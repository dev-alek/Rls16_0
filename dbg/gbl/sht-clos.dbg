        1   block-level on error undo, throw.
        2   using ibs.th.str.*.
        3   define  shared temp-table tt-susp-chk no-undo like ub.susp-chk .
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        7   define input  parameter p-check-cass    as   logical             no-undo.
        8   define input  parameter p-silent        as   logical             no-undo .
        9   define variable vss-revision    as char no-undo init "$Revision$":U .
       10   define variable vss-author      as char no-undo init "$Author$":U .
       11   define variable vss-date        as char no-undo init "$Date$":U .
       12   define variable vss-workfile    as char no-undo init "$Workfile$":U .
       13   define variable vss-archive     as char no-undo init "$Archive$":U .
       14   define variable vss-description as char no-undo init "Закрытие смены".
       15   define new global shared variable g#language as character no-undo .
       16   if g#language <> '' and g#language <> 'rus':U then do:
       17     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       18   end.
       19   define new global shared variable g#library  as handle no-undo .
       20   define new global shared variable g#library2 as handle no-undo .
       21   define   shared variable g#auto as logical no-undo.
       22   define   shared variable g#news as logical no-undo.
       23   define   shared variable g#oxml as logical no-undo.
       24   define   shared variable g#esys as logical no-undo.
       25   define   shared variable g#news-source-db as integer no-undo.
       26   define   shared variable g#esys-source-esys as integer no-undo.
       27   define   shared variable g#db-num as integer   no-undo .
       28   define   shared variable g#userid as character no-undo .
       29   define   shared variable g#passwd as character no-undo .
       30   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31     define variable v-cntxt-db-num        as integer   no-undo .
       32     define variable v-cntxt-userid        as character no-undo .
       33     define variable v-cntxt-level         as character no-undo .
       34     define variable v-cntxt-host-code-obj as integer   no-undo .
       35     define variable v-cntxt-obj-type      as character no-undo .
       36     define variable v-cntxt-obj-code      as integer   no-undo .
       37     define variable v-cntxt-db-num-obj    as integer   no-undo .
       38     define variable v-cntxt-is-admin      as logical   no-undo .
       39   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       40   procedure gen-key-rec :
       41     define input  parameter p-tbl-name    as character no-undo.
       42     define input  parameter p-bh_tbl-name as handle    no-undo.
       43     define output parameter p-key-rec     as character no-undo.
       44     do
       45     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       46     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       47     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       48     :
       49       define variable fh               as handle    no-undo .
       50       define variable v-ok             as logical   no-undo .
       51       define variable v-inform         as character no-undo .
       52       define variable v-ind            as integer   no-undo .
       53       define variable v-idx-field-qnty as integer   no-undo .
       54       if p-tbl-name = ?
       55         or p-tbl-name = "":U
       56       then do:
       57         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       58       end.
       59       if not p-bh_tbl-name:available then do:
       60         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       61       end.
       62       assign
       63         p-key-rec = p-tbl-name
       64         v-inform  = p-bh_tbl-name:index-information(1)
       65         v-ind     = 2
       66       .
       67       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       68       on error undo, return error
       69       :
       70         assign
       71           v-inform = p-bh_tbl-name:index-information( v-ind )
       72           v-ind    = v-ind + 1
       73         .
       74       end.
       75       if v-inform = ?
       76         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       77         or entry( 3, v-inform, ",":U ) <> "1":U
       78       then do:
       79         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
       80       end.
       81       else do:
       82         assign
       83           v-idx-field-qnty = num-entries( v-inform ) - 4
       84         .
       85         if v-idx-field-qnty < 2 then do:
       86           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
       87         end.
       88         do v-ind = 1 to v-idx-field-qnty by 2
       89         on error undo, return error
       90         :
       91           assign
       92             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
       93             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
       94           .
       95         end.
       96       end.
       97       if p-key-rec = ? then do:
       98         assign
       99           p-key-rec = "":U
      100         .
      101         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      102       end.
      103     end.
      104     return.
      105   end procedure.
      106   procedure gen-where-keyr-tab :
      107     define input  parameter i-tableSerach as character no-undo.
      108     define input  parameter i-tablekey   as character  no-undo.
      109     define input  parameter p-key-rec    as character  no-undo.
      110     define input  parameter p-key-handle as handle     no-undo .
      111     define input  parameter p-db-name    as character  no-undo .
      112     define input  parameter p-tt-handle  as handle     no-undo .
      113     define output parameter o-Where      as character  no-undo.
      114     do
      115     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      116     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      117     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      118     :
      119       define variable v-full-tbl-name  as character no-undo .
      120       define variable bh_tbl-name      as handle    no-undo .
      121       define variable fh_key           as handle    no-undo .
      122       define variable fh_search        as handle    no-undo .
      123       define variable v-field-num      as integer   no-undo .
      124       define variable v-count-fld      as integer   no-undo .
      125       define variable v-inform         as character no-undo .
      126       define variable v-ind            as integer   no-undo .
      127       define variable v-idx-field-qnty as integer   no-undo .
      128       define variable v-field-name     as character no-undo .
      129       define variable v-field-val      as character no-undo .
      130       define variable v-word-link      as character no-undo .
      131       define variable vTable           as character no-undo.
      132       define variable bh_tbl-key       as handle    no-undo .
      133       assign
      134         p-key-rec = trim( p-key-rec )
      135       .
      136       if p-key-handle <> ? then do:
      137         if not valid-handle(p-key-handle)
      138            or p-key-handle:type <> "buffer"
      139         then do:
      140           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      141         end.
      142         if num-entries( p-key-rec, chr(3) ) > 1
      143           or p-key-rec = ?
      144           or p-key-rec = "":U
      145         then do:
      146           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      147         end.
      148       end.
      149       else do:
      150         if p-key-rec = ?
      151           or p-key-rec = "":U
      152         then do:
      153           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      154         end.
      155       end.
      156       assign
      157         vTable = entry( 1 , p-key-rec, chr(3) )
      158       .
      159       if p-tt-handle <> ?
      160         and ( not valid-handle(p-tt-handle)
      161               or p-tt-handle:type <> "buffer"
      162             )
      163       then do:
      164         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      165       end.
      166       if p-tt-handle = ? then do:
      167         assign
      168           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      169         .
      170         create buffer bh_tbl-name for table v-full-tbl-name .
      171       end.
      172       else do:
      173         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      174       end.
      175       assign
      176         v-inform = bh_tbl-name:index-information(1)
      177         v-ind    = 2
      178       .
      179       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      180       on error undo, return error
      181       :
      182         assign
      183           v-inform = bh_tbl-name:index-information( v-ind )
      184           v-ind    = v-ind + 1
      185         .
      186       end.
      187       if v-inform = ?
      188         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      189         or entry( 3, v-inform, ",":U ) <> "1":U
      190       then do:
      191         delete object bh_tbl-name no-error.
      192         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      193       end.
      194       assign
      195         v-idx-field-qnty = num-entries( v-inform ) - 4
      196       .
      197       if v-idx-field-qnty < 2 then do:
      198         delete object bh_tbl-name no-error.
      199         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      200       end.
      201       assign
      202         o-where     = "where":U
      203         v-word-link = "":U
      204         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      205         v-count-fld = 0
      206       .
      207       if i-tablekey ne "" and i-tablekey ne ?
      208       then do:
      209         assign
      210           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      211         .
      212         create buffer bh_tbl-key for table v-full-tbl-name .
      213       end.
      214       if i-tableSerach ne "" and i-tableSerach ne ?
      215       then do:
      216         delete object bh_tbl-name no-error.
      217         assign
      218           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      219         .
      220         create buffer bh_tbl-name for table v-full-tbl-name .
      221       end.
      222       block_where:
      223       do v-ind = 1 to v-idx-field-qnty by 2
      224       on error undo, return error
      225       :
      226         assign
      227           v-count-fld = v-count-fld + 1
      228         .
      229         if p-key-handle = ?
      230           and v-count-fld > v-field-num
      231         then do:
      232           leave block_where.
      233         end.
      234         define variable VfieldKeyTable as handle no-undo.
      235         assign
      236           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      237           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      238         .
      239         if     bh_tbl-key ne ?
      240         then do:
      241            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      242            if VfieldKeyTable eq ?
      243            then next block_where.
      244         end.
      245         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      246         then
      247            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      248         else
      249            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      250         if p-key-handle = ? then do:
      251           assign
      252             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      253           .
      254         end.
      255         else do:
      256           assign
      257             fh_key = p-key-handle:buffer-field( v-field-name )
      258           .
      259           if fh_key = ?
      260             or not valid-handle( fh_key )
      261           then do:
      262             delete object bh_tbl-name.
      263             if     bh_tbl-key ne ?
      264             then
      265                delete object bh_tbl-key.
      266             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      267           end.
      268           assign
      269             v-field-val = fh_key:buffer-value
      270           .
      271         end.
      272         if fh_search:data-type ="character":U then do:
      273           assign
      274             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      275             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      276             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      277             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      278             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      279             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      280             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      281             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      282             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      283             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      284             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      285             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      286             v-field-val = substitute( '"&1"', v-field-val )
      287           .
      288         end.
      289         assign
      290           o-where = substitute( "&1 &2", o-where, v-field-val )
      291         .
      292         if v-word-link = "":U then do:
      293           assign
      294             v-word-link = "and":U
      295           .
      296         end.
      297       end.
      298       delete object bh_tbl-name.
      299       if     bh_tbl-key ne ?
      300       then
      301          delete object bh_tbl-key.
      302       if p-key-handle = ?
      303         and v-count-fld <> v-field-num
      304       then do:
      305         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      306       end.
      307     end.
      308   end procedure.
      309   procedure gen-hn-keyr-tab :
      310     define input  parameter i-tableSerach as character no-undo.
      311     define input  parameter i-tablekey   as character no-undo.
      312     define input  parameter p-key-rec    as character no-undo.
      313     define input  parameter p-key-handle as handle    no-undo .
      314     define input  parameter p-db-name    as character no-undo .
      315     define input  parameter p-tt-handle  as handle    no-undo .
      316     define input  parameter p-stts-lock  as integer   no-undo .
      317     define output parameter o-hn         as handle    no-undo.
      318     define variable v-full-tbl-name as character no-undo.
      319     define variable v-where         as character no-undo.
      320     define variable bh_tbl-name     as handle    no-undo.
      321     define variable vTable          as character no-undo.
      322     do
      323     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      324     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      325     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      326         run gen-where-keyr-tab(i-tableSerach,
      327                                i-tablekey,
      328                                p-key-rec,
      329                                p-key-handle,
      330                                p-db-name,
      331                                p-tt-handle,
      332                                output v-where).
      333         if i-tableSerach ne "" and i-tableSerach ne ?
      334         then do:
      335            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      336            create buffer bh_tbl-name for table v-full-tbl-name .
      337         end.
      338         else do:
      339            if p-tt-handle = ? then do:
      340               assign
      341                  vTable = entry( 1 , p-key-rec, chr(3) )
      342               .
      343               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      344               create buffer bh_tbl-name for table v-full-tbl-name .
      345            end.
      346            else do:
      347               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      348            end.
      349         end.
      350         if p-tt-handle = ? then do:
      351            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      352         end.
      353         else do:
      354            bh_tbl-name:find-first( v-where ) no-error .
      355         end.
      356         o-hn = bh_tbl-name.
      357      end.
      358   end procedure.
      359   procedure gen-hn-keyr :
      360     define input  parameter p-key-rec    as character no-undo.
      361     define input  parameter p-key-handle as handle    no-undo .
      362     define input  parameter p-db-name    as character no-undo .
      363     define input  parameter p-tt-handle  as handle    no-undo .
      364     define input  parameter p-stts-lock  as integer   no-undo .
      365     define output parameter o-hn         as handle    no-undo.
      366     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      367   end.
      368   procedure gen-row-keyr :
      369     define input  parameter p-key-rec    as character no-undo.
      370     define input  parameter p-key-handle as handle    no-undo .
      371     define input  parameter p-db-name    as character no-undo .
      372     define input  parameter p-tt-handle  as handle    no-undo .
      373     define input  parameter p-stts-lock  as integer   no-undo .
      374     define output parameter p-tbl-row    as rowid     no-undo.
      375     define output parameter p-tbl-name   as character no-undo.
      376     define variable vHn as handle no-undo.
      377       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      378       p-tbl-row = if vHn:available then vHn:rowid else ?.
      379       p-tbl-name =  vHn:table.
      380       delete object vHn no-error.
      381     if p-tbl-row = ? then do:
      382       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      383     end.
      384     else do:
      385       return.
      386     end.
      387   end procedure.
      388   procedure gen-key-fv :
      389     define input  parameter p-key-rec    as character no-undo .
      390     define output parameter p-field-list as character no-undo .
      391     define output parameter p-value-list as character no-undo.
      392     do
      393     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      394     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      395     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      396     :
      397       define variable v-full-tbl-name  as character no-undo .
      398       define variable bh_tbl-name      as handle    no-undo .
      399       define variable v-tbl-name       as character no-undo .
      400       define variable v-field-num      as integer   no-undo .
      401       define variable v-count-fld      as integer   no-undo .
      402       define variable v-inform         as character no-undo .
      403       define variable v-ind            as integer   no-undo .
      404       define variable v-idx-field-qnty as integer   no-undo .
      405       define variable v-delim-key      as character no-undo .
      406       if p-key-rec = ?
      407         or p-key-rec = "":U
      408       then do:
      409         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      410       end.
      411       assign
      412         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      413         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      414       .
      415       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      416       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      417       assign
      418         v-inform = bh_tbl-name:index-information(1)
      419         v-ind    = 2
      420       .
      421       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      422       on error undo, return error
      423       :
      424         assign
      425           v-inform = bh_tbl-name:index-information( v-ind )
      426           v-ind    = v-ind + 1
      427         .
      428       end.
      429       if v-inform = ?
      430         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      431         or entry( 3, v-inform, ",":U ) <> "1":U
      432       then do:
      433         delete object bh_tbl-name no-error.
      434         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      435       end.
      436       assign
      437         v-idx-field-qnty = num-entries( v-inform ) - 4
      438       .
      439       if v-idx-field-qnty < 2 then do:
      440         delete object bh_tbl-name no-error.
      441         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      442       end.
      443       assign
      444         p-field-list = "":U
      445         p-value-list = "":U
      446         v-delim-key  = "":U
      447         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      448         v-count-fld  = 0
      449       .
      450       block_where:
      451       do v-ind = 1 to v-idx-field-qnty by 2
      452       on error undo, return error
      453       :
      454         assign
      455           v-count-fld = v-count-fld + 1
      456         .
      457         if v-count-fld > v-field-num then do:
      458           leave block_where.
      459         end.
      460         assign
      461           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      462           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      463         .
      464         if v-ind = 1 then do:
      465           assign
      466             v-delim-key = chr(3)
      467           .
      468         end.
      469       end.
      470       delete object bh_tbl-name.
      471       if v-count-fld <> v-field-num then do:
      472         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      473       end.
      474     end.
      475   end procedure.
      476   procedure gen-key-field :
      477     define input  parameter p-table      as character no-undo .
      478     define output parameter p-field-list as character no-undo .
      479     do
      480     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      481     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      482     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      483     :
      484       define variable v-full-tbl-name  as character no-undo .
      485       define variable bh_tbl-name      as handle    no-undo .
      486       define variable v-tbl-name       as character no-undo .
      487       define variable v-field-num      as integer   no-undo .
      488       define variable v-count-fld      as integer   no-undo .
      489       define variable v-inform         as character no-undo .
      490       define variable v-ind            as integer   no-undo .
      491       define variable v-idx-field-qnty as integer   no-undo .
      492       define variable v-delim-key      as character no-undo .
      493       if p-table = ?
      494         or p-table = "":U
      495       then do:
      496         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      497       end.
      498       assign
      499         v-tbl-name      = p-table
      500         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      501       .
      502       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      503       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      504       assign
      505         v-inform = bh_tbl-name:index-information(1)
      506         v-ind    = 2
      507       .
      508       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      509       on error undo, return error
      510       :
      511         assign
      512           v-inform = bh_tbl-name:index-information( v-ind )
      513           v-ind    = v-ind + 1
      514         .
      515       end.
      516       if v-inform = ?
      517         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      518         or entry( 3, v-inform, ",":U ) <> "1":U
      519       then do:
      520         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      521       end.
      522       assign
      523         v-idx-field-qnty = num-entries( v-inform ) - 4
      524       .
      525       if v-idx-field-qnty < 2 then do:
      526         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      527       end.
      528       assign
      529         p-field-list = "":U
      530         v-delim-key  = "":U
      531         v-count-fld  = 0
      532       .
      533       block_where:
      534       do v-ind = 1 to v-idx-field-qnty by 2
      535       on error undo, return error
      536       :
      537         assign
      538           v-count-fld = v-count-fld + 1
      539         .
      540         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      541         if v-ind = 1 then do:
      542           assign
      543             v-delim-key = chr(3)
      544           .
      545         end.
      546       end.
      547       delete object bh_tbl-name.
      548     end.
      549   end procedure.
