     2365           buf_shift-param.shift-num = v-shift-num no-error .
     2366       if not available (buf_shift-param) then
     2367       do:
     2368           create buf_shift-param .
     2369           assign
     2370               buf_shift-param.gds-code       = buf_tt-rvs-line.gds-code
     2371               buf_shift-param.pl-code        = buf_tt-rvs-line.pl-code
     2372               buf_shift-param.obj-code       = p-curr-obj-code
     2373               buf_shift-param.obj-type       = p-curr-obj-type
     2374               buf_shift-param.shift-date     = v-shift-date
     2375               buf_shift-param.shift-name     = v-shift-name
     2376               buf_shift-param.shift-num      = v-shift-num
     2377               buf_shift-param.diff-cash-trk  = 0
     2378               buf_shift-param.diff-stock-end = 0
     2379               .
     2380           buf_shift-param.loc1 = buf_tt-rvs-line.loc1 .
     2381       end.
     2382       buf_tt-rvs-line.rast-stock-end = buf_tt-rvs-line.fact-stock-start + buf_tt-rvs-line.income - buf_tt-rvs-line.sale-kg - buf_tt-rvs-line.tech-refuell .
     2383       assign
