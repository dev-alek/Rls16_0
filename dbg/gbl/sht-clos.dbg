     2613       create ub.shift-param .
     2614       assign
     2615           ub.shift-param.obj-code   = p-curr-obj-code
     2616           ub.shift-param.obj-type   = p-curr-obj-type
     2617           ub.shift-param.shift-date = v-shift-date
     2618           ub.shift-param.shift-name = v-shift-name
     2619           ub.shift-param.shift-num  = v-shift-num .
     2620   end.
     2621   assign
     2622       ub.shift-param.prc-dev-mass   = prc-dev-mass
     2623       ub.shift-param.dev-paid-trans = dev-paid-trans
     2624       .
