      901                                     )
      902             .
      903             return .
      904           end.
      905           run gbl/rt-bcode.p
      906             (input  parparentproc
      907             ,input  p-doc-type + '|':u + buf_ord-doc.doc-code
      908             ,input  p-bar-code
      909             ,input  0
      910             ,input  0
      911             ,input  no
      912             ,output p-status
      913             ,output p-error-message
      914             ,output v-b-code
      915             ,output p-artic
      916             ,output p-name
      917             ,output v-prod-type
      918             ,output v-prod-code
      919             ,output p-prod-name
      920             ,output p-doc-qnty
      921             ,output p-unit-base
      922             ,output p-doc-sum
      923             ,output p-curr-abbr
      924             ,output v-last-date
      925             ,output p-price-docf
      926             ) .
      927           if p-status <> '0':u
      928           then do:
      929             assign
      930               p-status = '1':u
      931             .
      932             return .
      933           end.
      934           find first buf_currency no-lock
      935             where buf_currency.curr-code = buf_ord-doc.exch-code
      936           no-error .
      937           if not available buf_currency
      938           then do:
      939             assign
      940               p-status  = '1'
