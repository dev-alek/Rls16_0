      546       define variable v-valid-act   as logical   no-undo .
      547   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   do:
      549     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      550       (input  buf_sys-ctrl.db-num
      551       ,input  buf_user-login.user-id
      552       ,input  0
      553       ,input  'actn_rt-edit-doc_work':U
      554       ,input  'object':U
      555       ,input  v-host-code
      556       ,input  buf_clients.obj-type
      557       ,input  buf_clients.obj-code
      558       ,input  0
      559       ,input  0
      560       ,input  0
      561       ,input  false
      562       ,output v-valid-act
      563       )  .
      564   end.
      565       if v-valid-act <> true
      566       then do:
      567         assign
      568           p-status        = '1'
      569           p-message = substitute( "&1" , return-value )
      570         .
      571         return .
      572       end.
      573       if p-gds-code = "" then do:
      574         assign
      575           p-status  = '1':u
      576           p-message = "Не задан код товара"
      577         .
