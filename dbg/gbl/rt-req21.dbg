     1010               and buf_parts.obj-code  = buf_doc-line.obj-code
     1011               and buf_parts.artic     = buf_doc-line.artic
     1012               and buf_parts.prod-type = buf_doc-line.prod-type
     1013               and buf_parts.prod-code = buf_doc-line.prod-code
     1014               and buf_parts.in-code   = buf_doc-line.doc-code
     1015           :
     1016             if  buf_parts.last-date <> ?
     1017             and ( v-last-date = ?
     1018                  or
     1019                     (v-last-date <> ?
     1020                     and
     1021                     buf_parts.last-date < v-last-date
     1022                     )
     1023                 )
     1024             then do:
