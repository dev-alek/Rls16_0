      725             p-unit-base   = substitute( "&1" , buf_goods.unit-base                                                                   )
      726             p-doc-sum     = substitute( "&1" , (buf_ord-line-rcv.qnty * buf_ord-line-rcv.price-cli) / buf_ord-line-rcv.cli-base-rate )
      727             p-curr-abbr   = substitute( "&1" , buf_currency.curr-abbr                                                                )
      728             p-price-docf  = substitute( "&1" , buf_ord-line-rcv.price-cli                                                            )
      729           .
      730         end.
      731         when 'ПН':u
