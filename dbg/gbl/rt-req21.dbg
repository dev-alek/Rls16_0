      942                                     ,buf_ord-doc.exch-code
      943                                     ,buf_ord-doc.doc-code
      944                                     )
      945             .
      946             return .
      947           end.
      948           assign
      949             p-status      = '0'
      950             p-message     = ''
      951           .
      952         end.
      953         when 'РН':U
      954         then do:
      955           find first buf_trn-doc no-lock
      956             where buf_trn-doc.doc-code = v-search-doc-code
      957           no-error .
      958           if not available buf_trn-doc then do:
      959             assign
      960               p-status  = '1':u
      961               p-message = substitute("Не найдена накладная с кодом &1"
      962                                     ,v-search-doc-code
      963                                     )
      964             .
      965             return .
      966           end.
      967           if buf_trn-doc.status_ <> 'накл':U
      968           then do:
      969             assign
      970               p-status  = '1':u
      971               p-message = substitute("Документ &1 не в статусе &2"
      972                                     ,v-search-doc-code
      973                                     , 'накл':U
      974                                     )
      975             .
      976             return .
      977           end.
      978           find first buf_doc-line no-lock
      979             where buf_doc-line.doc-code   = buf_trn-doc.doc-code
      980               and buf_doc-line.artic      = buf_goods.artic
      981               and buf_doc-line.prod-type  = buf_goods.prod-type
      982               and buf_doc-line.prod-code  = buf_goods.prod-code
      983           no-error .
      984           if not available buf_doc-line then do:
      985             assign
      986               p-status  = '1':u
