     1029           end.
     1030           assign
     1031             p-status      = '0'
     1032             p-message     = ''
     1033             p-artic       = substitute( "&1" , buf_goods.artic                                                               )
     1034             p-name        = substitute( "&1" , buf_goods.gds-name                                                            )
     1035             p-prod-name   = substitute( "&1" , v-prod-name                                                                   )
     1036             p-doc-qnty    = substitute( "&1" , buf_doc-line.doc-qnty                                                         )
     1037             p-unit-base   = substitute( "&1" , buf_goods.unit-base                                                           )
     1038             p-doc-sum     = substitute( "&1" , (buf_doc-line.cli-qnty * buf_doc-line.price-cli) / buf_doc-line.cli-base-rate )
     1039             p-curr-abbr   = substitute( "&1" , buf_currency.curr-abbr                                                        )
     1040             p-last-date   = ( if v-last-date = ? then "" else string( v-last-date , "99.99.9999" )                           )
     1041           .
     1042         end.
     1043         otherwise do:
     1044           assign
     1045             p-status        = '1':u
     1046             p-message = substitute("Неизвестный тип документа &1"
     1047                                   ,p-doc-type
     1048                                   )
     1049           .
     1050           return .
     1051         end.
     1052       end case.
     1053   end.
     1054   end procedure.
