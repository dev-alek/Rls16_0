      591         assign
      592           p-status  = '1':u
      593           p-message = substitute("Ошибка преобразования кода товара &1. &2"
      594                                 ,p-gds-code
      595                                 ,v-error-message
      596                                 )
      597         .
      598         return .
      599       end.
      600       find first buf_goods no-lock
      601         where buf_goods.gds-code = v-gds-code
      602       no-error .
      603       if not available buf_goods then do:
      604         assign
      605           p-status  = '1':u
      606           p-message = substitute("Не найден товар с кодом &1."
      607                                 ,p-gds-code
      608                                 )
      609         .
