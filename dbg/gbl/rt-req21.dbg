      789               and buf_parts.prod-type = buf_doc-line.prod-type
      790               and buf_parts.prod-code = buf_doc-line.prod-code
      791               and buf_parts.in-code   = buf_doc-line.doc-code
      792           :
      793             if  buf_parts.last-date <> ?
      794             and ( v-last-date = ?
      795                  or
      796                     (v-last-date <> ?
      797                     and
      798                     buf_parts.last-date < v-last-date
      799                     )
      800                 )
      801             then do:
      802               assign
      803                 v-last-date = buf_parts.last-date
