        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle  no-undo .
        3   define input parameter p-directory-out  as character      no-undo .
        4   define input parameter p-file-name      as character      no-undo .
        5   define input parameter p-session-valid  as logical        no-undo .
        6   define input parameter p-error-message  as character      no-undo .
        7   define input parameter p-user-login     as character      no-undo .
        8   define input parameter p-obj-type       as character      no-undo .
        9   define input parameter p-obj-code       as character      no-undo .
       10   define input parameter p-host-code      as character      no-undo .
       11   define input parameter p-doc-code       as character      no-undo .
       12   define input parameter p-doc-type       as character      no-undo .
       13   define input parameter p-gds-code       as character      no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: rt-req21.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req21.p $":U .
       19   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 21. Приемка товара. Информация о товаре по коду товара.".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure integerm :
       80     define input  parameter p-string      as character no-undo .
       81     define input  parameter p-allow-sign  as logical   no-undo .
       82     define input  parameter p-allow-comma as logical   no-undo .
       83     define output parameter p-value       as integer   no-undo .
       84     define output parameter p-data-valid  as logical   no-undo .
       85     define output parameter p-message     as character no-undo .
       86     define variable v-replace-string as character no-undo .
       87     do
       88     on error undo, return error return-value
       89     :
       90       if p-string = ?
       91       then do:
       92         assign
       93           p-value      = ?
       94           p-data-valid = false
       95           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       96         .
       97         return .
       98       end.
       99       if p-string = ""
      100       then do:
      101         assign
      102           p-value      = ?
      103           p-data-valid = false
      104           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      105         .
      106         return .
      107       end.
      108       assign
      109         p-value = integer(p-string) no-error
      110       .
      111       if error-status :error = true
      112       then do:
      113         assign
      114           p-value      = ?
      115           p-data-valid = false
      116           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      117                                    ,p-string
      118                                    )
      119         .
      120         return .
      121       end.
      122       if index(p-string, ' ':u) > 0
      123       then do:
      124         assign
      125           p-value      = ?
      126           p-data-valid = false
      127           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      128                                    + "Строка содержит символы пробела"
      129                                    ,p-string
      130                                    )
      131         .
      132         return .
      133       end.
      134       assign
      135         v-replace-string = p-string
      136         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      145       .
      146       if p-allow-sign = true
      147       then do:
      148         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      149         then do:
      150           assign
      151             v-replace-string = substring(v-replace-string, 2)
      152           .
      153         end.
      154       end.
      155       else do:
      156         if substring(v-replace-string, 1, 1) = '+':u
      157         then do:
      158           assign
      159             p-value      = ?
      160             p-data-valid = false
      161             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      162                                     + "Задан параметр недопустимости знака челого числа. "
      163                                     + "Строка содержит символ плюс. "
      164                                     ,p-string
      165                                     )
      166           .
      167           return .
      168         end.
      169         if substring(v-replace-string, 1, 1) = '-':u
      170         then do:
      171           assign
      172             p-value      = ?
      173             p-data-valid = false
      174             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      175                                     + "Задан параметр недопустимости знака челого числа. "
      176                                     + "Строка содержит символ минус. "
      177                                     ,p-string
      178                                     )
      179           .
      180           return .
      181         end.
      182       end.
      183       if p-allow-comma = true
      184       then do:
      185         assign
      186           v-replace-string = replace(v-replace-string, ',', '')
      187         .
      188       end.
      189       else do:
      190         if index(v-replace-string, ',') > 0
      191         then do:
      192           assign
      193             p-value      = ?
      194             p-data-valid = false
      195             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      196                                     + "Задан параметр недопустимости знака разделителя тысяч."
      197                                     + "Строка содержит знак разделителя тысяч. "
      198                                     ,p-string
      199                                     )
      200           .
      201           return .
      202         end.
      203       end.
      204       if index(p-string, '.') > 0
      205       then do:
      206         assign
      207           p-value      = ?
      208           p-data-valid = false
      209           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      210                                    + "Строка содержит знак десятичной точки"
      211                                    ,p-string
      212                                    )
      213         .
      214         return .
      215       end.
      216       if v-replace-string <> fill('9', length(v-replace-string))
      217       then do:
      218         assign
      219           p-value      = ?
      220           p-data-valid = false
      221           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      222                                    + "Встречены символы, недопустимые для целого числа '&2'"
      223                                    ,p-string
      224                                    ,replace(v-replace-string, '9', '')
      225                                    )
      226         .
      227         return .
      228       end.
      229       assign
      230         p-data-valid = true
      231         p-message    = ""
      232       .
      233     end.
      234   end procedure.
      235   define new global shared variable g#library  as handle no-undo .
      236   define new global shared variable g#library2 as handle no-undo .
      237   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   function rtencode returns character
      239     ( p-init-string as character
      240     ) :
      241     define variable v-encode-string as character no-undo .
      242     if p-init-string = ?
      243     then do:
      244       assign
      245         v-encode-string = '?':u
      246       .
      247       return v-encode-string .
      248     end.
      249     if p-init-string = '?':u
      250     then do:
      251       assign
      252         v-encode-string = '~~077':u
      253       .
      254       return v-encode-string .
      255     end.
      256     assign
      257       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      258       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      259       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      260     .
      261     return v-encode-string .
      262   end function .
      263   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      264   procedure rt-cnvdc_decode :
      265     define input  parameter p-encoded-str as character no-undo .
      266     define output parameter p-decoded-str as character no-undo .
      267   do
      268   on error undo, return error return-value
      269   :
      270     define variable v-decoded-str as character no-undo .
      271     assign
      272       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      273       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      274       p-decoded-str = v-decoded-str
      275     .
      276   end.
      277   end procedure.
      278   define stream sout.
      279   define variable v-status      as character no-undo .
      280   define variable v-message     as character no-undo .
      281   define variable v-artic       as character no-undo .
      282   define variable v-name        as character no-undo .
      283   define variable v-prod-name   as character no-undo .
      284   define variable v-doc-qnty    as character no-undo .
      285   define variable v-unit-base   as character no-undo .
      286   define variable v-doc-sum     as character no-undo .
      287   define variable v-curr-abbr   as character no-undo .
      288   define variable v-last-date   as character no-undo .
      289   define variable v-price-docf  as character no-undo .
      290   define variable v-bar-code    as character no-undo .
      291   do on error undo, return error return-value
      292   :
      293     if p-session-valid = yes then do:
      294       run check-data in this-procedure
      295         (output v-status
      296         ,output v-message
      297         ,output v-artic
      298         ,output v-name
      299         ,output v-prod-name
      300         ,output v-doc-qnty
      301         ,output v-unit-base
      302         ,output v-doc-sum
      303         ,output v-curr-abbr
      304         ,output v-last-date
      305         ,output v-price-docf
      306         ,output v-bar-code
      307         ) no-error .
      308       if error-status :error
      309       then do:
      310         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      311                                     ,error-status :get-message(1)
      312                                     ,return-value
      313                                     ) .
      314       end.
      315     end.
      316     else do:
      317       assign
      318         v-status      = '1':U
      319         v-message     = p-error-message
      320         v-artic       = '':U
      321         v-name        = '':U
      322         v-prod-name   = '':U
      323         v-doc-qnty    = '':U
      324         v-unit-base   = '':U
      325         v-doc-sum     = '':U
      326         v-curr-abbr   = '':U
      327         v-last-date   = '':U
      328         v-price-docf  = '':u
      329         v-bar-code    = '':u
      330       .
      331     end.
      332     define variable v-temp-file-name as character no-undo .
      333     assign
      334       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      335     .
      336     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      337     put stream sout unformatted substitute('status:&1',       rtencode(v-status)      )
      338       + chr(10) .
      339     put stream sout unformatted substitute('message:&1',      rtencode(v-message)     )
      340       + chr(10) .
      341     put stream sout unformatted substitute('artic:&1',        rtencode(v-artic)       )
      342       + chr(10) .
      343     put stream sout unformatted substitute('name:&1',         rtencode(v-name)        )
      344       + chr(10) .
      345     put stream sout unformatted substitute('prod_name:&1',    rtencode(v-prod-name)   )
      346       + chr(10) .
      347     put stream sout unformatted substitute('doc_qnty:&1',     rtencode(v-doc-qnty)    )
      348       + chr(10) .
      349     put stream sout unformatted substitute('unit_base:&1',    rtencode(v-unit-base)   )
      350       + chr(10) .
      351     put stream sout unformatted substitute('doc_sum:&1',      rtencode(v-doc-sum)     )
      352       + chr(10) .
      353     put stream sout unformatted substitute('curr_abbr:&1',    rtencode(v-curr-abbr)   )
      354       + chr(10) .
      355     put stream sout unformatted substitute('deadline_date:&1', rtencode(v-last-date)  )
      356       + chr(10) .
      357     put stream sout unformatted substitute('price_docf:&1', rtencode(v-price-docf)    )
      358       + chr(10) .
      359     put stream sout unformatted substitute('bar_code:&1',   rtencode(v-bar-code)      )
      360       + chr(10) .
      361     output stream sout close .
      362     os-delete value(p-directory-out + '/':u + p-file-name) .
      363     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      364               value(p-directory-out + '/':u + p-file-name)
      365               .
      366   end.
      367   procedure check-data :
      368     define output parameter p-status      as character no-undo .
      369     define output parameter p-message     as character no-undo .
      370     define output parameter p-artic       as character no-undo .
      371     define output parameter p-name        as character no-undo .
      372     define output parameter p-prod-name   as character no-undo .
      373     define output parameter p-doc-qnty    as character no-undo .
      374     define output parameter p-unit-base   as character no-undo .
      375     define output parameter p-doc-sum     as character no-undo .
      376     define output parameter p-curr-abbr   as character no-undo .
      377     define output parameter p-last-date   as character no-undo .
      378     define output parameter p-price-docf  as character no-undo .
      379     define output parameter p-bar-code    as character no-undo .
      380     define buffer buf_clients       for ub.clients .
      381     define buffer buf_sysconf       for ub.sysconf .
      382     define buffer buf_sys-ctrl      for ub.sys-ctrl .
      383     define buffer buf_user-login    for ub.user-login .
      384     define buffer buf_goods         for ub.goods.
      385     define buffer buf_trn-doc       for ub.trn-doc.
      386     define buffer buf_doc-line      for ub.doc-line.
      387     define buffer buf_ord-doc       for ub.ord-doc .
      388     define buffer buf_ord-line      for ub.ord-line.
      389     define buffer buf_ord-doc-rcv   for ub.ord-doc-rcv.
      390     define buffer buf_ord-line-rcv  for ub.ord-line-rcv.
      391     define buffer buf_currency      for ub.currency .
      392     define buffer buf_parts         for ub.parts.
      393     define buffer buf_bar-code      for ub.bar-code.
      394     define variable v-price-cli     as decimal   no-undo .
      395     define variable v-price-base    as decimal   no-undo .
      396     define variable v-price-rubl    as decimal   no-undo .
      397     define variable v-vat-pc        as decimal   no-undo .
      398     define variable v-road-tax      as decimal   no-undo .
      399     define variable v-excise        as decimal   no-undo .
      400     define variable v-prod-name     as character no-undo .
      401     define variable v-last-date     as date      no-undo .
      402     define variable v-b-code        as integer   no-undo .
      403     define variable v-prod-type     as character no-undo .
      404     define variable v-prod-code     as integer   no-undo .
      405   do
      406   on error undo, return error return-value
      407   :
      408       assign
      409         p-last-date = "":u
      410         p-price-docf = "":u
      411       .
      412       find first buf_sys-ctrl no-lock .
      413       find first buf_user-login no-lock
      414         where buf_user-login.db-num = buf_sys-ctrl.db-num
      415           and buf_user-login.status_    = 0
      416           and buf_user-login.user-login = p-user-login
      417         no-error .
      418       if not available buf_user-login
      419       then do:
      420         assign
      421           p-status  = '1':u
      422           p-message = substitute("Неизвестный пользователь &1"
      423                                 ,p-user-login
      424                                 )
      425         .
      426         return .
      427       end.
      428       define variable v-obj-code      as integer   no-undo .
      429       define variable v-data-valid    as logical   no-undo .
      430       define variable v-error-message as character no-undo .
      431       if p-obj-code = ""
      432       then do:
      433         assign
      434           p-status  = '1':u
      435           p-message = "Не задан код объекта"
      436         .
      437         return .
      438       end.
      439       run integerm in this-procedure
      440         (input  p-obj-code
      441         ,input  false
      442         ,input  false
      443         ,output v-obj-code
      444         ,output v-data-valid
      445         ,output v-error-message
      446         ) .
      447       if v-data-valid <> true
      448       then do:
      449         assign
      450           p-status  = '1':u
      451           p-message = substitute("Ошибка преобразования кода объекта &1. &2"
      452                                 ,p-obj-code
      453                                 ,v-error-message
      454                                 )
      455         .
      456         return .
      457       end.
      458       find first buf_clients no-lock
      459         where buf_clients.obj-type = p-obj-type
      460           and buf_clients.obj-code = v-obj-code
      461         no-error .
      462       if not available buf_clients
      463       then do:
      464         assign
      465           p-status  = '1':u
      466           p-message = substitute("Не найден объект &1 &2"
      467                                 ,p-obj-type
      468                                 ,v-obj-code
      469                                 )
      470         .
      471         return .
      472       end.
      473       if  p-obj-type <> 'маг':U
      474       and p-obj-type <> 'скл':U
      475       then do:
      476         assign
      477           p-status  = '1':u
      478           p-message = substitute("Неправильный тип объекта &1 &2"
      479                                 ,p-obj-type
      480                                 ,v-obj-code
      481                                 )
      482         .
      483         return .
      484       end.
      485       define variable v-host-code as integer   no-undo .
      486       run integerm in this-procedure
      487         (input  p-host-code
      488         ,input  false
      489         ,input  false
      490         ,output v-host-code
      491         ,output v-data-valid
      492         ,output v-error-message
      493         ) .
      494       if v-data-valid <> true
      495       then do:
      496         assign
      497           p-status  = '1':u
      498           p-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      499                                 ,p-host-code
      500                                 ,v-error-message
      501                                 )
      502         .
      503         return .
      504       end.
      505       define variable v-obj-host-code as integer   no-undo .
      506   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      508     (input  buf_clients.obj-type
      509     ,input  buf_clients.obj-code
      510     ,output v-obj-host-code
      511     )  .
      512       if v-host-code <> v-obj-host-code
      513       then do:
      514         assign
      515           p-status        = '1':u
      516           p-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      517                                 ,p-host-code
      518                                 ,v-obj-host-code
      519                                 ,buf_clients.obj-type
      520                                 ,buf_clients.obj-code
      521                                 )
      522         .
      523         return .
      524       end.
      525       define variable v-object-available as logical   no-undo .
      526   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      528     (input  buf_sys-ctrl.db-num
      529     ,input  0
      530     ,input  buf_user-login.user-id
      531     ,input  buf_clients.obj-type
      532     ,input  buf_clients.obj-code
