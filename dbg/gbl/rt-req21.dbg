      579       end.
      580       define variable v-gds-code as integer   no-undo .
      581       run integerm in this-procedure
      582         (input  p-gds-code
      583         ,input  false
      584         ,input  false
      585         ,output v-gds-code
      586         ,output v-data-valid
      587         ,output v-error-message
      588         ) .
      589       if v-data-valid <> true
