        1   block-level on error undo, throw.
        2   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
        4   procedure paramls-clear :
        5     define buffer buf_temp-param for temp-param .
        6     do
        7     on error undo, return error return-value
        8     :
        9       for each buf_temp-param
       10       on error undo, return error
       11       :
       12         delete buf_temp-param .
       13       end.
       14     end.
       15   end procedure.
       16   procedure paramls-write :
       17     define input  parameter p-code     as character no-undo .
       18     define input  parameter p-sub-code as character no-undo .
       19     define input  parameter p-value    as character no-undo .
       20     define buffer buf_temp-param for temp-param .
       21     do
       22     on error undo, return error return-value
       23     :
       24       find first buf_temp-param
       25         where buf_temp-param.param-code     = p-code
       26           and buf_temp-param.param-sub-code = p-sub-code
       27         no-error .
       28       if not available buf_temp-param then do:
       29         create buf_temp-param .
       30         assign
       31           buf_temp-param.param-code     = p-code
       32           buf_temp-param.param-sub-code = p-sub-code
       33         .
       34       end.
       35       assign
       36         buf_temp-param.param-value = p-value
       37       .
       38     end.
       39   end procedure.
       40   procedure paramls-read :
       41     define input  parameter p-code          as character no-undo .
       42     define input  parameter p-sub-code      as character no-undo .
       43     define input  parameter p-default-value as character no-undo .
       44     define output parameter p-value         as character no-undo .
       45     define buffer buf_temp-param for temp-param .
       46     do
       47     on error undo, return error return-value
       48     :
       49       find first buf_temp-param
       50         where buf_temp-param.param-code     = p-code
       51           and buf_temp-param.param-sub-code = p-sub-code
       52         no-error .
       53       if available buf_temp-param then do:
       54         assign
       55           p-value = buf_temp-param.param-value
       56         .
       57       end.
       58       else do:
       59         assign
       60           p-value = p-default-value
       61         .
       62       end.
       63     end.
       64   end procedure.
       65   procedure paramls-append :
       66     define input  parameter p-code     as character no-undo .
       67     define input  parameter p-sub-code as character no-undo .
       68     define input  parameter p-value    as character no-undo .
       69     define buffer buf_temp-param for temp-param .
       70     do
       71     on error undo, return error return-value
       72     :
       73       find first buf_temp-param
       74            where buf_temp-param.param-code     = p-code
       75              and buf_temp-param.param-sub-code = p-sub-code
       76         no-error .
       77       if not available buf_temp-param then do:
       78         create buf_temp-param .
       79         assign
       80           buf_temp-param.param-code     = p-code
       81           buf_temp-param.param-sub-code = p-sub-code
       82           buf_temp-param.param-value    = p-value
       83         .
       84       end.
       85       else do:
       86           assign
       87               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
       88           .
       89       end.
       90     end.
       91   end procedure.
       92   define input-output parameter table for temp-param .
       93   define variable vss-revision    as character no-undo init "$Revision: bbf1530230d5, 2753, rls $":U .
       94   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       95   define variable vss-date        as character no-undo init "$Date: Сб фев 20 15:59:21 2021 +0300 $":U .
       96   define variable vss-workfile    as character no-undo init "$Workfile: macroxlt.p $":U .
       97   define variable vss-archive     as character no-undo init "$Archive: gbl/macroxlt.p $":U .
       98   define variable vss-description as character no-undo init "Программа формирования файла Excel из шаблона.".
       99   define variable mTextError      as character no-undo.
      100   procedure vss-get-info :
      101     define output parameter p-vss-revision    like vss-revision    no-undo .
      102     define output parameter p-vss-author      like vss-author      no-undo .
      103     define output parameter p-vss-date        like vss-date        no-undo .
      104     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      105     define output parameter p-vss-archive     like vss-archive     no-undo .
      106     define output parameter p-vss-description like vss-description no-undo .
      107     assign
      108       p-vss-revision    = vss-revision
      109       p-vss-author      = vss-author
      110       p-vss-date        = vss-date
      111       p-vss-workfile    = vss-workfile
      112       p-vss-archive     = vss-archive
      113       p-vss-description = vss-description
      114     .
      115   end procedure.
      116   procedure vss-get-parameters :
      117     define output parameter p-vss-parameters as character no-undo .
      118   end procedure.
      119   define new global shared variable g#vssrevis-logger as handle    no-undo .
      120   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      121   define variable v-vssrevis-logger                   as handle    no-undo .
      122   procedure vss-logevent :
      123     define input  parameter p-extra-paramters as character no-undo .
      124     define variable v-vssrevis-parameters as character no-undo .
      125     do
      126     on error undo, return error return-value
      127     :
      128       if  valid-handle(v-vssrevis-logger)
      129       and v-vssrevis-logger :get-signature("logevent") <> ""
      130       then do:
      131         run vss-get-parameters in this-procedure
      132           (output v-vssrevis-parameters
      133           ).
      134         run logevent in v-vssrevis-logger
      135           (input vss-workfile
      136           ,input vss-revision
      137           ,input v-vssrevis-parameters
      138           ,input p-extra-paramters
      139           ).
      140       end.
      141     end.
      142   end procedure.
      143   assign
      144     v-vssrevis-logger = g#vssrevis-logger
      145   .
      146   if  valid-handle(v-vssrevis-logger)
      147   and v-vssrevis-logger :get-signature("logevent") <> ""
      148   then do:
      149     assign
      150       v-vssrevis-logevent = true
      151     .
      152     run vss-logevent in this-procedure (input vss-description) .
      153   end.
      154   define new global shared variable g#language as character no-undo .
      155   if g#language <> '' and g#language <> 'rus':U then do:
      156     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      157   end.
      158   define buffer buf_temp-param for temp-param .
      159       define variable v-macroxlt-counter          as integer          no-undo .
      160       define variable chExcelApp                  as com-handle       no-undo .
      161       define variable chWorkBook                  as com-handle       no-undo .
      162       define variable chCodeModule                as com-handle       no-undo .
      163       define variable v-counter                   as integer          no-undo .
      164       define variable v-excel-file-name           as character        no-undo .
      165       define variable v-read-password             as character        no-undo .
      166       define variable v-write-password            as character        no-undo .
      167       define variable v-excel-dir-name            as character        no-undo .
      168       define variable v-ind                       as integer          no-undo .
      169       define variable v-excel-macro-file          as character        no-undo .
      170       define variable v-ok                        as logical          no-undo .
      171       define variable v-column-list               as character        no-undo .
      172       define variable v-excel-visible-char        as character        no-undo .
      173       define variable v-template-file-name        as character        no-undo .
      174       define variable v-vb-file-name              as character        no-undo .
      175       define variable v-default-excel-file-name   as character        no-undo .
      176       define variable v-data-header-filename      as character        no-undo .
      177       define variable v-data-filename             as character        no-undo .
      178       define variable v-temp-string               as character        no-undo .
      179       define variable v-version                   as character        no-undo .
      180       define variable v-version-dec               as decimal          no-undo .
      181       define variable v-found-reg-entry           as logical          no-undo .
      182       define variable v-trusted                   as character        no-undo .
      183   do
      184   on error undo, return error
      185   :
      186       run paramls-read in this-procedure (
      187             input "saveas":U
      188           , input "excel-file-name":U
      189           , input "":U
      190           , output v-excel-file-name
      191       ).
      192       run paramls-read in this-procedure (
      193             input "saveas":U
      194           , input "read-password":U
      195           , input  "":U
      196           , output v-read-password
      197       ).
      198       run paramls-read in this-procedure (
      199             input  "saveas":U
      200           , input  "write-password":U
      201           , input  "":U
      202           , output v-write-password
      203       ).
      204       run paramls-read in this-procedure (
      205             input "option":U
      206           , input "visible":U
      207           , input "true":U
      208           , output v-excel-visible-char
      209       ).
      210       run paramls-read (
      211             input "template":U
      212           , input "template-file-name":U
      213           , input "":U
      214           , output v-template-file-name
      215       ) .
      216       run paramls-read (
      217             input "template":U
      218           , input "vb-file-name":U
      219           , input "":U
      220           , output v-vb-file-name
      221       ) .
      222       run paramls-read (
      223             input "data":U
      224           , input "data-header-filename":U
      225           , input "":U
      226           , output v-data-header-filename
      227       ) .
      228       run paramls-read (
      229             input "data":U
      230           , input "data-filename":U
      231           , input "":U
      232           , output v-data-filename
      233       ) .
      234       define variable v-file-no-open-string   as character    no-undo.
      235       define variable v-file-no-open          as logical      no-undo.
      236       run paramls-read (
      237             input "file":U
      238           , input "file-no-open":U
      239           , input "yes":U
      240           , output v-file-no-open-string
      241       ) .
      242       assign
      243           v-file-no-open = ( v-file-no-open-string = "yes":U )
      244       .
      245       create "Excel.Application" chExcelApp no-error .
      246       if error-status :error then do:
      247           mTextError = substitute("&1~n&2"
      248               ,"Ошибка при запуске Excel"
      249               ,error-status :get-message(1)
      250             ).
      251           if not session:batch-mode then
      252             message
      253               mTextError
      254               view-as alert-box error.
      255           undo, return error mTextError.
      256       end.
      257       assign
      258           chExcelApp :WindowState = -4140
      259           chExcelApp :Visible     = False
      260           chExcelApp :Interactive = False
      261       .
      262         assign
      263           v-version = chExcelApp :version
      264         no-error.
      265         assign
      266           v-version-dec = decimal(v-version)
      267         no-error .
      268         if error-status:error then do:
      269           mTextError = "Не удалось определить версию Excel".
      270           if not session:batch-mode then
      271               message
      272               mTextError
      273               view-as alert-box error .
      274           release object chCodeModule no-error .
      275           release object chWorkBook   no-error .
      276           release object chExcelApp   no-error .
      277           undo, return error mTextError.
      278         end.
      279         if v-version-dec > 9 then do:
      280           run gbl/getregvl.p
      281                           ( "HKEY_CURRENT_USER":U
      282                           , "SOFTWARE":U
      283                           , "Microsoft\Office\" + string(v-version-dec, ">9.9":U) + "\Excel\Security":U
      284                           , "AccessVBOM":U
      285                           , output v-found-reg-entry
      286                           , OUTPUT v-trusted) no-error .
      287           if error-status:error then do:
      288             mTextError = "Не удалось определить политику безопасности для данной версии Excel".
      289             if not session:batch-mode then
      290                 message
      291                 mTextError
      292                 view-as alert-box error .
      293             release object chCodeModule no-error .
      294             release object chWorkBook   no-error .
      295             release object chExcelApp   no-error .
      296             undo, return error mTextError.
      297           end.
      298           if not v-found-reg-entry
      299           or trim(v-trusted) = "0":U then do:
      300               mTextError = substitute("&1~n&2~n&3~n&4~n&5~n&6~n&7"
      301                 ,"На Вашей машине запрещен программный доступ к VisualBasicProject"
      302                 ,"В связи с этим вывод в EXCEL невозможен"
      303                 ,"возможное решение проблемы:"
      304                 ,"открыть в EXCEL диалог <Сервис\Макрос\Безопасность> (<Tools\Macro\Security>)"
      305                 ,"выбрать закладку <Надежные источники> (<Trusted Sources>)  и включить галочку"
      306                 ,"<Доверять доступ Visual Basic Project> (<Trust access to Visual Basic Project>)"
      307                 ,"Затем закрыть Excel").
      308             if not session:batch-mode then
      309                 message
      310                 mTextError
      311                 view-as alert-box ERROR.
      312             release object chCodeModule no-error .
      313             release object chWorkBook   no-error .
      314             release object chExcelApp   no-error .
      315             undo, return error mTextError.
      316           end.
      317         end.
      318       assign
      319           v-temp-string        = v-template-file-name
      320           v-template-file-name = search( v-template-file-name )
      321       .
      322       if v-vb-file-name = ?
      323       then do:
      324           mTextError = substitute("&1~n~n&2&3"
      325             ,"Не найден шаблон Excel."
      326             ,"Необходим шаблон:"
      327             ,v-temp-string
      328           ).
      329           if not session:batch-mode then
      330               message
      331                   vss-workfile vss-revision vss-description skip
      332               view-as alert-box error.
      333           undo, return error mTextError.
      334       end.
      335       assign
      336           chWorkBook = chExcelApp :Workbooks :Add( v-template-file-name )
      337       .
      338       assign
      339           chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      340       .
      341       define variable v-book-name    as character    no-undo.
      342       assign
      343           v-book-name = chWorkBook :CodeName
      344       .
      345       assign
      346           v-temp-string  = v-vb-file-name
      347           v-vb-file-name = search( v-vb-file-name )
      348       .
      349       if v-vb-file-name = ?
      350       then do:
      351           mTextError = substitute("&1~n~n&2&3~n&4&5"
      352             ,"Не найдена программа обработки шаблона Excel."
      353             ,"Шаблон:"
      354             ,v-template-file-name
      355             ,"Необходима программа:",
      356             v-temp-string
      357           ).
      358           if not session:batch-mode then
      359               message
      360                   vss-workfile vss-revision vss-description skip
      361                   mTextError
      362               view-as alert-box error.
      363           undo, return error mTextError.
      364       end.
      365       run load-basic in this-procedure (
      366             input v-vb-file-name
      367           , input v-book-name
      368           , input v-template-file-name
      369           , input v-data-header-filename
      370           , input v-data-filename
      371       ).
      372       assign
      373           v-ok = chWorkbook :LoadBasic
      374       .
      375       assign
      376           v-ok = chWorkbook :StartApp
      377       .
      378       for each buf_temp-param
      379          where buf_temp-param.param-code = "command":U
      380       by buf_temp-param.param-sub-code
      381       on error undo, leave
      382       :
      383           assign
      384               v-ok = chWorkbook :DDEExecCommand( buf_temp-param.param-value )
      385           .
      386       end.
      387       assign
      388           chExcelApp:DisplayAlerts = False
      389       no-error .
      390       assign
      391           v-default-excel-file-name = chWorkBook:FullName
      392       no-error .
      393       if v-excel-file-name = "":U
      394       or v-excel-file-name = ?
      395       then do:
      396           run gbl/_tmpfile.p (
      397                 input  ""
      398               , input  ".xls"
      399               , output v-excel-file-name
      400           ).
      401           run gbl/d-file.p (
      402                 input-output v-excel-file-name
      403               , input-output v-excel-dir-name
      404               , input  (" Все файлы EXCEL (*.xls) ")
      405               , input  ("*.xls":U)
      406               , input  chr(44)
      407               , input  (".xls":U)
      408               , input  no
      409               , input  yes
      410               , input  yes
      411               , input  "Введите имя файла"
      412               , output v-ok
      413           ) .
      414           if v-ok <> true
      415           then do:
      416               assign
      417                   chWorkBook :Saved = true
      418               .
      419               assign
      420                   v-ok = chWorkBook :close no-error
      421               .
      422               release object chCodeModule no-error .
      423               release object chWorkBook   no-error .
      424               assign
      425                   v-ok = chExcelApp:Quit()
      426               no-error.
      427               release object chExcelApp   no-error .
      428               undo, return error "quit":U .
      429           end.
      430           if search( v-excel-file-name ) <> ?
      431           then do:
      432               os-delete value( v-excel-file-name ).
      433           end.
      434       end.
      435       if v-read-password <> "":U
      436       and v-write-password <> "":U
      437       then do:
      438           assign
      439               v-ok = chWorkBook :SaveAs( v-excel-file-name, -4143, v-read-password, v-write-password , , , ) no-error
      440           .
      441       end.
      442       else do:
      443           if v-write-password <> "":U
      444           then do:
