      446                   v-ok = chWorkBook :SaveAs( v-excel-file-name, -4143, , v-write-password , , , ) no-error
      447               .
      448           end.
      449           else do:
      450               assign
      451                   v-ok = chWorkBook :SaveAs( v-excel-file-name, -4143 , , , , , ) no-error
      452               .
      453           end.
      454       end.
      455       assign
