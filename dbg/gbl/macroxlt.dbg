      457       .
      458       assign
      459           v-excel-file-name = chWorkBook :FullName
      460       .
      461       if v-excel-file-name = v-default-excel-file-name
      462       or v-excel-file-name = ?
      463       then do:
      464           release object chCodeModule no-error .
      465           release object chWorkBook   no-error .
      466           release object chExcelApp   no-error .
      467           if not session:batch-mode then
      468               message
      469                   "Ошибка при сохранении файла"
      470                   skip "Сохраните Excel файл вручную"
      471               view-as alert-box information .
      472       end.
      473       else do:
      474           assign
      475               chWorkBook :Saved = true
      476           .
      477           assign
      478               v-ok = chWorkBook :close no-error
      479           .
      480           release object chCodeModule no-error .
      481           release object chWorkBook   no-error .
      482           assign
      483               v-ok = chExcelApp:Quit()
      484           no-error.
      485           release object chExcelApp   no-error .
      486           run paramls-append in this-procedure (
      487                 input "file":U
      488               , input "file-out-list":U
      489               , input v-excel-file-name
      490           ).
      491           if v-file-no-open = no
      492           then do:
      493               define variable v-excel-file-list    as character    no-undo.
      494               define variable v-excel-file-count   as integer      no-undo.
      495               run paramls-read in this-procedure (
      496                     input "file":U
      497                   , input "file-out-list":U
      498                   , input "":U
      499                   , output v-excel-file-list
      500               ).
      501               assign
      502                   v-excel-file-count = num-entries( v-excel-file-list )
      503               .
      504               do v-counter = 1 to v-excel-file-count
      505               :
      506                   assign
      507                       v-excel-file-name = entry( v-counter, v-excel-file-list )
      508                   .
      509                   run rep/killspac.p (
      510                       input-output v-excel-file-name
      511                   ).
      512                   run gbl/open_url.p (
      513                       input v-excel-file-name
      514                   ).
      515               end.
      516           end.
      517       end.
      518   end.
      519   procedure append-macro-line :
      520   define input  parameter p-macro-str as character no-undo .
      521   do
      522   on error undo, return error return-value
      523   :
      524       assign
      525           v-macroxlt-counter = v-macroxlt-counter + 1
      526       .
      527       assign
      528           v-ok = chCodeModule :InsertLines( v-macroxlt-counter, p-macro-str )
      529       .
      530   end.
      531   end procedure.
      532   procedure export-test-macro :
      533     assign
      534       v-ind = 0
      535     .
      536     do
      537     on error undo, return error return-value
      538     :
      539       run append-macro-line (input 'Sub HelloWorld()').
      540       run append-macro-line (input '  MsgBox "HelloWorld"').
      541       run append-macro-line (input 'End Sub').
      542     end.
      543   end procedure.
      544   procedure load-basic :
      545   define input parameter p-vb-file-name           as character        no-undo.
      546   define input parameter p-book-name              as character        no-undo.
      547   define input parameter p-template-file-name     as character        no-undo.
      548   define input parameter p-data-header-filename   as character        no-undo.
      549   define input parameter p-data-filename          as character        no-undo.
      550       define variable v-command-string    as character    no-undo.
      551     assign
      552       v-ind = 0
      553     .
      554     do
      555     on error undo, return error return-value
      556     :
      557       run append-macro-line ( input 'Sub LoadBasic').
      558       assign
      559           v-command-string = substitute( '  VBAProject.&1.VBProject.VBComponents.Import "&2"'
      560                                   , p-book-name
      561                                   , p-vb-file-name
      562                              )
      563       .
      564       run append-macro-line ( input v-command-string ).
      565       run append-macro-line ( input '  Application.Interactive = True').
      566       run append-macro-line ( input '  Application.ScreenUpdating = True').
      567       run append-macro-line ( input 'End Sub').
      568       run append-macro-line ( input 'Sub StartApp').
      569       run append-macro-line ( input 'Dim mModule As Object').
      570       run append-macro-line ( input 'Dim liCount As Long').
      571       run append-macro-line ( input '  Application.ScreenUpdating = False').
      572       run append-macro-line ( input '  Application.Interactive = False').
      573       assign
      574           v-command-string = substitute( '  call VBAProject.startFormFromTemplate ("&1", "&2")'
      575                                   , p-data-header-filename
      576                                   , p-data-filename
      577                              )
      578       .
      579       run append-macro-line ( input v-command-string ).
      580       run append-macro-line ( input substitute( 'For Each mModule In VBAProject.&1.VBProject.VBComponents', p-book-name ) ).
      581       run append-macro-line ( input 'If mModule.Type = 1 Then').
      582       run append-macro-line ( input substitute( '    VBAProject.&1.VBProject.VBComponents.Remove VBAProject.&1.VBProject.VBComponents(mModule.Name)', p-book-name ) ).
      583       run append-macro-line ( input 'End If').
      584       run append-macro-line ( input 'Next mModule').
      585       run append-macro-line ( input '  Application.Interactive = True').
      586       run append-macro-line ( input '  Application.ScreenUpdating = True').
      587       run append-macro-line ( input substitute( 'For Each mModule In VBAProject.&1.VBProject.VBComponents', p-book-name ) ).
      588       run append-macro-line ( input '    liCount = mModule.CodeModule.CountOfLines').
      589       run append-macro-line ( input '    mModule.CodeModule.DeleteLines 1, liCount').
      590       run append-macro-line ( input 'Next mModule').
      591       run append-macro-line ( input 'End Sub').
      592     end.
      593   end procedure.
      594   procedure clear-macro :
      595     define variable v-num-lines as integer   no-undo .
      596     do
      597     on error undo, return error return-value
      598     :
      599       assign
      600         v-num-lines = chCodeModule :CountOfLines
      601       .
      602       chCodeModule :DeleteLines(1, v-num-lines) .
      603     end.
      604   end procedure.
