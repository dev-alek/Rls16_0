        1   block-level on error undo, throw.
        2   define input  parameter p-cntxt-db-num          as integer   no-undo .
        3   define input  parameter p-cntxt-user-id         as character no-undo .
        4   define input  parameter p-cntxt-menu-code       as integer   no-undo .
        5   define input  parameter p-cntxt-menu-group-code as integer   no-undo .
        6   define input  parameter p-cntxt-level           as character no-undo .
        7   define input  parameter p-cntxt-host-code-obj   as integer   no-undo .
        8   define input  parameter p-cntxt-obj-type        as character no-undo .
        9   define input  parameter p-cntxt-obj-code        as integer   no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: cntxtstr.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/cntxtstr.p $":U .
       15   define variable vss-description as character no-undo init "Сохранить контекст пользователя".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure sys-time_get-sys :
       72     define output parameter p-year         as integer   no-undo .
       73     define output parameter p-month        as integer   no-undo .
       74     define output parameter p-day          as integer   no-undo .
       75     define output parameter p-hour         as integer   no-undo .
       76     define output parameter p-minute       as integer   no-undo .
       77     define output parameter p-second       as integer   no-undo .
       78     define output parameter p-milliseconds as integer   no-undo .
       79     define variable v-system-time-structure as memptr    no-undo.
       80     do
       81     on error undo, return error return-value
       82     :
       83       assign
       84         set-size(v-system-time-structure) = 16
       85       .
       86       run GetSystemTime
       87         (input  get-pointer-value(v-system-time-structure)
       88         ) .
       89       assign
       90         p-year         = get-short(v-system-time-structure,  1)
       91         p-month        = get-short(v-system-time-structure,  3)
       92         p-day          = get-short(v-system-time-structure,  7)
       93         p-hour         = get-short(v-system-time-structure,  9)
       94         p-minute       = get-short(v-system-time-structure, 11)
       95         p-second       = get-short(v-system-time-structure, 13)
       96         p-milliseconds = get-short(v-system-time-structure, 15)
       97       .
       98       assign
       99         set-size(v-system-time-structure) = 0
      100       .
      101     end.
      102   end procedure.
      103   procedure sys-time_get-comp-user-name :
      104     define output parameter p-computer-name as character no-undo .
      105     define output parameter p-user-name     as character no-undo .
      106     define output parameter p-process-pid   as integer   no-undo .
      107     define variable v-return-value  as integer   no-undo .
      108     define variable v-buffer-length as integer   no-undo .
      109     define variable v-buffer-memptr as memptr    no-undo .
      110     do
      111     on error undo, return error return-value
      112     :
      113       assign
      114         v-buffer-length = 1024
      115         set-size(v-buffer-memptr) = v-buffer-length + 4
      116       .
      117       assign
      118         put-long(v-buffer-memptr, 1) = v-buffer-length
      119       .
      120       run GetComputerNameA
      121         (input  get-pointer-value(v-buffer-memptr) + 4
      122         ,input  get-pointer-value(v-buffer-memptr)
      123         ,output v-return-value
      124         ) .
      125       if v-return-value <> 0
      126       then do:
      127         assign
      128           p-computer-name = get-string(v-buffer-memptr, 5)
      129         .
      130       end.
      131       assign
      132         put-long(v-buffer-memptr, 1) = v-buffer-length
      133       .
      134       run GetUserNameA
      135         (input  get-pointer-value(v-buffer-memptr) + 4
      136         ,input  get-pointer-value(v-buffer-memptr)
      137         ,output v-return-value
      138         ) .
      139       if v-return-value <> 0
      140       then do:
      141         assign
      142           p-user-name = get-string(v-buffer-memptr, 5)
      143         .
      144       end.
      145       run GetCurrentProcessId
      146         (output p-process-pid
      147         ) .
      148       assign
      149         set-size(v-buffer-memptr) = 0
      150       .
      151     end.
      152   end procedure.
      153   procedure sys-time_get-http :
      154     define output parameter p-http-time as character no-undo .
      155     define variable v-year         as integer   no-undo .
      156     define variable v-month        as integer   no-undo .
      157     define variable v-day-of-week  as integer   no-undo .
      158     define variable v-day          as integer   no-undo .
      159     define variable v-hour         as integer   no-undo .
      160     define variable v-minute       as integer   no-undo .
      161     define variable v-second       as integer   no-undo .
      162     define variable v-milliseconds as integer   no-undo .
      163     do
      164     on error undo, return error return-value
      165     :
      166       run sys-time_get-sys in this-procedure
      167         (output v-year
      168         ,output v-month
      169         ,output v-day
      170         ,output v-hour
      171         ,output v-minute
      172         ,output v-second
      173         ,output v-milliseconds
      174         ) .
      175       assign
      176         v-day-of-week = weekday(date(v-month, v-day, v-year))
      177         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      178                     + ', ':u
      179                     + string(v-day, '99':u)
      180                     + ' ':u
      181                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      182                     + ' ':u
      183                     + string(v-year, '9999':u)
      184                     + ' ':u
      185                     + string(v-hour, '99':u)
      186                     + ':':u
      187                     + string(v-minute, '99':u)
      188                     + ':':u
      189                     + string(v-second, '99':u)
      190                     + ' ':u
      191                     + 'GMT':u
      192       .
      193     end.
      194   end procedure.
      195   procedure sys-time_set-sys :
      196     define input  parameter p-year         as integer   no-undo .
      197     define input  parameter p-month        as integer   no-undo .
      198     define input  parameter p-day          as integer   no-undo .
      199     define input  parameter p-hour         as integer   no-undo .
      200     define input  parameter p-minute       as integer   no-undo .
      201     define input  parameter p-second       as integer   no-undo .
      202     define input  parameter p-milliseconds as integer   no-undo .
      203     define variable v-system-time-structure as memptr    no-undo.
      204     define variable v-return-value as integer   no-undo .
      205     define variable v-day-of-week  as integer   no-undo .
      206     do
      207     on error undo, return error return-value
      208     :
      209       assign
      210         v-day-of-week = weekday(date(p-month, p-day, p-year))
      211       .
      212       assign
      213         set-size(v-system-time-structure) = 16
      214       .
      215       assign
      216         put-short(v-system-time-structure,  1) = p-year
      217         put-short(v-system-time-structure,  3) = p-month
      218         put-short(v-system-time-structure,  5) = v-day-of-week
      219         put-short(v-system-time-structure,  7) = p-day
      220         put-short(v-system-time-structure,  9) = p-hour
      221         put-short(v-system-time-structure, 11) = p-minute
      222         put-short(v-system-time-structure, 13) = p-second
      223         put-short(v-system-time-structure, 15) = p-milliseconds
      224       .
      225       run SetSystemTime
      226         (input  get-pointer-value(v-system-time-structure)
      227         ,output v-return-value
      228         ) .
      229       assign
      230         set-size(v-system-time-structure) = 0
      231       .
      232       if v-return-value = 0
      233       then do:
      234         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      235       end.
      236     end.
      237   end procedure.
      238   procedure sys-time_sys-to-mjd :
      239     define input  parameter p-year         as integer   no-undo .
      240     define input  parameter p-month        as integer   no-undo .
      241     define input  parameter p-day          as integer   no-undo .
      242     define input  parameter p-hour         as integer   no-undo .
      243     define input  parameter p-minute       as integer   no-undo .
      244     define input  parameter p-second       as integer   no-undo .
      245     define input  parameter p-milliseconds as integer   no-undo .
      246     define output parameter p-mjd          as decimal   no-undo .
      247     define variable v-year-correction as decimal   no-undo .
      248     define variable v-shift-year as decimal   no-undo .
      249     do
      250     on error undo, return error return-value
      251     :
      252       assign
      253         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      254         v-shift-year      = decimal(p-year) + v-year-correction
      255         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      256               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      257               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      258               + decimal(p-day) - 2432076.0
      259               + p-hour / 24.0
      260               + p-minute / 1440.0
      261               + p-second / 86400.0
      262               + p-milliseconds / 86400000.0
      263       .
      264     end.
      265   end procedure.
      266   procedure sys-time_sys-to-loc :
      267     define input  parameter p-sys-year         as integer   no-undo .
      268     define input  parameter p-sys-month        as integer   no-undo .
      269     define input  parameter p-sys-day          as integer   no-undo .
      270     define input  parameter p-sys-hour         as integer   no-undo .
      271     define input  parameter p-sys-minute       as integer   no-undo .
      272     define input  parameter p-sys-second       as integer   no-undo .
      273     define input  parameter p-sys-milliseconds as integer   no-undo .
      274     define output parameter p-loc-year         as integer   no-undo .
      275     define output parameter p-loc-month        as integer   no-undo .
      276     define output parameter p-loc-day          as integer   no-undo .
      277     define output parameter p-loc-hour         as integer   no-undo .
      278     define output parameter p-loc-minute       as integer   no-undo .
      279     define output parameter p-loc-second       as integer   no-undo .
      280     define output parameter p-loc-milliseconds as integer   no-undo .
      281     define variable v-system-time-structure as memptr    no-undo.
      282     define variable v-return-value          as integer   no-undo .
      283     define variable v-sys-day-of-week       as integer   no-undo .
      284     do
      285     on error undo, return error return-value
      286     :
      287       assign
      288         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      289       .
      290       assign
      291         set-size(v-system-time-structure) = 32
      292       .
      293       assign
      294         put-short(v-system-time-structure,  1) = p-sys-year
      295         put-short(v-system-time-structure,  3) = p-sys-month
      296         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      297         put-short(v-system-time-structure,  7) = p-sys-day
      298         put-short(v-system-time-structure,  9) = p-sys-hour
      299         put-short(v-system-time-structure, 11) = p-sys-minute
      300         put-short(v-system-time-structure, 13) = p-sys-second
      301         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      302       .
      303       run SystemTimeToTzSpecificLocalTime
      304         (input  0
      305         ,input  get-pointer-value(v-system-time-structure)
      306         ,input  get-pointer-value(v-system-time-structure) + 16
      307         ,output v-return-value
      308         ) .
      309       assign
      310         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      311         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      312         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      313         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      314         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      315         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      316         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      317       .
      318       assign
      319         set-size(v-system-time-structure) = 0
      320       .
      321       if v-return-value = 0
      322       then do:
      323         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      324       end.
      325     end.
      326   end procedure.
      327   procedure sys-time_mjd-to-sys :
      328     define input  parameter p-mjd          as decimal   no-undo .
      329     define output parameter p-year         as integer   no-undo .
      330     define output parameter p-month        as integer   no-undo .
      331     define output parameter p-day          as integer   no-undo .
      332     define output parameter p-hour         as integer   no-undo .
      333     define output parameter p-minute       as integer   no-undo .
      334     define output parameter p-second       as integer   no-undo .
      335     define output parameter p-milliseconds as integer   no-undo .
      336     define variable v-year-correction as decimal   no-undo .
      337     define variable v-shift-year      as decimal   no-undo .
      338     define variable v-conv-date     as date      no-undo .
      339     define variable v-int-part      as integer   no-undo .
      340     define variable v-fraction-part as decimal   no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344       assign
      345         v-int-part      = integer(truncate(p-mjd, 0))
      346         v-fraction-part = p-mjd - v-int-part
      347         v-conv-date     = date(11, 17, 1858) + v-int-part
      348         p-year          = year(v-conv-date)
      349         p-month         = month(v-conv-date)
      350         p-day           = day(v-conv-date)
      351         v-fraction-part = v-fraction-part * 24.0
      352         p-hour          = integer(truncate(v-fraction-part, 0))
      353         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      354         p-minute        = integer(truncate(v-fraction-part, 0))
      355         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      356         p-second        = integer(truncate(v-fraction-part, 0))
      357         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      358         p-milliseconds  = integer(v-fraction-part)
      359       .
      360     end.
      361   end procedure.
      362   procedure sys-time_mjd-to-loc :
      363     define input  parameter p-mjd              as decimal   no-undo .
      364     define output parameter p-loc-year         as integer   no-undo .
      365     define output parameter p-loc-month        as integer   no-undo .
      366     define output parameter p-loc-day          as integer   no-undo .
      367     define output parameter p-loc-hour         as integer   no-undo .
      368     define output parameter p-loc-minute       as integer   no-undo .
      369     define output parameter p-loc-second       as integer   no-undo .
      370     define output parameter p-loc-milliseconds as integer   no-undo .
      371     define variable v-sys-year         as integer   no-undo .
      372     define variable v-sys-month        as integer   no-undo .
      373     define variable v-sys-day          as integer   no-undo .
      374     define variable v-sys-hour         as integer   no-undo .
      375     define variable v-sys-minute       as integer   no-undo .
      376     define variable v-sys-second       as integer   no-undo .
      377     define variable v-sys-milliseconds as integer   no-undo .
      378     do
      379     on error undo, return error return-value
      380     :
      381       run sys-time_mjd-to-sys
      382         (input  p-mjd
      383         ,output v-sys-year
      384         ,output v-sys-month
      385         ,output v-sys-day
      386         ,output v-sys-hour
      387         ,output v-sys-minute
      388         ,output v-sys-second
      389         ,output v-sys-milliseconds
      390         ) .
      391       run sys-time_sys-to-loc
      392         (input  v-sys-year
      393         ,input  v-sys-month
      394         ,input  v-sys-day
      395         ,input  v-sys-hour
      396         ,input  v-sys-minute
      397         ,input  v-sys-second
      398         ,input  v-sys-milliseconds
      399         ,output p-loc-year
      400         ,output p-loc-month
      401         ,output p-loc-day
      402         ,output p-loc-hour
      403         ,output p-loc-minute
      404         ,output p-loc-second
      405         ,output p-loc-milliseconds
      406         ) .
      407     end.
      408   end procedure.
      409   function sys-time_get-mjd-func returns decimal
      410   :
      411     define variable v-year         as integer   no-undo .
      412     define variable v-month        as integer   no-undo .
      413     define variable v-day          as integer   no-undo .
      414     define variable v-hour         as integer   no-undo .
      415     define variable v-minute       as integer   no-undo .
      416     define variable v-second       as integer   no-undo .
      417     define variable v-milliseconds as integer   no-undo .
      418     define variable v-mjd          as decimal   no-undo .
      419     run sys-time_get-sys in this-procedure
      420       (output v-year
      421       ,output v-month
      422       ,output v-day
      423       ,output v-hour
      424       ,output v-minute
      425       ,output v-second
      426       ,output v-milliseconds
      427       ) .
      428     run sys-time_sys-to-mjd in this-procedure
      429       (input  v-year
      430       ,input  v-month
      431       ,input  v-day
      432       ,input  v-hour
      433       ,input  v-minute
      434       ,input  v-second
      435       ,input  v-milliseconds
      436       ,output v-mjd
      437       ) .
      438     return v-mjd .
      439   end function .
      440   function sys-time_get-sys-str-func returns character
      441   :
      442     define variable v-utc-time as character no-undo .
      443     define variable v-year         as integer   no-undo .
      444     define variable v-month        as integer   no-undo .
      445     define variable v-day          as integer   no-undo .
      446     define variable v-hour         as integer   no-undo .
      447     define variable v-minute       as integer   no-undo .
      448     define variable v-second       as integer   no-undo .
      449     define variable v-milliseconds as integer   no-undo .
      450     run sys-time_get-sys in this-procedure
      451       (output v-year
      452       ,output v-month
      453       ,output v-day
      454       ,output v-hour
      455       ,output v-minute
      456       ,output v-second
      457       ,output v-milliseconds
      458       ) .
      459     assign
      460       v-utc-time  = 'UTC ':u
      461                   + string(v-year,         '9999':u)
      462                   + '/':u
      463                   + string(v-month,        '99':u)
      464                   + '/':u
      465                   + string(v-day,          '99':u)
      466                   + ' ':u
      467                   + string(v-hour,         '99':u)
      468                   + ':':u
      469                   + string(v-minute,       '99':u)
      470                   + ':':u
      471                   + string(v-second,       '99':u)
      472                   + ' ':u
      473                   + string(v-milliseconds, '999':u)
      474     .
      475     return v-utc-time.
      476   end function .
      477   function sys-time_mjd-to-loc-str-func returns character
      478     (v-sys-mjd as decimal)
      479   :
      480     define variable v-loc-str          as character no-undo .
      481     define variable v-loc-year         as integer   no-undo .
      482     define variable v-loc-month        as integer   no-undo .
      483     define variable v-loc-day          as integer   no-undo .
      484     define variable v-loc-hour         as integer   no-undo .
      485     define variable v-loc-minute       as integer   no-undo .
      486     define variable v-loc-second       as integer   no-undo .
      487     define variable v-loc-milliseconds as integer   no-undo .
      488     run sys-time_mjd-to-loc in this-procedure
      489       (input  v-sys-mjd
      490       ,output v-loc-year
      491       ,output v-loc-month
      492       ,output v-loc-day
      493       ,output v-loc-hour
      494       ,output v-loc-minute
      495       ,output v-loc-second
      496       ,output v-loc-milliseconds
      497       ) .
      498     assign
      499       v-loc-str = substitute('&1/&2/&3 &4:&5'
      500                             ,string(v-loc-day,    '99':U)
      501                             ,string(v-loc-month,  '99':U)
      502                             ,string(v-loc-year,   '9999':U)
      503                             ,string(v-loc-hour,   '99':U)
      504                             ,string(v-loc-minute, '99':U)
      505                             )
      506     .
      507     return v-loc-str .
      508   end function .
      509   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      510   :
      511     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      512   END PROCEDURE.
      513   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      514   :
      515     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      516     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      517   END PROCEDURE.
      518   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      519   :
      520     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      521     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      522   END PROCEDURE.
      523   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      524   :
      525     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      526     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      527     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      528     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      529   END PROCEDURE.
      530   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      531   :
      532     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      533     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      534     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      535   END PROCEDURE.
      536   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      537   :
      538     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      539     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      540     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      541   END PROCEDURE.
      542   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      543   :
      544     DEFINE RETURN PARAMETER RetVal          AS LONG.
      545   END PROCEDURE.
      546   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   procedure get-ro_get-read-only :
      548     define output parameter p-ro-set as logical   no-undo .
      549     do
      550     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info1, return-value, error-status :get-message( 1 ) )
      551     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info1 )
      552     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info1 )
      553     :
      554       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      555       then do:
      556         assign
      557           p-ro-set = true
      558         .
      559       end.
      560       else do:
      561         assign
      562           p-ro-set = false
      563         .
      564       end.
      565     end.
      566   end procedure.
      567   define variable v-user-context-history-id as integer   no-undo .
      568   define variable v-current-mjd             as decimal   no-undo .
      569   define variable v-last-group-menu         as character    no-undo .
      570   define variable v-cntxt-menu-group-id     as character    no-undo .
      571   define variable v-cntxt-menu-code         as integer      no-undo.
      572   define variable v-get-ro_read-only        as logical   no-undo .
      573   define buffer buf_menu-group           for ub.menu-group .
      574   define buffer buf_user-login           for ub.user-login .
      575   define buffer buf_user-context-history for ubflt.user-context-history .
      576   do
      577   on error undo, return error return-value
      578   :
      579     assign
      580       v-get-ro_read-only = false
      581     .
      582     run get-ro_get-read-only in this-procedure
      583       ( output v-get-ro_read-only
      584       ) .
      585     if v-get-ro_read-only = false then do:
      586       find first buf_user-login exclusive-lock
      587         where buf_user-login.db-num  = p-cntxt-db-num
      588           and buf_user-login.user-id = p-cntxt-user-id
      589         no-error .
      590     end.
      591     else do:
      592       find first buf_user-login no-lock
      593         where buf_user-login.db-num  = p-cntxt-db-num
      594           and buf_user-login.user-id = p-cntxt-user-id
      595         no-error .
      596     end.
      597     if not available buf_user-login
      598     then do:
      599       message
      600         vss-workfile vss-revision vss-description skip
      601         "Не найден логин пользователя" skip
      602         "База данных" p-cntxt-db-num skip
      603         "Идентификатор пользователя" p-cntxt-user-id skip
      604         view-as alert-box error .
      605       undo, return error return-value .
      606     end.
      607     find first buf_menu-group no-lock
      608       where buf_menu-group.menu-code       = p-cntxt-menu-code
      609         and buf_menu-group.menu-group-code = p-cntxt-menu-group-code
      610       no-error .
      611     if not available buf_menu-group
      612     then do:
      613       message
      614         vss-workfile vss-revision vss-description skip
      615         "Не найдена группа пунктов меню" skip
      616         "Код меню" p-cntxt-menu-code skip
      617         "Код группы пунктов меню" p-cntxt-menu-group-code skip
      618         view-as alert-box error .
      619       undo, return error return-value .
      620     end.
      621     assign
      622         v-cntxt-menu-group-id = buf_menu-group.menu-group-id
      623         v-cntxt-menu-code     = buf_menu-group.menu-group-code
      624     .
      625     find last buf_user-context-history exclusive-lock
      626       where buf_user-context-history.db-num  = p-cntxt-db-num
      627         and buf_user-context-history.user-id = p-cntxt-user-id
      628       no-error .
      629     if available buf_user-context-history
      630     then do:
      631       assign
      632         v-user-context-history-id = buf_user-context-history.user-context-history-id + 1
      633         v-last-group-menu         = buf_user-context-history.cntxt-menu-group-id
      634       .
      635     end.
      636     else do:
      637       assign
      638         v-user-context-history-id = 1
      639       .
      640     end.
      641     assign
      642       v-current-mjd = sys-time_get-mjd-func()
      643     .
      644     if v-get-ro_read-only = false then do:
      645       assign
      646         buf_user-login.cntxt-menu-code     = v-cntxt-menu-code
      647         buf_user-login.cntxt-menu-group-id = v-cntxt-menu-group-id
      648       .
      649     end.
      650     create buf_user-context-history .
      651     assign
      652       buf_user-context-history.db-num                  = p-cntxt-db-num
      653       buf_user-context-history.user-id                 = p-cntxt-user-id
      654       buf_user-context-history.user-context-history-id = v-user-context-history-id
      655       buf_user-context-history.cntxt-change-mjd        = v-current-mjd
      656       buf_user-context-history.cntxt-level             = p-cntxt-level
      657       buf_user-context-history.cntxt-host-code         = p-cntxt-host-code-obj
      658       buf_user-context-history.cntxt-obj-type          = p-cntxt-obj-type
      659       buf_user-context-history.cntxt-obj-code          = p-cntxt-obj-code
      660       buf_user-context-history.cntxt-menu-code         = p-cntxt-menu-code
      661       buf_user-context-history.cntxt-menu-group-id     = buf_menu-group.menu-group-id
      662     .
      663   end.
