        1   DEFINE TEMP-TABLE tt-table NO-UNDO LIKE ub.rep-line
        2          field str as character
        3          field gds-code as integer
        4          index pi is primary unique  gds-code
        5          .
        6   define input  PARAMETER TABLE FOR tt-table.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Сообщение о не включенных товарах".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   DEFINE BUTTON B-Cancel AUTO-END-KEY
      117        LABEL "Выход"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON B-Help
      121        LABEL "&Help"
      122        SIZE 3 BY 1
      123        BGCOLOR 8 .
      124   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      125        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      126        SIZE 98 BY 4
      127        FGCOLOR 4  NO-UNDO.
      128   DEFINE QUERY BROWSE-2 FOR
      129         tt-table SCROLLING.
      130   DEFINE BROWSE BROWSE-2
      131     QUERY BROWSE-2 DISPLAY
      132         tt-table.gds-code FORMAT ">>>>>>>>>9"
      133         tt-table.str      FORMAT "X(250)"
      134       WITH NO-BOX NO-LABELS NO-ROW-MARKERS SIZE 98 BY 17.5 ROW-HEIGHT-CHARS .6 FIT-LAST-COLUMN.
      135   DEFINE FRAME Dialog-Frame
      136        B-Cancel AT ROW 1 COL 1
      137        B-Help AT ROW 1 COL 96
      138        BROWSE-2 AT ROW 2 COL 1 WIDGET-ID 200
      139        EDITOR-1 AT ROW 19.5 COL 1 NO-LABEL WIDGET-ID 2
      140        SPACE(0.24) SKIP(0.03)
      141       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      142            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      143            TITLE "Сообщение о не включенных товарах"
      144            CANCEL-BUTTON B-Cancel WIDGET-ID 100.
      145   ASSIGN
      146          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      147          FRAME Dialog-Frame:HIDDEN           = TRUE.
      148   ASSIGN
      149          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      150   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      151   DO:
      152     APPLY "END-ERROR":U TO SELF.
      153   END.
      154   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      155   OR HELP OF FRAME Dialog-Frame
      156   DO:
      157   END.
      158   ON VALUE-CHANGED OF BROWSE-2 IN FRAME Dialog-Frame
      159   DO:
      160      IF AVAILABLE tt-table THEN DO:
      161          EDITOR-1 = tt-table.str .
      162          DISPLAY  EDITOR-1 WITH FRAME Dialog-Frame.
      163      END.
      164   END.
      165   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      166   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      167   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   on help of frame Dialog-Frame
      169   do:
      170     run gbl/app_help.p
      171       (input this-procedure :file-name
      172       ,input ''
      173       ,input ?
      174       ) no-error.
      175     if error-status :error then do:
      176       message
      177         "Ошибка при вызове помощи"
      178         error-status :get-message(1)
      179         view-as alert-box .
      180     end.
      181   end.
      182   run minbtn-set in this-procedure .
      183   on choose of b-help in frame Dialog-Frame
      184   do:
      185     apply "help":u to frame Dialog-Frame .
      186   end.
      187   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   procedure minbtn-set :
      189       do
      190           on error undo, return error return-value
      191           :
      192           define variable ii              as integer       no-undo .
      193           define variable fh              as widget-handle no-undo .
      194           define variable hh              as widget-handle no-undo .
      195           define variable v-h             as handle        extent 4 no-undo .
      196           define variable v-name-button   as character     no-undo .
      197           define variable v-help-old-x    as decimal       no-undo .
      198           define variable v-help-old-y    as decimal       no-undo .
      199           define variable v-help-old-size as decimal       no-undo .
      200           define variable v-frame-width   as decimal       no-undo .
      201           define variable jj              as integer       no-undo .
      202           do
      203               on error undo, return error
      204               :
      205               assign
      206                   v-frame-width = frame Dialog-Frame:width - 0.3
      207                   fh            = frame Dialog-Frame:first-child
      208                   hh            = fh:first-child
      209                   ii            = 1
      210                   .
      211               do while valid-handle(hh):
      212                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      213                   do:
      214                       case lc(hh:name) :
      215                           when "b-help" then
      216                               do:
      217                                   hh:load-image-up("cmp/b-help.bmp":u) .
      218                                   hh:load-image-down("cmp/b-help.bmp":u) .
      219                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      220                                   hh:TOOLTIP = "Помощь" .
      221                                   v-help-old-x = hh:column .
      222                                   v-help-old-y = hh:row    .
      223                                   v-help-old-size = hh:width .
      224                                   hh:width-chars = 2.5 .
      225                               end.
      226                           when "b-print" then
      227                               do:
      228                                   hh:load-image("cmp/b-print.bmp":u) .
      229                                   hh:TOOLTIP = "Печать" .
      230                                   v-h[ii] = hh:handle .
      231                                   ii = ii + 1 .
      232                                   hh:width-chars = 3 .
      233                               end.
      234                           when "b-history" or
      235                           when "b-hist" then
      236                               do:
      237                                   hh:load-image("cmp/b-hist.bmp":u) .
      238                                   hh:TOOLTIP = "История" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-sch" then
      244                               do:
      245                                   hh:load-image("cmp/b-sch.bmp":u) .
      246                                   hh:TOOLTIP = "Установка Фильтра" .
      247                                   v-h[ii] = hh:handle .
      248                                   ii = ii + 1 .
      249                                   hh:width-chars = 3 .
      250                               end.
      251                           when "b-hist-user" then
      252                               do:
      253                                   hh:load-image("cmp/b-hist.bmp":u) .
      254                                   hh:TOOLTIP = "История пользователя" .
      255                                   ii = ii + 1 .
      256                               end.
      257                       end case.
      258                   end.
      259                   hh = hh:next-sibling.
      260               end.
      261               b-help:column = v-frame-width - b-help:width-chars.
      262               jj = 0.
      263               repeat ii = 4 to 1 by -1 :
      264                   if valid-handle (v-h[ii] ) then
      265                   do:
      266                       jj  = jj + 1 .
      267                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      268                       v-h[ii]:row    = v-help-old-y .
      269                   end.
      270               end.
      271           end.
      272       end.
      273   end procedure.
      274   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      275   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      276   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      277   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      278   define variable v-diasize-current-frame-width  as decimal   no-undo .
      279   define variable v-diasize-current-frame-height as decimal   no-undo .
      280   define variable v-diasize-change-size          as logical   no-undo .
      281   define variable v-diasize-resize-button        as handle    no-undo .
      282   define variable v-diasize-wndmax               as logical   no-undo .
      283   define variable v-diasize-wndstore             as logical   no-undo .
      284   define variable v-diasize-proc-name            as character no-undo .
      285   define variable v-diasize-browse-handle        as handle    no-undo .
      286   define variable v-diasize-browse-number        as integer   no-undo .
      287   define variable v-diasize-need-full-display    as logical   no-undo init false .
      288   define temp-table temp-diasize-handle no-undo
      289     field handle-value  as handle
      290     field save-position as decimal
      291     index xpk is primary unique handle-value
      292     .
      293   define temp-table temp-browse-handle no-undo
      294     field browse-type   as character
      295     field browse-number as integer
      296     field browse-handle as handle
      297     field original-size as decimal
      298     index xpk is primary unique browse-type browse-number
      299     index xie browse-type browse-handle
      300   .
      301   procedure diasize_change-height :
      302     define input  parameter p-change-value  as decimal   no-undo .
      303     define input  parameter p-move-resize   as logical   no-undo .
      304     define variable v-field-group-handle    as handle    no-undo .
      305     define variable v-object-handle         as handle    no-undo .
      306     define variable v-frame-height          as decimal   no-undo .
      307     define variable v-frame-virtual-height  as decimal   no-undo .
      308     define variable v-browse-height         as decimal   no-undo .
      309     define variable v-window-height         as decimal   no-undo .
      310     define variable v-window-virtual-height as decimal   no-undo .
      311     define variable v-change-sign           as integer   no-undo .
      312     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      313     define buffer buf_temp-browse-handle  for temp-browse-handle .
      314     if p-change-value > 0
      315     then do:
      316       if frame Dialog-Frame :height + p-change-value
      317           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      318       then do:
      319         assign
      320           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      321                           - (frame Dialog-Frame :height-chars)
      322         .
      323         if p-change-value <= 0
      324         then do:
      325           run diasize_position-resize-button in this-procedure .
      326           return .
      327         end.
      328       end.
      329     end.
      330     if p-change-value < 0
      331     then do:
      332       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      333       then do:
      334         assign
      335           p-change-value = v-diasize-orig-frame-height
      336                          - (frame Dialog-Frame :height-chars)
      337         .
      338         if p-change-value >= 0
      339         then do:
      340           run diasize_position-resize-button in this-procedure .
      341           return .
      342         end.
      343       end.
      344     end.
      345     if p-change-value >= 0
      346     then do:
      347       assign
      348         v-change-sign = 1
      349       .
      350     end.
      351     else do:
      352       assign
      353         v-change-sign = -1
      354       .
      355     end.
      356     assign
      357       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      358     .
      359     if p-change-value = 0
      360     then do:
      361       run diasize_position-resize-button in this-procedure .
      362       return .
      363     end.
      364     move_block:
      365     do
      366     on error undo move_block, retry move_block
      367     :
      368       if retry
      369       then do:
      370         do
      371         on error undo move_block, leave move_block
      372         :
      373           if p-change-value > 0
      374           then do:
      375             for each buf_temp-diasize-handle
      376             on error undo, next
      377             :
      378               assign
      379                 v-object-handle = buf_temp-diasize-handle.handle-value
      380               .
      381               if v-object-handle <> v-diasize-resize-button
      382               then do:
      383                 assign
      384                   v-object-handle :row = buf_temp-diasize-handle.save-position
      385                 .
      386               end.
      387             end.
      388             assign
      389               v-diasize-browse-handle :height = v-browse-height
      390             .
      391             for each buf_temp-browse-handle
      392               where buf_temp-browse-handle.browse-type = 'height':u
      393             on error undo, next
      394             :
      395               assign
      396                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      397               .
      398             end.
      399             assign
      400               frame Dialog-Frame :height = v-frame-height
      401             .
      402             if frame Dialog-Frame :scrollable = true
      403             then do:
      404               assign
      405                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      406               .
      407             end.
      408             run diasize_position-resize-button in this-procedure .
      409           end.
      410           else do:
      411             if frame Dialog-Frame :scrollable = true
      412             then do:
      413               assign
      414                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      415               .
      416             end.
      417             assign
      418               frame Dialog-Frame :height = v-frame-height
      419             .
      420             assign
      421               v-diasize-browse-handle :height = v-browse-height
      422             .
      423             for each buf_temp-browse-handle
      424               where buf_temp-browse-handle.browse-type = 'height':u
      425             on error undo, next
      426             :
      427               assign
      428                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      429               .
      430             end.
      431             for each buf_temp-diasize-handle
      432             on error undo, next
      433             :
      434               assign
      435                 v-object-handle = buf_temp-diasize-handle.handle-value
      436               .
      437               if v-object-handle <> v-diasize-resize-button
      438               then do:
      439                 assign
      440                   v-object-handle :row = buf_temp-diasize-handle.save-position
      441                 .
      442               end.
      443             end.
      444             run diasize_position-resize-button in this-procedure .
      445           end.
      446           assign
      447             v-diasize-change-size = false
      448           .
      449           leave move_block .
      450         end.
      451       end.
      452       assign
      453         v-diasize-need-full-display = true
      454       .
      455       if v-diasize-change-size = false
      456       then do:
      457         assign
      458           v-diasize-change-size = true
      459         .
      460       end.
      461       else do:
      462         return .
      463       end.
      464       assign
      465         v-frame-height = frame Dialog-Frame :height
      466         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      467         v-browse-height = v-diasize-browse-handle :height
      468       .
      469       for each buf_temp-browse-handle
      470         where buf_temp-browse-handle.browse-type = 'height':u
      471       :
      472         assign
      473           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      474         .
      475       end.
      476       for each buf_temp-diasize-handle
      477       :
      478         delete buf_temp-diasize-handle .
      479       end.
      480       assign
      481         v-field-group-handle = frame Dialog-Frame :first-child
      482       .
      483       do while valid-handle(v-field-group-handle)
      484       :
      485         assign
      486           v-object-handle = v-field-group-handle :first-child
      487         .
      488         do while valid-handle(v-object-handle)
      489         :
      490           if  v-object-handle <> v-diasize-browse-handle :handle
      491           and can-query(v-object-handle, "row")
      492           and can-query(v-object-handle, "height")
      493           and ( v-object-handle :row > v-diasize-browse-handle :row )
      494           then do:
      495             find first buf_temp-browse-handle
      496               where buf_temp-browse-handle.browse-type   = 'height':u
      497                 and buf_temp-browse-handle.browse-handle = v-object-handle
      498               no-error .
      499             if available buf_temp-browse-handle
      500             then do:
      501             end.
      502             else do:
      503               create buf_temp-diasize-handle .
      504               assign
      505                 buf_temp-diasize-handle.handle-value  = v-object-handle
      506                 buf_temp-diasize-handle.save-position = v-object-handle :row
      507               .
      508             end.
      509           end.
      510           assign
      511             v-object-handle = v-object-handle :next-sibling
      512           .
      513         end.
      514         assign
      515           v-field-group-handle = v-field-group-handle :next-sibling
      516         .
      517       end.
      518       do with frame Dialog-Frame
      519       :
      520         hide v-diasize-resize-button .
      521         assign
      522           v-diasize-resize-button :row    = 1
      523           v-diasize-resize-button :column = 1
      524         .
      525       end.
      526       if p-change-value > 0
      527       then do:
      528         if frame Dialog-Frame :scrollable = true
      529         then do:
      530           assign
      531             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      532             no-error .
      533           if error-status :error
      534           or error-status :get-message(1) <> ""
      535           then do:
      536             undo move_block, retry move_block .
      537           end.
      538         end.
      539         assign
      540           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      541           no-error .
      542         if error-status :error
      543         or error-status :get-message(1) <> ""
      544         then do:
      545           undo move_block, retry move_block .
      546         end.
      547         assign
      548           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      549           no-error .
      550         if error-status :error
      551         or error-status :get-message(1) <> ""
      552         then do:
      553           undo move_block, retry move_block .
      554         end.
      555         for each buf_temp-browse-handle
      556           where buf_temp-browse-handle.browse-type = 'height':u
      557         on error undo move_block, retry move_block
      558         :
      559           assign
      560             buf_temp-browse-handle.browse-handle :height
      561               = buf_temp-browse-handle.browse-handle :height + p-change-value
      562             no-error .
      563           if error-status :error
      564           or error-status :get-message(1) <> ""
      565           then do:
      566             undo move_block, retry move_block .
      567           end.
      568         end.
      569         for each buf_temp-diasize-handle
      570         on error undo move_block, retry move_block
      571         :
      572           assign
      573             v-object-handle = buf_temp-diasize-handle.handle-value
      574           .
      575           if v-object-handle <> v-diasize-resize-button
      576           then do:
      577             assign
      578               v-object-handle :row = v-object-handle :row + p-change-value
      579               no-error .
      580             if error-status :error
      581             or error-status :get-message(1) <> ""
      582             then do:
      583               undo move_block, retry move_block .
      584             end.
      585           end.
      586         end.
      587       end.
      588       else do:
      589         for each buf_temp-diasize-handle
      590         on error undo move_block, retry move_block
      591         :
      592           assign
      593             v-object-handle = buf_temp-diasize-handle.handle-value
      594           .
      595           if v-object-handle <> v-diasize-resize-button
      596           then do:
      597             assign
      598               v-object-handle :row = v-object-handle :row + p-change-value
      599               no-error .
      600             if error-status :error
      601             or error-status :get-message(1) <> ""
      602             then do:
      603               undo move_block, retry move_block .
      604             end.
      605           end.
      606         end.
      607         assign
      608           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      609           no-error .
      610         if error-status :error
      611         or error-status :get-message(1) <> ""
      612         then do:
      613           undo move_block, retry move_block .
      614         end.
      615         for each buf_temp-browse-handle
      616           where buf_temp-browse-handle.browse-type = 'height':u
      617         on error undo move_block, retry move_block
      618         :
      619           assign
      620             buf_temp-browse-handle.browse-handle :height
      621               = buf_temp-browse-handle.browse-handle :height + p-change-value
      622             no-error .
      623           if error-status :error
      624           or error-status :get-message(1) <> ""
      625           then do:
      626             undo move_block, retry move_block .
      627           end.
      628         end.
      629         assign
      630           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      631           no-error .
      632         if error-status :error
      633         or error-status :get-message(1) <> ""
      634         then do:
      635           undo move_block, retry move_block .
      636         end.
      637         if frame Dialog-Frame :scrollable = true
      638         then do:
      639           assign
      640             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      641             no-error .
      642           if error-status :error
      643           or error-status :get-message(1) <> ""
      644           then do:
      645             undo move_block, retry move_block .
      646           end.
      647         end.
      648       end.
      649       if p-move-resize = true
      650       then do:
      651         run diasize_position-resize-button in this-procedure .
      652       end.
      653       if v-diasize-wndstore = true
      654       then do:
      655         if connected("ub") = true
      656         then do:
      657           define variable v-cntxt-db-num        as integer   no-undo .
      658           define variable v-cntxt-userid        as character no-undo .
      659           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      660                                             , OUTPUT v-cntxt-userid
      661                                             ) .
      662           run gbl/wndsizew.p
      663             (input  v-cntxt-db-num
      664             ,input  v-cntxt-userid
      665             ,input  v-diasize-proc-name
      666             ,input  'height':u
      667             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      668             ) .
      669         end.
      670       end.
      671     end.
      672     assign
      673       v-diasize-change-size = false
      674     .
      675   end procedure.
      676   procedure diasize_set-height :
      677     define input  parameter p-new-height  as decimal   no-undo .
      678     define input  parameter p-move-resize as logical   no-undo .
      679     do
      680     on error undo, return error return-value
      681     :
      682       run diasize_change-height in this-procedure
      683         (input  (p-new-height - frame Dialog-Frame :height)
      684         ,input  p-move-resize
      685         ) .
      686     end.
      687   end procedure.
      688   procedure diasize_change-width :
      689     define input  parameter p-change-value as decimal   no-undo .
      690     define input  parameter p-move-resize  as logical   no-undo .
      691     define variable v-field-group-handle   as handle    no-undo .
      692     define variable v-object-handle        as handle    no-undo .
      693     define variable v-frame-width          as decimal   no-undo .
      694     define variable v-frame-virtual-width  as decimal   no-undo .
      695     define variable v-browse-width         as decimal   no-undo .
      696     define variable v-window-width         as decimal   no-undo .
      697     define variable v-window-virtual-width as decimal   no-undo .
      698     define variable v-change-sign          as integer   no-undo .
      699     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      700     define buffer buf_temp-browse-handle  for temp-browse-handle .
      701     if p-change-value > 0
      702     then do:
      703       if frame Dialog-Frame :width + p-change-value >
      704           session :width-chars
      705       then do:
      706         assign
      707           p-change-value = session :width-chars - frame Dialog-Frame :width
      708         .
      709         if p-change-value <= 0
      710         then do:
      711           run diasize_position-resize-button in this-procedure .
      712           return .
      713         end.
      714       end.
      715     end.
      716     if p-change-value < 0
      717     then do:
      718       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      719       then do:
      720         assign
      721           p-change-value = v-diasize-orig-frame-width
      722                          - frame Dialog-Frame :width
      723         .
      724         if p-change-value >= 0
      725         then do:
      726           run diasize_position-resize-button in this-procedure .
      727           return .
      728         end.
      729       end.
      730     end.
      731     if p-change-value >= 0
      732     then do:
      733       assign
      734         v-change-sign = 1
      735       .
      736     end.
      737     else do:
      738       assign
      739         v-change-sign = -1
      740       .
      741     end.
      742     assign
      743       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      744     .
      745     if p-change-value = 0
      746     then do:
      747       run diasize_position-resize-button in this-procedure .
      748       return .
      749     end.
      750     move_block:
      751     do
      752     on error undo move_block, leave move_block
      753     :
      754       if retry
      755       then do:
      756         do
      757         on error undo move_block, leave move_block
      758         :
      759           if p-change-value > 0
      760           then do:
      761             for each buf_temp-diasize-handle
      762             on error undo, next
      763             :
      764               assign
      765                 v-object-handle = buf_temp-diasize-handle.handle-value
      766               .
      767               if v-object-handle <> v-diasize-resize-button
      768               then do:
      769                 assign
      770                   v-object-handle :col = buf_temp-diasize-handle.save-position
      771                 .
      772               end.
      773             end.
      774             assign
      775               v-diasize-browse-handle :width = v-browse-width
      776             .
      777             for each buf_temp-browse-handle
      778               where buf_temp-browse-handle.browse-type = 'width':u
      779             on error undo, next
      780             :
      781               assign
      782                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      783               .
      784             end.
      785             assign
      786               frame Dialog-Frame :width = v-frame-width
      787             .
      788             if frame Dialog-Frame :scrollable = true
      789             then do:
      790               assign
      791                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      792               .
      793             end.
      794             run diasize_position-resize-button in this-procedure .
      795           end.
      796           else do:
      797             if frame Dialog-Frame :scrollable = true
      798             then do:
      799               assign
      800                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      801               .
      802             end.
      803             assign
      804               frame Dialog-Frame :width = v-frame-width
      805             .
      806             for each buf_temp-browse-handle
      807               where buf_temp-browse-handle.browse-type = 'width':u
      808             on error undo, next
      809             :
      810               assign
      811                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      812               .
      813             end.
      814             assign
      815               v-diasize-browse-handle :width = v-browse-width
      816             .
      817             for each buf_temp-diasize-handle
      818             on error undo, next
      819             :
      820               assign
      821                 v-object-handle = buf_temp-diasize-handle.handle-value
      822               .
      823               if v-object-handle <> v-diasize-resize-button
      824               then do:
      825                 assign
      826                   v-object-handle :col = buf_temp-diasize-handle.save-position
      827                 .
      828               end.
      829             end.
      830             run diasize_position-resize-button in this-procedure .
      831           end.
      832           assign
      833             v-diasize-change-size = false
      834           .
      835           leave move_block .
      836         end.
      837       end.
      838       assign
      839         v-diasize-need-full-display = true
      840       .
      841       if v-diasize-change-size = false
      842       then do:
      843         assign
      844           v-diasize-change-size = true
      845         .
      846       end.
      847       else do:
      848         return .
      849       end.
      850       assign
      851         v-frame-width = frame Dialog-Frame :width
      852         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      853         v-browse-width = v-diasize-browse-handle :width
      854       .
      855       for each buf_temp-browse-handle
      856         where buf_temp-browse-handle.browse-type = 'width':u
      857       :
      858         assign
      859           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      860         .
      861       end.
      862       for each buf_temp-diasize-handle
      863       :
      864         delete buf_temp-diasize-handle .
      865       end.
      866       assign
      867         v-field-group-handle = frame Dialog-Frame :first-child
      868       .
      869       do while valid-handle(v-field-group-handle)
      870       :
      871         assign
      872           v-object-handle = v-field-group-handle :first-child
      873         .
      874         do while valid-handle(v-object-handle)
      875         :
      876           if  v-object-handle <> v-diasize-browse-handle :handle
      877           and v-object-handle <> v-diasize-resize-button
      878           and can-query(v-object-handle, "row")
      879           and can-query(v-object-handle, "height")
      880           and ( v-object-handle :col + v-object-handle :width
      881                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      882               )
      883           then do:
      884             find first buf_temp-browse-handle
      885               where buf_temp-browse-handle.browse-type   = 'width':u
      886                 and buf_temp-browse-handle.browse-handle = v-object-handle
      887               no-error .
      888             if available buf_temp-browse-handle
      889             then do:
      890             end.
      891             else do:
      892               create buf_temp-diasize-handle .
      893               assign
      894                 buf_temp-diasize-handle.handle-value  = v-object-handle
      895                 buf_temp-diasize-handle.save-position = v-object-handle :col
      896               .
      897             end.
      898           end.
      899           assign
      900             v-object-handle = v-object-handle :next-sibling
      901           .
      902         end.
      903         assign
      904           v-field-group-handle = v-field-group-handle :next-sibling
      905         .
      906       end.
      907       do with frame Dialog-Frame
      908       :
      909         hide v-diasize-resize-button .
      910         v-diasize-resize-button :row = 1.
      911         v-diasize-resize-button :column = 1.
      912       end.
      913       if p-change-value > 0
      914       then do:
      915         if frame Dialog-Frame :scrollable = true
      916         then do:
      917           assign
      918             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      919             no-error .
      920           if error-status :error
      921           or error-status :get-message(1) <> ""
      922           then do:
      923             undo move_block, retry move_block.
      924           end.
      925         end.
      926         assign
      927           frame Dialog-Frame :width = v-frame-width + p-change-value
      928           no-error .
      929         if error-status :error
      930         or error-status :get-message(1) <> ""
      931         then do:
      932           undo move_block, retry move_block.
      933         end.
      934         assign
      935           v-diasize-browse-handle :width = v-browse-width + p-change-value
      936         no-error .
      937         if error-status :error
      938         or error-status :get-message(1) <> ""
      939         then do:
      940           undo move_block, retry move_block.
      941         end.
      942         for each buf_temp-browse-handle
      943           where buf_temp-browse-handle.browse-type = 'width':u
      944         on error undo move_block, retry move_block
      945         :
      946           assign
      947             buf_temp-browse-handle.browse-handle :width
      948               = buf_temp-browse-handle.browse-handle :width + p-change-value
      949             no-error .
      950           if error-status :error
      951           or error-status :get-message(1) <> ""
      952           then do:
      953             undo move_block, retry move_block .
      954           end.
      955         end.
      956         for each buf_temp-diasize-handle
      957         on error undo move_block, retry move_block
      958         :
      959           assign
      960             v-object-handle = buf_temp-diasize-handle.handle-value
      961           .
      962           if v-object-handle <> v-diasize-resize-button
      963           then do:
      964             assign
      965               v-object-handle :col = v-object-handle :col + p-change-value
      966               no-error .
      967             if error-status :error
      968             or error-status :get-message(1) <> ""
      969             then do:
      970               undo move_block, retry move_block .
      971             end.
      972           end.
      973         end.
      974       end.
      975       else do:
      976         for each buf_temp-diasize-handle
      977         on error undo move_block, retry move_block
      978         :
      979           assign
      980             v-object-handle = buf_temp-diasize-handle.handle-value
      981           .
      982           if v-object-handle <> v-diasize-resize-button
      983           then do:
      984             assign
      985               v-object-handle :col = v-object-handle :col + p-change-value
      986               no-error .
      987             if error-status :error
      988             or error-status :get-message(1) <> ""
      989             then do:
      990               undo move_block, retry move_block .
      991             end.
      992           end.
      993         end.
      994         for each buf_temp-browse-handle
      995           where buf_temp-browse-handle.browse-type = 'width':u
      996         on error undo move_block, retry move_block
      997         :
      998           assign
      999             buf_temp-browse-handle.browse-handle :width
     1000               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1001             no-error .
     1002           if error-status :error
     1003           or error-status :get-message(1) <> ""
     1004           then do:
     1005             undo move_block, retry move_block .
     1006           end.
     1007         end.
     1008         assign
     1009           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1010           no-error .
     1011         if error-status :error
     1012         or error-status :get-message(1) <> ""
     1013         then do:
     1014           undo move_block, retry move_block.
     1015         end.
     1016         assign
     1017           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1018         no-error .
     1019         if error-status :error
     1020         or error-status :get-message(1) <> ""
     1021         then do:
     1022           undo move_block, retry move_block.
     1023         end.
     1024         if frame Dialog-Frame :scrollable = true
     1025         then do:
     1026           assign
     1027             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1028           no-error .
     1029           if error-status :error
     1030           or error-status :get-message(1) <> ""
     1031           then do:
     1032             undo move_block, retry move_block.
     1033           end.
     1034         end.
     1035       end.
     1036       if p-move-resize
     1037       then do:
     1038         run diasize_position-resize-button in this-procedure .
     1039       end.
     1040       if v-diasize-wndstore = true
     1041       then do:
     1042         if connected("ub") = true
     1043         then do:
     1044           define variable v-cntxt-db-num        as integer   no-undo .
     1045           define variable v-cntxt-userid        as character no-undo .
     1046           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1047                                             , OUTPUT v-cntxt-userid
     1048                                             ) .
     1049           run gbl/wndsizew.p
     1050             (input  v-cntxt-db-num
     1051             ,input  v-cntxt-userid
     1052             ,input  v-diasize-proc-name
     1053             ,input  'width':u
     1054             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1055             ) .
     1056         end.
     1057       end.
     1058     end.
     1059     assign
     1060       v-diasize-change-size = false
     1061     .
     1062   end procedure.
     1063   procedure diasize_set-width :
     1064     define input  parameter p-new-width  as decimal   no-undo .
     1065     define input  parameter p-move-resize as logical   no-undo .
     1066     do
     1067     on error undo, return error return-value
     1068     :
     1069       run diasize_change-width in this-procedure
     1070         (input  (p-new-width - frame Dialog-Frame :width)
     1071         ,input  p-move-resize
     1072         ) .
     1073     end.
     1074   end procedure.
     1075   procedure diasize_position-resize-button :
     1076     do with frame Dialog-Frame
     1077     :
     1078       hide v-diasize-resize-button .
     1079       assign
     1080         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1081                     - 1
     1082                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1083         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1084                     - 1
     1085                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1086       .
     1087       view v-diasize-resize-button .
     1088     end.
     1089   end procedure.
     1090   on alt-right anywhere
     1091   do:
     1092     run diasize_change-width in this-procedure
     1093       (input 1
     1094       ,input true
     1095       ) .
     1096     return no-apply .
     1097   end.
     1098   on alt-left anywhere
     1099   do:
     1100     run diasize_change-width in this-procedure
     1101       (input -1
     1102       ,input true
     1103       ) .
     1104     return no-apply .
     1105   end.
     1106   on alt-down anywhere
     1107   do:
     1108     run diasize_change-height in this-procedure
     1109       (input 1
     1110       ,input true
     1111       ) .
     1112     return no-apply .
     1113   end.
     1114   on alt-up anywhere
     1115   do:
     1116     run diasize_change-height in this-procedure
     1117       (input -1
     1118       ,input true
     1119       ) .
     1120     return no-apply .
     1121   end.
     1122   on alt-enter of frame Dialog-Frame
     1123   do:
     1124     run diasize_maximize in this-procedure
     1125       (input  ?
     1126       ).
     1127     return no-apply .
     1128   end.
     1129   procedure diasize_end-move :
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133       define variable v-row-delta as decimal   no-undo .
     1134       define variable v-col-delta as decimal   no-undo .
     1135       define variable v-new-row as decimal   no-undo .
     1136       define variable v-new-col as decimal   no-undo .
     1137       assign
     1138         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1139         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1140       .
     1141       assign
     1142         v-row-delta = v-new-row - frame Dialog-Frame :height
     1143         v-col-delta = v-new-col - frame Dialog-Frame :width
     1144       .
     1145       run diasize_change-height in this-procedure
     1146         (input v-row-delta
     1147         ,input true
     1148         ) .
     1149       run diasize_change-width in this-procedure
     1150         (input v-col-delta
     1151         ,input true
     1152         ) .
     1153     end.
     1154   end procedure.
     1155   procedure diasize_maximize :
     1156     define input  parameter p-action as logical   no-undo .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       if p-action = ?
     1161       then do:
     1162         if v-diasize-need-maximize = true
     1163         then do:
     1164           assign
     1165             p-action = true
     1166           .
     1167         end.
     1168         else do:
     1169           assign
     1170             p-action = false
     1171           .
     1172         end.
     1173       end.
     1174       if p-action = true
     1175       then do:
     1176         run diasize_change-height in this-procedure
     1177           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1178               - frame Dialog-Frame :height-chars
     1179           ,input true
     1180           ) .
     1181         run diasize_change-width in this-procedure
     1182           (input session :width-chars
     1183               - frame Dialog-Frame :width-chars
     1184           ,input true
     1185           ) .
     1186         assign
     1187           v-diasize-need-maximize = false
     1188         .
     1189       end.
     1190       else do:
     1191         run diasize_change-width in this-procedure
     1192           (input v-diasize-orig-frame-width
     1193               - frame Dialog-Frame :width-chars
     1194           ,input true
     1195           ) .
     1196         run diasize_change-height in this-procedure
     1197           (input v-diasize-orig-frame-height
     1198               - frame Dialog-Frame :height-chars
     1199           ,input true
     1200           ) .
     1201         assign
     1202           v-diasize-need-maximize = true
     1203         .
     1204       end.
     1205     end.
     1206   end procedure.
     1207   procedure diasize_restore-orig-size :
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       assign
     1212         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1213         v-diasize-current-frame-height = frame Dialog-Frame :height
     1214       .
     1215       run diasize_set-height in this-procedure
     1216         (input  v-diasize-orig-frame-height
     1217         ,input  true
     1218         ) .
     1219       run diasize_set-width in this-procedure
     1220         (input  v-diasize-orig-frame-width
     1221         ,input  true
     1222         ) .
     1223     end.
     1224   end procedure.
     1225   procedure diasize_restore-current-size :
     1226     do
     1227     on error undo, return error return-value
     1228     :
     1229       run diasize_set-height in this-procedure
     1230         (input  v-diasize-current-frame-height
     1231         ,input  true
     1232         ) .
     1233       run diasize_set-width in this-procedure
     1234         (input  v-diasize-current-frame-width
     1235         ,input  true
     1236         ) .
     1237     end.
     1238   end procedure.
     1239   procedure diasize_set-browse-handle :
     1240     define input  parameter p-browse-handle as handle   no-undo .
     1241     define buffer buf_temp-browse-handle for temp-browse-handle .
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       assign
     1246         v-diasize-browse-handle = p-browse-handle
     1247       .
     1248       for each buf_temp-browse-handle
     1249       on error undo, return error return-value
     1250       :
     1251         delete buf_temp-browse-handle .
     1252       end.
     1253     end.
     1254   end procedure.
     1255   procedure diasize_add_browse :
     1256     define input  parameter p-browse-type   as character no-undo .
     1257     define input  parameter p-browse-handle as handle    no-undo .
     1258     define buffer buf_temp-browse-handle for temp-browse-handle .
     1259     do
     1260     on error undo, return error return-value
     1261     :
     1262       assign
     1263         v-diasize-browse-number = v-diasize-browse-number + 1
     1264       .
     1265       create buf_temp-browse-handle .
     1266       assign
     1267         buf_temp-browse-handle.browse-type   = p-browse-type
     1268         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1269         buf_temp-browse-handle.browse-handle = p-browse-handle
     1270       .
     1271     end.
     1272   end procedure.
     1273   procedure diasize_init :
     1274     define variable v-default-value    as logical   no-undo .
     1275     define variable v-restore-saved    as logical   no-undo .
     1276     define variable v-resize-value-str as character no-undo .
     1277     do
     1278     on error undo, return error return-value
     1279     :
     1280       do with frame Dialog-Frame
     1281       :
     1282         assign
     1283           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1284           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1285           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1286         .
     1287         create button v-diasize-resize-button
     1288         assign
     1289           parent        = frame Dialog-Frame :first-child
     1290           label         = "s"
     1291           height-pixels = 16
     1292           width-pixels  = 16
     1293           visible       = true
     1294           sensitive     = true
     1295           movable       = true
     1296           triggers:
     1297             on end-move persistent run diasize_end-move in this-procedure .
     1298           end triggers.
     1299         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1300         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1301         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1302         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1303         assign
     1304           v-diasize-wndmax = false
     1305         .
     1306         if connected("ub") = true
     1307         then do:
     1308           define variable v-cntxt-db-num        as integer   no-undo .
     1309           define variable v-cntxt-userid        as character no-undo .
     1310           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1311                                             , OUTPUT v-cntxt-userid
     1312                                             ) .
     1313           run gbl/wndpar_r.p
     1314             (input  v-cntxt-db-num
     1315             ,input  v-cntxt-userid
     1316             ,input  'wndmax':U
     1317             ,output v-diasize-wndmax
     1318             ,output v-default-value
     1319             ) .
     1320         end.
     1321         assign
     1322           v-diasize-wndstore = false
     1323         .
     1324         if connected("ub") = true
     1325         then do:
     1326           run gbl/wndpar_r.p
     1327             (input  v-cntxt-db-num
     1328             ,input  v-cntxt-userid
     1329             ,input  'wndstore':U
     1330             ,output v-diasize-wndstore
     1331             ,output v-default-value
     1332             ) .
     1333         end.
     1334         assign
     1335           v-diasize-proc-name = entry(1, program-name(2), '.')
     1336         .
     1337         if v-diasize-wndstore = true
     1338         then do:
     1339           assign
     1340             v-restore-saved = false
     1341           .
     1342           if connected("ub") = true
     1343           then do:
     1344             run gbl/wndsizer.p
     1345               (input  v-cntxt-db-num
     1346               ,input  v-cntxt-userid
     1347               ,input  v-diasize-proc-name
     1348               ,input  'height':u
     1349               ,output v-resize-value-str
     1350               ) .
     1351             if v-resize-value-str <> '':U
     1352             then do:
     1353               run diasize_change-height in this-procedure
     1354                 (input  integer(v-resize-value-str)
     1355                 ,input  true
     1356                 ) .
     1357               assign
     1358                 v-restore-saved = true
     1359               .
     1360             end.
     1361           end.
     1362           if connected("ub") = true
     1363           then do:
     1364             run gbl/wndsizer.p
     1365               (input  v-cntxt-db-num
     1366               ,input  v-cntxt-userid
     1367               ,input  v-diasize-proc-name
     1368               ,input  'width':u
     1369               ,output v-resize-value-str
     1370               ) .
     1371             if v-resize-value-str <> '':U
     1372             then do:
     1373               run diasize_change-width in this-procedure
     1374                 (input  integer(v-resize-value-str)
     1375                 ,input  true
     1376                 ) .
     1377               assign
     1378                 v-restore-saved = true
     1379               .
     1380             end.
     1381           end.
     1382           if v-restore-saved <> true
     1383           then do:
     1384             if v-diasize-wndmax = true
     1385             then do:
     1386               run diasize_maximize in this-procedure
     1387                 (input  true
     1388                 ) .
     1389             end.
     1390           end.
     1391         end.
     1392         else do:
     1393           if v-diasize-wndmax = true
     1394           then do:
     1395             run diasize_maximize in this-procedure
     1396               (input  true
     1397               ) .
     1398           end.
     1399         end.
     1400       end.
     1401     end.
     1402   end procedure.
     1403   procedure diasize_need-full-display :
     1404     define output parameter p-need-full-display as logical   no-undo .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       assign
     1409         p-need-full-display = v-diasize-need-full-display
     1410       .
     1411       assign
     1412         v-diasize-need-full-display = false
     1413       .
     1414     end.
     1415   end procedure.
     1416   procedure get-context :
     1417      define output parameter p-db-num as integer          no-undo.
     1418      define output parameter p-user-id as character        no-undo.
     1419      define variable v-login               as character    no-undo.
     1420      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1421      define buffer buf_user-login  for ub.user-login .
     1422      do
     1423      on error undo, return error
     1424      :
     1425            FIND FIRST buf_sys-ctrl no-lock.
     1426            ASSIGN
     1427               v-login = USERID("ub")
     1428               p-db-num = buf_sys-ctrl.db-num
     1429            .
     1430            FIND FIRST buf_user-login
     1431                 WHERE buf_user-login.db-num = p-db-num
     1432                   AND buf_user-login.user-login = v-login
     1433                 no-lock
     1434                 no-error
     1435                 .
     1436            IF AVAILABLE buf_user-login
     1437            THEN DO:
     1438               assign
     1439                  p-user-id = buf_user-login.user-id
     1440               .
     1441            END.
     1442      end.
     1443   end procedure.
     1444       run diasize_init in this-procedure .
     1445   MAIN-BLOCK:
     1446   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1447      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1448     RUN enable_UI.
     1449     apply "VALUE-CHANGED":U to BROWSE-2 in frame Dialog-Frame.
     1450     WAIT-FOR GO OF FRAME Dialog-Frame.
     1451   END.
     1452   RUN disable_UI.
     1453   PROCEDURE disable_UI :
     1454     HIDE FRAME Dialog-Frame.
     1455   END PROCEDURE.
     1456   PROCEDURE enable_UI :
     1457     DISPLAY EDITOR-1
     1458         WITH FRAME Dialog-Frame.
     1459     ENABLE B-Cancel B-Help BROWSE-2 EDITOR-1
     1460         WITH FRAME Dialog-Frame.
     1461     VIEW FRAME Dialog-Frame.
     1462     OPEN QUERY BROWSE-2 FOR EACH tt-table.
     1463   END PROCEDURE.
