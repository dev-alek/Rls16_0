        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: lockuser.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/lockuser.p $":U .
        7   define variable vss-description as character no-undo init "Блокирование всех пользователей системы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure sys-time_get-sys :
       68     define output parameter p-year         as integer   no-undo .
       69     define output parameter p-month        as integer   no-undo .
       70     define output parameter p-day          as integer   no-undo .
       71     define output parameter p-hour         as integer   no-undo .
       72     define output parameter p-minute       as integer   no-undo .
       73     define output parameter p-second       as integer   no-undo .
       74     define output parameter p-milliseconds as integer   no-undo .
       75     define variable v-system-time-structure as memptr    no-undo.
       76     do
       77     on error undo, return error return-value
       78     :
       79       assign
       80         set-size(v-system-time-structure) = 16
       81       .
       82       run GetSystemTime
       83         (input  get-pointer-value(v-system-time-structure)
       84         ) .
       85       assign
       86         p-year         = get-short(v-system-time-structure,  1)
       87         p-month        = get-short(v-system-time-structure,  3)
       88         p-day          = get-short(v-system-time-structure,  7)
       89         p-hour         = get-short(v-system-time-structure,  9)
       90         p-minute       = get-short(v-system-time-structure, 11)
       91         p-second       = get-short(v-system-time-structure, 13)
       92         p-milliseconds = get-short(v-system-time-structure, 15)
       93       .
       94       assign
       95         set-size(v-system-time-structure) = 0
       96       .
       97     end.
       98   end procedure.
       99   procedure sys-time_get-comp-user-name :
      100     define output parameter p-computer-name as character no-undo .
      101     define output parameter p-user-name     as character no-undo .
      102     define output parameter p-process-pid   as integer   no-undo .
      103     define variable v-return-value  as integer   no-undo .
      104     define variable v-buffer-length as integer   no-undo .
      105     define variable v-buffer-memptr as memptr    no-undo .
      106     do
      107     on error undo, return error return-value
      108     :
      109       assign
      110         v-buffer-length = 1024
      111         set-size(v-buffer-memptr) = v-buffer-length + 4
      112       .
      113       assign
      114         put-long(v-buffer-memptr, 1) = v-buffer-length
      115       .
      116       run GetComputerNameA
      117         (input  get-pointer-value(v-buffer-memptr) + 4
      118         ,input  get-pointer-value(v-buffer-memptr)
      119         ,output v-return-value
      120         ) .
      121       if v-return-value <> 0
      122       then do:
      123         assign
      124           p-computer-name = get-string(v-buffer-memptr, 5)
      125         .
      126       end.
      127       assign
      128         put-long(v-buffer-memptr, 1) = v-buffer-length
      129       .
      130       run GetUserNameA
      131         (input  get-pointer-value(v-buffer-memptr) + 4
      132         ,input  get-pointer-value(v-buffer-memptr)
      133         ,output v-return-value
      134         ) .
      135       if v-return-value <> 0
      136       then do:
      137         assign
      138           p-user-name = get-string(v-buffer-memptr, 5)
      139         .
      140       end.
      141       run GetCurrentProcessId
      142         (output p-process-pid
      143         ) .
      144       assign
      145         set-size(v-buffer-memptr) = 0
      146       .
      147     end.
      148   end procedure.
      149   procedure sys-time_get-http :
      150     define output parameter p-http-time as character no-undo .
      151     define variable v-year         as integer   no-undo .
      152     define variable v-month        as integer   no-undo .
      153     define variable v-day-of-week  as integer   no-undo .
      154     define variable v-day          as integer   no-undo .
      155     define variable v-hour         as integer   no-undo .
      156     define variable v-minute       as integer   no-undo .
      157     define variable v-second       as integer   no-undo .
      158     define variable v-milliseconds as integer   no-undo .
      159     do
      160     on error undo, return error return-value
      161     :
      162       run sys-time_get-sys in this-procedure
      163         (output v-year
      164         ,output v-month
      165         ,output v-day
      166         ,output v-hour
      167         ,output v-minute
      168         ,output v-second
      169         ,output v-milliseconds
      170         ) .
      171       assign
      172         v-day-of-week = weekday(date(v-month, v-day, v-year))
      173         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      174                     + ', ':u
      175                     + string(v-day, '99':u)
      176                     + ' ':u
      177                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      178                     + ' ':u
      179                     + string(v-year, '9999':u)
      180                     + ' ':u
      181                     + string(v-hour, '99':u)
      182                     + ':':u
      183                     + string(v-minute, '99':u)
      184                     + ':':u
      185                     + string(v-second, '99':u)
      186                     + ' ':u
      187                     + 'GMT':u
      188       .
      189     end.
      190   end procedure.
      191   procedure sys-time_set-sys :
      192     define input  parameter p-year         as integer   no-undo .
      193     define input  parameter p-month        as integer   no-undo .
      194     define input  parameter p-day          as integer   no-undo .
      195     define input  parameter p-hour         as integer   no-undo .
      196     define input  parameter p-minute       as integer   no-undo .
      197     define input  parameter p-second       as integer   no-undo .
      198     define input  parameter p-milliseconds as integer   no-undo .
      199     define variable v-system-time-structure as memptr    no-undo.
      200     define variable v-return-value as integer   no-undo .
      201     define variable v-day-of-week  as integer   no-undo .
      202     do
      203     on error undo, return error return-value
      204     :
      205       assign
      206         v-day-of-week = weekday(date(p-month, p-day, p-year))
      207       .
      208       assign
      209         set-size(v-system-time-structure) = 16
      210       .
      211       assign
      212         put-short(v-system-time-structure,  1) = p-year
      213         put-short(v-system-time-structure,  3) = p-month
      214         put-short(v-system-time-structure,  5) = v-day-of-week
      215         put-short(v-system-time-structure,  7) = p-day
      216         put-short(v-system-time-structure,  9) = p-hour
      217         put-short(v-system-time-structure, 11) = p-minute
      218         put-short(v-system-time-structure, 13) = p-second
      219         put-short(v-system-time-structure, 15) = p-milliseconds
      220       .
      221       run SetSystemTime
      222         (input  get-pointer-value(v-system-time-structure)
      223         ,output v-return-value
      224         ) .
      225       assign
      226         set-size(v-system-time-structure) = 0
      227       .
      228       if v-return-value = 0
      229       then do:
      230         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      231       end.
      232     end.
      233   end procedure.
      234   procedure sys-time_sys-to-mjd :
      235     define input  parameter p-year         as integer   no-undo .
      236     define input  parameter p-month        as integer   no-undo .
      237     define input  parameter p-day          as integer   no-undo .
      238     define input  parameter p-hour         as integer   no-undo .
      239     define input  parameter p-minute       as integer   no-undo .
      240     define input  parameter p-second       as integer   no-undo .
      241     define input  parameter p-milliseconds as integer   no-undo .
      242     define output parameter p-mjd          as decimal   no-undo .
      243     define variable v-year-correction as decimal   no-undo .
      244     define variable v-shift-year as decimal   no-undo .
      245     do
      246     on error undo, return error return-value
      247     :
      248       assign
      249         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      250         v-shift-year      = decimal(p-year) + v-year-correction
      251         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      252               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      253               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      254               + decimal(p-day) - 2432076.0
      255               + p-hour / 24.0
      256               + p-minute / 1440.0
      257               + p-second / 86400.0
      258               + p-milliseconds / 86400000.0
      259       .
      260     end.
      261   end procedure.
      262   procedure sys-time_sys-to-loc :
      263     define input  parameter p-sys-year         as integer   no-undo .
      264     define input  parameter p-sys-month        as integer   no-undo .
      265     define input  parameter p-sys-day          as integer   no-undo .
      266     define input  parameter p-sys-hour         as integer   no-undo .
      267     define input  parameter p-sys-minute       as integer   no-undo .
      268     define input  parameter p-sys-second       as integer   no-undo .
      269     define input  parameter p-sys-milliseconds as integer   no-undo .
      270     define output parameter p-loc-year         as integer   no-undo .
      271     define output parameter p-loc-month        as integer   no-undo .
      272     define output parameter p-loc-day          as integer   no-undo .
      273     define output parameter p-loc-hour         as integer   no-undo .
      274     define output parameter p-loc-minute       as integer   no-undo .
      275     define output parameter p-loc-second       as integer   no-undo .
      276     define output parameter p-loc-milliseconds as integer   no-undo .
      277     define variable v-system-time-structure as memptr    no-undo.
      278     define variable v-return-value          as integer   no-undo .
      279     define variable v-sys-day-of-week       as integer   no-undo .
      280     do
      281     on error undo, return error return-value
      282     :
      283       assign
      284         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      285       .
      286       assign
      287         set-size(v-system-time-structure) = 32
      288       .
      289       assign
      290         put-short(v-system-time-structure,  1) = p-sys-year
      291         put-short(v-system-time-structure,  3) = p-sys-month
      292         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      293         put-short(v-system-time-structure,  7) = p-sys-day
      294         put-short(v-system-time-structure,  9) = p-sys-hour
      295         put-short(v-system-time-structure, 11) = p-sys-minute
      296         put-short(v-system-time-structure, 13) = p-sys-second
      297         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      298       .
      299       run SystemTimeToTzSpecificLocalTime
      300         (input  0
      301         ,input  get-pointer-value(v-system-time-structure)
      302         ,input  get-pointer-value(v-system-time-structure) + 16
      303         ,output v-return-value
      304         ) .
      305       assign
      306         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      307         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      308         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      309         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      310         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      311         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      312         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      313       .
      314       assign
      315         set-size(v-system-time-structure) = 0
      316       .
      317       if v-return-value = 0
      318       then do:
      319         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      320       end.
      321     end.
      322   end procedure.
      323   procedure sys-time_mjd-to-sys :
      324     define input  parameter p-mjd          as decimal   no-undo .
      325     define output parameter p-year         as integer   no-undo .
      326     define output parameter p-month        as integer   no-undo .
      327     define output parameter p-day          as integer   no-undo .
      328     define output parameter p-hour         as integer   no-undo .
      329     define output parameter p-minute       as integer   no-undo .
      330     define output parameter p-second       as integer   no-undo .
      331     define output parameter p-milliseconds as integer   no-undo .
      332     define variable v-year-correction as decimal   no-undo .
      333     define variable v-shift-year      as decimal   no-undo .
      334     define variable v-conv-date     as date      no-undo .
      335     define variable v-int-part      as integer   no-undo .
      336     define variable v-fraction-part as decimal   no-undo .
      337     do
      338     on error undo, return error return-value
      339     :
      340       assign
      341         v-int-part      = integer(truncate(p-mjd, 0))
      342         v-fraction-part = p-mjd - v-int-part
      343         v-conv-date     = date(11, 17, 1858) + v-int-part
      344         p-year          = year(v-conv-date)
      345         p-month         = month(v-conv-date)
      346         p-day           = day(v-conv-date)
      347         v-fraction-part = v-fraction-part * 24.0
      348         p-hour          = integer(truncate(v-fraction-part, 0))
      349         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      350         p-minute        = integer(truncate(v-fraction-part, 0))
      351         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      352         p-second        = integer(truncate(v-fraction-part, 0))
      353         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      354         p-milliseconds  = integer(v-fraction-part)
      355       .
      356     end.
      357   end procedure.
      358   procedure sys-time_mjd-to-loc :
      359     define input  parameter p-mjd              as decimal   no-undo .
      360     define output parameter p-loc-year         as integer   no-undo .
      361     define output parameter p-loc-month        as integer   no-undo .
      362     define output parameter p-loc-day          as integer   no-undo .
      363     define output parameter p-loc-hour         as integer   no-undo .
      364     define output parameter p-loc-minute       as integer   no-undo .
      365     define output parameter p-loc-second       as integer   no-undo .
      366     define output parameter p-loc-milliseconds as integer   no-undo .
      367     define variable v-sys-year         as integer   no-undo .
      368     define variable v-sys-month        as integer   no-undo .
      369     define variable v-sys-day          as integer   no-undo .
      370     define variable v-sys-hour         as integer   no-undo .
      371     define variable v-sys-minute       as integer   no-undo .
      372     define variable v-sys-second       as integer   no-undo .
      373     define variable v-sys-milliseconds as integer   no-undo .
      374     do
      375     on error undo, return error return-value
      376     :
      377       run sys-time_mjd-to-sys
      378         (input  p-mjd
      379         ,output v-sys-year
      380         ,output v-sys-month
      381         ,output v-sys-day
      382         ,output v-sys-hour
      383         ,output v-sys-minute
      384         ,output v-sys-second
      385         ,output v-sys-milliseconds
      386         ) .
      387       run sys-time_sys-to-loc
      388         (input  v-sys-year
      389         ,input  v-sys-month
      390         ,input  v-sys-day
      391         ,input  v-sys-hour
      392         ,input  v-sys-minute
      393         ,input  v-sys-second
      394         ,input  v-sys-milliseconds
      395         ,output p-loc-year
      396         ,output p-loc-month
      397         ,output p-loc-day
      398         ,output p-loc-hour
      399         ,output p-loc-minute
      400         ,output p-loc-second
      401         ,output p-loc-milliseconds
      402         ) .
      403     end.
      404   end procedure.
      405   function sys-time_get-mjd-func returns decimal
      406   :
      407     define variable v-year         as integer   no-undo .
      408     define variable v-month        as integer   no-undo .
      409     define variable v-day          as integer   no-undo .
      410     define variable v-hour         as integer   no-undo .
      411     define variable v-minute       as integer   no-undo .
      412     define variable v-second       as integer   no-undo .
      413     define variable v-milliseconds as integer   no-undo .
      414     define variable v-mjd          as decimal   no-undo .
      415     run sys-time_get-sys in this-procedure
      416       (output v-year
      417       ,output v-month
      418       ,output v-day
      419       ,output v-hour
      420       ,output v-minute
      421       ,output v-second
      422       ,output v-milliseconds
      423       ) .
      424     run sys-time_sys-to-mjd in this-procedure
      425       (input  v-year
      426       ,input  v-month
      427       ,input  v-day
      428       ,input  v-hour
      429       ,input  v-minute
      430       ,input  v-second
      431       ,input  v-milliseconds
      432       ,output v-mjd
      433       ) .
      434     return v-mjd .
      435   end function .
      436   function sys-time_get-sys-str-func returns character
      437   :
      438     define variable v-utc-time as character no-undo .
      439     define variable v-year         as integer   no-undo .
      440     define variable v-month        as integer   no-undo .
      441     define variable v-day          as integer   no-undo .
      442     define variable v-hour         as integer   no-undo .
      443     define variable v-minute       as integer   no-undo .
      444     define variable v-second       as integer   no-undo .
      445     define variable v-milliseconds as integer   no-undo .
      446     run sys-time_get-sys in this-procedure
      447       (output v-year
      448       ,output v-month
      449       ,output v-day
      450       ,output v-hour
      451       ,output v-minute
      452       ,output v-second
      453       ,output v-milliseconds
      454       ) .
      455     assign
      456       v-utc-time  = 'UTC ':u
      457                   + string(v-year,         '9999':u)
      458                   + '/':u
      459                   + string(v-month,        '99':u)
      460                   + '/':u
      461                   + string(v-day,          '99':u)
      462                   + ' ':u
      463                   + string(v-hour,         '99':u)
      464                   + ':':u
      465                   + string(v-minute,       '99':u)
      466                   + ':':u
      467                   + string(v-second,       '99':u)
      468                   + ' ':u
      469                   + string(v-milliseconds, '999':u)
      470     .
      471     return v-utc-time.
      472   end function .
      473   function sys-time_mjd-to-loc-str-func returns character
      474     (v-sys-mjd as decimal)
      475   :
      476     define variable v-loc-str          as character no-undo .
      477     define variable v-loc-year         as integer   no-undo .
      478     define variable v-loc-month        as integer   no-undo .
      479     define variable v-loc-day          as integer   no-undo .
      480     define variable v-loc-hour         as integer   no-undo .
      481     define variable v-loc-minute       as integer   no-undo .
      482     define variable v-loc-second       as integer   no-undo .
      483     define variable v-loc-milliseconds as integer   no-undo .
      484     run sys-time_mjd-to-loc in this-procedure
      485       (input  v-sys-mjd
      486       ,output v-loc-year
      487       ,output v-loc-month
      488       ,output v-loc-day
      489       ,output v-loc-hour
      490       ,output v-loc-minute
      491       ,output v-loc-second
      492       ,output v-loc-milliseconds
      493       ) .
      494     assign
      495       v-loc-str = substitute('&1/&2/&3 &4:&5'
      496                             ,string(v-loc-day,    '99':U)
      497                             ,string(v-loc-month,  '99':U)
      498                             ,string(v-loc-year,   '9999':U)
      499                             ,string(v-loc-hour,   '99':U)
      500                             ,string(v-loc-minute, '99':U)
      501                             )
      502     .
      503     return v-loc-str .
      504   end function .
      505   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      506   :
      507     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      508   END PROCEDURE.
      509   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      510   :
      511     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      512     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      513   END PROCEDURE.
      514   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      515   :
      516     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      517     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      518   END PROCEDURE.
      519   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      520   :
      521     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      522     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      523     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      524     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      525   END PROCEDURE.
      526   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      527   :
      528     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      529     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      530     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      531   END PROCEDURE.
      532   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      533   :
      534     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      535     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      536     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      537   END PROCEDURE.
      538   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      539   :
      540     DEFINE RETURN PARAMETER RetVal          AS LONG.
      541   END PROCEDURE.
      542   define variable v-total-lock-count  as integer   no-undo .
      543   define variable v-max-message-count as integer   no-undo .
      544   define variable v-error-message     as character no-undo .
      545   do
      546   on error undo, return error return-value
      547   :
      548     define buffer buf_sys-ctrl        for ub.sys-ctrl .
      549     define buffer buf_user-login      for ub.user-login .
      550     define buffer buf_lock_user-login for ub.user-login .
      551     assign
      552       v-total-lock-count  = 0
      553       v-max-message-count = 3
      554       v-error-message     = '':U
      555     .
      556     if transaction <> true
      557     then do:
      558       message
      559         vss-workfile vss-revision vss-description skip
      560         "Ошибка в способе вызова процедуры" skip
      561         "В момент вызова процедуры должна быть активна транзакция" skip
      562         view-as alert-box error .
      563       undo, return error return-value .
      564     end.
      565     find first buf_sys-ctrl no-lock .
      566     for each buf_user-login no-lock
      567       where buf_user-login.db-num = buf_sys-ctrl.db-num
      568     on error undo, return error return-value
      569     :
      570       find first buf_lock_user-login exclusive-lock
      571         where rowid(buf_lock_user-login) = rowid(buf_user-login)
      572         no-error no-wait .
      573       if not available buf_lock_user-login
      574       then do:
      575         assign
      576           v-total-lock-count = v-total-lock-count + 1
      577         .
      578         if v-total-lock-count <= v-max-message-count
      579         then do:
      580           assign
      581             v-error-message = v-error-message
      582                             + (if v-error-message <> '':U
      583                               then chr(10)
      584                               else '':U
      585                               )
      586                             + chr(10) + substitute("Компьютер &1"
      587                                                       ,buf_user-login.last-login-computer-name
      588                                                       )
      589                             + chr(10) + substitute("Пользователь компьютера &1"
      590                                                       ,buf_user-login.last-login-computer-user
      591                                                       )
      592                             + chr(10) + substitute("Идентификатор процесса &1"
      593                                                       ,buf_user-login.last-login-process-id
      594                                                       )
      595                             + chr(10) + substitute("Номер подключения к БД &1"
      596                                                       ,buf_user-login.last-login-connection-id
      597                                                       )
      598                             + chr(10) + substitute("Дата и время входа в систему &1"
      599                                                       ,sys-time_mjd-to-loc-str-func(buf_user-login.last-login-mjd)
      600                                                       )
      601           .
      602         end.
      603       end.
      604     end.
      605     if v-total-lock-count <> 0
      606     then do:
      607       undo, return error substitute("Работает пользователей &1"
      608                                    ,v-total-lock-count
      609                                    ) + chr(10)
      610                          + (if v-total-lock-count > v-max-message-count
      611                             then chr(10) + "Частичный список работающих пользователей" + chr(10)
      612                             else ""
      613                            )
      614                          + v-error-message .
      615     end.
      616     else do:
      617       return .
      618     end.
      619   end.
