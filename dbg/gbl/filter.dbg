        1   DEFINE BUFFER X_Filter FOR ubflt.filter.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define input parameter c-point        as character no-undo .
        4   define input parameter tbl            as character no-undo .
        5   define input parameter buf            as character no-undo .
        6   define input parameter fld            as character no-undo .
        7   define input parameter lab            as character no-undo .
        8   define input parameter spr            as character no-undo .
        9   define input parameter dim            as character no-undo .
       10   define variable vss-revision    as character no-undo initial "$Revision$":U .
       11   define variable vss-author      as character no-undo initial "$Author$":U .
       12   define variable vss-date        as character no-undo initial "$Date$":U .
       13   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       14   define variable vss-archive     as character no-undo initial "$Archive$":U .
       15   define variable vss-description as character no-undo initial "Выбор фильтра".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34       assign
       35         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,parparentproc,c-point,tbl,buf,fld,lab,spr,dim)
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define new global shared variable g#library  as handle no-undo .
      123   define new global shared variable g#library2 as handle no-undo .
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable flt-rec as recid no-undo.
      126   define variable g#report-num as integer no-undo .
      127   run get-report-num  in parparentproc ( output g#report-num ).
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   DEFINE VARIABLE kl AS INTEGER INITIAL 0.
      130   define variable MethodReturn AS LOGICAL.
      131   define variable ID AS RECID.
      132   define variable IDENT AS RECID.
      133   define variable ii as integer no-undo.
      134   define variable jj as integer no-undo.
      135   define variable rec as recid no-undo.
      136   define variable p-enable-sorting as logical no-undo init yes.
      137   define variable p-c-point-name   as character no-undo .
      138   define variable v-doc-rec as recid no-undo .
      139   define variable v-cntxt-userid as character no-undo .
      140   DEFINE BUTTON b-add
      141        LABEL "&Добавить":L
      142        SIZE 10 BY 1 TOOLTIP "Добавить новый фильтр".
      143   DEFINE BUTTON b-Cancel AUTO-END-KEY DEFAULT
      144        LABEL "&Выход "
      145        SIZE 10 BY 1 TOOLTIP "Выход без изменений"
      146        BGCOLOR 8 .
      147   DEFINE BUTTON b-del
      148        LABEL "&Удалить":L
      149        SIZE 10 BY 1 TOOLTIP "Удалить ранее существующий фильтр".
      150   DEFINE BUTTON b-exit AUTO-GO
      151        LABEL "&Снять":L
      152        SIZE 10 BY 1 TOOLTIP "Отменить действие установок фильтра".
      153   DEFINE BUTTON b-help DEFAULT
      154        LABEL "Помо&щь":L
      155        SIZE 10 BY 1
      156        BGCOLOR 8 .
      157   DEFINE BUTTON b-OK AUTO-GO DEFAULT
      158        LABEL "&Применить":L
      159        SIZE 10 BY 1 TOOLTIP "Применить установки выбранного фильтра"
      160        BGCOLOR 8 .
      161   DEFINE BUTTON b-update
      162        LABEL "&Изменить":L
      163        SIZE 10 BY 1 TOOLTIP "Изменить установки выбранного фильтра".
      164   DEFINE VARIABLE E-fields AS CHARACTER
      165        VIEW-AS EDITOR SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      166        SIZE 36.5 BY 4 NO-UNDO.
      167   DEFINE VARIABLE E-sorting AS CHARACTER
      168        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      169        SIZE 36.5 BY 4.17 NO-UNDO.
      170   DEFINE VARIABLE flt-name AS CHARACTER FORMAT "X(256)":U
      171        VIEW-AS FILL-IN
      172        SIZE 73 BY 1
      173        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      174   DEFINE QUERY br-filter FOR
      175         X_Filter SCROLLING.
      176   DEFINE BROWSE br-filter
      177     QUERY br-filter NO-LOCK DISPLAY
      178         X_Filter.Naim FORMAT "X(255)":U
      179       WITH SIZE 35 BY 9.25.
      180   DEFINE FRAME DIALOG-1
      181        b-Cancel AT ROW 1 COL 1
      182        b-OK AT ROW 1 COL 11
      183        b-exit AT ROW 1 COL 21
      184        b-add AT ROW 1 COL 31
      185        b-update AT ROW 1 COL 41
      186        b-del AT ROW 1 COL 51
      187        b-help AT ROW 1 COL 61
      188        flt-name AT ROW 2.25 COL 1.5 NO-LABEL
      189        br-filter AT ROW 4.33 COL 1.5
      190        E-fields AT ROW 4.33 COL 38 NO-LABEL
      191        E-sorting AT ROW 9.33 COL 38 NO-LABEL
      192        "Список фильтров" VIEW-AS TEXT
      193             SIZE 35 BY .67 AT ROW 3.5 COL 1.5
      194             BGCOLOR 1 FGCOLOR 15
      195        "Критерий выбора" VIEW-AS TEXT
      196             SIZE 36.5 BY .67 AT ROW 3.5 COL 38
      197             BGCOLOR 1 FGCOLOR 15
      198        "Сортировка" VIEW-AS TEXT
      199             SIZE 36.5 BY .67 AT ROW 8.58 COL 38
      200             BGCOLOR 1 FGCOLOR 15
      201        SPACE(0.74) SKIP(4.91)
      202       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      203            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      204            TITLE "Ф И Л Ь Т Р Ы":L
      205            DEFAULT-BUTTON b-OK CANCEL-BUTTON b-Cancel.
      206   ASSIGN
      207          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      208   ASSIGN
      209          E-fields:READ-ONLY IN FRAME DIALOG-1        = TRUE.
      210   ASSIGN
      211          E-sorting:READ-ONLY IN FRAME DIALOG-1        = TRUE.
      212   ON CHOOSE OF b-add IN FRAME DIALOG-1
      213   DO:
      214     define variable v-naim            like ubflt.filter.naim no-undo .
      215     define variable v-where-ysl       as character no-undo .
      216     define variable v-where-ysl-rus   as character no-undo .
      217     define variable v-fields-sort     as character no-undo .
      218     define variable v-fields-sort-rus as character no-undo .
      219     define variable p-lst-cend        as character no-undo .
      220     assign
      221       Kl = 0
      222     .
      223     run gbl/updf.w  (
      224                   input parParentProc
      225                 , input c-point
      226                 , input-output v-naim
      227                 , input yes
      228                 , input p-enable-sorting
      229                 , input yes
      230                 , input yes
      231                 , input Tbl
      232                 , input Buf
      233                 , input Fld
      234                 , input Lab
      235                 , input Spr
      236                 , input Dim
      237                 , input-output v-where-ysl
      238                 , input-output v-where-ysl-rus
      239                 , input-output v-fields-sort
      240                 , input-output v-fields-sort-rus
      241                 , input-output p-lst-cend
      242                 , input Kl
      243                 , output ID).
      244     IF ID = ? THEN DO :
      245       assign
      246         ID = IDENT
      247       .
      248     END.
      249     RUN enable_UI.
      250     REPOSITION br-filter TO RECID ID no-error.
      251     APPLY "value-changed" TO br-filter.
      252     apply "entry" to br-filter.
      253   END.
      254   ON CHOOSE OF b-Cancel IN FRAME DIALOG-1
      255   DO:
      256        assign flt-rec = ?.
      257        return 'undo':U.
      258   END.
      259   ON CHOOSE OF b-del IN FRAME DIALOG-1
      260   do:
      261   define variable flt-rec-del as recid no-undo .
      262   define buffer buf_filter for ubflt.filter.
      263   do on stop  undo, return:
      264     if available X_filter then do:
      265        flt-name = "".
      266        e-fields = "".
      267        e-sorting = "".
      268        flt-rec-del = recid(X_filter).
      269        get prev br-filter.
      270        if not available X_filter then do:
      271           get first br-filter.
      272           get next br-filter.
      273           end.
      274        flt-rec = recid(X_filter).
      275        FIND FIRST buf_filter WHERE recid(buf_filter) = flt-rec-del EXCLUSIVE-LOCK NO-ERROR.
      276        DELETE buf_filter.
      277        find X_filter where recid(X_filter) = flt-rec no-lock no-error.
      278        RUN enable_UI.
      279        REPOSITION br-filter TO RECID flt-rec no-error.
      280        APPLY "value-changed" TO br-filter.
      281        apply "entry" to br-filter.
      282        END.
      283   end.
      284   END.
      285   ON CHOOSE OF b-exit IN FRAME DIALOG-1
      286   DO:
      287      flt-rec = ?.
      288      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      289                           and ubflt.usr-flt.call-point = X_filter.call-point
      290                           no-error.
      291      if available ubflt.usr-flt then delete ubflt.usr-flt.
      292   END.
      293   ON CHOOSE OF b-OK IN FRAME DIALOG-1
      294   DO:
      295   if available X_filter  then do:
      296      flt-rec = recid(X_filter).
      297   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   define variable v-flt-put-ind3 as integer   no-undo .
      299   define variable v-flt-put-ind-sort3 as integer   no-undo .
      300   output to value(string(g#report-num) + ".whr").
      301   put .
      302   if num-entries(X_filter.where-ysl) > 0 then do:
      303      put unformatted 'and ('.
      304      do v-flt-put-ind3 = 1 to num-entries(X_filter.where-ysl):
      305        put unformatted entry(v-flt-put-ind3, X_filter.where-ysl) skip.
      306      end.
      307      put unformatted ')'.
      308   end.
      309   output close.
      310   output to value(string(g#report-num) + ".srt").
      311   put .
      312   do v-flt-put-ind3 = 1 to num-entries(X_filter.fields-sort):
      313      if  entry(v-flt-put-ind3, X_filter.fields-sort) <> "" then do:
      314          do v-flt-put-ind-sort3 = 1 to num-entries(entry(v-flt-put-ind3, X_filter.fields-sort),'*'):
      315               put  unformatted " by " + entry(v-flt-put-ind-sort3,entry(v-flt-put-ind3, X_filter.fields-sort),'*').
      316               if entry(v-flt-put-ind3, X_filter.lst-cend) = '1' then put " descending".
      317           end.
      318      end.
      319   end.
      320   output close.
      321      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      322                           and ubflt.usr-flt.call-point = X_filter.call-point
      323                           no-error.
      324      if not available ubflt.usr-flt then create ubflt.usr-flt.
      325      ubflt.usr-flt.user-name = v-cntxt-userid.
      326      ubflt.usr-flt.call-point    = X_filter.call-point.
      327      ubflt.usr-flt.naim = X_filter.naim.
      328      end.
      329   else flt-rec = ?.
      330   END.
      331   ON CHOOSE OF b-update IN FRAME DIALOG-1
      332   DO:
      333     define variable v-naim            like ubflt.filter.naim no-undo .
      334     define variable v-where-ysl       as character no-undo .
      335     define variable v-where-ysl-rus   as character no-undo .
      336     define variable v-fields-sort     as character no-undo .
      337     define variable v-fields-sort-rus as character no-undo .
      338     define variable p-lst-cend        as character no-undo .
      339     define buffer buf_filter for ubflt.filter.
      340     FIND FIRST buf_filter WHERE buf_filter.Num-flt = Kl EXCLUSIVE-LOCK NO-ERROR no-wait.
      341     IF AVAILABLE(buf_filter) THEN DO:
      342       assign
      343         Kl = buf_filter.Num-flt
      344       .
      345       run gbl/updf.w  (
      346                     input parParentProc
      347                   , input c-point
      348                   , input-output v-naim
      349                   , input yes
      350                   , input p-enable-sorting
      351                   , input yes
      352                   , input yes
      353                   , input Tbl
      354                   , input Buf
      355                   , input Fld
      356                   , input Lab
      357                   , input Spr
      358                   , input Dim
      359                   , input-output v-where-ysl
      360                   , input-output v-where-ysl-rus
      361                   , input-output v-fields-sort
      362                   , input-output v-fields-sort-rus
      363                   , input-output p-lst-cend
      364                   , input Kl
      365                   , output ID).
      366        IF ID = ? THEN ID = IDENT.
      367        RUN enable_UI.
      368        REPOSITION br-filter TO RECID ID no-error.
      369        APPLY "value-changed" TO br-filter.
      370        apply "entry" to br-filter.
      371        END.
      372      else
      373        if locked buf_filter then
      374           message 'Фильтр в данный момент корректируется другим пользователем'.
      375   END.
      376   ON MOUSE-SELECT-DBLCLICK OF br-filter IN FRAME DIALOG-1
      377   DO:
      378   apply "choose" to  b-ok.
      379   END.
      380   ON RETURN OF br-filter IN FRAME DIALOG-1
      381   DO:
      382   apply "choose" to  b-ok.
      383   END.
      384   ON VALUE-CHANGED OF br-filter IN FRAME DIALOG-1
      385   DO:
      386     IF AVAILABLE(X_filter) THEN DO:
      387       flt-rec = recid(X_filter).
      388       flt-name = X_filter.naim.
      389       Kl = X_filter.Num-flt.
      390       assign
      391         e-fields:screen-value = ""
      392         e-sorting:screen-value = "".
      393       assign e-fields
      394                   e-sorting.
      395       do ii = 1 to num-entries(X_filter.where-ysl-rus):
      396            MethodReturn = e-fields:insert-string(entry(ii ,X_filter.Where-ysl-rus) + chr(13)).
      397            assign e-fields.
      398       end.
      399       if p-enable-sorting then do:
      400         do ii = 1 to num-entries(X_filter.fields-sort-rus):
      401             MethodReturn = e-sorting:insert-string(entry(ii ,X_filter.fields-sort-rus) +
      402                                         (if entry(ii, X_filter.lst-cend) = '0' then "   (возр.)" else "  (убыв.)")
      403                                       + chr(13)).
      404             assign e-sorting.
      405         end.
      406       end.
      407       IDENT = RECID(X_filter).
      408       DISPLAY flt-name e-fields e-sorting WITH FRAME DIALOG-1.
      409       END.
      410   END.
      411   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      412   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      413   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   on help of frame DIALOG-1
      415   do:
      416     run gbl/app_help.p
      417       (input this-procedure :file-name
      418       ,input ''
      419       ,input ?
      420       ) no-error.
      421     if error-status :error then do:
      422       message
      423         "Ошибка при вызове помощи"
      424         error-status :get-message(1)
      425         view-as alert-box .
      426     end.
      427   end.
      428   run minbtn-set in this-procedure .
      429   on choose of b-help in frame DIALOG-1
      430   do:
      431     apply "help":u to frame DIALOG-1 .
      432   end.
      433   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   procedure minbtn-set :
      435       do
      436           on error undo, return error return-value
      437           :
      438           define variable ii              as integer       no-undo .
      439           define variable fh              as widget-handle no-undo .
      440           define variable hh              as widget-handle no-undo .
      441           define variable v-h             as handle        extent 4 no-undo .
      442           define variable v-name-button   as character     no-undo .
      443           define variable v-help-old-x    as decimal       no-undo .
      444           define variable v-help-old-y    as decimal       no-undo .
      445           define variable v-help-old-size as decimal       no-undo .
      446           define variable v-frame-width   as decimal       no-undo .
      447           define variable jj              as integer       no-undo .
      448           do
      449               on error undo, return error
      450               :
      451               assign
      452                   v-frame-width = frame DIALOG-1:width - 0.3
      453                   fh            = frame DIALOG-1:first-child
      454                   hh            = fh:first-child
      455                   ii            = 1
      456                   .
      457               do while valid-handle(hh):
      458                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      459                   do:
      460                       case lc(hh:name) :
      461                           when "b-help" then
      462                               do:
      463                                   hh:load-image-up("cmp/b-help.bmp":u) .
      464                                   hh:load-image-down("cmp/b-help.bmp":u) .
      465                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      466                                   hh:TOOLTIP = "Помощь" .
      467                                   v-help-old-x = hh:column .
      468                                   v-help-old-y = hh:row    .
      469                                   v-help-old-size = hh:width .
      470                                   hh:width-chars = 2.5 .
      471                               end.
      472                           when "b-print" then
      473                               do:
      474                                   hh:load-image("cmp/b-print.bmp":u) .
      475                                   hh:TOOLTIP = "Печать" .
      476                                   v-h[ii] = hh:handle .
      477                                   ii = ii + 1 .
      478                                   hh:width-chars = 3 .
      479                               end.
      480                           when "b-history" or
      481                           when "b-hist" then
      482                               do:
      483                                   hh:load-image("cmp/b-hist.bmp":u) .
      484                                   hh:TOOLTIP = "История" .
      485                                   v-h[ii] = hh:handle .
      486                                   ii = ii + 1 .
      487                                   hh:width-chars = 3 .
      488                               end.
      489                           when "b-sch" then
      490                               do:
      491                                   hh:load-image("cmp/b-sch.bmp":u) .
      492                                   hh:TOOLTIP = "Установка Фильтра" .
      493                                   v-h[ii] = hh:handle .
      494                                   ii = ii + 1 .
      495                                   hh:width-chars = 3 .
      496                               end.
      497                           when "b-hist-user" then
      498                               do:
      499                                   hh:load-image("cmp/b-hist.bmp":u) .
      500                                   hh:TOOLTIP = "История пользователя" .
      501                                   ii = ii + 1 .
      502                               end.
      503                       end case.
      504                   end.
      505                   hh = hh:next-sibling.
      506               end.
      507               b-help:column = v-frame-width - b-help:width-chars.
      508               jj = 0.
      509               repeat ii = 4 to 1 by -1 :
      510                   if valid-handle (v-h[ii] ) then
      511                   do:
      512                       jj  = jj + 1 .
      513                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      514                       v-h[ii]:row    = v-help-old-y .
      515                   end.
      516               end.
      517           end.
      518       end.
      519   end procedure.
      520   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      521   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      522   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      523   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      524   define variable v-diasize-current-frame-width  as decimal   no-undo .
      525   define variable v-diasize-current-frame-height as decimal   no-undo .
      526   define variable v-diasize-change-size          as logical   no-undo .
      527   define variable v-diasize-resize-button        as handle    no-undo .
      528   define variable v-diasize-wndmax               as logical   no-undo .
      529   define variable v-diasize-wndstore             as logical   no-undo .
      530   define variable v-diasize-proc-name            as character no-undo .
      531   define variable v-diasize-browse-handle        as handle    no-undo .
      532   define variable v-diasize-browse-number        as integer   no-undo .
      533   define variable v-diasize-need-full-display    as logical   no-undo init false .
      534   define temp-table temp-diasize-handle no-undo
      535     field handle-value  as handle
      536     field save-position as decimal
      537     index xpk is primary unique handle-value
      538     .
      539   define temp-table temp-browse-handle no-undo
      540     field browse-type   as character
      541     field browse-number as integer
      542     field browse-handle as handle
      543     field original-size as decimal
      544     index xpk is primary unique browse-type browse-number
      545     index xie browse-type browse-handle
      546   .
      547   procedure diasize_change-height :
      548     define input  parameter p-change-value  as decimal   no-undo .
      549     define input  parameter p-move-resize   as logical   no-undo .
      550     define variable v-field-group-handle    as handle    no-undo .
      551     define variable v-object-handle         as handle    no-undo .
      552     define variable v-frame-height          as decimal   no-undo .
      553     define variable v-frame-virtual-height  as decimal   no-undo .
      554     define variable v-browse-height         as decimal   no-undo .
      555     define variable v-window-height         as decimal   no-undo .
      556     define variable v-window-virtual-height as decimal   no-undo .
      557     define variable v-change-sign           as integer   no-undo .
      558     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      559     define buffer buf_temp-browse-handle  for temp-browse-handle .
      560     if p-change-value > 0
      561     then do:
      562       if frame DIALOG-1 :height + p-change-value
      563           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      564       then do:
      565         assign
      566           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      567                           - (frame DIALOG-1 :height-chars)
      568         .
      569         if p-change-value <= 0
      570         then do:
      571           run diasize_position-resize-button in this-procedure .
      572           return .
      573         end.
      574       end.
      575     end.
      576     if p-change-value < 0
      577     then do:
      578       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
      579       then do:
      580         assign
      581           p-change-value = v-diasize-orig-frame-height
      582                          - (frame DIALOG-1 :height-chars)
      583         .
      584         if p-change-value >= 0
      585         then do:
      586           run diasize_position-resize-button in this-procedure .
      587           return .
      588         end.
      589       end.
      590     end.
      591     if p-change-value >= 0
      592     then do:
      593       assign
      594         v-change-sign = 1
      595       .
      596     end.
      597     else do:
      598       assign
      599         v-change-sign = -1
      600       .
      601     end.
      602     assign
      603       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      604     .
      605     if p-change-value = 0
      606     then do:
      607       run diasize_position-resize-button in this-procedure .
      608       return .
      609     end.
      610     move_block:
      611     do
      612     on error undo move_block, retry move_block
      613     :
      614       if retry
      615       then do:
      616         do
      617         on error undo move_block, leave move_block
      618         :
      619           if p-change-value > 0
      620           then do:
      621             for each buf_temp-diasize-handle
      622             on error undo, next
      623             :
      624               assign
      625                 v-object-handle = buf_temp-diasize-handle.handle-value
      626               .
      627               if v-object-handle <> v-diasize-resize-button
      628               then do:
      629                 assign
      630                   v-object-handle :row = buf_temp-diasize-handle.save-position
      631                 .
      632               end.
      633             end.
      634             assign
      635               v-diasize-browse-handle :height = v-browse-height
      636             .
      637             for each buf_temp-browse-handle
      638               where buf_temp-browse-handle.browse-type = 'height':u
      639             on error undo, next
      640             :
      641               assign
      642                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      643               .
      644             end.
      645             assign
      646               frame DIALOG-1 :height = v-frame-height
      647             .
      648             if frame DIALOG-1 :scrollable = true
      649             then do:
      650               assign
      651                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      652               .
      653             end.
      654             run diasize_position-resize-button in this-procedure .
      655           end.
      656           else do:
      657             if frame DIALOG-1 :scrollable = true
      658             then do:
      659               assign
      660                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      661               .
      662             end.
      663             assign
      664               frame DIALOG-1 :height = v-frame-height
      665             .
      666             assign
      667               v-diasize-browse-handle :height = v-browse-height
      668             .
      669             for each buf_temp-browse-handle
      670               where buf_temp-browse-handle.browse-type = 'height':u
      671             on error undo, next
      672             :
      673               assign
      674                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      675               .
      676             end.
      677             for each buf_temp-diasize-handle
      678             on error undo, next
      679             :
      680               assign
      681                 v-object-handle = buf_temp-diasize-handle.handle-value
      682               .
      683               if v-object-handle <> v-diasize-resize-button
      684               then do:
      685                 assign
      686                   v-object-handle :row = buf_temp-diasize-handle.save-position
      687                 .
      688               end.
      689             end.
      690             run diasize_position-resize-button in this-procedure .
      691           end.
      692           assign
      693             v-diasize-change-size = false
      694           .
      695           leave move_block .
      696         end.
      697       end.
      698       assign
      699         v-diasize-need-full-display = true
      700       .
      701       if v-diasize-change-size = false
      702       then do:
      703         assign
      704           v-diasize-change-size = true
      705         .
      706       end.
      707       else do:
      708         return .
      709       end.
      710       assign
      711         v-frame-height = frame DIALOG-1 :height
      712         v-frame-virtual-height = frame DIALOG-1 :virtual-height
      713         v-browse-height = v-diasize-browse-handle :height
      714       .
      715       for each buf_temp-browse-handle
      716         where buf_temp-browse-handle.browse-type = 'height':u
      717       :
      718         assign
      719           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      720         .
      721       end.
      722       for each buf_temp-diasize-handle
      723       :
      724         delete buf_temp-diasize-handle .
      725       end.
      726       assign
      727         v-field-group-handle = frame DIALOG-1 :first-child
      728       .
      729       do while valid-handle(v-field-group-handle)
      730       :
      731         assign
      732           v-object-handle = v-field-group-handle :first-child
      733         .
      734         do while valid-handle(v-object-handle)
      735         :
      736           if  v-object-handle <> v-diasize-browse-handle :handle
      737           and can-query(v-object-handle, "row")
      738           and can-query(v-object-handle, "height")
      739           and ( v-object-handle :row > v-diasize-browse-handle :row )
      740           then do:
      741             find first buf_temp-browse-handle
      742               where buf_temp-browse-handle.browse-type   = 'height':u
      743                 and buf_temp-browse-handle.browse-handle = v-object-handle
      744               no-error .
      745             if available buf_temp-browse-handle
      746             then do:
      747             end.
      748             else do:
      749               create buf_temp-diasize-handle .
      750               assign
      751                 buf_temp-diasize-handle.handle-value  = v-object-handle
      752                 buf_temp-diasize-handle.save-position = v-object-handle :row
      753               .
      754             end.
      755           end.
      756           assign
      757             v-object-handle = v-object-handle :next-sibling
      758           .
      759         end.
      760         assign
      761           v-field-group-handle = v-field-group-handle :next-sibling
      762         .
      763       end.
      764       do with frame DIALOG-1
      765       :
      766         hide v-diasize-resize-button .
      767         assign
      768           v-diasize-resize-button :row    = 1
      769           v-diasize-resize-button :column = 1
      770         .
      771       end.
      772       if p-change-value > 0
      773       then do:
      774         if frame DIALOG-1 :scrollable = true
      775         then do:
      776           assign
      777             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
      778             no-error .
      779           if error-status :error
      780           or error-status :get-message(1) <> ""
      781           then do:
      782             undo move_block, retry move_block .
      783           end.
      784         end.
      785         assign
      786           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
      787           no-error .
      788         if error-status :error
      789         or error-status :get-message(1) <> ""
      790         then do:
      791           undo move_block, retry move_block .
      792         end.
      793         assign
      794           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      795           no-error .
      796         if error-status :error
      797         or error-status :get-message(1) <> ""
      798         then do:
      799           undo move_block, retry move_block .
      800         end.
      801         for each buf_temp-browse-handle
      802           where buf_temp-browse-handle.browse-type = 'height':u
      803         on error undo move_block, retry move_block
      804         :
      805           assign
      806             buf_temp-browse-handle.browse-handle :height
      807               = buf_temp-browse-handle.browse-handle :height + p-change-value
      808             no-error .
      809           if error-status :error
      810           or error-status :get-message(1) <> ""
      811           then do:
      812             undo move_block, retry move_block .
      813           end.
      814         end.
      815         for each buf_temp-diasize-handle
      816         on error undo move_block, retry move_block
      817         :
      818           assign
      819             v-object-handle = buf_temp-diasize-handle.handle-value
      820           .
      821           if v-object-handle <> v-diasize-resize-button
      822           then do:
      823             assign
      824               v-object-handle :row = v-object-handle :row + p-change-value
      825               no-error .
      826             if error-status :error
      827             or error-status :get-message(1) <> ""
      828             then do:
      829               undo move_block, retry move_block .
      830             end.
      831           end.
      832         end.
      833       end.
      834       else do:
      835         for each buf_temp-diasize-handle
      836         on error undo move_block, retry move_block
      837         :
      838           assign
      839             v-object-handle = buf_temp-diasize-handle.handle-value
      840           .
      841           if v-object-handle <> v-diasize-resize-button
      842           then do:
      843             assign
      844               v-object-handle :row = v-object-handle :row + p-change-value
      845               no-error .
      846             if error-status :error
      847             or error-status :get-message(1) <> ""
      848             then do:
      849               undo move_block, retry move_block .
      850             end.
      851           end.
      852         end.
      853         assign
      854           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      855           no-error .
      856         if error-status :error
      857         or error-status :get-message(1) <> ""
      858         then do:
      859           undo move_block, retry move_block .
      860         end.
      861         for each buf_temp-browse-handle
      862           where buf_temp-browse-handle.browse-type = 'height':u
      863         on error undo move_block, retry move_block
      864         :
      865           assign
      866             buf_temp-browse-handle.browse-handle :height
      867               = buf_temp-browse-handle.browse-handle :height + p-change-value
      868             no-error .
      869           if error-status :error
      870           or error-status :get-message(1) <> ""
      871           then do:
      872             undo move_block, retry move_block .
      873           end.
      874         end.
      875         assign
      876           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
      877           no-error .
      878         if error-status :error
      879         or error-status :get-message(1) <> ""
      880         then do:
      881           undo move_block, retry move_block .
      882         end.
      883         if frame DIALOG-1 :scrollable = true
      884         then do:
      885           assign
      886             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
      887             no-error .
      888           if error-status :error
      889           or error-status :get-message(1) <> ""
      890           then do:
      891             undo move_block, retry move_block .
      892           end.
      893         end.
      894       end.
      895       if p-move-resize = true
      896       then do:
      897         run diasize_position-resize-button in this-procedure .
      898       end.
      899       if v-diasize-wndstore = true
      900       then do:
      901         if connected("ub") = true
      902         then do:
      903           define variable v-cntxt-db-num        as integer   no-undo .
      904           define variable v-cntxt-userid        as character no-undo .
      905           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      906                                             , OUTPUT v-cntxt-userid
      907                                             ) .
      908           run gbl/wndsizew.p
      909             (input  v-cntxt-db-num
      910             ,input  v-cntxt-userid
      911             ,input  v-diasize-proc-name
      912             ,input  'height':u
      913             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
      914             ) .
      915         end.
      916       end.
      917     end.
      918     assign
      919       v-diasize-change-size = false
      920     .
      921   end procedure.
      922   procedure diasize_set-height :
      923     define input  parameter p-new-height  as decimal   no-undo .
      924     define input  parameter p-move-resize as logical   no-undo .
      925     do
      926     on error undo, return error return-value
      927     :
      928       run diasize_change-height in this-procedure
      929         (input  (p-new-height - frame DIALOG-1 :height)
      930         ,input  p-move-resize
      931         ) .
      932     end.
      933   end procedure.
      934   procedure diasize_change-width :
      935     define input  parameter p-change-value as decimal   no-undo .
      936     define input  parameter p-move-resize  as logical   no-undo .
      937     define variable v-field-group-handle   as handle    no-undo .
      938     define variable v-object-handle        as handle    no-undo .
      939     define variable v-frame-width          as decimal   no-undo .
      940     define variable v-frame-virtual-width  as decimal   no-undo .
      941     define variable v-browse-width         as decimal   no-undo .
      942     define variable v-window-width         as decimal   no-undo .
      943     define variable v-window-virtual-width as decimal   no-undo .
      944     define variable v-change-sign          as integer   no-undo .
      945     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      946     define buffer buf_temp-browse-handle  for temp-browse-handle .
      947     if p-change-value > 0
      948     then do:
      949       if frame DIALOG-1 :width + p-change-value >
      950           session :width-chars
      951       then do:
      952         assign
      953           p-change-value = session :width-chars - frame DIALOG-1 :width
      954         .
      955         if p-change-value <= 0
      956         then do:
      957           run diasize_position-resize-button in this-procedure .
      958           return .
      959         end.
      960       end.
      961     end.
      962     if p-change-value < 0
      963     then do:
      964       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
      965       then do:
      966         assign
      967           p-change-value = v-diasize-orig-frame-width
      968                          - frame DIALOG-1 :width
      969         .
      970         if p-change-value >= 0
      971         then do:
      972           run diasize_position-resize-button in this-procedure .
      973           return .
      974         end.
      975       end.
      976     end.
      977     if p-change-value >= 0
      978     then do:
      979       assign
      980         v-change-sign = 1
      981       .
      982     end.
      983     else do:
      984       assign
      985         v-change-sign = -1
      986       .
      987     end.
      988     assign
      989       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      990     .
      991     if p-change-value = 0
      992     then do:
      993       run diasize_position-resize-button in this-procedure .
      994       return .
      995     end.
      996     move_block:
      997     do
      998     on error undo move_block, leave move_block
      999     :
     1000       if retry
     1001       then do:
     1002         do
     1003         on error undo move_block, leave move_block
     1004         :
     1005           if p-change-value > 0
     1006           then do:
     1007             for each buf_temp-diasize-handle
     1008             on error undo, next
     1009             :
     1010               assign
     1011                 v-object-handle = buf_temp-diasize-handle.handle-value
     1012               .
     1013               if v-object-handle <> v-diasize-resize-button
     1014               then do:
     1015                 assign
     1016                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1017                 .
     1018               end.
     1019             end.
     1020             assign
     1021               v-diasize-browse-handle :width = v-browse-width
     1022             .
     1023             for each buf_temp-browse-handle
     1024               where buf_temp-browse-handle.browse-type = 'width':u
     1025             on error undo, next
     1026             :
     1027               assign
     1028                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1029               .
     1030             end.
     1031             assign
     1032               frame DIALOG-1 :width = v-frame-width
     1033             .
     1034             if frame DIALOG-1 :scrollable = true
     1035             then do:
     1036               assign
     1037                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1038               .
     1039             end.
     1040             run diasize_position-resize-button in this-procedure .
     1041           end.
     1042           else do:
     1043             if frame DIALOG-1 :scrollable = true
     1044             then do:
     1045               assign
     1046                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1047               .
     1048             end.
     1049             assign
     1050               frame DIALOG-1 :width = v-frame-width
     1051             .
     1052             for each buf_temp-browse-handle
     1053               where buf_temp-browse-handle.browse-type = 'width':u
     1054             on error undo, next
     1055             :
     1056               assign
     1057                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1058               .
     1059             end.
     1060             assign
     1061               v-diasize-browse-handle :width = v-browse-width
     1062             .
     1063             for each buf_temp-diasize-handle
     1064             on error undo, next
     1065             :
     1066               assign
     1067                 v-object-handle = buf_temp-diasize-handle.handle-value
     1068               .
     1069               if v-object-handle <> v-diasize-resize-button
     1070               then do:
     1071                 assign
     1072                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1073                 .
     1074               end.
     1075             end.
     1076             run diasize_position-resize-button in this-procedure .
     1077           end.
     1078           assign
     1079             v-diasize-change-size = false
     1080           .
     1081           leave move_block .
     1082         end.
     1083       end.
     1084       assign
     1085         v-diasize-need-full-display = true
     1086       .
     1087       if v-diasize-change-size = false
     1088       then do:
     1089         assign
     1090           v-diasize-change-size = true
     1091         .
     1092       end.
     1093       else do:
     1094         return .
     1095       end.
     1096       assign
     1097         v-frame-width = frame DIALOG-1 :width
     1098         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     1099         v-browse-width = v-diasize-browse-handle :width
     1100       .
     1101       for each buf_temp-browse-handle
     1102         where buf_temp-browse-handle.browse-type = 'width':u
     1103       :
     1104         assign
     1105           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1106         .
     1107       end.
     1108       for each buf_temp-diasize-handle
     1109       :
     1110         delete buf_temp-diasize-handle .
     1111       end.
     1112       assign
     1113         v-field-group-handle = frame DIALOG-1 :first-child
     1114       .
     1115       do while valid-handle(v-field-group-handle)
     1116       :
     1117         assign
     1118           v-object-handle = v-field-group-handle :first-child
     1119         .
     1120         do while valid-handle(v-object-handle)
     1121         :
     1122           if  v-object-handle <> v-diasize-browse-handle :handle
     1123           and v-object-handle <> v-diasize-resize-button
     1124           and can-query(v-object-handle, "row")
     1125           and can-query(v-object-handle, "height")
     1126           and ( v-object-handle :col + v-object-handle :width
     1127                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1128               )
     1129           then do:
     1130             find first buf_temp-browse-handle
     1131               where buf_temp-browse-handle.browse-type   = 'width':u
     1132                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1133               no-error .
     1134             if available buf_temp-browse-handle
     1135             then do:
     1136             end.
     1137             else do:
     1138               create buf_temp-diasize-handle .
     1139               assign
     1140                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1141                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1142               .
     1143             end.
     1144           end.
     1145           assign
     1146             v-object-handle = v-object-handle :next-sibling
     1147           .
     1148         end.
     1149         assign
     1150           v-field-group-handle = v-field-group-handle :next-sibling
     1151         .
     1152       end.
     1153       do with frame DIALOG-1
     1154       :
     1155         hide v-diasize-resize-button .
     1156         v-diasize-resize-button :row = 1.
     1157         v-diasize-resize-button :column = 1.
     1158       end.
     1159       if p-change-value > 0
     1160       then do:
     1161         if frame DIALOG-1 :scrollable = true
     1162         then do:
     1163           assign
     1164             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1165             no-error .
     1166           if error-status :error
     1167           or error-status :get-message(1) <> ""
     1168           then do:
     1169             undo move_block, retry move_block.
     1170           end.
     1171         end.
     1172         assign
     1173           frame DIALOG-1 :width = v-frame-width + p-change-value
     1174           no-error .
     1175         if error-status :error
     1176         or error-status :get-message(1) <> ""
     1177         then do:
     1178           undo move_block, retry move_block.
     1179         end.
     1180         assign
     1181           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1182         no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block.
     1187         end.
     1188         for each buf_temp-browse-handle
     1189           where buf_temp-browse-handle.browse-type = 'width':u
     1190         on error undo move_block, retry move_block
     1191         :
     1192           assign
     1193             buf_temp-browse-handle.browse-handle :width
     1194               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1195             no-error .
     1196           if error-status :error
     1197           or error-status :get-message(1) <> ""
     1198           then do:
     1199             undo move_block, retry move_block .
     1200           end.
     1201         end.
     1202         for each buf_temp-diasize-handle
     1203         on error undo move_block, retry move_block
     1204         :
     1205           assign
     1206             v-object-handle = buf_temp-diasize-handle.handle-value
     1207           .
     1208           if v-object-handle <> v-diasize-resize-button
     1209           then do:
     1210             assign
     1211               v-object-handle :col = v-object-handle :col + p-change-value
     1212               no-error .
     1213             if error-status :error
     1214             or error-status :get-message(1) <> ""
     1215             then do:
     1216               undo move_block, retry move_block .
     1217             end.
     1218           end.
     1219         end.
     1220       end.
     1221       else do:
     1222         for each buf_temp-diasize-handle
     1223         on error undo move_block, retry move_block
     1224         :
     1225           assign
     1226             v-object-handle = buf_temp-diasize-handle.handle-value
     1227           .
     1228           if v-object-handle <> v-diasize-resize-button
     1229           then do:
     1230             assign
     1231               v-object-handle :col = v-object-handle :col + p-change-value
     1232               no-error .
     1233             if error-status :error
     1234             or error-status :get-message(1) <> ""
     1235             then do:
     1236               undo move_block, retry move_block .
     1237             end.
     1238           end.
     1239         end.
     1240         for each buf_temp-browse-handle
     1241           where buf_temp-browse-handle.browse-type = 'width':u
     1242         on error undo move_block, retry move_block
     1243         :
     1244           assign
     1245             buf_temp-browse-handle.browse-handle :width
     1246               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1247             no-error .
     1248           if error-status :error
     1249           or error-status :get-message(1) <> ""
     1250           then do:
     1251             undo move_block, retry move_block .
     1252           end.
     1253         end.
     1254         assign
     1255           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1256           no-error .
     1257         if error-status :error
     1258         or error-status :get-message(1) <> ""
     1259         then do:
     1260           undo move_block, retry move_block.
     1261         end.
     1262         assign
     1263           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1264         no-error .
     1265         if error-status :error
     1266         or error-status :get-message(1) <> ""
     1267         then do:
     1268           undo move_block, retry move_block.
     1269         end.
     1270         if frame DIALOG-1 :scrollable = true
     1271         then do:
     1272           assign
     1273             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1274           no-error .
     1275           if error-status :error
     1276           or error-status :get-message(1) <> ""
     1277           then do:
     1278             undo move_block, retry move_block.
     1279           end.
     1280         end.
     1281       end.
     1282       if p-move-resize
     1283       then do:
     1284         run diasize_position-resize-button in this-procedure .
     1285       end.
     1286       if v-diasize-wndstore = true
     1287       then do:
     1288         if connected("ub") = true
     1289         then do:
     1290           define variable v-cntxt-db-num        as integer   no-undo .
     1291           define variable v-cntxt-userid        as character no-undo .
     1292           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1293                                             , OUTPUT v-cntxt-userid
     1294                                             ) .
     1295           run gbl/wndsizew.p
     1296             (input  v-cntxt-db-num
     1297             ,input  v-cntxt-userid
     1298             ,input  v-diasize-proc-name
     1299             ,input  'width':u
     1300             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1301             ) .
     1302         end.
     1303       end.
     1304     end.
     1305     assign
     1306       v-diasize-change-size = false
     1307     .
     1308   end procedure.
     1309   procedure diasize_set-width :
     1310     define input  parameter p-new-width  as decimal   no-undo .
     1311     define input  parameter p-move-resize as logical   no-undo .
     1312     do
     1313     on error undo, return error return-value
     1314     :
     1315       run diasize_change-width in this-procedure
     1316         (input  (p-new-width - frame DIALOG-1 :width)
     1317         ,input  p-move-resize
     1318         ) .
     1319     end.
     1320   end procedure.
     1321   procedure diasize_position-resize-button :
     1322     do with frame DIALOG-1
     1323     :
     1324       hide v-diasize-resize-button .
     1325       assign
     1326         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1327                     - 1
     1328                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1329         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1330                     - 1
     1331                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1332       .
     1333       view v-diasize-resize-button .
     1334     end.
     1335   end procedure.
     1336   on alt-right anywhere
     1337   do:
     1338     run diasize_change-width in this-procedure
     1339       (input 1
     1340       ,input true
     1341       ) .
     1342     return no-apply .
     1343   end.
     1344   on alt-left anywhere
     1345   do:
     1346     run diasize_change-width in this-procedure
     1347       (input -1
     1348       ,input true
     1349       ) .
     1350     return no-apply .
     1351   end.
     1352   on alt-down anywhere
     1353   do:
     1354     run diasize_change-height in this-procedure
     1355       (input 1
     1356       ,input true
     1357       ) .
     1358     return no-apply .
     1359   end.
     1360   on alt-up anywhere
     1361   do:
     1362     run diasize_change-height in this-procedure
     1363       (input -1
     1364       ,input true
     1365       ) .
     1366     return no-apply .
     1367   end.
     1368   on alt-enter of frame DIALOG-1
     1369   do:
     1370     run diasize_maximize in this-procedure
     1371       (input  ?
     1372       ).
     1373     return no-apply .
     1374   end.
     1375   procedure diasize_end-move :
     1376     do
     1377     on error undo, return error return-value
     1378     :
     1379       define variable v-row-delta as decimal   no-undo .
     1380       define variable v-col-delta as decimal   no-undo .
     1381       define variable v-new-row as decimal   no-undo .
     1382       define variable v-new-col as decimal   no-undo .
     1383       assign
     1384         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1385         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1386       .
     1387       assign
     1388         v-row-delta = v-new-row - frame DIALOG-1 :height
     1389         v-col-delta = v-new-col - frame DIALOG-1 :width
     1390       .
     1391       run diasize_change-height in this-procedure
     1392         (input v-row-delta
     1393         ,input true
     1394         ) .
     1395       run diasize_change-width in this-procedure
     1396         (input v-col-delta
     1397         ,input true
     1398         ) .
     1399     end.
     1400   end procedure.
     1401   procedure diasize_maximize :
     1402     define input  parameter p-action as logical   no-undo .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       if p-action = ?
     1407       then do:
     1408         if v-diasize-need-maximize = true
     1409         then do:
     1410           assign
     1411             p-action = true
     1412           .
     1413         end.
     1414         else do:
     1415           assign
     1416             p-action = false
     1417           .
     1418         end.
     1419       end.
     1420       if p-action = true
     1421       then do:
     1422         run diasize_change-height in this-procedure
     1423           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1424               - frame DIALOG-1 :height-chars
     1425           ,input true
     1426           ) .
     1427         run diasize_change-width in this-procedure
     1428           (input session :width-chars
     1429               - frame DIALOG-1 :width-chars
     1430           ,input true
     1431           ) .
     1432         assign
     1433           v-diasize-need-maximize = false
     1434         .
     1435       end.
     1436       else do:
     1437         run diasize_change-width in this-procedure
     1438           (input v-diasize-orig-frame-width
     1439               - frame DIALOG-1 :width-chars
     1440           ,input true
     1441           ) .
     1442         run diasize_change-height in this-procedure
     1443           (input v-diasize-orig-frame-height
     1444               - frame DIALOG-1 :height-chars
     1445           ,input true
     1446           ) .
     1447         assign
     1448           v-diasize-need-maximize = true
     1449         .
     1450       end.
     1451     end.
     1452   end procedure.
     1453   procedure diasize_restore-orig-size :
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       assign
     1458         v-diasize-current-frame-width  = frame DIALOG-1 :width
     1459         v-diasize-current-frame-height = frame DIALOG-1 :height
     1460       .
     1461       run diasize_set-height in this-procedure
     1462         (input  v-diasize-orig-frame-height
     1463         ,input  true
     1464         ) .
     1465       run diasize_set-width in this-procedure
     1466         (input  v-diasize-orig-frame-width
     1467         ,input  true
     1468         ) .
     1469     end.
     1470   end procedure.
     1471   procedure diasize_restore-current-size :
     1472     do
     1473     on error undo, return error return-value
     1474     :
     1475       run diasize_set-height in this-procedure
     1476         (input  v-diasize-current-frame-height
     1477         ,input  true
     1478         ) .
     1479       run diasize_set-width in this-procedure
     1480         (input  v-diasize-current-frame-width
     1481         ,input  true
     1482         ) .
     1483     end.
     1484   end procedure.
     1485   procedure diasize_set-browse-handle :
     1486     define input  parameter p-browse-handle as handle   no-undo .
     1487     define buffer buf_temp-browse-handle for temp-browse-handle .
     1488     do
     1489     on error undo, return error return-value
     1490     :
     1491       assign
     1492         v-diasize-browse-handle = p-browse-handle
     1493       .
     1494       for each buf_temp-browse-handle
     1495       on error undo, return error return-value
     1496       :
     1497         delete buf_temp-browse-handle .
     1498       end.
     1499     end.
     1500   end procedure.
     1501   procedure diasize_add_browse :
     1502     define input  parameter p-browse-type   as character no-undo .
     1503     define input  parameter p-browse-handle as handle    no-undo .
     1504     define buffer buf_temp-browse-handle for temp-browse-handle .
     1505     do
     1506     on error undo, return error return-value
     1507     :
     1508       assign
     1509         v-diasize-browse-number = v-diasize-browse-number + 1
     1510       .
     1511       create buf_temp-browse-handle .
     1512       assign
     1513         buf_temp-browse-handle.browse-type   = p-browse-type
     1514         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1515         buf_temp-browse-handle.browse-handle = p-browse-handle
     1516       .
     1517     end.
     1518   end procedure.
     1519   procedure diasize_init :
     1520     define variable v-default-value    as logical   no-undo .
     1521     define variable v-restore-saved    as logical   no-undo .
     1522     define variable v-resize-value-str as character no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       do with frame DIALOG-1
     1527       :
     1528         assign
     1529           v-diasize-orig-frame-height = frame DIALOG-1 :height
     1530           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     1531           v-diasize-browse-handle     = browse br-filter :handle
     1532         .
     1533         create button v-diasize-resize-button
     1534         assign
     1535           parent        = frame DIALOG-1 :first-child
     1536           label         = "s"
     1537           height-pixels = 16
     1538           width-pixels  = 16
     1539           visible       = true
     1540           sensitive     = true
     1541           movable       = true
     1542           triggers:
     1543             on end-move persistent run diasize_end-move in this-procedure .
     1544           end triggers.
     1545         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1546         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1547         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1548         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1549         assign
     1550           v-diasize-wndmax = false
     1551         .
     1552         if connected("ub") = true
     1553         then do:
     1554           define variable v-cntxt-db-num        as integer   no-undo .
     1555           define variable v-cntxt-userid        as character no-undo .
     1556           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1557                                             , OUTPUT v-cntxt-userid
     1558                                             ) .
     1559           run gbl/wndpar_r.p
     1560             (input  v-cntxt-db-num
     1561             ,input  v-cntxt-userid
     1562             ,input  'wndmax':U
     1563             ,output v-diasize-wndmax
     1564             ,output v-default-value
     1565             ) .
     1566         end.
     1567         assign
     1568           v-diasize-wndstore = false
     1569         .
     1570         if connected("ub") = true
     1571         then do:
     1572           run gbl/wndpar_r.p
     1573             (input  v-cntxt-db-num
     1574             ,input  v-cntxt-userid
     1575             ,input  'wndstore':U
     1576             ,output v-diasize-wndstore
     1577             ,output v-default-value
     1578             ) .
     1579         end.
     1580         assign
     1581           v-diasize-proc-name = entry(1, program-name(2), '.')
     1582         .
     1583         if v-diasize-wndstore = true
     1584         then do:
     1585           assign
     1586             v-restore-saved = false
     1587           .
     1588           if connected("ub") = true
     1589           then do:
     1590             run gbl/wndsizer.p
     1591               (input  v-cntxt-db-num
     1592               ,input  v-cntxt-userid
     1593               ,input  v-diasize-proc-name
     1594               ,input  'height':u
     1595               ,output v-resize-value-str
     1596               ) .
     1597             if v-resize-value-str <> '':U
     1598             then do:
     1599               run diasize_change-height in this-procedure
     1600                 (input  integer(v-resize-value-str)
     1601                 ,input  true
     1602                 ) .
     1603               assign
     1604                 v-restore-saved = true
     1605               .
     1606             end.
     1607           end.
     1608           if connected("ub") = true
     1609           then do:
     1610             run gbl/wndsizer.p
     1611               (input  v-cntxt-db-num
     1612               ,input  v-cntxt-userid
     1613               ,input  v-diasize-proc-name
     1614               ,input  'width':u
     1615               ,output v-resize-value-str
     1616               ) .
     1617             if v-resize-value-str <> '':U
     1618             then do:
     1619               run diasize_change-width in this-procedure
     1620                 (input  integer(v-resize-value-str)
     1621                 ,input  true
     1622                 ) .
     1623               assign
     1624                 v-restore-saved = true
     1625               .
     1626             end.
     1627           end.
     1628           if v-restore-saved <> true
     1629           then do:
     1630             if v-diasize-wndmax = true
     1631             then do:
     1632               run diasize_maximize in this-procedure
     1633                 (input  true
     1634                 ) .
     1635             end.
     1636           end.
     1637         end.
     1638         else do:
     1639           if v-diasize-wndmax = true
     1640           then do:
     1641             run diasize_maximize in this-procedure
     1642               (input  true
     1643               ) .
     1644           end.
     1645         end.
     1646       end.
     1647     end.
     1648   end procedure.
     1649   procedure diasize_need-full-display :
     1650     define output parameter p-need-full-display as logical   no-undo .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       assign
     1655         p-need-full-display = v-diasize-need-full-display
     1656       .
     1657       assign
     1658         v-diasize-need-full-display = false
     1659       .
     1660     end.
     1661   end procedure.
     1662   procedure get-context :
     1663      define output parameter p-db-num as integer          no-undo.
     1664      define output parameter p-user-id as character        no-undo.
     1665      define variable v-login               as character    no-undo.
     1666      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1667      define buffer buf_user-login  for ub.user-login .
     1668      do
     1669      on error undo, return error
     1670      :
     1671            FIND FIRST buf_sys-ctrl no-lock.
     1672            ASSIGN
     1673               v-login = USERID("ub")
     1674               p-db-num = buf_sys-ctrl.db-num
     1675            .
     1676            FIND FIRST buf_user-login
     1677                 WHERE buf_user-login.db-num = p-db-num
     1678                   AND buf_user-login.user-login = v-login
     1679                 no-lock
     1680                 no-error
     1681                 .
     1682            IF AVAILABLE buf_user-login
     1683            THEN DO:
     1684               assign
     1685                  p-user-id = buf_user-login.user-id
     1686               .
     1687            END.
     1688      end.
     1689   end procedure.
     1690       run diasize_init in this-procedure .
     1691   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1692   do:
     1693     br-filter :SET-REPOSITIONED-ROW(3, "CONDITIONAL") .
     1694   end.
     1695   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   on f5 of frame DIALOG-1 anywhere
     1697   do:
     1698      v-doc-rec = recid(ubflt.filter). OPEN QUERY br-filter FOR EACH X_Filter       WHERE X_Filter.call-point = c-point NO-LOCK. Reposition br-filter to recid v-doc-rec no-error .                APPLY 'ENTRY' to br-filter. APPLY 'value-changed' TO br-filter.
     1699       apply "VALUE-CHANGED" to br-filter.
     1700   end.
     1701   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   on CTRL-N, CTRL-Т of frame DIALOG-1 anywhere do:
     1703     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame DIALOG-1. END.
     1704     return no-apply.
     1705   end.
     1706   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   on F4 of frame DIALOG-1 anywhere do:
     1708     if b-update :sensitive then DO: apply "CHOOSE":U to b-update in frame DIALOG-1. END.
     1709     return no-apply.
     1710   end.
     1711   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   on F8 of frame DIALOG-1 anywhere do:
     1713     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame DIALOG-1. END.
     1714     return no-apply.
     1715   end.
     1716   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   on F2 of frame DIALOG-1 anywhere do:
     1718     if b-ok :sensitive then DO: apply "CHOOSE":U to b-ok in frame DIALOG-1. END.
     1719     return no-apply.
     1720   end.
     1721   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   on F2 of frame DIALOG-1 anywhere do:
     1723     if b-cancel :sensitive then DO: apply "CHOOSE":U to b-cancel in frame DIALOG-1. END.
     1724     return no-apply.
     1725   end.
     1726   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1727   run check-input-parameters in this-procedure
     1728     no-error .
     1729   if error-status :error
     1730   then do:
     1731     undo, return error return-value .
     1732   end.
     1733   on end-error, stop of frame DIALOG-1 do:
     1734        assign flt-rec = ?.
     1735        return 'undo':U.
     1736   end.
     1737   MAIN-BLOCK:
     1738   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1739      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1740     run get-userid in parparentproc
     1741       ( output v-cntxt-userid
     1742       ) .
     1743     p-enable-sorting = yes.
     1744     if num-entries(c-point, chr(4)) > 2 then do:
     1745       p-enable-sorting = logical(entry(3, c-point, chr(4))).
     1746     end.
     1747     p-c-point-name = c-point.
     1748     if num-entries(c-point, chr(4)) > 1 then do:
     1749       assign
     1750       p-c-point-name = entry(2, c-point, chr(4))
     1751       c-point        = entry(1, c-point, chr(4))
     1752       .
     1753     end.
     1754     assign frame DIALOG-1:title = "Ф И Л Ь T Р Ы   (" + p-c-point-name + ")".
     1755     RUN enable_UI.
     1756     reposition br-filter to recid flt-rec no-error.
     1757     apply "value-changed" to br-filter in frame DIALOG-1.
     1758     WAIT-FOR GO OF FRAME DIALOG-1 focus br-filter.
     1759   END.
     1760   RUN disable_UI.
     1761   PROCEDURE check-input-parameters :
     1762     if Fld = ""
     1763     or Fld = ?
     1764     then do:
     1765       message
     1766         vss-workfile vss-revision vss-description skip
     1767         "Ошибка задания входных параметров" skip
     1768         "Не задан список полей" skip
     1769         view-as alert-box error .
     1770       undo, return error "не задан список полей" .
     1771     end.
     1772   END PROCEDURE.
     1773   PROCEDURE disable_UI :
     1774     HIDE FRAME DIALOG-1.
     1775   END PROCEDURE.
     1776   PROCEDURE enable_UI :
     1777     DISPLAY flt-name E-fields E-sorting
     1778         WITH FRAME DIALOG-1.
     1779     ENABLE b-Cancel b-OK b-exit b-add b-update b-del b-help br-filter E-fields
     1780            E-sorting
     1781         WITH FRAME DIALOG-1.
     1782     OPEN QUERY br-filter FOR EACH X_Filter       WHERE X_Filter.call-point = c-point NO-LOCK.
     1783   END PROCEDURE.
