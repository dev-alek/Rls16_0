      378       then do:
      379         message
      380           vss-workfile vss-revision vss-description skip
      381           "Ошибка при вызове процедуры" 'clntattr-delete':u skip
      382           "Клиент" p-obj-type p-obj-code skip
      383           "Атрибут" p-code skip
      384           error-status :get-message(1) skip
      385           return-value skip
      386           view-as alert-box error .
      387       end.
      388       undo, return error return-value .
      389     end.
      390   end.
