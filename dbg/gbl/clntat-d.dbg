      366   do
      367   on error undo, return error return-value
      368   :
      369     run clntattr-delete in this-procedure
      370       (input  p-obj-type
      371       ,input  p-obj-code
      372       ,input  p-code
      373       ,output p-deleted
      374       ) no-error .
