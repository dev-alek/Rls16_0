       65   procedure ggoattr-value :
       66     define input  parameter p-node-code    like ub.gds-grp-obj-attr.node-code     no-undo .
       67     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
       68     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
       69     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
       70     define input  parameter p-code      like ub.gds-grp-obj-attr.attr-code  no-undo .
       71     define output parameter p-value     like ub.gds-grp-obj-attr.attr-value no-undo .
       72     define output parameter p-type      as character no-undo .
       73     do
       74     on error undo, return error
       75     :
       76           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-value in g#attr-lib
       77         (input  p-node-code
