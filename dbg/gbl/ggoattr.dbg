      211   procedure grp-obj-notcorr-value :
      212   do
      213   on error undo, return error
      214   :
      215   define input parameter p-node-code             as integer      no-undo.
      216   define input parameter p-obj-type              as character    no-undo.
      217   define input parameter p-obj-code              as integer      no-undo.
      218   define output parameter p-notcorr              as character    no-undo init ?.
      219   define output parameter p-range-notcorr     as integer      no-undo.
      220   define output parameter p-exists-notcorr    as logical      no-undo.
      221   define variable v-host-code as integer      no-undo.
      222   DEFINE VARIABLE v-found as logical no-undo .
      223   DEFINE VARIABLE v-exists as logical no-undo .
      224   DEFINE VARIABLE v-range as integer no-undo .
      225   DEFINE VARIABLE jj as integer no-undo .
      226   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      227   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      228   define buffer buf_gds-grp for ub.gds-grp.
      229   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      230   find first buf_gds-grp no-lock where
      231              buf_gds-grp.node-code = p-node-code no-error .
      232   if not avail buf_gds-grp and p-node-code <> 0 then do:
      233     message
      234       vss-workfile vss-revision vss-description
      235       skip "Не удалось найти группу товаров с кодом" p-node-code
      236       view-as alert-box error .
      237     undo, return error .
      238   end.
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      241     (input  p-obj-type
      242     ,input  p-obj-code
      243     ,output v-host-code
      244     ) no-error .
      245   if error-status :error
      246   then do:
      247       message
      248         vss-workfile vss-revision vss-description
      249         skip "Не удалось найти фирму объекта"
      250         skip p-obj-type p-obj-code
      251         skip return-value
      252         skip trim(error-status :get-message(1))
      253       view-as alert-box error.
      254       undo, return error .
      255   end.
      256   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      257   do while v-found = no and jj < 2:
      258     if v-range <> 3 then do:
      259       find first buf_gds-grp-obj no-lock
      260           where buf_gds-grp-obj.node-code = p-node-code
      261             and buf_gds-grp-obj.host-code = v-host-code
      262             and buf_gds-grp-obj.obj-type  = p-obj-type
      263             and buf_gds-grp-obj.obj-code  = p-obj-code
      264       no-error .
      265     end.
      266     if v-range = 3 or not available buf_gds-grp-obj
      267     then do:
      268        if v-range <> 2 then do:
      269           find first buf_gds-grp-obj no-lock
      270               where buf_gds-grp-obj.node-code = p-node-code
      271                 and buf_gds-grp-obj.host-code = v-host-code
      272                 and buf_gds-grp-obj.obj-type  = ""
      273                 and buf_gds-grp-obj.obj-code  = 0
      274           no-error .
      275         end.
      276         if v-range = 2 or not available buf_gds-grp-obj
      277         then do:
      278             if v-range <> 1 then do:
      279               find first buf_gds-grp-obj no-lock
      280                   where buf_gds-grp-obj.node-code = p-node-code
      281                   and buf_gds-grp-obj.host-code = 0
      282                   and buf_gds-grp-obj.obj-type  = ""
      283                   and buf_gds-grp-obj.obj-code  = 0
      284               no-error .
      285             end.
      286             if v-range = 1 or not available buf_gds-grp-obj
      287             then do:
      288                 assign
      289                     v-exists = no
      290                 .
      291             end.
      292             else do:
      293                 assign
      294                     v-exists = yes
      295                     v-range = 1
      296                 .
      297             end.
      298         end.
      299         else do:
      300             assign
      301                 v-exists = yes
      302                 v-range  = 2
      303             .
      304         end.
      305     end.
      306     else do:
      307         assign
      308             v-exists = yes
      309             v-range  = 3
      310         .
      311     end.
      312     if available buf_gds-grp-obj
      313     then do:
      314       find first buf_gds-grp-obj-attr no-lock
      315         where buf_gds-grp-obj-attr.node-code   = p-node-code
      316           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      317           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      318           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      319           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      320         no-error .
      321       if available buf_gds-grp-obj-attr then do:
      322         assign
      323           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      324         .
      325       end.
      326       else do:
      327         assign
      328           v-notcorr-value = ?
      329         .
      330       end.
      331       assign
      332       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      333                           then yes
      334                           else p-exists-notcorr)
      335       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      336                         then v-range
      337                         else p-range-notcorr
      338       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      339                         then v-notcorr-value
      340                         else p-notcorr
      341       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      342       jj = jj + 1
      343       .
      344     end.
      345     else do:
      346       assign
      347       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      348       jj = jj + 1
      349       .
      350     end.
      351   end.
      352   end.
      353   end procedure.
