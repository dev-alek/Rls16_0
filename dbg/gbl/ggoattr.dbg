        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Библиотека для работы с атрибутами БД".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   do:
       16     this-proc-hndl = this-procedure.
       17   end.
       18   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       19   define new global shared variable g#attr-lib  as handle no-undo .
       20   define variable v-attr-lib-variable as handle no-undo .
       21   procedure ggoattr-code :
       22     define input  parameter p-code           as character no-undo .
       23     define output parameter p-type           as character no-undo .
       24     define output parameter p-format         as character no-undo .
       25     define output parameter p-label          as character no-undo .
       26     define output parameter p-user-can-edit  as logical   no-undo .
       27     define output parameter p-output-display as logical   no-undo .
       28     define output parameter p-other          as character no-undo .
       29     do
       30     on error undo, return error
       31     :
       32           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
       33         (input  p-code
       34         ,output p-type
       35         ,output p-format
       36         ,output p-label
       37         ,output p-user-can-edit
       38         ,output p-output-display
       39         ,output p-other
       40         ) no-error .
       41       if error-status :error
       42       then do:
       43         undo, return error return-value .
       44       end.
       45     end.
       46   end procedure.
