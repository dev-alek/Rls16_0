        1   block-level on error undo, throw.
        2   define output parameter p-version         as character        no-undo.
        3   define output parameter p-locale          as character        no-undo.
        4   define output parameter p-SVNRev          as integer          no-undo.
        5   define output parameter p-compilerVersion as character        no-undo.
        6   define output parameter p-date            as date             no-undo.
        7   define output parameter p-time            as integer          no-undo.
        8   define output parameter p-comment         as character        no-undo.
        9   define output parameter p-file-date       as date             no-undo.
       10   define output parameter p-file-time       as integer          no-undo.
       11   define output parameter o-Release         as integer          no-undo init ?.
       12   define output parameter o-patch           as integer          no-undo init ?.
       13   define output parameter o-branch          as integer          no-undo init ?.
       14   define variable vss-revision    as character no-undo init "$Revision: 618b89371265, 2255, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: druban $":U .
       16   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:24:01 2019 +0300 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: vertag.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: gbl/vertag.p $":U .
       19   define variable vss-description as character no-undo init "Получить версию и тэг системы".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define variable vss-include-info0 as character format "X(65)" no-undo
       81   initial "@(#)$Workfile$ $Revision$".
       82   define temp-table temp_testXML-node no-undo
       83       field xmh-key       as integer
       84       field xmhNodName    as character
       85       index pi is primary unique
       86           xmh-key
       87       index nnm
       88           xmhNodName
       89   .
       90   define temp-table temp_testXML-entity no-undo
       91       field xme-key       as integer
       92       field xmh-key       as integer
       93       field xmeEntName    as character
       94       field xmeEntValue   as character
       95       index pi is primary unique
       96           xme-key
       97       index enm
       98           xmh-key
       99           xmeEntName
      100   .
      101   define temp-table temp_testXML-atribut no-undo
      102       field xme-key       as integer
      103       field xmeAtrName    as character
      104       field xmeAtrValue   as character
      105       index pi is primary unique
      106           xme-key
      107           xmeAtrName
      108   .
      109   define variable mRoot  as character no-undo init "Root".
      110   define stream xmldom-out.
      111   define variable mverfile_text as character   no-undo.
      112   define variable mverfile      as integer  no-undo.
      113   define variable v-xmldom-key       as integer      no-undo.
      114     define variable mTransaction  as logical no-undo init yes.
      115   procedure xmldom-clear :
      116       define buffer buf_temp_testXML-node         for temp_testXML-node.
      117       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      118       define buffer buf_temp_testXML-atribut      for temp_testXML-atribut.
      119   do
      120   for buf_temp_testXML-node
      121     , buf_temp_testXML-entity
      122     , buf_temp_testXML-atribut
      123   on error undo, return error
      124   :
      125       empty temp-table buf_temp_testXML-node   .
      126       empty temp-table buf_temp_testXML-entity .
      127       empty temp-table buf_temp_testXML-atribut.
      128       assign
      129           v-xmldom-key = 0
      130           mTransaction = yes
      131       .
      132   end.
      133   end .
      134   procedure xmldom-add :
      135   define input parameter p-node-name      as character        no-undo.
      136   define input parameter p-entity-name    as character        no-undo.
      137   define input parameter p-entity-value   as character        no-undo.
      138       define buffer buf_temp_testXML-node         for temp_testXML-node.
      139       define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      140   do
      141   for buf_temp_testXML-node
      142     , buf_temp_testXML-entity
      143   on error undo, return error
      144   :
      145       find last buf_temp_testXML-node
      146       use-index pi no-error.
      147       if not available buf_temp_testXML-node
      148       then do:
      149           assign
      150               v-xmldom-key = 0
      151           .
      152       end.
      153       else do:
      154           assign
      155               v-xmldom-key = buf_temp_testXML-node.xmh-key
      156           .
      157       end.
      158       find last buf_temp_testXML-entity
      159       use-index pi
      160       no-error.
      161       if available buf_temp_testXML-entity
      162       then do:
      163           assign
      164               v-xmldom-key = max(v-xmldom-key,buf_temp_testXML-entity.xme-key)
      165           .
      166       end.
      167       find first buf_temp_testXML-node
      168            where buf_temp_testXML-node.xmhNodName = p-node-name
      169       no-error.
      170       if not available buf_temp_testXML-node
      171       then do:
      172           assign
      173               v-xmldom-key = v-xmldom-key + 1
      174           .
      175           create buf_temp_testXML-node.
      176           assign
      177               buf_temp_testXML-node.xmh-key    = v-xmldom-key
      178               buf_temp_testXML-node.xmhNodName = p-node-name
      179           .
      180       end.
      181       assign
      182           v-xmldom-key = v-xmldom-key + 1
      183       .
      184       create buf_temp_testXML-entity.
      185       assign
      186           buf_temp_testXML-entity.xme-key      = v-xmldom-key
      187           buf_temp_testXML-entity.xmh-key      = buf_temp_testXML-node.xmh-key
      188           buf_temp_testXML-entity.xmeEntName   = p-entity-name
      189           buf_temp_testXML-entity.xmeEntValue  = p-entity-value
      190       .
      191   end.
      192   end.
      193   function  xmldom-save-next-level  returns character
      194      ( iKey         as integer,
      195      i-doc-handle as handle,
      196      i-row-handle as handle):
      197      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      198      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      199      define variable v-field-handle  as handle           no-undo.
      200      define variable v-text-handle   as handle           no-undo.
      201      create x-noderef v-field-handle.
      202      create x-noderef v-text-handle.
      203      for each buf_temp_testXML-entity
      204         where buf_temp_testXML-entity.xmh-key = iKey
      205           and not buf_temp_testXML-entity.xmeEntName begins "#"
      206      on error undo, return error:
      207         i-doc-handle :create-node ( v-field-handle, buf_temp_testXML-entity.xmeEntName , "ELEMENT" ).
      208         for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-entity.xme-key
      209         no-lock:
      210            v-field-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      211         end.
      212         i-row-handle :append-child ( v-field-handle ).
      213         i-doc-handle :create-node ( v-text-handle, buf_temp_testXML-entity.xmeEntValue, "TEXT" ).
      214         v-field-handle :append-child ( v-text-handle ).
      215         if buf_temp_testXML-entity.xmeEntValue eq ?  then buf_temp_testXML-entity.xmeEntValue = "unknown_value".
      216         v-text-handle :node-value = buf_temp_testXML-entity.xmeEntValue.
      217        xmldom-save-next-level(buf_temp_testXML-entity.xme-key, i-doc-handle,v-field-handle).
      218      end.
      219      delete object v-field-handle.
      220      delete object v-text-handle.
      221   end.
      222   procedure xmldom-save :
      223   define input parameter result  as character        no-undo.
      224   define variable iType  as character no-undo init "file".
      225       define variable v-doc-handle    as handle           no-undo.
      226       define variable v-root-handle   as handle           no-undo.
      227       define variable v-row-handle    as handle           no-undo.
      228       define variable v-buf-handle    as handle           no-undo.
      229       define buffer buf_temp_testXML-node         for temp_testXML-node.
      230   do
      231   for buf_temp_testXML-node
      232   on error undo, return error
      233   :
      234       create x-document v-doc-handle.
      235       assign
      236           v-doc-handle :encoding = "windows-1251":U
      237       .
      238       create x-noderef v-root-handle.
      239       v-doc-handle :create-node ( v-root-handle, mRoot, "ELEMENT" ).
      240       v-doc-handle :append-child ( v-root-handle ).
      241       for each buf_temp_testXML-node where not buf_temp_testXML-node.xmhNodName begins "#"
      242       on error undo, return error
      243       :
      244           assign
      245               v-buf-handle = buffer buf_temp_testxml-node :handle
      246           .
      247           create x-noderef v-row-handle.
      248           v-doc-handle :create-node ( v-row-handle, buf_temp_testXML-node.xmhNodName, "ELEMENT" ).
      249           for each temp_testXML-atribut where temp_testXML-atribut.xme-key eq buf_temp_testXML-node.xmh-key
      250           no-lock:
      251              v-row-handle:SET-ATTRIBUTE(temp_testXML-atribut.xmeatrName,temp_testXML-atribut.xmeAtrValue).
      252           end.
      253           v-root-handle :append-child ( v-row-handle ).
      254           xmldom-save-next-level(buf_temp_testXML-node.xmh-key,v-doc-handle,v-row-handle).
      255           delete object v-row-handle.
      256       end.
      257       if    iType eq "file"
      258       then do:
      259          os-delete result.
      260          v-doc-handle :save ( iType, result ).
      261          output stream xmldom-out to value( result ) append.
      262          put stream xmldom-out unformatted chr(10).
      263          output stream xmldom-out close.
      264       end.
      265       else if iType eq "memptr"
      266       then
      267          v-doc-handle :save ( iType, result ).
      268       else
      269          v-doc-handle :save ( "file", iType ).
      270       delete object v-doc-handle.
      271       delete object v-root-handle.
      272   end.
      273   end .
      274   function  xmldom-load-atribut returns logical
      275      (IParent    as handle,
      276      iParentkey as integer
      277      ):
      278      def var vanames as char no-undo.
      279      def var vname as char no-undo.
      280      define buffer temp_testXML-atribut          for temp_testXML-atribut.
      281      def var vi      as integer  no-undo.
      282      vanames = IParent:ATTRIBUTE-NAMES.
      283      do vi = 1 TO NUM-ENTRIES(vanames):
      284         vname = ENTRY(vi, vanames).
      285         create temp_testXML-atribut.
      286         assign
      287            temp_testXML-atribut.xme-key     = iParentkey
      288            temp_testXML-atribut.xmeatrName  = vname
      289            temp_testXML-atribut.xmeAtrValue = IParent:GET-ATTRIBUTE(vname)
      290         .
      291      END.
      292   end.
      293   define variable m-xme-key       as integer      no-undo.
      294   function  xmldom-load-next-level returns logical
      295      (IParent    as handle,
      296      iParentkey as integer ,
      297      ifilever as int):
      298      define variable v-field-handle  as handle           no-undo.
      299      define variable v-text-handle   as handle           no-undo.
      300      define variable v-field-counter as integer          no-undo.
      301      define variable v-field-amount  as integer          no-undo.
      302      define variable vDateActive as date no-undo.
      303      define buffer buf_temp_testXML-entity       for temp_testXML-entity.
      304      create x-noderef v-field-handle.
      305      create x-noderef v-text-handle.
      306      assign
      307         v-field-amount = IParent :num-children
      308      .
      309      repeat v-field-counter = 1 to v-field-amount:
      310         IParent :get-child ( v-field-handle, v-field-counter ).
      311         if v-field-handle :num-children < 1
      312         then do:
      313            next.
      314         end.
      315         create buf_temp_testXML-entity.
      316         assign
      317            m-xme-key = m-xme-key + 1
      318            buf_temp_testXML-entity.xme-key     = m-xme-key
      319            buf_temp_testXML-entity.xmh-key     = iParentkey
      320         .
      321         v-field-handle :get-child ( v-text-handle, 1 ).
      322         if     IParent:name         eq "file-info"
      323            and v-field-handle :name eq "version"
      324         then do:
      325            mverfile = int(v-text-handle :node-value)no-error.
      326            if     ifilever ne ?
      327            then do:
      328               if  mverfile  eq ifilever
      329               then do:
      330                  for each buf_temp_testXML-entity:
      331                     delete buf_temp_testXML-entity.
      332                  end.
      333                  return yes.
      334               end.
      335            end.
      336         end.
      337         else if     IParent:name         eq "file-info"
      338                 and v-field-handle :name eq "DateActive"
      339         then do:
      340            vDateActive = date(v-text-handle :node-value)no-error.
      341            if     vDateActive ne ?
      342            then do:
      343               if  vDateActive  lt today
      344               then do:
      345                  for each buf_temp_testXML-entity:
      346                     delete buf_temp_testXML-entity.
      347                  end.
      348                  return yes.
      349               end.
      350            end.
      351         end.
      352         else if     IParent:name         eq "file-info"
      353                 and v-field-handle :name eq "NoTransaction"
      354         then do:
      355           mTransaction = no.
      356         end.
      357         assign
      358            buf_temp_testXML-entity.xmeEntName   = v-field-handle :name
      359            buf_temp_testXML-entity.xmeEntValue  = v-text-handle :node-value
      360         .
      361         if buf_temp_testXML-entity.xmeEntValue eq "unknown_value"  then buf_temp_testXML-entity.xmeEntValue = ?.
      362         xmldom-load-atribut(v-field-handle,buf_temp_testXML-entity.xme-key).
      363         xmldom-load-next-level (v-field-handle,buf_temp_testXML-entity.xme-key, ifilever ).
      364      end.
      365      delete object v-text-handle.
      366      delete object v-field-handle.
      367   end.
      368   function  xmldom-load-ver returns character
      369    (i-full-filename    as character ,
      370      ifilever as integer ):
      371      define variable v-doc-handle    as handle           no-undo.
      372      define variable v-root-handle   as handle           no-undo.
      373      define variable v-table-handle  as handle           no-undo.
      374      define variable v-table-counter as integer      no-undo.
      375      define variable v-table-amount  as integer      no-undo.
      376      define buffer buf_temp_testXML-node         for temp_testXML-node.
      377      mverfile = ?.
      378      mverfile_text = ?.
      379      do
      380      for buf_temp_testXML-node
      381      on error undo, return error
      382      :
      383         assign
      384            i-full-filename = search( i-full-filename )
      385         .
      386         if i-full-filename = ?
      387         then do:
      388            undo, return "Загружаемый файл не найден.".
      389         end.
      390         create x-document v-doc-handle.
      391         v-doc-handle :encoding = "windows-1251":U.
      392         create x-noderef v-root-handle.
      393         create x-noderef v-table-handle.
      394         v-doc-handle :load ( "file", i-full-filename, true ) no-error.
      395         if    error-status :error
      396            or not valid-handle ( v-doc-handle )
      397            or v-doc-handle = ?
      398         then do:
      399            undo, return error vss-description + substitute( "Ошибка загрузки XML-файла &1", i-full-filename ).
      400         end.
      401         v-doc-handle :get-document-element ( v-root-handle ) no-error.
      402         if    error-status :error
      403            or not valid-handle ( v-root-handle )
      404            or v-root-handle = ?
      405         then do:
      406            undo, return error vss-description + substitute( "Ошибка чтения корневого тэга XML-файла &1", i-full-filename ).
      407         end.
      408         assign
      409            v-table-amount = v-root-handle :num-children
      410         no-error.
      411         if    error-status :error
      412            or v-table-amount = ?
      413         then do:
      414            undo, return error vss-description + substitute( ".&1Неверная структура XML-файла &2", chr(10), i-full-filename ).
      415         end.
      416         m-xme-key = v-table-amount +  1.
      417           repeat v-table-counter = 1 to v-table-amount:
      418            v-root-handle :get-child ( v-table-handle, v-table-counter ).
      419            create buf_temp_testXML-node.
      420            assign
      421               buf_temp_testXML-node.xmh-key       = v-table-counter
      422               buf_temp_testXML-node.xmhNodName    = v-table-handle :name
      423            .
      424            xmldom-load-atribut(v-table-handle,buf_temp_testXML-node.xmh-key).
      425            if xmldom-load-next-level (v-table-handle,buf_temp_testXML-node.xmh-key,ifilever)
      426            then do:
      427               for each buf_temp_testXML-node:
      428                  delete buf_temp_testXML-node.
      429               end.
      430               undo, return "Данные уже загружены.".
      431            end.
      432         end.
      433         delete object v-root-handle.
      434         delete object v-doc-handle.
      435         return mverfile_text.
      436      end.
      437   end .
      438   procedure xmldom-load :
      439   define input parameter p-full-filename  as character        no-undo.
      440    xmldom-load-ver(p-full-filename,?) .
      441   end.
      442   function getEnties returns character
      443   (input  i-parkey      as integer ,
      444                                            input i-entity-name    as character ,
      445                                            output o-entity-value  as character,
      446                                            output o-found         as logical ):
      447       define variable v-entity-name       as character no-undo.
      448       define variable v-entity-name-next  as character no-undo.
      449       define buffer buf_temp_testXML-entity    for temp_testXML-entity.
      450       v-entity-name     = entry(1,i-entity-name).
      451       if num-entries(i-entity-name) > 1
      452       then
      453          assign
      454             v-entity-name-next =  substring (i-entity-name,length(v-entity-name) + 2)
      455          .
      456       find first buf_temp_testXML-entity
      457                where buf_temp_testXML-entity.xmh-key      = i-parkey
      458                  and buf_temp_testXML-entity.xmeEntName   = v-entity-name
      459           no-error.
      460       if available buf_temp_testXML-entity
      461       then do:
      462          if v-entity-name-next eq ""
      463          then assign
      464             o-entity-value = buf_temp_testXML-entity.xmeEntValue
      465             o-found        = yes
      466          .
      467          else do :
      468              getEnties(buf_temp_testXML-entity.xme-key,v-entity-name-next,output o-entity-value,output o-found).
      469          end.
      470       end.
      471   end .
      472   procedure xmldom-read-unique :
      473   define input parameter i-node-name      as character        no-undo.
      474   define input parameter i-entity-name    as character        no-undo.
      475   define output parameter o-entity-value  as character        no-undo.
      476   define output parameter o-found         as logical          no-undo.
      477   define variable v-entity-l1-name  as character no-undo.
      478   define variable v-entity-l2-name  as character no-undo.
      479       define buffer buf_temp_testXML-node         for temp_testXML-node.
      480   do
      481   for buf_temp_testXML-node
      482   on error undo, return error
      483   :
      484       assign
      485           o-found = no
      486       .
      487       search-all-nodes:
      488       for each buf_temp_testXML-node
      489          where buf_temp_testXML-node.xmhNodName = i-node-name
      490       :
      491           getEnties(buf_temp_testXML-node.xmh-key,i-entity-name,output o-entity-value,output o-found).
      492      end.
      493   end.
      494   end .
      495       define variable v-enc-file          as character    no-undo.
      496       define variable v-ver-file          as character    no-undo.
      497       define variable v-found             as logical      no-undo.
      498       define variable v-SVNRev-string     as character    no-undo.
      499       define variable v-date-string       as character    no-undo.
      500       define variable v-time-string       as character    no-undo.
      501       define variable v-Release           as character    no-undo.
      502       define variable v-patch             as character    no-undo.
      503       define variable v-branch            as character    no-undo.
      504   do
      505   on error undo, return error return-value
      506   :
      507       assign
      508           p-version           = "":U
      509           p-locale            = "":U
      510           p-SVNRev            = 0
      511           p-compilerVersion   = "":U
      512           p-date              = ?
      513           p-time              = 0
      514           p-comment           = "":U
      515           p-file-date         = ?
      516           p-file-time         = ?
      517       .
      518       assign
      519           v-enc-file = search( "cmp/vertag.enc":U )
      520       .
      521       if v-enc-file = ?
      522       then do:
      523       end.
      524       else do:
      525          file-info:file-name = v-enc-file.
      526          p-file-date = file-info:file-create-date.
      527          p-file-time = file-info:file-create-time.
      528          if file-info:file-create-date eq file-info:file-mod-date
      529          then assign
      530             p-file-date = file-info:file-create-date
      531             p-file-time = max(file-info:file-create-time, file-info:file-mod-time)
      532          .
      533          else if file-info:file-create-date < file-info:file-mod-date
      534          then assign
      535             p-file-date = file-info:file-mod-date
      536             p-file-time = file-info:file-mod-time
      537          .
      538          else assign
      539             p-file-date = file-info:file-create-date
      540             p-file-time = file-info:file-create-time
      541          .
      542           run gbl/_tmpfile.p ( input "cp":U  , input ".ver":U, output v-ver-file ).
      543           run utl/filecryp.p (
      544                 input v-enc-file
      545               , input "sysadm":U
      546               , input no
      547               , input v-ver-file
      548           ).
      549           run xmldom-clear in this-procedure.
      550           run xmldom-load in this-procedure ( v-ver-file ) no-error.
      551           if error-status :error
      552           then do:
      553           end.
      554           else do:
      555               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "version":U         , output p-version            , output v-found   ).
      556               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "locale":U          , output p-locale             , output v-found   ).
      557               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "SVNRev":U          , output v-SVNRev-string      , output v-found   ).
      558               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "compilerVersion":U , output p-compilerVersion    , output v-found   ).
      559               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "date":U            , output v-date-string        , output v-found   ).
      560               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "time":U            , output v-time-string        , output v-found   ).
      561               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "comment":U         , output p-comment            , output v-found   ).
      562               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "Release":U         , output v-Release            , output v-found   ).
      563               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "patch":U           , output v-patch              , output v-found   ).
      564               run xmldom-read-unique in this-procedure ( input "TradeHouse":U, input "branch":U          , output v-branch             , output v-found   ).
      565               o-Release = integer (v-Release)         no-error.
      566               o-patch   = integer (v-patch)           no-error.
      567               o-branch  = integer (v-branch)          no-error.
      568               p-SVNRev  = integer ( v-SVNRev-string ) no-error.
      569               if error-status :error
      570               then do:
      571                   assign
      572                       p-SVNRev = 0
      573                   .
      574               end.
      575               assign
      576                   p-date   = date( v-date-string )
      577               no-error.
      578               if error-status :error
      579               then do:
      580                   assign
      581                       p-date   = ?
      582                   .
      583               end.
      584               assign
      585                   p-time   = integer( v-time-string )
      586               no-error.
      587               if error-status :error
      588               then do:
      589                   assign
      590                       p-time   = 0
      591                   .
      592               end.
      593           end.
      594           os-delete value( v-ver-file ).
      595       end.
      596   end.
