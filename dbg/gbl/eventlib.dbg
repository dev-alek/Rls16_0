        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: eventlib.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/eventlib.p $":U .
        7   define variable vss-description as character no-undo init "Библиотека логмрования событий на кассе и в СВ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define new global shared variable g#eventlib as handle no-undo.
      116   if valid-handle (g#eventlib)
      117   and g#eventlib <> this-procedure :handle
      118   and g#eventlib :get-signature('library_testproc':u) <> ""
      119   then do:
      120     message
      121       vss-workfile vss-revision vss-description skip
      122       "Попытка повторной загрузки библиотеки" skip
      123       g#eventlib skip
      124       g#eventlib :type skip
      125       g#eventlib :file-name skip
      126       valid-handle(g#eventlib) skip
      127       this-procedure :handle skip
      128       this-procedure :type skip
      129       this-procedure :file-name skip
      130       valid-handle(this-procedure) skip
      131       view-as alert-box error .
      132     undo, return error return-value .
      133   end.
      134   else do:
      135     assign
      136       g#eventlib = this-procedure :handle
      137     .
      138   end.
      139   if this-procedure :persistent <> true
      140   then do:
      141     message
      142       vss-workfile vss-revision vss-description skip
      143       "Ошибка запуска библиотеки" program-name(1) skip
      144       "Попытка запустить ее как обычную процедуру" skip
      145       view-as alert-box error .
      146   end.
      147   on delete of this-procedure do:
      148     assign
      149       g#eventlib = ?
      150     .
      151   end.
      152   define variable v-log-level    as integer INIT -1  no-undo.
      153   procedure eventlib-event-log :
      154   define input parameter p-log-level      as integer    no-undo .
      155   define input parameter p-db-num         as integer    no-undo .
      156   define input parameter p-action-item-id as CHARACTER  no-undo .
      157   define input parameter p-cash-num       as integer    no-undo .
      158   define input parameter p-cd-mode        as CHARACTER  no-undo .
      159   define input parameter p-chk-type       as integer    no-undo .
      160   define input parameter p-d-card         as CHARACTER  no-undo .
      161   define input parameter p-description    as CHARACTER  no-undo .
      162   define input parameter p-discnt         as DECIMAL    no-undo .
      163   define input parameter p-doc-code       as CHARACTER  no-undo .
      164   define input parameter p-doc-qnty       as DECIMAL    no-undo .
      165   define input parameter p-event-date     as DATE       no-undo .
      166   define input parameter p-event-id       as integer    no-undo .
      167   define input parameter p-event-time     as integer    no-undo .
      168   define input parameter p-event-type     as CHARACTER  no-undo .
      169   define input parameter p-gds-code       as integer    no-undo .
      170   define input parameter p-obj-type       as character  no-undo .
      171   define input parameter p-obj-code       as integer    no-undo .
      172   define input parameter p-pay-card       as CHARACTER  no-undo .
      173   define input parameter p-pos-type       as CHARACTER  no-undo .
      174   define input parameter p-price          as DECIMAL    no-undo .
      175   define input parameter p-shift-date     as DATE       no-undo .
      176   define input parameter p-shift-name     as CHARACTER  no-undo .
      177   define input parameter p-shift-num      as integer    no-undo .
      178   define input parameter p-src-code       as CHARACTER  no-undo .
      179   define input parameter p-tot-sum        as DECIMAL    no-undo .
      180   define input parameter p-user-id        as CHARACTER  no-undo .
      181   define buffer buf_cd-event-log      for ub.cd-event-log .
      182   define variable v-trans-id       as int64      no-undo .
      183   do
      184   on error undo, return error
      185   :
      186      IF v-log-level < (p-log-level + 1)
      187      THEN DO:
      188         RETURN.
      189      END.
      190      ASSIGN
      191         v-trans-id = NEXT-VALUE(s-cd-events-log, ub)
      192      .
      193      CREATE buf_cd-event-log.
      194      ASSIGN
      195         buf_cd-event-log.db-num          = p-db-num
      196         buf_cd-event-log.trans-id        = v-trans-id
      197         buf_cd-event-log.action-item-id  = p-action-item-id
      198         buf_cd-event-log.cash-num        = p-cash-num
      199         buf_cd-event-log.cd-mode         = p-cd-mode
      200         buf_cd-event-log.chk-type        = p-chk-type
      201         buf_cd-event-log.d-card          = p-d-card
      202         buf_cd-event-log.description     = p-description
      203         buf_cd-event-log.discnt          = p-discnt
      204         buf_cd-event-log.doc-code        = p-doc-code
      205         buf_cd-event-log.doc-qnty        = p-doc-qnty
      206         buf_cd-event-log.event-date      = p-event-date
      207         buf_cd-event-log.event-id        = p-event-id
      208         buf_cd-event-log.event-time      = p-event-time
      209         buf_cd-event-log.event-type      = p-event-type
      210         buf_cd-event-log.gds-code        = p-gds-code
      211         buf_cd-event-log.obj-code        = p-obj-code
      212         buf_cd-event-log.obj-type        = p-obj-type
      213         buf_cd-event-log.pay-card        = p-pay-card
      214         buf_cd-event-log.pos-type        = p-pos-type
      215         buf_cd-event-log.price           = p-price
      216         buf_cd-event-log.shift-date      = IF p-shift-date = ? THEN TODAY ELSE p-shift-date
      217         buf_cd-event-log.shift-name      = p-shift-name
      218         buf_cd-event-log.shift-num       = p-shift-num
      219         buf_cd-event-log.src-code        = p-src-code
      220         buf_cd-event-log.tot-sum         = p-tot-sum
      221         buf_cd-event-log.user-id         = p-user-id
      222      .
      223   end.
      224   end procedure.
      225   procedure eventlib-log-level :
      226   define input parameter p-log-level as integer          no-undo.
      227   define output parameter p-ok as logical          no-undo.
      228   do
      229   on error undo, return error
      230   :
      231      ASSIGN
      232         v-log-level = p-log-level
      233         p-ok        = TRUE
      234      .
      235   end.
      236   end procedure.
      237   procedure send-cctv-prisma :
      238   do
      239   on error undo, return error
      240   :
      241   end.
      242   end procedure.
      243   procedure send-cctv-intel :
      244   do
      245   on error undo, return error
      246   :
      247   end.
      248   end procedure.
