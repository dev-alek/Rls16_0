        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: ftp-ls.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/ftp-ls.p $":U .
       11   define variable vss-description as character no-undo init "Получение списка файлов с FTP".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "X(65)" no-undo
       71   initial "@(#)$Workfile$ $Revision$".
       72   define variable v-filelist-total-file-num           as integer      no-undo .
       73   define variable v-filelist-total-dir-num            as integer      no-undo .
       74   define variable v-filelist-main-procedure-handle    as handle       no-undo .
       75   define variable v-filelist-main-procedure-name      as character    no-undo .
       76   define temp-table temp-dirlist no-undo
       77       field dir-full-name     as character
       78       field dir-short-name    as character
       79       field need-process      as logical
       80       index xpk is primary unique dir-full-name
       81   .
       82   define temp-table temp-filelist no-undo
       83     field file-name        as character
       84     field file-name-no-ext as character
       85     field file-extension   as character
       86     field directory-name   as character
       87     field full-name        as character
       88     field dir-short-name   as character
       89     field need-process     as logical
       90     index xpk is unique primary full-name
       91     index xie1 directory-name file-name
       92     index xie2 directory-name file-name-no-ext
       93     index xie3 file-name
       94     index xie4 file-name-no-ext
       95     index xie5 need-process file-name
       96     .
       97   define stream dir-list .
       98   procedure filelist-get-file-num :
       99     define output parameter p-file-num as integer   no-undo .
      100     do
      101     on error undo, return error return-value
      102     :
      103       assign
      104         p-file-num = v-filelist-total-file-num
      105       .
      106     end.
      107   end procedure.
      108   procedure filelist-clear :
      109     do
      110     on error undo, return error return-value
      111     :
      112       define buffer buf_filelist for temp-filelist .
      113       assign
      114         v-filelist-total-file-num = 0
      115       .
      116       for each buf_filelist
      117       on error undo, return error
      118       :
      119         delete buf_filelist .
      120       end.
      121     end.
      122   end procedure.
      123   procedure filelist-init :
      124     do
      125     on error undo, return error
      126     :
      127       define input parameter p-dir-name       as character no-undo .
      128       define input parameter p-filter-ext     as logical   no-undo .
      129       define input parameter p-ext-list       as character no-undo .
      130       define input parameter p-dir-short-name as character no-undo .
      131       define buffer buf_temp-filelist for temp-filelist .
      132       if p-filter-ext = true
      133          and p-ext-list = ?
      134       or (p-filter-ext = false
      135          and p-ext-list <> ?
      136          and p-ext-list <> "":U
      137          )
      138       then do:
      139         message
      140           vss-workfile vss-revision vss-description skip
      141           "Ошибка задания входных параметров" skip
      142           "p-filter-ext" p-filter-ext skip
      143           "p-ext-list"   p-ext-list   skip
      144           view-as alert-box error .
      145         undo, return error .
      146       end.
      147       for each buf_temp-filelist
      148         where buf_temp-filelist.directory-name = p-dir-name
      149       on error undo, return error return-value
      150       :
      151         delete buf_temp-filelist .
      152       end.
      153       input stream dir-list from os-dir( p-dir-name ).
      154       define variable v-file                  as character no-undo .
      155       define variable v-path                  as character no-undo .
      156       define variable v-mask                  as character no-undo .
      157       define variable v-extension             as character no-undo .
      158       define variable v-file-name-without-ext as character no-undo .
      159       repeat
      160       on error undo, return error
      161       :
      162         import stream dir-list v-file v-path v-mask .
      163         if  v-mask <> ?
      164         and v-mask begins 'F':u
      165         then do:
      166         end.
      167         else do:
      168           next .
      169         end.
      170         if num-entries(v-file, '.':u) > 1
      171         then do:
      172           assign
      173             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      174             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      175           .
      176         end.
      177         else do:
      178           assign
      179             v-extension = ''
      180             v-file-name-without-ext = v-file
      181           .
      182         end.
      183         if p-filter-ext = true
      184         then do:
      185           if lookup(v-extension, p-ext-list) = 0
      186           then do:
      187             next .
      188           end.
      189         end.
      190         create buf_temp-filelist .
      191         assign
      192           buf_temp-filelist.file-name        = v-file
      193           buf_temp-filelist.directory-name   = p-dir-name
      194           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      195           buf_temp-filelist.file-extension   = v-extension
      196           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      197           buf_temp-filelist.dir-short-name   = p-dir-short-name
      198         .
      199         assign
      200           v-filelist-total-file-num = v-filelist-total-file-num + 1
      201         .
      202         if v-filelist-main-procedure-handle <> ?
      203         then do:
      204           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      205             (input "file":U
      206             , input v-filelist-total-file-num
      207             , input buf_temp-filelist.full-name
      208             , input buf_temp-filelist.file-name
      209             ) no-error.
      210           if error-status :error
      211           then do:
      212             message
      213               vss-workfile vss-revision vss-description skip
      214               "filelist-dirlist-subdir-init" skip(1)
      215               skip "Ошибка при вызове процедуры вывода"
      216               skip "результатов сканирования каталогов."
      217               skip return-value
      218               skip trim(error-status :get-message(1))
      219                       trim(error-status :get-message(2))
      220                       trim(error-status :get-message(3))
      221               view-as alert-box error.
      222             undo, return error .
      223           end.
      224         end.
      225       end.
      226       input stream dir-list close .
      227       return.
      228     end.
      229   end procedure.
      230   procedure filelist-dirlist-init-by-list :
      231     do
      232     on error undo, return error
      233     :
      234       define input parameter p-root-dir   as character no-undo .
      235       define input parameter p-dir-list   as character no-undo .
      236       define input parameter p-filter-ext as logical   no-undo .
      237       define input parameter p-ext-list   as character no-undo .
      238       define variable v-num-appdir as integer   no-undo .
      239       do v-num-appdir = 1 to num-entries(p-dir-list)
      240       :
      241         define variable v-curr-dir  as character no-undo .
      242         assign
      243           v-curr-dir = entry(v-num-appdir, p-dir-list)
      244         .
      245         run filelist-init in this-procedure
      246           (input p-root-dir + '/':u + v-curr-dir
      247           ,input p-filter-ext
      248           ,input p-ext-list
      249           ,input v-curr-dir
      250           ) .
      251       end.
      252     end.
      253   end procedure.
      254   procedure filelist-dirlist-clear :
      255     do
      256     on error undo, return error
      257     :
      258       define buffer buf_temp-dirlist for temp-dirlist .
      259       assign
      260           v-filelist-total-dir-num = 0
      261       .
      262       for each buf_temp-dirlist
      263       on error undo, return error
      264       :
      265         delete buf_temp-dirlist .
      266       end.
      267     end.
      268   end procedure.
      269   procedure filelist-dirlist-subdir-init :
      270   define input parameter p-dir-name   as character no-undo .
      271       define buffer buf_temp-dirlist for temp-dirlist .
      272   do
      273   for buf_temp-dirlist
      274   on error undo, return error
      275   :
      276       assign
      277           file-info :file-name = p-dir-name
      278       .
      279       if file-info :full-pathname = ?
      280       or index( file-info :file-type, "D" ) = 0
      281       then do:
      282           message
      283               vss-workfile vss-revision vss-description skip
      284               "filelist-dirlist-init: Заданного каталога не существует."
      285               skip (1)
      286               skip "Задан каталог:"
      287               skip substitute( "'&1'", p-dir-name )
      288           view-as alert-box error .
      289           undo, return error .
      290       end.
      291       input stream dir-list from os-dir( p-dir-name ).
      292       define variable v-file                  as character no-undo .
      293       define variable v-path                  as character no-undo .
      294       define variable v-mask                  as character no-undo .
      295       file-in-directory:
      296       repeat
      297       on error undo, return error
      298       :
      299           import stream dir-list
      300               v-file
      301               v-path
      302               v-mask
      303           .
      304           if  v-mask = ?
      305           or index( v-mask, 'D':u ) = 0
      306           or v-file = ".":U
      307           or v-file = "..":U
      308           then do:
      309               next file-in-directory.
      310           end.
      311           else do:
      312               find first buf_temp-dirlist
      313                    where buf_temp-dirlist.dir-full-name    = v-path
      314               no-error.
      315               if not available buf_temp-dirlist
      316               then do:
      317                   create buf_temp-dirlist .
      318                   assign
      319                       buf_temp-dirlist.dir-full-name    = v-path
      320                       buf_temp-dirlist.dir-short-name   = v-file
      321                       buf_temp-dirlist.need-process     = yes
      322                   .
      323               end.
      324               assign
      325                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      326               .
      327               if v-filelist-main-procedure-handle <> ?
      328               then do:
      329                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      330                         input "dir":U
      331                       , input v-filelist-total-dir-num
      332                       , input buf_temp-dirlist.dir-full-name
      333                       , input buf_temp-dirlist.dir-short-name
      334                   ) no-error.
      335                   if error-status :error
      336                   then do:
      337                       message
      338                           vss-workfile vss-revision vss-description skip
      339                           "filelist-dirlist-subdir-init"
      340                           skip(1)
      341                           skip "Ошибка при вызове процедуры вывода"
      342                           skip "результатов сканирования каталогов."
      343                           skip return-value
      344                           skip trim(error-status :get-message(1))
      345                                trim(error-status :get-message(2))
      346                                trim(error-status :get-message(3))
      347                       view-as alert-box error.
      348                       undo, return error .
      349                   end.
      350               end.
      351           end.
      352       end.
      353       input stream dir-list close .
      354   end.
      355   end procedure.
      356   procedure filelist-dirlist-init :
      357   define input parameter p-dir-name   as character no-undo .
      358       define variable v-file  as character no-undo.
      359       define variable v-path  as character no-undo.
      360       define variable v-mask  as character no-undo.
      361       define buffer buf_temp-dirlist for temp-dirlist .
      362   do
      363   for buf_temp-dirlist
      364   on error undo, return error
      365   :
      366       assign
      367           file-info :file-name = p-dir-name
      368       .
      369       if file-info :full-pathname = ?
      370       or index( file-info :file-type, "D" ) = 0
      371       then do:
      372           message
      373               vss-workfile vss-revision vss-description skip
      374               "filelist-dirlist-init: Заданного каталога не существует."
      375               skip (1)
      376               skip "Задан каталог:"
      377               skip substitute( "'&1'", p-dir-name )
      378           view-as alert-box error .
      379           undo, return error .
      380       end.
      381       for each buf_temp-dirlist
      382          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      383       on error undo, return error return-value
      384       :
      385           delete buf_temp-dirlist .
      386       end.
      387       create buf_temp-dirlist .
      388       assign
      389           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      390           buf_temp-dirlist.dir-short-name   = file-info :file-name
      391           buf_temp-dirlist.need-process     = yes
      392       .
      393       do
      394       while available buf_temp-dirlist
      395       on error undo, return error
      396       :
      397           run filelist-dirlist-subdir-init in this-procedure (
      398               input buf_temp-dirlist.dir-full-name
      399           ).
      400           assign
      401               buf_temp-dirlist.need-process = no
      402           .
      403           find first buf_temp-dirlist
      404                where buf_temp-dirlist.need-process = yes
      405           no-error.
      406       end.
      407   end.
      408   end procedure.
      409   procedure filelist-set-procedure-handle :
      410   define input parameter p-proc-handle    as handle           no-undo.
      411   define input parameter p-proc-name      as character        no-undo.
      412       define variable v-signature    as character    no-undo.
      413   do
      414   on error undo, return error
      415   :
      416       if p-proc-handle = ?
      417       or not valid-handle( p-proc-handle )
      418       or p-proc-handle :get-signature( p-proc-name ) = ""
      419       then do:
      420           assign
      421               v-filelist-main-procedure-handle = ?
      422               v-filelist-main-procedure-name   = ""
      423           .
      424           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      425       end.
      426       else do:
      427           assign
      428               v-signature = p-proc-handle :get-signature( p-proc-name )
      429           .
      430           if entry(   1, v-signature )    = "PROCEDURE":U
      431           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      432           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      433           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      434           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      435           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      436           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      437           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      438           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      439           then do:
      440               assign
      441                   v-filelist-main-procedure-handle = p-proc-handle
      442                   v-filelist-main-procedure-name   = p-proc-name
      443               .
      444           end.
      445           else do:
      446               assign
      447                   v-filelist-main-procedure-handle = ?
      448                   v-filelist-main-procedure-name   = ""
      449               .
      450               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      451           end.
      452       end.
      453   end.
      454   end procedure.
      455   procedure filelist-clear-procedure-handle :
      456   do
      457   on error undo, return error
      458   :
      459       assign
      460           v-filelist-main-procedure-handle = ?
      461           v-filelist-main-procedure-name   = ?
      462       .
      463   end.
      464   end procedure.
      465   procedure filelist-build-by-dirlist :
      466       define buffer buf_temp-dirlist      for temp-dirlist.
      467   do
      468   for buf_temp-dirlist
      469   on error undo, return error
      470   :
      471       for each buf_temp-dirlist
      472       on error undo, return error
      473       :
      474           run filelist-init in this-procedure (
      475                 input buf_temp-dirlist.dir-full-name
      476               , input no
      477               , input "":U
      478               , input buf_temp-dirlist.dir-short-name
      479           ).
      480       end.
      481   end.
      482   end procedure.
      483   procedure filelist-check-dir-exists :
      484   define input parameter p-dir-name   as character        no-undo.
      485   define output parameter p-exists    as logical          no-undo.
      486   do
      487   on error undo, return error
      488   :
      489       assign
      490           file-info :file-name = p-dir-name
      491       .
      492       if file-info :file-type <> ?
      493       and substring( file-info :file-type, 1, 1 ) = "D":U
      494       then do:
      495           assign
      496               p-exists = yes
      497           .
      498       end.
      499       else do:
      500           assign
      501               p-exists = no
      502           .
      503       end.
      504   end.
      505   end procedure.
      506   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   PROCEDURE InternetConnectA EXTERNAL "wininet.dll" PERSISTENT:
      508     define input parameter  hInternetSession  as  long.
      509     define input parameter  lpszServerName    as  char.
      510     define input parameter  nServerPort       as  long.
      511     define input parameter  lpszUserName      as  char.
      512     define input parameter  lpszPassword      as  char.
      513     define input parameter  dwService         as  long.
      514     define input parameter  dwFlags           as  long.
      515     define input parameter  dwContext         as  long.
      516     define return parameter hInternetConnect  as  long.
      517   END.
      518   PROCEDURE InternetGetLastResponseInfoA EXTERNAL "wininet.dll" PERSISTENT:
      519     define output parameter lpdwError          as  long.
      520     define output parameter lpszBuffer         as  char.
      521     define input-output  parameter lpdwBufferLength   as  long.
      522     define return parameter iResultCode       as  long.
      523   END.
      524   PROCEDURE InternetOpenUrlA EXTERNAL "wininet.dll" PERSISTENT:
      525     define input parameter  hInternetSession  as  long.
      526     define input parameter  lpszUrl           as  char.
      527     define input parameter  lpszHeaders       as  char.
      528     define input parameter  dwHeadersLength   as  long.
      529     define input parameter  dwFlags           as  long.
      530     define input parameter  dwContext         as  long.
      531     define return parameter iResultCode       as  long.
      532   END.
      533   PROCEDURE InternetOpenA EXTERNAL "wininet.dll" PERSISTENT:
      534     define input parameter  sAgent            as  char.
      535     define input parameter  lAccessType       as  long.
      536     define input parameter  sProxyName        as  char.
      537     define input parameter  sProxyBypass      as  char.
      538     define input parameter  lFlags            as  long.
      539     define return parameter iResultCode       as  long.
      540   END.
      541   PROCEDURE InternetReadFile EXTERNAL "wininet.dll" PERSISTENT:
      542     define input  parameter  hFile            as  long.
      543     define output parameter  sBuffer          as  char.
      544     define input  parameter  lNumBytesToRead  as  long.
      545     define output parameter  lNumOfBytesRead  as  long.
      546     define return parameter  iResultCode      as  long.
      547   END.
      548   PROCEDURE InternetCloseHandle EXTERNAL "wininet.dll" PERSISTENT:
      549     define input parameter  hInet             as  long.
      550     define return parameter iResultCode       as  long.
      551   END.
      552   PROCEDURE FtpFindFirstFileA EXTERNAL "wininet.dll" PERSISTENT :
      553       define input parameter  hFtpSession as  long.
      554       define input parameter  lpFileName as char.
      555       define input parameter  lpFindFileData as memptr.
      556       define input parameter  dwFlags        as long.
      557       define input parameter  dwContext      as long.
      558       define return parameter hSearch as long.
      559   END PROCEDURE.
      560   PROCEDURE InternetFindNextFileA EXTERNAL "wininet.dll" PERSISTENT:
      561       define input parameter  hSearch as long.
      562       define input parameter  lpFindFileData as memptr.
      563       define return parameter found as long.
      564   END PROCEDURE.
      565   PROCEDURE FtpGetCurrentDirectoryA EXTERNAL "wininet.dll" PERSISTENT:
      566       define input parameter  hFtpSession as long.
      567       define input parameter  lpszCurrentDirectory as long.
      568       define input-output parameter lpdwCurrentDirectory as long.
      569       define return parameter iRetCode as long.
      570   END PROCEDURE.
      571   PROCEDURE FtpSetCurrentDirectoryA EXTERNAL "wininet.dll" PERSISTENT:
      572       define input parameter  hFtpSession as long.
      573       define input parameter  lpszDirectory as long.
      574       define return parameter iRetCode as long.
      575   END PROCEDURE.
      576   PROCEDURE FtpOpenFileA EXTERNAL "wininet.dll" PERSISTENT:
      577       define input parameter  hFtpSession  as long.
      578       define input parameter  lpszFileName as long.
      579       define input parameter  dwAccess     as long.
      580       define input parameter  dwFlags      as long.
      581       define input parameter  dwContext    as long.
      582       define return parameter iRetCode as long.
      583   END PROCEDURE.
      584   PROCEDURE FtpPutFileA EXTERNAL "wininet.dll" PERSISTENT:
      585       define input parameter  hFtpSession       as long.
      586       define input parameter  lpszLocalFile     as long.
      587       define input parameter  lpszNewRemoteFile as long.
      588       define input parameter  dwFlags           as long.
      589       define input parameter  dwContext         as long.
      590       define return parameter iRetCode          as long.
      591   END PROCEDURE.
      592   PROCEDURE FtpGetFileA EXTERNAL "wininet.dll" PERSISTENT:
      593       define input parameter  hFtpSession          as long.
      594       define input parameter  lpszRemoteFile       as long.
      595       define input parameter  lpszNewFile          as long.
      596       define input parameter  fFailIfExists        as long.
      597       define input parameter  dwFlagsAndAttributes as long.
      598       define input parameter  dwFlags              as long.
      599       define input parameter  dwContext            as long.
      600       define return parameter iRetCode             as long.
      601   END PROCEDURE.
      602   PROCEDURE FtpDeleteFileA EXTERNAL "wininet.dll" PERSISTENT:
      603       define input parameter  hFtpSession          as long.
      604       define input parameter  lpszRemoteFile       as long.
      605       define return parameter iRetCode             as long.
      606   END PROCEDURE.
      607   PROCEDURE GetLastError external "kernel32.dll" :
      608     define return parameter dwMessageID as long.
      609   END PROCEDURE.
      610   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   FUNCTION ConnectWinInet RETURNS LOGICAL (
      612                                              output hInternetSession as integer
      613                                           ) :
      614     run InternetOpenA(input  'WebBasedAgent',
      615                       input  0,
      616                       input  '',
      617                       input  '',
      618                       input  0,
      619                       output hInternetSession).
      620     RETURN hInternetSession <> 0.
      621   END FUNCTION.
      622   FUNCTION CloseInternetConnection rETURNS LOGICAL  (
      623                                                    input phInternetSession as integer
      624                                                    ) :
      625   define variable iRetCode      as  integer no-undo.
      626   run InternetCloseHandle(input  phInternetSession,
      627                           output iRetCode).
      628   RETURN iRetCode > 0.
      629   END FUNCTION.
      630   FUNCTION InternetGetLastResponseInfo RETURNS CHARACTER ( ) :
      631   define variable cBuffer            as  character no-undo.
      632   define variable iBufferSz          as  integer init 4096 no-undo.
      633   define variable iResultCode        as  integer no-undo.
      634   define variable iTemp              as  integer no-undo.
      635   assign
      636   cBuffer = fill(' ', iBufferSz).
      637   run InternetGetLastResponseInfoA (output iResultCode,
      638                                     output cBuffer,
      639                                     input-output iBufferSz,
      640                                     output iTemp).
      641   RETURN substitute('Error (&1):  &2',
      642                       iResultCode,
      643                       substr(cBuffer,1,iBufferSz)) .
      644   END FUNCTION.
      645   FUNCTION FtpConnect RETURNS LOGICAL (
      646                                          input hInternetSession as integer
      647                                         ,input p-ftp-ip as character
      648                                         ,input p-ftp-login as character
      649                                         ,input p-ftp-password  as character
      650                                         ,input p-flags as integer
      651                                         ,output hFTPsession as integer
      652                                         ,output p-mes as character
      653                                         ):
      654   define variable ierror as integer no-undo .
      655   define variable v-mes1             as character no-undo .
      656   define variable v-server as character no-undo .
      657   define variable v-port as integer no-undo .
      658   case num-entries(p-ftp-ip, ":"):
      659      when 1 then do:
      660        v-server = p-ftp-ip.
      661        v-port = 21.
      662      end.
      663      when 2 then do:
      664       if entry(1, p-ftp-ip, ":") = "ftp" then do:
      665         assign
      666         v-server = p-ftp-ip
      667         v-port = 21
      668         .
      669       end.
      670       else do:
      671         assign
      672         v-server = entry(1, p-ftp-ip, ":")
      673         v-port = integer(entry(2, p-ftp-ip, ":"))
      674         .
      675       end.
      676     end.
      677     when 3 then do:
      678       if entry(1, p-ftp-ip, ":") <> "ftp" then do:
      679       end.
      680       assign
      681       v-server = entry(2, p-ftp-ip, ":")
      682       v-port = integer(entry(3, p-ftp-ip, ":"))
      683       .
      684     end.
      685   end case.
      686   run InternetConnectA (
      687                         input  hInternetSession
      688                       , input  v-server
      689                       , input  v-port
      690                       , input  p-ftp-login
      691                       , input  p-ftp-password
      692                       , input  1
      693                       , input  p-flags
      694                       , input  0
      695                       , output hFTPSession).
      696   IF hFTPSession = 0 then
      697   do:
      698     run GetLastError (output iError).
      699     p-mes = substitute("Ошибка при FTP соединении: &1", ierror).
      700     assign
      701     v-mes1 = InternetGetLastResponseInfo( )
      702     no-error .
      703     if v-mes1 <> ?
      704     and v-mes1 <> ''
      705     then do:
      706       p-mes = substitute("&1&2&3", p-mes, chr(10), v-mes1).
      707     end.
      708     RETURN FALSE.
      709   end.
      710   RETURN TRUE.
      711   END FUNCTION.
      712   FUNCTION FTPListDir RETURNS INTEGER (
      713                                       INPUT cSearchDir      as character
      714                                       ,INPUT cSearchFileSpec as character
      715                                       ,INPUT hFTPSession     as integer
      716                                       ,INPUT cProgCallBack   as character
      717                                       ,INPUT hCallProc       as HANDLE
      718     ):
      719   define variable lpFindData   as memptr    no-undo.
      720   define variable hSearch      as integer   no-undo.
      721   define variable iFound       as integer   no-undo initial 1.
      722   define variable iFileSpec    as integer   no-undo.
      723   define variable cFileList    as char      no-undo.
      724   define variable iRetCode     as integer   no-undo.
      725   assign
      726   set-size(lpFindData) = 4                                 + 8                                 + 8                                 + 8                                 + 4                                 + 4                                 + 4                                 + 4                                 + 260                       + 14.
      727   do iFileSpec = 1 to num-entries(cSearchFileSpec):
      728     iFound = 1.
      729     run FtpFindFirstFileA (input  hFtpSession,
      730                             input  cSearchDir + '/' +
      731                                   entry(iFileSpec, cSearchFileSpec),
      732                             input  lpFindData,
      733                             input  536870912,
      734                             input  0,
      735                             output hSearch).
      736     if hSearch <> -1 then
      737     repeat while iFound <> 0:
      738       run value(cProgCallBack) in hCallProc
      739             (input lpFindData,
      740               input  cSearchDir).
      741       run InternetFindNextFileA (input  hSearch,
      742                                   input  lpFindData,
      743                                   output iFound).
      744     end.
      745     else
      746       iRetCode = 5.
      747   end.
      748   set-size(lpFindData) = 0.
      749   run InternetCloseHandle (input hSearch, OUTPUT iRetCode).
      750   return iRetCode.
      751   END FUNCTION.
      752   FUNCTION FtpGetFile RETURNS logical
      753     (
      754       input hFtpSession as integer
      755      ,input p-rfilename as character
      756      ,input p-lFilename as character
      757      ,output p-mes as character
      758     ) :
      759   define variable lpRemoteFile   as  memptr  no-undo.
      760   define variable lpNewFile      as  memptr  no-undo.
      761   define variable fOverwirte     as  log     no-undo.
      762   define variable iRetCode       as  integer no-undo.
      763   define variable cRemoteFile    as  char    no-undo.
      764   assign
      765   set-size(lpRemoteFile)     = length(p-Rfilename) + 1
      766   put-string(lpRemoteFile,1) = p-rfilename
      767   set-size(lpNewFile)        = length(p-lfilename) + 1
      768   put-string(lpNewFile,1)    = p-lfilename.
      769   run FtpGetFileA(input hFtpSession,
      770                   input get-pointer-value(lpRemoteFile),
      771                   input get-pointer-value(lpNewFile),
      772                   input 0,
      773                   input 128,
      774                   input 2,
      775                   input 0,
      776                   output iRetCode).
      777   assign
      778   set-size(lpRemoteFile)     = 0
      779   set-size(lpNewFile)        = 0.
      780   if iRetCode = 0 then do:
      781     p-mes = InternetGetLastResponseInfo().
      782     return no.
      783   end.
      784   else do:
      785     p-mes = ''.
      786     return yes.
      787   end.
      788   END FUNCTION.
      789   FUNCTION FtpDeleteFile RETURNS LOGICAL (
      790                                              input hFtpSession as integer
      791                                             ,input p-rfilename as character
      792                                             ,output p-mes as character
      793                                            ) :
      794   define variable lpRemoteFile   as  memptr  no-undo.
      795   define variable iRetCode       as  integer no-undo.
      796   define variable cRemoteFile    as  char    no-undo.
      797   assign
      798   set-size(lpRemoteFile)     = length(p-rfilename) + 1
      799   put-string(lpRemoteFile,1) = p-rfilename.
      800   run FtpDeleteFileA(input hFtpSession,
      801                       input get-pointer-value(lpRemoteFile),
      802                       output iRetCode).
      803   assign
      804   set-size(lpRemoteFile)     = 0.
      805   if iRetCode = 0 then do:
      806     p-mes = InternetGetLastResponseInfo().
      807     return no.
      808   end.
      809   else do:
      810     return yes.
      811   end.
      812   END FUNCTION.
      813   FUNCTION FtpPutFile RETURNS logical (
      814                                          input hFTPsession as integer
      815                                         ,input p-LFilename as character
      816                                         ,input p-rfilename as character
      817                                         ,output p-mes as character
      818                                         ) :
      819   define variable lpLocalFile        as  memptr  no-undo.
      820   define variable  lpNewRemoteFile    as  memptr  no-undo.
      821   define variable  fOverwirte         as  log     no-undo.
      822   define variable  iRetCode           as  integer no-undo.
      823   assign
      824   set-size(lpNewRemoteFile)     = length(p-RFilename) + 1
      825   put-string(lpNewRemoteFile,1) = p-RFilename
      826   set-size(lpLocalFile)         = length(p-LFilename) + 1
      827   put-string(lpLocalFile,1)     = p-LFilename.
      828   run FtpPutFileA(input hFtpSession,
      829                   input get-pointer-value(lpLocalFile),
      830                   input get-pointer-value(lpNewRemoteFile),
      831                   input 2,
      832                   input 0,
      833                   output iRetCode).
      834   assign
      835   set-size(lpNewRemoteFile)     = 0
      836   set-size(lpLocalFile)         = 0.
      837   if iRetCode = 0 then do:
      838     p-mes = InternetGetLastResponseInfo().
      839     return no.
      840   end.
      841   else do:
      842     return yes.
      843   end.
      844   END FUNCTION.
      845   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   procedure ftp-fl_CreateFileList :
      847   define input parameter lpFindData   as  memptr no-undo.
      848   define input parameter pcSearchDir  as  char   no-undo.
      849   define variable iFileSize           as  integer no-undo.
      850   define variable lResult             as  logical no-undo.
      851   define variable v-file-name as character no-undo .
      852   define buffer buf_temp-dirlist for temp-dirlist.
      853   define buffer buf_temp-filelist for temp-filelist.
      854   do
      855   on error undo, return error
      856   :
      857       if get-long(lpFindData, 1) = 16 then do:
      858       v-file-name = get-string(lpFindData,45).
      859       find first buf_temp-dirlist where
      860                 buf_temp-dirlist.dir-full-name = pcSearchDir + chr(47) + v-file-name no-error.
      861       if not available buf_temp-dirlist then do:
      862         create buf_temp-dirlist.
      863         assign
      864         buf_temp-dirlist.dir-full-name = pcSearchDir + chr(47) + v-file-name
      865         buf_temp-dirlist.dir-short-name = v-file-name
      866         .
      867       end.
      868     end.
      869     else do:
      870       assign
      871       iFileSize = get-long(lpFindData,33)
      872       .
      873       v-file-name = get-string(lpFindData,45).
      874       if v-file-name <> '' then do:
      875         find first buf_temp-filelist where
      876                   buf_temp-filelist.full-name = pcSearchDir + chr(47) + v-file-name no-error.
      877         if not available buf_temp-filelist then do:
      878           create buf_temp-filelist.
      879           assign
      880           buf_temp-filelist.full-name = pcSearchDir + chr(47) + v-file-name
      881           buf_temp-filelist.directory-name = pcSearchDir
      882           buf_temp-filelist.file-name = v-file-name
      883           .
      884         end.
      885       end.
      886     end.
      887   end.
      888   end procedure.
      889   define variable hInternetSession   as  integer  no-undo.
      890   define variable hFTPSession        as  integer  no-undo.
      891   define variable cCurrentDir        as  character no-undo.
      892   define variable log-file-name as character no-undo .
      893   define variable p-ftp-ip as character no-undo .
      894   define variable p-ftp-login as character no-undo .
      895   define variable p-ftp-password as character no-undo .
      896   define variable p-rdir as character no-undo .
      897   define variable p-flags as integer no-undo .
      898   define variable v-mes as character no-undo .
      899   define variable v-cb-proc as character no-undo .
      900   define buffer buf_temp-filelist for temp-filelist.
      901   do
      902   on error undo, return error
      903   :
      904       if num-entries(p-parameter, chr(4) ) <> 7 then do:
      905               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1 &2 &3 Неверно переданы параметры"                                   ,vss-workfile                                    ,vss-revision                                    ,vss-description)).
      906         undo, return error ''.
      907       end.
      908       assign
      909       p-ftp-ip = entry(1, p-parameter, chr(4))
      910       p-ftp-login = entry(2, p-parameter, chr(4))
      911       p-ftp-password = entry(3, p-parameter, chr(4))
      912       p-flags =  integer(entry(4, p-parameter, chr(4)))
      913       p-rdir = entry(5, p-parameter, chr(4))
      914       v-cb-proc = entry(6, p-parameter, chr(4))
      915       log-file-name = entry(7, p-parameter, chr(4))
      916       .
      917           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Соединяюсь с &1... ", p-ftp-ip)).
      918       if not ConnectWinInet ( output hInternetSession  ) then do:
      919               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не могу установить соединение с &1", p-ftp-ip)).
      920         undo,  return error ''.
      921       end.
      922       else  do:
      923         if FTPConnect ( input hInternetSession
      924                        ,input p-ftp-ip
      925                        ,input p-ftp-login
      926                        ,input p-ftp-password
      927                        ,input p-flags
      928                        ,output hFTPsession
      929                        ,output v-mes
      930                        )
      931         then do:
      932                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Получаю список файлов в директории  &1 ", p-rdir)).
      933           FTPListDir (
      934                      INPUT (if p-rdir > '' then p-rdir else '.')
      935                    , INPUT '*.*'
      936                    , INPUT hFTPSession
      937                    , INPUT (if v-cb-proc > '' then v-cb-proc else 'ftp-fl_CreateFileList')
      938                    , INPUT (if v-cb-proc > ''
      939                             then p-parent-handle
      940                             else THIS-PROCEDURE)
      941                      ).
      942         end.
      943         else do:
      944           CloseInternetConnection(hInternetSession).
      945                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-mes).
      946           undo, return error ''.
      947         end.
      948         CloseInternetConnection(hInternetSession).
      949       end.
      950       if v-cb-proc  = '' then do:
      951         for each buf_temp-filelist:
      952           message
      953           buf_temp-filelist.full-name
      954           view-as alert-box .
      955         end.
      956      end.
      957   end.
