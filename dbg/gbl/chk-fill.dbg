        1   block-level on error undo, throw.
        2   define input parameter p-is-wth as integer no-undo .
        3   define input parameter rs-list-method as character no-undo .
        4   define input parameter par-run-name as character no-undo .
        5   define input parameter rs-status as character no-undo .
        6   define input parameter v-start-date as date no-undo.
        7   define input parameter v-end-date as date no-undo.
        8   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        9   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       10   define input parameter line-mode as character no-undo .
       11   define input parameter p-table-name as character no-undo .
       12   define input parameter p-filter-var as character no-undo .
       13   define input parameter p-dop-filter as character no-undo .
       14   define input-output parameter lns-cnt as integer no-undo .
       15   define output parameter line-rec as recid no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       18   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: chk-fill.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: gbl/chk-fill.p $":U .
       21   define variable vss-description as character no-undo init "Фильтр в списке документов".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define  shared  temp-table chk-list no-undo
       93   field doc-code   like ub.chk-doc.doc-code
       94   field obj-type   like ub.chk-doc.obj-type
       95   field obj-code   like ub.chk-doc.obj-code
       96   field out-code   like ub.chk-doc.out-code
       97   field chk-date   like ub.chk-doc.chk-date
       98   field chk-time   like ub.chk-doc.chk-time
       99   field shift-date like ub.chk-doc.shift-date
      100   field shift-num  like ub.chk-doc.shift-num
      101   field shift-name  like ub.chk-doc.shift-name
      102   field src-shift-date like ub.chk-doc.src-shift-date
      103   field chk-num    like ub.chk-doc.chk-num
      104   field pay-desk   like ub.chk-doc.pay-desk
      105   field cashier    like ub.chk-doc.cashier
      106   field cashier-psn-code    like ub.chk-doc.cashier-psn-code
      107   field chk-type   like ub.chk-doc.chk-type
      108   field d-card     like ub.chk-doc.d-card
      109   field netto      like ub.chk-doc.netto
      110   field discnt     like ub.chk-doc.discnt
      111   field tot-doc    like ub.chk-doc.tot-doc
      112   field is-wth     as logical
      113   field sel-order  as integer
      114   field znak       as integer
      115   field to-del     as logical
      116   field doc-num    as character label "№ док-та" format "X(22)"
      117   field doc-num2   as character label "№ заказа" format "X(22)"
      118   index xpk is primary unique doc-code is-wth
      119   index znak-order znak sel-order .
      120   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define   shared   temp-table chk-list-hist no-undo
      122   field list-table as character
      123   field id as integer
      124   field line as integer
      125   field hist-mode as character
      126   field des as character
      127   field num-recs as integer
      128   field option_ as character
      129   field item_ as character
      130   field status_ as character
      131   field num-add as integer
      132   field num-ignored as integer
      133   field done as logical
      134   field err_ as logical
      135   field err-mes as character
      136   index pi is primary
      137   id
      138   line
      139   index isdone
      140   done
      141   .
      142   define variable dsp-rs as character format "x(50)" no-undo.
      143   define variable lns-ignore as integer no-undo .
      144   define variable kk as integer no-undo .
      145   define variable v-doc-code like ub.chk-doc.doc-code no-undo .
      146   define variable v-prepare-string as character no-undo .
      147   define variable glog as logical no-undo .
      148   define query chk-doc-fill for ub.chk-doc.
      149   define query chk-gds-fill for ub.chk-doc, ub.chk-gds.
      150   define query chk-pay-fill for ub.chk-doc, ub.chk-pay.
      151   define query chk-doc-autotank-fill for ub.chk-doc, ub.chk-pay, ub.chk-pay-attr .
      152   define frame abc
      153   dsp-rs no-label
      154   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      155   TITLE par-run-name.
      156   view frame abc.
      157   disp dsp-rs with frame abc.
      158   case p-table-name:
      159     when 'chk-doc':U then do:
      160        v-prepare-string = substitute('for each chk-doc no-lock where chk-doc.obj-type = "&1" ' +
      161                                      'and chk-doc.obj-code = &2 and ' +
      162                                       p-dop-filter + chr(32) + p-filter-var
      163                                       , p-obj-type
      164                                       , p-obj-code
      165                                       ).
      166         glog = query chk-doc-fill:handle:query-prepare(v-prepare-string) no-error.
      167         if not glog
      168         or error-status:error then do:
      169           message
      170           substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      171                     , chr(10)
      172                     , error-status:get-message(1)
      173                     , p-filter-var)
      174           view-as alert-box error .
      175           undo, return error .
      176         end.
      177         glog = query chk-doc-fill:handle:query-open() no-error.
      178         if not glog
      179         or error-status:error then do:
      180           message
      181           substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      182                     , chr(10)
      183                     , error-status:get-message(1)
      184                     , p-filter-var)
      185           view-as alert-box error .
      186           undo, return error .
      187         end.
      188         REPEAT WITH FRAME abc:
      189           query chk-doc-fill:handle:GET-NEXT().
      190           IF query chk-doc-fill:handle:QUERY-OFF-END THEN LEAVE.
      191           process events.
      192           run ex-chk in this-procedure ( input rs-list-method, input rs-status, input line-mode).
      193        end.
      194        glog = query chk-doc-fill:handle:query-close() no-error.
      195     end.
      196     when 'chk-gds':U then do:
      197       v-prepare-string = substitute('for each chk-doc no-lock where chk-doc.obj-type = "&1" and chk-doc.obj-code = &2 and ' +
      198                                     p-dop-filter + ", each chk-gds no-lock where chk-gds.doc-code = chk-doc.doc-code " + p-filter-var
      199                                     , p-obj-type
      200                                     , p-obj-code)
      201                                     .
      202       glog = query chk-gds-fill:handle:query-prepare(v-prepare-string) no-error.
      203       if not glog
      204       or error-status:error then do:
      205         message
      206         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      207                   , chr(10)
      208                   , error-status:get-message(1)
      209                   , p-filter-var)
      210         view-as alert-box error .
      211         undo, return error .
      212       end.
      213       glog = query chk-gds-fill:handle:query-open() no-error.
      214       if not glog
      215       or error-status:error then do:
      216         message
      217         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      218                   , chr(10)
      219                   , error-status:get-message(1)
      220                   , p-filter-var)
      221         view-as alert-box error .
      222         undo, return error .
      223       end.
      224       REPEAT WITH FRAME abc:
      225         query chk-gds-fill:handle:GET-NEXT().
      226         IF query chk-gds-fill:handle:QUERY-OFF-END THEN LEAVE.
      227         process events.
      228         run ex-chk in this-procedure ( input rs-list-method, input rs-status, input line-mode).
      229         assign
      230         v-doc-code = chk-doc.doc-code.
      231       end.
      232       glog = query chk-gds-fill:handle:query-close() no-error.
      233     end.
      234     when 'chk-pay':U then do:
      235       v-prepare-string = substitute('for each chk-doc no-lock where chk-doc.obj-type = "&1" and chk-doc.obj-code = &2 and ' +
      236                                      p-dop-filter + ", each chk-pay no-lock where chk-pay.doc-code = chk-doc.doc-code " + p-filter-var
      237                                      , p-obj-type
      238                                      , p-obj-code)
      239                                      .
      240       glog = query chk-pay-fill:handle:query-prepare(v-prepare-string) no-error.
      241       if not glog
      242       or error-status:error then do:
      243         message
      244         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      245                   , chr(10)
      246                   , error-status:get-message(1)
      247                   , p-filter-var)
      248         view-as alert-box error .
      249         undo, return error .
      250       end.
      251       glog = query chk-pay-fill:handle:query-open() no-error.
      252       if not glog
      253       or error-status:error then do:
      254         message
      255         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      256                   , chr(10)
      257                   , error-status:get-message(1)
      258                   , p-filter-var)
      259         view-as alert-box error .
      260         undo, return error .
      261       end.
      262       REPEAT WITH FRAME abc:
      263         query chk-pay-fill:handle:GET-NEXT().
      264         IF query chk-pay-fill:handle:QUERY-OFF-END THEN LEAVE.
      265         process events.
      266         run ex-chk in this-procedure ( input rs-list-method, input rs-status, input line-mode).
      267         assign
      268         v-doc-code = chk-doc.doc-code.
      269       end.
      270       glog = query chk-pay-fill:handle:query-close() no-error.
      271     end.
      272     when 'chk-pay-attr':U then do:
      273        v-prepare-string = substitute('for each chk-doc no-lock where chk-doc.obj-type = "&1" ' +
      274                                      'and chk-doc.obj-code = &2 and ' +
      275                                       p-dop-filter + chr(32) + p-filter-var +
      276                                       ", each chk-pay no-lock where chk-pay.doc-code = chk-doc.doc-code " +
      277                                       ", each chk-pay-attr no-lock where chk-pay-attr.doc-code = chk-pay.doc-code " +
      278                                       "        and chk-pay-attr.line-num = chk-pay.line-num " +
      279                                       "        and chk-pay-attr.attr-code = 'autotank-sum-return'"
      280                                       , p-obj-type
      281                                       , p-obj-code
      282                                       ).
      283         glog = query chk-doc-autotank-fill:handle:query-prepare(v-prepare-string) no-error.
      284         if not glog
      285         or error-status:error then do:
      286           message
      287           substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      288                     , chr(10)
      289                     , error-status:get-message(1)
      290                     , p-filter-var)
      291           view-as alert-box error .
      292           undo, return error .
      293         end.
      294         glog = query chk-doc-autotank-fill:handle:query-open() no-error.
      295         if not glog
      296         or error-status:error then do:
      297           message
      298           substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      299                     , chr(10)
      300                     , error-status:get-message(1)
      301                     , p-filter-var)
      302           view-as alert-box error .
      303           undo, return error .
      304         end.
      305         REPEAT WITH FRAME abc:
      306           query chk-doc-autotank-fill:handle:GET-NEXT().
      307           IF query chk-doc-autotank-fill:handle:QUERY-OFF-END THEN LEAVE.
      308           process events.
      309           run ex-chk in this-procedure ( input 1, input rs-list-method, input rs-status, input line-mode).
      310        end.
      311        glog = query chk-doc-autotank-fill:handle:query-close() no-error.
      312     end.
      313   end case.
      314   hide frame abc.
      315   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   PROCEDURE ex-chk :
      317   define input parameter rs-list-method as character no-undo .
      318   define input parameter rs-status as character no-undo .
      319   define input parameter line-mode as character no-undo .
      320   define variable v-process as logical no-undo .
      321   define variable v-start-date as date no-undo .
      322   define variable v-end-date as date no-undo .
      323     CASE entry(1, rs-status, chr(4)):
      324       when "chk-date":U then do:
      325         ASSIGN
      326         V-START-DATE = DATE(ENTRY(2, rs-status, chr(4)))
      327         V-END-DATE = DATE(ENTRY(3, rs-status, chr(4)))
      328         rs-status = entry(1, rs-status, chr(4))
      329         .
      330       end.
      331     END CASE.
      332     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
      333       find first chk-list where
      334                 chk-list.doc-code = ub.chk-doc.doc-code
      335                 no-error.
      336       if available chk-list then do:
      337         if rs-list-method = "single":U or           (rs-status = 'все':U            or            (chk-doc.out-code = ? and rs-status = "free":U)            or            (chk-doc.chk-date >= v-start-date and chk-doc.chk-date <= v-end-date and rs-status = "chk-date":U)           )
      338         then do:
      339           assign
      340           v-process = yes
      341           .
      342         end.
      343         if line-mode = 'удаление':U and v-process then do:
      344           if chk-list.doc-code <> v-doc-code then
      345           lns-cnt = lns-cnt + 1.
      346           delete chk-list.
      347         end.
      348         if line-mode = 'ОСТАВИТЬ':U and  v-process then do:
      349           if chk-list.to-del = ? then .
      350           else do:
      351             if chk-list.doc-code <> v-doc-code then
      352             lns-cnt = lns-cnt + 1.
      353             assign chk-list.to-del = ?.
      354           end.
      355         end.
      356         if not v-process
      357         and chk-list.doc-code <> v-doc-code
      358         then
      359         assign
      360         lns-ignore = lns-ignore + 1
      361         .
      362       end.
      363     end.
      364     else
      365       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
      366         if rs-list-method = "single":U or           (rs-status = 'все':U            or            (chk-doc.out-code = ? and rs-status = "free":U)            or            (chk-doc.chk-date >= v-start-date and chk-doc.chk-date <= v-end-date and rs-status = "chk-date":U)           ) then do:
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   find chk-list
      369     where chk-list.doc-code = chk-doc.doc-code
      370     no-error .
      371   if available chk-list then do:
      372     assign
      373       chk-list.to-del = no
      374     .
      375   end.
      376   else do:
      377     create chk-list .
      378     assign
      379     chk-list.doc-code   = chk-doc.doc-code
      380     chk-list.obj-type   = chk-doc.obj-type
      381     chk-list.obj-code   = chk-doc.obj-code
      382     chk-list.out-code   = chk-doc.out-code
      383     chk-list.chk-date  = chk-doc.chk-date
      384     chk-list.chk-time  = chk-doc.chk-time
      385     chk-list.shift-date = chk-doc.shift-date
      386     chk-list.shift-num  = chk-doc.shift-num
      387     chk-list.src-shift-date = chk-doc.src-shift-date
      388     chk-list.chk-num    = chk-doc.chk-num
      389     chk-list.pay-desk   = chk-doc.pay-desk
      390     chk-list.cashier    = chk-doc.cashier
      391     chk-list.cashier-psn-code   = chk-doc.cashier-psn-code
      392     chk-list.chk-type   = chk-doc.chk-type
      393     chk-list.d-card     = chk-doc.d-card
      394     chk-list.is-wth     = LOOKUP(string(chk-doc.chk-type), '2,3,4,5,7':U) > 0
      395     chk-list.doc-num    = chk-doc.doc-num
      396     chk-list.doc-num2   = chk-doc.doc-num2
      397     chk-list.to-del = no
      398     .
      399     if chk-list.is-wth = no then do:
      400       assign
      401       chk-list.netto      = buffer chk-doc:handle:buffer-field("netto"):buffer-value
      402       chk-list.tot-doc    = buffer chk-doc:handle:buffer-field("tot-doc"):buffer-value
      403       chk-list.discnt     = buffer chk-doc:handle:buffer-field("discnt"):buffer-value
      404       no-error
      405       .
      406     end.
      407     else do:
      408       assign
      409       chk-list.netto      = 0
      410       chk-list.tot-doc    = 0
      411       chk-list.discnt     = 0
      412       no-error
      413       .
      414     end.
      415     assign
      416       lns-cnt = lns-cnt + 1
      417       line-rec = recid (chk-list)
      418     .
      419   end.
      420         end.
      421         else assign
      422         lns-ignore = lns-ignore + 1
      423         .
      424       end.
      425     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame abc.
      426   end PROCEDURE.
