    12853            .
    12854            find first buf_tt-line
    12855               where buf_tt-line.type = 0
    12856                  AND buf_tt-line.src  = v-found-str
    12857                  AND buf_tt-line.num  > v-found-num
    12858               NO-LOCK
    12859               no-error
    12860               .
    12861         end.
    12862         else do:
    12863            assign
    12864               p-message    = "По запросу ничего не найдено."
    12865               p-cd-submode = "0"
    12866               v-found-num  = 0
    12867               p-ok         = FALSE
    12868            .
    12869            return.
    12870         end.
    12871      end.
