     3454     v-summ-2 = 0
     3455     v-summ-3 = 0
     3456     v-summ-4 = 0
     3457      .
     3458     for each  buf_tt-line
     3459         where buf_tt-line.type = 1
     3460         :
     3461       case buf_tt-line.fr-pay-code :
     3462         WHEN 1 then do:
     3463           assign
     3464           v-summ-1 = v-summ-1 + if p-cd-mode = "2" then - buf_tt-line.summ-netto else buf_tt-line.summ-netto
     3465           .
     3466         end.
     3467         WHEN 2 then do:
     3468           assign
     3469           v-summ-2 = v-summ-2 + if p-cd-mode = "2" then - buf_tt-line.summ-netto else buf_tt-line.summ-netto
     3470           .
     3471         end.
     3472         WHEN 3 then do:
     3473           assign
     3474           v-summ-3 = v-summ-3 + if p-cd-mode = "2" then - buf_tt-line.summ-netto else buf_tt-line.summ-netto
     3475           .
     3476         end.
     3477         WHEN 4 then do:
