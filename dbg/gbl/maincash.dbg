     8089            find first buf_cash-pay
     8090                 where buf_cash-pay.cdpay-code = v-pay-type
     8091                   AND buf_cash-pay.curr-code  = v-curr-base-code
     8092                 NO-LOCK
     8093                 no-error
     8094                 .
     8095            run accum-curr-chk-pay in this-procedure ( input  buf_cash-pay.pay-code
     8096                                                , input  v-curr-base-code
     8097                                                , input  v-card-num
     8098                                                , output v-summ-pay-curr
     8099                                                ) .
     8100            run accum-chk-pay in this-procedure ( input  buf_cash-pay.cdpay-code
     8101                                                , input  v-curr-base-code
     8102                                                , input  v-card-num
     8103                                                , output v-found-pay
     8104                                                , output v-summ-pay-2
     8105                                                ) .
     8106            if  v-summ-pay-2 < (ABS(v-tot-rubl) - v-summ-pay-curr)
     8107            AND v-found-pay
     8108            then do:
     8109               message
     8110               "Максимальная сумма, которую вы можете вернуть" skip
     8111               "этим типом платежа, по этому чеку:" SKIP
     8112               v-summ-pay-2 skip
     8113               view-as alert-box information.
     8114               assign
     8115               v-mode = 'удаление':U
