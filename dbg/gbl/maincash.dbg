    16028      define variable v-summ-1  as decimal      no-undo.
    16029      define variable v-summ-2  as decimal      no-undo.
    16030      define variable v-summ-3  as decimal      no-undo.
    16031      define variable v-summ-4  as decimal      no-undo.
    16032      assign
    16033         v-summ-1 = 0
    16034         v-summ-2 = 0
    16035         v-summ-3 = 0
    16036         v-summ-4 = 0
    16037      .
    16038      for each  buf_tt-line
    16039         where buf_tt-line.type = 1
    16040      :
    16041         case buf_tt-line.fr-pay-code :
    16042            WHEN 1 then do:
    16043               assign
    16044                  v-summ-1 = v-summ-1 + if p-cd-mode = "2" then - buf_tt-line.summ-netto-rub else buf_tt-line.summ-netto-rub
    16045               .
    16046            end.
    16047            WHEN 2 then do:
    16048               assign
    16049                  v-summ-2 = v-summ-2 + if p-cd-mode = "2" then - buf_tt-line.summ-netto-rub else buf_tt-line.summ-netto-rub
    16050               .
    16051            end.
    16052            WHEN 3 then do:
    16053               assign
    16054                  v-summ-3 = v-summ-3 + if p-cd-mode = "2" then - buf_tt-line.summ-netto-rub else buf_tt-line.summ-netto-rub
    16055               .
    16056            end.
    16057            WHEN 4 then do:
    16058               assign
    16059                  v-summ-4 = v-summ-4 + if p-cd-mode = "2" then - buf_tt-line.summ-netto-rub else buf_tt-line.summ-netto-rub
    16060               .
    16061            end.
    16062            OTHERWISE DO:
