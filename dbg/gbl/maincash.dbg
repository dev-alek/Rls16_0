    17968        f11 AT ROW 16.04 COL 66.5 WIDGET-ID 24
    17969        f12 AT ROW 17.54 COL 66.5 WIDGET-ID 26
    17970        v-balance AT ROW 16.5 COL 26.5 NO-LABEL WIDGET-ID 38
    17971        v-time AT ROW 19.29 COL 72 NO-LABEL WIDGET-ID 62
    17972        v-total AT ROW 16.33 COL 14.38 RIGHT-ALIGNED WIDGET-ID 42
    17973        v-discount AT ROW 16.92 COL 5 COLON-ALIGNED WIDGET-ID 44
    17974        v-payment AT ROW 17.79 COL 5 COLON-ALIGNED WIDGET-ID 46
    17975        b-exit AT ROW 1 COL 66.5 WIDGET-ID 82
    17976        v-disc-pay AT ROW 18.38 COL 5 COLON-ALIGNED WIDGET-ID 112
    17977        v-dop-mess AT ROW 19.29 COL 31.5 COLON-ALIGNED NO-LABEL WIDGET-ID 114
    17978        RECT-1 AT ROW 19.13 COL 1 WIDGET-ID 34
    17979        RECT-4 AT ROW 19.13 COL 64 WIDGET-ID 84
    17980        RECT-5 AT ROW 15.46 COL 1 WIDGET-ID 92
    17981        RECT-6 AT ROW 19.13 COL 32.5 WIDGET-ID 110
    17982       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
    17983            SIDE-LABELS NO-UNDERLINE THREE-D
    17984            AT COL 1 ROW 1
    17985            SIZE 77 BY 19.17
    17986            FONT 24 WIDGET-ID 100.
    17987   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
    17988     CREATE WINDOW C-Win ASSIGN
    17989            HIDDEN             = YES
    17990            TITLE              = "Касса IBS TH POS"
    17991            HEIGHT             = 19.17
    17992            WIDTH              = 77
    17993            MAX-HEIGHT         = 19.17
    17994            MAX-WIDTH          = 77.5
    17995            VIRTUAL-HEIGHT     = 19.17
    17996            VIRTUAL-WIDTH      = 77.5
    17997            RESIZE             = yes
    17998            SCROLL-BARS        = no
    17999            STATUS-AREA        = no
    18000            BGCOLOR            = ?
    18001            FGCOLOR            = ?
    18002            KEEP-FRAME-Z-ORDER = yes
    18003            THREE-D            = yes
    18004            MESSAGE-AREA       = no
    18005            SENSITIVE          = yes.
    18006   ELSE C-Win = CURRENT-WINDOW.
    18007   ASSIGN C-Win:MENUBAR    = MENU MENU-BAR-C-Win:HANDLE.
    18008   ASSIGN
    18009          br-line:NUM-LOCKED-COLUMNS IN FRAME DEFAULT-FRAME     = 2.
    18010   ASSIGN
    18011          v-balance:AUTO-RESIZE IN FRAME DEFAULT-FRAME      = TRUE.
    18012   ASSIGN
    18013          v-card-num:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18014   ASSIGN
    18015          v-chk-num:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18016   ASSIGN
    18017          v-client-name:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18018   ASSIGN
    18019          v-date:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18020   ASSIGN
    18021          v-dop-mess:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18022   ASSIGN
    18023          v-ed-message:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18024   ASSIGN
    18025          v-label-balance:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18026   ASSIGN
    18027          v-mode-name:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
    18028   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
    18029   THEN C-Win:HIDDEN = no.
    18030   CREATE CONTROL-FRAME CtrlFrame ASSIGN
    18031          FRAME           = FRAME DEFAULT-FRAME:HANDLE
    18032          ROW             = 18.75
    18033          COLUMN          = 73.5
    18034          HEIGHT          = 1.25
    18035          WIDTH           = 4
    18036          WIDGET-ID       = 60
    18037          HIDDEN          = yes
    18038          SENSITIVE       = yes.
    18039         CtrlFrame:MOVE-AFTER(f11:HANDLE IN FRAME DEFAULT-FRAME).
    18040   ON END-ERROR OF C-Win
    18041   OR ENDKEY OF C-Win ANYWHERE DO:
    18042      RUN rule-run        IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode, INPUT-OUTPUT v-cd-submode, INPUT KEYLABEL(LASTKEY), INPUT 'th-pos-keyboard':U,   OUTPUT v-message, OUTPUT v-ok ) NO-ERROR.
    18043      IF ERROR-STATUS:ERROR
    18044      THEN DO:
    18045         ASSIGN
    18046            v-ok = FALSE
    18047         .
    18048      END.
    18049      ASSIGN
    18050         v-src-input = "":U
    18051      .
    18052      RUN Post_Enable_Ui IN THIS-PROCEDURE.
    18053      RETURN no-apply.
    18054   END.
    18055   ON WINDOW-CLOSE OF C-Win
    18056   DO:
    18057     IF v-cd-mode = "0" then APPLY "CLOSE":U TO THIS-PROCEDURE.
    18058     RETURN NO-APPLY.
    18059   END.
    18060   ON WINDOW-RESIZED OF C-Win
    18061   DO:
    18062      define variable v-delta-x    as decimal      no-undo.
    18063      define variable v-delta-y    as decimal      no-undo.
    18064      define variable v-prp-x    as decimal      no-undo.
    18065      define variable v-prp-y    as decimal      no-undo.
    18066      define variable ii    as integer      no-undo.
    18067      define variable v-hcol    as handle      no-undo.
    18068      if C-Win :WIDTH-CHARS < 77.50
    18069      then do:
    18070         assign
    18071         C-Win :WIDTH-CHARS = 77.50
    18072         .
    18073      end.
    18074      if C-Win :HEIGHT-CHARS < 19.17
    18075      then do:
    18076         assign
    18077         C-Win :HEIGHT-CHARS = 19.17
    18078         .
    18079      end.
    18080      assign
    18081         v-delta-x = (frame DEFAULT-FRAME :WIDTH-PIXELS  - C-Win :WIDTH-PIXELS )
    18082         v-delta-y = (frame DEFAULT-FRAME :HEIGHT-PIXELS - C-Win :HEIGHT-PIXELS)
    18083         v-prp-x = (C-Win :WIDTH-PIXELS / frame DEFAULT-FRAME :WIDTH-PIXELS )
    18084         v-prp-y = (C-Win :HEIGHT-PIXELS / frame DEFAULT-FRAME :HEIGHT-PIXELS ) .
    18085      if v-prp-x >= 1 then assign
    18086         frame DEFAULT-FRAME :WIDTH-PIXELS          = C-Win :WIDTH-PIXELS
    18087         frame DEFAULT-FRAME :virtual-width-PIXELS  = C-Win :WIDTH-PIXELS.
    18088      if v-prp-y >= 1 then assign
    18089              frame DEFAULT-FRAME :HEIGHT-PIXELS          = C-Win :HEIGHT-PIXELS
    18090              frame DEFAULT-FRAME :virtual-HEIGHT-PIXELS  = C-Win :HEIGHT-PIXELS
    18091      .
    18092      define variable v-widget   as handle       no-undo.
    18093      assign
    18094         v-widget = FRAME DEFAULT-FRAME:FIRST-CHILD
    18095         v-widget = v-widget:FIRST-CHILD
    18096      .
    18097      DO WHILE  VALID-HANDLE(v-widget)
    18098      :
    18099         CASE v-widget:TYPE:
    18100         OTHERWISE do:
    18101                 assign
    18102                  v-widget :WIDTH-PIXELS  = v-widget :WIDTH-PIXELS  * v-prp-x
    18103                  v-widget :HEIGHT-PIXELS = v-widget :HEIGHT-PIXELS * v-prp-y
    18104                  v-widget :x  = v-widget :x  * v-prp-x
    18105                  v-widget :y = v-widget :y * v-prp-y
    18106               .
    18107         end.
    18108         END CASE.
    18109         assign
    18110            v-widget = v-widget:NEXT-SIBLING
    18111         .
    18112      END.
    18113      if v-prp-x < 1 then assign
    18114         frame DEFAULT-FRAME:virtual-width-PIXELS    = C-Win :WIDTH-PIXELS
    18115         frame DEFAULT-FRAME :WIDTH-PIXELS           = C-Win :WIDTH-PIXELS
    18116          .
    18117      if v-prp-y < 1 then assign
    18118             frame DEFAULT-FRAME :virtual-HEIGHT-PIXELS  = C-Win :HEIGHT-PIXELS
    18119             frame DEFAULT-FRAME :HEIGHT-PIXELS          = C-Win :HEIGHT-PIXELS
    18120                .
    18121   if   C-Win :WIDTH-CHARS >= 130
    18122      and   C-Win :HEIGHT-CHARS >= 28
    18123   then do:
    18124   FRAME DEFAULT-FRAME:font = 26. br-line:font =     41. v-balance:font =   32. v-src-label:font = 38. v-src-input:font = 29. v-mode-name:font  = 38. v-font-ed-msgs_big   = 23. v-font-ed-msgs_small = 20. v-font-br-line       = 41. v-font-br-line_bold  = 35. v-label-balance:font = 38. br-line:ROW-HEIGHT-PIXELS = 20.
    18125   end.
    18126   else if   C-Win :WIDTH-CHARS >= 107
    18127      and   C-Win :HEIGHT-CHARS >= 20
    18128   then do:
    18129   FRAME DEFAULT-FRAME:font = 25. br-line:font =     40. v-balance:font =   31. v-src-label:font = 37. v-src-input:font = 28. v-mode-name:font  = 37. v-font-ed-msgs_big   = 22. v-font-ed-msgs_small = 19. v-font-br-line       = 40. v-font-br-line_bold  = 34. v-label-balance:font = 37. br-line:ROW-HEIGHT-PIXELS = 20.
    18130   end.
    18131   else do:
    18132    FRAME DEFAULT-FRAME:font = 24. br-line:font =     39. v-balance:font =   30. v-src-label:font = 36. v-src-input:font = 27. v-mode-name:font  = 36. v-font-ed-msgs_big   = 21. v-font-ed-msgs_small = 18. v-font-br-line       = 39. v-font-br-line_bold  = 33. v-label-balance:font = 36. br-line:ROW-HEIGHT-PIXELS = 14.
    18133   end.
    18134   run p_ed-msgs(input v-ed-message:screen-value, input ?).
    18135   br-line:refresh() no-error.
    18136      def var v-hb as handle no-undo.
    18137      def var v-colwdt as dec no-undo.
    18138      do ii = 1 to br-line:num-columns:
    18139       v-hb = br-line:GET-BROWSE-COLUMN(ii).
    18140       v-hb:WIDTH-PIXELS = v-hb:WIDTH-PIXELS * v-prp-x.
    18141       v-hb:COLUMN-FONT = 24.
    18142      end.
    18143   END.
