     3216   procedure chk-sale-open :
     3217   define input-output  parameter p-cd-mode     as character          no-undo.
     3218   define input-output  parameter p-cd-submode  as character          no-undo.
     3219   define output        parameter p-message     as character      no-undo .
     3220   define output        parameter p-ok          as logical          no-undo.
     3221   do
     3222   on error undo, return error
     3223   :
     3224      run clear-tt-chk in this-procedure.
     3225      run chk-open   ( input integer('1':U)
     3226                     , INPUt-OUTPUT p-cd-mode
     3227                     , INPUt-output p-cd-submode
     3228                     , output p-message
     3229                     , output p-ok
     3230                     ) .
     3231      if p-ok
     3232      then do:
     3233         assign
     3234            p-message    = "Чек продажи открыт"
     3235            p-cd-mode    = "1"
     3236            p-cd-submode = "0"
     3237         .
     3238      end.
     3239   end.
     3240   end procedure.
     3241   procedure chk-open :
     3242   define input         parameter p-chk-type    as INTEGER        no-undo.
     3243   define input-output  parameter p-cd-mode     as character          no-undo.
     3244   define input-output  parameter p-cd-submode  as character          no-undo.
     3245   define output        parameter p-message     as character      no-undo .
     3246   define output        parameter p-ok          as logical          no-undo.
     3247   define variable v-doc-code      as character no-undo .
     3248   do
     3249   on error undo, return error
     3250   :
     3251      case p-cd-mode:
     3252         WHEN "0" OR
     3253         WHEN "6"
     3254         then do:
     3255   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3256   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_create-chk-doc in g#libthpos
     3257     (input  v-cntxt-db-num
     3258     ,input  v-cntxt-obj-code
     3259     ,input  'IBS-TH':U
     3260     ,input  p-cash-num
     3261     ,input  p-chk-type
     3262     ,input  v-cashier
     3263     ,input  v-cashier-psn-code
     3264     ,output v-doc-code
     3265     ,output v-exch-rate
     3266     ,output v-exch-scales
     3267     ,output v-cash-rate
     3268     ,output v-cash-scales
     3269     ) no-error .
     3270            if error-status:error
     3271            then do:
     3272               assign
     3273                  p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
     3274                  p-ok = FALSE
     3275               .
     3276               return.
     3277            end.
     3278            CREATE tt-head-check.
     3279            assign
     3280               tt-head-check.doc-code    = v-doc-code
     3281               tt-head-check.exch-rate   = v-exch-rate
     3282               tt-head-check.exch-scales = v-exch-scales
     3283               tt-head-check.cash-rate   = if v-r-b = 'base':U then v-cash-rate    else 1
     3284               tt-head-check.cash-scales = if v-r-b = 'base':U then v-cash-scales  else 1
     3285               tt-head-check.chk-type    = p-chk-type
     3286               p-cd-submode = "0"
     3287               p-ok = TRUE
     3288            .
     3289            case STRING(p-chk-type):
     3290            WHEN '1':U then do:
     3291               assign
     3292                  p-cd-mode    = "1"
     3293               .
     3294            end.
     3295            WHEN '6':U then do:
     3296               assign
     3297                  p-cd-mode    = "2"
     3298               .
     3299            end.
     3300            WHEN '11':U then do:
     3301               assign
     3302                  p-cd-mode    = "7"
     3303               .
     3304            end.
     3305            OTHERWISE DO:
     3306            end.
     3307            end case.
     3308         end.
     3309         WHEN "8"
     3310         then do:
     3311   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
