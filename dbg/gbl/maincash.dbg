     6207   define output parameter p-summ-for-pay as decimal          no-undo.
     6208   define output parameter p-disc-pay     as decimal          no-undo.
     6209   define output parameter p-message      as character      no-undo .
     6210   define output parameter p-ok           as logical          no-undo.
     6211   do
     6212   on error undo, return error
     6213   :
     6214      run set-all-summ  ( output p-message
     6215                        , output p-ok
     6216                        ) .
     6217      if p-ok
     6218      then do:
     6219         assign
     6220            p-summ-brutto  = ABS( v-summ-brutto-rub  )
     6221            p-summ-netto   = ABS( v-summ-netto-rub   )
     6222            p-summ-discont = ABS( v-summ-discont-rub - (ABS(v-summ-brutto-rub) - ABS(v-summ-netto-rub)))
     6223            p-sum-pay      = ABS( v-summ-pay-rub     )
     6224            p-sum-fr       = v-summ-fr
     6225            p-summ-for-pay = v-sum-for-pay
     6226            p-disc-pay     = (ABS(v-summ-brutto-rub) - ABS(v-summ-netto-rub))
     6227         .
     6228      end.
     6229   end.
     6230   end procedure.
     6231   procedure 1998 :
     6232   define input-output  parameter p-cd-mode     as character          no-undo.
     6233   define input-output  parameter p-cd-submode  as character          no-undo.
     6234   define output        parameter p-message     as character      no-undo .
     6235   define output        parameter p-ok          as logical          no-undo.
     6236   define buffer buf_rule-call-param   for ub.rule-call-param .
     6237   define variable v-card    as logical      no-undo.
     6238   do
     6239   on error undo, return error
     6240   :
     6241      case p-cd-submode:
     6242         WHEN "0" OR
     6243         WHEN "3"
     6244         then do:
     6245            if p-cd-mode = "0"
     6246            then do:
     6247               run chk-sale-open ( INPUt-OUTPUT p-cd-mode
     6248                                 , INPUt-output p-cd-submode
     6249                                 , output p-message
     6250                                 , output p-ok
     6251                                 ) .
     6252            end.
     6253            for each  buf_rule-call-param
     6254                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
     6255                  no-lock
     6256               :
     6257               case buf_rule-call-param.param-name:
     6258                  WHEN "p-d-card"
     6259                  then do:
     6260                     if  buf_rule-call-param.param-value-character <> "":U
     6261                     AND buf_rule-call-param.param-value-character <> ?
     6262                     then
     6263                     assign
     6264                        v-src = buf_rule-call-param.param-value-character
     6265                        v-card = TRUE
     6266                     .
     6267                  end.
     6268                  OTHERWISE DO:
     6269                  end.
     6270               end case.
     6271            end.
     6272            if v-card
     6273            then do:
     6274               run input-card ( INPUt-OUTPUT p-cd-mode
     6275                              , INPUt-output p-cd-submode
     6276                              , output p-message
     6277                              , output p-ok
     6278                              ) .
     6279            end.
     6280            else do:
     6281               if p-cd-submode = "0"
     6282               then do:
     6283                  assign
     6284                     p-message    = "Регистрация дисконтной карты"
     6285                     p-cd-submode = "3"
     6286                     p-ok         = TRUE
     6287                  .
     6288               end.
     6289               else do:
     6290                  assign
     6291                     p-message = "Не задан номер карты"
     6292                  .
     6293               end.
     6294               return.
     6295            end.
     6296         end.
     6297         OTHERWISE DO:
     6298         end.
     6299      end case.
     6300   end.
     6301   end procedure.
     6302   procedure cr-down :
     6303   define output        parameter p-message     as character      no-undo .
     6304   define output        parameter p-ok          as logical          no-undo.
     6305   do
     6306   on error undo, return error
     6307   :
     6308   end.
     6309   end procedure.
     6310   procedure cr-up :
     6311   define output        parameter p-message     as character      no-undo .
     6312   define output        parameter p-ok          as logical          no-undo.
     6313   do
     6314   on error undo, return error
     6315   :
     6316   end.
     6317   end procedure.
     6318   procedure set-src :
     6319   define input  parameter p-src as character        no-undo.
     6320   define output parameter p-message     as character      no-undo .
     6321   define output parameter p-ok          as logical          no-undo.
     6322   do
     6323   on error undo, return error
     6324   :
     6325      assign
     6326         v-src = p-src
     6327         p-ok  = TRUE
     6328      .
     6329   end.
     6330   end procedure.
     6331   procedure input-qnty :
     6332   define input-output  parameter p-cd-mode     as character          no-undo.
     6333   define input-output  parameter p-cd-submode  as character          no-undo.
     6334   define output        parameter p-message     as character      no-undo .
     6335   define output        parameter p-ok          as logical          no-undo.
     6336   do
     6337   on error undo, return error
     6338   :
     6339      if p-cd-mode = "1"
     6340      OR p-cd-mode = "2"
     6341      then do:
     6342         assign
     6343            v-src-qnty = DECIMAL( v-src )
     6344         no-error.
     6345         if error-status:error
     6346         then do:
     6347            assign
     6348               p-message = substitute( "Вы ввели не число: &1 Введите количество правильно.", v-src )
     6349               p-ok = FALSE
     6350            .
     6351            return.
     6352         end.
     6353         assign
     6354            p-cd-submode = "0"
     6355            p-ok = TRUE
     6356         .
     6357      end.
     6358   end.
     6359   end procedure.
