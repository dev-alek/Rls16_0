    11264   define variable v-2-frpay-code as integer no-undo .
    11265   define variable v-src-discnt-local    as decimal      no-undo.
    11266   define variable v-src-discnt-local-rub    as decimal      no-undo.
    11267   define variable v-for-discnt-local-doc    as decimal no-undo .
    11268   define variable v-for-discnt-local-rubl   as decimal no-undo .
    11269   define variable v-for-discnt-local-r-b    as decimal no-undo .
    11270   define buffer buf_tt-line     for tt-line .
    11271   define buffer buf_tt-head-check     for tt-head-check .
    11272   do
    11273   on error undo, return error
    11274   :
    11275      if v-summ-netto-rub < v-summ-pay-rub
    11276      then do:
    11277         find buf_tt-head-check.
    11278         find last buf_tt-line where buf_tt-line.type = 1 no-lock.
    11279         if not available buf_tt-line
    11280         then do:
    11281            assign
    11282               p-message = "В чеке нет оплат"
    11283               p-ok      = FALSE
    11284            .
    11285            return.
    11286         end.
    11287         if p-rest-summ = ?
    11288         then do:
    11289            assign
    11290               v-pline-num = buf_tt-line.num + 1
    11291               v-mode      = 'ДОБАВЛЕНИЕ':U
    11292               v-pass-pay  = 0
    11293               v-pay-card  = ""
    11294               v-tot-base  = ?
    11295               v-tot-sum   = if (buf_tt-head-check.chk-type = integer('6':U)) then - (v-summ-netto-rub - v-summ-pay-rub) else v-summ-netto-rub - v-summ-pay-rub
    11296               v-tot-rubl  = if (buf_tt-head-check.chk-type = integer('6':U)) then - (v-summ-netto-rub - v-summ-pay-rub) else v-summ-netto-rub - v-summ-pay-rub
    11297               v-tot-base  = if (buf_tt-head-check.chk-type = integer('6':U)) then - (v-summ-netto - v-summ-pay) else v-summ-netto - v-summ-pay
    11298               v-pay-type  = ?
    11299            .
    11300         end.
    11301         else do:
    11302            assign
    11303               v-pline-num = buf_tt-line.num + 1
    11304               v-mode      = 'ДОБАВЛЕНИЕ':U
    11305               v-pass-pay  = 0
    11306               v-pay-card  = ""
    11307               v-tot-base  = ?
    11308               v-tot-sum   = if (buf_tt-head-check.chk-type = integer('6':U)) then p-rest-summ else - p-rest-summ
    11309               v-tot-rubl  = if (buf_tt-head-check.chk-type = integer('6':U)) then p-rest-summ else - p-rest-summ
    11310               v-tot-base  = if (buf_tt-head-check.chk-type = integer('6':U)) then p-rest-summ else - p-rest-summ
    11311               v-pay-type  = ?
    11312            .
    11313         end.
