    16797   PROCEDURE str-fix-width :
    16798   define input  parameter p-left-str  as character no-undo .
    16799   define input  parameter p-right-str as character no-undo .
    16800   define input  parameter p-width     as integer   no-undo .
    16801   define input  parameter p-cut       as logical   no-undo.
    16802   define output parameter p-fix-str   as character no-undo .
    16803   define output parameter p-message   as character no-undo .
    16804   define output parameter p-ok        as logical   no-undo .
    16805   define variable v-left-width    as integer       no-undo.
    16806   define variable v-right-width    as integer      no-undo.
    16807   do
    16808   on error undo, return error
    16809   :
    16810      assign
    16811         v-left-width  = LENGTH( p-left-str )
    16812         v-right-width = LENGTH( p-right-str )
    16813      .
    16814      if v-right-width > p-width
    16815      then do:
    16816         return error "правая часть больше ширины строки".
    16817      end.
    16818      if (v-right-width + v-left-width) > p-width + 1
    16819      then do:
    16820         if not p-cut
    16821         then do:
    16822            return error "суммарная длина больше ширины строки".
    16823         end.
    16824         assign
    16825            p-left-str = SUBSTRING(p-left-str, 1, (p-width - v-right-width - 1) ) + " "
    16826         .
    16827      end.
    16828      else do:
    16829         assign
    16830            p-left-str = p-left-str + FILL( " ", (p-width - v-right-width - v-left-width) )
    16831         .
    16832      end.
    16833      assign
    16834         p-fix-str = p-left-str + p-right-str
    16835         p-ok      = true
    16836      .
    16837   end.
    16838   end PROCEDURE.
    16839   PROCEDURE print-head-chk :
    16840   define output parameter p-message   as character no-undo .
    16841   define output parameter p-ok        as logical   no-undo .
    16842   define variable  v-count     as integer   no-undo .
    16843   define variable v-line    as character      no-undo.
    16844   do
    16845   on error undo, return error
    16846   :
    16847      DO v-count = 1 TO NUM-ENTRIES(v-cliche-lines, chr(4)):
    16848         assign
    16849            v-line = ENTRY(v-count, v-cliche-lines, chr(4))
    16850         .
    16851         if v-line = "":U
    16852         then do:
    16853            NEXT.
    16854         end.
    16855   define variable vss-include-info372 as character format "X(65)" no-undo
    16856   initial "@(#)$Workfile$ $Revision$".
    16857   do:
    16858     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-print-str in g#fr-lib
    16859       ( input       v-line
    16860       , output      p-message
    16861       , output      p-ok
    16862       ) no-error .
    16863   end.
    16864      end.
    16865      assign
    16866         p-ok      = true
    16867      .
    16868   end.
    16869   end PROCEDURE.
    16870   PROCEDURE 1991 :
    16871   define input-output  parameter p-cd-mode     as character no-undo .
    16872   define input-output  parameter p-cd-submode  as character no-undo .
    16873   define output  parameter p-message   as character no-undo .
    16874   define output  parameter p-ok        as logical   no-undo .
    16875   define variable v-rid-list    as character    no-undo.
    16876   define variable v-md    as character    no-undo.
    16877   define variable v-msg    as character    no-undo.
    16878   define buffer buf_wi-mode     for ub.wi-mode .
    16879   define buffer buf_rule-by-set for ub.rule-by-set .
    16880   do
    16881   on error undo, return error
    16882   :
    16883      if p-cd-mode = "1"
    16884      OR p-cd-mode = "2"
    16885      then do:
    16886         assign
    16887            v-md = substitute("&1.&2", p-cd-mode, p-cd-submode)
    16888         .
    16889      end.
    16890      else do:
    16891         assign
    16892            v-md = p-cd-mode
    16893         .
    16894      end.
    16895      find first  buf_wi-mode
    16896          where buf_wi-mode.mode-type  = 'cd-IBS-TH':U
    16897            AND buf_wi-mode.mode-id    = v-md
    16898          NO-LOCK
    16899          no-error
    16900          .
    16901      if not available buf_wi-mode
    16902      then do:
    16903         assign
    16904            p-message    = substitute( "Недоступен список функций для режима &1", v-md )
    16905            p-ok         = true
    16906         .
    16907         return .
    16908      end.
    16909      run rul/rule-by-set-s.w ( input parparentproc
    16910                              , input "b-sel":U
    16911                              , input "wi-mode"
    16912                              , input buf_wi-mode.codex_id
    16913                              , input buf_wi-mode.ruleset_id
    16914                              , input 0
    16915                              , input-output v-rid-list
    16916                              ) .
    16917      if v-rid-list = "":U
    16918      OR v-rid-list = ?
    16919      then do:
    16920         assign
    16921            p-message = "Отказ от выбора функции"
    16922            p-ok      = TRUE
    16923         .
    16924         return.
    16925      end.
    16926      find first buf_rule-by-set
    16927         where RECID(buf_rule-by-set) = INTEGER(ENTRY(1, v-rid-list))
    16928         no-lock
    16929         no-error
    16930         .
    16931      if not available buf_rule-by-set
    16932      then do:
    16933         assign
    16934            p-message = "Не найдена выбранная функция"
    16935            p-ok      = TRUE
    16936         .
    16937         return.
    16938      end.
    16939      run value( substitute("&1", string(buf_rule-by-set.rule_id, "9999"))) in this-procedure
    16940               ( input-output p-cd-mode
    16941               , input-output p-cd-submode
    16942               , output p-message
    16943               , output p-ok
    16944               ) no-error.
    16945      if error-status:error
    16946      then do:
    16947         assign
    16948            p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
    16949            p-ok = FALSE
    16950         .
    16951         return.
    16952      end.
    16953      if not p-ok
    16954      then do:
    16955         return.
    16956      end.
    16957      if p-cd-mode <> "4"
    16958      then do:
    16959         assign
    16960            v-msg            = p-message
    16961            v-cd-mode-pre    = p-cd-mode
    16962            v-cd-submode-pre = p-cd-submode
    16963         .
    16964      end.
    16965      run cd-context ( INPUt-OUTPUT p-cd-mode
    16966                     , INPUt-output p-cd-submode
    16967                     , output       p-message
    16968                     , output       p-ok
    16969                     ) .
    16970      if not p-ok
    16971      then do:
    16972         message
    16973            SKIP return-VALUE
    16974            SKIP trim(error-status :get-message(1))
    16975            SKIP trim(error-status :get-message(2))
    16976            SKIP trim(error-status :get-message(3))
    16977            sKIP p-message
    16978         view-as alert-box information.
    16979         return.
    16980      end.
    16981      if p-cd-mode <> "4"
    16982      then do:
    16983         assign
    16984            p-message        = v-msg
    16985            v-cd-mode-pre    = p-cd-mode
    16986            v-cd-submode-pre = p-cd-submode
    16987         .
    16988      end.
    16989      return.
    16990   end.
