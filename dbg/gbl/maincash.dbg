    10387   procedure add-sale :
    10388   define input-output  parameter p-cd-mode     as character          no-undo.
    10389   define input-output  parameter p-cd-submode  as character          no-undo.
    10390   define output parameter p-message     as character      no-undo .
    10391   define output parameter p-ok          as logical          no-undo.
    10392   define variable v-local-src    as character    no-undo.
    10393   do
    10394   on error undo, return error
    10395   :
    10396      assign
    10397         v-local-src = v-src
    10398      .
    10399      run clear-tt-chk in this-procedure.
    10400      run chk-open   ( input integer('1':U)
    10401                     , INPUt-OUTPUT p-cd-mode
    10402                     , INPUt-output p-cd-submode
    10403                     , output p-message
    10404                     , output p-ok
    10405                     ) .
    10406      if not p-ok
    10407      then do:
    10408         return.
    10409      end.
    10410      assign
    10411         p-cd-mode    = "1"
    10412         p-cd-submode = "0"
    10413      .
    10414      assign
    10415         v-src = v-local-src
    10416      .
    10417      run add-gds-line  ( INPUt-OUTPUT p-cd-mode
    10418                        , INPUt-output p-cd-submode
    10419                        , output p-message
    10420                        , output p-ok
    10421                        ) .
    10422   end.
    10423   end procedure.
    10424   procedure del-gds-line :
    10425   define input-output  parameter p-cd-mode     as character          no-undo.
    10426   define input-output  parameter p-cd-submode  as character          no-undo.
    10427   define output parameter p-message     as character      no-undo .
    10428   define output parameter p-ok          as logical          no-undo.
    10429   define buffer buf_tt-line     for tt-line .
    10430   define buffer buf_tt-head-check     for tt-head-check .
