    16992   PROCEDURE 2000 :
    16993   define input-output  parameter p-cd-mode     as character no-undo .
    16994   define input-output  parameter p-cd-submode  as character no-undo .
    16995   define output  parameter p-message   as character no-undo .
    16996   define output  parameter p-ok        as logical   no-undo .
    16997   define variable v-rid-list    as character    no-undo.
    16998   define variable v-md    as character    no-undo.
    16999   define variable v-msg    as character    no-undo.
    17000   define variable  v-count     as integer   no-undo .
    17001   define variable v-cd-mode-local    as character    no-undo.
    17002   define variable v-fr-num    as integer    no-undo.
    17003   define buffer buf_chk-doc     for ub.chk-doc .
    17004   define buffer buf_chk-gds     for ub.chk-gds .
    17005   define buffer buf_tt-line     for tt-line .
    17006   define buffer buf_goods       for ub.goods  .
    17007   define buffer buf_bar-code    for ub.bar-code .
    17008   define buffer buf_chk-pay     for ub.chk-pay .
    17009   define buffer buf_cash-pay    for ub.cash-pay .
    17010   do
    17011   on error undo, return error
    17012   :
    17013      if p-cd-mode <> "0"
    17014      then do:
    17015         return.
    17016      end.
    17017      run str/chk-docs.w   ( input parparentproc
    17018                           , input "b-sel"
    17019                           , input 'IBS-TH':U
    17020                           , input ?
    17021                           , input v-cntxt-obj-type
    17022                           , input v-cntxt-obj-code
    17023                           , input '':U
    17024                           , input '':U
    17025                           , input p-cash-num
    17026                           , input ?
    17027                           , input ?
    17028                           , input integer('1':U)
    17029                           , output v-rid-list) no-error.
    17030      if v-rid-list = "":U
    17031      then do:
    17032         assign
    17033            p-message = "Отказ от выбора чека"
    17034            p-ok      = TRUE
    17035         .
    17036         return.
    17037      end.
    17038      assign
    17039         v-with-context = FALSE
    17040         v-count = 1
    17041      .
    17042      _proc-body:
    17043      DO
    17044      on error undo, return
    17045      :
    17046         assign
    17047            v-cd-mode-local = "1"
    17048         .
    17049         find first buf_chk-doc
    17050            where RECID(buf_chk-doc) = INTEGER(ENTRY(v-count, v-rid-list))
    17051            NO-lock
    17052            no-error
    17053            .
    17054         if  not available buf_chk-doc
    17055         then do:
    17056            UNDO _proc-body, LEAVE _proc-body .
    17057         end.
    17058         if  buf_chk-doc.chk-type <> integer('1':U)
    17059         AND buf_chk-doc.chk-type <> integer('6':U)
    17060         then do:
    17061            UNDO _proc-body, LEAVE _proc-body .
    17062         end.
    17063         CREATE tt-head-check.
    17064         assign
    17065            tt-head-check.doc-code    = buf_chk-doc.doc-code
    17066            v-fr-num                  = buf_chk-doc.chk-num
    17067            tt-head-check.chk-type    = buf_chk-doc.chk-type
    17068            tt-head-check.cash-rate   = if v-r-b = 'base':U then v-cash-rate    else 1
    17069            tt-head-check.cash-scales = if v-r-b = 'base':U then v-cash-scales  else 1
    17070         .
    17071         if  buf_chk-doc.src-d-card <> ?
    17072         AND buf_chk-doc.src-d-card <> ''
    17073         then do:
    17074            if v-with-context
    17075            then do:
    17076               assign
    17077                  v-src = buf_chk-doc.src-d-card
    17078               .
    17079               run input-card in this-procedure ( INPUt-OUTPUT p-cd-mode
    17080                                                , INPUt-output p-cd-submode
    17081                                                , output p-message
    17082                                                , output p-ok
    17083                                                ) .
    17084               if not p-ok then do:
    17085                  UNDO _proc-body, LEAVE _proc-body .
    17086               end.
    17087            end.
    17088            else do:
    17089               assign
    17090                  tt-head-check.d-card = buf_chk-doc.src-d-card
    17091               .
    17092            end.
    17093         end.
    17094         assign
    17095            v-pass-gds = 0
    17096         .
    17097         for each buf_chk-gds
    17098            where buf_chk-gds.doc-code = buf_chk-doc.doc-code
    17099            no-lock
    17100            ,
    17101            first buf_bar-code
    17102            where buf_bar-code.b-code = buf_chk-gds.b-code
    17103            No-LOCK
    17104            ,
    17105            first buf_goods
    17106            where buf_goods.gds-code = buf_bar-code.gds-code
    17107            No-LOCK
    17108            by buf_chk-gds.line-num
    17109         :
    17110            find first buf_tt-line
    17111                 where buf_tt-line.ord-chk-num  = buf_chk-gds.doc-code
    17112                   AND buf_tt-line.ord-line-num = buf_chk-gds.line-num
    17113                 no-lock no-error.
    17114            if available buf_tt-line then NEXT.
    17115            case buf_chk-doc.chk-type:
    17116               when integer('6':U) then do:
    17117               assign
    17118               v-write-off-code = 0
    17119               .
    17120               end.
    17121            end case.
    17122            assign
    17123               v-src-price          = buf_chk-gds.src-price
    17124               v-src-price-rub      = buf_chk-gds.src-price * tt-head-check.cash-scales
    17125               v-src-discnt         = buf_chk-gds.src-discnt
    17126               v-src-discnt-rub     = buf_chk-gds.src-discnt * tt-head-check.cash-scales
    17127               v-src-qnty           = buf_chk-gds.src-qnty
    17128               v-num                = 0
    17129               v-src                = buf_chk-gds.src-code
    17130               v-pump               = buf_chk-gds.pump
    17131               v-nozzle-code        = buf_chk-gds.nozzle-code
    17132               v-pl-code            = buf_chk-gds.pl-code
    17133               v-fbr-depart         = buf_chk-gds.depart-id
    17134               v-chk-name           = buf_goods.chk-name
    17135               v-gds-code           = buf_goods.gds-code
    17136               v-src-sum-netto      = buf_chk-gds.src-price * buf_chk-gds.src-qnty
    17137               v-src-sum-netto-rub  = buf_chk-gds.src-price * buf_chk-gds.src-qnty * tt-head-check.cash-scales
    17138               v-summ-netto-rub     = v-summ-netto-rub + buf_chk-gds.src-price * buf_chk-gds.src-qnty * tt-head-check.cash-scales
    17139            .
    17140            run add-gds-line in this-procedure  ( INPUt-OUTPUT p-cd-mode
    17141                                                , INPUt-output p-cd-submode
    17142                                                , output p-message
    17143                                                , output p-ok
    17144                                                ) .
    17145            if not p-ok then do:
    17146               UNDO _proc-body, LEAVE _proc-body .
    17147            end.
    17148         end.
    17149         define variable v-ii as integer no-undo .
    17150         define variable v-jj as integer no-undo .
    17151         define variable v-dop1 as character no-undo .
    17152         define variable v-fr-code as integer no-undo .
    17153         define variable v-cp-list as character no-undo .
    17154         for each  buf_chk-pay
    17155             where buf_chk-pay.doc-code = buf_chk-doc.doc-code
    17156               AND buf_chk-pay.tot-rubl > 0
    17157             no-lock
    17158             :
    17159            if buf_chk-pay.tot-rubl <= 0 then NEXT.
    17160            assign
    17161               v-src             = STRING(buf_chk-pay.tot-rubl)
    17162               v-pay-type        = buf_chk-pay.pay-code
    17163               v-curr-base-code  = buf_chk-pay.curr-code
    17164            .
    17165            if buf_chk-pay.pay-code = 1
    17166            then do:
    17167               assign
    17168                  v-frpay-code = 1
    17169               .
    17170            end.
    17171            else
    17172            _pay:
    17173            DO v-ii = 1 TO num-entries(v-cp-lst, chr(4)):
    17174               v-dop1 = ENTRY(v-ii, v-cp-lst, chr(4)).
    17175               assign
    17176                  v-fr-code = INTEGER(ENTRY(1, v-dop1, "="))
    17177                  v-cp-list = ENTRY(2, v-dop1, "=")
    17178               no-error.
    17179               if v-fr-code >= 2
    17180               AND v-fr-code <= 4 then do:
    17181                  DO v-jj = 1 TO num-entries(v-cp-list, ";"):
    17182                     if  buf_chk-pay.pay-code   = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
    17183                     AND buf_chk-pay.curr-code  = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
    17184                     then do:
    17185                        assign
    17186                           v-frpay-code = v-fr-code
    17187                        .
    17188                        LEAVE _pay.
    17189                     end.
    17190                  end.
    17191               end.
    17192            end.
    17193            run input-pay-sale in this-procedure ( INPUt-OUTPUT v-cd-mode-local
    17194                                                 , INPUt-output p-cd-submode
    17195                                                 , output p-message
    17196                                                 , output p-ok
    17197                                                 ) .
    17198            if not p-ok then do:
    17199               UNDO _proc-body, LEAVE _proc-body .
    17200            end.
    17201         end.
    17202         if v-with-context
    17203         then do:
    17204            run set-all-summ ( output p-message
    17205                           , output p-ok
    17206                           ) no-error .
    17207         end.
    17208         assign
    17209            v-summ-discont-rub = v-summ-netto-rub - buf_chk-doc.netto * tt-head-check.cash-scales
    17210            v-summ-netto-rub = buf_chk-doc.netto * tt-head-check.cash-scales
    17211         .
    17212         run non-fisk-doc in this-procedure ( INPUt-OUTPUT v-cd-mode-local
    17213                                            , input-output p-cd-submode
    17214                                            , input substitute('КОПИЯ ЧЕКА &1 (&2)', v-fr-num, tt-head-check.doc-code)
    17215                                            , output p-message
    17216                                            , output p-ok
    17217                                            ) .
    17218      end.
    17219      run clear-tt-chk in this-procedure.
    17220      return.
    17221   end.
    17222   end PROCEDURE.
