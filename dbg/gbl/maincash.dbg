    13024   procedure 1999 :
    13025   define input-output  parameter p-cd-mode     as character        no-undo .
    13026   define input-output  parameter p-cd-submode  as character      no-undo .
    13027   define output parameter p-message     as character      no-undo .
    13028   define output parameter p-ok          as logical          no-undo.
    13029   do
    13030   on error undo, return error
    13031   :
    13032      assign
    13033         p-cd-mode     = "8"
    13034         p-cd-submode  = "0"
    13035         p-ok          = TRUE
    13036      .
    13037      case p-cd-mode:
    13038         WHEN "0"
    13039          OR
    13040         WHEN "8"
    13041         then do:
    13042            define buffer buf_rule-call-param   for ub.rule-call-param .
    13043            define variable v-type     as logical      no-undo.
    13044            define variable v-chk-type as integer      no-undo.
    13045            for each  buf_rule-call-param
    13046                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    13047                  no-lock
    13048               :
    13049               case buf_rule-call-param.param-name:
    13050                  WHEN "p-chk-type"
    13051                  then do:
    13052                     if  buf_rule-call-param.param-value-integer <> 0
    13053                     AND buf_rule-call-param.param-value-integer <> ?
    13054                     then
    13055                     assign
    13056                        v-chk-type  = buf_rule-call-param.param-value-integer
    13057                        v-type      = TRUE
    13058                     .
    13059                  end.
    13060                  OTHERWISE DO:
    13061                  end.
    13062               end case.
    13063            end.
    13064            if v-type
    13065            then do:
    13066               if v-cash-drawer-plug
    13067               then do:
    13068                  run 1988 in this-procedure ( INPUt-OUTPUT p-cd-mode
    13069                                             , INPUt-output p-cd-submode
    13070                                             , output p-message
    13071                                             , output p-ok
    13072                                             ) .
    13073               end.
    13074               case v-chk-type:
    13075                  WHEN INTEGER('3':U)
    13076                  then do:
    13077                     run chk-fnd-open  ( INPUt-OUTPUT p-cd-mode
    13078                                       , INPUt-output p-cd-submode
    13079                                       , output p-message
    13080                                       , output p-ok
    13081                                       ) .
    13082                  end.
    13083                  WHEN INTEGER('2':U)
    13084                  then do:
    13085                     run chk-inc-open  ( INPUt-OUTPUT p-cd-mode
    13086                                       , INPUt-output p-cd-submode
    13087                                       , output p-message
    13088                                       , output p-ok
    13089                                       ) .
    13090                  end.
    13091                  OTHERWISE DO:
    13092                                     message
    13093                    substitute("К сожалению, в настоящий момент работа с чеком типа &1 НЕ РЕАЛИЗОВАНА", entry (lookup (string(v-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) + 1, ',' + 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр':U))
    13094                    view-as alert-box error .
    13095                  end.
    13096               end case.
    13097            end.
    13098            else do:
    13099               assign
    13100                  p-message = "Укажите тип чека МЦ"
    13101               .
    13102               return.
    13103            end.
    13104         end.
    13105         OTHERWISE DO:
    13106         end.
    13107      end case.
    13108   end.
    13109   end procedure.
    13110   procedure input-summ :
    13111   define input-output  parameter p-cd-mode     as character        no-undo .
    13112   define input-output  parameter p-cd-submode  as character      no-undo .
    13113   define output parameter p-message     as character      no-undo .
    13114   define output parameter p-ok          as logical          no-undo.
    13115   define buffer buf_tt-head-check     for tt-head-check .
    13116   define variable v-pline-num as integer no-undo .
    13117   define variable v-pass-pay as integer no-undo .
    13118   define variable v-pay-card as character no-undo .
    13119   define variable v-tot-sum as decimal no-undo .
    13120   define variable v-tot-rubl as decimal no-undo .
    13121   define variable v-tot-base as decimal no-undo .
    13122   define variable v-2-cdpay-code as integer no-undo .
    13123   define variable v-2-curr-code as integer no-undo .
    13124   define variable v-2-tot-base as decimal no-undo .
    13125   define variable v-2-tot-rubl as decimal no-undo .
    13126   define variable v-frpay-code as integer no-undo .
    13127   define variable v-2-frpay-code as integer no-undo .
    13128   define variable v-msg    as character    no-undo.
    13129   do
    13130   on error undo, return error
    13131   :
    13132      if DECIMAL(v-src) < 0
    13133      then do:
    13134         assign
    13135            p-message = "Сумма должна быть не меньше нуля"
    13136            p-ok      = FALSE
    13137         .
    13138         return.
    13139      end.
    13140      run input-pay-sale in this-procedure ( input-output p-cd-mode
    13141                                          , input-output p-cd-submode
    13142                                          , output p-message
    13143                                          , output p-ok
    13144                                          ) no-error.
    13145      if error-status:error
    13146      OR not p-ok
    13147      then do:
    13148         assign
    13149            p-message = substitute("pay &1 &2 &3", error-status:get-message(1), return-value, p-message)
    13150            p-ok = FALSE
    13151         .
    13152         return.
    13153      end.
    13154      assign
    13155         v-msg = p-message
    13156      .
    13157      run 1982 in this-procedure ( input-output p-cd-mode
    13158                                 , input-output p-cd-submode
    13159                                 , output p-message
    13160                                 , output p-ok
    13161                                 ) no-error.
    13162      if error-status:error
    13163      OR not p-ok
    13164      then do:
    13165         assign
    13166            p-message = substitute("cl &1 &2 &3", error-status:get-message(1), return-value, p-message)
    13167            p-ok = FALSE
    13168         .
    13169         return.
    13170      end.
    13171      assign
    13172         p-message     = v-msg
    13173         p-cd-mode     = "0"
    13174         p-cd-submode  = "0"
    13175         p-ok          = TRUE
    13176      .
    13177   end.
    13178   end procedure.
