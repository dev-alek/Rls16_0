    10451   define variable v-2-tot-rubl as decimal no-undo .
    10452   define variable v-next    as character    no-undo.
    10453   define variable v-frpay-code as integer no-undo .
    10454   define variable v-2-frpay-code as integer no-undo .
    10455   define variable v-src-discnt-local    as decimal      no-undo.
    10456   define variable v-src-discnt-local-rub    as decimal      no-undo.
    10457   define variable v-for-discnt-local-doc    as decimal no-undo .
    10458   define variable v-for-discnt-local-rubl   as decimal no-undo .
    10459   define variable v-for-discnt-local-r-b    as decimal no-undo .
    10460   do
    10461   on error undo, return error
    10462   :
    10463     if v-curr-num-0 <> 0
    10464     then do:
    10465       find buf_tt-head-check.
    10466       find first buf_tt-line
    10467           where buf_tt-line.num  = v-curr-num-0
    10468             AND buf_tt-line.type = v-curr-type-0
    10469           no-lock
    10470           .
    10471       if not available buf_tt-line
    10472       then do:
    10473         assign
