    12809       , input  v-src
    12810       , input  '':U
    12811       , input  buf_tt-head-check.doc-code
    12812       , input  '':U
    12813       , input  TODAY
    12814       , input  48
    12815       , input  TIME
    12816       , input  'U':U
    12817       , input  0
    12818       , input  v-cntxt-obj-type
    12819       , input  v-cntxt-obj-code
    12820       , input  '':U
    12821       , input  'IBS-TH':U
    12822       , input  0
    12823       , input  ?
    12824       , input  '':U
    12825       , input  0
    12826       , input  v-src
    12827       , input  0
    12828       , input  v-cntxt-userid
    12829       ) no-error .
    12830   end.
    12831      if v-found-str <> v-src
    12832      then do:
    12833         assign
    12834            v-found-num  = 0
    12835         .
    12836      end.
    12837      assign
    12838         v-found-str = v-src
    12839      .
    12840      find first buf_tt-line
    12841           where buf_tt-line.type = 0
    12842             AND buf_tt-line.src  = v-found-str
    12843             AND buf_tt-line.num  > v-found-num
    12844           NO-LOCK
    12845           no-error
    12846           .
    12847      if not available buf_tt-line
    12848      then do:
    12849         if v-found-num > 0
    12850         then do:
    12851            assign
