     6097   on error undo, return error
     6098   :
     6099      if CAN-find( first tt-open-check where tt-open-check.chk-type = INTEGER('1':U))
     6100      then do:
     6101         assign
     6102           p-message = "Чек возврата привязан к чеку продажи, ИЗМЕНИТЬ ЦЕНУ НЕВОЗМОЖНО"
     6103           p-ok      = false
