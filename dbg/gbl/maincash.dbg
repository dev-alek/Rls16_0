     7951            CREATE buf_tt-line.
     7952            assign
     7953               buf_tt-line.type         = 1
     7954               buf_tt-line.num          = v-pline-num
     7955               buf_tt-line.line-name    = substitute("    Оплата &1", buf_cash-pay.obj-name  )
     7956               buf_tt-line.line-code    = v-pay-type
     7957               buf_tt-line.curr-code    = v-curr-base-code
     7958               buf_tt-line.fr-pay-code  = v-frpay-code
     7959               buf_tt-line.summ-netto-rub = ABSOLUTE(v-tot-rubl)
     7960               buf_tt-line.summ-netto   = ABSOLUTE(v-tot-base)
     7961               buf_tt-line.pay-card     = v-pay-card
     7962               buf_tt-line.summ-discont = v-src-discnt
     7963               buf_tt-line.summ-discont-rub = v-src-discnt-rub
     7964               buf_tt-line.qnty         = v-tot-sum
     7965               buf_tt-line.src          = STRING(v-pay-type)
     7966               buf_tt-line.summ-brutto  = v-for-discnt-rubl
     7967               buf_tt-line.line-name-2  = v-src
     7968               buf_tt-line.slip         = v-slip
     7969               v-curr-base-code         = v-cd-base-code
     7970               p-ok                     = TRUE
     7971               v-pay-type               = ?
     7972               v-curr-num-0             = v-pline-num
     7973               v-curr-type-0            = 1
     7974            .
     7975            if v-with-context
     7976            then do:
     7977               run set-all-summ ( output p-message
     7978                              , output p-ok
     7979                              ) no-error.
     7980            end.
     7981            if TRUNCATE(v-summ-netto-rub, 2) <= TRUNCATE(v-summ-pay-rub, 2)
     7982            then do:
     7983               assign
     7984                  p-cd-submode       = "0"
     7985               .
     7986            end.
     7987            assign
     7988               v-disp-msg-1             = substitute  ( " Оплата &1"
     7989                                                      , buf_cash-pay.obj-name
     7990                                                      )
     7991               v-disp-msg-2             = substitute  ( "&1 &2"
     7992                                                      , if (p-cd-mode = "2") then - v-tot-rubl else v-tot-rubl
     7993                                                      , v-cd-base-name
     7994                                                      )
     7995            .
     7996            assign
     7997               p-message    = substitute  ( "Оплата &1 &2"
     7998                                          , buf_cash-pay.obj-name
     7999                                          , if (p-cd-mode = "2") then - v-tot-rubl else v-tot-rubl
     8000                                          )
     8001            .
     8002         end.
     8003         WHEN "2"
     8004         then do:
     8005            if v-with-context
     8006            then do:
     8007               assign
     8008                  v-frpay-code = ?
     8009               .
