    12722   procedure pay-select :
    12723   define output parameter p-message     as character      no-undo .
    12724   define output parameter p-ok          as logical          no-undo.
    12725   define variable v-ref-list    as character    no-undo.
    12726   define buffer buf_cash-pay    for ub.cash-pay .
    12727   do
    12728   on error undo, return error
    12729   :
    12730      run ref/cashpays.w   ( input parparentproc
    12731                           , input "b-sel":U
    12732                           , input 'все':U
    12733                           , input v-cntxt-host-code-obj
    12734                           , input v-cntxt-obj-type
    12735                           , input v-cntxt-obj-code
    12736                           , output v-ref-list
    12737                           ) .
    12738      if v-ref-list = ""
    12739      then do:
    12740         return.
    12741      end.
    12742      find first buf_cash-pay
    12743           where recid( buf_cash-pay ) = INTEGER(ENTRY(1, v-ref-list))
    12744           NO-LOCK
    12745           no-error
    12746           .
    12747      if available buf_cash-pay then do:
    12748         assign
    12749            v-pay-type        = buf_cash-pay.cdpay-code
    12750            v-curr-base-code  = buf_cash-pay.curr-code
    12751            p-message         = buf_cash-pay.obj-name
    12752            p-ok              = TRUE
    12753         .
    12754      end.
    12755   end.
    12756   end procedure.
    12757   procedure set-cd-base-code :
    12758   define input parameter p-base-code as integer          no-undo.
    12759   define output parameter p-message     as character      no-undo .
