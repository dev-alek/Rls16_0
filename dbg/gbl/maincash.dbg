     3375   define variable vss-include-info100 as character format "X(65)" no-undo
     3376   initial "@(#)$Workfile$ $Revision$".
     3377   do:
     3378     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-ctrl in g#fr-lib
     3379       ( input        v-cash-drawer-open
     3380       , output       p-message
     3381       , output       p-ok
     3382       , output       v-fr-mode
     3383       , output       v-fr-time
     3384       , output       v-fr-date
     3385       , output       v-fr-last-shift-date
     3386       , output       v-fr-last-shift-num
     3387       , output       v-fr-lic
     3388       , output       v-fr-shift-open
     3389       , output       v-fr-serial
     3390       ) no-error .
     3391   end.
     3392     if  not p-ok
     3393     AND v-fr-shift-open = 24
     3394     then do:
     3395       assign
     3396       p-message = "Истекли 24 часа открытой смены. Чек можно только отложить."
     3397       p-ok = FALSE
     3398       .
     3399       return.
     3400     end.
     3401     if  ABS( v-summ-brutto-rub  ) > v-summ-fr
     3402     AND p-cd-mode = "2"
