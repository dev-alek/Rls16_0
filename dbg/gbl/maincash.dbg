     6008            define buffer buf_rule-call-param   for ub.rule-call-param .
     6009            define buffer buf_cash-pay          for ub.cash-pay .
     6010            define variable v-pay    as logical      no-undo.
     6011            define variable v-sum    as logical      no-undo.
     6012            for each  buf_rule-call-param
     6013                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
     6014                  no-lock
     6015               :
     6016               case buf_rule-call-param.param-name:
     6017                  WHEN "p-cash-pay"
     6018                  then do:
     6019                     if NUM-ENTRIES ( buf_rule-call-param.param-value-character ) > 1
     6020                     then do:
     6021                        assign
     6022                           v-pay-type        = INTEGER( ENTRY( 1, buf_rule-call-param.param-value-character ) )
     6023                           v-curr-base-code  = INTEGER( ENTRY( 2, buf_rule-call-param.param-value-character ) )
     6024                           v-pay             = TRUE
     6025                        no-error
     6026                        .
     6027                        if error-status:error
     6028                        then do:
     6029                           assign
     6030                              p-message = substitute( "Неправильно настроен тип платежа для данной функции: &1", buf_rule-call-param.param-value-character)
     6031                           .
     6032                           return.
     6033                        end.
     6034                     end.
     6035                  end.
     6036                  WHEN "p-tot-sum"
     6037                  then do:
     6038                     if  buf_rule-call-param.param-value-decimal <> 0
     6039                     AND buf_rule-call-param.param-value-decimal <> ?
     6040                     then
     6041                     assign
     6042                        v-src = STRING(buf_rule-call-param.param-value-decimal)
     6043                        v-sum = if (buf_rule-call-param.param-value-decimal <> 0) then TRUE else FALSE
     6044                     .
     6045                  end.
     6046                  OTHERWISE DO:
     6047                  end.
     6048               end case.
     6049            end.
     6050            if v-pay
     6051            then do:
     6052               if v-sum
     6053               then do:
     6054                  run input-pay-sale  ( INPUt-OUTPUT p-cd-mode
     6055                                       , INPUt-output p-cd-submode
     6056                                       , output p-message
     6057                                       , output p-ok
     6058                                       ) .
     6059               end.
     6060               else do:
     6061                  find first buf_cash-pay
     6062                       where buf_cash-pay.cdpay-code = v-pay-type
     6063                         AND buf_cash-pay.curr-code  = v-curr-base-code
     6064                       NO-LOCK
     6065                       no-error
     6066                        .
     6067                  if not available buf_cash-pay
     6068                  then do:
     6069                     assign
     6070                        p-message = substitute( "Не найден тип платежа: &1", buf_rule-call-param.param-value-character)
     6071                     .
     6072                     return.
     6073                  end.
     6074                  assign
     6075                     p-message = buf_cash-pay.obj-name
     6076                     p-ok      = TRUE
     6077                  .
     6078                  RELEASE buf_cash-pay.
     6079               end.
     6080            end.
     6081            else do:
     6082               assign
     6083                  p-message = "Не задан тип платежа"
     6084               .
     6085               return.
     6086            end.
     6087         end.
     6088      end.
     6089   end.
     6090   end procedure.
     6091   procedure 2004 :
     6092   define input-output  parameter p-cd-mode     as character          no-undo.
     6093   define input-output  parameter p-cd-submode  as character          no-undo.
     6094   define output        parameter p-message     as character      no-undo .
     6095   define output        parameter p-ok          as logical          no-undo.
