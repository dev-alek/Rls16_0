    10484       then do:
    10485         assign
    10486         p-message   = "Отправленную на ФР строку удалять нельзя."
    10487         p-ok        = FALSE
    10488         .
    10489         return.
    10490       end.
    10491       case buf_tt-line.type:
    10492         WHEN 0 then do:
    10493   define variable vss-include-info228 as character format "X(65)" no-undo
