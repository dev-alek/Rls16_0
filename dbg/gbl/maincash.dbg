     9995                     p-message = "Запрещена коррекция строк оплаты. Используйте удаление."
     9996                  .
     9997               end.
     9998            end.
     9999            OTHERWISE DO:
    10000            end.
    10001         end case.
    10002      end.
    10003      assign
    10004         v-src            = ""
    10005         v-src-qnty       = 0.0
    10006         v-src-price      = 0.0
    10007         v-src-price-rub  = 0.0
    10008         v-num            = 0
    10009         p-cd-submode     = "0"
    10010         p-ok             = TRUE
    10011      .
    10012   end.
    10013   end procedure.
    10014   procedure 2010 :
    10015   define input-output  parameter p-cd-mode     as character          no-undo.
    10016   define input-output  parameter p-cd-submode  as character          no-undo.
    10017   define output parameter p-message     as character      no-undo .
    10018   define output parameter p-ok          as logical          no-undo.
    10019   define buffer buf_tt-line     for tt-line .
    10020   do
    10021   on error undo, return error
    10022   :
    10023      if not v-qnty-change
    10024      then do:
    10025         assign
    10026            p-message   = "Коррекция количества запрещена"
    10027            p-ok        = FALSE
    10028         .
    10029         return.
    10030      end.
    10031      if v-curr-num-0 <> 0
    10032      then do:
    10033         find first buf_tt-line
    10034            where buf_tt-line.num  = v-curr-num-0
    10035              and buf_tt-line.type = v-curr-type-0
    10036            no-lock
    10037            .
    10038         if not available buf_tt-line
    10039         then do:
    10040            assign
    10041               p-message   = "Нет строки чека для коррекции"
    10042               p-ok        = FALSE
    10043            .
    10044            return.
    10045         end.
    10046      end.
    10047      else do:
    10048         assign
    10049            p-message   = "Нет строки чека для коррекции"
    10050            p-ok        = FALSE
    10051         .
    10052         return.
    10053      end.
    10054      if buf_tt-line.type = 1
    10055      then do:
    10056         assign
    10057            p-message   = "Cтроку оплаты корректировать нельзя."
    10058            p-ok        = FALSE
    10059         .
    10060         return.
    10061      end.
    10062      define buffer buf_rule-call-param   for ub.rule-call-param .
    10063      define variable v-qnty    as logical      no-undo.
    10064      for each  buf_rule-call-param
    10065            where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    10066            no-lock
    10067         :
    10068         case buf_rule-call-param.param-name:
    10069            WHEN "p-gds-qnty"
    10070            then do:
    10071               if  buf_rule-call-param.param-value-decimal <> 0
    10072               AND buf_rule-call-param.param-value-decimal <> ?
    10073               then
    10074               assign
    10075                  v-src = STRING(buf_rule-call-param.param-value-decimal)
    10076                  v-qnty = if (buf_rule-call-param.param-value-decimal <> 0) then TRUE else FALSE
    10077               .
    10078            end.
    10079            OTHERWISE DO:
    10080            end.
    10081         end case.
    10082      end.
    10083      if v-qnty
    10084      then do:
    10085         run upd-line  ( INPUt-OUTPUT p-cd-mode
    10086                           , INPUt-output p-cd-submode
    10087                           , output p-message
    10088                           , output p-ok
    10089                           ) .
    10090      end.
    10091      else do:
    10092         if p-cd-mode = "1"
    10093         OR p-cd-mode = "2"
    10094         then do:
    10095            assign
    10096               p-cd-submode = "1"
    10097               p-ok         = TRUE
    10098            .
    10099         end.
    10100      end.
    10101   end.
    10102   end procedure.
