    11215   procedure set-curr-num :
    11216   define input parameter p-type       as integer        no-undo.
    11217   define input parameter p-num        as integer        no-undo.
    11218   define output parameter p-message   as character      no-undo .
    11219   define output parameter p-ok        as logical        no-undo.
    11220   do
    11221   on error undo, return error
    11222   :
    11223      assign
    11224         v-curr-num-0 = p-num
    11225         v-curr-type-0 = p-type
    11226         p-ok  = TRUE
    11227      .
    11228   end.
    11229   end procedure.
    11230   procedure get-curr-num :
    11231   define output parameter p-type as integer          no-undo.
    11232   define output parameter p-num as integer          no-undo.
    11233   define output parameter p-message     as character      no-undo .
    11234   define output parameter p-ok          as logical          no-undo.
    11235   do
    11236   on error undo, return error
    11237   :
    11238      assign
    11239         p-num  = v-curr-num-0
    11240         p-type = v-curr-type-0
    11241         p-ok   = TRUE
    11242      .
    11243   end.
    11244   end procedure.
    11245   procedure rest-back :
    11246   define input-output  parameter p-rest-summ   as decimal          no-undo.
    11247   define output parameter p-message     as character      no-undo .
    11248   define output parameter p-ok          as logical          no-undo.
    11249   define variable v-pline-num as integer no-undo .
