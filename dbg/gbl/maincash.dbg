     3350   procedure 1982 :
     3351   define input-output  parameter p-cd-mode     as character          no-undo.
     3352   define input-output  parameter p-cd-submode  as character          no-undo.
     3353   define output        parameter p-message     as character      no-undo .
     3354   define output        parameter p-ok          as logical          no-undo.
     3355   define buffer buf_tt-line     for tt-line .
     3356   define variable v-chk-fr-num     as character    no-undo .
     3357   define variable v-price-rub      as decimal      no-undo .
     3358   define variable v-disc-rub       as decimal      no-undo .
     3359   define variable v-disc-rub-total as decimal      no-undo .
     3360   define variable v-print-line     as character    no-undo .
     3361   define variable v-rest-summ      as decimal      no-undo .
     3362   define variable v-summ-1  as decimal      no-undo.
     3363   define variable v-summ-2  as decimal      no-undo.
     3364   define variable v-summ-3  as decimal      no-undo.
     3365   define variable v-summ-4  as decimal      no-undo.
     3366   do
     3367   on error undo, return error
     3368   :
     3369     define variable v-fr-mode            as integer      no-undo.
     3370     define variable v-fr-time            as integer      no-undo.
     3371     define variable v-fr-date            as date         no-undo.
     3372     define variable v-fr-last-shift-date as date         no-undo.
     3373     define variable v-fr-lic             as character    no-undo.
