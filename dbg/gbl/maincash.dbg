     9018       , input  vv-doc-code
     9019       , input  '':U
     9020       , input  TODAY
     9021       , input  9
     9022       , input  TIME
     9023       , input  'S':U
     9024       , input  0
     9025       , input  v-cntxt-obj-type
     9026       , input  v-cntxt-obj-code
     9027       , input  '':U
     9028       , input  'IBS-TH':U
     9029       , input  0
     9030       , input  ?
     9031       , input  '':U
     9032       , input  0
     9033       , input  '':U
     9034       , input  0
     9035       , input  v-cntxt-userid
     9036       ) no-error .
     9037   end.
     9038               if error-status:error
     9039               then do:
     9040                  message
     9041                     "Z"  9
     9042                     skip error-status:get-message(1)
     9043                     skip return-value
     9044                  view-as alert-box information.
     9045               end.
     9046         end.
     9047      end.
     9048   end.
     9049   end procedure.
     9050   procedure 1985 :
     9051   define input-output  parameter p-cd-mode     as character          no-undo.
     9052   define input-output  parameter p-cd-submode  as character          no-undo.
     9053   define output parameter p-message     as character      no-undo .
     9054   define output parameter p-ok          as logical          no-undo.
     9055   define buffer buf_chk-doc     for ub.chk-doc .
     9056   define buffer buf_chk-gds     for ub.chk-gds .
     9057   define buffer buf_tt-line     for tt-line .
     9058   define buffer buf_tt-head-check     for tt-head-check .
     9059   define variable v-doc-code    as character    no-undo.
     9060   define variable v-doc-code-list    as character    no-undo.
     9061   define variable v-chk-type    as integer      no-undo.
     9062   define variable v-b-code as integer no-undo .
     9063   define variable v-chk-name as character no-undo .
     9064   define variable v-second-name as character no-undo .
     9065   define variable v-setted as logical no-undo .
     9066   define variable v-gds-code as integer no-undo .
     9067   define variable v-src-sum as decimal no-undo .
     9068   define variable v-src-sum-netto as decimal no-undo .
     9069   define variable v-rid-list    as character    no-undo.
     9070   define variable v-count    as integer      no-undo.
     9071   define buffer buf_tt-open-check     for tt-open-check .
     9072   define variable v-chk-list-type    as logical      no-undo.
     9073   do
     9074   on error undo, return error
     9075   :
     9076      case p-cd-mode:
     9077         WHEN "1"
     9078         then do:
     9079            run str/chk-docs.w   ( input parparentproc
     9080                                 , input "b-sel,b-mark"
     9081                                 , input 'IBS-TH':U
     9082                                 , input ?
     9083                                 , input v-cntxt-obj-type
     9084                                 , input v-cntxt-obj-code
     9085                                 , input '':U
     9086                                 , input '':U
     9087                                 , input p-cash-num
     9088                                 , input ?
     9089                                 , input ?
     9090                                 , input integer('201':U)
     9091                                 , output v-rid-list) no-error.
     9092            assign
     9093               v-chk-type = integer('201':U)
     9094            .
     9095         end.
     9096         WHEN "2"
     9097         then do:
     9098            run str/chk-docs.w   ( input parparentproc
     9099                                 , input "b-sel,b-mark"
     9100                                 , input 'IBS-TH':U
     9101                                 , input ?
     9102                                 , input v-cntxt-obj-type
     9103                                 , input v-cntxt-obj-code
     9104                                 , input '':U
     9105                                 , input '':U
     9106                                 , input p-cash-num
     9107                                 , input ?
     9108                                 , input ?
     9109                                 , input integer('206':U)
     9110                                 , output v-rid-list) no-error.
     9111            assign
     9112               v-chk-type = integer('206':U)
     9113            .
     9114         end.
     9115         WHEN "0"
     9116         then do:
     9117            assign
     9118               v-chk-list-type = ?
     9119            .
     9120            message
     9121               "Открыть отложенный чек?"
     9122               SKIP "ДА  - открыть отложенную продажу"
     9123               skip "НЕТ - открыть отложенный возврат"
     9124               SKIP "ОТМЕНА - отказ от выбора"
     9125            view-as alert-box question
     9126            BUTTONS YES-NO-CANCEL
     9127            UPDATE v-chk-list-type
     9128            .
     9129            if v-chk-list-type = ?
     9130            then do:
     9131               assign
     9132                  p-message = "Отказ от выбора отложенного чека"
     9133                  p-ok = TRUE
     9134               .
     9135               return.
     9136            end.
     9137            if v-chk-list-type
     9138            then do:
     9139               run str/chk-docs.w   ( input parparentproc
     9140                                    , input "b-sel,b-mark"
     9141                                    , input 'IBS-TH':U
     9142                                    , input ?
     9143                                    , input v-cntxt-obj-type
     9144                                    , input v-cntxt-obj-code
     9145                                    , input '':U
     9146                                    , input '':U
     9147                                    , input p-cash-num
     9148                                    , input ?
     9149                                    , input ?
     9150                                    , input integer('201':U)
     9151                                    , output v-rid-list) no-error.
     9152               assign
     9153                  v-chk-type = integer('201':U)
     9154               .
     9155               end.
     9156            else do:
     9157               run str/chk-docs.w   ( input parparentproc
     9158                                    , input "b-sel,b-mark"
     9159                                    , input 'IBS-TH':U
     9160                                    , input ?
     9161                                    , input v-cntxt-obj-type
     9162                                    , input v-cntxt-obj-code
     9163                                    , input '':U
     9164                                    , input '':U
     9165                                    , input p-cash-num
     9166                                    , input ?
     9167                                    , input ?
     9168                                    , input integer('206':U)
     9169                                    , output v-rid-list) no-error.
     9170               assign
     9171                  v-chk-type = integer('206':U)
     9172               .
     9173            end.
     9174         end.
     9175         OTHERWISE DO:
     9176         end.
     9177      end case.
     9178      if v-rid-list = "":U
     9179      then do:
     9180         return.
     9181      end.
     9182      run set-input-time in this-procedure ( input 0, output p-message, output p-ok ).
     9183      if p-cd-mode = "0"
     9184      then do:
     9185         if v-chk-list-type
     9186         then do:
     9187            run chk-sale-open in this-procedure ( INPUt-OUTPUT p-cd-mode
     9188                                                , input-output p-cd-submode
     9189                                                , output p-message
     9190                                                , output p-ok
     9191                                                ) .
     9192         end.
     9193         else do:
     9194            run 1987 in this-procedure ( INPUt-OUTPUT p-cd-mode
     9195                                       , input-output p-cd-submode
     9196                                       , output p-message
     9197                                       , output p-ok
     9198                                       ) .
     9199         end.
     9200      end.
     9201      _proc-body:
     9202      DO v-count = 1 to NUM-ENTRIES(v-rid-list)
     9203      on error undo, NEXT
     9204      :
     9205         find first buf_chk-doc
     9206            where RECID(buf_chk-doc) = INTEGER(ENTRY(v-count, v-rid-list))
     9207            share-lock
     9208            no-error
     9209            NO-WAIT
     9210            .
     9211         if  not available buf_chk-doc
     9212         and not locked buf_chk-doc
     9213         then do:
     9214            UNDO _proc-body, NEXT _proc-body .
     9215         end.
     9216         if locked buf_chk-doc
     9217         then do:
     9218            UNDO _proc-body, NEXT _proc-body .
     9219         end.
     9220         if  buf_chk-doc.chk-type <> integer('201':U)
     9221         AND buf_chk-doc.chk-type <> integer('206':U)
     9222         then do:
     9223            UNDO _proc-body, NEXT _proc-body .
     9224         end.
     9225         if  buf_chk-doc.src-d-card <> ?
     9226         AND buf_chk-doc.src-d-card <> ''
     9227         then do:
     9228            assign
     9229               v-src = buf_chk-doc.src-d-card
     9230            .
     9231            run input-card in this-procedure ( INPUt-OUTPUT p-cd-mode
     9232                                             , INPUt-output p-cd-submode
     9233                                             , output p-message
     9234                                             , output p-ok
     9235                                             ) .
     9236            if not p-ok then do:
     9237               UNDO _proc-body, LEAVE _proc-body .
     9238            end.
     9239         end.
     9240         assign
     9241            v-pass-gds = 0
     9242            v-doc-code-list = v-doc-code-list + "," + buf_chk-doc.doc-code
     9243         .
     9244         for each buf_chk-gds
     9245            where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     9246            no-lock
     9247         :
     9248            find first buf_tt-line
     9249                 where buf_tt-line.ord-chk-num  = buf_chk-gds.doc-code
     9250                   AND buf_tt-line.ord-line-num = buf_chk-gds.line-num
     9251                 no-lock no-error.
     9252            if available buf_tt-line then NEXT.
     9253            case buf_chk-doc.chk-type:
     9254               when integer('6':U) then do:
     9255               assign
     9256               v-write-off-code = 0
     9257               .
     9258               end.
     9259            end case.
     9260            assign
     9261               v-src-price    = buf_chk-gds.src-price
     9262               v-src-qnty     = buf_chk-gds.src-qnty
     9263               v-num          = 0
     9264               v-src          = buf_chk-gds.src-code
     9265               v-pump         = buf_chk-gds.pump
     9266               v-nozzle-code  = buf_chk-gds.nozzle-code
     9267               v-pl-code      = buf_chk-gds.pl-code
     9268               v-fbr-depart   = buf_chk-gds.depart-id
     9269               v-ord-chk-num  = buf_chk-gds.doc-code
     9270               v-ord-line-num = buf_chk-gds.line-num
     9271            .
     9272            run add-gds-line in this-procedure  ( INPUt-OUTPUT p-cd-mode
     9273                                                , INPUt-output p-cd-submode
     9274                                                , output p-message
     9275                                                , output p-ok
     9276                                                ) .
     9277            if not p-ok then do:
     9278               UNDO _proc-body, LEAVE _proc-body .
     9279            end.
     9280            if buf_chk-gds.sales-man > 0
     9281            then do:
     9282               find first buf_tt-line
     9283                  where buf_tt-line.ord-chk-num  = buf_chk-gds.doc-code
     9284                     AND buf_tt-line.ord-line-num = buf_chk-gds.line-num
     9285                  no-lock
     9286                  .
     9287               assign
     9288                  v-src = STRING(buf_chk-gds.sales-man)
     9289               .
     9290               run input-saller in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
     9291            end.
     9292         end.
     9293         if not CAN-find (first buf_tt-open-check
     9294                          where buf_tt-open-check.doc-code = buf_chk-doc.doc-code
     9295                            AND buf_tt-open-check.chk-type = buf_chk-doc.chk-type
     9296                          )
     9297         then do:
     9298            create buf_tt-open-check.
     9299            assign
     9300               buf_tt-open-check.doc-code = buf_chk-doc.doc-code
     9301               buf_tt-open-check.chk-type = buf_chk-doc.chk-type
     9302            .
     9303         end.
     9304      end.
     9305      assign
     9306         v-doc-code-list = TRIM( v-doc-code-list , "," )
     9307      .
     9308   define variable vss-include-info212 as character format "X(65)" no-undo
     9309   initial "@(#)$Workfile$ $Revision$".
     9310   do:
     9311     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
     9312       ( input  1
     9313       , input  v-cntxt-db-num
     9314       , input  '':U
     9315       , input  p-cash-num
     9316       , input  substitute( '&1.&2' , p-cd-mode, p-cd-submode)
     9317       , input  v-chk-type
     9318       , input  '':U
     9319       , input  '*':U
     9320       , input  '':U
     9321       , input  v-doc-code-list
     9322       , input  '':U
     9323       , input  TODAY
     9324       , input  60
     9325       , input  TIME
     9326       , input  'U':U
     9327       , input  0
     9328       , input  v-cntxt-obj-type
     9329       , input  v-cntxt-obj-code
     9330       , input  '':U
     9331       , input  'IBS-TH':U
     9332       , input  0
     9333       , input  ?
     9334       , input  '':U
     9335       , input  0
     9336       , input  '':U
     9337       , input  v-rid-list
     9338       , input  v-cntxt-userid
     9339       ) no-error .
     9340   end.
     9341   end.
     9342   end procedure.
     9343   procedure 1994 :
     9344   define input-output  parameter p-cd-mode     as character          no-undo.
     9345   define input-output  parameter p-cd-submode  as character          no-undo.
     9346   define output parameter p-message     as character      no-undo .
     9347   define output parameter p-ok          as logical          no-undo.
     9348   do
     9349   on error undo, return error
     9350   :
     9351      assign
     9352         p-message = "Поиск товара по чеку"
     9353         p-cd-submode = "6"
     9354         p-ok              = TRUE
     9355      .
     9356   end.
     9357   end procedure.
     9358   procedure 1981 :
     9359   define input-output  parameter p-cd-mode     as character        no-undo .
     9360   define input-output  parameter p-cd-submode  as character      no-undo .
     9361   define output parameter p-message     as character      no-undo .
     9362   define output parameter p-ok          as logical          no-undo.
     9363   define buffer buf_tt-line     for tt-line .
     9364   do
     9365   on error undo, return error
     9366   :
     9367        if p-cd-submode = "0"
     9368         then do:
     9369         run adm/chk-pass.w   ( input parparentproc
     9370                                 , input v-cntxt-userid
     9371                                 , input v-cntxt-db-num
     9372                                 , input "actn_ibsthpos-discont"
     9373                                 , input FALSE
     9374                                 , output p-message
     9375                                 , output p-ok
     9376                                 ) .
     9377            if CAN-find (first buf_tt-line where buf_tt-line.type = 1 NO-LOCK)
     9378            then do:
     9379               assign
     9380                  p-message = "Скидка должна быть задана до принятия платежей"
     9381                  p-ok      = FALSE
     9382               .
     9383            end.
     9384            if not p-ok
     9385            then return.
     9386            assign
     9387               p-message   = "Cкидка на итог"
     9388               p-cd-submode = "5"
     9389               p-ok = TRUE
     9390            .
     9391         end.
     9392        if p-cd-submode =  "5"
     9393         then do:
     9394            define buffer buf_rule-call-param   for ub.rule-call-param .
     9395            define buffer buf_cash-pay          for ub.cash-pay .
     9396            define variable v-type    as logical      no-undo.
     9397            define variable v-value    as logical      no-undo.
     9398            for each  buf_rule-call-param
     9399                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
     9400                  no-lock
     9401               :
     9402               case buf_rule-call-param.param-name:
     9403                  WHEN "p-discnt-v-type"
     9404                  then do:
     9405                     if  buf_rule-call-param.param-value-integer <> 0
     9406                     AND buf_rule-call-param.param-value-integer <> ?
     9407                     then
     9408                     assign
     9409                        v-disc-type       = STRING(buf_rule-call-param.param-value-integer)
     9410                        v-type            = TRUE
     9411                     .
     9412                  end.
     9413                  WHEN "p-discnt-value"
     9414                  then do:
     9415                     if  buf_rule-call-param.param-value-decimal <> 0
     9416                     AND buf_rule-call-param.param-value-decimal <> ?
     9417                     then
     9418                     assign
     9419                        v-src = STRING(buf_rule-call-param.param-value-decimal)
     9420                        v-value = TRUE
     9421                     .
     9422                  end.
     9423                  OTHERWISE DO:
     9424                  end.
     9425               end case.
     9426            end.
     9427            if v-type
     9428            then do:
     9429               if v-value
     9430               then do:
     9431                  run input-discont ( INPUt-OUTPUT p-cd-mode
     9432                                    , INPUt-output p-cd-submode
     9433                                    , output p-message
     9434                                    , output p-ok
     9435                                    ) .
     9436               end.
     9437               else do:
     9438                  case v-disc-type:
     9439                     WHEN '10':U
     9440                     then do:
     9441                        assign
     9442                           p-message = "Абсолютная скидка на итог чека"
     9443                           p-ok      = TRUE
     9444                        .
     9445                     end.
     9446                     WHEN '1':U
     9447                     then do:
     9448                        assign
     9449                           p-message = "Процентная скидка на итог чека"
     9450                           p-ok      = TRUE
     9451                        .
     9452                     end.
     9453                     OTHERWISE DO:
     9454                        assign
     9455                           p-message = substitute("Неизвестный тип скидки - &1",v-disc-type)
     9456                        .
     9457                     end.
     9458                  end case.
     9459               end.
     9460            end.
     9461            else do:
     9462               assign
     9463                  p-message = "Укажите тип скидки на итог чека"
     9464               .
     9465               return.
     9466            end.
     9467         end.
     9468   end.
     9469   end procedure.
     9470   procedure upd-line :
     9471   define input-output  parameter p-cd-mode     as character          no-undo.
     9472   define input-output  parameter p-cd-submode  as character          no-undo.
     9473   define output        parameter p-message     as character      no-undo .
     9474   define output        parameter p-ok          as logical          no-undo.
     9475   define buffer buf_tt-line     for tt-line .
     9476   define buffer buf_tt-head-check     for tt-head-check .
     9477   define variable v-b-code          as integer no-undo .
     9478   define variable v-gds-code        as integer no-undo .
     9479   define variable v-chk-name        as character no-undo .
     9480   define variable v-second-name     as character no-undo .
     9481   define variable v-src-sum         as decimal no-undo .
     9482   define variable v-src-sum-netto   as decimal no-undo .
     9483   define variable v-next    as character    no-undo.
     9484   define variable v-qnty-old    as decimal      no-undo.
     9485   define variable v-src-discnt-local    as decimal      no-undo.
     9486   define variable v-src-discnt-local-rub    as decimal      no-undo.
     9487   define variable v-for-discnt-local-doc    as decimal no-undo .
     9488   define variable v-for-discnt-local-rubl   as decimal no-undo .
     9489   define variable v-for-discnt-local-r-b    as decimal no-undo .
     9490   do
     9491   on error undo, return error
     9492   :
     9493      if v-curr-num-0 <> 0
     9494      AND (p-cd-mode = "1"
     9495      OR   p-cd-mode = "2")
     9496      then do:
     9497         find buf_tt-head-check.
     9498         find first buf_tt-line
     9499            where buf_tt-line.num  = v-curr-num-0
     9500              and buf_tt-line.type = v-curr-type-0
     9501            no-lock
     9502            .
     9503   define variable vss-include-info213 as character format "X(65)" no-undo
     9504   initial "@(#)$Workfile$ $Revision$".
     9505   do:
     9506     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
     9507       ( input  0
     9508       , input  v-cntxt-db-num
     9509       , input  '':U
     9510       , input  p-cash-num
     9511       , input  substitute( '&1.&2' , p-cd-mode, p-cd-submode)
     9512       , input  buf_tt-head-check.chk-type
     9513       , input  '':U
     9514       , input  '*':U
     9515       , input  0
     9516       , input  buf_tt-head-check.doc-code
     9517       , input  v-src
     9518       , input  TODAY
     9519       , input  16
     9520       , input  TIME
     9521       , input  'U':U
     9522       , input  buf_tt-line.line-code
     9523       , input  v-cntxt-obj-type
     9524       , input  v-cntxt-obj-code
     9525       , input  '':U
     9526       , input  'IBS-TH':U
     9527       , input  0
     9528       , input  ?
     9529       , input  '':U
     9530       , input  0
     9531       , input  v-src
     9532       , input  0
     9533       , input  v-cntxt-userid
     9534       ) no-error .
     9535   end.
     9536               if error-status:error
     9537               then do:
     9538                  message
     9539                     "Z"  16
     9540                     skip error-status:get-message(1)
     9541                     skip return-value
     9542                  view-as alert-box information.
     9543               end.
     9544         assign
     9545            v-src-qnty = DECIMAL( v-src )
     9546         no-error.
     9547         if error-status:error
     9548         then do:
     9549            assign
     9550               p-message = substitute( "Вы ввели не число: &1 Введите количество правильно.", v-src )
     9551               p-ok = FALSE
     9552            .
     9553   define variable vss-include-info214 as character format "X(65)" no-undo
