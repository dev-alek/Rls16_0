    15085         OR not p-ok
    15086         then do:
    15087             if   p-message = "":U
    15088             then p-message = "Нет связи с фискальным регистратором".
    15089             return.
    15090         end.
    15091      end.
    15092      assign
    15093         p-ok = TRUE
    15094      no-error .
    15095      run prep-lay_get-layout in this-procedure ( input 'th-pos-screen':U
    15096                              , input v-screen-type
    15097                              , input v-screen-layout-id ) no-error.
    15098      if error-status:error then do:
    15099         message
    15100                            substitute("Нельзя работать с POS IBS TH:&1&2&1&3"
    15101                                  , chr(10)
    15102                                  , error-status:get-message(1)
    15103                                  , return-value )
    15104         view-as alert-box error.
    15105         return error .
    15106      end.
    15107      if  v-keyboard-layout-id <> "":U
    15108      AND v-keyboard-layout-id <> ?
    15109      then do:
    15110         run prep-lay_get-layout in this-procedure ( input 'th-pos-keyboard':U
    15111                                 , input v-keyboard-type
    15112                                 , input v-keyboard-layout-id ) no-error.
    15113         if error-status:error then do:
    15114            message
    15115                              substitute("Нельзя работать с POS IBS TH:&1&2&1&3"
    15116                                    , chr(10)
    15117                                    , error-status:get-message(1)
    15118                                    , return-value )
    15119            view-as alert-box error.
    15120            return error .
    15121         end.
    15122      end.
    15123   end.
    15124   end procedure.
    15125   procedure set-context-serial :
    15126   define input   parameter p-serial      as char          no-undo.
    15127   define input   parameter p-model       as integer          no-undo.
    15128   define output  parameter p-message     as character      no-undo .
    15129   define output  parameter p-ok          as logical          no-undo.
    15130   do
    15131   on error undo, return error
    15132   :
    15133      assign
    15134         v-context-serial = p-serial
    15135      .
    15136      case p-model:
    15137         WHEN 4
    15138         then do:
    15139            assign
    15140               v-fr-width        = 36
    15141               v-fr-width-bold   = 18
    15142            .
    15143         end.
    15144         WHEN 9
    15145         then do:
    15146            assign
    15147               v-fr-width = 48
    15148               v-fr-width-bold   = 24
    15149            .
    15150         end.
    15151         WHEN 8
    15152         then do:
    15153            assign
    15154               v-fr-width = 40
    15155               v-fr-width-bold   = 28
    15156            .
    15157         end.
    15158         OTHERWISE DO:
    15159            assign
    15160               v-fr-width = 20
    15161               v-fr-width-bold   = 26
    15162            .
    15163         end.
    15164      end case.
    15165   end.
    15166   end procedure.
