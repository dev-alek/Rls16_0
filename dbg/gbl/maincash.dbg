    12134   procedure 1978 :
    12135   define input-output  parameter p-cd-mode     as character        no-undo .
    12136   define input-output  parameter p-cd-submode  as character      no-undo .
    12137   define output parameter p-message     as character      no-undo .
    12138   define output parameter p-ok          as logical          no-undo.
    12139   define buffer buf_goods    for ub.goods .
    12140   define variable v-ref-list    as character    no-undo.
    12141   define variable v-count      as integer      no-undo.
    12142   define buffer buf_tt-head-check     for tt-head-check .
    12143   DEFINE buffer loc_bar-code for ub.bar-code.
    12144   DEFINE buffer root_bar-code for ub.bar-code.
    12145   define buffer loc_gds-prt for ub.gds-prt.
    12146   do
    12147   on error undo, return error
    12148   :
    12149   define buffer buf_rule-call-param   for ub.rule-call-param .
    12150   define variable v-gds    as logical      no-undo.
    12151   for each  buf_rule-call-param
    12152       where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    12153       no-lock
    12154   :
    12155     case buf_rule-call-param.param-name:
    12156       WHEN "p-gds-code"  then do:
    12157         if  buf_rule-call-param.param-value-integer <> 0
    12158         AND buf_rule-call-param.param-value-integer <> ?
    12159         then
    12160         assign
    12161         v-src = STRING(buf_rule-call-param.param-value-integer)
    12162         v-gds = TRUE
    12163         .
    12164       end.
    12165       OTHERWISE DO:
    12166       end.
    12167      end case.
    12168    end.
    12169   if v-src <> '' then
    12170   do:
    12171     assign
    12172      v-gds = yes .
    12173   end.
    12174   if v-gds then do:
    12175     if not CAN-find ( buf_tt-head-check )
    12176      then do:
    12177            run clear-tt-chk in this-procedure.
    12178            run chk-sale-open   ( INPUt-OUTPUT p-cd-mode
    12179                              , INPUt-output p-cd-submode
    12180                              , output p-message
    12181                              , output p-ok
    12182                              ) .
    12183            if not p-ok
    12184            then do:
    12185               return.
    12186            end.
    12187      end.
    12188      run set-input-time in this-procedure ( input -1, output p-message, output p-ok ).
    12189      run add-gds-line in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
    12190   end.
    12191   else do:
    12192     run ref/gds-ref.p
    12193         ( parParentProc
    12194         , "b-sel"
    12195         , 'все':U
    12196         , 'все':U
    12197         , 'факт':U
    12198         , ?
    12199         , ?
    12200         , ?
    12201         , ?
    12202         , v-cntxt-obj-type
    12203         , v-cntxt-obj-code
    12204         , ?
    12205         , output v-ref-list).
    12206     if v-ref-list = ""
    12207     then do:
    12208         return.
    12209     end.
    12210     if not CAN-find ( buf_tt-head-check )
    12211     then do:
    12212       run clear-tt-chk in this-procedure.
    12213       run chk-sale-open   ( INPUt-OUTPUT p-cd-mode
    12214                         , INPUt-output p-cd-submode
    12215                         , output p-message
    12216                         , output p-ok
    12217                         ) .
    12218       if not p-ok
    12219       then do:
    12220          return.
    12221        end.
    12222     end.
    12223     DO v-count = 1 TO NUM-ENTRIES(v-ref-list)
    12224     on error undo, next
    12225     :
    12226       find first buf_goods
    12227         where recid( buf_goods ) = INTEGER(ENTRY(v-count, v-ref-list))
    12228         NO-LOCK
    12229         no-error.
    12230       if available buf_goods then do:
    12231         if v-doc-prt then do:
    12232           find first ub.gds-prt where
    12233                   ub.gds-prt.upper-code = buf_goods.prt-root NO-LOCK .
    12234           if v-doc-prt and  gds-prt.node-name <> '_Пустая шкала':U then do:
    12235             define variable v-sel-node-code as integer   no-undo .
    12236             run str/prt-ref.w
    12237               (input parparentproc
    12238               ,input  buf_goods.gds-code
    12239               ,input  'выбор':U
    12240               ,input  v-cntxt-obj-type
    12241               ,input  v-cntxt-obj-code
    12242               ,input  ""
    12243               ,input  ""
    12244               ,output v-sel-node-code
    12245               ) .
    12246             if v-sel-node-code <> ? then do:
    12247               find first loc_gds-prt No-LOCK
    12248                 where loc_gds-prt.node-code = v-sel-node-code
    12249                 No-error.
    12250               if not avail loc_gds-prt then return error.
    12251                 if not loc_gds-prt.is-term then do:
    12252                   message
    12253                   "Признак" loc_gds-prt.f-name "нетерминальный" skip
    12254                   view-as alert-box Warning.
    12255                 end.
    12256               find first loc_bar-code where
    12257                     loc_bar-code.node-code = ub.gds-prt.node-code AND
    12258                     loc_bar-code.gds-code = buf_goods.gds-code AND
    12259                     loc_bar-code.in-code = "" AND
    12260                     loc_bar-code.part-code = ""  AND
    12261                     loc_bar-code.unit-cli = buf_goods.unit-base NO-LOCK .
    12262               find first root_bar-code No-LOCK where
    12263                       root_bar-code.gds-code = loc_bar-code.gds-code AND
    12264                       root_bar-code.unit-cli = loc_bar-code.unit-cli AND
    12265                       root_bar-code.in-code   = "" AND
    12266                       root_bar-code.part-code = "" AND
    12267                       root_bar-code.node-code  = loc_gds-prt.node-code no-error.
    12268               if AVAIl root_bar-code then do:
    12269                   v-src = string(root_bar-code.b-code).
    12270               end.
    12271               else do:
    12272                 message
    12273                 "Отсутствует бар-код для признака" loc_gds-prt.f-name
    12274                 view-as alert-box WARNING.
    12275                 return.
    12276               end.
    12277             end.
    12278             else return.
    12279           end.
    12280           else do:
    12281             assign
    12282             v-src = STRING(buf_goods.gds-code)
    12283             .
    12284           end.
    12285         end.
    12286         else do:
    12287           assign
    12288           v-src = STRING(buf_goods.gds-code)
    12289           .
    12290         end.
    12291         case p-cd-mode:
    12292           when "1"
    12293           or
    12294           when "2"
    12295           or
    12296           when "7"
    12297           then do:
    12298             case p-cd-submode:
    12299               when "6" then do:
    12300                 run input-find-str in this-procedure (
    12301                                                       input-output p-cd-mode
    12302                                                      ,input-output p-cd-submode
    12303                                                      ,output p-message
    12304                                                      ,output p-ok
    12305                                                      ).
    12306               end.
    12307               otherwise do:
    12308                 run set-input-time in this-procedure ( input -1, output p-message, output p-ok ).
    12309                 run add-gds-line in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
    12310               end.
    12311             end  case.
    12312           end.
    12313           otherwise do:
    12314           end.
    12315         end case.
    12316       end.
    12317     end.
    12318   end.
    12319   end.
    12320   end procedure.
    12321   procedure card-select :
    12322   define input-output  parameter p-cd-mode     as character        no-undo .
    12323   define input-output  parameter p-cd-submode  as character      no-undo .
    12324   define output parameter p-message     as character      no-undo .
    12325   define output parameter p-ok          as logical          no-undo.
    12326   define buffer buf_dis-card    for ub.dis-card .
    12327   define variable v-ref-list    as character    no-undo.
    12328   define variable v-count      as integer      no-undo.
    12329   do
    12330   on error undo, return error
    12331   :
    12332      run ref/discards.w
    12333         ( parParentProc
    12334         , "b-sel"
    12335         , 'все':U
    12336         , v-cntxt-host-code-obj
    12337         , v-cntxt-obj-type
    12338         , v-cntxt-obj-code
    12339         , ?
    12340         , ?
    12341         , output v-ref-list
    12342         ) .
    12343      if v-ref-list = ""
    12344      then do:
    12345         return.
    12346      end.
    12347      DO v-count = 1 TO NUM-ENTRIES(v-ref-list)
    12348      on error undo, next
    12349      :
    12350         find first buf_dis-card
    12351            where recid( buf_dis-card ) = INTEGER(ENTRY(v-count, v-ref-list))
    12352            NO-LOCK
    12353            no-error.
    12354         if available buf_dis-card then do:
    12355            assign
    12356               v-src = STRING(buf_dis-card.d-card)
    12357            .
    12358            run input-card in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
    12359         end.
    12360      end.
    12361   end.
    12362   end procedure.
    12363   procedure saller-select :
    12364   define input-output  parameter p-cd-mode     as character        no-undo .
    12365   define input-output  parameter p-cd-submode  as character      no-undo .
    12366   define output parameter p-message     as character      no-undo .
    12367   define output parameter p-ok          as logical          no-undo.
    12368   define buffer buf_staff    for ub.staff .
    12369   define variable v-ref-list    as character    no-undo.
    12370   define variable v-count      as integer      no-undo.
    12371   do
    12372   on error undo, return error
    12373   :
    12374      run ref/staffs.w
    12375         ( parParentProc
    12376         , "b-sel"
    12377         , 'S':U
    12378         , v-cntxt-db-num
    12379         , 0
    12380         , output v-ref-list
    12381         ) .
    12382      if v-ref-list = ""
    12383      then do:
    12384         return.
    12385      end.
    12386      DO v-count = 1 TO NUM-ENTRIES(v-ref-list)
    12387      on error undo, next
    12388      :
    12389         find first buf_staff
    12390            where recid( buf_staff ) = INTEGER(ENTRY(v-count, v-ref-list))
    12391            NO-LOCK
    12392            no-error.
    12393         if available buf_staff then do:
    12394            assign
    12395               v-src = STRING(buf_staff.staff-code)
    12396            .
    12397            run input-saller in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
    12398         end.
    12399      end.
    12400   end.
    12401   end procedure.
    12402   procedure 1986 :
    12403   define input-output  parameter p-cd-mode     as character        no-undo .
    12404   define input-output  parameter p-cd-submode  as character      no-undo .
    12405   define output parameter p-message     as character      no-undo .
    12406   define output parameter p-ok          as logical          no-undo.
    12407   define buffer buf_chk-doc        for ub.chk-doc .
    12408   define buffer buf_chk-gds        for ub.chk-gds .
    12409   define buffer buf_tt-line        for tt-line .
    12410   define buffer buf_tt-open-check  for tt-open-check .
    12411   define variable v-doc-code-list    as character    no-undo.
    12412   define variable v-rid-list    as character    no-undo.
    12413   define variable v-b-code        as integer no-undo .
    12414   define variable v-chk-name      as character no-undo .
    12415   define variable v-second-name   as character no-undo .
    12416   define variable v-setted        as logical no-undo .
    12417   define variable v-gds-code      as integer no-undo .
    12418   define variable v-src-sum       as decimal no-undo .
    12419   define variable v-src-sum-netto as decimal no-undo .
    12420   define variable v-chk-type      as character    no-undo.
    12421   define variable v-chk-list-type    as logical      no-undo.
    12422   define variable v-count         as integer      no-undo.
    12423   do
    12424   on error undo, return error
    12425   :
    12426      if CAN-find( first buf_tt-open-check where buf_tt-open-check.chk-type = INTEGER('1':U))
    12427      then do:
    12428         assign
    12429            p-message = "Чек возврата уже привязан к чеку продажи"
    12430            p-ok      = TRUE
    12431         .
    12432         return.
    12433      end.
    12434      if CAN-find( first tt-line )
    12435      then do:
    12436         assign
    12437            p-message = "В текущем чеке есть строки, выбрать чек возврата НЕВОЗМОЖНО"
    12438            p-ok      = no
    12439         .
    12440         return.
    12441      end.
    12442      run str/chk-docs.w   ( input parparentproc
    12443                           , input "b-sel"
    12444                           , input 'IBS-TH':U
    12445                           , input ?
    12446                           , input v-cntxt-obj-type
    12447                           , input v-cntxt-obj-code
    12448                           , input '':U
    12449                           , input '':U
    12450                           , input p-cash-num
    12451                           , input ?
    12452                           , input ?
    12453                           , input integer('1':U)
    12454                           , output v-rid-list) no-error.
    12455      if v-rid-list = "":U
    12456      then do:
    12457         assign
    12458            p-message = "Отказ от выбора чека"
    12459            p-ok      = TRUE
    12460         .
    12461         return.
    12462      end.
    12463      if p-cd-mode = "0"
    12464      then do:
    12465         run 1987 in this-procedure ( INPUt-OUTPUT p-cd-mode
    12466                                    , input-output p-cd-submode
    12467                                    , output p-message
    12468                                    , output p-ok
    12469                                    ) .
    12470      end.
    12471      define buffer buf_rule-call-param   for ub.rule-call-param .
    12472      define variable v-dont-load-lines    as logical      no-undo.
    12473      for each  buf_rule-call-param
    12474            where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    12475            no-lock
    12476         :
    12477         case buf_rule-call-param.param-name:
    12478            WHEN "p-dont-load-lines"
    12479            then do:
    12480               if buf_rule-call-param.param-value-logical <> ?
    12481               then
    12482               assign
    12483                  v-dont-load-lines        = buf_rule-call-param.param-value-logical
    12484               .
    12485            end.
    12486            OTHERWISE DO:
    12487            end.
    12488         end case.
    12489      end.
    12490      if v-dont-load-lines = FALSE then
    12491      _proc-body:
    12492      DO v-count = 1 TO 1
    12493      on error undo, NEXT
    12494      :
    12495         find first buf_chk-doc
    12496            where RECID(buf_chk-doc) = INTEGER(ENTRY(v-count, v-rid-list))
    12497            no-lock
    12498            no-error
    12499            no-wait
    12500            .
    12501         if  buf_chk-doc.chk-type <> integer('1':U)
    12502         then do:
    12503            UNDO _proc-body, NEXT _proc-body .
    12504         end.
    12505         assign
    12506            v-chk-type = '6':U
    12507            v-doc-code-list = v-doc-code-list + "," + buf_chk-doc.doc-code
    12508         .
    12509         assign
    12510            v-pass-gds = 0
    12511         .
    12512         for each buf_chk-gds
    12513            where buf_chk-gds.doc-code = buf_chk-doc.doc-code
    12514            no-lock
    12515         :
    12516            find first buf_tt-line
    12517                 where buf_tt-line.ord-chk-num  = buf_chk-gds.doc-code
    12518                   AND buf_tt-line.ord-line-num = buf_chk-gds.line-num
    12519                 no-lock no-error.
    12520            if available buf_tt-line then NEXT.
    12521            assign
    12522               v-write-off-code  = 0
    12523               v-src-price       = (buf_chk-gds.price-base - buf_chk-gds.discnt) * ( buf_chk-gds.doc-qnty / buf_chk-gds.src-qnty)
    12524               v-src-discnt      = buf_chk-gds.discnt
    12525               v-src-qnty        = buf_chk-gds.src-qnty
    12526               v-num             = 0
    12527               v-src             = buf_chk-gds.src-code
    12528               v-pump            = buf_chk-gds.pump
    12529               v-nozzle-code     = buf_chk-gds.nozzle-code
    12530               v-pl-code         = buf_chk-gds.pl-code
    12531               v-fbr-depart      = buf_chk-gds.depart-id
    12532               v-ord-chk-num     = buf_chk-gds.doc-code
    12533               v-ord-line-num    = buf_chk-gds.line-num
    12534            .
    12535            run add-gds-line in this-procedure  ( INPUt-OUTPUT p-cd-mode
    12536                                                , INPUt-output p-cd-submode
    12537                                                , output p-message
    12538                                                , output p-ok
    12539                                                ) .
    12540            assign
    12541               v-write-off-code  = 0
    12542               v-src-price       = 0
    12543               v-src-qnty        = 0
    12544               v-num             = 0
    12545               v-src             = "":U
    12546            .
    12547            if not p-ok then do:
    12548               UNDO _proc-body, LEAVE _proc-body .
    12549            end.
    12550            if buf_chk-gds.sales-man > 0
    12551            then do:
    12552               find first buf_tt-line
    12553                  where buf_tt-line.ord-chk-num  = buf_chk-gds.doc-code
    12554                     AND buf_tt-line.ord-line-num = buf_chk-gds.line-num
    12555                  no-lock
    12556                  .
    12557               assign
    12558                  v-src = STRING(buf_chk-gds.sales-man)
    12559               .
    12560               run input-saller in this-procedure (input-output p-cd-mode, input-output p-cd-submode, output p-message, output p-ok).
    12561            end.
    12562         end.
    12563         if not CAN-find (first buf_tt-open-check
    12564                          where buf_tt-open-check.doc-code = buf_chk-doc.doc-code
    12565                            AND buf_tt-open-check.chk-type = buf_chk-doc.chk-type
    12566                          )
    12567         then do:
    12568            create buf_tt-open-check.
    12569            assign
    12570               buf_tt-open-check.doc-code = buf_chk-doc.doc-code
    12571               buf_tt-open-check.chk-type = buf_chk-doc.chk-type
    12572            .
    12573            v-aux-mess = substitute("Возврат по чеку: &1", buf_chk-doc.doc-code).
    12574         end.
    12575      end.
    12576      assign
    12577         v-doc-code-list = TRIM( v-doc-code-list , "," )
    12578      .
    12579   define variable vss-include-info266 as character format "X(65)" no-undo
    12580   initial "@(#)$Workfile$ $Revision$".
    12581   do:
    12582     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
    12583       ( input  1
    12584       , input  v-cntxt-db-num
    12585       , input  '':U
    12586       , input  p-cash-num
    12587       , input  substitute( '&1.&2' , p-cd-mode, p-cd-submode)
    12588       , input  v-chk-type
    12589       , input  '':U
    12590       , input  '*':U
    12591       , input  '':U
    12592       , input  v-doc-code-list
    12593       , input  '':U
    12594       , input  TODAY
    12595       , input  61
    12596       , input  TIME
    12597       , input  'U':U
    12598       , input  0
    12599       , input  v-cntxt-obj-type
    12600       , input  v-cntxt-obj-code
    12601       , input  '':U
    12602       , input  'IBS-TH':U
    12603       , input  0
    12604       , input  ?
    12605       , input  '':U
    12606       , input  0
    12607       , input  '':U
    12608       , input  v-rid-list
    12609       , input  v-cntxt-userid
    12610       ) no-error .
    12611   end.
    12612      if p-ok
    12613      then do:
    12614         find first buf_tt-line no-lock no-error.
    12615         if available buf_tt-line
    12616         then do:
    12617            assign
    12618               v-curr-num-0  = buf_tt-line.num
    12619               v-curr-type-0 = buf_tt-line.type
    12620            .
    12621         end.
    12622      end.
    12623      else do:
    12624         for each buf_tt-open-check
    12625            :
    12626            DELETE buf_tt-open-check.
    12627         end.
    12628      end.
    12629   end.
    12630   end procedure.
    12631   procedure 1990 :
    12632   define input-output  parameter p-cd-mode     as character        no-undo .
