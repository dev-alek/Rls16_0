    12774            p-message = substitute("Не найдена базовая валюта &1", p-base-code)
    12775         .
    12776         return.
    12777      end.
    12778      assign
    12779         v-cd-base-name   = buf_currency.curr-abbr
    12780         v-cd-base-code   = p-base-code
    12781         v-curr-base-code = p-base-code
    12782         p-ok             = TRUE
    12783      .
    12784   end.
    12785   end procedure.
    12786   procedure input-find-str :
    12787   define input-output  parameter p-cd-mode     as character        no-undo .
    12788   define input-output  parameter p-cd-submode  as character      no-undo .
    12789   define output parameter p-message     as character      no-undo .
    12790   define output parameter p-ok          as logical          no-undo.
    12791   define buffer buf_tt-line     for tt-line .
    12792   define buffer buf_tt-head-check     for tt-head-check .
    12793   define variable v-search-code    as integer      no-undo.
    12794   do
    12795   on error undo, return error
    12796   :
    12797      find first buf_tt-head-check.
    12798   define variable vss-include-info269 as character format "X(65)" no-undo
    12799   initial "@(#)$Workfile$ $Revision$".
    12800   do:
    12801     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
    12802       ( input  2
    12803       , input  v-cntxt-db-num
    12804       , input  '':U
    12805       , input  p-cash-num
    12806       , input  substitute( '&1.&2' , p-cd-mode, p-cd-submode)
    12807       , input  buf_tt-head-check.chk-type
