     6930   procedure set-cashier :
     6931   define output        parameter p-message     as character      no-undo .
     6932   define output        parameter p-ok          as logical          no-undo.
     6933   do
     6934   on error undo, return error
     6935   :
     6936   define variable vss-include-info171 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6937     run mainmenu_getcntxt in parparentproc
     6938       (output v-cntxt-db-num
     6939       ,output v-cntxt-userid
     6940       ,output v-cntxt-level
     6941       ,output v-cntxt-host-code-obj
     6942       ,output v-cntxt-obj-type
     6943       ,output v-cntxt-obj-code
     6944       ,output v-cntxt-db-num-obj
     6945       ,output v-cntxt-is-admin
     6946       ) .
     6947      define buffer buf_user-account      for ub.user-account .
     6948      define buffer buf_staff      for ub.staff .
     6949      define buffer buf_clients     for ub.clients .
     6950      define buffer buf_person      for ub.person .
     6951      define variable v-first-name    as character    no-undo.
     6952      define variable v-second-name    as character    no-undo.
     6953      find first buf_user-account
     6954           where buf_user-account.user-id = v-cntxt-userid
     6955           no-lock
     6956           .
     6957      find  first buf_staff
     6958            where buf_staff.role  = 'C':U
     6959         and buf_staff.role-level = 'db':U
     6960         and buf_staff.date-start <= today
     6961         and buf_staff.date-end >= today
     6962         and buf_staff.psn-code = buf_user-account.psn-code
     6963         and buf_staff.db-num     = v-cntxt-db-num
     6964         no-lock
     6965         no-error.
     6966      if not available buf_staff
     6967      then do:
     6968          message
     6969            "Пользователь"
     6970            SKIP "ID:"        buf_user-account.user-id
     6971            SKIP "Фамилия:"   buf_user-account.last-name
     6972            skip "Псевдоним:" buf_user-account.nik
     6973            skip "БД:"        v-cntxt-db-num
     6974            skip "не является кассиром. Работа с кассой невозможна."
     6975          view-as alert-box error.
     6976          return.
     6977      end.
     6978      find first buf_clients
     6979           where buf_clients.obj-type = 'чел':U
     6980             AND buf_clients.obj-code = buf_user-account.psn-code
     6981           NO-LOCK
     6982           .
     6983      find first buf_person
     6984           where buf_person.psn-code = buf_user-account.psn-code
     6985           NO-LOCK
     6986           .
     6987      assign
     6988         v-first-name  = SUBSTRING(TRIM(buf_person.name1), 1, 1)
     6989         v-second-name = SUBSTRING(TRIM(buf_person.name2), 1, 1)
     6990      .
     6991      Assign
     6992         v-cashier          = buf_staff.staff-code
     6993         v-cashier-psn-code = buf_user-account.psn-code
     6994         v-cashier-name     = Substitute( "Кассир &1 &2&3 &4&5"
     6995                                        , buf_clients.obj-name
     6996                                        , v-first-name
     6997                                        , if v-first-name <> "":U then "." else "":U
     6998                                        , v-second-name
     6999                                        , if v-second-name <> "":U then "." else "":U
     7000                                        )
     7001         p-ok               = TRUE
     7002      .
     7003   end.
     7004   end procedure.
     7005   procedure subm-qnty :
     7006   define input-output  parameter p-cd-mode     as character          no-undo.
     7007   define input-output  parameter p-cd-submode  as character          no-undo.
     7008   define output        parameter p-message     as character      no-undo .
     7009   define output        parameter p-ok          as logical          no-undo.
     7010   do
     7011   on error undo, return error
     7012   :
     7013      if p-cd-mode = "1"
     7014      OR p-cd-mode = "2"
     7015      then do:
     7016         assign
     7017            p-cd-submode = "1"
     7018            p-ok         = TRUE
     7019         .
     7020      end.
     7021   end.
     7022   end procedure.
     7023   procedure 1997 :
     7024   define input-output  parameter p-cd-mode     as character          no-undo.
     7025   define input-output  parameter p-cd-submode  as character          no-undo.
     7026   define output        parameter p-message     as character      no-undo .
     7027   define output        parameter p-ok          as logical          no-undo.
     7028   define buffer buf_rule-call-param   for ub.rule-call-param .
     7029   define variable v-sel    as logical      no-undo.
     7030   do
     7031   on error undo, return error
     7032   :
     7033      case p-cd-mode :
     7034         WHEN "1" OR
     7035         WHEN "2" then do:
     7036            if p-cd-submode = "0"
     7037            then do:
     7038               assign
     7039                  p-message    = "Регистрация продавца"
     7040                  p-cd-submode = "8"
     7041                  p-ok         = TRUE
     7042               .
     7043            end.
     7044            if p-cd-submode = "8"
     7045            then do:
     7046               for each  buf_rule-call-param
     7047                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
     7048                  no-lock
     7049                  :
     7050                  case buf_rule-call-param.param-name:
     7051                     WHEN "p-seller"
     7052                     then do:
     7053                        if  buf_rule-call-param.param-value-integer <> 0
     7054                        AND buf_rule-call-param.param-value-integer <> ?
     7055                        then do:
     7056                        assign
     7057                           v-src = STRING(buf_rule-call-param.param-value-integer)
     7058                           v-sel = TRUE
     7059                        .
     7060                        end.
     7061                     end.
     7062                     OTHERWISE DO:
     7063                     end.
     7064                  end case.
     7065               end.
     7066               if v-sel
     7067               then do:
     7068                  run input-saller  ( INPUt-OUTPUT p-cd-mode
     7069                                    , INPUt-output p-cd-submode
     7070                                    , output p-message
     7071                                    , output p-ok
     7072                                    ) .
     7073               end.
     7074            end.
     7075         end.
     7076         OTHERWISE DO:
     7077         end.
     7078      end case.
     7079   end.
     7080   end procedure.
     7081   procedure get-mode-name :
     7082   define input  parameter p-cd-mode     as character          no-undo.
     7083   define input  parameter p-cd-submode  as character          no-undo.
     7084   define output parameter p-message     as character      no-undo .
     7085   define output parameter p-ok          as logical          no-undo.
     7086   define buffer buf_tt-head-check     for tt-head-check .
     7087   define variable v-type    as integer    no-undo.
     7088   do
     7089   on error undo, return error
     7090   :
     7091      find  first tt-cdm
     7092            where tt-cdm.cd-mode = p-cd-mode
     7093            NO-LOCK
     7094            no-error
     7095            .
     7096      if available tt-cdm
     7097      then do:
     7098         case p-cd-mode:
     7099            WHEN "8"
     7100            then do:
     7101               find first buf_tt-head-check no-error.
     7102               if available buf_tt-head-check
     7103               then do:
     7104                  assign
     7105                     v-type = buf_tt-head-check.chk-type
     7106                  .
     7107               end.
     7108                     assign
     7109                        p-message = "Чеки МЦ"
     7110                        p-ok      = TRUE
     7111                     .
     7112            end.
     7113            OTHERWISE DO:
     7114               assign
     7115                  p-message = tt-cdm.cdm-name
     7116                  p-ok      = TRUE
     7117               .
     7118            end.
     7119         end case.
     7120      end.
     7121      else do:
     7122         assign
     7123            p-message = "   "
     7124         .
     7125      end.
     7126   end.
     7127   end procedure.
     7128   procedure get-submode-name :
     7129   define input  parameter p-cd-mode     as character          no-undo.
     7130   define input  parameter p-cd-submode  as character          no-undo.
     7131   define output parameter p-message     as character      no-undo .
     7132   define output parameter p-ok          as logical          no-undo.
     7133   do
     7134   on error undo, return error
     7135   :
     7136      find first tt-func-key
     7137           where tt-func-key.cd-mode    = p-cd-mode
     7138            AND  tt-func-key.cd-submode = p-cd-submode
     7139            AND  tt-func-key.key-name   = "v-src-input"
     7140           NO-LOCK
     7141           No-error
     7142           .
     7143      if available tt-func-key
     7144      then do:
     7145         assign
     7146            p-message = tt-func-key.key_label
     7147            p-ok      = TRUE
     7148         .
     7149      end.
     7150      else do:
     7151         assign
     7152            p-message = "   "
     7153         .
     7154      end.
     7155   end.
     7156   end procedure.
     7157   procedure get-chk-num :
     7158   define output parameter p-message     as character      no-undo .
     7159   define output parameter p-ok          as logical          no-undo.
     7160   do
     7161   on error undo, return error
     7162   :
     7163     find tt-head-check no-error.
     7164     if available tt-head-check
     7165     then do:
     7166        assign
     7167            p-message =  STRING( tt-head-check.doc-code )
     7168        .
     7169     end.
     7170     else do:
     7171        assign
     7172            p-ok = TRUE
     7173        no-error.
     7174     end.
     7175   end.
     7176   end procedure.
     7177   procedure input-saller :
     7178   define input-OUTPUT parameter p-cd-mode     as character          no-undo.
     7179   define input-OUTPUT parameter p-cd-submode  as character          no-undo.
     7180   define output parameter p-message     as character      no-undo .
     7181   define output parameter p-ok          as logical          no-undo.
     7182   define buffer buf_tt-head-check     for tt-head-check .
     7183   define buffer buf_tt-line     for tt-line .
     7184   define buffer buf_clients     for ub.clients .
     7185   define buffer buf_person      for ub.person .
     7186   define variable v-num-line    as integer      no-undo.
     7187   define variable v-password    as character    no-undo.
     7188   define variable v-seller-code as integer      no-undo.
     7189   define variable v-psn-seller-code as integer      no-undo.
     7190   do
     7191   on error undo, return error
     7192   :
     7193      if v-curr-type-0 <> 0
     7194      then do:
     7195         assign
     7196            p-message = "Продавца можно установить только на товарную строку"
     7197            p-ok = FALSE
     7198         .
     7199         return.
     7200      end.
     7201      if p-cd-mode = "1"
     7202      OR p-cd-mode = "2"
     7203      then do:
     7204         find buf_tt-head-check.
     7205         find last  buf_tt-line
     7206              where buf_tt-line.type = 0
