    15412   procedure print-slip :
    15413   define input   parameter p-slip     as character no-undo .
    15414   define output  parameter p-message  as character no-undo .
    15415   define output  parameter p-ok       as logical   no-undo .
    15416   define variable v-iii    as integer      no-undo .
    15417   define variable v-ccc    as character    no-undo .
    15418   do
    15419   on error undo, return error
    15420   :
    15421      DO v-iii = 1 TO NUM-ENTRIES(p-slip, chr(10))
    15422      :
    15423         v-ccc = ENTRY(v-iii, p-slip, chr(10)).
    15424         if INDEX(v-ccc, chr(01)) > 0
    15425         then do:
    15426            if v-cutter
    15427            then do:
    15428   define variable vss-include-info333 as character format "X(65)" no-undo
    15429   initial "@(#)$Workfile$ $Revision$".
    15430   do:
    15431     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-cut in g#fr-lib
    15432       ( INPUT       FALSE
    15433       , output      p-message
    15434       , output      p-ok
    15435       ) no-error .
    15436   end.
    15437            end.
    15438         end.
    15439         v-ccc = REPLACE(v-ccc,chr(01) , "":U).
    15440   define variable vss-include-info334 as character format "X(65)" no-undo
    15441   initial "@(#)$Workfile$ $Revision$".
    15442   do:
    15443     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-print-str in g#fr-lib
    15444       ( input       v-ccc
    15445       , output      p-message
    15446       , output      p-ok
    15447       ) no-error .
    15448   end.
    15449      end.
    15450      assign
    15451         p-ok     = TRUE
    15452      .
    15453   end.
    15454   end procedure.
    15455   procedure accum-chk-pay :
    15456   define input   parameter p-pay-code  as integer   no-undo .
    15457   define input   parameter p-curr-code as integer   no-undo .
    15458   define input   parameter p-card-num  as character no-undo .
    15459   define output  parameter p-found-pay as logical   no-undo .
    15460   define output  parameter p-summ-pay  as decimal   no-undo .
    15461   define buffer buf_chk-pay        for ub.chk-pay .
    15462   define buffer buf_tt-open-check  for tt-open-check .
    15463   define buffer buf_tt-line        for tt-line .
    15464   do
    15465   on error undo, return error
    15466   :
    15467      if p-pay-code = 0
    15468      then do:
    15469         for each  buf_tt-line
    15470            where buf_tt-line.ord-chk-num <> "":U
    15471            no-lock
    15472            BREAK BY buf_tt-line.ord-chk-num
    15473            :
    15474            if first-OF(buf_tt-line.ord-chk-num)
    15475            then do:
    15476               if CAN-find (first buf_tt-open-check
    15477                            where buf_tt-open-check.doc-code = buf_tt-line.ord-chk-num
    15478                              AND buf_tt-open-check.chk-type = INTEGER('1':U))
    15479               then do:
    15480                  assign
    15481                        p-found-pay = TRUE
    15482                  .
    15483                  for each  buf_chk-pay
    15484                        where buf_chk-pay.doc-code  = buf_tt-line.ord-chk-num
    15485                        NO-LOCK
    15486                        :
    15487                        assign
    15488                           p-summ-pay = p-summ-pay + buf_chk-pay.tot-sum
    15489                        .
    15490                  end.
    15491               end.
    15492            end.
    15493            else do:
    15494               NEXT.
    15495            end.
    15496         end.
    15497      end.
    15498      else do:
    15499         for each  buf_tt-line
    15500            where buf_tt-line.ord-chk-num <> "":U
    15501            no-lock
    15502            BREAK BY buf_tt-line.ord-chk-num
    15503            :
    15504            if first-OF(buf_tt-line.ord-chk-num)
    15505            then do:
    15506               if CAN-find (first buf_tt-open-check
    15507                            where buf_tt-open-check.doc-code = buf_tt-line.ord-chk-num
    15508                              AND buf_tt-open-check.chk-type = INTEGER('1':U))
    15509               then do:
    15510                  assign
    15511                        p-found-pay = TRUE
    15512                  .
    15513                  for each  buf_chk-pay
    15514                        where buf_chk-pay.doc-code    = buf_tt-line.ord-chk-num
    15515                        AND buf_chk-pay.pay-code    = p-pay-code
    15516                        AND buf_chk-pay.curr-code   = p-curr-code
    15517                        AND buf_chk-pay.pay-card    = p-card-num
    15518                        NO-LOCK
    15519                        :
    15520                        assign
    15521                           p-summ-pay = p-summ-pay + buf_chk-pay.tot-rubl
    15522                        .
    15523                  end.
    15524               end.
    15525            end.
    15526            else do:
    15527               NEXT.
    15528            end.
    15529         end.
    15530      end.
    15531      assign
    15532         p-summ-pay = ABS( p-summ-pay )
    15533      .
    15534   end.
    15535   end procedure.
    15536   procedure accum-curr-chk-pay :
    15537   define input   parameter p-pay-code  as integer   no-undo .
    15538   define input   parameter p-curr-code as integer   no-undo .
    15539   define input   parameter p-card-num  as character no-undo .
    15540   define output  parameter p-summ-pay  as decimal   no-undo .
    15541   define buffer buf_tt-line     for tt-line .
    15542   do
    15543   on error undo, return error
    15544   :
    15545      if p-pay-code = 0
    15546      then do:
    15547         for each  buf_tt-line
    15548            where buf_tt-line.type = 1
    15549            :
    15550            assign
    15551               p-summ-pay = p-summ-pay + buf_tt-line.summ-netto-rub
    15552            .
    15553         end.
    15554      end.
    15555      else do:
    15556         for each buf_tt-line
    15557            where buf_tt-line.type        = 1
    15558              AND buf_tt-line.line-code   = p-pay-code
    15559              AND buf_tt-line.curr-code   = p-curr-code
    15560              AND buf_tt-line.pay-card    = p-card-num
    15561            :
    15562            assign
    15563               p-summ-pay = p-summ-pay + buf_tt-line.summ-netto-rub
    15564            .
    15565         end.
    15566      end.
    15567   end.
    15568   end procedure.
    15569   PROCEDURE annul-lost-chk :
    15570   define output  parameter p-message   as character no-undo .
    15571   define output  parameter p-ok        as logical   no-undo .
    15572   define buffer buf_chk-doc     for ub.chk-doc .
    15573   do
    15574   on error undo, return error
    15575   :
    15576     find last  buf_chk-doc
    15577         where buf_chk-doc.obj-type = v-cntxt-obj-type
    15578           AND buf_chk-doc.obj-code = v-cntxt-obj-code
    15579           AND buf_chk-doc.pay-desk = p-cash-num
    15580           AND buf_chk-doc.office   = ?
    15581         NO-LOCK
    15582         no-error
    15583         .
    15584     if available buf_chk-doc
    15585     then do:
    15586   define variable vss-include-info335 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15587   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_annu-lost-check in g#libthpos
    15588     (input  buf_chk-doc.doc-code
    15589     ) no-error .
    15590       if error-status:error
    15591       then do:
    15592         assign
    15593         p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
    15594         p-ok = FALSE
    15595         .
    15596       end.
    15597       else do:
    15598         message
    15599         substitute("Найден и аннулирован незавершенный чек &1", buf_chk-doc.doc-code )
    15600         view-as alert-box warning.
    15601       end.
    15602     end.
    15603     assign
    15604     p-ok = TRUE
    15605     .
