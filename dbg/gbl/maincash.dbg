    17504   define output  parameter p-found    as logical   no-undo .
    17505   define output  parameter p-gds-qnty as decimal   no-undo .
    17506   define buffer buf_chk-gds        for ub.chk-gds .
    17507   define buffer buf_tt-open-check  for tt-open-check .
    17508   define buffer buf_tt-line        for tt-line .
    17509   do
    17510   on error undo, return error
    17511   :
    17512      for each buf_tt-open-check
    17513         where buf_tt-open-check.chk-type = INTEGER('1':U)
    17514         no-lock
    17515         :
    17516            assign
    17517               p-found    = TRUE
    17518            .
    17519            for each buf_chk-gds
    17520               where buf_chk-gds.doc-code = buf_tt-open-check.doc-code
    17521               AND   buf_chk-gds.src-code = p-code
    17522               NO-LOCK
    17523               :
    17524               assign
    17525                  p-gds-qnty = p-gds-qnty + ABS(buf_chk-gds.src-qnty)
    17526               .
    17527            end.
    17528      end.
    17529   end.
    17530   end procedure.
    17531   procedure accum-curr-chk-gds :
    17532   define input   parameter p-gds-code  as character   no-undo .
    17533   define output  parameter p-gds-qnty  as decimal   no-undo .
    17534   define buffer buf_tt-line     for tt-line .
    17535   do
    17536   on error undo, return error
    17537   :
    17538      for each buf_tt-line
    17539         where buf_tt-line.type = 0
    17540           AND buf_tt-line.src  = p-gds-code
    17541         :
    17542         assign
    17543            p-gds-qnty = p-gds-qnty + ABS(buf_tt-line.qnty)
    17544         .
    17545      end.
    17546   end.
    17547   end procedure.
    17548   procedure summ-for-pay :
    17549   define input-output  parameter p-cd-mode     as character        no-undo .
    17550   define input-output  parameter p-cd-submode  as character      no-undo .
    17551   define output parameter p-message     as character      no-undo .
    17552   define output parameter p-ok          as logical          no-undo.
    17553   define buffer buf_tt-head-check  for tt-head-check .
    17554   define buffer buf_tt-line        for tt-line .
    17555   define variable v-pline-num as integer no-undo .
    17556   define variable v-mode as character no-undo .
    17557   define variable v-pass-pay as integer no-undo .
    17558   define variable v-pay-card as character no-undo .
    17559   define variable v-tot-sum as decimal no-undo .
    17560   define variable v-tot-rubl as decimal no-undo .
    17561   define variable v-tot-base as decimal no-undo .
    17562   define variable v-par-code as integer   no-undo .
    17563   define variable v-src-qnty as decimal no-undo .
    17564   define variable v-get-qnty-method as character no-undo .
    17565   define variable v-2-cdpay-code as integer no-undo .
    17566   define variable v-2-curr-code as integer no-undo .
    17567   define variable v-2-tot-base as decimal no-undo .
    17568   define variable v-2-tot-rubl as decimal no-undo .
    17569   define variable v-2-frpay-code as integer no-undo .
    17570   define variable v-src-discnt-local    as decimal      no-undo.
    17571   define variable v-src-discnt-local-rub    as decimal      no-undo.
    17572   define variable v-for-discnt-local-doc    as decimal no-undo .
    17573   define variable v-for-discnt-local-rubl   as decimal no-undo .
    17574   define variable v-for-discnt-local-r-b    as decimal no-undo .
    17575   do
    17576   on error undo, return error
    17577   :
    17578      find buf_tt-head-check.
    17579      find last buf_tt-line where buf_tt-line.type = 1 no-error.
    17580      if not available buf_tt-head-check
    17581      then do:
    17582         assign
    17583            v-sum-for-pay = 0
    17584         .
    17585      end.
    17586      if p-cd-submode = "2"
    17587      then do:
    17588         assign
    17589            v-pline-num = if available buf_tt-line then buf_tt-line.num + 1 else 1
    17590            v-mode = 'check'
    17591            v-pass-pay  = 0
    17592            v-pay-card  = "0"
    17593            v-tot-sum   = ?
    17594            v-tot-rubl  = ?
    17595            v-tot-base  = ?
    17596         .
    17597         assign
    17598            v-frpay-code = ?
    17599         .
    17600   define variable vss-include-info373 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17601   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_pay-line in g#libthpos
    17602     (input  buf_tt-head-check.doc-code
    17603     ,input  v-pline-num
    17604     ,input  v-mode
    17605     ,input-output  v-pay-type
    17606     ,input-output  v-curr-base-code
    17607     ,input  v-par-code
    17608     ,input  v-src-qnty
    17609     ,output v-frpay-code
    17610     ,input  v-pass-pay
    17611     ,input  v-pay-card
    17612     ,input-output  v-tot-sum
    17613     ,input-output  v-sum-for-pay
    17614     ,input-output  v-tot-base
    17615     ,output v-get-qnty-method
    17616     ,output v-2-cdpay-code
    17617     ,output v-2-curr-code
    17618     ,output v-2-frpay-code
    17619     ,output v-2-tot-sum
    17620     ,output v-2-tot-rubl
    17621     ,output v-2-tot-base
    17622     ,output v-src-discnt
    17623     ,output v-src-discnt-rub
    17624     ,output v-for-discnt-doc
    17625     ,output v-for-discnt-rubl
    17626     ,output v-for-discnt-r-b
    17627     ,output p-ok
    17628     ) no-error .
    17629         if error-status:error
    17630         then do:
    17631            assign
    17632               p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
    17633               p-ok = FALSE
    17634               v-sum-for-pay = 0
    17635            .
    17636            return.
    17637         end.
    17638         return.
    17639      end.
    17640      else do:
    17641         assign
    17642            v-sum-for-pay = 0
    17643            p-ok = FALSE
    17644         .
    17645         return.
    17646      end.
    17647   end.
    17648   end PROCEDURE.
    17649   procedure wth-type-select:
    17650   define input-output  parameter p-cd-mode     as character no-undo .
    17651   define input-output  parameter p-cd-submode  as character no-undo .
    17652   define output        parameter p-message     as character no-undo .
    17653   define output        parameter p-ok          as logical   no-undo .
    17654   define variable v-chk-type    as character    no-undo.
    17655   do
    17656   on error undo, return error
    17657   :
    17658      run gbl/d-list.w  ( input "b-sel":U
    17659                        , input "Выберите тип чека МЦ"
    17660                        , input chr(44) + '3':U + chr(44) + '2':U
    17661                        , input "Тип чека МЦ не задан" + chr(44) + "Кассовый фонд" + chr(44) + 'Инкассация':U
    17662                        , input chr(44)
    17663                        , input "":U
    17664                        , output v-chk-type
    17665                        ) .
    17666      if v-chk-type = "":u then do:
    17667         assign
    17668            p-message = "Не выбран тип чека МЦ"
    17669         .
    17670         return.
    17671      end.
    17672      case v-chk-type:
    17673         WHEN '3':U
    17674         then do:
    17675            run chk-fnd-open  ( INPUt-OUTPUT p-cd-mode
    17676                              , INPUt-output p-cd-submode
    17677                              , output p-message
    17678                              , output p-ok
    17679                              ) .
    17680         end.
    17681         WHEN '2':U
    17682         then do:
    17683            run chk-inc-open  ( INPUt-OUTPUT p-cd-mode
    17684                              , INPUt-output p-cd-submode
    17685                              , output p-message
    17686                              , output p-ok
    17687                              ) .
    17688         end.
    17689         OTHERWISE DO:
    17690         end.
    17691      end case.
    17692   end.
    17693   end procedure.
    17694   procedure reset-summ-for-pay :
    17695   do
    17696   on error undo, return error
    17697   :
    17698      assign
    17699         v-sum-for-pay  = 0
    17700      .
    17701      return.
    17702   end.
    17703   end PROCEDURE.
    17704   procedure disc-type-select:
    17705   define output        parameter p-message     as character no-undo .
    17706   define output        parameter p-ok          as logical   no-undo .
    17707   define variable v-chk-type    as character    no-undo.
    17708   do
    17709   on error undo, return error
    17710   :
    17711      run gbl/d-list.w  ( input "b-sel":U
    17712                        , input "Выберите тип скидки"
    17713                        , input chr(44) + '10':U + chr(44) + '1':U
    17714                        , input "Тип чека МЦ не задан" + chr(44) + "Абсолютная скидка" + chr(44) + "Процентная скидка"
    17715                        , input chr(44)
    17716                        , input "":U
    17717                        , output v-disc-type
    17718                        ) .
    17719      if v-disc-type = "":u then do:
    17720         assign
    17721            p-message = "Не выбран тип скидки"
    17722         .
    17723         return.
    17724      end.
    17725      case v-disc-type:
    17726         WHEN '10':U
    17727         then do:
    17728            assign
    17729               p-message = "Абсолютная скидка на товарную строку"
    17730               p-ok      = TRUE
    17731            .
    17732         end.
    17733         WHEN '1':U
    17734         then do:
    17735            assign
    17736               p-message = "Процентная скидка на товарную строку"
    17737               p-ok      = TRUE
    17738            .
    17739         end.
    17740         OTHERWISE DO:
    17741            assign
    17742               p-message = substitute("Неизвестный тип скидки - &1",v-disc-type)
    17743            .
    17744         end.
    17745      end case.
    17746   end.
    17747   end procedure.
    17748   procedure wait-wth-type :
    17749   define output        parameter p-message     as character no-undo .
    17750   define output        parameter p-ok          as logical   no-undo .
    17751   do
    17752   on error undo, return error
    17753   :
    17754      assign
    17755         p-message = "Выберите тип чека МЦ"
    17756         p-ok      = FALSE
    17757      .
    17758      return.
    17759   end.
    17760   end procedure.
