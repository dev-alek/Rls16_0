    13785       , input  '':U
    13786       , input  'IBS-TH':U
    13787       , input  0
    13788       , input  ?
    13789       , input  '':U
    13790       , input  0
    13791       , input  v-src
    13792       , input  bufbr_tt-line.summ-netto
    13793       , input  v-cntxt-userid
    13794       ) no-error .
    13795   end.
    13796               return.
    13797            end.
    13798            assign
    13799               v-obj-name = "на строку"
    13800               bufbr_tt-line.hand-discounted = v-disc-type
    13801            .
    13802         end.
    13803         OTHERWISE DO:
    13804         end.
    13805      end case.
    13806   define variable vss-include-info288 as character format "X(65)" no-undo
    13807   initial "@(#)$Workfile$ $Revision$".
    13808   do:
    13809     if valid-handle( g#eventlib ) <> TRUE then do:       run gbl/eventlib.p persistent no-error.       if error-status :error or valid-handle( g#eventlib ) <> TRUE then do:         message "Error starting eventlib.p" skip( 0 )           g#eventlib                        skip( 0 )           g#eventlib    :type               skip( 0 )           g#eventlib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run eventlib-event-log in g#eventlib
    13810       ( input  0
    13811       , input  v-cntxt-db-num
    13812       , input  '':U
    13813       , input  p-cash-num
    13814       , input  substitute( '&1.&2' , p-cd-mode, p-cd-submode)
    13815       , input  buf_tt-head-check.chk-type
    13816       , input  '':U
    13817       , input  p-message
    13818       , input  v-dsk
    13819       , input  buf_tt-head-check.doc-code
    13820       , input  bufbr_tt-line.qnty
    13821       , input  TODAY
    13822       , input  44
    13823       , input  TIME
    13824       , input  'E':U
    13825       , input  bufbr_tt-line.line-code
    13826       , input  v-cntxt-obj-type
    13827       , input  v-cntxt-obj-code
    13828       , input  '':U
    13829       , input  'IBS-TH':U
    13830       , input  0
    13831       , input  ?
    13832       , input  '':U
    13833       , input  0
    13834       , input  v-src
    13835       , input  bufbr_tt-line.summ-netto
    13836       , input  v-cntxt-userid
    13837       ) no-error .
    13838   end.
    13839      define variable v-num-local   as integer      no-undo.
    13840      define variable v-type-local  as integer      no-undo.
    13841      assign
    13842         v-num-local  = v-curr-num-0
    13843         v-type-local = v-curr-type-0
    13844      .
    13845      run refresh-lines in this-procedure
    13846                     ( output p-message
    13847                     , output p-ok
    13848                     ) .
    13849      assign
    13850         v-curr-num-0     = v-num-local
    13851         v-curr-type-0    = v-type-local
    13852         v-src-qnty  = 0
    13853      .
    13854      if p-ok
    13855      then do:
    13856         assign
    13857            p-message = substitute  ( "&1 скидка &2 &3&4"
    13858                                    , v-type-name
    13859                                    , v-obj-name
    13860                                    , v-local-src
    13861                                    , v-end
    13862                                    )
    13863            p-cd-submode = "0"
    13864            v-disc-type  = "":U
    13865         .
    13866      end.
    13867   end.
    13868   end procedure.
    13869   procedure discont-abs :
    13870   define output        parameter p-message     as character      no-undo .
    13871   define output        parameter p-ok          as logical          no-undo.
    13872   do
    13873   on error undo, return error
    13874   :
    13875      assign
    13876         p-message   = "Абсолютная скидка"
    13877         v-disc-type = '10':U
    13878         p-ok        = TRUE
    13879      .
    13880   end.
    13881   end procedure.
    13882   procedure discont-per :
    13883   define output        parameter p-message     as character      no-undo .
    13884   define output        parameter p-ok          as logical          no-undo.
    13885      assign
    13886         p-message   = "Процентная скидка"
    13887         v-disc-type = '1':U
    13888         p-ok        = TRUE
    13889      .
    13890   do
    13891   on error undo, return error
    13892   :
    13893   end.
    13894   end procedure.
    13895   procedure discont-fix :
    13896   define input-output  parameter p-cd-mode     as character        no-undo .
    13897   define input-output  parameter p-cd-submode  as character      no-undo .
    13898   define output        parameter p-message     as character      no-undo .
    13899   define output        parameter p-ok          as logical          no-undo.
    13900   do
    13901   on error undo, return error
    13902   :
    13903      assign
    13904         v-src = STRING(v-fix-summ-pay)
    13905      .
    13906      run input-discont  ( input-output p-cd-mode
    13907                        , INPUt-output p-cd-submode
    13908                        , output p-message
    13909                        , output p-ok
    13910                        ) .
    13911   end.
    13912   end procedure.
    13913   procedure 1980 :
    13914   define input-output  parameter p-cd-mode     as character        no-undo .
    13915   define input-output  parameter p-cd-submode  as character      no-undo .
    13916   define output        parameter p-message     as character      no-undo .
    13917   define output        parameter p-ok          as logical          no-undo.
    13918   define buffer buf_tt-line     for tt-line .
    13919   do
    13920   on error undo, return error
    13921   :
    13922         if  p-cd-submode = "0"
    13923         then do:
    13924            if not available bufbr_tt-line
    13925            then do:
    13926               assign
    13927                  p-message = "Чек пуст"
    13928                  p-ok      = FALSE
    13929               .
    13930               return .
    13931            end.
    13932            if bufbr_tt-line.type <> 0
    13933            then do:
    13934               assign
    13935                  p-message = "Скидка устанавливается только на товарную строку"
    13936                  p-ok      = FALSE
    13937               .
    13938               return .
    13939            end.
    13940            run adm/chk-pass.w   ( input parparentproc
    13941                                 , input v-cntxt-userid
    13942                                 , input v-cntxt-db-num
    13943                                 , input "actn_ibsthpos-discont"
    13944                                 , input FALSE
    13945                                 , output p-message
    13946                                 , output p-ok
    13947                                 ) .
    13948            if CAN-find (first buf_tt-line where buf_tt-line.type = 1 NO-LOCK)
    13949            then do:
    13950               assign
    13951                  p-message = "Скидка должна быть задана до принятия платежей"
    13952                  p-ok      = FALSE
    13953               .
    13954            end.
    13955            if not p-ok
    13956            then return.
    13957            assign
    13958               p-message   = "Cкидка на товарную строку чека"
    13959               p-cd-submode = "4"
    13960               p-ok = TRUE
    13961            .
    13962         end.
    13963         if  p-cd-submode = "4"
    13964         then do:
    13965            define buffer buf_rule-call-param   for ub.rule-call-param .
    13966            define buffer buf_cash-pay          for ub.cash-pay .
    13967            define variable v-type    as logical      no-undo.
    13968            define variable v-value    as logical      no-undo.
    13969            for each  buf_rule-call-param
    13970                  where buf_rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    13971                  no-lock
    13972               :
    13973               case buf_rule-call-param.param-name:
    13974                  WHEN "p-discnt-v-type"
    13975                  then do:
    13976                     if  buf_rule-call-param.param-value-integer <> 0
    13977                     AND buf_rule-call-param.param-value-integer <> ?
    13978                     then
    13979                     assign
    13980                        v-disc-type       = STRING(buf_rule-call-param.param-value-integer)
    13981                        v-type            = TRUE
    13982                     .
    13983                  end.
    13984                  WHEN "p-discnt-value"
    13985                  then do:
    13986                     if  buf_rule-call-param.param-value-decimal <> 0
    13987                     AND buf_rule-call-param.param-value-decimal <> ?
    13988                     then
    13989                     assign
    13990                        v-src = STRING(buf_rule-call-param.param-value-decimal)
    13991                        v-value = TRUE
    13992                     .
    13993                  end.
    13994                  OTHERWISE DO:
    13995                  end.
    13996               end case.
    13997            end.
    13998            if v-type
    13999            then do:
    14000               if v-value
    14001               then do:
    14002                  run input-discont ( INPUt-OUTPUT p-cd-mode
    14003                                    , INPUt-output p-cd-submode
    14004                                    , output p-message
    14005                                    , output p-ok
    14006                                    ) .
    14007               end.
    14008               else do:
    14009                  case v-disc-type:
    14010                     WHEN '10':U
    14011                     then do:
    14012                        assign
    14013                           p-message = "Абсолютная скидка на товарную строку"
    14014                           p-ok      = TRUE
    14015                        .
    14016                     end.
    14017                     WHEN '1':U
    14018                     then do:
    14019                        assign
    14020                           p-message = "Процентная скидка на товарную строку"
    14021                           p-ok      = TRUE
    14022                        .
    14023                     end.
    14024                     OTHERWISE DO:
    14025                        assign
    14026                           p-message = substitute("Неизвестный тип скидки - &1",v-disc-type)
    14027                        .
    14028                     end.
    14029                  end case.
    14030               end.
    14031            end.
    14032            else do:
    14033               assign
    14034                  p-message = "Укажите тип скидки на товарную строку чека"
    14035               .
    14036               return.
    14037            end.
    14038         end.
    14039   end.
    14040   end procedure.
    14041   procedure recalc-lines :
    14042   define input         parameter p-start-line as integer          no-undo.
    14043   define input         parameter p-st as integer          no-undo.
    14044   define input         parameter p-pay as integer          no-undo.
    14045   define input-output  parameter p-cd-mode     as character          no-undo.
    14046   define input-output  parameter p-cd-submode  as character          no-undo.
    14047   define output  parameter p-message     as character      no-undo .
    14048   define output  parameter p-ok          as logical          no-undo.
    14049   define buffer buf_tt-line     for tt-line .
    14050   do
    14051   on error undo, return error
    14052   :
    14053      for each  buf_tt-line
    14054          where buf_tt-line.type =  0
    14055            AND buf_tt-line.num  >= p-start-line
    14056          NO-LOCK
    14057          :
    14058          assign
    14059            v-src = STRING(buf_tt-line.qnty)
    14060            v-curr-num-0  = buf_tt-line.num
    14061            v-curr-type-0 = buf_tt-line.type
    14062          .
    14063          run upd-line in this-procedure
    14064                        ( input-output p-cd-mode
    14065                        , INPUt-output p-cd-submode
    14066                        , output p-message
    14067                        , output p-ok
    14068                        ) .
    14069      end.
    14070      run set-all-summ ( output p-message
    14071                         , output p-ok
    14072                         ) .
    14073      if p-pay > 0
    14074      then do:
    14075         for each  buf_tt-line
    14076            where buf_tt-line.type =  1
    14077            NO-LOCK
    14078            :
    14079            assign
    14080               v-src         = STRING(buf_tt-line.line-name-2)
    14081               v-curr-num-0  = buf_tt-line.num
    14082               v-curr-type-0 = buf_tt-line.type
    14083            .
    14084            run upd-line in this-procedure
    14085                           ( input-output p-cd-mode
    14086                           , INPUt-output p-cd-submode
    14087                           , output p-message
    14088                           , output p-ok
    14089                           ) .
    14090            assign
    14091               v-src         = ""
    14092            .
    14093         end.
    14094      end.
    14095      if p-st > 0
    14096      then do:
    14097         run set-all-summ ( output p-message
    14098                          , output p-ok
    14099                          ) .
    14100      end.
    14101   end.
    14102   end procedure.
    14103   procedure refresh-lines :
    14104   define output  parameter p-message     as character      no-undo .
    14105   define output  parameter p-ok          as logical          no-undo.
    14106   define buffer buf_tt-line     for tt-line .
    14107   do
    14108   on error undo, return error
    14109   :
    14110      for each  buf_tt-line
    14111          where buf_tt-line.type =  0
    14112          NO-LOCK
    14113          :
    14114          assign
    14115            v-curr-num-0  = buf_tt-line.num
    14116            v-curr-type-0 = buf_tt-line.type
    14117          .
    14118          run refresh-gds-line in this-procedure ( output p-message
    14119                                                 , output p-ok
    14120                                                 ) .
    14121      end.
    14122         run set-all-summ ( output p-message
    14123                          , output p-ok
    14124                          ) .
    14125   end.
    14126   end procedure.
    14127   procedure refresh-gds-line :
    14128   define output        parameter p-message     as character      no-undo .
    14129   define output        parameter p-ok          as logical          no-undo.
    14130   define buffer buf_tt-line     for tt-line .
    14131   define buffer buf_tt-head-check     for tt-head-check .
    14132   define variable v-b-code          as integer no-undo .
    14133   define variable v-gds-code        as integer no-undo .
    14134   define variable v-chk-name        as character no-undo .
    14135   define variable v-second-name     as character no-undo .
    14136   define variable v-src-sum         as decimal no-undo .
    14137   define variable v-src-sum-netto   as decimal no-undo .
    14138   define variable v-next    as character    no-undo.
    14139   define variable v-qnty-old    as decimal      no-undo.
    14140   define variable v-src-discnt-local    as decimal      no-undo.
    14141   define variable v-src-discnt-local-rub    as decimal      no-undo.
    14142   define variable v-for-discnt-local-doc    as decimal no-undo .
    14143   define variable v-for-discnt-local-rubl   as decimal no-undo .
    14144   define variable v-for-discnt-local-r-b    as decimal no-undo .
    14145   do
    14146   on error undo, return error
    14147   :
    14148      if  v-curr-num-0 <> 0
    14149      then do:
    14150         find buf_tt-head-check.
    14151         find first buf_tt-line
    14152            where buf_tt-line.num  = v-curr-num-0
    14153              and buf_tt-line.type = v-curr-type-0
    14154            no-lock
    14155            .
    14156         case buf_tt-line.type:
    14157            WHEN 0 then do:
    14158               define variable v-qqq    as decimal      no-undo.
    14159               assign
    14160                  v-pump            = 0
    14161                  v-nozzle-code     = 0
    14162                  v-pl-code         = 0
    14163                  v-pass-gds        = 0
    14164                  v-fbr-depart      = 0
    14165                  v-src-price       = buf_tt-line.price-rub
    14166                  v-src-qnty        = if buf_tt-head-check.chk-type = INTEGER('6':U) then - buf_tt-line.qnty else buf_tt-line.qnty
    14167                  v-write-off-code  = 0
    14168                  v-src             = buf_tt-line.src
    14169               .
    14170   define variable vss-include-info289 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14171   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_gds-line in g#libthpos
    14172     (input  buf_tt-head-check.doc-code
    14173     ,input  v-curr-num-0
    14174     ,input  'ПРОСМОТР':U
    14175     ,input  0
    14176     ,input  buf_tt-line.src
    14177     ,input-output  v-src-qnty
    14178     ,input  v-pump
    14179     ,input  v-nozzle-code
    14180     ,input  v-pl-code
    14181     ,input  v-pass-gds
    14182     ,input  v-write-off-code
    14183     ,input  v-fbr-depart
    14184     ,output p-ok
    14185     ,output v-next
    14186     ,output v-b-code
    14187     ,output v-gds-code
    14188     ,output v-chk-name
    14189     ,output v-second-name
    14190     ,input-output v-src-price
    14191     ,output v-src-price-rub
    14192     ,output v-src-discnt
    14193     ,output v-src-discnt-rub
    14194     ,output v-src-sum
    14195     ,output v-src-sum-rub
    14196     ,output v-src-sum-netto
    14197     ,output v-src-sum-netto-rub
    14198     ,output v-unit-base
    14199     ) no-error .
    14200               if error-status:error
    14201               then do:
    14202                  assign
    14203                     p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
    14204                     p-ok = FALSE
    14205                  .
    14206                  return.
    14207               end.
    14208               assign
    14209                  buf_tt-line.qnty           = ABSOLUTE(v-src-qnty)                              buf_tt-line.qnty-str         = STRING(ABSOLUTE(v-src-qnty), "->>,>>>,>>9.999":U)                              buf_tt-line.price            = ABS(v-src-price)                              buf_tt-line.price-rub        = ABS(v-src-price-rub)                              buf_tt-line.price-STR        = STRING(ABSOLUTE(v-src-price-rub), "->>,>>>,>>9.99":U)                             buf_tt-line.summ-netto       = ABSOLUTE(v-src-sum-netto)                                                      buf_tt-line.summ-netto-rub   = ABSOLUTE(v-src-sum-netto-rub)                                                      buf_tt-line.summ-brutto      = ABSOLUTE(v-src-sum)                                                             buf_tt-line.summ-brutto-rub  = ABSOLUTE(v-src-sum-rub)                                                             buf_tt-line.unit-base        = v-unit-base                             buf_tt-line.summ-discont     = ABSOLUTE(v-src-discnt)                             buf_tt-line.summ-discont-rub = ABSOLUTE(v-src-discnt-rub)
    14210               .
    14211            end.
    14212            WHEN 1 then do:
    14213            end.
    14214            OTHERWISE DO:
    14215            end.
    14216         end case.
    14217      end.
    14218      assign
    14219         p-ok         = TRUE
    14220      .
    14221   end.
    14222   end procedure.
    14223   define variable vss-include-info290 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14224   procedure prep-lay_get-layout :
    14225   define input parameter p-layout-type as character no-undo .
    14226   define input parameter p-device-type as character no-undo .
    14227   define input parameter p-layout-id as character no-undo .
    14228   define buffer buf_layout for ub.layout.
    14229   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
    14230   define buffer buf_rule-call-param for ub.rule-call-param.
    14231   define buffer buf_temp-layout-elem-rule for temp-layout-elem-rule.
    14232   define buffer buf_temp-rule-call-param for temp-rule-call-param .
    14233   main-block:
    14234   do
    14235   on error undo, return error
    14236   :
    14237     for each buf_temp-layout-elem-rule where buf_temp-layout-elem-rule.layout-id = p-layout-id:
    14238       for each buf_temp-rule-call-param where
    14239               buf_temp-rule-call-param.call_id = buf_temp-layout-elem-rule.uniq-key-rec
    14240       :
    14241         delete buf_temp-rule-call-param.
    14242       end.
    14243       delete buf_temp-layout-elem-rule.
    14244     end.
    14245     find first buf_layout share-lock where
    14246               buf_layout.layout-id = p-layout-id no-error.
    14247     if not available buf_layout
    14248     or buf_layout.sts <> integer('0':U) then do:
    14249       find first buf_layout share-lock where
    14250               buf_layout.layout-type = p-layout-type
    14251           and buf_layout.device-type = p-device-type
    14252           and buf_layout.is-default = integer('1':U) no-error .
    14253       if not available buf_layout then do:
    14254         undo, return error substitute("Не найдено ни один подходящей раскладки типа &1 для &2"
    14255                                     ,p-layout-type
    14256                                     ,p-device-type).
    14257       end.
    14258     end.
    14259     for each buf_layout-elem-rule no-lock where
    14260             buf_layout-elem-rule.layout-id = buf_layout.layout-id
    14261     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14262     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    14263     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    14264     :
    14265       create buf_temp-layout-elem-rule.
    14266       buffer-copy buf_layout-elem-rule to buf_temp-layout-elem-rule.
    14267       for each buf_rule-call-param no-lock where
    14268               buf_rule-call-param.call_id = buf_layout-elem-rule.uniq-key-rec
    14269       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14270       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    14271       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    14272       :
    14273           create buf_temp-rule-call-param.
    14274           buffer-copy buf_rule-call-param to buf_temp-rule-call-param
    14275           assign
    14276           buf_temp-rule-call-param.layout-type = buf_layout.layout-type
    14277           buf_temp-rule-call-param.device-type = buf_layout.device-type
    14278           buf_temp-rule-call-param.mode-id = buf_layout-elem-rule.mode-id
    14279           buf_temp-rule-call-param.widget-id = buf_layout-elem-rule.widget-id
    14280           .
    14281       end.
    14282     end.
    14283   end.
    14284   end procedure.
    14285   procedure set-cd-prop :
    14286   define output  parameter p-message     as character      no-undo .
