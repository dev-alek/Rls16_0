    18378   ON ENTRY OF v-ed-message IN FRAME DEFAULT-FRAME
    18379   DO:
    18380   define variable vss-include-info376 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18381   if lookup(b-exit :type in frame DEFAULT-FRAME
    18382            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
    18383            ) = 0
    18384   then do:
    18385     message
    18386       "$Workfile$"
    18387       "Указанному интерфейсному элементу фокус не может быть передан" skip
    18388       "Интерфейсный элемент" self :name in frame DEFAULT-FRAME skip
    18389       "Тип" self :type in frame DEFAULT-FRAME skip
    18390       "Процедура" this-procedure :file-name skip
    18391       view-as alert-box .
    18392   end.
    18393   else do:
    18394     apply "entry":u to b-exit in frame DEFAULT-FRAME .
    18395     if focus :handle <> b-exit :handle in frame DEFAULT-FRAME then do:
    18396       return no-apply .
    18397     end.
    18398   end.
    18399     undo, return no-apply.
    18400   END.
    18401   ON ENTER OF v-src-input IN FRAME DEFAULT-FRAME
    18402   DO:
    18403     def var v-md as char no-undo .
    18404     def var v-egalite as int initial 0  no-undo .
    18405     def var v-widget-id as char no-undo .
    18406      ASSIGN
    18407         v-src-input
    18408      .
    18409      if substr(v-src-input,1,1) = ";" and
    18410         substr(v-src-input,length(v-src-input),1) = "?"
    18411         then
    18412      do:
    18413        if v-cd-mode = "1"
    18414              OR v-cd-mode = "2" then
    18415        do:
    18416         assign
    18417            v-md = substitute("&1.&2", v-cd-mode, v-cd-submode)
    18418         .
    18419        end.
    18420        else
    18421        do:
    18422         assign
    18423            v-md = v-cd-mode
    18424         .
    18425        end.
    18426        v-egalite = index(v-src-input,"=") .
    18427        if v-egalite = 0 then
    18428        do:
    18429          v-egalite = length(v-src-input)   .
    18430        end.
    18431        v-src-input = substr(v-src-input,2,v-egalite - 2) .
    18432        if v-cd-submode = "0" then
    18433        do:
    18434         find first buf_layout-elem-rule no-lock where
    18435                    buf_layout-elem-rule.layout-id = v-layout-id-screen
    18436                and buf_layout-elem-rule.mode-id   = v-md
    18437                and buf_layout-elem-rule.rule_id = 1998
    18438                no-error.
    18439         if avail buf_layout-elem-rule then
    18440         do:
    18441          v-widget-id  = buf_layout-elem-rule.widget-id .
    18442          RUN rule-run        IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18443                                                , INPUT-OUTPUT v-cd-submode
    18444                                                , INPUT v-widget-id
    18445                                                , INPUT 'th-pos-screen':U
    18446                                                , OUTPUT v-message
    18447                                                , OUTPUT v-ok ) NO-ERROR.
    18448          IF ERROR-STATUS:ERROR  THEN
    18449          DO:
    18450           ASSIGN
    18451            v-ok = FALSE
    18452            .
    18453          END.
    18454          RUN enable_UI IN THIS-PROCEDURE.
    18455          RUN post_enable_UI IN THIS-PROCEDURE.
    18456         end .
    18457        end.
    18458      end.
    18459      ASSIGN
    18460         v-src-input  = IF INDEX(v-src-input, ".":U) > 0 THEN REPLACE(v-src-input,",":U,"":U)
    18461                                                         ELSE REPLACE(v-src-input,",":U,".":U)
    18462         v-delta-time = ETIME - v-etime
    18463         v-etime      = 0
    18464      .
    18465      IF  v-src-input <> "":U
    18466      THEN DO:
    18467         RUN set-input-time IN THIS-PROCEDURE ( INPUT v-delta-time, OUTPUT v-err-message, OUTPUT v-ok ).
    18468         RUN set-src IN THIS-PROCEDURE ( INPUT v-src-input,  OUTPUT v-err-message, OUTPUT v-ok ).
    18469         RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18470                                        , INPUT-OUTPUT v-cd-submode
    18471                                        , INPUT v-src-input:name
    18472                                        , INPUT 'th-pos-screen':U
    18473                                        , OUTPUT v-message
    18474                                        , OUTPUT v-ok ) NO-ERROR.
    18475         IF ERROR-STATUS:ERROR
    18476         THEN DO:
    18477            ASSIGN
    18478               v-ok = FALSE
    18479            .
    18480         END.
    18481         ASSIGN
    18482            v-src-input = "":U
    18483         .
    18484         RUN Enable_Ui IN THIS-PROCEDURE.
    18485         RUN Post_Enable_Ui IN THIS-PROCEDURE.
    18486         RETURN NO-APPLY.
    18487      END.
    18488   END.
    18489   ON VALUE-CHANGED OF v-src-input IN FRAME DEFAULT-FRAME
    18490   DO:
    18491     IF (v-etime = 0)
    18492     THEN DO:
    18493     assign
    18494        v-etime = ETIME
    18495     .
    18496     END.
    18497   END.
    18498   ASSIGN CURRENT-WINDOW                = C-Win
    18499          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
    18500   ON CLOSE OF THIS-PROCEDURE
    18501      RUN disable_UI.
    18502   PAUSE 0 BEFORE-HIDE.
    18503   on any-key OF C-Win ANYWHERE
    18504   do :
    18505      DO
    18506      WITH FRAME DEFAULT-FRAME
    18507      :
    18508      define variable v-old-cd-mode    as character    no-undo.
    18509      define variable v-old-cd-submode    as character    no-undo.
    18510      define variable v-key    as character    no-undo.
    18511      define variable v-c-src-input as char  no-undo .
    18512      assign v-key = string(lastkey)
    18513             v-ok = no .
    18514      if v-layout-id <> '' then
    18515      do:
    18516        find first buf_layout-elem-rule no-lock
    18517                  where buf_layout-elem-rule.layout-id = v-layout-id
    18518                  and buf_layout-elem-rule.widget-id = v-key
    18519                  no-error.
    18520        if avail buf_layout-elem-rule then
    18521        do:
    18522            v-c-src-input = input v-src-input .
    18523            if buf_layout-elem-rule.rule_id = 1978 then
    18524            do:
    18525               RUN set-src IN THIS-PROCEDURE ( INPUT v-c-src-input,
    18526                                               OUTPUT v-err-message,
    18527                                               OUTPUT v-ok ) .
    18528            end.
    18529            RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18530                                            , INPUT-OUTPUT v-cd-submode
    18531                                            , INPUT v-key
    18532                                            , INPUT 'th-pos-keyboard':U
    18533                                            , OUTPUT v-message
    18534                                            , OUTPUT v-ok
    18535                                            ) NO-ERROR
    18536                                           .
    18537            IF ERROR-STATUS:ERROR
    18538            THEN DO:
    18539               ASSIGN
    18540                  v-ok = FALSE
    18541               .
    18542            END.
    18543            if v-ok = no then
    18544               assign
    18545                  v-src-input = ""
    18546                  v-c-src-input = "" .
    18547            if buf_layout-elem-rule.rule_id = 1978 then
    18548            do:
    18549              v-src-input = '' .
    18550            end.
    18551              RUN enable_UI IN THIS-PROCEDURE .
    18552              RUN post_enable_UI IN THIS-PROCEDURE .
    18553              if v-c-src-input <> '' then
    18554              do:
    18555                assign
    18556                  v-src-input = v-c-src-input .
    18557               RUN set-src IN THIS-PROCEDURE ( INPUT v-src-input,
    18558                                               OUTPUT v-err-message,
    18559                                               OUTPUT v-ok ) .
    18560               RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18561                                                , INPUT-OUTPUT v-cd-submode
    18562                                                , INPUT "v-src-input"
    18563                                                , INPUT 'th-pos-screen':U
    18564                                                , OUTPUT v-message
    18565                                                , OUTPUT v-ok ) NO-ERROR.
    18566                IF ERROR-STATUS:ERROR
    18567                THEN DO:
    18568                    ASSIGN
    18569                      v-ok = FALSE
    18570                       .
    18571                END.
    18572                assign v-src-input = "" .
    18573                RUN Enable_Ui IN THIS-PROCEDURE.
    18574                RUN Post_Enable_Ui IN THIS-PROCEDURE.
    18575              end.
    18576              Return no-apply .
    18577        end.
    18578      end.
    18579      assign
    18580         v-key = KEYLABEL(LASTKEY)
    18581      .
    18582      CASE v-key:
    18583         WHEN "CURSOR-UP":U OR
    18584         WHEN "CURSOR-DOWN":U
    18585         THEN DO:
    18586            APPLY "ENTRY":U TO br-line.
    18587            IF NOT AVAILABLE bufbr_tt-line
    18588            THEN DO:
    18589               IF CAN-FIND (tt-line NO-LOCK)
    18590               THEN DO:
    18591                  query br-line :handle :get-first( no-lock ).
    18592                  reposition br-line to rowid rowid( bufbr_tt-line ) no-error.
    18593                  assign
    18594                     v-curr-num = bufbr_tt-line.num
    18595                     v-curr-type = bufbr_tt-line.type
    18596                  .
    18597                  RUN set-curr-num IN THIS-PROCEDURE (INPUT v-curr-type, INPUT v-curr-num, OUTPUT v-message, OUTPUT v-ok).
    18598               END.
    18599            END.
    18600            ELSE DO:
    18601               IF v-key = "CURSOR-UP":U
    18602               THEN DO:
    18603                  query br-line :handle :get-prev( no-lock ).
    18604                  reposition br-line to rowid rowid( bufbr_tt-line ) no-error.
    18605                  assign
    18606                     v-curr-num = bufbr_tt-line.num
    18607                     v-curr-type = bufbr_tt-line.type
    18608                  .
    18609                  RUN set-curr-num IN THIS-PROCEDURE (INPUT v-curr-type, INPUT v-curr-num, OUTPUT v-message, OUTPUT v-ok).
    18610               END.
    18611               ELSE DO:
    18612                  query br-line :handle :get-next( no-lock ).
    18613                  reposition br-line to rowid rowid( bufbr_tt-line ) no-error.
    18614                  assign
    18615                     v-curr-num = bufbr_tt-line.num
    18616                     v-curr-type = bufbr_tt-line.type
    18617                  .
    18618                  RUN set-curr-num IN THIS-PROCEDURE (INPUT v-curr-type, INPUT v-curr-num, OUTPUT v-message, OUTPUT v-ok).
    18619               END.
    18620               CASE bufbr_tt-line.type:
    18621                  WHEN 0
    18622                  THEN DO:
    18623                     assign
    18624                        v-message                = SUBSTITUTE  ( "&1 &2x&3"
    18625                                                               , bufbr_tt-line.line-name
    18626                                                               , bufbr_tt-line.qnty
    18627                                                               , bufbr_tt-line.price
    18628                                                               )
    18629                     .
    18630                  END.
    18631                  WHEN 1
    18632                  THEN DO:
    18633                     assign
    18634                        v-message                = SUBSTITUTE  ( "&1 &2"
    18635                                                               , bufbr_tt-line.line-name
    18636                                                               , bufbr_tt-line.summ-netto
    18637                                                               )
    18638                     .
    18639                  END.
    18640                  OTHERWISE DO:
    18641                  END.
    18642               END CASE.
    18643            END.
    18644         END.
    18645         WHEN "CURSOR-LEFT":U
    18646         THEN DO:
    18647            APPLY "CURSOR-LEFT"  TO br-line .
    18648         END.
    18649         WHEN "CURSOR-RIGHT":U
    18650         THEN DO:
    18651            APPLY "CURSOR-RIGHT"  TO br-line .
    18652         END.
    18653         WHEN "*":U
    18654         THEN DO:
    18655         END.
    18656         WHEN "F1":U OR
    18657         WHEN "F2":U OR
    18658         WHEN "F3":U OR
    18659         WHEN "F4":U OR
    18660         WHEN "F5":U OR
    18661         WHEN "F6":U OR
    18662         WHEN "F7":U OR
    18663         WHEN "F8":U OR
    18664         WHEN "F9":U OR
    18665         WHEN "F10":U OR
    18666         WHEN "F11":U OR
    18667         WHEN "F12":U OR
    18668         WHEN "CTRL-S":U
    18669         THEN DO:
    18670            RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18671                                            , INPUT-OUTPUT v-cd-submode
    18672                                            , INPUT v-key
    18673                                            , INPUT 'th-pos-screen':U
    18674                                            , OUTPUT v-message
    18675                                            , OUTPUT v-ok
    18676                                            ) NO-ERROR.
    18677            IF ERROR-STATUS:ERROR
    18678            THEN DO:
    18679               ASSIGN
    18680                  v-ok = FALSE
    18681               .
    18682            END.
    18683            RUN enable_UI IN THIS-PROCEDURE.
    18684            RUN post_enable_UI IN THIS-PROCEDURE.
    18685         END.
    18686         WHEN "ENTER":U
    18687         THEN DO:
    18688            IF focus:name = "v-src-input":U
    18689            THEN DO:
    18690               APPLY "LEAVE":U TO v-src-input.
    18691               RETURN NO-APPLY.
    18692            END.
    18693            IF focus:name = "v-ed-message":U
    18694            THEN DO:
    18695               RETURN NO-APPLY.
    18696            END.
    18697            RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18698                                            , INPUT-OUTPUT v-cd-submode
    18699                                            , INPUT focus:name
    18700                                            , INPUT 'th-pos-keyboard':U
    18701                                            , OUTPUT v-message
    18702                                            , OUTPUT v-ok
    18703                                            ) NO-ERROR.
    18704            IF ERROR-STATUS:ERROR
    18705            THEN DO:
    18706               ASSIGN
    18707                  v-ok = FALSE
    18708               .
    18709            END.
    18710            RUN enable_UI IN THIS-PROCEDURE.
    18711            RUN post_enable_UI IN THIS-PROCEDURE.
    18712         END.
    18713         OTHERWISE DO:
    18714         END.
    18715      END CASE.
    18716      END.
    18717   end.
    18718   on "*":U OF FRAME DEFAULT-FRAME , v-src-input , br-line do :
    18719      DO
    18720      WITH FRAME DEFAULT-FRAME
    18721      :
    18722         RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18723                                        , INPUT-OUTPUT v-cd-submode
    18724                                        , INPUT "*":U
    18725                                        , INPUT 'th-pos-keyboard':U
    18726                                        , OUTPUT v-message
    18727                                        , OUTPUT v-ok
    18728                                        ) NO-ERROR.
    18729         IF ERROR-STATUS:ERROR
    18730         THEN DO:
    18731               ASSIGN
    18732                  v-ok = FALSE
    18733               .
    18734         END.
    18735         RUN enable_UI IN THIS-PROCEDURE.
    18736         RUN post_enable_UI IN THIS-PROCEDURE.
    18737         RETURN NO-APPLY.
    18738      END.
    18739   END.
    18740   on "DEL":U OF FRAME DEFAULT-FRAME , v-src-input , br-line do :
    18741      DO
    18742      WITH FRAME DEFAULT-FRAME
    18743      :
    18744         RUN rule-run IN THIS-PROCEDURE ( INPUT-OUTPUT v-cd-mode
    18745                                        , INPUT-OUTPUT v-cd-submode
    18746                                        , INPUT "DEL":U
    18747                                        , INPUT 'th-pos-keyboard':U
    18748                                        , OUTPUT v-message
    18749                                        , OUTPUT v-ok
    18750                                        ) NO-ERROR.
    18751         IF ERROR-STATUS:ERROR
    18752         THEN DO:
    18753               ASSIGN
    18754                  v-ok = FALSE
    18755               .
    18756         END.
    18757         RUN enable_UI IN THIS-PROCEDURE.
    18758         RUN post_enable_UI IN THIS-PROCEDURE.
    18759         RETURN NO-APPLY.
    18760      END.
    18761   END.
    18762   procedure proc-alt-shift-f2:
    18763     if not ibs.th.gbl.gbl-var:rcode
    18764   then
    18765     run gbl\inidebug.p .
    18766   end.
    18767   procedure proc-alt-shift-f3:
    18768     run gbl/prvssinf.p
    18769       ( input this-procedure
    18770       ) .
    18771   end.
    18772   define variable v-inform-launched as logical no-undo initial false .
    18773   procedure proc-alt-shift-f4:
    18774     define variable v-action as character no-undo .
    18775     if v-inform-launched = false then do:
    18776       assign
    18777         v-inform-launched = true
    18778       .
    18779       run gbl/d-inform.w
    18780         (  input self
    18781         ,  input this-procedure
    18782         , output v-action
    18783         ) no-error .
    18784       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
    18785       assign
    18786         v-inform-launched = false
    18787       .
    18788     end.
    18789   end.
    18790   procedure proc-alt-f1:
    18791     run gbl/corrhelp.p
    18792       (input this-procedure
    18793       ) .
    18794   end .
    18795   on alt-shift-f2 anywhere do:
    18796     run proc-alt-shift-f2.
    18797   end.
    18798   on alt-shift-f3 anywhere do:
    18799     run proc-alt-shift-f3 in this-procedure .
    18800   end.
    18801   on alt-shift-f4 anywhere do:
    18802     run proc-alt-shift-f4 in this-procedure.
    18803   end.
    18804   on alt-f1 anywhere do:
    18805     run proc-alt-f1 in this-procedure .
    18806   end.
    18807   MAIN-BLOCK:
    18808   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
    18809      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
    18810      IF p-emul
    18811      THEN DO:
    18812         run set-emul-mode IN THIS-PROCEDURE (OUTPUT v-message, OUTPUT v-ok).
    18813      END.
    18814      define buffer buf_user-account      for ub.user-account .
    18815      FIND FIRST buf_user-account
    18816           where buf_user-account.user-id = p-user-id
    18817           no-lock
    18818           .
    18819      ASSIGN
    18820         v-psn-name = SUBSTITUTE ( "&1 &2&3&4&5":U
    18821                                 , buf_user-account.last-name
    18822                                 , SUBSTRING(buf_user-account.first-name, 1, 1)
    18823                                 , IF buf_user-account.first-name <> "":U THEN ".":U ELSE "":U
    18824                                 , SUBSTRING(buf_user-account.second-name, 1, 1)
    18825                                 , IF buf_user-account.first-name <> "":U
    18826                                   AND buf_user-account.second-name <> "":U THEN ".":U ELSE "":U
    18827                                 )
    18828      .
    18829      assign
    18830         C-Win :max-width          = session :width-chars
    18831         C-Win :virtual-width      = session :width-chars
    18832         C-Win :max-height         = session :height-chars
    18833         C-Win :virtual-height     = session :height-chars
    18834      .
    18835       RUN set-cashier IN THIS-PROCEDURE  ( output v-message
    18836                                          , output v-ok
    18837                                          ) .
    18838       if v-ok = no then
    18839       do:
    18840         return .
    18841       end .
    18842       DO
    18843       TRANSACTION
    18844       :
    18845         FIND FIRST buf_cash-desk
    18846              WHERE buf_cash-desk.db-num   = v-cntxt-db-num
    18847                AND buf_cash-desk.obj-code = v-cntxt-obj-code
    18848                AND buf_cash-desk.pos-type = 'IBS-TH':U
    18849                AND buf_cash-desk.cash-num = p-cash-num
    18850              EXCLUSIVE-LOCK
    18851              NO-WAIT
    18852              NO-ERROR
    18853              .
    18854         IF NOT AVAILABLE buf_cash-desk
    18855         THEN DO:
    18856            IF LOCKED buf_cash-desk
    18857            THEN DO:
    18858               message
    18859                  SUBSTITUTE("Касса &1 уже работает", p-cash-num)
    18860                  skip
    18861               view-as alert-box information.
    18862               RETURN.
    18863            END.
    18864            ELSE DO:
    18865               message
    18866                  "Касса №" p-cash-num
    18867                  skip "на объекте" v-cntxt-obj-type v-cntxt-obj-code
    18868                  SKIP "не найдена"
    18869               view-as alert-box information.
    18870               RETURN.
    18871            END.
    18872         END.
    18873         assign
    18874           v-fr-type = buf_cash-desk.fr-type
    18875           .
    18876         find first   buf_cash-desk-attr no-lock where
    18877                       buf_cash-desk-attr.db-num = buf_cash-desk.db-num
    18878                   and buf_cash-desk-attr.obj-code = buf_cash-desk.obj-code
    18879                   and buf_cash-desk-attr.pos-type = buf_cash-desk.pos-type
    18880                   and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
    18881               and buf_cash-desk-attr.upper-attr-code = 'IBS-TH_fisreg':U
    18882               and buf_cash-desk-attr.attr-code = 'com-port':U
    18883           no-error.
    18884        if avail buf_cash-desk-attr then
    18885        do:
    18886         assign
    18887            v-com-port = buf_cash-desk-attr.attr-value-character
    18888         .
    18889        end.
    18890         find first   buf_cash-desk-attr no-lock where
    18891                       buf_cash-desk-attr.db-num = buf_cash-desk.db-num
    18892                   and buf_cash-desk-attr.obj-code = buf_cash-desk.obj-code
    18893                   and buf_cash-desk-attr.pos-type = buf_cash-desk.pos-type
    18894                   and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
    18895     and buf_cash-desk-attr.upper-attr-code = 'IBS-TH_devices':U
    18896     and buf_cash-desk-attr.attr-code = 'keyboard-layout-id':U
    18897           no-error.
    18898        if avail buf_cash-desk-attr then
    18899        do:
    18900         assign
    18901            v-layout-id = buf_cash-desk-attr.attr-value-character
    18902         .
    18903        end.
    18904         find first   buf_cash-desk-attr no-lock where
    18905                       buf_cash-desk-attr.db-num = buf_cash-desk.db-num
    18906                   and buf_cash-desk-attr.obj-code = buf_cash-desk.obj-code
    18907                   and buf_cash-desk-attr.pos-type = buf_cash-desk.pos-type
    18908                   and buf_cash-desk-attr.cash-num = buf_cash-desk.cash-num
    18909     and buf_cash-desk-attr.upper-attr-code = 'IBS-TH_interface':U
    18910     and buf_cash-desk-attr.attr-code = 'screen-layout-id':U
    18911           no-error.
    18912        if avail buf_cash-desk-attr then
    18913        do:
    18914         assign
    18915            v-layout-id-screen = buf_cash-desk-attr.attr-value-character
    18916         .
    18917        end.
    18918       END.
    18919   define variable vss-include-info377 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18920     run mainmenu_getcntxt in parparentproc
    18921       (output v-cntxt-db-num
    18922       ,output v-cntxt-userid
    18923       ,output v-cntxt-level
    18924       ,output v-cntxt-host-code-obj
    18925       ,output v-cntxt-obj-type
    18926       ,output v-cntxt-obj-code
    18927       ,output v-cntxt-db-num-obj
    18928       ,output v-cntxt-is-admin
    18929       ) .
    18930   define variable vss-include-info378 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18931   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_create-context in g#libthpos
    18932     (input  parparentproc
    18933     ,input  ?
    18934     ,input  v-cntxt-db-num
    18935     ,input  v-cntxt-obj-code
    18936     ,input  'IBS-TH':U
    18937     ,input  p-cash-num
    18938     ,output v-serial-code
    18939     ,output v-r-b
    18940     ,output v-base-code
    18941     ) no-error .
    18942      IF ERROR-STATUS:ERROR
    18943      THEN DO:
    18944         message  "Ошибка инициализации кассы IBS TH №"   p-cash-num
    18945            skip "магазина №"                             v-cntxt-obj-code
    18946            skip "БД №"                                   v-cntxt-db-num
    18947            skip RETURN-VALUE
    18948            SKIP error-status :get-message(1)
    18949            SKIP error-status :get-message(2)
    18950            SKIP error-status :get-message(3)
    18951         view-as alert-box information.
    18952         QUIT.
    18953      END.
    18954      run set-cd-base-code in this-procedure (INPUT v-base-code, OUTPUT v-message, OUTPUT v-ok) .
    18955      IF ERROR-STATUS:ERROR
    18956      OR NOT v-ok
    18957      THEN DO:
    18958         assign
    18959            v-ok = no
    18960            v-message = v-err-message
    18961         .
    18962         message
    18963            SKIP RETURN-VALUE
    18964            SKIP trim(error-status :get-message(1))
    18965            SKIP trim(error-status :get-message(2))
    18966            SKIP trim(error-status :get-message(3))
    18967            SKIP v-err-message
    18968         view-as alert-box information.
    18969         RETURN NO-APPLY.
    18970      END.
    18971      IF NOT p-emul
    18972      THEN DO:
    18973   define variable vss-include-info379 as character format "X(65)" no-undo
    18974   initial "@(#)$Workfile$ $Revision$".
    18975   do:
    18976     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-init in g#fr-lib
    18977       ( input  p-cash-num
    18978       , input  v-cntxt-obj-code
    18979       , input  v-serial-code
    18980       , input  v-fr-type
    18981       , input  v-com-port
    18982       , output v-fr-model
    18983       , output v-err-message
    18984       , output v-ok
    18985       ) NO-ERROR .
    18986   end.
    18987         IF ERROR-STATUS:ERROR
    18988         OR NOT v-ok
    18989         THEN DO:
    18990            message
    18991            SKIP RETURN-VALUE
    18992            SKIP trim(error-status :get-message(1))
    18993            SKIP trim(error-status :get-message(2))
    18994            SKIP trim(error-status :get-message(3))
    18995            SKIP v-err-message
    18996            view-as alert-box information.
    18997            RETURN.
    18998         END.
    18999         IF NOT v-ok
    19000         THEN DO:
    19001            assign
    19002               v-message = v-err-message
    19003            .
    19004         END.
    19005         RUN set-context-serial ( INPUT v-serial-code
    19006                                , INPUT v-fr-model
    19007                                , OUTPUT v-message
    19008                                , OUTPUT v-ok
    19009                                ) .
    19010      END.
    19011      RUN set-cd-prop IN THIS-PROCEDURE (OUTPUT v-message, OUTPUT v-ok).
    19012      IF NOT v-ok
    19013      THEN DO:
    19014         message
    19015            v-message
    19016            skip
    19017         view-as alert-box error.
    19018         RETURN.
    19019      END.
    19020      IF NOT p-emul
    19021      THEN DO:
    19022         RUN get-display-adv IN THIS-PROCEDURE  ( OUTPUT v-disp-message-1
    19023                                                , OUTPUT v-disp-message-2
    19024                                                , OUTPUT v-message
    19025                                                , OUTPUT v-ok
    19026                                                ) .
    19027   define variable vss-include-info380 as character format "X(65)" no-undo
    19028   initial "@(#)$Workfile$ $Revision$".
    19029   do:
    19030     if valid-handle( g#sb-lib ) <> TRUE then do:       run gbl/sb-lib.p persistent no-error.       if error-status :error or valid-handle( g#sb-lib ) <> TRUE then do:         message "Error starting sb-lib.p" skip( 0 )           g#sb-lib                        skip( 0 )           g#sb-lib    :type               skip( 0 )           g#sb-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run sb-init in g#sb-lib
    19031       ( input  v-cashless-system
    19032       , output v-err-message
    19033       , output v-ok
    19034       ) NO-ERROR .
    19035   end.
    19036         IF ERROR-STATUS:ERROR
    19037         OR NOT v-ok
    19038         THEN DO:
    19039            message
    19040            SKIP RETURN-VALUE
    19041            SKIP trim(error-status :get-message(1))
    19042            SKIP trim(error-status :get-message(2))
    19043            SKIP trim(error-status :get-message(3))
    19044            SKIP v-err-message
    19045            view-as alert-box information.
    19046            RETURN NO-APPLY.
    19047         END.
    19048         IF v-customer-display-plug
    19049         THEN DO:
    19050   define variable vss-include-info381 as character format "X(65)" no-undo
    19051   initial "@(#)$Workfile$ $Revision$".
    19052   do:
    19053     if valid-handle( g#disp-lib ) <> TRUE then do:       run gbl/disp-lib.p persistent no-error.       if error-status :error or valid-handle( g#disp-lib ) <> TRUE then do:         message "Error starting disp-lib.p" skip( 0 )           g#disp-lib                        skip( 0 )           g#disp-lib    :type               skip( 0 )           g#disp-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run disp-init in g#disp-lib
    19054       ( input  v-disp-message-1
    19055       , input  v-disp-message-2
    19056       , input  v-customer-display-type
    19057       , input  v-customer-display-port
    19058       , output v-message
    19059       , output v-ok
    19060       ) NO-ERROR .
    19061   end.
    19062            IF ERROR-STATUS:ERROR
    19063            OR NOT v-ok
    19064            THEN DO:
    19065               message
    19066               SKIP RETURN-VALUE
    19067               SKIP trim(error-status :get-message(1))
    19068               SKIP trim(error-status :get-message(2))
    19069               SKIP trim(error-status :get-message(3))
    19070               SKIP v-err-message
    19071               view-as alert-box information.
    19072               RETURN NO-APPLY.
    19073            END.
    19074         END.
    19075      END.
    19076      RUN fill-tt IN THIS-PROCEDURE.
    19077      RUN cd-context ( INPUt-OUTPUT v-cd-mode
    19078                     , INPUt-output v-cd-submode
    19079                     , output v-message
    19080                     , output v-ok
    19081                     ) .
    19082      RUN annul-lost-chk IN THIS-PROCEDURE ( output v-message
    19083                                           , output v-ok
    19084                                           ) .
    19085      IF NOT v-ok
    19086      THEN DO:
    19087         message
    19088            v-message
    19089            skip
    19090         view-as alert-box error.
    19091      END.
    19092      RUN enable_UI IN THIS-PROCEDURE.
    19093      C-Win :HEIGHT-CHARS = C-Win :FULL-HEIGHT-CHARS.
    19094      C-Win :width-CHARS = C-Win :FULL-width-CHARS.
    19095      C-Win :X = session:WORK-AREA-X.
    19096      C-Win :Y = session:WORK-AREA-Y.
    19097      apply "window-resized":U to c-win.
    19098      RUN post_enable_UI IN THIS-PROCEDURE.
    19099   define variable vss-include-info382 as character format "X(65)" no-undo
    19100   initial "@(#)$Workfile$ $Revision$".
    19101   do:
    19102     if valid-handle( g#disp-lib ) <> TRUE then do:       run gbl/disp-lib.p persistent no-error.       if error-status :error or valid-handle( g#disp-lib ) <> TRUE then do:         message "Error starting disp-lib.p" skip( 0 )           g#disp-lib                        skip( 0 )           g#disp-lib    :type               skip( 0 )           g#disp-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run disp-str in g#disp-lib
    19103       ( INPUT  v-cashier-name
    19104       , INPUT  '':U
    19105       , output v-err-message
    19106       , output v-ok
    19107       ) NO-ERROR .
    19108   end.
    19109      IF NOT THIS-PROCEDURE:PERSISTENT THEN
    19110         WAIT-FOR CLOSE OF THIS-PROCEDURE FOCUS v-src-input.
    19111      RELEASE buf_cash-desk.
    19112   END.
    19113   PROCEDURE control_load :
    19114   DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
    19115   DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.
    19116   OCXFile = SEARCH( "exe\wrx\gbl\maincash.wrx":U ).
    19117   IF OCXFile = ? THEN
    19118     OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
    19119                        R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U) + "wrx":U).
    19120   IF OCXFile <> ? THEN
    19121   DO:
    19122     ASSIGN
    19123       chCtrlFrame = CtrlFrame:COM-HANDLE
    19124       UIB_S = chCtrlFrame:LoadControls( OCXFile, "CtrlFrame":U)
    19125       CtrlFrame:NAME = "CtrlFrame":U
    19126     .
    19127     RUN initialize-controls IN THIS-PROCEDURE NO-ERROR.
    19128   END.
    19129   ELSE MESSAGE "exe\wrx\gbl\maincash.wrx":U SKIP(1)
    19130                "The binary control file could not be found. The controls cannot be loaded."
    19131                VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".
    19132   END PROCEDURE.
    19133   PROCEDURE disable_UI :
    19134     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
    19135     THEN DELETE WIDGET C-Win.
    19136     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
    19137   END PROCEDURE.
    19138   PROCEDURE enable_UI :
    19139     RUN control_load.
    19140     DISPLAY v-src-label v-date v-ed-message v-mode-name v-label-balance v-card-num
    19141             v-client-name v-chk-num v-src-input v-balance v-time v-total
    19142             v-discount v-payment v-disc-pay v-dop-mess
    19143         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
    19144     ENABLE v-src-label v-date v-ed-message v-mode-name v-label-balance v-card-num
    19145            v-client-name v-chk-num v-src-input f1 br-line f2 f3 f4 f5 f6 f7 f8 f9
    19146            f10 f11 f12 v-balance v-time v-total v-discount v-payment b-exit
    19147            v-disc-pay v-dop-mess RECT-1 RECT-4 RECT-5 RECT-6
    19148         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
    19149     OPEN QUERY br-line FOR EACH bufbr_tt-line.
    19150     VIEW C-Win.
    19151   END PROCEDURE.
    19152   PROCEDURE post_enable_UI :
    19153   do
    19154   on error undo, LEAVE
    19155   :
    19156      define variable v-ok-local          as logical      no-undo.
    19157      define variable v-widget      as handle       no-undo.
    19158      define variable v-label       as character    no-undo.
    19159      define variable v-tooltip       as character    no-undo.
    19160      define variable v-cd-subname  as character    no-undo.
    19161      define variable v-ccc    as character    no-undo.
    19162      define variable v-message-local    as character    no-undo.
    19163      define buffer buf_tt-line     for tt-line .
    19164      RUN get-mode-name IN THIS-PROCEDURE ( INPUT v-cd-mode
    19165                                        , INPUT v-cd-submode
    19166                                        , OUTPUT v-mode-name
    19167                                        , OUTPUT v-ok-local
    19168                                        ) .
    19169       define variable v-title as character no-undo .
    19170       define variable v-version-name as character no-undo .
    19171       define variable v-version-name-str as character no-undo .
    19172       define variable v-host-str         as character no-undo .
    19173       define variable v-obj-str          as character no-undo .
    19174       define variable v-user-str         as character no-undo .
    19175       define variable v-db-num-str       as character no-undo .
    19176       define variable v-user-id-str      as character no-undo .
    19177       define variable v-process-id-str   as character no-undo .
    19178       run gbl/getvers.p
    19179         (output v-version-name
    19180         ) .
    19181       assign
    19182         v-version-name-str = substitute("ITH &1", v-version-name)
    19183       .
    19184       assign
    19185         v-db-num-str = substitute("БД: &1", v-cntxt-db-num)
    19186       .
    19187       assign
    19188         v-user-id-str = substitute("Кассир: &1", v-psn-name)
    19189       .
    19190       assign
    19191         v-host-str = substitute("Фирма: &1 &2"
    19192                                 ,'орг':U
    19193                                 ,v-cntxt-host-code-obj
    19194                                 )
    19195       .
    19196       assign
    19197         v-obj-str = substitute("Объект: &1 &2"
    19198                               ,v-cntxt-obj-type
    19199                               ,v-cntxt-obj-code
    19200                               )
    19201       .
    19202       assign
    19203         v-title = substitute('Касса IBS TH POS &1, &2, &3, &4, &5, &6, PID &7':U
    19204                             ,p-cash-num
    19205                             ,v-db-num-str
    19206                             ,v-host-str
    19207                             ,v-obj-str
    19208                             ,v-user-id-str
    19209                             ,v-version-name-str
    19210                             ,p-pid
    19211                             )
    19212       .
    19213      ASSIGN
    19214         C-Win:TITLE = v-title
    19215      .
    19216      RUN get-submode-name IN THIS-PROCEDURE ( INPUT v-cd-mode
    19217                                          , INPUT v-cd-submode
    19218                                          , OUTPUT v-cd-subname
    19219                                          , OUTPUT v-ok-local
    19220                                          ) .
    19221      ASSIGN
    19222         v-src-label:screen-value IN FRAME DEFAULT-FRAME = f_src-label(v-cd-subname)
    19223      .
    19224      RUN get-chk-num  IN THIS-PROCEDURE  ( OUTPUT v-chk-num
    19225                                          , OUTPUT v-ok-local
    19226                                          ) .
    19227      run get-aux-mess in this-procedure (
    19228                                             output v-dop-mess
    19229                                           , OUTPUT v-ok-local
    19230                                           ).
    19231      RUN get-card-num ( OUTPUT v-card-num
    19232                       , OUTPUT v-client-name
    19233                       , OUTPUT v-ok-local
    19234                       ) .
    19235      IF v-cd-mode = "1"
    19236      OR v-cd-mode = "2"
    19237      THEN DO:
    19238         RUN summ-for-pay  ( INPUt-OUTPUT v-cd-mode
    19239                           , INPUt-output v-cd-submode
    19240                           , output v-message-local
    19241                           , output v-ok-local
    19242                           ) .
    19243      END.
    19244      IF  v-cd-mode <> "0"
    19245      AND v-cd-mode <> "4"
    19246      THEN DO:
    19247         RUN get-all-summ (  OUTPUT v-total
    19248                           , OUTPUT v-summ-nett
    19249                           , OUTPUT v-discount
    19250                           , OUTPUT v-payment
    19251                           , OUTPUT v-summ-fr-1
    19252                           , OUTPUT v-summ-for-pay
    19253                           , OUTPUT v-disc-pay
    19254                           , OUTPUT v-message-local
    19255                           , OUTPUT v-ok-local
    19256                           ) .
    19257      END.
    19258      IF v-summ-for-pay = 0
    19259      THEN DO:
    19260         ASSIGN
    19261            v-summ-for-pay =  IF v-cd-mode = "2" THEN v-payment - v-summ-nett
    19262                                                            ELSE v-summ-nett - v-payment
    19263         .
    19264      END.
    19265      IF  v-payment = 0
    19266      AND v-cd-mode = "0"
    19267      THEN DO:
    19268         ASSIGN
    19269            v-summ-for-pay = 0
    19270         .
    19271      END.
    19272      ASSIGN
    19273         v-label-balance = IF v-cd-mode = "2" THEN IF (v-summ-for-pay) > 0 THEN "Сдача:" ELSE "К оплате:"
    19274                                                         ELSE IF (v-summ-for-pay) < 0 THEN "Сдача:" ELSE "К оплате:"
    19275         v-balance = ABS(v-summ-for-pay)
    19276      .
    19277      RUN get-curr-num ( OUTPUT v-curr-type
    19278                       , OUTPUT v-curr-num
    19279                       , OUTPUT v-message-local
    19280                       , OUTPUT v-ok-local
    19281                       ) .
    19282      IF v-curr-num <> 0
    19283      THEN DO:
    19284         find first buf_tt-line
    19285            where buf_tt-line.num  = v-curr-num
    19286              AND buf_tt-line.type = v-curr-type
    19287            no-lock
    19288            no-error
    19289            .
    19290         IF AVAILABLE buf_tt-line
    19291         THEN DO:
    19292            reposition br-line to rowid rowid( buf_tt-line ) no-error.
    19293         END.
    19294      END.
    19295      CASE v-cd-mode:
    19296         WHEN "1" OR
    19297         WHEN "2" THEN DO:
    19298            IF v-cd-submode = "7"
    19299            AND AVAILABLE bufbr_tt-line
    19300            THEN DO:
    19301               ASSIGN
    19302                  v-src-input = trim(STRING(bufbr_tt-line.price, "->>>>>>>>9.99"))
    19303               .
    19304            END.
    19305         END.
    19306         OTHERWISE DO:
    19307         END.
    19308      END CASE.
    19309      run get-disc-type IN THIS-PROCEDURE ( OUTPUT v-disc-type
    19310                                          , OUTPUT v-message-local
    19311                                          , OUTPUT v-ok-local
    19312                                          ) .
    19313      CASE v-disc-type:
    19314         WHEN '10':U
    19315         THEN DO:
    19316            assign
    19317               v-src-label:screen-value IN FRAME DEFAULT-FRAME = f_src-label("Сумма скидки")
    19318            .
    19319         END.
    19320         WHEN '1':U
    19321         THEN DO:
    19322            assign
    19323               v-src-label:screen-value IN FRAME DEFAULT-FRAME = f_src-label("Процент скидки")
    19324            .
    19325         END.
    19326         OTHERWISE DO:
    19327         END.
    19328      END CASE.
    19329      DISPLAY
    19330         v-src-input
    19331         v-chk-num
    19332         v-dop-mess
    19333         v-card-num
    19334         v-client-name
    19335         v-payment
    19336         v-total
    19337         v-balance
    19338         v-discount
    19339         v-disc-pay
    19340         v-label-balance
    19341         v-mode-name
    19342      WITH FRAME DEFAULT-FRAME.
    19343      IF v-message <> "":U
    19344      THEN DO:
    19345         run p_ed-msgs(input v-message, input v-ok) no-error.
    19346      END.
    19347      assign
    19348         v-widget = FRAME DEFAULT-FRAME:FIRST-CHILD
    19349         v-widget = v-widget:FIRST-CHILD
    19350      .
    19351      DO WHILE  VALID-HANDLE(v-widget)
    19352      :
    19353         IF  v-widget:TYPE = "BUTTON":U
    19354         THEN DO:
    19355            RUN key-enable IN THIS-PROCEDURE ( INPUT v-cd-mode
    19356                                             , INPUT v-cd-submode
    19357                                             , INPUT v-widget:NAME
    19358                                             , OUTPUT v-ok-local
    19359                                             , OUTPUT v-label
    19360                                             , OUTPUT v-tooltip
    19361                                             ) NO-ERROR.
    19362            IF v-ok-local
    19363            AND ERROR-STATUS:ERROR = FALSE
    19364            THEN DO:
    19365               ASSIGN
    19366                  v-widget:SENSITIVE = TRUE
    19367                  v-widget:LABEL = v-label
    19368                  v-widget:tooltip = v-tooltip
    19369               .
    19370            END.
    19371            ELSE DO:
    19372               ASSIGN
    19373                  v-widget:SENSITIVE = FALSE
    19374                  v-widget:LABEL     = v-widget:NAME
    19375               .
    19376            END.
    19377         END.
    19378         assign
    19379            v-widget = v-widget:NEXT-SIBLING
    19380         .
    19381      END.
    19382   end.
    19383   IF ERROR-STATUS:ERROR
    19384   THEN DO:
    19385      message
    19386         202 v-message-local
    19387         skip RETURN-VALUE
    19388         SKIP error-status :get-message(1)
    19389      view-as alert-box error.
    19390   END.
    19391   apply 'entry':U to v-src-input.
    19392   END PROCEDURE.
    19393   PROCEDURE p_ed-msgs :
    19394   define input parameter p-msgs as character no-undo.
    19395   define input parameter p-ok  as logical no-undo.
    19396   v-ed-message:screen-value in frame DEFAULT-FRAME = p-msgs.
    19397   if p-ok then v-ed-message:FGCOLOR in frame DEFAULT-FRAME = Black_COLOR.
    19398   else if p-ok  = no then  v-ed-message:FGCOLOR in frame DEFAULT-FRAME = RED_COLOR.
    19399    IF LENGTH(p-msgs) > 38
    19400         OR INDEX(v-ed-message, chr(10)) > 0
    19401    THEN v-ed-message:FONT  = v-font-ed-msgs_small.
    19402    else v-ed-message:FONT  = v-font-ed-msgs_big .
    19403   END PROCEDURE.
    19404   FUNCTION f_src-label RETURNS CHARACTER
    19405     ( vf-src-label as char ) :
    19406   if  vf-src-label > "" then do:
    19407       return fill(" ":U,38 - length(vf-src-label)) + vf-src-label  + ':':U.
    19408   end.
    19409     RETURN "".
    19410   END FUNCTION.
