      912   procedure add-cdm :
      913   define input parameter p-cd-mode as character          no-undo.
      914   define input parameter p-name as character        no-undo.
      915   define input parameter p-next as character        no-undo.
      916   define input parameter p-btns as character        no-undo.
      917   do
      918   on error undo, return error
      919   :
      920      create tt-cdm.
      921      assign
      922         tt-cdm.cd-mode       = p-cd-mode
      923         tt-cdm.cdm-name       = p-name
      924         tt-cdm.cdm-next-modes = p-next
      925         tt-cdm.cdm-btns       = p-btns
      926      .
      927   end.
      928   end procedure.
      929   procedure add-key-func :
      930   define input parameter p-cdm         as character        no-undo .
      931   define input parameter p-cdsm        as character        no-undo .
      932   define input parameter p-name        as character        no-undo .
      933   define input parameter p-label       as character        no-undo .
      934   define input parameter p-func        as character        no-undo .
      935   define input parameter p-cng-context as LOGICAL          no-undo .
      936   define input parameter p-func-param  as character        no-undo .
      937   do
      938   on error undo, return error
      939   :
      940      create tt-func-key.
      941      assign
      942         tt-func-key.cd-mode     = p-cdm
      943         tt-func-key.cd-submode  = p-cdsm
      944         tt-func-key.key-name    = p-name
      945         tt-func-key.key_label   = p-label
      946         tt-func-key.key_func    = p-func
      947         tt-func-key.cng-context = p-cng-context
      948         tt-func-key.func-param  = p-func-param
      949      .
      950   end.
      951   end procedure.
      952   procedure shift-open :
      953   define output        parameter p-message     as character      no-undo .
      954   define output        parameter p-ok          as logical          no-undo.
      955   do
      956   on error undo, return error
      957   :
      958      if not v-emul-mode
      959         then do:
      960   define variable vss-include-info14 as character format "X(65)" no-undo
      961   initial "@(#)$Workfile$ $Revision$".
      962   do:
      963     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-shtop in g#fr-lib
      964       ( output       p-message
      965       , output       p-ok
      966       ) no-error .
      967   end.
      968         if error-status:error
      969         then do:
      970            assign
      971               p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
      972               p-ok = FALSE
      973            .
      974         end.
      975      end.
      976      else do:
      977         assign
      978            p-ok = TRUE
      979         .
      980      end.
      981   end.
      982   end procedure.
