     6859   procedure set-input-time :
     6860   define input      parameter p-time as INTEGER        no-undo.
     6861   define output     parameter p-message     as character      no-undo .
     6862   define output     parameter p-ok          as logical          no-undo.
     6863   do
     6864   on error undo, return error
     6865   :
     6866      assign
     6867         v-input-time = p-time
     6868      .
     6869      if p-time > 500
     6870      then do:
     6871         assign
     6872            v-pass-gds = 1
     6873         .
     6874      end.
     6875      else do:
     6876         if p-time < 0
     6877         then do:
     6878            assign
     6879               v-pass-gds = -1
     6880            .
     6881         end.
     6882         else do:
     6883            assign
     6884               v-pass-gds = 0
     6885            .
     6886         end.
     6887      end.
     6888   end.
     6889   end procedure.
     6890   procedure clear-tt-chk :
     6891   define buffer buf_tt-head-check     for tt-head-check .
     6892   define buffer buf_tt-line           for tt-line .
     6893   define buffer buf_tt-open-check     for tt-open-check .
     6894   do
     6895   on error undo, return error
     6896   :
     6897      EMPTY TEMP-TABLE buf_tt-head-check.
     6898      EMPTY TEMP-TABLE buf_tt-line.
     6899      EMPTY TEMP-TABLE buf_tt-open-check.
     6900      assign
     6901         v-src                = ""
     6902         v-src-qnty           = 0
     6903         v-curr-num-0         = 0
     6904         v-curr-type-0        = 0
     6905         v-input-time         = 0
     6906         v-pay-type           = ?
     6907         v-curr-base-code     = v-cd-base-code
     6908         v-d-card             = ""
     6909         v-cli-type           = ""
     6910         v-cli-code           = 0
     6911         v-obj-name           = ""
     6912         v-summ-netto         = 0
     6913         v-summ-brutto        = 0
     6914         v-summ-discont       = 0
     6915         v-summ-netto-rub     = 0
     6916         v-summ-brutto-rub    = 0
     6917         v-summ-discont-rub   = 0
     6918         v-discnt-chk         = 0
     6919         v-summ-pay           = 0
     6920         v-summ-pay-rub       = 0
     6921         v-disc-type          = "":U
     6922         v-with-context       = TRUE
     6923         v-num                = 0
     6924         v-ord-chk-num        = "":U
     6925         v-ord-line-num       = 0
     6926         v-aux-mess           = ''
     6927      .
     6928   end.
