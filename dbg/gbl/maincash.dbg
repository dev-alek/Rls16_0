      210   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      211                                                       ,input p-range-type as character
      212                                                       ,input p-code as integer):
      213   define variable v-seq-val as integer no-undo .
      214   define buffer buf_code-range for ub.code-range.
      215   find first buf_code-range no-lock where
      216             buf_code-range.db-num = p-db-num
      217       and  buf_code-range.range-type = p-range-type
      218       and  buf_code-range.stts = 'u'
      219       and buf_code-range.first-code <= p-code
      220       and buf_code-range.last-code >= p-code no-error .
      221   if available buf_code-range then return yes.
      222   CASE p-range-type:
      223     when 'pngb':U then do:
      224       v-seq-val = current-value(s-pngb-code, ub).
      225     end.
      226     when 'fmgb':U then do:
      227       v-seq-val = current-value(s-fmgb-code, ub).
      228     end.
      229   END CASE.
      230   if p-code <= v-seq-val then do:
      231     find first buf_code-range no-lock where
      232               buf_code-range.db-num = p-db-num
      233         and  buf_code-range.range-type = p-range-type
      234         and  buf_code-range.stts = 'a'
      235         and buf_code-range.first-code <= p-code
      236         no-error .
      237    if available buf_code-range then return yes.
      238   end.
      239   find first buf_code-range no-lock where
      240             buf_code-range.db-num = p-db-num
      241       and  buf_code-range.range-type = p-range-type
      242       and  buf_code-range.stts = 'f'
      243       and buf_code-range.first-code <= p-code
      244       and buf_code-range.last-code >= p-code
      245       no-error .
      246   if available buf_code-range then return yes.
      247   return no.
      248   END FUNCTION.
      249   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      250                                                       ,input p-range-type as character
      251                                                       ,input p-code as integer):
      252   define variable v-seq-val as integer no-undo .
      253   define buffer buf_code-range for ub.code-range.
      254   CASE p-range-type:
      255     when 'pngb':U then do:
      256       v-seq-val = current-value(s-pngb-code, ub).
      257     end.
      258     when 'fmgb':U then do:
      259       v-seq-val = current-value(s-fmgb-code, ub).
      260     end.
      261   END CASE.
      262   if p-code <= v-seq-val then do:
      263     find first buf_code-range no-lock where
      264               buf_code-range.db-num = p-db-num
      265         and  buf_code-range.range-type = p-range-type
      266         and buf_code-range.first-code <= p-code
      267         and buf_code-range.last-code >= p-code no-error .
      268     if available buf_code-range then return yes.
      269   end.
      270   return no.
      271   END FUNCTION.
      272   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      273                                                       ,input p-db-num as integer
      274                                                       ,input p-staff-code as integer
      275                                                       ,input p-date as date
      276                                                        ):
      277   define buffer buf_staff for ub.staff.
      278   if p-date = ? then do:
      279     p-date = today .
      280   end.
      281   find first buf_staff no-lock where
      282             buf_staff.role = p-role
      283         and buf_staff.role-level = 'db':U
      284         and buf_staff.db-num = p-db-num
      285         and buf_staff.staff-code = p-staff-code
      286         and buf_staff.date-end >= p-date use-index pi  no-error .
      287   if available buf_staff then do:
      288     return buf_staff.psn-code.
      289   end.
      290   return 0.
      291   end FUNCTION.
      292   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      293                                                             ,input p-db-num as integer
      294                                                             ,input p-date as date
      295                                                                 ):
      296   define buffer buf_staff for ub.staff.
      297   define buffer buf2_staff for ub.staff.
      298   if p-date = ? then do:
      299     p-date = today .
      300   end.
      301   for each  buf_staff no-lock where
      302             buf_staff.role = p-role
      303         and buf_staff.db-num = p-db-num,
      304   first buf2_staff no-lock where
      305         buf2_staff.role = p-role
      306     and buf2_staff.role-level = 'db':U
      307     and buf2_staff.staff-code = buf_staff.staff-code
      308     and buf2_staff.date-start <= p-date
      309     and buf2_staff.date-end >= p-date
      310   by buf_staff.staff-code
      311   by date-start descending:
      312     return buf_staff.staff-code.
      313   end.
      314   end FUNCTION.
      315   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      316                                                  ,input p-db-num as integer
      317                                                  ,input p-psn-code as integer
      318                                                  ,input p-date as date
      319                                                  ,output p-c-password as character
      320                                                        ):
      321   define buffer buf_staff for ub.staff.
      322   if p-date = ? then do:
      323     p-date = today .
      324   end.
      325   find first buf_staff no-lock where
      326             buf_staff.role = p-role
      327         and buf_staff.role-level = 'db':U
      328         and buf_staff.db-num = p-db-num
      329        and buf_staff.date-end >= p-date
      330        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      331   if available buf_staff
      332   then do:
      333     assign
      334     p-c-password = buf_staff.password.
      335     return buf_staff.staff-code.
      336   end.
      337   p-c-password = ''.
      338   return 0.
      339   end FUNCTION.
      340   FUNCTION gbclcode-is-psn-role returns integer (
      341                                                 input p-role as character
      342                                                 ,input p-psn-code as integer
      343                                                 ,input p-date as date
      344                                                     ):
      345   define buffer buf_staff for ub.staff.
      346   if p-date = ? then do:
      347     p-date = today .
      348   end.
      349   for each buf_staff no-lock where
      350             buf_staff.psn-code = p-psn-code
      351        and  buf_staff.role = p-role
      352   by buf_staff.role-level
      353   by buf_staff.date-start
      354        :
      355     if  buf_staff.date-start <= p-date and
      356     buf_staff.date-end >= p-date  then do:
      357       return buf_staff.staff-code.
      358     end.
      359   end.
      360   return 0.
      361   end FUNCTION.
      362   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      363   define variable v-role-name as character no-undo .
      364   assign
      365   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      366   no-error .
      367   return v-role-name.
      368   END.
      369   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   FUNCTION gbclcode-get-position returns character ( input p-role as character
      371                                                     ,input p-role-level as character
      372                                                     ,input p-work-place as character
      373                                                     ,input p-staff-code as integer
      374                                                                ):
      375   define variable v-role-name as character no-undo .
      376   define variable v-role-level as character no-undo .
      377   define variable v-staff-code as integer no-undo .
      378   assign
      379   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      380   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      381   v-staff-code = p-staff-code
      382   no-error .
      383   return substitute("&1, &2, Код &3"
      384                   ,v-role-name
      385                   ,v-role-level
      386                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      387   END.
      388   FUNCTION gbclcode-get-work-place returns character (
      389                                                   input p-role as character
      390                                                  ,input p-role-level as character
      391                                                  ,input p-db-num as integer
      392                                                  ,input p-host-code as integer
      393                                                  ,input p-obj-type as character
      394                                                  ,input p-obj-code as integer
      395                                                  ) :
      396   define variable v-work-place as character no-undo .
      397   define variable v-obj-type as character no-undo .
      398     case p-role-level:
      399       when 'db':U then do:
      400         v-work-place = string(p-db-num, "99999").
      401       end.
      402       when 'firm':U then do:
      403         v-work-place = string(p-host-code, "99999").
      404       end.
      405       when 'object':U then do:
      406         assign
      407         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      408         .
      409       end.
      410     END CASE.
      411     return v-work-place.
      412   END FUNCTION.
      413   FUNCTION gbclcode-get-level-last-code returns integer (
      414                                                           input p-role as character
      415                                                         , input p-role-level as character
      416                                                         , input p-work-place as character
      417                                                         , input p-date-start as date
      418                                                         ):
      419   DEFINE VARIABLE v-today as date no-undo .
      420   define buffer buf_staff for ub.staff.
      421   if p-work-place = chr(63) then return ?.
      422   if p-date-start = ? then do:
      423     v-today = today .
      424   end.
      425   else do:
      426     v-today = p-date-start.
      427   end.
      428   find last buf_staff no-lock where
      429             buf_staff.role = p-role
      430        and  buf_staff.role-level = p-role-level
      431        and  buf_staff.work-place = p-work-place
      432        and  buf_staff.date-start <= v-today + 1
      433        and  buf_staff.date-end >= v-today + 1
      434        use-index pi  no-error .
      435   if available buf_staff
      436   then return buf_staff.staff-code.
      437   return 0.
      438   end FUNCTION.
      439   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      440   procedure cur-time :
      441      define output parameter p-today as date      no-undo .
      442      define output parameter p-time  as integer   no-undo .
      443     do
      444     on error undo, return error
      445     :
      446       define variable v-date1 as date      no-undo .
      447       define variable v-date2 as date      no-undo .
      448       define variable v-time  as integer   no-undo .
      449       assign
      450         v-date1 = today
      451         v-time  = time
      452         v-date2 = today
      453       .
      454       if v-date1 <> v-date2
      455       then do:
      456         assign
      457           v-date1 = today
      458           v-time  = v-time
      459         .
      460       end.
      461       assign
      462         p-today = v-date1
      463         p-time  = v-time
      464       .
      465     end.
      466   end.
      467   function cur-time-date returns character
      468   :
      469     return string(today, '99/99/9999':U) .
      470   end.
      471   function cur-time-mjd returns decimal
      472   :
      473     define variable v-date as date      no-undo .
      474     define variable v-time as integer   no-undo .
      475     run cur-time in this-procedure
      476       (output v-date
      477       ,output v-time
      478       ) .
      479     return integer(v-date) - 2400002 + (v-time / 86400) .
      480   end.
      481   function cur-time-get-ending-index returns integer
      482   (input p-number as integer
      483   )
      484   :
      485     if p-number < 0
      486     or p-number = ?
      487     then do:
      488       return 1 .
      489     end.
      490     define variable v-rest as integer   no-undo .
      491     assign
      492       p-number = p-number modulo 100
      493     .
      494     if p-number < 20
      495     then do:
      496       assign
      497         v-rest = p-number
      498       .
      499     end.
      500     else do:
      501       assign
      502         v-rest = p-number modulo 10
      503       .
      504     end.
      505     case v-rest :
      506       when 1
      507       then do:
      508         return 2 .
      509       end.
      510       when 2 or
      511       when 3 or
      512       when 4
      513       then do:
      514         return 3 .
      515       end.
      516       otherwise do:
      517         return 1 .
      518       end.
      519     end case .
      520   end.
      521   procedure cur-time-mjd-to-date :
      522      define input  parameter i-mjd-diff as decimal no-undo.
      523      define output parameter o-Date     as date    no-undo.
      524      define output parameter o-Time     as integer no-undo.
      525      define variable v-day-number as integer   no-undo .
      526      if    i-mjd-diff < 0
      527         or i-mjd-diff = ?
      528      then do:
      529         return "?" .
      530      end.
      531      assign
      532         v-day-number = truncate(i-mjd-diff,0).
      533         o-Date = date(v-day-number + 2400002).
      534         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      535     .
      536   end.
      537   function cur-time-mjd-to-string returns character
      538   (input p-mjd-diff as decimal
      539   )
      540   :
      541     define variable v-day-number as integer   no-undo .
      542     define variable v-seconds    as integer   no-undo .
      543     define variable v-hour       as integer   no-undo .
      544     define variable v-min        as integer   no-undo .
      545     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      546     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      547     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      548     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      549     if p-mjd-diff < 0
      550     or p-mjd-diff = ?
      551     then do:
      552       return "?" .
      553     end.
      554     assign
      555       v-day-number = integer(truncate(p-mjd-diff,0))
      556       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      557     .
      558     if v-seconds > 86400
      559     then do:
      560       assign
      561         v-seconds = 86400 - 1
      562       .
      563     end.
      564     if v-seconds < 0
      565     then do:
      566       assign
      567         v-seconds = 0
      568       .
      569     end.
      570     assign
      571       v-hour = truncate(v-seconds / 3600, 0)
      572     .
      573     assign
      574       v-seconds = v-seconds modulo 3600
      575     .
      576     assign
      577       v-min = truncate(v-seconds / 60, 0)
      578     .
      579     assign
      580       v-seconds = v-seconds modulo 60
      581     .
      582     return
      583         (if v-day-number <> 0
      584           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      585           else ""
      586         )
      587       + (if v-day-number <> 0 or v-hour <> 0
      588           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      589           else ""
      590         )
      591       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      592           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      593           else ""
      594         )
      595       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      596       .
      597   end.
      598   function cur-time-string returns character
      599   :
      600     define variable v-date as date      no-undo .
      601     define variable v-time as integer   no-undo .
      602     run cur-time in this-procedure
      603       (output v-date
      604       ,output v-time
      605       ) .
      606     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      607   end.
      608   function cur-time-string-sec returns character
      609   :
      610     define variable v-date as date      no-undo .
      611     define variable v-time as integer   no-undo .
      612     run cur-time in this-procedure
      613       (output v-date
      614       ,output v-time
      615       ) .
      616     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      617   end.
      618   function cur-time-custom  returns character
      619   (input p-prefix as character
      620   ,input p-date-format as character
      621   ,input p-delimiter as character
      622   ,input p-time-format as character
      623   ,input p-suffix as character
      624   )
      625   :
      626     define variable v-date as date      no-undo .
      627     define variable v-time as integer   no-undo .
      628     run cur-time in this-procedure
      629       (output v-date
      630       ,output v-time
      631       ) .
      632     return
      633       p-prefix
      634       + string(v-date, p-date-format)
      635       + p-delimiter
      636       + string(v-time, p-time-format)
      637       + p-suffix
      638       .
      639   end.
      640   function cur-time-print  returns character
      641   :
      642     define variable v-date as date      no-undo .
      643     define variable v-time as integer   no-undo .
      644     run cur-time in this-procedure
      645       (output v-date
      646       ,output v-time
      647       ) .
      648     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      649   end.
      650   function cur-time-datetime returns datetime
      651   :
      652     define variable v-char as character no-undo .
      653     define variable v-datetime as datetime no-undo .
      654     v-char = cur-time-string().
      655     v-datetime = datetime(v-char).
      656     return  v-datetime.
      657   end.
      658   function cur-time-string-msec returns character
      659   :
      660     define variable v-date as datetime  no-undo .
      661     v-date = now.
      662     return string(v-date) .
      663   end.
