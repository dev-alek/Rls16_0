    17480   PROCEDURE get-time-close :
    17481   define output parameter p-time as integer          no-undo.
    17482   do
    17483   on error undo, return error
    17484   :
    17485      if v-time-close <> 0
    17486      then do:
    17487         assign
    17488            p-time = TIME - v-time-close
    17489         .
    17490      end.
    17491   end.
    17492   end PROCEDURE.
    17493   PROCEDURE reset-time-close :
