    10433   define variable v-gds-code        as integer no-undo .
    10434   define variable v-chk-name        as character no-undo .
    10435   define variable v-second-name     as character no-undo .
    10436   define variable v-src-sum         as decimal no-undo .
    10437   define variable v-src-sum-netto   as decimal no-undo .
    10438   define variable v-pline-num as integer no-undo .
    10439   define variable v-mode as character no-undo .
    10440   define variable v-pass-pay as integer no-undo .
    10441   define variable v-pay-card as character no-undo .
    10442   define variable v-tot-sum as decimal no-undo .
    10443   define variable v-tot-rubl as decimal no-undo .
    10444   define variable v-tot-base as decimal no-undo .
    10445   define variable v-par-code as integer  no-undo .
