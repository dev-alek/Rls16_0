     4727       , input  '*':U
     4728       , input  '':U
     4729       , input  v-doc-code
     4730       , input  '':U
     4731       , input  TODAY
     4732       , input  53
     4733       , input  TIME
     4734       , input  'U':U
     4735       , input  0
     4736       , input  v-cntxt-obj-type
     4737       , input  v-cntxt-obj-code
     4738       , input  '':U
     4739       , input  'IBS-TH':U
     4740       , input  0
     4741       , input  ?
     4742       , input  '':U
     4743       , input  0
     4744       , input  '':U
     4745       , input  0
     4746       , input  v-cntxt-userid
     4747       ) no-error .
     4748   end.
     4749   end.
     4750   end procedure.
     4751   procedure cd-unblock :
     4752   define input-output  parameter p-cd-mode     as character          no-undo.
     4753   define input-output  parameter p-cd-submode  as character          no-undo.
     4754   define output        parameter p-message     as character      no-undo .
     4755   define output        parameter p-ok          as logical          no-undo.
     4756   do
     4757   on error undo, return error
     4758   :
     4759      run adm/chk-pass.w   ( input parparentproc
     4760                           , input v-cntxt-userid
     4761                           , input v-cntxt-db-num
     4762                           , input "actn_ibsthpos-unblock"
     4763                           , input TRUE
     4764                           , output p-message
     4765                           , output p-ok
     4766                           ) .
     4767      if p-ok
     4768      then do:
     4769         assign
     4770            p-cd-mode    = v-cd-mode-user-pre
     4771            p-cd-submode = v-cd-submode-user-pre
     4772         .
     4773      end.
     4774   end.
     4775   end procedure.
     4776   procedure key-enable :
     4777   define input  parameter p-cd-mode      as character          no-undo.
     4778   define input  parameter p-cd-submode   as character        no-undo.
     4779   define input  parameter p-name         as character        no-undo.
     4780   define output parameter p-ok           as logical          no-undo.
     4781   define output parameter p-label        as character        no-undo.
     4782   define output parameter p-tooltip      as character        no-undo.
     4783   define variable v-md    as character    no-undo.
     4784   define variable v-msg   as character    no-undo.
     4785   define buffer buf_temp-layout-elem-rule      for temp-layout-elem-rule .
     4786   do
     4787   on error undo, return error
     4788   :
     4789      if p-cd-mode = "1"
     4790      OR p-cd-mode = "2"
     4791      then do:
     4792         assign
     4793            v-md = substitute("&1.&2", p-cd-mode, p-cd-submode)
     4794         .
     4795      end.
     4796      else do:
     4797         assign
     4798            v-md = p-cd-mode
     4799         .
     4800      end.
     4801      find first buf_temp-layout-elem-rule
     4802           where buf_temp-layout-elem-rule.layout-id  = v-screen-layout-id
     4803             and buf_temp-layout-elem-rule.mode-id    = v-md
     4804             and buf_temp-layout-elem-rule.widget-id  = p-name
     4805             no-error
     4806             .
     4807      if available buf_temp-layout-elem-rule then do:
     4808         assign
     4809            p-label     = buf_temp-layout-elem-rule.elem-label
     4810            p-tooltip   = buf_temp-layout-elem-rule.elem-tooltip
     4811            p-ok        = TRUE
     4812         .
     4813         RELEASE buf_temp-layout-elem-rule.
     4814      end.
     4815      else do:
     4816         find first tt-func-key
     4817              where tt-func-key.cd-mode     = p-cd-mode
     4818                and tt-func-key.cd-submode  = p-cd-submode
     4819                AND tt-func-key.key-name    = p-name
     4820               NO-LOCK
     4821               No-error
     4822               .
     4823         if not available tt-func-key
     4824         then return.
     4825         assign
     4826            p-label = tt-func-key.key_label
     4827            p-ok    = TRUE
     4828         .
     4829      end.
     4830      return.
     4831   end.
     4832   end procedure.
     4833   procedure key-run :
     4834   define input-output  parameter p-cd-mode     as character        no-undo .
     4835   define input-output  parameter p-cd-submode  as character      no-undo .
     4836   define input         parameter p-name        as character      no-undo .
     4837   define output        parameter p-message     as character      no-undo .
     4838   define output        parameter p-ok          as logical          no-undo.
     4839   define variable v-msg    as character    no-undo.
     4840   do
     4841   on error undo, return error
     4842   :
     4843      find first tt-func-key
     4844           where tt-func-key.cd-mode    = p-cd-mode
     4845            AND  tt-func-key.cd-submode = p-cd-submode
     4846            AND  tt-func-key.key-name   = p-name
     4847           NO-LOCK
     4848           No-error
     4849           .
     4850      if not available tt-func-key
     4851      then do:
     4852         return.
     4853      end.
     4854      assign
     4855         v-fix-summ-pay = DECIMAL(TRIM(tt-func-key.key_label, " %"))
     4856      no-error
     4857      .
     4858      if error-status:error
     4859      then do:
     4860         assign
     4861            v-fix-summ-pay = 0
     4862         no-error .
     4863      end.
     4864      if tt-func-key.cng-context
     4865      then do:
     4866         run VALUE( tt-func-key.key_func )  ( INPUt-OUTPUT p-cd-mode
     4867                                            , INPUt-output p-cd-submode
     4868                                            , output p-message
     4869                                            , output p-ok
     4870                                            ) .
     4871      end.
     4872      else do:
     4873         run VALUE( tt-func-key.key_func ) ( output p-message
     4874                                           , output p-ok
     4875                                           ) .
     4876      end.
     4877      if not p-ok
     4878      then do:
     4879         return.
     4880      end.
     4881      if p-cd-mode <> "4"
     4882      then do:
     4883         assign
     4884            v-msg            = p-message
     4885            v-cd-mode-pre    = p-cd-mode
     4886            v-cd-submode-pre = p-cd-submode
     4887         .
     4888      end.
     4889      run cd-context ( INPUt-OUTPUT p-cd-mode
     4890                     , INPUt-output p-cd-submode
     4891                     , output       p-message
     4892                     , output p-ok
     4893                     ) .
     4894      if not p-ok
     4895      then do:
     4896         return.
     4897      end.
     4898      if p-cd-mode <> "4"
     4899      then do:
     4900         assign
     4901            p-message        = v-msg
     4902            v-cd-mode-pre    = p-cd-mode
     4903            v-cd-submode-pre = p-cd-submode
     4904         .
     4905      end.
     4906      return.
     4907   end.
     4908   end procedure.
     4909   procedure rule-run :
     4910   define input-output  parameter p-cd-mode     as character        no-undo .
     4911   define input-output  parameter p-cd-submode  as character      no-undo .
     4912   define input         parameter p-name        as character      no-undo .
     4913   define input         parameter p-type        as character      no-undo .
     4914   define output        parameter p-message     as character      no-undo .
     4915   define output        parameter p-ok          as logical          no-undo.
     4916   define variable v-msg    as character    no-undo.
     4917   define variable v-md    as character    no-undo.
     4918   define buffer b_temp-layout-elem-rule for temp-layout-elem-rule .
     4919   define buffer b_tt-func-key for tt-func-key .
     4920   do
     4921   on error undo, return error
     4922   :
     4923      if p-cd-mode = "1"
     4924      OR p-cd-mode = "2"
     4925      then do:
     4926         assign
     4927            v-md = substitute("&1.&2", p-cd-mode, p-cd-submode)
     4928         .
     4929      end.
     4930      else do:
     4931         assign
     4932            v-md = p-cd-mode
     4933         .
     4934      end.
     4935      case p-type:
     4936         WHEN 'th-pos-keyboard':U then do:
     4937            if  v-keyboard-layout-id <> "":U
     4938            AND v-keyboard-layout-id <> ?
     4939            then do:
     4940               find first buf_temp-layout-elem-rule
     4941                  where buf_temp-layout-elem-rule.layout-id = v-keyboard-layout-id
     4942                     and buf_temp-layout-elem-rule.widget-id = p-name
     4943                     no-error
     4944                     .
     4945               if avail buf_temp-layout-elem-rule then
     4946               do:
     4947                  find first b_temp-layout-elem-rule no-lock where
     4948                             b_temp-layout-elem-rule.rule_id =  buf_temp-layout-elem-rule.rule_id
     4949                       and   b_temp-layout-elem-rule.mode-id = v-md
     4950                       no-error
     4951                       .
     4952                  if not avail b_temp-layout-elem-rule then
     4953                  do:
     4954                     find first b_tt-func-key no-lock where b_tt-func-key.cd-mode = p-cd-mode
     4955                                             and b_tt-func-key.cd-submode = p-cd-submode
     4956                                             and b_tt-func-key.key_func = string(buf_temp-layout-elem-rule.rule_id)
     4957                                             no-error.
     4958                     if not avail b_tt-func-key then
     4959                     do:
     4960                       assign p-ok = no
     4961                              p-message = "В данном режиме клавиша не работает"
     4962                            .
     4963                       return  .
     4964                     end.
     4965                  end.
     4966               end.
     4967            end.
     4968            else do:
     4969               find first buf_temp-layout-elem-rule
     4970                  where buf_temp-layout-elem-rule.layout-id = v-screen-layout-id
     4971                     and buf_temp-layout-elem-rule.mode-id   = v-md
     4972                     and buf_temp-layout-elem-rule.widget-id = p-name
     4973                     no-error
     4974                     .
     4975            end.
     4976         end.
     4977         WHEN 'th-pos-screen':U then do:
     4978            find first buf_temp-layout-elem-rule
     4979                 where buf_temp-layout-elem-rule.layout-id = v-screen-layout-id
     4980                   and buf_temp-layout-elem-rule.mode-id   = v-md
     4981                   and buf_temp-layout-elem-rule.widget-id = p-name
     4982                  no-error
     4983                  .
     4984         end.
     4985         OTHERWISE DO:
     4986         end.
     4987      end case.
     4988      if available buf_temp-layout-elem-rule then do:
     4989         run value( substitute("&1", string(buf_temp-layout-elem-rule.rule_id, "9999"))) in this-procedure
     4990                  ( input-output p-cd-mode
     4991                  , input-output p-cd-submode
     4992                  , output p-message
     4993                  , output p-ok
     4994                  ) no-error.
     4995         RELEASE buf_temp-layout-elem-rule.
     4996      end.
     4997      else do:
     4998         run key-run in this-procedure ( input-output p-cd-mode
     4999                                       , input-output p-cd-submode
     5000                                       , input p-name
     5001                                       , output p-message
     5002                                       , output p-ok
     5003                                       ) no-error.
     5004      end.
     5005      if error-status:error
     5006      then do:
     5007         assign
     5008            p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
     5009            p-ok = FALSE
     5010         .
     5011         return.
     5012      end.
     5013      if not p-ok
     5014      then do:
     5015         return.
     5016      end.
     5017      if p-cd-mode <> "4"
     5018      then do:
     5019         assign
     5020            v-msg            = p-message
     5021            v-cd-mode-pre    = p-cd-mode
     5022            v-cd-submode-pre = p-cd-submode
     5023         .
     5024      end.
     5025      run cd-context ( INPUt-OUTPUT p-cd-mode
     5026                     , INPUt-output p-cd-submode
     5027                     , output       p-message
     5028                     , output       p-ok
     5029                     ) .
     5030      if not p-ok
     5031      then do:
     5032         return.
     5033      end.
     5034      if p-cd-mode <> "4"
     5035      then do:
     5036         assign
     5037            p-message        = v-msg
     5038            v-cd-mode-pre    = p-cd-mode
     5039            v-cd-submode-pre = p-cd-submode
     5040         .
     5041      end.
     5042      return.
     5043   end.
     5044   end procedure.
     5045   procedure func-param :
     5046   define input   parameter p-name        as character      no-undo .
     5047   define output  parameter p-message     as character      no-undo .
     5048   define output  parameter p-ok          as logical        no-undo .
     5049   do
     5050   on error undo, return error
     5051   :
     5052         run VALUE( p-name ) in this-procedure ( output p-message, output p-ok ) no-error.
     5053         if error-status:error
     5054         then do:
     5055            assign
     5056               p-ok = FALSE
     5057               p-message = substitute  ( "&1 &2 &3 &4"
     5058                                       , return-VALUE
     5059                                       , error-status:get-message(1)
     5060                                       , error-status:get-message(2)
     5061                                       , error-status:get-message(3)
     5062                                       )
     5063            .
     5064         end.
     5065   end.
     5066   end procedure.
     5067   procedure pr-empty :
     5068   define output        parameter p-message     as character      no-undo .
     5069   define output        parameter p-ok          as logical          no-undo.
     5070   define variable v-choice as logical no-undo init yes.
     5071   do
     5072   on error undo, return error
     5073   :
     5074      message
     5075      "Вы действительно хотите  выйти из АРМа  'Кассир' ?"
     5076      view-as alert-box question buttons yes-no update v-choice .
     5077      if v-choice then.
     5078      else return no-apply.
     5079      if not v-emul-mode
     5080      then do:
     5081   define variable vss-include-info140 as character format "X(65)" no-undo
     5082   initial "@(#)$Workfile$ $Revision$".
     5083   do:
     5084     if valid-handle( g#disp-lib ) <> TRUE then do:       run gbl/disp-lib.p persistent no-error.       if error-status :error or valid-handle( g#disp-lib ) <> TRUE then do:         message "Error starting disp-lib.p" skip( 0 )           g#disp-lib                        skip( 0 )           g#disp-lib    :type               skip( 0 )           g#disp-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run disp-clear in g#disp-lib
     5085       ( output p-message
     5086       , output p-ok
     5087       ) no-error .
     5088   end.
     5089   define variable vss-include-info141 as character format "X(65)" no-undo
     5090   initial "@(#)$Workfile$ $Revision$".
     5091   do:
     5092     if valid-handle( g#disp-lib ) <> TRUE then do:       run gbl/disp-lib.p persistent no-error.       if error-status :error or valid-handle( g#disp-lib ) <> TRUE then do:         message "Error starting disp-lib.p" skip( 0 )           g#disp-lib                        skip( 0 )           g#disp-lib    :type               skip( 0 )           g#disp-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run disp-str in g#disp-lib
     5093       ( INPUT  '':U
     5094       , INPUT  '':U
     5095       , output p-message
     5096       , output p-ok
     5097       ) no-error .
     5098   end.
     5099   define variable vss-include-info142 as character format "X(65)" no-undo
     5100   initial "@(#)$Workfile$ $Revision$".
     5101   do:
     5102     if valid-handle( g#disp-lib ) <> TRUE then do:       run gbl/disp-lib.p persistent no-error.       if error-status :error or valid-handle( g#disp-lib ) <> TRUE then do:         message "Error starting disp-lib.p" skip( 0 )           g#disp-lib                        skip( 0 )           g#disp-lib    :type               skip( 0 )           g#disp-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run disp-terminate in g#disp-lib
     5103       ( output p-message
     5104       , output p-ok
     5105       ) no-error .
     5106   end.
     5107      end.
     5108      QUIT.
     5109   end.
     5110   end procedure.
     5111   procedure set-date :
     5112   define input-output  parameter p-cd-mode     as character        no-undo .
     5113   define input-output  parameter p-cd-submode  as character      no-undo .
     5114   define output        parameter p-message     as character      no-undo .
     5115   define output        parameter p-ok          as logical          no-undo.
     5116   do
     5117   on error undo, return error
     5118   :
     5119         if not v-emul-mode
     5120            then do:
     5121   define variable vss-include-info143 as character format "X(65)" no-undo
     5122   initial "@(#)$Workfile$ $Revision$".
     5123   do:
     5124     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-dtset in g#fr-lib
     5125       ( output       p-message
     5126       , output       p-ok
     5127       ) no-error .
     5128   end.
     5129            if error-status:error
     5130            then do:
     5131               assign
     5132                  p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
     5133                  p-ok = FALSE
     5134               .
     5135               return .
     5136            end.
     5137   define variable vss-include-info144 as character format "X(65)" no-undo
     5138   initial "@(#)$Workfile$ $Revision$".
     5139   do:
     5140     if valid-handle( g#fr-lib ) <> TRUE then do:       run gbl/fr-lib.p persistent no-error.       if error-status :error or valid-handle( g#fr-lib ) <> TRUE then do:         message "Error starting fr-lib.p" skip( 0 )           g#fr-lib                        skip( 0 )           g#fr-lib    :type               skip( 0 )           g#fr-lib    :file-name          skip( 0 )           error-status :get-message( 1 )  skip( 0 )           return-value                    skip( 0 )         view-as alert-box error.         stop.       end.      end.     run fr-tmset in g#fr-lib
     5141       ( output       p-message
     5142       , output       p-ok
     5143       ) no-error .
     5144   end.
     5145            if error-status:error
     5146            then do:
     5147               assign
     5148                  p-message = substitute("&1 &2 &3", error-status:get-message(1), return-value, p-message)
     5149                  p-ok = FALSE
     5150               .
     5151               return.
     5152            end.
     5153         end.
     5154         else do:
     5155            assign
     5156               p-cd-mode    = "0"
     5157               p-cd-submode = "0"
     5158               p-ok = TRUE
     5159            .
     5160         end.
     5161   end.
     5162   end procedure.
     5163   procedure add-gds-line :
     5164   define input-output  parameter p-cd-mode     as character        no-undo .
     5165   define input-output  parameter p-cd-submode  as character      no-undo .
     5166   define output parameter p-message     as character      no-undo .
     5167   define output parameter p-ok          as logical          no-undo.
     5168   define buffer buf_tt-line     for tt-line .
     5169   define buffer prev_tt-line    for tt-line .
     5170   define buffer buf_goods       for ub.goods .
     5171   define buffer buf_tt-head-check     for tt-head-check .
     5172   define variable v-b-code          as integer no-undo .
     5173   define variable v-second-name     as character no-undo .
     5174   define variable v-next    as character    no-undo.
     5175   do
     5176   on error undo, return error
     5177   :
     5178      find last  prev_tt-line
     5179           where prev_tt-line.type = 0
     5180           NO-LOCK
     5181           no-error
     5182           .
     5183      if ((p-cd-mode = "1"
     5184      OR  p-cd-mode = "2")
     5185      AND p-cd-submode = "0")
     5186      OR  not v-with-context
     5187      then do:
     5188         assign
     5189            v-pump            = 0
     5190            v-nozzle-code     = 0
     5191            v-pl-code         = 0
     5192            v-fbr-depart      = 0
     5193            v-src-price       = if (p-cd-mode = "1") then ? else v-src-price
     5194            v-write-off-code  = 0
     5195            v-num             = if v-num = 0 then (if (not available prev_tt-line) then 1
     5196                                                                                else prev_tt-line.num + 1)
     5197                                             else v-num
     5198         .
     5199         find buf_tt-head-check.
     5200         assign
     5201            v-src-qnty = if v-src-qnty = 0 then 1 else v-src-qnty
     5202         .
     5203         if p-cd-mode = "2"
     5204         then do:
     5205            define variable v-curr-qnty   as decimal      no-undo .
     5206            define variable v-old-qnty    as decimal      no-undo .
     5207            define variable v-found       as logical      no-undo .
     5208            run accum-chk-gds ( input  v-src
     5209                              , output v-found
     5210                              , output v-old-qnty
     5211                              ) .
     5212            run accum-curr-chk-gds  ( input  v-src
     5213                                    , output v-curr-qnty
     5214                                    ) .
     5215            if ( ( v-curr-qnty + v-src-qnty ) > v-old-qnty )
     5216            AND v-found
     5217            then do:
     5218               if v-old-qnty = 0
     5219               then do:
     5220                  assign
     5221                     p-message = "В исходном чеке продажи не было такого товара"
     5222                     p-ok = FALSE
     5223                  .
     5224                  return.
     5225               end.
     5226               else do:
     5227                  assign
     5228                     p-message = substitute( "По данному чеку продажи можно вернуть только &1 товара с кодом &2"
     5229                                          , v-old-qnty
     5230                                          , v-src
     5231                                          )
     5232                     p-ok = FALSE
     5233                  .
     5234                  return.
     5235               end.
     5236            end.
     5237            define buffer buf_chk-gds     for ub.chk-gds .
     5238            define buffer buf_tt-open-check     for tt-open-check .
     5239            find first buf_tt-open-check
     5240               where buf_tt-open-check.chk-type = INTEGER('1':U)
     5241               no-lock
     5242               no-error
     5243               .
     5244            find first buf_chk-gds
     5245               where buf_chk-gds.doc-code = buf_tt-open-check.doc-code
     5246                  AND   buf_chk-gds.src-code = v-src
     5247               NO-LOCK
     5248               no-error
     5249               .
     5250            if available buf_chk-gds
     5251            AND v-src-price = 0
     5252            then do:
     5253               assign
     5254                  v-src-price       = buf_chk-gds.price-base - buf_chk-gds.discnt
