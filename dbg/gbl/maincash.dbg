     8551            CREATE buf_tt-line.
     8552            assign
     8553               buf_tt-line.type        = 1
     8554               buf_tt-line.num         = v-pline-num
     8555               buf_tt-line.line-name   = substitute("    Оплата &1", buf_cash-pay.obj-name  )
     8556               buf_tt-line.line-code   = v-pay-type
     8557               buf_tt-line.curr-code   = v-curr-base-code
     8558               buf_tt-line.fr-pay-code = v-frpay-code
     8559               buf_tt-line.summ-netto-rub = ABSOLUTE(v-tot-rubl)
     8560               buf_tt-line.summ-netto   = ABSOLUTE(v-tot-base)
     8561               buf_tt-line.pay-card    = v-pay-card
     8562               buf_tt-line.qnty         = v-tot-sum
     8563               buf_tt-line.summ-discont = v-src-discnt
     8564               buf_tt-line.summ-discont-rub = v-src-discnt-rub
     8565               buf_tt-line.src          = STRING(v-pay-type)
