        1   block-level on error undo, throw.
        2   define output parameter par-dec as character no-undo .
        3   define output parameter par-tho as character no-undo .
        4   define output parameter par-sdate as character no-undo .
        5   define output parameter par-shortdate as character no-undo .
        6   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   def var vss-author      as character no-undo init "$Author: expertek $":U .
        8   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   def var vss-workfile    as character no-undo init "$Workfile: getlocal.p $":U .
       10   def var vss-archive     as character no-undo init "$Archive: gbl/getlocal.p $":U .
       11   def var vss-description as character no-undo init "Определение локальных настроек системы пользователя".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       73      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       74   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       76     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       77   FUNCTION GetLastError
       78            RETURNS INTEGER
       79            ()
       80            IN hpWinFunc.
       81   FUNCTION GetParent
       82            RETURNS INTEGER
       83            (input hwnd as INTEGER)
       84            IN hpWinFunc.
       85   FUNCTION ShowLastError
       86            RETURNS INTEGER
       87            ()
       88            IN hpWinFunc.
       89   FUNCTION CreateProcess
       90            RETURNS INTEGER
       91            (input CommandLine as CHAR,
       92             input CurrentDir  as CHAR,
       93             input wShowWindow as INTEGER)
       94            in hpWinFunc.
       95   PROCEDURE GetDateFormatA EXTERNAL "KERNEL32" :
       96      DEFINE INPUT PARAMETER        Locale      AS LONG.
       97      DEFINE INPUT PARAMETER        dwFlags     AS LONG.
       98      DEFINE INPUT PARAMETER        lpTime      AS LONG.
       99      DEFINE INPUT PARAMETER        lpFormat    AS LONG.
      100      DEFINE INPUT-OUTPUT PARAMETER lpDateStr   AS CHAR.
      101      DEFINE INPUT PARAMETER        cchDate     AS LONG.
      102      DEFINE RETURN PARAMETER       cchReturned AS LONG.
      103   END PROCEDURE.
      104   PROCEDURE GetTimeFormatA EXTERNAL "KERNEL32" :
      105      DEFINE INPUT PARAMETER        Locale    AS LONG.
      106      DEFINE INPUT PARAMETER        dwFlags   AS LONG.
      107      DEFINE INPUT PARAMETER        lpTime    AS LONG.
      108      DEFINE INPUT PARAMETER        lpFormat  AS LONG.
      109      DEFINE INPUT-OUTPUT PARAMETER lpTimeStr AS CHAR.
      110      DEFINE INPUT PARAMETER        cchTime   AS LONG.
      111      DEFINE RETURN PARAMETER       cchReturned AS LONG.
      112   END PROCEDURE.
      113   DEFINE VARIABLE cchRet as integer no-undo.
      114   do
      115   on error undo, return error
      116   :
      117   assign
      118   par-dec = fill(chr(32),50)
      119   par-tho = fill(chr(32),50)
      120   par-sdate = fill(chr(32),50)
      121   par-shortdate = fill(chr(32),50)
      122   .
      123     RUN GetLocaleInfoA in hpApi ( 1024
      124                                  ,14
      125                                  ,input-output par-dec
      126                                  ,length(par-dec)
      127                                  ,output cchRet
      128                                     ).
      129     RUN GetLocaleInfoA in hpApi ( 1024
      130                                  ,15
      131                                  ,input-output par-tho
      132                                  ,length(par-tho)
      133                                  ,output cchRet
      134                                     ).
      135     RUN GetLocaleInfoA in hpApi ( 1024
      136                                  ,31
      137                                  ,input-output par-shortdate
      138                                  ,length(par-shortdate)
      139                                  ,output cchRet
      140                                     ).
      141     RUN GetLocaleInfoA in hpApi ( 1024
      142                                  ,29
      143                                  ,input-output par-sdate
      144                                  ,length(par-sdate)
      145                                  ,output cchRet
      146                                     ).
      147     assign
      148     par-dec = trim(par-dec)
      149     par-tho = trim(par-tho)
      150     par-sdate = trim(par-sdate)
      151     par-shortdate = trim(par-shortdate)
      152     .
      153   end.
