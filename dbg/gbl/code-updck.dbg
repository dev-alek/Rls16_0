      260   procedure RunProcAny:
      261      define input  parameter iProc  as character no-undo.
      262      define input  parameter iParam as character no-undo.
      263      define output parameter oOk    as logical   no-undo.
      264      run value(iproc) (parparentproc, iparam, output oOk) no-error.
      265      if error-status:error
      266      then
      267         return substitute ("&1 &2", return-value, error-status:get-message(1)).
      268   end.
      269   function objExists return character
      270   (input  ifolder as character,
      271    input  iType   as character  ):
      272       define variable vFileType as character no-undo init "D,F".
      273       define variable vi        as integer no-undo.
      274       define variable vtype as character no-undo.
      275       if iType ne ?
      276       then
      277          vFileType = iType.
      278       do vi = 1 to num-entries(vFileType):
      279          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      280          vtype = file-information:file-type.
      281          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      282             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      283             index(vtype , entry(vi,vFileType )) > 0
      284          then return file-information:full-pathname .
      285          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      286          vtype = file-information:file-type.
      287          if file-information:file-name <> "" and
      288             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      289             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      290             index( vtype, entry(vi,vFileType )) > 0
      291          then return file-information:full-pathname .
      292       end.
      293       return ? .
      294   end.
      295   function SearchFile return character
      296   (input  ifile as character):
      297      return objExists(ifile,?).
      298   end.
      299   function SearchPFile return character
      300   (input inFile as char):
      301        define variable oFile       as character no-undo.
      302        define variable vFileSearch as character no-undo.
      303        define variable vNumEntry   as integer no-undo.
      304        if inFile = "" then return ?.
      305        vNumEntry = num-entries(inFile,".").
      306        vFileSearch = inFile.
      307        if    vNumEntry > 0
      308           and (   entry(vNumEntry,inFile,".") eq "p"
      309                or entry(vNumEntry,inFile,".") eq "w")
      310        then do:
      311           entry(vNumEntry,vFileSearch, ".") = "r".
      312           oFile = search(vFileSearch ).
      313           if oFile eq ?
      314           then
      315              oFile = search(inFile).
      316        end.
      317        else
      318           oFile = search(vFileSearch).
      319        return oFile.
      320     end.
      321   define temp-table ttUpd
      322     field fName     as character
      323     field fNamePath as character
      324     field fMd5      as character
      325     index fName fName
      326   .
      327   define variable mDirUpdCk as character no-undo.
      328   define variable mfile as character no-undo.
      329   define variable mfilemd5 as character no-undo.
      330   define variable v-md5-signature  as character no-undo.
      331   define variable vimport as class ibs.th.bge.xmlimpexp no-undo.
      332   define variable mTxt as character no-undo.
      333   define variable mfilever as char no-undo init ?.
      334   define variable m-type as character no-undo.
      335   define variable mdbver as integer no-undo.
      336   define variable f_load as logical no-undo init no.
      337   define variable v-filename as character no-undo.
      338   define variable v-fullfilename as character no-undo.
      339   define stream md5in.
      340   define stream dir-stream.
      341   subscribe "RunProcXmlImp" anywhere run-procedure "RunProcAny".
      342   subscribe "NotSendNwsForTable" anywhere run-procedure "DisableNws".
      343   subscribe "DisableNwsTable" anywhere run-procedure "SetNwsTable".
      344   vimport= new ibs.th.bge.xmlimpexp().
      345   mDirUpdCk = objExists("updck","D").
      346   if mDirUpdCk = ? then return.
      347   input stream dir-stream from os-dir( mDirUpdCk ) no-attr-list no-echo .
      348   block-upd:
      349   repeat:
      350      import stream dir-stream v-filename v-fullfilename .
      351      file-info :file-name = v-fullfilename.
      352      if caps( file-info :file-type ) begins "F":U and
      353         entry(2, file-info:file-name, ".") = "xml" then
      354      do:
      355          create ttUpd.
      356          assign
      357            ttUpd.fName     = v-filename
      358            ttUpd.fNamePath = v-fullfilename
      359            ttUpd.fMd5      = entry(1, v-fullfilename, ".") + ".md5"
      360          .
      361      end.
      362   end.
      363   input stream dir-stream close.
      364   block-for:
      365   for each ttUpd by ttUpd.fName:
      366         mfile    = ttUpd.fNamePath.
      367         mfilemd5 = ttUpd.fMd5.
      368         if    mfile    eq ?
      369            or mfilemd5 eq ?
      370         then
      371            leave block-for.
      372         if search(mfilemd5) = ? then
      373         do:
      374           return error substitute("Не найден файл сигнатуры &1.", mfilemd5).
      375         end.
      376         input  stream md5in from value (mfilemd5).
      377         import stream md5in mtxt no-error.
      378         input  stream md5in close.
      379         run gbl/md5.p (
      380             input  mfile
      381            ,output v-md5-signature
      382            ) .
      383         if mtxt eq encode(v-md5-signature + "updck" ) + string(index(encode(string(v-md5-signature)), "k"))
      384         then do:
      385            vimport:xmldom-load-ver  ( mfile,? ) no-error.
      386            if error-status:error
      387            then
      388               return error return-value.
      389               UPD_TBL:
      390               do transaction on error undo UPD_TBL, leave UPD_TBL:
      391                  vimport:updatetablefordb(this-procedure) no-error.
      392                  if error-status:error
      393                     then return error return-value.
      394               end.
      395            CODE_UPD:
      396            do transaction on error undo CODE_UPD, leave CODE_UPD:
      397            define variable lcXML as longchar no-undo.
      398            copy-lob from file mfile to lcXML.
      399               create code  no-error.
      400               assign
      401                  code.parent    = substitute("XML_BACKUP")
      402                  code.code      = substitute("&1 &2",string(now), entry(num-entries(mfile, "\"),mfile, "\"))
      403                  code.CodeValue = entry(num-entries(mfile, "\") , mfile, "\")
      404                  code.misc1     = v-md5-signature
      405                  code.misc2     = string(mdbver)
      406                  code.misc3     = lcXML
      407                  code.procview  = "ibs\th\ref\code\xmlbackup.p"
      408               .
      409            end.
      410            return-value = "".
      411            vimport:xmldom-clear().
      412         end.
      413         else
      414            return error substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile).
      415   end.
      416   define variable v-err-msg as character no-undo .
      417   catch exAppErrors as class Progress.Lang.AppError :
      418       v-err-msg = exAppErrors:ReturnValue .
      419       if v-err-msg > "" then . else do :
      420          v-err-msg = exAppErrors:GetMessage(1) .
      421         if v-err-msg > ""
      422         then v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-updck.p" + v-err-msg.
      423         else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-updck.p" .
      424       end .
      425     end catch .
      426     catch exProErrors as class Progress.Lang.ProError :
      427       v-err-msg = exProErrors:GetMessage(1) .
      428       if v-err-msg > ""
      429       then v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-updck.p" + v-err-msg.
      430       else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-updck.p" .
      431       return error v-err-msg.
      432     end catch .
      433     catch exAnyErrors as class Progress.Lang.Error:
      434       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-updck.p " + exAnyErrors:GetMessage(1).
      435       return error v-err-msg.
      436   end catch .
      437   finally:
      438      if valid-object(vimport)
      439      then
      440         delete object vimport.
      441      unsubscribe "NotSendNwsForTable".
      442      unsubscribe "DisableNwsTable".
      443      unsubscribe "RunProcXmlImp".
      444   end finally.
