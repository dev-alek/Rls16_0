        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define input  parameter p-directory-out     as character no-undo .
        4   define input  parameter p-file-name         as character no-undo .
        5   define input  parameter p-session-valid     as logical   no-undo .
        6   define input  parameter p-error-message     as character no-undo .
        7   define input  parameter p-user-login        as character no-undo .
        8   define input  parameter p-obj-type          as character no-undo .
        9   define input  parameter p-obj-code          as character no-undo .
       10   define input  parameter p-host-code         as character no-undo .
       11   define input  parameter p-doc-type          as character no-undo .
       12   define input  parameter p-doc-code          as character no-undo .
       13   define input  parameter p-bar-code          as character no-undo .
       14   define input  parameter p-cli-qnty          as character no-undo .
       15   define input  parameter p-unit-cli          as character no-undo .
       16   define input  parameter p-cli-base-rate     as character no-undo .
       17   define input  parameter p-line-number       as character no-undo .
       18   define input  parameter p-price-cli         as character no-undo .
       19   define input  parameter p-prod-artic        as character no-undo .
       20   define input  parameter p-prod-artic-search as character no-undo .
       21   define input  parameter p-price-docf        as character no-undo .
       22   define input  parameter p-deadline-date     as character no-undo .
       23   define input  parameter p-cop-check         as character no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       25   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       26   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile: rt-req14.p $":U .
       28   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req14.p $":U .
       29   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 14. Приемка товара. Редактирование количеств по документу".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure integerm :
       90     define input  parameter p-string      as character no-undo .
       91     define input  parameter p-allow-sign  as logical   no-undo .
       92     define input  parameter p-allow-comma as logical   no-undo .
       93     define output parameter p-value       as integer   no-undo .
       94     define output parameter p-data-valid  as logical   no-undo .
       95     define output parameter p-message     as character no-undo .
       96     define variable v-replace-string as character no-undo .
       97     do
       98     on error undo, return error return-value
       99     :
      100       if p-string = ?
      101       then do:
      102         assign
      103           p-value      = ?
      104           p-data-valid = false
      105           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      106         .
      107         return .
      108       end.
      109       if p-string = ""
      110       then do:
      111         assign
      112           p-value      = ?
      113           p-data-valid = false
      114           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      115         .
      116         return .
      117       end.
      118       assign
      119         p-value = integer(p-string) no-error
      120       .
      121       if error-status :error = true
      122       then do:
      123         assign
      124           p-value      = ?
      125           p-data-valid = false
      126           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      127                                    ,p-string
      128                                    )
      129         .
      130         return .
      131       end.
      132       if index(p-string, ' ':u) > 0
      133       then do:
      134         assign
      135           p-value      = ?
      136           p-data-valid = false
      137           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      138                                    + "Строка содержит символы пробела"
      139                                    ,p-string
      140                                    )
      141         .
      142         return .
      143       end.
      144       assign
      145         v-replace-string = p-string
      146         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      150         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      151         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      152         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      153         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      154         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      155       .
      156       if p-allow-sign = true
      157       then do:
      158         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      159         then do:
      160           assign
      161             v-replace-string = substring(v-replace-string, 2)
      162           .
      163         end.
      164       end.
      165       else do:
      166         if substring(v-replace-string, 1, 1) = '+':u
      167         then do:
      168           assign
      169             p-value      = ?
      170             p-data-valid = false
      171             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      172                                     + "Задан параметр недопустимости знака челого числа. "
      173                                     + "Строка содержит символ плюс. "
      174                                     ,p-string
      175                                     )
      176           .
      177           return .
      178         end.
      179         if substring(v-replace-string, 1, 1) = '-':u
      180         then do:
      181           assign
      182             p-value      = ?
      183             p-data-valid = false
      184             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      185                                     + "Задан параметр недопустимости знака челого числа. "
      186                                     + "Строка содержит символ минус. "
      187                                     ,p-string
      188                                     )
      189           .
      190           return .
      191         end.
      192       end.
      193       if p-allow-comma = true
      194       then do:
      195         assign
      196           v-replace-string = replace(v-replace-string, ',', '')
      197         .
      198       end.
      199       else do:
      200         if index(v-replace-string, ',') > 0
      201         then do:
      202           assign
      203             p-value      = ?
      204             p-data-valid = false
      205             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      206                                     + "Задан параметр недопустимости знака разделителя тысяч."
      207                                     + "Строка содержит знак разделителя тысяч. "
      208                                     ,p-string
      209                                     )
      210           .
      211           return .
      212         end.
      213       end.
      214       if index(p-string, '.') > 0
      215       then do:
      216         assign
      217           p-value      = ?
      218           p-data-valid = false
      219           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      220                                    + "Строка содержит знак десятичной точки"
      221                                    ,p-string
      222                                    )
      223         .
      224         return .
      225       end.
      226       if v-replace-string <> fill('9', length(v-replace-string))
      227       then do:
      228         assign
      229           p-value      = ?
      230           p-data-valid = false
      231           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      232                                    + "Встречены символы, недопустимые для целого числа '&2'"
      233                                    ,p-string
      234                                    ,replace(v-replace-string, '9', '')
      235                                    )
      236         .
      237         return .
      238       end.
      239       assign
      240         p-data-valid = true
      241         p-message    = ""
      242       .
      243     end.
      244   end procedure.
      245   define new global shared variable g#library  as handle no-undo .
      246   define new global shared variable g#library2 as handle no-undo .
      247   define new global shared variable g#lib-trn  as handle no-undo .
      248   define new global shared variable g#lib-trn2 as handle no-undo .
      249   define new global shared variable g#lib-trn3 as handle no-undo .
      250   define new global shared variable g#lib-trn4 as handle no-undo .
      251   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      253   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      254     field cst-code                like ub.trn-doc.cst-code
      255     field part-code               like ub.parts.part-code
      256     .
      257   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      258   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      259   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      260   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   function rtencode returns character
      262     ( p-init-string as character
      263     ) :
      264     define variable v-encode-string as character no-undo .
      265     if p-init-string = ?
      266     then do:
      267       assign
      268         v-encode-string = '?':u
      269       .
      270       return v-encode-string .
      271     end.
      272     if p-init-string = '?':u
      273     then do:
      274       assign
      275         v-encode-string = '~~077':u
      276       .
      277       return v-encode-string .
      278     end.
      279     assign
      280       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      281       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      282       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      283     .
      284     return v-encode-string .
      285   end function .
      286   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   define variable v-waitfram-action01         as character   no-undo .
      288   define variable v-waitfram-action02         as character   no-undo .
      289   define variable v-waitfram-action03         as character   no-undo .
      290   define variable mWaitFramTextBeg            as character   no-undo.
      291   define variable mWaitFramTextEnd            as character   no-undo.
      292   define variable mWaitFramView               as logical     no-undo.
      293   define variable mWaitProcEvent              as logical     no-undo init yes.
      294   define variable mWaitFramInterval           as integer     no-undo init 1 .
      295   define variable mWaitFramStop               as logical     no-undo.
      296   define variable mWaitFramStopUser           as logical     no-undo.
      297   define variable mWaitFramStopTimeOut        as logical     no-undo.
      298   define variable mWaitFramStartProc          as datetime-tz no-undo.
      299   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      300   define button B-WaitFramStop auto-end-key
      301        label "Стоп"
      302        size 10 by 1 tooltip "Остоновить процесс".
      303   define button B-viewProcInfo
      304        label "Информация"
      305        size 15 by 1 tooltip "Информация о процесс".
      306   define frame waitfram
      307     v-waitfram-action01 format "x(72)" no-label skip
      308     v-waitfram-action02 format "x(72)" no-label skip
      309     v-waitfram-action03 format "x(72)" no-label skip
      310     B-viewProcInfo
      311     B-WaitFramStop at row 4 col 30
      312     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      313     .
      314   define new global shared variable mBatchMode as logical no-undo init ?.
      315   define variable mFramBachModHandle as handle no-undo.
      316   mFramBachModHandle = frame waitfram:handle.
      317   define variable mFameOldVis as logical no-undo.
      318   define variable mVisCUrentVin as logical no-undo.
      319   if session:batch-mode
      320   then
      321      mBatchMode = yes.
      322   if mBatchMode = ? then do:
      323     mVisCUrentVin = current-window:visible.
      324     mFameOldVis = mFramBachModHandle:visible.
      325     mFramBachModHandle:visible  = yes.
      326     mBatchMode = mFramBachModHandle:visible ne yes.
      327     mFramBachModHandle:visible = mFameOldVis.
      328     current-window:visible = mVisCUrentVin.
      329   end.
      330    if  log-manager:logfile-name ne ?
      331     then DO:
      332         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      333         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      334         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      335     end.
      336   on choose of B-WaitFramStop in frame waitfram
      337   do:
      338     mWaitFramStop = yes.
      339     mWaitFramStopUser = yes.
      340   end.
      341   function waitfram-check-timeout returns logical():
      342      define variable vtime as int64 no-undo.
      343      if mWaitFramStopTimeOut
      344      then
      345         return yes.
      346      vtime = ( now - mWaitFramStartProc ) / 1000 .
      347      if     mWaitFramTimeOut ne ?
      348         and mWaitFramTimeOut ne 0
      349         and mWaitFramTimeOut lt vtime
      350      then do:
      351         mWaitFramStopTimeOut = yes.
      352      end.
      353      return mWaitFramStopTimeOut.
      354   end.
      355   procedure waitfram-hide :
      356     if not session:batch-mode
      357     then do
      358     on error undo, return error return-value
      359     :
      360       pause 0 before-hide .
      361       if not mBatchMode then
      362         hide frame waitfram .
      363     if     not mWaitFramView
      364        and mWaitProcEvent
      365     then
      366       process events .
      367     end.
      368   end procedure.
      369   procedure waitfram-show :
      370     define input  parameter p-message as character no-undo .
      371     define variable v-left-margin as integer   no-undo .
      372     if not session:batch-mode
      373     then do
      374     on error undo, return error return-value
      375     :
      376       if length(p-message) <= 70 then do:
      377         assign
      378           v-left-margin = integer((70 - length(p-message)) / 2)
      379         .
      380         assign
      381           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      382         .
      383         assign
      384           v-waitfram-action01 = " "
      385           v-waitfram-action02 = " "
      386                                    + fill(" ", v-left-margin)
      387                                    + p-message
      388           v-waitfram-action03 = " "
      389         .
      390       end.
      391       else do:
      392         define variable vRindex1 as integer no-undo.
      393         define variable vRindex2 as integer no-undo.
      394         vRindex1 = r-index(p-message," ",70).
      395         if vRindex1 = 0
      396         then
      397            vRindex1 = 70.
      398         if length(p-message)  <= vRindex1 + 70 then do:
      399           assign
      400             v-waitfram-action01 = " "
      401             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      402             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      403           .
      404         end.
      405         else do:
      406           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      407           if vRindex2 <= vRindex1
      408           then
      409              vRindex2 = vRindex1 + 70.
      410           assign
      411             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      412             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      413             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      414           .
      415         end.
      416       end.
      417       B-viewProcInfo:visible   in frame waitfram = no.
      418       B-viewProcInfo:sensitive in frame waitfram = no.
      419       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      420       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      421       if  (   mWaitFramView
      422          or  mWaitProcEvent)
      423          and not mBatchMode
      424       then
      425          display
      426             v-waitfram-action01 skip
      427             v-waitfram-action02 skip
      428             v-waitfram-action03 skip
      429          with frame waitfram .
      430       if     mWaitFramView
      431          then do:
      432             if     mWaitFramInterval ne ?
      433                and not mBatchMode
      434             then
      435                wait-for go of frame waitfram pause mWaitFramInterval.
      436          end.
      437          else
      438             if     mWaitProcEvent
      439                and not mBatchMode
      440             then
      441                process events .
      442     end.
      443   end procedure.
      444      procedure waitfram-show-this:
      445         define input  parameter iInterval as int64 no-undo.
      446         define variable vtime as int64 no-undo.
      447         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      448         mWaitFramInterval = iInterval.
      449         run waitfram-show (substitute("&1&2 &3&4" ,
      450                                       mWaitFramTextBeg ,
      451                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      452                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      453                                       mWaitFramTextEnd
      454                                      )
      455                           ).
      456      end.
      457      procedure WaitFramRunPause:
      458         define input  parameter iInterval as dec no-undo.
      459         define variable vStart  as datetime-tz no-undo.
      460         define variable vend    as datetime-tz no-undo.
      461         define variable vint as int64 no-undo.
      462         define variable vOk as logical no-undo.
      463         vStart = now.
      464         vend   = vStart.
      465         publish "WaitFramPause" (iInterval,output vOk).
      466         vend   =  now.
      467         vint = vend - vStart.
      468         vint = iInterval - vint / 1000.
      469         if     not mWaitFramStop
      470            and (   vint > 0
      471                 or (    not vOk
      472                     and iInterval eq ?
      473                     )
      474                 )
      475         then
      476            run waitfram-show-this (iInterval).
      477         vend   =  now.
      478         vint = vend - vStart.
      479         vint = iInterval - vint / 1000.
      480         if     not mWaitFramStop
      481            and vint > 0
      482         then do:
      483            run gbl/pause.p (vint * 1000).
      484         end.
      485         if iInterval ne ?
      486         then
      487            publish "WaitFramStop".
      488         waitfram-check-timeout().
      489      end.
      490      procedure WaitFramWaitFor:
      491         define input  parameter iInterval as dec no-undo.
      492         assign
      493            mWaitFramStartProc   = now
      494            mWaitFramStopUser    = no
      495            mWaitFramStopTimeOut = no
      496         .
      497         block-wait:
      498         do while not mWaitFramStop:
      499            run WaitFramRunPause (iInterval).
      500            if  waitfram-check-timeout()
      501            then do:
      502               leave block-wait.
      503            end.
      504         end.
      505         run waitfram-hide.
      506      end.
      507   procedure waitfram-join :
      508     define input  parameter p-line-1  as character no-undo .
      509     define input  parameter p-line-2  as character no-undo .
      510     define input  parameter p-line-3  as character no-undo .
      511     define output parameter p-message as character no-undo .
      512     do
      513     on error undo, return error return-value
      514     :
      515       assign
      516         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      517                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      518                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      519       .
      520     end.
      521   end procedure.
      522   function waitfram-join-function returns character
      523     (input p-line-1 as character
      524     ,input p-line-2 as character
      525     ,input p-line-3 as character
      526     ).
      527     define variable v-message as character no-undo .
      528     run waitfram-join in this-procedure
      529       (input  p-line-1
      530       ,input  p-line-2
      531       ,input  p-line-3
      532       ,output v-message
      533       ) .
      534     return v-message .
      535   end function .
      536   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   procedure rt-cnvdc_decode :
      538     define input  parameter p-encoded-str as character no-undo .
      539     define output parameter p-decoded-str as character no-undo .
      540   do
      541   on error undo, return error return-value
      542   :
      543     define variable v-decoded-str as character no-undo .
      544     assign
      545       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      546       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      547       p-decoded-str = v-decoded-str
      548     .
      549   end.
      550   end procedure.
      551   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   procedure strtdate :
      553     define input  parameter p-str         as character no-undo .
      554     define output parameter p-value       as date      no-undo .
      555     define output parameter p-data-valid  as logical   no-undo .
      556     define output parameter p-message     as character no-undo .
      557   do
      558   on error undo, return error return-value
      559   :
      560     define variable v-value       as date      no-undo .
      561     define variable v-i           as integer   no-undo .
      562     define variable v-num         as integer   no-undo .
      563     define variable v-delim       as character no-undo .
      564     define variable v-delim-list  as character no-undo .
      565     define variable v-day         as integer   no-undo .
      566     define variable v-month       as integer   no-undo .
      567     define variable v-year        as integer   no-undo .
      568     define variable v-day-str     as character no-undo .
      569     define variable v-month-str   as character no-undo .
      570     define variable v-year-str    as character no-undo .
      571     assign
      572       p-value       = ?
      573       p-data-valid  = false
      574     .
      575     if p-str = ?
      576     then do:
      577       assign
      578         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      579       .
      580       return .
      581     end.
      582     if p-str = ""
      583     then do:
      584       assign
      585         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      586       .
      587       return .
      588     end.
      589     if length(p-str)  > 10
      590     then do:
      591       assign
      592         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      593       .
      594       return .
      595     end.
      596     assign
      597       v-delim-list = '/,-,.':U
      598     .
      599     _delim:
      600     do v-i = 1 to num-entries( v-delim-list )
      601     :
      602       assign
      603         v-delim = entry( v-i , v-delim-list )
      604         v-num   = num-entries( p-str , v-delim )
      605       .
      606       if v-num <> 3
      607       then do:
      608         assign
      609           v-delim = ''
      610         .
      611       end.
      612       else do:
      613         leave _delim.
      614       end.
      615     end.
      616     if v-delim = ''
      617     then do:
      618       assign
      619         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      620       .
      621       return .
      622     end.
      623     assign
      624       v-day-str   = entry( 1, p-str , v-delim)
      625       v-month-str = entry( 2, p-str , v-delim)
      626       v-year-str  = entry( 3, p-str , v-delim)
      627     .
      628     if  length(v-day-str) > 2   or
      629         length(v-day-str) < 1   or
      630         length(v-month-str) > 2 or
      631         length(v-month-str) < 1 or
      632         (
      633           length(v-year-str) <> 2 and
      634           length(v-year-str) <> 4
      635         )
      636     then do:
      637       assign
      638         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      639       .
      640       return .
      641     end.
      642     if length( v-year-str ) = 2
      643     then do:
      644       assign
      645         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      646       .
      647     end.
      648     assign
      649       v-day   = integer( v-day-str )
      650       v-month = integer( v-month-str)
      651       v-year  = integer( v-year-str)
      652     no-error .
      653     if error-status :error
      654     then do:
      655       assign
      656         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      657       .
      658       return .
      659     end.
      660     if v-day < 1  or
      661        v-day > 31 or
      662        v-month < 1 or
      663        v-month > 12 or
      664        v-year < 0   or
      665        v-year > 5000
      666     then do:
      667       assign
      668         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      669       .
      670       return .
      671     end.
      672     assign
      673       v-value = date( v-month, v-day, v-year )
      674     no-error .
      675     if error-status :error
      676     then do:
      677       assign
      678         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      679       .
      680       return .
      681     end.
      682     assign
      683       p-value       = v-value
      684       p-data-valid  = true
      685     .
      686   end.
      687   end procedure.
      688       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      689       define buffer   in-vatp-parts    for ub.parts   .
      690       define buffer   in-vatp-doc      for ub.trn-doc .
      691       define buffer   in-vatp-goods    for ub.goods   .
      692       define buffer   in-vatp-sysconf  for ub.sysconf .
      693       define buffer   in-vatp_doc-attr for ub.doc-attr.
      694       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      695       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      696       define variable varinvprb                  as   character              no-undo.
      697       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      698       define variable cli-base-rate              as   decimal                no-undo.
      699       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      700       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      701       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      702       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      703       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      704       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      705       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      706       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      707       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      708       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      709       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      710       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      711       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      712       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      713       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      714       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      715       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      716       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      717       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      718       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      719       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      720       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      721       define variable varinvatp-envd             as   character              no-undo.
      722       define variable varinvatp-type             as   character              no-undo.
      723   define stream sout .
      724   define new shared buffer t-doc for ub.trn-doc.
      725   define variable v-status          as character no-undo .
      726   define variable v-error-message   as character no-undo .
      727   define variable v-unique-doc-code as character no-undo .
      728   define variable v-b-code          as integer   no-undo .
      729   define variable v-artic           as character no-undo .
      730   define variable v-name            as character no-undo .
      731   define variable v-prod-name       as character no-undo .
      732   define variable v-unit-cli        as character no-undo .
      733   define variable v-cli-base-rate   as character no-undo .
      734   define variable v-price-cli       as character no-undo .
      735   define variable v-vat-pc          as character no-undo .
      736   define variable v-curr-abbr       as character no-undo .
      737   define variable v-unit-base       as character no-undo .
      738   do
      739   on error undo, return error return-value
      740   :
      741     if p-session-valid = true
      742     then do:
      743       run check-data in this-procedure
      744         (output  v-status
      745         ,output  v-error-message
      746         ) no-error .
      747       if error-status :error
      748       then do:
      749         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      750                                     ,error-status :get-message(1)
      751                                     ,return-value
      752                                     ) .
      753       end.
      754     end.
      755     else do:
      756       assign
      757         v-status        = '1'
      758         v-error-message = p-error-message
      759       .
      760     end.
      761     define variable v-temp-file-name as character no-undo .
      762     assign
      763       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      764     .
      765     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      766     put stream sout unformatted substitute('status:&1', rtencode(v-status))
      767                                 + chr(10) .
      768     put stream sout unformatted substitute('message:&1',rtencode(v-error-message))
      769                                 + chr(10) .
      770     output stream sout close .
      771     os-delete value(p-directory-out + '/':u + p-file-name) .
      772     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      773               value(p-directory-out + '/':u + p-file-name)
      774               .
      775   end.
      776   procedure check-data :
      777     define output parameter p-status        as character no-undo .
      778     define output parameter p-error-message as character no-undo .
      779     define buffer buf_clients    for ub.clients .
      780     define buffer buf_sysconf    for ub.sysconf .
      781     define buffer buf_bar-code   for ub.bar-code .
      782     define buffer buf_goods      for ub.goods .
      783     define buffer buf_units      for ub.units .
      784     define buffer buf_doc-line   for ub.doc-line .
      785     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      786     define buffer buf_user-login for ub.user-login .
      787     define buffer buf_ext-artic  for ub.ext-artic.
      788     define variable v-bar-code          like ub.bar-code.b-code  no-undo .
      789     main_block:
      790     do transaction
      791     on error undo main_block, return error return-value
      792     :
      793       find first buf_sys-ctrl no-lock .
      794       find first buf_user-login no-lock
      795         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      796           and buf_user-login.status_    = 0
      797           and buf_user-login.user-login = p-user-login
      798         no-error .
      799       if not available buf_user-login
      800       then do:
      801         assign
      802           p-status        = '1'
      803           p-error-message = substitute("Неизвестный пользователь &1"
      804                                       ,p-user-login
      805                                       )
      806         .
      807         return .
      808       end.
      809       define variable v-obj-code      as integer   no-undo .
      810       define variable v-data-valid    as logical   no-undo .
      811       define variable v-error-message as character no-undo .
      812       if p-obj-code = ""
      813       then do:
      814         assign
      815           p-status        = '1'
      816           p-error-message = "Не задан код объекта"
      817         .
      818         return .
      819       end.
      820       run integerm in this-procedure
      821         (input  p-obj-code
      822         ,input  false
      823         ,input  false
      824         ,output v-obj-code
      825         ,output v-data-valid
      826         ,output v-error-message
      827         ) .
      828       if v-data-valid <> true
      829       then do:
      830         assign
      831           p-status        = '1'
      832           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      833                                       ,p-obj-code
      834                                       ,v-error-message
      835                                       )
      836         .
      837         return .
      838       end.
      839       find first buf_clients no-lock
      840         where buf_clients.obj-type = p-obj-type
      841           and buf_clients.obj-code = v-obj-code
      842         no-error .
      843       if not available buf_clients
      844       then do:
      845         assign
      846           p-status        = '1'
      847           p-error-message = substitute("Не найден объект &1 &2"
      848                                       ,p-obj-type
      849                                       ,v-obj-code
      850                                       )
      851         .
      852         return .
      853       end.
      854       if  p-obj-type <> 'маг':U
      855       and p-obj-type <> 'скл':U
      856       then do:
      857         assign
      858           p-status        = '1'
      859           p-error-message = substitute("Неправильный тип объекта &1 &2"
      860                                       ,p-obj-type
      861                                       ,v-obj-code
      862                                       )
      863         .
      864         return .
      865       end.
      866       define variable v-host-code as integer   no-undo .
      867       run integerm in this-procedure
      868         (input  p-host-code
      869         ,input  false
      870         ,input  false
      871         ,output v-host-code
      872         ,output v-data-valid
      873         ,output v-error-message
      874         ) .
      875       if v-data-valid <> true
      876       then do:
      877         assign
      878           p-status        = '1'
      879           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      880                                       ,p-host-code
      881                                       ,v-error-message
      882                                       )
      883         .
      884         return .
      885       end.
      886       define variable v-obj-host-code as integer   no-undo .
      887   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      888   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      889     (input  buf_clients.obj-type
      890     ,input  buf_clients.obj-code
      891     ,output v-obj-host-code
      892     )  .
      893       if v-host-code <> v-obj-host-code
      894       then do:
      895         assign
      896           p-status        = '1':u
      897           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      898                                       ,p-host-code
      899                                       ,v-obj-host-code
      900                                       ,buf_clients.obj-type
      901                                       ,buf_clients.obj-code
      902                                       )
      903         .
      904         return .
      905       end.
      906       find first buf_sysconf no-lock
      907         where buf_sysconf.host-code = v-host-code
      908         no-error .
      909       if not available buf_sysconf
      910       then do:
      911         assign
      912           p-status        = '1'
      913           p-error-message = substitute("Не найдена фирма &1"
      914                                       ,v-host-code
      915                                       )
      916         .
      917         return .
      918       end.
      919       define variable v-prod-artic-search as logical   no-undo .
      920       if( lookup ( p-prod-artic-search , '0,1':U ) = 0 )
      921       then do:
      922         assign
      923           p-status        = '1'
      924           p-error-message = substitute("Недопустимое значение поля prod_artic_search: &1"
      925                                       ,p-prod-artic-search
      926                                       )
      927         .
      928         return .
      929       end.
      930       else do:
      931         assign
      932           v-prod-artic-search = if ( p-prod-artic-search = '0') then no else yes
      933         .
      934       end.
      935       define variable v-cop-check as logical   no-undo .
      936       if( lookup ( p-cop-check , '0,1':U ) = 0 )
      937       then do:
      938         assign
      939           p-status        = '1'
      940           p-error-message = substitute("Недопустимое значение поля cop_check: &1"
      941                                       ,p-cop-check
      942                                       )
      943         .
      944         return .
      945       end.
      946       else do:
      947         assign
      948           v-cop-check = if ( p-cop-check = '0') then no else yes
      949         .
      950       end.
      951       define variable v-price-docf as decimal   no-undo .
      952       if p-price-docf = ""
      953       then do:
      954         assign
      955           p-status        = '1'
      956           p-error-message = "Не задана фактическая цена"
      957         .
      958         return .
      959       end.
      960       define variable v-last-date as date      no-undo .
      961       if p-deadline-date <> "" and p-deadline-date <> ?
      962       then do:
      963         run strtdate in this-procedure ( input  p-deadline-date
      964                                        , output v-last-date
      965                                        , output v-data-valid
      966                                        , output v-error-message
      967                                        ).
      968         if v-data-valid <> true then do:
      969           assign
      970             p-status        = '1'
      971             p-error-message = substitute("Ошибка преобразования срока годности &1. &2"
      972                                         ,p-deadline-date
      973                                         ,v-error-message
      974                                         )
      975           .
      976           return .
      977         end.
      978       end.
      979       define variable v-search-doc-code as character no-undo .
      980       run rt-cnvdc_decode in this-procedure ( input   p-doc-code
      981                                             , output  v-search-doc-code
      982                                             ) .
      983       case p-doc-type
      984       :
      985         when 'ПТ':u
      986         then do:
      987           assign
      988             p-status        = '1'
      989             p-error-message = "Нельзя редактировать количества по документу для поставки"
      990           .
      991           return .
      992         end.
      993         when 'ПН':u
      994         then do:
      995           find first t-doc exclusive-lock
      996             where t-doc.doc-code = v-search-doc-code
      997             no-error .
      998           if not available t-doc
      999           then do:
     1000             assign
     1001               p-status        = '1'
     1002               p-error-message = substitute("Не найден документ &1"
     1003                                           ,v-search-doc-code
     1004                                           )
     1005             .
     1006             return .
     1007           end.
     1008           if t-doc.obj-type <> p-obj-type
     1009           or t-doc.obj-code <> v-obj-code
     1010           then do:
     1011             assign
     1012               p-status        = '1'
     1013               p-error-message = substitute("Документ &1 принадлежит объекту &2 &3"
     1014                                           ,v-search-doc-code
     1015                                           ,p-obj-type
     1016                                           ,v-obj-code
     1017                                           )
     1018             .
     1019             return .
     1020           end.
     1021           if t-doc.ext-doc-type <> 'ie':U
     1022           then do:
     1023             assign
     1024               p-status        = '1'
     1025               p-error-message = substitute("Документа &1 не является документом внешнего прихода"
     1026                                           ,v-search-doc-code
     1027                                           )
     1028             .
     1029             return .
     1030           end.
     1031           if t-doc.status_ <> 'накл':U
     1032           then do:
     1033             assign
     1034               p-status        = '1'
     1035               p-error-message = substitute("Статус документа &1 отличен от &2. Невозможно редактировать количество"
     1036                                           ,v-search-doc-code
     1037                                           ,'накл':U
     1038                                           )
     1039             .
     1040             return .
     1041           end.
     1042           define variable v-object-available as logical   no-undo .
     1043   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1045     (input  buf_sys-ctrl.db-num
     1046     ,input  0
     1047     ,input  buf_user-login.user-id
     1048     ,input  buf_clients.obj-type
     1049     ,input  buf_clients.obj-code
     1050     ,output v-object-available
     1051     )  .
     1052           if v-object-available <> true
     1053           then do:
     1054             assign
     1055               p-status        = '1':u
     1056               p-error-message = substitute("Пользователю не доступен объект &1 &2"
     1057                                           ,buf_clients.obj-type
     1058                                           ,buf_clients.obj-code
     1059                                           )
     1060             .
     1061             return .
     1062           end.
     1063           define variable v-valid-act   as logical   no-undo .
     1064   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
