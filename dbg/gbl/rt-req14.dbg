     1572               p-status        = '1':u
     1573               p-error-message = substitute('Неизвестная ошибка при создании строки документа &1 &2 &3 &4':u
     1574                                           ,v-unique-doc-code
     1575                                           ,buf_goods.artic
     1576                                           ,buf_goods.prod-type
     1577                                           ,buf_goods.prod-code
     1578                                           )
     1579             .
     1580             undo main_block, return .
     1581           end.
     1582           if v-request-line-number <> 0
     1583           then do:
     1584             assign
     1585               buf_doc-line.line-num = v-request-line-number
     1586             .
     1587           end.
     1588           define buffer buf_parts for ub.parts .
     1589           define variable varprice-check as decimal no-undo.
     1590           define variable v-price-correct as logical   no-undo .
     1591           define variable v-message       as character no-undo .
     1592           if v-last-date <> ?
     1593           then do:
     1594             for each buf_parts exclusive-lock
     1595               where buf_parts.obj-type  = buf_doc-line.obj-type
     1596                 and buf_parts.obj-code  = buf_doc-line.obj-code
     1597                 and buf_parts.artic     = buf_doc-line.artic
     1598                 and buf_parts.prod-type = buf_doc-line.prod-type
     1599                 and buf_parts.prod-code = buf_doc-line.prod-code
     1600                 and buf_parts.in-code   = buf_doc-line.doc-code
     1601             :
     1602               assign
     1603                 buf_parts.last-date = v-last-date
     1604               .
     1605             end.
     1606           end.
     1607           assign
     1608             p-status        = '0':u
     1609             p-error-message = '':u
     1610           .
     1611           return .
     1612         end.
     1613         otherwise do:
     1614           assign
     1615             p-status        = '1':u
     1616             p-error-message = substitute("Неизвестный тип документа &1"
     1617                                         ,p-doc-type
     1618                                         )
     1619           .
     1620           undo main_block, return .
     1621         end.
     1622       end case .
     1623       assign
     1624         p-status        = '1'
     1625         p-error-message = "Неизвестная ошибка"
     1626       .
     1627       undo main_block, return .
     1628     end.
     1629   end procedure.
