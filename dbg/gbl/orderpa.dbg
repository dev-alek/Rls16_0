     1100   I-ord-ofof:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
     1101   run thbjattr_tooltip in this-procedure (
     1102                input   'ord-global':U
     1103               ,input  "ord-oobj"
     1104               ,output v-tooltip
     1105               ,output v-label
     1106               ,output v-tooltip-code
     1107               ) no-error .
     1108   v-ord-oobj:screen-value = entry(2,v-label,":") .
     1109   I-ord-oobj:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
     1110   run thbjattr_tooltip in this-procedure (
     1111                input   'ord-global':U
     1112               ,input  "ord-op"
     1113               ,output v-tooltip
     1114               ,output v-label
     1115               ,output v-tooltip-code
     1116               ) no-error .
     1117   v-ord-op:screen-value = entry(2,v-label,":") .
     1118   I-ord-op:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
     1119   run thbjattr_tooltip in this-procedure (
     1120                input   'ord-global':U
     1121               ,input  "ordshipd"
     1122               ,output v-tooltip
     1123               ,output v-label
     1124               ,output v-tooltip-code
     1125               ) no-error .
     1126   v-ordshipd:screen-value = entry(2,v-label,":") .
     1127   I-ordshipd:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
     1128   run thbjattr_tooltip in this-procedure (
     1129                input   'ord-global':U
     1130               ,input  "ordcyclg"
     1131               ,output v-tooltip
     1132               ,output v-label
     1133               ,output v-tooltip-code
     1134               ) no-error .
     1135   v-ordcyclg:screen-value = entry(2,v-label,":") .
     1136   I-ordcyclg:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
     1137   run thbjattr_tooltip in this-procedure (
     1138                input   'ord-global':U
     1139               ,input  "ord-min-ost-day"
     1140               ,output v-tooltip
     1141               ,output v-label
     1142               ,output v-tooltip-code
     1143               ) no-error .
     1144   v-ord-min-ost-day:screen-value = entry(2,v-label,":") .
