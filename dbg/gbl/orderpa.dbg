     1191   END PROCEDURE.
     1192   PROCEDURE init-proc :
     1193   define variable v-i as integer   no-undo .
     1194   define variable v-value-character as character no-undo .
     1195   define variable v-value-date as date no-undo .
     1196   define variable v-value-decimal as decimal no-undo .
     1197   define variable v-value-integer as INTEGER no-undo .
     1198   define variable v-value-logical AS LOGICAL no-undo .
     1199   define variable v-type as character no-undo .
     1200   define variable v-value as character no-undo .
     1201   define variable v-found as decimal   no-undo .
     1202     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1203       find first bufglbl_thbj-attr exclusive-lock where
     1204                 bufglbl_thbj-attr.obj-type = ""
     1205           and   bufglbl_thbj-attr.obj-code = 0
     1206           and   bufglbl_thbj-attr.upper-prop-code = 'ord-global':U
     1207           and   bufglbl_thbj-attr.prop-code = '':u no-wait no-error.
     1208        if locked bufglbl_thbj-attr then do:
     1209           message
     1210           vss-workfile vss-revision vss-description skip
     1211           'ord-global':U skip
     1212           "Запись Глобальных ПАРАМЕТРОВ ord занята"
     1213           view-as alert-box error .
     1214           undo, return error.
     1215         end.
     1216     end.
     1217     else do:
     1218       find first bufglbl_thbj-attr no-lock where
     1219             bufglbl_thbj-attr.obj-type = ""
     1220       and   bufglbl_thbj-attr.obj-code = 0
     1221       and   bufglbl_thbj-attr.upper-prop-code = 'ord-global':U
     1222       and   bufglbl_thbj-attr.prop-code = '':u no-error.
     1223     end.
     1224     if not available bufglbl_thbj-attr then do:
     1225       assign
     1226         v-to-create-glbl  = true
     1227         .
     1228       message
     1229       substitute ("Внимание!!!&1Параметра ord-gbl НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1230                   chr(10))
     1231                    view-as alert-box warning.
     1232     end.
     1233      find first bufobj_thbj-attr exclusive-lock where
     1234                 bufobj_thbj-attr.obj-type = p-obj-type
     1235           and   bufobj_thbj-attr.obj-code = p-obj-code
     1236           and   bufobj_thbj-attr.upper-prop-code = 'ord-obj':U
     1237           and   bufobj_thbj-attr.prop-code = '':u no-wait no-error.
     1238        if locked bufobj_thbj-attr then do:
     1239           message
     1240           "Запись ПАРАМЕТРОВ ord-obj занята"
     1241           view-as alert-box error .
     1242           undo, return error.
     1243     end.
     1244     else do:
     1245       find first bufobj_thbj-attr no-lock where
     1246             bufobj_thbj-attr.obj-type = p-obj-type
     1247       and   bufobj_thbj-attr.obj-code = p-obj-code
     1248       and   bufobj_thbj-attr.upper-prop-code = 'ord-obj':U
     1249       and   bufobj_thbj-attr.prop-code = '':u no-error.
     1250     end.
     1251     if not available bufobj_thbj-attr then do:
     1252       assign
     1253         v-to-create-obj  = true
     1254         .
     1255       message
     1256       substitute ("Внимание!!!&1Параметра ord-obj НЕТ в БД &2&3 !&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1257                   chr(10),
     1258                   p-obj-type ,
     1259                   p-obj-code
     1260                   )
     1261                    view-as alert-box warning.
     1262     end.
     1263     run fill-widgets in this-procedure no-error.
     1264     if error-status:error then undo, return error.
     1265     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1266        disable ord-log ord-ofof ord-oobj ord-op ordshipd ord-min-ost-day  ord-askp ord-11 ord-obj-rc b-cli ordcyclg  with frame Dialog-Frame.
     1267        B-exit:label = "Вы&ход"  .
     1268        hide B-quit in frame Dialog-Frame .
     1269     END.
     1270     if p-obj-type <> "" then do:
     1271        disable ord-log ord-ofof ord-oobj ord-op ord-min-ost-day ordshipd ordcyclg with frame Dialog-Frame.
     1272     end.
     1273   end procedure.
     1274   PROCEDURE init-tt :
     1275   END PROCEDURE.
     1276   PROCEDURE save-proc :
     1277   define variable v-value-character as character no-undo .
     1278   define variable v-value-date as date no-undo .
     1279   define variable v-value-decimal as decimal no-undo .
     1280   define variable v-value-integer as INTEGER no-undo .
     1281   define variable v-value-logical AS LOGICAL no-undo .
     1282   define variable v-sale-add as character no-undo .
     1283   define variable v-trf-type like ub.clients.obj-type no-undo .
     1284   define variable v-trf-code like ub.clients.obj-code no-undo .
     1285   define variable v-param-type as character no-undo .
     1286   define variable wh as widget-handle no-undo .
     1287   define variable fh as widget-handle no-undo .
     1288   define variable v-same-glbl as logical no-undo .
     1289   define variable v-same-obj  as logical no-undo .
     1290   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1291   define variable loc#log as logical   no-undo .
     1292   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1293   do:
     1294     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1295       (input  g#db-num
     1296       ,input  g#userid
     1297       ,input  0
     1298       ,input  'actn_global-ord_update':U
     1299       ,input  'global':U
     1300       ,input  0
     1301       ,input  '':U
     1302       ,input  0
     1303       ,input  0
     1304       ,input  0
     1305       ,input  0
     1306       ,input  true
     1307       ,output loc#log
     1308       )  .
     1309   end.
     1310     if loc#log <> yes then do: return error. end.
     1311   ASSIGN
     1312       ord-log FRAME Dialog-Frame
     1313       ord-ofof
     1314       ord-oobj
     1315       ord-op
     1316       ordshipd
     1317       ordcyclg
     1318       ord-min-ost-day
     1319       ord-askp
     1320       ord-11
     1321       ord-obj-rc
     1322       .
     1323   assign
     1324     fh = frame Dialog-Frame:first-child
     1325     wh = fh:first-child
     1326     .
     1327   do while valid-handle(wh):
     1328     if wh:private-data begins "recid2=" then do:
     1329       find first glbl_thbj-attr-ord where
     1330                 recid(glbl_thbj-attr-ord) = integer(entry(2, wh:private-data, '=')).
     1331       assign
     1332       buffer glbl_thbj-attr-ord:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1333     end.
     1334     if wh:private-data begins "recid3=" then do:
     1335       find first obj_thbj-attr-ord where
     1336                 recid(obj_thbj-attr-ord) = integer(entry(2, wh:private-data, '=')).
     1337       assign
     1338       buffer obj_thbj-attr-ord:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1339     end.
     1340     wh = wh:next-sibling.
     1341   end.
     1342   v-same-glbl = yes.
     1343   v-same-obj = yes.
     1344   for each glbl_thbj-attr-ord,
     1345       first temp-thbj-attr where
     1346             temp-thbj-attr.obj-type = glbl_thbj-attr-ord.obj-type
     1347         and temp-thbj-attr.obj-code = glbl_thbj-attr-ord.obj-code
     1348         and temp-thbj-attr.upper-prop-code = glbl_thbj-attr-ord.upper-prop-code
     1349         and temp-thbj-attr.prop-code = glbl_thbj-attr-ord.prop-code:
     1350      buffer-compare
     1351      glbl_thbj-attr-ord
     1352      to temp-thbj-attr
     1353      save result in v-same-glbl.
     1354      if not v-same-glbl then leave.
     1355   end.
     1356   v-same-glbl = no.
     1357   for each obj_thbj-attr-ord,
     1358       first temp-thbj-attr where
     1359             temp-thbj-attr.obj-type = obj_thbj-attr-ord.obj-type
     1360         and temp-thbj-attr.obj-code = obj_thbj-attr-ord.obj-code
     1361         and temp-thbj-attr.upper-prop-code = obj_thbj-attr-ord.upper-prop-code
     1362         and temp-thbj-attr.prop-code       = obj_thbj-attr-ord.prop-code:
     1363      buffer-compare
     1364      obj_thbj-attr-ord
     1365      to temp-thbj-attr
     1366      save result in v-same-obj.
     1367      if not v-same-obj then leave.
     1368   end.
     1369   v-same-obj = no.
     1370   do TRANSACTION
     1371   on error undo, return error return-value
     1372   :
     1373     run thbjattr_set-section in this-procedure (
     1374          input ""
     1375         ,input 0
     1376         ,input 'ord-global':U
     1377         ,input table glbl_thbj-attr-ord
     1378     ) no-error.
     1379     if error-status:error then do:
     1380       message error-status:get-message(1)  skip
     1381       return-value
     1382       view-as alert-box.
     1383       undo, return error.
     1384     end.
     1385     run thbjattr_set-section in this-procedure (
     1386          input p-obj-type
     1387         ,input p-obj-code
     1388         ,input 'ord-obj':U
     1389         ,input table obj_thbj-attr-ord
     1390     ) no-error.
     1391     if error-status:error then do:
     1392       message error-status:get-message(1)  skip
     1393       return-value
     1394       view-as alert-box.
     1395       undo, return error.
     1396     end.
     1397   end.
     1398   END PROCEDURE.
