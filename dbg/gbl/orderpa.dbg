     1148               ,input  "ord-askp"
     1149               ,output v-tooltip
     1150               ,output v-label
     1151               ,output v-tooltip-code
     1152               ) no-error .
     1153   v-ord-askp:screen-value = entry(2,v-label,":") .
     1154   I-ord-askp:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
