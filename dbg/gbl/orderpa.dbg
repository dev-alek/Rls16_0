     1045        ord-min-ost-day:private-data = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1046       display ord-min-ost-day with frame Dialog-Frame .
     1047     END.
     1048     create temp-thbj-attr.
     1049     buffer-copy glbl_thbj-attr-ord to temp-thbj-attr.
     1050   END.
     1051   FOR EACH obj_thbj-attr-ord:
     1052     IF obj_thbj-attr-ord.prop-code = 'ord-askp':U THEN DO:
     1053        ord-askp = obj_thbj-attr-ord.property-value-logical.
     1054        ord-askp:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid3=" + string(recid(obj_thbj-attr-ord)).
     1055        display ord-askp with frame Dialog-Frame .
     1056     END.
     1057     IF obj_thbj-attr-ord.prop-code = 'ord-obj-rc':U THEN DO:
     1058        ord-obj-rc = obj_thbj-attr-ord.property-value-character.
     1059        ord-obj-rc:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid3=" + string(recid(obj_thbj-attr-ord)).
     1060        display ord-obj-rc with frame Dialog-Frame .
     1061     END.
     1062     IF obj_thbj-attr-ord.prop-code = 'ord-wgt-div-prc':U THEN DO:
     1063        ord-wgt-div-prc = obj_thbj-attr-ord.property-value-decimal.
     1064        ord-wgt-div-prc:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid3=" + string(recid(obj_thbj-attr-ord)).
     1065        display ord-wgt-div-prc with frame Dialog-Frame .
     1066     END.
     1067     IF obj_thbj-attr-ord.prop-code = 'ord-comp-prc':U THEN DO:
     1068        ord-comp-prc = obj_thbj-attr-ord.property-value-decimal.
     1069        ord-comp-prc:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid3=" + string(recid(obj_thbj-attr-ord)).
     1070        display ord-comp-prc with frame Dialog-Frame .
     1071     END.
     1072     IF obj_thbj-attr-ord.prop-code = 'ord-11':U THEN DO:
     1073        ord-11 = obj_thbj-attr-ord.property-value-logical.
     1074        ord-11:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid3=" + string(recid(obj_thbj-attr-ord)).
     1075        display ord-11 with frame Dialog-Frame .
     1076     END.
     1077     create temp-thbj-attr.
     1078     buffer-copy obj_thbj-attr-ord to temp-thbj-attr.
     1079   END.
     1080   define variable v-tooltip as character no-undo .
     1081   define variable v-label   as character no-undo .
     1082   define variable v-tooltip-code as character no-undo .
     1083   run thbjattr_tooltip in this-procedure (
     1084                input   'ord-global':U
     1085               ,input  "ord-log"
     1086               ,output v-tooltip
     1087               ,output v-label
     1088               ,output v-tooltip-code
     1089               ) no-error .
     1090   v-ord-log:screen-value = entry(2,v-label,":") .
     1091   I-ord-log:private-data =  REPLACE ( v-tooltip-code , '`' , ',' ).
     1092   run thbjattr_tooltip in this-procedure (
     1093                input   'ord-global':U
     1094               ,input  "ord-ofof"
     1095               ,output v-tooltip
     1096               ,output v-label
     1097               ,output v-tooltip-code
     1098               ) no-error .
