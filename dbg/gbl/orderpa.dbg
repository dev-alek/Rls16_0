      783   END.
      784   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      785   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      786   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   on help of frame Dialog-Frame
      788   do:
      789     run gbl/app_help.p
      790       (input this-procedure :file-name
      791       ,input ''
      792       ,input ?
      793       ) no-error.
      794     if error-status :error then do:
      795       message
      796         "Ошибка при вызове помощи"
      797         error-status :get-message(1)
      798         view-as alert-box .
      799     end.
      800   end.
      801   run minbtn-set in this-procedure .
      802   on choose of b-help in frame Dialog-Frame
      803   do:
      804     apply "help":u to frame Dialog-Frame .
      805   end.
      806   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   procedure minbtn-set :
      808       do
      809           on error undo, return error return-value
      810           :
      811           define variable ii              as integer       no-undo .
      812           define variable fh              as widget-handle no-undo .
      813           define variable hh              as widget-handle no-undo .
      814           define variable v-h             as handle        extent 4 no-undo .
      815           define variable v-name-button   as character     no-undo .
      816           define variable v-help-old-x    as decimal       no-undo .
      817           define variable v-help-old-y    as decimal       no-undo .
      818           define variable v-help-old-size as decimal       no-undo .
      819           define variable v-frame-width   as decimal       no-undo .
      820           define variable jj              as integer       no-undo .
      821           do
      822               on error undo, return error
      823               :
      824               assign
      825                   v-frame-width = frame Dialog-Frame:width - 0.3
      826                   fh            = frame Dialog-Frame:first-child
      827                   hh            = fh:first-child
      828                   ii            = 1
      829                   .
      830               do while valid-handle(hh):
      831                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      832                   do:
      833                       case lc(hh:name) :
      834                           when "b-help" then
      835                               do:
      836                                   hh:load-image-up("cmp/b-help.bmp":u) .
      837                                   hh:load-image-down("cmp/b-help.bmp":u) .
      838                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      839                                   hh:TOOLTIP = "Помощь" .
      840                                   v-help-old-x = hh:column .
      841                                   v-help-old-y = hh:row    .
      842                                   v-help-old-size = hh:width .
      843                                   hh:width-chars = 2.5 .
      844                               end.
      845                           when "b-print" then
      846                               do:
      847                                   hh:load-image("cmp/b-print.bmp":u) .
      848                                   hh:TOOLTIP = "Печать" .
      849                                   v-h[ii] = hh:handle .
      850                                   ii = ii + 1 .
      851                                   hh:width-chars = 3 .
      852                               end.
      853                           when "b-history" or
      854                           when "b-hist" then
      855                               do:
      856                                   hh:load-image("cmp/b-hist.bmp":u) .
      857                                   hh:TOOLTIP = "История" .
      858                                   v-h[ii] = hh:handle .
      859                                   ii = ii + 1 .
      860                                   hh:width-chars = 3 .
      861                               end.
      862                           when "b-sch" then
      863                               do:
      864                                   hh:load-image("cmp/b-sch.bmp":u) .
      865                                   hh:TOOLTIP = "Установка Фильтра" .
      866                                   v-h[ii] = hh:handle .
      867                                   ii = ii + 1 .
      868                                   hh:width-chars = 3 .
      869                               end.
      870                           when "b-hist-user" then
      871                               do:
      872                                   hh:load-image("cmp/b-hist.bmp":u) .
      873                                   hh:TOOLTIP = "История пользователя" .
      874                                   ii = ii + 1 .
      875                               end.
      876                       end case.
      877                   end.
      878                   hh = hh:next-sibling.
      879               end.
      880               b-help:column = v-frame-width - b-help:width-chars.
      881               jj = 0.
      882               repeat ii = 4 to 1 by -1 :
      883                   if valid-handle (v-h[ii] ) then
      884                   do:
      885                       jj  = jj + 1 .
      886                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      887                       v-h[ii]:row    = v-help-old-y .
      888                   end.
      889               end.
      890           end.
      891       end.
      892   end procedure.
      893   MAIN-BLOCK:
      894   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      895      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      896   define variable loc#log as logical   no-undo .
      897   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   do:
      899     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      900       (input  g#db-num
      901       ,input  g#userid
      902       ,input  0
      903       ,input  'actn_global-ord_lookup':U
      904       ,input  'global':U
      905       ,input  0
      906       ,input  '':U
      907       ,input  0
      908       ,input  0
      909       ,input  0
      910       ,input  0
      911       ,input  true
      912       ,output loc#log
      913       )  .
      914   end.
      915     if loc#log <> yes then do:
      916        return.
      917     end.
      918     if p-obj-type <> "" then do:
      919        FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code) .
      920     end.
      921       RUN init-tt.
      922       RUN enable_UI.
      923       RUN init-proc.
      924     WAIT-FOR GO OF FRAME Dialog-Frame.
      925   END.
      926   RUN disable_UI.
      927   PROCEDURE disable_UI :
      928     HIDE FRAME Dialog-Frame.
      929   END PROCEDURE.
      930   PROCEDURE enable_UI :
      931     DISPLAY ord-log ord-ofof ord-oobj ord-op ord-min-ost-day ord-askp ordshipd
      932             ordcyclg ord-wgt-div-prc ord-11 ord-comp-prc v-ord-log v-ord-ofof
      933             v-ord-oobj v-ord-op v-ord-min-ost-day v-ord-askp ord-obj-rc
      934             v-ord-obj-rc v-ordshipd v-ordcyclg v-ord-wgt-div-prc v-ord-11
      935             v-ord-comp-prc
      936         WITH FRAME Dialog-Frame.
      937     ENABLE B-exit B-quit B-Help I-ord-log I-ord-ofof I-ord-oobj I-ord-op
      938            I-ord-min-ost-day I-ord-askp I-ord-obj-rc I-ordshipd I-ordcyclg
      939            I-ord-wgt-div-prc I-ord-11 I-ord-comp-prc ord-log ord-ofof ord-oobj
      940            ord-op ord-min-ost-day B-attr-ord-askp ord-askp B-attr-ord-obj-rc
      941            B-cli ordshipd ordcyclg B-attr-ord-wgt-div-prc ord-wgt-div-prc
      942            B-attr-ord-11 ord-11 B-attr-ord-comp-prc ord-comp-prc v-ord-log
      943            v-ord-ofof v-ord-oobj v-ord-op v-ord-min-ost-day v-ord-askp ord-obj-rc
      944            v-ord-obj-rc v-ordshipd v-ordcyclg v-ord-wgt-div-prc v-ord-11
      945            v-ord-comp-prc
      946         WITH FRAME Dialog-Frame.
      947     VIEW FRAME Dialog-Frame.
      948   END PROCEDURE.
      949   PROCEDURE fill-widgets :
      950   define variable v-value-character as character no-undo .
      951   define variable v-value-date as date no-undo .
      952   define variable v-value-decimal as decimal no-undo .
      953   define variable v-value-integer as INTEGER no-undo .
      954   define variable v-value-logical AS LOGICAL no-undo .
      955   define variable v-param-type as character no-undo .
      956   define variable v-param-value as character no-undo .
      957   for each thbjattr_thbj-attr:
      958     delete thbjattr_thbj-attr.
      959   end.
      960   for each glbl_thbj-attr-ord:
      961     delete glbl_thbj-attr-ord.
      962   end.
      963   for each obj_thbj-attr-ord:
      964     delete obj_thbj-attr-ord.
      965   end.
      966   for each temp-thbj-attr:
      967     delete temp-thbj-attr.
      968   end.
      969   run adm/shattri.p (
      970       input "init":U
      971     , input ""
      972     , input 0
      973     , input 'ord-global':U
      974     , input "":U
      975     , output v-value-character
      976     , output v-value-date
      977     , output v-value-decimal
      978     , output v-value-integer
      979     , output v-value-logical
      980     , output v-param-type
      981     , input-output TABLE-HANDLE v-tth-glbl
      982     ) no-error .
      983   if error-status:error then do:
      984     message
      985     "Не удалось получить начальные значения настроек" skip
      986     error-status:get-message(1) return-value
      987     view-as alert-box error .
      988     undo, return error .
      989   end.
      990   run adm/shattri.p (
      991       input "init":U
      992     , input p-obj-type
      993     , input p-obj-code
      994     , input 'ord-obj':U
      995     , input "":U
      996     , output v-value-character
      997     , output v-value-date
      998     , output v-value-decimal
      999     , output v-value-integer
     1000     , output v-value-logical
     1001     , output v-param-type
     1002     , input-output TABLE-HANDLE v-tth-obj
     1003     ) no-error .
     1004   if error-status:error then do:
     1005     message
     1006     "Не удалось получить начальные значения настроек" skip
     1007     error-status:get-message(1) return-value
     1008     view-as alert-box error .
     1009     undo, return error .
     1010   end.
     1011   FOR EACH glbl_thbj-attr-ord
     1012     :
     1013     IF glbl_thbj-attr-ord.prop-code = 'ord-log':U THEN DO:
     1014        ord-log = glbl_thbj-attr-ord.property-value-logical.
     1015        ord-log:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1016        display ord-log with frame Dialog-Frame .
     1017     END.
     1018     IF glbl_thbj-attr-ord.prop-code = 'ord-ofof':U THEN DO:
     1019        ord-ofof = glbl_thbj-attr-ord.property-value-logical.
     1020        ord-ofof:private-data = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1021        display ord-ofof with frame Dialog-Frame .
     1022     END.
     1023     IF glbl_thbj-attr-ord.prop-code = 'ord-oobj':U THEN DO:
     1024        ord-oobj = glbl_thbj-attr-ord.property-value-logical.
     1025        ord-oobj:private-data = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1026        display ord-oobj with frame Dialog-Frame .
     1027     END.
