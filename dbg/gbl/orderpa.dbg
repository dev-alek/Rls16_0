     1035        ordshipd:private-data = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1036       display ordshipd with frame Dialog-Frame .
     1037     END.
     1038     IF glbl_thbj-attr-ord.prop-code = 'ordcyclg':U THEN DO:
     1039        ordcyclg = glbl_thbj-attr-ord.property-value-logical.
     1040        ordcyclg:private-data = "recid2=" + string(recid(glbl_thbj-attr-ord)).
     1041       display ordcyclg with frame Dialog-Frame .
