      705         ('ord-obj':U,
      706          'ord-wgt-div-prc':U
      707          ).
      708   END.
      709   ON CHOOSE OF B-cli IN FRAME Dialog-Frame
      710   DO:
      711     define variable rid-list    as  char no-undo .
      712     def buffer buf_clients for ub.clients.
      713       run ref/cli-all.w
      714       ( input parParentProc,
      715         input "b-sel",
      716         input 'объект':U,
      717         input ?,
      718         input ?,
      719         input ? ,
      720         input ",,,,,,NO"   ,
      721         input "lock-cli-type",
      722         output  rid-list
      723         ) .
      724       find first buf_clients where recid(buf_clients) = integer(rid-list) no-lock no-error.
      725       if available buf_clients
      726       then
      727           Assign
      728              ord-obj-rc = buf_clients.obj-type + string( buf_clients.obj-code)
      729              .
      730       else
      731           assign
      732             ord-obj-rc = ""
      733           .
      734       Display ord-obj-rc with frame Dialog-Frame .
      735   END.
      736   ON MOUSE-SELECT-CLICK OF I-ord-11 IN FRAME Dialog-Frame
      737   DO:
      738     MESSAGE I-ord-11:private-data  VIEW-AS ALERT-BOX INFORMATION.
      739   END.
      740   ON MOUSE-SELECT-CLICK OF I-ord-askp IN FRAME Dialog-Frame
