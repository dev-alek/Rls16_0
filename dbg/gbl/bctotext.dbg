      283   procedure bar-code_get-bits :
      284     define input  parameter p-digit   as integer   no-undo .
      285     define input  parameter p-pattern as character no-undo .
      286     define output parameter p-bits    as character no-undo .
      287     do
      288     on error undo, return error return-value
      289     :
      290       if p-digit < 0
      291       or p-digit > 9
      292       then do:
      293         message
      294           vss-workfile vss-revision vss-description skip
      295           "Ошибка задания входных параметров" skip
      296           "Неизвестное значение параметра p-pattern" skip
      297           "p-pattern" p-pattern skip
      298           view-as alert-box error .
      299         undo, return error return-value .
      300       end.
      301       case p-pattern
      302       :
      303         when "A":u
      304         then do:
      305           assign
      306             p-bits = ean13_bits_a[p-digit + 1]
      307           .
      308         end.
      309         when "B":u
      310         then do:
      311           assign
      312             p-bits = ean13_bits_b[p-digit + 1]
      313           .
      314         end.
      315         when "C":u
      316         then do:
      317           assign
      318             p-bits = ean13_bits_c[p-digit + 1]
      319           .
      320         end.
      321         otherwise
      322         do:
      323           message
      324             vss-workfile vss-revision vss-description skip
      325             "Внутренняя ошибка" skip
      326             "Неизвестное значение параметра p-pattern" skip
      327             "p-pattern" p-pattern skip
      328             view-as alert-box error .
      329           undo, return error return-value .
      330         end.
      331       end case .
      332     end.
      333   end procedure.
      334   procedure bar-code_ean8 :
      335     define input  parameter p-bar-code   as character no-undo .
      336     define output parameter p-bit-string as character no-undo .
      337     do
      338     on error undo, return error return-value
      339     :
      340       define variable v-bit-string as character no-undo .
      341       define variable v-ind        as integer   no-undo .
      342       define variable v-bits       as character no-undo .
      343       assign
      344         v-bit-string = "101"
      345       .
      346       do v-ind = 1 to 4
      347       :
      348         run bar-code_get-bits in this-procedure
      349           (input  integer(substring(p-bar-code, v-ind, 1))
      350           ,input  "A"
      351           ,output v-bits
      352           ) .
      353         assign
      354           v-bit-string = v-bit-string + v-bits
      355         .
      356       end.
      357       assign
      358         v-bit-string = v-bit-string + "01010"
      359       .
      360       do v-ind = 5 to 8
      361       :
      362         run bar-code_get-bits in this-procedure
      363           (input  integer(substring(p-bar-code, v-ind, 1))
      364           ,input  "C"
      365           ,output v-bits
      366           ) .
      367         assign
      368           v-bit-string = v-bit-string + v-bits
      369         .
      370       end.
      371       assign
      372         v-bit-string = v-bit-string + "101"
      373       .
      374       assign
      375         p-bit-string = v-bit-string
      376       .
      377     end.
      378   end procedure.
      379   procedure bar-code_ean13 :
      380     define input  parameter p-bar-code   as character no-undo .
      381     define output parameter p-bit-string as character no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385       define variable v-bit-string as character no-undo .
      386       define variable v-ind        as integer   no-undo .
      387       define variable v-pattern    as character no-undo .
      388       define variable v-bits       as character no-undo .
      389       assign
      390         v-pattern = ean13_parity[integer(substring(p-bar-code, 1, 1)) + 1]
      391       .
      392       assign
      393         v-bit-string = "101"
      394       .
      395       do v-ind = 1 to 6
      396       :
      397         run bar-code_get-bits in this-procedure
      398           (input  integer(substring(p-bar-code, v-ind + 1, 1))
      399           ,input  substring(v-pattern,  v-ind, 1)
      400           ,output v-bits
      401           ) .
      402         assign
      403           v-bit-string = v-bit-string + v-bits
      404         .
      405       end.
      406       assign
      407         v-bit-string = v-bit-string + "01010"
      408       .
      409       do v-ind = 7 to 12
      410       :
      411         run bar-code_get-bits in this-procedure
      412           (input  integer(substring(p-bar-code, v-ind + 1, 1))
      413           ,input  substring(v-pattern,  v-ind, 1)
      414           ,output v-bits
      415           ) .
      416         assign
      417           v-bit-string = v-bit-string + v-bits
      418         .
      419       end.
      420       assign
      421         v-bit-string = v-bit-string + "101"
      422       .
      423       assign
      424         p-bit-string = v-bit-string
      425       .
      426     end.
      427   end procedure.
      428   procedure bar-code_ean128 :
      429     define input  parameter p-bar-code   as character no-undo .
      430     define output parameter p-bit-string as character no-undo .
      431     define variable v-bit-string      as character no-undo .
      432     define variable v-bit-index       as integer   no-undo .
      433     define variable v-ind             as integer   no-undo .
      434     define variable v-length-bar-code as integer   no-undo .
      435     define variable v-ascii-code      as integer   no-undo .
      436     define variable v-bar-code        as integer   no-undo .
      437     define variable v-check-sum       as integer   no-undo .
      438     define variable v-current-mode    as integer   no-undo .
      439     do
      440     on error undo, return error return-value
      441     :
      442       if p-bar-code = '':u
      443       or p-bar-code = ?
      444       then do:
      445         assign
      446           p-bit-string = '':u
      447         .
      448         return .
      449       end.
      450       assign
      451         v-ascii-code = asc(substring(p-bar-code, 1, 1))
      452       .
      453       assign
      454         v-current-mode = 101
      455       .
      456       if  v-ascii-code >= 96
      457       and v-ascii-code < 128
      458       then do:
      459         assign
      460           v-current-mode = 100
      461         .
      462       end.
      463       if  v-ascii-code >= 48
      464       and v-ascii-code <= 57
      465       and asc(substring(p-bar-code, 2, 1)) >= 48
      466       and asc(substring(p-bar-code, 2, 1)) <= 57
      467       then do:
      468         assign
      469           v-current-mode = 99
      470         .
      471       end.
      472       case v-current-mode
      473       :
      474         when 101
      475         then do:
      476           assign
      477             v-bit-string = ean128_bits[103 + 1]
      478             v-bit-index  = 0
      479             v-check-sum  = 103
      480           .
      481         end.
      482         when 100
      483         then do:
      484           assign
      485             v-bit-string = ean128_bits[104 + 1]
      486             v-bit-index  = 0
      487             v-check-sum  = 104
      488           .
      489         end.
      490         when 99
      491         then do:
      492           assign
      493             v-bit-string = ean128_bits[105 + 1]
      494             v-bit-index  = 0
      495             v-check-sum  = 105
      496           .
      497         end.
      498       end.
      499       assign
      500         v-length-bar-code = length(p-bar-code)
      501       .
      502       assign
      503         v-ind = 1
      504       .
      505       do while v-ind <= v-length-bar-code
      506       :
      507         assign
      508           v-ascii-code = asc(substring(p-bar-code, v-ind, 1))
      509         .
      510         if (v-ascii-code < 32
      511             or v-ascii-code = 128
      512           )
      513         and v-current-mode <> 101
      514         then do:
      515           assign
      516             v-current-mode = 101
      517           .
      518           assign
      519             v-bit-string = v-bit-string
      520                         + ean128_bits[101 + 1]
      521             v-bit-index  = v-bit-index + 1
      522             v-check-sum  = v-check-sum
      523                         + 101 * v-bit-index
      524           .
      525         end.
      526         if  v-ascii-code >= 96
      527         and v-ascii-code < 128
      528         and v-current-mode <> 100
      529         then do:
      530           assign
      531             v-current-mode = 100
      532           .
      533           assign
      534             v-bit-string = v-bit-string
      535                          + ean128_bits[100 + 1]
      536             v-bit-index  = v-bit-index + 1
      537             v-check-sum  = v-check-sum
      538                          + 100 * v-bit-index
      539           .
      540         end.
      541         if  v-current-mode = 99
      542         and not(v-ascii-code >= 48
      543                 and v-ascii-code <= 57
      544                 and v-ind < v-length-bar-code
      545                 and asc(substring(p-bar-code, v-ind + 1, 1)) >= 48
      546                 and asc(substring(p-bar-code, v-ind + 1, 1)) <= 57
      547             )
      548         then do:
      549           if  v-ascii-code >= 96
      550           and v-ascii-code < 128
      551           then do:
      552             assign
      553               v-current-mode = 100
      554             .
      555             assign
      556               v-bit-string = v-bit-string
      557                            + ean128_bits[100 + 1]
      558               v-bit-index  = v-bit-index + 1
      559               v-check-sum  = v-check-sum
      560                            + 100 * v-bit-index
      561             .
      562           end.
      563           else do:
      564             assign
      565               v-current-mode = 101
      566             .
      567             assign
      568               v-bit-string = v-bit-string
      569                            + ean128_bits[101 + 1]
      570               v-bit-index  = v-bit-index + 1
      571               v-check-sum  = v-check-sum
      572                            + 101 * v-bit-index
      573             .
      574           end.
      575         end.
      576         if  v-ascii-code >= 48
      577         and v-ascii-code <= 57
      578         and v-ind < v-length-bar-code
      579         and asc(substring(p-bar-code, v-ind + 1, 1)) >= 48
      580         and asc(substring(p-bar-code, v-ind + 1, 1)) <= 57
      581         and v-current-mode <> 99
      582         then do:
      583           assign
      584             v-current-mode = 99
      585           .
      586           assign
      587             v-bit-string = v-bit-string
      588                          + ean128_bits[99 + 1]
      589             v-bit-index  = v-bit-index + 1
      590             v-check-sum  = v-check-sum
      591                          + 99 * v-bit-index
      592           .
      593         end.
      594         case v-current-mode
      595         :
      596           when 101
      597           then do:
      598             if  v-ascii-code = 193
      599             then do:
      600               assign
      601                 v-bar-code = 102
      602               .
      603             end.
      604             if  v-ascii-code = 194
      605             then do:
      606               assign
      607                 v-bar-code = 97
      608               .
      609             end.
      610             if  v-ascii-code = 195
      611             then do:
      612               assign
      613                 v-bar-code = 96
      614               .
      615             end.
      616             if  v-ascii-code = 196
      617             then do:
      618               assign
      619                 v-bar-code = 101
      620               .
      621             end.
      622             if  v-ascii-code >= 32
      623             and v-ascii-code <= 95
      624             then do:
      625               assign
      626                 v-bar-code = v-ascii-code - 32
      627               .
      628             end.
      629             if v-ascii-code = 128
      630             then do:
      631               assign
      632                 v-bar-code = 64
      633               .
      634             end.
      635             if v-ascii-code < 32
      636             then do:
      637               assign
      638                 v-bar-code = v-ascii-code + 64
      639               .
      640             end.
      641             assign
      642               v-ind = v-ind + 1
      643             .
      644           end.
      645           when 100
      646           then do:
      647             if  v-ascii-code = 193
      648             then do:
      649               assign
      650                 v-bar-code = 102
      651               .
      652             end.
      653             if  v-ascii-code = 194
      654             then do:
      655               assign
      656                 v-bar-code = 97
      657               .
      658             end.
      659             if  v-ascii-code = 195
      660             then do:
      661               assign
      662                 v-bar-code = 96
      663               .
      664             end.
      665             if  v-ascii-code = 196
      666             then do:
      667               assign
      668                 v-bar-code = 100
      669               .
      670             end.
      671             if  v-ascii-code >= 32
      672             then do:
      673               assign
      674                 v-bar-code = v-ascii-code - 32
      675               .
      676             end.
      677             assign
      678               v-ind = v-ind + 1
      679             .
      680           end.
      681           when 99
      682           then do:
      683             assign
      684               v-bar-code = (v-ascii-code - 48) * 10
      685                          + asc(substring(p-bar-code, v-ind + 1, 1)) - 48
      686             .
      687             assign
      688               v-ind = v-ind + 2
      689             .
      690           end.
      691         end.
      692         assign
      693           v-bit-string = v-bit-string
      694                        + ean128_bits[v-bar-code + 1]
      695           v-bit-index  = v-bit-index + 1
      696           v-check-sum  = v-check-sum
      697                        + v-bar-code * v-bit-index
      698         .
      699       end.
      700       assign
      701         v-check-sum = v-check-sum modulo 103 + 1
      702       .
      703       assign
      704         v-bit-string = v-bit-string
      705                      + ean128_bits[v-check-sum]
      706                      + ean128_bits[106 + 1]
      707       .
      708       assign
      709         p-bit-string = v-bit-string
      710       .
      711     end.
      712   end procedure.
      713   procedure bar-code_3of9 :
      714     define input  parameter p-bar-code   as character no-undo .
      715     define output parameter p-bit-string as character no-undo .
      716     define variable v-length         as integer   no-undo .
      717     define variable v-ind            as integer   no-undo .
      718     define variable v-alphabet-index as integer   no-undo .
      719     define variable v-bit-string     as character no-undo .
      720     do
      721     on error undo, return error return-value
      722     :
      723       assign
      724         v-length     = length(p-bar-code)
      725         v-bit-string = '':u
      726       .
      727       do v-ind = 1 to v-length
      728       :
      729         assign
      730           v-alphabet-index = index(bc_3of9_alphabet, substring(p-bar-code,v-ind, 1))
      731         .
      732         if v-alphabet-index = 0
      733         then do:
      734           undo, return error substitute("Неизвестный символ &1"
      735                                        ,substring(p-bar-code,v-ind, 1)
      736                                        ) .
      737         end.
      738         assign
      739           v-bit-string = v-bit-string
      740                        + (if v-bit-string <> '':u then '0':u else '':u)
      741                        + bc_3of9_bits[v-alphabet-index]
      742         .
      743       end.
      744       assign
      745         p-bit-string = v-bit-string
      746       .
      747     end.
      748   end procedure.
      749   procedure bar-code_bit-string-to-text :
      750     define input  parameter p-bit-string as character no-undo .
      751     define output parameter p-text       as character no-undo .
      752     define variable v-text as character no-undo .
      753     do
      754     on error undo, return error return-value
      755     :
      756       assign
      757         v-text = replace(p-bit-string, "1", chr(162))
      758         v-text = replace(v-text, "0", chr(161))
      759         p-text = v-text + fill( chr(161), length(v-text) modulo 5)
      760       .
      761     end.
      762   end procedure.
      763   define variable v-bit-string as character no-undo .
      764   do
      765   on error undo, return error return-value
      766   :
      767     case p-bar-code-type
      768     :
      769       when 'ean8':U
      770       then do:
      771         run bar-code_ean8 in this-procedure
      772           (input  p-bar-code
      773           ,output v-bit-string
      774           ) .
      775       end.
      776       when 'ean13':U
      777       then do:
      778         run bar-code_ean13 in this-procedure
      779           (input  p-bar-code
      780           ,output v-bit-string
      781           ) .
      782       end.
      783       when '3of9':U
      784       then do:
      785         run bar-code_3of9 in this-procedure
      786           (input  p-bar-code
      787           ,output v-bit-string
      788           ) .
      789       end.
      790       when 'ean128':U
      791       then do:
      792         run bar-code_ean128 in this-procedure
      793           (input  p-bar-code
      794           ,output v-bit-string
      795           ) .
      796       end.
      797     end case .
      798     run bar-code_bit-string-to-text in this-procedure
      799       (input  v-bit-string
      800       ,output p-text
      801       ) .
      802   end.
