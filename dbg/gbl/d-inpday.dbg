     1471   ON CHOOSE OF b-next-year IN FRAME D-Dialog
     1472   DO:
     1473   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   if lookup(self :type
     1475            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1476            ) = 0
     1477   then do:
     1478     message
     1479       "$Workfile$"
     1480       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1481       "Интерфейсный элемент" self :name  skip
     1482       "Тип" self :type  skip
     1483       "Процедура" this-procedure :file-name skip
     1484       view-as alert-box .
     1485   end.
     1486   else do:
