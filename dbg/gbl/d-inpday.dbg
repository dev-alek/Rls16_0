       75   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       76   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       77   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       78   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       79   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       80   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       81   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       82   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       83   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       84   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       85   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       86   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   procedure proc-alt-shift-f2:
      316     if not ibs.th.gbl.gbl-var:rcode
      317   then
      318     run gbl\inidebug.p .
      319   end.
      320   procedure proc-alt-shift-f3:
      321     run gbl/prvssinf.p
      322       ( input this-procedure
      323       ) .
      324   end.
      325   define variable v-inform-launched as logical no-undo initial false .
      326   procedure proc-alt-shift-f4:
      327     define variable v-action as character no-undo .
      328     if v-inform-launched = false then do:
      329       assign
      330         v-inform-launched = true
      331       .
      332       run gbl/d-inform.w
      333         (  input self
      334         ,  input this-procedure
      335         , output v-action
      336         ) no-error .
      337       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      338       assign
      339         v-inform-launched = false
      340       .
      341     end.
      342   end.
      343   procedure proc-alt-f1:
      344     run gbl/corrhelp.p
      345       (input this-procedure
      346       ) .
      347   end .
      348   on alt-shift-f2 anywhere do:
      349     run proc-alt-shift-f2.
      350   end.
      351   on alt-shift-f3 anywhere do:
      352     run proc-alt-shift-f3 in this-procedure .
      353   end.
      354   on alt-shift-f4 anywhere do:
      355     run proc-alt-shift-f4 in this-procedure.
      356   end.
      357   on alt-f1 anywhere do:
      358     run proc-alt-f1 in this-procedure .
      359   end.
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   procedure date-str :
      362     define input  parameter p-date        as date      no-undo .
      363     define output parameter p-description as character no-undo .
      364     define variable v-day-list as character no-undo extent 31 initial
      365       ["первого"
      366       ,"второго"
      367       ,"третьего"
      368       ,"четвёртого"
      369       ,"пятого"
      370       ,"шестого"
      371       ,"седьмого"
      372       ,"восьмого"
      373       ,"девятого"
      374       ,"десятого"
      375       ,"одиннадцатого"
      376       ,"двенадцатого"
      377       ,"тринадцатого"
      378       ,"четырнадцатого"
      379       ,"пятнадцатого"
      380       ,"шестнадцатого"
      381       ,"семнадцатого"
      382       ,"восемнадцатого"
      383       ,"девятнадцатого"
      384       ,"двадцатого"
      385       ,"двадцать первого"
      386       ,"двадцать второго"
      387       ,"двадцать третьего"
      388       ,"двадцать четвертого"
      389       ,"двадцать пятого"
      390       ,"двадцать шестого"
      391       ,"двадцать седьмого"
      392       ,"двадцать восьмого"
      393       ,"двадцать девятого"
      394       ,"тридцатого"
      395       ,"тридцать первого"
      396       ] .
      397     define variable v-month-list as character no-undo extent 12 initial
      398       ["января"
      399       ,"февраля"
      400       ,"марта"
      401       ,"апреля"
      402       ,"мая"
      403       ,"июня"
      404       ,"июля"
      405       ,"августа"
      406       ,"сентября"
      407       ,"октября"
      408       ,"ноября"
      409       ,"декабря"
      410       ] .
      411     define variable v-year-list as character no-undo extent 43 initial
      412       ["одна тысяча девятьсот восьмидесятого"
      413       ,"одна тысяча девятьсот восемьдесят первого"
      414       ,"одна тысяча девятьсот восемьдесят второго"
      415       ,"одна тысяча девятьсот восемьдесят третьего"
      416       ,"одна тысяча девятьсот восемьдесят четвёртого"
      417       ,"одна тысяча девятьсот восемьдесят пятого"
      418       ,"одна тысяча девятьсот восемьдесят шестого"
      419       ,"одна тысяча девятьсот восемьдесят седьмого"
      420       ,"одна тысяча девятьсот восемьдесят восьмого"
      421       ,"одна тысяча девятьсот восемьдесят девятого"
      422       ,"одна тысяча девятьсот девяностого"
      423       ,"одна тысяча девятьсот девяносто первого"
      424       ,"одна тысяча девятьсот девяносто второго"
      425       ,"одна тысяча девятьсот девяносто третьего"
      426       ,"одна тысяча девятьсот девяносто четвёртого"
      427       ,"одна тысяча девятьсот девяносто пятого"
      428       ,"одна тысяча девятьсот девяносто шестого"
      429       ,"одна тысяча девятьсот девяносто седьмого"
      430       ,"одна тысяча девятьсот девяносто восьмого"
      431       ,"одна тысяча девятьсот девяносто девятого"
      432       ,"двухтысячного"
      433       ,"две тысячи первого"
      434       ,"две тысячи второго"
      435       ,"две тысячи третьего"
      436       ,"две тысячи четвёртого"
      437       ,"две тысячи пятого"
      438       ,"две тысячи шестого"
      439       ,"две тысячи седьмого"
      440       ,"две тысячи восьмого"
      441       ,"две тысячи девятого"
      442       ,"две тысячи десятого"
      443       ,"две тысячи одиннадцатого"
      444       ,"две тысячи двенадцатого"
      445       ,"две тысячи тринадцатого"
      446       ,"две тысячи четырнадцатого"
      447       ,"две тысячи пятнадцатого"
      448       ,"две тысячи шестнадцатого"
      449       ,"две тысячи семнадцатого"
      450       ,"две тысячи восемнадцатого"
      451       ,"две тысячи девятнадцатого"
      452       ,"две тысячи двадцатого"
      453       ,"две тысячи двадцать первого"
      454       ,"две тысячи двадцать второго"
      455       ] .
      456     define variable v-year       as integer   no-undo .
      457     define variable v-year-str   as character no-undo .
      458     do
      459     on error undo, return error return-value
      460     :
      461       assign
      462         v-year = year(p-date)
      463       .
      464       if  v-year >= 1980
      465       and v-year <= 2022
      466       then do:
      467         assign
      468           v-year-str = v-year-list[v-year - 1980 + 1]
      469         .
      470       end.
      471       else do:
      472         assign
      473           v-year-str = string(v-year)
      474         .
      475       end.
      476       assign
      477         p-description = substitute("&1 &2 &3 года"
      478                                   , v-day-list[day(p-date)]
      479                                   , v-month-list[month(p-date)]
      480                                   , v-year-str
      481                                   )
      482       .
      483     end.
      484   end procedure.
