     1719   run init-tt-holyday .
     1720   if p-title <> ""
     1721   then do:
     1722     assign
     1723       frame D-Dialog :title = p-title
     1724     .
     1725   end.
     1726   on left-mouse-click of
     1727   rect-1,  rect-2,  rect-3,  rect-4,  rect-5,  rect-6,  rect-7,  rect-8,  rect-9,  rect-10,
     1728   rect-11, rect-12, rect-13, rect-14, rect-15, rect-16, rect-17, rect-18, rect-19, rect-20,
     1729   rect-21, rect-22, rect-23, rect-24, rect-25, rect-26, rect-27, rect-28, rect-29, rect-30,
     1730   rect-31, rect-32, rect-33, rect-34, rect-35, rect-36, rect-37, rect-38, rect-39, rect-40,
     1731   rect-41, rect-42 do:
     1732     run set-curr-day
     1733       (input self :name
     1734       ).
     1735   end.
     1736   on left-mouse-dblclick of
     1737   rect-1,  rect-2,  rect-3,  rect-4,  rect-5,  rect-6,  rect-7,  rect-8,  rect-9,  rect-10,
     1738   rect-11, rect-12, rect-13, rect-14, rect-15, rect-16, rect-17, rect-18, rect-19, rect-20,
     1739   rect-21, rect-22, rect-23, rect-24, rect-25, rect-26, rect-27, rect-28, rect-29, rect-30,
     1740   rect-31, rect-32, rect-33, rect-34, rect-35, rect-36, rect-37, rect-38, rect-39, rect-40,
     1741   rect-41, rect-42 do:
     1742     run set-curr-day
     1743       (input self :name
     1744       ).
     1745     if p-mode <> "holyday" then do :
     1746       apply 'choose':u to b-exit .
     1747     end.
     1748   end.
     1749   on right-mouse-click of
     1750   rect-1,  rect-2,  rect-3,  rect-4,  rect-5,  rect-6,  rect-7,  rect-8,  rect-9,  rect-10,
     1751   rect-11, rect-12, rect-13, rect-14, rect-15, rect-16, rect-17, rect-18, rect-19, rect-20,
     1752   rect-21, rect-22, rect-23, rect-24, rect-25, rect-26, rect-27, rect-28, rect-29, rect-30,
     1753   rect-31, rect-32, rect-33, rect-34, rect-35, rect-36, rect-37, rect-38, rect-39, rect-40,
     1754   rect-41, rect-42 do:
     1755     if p-mode = "holyday"
     1756     then do :
     1757       run set-holy-day
     1758         (input self :name
     1759         ).
     1760     end.
     1761   end.
