     1136   ASSIGN
     1137          RECT-9:HIDDEN IN FRAME D-Dialog           = TRUE.
     1138   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1139   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1140   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1141   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1142   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1143   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1144   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1145   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1146       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
     1147   RUN ensure-broker.
     1148   THIS-PROCEDURE:ADM-DATA =
     1149        'ADM1.1~`':U +
     1150        'SmartDialog~`':U +
     1151        'DIALOG-BOX~`':U +
     1152        'NO ~`':U +
     1153        '~`':U +
     1154        '~`':U +
     1155        '~`':U +
     1156        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1157           + "~`":U +
     1158        'Layout,Hide-on-Init~`':U +
     1159        '~`':U +
     1160        '~`':U +
     1161        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1162        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1163            THEN "^^":U
     1164        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1165             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1166   PROCEDURE adm-apply-entry :
     1167     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1168   END PROCEDURE.
     1169   PROCEDURE adm-destroy :
     1170    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1171   END PROCEDURE.
     1172   PROCEDURE adm-disable :
     1173       DISABLE b-exit b-quit b-yesterday b-today b-tomorrow b-print b-help editor-description b-prev-day b-next-day FI-date CB-Month b-prev-month b-next-month FI-Year b-prev-year b-next-year editor-holiday fi-month-name WITH FRAME D-Dialog.
     1174       RUN dispatch ('disable-fields':U).
     1175       RUN set-attribute-list ('ENABLED=no':U).
     1176       RETURN.
     1177   END PROCEDURE.
     1178   PROCEDURE adm-edit-attribute-list :
     1179         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1180         RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE adm-enable :
     1183       ENABLE UNLESS-HIDDEN b-exit b-quit b-yesterday b-today b-tomorrow b-print b-help editor-description b-prev-day b-next-day FI-date CB-Month b-prev-month b-next-month FI-Year b-prev-year b-next-year editor-holiday fi-month-name WITH FRAME D-Dialog.
     1184       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1185       RUN set-attribute-list ('ENABLED=yes':U).
     1186       RETURN.
     1187   END PROCEDURE.
     1188   PROCEDURE adm-exit :
     1189        RUN notify ('exit':U).
     1190     RETURN.
     1191   END PROCEDURE.
     1192   PROCEDURE adm-hide :
     1193     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1194   END PROCEDURE.
     1195   PROCEDURE adm-initialize :
     1196     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1197   END PROCEDURE.
     1198   PROCEDURE adm-show-errors :
     1199       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1200       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1201           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1202       END.
     1203       RETURN.
     1204   END PROCEDURE.
     1205   PROCEDURE adm-UIB-mode :
     1206     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1207   END PROCEDURE.
     1208   PROCEDURE adm-view :
     1209     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1210   END PROCEDURE.
     1211   PROCEDURE dispatch :
     1212       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1213       RUN broker-dispatch IN adm-broker-hdl
     1214           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1215       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1216   END PROCEDURE.
     1217   PROCEDURE ensure-broker :
     1218   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1219   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1220   DO:
     1221       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1222       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1223   END.
     1224   END PROCEDURE.
     1225   PROCEDURE get-attribute :
     1226     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1227     RUN broker-get-attribute IN adm-broker-hdl
     1228         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1229     RETURN RETURN-VALUE.
     1230   END PROCEDURE.
     1231   PROCEDURE get-attribute-list :
     1232     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1233     RUN broker-get-attribute-list IN adm-broker-hdl
     1234         (INPUT THIS-PROCEDURE,
     1235          INPUT ?,
     1236          OUTPUT p-attr-list) NO-ERROR.
     1237     RETURN.
     1238   END PROCEDURE.
     1239   PROCEDURE new-state :
     1240     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1241     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1242     RETURN.
     1243   END PROCEDURE.
     1244   PROCEDURE notify :
     1245     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1246     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1247     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1248         RETURN "ADM-ERROR":U.
     1249     RETURN.
     1250   END PROCEDURE.
     1251   PROCEDURE set-attribute-list :
     1252     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1253     RUN ensure-broker.
     1254     RUN broker-set-attribute-list IN adm-broker-hdl
     1255         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1256     RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE set-position :
     1259       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1260       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1261       IF VALID-HANDLE(adm-object-hdl) THEN
     1262       DO:
     1263           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1264           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1265           DO:
     1266             IF p-row = 0 THEN p-row =
     1267               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1268             IF p-col = 0 THEN p-col =
     1269               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1270           END.
     1271           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1272           DO:
     1273             parent-hdl = adm-object-hdl:PARENT.
     1274             IF p-row = 0 THEN p-row =
     1275               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1276                 parent-hdl:ROW.
     1277             IF p-col = 0 THEN p-col =
     1278               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1279                 parent-hdl:COL.
     1280           END.
     1281           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1282           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1283         ASSIGN adm-object-hdl:ROW    =   p-row
     1284                adm-object-hdl:COLUMN =   p-col.
     1285       END.
     1286       RETURN.
     1287   END PROCEDURE.
     1288   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1289       STRING(adm-object-hdl)).
     1290   PAUSE 0 BEFORE-HIDE.
     1291   PROCEDURE adm-change-page :
     1292     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1293     END PROCEDURE.
     1294   PROCEDURE delete-page :
     1295     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1296     RUN broker-delete-page IN adm-broker-hdl
     1297         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1298     END PROCEDURE.
     1299   PROCEDURE init-object :
     1300     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1301     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1302     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1303     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1304     RUN broker-init-object IN adm-broker-hdl
     1305         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1306          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1307     RETURN.
     1308   END PROCEDURE.
     1309   PROCEDURE init-pages :
     1310     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1311     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1312         INPUT p-page-list) NO-ERROR.
     1313     END PROCEDURE.
     1314   PROCEDURE select-page :
     1315     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1316     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1317         INPUT p-page#) NO-ERROR.
     1318     END PROCEDURE.
     1319   PROCEDURE view-page :
     1320     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1321     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1322         INPUT p-page#).
     1323     END PROCEDURE.
     1324   ON GO OF FRAME D-Dialog
     1325   DO:
     1326     define variable v-new-month as integer no-undo .
     1327     define variable v-new-day   as integer no-undo .
     1328     define variable v-new-year  as integer no-undo .
     1329     assign
     1330       v-new-month = integer (cb-month :screen-value)
     1331       v-new-year  = integer (fi-year  :screen-value)
     1332       v-new-day   = v-curr-day
     1333     .
     1334     assign
     1335       v-date = date(v-new-month, v-new-day, v-new-year)
     1336     .
     1337     if v-date = ?
     1338     then do:
     1339       message
     1340         "Недопустимая дата" skip
     1341         "месяц" v-new-month skip
     1342         "день"  v-new-day   skip
     1343         "год"   v-new-year  skip
     1344         view-as alert-box error .
     1345       return no-apply .
     1346     end.
     1347     if  h-callback <> ?
     1348     and valid-handle(h-callback)
     1349     then do:
     1350       if h-callback :get-signature("cb-d-inpday-validate") <> ""
     1351       then do:
     1352         define variable v-ok as logical no-undo .
     1353         define variable v-message as character no-undo .
     1354         run cb-d-inpday-validate in h-callback
     1355           (input  v-date
     1356           ,output v-ok
     1357           ,output v-message
     1358           ) no-error .
     1359         if error-status :error
     1360         then do:
     1361           message
     1362             vss-workfile vss-revision vss-description skip
     1363             "Ошибка при вызове процедуры проверки допустимости даты" skip
     1364             "Вызывающая программа" h-callback :file-name skip
     1365             "Внутренняя процедура" "cb-d-inpday-validate" skip
     1366             error-status :get-message(1) skip
     1367             return-value skip
     1368             view-as alert-box error .
     1369           return no-apply .
     1370         end.
     1371         if v-ok <> true
     1372         then do:
     1373           message
     1374             v-message
     1375             view-as alert-box information .
     1376           return no-apply .
     1377         end.
     1378       end.
     1379       else do:
     1380         message
     1381           vss-workfile vss-revision vss-description skip
     1382           "Программе был передан указатель на процедуру для проверки диапазона дат" skip
     1383           "В вызывающей программе отсутствует внутренняя процедура" "cb-d-inpday-validate" skip
     1384           "Вызывающая программа" h-callback :file-name skip
     1385           view-as alert-box error .
     1386         return no-apply .
     1387       end.
     1388     end.
     1389     assign
     1390       p-date = v-date
     1391       p-ok   = true
     1392     .
     1393   END.
     1394   ON WINDOW-CLOSE OF FRAME D-Dialog
     1395   DO:
     1396     APPLY "END-ERROR":U TO SELF.
     1397   END.
     1398   ON CHOOSE OF b-exit IN FRAME D-Dialog
     1399   DO:
     1400   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   if lookup(self :type
     1402            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1403            ) = 0
     1404   then do:
     1405     message
     1406       "$Workfile$"
     1407       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1408       "Интерфейсный элемент" self :name  skip
     1409       "Тип" self :type  skip
     1410       "Процедура" this-procedure :file-name skip
     1411       view-as alert-box .
     1412   end.
     1413   else do:
     1414     apply "entry":u to self  .
     1415     if focus :handle <> self :handle  then do:
     1416       return no-apply .
     1417     end.
     1418   end.
     1419      run save-holyday in this-procedure .
     1420   END.
     1421   ON CHOOSE OF b-next-day IN FRAME D-Dialog
     1422   DO:
     1423   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   if lookup(self :type
     1425            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1426            ) = 0
     1427   then do:
     1428     message
     1429       "$Workfile$"
     1430       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1431       "Интерфейсный элемент" self :name  skip
     1432       "Тип" self :type  skip
     1433       "Процедура" this-procedure :file-name skip
     1434       view-as alert-box .
     1435   end.
     1436   else do:
     1437     apply "entry":u to self  .
     1438     if focus :handle <> self :handle  then do:
     1439       return no-apply .
     1440     end.
     1441   end.
     1442     run select-day in this-procedure
     1443       (input 1
     1444       ).
     1445   END.
     1446   ON CHOOSE OF b-next-month IN FRAME D-Dialog
     1447   DO:
     1448   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1449   if lookup(self :type
     1450            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1451            ) = 0
     1452   then do:
     1453     message
     1454       "$Workfile$"
     1455       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1456       "Интерфейсный элемент" self :name  skip
     1457       "Тип" self :type  skip
     1458       "Процедура" this-procedure :file-name skip
     1459       view-as alert-box .
     1460   end.
     1461   else do:
     1462     apply "entry":u to self  .
     1463     if focus :handle <> self :handle  then do:
     1464       return no-apply .
     1465     end.
     1466   end.
     1467     run select-month in this-procedure
     1468       (input 1
