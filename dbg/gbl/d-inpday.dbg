       71   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       72   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       73   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
