     1859   .
     1860   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1861   on help of frame D-Dialog
     1862   do:
     1863     run gbl/app_help.p
     1864       (input this-procedure :file-name
     1865       ,input ''
     1866       ,input ?
     1867       ) no-error.
     1868     if error-status :error then do:
     1869       message
     1870         "Ошибка при вызове помощи"
     1871         error-status :get-message(1)
     1872         view-as alert-box .
     1873     end.
     1874   end.
     1875   run minbtn-set in this-procedure .
     1876   on choose of b-help in frame D-Dialog
     1877   do:
     1878     apply "help":u to frame D-Dialog .
     1879   end.
     1880   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1881   procedure minbtn-set :
     1882       do
     1883           on error undo, return error return-value
     1884           :
     1885           define variable ii              as integer       no-undo .
     1886           define variable fh              as widget-handle no-undo .
     1887           define variable hh              as widget-handle no-undo .
     1888           define variable v-h             as handle        extent 4 no-undo .
     1889           define variable v-name-button   as character     no-undo .
     1890           define variable v-help-old-x    as decimal       no-undo .
     1891           define variable v-help-old-y    as decimal       no-undo .
     1892           define variable v-help-old-size as decimal       no-undo .
     1893           define variable v-frame-width   as decimal       no-undo .
     1894           define variable jj              as integer       no-undo .
     1895           do
     1896               on error undo, return error
     1897               :
     1898               assign
     1899                   v-frame-width = frame D-Dialog:width - 0.3
     1900                   fh            = frame D-Dialog:first-child
     1901                   hh            = fh:first-child
     1902                   ii            = 1
     1903                   .
     1904               do while valid-handle(hh):
     1905                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1906                   do:
     1907                       case lc(hh:name) :
     1908                           when "b-help" then
     1909                               do:
     1910                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1911                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1912                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1913                                   hh:TOOLTIP = "Помощь" .
     1914                                   v-help-old-x = hh:column .
     1915                                   v-help-old-y = hh:row    .
     1916                                   v-help-old-size = hh:width .
     1917                                   hh:width-chars = 2.5 .
     1918                               end.
     1919                           when "b-print" then
     1920                               do:
     1921                                   hh:load-image("cmp/b-print.bmp":u) .
     1922                                   hh:TOOLTIP = "Печать" .
     1923                                   v-h[ii] = hh:handle .
     1924                                   ii = ii + 1 .
     1925                                   hh:width-chars = 3 .
     1926                               end.
     1927                           when "b-history" or
     1928                           when "b-hist" then
     1929                               do:
     1930                                   hh:load-image("cmp/b-hist.bmp":u) .
     1931                                   hh:TOOLTIP = "История" .
     1932                                   v-h[ii] = hh:handle .
     1933                                   ii = ii + 1 .
     1934                                   hh:width-chars = 3 .
     1935                               end.
     1936                           when "b-sch" then
     1937                               do:
     1938                                   hh:load-image("cmp/b-sch.bmp":u) .
     1939                                   hh:TOOLTIP = "Установка Фильтра" .
     1940                                   v-h[ii] = hh:handle .
     1941                                   ii = ii + 1 .
     1942                                   hh:width-chars = 3 .
     1943                               end.
     1944                           when "b-hist-user" then
     1945                               do:
     1946                                   hh:load-image("cmp/b-hist.bmp":u) .
     1947                                   hh:TOOLTIP = "История пользователя" .
     1948                                   ii = ii + 1 .
     1949                               end.
     1950                       end case.
     1951                   end.
     1952                   hh = hh:next-sibling.
     1953               end.
     1954               b-help:column = v-frame-width - b-help:width-chars.
     1955               jj = 0.
     1956               repeat ii = 4 to 1 by -1 :
     1957                   if valid-handle (v-h[ii] ) then
     1958                   do:
     1959                       jj  = jj + 1 .
     1960                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1961                       v-h[ii]:row    = v-help-old-y .
     1962                   end.
     1963               end.
     1964           end.
     1965       end.
     1966   end procedure.
     1967   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     1968       MESSAGE "A SmartDialog is not intended ":U SKIP
     1969               "to be run Persistent or to be placed ":U SKIP
     1970               "in another SmartObject at UIB design time.":U
     1971               VIEW-AS ALERT-BOX ERROR.
     1972       RUN disable_UI.
     1973       DELETE PROCEDURE THIS-PROCEDURE.
     1974       RETURN.
     1975   END.
     1976   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     1977   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     1978   MAIN-BLOCK:
     1979   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1980      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1981     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     1982     run init-date in this-procedure .
     1983     run set-date in this-procedure
     1984       (input v-date
     1985       ) .
     1986     if p-description <> ""
     1987     then do:
     1988       assign
     1989         editor-description :visible      = true
     1990       .
     1991       define variable v-date-description as character no-undo .
     1992       run date-str in this-procedure
     1993         (input  date(v-curr-month, v-curr-day, v-curr-year)
     1994         ,output v-date-description
     1995         ) .
     1996       assign
     1997         editor-description :screen-value = substitute(p-description, v-date-description)
     1998       .
     1999     end.
     2000     else do:
     2001       assign
     2002         editor-description :visible      = false
     2003       .
     2004     end.
     2005     WAIT-FOR GO OF FRAME D-Dialog.
     2006   END.
     2007   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     2008   PROCEDURE adm-create-objects :
     2009   END PROCEDURE.
     2010   PROCEDURE adm-row-available :
     2011     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2012     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2013     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2014     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2015     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2016     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2017     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2018     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2019     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2020     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2021     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2022     IF adm-updating-record THEN RETURN.
     2023     RUN get-attribute ('FIELDS-ENABLED':U).
     2024     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2025     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2026         OUTPUT link-handle) NO-ERROR.
     2027     IF link-handle = "":U THEN
     2028         RETURN.
     2029     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2030     IF NUM-ENTRIES(link-handle) > 1 THEN
     2031         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2032             "encountered more than one RECORD-SOURCE.":U SKIP
     2033             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2034                VIEW-AS ALERT-BOX ERROR.
     2035     RUN get-attribute ('Key-Name':U).
     2036     key-name = RETURN-VALUE.
     2037     IF key-name = "":U THEN key-name = ?.
     2038     IF key-name NE ? THEN DO:
     2039       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2040         NO-ERROR.
     2041       IF key-value NE ? THEN
     2042         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2043     END.
     2044   IF VALID-HANDLE (adm-object-hdl) THEN
     2045       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2046   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2047   END PROCEDURE.
     2048   PROCEDURE check-holyday :
     2049     define input  parameter p-month   as integer   no-undo .
     2050     define input  parameter p-day     as integer   no-undo .
     2051     define variable v-holyday     as logical   no-undo .
     2052     define variable v-state       as logical   no-undo .
     2053     define variable v-description as character no-undo .
     2054     assign
     2055       v-holyday = false
     2056       v-state   = false
     2057     .
     2058     case p-month
     2059     :
     2060       when 1
     2061       then do:
     2062         case p-day
     2063         :
     2064           when 1 or
     2065           when 2
     2066           then do:
     2067             assign
     2068               v-holyday = true
     2069               v-state   = true
     2070               v-description = "1,2 января - Государственный праздник. Новый год."
     2071             .
     2072           end.
     2073           when 7
     2074           then do:
     2075             assign
     2076               v-holyday = true
     2077               v-state   = true
     2078               v-description = "7 января - Государственный праздник. Рождество Христово."
     2079             .
     2080           end.
     2081         end.
     2082       end.
     2083       when 2
     2084       then do:
     2085         case p-day
     2086         :
     2087           when 14
     2088           then do:
     2089             assign
     2090               v-holyday = true
     2091               v-state   = true
     2092               v-description = "14 февраля - День Святого Валентина (день всех влюбленных)."
     2093             .
     2094           end.
     2095           when 23
     2096           then do:
     2097             assign
     2098               v-holyday = true
     2099               v-state   = true
     2100               v-description = "23 февраля - Государственный праздник. День защитника Отечества."
     2101             .
     2102           end.
     2103         end.
     2104       end.
     2105       when 3
     2106       then do:
     2107         case p-day
     2108         :
     2109           when 8
     2110           then do:
     2111             assign
     2112               v-holyday = true
     2113               v-state   = true
     2114               v-description = "8 марта - Государственный праздник. Международный женский день."
     2115             .
     2116           end.
     2117           when 19
     2118           then do:
     2119             assign
     2120               v-holyday = true
     2121               v-state   = true
     2122               v-description = "19 марта - Государственный праздник. День работников торговли."
     2123             .
     2124           end.
     2125         end.
     2126       end.
     2127       when 4
     2128       then do:
     2129         case p-day
     2130         :
     2131           when 5
     2132           then do:
     2133             assign
     2134               v-holyday = true
     2135               v-description = "5 апреля 1242 года - день победы русского войска во главе с князем Александром Невским над немецкими рыцарями на Чудском озере (Ледовое побоище - 1242 год)."
     2136             .
     2137           end.
     2138           when 12
     2139           then do:
     2140             assign
     2141               v-holyday = true
     2142               v-description = "12 апреля - день космонавтики."
     2143             .
     2144           end.
     2145         end.
     2146       end.
     2147       when 5
     2148       then do:
     2149         case p-day
     2150         :
     2151           when 1 or
     2152           when 2
     2153           then do:
     2154             assign
     2155               v-holyday = true
     2156               v-state   = true
     2157               v-description = "1, 2 мая - Государственный праздник. Праздник весны и труда."
     2158             .
     2159           end.
     2160           when 9
     2161           then do:
     2162             assign
     2163               v-holyday = true
     2164               v-state   = true
     2165               v-description = "9 мая - Государственный праздник. День Победы [над Фашистской Германией]."
     2166             .
     2167           end.
     2168         end.
     2169       end.
     2170       when 6
     2171       then do:
     2172         case p-day
     2173         :
     2174           when 12
     2175           then do:
     2176             assign
     2177               v-holyday = true
     2178               v-state   = true
     2179               v-description = "12 июня - Государственный праздник. День России (день принятия Декларации о государственном суверенитете РФ)."
     2180             .
     2181           end.
     2182           when 25
     2183           then do:
     2184             assign
     2185               v-holyday = true
     2186               v-state   = true
     2187               v-description = "25 июня - день дружбы и единения славян."
     2188             .
     2189           end.
     2190         end.
     2191       end.
     2192       when 7
     2193       then do:
     2194         case p-day
     2195         :
     2196           when 10
     2197           then do:
     2198             assign
     2199               v-holyday = true
     2200               v-description = "10 июля 1709 года - день победы русской армии под командованием Петра I над шведской армией в Полтавской битве (1709 год)."
     2201             .
     2202           end.
     2203         end.
     2204       end.
     2205       when 8
     2206       then do:
     2207         case p-day
     2208         :
     2209           when 9
     2210           then do:
     2211             assign
     2212               v-holyday = true
     2213               v-description = "9 августа 1714 года - день первой в российской истории морской победы русского флота под командованием Петра I над шведским флотом у мыса Гангут (Гангутское сражение - 1714 год)"
     2214             .
     2215           end.
     2216           when 23
     2217           then do:
     2218             assign
     2219               v-holyday = true
     2220               v-description = "23 августа 1943 года - день воинской славы России. День разгрома советскими войсками немецко-фашистских войск на Курской дуге."
     2221             .
     2222           end.
     2223         end.
     2224       end.
     2225       when 9
     2226       then do:
     2227         case p-day
     2228         :
     2229           when 1
     2230           then do:
     2231             assign
     2232               v-holyday = true
     2233               v-description = "1 сентября 1994 года - начало разработки информационой системы IBS Trade House."
     2234             .
     2235           end.
     2236           when 7
     2237           then do:
     2238             assign
     2239               v-holyday = true
     2240               v-description = "7 сентября 1812 года - день сражения русской армии под командованием Кутузова с армией Наполеона около села Бородино (Бородинское сражение - 1812 год)."
     2241             .
     2242           end.
     2243           when 8
     2244           then do:
     2245             assign
     2246               v-holyday = true
     2247               v-description = "8 сентября 1380 года - день победы русского войска во главе с князем Дмитрием Донским над монголо-татарским войском на Куликовом поле (Куликовская битва - 1380 год)."
     2248             .
     2249           end.
     2250           when 9
     2251           then do:
     2252             assign
     2253               v-holyday = true
     2254               v-description = "9 сентября 1790 года - день победы русского флота под командованием Федора Ушакова над турецким флотом у острова Тендра (1790 год)."
     2255             .
     2256           end.
     2257         end.
     2258       end.
     2259       when 10
     2260       then do:
     2261         case p-day
     2262         :
     2263           when 22
     2264           then do:
     2265             assign
     2266               v-holyday = true
     2267               v-description = "22 октября 1721 года - Акт поднесения Государю Царю Петру I титула Императора Всероссийского наименования Великого и Отца Отечества."
     2268             .
     2269           end.
     2270         end.
     2271       end.
     2272       when 11
     2273       then do:
     2274         case p-day
     2275         :
     2276           when 2
     2277           then do:
     2278             assign
     2279               v-holyday = true
     2280               v-description = "2 ноября 1992 года - день основания компании IBS."
     2281             .
     2282           end.
     2283           when 4
     2284           then do:
     2285             assign
     2286               v-holyday = true
     2287               v-state   = true
     2288               v-description = "4 ноября - День народного единства."
     2289             .
     2290           end.
     2291           when 5
     2292           then do:
     2293             assign
     2294               v-holyday = true
     2295               v-description = "5 ноября 1612 года - день освобождения Москвы от польских интервентов народным ополчением под руководством Кузьмы Минина и Дмитрия Пожарского (1612 год)."
     2296             .
     2297           end.
     2298         end.
     2299       end.
     2300       when 12
     2301       then do:
     2302         case p-day
     2303         :
     2304           when 1
     2305           then do:
     2306             assign
     2307               v-holyday = true
     2308               v-description = "1 декабря 1853 года - день победы русской эскадры под командованием Нахимова над турецкой эскадрой в Синопской бухте (Синопское сражение - 1853 год)."
     2309             .
     2310           end.
     2311           when 12
     2312           then do:
     2313             assign
     2314               v-holyday = true
     2315               v-state   = true
     2316               v-description = "12 декабря - Государственный праздник. День конституции РФ."
     2317             .
     2318           end.
     2319           when 24
     2320           then do:
     2321             assign
     2322               v-holyday = true
     2323               v-description = "24 декабря 1790 года - день взятия турецкой крепости Измаил русскими войсками под командованием Александра Суворова (1790 год)."
     2324             .
     2325           end.
     2326         end.
     2327       end.
     2328     end case .
     2329     do with frame D-Dialog:
     2330       if v-holyday = true
     2331       then do:
     2332         assign
     2333           editor-holiday :screen-value = v-description
     2334         .
     2335       end.
     2336       else do:
     2337         assign
     2338           editor-holiday :screen-value = ""
     2339         .
     2340       end.
     2341     end.
     2342   END PROCEDURE.
     2343   PROCEDURE disable_UI :
     2344     HIDE FRAME D-Dialog.
     2345   END PROCEDURE.
     2346   PROCEDURE display-calendar :
     2347     assign
     2348       v-curr-month   = integer(cb-month :screen-value in frame D-Dialog)
     2349       v-curr-year    = integer(fi-year :screen-value  in frame D-Dialog)
     2350       v-month-begin  = date(v-curr-month
     2351                            ,1
     2352                            ,v-curr-year
     2353                            )
     2354       v-month-offset = (weekday(v-month-begin) + 5) mod 7
     2355     .
     2356     run gbl/lastday.p
     2357       (input  v-month-begin
     2358       ,output v-last-day
     2359       ).
     2360     if v-curr-day > v-last-day
     2361     then do:
     2362       assign
     2363         v-curr-day = v-last-day
     2364       .
     2365     end.
     2366     if v-curr-day = ?
     2367     or v-curr-day <= 0
     2368     then do:
     2369       assign
     2370         v-curr-day = 1
     2371       .
     2372     end.
     2373     do with frame D-Dialog:
     2374       assign
     2375         FI-date :screen-value = string( date (v-curr-month, v-curr-day, v-curr-year) )
     2376       .
     2377       run check-holyday in this-procedure
     2378         (input  v-curr-month
     2379         ,input  v-curr-day
     2380         ) .
     2381       if  p-description <> ""
     2382       and index(p-description, '&1':u) > 0
     2383       then do:
     2384         define variable v-date-description as character no-undo .
     2385         run date-str in this-procedure
     2386           (input  date(v-curr-month, v-curr-day, v-curr-year)
     2387           ,output v-date-description
     2388           ) .
     2389         assign
     2390           editor-description :screen-value = substitute(p-description, v-date-description)
     2391         .
     2392       end.
     2393     end.
     2394     define variable ind as integer no-undo .
     2395     define variable l-immediate-display as logical no-undo .
     2396     assign
     2397       l-immediate-display        = session :immediate-display
     2398       session :immediate-display = false
     2399     .
     2400     do ind = 1 to 42 :
     2401       run set-box-state in this-procedure
     2402         (input ind
     2403         ,input (if ind  >= v-month-offset + 1
     2404                 and ind <= v-month-offset + v-last-day
     2405                 then ind - v-month-offset
     2406                 else - day(date(v-curr-month, 1, v-curr-year) + ind - (v-month-offset + 1) )
     2407                )
     2408         ).
     2409     end.
     2410     assign
     2411       session :immediate-display = l-immediate-display
     2412     .
     2413     run init-holyday .
     2414   END PROCEDURE.
     2415   PROCEDURE display-month-name :
     2416     define variable v-month-name as character no-undo .
     2417     do with frame D-Dialog:
     2418       run gbl/monthnam.p
     2419         (input integer(cb-month :screen-value)
     2420         ,output v-month-name
     2421         ).
     2422       assign
     2423         fi-month-name :screen-value = v-month-name
     2424       .
     2425     end.
     2426     run display-calendar .
     2427   END PROCEDURE.
     2428   PROCEDURE init-holyday :
     2429   for each tt-holyday use-index pi
     2430      where tt-holyday.holy-date >= date(v-curr-month,1,v-curr-year)
     2431        and tt-holyday.holy-date <= date(v-curr-month,v-last-day,v-curr-year) no-lock :
     2432     if day(tt-holyday.holy-date) <> 0 then do :
     2433      run set-box-state-holy
     2434        (input day(tt-holyday.holy-date) + v-month-offset
     2435        ,input day(tt-holyday.holy-date)
     2436        ).
     2437      end.
     2438   end.
     2439   END PROCEDURE.
     2440   PROCEDURE init-tt-holyday :
     2441   define variable ii as integer no-undo .
     2442   find first sysconf-attr no-lock
     2443        where sysconf-attr.attr-code = "holyday"
     2444          and sysconf-attr.host-code = 0
     2445          and sysconf-attr.attr-value <> "" no-error.
     2446   if available sysconf-attr then do :
     2447     do ii = 1 to num-entries(sysconf-attr.attr-value,",") :
     2448       if not can-find(first tt-holyday where tt-holyday.holy-date = date(entry(ii,sysconf-attr.attr-value,",")) ) then do :
     2449         create tt-holyday .
     2450         assign
     2451           tt-holyday.holy-date = date(entry(ii,sysconf-attr.attr-value,","))
     2452         .
     2453       end.
     2454     end.
     2455   end.
     2456   END PROCEDURE.
     2457   PROCEDURE enable_UI :
     2458     DISPLAY editor-description CB-Month FI-Year editor-holiday
     2459         WITH FRAME D-Dialog.
     2460     ENABLE b-exit b-quit b-yesterday b-today b-tomorrow b-print b-help
     2461            editor-description b-prev-day b-next-day FI-date CB-Month b-prev-month
     2462            b-next-month FI-Year b-prev-year b-next-year editor-holiday
     2463            fi-month-name
     2464         WITH FRAME D-Dialog.
     2465     VIEW FRAME D-Dialog.
     2466   END PROCEDURE.
     2467   PROCEDURE init-date :
     2468     assign
     2469       v-date = p-date
     2470     .
     2471     if v-date = ?
     2472     then do:
     2473       run cur-time in this-procedure
     2474         (output v-today
     2475         ,output v-time
     2476         ).
     2477       assign
     2478         v-date = v-today
     2479       .
     2480     end.
     2481   END PROCEDURE.
     2482   PROCEDURE select-day :
     2483     define input parameter p-shift-value as integer no-undo .
     2484     define variable v-current-date as date      no-undo .
     2485     do with frame D-Dialog:
     2486       assign
     2487         v-current-date = date(v-curr-month, v-curr-day, v-curr-year)
     2488       .
     2489       if v-current-date <> ?
     2490       then do:
     2491         run set-date in this-procedure
     2492           (input v-current-date + p-shift-value
     2493           ) .
     2494       end.
     2495     end.
     2496   END PROCEDURE.
     2497   PROCEDURE save-holyday :
     2498   if p-mode = "holyday" then do :
     2499     holy-string = "" .
     2500     for each tt-holyday use-index pi
     2501       where tt-holyday.holy-date > date(month(today),day(today),year(today) - 2)
     2502         and tt-holyday.holy-date < date(month(today),day(today),year(today) + 2) no-lock :
     2503       holy-string = holy-string + "," + string(tt-holyday.holy-date) .
     2504     end.
     2505     holy-string = left-trim (holy-string , ",") .
     2506     find first sysconf-attr exclusive-lock
     2507          where sysconf-attr.attr-code  = "holyday"
     2508            and sysconf-attr.host-code = 0 no-error .
     2509     if not available sysconf-attr then do :
     2510       create sysconf-attr .
     2511       assign
     2512         sysconf-attr.attr-code  = "holyday"
     2513         sysconf-attr.host-code  = 0
     2514       .
     2515     end.
     2516     sysconf-attr.attr-value = holy-string .
     2517   end.
     2518   END PROCEDURE.
     2519   PROCEDURE select-month :
     2520     define input parameter p-shift-value as integer no-undo .
     2521     define variable v-current-month as integer no-undo .
     2522     do with frame D-Dialog:
     2523       assign
     2524         v-current-month = integer (cb-month :screen-value)
     2525       .
     2526       assign
     2527         v-current-month = v-current-month + p-shift-value
     2528       .
     2529       if v-current-month < 1
     2530       then do:
     2531         assign
     2532           v-current-month = 1
     2533         .
     2534       end.
     2535       if v-current-month > 12
     2536       then do:
     2537         assign
     2538           v-current-month = 12
     2539         .
     2540       end.
     2541       assign
     2542         cb-month :screen-value = string(v-current-month)
     2543       .
     2544     end.
     2545     run display-month-name .
     2546   END PROCEDURE.
     2547   PROCEDURE select-year :
     2548     define input parameter p-shift-value as integer no-undo .
     2549     define variable v-current-year as integer no-undo .
     2550     do with frame D-Dialog:
     2551       assign
     2552         v-current-year = integer (fi-year :screen-value)
     2553       .
     2554       assign
     2555         v-current-year = v-current-year + p-shift-value
     2556       .
     2557       if v-current-year < 0
     2558       then do:
     2559         assign
     2560           v-current-year = 0
     2561         .
     2562       end.
     2563       if v-current-year > 9999
     2564       then do:
     2565         assign
     2566           v-current-year = 9999
     2567         .
     2568       end.
     2569       assign
     2570         fi-year :screen-value = string(v-current-year)
     2571       .
     2572     end.
     2573     run display-month-name .
     2574   END PROCEDURE.
     2575   PROCEDURE send-records :
     2576   END PROCEDURE.
     2577   PROCEDURE set-box-state :
     2578     define input parameter v-box-number as integer no-undo .
     2579     define input parameter v-display-day as integer no-undo .
     2580     if v-display-day = 0
     2581     or v-display-day = ?
     2582     then do:
     2583       if v-day-handle  [v-box-number] :visible <> false
     2584       then do:
     2585         assign
     2586           v-day-handle  [v-box-number] :visible = false
     2587         .
     2588       end.
     2589       if v-day-handle  [v-box-number] :screen-value <> ""
     2590       then do:
     2591         assign
     2592           v-day-handle  [v-box-number] :screen-value = ""
     2593         .
     2594       end.
     2595       if v-rect-handle  [v-box-number] :sensitive <> false
     2596       then do:
     2597         assign
     2598           v-rect-handle  [v-box-number] :sensitive = false
     2599         .
     2600       end.
     2601       if v-rect-handle [v-box-number] :visible <> false
     2602       then do:
     2603         assign
     2604           v-rect-handle [v-box-number] :visible = false
     2605         .
     2606       end.
     2607     end.
     2608     else do:
     2609       if v-display-day > 0
     2610       then do:
     2611         if v-day-handle  [v-box-number] :visible <> true
     2612         then do:
     2613           assign
     2614             v-day-handle  [v-box-number] :visible = true
     2615           .
     2616         end.
     2617         if v-day-handle  [v-box-number] :screen-value <> string(v-display-day)
     2618         then do:
     2619           assign
     2620             v-day-handle  [v-box-number] :screen-value = string(v-display-day)
     2621           .
     2622         end.
     2623         run cur-time in this-procedure
     2624           (output v-today
     2625           ,output v-time
     2626           ).
     2627         if  v-display-day = day(v-today)
     2628         and v-curr-month  = month(v-today)
     2629         and v-curr-year   = year(v-today)
     2630         then do:
     2631           if v-day-handle  [v-box-number] :bgcolor <> YELLOW_COLOR
     2632           then do:
     2633             assign
     2634               v-day-handle  [v-box-number] :bgcolor = YELLOW_COLOR
     2635             .
     2636           end.
     2637         end.
     2638         else do:
     2639           if v-day-handle  [v-box-number] :bgcolor <> GREY_COLOR
     2640           then do:
     2641             assign
     2642               v-day-handle  [v-box-number] :bgcolor = GREY_COLOR
     2643             .
     2644           end.
     2645         end.
     2646         if v-display-day = v-curr-day
     2647         then do:
     2648           assign
     2649             v-rect-handle [v-box-number] :bgcolor = GREEN_COLOR
     2650           .
     2651         end.
     2652         else do:
     2653           assign
     2654             v-rect-handle [v-box-number] :bgcolor = GREY_COLOR
     2655           .
     2656         end.
     2657         if v-rect-handle [v-box-number] :visible <> true
     2658         then do:
     2659           assign
     2660             v-rect-handle [v-box-number] :visible = true
     2661           .
     2662         end.
     2663         if v-rect-handle  [v-box-number] :sensitive <> true
     2664         then do:
     2665           assign
     2666             v-rect-handle  [v-box-number] :sensitive = true
     2667           .
     2668         end.
     2669       end.
     2670       else do:
     2671         if v-day-handle  [v-box-number] :visible <> true
     2672         then do:
     2673           assign
     2674             v-day-handle  [v-box-number] :visible = true
     2675           .
     2676         end.
     2677         if v-day-handle  [v-box-number] :screen-value <> string(abs(v-display-day))
     2678         then do:
     2679           assign
     2680             v-day-handle  [v-box-number] :screen-value = string(abs(v-display-day))
     2681           .
     2682         end.
     2683         if v-day-handle  [v-box-number] :bgcolor <> ?
     2684         then do:
     2685           assign
     2686             v-day-handle  [v-box-number] :bgcolor = ?
     2687           .
     2688         end.
     2689         if v-rect-handle  [v-box-number] :sensitive <> false
     2690         then do:
     2691           assign
     2692             v-rect-handle  [v-box-number] :sensitive = false
     2693           .
     2694         end.
     2695         if v-rect-handle [v-box-number] :visible <> false
     2696         then do:
     2697           assign
     2698             v-rect-handle [v-box-number] :visible = false
     2699           .
     2700         end.
     2701       end.
     2702     end.
     2703   END PROCEDURE.
     2704   PROCEDURE set-box-state-holy :
     2705     define input parameter v-box-number as integer no-undo .
     2706     define input parameter v-display-day as integer no-undo .
     2707     if v-display-day > 0
     2708     then do:
     2709       if v-rect-handle [v-box-number] :bgcolor <> GREEN_COLOR then do :
     2710         if  v-rect-handle [v-box-number] :bgcolor <> RED_COLOR
     2711         then do:
     2712           assign
     2713             v-rect-handle [v-box-number] :bgcolor = RED_COLOR
     2714           .
     2715           find first tt-holyday no-lock
     2716           where tt-holyday.holy-date = date(v-curr-month,v-display-day,v-curr-year) no-error.
     2717           if not available tt-holyday then do :
     2718             create tt-holyday.
     2719             assign
     2720               holy-date = date(v-curr-month,v-display-day,v-curr-year)
     2721             .
     2722           end.
     2723         end.
     2724         else do:
     2725           assign
     2726             v-rect-handle [v-box-number] :bgcolor = GREY_COLOR
     2727           .
     2728           find first tt-holyday no-lock
     2729           where tt-holyday.holy-date = date(v-curr-month,v-display-day,v-curr-year) no-error.
     2730           if available tt-holyday then do :
     2731             delete tt-holyday.
     2732           end.
     2733         end.
     2734       end.
     2735       else do :
     2736         find first tt-holyday no-lock
     2737         where tt-holyday.holy-date = date(v-curr-month,v-display-day,v-curr-year) no-error.
     2738           if not available tt-holyday then do :
     2739             create tt-holyday.
     2740             assign
     2741               holy-date = date(v-curr-month,v-display-day,v-curr-year)
     2742             .
     2743           end.
     2744       end.
     2745     end.
     2746   END PROCEDURE.
     2747   PROCEDURE set-curr-day :
     2748     define input parameter p-rect-name as character no-undo .
     2749     define variable v-box-ind as integer no-undo .
     2750     assign
     2751       v-box-ind = integer (substring (p-rect-name, 6))
     2752     .
     2753     define variable v-new-day as integer no-undo .
     2754     define variable v-old-day as integer no-undo .
     2755     assign
     2756       v-new-day = if  v-box-ind >= v-month-offset + 1
     2757                   and v-box-ind <= v-month-offset + v-last-day
     2758                   then v-box-ind - v-month-offset
     2759                   else 0
     2760     .
     2761     if  v-new-day <> 0
     2762     and v-new-day <> v-curr-day
     2763     then do:
     2764       assign
     2765         v-old-day = v-curr-day
     2766         v-curr-day = v-new-day
     2767       .
     2768       run set-box-state
     2769         (input v-old-day + v-month-offset
     2770         ,input v-old-day
     2771         ).
     2772       if can-find(first tt-holyday where tt-holyday.holy-date = date(v-curr-month,v-old-day,v-curr-year))
     2773       then do :
     2774         run set-box-state-holy
     2775           (input v-old-day + v-month-offset
     2776           ,input v-old-day
     2777           ).
     2778       end.
     2779       run set-box-state
     2780         (input v-new-day + v-month-offset
     2781         ,input v-new-day
     2782         ).
     2783       do with frame D-Dialog:
     2784         assign
     2785           FI-date :screen-value = string( date (v-curr-month, v-curr-day, v-curr-year) )
     2786         .
     2787         run check-holyday in this-procedure
     2788           (input v-curr-month
     2789           ,input v-curr-day
     2790           ) .
     2791         if  p-description <> ""
     2792         and index(p-description, '&1':u) > 0
     2793         then do:
     2794           define variable v-date-description as character no-undo .
     2795           run date-str in this-procedure
     2796             (input  date(v-curr-month, v-curr-day, v-curr-year)
     2797             ,output v-date-description
     2798             ) .
     2799           assign
     2800             editor-description :screen-value = substitute(p-description, v-date-description)
     2801           .
     2802         end.
     2803       end.
     2804     end.
     2805   END PROCEDURE.
     2806   PROCEDURE set-holy-day :
     2807     define input parameter p-rect-name as character no-undo .
     2808     define variable v-box-ind as integer no-undo .
     2809     assign
     2810       v-box-ind = integer (substring (p-rect-name, 6))
     2811     .
     2812     define variable v-new-day as integer no-undo .
     2813     define variable v-old-day as integer no-undo .
     2814     assign
     2815       v-new-day = if  v-box-ind >= v-month-offset + 1
     2816                   and v-box-ind <= v-month-offset + v-last-day
     2817                   then v-box-ind - v-month-offset
     2818                   else 0
     2819     .
     2820     if  v-new-day <> 0
     2821     then do:
     2822       run set-box-state-holy
     2823         (input v-new-day + v-month-offset
     2824         ,input v-new-day
     2825         ).
     2826     end.
     2827   END PROCEDURE.
     2828   PROCEDURE set-date :
     2829     define input  parameter p-date as date      no-undo .
     2830     do with frame D-Dialog:
     2831       assign
     2832         CB-Month                = month(p-date)
     2833         CB-Month :screen-value  = string(month(p-date))
     2834         FI-Year                 = year(p-date)
     2835         FI-Year  :screen-value  = string(year(p-date))
     2836         v-curr-day              = day(p-date)
     2837       .
     2838     end.
     2839     run display-month-name in this-procedure .
     2840   END PROCEDURE.
     2841   PROCEDURE state-changed :
     2842     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2843     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2844   END PROCEDURE.
