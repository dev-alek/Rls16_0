        1   block-level on error undo, throw.
        2   define input parameter  p-process-key    as character no-undo .
        3   define input parameter  p-Key#_One       like ub.batchprocess.Key#_One      no-undo .
        4   define input parameter  p-Key#_Two       like ub.batchprocess.Key#_Two      no-undo .
        5   define input parameter  p-Key#_Three     like ub.batchprocess.Key#_Three    no-undo .
        6   define input parameter  p-CharKey_One    like ub.batchprocess.CharKey_One   no-undo .
        7   define input parameter  p-CharKey_Two    like ub.batchprocess.CharKey_Two   no-undo .
        8   define input parameter  p-CharKey_Three  like ub.batchprocess.CharKey_Three no-undo .
        9   define input parameter  p-key-descr-list as character no-undo .
       10   define input parameter  p-message-on     as logical no-undo .
       11   define parameter buffer lock_batchprocess for ub.batchprocess .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: lock-prc.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: gbl/lock-prc.p $":U .
       17   define variable vss-description as character no-undo init "Программа блокировки ресурсов".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36       assign
       37         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8|&9':u,p-process-key,p-Key#_One,p-Key#_Two,p-Key#_Three,p-CharKey_One,p-CharKey_Two,p-CharKey_Three,p-key-descr-list,p-message-on)
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define buffer buf_batchprocess for ub.batchprocess .
      316   define buffer delete_batchprocess for ub.batchprocess .
      317   do
      318   on error undo, return error return-value
      319   :
      320     define variable v-today as date      no-undo .
      321     define variable v-time  as integer   no-undo .
      322     if length(p-process-key) > 4
      323     then do:
      324       message
      325         vss-workfile vss-revision vss-description skip
      326         "Ошибка задания параметров" skip
      327         "Ключ блокирования процесса не может превышать 4 символа" skip
      328         "p-process-key"   p-process-key   skip
      329         "p-Key#_One"      p-Key#_One      skip
      330         "p-Key#_Two"      p-Key#_Two      skip
      331         "p-Key#_Three"    p-Key#_Three    skip
      332         "p-CharKey_One"   p-CharKey_One   skip
      333         "p-CharKey_Two"   p-CharKey_Two   skip
      334         "p-CharKey_Three" p-CharKey_Three skip
      335         "p-message-on"    p-message-on    skip
      336         view-as alert-box error .
      337       undo, return error return-value .
      338     end.
      339     if g#auto = true then do:
      340       assign
      341         p-message-on = false
      342       .
      343     end.
      344     def var v-bp_type like ub.batchprocess.bp_type no-undo .
      345     assign
      346       v-bp_type = 'lock':U + p-process-key
      347     .
      348     find first ub.batchprocess no-lock
      349       where ub.batchprocess.bp_type   = v-bp_type
      350         and ub.batchprocess.bp_status = 'N':U
      351         and  ub.batchprocess.key#_one  = p-Key#_One
      352         and ub.batchprocess.key#_two = p-Key#_Two
      353         and ub.batchprocess.key#_three = p-Key#_Three
      354         and ub.batchprocess.charkey_one = p-CharKey_One
      355         and ub.batchprocess.charkey_two = p-CharKey_Two
      356         and ub.batchprocess.charkey_three = p-CharKey_Three
      357     no-error .
      358     if not available ub.BatchProcess then do:
      359       create ub.BatchProcess .
      360           define variable v-btpr_upd-today-1 as date      no-undo.
      361       define variable v-btpr_upd-time-1  as integer   no-undo.
      362       run cur-time in this-procedure ( output v-btpr_upd-today-1
      363                                      , output v-btpr_upd-time-1
      364                                      ).
      365       assign
      366         ub.BatchProcess.BP_Type       = v-bp_type
      367         ub.BatchProcess.BP_Status     = 'N':U
      368         ub.BatchProcess.BatchProcess# = next-value( s-btpr, ub )
      369         ub.BatchProcess.User_ID       = g#userid
      370         ub.BatchProcess.BP_SysDate    = v-btpr_upd-today-1
      371         ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time-1, 'HH:MM' )
      372         ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time-1
      373       .
      374       assign
      375         ub.BatchProcess.Key#_One      = p-Key#_One
      376         ub.BatchProcess.Key#_Two      = p-Key#_Two
      377         ub.BatchProcess.Key#_Three    = p-Key#_Three
      378         ub.BatchProcess.CharKey_One   = p-CharKey_One
      379         ub.BatchProcess.CharKey_Two   = p-CharKey_Two
      380         ub.BatchProcess.CharKey_Three = p-CharKey_Three
      381       .
      382     end.
      383     validate ub.batchprocess .
      384     run lock-record in this-procedure
      385       (buffer ub.batchprocess
      386       ,buffer lock_batchprocess
      387       ) no-error .
      388     if error-status :error
      389     then do:
      390       if error-status :get-message(1) <> ""
      391       then do:
      392         message
      393           vss-workfile vss-revision vss-description skip
      394           "Ошибка при вызове процедуры lock-record" skip
      395           view-as alert-box error .
      396       end.
      397       undo, return error return-value .
      398     end.
      399     run cur-time in this-procedure ( output v-today
      400                                    , output v-time
      401                                    ).
      402     assign
      403       lock_batchprocess.bp_execuser_id    = g#userid
      404       lock_batchprocess.bp_execsysdate    = v-today
      405       lock_batchprocess.bp_execsystime    = string(v-time, 'hh:mm')
      406     .
      407     for each buf_batchprocess no-lock
      408       where buf_batchprocess.bp_type       = v-bp_type
      409         and buf_batchprocess.bp_status     = 'N':U
      410         and buf_batchprocess.Key#_One      = p-Key#_One
      411         and buf_batchprocess.Key#_Two      = p-Key#_Two
      412         and buf_batchprocess.Key#_Three    = p-Key#_Three
      413         and buf_batchprocess.CharKey_One   = p-CharKey_One
      414         and buf_batchprocess.CharKey_Two   = p-CharKey_Two
      415         and buf_batchprocess.CharKey_Three = p-CharKey_Three
      416         and recid(buf_batchprocess) <> recid(lock_batchprocess)
      417     on error undo, return error return-value
      418     :
      419       run lock-record in this-procedure
      420         (buffer buf_batchprocess
      421         ,buffer lock_batchprocess
      422         ) no-error .
      423       if error-status :error
      424       then do:
      425         if error-status :get-message(1) <> ""
      426         then do:
      427           message
      428             vss-workfile vss-revision vss-description skip
      429             "Ошибка при вызове процедуры lock-record" skip
      430             view-as alert-box error .
      431         end.
      432         delete ub.batchprocess .
      433         undo, return error return-value .
      434       end.
      435     end.
      436     find current lock_batchprocess share-lock .
      437     return .
      438   end.
      439   procedure lock-record :
      440     define parameter buffer other_batchprocess for ub.batchprocess .
      441     define parameter buffer buf_batchprocess for ub.batchprocess .
      442     def var v-resource-id as character no-undo .
      443     do
      444     on error undo, return error return-value
      445     :
      446       find buf_batchprocess exclusive-lock
      447         where recid(buf_batchprocess) = recid(other_batchprocess)
      448         no-wait
      449         no-error .
      450       if not available buf_batchprocess
      451       then do:
      452         if locked buf_batchprocess
      453         then do:
      454           define variable v-message as character no-undo .
      455           assign
      456             p-key-descr-list = p-key-descr-list + ",,,,,,":u
      457           .
      458           assign
      459             v-resource-id = "Код ресурса " + string(p-process-key) + chr(10)
      460                           + (if entry(7, p-key-descr-list) > ""
      461                             then entry(7, p-key-descr-list) + chr(10)
      462                             else ""
      463                             )
      464                           + (if p-Key#_One <> 0
      465                             then entry(1, p-key-descr-list) + " "
      466                                 + string(p-Key#_One) + chr(10)
      467                             else ""
      468                             )
      469                           + (if p-Key#_Two <> 0
      470                             then entry(2, p-key-descr-list) + " "
      471                                 + string(p-Key#_Two) + chr(10)
      472                             else ""
      473                             )
      474                           + (if p-Key#_Three <> 0
      475                             then entry(3, p-key-descr-list) + " "
      476                                 + string(p-Key#_Three) + chr(10)
      477                             else ""
      478                             )
      479                           + (if p-CharKey_One <> ""
      480                             then entry(4, p-key-descr-list) + " "
      481                                 + string(p-CharKey_One) + chr(10)
      482                             else ""
      483                             )
      484                           + (if p-CharKey_Two <> ""
      485                             then entry(5, p-key-descr-list) + " "
      486                                 + string(p-CharKey_Two) + chr(10)
      487                             else ""
      488                             )
      489                           + (if p-CharKey_Three <> ""
      490                             then entry(6, p-key-descr-list) + " "
      491                                 + string(p-CharKey_Three) + chr(10)
      492                             else ""
      493                             )
      494           .
      495           assign
      496             v-message = "Другой пользователь уже захватил ресурс" + chr(10)
      497                       + substitute("Пользователь &1", other_batchprocess.bp_execuser_id) + chr(10)
      498                       + substitute("Дата начала работы &1", other_batchprocess.bp_execsysdate) + chr(10)
      499                       + substitute("Время начала работы &1", other_batchprocess.bp_execsystime) + chr(10)
      500                       + substitute('&1':u, v-resource-id)
      501           .
      502           if p-message-on
      503           then do:
      504             message
      505               v-message
      506               view-as alert-box error .
      507           end.
      508         end.
      509         else do:
      510           assign
      511             v-message = substitute('&1 &2 &3':u, vss-workfile, vss-revision, vss-description) + chr(10)
      512                       + "Внутренняя ошибка при блокировании ресурса" + chr(10)
      513                       + "Отсутствует запись о блокировке ресурса" + chr(10)
      514           .
      515           if p-message-on
      516           then do:
      517             message
      518               v-message
      519               view-as alert-box error.
      520           end.
      521         end.
      522         undo, return error v-message .
      523       end.
      524     end.
      525   end procedure.
