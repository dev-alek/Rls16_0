        1   block-level on error undo, throw.
        2   define input parameter p-inn as character no-undo .
        3   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        5   define input parameter p-is-pboul like ub.firm.is-pboul no-undo .
        6   define output parameter p-correct as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: cb1b05444cdf, 212, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        9   define variable vss-date        as character no-undo init "$Date: Tue Jun 30 11:12:07 2015 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: keyinn.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: gbl/keyinn.p $":U .
       12   define variable vss-description as character no-undo init "".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vmn0 as character no-undo init "2,4,10,3,5,9,4,6,8":U.
       72   define variable vmn1 as character no-undo init "7,2,4,10,3,5,9,4,6,8":U.
       73   define variable vmn2 as character no-undo init "3,7,2,4,10,3,5,9,4,6,8":U.
       74   define variable v-int as integer no-undo .
       75   define variable v-dop as character no-undo .
       76   define buffer buf_firm for ub.firm.
       77   define buffer buf_person for ub.person.
       78   define variable v-cor as logical no-undo .
       79   function sum-1 returns integer(INPUT p-inn as character, input p-mnz as character, input p-ii as integer):
       80   define variable v-sum as integer no-undo .
       81   define variable ii as integer no-undo .
       82   define variable v-dopi as integer no-undo .
       83     do ii = 1 to p-ii:
       84       assign
       85       v-dopi = integer(substring(left-trim(p-inn, "F":U), ii, 1))
       86       no-error .
       87       if error-status:error then do:
       88         return ?.
       89       end.
       90       assign
       91       v-int = v-int + v-dopi * integer(entry(ii, p-mnz))
       92       .
       93     end.
       94     return v-int .
       95   END FUNCTION.
       96   CASE p-obj-type:
       97     when 'орг':U then do:
       98       if p-is-pboul = ? then do:
       99         find first buf_firm no-lock where
      100                 buf_firm.firm-code = p-obj-code no-error .
      101         if not avail buf_firm then do:
      102           return error "Неверные параметры p-obj-code и/или  p-is-pboul".
      103         end.
      104         assign
      105         p-is-pboul = buf_Firm.is-pboul
      106         .
      107       end.
      108       if p-is-pboul then do:
      109         run check in this-procedure ("12":U, output p-correct, output v-cor) no-error .
      110       end.
      111       else do:
      112         run check in this-procedure ("10":U, output p-correct, output v-cor) no-error .
      113         if p-correct = no and v-cor = no then do:
      114         run check in this-procedure ("12":U, output p-correct, output v-cor) no-error .
      115         end.
      116       end.
      117       if error-status:error then return error .
      118       return return-value.
      119     end.
      120     when 'чел':U then do:
      121       if p-is-pboul = ? then do:
      122         find first buf_person no-lock where
      123                 buf_person.psn-code = p-obj-code no-error .
      124         if not avail buf_person then do:
      125           return error "Неверные параметры p-obj-code и/или  p-is-pboul".
      126         end.
      127         assign
      128         p-is-pboul = buf_person.is-pboul
      129         .
      130       end.
      131       run check in this-procedure ("12":U, output p-correct, output v-cor) no-error .
      132       if p-correct = no and v-cor = no then do:
      133       run check in this-procedure ("10":U, output p-correct, output v-cor) no-error .
      134       end.
      135       if error-status:error then return error .
      136       return return-value.
      137     end.
      138   END CASE.
      139   procedure check :
      140   define input parameter p-par as character no-undo .
      141   define output parameter p-correct as logical no-undo .
      142   define output parameter p-cor as logical no-undo .
      143     do
      144     on error undo, return error
      145     :
      146       CASE p-par:
      147         when "10" then do:
      148           if length(left-trim(p-inn, "F":U)) <> 10 then do:
      149             assign p-cor = no.
      150             return substitute("ИНН &1: Неверная длина ИНН - &2 - должна быть буква <F> и/или 10 цифр"
      151                                ,p-inn
      152                                ,length (p-inn)) .
      153           end.
      154           else p-cor = yes.
      155           assign
      156           v-int = sum-1(p-inn, vmn0, 9)
      157           v-int = v-int MODULO 11
      158           v-int = v-int MODULO 10
      159           .
      160           if v-int = ? then do:
      161             return substitute("ИНН &1: Неверные символы в ИНН"
      162                               , p-inn).
      163           end.
      164           assign
      165           p-correct = (string(v-int) = substring(left-trim(p-inn, "F":U), 10, 1)
      166                       )
      167           .
      168           if p-correct then return "":U.
      169           else return substitute("ИНН &1: Неверное значение ИНН", p-inn).
      170         end.
      171         when "12":U then do:
      172           if length(p-inn) <> 12 then do:
      173             return substitute("ИНН &1: Неверная длина ИНН - &2 - должна быть 12 цифр"
      174                               , p-inn
      175                               , length(p-inn)).
      176             .
      177           end.
      178           assign
      179           v-int = sum-1(p-inn, vmn1, 10)
      180           v-int = (v-int MODULO 11)
      181           v-int = (v-int MODULO 10)
      182           .
      183           if v-int = ? then do:
      184             return substitute("ИНН &1: Неверные символы в ИНН"
      185                                , p-inn).
      186           end.
      187           if string(v-int) <> substring(p-inn, 11, 1) then do:
      188             return substitute("ИНН &1: Неверное значение ИНН", p-inn).
      189           end.
      190           assign
      191           v-dop = substr(p-inn, 1, 10) + string(v-int)
      192           v-int = 0
      193           v-int = sum-1(v-dop, vmn2, 11)
      194           .
      195           assign
      196           v-int = (v-int MODULO 11)
      197           v-int = (v-int MODULO 10)
      198           .
      199           if v-int = ? then do:
      200             return substitute("ИНН &1: Неверные символы в ИНН", p-inn).
      201           end.
      202           assign
      203           p-correct = (string(v-int) = substring(p-inn, 12, 1))
      204           .
      205           if p-correct then return "":U.
      206           else return substitute("ИНН &1: Неверное значение ИНН", p-inn).
      207         end.
      208       END CASE.
      209     end.
      210   end procedure.
