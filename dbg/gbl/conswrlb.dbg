        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile: conswrlb.p $":U .
        6   define variable vss-archive     as character no-undo initial "$Archive: gbl/conswrlb.p $":U .
        7   define variable vss-description as character no-undo initial "Библиотека  процедур".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#conswrlb as handle no-undo .
       67   if valid-handle (g#conswrlb)
       68   and g#conswrlb <> this-procedure :handle
       69   and g#conswrlb :get-signature('conswrlb_testproc':u) <> ""
       70   then do:
       71     message
       72       vss-workfile vss-revision vss-description skip
       73       "Попытка повторной загрузки библиотеки" skip
       74       g#conswrlb skip
       75       g#conswrlb :type skip
       76       g#conswrlb :file-name skip
       77       valid-handle(g#conswrlb) skip
       78       this-procedure :handle skip
       79       this-procedure :type skip
       80       this-procedure :file-name skip
       81       valid-handle(this-procedure) skip
       82       view-as alert-box error .
       83     undo, return error .
       84   end.
       85   else do:
       86     assign
       87       g#conswrlb = this-procedure :handle
       88     .
       89   end.
       90   if this-procedure :persistent <> true
       91   then do:
       92     message
       93       vss-workfile vss-revision vss-description skip
       94       "Ошибка запуска библиотеки" program-name(1) skip
       95       "Попытка запустить ее как обычную процедуру" skip
       96       view-as alert-box error .
       97   end.
       98   on delete of this-procedure
       99   do:
      100     assign
      101       g#conswrlb = ?
      102     .
      103   end.
      104   procedure conswrlb_testproc :
      105   end.
      106   procedure conswr :
      107     define input  parameter p-console-message as character no-undo .
      108     do
      109     on error undo, return error return-value
      110     :
      111       define variable v-window-handle        as integer   no-undo .
      112       define variable v-menu-handle          as integer   no-undo .
      113       define variable v-result               as integer   no-undo .
      114       define variable v-stdout               as integer   no-undo .
      115       define variable v-write-string         as character no-undo .
      116       define variable v-write-string-length  as integer   no-undo .
      117       define variable v-memptr-write-string  as memptr    no-undo .
      118       do
      119       on error undo, return error return-value
      120       :
      121         run GetConsoleWindow
      122           (output v-window-handle
      123           ) .
      124         if v-window-handle = 0
      125         then do:
      126           run AllocConsole
      127             (output v-result
      128             ) .
      129           run GetConsoleWindow
      130             (output v-window-handle
      131             ) .
      132           run GetSystemMenu
      133             (input  v-window-handle
      134             ,input  0
      135             ,output v-menu-handle
      136             ) .
      137           run DeleteMenu
      138             (input  v-menu-handle
      139             ,input  61536
      140             ,input  0
      141             ,output v-result
      142             ) .
      143         end.
      144         run GetStdHandle in this-procedure
      145           (input  -11
      146           ,output v-stdout
      147           ) .
      148         assign
      149           v-write-string                  = p-console-message
      150           v-write-string-length           = length(v-write-string)
      151           set-size(v-memptr-write-string) = (v-write-string-length + 1) * 3 + 4
      152           put-string(v-memptr-write-string, 5) = v-write-string
      153         .
      154         run MultiByteToWideChar
      155           (input  1251
      156           ,input  0
      157           ,input  get-pointer-value(v-memptr-write-string) + 4
      158           ,input  v-write-string-length
      159           ,input  get-pointer-value(v-memptr-write-string) + 4 + (v-write-string-length + 1)
      160           ,input  (v-write-string-length + 1) * 2
      161           ,output v-result
      162           ) .
      163         if v-result = v-write-string-length
      164         then do:
      165           run WriteConsoleW
      166             (input  v-stdout
      167             ,input  get-pointer-value(v-memptr-write-string) + 4 + (v-write-string-length + 1)
      168             ,input  v-write-string-length
      169             ,input  get-pointer-value(v-memptr-write-string)
      170             ,input  0
      171             ,output v-result
      172             ) .
      173         end.
      174         assign
      175           set-size(v-memptr-write-string) = 0
      176         .
      177       end.
      178     end.
      179   end procedure.
      180   PROCEDURE AllocConsole EXTERNAL "kernel32.dll"
      181   :
      182      DEFINE RETURN PARAMETER RetParam  AS LONG .
      183   END PROCEDURE .
      184   PROCEDURE GetConsoleWindow EXTERNAL "kernel32.dll"
      185   :
      186      DEFINE RETURN PARAMETER RetParam  AS LONG .
      187   END PROCEDURE .
      188   PROCEDURE GetStdHandle EXTERNAL "kernel32.dll"
      189   :
      190      DEFINE INPUT  PARAMETER nStdHandle AS LONG .
      191      DEFINE RETURN PARAMETER RetParam   AS LONG .
      192   END PROCEDURE .
      193   PROCEDURE WriteConsoleW EXTERNAL "kernel32.dll"
      194   :
      195      DEFINE INPUT  PARAMETER hConsoleOutput         AS LONG .
      196      DEFINE INPUT  PARAMETER lpBuffer               AS LONG .
      197      DEFINE INPUT  PARAMETER nNumberOfCharsToWrite  AS LONG .
      198      DEFINE INPUT  PARAMETER lpNumberOfCharsWritten AS LONG .
      199      DEFINE INPUT  PARAMETER lpReserved             AS LONG .
      200      DEFINE RETURN PARAMETER RetParam               AS LONG .
      201   END PROCEDURE .
      202   PROCEDURE MultiByteToWideChar EXTERNAL "kernel32.dll"
      203   :
      204     define input  parameter uCodePage      as long.
      205     define input  parameter dwFlags        as long.
      206     define input  parameter lpMultiByteStr as long.
      207     define input  parameter cbMubtiByte    as long.
      208     define input  parameter lpWideCharStr  as long.
      209     define input  parameter cbMultiByte    as long.
      210     define return parameter iRetCode       as long.
      211   END.
      212   PROCEDURE GetSystemMenu EXTERNAL "user32.dll"
      213   :
      214     define input  parameter hWnd      as long.
      215     define input  parameter bRevert   as long.
      216     define return parameter hMenu     as long.
      217   END.
      218   PROCEDURE EnableMenuItem EXTERNAL "user32.dll"
      219   :
      220     define input  parameter hMenu         as long.
      221     define input  parameter uIDEnableItem as long.
      222     define input  parameter uEnable       as long.
      223     define return parameter iRetCode      as long.
      224   END.
      225   PROCEDURE DeleteMenu EXTERNAL "user32.dll"
      226   :
      227     define input  parameter hMenu         as long.
      228     define input  parameter uIDEnableItem as long.
      229     define input  parameter uEnable       as long.
      230     define return parameter iRetCode      as long.
      231   END.
