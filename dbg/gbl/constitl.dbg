        1   block-level on error undo, throw.
        2   define input  parameter p-title           as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: constitl.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: gbl/constitl.p $":U .
        8   define variable vss-description as character no-undo init "Запись информации в консоль".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable v-window-handle        as integer   no-undo .
       64   define variable v-result               as integer   no-undo .
       65   define variable v-stdout               as integer   no-undo .
       66   define variable v-title                as character no-undo .
       67   define variable v-title-length         as integer   no-undo .
       68   define variable v-memptr-console-title as memptr    no-undo .
       69   define variable v-write-string         as character no-undo .
       70   define variable v-write-string-length  as integer   no-undo .
       71   define variable v-memptr-write-string  as memptr    no-undo .
       72   do
       73   on error undo, return error return-value
       74   :
       75     run GetConsoleWindow
       76       (output v-window-handle
       77       ) .
       78     if v-window-handle = 0
       79     then do:
       80       run AllocConsole
       81         (output v-result
       82         ) .
       83     end.
       84     assign
       85       v-title        = p-title
       86       v-title-length = length(v-title)
       87     .
       88     assign
       89       set-size(v-memptr-console-title) = (v-title-length + 1) * 3
       90     .
       91     assign
       92       put-string(v-memptr-console-title, 1) = v-title
       93     .
       94     run MultiByteToWideChar
       95       (input  1251
       96       ,input  0
       97       ,input  get-pointer-value(v-memptr-console-title)
       98       ,input  v-title-length
       99       ,input  get-pointer-value(v-memptr-console-title) + (v-title-length + 1)
      100       ,input  (v-title-length + 1) * 2
      101       ,output v-result
      102       ) .
      103     run SetConsoleTitleW
      104       (input  get-pointer-value(v-memptr-console-title) + (v-title-length + 1)
      105       ,output v-result
      106       ) .
      107     assign
      108       set-size(v-memptr-console-title) = 0
      109     .
      110   end.
      111   PROCEDURE AllocConsole EXTERNAL "kernel32.dll"
      112   :
      113      DEFINE RETURN PARAMETER RetParam  AS LONG .
      114   END PROCEDURE .
      115   PROCEDURE GetConsoleWindow EXTERNAL "kernel32.dll"
      116   :
      117      DEFINE RETURN PARAMETER RetParam  AS LONG .
      118   END PROCEDURE .
      119   PROCEDURE SetConsoleTitleW EXTERNAL "kernel32.dll"
      120   :
      121      DEFINE INPUT  PARAMETER lpConsoleTitle AS LONG .
      122      DEFINE RETURN PARAMETER RetParam       AS LONG .
      123   END PROCEDURE .
      124   PROCEDURE MultiByteToWideChar EXTERNAL "KERNEL32.dll"
      125   :
      126     define input  parameter uCodePage      as long.
      127     define input  parameter dwFlags        as long.
      128     define input  parameter lpMultiByteStr as long.
      129     define input  parameter cbMubtiByte    as long.
      130     define input  parameter lpWideCharStr  as long.
      131     define input  parameter cbMultiByte    as long.
      132     define return parameter iRetCode       as long.
      133   END.
