      411           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
      412         (input p-code
      413         ,input p-obj-type
      414         ,input p-obj-code
      415         ,output p-gds-code
      416         ,output p-dt-code
      417         ) no-error .
      418       if error-status :error
      419       then do:
      420         undo, return error return-value .
      421       end.
      422     end.
      423   end.
      424   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   procedure tpsi-gds-fill-tpsi-obj-table :
      426   define input parameter p-db-num like ub.db.db-num no-undo .
      427   define variable v-is-tpsi-obj as logical no-undo .
      428   define buffer buf_clients for ub.clients.
      429     do
      430     on error undo, return error return-value
      431     :
      432       for each temp-tpsi-clients :
      433         delete temp-tpsi-clients.
      434       end.
      435       _clients:
      436       for each buf_clients no-lock where
      437             buf_clients.db-num = p-db-num:
      438         assign
      439         v-is-tpsi-obj = no.
      440         run gbl/tpsi-obj.p (
      441                         input buf_clients.obj-type
      442                       ,input buf_clients.obj-code
      443                       ,output v-is-tpsi-obj) .
      444         if not v-is-tpsi-obj then NEXT _clients.
      445         create temp-tpsi-clients.
      446         buffer-copy
      447         buf_clients to
      448         temp-tpsi-clients.
      449       end.
      450     end.
      451   end procedure.
      452   procedure tpsi-gds-proprietor :
      453   define input parameter p-gds-code like ub.goods.gds-code no-undo .
      454   define input parameter p-db-num   like ub.db.db-num      no-undo .
      455   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
      456   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
      457   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
      458   define variable v-is-tpsi-obj as logical no-undo .
      459   do
      460   on error undo, return error return-value
      461   :
      462       define buffer buf_clients for ub.clients.
      463       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      464       assign
      465       p-proprietor-obj-type = "":U
      466       p-proprietor-obj-code = ?
      467       p-proprietor-host-code = ?
      468       .
      469       _gds-obj-attr:
      470       for each buf_clients no-lock where
      471               buf_clients.db-num = p-db-num,
      472         each buf_gds-obj-attr no-lock where
      473             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
      474         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
      475         AND buf_gds-obj-attr.gds-code = p-gds-code
      476         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
      477         if logical(buf_gds-obj-attr.attr-value) = yes then do:
      478           assign
      479           v-is-tpsi-obj = no.
      480           run gbl/tpsi-obj.p (
      481                           input buf_gds-obj-attr.obj-type
      482                         ,input buf_gds-obj-attr.obj-code
      483                         ,output v-is-tpsi-obj) .
      484           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
      485           assign
      486           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
      487           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
      488           p-proprietor-host-code = buf_clients.host-code
      489           .
      490           LEAVE.
      491         end.
      492       end.
      493   end.
      494   end procedure.
      495   procedure tpsi-preselect-gds-proprietor :
      496   define input parameter p-gds-code like ub.goods.gds-code no-undo .
      497   define input parameter p-db-num   like ub.db.db-num      no-undo .
      498   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
      499   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
      500   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
      501   do
      502   on error undo, return error return-value
      503   :
      504       define buffer buf_clients for ub.clients.
      505       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      506       assign
      507       p-proprietor-obj-type = "":U
      508       p-proprietor-obj-code = ?
      509       p-proprietor-host-code = ?
      510       .
      511       _gds-obj-attr:
      512       for each temp-tpsi-clients no-lock where
      513               temp-tpsi-clients.db-num = p-db-num,
      514         each buf_gds-obj-attr no-lock where
      515             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
      516         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
      517         AND buf_gds-obj-attr.gds-code = p-gds-code
      518         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
      519         if logical(buf_gds-obj-attr.attr-value) = yes then do:
      520           assign
      521           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
      522           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
      523           p-proprietor-host-code = temp-tpsi-clients.host-code
      524           .
      525           LEAVE.
      526         end.
      527       end.
      528   end.
      529   end procedure.
      530   do
      531   on error undo, return error
      532   :
      533      if p-check-tpsi-obj then
      534      run tpsi-gds-proprietor in this-procedure (
      535                                              input p-gds-code
      536                                             ,input p-db-num
      537                                             ,output p-proprietor-host-code
      538                                             ,output p-proprietor-obj-type
      539                                             ,output p-proprietor-obj-code
      540                                            )
      541                                            no-error.
      542      else
      543      run tpsi-preselect-gds-proprietor in this-procedure (
      544                                              input p-gds-code
      545                                             ,input p-db-num
      546                                             ,output p-proprietor-host-code
      547                                             ,output p-proprietor-obj-type
      548                                             ,output p-proprietor-obj-code
      549                                            )
      550                                            no-error.
      551      if error-status:error then return error return-value .
      552   end.
