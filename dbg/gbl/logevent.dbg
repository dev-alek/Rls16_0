        1   block-level on error undo, throw.
        2   define input  parameter p-server-name as character no-undo .
        3   define input  parameter p-event       as character no-undo .
        4   define input  parameter p-parameters  as character no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: logevent.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: gbl/logevent.p $":U .
       10   def var vss-description as character no-undo init "Модуль регистрации сообщений".
       11   define new global shared variable g#language as character no-undo .
       12   if g#language <> '' and g#language <> 'rus':U then do:
       13     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       14   end.
       15   do
       16   on error undo, return error return-value
       17   :
       18     def var v-command-name as character no-undo .
       19     def var v-logger-name as character no-undo .
       20     if p-event = ? then do:
       21       assign
       22         p-event = ""
       23       .
       24     end.
       25     if p-parameters = ? then do:
       26       assign
       27         p-parameters = '?'
       28       .
       29     end.
       30     assign
       31       v-logger-name = search("logevent.exe":u)
       32     .
       33     if v-logger-name <> ? then do:
       34       assign
       35         v-command-name  = v-logger-name
       36                         + (if p-server-name <> "" then " -m " + p-server-name + " " else "")
       37                         + (if p-event <> "" then " -r " + p-event + " " else "")
       38                         + " " + chr(34) + trim(p-parameters) + chr(34)
       39       .
       40       os-command silent  value (
       41         v-command-name
       42         ).
       43     end.
       44   end.
