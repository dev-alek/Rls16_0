        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as handle    no-undo .
        3   define input  parameter p-device-id     as character no-undo .
        4   define input  parameter p-user-login    as character no-undo .
        5   define input  parameter p-obj-type      as character no-undo .
        6   define input  parameter p-obj-code      as integer   no-undo .
        7   define output parameter p-send-message  as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: mtreq001.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq001.p $":U .
       13   define variable vss-description as character no-undo init "Мобильный терминал. Валидация настроек мягких чеков".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure integerm :
       76     define input  parameter p-string      as character no-undo .
       77     define input  parameter p-allow-sign  as logical   no-undo .
       78     define input  parameter p-allow-comma as logical   no-undo .
       79     define output parameter p-value       as integer   no-undo .
       80     define output parameter p-data-valid  as logical   no-undo .
       81     define output parameter p-message     as character no-undo .
       82     define variable v-replace-string as character no-undo .
       83     do
       84     on error undo, return error return-value
       85     :
       86       if p-string = ?
       87       then do:
       88         assign
       89           p-value      = ?
       90           p-data-valid = false
       91           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       92         .
       93         return .
       94       end.
       95       if p-string = ""
       96       then do:
       97         assign
       98           p-value      = ?
       99           p-data-valid = false
      100           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      101         .
      102         return .
      103       end.
      104       assign
      105         p-value = integer(p-string) no-error
      106       .
      107       if error-status :error = true
      108       then do:
      109         assign
      110           p-value      = ?
      111           p-data-valid = false
      112           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      113                                    ,p-string
      114                                    )
      115         .
      116         return .
      117       end.
      118       if index(p-string, ' ':u) > 0
      119       then do:
      120         assign
      121           p-value      = ?
      122           p-data-valid = false
      123           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      124                                    + "Строка содержит символы пробела"
      125                                    ,p-string
      126                                    )
      127         .
      128         return .
      129       end.
      130       assign
      131         v-replace-string = p-string
      132         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      141       .
      142       if p-allow-sign = true
      143       then do:
      144         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      145         then do:
      146           assign
      147             v-replace-string = substring(v-replace-string, 2)
      148           .
      149         end.
      150       end.
      151       else do:
      152         if substring(v-replace-string, 1, 1) = '+':u
      153         then do:
      154           assign
      155             p-value      = ?
      156             p-data-valid = false
      157             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      158                                     + "Задан параметр недопустимости знака челого числа. "
      159                                     + "Строка содержит символ плюс. "
      160                                     ,p-string
      161                                     )
      162           .
      163           return .
      164         end.
      165         if substring(v-replace-string, 1, 1) = '-':u
      166         then do:
      167           assign
      168             p-value      = ?
      169             p-data-valid = false
      170             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      171                                     + "Задан параметр недопустимости знака челого числа. "
      172                                     + "Строка содержит символ минус. "
      173                                     ,p-string
      174                                     )
      175           .
      176           return .
      177         end.
      178       end.
      179       if p-allow-comma = true
      180       then do:
      181         assign
      182           v-replace-string = replace(v-replace-string, ',', '')
      183         .
      184       end.
      185       else do:
      186         if index(v-replace-string, ',') > 0
      187         then do:
      188           assign
      189             p-value      = ?
      190             p-data-valid = false
      191             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      192                                     + "Задан параметр недопустимости знака разделителя тысяч."
      193                                     + "Строка содержит знак разделителя тысяч. "
      194                                     ,p-string
      195                                     )
      196           .
      197           return .
      198         end.
      199       end.
      200       if index(p-string, '.') > 0
      201       then do:
      202         assign
      203           p-value      = ?
      204           p-data-valid = false
      205           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      206                                    + "Строка содержит знак десятичной точки"
      207                                    ,p-string
      208                                    )
      209         .
      210         return .
      211       end.
      212       if v-replace-string <> fill('9', length(v-replace-string))
      213       then do:
      214         assign
      215           p-value      = ?
      216           p-data-valid = false
      217           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      218                                    + "Встречены символы, недопустимые для целого числа '&2'"
      219                                    ,p-string
      220                                    ,replace(v-replace-string, '9', '')
      221                                    )
      222         .
      223         return .
      224       end.
      225       assign
      226         p-data-valid = true
      227         p-message    = ""
      228       .
      229     end.
      230   end procedure.
      231   define variable v-user-login    as character no-undo .
      232   do
      233   on error undo, return error return-value
      234   :
      235     define variable v-sendmemptr  as memptr   no-undo .
      236     define variable hdocument as handle    no-undo .
      237     define variable hroot     as handle    no-undo .
      238     define variable hchild    as handle    no-undo .
      239     define variable htext     as handle    no-undo .
      240     define variable icounter        as integer   no-undo .
      241     define variable v-ok          as logical   no-undo .
      242     define variable v-message     as longchar  no-undo .
      243     define variable v-err-message as character no-undo .
      244     run check-data in this-procedure ( output v-ok , output v-err-message ) .
      245     create x-document hdocument.
      246     create x-noderef hroot.
      247     create x-noderef hchild.
      248     create x-noderef htext.
      249     hdocument:encoding = "UTF-8" .
      250     hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
      251     hdocument:APPEND-CHILD(hRoot).
      252     hdocument:create-node(hChild, "stts", "ELEMENT").
      253     hRoot:append-child(hChild).
      254     hdocument:create-node(hText, "", "TEXT").
      255     hChild:append-child(hText).
      256     hText:node-value = substitute( "&1" , (if v-ok then 0 else 1)).
      257     hdocument:create-node(hChild, "errmsg", "ELEMENT").
      258     hRoot:append-child(hChild).
      259     hdocument:create-node(hText, "", "TEXT").
      260     hChild:append-child(hText).
      261     hText:node-value = v-err-message .
      262     hdocument:create-node(hChild, "deviceid", "ELEMENT").
      263     hRoot:append-child(hChild).
      264     hdocument:create-node(hText, "", "TEXT").
      265     hChild:append-child(hText).
      266     hText:node-value = p-device-id.
      267     hdocument:save("LONGCHAR", v-message).
      268     delete object hdocument .
      269     delete object hroot     .
      270     delete object hchild    .
      271     delete object htext     .
      272     assign
      273       hdocument      = ?
      274       hroot          = ?
      275       hchild         = ?
      276       htext          = ?
      277       p-send-message = v-message
      278     .
      279   end.
      280   procedure check-data :
      281     define output parameter p-data-valid    as logical   no-undo .
      282     define output parameter p-error-message as character no-undo .
      283     define buffer buf_clients    for ub.clients .
      284     define buffer buf_sysconf    for ub.sysconf .
      285     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      286     define buffer buf_user-login for ub.user-login .
      287   do
      288   on error undo, return error return-value
      289   :
      290     find first buf_sys-ctrl no-lock .
      291     find first buf_user-login no-lock
      292       where buf_user-login.db-num     = buf_sys-ctrl.db-num
      293         and buf_user-login.status_    = 0
      294         and buf_user-login.user-login = p-user-login
      295       no-error .
      296     if not available buf_user-login
      297     then do:
      298       assign
      299         p-data-valid    = false
      300         p-error-message = substitute("Неизвестный пользователь &1"
      301                                     , v-user-login
      302                                     )
      303       .
      304       return .
      305     end.
      306     define variable v-obj-code      as integer   no-undo .
      307     define variable v-data-valid    as logical   no-undo .
      308     define variable v-error-message as character no-undo .
      309     find first buf_clients no-lock
      310       where buf_clients.obj-type = p-obj-type
      311         and buf_clients.obj-code = p-obj-code
      312       no-error .
      313     if not available buf_clients
      314     then do:
      315       assign
      316         p-data-valid    = false
      317         p-error-message = substitute( "Не найден объект &1 &2"
      318                                     , p-obj-type
      319                                     , p-obj-code
      320                                     )
      321       .
      322       return .
      323     end.
      324     if  p-obj-type <> 'маг':U
      325     and p-obj-type <> 'скл':U
      326     then do:
      327       assign
      328         p-data-valid    = false
      329         p-error-message = substitute("Неправильный тип объекта &1 &2"
      330                                     , p-obj-type
      331                                     , p-obj-code
      332                                     )
      333       .
      334       return .
      335     end.
      336     define variable v-host-code as integer   no-undo .
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      339     (input  buf_clients.obj-type
      340     ,input  buf_clients.obj-code
      341     ,output v-host-code
      342     )  .
      343     define variable v-object-available as logical   no-undo .
      344   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      346     (input  buf_sys-ctrl.db-num
      347     ,input  0
      348     ,input  buf_user-login.user-id
      349     ,input  buf_clients.obj-type
      350     ,input  buf_clients.obj-code
      351     ,output v-object-available
      352     )  .
      353     if v-object-available <> true
      354     then do:
      355       assign
      356         p-data-valid    = false
      357         p-error-message = substitute("Пользователю не доступен объект &1 &2"
      358                                     ,buf_clients.obj-type
      359                                     ,buf_clients.obj-code
      360                                     )
      361       .
      362       return .
      363     end.
      364     assign
      365       p-data-valid    = true
      366       p-error-message = ""
      367     .
      368   end.
      369   end procedure.
