      449   define temp-table temp_onewin_itemsSelected no-undo
      450       field its-key   as integer
      451       field itm-key   as integer
      452       field itmExtKey as character
      453       index pi is primary unique
      454           its-key
      455       index im
      456           itm-key
      457   .
      458   define variable v-onewin4-itm-key    as integer      no-undo.
      459   procedure onewin_clear :
      460       define buffer buf_temp_onewin_items        for temp_onewin_items.
      461   do
      462   for buf_temp_onewin_items
      463   on error undo, return error
      464   :
      465       empty temp-table buf_temp_onewin_items.
      466   end.
      467   end procedure.
      468   procedure onewin_add-item :
      469   define input parameter p-ext-key   as character        no-undo.
      470   define input parameter p-item-name as character        no-undo.
      471   define input parameter p-item-desc as character        no-undo.
      472   define input parameter p-selected  as logical          no-undo.
      473       define buffer buf_temp_onewin_items        for temp_onewin_items.
      474   do
      475   for buf_temp_onewin_items
      476   on error undo, return error
      477   :
      478       find last buf_temp_onewin_items no-error.
      479       if available buf_temp_onewin_items then do:
      480         v-onewin4-itm-key = buf_temp_onewin_items.itm-key.
      481       end.
      482       else do:
      483         v-onewin4-itm-key = 0.
      484       end.
      485       assign
      486           v-onewin4-itm-key = v-onewin4-itm-key + 1
      487       .
      488       create buf_temp_onewin_items.
      489       assign
      490       buf_temp_onewin_items.itm-key      = v-onewin4-itm-key
      491       buf_temp_onewin_items.itmExtKey    = p-ext-key
      492       buf_temp_onewin_items.itmName      = p-item-name
      493       buf_temp_onewin_items.itmDesc      = p-item-desc
      494       buf_temp_onewin_items.itmSelected  = p-selected
      495       .
      496   end.
      497   end procedure.
      498   procedure onewin_create-selection :
      499   define input parameter p-itm-key as integer no-undo .
      500   define input parameter p-itmextkey as character no-undo .
      501   define variable v-counter as integer no-undo .
      502   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      503   do
      504   on error undo, return error
      505   :
      506     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      507     if available buf_temp_onewin_itemsSelected then do:
      508       v-counter = buf_temp_onewin_itemsSelected.its-key.
      509     end.
      510     find first buf_temp_onewin_itemsSelected where
      511          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      512     if not available buf_temp_onewin_itemsSelected then do:
      513       create buf_temp_onewin_itemsSelected.
      514       assign
      515       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      516       v-counter = v-counter + 1
      517       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      518       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      519       .
      520     end.
      521   end.
      522   end procedure.
      523   procedure onewin_check-item :
      524   define input parameter p-ext-key   as character        no-undo.
      525   define output parameter p-exists as logical no-undo .
      526   define buffer buf_temp_onewin_items for temp_onewin_items.
      527   find first buf_temp_onewin_items where
      528   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      529   if available buf_temp_onewin_items then do:
      530     p-exists = yes.
      531   end.
      532   end procedure.
      533   define buffer obj_thbj-attr for ub.thbj-attr.
      534   define buffer glb_thbj-attr for ub.thbj-attr.
      535   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      536   define variable v-tth     as handle no-undo .
      537   define variable v-tthg    as handle no-undo .
      538   define variable v-to-create as logical no-undo.
      539   define variable v-to-create-trn as logical no-undo.
      540   define variable v-to-create-trn-g as logical no-undo.
      541   define variable str-attr as character no-undo .
      542   define temp-table thbjattr_thbj-attr-g no-undo like thbjattr_thbj-attr .
      543   assign
      544   v-tth  = buffer thbjattr_thbj-attr:table-handle .
      545   v-tthg = buffer thbjattr_thbj-attr-g:table-handle .
      546    if g#db-num <> 0 and p-obj-type = "" and  p-obj-code = 0
      547       then p-mode = 'ПРОСМОТР':U .
      548   DEFINE BUTTON B-exit AUTO-GO
      549        LABEL "&Ввод"
      550        SIZE 10 BY 1
      551        BGCOLOR 8 .
      552   DEFINE BUTTON B-Help
      553        LABEL "&Help"
      554        SIZE 10 BY 1
      555        BGCOLOR 8 .
      556   DEFINE BUTTON B-quit AUTO-END-KEY
      557        LABEL "&Отмена"
      558        SIZE 10 BY 1
      559        BGCOLOR 8 .
      560   DEFINE VARIABLE cb-section AS CHARACTER FORMAT "X(256)":U INITIAL "1"
      561        LABEL "Сервер"
      562        VIEW-AS COMBO-BOX INNER-LINES 2
      563        LIST-ITEM-PAIRS "тестовый","1",
      564                        "основной","2"
      565        DROP-DOWN-LIST
      566        SIZE 16 BY 1 NO-UNDO.
      567   DEFINE VARIABLE v-apikey AS CHARACTER FORMAT "X(256)":U
      568        LABEL "APIKey"
      569        VIEW-AS FILL-IN
      570        SIZE 97 BY 1 NO-UNDO.
      571   DEFINE VARIABLE v-login AS CHARACTER FORMAT "X(256)":U
      572        LABEL "Логин"
      573        VIEW-AS FILL-IN
      574        SIZE 42 BY 1 NO-UNDO.
      575   DEFINE VARIABLE v-login-is AS CHARACTER FORMAT "X(256)":U
      576        LABEL "Логин входа в ИС"
      577        VIEW-AS FILL-IN
      578        SIZE 50.13 BY 1 NO-UNDO.
      579   DEFINE VARIABLE v-password AS CHARACTER FORMAT "X(256)":U
      580        LABEL "Пароль"
      581        VIEW-AS FILL-IN
      582        SIZE 42 BY 1 NO-UNDO.
      583   DEFINE VARIABLE v-proxy-addres AS CHARACTER FORMAT "X(256)":U
      584        LABEL "Адрес прокси-сервера"
      585        VIEW-AS FILL-IN
      586        SIZE 52 BY 1 TOOLTIP "Адрес прокси-сервера в формате <IP>:<Port>" NO-UNDO.
      587   DEFINE VARIABLE v-proxy-login AS CHARACTER FORMAT "X(256)":U
      588        LABEL "Логин"
      589        VIEW-AS FILL-IN
      590        SIZE 21.5 BY 1 NO-UNDO.
      591   DEFINE VARIABLE v-proxy-pswd AS CHARACTER FORMAT "X(256)":U
      592        LABEL "Пароль"
      593        VIEW-AS FILL-IN
      594        SIZE 20.5 BY 1 NO-UNDO.
      595   DEFINE VARIABLE v-qrcode AS CHARACTER FORMAT "X(256)":U
      596        LABEL "Настройки для печати QR-кода"
      597        VIEW-AS FILL-IN
      598        SIZE 50.13 BY 1 NO-UNDO.
      599   DEFINE VARIABLE r-type-connect AS INTEGER
      600        VIEW-AS RADIO-SET HORIZONTAL
      601        RADIO-BUTTONS
      602             "Локально", 1,
      603   "через ГБД", 2
      604        SIZE 30 BY 1.25 NO-UNDO.
      605   DEFINE RECTANGLE RECT-1
      606        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      607        SIZE 106.5 BY 3.75.
      608   DEFINE RECTANGLE RECT-2
      609        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      610        SIZE 106.5 BY 3.25.
      611   DEFINE VARIABLE v-close AS LOGICAL INITIAL no
      612        LABEL ""
      613        VIEW-AS TOGGLE-BOX
      614        SIZE 2.5 BY .83 NO-UNDO.
      615   DEFINE VARIABLE v-manual-vcd AS LOGICAL INITIAL no
      616        LABEL ""
      617        VIEW-AS TOGGLE-BOX
      618        SIZE 2.5 BY .83 NO-UNDO.
      619   DEFINE VARIABLE v-proxy-ssl AS LOGICAL INITIAL no
      620        LABEL ""
      621        VIEW-AS TOGGLE-BOX
      622        SIZE 2.5 BY .83 NO-UNDO.
      623   DEFINE FRAME Dialog-Frame
      624        B-exit AT ROW 1 COL 1
      625        B-quit AT ROW 1 COL 11
      626        B-Help AT ROW 1 COL 88
      627        v-apikey AT ROW 3.04 COL 106 RIGHT-ALIGNED WIDGET-ID 2
      628        v-login AT ROW 4.25 COL 8 COLON-ALIGNED WIDGET-ID 4
      629        v-password AT ROW 4.25 COL 106 RIGHT-ALIGNED WIDGET-ID 6
      630        v-login-is AT ROW 6.75 COL 54.88 COLON-ALIGNED WIDGET-ID 22
      631        v-manual-vcd AT ROW 8.17 COL 57 WIDGET-ID 10
      632        v-close AT ROW 9.17 COL 57 WIDGET-ID 20
      633        r-type-connect AT ROW 9.92 COL 57 NO-LABEL WIDGET-ID 24
      634        v-qrcode AT ROW 11.17 COL 54.88 COLON-ALIGNED WIDGET-ID 8
      635        cb-section AT ROW 12.5 COL 54.88 COLON-ALIGNED WIDGET-ID 34
      636        v-proxy-addres AT ROW 15.25 COL 22.5 COLON-ALIGNED WIDGET-ID 42
      637        v-proxy-login AT ROW 16.5 COL 22.5 COLON-ALIGNED WIDGET-ID 44 PASSWORD-FIELD
      638        v-proxy-pswd AT ROW 16.5 COL 54 COLON-ALIGNED WIDGET-ID 46 PASSWORD-FIELD
      639        v-proxy-ssl AT ROW 15.25 COL 89 COLON-ALIGNED WIDGET-ID 48
      640        "Разрешено закрывать документ без указ. ВСД:" VIEW-AS TEXT
      641             SIZE 44.63 BY .92 AT ROW 9.08 COL 54.51 RIGHT-ALIGNED WIDGET-ID 18
      642        "Параметры подключения через Прокси-сервер:" VIEW-AS TEXT
      643             SIZE 43 BY .67 AT ROW 14.25 COL 35 WIDGET-ID 38
      644        "Разрешено вводить код ВСД вручную:" VIEW-AS TEXT
      645             SIZE 44.63 BY .92 AT ROW 8.08 COL 54.51 RIGHT-ALIGNED WIDGET-ID 12
      646        "Тип взаимодействия:" VIEW-AS TEXT
      647             SIZE 44.63 BY .92 AT ROW 10.04 COL 54.51 RIGHT-ALIGNED WIDGET-ID 28
      648        "  Параметры коннекта к ВЕТИС.API" VIEW-AS TEXT
      649             SIZE 32.5 BY .67 AT ROW 2 COL 37.5 WIDGET-ID 30
      650        "SSL прокси" VIEW-AS TEXT
      651             SIZE 10.63 BY .92 AT ROW 15.25 COL 88 RIGHT-ALIGNED WIDGET-ID 28
      652        RECT-1 AT ROW 2.25 COL 1.5 WIDGET-ID 36
      653        RECT-2 AT ROW 14.5 COL 1.5 WIDGET-ID 40
      654        SPACE(0.24) SKIP(0.49)
      655       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      656            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      657            TITLE "Параметры для работы с ФГИС Меркурий"
      658            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      659   ASSIGN
      660          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      661          FRAME Dialog-Frame:HIDDEN           = TRUE.
      662   ON GO OF FRAME Dialog-Frame
      663   DO:
      664     run save-proc in this-procedure no-error.
      665     if error-status :error then return no-apply.
      666   END.
      667   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      668   DO:
      669     APPLY "END-ERROR":U TO SELF.
      670   END.
      671   ON VALUE-CHANGED OF cb-section IN FRAME Dialog-Frame
      672   DO:
      673     assign cb-section .
      674   END.
      675   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      676   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      677   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   on help of frame Dialog-Frame
      679   do:
      680     run gbl/app_help.p
      681       (input this-procedure :file-name
      682       ,input ''
      683       ,input ?
      684       ) no-error.
      685     if error-status :error then do:
      686       message
      687         "Ошибка при вызове помощи"
      688         error-status :get-message(1)
      689         view-as alert-box .
      690     end.
      691   end.
      692   run minbtn-set in this-procedure .
      693   on choose of b-help in frame Dialog-Frame
      694   do:
      695     apply "help":u to frame Dialog-Frame .
      696   end.
      697   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   procedure minbtn-set :
      699       do
      700           on error undo, return error return-value
      701           :
      702           define variable ii              as integer       no-undo .
      703           define variable fh              as widget-handle no-undo .
      704           define variable hh              as widget-handle no-undo .
      705           define variable v-h             as handle        extent 4 no-undo .
      706           define variable v-name-button   as character     no-undo .
      707           define variable v-help-old-x    as decimal       no-undo .
      708           define variable v-help-old-y    as decimal       no-undo .
      709           define variable v-help-old-size as decimal       no-undo .
      710           define variable v-frame-width   as decimal       no-undo .
      711           define variable jj              as integer       no-undo .
      712           do
      713               on error undo, return error
      714               :
      715               assign
      716                   v-frame-width = frame Dialog-Frame:width - 0.3
      717                   fh            = frame Dialog-Frame:first-child
      718                   hh            = fh:first-child
      719                   ii            = 1
      720                   .
      721               do while valid-handle(hh):
      722                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      723                   do:
      724                       case lc(hh:name) :
      725                           when "b-help" then
      726                               do:
      727                                   hh:load-image-up("cmp/b-help.bmp":u) .
      728                                   hh:load-image-down("cmp/b-help.bmp":u) .
      729                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      730                                   hh:TOOLTIP = "Помощь" .
      731                                   v-help-old-x = hh:column .
      732                                   v-help-old-y = hh:row    .
      733                                   v-help-old-size = hh:width .
      734                                   hh:width-chars = 2.5 .
      735                               end.
      736                           when "b-print" then
      737                               do:
      738                                   hh:load-image("cmp/b-print.bmp":u) .
      739                                   hh:TOOLTIP = "Печать" .
      740                                   v-h[ii] = hh:handle .
      741                                   ii = ii + 1 .
      742                                   hh:width-chars = 3 .
      743                               end.
      744                           when "b-history" or
      745                           when "b-hist" then
      746                               do:
      747                                   hh:load-image("cmp/b-hist.bmp":u) .
      748                                   hh:TOOLTIP = "История" .
      749                                   v-h[ii] = hh:handle .
      750                                   ii = ii + 1 .
      751                                   hh:width-chars = 3 .
      752                               end.
      753                           when "b-sch" then
      754                               do:
      755                                   hh:load-image("cmp/b-sch.bmp":u) .
      756                                   hh:TOOLTIP = "Установка Фильтра" .
      757                                   v-h[ii] = hh:handle .
      758                                   ii = ii + 1 .
      759                                   hh:width-chars = 3 .
      760                               end.
      761                           when "b-hist-user" then
      762                               do:
      763                                   hh:load-image("cmp/b-hist.bmp":u) .
      764                                   hh:TOOLTIP = "История пользователя" .
      765                                   ii = ii + 1 .
      766                               end.
      767                       end case.
      768                   end.
      769                   hh = hh:next-sibling.
      770               end.
      771               b-help:column = v-frame-width - b-help:width-chars.
      772               jj = 0.
      773               repeat ii = 4 to 1 by -1 :
      774                   if valid-handle (v-h[ii] ) then
      775                   do:
      776                       jj  = jj + 1 .
      777                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      778                       v-h[ii]:row    = v-help-old-y .
      779                   end.
      780               end.
      781           end.
      782       end.
      783   end procedure.
      784   MAIN-BLOCK:
      785   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      786      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      787   if p-obj-type <> "" then
      788      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
      789       run enable_UI.
      790       run init-tt.
      791       RUN fill-widgets.
      792     WAIT-FOR GO OF FRAME Dialog-Frame.
      793   END.
      794   run disable_UI.
      795   PROCEDURE disable_UI :
      796     HIDE FRAME Dialog-Frame.
      797   END PROCEDURE.
      798   PROCEDURE enable_UI :
      799     DISPLAY v-apikey v-login v-password v-login-is v-manual-vcd v-close
      800             r-type-connect v-qrcode cb-section v-proxy-addres v-proxy-login
      801             v-proxy-pswd v-proxy-ssl
      802         WITH FRAME Dialog-Frame.
      803     ENABLE B-exit RECT-1 RECT-2 B-quit B-Help v-apikey v-login v-password
      804            v-login-is v-manual-vcd v-close r-type-connect v-qrcode cb-section
      805            v-proxy-addres v-proxy-login v-proxy-pswd v-proxy-ssl
      806         WITH FRAME Dialog-Frame.
      807     VIEW FRAME Dialog-Frame.
      808   END PROCEDURE.
      809   PROCEDURE fill-widgets :
      810   define variable v-value-character as character no-undo .
      811   define variable v-value-date as date no-undo .
      812   define variable v-value-decimal as decimal no-undo .
      813   define variable v-value-integer as INTEGER no-undo .
      814   define variable v-value-logical AS LOGICAL no-undo .
      815   define variable v-param-type as character no-undo .
      816   define variable v-param-value as character no-undo .
      817      assign
      818         v-tth = buffer temp-thbj-attr:table-handle
      819      .
      820   for each temp-thbj-attr:
      821     delete temp-thbj-attr.
      822   end.
      823   run adm/shattri.p (
      824       input "init":U
      825     , input p-obj-type
      826     , input p-obj-code
      827     , input 'mercur':U
      828     , input "":U
      829     , output v-value-character
      830     , output v-value-date
      831     , output v-value-decimal
      832     , output v-value-integer
      833     , output v-value-logical
      834     , output v-param-type
      835     , input-output TABLE-HANDLE v-tth
      836     ) no-error .
      837   if error-status:error then do:
      838     message
      839     "Не удалось получить начальные значения настроек" skip
      840     error-status:get-message(1) return-value
      841     view-as alert-box error .
      842     undo, return error .
      843   end.
      844   SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      845   FOR EACH temp-thbj-attr
      846     :
      847       IF temp-thbj-attr.prop-code = 'apikey':U THEN DO:
      848          v-apikey = temp-thbj-attr.property-value-character.
      849          display v-apikey with frame Dialog-Frame .
      850       END.
      851       IF temp-thbj-attr.prop-code = 'login':U THEN DO:
      852          v-login = temp-thbj-attr.property-value-character.
      853          display v-login with frame Dialog-Frame .
      854       END.
      855       IF temp-thbj-attr.prop-code = 'password':U THEN DO:
      856          v-password = temp-thbj-attr.property-value-character.
      857          display v-password with frame Dialog-Frame .
      858       END.
      859       IF temp-thbj-attr.prop-code = 'qrcode':U THEN DO:
      860          v-qrcode = temp-thbj-attr.property-value-character.
      861          display v-qrcode with frame Dialog-Frame .
      862       END.
      863       IF temp-thbj-attr.prop-code = 'close':U THEN DO:
      864          v-close = temp-thbj-attr.property-value-logical.
      865          display v-close with frame Dialog-Frame .
      866       END.
      867       IF temp-thbj-attr.prop-code = 'manual-vcd':U THEN DO:
      868          v-manual-vcd = temp-thbj-attr.property-value-logical.
      869          display v-manual-vcd with frame Dialog-Frame .
      870       END.
      871       IF temp-thbj-attr.prop-code = 'login_is':U THEN DO:
      872          v-login-is = temp-thbj-attr.property-value-character.
      873          display v-login-is with frame Dialog-Frame .
      874       END.
      875       IF temp-thbj-attr.prop-code = 'type-connect':U THEN DO:
      876          r-type-connect = temp-thbj-attr.property-value-integer .
      877          if r-type-connect = ? then r-type-connect = 1 .
      878          display r-type-connect with frame Dialog-Frame .
      879       END.
      880       IF temp-thbj-attr.prop-code = 'server':U THEN DO:
      881          cb-section = string(temp-thbj-attr.property-value-integer) .
      882          display cb-section with frame Dialog-Frame .
      883       END.
      884       IF temp-thbj-attr.prop-code = 'proxy-addres':U THEN DO:
      885          v-proxy-addres = temp-thbj-attr.property-value-character.
      886          display v-proxy-addres with frame Dialog-Frame .
      887       END.
      888        IF temp-thbj-attr.prop-code = 'proxy-login':U and temp-thbj-attr.property-value-character > '' THEN DO:
      889   define variable vss-include-info7 as character format "X(65)" no-undo
      890   initial "@(#)$Workfile$ $Revision$".
      891   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      892     (input  temp-thbj-attr.property-value-character
      893     ,output v-proxy-login
      894     ) no-error .
      895           display v-proxy-login with frame Dialog-Frame .
      896       END.
      897       IF temp-thbj-attr.prop-code = 'proxy-pswd':U and temp-thbj-attr.property-value-character > '' THEN DO:
      898   define variable vss-include-info8 as character format "X(65)" no-undo
      899   initial "@(#)$Workfile$ $Revision$".
      900   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      901     (input  temp-thbj-attr.property-value-character
      902     ,output v-proxy-pswd
      903     ) no-error .
      904          display v-proxy-pswd with frame Dialog-Frame .
      905       END.
      906       IF temp-thbj-attr.prop-code = 'proxy-ssl':U THEN DO:
      907          v-proxy-ssl = temp-thbj-attr.property-value-logical.
      908          display v-proxy-ssl with frame Dialog-Frame .
      909       END.
      910   END.
      911   END PROCEDURE.
      912   PROCEDURE init-tt :
      913   if p-mode = 'ПРОСМОТР':U then do:
      914     DISABLE
      915       v-apikey
      916       v-login
      917       v-password
      918       v-qrcode
      919       v-close
      920       v-manual-vcd
      921       v-login-is
      922       r-type-connect
      923       cb-section
      924     with frame Dialog-Frame .
      925   end.
      926   END PROCEDURE.
      927   PROCEDURE save-proc :
      928   define variable v-value-character as character no-undo .
      929   define variable v-value-date as date no-undo .
      930   define variable v-value-decimal as decimal no-undo .
      931   define variable v-value-integer as INTEGER no-undo .
      932   define variable v-value-logical AS LOGICAL no-undo .
      933   define variable v-sale-add as character no-undo .
      934   define variable v-trf-type like ub.clients.obj-type no-undo .
      935   define variable v-trf-code like ub.clients.obj-code no-undo .
      936   define variable v-param-type as character no-undo .
      937   define variable wh as widget-handle no-undo .
      938   define variable fh as widget-handle no-undo .
      939   define variable v-same as logical no-undo .
      940   define variable v-sameg as logical no-undo .
      941   define buffer buf_temp-thbj-attr for temp-thbj-attr .
      942   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
      943   ASSIGN FRAME Dialog-Frame
      944       v-apikey
      945       v-login
      946       v-password
      947       v-qrcode
      948       v-close
      949       v-manual-vcd
      950       v-login-is
      951       r-type-connect
      952       cb-section
      953       v-proxy-addres
      954       v-proxy-login
      955       v-proxy-pswd
      956       v-proxy-ssl
      957       .
      958       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'apikey':U .
      959       temp-thbj-attr.property-value-character = v-apikey.
      960       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'login':U .
      961       temp-thbj-attr.property-value-character = v-login.
      962       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'password':U .
      963       temp-thbj-attr.property-value-character = v-password.
      964       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'qrcode':U .
      965       temp-thbj-attr.property-value-character = v-qrcode.
      966       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'close':U .
      967       temp-thbj-attr.property-value-logical = v-close.
      968       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'manual-vcd':U .
      969       temp-thbj-attr.property-value-logical = v-manual-vcd.
      970       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'login_is':U .
      971       temp-thbj-attr.property-value-character = v-login-is.
      972       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'type-connect':U .
      973       temp-thbj-attr.property-value-integer = r-type-connect.
      974       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'server':U .
      975       temp-thbj-attr.property-value-integer = integer(cb-section).
      976       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'proxy-addres':U .
      977       temp-thbj-attr.property-value-character = v-proxy-addres.
      978       def var v-proxy-enc as char no-undo.
      979       SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      980       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'proxy-login':U .
      981       if v-proxy-login > ''
      982       then do :
      983   define variable vss-include-info9 as character format "X(65)" no-undo
      984   initial "@(#)$Workfile$ $Revision$".
      985     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      986     (input  v-proxy-login
      987     ,output v-proxy-enc
      988     ) no-error .
      989         temp-thbj-attr.property-value-character = if v-proxy-addres > '' then v-proxy-enc else "":U.
      990       end.
      991       else temp-thbj-attr.property-value-character = "":U .
      992       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'proxy-pswd':U .
      993       if v-proxy-pswd > ''
      994       then do :
      995   define variable vss-include-info10 as character format "X(65)" no-undo
      996   initial "@(#)$Workfile$ $Revision$".
      997     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pencrypt in g#library2
      998     (input  v-proxy-pswd
      999     ,output v-proxy-enc
     1000     ) no-error .
     1001         temp-thbj-attr.property-value-character = if v-proxy-addres > '' then v-proxy-enc else "":U.
     1002       end.
     1003       else temp-thbj-attr.property-value-character = "":U .
     1004       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'proxy-ssl':U .
     1005       temp-thbj-attr.property-value-logical = v-proxy-ssl.
     1006       do transaction:
     1007           RUN thbjattr_set-section IN THIS-PROCEDURE (
     1008                input p-obj-type
     1009               ,input p-obj-code
     1010               ,input 'mercur':U
     1011               ,INPUT table temp-thbj-attr
     1012           ) NO-ERROR.
     1013           if error-status:error then do:
     1014               message "Не удалось сохранить настройки"
     1015               view-as alert-box.
     1016               undo, return error.
     1017           end.
     1018       end.
     1019   END PROCEDURE.
