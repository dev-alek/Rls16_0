        1   block-level on error undo, throw.
        2   define output parameter par-dec as character no-undo .
        3   define output parameter par-tho as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: getexdel.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/getexdel.p $":U .
        9   define variable vss-description as character no-undo init "Определение локальных настроек системы пользователя - разделителя дес точки и тысяч".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       71      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       72   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       74     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       75   FUNCTION GetLastError
       76            RETURNS INTEGER
       77            ()
       78            IN hpWinFunc.
       79   FUNCTION GetParent
       80            RETURNS INTEGER
       81            (input hwnd as INTEGER)
       82            IN hpWinFunc.
       83   FUNCTION ShowLastError
       84            RETURNS INTEGER
       85            ()
       86            IN hpWinFunc.
       87   FUNCTION CreateProcess
       88            RETURNS INTEGER
       89            (input CommandLine as CHAR,
       90             input CurrentDir  as CHAR,
       91             input wShowWindow as INTEGER)
       92            in hpWinFunc.
       93   PROCEDURE GetDateFormatA EXTERNAL "KERNEL32" :
       94      DEFINE INPUT PARAMETER        Locale      AS LONG.
       95      DEFINE INPUT PARAMETER        dwFlags     AS LONG.
       96      DEFINE INPUT PARAMETER        lpTime      AS LONG.
       97      DEFINE INPUT PARAMETER        lpFormat    AS LONG.
       98      DEFINE INPUT-OUTPUT PARAMETER lpDateStr   AS CHAR.
       99      DEFINE INPUT PARAMETER        cchDate     AS LONG.
      100      DEFINE RETURN PARAMETER       cchReturned AS LONG.
      101   END PROCEDURE.
      102   PROCEDURE GetTimeFormatA EXTERNAL "KERNEL32" :
      103      DEFINE INPUT PARAMETER        Locale    AS LONG.
      104      DEFINE INPUT PARAMETER        dwFlags   AS LONG.
      105      DEFINE INPUT PARAMETER        lpTime    AS LONG.
      106      DEFINE INPUT PARAMETER        lpFormat  AS LONG.
      107      DEFINE INPUT-OUTPUT PARAMETER lpTimeStr AS CHAR.
      108      DEFINE INPUT PARAMETER        cchTime   AS LONG.
      109      DEFINE RETURN PARAMETER       cchReturned AS LONG.
      110   END PROCEDURE.
      111   DEFINE VARIABLE cchRet as integer no-undo.
      112   main-block:
      113   do
      114   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      115   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      116   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      117   :
      118   assign
      119   par-dec = fill(chr(32),50)
      120   par-tho = fill(chr(32),50)
      121   .
      122     RUN GetLocaleInfoA in hpApi ( 1024
      123                                  ,14
      124                                  ,input-output par-dec
      125                                  ,length(par-dec)
      126                                  ,output cchRet
      127                                     ).
      128     RUN GetLocaleInfoA in hpApi ( 1024
      129                                  ,15
      130                                  ,input-output par-tho
      131                                  ,length(par-tho)
      132                                  ,output cchRet
      133                                     ).
      134     assign
      135     par-dec = trim(par-dec)
      136     par-tho = trim(par-tho)
      137     .
      138   end.
