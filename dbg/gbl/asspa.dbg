      543   assign
      544   v-tth  = buffer thbjattr_thbj-attr:table-handle .
      545   v-tthg = buffer thbjattr_thbj-attr-g:table-handle .
      546    if g#db-num <> 0 and p-obj-type = "" and  p-obj-code = 0
      547       then p-mode = 'ПРОСМОТР':U .
