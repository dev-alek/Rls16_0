      449   define temp-table temp_onewin_itemsSelected no-undo
      450       field its-key   as integer
      451       field itm-key   as integer
      452       field itmExtKey as character
      453       index pi is primary unique
      454           its-key
      455       index im
      456           itm-key
      457   .
      458   define variable v-onewin4-itm-key    as integer      no-undo.
      459   procedure onewin_clear :
      460       define buffer buf_temp_onewin_items        for temp_onewin_items.
      461   do
      462   for buf_temp_onewin_items
      463   on error undo, return error
      464   :
      465       empty temp-table buf_temp_onewin_items.
      466   end.
      467   end procedure.
      468   procedure onewin_add-item :
      469   define input parameter p-ext-key   as character        no-undo.
      470   define input parameter p-item-name as character        no-undo.
      471   define input parameter p-item-desc as character        no-undo.
      472   define input parameter p-selected  as logical          no-undo.
      473       define buffer buf_temp_onewin_items        for temp_onewin_items.
      474   do
      475   for buf_temp_onewin_items
      476   on error undo, return error
      477   :
      478       find last buf_temp_onewin_items no-error.
      479       if available buf_temp_onewin_items then do:
      480         v-onewin4-itm-key = buf_temp_onewin_items.itm-key.
      481       end.
      482       else do:
      483         v-onewin4-itm-key = 0.
      484       end.
      485       assign
      486           v-onewin4-itm-key = v-onewin4-itm-key + 1
      487       .
      488       create buf_temp_onewin_items.
      489       assign
      490       buf_temp_onewin_items.itm-key      = v-onewin4-itm-key
      491       buf_temp_onewin_items.itmExtKey    = p-ext-key
      492       buf_temp_onewin_items.itmName      = p-item-name
      493       buf_temp_onewin_items.itmDesc      = p-item-desc
      494       buf_temp_onewin_items.itmSelected  = p-selected
      495       .
      496   end.
      497   end procedure.
      498   procedure onewin_create-selection :
      499   define input parameter p-itm-key as integer no-undo .
      500   define input parameter p-itmextkey as character no-undo .
      501   define variable v-counter as integer no-undo .
      502   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      503   do
      504   on error undo, return error
      505   :
      506     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      507     if available buf_temp_onewin_itemsSelected then do:
      508       v-counter = buf_temp_onewin_itemsSelected.its-key.
      509     end.
      510     find first buf_temp_onewin_itemsSelected where
      511          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      512     if not available buf_temp_onewin_itemsSelected then do:
      513       create buf_temp_onewin_itemsSelected.
      514       assign
      515       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      516       v-counter = v-counter + 1
      517       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      518       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      519       .
      520     end.
      521   end.
      522   end procedure.
      523   procedure onewin_check-item :
      524   define input parameter p-ext-key   as character        no-undo.
      525   define output parameter p-exists as logical no-undo .
      526   define buffer buf_temp_onewin_items for temp_onewin_items.
      527   find first buf_temp_onewin_items where
      528   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      529   if available buf_temp_onewin_items then do:
      530     p-exists = yes.
      531   end.
      532   end procedure.
      533   define buffer obj_thbj-attr for ub.thbj-attr.
