      700   END.
      701   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      702   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      703   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   on help of frame Dialog-Frame
      705   do:
      706     run gbl/app_help.p
      707       (input this-procedure :file-name
      708       ,input ''
      709       ,input ?
      710       ) no-error.
      711     if error-status :error then do:
      712       message
      713         "Ошибка при вызове помощи"
      714         error-status :get-message(1)
      715         view-as alert-box .
      716     end.
      717   end.
      718   run minbtn-set in this-procedure .
      719   on choose of b-help in frame Dialog-Frame
      720   do:
      721     apply "help":u to frame Dialog-Frame .
      722   end.
      723   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      724   procedure minbtn-set :
      725       do
      726           on error undo, return error return-value
      727           :
      728           define variable ii              as integer       no-undo .
      729           define variable fh              as widget-handle no-undo .
      730           define variable hh              as widget-handle no-undo .
      731           define variable v-h             as handle        extent 4 no-undo .
      732           define variable v-name-button   as character     no-undo .
      733           define variable v-help-old-x    as decimal       no-undo .
      734           define variable v-help-old-y    as decimal       no-undo .
      735           define variable v-help-old-size as decimal       no-undo .
      736           define variable v-frame-width   as decimal       no-undo .
      737           define variable jj              as integer       no-undo .
      738           do
      739               on error undo, return error
      740               :
      741               assign
      742                   v-frame-width = frame Dialog-Frame:width - 0.3
      743                   fh            = frame Dialog-Frame:first-child
      744                   hh            = fh:first-child
      745                   ii            = 1
      746                   .
      747               do while valid-handle(hh):
      748                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      749                   do:
      750                       case lc(hh:name) :
      751                           when "b-help" then
      752                               do:
      753                                   hh:load-image-up("cmp/b-help.bmp":u) .
      754                                   hh:load-image-down("cmp/b-help.bmp":u) .
      755                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      756                                   hh:TOOLTIP = "Помощь" .
      757                                   v-help-old-x = hh:column .
      758                                   v-help-old-y = hh:row    .
      759                                   v-help-old-size = hh:width .
      760                                   hh:width-chars = 2.5 .
      761                               end.
      762                           when "b-print" then
      763                               do:
      764                                   hh:load-image("cmp/b-print.bmp":u) .
      765                                   hh:TOOLTIP = "Печать" .
      766                                   v-h[ii] = hh:handle .
      767                                   ii = ii + 1 .
      768                                   hh:width-chars = 3 .
      769                               end.
      770                           when "b-history" or
      771                           when "b-hist" then
      772                               do:
      773                                   hh:load-image("cmp/b-hist.bmp":u) .
      774                                   hh:TOOLTIP = "История" .
      775                                   v-h[ii] = hh:handle .
      776                                   ii = ii + 1 .
      777                                   hh:width-chars = 3 .
      778                               end.
      779                           when "b-sch" then
      780                               do:
      781                                   hh:load-image("cmp/b-sch.bmp":u) .
      782                                   hh:TOOLTIP = "Установка Фильтра" .
      783                                   v-h[ii] = hh:handle .
      784                                   ii = ii + 1 .
      785                                   hh:width-chars = 3 .
      786                               end.
      787                           when "b-hist-user" then
      788                               do:
      789                                   hh:load-image("cmp/b-hist.bmp":u) .
      790                                   hh:TOOLTIP = "История пользователя" .
      791                                   ii = ii + 1 .
      792                               end.
      793                       end case.
      794                   end.
      795                   hh = hh:next-sibling.
      796               end.
      797               b-help:column = v-frame-width - b-help:width-chars.
      798               jj = 0.
      799               repeat ii = 4 to 1 by -1 :
      800                   if valid-handle (v-h[ii] ) then
      801                   do:
      802                       jj  = jj + 1 .
      803                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      804                       v-h[ii]:row    = v-help-old-y .
      805                   end.
      806               end.
      807           end.
      808       end.
      809   end procedure.
      810   MAIN-BLOCK:
      811   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      812      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      813   if p-obj-type <> "" then
      814      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
      815   define variable loc#log as logical   no-undo .
      816   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      817   do:
      818     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      819       (input  g#db-num
      820       ,input  g#userid
      821       ,input  0
      822       ,input  'actn_nakl-par_lookup':U
      823       ,input  'object':U
      824       ,input  v-cntxt-host-code-obj
      825       ,input  v-cntxt-obj-type
      826       ,input  v-cntxt-obj-code
      827       ,input  0
      828       ,input  0
      829       ,input  0
      830       ,input  true
      831       ,output loc#log
      832       )  .
      833   end.
      834      if loc#log <> yes then do: return error. end.
      835       run init-tt.
      836       run enable_UI.
      837       run init-proc.
      838     WAIT-FOR GO OF FRAME Dialog-Frame.
      839   END.
      840   run disable_UI.
      841   PROCEDURE disable_UI :
      842     HIDE FRAME Dialog-Frame.
      843   END PROCEDURE.
      844   PROCEDURE enable_UI :
      845     DISPLAY ass-srokiztdel crit-srokgod ass-num-days-igt ass-proc-matr-shabl
      846            v-ass-srokiztdel v-crit-srokgod v-Ass-Num-days-igt
      847             v-Ass-proc-matr-shabl
      848         WITH FRAME Dialog-Frame.
      849     ENABLE B-exit I-ass-srokiztdel I-crit-srokgod I-ass-num-days-igt
      850            I-ass-proc-matr-shabl B-quit B-Help B-6 ass-srokiztdel crit-srokgod
      851            B-7 B-8 ass-num-days-igt B-9 ass-proc-matr-shabl v-ass-srokiztdel
      852            v-crit-srokgod v-Ass-Num-days-igt v-Ass-proc-matr-shabl
      853         WITH FRAME Dialog-Frame.
      854     VIEW FRAME Dialog-Frame.
      855   END PROCEDURE.
      856   PROCEDURE fill-widgets :
      857   define variable v-value-character as character no-undo .
      858   define variable v-value-date as date no-undo .
      859   define variable v-value-decimal as decimal no-undo .
      860   define variable v-value-integer as INTEGER no-undo .
      861   define variable v-value-logical AS LOGICAL no-undo .
      862   define variable v-param-type as character no-undo .
      863   define variable v-param-value as character no-undo .
      864   for each thbjattr_thbj-attr:
      865     delete thbjattr_thbj-attr.
      866   end.
      867   for each thbjattr_thbj-attr-g:
      868     delete thbjattr_thbj-attr-g.
      869   end.
      870   for each temp-thbj-attr:
      871     delete temp-thbj-attr.
      872   end.
      873   run adm/shattri.p (
      874       input "init":U
      875     , input p-obj-type
      876     , input p-obj-code
      877     , input 'Ass-obj':U
      878     , input "":U
      879     , output v-value-character
      880     , output v-value-date
      881     , output v-value-decimal
      882     , output v-value-integer
      883     , output v-value-logical
      884     , output v-param-type
      885     , input-output TABLE-HANDLE v-tth
      886     ) no-error .
      887   if error-status:error then do:
      888     message
      889     "Не удалось получить начальные значения настроек" skip
      890     error-status:get-message(1) return-value
      891     view-as alert-box error .
      892     undo, return error .
      893   end.
      894   FOR EACH thbjattr_thbj-attr
      895   :
      896   IF thbjattr_thbj-attr.prop-code = 'ass-srokiztdel':U THEN DO:     ass-srokiztdel = thbjattr_thbj-attr.property-value-integer.     ass-srokiztdel:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display ass-srokiztdel with frame Dialog-Frame . END.
      897   IF thbjattr_thbj-attr.prop-code = 'crit-srokgod':U THEN DO:     crit-srokgod = thbjattr_thbj-attr.property-value-integer.     crit-srokgod:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display crit-srokgod with frame Dialog-Frame . END.
      898   IF thbjattr_thbj-attr.prop-code = 'ass-num-days-igt':U THEN DO:     ass-num-days-igt = thbjattr_thbj-attr.property-value-integer.     ass-num-days-igt:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display ass-num-days-igt with frame Dialog-Frame . END.
      899   IF thbjattr_thbj-attr.prop-code = 'ass-proc-matr-shabl':U THEN DO:     ass-proc-matr-shabl = thbjattr_thbj-attr.property-value-integer.     ass-proc-matr-shabl:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display ass-proc-matr-shabl with frame Dialog-Frame . END.
      900     create temp-thbj-attr.
      901     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
      902   END.
      903   define variable v-tooltip as character no-undo .
      904   define variable v-label   as character no-undo .
      905   define variable v-tooltip-code as character no-undo .
      906   run thbjattr_tooltip in this-procedure (    input   'Ass-obj':U   ,input  "ass-srokiztdel"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-ass-srokiztdel:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-ass-srokiztdel:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
      907   run thbjattr_tooltip in this-procedure (    input   'Ass-obj':U   ,input  "crit-srokgod"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-crit-srokgod:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-crit-srokgod:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
      908   run thbjattr_tooltip in this-procedure (    input   'Ass-obj':U   ,input  "ass-num-days-igt"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-ass-num-days-igt:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-ass-num-days-igt:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
      909   run thbjattr_tooltip in this-procedure (    input   'Ass-obj':U   ,input  "ass-proc-matr-shabl"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-ass-proc-matr-shabl:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-ass-proc-matr-shabl:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
      910   END PROCEDURE.
      911   PROCEDURE init-proc :
      912   define variable v-i as integer   no-undo .
      913   define variable v-value-character as character no-undo .
      914   define variable v-value-date as date no-undo .
      915   define variable v-value-decimal as decimal no-undo .
      916   define variable v-value-integer as INTEGER no-undo .
      917   define variable v-value-logical AS LOGICAL no-undo .
      918   define variable v-type as character no-undo .
      919   define variable v-value as character no-undo .
      920   define variable v-found as decimal   no-undo .
      921     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      922       find first obj_thbj-attr exclusive-lock where
      923                 obj_thbj-attr.obj-type = p-obj-type
      924           and   obj_thbj-attr.obj-code = p-obj-code
      925           and   obj_thbj-attr.upper-prop-code = 'Ass-obj':U
      926           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
      927        if locked obj_thbj-attr then do:
      928           message
      929           vss-workfile vss-revision vss-description skip
      930           'Ass-obj':U skip
      931           "Запись ПАРАМЕТРОВ  занята"
      932           view-as alert-box error .
      933           undo, return error.
      934         end.
      935     end.
      936     else do:
      937       find first obj_thbj-attr no-lock where
      938             obj_thbj-attr.obj-type = p-obj-type
      939       and   obj_thbj-attr.obj-code = p-obj-code
      940       and   obj_thbj-attr.upper-prop-code = 'Ass-obj':U
      941       and   obj_thbj-attr.prop-code = '':u no-error.
      942     end.
      943     if not available obj_thbj-attr then do:
      944       assign
      945         v-to-create-trn  = true
      946         .
      947       message
      948       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      949                   chr(10))
      950                    view-as alert-box warning.
      951     end.
      952     run fill-widgets in this-procedure no-error.
      953     if error-status:error then undo, return error.
      954     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      955        disable
      956        ass-srokiztdel
      957        crit-srokgod
      958        ass-num-days-igt
      959        ass-proc-matr-shabl
      960        with frame Dialog-Frame.
      961        B-exit:label = "Вы&ход"  .
      962        hide B-quit in frame Dialog-Frame .
      963     END.
      964     if not ( p-obj-type = "" and p-obj-code = 0 ) then do:
      965        disable
      966        with frame Dialog-Frame.
      967     end.
      968   end procedure.
      969   PROCEDURE init-tt :
      970   END PROCEDURE.
      971   PROCEDURE save-proc :
      972   define variable v-value-character as character no-undo .
      973   define variable v-value-date as date no-undo .
      974   define variable v-value-decimal as decimal no-undo .
      975   define variable v-value-integer as INTEGER no-undo .
      976   define variable v-value-logical AS LOGICAL no-undo .
      977   define variable v-sale-add as character no-undo .
      978   define variable v-trf-type like ub.clients.obj-type no-undo .
      979   define variable v-trf-code like ub.clients.obj-code no-undo .
      980   define variable v-param-type as character no-undo .
      981   define variable wh as widget-handle no-undo .
      982   define variable fh as widget-handle no-undo .
      983   define variable v-same as logical no-undo .
      984   define variable v-sameg as logical no-undo .
      985   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
      986   define variable loc#log as logical   no-undo .
      987   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   do:
      989     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      990       (input  g#db-num
      991       ,input  g#userid
      992       ,input  0
      993       ,input  'actn_nakl-par_update':U
      994       ,input  'object':U
      995       ,input  v-cntxt-host-code-obj
      996       ,input  v-cntxt-obj-type
      997       ,input  v-cntxt-obj-code
      998       ,input  0
      999       ,input  0
     1000       ,input  0
     1001       ,input  true
     1002       ,output loc#log
     1003       )  .
     1004   end.
     1005     if loc#log <> yes then do: return error. end.
     1006   ASSIGN
     1007       FRAME Dialog-Frame
     1008       ass-srokiztdel
     1009       crit-srokgod
     1010       ass-num-days-igt
     1011    .
     1012   assign
     1013     fh = frame Dialog-Frame:first-child
     1014     wh = fh:first-child
     1015     .
     1016   do while valid-handle(wh):
     1017     if wh:private-data begins "recid2=" then do:
     1018       find first thbjattr_thbj-attr where
     1019                  recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1020                  no-error .
     1021       if available thbjattr_thbj-attr then do:
     1022       assign
     1023       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1024              thbjattr_thbj-attr.obj-type = p-obj-type.
     1025              thbjattr_thbj-attr.obj-code = p-obj-code.
     1026       end.
     1027     end.
     1028     wh = wh:next-sibling.
     1029   end.
     1030   v-same = yes.
     1031   for each thbjattr_thbj-attr where
     1032            thbjattr_thbj-attr.obj-type = p-obj-type and
     1033            thbjattr_thbj-attr.obj-code = p-obj-code ,
     1034       first temp-thbj-attr where
     1035             temp-thbj-attr.obj-type = p-obj-type
     1036         and temp-thbj-attr.obj-code = p-obj-code
     1037         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1038         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code :
     1039      buffer-compare
     1040      thbjattr_thbj-attr
     1041      to temp-thbj-attr
     1042      save result in v-same.
     1043      if not v-same then leave.
     1044   end.
     1045   v-same = no.
     1046   v-sameg = yes.
     1047   do transaction
     1048   on error undo, return error return-value
     1049   :
     1050     run thbjattr_set-section in this-procedure (
     1051           input p-obj-type
     1052         , input p-obj-code
     1053         , input 'Ass-obj':U
     1054         , input table thbjattr_thbj-attr
     1055     ) no-error.
     1056     if error-status:error then do:
     1057       message error-status:get-message(1)  skip
     1058       return-value
     1059       view-as alert-box.
     1060       undo, return error.
     1061     end.
     1062     if p-obj-type = "" and p-obj-code = 0  then do:
     1063     end.
     1064   end.
     1065   END PROCEDURE.
