      659     run gbl/v-taobj.w
      660         ('Ass-obj':U,
      661          "ass-srokiztdel"
      662          ).
      663   END.
      664   ON CHOOSE OF B-7 IN FRAME Dialog-Frame
      665   DO:
      666     run gbl/v-taobj.w
      667         ('Ass-obj':U,
      668          "crit-srokgod"
      669          ).
      670   END.
      671   ON CHOOSE OF B-8 IN FRAME Dialog-Frame
      672   DO:
      673     run gbl/v-taobj.w
      674         ('Ass-obj':U,
      675          "ass-num-days-igt"
      676          ).
      677   END.
      678   ON CHOOSE OF B-9 IN FRAME Dialog-Frame
      679   DO:
      680     run gbl/v-taobj.w
      681         ('Ass-obj':U,
      682          "ass-proc-matr-shabl"
      683          ).
      684   END.
      685   ON MOUSE-SELECT-CLICK OF I-ass-num-days-igt IN FRAME Dialog-Frame
      686   DO:
      687     MESSAGE I-ass-num-days-igt:private-data  VIEW-AS ALERT-BOX INFORMATION.
      688   END.
      689   ON MOUSE-SELECT-CLICK OF I-ass-proc-matr-shabl IN FRAME Dialog-Frame
