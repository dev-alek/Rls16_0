        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out     as character no-undo .
        3   define input  parameter p-file-name         as character no-undo .
        4   define input  parameter p-data-valid        as logical   no-undo .
        5   define input  parameter p-error-message     as character no-undo .
        6   define input  parameter p-user-login        as character no-undo .
        7   define input  parameter p-obj-type          as character no-undo .
        8   define input  parameter p-obj-code          as character no-undo .
        9   define input  parameter p-host-code         as character no-undo .
       10   define input  parameter p-close-status      as character no-undo .
       11   define input  parameter p-cop-check         as character no-undo .
       12   define input  parameter p-prod-artic-search as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: rt-req04.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req04.p $":U .
       18   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 04. Приемка товара. Настройка".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure integerm :
       79     define input  parameter p-string      as character no-undo .
       80     define input  parameter p-allow-sign  as logical   no-undo .
       81     define input  parameter p-allow-comma as logical   no-undo .
       82     define output parameter p-value       as integer   no-undo .
       83     define output parameter p-data-valid  as logical   no-undo .
       84     define output parameter p-message     as character no-undo .
       85     define variable v-replace-string as character no-undo .
       86     do
       87     on error undo, return error return-value
       88     :
       89       if p-string = ?
       90       then do:
       91         assign
       92           p-value      = ?
       93           p-data-valid = false
       94           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       95         .
       96         return .
       97       end.
       98       if p-string = ""
       99       then do:
      100         assign
      101           p-value      = ?
      102           p-data-valid = false
      103           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      104         .
      105         return .
      106       end.
      107       assign
      108         p-value = integer(p-string) no-error
      109       .
      110       if error-status :error = true
      111       then do:
      112         assign
      113           p-value      = ?
      114           p-data-valid = false
      115           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      116                                    ,p-string
      117                                    )
      118         .
      119         return .
      120       end.
      121       if index(p-string, ' ':u) > 0
      122       then do:
      123         assign
      124           p-value      = ?
      125           p-data-valid = false
      126           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      127                                    + "Строка содержит символы пробела"
      128                                    ,p-string
      129                                    )
      130         .
      131         return .
      132       end.
      133       assign
      134         v-replace-string = p-string
      135         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      144       .
      145       if p-allow-sign = true
      146       then do:
      147         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      148         then do:
      149           assign
      150             v-replace-string = substring(v-replace-string, 2)
      151           .
      152         end.
      153       end.
      154       else do:
      155         if substring(v-replace-string, 1, 1) = '+':u
      156         then do:
      157           assign
      158             p-value      = ?
      159             p-data-valid = false
      160             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      161                                     + "Задан параметр недопустимости знака челого числа. "
      162                                     + "Строка содержит символ плюс. "
      163                                     ,p-string
      164                                     )
      165           .
      166           return .
      167         end.
      168         if substring(v-replace-string, 1, 1) = '-':u
      169         then do:
      170           assign
      171             p-value      = ?
      172             p-data-valid = false
      173             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      174                                     + "Задан параметр недопустимости знака челого числа. "
      175                                     + "Строка содержит символ минус. "
      176                                     ,p-string
      177                                     )
      178           .
      179           return .
      180         end.
      181       end.
      182       if p-allow-comma = true
      183       then do:
      184         assign
      185           v-replace-string = replace(v-replace-string, ',', '')
      186         .
      187       end.
      188       else do:
      189         if index(v-replace-string, ',') > 0
      190         then do:
      191           assign
      192             p-value      = ?
      193             p-data-valid = false
      194             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      195                                     + "Задан параметр недопустимости знака разделителя тысяч."
      196                                     + "Строка содержит знак разделителя тысяч. "
      197                                     ,p-string
      198                                     )
      199           .
      200           return .
      201         end.
      202       end.
      203       if index(p-string, '.') > 0
      204       then do:
      205         assign
      206           p-value      = ?
      207           p-data-valid = false
      208           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      209                                    + "Строка содержит знак десятичной точки"
      210                                    ,p-string
      211                                    )
      212         .
      213         return .
      214       end.
      215       if v-replace-string <> fill('9', length(v-replace-string))
      216       then do:
      217         assign
      218           p-value      = ?
      219           p-data-valid = false
      220           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      221                                    + "Встречены символы, недопустимые для целого числа '&2'"
      222                                    ,p-string
      223                                    ,replace(v-replace-string, '9', '')
      224                                    )
      225         .
      226         return .
      227       end.
      228       assign
      229         p-data-valid = true
      230         p-message    = ""
      231       .
      232     end.
      233   end procedure.
      234   define new global shared variable g#library  as handle no-undo .
      235   define new global shared variable g#library2 as handle no-undo .
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   function rtencode returns character
      238     ( p-init-string as character
      239     ) :
      240     define variable v-encode-string as character no-undo .
      241     if p-init-string = ?
      242     then do:
      243       assign
      244         v-encode-string = '?':u
      245       .
      246       return v-encode-string .
      247     end.
      248     if p-init-string = '?':u
      249     then do:
      250       assign
      251         v-encode-string = '~~077':u
      252       .
      253       return v-encode-string .
      254     end.
      255     assign
      256       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      257       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      258       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      259     .
      260     return v-encode-string .
      261   end function .
      262   define stream sout .
      263   define variable v-data-valid    as logical   no-undo .
      264   define variable v-error-message as character no-undo .
      265   do
      266   on error undo, return error return-value
      267   :
      268     if p-data-valid = true
      269     then do:
      270       run check-data in this-procedure
      271         (output  v-data-valid
      272         ,output  v-error-message
      273         ) no-error .
      274       if error-status :error
      275       then do:
      276         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      277                                     ,error-status :get-message(1)
      278                                     ,return-value
      279                                     ) .
      280       end.
      281     end.
      282     else do:
      283       assign
      284         v-data-valid    = p-data-valid
      285         v-error-message = p-error-message
      286       .
      287     end.
      288     define variable v-temp-file-name as character no-undo .
      289     assign
      290       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      291     .
      292     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      293     if v-data-valid = true
      294     then do:
      295       put stream sout unformatted 'status:0' + chr(10) .
      296       put stream sout unformatted 'message:' + chr(10) .
      297     end.
      298     else do:
      299       put stream sout unformatted 'status:1' + chr(10) .
      300       put stream sout unformatted substitute('message:&1', rtencode(v-error-message)) + chr(10) .
      301     end.
      302     output stream sout close .
      303     os-delete value(p-directory-out + '/':u + p-file-name) .
      304     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      305               value(p-directory-out + '/':u + p-file-name)
      306               .
      307   end.
      308   procedure check-data :
      309     define output parameter p-data-valid    as logical   no-undo .
      310     define output parameter p-error-message as character no-undo .
      311     define buffer buf_clients    for ub.clients .
      312     define buffer buf_sysconf    for ub.sysconf .
      313     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      314     define buffer buf_user-login for ub.user-login .
      315     do
      316     on error undo, return error return-value
      317     :
      318       find first buf_sys-ctrl no-lock .
      319       find first buf_user-login no-lock
      320         where buf_user-login.db-num = buf_sys-ctrl.db-num
      321           and buf_user-login.status_    = 0
      322           and buf_user-login.user-login = p-user-login
      323         no-error .
      324       if not available buf_user-login
      325       then do:
      326         assign
      327           p-data-valid    = false
      328           p-error-message = substitute("Неизвестный пользователь &1"
      329                                       ,p-error-message
      330                                       )
      331         .
      332         return .
      333       end.
      334       define variable v-obj-code      as integer   no-undo .
      335       define variable v-data-valid    as logical   no-undo .
      336       define variable v-error-message as character no-undo .
      337       if p-obj-code = ""
      338       then do:
      339         assign
      340           p-data-valid    = false
      341           p-error-message = "Не задан код объекта"
      342         .
      343         return .
      344       end.
      345       run integerm in this-procedure
      346         (input  p-obj-code
      347         ,input  false
      348         ,input  false
      349         ,output v-obj-code
      350         ,output v-data-valid
      351         ,output v-error-message
      352         ) .
      353       if v-data-valid <> true
      354       then do:
      355         assign
      356           p-data-valid    = false
      357           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      358                                       ,p-obj-code
      359                                       ,v-error-message
      360                                       )
      361         .
      362         return .
      363       end.
      364       find first buf_clients no-lock
      365         where buf_clients.obj-type = p-obj-type
      366           and buf_clients.obj-code = v-obj-code
      367         no-error .
      368       if not available buf_clients
      369       then do:
      370         assign
      371           p-data-valid    = false
      372           p-error-message = substitute("Не найден объект &1 &2"
      373                                       ,p-obj-type
      374                                       ,v-obj-code
      375                                       )
      376         .
      377         return .
      378       end.
      379       if  p-obj-type <> 'маг':U
      380       and p-obj-type <> 'скл':U
      381       then do:
      382         assign
      383           p-data-valid    = false
      384           p-error-message = substitute("Неправильный тип объекта &1 &2"
      385                                       ,p-obj-type
      386                                       ,v-obj-code
      387                                       )
      388         .
      389         return .
      390       end.
      391       define variable v-host-code as integer   no-undo .
      392       run integerm in this-procedure
      393         (input  p-host-code
      394         ,input  false
      395         ,input  false
      396         ,output v-host-code
      397         ,output v-data-valid
      398         ,output v-error-message
      399         ) .
      400       if v-data-valid <> true
      401       then do:
      402         assign
      403           p-data-valid    = false
      404           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      405                                       ,p-host-code
      406                                       ,v-error-message
      407                                       )
      408         .
      409         return .
      410       end.
      411       define variable v-obj-host-code as integer   no-undo .
      412   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      414     (input  buf_clients.obj-type
      415     ,input  buf_clients.obj-code
      416     ,output v-obj-host-code
      417     )  .
      418       if v-host-code <> v-obj-host-code
      419       then do:
      420         assign
      421           p-data-valid    = false
      422           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      423                                       ,p-host-code
      424                                       ,v-obj-host-code
      425                                       ,buf_clients.obj-type
      426                                       ,buf_clients.obj-code
      427                                       )
      428         .
      429         return .
      430       end.
      431       define variable v-object-available as logical   no-undo .
