      468       ,output v-valid-act
      469       )  .
      470   end.
      471       if v-valid-act <> true
      472       then do:
      473         assign
      474           p-data-valid    = false
      475           p-error-message = return-value
      476         .
      477         return .
      478       end.
      479       find first buf_sysconf no-lock
      480         where buf_sysconf.host-code = v-host-code
      481         no-error .
      482       if not available buf_sysconf
      483       then do:
      484         assign
      485           p-data-valid    = false
      486           p-error-message = substitute("Не найдена фирма &1"
      487                                       ,v-host-code
      488                                       )
      489         .
      490         return .
      491       end.
      492       if  p-close-status <> 'накл+':u
      493       and p-close-status <> 'факт':u
      494       then do:
      495         assign
      496           p-data-valid    = false
      497           p-error-message = substitute("Неизвестный статус &1"
      498                                       ,p-close-status
      499                                       )
      500         .
      501         return .
      502       end.
