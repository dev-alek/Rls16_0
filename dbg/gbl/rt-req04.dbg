      447                                       ,buf_clients.obj-code
      448                                       )
      449         .
      450         return .
      451       end.
      452       define variable v-valid-act   as logical   no-undo .
      453   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   do:
      455     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      456       (input  buf_sys-ctrl.db-num
      457       ,input  buf_user-login.user-id
      458       ,input  0
      459       ,input  'actn_rt-edit-doc_work':U
      460       ,input  'object':U
      461       ,input  v-host-code
      462       ,input  buf_clients.obj-type
