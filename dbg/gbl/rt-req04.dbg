      528       (input  buf_sys-ctrl.db-num
      529       ,input  buf_user-login.user-id
      530       ,input  0
      531       ,input  'actn_rt-edit-doc_close-doc':U
      532       ,input  'object':U
      533       ,input  v-host-code
      534       ,input  buf_clients.obj-type
      535       ,input  buf_clients.obj-code
      536       ,input  0
      537       ,input  0
      538       ,input  0
      539       ,input  false
      540       ,output v-valid-act
      541       )  .
      542   end.
      543       end.
      544       else do:
      545   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   do:
      547     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      548       (input  buf_sys-ctrl.db-num
      549       ,input  buf_user-login.user-id
      550       ,input  0
      551       ,input  'actn_rt-edit-doc_close-fact':U
      552       ,input  'object':U
      553       ,input  v-host-code
      554       ,input  buf_clients.obj-type
      555       ,input  buf_clients.obj-code
      556       ,input  0
      557       ,input  0
      558       ,input  0
      559       ,input  false
      560       ,output v-valid-act
      561       )  .
      562   end.
      563       end.
      564       if v-valid-act <> true
      565       then do:
      566         assign
      567           p-data-valid    = false
      568           p-error-message = return-value
      569         .
      570         return .
      571       end.
      572       if ( lookup( p-cop-check , '0,1':u ) = 0 )
      573       then do:
      574         assign
      575           p-data-valid    = false
      576           p-error-message = substitute( "Неверное значение параметра cop_check : &1" , p-cop-check )
      577         .
      578         return .
      579       end.
      580       if ( lookup( p-prod-artic-search , '0,1':u ) = 0 )
      581       then do:
      582         assign
      583           p-data-valid    = false
      584           p-error-message = substitute( "Неверное значение параметра prod_artic_search : &1" , p-prod-artic-search )
      585         .
      586         return .
      587       end.
      588       assign
      589         p-data-valid    = true
      590         p-error-message = ""
      591       .
      592     end.
      593   end procedure.
