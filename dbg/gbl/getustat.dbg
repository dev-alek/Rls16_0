        1   block-level on error undo, throw.
        2   define input  parameter p-userio-id        as integer   no-undo .
        3   define output parameter p-sys-time-mjd     as decimal   no-undo .
        4   define output parameter p-userio-ai-read   as decimal   no-undo .
        5   define output parameter p-userio-ai-write  as decimal   no-undo .
        6   define output parameter p-userio-bi-read   as decimal   no-undo .
        7   define output parameter p-userio-bi-write  as decimal   no-undo .
        8   define output parameter p-userio-db-access as decimal   no-undo .
        9   define output parameter p-userio-db-read   as decimal   no-undo .
       10   define output parameter p-userio-db-write  as decimal   no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: getustat.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/getustat.p $":U .
       16   define variable vss-description as character no-undo init "Получить статистику работы пользователя с базой данных".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure sys-time_get-sys :
       73     define output parameter p-year         as integer   no-undo .
       74     define output parameter p-month        as integer   no-undo .
       75     define output parameter p-day          as integer   no-undo .
       76     define output parameter p-hour         as integer   no-undo .
       77     define output parameter p-minute       as integer   no-undo .
       78     define output parameter p-second       as integer   no-undo .
       79     define output parameter p-milliseconds as integer   no-undo .
       80     define variable v-system-time-structure as memptr    no-undo.
       81     do
       82     on error undo, return error return-value
       83     :
       84       assign
       85         set-size(v-system-time-structure) = 16
       86       .
       87       run GetSystemTime
       88         (input  get-pointer-value(v-system-time-structure)
       89         ) .
       90       assign
       91         p-year         = get-short(v-system-time-structure,  1)
       92         p-month        = get-short(v-system-time-structure,  3)
       93         p-day          = get-short(v-system-time-structure,  7)
       94         p-hour         = get-short(v-system-time-structure,  9)
       95         p-minute       = get-short(v-system-time-structure, 11)
       96         p-second       = get-short(v-system-time-structure, 13)
       97         p-milliseconds = get-short(v-system-time-structure, 15)
       98       .
       99       assign
      100         set-size(v-system-time-structure) = 0
      101       .
      102     end.
      103   end procedure.
      104   procedure sys-time_get-comp-user-name :
      105     define output parameter p-computer-name as character no-undo .
      106     define output parameter p-user-name     as character no-undo .
      107     define output parameter p-process-pid   as integer   no-undo .
      108     define variable v-return-value  as integer   no-undo .
      109     define variable v-buffer-length as integer   no-undo .
      110     define variable v-buffer-memptr as memptr    no-undo .
      111     do
      112     on error undo, return error return-value
      113     :
      114       assign
      115         v-buffer-length = 1024
      116         set-size(v-buffer-memptr) = v-buffer-length + 4
      117       .
      118       assign
      119         put-long(v-buffer-memptr, 1) = v-buffer-length
      120       .
      121       run GetComputerNameA
      122         (input  get-pointer-value(v-buffer-memptr) + 4
      123         ,input  get-pointer-value(v-buffer-memptr)
      124         ,output v-return-value
      125         ) .
      126       if v-return-value <> 0
      127       then do:
      128         assign
      129           p-computer-name = get-string(v-buffer-memptr, 5)
      130         .
      131       end.
      132       assign
      133         put-long(v-buffer-memptr, 1) = v-buffer-length
      134       .
      135       run GetUserNameA
      136         (input  get-pointer-value(v-buffer-memptr) + 4
      137         ,input  get-pointer-value(v-buffer-memptr)
      138         ,output v-return-value
      139         ) .
      140       if v-return-value <> 0
      141       then do:
      142         assign
      143           p-user-name = get-string(v-buffer-memptr, 5)
      144         .
      145       end.
      146       run GetCurrentProcessId
      147         (output p-process-pid
      148         ) .
      149       assign
      150         set-size(v-buffer-memptr) = 0
      151       .
      152     end.
      153   end procedure.
      154   procedure sys-time_get-http :
      155     define output parameter p-http-time as character no-undo .
      156     define variable v-year         as integer   no-undo .
      157     define variable v-month        as integer   no-undo .
      158     define variable v-day-of-week  as integer   no-undo .
      159     define variable v-day          as integer   no-undo .
      160     define variable v-hour         as integer   no-undo .
      161     define variable v-minute       as integer   no-undo .
      162     define variable v-second       as integer   no-undo .
      163     define variable v-milliseconds as integer   no-undo .
      164     do
      165     on error undo, return error return-value
      166     :
      167       run sys-time_get-sys in this-procedure
      168         (output v-year
      169         ,output v-month
      170         ,output v-day
      171         ,output v-hour
      172         ,output v-minute
      173         ,output v-second
      174         ,output v-milliseconds
      175         ) .
      176       assign
      177         v-day-of-week = weekday(date(v-month, v-day, v-year))
      178         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      179                     + ', ':u
      180                     + string(v-day, '99':u)
      181                     + ' ':u
      182                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      183                     + ' ':u
      184                     + string(v-year, '9999':u)
      185                     + ' ':u
      186                     + string(v-hour, '99':u)
      187                     + ':':u
      188                     + string(v-minute, '99':u)
      189                     + ':':u
      190                     + string(v-second, '99':u)
      191                     + ' ':u
      192                     + 'GMT':u
      193       .
      194     end.
      195   end procedure.
      196   procedure sys-time_set-sys :
      197     define input  parameter p-year         as integer   no-undo .
      198     define input  parameter p-month        as integer   no-undo .
      199     define input  parameter p-day          as integer   no-undo .
      200     define input  parameter p-hour         as integer   no-undo .
      201     define input  parameter p-minute       as integer   no-undo .
      202     define input  parameter p-second       as integer   no-undo .
      203     define input  parameter p-milliseconds as integer   no-undo .
      204     define variable v-system-time-structure as memptr    no-undo.
      205     define variable v-return-value as integer   no-undo .
      206     define variable v-day-of-week  as integer   no-undo .
      207     do
      208     on error undo, return error return-value
      209     :
      210       assign
      211         v-day-of-week = weekday(date(p-month, p-day, p-year))
      212       .
      213       assign
      214         set-size(v-system-time-structure) = 16
      215       .
      216       assign
      217         put-short(v-system-time-structure,  1) = p-year
      218         put-short(v-system-time-structure,  3) = p-month
      219         put-short(v-system-time-structure,  5) = v-day-of-week
      220         put-short(v-system-time-structure,  7) = p-day
      221         put-short(v-system-time-structure,  9) = p-hour
      222         put-short(v-system-time-structure, 11) = p-minute
      223         put-short(v-system-time-structure, 13) = p-second
      224         put-short(v-system-time-structure, 15) = p-milliseconds
      225       .
      226       run SetSystemTime
      227         (input  get-pointer-value(v-system-time-structure)
      228         ,output v-return-value
      229         ) .
      230       assign
      231         set-size(v-system-time-structure) = 0
      232       .
      233       if v-return-value = 0
      234       then do:
      235         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      236       end.
      237     end.
      238   end procedure.
      239   procedure sys-time_sys-to-mjd :
      240     define input  parameter p-year         as integer   no-undo .
      241     define input  parameter p-month        as integer   no-undo .
      242     define input  parameter p-day          as integer   no-undo .
      243     define input  parameter p-hour         as integer   no-undo .
      244     define input  parameter p-minute       as integer   no-undo .
      245     define input  parameter p-second       as integer   no-undo .
      246     define input  parameter p-milliseconds as integer   no-undo .
      247     define output parameter p-mjd          as decimal   no-undo .
      248     define variable v-year-correction as decimal   no-undo .
      249     define variable v-shift-year as decimal   no-undo .
      250     do
      251     on error undo, return error return-value
      252     :
      253       assign
      254         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      255         v-shift-year      = decimal(p-year) + v-year-correction
      256         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      257               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      258               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      259               + decimal(p-day) - 2432076.0
      260               + p-hour / 24.0
      261               + p-minute / 1440.0
      262               + p-second / 86400.0
      263               + p-milliseconds / 86400000.0
      264       .
      265     end.
      266   end procedure.
      267   procedure sys-time_sys-to-loc :
      268     define input  parameter p-sys-year         as integer   no-undo .
      269     define input  parameter p-sys-month        as integer   no-undo .
      270     define input  parameter p-sys-day          as integer   no-undo .
      271     define input  parameter p-sys-hour         as integer   no-undo .
      272     define input  parameter p-sys-minute       as integer   no-undo .
      273     define input  parameter p-sys-second       as integer   no-undo .
      274     define input  parameter p-sys-milliseconds as integer   no-undo .
      275     define output parameter p-loc-year         as integer   no-undo .
      276     define output parameter p-loc-month        as integer   no-undo .
      277     define output parameter p-loc-day          as integer   no-undo .
      278     define output parameter p-loc-hour         as integer   no-undo .
      279     define output parameter p-loc-minute       as integer   no-undo .
      280     define output parameter p-loc-second       as integer   no-undo .
      281     define output parameter p-loc-milliseconds as integer   no-undo .
      282     define variable v-system-time-structure as memptr    no-undo.
      283     define variable v-return-value          as integer   no-undo .
      284     define variable v-sys-day-of-week       as integer   no-undo .
      285     do
      286     on error undo, return error return-value
      287     :
      288       assign
      289         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      290       .
      291       assign
      292         set-size(v-system-time-structure) = 32
      293       .
      294       assign
      295         put-short(v-system-time-structure,  1) = p-sys-year
      296         put-short(v-system-time-structure,  3) = p-sys-month
      297         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      298         put-short(v-system-time-structure,  7) = p-sys-day
      299         put-short(v-system-time-structure,  9) = p-sys-hour
      300         put-short(v-system-time-structure, 11) = p-sys-minute
      301         put-short(v-system-time-structure, 13) = p-sys-second
      302         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      303       .
      304       run SystemTimeToTzSpecificLocalTime
      305         (input  0
      306         ,input  get-pointer-value(v-system-time-structure)
      307         ,input  get-pointer-value(v-system-time-structure) + 16
      308         ,output v-return-value
      309         ) .
      310       assign
      311         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      312         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      313         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      314         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      315         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      316         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      317         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      318       .
      319       assign
      320         set-size(v-system-time-structure) = 0
      321       .
      322       if v-return-value = 0
      323       then do:
      324         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      325       end.
      326     end.
      327   end procedure.
      328   procedure sys-time_mjd-to-sys :
      329     define input  parameter p-mjd          as decimal   no-undo .
      330     define output parameter p-year         as integer   no-undo .
      331     define output parameter p-month        as integer   no-undo .
      332     define output parameter p-day          as integer   no-undo .
      333     define output parameter p-hour         as integer   no-undo .
      334     define output parameter p-minute       as integer   no-undo .
      335     define output parameter p-second       as integer   no-undo .
      336     define output parameter p-milliseconds as integer   no-undo .
      337     define variable v-year-correction as decimal   no-undo .
      338     define variable v-shift-year      as decimal   no-undo .
      339     define variable v-conv-date     as date      no-undo .
      340     define variable v-int-part      as integer   no-undo .
      341     define variable v-fraction-part as decimal   no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       assign
      346         v-int-part      = integer(truncate(p-mjd, 0))
      347         v-fraction-part = p-mjd - v-int-part
      348         v-conv-date     = date(11, 17, 1858) + v-int-part
      349         p-year          = year(v-conv-date)
      350         p-month         = month(v-conv-date)
      351         p-day           = day(v-conv-date)
      352         v-fraction-part = v-fraction-part * 24.0
      353         p-hour          = integer(truncate(v-fraction-part, 0))
      354         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      355         p-minute        = integer(truncate(v-fraction-part, 0))
      356         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      357         p-second        = integer(truncate(v-fraction-part, 0))
      358         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      359         p-milliseconds  = integer(v-fraction-part)
      360       .
      361     end.
      362   end procedure.
      363   procedure sys-time_mjd-to-loc :
      364     define input  parameter p-mjd              as decimal   no-undo .
      365     define output parameter p-loc-year         as integer   no-undo .
      366     define output parameter p-loc-month        as integer   no-undo .
      367     define output parameter p-loc-day          as integer   no-undo .
      368     define output parameter p-loc-hour         as integer   no-undo .
      369     define output parameter p-loc-minute       as integer   no-undo .
      370     define output parameter p-loc-second       as integer   no-undo .
      371     define output parameter p-loc-milliseconds as integer   no-undo .
      372     define variable v-sys-year         as integer   no-undo .
      373     define variable v-sys-month        as integer   no-undo .
      374     define variable v-sys-day          as integer   no-undo .
      375     define variable v-sys-hour         as integer   no-undo .
      376     define variable v-sys-minute       as integer   no-undo .
      377     define variable v-sys-second       as integer   no-undo .
      378     define variable v-sys-milliseconds as integer   no-undo .
      379     do
      380     on error undo, return error return-value
      381     :
      382       run sys-time_mjd-to-sys
      383         (input  p-mjd
      384         ,output v-sys-year
      385         ,output v-sys-month
      386         ,output v-sys-day
      387         ,output v-sys-hour
      388         ,output v-sys-minute
      389         ,output v-sys-second
      390         ,output v-sys-milliseconds
      391         ) .
      392       run sys-time_sys-to-loc
      393         (input  v-sys-year
      394         ,input  v-sys-month
      395         ,input  v-sys-day
      396         ,input  v-sys-hour
      397         ,input  v-sys-minute
      398         ,input  v-sys-second
      399         ,input  v-sys-milliseconds
      400         ,output p-loc-year
      401         ,output p-loc-month
      402         ,output p-loc-day
      403         ,output p-loc-hour
      404         ,output p-loc-minute
      405         ,output p-loc-second
      406         ,output p-loc-milliseconds
      407         ) .
      408     end.
      409   end procedure.
      410   function sys-time_get-mjd-func returns decimal
      411   :
      412     define variable v-year         as integer   no-undo .
      413     define variable v-month        as integer   no-undo .
      414     define variable v-day          as integer   no-undo .
      415     define variable v-hour         as integer   no-undo .
      416     define variable v-minute       as integer   no-undo .
      417     define variable v-second       as integer   no-undo .
      418     define variable v-milliseconds as integer   no-undo .
      419     define variable v-mjd          as decimal   no-undo .
      420     run sys-time_get-sys in this-procedure
      421       (output v-year
      422       ,output v-month
      423       ,output v-day
      424       ,output v-hour
      425       ,output v-minute
      426       ,output v-second
      427       ,output v-milliseconds
      428       ) .
      429     run sys-time_sys-to-mjd in this-procedure
      430       (input  v-year
      431       ,input  v-month
      432       ,input  v-day
      433       ,input  v-hour
      434       ,input  v-minute
      435       ,input  v-second
      436       ,input  v-milliseconds
      437       ,output v-mjd
      438       ) .
      439     return v-mjd .
      440   end function .
      441   function sys-time_get-sys-str-func returns character
      442   :
      443     define variable v-utc-time as character no-undo .
      444     define variable v-year         as integer   no-undo .
      445     define variable v-month        as integer   no-undo .
      446     define variable v-day          as integer   no-undo .
      447     define variable v-hour         as integer   no-undo .
      448     define variable v-minute       as integer   no-undo .
      449     define variable v-second       as integer   no-undo .
      450     define variable v-milliseconds as integer   no-undo .
      451     run sys-time_get-sys in this-procedure
      452       (output v-year
      453       ,output v-month
      454       ,output v-day
      455       ,output v-hour
      456       ,output v-minute
      457       ,output v-second
      458       ,output v-milliseconds
      459       ) .
      460     assign
      461       v-utc-time  = 'UTC ':u
      462                   + string(v-year,         '9999':u)
      463                   + '/':u
      464                   + string(v-month,        '99':u)
      465                   + '/':u
      466                   + string(v-day,          '99':u)
      467                   + ' ':u
      468                   + string(v-hour,         '99':u)
      469                   + ':':u
      470                   + string(v-minute,       '99':u)
      471                   + ':':u
      472                   + string(v-second,       '99':u)
      473                   + ' ':u
      474                   + string(v-milliseconds, '999':u)
      475     .
      476     return v-utc-time.
      477   end function .
      478   function sys-time_mjd-to-loc-str-func returns character
      479     (v-sys-mjd as decimal)
      480   :
      481     define variable v-loc-str          as character no-undo .
      482     define variable v-loc-year         as integer   no-undo .
      483     define variable v-loc-month        as integer   no-undo .
      484     define variable v-loc-day          as integer   no-undo .
      485     define variable v-loc-hour         as integer   no-undo .
      486     define variable v-loc-minute       as integer   no-undo .
      487     define variable v-loc-second       as integer   no-undo .
      488     define variable v-loc-milliseconds as integer   no-undo .
      489     run sys-time_mjd-to-loc in this-procedure
      490       (input  v-sys-mjd
      491       ,output v-loc-year
      492       ,output v-loc-month
      493       ,output v-loc-day
      494       ,output v-loc-hour
      495       ,output v-loc-minute
      496       ,output v-loc-second
      497       ,output v-loc-milliseconds
      498       ) .
      499     assign
      500       v-loc-str = substitute('&1/&2/&3 &4:&5'
      501                             ,string(v-loc-day,    '99':U)
      502                             ,string(v-loc-month,  '99':U)
      503                             ,string(v-loc-year,   '9999':U)
      504                             ,string(v-loc-hour,   '99':U)
      505                             ,string(v-loc-minute, '99':U)
      506                             )
      507     .
      508     return v-loc-str .
      509   end function .
      510   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      511   :
      512     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      513   END PROCEDURE.
      514   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      515   :
      516     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      517     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      518   END PROCEDURE.
      519   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      520   :
      521     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      522     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      523   END PROCEDURE.
      524   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      525   :
      526     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      527     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      528     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      529     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      530   END PROCEDURE.
      531   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      532   :
      533     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      534     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      535     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      536   END PROCEDURE.
      537   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      538   :
      539     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      540     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      541     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      542   END PROCEDURE.
      543   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      544   :
      545     DEFINE RETURN PARAMETER RetVal          AS LONG.
      546   END PROCEDURE.
      547   do
      548   on error undo, return error return-value
      549   :
      550     assign
      551       p-sys-time-mjd = sys-time_get-mjd-func()
      552     .
      553     find first ub._userio no-lock
      554       where ub._userio._userio-id = p-userio-id
      555       .
      556     assign
      557       p-userio-ai-read   = ub._userio._userio-airead
      558       p-userio-ai-write  = ub._userio._userio-aiwrite
      559       p-userio-bi-read   = ub._userio._userio-biread
      560       p-userio-bi-write  = ub._userio._userio-biwrite
      561       p-userio-db-access = ub._userio._userio-dbaccess
      562       p-userio-db-read   = ub._userio._userio-dbread
      563       p-userio-db-write  = ub._userio._userio-dbwrite
      564     .
      565   end.
