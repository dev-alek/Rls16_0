        1   block-level on error undo, throw.
        2   define input param  p-code  as character no-undo .
        3   define input param  h-code  as integer   no-undo .
        4   define input param  o-type  as character no-undo .
        5   define input param  o-code  as integer   no-undo .
        6   define input param  g-name  as character no-undo .
        7   define input param  u-name  as character no-undo .
        8   define input param  e-name  as character no-undo .
        9   define input param  msg-on  as logical   no-undo .
       10   define output param p-value as character no-undo .
       11   define output param p-type  as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: 6b203531fb4a, 3411, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       14   define variable vss-date        as character no-undo init "$Date: 2023/08/17 10:18:56 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: conf-rd.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: gbl/conf-rd.p $":U .
       17   define variable vss-description as character no-undo init "Чтение параметров конфигурации для текущей БД".
       18   define new global shared variable g#language as character no-undo .
       19   if g#language <> '' and g#language <> 'rus':U then do:
       20     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       21   end.
       22   define new global shared variable g#library  as handle no-undo .
       23   define new global shared variable g#library2 as handle no-undo .
       24   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       25     (input  p-code
       26     ,input  h-code
       27     ,input  o-type
       28     ,input  o-code
       29     ,input  g-name
       30     ,input  u-name
       31     ,input  e-name
       32     ,input  msg-on
       33     ,output p-value
       34     ,output p-type
       35     ) no-error .
       36   if error-status :error then do:
       37     if error-status :get-message(1) <> "" then do:
       38       message
       39         vss-workfile vss-revision vss-description skip
       40         "Ошибка при вызове процедуры conf-rd" skip
       41         error-status :get-message(1) skip
       42         return-value skip
       43         view-as alert-box error .
       44     end.
       45     undo, return error return-value.
       46   end.
