        1   block-level on error undo, throw.
        2   define temp-table temp-prwninfo no-undo
        3     field proc-id           as integer   format ">>>>>9"     label "Процесс"
        4     field progress-version  as character format "X(9)"       label "Версия"
        5     field progress-self     as logical   format "+/-"        label "Сам"
        6     field module-file-name  as character format "x(40)"      label "Исполняемый файл"
        7     field progress-propath  as character format "x(40)"      label "Путь поиска файлов (PROPATH)"
        8     field progress-inifile  as character format "x(40)"      label "Ini файл"
        9     field progress-curdir   as character format "x(40)"      label "Рабочая директория"
       10     field trans-active      as logical   format "+/-"        label "Транз."
       11     field cmd-line          as character format "x(160)"     label "Командная строка"
       12     field message-handle    as integer   format ">>>>>>>>9"  label "Указатель окна"
       13     field message-text      as character format "x(40)"      label "Сообщение"
       14     field proc-name         as character format "x(40)"      label "Имя программы"
       15     field proc-line         as integer   format "->>>>>>>>9" label "Строка"
       16     field r-code-name       as character format "x(40)"      label "Модуль"
       17     field db-connect-string as character format "x(40)"      label "Строка подключения"
       18     field widget-percent    as decimal   format ">>9.99%"    label "WdgUsed"
       19     field widget-num        as integer   format ">>>>>>>>9"  label "WidgNum"
       20     field max-widget-num    as integer   format ">>>>>>>>9"  label "Max widget num"
       21     index xpk is primary unique proc-id
       22     index is-self progress-self
       23   .
       24   define temp-table temp-prwnprocinfo no-undo
       25     field proc-id       as integer   format ">>>9"        label "Процесс"
       26     field proc-level    as integer   format ">>>9"        label "Уровень"
       27     field h-proc        as integer   format ">>>>>>>>>>>" label "Ук.программы"
       28     field proc-name     as character format "x(40)"       label "Имя программы"
       29     field proc-line     as integer   format "->>>>>>>>9"  label "Строка"
       30     field r-code-name   as character format "x(40)"       label "Модуль"
       31     field sub-procedure as logical
       32     field subproc-num   as integer   format ">>>>>9"
       33     index xpk is primary unique proc-id proc-level
       34   .
       35   define temp-table temp-procinfo no-undo
       36     field proc-level    as integer   format ">>>9"         label "Уровень"
       37     field h-proc        as integer   format ">>>>>>>>>>>"  label "Ук.программы"
       38     field proc-name     as character format "x(40)"        label "Имя программы"
       39     field proc-line     as integer   format "->>>>>>>>9"   label "Строка"
       40     field r-code-name   as character format "x(40)"        label "Модуль"
       41     field sub-procedure as logical
       42     field subproc-num   as integer   format ">>>>>9"
       43     index xpk is primary unique proc-level
       44   .
       45   define temp-table temp-window no-undo
       46      field window-handle       as integer   label "Handle"
       47      field window-visible      as logical   label "Visible"
       48      field window-text         as character label "Text"     format "x(20)"
       49      field window-class-atom   as integer   label "Class Atom"
       50      field window-class-name   as character label "Class Name"
       51      field window-message      as logical
       52      field window-message-text as character label "Message"  format "x(60)"
       53      field window-process-id   as integer   label "Process"
       54      field window-thread-id    as integer   label "Thread"
       55   .
       56   define temp-table temp-progress-version-info no-undo
       57      field progress-version as character
       58      field procedure-handle as character
       59      field pgc              as character
       60      field pdb-task         as character
       61      field savename         as character
       62      field the-display      as character
       63      field wic-max-id       as character
       64      index xpk is primary unique progress-version
       65   .
       66   define temp-table temp-dbg-file-header no-undo
       67     field proc-id     as integer   format ">>>9"  label "Процесс"
       68     field r-code-name as character format "x(40)" label "Модуль"
       69     field file-num    as integer   format ">>>9"  label "Номер файла"
       70     index xpk is primary unique proc-id r-code-name
       71     index x-file-num file-num
       72   .
       73   define temp-table temp-dbg-file no-undo
       74     field file-num  as integer   format ">>>9"    label "Номер файла"
       75     field line-num  as integer   format ">>>9"    label "Номер строки"
       76     field line-text as character format "x(200)" label "Строка"
       77     index xpk is primary unique file-num line-num
       78   .
       79   define temp-table temp-show-file no-undo
       80     field line-num  as integer   format ">>>9"    label "Номер строки"
       81     field line-text as character format "x(200)" label "Строка"
       82     index xpk is primary unique line-num
       83   .
       84   define output parameter table for temp-prwninfo .
       85   define output parameter table for temp-prwnprocinfo .
       86   define stream sinp .
       87   procedure GetProcessName :
       88     define input  parameter pid            as integer   no-undo .
       89     define output parameter p-process-name as character no-undo .
       90     define output parameter p-file-name    as character no-undo .
       91     define variable hProcess      as integer   no-undo .
       92     define variable hModule       as integer   no-undo .
       93     define variable cbNeeded      as integer   no-undo .
       94     define variable lphMod        as memptr    no-undo .
       95     define variable vProcessName  as char      no-undo .
       96     define variable RetVal        as integer   no-undo .
       97     do
       98     on error undo, return error return-value
       99     :
      100       RUN OpenProcess
      101         (input  1024 + 16
      102         ,input  0
      103         ,input  PID
      104         ,output hProcess
      105         ).
      106       assign
      107         vProcessName = "unknown" + FILL(" ", 260)
      108       .
      109       IF hProcess <> 0
      110       THEN DO:
      111         assign
      112           SET-SIZE (lphMod) = 4
      113         .
      114         RUN EnumProcessModules
      115           (input  hProcess
      116           ,input  GET-POINTER-VALUE(lphMod)
      117           ,input  GET-SIZE(lphMod)
      118           ,output cbNeeded
      119           ,output RetVal
      120           ).
      121         IF RetVal NE 0
      122         THEN DO:
      123           assign
      124             hModule = GET-LONG(lphMod,1)
      125           .
      126         END.
      127         else do:
      128           assign
      129             hModule = ?
      130           .
      131         end.
      132         assign
      133           SET-SIZE (lphMod) = 0
      134         .
      135         if hModule <> ?
      136         then do:
      137           run GetModuleBaseNameA
      138             (input  hProcess
      139             ,input  hModule
      140             ,output vProcessName
      141             ,input  LENGTH(vProcessName)
      142             ,output RetVal
      143             ).
      144           assign
      145             vProcessName = SUBSTRING(vProcessName,1,RetVal)
      146           .
      147             define variable cfilename as character no-undo .
      148             assign
      149               cfilename = "unknown" + FILL(" ", 260)
      150             .
      151           run GetModuleFileNameExA
      152             (input  hProcess
      153             ,input  hModule
      154             ,output cFileName
      155             ,input  LENGTH(cFileName)
      156             ,output RetVal
      157             ).
      158           assign
      159             cFileName = substring(cFileName,1,RetVal)
      160           .
      161         end.
      162         run CloseHandle
      163           (input  hProcess
      164           ,output RetVal
      165           ).
      166       end.
      167       assign
      168         p-process-name = TRIM(vProcessName)
      169         p-file-name    = TRIM(cFileName)
      170       .
      171     end.
      172   end procedure.
      173   define variable vpid          as integer   no-undo.
      174   define variable vpidlist      as memptr    no-undo.
      175   define variable cbneeded      as integer   no-undo.
      176   define variable vretval       as integer   no-undo.
      177   define variable v-progress-version as character no-undo .
      178   define variable v-procedure-handle as character no-undo .
      179   define variable v-pgc              as character no-undo .
      180   define variable v-pdb-task         as character no-undo .
      181   define variable v-savename         as character no-undo .
      182   define variable v-the-display      as character no-undo .
      183   define variable v-wic-max-id       as character no-undo .
      184   input stream sinp from value(search("cmp/procinrm.txt")) .
      185   repeat :
      186     assign
      187       v-progress-version = ""
      188       v-procedure-handle = ""
      189       v-pgc              = ""
      190       v-pdb-task         = ""
      191       v-savename         = ""
      192       v-the-display      = ""
      193       v-wic-max-id       = ""
      194     .
      195     import stream sinp
      196       v-progress-version
      197       v-procedure-handle
      198       v-pgc
      199       v-pdb-task
      200       v-savename
      201       v-the-display
      202       v-wic-max-id
      203       .
      204     if v-progress-version <> ""
      205     then do:
      206       find first temp-progress-version-info
      207         where temp-progress-version-info.progress-version = v-progress-version
      208         no-error .
      209       if not available temp-progress-version-info
      210       then do:
      211         create temp-progress-version-info .
      212         assign
      213           temp-progress-version-info.progress-version = v-progress-version
      214         .
      215       end.
      216       assign
      217         temp-progress-version-info.procedure-handle = v-procedure-handle
      218         temp-progress-version-info.pgc              = v-pgc
      219         temp-progress-version-info.pdb-task         = v-pdb-task
      220         temp-progress-version-info.savename         = v-savename
      221         temp-progress-version-info.the-display      = v-the-display
      222         temp-progress-version-info.wic-max-id       = v-wic-max-id
      223       .
      224     end.
      225   end.
      226   input stream sinp close .
      227   assign
      228     set-size(vpidlist) = 1000
      229   .
      230   define variable v-current-id as integer   no-undo .
      231   run GetCurrentProcessID (output v-current-id) .
      232   run enumprocesses
      233     (input get-pointer-value(vpidlist)
      234     ,input get-size(vpidlist)
      235     ,output cbneeded
      236     ,output vretval
      237     ).
      238   define variable v-ind as integer   no-undo .
      239   do v-ind = 1 to cbneeded / 4
      240   :
      241     assign
      242       vPID = GET-LONG(vPidList, 4 * (v-ind - 1) + 1)
      243     .
      244     define variable v-process-name as character no-undo .
      245     define variable v-file-name    as character no-undo .
      246     run getprocessname in this-procedure
      247       (input  vpid
      248       ,output v-process-name
      249       ,output v-file-name
      250       ) .
      251     if v-process-name = "prowin32.exe"
      252     then do:
      253       create temp-prwninfo .
      254       assign
      255         temp-prwninfo.proc-id          = vpid
      256         temp-prwninfo.module-file-name = v-file-name
      257       .
      258       if temp-prwninfo.proc-id = v-current-id
      259       then do:
      260         assign
      261           temp-prwninfo.progress-self = true
      262         .
      263       end.
      264       else do:
      265         assign
      266           temp-prwninfo.progress-self = false
      267         .
      268       end.
      269       define variable v-path as character no-undo .
      270       assign
      271         v-path = substring(v-file-name, 1, r-index(v-file-name, '\') - 1)
      272         v-path = substring(v-path, 1, r-index(v-path, '\') - 1)
      273       .
      274       define stream sinp .
      275       input stream sinp from value( v-path + '/':u + 'version':u) .
      276       define variable v-imp1 as character no-undo .
      277       define variable v-imp2 as character no-undo .
      278       define variable v-imp3 as character no-undo .
      279       import stream sinp v-imp1 v-imp2 v-imp3 .
      280       input stream sinp close .
      281       assign
      282         temp-prwninfo.progress-version = v-imp3
      283       .
      284       find first temp-progress-version-info
      285         where temp-progress-version-info.progress-version = temp-prwninfo.progress-version
      286         no-error .
      287       if available temp-progress-version-info
      288       then do:
      289         define variable v-progress-propath as character no-undo .
      290         define variable v-trans-active     as logical   no-undo .
      291         define variable v-ini-file         as character no-undo .
      292         define variable v-widget-num       as integer   no-undo .
      293         define variable v-max-widget-num   as integer   no-undo .
      294         run gbl/procinrm.p
      295           (input  temp-progress-version-info.progress-version
      296           ,input  temp-progress-version-info.procedure-handle
      297           ,input  temp-progress-version-info.pgc
      298           ,input  temp-progress-version-info.pdb-task
      299           ,input  temp-progress-version-info.savename
      300           ,input  temp-progress-version-info.the-display
      301           ,input  temp-progress-version-info.wic-max-id
      302           ,input  temp-prwninfo.proc-id
      303           ,output v-progress-propath
      304           ,output v-trans-active
      305           ,output v-ini-file
      306           ,output v-widget-num
      307           ,output v-max-widget-num
      308           ,output table temp-procinfo
      309           ) .
      310         assign
      311           temp-prwninfo.progress-propath = v-progress-propath
      312           temp-prwninfo.trans-active     = v-trans-active
      313           temp-prwninfo.progress-inifile = v-ini-file
      314           temp-prwninfo.widget-num       = v-widget-num
      315           temp-prwninfo.max-widget-num   = v-max-widget-num
      316         .
      317         assign
      318           temp-prwninfo.widget-percent = min((abs(temp-prwninfo.widget-num) * 100.0)
      319                                              / temp-prwninfo.max-widget-num
      320                                             ,100
      321                                             )
      322         .
      323         find first temp-procinfo
      324           where temp-procinfo.proc-level = 1
      325           no-error .
      326         if available temp-procinfo
      327         then do:
      328           assign
      329             temp-prwninfo.proc-name   = temp-procinfo.proc-name
      330             temp-prwninfo.proc-line   = temp-procinfo.proc-line
      331             temp-prwninfo.r-code-name = temp-procinfo.r-code-name
      332           .
      333         end.
      334         define variable v-new-proc-level as integer   no-undo .
      335         assign
      336           v-new-proc-level = 0
      337         .
      338         for each temp-procinfo
      339         on error undo, return error return-value
      340         by temp-procinfo.proc-level descending
      341         :
      342           assign
      343             v-new-proc-level = v-new-proc-level + 1
      344           .
      345           create temp-prwnprocinfo .
      346           buffer-copy temp-procinfo to temp-prwnprocinfo
      347           assign
      348             temp-prwnprocinfo.proc-level = v-new-proc-level
      349             temp-prwnprocinfo.proc-id    = temp-prwninfo.proc-id
      350           .
      351         end.
      352       end.
      353     end.
      354   end.
      355   assign
      356     SET-SIZE(vPidList) = 0
      357   .
      358   run gbl/windinfo.p
      359     (output table temp-window
      360     ) .
      361   for each temp-window
      362     where temp-window.window-visible    = true
      363       and temp-window.window-class-name = "#32770"
      364   :
      365     find first temp-prwninfo
      366       where temp-prwninfo.proc-id = temp-window.window-process-id
      367       no-error .
      368     if available temp-prwninfo
      369     then do:
      370       assign
      371         temp-prwninfo.message-handle = temp-window.window-handle
      372         temp-prwninfo.message-text   = temp-window.window-message-text
      373       .
      374     end.
      375   end.
      376   PROCEDURE GetProductVersion :
      377       DEFINE INPUT  PARAMETER pFilename       AS CHAR NO-UNDO.
      378       DEFINE OUTPUT PARAMETER pProductVersion AS CHAR NO-UNDO.
      379       DEFINE OUTPUT PARAMETER pFileVersion    AS CHAR NO-UNDO.
      380       DEF VAR dummy           AS INTEGER NO-UNDO.
      381       DEF VAR ReturnValue     AS INTEGER NO-UNDO.
      382       DEF VAR lpVersionInfo   AS MEMPTR  NO-UNDO.
      383       DEF VAR lpFixedFileInfo AS MEMPTR  NO-UNDO.
      384       DEF VAR versize         AS INTEGER NO-UNDO.
      385       DEF VAR ptrInfo         AS INTEGER NO-UNDO.
      386       DEF VAR cInfo           AS INTEGER NO-UNDO.
      387       RUN GetFileVersionInfoSizeA (pFileName,
      388                                    OUTPUT dummy,
      389                                    OUTPUT versize).
      390       IF versize = 0 THEN RETURN.
      391       assign
      392         SET-SIZE(lpVersionInfo) = 0
      393       .
      394       assign
      395         SET-SIZE(lpVersionInfo) = versize
      396       .
      397       RUN GetFileVersionInfoA ( pFileName,
      398                                 0,
      399                                 INPUT versize,
      400                                 INPUT GET-POINTER-VALUE(lpVersionInfo),
      401                                 OUTPUT returnvalue).
      402       IF returnvalue = 0 THEN DO:
      403         SET-SIZE(lpVersionInfo) = 0.
      404         RETURN.
      405       END.
      406       RUN VerQueryValueA (GET-POINTER-VALUE(lpVersionInfo),
      407                           "\":U,
      408                           OUTPUT ptrInfo,
      409                           OUTPUT cInfo,
      410                           OUTPUT returnvalue).
      411       IF NOT (returnvalue=0 OR cInfo=0) THEN DO:
      412          assign
      413            SET-POINTER-VALUE(lpFixedFileInfo) = ptrInfo
      414          .
      415          pProductVersion =  STRING(GET-SHORT (lpFixedFileInfo,19)) + '.' +
      416                             STRING(GET-SHORT (lpFixedFileInfo,17)) + '.' +
      417                             STRING(GET-SHORT (lpFixedFileInfo,23)) + '.' +
      418                             STRING(GET-SHORT (lpFixedFileInfo,21)).
      419          pFileVersion    =  STRING(GET-SHORT (lpFixedFileInfo,11)) + '.' +
      420                             STRING(GET-SHORT (lpFixedFileInfo, 9)) + '.' +
      421                             STRING(GET-SHORT (lpFixedFileInfo,15)) + '.' +
      422                             STRING(GET-SHORT (lpFixedFileInfo,13)).
      423       END.
      424       SET-SIZE (lpVersionInfo)   = 0.
      425   END PROCEDURE.
      426   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll" :
      427     DEFINE RETURN PARAMETER RetVal          AS LONG.
      428   END PROCEDURE.
      429   PROCEDURE CloseHandle EXTERNAL "kernel32.dll" :
      430     DEFINE INPUT  PARAMETER hObject AS LONG.
      431     DEFINE RETURN PARAMETER RetVal  AS LONG.
      432   END PROCEDURE.
      433   PROCEDURE OpenProcess EXTERNAL "kernel32.dll" :
      434     DEFINE INPUT  PARAMETER dwDesiredAccess AS LONG.
      435     DEFINE INPUT  PARAMETER bInheritHandle  AS LONG.
      436     DEFINE INPUT  PARAMETER dwProcessId     AS LONG.
      437     DEFINE RETURN PARAMETER hProcess        AS LONG.
      438   END PROCEDURE.
      439   PROCEDURE ReadProcessMemory EXTERNAL "kernel32.dll" :
      440     DEFINE INPUT  PARAMETER hProcess            AS LONG.
      441     DEFINE INPUT  PARAMETER lpBaseAddress       AS LONG.
      442     DEFINE INPUT  PARAMETER lpBuffer            AS LONG.
      443     DEFINE INPUT  PARAMETER nSize               AS LONG.
      444     DEFINE INPUT  PARAMETER lpNumberOfBytesRead AS LONG.
      445     DEFINE RETURN PARAMETER RetVal  AS LONG.
      446   END PROCEDURE.
      447   PROCEDURE GetModuleFileNameA EXTERNAL "kernel32.dll" :
      448     DEFINE INPUT  PARAMETER hModule    AS LONG.
      449     DEFINE OUTPUT PARAMETER lpFilename AS CHAR.
      450     DEFINE INPUT  PARAMETER nSize      AS LONG.
      451     DEFINE RETURN PARAMETER ReturnSize AS LONG.
      452   END PROCEDURE.
      453   PROCEDURE GetModuleFileNameExA EXTERNAL "psapi.dll" :
      454     DEFINE INPUT  PARAMETER hProcess   AS LONG.
      455     DEFINE INPUT  PARAMETER hModule    AS LONG.
      456     DEFINE OUTPUT PARAMETER lpFilename AS CHAR.
      457     DEFINE INPUT  PARAMETER nSize      AS LONG.
      458     DEFINE RETURN PARAMETER ReturnSize AS LONG.
      459   END PROCEDURE.
      460   PROCEDURE EnumProcesses EXTERNAL "psapi.dll" :
      461     DEFINE INPUT  PARAMETER vPidListProcess AS LONG.
      462     DEFINE INPUT  PARAMETER cb              AS LONG.
      463     DEFINE OUTPUT PARAMETER cbNeeded        AS LONG.
      464     DEFINE RETURN PARAMETER RetVal          AS LONG.
      465   END PROCEDURE.
      466   PROCEDURE EnumProcessModules EXTERNAL "psapi.dll" :
      467     DEFINE INPUT  PARAMETER hProcess    AS LONG.
      468     DEFINE INPUT  PARAMETER lphModule   AS LONG.
      469     DEFINE INPUT  PARAMETER cb          AS LONG.
      470     DEFINE OUTPUT PARAMETER cbNeeded    AS LONG.
      471     DEFINE RETURN PARAMETER RetVal AS LONG.
      472   END PROCEDURE.
      473   PROCEDURE GetModuleBaseNameA EXTERNAL "psapi.dll" :
      474     DEFINE INPUT  PARAMETER hProcess      AS LONG.
      475     DEFINE INPUT  PARAMETER hModule       AS LONG.
      476     DEFINE OUTPUT PARAMETER lpBaseName    AS CHAR.
      477     DEFINE INPUT  PARAMETER nSize         AS LONG.
      478     DEFINE RETURN PARAMETER nReturnedSize AS LONG.
      479   END PROCEDURE.
      480   PROCEDURE GetFileVersionInfoSizeA EXTERNAL "version.dll" :
      481     DEFINE INPUT  PARAMETER lptstrFilename  AS CHARACTER.
      482     DEFINE OUTPUT PARAMETER lpdwHandle      AS LONG.
      483     DEFINE RETURN PARAMETER VersionInfoSize AS LONG.
      484   END PROCEDURE.
      485   PROCEDURE GetFileVersionInfoA EXTERNAL "version.dll" :
      486     DEFINE INPUT  PARAMETER lptstrFilename  AS CHARACTER.
      487     DEFINE INPUT  PARAMETER dwHandle        AS LONG.
      488     DEFINE INPUT  PARAMETER dwLen           AS LONG.
      489     DEFINE INPUT  PARAMETER lpData          AS LONG.
      490     DEFINE RETURN PARAMETER ReturnValue     AS LONG.
      491   END PROCEDURE.
      492   PROCEDURE VerQueryValueA EXTERNAL "version.dll" :
      493     DEFINE INPUT  PARAMETER lpBlock     AS LONG.
      494     DEFINE INPUT  PARAMETER lpSubBlock  AS CHARACTER.
      495     DEFINE OUTPUT PARAMETER lplpBuffer  AS LONG.
      496     DEFINE OUTPUT PARAMETER puLen       AS LONG.
      497     DEFINE RETURN PARAMETER ReturnValue AS LONG.
      498   END PROCEDURE.
