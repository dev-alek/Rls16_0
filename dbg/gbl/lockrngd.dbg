        1   block-level on error undo, throw.
        2   define input  parameter p-lock-gds-type   as character no-undo .
        3   define input  parameter p-sub-type        as character no-undo .
        4   define parameter buffer lock_batchprocess for ub.batchprocess .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: lockrngd.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: gbl/lockrngd.p $":U .
       10   define variable vss-description as character no-undo initial "Блокировка переименования товара".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2':u,p-lock-gds-type,p-sub-type)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   do
       84   on error undo, return error return-value
       85   :
       86     if  p-lock-gds-type <> 'grar':U
       87     and p-lock-gds-type <> 'grgc':U
       88     then do:
       89       message
       90         vss-workfile vss-revision vss-description skip
       91         "Ошибка задания входных параметров" skip
       92         "Неизвестное значение типа блокировки" skip
       93         "Тип блокировки" p-lock-gds-type skip
       94         "Подтип блокировки" p-sub-type skip
       95         view-as alert-box error .
       96       undo, return error return-value .
       97     end.
       98     if  p-sub-type <> 'disable':U
       99     and p-sub-type <> 'enable':U
      100     then do:
      101       message
      102         vss-workfile vss-revision vss-description skip
      103         "Ошибка задания входных параметров" skip
      104         "Неизвестное значение подтипа блокировки" skip
      105         "Тип блокировки" p-lock-gds-type skip
      106         "Подтип блокировки" p-sub-type skip
      107         view-as alert-box error .
      108       undo, return error return-value .
      109     end.
      110     run gbl/lock-swi.p
      111       (input p-lock-gds-type
      112       ,input p-sub-type
      113       ,input 3600
      114       ,input "Переименование артикула"
      115       ,input 0
      116       ,input 0
      117       ,input 0
      118       ,input ""
      119       ,input ""
      120       ,input ""
      121       ,buffer lock_batchprocess
      122       ) no-error .
      123     if error-status :error
      124     then do:
      125       if error-status :get-message(1) <> ""
      126       then do:
      127         message
      128           vss-workfile vss-revision vss-description skip
      129           "Ошибка при вызове процедуры lock-swi.p" skip
      130           error-status :get-message(1) skip
      131           return-value skip
      132           view-as alert-box error .
      133       end.
      134       undo, return error return-value .
      135     end.
      136   end.
