        1   block-level on error undo, throw.
        2   define input parameter par-run-name as character no-undo .
        3   define input parameter RS-list-method  as character no-undo .
        4   define input parameter RS-status as character no-undo .
        5   define input parameter line-mode as character no-undo .
        6   define input parameter  p-filter-var as character no-undo .
        7   define output parameter lns-cnt as integer no-undo .
        8   define output parameter line-rec as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: dc-fill.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/dc-fill.p $":U .
       14   define variable vss-description as character no-undo init "Фильтр в списке дисконтных карт".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define shared temp-table dc-list no-undo like ub.dis-card
       86     field to-del as logical
       87     field order-num as integer
       88     field fdec as decimal
       89     field fint as integer
       90     field flog as logical
       91     field fchar as character
       92     index pi  is primary unique d-card
       93     index cn      card-num
       94     index cli cli-type cli-code
       95     index host-dscnt  emitent-host-code status_ d-pcnt
       96     index host-type  emitent-host-code type d-pcnt
       97     index oi order-num
       98     .
       99   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  shared  temp-table dc-list-hist no-undo
      101   field list-table as character
      102   field id as integer
      103   field line as integer
      104   field hist-mode as character
      105   field des as character
      106   field num-recs as integer
      107   field option_ as character
      108   field item_ as character
      109   field status_ as character
      110   field num-add as integer
      111   field num-ignored as integer
      112   field done as logical
      113   field err_ as logical
      114   field err-mes as character
      115   index pi is primary
      116   id
      117   line
      118   index isdone
      119   done
      120   .
      121   define variable dsp-rs as char format "x(50)" no-undo.
      122   define variable glog as logical no-undo .
      123   define variable v-prepare-string as character no-undo .
      124   define query dc-fill for ub.dis-card.
      125   define frame abc
      126   dsp-rs no-label
      127   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      128   TITLE par-run-name.
      129   view frame abc.
      130   display dsp-rs with frame abc.
      131   v-prepare-string = "for each ub.dis-card where true " + p-filter-var .
      132   glog = query dc-fill:handle:query-prepare(v-prepare-string) no-error.
      133   if not glog
      134   or error-status:error then do:
      135     message
      136     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      137                , chr(10)
      138                , error-status:get-message(1)
      139                , v-prepare-string)
      140     view-as alert-box error .
      141     undo, return error .
      142   end.
      143   glog = query dc-fill:handle:query-open() no-error.
      144   if not glog
      145   or error-status:error then do:
      146     message
      147     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      148                , chr(10)
      149                , error-status:get-message(1)
      150                , v-prepare-string)
      151     view-as alert-box error .
      152     undo, return error .
      153   end.
      154   REPEAT WITH FRAME abc:
      155     query dc-fill:handle:GET-NEXT().
      156     IF query dc-fill:handle:QUERY-OFF-END THEN LEAVE.
      157     process events.
      158     run ex-dc in this-procedure (input rs-list-method, input rs-status, input line-mode).
      159   end.
      160   glog = query dc-fill:handle:query-close() no-error.
      161   hide frame abc.
      162   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   PROCEDURE ex-dc :
      164   define input parameter rs-list-method as character no-undo .
      165   define input parameter rs-status as character no-undo .
      166   define input parameter line-mode as character no-undo .
      167   if rs-list-method = "single":U or
      168     (ub.dis-card.status_ = 'тек':U and (rs-status = 'тек':U or rs-status = 'все':U)) or
      169     (ub.dis-card.status_ = 'удал':U and (rs-status = 'удал':U or rs-status = 'все':U)) or
      170     (ub.dis-card.status_ = 'блок':U and (rs-status = 'блок':U or rs-status = 'все':U))
      171     then do:
      172     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
      173       find first dc-list where
      174                  dc-list.d-card = ub.dis-card.d-card no-error.
      175       if available dc-list then do:
      176         if line-mode = 'удаление':U then do:
      177           lns-cnt = lns-cnt + 1.
      178           delete dc-list.
      179         end.
      180         else do:
      181           if dc-list.to-del = ? then.
      182           else do:
      183             lns-cnt = lns-cnt + 1.
      184             dc-list.to-del = ?.
      185           end.
      186         end.
      187       end.
      188     end.
      189     else
      190       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
      191   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   find dc-list
      193     where dc-list.d-card = dis-card.d-card
      194     no-error .
      195   if available dc-list then do:
      196     assign
      197       dc-list.to-del = no
      198     .
      199   end.
      200   else do:
      201     create dc-list .
      202     buffer-copy dis-card to dc-list
      203     assign
      204       dc-list.to-del = no
      205     .
      206     assign
      207       lns-cnt = lns-cnt + 1
      208       line-rec = recid (dc-list)
      209     .
      210   end.
      211       end.
      212     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame abc.
      213   end.
      214   end.
