        1   define  input parameter parParentProc as widget-handle no-undo.
        2   define  input parameter spr           as character     no-undo.
        3   define  input parameter znak          as character     no-undo.
        4   define  input parameter lab_user      as character     no-undo.
        5   define  input parameter fld           as character     no-undo.
        6   define  input parameter lab           as character     no-undo.
        7   define  input parameter type          as character     no-undo.
        8   define output parameter str           as character     no-undo.
        9   define output parameter str_rus       as character     no-undo.
       10   define variable vss-revision    as character no-undo initial "$Revision$":U .
       11   define variable vss-author      as character no-undo initial "$Author$":U .
       12   define variable vss-date        as character no-undo initial "$Date$":U .
       13   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       14   define variable vss-archive     as character no-undo initial "$Archive$":U .
       15   define variable vss-description as character no-undo initial "Редактирование выражения справочника для фильтра".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34       assign
       35         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u,spr,znak,lab_user,fld,lab,type)
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable flt-rec as recid no-undo.
      135   define variable g#report-num as integer no-undo .
      136   run get-report-num  in parparentproc ( output g#report-num ).
      137   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      138   define variable v_type    as character no-undo.
      139   DEFINE BUTTON  Btn_Reference
      140        IMAGE-UP          FILE "btn-down-arrow"
      141        IMAGE-DOWN        FILE "btn-down-arrow"
      142        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      143        LABEL "":L
      144        SIZE 3 BY 1.
      145   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      146        LABEL "&Отмена"
      147        SIZE 10 BY 1.17
      148        BGCOLOR 8 .
      149   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      150        LABEL "&Сохранить"
      151        SIZE 10 BY 1.17
      152        BGCOLOR 8 .
      153   DEFINE BUTTON b-help DEFAULT
      154        LABEL "Помо&щь"
      155        SIZE 10 BY 1.17
      156        BGCOLOR 8 .
      157   define variable grp           as widget-handle no-undo .
      158   define variable flw           as widget-handle no-undo .
      159   define variable flw1          as widget-handle no-undo .
      160   define variable fill_in       as widget-handle no-undo .
      161   define variable txt           as widget-handle no-undo .
      162   define variable btn           as widget-handle no-undo .
      163   define variable frm           as character no-undo .
      164   define variable type_         as character no-undo .
      165   define variable lab_          as character no-undo .
      166   define variable fld_          as character no-undo .
      167   define variable join-tbl      as character no-undo .
      168   define variable join_rus      as character no-undo .
      169   define variable i             as integer   no-undo .
      170   define variable s             as character no-undo .
      171   define variable s_description as character no-undo .
      172   define variable a             as character no-undo .
      173   define variable next-fill-in  as logical   no-undo initial no .
      174   define variable name          as character no-undo .
      175   DEFINE FRAME DIALOG-1
      176        SPACE(74.02) SKIP(3.85)
      177       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      178            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      179            TITLE "":L.
      180   ASSIGN
      181          FRAME DIALOG-1 :SCROLLABLE       = NO.
      182   IF VALID-HANDLE( ACTIVE-WINDOW ) AND FRAME DIALOG-1:PARENT = ? THEN FRAME DIALOG-1 :PARENT = ACTIVE-WINDOW.
      183   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      184   DEFINE VARIABLE max-type-length  AS INTEGER   NO-UNDO.
      185   DEFINE VARIABLE cur-type-length  AS INTEGER   NO-UNDO.
      186   DEFINE VARIABLE type-length-1st  AS INTEGER   NO-UNDO.
      187   DEFINE VARIABLE max-label-length AS INTEGER   NO-UNDO.
      188   DEFINE VARIABLE cur-label-length AS INTEGER   NO-UNDO.
      189   DEFINE VARIABLE type_list        AS CHARACTER NO-UNDO INITIAL "CHARACTER,INTEGER,DECIMAL,DATE,LOGICAL,RECID,INT64":U.
      190   DEFINE VARIABLE format_list      AS CHARACTER NO-UNDO INITIAL "40,14,29,10,3,12,28":U.
      191   DEFINE VARIABLE format_character AS CHARACTER NO-UNDO INITIAL "x(40)":U.
      192   DEFINE VARIABLE format_integer   AS CHARACTER NO-UNDO INITIAL "->>>>>>>>>9":U.
      193   DEFINE VARIABLE format_decimal   AS CHARACTER NO-UNDO INITIAL "->>>>>>>>>>>>>>>>>9.9999":U.
      194   DEFINE VARIABLE format_date      AS CHARACTER NO-UNDO INITIAL "99/99/9999":U.
      195   DEFINE VARIABLE format_logical   AS CHARACTER NO-UNDO INITIAL "yes/no":U.
      196   DEFINE VARIABLE format_recid     AS CHARACTER NO-UNDO INITIAL ">>>>>>>>>>>9":U.
      197   DEFINE VARIABLE format_int64     AS CHARACTER NO-UNDO INITIAL "->>>>>>>>>>>>>>>>>>>9":U.
      198   MAIN-BLOCK:
      199   DO ON ERROR   UNDO MAIN-BLOCK, RETURN ERROR
      200      ON END-KEY UNDO MAIN-BLOCK, RETURN ERROR :
      201      frame DIALOG-1 :height-chars = num-entries( type, '*' ) * 1.5 + 5.
      202      frame DIALOG-1 :width-chars  = 78.
      203      form
      204          Btn_OK     at row 1 column  1
      205          Btn_Cancel at row 1 column 12
      206        b-help  at row 1 column 24
      207      with frame DIALOG-1.
      208      do i = 1 to num-entries( lab, '*' ) :
      209           assign lab_             = entry( i, lab, '*' ) + ": "
      210                  cur-label-length = LENGTH( lab_ ).
      211           IF cur-label-length > max-label-length THEN DO: ASSIGN max-label-length = cur-label-length. END.
      212           create text txt
      213                      assign
      214                        frame        = frame DIALOG-1 :handle
      215                        data-type    = "character"
      216                        format       = "x(" + Int2Char( cur-label-length )  + ")"
      217                        screen-value = lab_
      218                        row          = i * 1.5
      219                        column       = 1.5.
      220      end.
      221      do i = 1 to num-entries( type, '*' ) :
      222           assign
      223                 type_ = entry( i, type, '*' )
      224                 fld_  = entry( i, fld,  '*' )
      225                 lab_  = entry( i, lab,  '*' )
      226           .
      227           ASSIGN cur-type-length = INTEGER( ENTRY( LOOKUP( type_, type_list ), format_list ) ).
      228           IF i = 1 THEN DO: ASSIGN type-length-1st = cur-type-length. END.
      229           IF cur-type-length > max-type-length THEN DO: ASSIGN max-type-length = cur-type-length. END.
      230           case type_ :
      231              when 'character':U then do: assign frm = format_character. end.
      232              when 'integer':U   then do: assign frm = format_integer.   end.
      233              when 'int64':U   then do: assign frm = format_int64.   end.
      234              when 'decimal':U   then do: assign frm = format_decimal.   end.
      235              when 'date':U      then do: assign frm = format_date.      end.
      236              when 'logical':U   then do: assign frm = format_logical.   end.
      237              when 'recid':U     then do: assign frm = format_recid.     end.
      238           end case.
      239           create fill-in fill_in
      240                      assign
      241                        frame        = frame DIALOG-1 :handle
      242                        data-type    = type_
      243                        format       = frm
      244                        private-data = fld_ + ',' + lab_
      245                        row          = i * 1.5
      246                        column       = max-label-length + 1
      247                        sensitive    = yes
      248                        visible      = yes.
      249      end.
      250      frame DIALOG-1 :width-chars = max-label-length + max-type-length + 6.
      251      assign
      252           Btn_OK      :row       = i * 1.5 + 1
      253           Btn_OK      :column    = 2
      254           Btn_OK      :visible   = yes
      255           Btn_OK      :sensitive = yes
      256      .
      257      ASSIGN
      258           b-help :ROW       = i * 1.5 + 1
      259           b-help :COLUMN    = MAX( 25, max-label-length + type-length-1st - 5 )
      260           b-help :VISIBLE   = YES
      261           b-help :SENSITIVE = YES
      262      .
      263      assign
      264           Btn_Cancel  :row       = i * 1.5 + 1
      265           Btn_Cancel  :column    = MAX( 12, b-help :COLUMN - 12 )
      266           Btn_Cancel  :visible   = yes
      267           Btn_Cancel  :sensitive = yes
      268      .
      269      if spr <> "" then do:
      270          form Btn_Reference with frame DIALOG-1.
      271          assign
      272               Btn_Reference :row       = 1.5
      273               Btn_Reference :column    = max-label-length + type-length-1st + 2
      274               Btn_Reference :visible   = yes
      275               Btn_Reference :sensitive = yes
      276          .
      277          on choose of btn_ok in frame DIALOG-1 do:
      278               define variable type_       as character no-undo.
      279               define variable code_       as integer   no-undo.
      280               define variable art_        as character no-undo.
      281               define variable jnum_       as integer   no-undo.
      282               define variable jsub_       as integer   no-undo.
      283               define variable jhost-code_ as integer   no-undo.
      284               define variable v-found     as integer   no-undo extent 4.
      285               define variable numfdelim   as integer   no-undo.
      286               assign grp = frame DIALOG-1 :first-child.
      287               do while ( grp <> ? ) :
      288                    assign flw = grp :first-child.
      289                    do while ( flw <> ? ) :
      290                         if flw :type = 'fill-in' then do:
      291                            if spr = 'cli' then do:
      292                               if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      293                               then do:
      294                                 numfdelim = num-entries(entry( 2, entry( 1, flw :private-data ), '.' ),"-":U).
      295                                 case entry( numfdelim, entry( 2, entry( 1, flw :private-data ), '.' ), '-' ) :
      296                                     when "code" then do: assign code_ = integer( flw :screen-value ). end.
      297                                     when "type" then do: assign type_ =          flw :screen-value.   end.
      298                                 end case.
      299                               end.
      300                               else do:
      301                                 numfdelim = num-entries(entry( 2, entry( 1, flw :private-data ), '.' ),"-":U).
      302                                 case entry( numfdelim, entry( 1, flw :private-data ), '-' ) :
      303                                     when "code" then do: assign code_ = integer( flw :screen-value ). end.
      304                                     when "type" then do: assign type_ =          flw :screen-value.   end.
      305                                 end case.
      306                               end.
      307                            end.
      308                            if spr = 'gop' then do:
      309                               if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      310                               then do:
      311                                 case entry( 2, entry( 1, flw :private-data ), '.' )  :
      312                                   when "gop-db-num" then do: assign jnum_ = integer( flw :screen-value ). end.
      313                                   when "gop-id"  then do: assign jsub_ = integer( flw :screen-value ). end.
      314                                 end case.
      315                               end.
      316                               else do:
      317                                 case entry( 2, entry( 1, flw :private-data ), '.' )  :
      318                                   when "gop-db-num" then do: assign jnum_ = integer( flw :screen-value ). end.
      319                                   when "gop-id" then do: assign jsub_ = integer( flw :screen-value ). end.
      320                                 end case.
      321                               end.
      322                            end.
      323                            if spr = 'gds' then do:
      324                               if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      325                               then do:
      326                                 case entry( 2, entry( 1, flw :private-data ), '.' ) :
      327                                     when "prod-code" then do: assign code_ = integer( flw :screen-value ). end.
      328                                     when "prod-type" then do: assign type_ =          flw :screen-value.   end.
      329                                     when "artic"     then do: assign art_  =          flw :screen-value.   end.
      330                                 end case.
      331                               end.
      332                               else do:
      333                                 case entry( 1, flw :private-data ) :
      334                                     when "prod-code" then do: assign code_ = integer( flw :screen-value ). end.
      335                                     when "prod-type" then do: assign type_ =          flw :screen-value.   end.
      336                                     when "artic"     then do: assign art_  =          flw :screen-value.   end.
      337                                 end case.
      338                               end.
      339                            end.
      340                            if spr = 'acc' then do:
      341                               case entry( 2, entry( 2, entry( 1, flw :private-data ), '.' ), '-' ) :
      342                                   when "num" then do: assign jnum_ = integer( flw :screen-value ). end.
      343                                   when "sub" then do: assign jsub_ = integer( flw :screen-value ). end.
      344                               end case.
      345                               case entry( 2, entry( 1, flw :private-data ), '.' ) :
      346                                   when "host-code" then do: assign jhost-code_  = integer( flw :screen-value ). end.
      347                               end case.
      348                            end.
      349                         end.
      350                         assign flw = flw :next-sibling.
      351                    end.
      352                    assign grp = grp :next-sibling.
      353               end.
      354               case spr :
      355                   when 'cli' then do:
      356                       if lookup( type_, ( "":U    + chr(44) +
      357                                           'орг':U  + chr(44) +
      358                                           'чел':U  + chr(44) +
      359                                           'маг':U + chr(44) +
      360                                           'скл':U ) ) = 0 then do:
      361                         message "Неверный тип клиента".
      362                         return no-apply.
      363                       end.
      364                       if type_ = "":U then do:
      365                           FIND ub.clients WHERE
      366                                ub.clients.obj-type  = 'орг':U
      367                            AND ub.clients.obj-code = code_ NO-ERROR.
      368                           if available ub.clients then do: assign v-found[ 1 ] = 1. end.
      369                           FIND ub.clients WHERE
      370                                ub.clients.obj-type  = 'чел':U
      371                            AND ub.clients.obj-code = code_ NO-ERROR.
      372                           if available ub.clients then do: assign v-found[ 2 ] = 1. end.
      373                           FIND ub.clients WHERE
      374                                ub.clients.obj-type  = 'маг':U
      375                            AND ub.clients.obj-code = code_ NO-ERROR.
      376                           if available ub.clients then do: assign v-found[ 3 ] = 1. end.
      377                           FIND ub.clients WHERE
      378                                ub.clients.obj-type  = 'скл':U
      379                            AND ub.clients.obj-code = code_ NO-ERROR.
      380                           if available ub.clients then do: assign v-found[ 4 ] = 1. end.
      381                           if v-found[ 1 ] + v-found[ 2 ] + v-found[ 3 ] + v-found[ 4 ] > 1 then do:
      382                             message "Есть два или более клиента с кодом" code_ skip
      383                                     "Уточните тип клиента"
      384                             view-as alert-box .
      385                             return no-apply.
      386                           end.
      387                           else do:
      388                             if v-found[ 1 ]  = 1 then do:
      389                               assign
      390                                     type_ = 'орг':U
      391                               .
      392                             end.
      393                             if v-found[ 2 ]  = 1 then do:
      394                               assign
      395                                     type_ = 'чел':U
      396                               .
      397                             end.
      398                             if v-found[ 3 ]  = 1 then do:
      399                               assign
      400                                     type_ = 'маг':U
      401                               .
      402                             end.
      403                             if v-found[ 4 ]  = 1 then do:
      404                               assign
      405                                     type_ = 'скл':U
      406                               .
      407                             end.
      408                             if v-found [ 1 ] + v-found [ 2 ] + v-found [ 3 ] + v-found [ 4 ] > 0 then do:
      409                               assign grp = frame DIALOG-1 :first-child.
      410                               do while ( grp <> ? ) :
      411                                   assign flw = grp :first-child.
      412                                   do while ( flw <> ? ) :
      413                                         if flw :type = 'fill-in' then do:
      414                                             if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      415                                             then do:
      416                                               case entry( 2, entry( 2, entry( 1, flw :private-data ), '.' ), '-' ) :
      417                                                   when "type" then do: assign flw :screen-value = type_.   end.
      418                                               end case.
      419                                             end.
      420                                             else do:
      421                                               case entry( 2, entry( 1, flw :private-data ), '-' ) :
      422                                                   when "type" then do: assign flw :screen-value = type_.   end.
      423                                               end case.
      424                                             end.
      425                                         end.
      426                                         assign flw = flw :next-sibling.
      427                                   end.
      428                                   assign grp = grp :next-sibling.
      429                               end.
      430                             end.
      431                           end.
      432                       end.
      433                      find first ub.clients where
      434                                 ub.clients.obj-type = type_
      435                             and ub.clients.obj-code = code_ no-error.
      436                      if not available ub.clients then do:
      437                         message "Клиент отсутствует".
      438                         return no-apply.
      439                      end.
      440                      assign name = clients.obj-name.
      441                   end.
      442                   when 'gds' then do:
      443                     find ub.goods no-lock where
      444                         ub.goods.prod-type = type_
      445                     and ub.goods.prod-code = code_
      446                     and ub.goods.artic     = art_  no-error.
      447                     if not available ub.goods then do:
      448                       message "Товар отсутствует".
      449                       return no-apply.
      450                     end.
      451                     assign name = ub.goods.gds-name.
      452                   END.
      453                   when 'gop' then do:
      454                    find ub.grp-obj-price no-lock where
      455                         ub.grp-obj-price.gop-db-num = jnum_
      456                     and ub.grp-obj-price.gop-id     = jsub_
      457                     no-error.
      458                     if not available ub.grp-obj-price then do:
      459                       message "Группа отсутствует".
      460                       return no-apply.
      461                     end.
      462                     assign name = ub.grp-obj-price.name-group.
      463                   end.
      464               end case.
      465          end.
      466          on choose of Btn_Reference in frame DIALOG-1 do:
      467              define variable grp-rec  as recid     no-undo.
      468              define variable ref-rec  as recid     no-undo.
      469              define variable ref-list as character no-undo.
      470              define variable out-an   as integer   no-undo.
      471              define variable numfdelim as integer  no-undo.
      472              case spr :
      473                   when 'cli' then do:
      474                         ref-list = "".
      475                         run ref/cli-all.w (  input parParentProc,
      476                                          input "b-sel",
      477                                          input 'орг':U,
      478                                          input 'все':U,
      479                                          input 'текущие':U,
      480                                          input ?,
      481                                          input ",,,,,,NO":U,
      482                                          input ?,
      483                                         output ref-list         ) .
      484                         assign ref-rec = integer( entry( 1, ref-list ) ).
      485                         if ref-rec <> 0 then do:
      486                           find ub.clients where recid( ub.clients ) = ref-rec.
      487                           assign name = ub.clients.obj-name.
      488                           assign grp = frame DIALOG-1 :first-child.
      489                           do while ( grp <> ? ) :
      490                                assign flw = grp :first-child.
      491                                do while ( flw <> ? ) :
      492                                     if flw :type = 'fill-in' then do:
      493                                         if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      494                                         then do:
      495                                           numfdelim = num-entries(entry( 2, entry( 1, flw :private-data ), '.' ),"-":U).
      496                                           case entry( numfdelim , entry( 2, entry( 1, flw :private-data ), '.' ), '-' ) :
      497                                               when "code" then do: assign flw :screen-value = string( ub.clients.obj-code ). end.
      498                                               when "type" then do: assign flw :screen-value =         ub.clients.obj-type.   end.
      499                                           end case.
      500                                         end.
      501                                         else do:
      502                                           numfdelim = num-entries(entry( 1, flw :private-data ),"-":U).
      503                                           case entry( numfdelim, entry( 1, flw :private-data ), '-' ) :
      504                                               when "code" then do: assign flw :screen-value = string( ub.clients.obj-code ). end.
      505                                               when "type" then do: assign flw :screen-value =         ub.clients.obj-type.   end.
      506                                           end case.
      507                                         end.
      508                                     end.
      509                                     assign flw = flw :next-sibling.
      510                                end.
      511                                assign grp = grp :next-sibling.
      512                           end.
      513                           apply "entry":u  to Btn_OK in frame DIALOG-1.
      514                           apply "choose":u to Btn_OK in frame DIALOG-1.
      515                         end.
      516                         else do:
      517                           apply "entry":u to Btn_Reference in frame DIALOG-1.
      518                        end.
      519                   end.
      520                   when 'gds' then do:
      521                     run ref/gds-ref.p (    INPUT ParParentProc
      522                                     ,  INPUT "b-sel"
      523                                     ,  INPUT ?
      524                                     ,  INPUT ?
      525                                     ,  INPUT ?
      526                                     ,  INPUT ?
      527                                     ,  INPUT ?
      528                                     ,  INPUT ?
      529                                     ,  INPUT ?
      530                                     ,  INPUT ?
      531                                     ,  INPUT ?
      532                                     ,  INPUT ?
      533                                     , OUTPUT ref-list        ).
      534                     assign ref-rec = integer( entry( 1, ref-list ) ).
      535                     if ref-list <> "" then do:
      536                       find ub.goods where recid( ub.goods ) = ref-rec.
      537                       assign name = ub.goods.gds-name.
      538                       assign grp  = frame DIALOG-1 :first-child.
      539                       do while ( grp <> ? ) :
      540                             assign flw = grp :first-child.
      541                             do while ( flw <> ? ) :
      542                                 if flw :type = 'fill-in' then do:
      543                                     if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      544                                     then do:
      545                                     case entry( 2, entry( 1, flw :private-data ), '.' ) :
      546                                         when "prod-code" then do: assign flw :screen-value = string( ub.goods.prod-code ). end.
      547                                         when "prod-type" then do: assign flw :screen-value =         ub.goods.prod-type.   end.
      548                                         when "artic"     then do: assign flw :screen-value =         ub.goods.artic.       end.
      549                                     end case.
      550                                     end.
      551                                     else do:
      552                                     case entry( 1, flw :private-data ) :
      553                                         when "prod-code" then do: assign flw :screen-value = string( ub.goods.prod-code ). end.
      554                                         when "prod-type" then do: assign flw :screen-value =         ub.goods.prod-type.   end.
      555                                         when "artic"     then do: assign flw :screen-value =         ub.goods.artic.       end.
      556                                     end case.
      557                                     end.
      558                                 end.
      559                                 assign flw = flw :next-sibling.
      560                             end.
      561                             assign grp = grp :next-sibling.
      562                         end.
      563                         apply "entry":u  to Btn_OK in frame DIALOG-1.
      564                         apply "choose":u to Btn_OK in frame DIALOG-1.
      565                     end.              else do: apply "entry":u to Btn_Reference in frame DIALOG-1. end.
      566                   end.
      567                   when 'gop' then do:
      568                         ref-list = "".
      569                         run ref/gr-objpr.w (  input parParentProc,
      570                                              input "b-sel",
      571                                              input-output ref-list  ) .
      572                         assign ref-rec = integer( entry( 1, ref-list ) ).
      573                         if ref-rec <> 0 then do:
      574                           find ub.grp-obj-price where recid( ub.grp-obj-price ) = ref-rec.
      575                           assign name = ub.grp-obj-price.name-group.
      576                           assign grp = frame DIALOG-1 :first-child.
      577                           do while ( grp <> ? ) :
      578                                assign flw = grp :first-child.
      579                                do while ( flw <> ? ) :
      580                                     if flw :type = 'fill-in' then do:
      581                                         if num-entries( entry( 1, flw :private-data ), '.' ) > 1
      582                                         then do :
      583                                           case entry( 2, entry( 1, flw :private-data ), '.' ) :
      584                                               when "gop-db-num" then do: assign flw :screen-value = string( ub.grp-obj-price.gop-db-num ). end.
      585                                               when "gop-id" then do: assign flw :screen-value = string( ub.grp-obj-price.gop-id ).   end.
      586                                           end case.
      587                                         end.
      588                                         else do:
      589                                           case entry( 1, flw :private-data ) :
      590                                               when "gop-db-num" then do: assign flw :screen-value = string( ub.grp-obj-price.gop-db-num ). end.
      591                                               when "gop-id" then do: assign flw :screen-value = string ( ub.grp-obj-price.gop-id ).   end.
      592                                           end case.
      593                                         end.
      594                                     end.
      595                                     assign flw = flw :next-sibling.
      596                                end.
      597                                assign grp = grp :next-sibling.
      598                           end.
      599                           apply "entry":u  to Btn_OK in frame DIALOG-1.
      600                           apply "choose":u to Btn_OK in frame DIALOG-1.
      601                         end.
      602                         else do:
      603                           apply "entry":u to Btn_Reference in frame DIALOG-1.
      604                        end.
      605                   end.
      606              end case.
      607          end.
      608      end.
      609   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   on F1 of frame DIALOG-1 anywhere do:
      611     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame DIALOG-1. END.
      612     return no-apply.
      613   end.
      614   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   on help of frame DIALOG-1
      616   do:
      617     run gbl/app_help.p
      618       (input this-procedure :file-name
      619       ,input ''
      620       ,input ?
      621       ) no-error.
      622     if error-status :error then do:
      623       message
      624         "Ошибка при вызове помощи"
      625         error-status :get-message(1)
      626         view-as alert-box .
      627     end.
      628   end.
      629   run minbtn-set in this-procedure .
      630   on choose of b-help in frame DIALOG-1
      631   do:
      632     apply "help":u to frame DIALOG-1 .
      633   end.
      634   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure minbtn-set :
      636       do
      637           on error undo, return error return-value
      638           :
      639           define variable ii              as integer       no-undo .
      640           define variable fh              as widget-handle no-undo .
      641           define variable hh              as widget-handle no-undo .
      642           define variable v-h             as handle        extent 4 no-undo .
      643           define variable v-name-button   as character     no-undo .
      644           define variable v-help-old-x    as decimal       no-undo .
      645           define variable v-help-old-y    as decimal       no-undo .
      646           define variable v-help-old-size as decimal       no-undo .
      647           define variable v-frame-width   as decimal       no-undo .
      648           define variable jj              as integer       no-undo .
      649           do
      650               on error undo, return error
      651               :
      652               assign
      653                   v-frame-width = frame DIALOG-1:width - 0.3
      654                   fh            = frame DIALOG-1:first-child
      655                   hh            = fh:first-child
      656                   ii            = 1
      657                   .
      658               do while valid-handle(hh):
      659                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      660                   do:
      661                       case lc(hh:name) :
      662                           when "b-help" then
      663                               do:
      664                                   hh:load-image-up("cmp/b-help.bmp":u) .
      665                                   hh:load-image-down("cmp/b-help.bmp":u) .
      666                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      667                                   hh:TOOLTIP = "Помощь" .
      668                                   v-help-old-x = hh:column .
      669                                   v-help-old-y = hh:row    .
      670                                   v-help-old-size = hh:width .
      671                                   hh:width-chars = 2.5 .
      672                               end.
      673                           when "b-print" then
      674                               do:
      675                                   hh:load-image("cmp/b-print.bmp":u) .
      676                                   hh:TOOLTIP = "Печать" .
      677                                   v-h[ii] = hh:handle .
      678                                   ii = ii + 1 .
      679                                   hh:width-chars = 3 .
      680                               end.
      681                           when "b-history" or
      682                           when "b-hist" then
      683                               do:
      684                                   hh:load-image("cmp/b-hist.bmp":u) .
      685                                   hh:TOOLTIP = "История" .
      686                                   v-h[ii] = hh:handle .
      687                                   ii = ii + 1 .
      688                                   hh:width-chars = 3 .
      689                               end.
      690                           when "b-sch" then
      691                               do:
      692                                   hh:load-image("cmp/b-sch.bmp":u) .
      693                                   hh:TOOLTIP = "Установка Фильтра" .
      694                                   v-h[ii] = hh:handle .
      695                                   ii = ii + 1 .
      696                                   hh:width-chars = 3 .
      697                               end.
      698                           when "b-hist-user" then
      699                               do:
      700                                   hh:load-image("cmp/b-hist.bmp":u) .
      701                                   hh:TOOLTIP = "История пользователя" .
      702                                   ii = ii + 1 .
      703                               end.
      704                       end case.
      705                   end.
      706                   hh = hh:next-sibling.
      707               end.
      708               b-help:column = v-frame-width - b-help:width-chars.
      709               jj = 0.
      710               repeat ii = 4 to 1 by -1 :
      711                   if valid-handle (v-h[ii] ) then
      712                   do:
      713                       jj  = jj + 1 .
      714                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      715                       v-h[ii]:row    = v-help-old-y .
      716                   end.
      717               end.
      718           end.
      719       end.
      720   end procedure.
      721      WAIT-FOR GO OF FRAME DIALOG-1.
      722      if znak = "="
      723      then do:
      724        assign
      725          join-tbl = " AND "
      726          join_rus = " И "
      727        .
      728      end.
      729      else do:
      730        assign
      731          join-tbl = " OR "
      732          join_rus = " ИЛИ "
      733        .
      734      end.
      735      assign
      736        grp = frame DIALOG-1 :first-child
      737      .
      738      do while ( grp <> ? )
      739      :
      740         assign flw = grp :first-child.
      741         do while ( flw <> ? ) :
      742           if flw :type = 'fill-in'
      743           then do:
      744             if next-fill-in
      745             then do:
      746               assign
      747                 str     = str     + join-tbl
      748                 str_rus = str_rus + join_rus
      749               .
      750             end.
      751             assign
      752               next-fill-in = yes
      753             .
      754             assign
      755               s             = flw :screen-value
      756               s_description = flw :screen-value
      757               a             = ( if flw :data-type = "character" then '"' else '' )
      758             .
      759             if flw :data-type = "date"
      760             then do:
      761               define variable v-date as date      no-undo .
      762               assign
      763                 v-date = date(flw :screen-value)
      764               .
      765               if v-date = ?
      766               then do:
      767                 assign
      768                   s             = chr(63)
      769                   s_description = "НЕ_ЗАДАНА"
      770                 .
      771               end.
      772               else do:
      773                 assign
      774                   s             = 'date(':u + string(month(v-date))
      775                                 + '~~054':u + string(day(v-date))
      776                                 + '~~054':u + string(year(v-date))
      777                                 + ')':u
      778                   s_description = string(v-date, "99/99/9999")
      779                 .
      780               end.
      781             end.
      782             if flw :data-type = "character"
      783             then do:
      784               run replace-special-char in this-procedure
      785                 (input  s
      786                 ,output s
      787                 ) .
      788               assign
      789                 s_description = replace(s_description, ',', '~~054')
      790               .
      791             end.
      792             assign
      793               str     = str     + entry( 1, flw :private-data ) + " " + znak + " " + a + s             + a
      794               str_rus = str_rus + entry( 2, flw :private-data ) + " " + znak + " " + a + s_description + a
      795             .
      796           end.
      797           assign
      798             flw = flw :next-sibling
      799           .
      800         end.
      801         assign
      802           grp = grp :next-sibling
      803         .
      804      end.
      805      assign
      806        str     = "(" + str     + ")"
      807        str_rus = "(" + str_rus + ")"
      808      .
      809      if lookup( spr, "cli,gds,acc,gop" ) > 0 then do: assign str_rus = lab_user + ' ' + znak + ' "' + name + '"'. end.
      810   END.
      811   RUN disable_UI.
      812   PROCEDURE disable_UI :
      813     HIDE FRAME DIALOG-1.
      814   END PROCEDURE.
      815   PROCEDURE enable_UI :
      816     VIEW FRAME DIALOG-1.
      817   END PROCEDURE.
      818   PROCEDURE replace-special-char :
      819     define input  parameter p-in-string    as character no-undo .
      820     define output parameter p-out-string   as character no-undo .
      821     define variable v-out-string   as character no-undo .
      822     define variable v-enclose-char as character no-undo .
      823     do
      824     on error undo, return error return-value
      825     :
      826       assign
      827         v-out-string   = p-in-string
      828         v-enclose-char = '"'
      829       .
      830       if index(v-out-string, '"') > 0
      831       then do:
      832         assign
      833           v-out-string = replace(v-out-string, '"', v-enclose-char + ' + chr(' + string(asc('"')) + ') + ' + v-enclose-char)
      834         .
      835       end.
      836       if index(v-out-string, '~~') > 0
      837       then do:
      838         assign
      839           v-out-string = replace(v-out-string, '~~', v-enclose-char + ' + chr(' + string(asc('~~')) + ') + ' + v-enclose-char)
      840         .
      841       end.
      842       if index(v-out-string, ',') > 0
      843       then do:
      844         assign
      845           v-out-string = replace(v-out-string, ',', v-enclose-char + ' + chr(' + string(asc(',')) + ') + ' + v-enclose-char)
      846         .
      847       end.
      848       if index(v-out-string, "'") > 0
      849       then do:
      850         assign
      851           v-out-string = replace(v-out-string, "'", v-enclose-char + ' + chr(' + string(asc("'")) + ') + ' + v-enclose-char)
      852         .
      853       end.
      854       if index(v-out-string, '/') > 0
      855       then do:
      856         assign
      857           v-out-string = replace(v-out-string, '/', v-enclose-char + ' + chr(' + string(asc('/')) + ') + ' + v-enclose-char)
      858         .
      859       end.
      860       assign
      861         p-out-string = v-out-string
      862       .
      863     end.
      864   END PROCEDURE.
