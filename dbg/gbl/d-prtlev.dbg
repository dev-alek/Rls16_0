        1   DEFINE BUFFER X_gds-prt FOR ub.gds-prt.
        2   DEFINE BUFFER X_lvl-name FOR ub.lvl-name.
        3   define input  parameter p-node-code as integer   no-undo .
        4   define output parameter v-prt-level as integer   no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision$":U .
        6   define variable vss-author      as character no-undo initial "$Author$":U .
        7   define variable vss-date        as character no-undo initial "$Date$":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        9   define variable vss-archive     as character no-undo initial "$Archive$":U .
       10   define variable vss-description as character no-undo initial "Выбрать уровень шкалы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable v-upper-code as integer   no-undo .
      115   DEFINE BUTTON b-exit AUTO-END-KEY
      116        LABEL "&Выход"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON b-sel AUTO-GO
      124        LABEL "Вы&бор"
      125        SIZE 10 BY 1.
      126   DEFINE VARIABLE fi-scale-name AS CHARACTER FORMAT "X(256)":U
      127        LABEL "Название шкалы"
      128         VIEW-AS TEXT
      129        SIZE 70 BY .67 NO-UNDO.
      130   DEFINE QUERY BROWSE-level FOR
      131         X_lvl-name SCROLLING.
      132   DEFINE QUERY BROWSE-prt FOR
      133         X_gds-prt SCROLLING.
      134   DEFINE BROWSE BROWSE-level
      135     QUERY BROWSE-level DISPLAY
      136         X_lvl-name.lvl-name
      137       WITH NO-ROW-MARKERS SEPARATORS SIZE 21.75 BY 11.92.
      138   DEFINE BROWSE BROWSE-prt
      139     QUERY BROWSE-prt DISPLAY
      140         X_gds-prt.node-name format "x(16)"
      141       WITH NO-ROW-MARKERS SEPARATORS SIZE 30 BY 11.83.
      142   DEFINE FRAME Dialog-Frame
      143        b-exit AT ROW 1 COL 1
      144        b-sel AT ROW 1 COL 11
      145        b-help AT ROW 1 COL 21
      146        BROWSE-level AT ROW 4 COL 9.13
      147        BROWSE-prt AT ROW 4 COL 41.75
      148        fi-scale-name AT ROW 2.38 COL 16 COLON-ALIGNED
      149        SPACE(1.24) SKIP(14.19)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Просмотр шкалы"
      153            DEFAULT-BUTTON b-exit.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON GO OF FRAME Dialog-Frame
      158   DO:
      159     if available X_lvl-name
      160     then do:
      161       assign
      162         v-prt-level = X_lvl-name.level + 1
      163       .
      164     end.
      165   END.
      166   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      167   DO:
      168     APPLY "END-ERROR":U TO SELF.
      169   END.
      170   ON VALUE-CHANGED OF BROWSE-level IN FRAME Dialog-Frame
      171   DO:
      172     run open-query-gds-prt in this-procedure .
      173   END.
      174   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      175   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      176   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      177   on help of frame Dialog-Frame
      178   do:
      179     run gbl/app_help.p
      180       (input this-procedure :file-name
      181       ,input ''
      182       ,input ?
      183       ) no-error.
      184     if error-status :error then do:
      185       message
      186         "Ошибка при вызове помощи"
      187         error-status :get-message(1)
      188         view-as alert-box .
      189     end.
      190   end.
      191   run minbtn-set in this-procedure .
      192   on choose of b-help in frame Dialog-Frame
      193   do:
      194     apply "help":u to frame Dialog-Frame .
      195   end.
      196   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197   procedure minbtn-set :
      198       do
      199           on error undo, return error return-value
      200           :
      201           define variable ii              as integer       no-undo .
      202           define variable fh              as widget-handle no-undo .
      203           define variable hh              as widget-handle no-undo .
      204           define variable v-h             as handle        extent 4 no-undo .
      205           define variable v-name-button   as character     no-undo .
      206           define variable v-help-old-x    as decimal       no-undo .
      207           define variable v-help-old-y    as decimal       no-undo .
      208           define variable v-help-old-size as decimal       no-undo .
      209           define variable v-frame-width   as decimal       no-undo .
      210           define variable jj              as integer       no-undo .
      211           do
      212               on error undo, return error
      213               :
      214               assign
      215                   v-frame-width = frame Dialog-Frame:width - 0.3
      216                   fh            = frame Dialog-Frame:first-child
      217                   hh            = fh:first-child
      218                   ii            = 1
      219                   .
      220               do while valid-handle(hh):
      221                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      222                   do:
      223                       case lc(hh:name) :
      224                           when "b-help" then
      225                               do:
      226                                   hh:load-image-up("cmp/b-help.bmp":u) .
      227                                   hh:load-image-down("cmp/b-help.bmp":u) .
      228                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      229                                   hh:TOOLTIP = "Помощь" .
      230                                   v-help-old-x = hh:column .
      231                                   v-help-old-y = hh:row    .
      232                                   v-help-old-size = hh:width .
      233                                   hh:width-chars = 2.5 .
      234                               end.
      235                           when "b-print" then
      236                               do:
      237                                   hh:load-image("cmp/b-print.bmp":u) .
      238                                   hh:TOOLTIP = "Печать" .
      239                                   v-h[ii] = hh:handle .
      240                                   ii = ii + 1 .
      241                                   hh:width-chars = 3 .
      242                               end.
      243                           when "b-history" or
      244                           when "b-hist" then
      245                               do:
      246                                   hh:load-image("cmp/b-hist.bmp":u) .
      247                                   hh:TOOLTIP = "История" .
      248                                   v-h[ii] = hh:handle .
      249                                   ii = ii + 1 .
      250                                   hh:width-chars = 3 .
      251                               end.
      252                           when "b-sch" then
      253                               do:
      254                                   hh:load-image("cmp/b-sch.bmp":u) .
      255                                   hh:TOOLTIP = "Установка Фильтра" .
      256                                   v-h[ii] = hh:handle .
      257                                   ii = ii + 1 .
      258                                   hh:width-chars = 3 .
      259                               end.
      260                           when "b-hist-user" then
      261                               do:
      262                                   hh:load-image("cmp/b-hist.bmp":u) .
      263                                   hh:TOOLTIP = "История пользователя" .
      264                                   ii = ii + 1 .
      265                               end.
      266                       end case.
      267                   end.
      268                   hh = hh:next-sibling.
      269               end.
      270               b-help:column = v-frame-width - b-help:width-chars.
      271               jj = 0.
      272               repeat ii = 4 to 1 by -1 :
      273                   if valid-handle (v-h[ii] ) then
      274                   do:
      275                       jj  = jj + 1 .
      276                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      277                       v-h[ii]:row    = v-help-old-y .
      278                   end.
      279               end.
      280           end.
      281       end.
      282   end procedure.
      283   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      284   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      285   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      286   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      287   define variable v-diasize-current-frame-width  as decimal   no-undo .
      288   define variable v-diasize-current-frame-height as decimal   no-undo .
      289   define variable v-diasize-change-size          as logical   no-undo .
      290   define variable v-diasize-resize-button        as handle    no-undo .
      291   define variable v-diasize-wndmax               as logical   no-undo .
      292   define variable v-diasize-wndstore             as logical   no-undo .
      293   define variable v-diasize-proc-name            as character no-undo .
      294   define variable v-diasize-browse-handle        as handle    no-undo .
      295   define variable v-diasize-browse-number        as integer   no-undo .
      296   define variable v-diasize-need-full-display    as logical   no-undo init false .
      297   define temp-table temp-diasize-handle no-undo
      298     field handle-value  as handle
      299     field save-position as decimal
      300     index xpk is primary unique handle-value
      301     .
      302   define temp-table temp-browse-handle no-undo
      303     field browse-type   as character
      304     field browse-number as integer
      305     field browse-handle as handle
      306     field original-size as decimal
      307     index xpk is primary unique browse-type browse-number
      308     index xie browse-type browse-handle
      309   .
      310   procedure diasize_change-height :
      311     define input  parameter p-change-value  as decimal   no-undo .
      312     define input  parameter p-move-resize   as logical   no-undo .
      313     define variable v-field-group-handle    as handle    no-undo .
      314     define variable v-object-handle         as handle    no-undo .
      315     define variable v-frame-height          as decimal   no-undo .
      316     define variable v-frame-virtual-height  as decimal   no-undo .
      317     define variable v-browse-height         as decimal   no-undo .
      318     define variable v-window-height         as decimal   no-undo .
      319     define variable v-window-virtual-height as decimal   no-undo .
      320     define variable v-change-sign           as integer   no-undo .
      321     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      322     define buffer buf_temp-browse-handle  for temp-browse-handle .
      323     if p-change-value > 0
      324     then do:
      325       if frame Dialog-Frame :height + p-change-value
      326           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      327       then do:
      328         assign
      329           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      330                           - (frame Dialog-Frame :height-chars)
      331         .
      332         if p-change-value <= 0
      333         then do:
      334           run diasize_position-resize-button in this-procedure .
      335           return .
      336         end.
      337       end.
      338     end.
      339     if p-change-value < 0
      340     then do:
      341       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      342       then do:
      343         assign
      344           p-change-value = v-diasize-orig-frame-height
      345                          - (frame Dialog-Frame :height-chars)
      346         .
      347         if p-change-value >= 0
      348         then do:
      349           run diasize_position-resize-button in this-procedure .
      350           return .
      351         end.
      352       end.
      353     end.
      354     if p-change-value >= 0
      355     then do:
      356       assign
      357         v-change-sign = 1
      358       .
      359     end.
      360     else do:
      361       assign
      362         v-change-sign = -1
      363       .
      364     end.
      365     assign
      366       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      367     .
      368     if p-change-value = 0
      369     then do:
      370       run diasize_position-resize-button in this-procedure .
      371       return .
      372     end.
      373     move_block:
      374     do
      375     on error undo move_block, retry move_block
      376     :
      377       if retry
      378       then do:
      379         do
      380         on error undo move_block, leave move_block
      381         :
      382           if p-change-value > 0
      383           then do:
      384             for each buf_temp-diasize-handle
      385             on error undo, next
      386             :
      387               assign
      388                 v-object-handle = buf_temp-diasize-handle.handle-value
      389               .
      390               if v-object-handle <> v-diasize-resize-button
      391               then do:
      392                 assign
      393                   v-object-handle :row = buf_temp-diasize-handle.save-position
      394                 .
      395               end.
      396             end.
      397             assign
      398               v-diasize-browse-handle :height = v-browse-height
      399             .
      400             for each buf_temp-browse-handle
      401               where buf_temp-browse-handle.browse-type = 'height':u
      402             on error undo, next
      403             :
      404               assign
      405                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      406               .
      407             end.
      408             assign
      409               frame Dialog-Frame :height = v-frame-height
      410             .
      411             if frame Dialog-Frame :scrollable = true
      412             then do:
      413               assign
      414                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      415               .
      416             end.
      417             run diasize_position-resize-button in this-procedure .
      418           end.
      419           else do:
      420             if frame Dialog-Frame :scrollable = true
      421             then do:
      422               assign
      423                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      424               .
      425             end.
      426             assign
      427               frame Dialog-Frame :height = v-frame-height
      428             .
      429             assign
      430               v-diasize-browse-handle :height = v-browse-height
      431             .
      432             for each buf_temp-browse-handle
      433               where buf_temp-browse-handle.browse-type = 'height':u
      434             on error undo, next
      435             :
      436               assign
      437                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      438               .
      439             end.
      440             for each buf_temp-diasize-handle
      441             on error undo, next
      442             :
      443               assign
      444                 v-object-handle = buf_temp-diasize-handle.handle-value
      445               .
      446               if v-object-handle <> v-diasize-resize-button
      447               then do:
      448                 assign
      449                   v-object-handle :row = buf_temp-diasize-handle.save-position
      450                 .
      451               end.
      452             end.
      453             run diasize_position-resize-button in this-procedure .
      454           end.
      455           assign
      456             v-diasize-change-size = false
      457           .
      458           leave move_block .
      459         end.
      460       end.
      461       assign
      462         v-diasize-need-full-display = true
      463       .
      464       if v-diasize-change-size = false
      465       then do:
      466         assign
      467           v-diasize-change-size = true
      468         .
      469       end.
      470       else do:
      471         return .
      472       end.
      473       assign
      474         v-frame-height = frame Dialog-Frame :height
      475         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      476         v-browse-height = v-diasize-browse-handle :height
      477       .
      478       for each buf_temp-browse-handle
      479         where buf_temp-browse-handle.browse-type = 'height':u
      480       :
      481         assign
      482           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      483         .
      484       end.
      485       for each buf_temp-diasize-handle
      486       :
      487         delete buf_temp-diasize-handle .
      488       end.
      489       assign
      490         v-field-group-handle = frame Dialog-Frame :first-child
      491       .
      492       do while valid-handle(v-field-group-handle)
      493       :
      494         assign
      495           v-object-handle = v-field-group-handle :first-child
      496         .
      497         do while valid-handle(v-object-handle)
      498         :
      499           if  v-object-handle <> v-diasize-browse-handle :handle
      500           and can-query(v-object-handle, "row")
      501           and can-query(v-object-handle, "height")
      502           and ( v-object-handle :row > v-diasize-browse-handle :row )
      503           then do:
      504             find first buf_temp-browse-handle
      505               where buf_temp-browse-handle.browse-type   = 'height':u
      506                 and buf_temp-browse-handle.browse-handle = v-object-handle
      507               no-error .
      508             if available buf_temp-browse-handle
      509             then do:
      510             end.
      511             else do:
      512               create buf_temp-diasize-handle .
      513               assign
      514                 buf_temp-diasize-handle.handle-value  = v-object-handle
      515                 buf_temp-diasize-handle.save-position = v-object-handle :row
      516               .
      517             end.
      518           end.
      519           assign
      520             v-object-handle = v-object-handle :next-sibling
      521           .
      522         end.
      523         assign
      524           v-field-group-handle = v-field-group-handle :next-sibling
      525         .
      526       end.
      527       do with frame Dialog-Frame
      528       :
      529         hide v-diasize-resize-button .
      530         assign
      531           v-diasize-resize-button :row    = 1
      532           v-diasize-resize-button :column = 1
      533         .
      534       end.
      535       if p-change-value > 0
      536       then do:
      537         if frame Dialog-Frame :scrollable = true
      538         then do:
      539           assign
      540             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      541             no-error .
      542           if error-status :error
      543           or error-status :get-message(1) <> ""
      544           then do:
      545             undo move_block, retry move_block .
      546           end.
      547         end.
      548         assign
      549           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      550           no-error .
      551         if error-status :error
      552         or error-status :get-message(1) <> ""
      553         then do:
      554           undo move_block, retry move_block .
      555         end.
      556         assign
      557           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      558           no-error .
      559         if error-status :error
      560         or error-status :get-message(1) <> ""
      561         then do:
      562           undo move_block, retry move_block .
      563         end.
      564         for each buf_temp-browse-handle
      565           where buf_temp-browse-handle.browse-type = 'height':u
      566         on error undo move_block, retry move_block
      567         :
      568           assign
      569             buf_temp-browse-handle.browse-handle :height
      570               = buf_temp-browse-handle.browse-handle :height + p-change-value
      571             no-error .
      572           if error-status :error
      573           or error-status :get-message(1) <> ""
      574           then do:
      575             undo move_block, retry move_block .
      576           end.
      577         end.
      578         for each buf_temp-diasize-handle
      579         on error undo move_block, retry move_block
      580         :
      581           assign
      582             v-object-handle = buf_temp-diasize-handle.handle-value
      583           .
      584           if v-object-handle <> v-diasize-resize-button
      585           then do:
      586             assign
      587               v-object-handle :row = v-object-handle :row + p-change-value
      588               no-error .
      589             if error-status :error
      590             or error-status :get-message(1) <> ""
      591             then do:
      592               undo move_block, retry move_block .
      593             end.
      594           end.
      595         end.
      596       end.
      597       else do:
      598         for each buf_temp-diasize-handle
      599         on error undo move_block, retry move_block
      600         :
      601           assign
      602             v-object-handle = buf_temp-diasize-handle.handle-value
      603           .
      604           if v-object-handle <> v-diasize-resize-button
      605           then do:
      606             assign
      607               v-object-handle :row = v-object-handle :row + p-change-value
      608               no-error .
      609             if error-status :error
      610             or error-status :get-message(1) <> ""
      611             then do:
      612               undo move_block, retry move_block .
      613             end.
      614           end.
      615         end.
      616         assign
      617           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      618           no-error .
      619         if error-status :error
      620         or error-status :get-message(1) <> ""
      621         then do:
      622           undo move_block, retry move_block .
      623         end.
      624         for each buf_temp-browse-handle
      625           where buf_temp-browse-handle.browse-type = 'height':u
      626         on error undo move_block, retry move_block
      627         :
      628           assign
      629             buf_temp-browse-handle.browse-handle :height
      630               = buf_temp-browse-handle.browse-handle :height + p-change-value
      631             no-error .
      632           if error-status :error
      633           or error-status :get-message(1) <> ""
      634           then do:
      635             undo move_block, retry move_block .
      636           end.
      637         end.
      638         assign
      639           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      640           no-error .
      641         if error-status :error
      642         or error-status :get-message(1) <> ""
      643         then do:
      644           undo move_block, retry move_block .
      645         end.
      646         if frame Dialog-Frame :scrollable = true
      647         then do:
      648           assign
      649             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      650             no-error .
      651           if error-status :error
      652           or error-status :get-message(1) <> ""
      653           then do:
      654             undo move_block, retry move_block .
      655           end.
      656         end.
      657       end.
      658       if p-move-resize = true
      659       then do:
      660         run diasize_position-resize-button in this-procedure .
      661       end.
      662       if v-diasize-wndstore = true
      663       then do:
      664         if connected("ub") = true
      665         then do:
      666           define variable v-cntxt-db-num        as integer   no-undo .
      667           define variable v-cntxt-userid        as character no-undo .
      668           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      669                                             , OUTPUT v-cntxt-userid
      670                                             ) .
      671           run gbl/wndsizew.p
      672             (input  v-cntxt-db-num
      673             ,input  v-cntxt-userid
      674             ,input  v-diasize-proc-name
      675             ,input  'height':u
      676             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      677             ) .
      678         end.
      679       end.
      680     end.
      681     assign
      682       v-diasize-change-size = false
      683     .
      684   end procedure.
      685   procedure diasize_set-height :
      686     define input  parameter p-new-height  as decimal   no-undo .
      687     define input  parameter p-move-resize as logical   no-undo .
      688     do
      689     on error undo, return error return-value
      690     :
      691       run diasize_change-height in this-procedure
      692         (input  (p-new-height - frame Dialog-Frame :height)
      693         ,input  p-move-resize
      694         ) .
      695     end.
      696   end procedure.
      697   procedure diasize_change-width :
      698     define input  parameter p-change-value as decimal   no-undo .
      699     define input  parameter p-move-resize  as logical   no-undo .
      700     define variable v-field-group-handle   as handle    no-undo .
      701     define variable v-object-handle        as handle    no-undo .
      702     define variable v-frame-width          as decimal   no-undo .
      703     define variable v-frame-virtual-width  as decimal   no-undo .
      704     define variable v-browse-width         as decimal   no-undo .
      705     define variable v-window-width         as decimal   no-undo .
      706     define variable v-window-virtual-width as decimal   no-undo .
      707     define variable v-change-sign          as integer   no-undo .
      708     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      709     define buffer buf_temp-browse-handle  for temp-browse-handle .
      710     if p-change-value > 0
      711     then do:
      712       if frame Dialog-Frame :width + p-change-value >
      713           session :width-chars
      714       then do:
      715         assign
      716           p-change-value = session :width-chars - frame Dialog-Frame :width
      717         .
      718         if p-change-value <= 0
      719         then do:
      720           run diasize_position-resize-button in this-procedure .
      721           return .
      722         end.
      723       end.
      724     end.
      725     if p-change-value < 0
      726     then do:
      727       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      728       then do:
      729         assign
      730           p-change-value = v-diasize-orig-frame-width
      731                          - frame Dialog-Frame :width
      732         .
      733         if p-change-value >= 0
      734         then do:
      735           run diasize_position-resize-button in this-procedure .
      736           return .
      737         end.
      738       end.
      739     end.
      740     if p-change-value >= 0
      741     then do:
      742       assign
      743         v-change-sign = 1
      744       .
      745     end.
      746     else do:
      747       assign
      748         v-change-sign = -1
      749       .
      750     end.
      751     assign
      752       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      753     .
      754     if p-change-value = 0
      755     then do:
      756       run diasize_position-resize-button in this-procedure .
      757       return .
      758     end.
      759     move_block:
      760     do
      761     on error undo move_block, leave move_block
      762     :
      763       if retry
      764       then do:
      765         do
      766         on error undo move_block, leave move_block
      767         :
      768           if p-change-value > 0
      769           then do:
      770             for each buf_temp-diasize-handle
      771             on error undo, next
      772             :
      773               assign
      774                 v-object-handle = buf_temp-diasize-handle.handle-value
      775               .
      776               if v-object-handle <> v-diasize-resize-button
      777               then do:
      778                 assign
      779                   v-object-handle :col = buf_temp-diasize-handle.save-position
      780                 .
      781               end.
      782             end.
      783             assign
      784               v-diasize-browse-handle :width = v-browse-width
      785             .
      786             for each buf_temp-browse-handle
      787               where buf_temp-browse-handle.browse-type = 'width':u
      788             on error undo, next
      789             :
      790               assign
      791                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      792               .
      793             end.
      794             assign
      795               frame Dialog-Frame :width = v-frame-width
      796             .
      797             if frame Dialog-Frame :scrollable = true
      798             then do:
      799               assign
      800                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      801               .
      802             end.
      803             run diasize_position-resize-button in this-procedure .
      804           end.
      805           else do:
      806             if frame Dialog-Frame :scrollable = true
      807             then do:
      808               assign
      809                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      810               .
      811             end.
      812             assign
      813               frame Dialog-Frame :width = v-frame-width
      814             .
      815             for each buf_temp-browse-handle
      816               where buf_temp-browse-handle.browse-type = 'width':u
      817             on error undo, next
      818             :
      819               assign
      820                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      821               .
      822             end.
      823             assign
      824               v-diasize-browse-handle :width = v-browse-width
      825             .
      826             for each buf_temp-diasize-handle
      827             on error undo, next
      828             :
      829               assign
      830                 v-object-handle = buf_temp-diasize-handle.handle-value
      831               .
      832               if v-object-handle <> v-diasize-resize-button
      833               then do:
      834                 assign
      835                   v-object-handle :col = buf_temp-diasize-handle.save-position
      836                 .
      837               end.
      838             end.
      839             run diasize_position-resize-button in this-procedure .
      840           end.
      841           assign
      842             v-diasize-change-size = false
      843           .
      844           leave move_block .
      845         end.
      846       end.
      847       assign
      848         v-diasize-need-full-display = true
      849       .
      850       if v-diasize-change-size = false
      851       then do:
      852         assign
      853           v-diasize-change-size = true
      854         .
      855       end.
      856       else do:
      857         return .
      858       end.
      859       assign
      860         v-frame-width = frame Dialog-Frame :width
      861         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      862         v-browse-width = v-diasize-browse-handle :width
      863       .
      864       for each buf_temp-browse-handle
      865         where buf_temp-browse-handle.browse-type = 'width':u
      866       :
      867         assign
      868           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      869         .
      870       end.
      871       for each buf_temp-diasize-handle
      872       :
      873         delete buf_temp-diasize-handle .
      874       end.
      875       assign
      876         v-field-group-handle = frame Dialog-Frame :first-child
      877       .
      878       do while valid-handle(v-field-group-handle)
      879       :
      880         assign
      881           v-object-handle = v-field-group-handle :first-child
      882         .
      883         do while valid-handle(v-object-handle)
      884         :
      885           if  v-object-handle <> v-diasize-browse-handle :handle
      886           and v-object-handle <> v-diasize-resize-button
      887           and can-query(v-object-handle, "row")
      888           and can-query(v-object-handle, "height")
      889           and ( v-object-handle :col + v-object-handle :width
      890                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      891               )
      892           then do:
      893             find first buf_temp-browse-handle
      894               where buf_temp-browse-handle.browse-type   = 'width':u
      895                 and buf_temp-browse-handle.browse-handle = v-object-handle
      896               no-error .
      897             if available buf_temp-browse-handle
      898             then do:
      899             end.
      900             else do:
      901               create buf_temp-diasize-handle .
      902               assign
      903                 buf_temp-diasize-handle.handle-value  = v-object-handle
      904                 buf_temp-diasize-handle.save-position = v-object-handle :col
      905               .
      906             end.
      907           end.
      908           assign
      909             v-object-handle = v-object-handle :next-sibling
      910           .
      911         end.
      912         assign
      913           v-field-group-handle = v-field-group-handle :next-sibling
      914         .
      915       end.
      916       do with frame Dialog-Frame
      917       :
      918         hide v-diasize-resize-button .
      919         v-diasize-resize-button :row = 1.
      920         v-diasize-resize-button :column = 1.
      921       end.
      922       if p-change-value > 0
      923       then do:
      924         if frame Dialog-Frame :scrollable = true
      925         then do:
      926           assign
      927             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      928             no-error .
      929           if error-status :error
      930           or error-status :get-message(1) <> ""
      931           then do:
      932             undo move_block, retry move_block.
      933           end.
      934         end.
      935         assign
      936           frame Dialog-Frame :width = v-frame-width + p-change-value
      937           no-error .
      938         if error-status :error
      939         or error-status :get-message(1) <> ""
      940         then do:
      941           undo move_block, retry move_block.
      942         end.
      943         assign
      944           v-diasize-browse-handle :width = v-browse-width + p-change-value
      945         no-error .
      946         if error-status :error
      947         or error-status :get-message(1) <> ""
      948         then do:
      949           undo move_block, retry move_block.
      950         end.
      951         for each buf_temp-browse-handle
      952           where buf_temp-browse-handle.browse-type = 'width':u
      953         on error undo move_block, retry move_block
      954         :
      955           assign
      956             buf_temp-browse-handle.browse-handle :width
      957               = buf_temp-browse-handle.browse-handle :width + p-change-value
      958             no-error .
      959           if error-status :error
      960           or error-status :get-message(1) <> ""
      961           then do:
      962             undo move_block, retry move_block .
      963           end.
      964         end.
      965         for each buf_temp-diasize-handle
      966         on error undo move_block, retry move_block
      967         :
      968           assign
      969             v-object-handle = buf_temp-diasize-handle.handle-value
      970           .
      971           if v-object-handle <> v-diasize-resize-button
      972           then do:
      973             assign
      974               v-object-handle :col = v-object-handle :col + p-change-value
      975               no-error .
      976             if error-status :error
      977             or error-status :get-message(1) <> ""
      978             then do:
      979               undo move_block, retry move_block .
      980             end.
      981           end.
      982         end.
      983       end.
      984       else do:
      985         for each buf_temp-diasize-handle
      986         on error undo move_block, retry move_block
      987         :
      988           assign
      989             v-object-handle = buf_temp-diasize-handle.handle-value
      990           .
      991           if v-object-handle <> v-diasize-resize-button
      992           then do:
      993             assign
      994               v-object-handle :col = v-object-handle :col + p-change-value
      995               no-error .
      996             if error-status :error
      997             or error-status :get-message(1) <> ""
      998             then do:
      999               undo move_block, retry move_block .
     1000             end.
     1001           end.
     1002         end.
     1003         for each buf_temp-browse-handle
     1004           where buf_temp-browse-handle.browse-type = 'width':u
     1005         on error undo move_block, retry move_block
     1006         :
     1007           assign
     1008             buf_temp-browse-handle.browse-handle :width
     1009               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1010             no-error .
     1011           if error-status :error
     1012           or error-status :get-message(1) <> ""
     1013           then do:
     1014             undo move_block, retry move_block .
     1015           end.
     1016         end.
     1017         assign
     1018           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1019           no-error .
     1020         if error-status :error
     1021         or error-status :get-message(1) <> ""
     1022         then do:
     1023           undo move_block, retry move_block.
     1024         end.
     1025         assign
     1026           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1027         no-error .
     1028         if error-status :error
     1029         or error-status :get-message(1) <> ""
     1030         then do:
     1031           undo move_block, retry move_block.
     1032         end.
     1033         if frame Dialog-Frame :scrollable = true
     1034         then do:
     1035           assign
     1036             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1037           no-error .
     1038           if error-status :error
     1039           or error-status :get-message(1) <> ""
     1040           then do:
     1041             undo move_block, retry move_block.
     1042           end.
     1043         end.
     1044       end.
     1045       if p-move-resize
     1046       then do:
     1047         run diasize_position-resize-button in this-procedure .
     1048       end.
     1049       if v-diasize-wndstore = true
     1050       then do:
     1051         if connected("ub") = true
     1052         then do:
     1053           define variable v-cntxt-db-num        as integer   no-undo .
     1054           define variable v-cntxt-userid        as character no-undo .
     1055           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1056                                             , OUTPUT v-cntxt-userid
     1057                                             ) .
     1058           run gbl/wndsizew.p
     1059             (input  v-cntxt-db-num
     1060             ,input  v-cntxt-userid
     1061             ,input  v-diasize-proc-name
     1062             ,input  'width':u
     1063             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1064             ) .
     1065         end.
     1066       end.
     1067     end.
     1068     assign
     1069       v-diasize-change-size = false
     1070     .
     1071   end procedure.
     1072   procedure diasize_set-width :
     1073     define input  parameter p-new-width  as decimal   no-undo .
     1074     define input  parameter p-move-resize as logical   no-undo .
     1075     do
     1076     on error undo, return error return-value
     1077     :
     1078       run diasize_change-width in this-procedure
     1079         (input  (p-new-width - frame Dialog-Frame :width)
     1080         ,input  p-move-resize
     1081         ) .
     1082     end.
     1083   end procedure.
     1084   procedure diasize_position-resize-button :
     1085     do with frame Dialog-Frame
     1086     :
     1087       hide v-diasize-resize-button .
     1088       assign
     1089         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1090                     - 1
     1091                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1092         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1093                     - 1
     1094                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1095       .
     1096       view v-diasize-resize-button .
     1097     end.
     1098   end procedure.
     1099   on alt-right anywhere
     1100   do:
     1101     run diasize_change-width in this-procedure
     1102       (input 1
     1103       ,input true
     1104       ) .
     1105     return no-apply .
     1106   end.
     1107   on alt-left anywhere
     1108   do:
     1109     run diasize_change-width in this-procedure
     1110       (input -1
     1111       ,input true
     1112       ) .
     1113     return no-apply .
     1114   end.
     1115   on alt-down anywhere
     1116   do:
     1117     run diasize_change-height in this-procedure
     1118       (input 1
     1119       ,input true
     1120       ) .
     1121     return no-apply .
     1122   end.
     1123   on alt-up anywhere
     1124   do:
     1125     run diasize_change-height in this-procedure
     1126       (input -1
     1127       ,input true
     1128       ) .
     1129     return no-apply .
     1130   end.
     1131   on alt-enter of frame Dialog-Frame
     1132   do:
     1133     run diasize_maximize in this-procedure
     1134       (input  ?
     1135       ).
     1136     return no-apply .
     1137   end.
     1138   procedure diasize_end-move :
     1139     do
     1140     on error undo, return error return-value
     1141     :
     1142       define variable v-row-delta as decimal   no-undo .
     1143       define variable v-col-delta as decimal   no-undo .
     1144       define variable v-new-row as decimal   no-undo .
     1145       define variable v-new-col as decimal   no-undo .
     1146       assign
     1147         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1148         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1149       .
     1150       assign
     1151         v-row-delta = v-new-row - frame Dialog-Frame :height
     1152         v-col-delta = v-new-col - frame Dialog-Frame :width
     1153       .
     1154       run diasize_change-height in this-procedure
     1155         (input v-row-delta
     1156         ,input true
     1157         ) .
     1158       run diasize_change-width in this-procedure
     1159         (input v-col-delta
     1160         ,input true
     1161         ) .
     1162     end.
     1163   end procedure.
     1164   procedure diasize_maximize :
     1165     define input  parameter p-action as logical   no-undo .
     1166     do
     1167     on error undo, return error return-value
     1168     :
     1169       if p-action = ?
     1170       then do:
     1171         if v-diasize-need-maximize = true
     1172         then do:
     1173           assign
     1174             p-action = true
     1175           .
     1176         end.
     1177         else do:
     1178           assign
     1179             p-action = false
     1180           .
     1181         end.
     1182       end.
     1183       if p-action = true
     1184       then do:
     1185         run diasize_change-height in this-procedure
     1186           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1187               - frame Dialog-Frame :height-chars
     1188           ,input true
     1189           ) .
     1190         run diasize_change-width in this-procedure
     1191           (input session :width-chars
     1192               - frame Dialog-Frame :width-chars
     1193           ,input true
     1194           ) .
     1195         assign
     1196           v-diasize-need-maximize = false
     1197         .
     1198       end.
     1199       else do:
     1200         run diasize_change-width in this-procedure
     1201           (input v-diasize-orig-frame-width
     1202               - frame Dialog-Frame :width-chars
     1203           ,input true
     1204           ) .
     1205         run diasize_change-height in this-procedure
     1206           (input v-diasize-orig-frame-height
     1207               - frame Dialog-Frame :height-chars
     1208           ,input true
     1209           ) .
     1210         assign
     1211           v-diasize-need-maximize = true
     1212         .
     1213       end.
     1214     end.
     1215   end procedure.
     1216   procedure diasize_restore-orig-size :
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220       assign
     1221         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1222         v-diasize-current-frame-height = frame Dialog-Frame :height
     1223       .
     1224       run diasize_set-height in this-procedure
     1225         (input  v-diasize-orig-frame-height
     1226         ,input  true
     1227         ) .
     1228       run diasize_set-width in this-procedure
     1229         (input  v-diasize-orig-frame-width
     1230         ,input  true
     1231         ) .
     1232     end.
     1233   end procedure.
     1234   procedure diasize_restore-current-size :
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       run diasize_set-height in this-procedure
     1239         (input  v-diasize-current-frame-height
     1240         ,input  true
     1241         ) .
     1242       run diasize_set-width in this-procedure
     1243         (input  v-diasize-current-frame-width
     1244         ,input  true
     1245         ) .
     1246     end.
     1247   end procedure.
     1248   procedure diasize_set-browse-handle :
     1249     define input  parameter p-browse-handle as handle   no-undo .
     1250     define buffer buf_temp-browse-handle for temp-browse-handle .
     1251     do
     1252     on error undo, return error return-value
     1253     :
     1254       assign
     1255         v-diasize-browse-handle = p-browse-handle
     1256       .
     1257       for each buf_temp-browse-handle
     1258       on error undo, return error return-value
     1259       :
     1260         delete buf_temp-browse-handle .
     1261       end.
     1262     end.
     1263   end procedure.
     1264   procedure diasize_add_browse :
     1265     define input  parameter p-browse-type   as character no-undo .
     1266     define input  parameter p-browse-handle as handle    no-undo .
     1267     define buffer buf_temp-browse-handle for temp-browse-handle .
     1268     do
     1269     on error undo, return error return-value
     1270     :
     1271       assign
     1272         v-diasize-browse-number = v-diasize-browse-number + 1
     1273       .
     1274       create buf_temp-browse-handle .
     1275       assign
     1276         buf_temp-browse-handle.browse-type   = p-browse-type
     1277         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1278         buf_temp-browse-handle.browse-handle = p-browse-handle
     1279       .
     1280     end.
     1281   end procedure.
     1282   procedure diasize_init :
     1283     define variable v-default-value    as logical   no-undo .
     1284     define variable v-restore-saved    as logical   no-undo .
     1285     define variable v-resize-value-str as character no-undo .
     1286     do
     1287     on error undo, return error return-value
     1288     :
     1289       do with frame Dialog-Frame
     1290       :
     1291         assign
     1292           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1293           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1294           v-diasize-browse-handle     = browse BROWSE-level :handle
     1295         .
     1296         create button v-diasize-resize-button
     1297         assign
     1298           parent        = frame Dialog-Frame :first-child
     1299           label         = "s"
     1300           height-pixels = 16
     1301           width-pixels  = 16
     1302           visible       = true
     1303           sensitive     = true
     1304           movable       = true
     1305           triggers:
     1306             on end-move persistent run diasize_end-move in this-procedure .
     1307           end triggers.
     1308         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1309         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1310         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1311         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1312         assign
     1313           v-diasize-wndmax = false
     1314         .
     1315         if connected("ub") = true
     1316         then do:
     1317           define variable v-cntxt-db-num        as integer   no-undo .
     1318           define variable v-cntxt-userid        as character no-undo .
     1319           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1320                                             , OUTPUT v-cntxt-userid
     1321                                             ) .
     1322           run gbl/wndpar_r.p
     1323             (input  v-cntxt-db-num
     1324             ,input  v-cntxt-userid
     1325             ,input  'wndmax':U
     1326             ,output v-diasize-wndmax
     1327             ,output v-default-value
     1328             ) .
     1329         end.
     1330         assign
     1331           v-diasize-wndstore = false
     1332         .
     1333         if connected("ub") = true
     1334         then do:
     1335           run gbl/wndpar_r.p
     1336             (input  v-cntxt-db-num
     1337             ,input  v-cntxt-userid
     1338             ,input  'wndstore':U
     1339             ,output v-diasize-wndstore
     1340             ,output v-default-value
     1341             ) .
     1342         end.
     1343         assign
     1344           v-diasize-proc-name = entry(1, program-name(2), '.')
     1345         .
     1346         if v-diasize-wndstore = true
     1347         then do:
     1348           assign
     1349             v-restore-saved = false
     1350           .
     1351           if connected("ub") = true
     1352           then do:
     1353             run gbl/wndsizer.p
     1354               (input  v-cntxt-db-num
     1355               ,input  v-cntxt-userid
     1356               ,input  v-diasize-proc-name
     1357               ,input  'height':u
     1358               ,output v-resize-value-str
     1359               ) .
     1360             if v-resize-value-str <> '':U
     1361             then do:
     1362               run diasize_change-height in this-procedure
     1363                 (input  integer(v-resize-value-str)
     1364                 ,input  true
     1365                 ) .
     1366               assign
     1367                 v-restore-saved = true
     1368               .
     1369             end.
     1370           end.
     1371           if connected("ub") = true
     1372           then do:
     1373             run gbl/wndsizer.p
     1374               (input  v-cntxt-db-num
     1375               ,input  v-cntxt-userid
     1376               ,input  v-diasize-proc-name
     1377               ,input  'width':u
     1378               ,output v-resize-value-str
     1379               ) .
     1380             if v-resize-value-str <> '':U
     1381             then do:
     1382               run diasize_change-width in this-procedure
     1383                 (input  integer(v-resize-value-str)
     1384                 ,input  true
     1385                 ) .
     1386               assign
     1387                 v-restore-saved = true
     1388               .
     1389             end.
     1390           end.
     1391           if v-restore-saved <> true
     1392           then do:
     1393             if v-diasize-wndmax = true
     1394             then do:
     1395               run diasize_maximize in this-procedure
     1396                 (input  true
     1397                 ) .
     1398             end.
     1399           end.
     1400         end.
     1401         else do:
     1402           if v-diasize-wndmax = true
     1403           then do:
     1404             run diasize_maximize in this-procedure
     1405               (input  true
     1406               ) .
     1407           end.
     1408         end.
     1409       end.
     1410     end.
     1411   end procedure.
     1412   procedure diasize_need-full-display :
     1413     define output parameter p-need-full-display as logical   no-undo .
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417       assign
     1418         p-need-full-display = v-diasize-need-full-display
     1419       .
     1420       assign
     1421         v-diasize-need-full-display = false
     1422       .
     1423     end.
     1424   end procedure.
     1425   procedure get-context :
     1426      define output parameter p-db-num as integer          no-undo.
     1427      define output parameter p-user-id as character        no-undo.
     1428      define variable v-login               as character    no-undo.
     1429      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1430      define buffer buf_user-login  for ub.user-login .
     1431      do
     1432      on error undo, return error
     1433      :
     1434            FIND FIRST buf_sys-ctrl no-lock.
     1435            ASSIGN
     1436               v-login = USERID("ub")
     1437               p-db-num = buf_sys-ctrl.db-num
     1438            .
     1439            FIND FIRST buf_user-login
     1440                 WHERE buf_user-login.db-num = p-db-num
     1441                   AND buf_user-login.user-login = v-login
     1442                 no-lock
     1443                 no-error
     1444                 .
     1445            IF AVAILABLE buf_user-login
     1446            THEN DO:
     1447               assign
     1448                  p-user-id = buf_user-login.user-id
     1449               .
     1450            END.
     1451      end.
     1452   end procedure.
     1453       run diasize_init in this-procedure .
     1454   define buffer buf_gds-prt for ub.gds-prt .
     1455   find first buf_gds-prt no-lock
     1456     where buf_gds-prt.node-code = p-node-code
     1457     .
     1458   assign
     1459     v-upper-code  = buf_gds-prt.upper-code
     1460     fi-scale-name = buf_gds-prt.node-name
     1461   .
     1462   MAIN-BLOCK:
     1463   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1464      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1465     RUN enable_UI.
     1466     WAIT-FOR GO OF FRAME Dialog-Frame.
     1467   END.
     1468   RUN disable_UI.
     1469   PROCEDURE disable_UI :
     1470     HIDE FRAME Dialog-Frame.
     1471   END PROCEDURE.
     1472   PROCEDURE enable_UI :
     1473     DISPLAY fi-scale-name
     1474         WITH FRAME Dialog-Frame.
     1475     ENABLE b-exit b-sel b-help BROWSE-level BROWSE-prt fi-scale-name
     1476         WITH FRAME Dialog-Frame.
     1477     VIEW FRAME Dialog-Frame.
     1478     OPEN QUERY BROWSE-level FOR EACH X_lvl-name no-lock where X_lvl-name.upper-code = v-upper-code by X_lvl-name.level .    run open-query-gds-prt in this-procedure .
     1479   END PROCEDURE.
     1480   PROCEDURE open-query-gds-prt :
     1481     if available X_lvl-name
     1482     then do:
     1483       define buffer buf_gds-prt for ub.gds-prt .
     1484       define variable v-node-code as integer   no-undo .
     1485       assign
     1486         v-node-code = p-node-code
     1487       .
     1488       define variable v-ind as integer   no-undo .
     1489       do v-ind = 1 to X_lvl-name.level
     1490       :
     1491         find first buf_gds-prt no-lock
     1492           where buf_gds-prt.upper-code = v-node-code
     1493           .
     1494         assign
     1495           v-node-code = buf_gds-prt.node-code
     1496         .
     1497       end.
     1498       OPEN QUERY browse-prt FOR EACH X_gds-prt no-lock
     1499         where X_gds-prt.upper-code = v-node-code
     1500         by X_gds-prt.prt-num .
     1501     end.
     1502   END PROCEDURE.
