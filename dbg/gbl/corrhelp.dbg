        1   block-level on error undo, throw.
        2   define input  parameter h_current-procedure as handle    no-undo .
        3   define variable v-start-level as integer   no-undo .
        4   assign
        5     v-start-level = 2
        6   .
        7   define variable lok   as logical no-undo initial yes .
        8   define variable vss-revision    as character no-undo .
        9   define variable vss-author      as character no-undo .
       10   define variable vss-date        as character no-undo .
       11   define variable vss-workfile    as character no-undo .
       12   define variable vss-archive     as character no-undo .
       13   define variable vss-description as character no-undo .
       14   if valid-handle(h_current-procedure)
       15   and h_current-procedure :get-signature( 'vss-get-info':u ) <> ""
       16   then do:
       17     run vss-get-info in h_current-procedure
       18       (output vss-revision
       19       ,output vss-author
       20       ,output vss-date
       21       ,output vss-workfile
       22       ,output vss-archive
       23       ,output vss-description
       24       ).
       25   define variable v-workfile as character no-undo .
       26   v-workfile = entry ( 2 , vss-workfile ,":" ) .
       27   v-workfile = trim ( v-workfile , "$" ) .
       28   v-workfile = trim ( v-workfile  ) .
       29   v-workfile = trim ( v-workfile , ".w" ) .
       30   os-command no-wait VALUE( substitute('start winword.exe C:\HELP_15ver\&1.htm' , v-workfile )) .
       31   return .
       32   end.
       33   define variable level as integer no-undo .
       34   assign
       35     level = v-start-level
       36   .
       37   repeat while program-name(level) <> ?:
       38     message
       39       level program-name(level) skip
       40       view-as alert-box buttons ok-cancel update lok .
       41     if not lok then do:
       42       return no-apply .
       43     end.
       44     assign
       45       level = level + 1
       46     .
       47   end.
