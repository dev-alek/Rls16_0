        1   block-level on error undo, throw.
        2   define input  parameter c-p              as character no-undo.
        3   define output parameter flt-rec          as recid     no-undo .
        4   define output parameter filter-name      as character no-undo .
        5   define output parameter where-phrase     as character no-undo .
        6   define output parameter sort-phrase      as character no-undo .
        7   define output parameter where-phrase-rus as character no-undo .
        8   define output parameter sort-phrase-rus  as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: flt-get.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/flt-get.p $":U .
       14   define variable vss-description as character no-undo init "Получение текущего значение фильтра".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1',c-p)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable c-p-name                 as character no-undo .
       88   define variable v-enable-sorting         as logical   no-undo init yes.
       89   function octal-to-char returns character
       90     ( p-string as character ) :
       91     define variable v-asc     as integer no-undo .
       92     define variable v-new-asc as integer no-undo .
       93     define variable ind       as integer no-undo .
       94     if length(p-string) <> 3 then do:
       95       return ? .
       96     end.
       97     assign
       98       v-asc = 0
       99     .
      100     do ind = 1 to length(p-string)
      101     :
      102       assign
      103         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      104       .
      105       if v-new-asc < 0 or v-new-asc >= 8 then do:
      106         return ? .
      107       end.
      108       assign
      109         v-asc = v-asc * 8 + v-new-asc
      110       .
      111     end.
      112     return chr(v-asc) .
      113   end function .
      114   assign
      115     flt-rec = ?
      116   .
      117   if c-p = '':U then do:
      118     assign
      119       flt-rec      = ?
      120       filter-name  = ""
      121       where-phrase = ""
      122       sort-phrase  = ""
      123     .
      124   end.
      125   if num-entries(c-p, chr(4)) > 2 then do:
      126     assign
      127     v-enable-sorting = logical(entry(3, c-p, chr(4)))
      128     no-error
      129     .
      130   end.
      131   if num-entries(c-p, chr(4)) > 1 then do:
      132     assign
      133     c-p-name = entry(2, c-p, chr(4))
      134     c-p      = entry(1, c-p, chr(4))
      135     .
      136   end.
      137   find ubflt.usr-flt no-lock
      138     where ubflt.usr-flt.user-name  = g#userid
      139       and ubflt.usr-flt.call-point = c-p
      140     no-error.
      141   find ubflt.filter no-lock
      142     where ubflt.filter.call-point = ubflt.usr-flt.call-point
      143       and ubflt.filter.naim       = ubflt.usr-flt.naim
      144     no-error.
      145   if available ubflt.filter then do:
      146     assign
      147       flt-rec          = recid (ubflt.filter)
      148       filter-name      = ubflt.usr-flt.naim
      149       where-phrase     = ""
      150       sort-phrase      = ""
      151       where-phrase-rus = ""
      152       sort-phrase-rus  = ""
      153     .
      154     if num-entries(ubflt.filter.where-ysl) > 0 then do:
      155       assign
      156         where-phrase = where-phrase
      157                      + ' and ('
      158       .
      159       define variable ind as integer no-undo.
      160       do ind = 1 to num-entries(ubflt.filter.where-ysl):
      161         assign
      162           where-phrase = where-phrase
      163                       + " " + entry(ind, ubflt.filter.where-ysl)
      164         .
      165       end.
      166       assign
      167         where-phrase = where-phrase
      168                      + ')'
      169       .
      170     end.
      171     if num-entries(where-phrase, "^") > 1 then do:
      172       define variable v-new-where-phrase as character no-undo .
      173       assign
      174         v-new-where-phrase = entry(1, where-phrase, "^")
      175       .
      176       do ind = 2 to num-entries(where-phrase, "^")
      177       :
      178         define variable v-sub-phrase as character no-undo .
      179         assign
      180           v-sub-phrase = entry(ind, where-phrase, "^")
      181         .
      182         if octal-to-char(substring(v-sub-phrase, 1, 3)) <> ? then do:
      183           assign
      184             v-new-where-phrase = v-new-where-phrase
      185                               + octal-to-char(substring(v-sub-phrase, 1, 3))
      186                               + substring(v-sub-phrase, 4)
      187           .
      188         end.
      189         else do:
      190           assign
      191             v-new-where-phrase = v-new-where-phrase
      192                               + "^"
      193                               + v-sub-phrase
      194           .
      195         end.
      196       end.
      197       assign
      198         where-phrase = v-new-where-phrase
      199       .
      200     end.
      201     if v-enable-sorting then do:
      202       do ind = 1 to num-entries(ubflt.filter.fields-sort)
      203       :
      204         if entry(ind, ubflt.filter.fields-sort) <> "" then do:
      205           define variable num-sort as integer no-undo.
      206           do num-sort = 1 to num-entries( entry(ind, ubflt.filter.fields-sort), "*")
      207           :
      208             assign
      209               sort-phrase = sort-phrase
      210                           + " by "
      211                           + entry( num-sort , entry(ind, ubflt.filter.fields-sort), "*")
      212             .
      213             if entry(ind, ubflt.filter.lst-cend) = '1' then do:
      214               assign
      215                 sort-phrase = sort-phrase
      216                             + " descending"
      217               .
      218             end.
      219           end.
      220         end.
      221       end.
      222     end.
      223     assign
      224     where-phrase-rus = ubflt.filter.where-ysl-rus
      225     sort-phrase-rus  = (if v-enable-sorting then ubflt.filter.fields-sort-rus else "":U)
      226     .
      227   end.
      228   else do:
      229     assign
      230       flt-rec      = ?
      231       filter-name  = ""
      232       where-phrase = ""
      233       sort-phrase  = ""
      234     .
      235   end.
