        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define input  parameter p-dm-menu-handle    as widget-handle no-undo .
        4   define input  parameter p-menu-code         as integer   no-undo .
        5   define input  parameter p-db-num            as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 3ac8d1d44d52, 3383, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        8   define variable vss-date        as character no-undo init "$Date: 2023/05/31 09:28:12 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: menu-upd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/menu-upd.p $":U .
       11   define variable vss-description as character no-undo init "Проверка необходимости загрузки меню и загрузка меню".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   function diff-list returns character (
       73     input parfirst-list  as character,
       74     input parsecond-list as character,
       75     input pardelim       as character).
       76     if pardelim = ""
       77     or pardelim = ?
       78     then do:
       79       assign
       80         pardelim = ","
       81       .
       82     end.
       83     def var ind as integer no-undo .
       84     def var v-elem as character no-undo .
       85     def var v-result-list as character no-undo init "".
       86     def var v-num-parfirst-list as integer no-undo .
       87     assign
       88       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
       89     .
       90     do ind = 1 to v-num-parfirst-list
       91     :
       92       assign
       93         v-elem = entry(ind, parfirst-list, pardelim)
       94       .
       95       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
       96         assign
       97           v-result-list = v-result-list
       98                         + (if v-result-list > "" then pardelim else "")
       99                         + v-elem
      100         .
      101       end.
      102     end.
      103     return v-result-list .
      104   end function.
      105   function add-list returns character (
      106    input parfirst-list  as character,
      107    input parsecond-list as character,
      108    input pardelim       as character).
      109     if pardelim = ""
      110     or pardelim = ?
      111     then do:
      112       assign
      113         pardelim = ","
      114       .
      115     end.
      116     def var ind as integer no-undo .
      117     def var v-elem as character no-undo .
      118     def var v-result-list as character no-undo init "".
      119     def var v-num-parfirst-list as integer no-undo .
      120     assign
      121       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      122     .
      123     do ind = 1 to v-num-parfirst-list
      124     :
      125       assign
      126         v-elem = entry(ind, parfirst-list, pardelim)
      127       .
      128       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      129         assign
      130           v-result-list = v-result-list
      131                         + (if v-result-list > "" then pardelim else "")
      132                         + v-elem
      133         .
      134       end.
      135     end.
      136     def var v-num-parsecond-list as integer no-undo .
      137     assign
      138       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      139     .
      140     do ind = 1 to v-num-parsecond-list
      141     :
      142       assign
      143         v-elem = entry(ind, parsecond-list, pardelim)
      144       .
      145       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      146         assign
      147           v-result-list = v-result-list
      148                         + (if v-result-list > "" then pardelim else "")
      149                         + v-elem
      150         .
      151       end.
      152     end.
      153     return v-result-list .
      154   end function.
      155   function cross-list returns character (
      156    input parfirst-list  as character,
      157    input parsecond-list as character,
      158    input pardelim       as character).
      159     if pardelim = ""
      160     or pardelim = ?
      161     then do:
      162       assign
      163         pardelim = ","
      164       .
      165     end.
      166     def var ind as integer no-undo .
      167     def var v-elem as character no-undo .
      168     def var v-result-list as character no-undo init "".
      169     def var v-num-parfirst-list as integer no-undo .
      170     assign
      171       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      172     .
      173     do ind = 1 to v-num-parfirst-list
      174     :
      175       assign
      176         v-elem = entry(ind, parfirst-list, pardelim)
      177       .
      178       if lookup(v-elem, v-result-list, pardelim) = 0
      179       and lookup(v-elem, parsecond-list, pardelim) > 0
      180       then do:
      181         assign
      182           v-result-list = v-result-list
      183                         + (if v-result-list > "" then pardelim else "")
      184                         + v-elem
      185         .
      186       end.
      187     end.
      188     return v-result-list .
      189   end function.
      190   function radio-label returns character (
      191    input par-rs-value  as character,
      192    input par-rs-radio-buttons as character)
      193    .
      194    DEFINE variable v-result-label as character no-undo.
      195    assign
      196    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      197                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      198                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      199                             ), par-rs-radio-buttons
      200                           )
      201    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      202    .
      203   return v-result-label.
      204   end function.
      205   function m-radio-label returns character (
      206    input par-rs-value  as character,
      207    input par-rs-radio-buttons as character,
      208    input par-delim as character
      209    )
      210    .
      211    DEFINE variable v-result-label as character no-undo.
      212    assign
      213    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      214                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      215                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      216                             ), par-rs-radio-buttons, par-delim
      217                           )
      218    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      219    .
      220   return v-result-label.
      221   end function.
      222   FUNCTION mixlist returns character
      223   (
      224    input parfirst-list  as character
      225    ,input parsecond-list as character
      226    ,input pardelim       as character
      227    ,input pardelim-result as character ) :
      228     if pardelim = ""
      229     or pardelim = ?
      230     then do:
      231       assign
      232         pardelim = ","
      233       .
      234     end.
      235     def var ind as integer no-undo .
      236     def var v-elem1 as character no-undo .
      237     def var v-elem2 as character no-undo .
      238     def var v-result-list as character no-undo init "".
      239     do ind = 1 to num-entries(parfirst-list, pardelim)
      240     :
      241       assign
      242         v-elem1 = entry(ind, parfirst-list, pardelim)
      243         v-elem2 = entry(ind, parsecond-list, pardelim)
      244       .
      245         assign
      246           v-result-list = v-result-list
      247                         + (if v-result-list > "" then pardelim-result else "")
      248                         + v-elem1 + pardelim-result + v-elem2
      249         .
      250     end.
      251     return v-result-list .
      252   END FUNCTION.
      253   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      254   define variable v-waitfram-action01         as character   no-undo .
      255   define variable v-waitfram-action02         as character   no-undo .
      256   define variable v-waitfram-action03         as character   no-undo .
      257   define variable mWaitFramTextBeg            as character   no-undo.
      258   define variable mWaitFramTextEnd            as character   no-undo.
      259   define variable mWaitFramView               as logical     no-undo.
      260   define variable mWaitProcEvent              as logical     no-undo init yes.
      261   define variable mWaitFramInterval           as integer     no-undo init 1 .
      262   define variable mWaitFramStop               as logical     no-undo.
      263   define variable mWaitFramStopUser           as logical     no-undo.
      264   define variable mWaitFramStopTimeOut        as logical     no-undo.
      265   define variable mWaitFramStartProc          as datetime-tz no-undo.
      266   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      267   define button B-WaitFramStop auto-end-key
      268        label "Стоп"
      269        size 10 by 1 tooltip "Остоновить процесс".
      270   define button B-viewProcInfo
      271        label "Информация"
      272        size 15 by 1 tooltip "Информация о процесс".
      273   define frame waitfram
      274     v-waitfram-action01 format "x(72)" no-label skip
      275     v-waitfram-action02 format "x(72)" no-label skip
      276     v-waitfram-action03 format "x(72)" no-label skip
      277     B-viewProcInfo
      278     B-WaitFramStop at row 4 col 30
      279     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      280     .
      281   define new global shared variable mBatchMode as logical no-undo init ?.
      282   define variable mFramBachModHandle as handle no-undo.
      283   mFramBachModHandle = frame waitfram:handle.
      284   define variable mFameOldVis as logical no-undo.
      285   define variable mVisCUrentVin as logical no-undo.
      286   if session:batch-mode
      287   then
      288      mBatchMode = yes.
      289   if mBatchMode = ? then do:
      290     mVisCUrentVin = current-window:visible.
      291     mFameOldVis = mFramBachModHandle:visible.
      292     mFramBachModHandle:visible  = yes.
      293     mBatchMode = mFramBachModHandle:visible ne yes.
      294     mFramBachModHandle:visible = mFameOldVis.
      295     current-window:visible = mVisCUrentVin.
      296   end.
      297    if  log-manager:logfile-name ne ?
      298     then DO:
      299         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      300         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      301         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      302     end.
      303   on choose of B-WaitFramStop in frame waitfram
      304   do:
      305     mWaitFramStop = yes.
      306     mWaitFramStopUser = yes.
      307   end.
      308   function waitfram-check-timeout returns logical():
      309      define variable vtime as int64 no-undo.
      310      if mWaitFramStopTimeOut
      311      then
      312         return yes.
      313      vtime = ( now - mWaitFramStartProc ) / 1000 .
      314      if     mWaitFramTimeOut ne ?
      315         and mWaitFramTimeOut ne 0
      316         and mWaitFramTimeOut lt vtime
      317      then do:
      318         mWaitFramStopTimeOut = yes.
      319      end.
      320      return mWaitFramStopTimeOut.
      321   end.
      322   procedure waitfram-hide :
      323     if not session:batch-mode
      324     then do
      325     on error undo, return error return-value
      326     :
      327       pause 0 before-hide .
      328       if not mBatchMode then
      329         hide frame waitfram .
      330     if     not mWaitFramView
      331        and mWaitProcEvent
      332     then
      333       process events .
      334     end.
      335   end procedure.
      336   procedure waitfram-show :
      337     define input  parameter p-message as character no-undo .
      338     define variable v-left-margin as integer   no-undo .
      339     if not session:batch-mode
      340     then do
      341     on error undo, return error return-value
      342     :
      343       if length(p-message) <= 70 then do:
      344         assign
      345           v-left-margin = integer((70 - length(p-message)) / 2)
      346         .
      347         assign
      348           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      349         .
      350         assign
      351           v-waitfram-action01 = " "
      352           v-waitfram-action02 = " "
      353                                    + fill(" ", v-left-margin)
      354                                    + p-message
      355           v-waitfram-action03 = " "
      356         .
      357       end.
      358       else do:
      359         define variable vRindex1 as integer no-undo.
      360         define variable vRindex2 as integer no-undo.
      361         vRindex1 = r-index(p-message," ",70).
      362         if vRindex1 = 0
      363         then
      364            vRindex1 = 70.
      365         if length(p-message)  <= vRindex1 + 70 then do:
      366           assign
      367             v-waitfram-action01 = " "
      368             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      369             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      370           .
      371         end.
      372         else do:
      373           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      374           if vRindex2 <= vRindex1
      375           then
      376              vRindex2 = vRindex1 + 70.
      377           assign
      378             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      379             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      380             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      381           .
      382         end.
      383       end.
      384       B-viewProcInfo:visible   in frame waitfram = no.
      385       B-viewProcInfo:sensitive in frame waitfram = no.
      386       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      387       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      388       if  (   mWaitFramView
      389          or  mWaitProcEvent)
      390          and not mBatchMode
      391       then
      392          display
      393             v-waitfram-action01 skip
      394             v-waitfram-action02 skip
      395             v-waitfram-action03 skip
      396          with frame waitfram .
      397       if     mWaitFramView
      398          then do:
      399             if     mWaitFramInterval ne ?
      400                and not mBatchMode
      401             then
      402                wait-for go of frame waitfram pause mWaitFramInterval.
      403          end.
      404          else
      405             if     mWaitProcEvent
      406                and not mBatchMode
      407             then
      408                process events .
      409     end.
      410   end procedure.
      411      procedure waitfram-show-this:
      412         define input  parameter iInterval as int64 no-undo.
      413         define variable vtime as int64 no-undo.
      414         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      415         mWaitFramInterval = iInterval.
      416         run waitfram-show (substitute("&1&2 &3&4" ,
      417                                       mWaitFramTextBeg ,
      418                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      419                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      420                                       mWaitFramTextEnd
      421                                      )
      422                           ).
      423      end.
      424      procedure WaitFramRunPause:
      425         define input  parameter iInterval as dec no-undo.
      426         define variable vStart  as datetime-tz no-undo.
      427         define variable vend    as datetime-tz no-undo.
      428         define variable vint as int64 no-undo.
      429         define variable vOk as logical no-undo.
      430         vStart = now.
      431         vend   = vStart.
      432         publish "WaitFramPause" (iInterval,output vOk).
      433         vend   =  now.
      434         vint = vend - vStart.
      435         vint = iInterval - vint / 1000.
      436         if     not mWaitFramStop
      437            and (   vint > 0
      438                 or (    not vOk
      439                     and iInterval eq ?
      440                     )
      441                 )
      442         then
      443            run waitfram-show-this (iInterval).
      444         vend   =  now.
      445         vint = vend - vStart.
      446         vint = iInterval - vint / 1000.
      447         if     not mWaitFramStop
      448            and vint > 0
      449         then do:
      450            run gbl/pause.p (vint * 1000).
      451         end.
      452         if iInterval ne ?
      453         then
      454            publish "WaitFramStop".
      455         waitfram-check-timeout().
      456      end.
      457      procedure WaitFramWaitFor:
      458         define input  parameter iInterval as dec no-undo.
      459         assign
      460            mWaitFramStartProc   = now
      461            mWaitFramStopUser    = no
      462            mWaitFramStopTimeOut = no
      463         .
      464         block-wait:
      465         do while not mWaitFramStop:
      466            run WaitFramRunPause (iInterval).
      467            if  waitfram-check-timeout()
      468            then do:
      469               leave block-wait.
      470            end.
      471         end.
      472         run waitfram-hide.
      473      end.
      474   procedure waitfram-join :
      475     define input  parameter p-line-1  as character no-undo .
      476     define input  parameter p-line-2  as character no-undo .
      477     define input  parameter p-line-3  as character no-undo .
      478     define output parameter p-message as character no-undo .
      479     do
      480     on error undo, return error return-value
      481     :
      482       assign
      483         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      484                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      485                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      486       .
      487     end.
      488   end procedure.
      489   function waitfram-join-function returns character
      490     (input p-line-1 as character
      491     ,input p-line-2 as character
      492     ,input p-line-3 as character
      493     ).
      494     define variable v-message as character no-undo .
      495     run waitfram-join in this-procedure
      496       (input  p-line-1
      497       ,input  p-line-2
      498       ,input  p-line-3
      499       ,output v-message
      500       ) .
      501     return v-message .
      502   end function .
      503   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   procedure get-ro_get-read-only :
      505     define output parameter p-ro-set as logical   no-undo .
      506     do
      507     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info1, return-value, error-status :get-message( 1 ) )
      508     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info1 )
      509     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info1 )
      510     :
      511       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      512       then do:
      513         assign
      514           p-ro-set = true
      515         .
      516       end.
      517       else do:
      518         assign
      519           p-ro-set = false
      520         .
      521       end.
      522     end.
      523   end procedure.
