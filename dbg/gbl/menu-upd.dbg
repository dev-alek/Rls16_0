      564     .
      565   define stream sinp .
      566   define variable v-valid-menu-group-id-list as character no-undo .
      567   do
      568   on error undo, return error return-value
      569   :
      570     run check-menu-item in this-procedure .
      571   end.
      572   procedure check-menu-item :
      573     define variable v-db-control-number   as character no-undo .
      574     define variable v-menu-file-name      as character no-undo .
      575     define variable v-file-control-number as character no-undo .
      576     define variable v-sys-key             as character no-undo .
      577     define variable v-get-ro_read-only    as logical   no-undo .
      578     define buffer buf_menu-head for ub.menu-head .
      579     do
      580     on error undo, return error return-value
      581     :
      582       run get-db-control-number in this-procedure
      583         (output v-db-control-number
      584         ) .
      585       run get-menu-file-name in this-procedure
      586         (output v-menu-file-name
      587         ) .
      588       if v-menu-file-name = ""
      589       or v-menu-file-name = ?
      590       then do:
      591         message
      592           vss-workfile vss-revision vss-description skip
      593           "Не найден файл с описание меню" "cmp/menu.enc" skip
      594           "Работа системы будет продолжена, но возможно некоторые пункты меню" skip
      595           "работать не будут" skip
      596           view-as alert-box error .
      597         return .
      598       end.
      599       run get-file-control-number in this-procedure
      600         (input  v-menu-file-name
      601         ,output v-file-control-number
      602         ) .
      603       if v-db-control-number <> v-file-control-number
      604       then do:
      605         assign
      606           v-get-ro_read-only = false
      607         .
      608         run get-ro_get-read-only in this-procedure
      609           ( output v-get-ro_read-only
      610           ) .
      611         if v-get-ro_read-only = false then do:
      612   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      614     (output v-sys-key
      615     ) no-error .
      616           if v-sys-key = 'ExpertekIBS':U
      617           then do:
      618             define variable v-ok as logical   no-undo .
      619             message
      620               "Описание пунктов меню изменилось" skip
      621               "Контрольный номер в базе данных" v-db-control-number skip
      622               "Контрольный номер в файле" v-file-control-number skip
      623               "Путь к файлу" v-menu-file-name skip
      624               "Загрузить в базу данных описание пунктов меню?"
      625               view-as alert-box question buttons yes-no update v-ok .
      626             if v-ok <> true
      627             then do:
      628               return .
      629             end.
      630           end.
      631           run lock-menu-head in this-procedure
      632             (buffer buf_menu-head
      633             ) .
      634           if buf_menu-head.control-number = v-file-control-number
      635           then do:
      636             return .
      637           end.
      638           run read-menu-item in this-procedure
      639             (input v-menu-file-name
      640             ) .
      641           run filter-configuration-menu-group in this-procedure
      642             .
      643           run filter-configuration-menu-item in this-procedure
      644             .
      645           run filter-configuration-sub-menu in this-procedure
      646             .
      647           run set-db-code-menu-item in this-procedure
      648             .
      649           run set-parent-code-menu-item in this-procedure
      650             .
      651           run calculate-menu-item-group in this-procedure
      652             .
      653           run validate-menu-item in this-procedure
      654             no-error .
      655           if  error-status :error
      656           then do:
      657             if v-sys-key = 'ExpertekIBS':U
      658             then do:
      659               assign
      660                 v-ok = false
      661               .
      662               message
      663                 "При проверке описания меню были обнаружены ошибки" skip
      664                 "Загрузить в базу данных описание пунктов меню?"
      665                 view-as alert-box question buttons yes-no update v-ok .
      666               if v-ok <> true
      667               then do:
      668                 return .
      669               end.
      670             end.
      671             else do:
      672               message
      673                 vss-workfile vss-revision vss-description skip
      674                 "При проверке пунктов меню были обнаружены ошибки" skip
      675                 "Меню не было загружено" skip
      676                 error-status :get-message(1) skip
      677                 return-value skip
      678                 view-as alert-box error .
      679               return .
      680             end.
      681           end.
      682           do transaction
      683           on error undo, return error return-value
      684           :
      685             run clear-menu in this-procedure .
      686             run write-menu in this-procedure .
      687             run update-user-menu-group in this-procedure .
      688             assign
      689               buf_menu-head.control-number = v-file-control-number
      690             .
      691           end.
      692         end.
      693         else do:
      694           message
      695             vss-workfile vss-revision vss-description skip(1)
      696             substitute("Описание пунктов меню изменилось") skip
      697             substitute("До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!") skip
      698             view-as alert-box error .
      699           return error .
      700         end.
      701       end.
      702       run waitfram-hide in this-procedure .
      703     end.
      704   end procedure.
      705   procedure get-db-control-number :
      706     define output parameter p-db-control-number as character no-undo .
      707     define buffer buf_menu-head for ub.menu-head .
      708     do
      709     on error undo, return error return-value
      710     :
      711       find first buf_menu-head no-lock
      712         where buf_menu-head.menu-code = p-menu-code
      713         no-error .
      714       if available buf_menu-head
      715       then do:
      716         assign
      717           p-db-control-number = buf_menu-head.control-number
      718         .
      719       end.
      720       else do:
      721         assign
      722           p-db-control-number = '':u
      723         .
      724       end.
      725     end.
      726   end procedure.
      727   procedure get-menu-file-name :
      728     define output parameter p-menu-file-name as character no-undo .
      729     do
      730     on error undo, return error return-value
      731     :
      732       assign
      733         p-menu-file-name = search("cmp/menu.enc")
      734       .
      735     end.
      736   end procedure.
      737   procedure get-file-control-number :
      738     define input  parameter p-menu-file-name      as character no-undo .
      739     define output parameter p-file-control-number as character no-undo .
      740     define variable v-str-encrypt        as character no-undo .
      741     do
      742     on error undo, return error return-value
      743     :
      744       SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      745       input stream sinp from value(p-menu-file-name) .
      746       import stream sinp UNFORMATTED v-str-encrypt .
      747   define variable vss-include-info3 as character format "X(65)" no-undo
      748   initial "@(#)$Workfile$ $Revision$".
      749   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      750     (input  v-str-encrypt
      751     ,output p-file-control-number
      752     )  .
      753       ASSIGN
      754          p-file-control-number = TRIM(p-file-control-number, '~" ')
      755       .
      756       input stream sinp close .
      757     end.
      758   end procedure.
      759   procedure lock-menu-head :
      760     define parameter buffer buf_menu-head for ub.menu-head .
      761     define variable v-load    as logical      no-undo.
      762     do
      763     on error undo, return error return-value
      764     :
      765       find first buf_menu-head exclusive-lock
      766         where buf_menu-head.menu-code = p-menu-code
      767         no-error
      768         no-wait
      769         .
      770       if not available buf_menu-head
      771       then do:
      772         IF locked buf_menu-head then do:
      773            message
      774               "Производится загрузка меню другим пользователем." SKIP
      775               "Для корректной работы системы необходимо подождать."
      776            view-as alert-box.
      777            run waitfram-show in this-procedure ( input "Происходит загрузка меню. Ждите..." ).
      778            REPEAT :
      779               find first buf_menu-head
      780                  where buf_menu-head.menu-code = p-menu-code
      781                  exclusive-lock
      782                  no-error
      783                  no-wait
      784                  .
      785               IF AVAILABLE buf_menu-head THEN DO:
      786                  run waitfram-hide in this-procedure .
      787                  RETURN.
      788               END.
      789               pause 10 no-message.
      790            END.
      791         end.
      792         create buf_menu-head .
      793         assign
      794           buf_menu-head.menu-code      = p-menu-code
      795           buf_menu-head.menu-name      = "Системное меню"
      796           buf_menu-head.control-number = ""
      797         .
      798       end.
      799     end.
      800   end procedure.
      801   procedure read-menu-item :
      802     define input  parameter p-menu-file-name as character no-undo .
      803     define buffer buf_menu-head       for ub.menu-head .
      804     define buffer buf_menu-item       for ub.menu-item .
      805     define buffer buf_temp-menu-group for temp-menu-group .
      806     define buffer buf_temp-menu-item  for temp-menu-item .
      807     define variable v-control-number     as character no-undo .
      808     define variable v-file-item-code     as integer   no-undo .
      809     define variable v-item-type          as character no-undo .
      810     define variable v-item-name          as character no-undo .
      811     define variable v-item-procedure     as character no-undo .
      812     define variable v-item-id            as character no-undo .
      813     define variable v-parent-id          as character no-undo .
      814     define variable v-item-condition     as character no-undo .
      815     define variable v-item-context       as character no-undo .
      816     define variable v-item-configuration as character no-undo .
      817     define variable v-item-group-id      as character no-undo .
      818     define variable v-action-item-id     as character no-undo .
      819     define variable v-item-encoded       as character no-undo .
      820     define variable v-str-encrypt        as character no-undo .
      821     define variable v-str-decrypt        as character no-undo .
      822     do
      823     on error undo, return error return-value
      824     :
      825       input stream sinp from value(p-menu-file-name) .
      826       ASSIGN
      827          v-str-encrypt    = '':U
      828          v-control-number = '':U
      829       .
      830       import stream sinp UNFORMATTED v-str-encrypt .
      831   define variable vss-include-info4 as character format "X(65)" no-undo
      832   initial "@(#)$Workfile$ $Revision$".
      833   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      834     (input  v-str-encrypt
      835     ,output v-control-number
      836     )  .
      837       ASSIGN
      838          v-control-number = TRIM(v-control-number, '~" ')
      839       .
      840       define variable v-tag-name                 as character no-undo .
      841       define variable v-menu-group-code          as integer   no-undo .
      842       define variable v-menu-group-id            as character no-undo .
      843       define variable v-menu-group-name          as character no-undo .
      844       define variable v-menu-group-description   as character no-undo .
      845       define variable v-menu-group-licence-param as character no-undo .
      846       define variable v-button-image-name        as character no-undo .
      847       define variable v-menu-group-configuration as character no-undo .
      848       define variable v-menu-group-procedure     as character no-undo .
      849       assign
      850         v-menu-group-code          = 0
      851         v-valid-menu-group-id-list = '':U
      852       .
      853       read_menu_group:
      854       repeat
      855       :
      856         assign
      857           v-tag-name = '':u
      858           v-str-encrypt            = '':U
      859         .
      860         import stream sinp UNFORMATTED v-str-encrypt .
      861   define variable vss-include-info5 as character format "X(65)" no-undo
      862   initial "@(#)$Workfile$ $Revision$".
      863   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      864     (input  v-str-encrypt
      865     ,output v-tag-name
      866     )  .
      867         ASSIGN
      868            v-tag-name = TRIM(v-tag-name, '~" ')
      869         .
      870         if v-tag-name = 'menu-group':u
      871         then do:
      872           assign
      873             v-menu-group-code          = v-menu-group-code + 1
      874             v-menu-group-id            = '':u
      875             v-menu-group-name          = '':u
      876             v-menu-group-description   = '':u
      877             v-menu-group-licence-param = '':U
      878             v-button-image-name        = '':u
      879             v-menu-group-configuration = '':U
      880             v-menu-group-procedure     = '':U
      881             v-str-encrypt              = '':U
      882           .
      883           import stream sinp UNFORMATTED v-str-encrypt .
      884   define variable vss-include-info6 as character format "X(65)" no-undo
      885   initial "@(#)$Workfile$ $Revision$".
      886   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      887     (input  v-str-encrypt
      888     ,output v-str-decrypt
      889     )  .
      890           ASSIGN
      891             v-menu-group-id            = TRIM(SUBSTRING(v-str-decrypt, 1  ,  6), '~" ')
      892             v-menu-group-name          = TRIM(SUBSTRING(v-str-decrypt, 7  , 25), '~" ')
      893             v-menu-group-description   = TRIM(SUBSTRING(v-str-decrypt, 32 , 49), '~" ')
      894             v-menu-group-licence-param = TRIM(SUBSTRING(v-str-decrypt, 81 , 14), '~" ')
      895             v-button-image-name        = TRIM(SUBSTRING(v-str-decrypt, 95 , 33), '~" ')
      896             v-menu-group-configuration = TRIM(SUBSTRING(v-str-decrypt, 128, 22), '~" ')
      897             v-menu-group-procedure     = TRIM(SUBSTRING(v-str-decrypt, 150, 20), '~" ')
      898           .
      899           create buf_temp-menu-group .
      900           assign
      901             buf_temp-menu-group.menu-group-code          = v-menu-group-code
      902             buf_temp-menu-group.menu-group-id            = v-menu-group-id
      903             buf_temp-menu-group.menu-group-name          = v-menu-group-name
      904             buf_temp-menu-group.menu-group-description   = v-menu-group-description
      905             buf_temp-menu-group.menu-group-licence-param = v-menu-group-licence-param
      906             buf_temp-menu-group.button-image-name        = v-button-image-name
      907             buf_temp-menu-group.menu-group-configuration = v-menu-group-configuration
      908             buf_temp-menu-group.menu-group-procedure     = v-menu-group-procedure
      909           .
      910           assign
      911             v-valid-menu-group-id-list = v-valid-menu-group-id-list
      912                                        + (if v-valid-menu-group-id-list <> '':U then ',':U else '':U)
      913                                        + v-menu-group-id
      914           .
      915         end.
      916         if v-tag-name = 'menu-item':u
      917         then do:
      918           leave read_menu_group .
      919         end.
      920       end.
      921       assign
      922         v-file-item-code = 0
      923       .
      924       read_menu_item:
      925       repeat
      926       :
      927         assign
      928           v-file-item-code     = v-file-item-code + 1
      929           v-item-type          = '':u
      930           v-item-name          = '':u
      931           v-item-procedure     = '':u
      932           v-item-id            = '':u
      933           v-parent-id          = '':u
      934           v-item-condition     = '':u
      935           v-item-context       = '':u
      936           v-item-configuration = '':u
      937           v-item-group-id      = '':u
      938           v-action-item-id     = '':U
      939           v-item-encoded       = '':u
      940           v-str-encrypt        = '':U
      941         .
      942         if v-file-item-code modulo 10 = 0
      943         then do:
      944           run waitfram-show in this-procedure
      945             (input substitute("Обновление меню. Чтение описания меню из файла &1"
      946                             ,v-file-item-code
      947                             )
      948             ) .
      949         end.
      950         import stream sinp UNFORMATTED v-str-encrypt .
      951   define variable vss-include-info7 as character format "X(65)" no-undo
      952   initial "@(#)$Workfile$ $Revision$".
      953   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      954     (input  v-str-encrypt
      955     ,output v-str-decrypt
      956     )  .
      957         ASSIGN
      958           v-item-type          = TRIM(SUBSTRING(v-str-decrypt, 1  ,  4), '~" ')
      959           v-item-name          = TRIM(SUBSTRING(v-str-decrypt, 5  , 57), '~" ')
      960           v-item-procedure     = TRIM(SUBSTRING(v-str-decrypt, 62 , 63), '~" ')
      961           v-item-id            = TRIM(SUBSTRING(v-str-decrypt, 125, 27), '~" ')
      962           v-parent-id          = TRIM(SUBSTRING(v-str-decrypt, 152, 27), '~" ')
      963           v-item-condition     = TRIM(SUBSTRING(v-str-decrypt, 179, 66), '~" ')
      964           v-item-context       = TRIM(SUBSTRING(v-str-decrypt, 245, 10), '~" ')
      965           v-item-configuration = TRIM(SUBSTRING(v-str-decrypt, 255, 81), '~" ')
      966           v-item-group-id      = TRIM(SUBSTRING(v-str-decrypt, 336, 43), '~" ')
      967           v-action-item-id     = TRIM(SUBSTRING(v-str-decrypt, 379, 4 ), '~" ')
      968           v-item-encoded       = TRIM(SUBSTRING(v-str-decrypt, 383, 2 ), '~" ')
      969         .
      970         IF v-item-type = 'x-i':u
      971         THEN DO:
      972            NEXT read_menu_item.
      973         END.
      974         assign
      975           v-item-name = replace(v-item-name, "~{&abbr_rublyah~}", "рублях")
      976         .
      977         if lookup('~{&', v-item-name) > 0
      978         then do:
      979           message
      980             vss-workfile vss-revision vss-description skip
      981             "В меню задан препроцессинг для которого не указан способ обработки" skip
      982             "Идентификатор пункта" v-item-id skip
      983             "Имя пункта" v-item-name skip
      984             view-as alert-box error .
      985         end.
      986         if v-item-type <> 'r-l':u
      987         then do:
      988           find first buf_temp-menu-item
      989             where buf_temp-menu-item.item-id   = v-item-id
      990             no-error .
      991           if available buf_temp-menu-item
      992           then do:
      993             message
      994               vss-workfile vss-revision vss-description skip
      995               "Ошибка при задании пункта меню" skip
      996               "Уже создан пункт меню с таким же именем" v-item-id skip
      997               "item-type"          v-item-type          skip
      998               "item-name"          v-item-name          skip
      999               "item-procedure"     v-item-procedure     skip
     1000               "item-id"            v-item-id            skip
     1001               "parent-id"          v-parent-id          skip
     1002               "item-condition"     v-item-condition     skip
     1003               "item-context"       v-item-context       skip
     1004               "item-configuration" v-item-configuration skip
     1005               "item-group-id"      v-item-group-id      skip
     1006               "item-encoded"       v-item-encoded       skip
     1007               view-as alert-box error .
     1008           end.
     1009         end.
     1010         create buf_temp-menu-item .
     1011         assign
     1012           buf_temp-menu-item.file-item-code     = v-file-item-code
     1013           buf_temp-menu-item.item-type          = v-item-type
     1014           buf_temp-menu-item.item-name          = v-item-name
     1015           buf_temp-menu-item.item-procedure     = v-item-procedure
     1016           buf_temp-menu-item.item-id            = v-item-id
     1017           buf_temp-menu-item.parent-id          = v-parent-id
     1018           buf_temp-menu-item.parent-code        = 0
     1019           buf_temp-menu-item.item-condition     = v-item-condition
     1020           buf_temp-menu-item.item-context       = v-item-context
     1021           buf_temp-menu-item.item-configuration = v-item-configuration
     1022           buf_temp-menu-item.item-group-id      = v-item-group-id
     1023           buf_temp-menu-item.item-encoded       = v-item-encoded
     1024         .
     1025       end.
     1026       input stream sinp close .
     1027     end.
     1028   end procedure.
     1029   procedure export-menu-item :
     1030     define buffer buf_menu-item for ub.menu-item .
     1031     define buffer buf_menu-item-group for ub.menu-item-group .
     1032     do
     1033     on error undo, return error return-value
     1034     :
     1035       output to value('menu-export.txt':u) .
     1036       for each buf_menu-item
     1037       on error undo, return error return-value
     1038       :
     1039         export "menu-item" .
     1040         export buf_menu-item .
     1041       end.
     1042       for each buf_menu-item-group
     1043       on error undo, return error return-value
     1044       :
     1045         export "menu-item-group" .
     1046         export buf_menu-item-group .
     1047       end.
     1048       output close .
     1049     end.
     1050   end procedure.
     1051   procedure filter-configuration-menu-group :
     1052     define buffer buf_temp-menu-group for temp-menu-group .
     1053     define variable v-configuration-list           as character no-undo .
     1054     define variable v-configuration-item           as character no-undo .
     1055     define variable v-num-items-configuration-list as integer   no-undo .
     1056     define variable v-ind                          as integer   no-undo .
     1057     define variable v-enable-item                  as logical   no-undo .
     1058     define variable v-check-enable-item            as logical   no-undo .
     1059     do
     1060     on error undo, return error return-value
     1061     :
     1062       for each buf_temp-menu-group
     1063       on error undo, return error return-value
     1064       :
     1065         assign
     1066           v-configuration-list = buf_temp-menu-group.menu-group-configuration
     1067         .
     1068         if v-configuration-list = '':u
     1069         then do:
     1070           assign
     1071             v-enable-item = true
     1072           .
     1073         end.
     1074         else do:
     1075           assign
     1076             v-enable-item = false
     1077           .
     1078           assign
     1079             v-num-items-configuration-list = num-entries(v-configuration-list)
     1080           .
     1081           check_block :
     1082           do v-ind = 1 to v-num-items-configuration-list
     1083           :
     1084             assign
     1085               v-configuration-item = entry(v-ind, v-configuration-list)
     1086             .
     1087             run value(v-configuration-item) in parparentproc
     1088               (output v-check-enable-item
     1089               ) .
     1090             if v-check-enable-item = true
     1091             then do:
     1092               assign
     1093                 v-enable-item = true
     1094               .
     1095               leave check_block .
     1096             end.
     1097           end.
     1098         end.
     1099         if v-enable-item <> true
     1100         then do:
     1101           delete buf_temp-menu-group .
     1102         end.
     1103       end.
     1104     end.
     1105   end procedure.
     1106   procedure filter-configuration-menu-item :
     1107     define buffer buf_temp-menu-group for temp-menu-group .
     1108     define buffer buf_temp-menu-item  for temp-menu-item .
     1109     define variable v-configuration-list           as character no-undo .
     1110     define variable v-configuration-item           as character no-undo .
     1111     define variable v-num-items-configuration-list as integer   no-undo .
     1112     define variable v-ind                          as integer   no-undo .
     1113     define variable v-enable-item                  as logical   no-undo .
     1114     define variable v-check-enable-item            as logical   no-undo .
     1115     do
     1116     on error undo, return error return-value
     1117     :
     1118       for each buf_temp-menu-item
     1119       on error undo, return error return-value
     1120       :
     1121         define variable v-num-entries-item-group-id as integer   no-undo .
     1122         define variable v-new-item-group-id         as character no-undo .
     1123         assign
     1124           v-num-entries-item-group-id = num-entries(buf_temp-menu-item.item-group-id, chr(44))
     1125           v-new-item-group-id         = '':U
     1126         .
     1127         do v-ind = 1 to v-num-entries-item-group-id
     1128         :
     1129           if lookup(entry(v-ind, buf_temp-menu-item.item-group-id, chr(44)), v-valid-menu-group-id-list) = 0
     1130           then do:
     1131             message
     1132               vss-workfile vss-revision vss-description skip
     1133               "Неизвестный идентификатор группы пунктов меню" skip
     1134               "Идентификтор пункта меню" buf_temp-menu-item.item-id skip
     1135               "Номер пункта меню в файле"  buf_temp-menu-item.file-item-code skip
     1136               "Идентификатор группы пукнтов" entry(v-ind, buf_temp-menu-item.item-group-id, chr(44)) skip
     1137               view-as alert-box error .
     1138             undo, return error return-value .
     1139           end.
     1140           find first buf_temp-menu-group
     1141             where buf_temp-menu-group.menu-group-id = entry(v-ind, buf_temp-menu-item.item-group-id, chr(44))
     1142             no-error .
     1143           if available buf_temp-menu-group
     1144           then do:
     1145             assign
     1146               v-new-item-group-id = v-new-item-group-id
     1147                                   + (if v-new-item-group-id <> '':U then ',':U else '':U)
     1148                                   + string(buf_temp-menu-group.menu-group-code)
     1149             .
     1150           end.
     1151         end.
     1152         assign
     1153           buf_temp-menu-item.item-group-id = v-new-item-group-id
     1154         .
     1155         if buf_temp-menu-item.item-type <> 's-m':u
     1156         then do:
     1157           if buf_temp-menu-item.item-group-id = '':U
     1158           then do:
     1159             assign
     1160               v-enable-item = false
     1161             .
     1162           end.
     1163           else do:
     1164             assign
     1165               v-configuration-list = buf_temp-menu-item.item-configuration
     1166             .
     1167             if v-configuration-list = '':u
     1168             then do:
     1169               assign
     1170                 v-enable-item = true
     1171               .
     1172             end.
     1173             else do:
     1174               assign
     1175                 v-enable-item = false
     1176               .
     1177               assign
     1178                 v-num-items-configuration-list = num-entries(v-configuration-list)
     1179               .
     1180               check_block :
     1181               do v-ind = 1 to v-num-items-configuration-list
     1182               :
     1183                 assign
     1184                   v-configuration-item = entry(v-ind, v-configuration-list)
     1185                 .
     1186                 run value(v-configuration-item) in parparentproc
     1187                   (output v-check-enable-item
     1188                   ) .
     1189                 if v-check-enable-item = true
     1190                 then do:
     1191                   assign
     1192                     v-enable-item = true
     1193                   .
     1194                   leave check_block .
     1195                 end.
     1196               end.
     1197             end.
     1198           end.
     1199           if v-enable-item <> true
     1200           then do:
     1201             delete buf_temp-menu-item .
     1202           end.
     1203         end.
     1204       end.
     1205     end.
     1206   end procedure.
     1207   procedure filter-configuration-sub-menu :
     1208     define buffer buf_temp-menu-item        for temp-menu-item .
     1209     define buffer buf_parent_temp-menu-item for temp-menu-item .
     1210     define variable v-parent-id as character no-undo .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       for each buf_temp-menu-item
     1215         where buf_temp-menu-item.item-type = 's-m':u
     1216       on error undo, return error return-value
     1217       :
     1218         assign
     1219           buf_temp-menu-item.sub-menu-enable = false
     1220         .
     1221       end.
     1222       for each buf_temp-menu-item
     1223         where buf_temp-menu-item.parent-id <> '':u
     1224           and ( buf_temp-menu-item.item-type = 'm-i':u
     1225                 or buf_temp-menu-item.item-type = 'm-t':u
     1226                 or buf_temp-menu-item.item-type = 'r-l':u
     1227               )
     1228       on error undo, return error return-value
     1229       :
     1230         find first buf_parent_temp-menu-item
     1231           where buf_parent_temp-menu-item.item-id = buf_temp-menu-item.parent-id
     1232           no-error
     1233           .
     1234         if not available buf_parent_temp-menu-item then do:
     1235           message
     1236             vss-workfile vss-revision vss-description skip
     1237             "Внутренняя ошибка" skip
     1238             "В текущей конфигурации должен быть доступен пункт меню,"                                       skip
     1239             substitute( "но недоступен или отсутствует его 'родитель' (&1)", buf_temp-menu-item.parent-id ) skip
     1240             "item-code"          buf_temp-menu-item.item-code                                               skip
     1241             "item-type"          buf_temp-menu-item.item-type                                               skip
     1242             "item-name"          buf_temp-menu-item.item-name                                               skip
     1243             "item-procedure"     buf_temp-menu-item.item-procedure                                          skip
     1244             "item-id"            buf_temp-menu-item.item-id                                                 skip
     1245             "parent-id"          buf_temp-menu-item.parent-id                                               skip
     1246             "item-condition"     buf_temp-menu-item.item-condition                                          skip
     1247             "item-context"       buf_temp-menu-item.item-context                                            skip
     1248             "item-configuration" buf_temp-menu-item.item-configuration                                      skip
     1249             "item-group-id"      buf_temp-menu-item.item-group-id                                           skip
     1250             "item-encoded"       buf_temp-menu-item.item-encoded                                            skip
     1251             view-as alert-box warning .
     1252           delete buf_temp-menu-item .
     1253         end.
     1254         else do:
     1255           parent_scan:
     1256           do while available buf_parent_temp-menu-item
     1257           :
     1258             if buf_parent_temp-menu-item.sub-menu-enable = true
     1259             then do:
     1260               leave parent_scan .
     1261             end.
     1262             assign
     1263               buf_parent_temp-menu-item.sub-menu-enable = true
     1264             .
     1265             assign
     1266               v-parent-id = buf_parent_temp-menu-item.parent-id
     1267             .
     1268             if v-parent-id = '':u
     1269             then do:
     1270               leave parent_scan .
     1271             end.
     1272             find first buf_parent_temp-menu-item
     1273               where buf_parent_temp-menu-item.item-id = v-parent-id
     1274               .
     1275           end.
     1276         end.
     1277       end.
     1278       for each buf_temp-menu-item
     1279         where buf_temp-menu-item.item-type = 's-m':u
     1280           and buf_temp-menu-item.sub-menu-enable = false
     1281       on error undo, return error return-value
     1282       :
     1283         delete buf_temp-menu-item .
     1284       end.
     1285     end.
     1286   end procedure.
     1287   procedure set-db-code-menu-item :
     1288     define buffer buf_temp-menu-item for temp-menu-item .
     1289     define variable v-menu-item-code as integer   no-undo .
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       assign
     1294         v-menu-item-code = 0
     1295       .
     1296       run set-db-code-menu-item-childs
     1297         (input  '':u
     1298         ,input  v-menu-item-code
     1299         ,output v-menu-item-code
     1300         ).
     1301     end.
     1302   end procedure.
     1303   procedure set-parent-code-menu-item :
     1304     define buffer buf_temp-menu-item for temp-menu-item .
     1305     define buffer buf_parent_temp-menu-item for temp-menu-item .
     1306     do
     1307     on error undo, return error return-value
     1308     :
     1309       for each buf_temp-menu-item
     1310         where buf_temp-menu-item.parent-id <> ''
     1311       on error undo, return error return-value
     1312       :
     1313         find first buf_parent_temp-menu-item
     1314           where buf_parent_temp-menu-item.item-id = buf_temp-menu-item.parent-id
     1315           no-error .
     1316         if available buf_parent_temp-menu-item
     1317         then do:
     1318           assign
     1319             buf_temp-menu-item.parent-code = buf_parent_temp-menu-item.item-code
     1320           .
     1321         end.
     1322       end.
     1323     end.
     1324   end procedure.
     1325   procedure calculate-menu-item-group :
     1326     define buffer buf_temp-menu-group for temp-menu-group .
     1327     define buffer buf_temp-menu-item-group for temp-menu-item-group .
     1328     define buffer buf_temp-menu-item for temp-menu-item .
     1329     define buffer buf_parent_temp-menu-item for temp-menu-item .
     1330     define variable v-ind            as integer   no-undo .
     1331     define variable v-context        as character no-undo .
     1332     define variable v-context-list   as character no-undo .
     1333     define variable v-item-condition as character no-undo .
     1334     define variable v-parent-id      as character no-undo .
     1335     do
     1336     on error undo, return error return-value
     1337     :
     1338       do v-ind = 1 to 3
     1339       :
     1340         case v-ind :
     1341           when 1
     1342           then do:
     1343             assign
     1344               v-context      = 'global':U
     1345               v-context-list = 'global':U
     1346             .
     1347           end.
     1348           when 2
     1349           then do:
     1350             assign
     1351               v-context      = 'firm':U
     1352               v-context-list = 'global':U + chr(44) + 'firm':U
     1353             .
     1354           end.
     1355           when 3
     1356           then do:
     1357             assign
     1358               v-context      = 'object':U
     1359               v-context-list = 'global':U + chr(44) + 'firm':U + chr(44) + 'object':U
     1360             .
     1361           end.
     1362           otherwise do:
     1363             message
     1364               vss-workfile vss-revision vss-description skip
     1365               "Внутренняя ошибка" skip
     1366               "Неизвестное значение переменной v-ind" skip
     1367               v-ind skip
     1368               view-as alert-box error .
     1369             undo, return error return-value .
     1370           end.
     1371         end case .
     1372         for each buf_temp-menu-group
     1373         on error undo, return error return-value
     1374         :
     1375           for each buf_temp-menu-item
     1376             where buf_temp-menu-item.parent-id <> '':u
     1377               and lookup(buf_temp-menu-item.item-context, v-context-list) > 0
     1378               and lookup(string(buf_temp-menu-group.menu-group-code), buf_temp-menu-item.item-group-id) > 0
     1379               and ( buf_temp-menu-item.item-type = 'm-i':u
     1380                     or buf_temp-menu-item.item-type = 'm-t':u
     1381                   )
     1382           on error undo, return error return-value
     1383           :
     1384             assign
     1385               v-item-condition = buf_temp-menu-item.item-condition
     1386             .
     1387             find first buf_parent_temp-menu-item
     1388               where buf_parent_temp-menu-item.item-id = buf_temp-menu-item.parent-id
     1389               .
     1390             parent_scan:
     1391             do while available buf_parent_temp-menu-item
     1392             :
     1393               find first buf_temp-menu-item-group
     1394                 where buf_temp-menu-item-group.menu-code       = p-menu-code
     1395                   and buf_temp-menu-item-group.item-code       = buf_parent_temp-menu-item.item-code
     1396                   and buf_temp-menu-item-group.item-context    = v-context
     1397                   and buf_temp-menu-item-group.menu-group-code = buf_temp-menu-group.menu-group-code
     1398                 no-error .
     1399               if not available buf_temp-menu-item-group
     1400               then do:
     1401                 create buf_temp-menu-item-group .
     1402                 assign
     1403                   buf_temp-menu-item-group.menu-code       = p-menu-code
     1404                   buf_temp-menu-item-group.item-code       = buf_parent_temp-menu-item.item-code
     1405                   buf_temp-menu-item-group.item-context    = v-context
     1406                   buf_temp-menu-item-group.menu-group-code = buf_temp-menu-group.menu-group-code
     1407                   buf_temp-menu-item-group.parent-code     = buf_parent_temp-menu-item.parent-code
     1408                   buf_temp-menu-item-group.item-condition  = v-item-condition
     1409                 .
     1410               end.
     1411               else do:
     1412                 assign
     1413                   buf_temp-menu-item-group.item-condition
     1414                     = cross-list(buf_temp-menu-item-group.item-condition
     1415                                 ,v-item-condition
     1416                                 ,chr(44)
     1417                                 )
     1418                 .
     1419               end.
     1420               assign
     1421                 v-item-condition = buf_temp-menu-item-group.item-condition
     1422                 v-parent-id = buf_parent_temp-menu-item.parent-id
     1423               .
     1424               if v-parent-id = '':u
     1425               then do:
     1426                 leave parent_scan .
     1427               end.
     1428               find first buf_parent_temp-menu-item
     1429                 where buf_parent_temp-menu-item.item-id = v-parent-id
     1430                 .
     1431             end.
     1432           end.
     1433         end.
     1434       end.
     1435     end.
     1436   end procedure.
     1437   procedure set-db-code-menu-item-childs :
     1438     define input  parameter p-item-id         as character no-undo .
     1439     define input  parameter p-first-item-code as integer   no-undo .
     1440     define output parameter p-last-item-code  as integer   no-undo .
     1441     define buffer buf_temp-menu-item for temp-menu-item .
     1442     define variable v-menu-item-code as integer   no-undo .
     1443     do
     1444     on error undo, return error return-value
     1445     :
     1446       assign
     1447         v-menu-item-code = p-first-item-code
     1448       .
     1449       for each buf_temp-menu-item
     1450         where buf_temp-menu-item.parent-id = p-item-id
     1451       by buf_temp-menu-item.file-item-code
     1452       on error undo, return error
     1453       :
     1454         assign
     1455           v-menu-item-code = v-menu-item-code + 1
     1456         .
     1457         assign
     1458           buf_temp-menu-item.item-code = v-menu-item-code
     1459         .
     1460         if buf_temp-menu-item.item-type = 's-m':u
     1461         then do:
     1462           run set-db-code-menu-item-childs in this-procedure
     1463             (input  buf_temp-menu-item.item-id
     1464             ,input  v-menu-item-code
     1465             ,output v-menu-item-code
     1466             ) .
     1467         end.
     1468       end.
     1469       assign
     1470         p-last-item-code = v-menu-item-code
     1471       .
     1472     end.
     1473   end procedure.
     1474   procedure clear-menu :
     1475     define buffer buf_menu-group      for ub.menu-group .
     1476     define buffer buf_menu-item-group for ub.menu-item-group .
     1477     define buffer buf_menu-item       for ub.menu-item .
     1478     do
     1479     on error undo, return error return-value
     1480     :
     1481       define variable v-ind as integer   no-undo .
     1482       assign
     1483         v-ind = 0
     1484       .
     1485       for each buf_menu-group exclusive-lock
     1486         where buf_menu-group.menu-code = p-menu-code
     1487       by buf_menu-group.menu-code
     1488       on error undo, return error return-value
     1489       :
     1490         assign
     1491           v-ind = v-ind + 1
     1492         .
     1493         if v-ind modulo 10 = 0
     1494         then do:
     1495           run waitfram-show in this-procedure
     1496             (input substitute("Обновление меню. Удаление групп меню &1"
     1497                             ,v-ind
     1498                             )
     1499             ) .
     1500         end.
     1501         delete buf_menu-group .
     1502       end.
     1503       assign
     1504         v-ind = 0
     1505       .
     1506       for each buf_menu-item-group exclusive-lock
     1507         where buf_menu-item-group.menu-code = p-menu-code
     1508       on error undo, return error return-value
     1509       :
     1510         assign
     1511           v-ind = v-ind + 1
     1512         .
     1513         if v-ind modulo 10 = 0
     1514         then do:
     1515           run waitfram-show in this-procedure
     1516             (input substitute("Обновление меню. Удаление групп пунктов меню &1"
     1517                             ,v-ind
     1518                             )
     1519             ) .
     1520         end.
     1521         delete buf_menu-item-group .
     1522       end.
     1523       assign
     1524         v-ind = 0
     1525       .
     1526       for each buf_menu-item exclusive-lock
     1527         where buf_menu-item.menu-code = p-menu-code
     1528       on error undo, return error return-value
     1529       :
     1530         assign
     1531           v-ind = v-ind + 1
     1532         .
     1533         if v-ind modulo 10 = 0
     1534         then do:
     1535           run waitfram-show in this-procedure
     1536             (input substitute("Обновление меню. Удаление пунктов меню &1"
     1537                             ,v-ind
     1538                             )
     1539             ) .
     1540         end.
     1541         delete buf_menu-item .
     1542       end.
     1543     end.
     1544   end procedure.
     1545   procedure write-menu :
     1546     define buffer buf_temp-menu-group for temp-menu-group .
     1547     define buffer buf_menu-group for ub.menu-group .
     1548     define buffer buf_temp-menu-item for temp-menu-item .
     1549     define buffer buf_menu-item      for ub.menu-item .
     1550     define buffer buf_temp-menu-item-group for temp-menu-item-group .
     1551     define buffer buf_menu-item-group for ub.menu-item-group .
     1552     define variable v-ind as integer   no-undo .
     1553     do transaction
     1554     on error undo, return error return-value
     1555     :
     1556       assign
     1557         v-ind = v-ind + 1
     1558       .
     1559       for each buf_temp-menu-group
     1560       on error undo, return error return-value
     1561       :
     1562         assign
     1563           v-ind = v-ind + 1
     1564         .
     1565         if v-ind modulo 10 = 0
     1566         then do:
     1567           run waitfram-show in this-procedure
     1568             (input substitute("Обновление меню. Создание групп меню &1"
     1569                             ,v-ind
     1570                             )
     1571             ) .
     1572         end.
     1573         create buf_menu-group .
     1574         assign
     1575           buf_menu-group.menu-group-code          = buf_temp-menu-group.menu-group-code
     1576           buf_menu-group.menu-group-id            = buf_temp-menu-group.menu-group-id
     1577           buf_menu-group.menu-group-name          = buf_temp-menu-group.menu-group-name
     1578           buf_menu-group.menu-group-description   = buf_temp-menu-group.menu-group-description
     1579           buf_menu-group.menu-group-licence-param = buf_temp-menu-group.menu-group-licence-param
     1580           buf_menu-group.button-image-name        = buf_temp-menu-group.button-image-name
     1581           buf_menu-group.menu-group-procedure     = buf_temp-menu-group.menu-group-procedure
     1582         .
     1583       end.
     1584       for each buf_temp-menu-item
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-ind = v-ind + 1
     1589         .
     1590         if v-ind modulo 10 = 0
     1591         then do:
     1592           run waitfram-show in this-procedure
     1593             (input substitute("Обновление меню. Создание новых пунктов меню &1"
     1594                             ,v-ind
     1595                             )
     1596             ) .
     1597         end.
     1598         if buf_temp-menu-item.item-code = 0 then do:
     1599           message
     1600             vss-workfile vss-revision vss-description skip
     1601             "Внутренняя ошибка" skip
     1602             "Пункт меню не прошел обработку"                           skip
     1603             "item-code"          buf_temp-menu-item.item-code          skip
