     2043             .
     2044           end.
     2045         end case .
     2046       end.
     2047       if v-error-exist = true
     2048       then do:
     2049         undo, return error .
     2050       end.
     2051     end.
     2052   end procedure.
     2053   procedure update-user-menu-group :
     2054     define buffer buf_user-menu-group for ub.user-menu-group .
     2055     define buffer buf_menu-group      for ub.menu-group .
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       for each buf_user-menu-group exclusive-lock
     2060         where buf_user-menu-group.db-num = p-db-num
     2061       on error undo, return error return-value
     2062       :
     2063         find first buf_menu-group no-lock
     2064           where buf_menu-group.menu-code     = buf_user-menu-group.menu-code
     2065             and buf_menu-group.menu-group-id = buf_user-menu-group.menu-group-id
     2066           no-error .
     2067         if available buf_menu-group
     2068         then do:
     2069           assign
     2070             buf_user-menu-group.menu-group-code = buf_menu-group.menu-group-code
     2071           .
     2072         end.
     2073         else do:
     2074           assign
     2075             buf_user-menu-group.menu-group-code = 0
     2076           .
     2077         end.
     2078       end.
     2079     end.
     2080   end procedure.
     2081   procedure update-action-post-menu-group :
     2082     define buffer buf_action-post-menu-group for ub.action-post-menu-group .
     2083     define buffer buf_menu-group      for ub.menu-group .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087     end.
     2088   end procedure.
