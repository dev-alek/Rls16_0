        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-data-valid     as logical   no-undo .
        5   define input  parameter p-error-message  as character no-undo .
        6   define input  parameter p-user-login     as character no-undo .
        7   define input  parameter p-obj-type       as character no-undo .
        8   define input  parameter p-obj-code       as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: rt-req01.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req01.p $":U .
       14   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 01. Контроль цены. Настройка".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure integerm :
       75     define input  parameter p-string      as character no-undo .
       76     define input  parameter p-allow-sign  as logical   no-undo .
       77     define input  parameter p-allow-comma as logical   no-undo .
       78     define output parameter p-value       as integer   no-undo .
       79     define output parameter p-data-valid  as logical   no-undo .
       80     define output parameter p-message     as character no-undo .
       81     define variable v-replace-string as character no-undo .
       82     do
       83     on error undo, return error return-value
       84     :
       85       if p-string = ?
       86       then do:
       87         assign
       88           p-value      = ?
       89           p-data-valid = false
       90           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       91         .
       92         return .
       93       end.
       94       if p-string = ""
       95       then do:
       96         assign
       97           p-value      = ?
       98           p-data-valid = false
       99           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      100         .
      101         return .
      102       end.
      103       assign
      104         p-value = integer(p-string) no-error
      105       .
      106       if error-status :error = true
      107       then do:
      108         assign
      109           p-value      = ?
      110           p-data-valid = false
      111           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      112                                    ,p-string
      113                                    )
      114         .
      115         return .
      116       end.
      117       if index(p-string, ' ':u) > 0
      118       then do:
      119         assign
      120           p-value      = ?
      121           p-data-valid = false
      122           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      123                                    + "Строка содержит символы пробела"
      124                                    ,p-string
      125                                    )
      126         .
      127         return .
      128       end.
      129       assign
      130         v-replace-string = p-string
      131         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      132         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      140       .
      141       if p-allow-sign = true
      142       then do:
      143         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      144         then do:
      145           assign
      146             v-replace-string = substring(v-replace-string, 2)
      147           .
      148         end.
      149       end.
      150       else do:
      151         if substring(v-replace-string, 1, 1) = '+':u
      152         then do:
      153           assign
      154             p-value      = ?
      155             p-data-valid = false
      156             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      157                                     + "Задан параметр недопустимости знака челого числа. "
      158                                     + "Строка содержит символ плюс. "
      159                                     ,p-string
      160                                     )
      161           .
      162           return .
      163         end.
      164         if substring(v-replace-string, 1, 1) = '-':u
      165         then do:
      166           assign
      167             p-value      = ?
      168             p-data-valid = false
      169             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      170                                     + "Задан параметр недопустимости знака челого числа. "
      171                                     + "Строка содержит символ минус. "
      172                                     ,p-string
      173                                     )
      174           .
      175           return .
      176         end.
      177       end.
      178       if p-allow-comma = true
      179       then do:
      180         assign
      181           v-replace-string = replace(v-replace-string, ',', '')
      182         .
      183       end.
      184       else do:
      185         if index(v-replace-string, ',') > 0
      186         then do:
      187           assign
      188             p-value      = ?
      189             p-data-valid = false
      190             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      191                                     + "Задан параметр недопустимости знака разделителя тысяч."
      192                                     + "Строка содержит знак разделителя тысяч. "
      193                                     ,p-string
      194                                     )
      195           .
      196           return .
      197         end.
      198       end.
      199       if index(p-string, '.') > 0
      200       then do:
      201         assign
      202           p-value      = ?
      203           p-data-valid = false
      204           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      205                                    + "Строка содержит знак десятичной точки"
      206                                    ,p-string
      207                                    )
      208         .
      209         return .
      210       end.
      211       if v-replace-string <> fill('9', length(v-replace-string))
      212       then do:
      213         assign
      214           p-value      = ?
      215           p-data-valid = false
      216           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      217                                    + "Встречены символы, недопустимые для целого числа '&2'"
      218                                    ,p-string
      219                                    ,replace(v-replace-string, '9', '')
      220                                    )
      221         .
      222         return .
      223       end.
      224       assign
      225         p-data-valid = true
      226         p-message    = ""
      227       .
      228     end.
      229   end procedure.
      230   define new global shared variable g#library  as handle no-undo .
      231   define new global shared variable g#library2 as handle no-undo .
      232   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   function rtencode returns character
      234     ( p-init-string as character
      235     ) :
      236     define variable v-encode-string as character no-undo .
      237     if p-init-string = ?
      238     then do:
      239       assign
      240         v-encode-string = '?':u
      241       .
      242       return v-encode-string .
      243     end.
      244     if p-init-string = '?':u
      245     then do:
      246       assign
      247         v-encode-string = '~~077':u
      248       .
      249       return v-encode-string .
      250     end.
      251     assign
      252       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      253       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      254       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      255     .
      256     return v-encode-string .
      257   end function .
      258   define stream sout .
      259   define variable v-data-valid    as logical   no-undo .
      260   define variable v-error-message as character no-undo .
      261   do
      262   on error undo, return error return-value
      263   :
      264     if p-data-valid = true
      265     then do:
      266       run check-data in this-procedure
      267         (output  v-data-valid
      268         ,output  v-error-message
      269         ) no-error .
      270       if error-status :error
      271       then do:
      272         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      273                                     ,error-status :get-message(1)
      274                                     ,return-value
      275                                     ) .
      276       end.
      277     end.
      278     else do:
      279       assign
      280         v-data-valid    = p-data-valid
      281         v-error-message = p-error-message
      282       .
      283     end.
      284     define variable v-temp-file-name as character no-undo .
      285     assign
      286       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      287     .
      288     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      289     if v-data-valid = true
      290     then do:
      291       put stream sout unformatted 'status:0' + chr(10) .
      292       put stream sout unformatted 'message:' + chr(10) .
      293     end.
      294     else do:
      295       put stream sout unformatted 'status:1' + chr(10) .
      296       put stream sout unformatted substitute('message:&1', rtencode(v-error-message)) + chr(10) .
      297     end.
      298     output stream sout close .
      299     os-delete value(p-directory-out + '/':u + p-file-name) .
      300     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      301               value(p-directory-out + '/':u + p-file-name)
      302               .
      303   end.
      304   procedure check-data :
      305     define output parameter p-data-valid    as logical   no-undo .
      306     define output parameter p-error-message as character no-undo .
      307     define buffer buf_clients    for ub.clients .
      308     define buffer buf_sysconf    for ub.sysconf .
      309     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      310     define buffer buf_user-login for ub.user-login .
      311     do
      312     on error undo, return error return-value
      313     :
      314       find first buf_sys-ctrl no-lock .
      315       find first buf_user-login no-lock
      316         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      317           and buf_user-login.status_    = 0
      318           and buf_user-login.user-login = p-user-login
      319         no-error .
      320       if not available buf_user-login
      321       then do:
      322         assign
      323           p-data-valid    = false
      324           p-error-message = substitute("Неизвестный пользователь &1"
      325                                       ,p-error-message
      326                                       )
      327         .
      328         return .
      329       end.
      330       define variable v-obj-code      as integer   no-undo .
      331       define variable v-data-valid    as logical   no-undo .
      332       define variable v-error-message as character no-undo .
      333       if p-obj-code = ""
      334       then do:
      335         assign
      336           p-data-valid    = false
      337           p-error-message = "Не задан код объекта"
      338         .
      339         return .
      340       end.
      341       run integerm in this-procedure
      342         (input  p-obj-code
      343         ,input  false
      344         ,input  false
      345         ,output v-obj-code
      346         ,output v-data-valid
      347         ,output v-error-message
      348         ) .
      349       if v-data-valid <> true
      350       then do:
      351         assign
      352           p-data-valid    = false
      353           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      354                                       ,p-obj-code
      355                                       ,v-error-message
      356                                       )
      357         .
      358         return .
      359       end.
      360       find first buf_clients no-lock
      361         where buf_clients.obj-type = p-obj-type
      362           and buf_clients.obj-code = v-obj-code
      363         no-error .
      364       if not available buf_clients
      365       then do:
      366         assign
      367           p-data-valid    = false
      368           p-error-message = substitute("Не найден объект &1 &2"
      369                                       ,p-obj-type
      370                                       ,v-obj-code
      371                                       )
      372         .
      373         return .
      374       end.
      375       if  p-obj-type <> 'маг':U
      376       and p-obj-type <> 'скл':U
      377       then do:
      378         assign
      379           p-data-valid    = false
      380           p-error-message = substitute("Неправильный тип объекта &1 &2"
      381                                       ,p-obj-type
      382                                       ,v-obj-code
      383                                       )
      384         .
      385         return .
      386       end.
      387       define variable v-host-code as integer   no-undo .
      388   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      390     (input  buf_clients.obj-type
      391     ,input  buf_clients.obj-code
      392     ,output v-host-code
      393     )  .
      394       define variable v-object-available as logical   no-undo .
      395   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      397     (input  buf_sys-ctrl.db-num
      398     ,input  0
      399     ,input  buf_user-login.user-id
      400     ,input  buf_clients.obj-type
      401     ,input  buf_clients.obj-code
      402     ,output v-object-available
      403     )  .
      404       if v-object-available <> true
      405       then do:
      406         assign
      407           p-data-valid    = false
      408           p-error-message = substitute("Пользователю не доступен объект &1 &2"
      409                                       ,buf_clients.obj-type
      410                                       ,buf_clients.obj-code
      411                                       )
      412         .
      413         return .
      414       end.
      415       define variable v-valid-act   as logical   no-undo .
      416   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   do:
      418     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      419       (input  buf_sys-ctrl.db-num
      420       ,input  buf_user-login.user-id
      421       ,input  0
      422       ,input  'actn_rt-check-price_work':U
      423       ,input  'object':U
      424       ,input  v-host-code
      425       ,input  buf_clients.obj-type
      426       ,input  buf_clients.obj-code
      427       ,input  0
      428       ,input  0
      429       ,input  0
      430       ,input  false
      431       ,output v-valid-act
      432       )  .
      433   end.
      434       if v-valid-act <> true
      435       then do:
      436         assign
      437           p-data-valid    = false
      438           p-error-message = return-value
      439         .
      440         return .
      441       end.
      442       find first buf_sysconf no-lock
      443         where buf_sysconf.host-code = v-host-code
      444         no-error .
      445       if not available buf_sysconf
      446       then do:
      447         assign
      448           p-data-valid    = false
      449           p-error-message = substitute("Не найдена фирма &1"
      450                                       ,v-host-code
      451                                       )
      452         .
      453         return .
      454       end.
      455       assign
      456         p-data-valid    = true
      457         p-error-message = ""
      458       .
      459     end.
      460   end procedure.
