      444        SIZE 10 BY 3.33.
      445   DEFINE BUTTON b-screen
      446        IMAGE-UP FILE "cmp/prnts_screen.bmp":U
      447        IMAGE-DOWN FILE "cmp/prnts_screen.bmp":U
      448        IMAGE-INSENSITIVE FILE "cmp/prnt_screen.bmp":U
      449        LABEL "_ &Экран"
