      451   DEFINE BUTTON Exit AUTO-END-KEY
      452        IMAGE-UP FILE "cmp/prnts_exit.bmp":U
      453        IMAGE-DOWN FILE "cmp/prnts_exit.bmp":U
      454        IMAGE-INSENSITIVE FILE "cmp/prnt_exit.bmp":U
      455        LABEL "&Выход ":L
      456        SIZE 10 BY 3.33.
      457   DEFINE VARIABLE EDITOR-history AS CHARACTER
      458        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      459        SIZE 79.5 BY 4.63
      460        BGCOLOR 15 FGCOLOR 4  NO-UNDO.
      461   DEFINE VARIABLE fi-description AS CHARACTER FORMAT "X(256)":U
      462         VIEW-AS TEXT
      463        SIZE 80.5 BY .67
      464        BGCOLOR 15 FGCOLOR 4  NO-UNDO.
      465   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Действия по выводу отчёта:"
      466         VIEW-AS TEXT
      467        SIZE 26 BY .67
      468        BGCOLOR 15  NO-UNDO.
      469   DEFINE IMAGE IMAGE-1
      470        FILENAME "cmp/mainprint.bmp":U
      471        STRETCH-TO-FIT
      472        SIZE 80.5 BY 10.5.
      473   DEFINE FRAME DIALOG-1
      474        Exit AT ROW 1.17 COL 1.25
      475        EDITOR-history AT ROW 5.79 COL 1.5 NO-LABEL
      476        b-printer AT ROW 1.17 COL 12.25
      477        b-pdf AT ROW 1.17 COL 23.25
      478        b-screen AT ROW 1.17 COL 34.25
      479        b-file AT ROW 1.17 COL 45.25
      480        b-other AT ROW 1.17 COL 56.25
      481        b-excel AT ROW 1.17 COL 67.25
      482        b-help AT ROW 1.17 COL 78
      483        FILL-IN-1 AT ROW 4.96 COL 1.5 NO-LABEL
      484        fi-description AT ROW 10.63 COL 1 NO-LABEL
      485        IMAGE-1 AT ROW 1 COL 1 WIDGET-ID 14
      486       WITH VIEW-AS DIALOG-BOX
      487            SIDE-LABELS THREE-D  SCROLLABLE
      488            TITLE "Вывод отчета".
      489   ASSIGN
      490          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      491   ASSIGN
      492          EDITOR-history:READ-ONLY IN FRAME DIALOG-1        = TRUE.
      493   ASSIGN
      494          Exit:PRIVATE-DATA IN FRAME DIALOG-1     =
      495                   "Exit".
      496   ON CHOOSE OF b-excel IN FRAME DIALOG-1
      497   DO:
      498     define variable v-disable-button as logical   no-undo .
      499     if session :set-wait-state("compiler") then .
      500     if check-xslt-files() then
      501       do:
      502          run xslt-transform.
      503          run disable-excel(true).
      504       end.
      505     else if v-postpone-print then do:
      506       run gbl/open_url.p ( input p-excel-name) no-error .
      507     end.
      508     else do:
      509     if search( p-file-name + ".txl" ) = ?
      510     then do:
      511       run rep/runexcel.p
      512           (input p-file-name + ".txt"
      513           ) no-error .
      514       if error-status :error
      515       then do:
      516           if session :set-wait-state("") then .
      517           apply 'ENTRY':u to Exit .
      518           return no-apply .
      519       end.
      520     end.
      521     else do:
      522       run rep/runxlt.p (
      523           input p-file-name + ".txl"
      524       ) no-error.
      525       if error-status :error
      526       then do:
      527           os-delete value( p-file-name + ".txl" ).
      528           run disable-excel in this-procedure (
      529               input yes
      530           ).
      531           if session :set-wait-state("") then .
      532           run update-history in this-procedure (
      533               input "Отказ от сохранения отчёта в формате Excel"
      534           ).
      535           apply 'ENTRY':u to Exit .
      536           return no-apply .
      537       end.
      538       assign
      539           v-disable-button = yes
      540       .
      541     end.
      542     if return-value = "disable-button":U
      543     then do:
      544       assign
      545         v-disable-button = true
      546       .
      547     end.
      548     run disable-excel in this-procedure (
      549       input v-disable-button
      550     ).
      551     end.
      552     assign
      553       v-report-output = true
      554       p-user-action   = p-user-action + "; " + "excel"
      555     .
      556     run update-history in this-procedure
      557       (input "Отчёт сохранён в формате Excel"
      558       ) .
      559     if session :set-wait-state("") then .
      560     apply 'ENTRY':u to Exit .
      561   END.
      562   ON CHOOSE OF b-file IN FRAME DIALOG-1
      563   DO:
      564     if session :set-wait-state("compiler") then .
      565     assign
      566       RepFileFullName = "report.txt"
      567     .
      568     system-dialog get-file RepFileFullName
      569         ask-overwrite
      570         save-as
      571         create-test-file
      572         use-filename
      573         initial-dir '.'
      574         update lok
      575         default-extension "txt" .
      576     if lok = true
      577     then do:
      578       if RepFileFullName <> p-file-name
      579       then do:
      580         define variable v-err-status as integer   no-undo .
      581         os-copy
      582           value(p-file-name)
      583           value(RepFileFullName)
      584           .
      585         assign
      586           v-err-status = os-error
      587         .
      588         if v-err-status <> 0
      589         then do:
      590           message
      591             "Не удалось вывести отчет в файл" repfilefullname skip
      592             "Ошибка" v-err-status skip
      593             view-as alert-box error .
      594         end.
      595         else do:
      596           message
      597             "Отчёт выведен в файл"  repfilefullname skip
      598             view-as alert-box information .
      599           assign
      600             p-printed       = true
      601             v-report-output = true
      602             p-user-action   = p-user-action + "; " + "файл"
      603           .
      604           run update-history in this-procedure
      605             (input substitute("Отчёт сохранён в файл &1", repfilefullname)
      606             ) .
      607         end.
      608       end.
      609     end.
      610     if session :set-wait-state("") then .
      611     apply 'ENTRY':u to Exit .
      612   END.
      613   ON CHOOSE OF b-other IN FRAME DIALOG-1
      614   DO:
      615     define variable v-ok as logical   no-undo .
      616     message
      617       "Передать отчет заказной программе обработки" skip
      618       "Продолжить?" skip
      619       view-as alert-box question buttons yes-no update v-ok .
      620     if v-ok <> true
      621     then do:
      622       return no-apply .
      623     end.
      624     if session :set-wait-state("compiler") then .
      625     define variable v-extprog-retval as character no-undo .
      626     run gbl/extprog.p
      627       (input  'exec':U
      628       ,input  'altprn':U
      629       ,input  p-file-name
      630       ,input  ""
      631       ,input  ""
      632       ,output v-extprog-retval
      633       ) .
      634     assign
      635       v-report-output = true
      636       p-user-action   = p-user-action + "; " + "заказная"
      637     .
      638     run update-history in this-procedure
      639       (input "Отчёт передан заказной программе обработки"
      640       ) .
      641     if session :set-wait-state("") then .
      642     apply 'ENTRY':u to Exit .
      643   END.
      644   ON CHOOSE OF b-pdf IN FRAME DIALOG-1
      645   DO:
      646     if session :set-wait-state("compiler") then .
      647     define variable v-landscape as logical   no-undo .
      648     if DisabledOptions >= 8
      649     then do:
      650       assign
      651         v-landscape = true
      652       .
      653     end.
      654     else do:
      655       assign
      656         v-landscape = false
      657       .
      658     end.
      659     assign
      660       RepFileFullName = "report.pdf"
      661     .
      662     system-dialog get-file RepFileFullName
      663         ask-overwrite
      664         save-as
      665         create-test-file
      666         use-filename
      667         initial-dir '.'
      668         update lok
      669         default-extension "pdf" .
      670     if lok = true
      671     then do:
      672       if  search(RepFileFullName) <> ""
      673       and search(RepFileFullName) <> ?
      674       then do:
      675         os-delete value(RepFileFullName) .
      676       end.
      677       if  search(RepFileFullName) <> ""
      678       and search(RepFileFullName) <> ?
      679       then do:
      680         message
      681           "Файл существует и его невозможно удалить" skip
      682           "Невозможно вывести отчет в файл" RepFileFullName skip
      683           view-as alert-box error .
      684       end.
      685       else do:
      686         define variable v-extprog-retval as character no-undo .
      687         run gbl/extprog.p
      688           (input  'exec':U
      689           ,input  'txt2pdf':U
      690           ,input  p-file-name
      691           ,input  RepFileFullName
      692           ,input  (if v-landscape then "-l" else "")
      693           ,output v-extprog-retval
      694           ) .
      695         assign
      696           v-report-output = true
      697           p-user-action   = p-user-action + "; " + "pdf"
      698         .
      699         run update-history in this-procedure
      700           (input substitute("Отчёт сохранён в формате PDF в файл &1", repfilefullname)
      701           ) .
      702       end.
      703     end.
      704     if session :set-wait-state("") then .
      705     apply 'ENTRY':u to Exit .
      706   END.
      707   ON CHOOSE OF b-printer IN FRAME DIALOG-1
      708   DO:
      709     if session :set-wait-state("compiler") then .
      710     run adecomm/_osprint.p
      711       (input  ?
      712       ,input  p-file-name
      713       ,input  p-font-number
      714       ,input  (if DisabledOptions >= 8 then 3 else 1)
      715       ,input  0
      716       ,input  0
      717       ,output lok
      718       ).
      719     if lok
      720     then do:
      721       assign
      722         p-printed       = true
      723         v-report-output = true
      724         p-user-action   = p-user-action + "; " + "принтер"
      725       .
      726       run update-history in this-procedure
      727         (input "Отчёт распечатан на принтер"
      728         ) .
      729     end.
      730     if session :set-wait-state("") then .
      731     apply 'ENTRY':u to Exit .
      732   END.
      733   ON CHOOSE OF b-screen IN FRAME DIALOG-1
      734   DO:
      735     if session :set-wait-state("compiler") then .
      736     define variable v-extprog-retval as character no-undo .
      737     run gbl/extprog.p
      738       (input  'exec':U
      739       ,input  'rptview':U
      740       ,input  p-file-name
      741       ,input  ""
      742       ,input  ""
      743       ,output v-extprog-retval
      744       ) .
      745     assign
      746       v-report-output = true
      747       p-user-action   = p-user-action + "; " + "экран"
      748     .
      749     if session :set-wait-state("") then .
      750     apply 'ENTRY':u to Exit .
      751   END.
      752   ON CHOOSE OF Exit IN FRAME DIALOG-1
      753   DO:
      754     if search( p-file-name + ".txl" ) <> ?
      755     and not v-excel-printed
      756     then do:
      757       run prnexldl_clear in this-procedure ( input  p-file-name + ".txl"
      758                                            ) no-error.
      759     end.
      760     if search( p-file-name + ".txt" ) <> ?
      761     and search( p-file-name + ".frm" ) <> ? then do:
      762       os-delete value( p-file-name + ".txt" ).
      763       os-delete value( p-file-name + ".frm" ).
      764     end.
      765     apply "end-error":u to frame DIALOG-1  .
      766     return no-apply .
      767   END.
      768   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      769   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      770   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   on help of frame DIALOG-1
      772   do:
      773     run gbl/app_help.p
      774       (input this-procedure :file-name
      775       ,input ''
      776       ,input ?
      777       ) no-error.
      778     if error-status :error then do:
      779       message
      780         "Ошибка при вызове помощи"
      781         error-status :get-message(1)
      782         view-as alert-box .
      783     end.
      784   end.
      785   run minbtn-set in this-procedure .
      786   on choose of b-help in frame DIALOG-1
      787   do:
      788     apply "help":u to frame DIALOG-1 .
      789   end.
      790   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      791   procedure minbtn-set :
      792       do
      793           on error undo, return error return-value
      794           :
      795           define variable ii              as integer       no-undo .
      796           define variable fh              as widget-handle no-undo .
      797           define variable hh              as widget-handle no-undo .
      798           define variable v-h             as handle        extent 4 no-undo .
      799           define variable v-name-button   as character     no-undo .
      800           define variable v-help-old-x    as decimal       no-undo .
      801           define variable v-help-old-y    as decimal       no-undo .
      802           define variable v-help-old-size as decimal       no-undo .
      803           define variable v-frame-width   as decimal       no-undo .
      804           define variable jj              as integer       no-undo .
      805           do
      806               on error undo, return error
      807               :
      808               assign
      809                   v-frame-width = frame DIALOG-1:width - 0.3
      810                   fh            = frame DIALOG-1:first-child
      811                   hh            = fh:first-child
      812                   ii            = 1
      813                   .
      814               do while valid-handle(hh):
      815                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      816                   do:
      817                       case lc(hh:name) :
      818                           when "b-help" then
      819                               do:
      820                                   hh:load-image-up("cmp/b-help.bmp":u) .
      821                                   hh:load-image-down("cmp/b-help.bmp":u) .
      822                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      823                                   hh:TOOLTIP = "Помощь" .
      824                                   v-help-old-x = hh:column .
      825                                   v-help-old-y = hh:row    .
      826                                   v-help-old-size = hh:width .
      827                                   hh:width-chars = 2.5 .
      828                               end.
      829                           when "b-print" then
      830                               do:
      831                                   hh:load-image("cmp/b-print.bmp":u) .
      832                                   hh:TOOLTIP = "Печать" .
      833                                   v-h[ii] = hh:handle .
      834                                   ii = ii + 1 .
      835                                   hh:width-chars = 3 .
      836                               end.
      837                           when "b-history" or
      838                           when "b-hist" then
      839                               do:
      840                                   hh:load-image("cmp/b-hist.bmp":u) .
      841                                   hh:TOOLTIP = "История" .
      842                                   v-h[ii] = hh:handle .
      843                                   ii = ii + 1 .
      844                                   hh:width-chars = 3 .
      845                               end.
      846                           when "b-sch" then
      847                               do:
      848                                   hh:load-image("cmp/b-sch.bmp":u) .
      849                                   hh:TOOLTIP = "Установка Фильтра" .
      850                                   v-h[ii] = hh:handle .
      851                                   ii = ii + 1 .
      852                                   hh:width-chars = 3 .
      853                               end.
      854                           when "b-hist-user" then
      855                               do:
      856                                   hh:load-image("cmp/b-hist.bmp":u) .
      857                                   hh:TOOLTIP = "История пользователя" .
      858                                   ii = ii + 1 .
      859                               end.
      860                       end case.
      861                   end.
      862                   hh = hh:next-sibling.
      863               end.
      864               b-help:column = v-frame-width - b-help:width-chars.
      865               jj = 0.
      866               repeat ii = 4 to 1 by -1 :
      867                   if valid-handle (v-h[ii] ) then
      868                   do:
      869                       jj  = jj + 1 .
      870                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      871                       v-h[ii]:row    = v-help-old-y .
      872                   end.
      873               end.
      874           end.
      875       end.
      876   end procedure.
      877   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      878   on end-error of frame DIALOG-1
      879   do:
      880     define variable v-ok as logical   no-undo .
      881     run clear-temp-xslt-files.
      882     if v-report-output = false
      883     then do:
      884       message
      885         "Отчёт не был просмотрен, сохранён или распечатан" skip
      886         "Закрыть диалог вывода отчета?" skip
      887         view-as alert-box question buttons yes-no update v-ok .
      888       if v-ok <> true
      889       then do:
      890         return no-apply .
      891       end.
      892     end.
      893   end.
      894   MAIN-BLOCK:
      895   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      896    :
      897       assign
      898         p-printed       = false
      899         v-report-output = false
      900       .
      901       if DisabledOptions >= 30 then do:
      902         assign
      903         v-postpone-print = yes
      904         .
      905         disabledoptions = disabledoptions - 30.
      906         for each temp-destination:
      907           delete temp-destination.
      908         end.
      909         v-caller = this-procedure:instantiating-procedure.
      910         run cb_get-options in v-caller ( input this-procedure:handle).
      911       end.
      912       run init-fields in this-procedure .
      913       if return-value = 'exit' then return .
      914       apply 'entry':u to b-screen .
      915       RUN enable_UI.
      916       run disable-option in this-procedure .
      917       assign
      918         fi-description :screen-value = p-message
      919       .
      920       WAIT-FOR GO OF FRAME DIALOG-1.
      921   END.
      922   RUN disable_UI.
      923   PROCEDURE cb_set-options :
      924   DEFINE INPUT PARAMETER p-option AS character NO-UNDO.
      925   define input parameter p-resource as character no-undo .
      926   DEFINE BUFFER buf_temp-destination FOR temp-destination.
      927   find first buf_temp-destination where
      928            buf_temp-destination.destination = p-option no-error.
      929   if not available buf_temp-destination then do:
      930     create buf_temp-destination.
      931     assign
      932     buf_temp-destination.destination-id = p-option
      933     buf_temp-destination.destination = p-resource.
      934   end.
      935   END PROCEDURE.
      936   PROCEDURE disable-excel :
      937     define input  parameter p-disable-button as logical   no-undo .
      938     do with frame DIALOG-1
      939     on error undo, return error
      940     :
      941       if p-disable-button = true
      942       then do:
      943         assign
      944           b-excel :sensitive = false
      945           v-excel-printed = yes
      946         .
      947       end.
      948       else do:
      949           if v-prnfilen-excel-file-exist = no
      950           then do:
      951               assign
      952                   b-excel :sensitive = false
      953               .
      954           end.
      955       end.
      956     end.
      957   END PROCEDURE.
      958   PROCEDURE disable-option :
      959     do with frame DIALOG-1
      960     on error undo, return error
      961     :
      962       case disabledoptions :
      963         when 1 or
      964         when 9
      965         then do:
      966           assign
      967             b-printer :sensitive = false
      968           .
      969         end.
      970         when 2 or
      971         when 10
      972         then do:
      973           assign
      974             b-screen :sensitive = false
      975           .
      976           apply 'entry':u to b-file .
      977         end.
      978         when 3 or
      979         when 11
      980         then do:
      981           assign
      982             b-printer :sensitive = false
      983             b-screen  :sensitive = false
      984           .
      985           apply 'entry':u to b-file .
      986         end.
      987         when 4 or
      988         when 12
      989         then do:
      990           assign
      991             b-file :sensitive = false
      992           .
      993         end.
      994         when 5 or
      995         when 13
      996         then do:
      997           assign
      998             b-printer :sensitive = false
      999             b-file    :sensitive = false
     1000           .
     1001         end.
     1002         when 6 or
     1003         when 14
     1004         then do:
     1005           assign
     1006             b-screen :sensitive = false
     1007             b-file   :sensitive = false
     1008           .
     1009           apply 'entry':u to b-file .
     1010         end.
     1011         when 20
     1012         then do:
     1013           assign
     1014             b-screen  :sensitive = false
     1015             b-file    :sensitive = false
     1016             b-printer :sensitive = false
     1017             b-other   :sensitive = false
     1018             b-pdf     :sensitive = false
     1019           .
     1020           apply 'entry':u to b-excel .
     1021         end.
     1022         when 21
     1023         then do:
     1024             assign
     1025               b-screen  :sensitive = false
     1026               b-excel   :sensitive = false
     1027               b-printer :sensitive = false
     1028             .
     1029             apply 'entry':u to b-file .
     1030         end.
     1031       end case.
     1032       if v-postpone-print
     1033       and p-file-name = '' then do:
     1034         assign
     1035           b-screen  :sensitive = false
     1036           b-file    :sensitive = false
     1037           b-printer :sensitive = false
     1038           b-other   :sensitive = false
     1039           b-pdf     :sensitive = false
     1040         .
     1041       end.
     1042       run disable-excel in this-procedure
     1043         (input false
     1044         ) .
     1045     end.
     1046   END PROCEDURE.
     1047   PROCEDURE disable_UI :
     1048     HIDE FRAME DIALOG-1.
     1049   END PROCEDURE.
     1050   PROCEDURE enable_UI :
     1051     DISPLAY EDITOR-history fi-description FILL-IN-1
     1052         WITH FRAME DIALOG-1.
     1053     ENABLE Exit IMAGE-1 EDITOR-history b-printer b-pdf b-screen b-file b-other
     1054            b-excel b-help FILL-IN-1 fi-description
     1055         WITH FRAME DIALOG-1.
     1056   END PROCEDURE.
     1057   PROCEDURE init-fields :
     1058       define variable v-filename          as character    no-undo.
     1059       define variable v-filesize          as integer      no-undo.
     1060       define variable v-data-valid        as logical      no-undo.
     1061       define variable v-err-message       as character    no-undo.
     1062   do
     1063   on error undo, return error
     1064   :
     1065   if v-postpone-print then do:
     1066     find first temp-destination where
     1067             temp-destination.destination-id =  'text':U no-error.
     1068     if available temp-destination
     1069     and search (temp-destination.destination) <> ?
     1070     then do:
     1071       assign
     1072       p-file-name = temp-destination.destination
     1073       .
     1074     end.
     1075   end.
     1076   if p-file-name <> '' AND SEARCH(p-file-name) <> ?  then do:
     1077   INPUT stream temp-stream FROM value(p-file-name).
     1078   def var str1 as character no-undo .
     1079   def var kol-row as integer init 0 no-undo  .
     1080   REPEAT:
     1081       IMPORT stream temp-stream UNFORMATTED str1 no-error .
     1082       kol-row = kol-row + 1 .
     1083       if kol-row >= 2  then DO:
     1084        leave.
     1085       End.
     1086   END.
     1087   INPUT stream temp-stream CLOSE.
     1088   if kol-row = 0 then DO:
     1089       Message "Нет заданий на печать ! " view-as alert-box .
     1090       Return  'exit'.
     1091       End.
     1092   end.
     1093       if p-font-number <= 0
     1094       then do:
     1095           assign
     1096               p-font-number = 7
     1097           .
     1098       end.
     1099       assign
     1100           v-prnfilen-excel-file-exist = no
     1101       .
     1102       if v-postpone-print then do:
     1103         find first temp-destination where
     1104                temp-destination.destination-id =  'excel':U no-error.
     1105         if available temp-destination
     1106         and search (temp-destination.destination) <> ?
     1107         then do:
     1108           assign
     1109               v-prnfilen-excel-file-exist = yes
     1110               p-excel-name = temp-destination.destination
     1111           .
     1112         end.
     1113       end.
     1114       else do:
     1115       if search( p-file-name + ".txt" ) = ?
     1116       then do:
     1117           assign
     1118               v-filename = search( p-file-name + ".txl" )
     1119           .
     1120           if v-filename <> ?
     1121           then do:
     1122               run gbl/filesize.p (
     1123                     input v-filename
     1124                   , output v-filesize
     1125               ).
     1126               if v-filesize <> 0
     1127               and v-filesize <> ?
     1128               then do:
     1129                   assign
     1130                       v-prnfilen-excel-file-exist = yes
     1131                   .
     1132               end.
     1133               else do:
     1134                   if v-filesize = 0
     1135                   then do:
     1136                       os-delete value( v-filename ).
     1137                   end.
     1138               end.
     1139           end.
     1140       end.
     1141       else do:
     1142           assign
     1143               v-prnfilen-excel-file-exist = yes
     1144           .
     1145       end.
     1146       if check-xslt-files() then
     1147           do:
     1148               v-prnfilen-excel-file-exist = true.
     1149           end.
     1150       end.
     1151   end.
     1152   END PROCEDURE.
     1153   PROCEDURE update-history :
     1154     define input  parameter p-message as character no-undo .
     1155     define variable lok as logical   no-undo .
     1156     do with frame DIALOG-1
     1157     on error undo, return error
     1158     :
     1159       assign
     1160         lok = EDITOR-history :move-to-eof( )
     1161         lok = EDITOR-history :insert-string( p-message + chr(10) )
     1162         lok = EDITOR-history :move-to-eof( )
     1163       .
     1164     end.
     1165   END PROCEDURE.
     1166   procedure xslt-transform:
     1167       def var rnd-file-name as char no-undo.
     1168       run gbl/_tmpfile.p("", ".xls", output rnd-file-name).
     1169       def var xslt-path as char no-undo.
     1170       xslt-path = search("exe\xslt.exe").
     1171       os-command silent value(xslt-path + " -config " + p-file-name + ".xslt-cfg").
     1172       def var excel as com-handle no-undo.
     1173       create "Excel.Application" excel no-error.
     1174       if not ERROR-STATUS:ERROR then
     1175           do:
     1176               excel:Visible = false.
     1177               excel:DisplayAlerts = false.
     1178               excel:Workbooks:open(p-file-name + ".xslt-res").
     1179               excel:Visible = true.
     1180               excel:ActiveWorkBook:SaveAs(rnd-file-name,-4143, , , , , ).
     1181               release object excel no-error.
     1182               if error-status:ERROR then
     1183                   message "Не удалось освободить com-component->excel"
     1184                       view-as alert-box.
     1185           end.
     1186       else
     1187           message "Не удалось создать com-component->excel" view-as alert-box.
     1188   end.
     1189   function check-xslt-files returns logical:
     1190       if search(p-file-name + ".xslt-cfg") = ? then return false.
     1191       input stream cfg-stream from value(p-file-name + ".xslt-cfg").
     1192       def var str as char no-undo.
     1193       def var ret-val as logical no-undo initial false.
     1194       repeat:
     1195           import stream cfg-stream unformatted str.
     1196           if str begins "merge_file=" then ret-val = true.
     1197       end.
     1198       output stream cfg-stream close.
     1199       return ret-val.
     1200   end.
     1201   procedure clear-temp-xslt-files:
     1202     os-delete value(p-file-name + ".xslt-cfg") no-error.
     1203     os-delete value(p-file-name + ".xslt-res") no-error.
     1204     os-delete value(p-file-name + ".xslt-data") no-error.
     1205     os-delete value(p-file-name + ".xslt-merged") no-error.
     1206   end.
