        1   define input parameter p-filter-old     as character        no-undo.
        2   define output parameter p-filter-new    as character        no-undo.
        3   define output parameter p-accepted      as logical          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Фильтр для двухоконного интерфейса".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   DEFINE BUTTON b-cancel AUTO-END-KEY
      110        LABEL "&Отмена"
      111        SIZE 10 BY 1
      112        BGCOLOR 8 .
      113   DEFINE BUTTON b-exit AUTO-GO
      114        LABEL "В&вод"
      115        SIZE 10 BY 1
      116        BGCOLOR 8 .
      117   DEFINE BUTTON b-help
      118        LABEL "Помо&щь"
      119        SIZE 10 BY 1
      120        BGCOLOR 8 .
      121   DEFINE VARIABLE fi-filter AS CHARACTER FORMAT "X(256)":U
      122        LABEL "Строка фильтра"
      123        VIEW-AS FILL-IN
      124        SIZE 23 BY 1 NO-UNDO.
      125   DEFINE FRAME Dialog-Frame
      126        b-exit AT ROW 1 COL 1
      127        b-cancel AT ROW 1 COL 11
      128        b-help AT ROW 1 COL 31.5
      129        fi-filter AT ROW 2.75 COL 16.5 COLON-ALIGNED
      130        SPACE(0.49) SKIP(0.82)
      131       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      132            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      133            TITLE "Фильтр"
      134            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      135   ASSIGN
      136          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      137          FRAME Dialog-Frame:HIDDEN           = TRUE.
      138   ON GO OF FRAME Dialog-Frame
      139   DO:
      140       assign
      141           fi-filter
      142       .
      143       if fi-filter <> p-filter-old
      144       then do:
      145           assign
      146               p-filter-new    = fi-filter
      147               p-accepted      = yes
      148           .
      149       end.
      150       else do:
      151           assign
      152               p-accepted      = no
      153           .
      154       end.
      155   END.
      156   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      157   DO:
      158     APPLY "END-ERROR":U TO SELF.
      159   END.
      160   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      161   DO:
      162   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   if lookup(self :type
      164            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      165            ) = 0
      166   then do:
      167     message
      168       "$Workfile$"
      169       "Указанному интерфейсному элементу фокус не может быть передан" skip
      170       "Интерфейсный элемент" self :name  skip
      171       "Тип" self :type  skip
      172       "Процедура" this-procedure :file-name skip
      173       view-as alert-box .
      174   end.
      175   else do:
      176     apply "entry":u to self  .
      177     if focus :handle <> self :handle  then do:
      178       return no-apply .
      179     end.
      180   end.
      181   END.
      182   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   on help of frame Dialog-Frame
      184   do:
      185     run gbl/app_help.p
      186       (input this-procedure :file-name
      187       ,input ''
      188       ,input ?
      189       ) no-error.
      190     if error-status :error then do:
      191       message
      192         "Ошибка при вызове помощи"
      193         error-status :get-message(1)
      194         view-as alert-box .
      195     end.
      196   end.
      197   run minbtn-set in this-procedure .
      198   on choose of b-help in frame Dialog-Frame
      199   do:
      200     apply "help":u to frame Dialog-Frame .
      201   end.
      202   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      203   procedure minbtn-set :
      204       do
      205           on error undo, return error return-value
      206           :
      207           define variable ii              as integer       no-undo .
      208           define variable fh              as widget-handle no-undo .
      209           define variable hh              as widget-handle no-undo .
      210           define variable v-h             as handle        extent 4 no-undo .
      211           define variable v-name-button   as character     no-undo .
      212           define variable v-help-old-x    as decimal       no-undo .
      213           define variable v-help-old-y    as decimal       no-undo .
      214           define variable v-help-old-size as decimal       no-undo .
      215           define variable v-frame-width   as decimal       no-undo .
      216           define variable jj              as integer       no-undo .
      217           do
      218               on error undo, return error
      219               :
      220               assign
      221                   v-frame-width = frame Dialog-Frame:width - 0.3
      222                   fh            = frame Dialog-Frame:first-child
      223                   hh            = fh:first-child
      224                   ii            = 1
      225                   .
      226               do while valid-handle(hh):
      227                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      228                   do:
      229                       case lc(hh:name) :
      230                           when "b-help" then
      231                               do:
      232                                   hh:load-image-up("cmp/b-help.bmp":u) .
      233                                   hh:load-image-down("cmp/b-help.bmp":u) .
      234                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      235                                   hh:TOOLTIP = "Помощь" .
      236                                   v-help-old-x = hh:column .
      237                                   v-help-old-y = hh:row    .
      238                                   v-help-old-size = hh:width .
      239                                   hh:width-chars = 2.5 .
      240                               end.
      241                           when "b-print" then
      242                               do:
      243                                   hh:load-image("cmp/b-print.bmp":u) .
      244                                   hh:TOOLTIP = "Печать" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-history" or
      250                           when "b-hist" then
      251                               do:
      252                                   hh:load-image("cmp/b-hist.bmp":u) .
      253                                   hh:TOOLTIP = "История" .
      254                                   v-h[ii] = hh:handle .
      255                                   ii = ii + 1 .
      256                                   hh:width-chars = 3 .
      257                               end.
      258                           when "b-sch" then
      259                               do:
      260                                   hh:load-image("cmp/b-sch.bmp":u) .
      261                                   hh:TOOLTIP = "Установка Фильтра" .
      262                                   v-h[ii] = hh:handle .
      263                                   ii = ii + 1 .
      264                                   hh:width-chars = 3 .
      265                               end.
      266                           when "b-hist-user" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История пользователя" .
      270                                   ii = ii + 1 .
      271                               end.
      272                       end case.
      273                   end.
      274                   hh = hh:next-sibling.
      275               end.
      276               b-help:column = v-frame-width - b-help:width-chars.
      277               jj = 0.
      278               repeat ii = 4 to 1 by -1 :
      279                   if valid-handle (v-h[ii] ) then
      280                   do:
      281                       jj  = jj + 1 .
      282                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      283                       v-h[ii]:row    = v-help-old-y .
      284                   end.
      285               end.
      286           end.
      287       end.
      288   end procedure.
      289   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      290   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      291   MAIN-BLOCK:
      292   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      293      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      294     run init-fields in this-procedure .
      295     RUN enable_UI.
      296     apply "entry":U to fi-filter.
      297     WAIT-FOR GO OF FRAME Dialog-Frame.
      298   END.
      299   RUN disable_UI.
      300   PROCEDURE disable_UI :
      301     HIDE FRAME Dialog-Frame.
      302   END PROCEDURE.
      303   PROCEDURE enable_UI :
      304     DISPLAY fi-filter
      305         WITH FRAME Dialog-Frame.
      306     ENABLE b-exit b-cancel b-help fi-filter
      307         WITH FRAME Dialog-Frame.
      308     VIEW FRAME Dialog-Frame.
      309   END PROCEDURE.
      310   PROCEDURE init-fields :
      311   do
      312   on error undo, return error
      313   :
      314       assign
      315           fi-filter = p-filter-old
      316       .
      317   end.
      318   END PROCEDURE.
