        1   block-level on error undo, throw.
        2   define variable vss-revision       as character no-undo init "$Revision: d076eddfa1e9, 1505, rls $":U .
        3       define variable vss-author         as character no-undo init "$Author: SMMolotkov $":U .
        4       define variable vss-date           as character no-undo init "$Date: Thu Aug 30 10:41:48 2018 +0300 $":U .
        5       define variable vss-workfile       as character no-undo init "$Workfile: uobjsman.p $":U .
        6       define variable vss-archive        as character no-undo init "$Archive: gbl/uobjsman.p $":U .
        7       define variable vss-description    as character no-undo init "Экранные триггеры промо-акций".
        8   define input  parameter parparentproc   as handle no-undo .
        9     define input  parameter p-db-num        as integer   no-undo .
       10     define input  parameter p-user-id       as character no-undo .
       11     define input  parameter p-host-code-obj as integer   no-undo .
       12     define input  parameter p-obj-type      as character no-undo .
       13     define input  parameter p-obj-code      as integer   no-undo .
       14     define output parameter p-user-select   as logical   no-undo .
       15   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       16   define temp-table userobjs_temp-user-obj no-undo
       17     field obj-type as character
       18     field obj-code as integer
       19     index xpk is primary unique obj-type obj-code
       20     .
       21   procedure userobjs_clear :
       22     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       23     do
       24     on error undo, return error return-value
       25     :
       26       for each buf_userobjs_temp-user-obj
       27       on error undo, return error return-value
       28       :
       29         delete buf_userobjs_temp-user-obj .
       30       end.
       31     end.
       32   end .
       33   procedure userobjs_object-count :
       34     define output parameter p-total-count as integer   no-undo .
       35     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       36     do
       37     on error undo, return error return-value
       38     :
       39       assign
       40         p-total-count = 0
       41       .
       42       for each buf_userobjs_temp-user-obj
       43       on error undo, return error return-value
       44       :
       45         assign
       46           p-total-count = p-total-count + 1
       47         .
       48       end.
       49     end.
       50   end.
       51   procedure userobjs_append :
       52      define input  parameter p-obj-type as character no-undo .
       53      define input  parameter p-obj-code as integer   no-undo .
       54     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       55     do
       56     on error undo, return error return-value
       57     :
       58       find first buf_userobjs_temp-user-obj
       59         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
       60           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
       61         no-error .
       62       if not available buf_userobjs_temp-user-obj
       63       then do:
       64         create buf_userobjs_temp-user-obj .
       65         assign
       66           buf_userobjs_temp-user-obj.obj-type = p-obj-type
       67           buf_userobjs_temp-user-obj.obj-code = p-obj-code
       68         .
       69       end.
       70     end.
       71   end.
       72   procedure userobjs_object-exist :
       73     define output parameter p-object-exist as logical   no-undo .
       74     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       75     do
       76     on error undo, return error return-value
       77     :
       78       find first buf_userobjs_temp-user-obj
       79         no-error .
       80       if not available buf_userobjs_temp-user-obj
       81       then do:
       82         assign
       83           p-object-exist = false
       84         .
       85       end.
       86       else do:
       87         assign
       88           p-object-exist = true
       89         .
       90       end.
       91     end.
       92   end.
       93   procedure userobjs_transfer :
       94     define input  parameter p-callback-handle as handle no-undo .
       95     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
       96     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       97     do
       98     on error undo, return error return-value
       99     :
      100       if valid-handle(p-callback-handle) <> true
      101       then do:
      102         message
      103           vss-workfile vss-revision vss-description skip
      104           "Ошибка задания входных параметров" skip
      105           "Неизвестный указатель на процедуру" skip
      106           view-as alert-box error .
      107         undo, return error return-value .
      108       end.
      109       if p-callback-handle :get-signature("userobjs_append") = ""
      110       then do:
      111         message
      112           vss-workfile vss-revision vss-description skip
      113           "Ошибка задания входных параметров" skip
      114           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      115                     ,p-callback-handle :file-name
      116                     ) skip
      117           view-as alert-box error .
      118         undo, return error return-value .
      119       end.
      120       for each buf_userobjs_temp-user-obj
      121       on error undo, return error return-value
      122       :
      123         run userobjs_append in p-callback-handle
      124           (input  buf_userobjs_temp-user-obj.obj-type
      125           ,input  buf_userobjs_temp-user-obj.obj-code
      126           ) .
      127       end.
      128     end.
      129   end procedure.
      130   procedure userobjs_select-one :
      131      define input  parameter parparentproc     as widget-handle no-undo .
      132      define input  parameter p-db-num          as integer   no-undo .
      133      define input  parameter p-user-id         as character no-undo .
      134      define input  parameter p-host-code-obj   as integer   no-undo .
      135      define input  parameter p-obj-type        as character no-undo .
      136      define input  parameter p-obj-code        as integer   no-undo .
      137      define output parameter p-user-select     as logical   no-undo .
      138      define output parameter p-select-obj-type as character no-undo .
      139      define output parameter p-select-obj-code as character no-undo .
      140     do
      141     on error undo, return error return-value
      142     :
      143       run gbl/userobjs.w
      144         (input  parparentproc
      145         ,input  this-procedure :handle
      146         ,input  p-db-num
      147         ,input  p-user-id
      148         ,input  p-host-code-obj
      149         ,input  p-obj-type
      150         ,input  p-obj-code
      151         ,INPUT  "b-sel"
      152         ,output p-user-select
      153         ,output p-select-obj-type
      154         ,output p-select-obj-code
      155         ) .
      156     end.
      157   end.
      158   procedure userobjs_select-many :
      159     define input  parameter parparentproc   as widget-handle no-undo .
      160     define input  parameter p-db-num        as integer   no-undo .
      161     define input  parameter p-user-id       as character no-undo .
      162     define input  parameter p-host-code-obj as integer   no-undo .
      163     define input  parameter p-obj-type      as character no-undo .
      164     define input  parameter p-obj-code      as integer   no-undo .
      165     define output parameter p-user-select   as logical   no-undo .
      166     define variable v-select-obj-type as character no-undo .
      167     define variable v-select-obj-code as integer   no-undo .
      168     do
      169     on error undo, return error return-value
      170     :
      171       run gbl/userobjs.w
      172         (input  parparentproc
      173         ,input  this-procedure :handle
      174         ,input  p-db-num
      175         ,input  p-user-id
      176         ,input  p-host-code-obj
      177         ,input  p-obj-type
      178         ,input  p-obj-code
      179         ,INPUT  "b-sel,b-mark"
      180         ,output p-user-select
      181         ,output v-select-obj-type
      182         ,output v-select-obj-code
      183         ) .
      184     end.
      185   end.
      186   procedure thobjs :
      187      define input        parameter parparentproc     as widget-handle no-undo .
      188      define input        parameter i-bttns           as character     no-undo .
      189      define input        parameter i-list-mode       as character     no-undo.
      190      define input        parameter i-obj-type        as character     no-undo.
      191      define input        parameter i-db-num          as integer       no-undo.
      192      define input        parameter i-host-code       as integer       no-undo.
      193      define input-output parameter p-rid-list        as character     no-undo .
      194   run ref/thobjs.p
      195           ( input parparentproc
      196            ,input  this-procedure :handle
      197           , input i-bttns
      198           , input i-list-mode
      199           , input i-obj-type
      200           , input i-db-num
      201           , input i-host-code
      202           , input-output p-rid-list ) no-error .
      203   end.
      204     define output parameter table for userobjs_temp-user-obj .
      205   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   run userobjs_select-many in this-procedure
      207     (input  parparentproc
      208     ,input  p-db-num
      209     ,input  p-user-id
      210     ,input  p-host-code-obj
      211     ,input  p-obj-type
      212     ,input  p-obj-code
      213     ,output p-user-select
      214     )  .
