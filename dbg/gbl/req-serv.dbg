        1   block-level on error undo, throw.
        2   define input  parameter p-callback-handle as handle    no-undo .
        3   define input  parameter p-in-directory    as character no-undo .
        4   define input  parameter p-out-directory   as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: req-serv.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/req-serv.p $":U .
       10   define variable vss-description as character no-undo init "Программа разбора запросов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define stream dir-list .
       66   define stream sinp .
       67   define temp-table temp-filelist no-undo
       68     field file-name        as character
       69     field file-name-no-ext as character
       70     field file-extension   as character
       71     index xpk is unique primary file-name
       72     index xie1 file-name-no-ext
       73     .
       74   do
       75   on error undo, return error return-value
       76   :
       77     define variable v-num-request as integer no-undo .
       78     run w-reqsrv_show-description in p-callback-handle
       79       (input  "Сервер запущен"
       80       ) .
       81     run gbl/dirwatch.p
       82       (input  this-procedure
       83       ,input  "check-directory"
       84       ,input  p-in-directory
       85       ) .
       86   end.
       87   procedure check-directory :
       88     define output parameter p-terminate-watch as logical no-undo .
       89     define buffer buf_temp-filelist for temp-filelist .
       90     do
       91     on error undo, return error return-value
       92     :
       93       for each buf_temp-filelist
       94       :
       95         delete buf_temp-filelist .
       96       end.
       97       input stream dir-list from os-dir( p-in-directory ).
       98       define variable v-file                  as character no-undo .
       99       define variable v-path                  as character no-undo .
      100       define variable v-mask                  as character no-undo .
      101       define variable v-extension             as character no-undo .
      102       define variable v-file-name-without-ext as character no-undo .
      103       repeat
      104       on error undo, return error
      105       :
      106         import stream dir-list v-file v-path v-mask .
      107         if  v-mask <> ?
      108         and v-mask begins 'F':u
      109         then do:
      110         end.
      111         else do:
      112           next .
      113         end.
      114         if num-entries(v-file, '.':u) > 1
      115         then do:
      116           assign
      117             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      118             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      119           .
      120         end.
      121         else do:
      122           assign
      123             v-extension = ''
      124             v-file-name-without-ext = v-file
      125           .
      126         end.
      127         if v-extension = 'txt':u
      128         then do:
      129           create buf_temp-filelist .
      130           assign
      131             buf_temp-filelist.file-name        = v-file
      132             buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      133             buf_temp-filelist.file-extension   = v-extension
      134           .
      135         end.
      136       end.
      137       input stream dir-list close .
      138       define variable v-ip-address     as character no-undo .
      139       define variable v-request        as character no-undo .
      140       define variable v-post-data      as character no-undo .
      141       define variable v-request-ok     as logical   no-undo .
      142       define variable v-error-message  as character no-undo .
      143       file_scan :
      144       for each buf_temp-filelist
      145       :
      146         assign
      147           v-num-request = v-num-request + 1
      148           v-request-ok  = true
      149         .
      150         define variable v-check-file-name as character no-undo .
      151         define variable v-open-ok         as logical   no-undo .
      152         define variable v-error-code      as integer   no-undo .
      153         assign
      154           v-check-file-name = p-in-directory + '/':u + buf_temp-filelist.file-name
      155         .
      156         define variable v-try-index as integer   no-undo .
      157         assign
      158           v-try-index = 0
      159         .
      160         define variable v-show-error as logical   no-undo .
      161         assign
      162           v-show-error = true
      163         .
      164         wait_open :
      165         do while true
      166         :
      167           assign
      168             v-try-index = v-try-index + 1
      169           .
      170           if v-try-index > 1000
      171           then do:
      172             next file_scan .
      173           end.
      174           run check-open in this-procedure
      175             (input  v-check-file-name
      176             ,output v-open-ok
      177             ,output v-error-code
      178             ) .
      179           if v-open-ok = true
      180           then do:
      181             leave wait_open .
      182           end.
      183           if v-show-error = true
      184           then do:
      185             assign
      186               v-show-error = false
      187             .
      188             run w-reqsrv_show-request in p-callback-handle
      189               (input  substitute("&1 Ошибка открытия файла &2"
      190                                 ,buf_temp-filelist.file-name
      191                                 ,v-error-code
      192                                 )
      193               ) .
      194           end.
      195         end.
      196         run w-reqsrv_process-request in p-callback-handle
      197           (input  buf_temp-filelist.file-name
      198           ) .
      199       end.
      200       run w-reqsrv_check-stop in p-callback-handle
      201         (output p-terminate-watch
      202         ) .
      203     end.
      204   end procedure .
      205   procedure check-open :
      206     define input  parameter p-file-name  as character no-undo .
      207     define output parameter p-open-ok    as logical   no-undo .
      208     define output parameter p-error-code as integer   no-undo .
      209     do
      210     on error undo, return error return-value
      211     :
      212       define variable v-memptr-file-name as memptr no-undo .
      213       define variable v-file-handle      as integer   no-undo .
      214       define variable v-error-value      as integer   no-undo .
      215       define variable v-result           as integer   no-undo .
      216       assign
      217         set-size(v-memptr-file-name) = length(p-file-name) + 1
      218       .
      219       assign
      220         put-string(v-memptr-file-name, 1) = p-file-name
      221       .
      222       run CreateFileA
      223         (input  get-pointer-value(v-memptr-file-name)
      224         ,input  -2147483648
      225         ,input  1
      226         ,input  0
      227         ,input  3
      228         ,input  128
      229         ,input  0
      230         ,output v-file-handle
      231         ) .
      232       assign
      233         set-size(v-memptr-file-name) = 0
      234       .
      235       if v-file-handle = -1
      236       then do:
      237         run GetLastError
      238           (output v-error-value
      239           ) .
      240         run Sleep
      241           (input 10
      242           ) .
      243         assign
      244           p-open-ok    = false
      245           p-error-code = v-error-value
      246         .
      247       end.
      248       else do:
      249         assign
      250           p-open-ok    = true
      251           p-error-code = 0
      252         .
      253       end.
      254       run CloseHandle
      255         (input  v-file-handle
      256         ,output v-result
      257         ) .
      258     end.
      259   end procedure.
      260   PROCEDURE CreateFileA EXTERNAL "kernel32.dll"
      261   :
      262       DEFINE INPUT        PARAMETER lpFileName            AS LONG .
      263       DEFINE INPUT        PARAMETER dwDesiredAccess       AS LONG .
      264       DEFINE INPUT        PARAMETER dwShareMode           AS LONG .
      265       DEFINE INPUT        PARAMETER lpSecurityAttributes  AS LONG .
      266       DEFINE INPUT        PARAMETER dwCreationDisposition AS LONG .
      267       DEFINE INPUT        PARAMETER dwFlagsAndAttributes  AS LONG .
      268       DEFINE INPUT        PARAMETER hTemplateFile         AS LONG .
      269       DEFINE RETURN       PARAMETER RetParam              AS LONG .
      270   END PROCEDURE.
      271   PROCEDURE CloseHandle EXTERNAL "kernel32.dll"
      272   :
      273       DEFINE INPUT        PARAMETER hObject   AS LONG .
      274       DEFINE RETURN       PARAMETER RetParam  AS LONG .
      275   END PROCEDURE.
      276   PROCEDURE GetLastError EXTERNAL "kernel32.dll"
      277   :
      278       DEFINE RETURN       PARAMETER RetParam  AS LONG .
      279   END PROCEDURE.
      280   PROCEDURE Sleep EXTERNAL "kernel32.dll"
      281   :
      282       DEFINE INPUT        PARAMETER pMilliseconds AS LONG .
      283   END PROCEDURE.
