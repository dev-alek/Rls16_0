        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: 3ac8d1d44d52, 3383, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        5   define variable vss-date        as character no-undo init "$Date: 2023/05/31 09:28:12 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: actn-upd.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: gbl/actn-upd.p $":U .
        8   define variable vss-description as character no-undo init "Проверка и загрузка прав доступа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   procedure get-ro_get-read-only :
      321     define output parameter p-ro-set as logical   no-undo .
      322     do
      323     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info1, return-value, error-status :get-message( 1 ) )
      324     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info1 )
      325     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info1 )
      326     :
      327       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      328       then do:
      329         assign
      330           p-ro-set = true
      331         .
      332       end.
      333       else do:
      334         assign
      335           p-ro-set = false
      336         .
      337       end.
      338     end.
      339   end procedure.
      340   define temp-table temp-action-group no-undo
      341     field action-group-code          as integer
      342     field action-group-id            as character
      343     field action-group-name          as character
      344     field action-group-description   as character
      345     field action-group-configuration as character
      346     index xpk is primary unique action-group-code
      347     index xie1 action-group-id
      348   .
      349   define temp-table temp-action-item no-undo
      350     field action-item-code           as integer
      351     field action-item-id             as character
      352     field action-item-context        as character
      353     field action-item-configuration  as character
      354     field action-group-code          as integer
      355     field action-group-id            as character
      356     field action-item-name           as character
      357     field action-item-description    as character
      358     field action-item-encoded        as character
      359     index xpk is primary unique action-item-code
      360     index xie1 action-item-id
      361   .
      362   define temp-table temp-action-item-attr no-undo
      363     field action-item-code           as integer
      364     field attr-code                  as character
      365     field attr-value                 as character
      366     index xpk is primary unique action-item-code
      367   .
      368     define buffer buf_global-state             for ub.global-state .
      369     define buffer buf_global-state-attr        for ub.global-state-attr .
      370     define variable v-action-gbl               as logical no-undo .
      371   define buffer buf_batchprocess for ub.batchprocess .
      372   define variable v-action-head-code as integer   no-undo .
      373   define stream sinp .
      374   do
      375   on error undo, return error return-value
      376   :
      377     assign
      378       v-action-head-code = 0
      379     .
      380          FIND FIRST buf_global-state
      381           NO-LOCK
      382           .
      383      FIND FIRST buf_global-state-attr
      384           WHERE buf_global-state-attr.gls-id    = buf_global-state.gls-id
      385             AND buf_global-state-attr.attr-code = "action-gbl"
      386           NO-LOCK
      387           NO-error
      388           .
      389           if available (buf_global-state-attr) then v-action-gbl = logical (buf_global-state-attr.attr-value) .
      390     run check-action-item in this-procedure
      391       .
      392   end.
      393   procedure check-action-item :
      394     define variable v-action-db-control-number   as character no-undo .
      395     define variable v-action-file-name           as character no-undo .
      396     define variable v-action-file-control-number as character no-undo .
      397     define variable v-sys-key                    as character no-undo .
      398     define variable v-get-ro_read-only           as logical   no-undo .
      399     define buffer buf_action-head for ub.action-head .
      400     do
      401     on error undo, return error return-value
      402     :
      403       run get-action-db-control-number in this-procedure
      404         (output v-action-db-control-number
      405         ) .
      406       run get-action-file-name in this-procedure
      407         (output v-action-file-name
      408         ) .
      409       if v-action-file-name = ""
      410       or v-action-file-name = ?
      411       then do:
      412         message
      413           vss-workfile vss-revision vss-description skip
      414           "Не найден файл с описание прав" "cmp/actn.enc" skip
      415           "Работа системы будет продолжена, но возможно некоторые функции системы" skip
      416           "работать не будут" skip
      417           view-as alert-box error .
      418         return .
      419       end.
      420       run get-action-file-control-number in this-procedure
      421         (input  v-action-file-name
      422         ,output v-action-file-control-number
      423         ) .
      424       if v-action-db-control-number <> v-action-file-control-number
      425       then do:
      426         assign
      427           v-get-ro_read-only = false
      428         .
      429         run get-ro_get-read-only in this-procedure
      430           ( output v-get-ro_read-only
      431           ) .
      432         if v-get-ro_read-only = false then do:
      433   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
      435     (output v-sys-key
      436     ) no-error .
      437           if v-sys-key = 'ExpertekIBS':U
      438           then do:
      439             define variable v-ok as logical   no-undo .
      440             message
      441               "Описание прав изменилось" skip
      442               "Контрольный номер в базе данных" v-action-db-control-number skip
      443               "Контрольный номер в файле"       v-action-file-control-number skip
      444               "Путь к файлу" v-action-file-name skip
      445               "Загрузить в базу данных описание прав?"
      446               view-as alert-box question buttons yes-no update v-ok .
      447             if v-ok <> true
      448             then do:
      449               return .
      450             end.
      451           end.
      452           do transaction
      453           on error undo, return error return-value
      454           :
      455             run lock-action-head in this-procedure
      456               (buffer buf_action-head
      457               ) .
      458             if buf_action-head.action-head-control-number = v-action-file-control-number
      459             then do:
      460                   DELETE buf_batchprocess.
      461               return .
      462             end.
      463             run read-action-item in this-procedure
      464               (input v-action-file-name
      465               ) .
      466             run validate-action-item in this-procedure
      467               no-error .
      468             if  error-status :error
      469             then do:
      470               if v-sys-key = 'ExpertekIBS':U
      471               then do:
      472                 assign
      473                   v-ok = false
      474                 .
      475                 message
      476                   "При проверке прав были обнаружены ошибки" skip
      477                   "Загрузить в базу данных описание прав?"
      478                   view-as alert-box question buttons yes-no update v-ok .
      479                 if v-ok <> true
      480                 then do:
      481                     DELETE buf_batchprocess.
      482                   return .
      483                 end.
      484               end.
      485               else do:
      486                 message
      487                   vss-workfile vss-revision vss-description skip
      488                   "При проверке прав были обнаружены ошибки" skip
      489                   "Права не были загружены" skip
      490                   error-status :get-message(1) skip
      491                   return-value skip
      492                   view-as alert-box error .
      493                   DELETE buf_batchprocess.
      494                 return .
      495               end.
      496             end.
      497             run clear-action in this-procedure .
      498             run write-action in this-procedure .
      499             run update-action-role-item in this-procedure .
      500             run update-user-login-action-item in this-procedure .
      501             assign
      502               buf_action-head.action-head-control-number = v-action-file-control-number
      503             .
      504             DELETE buf_batchprocess.
      505           end.
      506         end.
      507         else do:
      508           message
      509             vss-workfile vss-revision vss-description skip(1)
      510             substitute("Описание прав изменилось") skip
      511             substitute("До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!") skip
      512             view-as alert-box error .
      513           return error .
      514         end.
      515       end.
      516       run waitfram-hide in this-procedure .
      517     end.
      518   end procedure.
      519   procedure get-action-db-control-number :
      520     define output parameter p-action-db-control-number as character no-undo .
      521     define buffer buf_action-head for ub.action-head .
      522     do
      523     on error undo, return error return-value
      524     :
      525       find first buf_action-head no-lock
      526         where buf_action-head.action-head-code = v-action-head-code
      527         no-error .
      528       if available buf_action-head
      529       then do:
      530         assign
      531           p-action-db-control-number = buf_action-head.action-head-control-number
      532         .
      533       end.
      534       else do:
      535         assign
      536           p-action-db-control-number = '':u
      537         .
      538       end.
      539     end.
      540   end procedure.
      541   procedure get-action-file-name :
      542     define output parameter p-action-file-name as character no-undo .
      543     do
      544     on error undo, return error return-value
      545     :
      546       assign
      547         p-action-file-name = search("cmp/actn.enc")
      548       .
      549     end.
      550   end procedure.
      551   procedure get-action-file-control-number :
      552     define input  parameter p-action-file-name           as character no-undo .
      553     define output parameter p-action-file-control-number as character no-undo .
      554     define variable v-str-encrypt        as character no-undo .
      555     do
      556     on error undo, return error return-value
      557     :
      558       SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      559       input stream sinp from value(p-action-file-name) .
      560       import stream sinp UNFORMATTED v-str-encrypt .
      561   define variable vss-include-info3 as character format "X(65)" no-undo
      562   initial "@(#)$Workfile$ $Revision$".
      563   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      564     (input  v-str-encrypt
      565     ,output p-action-file-control-number
      566     )  .
      567       ASSIGN
      568          p-action-file-control-number = TRIM(p-action-file-control-number, '~" ')
      569       .
      570       input stream sinp close .
      571     end.
      572   end procedure.
      573   procedure lock-action-head :
      574     define parameter buffer buf_action-head for ub.action-head .
      575     do
      576     on error undo, return error return-value
      577     :
      578       find first buf_action-head exclusive-lock
      579         where buf_action-head.action-head-code = v-action-head-code
      580         no-error .
      581       if not available buf_action-head
      582       then do:
      583         create buf_action-head .
      584         assign
      585           buf_action-head.action-head-code           = v-action-head-code
      586           buf_action-head.action-head-name           = "Системные права"
      587           buf_action-head.action-head-control-number = ""
      588         .
      589       end.
      590       for each  buf_batchprocess
      591           where buf_batchprocess.bp_type     = "actn-update":U
      592             and buf_batchprocess.bp_status   = 'N':U
      593           exclusive-lock
      594            :
      595            DELETE buf_batchprocess.
      596       END.
      597       create buf_batchprocess .
      598       assign
      599          buf_batchprocess.bp_type        = "actn-update":U
      600          buf_batchprocess.bp_status      = 'N':U
      601          buf_batchprocess.batchprocess#  = next-value(s-btpr, ub)
      602          buf_batchprocess.bp_sysdate     = TODAY
      603          buf_batchprocess.bp_systime     = string( time, 'hh:mm' )
      604          buf_batchprocess.bp_systimeint  = TIME
      605       .
      606     end.
      607   end procedure.
      608   procedure read-action-item :
      609     define input  parameter p-action-file-name as character no-undo .
      610     define buffer buf_action-head            for ub.action-head .
      611     define buffer buf_action-item            for ub.action-item .
      612     define buffer buf_temp-action-group      for temp-action-group .
      613     define buffer buf_temp-action-item       for temp-action-item .
      614     define buffer buf_temp-action-item-attr  for temp-action-item-attr .
      615     define variable v-action-head-control-number as character no-undo .
      616     define variable v-tag-name                   as character no-undo .
      617     define variable v-action-group-code          as integer   no-undo .
      618     define variable v-action-group-id            as character no-undo .
      619     define variable v-action-group-name          as character no-undo .
      620     define variable v-action-group-description   as character no-undo .
      621     define variable v-action-group-configuration as character no-undo .
      622     define variable v-action-item-code           as integer   no-undo .
      623     define variable v-action-item-id             as character no-undo .
      624     define variable v-action-item-context        as character no-undo .
      625     define variable v-action-item-configuration  as character no-undo .
      626     define variable v-action-item-name           as character no-undo .
      627     define variable v-action-item-description    as character no-undo .
      628     define variable v-action-item-encoded        as character no-undo .
      629     define variable v-action-item-attr-value     as character no-undo .
      630     define variable v-str-encrypt        as character no-undo .
      631     define variable v-str-decrypt        as character no-undo .
      632     define variable v-cc    as integer      no-undo.
      633     do
      634     on error undo, return error return-value
      635     :
      636       input stream sinp from value(p-action-file-name) .
      637       import stream sinp UNFORMATTED v-str-encrypt .
      638       v-cc = v-cc + 1.
      639       assign
      640         v-action-group-code = 0
      641       .
      642       read_action_group:
      643       repeat
      644       :
      645         assign
      646           v-tag-name      = '':u
      647           v-str-encrypt   = '':U
      648         .
      649         import stream sinp UNFORMATTED v-str-encrypt .
      650         v-cc = v-cc + 1.
      651   define variable vss-include-info4 as character format "X(65)" no-undo
      652   initial "@(#)$Workfile$ $Revision$".
      653   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      654     (input  v-str-encrypt
      655     ,output v-tag-name
      656     )  .
      657         v-tag-name = TRIM( v-tag-name , '~" ').
      658         if v-tag-name = 'action-group':u
      659         then do:
      660           assign
      661             v-action-group-code          = v-action-group-code + 1
      662             v-action-group-id            = '':u
      663             v-action-group-name          = '':u
      664             v-action-group-description   = '':u
      665             v-action-group-configuration = '':U
      666             v-str-encrypt                = '':U
      667           .
      668           import stream sinp UNFORMATTED v-str-encrypt .
      669           v-cc = v-cc + 1.
      670   define variable vss-include-info5 as character format "X(65)" no-undo
      671   initial "@(#)$Workfile$ $Revision$".
      672   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      673     (input  v-str-encrypt
      674     ,output v-str-decrypt
      675     )  .
      676           ASSIGN
      677             v-action-group-id            = TRIM(SUBSTRING(v-str-decrypt, 1  , 11), '~" ')
      678             v-action-group-name          = TRIM(SUBSTRING(v-str-decrypt, 12 , 25), '~" ')
      679             v-action-group-description   = TRIM(SUBSTRING(v-str-decrypt, 38 , 40), '~" ')
      680             v-action-group-configuration = TRIM(SUBSTRING(v-str-decrypt, 79 , 14), '~" ')
      681           .
      682           create buf_temp-action-group .
      683           assign
      684             buf_temp-action-group.action-group-code          = v-action-group-code
      685             buf_temp-action-group.action-group-id            = v-action-group-id
      686             buf_temp-action-group.action-group-name          = v-action-group-name
      687             buf_temp-action-group.action-group-description   = v-action-group-description
      688             buf_temp-action-group.action-group-configuration = v-action-group-configuration
      689           .
      690         end.
      691         if v-tag-name = 'action-item':u
      692         then do:
      693           leave read_action_group .
      694         end.
      695       end.
      696       assign
      697         v-action-item-code = 0
      698       .
      699       read_action_item:
      700       repeat
      701       :
      702         assign
      703           v-action-item-code          = v-action-item-code + 1
      704           v-action-item-id            = '':u
      705           v-action-item-context       = '':u
      706           v-action-item-configuration = '':u
      707           v-action-group-id           = '':u
      708           v-action-item-name          = '':u
      709           v-action-item-description   = '':u
      710           v-action-item-encoded       = '':u
      711           v-action-item-attr-value    = '':u
      712           v-str-encrypt               = '':U
      713         .
      714         if v-action-item-code modulo 10 = 0
      715         then do:
      716           run waitfram-show in this-procedure
      717             (input substitute("Обновление прав. Чтение описания прав из файла &1"
      718                              ,v-action-item-code
      719                              )
      720             ) .
      721         end.
      722         import stream sinp UNFORMATTED v-str-encrypt .
      723          v-cc = v-cc + 1.
      724   define variable vss-include-info6 as character format "X(65)" no-undo
      725   initial "@(#)$Workfile$ $Revision$".
      726   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      727     (input  v-str-encrypt
      728     ,output v-str-decrypt
      729     )  .
      730         IF length(v-str-decrypt) > 1 then do:
      731            ASSIGN
      732               v-action-item-id            = TRIM(SUBSTRING(v-str-decrypt, 1  ,  53), '~" ')
      733               v-action-item-context       = TRIM(SUBSTRING(v-str-decrypt, 54 ,   8), '~" ')
      734               v-action-item-configuration = TRIM(SUBSTRING(v-str-decrypt, 63 ,  28), '~" ')
      735               v-action-group-id           = TRIM(SUBSTRING(v-str-decrypt,  92,   9), '~" ')
      736               v-action-item-name          = TRIM(SUBSTRING(v-str-decrypt, 102, 130), '~" ')
      737               v-action-item-description   = TRIM(SUBSTRING(v-str-decrypt, 233, 233), '~" ')
      738               v-action-item-encoded       = TRIM(SUBSTRING(v-str-decrypt, 436,  10), '~" ')
      739               v-action-item-attr-value    = TRIM(SUBSTRING(v-str-decrypt, 467,  50), '~" ')
      740            .
      741         end.
      742         else do:
      743           leave read_action_item.
      744         end.
      745         assign
      746           v-action-item-description = replace(v-action-item-description, "~{&abbr_rubley~}", "рублей")
      747           v-action-item-description = replace(v-action-item-description, "~{&abbr_rublyam_allshift~}", "РУБЛЯМ")
      748         .
      749         if lookup('~{&', v-action-item-description) > 0
      750         then do:
      751           message
      752             vss-workfile vss-revision vss-description skip
      753             "В правах задан препроцессинг для которого не указан способ обработки" skip
      754             "Идентификатор права" v-action-item-id skip
      755             "Имя права" v-action-item-description skip
      756             view-as alert-box error .
      757         end.
      758         find first buf_temp-action-item
      759           where buf_temp-action-item.action-item-id = v-action-item-id
      760           no-error .
      761         if available buf_temp-action-item
      762         then do:
      763           message
      764             vss-workfile vss-revision vss-description skip
      765             "Ошибка при задании права" skip
      766             "Уже создано право с таким же идентификатором" v-action-item-id skip
      767             "action-item-id"             v-action-item-id             skip
      768             "action-item-context"        v-action-item-context        skip
      769             "action-group-configuration" v-action-group-configuration skip
      770             "action-group-id"            v-action-group-id            skip
      771             "action-item-name"           v-action-item-name           skip
      772             "action-item-description"    v-action-item-description    skip
      773             "action-item-encoded"        v-action-item-encoded        skip
      774             view-as alert-box error .
      775         end.
      776         create buf_temp-action-item .
      777         assign
      778           buf_temp-action-item.action-item-code          = v-action-item-code
      779           buf_temp-action-item.action-item-id            = v-action-item-id
      780           buf_temp-action-item.action-item-context       = v-action-item-context
      781           buf_temp-action-item.action-item-configuration = v-action-item-configuration
      782           buf_temp-action-item.action-group-code         = 0
      783           buf_temp-action-item.action-group-id           = v-action-group-id
      784           buf_temp-action-item.action-item-name          = v-action-item-name
      785           buf_temp-action-item.action-item-description   = v-action-item-description
      786           buf_temp-action-item.action-item-encoded       = v-action-item-encoded
      787         .
      788         if length(v-action-item-attr-value) <> 0 then do :
      789           find first buf_temp-action-item-attr
      790             where buf_temp-action-item-attr.action-item-code = v-action-item-code
      791             no-error.
      792           if available buf_temp-action-item-attr
      793           then do:
      794             message
      795               vss-workfile vss-revision vss-description skip
      796               "Ошибка при задании атрибута Linking"                        skip
      797               "Уже существует атрибут"        v-action-item-attr-value     skip
      798               "Для права с идентификатором"   v-action-item-id             skip
      799               "action-item-context"           v-action-item-context        skip
      800               "action-group-configuration"    v-action-group-configuration skip
      801               "action-group-id"               v-action-group-id            skip
      802               "action-item-name"              v-action-item-name           skip
      803               "action-item-description"       v-action-item-description    skip
      804               "action-item-encoded"           v-action-item-encoded        skip
      805               view-as alert-box error .
      806           end.
      807           create buf_temp-action-item-attr .
      808           assign
      809             buf_temp-action-item-attr.action-item-code = v-action-item-code
      810             buf_temp-action-item-attr.attr-code      = "Linking"
      811             buf_temp-action-item-attr.attr-value     = v-action-item-attr-value
      812           .
      813         end.
      814       end.
      815       input stream sinp close .
      816     end.
      817   end procedure.
      818   procedure filter-configuration-action-group :
      819     define buffer buf_temp-action-group for temp-action-group .
      820     define variable v-configuration-list           as character no-undo .
      821     define variable v-configuration-item           as character no-undo .
      822     define variable v-num-items-configuration-list as integer   no-undo .
      823     define variable v-ind                          as integer   no-undo .
      824     define variable v-enable-item                  as logical   no-undo .
      825     define variable v-check-enable-item            as logical   no-undo .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-action-group
      830       on error undo, return error return-value
      831       :
      832         assign
      833           v-configuration-list = buf_temp-action-group.action-group-configuration
      834         .
      835         if v-configuration-list = '':u
      836         then do:
      837           assign
      838             v-enable-item = true
      839           .
      840         end.
      841         else do:
      842           assign
      843             v-enable-item = false
      844           .
      845           assign
      846             v-num-items-configuration-list = num-entries(v-configuration-list)
      847           .
      848           check_block :
      849           do v-ind = 1 to v-num-items-configuration-list
      850           :
      851             assign
      852               v-configuration-item = entry(v-ind, v-configuration-list)
      853             .
      854             run value(v-configuration-item) in parparentproc
      855               (output v-check-enable-item
      856               ) .
      857             if v-check-enable-item = true
      858             then do:
      859               assign
      860                 v-enable-item = true
      861               .
      862               leave check_block .
      863             end.
      864           end.
      865         end.
      866         if v-enable-item <> true
      867         then do:
      868           delete buf_temp-action-group .
      869         end.
      870       end.
      871     end.
      872   end procedure.
      873   procedure filter-configuration-action-item :
      874     define buffer buf_temp-action-item for temp-action-item .
      875     define buffer buf_temp-action-item-attr for temp-action-item-attr .
      876     define variable v-configuration-list           as character no-undo .
      877     define variable v-configuration-item           as character no-undo .
      878     define variable v-num-items-configuration-list as integer   no-undo .
      879     define variable v-ind                          as integer   no-undo .
      880     define variable v-enable-item                  as logical   no-undo .
      881     define variable v-check-enable-item            as logical   no-undo .
      882     do
      883     on error undo, return error return-value
      884     :
      885       for each buf_temp-action-item
      886       on error undo, return error return-value
      887       :
      888         assign
      889           v-configuration-list = buf_temp-action-item.action-item-configuration
      890         .
      891         if v-configuration-list = '':u
      892         then do:
      893           assign
      894             v-enable-item = true
      895           .
      896         end.
      897         else do:
      898           assign
      899             v-enable-item = false
      900           .
      901           assign
      902             v-num-items-configuration-list = num-entries(v-configuration-list)
      903           .
      904           check_block :
      905           do v-ind = 1 to v-num-items-configuration-list
      906           :
      907             assign
      908               v-configuration-item = entry(v-ind, v-configuration-list)
      909             .
      910             run value(v-configuration-item) in parparentproc
      911               (output v-check-enable-item
      912               ) .
      913             if v-check-enable-item = true
      914             then do:
      915               assign
      916                 v-enable-item = true
      917               .
      918               leave check_block .
      919             end.
      920           end.
      921         end.
      922         if v-enable-item <> true
      923         then do:
      924           find first buf_temp-action-item-attr exclusive-lock
      925             where buf_temp-action-item-attr.action-item-code = buf_temp-action-item.action-item-code
      926             no-error.
      927           if available buf_temp-action-item-attr then do :
      928             delete buf_temp-action-item-attr .
      929           end.
      930           delete buf_temp-action-item .
      931         end.
      932       end.
      933     end.
      934   end procedure.
      935   procedure validate-action-item :
      936     do
      937     on error undo, return error return-value
      938     :
      939     end.
      940   end procedure.
      941   procedure export-action-item :
      942     define buffer buf_action-group for ub.action-group .
      943     define buffer buf_action-item  for ub.action-item .
      944     do
      945     on error undo, return error return-value
      946     :
      947       output to value('actn-export.txt':u) .
      948       for each buf_action-group
      949       on error undo, return error return-value
      950       :
      951         export "action-group" .
      952         export buf_action-group .
      953       end.
      954       for each buf_action-item
      955       on error undo, return error return-value
      956       :
      957         export "action-item" .
      958         export buf_action-item .
      959       end.
      960       output close .
      961     end.
      962   end procedure.
      963   procedure clear-action :
      964     define buffer buf_action-group for ub.action-group .
      965     define buffer buf_action-item  for ub.action-item .
      966     define buffer buf_action-item-attr for ub.action-item-attr .
      967     do
      968     on error undo, return error return-value
      969     :
      970       define variable v-ind as integer   no-undo .
      971       assign
      972         v-ind = 0
      973       .
      974       for each buf_action-group exclusive-lock
      975         where buf_action-group.action-head-code = v-action-head-code
      976       on error undo, return error return-value
      977       :
      978         assign
      979           v-ind = v-ind + 1
      980         .
      981         if v-ind modulo 10 = 0
      982         then do:
      983           run waitfram-show in this-procedure
      984             (input substitute("Обновление прав. Удаление групп прав &1"
      985                             ,v-ind
      986                             )
      987             ) .
      988         end.
      989         delete buf_action-group .
      990       end.
      991       assign
      992         v-ind = 0
      993       .
      994       for each buf_action-item exclusive-lock
      995         where buf_action-item.action-head-code = v-action-head-code
      996       on error undo, return error return-value
      997       :
      998         assign
      999           v-ind = v-ind + 1
     1000         .
     1001         if v-ind modulo 10 = 0
     1002         then do:
     1003           run waitfram-show in this-procedure
     1004             (input substitute("Обновление прав. Удаление прав &1"
     1005                             ,v-ind
     1006                             )
     1007             ) .
     1008         end.
     1009         delete buf_action-item .
     1010       end.
     1011       assign
     1012         v-ind = 0
     1013       .
     1014       for each buf_action-item-attr exclusive-lock
     1015         where buf_action-item-attr.action-head-code = v-action-head-code
     1016       on error undo, return error return-value
     1017       :
     1018         assign
     1019           v-ind = v-ind + 1
     1020         .
     1021         if v-ind modulo 10 = 0
     1022         then do:
     1023           run waitfram-show in this-procedure
     1024             (input substitute("Обновление прав. Удаление атрибутов прав &1"
     1025                             ,v-ind
     1026                             )
     1027             ) .
     1028         end.
     1029         delete buf_action-item-attr .
     1030       end.
     1031     end.
     1032   end procedure.
     1033   procedure write-action :
     1034     define buffer buf_temp-action-group      for temp-action-group .
     1035     define buffer buf_action-group           for ub.action-group .
     1036     define buffer buf_temp-action-item       for temp-action-item .
     1037     define buffer buf_action-item            for ub.action-item .
     1038     define buffer buf_temp-action-item-attr  for temp-action-item-attr .
     1039     define buffer buf_action-item-attr       for ub.action-item-attr .
     1040     define variable v-ind as integer   no-undo .
     1041     do
     1042     on error undo, return error return-value
     1043     :
     1044       assign
     1045         v-ind = v-ind + 1
     1046       .
     1047       for each buf_temp-action-group
     1048       on error undo, return error return-value
     1049       :
     1050         assign
     1051           v-ind = v-ind + 1
     1052         .
     1053         if v-ind modulo 10 = 0
     1054         then do:
     1055           run waitfram-show in this-procedure
     1056             (input substitute("Обновление прав. Создание групп прав &1"
     1057                             ,v-ind
     1058                             )
     1059             ) .
     1060         end.
     1061         create buf_action-group .
     1062         assign
     1063           buf_action-group.action-head-code         = v-action-head-code
     1064           buf_action-group.action-group-code        = buf_temp-action-group.action-group-code
     1065           buf_action-group.action-group-id          = buf_temp-action-group.action-group-id
     1066           buf_action-group.action-group-name        = buf_temp-action-group.action-group-name
     1067           buf_action-group.action-group-description = buf_temp-action-group.action-group-description
     1068         .
     1069       end.
     1070       for each buf_temp-action-item
     1071       on error undo, return error
     1072       :
     1073         assign
     1074           v-ind = v-ind + 1
     1075         .
     1076         if v-ind modulo 10 = 0
     1077         then do:
     1078           run waitfram-show in this-procedure
     1079             (input substitute("Обновление прав. Создание новых прав &1"
     1080                             ,v-ind
     1081                             )
     1082             ) .
     1083         end.
     1084         create buf_action-item .
     1085         assign
     1086           buf_action-item.action-head-code           = v-action-head-code
     1087           buf_action-item.action-item-code           = buf_temp-action-item.action-item-code
     1088           buf_action-item.action-item-id             = buf_temp-action-item.action-item-id
     1089           buf_action-item.action-item-context        = buf_temp-action-item.action-item-context
     1090           buf_action-item.action-group-code          = buf_temp-action-item.action-group-code
     1091           buf_action-item.action-group-id            = buf_temp-action-item.action-group-id
     1092           buf_action-item.action-item-name           = buf_temp-action-item.action-item-name
     1093           buf_action-item.action-item-description    = buf_temp-action-item.action-item-description
     1094           buf_action-item.action-item-encoded        = buf_temp-action-item.action-item-encoded
     1095         .
     1096       end.
     1097       for each buf_temp-action-item-attr
     1098       on error undo, return error
     1099       :
     1100         assign
     1101           v-ind = v-ind + 1
     1102         .
     1103         if v-ind modulo 10 = 0
     1104         then do:
     1105           run waitfram-show in this-procedure
     1106             (input substitute("Обновление прав. Создание атрибутов новых прав &1"
     1107                             ,v-ind
     1108                             )
     1109             ) .
     1110         end.
     1111         create buf_action-item-attr .
     1112         assign
     1113           buf_action-item-attr.action-head-code = v-action-head-code
     1114           buf_action-item-attr.action-item-code = buf_temp-action-item-attr.action-item-code
     1115           buf_action-item-attr.attr-code        = buf_temp-action-item-attr.attr-code
     1116           buf_action-item-attr.attr-value       = buf_temp-action-item-attr.attr-value
     1117         .
     1118       end.
     1119     end.
     1120   end procedure.
     1121   procedure update-action-role-item :
     1122     define variable v-current-db-num as integer   no-undo .
     1123     define buffer buf_action-role-item         for ub.action-role-item .
     1124     define buffer buf_action-item              for ub.action-item .
     1125     define buffer buf_action-role-item-gds     for ub.action-role-item-gds .
     1126     define buffer buf_action-role-item-gds-grp for ub.action-role-item-gds-grp .
     1127     do
     1128     on error undo, return error return-value
     1129     :
     1130   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1132     (output v-current-db-num
     1133     )  .
     1134       for each buf_action-role-item exclusive-lock
     1135         where buf_action-role-item.db-num           = v-current-db-num
     1136           and buf_action-role-item.action-head-code = v-action-head-code
     1137       on error undo, return error return-value
     1138       :
     1139         find first buf_action-item no-lock
     1140           where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     1141             and buf_action-item.action-item-id   = buf_action-role-item.action-item-id
     1142           no-error .
     1143         if available buf_action-item
     1144         then do:
     1145           assign
     1146             buf_action-role-item.action-item-code = buf_action-item.action-item-code
     1147           .
     1148           FOR EACH  buf_action-role-item-gds
     1149               where buf_action-role-item-gds.action-head-code       = buf_action-role-item.action-head-code
     1150                 and buf_action-role-item-gds.action-role-code       = buf_action-role-item.action-role-code
     1151                 and buf_action-role-item-gds.action-role-item-code  = buf_action-role-item.action-role-item-code
     1152                 and buf_action-role-item-gds.action-item-id         = buf_action-role-item.action-item-id
     1153               exclusive-lock
     1154               :
     1155               assign
     1156                  buf_action-role-item-gds.action-item-code = buf_action-item.action-item-code
     1157               .
     1158           END.
     1159         end.
     1160         else do:
     1161           FOR EACH  buf_action-role-item-gds
     1162               where buf_action-role-item-gds.action-head-code       = buf_action-role-item.action-head-code
     1163                 and buf_action-role-item-gds.action-role-code       = buf_action-role-item.action-role-code
     1164                 and buf_action-role-item-gds.action-role-item-code  = buf_action-role-item.action-role-item-code
     1165                 and buf_action-role-item-gds.action-item-id         = buf_action-role-item.action-item-id
     1166               exclusive-lock
     1167               :
     1168               assign
     1169                  buf_action-role-item-gds.action-item-code = 0
     1170               .
     1171           END.
     1172           assign
     1173             buf_action-role-item.action-item-code = 0
     1174           .
     1175         end.
     1176       end.
     1177       if v-current-db-num <> 0 and v-action-gbl then do:
     1178          disable triggers for load of buf_action-role-item .
     1179          v-current-db-num = 0 .
     1180          for each buf_action-role-item exclusive-lock
     1181         where buf_action-role-item.db-num           = v-current-db-num
     1182           and buf_action-role-item.action-head-code = v-action-head-code
     1183       on error undo, return error return-value
     1184       :
     1185         find first buf_action-item no-lock
     1186           where buf_action-item.action-head-code = buf_action-role-item.action-head-code
     1187             and buf_action-item.action-item-id   = buf_action-role-item.action-item-id
     1188           no-error .
     1189         if available buf_action-item
     1190         then do:
     1191           assign
     1192             buf_action-role-item.action-item-code = buf_action-item.action-item-code
     1193           .
     1194           FOR EACH  buf_action-role-item-gds
     1195               where buf_action-role-item-gds.action-head-code       = buf_action-role-item.action-head-code
     1196                 and buf_action-role-item-gds.action-role-code       = buf_action-role-item.action-role-code
     1197                 and buf_action-role-item-gds.action-role-item-code  = buf_action-role-item.action-role-item-code
     1198                 and buf_action-role-item-gds.action-item-id         = buf_action-role-item.action-item-id
     1199               exclusive-lock
     1200               :
     1201               assign
     1202                  buf_action-role-item-gds.action-item-code = buf_action-item.action-item-code
     1203               .
     1204           END.
     1205         end.
     1206         else do:
     1207           FOR EACH  buf_action-role-item-gds
     1208               where buf_action-role-item-gds.action-head-code       = buf_action-role-item.action-head-code
     1209                 and buf_action-role-item-gds.action-role-code       = buf_action-role-item.action-role-code
     1210                 and buf_action-role-item-gds.action-role-item-code  = buf_action-role-item.action-role-item-code
     1211                 and buf_action-role-item-gds.action-item-id         = buf_action-role-item.action-item-id
     1212               exclusive-lock
     1213               :
     1214               assign
     1215                  buf_action-role-item-gds.action-item-code = 0
     1216               .
     1217           END.
     1218           assign
     1219             buf_action-role-item.action-item-code = 0
     1220           .
     1221         end.
     1222       end.
     1223       end.
     1224     end.
     1225   end procedure.
