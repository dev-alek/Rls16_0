        1   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        2   DEFINE INPUT-OUTPUT PARAMETER pValue       AS CHARACTER NO-UNDO.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       65   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       66   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       67   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       68   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       69   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       70   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       71   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       74   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       75   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       76   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       77   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       78   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       79   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       80   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   function octal-to-char return character
       87   ( p-string as character ) :
       88     def var v-asc     as integer no-undo .
       89     def var v-new-asc as integer no-undo .
       90     def var ind       as integer no-undo .
       91     if length(p-string) <> 3 then do:
       92       return ? .
       93     end.
       94     assign
       95       v-asc = 0
       96     .
       97     do ind = 1 to length(p-string)
       98     :
       99       assign
      100         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      101       .
      102       if v-new-asc < 0 or v-new-asc >= 8 then do:
      103         return ? .
      104       end.
      105       assign
      106         v-asc = v-asc * 8 + v-new-asc
      107       .
      108     end.
      109     return chr(v-asc) .
      110   end function .
      111   function char-to-octal return character
      112   ( p-chr as character ) :
      113     def var v-asc    as integer   no-undo .
      114     def var ind      as integer   no-undo .
      115     def var v-string as character no-undo .
      116     if length(p-chr) <> 1 then do:
      117       return ? .
      118     end.
      119     assign
      120       v-asc    = asc(p-chr)
      121       v-string = ""
      122     .
      123     do ind = 1 to 3
      124     :
      125       assign
      126         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      127       .
      128       assign
      129         v-asc = truncate(v-asc / 8, 0)
      130       .
      131     end.
      132     return v-string .
      133   end.
      134   function str-encode return character
      135   (   p-init-string       as character
      136     , p-encode-char       as character
      137     , p-special-char-list as character
      138   ) :
      139     def var p-encode-string as character no-undo .
      140     def var ind                as integer no-undo .
      141     def var v-num-special-char as integer no-undo .
      142     def var v-special-char     as character no-undo .
      143     if p-encode-char = ?
      144     or p-encode-char = "" then do:
      145       assign
      146         p-encode-char = "~~"
      147       .
      148     end.
      149     if p-init-string = ? then do:
      150       return "?" .
      151     end.
      152     if p-init-string = "?" then do:
      153       return p-encode-char + char-to-octal("?") .
      154     end.
      155     assign
      156       v-num-special-char = length(p-special-char-list)
      157       p-encode-string    = replace(p-init-string
      158                                   ,p-encode-char
      159                                   ,p-encode-char + char-to-octal(p-encode-char)
      160                                   )
      161     .
      162     do ind = 1 to v-num-special-char
      163     :
      164       assign
      165         v-special-char = substring(p-special-char-list, ind, 1)
      166       .
      167       if v-special-char <> p-encode-char then do:
      168         assign
      169           p-encode-string = replace (p-encode-string
      170                                     ,v-special-char
      171                                     ,p-encode-char + char-to-octal(v-special-char)
      172                                     )
      173         .
      174       end.
      175     end.
      176     return p-encode-string .
      177   end.
      178   function str-decode returns character
      179     (p-init-string   as character
      180     ,p-encode-char   as character
      181     ) :
      182     def var p-decode-string as character no-undo .
      183     def var ind                       as integer no-undo .
      184     def var v-num-entries-init-string as integer no-undo .
      185     def var v-sub-phrase              as character no-undo .
      186     def var v-special-char            as character no-undo .
      187     if p-encode-char = ?
      188     or p-encode-char = "" then do:
      189       assign
      190         p-encode-char = "~~"
      191       .
      192     end.
      193     if p-init-string = "?" then do:
      194       return ? .
      195     end.
      196     assign
      197       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      198     .
      199     if v-num-entries-init-string > 1 then do:
      200       assign
      201         p-decode-string = entry(1, p-init-string, p-encode-char)
      202       .
      203       do ind = 2 to v-num-entries-init-string
      204       :
      205         assign
      206           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      207         .
      208         assign
      209           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      210         .
      211         if v-special-char <> ? then do:
      212           assign
      213             p-decode-string = p-decode-string
      214                             + v-special-char
      215                             + substring(v-sub-phrase, 4)
      216           .
      217         end.
      218         else do:
      219           assign
      220             p-decode-string = p-decode-string
      221                             + p-encode-char
      222                             + v-sub-phrase
      223           .
      224         end.
      225       end.
      226     end.
      227     else do:
      228       assign
      229         p-decode-string = p-init-string
      230       .
      231     end.
      232     return p-decode-string .
      233   end.
      234   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   procedure sel-date :
      236     define input  parameter p-date-handle as handle    no-undo .
      237     define input  parameter p-description as character no-undo .
      238     do
      239     on error undo, return error return-value
      240     :
      241       if (can-query (p-date-handle, "sensitive")
      242         and
      243         p-date-handle :sensitive = true
      244         )
      245       or (can-query (p-date-handle, "read-only")
      246         and
      247         p-date-handle :read-only = false
      248         )
      249       then do:
      250         if p-date-handle :handle <> focus :handle
      251         then do:
      252           apply "entry":u to p-date-handle .
      253         end.
      254         define variable v-ok            as logical no-undo .
      255         define variable v-curr-sv-date as date no-undo .
      256         assign
      257           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      258         .
      259         if v-curr-sv-date = ?
      260         then do:
      261           run gbl/getcurdt.p
      262             (output v-curr-sv-date
      263             ) .
      264         end.
      265         if v-curr-sv-date <> ?
      266         then do:
      267           run gbl/d-inpday.w
      268             (input ?
      269             ,input "Выбор даты"
      270             ,input p-description
      271             ,input ""
      272             ,input-output v-curr-sv-date
      273             ,output v-ok
      274             ).
      275           if v-ok = true
      276           then do:
      277             assign
      278               p-date-handle :screen-value = string(v-curr-sv-date) .
      279             .
      280           end.
      281         end.
      282       end.
      283     end.
      284   end procedure.
      285   procedure proc-alt-shift-f2:
      286     if not ibs.th.gbl.gbl-var:rcode
      287   then
      288     run gbl\inidebug.p .
      289   end.
      290   procedure proc-alt-shift-f3:
      291     run gbl/prvssinf.p
      292       ( input this-procedure
      293       ) .
      294   end.
      295   define variable v-inform-launched as logical no-undo initial false .
      296   procedure proc-alt-shift-f4:
      297     define variable v-action as character no-undo .
      298     if v-inform-launched = false then do:
      299       assign
      300         v-inform-launched = true
      301       .
      302       run gbl/d-inform.w
      303         (  input self
      304         ,  input this-procedure
      305         , output v-action
      306         ) no-error .
      307       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      308       assign
      309         v-inform-launched = false
      310       .
      311     end.
      312   end.
      313   procedure proc-alt-f1:
      314     run gbl/corrhelp.p
      315       (input this-procedure
      316       ) .
      317   end .
