      325     run proc-alt-shift-f4 in this-procedure.
      326   end.
      327   on alt-f1 anywhere do:
      328     run proc-alt-f1 in this-procedure .
      329   end.
      330   define variable lUserPressOK     AS LOGICAL       NO-UNDO INIT False .
      331   define variable sFormat          AS CHARACTER     NO-UNDO .
      332   define variable sType            AS CHARACTER     NO-UNDO .
      333   define variable sBoxProg         AS CHARACTER     NO-UNDO .
      334   define variable lBlank           AS LOGICAL       NO-UNDO .
      335   define variable v-password       as logical   no-undo .
      336   define variable hFillIn          AS WIDGET-HANDLE NO-UNDO .
      337   define variable sFillIn_Row      AS CHARACTER     NO-UNDO INIT ? .
      338   define variable sFillIn_Col      AS CHARACTER     NO-UNDO INIT ? .
      339   define variable sFillIn_Width    AS CHARACTER     NO-UNDO INIT ? .
      340   define variable sFillIn_Height   AS CHARACTER     NO-UNDO INIT ? .
      341   define variable sEditor_MaxChars AS CHARACTER     NO-UNDO INIT ? .
      342   define variable sCreate_Text1    AS CHARACTER     NO-UNDO INIT ? .
      343   define variable v-read-only      AS LOGICAL       NO-UNDO INIT False .
      344   DEFINE BUTTON b-choose-date
      345        IMAGE-UP FILE "btn-down-arrow":U
      346        IMAGE-DOWN FILE "btn-down-arrow":U
      347        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      348        LABEL "b-choose-date"
