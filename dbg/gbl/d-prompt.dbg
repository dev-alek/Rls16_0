      350   DEFINE BUTTON b-help
      351        LABEL "Помо&щь"
      352        SIZE 3 BY 1
      353        BGCOLOR 8 .
      354   DEFINE BUTTON Btn-Choose
      355        LABEL "V"
      356        SIZE 2.5 BY 1.
      357   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      358        LABEL "&Отмена"
      359        SIZE 10 BY 1
      360        BGCOLOR 8 .
      361   DEFINE BUTTON Btn_OK AUTO-GO
      362        LABEL "&Ввод "
      363        SIZE 10 BY 1
      364        BGCOLOR 8 .
      365   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      366        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      367        SIZE 5.5 BY 1.75
      368        BGCOLOR 15  NO-UNDO.
      369   DEFINE VARIABLE FILL-IN-Character AS CHARACTER FORMAT "X(256)":U
      370        VIEW-AS FILL-IN
      371        SIZE 41.25 BY 1
      372        BGCOLOR 15  NO-UNDO.
      373   DEFINE VARIABLE FILL-IN-Date AS DATE FORMAT "99/99/9999":U
      374        VIEW-AS FILL-IN
      375        SIZE 11.25 BY 1
      376        BGCOLOR 15  NO-UNDO.
      377   DEFINE VARIABLE FILL-IN-Decimal AS DECIMAL FORMAT "->>,>>9.99":U INITIAL 0
      378        VIEW-AS FILL-IN
      379        SIZE 41.25 BY 1
      380        BGCOLOR 15  NO-UNDO.
      381   DEFINE VARIABLE FILL-IN-Integer AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      382        VIEW-AS FILL-IN
      383        SIZE 41.25 BY 1
      384        BGCOLOR 15  NO-UNDO.
      385   DEFINE VARIABLE FILL-IN-Text-1 AS CHARACTER FORMAT "X(256)":U
      386         VIEW-AS TEXT
      387        SIZE 41.25 BY .58
      388        FONT 4 NO-UNDO.
      389   DEFINE VARIABLE FILL-IN-Text-2 AS CHARACTER FORMAT "X(256)":U
      390         VIEW-AS TEXT
      391        SIZE 41.25 BY .58
      392        FONT 4 NO-UNDO.
      393   DEFINE VARIABLE TOGGLE-1 AS LOGICAL INITIAL no
      394        LABEL ""
      395        VIEW-AS TOGGLE-BOX
      396        SIZE 4.63 BY .96 NO-UNDO.
      397   DEFINE FRAME Dialog-Frame
      398        FILL-IN-Decimal AT ROW 2.96 COL 2 NO-LABEL
      399        FILL-IN-Character AT ROW 2.96 COL 2 NO-LABEL
      400        FILL-IN-Integer AT ROW 2.96 COL 2 NO-LABEL
      401        FILL-IN-Date AT ROW 2.96 COL 2 NO-LABEL
      402        Btn-Choose AT ROW 2.96 COL 43.5
      403        b-choose-date AT ROW 3.08 COL 14.38
      404        EDITOR-1 AT ROW 4.13 COL 2 NO-LABEL
      405        b-help AT ROW 4.5 COL 45
      406        Btn_OK AT ROW 4.58 COL 8.5
      407        Btn_Cancel AT ROW 4.58 COL 28.5
      408        TOGGLE-1 AT ROW 4.58 COL 40.88
      409        FILL-IN-Text-1 AT ROW 1.13 COL 2.5 NO-LABEL
      410        FILL-IN-Text-2 AT ROW 2.04 COL 2.5 NO-LABEL
      411        SPACE(4.24) SKIP(3.45)
      412       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      413            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      414            TITLE "Prompter"
      415            CANCEL-BUTTON Btn_Cancel.
      416   ASSIGN
      417          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      418          FRAME Dialog-Frame:HIDDEN           = TRUE.
      419   ASSIGN
      420          b-choose-date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      421   ASSIGN
      422          Btn-Choose:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      423   ASSIGN
      424          EDITOR-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      425   ASSIGN
      426          FILL-IN-Character:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      427   ASSIGN
      428          FILL-IN-Date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      429   ASSIGN
      430          FILL-IN-Decimal:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      431   ASSIGN
      432          FILL-IN-Integer:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      433   ASSIGN
      434          FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      435   ASSIGN
      436          FILL-IN-Text-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      437   ASSIGN
      438          TOGGLE-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      439   ON GO OF FRAME Dialog-Frame
      440   DO:
      441     IF NOT v-read-only
      442     THEN DO:
      443       IF VALID-HANDLE(hFillIn)
      444       THEN DO:
      445         define variable v-check-date as date      no-undo .
      446         if  sType = 'DATE'
      447         then do:
      448           assign
      449             v-check-date = date(hFillIn :SCREEN-VALUE) no-error
      450           .
      451           if error-status :error
      452           then do:
      453             message
      454               "Ошибка при вводе даты" skip
      455               error-status :get-message(1) skip
      456               view-as alert-box error .
      457             return no-apply .
      458           end.
      459           hFillIn:SCREEN-VALUE = string (date(hFillIn:SCREEN-VALUE), "99/99/9999").
      460         end.
      461         ASSIGN
      462           pValue = hFillIn:SCREEN-VALUE
      463         .
      464       END.
      465     END.
      466     ASSIGN
      467       lUserPressOK = True
      468     .
      469   END.
      470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      471   DO:
      472     APPLY "END-ERROR":U TO SELF.
      473   END.
      474   ON CHOOSE OF b-choose-date IN FRAME Dialog-Frame
      475   DO:
      476     run sel-date in this-procedure
      477       (input FILL-IN-Date :handle
      478       ,input FRAME Dialog-Frame :TITLE
      479       ) .
      480   END.
      481   ON CHOOSE OF Btn-Choose IN FRAME Dialog-Frame
      482   DO:
      483     define variable var_id   as char no-undo.
      484     define variable var_name as char no-undo.
      485   if session :set-wait-state( "compiler" ) then.
      486     do with frame Dialog-Frame
      487     :
      488       assign
      489         var_id = hfillin :screen-value
      490       .
      491       run value(sboxprog) (input-output var_id, input-output var_name).
      492       if var_id <> hfillin :screen-value
      493       then do:
      494         assign
      495           hfillin :screen-value = var_id
      496         .
      497       end.
      498     end.
      499   if session :set-wait-state( "" ) then.
      500   END.
      501   ON RETURN OF FILL-IN-Character IN FRAME Dialog-Frame
      502   DO:
      503     APPLY "CHOOSE":U TO Btn_OK.
      504   END.
      505   ON RETURN OF FILL-IN-Date IN FRAME Dialog-Frame
      506   DO:
      507     APPLY "CHOOSE":U TO Btn_OK.
      508   END.
      509   ON RETURN OF FILL-IN-Decimal IN FRAME Dialog-Frame
      510   DO:
      511     APPLY "CHOOSE":U TO Btn_OK.
      512   END.
      513   ON RETURN OF FILL-IN-Integer IN FRAME Dialog-Frame
      514   DO:
      515     APPLY "CHOOSE":U TO Btn_OK.
      516   END.
      517   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
