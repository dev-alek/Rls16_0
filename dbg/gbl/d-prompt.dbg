      537   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   procedure minbtn-set :
      539       do
      540           on error undo, return error return-value
      541           :
      542           define variable ii              as integer       no-undo .
      543           define variable fh              as widget-handle no-undo .
      544           define variable hh              as widget-handle no-undo .
      545           define variable v-h             as handle        extent 4 no-undo .
      546           define variable v-name-button   as character     no-undo .
      547           define variable v-help-old-x    as decimal       no-undo .
      548           define variable v-help-old-y    as decimal       no-undo .
      549           define variable v-help-old-size as decimal       no-undo .
      550           define variable v-frame-width   as decimal       no-undo .
      551           define variable jj              as integer       no-undo .
      552           do
      553               on error undo, return error
      554               :
      555               assign
      556                   v-frame-width = frame Dialog-Frame:width - 0.3
      557                   fh            = frame Dialog-Frame:first-child
      558                   hh            = fh:first-child
      559                   ii            = 1
      560                   .
      561               do while valid-handle(hh):
      562                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      563                   do:
      564                       case lc(hh:name) :
      565                           when "b-help" then
      566                               do:
      567                                   hh:load-image-up("cmp/b-help.bmp":u) .
      568                                   hh:load-image-down("cmp/b-help.bmp":u) .
      569                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      570                                   hh:TOOLTIP = "Помощь" .
      571                                   v-help-old-x = hh:column .
      572                                   v-help-old-y = hh:row    .
      573                                   v-help-old-size = hh:width .
      574                                   hh:width-chars = 2.5 .
      575                               end.
      576                           when "b-print" then
      577                               do:
      578                                   hh:load-image("cmp/b-print.bmp":u) .
      579                                   hh:TOOLTIP = "Печать" .
      580                                   v-h[ii] = hh:handle .
      581                                   ii = ii + 1 .
      582                                   hh:width-chars = 3 .
      583                               end.
      584                           when "b-history" or
      585                           when "b-hist" then
      586                               do:
      587                                   hh:load-image("cmp/b-hist.bmp":u) .
      588                                   hh:TOOLTIP = "История" .
      589                                   v-h[ii] = hh:handle .
      590                                   ii = ii + 1 .
      591                                   hh:width-chars = 3 .
      592                               end.
      593                           when "b-sch" then
      594                               do:
      595                                   hh:load-image("cmp/b-sch.bmp":u) .
      596                                   hh:TOOLTIP = "Установка Фильтра" .
      597                                   v-h[ii] = hh:handle .
      598                                   ii = ii + 1 .
      599                                   hh:width-chars = 3 .
      600                               end.
      601                           when "b-hist-user" then
      602                               do:
      603                                   hh:load-image("cmp/b-hist.bmp":u) .
      604                                   hh:TOOLTIP = "История пользователя" .
      605                                   ii = ii + 1 .
      606                               end.
      607                       end case.
      608                   end.
      609                   hh = hh:next-sibling.
      610               end.
      611               b-help:column = v-frame-width - b-help:width-chars.
      612               jj = 0.
      613               repeat ii = 4 to 1 by -1 :
      614                   if valid-handle (v-h[ii] ) then
      615                   do:
      616                       jj  = jj + 1 .
      617                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      618                       v-h[ii]:row    = v-help-old-y .
      619                   end.
      620               end.
      621           end.
      622       end.
      623   end procedure.
      624   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      625   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      626   define variable ind AS INTEGER NO-UNDO.
      627   define variable sElement AS CHARACTER NO-UNDO.
      628   define variable sValue AS CHARACTER NO-UNDO.
      629   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      630     sElement = ENTRY(ind, pParameters, '\').
      631     IF NUM-ENTRIES(sElement, '=') = 2
      632     THEN DO:
      633       sValue   = ENTRY(2, sElement, '=').
      634       CASE ENTRY(1, sElement, '='):
      635         WHEN 'text1'         THEN do: assign FILL-IN-Text-1   = str-decode(sValue, "").             end.
      636         WHEN 'text2'         THEN do: assign FILL-IN-Text-2   = str-decode(sValue, "").             end.
      637         WHEN 'format'        THEN do: assign sFormat          = sValue.                             end.
      638         WHEN 'blank'         THEN do: assign lBlank           = lookup(sValue, 'true,yes':U) > 0.   end.
      639         WHEN 'password'      THEN do: assign v-password       = lookup(sValue, 'true,yes':U) > 0.   end.
      640         WHEN 'title'         THEN do: assign FRAME Dialog-Frame:TITLE = sValue.                    end.
      641         WHEN 'type'          THEN do: assign sType            = sValue.                             end.
      642         WHEN 'boxprog'       THEN do: assign sBoxProg         = sValue.                             end.
      643         WHEN 'FillIn_Row'    THEN do: assign sFillIn_Row      = sValue.                             end.
      644         WHEN 'FillIn_Col'    THEN do: assign sFillIn_Col      = sValue.                             end.
      645         WHEN 'FillIn_Height' THEN do: assign sFillIn_Height   = sValue.                             end.
      646         WHEN 'FillIn_Width'  THEN do: assign sFillIn_Width    = sValue.                             end.
      647         WHEN 'max-chars'     THEN do: assign sEditor_MaxChars = sValue.                             end.
      648         WHEN 'Create_Text1'  THEN do: assign sCreate_Text1    = sValue.                             end.
      649         WHEN 'readonly'      THEN do: assign v-read-only      = lookup(sValue, 'yes,true':U) > 0 .  end.
      650       END CASE.
      651     END.
      652   END.
      653   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      654   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      655   define variable hText AS WIDGET-HANDLE NO-UNDO.
      656   DO WITH FRAME Dialog-Frame
      657   :
      658     IF FILL-IN-Text-1 <> ''
      659     THEN DO:
      660       DISPLAY FILL-IN-Text-1.
      661     END.
      662     IF FILL-IN-Text-2 <> ''
      663     THEN DO:
      664       DISPLAY FILL-IN-Text-2.
      665     END.
      666   END.
      667   define variable sText1Label AS CHARACTER NO-UNDO.
      668   IF sCreate_Text1 <> ?
      669   AND NUM-ENTRIES(sCreate_Text1, ';') = 3
      670   THEN DO:
      671     sText1Label = ENTRY(3, sCreate_Text1, ';').
      672     CREATE TEXT hText
      673     ASSIGN
      674       ROW          = INTEGER(ENTRY(1, sCreate_Text1, ';'))
      675       COLUMN       = INTEGER(ENTRY(2, sCreate_Text1, ';'))
      676       FORMAT       = 'X(' + STRING(LENGTH(sText1Label)) + ')'
      677       SCREEN-VALUE = sText1Label
      678       FRAME        = hFrameHandle
      679       SENSITIVE    = FALSE
      680       VISIBLE      = TRUE
      681     .
      682   END.
      683   define variable sTypeOk as logical   no-undo .
      684   assign
      685     sTypeOk = false
      686   .
      687   if sType begins 'CHAR'
      688   or sType = 'C':U
      689   then do:
      690     assign
      691       sType = 'CHAR'
      692       sTypeOk = true
      693     .
      694   end.
      695   if sType begins 'INT'
      696   or sType = 'I':U
      697   then do:
      698     assign
      699       sType = 'INT'
      700       sTypeOk = true
      701     .
      702   end.
      703   if sType begins 'DEC'
      704   or sType = 'D':U
      705   then do:
      706     assign
      707       sType = 'DEC'
      708       sTypeOk = true
      709     .
      710   end.
      711   if sType begins 'DATE'
      712   or sType = 'T':U
      713   then do:
      714     assign
      715       sType = 'DATE'
      716       sTypeOk = true
      717     .
      718   end.
      719   if sType begins 'EDIT'
      720   then do:
      721     assign
      722       sType = 'EDIT'
      723       sTypeOk = true
      724     .
      725   end.
      726   if sType begins 'LOG'
      727   or sType = 'L':U
      728   then do:
      729     assign
      730       sType = 'LOG'
      731       sTypeOk = true
      732     .
      733   end.
      734   if sType = ''
      735   then do:
      736     assign
      737       sType = 'CHAR'
      738       sTypeOk = true
      739     .
      740   end.
      741   IF sTypeOk <> true
      742   THEN DO:
      743     MESSAGE
      744       vss-workfile vss-revision vss-description skip
      745       'Указан неправильный тип данных' SKIP
      746       'sType' sType SKIP
      747       'Тип данных принимается за строковый' SKIP
      748       'Позвоните разработчикам системы' skip
      749       VIEW-AS ALERT-BOX WARNING.
      750     assign
      751       sType = 'CHAR'
      752     .
      753   END.
      754   IF sType = 'LOG' AND num-entries(sFormat, chr(47)) <> 2
      755   then DO:
      756     MESSAGE
      757       vss-workfile vss-revision vss-description skip
      758       'Указан неправильный формат данный' SKIP
      759       'sFormat' sFormat 'для логического типа данных' SKIP
      760       'Формат данных принимается за yes/no' SKIP
      761       'Позвоните разработчикам системы' skip
      762       VIEW-AS ALERT-BOX WARNING.
      763     assign
      764       sFormat = 'yes/no'
      765     .
      766   END.
      767   RUN setup-editor .
      768   RUN setup-fill-in .
      769   RUN setup-toggle.
      770   if sType = "DATE"
      771   then do:
      772   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      773   on ' ' of FILL-IN-Date in frame Dialog-Frame
      774   do:
      775     if (can-query (self, "sensitive")
      776        and
      777        self :sensitive = true
      778        )
      779     or (can-query (self, "read-only")
      780        and
      781        self :read-only = false
      782        )
      783     then do:
      784       assign
      785         self :screen-value = ?
      786       .
      787     end.
      788     return no-apply.
      789   end.
      790   on delete-character of FILL-IN-Date in frame Dialog-Frame
      791   do:
      792     if (can-query (self, "sensitive")
      793        and
      794        self :sensitive = true
      795        )
      796     or (can-query (self, "read-only")
      797        and
      798        self :read-only = false
      799        )
      800     then do:
      801       assign
      802         self :screen-value = ?
      803       .
      804     end.
      805     return no-apply.
      806   end.
      807   on ctrl-d of FILL-IN-Date in frame Dialog-Frame
      808   do:
      809     define variable v-curr-sv-date as date no-undo .
      810     if (can-query (self, "sensitive")
      811        and
      812        self :sensitive = true
      813        )
      814     or (can-query (self, "read-only")
      815        and
      816        self :read-only = false
      817        )
      818     then do:
      819       if self :handle <> focus :handle
      820       then do:
      821         apply "entry":u to self .
      822       end.
      823       run gbl/getcurdt.p
      824         (output v-curr-sv-date
      825         ) .
      826       assign
      827         self :screen-value = string(v-curr-sv-date) .
      828       .
      829     end.
      830     return no-apply.
      831   end.
      832   on ctrl-b of FILL-IN-Date in frame Dialog-Frame
      833   do:
      834     if (can-query (self, "sensitive")
      835        and
      836        self :sensitive = true
      837        )
      838     or (can-query (self, "read-only")
      839        and
      840        self :read-only = false
      841        )
      842     then do:
      843       if self :handle <> focus :handle
      844       then do:
      845         apply "entry":u to self .
      846       end.
      847       define variable v-curr-sv-date as date no-undo .
      848       define variable v-new-sv-date  as date no-undo .
      849       assign
      850         v-curr-sv-date = date(self :screen-value) no-error
      851       .
      852       if v-curr-sv-date = ?
      853       then do:
      854         run gbl/getcurdt.p
      855           (output v-curr-sv-date
      856           ) .
      857       end.
      858       if v-curr-sv-date <> ?
      859       then do:
      860         assign
      861           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      862         .
      863         assign
      864           self :screen-value = string(v-new-sv-date) .
      865         .
      866       end.
      867     end.
      868     return no-apply .
      869   end.
      870   on ctrl-e of FILL-IN-Date in frame Dialog-Frame
      871   do:
      872     if (can-query (self, "sensitive")
      873        and
      874        self :sensitive = true
      875        )
      876     or (can-query (self, "read-only")
      877        and
      878        self :read-only = false
      879        )
      880     then do:
      881       if self :handle <> focus :handle
      882       then do:
      883         apply "entry":u to self .
      884       end.
      885       define variable v-curr-sv-date as date no-undo .
      886       define variable v-new-sv-date  as date no-undo .
      887       assign
      888         v-curr-sv-date = date(self :screen-value) no-error
      889       .
      890       if v-curr-sv-date = ?
      891       then do:
      892         run gbl/getcurdt.p
      893           (output v-curr-sv-date
      894           ) .
      895       end.
      896       if v-curr-sv-date <> ?
      897       then do:
      898         run gbl/lastdate.p
      899           (input  v-curr-sv-date
      900           ,output v-new-sv-date
      901           ).
      902         assign
      903           self :screen-value = string(v-new-sv-date) .
      904         .
      905       end.
      906     end.
      907     return no-apply .
      908   end.
      909   on ctrl-f of FILL-IN-Date in frame Dialog-Frame
      910   do:
      911     if (can-query (self, "sensitive")
      912        and
      913        self :sensitive = true
      914        )
      915     or (can-query (self, "read-only")
      916        and
      917        self :read-only = false
      918        )
      919     then do:
      920       if self :handle <> focus :handle
      921       then do:
      922         apply "entry":u to self .
      923       end.
      924       define variable v-ok            as logical   no-undo .
      925       define variable v-curr-sv-date  as date      no-undo .
      926       define variable v-description   as character no-undo .
      927       assign
      928         v-curr-sv-date = date(self :screen-value) no-error
      929       .
      930       if v-curr-sv-date = ?
      931       then do:
      932         run gbl/getcurdt.p
      933           (output v-curr-sv-date
      934           ) .
      935       end.
      936       if v-curr-sv-date <> ?
      937       then do:
      938         run gbl/d-inpday.w
      939           (input ?
      940           ,input "Выбор даты"
      941           ,input v-description
      942           ,input ""
      943           ,input-output v-curr-sv-date
      944           ,output v-ok
      945           ).
      946         if v-ok = true
      947         then do:
      948           assign
      949             self :screen-value = string(v-curr-sv-date) .
      950           .
      951         end.
      952       end.
      953     end.
      954     return no-apply .
      955   end.
      956     define MENU m-ed-date6
      957       MENU-ITEM m-ed-date6-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      958       MENU-ITEM m-ed-date6-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      959       MENU-ITEM m-ed-date6-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      960       MENU-ITEM m-ed-date6-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      961       .
      962     if FILL-IN-Date :POPUP-MENU in frame Dialog-Frame = ?
      963     then do:
      964       ASSIGN
      965         FILL-IN-Date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date6 :HANDLE
      966         FILL-IN-Date :MENU-MOUSE in frame Dialog-Frame = 3
      967       .
      968     end.
      969     define variable v-label-handle6 as handle no-undo .
      970     assign
      971       v-label-handle6 = FILL-IN-Date :side-label-handle in frame Dialog-Frame
      972     .
      973     if valid-handle (v-label-handle6)
      974     then do:
      975       if v-label-handle6 :tooltip = ""
      976       or v-label-handle6 :tooltip = ?
      977       then do:
      978         assign
      979           v-label-handle6 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      980         .
      981       end.
      982     end.
      983     ON CHOOSE OF MENU-ITEM m-ed-date6-1 in menu m-ed-date6 DO:
      984       apply "ctrl-b":U to FILL-IN-Date in frame Dialog-Frame .
      985     END.
      986     ON CHOOSE OF MENU-ITEM m-ed-date6-2 in menu m-ed-date6 DO:
      987       apply "ctrl-d":U to FILL-IN-Date in frame Dialog-Frame .
      988     END.
      989     ON CHOOSE OF MENU-ITEM m-ed-date6-3 in menu m-ed-date6 DO:
      990       apply "ctrl-e":U to FILL-IN-Date in frame Dialog-Frame .
      991     END.
      992     ON CHOOSE OF MENU-ITEM m-ed-date6-4 in menu m-ed-date6 DO:
      993       apply "ctrl-f":U to FILL-IN-Date in frame Dialog-Frame .
      994     END.
      995   end.
      996   MAIN-BLOCK:
      997   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      998      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      999     RUN enable_UI.
     1000     run setup-box-button .
     1001     run setup-cancel-button .
     1002     WAIT-FOR GO OF FRAME Dialog-Frame.
     1003   END.
     1004   RUN disable_UI.
     1005   IF lUserPressOK
     1006   THEN DO:
     1007     RETURN 'TRUE'.
     1008   END.
     1009   ELSE DO:
     1010     RETURN 'FALSE'.
     1011   END.
     1012   PROCEDURE disable_UI :
     1013     HIDE FRAME Dialog-Frame.
     1014   END PROCEDURE.
     1015   PROCEDURE enable_UI :
     1016     ENABLE b-help Btn_OK Btn_Cancel
     1017         WITH FRAME Dialog-Frame.
     1018     VIEW FRAME Dialog-Frame.
     1019   END PROCEDURE.
     1020   PROCEDURE setup-box-button :
     1021     DO WITH FRAME Dialog-Frame
     1022     :
     1023       IF sBoxProg <> ''
     1024       THEN DO:
     1025         ASSIGN
     1026           Btn-Choose:VISIBLE      = True AND NOT v-read-only
     1027           Btn-Choose:SENSITIVE    = True AND NOT v-read-only
     1028         .
     1029       END.
     1030       if v-read-only
     1031       then do:
     1032         assign
     1033           Btn_OK :LABEL = "&Выход"
     1034         .
     1035       end.
     1036     END.
     1037   END PROCEDURE.
     1038   PROCEDURE setup-cancel-button :
     1039     do with frame Dialog-Frame
     1040     :
     1041       if v-read-only = false
     1042       then do:
     1043         assign
     1044           Btn_Cancel :visible   = true
     1045           Btn_Cancel :sensitive = true
     1046         .
     1047       end.
     1048       else do:
     1049         assign
     1050           Btn_Cancel :sensitive = false
     1051           Btn_Cancel :visible   = false
     1052         .
     1053       end.
     1054     end.
     1055   END PROCEDURE.
     1056   PROCEDURE setup-editor :
     1057     do with frame Dialog-Frame
     1058     :
     1059       IF sType = 'EDIT'
     1060       THEN DO:
     1061         IF FILL-IN-Text-2 = ''
     1062         AND sFillIn_Row = ?
     1063         THEN DO:
     1064           sFillIn_Row = '2'.
     1065           IF FILL-IN-Text-1 = ''
     1066           THEN DO:
     1067             sFillIn_Row = '1.1'.
     1068           END.
     1069         END.
     1070         IF sFillIn_Height = ? THEN
     1071           sFillIn_Height = '10'.
     1072         IF sFillIn_Width = ? THEN
     1073           sFillIn_Width = '50'.
     1074         IF  sEditor_MaxChars <> ?
     1075         AND sEditor_MaxChars <> ''
     1076         AND CAN-SET(EDITOR-1:HANDLE, 'MAX-CHARS')
     1077         THEN DO:
     1078           ASSIGN
     1079             EDITOR-1:MAX-CHARS = INTEGER(sEditor_MaxChars)
     1080           .
     1081         END.
     1082       END.
     1083     end.
     1084   END PROCEDURE.
     1085   PROCEDURE setup-fill-in :
     1086     DO WITH FRAME Dialog-Frame
     1087     :
     1088       CASE sType:
     1089         WHEN 'CHAR'
     1090         THEN DO:
     1091           ASSIGN
     1092             FILL-IN-Character :VISIBLE      = True
     1093             FILL-IN-Character :SENSITIVE    = True AND NOT v-read-only
     1094             hFillIn = FILL-IN-Character:HANDLE
     1095           .
     1096         END.
     1097         WHEN 'INT'
     1098         THEN DO:
     1099           ASSIGN
     1100             FILL-IN-Integer :VISIBLE      = True
     1101             FILL-IN-Integer :SENSITIVE    = True AND NOT v-read-only
     1102             hFillIn = FILL-IN-Integer :HANDLE
     1103           .
     1104         END.
     1105         WHEN 'DATE'
     1106         THEN DO:
     1107           ASSIGN
     1108             FILL-IN-Date  :visible    = True
     1109             FILL-IN-Date  :sensitive  = True AND NOT v-read-only
     1110             b-choose-date :visible    = True AND NOT v-read-only
     1111             b-choose-date :sensitive  = True AND NOT v-read-only
     1112             hFillIn = FILL-IN-Date :HANDLE
     1113           .
     1114         END.
     1115         WHEN 'DEC'
     1116         THEN DO:
     1117           ASSIGN
     1118             FILL-IN-Decimal:VISIBLE      = True
     1119             FILL-IN-Decimal:SENSITIVE    = True AND NOT v-read-only
     1120             hFillIn = FILL-IN-Decimal :HANDLE
     1121           .
     1122         END.
     1123         WHEN 'EDIT'
     1124         THEN DO:
     1125           ASSIGN
     1126             EDITOR-1:VISIBLE      = True
     1127             EDITOR-1:SENSITIVE    = True
     1128             EDITOR-1:READ-ONLY    = v-read-only
     1129             EDITOR-1:BGCOLOR      = IF v-read-only THEN GRAY_COLOR ELSE WHITE_COLOR
     1130             EDITOR-1:ROW          = 3
     1131             EDITOR-1:COL          = 2
     1132             hFillIn = EDITOR-1:HANDLE
     1133           .
     1134         END.
     1135         WHEN 'LOG'
     1136         THEN DO:
     1137           ASSIGN
     1138             TOGGLE-1:VISIBLE      = True
     1139             TOGGLE-1:SENSITIVE    = True AND NOT v-read-only
     1140             TOGGLE-1:ROW          = 3
     1141             TOGGLE-1:COL          = 2
     1142             hFillIn = TOGGLE-1:HANDLE
     1143           .
     1144         END.
     1145       END CASE.
     1146     END.
     1147     IF VALID-HANDLE(hFillIn)
     1148     THEN DO:
     1149       IF CAN-SET(hFillIn, 'BLANK')
     1150       THEN DO:
     1151         ASSIGN
     1152           hFillIn:BLANK        = lBlank
     1153         .
     1154       END.
     1155       IF CAN-SET(hFillIn, 'PASSWORD-FIELD')
     1156       THEN DO:
     1157         ASSIGN
     1158           hFillIn:PASSWORD-FIELD = v-password
     1159         .
     1160       END.
     1161       IF CAN-SET(hFillIn, 'BLANK')
     1162       THEN DO:
     1163         ASSIGN
     1164           hFillIn:BLANK        = lBlank
     1165         .
     1166       END.
     1167       IF sFormat <> ''
     1168       AND CAN-SET(hFillIn, 'FORMAT')
     1169       THEN DO:
     1170         ASSIGN
     1171           hFillIn:FORMAT       = sFormat
     1172         .
     1173       END.
     1174       IF CAN-SET(hFillIn, 'SCREEN-VALUE')
     1175       THEN DO:
     1176         if sType = 'LOG'
     1177         then do:
     1178           ASSIGN
     1179             hFillIn :SCREEN-VALUE =
     1180               ( if lookup(pvalue
     1181                          , 'yes':U
     1182                          + ',':u + 'true':U
     1183                          + ',':u + entry(1, sFormat, chr(47))) > 0
     1184                 then "yes"
     1185                 else "no"
     1186               )
     1187           .
     1188         end.
     1189         else do:
     1190           ASSIGN
     1191             hFillIn :SCREEN-VALUE = pValue
     1192           .
     1193         end.
     1194       END.
     1195       IF  sFillIn_Row <> ?
     1196       AND sFillIn_Row <> ''
     1197       AND CAN-SET(hFillIn, 'ROW')
     1198       THEN DO:
     1199         ASSIGN
     1200           hFillIn:ROW          = DECIMAL(sFillIn_Row)
     1201         .
     1202         if  sType = 'DATE'
     1203         and NOT v-read-only
     1204         then do:
     1205           ASSIGN
     1206             b-choose-date :ROW          = DECIMAL(sFillIn_Row)
     1207           .
     1208         end.
     1209       END.
     1210       IF  sFillIn_Col  <> ?
     1211       AND sFillIn_Col <> ''
     1212       AND CAN-SET(hFillIn, 'COL')
     1213       THEN DO:
     1214         define variable v-new-col as decimal   no-undo .
     1215         assign
     1216           v-new-col = DECIMAL(sFillIn_Col)
     1217         .
     1218         if v-new-col + hFillIn :width + 1.5 >= frame Dialog-Frame:width
     1219         then do:
     1220           assign
     1221             frame Dialog-Frame:width = v-new-col + hFillIn :width + 1.5
     1222           .
     1223         end.
     1224         ASSIGN
     1225           hFillIn:COL = v-new-col
     1226         .
     1227         if  sType = 'DATE'
     1228         and NOT v-read-only
     1229         then do:
     1230           assign
     1231             v-new-col = hFillIn:COL + hFillIn:WIDTH + .2
     1232           .
     1233           if v-new-col + b-choose-date :width + 1.5 >= frame Dialog-Frame:width
     1234           then do:
     1235             assign
     1236               frame Dialog-Frame:width = v-new-col + b-choose-date :width + 1.5
     1237             .
     1238           end.
     1239           ASSIGN
     1240             b-choose-date :COL  = v-new-col
     1241           .
     1242         end.
     1243       END.
     1244       define variable eFillIn_Width AS DECIMAL NO-UNDO.
     1245       eFillIn_Width = DECIMAL(sFillIn_Width).
     1246       IF eFillIn_Width = ? THEN
     1247         eFillIn_Width = hFillIn:WIDTH.
     1248       IF hFillIn:COL + eFillIn_Width + 1.5 >= FRAME Dialog-Frame:WIDTH
     1249       THEN DO:
     1250         ASSIGN
     1251           FRAME Dialog-Frame:WIDTH = hFillIn:COL + eFillIn_Width + 1.5
     1252         .
     1253       END.
     1254       IF  sFillIn_Width  <> ?
     1255       AND sFillIn_Width <> ''
     1256       AND CAN-SET(hFillIn, 'WIDTH')
     1257       THEN DO:
     1258         ASSIGN
     1259           hFillIn:WIDTH        = DECIMAL(sFillIn_Width)
     1260         .
     1261       END.
     1262       define variable eFillIn_Height AS DECIMAL NO-UNDO.
     1263       eFillIn_Height = DECIMAL(sFillIn_Height).
     1264       IF eFillIn_Height = ? THEN
     1265         eFillIn_Height = hFillIn:HEIGHT.
     1266       define variable eHeightDelta AS DECIMAL NO-UNDO.
     1267       assign
     1268         eHeightDelta = hFillIn:ROW + eFillIn_HEIGHT + 2.2 - FRAME Dialog-Frame:HEIGHT
     1269       .
     1270       IF eHeightDelta > 0
     1271       THEN DO:
     1272         ASSIGN
     1273           FRAME Dialog-Frame:HEIGHT = FRAME Dialog-Frame:HEIGHT + eHeightDelta
     1274           Btn_Cancel:ROW             = Btn_Cancel:ROW + eHeightDelta
     1275           b-help:ROW               = b-help:ROW   + eHeightDelta
     1276           Btn_OK:ROW                 = Btn_OK:ROW     + eHeightDelta
     1277         .
     1278       END.
     1279       IF  sFillIn_Height  <> ?
     1280       AND sFillIn_Height <> ''
     1281       AND CAN-SET(hFillIn, 'HEIGHT')
     1282       THEN DO:
     1283         ASSIGN
     1284           hFillIn:HEIGHT       = DECIMAL(sFillIn_Height)
     1285         .
     1286       END.
     1287       IF hFillIn:MOVE-TO-TOP() THEN .
     1288     END.
     1289     pValue = ''.
     1290   END PROCEDURE.
     1291   PROCEDURE setup-toggle :
     1292     do with frame Dialog-Frame
     1293     :
     1294       IF sType = 'LOG'
     1295       THEN DO:
     1296         IF FILL-IN-Text-2 = ''
     1297         AND sFillIn_Row = ?
     1298         THEN DO:
     1299           sFillIn_Row = '2'.
     1300           IF FILL-IN-Text-1 = ''
     1301           THEN DO:
     1302             sFillIn_Row = '1.1'.
     1303           END.
     1304         END.
     1305         IF sFillIn_Height = ? THEN
     1306           sFillIn_Height = '10'.
     1307         IF sFillIn_Width = ? THEN
     1308           sFillIn_Width = '50'.
     1309         TOGGLE-1:format = sFormat.
     1310       END.
     1311     end.
     1312   END PROCEDURE.
