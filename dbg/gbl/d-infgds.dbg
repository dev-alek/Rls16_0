        1   block-level on error undo, throw.
        2   define input  parameter p-gds-code as integer   no-undo .
        3   define input  parameter p-obj-type as character no-undo .
        4   define input  parameter p-obj-code as integer   no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: d-infgds.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: gbl/d-infgds.p $":U .
       10   define variable vss-description as character no-undo initial "Подробная информация о товаре для разработчиков".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define buffer buf_goods for ub.goods .
       68   define buffer buf_gds-obj for ub.gds-obj .
       69   define variable v-bad-gds as logical   no-undo .
       70   define variable v-message as character no-undo .
       71   do
       72   on error undo, return error return-value
       73   :
       74     find first buf_goods no-lock
       75       where buf_goods.gds-code = p-gds-code
       76       no-error .
       77     if not available buf_goods
       78     then do:
       79       message
       80         vss-workfile vss-revision vss-description skip
       81         "Товар не найден" skip
       82         "Код товара" p-gds-code skip
       83         "Объект" p-obj-type p-obj-code skip
       84         view-as alert-box error .
       85       undo, return error return-value .
       86     end.
       87     define variable v-artic     as character no-undo .
       88     define variable v-prod-type as character no-undo .
       89     define variable v-prod-code as integer   no-undo .
       90     assign
       91       v-artic     = buf_goods.artic
       92       v-prod-type = buf_goods.prod-type
       93       v-prod-code = buf_goods.prod-code
       94     .
       95     find first buf_gds-obj exclusive-lock
       96       where buf_gds-obj.obj-type  = p-obj-type
       97         and buf_gds-obj.obj-code  = p-obj-code
       98         and buf_gds-obj.artic     = v-artic
       99         and buf_gds-obj.prod-type = v-prod-type
      100         and buf_gds-obj.prod-code = v-prod-code
      101       no-error .
      102     if available buf_gds-obj
      103     then do:
      104   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      106     (input p-obj-type
      107     ,input p-obj-code
      108     ,input v-artic
      109     ,input v-prod-type
      110     ,input v-prod-code
      111     ,input ?
      112     ,input 'return'
      113     ) no-error .
      114       if error-status :error
      115       then do:
      116         assign
      117           v-bad-gds = true
      118         .
      119         assign
      120           v-message = return-value
      121         .
      122       end.
      123     end.
      124     if v-bad-gds
      125     then do:
      126       message
      127         "Код товара" p-gds-code skip
      128         "Артикул" v-artic v-prod-type v-prod-code skip
      129         "Объект" p-obj-type p-obj-code skip
      130         "Товар испорчен" skip
      131         v-message skip
      132         view-as alert-box error .
      133     end.
      134     else do:
      135       message
      136         "Код товара" p-gds-code skip
      137         "Артикул" v-artic v-prod-type v-prod-code skip
      138         "Объект" p-obj-type p-obj-code skip
      139         "Товар целостный"
      140         view-as alert-box information .
      141     end.
      142   end.
