        1   block-level on error undo, throw.
        2   define input  parameter parparentproc    as widget-handle no-undo .
        3   define input  parameter p-directory-out  as character no-undo .
        4   define input  parameter p-file-name      as character no-undo .
        5   define input  parameter p-data-valid     as logical   no-undo .
        6   define input  parameter p-error-message  as character no-undo .
        7   define input  parameter p-user-login     as character no-undo .
        8   define input  parameter p-obj-type       as character no-undo .
        9   define input  parameter p-obj-code       as character no-undo .
       10   define input  parameter p-bar-code       as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: rt-req02.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req02.p $":U .
       16   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 02. Контроль цены. Считать штрих-код".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure integerm :
       77     define input  parameter p-string      as character no-undo .
       78     define input  parameter p-allow-sign  as logical   no-undo .
       79     define input  parameter p-allow-comma as logical   no-undo .
       80     define output parameter p-value       as integer   no-undo .
       81     define output parameter p-data-valid  as logical   no-undo .
       82     define output parameter p-message     as character no-undo .
       83     define variable v-replace-string as character no-undo .
       84     do
       85     on error undo, return error return-value
       86     :
       87       if p-string = ?
       88       then do:
       89         assign
       90           p-value      = ?
       91           p-data-valid = false
       92           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       93         .
       94         return .
       95       end.
       96       if p-string = ""
       97       then do:
       98         assign
       99           p-value      = ?
      100           p-data-valid = false
      101           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      102         .
      103         return .
      104       end.
      105       assign
      106         p-value = integer(p-string) no-error
      107       .
      108       if error-status :error = true
      109       then do:
      110         assign
      111           p-value      = ?
      112           p-data-valid = false
      113           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      114                                    ,p-string
      115                                    )
      116         .
      117         return .
      118       end.
      119       if index(p-string, ' ':u) > 0
      120       then do:
      121         assign
      122           p-value      = ?
      123           p-data-valid = false
      124           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      125                                    + "Строка содержит символы пробела"
      126                                    ,p-string
      127                                    )
      128         .
      129         return .
      130       end.
      131       assign
      132         v-replace-string = p-string
      133         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      142       .
      143       if p-allow-sign = true
      144       then do:
      145         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      146         then do:
      147           assign
      148             v-replace-string = substring(v-replace-string, 2)
      149           .
      150         end.
      151       end.
      152       else do:
      153         if substring(v-replace-string, 1, 1) = '+':u
      154         then do:
      155           assign
      156             p-value      = ?
      157             p-data-valid = false
      158             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      159                                     + "Задан параметр недопустимости знака челого числа. "
      160                                     + "Строка содержит символ плюс. "
      161                                     ,p-string
      162                                     )
      163           .
      164           return .
      165         end.
      166         if substring(v-replace-string, 1, 1) = '-':u
      167         then do:
      168           assign
      169             p-value      = ?
      170             p-data-valid = false
      171             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      172                                     + "Задан параметр недопустимости знака челого числа. "
      173                                     + "Строка содержит символ минус. "
      174                                     ,p-string
      175                                     )
      176           .
      177           return .
      178         end.
      179       end.
      180       if p-allow-comma = true
      181       then do:
      182         assign
      183           v-replace-string = replace(v-replace-string, ',', '')
      184         .
      185       end.
      186       else do:
      187         if index(v-replace-string, ',') > 0
      188         then do:
      189           assign
      190             p-value      = ?
      191             p-data-valid = false
      192             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      193                                     + "Задан параметр недопустимости знака разделителя тысяч."
      194                                     + "Строка содержит знак разделителя тысяч. "
      195                                     ,p-string
      196                                     )
      197           .
      198           return .
      199         end.
      200       end.
      201       if index(p-string, '.') > 0
      202       then do:
      203         assign
      204           p-value      = ?
      205           p-data-valid = false
      206           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      207                                    + "Строка содержит знак десятичной точки"
      208                                    ,p-string
      209                                    )
      210         .
      211         return .
      212       end.
      213       if v-replace-string <> fill('9', length(v-replace-string))
      214       then do:
      215         assign
      216           p-value      = ?
      217           p-data-valid = false
      218           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      219                                    + "Встречены символы, недопустимые для целого числа '&2'"
      220                                    ,p-string
      221                                    ,replace(v-replace-string, '9', '')
      222                                    )
      223         .
      224         return .
      225       end.
      226       assign
      227         p-data-valid = true
      228         p-message    = ""
      229       .
      230     end.
      231   end procedure.
      232   define new global shared variable g#library  as handle no-undo .
      233   define new global shared variable g#library2 as handle no-undo .
      234   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   function rtencode returns character
      236     ( p-init-string as character
      237     ) :
      238     define variable v-encode-string as character no-undo .
      239     if p-init-string = ?
      240     then do:
      241       assign
      242         v-encode-string = '?':u
      243       .
      244       return v-encode-string .
      245     end.
      246     if p-init-string = '?':u
      247     then do:
      248       assign
      249         v-encode-string = '~~077':u
      250       .
      251       return v-encode-string .
      252     end.
      253     assign
      254       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      255       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      256       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      257     .
      258     return v-encode-string .
      259   end function .
      260   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      262   procedure partslib-clear-temp-parts :
      263     define buffer buf_temp-parts for temp-parts .
      264     do
      265     on error undo, return error
      266     :
      267       for each buf_temp-parts
      268       on error undo, return error
      269       :
      270         delete buf_temp-parts .
      271       end.
      272     end.
      273   end procedure.
      274   procedure partslib-create-temp-parts :
      275     define parameter buffer buf_parts       for ub.parts .
      276     define parameter buffer buf_temp-parts  for temp-parts .
      277     define input  parameter p-goods-twounit as logical   no-undo .
      278     define variable v-base-part-code as character no-undo .
      279     do
      280     on error undo, return error
      281     :
      282       if p-goods-twounit = true
      283       then do:
      284         assign
      285           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      286         .
      287       end.
      288       else do:
      289         assign
      290           v-base-part-code = buf_parts.part-code
      291         .
      292       end.
      293       find first buf_temp-parts exclusive-lock
      294         where buf_temp-parts.obj-type  = buf_parts.obj-type
      295           and buf_temp-parts.obj-code  = buf_parts.obj-code
      296           and buf_temp-parts.artic     = buf_parts.artic
      297           and buf_temp-parts.prod-type = buf_parts.prod-type
      298           and buf_temp-parts.prod-code = buf_parts.prod-code
      299           and buf_temp-parts.in-code   = buf_parts.in-code
      300           and buf_temp-parts.out-code  = 'free-zone':U
      301           and buf_temp-parts.part-code = v-base-part-code
      302         no-error.
      303       if not available buf_temp-parts
      304       then do:
      305         create buf_temp-parts .
      306         buffer-copy buf_parts to buf_temp-parts
      307         assign
      308           buf_temp-parts.out-code  = 'free-zone':U
      309           buf_temp-parts.part-code = v-base-part-code
      310           buf_temp-parts.rsrv-free = yes
      311           buf_temp-parts.status_   = no
      312           buf_temp-parts.qnty      = 0
      313           buf_temp-parts.fact-qnty = 0
      314           buf_temp-parts.real-qnty = 0
      315           buf_temp-parts.cli-qnty  = 0
      316         .
      317       end.
      318     end.
      319   end procedure.
      320   procedure partslib-init-temp-parts :
      321     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      322     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      323     define input parameter p-artic           like ub.parts.artic     no-undo .
      324     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      325     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      326     define buffer buf_parts      for ub.parts .
      327     define buffer buf_temp-parts for temp-parts .
      328     define variable v-goods-twounit    as logical   no-undo .
      329     do
      330     on error undo, return error
      331     :
      332   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      334     (input  p-artic
      335     ,input  p-prod-type
      336     ,input  p-prod-code
      337     ,input  'twounit=request':u
      338     ,output v-goods-twounit
      339     ) no-error .
      340       if error-status :error
      341       then do:
      342         message
      343           vss-workfile vss-revision vss-description skip
      344           vss-include-info2 skip
      345           "Ошибка при определении атрибута товара" skip
      346           "Артикул" p-artic p-prod-type p-prod-code skip
      347           "twounit=request" skip
      348           error-status :get-message(1) skip
      349           return-value skip
      350           view-as alert-box error .
      351         undo, return error return-value .
      352       end.
      353       run partslib-clear-temp-parts in this-procedure .
      354       for each buf_parts
      355         where buf_parts.obj-type  = p-obj-type
      356           and buf_parts.obj-code  = p-obj-code
      357           and buf_parts.artic     = p-artic
      358           and buf_parts.prod-type = p-prod-type
      359           and buf_parts.prod-code = p-prod-code
      360           and buf_parts.rsrv-free = yes
      361           and buf_parts.status_   = no
      362           and buf_parts.in-code   <> buf_parts.out-code
      363       on error undo, return error
      364       :
      365         run partslib-create-temp-parts in this-procedure
      366           (buffer buf_parts
      367           ,buffer buf_temp-parts
      368           ,input  v-goods-twounit
      369           ) .
      370         define variable v-parts-qnty          as decimal   no-undo .
      371         define variable v-parts-cli-qnty      as decimal   no-undo .
      372         define variable v-parts-free-qnty     as decimal   no-undo .
      373         define variable v-parts-free-cli-qnty as decimal   no-undo .
      374         if buf_parts.out-code = 'free-zone':U
      375         then do:
      376           assign
      377             v-parts-qnty          = buf_parts.qnty
      378             v-parts-cli-qnty      = buf_parts.cli-qnty
      379             v-parts-free-qnty     = buf_parts.qnty
      380             v-parts-free-cli-qnty = buf_parts.cli-qnty
      381           .
      382         end.
      383         else do:
      384           assign
      385             v-parts-qnty          = abs(buf_parts.qnty)
      386             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      387             v-parts-free-qnty     = 0
      388             v-parts-free-cli-qnty = 0
      389           .
      390         end.
      391         assign
      392           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      393           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      394           buf_temp-parts.real-qnty     = 0
      395           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      396           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      397           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      398         .
      399       end.
      400     end.
      401   end procedure.
      402   procedure partslib-init-temp-parts-by-factord :
      403     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      404     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      405     define input parameter p-artic              like ub.parts.artic     no-undo .
      406     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      407     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      408     define input parameter p-fact-order         as decimal   no-undo .
      409     define input parameter p-include-fact-order as logical   no-undo .
      410     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      411     define buffer buf_gds-obj  for ub.gds-obj .
      412     do
      413     on error undo, return error
      414     :
      415       do transaction
      416       on error undo, return error
      417       :
      418   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      420     (input  p-obj-type
      421     ,input  p-obj-code
      422     ,input  p-artic
      423     ,input  p-prod-type
      424     ,input  p-prod-code
      425     ,buffer buf_gds-obj
      426     ) no-error .
      427         if error-status :error
      428         then do:
      429           message
      430             vss-workfile vss-revision vss-description skip
      431             vss-include-info2 skip
      432             "Невозможно найти товар на объекте" skip
      433             "Объект" p-obj-type p-obj-code skip
      434             "Артикул" p-artic p-prod-type p-prod-code skip
      435             error-status :get-message(1) skip
      436             return-value skip
      437             view-as alert-box error .
      438           undo, return error .
      439         end.
      440         find current buf_gds-obj exclusive-lock .
      441       end.
      442       run partslib-init-temp-parts in this-procedure
      443         (input p-obj-type
      444         ,input p-obj-code
      445         ,input p-artic
      446         ,input p-prod-type
      447         ,input p-prod-code
      448         ) no-error .
      449       if error-status :error
      450       then do:
      451         message
      452           vss-workfile vss-revision vss-description skip
      453           vss-include-info2 skip
      454           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      455           "Объект" p-obj-type p-obj-code skip
      456           "Артикул" p-artic p-prod-type p-prod-code skip
      457           "p-fact-order" p-fact-order skip
      458           view-as alert-box error .
      459         undo, return error .
      460       end.
      461       if p-include-fact-order = true
      462       then do:
      463         assign
      464           p-fact-order = p-fact-order - 0.0000000001
      465         .
      466       end.
      467       define variable v-max-fact-order as character no-undo .
      468       run factord-max-fact-order in this-procedure
      469         (output v-max-fact-order
      470         ) no-error .
      471       if error-status :error
      472       then do:
      473         message
      474           vss-workfile vss-revision vss-description skip
      475           vss-include-info2 skip
      476           "Ошибка при вызове процедуры factord-max-fact-order" skip
      477           "Объект" p-obj-type p-obj-code skip
      478           "Артикул" p-artic p-prod-type p-prod-code skip
      479           "p-fact-order" p-fact-order skip
      480           view-as alert-box error .
      481         undo, return error .
      482       end.
      483       run partslib-update-by-factord in this-procedure
      484         (input p-obj-type
      485         ,input p-obj-code
      486         ,input p-artic
      487         ,input p-prod-type
      488         ,input p-prod-code
      489         ,input p-fact-order
      490         ,input v-max-fact-order
      491         ,input false
      492         ) no-error .
      493       if error-status :error
      494       then do:
      495         message
      496           vss-workfile vss-revision vss-description skip
      497           vss-include-info2 skip
      498           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      499           "Объект" p-obj-type p-obj-code skip
      500           "Артикул" p-artic p-prod-type p-prod-code skip
      501           "p-fact-order" p-fact-order skip
      502           "v-max-fact-order" v-max-fact-order skip
      503           view-as alert-box error .
      504         undo, return error .
      505       end.
      506     end.
      507   end procedure.
      508   procedure partslib-update-by-factord :
      509     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      510     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      511     define input parameter p-artic              like ub.parts.artic     no-undo .
      512     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      513     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      514     define input parameter p-start-fact-order   as decimal   no-undo .
      515     define input parameter p-end-fact-order     as decimal   no-undo .
      516     define input parameter p-lock-gds-obj       as logical   no-undo .
      517     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      518     define buffer buf_gds-obj  for ub.gds-obj .
      519     define buffer buf_doc-line for ub.doc-line .
      520     define variable v-total-parts-qnty as decimal   no-undo .
      521     define variable v-goods-gds-goods  as logical   no-undo .
      522     define variable v-goods-twounit    as logical   no-undo .
      523     do
      524     on error undo, return error
      525     :
      526       if p-start-fact-order > p-end-fact-order
      527       then do:
      528         message
      529           vss-workfile vss-revision vss-description skip
      530           vss-include-info2 skip
      531           "Ошибка задания входных параметров" skip
      532           "Начало интервала превышает конец интервала" skip
      533           "Объект" p-obj-type p-obj-code skip
      534           "Артикул" p-artic p-prod-type p-prod-code skip
      535           "p-start-fact-order" p-start-fact-order skip
      536           "p-end-fact-order"   p-end-fact-order skip
      537           view-as alert-box error .
      538         undo, return error .
      539       end.
      540       if p-lock-gds-obj = true
      541       then do:
      542         do transaction
      543         on error undo, return error
      544         :
      545   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      547     (input  p-obj-type
      548     ,input  p-obj-code
      549     ,input  p-artic
      550     ,input  p-prod-type
      551     ,input  p-prod-code
      552     ,buffer buf_gds-obj
      553     ) no-error .
      554           if error-status :error
      555           then do:
      556             message
      557               vss-workfile vss-revision vss-description skip
      558               vss-include-info2 skip
      559               "Невозможно найти gds-obj" skip
      560               error-status :get-message(1) skip
      561               return-value skip
      562               view-as alert-box error .
      563             undo, return error .
      564           end.
      565           find current buf_gds-obj exclusive-lock .
      566         end.
      567       end.
      568   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      570     (input  p-artic
      571     ,input  p-prod-type
      572     ,input  p-prod-code
      573     ,input  'gds-goods=request':u
      574     ,output v-goods-gds-goods
      575     ) no-error .
      576       if error-status :error
      577       then do:
      578         message
      579           vss-workfile vss-revision vss-description skip
      580           vss-include-info2 skip
      581           "Ошибка при определении атрибута товара" skip
      582           "Артикул" p-artic p-prod-type p-prod-code skip
      583           "gds-goods=request" skip
      584           error-status :get-message(1) skip
      585           return-value skip
      586           view-as alert-box error .
      587         undo, return error return-value .
      588       end.
      589   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      591     (input  p-artic
      592     ,input  p-prod-type
      593     ,input  p-prod-code
      594     ,input  'twounit=request':u
      595     ,output v-goods-twounit
      596     ) no-error .
      597       if error-status :error
      598       then do:
      599         message
      600           vss-workfile vss-revision vss-description skip
      601           vss-include-info2 skip
      602           "Ошибка при определении атрибута товара" skip
      603           "Артикул" p-artic p-prod-type p-prod-code skip
      604           "twounit=request" skip
      605           error-status :get-message(1) skip
      606           return-value skip
      607           view-as alert-box error .
      608         undo, return error return-value .
      609       end.
      610       for each buf_doc-line no-lock
      611         where buf_doc-line.obj-type   = p-obj-type
      612           and buf_doc-line.obj-code   = p-obj-code
      613           and buf_doc-line.artic      = p-artic
      614           and buf_doc-line.prod-type  = p-prod-type
      615           and buf_doc-line.prod-code  = p-prod-code
      616           and buf_doc-line.status_    = 'факт':U
      617           and buf_doc-line.fact-order > p-start-fact-order
      618           and buf_doc-line.fact-order <= p-end-fact-order
      619       on error undo, return error
      620       :
      621         run partslib-process-document in this-procedure
      622           (input  buf_doc-line.doc-code
      623           ,input  p-obj-type
      624           ,input  p-obj-code
      625           ,input  p-artic
      626           ,input  p-prod-type
      627           ,input  p-prod-code
      628           ,input  v-goods-gds-goods
      629           ,input  v-goods-twounit
      630           ,output v-total-parts-qnty
      631           ) no-error .
      632         if error-status :error
      633         then do:
      634           message
      635             vss-workfile vss-revision vss-description skip
      636             vss-include-info2 skip
      637             "Ошибка при вызове процедуры partslib-process-document" skip
      638             "Документ" buf_doc-line.doc-code skip
      639             "Объект" p-obj-type p-obj-code skip
      640             "Артикул" p-artic p-prod-type p-prod-code skip
      641             "p-start-fact-order" p-start-fact-order skip
      642             "p-end-fact-order" p-end-fact-order skip
      643             error-status :get-message(1) skip
      644             return-value skip
      645             view-as alert-box error .
      646           undo, return error return-value .
      647         end.
      648       end.
      649     end.
      650   end procedure.
      651   procedure partslib-process-document :
      652     define input  parameter p-doc-code         as character no-undo .
      653     define input  parameter p-obj-type         as character no-undo .
      654     define input  parameter p-obj-code         as integer   no-undo .
      655     define input  parameter p-artic            as character no-undo .
      656     define input  parameter p-prod-type        as character no-undo .
      657     define input  parameter p-prod-code        as integer   no-undo .
      658     define input  parameter p-goods-gds-goods  as logical   no-undo .
      659     define input  parameter p-goods-twounit    as logical   no-undo .
      660     define output parameter p-total-parts-qnty as decimal   no-undo .
      661     define variable v-parts-sign as integer   no-undo .
      662     define buffer buf_trn-doc    for ub.trn-doc .
      663     define buffer buf_doc-line   for ub.doc-line .
      664     define buffer buf_parts      for ub.parts .
      665     define buffer buf_temp-parts for temp-parts .
      666     do
      667     on error undo, return error return-value
      668     :
      669       find first buf_trn-doc no-lock
      670         where buf_trn-doc.doc-code = p-doc-code
      671         no-error .
      672       if not available buf_trn-doc
      673       then do:
      674         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      675                                      ,p-doc-code
      676                                      ) .
      677       end.
      678       case buf_trn-doc.doc-type
      679       :
      680         when 'при':U or
      681         when 'возврат':U or
      682         when 'инв':U
      683         then do:
      684           assign
      685             v-parts-sign = -1
      686           .
      687         end.
      688         when 'рас':U or
      689         when 'спи':U
      690         then do:
      691           assign
      692             v-parts-sign = 1
      693           .
      694         end.
      695         otherwise do:
      696           undo, return error substitute("Неизвестный тип документа &1"
      697                                       ,buf_trn-doc.doc-type
      698                                       ) .
      699         end.
      700       end.
      701       find first buf_doc-line no-lock
      702         where buf_doc-line.doc-code  = p-doc-code
      703           and buf_doc-line.artic     = p-artic
      704           and buf_doc-line.prod-type = p-prod-type
      705           and buf_doc-line.prod-code = p-prod-code
      706         no-error .
      707       if not available buf_doc-line
      708       then do:
      709         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      710                                      ,p-doc-code
      711                                      ,artic
      712                                      ,prod-type
      713                                      ,prod-code
      714                                      ) .
      715       end.
      716       assign
      717         p-total-parts-qnty = 0
      718       .
      719       if p-goods-gds-goods = true
      720       then do:
      721         for each buf_parts no-lock
      722           where buf_parts.out-code  = p-doc-code
      723             and buf_parts.obj-type  = p-obj-type
      724             and buf_parts.obj-code  = p-obj-code
      725             and buf_parts.artic     = p-artic
      726             and buf_parts.prod-type = p-prod-type
      727             and buf_parts.prod-code = p-prod-code
      728         on error undo, return error
      729         :
      730           run partslib-create-temp-parts in this-procedure
      731             (buffer buf_parts
      732             ,buffer buf_temp-parts
      733             ,input  p-goods-twounit
      734             ) .
      735           assign
      736             p-total-parts-qnty        = p-total-parts-qnty
      737                                       + v-parts-sign * buf_parts.fact-qnty
      738             buf_temp-parts.qnty       = buf_temp-parts.qnty
      739                                       + v-parts-sign * buf_parts.fact-qnty
      740             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      741                                       + v-parts-sign * buf_parts.fact-qnty
      742             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      743                                       + v-parts-sign * buf_parts.cli-qnty
      744           .
      745           if buf_temp-parts.qnty = 0
      746           then do:
      747             delete buf_temp-parts .
      748           end.
      749         end.
      750       end.
      751       else do:
      752         assign
      753           p-total-parts-qnty = p-total-parts-qnty
      754                              + v-parts-sign * buf_doc-line.fact-qnty
      755         .
      756       end.
      757     end.
      758   end procedure.
      759   procedure partslib-init-temp-parts-by-date :
      760     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      761     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      762     define input parameter p-artic           like ub.parts.artic     no-undo .
      763     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      764     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      765     define input parameter p-fact-date       as date      no-undo .
      766     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      767     do
      768     on error undo, return error
      769     :
      770       define variable v-fact-order                as decimal   no-undo .
      771       define variable v-shift-end-fact-order      as decimal   no-undo .
      772       define variable v-day-end-fact-order        as decimal   no-undo .
      773       run factord in this-procedure
      774         (input  p-fact-date
      775         ,input  1
      776         ,input  1
      777         ,input  ?
      778         ,input  0
      779         ,input  false
      780         ,output v-fact-order
      781         ,output v-shift-end-fact-order
      782         ,output v-day-end-fact-order
      783         ) no-error .
      784       if error-status :error
      785       then do:
      786         message
      787           vss-workfile vss-revision vss-description skip
      788           vss-include-info2 skip
      789           "Ошибка при определении момента времени, на который требуется остаток" skip
      790           "Объект" p-obj-type p-obj-code skip
      791           "Артикул" p-artic p-prod-type p-prod-code skip
      792           "Дата" p-fact-date skip
      793           view-as alert-box error .
      794         undo, return error .
      795       end.
      796       run partslib-init-temp-parts-by-factord in this-procedure
      797         (input p-obj-type
      798         ,input p-obj-code
      799         ,input p-artic
      800         ,input p-prod-type
      801         ,input p-prod-code
      802         ,input v-day-end-fact-order
      803         ,input false
      804         ) no-error .
      805       if error-status :error
      806       then do:
      807         message
      808           vss-workfile vss-revision vss-description skip
      809           vss-include-info2 skip
      810           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      811           "Объект" p-obj-type p-obj-code skip
      812           "Артикул" p-artic p-prod-type p-prod-code skip
      813           "Дата" p-fact-date skip
      814           view-as alert-box error .
      815         undo, return error .
      816       end.
      817     end.
      818   end procedure.
      819   procedure partslib-calc-cost :
      820     define output parameter p-fact-qnty      as decimal   no-undo .
      821     define output parameter p-vat-pc         as decimal   no-undo .
      822     define output parameter p-slt-pc         as decimal   no-undo .
      823     define output parameter p-sum-base       as decimal   no-undo .
      824     define output parameter p-sum-rubl       as decimal   no-undo .
      825     define output parameter p-vat-base       as decimal   no-undo .
      826     define output parameter p-vat-rubl       as decimal   no-undo .
      827     define output parameter p-slt-base       as decimal   no-undo .
      828     define output parameter p-slt-rubl       as decimal   no-undo .
      829     define output parameter p-road-tax-base  as decimal   no-undo .
      830     define output parameter p-road-tax-rubl  as decimal   no-undo .
      831     define output parameter p-transport-base as decimal   no-undo .
      832     define output parameter p-transport-rubl as decimal   no-undo .
      833     define output parameter p-other-base     as decimal   no-undo .
      834     define output parameter p-other-rubl     as decimal   no-undo .
      835     define output parameter p-excise-base    as decimal   no-undo .
      836     define output parameter p-excise-rubl    as decimal   no-undo .
      837     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      838     do
      839     on error undo, return error return-value
      840     :
      841       define buffer buf_temp-parts for temp-parts .
      842       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      843       define buffer   in-vatp-parts    for ub.parts   .
      844       define buffer   in-vatp-doc      for ub.trn-doc .
      845       define buffer   in-vatp-goods    for ub.goods   .
      846       define buffer   in-vatp-sysconf  for ub.sysconf .
      847       define buffer   in-vatp_doc-attr for ub.doc-attr.
      848       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      849       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      850       define variable varinvprb                  as   character              no-undo.
      851       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      852       define variable cli-base-rate              as   decimal                no-undo.
      853       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      854       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      855       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      856       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      857       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      858       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      859       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      860       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      861       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      862       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      863       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      864       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      865       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      866       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      867       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      868       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      869       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      870       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      871       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      872       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      873       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      874       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      875       define variable varinvatp-envd             as   character              no-undo.
      876       define variable varinvatp-type             as   character              no-undo.
      877       for each buf_temp-parts
      878       on error undo, return error
      879       :
      880   assign
      881     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      882     price-base-with-tax-loc = buf_temp-parts.price-base
      883   .
      884   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      885   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      886     (output varinvprb
      887     )  .
      888     if buf_temp-parts.out-code = 'free-zone':U     or
      889        buf_temp-parts.out-code = 'out-zone':U   or
      890        buf_temp-parts.doc-type = 'акт':U then do:
      891       assign
      892         in-vatp-have-vat-slt = yes.
      893     end.
      894     else do:
      895       find first in-vatp_doc-attr no-lock
      896         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      897           and in-vatp_doc-attr.attr-code = 'envd':U
      898         no-error .
      899       if not available in-vatp_doc-attr then do:
      900         assign
      901           in-vatp-have-vat-slt = yes.
      902       end.
      903       else do:
      904            in-vatp-have-vat-slt = no.
      905       end.
      906     end.
      907     assign
      908      price-cli-with-tax-loc = buf_temp-parts.price-cli
      909      cli-base-rate          = buf_temp-parts.cli-base-rate.
      910     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      911              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      912     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      913             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      914             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      915             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      916             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      917             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      918             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      919       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      920     assign
      921       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      922     assign
      923       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      924       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      925       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      926       transport-cli-loc  = 0
      927       other-cli-loc      = 0
      928     .
      929   ASSIGN
      930             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      931       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      932   .
      933         assign
      934           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      935           p-vat-pc         = p-vat-pc         + vat-pc-loc
      936           p-slt-pc         = p-slt-pc         + slt-pc-loc
      937           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      938           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      939           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      940           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      941           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      942           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      943           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      944           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      945           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      946           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      947           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      948           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      949           p-excise-base    = p-excise-base    + 0
      950           p-excise-rubl    = p-excise-rubl    + 0
      951         .
      952       end.
      953       if p-fact-qnty      = ?
      954       or p-sum-base       = ?
      955       or p-sum-rubl       = ?
      956       or p-vat-base       = ?
      957       or p-vat-rubl       = ?
      958       or p-slt-base       = ?
      959       or p-slt-rubl       = ?
      960       or p-road-tax-base  = ?
      961       or p-road-tax-rubl  = ?
      962       or p-transport-base = ?
      963       or p-transport-rubl = ?
      964       or p-other-base     = ?
      965       or p-other-rubl     = ?
      966       or p-excise-base    = ?
      967       or p-excise-rubl    = ?
      968       then do:
      969         message
      970           vss-workfile vss-revision vss-description skip
      971           vss-include-info2 skip
      972           "Программа in-vatp.i вернула неопределенные значения" skip
      973           "p-fact-qnty"      p-fact-qnty      skip
      974           "p-sum-base"       p-sum-base       skip
      975           "p-sum-rubl"       p-sum-rubl       skip
      976           "p-vat-base"       p-vat-base       skip
      977           "p-vat-rubl"       p-vat-rubl       skip
      978           "p-slt-base"       p-slt-base       skip
      979           "p-slt-rubl"       p-slt-rubl       skip
      980           "p-road-tax-base"  p-road-tax-base  skip
      981           "p-road-tax-rubl"  p-road-tax-rubl  skip
      982           "p-transport-base" p-transport-base skip
      983           "p-transport-rubl" p-transport-rubl skip
      984           "p-other-base"     p-other-base     skip
      985           "p-other-rubl"     p-other-rubl     skip
      986           "p-excise-base"    p-excise-base    skip
      987           "p-excise-rubl"    p-excise-rubl    skip
      988           view-as alert-box error .
      989         undo, return error .
      990       end.
      991     end.
      992   end procedure.
      993   define stream sout .
      994   define variable v-status        as character no-undo .
      995   define variable v-error-message as character no-undo .
      996   define variable v-ret-obj-type  as character no-undo .
      997   define variable v-ret-obj-code  as character no-undo .
      998   define variable v-bar-code-str  as character no-undo .
      999   define variable v-price-label   as character no-undo .
     1000   define variable v-price-sale    as character no-undo .
     1001   define variable v-artic         as character no-undo .
     1002   define variable v-name          as character no-undo .
     1003   define variable v-prod-name     as character no-undo .
     1004   define variable v-prod-type     as character no-undo .
     1005   define variable v-prod-code     as character no-undo .
     1006   define variable v-fact-qnty     as character no-undo .
     1007   define variable v-unit-base     as character no-undo .
     1008   define variable v-rsrv-qnty     as character no-undo .
     1009   define variable v-min-stock     as character no-undo .
     1010   define variable v-last-date     as character no-undo .
     1011   do
     1012   on error undo, return error return-value
     1013   :
     1014     if p-data-valid = true
     1015     then do:
     1016       run check-data in this-procedure
     1017         (output v-status
     1018         ,output v-error-message
     1019         ,output v-ret-obj-type
     1020         ,output v-ret-obj-code
     1021         ,output v-bar-code-str
     1022         ,output v-price-label
     1023         ,output v-price-sale
     1024         ,output v-artic
     1025         ,output v-name
     1026         ,output v-prod-name
     1027         ,output v-prod-type
     1028         ,output v-prod-code
     1029         ,output v-fact-qnty
     1030         ,output v-unit-base
     1031         ,output v-rsrv-qnty
     1032         ,output v-min-stock
     1033         ,output v-last-date
     1034         ) no-error .
     1035       if error-status :error
     1036       then do:
     1037         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
     1038                                     ,error-status :get-message(1)
     1039                                     ,return-value
     1040                                     ) .
     1041       end.
     1042     end.
     1043     else do:
     1044       assign
     1045         v-status        = '2':u
     1046         v-error-message = p-error-message
     1047         v-ret-obj-type  = ''
     1048         v-ret-obj-code  = ''
     1049         v-bar-code-str  = ''
     1050         v-price-label   = ''
     1051         v-price-sale    = ''
     1052         v-artic         = ''
     1053         v-name          = ''
     1054         v-prod-name     = ''
     1055         v-prod-type     = ''
     1056         v-prod-code     = ''
     1057         v-fact-qnty     = ''
     1058         v-unit-base     = ''
     1059         v-rsrv-qnty     = ''
     1060         v-min-stock     = ''
     1061         v-last-date     = ''
     1062       .
     1063     end.
     1064     define variable v-temp-file-name as character no-undo .
     1065     assign
     1066       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
     1067     .
     1068     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
     1069     put stream sout unformatted substitute('status:&1',       rtencode(v-status))
     1070       + chr(10) .
     1071     put stream sout unformatted substitute('message:&1',      rtencode(v-error-message))
     1072       + chr(10) .
     1073     put stream sout unformatted substitute('obj_type:&1',     rtencode(v-ret-obj-type))
     1074       + chr(10) .
     1075     put stream sout unformatted substitute('obj_code:&1',     rtencode(v-ret-obj-code))
     1076       + chr(10) .
     1077     put stream sout unformatted substitute('bar_code_str:&1', rtencode(v-bar-code-str))
     1078       + chr(10) .
     1079     put stream sout unformatted substitute('price_label:&1',  rtencode(v-price-label))
     1080       + chr(10) .
     1081     put stream sout unformatted substitute('price_sale:&1',   rtencode(v-price-sale))
     1082       + chr(10) .
     1083     put stream sout unformatted substitute('artic:&1',        rtencode(v-artic))
     1084       + chr(10) .
     1085     put stream sout unformatted substitute('name:&1',         rtencode(v-name))
     1086       + chr(10) .
     1087     put stream sout unformatted substitute('prod_name:&1',    rtencode(v-prod-name))
     1088       + chr(10) .
     1089     put stream sout unformatted substitute('prod_type:&1',    rtencode(v-prod-type))
     1090       + chr(10) .
     1091     put stream sout unformatted substitute('prod_code:&1',    rtencode(v-prod-code))
     1092       + chr(10) .
     1093     put stream sout unformatted substitute('fact_qnty:&1',    rtencode(v-fact-qnty))
     1094       + chr(10) .
     1095     put stream sout unformatted substitute('unit_base:&1',    rtencode(v-unit-base))
     1096       + chr(10) .
     1097     put stream sout unformatted substitute('rsrv_qnty:&1',    rtencode(v-rsrv-qnty))
     1098       + chr(10) .
     1099     put stream sout unformatted substitute('min_stock:&1',    rtencode(v-min-stock))
     1100       + chr(10) .
     1101     put stream sout unformatted substitute('last_date:&1',    rtencode(v-last-date))
     1102       + chr(10) .
     1103     output stream sout close .
     1104     os-delete value(p-directory-out + '/':u + p-file-name) .
     1105     os-rename value(p-directory-out + '/':u + v-temp-file-name)
     1106               value(p-directory-out + '/':u + p-file-name)
     1107               .
     1108   end.
     1109   procedure check-data :
     1110     define output parameter p-status        as character no-undo .
     1111     define output parameter p-error-message as character no-undo .
     1112     define output parameter p-ret-obj-type  as character no-undo .
     1113     define output parameter p-ret-obj-code  as character no-undo .
     1114     define output parameter p-bar-code-str  as character no-undo .
     1115     define output parameter p-price-label   as character no-undo .
     1116     define output parameter p-price-sale    as character no-undo .
     1117     define output parameter p-artic         as character no-undo .
     1118     define output parameter p-name          as character no-undo .
     1119     define output parameter p-prod-name     as character no-undo .
     1120     define output parameter p-prod-type     as character no-undo .
     1121     define output parameter p-prod-code     as character no-undo .
     1122     define output parameter p-fact-qnty     as character no-undo .
     1123     define output parameter p-unit-base     as character no-undo .
     1124     define output parameter p-rsrv-qnty     as character no-undo .
     1125     define output parameter p-min-stock     as character no-undo .
     1126     define output parameter p-last-date     as character no-undo .
     1127     define buffer buf_clients      for ub.clients .
     1128     define buffer buf_sysconf      for ub.sysconf .
     1129     define buffer buf_bar-code     for ub.bar-code .
     1130     define buffer buf_goods        for ub.goods .
     1131     define buffer buf_gds-obj      for ub.gds-obj .
     1132     define buffer buf_gds-obj-prop for ub.gds-obj-prop .
     1133     define buffer buf_sys-ctrl     for ub.sys-ctrl .
     1134     define buffer buf_user-login   for ub.user-login .
     1135     define variable v-b-code as integer   no-undo .
     1136     do
     1137     on error undo, return error return-value
     1138     :
     1139       find first buf_sys-ctrl no-lock .
     1140       find first buf_user-login no-lock
     1141         where buf_user-login.db-num = buf_sys-ctrl.db-num
     1142           and buf_user-login.status_    = 0
     1143           and buf_user-login.user-login = p-user-login
     1144         no-error .
     1145       if not available buf_user-login
     1146       then do:
     1147         assign
     1148           p-status        = '2':u
     1149           p-error-message = substitute("Неизвестный пользователь &1"
     1150                                       ,p-error-message
     1151                                       )
     1152         .
     1153         return .
     1154       end.
     1155       define variable v-obj-code      as integer   no-undo .
     1156       define variable v-data-valid    as logical   no-undo .
     1157       define variable v-error-message as character no-undo .
     1158       if p-obj-code = ""
     1159       then do:
     1160         assign
     1161           p-status        = '2':u
     1162           p-error-message = "Не задан код объекта"
     1163         .
     1164         return .
     1165       end.
     1166       run integerm in this-procedure
     1167         (input  p-obj-code
     1168         ,input  false
     1169         ,input  false
     1170         ,output v-obj-code
     1171         ,output v-data-valid
     1172         ,output v-error-message
     1173         ) .
     1174       if v-data-valid <> true
     1175       then do:
     1176         assign
     1177           p-status        = '2':u
     1178           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
     1179                                       ,p-obj-code
     1180                                       ,v-error-message
     1181                                       )
     1182         .
     1183         return .
     1184       end.
     1185       find first buf_clients no-lock
     1186         where buf_clients.obj-type = p-obj-type
     1187           and buf_clients.obj-code = v-obj-code
     1188         no-error .
     1189       if not available buf_clients
     1190       then do:
     1191         assign
     1192           p-status        = '2':u
     1193           p-error-message = substitute("Не найден объект &1 &2"
     1194                                       ,p-obj-type
     1195                                       ,v-obj-code
     1196                                       )
     1197         .
     1198         return .
     1199       end.
     1200       if  p-obj-type <> 'маг':U
     1201       and p-obj-type <> 'скл':U
     1202       then do:
     1203         assign
     1204           p-status        = '2':u
     1205           p-error-message = substitute("Неправильный тип объекта &1 &2"
     1206                                       ,p-obj-type
     1207                                       ,v-obj-code
     1208                                       )
     1209         .
     1210         return .
     1211       end.
     1212       define variable v-host-code as integer   no-undo .
     1213   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1215     (input  buf_clients.obj-type
     1216     ,input  buf_clients.obj-code
     1217     ,output v-host-code
     1218     )  .
     1219       define variable v-object-available as logical   no-undo .
     1220   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1222     (input  buf_sys-ctrl.db-num
     1223     ,input  0
     1224     ,input  buf_user-login.user-id
     1225     ,input  buf_clients.obj-type
     1226     ,input  buf_clients.obj-code
     1227     ,output v-object-available
     1228     )  .
     1229       if v-object-available <> true
     1230       then do:
     1231         assign
     1232           p-status        = '2':u
     1233           p-error-message = substitute("Пользователю не доступен объект &1 &2"
     1234                                       ,buf_clients.obj-type
     1235                                       ,buf_clients.obj-code
     1236                                       )
     1237         .
     1238         return .
     1239       end.
     1240       define variable v-valid-act   as logical   no-undo .
     1241   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   do:
     1243     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1244       (input  buf_sys-ctrl.db-num
     1245       ,input  buf_user-login.user-id
     1246       ,input  0
     1247       ,input  'actn_rt-check-price_work':U
     1248       ,input  'object':U
     1249       ,input  v-host-code
     1250       ,input  buf_clients.obj-type
     1251       ,input  buf_clients.obj-code
     1252       ,input  0
     1253       ,input  0
     1254       ,input  0
     1255       ,input  false
     1256       ,output v-valid-act
     1257       )  .
     1258   end.
     1259       if v-valid-act <> true
     1260       then do:
     1261         assign
     1262           p-status        = '2':u
     1263           p-error-message = return-value
     1264         .
     1265         return .
     1266       end.
     1267       find first buf_sysconf no-lock
     1268         where buf_sysconf.host-code = v-host-code
     1269         no-error .
     1270       if not available buf_sysconf
     1271       then do:
     1272         assign
     1273           p-status        = '2':u
     1274           p-error-message = substitute("Не найдена фирма &1"
     1275                                       ,v-host-code
     1276                                       )
     1277         .
     1278         return .
     1279       end.
     1280       define variable v-bar-code        as character no-undo .
     1281       define variable v-price-label     as decimal   no-undo .
     1282       define variable v-prc-price-label as decimal   no-undo .
     1283       case num-entries(p-bar-code, '/':u)
     1284       :
     1285         when 1
     1286         then do:
     1287           assign
     1288             v-bar-code        = p-bar-code
     1289             v-prc-price-label = 0
     1290           .
     1291         end.
     1292         when 2
     1293         then do:
     1294           assign
     1295             v-bar-code = entry(1, p-bar-code, '/':u)
     1296           .
     1297           assign
     1298             v-prc-price-label = decimal(entry(2, p-bar-code, '/':u)) no-error
     1299           .
     1300           if error-status :error
     1301           then do:
     1302             assign
     1303               p-status        = '2':u
     1304               p-error-message = substitute("Ошибка в указании цены в составе штрих кода &1"
     1305                                           ,p-bar-code
     1306                                           )
     1307             .
     1308             return .
     1309           end.
     1310         end.
     1311         otherwise do:
     1312           assign
     1313             p-status        = '2':u
     1314             p-error-message = substitute("Ошибка в указании формата строки проверки штрих-кода &1"
     1315                                         ,p-bar-code
     1316                                         )
     1317           .
     1318           return .
     1319         end.
     1320       end.
     1321       run gbl/getbcode.p
     1322         (input  parparentproc
     1323         ,input  v-bar-code
     1324         ,input  ""
     1325         ,input  0
     1326         ,input  false
     1327         ,output v-b-code
     1328         ) .
     1329       if v-b-code = ?
     1330       then do:
     1331         assign
     1332           p-status        = '2'
     1333           p-error-message = substitute('Не найден штрих-код &1'
     1334                                       ,v-bar-code
     1335                                       )
     1336         .
     1337         return .
     1338       end.
     1339       find first buf_bar-code no-lock
     1340         where buf_bar-code.b-code = v-b-code
     1341         no-error .
     1342       if not available buf_bar-code
     1343       then do:
     1344         assign
     1345           p-status        = '2'
     1346           p-error-message = substitute('Ошибка поиска записи bar-code &1'
     1347                                       ,v-b-code
     1348                                       )
     1349         .
     1350         return .
     1351       end.
     1352       find first buf_goods no-lock
     1353         where buf_goods.gds-code = buf_bar-code.gds-code
     1354         no-error .
     1355       if not available buf_goods
     1356       then do:
     1357         assign
     1358           p-status        = '2'
     1359           p-error-message = substitute('Ошибка поиска записи товар с кодом &1 для бар-кода &2'
     1360                                       ,buf_bar-code.gds-code
     1361                                       ,v-b-code
     1362                                       )
     1363         .
     1364         return .
     1365       end.
     1366       define variable v-prc-doc-num     as character no-undo .
     1367       define variable v-prc-price-sale  as decimal   no-undo .
     1368       define variable v-prc-road-tax    as decimal   no-undo .
     1369       define variable v-prc-excise      as decimal   no-undo .
     1370   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1372     (input  p-obj-type
     1373     ,input  v-obj-code
     1374     ,input  v-b-code
     1375     ,input  0
     1376     ,input  0
     1377     ,output v-prc-doc-num
     1378     ,output v-prc-price-sale
     1379     ,output v-prc-road-tax
     1380     ,output v-prc-excise
     1381     ) no-error .
     1382       if error-status :error
     1383       then do:
     1384         assign
     1385           p-status        = '2'
     1386           p-error-message = substitute('Ошибка при поиске записи переоценки для штрих кода &1 &2 &3'
     1387                                       ,v-bar-code
     1388                                       ,error-status :get-message(1)
     1389                                       ,return-value
     1390                                       )
     1391         .
     1392         return .
     1393       end.
     1394       if v-prc-price-sale = ?
     1395       then do:
     1396         assign
     1397           v-prc-price-sale = 0
     1398         .
     1399       end.
     1400       find first buf_clients no-lock
     1401         where buf_clients.obj-type = buf_goods.prod-type
     1402           and buf_clients.obj-code = buf_goods.prod-code
     1403         no-error .
     1404       if not available buf_clients
     1405       then do:
     1406         assign
     1407           p-status        = '2':u
     1408           p-error-message = substitute("Ошибка при поиске записи поставщика &1 &2 для товара с кодом &3"
     1409                                       ,buf_goods.prod-type
     1410                                       ,buf_goods.prod-code
     1411                                       ,buf_goods.gds-code
     1412                                       )
     1413         .
     1414         return .
     1415       end.
     1416       assign
     1417         p-prod-name = buf_clients.obj-name
     1418       .
     1419       find first buf_gds-obj no-lock
     1420         where buf_gds-obj.gds-code = buf_goods.gds-code
     1421           and buf_gds-obj.obj-type = p-obj-type
     1422           and buf_gds-obj.obj-code = v-obj-code
     1423         no-error .
     1424       if available buf_gds-obj
     1425       then do:
     1426         assign
     1427           p-fact-qnty = string(buf_gds-obj.fact-qnty)
     1428           p-rsrv-qnty = string(buf_gds-obj.fact-qnty - buf_gds-obj.free-qnty)
     1429         .
     1430       end.
     1431       else do:
     1432         assign
     1433           p-fact-qnty = string(0.0)
     1434           p-rsrv-qnty = string(0.0)
     1435         .
     1436       end.
     1437       define variable v-attr-value as character no-undo .
     1438       define variable v-attr-type  as character no-undo .
     1439       find first buf_gds-obj-prop no-lock
     1440         where buf_gds-obj-prop.obj-type = p-obj-type
     1441           and buf_gds-obj-prop.obj-code = v-obj-code
     1442           and buf_gds-obj-prop.gds-code = buf_goods.gds-code
     1443         no-error .
     1444       if available buf_gds-obj-prop
     1445       then do:
     1446         assign
     1447           p-min-stock = string(buf_gds-obj-prop.gdop-min-stock)
     1448         .
     1449       end.
     1450       else do:
     1451         assign
     1452           p-min-stock = string(0)
     1453         .
     1454       end.
     1455       define variable v-bc-frmt  as character no-undo .
     1456       define variable v-bc-pfx   as character no-undo .
     1457       define variable v-par-type as character no-undo .
     1458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1459     (input  'bc-frmt':u
     1460     ,input  '':u
     1461     ,input  '':u
     1462     ,input  0
     1463     ,input  '':u
     1464     ,input  '':u
     1465     ,input  '':u
     1466     ,input  false
     1467     ,output v-bc-frmt
     1468     ,output v-par-type
     1469     ) no-error .
     1470       if error-status :error
     1471       then do:
     1472         assign
     1473           p-status        = '2':u
     1474           p-error-message = substitute("Ошибка при чтении конфигурационного параметра &1"
     1475                                       ,'bc-frmt':u
     1476                                       )
     1477         .
     1478         return .
     1479       end.
     1480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1481     (input  'bc-pfx':u
     1482     ,input  '':u
     1483     ,input  '':u
     1484     ,input  0
     1485     ,input  '':u
     1486     ,input  '':u
     1487     ,input  '':u
     1488     ,input  false
     1489     ,output v-bc-pfx
     1490     ,output v-par-type
     1491     ) no-error .
     1492       if error-status :error
     1493       then do:
     1494         assign
     1495           p-status        = '2':u
     1496           p-error-message = substitute("Ошибка при чтении конфигурационного параметра &1"
     1497                                       ,'bc-pfx':u
     1498                                       )
     1499         .
     1500         return .
     1501       end.
     1502   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-ean in g#library
     1504     (input  v-bc-frmt
     1505     ,input  v-bc-pfx
     1506     ,input  v-b-code
     1507     ,output p-bar-code-str
     1508     ) no-error .
     1509       if error-status :error
     1510       then do:
     1511         assign
     1512           p-status        = '2':u
     1513           p-error-message = substitute("Ошибка при поиске промышленного кода для бар-кода &1"
     1514                                       ,v-b-code
     1515                                       )
     1516         .
     1517         return .
     1518       end.
     1519       run partslib-init-temp-parts in this-procedure
     1520         (input p-obj-type
     1521         ,input v-obj-code
     1522         ,input buf_goods.artic
     1523         ,input buf_goods.prod-type
     1524         ,input buf_goods.prod-code
     1525         ) .
     1526       define variable v-last-date as date      no-undo .
     1527       assign
     1528         v-last-date = ?
     1529       .
     1530       define buffer buf_temp-parts for temp-parts .
     1531       for each buf_temp-parts
     1532       on error undo, return error return-value
     1533       :
     1534         if  buf_temp-parts.last-date <> ?
     1535         and (v-last-date = ?
     1536             or
     1537                (v-last-date <> ?
     1538                and
     1539                buf_temp-parts.last-date < v-last-date
     1540                )
     1541             )
     1542         then do:
     1543           assign
     1544             v-last-date = buf_temp-parts.last-date
     1545           .
     1546         end.
     1547       end.
     1548       if v-last-date = ?
     1549       then do:
     1550         assign
     1551           p-last-date = ''
     1552         .
     1553       end.
     1554       else do:
     1555         assign
     1556           p-last-date = string(v-last-date, '99.99.9999':u)
     1557         .
     1558       end.
     1559       if v-prc-price-label = v-prc-price-sale
     1560       then do:
     1561         assign
     1562           p-status = '0':u
     1563         .
     1564       end.
     1565       else do:
     1566         assign
     1567           p-status = '1':u
     1568         .
     1569       end.
     1570       assign
     1571         p-error-message = ""
     1572         p-ret-obj-type  = p-obj-type
     1573         p-ret-obj-code  = string(v-obj-code)
     1574         p-price-label   = string(v-price-label)
     1575         p-price-sale    = string(v-price-sale)
     1576         p-artic         = buf_goods.artic
     1577         p-name          = buf_goods.gds-name
     1578         p-prod-type     = buf_goods.prod-type
     1579         p-prod-code     = string(buf_goods.prod-code)
     1580         p-unit-base     = buf_goods.unit-base
     1581         p-price-label   = string(v-prc-price-label)
     1582         p-price-sale    = string(v-prc-price-sale)
     1583       .
     1584     end.
     1585   end procedure.
