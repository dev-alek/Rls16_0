        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: mcrexlts.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/mcrexlts.p $":U .
        7   define variable vss-description as character no-undo init "Программа пример запуска внешней сессии".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
       68   procedure paramls-clear :
       69     define buffer buf_temp-param for temp-param .
       70     do
       71     on error undo, return error return-value
       72     :
       73       for each buf_temp-param
       74       on error undo, return error
       75       :
       76         delete buf_temp-param .
       77       end.
       78     end.
       79   end procedure.
       80   procedure paramls-write :
       81     define input  parameter p-code     as character no-undo .
       82     define input  parameter p-sub-code as character no-undo .
       83     define input  parameter p-value    as character no-undo .
       84     define buffer buf_temp-param for temp-param .
       85     do
       86     on error undo, return error return-value
       87     :
       88       find first buf_temp-param
       89         where buf_temp-param.param-code     = p-code
       90           and buf_temp-param.param-sub-code = p-sub-code
       91         no-error .
       92       if not available buf_temp-param then do:
       93         create buf_temp-param .
       94         assign
       95           buf_temp-param.param-code     = p-code
       96           buf_temp-param.param-sub-code = p-sub-code
       97         .
       98       end.
       99       assign
      100         buf_temp-param.param-value = p-value
      101       .
      102     end.
      103   end procedure.
      104   procedure paramls-read :
      105     define input  parameter p-code          as character no-undo .
      106     define input  parameter p-sub-code      as character no-undo .
      107     define input  parameter p-default-value as character no-undo .
      108     define output parameter p-value         as character no-undo .
      109     define buffer buf_temp-param for temp-param .
      110     do
      111     on error undo, return error return-value
      112     :
      113       find first buf_temp-param
      114         where buf_temp-param.param-code     = p-code
      115           and buf_temp-param.param-sub-code = p-sub-code
      116         no-error .
      117       if available buf_temp-param then do:
      118         assign
      119           p-value = buf_temp-param.param-value
      120         .
      121       end.
      122       else do:
      123         assign
      124           p-value = p-default-value
      125         .
      126       end.
      127     end.
      128   end procedure.
      129   procedure paramls-append :
      130     define input  parameter p-code     as character no-undo .
      131     define input  parameter p-sub-code as character no-undo .
      132     define input  parameter p-value    as character no-undo .
      133     define buffer buf_temp-param for temp-param .
      134     do
      135     on error undo, return error return-value
      136     :
      137       find first buf_temp-param
      138            where buf_temp-param.param-code     = p-code
      139              and buf_temp-param.param-sub-code = p-sub-code
      140         no-error .
      141       if not available buf_temp-param then do:
      142         create buf_temp-param .
      143         assign
      144           buf_temp-param.param-code     = p-code
      145           buf_temp-param.param-sub-code = p-sub-code
      146           buf_temp-param.param-value    = p-value
      147         .
      148       end.
      149       else do:
      150           assign
      151               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      152           .
      153       end.
      154     end.
      155   end procedure.
      156   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      157   define variable v-waitfram-action01         as character   no-undo .
      158   define variable v-waitfram-action02         as character   no-undo .
      159   define variable v-waitfram-action03         as character   no-undo .
      160   define variable mWaitFramTextBeg            as character   no-undo.
      161   define variable mWaitFramTextEnd            as character   no-undo.
      162   define variable mWaitFramView               as logical     no-undo.
      163   define variable mWaitProcEvent              as logical     no-undo init yes.
      164   define variable mWaitFramInterval           as integer     no-undo init 1 .
      165   define variable mWaitFramStop               as logical     no-undo.
      166   define variable mWaitFramStopUser           as logical     no-undo.
      167   define variable mWaitFramStopTimeOut        as logical     no-undo.
      168   define variable mWaitFramStartProc          as datetime-tz no-undo.
      169   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      170   define button B-WaitFramStop auto-end-key
      171        label "Стоп"
      172        size 10 by 1 tooltip "Остоновить процесс".
      173   define button B-viewProcInfo
      174        label "Информация"
      175        size 15 by 1 tooltip "Информация о процесс".
      176   define frame waitfram
      177     v-waitfram-action01 format "x(72)" no-label skip
      178     v-waitfram-action02 format "x(72)" no-label skip
      179     v-waitfram-action03 format "x(72)" no-label skip
      180     B-viewProcInfo
      181     B-WaitFramStop at row 4 col 30
      182     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      183     .
      184   define new global shared variable mBatchMode as logical no-undo init ?.
      185   define variable mFramBachModHandle as handle no-undo.
      186   mFramBachModHandle = frame waitfram:handle.
      187   define variable mFameOldVis as logical no-undo.
      188   define variable mVisCUrentVin as logical no-undo.
      189   if session:batch-mode
      190   then
      191      mBatchMode = yes.
      192   if mBatchMode = ? then do:
      193     mVisCUrentVin = current-window:visible.
      194     mFameOldVis = mFramBachModHandle:visible.
      195     mFramBachModHandle:visible  = yes.
      196     mBatchMode = mFramBachModHandle:visible ne yes.
      197     mFramBachModHandle:visible = mFameOldVis.
      198     current-window:visible = mVisCUrentVin.
      199   end.
      200    if  log-manager:logfile-name ne ?
      201     then DO:
      202         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      203         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      204         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      205     end.
      206   on choose of B-WaitFramStop in frame waitfram
      207   do:
      208     mWaitFramStop = yes.
      209     mWaitFramStopUser = yes.
      210   end.
      211   function waitfram-check-timeout returns logical():
      212      define variable vtime as int64 no-undo.
      213      if mWaitFramStopTimeOut
      214      then
      215         return yes.
      216      vtime = ( now - mWaitFramStartProc ) / 1000 .
      217      if     mWaitFramTimeOut ne ?
      218         and mWaitFramTimeOut ne 0
      219         and mWaitFramTimeOut lt vtime
      220      then do:
      221         mWaitFramStopTimeOut = yes.
      222      end.
      223      return mWaitFramStopTimeOut.
      224   end.
      225   procedure waitfram-hide :
      226     if not session:batch-mode
      227     then do
      228     on error undo, return error return-value
      229     :
      230       pause 0 before-hide .
      231       if not mBatchMode then
      232         hide frame waitfram .
      233     if     not mWaitFramView
      234        and mWaitProcEvent
      235     then
      236       process events .
      237     end.
      238   end procedure.
      239   procedure waitfram-show :
      240     define input  parameter p-message as character no-undo .
      241     define variable v-left-margin as integer   no-undo .
      242     if not session:batch-mode
      243     then do
      244     on error undo, return error return-value
      245     :
      246       if length(p-message) <= 70 then do:
      247         assign
      248           v-left-margin = integer((70 - length(p-message)) / 2)
      249         .
      250         assign
      251           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      252         .
      253         assign
      254           v-waitfram-action01 = " "
      255           v-waitfram-action02 = " "
      256                                    + fill(" ", v-left-margin)
      257                                    + p-message
      258           v-waitfram-action03 = " "
      259         .
      260       end.
      261       else do:
      262         define variable vRindex1 as integer no-undo.
      263         define variable vRindex2 as integer no-undo.
      264         vRindex1 = r-index(p-message," ",70).
      265         if vRindex1 = 0
      266         then
      267            vRindex1 = 70.
      268         if length(p-message)  <= vRindex1 + 70 then do:
      269           assign
      270             v-waitfram-action01 = " "
      271             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      272             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      273           .
      274         end.
      275         else do:
      276           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      277           if vRindex2 <= vRindex1
      278           then
      279              vRindex2 = vRindex1 + 70.
      280           assign
      281             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      282             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      283             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      284           .
      285         end.
      286       end.
      287       B-viewProcInfo:visible   in frame waitfram = no.
      288       B-viewProcInfo:sensitive in frame waitfram = no.
      289       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      290       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      291       if  (   mWaitFramView
      292          or  mWaitProcEvent)
      293          and not mBatchMode
      294       then
      295          display
      296             v-waitfram-action01 skip
      297             v-waitfram-action02 skip
      298             v-waitfram-action03 skip
      299          with frame waitfram .
      300       if     mWaitFramView
      301          then do:
      302             if     mWaitFramInterval ne ?
      303                and not mBatchMode
      304             then
      305                wait-for go of frame waitfram pause mWaitFramInterval.
      306          end.
      307          else
      308             if     mWaitProcEvent
      309                and not mBatchMode
      310             then
      311                process events .
      312     end.
      313   end procedure.
      314      procedure waitfram-show-this:
      315         define input  parameter iInterval as int64 no-undo.
      316         define variable vtime as int64 no-undo.
      317         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      318         mWaitFramInterval = iInterval.
      319         run waitfram-show (substitute("&1&2 &3&4" ,
      320                                       mWaitFramTextBeg ,
      321                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      322                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      323                                       mWaitFramTextEnd
      324                                      )
      325                           ).
      326      end.
      327      procedure WaitFramRunPause:
      328         define input  parameter iInterval as dec no-undo.
      329         define variable vStart  as datetime-tz no-undo.
      330         define variable vend    as datetime-tz no-undo.
      331         define variable vint as int64 no-undo.
      332         define variable vOk as logical no-undo.
      333         vStart = now.
      334         vend   = vStart.
      335         publish "WaitFramPause" (iInterval,output vOk).
      336         vend   =  now.
      337         vint = vend - vStart.
      338         vint = iInterval - vint / 1000.
      339         if     not mWaitFramStop
      340            and (   vint > 0
      341                 or (    not vOk
      342                     and iInterval eq ?
      343                     )
      344                 )
      345         then
      346            run waitfram-show-this (iInterval).
      347         vend   =  now.
      348         vint = vend - vStart.
      349         vint = iInterval - vint / 1000.
      350         if     not mWaitFramStop
      351            and vint > 0
      352         then do:
      353            run gbl/pause.p (vint * 1000).
      354         end.
      355         if iInterval ne ?
      356         then
      357            publish "WaitFramStop".
      358         waitfram-check-timeout().
      359      end.
      360      procedure WaitFramWaitFor:
      361         define input  parameter iInterval as dec no-undo.
      362         assign
      363            mWaitFramStartProc   = now
      364            mWaitFramStopUser    = no
      365            mWaitFramStopTimeOut = no
      366         .
      367         block-wait:
      368         do while not mWaitFramStop:
      369            run WaitFramRunPause (iInterval).
      370            if  waitfram-check-timeout()
      371            then do:
      372               leave block-wait.
      373            end.
      374         end.
      375         run waitfram-hide.
      376      end.
      377   procedure waitfram-join :
      378     define input  parameter p-line-1  as character no-undo .
      379     define input  parameter p-line-2  as character no-undo .
      380     define input  parameter p-line-3  as character no-undo .
      381     define output parameter p-message as character no-undo .
      382     do
      383     on error undo, return error return-value
      384     :
      385       assign
      386         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      387                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      388                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      389       .
      390     end.
      391   end procedure.
      392   function waitfram-join-function returns character
      393     (input p-line-1 as character
      394     ,input p-line-2 as character
      395     ,input p-line-3 as character
      396     ).
      397     define variable v-message as character no-undo .
      398     run waitfram-join in this-procedure
      399       (input  p-line-1
      400       ,input  p-line-2
      401       ,input  p-line-3
      402       ,output v-message
      403       ) .
      404     return v-message .
      405   end function .
      406   define stream slog .
      407   define variable v-row       as integer   no-undo .
      408   define variable v-col       as integer   no-undo .
      409   define variable v-ind       as integer   no-undo .
      410   define variable v-file-name as character no-undo .
      411   do
      412   on error undo, return error return-value
      413   :
      414     run paramls-clear in this-procedure
      415       .
      416     run waitfram-show in this-procedure
      417       (input "Создание отчета"
      418       ) .
      419     run paramls-write in this-procedure
      420       (input 'rowsgroup-enable':u
      421       ,input '':u
      422       ,input 'yes':u
      423       ) .
      424     do v-ind = 1 to 2
      425     :
      426       run waitfram-show in this-procedure
      427         (input substitute("Создание отчета. Страница &1", v-ind)
      428         ) .
      429       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
      430       output stream slog to value(v-file-name) .
      431       define variable v-max-row as integer   no-undo .
      432       define variable v-max-col as integer   no-undo .
      433       assign
      434         v-max-row = 100
      435         v-max-col = 100
      436       .
      437       do v-row = 1 to v-max-row
      438       :
      439         put stream slog unformatted substitute('formula(&3,"r&1c&2")'
      440           ,v-row
      441           ,1
      442           ,'"Строка ""' + string(v-row) + '"""'
      443           )
      444           + chr(10) .
      445       end.
      446       put stream slog unformatted substitute('formula(&3,"r&1c&2")'
      447         ,1
      448         ,1
      449         ,'"608E"'
      450         )
      451         + chr(10) .
      452       put stream slog unformatted substitute('formula(&3,"r&1c&2")'
      453         ,2
      454         ,1
      455         ,'"12.02"'
      456         )
      457         + chr(10) .
      458       do v-row = 1 to v-max-row
      459       :
      460         do v-col = 2 to v-max-col
      461         :
      462           put stream slog unformatted substitute('formula(&3,"r&1c&2")'
      463             ,v-row
      464             ,v-col
      465             ,string(v-row * v-col + v-ind / 10)
      466             )
      467             + chr(10) .
      468           define variable v-cell-type as integer   no-undo .
      469           assign
      470             v-cell-type = (v-col + v-row) modulo 3
      471           .
      472           if v-cell-type <> 0 then do:
      473             put stream slog unformatted substitute('select("r&1c&2")'
      474               ,v-row
      475               ,v-col
      476               ) + chr(10) .
      477             if v-cell-type = 1 then do:
      478               put stream slog unformatted 'format.font(,10,true)' + chr(10) .
      479             end.
      480             else do:
      481               put stream slog unformatted 'format.font(,12,,true)' + chr(10) .
      482               put stream slog unformatted 'patterns(1,,40,true)' + chr(10) .
      483             end.
      484           end.
      485         end.
      486       end.
      487       put stream slog unformatted 'select("r5c5")' + chr(10) .
      488       put stream slog unformatted 'format.number("@")' + chr(10) .
      489       put stream slog unformatted substitute('formula(&3,"r&1c&2")'
      490         ,5
      491         ,5
      492         ,'"12.02"'
      493         )
      494         + chr(10) .
      495       run paramls-write in this-procedure
      496         (input 'rowsgroup':u
      497         ,input string(v-ind) + ',':u + '000000001':u
      498         ,input '5:15':u
      499         ) .
      500       run paramls-write in this-procedure
      501         (input 'rowsgroup':u
      502         ,input string(v-ind) + ',':u + '000000002':u
      503         ,input '2:18':u
      504         ) .
      505       put stream slog unformatted 'select("r1c1")' + chr(10) .
      506       output stream slog close .
      507       run paramls-write in this-procedure
      508         (input "file"
      509         ,input string(v-ind)
      510         ,input v-file-name
      511         ) .
      512     end.
      513     define variable v-excel-file-name as character no-undo .
      514     define variable v-read-password   as character no-undo .
      515     define variable v-write-password  as character no-undo .
      516     assign
      517     .
      518     run paramls-write in this-procedure
      519       (input "saveas"
      520       ,input "excel-file-name"
      521       ,input v-excel-file-name
      522       ) .
      523     run paramls-write in this-procedure
      524       (input "charcol"
      525       ,input ""
      526       ,input "1,2"
      527       ) .
      528     run paramls-write in this-procedure
      529       (input "saveas"
      530       ,input "read-password"
      531       ,input v-read-password
      532       ) .
      533     run paramls-write in this-procedure
      534       (input "saveas"
      535       ,input "write-password"
      536       ,input v-write-password
      537       ) .
      538     run waitfram-hide in this-procedure .
      539     run gbl/macroexl.p
      540       (input-output table temp-param
      541       ) .
      542     define buffer buf_temp-param for temp-param .
      543     for each buf_temp-param
      544       where buf_temp-param.param-code = "file"
      545     on error undo, return error
      546     :
      547       os-delete value(buf_temp-param.param-value) .
      548     end.
      549   end.
