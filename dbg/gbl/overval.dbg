     1211       ) .
     1212   define buffer buf_gds-grp for ub.gds-grp  .
     1213   define variable gdsgrp_recids as character no-undo .
     1214   define variable ii as integer   no-undo .
     1215   define variable nn as integer   no-undo .
     1216   gdsgrp_recids = "".
     1217   nn = num-entries(pr-nogds0).
     1218   repeat ii = 1 to nn :
     1219      find first buf_gds-grp no-lock where
     1220                 buf_gds-grp.node-code = integer(entry( ii , pr-nogds0 )) no-error  .
     1221      if available buf_gds-grp then do:
     1222         gdsgrp_recids = trim(gdsgrp_recids) + string(recid(buf_gds-grp)) + "," .
     1223      end.
     1224   end.
     1225   run ref/gds-grp.w
     1226     ( input parparentproc
     1227      ,input "b-sel,b-mark"
     1228      ,input v-cntxt-obj-type
     1229      ,input v-cntxt-obj-code
     1230      ,input-output gdsgrp_recids
     1231      ) .
     1232   assign
     1233     scr-nogrp0 = ""
     1234     pr-nogds0  = ""
     1235     nn = num-entries(gdsgrp_recids)
     1236   .
     1237   repeat ii = 1 to nn :
     1238      find first buf_gds-grp no-lock where
     1239                 recid(buf_gds-grp) = integer( entry( ii , gdsgrp_recids ))  no-error  .
     1240      if available buf_gds-grp then do:
     1241         assign
     1242           scr-nogrp0 = scr-nogrp0 + substitute("&1.&2 &3" , buf_gds-grp.node-code , buf_gds-grp.node-name , chr(10) )
     1243           pr-nogds0  = trim(pr-nogds0)  + string(buf_gds-grp.node-code)  +  ","
     1244         .
     1245      end.
     1246   end.
     1247   assign
     1248     pr-nogds0   = trim(pr-nogds0, ",")
     1249     scr-nogrp0  = trim(scr-nogrp0)
     1250   .
     1251   DISPLAY pr-nogds0 scr-nogrp0 WITH FRAME FRAME-b .
     1252   END.
