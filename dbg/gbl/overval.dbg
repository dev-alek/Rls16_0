     1197     define variable v-cntxt-obj-type      as character no-undo .
     1198     define variable v-cntxt-obj-code      as integer   no-undo .
     1199     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1200     define variable v-cntxt-is-admin      as logical   no-undo .
     1201   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1202     run mainmenu_getcntxt in parparentproc
     1203       (output v-cntxt-db-num
     1204       ,output v-cntxt-userid
     1205       ,output v-cntxt-level
     1206       ,output v-cntxt-host-code-obj
