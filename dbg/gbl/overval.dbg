     1347   ON VALUE-CHANGED OF pr-notls IN FRAME FRAME-A
     1348   DO:
     1349     ASSIGN pr-notls.
     1350     IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1351      IF NOT pr-notls THEN DO:
     1352         assign
     1353           pr-parex  = pr-notls
     1354           pr-sclex  = pr-notls
     1355           pr-altex  = pr-notls
     1356         .
     1357         DISPLAY  pr-parex pr-sclex pr-altex WITH FRAME FRAME-A .
     1358         DISABLE pr-parex pr-sclex pr-altex WITH FRAME FRAME-A .
     1359      END.
     1360      ELSE DO:
     1361         ENABLE pr-parex pr-sclex pr-altex WITH FRAME FRAME-A .
     1362      END.
     1363    END.
     1364   END.
     1365   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1366   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1367   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1368   on help of frame Dialog-Frame
     1369   do:
     1370     run gbl/app_help.p
     1371       (input this-procedure :file-name
     1372       ,input ''
     1373       ,input ?
     1374       ) no-error.
     1375     if error-status :error then do:
     1376       message
     1377         "Ошибка при вызове помощи"
     1378         error-status :get-message(1)
     1379         view-as alert-box .
     1380     end.
     1381   end.
     1382   run minbtn-set in this-procedure .
     1383   on choose of b-help in frame Dialog-Frame
     1384   do:
     1385     apply "help":u to frame Dialog-Frame .
     1386   end.
     1387   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1388   procedure minbtn-set :
     1389       do
     1390           on error undo, return error return-value
     1391           :
     1392           define variable ii              as integer       no-undo .
     1393           define variable fh              as widget-handle no-undo .
     1394           define variable hh              as widget-handle no-undo .
     1395           define variable v-h             as handle        extent 4 no-undo .
     1396           define variable v-name-button   as character     no-undo .
     1397           define variable v-help-old-x    as decimal       no-undo .
     1398           define variable v-help-old-y    as decimal       no-undo .
     1399           define variable v-help-old-size as decimal       no-undo .
     1400           define variable v-frame-width   as decimal       no-undo .
     1401           define variable jj              as integer       no-undo .
     1402           do
     1403               on error undo, return error
     1404               :
     1405               assign
     1406                   v-frame-width = frame Dialog-Frame:width - 0.3
     1407                   fh            = frame Dialog-Frame:first-child
     1408                   hh            = fh:first-child
     1409                   ii            = 1
     1410                   .
     1411               do while valid-handle(hh):
     1412                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1413                   do:
     1414                       case lc(hh:name) :
     1415                           when "b-help" then
     1416                               do:
     1417                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1418                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1419                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1420                                   hh:TOOLTIP = "Помощь" .
     1421                                   v-help-old-x = hh:column .
     1422                                   v-help-old-y = hh:row    .
     1423                                   v-help-old-size = hh:width .
     1424                                   hh:width-chars = 2.5 .
     1425                               end.
     1426                           when "b-print" then
     1427                               do:
     1428                                   hh:load-image("cmp/b-print.bmp":u) .
     1429                                   hh:TOOLTIP = "Печать" .
     1430                                   v-h[ii] = hh:handle .
     1431                                   ii = ii + 1 .
     1432                                   hh:width-chars = 3 .
     1433                               end.
     1434                           when "b-history" or
     1435                           when "b-hist" then
     1436                               do:
     1437                                   hh:load-image("cmp/b-hist.bmp":u) .
     1438                                   hh:TOOLTIP = "История" .
     1439                                   v-h[ii] = hh:handle .
     1440                                   ii = ii + 1 .
     1441                                   hh:width-chars = 3 .
     1442                               end.
     1443                           when "b-sch" then
     1444                               do:
     1445                                   hh:load-image("cmp/b-sch.bmp":u) .
     1446                                   hh:TOOLTIP = "Установка Фильтра" .
     1447                                   v-h[ii] = hh:handle .
     1448                                   ii = ii + 1 .
     1449                                   hh:width-chars = 3 .
     1450                               end.
     1451                           when "b-hist-user" then
     1452                               do:
     1453                                   hh:load-image("cmp/b-hist.bmp":u) .
     1454                                   hh:TOOLTIP = "История пользователя" .
     1455                                   ii = ii + 1 .
     1456                               end.
     1457                       end case.
     1458                   end.
     1459                   hh = hh:next-sibling.
     1460               end.
     1461               b-help:column = v-frame-width - b-help:width-chars.
     1462               jj = 0.
     1463               repeat ii = 4 to 1 by -1 :
     1464                   if valid-handle (v-h[ii] ) then
     1465                   do:
     1466                       jj  = jj + 1 .
     1467                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1468                       v-h[ii]:row    = v-help-old-y .
     1469                   end.
     1470               end.
     1471           end.
     1472       end.
     1473   end procedure.
     1474   MAIN-BLOCK:
     1475   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1476      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1477   if p-obj-type <> "" then
     1478      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) + " " + p-mode  .
     1479   define variable loc#log as logical   no-undo .
     1480   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   do:
     1482     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1483       (input  g#db-num
     1484       ,input  g#userid
     1485       ,input  0
     1486       ,input  'actn_global-trn_lookup':U
     1487       ,input  'global':U
     1488       ,input  0
     1489       ,input  '':U
     1490       ,input  0
     1491       ,input  0
     1492       ,input  0
     1493       ,input  0
     1494       ,input  true
     1495       ,output loc#log
     1496       )  .
     1497   end.
     1498     if loc#log <> yes then do: return error. end.
     1499       run enable_UI in THIS-PROCEDURE.
     1500       run init-proc in THIS-PROCEDURE.
     1501       if p-mode = 'ПРОСМОТР':U then do:
     1502         disable B-corr-pr-list
     1503            with  frame frame-a.
     1504         disable
     1505            B-corr-pr-nogds0
     1506            B-corr-pr-nogds
     1507            with  frame frame-b.
     1508       end.
     1509     WAIT-FOR GO OF FRAME Dialog-Frame.
     1510   END.
     1511   run disable_UI.
     1512   PROCEDURE disable_UI :
     1513     HIDE FRAME Dialog-Frame.
     1514     HIDE FRAME FRAME-A.
     1515     HIDE FRAME FRAME-B.
     1516   END PROCEDURE.
     1517   PROCEDURE enable_UI :
     1518     ENABLE B-exit B-quit b-frame-a b-frame-b B-Help
     1519         WITH FRAME Dialog-Frame.
     1520     VIEW FRAME Dialog-Frame.
     1521     DISPLAY pr-notls pr-altex pr-sclex pr-parex pr-clt-q pr-dpl-q pr-rdc-q
     1522             pr-equ-dq pr-abs-d pr-dscnt pr-print pr-list pr-rndmt pr-rndbs
     1523             pr-incpc pr-discm pr-sigma v-pr-notls v-pr-altex v-pr-sclex v-pr-parex
     1524             v-pr-clt-q v-pr-dpl-q v-pr-rdc-q v-pr-equ-dq v-pr-abs-d v-pr-dscnt
     1525             v-pr-print v-pr-list FILL-IN-2 v-pr-rndmt v-pr-rndbs v-pr-incpc
     1526             v-pr-discm v-pr-sigma
     1527         WITH FRAME FRAME-A.
     1528     ENABLE I-pr-abs-d I-pr-altex I-pr-clt-q I-pr-dpl-q I-pr-dscnt I-pr-equ-dq
     1529            I-pr-notls I-pr-parex I-pr-print I-pr-rdc-q I-pr-discm I-pr-incpc
     1530            I-pr-rndbs I-pr-sigma I-pr-list I-pr-rndmt I-pr-sclex B-attr-pr-notls
     1531            pr-notls B-attr-pr-altex pr-altex B-attr-pr-sclex pr-sclex
     1532            B-attr-pr-parex pr-parex B-attr-pr-clt-q pr-clt-q B-attr-pr-dpl-q
     1533            pr-dpl-q B-attr-pr-rdc-q pr-rdc-q B-attr-pr-equ-dq pr-equ-dq
     1534            B-attr-pr-abs-d pr-abs-d B-attr-pr-dscnt pr-dscnt B-attr-pr-print
     1535            pr-print B-attr-pr-list B-corr-pr-list B-attr-pr-rndmt pr-rndmt
     1536            B-attr-pr-rndbs pr-rndbs B-attr-pr-incpc pr-incpc B-attr-pr-discm
     1537            pr-discm B-attr-pr-sigma pr-sigma v-pr-notls v-pr-altex v-pr-sclex
     1538            v-pr-parex v-pr-clt-q v-pr-dpl-q v-pr-rdc-q v-pr-equ-dq v-pr-abs-d
     1539            v-pr-dscnt v-pr-print v-pr-list FILL-IN-2 v-pr-rndmt v-pr-rndbs
     1540            v-pr-incpc v-pr-discm v-pr-sigma
     1541         WITH FRAME FRAME-A.
     1542     DISPLAY pr-goods0 pr-nogds0 scr-nogrp0 pr-goods pr-nogds scr-nogrp v-pr-goods0
     1543             v-pr-nogds0 v-pr-goods v-pr-nogds
     1544         WITH FRAME FRAME-B.
     1545     ENABLE I-pr-goods I-pr-nogds I-pr-goods0 I-pr-nogds0 B-attr-pr-goods0
     1546            pr-goods0 B-attr-pr-nogds0 pr-nogds0 B-corr-pr-nogds0 scr-nogrp0
     1547            B-attr-pr-goods pr-goods B-attr-pr-nogds pr-nogds B-corr-pr-nogds
     1548            scr-nogrp v-pr-goods0 v-pr-nogds0 v-pr-goods v-pr-nogds
     1549         WITH FRAME FRAME-B.
     1550   END PROCEDURE.
     1551   PROCEDURE fill-widgets :
     1552   define variable v-value-character as character no-undo .
     1553   define variable v-value-date      as date      no-undo .
     1554   define variable v-value-decimal   as decimal   no-undo .
     1555   define variable v-value-integer   as integer   no-undo .
     1556   define variable v-value-logical   as logical   no-undo .
     1557   define variable v-param-type      as character no-undo .
     1558   define variable v-param-value     as character no-undo .
     1559   for each thbjattr_thbj-attr:
     1560     delete thbjattr_thbj-attr.
     1561   end.
     1562   for each thbjattr_thbj-attr-tt:
     1563     delete thbjattr_thbj-attr-tt.
     1564   end.
     1565   for each temp-thbj-attr:
     1566     delete temp-thbj-attr.
     1567   end.
     1568   run adm/shattri.p (
     1569       input "get":U
     1570     , input p-obj-type
     1571     , input p-obj-code
     1572     , input 'overval':U
     1573     , input "":U
     1574     , output v-value-character
     1575     , output v-value-date
     1576     , output v-value-decimal
     1577     , output v-value-integer
     1578     , output v-value-logical
     1579     , output v-param-type
     1580     , input-output TABLE thbjattr_thbj-attr-tt
     1581     ) no-error .
     1582   if error-status:error then do:
     1583     message
     1584     "Не удалось получить начальные значения настроек" skip
     1585     error-status:get-message(1) return-value
     1586     view-as alert-box error .
     1587     undo, return error .
     1588   end.
     1589   if p-obj-code <> 0 and p-obj-type <> "" then do:
     1590     find first thbjattr_thbj-attr-tt where thbjattr_thbj-attr-tt.prop-code = 'pr-list':U.
     1591     if available thbjattr_thbj-attr-tt then do:
     1592       delete thbjattr_thbj-attr-tt.
     1593     end.
     1594     pr-list = "Параметр pr-list Глобальный".
     1595     display pr-list WITH FRAME FRAME-A.
     1596     disable B-corr-pr-list
     1597         with  frame frame-a.
     1598   end.
     1599   FOR EACH thbjattr_thbj-attr-tt where thbjattr_thbj-attr-tt.obj-type  = p-obj-type :
     1600   if thbjattr_thbj-attr-tt.prop-code = "pr-abs-d" then do:      pr-abs-d = thbjattr_thbj-attr-tt.property-value-logical.      pr-abs-d:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-abs-d with frame frame-a .   end.
     1601   if thbjattr_thbj-attr-tt.prop-code = "pr-altex" then do:      pr-altex = thbjattr_thbj-attr-tt.property-value-logical.      pr-altex:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-altex with frame frame-a .   end.
     1602   if thbjattr_thbj-attr-tt.prop-code = "pr-clt-q" then do:      pr-clt-q = thbjattr_thbj-attr-tt.property-value-logical.      pr-clt-q:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-clt-q with frame frame-a .   end.
     1603   if thbjattr_thbj-attr-tt.prop-code = "pr-discm" then do:      pr-discm = thbjattr_thbj-attr-tt.property-value-character.      pr-discm:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-discm with frame frame-a .   end.
     1604   if thbjattr_thbj-attr-tt.prop-code = "pr-dpl-q" then do:      pr-dpl-q = thbjattr_thbj-attr-tt.property-value-logical.      pr-dpl-q:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-dpl-q with frame frame-a .   end.
     1605   if thbjattr_thbj-attr-tt.prop-code = "pr-dscnt" then do:      pr-dscnt = thbjattr_thbj-attr-tt.property-value-logical.      pr-dscnt:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-dscnt with frame frame-a .   end.
     1606   if thbjattr_thbj-attr-tt.prop-code = "pr-equ-dq" then do:      pr-equ-dq = thbjattr_thbj-attr-tt.property-value-integer.      pr-equ-dq:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-equ-dq with frame frame-a .   end.
     1607   if thbjattr_thbj-attr-tt.prop-code = "pr-incpc" then do:      pr-incpc = thbjattr_thbj-attr-tt.property-value-decimal.      pr-incpc:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-incpc with frame frame-a .   end.
     1608   if thbjattr_thbj-attr-tt.prop-code = "pr-list" then do:      pr-list = thbjattr_thbj-attr-tt.property-value-character.      pr-list:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-list with frame frame-a .   end.
     1609   if thbjattr_thbj-attr-tt.prop-code = "pr-notls" then do:      pr-notls = thbjattr_thbj-attr-tt.property-value-logical.      pr-notls:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-notls with frame frame-a .   end.
     1610   if thbjattr_thbj-attr-tt.prop-code = "pr-parex" then do:      pr-parex = thbjattr_thbj-attr-tt.property-value-logical.      pr-parex:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-parex with frame frame-a .   end.
     1611   if thbjattr_thbj-attr-tt.prop-code = "pr-print" then do:      pr-print = thbjattr_thbj-attr-tt.property-value-logical.      pr-print:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-print with frame frame-a .   end.
     1612   if thbjattr_thbj-attr-tt.prop-code = "pr-rdc-q" then do:      pr-rdc-q = thbjattr_thbj-attr-tt.property-value-logical.      pr-rdc-q:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-rdc-q with frame frame-a .   end.
     1613   if thbjattr_thbj-attr-tt.prop-code = "pr-rndbs" then do:      pr-rndbs = thbjattr_thbj-attr-tt.property-value-decimal.      pr-rndbs:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-rndbs with frame frame-a .   end.
     1614   if thbjattr_thbj-attr-tt.prop-code = "pr-rndmt" then do:      pr-rndmt = thbjattr_thbj-attr-tt.property-value-character.      pr-rndmt:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-rndmt with frame frame-a .   end.
     1615   if thbjattr_thbj-attr-tt.prop-code = "pr-sclex" then do:      pr-sclex = thbjattr_thbj-attr-tt.property-value-logical.      pr-sclex:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-sclex with frame frame-a .   end.
     1616   if thbjattr_thbj-attr-tt.prop-code = "pr-sigma" then do:      pr-sigma = thbjattr_thbj-attr-tt.property-value-decimal.      pr-sigma:private-data IN FRAME frame-a = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-sigma with frame frame-a .   end.
     1617   if thbjattr_thbj-attr-tt.prop-code = "pr-goods" then do:      pr-goods = thbjattr_thbj-attr-tt.property-value-character.      pr-goods:private-data IN FRAME frame-b = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-goods with frame frame-b .   end.
     1618   if thbjattr_thbj-attr-tt.prop-code = "pr-nogds" then do:      pr-nogds = thbjattr_thbj-attr-tt.property-value-character.      pr-nogds:private-data IN FRAME frame-b = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-nogds with frame frame-b .   end.
     1619   if thbjattr_thbj-attr-tt.prop-code = "pr-goods0" then do:      pr-goods0 = thbjattr_thbj-attr-tt.property-value-character.      pr-goods0:private-data IN FRAME frame-b = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-goods0 with frame frame-b .   end.
     1620   if thbjattr_thbj-attr-tt.prop-code = "pr-nogds0" then do:      pr-nogds0 = thbjattr_thbj-attr-tt.property-value-character.      pr-nogds0:private-data IN FRAME frame-b = "recid2=" + string(recid(thbjattr_thbj-attr-tt)).      display pr-nogds0 with frame frame-b .   end.
     1621     create temp-thbj-attr.
     1622     buffer-copy thbjattr_thbj-attr-tt to temp-thbj-attr.
     1623   END.
     1624   define variable nn as integer   no-undo .
     1625   define variable ii as integer   no-undo .
     1626   define buffer buf_gds-grp for ub.gds-grp  .
     1627   scr-nogrp = "" .
     1628   nn = num-entries ( pr-nogds ) .
     1629   repeat ii = 1 to nn :
     1630      find first buf_gds-grp no-lock where
     1631                 buf_gds-grp.node-code = integer(entry( ii , pr-nogds ))  no-error  .
     1632      if available buf_gds-grp then do:
     1633         scr-nogrp = scr-nogrp + substitute( "&1.&2 &3" , buf_gds-grp.node-code , buf_gds-grp.node-name , chr(10) ) .
     1634      end.
     1635   end.
     1636   scr-nogrp  = trim(scr-nogrp) .
     1637   display scr-nogrp with frame frame-b .
     1638   scr-nogrp0 = "" .
     1639   nn = num-entries ( pr-nogds0 ) .
     1640   repeat ii = 1 to nn :
     1641      find first buf_gds-grp no-lock where
     1642                 buf_gds-grp.node-code = integer(entry( ii , pr-nogds0 ))  no-error  .
     1643      if available buf_gds-grp then do:
     1644         scr-nogrp0 = scr-nogrp0 + substitute( "&1.&2 &3" , buf_gds-grp.node-code , buf_gds-grp.node-name , chr(10) ) .
     1645      end.
     1646   end.
     1647   scr-nogrp0  = trim(scr-nogrp0) .
     1648   display scr-nogrp0 with frame frame-b .
     1649   define variable v-tooltip as character no-undo .
     1650   define variable v-label   as character no-undo .
     1651   define variable v-tooltip-code as character no-undo .
     1652   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-abs-d"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-abs-d:screen-value = entry(2,v-label,":") . v-pr-abs-d = entry(2,v-label,":") . I-pr-abs-d:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1653   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-altex"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-altex:screen-value = entry(2,v-label,":") . v-pr-altex = entry(2,v-label,":") . I-pr-altex:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1654   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-clt-q"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-clt-q:screen-value = entry(2,v-label,":") . v-pr-clt-q = entry(2,v-label,":") . I-pr-clt-q:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1655   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-discm"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-discm:screen-value = entry(2,v-label,":") . v-pr-discm = entry(2,v-label,":") . I-pr-discm:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1656   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-dpl-q"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-dpl-q:screen-value = entry(2,v-label,":") . v-pr-dpl-q = entry(2,v-label,":") . I-pr-dpl-q:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1657   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-dscnt"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-dscnt:screen-value = entry(2,v-label,":") . v-pr-dscnt = entry(2,v-label,":") . I-pr-dscnt:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1658   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-equ-dq"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-equ-dq:screen-value = entry(2,v-label,":") . v-pr-equ-dq = entry(2,v-label,":") . I-pr-equ-dq:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1659   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-incpc"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-incpc:screen-value = entry(2,v-label,":") . v-pr-incpc = entry(2,v-label,":") . I-pr-incpc:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1660   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-list"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-list:screen-value = entry(2,v-label,":") . v-pr-list = entry(2,v-label,":") . I-pr-list:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1661   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-notls"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-notls:screen-value = entry(2,v-label,":") . v-pr-notls = entry(2,v-label,":") . I-pr-notls:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1662   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-parex"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-parex:screen-value = entry(2,v-label,":") . v-pr-parex = entry(2,v-label,":") . I-pr-parex:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1663   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-print"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-print:screen-value = entry(2,v-label,":") . v-pr-print = entry(2,v-label,":") . I-pr-print:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1664   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-rdc-q"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-rdc-q:screen-value = entry(2,v-label,":") . v-pr-rdc-q = entry(2,v-label,":") . I-pr-rdc-q:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1665   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-rndbs"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-rndbs:screen-value = entry(2,v-label,":") . v-pr-rndbs = entry(2,v-label,":") . I-pr-rndbs:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1666   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-rndmt"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-rndmt:screen-value = entry(2,v-label,":") . v-pr-rndmt = entry(2,v-label,":") . I-pr-rndmt:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
