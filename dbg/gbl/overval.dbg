     1671   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-goods0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-goods0:screen-value = entry(2,v-label,":") . v-pr-goods0 = entry(2,v-label,":") . I-pr-goods0:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1672   run thbjattr_tooltip in this-procedure (    input   'overval':U   ,input  "pr-nogds0"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-label =  REPLACE ( v-label , "`" , "," ). v-pr-nogds0:screen-value = entry(2,v-label,":") . v-pr-nogds0 = entry(2,v-label,":") . I-pr-nogds0:private-data =  REPLACE ( v-tooltip-code , "`" , "," ).
     1673   END PROCEDURE.
     1674   PROCEDURE init-proc :
     1675   define variable v-i               as integer   no-undo .
     1676   define variable v-value-character as character no-undo .
     1677   define variable v-value-date      as date      no-undo .
     1678   define variable v-value-decimal   as decimal   no-undo .
     1679   define variable v-value-integer   as integer   no-undo .
     1680   define variable v-value-logical   as logical   no-undo .
     1681   define variable v-type            as character no-undo .
     1682   define variable v-value           as character no-undo .
     1683   define variable v-found           as decimal   no-undo .
     1684   HIDE FRAME frame-b.
     1685   VIEW FRAME frame-a.
     1686     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1687       find first buf_thbj-attr exclusive-lock where
     1688                 buf_thbj-attr.obj-type = p-obj-type
     1689           and   buf_thbj-attr.obj-code = p-obj-code
     1690           and   buf_thbj-attr.upper-prop-code = 'overval':U
     1691           and   buf_thbj-attr.prop-code = '':u no-wait no-error.
     1692        if locked buf_thbj-attr then do:
     1693           message
     1694           vss-workfile vss-revision vss-description skip
     1695           'overval':U skip
     1696           "Запись Глобальных ПАРАМЕТРОВ  занята"
     1697           view-as alert-box error .
     1698           undo, return error.
     1699         end.
     1700     end.
     1701     else do:
     1702       find first buf_thbj-attr no-lock where
     1703             buf_thbj-attr.obj-type = p-obj-type
     1704       and   buf_thbj-attr.obj-code = p-obj-code
     1705       and   buf_thbj-attr.upper-prop-code = 'overval':U
     1706       and   buf_thbj-attr.prop-code = '':u no-error.
     1707     end.
     1708     if not available buf_thbj-attr then do:
     1709       assign
     1710         v-to-create-trn  = true
     1711         .
     1712       message
     1713       substitute ("Внимание!!!&1 Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1714                   chr(10))
     1715                    view-as alert-box warning.
     1716     end.
     1717     run fill-widgets in this-procedure no-error.
     1718     if error-status:error then undo, return error.
     1719     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1720        disable
     1721       pr-abs-d
     1722       pr-altex
     1723       pr-clt-q
     1724       pr-discm
     1725       pr-dpl-q
     1726       pr-dscnt
     1727       pr-equ-dq
     1728       pr-incpc
     1729       pr-list
     1730       pr-notls
     1731       pr-parex
     1732       pr-print
     1733       pr-rdc-q
     1734       pr-rndbs
     1735       pr-rndmt
     1736       pr-sclex
     1737       pr-sigma
     1738     with frame frame-a.
     1739     disable
     1740       pr-goods
     1741       pr-nogds
     1742       pr-goods0
     1743       pr-nogds0
     1744     with frame frame-b.
     1745        B-exit:label in frame Dialog-Frame = "Вы&ход"  .
     1746        hide B-quit in frame Dialog-Frame .
     1747     END.
     1748     IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1749      IF NOT pr-notls THEN DO:
     1750         DISPLAY  pr-parex pr-sclex pr-altex WITH FRAME FRAME-a .
     1751         DISABLE pr-parex pr-sclex pr-altex WITH FRAME FRAME-a .
     1752      END.
     1753    END.
     1754   end procedure.
     1755   PROCEDURE save-proc :
     1756   define variable v-value-character as character no-undo .
     1757   define variable v-value-date      as date      no-undo .
     1758   define variable v-value-decimal   as decimal   no-undo .
     1759   define variable v-value-integer   as integer   no-undo .
     1760   define variable v-value-logical   as logical   no-undo .
     1761   define variable v-sale-add        as character no-undo .
     1762   define variable v-same            as logical   no-undo .
     1763   define variable v-param-type      as character no-undo .
     1764   define variable v-trf-type like ub.clients.obj-type no-undo .
     1765   define variable v-trf-code like ub.clients.obj-code no-undo .
     1766   define variable wh as widget-handle no-undo .
     1767   define variable fh as widget-handle no-undo .
     1768   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1769   define variable loc#log           as logical   no-undo .
     1770   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771   do:
     1772     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1773       (input  g#db-num
     1774       ,input  g#userid
     1775       ,input  0
     1776       ,input  'actn_global-trn_update':U
     1777       ,input  'global':U
     1778       ,input  0
     1779       ,input  '':U
     1780       ,input  0
     1781       ,input  0
     1782       ,input  0
     1783       ,input  0
     1784       ,input  true
     1785       ,output loc#log
     1786       )  .
     1787   end.
     1788     if loc#log <> yes then do: return error. end.
     1789   ASSIGN
     1790       pr-abs-d FRAME FRAME-a
     1791       pr-altex
     1792       pr-clt-q
     1793       pr-discm
     1794       pr-dpl-q
     1795       pr-dscnt
     1796       pr-equ-dq
     1797       pr-incpc
     1798       pr-list
     1799       pr-notls
     1800       pr-parex
     1801       pr-print
     1802       pr-rdc-q
     1803       pr-rndbs
     1804       pr-rndmt
     1805       pr-sclex
     1806       pr-sigma
     1807       .
     1808   ASSIGN
     1809       pr-goods FRAME FRAME-b
     1810       pr-nogds
     1811       pr-goods0
     1812       pr-nogds0
     1813       .
     1814   assign
     1815     fh = frame frame-a:first-child
     1816     wh = fh:first-child
     1817     .
     1818   do while valid-handle(wh):
     1819     if wh:private-data begins "recid2=" then do:
     1820       find first thbjattr_thbj-attr-tt where
     1821                 recid(thbjattr_thbj-attr-tt) = integer(entry(2, wh:private-data, '=')) exclusive-lock.
     1822       assign
     1823         buffer thbjattr_thbj-attr-tt:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     1824         thbjattr_thbj-attr-tt.obj-type = p-obj-type
     1825         thbjattr_thbj-attr-tt.obj-code = p-obj-code
     1826       .
     1827     end.
     1828     wh = wh:next-sibling.
     1829   end.
     1830   assign
     1831     fh = frame frame-b:first-child
     1832     wh = fh:first-child
     1833     .
     1834   do while valid-handle(wh):
     1835     if wh:private-data begins "recid2=" then do:
     1836       find first thbjattr_thbj-attr-tt where
     1837                 recid(thbjattr_thbj-attr-tt) = integer(entry(2, wh:private-data, '=')).
     1838       assign
     1839         buffer thbjattr_thbj-attr-tt:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value
     1840         thbjattr_thbj-attr-tt.obj-type = p-obj-type
     1841         thbjattr_thbj-attr-tt.obj-code = p-obj-code
     1842       .
     1843     end.
     1844     wh = wh:next-sibling.
     1845   end.
     1846   v-same = yes.
     1847   for each thbjattr_thbj-attr-tt,
     1848       first temp-thbj-attr where
     1849             temp-thbj-attr.obj-type         = thbjattr_thbj-attr-tt.obj-type
     1850         and temp-thbj-attr.obj-code         = thbjattr_thbj-attr-tt.obj-code
     1851         and temp-thbj-attr.upper-prop-code  = thbjattr_thbj-attr-tt.upper-prop-code
     1852         and temp-thbj-attr.prop-code        = thbjattr_thbj-attr-tt.prop-code
     1853         :
     1854      buffer-compare
     1855      thbjattr_thbj-attr-tt
     1856      to temp-thbj-attr
     1857      save result in v-same.
     1858      if not v-same then leave.
     1859   end.
     1860   v-same = no.
     1861   IF v-same  and not v-to-create THEN RETURN.
     1862   do TRANSACTION
     1863   on error undo, return error return-value
     1864   :
     1865     run thbjattr_set-section in this-procedure (
     1866           input p-obj-type
     1867         , input p-obj-code
     1868         , input 'overval':U
     1869         , input table thbjattr_thbj-attr-tt
     1870     ) no-error.
     1871     if error-status:error then do:
     1872       message error-status:get-message(1)  skip
     1873       return-value
     1874       view-as alert-box.
     1875       undo, return error.
     1876     end.
     1877   end.
     1878   END PROCEDURE.
