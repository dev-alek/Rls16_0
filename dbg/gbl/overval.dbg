     1125   ON CHOOSE OF B-corr-pr-nogds IN FRAME FRAME-B
     1126   DO:
     1127   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128     define variable v-cntxt-db-num        as integer   no-undo .
     1129     define variable v-cntxt-userid        as character no-undo .
     1130     define variable v-cntxt-level         as character no-undo .
     1131     define variable v-cntxt-host-code-obj as integer   no-undo .
     1132     define variable v-cntxt-obj-type      as character no-undo .
     1133     define variable v-cntxt-obj-code      as integer   no-undo .
     1134     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1135     define variable v-cntxt-is-admin      as logical   no-undo .
     1136   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137     run mainmenu_getcntxt in parparentproc
     1138       (output v-cntxt-db-num
     1139       ,output v-cntxt-userid
     1140       ,output v-cntxt-level
     1141       ,output v-cntxt-host-code-obj
     1142       ,output v-cntxt-obj-type
     1143       ,output v-cntxt-obj-code
     1144       ,output v-cntxt-db-num-obj
     1145       ,output v-cntxt-is-admin
     1146       ) .
     1147   define buffer buf_gds-grp for ub.gds-grp  .
     1148   define variable gdsgrp_recids as character no-undo .
     1149   define variable ii as integer   no-undo .
     1150   define variable nn as integer   no-undo .
     1151   assign
     1152     gdsgrp_recids = ""
     1153     nn = num-entries(pr-nogds)
     1154   .
     1155   repeat ii = 1 to nn :
     1156      find first buf_gds-grp no-lock where
     1157                 buf_gds-grp.node-code = integer(entry( ii , pr-nogds )) no-error  .
     1158      if available buf_gds-grp then do:
     1159         gdsgrp_recids = trim(gdsgrp_recids) + string(recid(buf_gds-grp)) + "," .
     1160      end.
     1161   end.
     1162   run ref/gds-grp.w
     1163     ( input parparentproc
     1164      ,input "b-sel,b-mark"
     1165      ,input v-cntxt-obj-type
     1166      ,input v-cntxt-obj-code
     1167      ,input-output gdsgrp_recids
     1168      ) .
     1169   assign
     1170     scr-nogrp = ""
     1171     pr-nogds  = ""
     1172     nn = num-entries(gdsgrp_recids)
     1173   .
     1174   repeat ii = 1 to nn :
     1175      find first buf_gds-grp no-lock where
     1176                 recid(buf_gds-grp) = integer( entry( ii , gdsgrp_recids ))  no-error  .
     1177      if available buf_gds-grp then do:
     1178         assign
     1179           scr-nogrp = scr-nogrp + substitute("&1.&2 &3" , buf_gds-grp.node-code , buf_gds-grp.node-name , chr(10) )
     1180           pr-nogds  = trim(pr-nogds)  + string(buf_gds-grp.node-code)  +  ","
     1181         .
     1182      end.
     1183   end.
     1184   assign
     1185     pr-nogds  = trim(pr-nogds, ",")
     1186     scr-nogrp = trim(scr-nogrp)
     1187   .
     1188   DISPLAY pr-nogds scr-nogrp WITH FRAME FRAME-B .
     1189   END.
     1190   ON CHOOSE OF B-corr-pr-nogds0 IN FRAME FRAME-B
     1191   DO:
     1192   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193     define variable v-cntxt-db-num        as integer   no-undo .
     1194     define variable v-cntxt-userid        as character no-undo .
     1195     define variable v-cntxt-level         as character no-undo .
