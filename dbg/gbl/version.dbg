        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   procedure get-ro_get-read-only :
        4     define output parameter p-ro-set as logical   no-undo .
        5     do
        6     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info0, return-value, error-status :get-message( 1 ) )
        7     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info0 )
        8     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info0 )
        9     :
       10       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
       11       then do:
       12         assign
       13           p-ro-set = true
       14         .
       15       end.
       16       else do:
       17         assign
       18           p-ro-set = false
       19         .
       20       end.
       21     end.
       22   end procedure.
       23   define buffer buf_sys-ctrl for ub.sys-ctrl .
       24   define buffer buf_db for ub.db .
       25       define variable v-version-developer-list    as character    no-undo.
       26       define variable v-version           as character no-undo .
       27       define variable v-locale            as character no-undo .
       28       define variable v-SVNRev            as integer   no-undo .
       29       define variable v-compilerVersion   as character no-undo .
       30       define variable v-compile-date      as date      no-undo .
       31       define variable v-time              as integer   no-undo .
       32       define variable v-comment           as character no-undo .
       33       define variable v-file-date         as date      no-undo .
       34       define variable v-file-time         as integer   no-undo .
       35       define variable v-releace           as integer   no-undo.
       36       define variable v-patch             as integer   no-undo.
       37       define variable v-branch            as integer   no-undo.
       38       define variable v-program-tag       as character    no-undo .
       39       define variable v-read-only         as logical      no-undo .
       40   do
       41   on error undo, return error return-value
       42   :
       43       run gbl/vertag.p (
       44             output v-version
       45           , output v-locale
       46           , output v-SVNRev
       47           , output v-compilerVersion
       48           , output v-compile-date
       49           , output v-time
       50           , output v-comment
       51           , output v-file-date
       52           , output v-file-time
       53           , output v-releace
       54           , output v-patch
       55           , output v-branch
       56       ) .
       57       case v-locale
       58       :
       59           when "rus":U
       60           then do:
       61               assign
       62                   v-locale = "Россия"
       63               .
       64           end.
       65           when "kaz":U
       66           then do:
       67               assign
       68                   v-locale = "Казахстан"
       69               .
       70           end.
       71           otherwise do:
       72           end.
       73       end case.
       74       assign
       75           v-version = substitute( "&1 (&2)"
       76                                   , v-version
       77                                   , v-locale
       78                                 )
       79       .
       80     run gbl/verinfo.p.
       81     run get-ro_get-read-only
       82       (output v-read-only
       83       ) .
       84     find first buf_sys-ctrl no-lock .
       85     find buf_db no-lock
       86       where buf_db.db-num = buf_sys-ctrl.db-num
       87       .
       88     message
       89            "Автоматизированная система управления"
       90       skip "торговым предприятием"
       91       skip "IBS Trade House"
       92       skip(1)
       93            "Версия:"  v-version
       94       skip "Дата компиляции:"  v-compile-date
       95       skip "Тэг:"  v-SVNRev
       96       skip "О версии:"  v-comment
       97       skip (1)
       98            "Версия Progress:" proversion
       99       skip "Комплектация Progress:" progress
      100       skip "Версия СУБД Progress:" dbversion("ub")
      101       skip(1)
      102            "БД:"  buf_db.db-name
      103       skip "Номер БД:"  buf_db.db-num
      104       skip "" (if v-read-only then "Режим только чтение" else '':U)
      105       view-as alert-box information .
      106   end.
      107   procedure add-developer :
      108   define input parameter p-name       as character        no-undo.
      109       define variable v-last-string   as character    no-undo.
      110       define variable v-new-line      as logical      no-undo.
      111   do
      112   on error undo, return error
      113   :
      114       assign
      115           v-new-line = no
      116       .
      117       if v-version-developer-list <> "":U
      118       then do:
      119           assign
      120               v-last-string = entry( num-entries( v-version-developer-list, chr(10) ), v-version-developer-list, chr(10) )
      121           .
      122           if length( v-last-string ) > 40
      123           then do:
      124               assign
      125                   v-version-developer-list = v-version-developer-list + ",        " + chr(10)
      126                   v-new-line               = yes
      127               .
      128           end.
      129       end.
      130       assign
      131           v-version-developer-list = substitute( "&1&2&3":U
      132                                       , v-version-developer-list
      133                                       , ( if v-version-developer-list = "":U
      134                                           or v-new-line = yes
      135                                           then "":U
      136                                           else ", ":U )
      137                                       , p-name
      138                                        )
      139       .
      140   end.
      141   end procedure.
