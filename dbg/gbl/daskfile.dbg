        1   DEFINE INPUT PARAMETER p-title         AS CHARACTER NO-UNDO.
        2   DEFINE INPUT PARAMETER p-old-file-path AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER p-old-file-size AS integer NO-UNDO.
        4   DEFINE INPUT PARAMETER p-old-file-date AS date NO-UNDO.
        5   DEFINE INPUT PARAMETER p-old-file-time AS integer NO-UNDO.
        6   DEFINE INPUT PARAMETER p-new-file-path AS CHARACTER NO-UNDO.
        7   DEFINE INPUT PARAMETER p-new-file-size AS integer NO-UNDO.
        8   DEFINE INPUT PARAMETER p-new-file-date AS date NO-UNDO.
        9   DEFINE INPUT PARAMETER p-new-file-time AS integer NO-UNDO.
       10   DEFINE INPUT PARAMETER p-default-button AS INTEGER NO-UNDO.
       11   DEFINE INPUT PARAMETER p-cancel-button AS INTEGER NO-UNDO.
       12   DEFINE output PARAMETER p-choice AS integer NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Диалог действий при переносе файлов".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define variable v-waitfram-action01         as character   no-undo .
       75   define variable v-waitfram-action02         as character   no-undo .
       76   define variable v-waitfram-action03         as character   no-undo .
       77   define variable mWaitFramTextBeg            as character   no-undo.
       78   define variable mWaitFramTextEnd            as character   no-undo.
       79   define variable mWaitFramView               as logical     no-undo.
       80   define variable mWaitProcEvent              as logical     no-undo init yes.
       81   define variable mWaitFramInterval           as integer     no-undo init 1 .
       82   define variable mWaitFramStop               as logical     no-undo.
       83   define variable mWaitFramStopUser           as logical     no-undo.
       84   define variable mWaitFramStopTimeOut        as logical     no-undo.
       85   define variable mWaitFramStartProc          as datetime-tz no-undo.
       86   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       87   define button B-WaitFramStop auto-end-key
       88        label "Стоп"
       89        size 10 by 1 tooltip "Остоновить процесс".
       90   define button B-viewProcInfo
       91        label "Информация"
       92        size 15 by 1 tooltip "Информация о процесс".
       93   define frame waitfram
       94     v-waitfram-action01 format "x(72)" no-label skip
       95     v-waitfram-action02 format "x(72)" no-label skip
       96     v-waitfram-action03 format "x(72)" no-label skip
       97     B-viewProcInfo
       98     B-WaitFramStop at row 4 col 30
       99     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      100     .
      101   define new global shared variable mBatchMode as logical no-undo init ?.
      102   define variable mFramBachModHandle as handle no-undo.
      103   mFramBachModHandle = frame waitfram:handle.
      104   define variable mFameOldVis as logical no-undo.
      105   define variable mVisCUrentVin as logical no-undo.
      106   if session:batch-mode
      107   then
      108      mBatchMode = yes.
      109   if mBatchMode = ? then do:
      110     mVisCUrentVin = current-window:visible.
      111     mFameOldVis = mFramBachModHandle:visible.
      112     mFramBachModHandle:visible  = yes.
      113     mBatchMode = mFramBachModHandle:visible ne yes.
      114     mFramBachModHandle:visible = mFameOldVis.
      115     current-window:visible = mVisCUrentVin.
      116   end.
      117    if  log-manager:logfile-name ne ?
      118     then DO:
      119         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      120         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      121         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      122     end.
      123   on choose of B-WaitFramStop in frame waitfram
      124   do:
      125     mWaitFramStop = yes.
      126     mWaitFramStopUser = yes.
      127   end.
      128   function waitfram-check-timeout returns logical():
      129      define variable vtime as int64 no-undo.
      130      if mWaitFramStopTimeOut
      131      then
      132         return yes.
      133      vtime = ( now - mWaitFramStartProc ) / 1000 .
      134      if     mWaitFramTimeOut ne ?
      135         and mWaitFramTimeOut ne 0
      136         and mWaitFramTimeOut lt vtime
      137      then do:
      138         mWaitFramStopTimeOut = yes.
      139      end.
      140      return mWaitFramStopTimeOut.
      141   end.
      142   procedure waitfram-hide :
      143     if not session:batch-mode
      144     then do
      145     on error undo, return error return-value
      146     :
      147       pause 0 before-hide .
      148       if not mBatchMode then
      149         hide frame waitfram .
      150     if     not mWaitFramView
      151        and mWaitProcEvent
      152     then
      153       process events .
      154     end.
      155   end procedure.
      156   procedure waitfram-show :
      157     define input  parameter p-message as character no-undo .
      158     define variable v-left-margin as integer   no-undo .
      159     if not session:batch-mode
      160     then do
      161     on error undo, return error return-value
      162     :
      163       if length(p-message) <= 70 then do:
      164         assign
      165           v-left-margin = integer((70 - length(p-message)) / 2)
      166         .
      167         assign
      168           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      169         .
      170         assign
      171           v-waitfram-action01 = " "
      172           v-waitfram-action02 = " "
      173                                    + fill(" ", v-left-margin)
      174                                    + p-message
      175           v-waitfram-action03 = " "
      176         .
      177       end.
      178       else do:
      179         define variable vRindex1 as integer no-undo.
      180         define variable vRindex2 as integer no-undo.
      181         vRindex1 = r-index(p-message," ",70).
      182         if vRindex1 = 0
      183         then
      184            vRindex1 = 70.
      185         if length(p-message)  <= vRindex1 + 70 then do:
      186           assign
      187             v-waitfram-action01 = " "
      188             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      190           .
      191         end.
      192         else do:
      193           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      194           if vRindex2 <= vRindex1
      195           then
      196              vRindex2 = vRindex1 + 70.
      197           assign
      198             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      200             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      201           .
      202         end.
      203       end.
      204       B-viewProcInfo:visible   in frame waitfram = no.
      205       B-viewProcInfo:sensitive in frame waitfram = no.
      206       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       if  (   mWaitFramView
      209          or  mWaitProcEvent)
      210          and not mBatchMode
      211       then
      212          display
      213             v-waitfram-action01 skip
      214             v-waitfram-action02 skip
      215             v-waitfram-action03 skip
      216          with frame waitfram .
      217       if     mWaitFramView
      218          then do:
      219             if     mWaitFramInterval ne ?
      220                and not mBatchMode
      221             then
      222                wait-for go of frame waitfram pause mWaitFramInterval.
      223          end.
      224          else
      225             if     mWaitProcEvent
      226                and not mBatchMode
      227             then
      228                process events .
      229     end.
      230   end procedure.
      231      procedure waitfram-show-this:
      232         define input  parameter iInterval as int64 no-undo.
      233         define variable vtime as int64 no-undo.
      234         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      235         mWaitFramInterval = iInterval.
      236         run waitfram-show (substitute("&1&2 &3&4" ,
      237                                       mWaitFramTextBeg ,
      238                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      239                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      240                                       mWaitFramTextEnd
      241                                      )
      242                           ).
      243      end.
      244      procedure WaitFramRunPause:
      245         define input  parameter iInterval as dec no-undo.
      246         define variable vStart  as datetime-tz no-undo.
      247         define variable vend    as datetime-tz no-undo.
      248         define variable vint as int64 no-undo.
      249         define variable vOk as logical no-undo.
      250         vStart = now.
      251         vend   = vStart.
      252         publish "WaitFramPause" (iInterval,output vOk).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and (   vint > 0
      258                 or (    not vOk
      259                     and iInterval eq ?
      260                     )
      261                 )
      262         then
      263            run waitfram-show-this (iInterval).
      264         vend   =  now.
      265         vint = vend - vStart.
      266         vint = iInterval - vint / 1000.
      267         if     not mWaitFramStop
      268            and vint > 0
      269         then do:
      270            run gbl/pause.p (vint * 1000).
      271         end.
      272         if iInterval ne ?
      273         then
      274            publish "WaitFramStop".
      275         waitfram-check-timeout().
      276      end.
      277      procedure WaitFramWaitFor:
      278         define input  parameter iInterval as dec no-undo.
      279         assign
      280            mWaitFramStartProc   = now
      281            mWaitFramStopUser    = no
      282            mWaitFramStopTimeOut = no
      283         .
      284         block-wait:
      285         do while not mWaitFramStop:
      286            run WaitFramRunPause (iInterval).
      287            if  waitfram-check-timeout()
      288            then do:
      289               leave block-wait.
      290            end.
      291         end.
      292         run waitfram-hide.
      293      end.
      294   procedure waitfram-join :
      295     define input  parameter p-line-1  as character no-undo .
      296     define input  parameter p-line-2  as character no-undo .
      297     define input  parameter p-line-3  as character no-undo .
      298     define output parameter p-message as character no-undo .
      299     do
      300     on error undo, return error return-value
      301     :
      302       assign
      303         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      306       .
      307     end.
      308   end procedure.
      309   function waitfram-join-function returns character
      310     (input p-line-1 as character
      311     ,input p-line-2 as character
      312     ,input p-line-3 as character
      313     ).
      314     define variable v-message as character no-undo .
      315     run waitfram-join in this-procedure
      316       (input  p-line-1
      317       ,input  p-line-2
      318       ,input  p-line-3
      319       ,output v-message
      320       ) .
      321     return v-message .
      322   end function .
      323   define new global shared variable g#language as character no-undo .
      324   if g#language <> '' and g#language <> 'rus':U then do:
      325     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      326   end.
      327   define new global shared variable g#library  as handle no-undo .
      328   define new global shared variable g#library2 as handle no-undo .
      329   procedure proc-alt-shift-f2:
      330     if not ibs.th.gbl.gbl-var:rcode
      331   then
      332     run gbl\inidebug.p .
      333   end.
      334   procedure proc-alt-shift-f3:
      335     run gbl/prvssinf.p
      336       ( input this-procedure
      337       ) .
      338   end.
      339   define variable v-inform-launched as logical no-undo initial false .
      340   procedure proc-alt-shift-f4:
      341     define variable v-action as character no-undo .
      342     if v-inform-launched = false then do:
      343       assign
      344         v-inform-launched = true
      345       .
      346       run gbl/d-inform.w
      347         (  input self
      348         ,  input this-procedure
      349         , output v-action
      350         ) no-error .
      351       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      352       assign
      353         v-inform-launched = false
      354       .
      355     end.
      356   end.
      357   procedure proc-alt-f1:
      358     run gbl/corrhelp.p
      359       (input this-procedure
      360       ) .
      361   end .
      362   on alt-shift-f2 anywhere do:
      363     run proc-alt-shift-f2.
      364   end.
      365   on alt-shift-f3 anywhere do:
      366     run proc-alt-shift-f3 in this-procedure .
      367   end.
      368   on alt-shift-f4 anywhere do:
      369     run proc-alt-shift-f4 in this-procedure.
      370   end.
      371   on alt-f1 anywhere do:
      372     run proc-alt-f1 in this-procedure .
      373   end.
      374   DEFINE BUTTON B-Help
      375        LABEL "Помо&щь"
      376        SIZE 10 BY 1
      377        BGCOLOR 8 .
      378   DEFINE BUTTON B-overwrite AUTO-GO
      379        LABEL "&Перезаписать"
      380        SIZE 20 BY 1
      381        BGCOLOR 8 .
      382   DEFINE BUTTON B-overwrite-all AUTO-GO
      383        LABEL "Перезаписать &все"
      384        SIZE 20 BY 1
      385        BGCOLOR 8 .
      386   DEFINE BUTTON B-overwrite-all-older AUTO-GO
      387        LABEL "Перезаписать старые"
      388        SIZE 20 BY 1
      389        BGCOLOR 8 .
      390   DEFINE BUTTON b-quit AUTO-END-KEY
      391        LABEL "&Отмена"
      392        SIZE 20 BY 1
      393        BGCOLOR 8 .
      394   DEFINE BUTTON B-skip AUTO-GO
      395        LABEL "Ос&тавить"
      396        SIZE 20 BY 1
      397        BGCOLOR 8 .
      398   DEFINE BUTTON B-skip-all AUTO-GO
      399        LABEL "Ост&авить все"
      400        SIZE 20 BY 1
      401        BGCOLOR 8 .
      402   DEFINE VARIABLE f-new-file AS CHARACTER FORMAT "X(256)":U
      403        LABEL "Файлом"
      404         VIEW-AS TEXT
      405        SIZE 55.5 BY .67 NO-UNDO.
      406   DEFINE VARIABLE f-new-file-date AS DATE FORMAT "99/99/9999":U
      407         VIEW-AS TEXT
      408        SIZE 11 BY .67
      409        FGCOLOR 4  NO-UNDO.
      410   DEFINE VARIABLE f-new-file-size AS INTEGER FORMAT ">>>,>>>,>>9Б":U INITIAL 0
      411         VIEW-AS TEXT
      412        SIZE 12 BY 1
      413        FGCOLOR 4  NO-UNDO.
      414   DEFINE VARIABLE f-new-file-time AS CHARACTER FORMAT "X(8)":U
      415         VIEW-AS TEXT
      416        SIZE 11 BY .67
      417        FGCOLOR 4  NO-UNDO.
      418   DEFINE VARIABLE f-old-file AS CHARACTER FORMAT "X(256)":U
      419        LABEL "Перезаписать"
      420         VIEW-AS TEXT
      421        SIZE 55.5 BY .67 NO-UNDO.
      422   DEFINE VARIABLE f-old-file-date AS DATE FORMAT "99/99/9999":U
      423         VIEW-AS TEXT
      424        SIZE 11 BY .67
      425        FGCOLOR 4  NO-UNDO.
      426   DEFINE VARIABLE f-old-file-size AS INTEGER FORMAT ">>>,>>>,>>9Б":U INITIAL 0
      427         VIEW-AS TEXT
      428        SIZE 12 BY 1
      429        FGCOLOR 4  NO-UNDO.
      430   DEFINE VARIABLE f-old-file-time AS CHARACTER FORMAT "X(8)":U
      431         VIEW-AS TEXT
      432        SIZE 11 BY .67
      433        FGCOLOR 4  NO-UNDO.
      434   DEFINE FRAME Dialog-Frame
      435        B-Help AT ROW 1 COL 54.9
      436        B-overwrite AT ROW 6.87 COL 1.5
      437        B-overwrite-all AT ROW 6.87 COL 21.5
      438        B-skip AT ROW 6.87 COL 41.5
      439        b-quit AT ROW 7.93 COL 1.5
      440        B-overwrite-all-older AT ROW 7.93 COL 21.5
      441        B-skip-all AT ROW 7.93 COL 41.5
      442        f-old-file AT ROW 2 COL 1
      443        f-old-file-size AT ROW 3 COL 12 COLON-ALIGNED NO-LABEL
      444        f-old-file-date AT ROW 3 COL 32 NO-LABEL
      445        f-old-file-time AT ROW 3 COL 52 NO-LABEL
      446        f-new-file AT ROW 4.2 COL 7
      447        f-new-file-size AT ROW 5 COL 12 COLON-ALIGNED NO-LABEL
      448        f-new-file-date AT ROW 5 COL 32 NO-LABEL
      449        f-new-file-time AT ROW 5 COL 52 NO-LABEL
      450        SPACE(7.59) SKIP(4.69)
      451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      453            TITLE ""
      454            DEFAULT-BUTTON B-overwrite CANCEL-BUTTON b-quit.
      455   ASSIGN
      456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      457          FRAME Dialog-Frame:HIDDEN           = TRUE.
      458   ASSIGN
      459          B-overwrite:PRIVATE-DATA IN FRAME Dialog-Frame     =
      460                   "1".
      461   ASSIGN
      462          B-overwrite-all:PRIVATE-DATA IN FRAME Dialog-Frame     =
      463                   "2".
      464   ASSIGN
      465          B-overwrite-all-older:PRIVATE-DATA IN FRAME Dialog-Frame     =
      466                   "5".
      467   ASSIGN
      468          b-quit:PRIVATE-DATA IN FRAME Dialog-Frame     =
      469                   "6".
      470   ASSIGN
      471          B-skip:PRIVATE-DATA IN FRAME Dialog-Frame     =
      472                   "3".
      473   ASSIGN
      474          B-skip-all:PRIVATE-DATA IN FRAME Dialog-Frame     =
      475                   "4".
      476   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      477   DO:
      478     APPLY "END-ERROR":U TO SELF.
      479   END.
      480   ON CHOOSE OF B-overwrite IN FRAME Dialog-Frame
      481   OR CHOOSE OF b-overwrite-all
      482   OR CHOOSE OF b-overwrite-all-older
      483   OR CHOOSE OF b-skip
      484   OR CHOOSE OF b-skip-all
      485   OR CHOOSE OF b-quit
      486   DO:
      487     ASSIGN
      488     p-choice = INTEGER(SELF:PRIVATE-DATA).
      489   END.
      490   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      491   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      492   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   on help of frame Dialog-Frame
      494   do:
      495     run gbl/app_help.p
      496       (input this-procedure :file-name
      497       ,input ''
      498       ,input ?
      499       ) no-error.
      500     if error-status :error then do:
      501       message
      502         "Ошибка при вызове помощи"
      503         error-status :get-message(1)
      504         view-as alert-box .
      505     end.
      506   end.
      507   run minbtn-set in this-procedure .
      508   on choose of b-help in frame Dialog-Frame
      509   do:
      510     apply "help":u to frame Dialog-Frame .
      511   end.
      512   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   procedure minbtn-set :
      514       do
      515           on error undo, return error return-value
      516           :
      517           define variable ii              as integer       no-undo .
      518           define variable fh              as widget-handle no-undo .
      519           define variable hh              as widget-handle no-undo .
      520           define variable v-h             as handle        extent 4 no-undo .
      521           define variable v-name-button   as character     no-undo .
      522           define variable v-help-old-x    as decimal       no-undo .
      523           define variable v-help-old-y    as decimal       no-undo .
      524           define variable v-help-old-size as decimal       no-undo .
      525           define variable v-frame-width   as decimal       no-undo .
      526           define variable jj              as integer       no-undo .
      527           do
      528               on error undo, return error
      529               :
      530               assign
      531                   v-frame-width = frame Dialog-Frame:width - 0.3
      532                   fh            = frame Dialog-Frame:first-child
      533                   hh            = fh:first-child
      534                   ii            = 1
      535                   .
      536               do while valid-handle(hh):
      537                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      538                   do:
      539                       case lc(hh:name) :
      540                           when "b-help" then
      541                               do:
      542                                   hh:load-image-up("cmp/b-help.bmp":u) .
      543                                   hh:load-image-down("cmp/b-help.bmp":u) .
      544                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      545                                   hh:TOOLTIP = "Помощь" .
      546                                   v-help-old-x = hh:column .
      547                                   v-help-old-y = hh:row    .
      548                                   v-help-old-size = hh:width .
      549                                   hh:width-chars = 2.5 .
      550                               end.
      551                           when "b-print" then
      552                               do:
      553                                   hh:load-image("cmp/b-print.bmp":u) .
      554                                   hh:TOOLTIP = "Печать" .
      555                                   v-h[ii] = hh:handle .
      556                                   ii = ii + 1 .
      557                                   hh:width-chars = 3 .
      558                               end.
      559                           when "b-history" or
      560                           when "b-hist" then
      561                               do:
      562                                   hh:load-image("cmp/b-hist.bmp":u) .
      563                                   hh:TOOLTIP = "История" .
      564                                   v-h[ii] = hh:handle .
      565                                   ii = ii + 1 .
      566                                   hh:width-chars = 3 .
      567                               end.
      568                           when "b-sch" then
      569                               do:
      570                                   hh:load-image("cmp/b-sch.bmp":u) .
      571                                   hh:TOOLTIP = "Установка Фильтра" .
      572                                   v-h[ii] = hh:handle .
      573                                   ii = ii + 1 .
      574                                   hh:width-chars = 3 .
      575                               end.
      576                           when "b-hist-user" then
      577                               do:
      578                                   hh:load-image("cmp/b-hist.bmp":u) .
      579                                   hh:TOOLTIP = "История пользователя" .
      580                                   ii = ii + 1 .
      581                               end.
      582                       end case.
      583                   end.
      584                   hh = hh:next-sibling.
      585               end.
      586               b-help:column = v-frame-width - b-help:width-chars.
      587               jj = 0.
      588               repeat ii = 4 to 1 by -1 :
      589                   if valid-handle (v-h[ii] ) then
      590                   do:
      591                       jj  = jj + 1 .
      592                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      593                       v-h[ii]:row    = v-help-old-y .
      594                   end.
      595               end.
      596           end.
      597       end.
      598   end procedure.
      599   MAIN-BLOCK:
      600   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      601      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      602     RUN Myenable in this-procedure .
      603     WAIT-FOR GO OF FRAME Dialog-Frame.
      604   END.
      605   RUN disable_UI.
      606   PROCEDURE disable_UI :
      607     HIDE FRAME Dialog-Frame.
      608   END PROCEDURE.
      609   PROCEDURE enable_UI :
      610     DISPLAY f-old-file f-old-file-size f-old-file-date f-old-file-time f-new-file
      611             f-new-file-size f-new-file-date f-new-file-time
      612         WITH FRAME Dialog-Frame.
      613     ENABLE B-Help B-overwrite B-overwrite-all B-skip b-quit B-overwrite-all-older
      614            B-skip-all f-old-file f-old-file-size f-old-file-date f-old-file-time
      615            f-new-file f-new-file-size f-new-file-date f-new-file-time
      616         WITH FRAME Dialog-Frame.
      617     VIEW FRAME Dialog-Frame.
      618   END PROCEDURE.
      619   PROCEDURE MyEnable :
      620   ASSIGN
      621   f-old-file = p-old-file-path
      622   f-old-file-size = p-old-file-size
      623   f-old-file-date = p-old-file-date
      624   f-old-file-time = string(p-old-file-time, "HH:MM:SS")
      625   f-new-file = p-new-file-path
      626   f-new-file-size = p-new-file-size
      627   f-new-file-date = p-new-file-date
      628   f-new-file-time = string(p-new-file-time, "HH:MM:SS")
      629   .
      630   DISPLAY
      631   f-old-file
      632   f-old-file-size
      633   f-old-file-date
      634   f-old-file-time
      635   f-new-file
      636   f-new-file-size
      637   f-new-file-date
      638   f-new-file-time
      639   WITH FRAME Dialog-Frame.
      640   ASSIGN
      641   B-overwrite:PRIVATE-DATA IN FRAME Dialog-Frame = string(1)
      642   B-overwrite-all :PRIVATE-DATA IN FRAME Dialog-Frame = string(2)
      643   B-skip:PRIVATE-DATA IN FRAME Dialog-Frame = string(3)
      644   b-quit:PRIVATE-DATA IN FRAME Dialog-Frame = string(6)
      645   B-overwrite-all-older:PRIVATE-DATA IN FRAME Dialog-Frame = string(5)
      646   B-skip-all:PRIVATE-DATA IN FRAME Dialog-Frame = string(4)
      647   .
      648   define variable fh as widget-handle no-undo .
      649   define variable hh as widget-handle no-undo .
      650   assign
      651   fh = frame Dialog-Frame:first-child
      652   hh = fh:first-child
      653   .
      654   do while valid-handle(hh):
      655   IF hh:TYPE <> "button" THEN DO:
      656     hh = hh:next-sibling.
      657   END.
      658   if hh:private-data = string(p-cancel-button) then do:
      659     ASSIGN
      660     FRAME Dialog-Frame:cancel-button = hh.
      661   end.
      662   if hh:private-data = string(p-default-button) then do:
      663     APPLY "ENTRY" to hh.
      664   end.
      665   hh = hh:next-sibling.
      666   end.
      667   ENABLE
      668   B-Help
      669   B-overwrite
      670   B-overwrite-all
      671   B-skip
      672   b-quit
      673   B-overwrite-all-older
      674   B-skip-all
      675   WITH FRAME Dialog-Frame.
      676   ASSIGN
      677   FRAME Dialog-Frame:TITLE = p-title.
      678   VIEW FRAME Dialog-Frame.
      679   END PROCEDURE.
