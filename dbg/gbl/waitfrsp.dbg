        1   define input parameter p-disk-letter            as character    no-undo.
        2   define input parameter p-minimum-free-mbytes    as decimal      no-undo.
        3   define output parameter p-cancel                as logical      no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Проверяет свободное место на диске с ожиданием.".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   define variable v-space-not-available    as logical        no-undo.
      110   DEFINE BUTTON b-exit AUTO-GO
      111        LABEL "&Выход"
      112        SIZE 10 BY 1
      113        BGCOLOR 8 .
      114   DEFINE BUTTON b-help
      115        LABEL "Помощ&ь"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE VARIABLE ed-message AS CHARACTER INITIAL "На диске недостаточно свободного места."
      119        VIEW-AS EDITOR
      120        SIZE 38.75 BY 3.79 NO-BOX  NO-UNDO.
      121   DEFINE FRAME Dialog-Frame
      122        b-exit AT ROW 1.17 COL 2
      123        b-help AT ROW 1.17 COL 31
      124        ed-message AT ROW 2.58 COL 2.25 NO-LABEL
      125        SPACE(0.87) SKIP(0.16)
      126       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      127            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      128            TITLE "Нет места на диске".
      129   ASSIGN
      130          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      131          FRAME Dialog-Frame:HIDDEN           = TRUE.
      132   ASSIGN
      133          ed-message:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      134   ON GO OF FRAME Dialog-Frame
      135   DO:
      136       assign
      137           p-cancel = yes
      138       .
      139   END.
      140   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      141   DO:
      142     APPLY "END-ERROR":U TO SELF.
      143   END.
      144   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      145   DO:
      146       assign
      147           p-cancel = yes
      148       .
      149       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      150   END.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   on help of frame Dialog-Frame
      153   do:
      154     run gbl/app_help.p
      155       (input this-procedure :file-name
      156       ,input ''
      157       ,input ?
      158       ) no-error.
      159     if error-status :error then do:
      160       message
      161         "Ошибка при вызове помощи"
      162         error-status :get-message(1)
      163         view-as alert-box .
      164     end.
      165   end.
      166   run minbtn-set in this-procedure .
      167   on choose of b-help in frame Dialog-Frame
      168   do:
      169     apply "help":u to frame Dialog-Frame .
      170   end.
      171   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure minbtn-set :
      173       do
      174           on error undo, return error return-value
      175           :
      176           define variable ii              as integer       no-undo .
      177           define variable fh              as widget-handle no-undo .
      178           define variable hh              as widget-handle no-undo .
      179           define variable v-h             as handle        extent 4 no-undo .
      180           define variable v-name-button   as character     no-undo .
      181           define variable v-help-old-x    as decimal       no-undo .
      182           define variable v-help-old-y    as decimal       no-undo .
      183           define variable v-help-old-size as decimal       no-undo .
      184           define variable v-frame-width   as decimal       no-undo .
      185           define variable jj              as integer       no-undo .
      186           do
      187               on error undo, return error
      188               :
      189               assign
      190                   v-frame-width = frame Dialog-Frame:width - 0.3
      191                   fh            = frame Dialog-Frame:first-child
      192                   hh            = fh:first-child
      193                   ii            = 1
      194                   .
      195               do while valid-handle(hh):
      196                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      197                   do:
      198                       case lc(hh:name) :
      199                           when "b-help" then
      200                               do:
      201                                   hh:load-image-up("cmp/b-help.bmp":u) .
      202                                   hh:load-image-down("cmp/b-help.bmp":u) .
      203                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      204                                   hh:TOOLTIP = "Помощь" .
      205                                   v-help-old-x = hh:column .
      206                                   v-help-old-y = hh:row    .
      207                                   v-help-old-size = hh:width .
      208                                   hh:width-chars = 2.5 .
      209                               end.
      210                           when "b-print" then
      211                               do:
      212                                   hh:load-image("cmp/b-print.bmp":u) .
      213                                   hh:TOOLTIP = "Печать" .
      214                                   v-h[ii] = hh:handle .
      215                                   ii = ii + 1 .
      216                                   hh:width-chars = 3 .
      217                               end.
      218                           when "b-history" or
      219                           when "b-hist" then
      220                               do:
      221                                   hh:load-image("cmp/b-hist.bmp":u) .
      222                                   hh:TOOLTIP = "История" .
      223                                   v-h[ii] = hh:handle .
      224                                   ii = ii + 1 .
      225                                   hh:width-chars = 3 .
      226                               end.
      227                           when "b-sch" then
      228                               do:
      229                                   hh:load-image("cmp/b-sch.bmp":u) .
      230                                   hh:TOOLTIP = "Установка Фильтра" .
      231                                   v-h[ii] = hh:handle .
      232                                   ii = ii + 1 .
      233                                   hh:width-chars = 3 .
      234                               end.
      235                           when "b-hist-user" then
      236                               do:
      237                                   hh:load-image("cmp/b-hist.bmp":u) .
      238                                   hh:TOOLTIP = "История пользователя" .
      239                                   ii = ii + 1 .
      240                               end.
      241                       end case.
      242                   end.
      243                   hh = hh:next-sibling.
      244               end.
      245               b-help:column = v-frame-width - b-help:width-chars.
      246               jj = 0.
      247               repeat ii = 4 to 1 by -1 :
      248                   if valid-handle (v-h[ii] ) then
      249                   do:
      250                       jj  = jj + 1 .
      251                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      252                       v-h[ii]:row    = v-help-old-y .
      253                   end.
      254               end.
      255           end.
      256       end.
      257   end procedure.
      258   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      259   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      260   MAIN-BLOCK:
      261   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      262      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      263       RUN enable_UI.
      264       assign
      265           p-cancel                    = no
      266           ed-message :screen-value    = substitute( "Недостаточно места на диске &1: (для работы программы требуется &2 мегабайт)."
      267                                                       + " Вы можете освободить место на диске или прервать выполнение программы"
      268                                                       + " нажатием кнопки Выход"
      269                                                       , caps( p-disk-letter )
      270                                                       , p-minimum-free-mbytes )
      271       .
      272       run gbl/chkfree.p (
      273             input p-disk-letter
      274           , input p-minimum-free-mbytes
      275           , output v-space-not-available
      276       ).
      277       if v-space-not-available = yes
      278       then do:
      279           free-space-loop:
      280           do
      281           while true
      282           :
      283               WAIT-FOR
      284                   GO OF FRAME Dialog-Frame
      285                   pause 5
      286               .
      287               run gbl/chkfree.p (
      288                     input p-disk-letter
      289                   , input p-minimum-free-mbytes
      290                   , output v-space-not-available
      291               ).
      292               if v-space-not-available = no
      293               then do:
      294                   leave free-space-loop.
      295               end.
      296           end.
      297       end.
      298       else do:
      299           assign
      300               p-cancel = no
      301           .
      302           return.
      303       end.
      304   END.
      305   RUN disable_UI.
      306   PROCEDURE disable_UI :
      307     HIDE FRAME Dialog-Frame.
      308   END PROCEDURE.
      309   PROCEDURE enable_UI :
      310     DISPLAY ed-message
      311         WITH FRAME Dialog-Frame.
      312     ENABLE b-exit b-help
      313         WITH FRAME Dialog-Frame.
      314     VIEW FRAME Dialog-Frame.
      315   END PROCEDURE.
