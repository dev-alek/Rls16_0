        1   block-level on error undo, throw.
        2   define input  parameter p-process-key    as character no-undo .
        3   define input  parameter p-Key#_One       like ub.batchprocess.Key#_One      no-undo .
        4   define input  parameter p-Key#_Two       like ub.batchprocess.Key#_Two      no-undo .
        5   define input  parameter p-Key#_Three     like ub.batchprocess.Key#_Three    no-undo .
        6   define input  parameter p-CharKey_One    like ub.batchprocess.CharKey_One   no-undo .
        7   define input  parameter p-CharKey_Two    like ub.batchprocess.CharKey_Two   no-undo .
        8   define input  parameter p-CharKey_Three  like ub.batchprocess.CharKey_Three no-undo .
        9   define input  parameter p-lock-type      as character no-undo .
       10   define parameter buffer lock_batchprocess for ub.batchprocess .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: lockshpr.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/lockshpr.p $":U .
       16   define variable vss-description as character no-undo init "Программа блокировки ресурсов".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35       assign
       36         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5':u,p-process-key,p-Key#_One,p-Key#_Two,p-Key#_Three,p-CharKey_One),substitute('&1|&2|&3':u,p-CharKey_Two,p-CharKey_Three,p-lock-type))
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define buffer buf_batchprocess for ub.batchprocess .
      315   define buffer delete_batchprocess for ub.batchprocess .
      316   do
      317   on error undo, return error return-value
      318   :
      319     if length(p-process-key) > 4
      320     then do:
      321       message
      322         vss-workfile vss-revision vss-description skip
      323         "Ошибка задания параметров" skip
      324         "Ключ блокирования процесса не может превышать 4 символа" skip
      325         "p-process-key"   p-process-key   skip
      326         "p-Key#_One"      p-Key#_One      skip
      327         "p-Key#_Two"      p-Key#_Two      skip
      328         "p-Key#_Three"    p-Key#_Three    skip
      329         "p-CharKey_One"   p-CharKey_One   skip
      330         "p-CharKey_Two"   p-CharKey_Two   skip
      331         "p-CharKey_Three" p-CharKey_Three skip
      332         "p-lock-type"     p-lock-type     skip
      333         view-as alert-box error .
      334       undo, return error return-value .
      335     end.
      336     if  p-lock-type <> 'share-lock':u
      337     and p-lock-type <> 'exclusive-lock':u
      338     then do:
      339       message
      340         vss-workfile vss-revision vss-description skip
      341         "Ошибка задания параметров" skip
      342         "Неизвестный тип блокирования процесса" skip
      343         "p-process-key"   p-process-key   skip
      344         "p-Key#_One"      p-Key#_One      skip
      345         "p-Key#_Two"      p-Key#_Two      skip
      346         "p-Key#_Three"    p-Key#_Three    skip
      347         "p-CharKey_One"   p-CharKey_One   skip
      348         "p-CharKey_Two"   p-CharKey_Two   skip
      349         "p-CharKey_Three" p-CharKey_Three skip
      350         "p-lock-type"     p-lock-type     skip
      351         view-as alert-box error .
      352       undo, return error return-value .
      353     end.
      354     def var v-bp_type like ub.batchprocess.bp_type no-undo .
      355     assign
      356       v-bp_type = 'lock':U + p-process-key
      357     .
      358     find first ub.batchprocess no-lock
      359       where ub.batchprocess.bp_type       = v-bp_type
      360         and ub.batchprocess.bp_status     = 'N':U
      361         and ub.batchprocess.key#_one      = p-Key#_One
      362         and ub.batchprocess.key#_two      = p-Key#_Two
      363         and ub.batchprocess.key#_three    = p-Key#_Three
      364         and ub.batchprocess.charkey_one   = p-CharKey_One
      365         and ub.batchprocess.charkey_two   = p-CharKey_Two
      366         and ub.batchprocess.charkey_three = p-CharKey_Three
      367       no-error .
      368     if not available ub.batchprocess
      369     then do:
      370       create ub.batchprocess .
      371       define variable v-btpr_upd-today as date      no-undo.
      372       define variable v-btpr_upd-time  as integer   no-undo.
      373       run cur-time in this-procedure
      374         (output v-btpr_upd-today
      375         ,output v-btpr_upd-time
      376         ).
      377       assign
      378         ub.batchprocess.batchprocess# = next-value(s-btpr, ub)
      379         ub.batchprocess.bp_type       = v-bp_type
      380         ub.batchprocess.bp_status     = 'N':U
      381         ub.batchprocess.user_id       = g#userid
      382         ub.batchprocess.bp_sysdate    = v-btpr_upd-today
      383         ub.batchprocess.bp_systime    = string( v-btpr_upd-time, 'hh:mm':u )
      384         ub.batchprocess.bp_systimeint = v-btpr_upd-time
      385         ub.batchprocess.key#_one      = p-Key#_One
      386         ub.batchprocess.key#_two      = p-Key#_Two
      387         ub.batchprocess.key#_three    = p-Key#_Three
      388         ub.batchprocess.charkey_one   = p-CharKey_One
      389         ub.batchprocess.charkey_two   = p-CharKey_Two
      390         ub.batchprocess.charkey_three = p-CharKey_Three
      391       .
      392     end.
      393     validate ub.batchprocess .
      394     run lock-record in this-procedure
      395       (buffer ub.batchprocess
      396       ,buffer lock_batchprocess
      397       ) no-error .
      398     if error-status :error
      399     then do:
      400       if error-status :get-message(1) <> ""
      401       then do:
      402         message
      403           vss-workfile vss-revision vss-description skip
      404           "Ошибка при вызове процедуры lock-record" skip
      405           view-as alert-box error .
      406       end.
      407       undo, return error return-value .
      408     end.
      409     if p-lock-type = 'exclusive-lock':u
      410     then do:
      411       define variable v-today as date      no-undo .
      412       define variable v-time  as integer   no-undo .
      413       run cur-time in this-procedure
      414         (output v-today
      415         ,output v-time
      416         ).
      417       assign
      418         lock_batchprocess.bp_execuser_id    = g#userid
      419         lock_batchprocess.bp_execsysdate    = v-today
      420         lock_batchprocess.bp_execsystime    = string(v-time, 'hh:mm':u)
      421         lock_batchprocess.bp_execsystimeint = v-time
      422       .
      423     end.
      424     define variable v-lock-success as logical   no-undo .
      425     assign
      426       v-lock-success = true
      427     .
      428     for each buf_batchprocess no-lock
      429       where buf_batchprocess.bp_type       = v-bp_type
      430         and buf_batchprocess.bp_status     = 'N':U
      431         and buf_batchprocess.Key#_One      = p-Key#_One
      432         and buf_batchprocess.Key#_Two      = p-Key#_Two
      433         and buf_batchprocess.Key#_Three    = p-Key#_Three
      434         and buf_batchprocess.CharKey_One   = p-CharKey_One
      435         and buf_batchprocess.CharKey_Two   = p-CharKey_Two
      436         and buf_batchprocess.CharKey_Three = p-CharKey_Three
      437         and recid(buf_batchprocess) <> recid(lock_batchprocess)
      438     on error undo, return error return-value
      439     :
      440       assign
      441         v-lock-success = false
      442       .
      443       define buffer buf_delete_batchprocess for ub.batchprocess .
      444       find first buf_delete_batchprocess exclusive-lock
      445         where recid(buf_delete_batchprocess) = recid(buf_batchprocess)
      446         no-wait
      447         no-error .
      448       if available (buf_delete_batchprocess)
      449       then do:
      450         delete buf_delete_batchprocess .
      451       end.
      452     end.
      453     if v-lock-success <> true
      454     then do:
      455       find current ub.batchprocess exclusive-lock
      456         no-wait
      457         no-error .
      458       if available ub.batchprocess
      459       then do:
      460         delete ub.batchprocess .
      461       end.
      462       undo, return error substitute("Попытка одновременного захвата ресурса &1", v-bp_type) .
      463     end.
      464     return .
      465   end.
      466   procedure lock-record :
      467     define parameter buffer other_batchprocess for ub.batchprocess .
      468     define parameter buffer buf_batchprocess for ub.batchprocess .
      469     def var v-resource-id as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       if p-lock-type = 'exclusive-lock':u
      474       then do:
      475         find first buf_batchprocess exclusive-lock
      476           where recid(buf_batchprocess) = recid(other_batchprocess)
      477           no-error .
      478       end.
      479       else do:
      480         find first buf_batchprocess share-lock
      481           where recid(buf_batchprocess) = recid(other_batchprocess)
      482           no-error .
      483       end.
      484       if not available buf_batchprocess
      485       then do:
      486           message
      487             vss-workfile vss-revision vss-description skip
      488             "Внутренняя ошибка при блокировании ресурса" skip
      489             "Отсутствует запись о блокировке ресурса" skip
      490             view-as alert-box error.
      491         undo, return error substitute("Другой пользователь захватил ресурс &1", v-resource-id) .
      492       end.
      493     end.
      494   end procedure.
