        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: windinfo.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/windinfo.p $":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define temp-table temp-window no-undo
      114      field window-handle       as integer   label "Handle"
      115      field window-visible      as logical   label "Visible"
      116      field window-text         as character label "Text"     format "x(20)"
      117      field window-class-atom   as integer   label "Class Atom"
      118      field window-class-name   as character label "Class Name"
      119      field window-message      as logical
      120      field window-message-text as character label "Message"  format "x(60)"
      121      field window-process-id   as integer   label "Process"
      122      field window-thread-id    as integer   label "Thread"
      123   .
      124   define output parameter table for temp-window .
      125   define variable v-return-value as integer no-undo .
      126   define variable lpProcessId as memptr    no-undo .
      127   define variable lpString    as memptr    no-undo .
      128   define variable hWnd        as integer   no-undo .
      129   assign
      130     set-size(lpProcessId) = 4
      131     set-size(lpstring) = 10000
      132   .
      133   define variable v-desktop-window as integer   no-undo .
      134   run GetDesktopWindow
      135     (output v-desktop-window
      136     ) .
      137   define variable v-current-window as integer   no-undo .
      138   define variable v-next-window    as integer   no-undo .
      139   run GetTopWindow
      140     (input  v-desktop-window
      141     ,output v-current-window
      142     ) .
      143   do while v-current-window <> 0
      144   :
      145     assign
      146       hWnd = v-current-window
      147     .
      148     create temp-window .
      149     assign
      150       temp-window.window-handle = hwnd
      151     .
      152     run IsWindowVisible
      153       (input  hwnd
      154       ,output v-return-value
      155       ).
      156     if v-return-value <> 0
      157     then do:
      158       assign
      159         temp-window.window-visible = true
      160       .
      161     end.
      162     else do:
      163       assign
      164         temp-window.window-visible = false
      165       .
      166     end.
      167     define variable v-thread-id as integer   no-undo .
      168     run GetWindowThreadProcessId
      169       (input hwnd
      170       ,input  get-pointer-value(lpProcessId)
      171       ,output v-thread-id
      172       ).
      173     assign
      174       temp-window.window-process-id = get-long(lpProcessId, 1)
      175       temp-window.window-thread-id  = v-thread-id
      176     .
      177     run GetWindowTextA
      178       (input  hwnd
      179       ,input  get-pointer-value(lpString)
      180       ,input  get-size(lpString)
      181       ,output v-return-value
      182       ).
      183     if v-return-value <> 0
      184     then do:
      185       assign
      186         temp-window.window-text = get-string(lpString, 1)
      187       .
      188     end.
      189     run GetClassLongA
      190       (input hwnd
      191       ,input -32
      192       ,output v-return-value
      193       ) .
      194     if v-return-value <> 0
      195     then do:
      196       assign
      197         temp-window.window-class-atom = v-return-value
      198       .
      199     end.
      200     if temp-window.window-class-atom <> 0
      201     then do:
      202       run GlobalGetAtomNameA
      203         (input temp-window.window-class-atom
      204         ,input get-pointer-value(lpString)
      205         ,input get-size(lpString)
      206         ,output v-return-value
      207         ) .
      208       if v-return-value <> 0
      209       then do:
      210         assign
      211           temp-window.window-class-name = get-string(lpString, 1)
      212         .
      213       end.
      214     end.
      215     if temp-window.window-class-name = "#32770"
      216     then do:
      217       assign
      218         temp-window.window-message = true
      219       .
      220       run GetDlgItemTextA
      221         (input temp-window.window-handle
      222         ,input 65535
      223         ,input get-pointer-value(lpString)
      224         ,input get-size(lpString)
      225         ,output v-return-value
      226         ) .
      227       if v-return-value <> 0
      228       then do:
      229         assign
      230           temp-window.window-message-text = get-string(lpString, 1)
      231         .
      232       end.
      233     end.
      234     else do:
      235       assign
      236         temp-window.window-message = false
      237       .
      238     end.
      239     run GetWindow
      240       (input  v-current-window
      241       ,input  2
      242       ,output v-next-window
      243       ) .
      244     assign
      245       v-current-window = v-next-window
      246     .
      247   end.
      248   assign
      249     set-size(lpProcessId) = 0
      250     set-size(lpString) = 0
      251   .
      252   PROCEDURE IsWindowVisible EXTERNAL "user32" :
      253     DEFINE INPUT  PARAMETER hwnd   AS LONG.
      254     DEFINE RETURN PARAMETER retval AS LONG.
      255   END PROCEDURE.
      256   PROCEDURE GetWindowTextA EXTERNAL "user32" :
      257     DEFINE INPUT  PARAMETER hWnd      AS LONG.
      258     DEFINE INPUT  PARAMETER lpString  AS LONG.
      259     DEFINE INPUT  PARAMETER nMaxCount AS LONG.
      260     DEFINE RETURN PARAMETER retval    AS LONG.
      261   END PROCEDURE.
      262   PROCEDURE GetClassLongA EXTERNAL "user32" :
      263     DEFINE INPUT  PARAMETER hWnd   AS LONG.
      264     DEFINE INPUT  PARAMETER nIndex AS LONG.
      265     DEFINE RETURN PARAMETER retval AS LONG.
      266   END PROCEDURE.
      267   PROCEDURE GlobalGetAtomNameA EXTERNAL "kernel32" :
      268     DEFINE INPUT  PARAMETER nAtom    AS LONG.
      269     DEFINE INPUT  PARAMETER lpBuffer AS LONG.
      270     DEFINE INPUT  PARAMETER nSize    AS LONG.
      271     DEFINE RETURN PARAMETER retval   AS LONG.
      272   END PROCEDURE.
      273   PROCEDURE GetDlgItemTextA EXTERNAL "user32" :
      274     DEFINE INPUT  PARAMETER hDlg       AS LONG.
      275     DEFINE INPUT  PARAMETER nIDDlgItem AS LONG.
      276     DEFINE INPUT  PARAMETER lpString   AS LONG.
      277     DEFINE INPUT  PARAMETER nMaxCount  AS LONG.
      278     DEFINE RETURN PARAMETER retval     AS LONG.
      279   END PROCEDURE.
      280   PROCEDURE  GetDesktopWindow EXTERNAL "user32" :
      281     DEFINE RETURN PARAMETER retval AS LONG.
      282   END PROCEDURE.
      283   PROCEDURE  GetTopWindow EXTERNAL "user32" :
      284     DEFINE INPUT  PARAMETER hwnd   AS LONG.
      285     DEFINE RETURN PARAMETER retval AS LONG.
      286   END PROCEDURE.
      287   PROCEDURE  GetWindow EXTERNAL "user32" :
      288     DEFINE INPUT  PARAMETER hwnd   AS LONG.
      289     DEFINE INPUT  PARAMETER wCmd   AS LONG.
      290     DEFINE RETURN PARAMETER retval AS LONG.
      291   END PROCEDURE.
      292   PROCEDURE GetWindowThreadProcessId EXTERNAL "user32" :
      293     DEFINE INPUT  PARAMETER hwnd          AS LONG.
      294     DEFINE INPUT  PARAMETER lpdwProcessId AS LONG.
      295     DEFINE RETURN PARAMETER retval        AS LONG.
      296   END PROCEDURE.
