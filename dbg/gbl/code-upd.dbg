      498       if v-err-msg > ""
      499       then v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-upd.p" + v-err-msg.
      500       else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-upd.p" .
      501       return error v-err-msg.
      502     end catch .
