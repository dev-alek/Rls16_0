      236   define new global shared variable g#library  as handle no-undo .
      237   define new global shared variable g#library2 as handle no-undo .
      238   define   shared variable g#auto as logical no-undo.
      239   define   shared variable g#news as logical no-undo.
      240   define   shared variable g#oxml as logical no-undo.
      241   define   shared variable g#esys as logical no-undo.
      242   define   shared variable g#news-source-db as integer no-undo.
      243   define   shared variable g#esys-source-esys as integer no-undo.
      244   define   shared variable g#db-num as integer   no-undo .
      245   define   shared variable g#userid as character no-undo .
      246   define   shared variable g#passwd as character no-undo .
      247   define variable mDisableNwsFortable as character no-undo.
      248   procedure DisableNws:
      249      define input  parameter iTable  as character no-undo.
      250      define output parameter oNotNWS as logical no-undo.
      251      if      mDisableNwsFortable ne ?
      252          and can-do(mDisableNwsFortable,iTable)
      253      then
      254         oNotNWS = yes.
      255   end.
      256   procedure SetNwsTable:
      257      define input  parameter iTable  as character no-undo.
      258      mDisableNwsFortable = iTable.
      259   end.
      260   procedure RunProcAny:
      261      define input  parameter iProc  as character no-undo.
      262      define input  parameter iParam as character no-undo.
      263      define output parameter oOk    as logical   no-undo.
      264      run value(iproc) (parparentproc, iparam, output oOk) no-error.
      265      if error-status:error
      266      then
      267         return substitute ("&1 &2", return-value, error-status:get-message(1)).
      268   end.
      269   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270     define variable v-cntxt-db-num        as integer   no-undo .
      271     define variable v-cntxt-userid        as character no-undo .
      272     define variable v-cntxt-level         as character no-undo .
      273     define variable v-cntxt-host-code-obj as integer   no-undo .
      274     define variable v-cntxt-obj-type      as character no-undo .
      275     define variable v-cntxt-obj-code      as integer   no-undo .
      276     define variable v-cntxt-db-num-obj    as integer   no-undo .
      277     define variable v-cntxt-is-admin      as logical   no-undo .
      278   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      279     run mainmenu_getcntxt in parparentproc
      280       (output v-cntxt-db-num
      281       ,output v-cntxt-userid
      282       ,output v-cntxt-level
      283       ,output v-cntxt-host-code-obj
      284       ,output v-cntxt-obj-type
      285       ,output v-cntxt-obj-code
      286       ,output v-cntxt-db-num-obj
      287       ,output v-cntxt-is-admin
      288       ) .
      289   define buffer buf_db for ub.db.
      290   find first buf_db no-lock where buf_db.db-num = v-cntxt-db-num no-error.
      291   define variable updschmObj      as class ibs.th.adm.upd.CheckUpd no-undo.
      292   updschmObj = new ibs.th.adm.upd.CheckUpd (no).
      293   updschmObj:updChceck().
      294   if     buf_db.reserve1-char begins "updto:"
      295       or updschmObj:CurrDBShm ne int(buf_db.reserve1-char)
      296   then do trans:
      297      find first buf_db exclusive-lock where buf_db.db-num = v-cntxt-db-num no-error.
      298      buf_db.reserve1-char = string(updschmObj:CurrDBShm).
      299   end.
      300   delete object updschmObj no-error.
      301   define variable mfile as character no-undo.
      302   define variable mfilemd5 as character no-undo.
      303   define variable v-md5-signature  as character no-undo.
      304   define variable vimport as class ibs.th.bge.xmlimpexp no-undo.
      305   define variable mTxt as character no-undo.
      306   define variable mfilever as char no-undo init ?.
      307   define variable m-type as character no-undo.
      308   define variable mdbver as integer no-undo.
      309   define variable mdbver_old as integer no-undo.
      310   define variable f_load as logical no-undo init no.
      311   define variable mRunTransaction as logical no-undo.
      312   define stream md5in.
      313   run db-attr-value in this-procedure
      314              (input ibs.th.gbl.gbl-var:g#db-num
      315              ,input 'ver-met':U
      316              ,output mTxt
      317              ,output m-type
      318              ) no-error .
      319   mdbver_old = int(mtxt) no-error.
      320   if mdbver_old eq ?
      321   then
      322      mdbver_old = 0.
      323   subscribe "RunProcXmlImp" anywhere run-procedure "RunProcAny".
      324   subscribe "NotSendNwsForTable" anywhere run-procedure "DisableNws".
      325   subscribe "DisableNwsTable" anywhere run-procedure "SetNwsTable".
      326   vimport= new ibs.th.bge.xmlimpexp().
      327   block-upd:
      328   do mdbver = mdbver_old + 1 to 999999999:
      329      mfile    = search(substitute("upd/&1.xml",string(mdbver,"999999999"))).
      330      mfilemd5 = search(substitute("upd/&1.md5",string(mdbver,"999999999"))).
      331      if    mfile    eq ?
      332         or mfilemd5 eq ?
      333      then
      334         leave block-upd.
      335      input  stream md5in from value (mfilemd5).
      336      import stream md5in mtxt no-error.
      337      input  stream md5in close.
      338      run gbl/md5.p (
      339             input  mfile
      340            ,output v-md5-signature
      341            ) .
      342      if mtxt eq encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      343      then do:
      344         vimport:xmldom-load-ver  ( mfile,? ) no-error.
      345         mRunTransaction = vimport:mTransaction.
      346         if error-status:error
      347         then
      348            return error return-value.
      349         if mRunTransaction then
      350         do:
      351           UPD_TBL:
      352           do transaction on error undo UPD_TBL, leave UPD_TBL:
      353             vimport:updatetablefordb(this-procedure) no-error.
      354             if error-status:error
      355               then return error return-value.
      356           end.
      357         end.
      358         else do:
      359            vimport:updatetablefordb(this-procedure) no-error.
      360            if error-status:error
      361              then return error return-value.
      362         end.
      363          CODE_UPD:
      364          do transaction on error undo CODE_UPD, leave CODE_UPD:
      365          create code  no-error.
      366            assign
      367            code.parent    = substitute("XML_UPD&1 &2",chr(4),string(ibs.th.gbl.gbl-var:g#db-num))
      368            code.code      = string(now)
      369            code.CodeValue = entry(num-entries(mfile, "\") , mfile, "\")
      370            code.misc1     = v-md5-signature
      371            code.misc2     = string(mdbver)
      372            code.misc3     = string(ibs.th.gbl.gbl-var:g#db-num)
      373            code.nwsgbd    = yes.
      374            code.nwsubd    = yes.
      375            .
      376          f_load = yes.
      377          end.
      378         return-value = "".
      379         vimport:xmldom-clear().
      380      end.
      381      else
      382         return error substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile).
      383   end.
      384   mdbver = mdbver - 1.
      385   if mdbver gt mdbver_old
      386   then
      387      run db-attr-write in this-procedure ( input ibs.th.gbl.gbl-var:g#db-num
      388                                          , input 'ver-met':U
      389                                          , input string (mdbver)
      390                                          )  .
      391   mfile    = search("upd/code.xml").
      392   mfilemd5 = search("upd/code.md5").
      393   if mfile ne ? and mfilemd5 ne ?
      394   then do:
      395      input  stream md5in from value (mfilemd5).
      396      import stream md5in mtxt no-error.
      397      input  stream md5in close.
      398      run gbl/md5.p (
      399             input  mfile
      400            ,output v-md5-signature
      401            ) .
      402      if mtxt ne encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      403      then
      404         return error substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile).
      405      mfilever = vimport:xmldom-load-ver  ( mfile,? ) no-error.
      406      if error-status:error
      407      then
      408         return error return-value.
      409      IMP_CODE:
      410      do transaction on error undo IMP_CODE, leave IMP_CODE:
      411          vimport:updatetablefordb(this-procedure) no-error.
      412          if error-status:error
      413          then
      414             return error return-value + " " + error-status:get-message(1).
      415          else
      416             run db-attr-write in this-procedure ( input ibs.th.gbl.gbl-var:g#db-num
      417                                                 , input 'ver-code':U
      418                                                 , input mfilever
      419                                                 ) no-error .
      420      end.
      421      CODE_UPD2:
      422      do transaction on error undo CODE_UPD2, leave CODE_UPD2:
      423      find last code no-lock where code.CodeValue = "code.xml" no-error.
      424      if available code and code.misc1 <> v-md5-signature
      425            then do:
      426            create code no-error.
      427               assign
      428               code.parent    = substitute("XML_UPD&1 &2",chr(4),string(ibs.th.gbl.gbl-var:g#db-num))
      429               code.code      = string(now)
      430               code.CodeValue = entry(num-entries(mfile, "\") , mfile, "\")
      431               code.misc1     = v-md5-signature
      432               code.misc2     = string(mdbver)
      433               code.misc3     = string(ibs.th.gbl.gbl-var:g#db-num)
      434               code.nwsgbd    = yes.
      435               code.nwsubd    = yes.
      436               .
      437      f_load = yes.
      438      end.
      439      if not available code
      440            then do:
      441            create code  no-error.
      442               assign
      443               code.parent    = substitute("XML_UPD&1 &2",chr(4),string(ibs.th.gbl.gbl-var:g#db-num))
      444               code.code      = string(now)
      445               code.CodeValue = entry(num-entries(mfile, "\") , mfile, "\")
      446               code.misc1     = v-md5-signature
      447               code.misc2     = string(mdbver)
      448               code.misc3     = string(ibs.th.gbl.gbl-var:g#db-num)
      449               code.nwsgbd    = yes.
      450               code.nwsubd    = yes.
      451               .
      452      f_load = yes.
      453      end.
      454      end.
      455      return-value = "".
      456      vimport:xmldom-clear().
      457   end.
      458   if f_load = no
      459           then do:
      460      CODE_UPD3:
      461      do transaction on error undo CODE_UPD3, leave CODE_UPD3:
      462           find last code no-lock where code.parent BEGINS "XML_UPD" no-error.
      463           mfile    = search(substitute("upd/&1.xml", string(mdbver_old, "999999999"))).
      464           mfilemd5 = search(substitute("upd/&1.md5", string(mdbver_old, "999999999"))).
      465           if mfile ne ? and mfilemd5 ne ? then do:
      466                   input stream md5in from value(mfilemd5).
      467                   import stream md5in mTxt no-error.
      468                   input stream md5in close.
      469                   run gbl/md5.p (input  mfile, output v-md5-signature) no-error.
      470                   if available code and code.misc1 ne v-md5-signature then do:
      471                           create code no-error.
      472                           assign
      473                           code.parent    = substitute("XML_UPD&1 &2",chr(4),string(ibs.th.gbl.gbl-var:g#db-num))
      474                           code.code      = string(now)
      475                           code.CodeValue = entry(num-entries(mfile, "\") , mfile, "\")
      476                           code.misc1     = v-md5-signature
      477                           code.misc2     = string(mdbver)
      478                           code.misc3     = string(ibs.th.gbl.gbl-var:g#db-num)
      479                           code.nwsgbd    = yes.
      480                           code.nwsubd    = yes.
      481                           .
      482                   end.
      483           end.
      484      end.
      485   end.
