      491         if v-err-msg > ""
      492         then v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-upd.p" + v-err-msg.
      493         else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\code-upd.p" .
      494       end .
      495     end catch .
