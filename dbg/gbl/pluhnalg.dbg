        1   block-level on error undo, throw.
        2   define input parameter p-check-number as character no-undo .
        3   define output parameter p-long-number  as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: pluhnalg.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/pluhnalg.p $":U .
        9   define variable vss-description as character no-undo init "Процедура получения по номеру карты вида NNNNNNNNN? номера с рассчитанной КЦ NNNNNNNNNC по методу Luhna".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   FUNCTION Luhn-algo returns integer(input p-str as character):
       70   define variable v-length as integer no-undo .
       71   define variable v-ii as integer no-undo .
       72   define variable v-jj as integer no-undo .
       73   define variable v-c as character no-undo extent 10.
       74   define variable v-c-int-dop as integer no-undo extent 10.
       75   define variable v-c-int-dop2 as integer no-undo extent 10.
       76   define variable v-c-int as integer no-undo extent 10.
       77   define variable v-all as integer no-undo .
       78   define variable v-all-trunc-up as integer no-undo .
       79   assign
       80   v-length = length(p-str).
       81   if v-length modulo 2 <> 0 then do:
       82     assign
       83     p-str = "0" + p-str
       84     .
       85   end.
       86   do v-ii = 0 to v-length by 2:
       87     assign
       88     v-jj = integer(v-ii / 2) + 1
       89     v-c[v-jj] = substring(p-str, v-ii + 1, 2)
       90     v-c-int-dop[v-jj] = integer(substring(v-c[v-jj], 2, 1)) * 2
       91     v-c-int-dop2[v-jj] = TRUNCATE(v-c-int-dop[v-jj] / 10, 0)  +  v-c-int-dop[v-jj] modulo 10
       92     v-c-int[v-jj] = integer(substring(v-c[v-jj], 1, 1)) + v-c-int-dop2[v-jj]
       93     v-all = v-all +  v-c-int[v-jj]
       94     .
       95   end.
       96   assign
       97   v-all-trunc-up =  if v-all modulo 10 <> 0
       98                     then (TRUNCATE(v-all / 10, 0) * 10 + 10)
       99                     else v-all
      100   .
      101   return (v-all-trunc-up - v-all).
      102   END FUNCTION.
      103   define variable v-dopi as integer no-undo .
      104   define variable v-pos as integer no-undo .
      105   define variable v-check-number as character no-undo .
      106   do
      107   on error undo, return error
      108   :
      109     if index(p-check-number , 'C') = 0 then do:
      110       undo, return error substitute("в номере карты &1 не определена позиция контрольной цифры"
      111                                      , p-check-number ).
      112     end.
      113     if num-entries(p-check-number, 'C') > 2 then do:
      114       undo, return error substitute("для карты &1 определено более 1 позиции контрольной цифры&2для алгоритма Luhna это невозможно"
      115                                      , p-check-number
      116                                      , chr(10)
      117                                      ).
      118     end.
      119     assign
      120     v-pos  = index(p-check-number, 'C')
      121     v-check-number = p-check-number
      122     v-dopi = Luhn-algo(replace(p-check-number, 'C', '':U))
      123     no-error .
      124     if error-status:error then do:
      125       undo, return error substitute("ошибка при вычислении КЦ для карты &1:&2&3&2&4"
      126                                      , P-CHECK-NUMBER
      127                                      , chr(10)
      128                                      , error-status:get-message(1)
      129                                      , return-value ).
      130     end.
      131     assign
      132     p-long-number = replace(v-check-number, 'C':U, string(v-dopi))
      133     .
      134   end.
