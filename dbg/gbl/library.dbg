     6161           "Код товара" p-gds-code skip
     6162           view-as alert-box error .
     6163         undo, return error return-value .
     6164       end.
     6165       assign
     6166         p-unit-base = buf_goods.unit-base
     6167       .
     6168     end.
     6169   end procedure.
