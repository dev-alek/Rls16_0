    11908           "Ошибка при вызове процедуры" 'odtclose':u skip
    11909           "Объект" p-obj-type p-obj-code skip
    11910           "Новая дата" p-sys-date skip
    11911           return-value skip
    11912           error-status :get-message(1) skip
    11913           view-as alert-box error .
    11914         undo, return error return-value .
    11915       end.
