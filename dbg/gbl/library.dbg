     3290   define variable l-last-hostcode-exist     as logical                  no-undo initial false .
     3291   define variable v-last-hostcode-obj-type  like ub.price-doc.obj-type  no-undo .
     3292   define variable v-last-hostcode-obj-code  like ub.price-doc.obj-code  no-undo .
     3293   define variable v-last-hostcode-host-code like ub.price-doc.host-code no-undo .
