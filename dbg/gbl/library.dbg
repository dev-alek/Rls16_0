     3309   procedure hostcode :
     3310   do
     3311   on error undo, return error return-value
     3312   :
     3313     define input  parameter p-obj-type  as character no-undo .
     3314     define input  parameter p-obj-code  as integer   no-undo .
     3315     define output parameter p-host-code as integer   no-undo .
     3316     define variable vss-description as character no-undo initial "hostcode-01: код фирмы для объекта".
     3317     if  l-last-hostcode-exist = true
     3318     and p-obj-type            = v-last-hostcode-obj-type
     3319     and p-obj-code            = v-last-hostcode-obj-code
     3320     then do:
     3321       assign
     3322         p-host-code = v-last-hostcode-host-code
     3323       .
     3324       return .
     3325     end.
     3326     define buffer buf_store   for ub.store .
     3327     define buffer buf_shop    for ub.shop .
     3328     case p-obj-type :
     3329       when 'скл':U
     3330       then do:
     3331         find first buf_store no-lock
     3332           where buf_store.obj-code = p-obj-code
     3333           no-error .
     3334         if not available buf_store
     3335         then do:
     3336           message
     3337             vss-workfile vss-revision vss-description skip
     3338             "Не найден склад" skip
     3339             "p-obj-type" p-obj-type skip
     3340             "p-obj-code" p-obj-code skip
     3341             view-as alert-box error .
     3342           undo, return error return-value .
     3343         end.
     3344         assign
     3345           p-host-code = buf_store.host-code
     3346         .
     3347       end.
     3348       when 'маг':U
     3349       then do:
     3350         find first buf_shop no-lock
     3351           where buf_shop.obj-code = p-obj-code
     3352           no-error .
     3353         if not available buf_shop
     3354         then do:
     3355           message
     3356             vss-workfile vss-revision vss-description skip
     3357             "Не найден магазин" skip
     3358             "p-obj-type" p-obj-type skip
     3359             "p-obj-code" p-obj-code skip
     3360             view-as alert-box error .
     3361           undo, return error return-value .
     3362         end.
     3363         assign
     3364           p-host-code = buf_shop.host-code
     3365         .
     3366       end.
     3367       otherwise do:
     3368         message
     3369           vss-workfile vss-revision vss-description skip
     3370           "Неизвестный тип объекта" skip
     3371           "p-obj-type" p-obj-type skip
     3372           "p-obj-code" p-obj-code skip
     3373           view-as alert-box error .
     3374         undo, return error return-value .
     3375       end.
     3376     end.
     3377     assign
     3378       l-last-hostcode-exist     = true
     3379       v-last-hostcode-obj-type  = p-obj-type
     3380       v-last-hostcode-obj-code  = p-obj-code
     3381       v-last-hostcode-host-code = p-host-code
     3382     .
     3383   end.
     3384   end procedure.
     3385   procedure hostname :
     3386   do
     3387   on error undo, return error return-value
     3388   :
     3389     define input  parameter p-obj-type  like ub.price-doc.obj-type  no-undo .
     3390     define input  parameter p-obj-code  like ub.price-doc.obj-code  no-undo .
     3391     define output parameter p-host-code like ub.price-doc.host-code no-undo .
     3392     define output parameter p-host-name like ub.clients.obj-name    no-undo .
     3393     define variable vss-description as character no-undo initial "hostname-01: имя фирмы для объекта".
     3394     if  l-last-hostname-exist = true
     3395     and p-obj-type            = v-last-hostname-obj-type
     3396     and p-obj-code            = v-last-hostname-obj-code
     3397     then do:
     3398       assign
     3399         p-host-code = v-last-hostcode-host-code
     3400         p-host-name = v-last-hostname-host-name
     3401       .
     3402       return .
     3403     end.
     3404     if  l-last-hostname-exist = true
     3405     and p-obj-type = 'орг':U
     3406     and v-last-hostcode-host-code = p-obj-code then do:
     3407       assign
     3408         p-host-code = v-last-hostcode-host-code
     3409         p-host-name = v-last-hostname-host-name
     3410       .
     3411       return .
     3412     end.
     3413     define buffer buf_store   for ub.store .
     3414     define buffer buf_shop    for ub.shop .
     3415     define buffer buf_clients for ub.clients.
     3416     define buffer buf_sysconf for ub.sysconf .
     3417     case p-obj-type :
     3418       when 'скл':U
     3419       then do:
     3420         find first buf_store no-lock
     3421              where buf_store.obj-code = p-obj-code
     3422         no-error .
     3423         if not available buf_store
     3424         then do:
     3425           message
     3426             vss-workfile vss-revision vss-description skip
     3427             "Не найден склад" skip
     3428             "p-obj-type" p-obj-type skip
     3429             "p-obj-code" p-obj-code skip
     3430             view-as alert-box error .
     3431           undo, return error return-value .
     3432         end.
     3433         assign
     3434           p-host-code = buf_store.host-code
     3435         .
     3436       end.
     3437       when 'маг':U
     3438       then do:
     3439         find first buf_shop no-lock
     3440              where buf_shop.obj-code = p-obj-code
     3441         no-error .
     3442         if not available buf_shop
     3443         then do:
     3444           message
     3445             vss-workfile vss-revision vss-description skip
     3446             "Не найден магазин" skip
     3447             "p-obj-type" p-obj-type skip
     3448             "p-obj-code" p-obj-code skip
     3449             view-as alert-box error .
     3450           undo, return error return-value .
     3451         end.
     3452         assign
     3453           p-host-code = buf_shop.host-code
     3454         .
     3455       end.
     3456       when 'орг':U
     3457       then do:
     3458         find first buf_sysconf no-lock
     3459              where buf_sysconf.host-code = p-host-code
     3460         no-error.
     3461         if not available buf_sysconf
     3462         then do:
     3463           message
     3464             vss-workfile vss-revision vss-description skip
     3465             "Не найдена СВОЯ фирма" skip
     3466             "p-obj-type" p-obj-type skip
     3467             "p-obj-code" p-obj-code skip
     3468             view-as alert-box error .
     3469           undo, return error return-value .
     3470         end.
     3471         assign
     3472           p-host-code = buf_sysconf.host-code
     3473         .
     3474       end.
     3475       otherwise do:
     3476         message
     3477           vss-workfile vss-revision vss-description skip
     3478           "Неизвестный тип объекта" skip
     3479           "p-obj-type" p-obj-type skip
     3480           "p-obj-code" p-obj-code skip
     3481           view-as alert-box error .
     3482         undo, return error return-value .
     3483       end.
     3484     end.
     3485     if p-obj-type <> 'орг':U then do:
     3486       assign
     3487         l-last-hostcode-exist     = true
     3488         v-last-hostcode-obj-type  = p-obj-type
     3489         v-last-hostcode-obj-code  = p-obj-code
     3490         v-last-hostcode-host-code = p-host-code
     3491       .
     3492     end.
     3493     find first buf_clients no-lock
     3494          where buf_clients.obj-type = 'орг':U
     3495            and buf_clients.obj-code = p-host-code
     3496     no-error.
     3497     if not available buf_clients
     3498     then do:
     3499       message
     3500         vss-workfile vss-revision vss-description skip
     3501         "Не найдена фирма" skip
     3502         "p-host-code" p-host-code skip
     3503       view-as alert-box error .
     3504       undo, return error return-value .
     3505     end.
     3506     assign
     3507       p-host-name               = buf_clients.obj-name
     3508     .
     3509     if p-obj-type <> 'орг':U then do:
     3510       assign
     3511         l-last-hostname-exist     = true
     3512         v-last-hostname-obj-type  = p-obj-type
     3513         v-last-hostname-obj-code  = p-obj-code
     3514         v-last-hostname-host-name = p-host-name
     3515       .
     3516     end.
     3517   end.
     3518   end procedure.
     3519   procedure hostcvat :
     3520   do
     3521   on error undo, return error return-value
     3522   :
     3523     define input  parameter p-host-code   like ub.sysconf.host-code   no-undo .
     3524     define output parameter p-cons-vat-pc like ub.sysconf.cons-vat-pc no-undo .
     3525     define buffer buf_sysconf   for ub.sysconf.
     3526     define variable vss-description as character no-undo initial "hostcvat-01: Консигнационный НДС для фирмы".
     3527     find first buf_sysconf
     3528          where buf_sysconf.host-code = p-host-code
     3529     no-error.
     3530     if error-status :error
     3531     then do:
     3532         message
     3533           vss-workfile vss-revision vss-description skip
     3534           "Не найдена фирма." skip
     3535           "p-host-code" p-host-code skip
     3536         view-as alert-box error .
     3537         undo, return error return-value .
     3538     end.
     3539     assign
     3540       p-cons-vat-pc = buf_sysconf.cons-vat-pc
     3541     .
     3542   end.
     3543   end procedure.
     3544   procedure gdsobjcr :
     3545     define input parameter  p-obj-type  like ub.gds-obj.obj-type  no-undo .
     3546     define input parameter  p-obj-code  like ub.gds-obj.obj-code  no-undo .
     3547     define input parameter  p-artic     like ub.gds-obj.artic     no-undo .
     3548     define input parameter  p-prod-type like ub.gds-obj.prod-type no-undo .
     3549     define input parameter  p-prod-code like ub.gds-obj.prod-code no-undo .
     3550     define parameter buffer buf_gds-obj for ub.gds-obj .
     3551     define variable vss-description as character no-undo initial "gdsobjcr-03: поиск и, при необходимости, cоздание записи товар на объекте".
     3552     define buffer buf_goods for ub.goods .
     3553     define buffer buf_units for ub.units .
     3554     define buffer buf_dis-thbj-rule  for ub.dis-thbj-rule.
     3555     define buffer buf_batchprocess for ub.batchprocess .
     3556     do
     3557     on error undo, return error return-value
     3558     :
     3559       find first buf_gds-obj no-lock
     3560         where buf_gds-obj.obj-type  = p-obj-type
     3561           and buf_gds-obj.obj-code  = p-obj-code
     3562           and buf_gds-obj.artic     = p-artic
     3563           and buf_gds-obj.prod-type = p-prod-type
     3564           and buf_gds-obj.prod-code = p-prod-code
     3565         no-error .
     3566       if not available buf_gds-obj
     3567       then do:
     3568         do transaction
     3569         on error undo, return error return-value
     3570         :
     3571           run gbl/lockgdoc.p
     3572             (input  p-obj-type
     3573             ,input  p-obj-code
     3574             ,input  'gdoc':U
     3575             ,input  'enable':U
     3576             ,buffer buf_batchprocess
     3577             ) no-error .
     3578           if error-status :error
     3579           then do:
     3580             message
     3581               vss-workfile vss-revision vss-description skip
     3582               "Ошибка при проверке возможности создания записей товара на объекте" skip
     3583               "Объект" p-obj-type p-obj-code skip
     3584               "Артикул" p-artic p-prod-type p-prod-code skip
     3585               error-status :get-message(1) skip
     3586               return-value skip
     3587               view-as alert-box error .
     3588             undo, return error return-value .
     3589           end.
     3590           find first buf_goods share-lock
     3591             where buf_goods.artic     = p-artic
     3592               and buf_goods.prod-type = p-prod-type
     3593               and buf_goods.prod-code = p-prod-code
     3594             no-error .
     3595           if not available buf_goods
     3596           then do:
     3597             message
     3598               "Не найдена запись товара" skip
     3599               "Объект" p-obj-type p-obj-code skip
     3600               "Артикул" p-artic p-prod-type p-prod-code skip
     3601               "Если товар переименован ждите повторной передачи пакета новостей с новым артикулом товара."
     3602               view-as alert-box .
     3603             undo, return error return-value .
     3604           end.
     3605           find first buf_gds-obj exclusive-lock
     3606             where buf_gds-obj.obj-type  = p-obj-type
     3607               and buf_gds-obj.obj-code  = p-obj-code
     3608               and buf_gds-obj.artic     = p-artic
     3609               and buf_gds-obj.prod-type = p-prod-type
     3610               and buf_gds-obj.prod-code = p-prod-code
     3611             no-error .
     3612           if not available buf_gds-obj
     3613           then do:
     3614             create buf_gds-obj.
     3615             assign
     3616               buf_gds-obj.obj-type  = p-obj-type
     3617               buf_gds-obj.obj-code  = p-obj-code
     3618               buf_gds-obj.artic     = p-artic
     3619               buf_gds-obj.prod-type = p-prod-type
     3620               buf_gds-obj.prod-code = p-prod-code
     3621               buf_gds-obj.grp-name  = buf_goods.grp-name
     3622               buf_gds-obj.stts      = buf_goods.stts
     3623               buf_gds-obj.gds-code  = buf_goods.gds-code
     3624             .
     3625             run gds-objh_write-gds-obj-proc in this-procedure ( buffer buf_gds-obj
     3626                                                               ,integer('1':U)
     3627                                                               ,input ''
     3628                                                               ,input '').
     3629   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3631     (input  p-obj-type
     3632     ,input  p-obj-code
     3633     ,output buf_gds-obj.host-code
     3634     ) no-error .
     3635             if error-status :error
     3636             then do:
     3637               message
     3638                 vss-workfile vss-revision vss-description skip
     3639                 "Ошибка при определении кода фирмы для объекта" skip
     3640                 "Объект" p-obj-type p-obj-code skip
     3641                 "Артикул" p-artic p-prod-type p-prod-code skip
     3642                 error-status :get-message(1) skip
     3643                 return-value skip
     3644                 view-as alert-box error .
     3645               undo, return error return-value .
     3646             end.
     3647             define variable v-cur-db-num like ub.db.db-num no-undo .
     3648             define variable v-obj-db-num like ub.db.db-num no-undo .
     3649   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3651     (output v-cur-db-num
     3652     ) no-error .
     3653             if error-status :error
     3654             then do:
     3655               message
     3656                 vss-workfile vss-revision vss-description skip
     3657                 "Ошибка при определении номера текущей БД" skip
     3658                 "Объект" p-obj-type p-obj-code skip
     3659                 error-status :get-message(1) skip
     3660                 return-value skip
     3661                 view-as alert-box error .
     3662               undo, return error return-value .
     3663             end.
     3664   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3666     (input  p-obj-type
     3667     ,input  p-obj-code
     3668     ,output v-obj-db-num
     3669     ) no-error .
     3670             if error-status :error
     3671             then do:
     3672               message
     3673                 vss-workfile vss-revision vss-description skip
     3674                 "Ошибка при определении номера БД объекта" skip
     3675                 "Объект" p-obj-type p-obj-code skip
     3676                 error-status :get-message(1) skip
     3677                 return-value skip
     3678                 view-as alert-box error .
     3679               undo, return error return-value .
     3680             end.
     3681             if v-cur-db-num = v-obj-db-num
     3682             then do:
     3683               define buffer buf_dis-rule for ub.dis-rule.
     3684               define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3685               for each buf_dis-thbj-rule share-lock
     3686                 where buf_dis-thbj-rule.discnt-role = 'dflt-gds-temp-disc':U
     3687                   and buf_dis-thbj-rule.obj-type    = p-obj-type
     3688                   and buf_dis-thbj-rule.obj-code    = p-obj-code
     3689                   and string(buf_dis-thbj-rule.rule-num) = buf_dis-thbj-rule.nonunique,
     3690                   first buf_dis-rule share-lock where
     3691                         buf_dis-rule.rule-num = buf_dis-thbj-rule.rule-num
     3692                     and buf_dis-rule.rule-num = buf_dis-rule.rl-root,
     3693                   first buf_dis-cfg-rule no-lock where
     3694                        buf_dis-cfg-rule.table-name = 'dis-thbj-rule':U
     3695                   and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     3696                   and buf_dis-cfg-rule.link-prop = integer('3':U)
     3697                on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3698                on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3699                on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3700                :
     3701                 run disgdsru-write  in this-procedure (
     3702                     input p-obj-type
     3703                     ,input p-obj-code
     3704                     ,input buf_goods.gds-code
     3705                     ,input buf_dis-thbj-rule.pos-type
     3706                     ,input ?
     3707                     ,input buf_dis-rule.templ-rl-root
     3708                     ,input buf_dis-cfg-rule.time-templ-rl-root
     3709                     ,input buf_dis-rule.rule-num
     3710                     ,input ""
     3711                     ) no-error.
     3712                 if error-status :error
     3713                 then do:
     3714                   message
     3715                     vss-workfile vss-revision vss-description skip
     3716                     "Ошибка при создании скидки товара на объекте" skip
     3717                     "Объект" p-obj-type p-obj-code skip
     3718                     "Артикул" p-artic p-prod-type p-prod-code skip
     3719                     "Код товара" buf_goods.gds-code
     3720                     "Правило скидки" buf_dis-thbj-rule.rule-num
     3721                     error-status :get-message(1) skip
     3722                     return-value skip
     3723                     view-as alert-box error .
     3724                   undo, return error return-value .
     3725                 end.
     3726                 leave.
     3727               end.
     3728             end.
     3729             find buf_units no-lock
     3730               where buf_units.unit-name = buf_goods.unit-base
     3731               no-error .
     3732             if not available buf_units
     3733             then do:
     3734               message
     3735                 vss-workfile vss-revision vss-description skip
     3736                 "Не найдена базовая единица измерения" skip
     3737                 "Объект" p-obj-type p-obj-code skip
     3738                 "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     3739                 "Базовая единица измерения" buf_goods.unit-base skip
     3740                 view-as alert-box error .
     3741               undo, return error return-value .
     3742             end.
     3743             define variable v-cp as logical no-undo .
     3744             v-cp = ?.
     3745             if v-cp = ?
     3746             and lookup('сер':U, buf_units.type) > 0
     3747             then do:
     3748               v-cp = yes.
     3749             end.
     3750             if v-cp = ?
     3751             and (lookup('вес':U, buf_units.type) > 0
     3752             or buf_goods.gds-type = 'у':U) then do:
     3753               v-cp = no.
     3754             end.
     3755             if v-cp = ? then do:
     3756               define variable v-is-petrolium as logical no-undo .
     3757               define variable v-is-pieces as logical no-undo .
     3758   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3759     (
     3760        input p-artic
     3761     ,  input p-prod-type
     3762     ,  input p-prod-code
     3763     , output v-is-petrolium
     3764     , output v-is-pieces
     3765     ) .
     3766               if v-is-petrolium and
     3767               not v-is-pieces then do:
     3768                 v-cp = no.
     3769               end.
     3770             end.
     3771             if v-cp = ? then do:
     3772               define buffer buf_gds-prt for ub.gds-prt.
     3773               FIND FIRST buf_gds-prt No-LOCK WHERE
     3774                     buf_gds-prt.upper-code = buf_goods.prt-root No-ERROR.
     3775               if available buf_gds-prt
     3776               and buf_gds-prt.node-name <> '_Пустая шкала':U  then do:
     3777                 define variable l-doc-prt as logical no-undo .
     3778   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3779   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3780     (input  p-obj-type
     3781     ,input  p-obj-code
     3782     ,input  'doc-prt=request':u
     3783     ,output l-doc-prt
     3784     ) no-error .
     3785               end.
     3786               IF NOT AVAIL buf_gds-prt
     3787               OR (buf_gds-prt.node-name <> '_Пустая шкала':U and l-doc-prt) then do:
     3788                 v-cp = no.
     3789               end.
     3790             end.
     3791             if v-cp = ? then do:
     3792               define variable v-attr-value as character no-undo .
     3793               define variable v-attr-type as character no-undo .
     3794               run gds-attr-value in this-procedure
     3795                 (input  buf_gds-obj.gds-code
     3796                 ,input  'cash-parts':U
     3797                 ,output v-attr-value
     3798                 ,output v-attr-type
     3799                 ) .
     3800               assign
     3801                 v-cp = lookup(v-attr-value, 'true,yes':u) > 0
     3802               .
     3803             end.
     3804             assign
     3805             buf_gds-obj.cash-parts = v-cp
     3806             .
     3807             if  lookup('топ':U,  buf_units.type) > 0
     3808             and lookup('дро':U, buf_units.type) > 0
     3809             then do:
     3810               assign
     3811                 buf_gds-obj.place-rsrv = true
     3812               .
     3813             end.
     3814             if lookup('вес':U, buf_units.type) > 0
     3815             then do:
     3816               run sclcdattr in this-procedure
     3817                 (input  buf_goods.gds-code
     3818                 ,input  p-obj-type
     3819                 ,input  p-obj-code
     3820                 ,input  ?
     3821                 ,input  yes
     3822                 ) no-error.
     3823               if error-status :error
     3824               then do:
     3825                 message
     3826                   vss-workfile vss-revision vss-description skip
     3827                   "Ошибка при создании атрибута ВЕСОВОЙ КОД ТОВАРА НА ОБЪЕКТЕ" skip
     3828                   "Объект" p-obj-type p-obj-code skip
     3829                   "Артикул" p-artic p-prod-type p-prod-code skip
     3830                   "Код товара" buf_goods.gds-code
     3831                   error-status :get-message(1) skip
     3832                   return-value skip
     3833                   view-as alert-box error .
     3834                 undo, return error return-value .
     3835               end.
     3836             end.
     3837             define variable v-exist as logical no-undo .
     3838             run gds-attr-exist in this-procedure ( input buf_gds-obj.gds-code
     3839                                                   ,input  'dflt-insalepr':U
     3840                                                   ,output v-exist).
     3841             if v-exist then do:
     3842               run gds-attr-value in this-procedure
     3843                 (input  buf_gds-obj.gds-code
     3844                 ,input  'dflt-insalepr':U
     3845                 ,output v-attr-value
     3846                 ,output v-attr-type
     3847                 ) .
     3848               buf_gds-obj.insalepr = integer(logical(v-attr-value)).
     3849             end.
     3850             assign
     3851               buf_gds-obj.first-doc = today
     3852               buf_gds-obj.last-doc  = today
     3853             .
     3854             define buffer buf_prt-obj for ub.prt-obj .
     3855             for each buf_prt-obj no-lock
     3856               where buf_prt-obj.obj-type  = p-obj-type
     3857                 and buf_prt-obj.obj-code  = p-obj-code
     3858                 and buf_prt-obj.artic     = p-artic
     3859                 and buf_prt-obj.prod-type = p-prod-type
     3860                 and buf_prt-obj.prod-code = p-prod-code
     3861             on error undo, return error return-value
     3862             :
     3863               if buf_prt-obj.fact-qnty <> 0
     3864               or buf_prt-obj.free-qnty <> 0
     3865               then do:
     3866                 message
     3867                   vss-workfile vss-revision vss-description skip
     3868                   "Ошибка при создании товара на объекте" skip
     3869                   "Уже существует признак на объекте с ненулевыми количествами" skip
     3870                   "Объект" p-obj-type p-obj-code skip
     3871                   "Артикул" p-artic p-prod-type p-prod-code skip
     3872                   "Ссылка на шкалу" buf_prt-obj.prt-code skip
     3873                   "Фактическое количество" buf_prt-obj.fact-qnty skip
     3874                   "Свободное количество" buf_prt-obj.free-qnty skip
     3875                   view-as alert-box error .
     3876                 undo, return error return-value .
     3877               end.
     3878             end.
     3879           end.
     3880         end.
     3881       end.
     3882     end.
     3883   end procedure.
     3884   procedure gohist :
     3885     define input  parameter p-obj-type           as character no-undo .
     3886     define input  parameter p-obj-code           as integer   no-undo .
     3887     define input  parameter p-gds-code           as integer   no-undo .
     3888     define input  parameter p-action-type        as character no-undo .
     3889     define input  parameter p-fact-qnty          as decimal   no-undo .
     3890     define input  parameter p-fact-cli-qnty      as decimal   no-undo .
     3891     define input  parameter p-fact-base          as decimal   no-undo .
     3892     define input  parameter p-fact-rubl          as decimal   no-undo .
     3893     define input  parameter p-fact-sale          as decimal   no-undo .
     3894     define input  parameter p-old-fact-qnty      as decimal   no-undo .
     3895     define input  parameter p-old-fact-cli-qnty  as decimal   no-undo .
     3896     define input  parameter p-old-fact-base      as decimal   no-undo .
     3897     define input  parameter p-old-fact-rubl      as decimal   no-undo .
     3898     define input  parameter p-old-fact-sale      as decimal   no-undo .
     3899     define input  parameter p-source-type        as character no-undo .
     3900     define input  parameter p-source-ref         as character no-undo .
     3901     define input  parameter p-source-date        as date      no-undo .
     3902     define input  parameter p-corr-user-db-num   as integer   no-undo .
     3903     define input  parameter p-corr-user-name     as character no-undo .
     3904     define input  parameter p-corr-date          as date      no-undo .
     3905     define input  parameter p-corr-time          as integer   no-undo .
     3906     define input  parameter p-corr-time-str      as character no-undo .
     3907     define variable v-new-chip-num as integer   no-undo .
     3908     define buffer buf_c-gds-obj for ub.c-gds-obj .
     3909     do
     3910     for buf_c-gds-obj
     3911     transaction
     3912     on error undo, return error return-value
     3913     :
     3914       find last buf_c-gds-obj exclusive-lock
     3915         where buf_c-gds-obj.obj-type = p-obj-type
     3916           and buf_c-gds-obj.obj-code = p-obj-code
     3917           and buf_c-gds-obj.gds-code = p-gds-code
     3918         use-index pi
     3919         no-error .
     3920       if available buf_c-gds-obj
     3921       then do:
     3922         assign
     3923           v-new-chip-num = buf_c-gds-obj.chip-num + 1
     3924         .
     3925       end.
     3926       else do:
     3927         assign
     3928           v-new-chip-num = 1
     3929         .
     3930       end.
     3931       create buf_c-gds-obj .
     3932       assign
     3933         buf_c-gds-obj.obj-type          = p-obj-type
     3934         buf_c-gds-obj.obj-code          = p-obj-code
     3935         buf_c-gds-obj.gds-code          = p-gds-code
     3936         buf_c-gds-obj.chip-num          = v-new-chip-num
     3937         buf_c-gds-obj.action-type       = p-action-type
     3938         buf_c-gds-obj.fact-qnty         = p-fact-qnty
     3939         buf_c-gds-obj.fact-cli-qnty     = p-fact-cli-qnty
     3940         buf_c-gds-obj.fact-base         = p-fact-base
     3941         buf_c-gds-obj.fact-rubl         = p-fact-rubl
     3942         buf_c-gds-obj.fact-sale         = p-fact-sale
     3943         buf_c-gds-obj.old-fact-qnty     = p-old-fact-qnty
     3944         buf_c-gds-obj.old-fact-cli-qnty = p-old-fact-cli-qnty
     3945         buf_c-gds-obj.old-fact-base     = p-old-fact-base
     3946         buf_c-gds-obj.old-fact-rubl     = p-old-fact-rubl
     3947         buf_c-gds-obj.old-fact-sale     = p-old-fact-sale
     3948         buf_c-gds-obj.source-type       = p-source-type
     3949         buf_c-gds-obj.source-ref        = p-source-ref
     3950         buf_c-gds-obj.source-date       = p-source-date
     3951         buf_c-gds-obj.corr-user-db-num  = p-corr-user-db-num
     3952         buf_c-gds-obj.corr-user-name    = p-corr-user-name
     3953         buf_c-gds-obj.corr-date         = p-corr-date
     3954         buf_c-gds-obj.corr-time         = p-corr-time
     3955         buf_c-gds-obj.corr-time-str     = p-corr-time-str
     3956       .
     3957     end.
     3958   end procedure.
     3959   procedure plgohist :
     3960     define input  parameter p-obj-type           as character no-undo .
     3961     define input  parameter p-obj-code           as integer   no-undo .
     3962     define input  parameter p-pl-code            as integer   no-undo .
     3963     define input  parameter p-gds-code           as integer   no-undo .
     3964     define input  parameter p-action-type        as character no-undo .
     3965     define input  parameter p-fact-qnty          as decimal   no-undo .
     3966     define input  parameter p-cli-qnty           as decimal   no-undo .
     3967     define input  parameter p-free-qnty          as decimal   no-undo .
     3968     define input  parameter p-cli-fact-qnty      as decimal   no-undo .
     3969     define input  parameter p-cli-free-qnty      as decimal   no-undo .
     3970     define input  parameter p-old-fact-qnty      as decimal   no-undo .
     3971     define input  parameter p-old-cli-qnty       as decimal   no-undo .
     3972     define input  parameter p-old-free-qnty      as decimal   no-undo .
     3973     define input  parameter p-old-cli-fact-qnty  as decimal   no-undo .
     3974     define input  parameter p-old-cli-free-qnty  as decimal   no-undo .
     3975     define input  parameter p-source-type        as character no-undo .
     3976     define input  parameter p-source-ref         as character no-undo .
     3977     define input  parameter p-source-date        as date      no-undo .
     3978     define input  parameter p-corr-user-db-num   as integer   no-undo .
     3979     define input  parameter p-corr-user-name     as character no-undo .
     3980     define input  parameter p-corr-date          as date      no-undo .
     3981     define input  parameter p-corr-time          as integer   no-undo .
     3982     define input  parameter p-corr-time-str      as character no-undo .
     3983     define variable v-new-chip-num as integer   no-undo .
     3984     define buffer buf_c-pl-gds-obj for ub.c-pl-gds-obj .
     3985     do
     3986     for buf_c-pl-gds-obj
     3987     transaction
     3988     on error undo, return error return-value
     3989     :
     3990       find last buf_c-pl-gds-obj exclusive-lock
     3991         where buf_c-pl-gds-obj.obj-type = p-obj-type
     3992           and buf_c-pl-gds-obj.obj-code = p-obj-code
     3993           and buf_c-pl-gds-obj.gds-code = p-gds-code
     3994           and buf_c-pl-gds-obj.pl-code = p-pl-code
     3995         use-index pi
     3996         no-error .
     3997       if available buf_c-pl-gds-obj
     3998       then do:
     3999         assign
     4000           v-new-chip-num = buf_c-pl-gds-obj.chip-num + 1
     4001         .
     4002       end.
     4003       else do:
     4004         assign
     4005           v-new-chip-num = 1
     4006         .
     4007       end.
     4008       create buf_c-pl-gds-obj .
     4009       assign
     4010         buf_c-pl-gds-obj.obj-type          = p-obj-type
     4011         buf_c-pl-gds-obj.obj-code          = p-obj-code
     4012         buf_c-pl-gds-obj.gds-code          = p-gds-code
     4013         buf_c-pl-gds-obj.pl-code           = p-pl-code
     4014         buf_c-pl-gds-obj.chip-num          = v-new-chip-num
     4015         buf_c-pl-gds-obj.action-type       = p-action-type
     4016         buf_c-pl-gds-obj.fact-qnty         = p-fact-qnty
     4017         buf_c-pl-gds-obj.cli-qnty          = p-cli-qnty
     4018         buf_c-pl-gds-obj.free-qnty         = p-free-qnty
     4019         buf_c-pl-gds-obj.cli-fact-qnty     = p-cli-fact-qnty
     4020         buf_c-pl-gds-obj.cli-free-qnty     = p-cli-free-qnty
     4021         buf_c-pl-gds-obj.old-fact-qnty     = p-old-fact-qnty
     4022         buf_c-pl-gds-obj.old-cli-qnty      = p-old-cli-qnty
     4023         buf_c-pl-gds-obj.old-free-qnty     = p-old-free-qnty
     4024         buf_c-pl-gds-obj.old-cli-fact-qnty = p-old-cli-fact-qnty
     4025         buf_c-pl-gds-obj.old-cli-free-qnty = p-old-cli-free-qnty
     4026         buf_c-pl-gds-obj.source-type       = p-source-type
     4027         buf_c-pl-gds-obj.source-ref        = p-source-ref
     4028         buf_c-pl-gds-obj.source-date       = p-source-date
     4029         buf_c-pl-gds-obj.corr-user-db-num  = p-corr-user-db-num
     4030         buf_c-pl-gds-obj.corr-user-name    = p-corr-user-name
     4031         buf_c-pl-gds-obj.corr-date         = p-corr-date
     4032         buf_c-pl-gds-obj.corr-time         = p-corr-time
     4033         buf_c-pl-gds-obj.corr-time-str     = p-corr-time-str
     4034       .
     4035     end.
     4036   end procedure.
     4037   procedure prtobjcr :
     4038     define input parameter  v-obj-type   like ub.prt-obj.obj-type  no-undo .
     4039     define input parameter  v-obj-code   like ub.prt-obj.obj-code  no-undo .
     4040     define input parameter  v-artic      like ub.prt-obj.artic     no-undo .
     4041     define input parameter  v-prod-type  like ub.prt-obj.prod-type no-undo .
     4042     define input parameter  v-prod-code  like ub.prt-obj.prod-code no-undo .
     4043     define input parameter  v-prt-code   like ub.prt-obj.prt-code  no-undo .
     4044     define parameter buffer buf_prt-obj  for  ub.prt-obj .
     4045     define variable vss-description as character no-undo initial "prtobjcr-02: поиск/создание записи о признаке на объекте".
     4046     find first buf_prt-obj no-lock
     4047       where buf_prt-obj.obj-type  = v-obj-type
     4048         and buf_prt-obj.obj-code  = v-obj-code
     4049         and buf_prt-obj.artic     = v-artic
     4050         and buf_prt-obj.prod-type = v-prod-type
     4051         and buf_prt-obj.prod-code = v-prod-code
     4052         and buf_prt-obj.prt-code  = v-prt-code
     4053       no-error.
     4054     if not available buf_prt-obj
     4055     then do:
     4056       do transaction
     4057       on error undo, return error return-value
     4058       :
     4059         create buf_prt-obj.
     4060         assign
     4061           buf_prt-obj.obj-type  = v-obj-type
     4062           buf_prt-obj.obj-code  = v-obj-code
     4063           buf_prt-obj.artic     = v-artic
     4064           buf_prt-obj.prod-type = v-prod-type
     4065           buf_prt-obj.prod-code = v-prod-code
     4066           buf_prt-obj.prt-code  = v-prt-code
     4067         .
     4068   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjup in g#library
     4069     (buffer buf_prt-obj
     4070     ) no-error .
     4071         if error-status :error
     4072         then do:
     4073           message
     4074             vss-workfile vss-revision vss-description skip
     4075             "Ошибка при обновлении информации в признаке на объекте" skip
     4076             "Объект" v-obj-type v-obj-code skip
     4077             "Артикул" v-artic v-prod-type v-prod-code skip
     4078             "Признак" v-prt-code skip
     4079             error-status :get-message(1) skip
     4080             return-value skip
     4081             view-as alert-box error .
     4082           undo, return error return-value .
     4083         end.
     4084       end.
     4085     end.
     4086   end procedure.
     4087   procedure prtobjup :
     4088     define parameter buffer buf_prt-obj for ub.prt-obj .
     4089     define variable vss-description as character no-undo initial "prtobjup-02: обновление информации в признаке товара на объекте".
     4090     define variable v-root-node     like ub.prt-obj.prt-code no-undo .
     4091     define variable l-terminal-prt  as logical no-undo .
     4092     do
     4093     on error undo, return error return-value
     4094     :
     4095   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4096   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4097     (input  buf_prt-obj.obj-type
     4098     ,input  buf_prt-obj.obj-code
     4099     ,output buf_prt-obj.host-code
     4100     ) no-error .
     4101       if error-status :error
     4102       then do:
     4103         undo, return error
     4104           "Ошибка при определении кода фирмы для объекта"
     4105           .
     4106       end.
     4107       define buffer buf_goods    for ub.goods    .
     4108       find first buf_goods no-lock
     4109         where buf_goods.artic     = buf_prt-obj.artic
     4110           and buf_goods.prod-type = buf_prt-obj.prod-type
     4111           and buf_goods.prod-code = buf_prt-obj.prod-code
     4112         no-error .
     4113       if not available buf_goods
     4114       then do:
     4115         undo, return error
     4116           "Не найден товар"
     4117           .
     4118       end.
     4119       define buffer buf_gds-prt for ub.gds-prt .
     4120       find first buf_gds-prt no-lock
     4121         where buf_gds-prt.node-code = buf_prt-obj.prt-code
     4122         no-error .
     4123       if not available buf_gds-prt
     4124       then do:
     4125         undo, return error
     4126           "Не найден признак"
     4127          .
     4128       end.
     4129       if buf_gds-prt.prt-root <> buf_goods.prt-root
     4130       then do:
     4131         undo, return error
     4132           "Задан код признака из шкалы, которая не принадлежит товару" + chr(10)
     4133           + "Код шкалы товара" + string(buf_goods.prt-root)
     4134           + "Код шкалы признака" + string(buf_gds-prt.prt-root)
     4135           .
     4136       end.
     4137   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4139     (input  buf_prt-obj.artic
     4140     ,input  buf_prt-obj.prod-type
     4141     ,input  buf_prt-obj.prod-code
     4142     ,output v-root-node
     4143     ) no-error .
     4144       if error-status :error
     4145       then do:
     4146         undo, return error
     4147           "Ошибка при определении корня шкалы для товара"
     4148           .
     4149       end.
     4150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4151     (input  buf_prt-obj.prt-code
     4152     ,input  'terminal-prt=request':u
     4153     ,output l-terminal-prt
     4154     ) no-error .
     4155       if error-status :error
     4156       then do:
     4157         undo, return error
     4158           "Ошибка при определении атрибута признака"
     4159           .
     4160       end.
     4161       assign
     4162         buf_prt-obj.is-term = l-terminal-prt
     4163       .
     4164       if  buf_prt-obj.prt-code <> v-root-node
     4165       and l-terminal-prt = false
     4166       then do:
     4167         assign
     4168           buf_prt-obj.price-sale = ?
     4169         .
     4170       end.
     4171       else do:
     4172         define buffer buf_bar-code for ub.bar-code .
     4173         define variable v-is-new as logical no-undo .
     4174   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     4176     (input  buf_goods.gds-code
     4177     ,input  buf_prt-obj.prt-code
     4178     ,input  '':U
     4179     ,input  '':U
     4180     ,input  buf_goods.unit-base
     4181     ,input  1
     4182     ,output v-is-new
     4183     ,buffer buf_bar-code
     4184     ) no-error .
     4185         if error-status :error
     4186         then do:
     4187           undo, return error
     4188             "Ошибка при поиске бар-кода"
     4189             .
     4190         end.
     4191         define variable v-doc-num    like ub.price-list.doc-num    no-undo .
     4192         define variable v-price-sale like ub.price-list.price-sale no-undo .
     4193         define variable v-road-tax   like ub.price-list.road-tax   no-undo .
     4194         define variable v-excise     like ub.price-list.excise     no-undo .
     4195   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4196   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4197     (input  buf_prt-obj.obj-type
     4198     ,input  buf_prt-obj.obj-code
     4199     ,input  buf_bar-code.b-code
     4200     ,input  0
     4201     ,input  0
     4202     ,output v-doc-num
     4203     ,output v-price-sale
     4204     ,output v-road-tax
     4205     ,output v-excise
     4206     ) no-error .
     4207         if error-status :error
     4208         then do:
     4209           undo, return error
     4210             "Ошибка при определение цены признака на объекте"
     4211             .
     4212         end.
     4213         if v-price-sale = ?
     4214         then do:
     4215           assign
     4216             buf_prt-obj.price-sale = 0
     4217           .
     4218         end.
     4219         else do:
     4220           assign
     4221             buf_prt-obj.price-sale = v-price-sale
     4222           .
     4223         end.
     4224       end.
     4225       if buf_prt-obj.fact-qnty = ?
     4226       or buf_prt-obj.free-qnty = ?
     4227       then do:
     4228         undo, return error
     4229           "В признаке на объекте заданы неопределенные количества"
     4230           .
     4231       end.
     4232     end.
     4233   end procedure.
     4234   procedure gdscr :
