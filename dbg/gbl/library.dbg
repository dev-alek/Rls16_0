    11200           .
    11201         end.
    11202         assign
    11203         partax-code = buf_tax-rate.tax-code
    11204         parrate-code = buf_tax-rate.rate-code
    11205         .
    11206         if buf_tax-rate.status_ = 'удал':U
    11207         then do:
