     4296   procedure gdsat :
     4297     do
     4298     on error undo, return error return-value
     4299     :
     4300       define input  parameter p-artic            like ub.goods.artic     no-undo .
     4301       define input  parameter p-prod-type        like ub.goods.prod-type no-undo .
     4302       define input  parameter p-prod-code        like ub.goods.prod-code no-undo .
     4303       define input  parameter p-action           as character            no-undo .
     4304       define output parameter p-return-attribute as logical              no-undo .
     4305       define variable vss-description as character no-undo initial "gdsat-03: Получить атрибут товара".
     4306       define variable ind      as integer   no-undo .
     4307       define variable v-action as character no-undo .
     4308       define buffer buf_goods for ub.goods .
     4309       define buffer buf_units for ub.units .
     4310       for first buf_goods field(gds-code) no-lock
     4311         where buf_goods.artic     = p-artic
     4312           and buf_goods.prod-type = p-prod-type
     4313           and buf_goods.prod-code = p-prod-code:
     4314   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     4315     (input  buf_goods.gds-code
     4316     ,input  p-action
     4317     ,output p-return-attribute
     4318     ) no-error .
     4319         if error-status :error
     4320         then do:
     4321           message
     4322             vss-workfile vss-revision vss-description skip
     4323             "Не найден товар" skip
     4324             "Артикул" p-artic p-prod-type p-prod-code skip
     4325             "Действие" p-action skip
     4326             error-status :get-message(1) skip
     4327             return-value skip
     4328             view-as alert-box error .
     4329           undo, return error return-value .
     4330         end.
     4331       end.
     4332     end.
     4333   end procedure.
     4334   procedure gdscdat :
     4335     do
     4336     on error undo, return error return-value
     4337     :
     4338       define input  parameter p-gds-code         like ub.goods.gds-code  no-undo .
     4339       define input  parameter p-action           as character            no-undo .
     4340       define output parameter p-return-attribute as logical              no-undo .
     4341       define variable vss-description as character no-undo initial "gdscdat-01: Получить атрибут товара".
     4342       define variable ind      as integer   no-undo .
     4343       define variable v-action as character no-undo .
     4344       define buffer buf_goods for ub.goods .
     4345       define buffer buf_units for ub.units .
     4346       find first buf_goods no-lock
     4347         where buf_goods.gds-code = p-gds-code
     4348         no-error .
     4349       if not available buf_goods
     4350       then do:
     4351         message
     4352           vss-workfile vss-revision vss-description skip
     4353           "Не найден товар" skip
     4354           "Код товара" p-gds-code skip
     4355           "Действие" p-action skip
     4356           view-as alert-box error .
     4357         undo, return error return-value .
     4358       end.
     4359       define variable v-num-entries-p-action as integer no-undo .
     4360       assign
     4361         v-num-entries-p-action = num-entries(p-action)
     4362       .
     4363       do ind = 1 to v-num-entries-p-action
     4364       :
     4365         assign
     4366           v-action = entry(ind, p-action)
     4367         .
     4368         case v-action :
     4369           when 'gds-goods=request':u
     4370           then do:
     4371             assign
     4372               p-return-attribute = (buf_goods.gds-type = 'т':U)
     4373             .
     4374           end.
     4375           when 'empty-scale=request':u
     4376           then do:
     4377             define variable v-root-node   like ub.gds-dtl.prt-code no-undo .
     4378             define variable l-empty-scale as logical no-undo .
     4379   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
     4381     (input  p-gds-code
     4382     ,output v-root-node
     4383     ) no-error .
     4384             if error-status :error
     4385             then do:
     4386               message
     4387                 vss-workfile vss-revision vss-description skip
     4388                 "Ошибка при определении корневого признака шкалы" skip
     4389                 "Код товара" p-gds-code skip
     4390                 error-status :get-message(1) skip
     4391                 return-value skip
     4392                 view-as alert-box error .
     4393               undo, return error return-value .
     4394             end.
     4395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4396     (input  v-root-node
     4397     ,input  'empty-scale=request':u
     4398     ,output l-empty-scale
     4399     ) no-error .
     4400             if error-status :error
     4401             then do:
     4402               message
     4403                 vss-workfile vss-revision vss-description skip
     4404                 "Ошибка при определении атрибута шкалы" skip
     4405                 "Код товара" p-gds-code skip
     4406                 "Код признака" v-root-node skip
     4407                 "Запрашивался атрибут" "empty-scale=request" skip
     4408                 error-status :get-message(1) skip
     4409                 return-value skip
     4410                 view-as alert-box error .
     4411               undo, return error return-value .
     4412             end.
     4413             assign
     4414               p-return-attribute = l-empty-scale
     4415             .
     4416           end.
     4417           when 'serial=request':u
     4418           then do:
     4419             find first buf_units no-lock
     4420               where buf_units.unit-name = buf_goods.unit-base
     4421               no-error .
     4422             if not available buf_units
     4423             then do:
     4424               message
     4425                 vss-workfile vss-revision vss-description skip
     4426                 "Не найдена базовая единица измерения" skip
     4427                 "Код товара" p-gds-code skip
     4428                 "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     4429                 "Базовая единица измерения" buf_goods.unit-base skip
     4430                 view-as alert-box .
     4431               undo, return error return-value .
     4432             end.
     4433             assign
     4434               p-return-attribute = (lookup('сер':U, buf_units.type) > 0)
     4435             .
     4436           end.
     4437           when 'twounit=request':u
     4438           then do:
     4439             find buf_units no-lock
     4440               where buf_units.unit-name = buf_goods.unit-base
     4441               no-error .
     4442             if not available buf_units
     4443             then do:
     4444               message
     4445                 vss-workfile vss-revision vss-description skip
     4446                 "Не найдена базовая единица измерения" skip
     4447                 "Код товара" p-gds-code skip
     4448                 "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     4449                 "Базовая единица измерения" buf_goods.unit-base skip
     4450                 view-as alert-box error .
     4451               undo, return error return-value .
     4452             end.
     4453             assign
     4454               p-return-attribute = (lookup('2ед':U, buf_units.type) > 0)
     4455             .
     4456           end.
     4457           when 'bottle=request':u
     4458           then do:
     4459             find buf_units no-lock
     4460               where buf_units.unit-name = buf_goods.unit-base
     4461               no-error .
     4462             if not available buf_units
     4463             then do:
     4464               message
     4465                 vss-workfile vss-revision vss-description skip
     4466                 "Не найдена базовая единица измерения" skip
     4467                 "Код товара" p-gds-code skip
     4468                 "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     4469                 "Базовая единица измерения" buf_goods.unit-base skip
     4470                 view-as alert-box error .
     4471               undo, return error return-value .
     4472             end.
     4473             assign
     4474               p-return-attribute = (lookup('сте':U, buf_units.type) > 0)
     4475             .
     4476           end.
     4477           when 'alcohol-prod=request':u
     4478           then do:
     4479             define variable v-attr-value as character no-undo .
     4480             define variable v-attr-type  as character no-undo .
     4481             run gds-attr-value in this-procedure
     4482               (input  p-gds-code
     4483               ,input  'alcohol-prod':U
     4484               ,output v-attr-value
     4485               ,output v-attr-type
     4486               ) .
     4487             assign
     4488               p-return-attribute = lookup(v-attr-value, 'true,yes':u) > 0
     4489             .
     4490           end.
     4491           when 'mercur_FGIS=request':u
     4492           then do:
     4493             run gds-attr-value in this-procedure
     4494               (input  p-gds-code
     4495               ,input  'mercur_FGIS':U
     4496               ,output v-attr-value
     4497               ,output v-attr-type
     4498               ) .
     4499             assign
     4500               p-return-attribute = lookup(v-attr-value, 'true,yes':u) > 0
     4501             .
     4502           end.
     4503           when 'production-only=request':u
     4504           then do:
     4505             run gds-attr-value in this-procedure
     4506               (input  p-gds-code
     4507               ,input  'production-only':U
     4508               ,output v-attr-value
     4509               ,output v-attr-type
     4510               ) .
     4511             assign
     4512               p-return-attribute = lookup(v-attr-value, 'true,yes':u) > 0
     4513             .
     4514           end.
     4515           otherwise do:
     4516             message
     4517               vss-workfile vss-revision vss-description skip
     4518               "Неизвестный параметр вызова." skip
     4519               "Код товара" p-gds-code skip
     4520               "Список действий" p-action skip
     4521               "Действие" v-action skip
     4522               view-as alert-box error .
     4523             undo, return error return-value .
     4524           end.
     4525         end case .
     4526       end.
     4527     end.
     4528   end procedure.
     4529   procedure gdsobjat :
     4530     define input  parameter p-obj-type         like ub.gds-obj.obj-type  no-undo .
     4531     define input  parameter p-obj-code         like ub.gds-obj.obj-code  no-undo .
     4532     define input  parameter p-artic            like ub.gds-obj.artic     no-undo .
     4533     define input  parameter p-prod-type        like ub.gds-obj.prod-type no-undo .
     4534     define input  parameter p-prod-code        like ub.gds-obj.prod-code no-undo .
     4535     define input  parameter p-action           as character no-undo .
     4536     define output parameter p-return-attribute as logical no-undo .
     4537     define variable vss-description as character no-undo initial "gdsobjat-02: задает/получает признаки товара на объекте".
     4538     define variable ind      as integer no-undo .
     4539     define variable v-action as character no-undo .
     4540     define variable l-find-gds-obj as logical no-undo initial false .
     4541     define buffer buf_gds-obj for ub.gds-obj .
     4542     define variable v-num-entries-p-action as integer no-undo .
     4543     assign
     4544       v-num-entries-p-action = num-entries(p-action)
     4545     .
     4546     do ind = 1 to v-num-entries-p-action
     4547     :
     4548       assign
     4549         v-action = entry(ind, p-action)
     4550       .
     4551       if lookup(v-action, "in-ov=request,inv-on=request,ov-on=request,exist-gds-obj=request") > 0
     4552       then do:
     4553         find first buf_gds-obj no-lock
     4554           where buf_gds-obj.obj-type  = p-obj-type
     4555             and buf_gds-obj.obj-code  = p-obj-code
     4556             and buf_gds-obj.artic     = p-artic
     4557             and buf_gds-obj.prod-type = p-prod-type
     4558             and buf_gds-obj.prod-code = p-prod-code
     4559           no-error .
     4560       end.
     4561       else do:
     4562         if l-find-gds-obj <> true
     4563         then do:
     4564   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4565   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4566     (input  p-obj-type
     4567     ,input  p-obj-code
     4568     ,input  p-artic
     4569     ,input  p-prod-type
     4570     ,input  p-prod-code
     4571     ,buffer buf_gds-obj
     4572     ) no-error .
     4573           if error-status :error
     4574           then do:
     4575             message
     4576               vss-workfile vss-revision vss-description skip
     4577               "Невозможно найти gds-obj" skip
     4578               "p-obj-type"  p-obj-type  skip
     4579               "p-obj-code"  p-obj-code  skip
     4580               "p-artic"     p-artic     skip
     4581               "p-prod-type" p-prod-type skip
     4582               "p-prod-code" p-prod-code skip
     4583               error-status :get-message(1) skip
     4584               return-value skip
     4585               view-as alert-box error .
     4586             undo, return error return-value .
     4587           end.
     4588           assign
     4589             l-find-gds-obj = true
     4590           .
     4591         end.
     4592       end.
     4593       case v-action :
     4594         when "exist-gds-obj=request"
     4595         then do:
     4596           assign
     4597             p-return-attribute = (available buf_gds-obj)
     4598           .
     4599         end.
     4600         when "in-ov=true" or
     4601         when "in-ov=yes"
     4602         then do:
     4603           do transaction
     4604           on error undo, return error return-value
     4605           :
     4606             find current buf_gds-obj exclusive-lock .
     4607             if buf_gds-obj.in-ov <> true
     4608             then do:
     4609               assign
     4610                 buf_gds-obj.in-ov = true
     4611               .
     4612             end.
     4613             assign
     4614               p-return-attribute = buf_gds-obj.in-ov
     4615             .
     4616           end.
     4617         end.
     4618         when "in-ov=false" or
     4619         when "in-ov=no"
     4620         then do:
     4621           do transaction
     4622           on error undo, return error return-value
     4623           :
     4624             find current buf_gds-obj exclusive-lock .
     4625             if buf_gds-obj.in-ov <> false
     4626             then do:
     4627               assign
     4628                 buf_gds-obj.in-ov = false
     4629               .
     4630             end.
     4631             assign
     4632               p-return-attribute = buf_gds-obj.in-ov
     4633             .
     4634           end.
     4635         end.
     4636         when "in-ov=request"
     4637         then do:
     4638           if available buf_gds-obj
     4639           then do:
     4640             assign
     4641               p-return-attribute = buf_gds-obj.in-ov
     4642             .
     4643           end.
     4644           else do:
     4645             assign
     4646               p-return-attribute = false
     4647             .
     4648           end.
     4649         end.
     4650         when "in-ov=request:exclusive"
     4651         then do:
     4652           do transaction
     4653           on error undo, return error return-value
     4654           :
     4655             find current buf_gds-obj exclusive-lock .
     4656             assign
     4657               p-return-attribute = buf_gds-obj.in-ov
     4658             .
     4659           end.
     4660         end.
     4661         when "in-ov=request:share"
     4662         then do:
     4663           do transaction
     4664           on error undo, return error return-value
     4665           :
     4666             find current buf_gds-obj share-lock .
     4667             assign
     4668               p-return-attribute = buf_gds-obj.in-ov
     4669             .
     4670           end.
     4671         end.
     4672         when "inv-on=true" or
     4673         when "inv-on=yes"
     4674         then do:
     4675           do transaction
     4676           on error undo, return error return-value
     4677           :
     4678             find current buf_gds-obj exclusive-lock .
     4679             if buf_gds-obj.inv-on <> true
     4680             then do:
     4681               assign
     4682                 buf_gds-obj.inv-on = true
     4683               .
     4684             end.
     4685             else do:
     4686               message
     4687                 vss-workfile vss-revision vss-description skip
     4688                 "Ошибка при установке признака 'Товар находится в инвентаризации'."
     4689                 "p-obj-type"  p-obj-type  skip
     4690                 "p-obj-code"  p-obj-code  skip
     4691                 "p-artic"     p-artic     skip
     4692                 "p-prod-type" p-prod-type skip
     4693                 "p-prod-code" p-prod-code skip
     4694                 "v-action"    v-action    skip
     4695                 "p-action"    p-action    skip
     4696                 "gds-obj.inv-on" buf_gds-obj.inv-on skip
     4697                 view-as alert-box error .
     4698               undo, return error return-value .
     4699             end.
     4700             assign
     4701               p-return-attribute = buf_gds-obj.inv-on
     4702             .
     4703           end.
     4704         end.
     4705         when "inv-on=false" or
     4706         when "inv-on=no"
     4707         then do:
     4708           do transaction
     4709           on error undo, return error return-value
     4710           :
     4711             find current buf_gds-obj exclusive-lock .
     4712             if buf_gds-obj.inv-on <> false
     4713             then do:
     4714               assign
     4715                 buf_gds-obj.inv-on = false
     4716               .
     4717             end.
     4718             else do:
     4719               message
     4720                 vss-workfile vss-revision vss-description skip
     4721                 "Ошибка при сбрасывании признака 'Товар находится в инвентаризации'."
     4722                 "p-obj-type"  p-obj-type  skip
     4723                 "p-obj-code"  p-obj-code  skip
     4724                 "p-artic"     p-artic     skip
     4725                 "p-prod-type" p-prod-type skip
     4726                 "p-prod-code" p-prod-code skip
     4727                 "v-action"    v-action    skip
     4728                 "p-action"    p-action    skip
     4729                 "gds-obj.inv-on" buf_gds-obj.inv-on skip
     4730                 view-as alert-box error .
     4731               undo, return error return-value .
     4732             end.
     4733             assign
     4734               p-return-attribute = buf_gds-obj.inv-on
     4735             .
     4736           end.
     4737         end.
     4738         when "inv-on=request"
     4739         then do:
     4740           if available buf_gds-obj
     4741           then do:
     4742             assign
     4743               p-return-attribute = buf_gds-obj.inv-on
     4744             .
     4745           end.
     4746           else do:
     4747             assign
     4748               p-return-attribute = false
     4749             .
     4750           end.
     4751         end.
     4752         when "inv-on=request:exclusive"
     4753         then do:
