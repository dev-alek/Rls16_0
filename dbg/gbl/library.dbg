     9429         end.
     9430         when 'ot':U
     9431         then do:
     9432         end.
     9433         when 'ap':U
     9434         then do:
     9435           if  buf_trn-doc.doc-type    = 'инв':U
     9436           and buf_trn-doc.internal    = false
     9437           and buf_trn-doc.discnt-type = ""
     9438           and buf_trn-doc.ret-supp    = false
     9439           then do:
     9440             return .
     9441           end.
     9442         end.
     9443         when 'mp':U
     9444         then do:
     9445           if  buf_trn-doc.doc-type    = 'инв':U
     9446           and buf_trn-doc.internal    = false
     9447           and buf_trn-doc.discnt-type = ""
     9448           and buf_trn-doc.ret-supp    = false
     9449           then do:
     9450             return .
     9451           end.
     9452         end.
     9453         when 'pc':U
     9454         then do:
     9455           if  buf_trn-doc.doc-type    = 'инв':U
     9456           and buf_trn-doc.internal    = false
     9457           and buf_trn-doc.discnt-type = ""
     9458           and buf_trn-doc.ret-supp    = false
     9459           then do:
     9460             return .
     9461           end.
     9462         end.
     9463       end.
     9464       return error substitute(vss-description
     9465         + "Противоречивое состояние полей типа документа." + chr(10)
     9466         + "doc-code &1" + chr(10)
     9467         + "doc-type &2" + chr(10)
     9468         + "internal &3" + chr(10)
     9469         + "discnt-type &4" + chr(10)
     9470         + "ret-supp &5" + chr(10)
     9471         + "status_ &6" + chr(10)
     9472         + "obj-type &7" + chr(10)
     9473         + "obj-code &8" + chr(10)
     9474         + "ext-doc-type &9" + chr(10)
     9475         , buf_trn-doc.doc-code
     9476         , buf_trn-doc.doc-type
     9477         , buf_trn-doc.internal
     9478         , buf_trn-doc.discnt-type
     9479         , buf_trn-doc.ret-supp
     9480         , buf_trn-doc.status_
     9481         , buf_trn-doc.obj-type
     9482         , buf_trn-doc.obj-code
     9483         , buf_trn-doc.ext-doc-type
     9484         ) .
