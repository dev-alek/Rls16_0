     9625   procedure gdsdtlcr :
     9626     define input parameter  v-root-node  like ub.gds-dtl.prt-code no-undo .
     9627     define parameter buffer buf_doc-line for ub.doc-line .
     9628     define parameter buffer buf_gds-dtl  for ub.gds-dtl .
     9629     define variable vss-description as character no-undo initial "gdsdtlcr-02: Создается корневой gds-dtl в накладной на основании строки накладной".
     9630     define buffer buf_trn-doc for ub.trn-doc .
     9631     do
     9632     on error undo, return error return-value
     9633     :
     9634       if v-root-node = ?
     9635       then do:
     9636   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     9638     (input  buf_doc-line.artic
     9639     ,input  buf_doc-line.prod-type
     9640     ,input  buf_doc-line.prod-code
     9641     ,output v-root-node
     9642     ) no-error .
     9643         if error-status :error
     9644         then do:
     9645           message
     9646             vss-workfile vss-revision vss-description skip
     9647             "Ошибка при определении корневого признака шкалы" skip
     9648             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9649             error-status :get-message(1) skip
     9650             return-value skip
     9651             view-as alert-box error .
     9652           undo, return error return-value .
     9653         end.
     9654       end.
     9655       find first buf_gds-dtl
     9656         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     9657           and buf_gds-dtl.artic     = buf_doc-line.artic
     9658           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     9659           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     9660           and buf_gds-dtl.prt-code  = v-root-node
     9661         no-error .
     9662       if not available buf_gds-dtl
     9663       then do:
     9664         find first buf_trn-doc no-lock
     9665           where buf_trn-doc.doc-code = buf_doc-line.doc-code
     9666           no-error .
     9667         if not available buf_trn-doc
     9668         then do:
     9669           message
     9670             vss-workfile vss-revision vss-description skip
     9671             "Не найден документ" skip
     9672             "Документ" buf_doc-line.doc-code skip
     9673             error-status :get-message(1) skip
     9674             view-as alert-box error .
     9675           undo, return error return-value .
     9676         end.
     9677         define variable l-cr-root-gds-dtl as logical no-undo .
     9678   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9680     (input  buf_doc-line.obj-type
     9681     ,input  buf_doc-line.obj-code
     9682     ,input  buf_doc-line.artic
     9683     ,input  buf_doc-line.prod-type
     9684     ,input  buf_doc-line.prod-code
     9685     ,input  'cr-root-gds-dtl=request':U
     9686     ,output l-cr-root-gds-dtl
     9687     ) no-error .
     9688         if error-status :error
     9689         then do:
     9690           message
     9691             vss-workfile vss-revision vss-description skip
     9692             "Ошибка при определении признака товара на объекте" skip
     9693             "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     9694             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9695             "Запрашиваемый атрибут" "cash-parts=request":u skip
     9696             error-status :get-message(1) skip
     9697             return-value skip
     9698             view-as alert-box error .
     9699           undo, return error return-value .
     9700         end.
     9701         if l-cr-root-gds-dtl = false
     9702         then do:
     9703           message
     9704             vss-workfile vss-revision vss-description skip
     9705             "Недопустимо создавать корневой признак в накладной для товара" skip
     9706             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     9707             view-as alert-box error .
     9708           undo, return error return-value .
     9709         end.
     9710         create buf_gds-dtl.
     9711         assign
     9712           buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     9713           buf_gds-dtl.artic     = buf_doc-line.artic
     9714           buf_gds-dtl.prod-code = buf_doc-line.prod-code
     9715           buf_gds-dtl.prod-type = buf_doc-line.prod-type
     9716           buf_gds-dtl.prt-code  = v-root-node
     9717           buf_gds-dtl.obj-type  = buf_doc-line.obj-type
     9718           buf_gds-dtl.obj-code  = buf_doc-line.obj-code
     9719         .
     9720         if buf_trn-doc.ext-doc-type = 'vt':U              or
     9721            buf_trn-doc.ext-doc-type = 'vp':U         or
     9722            buf_trn-doc.ext-doc-type = 'ap':U   or
     9723            buf_trn-doc.ext-doc-type = 'mp':U or
     9724            buf_trn-doc.ext-doc-type = 'pc':U   then do:
     9725           assign
     9726             buf_gds-dtl.doc-qnty  = buf_doc-line.fact-qnty
     9727             buf_gds-dtl.fact-qnty = buf_doc-line.doc-qnty
     9728           .
     9729         end.
     9730         else do:
     9731           assign
     9732             buf_gds-dtl.doc-qnty  = buf_doc-line.doc-qnty
     9733             buf_gds-dtl.fact-qnty = buf_doc-line.fact-qnty
     9734           .
     9735         end.
     9736       end.
     9737     end.
     9738   end procedure.
     9739   procedure trnat :
     9740     define input parameter  p-trn-doc-doc-type     like ub.trn-doc.doc-type     no-undo .
     9741     define input parameter  p-trn-doc-internal     like ub.trn-doc.internal     no-undo .
     9742     define input parameter  p-trn-doc-discnt-type  like ub.trn-doc.discnt-type  no-undo .
     9743     define input parameter  p-trn-doc-status_      like ub.trn-doc.status_      no-undo .
     9744     define input parameter  p-trn-doc-flag         like ub.trn-doc.flag_        no-undo .
     9745     define input parameter  p-trn-doc-ext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     9746     define input  parameter p-action               as   character               no-undo .
     9747     define output parameter p-return-attribute     as   character               no-undo .
     9748     define variable vss-description as character no-undo initial "trnat-01: Задает/получает различные признаки товара на объекте".
     9749     define variable ind      as integer no-undo .
     9750     define variable v-action as character no-undo .
     9751     define variable v-num-entries-p-action as integer no-undo .
     9752     do
     9753     on error undo, return error return-value
     9754     :
     9755       assign
     9756         v-num-entries-p-action = num-entries(p-action)
     9757       .
     9758       do ind = 1 to v-num-entries-p-action
     9759       :
     9760         assign
     9761           v-action = entry(ind, p-action)
     9762         .
     9763         case v-action :
     9764           when "can-change-status-inv-on=request"
     9765           then do:
     9766             if  p-trn-doc-doc-type = 'инв':U
     9767             then do:
     9768               assign
     9769                 p-return-attribute = "true":u
     9770               .
     9771               next .
     9772             end.
     9773             if  p-trn-doc-doc-type = 'при':U
     9774             and p-trn-doc-internal = false
     9775             and p-trn-doc-status_  = 'накл':U
     9776             then do:
     9777               assign
     9778                 p-return-attribute = "true":u
     9779               .
     9780               next .
     9781             end.
     9782             assign
     9783               p-return-attribute = "false":u
     9784             .
     9785           end.
     9786           when "can-edit-inv-on=request":u
     9787           then do:
     9788             if  p-trn-doc-doc-type     = 'инв':U
     9789             and p-trn-doc-ext-doc-type = 'vt':U
     9790             and p-trn-doc-status_      = 'разрешен':U
     9791             and p-trn-doc-flag         = true
     9792             then do:
     9793               assign
     9794                 p-return-attribute = "true":u
     9795               .
     9796               next .
     9797             end.
     9798             if  p-trn-doc-doc-type     = 'инв':U
     9799             and p-trn-doc-ext-doc-type = 'vp':U
     9800             and p-trn-doc-status_      = 'накл':U
     9801             and p-trn-doc-flag         = false
     9802             then do:
     9803               assign
     9804                 p-return-attribute = "true":u
     9805               .
     9806               next .
     9807             end.
     9808             if  p-trn-doc-doc-type     = 'инв':U
     9809             and p-trn-doc-ext-doc-type = 'ap':U
     9810             and p-trn-doc-status_      = 'накл':U
     9811             and p-trn-doc-flag         = false
     9812             then do:
     9813               assign
     9814                 p-return-attribute = "true":u
     9815               .
     9816               next .
     9817             end.
     9818             if  p-trn-doc-doc-type     = 'инв':U
     9819             and p-trn-doc-ext-doc-type = 'mp':U
     9820             and p-trn-doc-status_      = 'накл':U
     9821             and p-trn-doc-flag         = false
     9822             then do:
     9823               assign
     9824                 p-return-attribute = "true":u
     9825               .
     9826               next .
     9827             end.
     9828             if  p-trn-doc-doc-type = 'при':U
     9829             and p-trn-doc-internal = false
     9830             and p-trn-doc-status_  = 'накл':U
     9831             then do:
     9832               assign
     9833                 p-return-attribute = "true":u
     9834               .
     9835               next .
     9836             end.
     9837             assign
     9838               p-return-attribute = "false":u
     9839             .
     9840           end.
     9841           otherwise do:
     9842             message
     9843               vss-workfile vss-revision vss-description skip
     9844               "Неизвестное значение параметра v-action " skip
     9845               "v-action" v-action skip
     9846               "p-action" p-action skip
     9847               view-as alert-box error .
     9848             undo, return error return-value .
     9849           end.
     9850         end.
     9851       end.
     9852     end.
     9853   end procedure.
     9854   procedure qntycalc :
     9855     define input parameter  p-calc-method   as character                   no-undo .
     9856     define input parameter  p-cli-base-rate like ub.doc-line.cli-base-rate no-undo .
     9857     define input parameter  p-cli-qnty      like ub.doc-line.cli-qnty      no-undo .
     9858     define input parameter  p-doc-qnty      like ub.doc-line.doc-qnty      no-undo .
     9859     define output parameter p-new-cli-qnty  like ub.doc-line.cli-qnty      no-undo .
     9860     define output parameter p-new-doc-qnty  like ub.doc-line.doc-qnty      no-undo .
     9861     define variable vss-description as character no-undo initial "qntycalc-01: Пересчет количеств из одной единицы измерения в другую".
     9862     do
     9863     on error undo, return error return-value
     9864     :
     9865       if p-cli-base-rate <= 0
     9866       or p-cli-base-rate = ?
     9867       then do:
     9868         message
     9869           vss-workfile vss-revision vss-description skip
     9870           "Невозможно пересчитать количество при коэффициенте пересчета " skip
     9871           string(p-cli-base-rate) chr(10)
     9872           view-as alert-box error .
     9873         undo, return error
     9874           "Невозможно пересчитать количество при коэффициенте пересчета "
     9875           + string(p-cli-base-rate) + chr(10)
     9876           .
     9877       end.
     9878       define variable v-round-parameter as integer no-undo .
     9879       if p-cli-base-rate = 1
     9880       then do:
     9881         assign
     9882           v-round-parameter = 10
     9883         .
     9884       end.
     9885       else do:
     9886         assign
     9887           v-round-parameter = 3
     9888         .
     9889       end.
     9890       case p-calc-method :
     9891         when "cli-qnty"
     9892         then do:
     9893           if abs(p-doc-qnty - round(p-cli-qnty * p-cli-base-rate, v-round-parameter)) < 0.0011
     9894           then do:
     9895             assign
     9896               p-new-cli-qnty = p-cli-qnty
     9897               p-new-doc-qnty = p-doc-qnty
     9898             .
     9899           end.
     9900           else do:
     9901             assign
     9902               p-new-cli-qnty = round(p-doc-qnty / p-cli-base-rate, v-round-parameter)
     9903             .
     9904             assign
     9905               p-new-doc-qnty = p-doc-qnty
     9906             .
     9907             if abs(p-new-doc-qnty - p-new-cli-qnty * p-cli-base-rate) > 0.001
     9908             then do:
     9909               undo, return error
     9910                 "Невозможно пересчитать количество по документу " + string(p-doc-qnty) + chr(10)
     9911                 + "в количество по ТТН" + chr(10)
     9912                 + "при коэффициенте пересчета " + string(p-cli-base-rate, "->>>,>>9.9999999999") + chr(10)
     9913                 + "p-new-doc-qnty " + string(p-new-doc-qnty) + chr(10)
     9914                 + "p-new-cli-qnty " + string(p-new-cli-qnty) + chr(10)
     9915                 + "p-new-cli-qnty * p-cli-base-rate " + string(p-new-cli-qnty * p-cli-base-rate) + chr(10)
     9916                 .
     9917             end.
     9918           end.
     9919         end.
     9920         when "doc-qnty"
     9921         then do:
     9922           assign
     9923             p-new-cli-qnty = p-cli-qnty
     9924             p-new-doc-qnty = round(p-cli-qnty * p-cli-base-rate, v-round-parameter)
     9925           .
     9926         end.
     9927         otherwise do:
     9928           message
     9929             vss-workfile vss-revision vss-description skip
     9930             "Неизвестное значение парметра" skip
     9931             "p-calc-method" p-calc-method skip
     9932             view-as alert-box error .
     9933           undo, return error return-value .
     9934         end.
     9935       end.
     9936     end.
     9937   end procedure.
     9938   procedure needprts :
     9939     define input  parameter p-ext-doc-type         like ub.trn-doc.ext-doc-type         no-undo .
     9940     define input  parameter p-cli-type             like ub.trn-doc.cli-type             no-undo .
     9941     define input  parameter p-cli-code             like ub.trn-doc.cli-code             no-undo .
     9942     define input  parameter p-hold-doc-code-child  like ub.trn-doc.hold-doc-code-child  no-undo .
     9943     define input  parameter p-hold-doc-code-parent like ub.trn-doc.hold-doc-code-parent no-undo .
     9944     define input  parameter p-status               like ub.trn-doc.status_              no-undo .
     9945     define output parameter p-result               as   character                       no-undo .
     9946     define variable vss-description as character no-undo initial "needprts-01: Определяет способ резервирования партий за документом возврата поставщику".
     9947     define buffer bf_sysconf for ub.sysconf.
     9948     define variable varhold          as character no-undo.
     9949     define variable varhold-type     as character no-undo.
     9950     do for bf_sysconf
     9951     on error undo, return error substitute ("&1 &2", return-value, error-status:get-message(1))
     9952     :
     9953       if p-ext-doc-type <> 'ep':U
     9954       then do:
     9955         assign
     9956           p-result = 'all':u
     9957         .
     9958         return .
     9959       end.
     9960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     9961     (input  'holding':U
     9962     ,input  '':U
     9963     ,input  '':U
     9964     ,input  0
     9965     ,input  '':U
     9966     ,input  '':U
     9967     ,input  '':U
     9968     ,input  true
     9969     ,output varhold
     9970     ,output varhold-type
     9971     )  .
     9972       if lookup(varhold, 'true,yes':u) = 0
     9973       then do:
     9974         assign
     9975           p-result = 'all':u
     9976         .
     9977       end.
     9978       else do:
     9979         if p-cli-type <> 'орг':U
     9980         then do:
     9981           assign
     9982             p-result = 'all':u
     9983           .
     9984         end.
     9985         else do:
     9986           find first bf_sysconf no-lock
     9987             where bf_sysconf.host-code = p-cli-code
     9988             no-error.
     9989           if not available bf_sysconf
     9990           then do:
     9991             assign
     9992               p-result = 'all':u
     9993             .
     9994           end.
     9995           else do:
     9996             if  (p-hold-doc-code-child  = '':u
     9997                  or
     9998                  p-hold-doc-code-child  = 'no-hold':u
     9999                 )
    10000             and (p-hold-doc-code-parent = '':u
    10001                  or
    10002                  p-hold-doc-code-parent = 'no-hold':u
    10003                 )
    10004             then do:
    10005               assign
    10006                 p-result = 'no-hold':u
    10007               .
    10008             end.
    10009             else do:
    10010               assign
    10011                 p-result = 'hold':u
    10012               .
    10013             end.
    10014           end.
    10015         end.
    10016       end.
    10017     end.
    10018   end procedure.
    10019   procedure part-prc :
    10020     define parameter buffer buf_parts               for ub.parts .
    10021     define parameter buffer buf_trn-doc             for ub.trn-doc .
    10022     define input  parameter p-reserv-single-part    as logical   no-undo .
    10023     define input  parameter p-single-part-in-code   as character no-undo .
    10024     define input  parameter p-single-part-part-code as character no-undo .
    10025     define input  parameter p-pl-code               as decimal   no-undo .
    10026     define input  parameter p-goods-twounit         as logical   no-undo .
    10027     define input  parameter p-purch-code-list       as character no-undo .
    10028     define input  parameter p-rsrv-qnty             as decimal   no-undo .
    10029     define input  parameter p-check-negmanuf        as logical   no-undo .
    10030     define output parameter p-reason                as character no-undo .
    10031     define output parameter p-process-part          as logical   no-undo .
    10032     define variable vss-description as character no-undo initial "Проверка возможности резервирования партии".
    10033     define variable v-value-character as character no-undo .
    10034     define variable v-value-date      as date      no-undo .
    10035     define variable v-value-decimal   as decimal   no-undo .
    10036     define variable v-value-integer   as integer   no-undo .
    10037     define variable v-avail-on-date   as logical   no-undo .
    10038     define variable v-avail-on-date-type as character no-undo .
    10039     define variable v-tth             as handle no-undo .
    10040     do
    10041     on error undo, return error return-value
    10042     :
    10043       if not available buf_parts
    10044       then do:
    10045         message
    10046           vss-workfile vss-revision vss-description skip
    10047           "Не задана запись партий"
    10048           view-as alert-box error .
    10049         undo, return error return-value .
    10050       end.
    10051       if not available buf_trn-doc
    10052       then do:
    10053         message
    10054           vss-workfile vss-revision vss-description skip
    10055           "Не задана запись документа"
    10056           view-as alert-box error .
    10057         undo, return error return-value .
    10058       end.
    10059       assign
    10060         p-process-part = true
    10061       .
    10062       define variable v-date-compare as date      no-undo .
    10063       if buf_trn-doc.doc-type = 'рас':U and buf_parts.out-code = 'free-zone':U and
    10064          buf_trn-doc.ext-doc-type <> 'ep':U  then do:
    10065           if  buf_trn-doc.ext-doc-type = 'es':U  then do:
    10066                v-date-compare =  buf_trn-doc.doc-date .
    10067              end.
    10068              else do:
    10069                v-date-compare =  buf_trn-doc.fact-date .
    10070              end.
    10071          if v-date-compare < buf_parts.fact-date then do:
    10072     delete object v-tth no-error.
    10073     run adm/shattri.p (
    10074         input "get":U
    10075         ,input buf_trn-doc.obj-type
    10076         ,input buf_trn-doc.obj-code
    10077         ,input 'nakl_par':U
    10078         ,input  "avail-on-date"
    10079         ,output v-value-character
    10080         ,output v-value-date
    10081         ,output v-value-decimal
    10082         ,output v-value-integer
    10083         ,output v-avail-on-date
    10084         ,output v-avail-on-date-type
    10085         ,INPUT-OUTPUT table-handle v-tth
    10086         ) no-error .
    10087         if error-status :error  then v-avail-on-date = false .
    10088         delete object v-tth no-error.
    10089         if v-avail-on-date = true then do:
    10090               message  substitute("По товару &3 (&4&5)  дата прихода партии &2 позже даты расхода (док.дата &1 и факт.дата &6 ) !!!" ,buf_trn-doc.doc-date , buf_parts.fact-date , buf_parts.artic, buf_parts.prod-type , buf_parts.prod-code ,buf_trn-doc.fact-date) view-as alert-box error .
    10091               p-reason        = substitute("По товару &3 (&4&5)  дата прихода партии &2 позже даты расхода (док.дата &1 и факт.дата &6 ) !!!" ,buf_trn-doc.doc-date , buf_parts.fact-date , buf_parts.artic, buf_parts.prod-type , buf_parts.prod-code ,buf_trn-doc.fact-date) .
    10092               p-process-part  = false.
    10093               return .
    10094          end.
    10095       end.
    10096       end.
    10097       define variable v-rsrv-type as character no-undo .
    10098       run needprts in this-procedure
    10099         (input  buf_trn-doc.ext-doc-type
    10100         ,input  buf_trn-doc.cli-type
    10101         ,input  buf_trn-doc.cli-code
    10102         ,input  buf_trn-doc.hold-doc-code-child
    10103         ,input  buf_trn-doc.hold-doc-code-parent
    10104         ,input  buf_trn-doc.status_
    10105         ,output v-rsrv-type
    10106         ) .
    10107       if v-rsrv-type = 'hold':u
    10108       then do:
    10109         define buffer buf_income_trn-doc for ub.trn-doc .
    10110         find first buf_income_trn-doc no-lock
    10111           where buf_income_trn-doc.doc-code = buf_parts.in-code
    10112           no-error .
    10113         if not available buf_income_trn-doc
    10114         then do:
    10115           assign
    10116             p-reason        = vss-description + ":" + chr(10)
    10117                             + substitute("Не найден документ прихода &1",buf_parts.in-code) + chr(10)
    10118                             + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10119             p-process-part  = false
    10120           .
    10121           return .
    10122         end.
    10123         if buf_income_trn-doc.cli-type <> buf_trn-doc.cli-type
    10124         or buf_income_trn-doc.cli-code <> buf_trn-doc.cli-code
    10125         then do:
    10126           assign
    10127             p-reason        = vss-description + ":" + chr(10)
    10128                             + substitute("Документ прихода &1",buf_income_trn-doc.doc-code) + chr(10)
    10129                             + substitute("Фирма на которую производится межфирменное перемещение &1 &2",buf_trn-doc.cli-type,buf_trn-doc.cli-code) + chr(10)
    10130                             + substitute("Фирма с которой было межфирменное перемещение &1 &2",buf_income_trn-doc.cli-type,buf_income_trn-doc.cli-code) + chr(10)
    10131                             + "Фирмы не совпадают" + chr(10)
    10132                             + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10133             p-process-part  = false
    10134           .
    10135           return .
    10136         end.
    10137         if buf_income_trn-doc.hold-obj-type <> buf_trn-doc.hold-obj-type
    10138         or buf_income_trn-doc.hold-obj-code <> buf_trn-doc.hold-obj-code
    10139         then do:
    10140           assign
    10141             p-reason        = vss-description + ":" + chr(10)
    10142                             + substitute("Документ прихода &1",buf_income_trn-doc.doc-code) + chr(10)
    10143                             + substitute("Объект на который производится межфирменное перемещение &1 &2",buf_trn-doc.hold-obj-type,buf_trn-doc.hold-obj-code) + chr(10)
    10144                             + substitute("Объект с которого было межфирменное перемещение &1 &2",buf_income_trn-doc.hold-obj-type,buf_income_trn-doc.hold-obj-code) + chr(10)
    10145                             + "Объекты не совпадают" + chr(10)
    10146                             + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10147             p-process-part  = false
    10148           .
    10149           return .
    10150         end.
    10151         if buf_trn-doc.hold-doc-code-parent = ""
    10152         then do:
    10153           assign
    10154             p-reason        = vss-description + ":" + chr(10)
    10155                             + substitute("Документ прихода &1",buf_income_trn-doc.doc-code) + chr(10)
    10156                             + "Документ прихода не является документом межфирменного прихода" + chr(10)
    10157                             + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10158             p-process-part  = false
    10159           .
    10160           return .
    10161         end.
    10162       end.
    10163       if p-goods-twounit = true
    10164       then do:
    10165         define variable v-parts-qnty like ub.parts.qnty no-undo .
    10166         case buf_parts.out-code :
    10167           when 'free-zone':U
    10168           then do:
    10169             assign
    10170               v-parts-qnty = buf_parts.qnty
    10171             .
    10172           end.
    10173           when 'out-zone':U
    10174           then do:
    10175             assign
    10176               v-parts-qnty = - buf_parts.qnty
    10177             .
    10178           end.
    10179           when buf_trn-doc.doc-code
    10180           then do:
    10181             if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0
    10182             then do:
    10183               assign
    10184                 v-parts-qnty = - buf_parts.qnty
    10185               .
    10186             end.
    10187             else do:
    10188               assign
    10189                 v-parts-qnty = buf_parts.qnty
    10190               .
    10191             end.
    10192           end.
    10193           otherwise do:
    10194             message
    10195               vss-workfile vss-revision vss-description skip
    10196               "Попытка изменить партию, не принадлежащую документу" skip
    10197               "Партия зарезервирована за документом" buf_parts.out-code skip
    10198               "Текущий документ" buf_trn-doc.doc-code skip
    10199               view-as alert-box error .
    10200             undo, return error return-value .
    10201           end.
    10202         end case .
    10203         if buf_parts.out-code <> buf_parts.in-code
    10204         then do:
    10205           if v-parts-qnty <> - p-rsrv-qnty
    10206           then do:
    10207             assign
    10208               p-reason        = vss-description + ":" + chr(10)
    10209                               + "Для товара с двумя ед.изм. партию можно зарезервировать только целиком" + chr(10)
    10210                               + "Количество в партии" + " " + string(v-parts-qnty) + chr(10)
    10211                               + "Было запрошено количество" + " " + string(p-rsrv-qnty) + chr(10)
    10212                               + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10213               p-process-part  = false
    10214             .
    10215             return .
    10216           end.
    10217         end.
    10218         if buf_parts.cli-qnty <> 1
    10219         then do:
    10220           assign
    10221             p-reason       = vss-description + ":" + chr(10)
    10222                           + "Для товара с двумя ед.изм. количество по клиенту должно быть 1" + chr(10)
    10223                           + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10224             p-process-part = false
    10225           .
    10226           return .
    10227         end.
    10228       end.
    10229       if  p-purch-code-list <> ?
    10230       and p-purch-code-list <> '':u
    10231       then do:
    10232         if lookup(string(buf_parts.purch-code), p-purch-code-list) = 0
    10233         then do:
    10234           define variable v-ind              as integer   no-undo .
    10235           define variable v-purch-code-list  as character no-undo .
    10236           define variable v-parts-purch-code as character no-undo .
    10237           assign
    10238             v-purch-code-list = ""
    10239           .
    10240           do v-ind = 1 to num-entries(p-purch-code-list)
    10241           :
    10242                       assign
    10243               v-purch-code-list = v-purch-code-list
    10244                                 + (if v-purch-code-list <> '':u then ',':u else '':u )
    10245                                 + entry (lookup (entry(v-ind,p-purch-code-list), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
    10246             .
    10247           end.
    10248                   assign
    10249             v-parts-purch-code = entry (lookup (string(buf_parts.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
    10250           .
    10251           assign
    10252             p-reason        = vss-description + ":" + chr(10)
    10253                             + substitute("Задано резервирование по типам приобретения &1", v-purch-code-list) + chr(10)
    10254                             + substitute("Невозможно зарезервировать партию &1 &2", buf_parts.in-code, buf_parts.part-code) + chr(10)
    10255                             + substitute("с типом приобретения &1", v-parts-purch-code)
    10256             p-process-part  = false
    10257           .
    10258           return .
    10259         end.
    10260       end.
    10261       if p-reserv-single-part
    10262       then do:
    10263       define buffer buf_goods for ub.goods  .
    10264       define buffer buf_parts-attr for ub.parts-attr  .
    10265       define variable v-is-ok as logical   no-undo .
    10266       define buffer buf_trn-doc-parts for ub.trn-doc  .
    10267       find first buf_trn-doc-parts no-lock where
    10268                  buf_trn-doc-parts.doc-code = p-single-part-in-code no-error .
    10269        v-is-ok =  false .
    10270         if not available buf_trn-doc-parts then do:
    10271             v-is-ok = true .
    10272         end.
    10273         else do:
    10274           if buf_trn-doc-parts.ext-doc-type <> 'ev':U then v-is-ok = true .
    10275         end.
    10276         if v-is-ok = true then do:
    10277           find first buf_goods no-lock where
    10278                      buf_goods.artic     = buf_parts.artic and
    10279                      buf_goods.prod-type = buf_parts.prod-type and
    10280                      buf_goods.prod-code = buf_parts.prod-code no-error .
    10281           find first buf_parts-attr no-lock where
    10282                      buf_parts-attr.gds-code  = buf_goods.gds-code  and
    10283                      buf_parts-attr.part-code = buf_parts.part-code  and
    10284                      buf_parts-attr.in-code =   buf_parts.in-code no-error .
    10285                       if error-status :error then DO:
    10286                           message
    10287                             vss-workfile vss-revision vss-description skip
    10288                             error-status :get-message(1) skip
    10289                             return-value skip
    10290                             "Нет атрибута партиии "
    10291                             view-as alert-box error
    10292                           .
    10293                           return error return-value .
    10294                       end.
    10295             if buf_parts-attr.orig-in-code   <> p-single-part-in-code
    10296             or buf_parts-attr.orig-part-code <> p-single-part-part-code
    10297             then do:
    10298               assign
    10299                 p-reason       = vss-description + ":" + chr(10)
    10300                               + "Происходит резервирование конкретной партии"
    10301                               + p-single-part-in-code + " " + p-single-part-part-code + chr(10)
    10302                               + "Невозможно зарезервировать партию " +  buf_parts.in-code + " " + buf_parts.part-code
    10303                 p-process-part = false
    10304               .
    10305               return .
    10306             end.
    10307         end.
    10308       end.
    10309       if  p-pl-code <> ?
    10310       and p-pl-code <> 0
    10311       then do:
    10312         if buf_parts.pl-code <> p-pl-code
    10313         then do:
    10314           assign
    10315             p-reason        = vss-description + ":" + chr(10)
    10316                             + substitute("Происходит резервирование партий на складском месте &1", p-pl-code) + chr(10)
    10317                             + substitute("Невозможно зарезервировать партию &1 &2", buf_parts.in-code, buf_parts.part-code) + chr(10)
    10318                             + substitute("со складского места &1", buf_parts.pl-code)
    10319             p-process-part  = false
    10320           .
    10321           return .
    10322         end.
    10323       end.
    10324       if buf_trn-doc.ext-doc-type = 'ep':U
    10325       then do:
    10326         if ( buf_parts.is-supp   = true
    10327             and buf_parts.supp-type = buf_trn-doc.cli-type
    10328             and buf_parts.supp-code = buf_trn-doc.cli-code
    10329           )
    10330         or ( buf_parts.is-supp   = false
    10331           )
    10332         then do:
    10333         end.
    10334         else do:
    10335           assign
    10336             p-reason       = vss-description + ":" + chr(10)
    10337                           + "Для документа расход возврат поставщику" + chr(10)
    10338                           + "Можно резервировать только партии, созданные документом внешнего прихода от поставщика "
    10339                           + string (buf_trn-doc.cli-type) + " " + string(buf_trn-doc.cli-code)
    10340                           + chr(10)
    10341                           + "или созданные другими типами документов"
    10342             p-process-part = false
    10343           .
    10344           return .
    10345         end.
    10346       end.
    10347       if p-check-negmanuf = true
    10348       then do:
    10349         if buf_trn-doc.ext-doc-type = 'wm':U
    10350         or buf_trn-doc.ext-doc-type = 'em':U
    10351         then do:
    10352           if buf_parts.in-code = buf_parts.out-code
    10353           then do:
    10354             define variable conf-par as character no-undo .
    10355   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10356   empty temp-table thbjattr_thbj-attr.
    10357   run adm/shattri.p (
    10358      input "get":U
    10359     ,input buf_trn-doc.obj-type
    10360     ,input buf_trn-doc.obj-code
    10361     ,input 'rezerv-obj':U
    10362     ,input  ""
    10363     ,output v-value-character
    10364     ,output v-value-date
    10365     ,output v-value-decimal
    10366     ,output v-value-integer
    10367     ,output v-value-logical
    10368     ,output par-type
    10369     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10370     ) no-error .
    10371             for each thbjattr_thbj-attr :
    10372                 if thbjattr_thbj-attr.prop-code = 'negmanuf'  then conf-par  = thbjattr_thbj-attr.property-value-character.
    10373             end.
    10374             empty temp-table thbjattr_thbj-attr.
    10375             if conf-par = "disable"
    10376             then do:
    10377               assign
    10378                 p-reason       = vss-description + ":" + chr(10)
    10379                                 + "Для документа списание по производству запрещено порождение партий" + chr(10)
    10380                                 + "Параметр системы negmanuf" + chr(10)
    10381                 p-process-part = false
    10382               .
    10383               return .
    10384             end.
    10385           end.
    10386         end.
    10387       end.
    10388       if  buf_parts.supp-type = buf_trn-doc.obj-type
    10389       and buf_parts.supp-code = buf_trn-doc.obj-code
    10390       then do:
    10391         define variable v-is-hold as logical   no-undo .
    10392   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10393   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    10394     (input  buf_trn-doc.doc-code
    10395     ,output v-is-hold
    10396     )  .
    10397         if buf_trn-doc.ext-doc-type = 'ev':U
    10398         or buf_trn-doc.ext-doc-type = 'eo':U
    10399         or v-is-hold                = true
    10400         then do:
    10401           define buffer negative_parts for ub.parts .
    10402           if buf_trn-doc.ext-doc-type = 'ev':U
    10403           or buf_trn-doc.ext-doc-type = 'eo':U
    10404           then do:
    10405             find first negative_parts no-lock
    10406               where negative_parts.obj-type  = buf_parts.obj-type
    10407                 and negative_parts.obj-code  = buf_parts.obj-code
    10408                 and negative_parts.artic     = buf_parts.artic
    10409                 and negative_parts.prod-type = buf_parts.prod-type
    10410                 and negative_parts.prod-code = buf_parts.prod-code
    10411                 and negative_parts.in-code   = buf_parts.in-code
    10412                 and negative_parts.out-code  = 'out-zone':U
    10413                 and negative_parts.part-code = buf_parts.part-code
    10414               no-error .
    10415             if available negative_parts
    10416             and negative_parts.fact-qnty < 0
    10417             then do:
    10418               assign
    10419                 p-reason       = vss-description + ":" + chr(10)
    10420                                + "Это порожденная партия. Ее нельзя зарезервировать за документом внутреннего перемещения." + chr(10)
    10421                                + "В расходной зоне существует партия с отрицательным количеством"
    10422                 p-process-part = false
    10423               .
    10424               return .
    10425             end.
    10426           end.
    10427           else do:
    10428           end.
    10429         end.
    10430       end.
    10431       return .
    10432     end.
    10433   end procedure.
    10434   procedure gds-code :
    10435     define input  parameter p-artic     like ub.goods.artic     no-undo .
    10436     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
    10437     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
    10438     define output parameter p-gds-code  like ub.goods.gds-code  no-undo .
    10439     define variable vss-description as character no-undo initial "gds-code-01: Поиск кода товара по артикулу и коду производителя".
    10440     define buffer buf_goods    for ub.goods .
    10441     do
    10442     on error undo, return error return-value
    10443     :
    10444       find first buf_goods no-lock
    10445         where buf_goods.artic     = p-artic
    10446           and buf_goods.prod-type = p-prod-type
    10447           and buf_goods.prod-code = p-prod-code
    10448         no-error .
    10449       if not available buf_goods
    10450       then do:
    10451         message
    10452           vss-workfile vss-revision vss-description skip
    10453           "Не найден товар" skip
    10454           "Артикул" p-artic p-prod-type p-prod-code skip
    10455           view-as alert-box error .
    10456         undo, return error return-value  .
    10457       end.
    10458       if buf_goods.gds-code = 0
    10459       or buf_goods.gds-code = ?
    10460       then do:
    10461         message
    10462           vss-workfile vss-revision vss-description skip
    10463           "У товара не задан первичный код" skip
    10464           "Артикул" p-artic p-prod-type p-prod-code skip
    10465           "gds-code" buf_goods.gds-code skip
    10466           view-as alert-box error .
    10467         undo, return error return-value .
    10468       end.
    10469       assign
    10470         p-gds-code = buf_goods.gds-code
    10471       .
    10472     end.
    10473   end procedure.
    10474   procedure arptpc :
    10475     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
    10476     define output parameter p-artic     like ub.goods.artic     no-undo .
    10477     define output parameter p-prod-type like ub.goods.prod-type no-undo .
    10478     define output parameter p-prod-code like ub.goods.prod-code no-undo .
    10479     define variable vss-description as character no-undo initial "arptpc-01: Поиск артикула и кода производителя".
    10480     define buffer buf_goods    for ub.goods .
    10481     do
    10482     on error undo, return error return-value
    10483     :
    10484       if p-gds-code = 0
    10485       or p-gds-code = ?
    10486       then do:
    10487         message
    10488           vss-workfile vss-revision vss-description skip
    10489           "Ошибка задания входных параметров" skip
    10490           "Не задан код товара" skip
    10491           "Код товара" p-gds-code skip
    10492           view-as alert-box error .
    10493         undo, return error return-value .
    10494       end.
    10495       find first buf_goods no-lock
    10496         where buf_goods.gds-code = p-gds-code
    10497         no-error .
    10498       if not available buf_goods
    10499       then do:
    10500         message
    10501           vss-workfile vss-revision vss-description skip
    10502           "Не найден товар" skip
    10503           "Код товара" p-gds-code skip
    10504           view-as alert-box error .
    10505         undo, return error return-value .
    10506       end.
    10507       assign
    10508         p-artic     = buf_goods.artic
    10509         p-prod-type = buf_goods.prod-type
    10510         p-prod-code = buf_goods.prod-code
    10511       .
    10512     end.
    10513   end procedure.
    10514   procedure gds-arnm :
    10515     define input  parameter p-artic     like ub.goods.artic     no-undo .
    10516     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
    10517     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
    10518     define output parameter p-gds-name  like ub.goods.gds-name  no-undo .
    10519     define variable vss-description as character no-undo initial "gds-arnm: Возвращает имя товара по артикулу".
    10520     define buffer buf_goods for ub.goods .
    10521     do
    10522     on error undo, return error return-value
    10523     :
    10524       find first buf_goods no-lock
    10525         where buf_goods.artic     = p-artic
    10526           and buf_goods.prod-type = p-prod-type
    10527           and buf_goods.prod-code = p-prod-code
    10528         no-error .
    10529       if not available buf_goods
    10530       then do:
    10531         message
    10532           vss-workfile vss-revision vss-description skip
    10533           "Не найден товар" skip
    10534           "Артикул" p-artic p-prod-type p-prod-code skip
    10535           view-as alert-box error .
    10536         undo, return error return-value .
    10537       end.
    10538       assign
    10539         p-gds-name = buf_goods.gds-name
    10540       .
    10541     end.
    10542   end procedure.
    10543   procedure gds-cdnm :
    10544     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
    10545     define output parameter p-gds-name  like ub.goods.gds-name  no-undo .
    10546     define variable vss-description as character no-undo initial "gds-cdnm: Возвращает имя товара по коду".
    10547     define buffer buf_goods for ub.goods .
    10548     do
    10549     on error undo, return error return-value
    10550     :
    10551       find first buf_goods no-lock
    10552         where buf_goods.gds-code  = p-gds-code
    10553         no-error .
    10554       if not available buf_goods
    10555       then do:
    10556         message
    10557           vss-workfile vss-revision vss-description skip
    10558           "Не найден товар" skip
    10559           "Код" p-gds-code skip
    10560           view-as alert-box error .
    10561         undo, return error return-value .
    10562       end.
    10563       assign
    10564         p-gds-name = buf_goods.gds-name
    10565       .
    10566     end.
    10567   end procedure.
    10568   procedure basecode :
    10569     define input parameter  p-host-code  like ub.sysconf.host-code     no-undo .
    10570     define output parameter p-base-code  like ub.sysconf.base-code     no-undo .
    10571     define variable vss-description as character no-undo initial "basecode-01: определение кода базовой валюты".
    10572     do
    10573     on error undo, return error return-value
    10574     :
    10575       define buffer buf_sysconf for ub.sysconf .
    10576       find first buf_sysconf no-lock
    10577         where buf_sysconf.host-code = p-host-code
    10578         no-error .
    10579       if not available buf_sysconf
    10580       then do:
    10581         message
    10582           vss-workfile vss-revision vss-description skip
    10583           "Не найдена фирма" skip
    10584           "host-code" p-host-code skip
    10585           view-as alert-box error .
    10586         undo, return error return-value .
    10587       end.
    10588       assign
    10589         p-base-code = buf_sysconf.base-code
    10590       .
    10591     end.
    10592   end procedure.
    10593   procedure consvtpc :
    10594     define input parameter  p-host-code   like ub.sysconf.host-code   no-undo .
    10595     define output parameter p-cons-vat-pc like ub.sysconf.cons-vat-pc no-undo .
    10596     define variable vss-description as character no-undo initial "consvtpc-01: определение налога по консигнации".
    10597     do
    10598     on error undo, return error return-value
    10599     :
    10600       define buffer buf_sysconf for ub.sysconf .
    10601       find first buf_sysconf no-lock
    10602         where buf_sysconf.host-code = p-host-code
    10603         no-error .
    10604       if not available buf_sysconf
    10605       then do:
    10606         message
    10607           vss-workfile vss-revision vss-description skip
    10608           "Не найдена фирма" skip
    10609           "host-code" p-host-code skip
    10610           view-as alert-box error .
    10611         undo, return error return-value .
    10612       end.
    10613       assign
    10614         p-cons-vat-pc = buf_sysconf.cons-vat-pc
    10615       .
    10616     end.
    10617   end procedure.
    10618   procedure baserate :
    10619     define input  parameter p-host-code  like ub.sysconf.host-code     no-undo .
    10620     define input  parameter p-curr-date  as date no-undo .
    10621     define output parameter p-base-rate  like ub.curr-accnt.exch-rate  no-undo .
    10622     define output parameter p-base-scale like ub.curr-accnt.exch-scale no-undo .
    10623     define variable vss-description as character no-undo initial "baserate-01: определение курса базовой валюты".
    10624     define buffer buf_curr-accnt for ub.curr-accnt .
    10625     define buffer buf_currency   for ub.currency .
    10626     define variable v-base-code like ub.sysconf.base-code no-undo .
    10627     do
    10628     on error undo, return error return-value
    10629     :
    10630   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10632     (input  p-host-code
    10633     ,output v-base-code
    10634     ) no-error .
    10635       if error-status :error
    10636       then do:
    10637         undo, return error substitute("Ошибка при определении кода базовой валюты для фирмы &1", p-host-code) .
    10638       end.
    10639       if p-curr-date = ?
    10640       then do:
    10641         find last buf_curr-accnt no-lock
    10642           where buf_curr-accnt.curr-code = v-base-code
    10643           use-index pi
    10644           no-error .
    10645       end.
    10646       else do:
    10647         find last buf_curr-accnt no-lock
    10648           where buf_curr-accnt.curr-code =  v-base-code
    10649             and buf_curr-accnt.exch-date <= p-curr-date
    10650           use-index pi
    10651           no-error .
    10652       end.
    10653       if not available buf_curr-accnt
    10654       then do:
    10655         find first buf_currency no-lock
    10656           where buf_currency.curr-code = v-base-code
    10657           no-error .
    10658         if not available buf_currency
    10659         then do:
    10660           undo, return error substitute("Не найдена базовая валюта &1", v-base-code) .
    10661         end.
    10662         undo, return error substitute("Базовая валюта") + chr(10)
    10663           + substitute("Код &1", buf_currency.curr-code) + chr(10)
    10664           + substitute("Краткое название &1", buf_currency.curr-abbr ) + chr(10)
    10665           + substitute("Название &1", buf_currency.curr-name) + chr(10)
    10666           + substitute("На дату &1 неизвестен курс базовой валюты", string(p-curr-date, "99/99/9999"))
    10667           .
    10668       end.
    10669       assign
    10670         p-base-rate  = buf_curr-accnt.exch-rate
    10671         p-base-scale = buf_curr-accnt.exch-scale
    10672       .
    10673     end.
    10674   end procedure.
    10675   procedure exchrate :
    10676     define input  parameter p-curr-code  like ub.currency.curr-code    no-undo .
    10677     define input  parameter p-curr-date  as date no-undo .
    10678     define output parameter p-exch-rate  like ub.curr-accnt.exch-rate  no-undo .
    10679     define output parameter p-exch-scale like ub.curr-accnt.exch-scale no-undo .
    10680     define output parameter p-curr-abbr  like ub.currency.curr-abbr    no-undo .
    10681     define variable vss-description as character no-undo initial "exchrate-01: определение курса валюты по отношению к национальной".
    10682     define buffer buf_curr-accnt for ub.curr-accnt .
    10683     define buffer buf_currency   for ub.currency .
    10684     do
    10685     on error undo, return error return-value
    10686     :
    10687       find first buf_currency no-lock
    10688         where buf_currency.curr-code = p-curr-code
    10689         no-error .
    10690       if not available buf_currency
    10691       then do:
    10692         undo, return error substitute("Не найдена валюта &1", p-curr-code) .
    10693       end.
    10694       find last buf_curr-accnt no-lock
    10695         where buf_curr-accnt.curr-code =  p-curr-code
    10696           and buf_curr-accnt.exch-date <= p-curr-date
    10697         use-index pi
    10698         no-error .
    10699       if not available buf_curr-accnt
    10700       then do:
    10701         undo, return error substitute("Валюта") + chr(10)
    10702           + substitute("Код &1", buf_currency.curr-code) + chr(10)
    10703           + substitute("Краткое название &1", buf_currency.curr-abbr ) + chr(10)
    10704           + substitute("Название &1", buf_currency.curr-name) + chr(10)
    10705           + substitute("На дату &1 неизвестен курс валюты", string(p-curr-date, "99/99/9999"))
    10706           .
    10707       end.
    10708       assign
    10709         p-exch-rate  = buf_curr-accnt.exch-rate
    10710         p-exch-scale = buf_curr-accnt.exch-scale
    10711         p-curr-abbr  = buf_currency.curr-abbr
    10712       .
    10713     end.
    10714   end procedure.
    10715   procedure curshift :
    10716     define input  parameter p-obj-type   like ub.shift-obj.obj-type   no-undo .
    10717     define input  parameter p-obj-code   like ub.shift-obj.obj-code   no-undo .
    10718     define output parameter p-shift-date like ub.shift-obj.shift-date no-undo .
    10719     define output parameter p-shift-num  like ub.shift-obj.shift-num  no-undo .
    10720     define output parameter p-shift-name like ub.shift-obj.shift-name no-undo.
    10721     define variable vss-description as character no-undo initial "curshift-01: определение текущей смены".
    10722     define buffer buf_shift-obj for ub.shift-obj .
    10723     do
    10724     on error undo, return error return-value
    10725     :
    10726       find first buf_shift-obj
    10727         where buf_shift-obj.obj-type = p-obj-type
    10728           and buf_shift-obj.obj-code = p-obj-code
    10729           and buf_shift-obj.status_ = 'тек':U
    10730         use-index stts
    10731         no-error .
    10732       if not available buf_shift-obj
    10733       then do:
    10734         undo, return error
    10735           "Нет открытой смены на объекте: "
    10736           + string(p-obj-type) + " " + string(p-obj-code) .
    10737       end.
    10738       assign
    10739         p-shift-date = buf_shift-obj.shift-date
    10740         p-shift-num  = buf_shift-obj.shift-num
    10741         p-shift-name = buf_shift-obj.shift-name
    10742       .
    10743     end.
    10744   end procedure.
    10745   procedure lastindc :
    10746     define input  parameter p-host-code  like ub.gds-obj.host-code no-undo .
    10747     define input  parameter p-artic      like ub.gds-obj.artic     no-undo .
    10748     define input  parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
    10749     define input  parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
    10750     define output parameter p-in-code    like ub.gds-obj.in-code   no-undo .
    10751     define output parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
    10752     define output parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
    10753     define variable vss-description as character no-undo initial "lastincd-01: определение объекта на котором был последний приход" .
    10754     define buffer buf_gds-obj for ub.gds-obj .
    10755     define buffer buf_trn-doc for ub.trn-doc .
    10756     do
    10757     on error undo, return error return-value
    10758     :
    10759       assign
    10760         p-in-code  = ""
    10761         p-obj-type = ""
    10762         p-obj-code = 0
    10763       .
    10764       for each buf_gds-obj no-lock
    10765         where buf_gds-obj.host-code = p-host-code
    10766           and buf_gds-obj.artic     = p-artic
    10767           and buf_gds-obj.prod-type = p-prod-type
    10768           and buf_gds-obj.prod-code = p-prod-code
    10769       , first buf_trn-doc no-lock
    10770         where buf_trn-doc.doc-code = buf_gds-obj.in-code
    10771           and buf_trn-doc.status_  = 'факт':U
    10772       by buf_trn-doc.fact-order descending
    10773       on error undo, return error return-value
    10774       :
    10775         assign
    10776           p-in-code  = buf_gds-obj.in-code
    10777           p-obj-type = buf_gds-obj.obj-type
    10778           p-obj-code = buf_gds-obj.obj-code
    10779         .
    10780         leave .
    10781       end.
    10782     end.
    10783   end procedure.
    10784   procedure sclcdattr :
    10785     define input  parameter p-gds-code  like ub.bar-code.gds-code  no-undo .
    10786     define input  parameter p-obj-type  like ub.gds-obj.obj-type   no-undo .
    10787     define input  parameter p-obj-code  like ub.gds-obj.obj-code   no-undo .
    10788     define input  parameter p-b-str     like ub.prod-bc.b-str      no-undo.
    10789     define input  parameter p-overwrite as logical no-undo .
    10790     define variable vss-description as character no-undo initial "sclcdattr-01: создание атрибута ВЕСОВОЙ КОД ТОВАРА НА ОБЪЕКТЕ".
    10791     define variable vss-proc-revision as character no-undo initial "library.p sclcdattr" .
    10792     define buffer buf_bar-code for ub.bar-code .
    10793     define buffer buf_prod-bc for ub.prod-bc .
    10794     define buffer buf_gds-obj for ub.gds-obj .
    10795     define buffer buf_clients for ub.clients .
    10796     define buffer buf_units   for ub.units .
    10797     define buffer buf_db       for ub.db .
    10798     define variable v-db-num    as integer   no-undo .
    10799     define variable v-node-code like ub.bar-code.node-code no-undo .
    10800     define variable v-unit-base like ub.goods.unit-base no-undo .
    10801     define variable p-b-code like ub.bar-code.b-code no-undo .
    10802     define variable v-exist as logical no-undo .
    10803     define variable v-b-str as integer no-undo .
    10804     define variable l-prod-bc-weight as logical no-undo .
    10805     define variable v-nw as logical no-undo .
    10806     do
    10807     on error undo, return error return-value
    10808     :
    10809   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
    10811     (output v-db-num
    10812     ) no-error .
    10813       if error-status :error
    10814       then do:
    10815         message
    10816           vss-workfile vss-revision vss-description skip
    10817           "Ошибка при определении текущей БД" skip
    10818           error-status :get-message(1) skip
    10819           return-value skip
    10820           view-as alert-box error .
    10821         undo, return error return-value .
    10822       end.
    10823       find first buf_db no-lock
    10824         where buf_db.db-num = v-db-num
    10825         no-error .
    10826       if not available buf_db
    10827       then do:
    10828         message
    10829           vss-workfile vss-revision vss-description skip
    10830           "Не найдена запись таблицы базы данных" skip
    10831           "База данных" v-db-num skip
    10832           view-as alert-box error .
    10833         undo, return error return-value .
    10834       end.
    10835   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsrtnod in g#library
    10837     (input  p-gds-code
    10838     ,output v-node-code
    10839     ) no-error .
    10840       if error-status :error
    10841       then do:
    10842         message
    10843           vss-workfile vss-revision vss-description skip
    10844           "Ошибка при определении корневого признака товара" skip
    10845           "Код товара" p-gds-code skip
    10846           error-status :get-message(1) skip
    10847           return-value skip
    10848           view-as alert-box error .
    10849         undo, return error return-value .
    10850       end.
    10851   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
    10853     (input  p-gds-code
    10854     ,output v-unit-base
    10855     ) no-error .
    10856       if error-status :error
    10857       then do:
    10858         message
    10859           vss-workfile vss-revision vss-description skip
    10860           "Ошибка определения базовой единицы измерения товара" skip
    10861           "Код товара" p-gds-code skip
    10862           view-as alert-box error .
    10863         undo, return error return-value .
    10864       end.
    10865       find first buf_units No-LOCK
    10866         where buf_units.unit-name = v-unit-base No-ERROR.
    10867       if not avail buf_units
    10868       then do:
    10869         message
    10870           vss-workfile vss-revision vss-description skip
    10871           "Не найдена базовая единица измерения товара" skip
    10872           "Единица измерения" v-unit-base
    10873           "Код товара" p-gds-code skip
    10874           view-as alert-box error .
    10875         undo, return error return-value .
    10876       end.
    10877       if lookup('вес':U, buf_units.type) = 0
    10878       then do:
    10879         if lookup('шту':U, buf_units.type) > 0 then do:
    10880           v-nw = yes.
    10881         end.
    10882         else do:
    10883         message
    10884           vss-workfile vss-revision vss-description skip
    10885           "Попытка присвоить атрибут товара на  объекте" skip
    10886             "ВЕСОВОЙ КОД невесовому и не штучному товару" skip
    10887           "Код товара" p-gds-code skip
    10888           view-as alert-box error .
    10889         undo, return error return-value .
    10890       end.
    10891       end.
    10892       find first buf_bar-code no-lock
    10893         where buf_bar-code.gds-code  = p-gds-code
    10894           and buf_bar-code.node-code = v-node-code
    10895           and buf_bar-code.part-code = ""
    10896           and buf_bar-code.in-code   = ""
    10897           and buf_bar-code.unit-cli  = v-unit-base
    10898         no-error .
    10899       if not available buf_bar-code
    10900       then do:
    10901         message
    10902           vss-workfile vss-revision vss-description skip
    10903           "Не найден первичный бар-кода признака " skip
    10904           "Код товара" p-gds-code skip
    10905           "Код признака" v-node-code skip
    10906           "Базовая единица измерения" skip
    10907           view-as alert-box error .
    10908         undo, return error return-value .
    10909       end.
    10910       assign
    10911         p-b-code = buf_bar-code.b-code
    10912       .
    10913       _prod-bc:
    10914       for each  buf_prod-bc no-lock
    10915         where buf_prod-bc.b-code = p-b-code
    10916           and buf_prod-bc.bc-on = true
    10917           and (p-b-str = ? or buf_prod-bc.b-str = p-b-str)
    10918        on error undo, return error return-value
    10919        :
    10920         if v-nw then do:
    10921           if (buf_prod-bc.bc-on-type = 'pglc':U) then do:
    10922             leave _prod-bc.
    10923           end.
    10924           else do:
    10925             next _prod-bc.
    10926           end.
    10927         end.
    10928         else do:
    10929   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10931     (buffer buf_prod-bc
    10932     ,input  'weight=request':u
    10933     ,output l-prod-bc-weight
    10934     ) no-error .
    10935         if error-status :error
    10936         then do:
    10937           message
    10938             vss-workfile vss-revision vss-description skip
    10939             "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
    10940             "Основной бар-код" buf_prod-bc.b-code skip
    10941             "Дополнительный бар-код" buf_prod-bc.b-str skip
    10942             "Действие weight=request" skip
    10943             error-status :get-message(1) skip
    10944             return-value skip
    10945             view-as alert-box error .
    10946           undo, return error return-value .
    10947         end.
    10948         if not l-prod-bc-weight
    10949         then do:
    10950           NEXT _prod-bc.
    10951         end.
    10952         ELSE do:
    10953           LEAVE _prod-bc.
    10954         end.
    10955         end.
    10956       END.
    10957       if not avail buf_prod-bc
    10958       then do:
    10959         if p-b-str = ?
    10960         then do:
    10961           error-status:error = false.
    10962           return.
    10963         end.
    10964         else do:
    10965           if v-nw then do:
    10966             message
    10967               vss-workfile vss-revision vss-description skip
    10968               "Не найден штучный код товара для весов" skip
    10969               "Код товара" p-gds-code skip
    10970               "Весовой код" p-b-str skip
    10971               view-as alert-box error .
    10972             undo, return error return-value .
    10973           end.
    10974           else do:
    10975           message
    10976             vss-workfile vss-revision vss-description skip
    10977             "Не найден весовой код товара " skip
    10978             "Код товара" p-gds-code skip
    10979             "Весовой код" p-b-str skip
    10980             view-as alert-box error .
    10981           undo, return error return-value .
    10982         end.
    10983         end.
    10984       END.
    10985       assign
    10986       v-b-str = integer(buf_prod-bc.b-str) no-error.
    10987       if error-status :error or v-b-str = ? or length(buf_prod-bc.b-str) > 6
    10988       then do:
    10989         message
    10990           vss-workfile vss-revision vss-description skip
    10991           "Неверный весовой код " skip
    10992           "Код товара" p-gds-code skip
    10993           "Весовой код" buf_prod-bc.b-str skip
    10994           view-as alert-box error .
    10995         undo, return error return-value .
    10996       end.
    10997       do
    10998       on error undo, return error return-value
    10999       :
    11000         _clients:
    11001         FOR EACH buf_clients No-LOCK WHERE
    11002                 buf_clients.db-num = buf_db.db-num
    11003                 on error undo, return error return-value
    11004                 :
    11005           if p-obj-type <> "" and
    11006             p-obj-code <> 0 and
    11007             (buf_clients.obj-type <> p-obj-type OR
    11008               buf_clients.obj-code <> p-obj-code) then NEXT _Clients.
    11009           FIND FIRST buf_gds-obj no-LOCK WHERE
    11010                     buf_gds-obj.gds-code = p-gds-code AND
    11011                     buf_gds-obj.obj-type = buf_clients.obj-type AND
    11012                     buf_gds-obj.obj-code = buf_clients.obj-code No-ERROR.
    11013           if NOT avail buf_gds-obj then NEXT _clients.
    11014           run gdsoattr-exist in this-procedure (
    11015                                                 input p-gds-code,
    11016                                                 input buf_clients.obj-type,
    11017                                                 input buf_clients.obj-code,
    11018                                                 input 'scales-code':U,
    11019                                                 output v-exist
    11020                                               ) .
    11021           if  v-exist
    11022           and p-overwrite = false
    11023           and (p-obj-type <> "" OR p-obj-code <> 0)
    11024           then do:
    11025             undo, return error vss-proc-revision + ":" + chr(10)
    11026               + "Уже имеется  атрибут  товара  на  объекте  ВЕСОВОЙ  КОД " + chr(10)
    11027               + "Код товара " + string(p-gds-code) + chr(10)
    11028               + "Тип объекта " + string(buf_clients.obj-type) + chr(10)
    11029               + "Код объекта " + string(buf_clients.obj-code) + chr(10)
    11030               .
    11031           end.
    11032           run gdsoattr-write in this-procedure (
    11033                                                 input p-gds-code,
    11034                                                 input buf_clients.obj-type,
    11035                                                 input buf_clients.obj-code,
    11036                                                 input 'scales-code':U,
    11037                                                 input string(v-b-str, "99999")
    11038                                               ) no-error.
    11039           if error-status :error
    11040           then do:
    11041             undo, return error vss-proc-revision + ":" + chr(10)
    11042               + "Ошибка при создания атрибута товара на объекте ВЕСОВОЙ КОД" + chr(10)
    11043               + "Код товара " + string(p-gds-code) + chr(10)
    11044               + "Тип объекта " + string(buf_clients.obj-type) + chr(10)
    11045               + "Код объекта " + string(buf_clients.obj-code) + chr(10)
    11046               + "Значение атрибута " + string(v-b-str, "99999") + chr(10)
    11047               .
    11048           end.
    11049         END.
    11050       END.
    11051     end.
    11052   end procedure.
    11053   procedure pftaxval :
    11054     define input  parameter par-rc       as recid     no-undo .
    11055     define input  parameter partax-code  like ub.tax.tax-code no-undo .
    11056     define input  parameter parrate-code like ub.tax-rate.rate-code no-undo .
    11057     define input  parameter par-date     as date      no-undo .
    11058     define input  parameter parhost-code like ub.sysconf.host-code no-undo .
    11059     define input  parameter parobj-type  like ub.clients.obj-type no-undo .
    11060     define input  parameter parobj-code  like ub.clients.obj-code no-undo .
    11061     define output parameter partax-value as decimal no-undo initial ?.
    11062     define variable vss-description as character no-undo initial "pftaxval: Значение по ставке налога в заданный момент  времени для заданного объекта и фирмы".
    11063     define variable v-fact-order as decimal no-undo .
    11064     define buffer buf_tax-rate for ub.tax-rate.
    11065     define buffer buf_tax-rate-value for ub.tax-rate-value.
    11066     define buffer buf_tax-rate-attr for ub.tax-rate-attr .
    11067     do
    11068     on error undo, return error return-value
    11069     :
    11070       if par-date = ?
    11071       then do:
    11072         assign
    11073           par-date = today
    11074         .
    11075       end.
    11076       run factord-end-day in this-procedure
    11077         (input  par-date
    11078         ,output v-fact-order
    11079         ).
    11080       if partax-code  = 0
    11081       or parrate-code = 0
    11082       then do:
    11083         find first buf_tax-rate no-lock
    11084           where recid(buf_tax-rate) = par-rc
    11085           no-error .
    11086         if not available buf_tax-rate
    11087         then do:
    11088           assign
    11089             partax-value = ?
    11090           .
    11091           undo, return error
    11092           "Не найдена ставка налога "
    11093           + "recid " + string(par-rc)
    11094           .
    11095         end.
    11096         assign
    11097         partax-code = buf_tax-rate.tax-code
    11098         parrate-code = buf_tax-rate.rate-code
    11099         .
    11100         if buf_tax-rate.status_ = 'удал':U
    11101         then do:
    11102           partax-value = ?.
    11103           undo, return error
    11104           "Ставка налога недействительна "
    11105           + "налог: " + string(buf_tax-rate.tax-code) + " ставка: " + string(buf_tax-rate.rate-code) .
    11106         end.
    11107       END.
    11108       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11109                   buf_tax-rate-value.tax-code  = partax-code  AND
    11110                   buf_tax-rate-value.rate-code = parrate-code AND
    11111                   buf_tax-rate-value.host-code = parhost-code AND
    11112                   buf_tax-rate-value.obj-type = parobj-type AND
    11113                   buf_tax-rate-value.obj-code = parobj-code AND
    11114                   buf_tax-rate-value.fact-order <= v-fact-order AND
    11115                   buf_tax-rate-value.status_ <> 'удал':U
    11116                   NO-ERROR.
    11117       if avail buf_tax-rate-value
    11118       then do:
    11119         find first buf_tax-rate-attr no-lock where buf_tax-rate-attr.tax-code = integer('1':U)
    11120         and buf_tax-rate-attr.attr-code = "envd" and buf_tax-rate-attr.rate-code = buf_tax-rate-value.rate-code no-error .
    11121         if available (buf_tax-rate-attr) then partax-value = -1 .
    11122         else partax-value = buf_tax-rate-value.rate-value.
    11123         return.
    11124       end.
    11125       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11126                   buf_tax-rate-value.tax-code  = partax-code  AND
    11127                   buf_tax-rate-value.rate-code = parrate-code AND
    11128                   buf_tax-rate-value.host-code = parhost-code AND
    11129                   buf_tax-rate-value.obj-type = "" AND
    11130                   buf_tax-rate-value.obj-code = 0 AND
    11131                   buf_tax-rate-value.fact-order <= v-fact-order AND
    11132                   buf_tax-rate-value.status_ <> 'удал':U
    11133                   NO-ERROR.
    11134       if avail buf_tax-rate-value
    11135       then do:
    11136         find first buf_tax-rate-attr no-lock where buf_tax-rate-attr.tax-code = integer('1':U)
    11137         and buf_tax-rate-attr.attr-code = "envd" and buf_tax-rate-attr.rate-code = buf_tax-rate-value.rate-code no-error .
    11138         if available (buf_tax-rate-attr) then partax-value = -1 .
    11139         else partax-value = buf_tax-rate-value.rate-value.
    11140         return.
    11141       end.
    11142       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11143                   buf_tax-rate-value.tax-code  = partax-code  AND
    11144                   buf_tax-rate-value.rate-code = parrate-code AND
    11145                   buf_tax-rate-value.host-code = 0 AND
    11146                   buf_tax-rate-value.obj-type = "" AND
    11147                   buf_tax-rate-value.obj-code = 0 AND
    11148                   buf_tax-rate-value.fact-order <= v-fact-order AND
    11149                   buf_tax-rate-value.status_ <> 'удал':U
    11150                   NO-ERROR.
    11151       if avail buf_tax-rate-value
    11152       then do:
    11153         find first buf_tax-rate-attr no-lock where buf_tax-rate-attr.tax-code = integer('1':U)
    11154         and buf_tax-rate-attr.attr-code = "envd" and buf_tax-rate-attr.rate-code = buf_tax-rate-value.rate-code no-error .
    11155         if available (buf_tax-rate-attr) then partax-value = -1 .
    11156         else partax-value = buf_tax-rate-value.rate-value.
    11157         return.
    11158       end.
    11159     end.
    11160   end procedure.
    11161   procedure pftaxvlx :
    11162     define input  parameter par-rc       as recid     no-undo .
