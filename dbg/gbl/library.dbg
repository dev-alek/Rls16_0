     4765           do transaction
     4766           on error undo, return error return-value
     4767           :
     4768             find current buf_gds-obj exclusive-lock .
     4769             assign
     4770               p-return-attribute = buf_gds-obj.inv-on
     4771             .
     4772           end.
     4773         end.
     4774         when "ov-on=true" or
     4775         when "ov-on=yes"
     4776         then do:
     4777           do transaction
     4778           on error undo, return error return-value
     4779           :
     4780             find current buf_gds-obj exclusive-lock .
     4781             if buf_gds-obj.ov-on <> true
     4782             then do:
     4783               assign
     4784                 buf_gds-obj.ov-on = true
     4785               .
     4786             end.
     4787             else do:
