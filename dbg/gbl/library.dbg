     2913   define input  parameter p-upper-code     as character no-undo .
     2914   define input  parameter p-code           as character no-undo .
     2915   define output parameter p-label          as character no-undo .
     2916   define output parameter p-user-can-edit  as logical   no-undo .
     2917   define output parameter p-output-display as logical   no-undo .
