     6297           + "Код товара " + string(p-gds-code) + chr(10)
     6298           + "Код признака " + string(p-node-code) + chr(10)
     6299           + "Код ПН " + string(p-in-code) + chr(10)
     6300           + "Код партии " + string(p-part-code) + chr(10)
     6301           + "Базовая единица измерения " + string(v-unit-base) + chr(10)
     6302           .
     6303       end.
     6304     end.
     6305   end procedure.
     6306   procedure partbcod :
     6307     define parameter buffer buf_parts   for ub.parts .
     6308     define output parameter p-b-code    like ub.bar-code.b-code    no-undo .
     6309     define variable vss-description as character no-undo initial "partbcod-01: определение первичного бар-кода признака".
     6310     define variable vss-proc-revision as character no-undo initial "library.p partbcod-01" .
     6311     define buffer buf_goods    for ub.goods .
     6312     define buffer buf_bar-code for ub.bar-code .
     6313     define variable v-root-node like ub.prt-obj.prt-code no-undo .
     6314     do
     6315     on error undo, return error return-value
     6316     :
     6317       find first buf_goods no-lock
     6318         where buf_goods.artic     = buf_parts.artic
     6319           and buf_goods.prod-type = buf_parts.prod-type
     6320           and buf_goods.prod-code = buf_parts.prod-code
     6321         no-error .
     6322       if not available buf_goods
     6323       then do:
     6324         message
     6325           vss-workfile vss-revision vss-description skip
     6326           "Не найден товар" skip
     6327           "Артикул товара" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6328           "Код партии" recid(buf_parts) skip
     6329           view-as alert-box error .
     6330         undo, return error return-value .
     6331       end.
     6332       run prt-root-to-node-code in this-procedure
     6333         (input  buf_goods.prt-root
     6334         ,output v-root-node
     6335         ) no-error .
     6336       if error-status :error
     6337       then do:
     6338         message
     6339           vss-workfile vss-revision vss-description skip
     6340           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     6341           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     6342           "Указатель на корень шкалы" buf_goods.prt-root skip
     6343           error-status :get-message(1) skip
     6344           return-value skip
     6345           view-as alert-box error .
     6346         undo, return error return-value .
     6347       end.
     6348       find first buf_bar-code no-lock
     6349         where buf_bar-code.gds-code  = buf_goods.gds-code
     6350           and buf_bar-code.node-code = v-root-node
     6351           and buf_bar-code.part-code = buf_parts.part-code
     6352           and buf_bar-code.in-code   = buf_parts.in-code
     6353           and buf_bar-code.unit-cli  = buf_goods.unit-base
     6354         no-error .
     6355       if not available buf_bar-code
     6356       then do:
     6357         undo, return error vss-proc-revision + ":" + chr(10)
     6358           + "Не найден первичный бар-код партии " + chr(10)
     6359           + "Код товара " + string(buf_goods.gds-code) + chr(10)
     6360           + "Код признака " + string(v-root-node) + chr(10)
     6361           + "Код партии " + string(buf_parts.part-code) + chr(10)
     6362           + "Код ПН " + string(buf_parts.in-code) + chr(10)
     6363           + "Базовая единица измерения " + string(buf_goods.unit-base) + chr(10)
     6364           .
     6365       end.
     6366       assign
     6367         p-b-code = buf_bar-code.b-code
     6368       .
     6369     end.
     6370   end procedure.
     6371   procedure barcodcr :
     6372     define input  parameter p-gds-code      like ub.bar-code.gds-code      no-undo .
     6373     define input  parameter p-node-code     like ub.bar-code.node-code     no-undo .
     6374     define input  parameter p-part-code     like ub.bar-code.part-code     no-undo .
     6375     define input  parameter p-in-code       like ub.bar-code.in-code       no-undo .
     6376     define input  parameter p-unit-cli      like ub.bar-code.unit-cli      no-undo .
     6377     define input  parameter p-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     6378     define output parameter p-is-new        as logical                     no-undo .
     6379     define parameter buffer buf_bar-code for ub.bar-code .
     6380     define variable vss-description as character no-undo initial "barcodcr-03: поиск/создание бар-кода" .
     6381     define variable v-new-b-code like ub.bar-code.b-code no-undo .
     6382     define variable v-unit-base  like ub.goods.unit-base no-undo .
     6383     do
     6384     on error undo, return error return-value
     6385     :
     6386       assign
     6387         p-is-new = false
     6388       .
     6389       find first buf_bar-code no-lock
     6390         where buf_bar-code.gds-code  = p-gds-code
     6391           and buf_bar-code.node-code = p-node-code
     6392           and buf_bar-code.part-code = p-part-code
     6393           and buf_bar-code.in-code   = p-in-code
     6394           and buf_bar-code.unit-cli  = p-unit-cli
     6395         no-error .
     6396       if not available buf_bar-code
     6397       then do
     6398       transaction
     6399       on error undo, return error return-value
     6400       :
     6401         run gen-b-code in this-procedure
     6402           ( input 'bcgb':U,
     6403             output v-new-b-code
     6404           ) no-error .
     6405         if error-status :error
     6406         then do:
     6407           message
     6408             vss-workfile vss-revision vss-description skip
     6409             "Ошибка при получении номера бар-кода" skip
     6410             error-status :get-message(1) skip
     6411             return-value skip
     6412             view-as alert-box error .
     6413           undo, return error return-value .
     6414         end.
     6415   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     6417     (input  p-gds-code
     6418     ,output v-unit-base
     6419     ) no-error .
     6420         if error-status :error
     6421         then do:
     6422           message
     6423             vss-workfile vss-revision vss-description skip
     6424             "Ошибка определения базовой единицы измерения товара" skip
     6425             "Код товара" p-gds-code skip
     6426             view-as alert-box error .
     6427           undo, return error return-value .
     6428         end.
     6429         if p-unit-cli = v-unit-base
     6430         then do:
     6431           assign
     6432             p-cli-base-rate = 1
     6433           .
     6434         end.
     6435         if p-cli-base-rate = ?
     6436         or p-cli-base-rate = 0
     6437         then do:
     6438           message
     6439             vss-workfile vss-revision vss-description skip
     6440             "Ошибка задания входных параметров" skip
     6441             "Не задана коэффициент преобразования из одной единицы измерения в другую" skip
     6442             "Код товара" p-gds-code skip
     6443             "p-unit-cli" p-unit-cli skip
     6444             "v-unit-base" v-unit-base skip
     6445             "p-cli-base-rate" p-cli-base-rate skip
     6446             view-as alert-box error .
     6447           undo, return error return-value .
     6448         end.
     6449         assign
     6450           p-is-new = true
     6451         .
     6452         create buf_bar-code .
     6453         assign
     6454           buf_bar-code.b-code        = v-new-b-code
     6455           buf_bar-code.gds-code      = p-gds-code
     6456           buf_bar-code.node-code     = p-node-code
     6457           buf_bar-code.part-code     = p-part-code
     6458           buf_bar-code.in-code       = p-in-code
     6459           buf_bar-code.unit-cli      = p-unit-cli
     6460           buf_bar-code.cli-base-rate = p-cli-base-rate
     6461         .
     6462       end.
     6463       else do:
     6464         if buf_bar-code.stts_ = integer('99':U)
     6465         then do:
     6466           undo, return error substitute("бар-код &1 для товара &2 помечен к удалению", buf_bar-code.b-code, p-gds-code).
     6467         end.
     6468       end.
     6469     end.
     6470   end procedure.
     6471   procedure bcodeprc :
     6472     define input parameter  v-obj-type    like ub.price-list.obj-type   no-undo .
     6473     define input parameter  v-obj-code    like ub.price-list.obj-code   no-undo .
     6474     define input parameter  v-b-code      like ub.bar-code.b-code       no-undo .
     6475     define input parameter  v-root-b-code like ub.bar-code.b-code       no-undo .
     6476     define input parameter  v-fact-order  like ub.price-doc.fact-order  no-undo .
     6477     define output parameter v-doc-num     like ub.price-list.doc-num    no-undo .
     6478     define output parameter v-price-sale  like ub.price-list.price-sale no-undo .
     6479     define output parameter v-road-tax    like ub.price-list.road-tax   no-undo .
     6480     define output parameter v-excise      like ub.price-list.excise     no-undo .
     6481     define variable v-price-list-recid as recid no-undo .
     6482     define variable v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
     6483     define variable vss-description as character no-undo initial "bcodeprc-03: получение продажной цены товара (признака)".
     6484     define buffer buf_price-list      for ub.price-list .
     6485     do
     6486     on error undo, return error return-value
     6487     :
     6488   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6489   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     6490     (input  v-obj-type
     6491     ,input  v-obj-code
     6492     ,input  v-b-code
     6493     ,input  v-root-b-code
     6494     ,input  v-fact-order
     6495     ,output v-price-list-recid
     6496     ,output v-cli-base-rate
     6497     )  .
     6498       if v-price-list-recid = ?
     6499       then do:
     6500         assign
     6501           v-doc-num    = ?
     6502           v-price-sale = ?
     6503           v-road-tax   = ?
     6504           v-excise     = ?
     6505         .
     6506       end.
     6507       else do:
     6508         find first buf_price-list no-lock
     6509           where recid(buf_price-list) = v-price-list-recid
     6510           .
     6511         assign
     6512           v-doc-num    = buf_price-list.doc-num
     6513           v-price-sale = buf_price-list.price-sale * v-cli-base-rate
     6514           v-road-tax   = buf_price-list.road-tax   * v-cli-base-rate
     6515           v-excise     = buf_price-list.excise     * v-cli-base-rate
     6516         .
     6517       end.
     6518     end.
     6519   end procedure.
     6520   procedure bcprcex :
     6521     define input  parameter v-obj-type    like ub.price-list.obj-type   no-undo .
     6522     define input  parameter v-obj-code    like ub.price-list.obj-code   no-undo .
     6523     define input  parameter v-b-code      like ub.bar-code.b-code       no-undo .
     6524     define input  parameter v-root-b-code like ub.bar-code.b-code       no-undo .
     6525     define input  parameter v-fact-order  like ub.price-doc.fact-order  no-undo .
     6526     define output parameter v-doc-num     like ub.price-list.doc-num    no-undo .
     6527     define output parameter v-price-sale  like ub.price-list.price-sale no-undo .
     6528     define output parameter v-road-tax    like ub.price-list.road-tax   no-undo .
     6529     define output parameter v-excise      like ub.price-list.excise     no-undo .
     6530     define output parameter v-VAT-pc      like ub.price-list.VAT-pc     no-undo .
     6531     define output parameter v-SLT-pc      like ub.price-list.SLT-pc     no-undo .
     6532     define variable v-price-list-recid as recid no-undo .
     6533     define variable v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
     6534     define variable vss-description as character no-undo initial "bcprcex-01: получение продажной цены бар-кода с налогами".
     6535     define buffer buf_price-list      for ub.price-list .
     6536     do
     6537     on error undo, return error return-value
     6538     :
     6539   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     6541     (input  v-obj-type
     6542     ,input  v-obj-code
     6543     ,input  v-b-code
     6544     ,input  v-root-b-code
     6545     ,input  v-fact-order
     6546     ,output v-price-list-recid
     6547     ,output v-cli-base-rate
     6548     )  .
     6549       if v-price-list-recid = ?
     6550       then do:
     6551         assign
     6552           v-doc-num    = ?
     6553           v-price-sale = ?
     6554           v-road-tax   = ?
     6555           v-excise     = ?
     6556           v-VAT-pc     = ?
     6557           v-SLT-pc     = ?
     6558         .
     6559       end.
     6560       else do:
     6561         find first buf_price-list no-lock
     6562           where recid(buf_price-list) = v-price-list-recid
     6563           .
     6564         assign
     6565           v-doc-num    = buf_price-list.doc-num
     6566           v-price-sale = buf_price-list.price-sale * v-cli-base-rate
     6567           v-road-tax   = buf_price-list.road-tax   * v-cli-base-rate
     6568           v-excise     = buf_price-list.excise     * v-cli-base-rate
     6569           v-VAT-pc     = buf_price-list.VAT-pc
     6570           v-SLT-pc     = buf_price-list.SLT-pc
     6571         .
     6572       end.
     6573     end.
     6574   end procedure.
     6575   procedure bcodepls :
     6576     define input  parameter v-obj-type         like ub.price-list.obj-type    no-undo .
     6577     define input  parameter v-obj-code         like ub.price-list.obj-code    no-undo .
     6578     define input  parameter v-b-code           like ub.bar-code.b-code        no-undo .
     6579     define input  parameter v-root-b-code      like ub.bar-code.b-code        no-undo .
     6580     define input  parameter v-fact-order       like ub.price-doc.fact-order   no-undo .
     6581     define output parameter v-recid-price-list as recid                       no-undo .
     6582     define output parameter v-cli-base-rate    like ub.bar-code.cli-base-rate no-undo .
     6583     define variable vss-description as character no-undo initial "bcodepls-01: записи продажной цены признака".
     6584     define buffer buf_root_bar-code   for ub.bar-code .
     6585     define buffer buf_bar-code        for ub.bar-code .
     6586     define buffer buf_root_price-list for ub.price-list .
     6587     define buffer buf_price-list      for ub.price-list .
     6588     define buffer buf_main_bar-code   for ub.bar-code .
     6589     define variable  v-is-parts as logical   no-undo .
     6590     do
     6591     on error undo, return error return-value
     6592     :
     6593       find first buf_bar-code no-lock
     6594         where buf_bar-code.b-code = v-b-code
     6595         no-error .
     6596       if not available buf_bar-code
     6597       then do:
     6598         message
     6599           vss-workfile vss-revision vss-description skip
     6600           "Ошибка при задании входных параметров" skip
     6601           "Не найден бар-код" v-b-code skip
     6602           view-as alert-box error .
     6603         undo, return error return-value .
     6604       end.
     6605       assign
     6606         v-cli-base-rate = buf_bar-code.cli-base-rate
     6607       .
     6608       if v-fact-order = ?
     6609       then do:
     6610         message
     6611           vss-workfile vss-revision vss-description skip
     6612           "Ошибка при задании входных параметров" skip
     6613           "Должен быть задан порядковый номер документа" skip
     6614           "Для определения текущей цены он должен быть равен 0" skip
     6615           "Порядковый номер документа" v-fact-order skip
     6616           view-as alert-box error .
     6617         undo, return error return-value .
     6618       end.
     6619       if v-root-b-code = ?
     6620       then do:
     6621         message
     6622           vss-workfile vss-revision vss-description skip
     6623           "Ошибка при задании входных параметров" skip
     6624           "Должен быть задан бар-код корневого признака" skip
     6625           "Или он должен быть равен 0" skip
     6626           "Бар-код корневого признака" v-root-b-code skip
     6627           view-as alert-box error .
     6628         undo, return error return-value .
     6629       end.
     6630       if v-root-b-code = 0
     6631       then do:
     6632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6633     (input  buf_bar-code.gds-code
     6634     ,input  ?
     6635     ,output v-root-b-code
     6636     ) no-error .
     6637         if error-status :error
     6638         then do:
     6639           message
     6640             vss-workfile vss-revision vss-description skip
     6641             "Ошибка при определении корневого бар-кода для товара" skip
     6642             "Код товара"  buf_bar-code.gds-code skip
     6643             error-status :get-message(1) skip
     6644             return-value skip
     6645             view-as alert-box error .
     6646           undo, return error return-value .
     6647         end.
     6648       end.
     6649       else do:
     6650         define variable v-check-root-b-code like ub.bar-code.b-code no-undo .
     6651   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6652     (input  buf_bar-code.gds-code
     6653     ,input  ?
     6654     ,output v-check-root-b-code
     6655     ) no-error .
     6656         if error-status :error
     6657         then do:
     6658           message
     6659             vss-workfile vss-revision vss-description skip
     6660             "Ошибка при определении корневого бар-кода для товара" skip
     6661             "Код товара"  buf_bar-code.gds-code skip
     6662             error-status :get-message(1) skip
     6663             return-value skip
     6664             view-as alert-box error .
     6665           undo, return error return-value .
     6666         end.
     6667         if v-root-b-code <> v-check-root-b-code
     6668         then do:
     6669           message
     6670             vss-workfile vss-revision vss-description skip
     6671             "Ошибка задания входных параметров" skip
     6672             "Код товара" buf_bar-code.gds-code skip
     6673             "Основной бар-код товара" v-check-root-b-code skip
     6674             "В качестве параметра передано" v-root-b-code skip
     6675             view-as alert-box error .
     6676           undo, return error return-value .
     6677         end.
     6678       end.
     6679       find first buf_root_bar-code no-lock
     6680         where buf_root_bar-code.b-code = v-root-b-code
     6681         no-error .
     6682       if not available buf_root_bar-code
     6683       then do:
     6684         message
     6685           vss-workfile vss-revision vss-description skip
     6686           "Не найден бар-код корневого признака" skip
     6687           "Код товара" buf_bar-code.gds-code skip
     6688           "Бар-код" v-root-b-code skip
     6689           view-as alert-box error .
     6690         undo, return error return-value .
     6691       end.
     6692       if buf_root_bar-code.gds-code <> buf_bar-code.gds-code
     6693       then do:
     6694         message
     6695           vss-workfile vss-revision vss-description skip
     6696           "Ошибка задания входных параметров" skip
     6697           "В качестве параметров указаны бар-коды разных товаров" skip
     6698           "Бар-код" buf_bar-code.b-code skip
     6699           "Код товара" buf_bar-code.gds-code skip
     6700           "Бар-код корневого признака" buf_root_bar-code.b-code skip
     6701           "Код товара в бар-коде корневого признака" buf_root_bar-code.gds-code skip
     6702           view-as alert-box error .
     6703         undo, return error return-value .
     6704       end.
     6705       v-is-parts = false .
     6706       if buf_bar-code.in-code <> "" then do:
     6707          v-is-parts = true .
     6708       end.
     6709       if v-is-parts = true then do:
     6710           if v-fact-order = 0
     6711           then do:
     6712             find last buf_root_price-list no-lock
     6713               where buf_root_price-list.obj-type   = v-obj-type
     6714                 and buf_root_price-list.obj-code   = v-obj-code
     6715                 and buf_root_price-list.b-code     = v-b-code
     6716                 and buf_root_price-list.price-type = ""
     6717               use-index fact-close
     6718               no-error.
     6719           end.
     6720           else do:
     6721             find last buf_root_price-list no-lock
     6722               where buf_root_price-list.obj-type   = v-obj-type
     6723                 and buf_root_price-list.obj-code   = v-obj-code
     6724                 and buf_root_price-list.b-code     = v-b-code
     6725                 and buf_root_price-list.price-type = ""
     6726                 and buf_root_price-list.fact-order < v-fact-order
     6727               use-index fact-close
     6728               no-error.
     6729           end.
     6730           if  available buf_root_price-list
     6731           and buf_root_price-list.fact-order <> 0
     6732           then do:
     6733               assign
     6734                 v-recid-price-list = recid(buf_root_price-list)
     6735                 v-cli-base-rate    = 1
     6736               .
     6737               return .
     6738           end.
     6739           else do:
     6740             if v-fact-order = 0
     6741             then do:
     6742               find last buf_root_price-list no-lock
     6743                 where buf_root_price-list.obj-type   = v-obj-type
     6744                   and buf_root_price-list.obj-code   = v-obj-code
     6745                   and buf_root_price-list.b-code     = v-root-b-code
     6746                   and buf_root_price-list.price-type = ""
     6747                 use-index fact-close
     6748                 no-error.
     6749             end.
     6750             else do:
     6751               find last buf_root_price-list no-lock
     6752                 where buf_root_price-list.obj-type   = v-obj-type
     6753                   and buf_root_price-list.obj-code   = v-obj-code
     6754                   and buf_root_price-list.b-code     = v-root-b-code
     6755                   and buf_root_price-list.price-type = ""
     6756                   and buf_root_price-list.fact-order < v-fact-order
     6757                 use-index fact-close
     6758                 no-error.
     6759             end.
     6760             if  available buf_root_price-list
     6761             and buf_root_price-list.fact-order <> 0
     6762             then do:
     6763                 assign
     6764                   v-recid-price-list = recid(buf_root_price-list)
     6765                   v-cli-base-rate    = 1
     6766                 .
     6767                 return .
     6768             end.
     6769             else do:
     6770                 assign
     6771                   v-recid-price-list = ?
     6772                   v-cli-base-rate    = ?
     6773                 .
     6774                 return .
     6775             end.
     6776           end.
     6777       end.
     6778       if v-fact-order = 0
     6779       then do:
     6780         find last buf_root_price-list no-lock
     6781           where buf_root_price-list.obj-type   = v-obj-type
     6782             and buf_root_price-list.obj-code   = v-obj-code
     6783             and buf_root_price-list.b-code     = v-root-b-code
     6784             and buf_root_price-list.price-type = ""
     6785           use-index fact-close
     6786           no-error.
     6787       end.
     6788       else do:
     6789         find last buf_root_price-list no-lock
     6790           where buf_root_price-list.obj-type   = v-obj-type
     6791             and buf_root_price-list.obj-code   = v-obj-code
     6792             and buf_root_price-list.b-code     = v-root-b-code
     6793             and buf_root_price-list.price-type = ""
     6794             and buf_root_price-list.fact-order < v-fact-order
     6795           use-index fact-close
     6796           no-error.
     6797       end.
     6798       if  available buf_root_price-list
     6799       and buf_root_price-list.fact-order <> 0
     6800       then do:
     6801         if v-b-code = v-root-b-code
     6802         then do:
     6803           assign
     6804             v-recid-price-list = recid(buf_root_price-list)
     6805             v-cli-base-rate    = 1
     6806           .
     6807           return .
     6808         end.
     6809         else do:
     6810           find first buf_price-list no-lock
     6811             where buf_price-list.doc-num    = buf_root_price-list.doc-num
     6812               and buf_price-list.b-code     = v-b-code
     6813               and buf_price-list.price-type = ""
     6814             no-error.
     6815           if available buf_price-list
     6816           then do:
     6817             assign
     6818               v-recid-price-list = recid(buf_price-list)
     6819               v-cli-base-rate    = 1
     6820             .
     6821             return .
     6822           end.
     6823           if buf_bar-code.unit-cli = buf_root_bar-code.unit-cli
     6824           then do:
     6825             assign
     6826               v-recid-price-list = recid(buf_root_price-list)
     6827               v-cli-base-rate    = 1
     6828             .
     6829             return .
     6830           end.
     6831           else do:
     6832             define variable v-is-new as logical no-undo .
     6833   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6834   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     6835     (input  buf_bar-code.gds-code
     6836     ,input  buf_bar-code.node-code
     6837     ,input  buf_bar-code.part-code
     6838     ,input  buf_bar-code.in-code
     6839     ,input  buf_root_bar-code.unit-cli
     6840     ,input  1
     6841     ,output v-is-new
     6842     ,buffer buf_main_bar-code
     6843     ) no-error .
     6844             if error-status :error
     6845             then do:
     6846               message
     6847                 vss-workfile vss-revision vss-description skip
     6848                 "Ошибка при поиске бар-кода" skip
     6849                 error-status :get-message(1) skip
     6850                 return-value skip
     6851                 view-as alert-box error .
     6852               undo, return error return-value .
     6853             end.
     6854             find first buf_price-list no-lock
     6855               where buf_price-list.doc-num    = buf_root_price-list.doc-num
     6856                 and buf_price-list.b-code     = buf_main_bar-code.b-code
     6857                 and buf_price-list.price-type = ""
     6858               no-error.
     6859             if available buf_price-list
     6860             then do:
     6861               assign
     6862                 v-recid-price-list = recid(buf_price-list)
     6863               .
     6864               return .
     6865             end.
     6866             else do:
     6867               assign
     6868                 v-recid-price-list = recid(buf_root_price-list)
     6869               .
     6870               return .
     6871             end.
     6872           end.
     6873         end.
     6874       end.
     6875       else do:
     6876         assign
     6877           v-recid-price-list = ?
     6878           v-cli-base-rate    = ?
     6879         .
     6880         return .
     6881       end.
     6882       message
     6883         vss-workfile vss-revision vss-description skip
     6884         "Внутренняя ошибка при определении цены бар-кода" skip
     6885         "Бар-код"    buf_bar-code.b-code skip
     6886         "Код товара" buf_bar-code.gds-code skip
     6887         "recid(root_price-list)" recid(buf_root_price-list) skip
     6888         "recid(price-list)"      recid(buf_price-list) skip
     6889         view-as alert-box error .
     6890       undo, return error return-value .
     6891     end.
     6892   end procedure.
     6893   procedure bcodeqnt :
     6894     define input parameter  v-obj-type    like ub.gds-obj.obj-type  no-undo .
     6895     define input parameter  v-obj-code    like ub.gds-obj.obj-code  no-undo .
     6896     define input parameter  v-b-code      like ub.bar-code.b-code   no-undo .
     6897     define input parameter  v-root-b-code like ub.bar-code.b-code   no-undo .
     6898     define output parameter v-fact-qnty   like ub.gds-obj.fact-qnty no-undo .
     6899     define output parameter v-qnty-type   as character              no-undo .
     6900     define output parameter v-qnty-recid  as recid                  no-undo .
     6901     define variable vss-description as character no-undo initial "bcodeqnt-01: Определение текущего количества товара на объекте с данным бар-кодом".
     6902     define buffer buf_root_bar-code   for ub.bar-code .
     6903     define buffer buf_bar-code        for ub.bar-code .
     6904     define buffer buf_root_price-list for ub.price-list .
     6905     define buffer buf_price-list      for ub.price-list .
     6906     define buffer buf_main_bar-code   for ub.bar-code .
     6907     define buffer buf_goods for ub.goods .
     6908     define buffer buf_parts for ub.parts .
     6909     define buffer buf_prt-obj for ub.prt-obj .
     6910     define buffer buf_gds-obj for ub.gds-obj .
     6911     do
     6912     on error undo, return error return-value
     6913     :
     6914       find first buf_bar-code no-lock
     6915         where buf_bar-code.b-code = v-b-code
     6916         no-error .
     6917       if not available buf_bar-code
     6918       then do:
     6919         message
     6920           vss-workfile vss-revision vss-description skip
     6921           "Ошибка при задании входных параметров" skip
     6922           "Не найден бар-код" v-b-code skip
     6923           view-as alert-box error .
     6924         undo, return error return-value .
     6925       end.
     6926       if v-root-b-code = ?
     6927       then do:
     6928         message
     6929           vss-workfile vss-revision vss-description skip
     6930           "Ошибка при задании входных параметров" skip
     6931           "Должен быть задан бар-код корневого признака" skip
     6932           "Или он должен быть равено 0" skip
     6933           "Бар-код корневого признака" v-root-b-code skip
     6934           view-as alert-box error .
     6935         undo, return error return-value .
     6936       end.
     6937       if v-root-b-code = 0
     6938       then do:
     6939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6940     (input  buf_bar-code.gds-code
     6941     ,input  ?
     6942     ,output v-root-b-code
     6943     ) no-error .
     6944         if error-status :error
     6945         then do:
     6946           message
     6947             vss-workfile vss-revision vss-description skip
     6948             "Ошибка при определении корневого бар-кода для товара" skip
     6949             "Код товара"  buf_bar-code.gds-code skip
     6950             error-status :get-message(1) skip
     6951             return-value skip
     6952             view-as alert-box error .
     6953           undo, return error return-value .
     6954         end.
     6955       end.
     6956       find first buf_root_bar-code no-lock
     6957         where buf_root_bar-code.b-code = v-root-b-code
     6958         no-error .
     6959       if not available buf_root_bar-code
     6960       then do:
     6961         message
     6962           vss-workfile vss-revision vss-description skip
     6963           "Не найден бар-код корневого признака" skip
     6964           "Код товара" buf_bar-code.gds-code skip
     6965           "Бар-код" v-root-b-code skip
     6966           view-as alert-box error .
     6967         undo, return error return-value .
     6968       end.
     6969       if buf_root_bar-code.gds-code <> buf_bar-code.gds-code
     6970       then do:
     6971         message
     6972           vss-workfile vss-revision vss-description skip
     6973           "Ошибка задания входных параметров" skip
     6974           "В качестве параметров указаны бар-коды разных товаров" skip
     6975           "Бар-код" buf_bar-code.b-code skip
     6976           "Код товара" buf_bar-code.gds-code skip
     6977           "Бар-код корневого признака" buf_root_bar-code.b-code skip
     6978           "Код товара в бар-коде корневого признака" buf_root_bar-code.gds-code skip
     6979           view-as alert-box error .
     6980         undo, return error return-value .
     6981       end.
     6982       if buf_bar-code.unit-cli <> buf_root_bar-code.unit-cli
     6983       then do:
     6984         assign
     6985           v-fact-qnty  = ?
     6986           v-qnty-type  = "alt-unit":u
     6987           v-qnty-recid = ?
     6988         .
     6989         return .
     6990       end.
     6991       find first buf_goods no-lock
     6992         where buf_goods.gds-code = buf_bar-code.gds-code
     6993         no-error .
     6994       if error-status :error
     6995       then do:
     6996         message
     6997           vss-workfile vss-revision vss-description skip
     6998           "Не найден товар" skip
     6999           "Бар-код" buf_bar-code.b-code skip
     7000           "Код товара" buf_bar-code.gds-code skip
     7001           view-as alert-box error .
     7002         undo, return error return-value .
     7003       end.
     7004       if buf_bar-code.in-code <> ""
     7005       then do:
     7006         assign
     7007           v-fact-qnty  = 0
     7008           v-qnty-type  = "parts":u
     7009           v-qnty-recid = ?
     7010         .
     7011         find first buf_parts no-lock
     7012           where buf_parts.obj-type  = v-obj-type
     7013             and buf_parts.obj-code  = v-obj-code
     7014             and buf_parts.artic     = buf_goods.artic
     7015             and buf_parts.prod-type = buf_goods.prod-type
     7016             and buf_parts.prod-code = buf_goods.prod-code
     7017             and buf_parts.in-code   = buf_bar-code.in-code
     7018             and buf_parts.part-code = buf_bar-code.part-code
     7019             and buf_parts.out-code  = 'free-zone':U
     7020           no-error .
     7021         if available buf_parts
     7022         then do:
     7023           assign
     7024             v-fact-qnty  = buf_parts.fact-qnty
     7025             v-qnty-recid = recid(buf_parts)
     7026           .
     7027         end.
     7028         return .
     7029       end.
     7030       if buf_bar-code.b-code = buf_root_bar-code.b-code
     7031       then do:
     7032         assign
     7033           v-fact-qnty  = 0
     7034           v-qnty-type  = "gds-obj":u
     7035           v-qnty-recid = ?
     7036         .
     7037         find first buf_gds-obj no-lock
     7038           where buf_gds-obj.obj-type = v-obj-type
     7039             and buf_gds-obj.obj-code = v-obj-code
     7040             and buf_gds-obj.gds-code = buf_bar-code.gds-code
     7041           no-error .
     7042         if available buf_gds-obj
     7043         then do:
     7044           assign
     7045             v-fact-qnty  = buf_gds-obj.fact-qnty
     7046             v-qnty-recid = recid(buf_gds-obj)
     7047           .
     7048         end.
     7049         return .
     7050       end.
     7051       else do:
     7052         assign
     7053           v-fact-qnty  = 0
     7054           v-qnty-type  = "prt-obj":u
     7055           v-qnty-recid = ?
     7056         .
     7057         find first buf_prt-obj no-lock
     7058           where buf_prt-obj.obj-type  = v-obj-type
     7059             and buf_prt-obj.obj-code  = v-obj-code
     7060             and buf_prt-obj.artic     = buf_goods.artic
     7061             and buf_prt-obj.prod-type = buf_goods.prod-type
     7062             and buf_prt-obj.prod-code = buf_goods.prod-code
     7063             and buf_prt-obj.prt-code  = buf_bar-code.node-code
     7064           no-error .
     7065         if available buf_prt-obj
     7066         then do:
     7067           assign
     7068             v-fact-qnty  = buf_prt-obj.fact-qnty
     7069             v-qnty-recid = recid(buf_prt-obj)
     7070           .
     7071         end.
     7072         return .
     7073       end.
     7074       message
     7075         vss-workfile vss-revision vss-description skip
     7076         "Внутренняя ошибка при определении количества по бар-коду" skip
     7077         "Бар-код"    buf_bar-code.b-code skip
     7078         "Код товара" buf_bar-code.gds-code skip
     7079         view-as alert-box error .
     7080       undo, return error return-value .
     7081     end.
     7082   end procedure.
     7083   procedure prodbcat :
     7084     do
     7085     on error undo, return error return-value
     7086     :
     7087       define parameter buffer buf_prod-bc  for ub.prod-bc .
     7088       define input  parameter p-action           as character no-undo .
     7089       define output parameter p-return-attribute as logical no-undo .
     7090       define variable vss-description as character no-undo initial "prodbcat-01: определение параметров дополнительного бар-кода".
     7091       define buffer buf_bar-code   for ub.bar-code   .
     7092       define buffer buf_goods      for ub.goods      .
     7093       define buffer buf_units      for ub.units      .
     7094       define buffer base_units     for ub.units      .
     7095       define buffer buf_code-range for ub.code-range .
     7096       define variable p-code-int as integer no-undo .
     7097       define variable v-cdrg-type as character no-undo .
     7098       if not available buf_prod-bc
     7099       then do:
     7100         message
     7101           vss-workfile vss-revision vss-description skip
     7102           "Ошибка задания входных параметров" skip
     7103           "Не задан дополнительный бар-код" skip
     7104           view-as alert-box error .
     7105         undo, return error return-value .
     7106       end.
     7107       if buf_prod-bc.bc-on-type eq 'GTIN':U
     7108       then do:
     7109          return.
     7110       end.
     7111       define variable ind                    as integer   no-undo .
     7112       define variable v-num-entries-p-action as integer   no-undo .
     7113       define variable v-action               as character no-undo .
     7114       assign
     7115         v-num-entries-p-action = num-entries(p-action)
     7116       .
     7117       assign
     7118         p-return-attribute = true
     7119       .
     7120       _ind:
     7121       do ind = 1 to v-num-entries-p-action
     7122       :
     7123         if ind > 1 and p-return-attribute = false then return.
     7124         assign
     7125           v-action = entry(ind, p-action)
     7126         .
     7127         case v-action :
     7128           when "global=request":u
     7129           then do:
     7130             if not (buf_prod-bc.bc-on-type = ''
     7131             or buf_prod-bc.bc-on-type = 'scgb':U
     7132             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     7133               assign
     7134                 p-return-attribute = false
     7135               .
     7136             end.
     7137           end.
     7138           when "weight=request":u
     7139           then do:
     7140             if not (buf_prod-bc.bc-on-type = 'sclc':U
     7141             or buf_prod-bc.bc-on-type = 'scgb':U) then do:
     7142               assign
     7143                 p-return-attribute = false
     7144               .
     7145             end.
     7146           end.
     7147           when "pgweight=request":u
     7148           then do:
     7149             if not (buf_prod-bc.bc-on-type = 'pglc':U) then do:
     7150               assign
     7151                 p-return-attribute = false.
     7152             end.
     7153           end.
     7154           when "petrolium=request":u
     7155           then do:
     7156             if not (buf_prod-bc.bc-on-type = 'ptlc':U) then do:
     7157               assign
     7158                 p-return-attribute = false.
     7159             end.
     7160           end.
     7161           when "scaleable=request":u
     7162           then do:
     7163             if not (buf_prod-bc.bc-on-type = 'sslc':U
     7164             or buf_prod-bc.bc-on-type = 'ssgb':U) then do:
     7165               assign
     7166                 p-return-attribute = false.
     7167             end.
     7168           end.
     7169           otherwise do:
     7170             message
     7171               vss-workfile vss-revision vss-description skip
     7172               "Неизвестное значение параметра v-action " skip
     7173               "v-action" v-action skip
     7174               "p-action" p-action skip
     7175               view-as alert-box error .
     7176             undo, return error return-value .
     7177           end.
     7178         end case.
     7179       end.
     7180     end.
     7181   end procedure.
     7182   procedure prodbctv :
     7183     do
     7184     on error undo, return error return-value
     7185     :
     7186       define input  parameter p-b-str    like ub.prod-bc.b-str   no-undo .
     7187       define input  parameter p-unit-cli like ub.units.unit-name no-undo .
     7188       define input  parameter p-unit-base like ub.units.unit-name no-undo .
     7189       define input  parameter p-action           as character no-undo .
     7190       define output parameter p-return-attribute as logical no-undo .
     7191       define variable vss-description as character no-undo init "prodbctv-01: определение параметров ЗНАЧЕНИЯ дополнительного бар-кода".
     7192       define buffer buf_units      for ub.units      .
     7193       define buffer base_units     for ub.units      .
     7194       define buffer buf_code-range for ub.code-range .
     7195       define variable p-code-int as integer no-undo .
     7196       define variable v-cdrg-type as character no-undo .
     7197       find first buf_units no-lock
     7198         where buf_units.unit-name = p-unit-cli
     7199         no-error .
     7200       if not available buf_units
     7201       then do:
     7202         message
     7203           vss-workfile vss-revision vss-description skip
     7204           "Не найдена единица измерения бар-кода" skip
     7205           "Единица измерения" p-unit-cli skip
     7206           view-as alert-box error .
     7207         undo, return error return-value .
     7208       end.
     7209       define variable ind                    as integer   no-undo .
     7210       define variable v-num-entries-p-action as integer   no-undo .
     7211       define variable v-action               as character no-undo .
     7212       assign
     7213         v-num-entries-p-action = num-entries(p-action)
     7214       .
     7215       assign
     7216         p-return-attribute = true
     7217       .
     7218       _ind:
     7219       do ind = 1 to v-num-entries-p-action
     7220       :
     7221         if ind > 1 and p-return-attribute = false then return.
     7222         assign
     7223           v-action = entry(ind, p-action)
     7224         .
     7225         case v-action :
     7226           when "global=request":u
     7227           then do:
     7228             if lookup('вес':U, buf_units.type) > 0
     7229             or (lookup('топ':U, buf_units.type)  > 0
     7230                 and lookup('дро':U, buf_units.type) > 0
     7231               )
     7232             or lookup('шту':U, buf_units.type) > 0
     7233             then do:
     7234               if length(p-b-str) < 6
     7235               then do:
     7236                 if v-action = "global=request":u
     7237                    and (lookup('вес':U, buf_units.type) > 0
     7238                        or lookup('шту':U, buf_units.type) > 0
     7239                       )
     7240                 then do:
     7241                   if lookup('вес':U, buf_units.type) > 0 then v-cdrg-type = 'sclc':U.
     7242                   if lookup('шту':U, buf_units.type) > 0 then v-cdrg-type = 'pglc':U.
     7243                   find first buf_code-range
     7244                     where buf_code-range.range-type = v-cdrg-type
     7245                       and buf_code-range.last-code >= int( p-b-str )
     7246                     use-index last-codei
     7247                     no-error .
     7248                   if  available buf_code-range
     7249                   and buf_code-range.first-code <= int( p-b-str )
     7250                   then do:
     7251                     assign
     7252                       p-return-attribute = false
     7253                     .
     7254                   end.
     7255                 end.
     7256                 else do:
     7257                   assign
     7258                     p-return-attribute = false
     7259                   .
     7260                 end.
     7261               end.
     7262             end.
     7263             if lookup('дро':U, buf_units.type) > 0
     7264             then do:
     7265               find first buf_code-range
     7266                 where buf_code-range.range-type = 'sslc':U
     7267                   and buf_code-range.last-code >= int( p-b-str )
     7268                 use-index last-codei
     7269                 no-error .
     7270               if  available buf_code-range
     7271               and buf_code-range.first-code <= int( p-b-str )
     7272               then do:
     7273                 assign
     7274                   p-return-attribute = false
     7275                 .
     7276               end.
     7277             end.
     7278           end.
     7279           when "weight=request":u
     7280           then do:
     7281             assign
     7282               p-code-int         = integer( p-b-str ) no-error
     7283             .
     7284             if lookup('вес':U, buf_units.type) > 0
     7285                and length(p-b-str) < 6
     7286                and length( string( p-code-int ) ) < 6
     7287                and length(p-b-str) > 2
     7288                and length( string( p-code-int ) ) > 2
     7289             then do:
     7290               next _ind.
     7291             end.
     7292             else do:
     7293               assign
     7294                 p-return-attribute = false
     7295               .
     7296             end.
     7297           end.
     7298           when "pgweight=request":u
     7299           then do:
     7300             assign
     7301               p-code-int         = integer( p-b-str ) no-error
     7302             .
     7303             if lookup('шту':U, buf_units.type) > 0
     7304                and length(p-b-str) < 6
     7305                and length( string( p-code-int ) ) < 6
     7306                and length(p-b-str) > 2
     7307                and length( string( p-code-int ) ) > 2
     7308             then do:
     7309               next _ind.
     7310             end.
     7311             else do:
     7312               assign
     7313                 p-return-attribute = true
     7314               .
     7315             end.
     7316           end.
     7317           when "petrolium=request":u
     7318           then do:
     7319             assign
     7320               p-code-int         = integer( p-b-str ) no-error
     7321             .
     7322             if lookup( 'топ':U, buf_units.type )  > 0
     7323                and lookup( 'дро':U, buf_units.type ) > 0
     7324                and length( p-b-str ) <= 2
     7325                and length( string( p-code-int ) ) <= 2
     7326                and p-code-int <> 0
     7327             then do:
     7328               next _ind.
     7329             end.
     7330             else do:
     7331               assign
     7332                 p-return-attribute = false
     7333               .
     7334             end.
     7335           end.
     7336           when "scaleable=request":u
     7337           then do:
     7338             assign
     7339               p-code-int         = integer( p-b-str ) no-error
     7340             .
     7341             find first base_units no-lock
     7342               where base_units.unit-name = p-unit-base
     7343               no-error .
     7344             if not available base_units
     7345             then do:
     7346               message
     7347                 vss-workfile vss-revision vss-description skip
     7348                 "Не найдена основная единица измерения" skip
     7349                 "Единица измерения" p-unit-base skip
     7350                 view-as alert-box error .
     7351               undo, return error return-value .
     7352             end.
     7353             if lookup('дро':U, buf_units.type) > 0
     7354                and lookup('вес':U, base_units.type) > 0
     7355             then do:
     7356               p-code-int = 0.
     7357               assign
     7358               p-code-int = integer( p-b-str )
     7359               no-error .
     7360               if error-status :error or p-code-int <= 0
     7361               then do:
     7362                 assign
     7363                   p-return-attribute = false
     7364                 .
     7365                 next _ind.
     7366               end.
     7367               if trim(string(p-code-int, ">>>>>>>>9":U)) <>  p-b-str
     7368               then do:
     7369                 assign
     7370                   p-return-attribute = false
     7371                 .
     7372                 next _ind.
     7373               end.
     7374               find first buf_code-range
     7375                 where buf_code-range.range-type = 'sslc':U
     7376                   and buf_code-range.last-code >= p-code-int
     7377                   use-index last-codei
     7378                 no-error .
     7379               if  available buf_code-range
     7380               and buf_code-range.first-code <= p-code-int
     7381               then do:
     7382                 next _ind.
     7383               end.
     7384               else do:
     7385                 find first buf_code-range
     7386                   where buf_code-range.range-type = 'ssgb':U
     7387                     and buf_code-range.last-code >= p-code-int
     7388                     use-index last-codei
     7389                   no-error .
     7390                 if  available buf_code-range
     7391                 and buf_code-range.first-code <= p-code-int
     7392                 then do:
     7393                   next _ind.
     7394                 end.
     7395                 else do:
     7396                   assign
     7397                     p-return-attribute = false
     7398                   .
     7399                 end.
     7400               end.
     7401             end.
     7402             else do:
     7403               assign
     7404                 p-return-attribute = false
     7405               .
     7406             end.
     7407           end.
     7408           otherwise do:
     7409             message
     7410               vss-workfile vss-revision vss-description skip
     7411               "Неизвестное значение параметра v-action " skip
     7412               "v-action" v-action skip
     7413               "p-action" p-action skip
     7414               view-as alert-box error .
     7415             undo, return error return-value .
     7416           end.
     7417         end case.
     7418       end.
     7419     end.
     7420   end procedure.
     7421   procedure bc-ean :
     7422     define input  parameter p-bc-frmt  as character no-undo .
     7423     define input  parameter p-bc-pfx   as character no-undo .
     7424     define input  parameter p-b-code   as integer   no-undo .
     7425     define output parameter p-ean-code as character no-undo .
     7426     define buffer buf_bar-code for ub.bar-code .
     7427     define buffer buf_prod-bc for ub.prod-bc.
     7428     define variable v-bc-frmt as character no-undo .
     7429     define variable v-check-length as integer   no-undo .
     7430     define variable v-check-code   as character no-undo .
     7431     do
     7432     on error undo, return error return-value
     7433     :
     7434       find first buf_bar-code no-lock
     7435         where buf_bar-code.b-code = p-b-code
     7436         no-error .
     7437       if not available buf_bar-code
     7438       then do:
     7439         undo, return error substitute("Ошибка задания входных параметров. Не найден штрих-код &1"
     7440                                      ,p-b-code
     7441                                      ) .
     7442       end.
     7443       case p-bc-frmt :
     7444         when 'EAN13':u
     7445         then do:
     7446           assign
     7447             v-check-length = 13
     7448           .
     7449         end.
     7450         when 'EAN8':u
     7451         then do:
     7452           assign
     7453             v-check-length = 8
     7454           .
     7455         end.
     7456         otherwise do:
     7457           undo, return error substitute('Неизвестное значение параметра &1', p-bc-frmt) .
     7458         end.
     7459       end case .
     7460       for each buf_prod-bc no-lock
     7461         where buf_prod-bc.b-code = p-b-code
     7462           and buf_prod-bc.bc-on  = true
     7463       on error undo, return error return-value
     7464       :
     7465         if length(buf_prod-bc.b-str) = v-check-length
     7466         then do:
     7467           assign
     7468             v-check-code = substring (buf_prod-bc.b-str
     7469                                       ,1
     7470                                       ,length (buf_prod-bc.b-str) - 1
     7471                                       )
     7472           .
     7473           run str/chk-sum.p
     7474             (input-output v-check-code
     7475             ) no-error.
     7476           if error-status :error <> true
     7477           and v-check-code = buf_prod-bc.b-str
     7478           then do:
     7479             assign
     7480               p-ean-code = buf_prod-bc.b-str
     7481             .
     7482             return .
     7483           end.
     7484         end.
     7485       end.
     7486   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7487     define variable tmp-str56  as character no-undo.
     7488     define variable tmp-num56  as character no-undo.
     7489     define variable i56        as integer   no-undo.
     7490     define variable sum56      as integer   no-undo.
     7491     define variable len-code56 as integer   no-undo.
     7492     define variable varcont56  as logical   initial yes no-undo.
     7493     CASE p-bc-frmt :
     7494       WHEN "EAN13" THEN do:
     7495         assign
     7496           tmp-str56 = string( p-b-code, "999999999999" )
     7497         .
     7498       end.
     7499       WHEN "EAN8" THEN do:
     7500         assign
     7501           tmp-str56 = string( p-b-code, "9999999" )
     7502         .
     7503       end.
     7504       OTHERWISE DO:
     7505             assign p-ean-code     = ""
     7506                    varcont56 = no.
     7507       END.
     7508     END CASE.
     7509     if varcont56 = yes then do:
     7510       if integer( substring( tmp-str56, 1, length( p-bc-pfx ) ) ) <> 0
     7511       then do:
     7512            assign p-ean-code     = ""
     7513                   varcont56 = no.
     7514       end.
     7515       else do:
     7516         assign
     7517           p-ean-code = p-bc-pfx + substring( tmp-str56, length( p-bc-pfx ) + 1, length( tmp-str56 ) - length( p-bc-pfx ) )
     7518           len-code56    = length( p-ean-code )
     7519         .
     7520         define variable v-sum-char56 as character no-undo .
     7521         assign
     7522           sum56 = 0
     7523         .
     7524         do i56 = 1 to len-code56 by 2
     7525         :
     7526           assign
     7527             v-sum-char56 = substr(p-ean-code, len-code56 - i56 + 1, 1)
     7528           .
     7529           if v-sum-char56 < "0"
     7530           or v-sum-char56 > "9"
     7531           then do:
     7532                assign p-ean-code     = ""
     7533                       varcont56 = no.
     7534           end.
     7535           assign
     7536             sum56 = sum56 + integer(v-sum-char56)
     7537           .
     7538         end.
     7539         if varcont56 = yes then do:
     7540           assign
     7541             sum56 = sum56 * 3
     7542           .
     7543           do i56 = 2 to len-code56 by 2
     7544           :
     7545             assign
     7546               v-sum-char56 = substr(p-ean-code, len-code56 - i56 + 1, 1)
     7547             .
     7548             if v-sum-char56 < "0"
     7549             or v-sum-char56 > "9"
     7550             then do:
     7551                  assign p-ean-code     = ""
     7552                         varcont56 = no.
     7553             end.
     7554             assign
     7555               sum56 = sum56 + integer(v-sum-char56)
     7556             .
     7557           end.
     7558           if varcont56 = yes then do:
     7559              if sum56 mod 10 = 0 then do:
     7560                assign
     7561                  p-ean-code = p-ean-code + '0'
     7562                .
     7563              end.
     7564              else do:
     7565                assign
     7566                  p-ean-code = p-ean-code + string(10 - sum56 mod 10)
     7567                .
     7568              end.
     7569           end.
     7570         end.
     7571       end.
     7572     end.
     7573     end.
     7574   end procedure.
     7575   procedure prt-root-to-node-code :
     7576     define input  parameter p-prt-root  like ub.goods.prt-root no-undo .
     7577     define output parameter p-root-node like ub.goods.prt-root no-undo .
     7578     define variable vss-description as character no-undo initial "prt-root-to-node-code-01: определение корневого признака шкалы по коду шкалы".
     7579     define buffer buf_gds-prt for ub.gds-prt .
     7580     do
     7581     on error undo, return error return-value
     7582     :
     7583       find buf_gds-prt no-lock
     7584         where buf_gds-prt.upper-code = p-prt-root
     7585         no-error .
     7586       if not available buf_gds-prt
     7587       then do:
     7588         message
     7589           vss-workfile vss-revision vss-description skip
     7590           "Не найден корень шкалы" skip
     7591           "Указатель на корень шкалы" p-prt-root skip
     7592           view-as alert-box error .
     7593         undo, return error return-value .
     7594       end.
     7595       assign
     7596         p-root-node = buf_gds-prt.node-code
     7597       .
     7598     end.
     7599   end procedure.
     7600   procedure rootnode :
     7601     define input  parameter p-artic     like ub.goods.artic     no-undo .
     7602     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
     7603     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
     7604     define output parameter p-root-node like ub.goods.prt-root  no-undo .
     7605     define variable vss-description as character no-undo initial "rootnode-01: определение корневого признака товара по артикулу".
     7606     define buffer buf_goods for ub.goods .
     7607     do
     7608     on error undo, return error return-value
     7609     :
     7610       find first buf_goods no-lock
     7611         where buf_goods.artic     = p-artic
     7612           and buf_goods.prod-type = p-prod-type
     7613           and buf_goods.prod-code = p-prod-code
     7614         no-error .
     7615       if not available buf_goods
     7616       then do:
     7617         message
     7618           vss-workfile vss-revision vss-description skip
     7619           "Не найден товар" skip
     7620           "Артикул" p-artic p-prod-type p-prod-code skip
     7621           view-as alert-box error .
     7622         undo, return error return-value .
     7623       end.
     7624       run prt-root-to-node-code in this-procedure
     7625         (input  buf_goods.prt-root
     7626         ,output p-root-node
     7627         ) no-error .
     7628       if error-status :error
     7629       then do:
     7630         message
     7631           vss-workfile vss-revision vss-description skip
     7632           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     7633           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     7634           "Указатель на корень шкалы" buf_goods.prt-root skip
     7635           error-status :get-message(1) skip
     7636           return-value skip
     7637           view-as alert-box error .
     7638         undo, return error return-value .
     7639       end.
     7640     end.
     7641   end procedure.
     7642   procedure gdsrtnod :
     7643     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     7644     define output parameter p-root-node like ub.goods.prt-root no-undo .
     7645     define variable vss-description as character no-undo initial "gdsrtnod-01: определение корневого признака товара по коду товара".
     7646     define buffer buf_goods   for ub.goods .
     7647     do
     7648     on error undo, return error return-value
     7649     :
     7650       find first buf_goods no-lock
     7651         where buf_goods.gds-code  = p-gds-code
     7652         no-error .
     7653       if not available buf_goods
     7654       then do:
     7655         message
     7656           vss-workfile vss-revision vss-description skip
     7657           "Не найден товар" skip
     7658           "Код товара" p-gds-code skip
     7659           view-as alert-box error .
     7660         undo, return error return-value .
     7661       end.
     7662       run prt-root-to-node-code in this-procedure
     7663         (input  buf_goods.prt-root
     7664         ,output p-root-node
     7665         ) no-error .
     7666       if error-status :error
     7667       then do:
     7668         message
     7669           vss-workfile vss-revision vss-description skip
     7670           "Ошибка при вызове процедуры prt-root-to-node-code" skip
     7671           "Товар" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     7672           "Указатель на корень шкалы" buf_goods.prt-root skip
     7673           error-status :get-message(1) skip
     7674           return-value skip
     7675           view-as alert-box error .
     7676         undo, return error return-value .
     7677       end.
     7678     end.
     7679   end procedure.
     7680   procedure currdbat :
     7681     define input  parameter p-action           as character no-undo .
     7682     define output parameter p-return-attribute as logical no-undo .
     7683     define variable vss-description as character no-undo initial "currdbat-01: определение атрибутов текущей базы данных".
     7684     do
     7685     on error undo, return error return-value
     7686     :
     7687       define variable v-db-num               as integer   no-undo .
     7688       define variable v-num-entries-p-action as integer   no-undo .
     7689       define variable v-ind                  as integer   no-undo .
     7690       define variable v-action               as character no-undo .
     7691       assign
     7692         v-num-entries-p-action = num-entries(p-action)
     7693       .
     7694       do v-ind = 1 to v-num-entries-p-action
     7695       on error undo, return error return-value
     7696       :
     7697         assign
     7698           v-action = entry(v-ind, p-action)
     7699         .
     7700         case v-action :
     7701           when 'office=request':u
     7702           then do:
     7703   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7705     (output v-db-num
     7706     ) no-error .
     7707             if error-status :error
     7708             then do:
     7709               message
     7710                 vss-workfile vss-revision vss-description skip
     7711                 "Ошибка при определении текущей БД" skip
     7712                 error-status :get-message(1) skip
     7713                 return-value skip
     7714                 view-as alert-box error .
     7715               undo, return error return-value .
     7716             end.
     7717             if v-db-num = 0
     7718             then do:
     7719               assign
     7720                 p-return-attribute = true
     7721               .
     7722             end.
     7723             else do:
     7724               assign
     7725                 p-return-attribute = false
     7726               .
     7727             end.
     7728           end.
     7729           otherwise do:
     7730             message
     7731               vss-workfile vss-revision vss-description skip
     7732               "Ошибка задания входных параметров" skip
     7733               "p-action" p-action skip
     7734               "v-action" v-action skip
     7735               view-as alert-box error .
     7736             undo, return error return-value .
     7737           end.
     7738         end.
     7739       end.
     7740     end.
     7741   end procedure.
     7742   procedure objat :
     7743     define input  parameter p-obj-type         like ub.gds-obj.obj-type  no-undo .
     7744     define input  parameter p-obj-code         like ub.gds-obj.obj-code  no-undo .
     7745     define input  parameter p-action           as character no-undo .
     7746     define output parameter p-return-attribute as logical no-undo .
     7747     define variable vss-description as character no-undo initial "objat-03: Получить атрибут объекта (склад магазин)".
     7748     define variable ind      as integer no-undo .
     7749     define variable v-action as character no-undo .
     7750     define variable l-in-ov       as logical   no-undo .
     7751     define variable l-doc-prt     as logical   no-undo .
     7752     define variable l-shift-on    as logical   no-undo .
     7753     define variable v-no-eq       as logical   no-undo .
     7754     define variable v-price-calc  as logical   no-undo .
     7755     define variable v-inout-price as logical   no-undo .
     7756     define variable v-host-code like ub.sysconf.host-code no-undo .
     7757     define buffer buf_store   for ub.store .
     7758     define buffer buf_shop    for ub.shop .
     7759     define buffer buf_gds-obj for ub.gds-obj .
     7760     do
     7761     on error undo, return error return-value
     7762     :
     7763       case p-obj-type :
     7764         when 'скл':U
     7765         then do:
     7766           find buf_store no-lock
     7767             where buf_store.obj-code = p-obj-code
     7768             no-error .
     7769           if not available buf_store
     7770           then do:
     7771             undo, return error substitute("Не найден объект &1 &2", p-obj-type, p-obj-code).
     7772           end.
     7773           assign
     7774             l-in-ov       = buf_store.in-ov
     7775             l-doc-prt     = buf_store.doc-prt
     7776             l-shift-on    = buf_store.shift-on
     7777             v-no-eq       = buf_store.no-eq
     7778             v-price-calc  = buf_store.price-calc
     7779             v-inout-price = buf_store.inout-price
     7780             v-host-code   = buf_store.host-code
     7781           .
     7782         end.
     7783         when 'маг':U
     7784         then do:
     7785           find buf_shop no-lock
     7786             where buf_shop.obj-code = p-obj-code
     7787             no-error .
     7788           if not available buf_shop
     7789           then do:
     7790             undo, return error substitute("Не найден объект &1 &2", p-obj-type, p-obj-code).
     7791           end.
     7792           assign
     7793             l-in-ov       = buf_shop.in-ov
     7794             l-doc-prt     = buf_shop.doc-prt
     7795             l-shift-on    = buf_shop.shift-on
     7796             v-no-eq       = buf_shop.no-eq
     7797             v-price-calc  = buf_shop.price-calc
     7798             v-inout-price = buf_shop.inout-price
     7799             v-host-code   = buf_shop.host-code
     7800           .
     7801         end.
     7802         otherwise do:
     7803           message
     7804             vss-workfile vss-revision vss-description skip
     7805             "Ошибка задания входных параметров" skip
     7806             "Задан неправильный тип для объекта" skip
     7807             "p-obj-type" p-obj-type skip
     7808             "p-obj-code" p-obj-code skip
     7809             view-as alert-box error .
     7810           undo, return error return-value .
     7811         end.
     7812       end case .
     7813       define variable v-num-entries-p-action as integer no-undo .
     7814       assign
     7815         v-num-entries-p-action = num-entries(p-action)
     7816       .
     7817       do ind = 1 to v-num-entries-p-action
     7818       on error undo, return error return-value
     7819       :
     7820         assign
     7821           v-action = entry(ind, p-action)
     7822         .
     7823         case v-action :
     7824           when 'check-exist':u
     7825           then do:
     7826             assign
     7827               p-return-attribute = true
     7828             .
     7829           end.
     7830           when 'doc-prt=request':u
     7831           then do:
     7832             assign
     7833               p-return-attribute = l-doc-prt
     7834             .
     7835           end.
     7836           when 'in-ov=request':u
     7837           then do:
     7838             assign
     7839               p-return-attribute = l-in-ov
     7840             .
     7841           end.
     7842           when 'shift-on=request':u
     7843           then do:
     7844             assign
     7845               p-return-attribute = l-shift-on
     7846             .
     7847           end.
     7848           when 'inout-price=request':u
     7849           then do:
     7850             assign
     7851               p-return-attribute = v-inout-price
     7852             .
     7853           end.
     7854           when 'exist-in-ov=request':u
     7855           then do:
     7856             if can-find (first buf_gds-obj no-lock
     7857               where buf_gds-obj.obj-type = p-obj-type
     7858                 and buf_gds-obj.obj-code = p-obj-code
     7859                 and buf_gds-obj.in-ov    = yes
     7860             )
     7861             and l-in-ov
     7862             then do:
     7863               assign
     7864                 p-return-attribute = true
     7865               .
     7866             end.
     7867             else do:
     7868               assign
     7869                 p-return-attribute = false
     7870               .
     7871             end.
     7872           end.
     7873           when 'autodate=request':u
     7874           then do:
     7875             define variable v-param-name    as character no-undo .
     7876             define variable v-default-value as logical   no-undo .
     7877             define variable v-value-character as character  no-undo .
     7878             define variable v-value-date      as date       no-undo .
     7879             define variable v-value-decimal   as decimal    no-undo .
     7880             define variable v-value-integer   as integer    no-undo .
     7881             define variable v-value-logical   as logical    no-undo .
     7882             define variable v-tth             as handle     no-undo .
     7883             define variable v-param-type      as character no-undo .
     7884             if l-shift-on = false
     7885             then do:
     7886                 assign
     7887                   v-param-name    = 'autodate':u
     7888                   v-default-value = yes
     7889                 .
     7890             end.
     7891             else do:
     7892                 assign
     7893                   v-param-name    = 'autodtsh':u
     7894                   v-default-value = no
     7895                 .
     7896             end.
     7897             run adm/shattri.p ( input "get":U
     7898                               , input  p-obj-type
     7899                               , input  p-obj-code
     7900                               , input  'obj-date':U
     7901                               , input  v-param-name
     7902                               , output v-value-character
     7903                               , output v-value-date
     7904                               , output v-value-decimal
     7905                               , output v-value-integer
     7906                               , output v-value-logical
     7907                               , output v-param-type
     7908                               , input-output table-handle v-tth
     7909                               ) no-error .
     7910             if error-status :error
     7911             then do:
     7912                 assign
     7913                   p-return-attribute   = v-default-value
     7914                 .
     7915             end.
     7916             else do:
     7917               assign
     7918                 p-return-attribute = v-value-logical
     7919               .
     7920             end.
     7921             delete object v-tth no-error.
     7922           end.
     7923           when 'active=request':u
     7924           then do:
     7925             define variable v-db-num as integer   no-undo .
     7926   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7927   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7928     (output v-db-num
     7929     ) no-error .
     7930             if error-status :error
     7931             then do:
     7932               message
     7933                 vss-workfile vss-revision vss-description skip
     7934                 "Ошибка при определении текущей БД" skip
     7935                 error-status :get-message(1) skip
     7936                 return-value skip
     7937                 view-as alert-box error .
     7938               undo, return error return-value .
     7939             end.
     7940             define buffer buf_clients for ub.clients .
     7941             find first buf_clients no-lock
     7942               where buf_clients.obj-type = p-obj-type
     7943                 and buf_clients.obj-code = p-obj-code
     7944               no-error.
     7945             if not available buf_clients
     7946             then do:
     7947               message
     7948                 vss-workfile vss-revision vss-description skip
     7949                 "Ошибка задания входных параметров" skip
     7950                 substitute("Не найден объект &1 &2.", p-obj-type, p-obj-code) skip
     7951                 view-as alert-box error .
     7952               undo, return error return-value .
     7953             end.
     7954             if buf_clients.db-num = v-db-num
     7955             then do:
     7956               assign
     7957                 p-return-attribute = yes
     7958               .
     7959             end.
     7960             else do:
     7961               assign
     7962                 p-return-attribute = no
     7963               .
     7964             end.
     7965           end.
     7966           when 'no-eq=request':u
     7967           then do:
     7968             assign
     7969               p-return-attribute = v-no-eq
     7970             .
     7971           end.
     7972           when 'price-calc=request':u
     7973           then do:
     7974             assign
     7975               p-return-attribute = v-price-calc
     7976             .
     7977           end.
     7978           otherwise do:
     7979             message
     7980               vss-workfile vss-revision vss-description skip
     7981               "Ошибка задания входных параметров" skip
     7982               "Объект" p-obj-type p-obj-code skip
     7983               "Список действий" p-action skip
     7984               "Действие" v-action skip
     7985               view-as alert-box error .
     7986             undo, return error return-value .
     7987           end.
     7988         end case .
     7989       end.
     7990     end.
     7991   end procedure.
     7992   procedure objretsp :
     7993     define input parameter  p-obj-type    like ub.gds-obj.obj-type no-undo .
     7994     define input parameter  p-obj-code    like ub.gds-obj.obj-code no-undo .
     7995     define output parameter p-ret-sup-pay like ub.store.ret-sup-pay no-undo .
     7996     define variable vss-description as character no-undo initial "objretsp-01: определение кода оплаты <<возврат поставщику>> для объекта".
     7997     define buffer buf_store for ub.store .
     7998     define buffer buf_shop  for ub.shop  .
     7999     do
     8000     on error undo, return error return-value
     8001     :
     8002       if p-obj-type = 'скл':U
     8003       then do:
     8004         find first buf_store no-lock
     8005           where buf_store.obj-code = p-obj-code
     8006           .
     8007         assign
     8008           p-ret-sup-pay = buf_store.ret-sup-pay
     8009         .
     8010       end.
     8011       else do:
     8012         find buf_shop no-lock
     8013           where buf_shop.obj-code = p-obj-code
     8014           .
     8015         assign
     8016           p-ret-sup-pay = buf_shop.ret-sup-pay
     8017         .
     8018       end.
     8019     end.
     8020   end procedure.
     8021   procedure objoutp :
     8022     define input parameter  p-obj-type like ub.gds-obj.obj-type no-undo .
     8023     define input parameter  p-obj-code like ub.gds-obj.obj-code no-undo .
     8024     define output parameter p-out-pay  like ub.store.out-pay no-undo .
     8025     define variable vss-description as character no-undo initial "objretsp-01: определение кода оплаты <<возврат поставщику>> для объекта".
     8026     define buffer buf_store for ub.store .
     8027     define buffer buf_shop  for ub.shop  .
     8028     do
     8029     on error undo, return error return-value
     8030     :
     8031       if p-obj-type = 'скл':U
     8032       then do:
     8033         find first buf_store no-lock
     8034           where buf_store.obj-code = p-obj-code
     8035           .
     8036         assign
     8037           p-out-pay = buf_store.out-pay
     8038         .
     8039       end.
     8040       else do:
     8041         find buf_shop no-lock
     8042           where buf_shop.obj-code = p-obj-code
     8043           .
     8044         assign
     8045           p-out-pay = buf_shop.out-pay
     8046         .
     8047       end.
     8048     end.
     8049   end procedure.
     8050   procedure objinpay :
     8051     define input parameter  p-obj-type like ub.gds-obj.obj-type no-undo .
     8052     define input parameter  p-obj-code like ub.gds-obj.obj-code no-undo .
     8053     define output parameter p-in-pay  like ub.store.in-pay no-undo .
     8054     define variable vss-description as character no-undo initial "objretsp-01: определение кода оплаты <<возврат поставщику>> для объекта".
     8055     define buffer buf_store for ub.store .
     8056     define buffer buf_shop  for ub.shop  .
     8057     do
     8058     on error undo, return error return-value
     8059     :
     8060       if p-obj-type = 'скл':U
     8061       then do:
     8062         find first buf_store no-lock
     8063           where buf_store.obj-code = p-obj-code
     8064           .
     8065         assign
     8066           p-in-pay = buf_store.in-pay
     8067         .
     8068       end.
     8069       else do:
     8070         find buf_shop no-lock
     8071           where buf_shop.obj-code = p-obj-code
     8072           .
     8073         assign
     8074           p-in-pay = buf_shop.in-pay
     8075         .
     8076       end.
     8077     end.
     8078   end procedure.
     8079   procedure objdnpay :
     8080     define input parameter  p-obj-type    like ub.gds-obj.obj-type no-undo .
     8081     define input parameter  p-obj-code    like ub.gds-obj.obj-code no-undo .
     8082     define output parameter p-down-pay    like ub.store.down-pay   no-undo .
     8083     define variable vss-description as character no-undo initial "objdnpay-01: определение кода оплаты списания для объекта".
     8084     define buffer buf_store for ub.store .
     8085     define buffer buf_shop  for ub.shop  .
     8086     do
     8087     on error undo, return error return-value
     8088     :
     8089       if p-obj-type = 'скл':U
     8090       then do:
     8091         find first buf_store no-lock
     8092           where buf_store.obj-code = p-obj-code
     8093           .
     8094         assign
     8095           p-down-pay = buf_store.down-pay
     8096         .
     8097       end.
     8098       else do:
     8099         find buf_shop no-lock
     8100           where buf_shop.obj-code = p-obj-code
     8101           .
     8102         assign
     8103           p-down-pay = buf_shop.down-pay
     8104         .
     8105       end.
     8106     end.
     8107   end procedure.
     8108   procedure objconsp :
     8109     define input parameter  p-obj-type  like ub.gds-obj.obj-type   no-undo .
     8110     define input parameter  p-obj-code  like ub.gds-obj.obj-code   no-undo .
     8111     define output parameter p-cons-code like ub.sysconf.purch-code no-undo .
     8112     define variable vss-description as character no-undo initial "objconsp-01: определение кода оплаты <<получение товара на консигнацию>> для объекта".
     8113     do
     8114     on error undo, return error return-value
     8115     :
     8116       assign
     8117         p-cons-code = integer('2':U)
     8118       .
     8119     end.
     8120   end procedure.
     8121   procedure objatext :
     8122     define input  parameter p-obj-type like ub.gds-obj.obj-type  no-undo .
     8123     define input  parameter p-obj-code like ub.gds-obj.obj-code  no-undo .
     8124     define input  parameter p-action   as character no-undo .
     8125     define output parameter p-value    as character no-undo .
     8126     define output parameter p-type     as character no-undo .
     8127     define variable vss-description as character no-undo initial "objatext-01: получение расширенного атрибута объекта".
     8128     do
     8129     on error undo, return error return-value
     8130     :
     8131       define variable v-action-code as character no-undo .
     8132       assign
     8133         v-action-code = entry(1, p-action, '=':u)
     8134       .
     8135       case p-action :
     8136         when "ret-sup-pay=request":u
     8137         then do:
     8138           run objretsp in this-procedure
     8139             (input  p-obj-type
     8140             ,input  p-obj-code
     8141             ,output p-value
     8142             ).
     8143           assign
     8144             p-type  = 'I':U
     8145           .
     8146         end.
     8147         when "cons-pay=request":u
     8148         then do:
     8149           run objconsp in this-procedure
     8150             (input  p-obj-type
     8151             ,input  p-obj-code
     8152             ,output p-value
     8153             ).
     8154           assign
     8155             p-type  = 'I':U
     8156           .
     8157         end.
     8158         when "out-pay=request":u
     8159         then do:
     8160           run objoutp in this-procedure
     8161             (input  p-obj-type
     8162             ,input  p-obj-code
     8163             ,output p-value
     8164             ).
     8165           assign
     8166             p-type  = 'I':U
     8167           .
     8168         end.
     8169         when "in-pay=request":u
     8170         then do:
     8171           run objinpay in this-procedure
     8172             (input  p-obj-type
     8173             ,input  p-obj-code
     8174             ,output p-value
     8175             ).
     8176           assign
     8177             p-type  = 'I':U
     8178           .
     8179         end.
     8180         otherwise do:
     8181           message
     8182             vss-workfile vss-revision vss-description skip
     8183             "Неизвестный параметр вызова." skip
     8184             "Объект" p-obj-type p-obj-code skip
     8185             "p-action" p-action skip
     8186             view-as alert-box error .
     8187           undo, return error return-value .
     8188         end.
     8189       end case .
     8190     end.
     8191   end procedure.
     8192   procedure prtcheck :
     8193     define input parameter p-doc-prt    as logical no-undo .
     8194     define input parameter p-node-code  like ub.gds-prt.node-code no-undo .
     8195     define input parameter p-root-node  like ub.gds-prt.node-code no-undo .
     8196     define variable vss-description as character no-undo initial "prtcheck-01: проверка допустимости признака для использования в gds-dtl".
     8197     if p-doc-prt   = ?
     8198     or p-node-code = ?
     8199     or p-root-node = ?
     8200     then do:
     8201       message
     8202         vss-workfile vss-revision vss-description skip
     8203         "Входные параметры должны быть определены" skip
     8204         "p-doc-prt"   p-doc-prt   skip
     8205         "p-node-code" p-node-code skip
     8206         "p-node-code" p-node-code skip
     8207         "p-root-node" p-root-node skip
     8208         "p-root-node" p-root-node skip
     8209         view-as alert-box error .
     8210       undo, return error return-value .
     8211     end.
     8212     if p-doc-prt
     8213     then do:
     8214       define variable l-terminal-prt as logical no-undo .
     8215   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     8216     (input  p-node-code
     8217     ,input  'terminal-prt=request':U
     8218     ,output l-terminal-prt
     8219     ) no-error .
     8220       if error-status :error
     8221       then do:
     8222         message
     8223           vss-workfile vss-revision vss-description skip
     8224           "Ошибка при определении атрибута признака" skip
     8225           "p-node-code" p-node-code skip
     8226           "Запрашивался атрибут" "terminal-prt=request"
     8227           error-status:get-message(1) skip
     8228           return-value skip
     8229           view-as alert-box error .
     8230         undo, return error return-value .
     8231       end.
     8232       if l-terminal-prt <> true
     8233       then do:
     8234         undo, return error
     8235           vss-workfile + "Недопустимый признак" + chr(10)
     8236           + "На объекте включены признаки" + chr(10)
     8237           + "Указанный признак не является терминальным" + chr(10)
     8238           + "p-node-code " + string(p-node-code) + chr(10)
     8239           + "p-root-node " + string(p-root-node) + chr(10)
     8240           .
     8241       end.
     8242     end.
     8243     else do:
     8244       if p-node-code <> p-root-node
     8245       then do:
     8246         message
     8247           vss-workfile vss-revision vss-description skip
     8248           "Недопустимый признак" skip
     8249           "На объекте выключены признаки" skip
     8250           "Указанный признак не является корневым" skip
     8251           "p-node-code" p-node-code skip
     8252           error-status:get-message(1) skip
     8253           return-value skip
     8254           view-as alert-box error .
     8255         undo, return error
     8256           vss-workfile + "Недопустимый признак" + chr(10)
     8257           + "На объекте выключены признаки" + chr(10)
     8258           + "Указанный признак не является корневым" + chr(10)
     8259           + "p-node-code " + string(p-node-code) + chr(10)
     8260           + "p-root-node " + string(p-root-node) + chr(10)
     8261           .
     8262       end.
     8263     end.
     8264   end procedure.
     8265   procedure prtat :
     8266     define input  parameter p-node-code        like ub.gds-prt.node-code no-undo .
     8267     define input  parameter p-action           as character              no-undo .
     8268     define output parameter p-return-attribute as logical                no-undo .
     8269     define variable vss-description as character no-undo initial "prtat-01: Получить атрибут шкалы/признака".
     8270     define variable ind      as integer   no-undo .
     8271     define variable v-action as character no-undo .
     8272     define buffer buf_gds-prt for ub.gds-prt .
     8273     find first buf_gds-prt no-lock
     8274       where buf_gds-prt.node-code = p-node-code
     8275       no-error .
     8276     if not available buf_gds-prt
     8277     then do:
     8278       message
     8279         vss-workfile vss-revision vss-description skip
     8280         "Не найдена шкала." skip
     8281         "p-node-code" p-node-code skip
     8282         "p-action"    p-action skip
     8283         view-as alert-box error .
     8284       undo, return error return-value .
     8285     end.
     8286     define variable v-num-entries-p-action as integer no-undo .
     8287     assign
     8288       v-num-entries-p-action = num-entries(p-action)
     8289     .
     8290     do ind = 1 to v-num-entries-p-action
     8291     :
     8292       assign
     8293         v-action = entry(ind, p-action)
     8294       .
     8295       case v-action :
     8296         when 'empty-scale=request'
     8297         then do:
     8298           if buf_gds-prt.root <> true
     8299           then do:
     8300             message
     8301               vss-workfile vss-revision vss-description skip
     8302               "Переданный признак не является корнем шкалы." skip
     8303               "p-node-code" p-node-code skip
     8304               "p-action"    v-action skip
     8305               view-as alert-box error .
     8306             undo, return error return-value .
     8307           end.
     8308           assign
     8309             p-return-attribute = (buf_gds-prt.node-name = '_Пустая шкала':U )
     8310           .
     8311         end.
     8312         when 'terminal-prt=request'
     8313         then do:
     8314           define variable l-terminal-prt as logical no-undo .
     8315           assign
     8316             l-terminal-prt = true
     8317           .
     8318           define buffer terminal_gds-prt for ub.gds-prt .
     8319           find first terminal_gds-prt no-lock
     8320             where terminal_gds-prt.upper-code = p-node-code
     8321             no-error .
     8322           if available terminal_gds-prt
     8323           then do:
     8324             assign
     8325               l-terminal-prt = false
     8326             .
     8327           end.
     8328           assign
     8329             p-return-attribute = l-terminal-prt
     8330           .
     8331         end.
     8332         otherwise do:
     8333           message
     8334             vss-workfile vss-revision vss-description skip
     8335             "Неизвестный параметр вызова." skip
     8336             "p-node-code" p-node-code skip
     8337             "p-action" p-action skip
     8338             "v-action" v-action skip
     8339             view-as alert-box error .
     8340           undo, return error return-value .
     8341         end.
     8342       end case .
     8343     end.
     8344   end procedure.
     8345   define temp-table temp-pl-gds no-undo
     8346     field pl-code          like ub.pl-gds.pl-code
     8347     field fact-qnty        like ub.pl-gds.fact-qnty
     8348     field free-qnty        like ub.pl-gds.free-qnty
     8349     field db-fact-qnty     like ub.pl-gds.fact-qnty
     8350     field db-free-qnty     like ub.pl-gds.free-qnty
     8351     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
     8352     field cli-free-qnty    like ub.pl-gds.cli-free-qnty
     8353     field db-cli-fact-qnty like ub.pl-gds.cli-fact-qnty
     8354     field db-cli-free-qnty like ub.pl-gds.cli-free-qnty
     8355     index xpk is primary unique pl-code
     8356   .
     8357   procedure gdscheck :
     8358     define input parameter p-obj-type  like ub.gds-obj.obj-type  no-undo .
     8359     define input parameter p-obj-code  like ub.gds-obj.obj-code  no-undo .
     8360     define input parameter p-artic     like ub.gds-obj.artic     no-undo .
     8361     define input parameter p-prod-type like ub.gds-obj.prod-type no-undo .
     8362     define input parameter p-prod-code like ub.gds-obj.prod-code no-undo .
     8363     define input parameter p-root-node like ub.prt-obj.prt-code  no-undo .
     8364     define input parameter p-mode      as character              no-undo .
     8365     define variable vss-description as character no-undo initial "gdscheck-01: Проверка целостности товара" .
     8366     define buffer buf_goods       for ub.goods .
     8367     define buffer buf_gds-obj     for ub.gds-obj .
     8368     define buffer buf_prt-obj     for ub.prt-obj .
     8369     define buffer buf_parts       for ub.parts .
     8370     define buffer buf_units       for ub.units .
     8371     define buffer buf_contract    for ub.contract .
     8372     define buffer buf_temp-pl-gds for temp-pl-gds .
     8373     define buffer buf_pl-gds      for ub.pl-gds .
     8374     define variable l-bad-gds   as logical  initial true .
     8375     define variable v-host-code as integer   no-undo .
     8376     define variable v-message as character no-undo .
     8377     if  p-mode <> ""
     8378     and p-mode <> ?
     8379     and p-mode <> "return"
     8380     then do:
     8381       message
     8382         vss-workfile vss-revision vss-description skip
     8383         "Неизвестное значение параметра p-mode" skip
     8384         "p-mode" p-mode skip
     8385         view-as alert-box information.
     8386       undo, return error return-value .
     8387     end.
     8388     assign
     8389       v-message = "Объект" + " " + string(p-obj-type) + " " + string(p-obj-code) + chr(10)
     8390                 + "Товар" + " " + string(p-artic) + " "
     8391                   + string(p-prod-type) + " " + string(p-prod-code) + chr(10)
     8392     .
     8393     check_block:
     8394     do
     8395     on error undo check_block, leave
     8396     :
     8397       assign
     8398         l-bad-gds = false
     8399       .
     8400       find first buf_goods no-lock
     8401         where buf_goods.artic     = p-artic
     8402           and buf_goods.prod-type = p-prod-type
     8403           and buf_goods.prod-code = p-prod-code
     8404         no-error .
     8405       if not available buf_goods
     8406       then do:
     8407         assign
     8408           v-message = v-message
     8409                     + "Не найдена запись товар" + chr(10)
     8410           l-bad-gds = true
     8411         .
     8412         leave check_block.
     8413       end.
     8414       if buf_goods.PS begins "123321"
     8415       then do:
     8416         return .
     8417       end.
     8418   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8420     (input  p-obj-type
     8421     ,input  p-obj-code
     8422     ,output v-host-code
     8423     ) no-error .
     8424       if error-status :error
     8425       then do:
     8426         message
     8427           vss-workfile vss-revision vss-description skip
     8428           "Ошибка при определении кода фирмы для объекта" skip
     8429           "Объект" p-obj-type p-obj-code skip
     8430           error-status :get-message(1) skip
     8431           return-value skip
     8432           view-as alert-box error .
     8433         undo, return error return-value .
     8434       end.
     8435       define variable l-goods-twounit as logical no-undo .
     8436   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8437   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8438     (input  buf_goods.artic
     8439     ,input  buf_goods.prod-type
     8440     ,input  buf_goods.prod-code
     8441     ,input  'twounit=request':U
     8442     ,output l-goods-twounit
     8443     ) no-error .
     8444       if error-status :error
     8445       then do:
     8446         message
     8447           vss-workfile vss-revision vss-description skip
     8448           "Ошибка при определении атрибута товара" skip
     8449           "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     8450           'twounit=request':u skip
     8451           error-status :get-message(1) skip
     8452           return-value skip
     8453           view-as alert-box error .
     8454         undo, return error return-value .
     8455       end.
     8456       find first buf_gds-obj exclusive-lock
     8457         where buf_gds-obj.obj-type  = p-obj-type
     8458           and buf_gds-obj.obj-code  = p-obj-code
     8459           and buf_gds-obj.artic     = p-artic
     8460           and buf_gds-obj.prod-type = p-prod-type
     8461           and buf_gds-obj.prod-code = p-prod-code
     8462         no-error .
     8463       if not available buf_gds-obj
     8464       then do:
     8465         assign
     8466           v-message = v-message
     8467                     + "Не найдена запись товара на объекте" + chr(10)
     8468           l-bad-gds = true
     8469         .
     8470         leave check_block.
     8471       end.
     8472       if p-root-node = ?
     8473       then do:
     8474   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     8476     (input  p-artic
     8477     ,input  p-prod-type
     8478     ,input  p-prod-code
     8479     ,output p-root-node
     8480     ) no-error .
     8481         if error-status :error
     8482         then do:
     8483           assign
     8484             v-message = v-message
     8485                       + "Не найден корень шкалы" + chr(10)
     8486             l-bad-gds = true
     8487           .
     8488           leave check_block.
     8489         end.
     8490       end.
     8491       define variable v-total-prt-obj-fact-qnty like buf_prt-obj.fact-qnty no-undo .
     8492       define variable v-total-prt-obj-free-qnty like buf_prt-obj.free-qnty no-undo .
     8493       assign
     8494         v-total-prt-obj-fact-qnty = 0
     8495         v-total-prt-obj-free-qnty = 0
     8496       .
     8497       for each buf_prt-obj share-lock
     8498         where buf_prt-obj.obj-type  = p-obj-type
     8499           and buf_prt-obj.obj-code  = p-obj-code
     8500           and buf_prt-obj.artic     = p-artic
     8501           and buf_prt-obj.prod-type = p-prod-type
     8502           and buf_prt-obj.prod-code = p-prod-code
     8503           and buf_prt-obj.prt-code  = p-root-node
     8504       on error undo check_block, leave check_block
     8505       :
     8506         assign
     8507           v-total-prt-obj-fact-qnty = v-total-prt-obj-fact-qnty + buf_prt-obj.fact-qnty
     8508           v-total-prt-obj-free-qnty = v-total-prt-obj-free-qnty + buf_prt-obj.free-qnty
     8509         .
     8510       end.
     8511       if v-total-prt-obj-fact-qnty <> buf_gds-obj.fact-qnty
     8512       or v-total-prt-obj-free-qnty <> buf_gds-obj.free-qnty
     8513       then do:
     8514         assign
     8515           v-message = v-message
     8516                     + "Количество по шкале не совпадает с количеством по товару" + chr(10)
     8517                     + "По товару:" + chr(10)
     8518                     + "  " + "фактически" + " " + string(buf_gds-obj.fact-qnty) + chr(10)
     8519                     + "  " + "свободно" + " " + string(buf_gds-obj.free-qnty) + chr(10)
     8520                     + "По шкале:" + chr(10)
     8521                     + "  " + "фактически" + " " + string(v-total-prt-obj-fact-qnty) + chr(10)
     8522                     + "  " + "свободно" + " " + string(v-total-prt-obj-free-qnty) + chr(10)
     8523           l-bad-gds = true
     8524         .
     8525         leave check_block.
     8526       end.
     8527       find first buf_units no-lock
     8528         where buf_units.unit-name = buf_goods.unit-base
     8529         no-error .
     8530       if not available buf_units
     8531       then do:
     8532         assign
     8533           v-message = v-message
     8534                     + "Не найдена базовая единица измерения"
     8535                     + string(buf_goods.unit-base) + chr(10)
     8536           l-bad-gds = true
     8537         .
     8538         leave check_block.
     8539       end.
     8540       define variable l-goods-serial as logical no-undo .
     8541   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8543     (input  buf_goods.artic
     8544     ,input  buf_goods.prod-type
     8545     ,input  buf_goods.prod-code
     8546     ,input  'serial=request':u
     8547     ,output l-goods-serial
     8548     ) no-error .
     8549       if error-status :error
     8550       then do:
     8551         message
     8552           vss-workfile vss-revision vss-description skip
     8553           "Ошибка при определении атрибута товара" skip
     8554           "Артикул" buf_goods.artic buf_goods.prod-type buf_goods.prod-code skip
     8555           'twounit=request':u skip
     8556           error-status :get-message(1) skip
     8557           return-value skip
     8558           view-as alert-box error .
     8559         undo, return error return-value .
     8560       end.
     8561       if l-goods-serial = true
     8562       then do:
     8563         if buf_gds-obj.cash-parts <> true
     8564         then do:
     8565           assign
     8566             v-message = v-message
     8567                       + "У серийного товара отсутствует признак продажи по партиям (cash-parts)"
     8568                       + chr(10)
     8569             l-bad-gds = true
     8570           .
     8571           leave check_block.
     8572         end.
     8573       end.
     8574       if  lookup('топ':U,  buf_units.type) > 0
     8575       and lookup('дро':U, buf_units.type) > 0
     8576       then do:
     8577         if buf_gds-obj.place-rsrv <> true
     8578         then do:
     8579           assign
     8580             v-message = v-message
     8581                       + "У дробного топливного товара отсутствует признак учета по местам хранения (place-rsrv)"
     8582                       + chr(10)
     8583             l-bad-gds = true
     8584           .
     8585           leave check_block.
     8586         end.
     8587       end.
     8588       if buf_gds-obj.place-rsrv = true
     8589       then do:
     8590         for each buf_temp-pl-gds
     8591         on error undo, return error return-value
     8592         :
     8593           delete buf_temp-pl-gds .
     8594         end.
     8595         for each buf_pl-gds share-lock
     8596           where buf_pl-gds.gds-code = buf_goods.gds-code
     8597             and buf_pl-gds.obj-type = p-obj-type
     8598             and buf_pl-gds.obj-code = p-obj-code
     8599         on error undo, return error return-value
     8600         :
     8601           create buf_temp-pl-gds .
     8602           assign
     8603             buf_temp-pl-gds.pl-code      = buf_pl-gds.pl-code
     8604             buf_temp-pl-gds.fact-qnty    = 0.0
     8605             buf_temp-pl-gds.free-qnty    = 0.0
     8606             buf_temp-pl-gds.db-fact-qnty = buf_pl-gds.fact-qnty
     8607             buf_temp-pl-gds.db-free-qnty = buf_pl-gds.free-qnty
     8608           .
     8609         end.
     8610       end.
     8611       define variable v-parts-fact-qnty     as decimal no-undo .
     8612       define variable v-parts-free-qnty     as decimal no-undo .
     8613       define variable v-parts-cli-qnty      as decimal no-undo .
     8614       define variable v-parts-add-fact-qnty as decimal no-undo .
     8615       define variable v-parts-add-free-qnty as decimal no-undo .
     8616       define buffer buf_trn-doc for ub.trn-doc .
     8617       assign
     8618         v-parts-fact-qnty = 0
     8619         v-parts-free-qnty = 0
     8620         v-parts-cli-qnty  = 0
     8621       .
     8622       for each buf_parts share-lock
     8623         where buf_parts.obj-type  = p-obj-type
     8624           and buf_parts.obj-code  = p-obj-code
     8625           and buf_parts.artic     = p-artic
     8626           and buf_parts.prod-type = p-prod-type
     8627           and buf_parts.prod-code = p-prod-code
     8628           and buf_parts.status_   = no
     8629           and buf_parts.rsrv-free = yes
     8630       on error undo check_block, leave check_block
     8631       :
     8632         assign
     8633           v-parts-add-fact-qnty = 0.0
     8634           v-parts-add-free-qnty = 0.0
     8635         .
     8636         if buf_parts.out-code = 'out-zone':U
     8637         then do:
     8638           assign
     8639             v-message = v-message
     8640                       + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8641                       + "в расходной зоне логически принадлежит приходной зоне (rsrv-free=yes)" + chr(10)
     8642             l-bad-gds = true
     8643           .
     8644           leave check_block.
     8645         end.
     8646         if buf_gds-obj.place-rsrv = true
     8647           and ( buf_parts.pl-code = ?
     8648                 or buf_parts.pl-code = 0
     8649               )
     8650         then do:
     8651           assign
     8652             v-message = v-message
     8653                       + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8654                       + "Имеет не заданное складское место (pl-code)" + chr(10)
     8655             l-bad-gds = true
     8656           .
     8657           leave check_block.
     8658         end.
     8659         if buf_parts.out-code = 'free-zone':U
     8660         then do:
     8661           assign
     8662             v-parts-add-fact-qnty = v-parts-add-fact-qnty + buf_parts.qnty
     8663             v-parts-add-free-qnty = v-parts-add-free-qnty + buf_parts.qnty
     8664           .
     8665         end.
     8666         else do:
     8667           find first buf_trn-doc no-lock
     8668             where buf_trn-doc.doc-code = buf_parts.out-code
     8669             no-error .
     8670           if not available buf_trn-doc
     8671           then do:
     8672             assign
     8673               v-message = v-message
     8674                         + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8675                         + "Не найден документ для которого зарезервирована партия" + chr(10)
     8676                         + "Документ" + " " + string(buf_parts.out-code) + chr(10)
     8677               l-bad-gds = true
     8678             .
     8679             leave check_block.
     8680           end.
     8681           if buf_parts.in-code <> buf_parts.out-code
     8682           then do:
     8683             assign
     8684               v-parts-add-fact-qnty = v-parts-add-fact-qnty + abs(buf_parts.qnty)
     8685             .
     8686           end.
     8687           if buf_trn-doc.doc-type = 'инв':U
     8688           then do:
     8689             if buf_parts.qnty > 0
     8690             then do:
     8691               assign
     8692                 v-message = v-message
     8693                           + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8694                           + "Зарезервированная за документом инвентаризации" + " "
     8695                             + string(buf_parts.out-code) + chr(10)
     8696                           + "Имеет положительный знак количества" + chr(10)
     8697                           + "  " + "buf_trn-doc.doc-type" + " " + string(buf_trn-doc.doc-type) + chr(10)
     8698                           + "  " + "buf_parts.qnty" + " " + string(buf_parts.qnty) + chr(10)
     8699                 l-bad-gds = true
     8700               .
     8701               leave check_block.
     8702             end.
     8703             if buf_parts.in-code <> buf_parts.out-code
     8704             then do:
     8705               assign
     8706                 v-parts-add-free-qnty = v-parts-add-free-qnty + abs(buf_parts.qnty)
     8707               .
     8708             end.
     8709           end.
     8710           else do:
     8711             if buf_parts.qnty < 0
     8712             then do:
     8713               assign
     8714                 v-message = v-message
     8715                           + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8716                           + "Зарезервированная за документом" + " " + string(buf_parts.out-code) + chr(10)
     8717                           + "Имеет отрицательный знак количества" + chr(10)
     8718                           + "  " + "buf_trn-doc.doc-type" + " " + string(buf_trn-doc.doc-type) + chr(10)
     8719                           + "  " + "buf_parts.qnty" + " " + string(buf_parts.qnty) + chr(10)
     8720                 l-bad-gds = true
     8721               .
     8722               leave check_block.
     8723             end.
     8724             if buf_parts.in-code = buf_parts.out-code
     8725             then do:
     8726               assign
     8727                 v-parts-add-free-qnty = v-parts-add-free-qnty - abs(buf_parts.qnty)
     8728               .
     8729             end.
     8730           end.
     8731         end.
     8732         assign
     8733           v-parts-fact-qnty = v-parts-fact-qnty + v-parts-add-fact-qnty
     8734           v-parts-free-qnty = v-parts-free-qnty + v-parts-add-free-qnty
     8735         .
     8736         if buf_gds-obj.place-rsrv = true then do:
     8737           find first buf_temp-pl-gds
     8738             where buf_temp-pl-gds.pl-code = buf_parts.pl-code
     8739             no-error .
     8740           if not available buf_temp-pl-gds then do:
     8741             create buf_temp-pl-gds .
     8742             assign
     8743               buf_temp-pl-gds.pl-code = buf_parts.pl-code
     8744             .
     8745           end.
     8746           assign
     8747             buf_temp-pl-gds.fact-qnty = buf_temp-pl-gds.fact-qnty + v-parts-add-fact-qnty
     8748             buf_temp-pl-gds.free-qnty = buf_temp-pl-gds.free-qnty + v-parts-add-free-qnty
     8749           .
     8750         end.
     8751         if buf_parts.contract-code = ?
     8752         then do:
     8753           assign
     8754             v-message = v-message
     8755                       + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8756                       + "Неопределённое значение поля contract-code" + chr(10)
     8757             l-bad-gds = true
     8758           .
     8759           leave check_block.
     8760         end.
     8761         if buf_parts.contract-code <> 0
     8762         then do:
     8763           find first buf_contract no-lock
     8764             where buf_contract.host-code     = v-host-code
     8765               and buf_contract.contract-code = buf_parts.contract-code
     8766             no-error .
     8767           if not available buf_contract
     8768           then do:
     8769             assign
     8770               v-message = v-message
     8771                         + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8772                         + substitute("Не найден контракт партии") + chr(10)
     8773                         + substitute("Код фирмы &1", v-host-code) + chr(10)
     8774                         + substitute("Код контракта &1", buf_parts.contract-code) + chr(10)
     8775               l-bad-gds = true
     8776             .
     8777             leave check_block.
     8778           end.
     8779           if buf_parts.supp-type <> buf_contract.cli-type
     8780           or buf_parts.supp-code <> buf_contract.cli-code
     8781           then do:
     8782             if not buf_contract.doc-type = 'рас':U then do:
     8783             assign
     8784               v-message = v-message
     8785                         + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8786                         + substitute("Отличаются поставщик партии и контрагент договора") + chr(10)
     8787                         + substitute("Поставщик партии &1 &2", buf_parts.supp-type, buf_parts.supp-code) + chr(10)
     8788                         + substitute("Контрагент договора &1 &2",buf_contract.cli-type, buf_contract.cli-code) + chr(10)
     8789                         + substitute("Код фирмы &1", v-host-code) + chr(10)
     8790                         + substitute("Код контракта &1", buf_contract.contract-code) + chr(10)
     8791               l-bad-gds = true
     8792             .
     8793             leave check_block.
     8794           end.
     8795           end.
     8796           if  buf_parts.supp-type = 'орг':U
     8797           and buf_parts.supp-code = v-host-code
     8798           then do:
     8799             assign
     8800               v-message = v-message
     8801                         + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8802                         + substitute("Нельзя указывать контракт для партии, поставщиком которой является собственная фирма") + chr(10)
     8803                         + substitute("Поставщик партии &1 &2", buf_parts.supp-type, buf_parts.supp-code) + chr(10)
     8804                         + substitute("Контрагент договора &1 &2",buf_contract.cli-type, buf_contract.cli-code) + chr(10)
     8805                         + substitute("Код фирмы &1", v-host-code) + chr(10)
     8806                         + substitute("Код контракта &1", buf_contract.contract-code) + chr(10)
     8807               l-bad-gds = true
     8808             .
     8809             leave check_block.
     8810           end.
     8811           if buf_parts.exch-code <> buf_contract.curr-code
     8812           then do:
     8813             assign
     8814               v-message = v-message
     8815                         + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8816                         + "Не совпадают валюта партии и валюта контракта" + chr(10)
     8817                         + substitute("Валюта партии &1", buf_parts.exch-code) + chr(10)
     8818                         + substitute("Валюта контракта &1", buf_contract.curr-code) + chr(10)
     8819               l-bad-gds = true
     8820             .
     8821             leave check_block.
     8822           end.
     8823           define variable v-contract-purch-code as integer   no-undo .
     8824   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cntpurch in g#library
     8826     (input  buf_contract.contract-type
     8827     ,output v-contract-purch-code
     8828     ) no-error .
     8829           if error-status :error
     8830           then do:
     8831             message
     8832               vss-workfile vss-revision vss-description skip
     8833               "Ошибка при определении типа поставки для контракта" skip
     8834               "Код фирмы" v-host-code skip
     8835               "Код контракта" buf_contract.contract-code skip
     8836               "Тип контракта" buf_contract.contract-type skip
     8837               error-status :get-message(1) skip
     8838               return-value skip
     8839               view-as alert-box error .
     8840             undo, return error return-value .
     8841           end.
     8842           if v-contract-purch-code = 3
     8843           then do:
     8844             if  buf_parts.purch-code <> 3
     8845             and buf_parts.purch-code <> 1
     8846             then do:
     8847               assign
     8848                 v-message = v-message
     8849                           + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8850                           + "Не совпадают тип поставки партии и тип поставки контракта" + chr(10)
     8851                           + substitute("Код фирмы &1", v-host-code) + chr(10)
     8852                           + substitute("Код контракта &1", buf_contract.contract-code) + chr(10)
     8853                           + substitute("Тип поставки партии &1", buf_parts.purch-code) + chr(10)
     8854                           + substitute("Тип поставки контракта &1", v-contract-purch-code) + chr(10)
     8855                 l-bad-gds = true
     8856               .
     8857               leave check_block.
     8858             end.
     8859           end.
     8860           else do:
     8861             if buf_parts.purch-code <> v-contract-purch-code
     8862             then do:
     8863               assign
     8864                 v-message = v-message
     8865                           + "Партия по ПН" + " " + string(buf_parts.in-code) + chr(10)
     8866                           + "Не совпадают тип поставки партии и тип поставки контракта" + chr(10)
     8867                           + substitute("Код фирмы &1", v-host-code) + chr(10)
     8868                           + substitute("Код контракта &1", buf_contract.contract-code) + chr(10)
     8869                           + substitute("Тип поставки партии &1", buf_parts.purch-code) + chr(10)
     8870                           + substitute("Тип поставки контракта &1", v-contract-purch-code) + chr(10)
     8871                 l-bad-gds = true
     8872               .
     8873               leave check_block.
     8874             end.
     8875           end.
     8876         end.
     8877         if l-goods-twounit
     8878         then do:
     8879           if buf_parts.out-code = 'free-zone':U
     8880           then do:
     8881             assign
     8882               v-parts-cli-qnty = v-parts-cli-qnty + buf_parts.cli-qnty
     8883             .
     8884           end.
     8885           else do:
     8886             if buf_parts.in-code <> buf_parts.out-code
     8887             then do:
     8888               assign
     8889                 v-parts-cli-qnty = v-parts-cli-qnty + abs(buf_parts.cli-qnty)
     8890               .
     8891             end.
     8892           end.
     8893         end.
     8894       end.
     8895       if buf_gds-obj.place-rsrv = true
     8896       then do:
     8897         define variable is-petrol as logical no-undo .
     8898         define variable is-pieces as logical no-undo .
     8899   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     8900     (
     8901        input buf_goods.artic
     8902     ,  input buf_goods.prod-type
     8903     ,  input buf_goods.prod-code
     8904     , output is-petrol
     8905     , output is-pieces
     8906     ) no-error.
     8907         if error-status :error
     8908         then do:
     8909           assign
     8910             is-petrol = ?
     8911             is-pieces = ?
     8912           .
     8913         end.
     8914         if not( is-petrol = true
     8915                 and is-pieces = false
     8916               )
     8917         then do:
     8918           for each buf_temp-pl-gds
     8919           on error undo check_block, leave check_block
     8920           :
     8921             if buf_temp-pl-gds.db-fact-qnty <> buf_temp-pl-gds.fact-qnty
     8922             or buf_temp-pl-gds.db-free-qnty <> buf_temp-pl-gds.free-qnty
     8923             then do:
     8924               assign
     8925                 v-message = v-message
     8926                           + "Количество по партиям свободной зоны и зарезервированным партиям" + chr(10)
     8927                           + "не совпадает с количеством по месту резервирования" + chr(10)
     8928                           + "Место хранения:" + " " + string(buf_temp-pl-gds.pl-code) + chr(10)
     8929                           + "  " + "фактически" + " " + string(buf_temp-pl-gds.db-fact-qnty) + chr(10)
     8930                           + "  " + "свободно" + " " + string(buf_temp-pl-gds.db-free-qnty) + chr(10)
     8931                           + "По партиям:" + chr(10)
     8932                           + "  " + "фактически" + " " + string(buf_temp-pl-gds.fact-qnty) + chr(10)
     8933                           + "  " + "свободно" + " " + string(buf_temp-pl-gds.free-qnty) + chr(10)
     8934                 l-bad-gds = true
     8935               .
     8936               leave check_block.
     8937             end.
     8938           end.
     8939         end.
     8940       end.
     8941       if v-parts-fact-qnty <> buf_gds-obj.fact-qnty
     8942       or v-parts-free-qnty <> buf_gds-obj.free-qnty
     8943       then do:
     8944         assign
     8945           v-message = v-message
     8946                     + "Количество по партиям свободной зоны и зарезервированным партиям" + chr(10)
     8947                     + "не совпадает с количеством по товару" + chr(10)
     8948                     + "По товару:" + chr(10)
     8949                     + "  " + "фактически" + " " + string(buf_gds-obj.fact-qnty) + chr(10)
     8950                     + "  " + "свободно" + " " + string(buf_gds-obj.free-qnty) + chr(10)
     8951                     + "По партиям:" + chr(10)
     8952                     + "  " + "фактически" + " " + string(v-parts-fact-qnty) + chr(10)
     8953                     + "  " + "свободно" + " " + string(v-parts-free-qnty) + chr(10)
     8954           l-bad-gds = true
     8955         .
     8956         leave check_block.
     8957       end.
     8958       if l-goods-twounit
     8959       then do:
     8960         if v-parts-cli-qnty <> buf_gds-obj.fact-cli-qnty
     8961         then do:
     8962           assign
     8963             v-message = v-message
     8964                       + "Количество второй единицы измерения по партиям свободной зоны и зарезервированным партиям" + chr(10)
     8965                       + "не совпадает с количеством второй единицы измерения по товару" + chr(10)
     8966                       + "По товару:" + chr(10)
     8967                       + "  " + "фактически" + " " + string(buf_gds-obj.fact-qnty) + chr(10)
     8968                       + "  " + "свободно" + " " + string(buf_gds-obj.free-qnty) + chr(10)
     8969                       + "  " + "вторая ед. изм." + " " + string(buf_gds-obj.fact-cli-qnty) + chr(10)
     8970                       + "По партиям:" + chr(10)
     8971                       + "  " + "фактически" + " " + string(v-parts-fact-qnty) + chr(10)
     8972                       + "  " + "свободно" + " " + string(v-parts-free-qnty) + chr(10)
     8973                       + "  " + "вторая ед. изм." + " " + string(v-parts-cli-qnty) + chr(10)
     8974             l-bad-gds = true
     8975           .
     8976           leave check_block.
     8977         end.
     8978       end.
     8979     end.
     8980     if l-bad-gds
     8981     then do:
     8982       define variable v-return-value as character no-undo .
     8983       if p-mode = ""
     8984       or p-mode = ?
     8985       then do:
     8986         message
     8987           vss-workfile + " " + vss-revision + " " + vss-description + chr(10)
     8988           v-message + chr(10)
     8989           view-as alert-box .
     8990       end.
     8991       if p-mode = "return"
     8992       then do:
     8993         assign
     8994           v-return-value = v-message
     8995         .
     8996       end.
     8997       undo, return error v-return-value .
     8998     end.
     8999   end procedure.
     9000   procedure prtlevel :
     9001     define input  parameter p-root-node  like ub.gds-prt.node-code no-undo .
     9002     define output parameter p-prt-level  as integer no-undo .
     9003     define variable vss-description as character no-undo initial "prtlevel-01: определяет количество уровней в шкале".
     9004     do
     9005     on error undo, return error return-value
     9006     :
     9007       define buffer buf_gds-prt for ub.gds-prt .
     9008       find first buf_gds-prt no-lock
     9009         where buf_gds-prt.node-code = p-root-node
     9010         use-index level
     9011         no-error.
     9012       if not available buf_gds-prt
     9013       then do:
     9014         message
     9015           vss-workfile vss-revision vss-description skip
     9016           "Ошибка задания входных параметров" skip
     9017           "Не найдена шкала" skip
     9018           "p-root-node" p-root-node skip
     9019           view-as alert-box error .
     9020         undo, return error return-value .
     9021       end.
     9022       if buf_gds-prt.root <> true
     9023       then do:
     9024         message
     9025           vss-workfile vss-revision vss-description skip
     9026           "Переданный признак не является корнем шкалы." skip
     9027           "p-root-node" p-root-node skip
     9028           view-as alert-box error .
     9029         undo, return error return-value .
     9030       end.
     9031       assign
     9032         p-prt-level = 1
     9033       .
     9034       define variable terminal-n-c like ub.gds-prt.node-code no-undo .
     9035       assign
     9036         terminal-n-c = p-root-node
     9037       .
     9038       do while true:
     9039         find first buf_gds-prt no-lock
     9040           where buf_gds-prt.upper-code = terminal-n-c
     9041           use-index level
     9042           no-error.
     9043         if not available buf_gds-prt
     9044         then do:
     9045           return .
     9046         end.
     9047         assign
     9048           p-prt-level  = p-prt-level + 1
     9049           terminal-n-c = buf_gds-prt.node-code
     9050         .
     9051       end.
     9052     end.
     9053   end procedure.
     9054   procedure termnode :
     9055     define input parameter  p-node-code  like ub.gds-prt.node-code no-undo .
     9056     define output parameter terminal-n-c like ub.gds-prt.node-code no-undo .
     9057     define variable vss-description as character no-undo initial "termnode-01: определение первого терминального признака для указанного признака".
     9058     define buffer terminal_gds-prt for ub.gds-prt .
     9059     assign
     9060       terminal-n-c = p-node-code
     9061     .
     9062     do while true:
     9063       find first terminal_gds-prt no-lock
     9064         where terminal_gds-prt.upper-code = terminal-n-c
     9065         use-index level
     9066         no-error.
     9067       if not available terminal_gds-prt
     9068       then do:
     9069         return .
     9070       end.
     9071       assign
     9072         terminal-n-c = terminal_gds-prt.node-code
     9073       .
     9074     end.
     9075   end procedure.
     9076   procedure cligdscr :
     9077     define input parameter  v-cli-type  like ub.cli-gds.cli-type  no-undo .
     9078     define input parameter  v-cli-code  like ub.cli-gds.cli-code  no-undo .
     9079     define input parameter  v-host-code like ub.cli-gds.host-code no-undo .
     9080     define input parameter  v-artic     like ub.cli-gds.artic     no-undo .
     9081     define input parameter  v-prod-type like ub.cli-gds.prod-type no-undo .
     9082     define input parameter  v-prod-code like ub.cli-gds.prod-code no-undo .
     9083     define parameter buffer buf_cli-gds for ub.cli-gds .
     9084     define variable vss-description as character no-undo initial "cligdscr-01: поиск/cоздание записи остатков по объекту".
     9085      find first buf_cli-gds no-lock
     9086       where buf_cli-gds.cli-type  = v-cli-type
     9087         and buf_cli-gds.cli-code  = v-cli-code
     9088         and buf_cli-gds.host-code = v-host-code
     9089         and buf_cli-gds.artic     = v-artic
     9090         and buf_cli-gds.prod-type = v-prod-type
     9091         and buf_cli-gds.prod-code = v-prod-code
     9092       no-error.
     9093     if not available buf_cli-gds
     9094     then do:
     9095       do transaction
     9096       on error undo, return error return-value
     9097       :
     9098         create buf_cli-gds.
     9099         assign
     9100           buf_cli-gds.cli-type  = v-cli-type
     9101           buf_cli-gds.cli-code  = v-cli-code
     9102           buf_cli-gds.host-code = v-host-code
     9103           buf_cli-gds.artic     = v-artic
     9104           buf_cli-gds.prod-type = v-prod-type
     9105           buf_cli-gds.prod-code = v-prod-code
     9106         .
     9107         assign
     9108           buf_cli-gds.in-rubl   = 0
     9109           buf_cli-gds.in-base   = 0
     9110           buf_cli-gds.in-qnty   = 0
     9111           buf_cli-gds.out-qnty  = 0
     9112           buf_cli-gds.ret-qnty  = 0
     9113         .
     9114            release buf_cli-gds.
     9115       end.
     9116       find first buf_cli-gds no-lock
     9117       where buf_cli-gds.cli-type  = v-cli-type
     9118         and buf_cli-gds.cli-code  = v-cli-code
     9119         and buf_cli-gds.host-code = v-host-code
     9120         and buf_cli-gds.artic     = v-artic
     9121         and buf_cli-gds.prod-type = v-prod-type
     9122         and buf_cli-gds.prod-code = v-prod-code
     9123       .
     9124     end.
     9125   end procedure.
     9126   procedure unitqnty :
     9127     define input parameter  p-unit-name        like ub.units.unit-name no-undo .
     9128     define input parameter  p-artic            like ub.goods.artic     no-undo .
     9129     define input parameter  p-prod-type        like ub.goods.prod-type no-undo .
     9130     define input parameter  p-prod-code        like ub.goods.prod-code no-undo .
     9131     define input parameter  p-unit-description as character            no-undo .
     9132     define input parameter  p-qnty             as decimal              no-undo .
     9133     define variable vss-description as character no-undo initial "unitqnty-01: Контроль допустимых количеств для данной единицы измерения (товара)".
     9134     define buffer buf_units for ub.units .
     9135     define buffer buf_goods for ub.goods .
     9136     define variable v-artic as character no-undo .
     9137     if p-unit-description = ''
     9138     or p-unit-description = ?
     9139     then do:
     9140       assign
     9141         p-unit-description = "Единица измерения"
     9142       .
     9143     end.
     9144     if  p-unit-name <> ''
     9145     and p-unit-name <> ?
     9146     then do:
     9147       find first buf_units no-lock
     9148         where buf_units.unit-name = p-unit-name
     9149         no-error .
     9150       if not available buf_units
     9151       then do:
     9152         message
     9153           vss-workfile vss-revision vss-description skip
     9154           "Не найдена единица измерения" skip
     9155           "p-unit-name"   p-unit-name skip
     9156           "p-artic"       p-artic  skip
     9157           "p-prod-type"   p-prod-type skip
     9158           "p-proc-code"   p-prod-code skip
     9159           "p-qnty"        p-qnty skip
     9160           view-as alert-box error .
     9161         undo, return error return-value .
     9162       end.
     9163     end.
     9164     else do:
     9165       find first buf_goods no-lock
     9166         where buf_goods.artic     = p-artic
     9167           and buf_goods.prod-type = p-prod-type
     9168           and buf_goods.prod-code = p-prod-code
     9169         no-error .
     9170       if not available buf_goods
     9171       then do:
     9172         message
     9173           vss-workfile vss-revision vss-description skip
     9174           "Не найден товар" skip
     9175           "p-unit-name"   p-unit-name skip
     9176           "p-artic"       p-artic  skip
     9177           "p-prod-type"   p-prod-type skip
     9178           "p-proc-code"   p-prod-code skip
     9179           "p-qnty"        p-qnty skip
     9180           view-as alert-box error .
     9181         undo, return error return-value .
     9182       end.
     9183       find first buf_units no-lock
     9184         where buf_units.unit-name = buf_goods.unit-base
     9185         no-error .
     9186       if not available buf_units
     9187       then do:
     9188         message
     9189           vss-workfile vss-revision vss-description skip
     9190           "Не найдена единица измерения" skip
     9191           "p-unit-name"   p-unit-name skip
     9192           "p-artic"       p-artic  skip
     9193           "p-prod-type"   p-prod-type skip
     9194           "p-proc-code"   p-prod-code skip
     9195           "p-qnty"        p-qnty skip
     9196           view-as alert-box error .
     9197         undo, return error return-value .
     9198       end.
     9199       assign
     9200         v-artic = "Артикул " + string(p-artic) + " " + string(p-prod-type)
     9201                 + " " + string(p-prod-code)
     9202         p-unit-description = "Базовая единица измерения"
     9203       .
     9204     end.
     9205     if lookup('шту':U, buf_units.type) > 0
     9206     or lookup('сер':U, buf_units.type) > 0
     9207     then do:
     9208       if p-qnty <> truncate(p-qnty, 0)
     9209       then do:
     9210         message
     9211           "Для штучного и серийного товаров резервируемое количество должно быть целым" skip
     9212           v-artic skip
     9213           p-unit-description buf_units.unit-name skip
     9214           "Запрошено количество " p-qnty skip
     9215           view-as alert-box .
     9216         undo, return error return-value .
     9217       end.
