    14880   procedure partppric :
    14881   define parameter buffer buf_parts for ub.parts .
    14882   define output parameter p-price           as decimal   no-undo .
    14883   define output parameter p-priceWithVat    as decimal   no-undo .
    14884   define output parameter p-vat-pc          as decimal   no-undo .
    14885     do
    14886     on error undo, return error return-value
    14887     :
    14888      p-price        = decimal(entry(1,buf_parts.dop,";")) / buf_parts.cli-base-rate.
    14889      p-priceWithVat = decimal(entry(2,buf_parts.dop,";")) / buf_parts.cli-base-rate no-error .
    14890      if error-status :error then do:
    14891         p-priceWithVat = 0 .
    14892      end.
    14893      if p-priceWithVat = 0 then do:
    14894        p-vat-pc       = 0 .
    14895      end.
    14896      else do:
    14897         p-vat-pc       = 100 * ( p-priceWithVat - p-price ) / p-price .
    14898      end.
    14899     end.
    14900   end procedure.
    14901   procedure calltree :
    14902   define input parameter p-proc-name as character no-undo .
    14903   define input parameter p-from-handle as handle no-undo .
    14904   define input parameter p-find-up-to-handle as handle no-undo .
    14905   define output parameter p-proc-handle as handle no-undo .
    14906   define variable v-uh as handle no-undo .
    14907   define variable v-uh1 as handle no-undo .
    14908   main-block:
    14909   do
    14910   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    14911   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
    14912   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
    14913   :
    14914     if not valid-handle(p-from-handle) then do:
    14915       undo, return error substitute("Не указан handle procedure, от которой начинается поиск").
    14916     end.
    14917     if p-from-handle:persistent then do:
    14918       if p-proc-name <> "mainhandle_parentproc_indicator" then do:
    14919         message
    14920         vss-workfile vss-revision vss-description skip
    14921         substitute("НЕ разрешено вызывать процедуру из персистентной процедуры (&1)", p-from-handle:name)
    14922         view-as alert-box error .
    14923         undo, return error .
    14924       end.
    14925       v-uh = session:first-procedure no-error .
    14926       do while valid-handle(v-uh):
    14927         v-uh1 = v-uh:instantiating-procedure.
    14928         if valid-handle(v-uh1)
    14929         and v-uh1:type = "PROCEDURE"
    14930         and lookup(p-proc-name, v-uh1:internal-entries) > 0 then do:
    14931           p-proc-handle = v-uh1 .
    14932           leave.
    14933         end.
    14934         v-uh = v-uh:next-sibling no-error .
    14935       end.
    14936     end.
    14937     v-uh = p-from-handle:instantiating-procedure.
    14938     do while valid-handle(v-uh):
    14939       if lookup(p-proc-name, v-uh:internal-entries) > 0 then do:
    14940         p-proc-handle = v-uh .
    14941         leave.
    14942       end.
    14943       if valid-handle(p-find-up-to-handle) and  v-uh = p-find-up-to-handle then do:
    14944         leave.
    14945       end.
    14946       v-uh = v-uh:instantiating-procedure.
    14947     end.
    14948   end.
    14949   end procedure.
    14950   procedure regcode :
    14951   do
    14952   on error undo, return error return-value
    14953   :
    14954     define input  parameter p-obj-type  as character no-undo .
    14955     define input  parameter p-obj-code  as integer   no-undo .
    14956     define output parameter p-reg-code  as integer   no-undo .
    14957     define variable vss-description as character no-undo initial "regcode-01: код региона для БД".
    14958     define variable v-db-attr-type  as character no-undo.
    14959     define buffer buf_db   for ub.db .
    14960     case p-obj-type :
    14961       when 'БД':U
    14962       then do:
    14963         find first buf_db no-lock
    14964           where buf_db.db-num = p-obj-code
    14965           no-error .
    14966         if not available buf_db
    14967         then do:
    14968           message
    14969             vss-workfile vss-revision vss-description skip
    14970             "Не найдена БД" skip
    14971             "p-obj-type" p-obj-type skip
    14972             "p-obj-code" p-obj-code skip
    14973             view-as alert-box error .
    14974           undo, return error return-value .
    14975         end.
    14976         run db-attr-value in this-procedure (buf_db.db-num,
    14977                                              "reg-code",
    14978                                              output p-reg-code,
    14979                                              output v-db-attr-type) no-error.
    14980       end.
    14981       otherwise do:
    14982         message
    14983           vss-workfile vss-revision vss-description skip
    14984           "Неизвестный тип объекта" skip
    14985           "p-obj-type" p-obj-type skip
    14986           "p-obj-code" p-obj-code skip
    14987           view-as alert-box error .
    14988         undo, return error return-value .
    14989       end.
    14990     end.
    14991     assign
    14992       l-last-regcode-exist     = true
    14993       v-last-regcode-obj-type  = p-obj-type
    14994       v-last-regcode-obj-code  = p-obj-code
    14995       v-last-regcode-reg-code  = p-reg-code
    14996     .
    14997   end.
    14998   end procedure.
    14999   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15000   Function reverse returns character (str as character).
    15001      define variable rev_incl_s as character init "" no-undo .
    15002      define variable rev_incl_i as integer no-undo .
    15003      define variable rev_incl_l as integer no-undo .
    15004      rev_incl_l = length(str).
    15005      do rev_incl_i = 1 to rev_incl_l:
    15006         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
    15007      end.
    15008      return rev_incl_s.
    15009   end.
    15010   procedure check-enc.
    15011     define input  parameter p-db-num    as integer   no-undo .
    15012     define input  parameter p-db-key    as character no-undo .
    15013     define input  parameter p-code      as character no-undo .
    15014     define input  parameter p-value     as character no-undo .
    15015     define input  parameter p-beg-date  as date      no-undo .
    15016     define input  parameter p-end-date  as date      no-undo .
    15017     define input  parameter p-enc-value as character no-undo .
    15018     define output parameter p-answer    as logical   no-undo .
    15019     define variable tmp         as character no-undo .
    15020     define variable v-enc-value as character no-undo .
    15021     if p-db-num <> 0
    15022       and p-db-key = "":U
    15023     then do:
    15024       assign
    15025         p-answer = true
    15026       .
    15027       return.
    15028     end.
    15029     if p-db-key = "unload-db":U then do:
    15030       assign
    15031         p-answer = true
    15032       .
    15033       return.
    15034     end.
    15035     if p-code = ""  then do:
    15036       assign
    15037         tmp = string( p-db-num ) + reverse (p-db-key).
    15038       .
    15039     end.
    15040     else do:
    15041       assign
    15042         tmp = string( p-db-num )
    15043               + trim( p-db-key )
    15044               + reverse( trim( p-code ) )
    15045               + reverse( trim( p-value ) )
    15046               + reverse( string( p-beg-date, "99.99.9999" ) )
    15047               + reverse( string( p-end-date, "99.99.9999" ) )
    15048       .
    15049     end.
    15050     run pswd-enc in this-procedure
    15051       ( input tmp
    15052        ,output v-enc-value
    15053       ) no-error .
    15054     if error-status:error then do:
    15055       message
    15056         vss-workfile vss-revision vss-description skip
    15057         "Ошибка при вызове процедуры pswd-enc" skip
    15058         return-value skip
    15059         error-status :get-message(1) skip
    15060         view-as alert-box error .
    15061       undo, return error .
    15062     end.
    15063     if v-enc-value = p-enc-value then do:
    15064       assign
    15065         p-answer = true
    15066       .
    15067     end.
    15068     else do:
    15069       assign
    15070         p-answer = false
    15071       .
    15072     end.
    15073   end.
    15074   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15075   procedure pswd-enc :
    15076     define input parameter  pswd     as character no-undo .
    15077     define output parameter enc-pswd as character no-undo .
    15078     do
    15079     on error undo, return error return-value
    15080     :
    15081       assign
    15082         enc-pswd = encode(pswd + string(index(pswd, "k")))
    15083       .
    15084     end.
    15085   end procedure.
    15086   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15087   def var vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15088   procedure gen-key-rec :
    15089     define input  parameter p-tbl-name    as character no-undo.
    15090     define input  parameter p-bh_tbl-name as handle    no-undo.
    15091     define output parameter p-key-rec     as character no-undo.
    15092     do
    15093     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15094     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
    15095     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
    15096     :
    15097       define variable fh               as handle    no-undo .
    15098       define variable v-ok             as logical   no-undo .
    15099       define variable v-inform         as character no-undo .
    15100       define variable v-ind            as integer   no-undo .
    15101       define variable v-idx-field-qnty as integer   no-undo .
    15102       if p-tbl-name = ?
    15103         or p-tbl-name = "":U
    15104       then do:
    15105         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info104 ).
    15106       end.
    15107       if not p-bh_tbl-name:available then do:
    15108         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info104, p-tbl-name ).
    15109       end.
    15110       assign
    15111         p-key-rec = p-tbl-name
    15112         v-inform  = p-bh_tbl-name:index-information(1)
    15113         v-ind     = 2
    15114       .
    15115       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    15116       on error undo, return error
    15117       :
    15118         assign
    15119           v-inform = p-bh_tbl-name:index-information( v-ind )
    15120           v-ind    = v-ind + 1
    15121         .
    15122       end.
    15123       if v-inform = ?
    15124         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    15125         or entry( 3, v-inform, ",":U ) <> "1":U
    15126       then do:
    15127         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info104, p-tbl-name ).
    15128       end.
    15129       else do:
    15130         assign
    15131           v-idx-field-qnty = num-entries( v-inform ) - 4
    15132         .
    15133         if v-idx-field-qnty < 2 then do:
    15134           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info104, v-inform, p-tbl-name ).
    15135         end.
    15136         do v-ind = 1 to v-idx-field-qnty by 2
    15137         on error undo, return error
    15138         :
    15139           assign
    15140             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
    15141             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
    15142           .
    15143         end.
    15144       end.
    15145       if p-key-rec = ? then do:
    15146         assign
    15147           p-key-rec = "":U
    15148         .
    15149         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info104, p-tbl-name ).
    15150       end.
    15151     end.
    15152     return.
    15153   end procedure.
    15154   procedure gen-where-keyr-tab :
    15155     define input  parameter i-tableSerach as character no-undo.
    15156     define input  parameter i-tablekey   as character  no-undo.
    15157     define input  parameter p-key-rec    as character  no-undo.
    15158     define input  parameter p-key-handle as handle     no-undo .
    15159     define input  parameter p-db-name    as character  no-undo .
    15160     define input  parameter p-tt-handle  as handle     no-undo .
    15161     define output parameter o-Where      as character  no-undo.
    15162     do
    15163     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15164     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
    15165     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
    15166     :
    15167       define variable v-full-tbl-name  as character no-undo .
    15168       define variable bh_tbl-name      as handle    no-undo .
    15169       define variable fh_key           as handle    no-undo .
    15170       define variable fh_search        as handle    no-undo .
    15171       define variable v-field-num      as integer   no-undo .
    15172       define variable v-count-fld      as integer   no-undo .
    15173       define variable v-inform         as character no-undo .
    15174       define variable v-ind            as integer   no-undo .
    15175       define variable v-idx-field-qnty as integer   no-undo .
    15176       define variable v-field-name     as character no-undo .
    15177       define variable v-field-val      as character no-undo .
    15178       define variable v-word-link      as character no-undo .
    15179       define variable vTable           as character no-undo.
    15180       define variable bh_tbl-key       as handle    no-undo .
    15181       assign
    15182         p-key-rec = trim( p-key-rec )
    15183       .
    15184       if p-key-handle <> ? then do:
    15185         if not valid-handle(p-key-handle)
    15186            or p-key-handle:type <> "buffer"
    15187         then do:
    15188           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info104 ).
    15189         end.
    15190         if num-entries( p-key-rec, chr(3) ) > 1
    15191           or p-key-rec = ?
    15192           or p-key-rec = "":U
    15193         then do:
    15194           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info104, p-key-rec ).
    15195         end.
    15196       end.
    15197       else do:
    15198         if p-key-rec = ?
    15199           or p-key-rec = "":U
    15200         then do:
    15201           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info104 ).
    15202         end.
    15203       end.
    15204       assign
    15205         vTable = entry( 1 , p-key-rec, chr(3) )
    15206       .
    15207       if p-tt-handle <> ?
    15208         and ( not valid-handle(p-tt-handle)
    15209               or p-tt-handle:type <> "buffer"
    15210             )
    15211       then do:
    15212         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info104, vTable, chr(10) ).
    15213       end.
    15214       if p-tt-handle = ? then do:
    15215         assign
    15216           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
    15217         .
    15218         create buffer bh_tbl-name for table v-full-tbl-name .
    15219       end.
    15220       else do:
    15221         create buffer bh_tbl-name for table p-tt-handle:table-handle .
    15222       end.
    15223       assign
    15224         v-inform = bh_tbl-name:index-information(1)
    15225         v-ind    = 2
    15226       .
    15227       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    15228       on error undo, return error
    15229       :
    15230         assign
    15231           v-inform = bh_tbl-name:index-information( v-ind )
    15232           v-ind    = v-ind + 1
    15233         .
    15234       end.
    15235       if v-inform = ?
    15236         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    15237         or entry( 3, v-inform, ",":U ) <> "1":U
    15238       then do:
    15239         delete object bh_tbl-name no-error.
    15240         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info104, vTable ).
    15241       end.
    15242       assign
    15243         v-idx-field-qnty = num-entries( v-inform ) - 4
    15244       .
    15245       if v-idx-field-qnty < 2 then do:
    15246         delete object bh_tbl-name no-error.
    15247         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info104, v-inform, vTable ).
    15248       end.
    15249       assign
    15250         o-where     = "where":U
    15251         v-word-link = "":U
    15252         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
    15253         v-count-fld = 0
    15254       .
    15255       if i-tablekey ne "" and i-tablekey ne ?
    15256       then do:
    15257         assign
    15258           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
    15259         .
    15260         create buffer bh_tbl-key for table v-full-tbl-name .
    15261       end.
    15262       if i-tableSerach ne "" and i-tableSerach ne ?
    15263       then do:
    15264         delete object bh_tbl-name no-error.
    15265         assign
    15266           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
    15267         .
    15268         create buffer bh_tbl-name for table v-full-tbl-name .
    15269       end.
    15270       block_where:
    15271       do v-ind = 1 to v-idx-field-qnty by 2
    15272       on error undo, return error
    15273       :
    15274         assign
    15275           v-count-fld = v-count-fld + 1
    15276         .
    15277         if p-key-handle = ?
    15278           and v-count-fld > v-field-num
    15279         then do:
    15280           leave block_where.
    15281         end.
    15282         define variable VfieldKeyTable as handle no-undo.
    15283         assign
    15284           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
    15285           fh_search    = bh_tbl-name:buffer-field( v-field-name )
    15286         .
    15287         if     bh_tbl-key ne ?
    15288         then do:
    15289            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
    15290            if VfieldKeyTable eq ?
    15291            then next block_where.
    15292         end.
    15293         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
    15294         then
    15295            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
    15296         else
    15297            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
    15298         if p-key-handle = ? then do:
    15299           assign
    15300             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
    15301           .
    15302         end.
    15303         else do:
    15304           assign
    15305             fh_key = p-key-handle:buffer-field( v-field-name )
    15306           .
    15307           if fh_key = ?
    15308             or not valid-handle( fh_key )
    15309           then do:
    15310             delete object bh_tbl-name.
    15311             if     bh_tbl-key ne ?
    15312             then
    15313                delete object bh_tbl-key.
    15314             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info104, p-key-handle:name, v-field-name ).
    15315           end.
    15316           assign
    15317             v-field-val = fh_key:buffer-value
    15318           .
    15319         end.
    15320         if fh_search:data-type ="character":U then do:
    15321           assign
    15322             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
    15323             v-field-val = replace( v-field-val, '"':U, '~~"':U )
    15324             v-field-val = replace( v-field-val, "'":U, "~~'":U )
    15325             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
    15326             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
    15327             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
    15328             v-field-val = replace( v-field-val, chr(10), '~~n':U )
    15329             v-field-val = replace( v-field-val, chr(9), '~~t':U )
    15330             v-field-val = replace( v-field-val, chr(13), '~~r':U )
    15331             v-field-val = replace( v-field-val, chr(27), '~~E':U )
    15332             v-field-val = replace( v-field-val, chr(8), '~~b':U )
    15333             v-field-val = replace( v-field-val, chr(12), '~~f':U )
    15334             v-field-val = substitute( '"&1"', v-field-val )
    15335           .
    15336         end.
    15337         assign
    15338           o-where = substitute( "&1 &2", o-where, v-field-val )
    15339         .
    15340         if v-word-link = "":U then do:
    15341           assign
    15342             v-word-link = "and":U
    15343           .
    15344         end.
    15345       end.
    15346       delete object bh_tbl-name.
    15347       if     bh_tbl-key ne ?
    15348       then
    15349          delete object bh_tbl-key.
    15350       if p-key-handle = ?
    15351         and v-count-fld <> v-field-num
    15352       then do:
    15353         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info104, vTable ).
    15354       end.
    15355     end.
    15356   end procedure.
    15357   procedure gen-hn-keyr-tab :
    15358     define input  parameter i-tableSerach as character no-undo.
    15359     define input  parameter i-tablekey   as character no-undo.
    15360     define input  parameter p-key-rec    as character no-undo.
    15361     define input  parameter p-key-handle as handle    no-undo .
    15362     define input  parameter p-db-name    as character no-undo .
    15363     define input  parameter p-tt-handle  as handle    no-undo .
    15364     define input  parameter p-stts-lock  as integer   no-undo .
    15365     define output parameter o-hn         as handle    no-undo.
    15366     define variable v-full-tbl-name as character no-undo.
    15367     define variable v-where         as character no-undo.
    15368     define variable bh_tbl-name     as handle    no-undo.
    15369     define variable vTable          as character no-undo.
    15370     do
    15371     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15372     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
    15373     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
    15374         run gen-where-keyr-tab(i-tableSerach,
    15375                                i-tablekey,
    15376                                p-key-rec,
    15377                                p-key-handle,
    15378                                p-db-name,
    15379                                p-tt-handle,
    15380                                output v-where).
    15381         if i-tableSerach ne "" and i-tableSerach ne ?
    15382         then do:
    15383            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
    15384            create buffer bh_tbl-name for table v-full-tbl-name .
    15385         end.
    15386         else do:
    15387            if p-tt-handle = ? then do:
    15388               assign
    15389                  vTable = entry( 1 , p-key-rec, chr(3) )
    15390               .
    15391               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
    15392               create buffer bh_tbl-name for table v-full-tbl-name .
    15393            end.
    15394            else do:
    15395               create buffer bh_tbl-name for table p-tt-handle:table-handle .
    15396            end.
    15397         end.
    15398         if p-tt-handle = ? then do:
    15399            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
    15400         end.
    15401         else do:
    15402            bh_tbl-name:find-first( v-where ) no-error .
    15403         end.
    15404         o-hn = bh_tbl-name.
    15405      end.
    15406   end procedure.
    15407   procedure gen-hn-keyr :
    15408     define input  parameter p-key-rec    as character no-undo.
    15409     define input  parameter p-key-handle as handle    no-undo .
    15410     define input  parameter p-db-name    as character no-undo .
    15411     define input  parameter p-tt-handle  as handle    no-undo .
    15412     define input  parameter p-stts-lock  as integer   no-undo .
    15413     define output parameter o-hn         as handle    no-undo.
    15414     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
    15415   end.
    15416   procedure gen-row-keyr :
    15417     define input  parameter p-key-rec    as character no-undo.
    15418     define input  parameter p-key-handle as handle    no-undo .
    15419     define input  parameter p-db-name    as character no-undo .
    15420     define input  parameter p-tt-handle  as handle    no-undo .
    15421     define input  parameter p-stts-lock  as integer   no-undo .
    15422     define output parameter p-tbl-row    as rowid     no-undo.
    15423     define output parameter p-tbl-name   as character no-undo.
    15424     define variable vHn as handle no-undo.
    15425       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
    15426       p-tbl-row = if vHn:available then vHn:rowid else ?.
    15427       p-tbl-name =  vHn:table.
    15428       delete object vHn no-error.
    15429     if p-tbl-row = ? then do:
    15430       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info104, p-tbl-name, p-key-rec ).
    15431     end.
    15432     else do:
    15433       return.
    15434     end.
    15435   end procedure.
    15436   procedure gen-key-fv :
    15437     define input  parameter p-key-rec    as character no-undo .
    15438     define output parameter p-field-list as character no-undo .
    15439     define output parameter p-value-list as character no-undo.
    15440     do
    15441     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15442     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
    15443     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
    15444     :
    15445       define variable v-full-tbl-name  as character no-undo .
    15446       define variable bh_tbl-name      as handle    no-undo .
    15447       define variable v-tbl-name       as character no-undo .
    15448       define variable v-field-num      as integer   no-undo .
    15449       define variable v-count-fld      as integer   no-undo .
    15450       define variable v-inform         as character no-undo .
    15451       define variable v-ind            as integer   no-undo .
    15452       define variable v-idx-field-qnty as integer   no-undo .
    15453       define variable v-delim-key      as character no-undo .
    15454       if p-key-rec = ?
    15455         or p-key-rec = "":U
    15456       then do:
    15457         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info104 ).
    15458       end.
    15459       assign
    15460         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
    15461         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
    15462       .
    15463       create buffer bh_tbl-name for table v-full-tbl-name no-error .
    15464       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info104 ).
    15465       assign
    15466         v-inform = bh_tbl-name:index-information(1)
    15467         v-ind    = 2
    15468       .
    15469       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    15470       on error undo, return error
    15471       :
    15472         assign
    15473           v-inform = bh_tbl-name:index-information( v-ind )
    15474           v-ind    = v-ind + 1
    15475         .
    15476       end.
    15477       if v-inform = ?
    15478         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    15479         or entry( 3, v-inform, ",":U ) <> "1":U
    15480       then do:
    15481         delete object bh_tbl-name no-error.
    15482         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info104, v-tbl-name ).
    15483       end.
    15484       assign
    15485         v-idx-field-qnty = num-entries( v-inform ) - 4
    15486       .
    15487       if v-idx-field-qnty < 2 then do:
    15488         delete object bh_tbl-name no-error.
    15489         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info104, v-inform, v-tbl-name ).
    15490       end.
    15491       assign
    15492         p-field-list = "":U
    15493         p-value-list = "":U
    15494         v-delim-key  = "":U
    15495         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
    15496         v-count-fld  = 0
    15497       .
    15498       block_where:
    15499       do v-ind = 1 to v-idx-field-qnty by 2
    15500       on error undo, return error
    15501       :
    15502         assign
    15503           v-count-fld = v-count-fld + 1
    15504         .
    15505         if v-count-fld > v-field-num then do:
    15506           leave block_where.
    15507         end.
    15508         assign
    15509           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
    15510           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
    15511         .
    15512         if v-ind = 1 then do:
    15513           assign
    15514             v-delim-key = chr(3)
    15515           .
    15516         end.
    15517       end.
    15518       delete object bh_tbl-name.
    15519       if v-count-fld <> v-field-num then do:
    15520         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info104, v-tbl-name ).
    15521       end.
    15522     end.
    15523   end procedure.
    15524   procedure gen-key-field :
    15525     define input  parameter p-table      as character no-undo .
    15526     define output parameter p-field-list as character no-undo .
    15527     do
    15528     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    15529     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
    15530     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
    15531     :
    15532       define variable v-full-tbl-name  as character no-undo .
    15533       define variable bh_tbl-name      as handle    no-undo .
    15534       define variable v-tbl-name       as character no-undo .
    15535       define variable v-field-num      as integer   no-undo .
    15536       define variable v-count-fld      as integer   no-undo .
    15537       define variable v-inform         as character no-undo .
    15538       define variable v-ind            as integer   no-undo .
    15539       define variable v-idx-field-qnty as integer   no-undo .
    15540       define variable v-delim-key      as character no-undo .
    15541       if p-table = ?
    15542         or p-table = "":U
    15543       then do:
    15544         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info104 ).
    15545       end.
    15546       assign
    15547         v-tbl-name      = p-table
    15548         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
    15549       .
    15550       create buffer bh_tbl-name for table v-full-tbl-name no-error .
    15551       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info104 ).
    15552       assign
    15553         v-inform = bh_tbl-name:index-information(1)
    15554         v-ind    = 2
    15555       .
    15556       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
    15557       on error undo, return error
    15558       :
    15559         assign
    15560           v-inform = bh_tbl-name:index-information( v-ind )
    15561           v-ind    = v-ind + 1
    15562         .
    15563       end.
    15564       if v-inform = ?
    15565         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
    15566         or entry( 3, v-inform, ",":U ) <> "1":U
    15567       then do:
    15568         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info104, v-tbl-name ).
    15569       end.
    15570       assign
    15571         v-idx-field-qnty = num-entries( v-inform ) - 4
    15572       .
    15573       if v-idx-field-qnty < 2 then do:
    15574         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info104, v-inform, v-tbl-name ).
    15575       end.
    15576       assign
    15577         p-field-list = "":U
    15578         v-delim-key  = "":U
    15579         v-count-fld  = 0
    15580       .
    15581       block_where:
    15582       do v-ind = 1 to v-idx-field-qnty by 2
    15583       on error undo, return error
    15584       :
    15585         assign
    15586           v-count-fld = v-count-fld + 1
    15587         .
    15588         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
    15589         if v-ind = 1 then do:
    15590           assign
    15591             v-delim-key = chr(3)
    15592           .
    15593         end.
    15594       end.
    15595       delete object bh_tbl-name.
    15596     end.
    15597   end procedure.
    15598   procedure rum-runa :
    15599   define input  parameter parparentproc as widget-handle no-undo .
    15600   define input  parameter p-parent-handle as handle no-undo .
