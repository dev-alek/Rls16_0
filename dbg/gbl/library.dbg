     9220   function not-null-string returns character
     9221     (input p-str as character )
     9222   :
     9223     if p-str = ?
     9224     then do:
     9225       return '?' .
     9226     end.
     9227     return p-str .
     9228   end.
     9229   procedure usrnick :
     9230   define input parameter p-user-id as character        no-undo.
     9231   define output parameter p-nick   as character        no-undo.
     9232      define buffer buf_user-account      for ub.user-account .
     9233   do
     9234   for buf_user-account
     9235   on error undo, return error
     9236   :
     9237      find first buf_user-account no-lock
     9238           where buf_user-account.user-id = p-user-id
     9239      no-error.
     9240      if available buf_user-account
     9241      then do:
     9242          assign
     9243              p-nick = buf_user-account.nik
     9244          .
     9245      end.
     9246      else do:
     9247          assign
     9248              p-nick = p-user-id
     9249          .
     9250      end.
     9251   end.
     9252   end procedure.
     9253   procedure chkextdt :
