     4824                 "p-obj-type"  p-obj-type  skip
     4825                 "p-obj-code"  p-obj-code  skip
     4826                 "p-artic"     p-artic     skip
     4827                 "p-prod-type" p-prod-type skip
     4828                 "p-prod-code" p-prod-code skip
     4829                 "v-action"    v-action    skip
     4830                 "p-action"    p-action    skip
     4831                 "gds-obj.ov-on" buf_gds-obj.ov-on skip
     4832                 view-as alert-box error .
