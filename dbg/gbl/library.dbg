     5386             .
     5387           end.
     5388           else do:
     5389   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5390   empty temp-table thbjattr_thbj-attr.
     5391   run adm/shattri.p (
     5392      input "get":U
     5393     ,input ''
     5394     ,input 0
     5395     ,input 'rezerv-global':U
     5396     ,input  ""
     5397     ,output v-value-character
     5398     ,output v-value-date
     5399     ,output v-value-decimal
     5400     ,output v-value-integer
     5401     ,output v-value-logical
     5402     ,output par-type
     5403     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5404     ) no-error .
     5405             for each thbjattr_thbj-attr :
     5406                 if thbjattr_thbj-attr.prop-code = 'parts-bc'  then p-return-attribute  = thbjattr_thbj-attr.property-value-logical.
     5407             end.
     5408             empty temp-table thbjattr_thbj-attr.
     5409           end.
     5410         end.
     5411         when "cr-root-gds-dtl=request":u
     5412         then do:
     5413           define variable v-root-node   like ub.gds-dtl.prt-code no-undo .
     5414           define variable l-empty-scale as logical   no-undo .
     5415           define variable l-doc-prt     as logical   no-undo .
     5416   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     5418     (input  p-artic
     5419     ,input  p-prod-type
     5420     ,input  p-prod-code
     5421     ,output v-root-node
     5422     ) no-error .
     5423           if error-status :error
     5424           then do:
     5425             message
     5426               vss-workfile vss-revision vss-description skip
     5427               "Ошибка при определении корневого признака шкалы" skip
     5428               "Артикул" p-artic p-prod-type p-prod-code skip
     5429               error-status :get-message(1) skip
     5430               return-value skip
     5431               view-as alert-box error .
     5432             undo, return error return-value .
     5433           end.
     5434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5435     (input  v-root-node
     5436     ,input  'empty-scale=request':u
     5437     ,output l-empty-scale
     5438     ) no-error .
     5439           if error-status :error
     5440           then do:
     5441             message
     5442               vss-workfile vss-revision vss-description skip
     5443               "Ошибка при определении атрибута шкалы" skip
     5444               "Код признака" v-root-node skip
     5445               "Запрашивался атрибут" "empty-scale=request" skip
     5446               error-status :get-message(1) skip
     5447               return-value skip
     5448               view-as alert-box error .
     5449             undo, return error return-value .
     5450           end.
     5451   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5453     (input  p-obj-type
     5454     ,input  p-obj-code
     5455     ,input  'doc-prt=request':u
     5456     ,output l-doc-prt
     5457     ) no-error .
     5458           if error-status :error
     5459           then do:
     5460             message
     5461               vss-workfile vss-revision vss-description skip
     5462               "Ошибка при определении атрибута объекта" skip
     5463               "Объект" p-obj-type p-obj-code skip
     5464               "Запрашивался атрибут" "doc-prt=request" skip
     5465               error-status :get-message(1) skip
