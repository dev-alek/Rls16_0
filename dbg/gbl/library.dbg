    11210           + "налог: " + string(buf_tax-rate.tax-code) + " ставка: " + string(buf_tax-rate.rate-code) .
    11211         end.
    11212       END.
    11213       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11214                   buf_tax-rate-value.tax-code  = partax-code  AND
