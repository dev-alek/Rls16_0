    13559         when 'pl-pump':U
    13560         THEN do:
    13561             assign
    13562             p-user-name = "Склад.место ТРК"
    13563             .
    13564         end.
    13565         when 'pl-pump-nozzle':U
    13566         THEN do:
    13567             assign
    13568             p-user-name = "Соотв. пистолета и ТРК"
    13569             .
    13570         end.
    13571         when 'shift-obj':U
    13572         THEN do:
    13573             assign
    13574             p-user-name = "Смены"
    13575             .
    13576         end.
    13577         when "report"
    13578         THEN do:
    13579             assign
    13580             p-user-name = "Отчеты"
    13581             .
    13582         end.
    13583         when "utl"
    13584         THEN do:
    13585             assign
    13586             p-user-name = "Утилиты"
    13587             .
    13588         end.
    13589         when "printdoc"
    13590         THEN do:
    13591             assign
    13592             p-user-name = "Печать"
    13593             .
    13594         end.
    13595         otherwise do:
    13596           assign
    13597             p-user-name = p-table-name
    13598           .
    13599         end.
    13600       end.
    13601     end.
    13602   end procedure.
    13603   procedure tblusrnm :
    13604     define input  parameter p-user-name  as character no-undo .
    13605     define output parameter p-table-name as character no-undo .
    13606     define variable vss-description as character no-undo initial "tblusrnm-01: возвращает имя таблицы по пользовательскому имени таблицы".
    13607     do
    13608     on error undo, return error return-value
    13609     :
    13610       case p-user-name
    13611       :
    13612         when 'Накладная'
    13613         then do:
    13614           assign
    13615             p-table-name = 'trn-doc':U
    13616           .
    13617         end.
    13618         when 'Переоценка'
    13619         then do:
    13620           assign
    13621             p-table-name = 'price-doc':U
    13622           .
    13623         end.
    13624         when 'Документ МЦ'
    13625         then do:
    13626           assign
    13627             p-table-name = 'wth-doc':U
    13628           .
    13629         end.
    13630         when 'Продажа'
    13631         then do:
    13632           assign
    13633             p-table-name = 'inkas':U
    13634           .
    13635         end.
    13636         when 'Производство'
    13637         then do:
    13638           assign
    13639             p-table-name = 'fbr-doc':U
    13640           .
    13641         end.
    13642         when 'План-меню'
    13643         then do:
    13644           assign
    13645             p-table-name = 'fbr-pln':U
    13646           .
    13647         end.
    13648         when 'Сверка'
    13649         then do:
    13650           assign
    13651             p-table-name = 'rvs-doc':U
    13652           .
    13653         end.
    13654         when 'Док.сч.ТРК'
    13655         then do:
    13656           assign
    13657             p-table-name = 'icnt-doc':U
    13658           .
    13659         end.
    13660         when 'Заказ'
    13661         then do:
    13662           assign
    13663             p-table-name = 'ord-doc':U
    13664           .
    13665         end.
    13666         when 'Поставка'
    13667         then do:
    13668           assign
    13669             p-table-name = 'ord-doc-rcv':U
    13670           .
    13671         end.
    13672         when 'СЗФП'
    13673         then do:
    13674           assign
    13675             p-table-name = 'ord-cons':U
    13676           .
    13677         end.
    13678         otherwise do:
    13679           assign
    13680             p-table-name = p-user-name
    13681           .
    13682         end.
    13683       end.
    13684     end.
    13685   end procedure.
    13686   procedure partcond :
    13687     define input  parameter p-ext-doc-type    as character no-undo .
    13688     define input  parameter p-is-hold         as logical   no-undo .
    13689     define input  parameter p-parts-fact-qnty as decimal   no-undo .
    13690     define input  parameter p-create-part     as logical   no-undo .
    13691     define input  parameter p-old-return      as logical   no-undo .
    13692     define output parameter p-rsrv-code       as character no-undo .
    13693     define output parameter p-unrv-code       as character no-undo .
    13694     define output parameter p-need-rsrv       as logical   no-undo .
    13695     define output parameter p-need-unrv       as logical   no-undo .
    13696     define output parameter p-rsrv-sign       as integer   no-undo .
    13697     define output parameter p-unrv-sign       as integer   no-undo .
    13698     define variable vss-description as character no-undo init "partcond-01: определяет каким образом обрабатывать партии документа".
    13699     do
    13700     on error undo, return error return-value
    13701     :
    13702       assign
    13703         p-rsrv-sign = -1
    13704         p-unrv-sign = 1
    13705       .
    13706       case p-ext-doc-type :
    13707         when 'ie':U
    13708         then do:
    13709           assign
    13710             p-rsrv-code = 'free-zone':U
    13711             p-unrv-code = 'out-zone':U
    13712             p-need-rsrv = true
    13713             p-need-unrv = false
    13714           .
    13715         end.
    13716         when 'ee':U
    13717         then do:
    13718           assign
    13719             p-rsrv-code = 'out-zone':U
    13720             p-unrv-code = 'free-zone':U
    13721             p-need-rsrv = true
    13722             p-need-unrv = true
    13723           .
    13724         end.
    13725         when 'ep':U
    13726         then do:
    13727           assign
    13728             p-rsrv-code = 'out-zone':U
    13729             p-unrv-code = 'free-zone':U
    13730             p-need-rsrv = false
    13731             p-need-unrv = true
    13732           .
    13733         end.
    13734         when 'es':U
    13735         then do:
    13736           assign
    13737             p-rsrv-code = 'out-zone':U
    13738             p-unrv-code = 'free-zone':U
    13739             p-need-rsrv = true
    13740             p-need-unrv = true
    13741           .
    13742         end.
    13743         when 're':U
    13744         then do:
    13745           assign
    13746             p-rsrv-code = 'free-zone':U
    13747             p-unrv-code = 'out-zone':U
    13748             p-need-rsrv = true
    13749             p-need-unrv = true
    13750           .
    13751           if ( p-create-part = true
    13752                and
    13753                p-old-return  = true
    13754              )
    13755           or p-is-hold = true
    13756           then do:
    13757             assign
    13758               p-need-unrv = false
    13759             .
    13760           end.
    13761         end.
    13762         when 'rs':U
    13763         then do:
    13764           assign
    13765             p-rsrv-code = 'free-zone':U
    13766             p-unrv-code = 'out-zone':U
    13767             p-need-rsrv = true
    13768             p-need-unrv = true
    13769           .
    13770           if  p-create-part = true
    13771           and p-old-return  = true
    13772           then do:
    13773             assign
    13774               p-need-unrv = false
    13775             .
    13776           end.
    13777         end.
    13778         when 'we':U
    13779         then do:
    13780           assign
    13781             p-rsrv-code = 'out-zone':U
    13782             p-unrv-code = 'free-zone':U
    13783             p-need-rsrv = true
    13784             p-need-unrv = true
    13785           .
    13786         end.
    13787         when 'vt':U              or
    13788         when 'mp':U or
    13789         when 'vp':U         then do:
    13790           if p-parts-fact-qnty >= 0
    13791           then do:
    13792             assign
    13793               p-rsrv-code = 'free-zone':U
    13794               p-unrv-code = 'out-zone':U
    13795               p-need-rsrv = true
    13796               p-need-unrv = true
    13797             .
    13798             if  p-create-part = true
    13799             and p-old-return  = true
    13800             then do:
    13801               assign
    13802                 p-need-unrv = false
    13803               .
    13804             end.
    13805           end.
    13806           else do:
    13807             assign
    13808               p-rsrv-sign = 1
    13809               p-unrv-sign = -1
    13810             .
    13811             assign
    13812               p-rsrv-code = 'out-zone':U
    13813               p-unrv-code = 'free-zone':U
    13814               p-need-rsrv = true
    13815               p-need-unrv = true
    13816             .
    13817           end.
    13818         end.
    13819         when 'ap':U or
    13820         when 'pc':U
    13821         then do:
    13822           if p-parts-fact-qnty >= 0
    13823           then do:
    13824             assign
    13825               p-rsrv-code = 'free-zone':U
    13826               p-unrv-code = 'out-zone':U
    13827               p-need-rsrv = true
    13828               p-need-unrv = false
    13829             .
    13830           end.
    13831           else do:
    13832             assign
    13833               p-rsrv-sign = 1
    13834               p-unrv-sign = -1
    13835             .
    13836             assign
    13837               p-rsrv-code = 'out-zone':U
    13838               p-unrv-code = 'free-zone':U
    13839               p-need-rsrv = false
    13840               p-need-unrv = true
    13841             .
    13842           end.
    13843         end.
    13844         when 'iv':U
    13845         then do:
    13846           assign
    13847             p-rsrv-code = 'free-zone':U
    13848             p-unrv-code = 'out-zone':U
    13849             p-need-rsrv = true
    13850             p-need-unrv = false
    13851           .
    13852         end.
    13853         when 'ev':U
    13854         then do:
    13855           assign
    13856             p-rsrv-code = 'out-zone':U
    13857             p-unrv-code = 'free-zone':U
    13858             p-need-rsrv = true
    13859             p-need-unrv = true
    13860           .
    13861         end.
    13862         when 'io':U
    13863         then do:
    13864           assign
    13865             p-rsrv-code = 'free-zone':U
    13866             p-unrv-code = 'out-zone':U
    13867             p-need-rsrv = true
    13868             p-need-unrv = false
    13869           .
    13870         end.
    13871         when 'eo':U
    13872         then do:
    13873           assign
    13874             p-rsrv-code = 'out-zone':U
    13875             p-unrv-code = 'free-zone':U
    13876             p-need-rsrv = true
    13877             p-need-unrv = true
    13878           .
    13879         end.
    13880         when 'rv':U
    13881         then do:
    13882           assign
    13883             p-rsrv-code = 'free-zone':U
    13884             p-unrv-code = 'out-zone':U
    13885             p-need-rsrv = true
    13886             p-need-unrv = true
    13887           .
    13888         end.
    13889         when 'em':U or
    13890         when 'wm':U
    13891         then do:
    13892           assign
    13893             p-rsrv-code = 'out-zone':U
    13894             p-unrv-code = 'free-zone':U
    13895             p-need-rsrv = true
    13896             p-need-unrv = true
    13897           .
    13898         end.
    13899         when 'im':U
    13900         then do:
    13901           assign
    13902             p-rsrv-code = 'free-zone':U
    13903             p-unrv-code = 'out-zone':U
    13904             p-need-rsrv = true
    13905             p-need-unrv = false
    13906           .
    13907         end.
    13908         otherwise do:
    13909           message
    13910             vss-workfile vss-revision vss-description skip
    13911             "Неизвестный тип документа" skip
    13912             "Тип документа" p-ext-doc-type skip
    13913             view-as alert-box error .
    13914           undo, return error return-value .
    13915         end.
    13916       end case .
    13917       if p-rsrv-code = p-unrv-code
    13918       then do:
    13919         message
    13920           vss-workfile vss-revision vss-description skip
    13921           "Внутренняя ошибка" skip
    13922           "p-rsrv-code" p-rsrv-code skip
    13923           "p-unrv-code" p-unrv-code skip
    13924           view-as alert-box error .
    13925         undo, return error return-value .
    13926       end.
    13927     end.
    13928   end procedure.
    13929   procedure partparm :
    13930     define input  parameter p-parts-recid as recid     no-undo .
    13931     define output parameter p-create-part as logical   no-undo .
    13932     define output parameter p-old-return  as logical   no-undo .
    13933     define output parameter p-create-obj  as logical   no-undo .
    13934     define variable vss-description as character no-undo init "partparm-01: определяет тип партии".
    13935     define buffer buf_parts for ub.parts .
    13936     do
    13937     on error undo, return error return-value
    13938     :
    13939       find first buf_parts no-lock
    13940         where recid(buf_parts) = p-parts-recid
    13941         no-error .
    13942       if not available buf_parts
    13943       then do:
    13944         undo, return error substitute("Не найдена партия с кодом &1", p-parts-recid) .
    13945       end.
    13946       if  buf_parts.supp-type = buf_parts.obj-type
    13947       and buf_parts.supp-code = buf_parts.obj-code
    13948       then do:
    13949         assign
    13950           p-create-obj = true
    13951         .
    13952       end.
    13953       else do:
    13954         assign
    13955           p-create-obj = false
    13956         .
    13957       end.
    13958       assign
    13959         p-old-return = false
    13960       .
    13961       if buf_parts.in-code = buf_parts.out-code
    13962       then do:
    13963         assign
    13964           p-create-part = true
    13965         .
    13966         if p-create-obj = true
    13967         then do:
    13968           assign
    13969             p-old-return = false
    13970           .
    13971         end.
    13972         else do:
    13973           assign
    13974             p-old-return = true
    13975           .
    13976         end.
    13977       end.
    13978       else do:
    13979         assign
    13980           p-create-part = false
    13981         .
    13982       end.
    13983     end.
    13984   end procedure.
    13985   procedure hold-doc :
    13986     define input  parameter pardoc-code as character no-undo .
    13987     define output parameter paris-hold  as logical   no-undo .
    13988     define buffer buf_trn-doc for ub.trn-doc.
    13989     define variable vss-description as character no-undo init "hold-doc-01: определяет тип документа - холдинговый или нет".
    13990     do
    13991     for buf_trn-doc
    13992     on error undo, return error substitute ("&1 &2", return-value, error-status:get-message(1))
    13993     :
    13994       find first buf_trn-doc no-lock
    13995         where buf_trn-doc.doc-code = pardoc-code
    13996         no-error .
    13997       if not available buf_trn-doc
    13998       then do:
    13999         undo, return error substitute ("Не найден документ с номером &1.", pardoc-code).
    14000       end.
    14001       if  ( buf_trn-doc.ext-doc-type = 'ie':U
    14002             or buf_trn-doc.ext-doc-type = 'ee':U
    14003             or buf_trn-doc.ext-doc-type = 'ep':U
    14004             or buf_trn-doc.ext-doc-type = 're':U
    14005           )
    14006       and ( ( buf_trn-doc.hold-doc-code-child  <> ""
    14007               and buf_trn-doc.hold-doc-code-child  <> "no-hold":u
    14008             )
    14009             or
    14010             ( buf_trn-doc.hold-doc-code-parent <> ""
    14011               and buf_trn-doc.hold-doc-code-parent <> "no-hold":u
    14012             )
    14013           )
    14014       then do:
    14015         assign
    14016           paris-hold = yes
    14017         .
    14018       end.
    14019       else do:
    14020         assign
    14021           paris-hold = no
    14022         .
    14023       end.
    14024     end.
    14025   end procedure.
    14026   procedure docextnm :
    14027     define input  parameter p-doc-code as character no-undo .
    14028     define output parameter p-ext-name as character no-undo .
    14029     define variable vss-description as character no-undo init "docextnm-01: определяет короткое имя документа для показа в интерфейсах".
    14030     define variable v-is-hold as logical   no-undo .
    14031     define buffer buf_trn-doc for ub.trn-doc .
    14032     do
    14033     on error undo, return error return-value
    14034     :
    14035       find first buf_trn-doc no-lock
    14036         where buf_trn-doc.doc-code = p-doc-code
    14037         no-error .
    14038       if available buf_trn-doc
    14039       then do:
    14040   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    14042     (input  p-doc-code
    14043     ,output v-is-hold
    14044     )  .
    14045         case buf_trn-doc.ext-doc-type
    14046         :
    14047           when 'ie':U
    14048           then do:
    14049             if v-is-hold = false
    14050             then do:
    14051               assign
    14052                 p-ext-name = "ПН"
    14053               .
    14054             end.
    14055             else do:
    14056               assign
    14057                 p-ext-name = "ПФ"
    14058               .
    14059             end.
    14060           end.
    14061           when 'ee':U
    14062           then do:
    14063             if v-is-hold = false
    14064             then do:
    14065               assign
    14066                 p-ext-name = "РН"
    14067               .
    14068             end.
    14069             else do:
    14070               assign
    14071                 p-ext-name = "РФ"
    14072               .
    14073             end.
    14074           end.
    14075           when 'ep':U
    14076           then do:
    14077             if v-is-hold = false
    14078             then do:
    14079               assign
    14080                 p-ext-name = "РЩ"
    14081               .
    14082             end.
    14083             else do:
    14084               assign
    14085                 p-ext-name = "РЖ"
    14086               .
    14087             end.
    14088           end.
    14089           when 'es':U
    14090           then do:
    14091             assign
    14092               p-ext-name = "РК"
    14093             .
    14094           end.
    14095           when 're':U
    14096           then do:
    14097             if v-is-hold = false
    14098             then do:
    14099               assign
    14100                 p-ext-name = "ВН"
    14101               .
    14102             end.
    14103             else do:
    14104               assign
    14105                 p-ext-name = "ВФ"
    14106               .
    14107             end.
    14108           end.
    14109           when 'rs':U
    14110           then do:
    14111             assign
    14112               p-ext-name = "ВК"
    14113             .
    14114           end.
    14115           when 'we':U
    14116           then do:
    14117             assign
    14118               p-ext-name = "СН"
    14119             .
    14120           end.
    14121           when 'vt':U
    14122           then do:
    14123             assign
    14124               p-ext-name = "ИН"
    14125             .
    14126           end.
    14127           when 'vp':U
    14128           then do:
    14129             assign
    14130               p-ext-name = "ПС"
    14131             .
    14132           end.
    14133           when 'iv':U
    14134           then do:
    14135             assign
    14136               p-ext-name = "ПВ"
    14137             .
    14138           end.
    14139           when 'ev':U
    14140           then do:
    14141             assign
    14142               p-ext-name = "РВ"
    14143             .
    14144           end.
    14145           when 'io':U
    14146           then do:
    14147             assign
    14148               p-ext-name = "ПО"
    14149             .
    14150           end.
    14151           when 'eo':U
    14152           then do:
    14153             assign
    14154               p-ext-name = "РО"
    14155             .
    14156           end.
    14157           when 'rv':U
    14158           then do:
    14159             assign
    14160               p-ext-name = "ВВ"
    14161             .
    14162           end.
    14163           when 'em':U
    14164           then do:
    14165             assign
    14166               p-ext-name = "РП"
    14167             .
    14168           end.
    14169           when 'wm':U
    14170           then do:
    14171             assign
    14172               p-ext-name = "СП"
    14173             .
    14174           end.
    14175           when 'im':U
    14176           then do:
    14177             assign
    14178               p-ext-name = "ПП"
    14179             .
    14180           end.
    14181           when 'ap':U
    14182           then do:
    14183             assign
    14184               p-ext-name = "ИЦ"
    14185             .
    14186           end.
    14187           when 'mp':U
    14188           then do:
    14189             assign
    14190               p-ext-name = "ИМ"
    14191             .
    14192           end.
    14193           when 'pc':U
    14194           then do:
    14195             assign
    14196               p-ext-name = "ИТ"
    14197             .
    14198           end.
    14199           otherwise do:
    14200             assign
    14201               p-ext-name = buf_trn-doc.ext-doc-type
    14202             .
    14203           end.
    14204         end case .
    14205       end.
    14206       else do:
    14207         assign
    14208           p-ext-name = "??"
    14209         .
    14210       end.
    14211     end.
    14212   end procedure.
    14213   procedure fgdsobjt :
    14214     define input  parameter p-obj-type         like ub.fbr-gds-obj.obj-type  no-undo .
    14215     define input  parameter p-obj-code         like ub.fbr-gds-obj.obj-code  no-undo .
    14216     define input  parameter p-gds-code         like ub.fbr-gds-obj.gds-code  no-undo .
    14217     define input  parameter p-action           as character no-undo .
    14218     define output parameter p-return-attribute as character no-undo .
    14219     define variable vss-description as character no-undo initial "fgdsobjt-01: задает/получает признаки товара на объекте РЕСТОРАН".
    14220     define variable ind      as integer no-undo .
    14221     define variable v-action as character no-undo .
    14222     define variable l-find-fbr-gds-obj as logical no-undo initial false .
    14223     define buffer buf_fbr-gds-obj for ub.fbr-gds-obj .
    14224     define variable v-num-entries-p-action as integer no-undo .
    14225     assign
    14226       v-num-entries-p-action = num-entries(p-action)
    14227     .
    14228     do ind = 1 to v-num-entries-p-action
    14229     :
    14230       assign
    14231         v-action = entry(ind, p-action)
    14232       .
    14233       if lookup(entry(1, v-action, ":":U), "is-menu=request,is-semi-finished=request,is-dish=request,is-modificator=request,is-modificator-null-price=request,exist-fbr-gds-obj=request") > 0
    14234       then do:
    14235         find first buf_fbr-gds-obj no-lock
    14236           where buf_fbr-gds-obj.obj-type  = p-obj-type
    14237             and buf_fbr-gds-obj.obj-code  = p-obj-code
    14238             and buf_fbr-gds-obj.gds-code  = p-gds-code
    14239           no-error .
    14240       end.
    14241       if not available buf_fbr-gds-obj then return string(0).
    14242       if num-entries(v-action, ":":U) > 1
    14243       then do:
    14244         if entry(2, v-action, ":":U) = "exclusive-lock":U
    14245         then do:
    14246           find current buf_fbr-gds-obj exclusive-lock .
    14247         end.
    14248         if entry(2, v-action, ":":U) = "share":U
    14249         then do:
    14250           find current buf_fbr-gds-obj share-lock .
    14251         end.
    14252       end.
    14253       case entry(1, v-action, "=request":U) :
    14254         when "exist-fbr-gds-obj":U
    14255         then do:
    14256           assign
    14257           p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14258                                + if (available buf_fbr-gds-obj) then string(1) else string(0)
    14259           .
    14260         end.
    14261         when "is-menu":U
    14262         then do:
    14263           assign
    14264             p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14265                                  + if buf_fbr-gds-obj.is-menu then string(1) else string(0)
    14266           .
    14267         end.
    14268         when "is-semi-finished":U
    14269         then do:
    14270           assign
    14271           p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14272                                + if buf_fbr-gds-obj.is-semi-finished then string(1) else string(0)
    14273           .
    14274         end.
    14275         when "is-dish":U
    14276         then do:
    14277           assign
    14278           p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14279                                + string(if buf_fbr-gds-obj.is-menu then 1 else 0 +
    14280                                       if buf_fbr-gds-obj.is-semi-finished then 2 else 0 )
    14281           .
    14282         end.
    14283         when "is-modificator-null-price":U
    14284         then do:
    14285           assign
    14286           p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14287                                + string(if buf_fbr-gds-obj.is-modificator
    14288                                       and buf_fbr-gds-obj.is-null-price
    14289                                       then 1
    14290                                       else 0)
    14291           .
    14292         end.
    14293         when "is-modificator":U
    14294         then do:
    14295           assign
    14296           p-return-attribute = p-return-attribute + (if p-return-attribute = '':U then '':U else chr(44))
    14297                                + string(if buf_fbr-gds-obj.is-modificator
    14298                                       then 1
    14299                                       else 0)
    14300           .
    14301         end.
    14302         otherwise do:
    14303           message
    14304             vss-workfile vss-revision vss-description skip
    14305             "Неизвестное значение параметра v-action " skip
    14306             "v-action" v-action skip
    14307             "p-action" p-action skip
    14308             view-as alert-box error .
    14309           undo, return error return-value .
    14310         end.
    14311       end.
    14312     end.
    14313   end procedure.
    14314   procedure cntpurch :
    14315     define input  parameter p-contract-type as character no-undo .
    14316     define output parameter p-purch-code    as integer   no-undo .
    14317     define variable vss-description as character no-undo initial "cntpurch-01: Определить тип приобретения по типу контракта".
    14318     do
    14319     on error undo, return error return-value
    14320     :
    14321       if p-contract-type = ""
    14322       or p-contract-type = ?
    14323       then do:
    14324         undo, return error vss-description + "Не задан тип договора"
    14325           .
    14326       end.
    14327       if lookup(p-contract-type, 'Купли-продажи,Консигнации,Ответственного хранения,Агентский договор,Давальческого сырья,Продажи через ТПСИ,о Дополнительных расходах':U) = 0
    14328       then do:
    14329         undo, return error vss-description + "Неизвестный тип договора" + chr(10)
    14330           + substitute("Тип договора &1", p-contract-type)
    14331           .
    14332       end.
    14333       if lookup(p-contract-type, 'Купли-продажи,Агентский договор,Давальческого сырья,Продажи через ТПСИ':U) > 0
    14334       then do:
    14335         assign
    14336           p-purch-code = 1
    14337         .
    14338       end.
    14339       else do:
    14340         if lookup(p-contract-type, 'Консигнации':U) > 0
    14341         then do:
    14342           assign
    14343             p-purch-code = 2
    14344           .
    14345         end.
    14346         else do:
    14347           if lookup(p-contract-type, 'Ответственного хранения':U) > 0
    14348           then do:
    14349             assign
    14350               p-purch-code = 3
    14351             .
    14352           end.
    14353           else do:
    14354             undo, return error vss-description + "Ошибка при определении типа приобретения на основе типа договора" + chr(10)
    14355               + substitute("Тип договора &1", p-contract-type)
    14356               .
    14357           end.
    14358         end.
    14359       end.
    14360     end.
    14361   end procedure.
    14362   procedure purchnam :
    14363     define input  parameter p-purch-code as integer   no-undo .
    14364     define output parameter p-purch-name as character no-undo .
    14365     define variable vss-description as character no-undo initial "purchnam-01: Определить название типа приобретения по коду типа приобретения".
    14366     define variable v-purch-code-index as integer   no-undo .
    14367     do
    14368     on error undo, return error return-value
    14369     :
    14370       assign
    14371         v-purch-code-index = lookup(string(p-purch-code), '1,2,3,4':U )
    14372       .
    14373       if v-purch-code-index = ?
    14374       then do:
    14375         undo, return error vss-description + chr(10)
    14376           + "Тип приобретения имеет неопределённое значение" .
    14377       end.
    14378       if v-purch-code-index > 0
    14379       then do:
    14380         assign
    14381           p-purch-name = entry(v-purch-code-index, 'выкуп,консигнация,ответственное хранение,старая консигнация':U)
    14382         .
    14383       end.
    14384       else do:
    14385         undo, return error vss-description + chr(10)
    14386           + substitute("Неизвестный тип приобретения &1", p-purch-code) .
    14387       end.
    14388     end.
    14389   end procedure.
    14390   procedure xmlbegin :
    14391     define input  parameter p-file-name    as character no-undo .
    14392     define input  parameter p-option-string as character no-undo .
    14393     define variable vss-description as character no-undo initial "xmlbegin-01: Начать создание xml файла".
    14394     do
    14395     on error undo, return error return-value
    14396     :
    14397       output stream librout to value(p-file-name) .
    14398       put stream librout unformatted
    14399         substitute("<?xml version='1.0' &1?>":u, p-option-string) + chr(10)
    14400         + "<root>":u + chr(10)
    14401         .
    14402       output stream librout close .
    14403     end.
    14404   end procedure.
    14405   procedure xmlend :
    14406     define input  parameter p-file-name as character no-undo .
    14407     define variable vss-description as character no-undo initial "xmlend-01: Завершить создание xml файла".
    14408     do
    14409     on error undo, return error return-value
    14410     :
    14411       output stream librout to value(p-file-name) append .
    14412       put stream librout unformatted
    14413         "</root>":u + chr(10)
    14414         .
    14415       output stream librout close .
    14416     end.
    14417   end procedure.
    14418   procedure cutd-obj :
    14419     define input  parameter p-obj-type     as character no-undo .
    14420     define input  parameter p-obj-code     as integer   no-undo .
    14421     define output parameter p-status       as integer   no-undo .
    14422     define output parameter p-cut-date     as date      no-undo .
    14423     define output parameter p-cut-fin-date as date      no-undo .
    14424     do
    14425     on error undo, return error substitute( "&1 (cutd-obj). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14426     :
    14427       define buffer buf_clients for ub.clients .
    14428       find first buf_clients no-lock
    14429         where buf_clients.obj-type = p-obj-type
    14430           and buf_clients.obj-code = p-obj-code
    14431         no-error .
    14432       if not available buf_clients
    14433       then do:
    14434         undo, return error substitute( "&1 (cutd-obj). Объект &2 &3 не найден!", vss-workfile, p-obj-type, p-obj-code ) .
    14435       end.
    14436   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-db in g#library
    14437     (input  buf_clients.db-num
    14438     ,output p-status
    14439     ,output p-cut-date
    14440     ,output p-cut-fin-date
    14441     ) no-error .
    14442       if error-status :error
    14443       then do:
    14444         undo, return error substitute( "&1 (cutd-obj). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14445       end.
    14446     end.
    14447     return.
    14448   end procedure.
    14449   procedure cutd-db :
    14450     define input  parameter p-db-num       as integer   no-undo .
    14451     define output parameter p-status       as integer   no-undo .
    14452     define output parameter p-cut-date     as date      no-undo .
    14453     define output parameter p-cut-fin-date as date      no-undo .
    14454     do
    14455     on error undo, return error substitute( "&1 (cutd-db). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14456     :
    14457       define variable v-attr-exist as logical   no-undo .
    14458       define variable v-attr-value as character no-undo .
    14459       define variable v-attr-type  as character no-undo .
    14460       define buffer buf_sys-ctrl for ub.sys-ctrl .
    14461       assign
    14462         p-cut-date = ?
    14463         p-status   = ?
    14464       .
    14465       run db-attr-exist ( input p-db-num
    14466                          ,input 'cut-date':U
    14467                          ,output v-attr-exist
    14468                         ) no-error.
    14469       if error-status :error
    14470       then do:
    14471         undo, return error substitute( "&1 (cutd-db). Ошибка при определении наличия атрибута 'дата обрезания складских документов' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14472       end.
    14473       if v-attr-exist = true then do:
    14474         run db-attr-value ( input p-db-num
    14475                            ,input 'cut-date':U
    14476                            ,output v-attr-value
    14477                            ,output v-attr-type
    14478                           ) no-error.
    14479         if error-status :error
    14480         then do:
    14481           undo, return error substitute( "&1 (cutd-db). Ошибка при чтении значения атрибута 'дата обрезания складских документов' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14482         end.
    14483         if v-attr-value = "":U
    14484           or v-attr-value = ?
    14485         then do:
    14486           undo, return error substitute( "&1 (cutd-db). Атрибут 'дата обрезания складских документов' для БД &2 имеет некорректное значение '&3'", vss-workfile, p-db-num, v-attr-value ).
    14487         end.
    14488         else do:
    14489           assign
    14490             p-cut-date = date( v-attr-value )
    14491           .
    14492           run db-attr-exist ( input p-db-num
    14493                              ,input 'unload-after-cut':U
    14494                              ,output v-attr-exist
    14495                             ) no-error.
    14496           if error-status :error
    14497           then do:
    14498             undo, return error substitute( "&1 (cutd-db). Ошибка при определении наличия атрибута 'выгрузка после обрезания' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14499           end.
    14500           run db-attr-value ( input p-db-num
    14501                              ,input 'unload-after-cut':U
    14502                              ,output v-attr-value
    14503                              ,output v-attr-type
    14504                             ) no-error.
    14505           if error-status :error
    14506           then do:
    14507             undo, return error substitute( "&1 (cutd-db). Ошибка при чтении значения атрибута 'выгрузка после обрезани ' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14508           end.
    14509           if v-attr-exist = true
    14510             and v-attr-value = "yes":U
    14511           then do:
    14512             assign
    14513               p-status = 4
    14514             .
    14515           end.
    14516           else do:
    14517             assign
    14518               p-status = 3
    14519             .
    14520           end.
    14521         end.
    14522       end.
    14523       else do:
    14524         find first buf_sys-ctrl no-lock .
    14525         if buf_sys-ctrl.cut-date <> ? then do:
    14526           assign
    14527             p-cut-date = buf_sys-ctrl.cut-date
    14528             p-status   = 2
    14529           .
    14530         end.
    14531         else do:
    14532           assign
    14533             p-cut-date = buf_sys-ctrl.cut-date
    14534             p-status   = 1
    14535           .
    14536         end.
    14537       end.
    14538       run db-attr-exist ( input p-db-num
    14539                         ,input 'cut-fin-date':U
    14540                         ,output v-attr-exist
    14541                         ) no-error.
    14542       if error-status :error
    14543       then do:
    14544         undo, return error substitute( "&1 (cutd-db). Ошибка при определении наличия атрибута 'дата обрезания финансовых документов' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14545       end.
    14546       if v-attr-exist = true then do:
    14547         run db-attr-value ( input p-db-num
    14548                           ,input 'cut-fin-date':U
    14549                           ,output v-attr-value
    14550                           ,output v-attr-type
    14551                           ) no-error.
    14552         if error-status :error
    14553         then do:
    14554           undo, return error substitute( "&1 (cutd-db). Ошибка при чтении значения атрибута 'дата обрезания финансовых документов' для БД &2 &3&4&5", vss-workfile, p-db-num, return-value, chr(10), error-status :get-message ( error-status :num-messages ) ).
    14555         end.
    14556         if v-attr-value = "":U
    14557           or v-attr-value = ?
    14558         then do:
    14559           undo, return error substitute( "&1 (cutd-db). Атрибут 'дата обрезания финансовых документов' для БД &2 имеет некорректное значение '&3'", vss-workfile, p-db-num, v-attr-value ).
    14560         end.
    14561         else do:
    14562           assign
    14563             p-cut-fin-date = date( v-attr-value )
    14564           .
    14565         end.
    14566       end.
    14567       else do:
    14568         assign
    14569           p-cut-fin-date = ?
    14570         .
    14571       end.
    14572     end.
    14573     return.
    14574   end procedure.
    14575   procedure gdsobjpr :
    14576     do
    14577     on error undo, return error substitute( "&1 (gdsobjpr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
    14578     :
    14579     define input  parameter p-obj-type                    like ub.gds-obj.obj-type  no-undo .
    14580     define input  parameter p-obj-code                    like ub.gds-obj.obj-code  no-undo .
    14581     define input  parameter p-artic                       like ub.gds-obj.artic     no-undo .
    14582     define input  parameter p-prod-type                   like ub.gds-obj.prod-type no-undo .
    14583     define input  parameter p-prod-code                   like ub.gds-obj.prod-code no-undo .
    14584     define input  parameter p-gds-code                    like ub.gds-obj.gds-code no-undo .
    14585     define output parameter p-amin                        as logical no-undo .
    14586     define output parameter p-izt                         as character no-undo .
    14587     define output parameter p-gdop-min-stock              as decimal   no-undo .
    14588     define output parameter p-grop-max-stock              as decimal   no-undo .
    14589     define output parameter p-grop-level-always-presence  as decimal   no-undo .
    14590     define output parameter p-grop-min-order              as decimal   no-undo .
    14591   define buffer buf_goods for  ub.goods .
    14592   define buffer buf_gds-obj-prop for  ub.gds-obj-prop .
    14593   if p-gds-code = ? or p-gds-code = 0  then do:
    14594      find first buf_goods no-lock where
    14595           buf_goods.artic      = p-artic     and
    14596           buf_goods.prod-type  = p-prod-type and
    14597           buf_goods.prod-code  = p-prod-code no-error .
    14598           if error-status :error
    14599           then do:
    14600             undo, return error substitute( "Ошибка при определении товара &1 &2 &3 &4",
    14601             p-artic   ,
    14602             p-prod-type,
    14603             p-prod-code ,
    14604             error-status :get-message (1) ).
    14605           end.
    14606      p-gds-code = buf_goods.gds-code.
    14607   end.
    14608   find first buf_gds-obj-prop no-lock where
    14609              buf_gds-obj-prop.gds-code = p-gds-code and
    14610              buf_gds-obj-prop.obj-type = p-obj-type and
    14611              buf_gds-obj-prop.obj-code = p-obj-code no-error .
    14612              if available buf_gds-obj-prop
    14613              then do:
    14614                 assign
    14615                   p-amin = buf_gds-obj-prop.gdop-assort-min
    14616                   p-izt  = buf_gds-obj-prop.gdop-igt
    14617                   p-gdop-min-stock               = buf_gds-obj-prop.gdop-min-stock
    14618                   p-grop-max-stock               = buf_gds-obj-prop.grop-max-stock
    14619                   p-grop-level-always-presence   = buf_gds-obj-prop.grop-level-always-presence
    14620                   p-grop-min-order               = buf_gds-obj-prop.grop-min-order
    14621                 .
    14622              end.
    14623              else do:
    14624                 assign
    14625                   p-amin = false
    14626                   p-izt  = 'Пусто':U
    14627                   p-gdop-min-stock               = 0
    14628                   p-grop-max-stock               = 0
    14629                   p-grop-level-always-presence   = 0
    14630                   p-grop-min-order               = 0
    14631                 .
    14632              end.
    14633   end.
    14634   end procedure.
    14635   procedure glstmain :
    14636   define output parameter p-main-price-list as logical   no-undo .
    14637   define buffer buf_global-state for ub.global-state  .
    14638     do
    14639     on error undo, return error return-value
    14640     :
    14641    find first  buf_global-state no-lock no-error .
    14642    if not available buf_global-state then create buf_global-state.
    14643       assign
    14644           p-main-price-list  = false
    14645       .
    14646   if  logical(buf_global-state.db-num-chg)   = true  and
    14647       buf_global-state.pl-use-grp-buy        = false and
    14648       buf_global-state.pl-use-oborot-buy     = false and
    14649       buf_global-state.pl-use-qnty-group     = false and
    14650       buf_global-state.pl-use-sum-group      = false and
    14651       buf_global-state.pl-use-sys-date-time  = false and
    14652       buf_global-state.pl-use-shift-date-num = false and
    14653       buf_global-state.pl-use-cassa          = false and
    14654       buf_global-state.pl-use-val            = false and
    14655       buf_global-state.pl-use-pay-type       = false and
    14656       buf_global-state.pl-use-child          = false and
    14657       buf_global-state.pl-use-cash-pay       = false
    14658       then do:
    14659         p-main-price-list  = true  .
    14660       end.
    14661     end.
    14662   end procedure.
    14663   procedure glstall :
    14664   define output parameter p-use-grp-buy          as logical   no-undo .
    14665   define output parameter p-use-oborot-buy       as logical   no-undo .
    14666   define output parameter p-use-qnty-group       as logical   no-undo .
    14667   define output parameter p-use-sum-group        as logical   no-undo .
    14668   define output parameter p-use-add-code         as logical   no-undo .
    14669   define output parameter p-use-sys-date-time    as logical   no-undo .
    14670   define output parameter p-use-shift-date-num   as logical   no-undo .
    14671   define output parameter p-use-cassa            as logical   no-undo .
    14672   define output parameter p-use-val              as logical   no-undo .
    14673   define output parameter p-use-pay-type         as logical   no-undo .
