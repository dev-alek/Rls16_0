     2889      define output parameter p-host           as logical no-undo .
     2890      define output parameter p-shop           as logical no-undo .
     2891      define output parameter p-store          as logical no-undo .
     2892      define output parameter p-db             as logical no-undo .
     2893      define variable p-region as logical no-undo.
     2894      run thbjattr_code_reg in this-procedure (
     2895                                               p-upper-code,
     2896                                               p-code,
     2897                                               output p-label,
     2898                                               output p-user-can-edit,
     2899                                               output p-output-display,
     2900                                               output p-other,
     2901                                               output p-prop-list,
     2902                                               output p-prop-type-list,
     2903                                               output p-prop-label-list,
     2904                                               output p-global,
     2905                                               output p-host,
     2906                                               output p-shop,
     2907                                               output p-store,
     2908                                               output p-db,
     2909                                               output p-region
     2910                                               ).
     2911   end procedure.
