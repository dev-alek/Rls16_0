     6145   procedure unitbase :
     6146     define input  parameter p-gds-code  like ub.goods.gds-code  no-undo .
     6147     define output parameter p-unit-base like ub.goods.unit-base no-undo .
     6148     define variable vss-description as character no-undo initial "unitbase-01: определение базовой единицы измерения товара".
     6149     define buffer buf_goods for ub.goods .
     6150     do
     6151     on error undo, return error return-value
     6152     :
     6153       find first buf_goods no-lock
     6154         where buf_goods.gds-code = p-gds-code
     6155         no-error .
     6156       if not available buf_goods
     6157       then do:
     6158         message
     6159           vss-workfile vss-revision vss-description skip
