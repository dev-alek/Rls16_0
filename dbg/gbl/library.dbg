    11865   procedure objdtget :
    11866     define input  parameter p-obj-type like ub.obj-date.obj-type no-undo .
    11867     define input  parameter p-obj-code like ub.obj-date.obj-code no-undo .
    11868     define output parameter p-sys-date like ub.obj-date.sys-date no-undo .
    11869     define variable vss-description as character no-undo initial "objdtget-01: запросить текущую дату на объекте".
    11870     do
    11871     on error undo, return error return-value
    11872     :
    11873       define buffer buf_obj-date for ub.obj-date .
    11874       find first buf_obj-date
    11875         where buf_obj-date.obj-type = p-obj-type
    11876           and buf_obj-date.obj-code = p-obj-code
    11877           and buf_obj-date.status_  = 'тек':U
    11878         no-error .
    11879       if not available buf_obj-date
    11880       then do:
    11881         undo, return error substitute("На объекте не задана текущая дата. Объект &1 &2", p-obj-type, p-obj-code) .
    11882       end.
    11883       assign
    11884         p-sys-date = buf_obj-date.sys-date
    11885       .
    11886       RELEASE buf_obj-date.
    11887     end.
    11888   end procedure.
    11889   procedure objdtset :
    11890     define input parameter p-obj-type like ub.obj-date.obj-type   no-undo .
    11891     define input parameter p-obj-code like ub.obj-date.obj-code   no-undo .
    11892     define input parameter p-sys-date like ub.obj-date.sys-date no-undo .
    11893     define variable vss-description as character no-undo initial "objdtset-01: установить текущую дату на объекте".
    11894     do transaction
    11895     on error undo, return error return-value
    11896     :
    11897       define buffer buf_obj-date for ub.obj-date .
    11898   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run odtclose in g#library
    11900     (input p-obj-type
    11901     ,input p-obj-code
    11902     ,input p-sys-date
