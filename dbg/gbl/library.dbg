     5888                 then do:
     5889                   message
     5890                     "Параметр" p-code "действующий в данный момент отсутствует в БД" skip
     5891                     view-as alert-box error.
     5892                 end.
     5893                 undo, return error substitute ("Параметр &1 действующий в данный момент отсутствует в БД.", p-code ).
     5894               end.
     5895             end.
     5896           end.
     5897           if buf_config.param-type = 'L':U
     5898           then do:
     5899             assign
     5900               p-type  = buf_config.param-type
     5901             .
     5902             find first buf_config no-lock
     5903               where buf_config.param-code = p-code
     5904                 and buf_config.host-code  = 0
     5905                 and buf_config.obj-type   = ""
     5906                 and buf_config.obj-code   = 0
     5907                 and buf_config.beg-date   <= v-today
     5908                 and buf_config.end-date   >= v-today
     5909                 and buf_config.db-num     = p-db-num
     5910                 and buf_config.param-value = "yes":U
     5911               no-error .
     5912             if not available buf_config
     5913             then do:
     5914               find first buf_config no-lock
     5915                 where buf_config.param-code = p-code
     5916                   and buf_config.host-code  = 0
     5917                   and buf_config.obj-type   = ""
     5918                   and buf_config.obj-code   = 0
     5919                   and buf_config.beg-date   <= v-today
     5920                   and buf_config.end-date   >= v-today
     5921                   and buf_config.db-num     = p-db-num
     5922                 no-error .
     5923             end.
     5924             if available buf_config then do:
     5925               run check-cfg-param in this-procedure
     5926                 ( input buf_config.conf-type
     5927                  ,input buf_config.param-code
     5928                  ,input buf_config.db-num
     5929                  ,input buf_config.param-value
     5930                  ,input buf_config.beg-date
     5931                  ,input buf_config.end-date
     5932                  ,input buf_config.param-encoded
     5933                  ,input buf_config.host-code
     5934                  ,input buf_config.obj-type
     5935                  ,input buf_config.obj-code
     5936                  ,input msg-on
     5937                  ,output v-level
     5938                 ) no-error .
     5939               if error-status :error
     5940               then do:
     5941                 undo, return error return-value .
     5942               end.
     5943               assign
     5944                 p-value = buf_config.param-value
     5945               .
     5946             end.
     5947             else do:
     5948               if msg-on = TRUE
     5949               then do:
     5950                 message
     5951                   "Параметр" p-code "действующий в данный момент отсутствует в БД." skip
     5952                   "или имеет ошибочную привязку" skip
     5953                   view-as alert-box error.
     5954               end.
     5955               undo, return error substitute ("Параметр &1 действующий в данный момент отсутствует в БД.", p-code ).
     5956             end.
     5957           end.
     5958         end.
     5959         else do:
     5960           if o-type <> ""
     5961             and o-code <> 0
     5962           then do:
     5963             assign
     5964               l-object-specified = true
     5965             .
     5966   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5967   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5968     (input  o-type
     5969     ,input  o-code
     5970     ,output v-host-code
     5971     ) no-error .
     5972             if error-status :error
     5973             then do:
     5974               if msg-on = TRUE
     5975               then do:
     5976                 message
     5977                   vss-workfile vss-revision vss-description skip
     5978                   "Ошибка при определении кода фирмы для объекта" skip
     5979                   "o-type" o-type skip
     5980                   "o-code" o-code skip
     5981                   error-status :get-message(1) skip
     5982                   return-value skip
     5983                   view-as alert-box error .
     5984               end.
     5985               undo, return error substitute( "Ошибка при определении кода фирмы для объекта &1 &2", o-type, o-code ) .
     5986             end.
     5987             if h-code = 0
     5988               or h-code = ?
     5989             then do:
     5990               assign
     5991                 h-code = v-host-code
     5992               .
     5993             end.
