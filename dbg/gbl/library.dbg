    11936   procedure objdtcr :
    11937     define input parameter p-obj-type like ub.obj-date.obj-type no-undo .
    11938     define input parameter p-obj-code like ub.obj-date.obj-code no-undo .
    11939     define input parameter p-sys-date like ub.obj-date.sys-date no-undo .
    11940     define variable vss-description as character no-undo initial "objdtcr-01: создать новую текущую дату на объекте".
    11941     define buffer buf_obj-date for ub.obj-date .
    11942     do
    11943     on error undo, return error return-value
    11944     :
    11945       create buf_obj-date .
    11946       assign
    11947         buf_obj-date.obj-type = p-obj-type
    11948         buf_obj-date.obj-code = p-obj-code
    11949         buf_obj-date.sys-date = p-sys-date
    11950         buf_obj-date.status_  = 'тек':U
    11951       .
    11952       release buf_obj-date .
    11953     end.
    11954   end procedure.
    11955   procedure odtclose :
    11956     define input parameter p-obj-type like ub.obj-date.obj-type no-undo .
    11957     define input parameter p-obj-code like ub.obj-date.obj-code no-undo .
    11958     define input parameter p-sys-date like ub.obj-date.sys-date no-undo .
    11959     define variable vss-description as character no-undo initial "odtclose-01: закрыть текущую дату на объекте".
    11960     do transaction
    11961     on error undo, return error return-value
    11962     :
    11963       define buffer buf_obj-date for ub.obj-date .
    11964       find first buf_obj-date exclusive-lock
    11965         where buf_obj-date.obj-type = p-obj-type
    11966           and buf_obj-date.obj-code = p-obj-code
    11967           and buf_obj-date.status_  = 'тек':U
    11968         no-error .
    11969       if not available buf_obj-date
    11970       then do:
    11971         message
    11972           vss-workfile vss-revision vss-description skip
    11973           "На объекте не задана текущая дата" skip
    11974           "Объект" p-obj-type p-obj-code skip
    11975           view-as alert-box error .
    11976         undo, return error return-value .
    11977       end.
    11978       if p-sys-date < buf_obj-date.sys-date
    11979       then do:
    11980         message
    11981           vss-workfile vss-revision vss-description skip
    11982           "Новая дата не может быть меньше текущей даты" skip
    11983           "Объект" p-obj-type p-obj-code skip
    11984           "Новая дата" p-sys-date skip
    11985           "Текущая дата" buf_obj-date.sys-date skip
    11986           view-as alert-box error .
    11987         undo, return error return-value .
    11988       end.
    11989       assign
    11990         buf_obj-date.status_ = 'зкр':U
    11991       .
    11992       release buf_obj-date .
    11993     end.
    11994   end procedure.
    11995   procedure curr-r-b :
    11996     define output parameter p-r-b       as character no-undo .
    11997     define variable vss-description as character no-undo initial "curr-r-b-1: определение типа валюты продажи".
    11998     define buffer buf_sys-ctrl for ub.sys-ctrl .
    11999     do
    12000     on error undo, return error return-value
    12001     :
    12002       find first buf_sys-ctrl no-lock .
    12003       assign
    12004         p-r-b = buf_sys-ctrl.r-b
    12005       .
    12006       if  p-r-b <> 'rubl':U
    12007       and p-r-b <> 'base':U
    12008       then do:
    12009         message
    12010           vss-workfile vss-revision vss-description skip
    12011           "Недопустимое значение типа валюты продажи" p-r-b skip
    12012           view-as alert-box error .
    12013         undo, return error return-value .
    12014       end.
    12015     end.
    12016   end procedure.
    12017   procedure currsysk :
    12018     define output parameter p-sys-key       as character no-undo .
    12019     define variable vss-description as character no-undo initial "curr-sk: определение sys-key".
    12020     define buffer buf_sys-ctrl for ub.sys-ctrl .
    12021     do
    12022     on error undo, return error return-value
    12023     :
    12024       find first buf_sys-ctrl no-lock .
    12025       assign
    12026         p-sys-key = buf_sys-ctrl.sys-key
    12027       .
    12028       if p-sys-key = ? then do:
    12029         assign
    12030           p-sys-key = "":U
    12031         .
    12032       end.
    12033     end.
    12034   end procedure.
    12035   procedure rbisbase :
    12036     define output parameter p-rb-is-base as logical   no-undo .
    12037     do
    12038     on error undo, return error return-value
    12039     :
    12040       define variable v-curr-r-b as character no-undo .
    12041   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    12042   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    12043     (output v-curr-r-b
    12044     )  .
    12045       if v-curr-r-b = 'base':U
    12046       then do:
    12047         assign
    12048           p-rb-is-base = true
    12049         .
    12050       end.
    12051       else do:
    12052         assign
    12053           p-rb-is-base = false
    12054         .
    12055       end.
    12056     end.
    12057   end procedure.
    12058   procedure r-b-curr :
    12059     define input parameter  p-host-code  like ub.sysconf.host-code     no-undo .
    12060     define output parameter p-curr-code  as integer   no-undo .
    12061     define variable vss-description as character no-undo initial "r-b-curr-01: определение кода валюты r-b для фирмы".
    12062     define variable v-curr-r-b  as character no-undo .
    12063     do
    12064     on error undo, return error return-value
    12065     :
    12066   define variable vss-include-info87 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    12067   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    12068     (output v-curr-r-b
    12069     ) no-error .
    12070       if error-status :error
    12071       then do:
    12072         message
    12073           vss-workfile vss-revision vss-description skip
    12074           "Ошибка при вызове процедуры curr-r-b" skip
    12075           error-status :get-message(1) skip
    12076           return-value skip
    12077           view-as alert-box error .
    12078         undo, return error return-value .
    12079       end.
    12080       if v-curr-r-b = 'rubl':U
    12081       then do:
    12082         assign
    12083           p-curr-code = 0
    12084         .
    12085       end.
    12086       else do:
    12087   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    12089     (input  p-host-code
    12090     ,output p-curr-code
    12091     ) no-error .
    12092         if error-status :error
    12093         then do:
    12094           undo, return error return-value .
    12095         end.
    12096       end.
    12097     end.
    12098   end procedure.
    12099   procedure r-b-abbr :
    12100     define input parameter  p-host-code  like ub.sysconf.host-code     no-undo .
    12101     define output parameter p-r-b-abbr   as character no-undo .
    12102     define variable vss-description as character no-undo initial "r-b-abbr-03: определение аббревиатуры валюты r-b для фирмы".
    12103     define variable v-curr-code as integer   no-undo .
    12104     define buffer buf_currency for ub.currency.
    12105     do
    12106     on error undo, return error return-value
    12107     :
    12108   define variable vss-include-info89 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    12109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
    12110     (input  p-host-code
    12111     ,output v-curr-code
    12112     ) no-error .
    12113       if error-status :error
    12114       then do:
    12115         undo, return error return-value .
    12116       end.
    12117       find first buf_currency no-lock
    12118         where buf_currency.curr-code = v-curr-code
    12119         no-error .
    12120       if not available buf_currency
    12121       then do:
    12122         assign
    12123           p-r-b-abbr = "?"
    12124         .
    12125         message
    12126           vss-workfile vss-revision vss-description skip
    12127           "Не найдена валюта" skip
    12128           "curr-code" v-curr-code skip
    12129           view-as alert-box error .
    12130         undo, return error return-value .
    12131       end.
    12132       assign
    12133         p-r-b-abbr = buf_currency.curr-abbr
    12134       .
    12135     end.
    12136   end procedure.
    12137   procedure objdpcnt :
    12138     define input parameter p-type like ub.dis-card-type.type no-undo .
    12139     define input parameter p-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo .
    12140     define input parameter p-host-code like ub.sysconf.host-code  no-undo .
    12141     define input parameter p-obj-type like ub.clients.obj-type   no-undo .
    12142     define input parameter p-obj-code like ub.clients.obj-code   no-undo .
    12143     define input parameter p-discnt-role as character no-undo .
    12144     define output parameter p-d-pcnt as decimal no-undo init ?.
    12145     define variable vss-description as character no-undo initial "objdpcnt2: определение скидки по карте на объекте".
    12146     do transaction
    12147     on error undo, return error return-value
    12148     :
    12149       define buffer buf_dis-dct-rule for ub.dis-dct-rule .
    12150       define buffer buf_dis-rule for ub.dis-rule.
    12151       if NOT (p-discnt-role = 'def-pcnt':U
    12152               OR
    12153               p-discnt-role = 'def-cash-pcnt':U
    12154               or
    12155               p-discnt-role = 'def-categ':U
    12156               )
    12157       then do:
    12158           message
    12159             vss-workfile vss-revision vss-description skip
    12160             "Неверные параметры вызова" skip
    12161             "p-discnt-role" skip
    12162             view-as alert-box error .
    12163           undo, return error return-value .
    12164       end.
    12165       FIND FIRST buf_dis-dct-rule No-LOCK WHERE
    12166                           buf_dis-dct-rule.type = p-type
    12167                       AND buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
    12168                       AND buf_dis-dct-rule.host-code = p-host-code
    12169                       AND buf_dis-dct-rule.obj-type = p-obj-type
    12170                       and buf_dis-dct-rule.obj-code = p-obj-code
    12171                       and buf_dis-dct-rule.pos-type = 'bo':U
    12172                       and buf_dis-dct-rule.discnt-role = p-discnt-role No-ERROR.
    12173       if available buf_dis-dct-rule
    12174       then do:
    12175         find first buf_dis-rule NO-lock
    12176           where buf_dis-rule.rule-num = buf_dis-dct-rule.rule-num no-error.
    12177         if not avail buf_dis-rule
    12178         then do:
    12179             p-d-pcnt = ?.
    12180             undo, return error
    12181             substitute("Не найдена скидка для типа ДК: тип &1 эмитент &2&3тип скидки &4"
    12182                        , p-type
    12183                        , p-emitent-host-code
    12184                        , chr(10)
    12185                        ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
    12186                        ) .
    12187         end.
    12188         assign
    12189         p-d-pcnt = (if p-discnt-role = 'def-categ':U
    12190                     then buf_dis-rule.dis-kat
    12191                     else buf_dis-rule.discnt-value).
    12192         return.
    12193       end.
    12194     end.
    12195   end procedure.
    12196   procedure wthobjcr :
    12197     define input parameter  v-obj-type  like ub.wth-obj.obj-type  no-undo .
    12198     define input parameter  v-obj-code  like ub.wth-obj.obj-code  no-undo .
    12199     define input parameter  v-wth-code  like ub.wth-obj.wth-code     no-undo .
    12200     define parameter buffer buf_wth-obj for ub.wth-obj .
    12201     define variable vss-description as character no-undo initial "wthobjcr-01: поиск/cоздание записи о МЦ на объекте".
    12202     define buffer buf_wealth for ub.wealth .
    12203     find first buf_wth-obj no-lock
    12204       where buf_wth-obj.obj-type  = v-obj-type
    12205         and buf_wth-obj.obj-code  = v-obj-code
    12206         and buf_wth-obj.wth-code  = v-wth-code
    12207       no-error .
    12208     if not available buf_wth-obj
    12209     then do:
    12210       do transaction
    12211       on error undo, return error return-value
    12212       :
    12213         find first buf_wealth share-lock
    12214           where buf_wealth.wth-code = v-wth-code
    12215           no-error .
    12216         if not available buf_wealth
    12217         then do:
    12218           message
    12219             "МЦ" v-wth-code "не найдена."
    12220             view-as alert-box .
    12221           undo, return error return-value .
    12222         end.
    12223         create buf_wth-obj.
    12224         assign
    12225           buf_wth-obj.obj-type     = v-obj-type
    12226           buf_wth-obj.obj-code     = v-obj-code
    12227           buf_wth-obj.wth-code     = v-wth-code
    12228         .
    12229   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12231     (input  v-obj-type
    12232     ,input  v-obj-code
    12233     ,output buf_wth-obj.host-code
    12234     ) no-error .
    12235         if error-status :error
    12236         then do:
    12237           message
    12238             vss-workfile vss-revision vss-description skip
    12239             "Ошибка при определении кода фирмы для объекта" skip
    12240             "v-obj-type" v-obj-type skip
    12241             "v-obj-code" v-obj-code skip
    12242             error-status :get-message(1) skip
    12243             return-value skip
    12244             view-as alert-box error .
    12245           undo, return error return-value .
    12246         end.
    12247         define buffer buf_wth-pobj for ub.wth-pobj .
    12248         for each buf_wth-pobj no-lock
    12249           where buf_wth-pobj.obj-type   = v-obj-type
    12250             and buf_wth-pobj.obj-code   = v-obj-code
    12251             and buf_wth-pobj.wth-code    = v-wth-code
    12252         on error undo, return error return-value
    12253         :
    12254           if buf_wth-pobj.incass-bank-pl <> 0
    12255           or buf_wth-pobj.incass-other-pl <> 0
    12256           or buf_wth-pobj.incass-cassa-pl <> 0
    12257           or buf_wth-pobj.incass-pl <> 0
    12258           or buf_wth-pobj.income-cassa-pl <> 0
    12259           or buf_wth-pobj.income-other-pl <> 0
    12260           or buf_wth-pobj.income-pl <> 0
    12261           then do:
    12262             message
    12263               vss-workfile vss-revision vss-description skip
    12264               "Ошибка при создании МЦ на объекте" skip
    12265               "Уже существует МЦ на МХ объекта с ненулевыми суммами" skip
    12266               "Объект"  v-obj-type v-obj-code skip
    12267               "Код МЦ" v-wth-code skip
    12268               "Код МХ" buf_wth-pobj.w-p-code skip
    12269               "Сумма инкассировано в банк" buf_wth-pobj.incass-bank-pl SKIP
    12270               "Сумма возврата по кассе" buf_wth-pobj.incass-cassa-pl SKIP
    12271               "Сумма других расходов" buf_wth-pobj.incass-other-pl SKIP
    12272               "Сумма расходов всего" buf_wth-pobj.incass-pl SKIP
    12273               "Сумма выручки" buf_wth-pobj.income-cassa-pl
    12274               "Сумма других приходов" buf_wth-pobj.income-other-pl
    12275               "Сумма приходов всего" buf_wth-pobj.income-pl
    12276               view-as alert-box error .
    12277             undo, return error return-value .
    12278           end.
    12279         end.
    12280       end.
    12281     end.
    12282   end procedure.
    12283   procedure wthpobjc :
    12284     define input parameter  v-obj-type  like ub.wth-pobj.obj-type  no-undo .
    12285     define input parameter  v-obj-code  like ub.wth-pobj.obj-code  no-undo .
    12286     define input parameter  v-wth-code  like ub.wth-pobj.wth-code  no-undo .
    12287     define input parameter  v-w-p-code  like ub.wth-pobj.wth-code  no-undo .
    12288     define parameter buffer buf_wth-pobj for ub.wth-pobj .
    12289     define variable vss-description as character no-undo initial "wthpobjc-01: поиск/cоздание записи о МЦ на МХ объекта".
    12290     define buffer buf_wealth for ub.wealth .
    12291     define buffer buf_wth-place for ub.wth-place .
    12292     define buffer buf_wth-obj for ub.wth-obj .
    12293     find first buf_wth-pobj no-lock
    12294       where buf_wth-pobj.obj-type  = v-obj-type
    12295         and buf_wth-pobj.obj-code  = v-obj-code
    12296         and buf_wth-pobj.wth-code  = v-wth-code
    12297         and buf_wth-pobj.w-p-code  = v-w-p-code
    12298       no-error .
    12299     if not available buf_wth-pobj
    12300     then do:
    12301       do transaction
    12302       on error undo, return error return-value
    12303       :
    12304         find first buf_wealth share-lock
    12305           where buf_wealth.wth-code = v-wth-code
    12306           no-error .
    12307         if not available buf_wealth
    12308         then do:
    12309           message
    12310             "МЦ" v-wth-code "не найдена."
    12311             view-as alert-box .
    12312           undo, return error return-value .
    12313         end.
    12314         find first buf_wth-place share-lock
    12315           where buf_wth-place.w-p-code = v-w-p-code
    12316             AND buf_wth-place.obj-type = v-obj-type
    12317             AND buf_wth-place.obj-code = v-obj-code
    12318           no-error .
    12319         if not available buf_wth-place
    12320         then do:
    12321           message
    12322             "МХ" v-w-p-code
    12323             "объект" v-obj-type v-obj-code
    12324             "не найдено."
    12325             view-as alert-box .
    12326           undo, return error return-value .
    12327         end.
    12328         create buf_wth-pobj.
    12329         assign
    12330           buf_wth-pobj.obj-type     = v-obj-type
    12331           buf_wth-pobj.obj-code     = v-obj-code
    12332           buf_wth-pobj.wth-code     = v-wth-code
    12333           buf_wth-pobj.w-p-code     = v-w-p-code
    12334         .
    12335   define variable vss-include-info91 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    12337     (input  v-obj-type
    12338     ,input  v-obj-code
    12339     ,output buf_wth-pobj.host-code
    12340     ) no-error .
    12341         if error-status :error
    12342         then do:
    12343           message
    12344             vss-workfile vss-revision vss-description skip
    12345             "Ошибка при определении кода фирмы для объекта" skip
    12346             "v-obj-type" v-obj-type skip
    12347             "v-obj-code" v-obj-code skip
    12348             error-status :get-message(1) skip
    12349             return-value skip
    12350             view-as alert-box error .
    12351           undo, return error return-value .
    12352         end.
    12353       end.
    12354     end.
    12355   end procedure.
    12356   procedure wthcheck :
    12357     define input parameter p-obj-type  like ub.wth-obj.obj-type  no-undo .
    12358     define input parameter p-obj-code  like ub.wth-obj.obj-code  no-undo .
    12359     define input parameter p-wth-code  like ub.wth-obj.wth-code  no-undo .
    12360     define input parameter p-mode      as character              no-undo .
    12361     define variable vss-description as character no-undo initial "wthcheck-01: Проверка целостности МЦ" .
    12362     define buffer buf_wealth      for ub.wealth .
    12363     define buffer buf_wth-obj     for ub.wth-obj .
    12364     define buffer buf_wth-pobj    for ub.wth-pobj .
    12365     define buffer buf_temp-pl-wth for temp-pl-wth .
    12366     define variable l-bad-wth as logical  initial true .
    12367     define variable v-message as character no-undo .
    12368     if  p-mode <> ""
    12369     and p-mode <> ?
    12370     and p-mode <> "return"
    12371     then do:
    12372       message
    12373         vss-workfile vss-revision vss-description skip
    12374         "Неизвестное значение параметра p-mode" skip
    12375         "p-mode" p-mode skip
    12376         view-as alert-box information.
    12377       undo, return error return-value .
    12378     end.
    12379     assign
    12380       v-message = "Объект" + " " + string(p-obj-type) + " " + string(p-obj-code) + chr(10)
    12381                 + "МЦ" + " " + string(p-wth-code) + chr(10)
    12382     .
    12383     check_block:
    12384     do
    12385     on error undo check_block, leave
    12386     :
    12387       assign
    12388         l-bad-wth = false
    12389       .
    12390       find first buf_wealth no-lock
    12391         where buf_wealth.wth-code     = p-wth-code
    12392         no-error .
    12393       if not available buf_wealth
    12394       then do:
    12395         assign
    12396           v-message = v-message
    12397                     + "Не найдена запись МЦ" + chr(10)
    12398           l-bad-wth = true
    12399         .
    12400         leave check_block.
    12401       end.
    12402       if buf_wealth.PS begins "%%%"
    12403       then do:
    12404         return .
    12405       end.
    12406       find first buf_wth-obj exclusive-lock
    12407         where buf_wth-obj.obj-type  = p-obj-type
    12408           and buf_wth-obj.obj-code  = p-obj-code
    12409           and buf_wth-obj.wth-code  = p-wth-code
    12410         no-error .
    12411       if not available buf_wth-obj
    12412       then do:
    12413         assign
    12414           v-message = v-message
    12415                     + "Не найдена запись МЦ на объекте" + chr(10)
    12416           l-bad-wth = true
    12417         .
    12418         leave check_block.
    12419       end.
    12420       DEFINE VARIABLE v-incass-bank  like ub.wth-obj.incass-bank  no-undo .
    12421       DEFINE VARIABLE v-incass-other like ub.wth-obj.incass-other no-undo .
    12422       DEFINE VARIABLE v-incass-cassa like ub.wth-obj.incass-cassa no-undo .
    12423       DEFINE VARIABLE v-incass       like ub.wth-obj.incass       no-undo .
    12424       DEFINE VARIABLE v-income-cassa like ub.wth-obj.income-cassa no-undo .
    12425       DEFINE VARIABLE v-income-other like ub.wth-obj.income-other no-undo .
    12426       DEFINE VARIABLE v-income       like ub.wth-obj.income       no-undo .
    12427       assign
    12428       v-incass-bank  = 0
    12429       v-incass-other = 0
    12430       v-incass-cassa = 0
    12431       v-incass       = 0
    12432       v-income-cassa = 0
    12433       v-income-other = 0
    12434       v-income       = 0
    12435       .
    12436       for each buf_wth-pobj share-lock
    12437         where buf_wth-pobj.obj-type  = p-obj-type
    12438           and buf_wth-pobj.obj-code  = p-obj-code
    12439           and buf_wth-pobj.wth-code   = p-wth-code
    12440       on error undo check_block, leave check_block
    12441       :
    12442         assign
    12443         v-incass-bank  = v-incass-bank  + buf_wth-pobj.incass-bank-pl
    12444         v-incass-other = v-incass-other + buf_wth-pobj.incass-other-pl
    12445         v-incass-cassa = v-incass-cassa + buf_wth-pobj.incass-cassa-pl
    12446         v-incass       = v-incass       + buf_wth-pobj.incass-pl
    12447         v-income-cassa = v-income-cassa + buf_wth-pobj.income-cassa-pl
    12448         v-income-other = v-income-other + buf_wth-pobj.income-other-pl
    12449         v-income       = v-income       + buf_wth-pobj.income-pl
    12450         .
    12451       end.
    12452       if
    12453       (v-incass-bank + v-incass-other + v-incass-cassa) <> v-incass OR
    12454       (v-income-cassa + v-income-other) <> v-income OR
    12455       (buf_wth-obj.incass-bank + buf_wth-obj.incass-other + buf_wth-obj.incass-cassa) <> buf_wth-obj.incass OR
    12456       (buf_wth-obj.income-cassa + buf_wth-obj.income-other) <> buf_wth-obj.income
    12457       then do:
    12458         assign
    12459           v-message = v-message
    12460                     + "Суммы по МХ не совпадают с суммами по МЦ на объекте" + chr(10)
    12461                     + "или не корреллируют друг с другом" + chr(10)
    12462                     + "По МЦ на объекте:"          +         chr(10)
    12463                     + "Сумма инкассировано в банк" + chr(32) + string(buf_wth-obj.incass-bank ) + chr(10)
    12464                     + "Сумма возвратов по кассе"   + chr(32) + string(buf_wth-obj.incass-cassa) + chr(10)
    12465                     + "Сумма других расходов"      + chr(32) + string(buf_wth-obj.incass-other) + chr(10)
    12466                     + "Сумма расходов всего"       + chr(32) + string(buf_wth-obj.incass      ) + chr(10)
    12467                     + "Сумма выручки"              + chr(32) + string(buf_wth-obj.income-cassa) + chr(10)
    12468                     + "Сумма других приходов"      + chr(32) + string(buf_wth-obj.income-other) + chr(10)
    12469                     + "Сумма приходов всего"       + chr(32) + string(buf_wth-obj.income      ) + chr(10)
    12470                     + "По МХ:" + chr(10)
    12471                     + "Сумма инкассировано в банк" + chr(32) + string(          v-incass-bank ) + chr(10)
    12472                     + "Сумма возвратов по кассе"   + chr(32) + string(          v-incass-cassa) + chr(10)
    12473                     + "Сумма других расходов"      + chr(32) + string(          v-incass-other) + chr(10)
    12474                     + "Сумма расходов всего"       + chr(32) + string(          v-incass      ) + chr(10)
    12475                     + "Сумма выручки"              + chr(32) + string(          v-income-cassa) + chr(10)
    12476                     + "Сумма других приходов"      + chr(32) + string(          v-income-other) + chr(10)
    12477                     + "Сумма приходов всего"       + chr(32) + string(          v-income      ) + chr(10)
    12478           l-bad-wth = true
    12479         .
    12480         leave check_block.
    12481       end.
    12482     end.
    12483     if l-bad-wth
    12484     then do:
    12485       define variable v-return-value as character no-undo .
    12486       if p-mode = ""
    12487       or p-mode = ?
    12488       then do:
    12489         message
    12490           vss-workfile + " " + vss-revision + " " + vss-description + chr(10)
    12491           v-message + chr(10)
    12492           view-as alert-box .
    12493       end.
    12494       if p-mode = "return"
    12495       then do:
    12496         assign
    12497           v-return-value = v-message
    12498         .
    12499       end.
    12500       undo, return error v-return-value .
    12501     end.
    12502   end procedure.
    12503   procedure wthobjat :
    12504     define input  parameter p-obj-type         like ub.wth-obj.obj-type  no-undo .
    12505     define input  parameter p-obj-code         like ub.wth-obj.obj-code  no-undo .
    12506     define input  parameter p-wth-code         like ub.wth-obj.wth-code  no-undo .
    12507     define input  parameter p-action           as character no-undo .
    12508     define output parameter p-return-attribute as logical no-undo .
    12509     define variable vss-description as character no-undo initial "wthobjat-01: задает/получает признаки МЦ на объекте".
    12510     define variable ind      as integer no-undo .
    12511     define variable v-action as character no-undo .
    12512     define variable l-find-wth-obj as logical no-undo initial false .
    12513     define buffer buf_wth-obj for ub.wth-obj .
    12514     define variable v-num-entries-p-action as integer no-undo .
    12515     assign
    12516       v-num-entries-p-action = num-entries(p-action)
    12517     .
    12518     do ind = 1 to v-num-entries-p-action
    12519     :
    12520       assign
    12521         v-action = entry(ind, p-action)
    12522       .
    12523       if lookup(v-action, "inv-on=request,exist-wth-obj=request") > 0
    12524       then do:
    12525         find first buf_wth-obj no-lock
    12526           where buf_wth-obj.obj-type  = p-obj-type
    12527             and buf_wth-obj.obj-code  = p-obj-code
    12528             and buf_wth-obj.wth-code  = p-wth-code
    12529           no-error .
    12530       end.
    12531       else do:
    12532         if l-find-wth-obj <> true
    12533         then do:
    12534   define variable vss-include-info92 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthobjcr in g#library
    12536     (input  p-obj-type
    12537     ,input  p-obj-code
    12538     ,input  p-wth-code
    12539     ,buffer buf_wth-obj
    12540     ) no-error .
    12541           if error-status :error
    12542           then do:
    12543             message
    12544               vss-workfile vss-revision vss-description skip
    12545               "Невозможно найти wth-obj" skip
    12546               "p-obj-type"  p-obj-type  skip
    12547               "p-obj-code"  p-obj-code  skip
    12548               "p-wth-code"  p-wth-code  skip
    12549               error-status :get-message(1) skip
    12550               return-value skip
    12551               view-as alert-box error .
    12552             undo, return error return-value .
    12553           end.
    12554           assign
    12555             l-find-wth-obj = true
    12556           .
    12557         end.
    12558       end.
    12559       case v-action :
    12560         when "exist-wth-obj=request"
    12561         then do:
    12562           assign
    12563             p-return-attribute = (available buf_wth-obj)
    12564           .
    12565         end.
    12566         when "inv-on=true" or
    12567         when "inv-on=yes"
    12568         then do:
    12569           do transaction
    12570           on error undo, return error return-value
    12571           :
    12572             find current buf_wth-obj exclusive-lock .
    12573             if buf_wth-obj.inv-on <> true
    12574             then do:
    12575               assign
    12576                 buf_wth-obj.inv-on = true
    12577               .
    12578             end.
    12579             else do:
    12580               message
    12581                 vss-workfile vss-revision vss-description skip
    12582                 "Ошибка при установке признака 'МЦ находится в инвентаризации'."
    12583                 "p-obj-type"  p-obj-type  skip
    12584                 "p-obj-code"  p-obj-code  skip
    12585                 "p-wth-code"  p-wth-code  skip
    12586                 "v-action"    v-action    skip
    12587                 "p-action"    p-action    skip
    12588                 "wth-obj.inv-on" buf_wth-obj.inv-on skip
    12589                 view-as alert-box error .
    12590               undo, return error return-value .
    12591             end.
    12592             assign
    12593               p-return-attribute = buf_wth-obj.inv-on
    12594             .
    12595           end.
    12596         end.
    12597         when "inv-on=false" or
    12598         when "inv-on=no"
    12599         then do:
    12600           do transaction
    12601           on error undo, return error return-value
    12602           :
    12603             find current buf_wth-obj exclusive-lock .
    12604             if buf_wth-obj.inv-on <> false
    12605             then do:
    12606               assign
    12607                 buf_wth-obj.inv-on = false
    12608               .
    12609             end.
    12610             else do:
    12611               message
    12612                 vss-workfile vss-revision vss-description skip
    12613                 "Ошибка при сбрасывании признака 'МЦ находится в инвентаризации'."
    12614                 "p-obj-type"  p-obj-type  skip
    12615                 "p-obj-code"  p-obj-code  skip
    12616                 "p-wth-code"  p-wth-code  skip
    12617                 "v-action"    v-action    skip
    12618                 "p-action"    p-action    skip
    12619                 "wth-obj.inv-on" buf_wth-obj.inv-on skip
    12620                 view-as alert-box error .
    12621               undo, return error return-value .
    12622             end.
    12623             assign
    12624               p-return-attribute = buf_wth-obj.inv-on
    12625             .
    12626           end.
    12627         end.
    12628         when "inv-on=request"
    12629         then do:
    12630           if available buf_wth-obj
    12631           then do:
    12632             assign
    12633               p-return-attribute = buf_wth-obj.inv-on
    12634             .
    12635           end.
    12636           else do:
    12637             assign
    12638               p-return-attribute = false
    12639             .
    12640           end.
    12641         end.
    12642         when "inv-on=request:exclusive"
    12643         then do:
    12644           do transaction
    12645           on error undo, return error return-value
    12646           :
    12647             find current buf_wth-obj exclusive-lock .
    12648             assign
    12649               p-return-attribute = buf_wth-obj.inv-on
    12650             .
    12651           end.
    12652         end.
    12653         when "inv-on=request:share"
    12654         then do:
    12655           do transaction
    12656           on error undo, return error return-value
    12657           :
    12658             find current buf_wth-obj exclusive-lock .
    12659             assign
    12660               p-return-attribute = buf_wth-obj.inv-on
    12661             .
    12662           end.
    12663         end.
    12664         otherwise do:
    12665           message
    12666             vss-workfile vss-revision vss-description skip
    12667             "Неизвестное значение параметра v-action " skip
    12668             "v-action" v-action skip
    12669             "p-action" p-action skip
    12670             view-as alert-box error .
    12671           undo, return error return-value .
    12672         end.
    12673       end.
    12674     end.
    12675   end procedure.
    12676   procedure wthdat :
    12677     define input parameter  p-wth-doc-doc-type    like ub.wth-doc.doc-type no-undo .
    12678     define input parameter  p-wth-doc-internal    like ub.wth-doc.exter_   no-undo .
    12679     define input parameter  p-wth-doc-status_     like ub.wth-doc.status_  no-undo .
    12680     define input  parameter p-action              as character no-undo .
    12681     define output parameter p-return-attribute    as character no-undo .
    12682     define variable vss-description as character no-undo initial "wthdat-01: Задает/получает различные признаки документа МЦ на объекте".
    12683     define variable ind      as integer no-undo .
    12684     define variable v-action as character no-undo .
    12685     define variable v-num-entries-p-action as integer no-undo .
    12686     do
    12687     on error undo, return error return-value
    12688     :
    12689       assign
    12690         v-num-entries-p-action = num-entries(p-action)
    12691       .
    12692       do ind = 1 to v-num-entries-p-action
    12693       :
    12694         assign
    12695           v-action = entry(ind, p-action)
    12696         .
    12697         case v-action :
    12698           when "can-change-status-inv-on=request"
    12699           then do:
    12700             if  p-wth-doc-doc-type = 'инв':U
    12701             then do:
    12702               assign
    12703                 p-return-attribute = "true":u
    12704               .
    12705               next .
    12706             end.
    12707             if  p-wth-doc-doc-type = 'при':U
    12708             and p-wth-doc-internal = false
    12709             and p-wth-doc-status_  = 'накл':U
    12710             then do:
    12711               assign
    12712                 p-return-attribute = "true":u
    12713               .
    12714               next .
    12715             end.
    12716             assign
    12717               p-return-attribute = "false":u
    12718             .
    12719           end.
    12720           when "can-edit-inv-on=request":u
    12721           then do:
    12722             if  p-wth-doc-doc-type = 'инв':U
    12723             and p-wth-doc-status_  = 'разрешен':U
    12724            then do:
    12725               assign
    12726                 p-return-attribute = "true":u
    12727               .
    12728               next .
    12729             end.
    12730             if  p-wth-doc-doc-type = 'при':U
    12731             and p-wth-doc-internal = false
    12732             and p-wth-doc-status_  = 'накл':U
    12733             then do:
    12734               assign
    12735                 p-return-attribute = "true":u
    12736               .
    12737               next .
    12738             end.
    12739             assign
    12740               p-return-attribute = "false":u
    12741             .
    12742           end.
    12743           otherwise do:
    12744             message
    12745               vss-workfile vss-revision vss-description skip
    12746               "Неизвестное значение параметра v-action " skip
    12747               "v-action" v-action skip
    12748               "p-action" p-action skip
    12749               view-as alert-box error .
    12750             undo, return error return-value .
    12751           end.
    12752         end.
    12753       end.
    12754     end.
    12755   end procedure.
    12756   procedure emptyscl :
    12757     define output parameter p-node-code as integer   no-undo .
    12758     define variable vss-description as character no-undo initial "emptyscl-01: Определение корневого признака пустой шкалы".
    12759     define buffer buf_gds-prt for ub.gds-prt .
    12760     do
    12761     on error undo, return error return-value
    12762     :
    12763       find first buf_gds-prt no-lock
    12764         where buf_gds-prt.root = true
    12765           and buf_gds-prt.node-name = '_Пустая шкала':U
    12766         no-error .
    12767       if available buf_gds-prt
    12768       then do:
    12769         assign
    12770           p-node-code = buf_gds-prt.node-code
    12771         .
    12772       end.
    12773       else do:
    12774         undo, return error substitute("&1 не найдена", '_Пустая шкала':U ) .
    12775       end.
    12776     end.
    12777   end procedure.
    12778   procedure objdbnum :
    12779     define input  parameter p-obj-type as character no-undo .
    12780     define input  parameter p-obj-code as integer   no-undo .
    12781     define output parameter p-db-num   as integer   no-undo .
    12782     define variable vss-description as character no-undo initial "objdbnum-01: Определить базу данных, которой принадлежит объект".
    12783     define buffer buf_clients for ub.clients .
    12784     do
    12785     on error undo, return error return-value
    12786     :
    12787       find first buf_clients no-lock
    12788         where buf_clients.obj-type = p-obj-type
    12789           and buf_clients.obj-code = p-obj-code
    12790         no-error .
    12791       if not available buf_clients
    12792       then do:
    12793         undo, return error substitute( "Ошибка задания входных параметров. Не найден объект &1 &2", p-obj-type, p-obj-code) .
    12794       end.
    12795       assign
    12796         p-db-num = buf_clients.db-num
    12797       .
    12798     end.
    12799   end procedure.
    12800   procedure grpgdsnm :
    12801     define input  parameter p-node-code     as integer   no-undo .
    12802     define output parameter p-full-grp-name as character no-undo .
    12803     define variable vss-description as character no-undo initial "grpgdsnm-01: Полное имя группы для сортировки и поиска".
    12804     define variable v-upper-code as integer   no-undo .
    12805     define variable v-grp-name   as character no-undo .
    12806     define buffer buf_gds-grp for ub.gds-grp .
    12807     do
    12808     on error undo, return error return-value
    12809     :
    12810       find buf_gds-grp no-lock
    12811         where buf_gds-grp.node-code = p-node-code
    12812         no-error .
    12813       if not available buf_gds-grp
    12814       then do:
    12815         undo, return error substitute("Ошибка задания входных параметров" + chr(10)
    12816                                      + "Не найдена группа &1", p-node-code
    12817                                      ) .
    12818       end.
    12819       assign
    12820         v-grp-name = ''
    12821       .
    12822       do while buf_gds-grp.upper-code <> 0
    12823       on error undo, return error return-value
    12824       :
    12825         assign
    12826           v-grp-name   = buf_gds-grp.node-name + chr(47) + v-grp-name
    12827           v-upper-code = buf_gds-grp.upper-code
    12828         .
    12829         find buf_gds-grp no-lock
    12830           where buf_gds-grp.node-code = v-upper-code
    12831           no-error .
    12832         if not available buf_gds-grp
    12833         then do:
    12834           undo, return error substitute("Не найдена родительская группа для группы &1", v-upper-code
    12835                                        ) .
    12836         end.
    12837       end.
    12838       assign
    12839         p-full-grp-name = v-grp-name
    12840       .
    12841     end.
    12842   end procedure.
    12843   procedure file-clr :
    12844     define input  parameter p-file-name as character no-undo .
    12845     define variable vss-description as character no-undo initial "file-clr-01: Создать новый файл нулевой длины".
    12846     do
    12847     on error undo, return error return-value
    12848     :
    12849       if p-file-name = ""
    12850       or p-file-name = ?
    12851       then do:
    12852         message
    12853           vss-workfile vss-revision vss-description skip
    12854           "Ошибка задания входных параметров" skip
    12855           "Не задано имя файла" skip
    12856           "p-file-name" p-file-name skip
    12857           view-as alert-box error .
    12858         undo, return error return-value .
    12859       end.
    12860       output stream librout to value(p-file-name) .
    12861       output stream librout close .
    12862     end.
    12863   end procedure.
    12864   procedure file-wr :
    12865     define input  parameter p-file-name as character no-undo .
    12866     define input  parameter p-line      as character no-undo .
    12867     define variable vss-description as character no-undo initial "file-wr-01: Записать строку в файл".
    12868     do
    12869     on error undo, return error return-value
    12870     :
    12871       if p-file-name = ""
    12872       or p-file-name = ?
    12873       then do:
    12874         message
    12875           vss-workfile vss-revision vss-description skip
    12876           "Ошибка задания входных параметров" skip
    12877           "Не задано имя файла" skip
    12878           "p-file-name" p-file-name skip
    12879           "p-line" p-line skip
    12880           view-as alert-box error .
    12881         undo, return error return-value .
    12882       end.
    12883       if p-line = ?
    12884       then do:
    12885         message
    12886           vss-workfile vss-revision vss-description skip
    12887           "Ошибка задания входных параметров" skip
    12888           "Не задана строка для вывода в файл" skip
    12889           "p-file-name" p-file-name skip
    12890           "p-line" p-line skip
    12891           view-as alert-box error .
    12892         undo, return error return-value .
    12893       end.
    12894       output stream librout to value(p-file-name) append.
    12895       put stream librout unformatted p-line .
    12896       output stream librout close .
    12897     end.
    12898   end procedure.
    12899   procedure filenmln :
    12900     define input  parameter p-file-name  as character no-undo .
    12901     define input  parameter p-line-count as integer   no-undo .
    12902     define output parameter p-line-exist as logical   no-undo .
    12903     define variable vss-description as character no-undo initial "filenmln-01: Определить наличие определенного количества строк в файле".
    12904     define variable v-str-read as character no-undo .
    12905     define variable v-str-ind  as integer   no-undo init 0 .
    12906     if p-line-count = ?
    12907     then do:
    12908       message
    12909         vss-workfile vss-revision vss-description skip
    12910         "Ошибка задания входных параметров" skip
    12911         "p-line-count" p-line-count skip
    12912         view-as alert-box error .
    12913       undo, return error return-value .
    12914     end.
    12915     do
    12916     on error undo, return error return-value
    12917     :
    12918       assign
    12919         p-line-exist = false
    12920       .
    12921       input stream librout from value(p-file-name) .
    12922       repeat
    12923       :
    12924         import stream librout unformatted v-str-read no-error .
    12925         assign
    12926           v-str-ind = v-str-ind + 1
    12927         .
    12928         if v-str-ind >= p-line-count
    12929         then do:
    12930           assign
    12931             p-line-exist = true
    12932           .
    12933           leave.
    12934         end.
    12935       end.
    12936       input stream librout close .
    12937     end.
    12938   end procedure.
    12939   procedure rsrvtype :
    12940     define input  parameter p-doc-code  as character no-undo .
    12941     define output parameter p-rsrv-type as character no-undo .
    12942     define variable vss-description as character no-undo initial "rsrvtype-01: Способ резервирования документа в зависимости от типа и статуса".
    12943     define buffer buf_trn-doc for ub.trn-doc .
    12944     do
    12945     on error undo, return error return-value
    12946     :
    12947       find first buf_trn-doc no-lock
    12948         where buf_trn-doc.doc-code = p-doc-code
    12949         no-error .
    12950       if error-status :error
    12951       then do:
    12952         message
    12953           vss-workfile vss-revision vss-description skip
    12954           "Ошибка задания входных параметров" skip
    12955           "Документ" p-doc-code skip
    12956           view-as alert-box error .
    12957         undo, return error return-value .
    12958       end.
    12959       case buf_trn-doc.doc-type:
    12960         when 'при':U
    12961         then do:
    12962           if buf_trn-doc.internal = false
    12963           then do:
    12964             if  buf_trn-doc.status_  = 'накл':U
    12965             and buf_trn-doc.flag_    = false
    12966             then do:
    12967               assign
    12968                 p-rsrv-type = 'rsrv-pri-doc':U
    12969               .
    12970               return .
    12971             end.
    12972             if  buf_trn-doc.status_  = 'накл':U
    12973             and buf_trn-doc.flag_    = true
    12974             then do:
    12975               assign
    12976                 p-rsrv-type = 'rsrv-pri-fact':U
    12977               .
    12978               return .
    12979             end.
    12980           end.
    12981           if  buf_trn-doc.internal = true
    12982           then do:
    12983             if  buf_trn-doc.status_  = 'накл':U
    12984             and buf_trn-doc.flag_    = false
    12985             then do:
    12986               assign
    12987                 p-rsrv-type = 'rsrv-pri-doc':U
    12988               .
    12989               return .
    12990             end.
    12991             if  buf_trn-doc.status_  = 'накл':U
    12992             and buf_trn-doc.flag_    = true
    12993             then do:
    12994               assign
    12995                 p-rsrv-type = 'rsrv-fact':U
    12996               .
    12997               return .
    12998             end.
    12999           end.
    13000         end.
    13001         when 'рас':U   or
    13002         when 'спи':U or
    13003         when 'возврат':U
    13004         then do:
    13005           if (buf_trn-doc.status_ = 'накл':U and buf_trn-doc.flag_ = no )
    13006           or (buf_trn-doc.status_ = 'касс':U )
    13007           then do:
    13008             assign
    13009               p-rsrv-type = 'rsrv-doc':U
    13010             .
    13011             return .
    13012           end.
    13013           else do:
    13014             if buf_trn-doc.status_ = 'разрешен':U
    13015             or (buf_trn-doc.status_ = 'накл':U and buf_trn-doc.flag_ = yes and buf_trn-doc.ext-doc-type = 'eo':U)
    13016             then do:
    13017               assign
    13018                 p-rsrv-type = 'rsrv-fact':U
    13019               .
    13020               return .
    13021             end.
    13022           end.
    13023         end.
    13024         when 'инв':U
    13025         then do:
    13026           assign
    13027             p-rsrv-type = 'rsrv-doc':U
    13028           .
    13029           return .
    13030         end.
    13031       end case.
    13032       undo, return error substitute("Неизвестный тип документа. Тип документа &1. Статус &2", buf_trn-doc.doc-type, buf_trn-doc.status_) .
    13033     end.
    13034   end procedure.
    13035   procedure curdbnum :
    13036     define output parameter p-db-num as integer   no-undo .
    13037     define variable vss-description as character no-undo initial "curdbnum-01: Возвращает номер текущей базы данных".
    13038     define buffer buf_sys-ctrl for ub.sys-ctrl .
    13039     do
    13040     on error undo, return error return-value
    13041     :
    13042       find first buf_sys-ctrl no-lock no-error .
    13043       if not available buf_sys-ctrl
    13044       then do:
    13045         message
    13046           vss-workfile vss-revision vss-description skip
    13047           "Не найдена запись sys-ctrl" skip
    13048           view-as alert-box error .
    13049         undo, return error return-value .
    13050       end.
    13051       assign
    13052         p-db-num = buf_sys-ctrl.db-num
    13053       .
    13054     end.
    13055   end procedure.
    13056   procedure usrfulnm :
    13057     define input  parameter p-user-id   as character no-undo .
    13058     define output parameter p-user-name as character no-undo .
    13059     define variable vss-description as character no-undo initial "usrfulnm-01: Псевдоним пользователя".
    13060     define buffer buf_user-account        for ub.user-account .
    13061     define buffer buf_parent_user-account for ub.user-account .
    13062     do
    13063     on error undo, return error return-value
    13064     :
    13065       find first buf_user-account no-lock
    13066         where buf_user-account.user-id = p-user-id
    13067         no-error .
    13068       if not available buf_user-account
    13069       then do:
    13070         assign
    13071           p-user-name = p-user-id
    13072         .
    13073       end.
    13074       else do:
    13075         if buf_user-account.check-parent = true
    13076         then do:
    13077           find first buf_parent_user-account no-lock
    13078             where buf_parent_user-account.user-id = buf_user-account.parent-user-id
    13079             no-error .
    13080           if not available buf_parent_user-account
    13081           then do:
    13082             assign
    13083               p-user-name = p-user-id
    13084             .
    13085           end.
    13086           else do:
    13087             assign
    13088               p-user-name = buf_user-account.nik
    13089             .
    13090           end.
    13091         end.
    13092         else do:
    13093           assign
    13094             p-user-name = buf_user-account.nik
    13095           .
    13096         end.
    13097       end.
    13098     end.
    13099   end procedure.
    13100   procedure usrfuln2 :
    13101     define input  parameter p-user-id   as character no-undo .
    13102     define input  parameter p-db-num    as integer   no-undo .
    13103     define output parameter p-user-name as character no-undo .
    13104     define variable vss-description as character no-undo initial "usrfulnm-01: Имя пользователя".
    13105     define buffer buf_user-account        for ub.user-account .
    13106     define buffer buf_parent_user-account for ub.user-account .
    13107     define buffer buf_user-account-attr   for ub.user-account-attr .
    13108     do
    13109     on error undo, return error return-value
    13110     :
    13111       find first buf_user-account no-lock
    13112         where buf_user-account.user-id = p-user-id
    13113         no-error .
    13114       if not available buf_user-account
    13115       then do:
    13116         find first buf_user-account
    13117              where buf_user-account.user-id begins SUBSTITUTE("&1-", p-db-num)
    13118                and buf_user-account.parent-user-id   = p-user-id
    13119                and buf_user-account.check-parent     = FALSE
    13120              no-lock
    13121              no-error
    13122              .
    13123               if available buf_user-account
    13124               then do:
    13125                  assign
    13126                     p-user-name = substitute('&1 &2 &3':U
    13127                                             ,buf_user-account.last-name
    13128                                             ,buf_user-account.first-name
    13129                                             ,buf_user-account.second-name
    13130                                             )
    13131                  .
    13132               end.
    13133               else do:
    13134                  assign
    13135                     p-user-name = p-user-id
    13136                  .
    13137               end.
    13138       end.
    13139       else do:
    13140         if buf_user-account.check-parent = true
    13141         then do:
    13142           find first buf_parent_user-account no-lock
    13143             where buf_parent_user-account.user-id = buf_user-account.parent-user-id
    13144             no-error .
    13145           if not available buf_parent_user-account
    13146           then do:
    13147             assign
    13148               p-user-name = p-user-id
    13149             .
    13150           end.
    13151           else do:
    13152             assign
    13153               p-user-name = substitute('&1 &2 &3':U
    13154                                       ,buf_parent_user-account.last-name
    13155                                       ,buf_parent_user-account.first-name
    13156                                       ,buf_parent_user-account.second-name
    13157                                       )
    13158             .
    13159           end.
    13160         end.
    13161         else do:
    13162           assign
    13163             p-user-name = substitute('&1 &2 &3':U
    13164                                     ,buf_user-account.last-name
    13165                                     ,buf_user-account.first-name
    13166                                     ,buf_user-account.second-name
    13167                                     )
    13168           .
    13169         end.
    13170       end.
    13171     end.
    13172   end procedure.
    13173   procedure curdburt :
    13174     define output parameter p-db-num       as integer   no-undo .
    13175     define output parameter p-user-name    as character no-undo .
    13176     define output parameter p-sys-date     as date      no-undo .
    13177     define output parameter p-sys-time     as character no-undo .
    13178     define output parameter p-sys-time-int as integer   no-undo .
    13179     define variable vss-description as character no-undo initial "curdburt-01: Возвращает текущий номер базы данных, пользователя, дату, время и количество секунд".
    13180     do
    13181     on error undo, return error return-value
    13182     :
    13183   define variable vss-include-info93 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13184   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
    13185     (output p-db-num
    13186     ,output p-user-name
    13187     ) no-error .
    13188       if error-status :error
    13189       then do:
    13190         message
    13191           vss-workfile vss-revision vss-description skip
    13192           "Ошибка при определении текущего номера базы данных и пользователя" skip
    13193           error-status :get-message(1) skip
    13194           return-value skip
    13195           view-as alert-box error .
    13196         undo, return error return-value .
    13197       end.
    13198       run cur-time in this-procedure
    13199         (output p-sys-date
    13200         ,output p-sys-time-int
    13201         ) no-error .
    13202       if error-status :error
    13203       then do:
    13204         message
    13205           vss-workfile vss-revision vss-description skip
    13206           "Ошибка при определении текущего номера базы данных" skip
    13207           error-status :get-message(1) skip
    13208           return-value skip
    13209           view-as alert-box error .
    13210         undo, return error return-value .
    13211       end.
    13212       assign
    13213         p-sys-time = string(p-sys-time-int, 'HH:MM:SS':u)
    13214       .
    13215     end.
    13216   end procedure.
    13217   procedure proridoc :
    13218     define input  parameter p-in-code        as character no-undo .
    13219     define input  parameter p-gds-code       as integer   no-undo .
    13220     define input  parameter p-part-code      as character no-undo .
    13221     define output parameter p-orig-in-code   as character no-undo .
    13222     define output parameter p-orig-gds-code  as integer   no-undo .
    13223     define output parameter p-orig-part-code as character no-undo .
    13224     define variable vss-description as character no-undo initial "proridoc-01: Возвращает первичный приход партии".
    13225     define buffer buf_parts-root for ub.parts-root .
    13226     do
    13227     on error undo, return error return-value
    13228     :
    13229       define variable v-in-code   as character no-undo .
    13230       define variable v-gds-code  as integer   no-undo .
    13231       define variable v-part-code as character no-undo .
    13232       assign
    13233         v-in-code   = p-in-code
    13234         v-gds-code  = p-gds-code
    13235         v-part-code = p-part-code
    13236       .
    13237       find first buf_parts-root no-lock
    13238         where buf_parts-root.in-code   = v-in-code
    13239           and buf_parts-root.gds-code  = v-gds-code
    13240           and buf_parts-root.part-code = v-part-code
    13241         no-error .
    13242       do while available buf_parts-root
    13243       :
    13244         assign
    13245           v-in-code   = buf_parts-root.orig-in-code
    13246           v-gds-code  = buf_parts-root.orig-gds-code
    13247           v-part-code = buf_parts-root.orig-part-code
    13248         .
    13249         find first buf_parts-root no-lock
    13250           where buf_parts-root.in-code   = v-in-code
    13251             and buf_parts-root.gds-code  = v-gds-code
    13252             and buf_parts-root.part-code = v-part-code
    13253           no-error .
    13254       end.
    13255       assign
    13256         p-orig-in-code   = v-in-code
    13257         p-orig-gds-code  = v-gds-code
    13258         p-orig-part-code = v-part-code
    13259       .
    13260     end.
    13261   end procedure.
    13262   procedure pargocod :
    13263     define input  parameter p-parts-recid as recid     no-undo .
    13264     define output parameter p-gds-code    as integer   no-undo .
    13265     define variable vss-description as character no-undo initial "pargocod-01: Возвращает код товара для партии".
    13266     define buffer buf_parts for ub.parts .
    13267     define buffer buf_goods for ub.goods .
    13268     do
    13269     on error undo, return error return-value
    13270     :
    13271       find first buf_parts no-lock
    13272         where recid(buf_parts) = p-parts-recid
    13273         no-error .
    13274       if not available buf_parts
    13275       then do:
    13276         undo, return error substitute("Ошибка задания входных параметров. Не найдена партия с кодом &1", p-parts-recid).
    13277       end.
    13278       find first buf_goods no-lock
    13279         where buf_goods.artic     = buf_parts.artic
    13280           and buf_goods.prod-type = buf_parts.prod-type
    13281           and buf_goods.prod-code = buf_parts.prod-code
    13282         no-error .
    13283       if not available buf_goods
    13284       then do:
    13285         undo, return error substitute("Не найден товар. Указатель партии &1. Артикул &2 &3 &4.", p-parts-recid, buf_parts.artic, buf_parts.prod-type, buf_parts.prod-code) .
    13286       end.
    13287       assign
    13288         p-gds-code = buf_goods.gds-code
    13289       .
    13290     end.
    13291   end procedure.
    13292   procedure doclicod :
    13293     define input  parameter p-doc-line-recid as recid     no-undo .
    13294     define output parameter p-gds-code       as integer   no-undo .
    13295     define variable vss-description as character no-undo initial "doclicod-01: Возвращает код товара для строки документа".
    13296     define buffer buf_doc-line for ub.doc-line .
    13297     define buffer buf_goods for ub.goods .
    13298     do
    13299     on error undo, return error return-value
    13300     :
    13301       find first buf_doc-line no-lock
    13302         where recid(buf_doc-line) = p-doc-line-recid
    13303         no-error .
    13304       if not available buf_doc-line
    13305       then do:
    13306         undo, return error substitute("Ошибка задания входных параметров. Не найдена строка документа с указателем &1", p-doc-line-recid) .
    13307       end.
    13308       find first buf_goods no-lock
    13309         where buf_goods.artic     = buf_doc-line.artic
    13310           and buf_goods.prod-type = buf_doc-line.prod-type
    13311           and buf_goods.prod-code = buf_doc-line.prod-code
    13312         no-error .
    13313       if not available buf_goods
    13314       then do:
    13315         undo, return error substitute("Не найден товар. Указатель строки &1. Артикул &2 &3 &4",p-doc-line-recid,buf_doc-line.artic,buf_doc-line.prod-type,buf_doc-line.prod-code).
    13316       end.
    13317       assign
    13318         p-gds-code = buf_goods.gds-code
    13319       .
    13320     end.
    13321   end procedure.
