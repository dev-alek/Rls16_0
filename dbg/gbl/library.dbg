    15921     END CASE.
    15922     find first buf_thbj-attr no-lock where
    15923               buf_thbj-attr.upper-prop-code = 'rum':U
    15924          and  buf_thbj-attr.prop-code = v-prop-code no-error.
    15925     if not available buf_thbj-attr
    15926     or buf_thbj-attr.property-value-logical = no
    15927     then return ''.
    15928     run gen-key-rec in this-procedure ( input 'thbj-attr':U
    15929                                        ,input (buffer buf_thbj-attr:handle)
    15930                                        ,output v-uniq-key-rec).
    15931     _codex:
    15932     do v-jj = 1 to num-entries(v-codex-id-list):
    15933       if entry(v-jj, v-codex-id-list) = '':U then next _codex.
    15934       v-codex-id = integer(entry(v-jj, v-codex-id-list)).
    15935       do v-ii = 1 to num-entries(v-ruleset-id-list[v-jj]):
    15936           if entry(v-ii, v-ruleset-id-list[v-jj]) = '':U then next.
    15937           v-ruleset-id = integer(entry(v-ii, v-ruleset-id-list[v-jj])).
    15938         _rule-by-call:
    15939         for each buf_rule-by-call no-lock where
    15940                   buf_rule-by-call.call_id = v-uniq-key-rec
    15941             and buf_rule-by-call.can-calc = yes
    15942             and buf_rule-by-call.codex_id = v-codex-id
    15943             and buf_rule-by-call.ruleset_id = v-ruleset-id
    15944         by buf_rule-by-call.call_Id
    15945         by buf_rule-by-call.codex_id
    15946         by buf_rule-by-call.ruleset_id
    15947         by buf_rule-by-call.order_id
    15948         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
    15949         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
    15950         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ) :
    15951           v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
    15952           run value(v-proc-name)  (
    15953                                                                 input parparentproc
    15954                                                               ,input p-parent-handle
    15955                                                               ,input p-log-handle
    15956                                                               ,input v-cont-handle
    15957                                                               ,input v-codex-id
    15958                                                               ,input v-ruleset-id
    15959                                                               ,input buf_rule-by-call.call_id
    15960                                                               ,input buf_rule-by-call.order_id
    15961                                                               ,input buf_rule-by-call.rule_id
    15962                                                               ,input buf_rule-by-call.profile
    15963                                                               ,input buf_rule-by-call.is_dynamic
    15964                                                               ,input v-doc-type
    15965                                                               ,input 0
    15966                                                               ,input ''
    15967                                                               ,input 0
    15968                                                               ,input v-doc-code
    15969                                                               ,input v-process-file-name
    15970                                                               ,input 0
    15971                                                               ,input v-curr-r-b
    15972                                                               ,input ?
    15973                                                               ,input 0
    15974                                                               ) .
    15975         end.
    15976       end.
    15977     end.
    15978   end.
    15979   end procedure.
