     4791                 "p-obj-type"  p-obj-type  skip
     4792                 "p-obj-code"  p-obj-code  skip
     4793                 "p-artic"     p-artic     skip
     4794                 "p-prod-type" p-prod-type skip
     4795                 "p-prod-code" p-prod-code skip
     4796                 "v-action"    v-action    skip
     4797                 "p-action"    p-action    skip
     4798                 "gds-obj.ov-on" buf_gds-obj.ov-on skip
     4799                 view-as alert-box error .
     4800               undo, return error return-value .
     4801             end.
     4802             assign
     4803               p-return-attribute = buf_gds-obj.ov-on
     4804             .
     4805           end.
     4806         end.
     4807         when "ov-on=false" or
     4808         when "ov-on=no"
     4809         then do:
