     6009               end.
     6010             end.
     6011           end.
     6012           find first buf_config no-lock
     6013             where buf_config.param-code = p-code
     6014               and buf_config.host-code  = h-code
     6015               and buf_config.obj-type   = o-type
     6016               and buf_config.obj-code   = o-code
     6017               and buf_config.db-num     = p-db-num
     6018               and buf_config.beg-date   <= v-today
     6019               and buf_config.end-date   >= v-today
     6020           no-error .
     6021           if not available buf_config then
     6022           find first buf_config no-lock
     6023             where buf_config.param-code = p-code
     6024               and buf_config.host-code  = h-code
     6025               and buf_config.obj-type   = o-type
     6026               and buf_config.obj-code   = o-code
     6027               and buf_config.db-num     = p-db-num
     6028           no-error .
     6029           if not available buf_config
     6030           then do:
     6031             if h-code <> 0
     6032             or o-type <> ""
     6033             or o-code <> 0
     6034             then do:
     6035               if l-object-specified
     6036               then do:
     6037                 find first buf_config no-lock
     6038                   where buf_config.param-code = p-code
     6039                     and buf_config.host-code  = h-code
     6040                     and buf_config.obj-type   = ""
     6041                     and buf_config.obj-code   = 0
     6042                     and buf_config.db-num     = p-db-num
     6043                   no-error .
     6044               end.
     6045               if not available buf_config
     6046               then do:
     6047                 find first buf_config no-lock
     6048                   where buf_config.param-code = p-code
     6049                     and buf_config.host-code  = 0
     6050                     and buf_config.obj-type   = ""
     6051                     and buf_config.obj-code   = 0
     6052                     and buf_config.db-num     = p-db-num
     6053                   no-error .
     6054               end.
     6055             end.
