     3177   procedure gds-objh_write-gds-obj-proc  :
     3178   define parameter buffer buf_gds-obj for ub.gds-obj .
     3179   define input parameter p-action as integer no-undo .
     3180   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
     3181   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
     3182   define variable v-date as date      no-undo.
     3183   define variable v-time  as integer   no-undo.
     3184   define variable v-current-db-num as integer no-undo .
     3185   define variable v-news as logical no-undo .
     3186   define variable v-esys as logical no-undo .
     3187   define variable v-userid as character no-undo .
     3188   define variable v-h as handle no-undo .
     3189   define buffer buf_c-gds-hist for ub.c-gds-hist.
     3190   define buffer buf_c-gds-obj-ref for ub.c-gds-obj-ref.
     3191     do
     3192     on error undo, return error
     3193     :
     3194       if not available buf_gds-obj then do:
     3195         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
     3196                       "Ошибка задания входных параметров:Не определен товар на объекте" ).
     3197       end.
     3198   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3199   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run calltree in g#library
     3200     (input  'mainhandle_parentproc_indicator'
     3201     ,input  this-procedure:handle
     3202     ,input  ?
     3203     ,output v-h
     3204     )  .
     3205       run get-news in v-h ( output v-news) no-error.
     3206       if v-news or not valid-handle(v-h) then return ''.
     3207       run get-db-num in v-h ( output v-current-db-num).
     3208       run get-userid in v-h ( output v-userid).
     3209       run get-esys in v-h ( output v-esys).
     3210       run cur-time in this-procedure(output v-date, output v-time).
     3211       create buf_c-gds-obj-ref.
     3212       buffer-copy buf_gds-obj to buf_c-gds-obj-ref
     3213       assign
     3214       buf_c-gds-obj-ref.gds-code           = buf_gds-obj.gds-code
     3215       buf_c-gds-obj-ref.obj-type           = buf_gds-obj.obj-type
     3216       buf_c-gds-obj-ref.obj-code           = buf_gds-obj.obj-code
     3217       buf_c-gds-obj-ref.chip-num           = next-value (s-gds-chip, ub)
     3218       buf_c-gds-obj-ref.corr-time          = v-time
     3219       buf_c-gds-obj-ref.corr-user-db-num   = v-current-db-num
     3220       buf_c-gds-obj-ref.corr-user-name     = (if v-news then (chr(4) +  'СПН':U)
     3221                                         else (if v-esys
     3222                                               then (chr(4) +  'ВС':U)
     3223                                               else v-userid)
     3224                                               )
     3225       buf_c-gds-obj-ref.corr-date          = v-date
     3226       .
     3227       create buf_c-gds-hist.
     3228       buffer-copy buf_c-gds-obj-ref to buf_c-gds-hist
     3229       assign
     3230       buf_c-gds-hist.action =  p-action
     3231       buf_c-gds-hist.subject = 'gds-obj':U
     3232       buf_c-gds-hist.is-news = v-news
     3233       buf_c-gds-hist.source-type = p-source-type
     3234       buf_c-gds-hist.source-ref = p-source-ref
     3235       .
     3236       run nws/cr-route.p ( input 'send-tbl':U
     3237                          , input 'c-gds-obj-ref':U
     3238                          , input buffer buf_c-gds-obj-ref:handle
     3239                          , input '' ) .
     3240       run nws/cr-route.p ( input 'send-tbl':U
     3241                          , input 'c-gds-hist':U
     3242                          , input buffer buf_c-gds-hist:handle
     3243                          , input '' ) .
     3244     end.
     3245   end procedure.
