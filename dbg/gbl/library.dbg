    11219                   buf_tax-rate-value.fact-order <= v-fact-order AND
    11220                   buf_tax-rate-value.status_ = 'тек':U
    11221                   NO-ERROR.
    11222       if avail buf_tax-rate-value
    11223       then do:
    11224         assign
    11225         par-x-host-code = buf_tax-rate-value.host-code
    11226         par-x-obj-type = buf_tax-rate-value.obj-type
    11227         par-x-obj-code = buf_tax-rate-value.obj-code
    11228         .
    11229         return.
    11230       end.
    11231       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11232                   buf_tax-rate-value.tax-code  = partax-code  AND
    11233                   buf_tax-rate-value.rate-code = parrate-code AND
    11234                   buf_tax-rate-value.host-code = parhost-code AND
    11235                   buf_tax-rate-value.obj-type = "" AND
    11236                   buf_tax-rate-value.obj-code = 0 AND
    11237                   buf_tax-rate-value.fact-order <= v-fact-order AND
    11238                   buf_tax-rate-value.status_ = 'тек':U
    11239                   NO-ERROR.
    11240       if avail buf_tax-rate-value
    11241       then do:
    11242         assign
    11243         par-x-host-code = buf_tax-rate-value.host-code
    11244         par-x-obj-type = buf_tax-rate-value.obj-type
    11245         par-x-obj-code = buf_tax-rate-value.obj-code
    11246         .
    11247         return.
    11248       end.
    11249       FIND LAST buf_tax-rate-value NO-LOCK WHERE
    11250                   buf_tax-rate-value.tax-code  = partax-code  AND
    11251                   buf_tax-rate-value.rate-code = parrate-code AND
    11252                   buf_tax-rate-value.host-code = 0 AND
    11253                   buf_tax-rate-value.obj-type = "" AND
    11254                   buf_tax-rate-value.obj-code = 0 AND
