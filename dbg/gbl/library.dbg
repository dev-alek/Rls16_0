     5876                   .
     5877                 end.
     5878                 else do:
     5879                   assign
     5880                     p-value = string( integer( p-value ) + integer( buf-all_config.param-value ) )
     5881                   .
     5882                 end.
     5883               end.
     5884               if p-value = ?
     5885                 or trim( p-value ) = "":U
     5886               then do:
