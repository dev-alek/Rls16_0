     2930   :
     2931       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     2932       (input  p-upper-code
     2933       ,input  p-code
     2934       ,output p-label
     2935       ,output p-user-can-edit
     2936       ,output p-output-display
     2937       ,output p-other
     2938       ,output p-prop-list
     2939       ,output p-prop-type-list
     2940       ,output p-prop-label-list
     2941       ,output p-global
     2942       ,output p-host
     2943       ,output p-shop
     2944       ,output p-store
     2945       ,output p-db
     2946       ,output p-region
     2947       ) no-error .
     2948     if error-status :error
