    11788                                    , output v-value-decimal
    11789                                    , output v-value-integer
    11790                                    , output v-value-logical
    11791                                    , output v-param-type
    11792                                    , input-output table-handle v-tth
    11793                                    ) no-error .
    11794                 if error-status :error then do:
    11795                   assign vardiffshft = 3.
    11796                 end.
    11797                 else do:
    11798                   assign
    11799                     vardiffshft = v-value-integer no-error.
    11800                   if error-status :error
    11801                   or vardiffshft < 0
    11802                   then do:
    11803                     message "Неверно задан параметр diffshft: " diffshftvalue skip
    11804                             "Параметр может принимать целые значения > 0." skip
    11805                     view-as alert-box error.
    11806                     undo, return error substitute( "Неверно задан параметр diffshft: &1.&2" +
    11807                                                    "Параметр может принимать целые значения > 0.",
    11808                                                    diffshftvalue,
    11809                                                    chr(10) ) .
    11810                   end.
    11811                 end.
    11812                 delete object v-tth no-error.
