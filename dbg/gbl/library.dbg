     5373               "Объект" p-obj-type p-obj-code skip
     5374               "Артикул" p-artic p-prod-type p-prod-code skip
     5375               "Запрашиваемый атрибут" "cash-parts=request":u skip
     5376               error-status :get-message(1) skip
     5377               return-value skip
     5378               view-as alert-box error .
     5379             undo, return error return-value .
     5380           end.
     5381           if l-goods-serial
     5382           or l-cash-parts
     5383           then do:
     5384             assign
