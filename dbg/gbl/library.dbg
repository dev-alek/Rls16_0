     5488   procedure gdsoattr-increase-pc :
     5489   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     5490   define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
     5491   define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
     5492   define output parameter p-increase-pc like ub.goods.increase-pc no-undo .
     5493   DEFINE VARIABLE v-exist as logical no-undo .
     5494   DEFINE VARIABLE v-attr-value as character no-undo .
     5495   DEFINE VARIABLE v-attr-type as character no-undo .
     5496   define variable vss-description as character no-undo initial "gdsoattr-increase-pc-01: получение значения наценки на объекте".
     5497   define buffer buf_goods for ub.goods .
     5498     do
     5499     on error undo, return error return-value
     5500     :
     5501       find first buf_goods no-lock
     5502         where buf_goods.gds-code     = p-gds-code
     5503         no-error .
     5504       if not available buf_goods
     5505       then do:
     5506         message
     5507           vss-workfile vss-revision vss-description skip
     5508           "Не найден товар" skip
     5509           "Код товара" p-gds-code skip
     5510           view-as alert-box error .
     5511         undo, return error return-value .
     5512       end.
     5513       run gdsoattr-exist in this-procedure(
     5514                                         input p-gds-code,
     5515                                         input p-obj-type,
     5516                                         input p-obj-code,
     5517                                         input 'increase-pc':U,
     5518                                         output v-exist).
     5519      if not v-exist
     5520      then do:
     5521         assign
     5522         p-increase-pc = buf_goods.increase-pc
     5523         .
     5524       end.
     5525       else do:
     5526         run gdsoattr-value ( input 'increase-pc':U,
     5527                             input p-gds-code,
     5528                             input p-obj-type,
     5529                             input p-obj-code,
     5530                             output v-attr-value,
     5531                             output v-attr-type ) no-error .
     5532         if not error-status :error
     5533         then do:
     5534           assign
     5535           p-increase-pc = decimal(v-attr-value)
     5536           no-error
     5537           .
     5538         end.
     5539         if error-status :error
     5540         then do:
     5541           message
     5542           vss-workfile vss-revision vss-description skip
     5543           "Ошибка при определении атрибута товара на объекте" skip
     5544           "Код товара" p-gds-code skip
     5545           error-status :get-message(1) skip
     5546           return-value skip
     5547           view-as alert-box error .
     5548           undo, return error return-value .
     5549         end.
     5550       end.
     5551     end.
     5552   end procedure.
     5553   procedure check-cfg-param :
     5554     define input  parameter p-conf-type     like ub.config.conf-type     no-undo .
     5555     define input  parameter p-param-code    like ub.config.param-code    no-undo .
     5556     define input  parameter p-db-num        like ub.config.db-num        no-undo .
     5557     define input  parameter p-param-value   like ub.config.param-value   no-undo .
     5558     define input  parameter p-beg-date      like ub.config.beg-date      no-undo .
     5559     define input  parameter p-end-date      like ub.config.end-date      no-undo .
     5560     define input  parameter p-param-encoded like ub.config.param-encoded no-undo .
     5561     define input  parameter p-host-code     like ub.config.host-code     no-undo .
     5562     define input  parameter p-obj-type      like ub.config.obj-type      no-undo .
     5563     define input  parameter p-obj-code      like ub.config.obj-code      no-undo .
     5564     define input  parameter p-msg-on        as logical   no-undo .
     5565     define output parameter p-attach-level  as character no-undo .
     5566     do
     5567     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5568     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     5569     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     5570     :
     5571       define variable v-ok               as logical   no-undo .
     5572       define variable v-assignment-type  as character no-undo .
     5573       define variable v-assignment-ind   as integer   no-undo .
     5574       define buffer buf_db for ub.db .
     5575       if lookup( p-conf-type, 'к,п':U ) > 0
     5576       then do:
     5577         find first buf_db no-lock
     5578           where buf_db.db-num = p-db-num
     5579           no-error .
     5580         if not available buf_db
     5581         then do:
     5582           message
     5583             vss-workfile vss-revision vss-description skip
     5584             "Не найдена запись таблицы базы данных" skip
     5585             "База данных" p-db-num skip
     5586             view-as alert-box error .
     5587           undo, return error return-value .
     5588         end.
     5589         run check-enc in this-procedure
     5590           (input  p-db-num
     5591           ,input  buf_db.db-key
     5592           ,input  p-param-code
     5593           ,input  p-param-value
     5594           ,input  p-beg-date
     5595           ,input  p-end-date
     5596           ,input  p-param-encoded
     5597           ,output v-ok
     5598           ) no-error.
     5599         if error-status :error
     5600         then do:
     5601           if p-msg-on = true
     5602           then do:
     5603             message
     5604               vss-workfile vss-revision vss-description skip
     5605               substitute ("Параметр &1. Ошибка при проверке кодирования.", p-param-code ) skip
     5606               error-status :get-message(1) skip
     5607               return-value skip
     5608               view-as alert-box error .
     5609           end.
     5610           undo, return error substitute ("Параметр &1. Ошибка при проверке кодирования. &2", p-param-code, error-status :get-message( error-status :num-messages ) ).
     5611         end.
     5612         if v-ok <> true
     5613         then do:
     5614           if p-msg-on = true
     5615           then do:
     5616             message
     5617               vss-workfile vss-revision vss-description skip
     5618               substitute("Некорректное кодированное значение параметра &1", p-param-code) skip
     5619               view-as alert-box error.
     5620           end.
     5621           undo, return error substitute("Некорректное кодированное значение параметра &1", p-param-code).
     5622         end.
     5623         if p-host-code <> 0
     5624         or p-obj-type  <> ""
     5625         or p-obj-code  <> 0
     5626         then do:
     5627           if p-msg-on = true
     5628           then do:
     5629             message
     5630               vss-workfile vss-revision vss-description skip
     5631               substitute("Кодированые параметры могут быть только без привязки! Параметр &1", p-param-code) skip
     5632               view-as alert-box error.
     5633           end.
     5634           undo, return error substitute("Кодированые параметры могут быть только без привязки! Параметр &1", p-param-code).
     5635         end.
     5636         assign
     5637           p-attach-level = 'global':U
     5638         .
     5639       end.
     5640       else do:
     5641         assign
     5642           v-assignment-type = ( if  p-host-code = 0
     5643                                 then "0":u
     5644                                 else "1":u
     5645                               )
     5646                             + ( if  p-obj-type  = ""
     5647                                 and p-obj-code  = 0
     5648                                 then "0":u
     5649                                 else "1":u
     5650                               )
     5651         .
     5652         assign
     5653           v-assignment-ind = lookup( v-assignment-type, "00,10,11":u )
     5654         .
     5655         if v-assignment-ind = 0
     5656         then do:
     5657           if p-msg-on = TRUE
     5658           then do:
     5659             message
     5660               vss-workfile vss-revision vss-description skip
     5661               "Неправильная привязка параметра конфигурации" skip
     5662               "param-code" p-param-code      skip
     5663               "host-code"  p-host-code       skip
     5664               "obj-type"   p-obj-type        skip
     5665               "obj-code"   p-obj-code        skip
     5666               "привязка"   v-assignment-type skip
     5667               view-as alert-box error .
     5668           end.
     5669           undo, return error substitute ("Неправильная привязка параметра конфигурации &1", p-param-code ).
     5670         end.
     5671         assign
     5672           p-attach-level = entry(v-assignment-ind
     5673                                 ,'global':U
     5674                                 + chr(44) + 'firm':U
     5675                                 + chr(44) + 'object':U
     5676                                 )
     5677         .
     5678       end.
     5679       if p-beg-date = ?
     5680       or p-end-date = ?
     5681       then do:
     5682         if p-msg-on = true
     5683         then do:
     5684           message
     5685             vss-workfile vss-revision vss-description skip
     5686             substitute("Ошибка задания срока действия параметра &1. Дата начала &2. Дата окончания &3"
     5687                       ,p-param-code
     5688                       ,p-beg-date
     5689                       ,p-end-date
     5690                       ) skip
     5691             view-as alert-box error.
     5692         end.
     5693         undo, return error  substitute("Ошибка задания срока действия параметра &1. Дата начала &2. Дата окончания &3"
     5694                                 ,p-param-code
     5695                                 ,p-beg-date
     5696                                 ,p-end-date
     5697                                 ) .
     5698       end.
     5699     end.
     5700   end procedure.
     5701   procedure confrddb :
     5702     define input  parameter p-code   as character no-undo .
     5703     define input  parameter p-db-num as integer   no-undo .
     5704     define input  parameter h-code   as integer   no-undo .
     5705     define input  parameter o-type   as character no-undo .
     5706     define input  parameter o-code   as integer   no-undo .
     5707     define input  parameter msg-on   as logical   no-undo .
     5708     define output parameter p-value  as character no-undo .
     5709     define output parameter p-type   as character no-undo .
     5710     define variable vss-description as character no-undo initial "confrddb: Чтение параметров конфигурации для заданной БД".
     5711     do
     5712     on error undo, return error return-value
     5713     :
     5714       define variable v-today            as date      no-undo .
     5715       define variable v-time             as integer   no-undo .
     5716       define variable l-object-specified as logical   no-undo .
     5717       define variable v-host-code        as integer   no-undo .
     5718       define variable v-level            as character no-undo .
     5719       define variable v-db-num        as integer   no-undo .
     5720       define buffer buf_config     for ub.config .
     5721       define buffer buf-all_config for ub.config .
     5722       if p-db-num < 0 then do:
     5723         message
     5724           vss-workfile vss-revision vss-description skip
     5725           substitute("Ошибка задания входных параметров. Параметр &1 БД &2", p-code, p-db-num ) skip
     5726           view-as alert-box error.
     5727         undo, return error substitute("&1.&2 Ошибка задания входных параметров. Параметр &3 БД &4", vss-description, chr(10), p-code, p-db-num ) .
     5728       end.
     5729       if p-db-num = ? then do:
     5730   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5731   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5732     (output p-db-num
     5733     ) no-error .
     5734         if error-status :error
     5735         then do:
     5736           message
     5737             vss-workfile vss-revision vss-description skip
     5738             "Ошибка при определении номера базы данных" skip
     5739             error-status :get-message(1) skip
     5740             return-value skip
     5741             view-as alert-box error .
     5742           undo, return error return-value .
     5743         end.
     5744       end.
     5745       assign
     5746         p-value            = ?
     5747         l-object-specified = false
     5748       .
     5749           run cur-time in this-procedure
     5750             ( output v-today
     5751              ,output v-time
     5752             ) no-error .
     5753       if length(p-code) > 8
     5754       then do:
     5755         message
     5756           vss-workfile vss-revision vss-description skip
     5757           "Длина имени параметра не может превышать 8 символов" skip
     5758           "p-code" p-code skip
     5759           view-as alert-box error .
     5760       end.
     5761       find first buf_config no-lock
     5762         where buf_config.param-code = p-code
     5763           and buf_config.db-num     = p-db-num
     5764         no-error .
     5765       if not available buf_config
     5766       then do:
     5767         if msg-on = TRUE
     5768         then do:
     5769           message
     5770             "Параметр" p-code "отсутствует в БД." skip
     5771             "Параметры задаются через 'АРМ Администратор/Справочники/Настройки и конфигурация системы'" skip
     5772             "или при первоначальной настройке системы" skip
     5773             view-as alert-box error.
     5774         end.
     5775         undo, return error substitute ("Параметр &1 отсутствует в БД. Параметры задаются через 'АРМ Администратор/Справочники/Настройки и конфигурация системы' или при первоначальной настройке системы", p-code ).
     5776       end.
     5777       else do:
     5778         if lookup( buf_config.conf-type, 'к,п':U ) > 0
     5779         and ( buf_config.param-type = 'L':U
     5780               or buf_config.param-type = 'I':U
     5781             )
     5782         then do:
     5783           if error-status :error
     5784           then do:
     5785             if msg-on = TRUE
     5786             then do:
     5787               message
     5788                 vss-workfile vss-revision vss-description skip
     5789                 "Ошибка при определении текущего времени" skip
     5790                 error-status :get-message(1) skip
     5791                 return-value skip
     5792                 view-as alert-box error .
     5793             end.
     5794             undo, return error "Ошибка при определении текущего времени" .
     5795           end.
     5796           if buf_config.param-type = 'I':U
     5797           then do:
     5798             assign
     5799               p-type  = buf_config.param-type
     5800             .
     5801             for each buf-all_config no-lock
     5802               where buf-all_config.param-code = p-code
     5803                 and buf-all_config.host-code  = 0
     5804                 and buf-all_config.obj-type   = ""
     5805                 and buf-all_config.obj-code   = 0
     5806                 and buf-all_config.beg-date   <= v-today
     5807                 and buf-all_config.end-date   >= v-today
     5808                 and buf-all_config.db-num     = p-db-num
     5809             on error undo, return error return-value
     5810             :
     5811               run check-cfg-param in this-procedure
     5812                 ( input buf-all_config.conf-type
     5813                  ,input buf-all_config.param-code
     5814                  ,input buf-all_config.db-num
     5815                  ,input buf-all_config.param-value
     5816                  ,input buf-all_config.beg-date
     5817                  ,input buf-all_config.end-date
     5818                  ,input buf-all_config.param-encoded
     5819                  ,input buf-all_config.host-code
     5820                  ,input buf-all_config.obj-type
     5821                  ,input buf-all_config.obj-code
     5822                  ,input msg-on
     5823                  ,output v-level
     5824                 ) no-error .
     5825               if error-status :error
     5826               then do:
     5827                 undo, return error return-value .
     5828               end.
     5829               if p-value = ?
     5830               then do:
     5831                 assign
     5832                   p-value = buf-all_config.param-value
     5833                 .
     5834               end.
     5835               else do:
     5836                 assign
     5837                   p-value = string( integer( p-value ) + integer( buf-all_config.param-value ) )
     5838                 .
     5839               end.
     5840             end.
     5841             if p-value = ?
     5842               or trim( p-value ) = "":U
     5843             then do:
     5844               for each buf-all_config no-lock
     5845                 where buf-all_config.param-code = p-code
     5846                   and buf-all_config.host-code  = 0
     5847                   and buf-all_config.obj-type   = ""
     5848                   and buf-all_config.obj-code   = 0
     5849                   and buf-all_config.beg-date   <= v-today
     5850                   and buf-all_config.end-date   >= v-today
     5851                   and buf-all_config.db-num     = p-db-num
     5852               on error undo, return error return-value
     5853               :
     5854                 run check-cfg-param in this-procedure
     5855                   ( input buf-all_config.conf-type
     5856                    ,input buf-all_config.param-code
     5857                    ,input buf-all_config.db-num
     5858                    ,input buf-all_config.param-value
     5859                    ,input buf-all_config.beg-date
     5860                    ,input buf-all_config.end-date
     5861                    ,input buf-all_config.param-encoded
     5862                    ,input buf-all_config.host-code
     5863                    ,input buf-all_config.obj-type
     5864                    ,input buf-all_config.obj-code
     5865                    ,input msg-on
     5866                    ,output v-level
     5867                   ) no-error .
