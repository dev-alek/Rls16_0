     1139   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   procedure factord :
     1141     define input  parameter p-fact-date            as date    no-undo .
     1142     define input  parameter p-fact-time            as integer no-undo .
     1143     define input  parameter p-fact-num             as integer no-undo .
     1144     define input  parameter p-shift-date           as date    no-undo .
     1145     define input  parameter p-shift-num            as integer no-undo .
     1146     define input  parameter p-shift-on             as logical no-undo .
     1147     define output parameter p-fact-order           as decimal no-undo .
     1148     define output parameter p-shift-end-fact-order as decimal no-undo .
     1149     define output parameter p-day-end-fact-order   as decimal no-undo .
     1150     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1151     if p-fact-date = ?
     1152     then do:
     1153       return error "Не указана фактическая дата" .
     1154     end.
     1155     define variable v-fact-date-num as integer no-undo .
     1156     assign
     1157       v-fact-date-num = integer(p-fact-date)
     1158     .
     1159     if p-fact-num = ?
     1160     or p-fact-num = 0
     1161     then do:
     1162       return error "Не задан p-fact-num " + string(p-fact-num) .
     1163     end.
     1164     if p-fact-num < 0
     1165     then do:
     1166       return error "Отрицательный fact-num " + string(p-fact-num) .
     1167     end.
     1168     if p-fact-num >= 100000000
     1169     then do:
     1170       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1171     end.
     1172     if p-shift-on = true
     1173     then do:
     1174       if p-shift-date = ?
     1175       then do:
     1176         return error "Не задана дата смены" .
     1177       end.
     1178       if p-shift-num = ?
     1179       or p-shift-num = 0
     1180       then do:
     1181         return error "Не задан номер смены" .
     1182       end.
     1183     end.
     1184     else do:
     1185       assign
     1186         p-shift-date = p-fact-date
     1187         p-shift-num  = 24
     1188       .
     1189     end.
     1190     define variable v-shift-offset as integer no-undo .
     1191     if p-shift-date = p-fact-date
     1192     then do:
     1193       assign
     1194         v-shift-offset = 1
     1195       .
     1196     end.
     1197     if p-shift-date < p-fact-date
     1198     then do:
     1199       assign
     1200         v-shift-offset = 0
     1201       .
     1202     end.
     1203     if p-shift-date > p-fact-date
     1204     then do:
     1205       message
     1206         vss-workfile vss-revision vss-description skip
     1207         "Неправильная дата закрытия смены" skip
     1208         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1209         view-as alert-box error .
     1210       undo, return error
     1211         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1212           ,string(p-fact-date, '99/99/9999':U)
     1213           ,string(p-shift-date, '99/99/9999':U)
     1214           )
     1215       .
     1216     end.
     1217     if p-shift-num < 1
     1218     or p-shift-num > 24
     1219     then do:
     1220       message
     1221         vss-workfile vss-revision vss-description skip
     1222         "Неправильный номер смены" skip
     1223         "p-shift-num" p-shift-num skip
     1224         view-as alert-box error .
     1225       undo, return error return-value .
     1226     end.
     1227     assign
     1228       p-fact-order           = v-fact-date-num
     1229                              + v-shift-offset * 0.5
     1230                              + p-shift-num    * 0.02 - 0.01
     1231                              + p-fact-num     * 0.0000000001
     1232       p-shift-end-fact-order = v-fact-date-num
     1233                              + v-shift-offset * 0.5
     1234                              + p-shift-num    * 0.02
     1235       p-day-end-fact-order   = v-fact-date-num
     1236                              + 0.99
     1237     .
     1238     if p-fact-order           <= v-fact-date-num
     1239     or p-shift-end-fact-order <= v-fact-date-num
     1240     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1241     or p-shift-end-fact-order >= p-day-end-fact-order
     1242     then do:
     1243       message
     1244         vss-workfile vss-revision vss-description skip
     1245         "Внутренняя ошибка при генерации фактического номера" skip
     1246         "p-fact-date"            p-fact-date            skip
     1247         "p-fact-time"            p-fact-time            skip
     1248         "p-fact-num"             p-fact-num             skip
     1249         "p-shift-date"           p-shift-date           skip
     1250         "p-shift-num"            p-shift-num            skip
     1251         "p-shift-on"             p-shift-on             skip
     1252         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1253         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1254         "v-fact-date-num"        v-fact-date-num        skip
     1255         view-as alert-box error .
     1256       undo, return error return-value .
     1257     end.
     1258   end procedure.
     1259   procedure day-begin-fact-order :
     1260     define input  parameter p-fact-date            as date    no-undo .
     1261     define output parameter p-day-begin-fact-order as decimal no-undo .
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       if p-fact-date = ?
     1266       then do:
     1267         assign
     1268           p-day-begin-fact-order = 0
     1269         .
     1270       end.
     1271       else do:
     1272         assign
     1273           p-day-begin-fact-order = integer(p-fact-date)
     1274         .
     1275       end.
     1276     end.
     1277   end procedure.
     1278   procedure factord-max-fact-order :
     1279     define output parameter p-max-fact-order as decimal   no-undo .
     1280     do
     1281     on error undo, return error return-value
     1282     :
     1283       run day-begin-fact-order in this-procedure
     1284         (input  date(1, 1, 5000)
     1285         ,output p-max-fact-order
     1286         ) .
     1287     end.
     1288   end procedure.
     1289   procedure factord-cut-archive :
     1290     define input  parameter p-obj-type             as character no-undo .
     1291     define input  parameter p-obj-code             as integer   no-undo .
     1292     define input  parameter p-fact-date            as date      no-undo .
     1293     define output parameter p-shift-on             as logical   no-undo .
     1294     define output parameter p-shift-date           as date      no-undo .
     1295     define output parameter p-shift-num            as integer   no-undo .
     1296     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1297     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1298     define variable v-fact-order as decimal   no-undo .
     1299     define buffer buf_shift-obj for ub.shift-obj .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1304   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1305     (input  p-obj-type
     1306     ,input  p-obj-code
     1307     ,input  'shift-on=request'
     1308     ,output p-shift-on
     1309     ) no-error .
     1310       if error-status :error
     1311       then do:
     1312         message
     1313           vss-workfile vss-revision vss-description skip
     1314           "Ошибка при определении атрибута объекта" skip
     1315           "Объект" p-obj-type p-obj-code skip
     1316           error-status :get-message(1) skip
     1317           return-value skip
     1318           view-as alert-box error .
     1319         undo, return error return-value .
     1320       end.
     1321       if p-shift-on = false
     1322       then do:
     1323         assign
     1324           p-shift-date               = ?
     1325           p-shift-num                = 0
     1326         .
     1327       end.
     1328       else do:
     1329         find first buf_shift-obj share-lock
     1330           where buf_shift-obj.obj-type   = p-obj-type
     1331             and buf_shift-obj.obj-code   = p-obj-code
     1332             and buf_shift-obj.shift-date > p-fact-date
     1333           use-index pi
     1334           no-error .
     1335         if not available buf_shift-obj
     1336         or buf_shift-obj.status_ <> 'зкр':U
     1337         then do:
     1338           message
     1339             vss-workfile vss-revision vss-description skip
     1340             "Невозможно вычислить последнюю смену" skip
     1341             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1342             "Объект" p-obj-type p-obj-code skip
     1343             "Дата" p-fact-date skip
     1344             view-as alert-box error .
     1345           undo, return error return-value .
     1346         end.
     1347         find last buf_shift-obj share-lock
     1348           where buf_shift-obj.obj-type = p-obj-type
     1349             and buf_shift-obj.obj-code = p-obj-code
     1350             and buf_shift-obj.shift-date <= p-fact-date
     1351           use-index pi
     1352           no-error .
     1353         if available buf_shift-obj
     1354         then do:
     1355           if  buf_shift-obj.status_ = 'зкр':U
     1356           then do:
     1357             assign
     1358               p-shift-date = buf_shift-obj.shift-date
     1359               p-shift-num  = buf_shift-obj.shift-num
     1360             .
     1361           end.
     1362           else do:
     1363             message
     1364               vss-workfile vss-revision vss-description skip
     1365               "Невозможно вычислить последнюю смену" skip
     1366               "Статус смены отличен от статуса" 'зкр':U skip
     1367               "Объект" p-obj-type p-obj-code skip
     1368               "Дата" p-fact-date skip
     1369               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1370               view-as alert-box error .
     1371             undo, return error return-value .
     1372           end.
     1373         end.
     1374         else do:
     1375           assign
     1376             p-shift-date = p-fact-date - 1
     1377             p-shift-num  = 1
     1378           .
     1379         end.
     1380       end.
     1381       run factord in this-procedure
     1382         (input  p-fact-date
     1383         ,input  1
     1384         ,input  1
     1385         ,input  p-shift-date
     1386         ,input  p-shift-num
     1387         ,input  p-shift-on
     1388         ,output v-fact-order
     1389         ,output p-shift-end-fact-order
     1390         ,output p-day-end-fact-order
     1391         ) no-error .
     1392       if error-status :error
     1393       then do:
     1394         message
     1395           vss-workfile vss-revision vss-description skip
     1396           "Ошибка при вызове процедуры factord"
     1397           error-status :get-message(1) skip
     1398           return-value skip
     1399           view-as alert-box error .
     1400         undo, return error return-value .
     1401       end.
     1402     end.
     1403   end procedure.
     1404   procedure factord-lock-shift :
     1405     define input  parameter p-obj-type  as character no-undo .
     1406     define input  parameter p-obj-code  as integer   no-undo .
     1407     define input  parameter p-fact-date as date      no-undo .
     1408     define parameter buffer buf_shift-obj for ub.shift-obj .
     1409     define variable v-shift-on      as logical   no-undo .
     1410     define variable v-extra-message as character no-undo .
     1411     define variable v-error as character no-undo .
     1412     do
     1413     on error undo, return error return-value
     1414     :
     1415   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1417     (input  p-obj-type
     1418     ,input  p-obj-code
     1419     ,input  'shift-on=request'
     1420     ,output v-shift-on
     1421     ) no-error .
     1422       if error-status :error
     1423       then do:
     1424         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1425         undo, return error v-error .
     1426       end.
     1427       if v-shift-on = true
     1428       then do:
     1429         find first buf_shift-obj share-lock
     1430           where buf_shift-obj.obj-type   = p-obj-type
     1431             and buf_shift-obj.obj-code   = p-obj-code
     1432             and buf_shift-obj.shift-date > p-fact-date
     1433           use-index pi
     1434           no-error .
     1435         if not available buf_shift-obj
     1436         or buf_shift-obj.status_ <> 'зкр':U
     1437         then do:
     1438           find last buf_shift-obj
     1439             where buf_shift-obj.obj-type = p-obj-type
     1440               and buf_shift-obj.obj-code = p-obj-code
     1441               and buf_shift-obj.status_  = 'зкр':U
     1442             use-index stts
     1443             no-error .
     1444           if available buf_shift-obj
     1445           then do:
     1446             assign
     1447               v-extra-message =
     1448                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1449                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1450                               )
     1451             .
     1452           end.
     1453           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1454           undo, return error v-error .
     1455         end.
     1456       end.
     1457     end.
     1458   end procedure.
     1459   procedure factord-end-day :
     1460     define input  parameter p-fact-date            as date    no-undo .
     1461     define output parameter p-day-end-fact-order   as decimal no-undo .
     1462     do
     1463     on error undo, return error return-value
     1464     :
     1465       if p-fact-date = ?
     1466       then do:
     1467         return error "Не указана фактическая дата" .
     1468       end.
     1469       assign
     1470         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1471       .
     1472     end.
     1473   end procedure.
     1474   procedure factord-to-date :
     1475     define input  parameter p-fact-order as decimal no-undo .
     1476     define output parameter p-fact-date  as date    no-undo .
     1477     define variable v-ref-date  as date      no-undo .
     1478     define variable v-ref-delta as integer   no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       if p-fact-order = ?
     1483       or p-fact-order = 0
     1484       then do:
     1485         return error "Не указан fact-order" .
     1486       end.
     1487       assign
     1488         v-ref-date  = date(1, 1, 2000)
     1489       .
     1490       assign
     1491         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1492       .
     1493       assign
     1494         p-fact-date = v-ref-date + v-ref-delta
     1495       .
     1496     end.
     1497   end procedure.
     1498   procedure factord-to-fact-num :
     1499     define input  parameter p-fact-order as decimal no-undo .
     1500     define output parameter p-fact-num   as integer no-undo .
     1501     define variable v-fact-order-trunc as decimal no-undo .
     1502     do
     1503     on error undo, return error return-value
     1504     :
     1505       if p-fact-order = ?
     1506       or p-fact-order = 0
     1507       then do:
     1508         return error "Не указан fact-order" .
     1509       end.
     1510       assign
     1511        v-fact-order-trunc = truncate(p-fact-order, 2)
     1512       .
     1513       assign
     1514         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1515       .
     1516     end.
     1517   end procedure.
     1518   procedure factord-to-shift-num :
     1519     define input  parameter p-fact-order as decimal no-undo .
     1520     define output parameter p-shift-num   as integer no-undo .
     1521     define variable  p-shift-numd  as decimal   no-undo .
     1522     define variable v-fact-order-trunc as decimal no-undo .
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       if p-fact-order = ?
     1527       or p-fact-order = 0
     1528       then do:
     1529         return error "Не указан fact-order" .
     1530       end.
     1531       assign
     1532        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1533       .
     1534       if v-fact-order-trunc < 0.5 then do:
     1535         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1536       end.
     1537       assign
     1538         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1539         .
     1540        assign
     1541         p-shift-num = truncate (p-shift-numd , 0)
     1542       .
     1543     end.
     1544   end procedure.
     1545   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1546   procedure cur-time :
     1547      define output parameter p-today as date      no-undo .
     1548      define output parameter p-time  as integer   no-undo .
     1549     do
     1550     on error undo, return error
     1551     :
     1552       define variable v-date1 as date      no-undo .
     1553       define variable v-date2 as date      no-undo .
     1554       define variable v-time  as integer   no-undo .
     1555       assign
     1556         v-date1 = today
     1557         v-time  = time
     1558         v-date2 = today
     1559       .
     1560       if v-date1 <> v-date2
     1561       then do:
     1562         assign
     1563           v-date1 = today
     1564           v-time  = v-time
     1565         .
     1566       end.
     1567       assign
     1568         p-today = v-date1
     1569         p-time  = v-time
     1570       .
     1571     end.
     1572   end.
     1573   function cur-time-date returns character
     1574   :
     1575     return string(today, '99/99/9999':U) .
     1576   end.
     1577   function cur-time-mjd returns decimal
     1578   :
     1579     define variable v-date as date      no-undo .
     1580     define variable v-time as integer   no-undo .
     1581     run cur-time in this-procedure
     1582       (output v-date
     1583       ,output v-time
     1584       ) .
     1585     return integer(v-date) - 2400002 + (v-time / 86400) .
     1586   end.
     1587   function cur-time-get-ending-index returns integer
     1588   (input p-number as integer
     1589   )
     1590   :
     1591     if p-number < 0
     1592     or p-number = ?
     1593     then do:
     1594       return 1 .
     1595     end.
     1596     define variable v-rest as integer   no-undo .
     1597     assign
     1598       p-number = p-number modulo 100
     1599     .
     1600     if p-number < 20
     1601     then do:
     1602       assign
     1603         v-rest = p-number
     1604       .
     1605     end.
     1606     else do:
     1607       assign
     1608         v-rest = p-number modulo 10
     1609       .
     1610     end.
     1611     case v-rest :
     1612       when 1
     1613       then do:
     1614         return 2 .
     1615       end.
     1616       when 2 or
     1617       when 3 or
     1618       when 4
     1619       then do:
     1620         return 3 .
     1621       end.
     1622       otherwise do:
     1623         return 1 .
     1624       end.
     1625     end case .
     1626   end.
     1627   procedure cur-time-mjd-to-date :
     1628      define input  parameter i-mjd-diff as decimal no-undo.
     1629      define output parameter o-Date     as date    no-undo.
     1630      define output parameter o-Time     as integer no-undo.
     1631      define variable v-day-number as integer   no-undo .
     1632      if    i-mjd-diff < 0
     1633         or i-mjd-diff = ?
     1634      then do:
     1635         return "?" .
     1636      end.
     1637      assign
     1638         v-day-number = truncate(i-mjd-diff,0).
     1639         o-Date = date(v-day-number + 2400002).
     1640         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1641     .
     1642   end.
     1643   function cur-time-mjd-to-string returns character
     1644   (input p-mjd-diff as decimal
     1645   )
     1646   :
     1647     define variable v-day-number as integer   no-undo .
     1648     define variable v-seconds    as integer   no-undo .
     1649     define variable v-hour       as integer   no-undo .
     1650     define variable v-min        as integer   no-undo .
     1651     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1652     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1653     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1654     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1655     if p-mjd-diff < 0
     1656     or p-mjd-diff = ?
     1657     then do:
     1658       return "?" .
     1659     end.
     1660     assign
     1661       v-day-number = integer(truncate(p-mjd-diff,0))
     1662       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1663     .
     1664     if v-seconds > 86400
     1665     then do:
     1666       assign
     1667         v-seconds = 86400 - 1
     1668       .
     1669     end.
     1670     if v-seconds < 0
     1671     then do:
     1672       assign
     1673         v-seconds = 0
     1674       .
     1675     end.
     1676     assign
     1677       v-hour = truncate(v-seconds / 3600, 0)
     1678     .
     1679     assign
     1680       v-seconds = v-seconds modulo 3600
     1681     .
     1682     assign
     1683       v-min = truncate(v-seconds / 60, 0)
     1684     .
     1685     assign
     1686       v-seconds = v-seconds modulo 60
     1687     .
     1688     return
     1689         (if v-day-number <> 0
     1690           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1691           else ""
     1692         )
     1693       + (if v-day-number <> 0 or v-hour <> 0
     1694           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1695           else ""
     1696         )
     1697       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1698           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1699           else ""
     1700         )
     1701       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1702       .
     1703   end.
     1704   function cur-time-string returns character
     1705   :
     1706     define variable v-date as date      no-undo .
     1707     define variable v-time as integer   no-undo .
     1708     run cur-time in this-procedure
     1709       (output v-date
     1710       ,output v-time
     1711       ) .
     1712     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1713   end.
     1714   function cur-time-string-sec returns character
     1715   :
     1716     define variable v-date as date      no-undo .
     1717     define variable v-time as integer   no-undo .
     1718     run cur-time in this-procedure
     1719       (output v-date
     1720       ,output v-time
     1721       ) .
     1722     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1723   end.
     1724   function cur-time-custom  returns character
     1725   (input p-prefix as character
     1726   ,input p-date-format as character
     1727   ,input p-delimiter as character
     1728   ,input p-time-format as character
     1729   ,input p-suffix as character
     1730   )
     1731   :
     1732     define variable v-date as date      no-undo .
     1733     define variable v-time as integer   no-undo .
     1734     run cur-time in this-procedure
     1735       (output v-date
     1736       ,output v-time
     1737       ) .
     1738     return
     1739       p-prefix
     1740       + string(v-date, p-date-format)
     1741       + p-delimiter
     1742       + string(v-time, p-time-format)
     1743       + p-suffix
     1744       .
     1745   end.
     1746   function cur-time-print  returns character
     1747   :
     1748     define variable v-date as date      no-undo .
     1749     define variable v-time as integer   no-undo .
     1750     run cur-time in this-procedure
     1751       (output v-date
     1752       ,output v-time
     1753       ) .
     1754     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1755   end.
     1756   function cur-time-datetime returns datetime
     1757   :
     1758     define variable v-char as character no-undo .
     1759     define variable v-datetime as datetime no-undo .
     1760     v-char = cur-time-string().
     1761     v-datetime = datetime(v-char).
     1762     return  v-datetime.
     1763   end.
     1764   function cur-time-string-msec returns character
     1765   :
     1766     define variable v-date as datetime  no-undo .
     1767     v-date = now.
     1768     return string(v-date) .
     1769   end.
     1770   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1772   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1773   procedure disrules-fill-properties:
     1774   define input  parameter p-templ-rl-root as integer   no-undo .
     1775   define buffer buf_drt-prop for ub.drt-prop.
     1776   define buffer buf_temp-drt-prop for temp-drt-prop.
     1777   do
     1778   on error undo, return error return-value
     1779   :
     1780     for each buf_temp-drt-prop:
     1781       delete buf_temp-drt-prop.
     1782     end.
     1783     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1784       create buf_temp-drt-prop.
     1785       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1786     end.
     1787   end.
     1788   end procedure.
     1789   ~
     1790   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1791   procedure discfgru-check :
     1792   define input parameter p-table-name as character no-undo .
     1793   define input parameter p-templ-rl-root as integer no-undo .
     1794   define input parameter p-time-templ-rl-root as integer no-undo .
     1795   define input parameter p-pos-type as character no-undo .
     1796   define output parameter p-disnct-role as character no-undo .
     1797   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       find first buf_dis-cfg-rule no-lock where
     1802               buf_dis-cfg-rule.table-name = p-table-name
     1803           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1804           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1805           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1806       if not available buf_dis-cfg-rule
     1807       or p-pos-type = "":U
     1808       then do:
     1809          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1810                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1811                                  , p-templ-rl-root
     1812                                  , (if p-time-templ-rl-root = ?
     1813                                     then '':U
     1814                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1815                                     )
     1816                                  ).
     1817       end.
     1818       assign
     1819       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1820       .
     1821     end.
     1822   end procedure.
     1823   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1824   FUNCTION get-region RETURNS CHARACTER
     1825     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1826     define variable par-region as character no-undo.
     1827     if parhost-code = 0 and
     1828          parobj-type = "":U and
     1829          parobj-code = 0 then do:
     1830          par-region = "Глобально".
     1831          return par-region.
     1832       end.
     1833       if parobj-type = 'орг':U then do:
     1834          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1835          return par-region.
     1836       end.
     1837       if parobj-type = 'регион':U
     1838       then do:
     1839          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1840          return par-region.
     1841       end.
     1842       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1843       return par-region.
     1844   END FUNCTION.
     1845   FUNCTION get-objregion RETURNS CHARACTER
     1846     (  input parobj-type as character, input parobj-code as integer ) :
     1847     define variable par-region as character no-undo.
     1848     if  parobj-type = "":U and
     1849         parobj-code = 0
     1850     then do:
     1851        par-region = "Глобально".
     1852     end.
     1853     else if parobj-type = 'орг':U
     1854     then do:
     1855        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1856     end.
     1857     else if parobj-type = 'регион':U
     1858     then do:
     1859        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1860     end.
     1861     else
     1862        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1863     return par-region.
     1864   END FUNCTION.
     1865   procedure disgdsru-name :
     1866   define buffer buf_dis-rule for ub.dis-rule.
     1867   do
     1868     on error undo, return error
     1869     :
     1870     define input  parameter p-templ-rl-root  as integer no-undo .
     1871     define output parameter p-label          as character no-undo .
     1872     find first buf_dis-rule no-lock where
     1873               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1874     if available buf_dis-rule
     1875     then do:
     1876       if buf_dis-rule.rule-num > 0 then
     1877       p-label = buf_dis-rule.des.
     1878     end.
     1879     else do:
     1880       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1881     end.
     1882   end.
     1883   end procedure.
     1884   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1885   define variable v-rule-label as character no-undo .
     1886   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1887                                        ,output v-rule-label) no-error.
     1888   return v-rule-label.
     1889   end function.
     1890   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1891   define variable v-rule-label as character no-undo .
     1892   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1893   end function.
     1894   procedure disgdsru-write :
     1895     do
     1896     on error undo, return error
     1897     :
     1898       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1899       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1900       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1901       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1902       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1903       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1904       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1905       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1906       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1907       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1908       define buffer buf_dis-rule for ub.dis-rule.
     1909       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1910       define variable v-label          as character no-undo .
     1911       define variable v-discnt-role as character no-undo .
     1912       run discfgru-check in this-procedure (
     1913                                             input 'dis-gds-rule':U
     1914                                            ,input p-templ-rl-root
     1915                                            ,input p-time-templ-rl-root
     1916                                            ,input p-pos-type
     1917                                            ,output v-discnt-role
     1918                                             ) no-error .
     1919       if error-status :error then do:
     1920         undo, return error return-value .
     1921       end.
     1922       if p-discnt-role = ? then do:
     1923         p-discnt-role = v-discnt-role.
     1924       end.
     1925       if p-discnt-role <> v-discnt-role then do:
     1926         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1927                                 ,p-gds-code
     1928                                 ,p-obj-type
