    11428   procedure pftxvalo :
    11429     define input  parameter par-rc        as recid                          no-undo .
    11430     define input  parameter partax-code   like ub.tax.tax-code              no-undo .
    11431     define input  parameter parrate-code  like ub.tax-rate.rate-code        no-undo .
    11432     define input  parameter parfact-order like ub.tax-rate-value.fact-order no-undo .
    11433     define input  parameter parhost-code  like ub.sysconf.host-code         no-undo .
    11434     define input  parameter parobj-type   like ub.clients.obj-type          no-undo .
    11435     define input  parameter parobj-code   like ub.clients.obj-code          no-undo .
    11436     define output parameter partax-value  as decimal no-undo .
    11437     define variable vss-description as character no-undo initial "pftxvalo: Значение по ставке налога для данного fact-order для заданного объекта и фирмы".
    11438     define buffer buf_tax-rate for ub.tax-rate.
    11439     define buffer buf_tax-rate-value for ub.tax-rate-value.
    11440     do
    11441     on error undo, return error return-value
    11442     :
    11443       assign
    11444         partax-value = ?
    11445       .
    11446       if partax-code  = 0
    11447       or parrate-code = 0
    11448       then do:
    11449         if par-rc = ?
    11450         then do:
    11451           undo, return error "Неверный параметр - recid tax-rate" .
    11452         end.
    11453         find first buf_tax-rate no-lock
    11454           where recid(buf_tax-rate) = par-rc
    11455           no-error .
    11456         if not available buf_tax-rate
    11457         then do:
    11458           undo, return error "Не найдена ставка налога " + "recid " + string(par-rc) .
    11459         end.
    11460         if buf_tax-rate.status_ = 'удал':U
    11461         then do:
    11462           undo, return error "Ставка налога недействительна "
    11463           + "налог: " + string(buf_tax-rate.tax-code) + " ставка: " + string(buf_tax-rate.rate-code) .
    11464         end.
    11465         assign
    11466           partax-code  = buf_tax-rate.tax-code
    11467           parrate-code = buf_tax-rate.rate-code
    11468         .
    11469       end.
    11470       find last buf_tax-rate-value no-lock
    11471         where buf_tax-rate-value.tax-code   = partax-code
    11472           and buf_tax-rate-value.rate-code  = parrate-code
    11473           and buf_tax-rate-value.host-code  = parhost-code
    11474           and buf_tax-rate-value.obj-type   = parobj-type
    11475           and buf_tax-rate-value.obj-code   = parobj-code
    11476           and buf_tax-rate-value.fact-order <= parfact-order
    11477           and buf_tax-rate-value.status_    = 'тек':U
    11478         no-error .
    11479       if available buf_tax-rate-value
    11480       then do:
    11481         assign
    11482           partax-value = buf_tax-rate-value.rate-value
    11483         .
    11484         return.
    11485       end.
    11486       find last buf_tax-rate-value no-lock
    11487         where buf_tax-rate-value.tax-code   = partax-code
    11488           and buf_tax-rate-value.rate-code  = parrate-code
    11489           and buf_tax-rate-value.host-code  = parhost-code
    11490           and buf_tax-rate-value.obj-type   = ""
    11491           and buf_tax-rate-value.obj-code   = 0
    11492           and buf_tax-rate-value.fact-order <= parfact-order
    11493           and buf_tax-rate-value.status_    = 'тек':U
    11494         no-error .
    11495       if available buf_tax-rate-value
    11496       then do:
    11497         assign
    11498           partax-value = buf_tax-rate-value.rate-value
    11499         .
    11500         return.
    11501       end.
    11502       find last buf_tax-rate-value no-lock
    11503         where buf_tax-rate-value.tax-code   = partax-code
    11504           and buf_tax-rate-value.rate-code  = parrate-code
    11505           and buf_tax-rate-value.host-code  = 0
    11506           and buf_tax-rate-value.obj-type   = ""
    11507           and buf_tax-rate-value.obj-code   = 0
    11508           and buf_tax-rate-value.fact-order <= parfact-order
    11509           and buf_tax-rate-value.status_    = 'тек':U
    11510         no-error .
    11511       if available buf_tax-rate-value
    11512       then do:
    11513         assign
    11514           partax-value = buf_tax-rate-value.rate-value
    11515         .
    11516         return.
    11517       end.
    11518     end.
    11519   end procedure.
    11520   procedure getListTaxRateValue :
    11521     define input  parameter iTax       like ub.tax.tax-name              no-undo .
    11522     define input  parameter iDate      like ub.tax-rate-value.fact-date  no-undo .
    11523     define input  parameter iHostCode  like ub.sysconf.host-code         no-undo .
    11524     define input  parameter iObjType   like ub.clients.obj-type          no-undo .
    11525     define input  parameter iObjCode   like ub.clients.obj-code          no-undo .
    11526     define output parameter oListTaxValue as character no-undo .
    11527     define variable vss-description as character no-undo initial "getListTaxRateValue: Возвращает список действующих ставок налога на дату для заданного объекта".
    11528     define variable vFactOrder as decimal no-undo.
    11529     define buffer buf_tax            for ub.tax.
    11530     define buffer buf_tax-rate       for ub.tax-rate.
    11531     define buffer buf_tax-rate-value for ub.tax-rate-value.
    11532     if iDate = ? then
    11533       iDate = today.
    11534     run factord-end-day in this-procedure
    11535       (input  iDate
    11536       ,output vFactOrder
    11537       ).
    11538     do
    11539     on error undo, return error return-value
    11540     :
    11541       for first buf_tax where
    11542                 buf_tax.tax-name = iTax
    11543             and buf_tax.status_  = 'тек':U no-lock,
    11544           each buf_tax-rate where
    11545                buf_tax-rate.tax-code = buf_tax.tax-code
    11546            and buf_tax-rate.status_ <> 'удал':U
    11547           no-lock,
    11548           last buf_tax-rate-value where
    11549                buf_tax-rate-value.tax-code = buf_tax-rate.tax-code
    11550            and buf_tax-rate-value.rate-code = buf_tax-rate.rate-code
    11551            and buf_tax-rate-value.host-code = iHostCode
    11552            and buf_tax-rate-value.obj-type = iObjType
    11553            and buf_tax-rate-value.obj-code = iObjCode
    11554            and buf_tax-rate-value.fact-order <= vFactOrder
    11555            and buf_tax-rate-value.status_ = 'тек':U
    11556           no-lock by buf_tax-rate-value.rate-value:
    11557         oListTaxValue = substitute(
    11558           "&1&2&3",
    11559           oListTaxValue,
    11560           if oListTaxValue = "" then "" else ",",
    11561           string(buf_tax-rate-value.rate-value)
    11562         ).
    11563       end.
    11564     end.
    11565   end procedure.
    11566   procedure curobjdt :
    11567     define input  parameter p-obj-type like ub.obj-date.obj-type   no-undo .
    11568     define input  parameter p-obj-code like ub.obj-date.obj-code   no-undo .
    11569     define output parameter p-sys-date like ub.obj-date.sys-date no-undo .
    11570     define variable vss-description as character no-undo initial "curobjdt-01: определение текущей даты".
    11571     do
    11572     on error undo, return error return-value
    11573     :
    11574       define buffer bf_clients for ub.clients.
    11575       define variable v-cur-sys-date  as date      no-undo .
    11576       define variable v-db-sys-date   as date      no-undo .
    11577       define variable v-obj-is-active as logical   no-undo.
    11578       define variable diffshftvalue   as character no-undo initial ?.
    11579       define variable diffshfttype    as character no-undo initial ?.
    11580       define variable vardiffshft     as integer   no-undo initial ?.
    11581       assign
    11582         v-db-sys-date = today
    11583       .
    11584   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtget in g#library
    11586     (input  p-obj-type
    11587     ,input  p-obj-code
    11588     ,output v-cur-sys-date
