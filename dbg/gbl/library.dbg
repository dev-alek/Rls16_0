     2065   PROCEDURE cmp-disgdsru-write :
     2066   do
     2067   on error undo, return error
     2068   :
     2069     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     2070     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     2071     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     2072     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     2073     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     2074     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     2075     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     2076     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     2077     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     2078     define variable v-rule-label          as character no-undo .
     2079     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     2080     define buffer buf_dis-rule     for ub.dis-rule.
     2081     run disgdsru-name in this-procedure (
     2082                                         input  p-templ-rl-root
     2083                                         ,output v-rule-label
     2084                                         ) no-error .
     2085     if error-status :error then do:
     2086       undo, return error return-value .
     2087     end.
     2088     find first buf_tt0-dis-gds-rule exclusive-lock where
     2089                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2090             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2091             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2092             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2093             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2094             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2095             no-error .
     2096     if not available buf_tt0-dis-gds-rule then do:
     2097       create buf_tt0-dis-gds-rule .
     2098       assign
     2099       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     2100       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     2101       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     2102       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     2103       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2104       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     2105       no-error
     2106       .
     2107     end.
     2108     find first buf_dis-rule no-lock where
     2109               buf_dis-rule.rule-num = p-rule-num.
     2110     ASSIGN
     2111     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2112     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     2113     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     2114     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     2115     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     2116     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     2117     no-error.
     2118     release buf_tt0-dis-gds-rule no-error .
     2119     if error-status:error then do:
     2120       undo, return error return-value .
     2121     end.
     2122   end.
     2123   END PROCEDURE.
