     6067                ,input buf_config.obj-type
     6068                ,input buf_config.obj-code
     6069                ,input msg-on
     6070                ,output v-level
     6071               ) no-error .
     6072             if error-status :error
     6073             then do:
     6074               undo, return error return-value.
     6075             end.
     6076             assign
     6077               p-type  = buf_config.param-type
     6078               p-value = buf_config.param-value
     6079             .
     6080           end.
     6081           else do:
     6082             if msg-on = TRUE
     6083             then do:
     6084               message
     6085                 "Параметр" p-code "отсутствует в БД." skip
     6086                 "Параметры задаются через 'АРМ Администратор/Справочники/Настройки и конфигурация системы'" skip
