      981   procedure gds-obj-dop-alt-name :
      982     define input  parameter p-gds-code    like ub.gds-obj-attr.gds-code no-undo .
      983     define input  parameter p-obj-type    like ub.gds-obj-attr.obj-type no-undo .
      984     define input  parameter p-obj-code    like ub.gds-obj-attr.obj-code no-undo .
      985     define input-output parameter p-value as character no-undo .
      986     define output parameter p-setted      as logical no-undo .
      987     do
