    11256                   buf_tax-rate-value.status_ = 'тек':U
    11257                   NO-ERROR.
    11258       if avail buf_tax-rate-value
    11259       then do:
    11260         assign
    11261         par-x-host-code = buf_tax-rate-value.host-code
    11262         par-x-obj-type = buf_tax-rate-value.obj-type
    11263         par-x-obj-code = buf_tax-rate-value.obj-code
    11264         .
    11265         return.
    11266       end.
    11267     end.
