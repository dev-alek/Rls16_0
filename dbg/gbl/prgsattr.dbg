      287   define variable v-com-handle-list as character no-undo
      288   initial
      289   "COM-HANDLE~
      290   " .
      291   define variable v-character-list as character no-undo
      292   initial
      293   "ACCELERATOR~
      294   ,CHARSET~
      295   ,CPCASE~
      296   ,CPCOLL~
      297   ,CPINTERNAL~
      298   ,CPLOG~
      299   ,CPPRINT~
      300   ,CPRCODEIN~
      301   ,CPRCODEOUT~
      302   ,CPSTREAM~
      303   ,CPTERM~
      304   ,DATA-TYPE~
      305   ,DATE-FORMAT~
      306   ,DBNAME~
      307   ,DDE-ITEM~
      308   ,DDE-NAME~
      309   ,DDE-TOPIC~
      310   ,DELIMITER~
      311   ,DISPLAY-TYPE~
      312   ,FORMAT~
      313   ,FRAME-NAME~
      314   ,HELP~
      315   ,LABEL~
      316   ,LIST-ITEMS~
