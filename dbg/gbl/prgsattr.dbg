      337   " .
      338   do
      339   on error undo, return error return-value
      340   :
      341     define variable v-attrib-name as character no-undo .
      342     assign
      343       v-attrib-name = keyword-all(p-attribute-name)
      344     .
      345     if  v-attrib-name <> ?
      346     and v-attrib-name <> "" then do:
      347       if lookup(v-attrib-name, v-widget-handle-list) > 0 then do:
      348         assign
      349           p-attribute-type = 'W':U
      350         .
      351       end.
      352       if lookup(v-attrib-name, v-com-handle-list) > 0 then do:
      353         assign
      354           p-attribute-type = 'H':U
      355         .
      356       end.
      357       if lookup(v-attrib-name, v-logical-list) > 0 then do:
      358         assign
      359           p-attribute-type = 'L':U
      360         .
      361       end.
      362       if lookup(v-attrib-name, v-integer-list) > 0 then do:
      363         assign
      364           p-attribute-type = 'I':U
      365         .
      366       end.
      367       if lookup(v-attrib-name, v-decimal-list) > 0 then do:
      368         assign
      369           p-attribute-type = 'D':U
      370         .
      371       end.
      372       if lookup(v-attrib-name, v-character-list) > 0 then do:
      373         assign
      374           p-attribute-type = 'C':U
      375         .
      376       end.
      377     end.
      378   end.
