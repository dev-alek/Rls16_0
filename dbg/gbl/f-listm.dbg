        1   define input  parameter parParentProc  as widget-handle no-undo .
        2   define input  parameter spr      as character no-undo .
        3   define input  parameter lab_user as character no-undo .
        4   define input  parameter fld      as character no-undo .
        5   define input  parameter lab      as character no-undo .
        6   define input  parameter type     as character no-undo .
        7   define output parameter str      as character no-undo .
        8   define output parameter str_rus  as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Редактирование фильтров - списков со справочниками".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u,spr,lab_user,fld,lab,type)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable flt-rec as recid no-undo.
      134   define variable g#report-num as integer no-undo .
      135   run get-report-num  in parparentproc ( output g#report-num ).
      136   DEFINE BUTTON  b-spr
      137        IMAGE-UP FILE "btn-down-arrow"
      138        IMAGE-DOWN FILE "btn-down-arrow"
      139        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      140        LABEL "":L
      141        SIZE 2.5 BY .9.
      142   define variable grp     AS WIDGET NO-UNDO.
      143   define variable flw      AS WIDGET NO-UNDO.
      144   define variable fill_in AS WIDGET NO-UNDO.
      145   define variable txt      AS WIDGET NO-UNDO.
      146   define variable btn     AS WIDGET NO-UNDO.
      147   define variable min-width      AS INT    NO-UNDO INIT 20.
      148   define variable frm                AS CHAR NO-UNDO.
      149   define variable frm-text         AS CHAR NO-UNDO.
      150   define variable type_            AS CHAR NO-UNDO.
      151   define variable lab_              AS CHAR NO-UNDO.
      152   define variable fld_               AS CHAR NO-UNDO.
      153   define variable data              AS CHAR NO-UNDO.
      154   define variable join-tbl          AS CHAR NO-UNDO.
      155   define variable join_rus        AS CHAR NO-UNDO.
      156   define variable join_ext        AS CHAR NO-UNDO.
      157   define variable join_rus_ext AS CHAR NO-UNDO.
      158   define variable ii                    AS INT     NO-UNDO.
      159   define variable ii1                   AS INT     NO-UNDO.
      160   define variable j                    AS INT     NO-UNDO.
      161   define variable s                   AS CHAR NO-UNDO.
      162   define variable a                   AS CHAR NO-UNDO.
      163   define variable next-fill-in     AS LOG   NO-UNDO INIT FALSE.
      164   define variable znak             AS CHAR NO-UNDO.
      165   define variable offset            AS CHAR NO-UNDO.
      166   define variable scr-val          AS CHAR NO-UNDO.
      167   define variable name            AS CHAR NO-UNDO.
      168   define variable ref-list           AS CHAR NO-UNDO.
      169   define variable out-an           AS INT     NO-UNDO.
      170   define variable v_type          AS CHAR NO-UNDO.
      171   DEFINE BUTTON b-add
      172        LABEL "&Добавить":L
      173        SIZE 10 BY 1 TOOLTIP "Ввести в список внесенное с клавиатуры значение".
      174   DEFINE BUTTON b-del
      175        LABEL "&Удалить":L
      176        SIZE 10 BY 1 TOOLTIP "Удалить ранее включенное в список значение".
      177   DEFINE BUTTON B-help
      178        LABEL "Помо&щь"
      179        SIZE 2.5 BY 1.
      180   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      181        LABEL "&Отмена":L
      182        SIZE 10 BY 1 TOOLTIP "Отменить формирование критерия"
      183        BGCOLOR 8 .
      184   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      185        LABEL "&Сохранить":L
      186        SIZE 10 BY 1 TOOLTIP "Сохранить сформированный критерий"
      187        BGCOLOR 8 .
      188   DEFINE VARIABLE list AS CHARACTER
      189        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      190        SIZE 20 BY 5.5 NO-UNDO.
      191   DEFINE VARIABLE togl AS LOGICAL INITIAL no
      192        LABEL "Включительно":L
      193        VIEW-AS TOGGLE-BOX
      194        SIZE 15 BY .83 NO-UNDO.
      195   DEFINE FRAME DIALOG-1
      196        B-help AT ROW 1 COL 1 WIDGET-ID 2
      197        b-add AT ROW 3.25 COL 3
      198        b-del AT ROW 3.25 COL 13
      199        list AT ROW 4.75 COL 3 NO-LABEL
      200        togl AT ROW 10.25 COL 3
      201        Btn_OK AT ROW 11.25 COL 3
      202        Btn_Cancel AT ROW 11.25 COL 13.13
      203        SPACE(8.11) SKIP(0.62)
      204       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      205            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      206            TITLE "":L
      207            CANCEL-BUTTON Btn_Cancel.
      208   ASSIGN
      209          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      210   ON CHOOSE OF b-add IN FRAME DIALOG-1
      211   DO:
      212     run proc-b-add in this-procedure No-ERROR.
      213     APPLY "ENTRY":U TO btn_cancel IN FRAME DIALOG-1.
      214   END.
      215   ON CHOOSE OF b-del IN FRAME DIALOG-1
      216   DO:
      217     ASSIGN list.
      218     IF list:DELETE( list ) THEN.
      219   END.
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   on help of frame DIALOG-1
      222   do:
      223     run gbl/app_help.p
      224       (input this-procedure :file-name
      225       ,input ''
      226       ,input ?
      227       ) no-error.
      228     if error-status :error then do:
      229       message
      230         "Ошибка при вызове помощи"
      231         error-status :get-message(1)
      232         view-as alert-box .
      233     end.
      234   end.
      235   run minbtn-set in this-procedure .
      236   on choose of b-help in frame DIALOG-1
      237   do:
      238     apply "help":u to frame DIALOG-1 .
      239   end.
      240   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   procedure minbtn-set :
      242       do
      243           on error undo, return error return-value
      244           :
      245           define variable ii              as integer       no-undo .
      246           define variable fh              as widget-handle no-undo .
      247           define variable hh              as widget-handle no-undo .
      248           define variable v-h             as handle        extent 4 no-undo .
      249           define variable v-name-button   as character     no-undo .
      250           define variable v-help-old-x    as decimal       no-undo .
      251           define variable v-help-old-y    as decimal       no-undo .
      252           define variable v-help-old-size as decimal       no-undo .
      253           define variable v-frame-width   as decimal       no-undo .
      254           define variable jj              as integer       no-undo .
      255           do
      256               on error undo, return error
      257               :
      258               assign
      259                   v-frame-width = frame DIALOG-1:width - 0.3
      260                   fh            = frame DIALOG-1:first-child
      261                   hh            = fh:first-child
      262                   ii            = 1
      263                   .
      264               do while valid-handle(hh):
      265                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      266                   do:
      267                       case lc(hh:name) :
      268                           when "b-help" then
      269                               do:
      270                                   hh:load-image-up("cmp/b-help.bmp":u) .
      271                                   hh:load-image-down("cmp/b-help.bmp":u) .
      272                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      273                                   hh:TOOLTIP = "Помощь" .
      274                                   v-help-old-x = hh:column .
      275                                   v-help-old-y = hh:row    .
      276                                   v-help-old-size = hh:width .
      277                                   hh:width-chars = 2.5 .
      278                               end.
      279                           when "b-print" then
      280                               do:
      281                                   hh:load-image("cmp/b-print.bmp":u) .
      282                                   hh:TOOLTIP = "Печать" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-history" or
      288                           when "b-hist" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История" .
      292                                   v-h[ii] = hh:handle .
      293                                   ii = ii + 1 .
      294                                   hh:width-chars = 3 .
      295                               end.
      296                           when "b-sch" then
      297                               do:
      298                                   hh:load-image("cmp/b-sch.bmp":u) .
      299                                   hh:TOOLTIP = "Установка Фильтра" .
      300                                   v-h[ii] = hh:handle .
      301                                   ii = ii + 1 .
      302                                   hh:width-chars = 3 .
      303                               end.
      304                           when "b-hist-user" then
      305                               do:
      306                                   hh:load-image("cmp/b-hist.bmp":u) .
      307                                   hh:TOOLTIP = "История пользователя" .
      308                                   ii = ii + 1 .
      309                               end.
      310                       end case.
      311                   end.
      312                   hh = hh:next-sibling.
      313               end.
      314               b-help:column = v-frame-width - b-help:width-chars.
      315               jj = 0.
      316               repeat ii = 4 to 1 by -1 :
      317                   if valid-handle (v-h[ii] ) then
      318                   do:
      319                       jj  = jj + 1 .
      320                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      321                       v-h[ii]:row    = v-help-old-y .
      322                   end.
      323               end.
      324           end.
      325       end.
      326   end procedure.
      327   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      328   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      329   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      330   Main-Block:
      331   DO ON ERROR    UNDO Main-Block, RETURN ERROR
      332         ON STOP       UNDO Main-Block, RETURN ERROR
      333         ON END-KEY UNDO Main-Block, RETURN ERROR :
      334      ASSIGN
      335        offset    = "3"
      336        frm        = "":U
      337        frm-text = "":U.
      338      DO ii = 1 TO NUM-ENTRIES( lab, '*' ) :
      339           type_ = ENTRY(ii, type, '*' ).
      340           CASE type_ :
      341                   WHEN 'character':U THEN DO:
      342                      ASSIGN
      343                        offset    = offset    + ',' + STRING( INT( ENTRY(ii, offset ) ) + 20 + 2 )
      344                        frm        = frm        + ',' + "x(20)"
      345                        frm-text = frm-text + ',' + "x(20)".
      346                   END.
      347                   WHEN 'integer':U THEN DO:
      348                      ASSIGN
      349                        offset    = offset    + ',' + STRING( INT( ENTRY(ii, offset ) ) +  10  + 2 )
      350                        frm        = frm        + ',' + ( ">>>>>>>>>9" )
      351                        frm-text = frm-text + ',' + ( "x(10)" ).
      352                   END.
      353                   WHEN 'int64':U THEN DO:
      354                      ASSIGN
      355                        offset    = offset    + ',' + STRING( INT64( ENTRY(ii, offset ) ) +  10  + 2 )
      356                        frm        = frm        + ',' + ( ">>>>>>>>>>>>>>>>>>>9" )
      357                        frm-text = frm-text + ',' + ( "x(20)" ).
      358                   END.
      359                   WHEN 'decimal':U THEN DO:
      360                      ASSIGN
      361                        offset    = offset     + ',' + STRING( INT( ENTRY( ii, offset ) ) + 12 + 2 )
      362                        frm        = frm        + ',' + ">>>>>>>9.999"
      363                        frm-text = frm-text + ',' + "x(12)".
      364                   END.
      365                   WHEN 'date':U THEN DO:
      366                      ASSIGN
      367                        offset    = offset    + ',' + STRING( INT( ENTRY( ii, offset ) ) + 10 + 2 )
      368                        frm        = frm        + ',' + "99/99/9999"
      369                        frm-text = frm-text + ',' + "x(10)".
      370                   END.
      371                   WHEN 'logical':U THEN DO:
      372                      ASSIGN
      373                        offset    = offset     + ',' + STRING( INT( ENTRY( ii, offset ) ) + 10 + 2 )
      374                        frm        = frm        + ',' + "yes/no"
      375                        frm-text = frm-text + ',' + "x(10)".
      376                   END.
      377                   WHEN 'recid':U THEN DO:
      378                      ASSIGN
      379                        offset    = offset    + ',' + STRING( INT( ENTRY( ii, offset ) ) +  10  + 2 )
      380                        frm        = frm        + ',' +  ">>>>>>>>>9"
      381                        frm-text = frm-text + ',' +  "x(10)" .
      382                   END.
      383           END CASE.
      384      END.
      385      SUBSTR( frm,        1, 1 ) = "".
      386      SUBSTR( frm-text, 1, 1 ) = "".
      387      IF INT( ENTRY( NUM-ENTRIES( offset ), offset ) ) > min-width THEN
      388         min-width = INT( ENTRY( NUM-ENTRIES( offset ), offset ) ).
      389      IF CAN-DO( "cli,gds", spr ) THEN min-width = min-width + 20 .
      390      ASSIGN FRAME DIALOG-1:WIDTH-CHAR = min-width + 3.
      391      IF spr <> "" THEN DO:
      392          FORM b-spr WITH FRAME DIALOG-1.
      393          ASSIGN
      394            b-spr:ROW          = 2
      395            b-spr:COLUMN    = min-width
      396            b-spr:VISIBLE      = TRUE
      397            b-spr:SENSITIVE = TRUE.
      398          ON CHOOSE OF b-spr IN FRAME DIALOG-1 DO:
      399            define variable grp-rec AS RECID NO-UNDO.
      400            define variable ref-rec  AS RECID NO-UNDO.
      401            CASE spr :
      402               WHEN 'cli' THEN DO:
      403                 ref-list = "".
      404                 run ref/cli-all.w (
      405                                parParentProc
      406                              , "b-sel,b-mark":U
      407                              , 'орг':U
      408                              , 'все':U
      409                              , 'текущие':U
      410                              , ?
      411                              , ",,,,,,NO"
      412                              , "":U
      413                              , OUTPUT ref-list ).
      414                 IF ref-list <> "":U THEN DO:
      415                   DO ii1 = 1 to num-entries(ref-list):
      416                     ASSIGN ref-rec = integer(entry(ii1, ref-list)).
      417                     FIND ub.clients WHERE RECID( ub.clients ) = ref-rec.
      418                     ASSIGN
      419                     name = ub.clients.obj-name
      420                     grp     = FRAME DIALOG-1:FIRST-CHILD.
      421                     DO WHILE ( grp <> ? ) :
      422                       flw = grp:FIRST-CHILD.
      423                       DO WHILE ( flw <> ? ) :
      424                         IF flw:type = 'fill-in' THEN DO:
      425                           CASE ENTRY( 2, ENTRY( 2, ENTRY( 1, flw:PRIVATE-DATA ), '.' ), '-' ) :
      426                             WHEN "code" THEN flw:SCREEN-VALUE = STRING( clients.obj-code ).
      427                             WHEN "type"  THEN flw:SCREEN-VALUE = clients.obj-type.
      428                           END CASE.
      429                         END.
      430                         flw = flw:NEXT-SIBLING.
      431                       END.
      432                       grp = grp:NEXT-SIBLING.
      433                     END.
      434                     APPLY "ENTRY":U   TO b-add IN FRAME DIALOG-1.
      435                     RUN proc-b-add in this-procedure.
      436                   END.
      437                 END.
      438                 ELSE DO:
      439                   APPLY "ENTRY":U TO b-spr IN FRAME DIALOG-1.
      440                 end.
      441               END.
      442               WHEN 'gds' THEN DO:
      443                 run ref/gds-ref.p ( input parparentproc
      444                                 , input "b-sel,b-mark":U
      445                                 , input ?
      446                                 , input ?
      447                                 , input ?
      448                                 , input ?
      449                                 , input ?
      450                                 , input ?
      451                                 , input ?
      452                                 , input ?
      453                                 , input ?
      454                                 , input ?
      455                                 , OUTPUT ref-list ).
      456                 IF ref-list <> "":U THEN DO:
      457                   DO II1 = 1 to num-entries(ref-list):
      458                     ASSIGN ref-rec = INT( ENTRY(ii1, ref-list )).
      459                     FIND ub.goods NO-LOCK WHERE RECID( ub.goods ) = ref-rec.
      460                     ASSIGN
      461                     name = ub.goods.gds-name
      462                     grp     = FRAME DIALOG-1:FIRST-CHILD.
      463                     DO WHILE ( grp <> ? ) :
      464                       ASSIGN flw = grp:FIRST-CHILD.
      465                       DO WHILE ( flw <> ? ) :
      466                         IF flw:type = 'fill-in' THEN DO:
      467                           CASE ENTRY( 2, ENTRY( 1, flw:PRIVATE-DATA ), '.' ) :
      468                             WHEN "prod-code" THEN flw:SCREEN-VALUE = STRING( prod-code ).
      469                             WHEN "prod-type"  THEN flw:SCREEN-VALUE = prod-type.
      470                             WHEN "artic"          THEN flw:SCREEN-VALUE = artic.
      471                           END CASE.
      472                         END.
      473                         ASSIGN flw = flw:NEXT-SIBLING.
      474                       END.
      475                       ASSIGN grp = grp:NEXT-SIBLING.
      476                     END.
      477                     APPLY "ENTRY":U   TO b-add IN FRAME DIALOG-1.
      478                     RUN proc-b-add in this-procedure.
      479                   END.
      480                 END.
      481                 ELSE DO:
      482                   APPLY "ENTRY":U TO b-spr IN FRAME DIALOG-1.
      483                 END.
      484               END.
      485            END CASE.
      486          END.
      487      END.
      488      ASSIGN list:WIDTH-CHAR = INT( ENTRY( NUM-ENTRIES( offset ), offset ) ) - 3 + 1.
      489      IF CAN-DO( "cli,gds", spr) THEN list:WIDTH-CHAR = list:WIDTH-CHAR +  20 .
      490      IF lab_user = "":U OR lab_user = ? THEN lab_user = lab.
      491      DO ii = 1 TO NUM-ENTRIES( lab_user, '*' ) :
      492           lab_ = ENTRY( ii, lab_user, '*' ).
      493           CREATE TEXT txt
      494                      ASSIGN
      495                        FRAME               = FRAME DIALOG-1:HANDLE
      496                        DATA-TYPE        = "character"
      497                        FORMAT             = ENTRY( ii, frm-text )
      498                        SCREEN-VALUE = lab_
      499                        ROW                  = 1
      500                        COLUMN            = INT( ENTRY(ii, offset ) ).
      501      END.
      502      DO ii = 1 TO NUM-ENTRIES( type, '*' ) :
      503         ASSIGN
      504           type_ = ENTRY( ii, type, '*' )
      505           fld_    = ENTRY( ii, fld,    '*' )
      506           lab_   = ENTRY( ii, lab,   '*' ).
      507           CREATE FILL-IN fill_in
      508                      ASSIGN
      509                        FRAME            = FRAME DIALOG-1:HANDLE
      510                        DATA-TYPE     = type_
      511                        FORMAT          = ENTRY( ii, frm )
      512                        PRIVATE-DATA = fld_ + ',' + lab_
      513                        ROW                = 2
      514                        COLUMN          = INT( ENTRY( ii, offset ) )
      515                        SENSITIVE       = TRUE
      516                        VISIBLE            = TRUE.
      517      END.
      518      togl = TRUE.
      519      RUN enable_UI.
      520      WAIT-FOR GO OF FRAME DIALOG-1.
      521      ASSIGN list.
      522      IF list:NUM-ITEMS = 0 THEN RETURN ERROR.
      523      IF INPUT FRAME DIALOG-1 togl THEN DO:
      524        ASSIGN
      525         znak      = " = "
      526         join-tbl   = " AND "  join_rus        = " И "
      527         join_ext = " OR "    join_rus_ext = " ИЛИ ".
      528      END. ELSE DO:
      529        ASSIGN
      530         znak      = " <> "
      531         join-tbl   = " OR "    join_rus        = " ИЛИ "
      532         join_ext = " AND "  join_rus_ext = " И ".
      533      END.
      534      ASSIGN
      535        str        = '('
      536        str_rus = '('.
      537      DO ii = 1 TO list:NUM-ITEMS :
      538           ASSIGN
      539             s   = ENTRY( ii, list:LIST-ITEMS )
      540             str = str + '('.
      541           IF NOT CAN-DO( "cli,gds", spr ) THEN str_rus = str_rus + '('.
      542           DO j = 1 TO NUM-ENTRIES( type, '*' ) :
      543                ASSIGN
      544                  type_ = ENTRY( j, type, '*' )
      545                  fld_    = ENTRY( j, fld,    '*' )
      546                  lab_   = ENTRY( j, lab,   '*' )
      547                  data   = TRIM( ENTRY( j, s, '|' ) ).
      548                IF type_ = "character" THEN data = '"' + data + '"'.
      549                IF NOT CAN-DO( "cli,gds", spr ) THEN str_rus = str_rus + lab_ + znak + data.
      550                IF type_ = "date" THEN data = ENTRY( 2, data, chr(47) ) + ENTRY( 1, data, chr(47) ) + ENTRY( 3, data, chr(47) ).
      551                str = str + fld_ + znak + data.
      552                IF j <> NUM-ENTRIES( type, '*' ) THEN DO:
      553                     str = str + join-tbl.
      554                     IF NOT CAN-DO( "cli,gds", spr ) THEN str_rus = str_rus + join_rus.
      555                END.
      556           END.
      557           IF CAN-DO( "cli,gds", spr ) THEN str_rus = str_rus + lab_user + znak + '"' + TRIM( ENTRY( j, s, '|' ) ) + '"'.
      558           str = str + ')'.
      559           IF NOT CAN-DO( "cli,gds", spr ) THEN str_rus = str_rus + ')'.
      560           IF ii <> list:NUM-ITEMS THEN DO:
      561              ASSIGN
      562                str        = str + join_ext
      563                str_rus = str_rus + join_rus_ext.
      564           END.
      565      END.
      566      ASSIGN
      567        str        = str        + ')'
      568        str_rus = str_rus + ')'.
      569   END.
      570   RUN disable_UI.
      571   PROCEDURE disable_UI :
      572     HIDE FRAME DIALOG-1.
      573   END PROCEDURE.
      574   PROCEDURE enable_UI :
      575     DISPLAY list togl
      576         WITH FRAME DIALOG-1.
      577     ENABLE B-help b-add b-del list togl Btn_OK Btn_Cancel
      578         WITH FRAME DIALOG-1.
      579   END PROCEDURE.
      580   PROCEDURE proc-b-add :
      581   define variable type_  AS CHAR NO-UNDO.
      582   define variable code_ AS INT     NO-UNDO.
      583   define variable art_     AS CHAR NO-UNDO.
      584   define variable jnum_ AS INT     NO-UNDO.
      585   define variable jsub_  AS INT     NO-UNDO.
      586   define variable jhost-code_ as int no-undo.
      587   define variable v-found as integer no-undo extent 4.
      588     ASSIGN
      589      s    = ""
      590      grp = FRAME DIALOG-1:FIRST-CHILD.
      591     DO WHILE ( grp <> ? ) :
      592           flw = grp:FIRST-CHILD.
      593           DO WHILE ( flw <> ? ) :
      594                IF flw:type = 'fill-in' THEN DO:
      595                   IF spr = 'cli' THEN DO:
      596                     CASE ENTRY( 2, ENTRY( 2, ENTRY( 1, flw:PRIVATE-DATA ), '.' ), '-' ) :
      597                         WHEN "code" THEN code_ = INT( flw:SCREEN-VALUE ).
      598                         WHEN "type"  THEN type_  = flw:SCREEN-VALUE.
      599                     END CASE.
      600                   END.
      601                   IF spr = 'gds' THEN DO:
      602                     CASE ENTRY( 2, ENTRY( 1, flw:PRIVATE-DATA ), '.' ) :
      603                          WHEN "prod-code" THEN code_ = INT( flw:SCREEN-VALUE ).
      604                          WHEN "prod-type"  THEN type_ = flw:SCREEN-VALUE.
      605                          WHEN "artic"          THEN art_    = flw:SCREEN-VALUE.
      606                     END CASE.
      607                   END.
      608                   CASE flw:DATA-TYPE :
      609                      WHEN 'character':U THEN scr-val = STRING(          flw:SCREEN-VALUE,   flw:FORMAT ).
      610                      WHEN 'decimal':U   THEN scr-val = STRING( DEC( flw:SCREEN-VALUE ), flw:FORMAT ).
      611                      WHEN 'integer':U     THEN scr-val = STRING( INT( flw:SCREEN-VALUE ),  flw:FORMAT ).
      612                      WHEN 'int64':U     THEN scr-val = STRING( INT( flw:SCREEN-VALUE ),  flw:FORMAT ).
      613                      WHEN 'date':U         THEN scr-val = STRING(         flw:SCREEN-VALUE,    'x(10)'          ).
      614                      WHEN 'logical':U     THEN scr-val = STRING(         flw:SCREEN-VALUE,    'x(10)'          ).
      615                      WHEN 'recid':U        THEN scr-val = STRING( INT( flw:SCREEN-VALUE ), '>>>>>>>>>9' ).
      616                   END CASE.
      617                   s = s + scr-val + ' |'.
      618                END.
      619                flw = flw:NEXT-SIBLING.
      620           END.
      621           grp = grp:NEXT-SIBLING.
      622      END.
      623      CASE spr :
      624         WHEN 'cli' THEN DO:
      625           if lookup(type_, ("":U + chr(44) +
      626                             'орг':U + chr(44) +
      627                             'чел':U + chr(44) +
      628                             'маг':U + chr(44) +
      629                             'скл':U) ) = 0 then do:
      630             message "Неверный тип клиента".
      631             return no-apply.
      632           end.
      633           if type_ = "":U then do:
      634               FIND ub.clients WHERE
      635                   ub.clients.obj-type  = 'орг':U
      636               AND ub.clients.obj-code = code_ NO-ERROR.
      637               if avail ub.clients then v-found[1] = 1.
      638               FIND ub.clients WHERE
      639                   ub.clients.obj-type  = 'чел':U
      640               AND ub.clients.obj-code = code_ NO-ERROR.
      641               if avail ub.clients then v-found[2] = 1.
      642               FIND ub.clients WHERE
      643                   ub.clients.obj-type  = 'маг':U
      644               AND ub.clients.obj-code = code_ NO-ERROR.
      645               if avail ub.clients then v-found[3] = 1.
      646               FIND ub.clients WHERE
      647                   ub.clients.obj-type  = 'скл':U
      648               AND ub.clients.obj-code = code_ NO-ERROR.
      649               if avail ub.clients then v-found[4] = 1.
      650               if v-found[1] + v-found[2] + v-found[3] + v-found[4] > 1 then do:
      651                 message "Есть два клиента или более с кодом" code_ skip
      652                 "Уточните тип клиента"
      653                 view-as alert-box .
      654                 return no-apply.
      655               end.
      656               else do:
      657                 if v-found[1]  = 1 then
      658                 assign
      659                 type_ =   'орг':U
      660                 .
      661                 if v-found[2]  = 1 then
      662                 assign
      663                 type_ =   'чел':U
      664                 .
      665                 if v-found[3]  = 1 then
      666                 assign
      667                 type_ =   'маг':U
      668                 .
      669                 if v-found[4]  = 1 then
      670                 assign
      671                 type_ =   'скл':U
      672                 .
      673               end.
      674            end.
      675            FIND ub.clients WHERE
      676                ub.clients.obj-type  = type_
      677            AND ub.clients.obj-code = code_ NO-ERROR.
      678            IF NOT AVAIL ub.clients THEN DO:
      679               MESSAGE "Клиент отсутствует".
      680               RETURN NO-APPLY.
      681            END.
      682            ELSE ASSIGN name = ub.clients.obj-name.
      683         END.
      684         WHEN 'gds' THEN DO:
      685           FIND ub.goods WHERE ub.goods.prod-type  = type_
      686                                           AND ub.goods.prod-code = code_
      687                                           AND ub.goods.artic          = art_     NO-ERROR.
      688           IF NOT AVAIL ub.goods THEN DO:
      689               MESSAGE "Товар отсутствует".
      690               RETURN NO-APPLY.
      691           END.
      692           ELSE do:
      693             ASSIGN name = ub.goods.gds-name.
      694           end.
      695         END.
      696      END CASE.
      697     IF CAN-DO( "cli,gds", spr ) THEN s = s + name.
      698     ii = LOOKUP( s, list:LIST-ITEMS ).
      699     IF ii = 0 OR ii = ? THEN IF list:ADD-LAST( s ) THEN.
      700   END PROCEDURE.
