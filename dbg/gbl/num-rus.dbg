        1   block-level on error undo, throw.
        2   define  input parameter  InSum as decimal   no-undo .
        3   define output parameter OutSum as character no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: num-rus.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: gbl/num-rus.p $":U .
        9   define variable vss-description as character no-undo initial "сумма прописью без указания валюты":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable Formatted as character no-undo .
       65   define variable Word      as character no-undo .
       66   define variable II        as integer   no-undo .
       67   assign
       68     Formatted = string( abs( InSum ), "999999999999999.99":U )
       69     II        = length( Formatted ) - 3
       70   .
       71   L1:
       72   do while ( II >= 3 ) :
       73     if substring( Formatted, II - 2, 3 ) = "000"
       74     then do:
       75       assign
       76         II = II - 3
       77       .
       78       next L1 .
       79     end.
       80     if II = 12
       81     then do:
       82       assign
       83         Word =  "тысяч          "
       84       .
       85     end.
       86     if II =  9
       87     then do:
       88       assign
       89         Word =  "миллион        "
       90       .
       91     end.
       92     if II =  6
       93     then do:
       94       assign
       95         Word =  "миллиард       "
       96       .
       97     end.
       98     if II =  3
       99     then do:
      100       assign
      101         Word =  "триллион       "
      102       .
      103     end.
      104     if II < 15 then do:
      105       if substring( Formatted, II,     1 )  = "1" and
      106          substring( Formatted, II - 1, 1 ) <> "1" and II = 12
      107       then do:
      108         assign
      109           Word = trim( Word ) + "а"
      110         .
      111       end.
      112       if substring( Formatted, II, 1 ) = "2" or
      113          substring( Formatted, II, 1 ) = "3" or
      114          substring( Formatted, II, 1 ) = "4"
      115       then do:
      116         if II = 12
      117         then do:
      118           if substring( Formatted, II - 1, 1 ) <> "1"
      119           then do:
      120             assign
      121               Word = trim( Word ) + "и"
      122             .
      123           end.
      124         end.
      125         else do:
      126           if substring( Formatted, II - 1, 1 ) <> "1"
      127           then do:
      128             assign
      129               Word = trim( Word ) + "а"
      130             .
      131           end.
      132         end.
      133       end.
      134       if ( substring( Formatted, II,     1 ) <> "1" and
      135            substring( Formatted, II,     1 ) <> "2" and
      136            substring( Formatted, II,     1 ) <> "3" and
      137            substring( Formatted, II,     1 ) <> "4" and II <> 12 ) or
      138          ( substring( Formatted, II - 1, 1 )  = "1" and II <  12 )
      139       then do:
      140         assign
      141           Word = trim( Word ) + "ов"
      142         .
      143       end.
      144       if Word <> "":U
      145       then do:
      146         assign
      147           OutSum = trim( Word ) + " ":U + trim( OutSum )
      148         .
      149       end.
      150     end.
      151     if substring( Formatted, II - 1, 1 ) <> "1"
      152     then do:
      153   assign
      154     Word = "":U
      155   .
      156   case substring( Formatted, II, 1 ) :
      157     when "0" then do:
      158       assign
      159         Word = " "
      160       .
      161     end.
      162     when "1" then do:
      163       assign
      164         Word = "один   "
      165       .
      166     end.
      167     when "2" then do:
      168       assign
      169         Word = "два   "
      170       .
      171     end.
      172     when "3" then do:
      173       assign
      174         Word = "три   "
      175       .
      176     end.
      177     when "4" then do:
      178       assign
      179         Word = "четыре   "
      180       .
      181     end.
      182     when "5" then do:
      183       assign
      184         Word = "пять   "
      185       .
      186     end.
      187     when "6" then do:
      188       assign
      189         Word = "шесть   "
      190       .
      191     end.
      192     when "7" then do:
      193       assign
      194         Word = "семь   "
      195       .
      196     end.
      197     when "8" then do:
      198       assign
      199         Word = "восемь   "
      200       .
      201     end.
      202     when "9" then do:
      203       assign
      204         Word = "девять   "
      205       .
      206     end.
      207   end case.
      208       if II                            = 12  and
      209          substring( Formatted, II, 1 ) = "1"
      210       then do:
      211         assign
      212           Word = "одна   "
      213         .
      214       end.
      215       if II                            = 12  and
      216          substring( Formatted, II, 1 ) = "2"
      217       then do:
      218         assign
      219           Word = "две    "
      220         .
      221       end.
      222       if Word <> "":U
      223       then do:
      224         assign
      225           OutSum = trim( Word ) + " ":U + trim( OutSum )
      226         .
      227       end.
      228       assign
      229         II = II - 1
      230       .
      231   assign
      232     Word = "":U
      233   .
      234   case substring( Formatted, II, 1 ) :
      235     when "0" then do:
      236       assign
      237         Word = " "
      238       .
      239     end.
      240     when "1" then do:
      241       assign
      242         Word = " "
      243       .
      244     end.
      245     when "2" then do:
      246       assign
      247         Word = "двадцать   "
      248       .
      249     end.
      250     when "3" then do:
      251       assign
      252         Word = "тридцать    "
      253       .
      254     end.
      255     when "4" then do:
      256       assign
      257         Word = "сорок   "
      258       .
      259     end.
      260     when "5" then do:
      261       assign
      262         Word = "пятьдесят   "
      263       .
      264     end.
      265     when "6" then do:
      266       assign
      267         Word = "шестьдесят   "
      268       .
      269     end.
      270     when "7" then do:
      271       assign
      272         Word = "семьдесят   "
      273       .
      274     end.
      275     when "8" then do:
      276       assign
      277         Word = "восемьдесят   "
      278       .
      279     end.
      280     when "9" then do:
      281       assign
      282         Word = "девяносто   "
      283       .
      284     end.
      285   end case.
      286     end.
      287     else do:
      288   assign
      289     Word = "":U
      290   .
      291   case substring( Formatted, II, 1 ) :
      292     when "0" then do:
      293       assign
      294         Word = "десять   "
      295       .
      296     end.
      297     when "1" then do:
      298       assign
      299         Word = "одиннадцать   "
      300       .
      301     end.
      302     when "2" then do:
      303       assign
      304         Word = "двенадцать   "
      305       .
      306     end.
      307     when "3" then do:
      308       assign
      309         Word = "тринадцать   "
      310       .
      311     end.
      312     when "4" then do:
      313       assign
      314         Word = "четырнадцать   "
      315       .
      316     end.
      317     when "5" then do:
      318       assign
      319         Word = "пятнадцать   "
      320       .
      321     end.
      322     when "6" then do:
      323       assign
      324         Word = "шестнадцать   "
      325       .
      326     end.
      327     when "7" then do:
      328       assign
      329         Word = "семнадцать   "
      330       .
      331     end.
      332     when "8" then do:
      333       assign
      334         Word = "восемнадцать   "
      335       .
      336     end.
      337     when "9" then do:
      338       assign
      339         Word = "девятнадцать   "
      340       .
      341     end.
      342   end case.
      343       assign
      344         II = II - 1
      345       .
      346     end.
      347     if Word <> "":U
      348     then do:
      349       assign
      350         OutSum = trim( Word ) + " ":U + trim( OutSum )
      351       .
      352     end.
      353     assign
      354       II = II - 1
      355     .
      356   assign
      357     Word = "":U
      358   .
      359   case substring( Formatted, II, 1 ) :
      360     when "0" then do:
      361       assign
      362         Word = " "
      363       .
      364     end.
      365     when "1" then do:
      366       assign
      367         Word = "сто         "
      368       .
      369     end.
      370     when "2" then do:
      371       assign
      372         Word = "двести         "
      373       .
      374     end.
      375     when "3" then do:
      376       assign
      377         Word = "триста         "
      378       .
      379     end.
      380     when "4" then do:
      381       assign
      382         Word = "четыреста          "
      383       .
      384     end.
      385     when "5" then do:
      386       assign
      387         Word = "пятьсот          "
      388       .
      389     end.
      390     when "6" then do:
      391       assign
      392         Word = "шестьсот         "
      393       .
      394     end.
      395     when "7" then do:
      396       assign
      397         Word = "семьсот         "
      398       .
      399     end.
      400     when "8" then do:
      401       assign
      402         Word = "восемьсот          "
      403       .
      404     end.
      405     when "9" then do:
      406       assign
      407         Word = "девятьсот          "
      408       .
      409     end.
      410   end case.
      411     if Word <> "":U
      412     then do:
      413       assign
      414         OutSum = trim( Word ) + " ":U + trim( OutSum )
      415       .
      416     end.
      417     assign
      418       II = II - 1
      419     .
      420   end.
