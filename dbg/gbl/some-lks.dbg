        1   DEFINE BUFFER X_who-lk FOR ub.who-lk.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-resource-id as character no-undo .
        6   define input  parameter p-lk-type as character no-undo .
        7   define input-output parameter p-rid-list as character no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Список who-lk".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   FUNCTION mark-string RETURNS CHARACTER
      369     ( input p-recid as recid, input mark-list as character  ) :
      370     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      371   END FUNCTION.
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373     define variable v-cntxt-db-num        as integer   no-undo .
      374     define variable v-cntxt-userid        as character no-undo .
      375     define variable v-cntxt-level         as character no-undo .
      376     define variable v-cntxt-host-code-obj as integer   no-undo .
      377     define variable v-cntxt-obj-type      as character no-undo .
      378     define variable v-cntxt-obj-code      as integer   no-undo .
      379     define variable v-cntxt-db-num-obj    as integer   no-undo .
      380     define variable v-cntxt-is-admin      as logical   no-undo .
      381   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   procedure gen-key-rec :
      383     define input  parameter p-tbl-name    as character no-undo.
      384     define input  parameter p-bh_tbl-name as handle    no-undo.
      385     define output parameter p-key-rec     as character no-undo.
      386     do
      387     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      388     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      389     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      390     :
      391       define variable fh               as handle    no-undo .
      392       define variable v-ok             as logical   no-undo .
      393       define variable v-inform         as character no-undo .
      394       define variable v-ind            as integer   no-undo .
      395       define variable v-idx-field-qnty as integer   no-undo .
      396       if p-tbl-name = ?
      397         or p-tbl-name = "":U
      398       then do:
      399         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      400       end.
      401       if not p-bh_tbl-name:available then do:
      402         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      403       end.
      404       assign
      405         p-key-rec = p-tbl-name
      406         v-inform  = p-bh_tbl-name:index-information(1)
      407         v-ind     = 2
      408       .
      409       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      410       on error undo, return error
      411       :
      412         assign
      413           v-inform = p-bh_tbl-name:index-information( v-ind )
      414           v-ind    = v-ind + 1
      415         .
      416       end.
      417       if v-inform = ?
      418         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      419         or entry( 3, v-inform, ",":U ) <> "1":U
      420       then do:
      421         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      422       end.
      423       else do:
      424         assign
      425           v-idx-field-qnty = num-entries( v-inform ) - 4
      426         .
      427         if v-idx-field-qnty < 2 then do:
      428           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      429         end.
      430         do v-ind = 1 to v-idx-field-qnty by 2
      431         on error undo, return error
      432         :
      433           assign
      434             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      435             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      436           .
      437         end.
      438       end.
      439       if p-key-rec = ? then do:
      440         assign
      441           p-key-rec = "":U
      442         .
      443         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      444       end.
      445     end.
      446     return.
      447   end procedure.
      448   procedure gen-where-keyr-tab :
      449     define input  parameter i-tableSerach as character no-undo.
      450     define input  parameter i-tablekey   as character  no-undo.
      451     define input  parameter p-key-rec    as character  no-undo.
      452     define input  parameter p-key-handle as handle     no-undo .
      453     define input  parameter p-db-name    as character  no-undo .
      454     define input  parameter p-tt-handle  as handle     no-undo .
      455     define output parameter o-Where      as character  no-undo.
      456     do
      457     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      458     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      459     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      460     :
      461       define variable v-full-tbl-name  as character no-undo .
      462       define variable bh_tbl-name      as handle    no-undo .
      463       define variable fh_key           as handle    no-undo .
      464       define variable fh_search        as handle    no-undo .
      465       define variable v-field-num      as integer   no-undo .
      466       define variable v-count-fld      as integer   no-undo .
      467       define variable v-inform         as character no-undo .
      468       define variable v-ind            as integer   no-undo .
      469       define variable v-idx-field-qnty as integer   no-undo .
      470       define variable v-field-name     as character no-undo .
      471       define variable v-field-val      as character no-undo .
      472       define variable v-word-link      as character no-undo .
      473       define variable vTable           as character no-undo.
      474       define variable bh_tbl-key       as handle    no-undo .
      475       assign
      476         p-key-rec = trim( p-key-rec )
      477       .
      478       if p-key-handle <> ? then do:
      479         if not valid-handle(p-key-handle)
      480            or p-key-handle:type <> "buffer"
      481         then do:
      482           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      483         end.
      484         if num-entries( p-key-rec, chr(3) ) > 1
      485           or p-key-rec = ?
      486           or p-key-rec = "":U
      487         then do:
      488           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      489         end.
      490       end.
      491       else do:
      492         if p-key-rec = ?
      493           or p-key-rec = "":U
      494         then do:
      495           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      496         end.
      497       end.
      498       assign
      499         vTable = entry( 1 , p-key-rec, chr(3) )
      500       .
      501       if p-tt-handle <> ?
      502         and ( not valid-handle(p-tt-handle)
      503               or p-tt-handle:type <> "buffer"
      504             )
      505       then do:
      506         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      507       end.
      508       if p-tt-handle = ? then do:
      509         assign
      510           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      511         .
      512         create buffer bh_tbl-name for table v-full-tbl-name .
      513       end.
      514       else do:
      515         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      516       end.
      517       assign
      518         v-inform = bh_tbl-name:index-information(1)
      519         v-ind    = 2
      520       .
      521       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      522       on error undo, return error
      523       :
      524         assign
      525           v-inform = bh_tbl-name:index-information( v-ind )
      526           v-ind    = v-ind + 1
      527         .
      528       end.
      529       if v-inform = ?
      530         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      531         or entry( 3, v-inform, ",":U ) <> "1":U
      532       then do:
      533         delete object bh_tbl-name no-error.
      534         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      535       end.
      536       assign
      537         v-idx-field-qnty = num-entries( v-inform ) - 4
      538       .
      539       if v-idx-field-qnty < 2 then do:
      540         delete object bh_tbl-name no-error.
      541         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      542       end.
      543       assign
      544         o-where     = "where":U
      545         v-word-link = "":U
      546         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      547         v-count-fld = 0
      548       .
      549       if i-tablekey ne "" and i-tablekey ne ?
      550       then do:
      551         assign
      552           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      553         .
      554         create buffer bh_tbl-key for table v-full-tbl-name .
      555       end.
      556       if i-tableSerach ne "" and i-tableSerach ne ?
      557       then do:
      558         delete object bh_tbl-name no-error.
      559         assign
      560           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      561         .
      562         create buffer bh_tbl-name for table v-full-tbl-name .
      563       end.
      564       block_where:
      565       do v-ind = 1 to v-idx-field-qnty by 2
      566       on error undo, return error
      567       :
      568         assign
      569           v-count-fld = v-count-fld + 1
      570         .
      571         if p-key-handle = ?
      572           and v-count-fld > v-field-num
      573         then do:
      574           leave block_where.
      575         end.
      576         define variable VfieldKeyTable as handle no-undo.
      577         assign
      578           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      579           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      580         .
      581         if     bh_tbl-key ne ?
      582         then do:
      583            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      584            if VfieldKeyTable eq ?
      585            then next block_where.
      586         end.
      587         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      588         then
      589            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      590         else
      591            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      592         if p-key-handle = ? then do:
      593           assign
      594             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      595           .
      596         end.
      597         else do:
      598           assign
      599             fh_key = p-key-handle:buffer-field( v-field-name )
      600           .
      601           if fh_key = ?
      602             or not valid-handle( fh_key )
      603           then do:
      604             delete object bh_tbl-name.
      605             if     bh_tbl-key ne ?
      606             then
      607                delete object bh_tbl-key.
      608             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      609           end.
      610           assign
      611             v-field-val = fh_key:buffer-value
      612           .
      613         end.
      614         if fh_search:data-type ="character":U then do:
      615           assign
      616             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      617             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      618             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      619             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      620             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      621             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      622             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      623             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      624             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      625             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      626             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      627             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      628             v-field-val = substitute( '"&1"', v-field-val )
      629           .
      630         end.
      631         assign
      632           o-where = substitute( "&1 &2", o-where, v-field-val )
      633         .
      634         if v-word-link = "":U then do:
      635           assign
      636             v-word-link = "and":U
      637           .
      638         end.
      639       end.
      640       delete object bh_tbl-name.
      641       if     bh_tbl-key ne ?
      642       then
      643          delete object bh_tbl-key.
      644       if p-key-handle = ?
      645         and v-count-fld <> v-field-num
      646       then do:
      647         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      648       end.
      649     end.
      650   end procedure.
      651   procedure gen-hn-keyr-tab :
      652     define input  parameter i-tableSerach as character no-undo.
      653     define input  parameter i-tablekey   as character no-undo.
      654     define input  parameter p-key-rec    as character no-undo.
      655     define input  parameter p-key-handle as handle    no-undo .
      656     define input  parameter p-db-name    as character no-undo .
      657     define input  parameter p-tt-handle  as handle    no-undo .
      658     define input  parameter p-stts-lock  as integer   no-undo .
      659     define output parameter o-hn         as handle    no-undo.
      660     define variable v-full-tbl-name as character no-undo.
      661     define variable v-where         as character no-undo.
      662     define variable bh_tbl-name     as handle    no-undo.
      663     define variable vTable          as character no-undo.
      664     do
      665     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      666     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      667     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      668         run gen-where-keyr-tab(i-tableSerach,
      669                                i-tablekey,
      670                                p-key-rec,
      671                                p-key-handle,
      672                                p-db-name,
      673                                p-tt-handle,
      674                                output v-where).
      675         if i-tableSerach ne "" and i-tableSerach ne ?
      676         then do:
      677            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      678            create buffer bh_tbl-name for table v-full-tbl-name .
      679         end.
      680         else do:
      681            if p-tt-handle = ? then do:
      682               assign
      683                  vTable = entry( 1 , p-key-rec, chr(3) )
      684               .
      685               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      686               create buffer bh_tbl-name for table v-full-tbl-name .
      687            end.
      688            else do:
      689               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      690            end.
      691         end.
      692         if p-tt-handle = ? then do:
      693            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      694         end.
      695         else do:
      696            bh_tbl-name:find-first( v-where ) no-error .
      697         end.
      698         o-hn = bh_tbl-name.
      699      end.
      700   end procedure.
      701   procedure gen-hn-keyr :
      702     define input  parameter p-key-rec    as character no-undo.
      703     define input  parameter p-key-handle as handle    no-undo .
      704     define input  parameter p-db-name    as character no-undo .
      705     define input  parameter p-tt-handle  as handle    no-undo .
      706     define input  parameter p-stts-lock  as integer   no-undo .
      707     define output parameter o-hn         as handle    no-undo.
      708     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      709   end.
      710   procedure gen-row-keyr :
      711     define input  parameter p-key-rec    as character no-undo.
      712     define input  parameter p-key-handle as handle    no-undo .
      713     define input  parameter p-db-name    as character no-undo .
      714     define input  parameter p-tt-handle  as handle    no-undo .
      715     define input  parameter p-stts-lock  as integer   no-undo .
      716     define output parameter p-tbl-row    as rowid     no-undo.
      717     define output parameter p-tbl-name   as character no-undo.
      718     define variable vHn as handle no-undo.
      719       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      720       p-tbl-row = if vHn:available then vHn:rowid else ?.
      721       p-tbl-name =  vHn:table.
      722       delete object vHn no-error.
      723     if p-tbl-row = ? then do:
      724       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      725     end.
      726     else do:
      727       return.
      728     end.
      729   end procedure.
      730   procedure gen-key-fv :
      731     define input  parameter p-key-rec    as character no-undo .
      732     define output parameter p-field-list as character no-undo .
      733     define output parameter p-value-list as character no-undo.
      734     do
      735     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      736     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      737     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      738     :
      739       define variable v-full-tbl-name  as character no-undo .
      740       define variable bh_tbl-name      as handle    no-undo .
      741       define variable v-tbl-name       as character no-undo .
      742       define variable v-field-num      as integer   no-undo .
      743       define variable v-count-fld      as integer   no-undo .
      744       define variable v-inform         as character no-undo .
      745       define variable v-ind            as integer   no-undo .
      746       define variable v-idx-field-qnty as integer   no-undo .
      747       define variable v-delim-key      as character no-undo .
      748       if p-key-rec = ?
      749         or p-key-rec = "":U
      750       then do:
      751         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      752       end.
      753       assign
      754         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      755         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      756       .
      757       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      758       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      759       assign
      760         v-inform = bh_tbl-name:index-information(1)
      761         v-ind    = 2
      762       .
      763       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      764       on error undo, return error
      765       :
      766         assign
      767           v-inform = bh_tbl-name:index-information( v-ind )
      768           v-ind    = v-ind + 1
      769         .
      770       end.
      771       if v-inform = ?
      772         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      773         or entry( 3, v-inform, ",":U ) <> "1":U
      774       then do:
      775         delete object bh_tbl-name no-error.
      776         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      777       end.
      778       assign
      779         v-idx-field-qnty = num-entries( v-inform ) - 4
      780       .
      781       if v-idx-field-qnty < 2 then do:
      782         delete object bh_tbl-name no-error.
      783         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      784       end.
      785       assign
      786         p-field-list = "":U
      787         p-value-list = "":U
      788         v-delim-key  = "":U
      789         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      790         v-count-fld  = 0
      791       .
      792       block_where:
      793       do v-ind = 1 to v-idx-field-qnty by 2
      794       on error undo, return error
      795       :
      796         assign
      797           v-count-fld = v-count-fld + 1
      798         .
      799         if v-count-fld > v-field-num then do:
      800           leave block_where.
      801         end.
      802         assign
      803           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      804           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      805         .
      806         if v-ind = 1 then do:
      807           assign
      808             v-delim-key = chr(3)
      809           .
      810         end.
      811       end.
      812       delete object bh_tbl-name.
      813       if v-count-fld <> v-field-num then do:
      814         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      815       end.
      816     end.
      817   end procedure.
      818   procedure gen-key-field :
      819     define input  parameter p-table      as character no-undo .
      820     define output parameter p-field-list as character no-undo .
      821     do
      822     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      823     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      824     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      825     :
      826       define variable v-full-tbl-name  as character no-undo .
      827       define variable bh_tbl-name      as handle    no-undo .
      828       define variable v-tbl-name       as character no-undo .
      829       define variable v-field-num      as integer   no-undo .
      830       define variable v-count-fld      as integer   no-undo .
      831       define variable v-inform         as character no-undo .
      832       define variable v-ind            as integer   no-undo .
      833       define variable v-idx-field-qnty as integer   no-undo .
      834       define variable v-delim-key      as character no-undo .
      835       if p-table = ?
      836         or p-table = "":U
      837       then do:
      838         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      839       end.
      840       assign
      841         v-tbl-name      = p-table
      842         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      843       .
      844       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      845       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      846       assign
      847         v-inform = bh_tbl-name:index-information(1)
      848         v-ind    = 2
      849       .
      850       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      851       on error undo, return error
      852       :
      853         assign
      854           v-inform = bh_tbl-name:index-information( v-ind )
      855           v-ind    = v-ind + 1
      856         .
      857       end.
      858       if v-inform = ?
      859         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      860         or entry( 3, v-inform, ",":U ) <> "1":U
      861       then do:
      862         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      863       end.
      864       assign
      865         v-idx-field-qnty = num-entries( v-inform ) - 4
      866       .
      867       if v-idx-field-qnty < 2 then do:
      868         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      869       end.
      870       assign
      871         p-field-list = "":U
      872         v-delim-key  = "":U
      873         v-count-fld  = 0
      874       .
      875       block_where:
      876       do v-ind = 1 to v-idx-field-qnty by 2
      877       on error undo, return error
      878       :
      879         assign
      880           v-count-fld = v-count-fld + 1
      881         .
      882         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      883         if v-ind = 1 then do:
      884           assign
      885             v-delim-key = chr(3)
      886           .
      887         end.
      888       end.
      889       delete object bh_tbl-name.
      890     end.
      891   end procedure.
      892   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   FUNCTION get-region RETURNS CHARACTER
      896     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      897     define variable par-region as character no-undo.
      898     if parhost-code = 0 and
      899          parobj-type = "":U and
      900          parobj-code = 0 then do:
      901          par-region = "Глобально".
      902          return par-region.
      903       end.
      904       if parobj-type = 'орг':U then do:
      905          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      906          return par-region.
      907       end.
      908       if parobj-type = 'регион':U
      909       then do:
      910          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      911          return par-region.
      912       end.
      913       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      914       return par-region.
      915   END FUNCTION.
      916   FUNCTION get-objregion RETURNS CHARACTER
      917     (  input parobj-type as character, input parobj-code as integer ) :
      918     define variable par-region as character no-undo.
      919     if  parobj-type = "":U and
      920         parobj-code = 0
      921     then do:
      922        par-region = "Глобально".
      923     end.
      924     else if parobj-type = 'орг':U
      925     then do:
      926        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      927     end.
      928     else if parobj-type = 'регион':U
      929     then do:
      930        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      931     end.
      932     else
      933        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      934     return par-region.
      935   END FUNCTION.
      936   FUNCTION calldscr returns character ( input p-call-id as character):
      937   define variable v-descr as character no-undo .
      938   define variable v-field-list as character no-undo .
      939   define variable v-value-list as character no-undo.
      940   define variable v-prop-label as character no-undo .
      941   define variable v-node-label as character no-undo .
      942   define variable v-dt-code as integer no-undo .
      943   define variable v-host-code as integer no-undo .
      944   define variable v-obj-type as character no-undo .
      945   define variable v-obj-code as integer no-undo .
      946   define variable v-label as character no-undo .
      947   define variable v-node-code as integer no-undo .
      948   define buffer buf_prop-head for ub.prop-head.
      949   define buffer buf_prop-ref for ub.prop-ref.
      950   define buffer buf_prop-map for ub.prop-map.
      951   run gen-key-fv in this-procedure ( input p-call-id
      952                                     ,output v-field-list
      953                                     ,output v-value-list) no-error .
      954   if error-status:error then return p-call-id.
      955   CASE entry(1, p-call-id, chr(3)):
      956     when 'dis-card-type':U then do:
      957       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      958                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      959                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      960                            ).
      961     end.
      962     when 'dis-card':U then do:
      963       v-descr = substitute("ДК: № &1"
      964                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      965                            ).
      966     end.
      967     when 'dis-card-property':U then do:
      968       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      969       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      970       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      971       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      972       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      973       find first buf_prop-ref no-lock where
      974                 buf_prop-ref.dt-code = v-dt-code no-error .
      975       if available buf_prop-ref then do:
      976         find first buf_prop-head no-lock where
      977                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      978         v-prop-label = buf_prop-head.prop-label.
      979         find first buf_prop-map no-lock where
      980                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      981               and buf_prop-map.node-code = v-node-code no-error .
      982         if available buf_prop-map then do:
      983           v-label = buf_prop-map.node-label.
      984         end.
      985       end.
      986       v-descr = substitute("ДК: № &1 &2:&3 &4"
      987                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      988                            ,v-prop-label
      989                            ,v-label
      990                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      991                            ).
      992     end.
      993     when 'clients':U then do:
      994       v-descr = substitute("&1&2"
      995                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      996                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      997                            ).
      998     end.
      999     when 'ext-system':U then do:
     1000       v-descr = substitute("Внешняя система &1"
     1001                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1002                            ).
     1003     end.
     1004     WHEN 'thbj-attr':U then do:
     1005       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1006       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1007       then do:
     1008         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1009           v-descr = "Операции с товарами".
     1010         end.
     1011         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1012           v-descr = "Операции с клиентами".
     1013         end.
     1014         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1015           v-descr = "Операции с группами товаров".
     1016         end.
     1017         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1018           v-descr = "Операции с группами клиентов".
     1019         end.
     1020         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1021           v-descr = "Операции с чеками на POS IBS-TH".
     1022         end.
     1023         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1024           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1025         end.
     1026         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1027           v-descr = "Операции в системе электронного документооборота".
     1028         end.
     1029         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1030           v-descr = "Операции со справочниками".
     1031         end.
     1032         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1033           v-descr = "Операции с ДНЦ и переоценками".
     1034         end.
     1035         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1036           v-descr = "Отчеты".
     1037         end.
     1038         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1039           v-descr = "Операции с заказами".
     1040         end.
     1041       end.
     1042     end.
     1043     when 'cash-desk':U then do:
     1044       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1045                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1046                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1047                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1048                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1049                            ).
     1050     end.
     1051     when 'ext-file':U then do:
     1052       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1053                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1054                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1055                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1056                            ).
     1057     end.
     1058   end case.
     1059   return v-descr.
     1060   end function.
     1061   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1062   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
     1063   define variable v-rid-list as character no-undo .
     1064   define variable v-resource-descr as character no-undo .
     1065   DEFINE BUTTON B-Help
     1066        LABEL "Помо&щь"
     1067        SIZE 3 BY 1
     1068        BGCOLOR 8 .
     1069   DEFINE BUTTON b-mark
     1070        LABEL "&*"
     1071        SIZE 4 BY 1.
     1072   DEFINE BUTTON b-quit AUTO-END-KEY
     1073        LABEL "&Выход"
     1074        SIZE 10 BY 1
     1075        BGCOLOR 8 .
     1076   DEFINE BUTTON b-sel AUTO-GO
     1077        LABEL "Выбор"
     1078        SIZE 10 BY 1.
     1079   DEFINE VARIABLE E-ps AS CHARACTER
     1080        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1081        SIZE 97 BY 2.88 NO-UNDO.
     1082   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1083         VIEW-AS TEXT
     1084        SIZE 9 BY .67
     1085        FGCOLOR 10  NO-UNDO.
     1086   DEFINE QUERY br-who-lk FOR
     1087         X_who-lk SCROLLING.
     1088   DEFINE BROWSE br-who-lk
     1089    QUERY br-who-lk DISPLAY
     1090         mark-string(recid(X_who-lk), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1091   X_who-lk.resource_id COLUMN-LABEL "ID" FORMAT "X(40)"
     1092   entry (lookup (X_who-lk.lk-type, 'update-delete':U) + 1, ',' + 'Изменение/Удаление':U) COLUMN-LABEL "Блокирование на" FORMAT "X(20)"
     1093   X_who-lk.lk-mess COLUMN-LABEL "Пользователь" FORMAT "X(255)" WIDTH 80
     1094       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.54 FIT-LAST-COLUMN.
     1095   DEFINE FRAME Dialog-Frame
     1096        b-quit AT ROW 1 COL 1
     1097        b-mark AT ROW 1 COL 20 WIDGET-ID 12
     1098        b-sel AT ROW 1 COL 24 WIDGET-ID 10
     1099        B-Help AT ROW 1 COL 95
     1100        br-who-lk AT ROW 2.33 COL 1.5 WIDGET-ID 100
     1101        E-ps AT ROW 20 COL 1.5 NO-LABEL WIDGET-ID 16
     1102        mark-num AT ROW 1 COL 11 NO-LABEL WIDGET-ID 14
     1103        SPACE(78.50) SKIP(21.20)
     1104       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1105            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1106            TITLE ""
     1107            CANCEL-BUTTON b-quit.
     1108   ASSIGN
     1109          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1110          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1111   ON GO OF FRAME Dialog-Frame
     1112   DO:
     1113     p-rid-list = v-rid-list.
     1114   END.
     1115   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1116   DO:
     1117     APPLY "END-ERROR":U TO SELF.
     1118   END.
     1119   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1120   DO:
     1121       define variable glog as logical no-undo .
     1122     if available X_who-lk then do:
     1123   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   define variable v-str-recid8 as character no-undo .
     1125   define variable v-num-entry8 as integer   no-undo .
     1126   assign
     1127     v-str-recid8 = trim( string( recid( X_who-lk ) , "->>>>>>>>>>>9":U ) )
     1128     v-num-entry8 = lookup( v-str-recid8 , v-rid-list )
     1129   .
     1130   if v-num-entry8 > 0 then do:
     1131     assign
     1132       entry( v-num-entry8, v-rid-list ) = "":U
     1133       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1134     .
     1135   end.
     1136   else do:
     1137     assign
     1138       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid8
     1139     .
     1140   end.
     1141     glog = br-who-lk:refresh() .
     1142     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1143         glog = br-who-lk:select-next-row ().
     1144         apply "VALUE-CHANGED" to br-who-lk in frame Dialog-Frame.
     1145     end.
     1146     if num-entries( v-rid-list ) = 0
     1147     then
     1148         hide mark-num in frame Dialog-Frame.
     1149     else
     1150         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1151   end.
     1152   apply "entry" to br-who-lk in frame Dialog-Frame.
     1153   END.
     1154   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1155   DO:
     1156     if available X_who-lk then do:
     1157       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1158       then  v-rid-list = string( recid( X_who-lk ) ) .
     1159     end.
     1160   END.
     1161   ON VALUE-CHANGED OF br-who-lk IN FRAME Dialog-Frame
     1162   DO:
     1163     if available X_who-lk then do:
     1164        e-ps:screen-value in frame Dialog-Frame = X_who-lk.ps.
     1165     end.
     1166     else do:
     1167        e-ps:screen-value in frame Dialog-Frame = "".
     1168     end.
     1169   END.
     1170   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1171   on f5 of frame Dialog-Frame anywhere
     1172   do:
     1173      v-doc-rec = recid(X_who-lk).    RUn OpenBR in this-procedure.  REPOSITION br-who-lk to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-who-lk.
     1174       apply "VALUE-CHANGED" to br-who-lk.
     1175   end.
     1176   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   on help of frame Dialog-Frame
     1178   do:
     1179     run gbl/app_help.p
     1180       (input this-procedure :file-name
     1181       ,input ''
     1182       ,input ?
     1183       ) no-error.
     1184     if error-status :error then do:
     1185       message
     1186         "Ошибка при вызове помощи"
     1187         error-status :get-message(1)
     1188         view-as alert-box .
     1189     end.
     1190   end.
     1191   run minbtn-set in this-procedure .
     1192   on choose of b-help in frame Dialog-Frame
     1193   do:
     1194     apply "help":u to frame Dialog-Frame .
     1195   end.
     1196   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1197   procedure minbtn-set :
     1198       do
     1199           on error undo, return error return-value
     1200           :
     1201           define variable ii              as integer       no-undo .
     1202           define variable fh              as widget-handle no-undo .
     1203           define variable hh              as widget-handle no-undo .
     1204           define variable v-h             as handle        extent 4 no-undo .
     1205           define variable v-name-button   as character     no-undo .
     1206           define variable v-help-old-x    as decimal       no-undo .
     1207           define variable v-help-old-y    as decimal       no-undo .
     1208           define variable v-help-old-size as decimal       no-undo .
     1209           define variable v-frame-width   as decimal       no-undo .
     1210           define variable jj              as integer       no-undo .
     1211           do
     1212               on error undo, return error
     1213               :
     1214               assign
     1215                   v-frame-width = frame Dialog-Frame:width - 0.3
     1216                   fh            = frame Dialog-Frame:first-child
     1217                   hh            = fh:first-child
     1218                   ii            = 1
     1219                   .
     1220               do while valid-handle(hh):
     1221                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1222                   do:
     1223                       case lc(hh:name) :
     1224                           when "b-help" then
     1225                               do:
     1226                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1227                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1228                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1229                                   hh:TOOLTIP = "Помощь" .
     1230                                   v-help-old-x = hh:column .
     1231                                   v-help-old-y = hh:row    .
     1232                                   v-help-old-size = hh:width .
     1233                                   hh:width-chars = 2.5 .
     1234                               end.
     1235                           when "b-print" then
     1236                               do:
     1237                                   hh:load-image("cmp/b-print.bmp":u) .
     1238                                   hh:TOOLTIP = "Печать" .
     1239                                   v-h[ii] = hh:handle .
     1240                                   ii = ii + 1 .
     1241                                   hh:width-chars = 3 .
     1242                               end.
     1243                           when "b-history" or
     1244                           when "b-hist" then
     1245                               do:
     1246                                   hh:load-image("cmp/b-hist.bmp":u) .
     1247                                   hh:TOOLTIP = "История" .
     1248                                   v-h[ii] = hh:handle .
     1249                                   ii = ii + 1 .
     1250                                   hh:width-chars = 3 .
     1251                               end.
     1252                           when "b-sch" then
     1253                               do:
     1254                                   hh:load-image("cmp/b-sch.bmp":u) .
     1255                                   hh:TOOLTIP = "Установка Фильтра" .
     1256                                   v-h[ii] = hh:handle .
     1257                                   ii = ii + 1 .
     1258                                   hh:width-chars = 3 .
     1259                               end.
     1260                           when "b-hist-user" then
     1261                               do:
     1262                                   hh:load-image("cmp/b-hist.bmp":u) .
     1263                                   hh:TOOLTIP = "История пользователя" .
     1264                                   ii = ii + 1 .
     1265                               end.
     1266                       end case.
     1267                   end.
     1268                   hh = hh:next-sibling.
     1269               end.
     1270               b-help:column = v-frame-width - b-help:width-chars.
     1271               jj = 0.
     1272               repeat ii = 4 to 1 by -1 :
     1273                   if valid-handle (v-h[ii] ) then
     1274                   do:
     1275                       jj  = jj + 1 .
     1276                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1277                       v-h[ii]:row    = v-help-old-y .
     1278                   end.
     1279               end.
     1280           end.
     1281       end.
     1282   end procedure.
     1283   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1284   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1285   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1286   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1287   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1288   define variable v-diasize-current-frame-height as decimal   no-undo .
     1289   define variable v-diasize-change-size          as logical   no-undo .
     1290   define variable v-diasize-resize-button        as handle    no-undo .
     1291   define variable v-diasize-wndmax               as logical   no-undo .
     1292   define variable v-diasize-wndstore             as logical   no-undo .
     1293   define variable v-diasize-proc-name            as character no-undo .
     1294   define variable v-diasize-browse-handle        as handle    no-undo .
     1295   define variable v-diasize-browse-number        as integer   no-undo .
     1296   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1297   define temp-table temp-diasize-handle no-undo
     1298     field handle-value  as handle
     1299     field save-position as decimal
     1300     index xpk is primary unique handle-value
     1301     .
     1302   define temp-table temp-browse-handle no-undo
     1303     field browse-type   as character
     1304     field browse-number as integer
     1305     field browse-handle as handle
     1306     field original-size as decimal
     1307     index xpk is primary unique browse-type browse-number
     1308     index xie browse-type browse-handle
     1309   .
     1310   procedure diasize_change-height :
     1311     define input  parameter p-change-value  as decimal   no-undo .
     1312     define input  parameter p-move-resize   as logical   no-undo .
     1313     define variable v-field-group-handle    as handle    no-undo .
     1314     define variable v-object-handle         as handle    no-undo .
     1315     define variable v-frame-height          as decimal   no-undo .
     1316     define variable v-frame-virtual-height  as decimal   no-undo .
     1317     define variable v-browse-height         as decimal   no-undo .
     1318     define variable v-window-height         as decimal   no-undo .
     1319     define variable v-window-virtual-height as decimal   no-undo .
     1320     define variable v-change-sign           as integer   no-undo .
     1321     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1322     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1323     if p-change-value > 0
     1324     then do:
     1325       if frame Dialog-Frame :height + p-change-value
     1326           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1327       then do:
     1328         assign
     1329           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1330                           - (frame Dialog-Frame :height-chars)
     1331         .
     1332         if p-change-value <= 0
     1333         then do:
     1334           run diasize_position-resize-button in this-procedure .
     1335           return .
     1336         end.
     1337       end.
     1338     end.
     1339     if p-change-value < 0
     1340     then do:
     1341       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1342       then do:
     1343         assign
     1344           p-change-value = v-diasize-orig-frame-height
     1345                          - (frame Dialog-Frame :height-chars)
     1346         .
     1347         if p-change-value >= 0
     1348         then do:
     1349           run diasize_position-resize-button in this-procedure .
     1350           return .
     1351         end.
     1352       end.
     1353     end.
     1354     if p-change-value >= 0
     1355     then do:
     1356       assign
     1357         v-change-sign = 1
     1358       .
     1359     end.
     1360     else do:
     1361       assign
     1362         v-change-sign = -1
     1363       .
     1364     end.
     1365     assign
     1366       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1367     .
     1368     if p-change-value = 0
     1369     then do:
     1370       run diasize_position-resize-button in this-procedure .
     1371       return .
     1372     end.
     1373     move_block:
     1374     do
     1375     on error undo move_block, retry move_block
     1376     :
     1377       if retry
     1378       then do:
     1379         do
     1380         on error undo move_block, leave move_block
     1381         :
     1382           if p-change-value > 0
     1383           then do:
     1384             for each buf_temp-diasize-handle
     1385             on error undo, next
     1386             :
     1387               assign
     1388                 v-object-handle = buf_temp-diasize-handle.handle-value
     1389               .
     1390               if v-object-handle <> v-diasize-resize-button
     1391               then do:
     1392                 assign
     1393                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1394                 .
     1395               end.
     1396             end.
     1397             assign
     1398               v-diasize-browse-handle :height = v-browse-height
     1399             .
     1400             for each buf_temp-browse-handle
     1401               where buf_temp-browse-handle.browse-type = 'height':u
     1402             on error undo, next
     1403             :
     1404               assign
     1405                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1406               .
     1407             end.
     1408             assign
     1409               frame Dialog-Frame :height = v-frame-height
     1410             .
     1411             if frame Dialog-Frame :scrollable = true
     1412             then do:
     1413               assign
     1414                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1415               .
     1416             end.
     1417             run diasize_position-resize-button in this-procedure .
     1418           end.
     1419           else do:
     1420             if frame Dialog-Frame :scrollable = true
     1421             then do:
     1422               assign
     1423                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1424               .
     1425             end.
     1426             assign
     1427               frame Dialog-Frame :height = v-frame-height
     1428             .
     1429             assign
     1430               v-diasize-browse-handle :height = v-browse-height
     1431             .
     1432             for each buf_temp-browse-handle
     1433               where buf_temp-browse-handle.browse-type = 'height':u
     1434             on error undo, next
     1435             :
     1436               assign
     1437                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1438               .
     1439             end.
     1440             for each buf_temp-diasize-handle
     1441             on error undo, next
     1442             :
     1443               assign
     1444                 v-object-handle = buf_temp-diasize-handle.handle-value
     1445               .
     1446               if v-object-handle <> v-diasize-resize-button
     1447               then do:
     1448                 assign
     1449                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1450                 .
     1451               end.
     1452             end.
     1453             run diasize_position-resize-button in this-procedure .
     1454           end.
     1455           assign
     1456             v-diasize-change-size = false
     1457           .
     1458           leave move_block .
     1459         end.
     1460       end.
     1461       assign
     1462         v-diasize-need-full-display = true
     1463       .
     1464       if v-diasize-change-size = false
     1465       then do:
     1466         assign
     1467           v-diasize-change-size = true
     1468         .
     1469       end.
     1470       else do:
     1471         return .
     1472       end.
     1473       assign
     1474         v-frame-height = frame Dialog-Frame :height
     1475         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1476         v-browse-height = v-diasize-browse-handle :height
     1477       .
     1478       for each buf_temp-browse-handle
     1479         where buf_temp-browse-handle.browse-type = 'height':u
     1480       :
     1481         assign
     1482           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1483         .
     1484       end.
     1485       for each buf_temp-diasize-handle
     1486       :
     1487         delete buf_temp-diasize-handle .
     1488       end.
     1489       assign
     1490         v-field-group-handle = frame Dialog-Frame :first-child
     1491       .
     1492       do while valid-handle(v-field-group-handle)
     1493       :
     1494         assign
     1495           v-object-handle = v-field-group-handle :first-child
     1496         .
     1497         do while valid-handle(v-object-handle)
     1498         :
     1499           if  v-object-handle <> v-diasize-browse-handle :handle
     1500           and can-query(v-object-handle, "row")
     1501           and can-query(v-object-handle, "height")
     1502           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1503           then do:
     1504             find first buf_temp-browse-handle
     1505               where buf_temp-browse-handle.browse-type   = 'height':u
     1506                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1507               no-error .
     1508             if available buf_temp-browse-handle
     1509             then do:
     1510             end.
     1511             else do:
     1512               create buf_temp-diasize-handle .
     1513               assign
     1514                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1515                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1516               .
     1517             end.
     1518           end.
     1519           assign
     1520             v-object-handle = v-object-handle :next-sibling
     1521           .
     1522         end.
     1523         assign
     1524           v-field-group-handle = v-field-group-handle :next-sibling
     1525         .
     1526       end.
     1527       do with frame Dialog-Frame
     1528       :
     1529         hide v-diasize-resize-button .
     1530         assign
     1531           v-diasize-resize-button :row    = 1
     1532           v-diasize-resize-button :column = 1
     1533         .
     1534       end.
     1535       if p-change-value > 0
     1536       then do:
     1537         if frame Dialog-Frame :scrollable = true
     1538         then do:
     1539           assign
     1540             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1541             no-error .
     1542           if error-status :error
     1543           or error-status :get-message(1) <> ""
     1544           then do:
     1545             undo move_block, retry move_block .
     1546           end.
     1547         end.
     1548         assign
     1549           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1550           no-error .
     1551         if error-status :error
     1552         or error-status :get-message(1) <> ""
     1553         then do:
     1554           undo move_block, retry move_block .
     1555         end.
     1556         assign
     1557           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1558           no-error .
     1559         if error-status :error
     1560         or error-status :get-message(1) <> ""
     1561         then do:
     1562           undo move_block, retry move_block .
     1563         end.
     1564         for each buf_temp-browse-handle
     1565           where buf_temp-browse-handle.browse-type = 'height':u
     1566         on error undo move_block, retry move_block
     1567         :
     1568           assign
     1569             buf_temp-browse-handle.browse-handle :height
     1570               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1571             no-error .
     1572           if error-status :error
     1573           or error-status :get-message(1) <> ""
     1574           then do:
     1575             undo move_block, retry move_block .
     1576           end.
     1577         end.
     1578         for each buf_temp-diasize-handle
     1579         on error undo move_block, retry move_block
     1580         :
     1581           assign
     1582             v-object-handle = buf_temp-diasize-handle.handle-value
     1583           .
     1584           if v-object-handle <> v-diasize-resize-button
     1585           then do:
     1586             assign
     1587               v-object-handle :row = v-object-handle :row + p-change-value
     1588               no-error .
     1589             if error-status :error
     1590             or error-status :get-message(1) <> ""
     1591             then do:
     1592               undo move_block, retry move_block .
     1593             end.
     1594           end.
     1595         end.
     1596       end.
     1597       else do:
     1598         for each buf_temp-diasize-handle
     1599         on error undo move_block, retry move_block
     1600         :
     1601           assign
     1602             v-object-handle = buf_temp-diasize-handle.handle-value
     1603           .
     1604           if v-object-handle <> v-diasize-resize-button
     1605           then do:
     1606             assign
     1607               v-object-handle :row = v-object-handle :row + p-change-value
     1608               no-error .
     1609             if error-status :error
     1610             or error-status :get-message(1) <> ""
     1611             then do:
     1612               undo move_block, retry move_block .
     1613             end.
     1614           end.
     1615         end.
     1616         assign
     1617           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1618           no-error .
     1619         if error-status :error
     1620         or error-status :get-message(1) <> ""
     1621         then do:
     1622           undo move_block, retry move_block .
     1623         end.
     1624         for each buf_temp-browse-handle
     1625           where buf_temp-browse-handle.browse-type = 'height':u
     1626         on error undo move_block, retry move_block
     1627         :
     1628           assign
     1629             buf_temp-browse-handle.browse-handle :height
     1630               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1631             no-error .
     1632           if error-status :error
     1633           or error-status :get-message(1) <> ""
     1634           then do:
     1635             undo move_block, retry move_block .
     1636           end.
     1637         end.
     1638         assign
     1639           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1640           no-error .
