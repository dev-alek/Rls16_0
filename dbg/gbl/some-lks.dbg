     1649             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1650             no-error .
     1651           if error-status :error
     1652           or error-status :get-message(1) <> ""
     1653           then do:
     1654             undo move_block, retry move_block .
     1655           end.
     1656         end.
     1657       end.
     1658       if p-move-resize = true
     1659       then do:
     1660         run diasize_position-resize-button in this-procedure .
     1661       end.
     1662       if v-diasize-wndstore = true
     1663       then do:
     1664         if connected("ub") = true
     1665         then do:
     1666           define variable v-cntxt-db-num        as integer   no-undo .
     1667           define variable v-cntxt-userid        as character no-undo .
     1668           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1669                                             , OUTPUT v-cntxt-userid
     1670                                             ) .
     1671           run gbl/wndsizew.p
     1672             (input  v-cntxt-db-num
     1673             ,input  v-cntxt-userid
     1674             ,input  v-diasize-proc-name
     1675             ,input  'height':u
     1676             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1677             ) .
     1678         end.
     1679       end.
     1680     end.
     1681     assign
     1682       v-diasize-change-size = false
     1683     .
     1684   end procedure.
     1685   procedure diasize_set-height :
     1686     define input  parameter p-new-height  as decimal   no-undo .
     1687     define input  parameter p-move-resize as logical   no-undo .
     1688     do
     1689     on error undo, return error return-value
     1690     :
     1691       run diasize_change-height in this-procedure
     1692         (input  (p-new-height - frame Dialog-Frame :height)
     1693         ,input  p-move-resize
     1694         ) .
     1695     end.
     1696   end procedure.
     1697   procedure diasize_change-width :
     1698     define input  parameter p-change-value as decimal   no-undo .
     1699     define input  parameter p-move-resize  as logical   no-undo .
     1700     define variable v-field-group-handle   as handle    no-undo .
     1701     define variable v-object-handle        as handle    no-undo .
     1702     define variable v-frame-width          as decimal   no-undo .
     1703     define variable v-frame-virtual-width  as decimal   no-undo .
     1704     define variable v-browse-width         as decimal   no-undo .
     1705     define variable v-window-width         as decimal   no-undo .
     1706     define variable v-window-virtual-width as decimal   no-undo .
     1707     define variable v-change-sign          as integer   no-undo .
     1708     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1709     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1710     if p-change-value > 0
     1711     then do:
     1712       if frame Dialog-Frame :width + p-change-value >
     1713           session :width-chars
     1714       then do:
     1715         assign
     1716           p-change-value = session :width-chars - frame Dialog-Frame :width
     1717         .
     1718         if p-change-value <= 0
     1719         then do:
     1720           run diasize_position-resize-button in this-procedure .
     1721           return .
     1722         end.
     1723       end.
     1724     end.
     1725     if p-change-value < 0
     1726     then do:
     1727       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1728       then do:
     1729         assign
     1730           p-change-value = v-diasize-orig-frame-width
     1731                          - frame Dialog-Frame :width
     1732         .
     1733         if p-change-value >= 0
     1734         then do:
     1735           run diasize_position-resize-button in this-procedure .
     1736           return .
     1737         end.
     1738       end.
     1739     end.
     1740     if p-change-value >= 0
     1741     then do:
     1742       assign
     1743         v-change-sign = 1
     1744       .
     1745     end.
     1746     else do:
     1747       assign
     1748         v-change-sign = -1
     1749       .
     1750     end.
     1751     assign
     1752       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1753     .
     1754     if p-change-value = 0
     1755     then do:
     1756       run diasize_position-resize-button in this-procedure .
     1757       return .
     1758     end.
     1759     move_block:
     1760     do
     1761     on error undo move_block, leave move_block
     1762     :
     1763       if retry
     1764       then do:
     1765         do
     1766         on error undo move_block, leave move_block
     1767         :
     1768           if p-change-value > 0
     1769           then do:
     1770             for each buf_temp-diasize-handle
     1771             on error undo, next
     1772             :
     1773               assign
     1774                 v-object-handle = buf_temp-diasize-handle.handle-value
     1775               .
     1776               if v-object-handle <> v-diasize-resize-button
     1777               then do:
     1778                 assign
     1779                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1780                 .
     1781               end.
     1782             end.
     1783             assign
     1784               v-diasize-browse-handle :width = v-browse-width
     1785             .
     1786             for each buf_temp-browse-handle
     1787               where buf_temp-browse-handle.browse-type = 'width':u
     1788             on error undo, next
     1789             :
     1790               assign
     1791                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1792               .
     1793             end.
     1794             assign
     1795               frame Dialog-Frame :width = v-frame-width
     1796             .
     1797             if frame Dialog-Frame :scrollable = true
     1798             then do:
