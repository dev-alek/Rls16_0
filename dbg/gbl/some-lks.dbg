     1851       then do:
     1852         assign
     1853           v-diasize-change-size = true
     1854         .
     1855       end.
     1856       else do:
     1857         return .
     1858       end.
     1859       assign
     1860         v-frame-width = frame Dialog-Frame :width
     1861         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1862         v-browse-width = v-diasize-browse-handle :width
     1863       .
