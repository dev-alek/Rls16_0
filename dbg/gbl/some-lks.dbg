     2053           define variable v-cntxt-db-num        as integer   no-undo .
     2054           define variable v-cntxt-userid        as character no-undo .
     2055           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2056                                             , OUTPUT v-cntxt-userid
     2057                                             ) .
     2058           run gbl/wndsizew.p
     2059             (input  v-cntxt-db-num
     2060             ,input  v-cntxt-userid
     2061             ,input  v-diasize-proc-name
     2062             ,input  'width':u
     2063             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2064             ) .
     2065         end.
     2066       end.
     2067     end.
     2068     assign
     2069       v-diasize-change-size = false
     2070     .
     2071   end procedure.
     2072   procedure diasize_set-width :
     2073     define input  parameter p-new-width  as decimal   no-undo .
     2074     define input  parameter p-move-resize as logical   no-undo .
     2075     do
     2076     on error undo, return error return-value
     2077     :
     2078       run diasize_change-width in this-procedure
     2079         (input  (p-new-width - frame Dialog-Frame :width)
     2080         ,input  p-move-resize
     2081         ) .
     2082     end.
     2083   end procedure.
     2084   procedure diasize_position-resize-button :
     2085     do with frame Dialog-Frame
     2086     :
     2087       hide v-diasize-resize-button .
     2088       assign
     2089         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2090                     - 1
     2091                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2092         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2093                     - 1
     2094                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2095       .
     2096       view v-diasize-resize-button .
     2097     end.
     2098   end procedure.
     2099   on alt-right anywhere
     2100   do:
     2101     run diasize_change-width in this-procedure
     2102       (input 1
     2103       ,input true
     2104       ) .
     2105     return no-apply .
     2106   end.
     2107   on alt-left anywhere
     2108   do:
     2109     run diasize_change-width in this-procedure
     2110       (input -1
     2111       ,input true
     2112       ) .
     2113     return no-apply .
     2114   end.
     2115   on alt-down anywhere
     2116   do:
     2117     run diasize_change-height in this-procedure
     2118       (input 1
     2119       ,input true
     2120       ) .
     2121     return no-apply .
     2122   end.
     2123   on alt-up anywhere
     2124   do:
     2125     run diasize_change-height in this-procedure
     2126       (input -1
     2127       ,input true
     2128       ) .
     2129     return no-apply .
     2130   end.
     2131   on alt-enter of frame Dialog-Frame
     2132   do:
     2133     run diasize_maximize in this-procedure
     2134       (input  ?
     2135       ).
     2136     return no-apply .
     2137   end.
     2138   procedure diasize_end-move :
     2139     do
     2140     on error undo, return error return-value
     2141     :
     2142       define variable v-row-delta as decimal   no-undo .
     2143       define variable v-col-delta as decimal   no-undo .
     2144       define variable v-new-row as decimal   no-undo .
     2145       define variable v-new-col as decimal   no-undo .
     2146       assign
     2147         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2148         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2149       .
     2150       assign
     2151         v-row-delta = v-new-row - frame Dialog-Frame :height
     2152         v-col-delta = v-new-col - frame Dialog-Frame :width
     2153       .
     2154       run diasize_change-height in this-procedure
     2155         (input v-row-delta
     2156         ,input true
     2157         ) .
     2158       run diasize_change-width in this-procedure
     2159         (input v-col-delta
     2160         ,input true
     2161         ) .
     2162     end.
     2163   end procedure.
     2164   procedure diasize_maximize :
     2165     define input  parameter p-action as logical   no-undo .
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       if p-action = ?
     2170       then do:
     2171         if v-diasize-need-maximize = true
     2172         then do:
     2173           assign
     2174             p-action = true
     2175           .
     2176         end.
     2177         else do:
     2178           assign
     2179             p-action = false
     2180           .
     2181         end.
     2182       end.
     2183       if p-action = true
     2184       then do:
     2185         run diasize_change-height in this-procedure
     2186           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2187               - frame Dialog-Frame :height-chars
     2188           ,input true
     2189           ) .
     2190         run diasize_change-width in this-procedure
     2191           (input session :width-chars
     2192               - frame Dialog-Frame :width-chars
     2193           ,input true
     2194           ) .
     2195         assign
     2196           v-diasize-need-maximize = false
     2197         .
     2198       end.
     2199       else do:
     2200         run diasize_change-width in this-procedure
     2201           (input v-diasize-orig-frame-width
     2202               - frame Dialog-Frame :width-chars
     2203           ,input true
     2204           ) .
     2205         run diasize_change-height in this-procedure
     2206           (input v-diasize-orig-frame-height
     2207               - frame Dialog-Frame :height-chars
     2208           ,input true
     2209           ) .
     2210         assign
     2211           v-diasize-need-maximize = true
     2212         .
     2213       end.
     2214     end.
     2215   end procedure.
     2216   procedure diasize_restore-orig-size :
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       assign
     2221         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2222         v-diasize-current-frame-height = frame Dialog-Frame :height
     2223       .
     2224       run diasize_set-height in this-procedure
     2225         (input  v-diasize-orig-frame-height
     2226         ,input  true
     2227         ) .
     2228       run diasize_set-width in this-procedure
     2229         (input  v-diasize-orig-frame-width
     2230         ,input  true
     2231         ) .
     2232     end.
     2233   end procedure.
     2234   procedure diasize_restore-current-size :
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       run diasize_set-height in this-procedure
     2239         (input  v-diasize-current-frame-height
     2240         ,input  true
     2241         ) .
     2242       run diasize_set-width in this-procedure
     2243         (input  v-diasize-current-frame-width
     2244         ,input  true
     2245         ) .
     2246     end.
     2247   end procedure.
     2248   procedure diasize_set-browse-handle :
     2249     define input  parameter p-browse-handle as handle   no-undo .
     2250     define buffer buf_temp-browse-handle for temp-browse-handle .
     2251     do
     2252     on error undo, return error return-value
     2253     :
     2254       assign
     2255         v-diasize-browse-handle = p-browse-handle
     2256       .
     2257       for each buf_temp-browse-handle
     2258       on error undo, return error return-value
     2259       :
     2260         delete buf_temp-browse-handle .
     2261       end.
     2262     end.
     2263   end procedure.
     2264   procedure diasize_add_browse :
     2265     define input  parameter p-browse-type   as character no-undo .
     2266     define input  parameter p-browse-handle as handle    no-undo .
     2267     define buffer buf_temp-browse-handle for temp-browse-handle .
     2268     do
     2269     on error undo, return error return-value
     2270     :
     2271       assign
     2272         v-diasize-browse-number = v-diasize-browse-number + 1
     2273       .
     2274       create buf_temp-browse-handle .
     2275       assign
     2276         buf_temp-browse-handle.browse-type   = p-browse-type
     2277         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2278         buf_temp-browse-handle.browse-handle = p-browse-handle
     2279       .
     2280     end.
     2281   end procedure.
     2282   procedure diasize_init :
     2283     define variable v-default-value    as logical   no-undo .
     2284     define variable v-restore-saved    as logical   no-undo .
     2285     define variable v-resize-value-str as character no-undo .
     2286     do
     2287     on error undo, return error return-value
     2288     :
     2289       do with frame Dialog-Frame
     2290       :
     2291         assign
     2292           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2293           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2294           v-diasize-browse-handle     = browse br-who-lk :handle
     2295         .
     2296         create button v-diasize-resize-button
     2297         assign
     2298           parent        = frame Dialog-Frame :first-child
     2299           label         = "s"
     2300           height-pixels = 16
     2301           width-pixels  = 16
     2302           visible       = true
     2303           sensitive     = true
     2304           movable       = true
     2305           triggers:
     2306             on end-move persistent run diasize_end-move in this-procedure .
     2307           end triggers.
     2308         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2309         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2310         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2311         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2312         assign
     2313           v-diasize-wndmax = false
     2314         .
     2315         if connected("ub") = true
     2316         then do:
     2317           define variable v-cntxt-db-num        as integer   no-undo .
     2318           define variable v-cntxt-userid        as character no-undo .
     2319           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2320                                             , OUTPUT v-cntxt-userid
     2321                                             ) .
     2322           run gbl/wndpar_r.p
     2323             (input  v-cntxt-db-num
     2324             ,input  v-cntxt-userid
     2325             ,input  'wndmax':U
     2326             ,output v-diasize-wndmax
     2327             ,output v-default-value
     2328             ) .
     2329         end.
     2330         assign
     2331           v-diasize-wndstore = false
     2332         .
     2333         if connected("ub") = true
     2334         then do:
     2335           run gbl/wndpar_r.p
     2336             (input  v-cntxt-db-num
     2337             ,input  v-cntxt-userid
     2338             ,input  'wndstore':U
     2339             ,output v-diasize-wndstore
     2340             ,output v-default-value
     2341             ) .
     2342         end.
     2343         assign
     2344           v-diasize-proc-name = entry(1, program-name(2), '.')
     2345         .
     2346         if v-diasize-wndstore = true
     2347         then do:
     2348           assign
     2349             v-restore-saved = false
     2350           .
     2351           if connected("ub") = true
     2352           then do:
     2353             run gbl/wndsizer.p
     2354               (input  v-cntxt-db-num
     2355               ,input  v-cntxt-userid
     2356               ,input  v-diasize-proc-name
     2357               ,input  'height':u
     2358               ,output v-resize-value-str
     2359               ) .
     2360             if v-resize-value-str <> '':U
     2361             then do:
     2362               run diasize_change-height in this-procedure
     2363                 (input  integer(v-resize-value-str)
     2364                 ,input  true
     2365                 ) .
     2366               assign
     2367                 v-restore-saved = true
     2368               .
     2369             end.
     2370           end.
     2371           if connected("ub") = true
     2372           then do:
     2373             run gbl/wndsizer.p
     2374               (input  v-cntxt-db-num
     2375               ,input  v-cntxt-userid
     2376               ,input  v-diasize-proc-name
     2377               ,input  'width':u
     2378               ,output v-resize-value-str
     2379               ) .
     2380             if v-resize-value-str <> '':U
     2381             then do:
     2382               run diasize_change-width in this-procedure
     2383                 (input  integer(v-resize-value-str)
     2384                 ,input  true
     2385                 ) .
     2386               assign
     2387                 v-restore-saved = true
     2388               .
     2389             end.
     2390           end.
     2391           if v-restore-saved <> true
     2392           then do:
     2393             if v-diasize-wndmax = true
     2394             then do:
     2395               run diasize_maximize in this-procedure
     2396                 (input  true
     2397                 ) .
     2398             end.
     2399           end.
     2400         end.
     2401         else do:
     2402           if v-diasize-wndmax = true
     2403           then do:
     2404             run diasize_maximize in this-procedure
     2405               (input  true
     2406               ) .
     2407           end.
     2408         end.
     2409       end.
     2410     end.
     2411   end procedure.
     2412   procedure diasize_need-full-display :
     2413     define output parameter p-need-full-display as logical   no-undo .
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       assign
     2418         p-need-full-display = v-diasize-need-full-display
     2419       .
     2420       assign
     2421         v-diasize-need-full-display = false
     2422       .
     2423     end.
     2424   end procedure.
     2425   procedure get-context :
     2426      define output parameter p-db-num as integer          no-undo.
     2427      define output parameter p-user-id as character        no-undo.
     2428      define variable v-login               as character    no-undo.
     2429      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2430      define buffer buf_user-login  for ub.user-login .
     2431      do
     2432      on error undo, return error
     2433      :
     2434            FIND FIRST buf_sys-ctrl no-lock.
     2435            ASSIGN
     2436               v-login = USERID("ub")
     2437               p-db-num = buf_sys-ctrl.db-num
     2438            .
     2439            FIND FIRST buf_user-login
     2440                 WHERE buf_user-login.db-num = p-db-num
     2441                   AND buf_user-login.user-login = v-login
     2442                 no-lock
     2443                 no-error
     2444                 .
     2445            IF AVAILABLE buf_user-login
     2446            THEN DO:
     2447               assign
     2448                  p-user-id = buf_user-login.user-id
     2449               .
     2450            END.
     2451      end.
     2452   end procedure.
     2453       run diasize_init in this-procedure .
     2454   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2455   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2456   MAIN-BLOCK:
     2457   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2458      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2459   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460     run mainmenu_getcntxt in parparentproc
     2461       (output v-cntxt-db-num
     2462       ,output v-cntxt-userid
     2463       ,output v-cntxt-level
     2464       ,output v-cntxt-host-code-obj
     2465       ,output v-cntxt-obj-type
     2466       ,output v-cntxt-obj-code
     2467       ,output v-cntxt-db-num-obj
     2468       ,output v-cntxt-is-admin
     2469       ) .
     2470     if lookup( p-list-mode , 'все':U + chr(4) + "resource-id", chr(4) ) = 0 then do:
     2471       message
     2472       substitute("Неверно задано значение параметра p-list-mode (&1)", p-list-mode)
     2473       view-as alert-box error .
     2474       undo, return error .
     2475     end.
     2476     if p-list-mode = "resource-id" then do:
     2477       v-resource-descr = calldscr(p-resource-id).
     2478     end.
     2479     run Myenable in this-procedure .
     2480     v-rid-list = p-rid-list.
     2481     WAIT-FOR GO OF FRAME Dialog-Frame.
     2482   END.
     2483   RUN disable_UI.
     2484   PROCEDURE disable_UI :
     2485     HIDE FRAME Dialog-Frame.
     2486   END PROCEDURE.
     2487   PROCEDURE enable_UI :
     2488     DISPLAY E-ps mark-num
     2489         WITH FRAME Dialog-Frame.
     2490     ENABLE b-quit b-mark b-sel B-Help br-who-lk E-ps mark-num
     2491         WITH FRAME Dialog-Frame.
     2492     VIEW FRAME Dialog-Frame.
     2493     RUN openbr IN THIS-PROCEDURE.
     2494   END PROCEDURE.
     2495   PROCEDURE MyEnable :
     2496   ASSIGN
     2497   X_who-lk.lk-mess:RESIZABLE IN BROWSE br-who-lk = YES
     2498   .
     2499   if p-list-mode = "resource-id" then do:
     2500     X_who-lk.resource_id:visible in browse br-who-lk = no.
     2501   end.
     2502   ENABLE
     2503   b-quit
     2504   B-Help
     2505   b-mark when lookup("b-mark", bttns) > 0
     2506   b-sel when lookup("b-sel", bttns) > 0
     2507   br-who-lk
     2508   WITH FRAME Dialog-Frame.
     2509   VIEW FRAME Dialog-Frame.
     2510   run Openbr in this-procedure .
     2511   APPLY "VALUE-CHANGED" to br-who-lk in frame Dialog-Frame.
     2512   END PROCEDURE.
     2513   PROCEDURE Openbr :
     2514   CASE p-list-mode:
     2515      when 'все':U then do:
     2516         frame Dialog-Frame :title = "Все использования".
     2517         OPEN QUERY br-who-lk FOR EACH X_who-lk NO-LOCK INDEXED-REPOSITION.
     2518      end.
     2519      when "resource-id" then do:
     2520         frame Dialog-Frame :title = substitute("Использование &1", v-resource-descr).
     2521         OPEN QUERY br-who-lk
     2522         FOR EACH X_who-lk NO-LOCK where
     2523                  X_who-lk.resource_id = p-resource-id
     2524         by X_who-lk.call_id
     2525        INDEXED-REPOSITION
     2526         .
     2527      end.
     2528   end case.
     2529   END PROCEDURE.
