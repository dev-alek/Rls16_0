     1888           and can-query(v-object-handle, "height")
     1889           and ( v-object-handle :col + v-object-handle :width
     1890                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1891               )
     1892           then do:
     1893             find first buf_temp-browse-handle
     1894               where buf_temp-browse-handle.browse-type   = 'width':u
     1895                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1896               no-error .
     1897             if available buf_temp-browse-handle
     1898             then do:
     1899             end.
     1900             else do:
     1901               create buf_temp-diasize-handle .
     1902               assign
     1903                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1904                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1905               .
     1906             end.
     1907           end.
     1908           assign
     1909             v-object-handle = v-object-handle :next-sibling
     1910           .
     1911         end.
     1912         assign
     1913           v-field-group-handle = v-field-group-handle :next-sibling
     1914         .
     1915       end.
     1916       do with frame Dialog-Frame
     1917       :
     1918         hide v-diasize-resize-button .
     1919         v-diasize-resize-button :row = 1.
     1920         v-diasize-resize-button :column = 1.
     1921       end.
     1922       if p-change-value > 0
     1923       then do:
     1924         if frame Dialog-Frame :scrollable = true
     1925         then do:
     1926           assign
     1927             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1928             no-error .
