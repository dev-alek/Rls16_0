     1998             then do:
     1999               undo move_block, retry move_block .
     2000             end.
     2001           end.
     2002         end.
     2003         for each buf_temp-browse-handle
     2004           where buf_temp-browse-handle.browse-type = 'width':u
     2005         on error undo move_block, retry move_block
     2006         :
     2007           assign
     2008             buf_temp-browse-handle.browse-handle :width
     2009               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2010             no-error .
     2011           if error-status :error
     2012           or error-status :get-message(1) <> ""
     2013           then do:
