      657         t-f.field-label format "X(30)" column-label "Название поля"
      658   t-f.field-size format "X(3)":U column-label "Длина!поля"
      659       WITH NO-ROW-MARKERS SEPARATORS SIZE 40 BY 13.17
      660            BGCOLOR 15 .
      661   DEFINE BROWSE BR-sel-fields
      662     QUERY BR-sel-fields DISPLAY
      663         sel_t-f.field-label format "X(30)" column-label "Название поля"
      664   sel_t-f.field-size format "X(3)":U column-label "Длина!поля"
      665       WITH NO-ROW-MARKERS SEPARATORS SIZE 40 BY 13.25
      666            BGCOLOR 15 .
      667   DEFINE FRAME DIALOG-1
      668        Btn_OK AT ROW 1 COL 1
      669        Btn_Cancel AT ROW 1 COL 11
      670        b-help AT ROW 1 COL 21
      671        ubflt.filter.Naim AT ROW 2.67 COL 1.88 HELP
      672             ""
      673             LABEL "Имя шаблона печати" FORMAT "X(255)"
      674             VIEW-AS FILL-IN
      675             SIZE 77.38 BY 1 TOOLTIP "Введите имя создаваемого шаблона печати"
      676             BGCOLOR 15
      677        RS-tabs AT ROW 4.5 COL 2 NO-LABEL
      678        f-num-clmn AT ROW 5.42 COL 89.63 COLON-ALIGNED NO-LABEL
      679        f-length AT ROW 5.46 COL 66.88 COLON-ALIGNED NO-LABEL
      680        FILL-IN-4 AT ROW 7.08 COL 56.13 COLON-ALIGNED NO-LABEL
      681        FILL-IN-3 AT ROW 7.25 COL 2 NO-LABEL
      682        BR-sel-fields AT ROW 8.08 COL 58
      683        BR-fields AT ROW 8.25 COL 2
      684        btn-add AT ROW 9.58 COL 46
      685        btn-remove AT ROW 10.83 COL 46
      686        b-up AT ROW 13.08 COL 46
      687        b-down AT ROW 14.33 COL 46
      688        RECT-1 AT ROW 2.25 COL 1
      689        "Кол-во полей" VIEW-AS TEXT
      690             SIZE 12.5 BY .67 AT ROW 5.54 COL 78.88
      691             BGCOLOR 1 FGCOLOR 15
      692        "Длина шаблона" VIEW-AS TEXT
      693             SIZE 14.5 BY .67 AT ROW 5.63 COL 53.5
      694             BGCOLOR 1 FGCOLOR 15
      695        SPACE(31.87) SKIP(15.36)
      696       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      697            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      698            BGCOLOR 8 FGCOLOR 0
      699            TITLE BGCOLOR 8 FGCOLOR 0 "":L
      700            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      701   ASSIGN
      702          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      703   ON CHOOSE OF b-down IN FRAME DIALOG-1
      704   DO:
      705   define variable v-order as integer no-undo.
      706   define variable v-rec as recid no-undo.
      707   define buffer buf_sel-t-f for t-f.
      708     if not available sel_t-f then do:
      709       return no-apply.
      710   end.
      711   assign
      712   v-rec = recid(sel_t-f).
      713   find last buf_sel-t-f use-index iorder no-error.
      714   if avail buf_sel-t-f then do:
      715       v-order = buf_sel-t-f.field-order.
      716   end.
      717   if sel_t-f.field-order = v-order then do:
      718       return no-apply.
      719   end.
      720   assign
      721   v-order = sel_t-f.field-order.
      722   find first buf_sel-t-f where
      723               buf_SEL-T-F.field-order > v-order
      724               and buf_sel-t-f.field-order > 0 use-index iorder no-error.
      725       if not available buf_sel-t-f then do:
      726           return no-apply.
      727       end.
      728   assign
      729   sel_t-f.field-order = buf_sel-t-f.field-order
      730   buf_sel-t-f.field-order = v-order
      731   .
      732     APPLY "VALUE-CHANGED" to Rs-tabs.
      733    OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      734     run enable-buttons in this-procedure.
      735     REPOSITION br-sel-fields to recid v-rec no-error.
      736     apply "ENTRY" to br-sel-fields.
      737   END.
      738   ON CHOOSE OF b-up IN FRAME DIALOG-1
      739   DO:
      740   define variable v-order as integer no-undo.
      741   define variable v-rec as recid no-undo.
      742   define buffer buf_sel-t-f for t-f.
      743     if not available sel_t-f then do:
      744       return no-apply.
      745   end.
      746   if sel_t-f.field-order = 1 then do:
      747       return no-apply.
      748   end.
      749   assign
      750   v-order = sel_t-f.field-order
      751   v-rec = recid(sel_t-f).
      752   .
      753   find last buf_sel-t-f where
      754               buf_SEL-T-F.field-order < v-order
      755               and buf_sel-t-f.field-order > 0 use-index iorder  no-error.
      756       if not available buf_sel-t-f then do:
      757           return no-apply.
      758       end.
      759   assign
      760   sel_t-f.field-order = buf_sel-t-f.field-order
      761   buf_sel-t-f.field-order = v-order
      762   .
      763     APPLY "VALUE-CHANGED" to Rs-tabs.
      764    OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      765       run enable-buttons in this-procedure.
      766   REPOSITION br-sel-fields to recid v-rec no-error.
      767     apply "ENTRY" to br-sel-fields.
      768   END.
      769   ON MOUSE-SELECT-DBLCLICK OF BR-fields IN FRAME DIALOG-1
      770   DO:
      771     APPLY "CHOOSE" to btn-add.
      772   END.
      773   ON CHOOSE OF btn-add IN FRAME DIALOG-1
      774   DO:
      775   define variable v-max-order as integer no-undo.
      776   define buffer buf_t-f for t-f.
      777   if not avail t-f then return no-apply.
      778   find last buf_t-f no-lock use-index iorder no-error.
      779   if avail buf_t-f then do:
      780       assign
      781       v-max-order = buf_t-f.field-order
      782       .
      783   end.
      784   Find first buf_t-f where
      785                recid(buf_t-f) = recid(t-f).
      786   assign
      787   buf_t-f.field-order = v-max-order + 1
      788   v-num-clmn = v-num-clmn +  1
      789   v-length = v-length + INTEGER(t-f.field-SIZE)
      790   .
      791   APPLY "VALUE-CHANGED" to Rs-tabs.
      792   OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      793   RUN PROC-N-L IN THIS-PROCEDURE.
      794   run enable-buttons in this-procedure.
      795   REPOSITION br-sel-fields to recid recid(buf_t-f) no-error.
      796   apply "ENTRY" to br-sel-fields.
      797   browse br-sel-fields:set-repositioned-row(5, "CONDITIONAL").
      798   END.
      799   ON CHOOSE OF btn-remove IN FRAME DIALOG-1
      800   DO:
      801   define variable v-order as integer no-undo.
      802   define buffer buf_t-f for t-f.
      803   define buffer buf1_t-f for t-f.
      804   if not available sel_t-f then do:
      805       return no-apply.
      806   end.
      807    find first buf_t-f where
      808            recid(buf_t-f) = recid(sel_t-f)
      809    .
      810    v-order = buf_t-f.field-order.
      811   assign
      812   buf_t-f.field-order = 0
      813   v-num-clmn = v-num-clmn -  1
      814   v-length = v-length - INTEGER(buf_t-f.field-SIZE)
      815   .
      816   for each buf_t-f where
      817                buf_t-f.field-order > v-order:
      818       find first buf1_t-f where
      819                   recid(buf1_t-f) = recid(buf_t-f).
      820       assign
      821       buf1_t-f.field-order =   buf1_t-f.field-order - 1
      822       .
      823   END.
      824   APPLY "VALUE-CHANGED" to Rs-tabs.
      825   OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      826   RUN PROC-N-L IN THIS-PROCEDURE.
      827   run enable-buttons in this-procedure.
      828   REPOSITION br-sel-fields to row v-order - 1 no-error.
      829   apply "ENTRY" to br-sel-fields.
      830   END.
      831   ON CHOOSE OF Btn_OK IN FRAME DIALOG-1
      832   DO:
      833   define variable v-file-name as character no-undo.
      834   define buffer buf_sel-t-f for t-f.
      835   if (can-find(ubflt.filter where ubflt.filter.call-point = c-point
      836          and ubflt.filter.naim = input frame DIALOG-1 ubflt.filter.naim) and v-new) or
      837          input frame DIALOG-1 ubflt.filter.naim = "" then do:
      838       if input frame DIALOG-1 ubflt.filter.naim = ""
      839       then
      840       message "Пустое имя фильтра недопустимо".
      841       else message "Фильтр с таким именем уже сущестует".
      842       apply "entry" to ubflt.filter.naim.
      843       return no-apply.
      844   end.
      845   id = recid(ubflt.filter).
      846   IDENT = RECID(ubflt.filter).
      847   assign
      848   select3 = "":U
      849   select3-size = "":U
      850   select3-format = "":U
      851   select3-type = "":U
      852   select3-label = "":U
      853   .
      854   for each buf_sel-t-f no-lock where
      855            buf_sel-t-f.field-order > 0 :
      856   assign
      857   v-file-name = "":U.
      858   do ii = 1 to num-entries(buf_sel-t-f.field-name, '*':U):
      859       assign
      860       v-file-name = v-file-name + '*':U + buf_sel-t-f.table-name + ".":U + entry(ii, buf_sel-t-f.field-name, '*':U)
      861       .
      862   end.
      863   assign
      864   v-file-name = left-trim(v-file-name , '*':U)
      865   .
      866   assign
      867   select3 = select3 + chr(44) + v-file-name
      868   select3-size = select3-size + chr(44) + buf_sel-t-f.field-size
      869   select3-format = select3-format + chr(4) + buf_sel-t-f.field-format
      870   select3-type = select3-type + chr(44) + buf_sel-t-f.field-type
      871   select3-label = select3-label + chr(44) + buf_sel-t-f.field-label
      872   .
      873   end.
      874   assign
      875   Filter.naim = input frame DIALOG-1 ubflt.filter.naim
      876   Filter.call-point = c-point
      877   Filter.Tbl = List-Tabls
      878   Filter.Flds = List-Fields
      879   Filter.Fields-sort = left-trim(SELECT3, chr(44))
      880   Filter.Fields-sort-rus = left-trim(SELECT3-label, chr(44))
      881   Filter.Where-ysl = left-trim(select3-size, chr(44))
      882   Filter.Where-ysl-rus = left-trim(select3-format, chr(4))
      883   Filter.lst-cend = left-trim(select3-type, chr(44))
      884   .
      885   END.
      886   ON VALUE-CHANGED OF RS-tabs IN FRAME DIALOG-1
      887   DO:
      888     assign
      889     rs-tabs.
      890   OPEN QUERY br-fields FOR EACH t-f no-lock where t-f.table-name = RS-tabs
      891   and t-f.field-order = 0 use-index itorder.
      892   END.
      893   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      894   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      895   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   on help of frame DIALOG-1
      897   do:
      898     run gbl/app_help.p
      899       (input this-procedure :file-name
      900       ,input ''
      901       ,input ?
      902       ) no-error.
      903     if error-status :error then do:
      904       message
      905         "Ошибка при вызове помощи"
      906         error-status :get-message(1)
      907         view-as alert-box .
      908     end.
      909   end.
      910   run minbtn-set in this-procedure .
      911   on choose of b-help in frame DIALOG-1
      912   do:
      913     apply "help":u to frame DIALOG-1 .
      914   end.
      915   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure minbtn-set :
      917       do
      918           on error undo, return error return-value
      919           :
      920           define variable ii              as integer       no-undo .
      921           define variable fh              as widget-handle no-undo .
      922           define variable hh              as widget-handle no-undo .
      923           define variable v-h             as handle        extent 4 no-undo .
      924           define variable v-name-button   as character     no-undo .
      925           define variable v-help-old-x    as decimal       no-undo .
      926           define variable v-help-old-y    as decimal       no-undo .
      927           define variable v-help-old-size as decimal       no-undo .
      928           define variable v-frame-width   as decimal       no-undo .
      929           define variable jj              as integer       no-undo .
      930           do
      931               on error undo, return error
      932               :
      933               assign
      934                   v-frame-width = frame DIALOG-1:width - 0.3
      935                   fh            = frame DIALOG-1:first-child
      936                   hh            = fh:first-child
      937                   ii            = 1
      938                   .
      939               do while valid-handle(hh):
      940                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      941                   do:
      942                       case lc(hh:name) :
      943                           when "b-help" then
      944                               do:
      945                                   hh:load-image-up("cmp/b-help.bmp":u) .
      946                                   hh:load-image-down("cmp/b-help.bmp":u) .
      947                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      948                                   hh:TOOLTIP = "Помощь" .
      949                                   v-help-old-x = hh:column .
      950                                   v-help-old-y = hh:row    .
      951                                   v-help-old-size = hh:width .
      952                                   hh:width-chars = 2.5 .
      953                               end.
      954                           when "b-print" then
      955                               do:
      956                                   hh:load-image("cmp/b-print.bmp":u) .
      957                                   hh:TOOLTIP = "Печать" .
      958                                   v-h[ii] = hh:handle .
      959                                   ii = ii + 1 .
      960                                   hh:width-chars = 3 .
      961                               end.
      962                           when "b-history" or
      963                           when "b-hist" then
      964                               do:
      965                                   hh:load-image("cmp/b-hist.bmp":u) .
      966                                   hh:TOOLTIP = "История" .
      967                                   v-h[ii] = hh:handle .
      968                                   ii = ii + 1 .
      969                                   hh:width-chars = 3 .
      970                               end.
      971                           when "b-sch" then
      972                               do:
      973                                   hh:load-image("cmp/b-sch.bmp":u) .
      974                                   hh:TOOLTIP = "Установка Фильтра" .
      975                                   v-h[ii] = hh:handle .
      976                                   ii = ii + 1 .
      977                                   hh:width-chars = 3 .
      978                               end.
      979                           when "b-hist-user" then
      980                               do:
      981                                   hh:load-image("cmp/b-hist.bmp":u) .
      982                                   hh:TOOLTIP = "История пользователя" .
      983                                   ii = ii + 1 .
      984                               end.
      985                       end case.
      986                   end.
      987                   hh = hh:next-sibling.
      988               end.
      989               b-help:column = v-frame-width - b-help:width-chars.
      990               jj = 0.
      991               repeat ii = 4 to 1 by -1 :
      992                   if valid-handle (v-h[ii] ) then
      993                   do:
      994                       jj  = jj + 1 .
      995                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      996                       v-h[ii]:row    = v-help-old-y .
      997                   end.
      998               end.
      999           end.
     1000       end.
     1001   end procedure.
     1002   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1003   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1004   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1005   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1006   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1007   define variable v-diasize-current-frame-height as decimal   no-undo .
     1008   define variable v-diasize-change-size          as logical   no-undo .
     1009   define variable v-diasize-resize-button        as handle    no-undo .
     1010   define variable v-diasize-wndmax               as logical   no-undo .
     1011   define variable v-diasize-wndstore             as logical   no-undo .
     1012   define variable v-diasize-proc-name            as character no-undo .
     1013   define variable v-diasize-browse-handle        as handle    no-undo .
     1014   define variable v-diasize-browse-number        as integer   no-undo .
     1015   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1016   define temp-table temp-diasize-handle no-undo
     1017     field handle-value  as handle
     1018     field save-position as decimal
     1019     index xpk is primary unique handle-value
     1020     .
     1021   define temp-table temp-browse-handle no-undo
     1022     field browse-type   as character
     1023     field browse-number as integer
     1024     field browse-handle as handle
     1025     field original-size as decimal
     1026     index xpk is primary unique browse-type browse-number
     1027     index xie browse-type browse-handle
     1028   .
     1029   procedure diasize_change-height :
     1030     define input  parameter p-change-value  as decimal   no-undo .
     1031     define input  parameter p-move-resize   as logical   no-undo .
     1032     define variable v-field-group-handle    as handle    no-undo .
     1033     define variable v-object-handle         as handle    no-undo .
     1034     define variable v-frame-height          as decimal   no-undo .
     1035     define variable v-frame-virtual-height  as decimal   no-undo .
     1036     define variable v-browse-height         as decimal   no-undo .
     1037     define variable v-window-height         as decimal   no-undo .
     1038     define variable v-window-virtual-height as decimal   no-undo .
     1039     define variable v-change-sign           as integer   no-undo .
     1040     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1041     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1042     if p-change-value > 0
     1043     then do:
     1044       if frame DIALOG-1 :height + p-change-value
     1045           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1046       then do:
     1047         assign
     1048           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1049                           - (frame DIALOG-1 :height-chars)
     1050         .
     1051         if p-change-value <= 0
     1052         then do:
     1053           run diasize_position-resize-button in this-procedure .
     1054           return .
     1055         end.
     1056       end.
     1057     end.
     1058     if p-change-value < 0
     1059     then do:
     1060       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
     1061       then do:
     1062         assign
     1063           p-change-value = v-diasize-orig-frame-height
     1064                          - (frame DIALOG-1 :height-chars)
     1065         .
     1066         if p-change-value >= 0
     1067         then do:
     1068           run diasize_position-resize-button in this-procedure .
     1069           return .
     1070         end.
     1071       end.
     1072     end.
     1073     if p-change-value >= 0
     1074     then do:
     1075       assign
     1076         v-change-sign = 1
     1077       .
     1078     end.
     1079     else do:
     1080       assign
     1081         v-change-sign = -1
     1082       .
     1083     end.
     1084     assign
     1085       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1086     .
     1087     if p-change-value = 0
     1088     then do:
     1089       run diasize_position-resize-button in this-procedure .
     1090       return .
     1091     end.
     1092     move_block:
     1093     do
     1094     on error undo move_block, retry move_block
     1095     :
     1096       if retry
     1097       then do:
     1098         do
     1099         on error undo move_block, leave move_block
     1100         :
     1101           if p-change-value > 0
     1102           then do:
     1103             for each buf_temp-diasize-handle
     1104             on error undo, next
     1105             :
     1106               assign
     1107                 v-object-handle = buf_temp-diasize-handle.handle-value
     1108               .
     1109               if v-object-handle <> v-diasize-resize-button
     1110               then do:
     1111                 assign
     1112                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1113                 .
     1114               end.
     1115             end.
     1116             assign
     1117               v-diasize-browse-handle :height = v-browse-height
     1118             .
     1119             for each buf_temp-browse-handle
     1120               where buf_temp-browse-handle.browse-type = 'height':u
     1121             on error undo, next
     1122             :
     1123               assign
     1124                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1125               .
     1126             end.
     1127             assign
     1128               frame DIALOG-1 :height = v-frame-height
     1129             .
     1130             if frame DIALOG-1 :scrollable = true
     1131             then do:
     1132               assign
     1133                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1134               .
     1135             end.
     1136             run diasize_position-resize-button in this-procedure .
     1137           end.
     1138           else do:
     1139             if frame DIALOG-1 :scrollable = true
     1140             then do:
     1141               assign
     1142                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1143               .
     1144             end.
     1145             assign
     1146               frame DIALOG-1 :height = v-frame-height
     1147             .
     1148             assign
     1149               v-diasize-browse-handle :height = v-browse-height
     1150             .
     1151             for each buf_temp-browse-handle
     1152               where buf_temp-browse-handle.browse-type = 'height':u
     1153             on error undo, next
     1154             :
     1155               assign
     1156                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1157               .
     1158             end.
     1159             for each buf_temp-diasize-handle
     1160             on error undo, next
     1161             :
     1162               assign
     1163                 v-object-handle = buf_temp-diasize-handle.handle-value
     1164               .
     1165               if v-object-handle <> v-diasize-resize-button
     1166               then do:
     1167                 assign
     1168                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1169                 .
     1170               end.
     1171             end.
     1172             run diasize_position-resize-button in this-procedure .
     1173           end.
     1174           assign
     1175             v-diasize-change-size = false
     1176           .
     1177           leave move_block .
     1178         end.
     1179       end.
     1180       assign
     1181         v-diasize-need-full-display = true
     1182       .
     1183       if v-diasize-change-size = false
     1184       then do:
     1185         assign
     1186           v-diasize-change-size = true
     1187         .
     1188       end.
     1189       else do:
     1190         return .
     1191       end.
     1192       assign
     1193         v-frame-height = frame DIALOG-1 :height
     1194         v-frame-virtual-height = frame DIALOG-1 :virtual-height
     1195         v-browse-height = v-diasize-browse-handle :height
     1196       .
     1197       for each buf_temp-browse-handle
     1198         where buf_temp-browse-handle.browse-type = 'height':u
     1199       :
     1200         assign
     1201           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1202         .
     1203       end.
     1204       for each buf_temp-diasize-handle
     1205       :
     1206         delete buf_temp-diasize-handle .
     1207       end.
     1208       assign
     1209         v-field-group-handle = frame DIALOG-1 :first-child
     1210       .
     1211       do while valid-handle(v-field-group-handle)
     1212       :
     1213         assign
     1214           v-object-handle = v-field-group-handle :first-child
     1215         .
     1216         do while valid-handle(v-object-handle)
     1217         :
     1218           if  v-object-handle <> v-diasize-browse-handle :handle
     1219           and can-query(v-object-handle, "row")
     1220           and can-query(v-object-handle, "height")
     1221           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1222           then do:
     1223             find first buf_temp-browse-handle
     1224               where buf_temp-browse-handle.browse-type   = 'height':u
     1225                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1226               no-error .
     1227             if available buf_temp-browse-handle
     1228             then do:
     1229             end.
     1230             else do:
     1231               create buf_temp-diasize-handle .
     1232               assign
     1233                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1234                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1235               .
     1236             end.
     1237           end.
     1238           assign
     1239             v-object-handle = v-object-handle :next-sibling
     1240           .
     1241         end.
     1242         assign
     1243           v-field-group-handle = v-field-group-handle :next-sibling
     1244         .
     1245       end.
     1246       do with frame DIALOG-1
     1247       :
     1248         hide v-diasize-resize-button .
     1249         assign
     1250           v-diasize-resize-button :row    = 1
     1251           v-diasize-resize-button :column = 1
     1252         .
     1253       end.
     1254       if p-change-value > 0
     1255       then do:
     1256         if frame DIALOG-1 :scrollable = true
     1257         then do:
     1258           assign
     1259             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1260             no-error .
     1261           if error-status :error
     1262           or error-status :get-message(1) <> ""
     1263           then do:
     1264             undo move_block, retry move_block .
     1265           end.
     1266         end.
     1267         assign
     1268           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1269           no-error .
     1270         if error-status :error
     1271         or error-status :get-message(1) <> ""
     1272         then do:
     1273           undo move_block, retry move_block .
     1274         end.
     1275         assign
     1276           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1277           no-error .
     1278         if error-status :error
     1279         or error-status :get-message(1) <> ""
     1280         then do:
     1281           undo move_block, retry move_block .
     1282         end.
     1283         for each buf_temp-browse-handle
     1284           where buf_temp-browse-handle.browse-type = 'height':u
     1285         on error undo move_block, retry move_block
     1286         :
     1287           assign
     1288             buf_temp-browse-handle.browse-handle :height
     1289               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1290             no-error .
     1291           if error-status :error
     1292           or error-status :get-message(1) <> ""
     1293           then do:
     1294             undo move_block, retry move_block .
     1295           end.
     1296         end.
     1297         for each buf_temp-diasize-handle
     1298         on error undo move_block, retry move_block
     1299         :
     1300           assign
     1301             v-object-handle = buf_temp-diasize-handle.handle-value
     1302           .
     1303           if v-object-handle <> v-diasize-resize-button
     1304           then do:
     1305             assign
     1306               v-object-handle :row = v-object-handle :row + p-change-value
     1307               no-error .
     1308             if error-status :error
     1309             or error-status :get-message(1) <> ""
     1310             then do:
     1311               undo move_block, retry move_block .
     1312             end.
     1313           end.
     1314         end.
     1315       end.
     1316       else do:
     1317         for each buf_temp-diasize-handle
     1318         on error undo move_block, retry move_block
     1319         :
     1320           assign
     1321             v-object-handle = buf_temp-diasize-handle.handle-value
     1322           .
     1323           if v-object-handle <> v-diasize-resize-button
     1324           then do:
     1325             assign
     1326               v-object-handle :row = v-object-handle :row + p-change-value
     1327               no-error .
     1328             if error-status :error
     1329             or error-status :get-message(1) <> ""
     1330             then do:
     1331               undo move_block, retry move_block .
     1332             end.
     1333           end.
     1334         end.
     1335         assign
     1336           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1337           no-error .
     1338         if error-status :error
     1339         or error-status :get-message(1) <> ""
     1340         then do:
     1341           undo move_block, retry move_block .
     1342         end.
     1343         for each buf_temp-browse-handle
     1344           where buf_temp-browse-handle.browse-type = 'height':u
     1345         on error undo move_block, retry move_block
     1346         :
     1347           assign
     1348             buf_temp-browse-handle.browse-handle :height
     1349               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1350             no-error .
     1351           if error-status :error
     1352           or error-status :get-message(1) <> ""
     1353           then do:
     1354             undo move_block, retry move_block .
     1355           end.
     1356         end.
     1357         assign
     1358           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1359           no-error .
     1360         if error-status :error
     1361         or error-status :get-message(1) <> ""
     1362         then do:
     1363           undo move_block, retry move_block .
     1364         end.
     1365         if frame DIALOG-1 :scrollable = true
     1366         then do:
     1367           assign
     1368             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1369             no-error .
     1370           if error-status :error
     1371           or error-status :get-message(1) <> ""
     1372           then do:
     1373             undo move_block, retry move_block .
     1374           end.
     1375         end.
     1376       end.
     1377       if p-move-resize = true
     1378       then do:
     1379         run diasize_position-resize-button in this-procedure .
     1380       end.
     1381       if v-diasize-wndstore = true
     1382       then do:
     1383         if connected("ub") = true
     1384         then do:
     1385           define variable v-cntxt-db-num        as integer   no-undo .
     1386           define variable v-cntxt-userid        as character no-undo .
     1387           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1388                                             , OUTPUT v-cntxt-userid
     1389                                             ) .
     1390           run gbl/wndsizew.p
     1391             (input  v-cntxt-db-num
     1392             ,input  v-cntxt-userid
     1393             ,input  v-diasize-proc-name
     1394             ,input  'height':u
     1395             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
     1396             ) .
     1397         end.
     1398       end.
     1399     end.
     1400     assign
     1401       v-diasize-change-size = false
     1402     .
     1403   end procedure.
     1404   procedure diasize_set-height :
     1405     define input  parameter p-new-height  as decimal   no-undo .
     1406     define input  parameter p-move-resize as logical   no-undo .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       run diasize_change-height in this-procedure
     1411         (input  (p-new-height - frame DIALOG-1 :height)
     1412         ,input  p-move-resize
     1413         ) .
     1414     end.
     1415   end procedure.
     1416   procedure diasize_change-width :
     1417     define input  parameter p-change-value as decimal   no-undo .
     1418     define input  parameter p-move-resize  as logical   no-undo .
     1419     define variable v-field-group-handle   as handle    no-undo .
     1420     define variable v-object-handle        as handle    no-undo .
     1421     define variable v-frame-width          as decimal   no-undo .
     1422     define variable v-frame-virtual-width  as decimal   no-undo .
     1423     define variable v-browse-width         as decimal   no-undo .
     1424     define variable v-window-width         as decimal   no-undo .
     1425     define variable v-window-virtual-width as decimal   no-undo .
     1426     define variable v-change-sign          as integer   no-undo .
     1427     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1428     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1429     if p-change-value > 0
     1430     then do:
     1431       if frame DIALOG-1 :width + p-change-value >
     1432           session :width-chars
     1433       then do:
     1434         assign
     1435           p-change-value = session :width-chars - frame DIALOG-1 :width
     1436         .
     1437         if p-change-value <= 0
     1438         then do:
     1439           run diasize_position-resize-button in this-procedure .
     1440           return .
     1441         end.
     1442       end.
     1443     end.
     1444     if p-change-value < 0
     1445     then do:
     1446       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
     1447       then do:
     1448         assign
     1449           p-change-value = v-diasize-orig-frame-width
     1450                          - frame DIALOG-1 :width
     1451         .
     1452         if p-change-value >= 0
     1453         then do:
     1454           run diasize_position-resize-button in this-procedure .
     1455           return .
     1456         end.
     1457       end.
     1458     end.
     1459     if p-change-value >= 0
     1460     then do:
     1461       assign
     1462         v-change-sign = 1
     1463       .
     1464     end.
     1465     else do:
     1466       assign
     1467         v-change-sign = -1
     1468       .
     1469     end.
     1470     assign
     1471       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1472     .
     1473     if p-change-value = 0
     1474     then do:
     1475       run diasize_position-resize-button in this-procedure .
     1476       return .
     1477     end.
     1478     move_block:
     1479     do
     1480     on error undo move_block, leave move_block
     1481     :
     1482       if retry
     1483       then do:
     1484         do
     1485         on error undo move_block, leave move_block
     1486         :
     1487           if p-change-value > 0
     1488           then do:
     1489             for each buf_temp-diasize-handle
     1490             on error undo, next
     1491             :
     1492               assign
     1493                 v-object-handle = buf_temp-diasize-handle.handle-value
     1494               .
     1495               if v-object-handle <> v-diasize-resize-button
     1496               then do:
     1497                 assign
     1498                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1499                 .
     1500               end.
     1501             end.
     1502             assign
     1503               v-diasize-browse-handle :width = v-browse-width
     1504             .
     1505             for each buf_temp-browse-handle
     1506               where buf_temp-browse-handle.browse-type = 'width':u
     1507             on error undo, next
     1508             :
     1509               assign
     1510                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1511               .
     1512             end.
     1513             assign
     1514               frame DIALOG-1 :width = v-frame-width
     1515             .
     1516             if frame DIALOG-1 :scrollable = true
     1517             then do:
     1518               assign
     1519                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1520               .
     1521             end.
     1522             run diasize_position-resize-button in this-procedure .
     1523           end.
     1524           else do:
     1525             if frame DIALOG-1 :scrollable = true
     1526             then do:
     1527               assign
     1528                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1529               .
     1530             end.
     1531             assign
     1532               frame DIALOG-1 :width = v-frame-width
     1533             .
     1534             for each buf_temp-browse-handle
     1535               where buf_temp-browse-handle.browse-type = 'width':u
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1540               .
     1541             end.
     1542             assign
     1543               v-diasize-browse-handle :width = v-browse-width
     1544             .
     1545             for each buf_temp-diasize-handle
     1546             on error undo, next
     1547             :
     1548               assign
     1549                 v-object-handle = buf_temp-diasize-handle.handle-value
     1550               .
     1551               if v-object-handle <> v-diasize-resize-button
     1552               then do:
     1553                 assign
     1554                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1555                 .
     1556               end.
     1557             end.
     1558             run diasize_position-resize-button in this-procedure .
     1559           end.
     1560           assign
     1561             v-diasize-change-size = false
     1562           .
     1563           leave move_block .
     1564         end.
     1565       end.
     1566       assign
     1567         v-diasize-need-full-display = true
     1568       .
     1569       if v-diasize-change-size = false
     1570       then do:
     1571         assign
     1572           v-diasize-change-size = true
     1573         .
     1574       end.
     1575       else do:
     1576         return .
     1577       end.
     1578       assign
     1579         v-frame-width = frame DIALOG-1 :width
     1580         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     1581         v-browse-width = v-diasize-browse-handle :width
     1582       .
     1583       for each buf_temp-browse-handle
     1584         where buf_temp-browse-handle.browse-type = 'width':u
     1585       :
     1586         assign
     1587           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1588         .
     1589       end.
     1590       for each buf_temp-diasize-handle
     1591       :
     1592         delete buf_temp-diasize-handle .
     1593       end.
     1594       assign
     1595         v-field-group-handle = frame DIALOG-1 :first-child
     1596       .
     1597       do while valid-handle(v-field-group-handle)
     1598       :
     1599         assign
     1600           v-object-handle = v-field-group-handle :first-child
     1601         .
     1602         do while valid-handle(v-object-handle)
     1603         :
     1604           if  v-object-handle <> v-diasize-browse-handle :handle
     1605           and v-object-handle <> v-diasize-resize-button
     1606           and can-query(v-object-handle, "row")
     1607           and can-query(v-object-handle, "height")
     1608           and ( v-object-handle :col + v-object-handle :width
     1609                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1610               )
     1611           then do:
     1612             find first buf_temp-browse-handle
     1613               where buf_temp-browse-handle.browse-type   = 'width':u
     1614                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1615               no-error .
     1616             if available buf_temp-browse-handle
     1617             then do:
     1618             end.
     1619             else do:
     1620               create buf_temp-diasize-handle .
     1621               assign
     1622                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1623                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1624               .
     1625             end.
     1626           end.
     1627           assign
     1628             v-object-handle = v-object-handle :next-sibling
     1629           .
     1630         end.
     1631         assign
     1632           v-field-group-handle = v-field-group-handle :next-sibling
     1633         .
     1634       end.
     1635       do with frame DIALOG-1
     1636       :
     1637         hide v-diasize-resize-button .
     1638         v-diasize-resize-button :row = 1.
     1639         v-diasize-resize-button :column = 1.
     1640       end.
     1641       if p-change-value > 0
     1642       then do:
     1643         if frame DIALOG-1 :scrollable = true
     1644         then do:
     1645           assign
     1646             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1647             no-error .
     1648           if error-status :error
     1649           or error-status :get-message(1) <> ""
     1650           then do:
     1651             undo move_block, retry move_block.
     1652           end.
     1653         end.
     1654         assign
     1655           frame DIALOG-1 :width = v-frame-width + p-change-value
     1656           no-error .
     1657         if error-status :error
     1658         or error-status :get-message(1) <> ""
     1659         then do:
     1660           undo move_block, retry move_block.
     1661         end.
     1662         assign
     1663           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1664         no-error .
     1665         if error-status :error
     1666         or error-status :get-message(1) <> ""
     1667         then do:
     1668           undo move_block, retry move_block.
     1669         end.
     1670         for each buf_temp-browse-handle
     1671           where buf_temp-browse-handle.browse-type = 'width':u
     1672         on error undo move_block, retry move_block
     1673         :
     1674           assign
     1675             buf_temp-browse-handle.browse-handle :width
     1676               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1677             no-error .
     1678           if error-status :error
     1679           or error-status :get-message(1) <> ""
     1680           then do:
     1681             undo move_block, retry move_block .
     1682           end.
     1683         end.
     1684         for each buf_temp-diasize-handle
     1685         on error undo move_block, retry move_block
     1686         :
     1687           assign
     1688             v-object-handle = buf_temp-diasize-handle.handle-value
     1689           .
     1690           if v-object-handle <> v-diasize-resize-button
     1691           then do:
     1692             assign
     1693               v-object-handle :col = v-object-handle :col + p-change-value
     1694               no-error .
     1695             if error-status :error
     1696             or error-status :get-message(1) <> ""
     1697             then do:
     1698               undo move_block, retry move_block .
     1699             end.
     1700           end.
     1701         end.
     1702       end.
     1703       else do:
     1704         for each buf_temp-diasize-handle
     1705         on error undo move_block, retry move_block
     1706         :
     1707           assign
     1708             v-object-handle = buf_temp-diasize-handle.handle-value
     1709           .
     1710           if v-object-handle <> v-diasize-resize-button
     1711           then do:
     1712             assign
     1713               v-object-handle :col = v-object-handle :col + p-change-value
     1714               no-error .
     1715             if error-status :error
     1716             or error-status :get-message(1) <> ""
     1717             then do:
     1718               undo move_block, retry move_block .
     1719             end.
     1720           end.
     1721         end.
     1722         for each buf_temp-browse-handle
     1723           where buf_temp-browse-handle.browse-type = 'width':u
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             buf_temp-browse-handle.browse-handle :width
     1728               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1729             no-error .
     1730           if error-status :error
     1731           or error-status :get-message(1) <> ""
     1732           then do:
     1733             undo move_block, retry move_block .
     1734           end.
     1735         end.
     1736         assign
     1737           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1738           no-error .
     1739         if error-status :error
     1740         or error-status :get-message(1) <> ""
     1741         then do:
     1742           undo move_block, retry move_block.
     1743         end.
     1744         assign
     1745           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1746         no-error .
     1747         if error-status :error
     1748         or error-status :get-message(1) <> ""
     1749         then do:
     1750           undo move_block, retry move_block.
     1751         end.
     1752         if frame DIALOG-1 :scrollable = true
     1753         then do:
     1754           assign
     1755             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1756           no-error .
     1757           if error-status :error
     1758           or error-status :get-message(1) <> ""
     1759           then do:
     1760             undo move_block, retry move_block.
     1761           end.
     1762         end.
     1763       end.
     1764       if p-move-resize
     1765       then do:
     1766         run diasize_position-resize-button in this-procedure .
     1767       end.
     1768       if v-diasize-wndstore = true
     1769       then do:
     1770         if connected("ub") = true
     1771         then do:
     1772           define variable v-cntxt-db-num        as integer   no-undo .
     1773           define variable v-cntxt-userid        as character no-undo .
     1774           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1775                                             , OUTPUT v-cntxt-userid
     1776                                             ) .
     1777           run gbl/wndsizew.p
     1778             (input  v-cntxt-db-num
     1779             ,input  v-cntxt-userid
     1780             ,input  v-diasize-proc-name
     1781             ,input  'width':u
     1782             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1783             ) .
     1784         end.
     1785       end.
     1786     end.
     1787     assign
     1788       v-diasize-change-size = false
     1789     .
     1790   end procedure.
     1791   procedure diasize_set-width :
     1792     define input  parameter p-new-width  as decimal   no-undo .
     1793     define input  parameter p-move-resize as logical   no-undo .
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       run diasize_change-width in this-procedure
     1798         (input  (p-new-width - frame DIALOG-1 :width)
     1799         ,input  p-move-resize
     1800         ) .
     1801     end.
     1802   end procedure.
     1803   procedure diasize_position-resize-button :
     1804     do with frame DIALOG-1
     1805     :
     1806       hide v-diasize-resize-button .
     1807       assign
     1808         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1809                     - 1
     1810                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1811         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1812                     - 1
     1813                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1814       .
     1815       view v-diasize-resize-button .
     1816     end.
     1817   end procedure.
     1818   on alt-right anywhere
     1819   do:
     1820     run diasize_change-width in this-procedure
     1821       (input 1
     1822       ,input true
     1823       ) .
     1824     return no-apply .
     1825   end.
     1826   on alt-left anywhere
     1827   do:
     1828     run diasize_change-width in this-procedure
     1829       (input -1
     1830       ,input true
     1831       ) .
     1832     return no-apply .
     1833   end.
     1834   on alt-down anywhere
     1835   do:
     1836     run diasize_change-height in this-procedure
     1837       (input 1
     1838       ,input true
     1839       ) .
     1840     return no-apply .
     1841   end.
     1842   on alt-up anywhere
     1843   do:
     1844     run diasize_change-height in this-procedure
     1845       (input -1
     1846       ,input true
     1847       ) .
     1848     return no-apply .
     1849   end.
     1850   on alt-enter of frame DIALOG-1
     1851   do:
     1852     run diasize_maximize in this-procedure
     1853       (input  ?
     1854       ).
     1855     return no-apply .
     1856   end.
     1857   procedure diasize_end-move :
     1858     do
     1859     on error undo, return error return-value
     1860     :
     1861       define variable v-row-delta as decimal   no-undo .
     1862       define variable v-col-delta as decimal   no-undo .
     1863       define variable v-new-row as decimal   no-undo .
     1864       define variable v-new-col as decimal   no-undo .
     1865       assign
     1866         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1867         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1868       .
     1869       assign
     1870         v-row-delta = v-new-row - frame DIALOG-1 :height
     1871         v-col-delta = v-new-col - frame DIALOG-1 :width
     1872       .
     1873       run diasize_change-height in this-procedure
     1874         (input v-row-delta
     1875         ,input true
     1876         ) .
     1877       run diasize_change-width in this-procedure
     1878         (input v-col-delta
     1879         ,input true
     1880         ) .
     1881     end.
     1882   end procedure.
     1883   procedure diasize_maximize :
     1884     define input  parameter p-action as logical   no-undo .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888       if p-action = ?
     1889       then do:
     1890         if v-diasize-need-maximize = true
     1891         then do:
     1892           assign
     1893             p-action = true
     1894           .
     1895         end.
     1896         else do:
     1897           assign
     1898             p-action = false
     1899           .
     1900         end.
     1901       end.
     1902       if p-action = true
     1903       then do:
     1904         run diasize_change-height in this-procedure
     1905           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1906               - frame DIALOG-1 :height-chars
     1907           ,input true
     1908           ) .
     1909         run diasize_change-width in this-procedure
     1910           (input session :width-chars
     1911               - frame DIALOG-1 :width-chars
     1912           ,input true
     1913           ) .
     1914         assign
     1915           v-diasize-need-maximize = false
     1916         .
     1917       end.
     1918       else do:
     1919         run diasize_change-width in this-procedure
     1920           (input v-diasize-orig-frame-width
     1921               - frame DIALOG-1 :width-chars
     1922           ,input true
     1923           ) .
     1924         run diasize_change-height in this-procedure
     1925           (input v-diasize-orig-frame-height
     1926               - frame DIALOG-1 :height-chars
     1927           ,input true
     1928           ) .
     1929         assign
     1930           v-diasize-need-maximize = true
     1931         .
     1932       end.
     1933     end.
     1934   end procedure.
     1935   procedure diasize_restore-orig-size :
     1936     do
     1937     on error undo, return error return-value
     1938     :
     1939       assign
     1940         v-diasize-current-frame-width  = frame DIALOG-1 :width
     1941         v-diasize-current-frame-height = frame DIALOG-1 :height
     1942       .
     1943       run diasize_set-height in this-procedure
     1944         (input  v-diasize-orig-frame-height
     1945         ,input  true
     1946         ) .
     1947       run diasize_set-width in this-procedure
     1948         (input  v-diasize-orig-frame-width
     1949         ,input  true
     1950         ) .
     1951     end.
     1952   end procedure.
     1953   procedure diasize_restore-current-size :
     1954     do
     1955     on error undo, return error return-value
     1956     :
     1957       run diasize_set-height in this-procedure
     1958         (input  v-diasize-current-frame-height
     1959         ,input  true
     1960         ) .
     1961       run diasize_set-width in this-procedure
     1962         (input  v-diasize-current-frame-width
     1963         ,input  true
     1964         ) .
     1965     end.
     1966   end procedure.
     1967   procedure diasize_set-browse-handle :
     1968     define input  parameter p-browse-handle as handle   no-undo .
     1969     define buffer buf_temp-browse-handle for temp-browse-handle .
     1970     do
     1971     on error undo, return error return-value
     1972     :
     1973       assign
     1974         v-diasize-browse-handle = p-browse-handle
     1975       .
     1976       for each buf_temp-browse-handle
     1977       on error undo, return error return-value
     1978       :
     1979         delete buf_temp-browse-handle .
     1980       end.
     1981     end.
     1982   end procedure.
     1983   procedure diasize_add_browse :
     1984     define input  parameter p-browse-type   as character no-undo .
     1985     define input  parameter p-browse-handle as handle    no-undo .
     1986     define buffer buf_temp-browse-handle for temp-browse-handle .
     1987     do
     1988     on error undo, return error return-value
     1989     :
     1990       assign
     1991         v-diasize-browse-number = v-diasize-browse-number + 1
     1992       .
     1993       create buf_temp-browse-handle .
     1994       assign
     1995         buf_temp-browse-handle.browse-type   = p-browse-type
     1996         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1997         buf_temp-browse-handle.browse-handle = p-browse-handle
     1998       .
     1999     end.
     2000   end procedure.
     2001   procedure diasize_init :
     2002     define variable v-default-value    as logical   no-undo .
     2003     define variable v-restore-saved    as logical   no-undo .
     2004     define variable v-resize-value-str as character no-undo .
     2005     do
     2006     on error undo, return error return-value
     2007     :
     2008       do with frame DIALOG-1
     2009       :
     2010         assign
     2011           v-diasize-orig-frame-height = frame DIALOG-1 :height
     2012           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     2013           v-diasize-browse-handle     = browse BR-fields :handle
     2014         .
     2015         create button v-diasize-resize-button
     2016         assign
     2017           parent        = frame DIALOG-1 :first-child
     2018           label         = "s"
     2019           height-pixels = 16
     2020           width-pixels  = 16
     2021           visible       = true
     2022           sensitive     = true
     2023           movable       = true
     2024           triggers:
     2025             on end-move persistent run diasize_end-move in this-procedure .
     2026           end triggers.
     2027         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2028         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2029         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2030         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2031         assign
     2032           v-diasize-wndmax = false
     2033         .
     2034         if connected("ub") = true
     2035         then do:
     2036           define variable v-cntxt-db-num        as integer   no-undo .
     2037           define variable v-cntxt-userid        as character no-undo .
     2038           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2039                                             , OUTPUT v-cntxt-userid
     2040                                             ) .
     2041           run gbl/wndpar_r.p
     2042             (input  v-cntxt-db-num
     2043             ,input  v-cntxt-userid
     2044             ,input  'wndmax':U
     2045             ,output v-diasize-wndmax
     2046             ,output v-default-value
     2047             ) .
     2048         end.
     2049         assign
     2050           v-diasize-wndstore = false
     2051         .
     2052         if connected("ub") = true
     2053         then do:
     2054           run gbl/wndpar_r.p
     2055             (input  v-cntxt-db-num
     2056             ,input  v-cntxt-userid
     2057             ,input  'wndstore':U
     2058             ,output v-diasize-wndstore
     2059             ,output v-default-value
     2060             ) .
     2061         end.
     2062         assign
     2063           v-diasize-proc-name = entry(1, program-name(2), '.')
     2064         .
     2065         if v-diasize-wndstore = true
     2066         then do:
     2067           assign
     2068             v-restore-saved = false
     2069           .
     2070           if connected("ub") = true
     2071           then do:
     2072             run gbl/wndsizer.p
     2073               (input  v-cntxt-db-num
     2074               ,input  v-cntxt-userid
     2075               ,input  v-diasize-proc-name
     2076               ,input  'height':u
     2077               ,output v-resize-value-str
     2078               ) .
     2079             if v-resize-value-str <> '':U
     2080             then do:
     2081               run diasize_change-height in this-procedure
     2082                 (input  integer(v-resize-value-str)
     2083                 ,input  true
     2084                 ) .
     2085               assign
     2086                 v-restore-saved = true
     2087               .
     2088             end.
     2089           end.
     2090           if connected("ub") = true
     2091           then do:
     2092             run gbl/wndsizer.p
     2093               (input  v-cntxt-db-num
     2094               ,input  v-cntxt-userid
     2095               ,input  v-diasize-proc-name
     2096               ,input  'width':u
     2097               ,output v-resize-value-str
     2098               ) .
     2099             if v-resize-value-str <> '':U
     2100             then do:
     2101               run diasize_change-width in this-procedure
     2102                 (input  integer(v-resize-value-str)
     2103                 ,input  true
     2104                 ) .
     2105               assign
     2106                 v-restore-saved = true
     2107               .
     2108             end.
     2109           end.
     2110           if v-restore-saved <> true
     2111           then do:
     2112             if v-diasize-wndmax = true
     2113             then do:
     2114               run diasize_maximize in this-procedure
     2115                 (input  true
     2116                 ) .
     2117             end.
     2118           end.
     2119         end.
     2120         else do:
     2121           if v-diasize-wndmax = true
     2122           then do:
     2123             run diasize_maximize in this-procedure
     2124               (input  true
     2125               ) .
     2126           end.
     2127         end.
     2128       end.
     2129     end.
     2130   end procedure.
     2131   procedure diasize_need-full-display :
     2132     define output parameter p-need-full-display as logical   no-undo .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       assign
     2137         p-need-full-display = v-diasize-need-full-display
     2138       .
     2139       assign
     2140         v-diasize-need-full-display = false
     2141       .
     2142     end.
     2143   end procedure.
     2144   procedure get-context :
     2145      define output parameter p-db-num as integer          no-undo.
     2146      define output parameter p-user-id as character        no-undo.
     2147      define variable v-login               as character    no-undo.
     2148      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2149      define buffer buf_user-login  for ub.user-login .
     2150      do
     2151      on error undo, return error
     2152      :
     2153            FIND FIRST buf_sys-ctrl no-lock.
     2154            ASSIGN
     2155               v-login = USERID("ub")
     2156               p-db-num = buf_sys-ctrl.db-num
     2157            .
     2158            FIND FIRST buf_user-login
     2159                 WHERE buf_user-login.db-num = p-db-num
     2160                   AND buf_user-login.user-login = v-login
     2161                 no-lock
     2162                 no-error
     2163                 .
     2164            IF AVAILABLE buf_user-login
     2165            THEN DO:
     2166               assign
     2167                  p-user-id = buf_user-login.user-id
     2168               .
     2169            END.
     2170      end.
     2171   end procedure.
     2172       run diasize_init in this-procedure .
     2173   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     2174     fill-in-3 = 'Доступные поля'.
     2175     fill-in-4 = 'Выбранные поля'.
     2176   MAIN-BLOCK:
     2177   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2178     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2179   IF Kl <> 0 THEN DO:
     2180      FIND FIRST ubflt.filter WHERE Num-flt = Kl.
     2181      assign
     2182      select3 = ubflt.filter.Fields-sort
     2183      select3-label = ubflt.filter.Fields-sort-rus
     2184      select3-size = ubflt.filter.Where-ysl
     2185      select3-format = ubflt.filter.Where-ysl-rus
     2186      select3-type = ubflt.filter.lst-cend
     2187      .
     2188   END.
     2189   ELSE DO:
     2190      CREATE ubflt.filter.
     2191      assign
     2192      ubflt.filter.call-point = c-point
     2193      Kl = Num-flt
     2194      .
     2195      v-new = yes.
     2196   END.
     2197   assign
     2198   jj             = 0
     2199   .
     2200   run fill-table in this-procedure no-error.
     2201   RUN MYenable.
     2202   apply "VALUE-CHANGED" to RS-tabs.
     2203   RUN PROC-N-L IN THIS-PROCEDURE.
     2204   WAIT-FOR GO OF FRAME DIALOG-1 focus br-fields.
     2205   if undo_ then undo,retry.
     2206   END.
     2207   RUN disable_UI.
     2208   PROCEDURE disable_UI :
     2209     HIDE FRAME DIALOG-1.
     2210   END PROCEDURE.
     2211   PROCEDURE enable-buttons :
     2212    if available t-f then do:
     2213       enable
     2214       btn-add
     2215       with frame DIALOG-1.
     2216     end.
     2217     if available sel_t-f then do:
     2218       enable
     2219       btn-remove
     2220       b-down b-up
     2221       with frame DIALOG-1.
     2222     end.
     2223   END PROCEDURE.
     2224   PROCEDURE enable_UI :
     2225     DISPLAY RS-tabs f-num-clmn f-length FILL-IN-4 FILL-IN-3
     2226         WITH FRAME DIALOG-1.
     2227     IF AVAILABLE ubflt.filter THEN
     2228       DISPLAY ubflt.filter.Naim
     2229         WITH FRAME DIALOG-1.
     2230     ENABLE Btn_OK RECT-1 Btn_Cancel b-help ubflt.filter.Naim RS-tabs BR-sel-fields
     2231            BR-fields
     2232         WITH FRAME DIALOG-1.
     2233     OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
     2234   END PROCEDURE.
     2235   PROCEDURE fill-table :
     2236   define variable v-label as character no-undo .
     2237   list-tabls_block:
     2238   do ii = 1 to num-entries(List-Buf):
     2239     assign
     2240     file-name = entry(ii, List-tabls).
     2241     list-dim_block:
     2242     do kk = jj + 1 to jj + int(entry(ii,List-dim)):
     2243       if file-name = "function":U OR index(entry(1, entry(kk, list-spr), '.'), "ATTR":u) > 0 then do:
     2244         create t-f.
     2245         assign
     2246         t-f.table-name = file-name
     2247         t-f.field-name = entry(kk, List-Fields)
     2248         t-f.field-type  = entry(2, entry(kk, list-spr), '.')
     2249         t-f.field-label = entry(kk,List-Labels)
     2250         t-f.field-clabel = t-f.field-label
     2251         t-f.field-spr = "":U
     2252         t-f.field-size = entry(kk,List-Size)
     2253         t-f.field-format = entry(kk,List-format, chr(4))
     2254         t-f.field-table-order = kk
     2255         .
     2256       end.
     2257       else do:
     2258         find first _File where _File-Name = file-name.
     2259         id = recid(_File).
     2260         do ll = 1 to num-entries(entry(kk, List-Fields),'*'):
     2261           find _Field no-lock where
     2262               _Field._Field-name =  entry(ll,entry(kk, List-Fields),'*')
     2263           and _Field._File-Recid = id
     2264           no-error .
     2265           if not available _Field then do:
     2266             message
     2267             vss-workfile vss-revision vss-description skip
     2268             "Неизвестное поле" entry(ll,entry(kk, List-Fields),'*') skip
     2269             "Таблица" entry(ii, List-Tabls)
     2270             view-as alert-box error .
     2271             next list-dim_block .
     2272           end.
     2273           find first t-f where
     2274                      t-f.table-name = _File._File-name
     2275                  AND t-f.field-name = entry(kk, List-Fields)
     2276           no-error.
     2277           if not available t-f then do:
     2278             create t-f.
     2279             assign
     2280             t-f.table-name = _File._File-name
     2281             t-f.field-name = entry(kk, List-Fields)
     2282             t-f.field-spr = entry(kk,List-spr)
     2283             t-f.field-size = entry(kk,List-Size)
     2284             t-f.field-format = entry(kk,List-format, chr(4))
     2285             t-f.field-table-order = kk
     2286             .
     2287           end.
     2288           if _field._label = ? then do:
     2289             assign
     2290             v-label = chr(63)
     2291             .
     2292           end.
     2293           else do:
     2294             if current-language = "english" or current-language = "romanian" then do:
     2295               if current-language = "english" then
     2296               v-label = (if entry(2,_field._desc,"`") <> ? then entry(2,_field._desc,"`") else chr(63)).
     2297               else
     2298               v-label = (if entry(3,_field._desc,"`") <> ? then entry(3,_field._desc,"`") else chr(63)).
     2299             end.
     2300             else do:
     2301               v-label = (if _field._label <> ? then _field._label else chr(63)).
     2302             end.
     2303           end.
     2304           assign
     2305           t-f.field-name-0 = t-f.field-name-0 +
     2306                              (if t-f.field-name-0 = "":U
     2307                               then "":U
     2308                               else '*':U) +
     2309                              entry(ll,entry(kk, List-Fields), '*':U)
     2310           t-f.field-label  = if entry(kk,List-Labels) <> ""
     2311                              then entry(kk,List-Labels)
     2312                              else t-f.field-label  +
     2313                              (if t-f.field-label = "":U
     2314                               then "":U
     2315                               else '*':U) +
     2316                               v-label
     2317           t-f.field-clabel = t-f.field-label
     2318           t-f.field-type   = t-f.field-type  +
     2319                              (if t-f.field-type = "":U
     2320                               then "":U
     2321                               else '*':U) +
     2322                               _field._data-type
     2323           t-f.field-format = entry(kk, list-format, chr(4))
     2324           .
     2325         end.
     2326       end.
     2327       if avail t-f then do:
     2328         assign
     2329         t-f.field-order =  lookup(t-f.table-name + ".":U + t-f.field-name, select3)
     2330         v-num-clmn = v-num-clmn +  (if   t-f.field-order > 0 then 1 else 0)
     2331         v-length = v-length + (if   t-f.field-order > 0 then integer(entry(t-f.field-order, ubflt.filter.where-ysl)) else 0)
     2332         .
     2333         assign
     2334         t-f.field-clabel = entry(kk,Select3-Label)
     2335         no-error .
     2336       end.
     2337     end.
     2338     jj = jj + int(entry(ii,List-dim)).
     2339   end.
     2340   END PROCEDURE.
     2341   PROCEDURE MyEnable :
     2342   do ii = 1 to num-entries(list-tabls):
     2343   assign
     2344   v-rb = v-rb +
     2345              (if v-rb = "":U then "":U else chr(44)) +
     2346               entry(ii, list-buf) + chr(44) + entry(ii, list-tabls) .
     2347   .
     2348   end.
     2349   assign rs-tabs:radio-buttons in frame DIALOG-1= v-rb.
     2350    DISPLAY RS-tabs FILL-IN-3 FILL-IN-4
     2351         WITH FRAME DIALOG-1.
     2352     IF AVAILABLE ubflt.filter THEN
     2353       DISPLAY ubflt.filter.Naim
     2354         WITH FRAME DIALOG-1.
     2355     ENABLE Btn_OK RECT-1 Btn_Cancel b-help ubflt.filter.Naim RS-tabs BR-fields
     2356            BR-sel-fields
     2357         WITH FRAME DIALOG-1.
     2358     OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
     2359     APPLY "Value-changed" to rs-tabs.
     2360     run enable-buttons in this-procedure.
     2361   END PROCEDURE.
     2362   PROCEDURE PROC-N-L :
     2363   display
     2364   string(v-num-clmn, ">>9") @ f-num-clmn
     2365   string(v-length, ">>>>9") @ f-length
     2366   WITH FRAME DIALOG-1.
     2367   END PROCEDURE.
