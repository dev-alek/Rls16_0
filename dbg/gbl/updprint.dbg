        1   define input parameter  c-point     as character no-undo .
        2   define input parameter  list-tabls  as character no-undo .
        3   define input parameter  list-buf    as character no-undo .
        4   define input parameter  list-fields as character no-undo .
        5   define input parameter  list-labels as character no-undo .
        6   define input parameter  list-spr    as character no-undo .
        7   define input parameter  list-size    as character no-undo .
        8   define input parameter  list-format    as character no-undo .
        9   define input parameter  list-dim    as character no-undo .
       10   define input parameter  kl          as integer   no-undo .
       11   define output parameter ident       as recid     no-undo .
       12   define output parameter P-LENGTH       as INTEGER     no-undo .
       13   define output parameter P-NUM-CLMN       as INTEGER     no-undo .
       14   def var vss-revision    as character no-undo init "$Revision$":U .
       15   def var vss-author      as character no-undo init "$Author$":U .
       16   def var vss-date        as character no-undo init "$Date$":U .
       17   def var vss-workfile    as character no-undo init "$Workfile$":U .
       18   def var vss-archive     as character no-undo init "$Archive$":U .
       19   def var vss-description as character no-undo init "Создание и редактирование шаблона печати".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38       assign
       39         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,c-point,list-tabls,list-buf,list-fields,list-labels,list-spr,list-dim,kl)
       40       .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   procedure proc-alt-shift-f2:
       93     if not ibs.th.gbl.gbl-var:rcode
       94   then
       95     run gbl\inidebug.p .
       96   end.
       97   procedure proc-alt-shift-f3:
       98     run gbl/prvssinf.p
       99       ( input this-procedure
      100       ) .
      101   end.
      102   define variable v-inform-launched as logical no-undo initial false .
      103   procedure proc-alt-shift-f4:
      104     define variable v-action as character no-undo .
      105     if v-inform-launched = false then do:
      106       assign
      107         v-inform-launched = true
      108       .
      109       run gbl/d-inform.w
      110         (  input self
      111         ,  input this-procedure
      112         , output v-action
      113         ) no-error .
      114       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      115       assign
      116         v-inform-launched = false
      117       .
      118     end.
      119   end.
      120   procedure proc-alt-f1:
      121     run gbl/corrhelp.p
      122       (input this-procedure
      123       ) .
      124   end .
      125   on alt-shift-f2 anywhere do:
      126     run proc-alt-shift-f2.
      127   end.
      128   on alt-shift-f3 anywhere do:
      129     run proc-alt-shift-f3 in this-procedure .
      130   end.
      131   on alt-shift-f4 anywhere do:
      132     run proc-alt-shift-f4 in this-procedure.
      133   end.
      134   on alt-f1 anywhere do:
      135     run proc-alt-f1 in this-procedure .
      136   end.
      137   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   procedure factord :
      139     define input  parameter p-fact-date            as date    no-undo .
      140     define input  parameter p-fact-time            as integer no-undo .
      141     define input  parameter p-fact-num             as integer no-undo .
      142     define input  parameter p-shift-date           as date    no-undo .
      143     define input  parameter p-shift-num            as integer no-undo .
      144     define input  parameter p-shift-on             as logical no-undo .
      145     define output parameter p-fact-order           as decimal no-undo .
      146     define output parameter p-shift-end-fact-order as decimal no-undo .
      147     define output parameter p-day-end-fact-order   as decimal no-undo .
      148     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      149     if p-fact-date = ?
      150     then do:
      151       return error "Не указана фактическая дата" .
      152     end.
      153     define variable v-fact-date-num as integer no-undo .
      154     assign
      155       v-fact-date-num = integer(p-fact-date)
      156     .
      157     if p-fact-num = ?
      158     or p-fact-num = 0
      159     then do:
      160       return error "Не задан p-fact-num " + string(p-fact-num) .
      161     end.
      162     if p-fact-num < 0
      163     then do:
      164       return error "Отрицательный fact-num " + string(p-fact-num) .
      165     end.
      166     if p-fact-num >= 100000000
      167     then do:
      168       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      169     end.
      170     if p-shift-on = true
      171     then do:
      172       if p-shift-date = ?
      173       then do:
      174         return error "Не задана дата смены" .
      175       end.
      176       if p-shift-num = ?
      177       or p-shift-num = 0
      178       then do:
      179         return error "Не задан номер смены" .
      180       end.
      181     end.
      182     else do:
      183       assign
      184         p-shift-date = p-fact-date
      185         p-shift-num  = 24
      186       .
      187     end.
      188     define variable v-shift-offset as integer no-undo .
      189     if p-shift-date = p-fact-date
      190     then do:
      191       assign
      192         v-shift-offset = 1
      193       .
      194     end.
      195     if p-shift-date < p-fact-date
      196     then do:
      197       assign
      198         v-shift-offset = 0
      199       .
      200     end.
      201     if p-shift-date > p-fact-date
      202     then do:
      203       message
      204         vss-workfile vss-revision vss-description skip
      205         "Неправильная дата закрытия смены" skip
      206         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      207         view-as alert-box error .
      208       undo, return error
      209         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      210           ,string(p-fact-date, '99/99/9999':U)
      211           ,string(p-shift-date, '99/99/9999':U)
      212           )
      213       .
      214     end.
      215     if p-shift-num < 1
      216     or p-shift-num > 24
      217     then do:
      218       message
      219         vss-workfile vss-revision vss-description skip
      220         "Неправильный номер смены" skip
      221         "p-shift-num" p-shift-num skip
      222         view-as alert-box error .
      223       undo, return error return-value .
      224     end.
      225     assign
      226       p-fact-order           = v-fact-date-num
      227                              + v-shift-offset * 0.5
      228                              + p-shift-num    * 0.02 - 0.01
      229                              + p-fact-num     * 0.0000000001
      230       p-shift-end-fact-order = v-fact-date-num
      231                              + v-shift-offset * 0.5
      232                              + p-shift-num    * 0.02
      233       p-day-end-fact-order   = v-fact-date-num
      234                              + 0.99
      235     .
      236     if p-fact-order           <= v-fact-date-num
      237     or p-shift-end-fact-order <= v-fact-date-num
      238     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      239     or p-shift-end-fact-order >= p-day-end-fact-order
      240     then do:
      241       message
      242         vss-workfile vss-revision vss-description skip
      243         "Внутренняя ошибка при генерации фактического номера" skip
      244         "p-fact-date"            p-fact-date            skip
      245         "p-fact-time"            p-fact-time            skip
      246         "p-fact-num"             p-fact-num             skip
      247         "p-shift-date"           p-shift-date           skip
      248         "p-shift-num"            p-shift-num            skip
      249         "p-shift-on"             p-shift-on             skip
      250         "p-shift-end-fact-order" p-shift-end-fact-order skip
      251         "p-day-end-fact-order"   p-day-end-fact-order   skip
      252         "v-fact-date-num"        v-fact-date-num        skip
      253         view-as alert-box error .
      254       undo, return error return-value .
      255     end.
      256   end procedure.
      257   procedure day-begin-fact-order :
      258     define input  parameter p-fact-date            as date    no-undo .
      259     define output parameter p-day-begin-fact-order as decimal no-undo .
      260     do
      261     on error undo, return error return-value
      262     :
      263       if p-fact-date = ?
      264       then do:
      265         assign
      266           p-day-begin-fact-order = 0
      267         .
      268       end.
      269       else do:
      270         assign
      271           p-day-begin-fact-order = integer(p-fact-date)
      272         .
      273       end.
      274     end.
      275   end procedure.
      276   procedure factord-max-fact-order :
      277     define output parameter p-max-fact-order as decimal   no-undo .
      278     do
      279     on error undo, return error return-value
      280     :
      281       run day-begin-fact-order in this-procedure
      282         (input  date(1, 1, 5000)
      283         ,output p-max-fact-order
      284         ) .
      285     end.
      286   end procedure.
      287   procedure factord-cut-archive :
      288     define input  parameter p-obj-type             as character no-undo .
      289     define input  parameter p-obj-code             as integer   no-undo .
      290     define input  parameter p-fact-date            as date      no-undo .
      291     define output parameter p-shift-on             as logical   no-undo .
      292     define output parameter p-shift-date           as date      no-undo .
      293     define output parameter p-shift-num            as integer   no-undo .
      294     define output parameter p-day-end-fact-order   as decimal   no-undo .
      295     define output parameter p-shift-end-fact-order as decimal   no-undo .
      296     define variable v-fact-order as decimal   no-undo .
      297     define buffer buf_shift-obj for ub.shift-obj .
      298     do
      299     on error undo, return error return-value
      300     :
      301   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      303     (input  p-obj-type
      304     ,input  p-obj-code
      305     ,input  'shift-on=request'
      306     ,output p-shift-on
      307     ) no-error .
      308       if error-status :error
      309       then do:
      310         message
      311           vss-workfile vss-revision vss-description skip
      312           "Ошибка при определении атрибута объекта" skip
      313           "Объект" p-obj-type p-obj-code skip
      314           error-status :get-message(1) skip
      315           return-value skip
      316           view-as alert-box error .
      317         undo, return error return-value .
      318       end.
      319       if p-shift-on = false
      320       then do:
      321         assign
      322           p-shift-date               = ?
      323           p-shift-num                = 0
      324         .
      325       end.
      326       else do:
      327         find first buf_shift-obj share-lock
      328           where buf_shift-obj.obj-type   = p-obj-type
      329             and buf_shift-obj.obj-code   = p-obj-code
      330             and buf_shift-obj.shift-date > p-fact-date
      331           use-index pi
      332           no-error .
      333         if not available buf_shift-obj
      334         or buf_shift-obj.status_ <> 'зкр':U
      335         then do:
      336           message
      337             vss-workfile vss-revision vss-description skip
      338             "Невозможно вычислить последнюю смену" skip
      339             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      340             "Объект" p-obj-type p-obj-code skip
      341             "Дата" p-fact-date skip
      342             view-as alert-box error .
      343           undo, return error return-value .
      344         end.
      345         find last buf_shift-obj share-lock
      346           where buf_shift-obj.obj-type = p-obj-type
      347             and buf_shift-obj.obj-code = p-obj-code
      348             and buf_shift-obj.shift-date <= p-fact-date
      349           use-index pi
      350           no-error .
      351         if available buf_shift-obj
      352         then do:
      353           if  buf_shift-obj.status_ = 'зкр':U
      354           then do:
      355             assign
      356               p-shift-date = buf_shift-obj.shift-date
      357               p-shift-num  = buf_shift-obj.shift-num
      358             .
      359           end.
      360           else do:
      361             message
      362               vss-workfile vss-revision vss-description skip
      363               "Невозможно вычислить последнюю смену" skip
      364               "Статус смены отличен от статуса" 'зкр':U skip
      365               "Объект" p-obj-type p-obj-code skip
      366               "Дата" p-fact-date skip
      367               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      368               view-as alert-box error .
      369             undo, return error return-value .
      370           end.
      371         end.
      372         else do:
      373           assign
      374             p-shift-date = p-fact-date - 1
      375             p-shift-num  = 1
      376           .
      377         end.
      378       end.
      379       run factord in this-procedure
      380         (input  p-fact-date
      381         ,input  1
      382         ,input  1
      383         ,input  p-shift-date
      384         ,input  p-shift-num
      385         ,input  p-shift-on
      386         ,output v-fact-order
      387         ,output p-shift-end-fact-order
      388         ,output p-day-end-fact-order
      389         ) no-error .
      390       if error-status :error
      391       then do:
      392         message
      393           vss-workfile vss-revision vss-description skip
      394           "Ошибка при вызове процедуры factord"
      395           error-status :get-message(1) skip
      396           return-value skip
      397           view-as alert-box error .
      398         undo, return error return-value .
      399       end.
      400     end.
      401   end procedure.
      402   procedure factord-lock-shift :
      403     define input  parameter p-obj-type  as character no-undo .
      404     define input  parameter p-obj-code  as integer   no-undo .
      405     define input  parameter p-fact-date as date      no-undo .
      406     define parameter buffer buf_shift-obj for ub.shift-obj .
      407     define variable v-shift-on      as logical   no-undo .
      408     define variable v-extra-message as character no-undo .
      409     define variable v-error as character no-undo .
      410     do
      411     on error undo, return error return-value
      412     :
      413   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      415     (input  p-obj-type
      416     ,input  p-obj-code
      417     ,input  'shift-on=request'
      418     ,output v-shift-on
      419     ) no-error .
      420       if error-status :error
      421       then do:
      422         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      423         undo, return error v-error .
      424       end.
      425       if v-shift-on = true
      426       then do:
      427         find first buf_shift-obj share-lock
      428           where buf_shift-obj.obj-type   = p-obj-type
      429             and buf_shift-obj.obj-code   = p-obj-code
      430             and buf_shift-obj.shift-date > p-fact-date
      431           use-index pi
      432           no-error .
      433         if not available buf_shift-obj
      434         or buf_shift-obj.status_ <> 'зкр':U
      435         then do:
      436           find last buf_shift-obj
      437             where buf_shift-obj.obj-type = p-obj-type
      438               and buf_shift-obj.obj-code = p-obj-code
      439               and buf_shift-obj.status_  = 'зкр':U
      440             use-index stts
      441             no-error .
      442           if available buf_shift-obj
      443           then do:
      444             assign
      445               v-extra-message =
      446                     substitute("Дата начала последеней закрытой смены на объекте &1"
      447                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      448                               )
      449             .
      450           end.
      451           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      452           undo, return error v-error .
      453         end.
      454       end.
      455     end.
      456   end procedure.
      457   procedure factord-end-day :
      458     define input  parameter p-fact-date            as date    no-undo .
      459     define output parameter p-day-end-fact-order   as decimal no-undo .
      460     do
      461     on error undo, return error return-value
      462     :
      463       if p-fact-date = ?
      464       then do:
      465         return error "Не указана фактическая дата" .
      466       end.
      467       assign
      468         p-day-end-fact-order = integer(p-fact-date) + 0.99
      469       .
      470     end.
      471   end procedure.
      472   procedure factord-to-date :
      473     define input  parameter p-fact-order as decimal no-undo .
      474     define output parameter p-fact-date  as date    no-undo .
      475     define variable v-ref-date  as date      no-undo .
      476     define variable v-ref-delta as integer   no-undo .
      477     do
      478     on error undo, return error return-value
      479     :
      480       if p-fact-order = ?
      481       or p-fact-order = 0
      482       then do:
      483         return error "Не указан fact-order" .
      484       end.
      485       assign
      486         v-ref-date  = date(1, 1, 2000)
      487       .
      488       assign
      489         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      490       .
      491       assign
      492         p-fact-date = v-ref-date + v-ref-delta
      493       .
      494     end.
      495   end procedure.
      496   procedure factord-to-fact-num :
      497     define input  parameter p-fact-order as decimal no-undo .
      498     define output parameter p-fact-num   as integer no-undo .
      499     define variable v-fact-order-trunc as decimal no-undo .
      500     do
      501     on error undo, return error return-value
      502     :
      503       if p-fact-order = ?
      504       or p-fact-order = 0
      505       then do:
      506         return error "Не указан fact-order" .
      507       end.
      508       assign
      509        v-fact-order-trunc = truncate(p-fact-order, 2)
      510       .
      511       assign
      512         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      513       .
      514     end.
      515   end procedure.
      516   procedure factord-to-shift-num :
      517     define input  parameter p-fact-order as decimal no-undo .
      518     define output parameter p-shift-num   as integer no-undo .
      519     define variable  p-shift-numd  as decimal   no-undo .
      520     define variable v-fact-order-trunc as decimal no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524       if p-fact-order = ?
      525       or p-fact-order = 0
      526       then do:
      527         return error "Не указан fact-order" .
      528       end.
      529       assign
      530        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      531       .
      532       if v-fact-order-trunc < 0.5 then do:
      533         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      534       end.
      535       assign
      536         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      537         .
      538        assign
      539         p-shift-num = truncate (p-shift-numd , 0)
      540       .
      541     end.
      542   end procedure.
      543   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   FUNCTION yearofst RETURNS integer
      545     ( input p-year as integer ) :
      546   DEFINE VARIABLE v-year-true as integer no-undo .
      547   DEFINE VARIABLE v-y-o as integer no-undo .
      548   DEFINE VARIABLE v-ost as integer no-undo .
      549   if p-year < 0 or p-year > 99 then return ?.
      550   assign
      551   v-y-o = session:year-offset
      552   v-ost = (v-y-o MODULO 100)
      553   v-year-true = (if p-year < v-ost
      554                  then (v-y-o + (v-y-o MODULO 100) + p-year)
      555                  else (v-y-o - v-ost + p-year))
      556   .
      557   return v-year-true.
      558   END FUNCTION.
      559   def new shared var undo_ as logical initial no.
      560   DEF VAR select3 AS CHARACTER INITIAL "" no-undo.
      561   def var select3-size as character no-undo .
      562   def var select3-format as character no-undo .
      563   def var select3-type as character no-undo .
      564   def var select3-label as character no-undo .
      565   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   define temp-table t-f no-undo
      567   field table-name as character
      568   field field-name as character
      569   field field-name-0 as character
      570   field field-format as character
      571   field field-type as character
      572   field field-size as character
      573   field field-csize as integer
      574   field field-label as character
      575   field field-clabel as character
      576   field field-spr as character
      577   field field-table-order as integer
      578   field field-order as integer
      579   index pi is unique primary
      580   table-name
      581   field-name
      582   index iorder
      583   field-order
      584   index itorder
      585   table-name
      586   field-table-order
      587   .
      588   define buffer sel_t-f for t-f.
      589   def var v-rb as character no-undo.
      590   DEF VAR ii AS INTEGER no-undo.
      591   DEF VAR jj AS INTEGER no-undo.
      592   DEF VAR kk AS INTEGER no-undo.
      593   DEF VAR ll AS INTEGER no-undo.
      594   DEF VAR id AS RECID no-undo.
      595   DEF VAR file-name LIKE _FILE-NAME no-undo.
      596   define variable v-new as logical no-undo .
      597   define variable v-length as integer no-undo.
      598   define variable v-num-clmn as integer no-undo.
      599   DEFINE BUTTON b-down
      600        LABEL "Вни&з":L
      601        SIZE 8.5 BY 1.17 TOOLTIP "Понизить порядок выбранного поля".
      602   DEFINE BUTTON b-help DEFAULT
      603        LABEL "Помо&щь":L
      604        SIZE 10 BY 1
      605        BGCOLOR 8 .
      606   DEFINE BUTTON b-up
      607        LABEL "Ввер&х":L
      608        SIZE 8.5 BY 1.17 TOOLTIP "Повысить порядок выбранного поля".
      609   DEFINE BUTTON btn-add
      610        LABEL "&Добавить":L
      611        SIZE 8.5 BY 1.25 TOOLTIP "Добавить поле в список сортируемых полей".
      612   DEFINE BUTTON btn-remove
      613        LABEL "У&брать":L
      614        SIZE 8.5 BY 1.17 TOOLTIP "Убрать поле из списка сортируемых полей".
      615   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      616        LABEL "&Отмена ":L
      617        SIZE 10 BY 1 TOOLTIP "Выход без изменений"
      618        BGCOLOR 8 .
      619   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      620        LABEL "&Сохранить":L
      621        SIZE 10 BY 1 TOOLTIP "Сохранить сформированный фильтр"
      622        BGCOLOR 8 .
      623   DEFINE VARIABLE f-length AS CHARACTER FORMAT "X(5)":U
      624        VIEW-AS FILL-IN
      625        SIZE 9.13 BY 1 NO-UNDO.
      626   DEFINE VARIABLE f-num-clmn AS CHARACTER FORMAT "X(3)":U
      627        VIEW-AS FILL-IN
      628        SIZE 6.13 BY 1 NO-UNDO.
      629   DEFINE VARIABLE FILL-IN-3 AS CHARACTER FORMAT "X(256)":U
      630        VIEW-AS FILL-IN
      631        SIZE 40 BY 1
      632        BGCOLOR 1 FGCOLOR 15  NO-UNDO.
      633   DEFINE VARIABLE FILL-IN-4 AS CHARACTER FORMAT "X(256)":U
      634        VIEW-AS FILL-IN
      635        SIZE 40 BY 1
      636        BGCOLOR 1 FGCOLOR 15  NO-UNDO.
      637   DEFINE VARIABLE RS-tabs AS CHARACTER
      638        VIEW-AS RADIO-SET HORIZONTAL
      639        RADIO-BUTTONS
      640             "Item 1", "1",
      641   "Item 2", "2",
      642   "Item 3", "3",
      643   "Item 4", "4"
      644        SIZE 97.38 BY .79 NO-UNDO.
      645   DEFINE RECTANGLE RECT-1
      646        EDGE-PIXELS 2 GRAPHIC-EDGE
      647        SIZE 98.75 BY 1.88
      648        BGCOLOR 8 FGCOLOR 8 .
      649   DEFINE QUERY BR-fields FOR
