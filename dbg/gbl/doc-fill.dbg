      227       end.
      228       glog = query inkas-fill:handle:query-open() no-error.
      229       if not glog
      230       or error-status:error then do:
      231         message
      232         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      233                   , chr(10)
      234                   , error-status:get-message(1)
      235                   , p-filter-var)
      236         view-as alert-box error .
      237         undo, return error .
      238       end.
      239       REPEAT WITH FRAME abc:
      240         query inkas-fill:handle:GET-NEXT().
      241         IF query inkas-fill:handle:QUERY-OFF-END THEN LEAVE.
      242         process events.
      243         run ex-doc in this-procedure ( input 2, input rs-list-method, input rs-status, input line-mode) .
      244       end.
      245       glog = query inkas-fill:handle:query-close() no-error.
      246     end.
      247     when 'fbr-doc':U then do:
      248       v-prepare-string = substitute('for each fbr-doc no-lock where fbr-doc.host-code = &1 ' +
      249                                      p-filter-var
      250                                     , p-curr-host-code
      251                                     ).
      252       glog = query fbr-doc-fill:handle:query-prepare(v-prepare-string) no-error.
      253       if not glog
