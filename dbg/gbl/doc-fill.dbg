      127   define variable dsp-rs as character format "x(50)" no-undo.
      128   define variable v-prepare-string as character no-undo .
      129   define variable glog as logical no-undo .
      130   define query trn-doc-fill for ub.trn-doc.
      131   define query price-doc-fill for ub.price-doc.
      132   define query inkas-fill for ub.inkas.
      133   define query fbr-doc-fill for ub.fbr-doc.
      134   define frame abc
      135   dsp-rs no-label
      136   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      137   TITLE par-run-name.
      138   view frame abc.
      139   display dsp-rs
      140   with frame abc.
      141   case p-table-name:
      142     when 'trn-doc':U then do:
      143       v-prepare-string = substitute('for each trn-doc no-lock where trn-doc.host-code = &1 ' +
      144                                      p-filter-var
      145                                     , p-curr-host-code
      146                                     ).
      147       glog = query trn-doc-fill:handle:query-prepare(v-prepare-string) no-error.
      148       if not glog
      149       or error-status:error then do:
      150         message
      151         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      152                   , chr(10)
      153                   , error-status:get-message(1)
      154                   , p-filter-var)
      155         view-as alert-box error .
      156         undo, return error .
      157       end.
      158       glog = query trn-doc-fill:handle:query-open() no-error.
      159       if not glog
      160       or error-status:error then do:
      161         message
      162         substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      163                   , chr(10)
      164                   , error-status:get-message(1)
      165                   , p-filter-var)
      166         view-as alert-box error .
      167         undo, return error .
      168       end.
      169       REPEAT WITH FRAME abc:
      170          query trn-doc-fill:handle:GET-NEXT().
      171          IF query trn-doc-fill:handle:QUERY-OFF-END THEN LEAVE.
      172          process events.
      173          run ex-doc in this-procedure ( input 1, input rs-list-method, input rs-status, input line-mode) .
      174       end.
      175       glog = query trn-doc-fill:handle:query-close() no-error.
      176     end.
      177     when 'price-doc':U then do:
      178       v-prepare-string = substitute('for each price-doc no-lock where price-doc.host-code = &1 ' +
      179                                      p-filter-var
      180                                     , p-curr-host-code
      181                                     ).
      182       glog = query price-doc-fill:handle:query-prepare(v-prepare-string) no-error.
      183       if not glog
