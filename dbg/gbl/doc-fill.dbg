      434     doc-list.obj-code   = ub.c-trn-doc.obj-code
      435     doc-list.fact-num   = ub.c-trn-doc.fact-num
      436     doc-list.doc-date   = ub.c-trn-doc.doc-date
      437     doc-list.fact-date  = ub.c-trn-doc.fact-date
      438     doc-list.shift-date = ub.c-trn-doc.shift-date
      439     doc-list.shift-num  = ub.c-trn-doc.shift-num
      440     doc-list.fact-order = ub.c-trn-doc.fact-order
      441     doc-list.is-trn-doc = yes
      442     doc-list.doc-type   = "-" + ub.c-trn-doc.doc-type
      443     doc-list.ext-doc-type   = ub.c-trn-doc.ext-doc-type
      444     doc-list.is-del     = yes
      445     doc-list.sel-order  = v-sel-order
      446     doc-list.znak       = if can-do ('рас,спи':U, doc-list.doc-type) then -1 else 1
      447     doc-list.to-del = no
      448     .
      449     assign
      450       lns-cnt = lns-cnt + 1
      451       line-rec = recid (doc-list)
      452     .
      453   end.
      454           end.
      455           when 0 then do:
      456   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      457   find doc-list
      458     where doc-list.doc-code = ub.price-doc.doc-num
      459       and doc-list.doc-type = 'переоценка':U
      460     no-error .
      461   if available doc-list then do:
      462     assign
      463       doc-list.to-del = no
      464     .
      465   end.
      466   else do:
      467     if ub.price-doc.host-code <> p-curr-host-code then return.
      468     create doc-list .
      469     assign
      470     doc-list.doc-code   = ub.price-doc.doc-num
      471     doc-list.obj-type   = ub.price-doc.obj-type
      472     doc-list.obj-code   = ub.price-doc.obj-code
      473     doc-list.fact-num   = ub.price-doc.fact-num
      474     doc-list.fact-date  = ub.price-doc.fact-date
      475     doc-list.shift-date = ub.price-doc.shift-date
      476     doc-list.shift-num  = ub.price-doc.shift-num
      477     doc-list.fact-order = ub.price-doc.fact-order
      478     doc-list.is-trn-doc = no
      479     doc-list.is-del     = no
      480     doc-list.doc-type   = 'переоценка':U
      481     doc-list.ext-doc-type   = 'ot':U
      482     doc-list.sel-order  = v-sel-order
      483     doc-list.znak       = 1
      484     doc-list.to-del = no
      485     .
      486     assign
      487       lns-cnt = lns-cnt + 1
      488       line-rec = recid (doc-list)
      489     .
      490   end.
      491           end.
      492           when 2 then do:
      493   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   find doc-list
      495     where doc-list.doc-code = ub.inkas.inkas-code
      496     and doc-list.doc-type = 'касс':U
      497     no-error .
      498   find first inkas_trn-doc where
      499              inkas_trn-doc.doc-code = ub.inkas.inkas-code no-error .
      500   if available doc-list then do:
      501     assign
      502       doc-list.to-del = no
      503     .
      504   end.
      505   else do:
      506     if ub.inkas.host-code <> p-curr-host-code then return.
      507     create doc-list .
