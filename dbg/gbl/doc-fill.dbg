        1   block-level on error undo, throw.
        2   define input parameter pis-trn-doc as integer no-undo .
        3   define input parameter rs-list-method as character no-undo .
        4   define input parameter par-run-name as character no-undo .
        5   define input parameter rs-status as character no-undo .
