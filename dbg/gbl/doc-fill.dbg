      202         undo, return error .
      203       end.
      204       REPEAT WITH FRAME abc:
      205         query price-doc-fill:handle:GET-NEXT().
      206         IF query price-doc-fill:handle:QUERY-OFF-END THEN LEAVE.
      207         process events.
      208         run ex-doc in this-procedure ( input 0, input rs-list-method, input rs-status, input line-mode) .
      209       end.
      210       glog = query price-doc-fill:handle:query-close() no-error.
      211     end.
      212     when 'inkas':U then do:
      213       v-prepare-string = substitute('for each inkas no-lock where inkas.host-code = &1 ' +
      214                                      p-filter-var
      215                                     , p-curr-host-code
