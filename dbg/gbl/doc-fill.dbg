      281     end.
      282   end case.
      283   hide frame abc.
      284   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      285   PROCEDURE ex-doc :
      286   DEFINE INPUT PARAMETER loc-is-trn-doc as integer no-undo.
      287   define input parameter rs-list-method as character no-undo .
      288   define input parameter rs-status as character no-undo .
      289   define input parameter line-mode as character no-undo .
      290     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
      291       CASE loc-is-trn-doc:
      292         when 1 then do:
      293           if ub.trn-doc.host-code <> p-curr-host-code then return.
      294           find first doc-list where
      295                     doc-list.doc-code = ub.trn-doc.doc-code
      296                and  doc-list.doc-type = ub.trn-doc.doc-type
      297                     no-error.
      298         end.
      299         when 101 then do:
      300           if ub.c-trn-doc.host-code <> p-curr-host-code then return.
      301           find first doc-list where
      302                     doc-list.doc-code = ub.c-trn-doc.doc-code
      303                and  doc-list.doc-type = "-" + ub.c-trn-doc.doc-type
      304                     no-error.
      305         end.
      306         when 0 then do:
      307           if ub.price-doc.host-code <> p-curr-host-code then return.
      308           find first doc-list where
      309                     doc-list.doc-code = ub.price-doc.doc-num
      310                and  doc-list.doc-type = 'переоценка':U
      311                     no-error.
      312         end.
      313         when 2 then do:
      314           if ub.inkas.host-code <> p-curr-host-code then return.
      315           find first doc-list where
      316                     doc-list.doc-code = ub.inkas.inkas-code
      317                and  doc-list.doc-type = 'касс':U
      318                     no-error.
      319         end.
      320         when 102 then do:
      321           if ub.c-inkas.host-code <> p-curr-host-code then return.
      322           find first doc-list where
      323                     doc-list.doc-code = ub.c-inkas.inkas-code
      324                and  doc-list.doc-type = "-" + 'касс':U
      325                     no-error.
      326         end.
      327         when 3 then do:
      328           if ub.fbr-doc.host-code <> p-curr-host-code then return.
      329           find first doc-list where
      330                     doc-list.doc-code = ub.fbr-doc.doc-code
      331                and  doc-list.doc-type = 'производство':U
      332                     no-error.
      333         end.
      334         when 4 then do:
      335           message
      336           ub.ord-doc.host-code <> p-curr-host-code
      337           view-as alert-box .
      338           if ub.ord-doc.host-code <> p-curr-host-code then return.
      339           find first doc-list where
      340                     doc-list.doc-code = ub.ord-doc.doc-code
      341                and  doc-list.doc-type = ub.ord-doc.doc-type
      342                     no-error.
      343         end.
      344       end CASE.
      345       if available doc-list then do:
      346         if line-mode = 'удаление':U then do:
      347            lns-cnt = lns-cnt + 1.
      348            delete doc-list.
      349         end.
      350         if line-mode = 'ОСТАВИТЬ':U then do:
      351           if doc-list.to-del = ? then .
      352           else do:
      353             lns-cnt = lns-cnt + 1.
      354             doc-list.to-del = ?.
      355           end.
      356         end.
      357       end.
      358     end.
      359     else
      360       if line-mode = 'ДОБАВЛЕНИЕ':U
      361       then do:
      362         define variable v-sel-order as integer   no-undo .
      363         define buffer buf_sel_order_doc-list for doc-list .
      364         find last buf_sel_order_doc-list
      365           use-index sel-order
      366           no-error .
      367         if available buf_sel_order_doc-list
      368         then do:
      369           assign
      370             v-sel-order = buf_sel_order_doc-list.sel-order + 1
      371           .
      372         end.
      373         else do:
      374           assign
      375             v-sel-order = 1
      376           .
      377         end.
      378         CASE loc-is-trn-doc:
      379           when 1 then do:
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   find doc-list
      382     where doc-list.doc-code = ub.trn-doc.doc-code
      383       and doc-list.doc-type = ub.trn-doc.doc-type
      384     no-error .
      385   if available doc-list then do:
      386     assign
      387       doc-list.to-del = no
      388     .
      389   end.
      390   else do:
      391     if ub.trn-doc.host-code <> p-curr-host-code then return.
      392     create doc-list .
      393     assign
      394     doc-list.doc-code   = ub.trn-doc.doc-code
      395     doc-list.obj-type   = ub.trn-doc.obj-type
      396     doc-list.obj-code   = ub.trn-doc.obj-code
      397     doc-list.fact-num   = ub.trn-doc.fact-num
      398     doc-list.doc-date   = ub.trn-doc.doc-date
      399     doc-list.fact-date  = ub.trn-doc.fact-date
      400     doc-list.shift-date = ub.trn-doc.shift-date
      401     doc-list.shift-num  = ub.trn-doc.shift-num
      402     doc-list.fact-order = ub.trn-doc.fact-order
      403     doc-list.is-trn-doc = yes
      404     doc-list.is-del     = no
      405     doc-list.doc-type   = ub.trn-doc.doc-type
      406     doc-list.ext-doc-type   = ub.trn-doc.ext-doc-type
      407     doc-list.sel-order  = v-sel-order
      408     doc-list.znak       = if can-do ('рас,спи':U, doc-list.doc-type) then -1 else 1
      409     doc-list.to-del = no
      410     .
      411     assign
      412       lns-cnt = lns-cnt + 1
      413       line-rec = recid (doc-list)
      414     .
      415   end.
      416           end.
      417           when 101 then do:
      418   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   find doc-list
      420     where doc-list.doc-code = ub.c-trn-doc.doc-code
      421       and doc-list.doc-type = "-" + ub.c-trn-doc.doc-type
      422     no-error .
      423   if available doc-list then do:
