        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Редактирование пользовательских параметров настройки интерфейса".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   procedure proc-alt-shift-f2:
       62     if not ibs.th.gbl.gbl-var:rcode
       63   then
       64     run gbl\inidebug.p .
       65   end.
       66   procedure proc-alt-shift-f3:
       67     run gbl/prvssinf.p
       68       ( input this-procedure
       69       ) .
       70   end.
       71   define variable v-inform-launched as logical no-undo initial false .
       72   procedure proc-alt-shift-f4:
       73     define variable v-action as character no-undo .
       74     if v-inform-launched = false then do:
       75       assign
       76         v-inform-launched = true
       77       .
       78       run gbl/d-inform.w
       79         (  input self
       80         ,  input this-procedure
       81         , output v-action
       82         ) no-error .
       83       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       84       assign
       85         v-inform-launched = false
       86       .
       87     end.
       88   end.
       89   procedure proc-alt-f1:
       90     run gbl/corrhelp.p
       91       (input this-procedure
       92       ) .
       93   end .
       94   on alt-shift-f2 anywhere do:
       95     run proc-alt-shift-f2.
       96   end.
       97   on alt-shift-f3 anywhere do:
       98     run proc-alt-shift-f3 in this-procedure .
       99   end.
      100   on alt-shift-f4 anywhere do:
      101     run proc-alt-shift-f4 in this-procedure.
      102   end.
      103   on alt-f1 anywhere do:
      104     run proc-alt-f1 in this-procedure .
      105   end.
      106   define new global shared variable g#language as character no-undo .
      107   if g#language <> '' and g#language <> 'rus':U then do:
      108     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      109   end.
      110   define new global shared variable g#library  as handle no-undo .
      111   define new global shared variable g#library2 as handle no-undo .
      112   define   shared variable g#auto as logical no-undo.
      113   define   shared variable g#news as logical no-undo.
      114   define   shared variable g#oxml as logical no-undo.
      115   define   shared variable g#esys as logical no-undo.
      116   define   shared variable g#news-source-db as integer no-undo.
      117   define   shared variable g#esys-source-esys as integer no-undo.
      118   define   shared variable g#db-num as integer   no-undo .
      119   define   shared variable g#userid as character no-undo .
      120   define   shared variable g#passwd as character no-undo .
      121   DEFINE BUTTON b-default
      122        LABEL "&По умолчанию"
      123        SIZE 15 BY 1.
      124   DEFINE BUTTON b-delete-size
      125        LABEL "&Удалить размеры"
      126        SIZE 17 BY 1.
      127   DEFINE BUTTON b-exit AUTO-GO
      128        LABEL "&Выход"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-help
      132        LABEL "Помо&щь"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE VARIABLE fi-description AS CHARACTER FORMAT "X(256)":U INITIAL "ПАРАМЕТРЫ ОКНА"
      136         VIEW-AS TEXT
      137        SIZE 15 BY .67
      138        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      139   DEFINE RECTANGLE RECT-1
      140        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      141        SIZE 74.5 BY 3.5.
      142   DEFINE VARIABLE tb-wndmax AS LOGICAL INITIAL no
      143        LABEL "Максимизировать при открытии и восстановливать сохранённые параметры"
      144        VIEW-AS TOGGLE-BOX
      145        SIZE 72 BY .83 NO-UNDO.
      146   DEFINE VARIABLE tb-wndstore AS LOGICAL INITIAL no
      147        LABEL "Сохранять внешний вид окна"
      148        VIEW-AS TOGGLE-BOX
      149        SIZE 30.5 BY .83 NO-UNDO.
      150   DEFINE FRAME Dialog-Frame
      151        b-exit AT ROW 1 COL 1
      152        b-default AT ROW 1 COL 11
      153        b-delete-size AT ROW 1 COL 26
      154        b-help AT ROW 1 COL 43
      155        tb-wndmax AT ROW 4 COL 4
      156        tb-wndstore AT ROW 5.25 COL 4
      157        fi-description AT ROW 3 COL 3.5 COLON-ALIGNED NO-LABEL
      158        RECT-1 AT ROW 3.25 COL 3
      159        SPACE(2.12) SKIP(1.32)
      160       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      161            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      162            TITLE "Параметры интерфейса"
      163            DEFAULT-BUTTON b-exit.
      164   ASSIGN
      165          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      166          FRAME Dialog-Frame:HIDDEN           = TRUE.
      167   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      168   DO:
      169     APPLY "END-ERROR":U TO SELF.
      170   END.
      171   ON CHOOSE OF b-default IN FRAME Dialog-Frame
      172   DO:
      173     run gbl/wndpar_d.p
      174       (input  g#db-num
      175       ,input  g#userid
      176       ,input  'wndmax':U
      177       ) .
      178     run gbl/wndpar_d.p
      179       (input  g#db-num
      180       ,input  g#userid
      181       ,input  'wndstore':U
      182       ) .
      183     run read-values-from-db in this-procedure .
      184   END.
      185   ON CHOOSE OF b-delete-size IN FRAME Dialog-Frame
      186   DO:
      187     define variable v-ok as logical   no-undo .
      188     message
      189       "Удалить сохранённое значение ширины и высоты для всех окон" skip
      190       "для пользователя" g#userid skip
      191       "Продолжить?" skip
      192       view-as alert-box question buttons yes-no update v-ok .
      193     if v-ok = true
      194     then do:
      195       run gbl/wndsizea.p
      196         (input  g#db-num
      197         ,input  g#userid
      198         ) .
      199     end.
      200   END.
      201   ON VALUE-CHANGED OF tb-wndmax IN FRAME Dialog-Frame
      202   DO:
      203     run gbl/wndpar_w.p
      204       (input  g#db-num
      205       ,input  g#userid
      206       ,input  'wndmax':U
      207       ,input  self :checked
      208       ) .
      209   END.
      210   ON VALUE-CHANGED OF tb-wndstore IN FRAME Dialog-Frame
      211   DO:
      212     run gbl/wndpar_w.p
      213       (input  g#db-num
      214       ,input  g#userid
      215       ,input  'wndstore':U
      216       ,input  self :checked
      217       ) .
      218   END.
      219   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      220   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      221   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   on help of frame Dialog-Frame
      223   do:
      224     run gbl/app_help.p
      225       (input this-procedure :file-name
      226       ,input ''
      227       ,input ?
      228       ) no-error.
      229     if error-status :error then do:
      230       message
      231         "Ошибка при вызове помощи"
      232         error-status :get-message(1)
      233         view-as alert-box .
      234     end.
      235   end.
      236   run minbtn-set in this-procedure .
      237   on choose of b-help in frame Dialog-Frame
      238   do:
      239     apply "help":u to frame Dialog-Frame .
      240   end.
      241   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   procedure minbtn-set :
      243       do
      244           on error undo, return error return-value
      245           :
      246           define variable ii              as integer       no-undo .
      247           define variable fh              as widget-handle no-undo .
      248           define variable hh              as widget-handle no-undo .
      249           define variable v-h             as handle        extent 4 no-undo .
      250           define variable v-name-button   as character     no-undo .
      251           define variable v-help-old-x    as decimal       no-undo .
      252           define variable v-help-old-y    as decimal       no-undo .
      253           define variable v-help-old-size as decimal       no-undo .
      254           define variable v-frame-width   as decimal       no-undo .
      255           define variable jj              as integer       no-undo .
      256           do
      257               on error undo, return error
      258               :
      259               assign
      260                   v-frame-width = frame Dialog-Frame:width - 0.3
      261                   fh            = frame Dialog-Frame:first-child
      262                   hh            = fh:first-child
      263                   ii            = 1
      264                   .
      265               do while valid-handle(hh):
      266                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      267                   do:
      268                       case lc(hh:name) :
      269                           when "b-help" then
      270                               do:
      271                                   hh:load-image-up("cmp/b-help.bmp":u) .
      272                                   hh:load-image-down("cmp/b-help.bmp":u) .
      273                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      274                                   hh:TOOLTIP = "Помощь" .
      275                                   v-help-old-x = hh:column .
      276                                   v-help-old-y = hh:row    .
      277                                   v-help-old-size = hh:width .
      278                                   hh:width-chars = 2.5 .
      279                               end.
      280                           when "b-print" then
      281                               do:
      282                                   hh:load-image("cmp/b-print.bmp":u) .
      283                                   hh:TOOLTIP = "Печать" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-history" or
      289                           when "b-hist" then
      290                               do:
      291                                   hh:load-image("cmp/b-hist.bmp":u) .
      292                                   hh:TOOLTIP = "История" .
      293                                   v-h[ii] = hh:handle .
      294                                   ii = ii + 1 .
      295                                   hh:width-chars = 3 .
      296                               end.
      297                           when "b-sch" then
      298                               do:
      299                                   hh:load-image("cmp/b-sch.bmp":u) .
      300                                   hh:TOOLTIP = "Установка Фильтра" .
      301                                   v-h[ii] = hh:handle .
      302                                   ii = ii + 1 .
      303                                   hh:width-chars = 3 .
      304                               end.
      305                           when "b-hist-user" then
      306                               do:
      307                                   hh:load-image("cmp/b-hist.bmp":u) .
      308                                   hh:TOOLTIP = "История пользователя" .
      309                                   ii = ii + 1 .
      310                               end.
      311                       end case.
      312                   end.
      313                   hh = hh:next-sibling.
      314               end.
      315               b-help:column = v-frame-width - b-help:width-chars.
      316               jj = 0.
      317               repeat ii = 4 to 1 by -1 :
      318                   if valid-handle (v-h[ii] ) then
      319                   do:
      320                       jj  = jj + 1 .
      321                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      322                       v-h[ii]:row    = v-help-old-y .
      323                   end.
      324               end.
      325           end.
      326       end.
      327   end procedure.
      328   MAIN-BLOCK:
      329   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      330      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      331     RUN enable_UI.
      332     run read-values-from-db in this-procedure .
      333     WAIT-FOR GO OF FRAME Dialog-Frame.
      334   END.
      335   RUN disable_UI.
      336   PROCEDURE disable_UI :
      337     HIDE FRAME Dialog-Frame.
      338   END PROCEDURE.
      339   PROCEDURE enable_UI :
      340     DISPLAY tb-wndmax tb-wndstore fi-description
      341         WITH FRAME Dialog-Frame.
      342     ENABLE b-exit RECT-1 b-default b-delete-size b-help tb-wndmax tb-wndstore
      343            fi-description
      344         WITH FRAME Dialog-Frame.
      345     VIEW FRAME Dialog-Frame.
      346   END PROCEDURE.
      347   PROCEDURE read-values-from-db :
      348     define variable v-param-value   as logical   no-undo .
      349     define variable v-default-value as logical   no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       do with frame Dialog-Frame
      354       :
      355         run gbl/wndpar_r.p
      356           (input  g#db-num
      357           ,input  g#userid
      358           ,input  'wndmax':U
      359           ,output v-param-value
      360           ,output v-default-value
      361           ) .
      362         assign
      363           tb-wndmax :checked = v-param-value
      364         .
      365         run gbl/wndpar_r.p
      366           (input  g#db-num
      367           ,input  g#userid
      368           ,input  'wndstore':U
      369           ,output v-param-value
      370           ,output v-default-value
      371           ) .
      372         assign
      373           tb-wndstore :checked = v-param-value
      374         .
      375       end.
      376     end.
      377   END PROCEDURE.
