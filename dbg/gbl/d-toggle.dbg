      532   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      533   DO:
      534     ASSIGN
      535     t-1 WHEN t-1:visible
      536     t-2 WHEN t-2:visible
      537     t-3 WHEN t-3:visible
      538     t-4 WHEN t-4:visible
      539     t-5 WHEN t-5:visible
      540     t-6 WHEN t-6:visible
      541     t-7 WHEN t-7:visible
      542     t-8 WHEN t-8:visible
      543     t-9 WHEN t-9:visible
      544     .
      545     ASSIGN
      546     p-list = (IF t-1:VISIBLE THEN (STRING(t-1) + v-first-delimiter) ELSE "":U) +
      547              (IF t-1:VISIBLE THEN (STRING(t-2) + v-first-delimiter) ELSE "":U) +
      548              (IF t-1:VISIBLE THEN (STRING(t-3) + v-first-delimiter) ELSE "":U) +
      549              (IF t-1:VISIBLE THEN (STRING(t-4) + v-first-delimiter) ELSE "":U) +
      550              (IF t-1:VISIBLE THEN (STRING(t-5) + v-first-delimiter) ELSE "":U) +
      551              (IF t-1:VISIBLE THEN (STRING(t-6) + v-first-delimiter) ELSE "":U) +
      552              (IF t-1:VISIBLE THEN (STRING(t-7) + v-first-delimiter) ELSE "":U) +
      553              (IF t-1:VISIBLE THEN (STRING(t-8) + v-first-delimiter) ELSE "":U) +
      554              (IF t-1:VISIBLE THEN (STRING(t-9) + v-first-delimiter) ELSE "":U)
      555     p-list = right-trim(p-list, v-first-delimiter)
      556     .
      557   END.
      558   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      559   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      560   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   on help of frame Dialog-Frame
      562   do:
      563     run gbl/app_help.p
      564       (input this-procedure :file-name
      565       ,input ''
      566       ,input ?
      567       ) no-error.
      568     if error-status :error then do:
      569       message
      570         "Ошибка при вызове помощи"
      571         error-status :get-message(1)
      572         view-as alert-box .
      573     end.
      574   end.
      575   run minbtn-set in this-procedure .
      576   on choose of b-help in frame Dialog-Frame
      577   do:
      578     apply "help":u to frame Dialog-Frame .
      579   end.
      580   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   procedure minbtn-set :
      582       do
      583           on error undo, return error return-value
      584           :
      585           define variable ii              as integer       no-undo .
      586           define variable fh              as widget-handle no-undo .
      587           define variable hh              as widget-handle no-undo .
      588           define variable v-h             as handle        extent 4 no-undo .
      589           define variable v-name-button   as character     no-undo .
      590           define variable v-help-old-x    as decimal       no-undo .
      591           define variable v-help-old-y    as decimal       no-undo .
      592           define variable v-help-old-size as decimal       no-undo .
      593           define variable v-frame-width   as decimal       no-undo .
      594           define variable jj              as integer       no-undo .
      595           do
      596               on error undo, return error
      597               :
      598               assign
      599                   v-frame-width = frame Dialog-Frame:width - 0.3
      600                   fh            = frame Dialog-Frame:first-child
      601                   hh            = fh:first-child
      602                   ii            = 1
      603                   .
      604               do while valid-handle(hh):
      605                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      606                   do:
      607                       case lc(hh:name) :
      608                           when "b-help" then
      609                               do:
      610                                   hh:load-image-up("cmp/b-help.bmp":u) .
      611                                   hh:load-image-down("cmp/b-help.bmp":u) .
      612                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      613                                   hh:TOOLTIP = "Помощь" .
      614                                   v-help-old-x = hh:column .
      615                                   v-help-old-y = hh:row    .
      616                                   v-help-old-size = hh:width .
      617                                   hh:width-chars = 2.5 .
      618                               end.
      619                           when "b-print" then
      620                               do:
      621                                   hh:load-image("cmp/b-print.bmp":u) .
      622                                   hh:TOOLTIP = "Печать" .
      623                                   v-h[ii] = hh:handle .
      624                                   ii = ii + 1 .
      625                                   hh:width-chars = 3 .
      626                               end.
      627                           when "b-history" or
      628                           when "b-hist" then
      629                               do:
      630                                   hh:load-image("cmp/b-hist.bmp":u) .
      631                                   hh:TOOLTIP = "История" .
      632                                   v-h[ii] = hh:handle .
      633                                   ii = ii + 1 .
      634                                   hh:width-chars = 3 .
      635                               end.
      636                           when "b-sch" then
      637                               do:
      638                                   hh:load-image("cmp/b-sch.bmp":u) .
      639                                   hh:TOOLTIP = "Установка Фильтра" .
      640                                   v-h[ii] = hh:handle .
      641                                   ii = ii + 1 .
      642                                   hh:width-chars = 3 .
      643                               end.
      644                           when "b-hist-user" then
      645                               do:
      646                                   hh:load-image("cmp/b-hist.bmp":u) .
      647                                   hh:TOOLTIP = "История пользователя" .
      648                                   ii = ii + 1 .
      649                               end.
      650                       end case.
      651                   end.
      652                   hh = hh:next-sibling.
      653               end.
      654               b-help:column = v-frame-width - b-help:width-chars.
      655               jj = 0.
      656               repeat ii = 4 to 1 by -1 :
      657                   if valid-handle (v-h[ii] ) then
      658                   do:
      659                       jj  = jj + 1 .
      660                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      661                       v-h[ii]:row    = v-help-old-y .
      662                   end.
      663               end.
      664           end.
      665       end.
      666   end procedure.
      667   on cursor-left anywhere do:
      668     apply "back-tab":u to focus .
      669   end.
      670   on cursor-right anywhere do:
      671     apply "tab":u to focus .
      672   end.
      673   MAIN-BLOCK:
      674   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      675      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      676     RUN Myenable.
      677     WAIT-FOR GO OF FRAME Dialog-Frame.
      678   END.
      679   RUN disable_UI.
      680   PROCEDURE disable_UI :
      681     HIDE FRAME Dialog-Frame.
      682   END PROCEDURE.
      683   PROCEDURE enable_UI :
      684     DISPLAY EDITOR-1 T-2
      685         WITH FRAME Dialog-Frame.
      686     ENABLE B-exit b-quit EDITOR-1 B-Help
      687         WITH FRAME Dialog-Frame.
      688     VIEW FRAME Dialog-Frame.
      689   END PROCEDURE.
      690   PROCEDURE MyEnable :
      691   DEFINE VARIABLE v-bottom AS DECIMAL NO-UNDO.
      692   do with frame Dialog-Frame:
      693     assign
      694       frame Dialog-Frame :title = p-title
      695     .
      696     v-bottom = editor-1:FRAME-ROW + editor-1:HEIGHT-CHARS.
      697     if length (p-delimiter) >= 1 then do:
      698       assign
      699         v-first-delimiter = substring(p-delimiter, 1, 1)
      700       .
      701     end.
      702     if length (p-delimiter) >= 2 then do:
      703       assign
      704         v-second-delimiter = substring(p-delimiter, 2, 1)
      705       .
      706     end.
      707     assign
      708       v-toggles = num-entries(p-toggles, v-first-delimiter)
      709       editor-1 = p-text
      710     .
      711     if v-toggles > 9 then do:
      712       message
      713         vss-workfile vss-revision vss-description skip
      714         "Количество флагов больше 9" skip
      715         "p-toggles" p-toggles skip
      716         view-as alert-box .
      717       undo, return error .
      718     end.
      719     if v-toggles <> num-entries(p-toggles-description, v-first-delimiter) then do:
      720       message
      721         vss-workfile vss-revision vss-description skip
      722         "Ошибка задания входных параметров" skip
      723         "Количество описаний флагов не совпадает с количеством флагов" skip
      724         "флагов" v-toggles skip
      725         "Описаний флагов" num-entries(p-toggles-description) skip
      726         view-as alert-box error .
      727       undo, return error .
      728     end.
      729     if v-toggles <> num-entries(p-toggles-init, v-first-delimiter) then do:
      730       message
      731         vss-workfile vss-revision vss-description skip
      732         "Ошибка задания входных параметров" skip
      733         "Количество начальных значений флагов не совпадает с количеством флагов" skip
      734         "флагов" v-toggles skip
      735         "Начальных значений флагов" num-entries(p-toggles-init) skip
      736         view-as alert-box error .
      737       undo, return error .
      738     end.
      739     define variable v-toggle-handle             as handle no-undo extent 9 .
      740     define variable v-toggle-description-handle as handle no-undo extent 9 .
      741     assign
      742       v-toggle-handle[1]             = t-1         :handle
      743       v-toggle-handle[2]             = t-2         :handle
      744       v-toggle-handle[3]             = t-3         :handle
      745       v-toggle-handle[4]             = t-4         :handle
      746       v-toggle-handle[5]             = t-5         :handle
      747       v-toggle-handle[6]             = t-6         :handle
      748       v-toggle-handle[7]             = t-7         :handle
      749       v-toggle-handle[8]             = t-8         :handle
      750       v-toggle-handle[9]             = t-9         :handle
      751       v-toggle-description-handle[1] = description-1 :handle
      752       v-toggle-description-handle[2] = description-2 :handle
      753       v-toggle-description-handle[3] = description-3 :handle
      754       v-toggle-description-handle[4] = description-4 :handle
      755       v-toggle-description-handle[5] = description-5 :handle
      756       v-toggle-description-handle[6] = description-6 :handle
      757       v-toggle-description-handle[7] = description-7 :handle
      758       v-toggle-description-handle[8] = description-8 :handle
      759       v-toggle-description-handle[9] = description-9 :handle
      760         .
      761     define variable v-handle             as handle no-undo .
      762     define variable v-handle-description as handle no-undo .
      763     define variable ind as integer no-undo .
      764     do ind = 1 to v-toggles
      765     :
      766       assign
      767         v-handle             = v-toggle-handle[ind]
      768         v-handle-description = v-toggle-description-handle[ind]
      769       .
      770       define variable v-toggle-text      as character no-undo .
      771       define variable v-description-text as character no-undo .
      772       define variable l-sensitive        as logical no-undo .
      773       define variable l-confirm          as logical no-undo .
      774       define variable v-btn-text-ind     as integer no-undo .
      775       assign
      776         v-toggle-text      = entry(ind, p-toggles, v-first-delimiter)
      777         v-description-text = entry(ind, p-toggles-description, v-first-delimiter)
      778         l-sensitive        = true
      779         l-confirm          = false
      780       .
      781       define variable v-toggle-attribute as character no-undo .
      782       do v-btn-text-ind = 2 to num-entries(v-toggle-text, v-second-delimiter )
      783       :
      784         assign
      785           v-toggle-attribute = entry(v-btn-text-ind, v-toggle-text, v-second-delimiter)
      786         .
      787         case v-toggle-attribute :
      788           when 'disable' then do:
      789             assign
      790               l-sensitive = false
      791             .
      792           end.
      793           otherwise do:
      794             message
      795               vss-workfile vss-revision vss-description skip
      796               "Неизвестный атрибут флаг" skip
      797               "Атрибут" v-toggle-attribute skip
      798               "Описание флага" ind skip
      799               v-toggle-text skip
      800               view-as alert-box error .
      801           end.
      802         end case .
      803       end.
      804       if num-entries (v-toggle-text, v-second-delimiter ) >= 1 then do:
      805         assign
      806           v-toggle-text = entry(1, v-toggle-text, v-second-delimiter)
      807         .
      808       end.
      809       assign
      810         v-handle :label     = v-toggle-text
      811         v-handle :visible   = true
      812         v-handle :sensitive = l-sensitive
      813       .
      814       v-bottom = v-handle:frame-row + v-handle:HEIGHT-CHARS.
      815       v-handle:screen-value = entry(ind, p-toggles-init, v-first-delimiter).
      816       if v-description-text = "" then do:
      817         assign
      818           v-handle :width = min(max(v-handle :width
      819                                    ,length(v-toggle-text) + 2
      820                                    )
      821                                ,frame Dialog-Frame :width - v-handle :column - 1
      822                                )
      823          .
      824       end.
      825       if v-description-text <> "" then do:
      826         assign
      827           v-handle-description :visible      = true
      828           v-handle-description :sensitive    = true
      829           v-handle-description :read-only    = true
      830           v-handle-description :screen-value = v-description-text
      831         .
      832       end.
      833     end.
      834   end.
      835   ASSIGN
      836   FRAME Dialog-Frame:HEIGHT-CHARS = v-bottom + 2
      837       .
      838   DISPLAY
      839   EDITOR-1
      840   WITH FRAME Dialog-Frame.
      841   ENABLE
      842   B-exit
      843   b-quit
      844   EDITOR-1
      845   B-Help
      846   WITH FRAME Dialog-Frame.
      847   VIEW FRAME Dialog-Frame.
      848   END PROCEDURE.
