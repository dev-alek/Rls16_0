        1   block-level on error undo, throw.
        2   define input parameter p-shift-date as date no-undo.
        3   define input parameter p-shift-num as integer no-undo.
        4   define input parameter p-obj-type as character no-undo.
        5   define input parameter p-obj-code as integer no-undo.
        6   define input parameter p-start-time as integer no-undo.
        7   define input parameter p-end-time as integer no-undo.
        8   find first ub.shift-obj exclusive-lock
        9       where ub.shift-obj.obj-type = p-obj-type
       10       and ub.shift-obj.obj-code = p-obj-code
       11       and ub.shift-obj.shift-date = p-shift-date
       12       and ub.shift-obj.shift-num = p-shift-num
       13       no-error.
       14   if not available ub.shift-obj then
       15       return error subst("Смена &1 &2 на объекте &3 &4 не найдена", p-shift-date, p-shift-num, p-obj-type, p-obj-code).
       16   if ub.shift-obj.open-time = p-start-time and ub.shift-obj.close-time = p-end-time then
       17       return.
       18   assign
       19       ub.shift-obj.open-time = p-start-time
       20       ub.shift-obj.close-time = p-end-time
       21   .
       22   release ub.shift-obj no-error.
       23   if error-status:error then
       24       return error return-value.
