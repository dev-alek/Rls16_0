        1   block-level on error undo, throw.
        2   define input parameter p-string     as character no-undo .
        3   define input parameter p-min-val    as integer   no-undo .
        4   define input parameter p-max-val    as integer   no-undo .
        5   define input parameter p-first-err  as logical   no-undo .
        6   define input parameter p-handle-tbl as handle    no-undo .
        7   define input parameter p-field-name as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: prcs-lst.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/prcs-lst.p $":U .
       13   define variable vss-description as character no-undo init "Преобразование строки вида 1-5,9 в список вида 1,2,3,4,5,9".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   do
       73   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       74   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       75   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       76   :
       77     define variable v-err-msg      as character no-undo .
       78     define variable v-num-entries  as integer   no-undo .
       79     define variable v-num-entries1 as integer   no-undo .
       80     define variable v-ind          as integer   no-undo .
       81     define variable v-ind1         as integer   no-undo .
       82     define variable v-val-str      as character no-undo .
       83     define variable v-val-tmp      as character no-undo .
       84     define variable v-val-int      as integer   no-undo .
       85     define variable v-val-beg      as integer   no-undo .
       86     define variable v-val-end      as integer   no-undo .
       87     define variable fh             as handle    no-undo .
       88     assign
       89       v-err-msg     = "":U
       90       v-num-entries = num-entries( p-string, ",":U )
       91     .
       92     block_list:
       93     do v-ind = 1 to v-num-entries
       94     on error undo, return error return-value
       95     :
       96       assign
       97         v-val-str = trim( entry( v-ind, p-string, ",":U ) )
       98       .
       99       if v-val-str = "":U then do:
      100         next block_list.
      101       end.
      102       if num-entries( v-val-str, "-":U ) > 1 then do:
      103         assign
      104           v-val-tmp = trim( entry( 1, v-val-str, "-":U ) )
      105         .
      106         if v-val-tmp = "":U then do:
      107           if p-first-err = true then do:
      108             assign
      109               v-err-msg = substitute( 'задание списка "&1" некорректно; первое число отрицательное', v-val-str )
      110             .
      111             leave block_list.
      112           end.
      113           else do:
      114             next block_list.
      115           end.
      116         end.
      117         assign
      118           v-val-beg = integer( v-val-tmp )
      119           no-error
      120         .
      121         if error-status :error then do:
      122           if p-first-err = true then do:
      123             assign
      124               v-err-msg = substitute( "значение &1 не числовое", v-val-tmp )
      125             .
      126             leave block_list.
      127           end.
      128           else do:
      129             next block_list.
      130           end.
      131         end.
      132         if v-val-beg < p-min-val then do:
      133           if p-first-err = true then do:
      134             assign
      135               v-err-msg = substitute( "значение &1 меньше минимально допустимого (&2)", v-val-tmp, p-min-val )
      136             .
      137             leave block_list.
      138           end.
      139           else do:
      140             next block_list.
      141           end.
      142         end.
      143         assign
      144           v-val-tmp = trim( entry( num-entries( v-val-str, "-":U ), v-val-str, "-":U ) )
      145         .
      146         if v-val-tmp = "":U then do:
      147           if p-first-err = true then do:
      148             assign
      149               v-err-msg = substitute( 'задание списка "&1" некорректно; должно быть вида "1-5"', v-val-str )
      150             .
      151             leave block_list.
      152           end.
      153           else do:
      154             next block_list.
      155           end.
      156         end.
      157         assign
      158           v-val-end = integer( v-val-tmp )
      159           no-error
      160         .
      161         if error-status :error then do:
      162           if p-first-err = true then do:
      163             assign
      164               v-err-msg = substitute( "значение &1 не числовое", v-val-tmp )
      165             .
      166             leave block_list.
      167           end.
      168           else do:
      169             next block_list.
      170           end.
      171         end.
      172         if v-val-end > p-max-val then do:
      173           if p-first-err = true then do:
      174             assign
      175               v-err-msg = substitute( "значение &1 больше максимально допустимого (&2)", v-val-tmp, p-max-val )
      176             .
      177             leave block_list.
      178           end.
      179           else do:
      180             next block_list.
      181           end.
      182         end.
      183         assign
      184           v-ind1 = v-val-beg
      185         .
      186         block_dash:
      187         do while true
      188         on error undo, return error return-value
      189         :
      190           if v-ind1 = p-max-val + 1 then do:
      191             assign
      192               v-ind1 = p-min-val
      193             .
      194           end.
      195           p-handle-tbl:find-first( substitute( "where &1 = &2", p-field-name, v-ind1 ), no-lock ) no-error .
      196           if not p-handle-tbl:available then do:
      197             p-handle-tbl:buffer-create.
      198             assign
      199               fh = p-handle-tbl:buffer-field( p-field-name ).
      200               fh:buffer-value() = v-ind1
      201             .
      202           end.
      203           if v-ind1 = v-val-end then do:
      204             leave block_dash.
      205           end.
      206           assign
      207             v-ind1 = v-ind1 + 1
      208           .
      209         end.
      210       end.
      211       else do:
      212         assign
      213           v-val-int = integer( v-val-str )
      214           no-error
      215         .
      216         if error-status :error then do:
      217           if p-first-err = true then do:
      218             assign
      219               v-err-msg = substitute( "значение &1 не числовое", v-val-str )
      220             .
      221             leave block_list.
      222           end.
      223           else do:
      224             next block_list.
      225           end.
      226         end.
      227         if v-val-int > p-max-val then do:
      228           if p-first-err = true then do:
      229             assign
      230               v-err-msg = substitute( "значение &1 больше максимально допустимого (&2)", v-val-str, p-max-val )
      231             .
      232             leave block_list.
      233           end.
      234           else do:
      235             next block_list.
      236           end.
      237         end.
      238         if v-val-int < p-min-val then do:
      239           if p-first-err = true then do:
      240             assign
      241               v-err-msg = substitute( "значение &1 меньше минимально допустимого (&2)", v-val-str, p-min-val )
      242             .
      243             leave block_list.
      244           end.
      245           else do:
      246             next block_list.
      247           end.
      248         end.
      249         p-handle-tbl:find-first( substitute( "where &1 = &2", p-field-name, v-val-int ), no-lock ) no-error .
      250         if not p-handle-tbl:available then do:
      251           p-handle-tbl:buffer-create.
      252           assign
      253             fh = p-handle-tbl:buffer-field( p-field-name ).
      254             fh:buffer-value() = v-val-int
      255           .
      256         end.
      257       end.
      258     end.
      259     if v-err-msg <> "":U then do:
      260       return error v-err-msg.
      261     end.
      262     else do:
      263       return.
      264     end.
      265   end.
