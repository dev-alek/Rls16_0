        1   block-level on error undo, throw.
        2   define input parameter p-filename       as character        no-undo.
        3   define input parameter p-parameter      as character        no-undo.
        4   define input parameter p-vb-filename    as character        no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: xlimport.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/xlimport.p $":U .
       10   define variable vss-description as character no-undo init "Процедура импорта из формата xls".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define variable v-waitfram-action01         as character   no-undo .
       71   define variable v-waitfram-action02         as character   no-undo .
       72   define variable v-waitfram-action03         as character   no-undo .
       73   define variable mWaitFramTextBeg            as character   no-undo.
       74   define variable mWaitFramTextEnd            as character   no-undo.
       75   define variable mWaitFramView               as logical     no-undo.
       76   define variable mWaitProcEvent              as logical     no-undo init yes.
       77   define variable mWaitFramInterval           as integer     no-undo init 1 .
       78   define variable mWaitFramStop               as logical     no-undo.
       79   define variable mWaitFramStopUser           as logical     no-undo.
       80   define variable mWaitFramStopTimeOut        as logical     no-undo.
       81   define variable mWaitFramStartProc          as datetime-tz no-undo.
       82   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       83   define button B-WaitFramStop auto-end-key
       84        label "Стоп"
       85        size 10 by 1 tooltip "Остоновить процесс".
       86   define button B-viewProcInfo
       87        label "Информация"
       88        size 15 by 1 tooltip "Информация о процесс".
       89   define frame waitfram
       90     v-waitfram-action01 format "x(72)" no-label skip
       91     v-waitfram-action02 format "x(72)" no-label skip
       92     v-waitfram-action03 format "x(72)" no-label skip
       93     B-viewProcInfo
       94     B-WaitFramStop at row 4 col 30
       95     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       96     .
       97   define new global shared variable mBatchMode as logical no-undo init ?.
       98   define variable mFramBachModHandle as handle no-undo.
       99   mFramBachModHandle = frame waitfram:handle.
      100   define variable mFameOldVis as logical no-undo.
      101   define variable mVisCUrentVin as logical no-undo.
      102   if session:batch-mode
      103   then
      104      mBatchMode = yes.
      105   if mBatchMode = ? then do:
      106     mVisCUrentVin = current-window:visible.
      107     mFameOldVis = mFramBachModHandle:visible.
      108     mFramBachModHandle:visible  = yes.
      109     mBatchMode = mFramBachModHandle:visible ne yes.
      110     mFramBachModHandle:visible = mFameOldVis.
      111     current-window:visible = mVisCUrentVin.
      112   end.
      113    if  log-manager:logfile-name ne ?
      114     then DO:
      115         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      116         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      117         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      118     end.
      119   on choose of B-WaitFramStop in frame waitfram
      120   do:
      121     mWaitFramStop = yes.
      122     mWaitFramStopUser = yes.
      123   end.
      124   function waitfram-check-timeout returns logical():
      125      define variable vtime as int64 no-undo.
      126      if mWaitFramStopTimeOut
      127      then
      128         return yes.
      129      vtime = ( now - mWaitFramStartProc ) / 1000 .
      130      if     mWaitFramTimeOut ne ?
      131         and mWaitFramTimeOut ne 0
      132         and mWaitFramTimeOut lt vtime
      133      then do:
      134         mWaitFramStopTimeOut = yes.
      135      end.
      136      return mWaitFramStopTimeOut.
      137   end.
      138   procedure waitfram-hide :
      139     if not session:batch-mode
      140     then do
      141     on error undo, return error return-value
      142     :
      143       pause 0 before-hide .
      144       if not mBatchMode then
      145         hide frame waitfram .
      146     if     not mWaitFramView
      147        and mWaitProcEvent
      148     then
      149       process events .
      150     end.
      151   end procedure.
      152   procedure waitfram-show :
      153     define input  parameter p-message as character no-undo .
      154     define variable v-left-margin as integer   no-undo .
      155     if not session:batch-mode
      156     then do
      157     on error undo, return error return-value
      158     :
      159       if length(p-message) <= 70 then do:
      160         assign
      161           v-left-margin = integer((70 - length(p-message)) / 2)
      162         .
      163         assign
      164           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      165         .
      166         assign
      167           v-waitfram-action01 = " "
      168           v-waitfram-action02 = " "
      169                                    + fill(" ", v-left-margin)
      170                                    + p-message
      171           v-waitfram-action03 = " "
      172         .
      173       end.
      174       else do:
      175         define variable vRindex1 as integer no-undo.
      176         define variable vRindex2 as integer no-undo.
      177         vRindex1 = r-index(p-message," ",70).
      178         if vRindex1 = 0
      179         then
      180            vRindex1 = 70.
      181         if length(p-message)  <= vRindex1 + 70 then do:
      182           assign
      183             v-waitfram-action01 = " "
      184             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      185             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      186           .
      187         end.
      188         else do:
      189           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      190           if vRindex2 <= vRindex1
      191           then
      192              vRindex2 = vRindex1 + 70.
      193           assign
      194             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      197           .
      198         end.
      199       end.
      200       B-viewProcInfo:visible   in frame waitfram = no.
      201       B-viewProcInfo:sensitive in frame waitfram = no.
      202       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       if  (   mWaitFramView
      205          or  mWaitProcEvent)
      206          and not mBatchMode
      207       then
      208          display
      209             v-waitfram-action01 skip
      210             v-waitfram-action02 skip
      211             v-waitfram-action03 skip
      212          with frame waitfram .
      213       if     mWaitFramView
      214          then do:
      215             if     mWaitFramInterval ne ?
      216                and not mBatchMode
      217             then
      218                wait-for go of frame waitfram pause mWaitFramInterval.
      219          end.
      220          else
      221             if     mWaitProcEvent
      222                and not mBatchMode
      223             then
      224                process events .
      225     end.
      226   end procedure.
      227      procedure waitfram-show-this:
      228         define input  parameter iInterval as int64 no-undo.
      229         define variable vtime as int64 no-undo.
      230         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      231         mWaitFramInterval = iInterval.
      232         run waitfram-show (substitute("&1&2 &3&4" ,
      233                                       mWaitFramTextBeg ,
      234                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      235                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      236                                       mWaitFramTextEnd
      237                                      )
      238                           ).
      239      end.
      240      procedure WaitFramRunPause:
      241         define input  parameter iInterval as dec no-undo.
      242         define variable vStart  as datetime-tz no-undo.
      243         define variable vend    as datetime-tz no-undo.
      244         define variable vint as int64 no-undo.
      245         define variable vOk as logical no-undo.
      246         vStart = now.
      247         vend   = vStart.
      248         publish "WaitFramPause" (iInterval,output vOk).
      249         vend   =  now.
      250         vint = vend - vStart.
      251         vint = iInterval - vint / 1000.
      252         if     not mWaitFramStop
      253            and (   vint > 0
      254                 or (    not vOk
      255                     and iInterval eq ?
      256                     )
      257                 )
      258         then
      259            run waitfram-show-this (iInterval).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and vint > 0
      265         then do:
      266            run gbl/pause.p (vint * 1000).
      267         end.
      268         if iInterval ne ?
      269         then
      270            publish "WaitFramStop".
      271         waitfram-check-timeout().
      272      end.
      273      procedure WaitFramWaitFor:
      274         define input  parameter iInterval as dec no-undo.
      275         assign
      276            mWaitFramStartProc   = now
      277            mWaitFramStopUser    = no
      278            mWaitFramStopTimeOut = no
      279         .
      280         block-wait:
      281         do while not mWaitFramStop:
      282            run WaitFramRunPause (iInterval).
      283            if  waitfram-check-timeout()
      284            then do:
      285               leave block-wait.
      286            end.
      287         end.
      288         run waitfram-hide.
      289      end.
      290   procedure waitfram-join :
      291     define input  parameter p-line-1  as character no-undo .
      292     define input  parameter p-line-2  as character no-undo .
      293     define input  parameter p-line-3  as character no-undo .
      294     define output parameter p-message as character no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      302       .
      303     end.
      304   end procedure.
      305   function waitfram-join-function returns character
      306     (input p-line-1 as character
      307     ,input p-line-2 as character
      308     ,input p-line-3 as character
      309     ).
      310     define variable v-message as character no-undo .
      311     run waitfram-join in this-procedure
      312       (input  p-line-1
      313       ,input  p-line-2
      314       ,input  p-line-3
      315       ,output v-message
      316       ) .
      317     return v-message .
      318   end function .
      319   define variable v-xlimport-macro-line-counter    as integer      no-undo.
      320   define variable v-ok            as logical      no-undo.
      321   define variable v-vb-filename   as character    no-undo.
      322   define variable v-filename      as character    no-undo.
      323   define variable v-version       as character no-undo .
      324   define variable v-version-dec   as decimal   no-undo .
      325   define variable v-found-reg-entry as logical no-undo .
      326   define variable v-trusted as character no-undo .
      327   define variable chExcelApp                  as com-handle       no-undo.
      328   define variable chWorkBook                  as com-handle       no-undo.
      329   define variable chCodeModule                as com-handle       no-undo.
      330   do
      331   on error undo, return error
      332   :
      333       assign
      334           v-filename      = search( p-filename    )
      335           v-vb-filename   = search( p-vb-filename )
      336       .
      337       if v-filename = ?
      338       then do:
      339           message
      340               "Не найден файл Excel"
      341               skip p-filename
      342           view-as alert-box error.
      343           undo, return error .
      344       end.
      345       if v-vb-filename = ?
      346       then do:
      347           message
      348               "Не найден файл обработки"
      349               skip p-vb-filename
      350           view-as alert-box error.
      351           undo, return error .
      352       end.
      353       create "Excel.Application" chExcelApp no-error .
      354       if error-status :error then do:
      355           message
      356           "Ошибка при запуске Excel" skip
      357           error-status :get-message(1) skip
      358           view-as alert-box error .
      359           undo, return error .
      360       end.
      361       assign
      362       chExcelApp :WindowState =
      363       chExcelApp :Visible     = False
      364       chExcelApp :Interactive = False
      365       chExcelApp :Visible     = yes
      366       chExcelApp :Interactive = yes
      367       v-version = chExcelApp:version
      368       no-error
      369       .
      370       assign
      371       v-version-dec = decimal(v-version)
      372       no-error .
      373       if error-status:error then do:
      374         run  clearexcel in this-procedure .
      375         message "Не удалось определить версию Excel"
      376         view-as alert-box error .
      377         return error '':U.
      378       end.
      379       if v-version-dec > 9 then do:
      380         run gbl/getregvl.p (
      381                          input "HKEY_CURRENT_USER":U
      382                         ,input  "SOFTWARE":U
      383                         ,input ("Microsoft\Office\" + string(v-version-dec, ">9.9":U) + "\Excel\Security":U)
      384                         ,input  "AccessVBOM":U
      385                         ,output v-found-reg-entry
      386                         ,OUTPUT v-trusted) no-error .
      387         if error-status:error then do:
      388           message
      389           "Не удалось определить политику безопасности для данной версии Excel"
      390           view-as alert-box error .
      391           run  clearexcel in this-procedure .
      392           return error '':U.
      393         end.
      394         if not v-found-reg-entry
      395         or trim(v-trusted) = "0":U then do:
      396           message
      397           "На Вашей машине запрещен программный доступ к VisualBasicProject" skip
      398           "В связи с этим вывод в EXCEL невозможен" skip
      399           "возможное решение проблемы:" skip
      400           "открыть в EXCEL диалог <Сервис\Макрос\Безопасность> (<Tools\Macro\Security>)" skip
      401           "выбрать закладку <Надежные источники> (<Trusted Sources>)  и включить галочку" skip
      402           "<Доверять доступ Visual Basic Project> (<Trust access to Visual Basic Project>)" skip
      403           "Затем закрыть Excel"
      404           view-as alert-box ERROR.
      405           run  clearexcel in this-procedure .
      406           return error '':U.
      407         end.
      408       end.
      409       assign
      410       chWorkBook = chExcelApp :Workbooks :Add( v-filename )
      411       .
      412       assign
      413       chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      414       .
      415       run load-basic in this-procedure (
      416             input v-filename
      417           , input v-vb-filename
      418       ).
      419       assign
      420           v-ok = chWorkbook:LoadBasic
      421       .
      422       assign
      423           v-ok = chWorkbook:StartApp
      424       .
      425       assign
      426           chExcelApp :DisplayAlerts = False
      427       .
      428       run clearexcel in this-procedure .
      429   end.
      430   procedure load-basic :
      431   define input parameter p-filename       as character        no-undo.
      432   define input parameter p-vb-filename    as character        no-undo.
      433   define variable chCodeModule as com-handle no-undo .
      434   define variable num-of-lines as integer no-undo .
      435       define variable v-command-string    as character    no-undo.
      436     do
      437     on error undo, return error return-value
      438     :
      439     assign
      440       chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      441     .
      442     assign
      443     num-of-lines = chCodeModule :CountOfLines.
      444     chCodeModule:DeleteLines(1, num-of-lines).
      445       run append-macro-line ( input 'Sub LoadBasic').
      446       assign
      447           v-command-string = substitute( '  ThisWorkbook.VBProject.VBComponents.Import "&1"'
      448                                   , p-vb-filename
      449                              )
      450       .
      451       run append-macro-line ( input v-command-string ).
      452       run append-macro-line ( input '  Application.Interactive = True').
      453       run append-macro-line ( input '  Application.ScreenUpdating = True').
      454       run append-macro-line ( input 'End Sub').
      455       run append-macro-line ( input 'Sub StartApp').
      456       run append-macro-line ( input 'Dim mModule As Object').
      457       run append-macro-line ( input 'Dim liCount As Long').
      458       run append-macro-line ( input '  Application.ScreenUpdating = False').
      459       run append-macro-line ( input '  Application.Interactive = False').
      460       assign
      461           v-command-string = substitute( '  call VBAProject.mainMacro ("&1")'
      462                                   , p-parameter
      463                              )
      464       .
      465       run append-macro-line ( input v-command-string ).
      466       run append-macro-line ( input 'For Each mModule In ThisWorkbook.VBProject.VBComponents').
      467       run append-macro-line ( input 'If mModule.Type = 1 Then').
      468       run append-macro-line ( input '    ThisWorkbook.VBProject.VBComponents.Remove ThisWorkbook.VBProject.VBComponents(mModule.Name)').
      469       run append-macro-line ( input 'End If').
      470       run append-macro-line ( input 'Next mModule').
      471       run append-macro-line ( input '  Application.Interactive = True').
      472       run append-macro-line ( input '  Application.ScreenUpdating = True').
      473       run append-macro-line ( input 'For Each mModule In ThisWorkbook.VBProject.VBComponents').
      474       run append-macro-line ( input '    liCount = mModule.CodeModule.CountOfLines').
      475       run append-macro-line ( input '    mModule.CodeModule.DeleteLines 1, liCount').
      476       run append-macro-line ( input 'Next mModule').
      477       run append-macro-line ( input 'End Sub').
      478     end.
      479   end procedure.
      480   procedure append-macro-line :
      481   define input  parameter p-macro-str as character no-undo .
      482   do
      483   on error undo, return error return-value
      484   :
      485       assign
      486           v-xlimport-macro-line-counter = v-xlimport-macro-line-counter + 1
      487       .
      488       assign
      489           v-ok = chCodeModule :InsertLines( v-xlimport-macro-line-counter, p-macro-str )
      490       .
      491   end.
      492   end procedure.
      493   procedure ClearExcel :
      494   define variable v-ok as logical no-undo .
      495     do
      496     on error undo, return error
      497     :
      498       release object chCodeModule no-error .
      499       release object chWorkBook   no-error .
      500       assign
      501           v-ok = chExcelApp:Quit()
      502       no-error.
      503       release object chExcelApp   no-error .
      504       PROCESS EVENTS.
      505     end.
      506   end procedure.
