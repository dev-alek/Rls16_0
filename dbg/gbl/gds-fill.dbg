        1   block-level on error undo, throw.
        2   define input parameter par-run-names as character no-undo .
        3   define input parameter Rs-list-method as character no-undo .
        4   define input parameter Rs-status as character no-undo .
        5   define input parameter line-mode as character no-undo .
        6   define input parameter p-filter-var as character no-undo .
        7   define output parameter lns-cnt as integer no-undo .
        8   define output parameter line-rec as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: gds-fill.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/gds-fill.p $":U .
       14   define variable vss-description as character no-undo init "Формирование списка товаров по фильтру".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define shared temp-table gds-list no-undo like ub.goods
       87     field qnty   as decimal
       88     field to-del as logical
       89     field order-num as integer
       90     field to-sel as logical
       91     field promo-code as character
       92     field ActionId  as int64
       93     field db-num as integer
       94     index art  is primary unique artic prod-type prod-code
       95     index code is         unique gds-code
       96     index oi order-num
       97     index isel to-sel
       98     .
       99   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  shared  temp-table gds-list-hist no-undo
      101   field list-table as character
      102   field id as integer
      103   field line as integer
      104   field hist-mode as character
      105   field des as character
      106   field num-recs as integer
      107   field option_ as character
      108   field item_ as character
      109   field status_ as character
      110   field num-add as integer
      111   field num-ignored as integer
      112   field done as logical
      113   field err_ as logical
      114   field err-mes as character
      115   index pi is primary
      116   id
      117   line
      118   index isdone
      119   done
      120   .
      121   define variable dsp-rs as char format "x(50)" no-undo.
      122   define variable lns-ignore as integer no-undo .
      123   define variable glog as logical no-undo .
      124   define variable v-prepare-string as character no-undo .
      125   define query gds-fill for ub.clients, ub.goods, ub.gds-prt.
      126   def frame abc
      127   dsp-rs no-label
      128   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      129   TITLE par-run-names.
      130   view frame abc.
      131   disp dsp-rs with frame abc.
      132   v-prepare-string = "for each clients, each goods where clients.obj-type = goods.prod-type and clients.obj-code = goods.prod-code " +
      133                      p-filter-var  +
      134                      ", first gds-prt where gds-prt.upper-code = goods.prt-root".
      135   glog = query gds-fill:handle:query-prepare(v-prepare-string) no-error.
      136   if not glog
      137   or error-status:error then do:
      138     message
      139     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      140                , chr(10)
      141                , error-status:get-message(1)
      142                , p-filter-var)
      143     view-as alert-box error .
      144     undo, return error .
      145   end.
      146   glog = query gds-fill:handle:query-open() no-error.
      147   if not glog
      148   or error-status:error then do:
      149     message
      150     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      151                , chr(10)
      152                , error-status:get-message(1)
      153                , p-filter-var)
      154     view-as alert-box error .
      155     undo, return error .
      156   end.
      157   REPEAT WITH FRAME abc:
      158     query gds-fill:handle:GET-NEXT().
      159     IF query gds-fill:handle:QUERY-OFF-END THEN LEAVE.
      160     process events.
      161     run ex-gds in this-procedure ( buffer goods, input rs-list-method, input rs-status, input line-mode).
      162   end.
      163   glog = query gds-fill:handle:query-close() no-error.
      164   hide frame abc.
      165   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   PROCEDURE ex-gds :
      167       define parameter buffer buf_goods for ub.goods.
      168       define input parameter rs-list-method as character no-undo .
      169       define input parameter rs-status as character no-undo .
      170       define input parameter line-mode as character no-undo .
      171       if rs-list-method = "single":U or
      172           (buf_goods.stts = 0  and rs-status <> 'удаленные':U) or
      173           (buf_goods.stts <> 0 and rs-status <> 'текущие':U) then
      174       do:
      175           if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then
      176           do:
      177               if rs-list-method = "tsd":U then
      178               do:
      179                   for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
      180                       ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
      181                       find first gds-list where gds-list.artic = buf_goods.artic
      182                           and gds-list.prod-type = buf_goods.prod-type
      183                           and gds-list.prod-code = buf_goods.prod-code no-error.
      184                       if available gds-list then
      185                       do:
      186                           if line-mode = 'удаление':U then
      187                           do:
      188                               lns-cnt = lns-cnt + 1.
      189                               delete gds-list.
      190                           end.
      191                           else
      192                           do:
      193                               if gds-list.to-del = ? then.
      194                               else
      195                               do:
      196                                   lns-cnt = lns-cnt + 1.
      197                                   gds-list.to-del = ?.
      198                               end.
      199                           end.
      200                       end.
      201                   end.
      202               end.
      203               else
      204               do:
      205                   find first gds-list where gds-list.artic = buf_goods.artic
      206                       and gds-list.prod-type = buf_goods.prod-type
      207                       and gds-list.prod-code = buf_goods.prod-code no-error.
      208                   if available gds-list then
      209                   do:
      210                       if line-mode = 'удаление':U then
      211                       do:
      212                           lns-cnt = lns-cnt + 1.
      213                           delete gds-list.
      214                       end.
      215                       else
      216                       do:
      217                           if gds-list.to-del = ? then.
      218                           else
      219                           do:
      220                               lns-cnt = lns-cnt + 1.
      221                               gds-list.to-del = ?.
      222                           end.
      223                       end.
      224                   end.
      225               end.
      226           end.
      227           else
      228               if line-mode = 'ДОБАВЛЕНИЕ':U then
      229               do:
      230   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      231   find gds-list
      232     where gds-list.prod-type = buf_goods.prod-type
      233       and gds-list.prod-code = buf_goods.prod-code
      234       and gds-list.artic     = buf_goods.artic
      235     no-error .
      236   if available gds-list then do:
      237     assign
      238       gds-list.to-del = no
      239     .
      240   end.
      241   else do:
      242     define variable v-last4 as integer no-undo .
      243     find last gds-list use-index oi no-error.
      244     if available gds-list then do:
      245       v-last4 = gds-list.order-num .
      246     end.
      247     else do:
      248       v-last4 = 0 .
      249     end.
      250     create gds-list .
      251     buffer-copy buf_goods to gds-list
      252     assign
      253       gds-list.to-del = no
      254       gds-list.order-num = v-last4 + 1
      255     .
      256     assign
      257       lns-cnt = lns-cnt + 1
      258       line-rec = recid (gds-list)
      259     .
      260   end.
      261                   if rs-list-method = "tsd":U  then
      262                   do:
      263                       for first ub.Code no-lock where ub.Code.parent = "TiketPrint" and
      264                           ub.code.status_ = 0 and ub.Code.code = string(buf_goods.gds-code):
      265                           find first gds-list where gds-list.gds-code = buf_goods.gds-code no-error.
      266                           if available gds-list then
      267                           do:
      268                               gds-list.qnty = decimal(ub.Code.CodeValue) .
      269                           end.
      270                       end.
      271                   end.
      272               end.
      273               disp "ЖДИТЕ...    Обработано товаров :" + string (lns-cnt) @ dsp-rs with frame abc.
      274       end.
      275       else
      276           assign
      277               lns-ignore = lns-ignore + 1
      278               .
      279   end.
