        1   block-level on error undo, throw.
        2   using ibs.th.gbl.*.
        3   define input  parameter p-auto-value  as logical   no-undo .
        4   define input  parameter p-user-id     as character no-undo .
        5   define input  parameter p-user-passwd as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 6eb2e10e43c1, 3410, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
        8   define variable vss-date        as character no-undo init "$Date: 2023/08/17 10:18:56 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: set-gbl.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/set-gbl.p $":U .
       11   define variable vss-description as character no-undo init "Инициализация глобальных переменных".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   do
       82   on error undo, return error return-value
       83   :
       84     define variable v-msg as character no-undo .
       85     define variable conf-par as character no-undo .
       86     define variable par-type as character no-undo .
       87     define buffer buf_sys-ctrl       for ub.sys-ctrl .
       88     define buffer buf_other-sys-ctrl for ub.sys-ctrl .
       89     assign
       90       session :time-source = "ub"
       91     .
       92     find first buf_sys-ctrl no-lock
       93       no-error .
       94     if not available buf_sys-ctrl
       95     then do:
       96       message
       97         "Невозможно определить номер базы данных" skip
       98         "Не найдена запись sys-ctrl" skip
       99         "Невозможно продолжить работу системы" skip
      100         view-as alert-box error .
      101       undo, return error return-value .
      102     end.
      103     find first buf_other-sys-ctrl no-lock
      104       where rowid(buf_other-sys-ctrl) <> rowid(buf_sys-ctrl)
      105       no-error .
      106     if available buf_other-sys-ctrl
      107     then do:
      108       message
      109         "Невозможно определить номер базы данных" skip
      110         "Найдено более одной записи sys-ctrl" skip
      111         "Невозможно продолжить работу системы" skip
      112         view-as alert-box error .
      113       undo, return error return-value .
      114     end.
      115     assign
      116       g#auto           = p-auto-value
      117       g#news           = false
      118       g#news-source-db = -1
      119       g#db-num         = buf_sys-ctrl.db-num
      120       g#userid         = p-user-id
      121       g#passwd         = p-user-passwd
      122     .
      123     def var gblVarObj as class gbl-var.
      124     gblVarObj = new gbl-var().
      125     gblVarObj:InitObj (g#auto, g#news-source-db, g#db-num, g#userid, g#passwd, g#esys).
      126     delete object gblVarObj no-error.
      127     define new global shared var g#language as character no-undo .
      128     assign
      129       g#language = buf_sys-ctrl.language
      130     .
      131     release buf_sys-ctrl.
      132     if g#language <> 'eng':U
      133       and g#language <> 'rus':U
      134     then do:
      135       assign
      136         v-msg = substitute( "&1. Неправильное значение параметра &2&3Должно быть &4 или &5", vss-workfile, "language":U, chr(10), 'eng':U, 'rus':U )
      137       .
      138       if g#news <> true then do:
      139         message
      140           vss-workfile vss-revision vss-description skip
      141           v-msg skip
      142           view-as alert-box error .
      143       end.
      144       undo, return error v-msg .
      145     end.
      146     if g#language <> "rus"
      147     then do:
      148       assign
      149         v-msg = substitute( "&1. Incorrect version of str-glbl.i or incorrect value of &2 paramater&3Check str-glbl.i &2&3 Check language parameter &4":U, vss-workfile, "language":U, chr(10), g#language )
      150       .
      151       if g#news <> true then do:
      152         message
      153           vss-workfile vss-revision vss-description skip
      154           v-msg skip
      155           view-as alert-box error .
      156       end.
      157       undo, return error v-msg .
      158     end.
      159      if not p-user-passwd begins "nocrypt:"
      160     then do:
      161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      162     (input  'oxmlthon':u
      163     ,input  '':u
      164     ,input  '':u
      165     ,input  0
      166     ,input  '':u
      167     ,input  '':u
      168     ,input  '':u
      169     ,input  no
      170     ,output conf-par
      171     ,output par-type
      172     ) no-error .
      173       if error-status :error
      174       then do:
      175           assign
      176               g#oxml = no
      177           .
      178       end.
      179       else do:
      180           if par-type = 'L':U
      181           and conf-par = 'yes':u
      182           then do:
      183               assign
      184                   g#oxml = yes
      185               .
      186           end.
      187           else do:
      188               assign
      189                   g#oxml = no
      190               .
      191           end.
      192       end.
      193   end.
      194   end.
