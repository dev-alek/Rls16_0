        1   DEFINE TEMP-TABLE x_thbj-attr NO-UNDO LIKE ub.thbj-attr
        2          field ind1 as char
        3          field p1 as char
        4          field d1 as char
        5          index pi ind1
        6          .
        7   define input  parameter p-upper-code as character no-undo .
        8   define input  parameter p-code       as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Просмотр Параметров по всем объектам для thbjattr".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define new global shared variable g#attr-lib  as handle no-undo .
      131   define variable v-attr-lib-variable as handle no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      134   procedure thbjattr_code :
      135      define input  parameter p-upper-code     as character no-undo .
      136      define input  parameter p-code           as character no-undo .
      137      define output parameter p-label          as character no-undo .
      138      define output parameter p-user-can-edit  as logical   no-undo .
      139      define output parameter p-output-display as logical   no-undo .
      140      define output parameter p-other          as character no-undo .
      141      define output parameter p-prop-list      as character no-undo .
      142      define output parameter p-prop-type-list as character no-undo .
      143      define output parameter p-prop-label-list as character no-undo .
      144      define output parameter p-global          as logical no-undo .
      145      define output parameter p-host           as logical no-undo .
      146      define output parameter p-shop           as logical no-undo .
      147      define output parameter p-store          as logical no-undo .
      148      define output parameter p-db             as logical no-undo .
      149      define variable p-region as logical no-undo.
      150      run thbjattr_code_reg in this-procedure (
      151                                               p-upper-code,
      152                                               p-code,
      153                                               output p-label,
      154                                               output p-user-can-edit,
      155                                               output p-output-display,
      156                                               output p-other,
      157                                               output p-prop-list,
      158                                               output p-prop-type-list,
      159                                               output p-prop-label-list,
      160                                               output p-global,
      161                                               output p-host,
      162                                               output p-shop,
      163                                               output p-store,
      164                                               output p-db,
      165                                               output p-region
      166                                               ).
      167   end procedure.
      168   procedure thbjattr_code_reg :
      169   define input  parameter p-upper-code     as character no-undo .
      170   define input  parameter p-code           as character no-undo .
      171   define output parameter p-label          as character no-undo .
      172   define output parameter p-user-can-edit  as logical   no-undo .
      173   define output parameter p-output-display as logical   no-undo .
      174   define output parameter p-other          as character no-undo .
      175   define output parameter p-prop-list      as character no-undo .
      176   define output parameter p-prop-type-list as character no-undo .
      177   define output parameter p-prop-label-list as character no-undo .
      178   define output parameter p-global          as logical no-undo .
      179   define output parameter p-host           as logical no-undo .
      180   define output parameter p-shop           as logical no-undo .
      181   define output parameter p-store          as logical no-undo .
      182   define output parameter p-db             as logical no-undo .
      183   define output parameter p-region         as logical no-undo .
      184   do
      185   on error undo, return error return-value
      186   :
      187       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      188       (input  p-upper-code
      189       ,input  p-code
      190       ,output p-label
      191       ,output p-user-can-edit
      192       ,output p-output-display
      193       ,output p-other
      194       ,output p-prop-list
      195       ,output p-prop-type-list
      196       ,output p-prop-label-list
      197       ,output p-global
      198       ,output p-host
      199       ,output p-shop
      200       ,output p-store
      201       ,output p-db
      202       ,output p-region
      203       ) no-error .
      204     if error-status :error
      205     then do:
      206       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      207     end.
      208   end.
      209   end procedure.
