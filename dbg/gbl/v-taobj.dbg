      420   define variable v-tooltip as character no-undo .
      421   define variable v-label   as character no-undo .
      422   define variable v-tooltip-code as character no-undo .
      423   define variable v-host-code as integer   no-undo .
      424   DEFINE BUTTON B-Help
      425        LABEL "&Help"
      426        SIZE 3 BY 1
      427        BGCOLOR 8 .
      428   DEFINE VARIABLE v-info AS CHARACTER
      429        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      430        SIZE 62.38 BY 3.33 TOOLTIP "Справочная информация о параметре" NO-UNDO.
      431   DEFINE QUERY BROWSE-2 FOR
      432         x_thbj-attr SCROLLING.
      433   DEFINE BROWSE BROWSE-2
      434     QUERY BROWSE-2 NO-LOCK DISPLAY
      435         X_thbj-attr.p1 FORMAT "X(9)":U COLUMN-LABEL "Уровень"
      436         X_thbj-attr.obj-type FORMAT "X(3)":U
      437         X_thbj-attr.obj-code FORMAT ">>>>>>>>>":U COLUMN-LABEL "Код"
      438         X_thbj-attr.d1  COLUMN-LABEL "Значение" FORMAT "x(100)":U
      439       WITH NO-ROW-MARKERS SEPARATORS SIZE 65.5 BY 12.25 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      440   DEFINE FRAME Dialog-Frame
      441        B-Help AT ROW 1 COL 65
      442        v-info AT ROW 2 COL 1.88 NO-LABEL WIDGET-ID 6
      443        BROWSE-2 AT ROW 5.5 COL 1.75 WIDGET-ID 200
      444        SPACE(1.12) SKIP(0.07)
      445       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      446            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      447            TITLE "<insert dialog title>" WIDGET-ID 100.
      448   ASSIGN
      449          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      450          FRAME Dialog-Frame:HIDDEN           = TRUE.
      451   ASSIGN
      452          v-info:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      453   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      454   DO:
      455     APPLY "END-ERROR":U TO SELF.
      456   END.
      457   ON CHOOSE OF B-Help IN FRAME Dialog-Frame
      458   OR HELP OF FRAME Dialog-Frame
      459   DO:
      460   END.
      461   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      462   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      463   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   on help of frame Dialog-Frame
      465   do:
      466     run gbl/app_help.p
      467       (input this-procedure :file-name
      468       ,input ''
      469       ,input ?
      470       ) no-error.
      471     if error-status :error then do:
      472       message
      473         "Ошибка при вызове помощи"
      474         error-status :get-message(1)
      475         view-as alert-box .
      476     end.
      477   end.
      478   run minbtn-set in this-procedure .
      479   on choose of b-help in frame Dialog-Frame
      480   do:
      481     apply "help":u to frame Dialog-Frame .
      482   end.
      483   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      484   procedure minbtn-set :
      485       do
      486           on error undo, return error return-value
      487           :
      488           define variable ii              as integer       no-undo .
      489           define variable fh              as widget-handle no-undo .
      490           define variable hh              as widget-handle no-undo .
      491           define variable v-h             as handle        extent 4 no-undo .
      492           define variable v-name-button   as character     no-undo .
      493           define variable v-help-old-x    as decimal       no-undo .
      494           define variable v-help-old-y    as decimal       no-undo .
      495           define variable v-help-old-size as decimal       no-undo .
      496           define variable v-frame-width   as decimal       no-undo .
      497           define variable jj              as integer       no-undo .
      498           do
      499               on error undo, return error
      500               :
      501               assign
      502                   v-frame-width = frame Dialog-Frame:width - 0.3
      503                   fh            = frame Dialog-Frame:first-child
      504                   hh            = fh:first-child
      505                   ii            = 1
      506                   .
      507               do while valid-handle(hh):
      508                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      509                   do:
      510                       case lc(hh:name) :
      511                           when "b-help" then
      512                               do:
      513                                   hh:load-image-up("cmp/b-help.bmp":u) .
      514                                   hh:load-image-down("cmp/b-help.bmp":u) .
      515                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      516                                   hh:TOOLTIP = "Помощь" .
      517                                   v-help-old-x = hh:column .
      518                                   v-help-old-y = hh:row    .
      519                                   v-help-old-size = hh:width .
      520                                   hh:width-chars = 2.5 .
      521                               end.
      522                           when "b-print" then
      523                               do:
      524                                   hh:load-image("cmp/b-print.bmp":u) .
      525                                   hh:TOOLTIP = "Печать" .
      526                                   v-h[ii] = hh:handle .
      527                                   ii = ii + 1 .
      528                                   hh:width-chars = 3 .
      529                               end.
      530                           when "b-history" or
      531                           when "b-hist" then
      532                               do:
      533                                   hh:load-image("cmp/b-hist.bmp":u) .
      534                                   hh:TOOLTIP = "История" .
      535                                   v-h[ii] = hh:handle .
      536                                   ii = ii + 1 .
      537                                   hh:width-chars = 3 .
      538                               end.
      539                           when "b-sch" then
      540                               do:
      541                                   hh:load-image("cmp/b-sch.bmp":u) .
      542                                   hh:TOOLTIP = "Установка Фильтра" .
      543                                   v-h[ii] = hh:handle .
      544                                   ii = ii + 1 .
      545                                   hh:width-chars = 3 .
      546                               end.
      547                           when "b-hist-user" then
      548                               do:
      549                                   hh:load-image("cmp/b-hist.bmp":u) .
      550                                   hh:TOOLTIP = "История пользователя" .
      551                                   ii = ii + 1 .
      552                               end.
      553                       end case.
      554                   end.
      555                   hh = hh:next-sibling.
      556               end.
      557               b-help:column = v-frame-width - b-help:width-chars.
      558               jj = 0.
      559               repeat ii = 4 to 1 by -1 :
      560                   if valid-handle (v-h[ii] ) then
      561                   do:
      562                       jj  = jj + 1 .
      563                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      564                       v-h[ii]:row    = v-help-old-y .
      565                   end.
      566               end.
      567           end.
      568       end.
      569   end procedure.
      570   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      571   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      572   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      573   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      574   define variable v-diasize-current-frame-width  as decimal   no-undo .
      575   define variable v-diasize-current-frame-height as decimal   no-undo .
      576   define variable v-diasize-change-size          as logical   no-undo .
      577   define variable v-diasize-resize-button        as handle    no-undo .
      578   define variable v-diasize-wndmax               as logical   no-undo .
      579   define variable v-diasize-wndstore             as logical   no-undo .
      580   define variable v-diasize-proc-name            as character no-undo .
      581   define variable v-diasize-browse-handle        as handle    no-undo .
      582   define variable v-diasize-browse-number        as integer   no-undo .
      583   define variable v-diasize-need-full-display    as logical   no-undo init false .
      584   define temp-table temp-diasize-handle no-undo
      585     field handle-value  as handle
      586     field save-position as decimal
      587     index xpk is primary unique handle-value
      588     .
      589   define temp-table temp-browse-handle no-undo
      590     field browse-type   as character
      591     field browse-number as integer
      592     field browse-handle as handle
      593     field original-size as decimal
      594     index xpk is primary unique browse-type browse-number
      595     index xie browse-type browse-handle
      596   .
      597   procedure diasize_change-height :
      598     define input  parameter p-change-value  as decimal   no-undo .
      599     define input  parameter p-move-resize   as logical   no-undo .
      600     define variable v-field-group-handle    as handle    no-undo .
      601     define variable v-object-handle         as handle    no-undo .
      602     define variable v-frame-height          as decimal   no-undo .
      603     define variable v-frame-virtual-height  as decimal   no-undo .
      604     define variable v-browse-height         as decimal   no-undo .
      605     define variable v-window-height         as decimal   no-undo .
      606     define variable v-window-virtual-height as decimal   no-undo .
      607     define variable v-change-sign           as integer   no-undo .
      608     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      609     define buffer buf_temp-browse-handle  for temp-browse-handle .
      610     if p-change-value > 0
      611     then do:
      612       if frame Dialog-Frame :height + p-change-value
      613           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      614       then do:
      615         assign
      616           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      617                           - (frame Dialog-Frame :height-chars)
      618         .
      619         if p-change-value <= 0
      620         then do:
      621           run diasize_position-resize-button in this-procedure .
      622           return .
      623         end.
      624       end.
      625     end.
      626     if p-change-value < 0
      627     then do:
      628       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      629       then do:
      630         assign
      631           p-change-value = v-diasize-orig-frame-height
      632                          - (frame Dialog-Frame :height-chars)
      633         .
      634         if p-change-value >= 0
      635         then do:
      636           run diasize_position-resize-button in this-procedure .
      637           return .
      638         end.
      639       end.
      640     end.
      641     if p-change-value >= 0
      642     then do:
      643       assign
      644         v-change-sign = 1
      645       .
      646     end.
      647     else do:
      648       assign
      649         v-change-sign = -1
      650       .
      651     end.
      652     assign
      653       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      654     .
      655     if p-change-value = 0
      656     then do:
      657       run diasize_position-resize-button in this-procedure .
      658       return .
      659     end.
      660     move_block:
      661     do
      662     on error undo move_block, retry move_block
      663     :
      664       if retry
      665       then do:
      666         do
      667         on error undo move_block, leave move_block
      668         :
      669           if p-change-value > 0
      670           then do:
      671             for each buf_temp-diasize-handle
      672             on error undo, next
      673             :
      674               assign
      675                 v-object-handle = buf_temp-diasize-handle.handle-value
      676               .
      677               if v-object-handle <> v-diasize-resize-button
      678               then do:
      679                 assign
      680                   v-object-handle :row = buf_temp-diasize-handle.save-position
      681                 .
      682               end.
      683             end.
      684             assign
      685               v-diasize-browse-handle :height = v-browse-height
      686             .
      687             for each buf_temp-browse-handle
      688               where buf_temp-browse-handle.browse-type = 'height':u
      689             on error undo, next
      690             :
      691               assign
      692                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      693               .
      694             end.
      695             assign
      696               frame Dialog-Frame :height = v-frame-height
      697             .
      698             if frame Dialog-Frame :scrollable = true
      699             then do:
      700               assign
      701                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      702               .
      703             end.
      704             run diasize_position-resize-button in this-procedure .
      705           end.
      706           else do:
      707             if frame Dialog-Frame :scrollable = true
      708             then do:
      709               assign
      710                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      711               .
      712             end.
      713             assign
      714               frame Dialog-Frame :height = v-frame-height
      715             .
      716             assign
      717               v-diasize-browse-handle :height = v-browse-height
      718             .
      719             for each buf_temp-browse-handle
      720               where buf_temp-browse-handle.browse-type = 'height':u
      721             on error undo, next
      722             :
      723               assign
      724                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      725               .
      726             end.
      727             for each buf_temp-diasize-handle
      728             on error undo, next
      729             :
      730               assign
      731                 v-object-handle = buf_temp-diasize-handle.handle-value
      732               .
      733               if v-object-handle <> v-diasize-resize-button
      734               then do:
      735                 assign
      736                   v-object-handle :row = buf_temp-diasize-handle.save-position
      737                 .
      738               end.
      739             end.
      740             run diasize_position-resize-button in this-procedure .
      741           end.
      742           assign
      743             v-diasize-change-size = false
      744           .
      745           leave move_block .
      746         end.
      747       end.
      748       assign
      749         v-diasize-need-full-display = true
      750       .
      751       if v-diasize-change-size = false
      752       then do:
      753         assign
      754           v-diasize-change-size = true
      755         .
      756       end.
      757       else do:
      758         return .
      759       end.
      760       assign
      761         v-frame-height = frame Dialog-Frame :height
      762         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      763         v-browse-height = v-diasize-browse-handle :height
      764       .
      765       for each buf_temp-browse-handle
      766         where buf_temp-browse-handle.browse-type = 'height':u
      767       :
      768         assign
      769           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      770         .
      771       end.
      772       for each buf_temp-diasize-handle
      773       :
      774         delete buf_temp-diasize-handle .
      775       end.
      776       assign
      777         v-field-group-handle = frame Dialog-Frame :first-child
      778       .
      779       do while valid-handle(v-field-group-handle)
      780       :
      781         assign
      782           v-object-handle = v-field-group-handle :first-child
      783         .
      784         do while valid-handle(v-object-handle)
      785         :
      786           if  v-object-handle <> v-diasize-browse-handle :handle
      787           and can-query(v-object-handle, "row")
      788           and can-query(v-object-handle, "height")
      789           and ( v-object-handle :row > v-diasize-browse-handle :row )
      790           then do:
      791             find first buf_temp-browse-handle
      792               where buf_temp-browse-handle.browse-type   = 'height':u
      793                 and buf_temp-browse-handle.browse-handle = v-object-handle
      794               no-error .
      795             if available buf_temp-browse-handle
      796             then do:
      797             end.
      798             else do:
      799               create buf_temp-diasize-handle .
      800               assign
      801                 buf_temp-diasize-handle.handle-value  = v-object-handle
      802                 buf_temp-diasize-handle.save-position = v-object-handle :row
      803               .
      804             end.
      805           end.
      806           assign
      807             v-object-handle = v-object-handle :next-sibling
      808           .
      809         end.
      810         assign
      811           v-field-group-handle = v-field-group-handle :next-sibling
      812         .
      813       end.
      814       do with frame Dialog-Frame
      815       :
      816         hide v-diasize-resize-button .
      817         assign
      818           v-diasize-resize-button :row    = 1
      819           v-diasize-resize-button :column = 1
      820         .
      821       end.
      822       if p-change-value > 0
      823       then do:
      824         if frame Dialog-Frame :scrollable = true
      825         then do:
      826           assign
      827             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      828             no-error .
      829           if error-status :error
      830           or error-status :get-message(1) <> ""
      831           then do:
      832             undo move_block, retry move_block .
      833           end.
      834         end.
      835         assign
      836           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      837           no-error .
      838         if error-status :error
      839         or error-status :get-message(1) <> ""
      840         then do:
      841           undo move_block, retry move_block .
      842         end.
      843         assign
      844           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      845           no-error .
      846         if error-status :error
      847         or error-status :get-message(1) <> ""
      848         then do:
      849           undo move_block, retry move_block .
      850         end.
      851         for each buf_temp-browse-handle
      852           where buf_temp-browse-handle.browse-type = 'height':u
      853         on error undo move_block, retry move_block
      854         :
      855           assign
      856             buf_temp-browse-handle.browse-handle :height
      857               = buf_temp-browse-handle.browse-handle :height + p-change-value
      858             no-error .
      859           if error-status :error
      860           or error-status :get-message(1) <> ""
      861           then do:
      862             undo move_block, retry move_block .
      863           end.
      864         end.
      865         for each buf_temp-diasize-handle
      866         on error undo move_block, retry move_block
      867         :
      868           assign
      869             v-object-handle = buf_temp-diasize-handle.handle-value
      870           .
      871           if v-object-handle <> v-diasize-resize-button
      872           then do:
      873             assign
      874               v-object-handle :row = v-object-handle :row + p-change-value
      875               no-error .
      876             if error-status :error
      877             or error-status :get-message(1) <> ""
      878             then do:
      879               undo move_block, retry move_block .
      880             end.
      881           end.
      882         end.
      883       end.
      884       else do:
      885         for each buf_temp-diasize-handle
      886         on error undo move_block, retry move_block
      887         :
      888           assign
      889             v-object-handle = buf_temp-diasize-handle.handle-value
      890           .
      891           if v-object-handle <> v-diasize-resize-button
      892           then do:
      893             assign
      894               v-object-handle :row = v-object-handle :row + p-change-value
      895               no-error .
      896             if error-status :error
      897             or error-status :get-message(1) <> ""
      898             then do:
      899               undo move_block, retry move_block .
      900             end.
      901           end.
      902         end.
      903         assign
      904           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      905           no-error .
      906         if error-status :error
      907         or error-status :get-message(1) <> ""
      908         then do:
      909           undo move_block, retry move_block .
      910         end.
      911         for each buf_temp-browse-handle
      912           where buf_temp-browse-handle.browse-type = 'height':u
      913         on error undo move_block, retry move_block
      914         :
      915           assign
      916             buf_temp-browse-handle.browse-handle :height
      917               = buf_temp-browse-handle.browse-handle :height + p-change-value
      918             no-error .
      919           if error-status :error
      920           or error-status :get-message(1) <> ""
      921           then do:
      922             undo move_block, retry move_block .
      923           end.
      924         end.
      925         assign
      926           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      927           no-error .
      928         if error-status :error
      929         or error-status :get-message(1) <> ""
      930         then do:
      931           undo move_block, retry move_block .
      932         end.
      933         if frame Dialog-Frame :scrollable = true
      934         then do:
      935           assign
      936             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      937             no-error .
      938           if error-status :error
      939           or error-status :get-message(1) <> ""
      940           then do:
      941             undo move_block, retry move_block .
      942           end.
      943         end.
      944       end.
      945       if p-move-resize = true
      946       then do:
      947         run diasize_position-resize-button in this-procedure .
      948       end.
      949       if v-diasize-wndstore = true
      950       then do:
      951         if connected("ub") = true
      952         then do:
      953           define variable v-cntxt-db-num        as integer   no-undo .
      954           define variable v-cntxt-userid        as character no-undo .
      955           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      956                                             , OUTPUT v-cntxt-userid
      957                                             ) .
      958           run gbl/wndsizew.p
      959             (input  v-cntxt-db-num
      960             ,input  v-cntxt-userid
      961             ,input  v-diasize-proc-name
      962             ,input  'height':u
      963             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      964             ) .
      965         end.
      966       end.
      967     end.
      968     assign
      969       v-diasize-change-size = false
      970     .
      971   end procedure.
      972   procedure diasize_set-height :
      973     define input  parameter p-new-height  as decimal   no-undo .
      974     define input  parameter p-move-resize as logical   no-undo .
      975     do
      976     on error undo, return error return-value
      977     :
      978       run diasize_change-height in this-procedure
      979         (input  (p-new-height - frame Dialog-Frame :height)
      980         ,input  p-move-resize
      981         ) .
      982     end.
      983   end procedure.
      984   procedure diasize_change-width :
      985     define input  parameter p-change-value as decimal   no-undo .
      986     define input  parameter p-move-resize  as logical   no-undo .
      987     define variable v-field-group-handle   as handle    no-undo .
      988     define variable v-object-handle        as handle    no-undo .
      989     define variable v-frame-width          as decimal   no-undo .
      990     define variable v-frame-virtual-width  as decimal   no-undo .
      991     define variable v-browse-width         as decimal   no-undo .
      992     define variable v-window-width         as decimal   no-undo .
      993     define variable v-window-virtual-width as decimal   no-undo .
      994     define variable v-change-sign          as integer   no-undo .
      995     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      996     define buffer buf_temp-browse-handle  for temp-browse-handle .
      997     if p-change-value > 0
      998     then do:
      999       if frame Dialog-Frame :width + p-change-value >
     1000           session :width-chars
     1001       then do:
     1002         assign
     1003           p-change-value = session :width-chars - frame Dialog-Frame :width
     1004         .
     1005         if p-change-value <= 0
     1006         then do:
     1007           run diasize_position-resize-button in this-procedure .
     1008           return .
     1009         end.
     1010       end.
     1011     end.
     1012     if p-change-value < 0
     1013     then do:
     1014       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1015       then do:
     1016         assign
     1017           p-change-value = v-diasize-orig-frame-width
     1018                          - frame Dialog-Frame :width
     1019         .
     1020         if p-change-value >= 0
     1021         then do:
     1022           run diasize_position-resize-button in this-procedure .
     1023           return .
     1024         end.
     1025       end.
     1026     end.
     1027     if p-change-value >= 0
     1028     then do:
     1029       assign
     1030         v-change-sign = 1
     1031       .
     1032     end.
     1033     else do:
     1034       assign
     1035         v-change-sign = -1
     1036       .
     1037     end.
     1038     assign
     1039       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1040     .
     1041     if p-change-value = 0
     1042     then do:
     1043       run diasize_position-resize-button in this-procedure .
     1044       return .
     1045     end.
     1046     move_block:
     1047     do
     1048     on error undo move_block, leave move_block
     1049     :
     1050       if retry
     1051       then do:
     1052         do
     1053         on error undo move_block, leave move_block
     1054         :
     1055           if p-change-value > 0
     1056           then do:
     1057             for each buf_temp-diasize-handle
     1058             on error undo, next
     1059             :
     1060               assign
     1061                 v-object-handle = buf_temp-diasize-handle.handle-value
     1062               .
     1063               if v-object-handle <> v-diasize-resize-button
     1064               then do:
     1065                 assign
     1066                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1067                 .
     1068               end.
     1069             end.
     1070             assign
     1071               v-diasize-browse-handle :width = v-browse-width
     1072             .
     1073             for each buf_temp-browse-handle
     1074               where buf_temp-browse-handle.browse-type = 'width':u
     1075             on error undo, next
     1076             :
     1077               assign
     1078                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1079               .
     1080             end.
     1081             assign
     1082               frame Dialog-Frame :width = v-frame-width
     1083             .
     1084             if frame Dialog-Frame :scrollable = true
     1085             then do:
     1086               assign
     1087                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1088               .
     1089             end.
     1090             run diasize_position-resize-button in this-procedure .
     1091           end.
     1092           else do:
     1093             if frame Dialog-Frame :scrollable = true
     1094             then do:
     1095               assign
     1096                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1097               .
     1098             end.
     1099             assign
     1100               frame Dialog-Frame :width = v-frame-width
     1101             .
     1102             for each buf_temp-browse-handle
     1103               where buf_temp-browse-handle.browse-type = 'width':u
     1104             on error undo, next
     1105             :
     1106               assign
     1107                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1108               .
     1109             end.
     1110             assign
     1111               v-diasize-browse-handle :width = v-browse-width
     1112             .
     1113             for each buf_temp-diasize-handle
     1114             on error undo, next
     1115             :
     1116               assign
     1117                 v-object-handle = buf_temp-diasize-handle.handle-value
     1118               .
     1119               if v-object-handle <> v-diasize-resize-button
     1120               then do:
     1121                 assign
     1122                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1123                 .
     1124               end.
     1125             end.
     1126             run diasize_position-resize-button in this-procedure .
     1127           end.
     1128           assign
     1129             v-diasize-change-size = false
     1130           .
     1131           leave move_block .
     1132         end.
     1133       end.
     1134       assign
     1135         v-diasize-need-full-display = true
     1136       .
     1137       if v-diasize-change-size = false
     1138       then do:
     1139         assign
     1140           v-diasize-change-size = true
     1141         .
     1142       end.
     1143       else do:
     1144         return .
     1145       end.
     1146       assign
     1147         v-frame-width = frame Dialog-Frame :width
     1148         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1149         v-browse-width = v-diasize-browse-handle :width
     1150       .
     1151       for each buf_temp-browse-handle
     1152         where buf_temp-browse-handle.browse-type = 'width':u
     1153       :
     1154         assign
     1155           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1156         .
     1157       end.
     1158       for each buf_temp-diasize-handle
     1159       :
     1160         delete buf_temp-diasize-handle .
     1161       end.
     1162       assign
     1163         v-field-group-handle = frame Dialog-Frame :first-child
     1164       .
     1165       do while valid-handle(v-field-group-handle)
     1166       :
     1167         assign
     1168           v-object-handle = v-field-group-handle :first-child
     1169         .
     1170         do while valid-handle(v-object-handle)
     1171         :
     1172           if  v-object-handle <> v-diasize-browse-handle :handle
     1173           and v-object-handle <> v-diasize-resize-button
     1174           and can-query(v-object-handle, "row")
     1175           and can-query(v-object-handle, "height")
     1176           and ( v-object-handle :col + v-object-handle :width
     1177                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1178               )
     1179           then do:
     1180             find first buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type   = 'width':u
     1182                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1183               no-error .
     1184             if available buf_temp-browse-handle
     1185             then do:
     1186             end.
     1187             else do:
     1188               create buf_temp-diasize-handle .
     1189               assign
     1190                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1191                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1192               .
     1193             end.
     1194           end.
     1195           assign
     1196             v-object-handle = v-object-handle :next-sibling
     1197           .
     1198         end.
     1199         assign
     1200           v-field-group-handle = v-field-group-handle :next-sibling
     1201         .
     1202       end.
     1203       do with frame Dialog-Frame
     1204       :
     1205         hide v-diasize-resize-button .
     1206         v-diasize-resize-button :row = 1.
     1207         v-diasize-resize-button :column = 1.
     1208       end.
     1209       if p-change-value > 0
     1210       then do:
     1211         if frame Dialog-Frame :scrollable = true
     1212         then do:
     1213           assign
     1214             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1215             no-error .
     1216           if error-status :error
     1217           or error-status :get-message(1) <> ""
     1218           then do:
     1219             undo move_block, retry move_block.
     1220           end.
     1221         end.
     1222         assign
     1223           frame Dialog-Frame :width = v-frame-width + p-change-value
     1224           no-error .
     1225         if error-status :error
     1226         or error-status :get-message(1) <> ""
     1227         then do:
     1228           undo move_block, retry move_block.
     1229         end.
     1230         assign
     1231           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1232         no-error .
     1233         if error-status :error
     1234         or error-status :get-message(1) <> ""
     1235         then do:
     1236           undo move_block, retry move_block.
     1237         end.
     1238         for each buf_temp-browse-handle
     1239           where buf_temp-browse-handle.browse-type = 'width':u
     1240         on error undo move_block, retry move_block
     1241         :
     1242           assign
     1243             buf_temp-browse-handle.browse-handle :width
     1244               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1245             no-error .
     1246           if error-status :error
     1247           or error-status :get-message(1) <> ""
     1248           then do:
     1249             undo move_block, retry move_block .
     1250           end.
     1251         end.
     1252         for each buf_temp-diasize-handle
     1253         on error undo move_block, retry move_block
     1254         :
     1255           assign
     1256             v-object-handle = buf_temp-diasize-handle.handle-value
     1257           .
     1258           if v-object-handle <> v-diasize-resize-button
     1259           then do:
     1260             assign
     1261               v-object-handle :col = v-object-handle :col + p-change-value
     1262               no-error .
     1263             if error-status :error
     1264             or error-status :get-message(1) <> ""
     1265             then do:
     1266               undo move_block, retry move_block .
     1267             end.
     1268           end.
     1269         end.
     1270       end.
     1271       else do:
     1272         for each buf_temp-diasize-handle
     1273         on error undo move_block, retry move_block
     1274         :
     1275           assign
     1276             v-object-handle = buf_temp-diasize-handle.handle-value
     1277           .
     1278           if v-object-handle <> v-diasize-resize-button
     1279           then do:
     1280             assign
     1281               v-object-handle :col = v-object-handle :col + p-change-value
     1282               no-error .
     1283             if error-status :error
     1284             or error-status :get-message(1) <> ""
     1285             then do:
     1286               undo move_block, retry move_block .
     1287             end.
     1288           end.
     1289         end.
     1290         for each buf_temp-browse-handle
     1291           where buf_temp-browse-handle.browse-type = 'width':u
     1292         on error undo move_block, retry move_block
     1293         :
     1294           assign
     1295             buf_temp-browse-handle.browse-handle :width
     1296               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1297             no-error .
     1298           if error-status :error
     1299           or error-status :get-message(1) <> ""
     1300           then do:
     1301             undo move_block, retry move_block .
     1302           end.
     1303         end.
     1304         assign
     1305           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1306           no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block.
     1311         end.
     1312         assign
     1313           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1314         no-error .
     1315         if error-status :error
     1316         or error-status :get-message(1) <> ""
     1317         then do:
     1318           undo move_block, retry move_block.
     1319         end.
     1320         if frame Dialog-Frame :scrollable = true
     1321         then do:
     1322           assign
     1323             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1324           no-error .
     1325           if error-status :error
     1326           or error-status :get-message(1) <> ""
     1327           then do:
     1328             undo move_block, retry move_block.
     1329           end.
     1330         end.
     1331       end.
     1332       if p-move-resize
     1333       then do:
     1334         run diasize_position-resize-button in this-procedure .
     1335       end.
     1336       if v-diasize-wndstore = true
     1337       then do:
     1338         if connected("ub") = true
     1339         then do:
     1340           define variable v-cntxt-db-num        as integer   no-undo .
     1341           define variable v-cntxt-userid        as character no-undo .
     1342           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1343                                             , OUTPUT v-cntxt-userid
     1344                                             ) .
     1345           run gbl/wndsizew.p
     1346             (input  v-cntxt-db-num
     1347             ,input  v-cntxt-userid
     1348             ,input  v-diasize-proc-name
     1349             ,input  'width':u
     1350             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1351             ) .
     1352         end.
     1353       end.
     1354     end.
     1355     assign
     1356       v-diasize-change-size = false
     1357     .
     1358   end procedure.
     1359   procedure diasize_set-width :
     1360     define input  parameter p-new-width  as decimal   no-undo .
     1361     define input  parameter p-move-resize as logical   no-undo .
     1362     do
     1363     on error undo, return error return-value
     1364     :
     1365       run diasize_change-width in this-procedure
     1366         (input  (p-new-width - frame Dialog-Frame :width)
     1367         ,input  p-move-resize
     1368         ) .
     1369     end.
     1370   end procedure.
     1371   procedure diasize_position-resize-button :
     1372     do with frame Dialog-Frame
     1373     :
     1374       hide v-diasize-resize-button .
     1375       assign
     1376         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1377                     - 1
     1378                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1379         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1380                     - 1
     1381                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1382       .
     1383       view v-diasize-resize-button .
     1384     end.
     1385   end procedure.
     1386   on alt-right anywhere
     1387   do:
     1388     run diasize_change-width in this-procedure
     1389       (input 1
     1390       ,input true
     1391       ) .
     1392     return no-apply .
     1393   end.
     1394   on alt-left anywhere
     1395   do:
     1396     run diasize_change-width in this-procedure
     1397       (input -1
     1398       ,input true
     1399       ) .
     1400     return no-apply .
     1401   end.
     1402   on alt-down anywhere
     1403   do:
     1404     run diasize_change-height in this-procedure
     1405       (input 1
     1406       ,input true
     1407       ) .
     1408     return no-apply .
     1409   end.
     1410   on alt-up anywhere
     1411   do:
     1412     run diasize_change-height in this-procedure
     1413       (input -1
     1414       ,input true
     1415       ) .
     1416     return no-apply .
     1417   end.
     1418   on alt-enter of frame Dialog-Frame
     1419   do:
     1420     run diasize_maximize in this-procedure
     1421       (input  ?
     1422       ).
     1423     return no-apply .
     1424   end.
     1425   procedure diasize_end-move :
     1426     do
     1427     on error undo, return error return-value
     1428     :
     1429       define variable v-row-delta as decimal   no-undo .
     1430       define variable v-col-delta as decimal   no-undo .
     1431       define variable v-new-row as decimal   no-undo .
     1432       define variable v-new-col as decimal   no-undo .
     1433       assign
     1434         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1435         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1436       .
     1437       assign
     1438         v-row-delta = v-new-row - frame Dialog-Frame :height
     1439         v-col-delta = v-new-col - frame Dialog-Frame :width
     1440       .
     1441       run diasize_change-height in this-procedure
     1442         (input v-row-delta
     1443         ,input true
     1444         ) .
     1445       run diasize_change-width in this-procedure
     1446         (input v-col-delta
     1447         ,input true
     1448         ) .
     1449     end.
     1450   end procedure.
     1451   procedure diasize_maximize :
     1452     define input  parameter p-action as logical   no-undo .
     1453     do
     1454     on error undo, return error return-value
     1455     :
     1456       if p-action = ?
     1457       then do:
     1458         if v-diasize-need-maximize = true
     1459         then do:
     1460           assign
     1461             p-action = true
     1462           .
     1463         end.
     1464         else do:
     1465           assign
     1466             p-action = false
     1467           .
     1468         end.
     1469       end.
     1470       if p-action = true
     1471       then do:
     1472         run diasize_change-height in this-procedure
     1473           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1474               - frame Dialog-Frame :height-chars
     1475           ,input true
     1476           ) .
     1477         run diasize_change-width in this-procedure
     1478           (input session :width-chars
     1479               - frame Dialog-Frame :width-chars
     1480           ,input true
     1481           ) .
     1482         assign
     1483           v-diasize-need-maximize = false
     1484         .
     1485       end.
     1486       else do:
     1487         run diasize_change-width in this-procedure
     1488           (input v-diasize-orig-frame-width
     1489               - frame Dialog-Frame :width-chars
     1490           ,input true
     1491           ) .
     1492         run diasize_change-height in this-procedure
     1493           (input v-diasize-orig-frame-height
     1494               - frame Dialog-Frame :height-chars
     1495           ,input true
     1496           ) .
     1497         assign
     1498           v-diasize-need-maximize = true
     1499         .
     1500       end.
     1501     end.
     1502   end procedure.
     1503   procedure diasize_restore-orig-size :
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       assign
     1508         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1509         v-diasize-current-frame-height = frame Dialog-Frame :height
     1510       .
     1511       run diasize_set-height in this-procedure
     1512         (input  v-diasize-orig-frame-height
     1513         ,input  true
     1514         ) .
     1515       run diasize_set-width in this-procedure
     1516         (input  v-diasize-orig-frame-width
     1517         ,input  true
     1518         ) .
     1519     end.
     1520   end procedure.
     1521   procedure diasize_restore-current-size :
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       run diasize_set-height in this-procedure
     1526         (input  v-diasize-current-frame-height
     1527         ,input  true
     1528         ) .
     1529       run diasize_set-width in this-procedure
     1530         (input  v-diasize-current-frame-width
     1531         ,input  true
     1532         ) .
     1533     end.
     1534   end procedure.
     1535   procedure diasize_set-browse-handle :
     1536     define input  parameter p-browse-handle as handle   no-undo .
     1537     define buffer buf_temp-browse-handle for temp-browse-handle .
     1538     do
     1539     on error undo, return error return-value
     1540     :
     1541       assign
     1542         v-diasize-browse-handle = p-browse-handle
     1543       .
     1544       for each buf_temp-browse-handle
     1545       on error undo, return error return-value
     1546       :
     1547         delete buf_temp-browse-handle .
     1548       end.
     1549     end.
     1550   end procedure.
     1551   procedure diasize_add_browse :
     1552     define input  parameter p-browse-type   as character no-undo .
     1553     define input  parameter p-browse-handle as handle    no-undo .
     1554     define buffer buf_temp-browse-handle for temp-browse-handle .
     1555     do
     1556     on error undo, return error return-value
     1557     :
     1558       assign
     1559         v-diasize-browse-number = v-diasize-browse-number + 1
     1560       .
     1561       create buf_temp-browse-handle .
     1562       assign
     1563         buf_temp-browse-handle.browse-type   = p-browse-type
     1564         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1565         buf_temp-browse-handle.browse-handle = p-browse-handle
     1566       .
     1567     end.
     1568   end procedure.
     1569   procedure diasize_init :
     1570     define variable v-default-value    as logical   no-undo .
     1571     define variable v-restore-saved    as logical   no-undo .
     1572     define variable v-resize-value-str as character no-undo .
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       do with frame Dialog-Frame
     1577       :
     1578         assign
     1579           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1580           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1581           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1582         .
     1583         create button v-diasize-resize-button
     1584         assign
     1585           parent        = frame Dialog-Frame :first-child
     1586           label         = "s"
     1587           height-pixels = 16
     1588           width-pixels  = 16
     1589           visible       = true
     1590           sensitive     = true
     1591           movable       = true
     1592           triggers:
     1593             on end-move persistent run diasize_end-move in this-procedure .
     1594           end triggers.
     1595         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1596         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1597         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1598         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1599         assign
     1600           v-diasize-wndmax = false
     1601         .
     1602         if connected("ub") = true
     1603         then do:
     1604           define variable v-cntxt-db-num        as integer   no-undo .
     1605           define variable v-cntxt-userid        as character no-undo .
     1606           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1607                                             , OUTPUT v-cntxt-userid
     1608                                             ) .
     1609           run gbl/wndpar_r.p
     1610             (input  v-cntxt-db-num
     1611             ,input  v-cntxt-userid
     1612             ,input  'wndmax':U
     1613             ,output v-diasize-wndmax
     1614             ,output v-default-value
     1615             ) .
     1616         end.
     1617         assign
     1618           v-diasize-wndstore = false
     1619         .
     1620         if connected("ub") = true
     1621         then do:
     1622           run gbl/wndpar_r.p
     1623             (input  v-cntxt-db-num
     1624             ,input  v-cntxt-userid
     1625             ,input  'wndstore':U
     1626             ,output v-diasize-wndstore
     1627             ,output v-default-value
     1628             ) .
     1629         end.
     1630         assign
     1631           v-diasize-proc-name = entry(1, program-name(2), '.')
     1632         .
     1633         if v-diasize-wndstore = true
     1634         then do:
     1635           assign
     1636             v-restore-saved = false
     1637           .
     1638           if connected("ub") = true
     1639           then do:
     1640             run gbl/wndsizer.p
     1641               (input  v-cntxt-db-num
     1642               ,input  v-cntxt-userid
     1643               ,input  v-diasize-proc-name
     1644               ,input  'height':u
     1645               ,output v-resize-value-str
     1646               ) .
     1647             if v-resize-value-str <> '':U
     1648             then do:
     1649               run diasize_change-height in this-procedure
     1650                 (input  integer(v-resize-value-str)
     1651                 ,input  true
     1652                 ) .
     1653               assign
     1654                 v-restore-saved = true
     1655               .
     1656             end.
     1657           end.
     1658           if connected("ub") = true
     1659           then do:
     1660             run gbl/wndsizer.p
     1661               (input  v-cntxt-db-num
     1662               ,input  v-cntxt-userid
     1663               ,input  v-diasize-proc-name
     1664               ,input  'width':u
     1665               ,output v-resize-value-str
     1666               ) .
     1667             if v-resize-value-str <> '':U
     1668             then do:
     1669               run diasize_change-width in this-procedure
     1670                 (input  integer(v-resize-value-str)
     1671                 ,input  true
     1672                 ) .
     1673               assign
     1674                 v-restore-saved = true
     1675               .
     1676             end.
     1677           end.
     1678           if v-restore-saved <> true
     1679           then do:
     1680             if v-diasize-wndmax = true
     1681             then do:
     1682               run diasize_maximize in this-procedure
     1683                 (input  true
     1684                 ) .
     1685             end.
     1686           end.
     1687         end.
     1688         else do:
     1689           if v-diasize-wndmax = true
     1690           then do:
     1691             run diasize_maximize in this-procedure
     1692               (input  true
     1693               ) .
     1694           end.
     1695         end.
     1696       end.
     1697     end.
     1698   end procedure.
     1699   procedure diasize_need-full-display :
     1700     define output parameter p-need-full-display as logical   no-undo .
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704       assign
     1705         p-need-full-display = v-diasize-need-full-display
     1706       .
     1707       assign
     1708         v-diasize-need-full-display = false
     1709       .
     1710     end.
     1711   end procedure.
     1712   procedure get-context :
     1713      define output parameter p-db-num as integer          no-undo.
     1714      define output parameter p-user-id as character        no-undo.
     1715      define variable v-login               as character    no-undo.
     1716      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1717      define buffer buf_user-login  for ub.user-login .
     1718      do
     1719      on error undo, return error
     1720      :
     1721            FIND FIRST buf_sys-ctrl no-lock.
     1722            ASSIGN
     1723               v-login = USERID("ub")
     1724               p-db-num = buf_sys-ctrl.db-num
     1725            .
     1726            FIND FIRST buf_user-login
     1727                 WHERE buf_user-login.db-num = p-db-num
     1728                   AND buf_user-login.user-login = v-login
     1729                 no-lock
     1730                 no-error
     1731                 .
     1732            IF AVAILABLE buf_user-login
     1733            THEN DO:
     1734               assign
     1735                  p-user-id = buf_user-login.user-id
     1736               .
     1737            END.
     1738      end.
     1739   end procedure.
     1740       run diasize_init in this-procedure .
     1741   MAIN-BLOCK:
     1742   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1743      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1744   run thbjattr_tooltip in this-procedure (
     1745      input  p-upper-code
     1746     ,input  p-code
     1747     ,output v-tooltip
     1748     ,output v-label
     1749     ,output v-tooltip-code
     1750     ) no-error .
     1751    frame Dialog-Frame:title = entry( 2 ,v-label, ":" ) no-error .
     1752    if error-status :error then frame Dialog-Frame:title = v-label .
     1753    v-info =  REPLACE ( v-tooltip-code , "`" , "," ) .
     1754    display v-info with frame Dialog-Frame .
     1755     run init-tt in this-procedure .
     1756     run enable_ui in this-procedure .
     1757     WAIT-FOR GO OF FRAME Dialog-Frame.
     1758   END.
     1759   RUN disable_UI.
     1760   PROCEDURE disable_UI :
     1761     HIDE FRAME Dialog-Frame.
     1762   END PROCEDURE.
     1763   PROCEDURE enable_UI :
     1764     DISPLAY v-info
     1765         WITH FRAME Dialog-Frame.
     1766     ENABLE B-Help v-info BROWSE-2
     1767         WITH FRAME Dialog-Frame.
     1768     VIEW FRAME Dialog-Frame.
     1769     OPEN QUERY BROWSE-2 FOR EACH x_thbj-attr  NO-LOCK INDEXED-REPOSITION.
     1770   END PROCEDURE.
     1771   PROCEDURE init-tt :
     1772   define buffer buf_thbj-attr for ub.thbj-attr .
     1773   empty TEMP-TABLE  x_thbj-attr .
     1774   for each buf_thbj-attr no-lock where
     1775            buf_thbj-attr.upper-prop-code = p-upper-code and
     1776            buf_thbj-attr.prop-code       = p-code and
     1777            buf_thbj-attr.prop-code <> "" Break by buf_thbj-attr.obj-type by buf_thbj-attr.obj-code :
     1778      find first x_thbj-attr where
     1779                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type and
     1780                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code no-error .
     1781           if not available x_thbj-attr then do:
     1782             create  x_thbj-attr.
     1783             assign
     1784                 x_thbj-attr.obj-type = buf_thbj-attr.obj-type
     1785                 x_thbj-attr.obj-code = buf_thbj-attr.obj-code
     1786             .
     1787           end.
     1788          if buf_thbj-attr.obj-type  = "" then
     1789           assign
     1790             x_thbj-attr.p1 = "глобально"
     1791             x_thbj-attr.ind1 =  "0" + string( 0,"999999999") + "   " + string( 0 ,"999999999" )
     1792           .
     1793          if buf_thbj-attr.obj-type  = 'орг':U then
     1794           assign
     1795             x_thbj-attr.p1 = "фирма"
     1796             x_thbj-attr.ind1 =  "0" + string(buf_thbj-attr.obj-code,"999999999") + "   " + string( 0 ,"999999999" )
     1797           .
     1798          if buf_thbj-attr.obj-type  <> 'орг':U and buf_thbj-attr.obj-type  <> ""
     1799          and buf_thbj-attr.obj-type <> 'БД':U
     1800          then do:
     1801           assign
     1802             x_thbj-attr.p1 = " объект"
     1803           .
     1804   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1806     (input  buf_thbj-attr.obj-type
     1807     ,input  buf_thbj-attr.obj-code
     1808     ,output v-host-code
     1809     )  .
     1810            x_thbj-attr.ind1 =  "0" + string(v-host-code,"999999999") + buf_thbj-attr.obj-type + string(buf_thbj-attr.obj-code ,"999999999" ).
     1811          end.
     1812          if buf_thbj-attr.obj-type = 'БД':U then do:
     1813           assign
     1814             x_thbj-attr.p1 = " БД"
     1815             x_thbj-attr.ind1 = "0" + string( buf_thbj-attr.obj-code,":999999999") + "   " + string( 0 ,"999999999" ).
     1816          end.
     1817          case buf_thbj-attr.prop-value-type :
     1818          when 'character':U then do:
     1819               if      buf_thbj-attr.upper-prop-code eq "gismt"
     1820               and (   buf_thbj-attr.prop-code eq "oflinepswd"
     1821                    or buf_thbj-attr.prop-code eq "proxypswd"
     1822                    or buf_thbj-attr.prop-code eq "MaxApiToken")
     1823               then
     1824                  x_thbj-attr.d1 = fill("*",length (buf_thbj-attr.property-value-character)).
     1825                else
     1826                   x_thbj-attr.d1 = buf_thbj-attr.property-value-character.
     1827          end.
     1828          when 'integer':U then
     1829               assign
     1830                x_thbj-attr.d1 = string(buf_thbj-attr.property-value-integer)
     1831               .
     1832          when 'decimal':U then
     1833               assign
     1834                x_thbj-attr.d1 = string(buf_thbj-attr.property-value-decimal)
     1835               .
     1836          when 'logical':U then
     1837               assign
     1838                x_thbj-attr.d1 = string(buf_thbj-attr.property-value-logical,"да/нет")
     1839               .
     1840          when 'date':U then do:
     1841               assign
     1842                x_thbj-attr.d1 = string(buf_thbj-attr.property-value-date, "99/99/9999" )
     1843               .
     1844               if  x_thbj-attr.d1 = ? then x_thbj-attr.d1 = "" .
     1845               end.
     1846          end case.
     1847   end.
     1848   END PROCEDURE.
