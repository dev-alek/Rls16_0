        1   CREATE WIDGET-POOL.
        2   define input  parameter p-user-login    as character no-undo .
        3   define input  parameter p-user-password as character no-undo .
        4   define input  parameter p-port          as integer   no-undo .
        5   define input  parameter p-pos-num       as integer   no-undo .
        6   define input  parameter p-auto-start    as logical   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Окно запуска сервера".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   procedure sys-time_get-sys :
      118     define output parameter p-year         as integer   no-undo .
      119     define output parameter p-month        as integer   no-undo .
      120     define output parameter p-day          as integer   no-undo .
      121     define output parameter p-hour         as integer   no-undo .
      122     define output parameter p-minute       as integer   no-undo .
      123     define output parameter p-second       as integer   no-undo .
      124     define output parameter p-milliseconds as integer   no-undo .
      125     define variable v-system-time-structure as memptr    no-undo.
      126     do
      127     on error undo, return error return-value
      128     :
      129       assign
      130         set-size(v-system-time-structure) = 16
      131       .
      132       run GetSystemTime
      133         (input  get-pointer-value(v-system-time-structure)
      134         ) .
      135       assign
      136         p-year         = get-short(v-system-time-structure,  1)
      137         p-month        = get-short(v-system-time-structure,  3)
      138         p-day          = get-short(v-system-time-structure,  7)
      139         p-hour         = get-short(v-system-time-structure,  9)
      140         p-minute       = get-short(v-system-time-structure, 11)
      141         p-second       = get-short(v-system-time-structure, 13)
      142         p-milliseconds = get-short(v-system-time-structure, 15)
      143       .
      144       assign
      145         set-size(v-system-time-structure) = 0
      146       .
      147     end.
      148   end procedure.
      149   procedure sys-time_get-comp-user-name :
      150     define output parameter p-computer-name as character no-undo .
      151     define output parameter p-user-name     as character no-undo .
      152     define output parameter p-process-pid   as integer   no-undo .
      153     define variable v-return-value  as integer   no-undo .
      154     define variable v-buffer-length as integer   no-undo .
      155     define variable v-buffer-memptr as memptr    no-undo .
      156     do
      157     on error undo, return error return-value
      158     :
      159       assign
      160         v-buffer-length = 1024
      161         set-size(v-buffer-memptr) = v-buffer-length + 4
      162       .
      163       assign
      164         put-long(v-buffer-memptr, 1) = v-buffer-length
      165       .
      166       run GetComputerNameA
      167         (input  get-pointer-value(v-buffer-memptr) + 4
      168         ,input  get-pointer-value(v-buffer-memptr)
      169         ,output v-return-value
      170         ) .
      171       if v-return-value <> 0
      172       then do:
      173         assign
      174           p-computer-name = get-string(v-buffer-memptr, 5)
      175         .
      176       end.
      177       assign
      178         put-long(v-buffer-memptr, 1) = v-buffer-length
      179       .
      180       run GetUserNameA
      181         (input  get-pointer-value(v-buffer-memptr) + 4
      182         ,input  get-pointer-value(v-buffer-memptr)
      183         ,output v-return-value
      184         ) .
      185       if v-return-value <> 0
      186       then do:
      187         assign
      188           p-user-name = get-string(v-buffer-memptr, 5)
      189         .
      190       end.
      191       run GetCurrentProcessId
      192         (output p-process-pid
      193         ) .
      194       assign
      195         set-size(v-buffer-memptr) = 0
      196       .
      197     end.
      198   end procedure.
      199   procedure sys-time_get-http :
      200     define output parameter p-http-time as character no-undo .
      201     define variable v-year         as integer   no-undo .
      202     define variable v-month        as integer   no-undo .
      203     define variable v-day-of-week  as integer   no-undo .
      204     define variable v-day          as integer   no-undo .
      205     define variable v-hour         as integer   no-undo .
      206     define variable v-minute       as integer   no-undo .
      207     define variable v-second       as integer   no-undo .
      208     define variable v-milliseconds as integer   no-undo .
      209     do
      210     on error undo, return error return-value
      211     :
      212       run sys-time_get-sys in this-procedure
      213         (output v-year
      214         ,output v-month
      215         ,output v-day
      216         ,output v-hour
      217         ,output v-minute
      218         ,output v-second
      219         ,output v-milliseconds
      220         ) .
      221       assign
      222         v-day-of-week = weekday(date(v-month, v-day, v-year))
      223         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      224                     + ', ':u
      225                     + string(v-day, '99':u)
      226                     + ' ':u
      227                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      228                     + ' ':u
      229                     + string(v-year, '9999':u)
      230                     + ' ':u
      231                     + string(v-hour, '99':u)
      232                     + ':':u
      233                     + string(v-minute, '99':u)
      234                     + ':':u
      235                     + string(v-second, '99':u)
      236                     + ' ':u
      237                     + 'GMT':u
      238       .
      239     end.
      240   end procedure.
      241   procedure sys-time_set-sys :
      242     define input  parameter p-year         as integer   no-undo .
      243     define input  parameter p-month        as integer   no-undo .
      244     define input  parameter p-day          as integer   no-undo .
      245     define input  parameter p-hour         as integer   no-undo .
      246     define input  parameter p-minute       as integer   no-undo .
      247     define input  parameter p-second       as integer   no-undo .
      248     define input  parameter p-milliseconds as integer   no-undo .
      249     define variable v-system-time-structure as memptr    no-undo.
      250     define variable v-return-value as integer   no-undo .
      251     define variable v-day-of-week  as integer   no-undo .
      252     do
      253     on error undo, return error return-value
      254     :
      255       assign
      256         v-day-of-week = weekday(date(p-month, p-day, p-year))
      257       .
      258       assign
      259         set-size(v-system-time-structure) = 16
      260       .
      261       assign
      262         put-short(v-system-time-structure,  1) = p-year
      263         put-short(v-system-time-structure,  3) = p-month
      264         put-short(v-system-time-structure,  5) = v-day-of-week
      265         put-short(v-system-time-structure,  7) = p-day
      266         put-short(v-system-time-structure,  9) = p-hour
      267         put-short(v-system-time-structure, 11) = p-minute
      268         put-short(v-system-time-structure, 13) = p-second
      269         put-short(v-system-time-structure, 15) = p-milliseconds
      270       .
      271       run SetSystemTime
      272         (input  get-pointer-value(v-system-time-structure)
      273         ,output v-return-value
      274         ) .
      275       assign
      276         set-size(v-system-time-structure) = 0
      277       .
      278       if v-return-value = 0
      279       then do:
      280         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      281       end.
      282     end.
      283   end procedure.
      284   procedure sys-time_sys-to-mjd :
      285     define input  parameter p-year         as integer   no-undo .
      286     define input  parameter p-month        as integer   no-undo .
      287     define input  parameter p-day          as integer   no-undo .
      288     define input  parameter p-hour         as integer   no-undo .
      289     define input  parameter p-minute       as integer   no-undo .
      290     define input  parameter p-second       as integer   no-undo .
      291     define input  parameter p-milliseconds as integer   no-undo .
      292     define output parameter p-mjd          as decimal   no-undo .
      293     define variable v-year-correction as decimal   no-undo .
      294     define variable v-shift-year as decimal   no-undo .
      295     do
      296     on error undo, return error return-value
      297     :
      298       assign
      299         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      300         v-shift-year      = decimal(p-year) + v-year-correction
      301         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      302               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      303               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      304               + decimal(p-day) - 2432076.0
      305               + p-hour / 24.0
      306               + p-minute / 1440.0
      307               + p-second / 86400.0
      308               + p-milliseconds / 86400000.0
      309       .
      310     end.
      311   end procedure.
      312   procedure sys-time_sys-to-loc :
      313     define input  parameter p-sys-year         as integer   no-undo .
      314     define input  parameter p-sys-month        as integer   no-undo .
      315     define input  parameter p-sys-day          as integer   no-undo .
      316     define input  parameter p-sys-hour         as integer   no-undo .
      317     define input  parameter p-sys-minute       as integer   no-undo .
      318     define input  parameter p-sys-second       as integer   no-undo .
      319     define input  parameter p-sys-milliseconds as integer   no-undo .
      320     define output parameter p-loc-year         as integer   no-undo .
      321     define output parameter p-loc-month        as integer   no-undo .
      322     define output parameter p-loc-day          as integer   no-undo .
      323     define output parameter p-loc-hour         as integer   no-undo .
      324     define output parameter p-loc-minute       as integer   no-undo .
      325     define output parameter p-loc-second       as integer   no-undo .
      326     define output parameter p-loc-milliseconds as integer   no-undo .
      327     define variable v-system-time-structure as memptr    no-undo.
      328     define variable v-return-value          as integer   no-undo .
      329     define variable v-sys-day-of-week       as integer   no-undo .
      330     do
      331     on error undo, return error return-value
      332     :
      333       assign
      334         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      335       .
      336       assign
      337         set-size(v-system-time-structure) = 32
      338       .
      339       assign
      340         put-short(v-system-time-structure,  1) = p-sys-year
      341         put-short(v-system-time-structure,  3) = p-sys-month
      342         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      343         put-short(v-system-time-structure,  7) = p-sys-day
      344         put-short(v-system-time-structure,  9) = p-sys-hour
      345         put-short(v-system-time-structure, 11) = p-sys-minute
      346         put-short(v-system-time-structure, 13) = p-sys-second
      347         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      348       .
      349       run SystemTimeToTzSpecificLocalTime
      350         (input  0
      351         ,input  get-pointer-value(v-system-time-structure)
      352         ,input  get-pointer-value(v-system-time-structure) + 16
      353         ,output v-return-value
      354         ) .
      355       assign
      356         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      357         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      358         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      359         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      360         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      361         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      362         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      363       .
      364       assign
      365         set-size(v-system-time-structure) = 0
      366       .
      367       if v-return-value = 0
      368       then do:
      369         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      370       end.
      371     end.
      372   end procedure.
      373   procedure sys-time_mjd-to-sys :
      374     define input  parameter p-mjd          as decimal   no-undo .
      375     define output parameter p-year         as integer   no-undo .
      376     define output parameter p-month        as integer   no-undo .
      377     define output parameter p-day          as integer   no-undo .
      378     define output parameter p-hour         as integer   no-undo .
      379     define output parameter p-minute       as integer   no-undo .
      380     define output parameter p-second       as integer   no-undo .
      381     define output parameter p-milliseconds as integer   no-undo .
      382     define variable v-year-correction as decimal   no-undo .
      383     define variable v-shift-year      as decimal   no-undo .
      384     define variable v-conv-date     as date      no-undo .
      385     define variable v-int-part      as integer   no-undo .
      386     define variable v-fraction-part as decimal   no-undo .
      387     do
      388     on error undo, return error return-value
      389     :
      390       assign
      391         v-int-part      = integer(truncate(p-mjd, 0))
      392         v-fraction-part = p-mjd - v-int-part
      393         v-conv-date     = date(11, 17, 1858) + v-int-part
      394         p-year          = year(v-conv-date)
      395         p-month         = month(v-conv-date)
      396         p-day           = day(v-conv-date)
      397         v-fraction-part = v-fraction-part * 24.0
      398         p-hour          = integer(truncate(v-fraction-part, 0))
      399         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      400         p-minute        = integer(truncate(v-fraction-part, 0))
      401         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      402         p-second        = integer(truncate(v-fraction-part, 0))
      403         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      404         p-milliseconds  = integer(v-fraction-part)
      405       .
      406     end.
      407   end procedure.
      408   procedure sys-time_mjd-to-loc :
      409     define input  parameter p-mjd              as decimal   no-undo .
      410     define output parameter p-loc-year         as integer   no-undo .
      411     define output parameter p-loc-month        as integer   no-undo .
      412     define output parameter p-loc-day          as integer   no-undo .
      413     define output parameter p-loc-hour         as integer   no-undo .
      414     define output parameter p-loc-minute       as integer   no-undo .
      415     define output parameter p-loc-second       as integer   no-undo .
      416     define output parameter p-loc-milliseconds as integer   no-undo .
      417     define variable v-sys-year         as integer   no-undo .
      418     define variable v-sys-month        as integer   no-undo .
      419     define variable v-sys-day          as integer   no-undo .
      420     define variable v-sys-hour         as integer   no-undo .
      421     define variable v-sys-minute       as integer   no-undo .
      422     define variable v-sys-second       as integer   no-undo .
      423     define variable v-sys-milliseconds as integer   no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427       run sys-time_mjd-to-sys
      428         (input  p-mjd
      429         ,output v-sys-year
      430         ,output v-sys-month
      431         ,output v-sys-day
      432         ,output v-sys-hour
      433         ,output v-sys-minute
      434         ,output v-sys-second
      435         ,output v-sys-milliseconds
      436         ) .
      437       run sys-time_sys-to-loc
      438         (input  v-sys-year
      439         ,input  v-sys-month
      440         ,input  v-sys-day
      441         ,input  v-sys-hour
      442         ,input  v-sys-minute
      443         ,input  v-sys-second
      444         ,input  v-sys-milliseconds
      445         ,output p-loc-year
      446         ,output p-loc-month
      447         ,output p-loc-day
      448         ,output p-loc-hour
      449         ,output p-loc-minute
      450         ,output p-loc-second
      451         ,output p-loc-milliseconds
      452         ) .
      453     end.
      454   end procedure.
      455   function sys-time_get-mjd-func returns decimal
      456   :
      457     define variable v-year         as integer   no-undo .
      458     define variable v-month        as integer   no-undo .
      459     define variable v-day          as integer   no-undo .
      460     define variable v-hour         as integer   no-undo .
      461     define variable v-minute       as integer   no-undo .
      462     define variable v-second       as integer   no-undo .
      463     define variable v-milliseconds as integer   no-undo .
      464     define variable v-mjd          as decimal   no-undo .
      465     run sys-time_get-sys in this-procedure
      466       (output v-year
      467       ,output v-month
      468       ,output v-day
      469       ,output v-hour
      470       ,output v-minute
      471       ,output v-second
      472       ,output v-milliseconds
      473       ) .
      474     run sys-time_sys-to-mjd in this-procedure
      475       (input  v-year
      476       ,input  v-month
      477       ,input  v-day
      478       ,input  v-hour
      479       ,input  v-minute
      480       ,input  v-second
      481       ,input  v-milliseconds
      482       ,output v-mjd
      483       ) .
      484     return v-mjd .
      485   end function .
      486   function sys-time_get-sys-str-func returns character
      487   :
      488     define variable v-utc-time as character no-undo .
      489     define variable v-year         as integer   no-undo .
      490     define variable v-month        as integer   no-undo .
      491     define variable v-day          as integer   no-undo .
      492     define variable v-hour         as integer   no-undo .
      493     define variable v-minute       as integer   no-undo .
      494     define variable v-second       as integer   no-undo .
      495     define variable v-milliseconds as integer   no-undo .
      496     run sys-time_get-sys in this-procedure
      497       (output v-year
      498       ,output v-month
      499       ,output v-day
      500       ,output v-hour
      501       ,output v-minute
      502       ,output v-second
      503       ,output v-milliseconds
      504       ) .
      505     assign
      506       v-utc-time  = 'UTC ':u
      507                   + string(v-year,         '9999':u)
      508                   + '/':u
      509                   + string(v-month,        '99':u)
      510                   + '/':u
      511                   + string(v-day,          '99':u)
      512                   + ' ':u
      513                   + string(v-hour,         '99':u)
      514                   + ':':u
      515                   + string(v-minute,       '99':u)
      516                   + ':':u
      517                   + string(v-second,       '99':u)
      518                   + ' ':u
      519                   + string(v-milliseconds, '999':u)
      520     .
      521     return v-utc-time.
      522   end function .
      523   function sys-time_mjd-to-loc-str-func returns character
      524     (v-sys-mjd as decimal)
      525   :
      526     define variable v-loc-str          as character no-undo .
      527     define variable v-loc-year         as integer   no-undo .
      528     define variable v-loc-month        as integer   no-undo .
      529     define variable v-loc-day          as integer   no-undo .
      530     define variable v-loc-hour         as integer   no-undo .
      531     define variable v-loc-minute       as integer   no-undo .
      532     define variable v-loc-second       as integer   no-undo .
      533     define variable v-loc-milliseconds as integer   no-undo .
      534     run sys-time_mjd-to-loc in this-procedure
      535       (input  v-sys-mjd
      536       ,output v-loc-year
      537       ,output v-loc-month
      538       ,output v-loc-day
      539       ,output v-loc-hour
      540       ,output v-loc-minute
      541       ,output v-loc-second
      542       ,output v-loc-milliseconds
      543       ) .
      544     assign
      545       v-loc-str = substitute('&1/&2/&3 &4:&5'
      546                             ,string(v-loc-day,    '99':U)
      547                             ,string(v-loc-month,  '99':U)
      548                             ,string(v-loc-year,   '9999':U)
      549                             ,string(v-loc-hour,   '99':U)
      550                             ,string(v-loc-minute, '99':U)
      551                             )
      552     .
      553     return v-loc-str .
      554   end function .
