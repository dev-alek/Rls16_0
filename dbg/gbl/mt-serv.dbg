     1072       "$Workfile$"
     1073       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1074       "Интерфейсный элемент" self :name  skip
     1075       "Тип" self :type  skip
     1076       "Процедура" this-procedure :file-name skip
     1077       view-as alert-box .
     1078   end.
     1079   else do:
     1080     apply "entry":u to self  .
     1081     if focus :handle <> self :handle  then do:
     1082       return no-apply .
     1083     end.
     1084   end.
     1085     run proc-b-stop in this-procedure.
     1086   END.
     1087   ON LEAVE OF fi-port IN FRAME DEFAULT-FRAME
     1088   DO:
     1089       assign
     1090           fi-port
     1091       .
     1092       run proc-check-port in this-procedure.
     1093   END.
     1094   ASSIGN CURRENT-WINDOW                = C-Win
     1095          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
     1096   ON CLOSE OF THIS-PROCEDURE
     1097      RUN my-disable.
     1098   PAUSE 0 BEFORE-HIDE.
     1099   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   on F2 of frame DEFAULT-FRAME anywhere do:
     1101     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame DEFAULT-FRAME. END.
     1102     return no-apply.
     1103   end.
     1104   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   on help of frame DEFAULT-FRAME
     1106   do:
     1107     run gbl/app_help.p
     1108       (input this-procedure :file-name
     1109       ,input ''
     1110       ,input ?
     1111       ) no-error.
     1112     if error-status :error then do:
     1113       message
     1114         "Ошибка при вызове помощи"
     1115         error-status :get-message(1)
     1116         view-as alert-box .
     1117     end.
     1118   end.
     1119   run minbtn-set in this-procedure .
     1120   on choose of b-help in frame DEFAULT-FRAME
     1121   do:
     1122     apply "help":u to frame DEFAULT-FRAME .
     1123   end.
     1124   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125   procedure minbtn-set :
     1126       do
     1127           on error undo, return error return-value
     1128           :
     1129           define variable ii              as integer       no-undo .
     1130           define variable fh              as widget-handle no-undo .
     1131           define variable hh              as widget-handle no-undo .
     1132           define variable v-h             as handle        extent 4 no-undo .
     1133           define variable v-name-button   as character     no-undo .
     1134           define variable v-help-old-x    as decimal       no-undo .
     1135           define variable v-help-old-y    as decimal       no-undo .
     1136           define variable v-help-old-size as decimal       no-undo .
     1137           define variable v-frame-width   as decimal       no-undo .
     1138           define variable jj              as integer       no-undo .
     1139           do
     1140               on error undo, return error
     1141               :
     1142               assign
     1143                   v-frame-width = frame DEFAULT-FRAME:width - 0.3
     1144                   fh            = frame DEFAULT-FRAME:first-child
     1145                   hh            = fh:first-child
     1146                   ii            = 1
     1147                   .
     1148               do while valid-handle(hh):
     1149                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1150                   do:
     1151                       case lc(hh:name) :
     1152                           when "b-help" then
     1153                               do:
     1154                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1155                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1156                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1157                                   hh:TOOLTIP = "Помощь" .
     1158                                   v-help-old-x = hh:column .
     1159                                   v-help-old-y = hh:row    .
     1160                                   v-help-old-size = hh:width .
     1161                                   hh:width-chars = 2.5 .
     1162                               end.
     1163                           when "b-print" then
     1164                               do:
     1165                                   hh:load-image("cmp/b-print.bmp":u) .
     1166                                   hh:TOOLTIP = "Печать" .
     1167                                   v-h[ii] = hh:handle .
     1168                                   ii = ii + 1 .
     1169                                   hh:width-chars = 3 .
     1170                               end.
     1171                           when "b-history" or
     1172                           when "b-hist" then
     1173                               do:
     1174                                   hh:load-image("cmp/b-hist.bmp":u) .
     1175                                   hh:TOOLTIP = "История" .
     1176                                   v-h[ii] = hh:handle .
     1177                                   ii = ii + 1 .
     1178                                   hh:width-chars = 3 .
     1179                               end.
     1180                           when "b-sch" then
     1181                               do:
     1182                                   hh:load-image("cmp/b-sch.bmp":u) .
     1183                                   hh:TOOLTIP = "Установка Фильтра" .
     1184                                   v-h[ii] = hh:handle .
     1185                                   ii = ii + 1 .
     1186                                   hh:width-chars = 3 .
     1187                               end.
     1188                           when "b-hist-user" then
     1189                               do:
     1190                                   hh:load-image("cmp/b-hist.bmp":u) .
     1191                                   hh:TOOLTIP = "История пользователя" .
     1192                                   ii = ii + 1 .
     1193                               end.
     1194                       end case.
     1195                   end.
     1196                   hh = hh:next-sibling.
     1197               end.
     1198               b-help:column = v-frame-width - b-help:width-chars.
     1199               jj = 0.
     1200               repeat ii = 4 to 1 by -1 :
     1201                   if valid-handle (v-h[ii] ) then
     1202                   do:
     1203                       jj  = jj + 1 .
     1204                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1205                       v-h[ii]:row    = v-help-old-y .
     1206                   end.
     1207               end.
     1208           end.
     1209       end.
     1210   end procedure.
     1211   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1212   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1213   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1214   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1215   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1216   define variable v-diasize-current-frame-height as decimal   no-undo .
     1217   define variable v-diasize-change-size          as logical   no-undo .
     1218   define variable v-diasize-resize-button        as handle    no-undo .
     1219   define variable v-diasize-wndmax               as logical   no-undo .
     1220   define variable v-diasize-wndstore             as logical   no-undo .
     1221   define variable v-diasize-proc-name            as character no-undo .
     1222   define variable v-diasize-browse-handle        as handle    no-undo .
     1223   define variable v-diasize-browse-number        as integer   no-undo .
     1224   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1225   define temp-table temp-diasize-handle no-undo
     1226     field handle-value  as handle
     1227     field save-position as decimal
     1228     index xpk is primary unique handle-value
     1229     .
     1230   define temp-table temp-browse-handle no-undo
     1231     field browse-type   as character
     1232     field browse-number as integer
     1233     field browse-handle as handle
     1234     field original-size as decimal
     1235     index xpk is primary unique browse-type browse-number
     1236     index xie browse-type browse-handle
     1237   .
     1238   procedure diasize_change-height :
     1239     define input  parameter p-change-value  as decimal   no-undo .
     1240     define input  parameter p-move-resize   as logical   no-undo .
     1241     define variable v-field-group-handle    as handle    no-undo .
     1242     define variable v-object-handle         as handle    no-undo .
     1243     define variable v-frame-height          as decimal   no-undo .
     1244     define variable v-frame-virtual-height  as decimal   no-undo .
     1245     define variable v-browse-height         as decimal   no-undo .
     1246     define variable v-window-height         as decimal   no-undo .
     1247     define variable v-window-virtual-height as decimal   no-undo .
     1248     define variable v-change-sign           as integer   no-undo .
     1249     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1250     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1251     if p-change-value > 0
     1252     then do:
     1253       if frame DEFAULT-FRAME :height + p-change-value
     1254           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1255       then do:
     1256         assign
     1257           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1258                           - (frame DEFAULT-FRAME :height-chars)
     1259         .
     1260         if p-change-value <= 0
     1261         then do:
     1262           run diasize_position-resize-button in this-procedure .
     1263           return .
     1264         end.
     1265       end.
     1266     end.
     1267     if p-change-value < 0
     1268     then do:
     1269       if frame DEFAULT-FRAME :height + p-change-value < v-diasize-orig-frame-height
     1270       then do:
     1271         assign
     1272           p-change-value = v-diasize-orig-frame-height
     1273                          - (frame DEFAULT-FRAME :height-chars)
     1274         .
     1275         if p-change-value >= 0
     1276         then do:
     1277           run diasize_position-resize-button in this-procedure .
     1278           return .
     1279         end.
     1280       end.
     1281     end.
     1282     if p-change-value >= 0
     1283     then do:
     1284       assign
     1285         v-change-sign = 1
     1286       .
     1287     end.
     1288     else do:
     1289       assign
     1290         v-change-sign = -1
     1291       .
     1292     end.
     1293     assign
     1294       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1295     .
     1296     if p-change-value = 0
     1297     then do:
     1298       run diasize_position-resize-button in this-procedure .
     1299       return .
     1300     end.
     1301     move_block:
     1302     do
     1303     on error undo move_block, retry move_block
     1304     :
     1305       if retry
     1306       then do:
     1307         do
     1308         on error undo move_block, leave move_block
     1309         :
     1310           if p-change-value > 0
     1311           then do:
     1312             for each buf_temp-diasize-handle
     1313             on error undo, next
     1314             :
     1315               assign
     1316                 v-object-handle = buf_temp-diasize-handle.handle-value
     1317               .
     1318               if v-object-handle <> v-diasize-resize-button
     1319               then do:
     1320                 assign
     1321                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1322                 .
     1323               end.
     1324             end.
     1325             assign
     1326               v-diasize-browse-handle :height = v-browse-height
     1327             .
     1328             for each buf_temp-browse-handle
     1329               where buf_temp-browse-handle.browse-type = 'height':u
     1330             on error undo, next
     1331             :
     1332               assign
     1333                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1334               .
     1335             end.
     1336             assign
     1337               frame DEFAULT-FRAME :height = v-frame-height
     1338             .
     1339             if frame DEFAULT-FRAME :scrollable = true
     1340             then do:
     1341               assign
     1342                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
     1343               .
     1344             end.
     1345             run diasize_position-resize-button in this-procedure .
     1346           end.
     1347           else do:
     1348             if frame DEFAULT-FRAME :scrollable = true
     1349             then do:
     1350               assign
     1351                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
     1352               .
     1353             end.
     1354             assign
     1355               frame DEFAULT-FRAME :height = v-frame-height
     1356             .
     1357             assign
     1358               v-diasize-browse-handle :height = v-browse-height
     1359             .
     1360             for each buf_temp-browse-handle
     1361               where buf_temp-browse-handle.browse-type = 'height':u
     1362             on error undo, next
     1363             :
     1364               assign
     1365                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1366               .
     1367             end.
     1368             for each buf_temp-diasize-handle
     1369             on error undo, next
     1370             :
     1371               assign
     1372                 v-object-handle = buf_temp-diasize-handle.handle-value
     1373               .
     1374               if v-object-handle <> v-diasize-resize-button
     1375               then do:
     1376                 assign
     1377                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1378                 .
     1379               end.
     1380             end.
     1381             run diasize_position-resize-button in this-procedure .
     1382           end.
     1383           assign
     1384             v-diasize-change-size = false
     1385           .
     1386           leave move_block .
     1387         end.
     1388       end.
     1389       assign
     1390         v-diasize-need-full-display = true
     1391       .
     1392       if v-diasize-change-size = false
     1393       then do:
     1394         assign
     1395           v-diasize-change-size = true
     1396         .
     1397       end.
     1398       else do:
     1399         return .
     1400       end.
     1401       assign
     1402         v-frame-height = frame DEFAULT-FRAME :height
     1403         v-frame-virtual-height = frame DEFAULT-FRAME :virtual-height
     1404         v-browse-height = v-diasize-browse-handle :height
     1405       .
     1406       for each buf_temp-browse-handle
     1407         where buf_temp-browse-handle.browse-type = 'height':u
     1408       :
     1409         assign
     1410           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1411         .
     1412       end.
     1413       for each buf_temp-diasize-handle
     1414       :
     1415         delete buf_temp-diasize-handle .
     1416       end.
     1417       assign
     1418         v-field-group-handle = frame DEFAULT-FRAME :first-child
     1419       .
     1420       do while valid-handle(v-field-group-handle)
     1421       :
     1422         assign
     1423           v-object-handle = v-field-group-handle :first-child
     1424         .
     1425         do while valid-handle(v-object-handle)
     1426         :
     1427           if  v-object-handle <> v-diasize-browse-handle :handle
     1428           and can-query(v-object-handle, "row")
     1429           and can-query(v-object-handle, "height")
     1430           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1431           then do:
     1432             find first buf_temp-browse-handle
     1433               where buf_temp-browse-handle.browse-type   = 'height':u
     1434                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1435               no-error .
     1436             if available buf_temp-browse-handle
     1437             then do:
     1438             end.
     1439             else do:
     1440               create buf_temp-diasize-handle .
     1441               assign
     1442                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1443                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1444               .
     1445             end.
     1446           end.
     1447           assign
     1448             v-object-handle = v-object-handle :next-sibling
     1449           .
     1450         end.
     1451         assign
     1452           v-field-group-handle = v-field-group-handle :next-sibling
     1453         .
     1454       end.
     1455       do with frame DEFAULT-FRAME
     1456       :
     1457         hide v-diasize-resize-button .
     1458         assign
     1459           v-diasize-resize-button :row    = 1
     1460           v-diasize-resize-button :column = 1
     1461         .
     1462       end.
     1463       if p-change-value > 0
     1464       then do:
     1465         if frame DEFAULT-FRAME :scrollable = true
     1466         then do:
     1467           assign
     1468             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     1469             no-error .
     1470           if error-status :error
     1471           or error-status :get-message(1) <> ""
     1472           then do:
     1473             undo move_block, retry move_block .
     1474           end.
     1475         end.
     1476         assign
     1477           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     1478           no-error .
     1479         if error-status :error
     1480         or error-status :get-message(1) <> ""
     1481         then do:
     1482           undo move_block, retry move_block .
     1483         end.
     1484         assign
     1485           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1486           no-error .
     1487         if error-status :error
     1488         or error-status :get-message(1) <> ""
     1489         then do:
     1490           undo move_block, retry move_block .
     1491         end.
     1492         for each buf_temp-browse-handle
     1493           where buf_temp-browse-handle.browse-type = 'height':u
     1494         on error undo move_block, retry move_block
     1495         :
     1496           assign
     1497             buf_temp-browse-handle.browse-handle :height
     1498               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1499             no-error .
     1500           if error-status :error
     1501           or error-status :get-message(1) <> ""
     1502           then do:
     1503             undo move_block, retry move_block .
     1504           end.
     1505         end.
     1506         for each buf_temp-diasize-handle
     1507         on error undo move_block, retry move_block
     1508         :
     1509           assign
     1510             v-object-handle = buf_temp-diasize-handle.handle-value
     1511           .
     1512           if v-object-handle <> v-diasize-resize-button
     1513           then do:
     1514             assign
     1515               v-object-handle :row = v-object-handle :row + p-change-value
     1516               no-error .
     1517             if error-status :error
     1518             or error-status :get-message(1) <> ""
     1519             then do:
     1520               undo move_block, retry move_block .
     1521             end.
     1522           end.
     1523         end.
     1524       end.
     1525       else do:
     1526         for each buf_temp-diasize-handle
     1527         on error undo move_block, retry move_block
     1528         :
     1529           assign
     1530             v-object-handle = buf_temp-diasize-handle.handle-value
     1531           .
     1532           if v-object-handle <> v-diasize-resize-button
     1533           then do:
     1534             assign
     1535               v-object-handle :row = v-object-handle :row + p-change-value
     1536               no-error .
     1537             if error-status :error
     1538             or error-status :get-message(1) <> ""
     1539             then do:
     1540               undo move_block, retry move_block .
     1541             end.
     1542           end.
     1543         end.
     1544         assign
     1545           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1546           no-error .
     1547         if error-status :error
     1548         or error-status :get-message(1) <> ""
     1549         then do:
     1550           undo move_block, retry move_block .
     1551         end.
     1552         for each buf_temp-browse-handle
     1553           where buf_temp-browse-handle.browse-type = 'height':u
     1554         on error undo move_block, retry move_block
     1555         :
     1556           assign
     1557             buf_temp-browse-handle.browse-handle :height
     1558               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1559             no-error .
     1560           if error-status :error
     1561           or error-status :get-message(1) <> ""
     1562           then do:
     1563             undo move_block, retry move_block .
     1564           end.
     1565         end.
     1566         assign
     1567           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     1568           no-error .
     1569         if error-status :error
     1570         or error-status :get-message(1) <> ""
     1571         then do:
     1572           undo move_block, retry move_block .
     1573         end.
     1574         if frame DEFAULT-FRAME :scrollable = true
     1575         then do:
     1576           assign
     1577             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     1578             no-error .
     1579           if error-status :error
     1580           or error-status :get-message(1) <> ""
     1581           then do:
     1582             undo move_block, retry move_block .
     1583           end.
     1584         end.
     1585       end.
     1586       if p-move-resize = true
     1587       then do:
     1588         run diasize_position-resize-button in this-procedure .
     1589       end.
     1590       if v-diasize-wndstore = true
     1591       then do:
     1592         if connected("ub") = true
     1593         then do:
     1594           define variable v-cntxt-db-num        as integer   no-undo .
     1595           define variable v-cntxt-userid        as character no-undo .
     1596           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1597                                             , OUTPUT v-cntxt-userid
     1598                                             ) .
     1599           run gbl/wndsizew.p
     1600             (input  v-cntxt-db-num
     1601             ,input  v-cntxt-userid
     1602             ,input  v-diasize-proc-name
     1603             ,input  'height':u
     1604             ,input  string(frame DEFAULT-FRAME :height - v-diasize-orig-frame-height)
     1605             ) .
     1606         end.
     1607       end.
     1608     end.
     1609     assign
     1610       v-diasize-change-size = false
     1611     .
     1612   end procedure.
     1613   procedure diasize_set-height :
     1614     define input  parameter p-new-height  as decimal   no-undo .
     1615     define input  parameter p-move-resize as logical   no-undo .
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619       run diasize_change-height in this-procedure
     1620         (input  (p-new-height - frame DEFAULT-FRAME :height)
     1621         ,input  p-move-resize
     1622         ) .
     1623     end.
     1624   end procedure.
     1625   procedure diasize_change-width :
     1626     define input  parameter p-change-value as decimal   no-undo .
     1627     define input  parameter p-move-resize  as logical   no-undo .
     1628     define variable v-field-group-handle   as handle    no-undo .
     1629     define variable v-object-handle        as handle    no-undo .
     1630     define variable v-frame-width          as decimal   no-undo .
     1631     define variable v-frame-virtual-width  as decimal   no-undo .
     1632     define variable v-browse-width         as decimal   no-undo .
     1633     define variable v-window-width         as decimal   no-undo .
     1634     define variable v-window-virtual-width as decimal   no-undo .
     1635     define variable v-change-sign          as integer   no-undo .
     1636     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1637     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1638     if p-change-value > 0
     1639     then do:
     1640       if frame DEFAULT-FRAME :width + p-change-value >
     1641           session :width-chars
     1642       then do:
     1643         assign
     1644           p-change-value = session :width-chars - frame DEFAULT-FRAME :width
     1645         .
     1646         if p-change-value <= 0
     1647         then do:
     1648           run diasize_position-resize-button in this-procedure .
     1649           return .
     1650         end.
     1651       end.
     1652     end.
     1653     if p-change-value < 0
     1654     then do:
     1655       if frame DEFAULT-FRAME :width + p-change-value < v-diasize-orig-frame-width
     1656       then do:
     1657         assign
     1658           p-change-value = v-diasize-orig-frame-width
     1659                          - frame DEFAULT-FRAME :width
     1660         .
     1661         if p-change-value >= 0
     1662         then do:
     1663           run diasize_position-resize-button in this-procedure .
     1664           return .
     1665         end.
     1666       end.
     1667     end.
     1668     if p-change-value >= 0
     1669     then do:
     1670       assign
     1671         v-change-sign = 1
     1672       .
     1673     end.
     1674     else do:
     1675       assign
     1676         v-change-sign = -1
     1677       .
     1678     end.
     1679     assign
     1680       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1681     .
     1682     if p-change-value = 0
     1683     then do:
     1684       run diasize_position-resize-button in this-procedure .
     1685       return .
     1686     end.
     1687     move_block:
     1688     do
     1689     on error undo move_block, leave move_block
     1690     :
     1691       if retry
     1692       then do:
     1693         do
     1694         on error undo move_block, leave move_block
     1695         :
     1696           if p-change-value > 0
     1697           then do:
     1698             for each buf_temp-diasize-handle
     1699             on error undo, next
     1700             :
     1701               assign
     1702                 v-object-handle = buf_temp-diasize-handle.handle-value
     1703               .
     1704               if v-object-handle <> v-diasize-resize-button
     1705               then do:
     1706                 assign
     1707                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1708                 .
     1709               end.
     1710             end.
     1711             assign
     1712               v-diasize-browse-handle :width = v-browse-width
     1713             .
     1714             for each buf_temp-browse-handle
     1715               where buf_temp-browse-handle.browse-type = 'width':u
     1716             on error undo, next
     1717             :
     1718               assign
     1719                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1720               .
     1721             end.
     1722             assign
     1723               frame DEFAULT-FRAME :width = v-frame-width
     1724             .
     1725             if frame DEFAULT-FRAME :scrollable = true
     1726             then do:
     1727               assign
     1728                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     1729               .
     1730             end.
     1731             run diasize_position-resize-button in this-procedure .
     1732           end.
     1733           else do:
     1734             if frame DEFAULT-FRAME :scrollable = true
     1735             then do:
     1736               assign
     1737                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     1738               .
     1739             end.
     1740             assign
     1741               frame DEFAULT-FRAME :width = v-frame-width
     1742             .
     1743             for each buf_temp-browse-handle
     1744               where buf_temp-browse-handle.browse-type = 'width':u
     1745             on error undo, next
     1746             :
     1747               assign
     1748                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1749               .
     1750             end.
     1751             assign
     1752               v-diasize-browse-handle :width = v-browse-width
     1753             .
     1754             for each buf_temp-diasize-handle
     1755             on error undo, next
     1756             :
     1757               assign
     1758                 v-object-handle = buf_temp-diasize-handle.handle-value
     1759               .
     1760               if v-object-handle <> v-diasize-resize-button
     1761               then do:
     1762                 assign
     1763                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1764                 .
     1765               end.
     1766             end.
     1767             run diasize_position-resize-button in this-procedure .
     1768           end.
     1769           assign
     1770             v-diasize-change-size = false
     1771           .
     1772           leave move_block .
     1773         end.
     1774       end.
     1775       assign
     1776         v-diasize-need-full-display = true
     1777       .
     1778       if v-diasize-change-size = false
     1779       then do:
     1780         assign
     1781           v-diasize-change-size = true
     1782         .
     1783       end.
     1784       else do:
     1785         return .
     1786       end.
     1787       assign
     1788         v-frame-width = frame DEFAULT-FRAME :width
     1789         v-frame-virtual-width = frame DEFAULT-FRAME :virtual-width
     1790         v-browse-width = v-diasize-browse-handle :width
     1791       .
     1792       for each buf_temp-browse-handle
     1793         where buf_temp-browse-handle.browse-type = 'width':u
     1794       :
     1795         assign
     1796           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1797         .
     1798       end.
     1799       for each buf_temp-diasize-handle
     1800       :
     1801         delete buf_temp-diasize-handle .
     1802       end.
     1803       assign
     1804         v-field-group-handle = frame DEFAULT-FRAME :first-child
     1805       .
     1806       do while valid-handle(v-field-group-handle)
     1807       :
     1808         assign
     1809           v-object-handle = v-field-group-handle :first-child
     1810         .
     1811         do while valid-handle(v-object-handle)
     1812         :
     1813           if  v-object-handle <> v-diasize-browse-handle :handle
     1814           and v-object-handle <> v-diasize-resize-button
     1815           and can-query(v-object-handle, "row")
     1816           and can-query(v-object-handle, "height")
     1817           and ( v-object-handle :col + v-object-handle :width
     1818                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1819               )
     1820           then do:
     1821             find first buf_temp-browse-handle
     1822               where buf_temp-browse-handle.browse-type   = 'width':u
     1823                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1824               no-error .
     1825             if available buf_temp-browse-handle
     1826             then do:
     1827             end.
     1828             else do:
     1829               create buf_temp-diasize-handle .
     1830               assign
     1831                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1832                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1833               .
     1834             end.
     1835           end.
     1836           assign
     1837             v-object-handle = v-object-handle :next-sibling
     1838           .
     1839         end.
     1840         assign
     1841           v-field-group-handle = v-field-group-handle :next-sibling
     1842         .
     1843       end.
     1844       do with frame DEFAULT-FRAME
     1845       :
     1846         hide v-diasize-resize-button .
     1847         v-diasize-resize-button :row = 1.
     1848         v-diasize-resize-button :column = 1.
     1849       end.
     1850       if p-change-value > 0
     1851       then do:
     1852         if frame DEFAULT-FRAME :scrollable = true
     1853         then do:
     1854           assign
     1855             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     1856             no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block.
     1861           end.
     1862         end.
     1863         assign
     1864           frame DEFAULT-FRAME :width = v-frame-width + p-change-value
     1865           no-error .
     1866         if error-status :error
     1867         or error-status :get-message(1) <> ""
     1868         then do:
     1869           undo move_block, retry move_block.
     1870         end.
     1871         assign
     1872           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1873         no-error .
     1874         if error-status :error
     1875         or error-status :get-message(1) <> ""
     1876         then do:
     1877           undo move_block, retry move_block.
     1878         end.
     1879         for each buf_temp-browse-handle
     1880           where buf_temp-browse-handle.browse-type = 'width':u
     1881         on error undo move_block, retry move_block
     1882         :
     1883           assign
     1884             buf_temp-browse-handle.browse-handle :width
     1885               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1886             no-error .
     1887           if error-status :error
     1888           or error-status :get-message(1) <> ""
     1889           then do:
     1890             undo move_block, retry move_block .
     1891           end.
     1892         end.
     1893         for each buf_temp-diasize-handle
     1894         on error undo move_block, retry move_block
     1895         :
     1896           assign
     1897             v-object-handle = buf_temp-diasize-handle.handle-value
     1898           .
     1899           if v-object-handle <> v-diasize-resize-button
     1900           then do:
     1901             assign
     1902               v-object-handle :col = v-object-handle :col + p-change-value
     1903               no-error .
     1904             if error-status :error
     1905             or error-status :get-message(1) <> ""
     1906             then do:
     1907               undo move_block, retry move_block .
     1908             end.
     1909           end.
     1910         end.
     1911       end.
     1912       else do:
     1913         for each buf_temp-diasize-handle
     1914         on error undo move_block, retry move_block
     1915         :
     1916           assign
     1917             v-object-handle = buf_temp-diasize-handle.handle-value
     1918           .
     1919           if v-object-handle <> v-diasize-resize-button
     1920           then do:
     1921             assign
     1922               v-object-handle :col = v-object-handle :col + p-change-value
     1923               no-error .
     1924             if error-status :error
     1925             or error-status :get-message(1) <> ""
     1926             then do:
     1927               undo move_block, retry move_block .
     1928             end.
     1929           end.
     1930         end.
     1931         for each buf_temp-browse-handle
     1932           where buf_temp-browse-handle.browse-type = 'width':u
     1933         on error undo move_block, retry move_block
     1934         :
     1935           assign
     1936             buf_temp-browse-handle.browse-handle :width
     1937               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1938             no-error .
     1939           if error-status :error
     1940           or error-status :get-message(1) <> ""
     1941           then do:
     1942             undo move_block, retry move_block .
     1943           end.
     1944         end.
     1945         assign
     1946           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1947           no-error .
     1948         if error-status :error
     1949         or error-status :get-message(1) <> ""
     1950         then do:
     1951           undo move_block, retry move_block.
     1952         end.
     1953         assign
     1954           frame DEFAULT-FRAME :width = frame DEFAULT-FRAME :width + p-change-value
     1955         no-error .
     1956         if error-status :error
     1957         or error-status :get-message(1) <> ""
     1958         then do:
     1959           undo move_block, retry move_block.
     1960         end.
     1961         if frame DEFAULT-FRAME :scrollable = true
     1962         then do:
     1963           assign
     1964             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     1965           no-error .
     1966           if error-status :error
     1967           or error-status :get-message(1) <> ""
     1968           then do:
     1969             undo move_block, retry move_block.
     1970           end.
     1971         end.
     1972       end.
     1973       if p-move-resize
     1974       then do:
     1975         run diasize_position-resize-button in this-procedure .
     1976       end.
     1977       if v-diasize-wndstore = true
     1978       then do:
     1979         if connected("ub") = true
     1980         then do:
     1981           define variable v-cntxt-db-num        as integer   no-undo .
     1982           define variable v-cntxt-userid        as character no-undo .
     1983           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1984                                             , OUTPUT v-cntxt-userid
     1985                                             ) .
     1986           run gbl/wndsizew.p
     1987             (input  v-cntxt-db-num
     1988             ,input  v-cntxt-userid
     1989             ,input  v-diasize-proc-name
     1990             ,input  'width':u
     1991             ,input  string(frame DEFAULT-FRAME :width - v-diasize-orig-frame-width)
     1992             ) .
     1993         end.
     1994       end.
     1995     end.
     1996     assign
     1997       v-diasize-change-size = false
     1998     .
     1999   end procedure.
     2000   procedure diasize_set-width :
     2001     define input  parameter p-new-width  as decimal   no-undo .
     2002     define input  parameter p-move-resize as logical   no-undo .
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       run diasize_change-width in this-procedure
     2007         (input  (p-new-width - frame DEFAULT-FRAME :width)
     2008         ,input  p-move-resize
     2009         ) .
     2010     end.
     2011   end procedure.
     2012   procedure diasize_position-resize-button :
     2013     do with frame DEFAULT-FRAME
     2014     :
     2015       hide v-diasize-resize-button .
     2016       assign
     2017         v-diasize-resize-button :row = frame DEFAULT-FRAME :height - v-diasize-resize-button :height
     2018                     - 1
     2019                     - (frame DEFAULT-FRAME :border-bottom-pixels / session :pixels-per-row)
     2020         v-diasize-resize-button :col = frame DEFAULT-FRAME :width - v-diasize-resize-button :width
     2021                     - 1
     2022                     - (frame DEFAULT-FRAME :border-right-pixels / session :pixels-per-column)
     2023       .
     2024       view v-diasize-resize-button .
     2025     end.
     2026   end procedure.
     2027   on alt-right anywhere
     2028   do:
     2029     run diasize_change-width in this-procedure
     2030       (input 1
     2031       ,input true
     2032       ) .
     2033     return no-apply .
     2034   end.
     2035   on alt-left anywhere
     2036   do:
     2037     run diasize_change-width in this-procedure
     2038       (input -1
     2039       ,input true
     2040       ) .
     2041     return no-apply .
     2042   end.
     2043   on alt-down anywhere
     2044   do:
     2045     run diasize_change-height in this-procedure
     2046       (input 1
     2047       ,input true
     2048       ) .
     2049     return no-apply .
     2050   end.
     2051   on alt-up anywhere
     2052   do:
     2053     run diasize_change-height in this-procedure
     2054       (input -1
     2055       ,input true
     2056       ) .
     2057     return no-apply .
     2058   end.
     2059   on alt-enter of frame DEFAULT-FRAME
     2060   do:
     2061     run diasize_maximize in this-procedure
     2062       (input  ?
     2063       ).
     2064     return no-apply .
     2065   end.
     2066   procedure diasize_end-move :
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       define variable v-row-delta as decimal   no-undo .
     2071       define variable v-col-delta as decimal   no-undo .
     2072       define variable v-new-row as decimal   no-undo .
     2073       define variable v-new-col as decimal   no-undo .
     2074       assign
     2075         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2076         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2077       .
     2078       assign
     2079         v-row-delta = v-new-row - frame DEFAULT-FRAME :height
     2080         v-col-delta = v-new-col - frame DEFAULT-FRAME :width
     2081       .
     2082       run diasize_change-height in this-procedure
     2083         (input v-row-delta
     2084         ,input true
     2085         ) .
     2086       run diasize_change-width in this-procedure
     2087         (input v-col-delta
     2088         ,input true
     2089         ) .
     2090     end.
     2091   end procedure.
     2092   procedure diasize_maximize :
     2093     define input  parameter p-action as logical   no-undo .
     2094     do
     2095     on error undo, return error return-value
     2096     :
     2097       if p-action = ?
     2098       then do:
     2099         if v-diasize-need-maximize = true
     2100         then do:
     2101           assign
     2102             p-action = true
     2103           .
     2104         end.
     2105         else do:
     2106           assign
     2107             p-action = false
     2108           .
     2109         end.
     2110       end.
     2111       if p-action = true
     2112       then do:
     2113         run diasize_change-height in this-procedure
     2114           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2115               - frame DEFAULT-FRAME :height-chars
     2116           ,input true
     2117           ) .
     2118         run diasize_change-width in this-procedure
     2119           (input session :width-chars
     2120               - frame DEFAULT-FRAME :width-chars
     2121           ,input true
     2122           ) .
     2123         assign
     2124           v-diasize-need-maximize = false
     2125         .
     2126       end.
     2127       else do:
     2128         run diasize_change-width in this-procedure
     2129           (input v-diasize-orig-frame-width
     2130               - frame DEFAULT-FRAME :width-chars
     2131           ,input true
     2132           ) .
     2133         run diasize_change-height in this-procedure
     2134           (input v-diasize-orig-frame-height
     2135               - frame DEFAULT-FRAME :height-chars
     2136           ,input true
     2137           ) .
     2138         assign
     2139           v-diasize-need-maximize = true
     2140         .
     2141       end.
     2142     end.
     2143   end procedure.
     2144   procedure diasize_restore-orig-size :
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       assign
     2149         v-diasize-current-frame-width  = frame DEFAULT-FRAME :width
     2150         v-diasize-current-frame-height = frame DEFAULT-FRAME :height
     2151       .
     2152       run diasize_set-height in this-procedure
     2153         (input  v-diasize-orig-frame-height
     2154         ,input  true
     2155         ) .
     2156       run diasize_set-width in this-procedure
     2157         (input  v-diasize-orig-frame-width
     2158         ,input  true
     2159         ) .
     2160     end.
     2161   end procedure.
     2162   procedure diasize_restore-current-size :
     2163     do
     2164     on error undo, return error return-value
     2165     :
     2166       run diasize_set-height in this-procedure
     2167         (input  v-diasize-current-frame-height
     2168         ,input  true
     2169         ) .
     2170       run diasize_set-width in this-procedure
     2171         (input  v-diasize-current-frame-width
     2172         ,input  true
     2173         ) .
     2174     end.
     2175   end procedure.
     2176   procedure diasize_set-browse-handle :
     2177     define input  parameter p-browse-handle as handle   no-undo .
     2178     define buffer buf_temp-browse-handle for temp-browse-handle .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       assign
     2183         v-diasize-browse-handle = p-browse-handle
     2184       .
     2185       for each buf_temp-browse-handle
     2186       on error undo, return error return-value
     2187       :
     2188         delete buf_temp-browse-handle .
     2189       end.
     2190     end.
     2191   end procedure.
     2192   procedure diasize_add_browse :
     2193     define input  parameter p-browse-type   as character no-undo .
     2194     define input  parameter p-browse-handle as handle    no-undo .
     2195     define buffer buf_temp-browse-handle for temp-browse-handle .
     2196     do
     2197     on error undo, return error return-value
     2198     :
     2199       assign
     2200         v-diasize-browse-number = v-diasize-browse-number + 1
     2201       .
     2202       create buf_temp-browse-handle .
     2203       assign
     2204         buf_temp-browse-handle.browse-type   = p-browse-type
     2205         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2206         buf_temp-browse-handle.browse-handle = p-browse-handle
     2207       .
     2208     end.
     2209   end procedure.
     2210   procedure diasize_init :
     2211     define variable v-default-value    as logical   no-undo .
     2212     define variable v-restore-saved    as logical   no-undo .
     2213     define variable v-resize-value-str as character no-undo .
     2214     do
     2215     on error undo, return error return-value
     2216     :
     2217       do with frame DEFAULT-FRAME
     2218       :
     2219         assign
     2220           v-diasize-orig-frame-height = frame DEFAULT-FRAME :height
     2221           v-diasize-orig-frame-width  = frame DEFAULT-FRAME :width
     2222           v-diasize-browse-handle     = browse br-log :handle
     2223         .
     2224         create button v-diasize-resize-button
     2225         assign
     2226           parent        = frame DEFAULT-FRAME :first-child
     2227           label         = "s"
     2228           height-pixels = 16
     2229           width-pixels  = 16
     2230           visible       = true
     2231           sensitive     = true
     2232           movable       = true
     2233           triggers:
     2234             on end-move persistent run diasize_end-move in this-procedure .
     2235           end triggers.
     2236         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2237         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2238         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2239         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2240         assign
     2241           v-diasize-wndmax = false
     2242         .
     2243         if connected("ub") = true
     2244         then do:
     2245           define variable v-cntxt-db-num        as integer   no-undo .
     2246           define variable v-cntxt-userid        as character no-undo .
     2247           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2248                                             , OUTPUT v-cntxt-userid
     2249                                             ) .
     2250           run gbl/wndpar_r.p
     2251             (input  v-cntxt-db-num
     2252             ,input  v-cntxt-userid
     2253             ,input  'wndmax':U
     2254             ,output v-diasize-wndmax
     2255             ,output v-default-value
     2256             ) .
     2257         end.
     2258         assign
     2259           v-diasize-wndstore = false
     2260         .
     2261         if connected("ub") = true
     2262         then do:
     2263           run gbl/wndpar_r.p
     2264             (input  v-cntxt-db-num
     2265             ,input  v-cntxt-userid
     2266             ,input  'wndstore':U
     2267             ,output v-diasize-wndstore
     2268             ,output v-default-value
     2269             ) .
     2270         end.
     2271         assign
     2272           v-diasize-proc-name = entry(1, program-name(2), '.')
     2273         .
     2274         if v-diasize-wndstore = true
     2275         then do:
     2276           assign
     2277             v-restore-saved = false
     2278           .
     2279           if connected("ub") = true
     2280           then do:
     2281             run gbl/wndsizer.p
     2282               (input  v-cntxt-db-num
     2283               ,input  v-cntxt-userid
     2284               ,input  v-diasize-proc-name
     2285               ,input  'height':u
     2286               ,output v-resize-value-str
     2287               ) .
     2288             if v-resize-value-str <> '':U
     2289             then do:
     2290               run diasize_change-height in this-procedure
     2291                 (input  integer(v-resize-value-str)
     2292                 ,input  true
     2293                 ) .
     2294               assign
     2295                 v-restore-saved = true
     2296               .
     2297             end.
     2298           end.
     2299           if connected("ub") = true
     2300           then do:
     2301             run gbl/wndsizer.p
     2302               (input  v-cntxt-db-num
     2303               ,input  v-cntxt-userid
     2304               ,input  v-diasize-proc-name
     2305               ,input  'width':u
     2306               ,output v-resize-value-str
     2307               ) .
     2308             if v-resize-value-str <> '':U
     2309             then do:
     2310               run diasize_change-width in this-procedure
     2311                 (input  integer(v-resize-value-str)
     2312                 ,input  true
     2313                 ) .
     2314               assign
     2315                 v-restore-saved = true
     2316               .
     2317             end.
     2318           end.
     2319           if v-restore-saved <> true
     2320           then do:
     2321             if v-diasize-wndmax = true
     2322             then do:
     2323               run diasize_maximize in this-procedure
     2324                 (input  true
     2325                 ) .
     2326             end.
     2327           end.
     2328         end.
     2329         else do:
     2330           if v-diasize-wndmax = true
     2331           then do:
     2332             run diasize_maximize in this-procedure
     2333               (input  true
     2334               ) .
     2335           end.
     2336         end.
     2337       end.
     2338     end.
     2339   end procedure.
     2340   procedure diasize_need-full-display :
     2341     define output parameter p-need-full-display as logical   no-undo .
     2342     do
     2343     on error undo, return error return-value
     2344     :
     2345       assign
     2346         p-need-full-display = v-diasize-need-full-display
     2347       .
     2348       assign
     2349         v-diasize-need-full-display = false
     2350       .
     2351     end.
     2352   end procedure.
     2353   procedure get-context :
     2354      define output parameter p-db-num as integer          no-undo.
     2355      define output parameter p-user-id as character        no-undo.
     2356      define variable v-login               as character    no-undo.
     2357      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2358      define buffer buf_user-login  for ub.user-login .
     2359      do
     2360      on error undo, return error
     2361      :
     2362            FIND FIRST buf_sys-ctrl no-lock.
     2363            ASSIGN
     2364               v-login = USERID("ub")
     2365               p-db-num = buf_sys-ctrl.db-num
     2366            .
     2367            FIND FIRST buf_user-login
     2368                 WHERE buf_user-login.db-num = p-db-num
     2369                   AND buf_user-login.user-login = v-login
     2370                 no-lock
     2371                 no-error
     2372                 .
     2373            IF AVAILABLE buf_user-login
     2374            THEN DO:
     2375               assign
     2376                  p-user-id = buf_user-login.user-id
     2377               .
     2378            END.
     2379      end.
     2380   end procedure.
     2381       run diasize_init in this-procedure .
     2382   MAIN-BLOCK:
     2383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2385     find first buf_sys-ctrl no-lock .
     2386     find buf_user-login no-lock
     2387       where buf_user-login.db-num     = buf_sys-ctrl.db-num
     2388         and buf_user-login.status_    = 0
     2389         and buf_user-login.user-login = p-user-login
     2390       no-error .
     2391     if not available buf_user-login
     2392     then do:
     2393       message
     2394         "Не найден пользователь" skip
     2395         p-user-login skip
     2396         view-as alert-box error .
     2397       undo, return error return-value .
     2398     end.
     2399     find first buf_cash-desk no-lock
     2400       where buf_cash-desk.db-num    = buf_sys-ctrl.db-num
     2401         and buf_cash-desk.pos-type  = 'IBS-TH-MOB':U
     2402         and buf_cash-desk.cash-num  = p-pos-num
     2403     no-error.
     2404     if not available buf_cash-desk
     2405     then do:
     2406       message
     2407         substitute( "В БД &1 не найдена база типа &2 с кодом &3"
     2408                   , buf_sys-ctrl.db-num
     2409                   , 'IBS-TH-MOB':U
     2410                   , p-pos-num
     2411                   )
     2412       view-as alert-box error.
     2413       undo, return error return-value .
     2414     end.
     2415     run gbl/set-gbl.p
     2416       (input true
     2417       ,input buf_user-login.user-id
     2418       ,input p-user-password
     2419       ) .
     2420     define variable v-rtexch-chr               as character no-undo .
     2421     define variable v-rtexch-type              as character no-undo .
     2422     define variable v-rtusrnum-chr             as character no-undo .
     2423     define variable v-rtusrnum-type            as character no-undo .
     2424     define variable v-rtexpdt-chr              as character no-undo .
     2425     define variable v-rtexpdt-type             as character no-undo .
     2426     define variable v-rtusrnum                 as integer   no-undo .
     2427     define variable v-rtexpdt                  as date      no-undo .
     2428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2429     (input  'rtexch':u
     2430     ,input  0
     2431     ,input  ''
     2432     ,input  0
     2433     ,input  ''
     2434     ,input  ''
     2435     ,input  ''
     2436     ,input  no
     2437     ,output v-rtexch-chr
     2438     ,output v-rtexch-type
     2439     ) no-error .
     2440     if error-status :error
     2441     or v-rtexch-chr <> "yes"
     2442     then do:
     2443       message
     2444         "Отсутствуют права для работы с радиотерминалом" skip
     2445         "Параметр rtexch" skip
     2446         view-as alert-box error .
     2447       undo, return error return-value .
     2448     end.
     2449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2450     (input  'rtusrnum':u
     2451     ,input  0
     2452     ,input  ''
     2453     ,input  0
     2454     ,input  ''
     2455     ,input  ''
     2456     ,input  ''
     2457     ,input  no
     2458     ,output v-rtusrnum-chr
     2459     ,output v-rtusrnum-type
     2460     ) no-error .
     2461     if error-status :error
     2462     then do:
     2463       message
     2464         "Не задано количество пользователей для работы с радиотерминалом" skip
     2465         "Параметр rtusrnum" skip
     2466         view-as alert-box error .
     2467       undo, return error return-value .
     2468     end.
     2469     assign
     2470       v-cfg-max-user-num = integer(v-rtusrnum-chr) no-error
     2471     .
     2472   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2473     (input  'rtexpdt':u
     2474     ,input  0
     2475     ,input  ''
     2476     ,input  0
     2477     ,input  ''
     2478     ,input  ''
     2479     ,input  ''
     2480     ,input  no
     2481     ,output v-rtexpdt-chr
     2482     ,output v-rtexpdt-type
     2483     ) no-error .
     2484     if error-status :error
     2485     then do:
     2486       message
     2487         "Не задан срок окончания лицензии для работы с радиотерминалом" skip
     2488         "Параметр rtexpdt" skip
     2489         view-as alert-box error .
     2490       undo, return error return-value .
     2491     end.
     2492     assign
     2493       v-rtexpdt = date(v-rtexpdt-chr) no-error
     2494     .
     2495     if v-rtexpdt = ?
     2496     then do:
     2497       message
     2498         "Не задан срок окончания лицензии для работы с радиотерминалом" skip
     2499         "Параметр rtexpdt" skip
     2500         view-as alert-box error .
     2501       undo, return error return-value .
     2502     end.
     2503     assign
     2504       session :time-source = 'ub':U
     2505     .
     2506     if today > v-rtexpdt
     2507     then do:
     2508       message
     2509         "Истек срок действия лицензии для работы с радиотерминалом" skip
     2510         "Сегодня" today skip
     2511         "Срок окончания лицензии" v-rtexpdt skip
     2512         "Параметр rtexpdt" skip
     2513         view-as alert-box error .
     2514       undo, return error return-value .
     2515     end.
     2516     if v-rtexpdt - today < 15
     2517     then do:
     2518       message
     2519         substitute("ВНИМАНИЕ!!! До окончания лиценизии осталось &1 дней", v-rtexpdt - today)
     2520       view-as alert-box information.
     2521     end.
     2522     define buffer rtexch-lock_batchprocess for ub.batchprocess .
     2523     run gbl/lock-prc.p
     2524       (input 'mtex':U
     2525       ,input p-pos-num
     2526       ,input 0
     2527       ,input 0
     2528       ,input 'IBS-TH-MOB':U
     2529       ,input ""
     2530       ,input ""
     2531       ,input ",,,,,,Обработка запросов радиотерминала"
     2532       ,input true
     2533       ,buffer rtexch-lock_batchprocess
     2534       ) no-error .
     2535     if error-status :error
     2536     then do:
     2537       message
     2538         vss-workfile vss-revision vss-description skip
     2539         substitute( "Сервер обработки запросов радиотерминала уже запущен для кассы &1"
     2540                   , p-pos-num
     2541                   ) skip
     2542         error-status :get-message(1) skip
     2543         return-value skip
     2544         view-as alert-box error .
     2545       return .
     2546     end.
     2547     RUN my-enable.
     2548     IF NOT THIS-PROCEDURE:PERSISTENT THEN
     2549       WAIT-FOR CLOSE OF THIS-PROCEDURE.
     2550   END.
     2551   PROCEDURE check-crc32 :
     2552     define input  parameter p-mem   as memptr   no-undo .
     2553     define input  parameter p-len   as integer  no-undo .
     2554     define output parameter p-crc32 as int64    no-undo .
     2555     define variable v-message as memptr no-undo.
     2556     set-size(v-message) = p-len .
     2557     set-pointer-value(v-message) = get-pointer-value(p-mem).
     2558     run crc32 ( input 0 , input v-message , input p-len , output p-crc32).
     2559     set-size(v-message) = 0 .
     2560   END PROCEDURE.
     2561   PROCEDURE conproc :
     2562   define input param clienthandle as handle.
     2563   do
     2564   on error undo, return error return-value
     2565   :
     2566     define variable v-log as logical   no-undo .
     2567     assign
     2568       v-log = clienthandle :set-read-response-procedure("readproc").
     2569     .
     2570     if v-log <> yes then do:
     2571     end.
     2572     clienthandle :set-socket-option( "SO-LINGER" , "FALSE" ).
     2573     clienthandle :set-socket-option( "TCP-NODELAY" , "TRUE" ).
     2574     find first tt-cli-socket no-lock
     2575       where tt-cli-socket.sock-handle = clienthandle
     2576     no-error .
     2577     if not available tt-cli-socket
     2578     then do:
     2579       create tt-cli-socket.
     2580       assign
     2581         tt-cli-socket.sock-handle = clienthandle
     2582       .
     2583     end.
     2584     assign
     2585       tt-cli-socket.remote-host     = clienthandle :remote-host
     2586       tt-cli-socket.remote-port     = clienthandle :remote-port
     2587       tt-cli-socket.conn-time       = time
     2588       tt-cli-socket.last-conn-time  = tt-cli-socket.conn-time
     2589     .
     2590     run write-log in this-procedure ( substitute( "Установлено соединение. Удаленный хост: &1 , удаленный порт: &2"
     2591                                                 , tt-cli-socket.remote-host
     2592                                                 , tt-cli-socket.remote-port
     2593                                                 )
     2594                                     ) .
     2595   end.
     2596   END PROCEDURE.
     2597   PROCEDURE disable_UI :
     2598     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     2599     THEN DELETE WIDGET C-Win.
     2600     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2601   END PROCEDURE.
     2602   PROCEDURE empty-tt-cli-socket :
     2603   do
     2604   on error undo, return error return-value
     2605   :
     2606     empty temp-table tt-cli-socket .
     2607   end.
     2608   END PROCEDURE.
     2609   PROCEDURE enable_UI :
     2610     DISPLAY fi-port fi-pos-num fi-pos-type fi-users fi-last-conn-time
     2611         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     2612     ENABLE b-exit b-start b-help r-semaphore fi-port br-log fi-pos-num
     2613            fi-pos-type fi-users fi-last-conn-time
     2614         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     2615     OPEN QUERY br-log FOR EACH tt-log.
     2616     VIEW C-Win.
     2617   END PROCEDURE.
     2618   PROCEDURE mt-serv_get-pos-num :
     2619     define output parameter p-cash-desk-num as integer   no-undo .
     2620   do
     2621   on error undo, return error return-value
     2622   :
     2623     assign
     2624       p-cash-desk-num = p-pos-num
     2625     .
     2626   end.
     2627   END PROCEDURE.
     2628   PROCEDURE mt-serv_write-error-message :
     2629     define input  parameter p-message     as character no-undo .
     2630     define output parameter p-xml-message as character no-undo .
     2631   do
     2632   on error undo, return error return-value
     2633   :
     2634     assign
     2635       p-xml-message = substitute( '<?xml version="1.0"?><msg><stts>1</stts><errmsg>&1</errmsg></msg>'
     2636                                 , p-message
     2637                                 )
     2638     .
     2639   end.
     2640   END PROCEDURE.
     2641   PROCEDURE mt-serv_write-last-conn-time :
     2642     define input  parameter p-string as character no-undo .
     2643   do
     2644   on error undo, return error return-value
     2645   :
     2646     assign
     2647       fi-last-conn-time = p-string
     2648     .
     2649     display
     2650       fi-last-conn-time
     2651     with frame DEFAULT-FRAME.
     2652   end.
     2653   END PROCEDURE.
     2654   PROCEDURE mt-serv_write-user-num :
     2655     define input  parameter p-user-num as integer   no-undo .
     2656   do
     2657   on error undo, return error return-value
     2658   :
     2659     run mt-serv_write-user-str in this-procedure ( substitute( "&1 из &2 работает"
     2660                                                              , p-user-num
     2661                                                              , v-cfg-max-user-num
     2662                                                              )
     2663                                                  ) .
     2664   end.
     2665   END PROCEDURE.
     2666   PROCEDURE mt-serv_write-user-str :
     2667     define input  parameter p-users as character no-undo .
     2668   do
     2669   on error undo, return error return-value
     2670   :
     2671     assign
     2672       fi-users = p-users
     2673     .
     2674     display
     2675       fi-users
     2676     with frame DEFAULT-FRAME.
     2677   end.
     2678   END PROCEDURE.
     2679   PROCEDURE my-disable :
     2680     run stop-server in this-procedure .
     2681     run disable_UI in this-procedure .
     2682   END PROCEDURE.
     2683   PROCEDURE my-enable :
     2684     assign
     2685       fi-port            = p-port
     2686       fi-pos-num         = p-pos-num
     2687       fi-pos-type        = 'IBS-TH-MOB':U
     2688       v-cfg-timeout      = 1000
     2689     .
     2690     display
     2691       fi-port
     2692       fi-pos-num
     2693       fi-pos-type
     2694     with frame DEFAULT-FRAME in window C-Win.
     2695     enable
     2696       b-exit
     2697       b-start
     2698       b-help
     2699       b-prop
     2700       fi-port
     2701       fi-last-conn-time
     2702       fi-users
     2703       br-log
     2704     with frame DEFAULT-FRAME in window C-Win.
     2705     view C-Win.
     2706     run mt-serv_write-user-num in this-procedure ( input 0 ) .
     2707   END PROCEDURE.
     2708   PROCEDURE proc-b-exit :
     2709     define variable v-answer  as logical   no-undo .
     2710     run gbl/q-wait.w ( input substitute( "Вы хотите завершить работу ?" )
     2711                      , input false
     2712                      , input 5
     2713                      , output v-answer
     2714                      ) .
     2715     if v-answer = true
     2716     then do:
     2717       find first tt-log no-error .
     2718       if available tt-log
     2719       then do:
     2720         run gbl/q-wait.w ( input substitute( "Сохранить лог перед выходом ?" )
     2721                          , input true
     2722                          , input 5
     2723                          , output v-answer
     2724                          ) .
     2725         if v-answer = true
     2726         then do:
     2727           run save-log in this-procedure .
     2728         end.
     2729       end.
     2730       empty temp-table tt-cli-socket.
     2731       empty temp-table tt-log.
     2732       apply "close" to this-procedure .
     2733     end.
     2734   END PROCEDURE.
     2735   PROCEDURE proc-b-prop :
     2736     message "!" view-as alert-box.
     2737   END PROCEDURE.
     2738   PROCEDURE proc-b-start :
     2739     define variable v-conn-str  as character no-undo .
     2740     define variable v-retval    as logical   no-undo .
     2741     define variable v-port      as integer   no-undo .
     2742     create-block:
     2743     do
     2744     on error undo, return error return-value
     2745     :
     2746       assign
     2747         v-port = fi-port
     2748       .
     2749       assign
     2750         v-conn-str = substitute("-S &1" , v-port)
     2751       .
     2752       create server-socket v-server-socket no-error .
     2753       if error-status :error or not valid-handle (v-server-socket)
     2754       then do:
     2755         message
     2756           "Ошибка при создании серверного сокета!" skip
     2757           error-status :get-message(1) skip
     2758           error-status :get-message(2) skip
     2759           error-status :get-message(3) skip
     2760         view-as alert-box error.
     2761         undo create-block, return error.
     2762       end.
     2763       assign
     2764         v-retval = v-server-socket :enable-connections( v-conn-str )
     2765       .
     2766       if v-retval = no
     2767       then do:
     2768         run write-log in this-procedure ("Ошибка при вызове процедуры enable-connections.").
     2769         undo create-block, return error.
     2770       end.
     2771       assign
     2772         v-retval = v-server-socket :set-connect-procedure( "conproc" )
     2773       .
     2774       if v-retval = no
     2775       then do:
     2776         run write-log in this-procedure ("Ошибка при вызове процедуры set-connect-procedure.").
     2777         undo create-block, return error.
     2778       end.
     2779       run write-log in this-procedure ( substitute(  "Сервер запущен на порте &1." , v-port ) ).
     2780     end.
     2781     assign
     2782       b-start :sensitive in frame DEFAULT-FRAME = no
     2783       fi-port :sensitive in frame DEFAULT-FRAME = no
     2784       b-stop  :sensitive in frame DEFAULT-FRAME = yes
     2785       b-exit  :sensitive in frame DEFAULT-FRAME = no
     2786       r-semaphore :bgcolor = GREEN_COLOR
     2787       v-server-running     = true
     2788     .
     2789     run mt-serv_write-user-num ( input 0 ) .
     2790   END PROCEDURE.
     2791   PROCEDURE proc-b-stop :
     2792   do
     2793   on error undo, return error return-value
     2794   :
     2795     define variable v-answer as logical   no-undo .
     2796     run gbl/q-wait.w ( input substitute( "Вы хотите остановить сервер ?" )
     2797                      , input false
     2798                      , input 5
     2799                      , output v-answer
     2800                      ) .
     2801     if v-answer = true
     2802     then do:
     2803       run stop-server in this-procedure .
     2804       assign
     2805         b-stop  :sensitive in frame DEFAULT-FRAME = no
     2806         b-start :sensitive in frame DEFAULT-FRAME = yes
     2807         fi-port :sensitive in frame DEFAULT-FRAME = yes
     2808         b-exit  :sensitive in frame DEFAULT-FRAME = yes
     2809         r-semaphore :bgcolor = RED_COLOR
     2810       .
     2811       run mt-serv_write-user-num ( input 0 ) .
     2812     end.
     2813   end.
     2814   END PROCEDURE.
     2815   PROCEDURE proc-check-port :
     2816   END PROCEDURE.
     2817   PROCEDURE readproc :
     2818   define buffer buf_tt-cli-socket for tt-cli-socket.
     2819     define variable v-size          as integer    no-undo .
     2820     define variable v-crc32         as int64      no-undo .
     2821     define variable v-func_num      as integer    no-undo .
     2822     define variable v-req_num       as integer    no-undo .
     2823     define variable v-field_num     as integer    no-undo .
     2824     define variable v-text          as character  no-undo .
     2825     define variable v-checked-crc32 as int64      no-undo .
     2826     define variable v-msg-size      as integer    no-undo .
     2827     define variable v-memptr        as memptr     no-undo .
     2828     define variable v-memptrw       as memptr     no-undo .
     2829     define variable v-memptrs       as memptr     no-undo .
     2830     define variable v-msg-str       as longchar   no-undo .
     2831     define variable v-bytes-readed  as integer    no-undo .
     2832     define variable v-log           as logical    no-undo .
     2833     define variable v-sendmemptr    as memptr     no-undo .
     2834     define variable v-sendstr       as longchar   no-undo .
     2835     define variable v-date          as date       no-undo .
     2836     define variable v-time          as integer    no-undo .
     2837   do
     2838   on error undo, return error return-value
     2839   :
     2840     run cur-time in this-procedure ( output v-date
     2841                                    , output v-time
     2842                                    ) .
     2843       run mt-serv_write-last-conn-time in this-procedure ( input substitute( "&1 &2"
     2844                                                                            , v-date
     2845                                                                            , string(v-time, "hh:mm:ss")
     2846                                                                            )
     2847                                                          ) .
     2848       find first buf_tt-cli-socket no-lock
     2849         where buf_tt-cli-socket.sock-handle = self
     2850       no-error .
     2851       if not available buf_tt-cli-socket
     2852       then do:
     2853         return.
     2854       end.
     2855       if not self:connected() then do:
     2856         run write-log in this-procedure ( substitute( "Удаленный клиент отключился: &1:&2"
     2857                                                     , buf_tt-cli-socket.remote-host
     2858                                                     , buf_tt-cli-socket.remote-port
     2859                                                     )
     2860                                         ) .
     2861         delete buf_tt-cli-socket.
     2862         return.
     2863       end.
     2864       assign
     2865         buf_tt-cli-socket.last-conn-time  = time
     2866         r-semaphore :bgcolor in frame DEFAULT-FRAME = YELLOW_COLOR
     2867       .
     2868       set-size(v-memptr) = 20 .
     2869       self:read(v-memptr,1,20) .
     2870       assign
     2871           v-bytes-readed = self:bytes-read
     2872       .
     2873       if v-bytes-readed < 20
     2874       then do:
     2875           return.
     2876       end.
     2877       assign
     2878         v-size        = get-long(v-memptr,1)
     2879         v-crc32       = get-unsigned-long(v-memptr,5)
     2880         v-func_num    = get-long(v-memptr,9)
     2881         v-req_num     = get-long(v-memptr,13)
     2882         v-field_num   = get-long(v-memptr,17)
     2883         v-msg-size    =  v-size - 20
     2884       .
     2885       put-long(v-memptr,5) = 0 .
     2886       run check-crc32 in this-procedure ( input v-memptr , 20, output v-checked-crc32) .
     2887       set-size(v-memptr) = 0.
     2888       if v-msg-size > 0
     2889       then do:
     2890           set-size(v-memptrs) = v-msg-size .
     2891           self:read(v-memptrs,1,v-msg-size) .
     2892           assign
     2893               v-msg-str = get-string(v-memptrs, 1, v-msg-size)
     2894           .
     2895           set-size(v-memptrs) = 0 .
     2896       end.
     2897       assign
     2898         v-text =   substitute( "CRC32=&1 , CHECKED=&2"
     2899                              , v-crc32
     2900                              , v-checked-crc32
     2901                              )
     2902       .
     2903       run write-log in this-procedure ( substitute( "&1:&2 &3&4&5 byte recieved : &4&6&4&7&4&6"
     2904                                                   , self :remote-host
     2905                                                   , self :remote-port
     2906                                                   , v-text
     2907                                                   , chr(10)
     2908                                                   , self :bytes-read
     2909                                                   , fill('-',120)
     2910                                                   , v-msg-str
     2911                                                   )
     2912                                       ) .
     2913       if valid-handle(v-mt-route-handle) <> true
     2914       then do:
     2915         run gbl/mt-route.p persistent set v-mt-route-handle no-error .
     2916         if error-status :error
     2917         then do:
     2918           run mt-serv_write-error-message in this-procedure ( input "Ошибка при запуске маршрутизатора сообщений mt-route.p":U
     2919                                                             , output v-sendstr
     2920                                                             ) .
     2921         end.
     2922         run mt-route_init in v-mt-route-handle ( input this-procedure
     2923                                                , input p-pos-num
     2924                                                , input v-cfg-max-user-num
     2925                                                , input v-cfg-timeout
     2926                                                ) no-error .
     2927         if error-status :error
     2928         then do:
     2929           run mt-serv_write-error-message in this-procedure ( input "Ошибка установки номера кассы ":U + string(p-pos-num)
     2930                                                             , output v-sendstr
     2931                                                             ) .
     2932         end.
     2933         assign
     2934           v-mt-route-loaded = true
     2935         .
     2936       end.
     2937       if v-mt-route-loaded = true then do:
     2938         run mt-route_process-request in v-mt-route-handle ( input this-procedure
     2939                                                           , input v-req_num
     2940                                                           , input '<?xml version="1.0"?>' + v-msg-str
     2941                                                           , output v-sendstr
     2942                                                           ) no-error .
     2943         if error-status :error
     2944         then do:
     2945           run mt-serv_write-error-message in this-procedure ( input "Ошибка при обработке запроса ":U + string(v-req_num)
     2946                                                             , output v-sendstr
     2947                                                             ) .
     2948         end.
     2949       end.
     2950       set-size(v-sendmemptr) = 20 + length(v-sendstr) + 1 .
     2951       put-long(v-sendmemptr , 1 )   = 20 + length(v-sendstr) .
     2952       put-long(v-sendmemptr , 5 )   = 0 .
     2953       put-long(v-sendmemptr , 9 )   = 0 .
     2954       put-long(v-sendmemptr , 13 )  = 0 .
     2955       put-long(v-sendmemptr , 17 )  = 0 .
     2956       put-string(v-sendmemptr,21)   = v-sendstr .
     2957       v-log = self:write(v-sendmemptr, 1, 20 + length(v-sendstr) ) no-error .
     2958       if error-status :error
     2959       then do:
     2960         message
     2961           error-status :get-message(1) skip
     2962           error-status :get-message(2) skip
     2963           error-status :get-message(3)
     2964         view-as alert-box error.
     2965       end.
     2966       set-size(v-sendmemptr) = 0 .
     2967       run write-log in this-procedure ( substitute("&1 bytes writen: &2&3&2&4&2&3"
     2968                                                   , self:BYTES-WRITTEN
     2969                                                   , chr(10)
     2970                                                   , fill('-',120)
     2971                                                   , v-sendstr
     2972                                                   )
     2973                                       ).
     2974       if v-req_num = 13
     2975       then do:
     2976         self:disconnect().
     2977         run write-log in this-procedure ( substitute( "Client disconnected! &1&2&1"
     2978                                                     , chr(10)
     2979                                                     , fill('*',120)
     2980                                                     )
     2981                                         ).
     2982         delete buf_tt-cli-socket.
     2983       end.
     2984       assign
     2985         r-semaphore :bgcolor in frame DEFAULT-FRAME = GREEN_COLOR
     2986       .
     2987   end.
     2988   END PROCEDURE.
     2989   PROCEDURE save-log :
     2990     output stream slog to value("c:\socklog.log":U) append.
     2991     for each tt-log :
     2992       put stream slog unformatted tt-log.id " " tt-log.log-date " " tt-log.log-time " " tt-log.log-text skip fill('#',200) skip.
     2993     end.
     2994     output stream slog close.
     2995   END PROCEDURE.
     2996   PROCEDURE stop-server :
     2997   do
     2998   on error undo, return error return-value
     2999   :
     3000     for each tt-cli-socket:
     3001       if valid-handle( tt-cli-socket.sock-handle )
     3002       then do:
     3003         tt-cli-socket.sock-handle :disconnect() .
     3004         run write-log in this-procedure ( substitute( "Отключение удаленного пользователя &1:&2"
     3005                                                     , tt-cli-socket.remote-host
     3006                                                     , tt-cli-socket.remote-port
     3007                                                     )
     3008                                         ).
     3009       end.
     3010     end.
     3011     if valid-handle(v-server-socket)
     3012     then do:
     3013       v-server-socket :disable-connections() .
     3014       delete object v-server-socket .
     3015       run write-log in this-procedure ("Сервер остановлен.").
     3016       assign
     3017         v-server-running = false
     3018       .
     3019     end.
     3020     if valid-handle(v-mt-route-handle) = true
     3021     then do:
     3022       delete procedure v-mt-route-handle .
     3023       assign
     3024         v-mt-route-loaded = false
     3025       .
     3026     end.
     3027   end.
     3028   END PROCEDURE.
     3029   PROCEDURE write-log :
     3030   define input  parameter p-message as character no-undo .
     3031   do
     3032   on error undo, return error return-value
     3033   :
     3034     define variable v-str as character no-undo .
     3035     assign
     3036       v-str     = string( time , "HH:MM:SS" ) + ">" + trim(p-message)
     3037       v-log-id  = v-log-id + 1
     3038     .
     3039     create tt-log.
     3040     assign
     3041       tt-log.id           = v-log-id
     3042       tt-log.log-date     = today
     3043       tt-log.log-time     = time
     3044       tt-log.log-text     = p-message
     3045     .
     3046     define buffer sch_tt-log for tt-log.
     3047     find last sch_tt-log no-error .
     3048     if available sch_tt-log
     3049     then do:
     3050       open query br-log for each tt-log  indexed-reposition.
     3051       reposition br-log to rowid rowid(sch_tt-log) no-error .
     3052     end.
     3053   end.
     3054   END PROCEDURE.
