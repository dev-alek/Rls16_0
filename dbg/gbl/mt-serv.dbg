      883   DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.
      884   DEFINE BUTTON b-exit
      885        LABEL "&Выход"
      886        SIZE 10 BY 1.
      887   DEFINE BUTTON b-help
      888        LABEL "Помощь"
      889        SIZE 10 BY 1.
      890   DEFINE BUTTON b-prop
      891        LABEL "&Настройки"
      892        SIZE 10 BY 1.
      893   DEFINE BUTTON b-start
      894        LABEL "&Старт"
      895        SIZE 10 BY 1.
      896   DEFINE BUTTON b-stop
      897        LABEL "&Стоп"
      898        SIZE 10 BY 1.
      899   DEFINE VARIABLE fi-last-conn-time AS CHARACTER FORMAT "X(256)":U
      900        LABEL "Последнее соединение"
      901         VIEW-AS TEXT
      902        SIZE 58 BY .67
      903        FGCOLOR 4  NO-UNDO.
      904   DEFINE VARIABLE fi-port AS INTEGER FORMAT ">>>>9":U INITIAL 0
      905        LABEL "Порт"
      906        VIEW-AS FILL-IN
      907        SIZE 20 BY 1 NO-UNDO.
      908   DEFINE VARIABLE fi-pos-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
      909        LABEL "Номер кассы"
      910         VIEW-AS TEXT
      911        SIZE 20 BY .67
      912        FGCOLOR 4  NO-UNDO.
      913   DEFINE VARIABLE fi-pos-type AS CHARACTER FORMAT "X(256)":U INITIAL "0"
      914        LABEL "Тип кассы"
      915         VIEW-AS TEXT
      916        SIZE 20 BY .67
      917        FGCOLOR 4  NO-UNDO.
      918   DEFINE VARIABLE fi-users AS CHARACTER FORMAT "X(256)":U
      919        LABEL "Пользователи"
      920         VIEW-AS TEXT
      921        SIZE 64.5 BY .67
      922        FGCOLOR 4  NO-UNDO.
      923   DEFINE RECTANGLE r-semaphore
      924        EDGE-PIXELS 1 GRAPHIC-EDGE
      925        SIZE 80 BY 1
      926        BGCOLOR 12 .
      927   DEFINE QUERY br-log FOR
      928         tt-log SCROLLING.
      929   DEFINE BROWSE br-log
      930     QUERY br-log DISPLAY
      931         tt-log.id FORMAT ">>>>>9" LABEL "#"
      932       tt-log.log-text FORMAT "X(200)" LABEL "Сообщение"
      933       WITH NO-ROW-MARKERS SIZE 80 BY 10 FIT-LAST-COLUMN.
      934   DEFINE FRAME DEFAULT-FRAME
      935        b-exit AT ROW 1 COL 1 WIDGET-ID 4
      936        b-start AT ROW 1 COL 11 WIDGET-ID 6
      937        b-stop AT ROW 1 COL 21 WIDGET-ID 10
      938        b-prop AT ROW 1 COL 31 WIDGET-ID 28
      939        b-help AT ROW 1 COL 71 WIDGET-ID 14
      940        fi-port AT ROW 4.83 COL 9 WIDGET-ID 8
      941        br-log AT ROW 7 COL 1 WIDGET-ID 200
      942        fi-pos-num AT ROW 2 COL 13 COLON-ALIGNED WIDGET-ID 16
      943        fi-pos-type AT ROW 2.71 COL 13 COLON-ALIGNED WIDGET-ID 18
      944        fi-users AT ROW 3.42 COL 13 COLON-ALIGNED WIDGET-ID 24
      945        fi-last-conn-time AT ROW 4.13 COL 21 COLON-ALIGNED WIDGET-ID 26
      946        r-semaphore AT ROW 5.92 COL 1 WIDGET-ID 12
      947       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      948            SIDE-LABELS NO-UNDERLINE THREE-D
      949            AT COL 1 ROW 1
      950            SIZE 80 BY 16 WIDGET-ID 100.
      951   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      952     CREATE WINDOW C-Win ASSIGN
      953            HIDDEN             = YES
      954            TITLE              = "МТ-Сервер"
      955            HEIGHT             = 16
      956            WIDTH              = 80
      957            MAX-HEIGHT         = 16
      958            MAX-WIDTH          = 80
      959            VIRTUAL-HEIGHT     = 16
      960            VIRTUAL-WIDTH      = 80
      961            RESIZE             = yes
      962            SCROLL-BARS        = no
      963            STATUS-AREA        = no
      964            BGCOLOR            = ?
      965            FGCOLOR            = ?
      966            KEEP-FRAME-Z-ORDER = yes
      967            THREE-D            = yes
      968            MESSAGE-AREA       = no
      969            SENSITIVE          = yes.
      970   ELSE C-Win = CURRENT-WINDOW.
      971   ASSIGN
      972          fi-last-conn-time:READ-ONLY IN FRAME DEFAULT-FRAME        = TRUE.
      973   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      974   THEN C-Win:HIDDEN = no.
      975   ON END-ERROR OF C-Win
      976   OR ENDKEY OF C-Win ANYWHERE DO:
      977     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      978   END.
      979   ON WINDOW-CLOSE OF C-Win
      980   DO:
      981     APPLY "CLOSE":U TO THIS-PROCEDURE.
      982     RETURN NO-APPLY.
      983   END.
      984   ON WINDOW-MAXIMIZED OF C-Win
      985   DO:
      986     RETURN NO-APPLY.
      987   END.
      988   ON WINDOW-RESIZED OF C-Win
      989   DO:
      990     RETURN NO-APPLY.
      991   END.
