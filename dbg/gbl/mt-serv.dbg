      622   procedure cur-time :
      623      define output parameter p-today as date      no-undo .
      624      define output parameter p-time  as integer   no-undo .
      625     do
      626     on error undo, return error
      627     :
      628       define variable v-date1 as date      no-undo .
      629       define variable v-date2 as date      no-undo .
      630       define variable v-time  as integer   no-undo .
      631       assign
      632         v-date1 = today
      633         v-time  = time
      634         v-date2 = today
      635       .
      636       if v-date1 <> v-date2
      637       then do:
      638         assign
      639           v-date1 = today
      640           v-time  = v-time
      641         .
      642       end.
      643       assign
      644         p-today = v-date1
      645         p-time  = v-time
      646       .
      647     end.
      648   end.
      649   function cur-time-date returns character
      650   :
      651     return string(today, '99/99/9999':U) .
      652   end.
      653   function cur-time-mjd returns decimal
      654   :
      655     define variable v-date as date      no-undo .
      656     define variable v-time as integer   no-undo .
      657     run cur-time in this-procedure
      658       (output v-date
      659       ,output v-time
      660       ) .
      661     return integer(v-date) - 2400002 + (v-time / 86400) .
      662   end.
      663   function cur-time-get-ending-index returns integer
      664   (input p-number as integer
      665   )
      666   :
      667     if p-number < 0
      668     or p-number = ?
      669     then do:
      670       return 1 .
      671     end.
      672     define variable v-rest as integer   no-undo .
      673     assign
      674       p-number = p-number modulo 100
      675     .
      676     if p-number < 20
      677     then do:
      678       assign
      679         v-rest = p-number
      680       .
      681     end.
      682     else do:
      683       assign
      684         v-rest = p-number modulo 10
      685       .
      686     end.
      687     case v-rest :
      688       when 1
      689       then do:
      690         return 2 .
      691       end.
      692       when 2 or
      693       when 3 or
      694       when 4
      695       then do:
      696         return 3 .
      697       end.
      698       otherwise do:
      699         return 1 .
      700       end.
      701     end case .
      702   end.
      703   procedure cur-time-mjd-to-date :
      704      define input  parameter i-mjd-diff as decimal no-undo.
      705      define output parameter o-Date     as date    no-undo.
      706      define output parameter o-Time     as integer no-undo.
      707      define variable v-day-number as integer   no-undo .
      708      if    i-mjd-diff < 0
      709         or i-mjd-diff = ?
      710      then do:
      711         return "?" .
      712      end.
      713      assign
      714         v-day-number = truncate(i-mjd-diff,0).
      715         o-Date = date(v-day-number + 2400002).
      716         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      717     .
      718   end.
      719   function cur-time-mjd-to-string returns character
      720   (input p-mjd-diff as decimal
      721   )
      722   :
      723     define variable v-day-number as integer   no-undo .
      724     define variable v-seconds    as integer   no-undo .
      725     define variable v-hour       as integer   no-undo .
      726     define variable v-min        as integer   no-undo .
      727     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      728     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      729     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      730     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      731     if p-mjd-diff < 0
      732     or p-mjd-diff = ?
      733     then do:
      734       return "?" .
      735     end.
      736     assign
      737       v-day-number = integer(truncate(p-mjd-diff,0))
      738       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      739     .
      740     if v-seconds > 86400
      741     then do:
      742       assign
      743         v-seconds = 86400 - 1
      744       .
      745     end.
      746     if v-seconds < 0
      747     then do:
      748       assign
      749         v-seconds = 0
      750       .
      751     end.
      752     assign
      753       v-hour = truncate(v-seconds / 3600, 0)
      754     .
      755     assign
      756       v-seconds = v-seconds modulo 3600
      757     .
      758     assign
      759       v-min = truncate(v-seconds / 60, 0)
      760     .
      761     assign
      762       v-seconds = v-seconds modulo 60
      763     .
      764     return
      765         (if v-day-number <> 0
      766           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      767           else ""
      768         )
      769       + (if v-day-number <> 0 or v-hour <> 0
      770           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      771           else ""
      772         )
      773       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      774           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      775           else ""
      776         )
      777       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      778       .
      779   end.
      780   function cur-time-string returns character
      781   :
      782     define variable v-date as date      no-undo .
      783     define variable v-time as integer   no-undo .
      784     run cur-time in this-procedure
      785       (output v-date
      786       ,output v-time
      787       ) .
      788     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      789   end.
      790   function cur-time-string-sec returns character
      791   :
      792     define variable v-date as date      no-undo .
      793     define variable v-time as integer   no-undo .
      794     run cur-time in this-procedure
      795       (output v-date
      796       ,output v-time
      797       ) .
      798     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      799   end.
      800   function cur-time-custom  returns character
      801   (input p-prefix as character
      802   ,input p-date-format as character
      803   ,input p-delimiter as character
      804   ,input p-time-format as character
      805   ,input p-suffix as character
      806   )
      807   :
      808     define variable v-date as date      no-undo .
      809     define variable v-time as integer   no-undo .
      810     run cur-time in this-procedure
      811       (output v-date
      812       ,output v-time
      813       ) .
      814     return
      815       p-prefix
      816       + string(v-date, p-date-format)
      817       + p-delimiter
      818       + string(v-time, p-time-format)
      819       + p-suffix
      820       .
      821   end.
      822   function cur-time-print  returns character
      823   :
      824     define variable v-date as date      no-undo .
      825     define variable v-time as integer   no-undo .
      826     run cur-time in this-procedure
      827       (output v-date
      828       ,output v-time
      829       ) .
      830     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      831   end.
      832   function cur-time-datetime returns datetime
      833   :
      834     define variable v-char as character no-undo .
      835     define variable v-datetime as datetime no-undo .
      836     v-char = cur-time-string().
      837     v-datetime = datetime(v-char).
      838     return  v-datetime.
      839   end.
      840   function cur-time-string-msec returns character
      841   :
      842     define variable v-date as datetime  no-undo .
      843     v-date = now.
      844     return string(v-date) .
      845   end.
