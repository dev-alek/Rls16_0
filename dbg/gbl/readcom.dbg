        1   DEFINE VARIABLE cCheckString AS CHARACTER NO-UNDO.
        2   DEFINE STREAM StreamName.
        3   define new global shared variable gComPort as integer no-undo init ?.
        4   if gComPort eq ? then do:
        5      define variable vComPortstr as char no-undo.
        6      get-key-value section "REP-SETS"
        7                          key "ComPort"
        8                        value vComPortstr.
        9      gComPort = int(vComPortstr) no-error.
       10      if    error-status:error
       11         or gComPort < 1
       12         or vComPortstr eq ?
       13      then
       14         gComPort = 1.
       15   end.
       16   INPUT STREAM StreamName FROM value("COM" + string (gComPort)).
       17   ASSIGN cCheckString = "".
       18   REPEAT:
       19    READKEY STREAM StreamName PAUSE 1.
       20    IF LASTKEY = -1 THEN
       21    LEAVE.
       22    ELSE
       23    ASSIGN cCheckString = cCheckString + CHR(LASTKEY).
       24   END.
       25   INPUT STREAM StreamName CLOSE.
       26   return cCheckString.
