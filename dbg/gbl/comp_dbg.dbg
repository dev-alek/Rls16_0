        1   block-level on error undo, throw.
        2   define input  parameter p-module-file-name  as character no-undo .
        3   define input  parameter p-progress-curdir   as character no-undo .
        4   define input  parameter p-progress-inifile  as character no-undo .
        5   define input  parameter p-progress-propath  as character no-undo .
        6   define input  parameter p-r-code-name       as character no-undo .
        7   define input  parameter p-proc-line         as character no-undo .
        8   define input  parameter p-db-connect-string as character no-undo .
        9   define output parameter p-dbg-file          as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: comp_dbg.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/comp_dbg.p $":U .
       15   define variable vss-description as character no-undo init "Создать dbg файл для программы из другой сессии".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define stream sout .
       75   define variable v-run-filename     as character no-undo .
       76   define variable v-compile-filename as character no-undo .
       77   define variable v-dbg-filename     as character no-undo .
       78   do
       79   on error undo, return error return-value
       80   :
       81     run gbl/_tmpfile.p
       82       (input  "prw"
       83       ,input  ".dbg"
       84       ,output v-dbg-filename
       85       ).
       86     output stream sout to value(v-dbg-filename).
       87     put stream sout unformatted "ERROR GENERATING *.DBG FILE" skip .
       88     output stream sout close .
       89     assign
       90       file-info :file-name = v-dbg-filename
       91       v-dbg-filename = file-info :full-pathname
       92     .
       93     run gbl/_tmpfile.p
       94       (input  "prw"
       95       ,input  ".p"
       96       ,output v-compile-filename
       97       ).
       98     output stream sout to value(v-compile-filename).
       99     put stream sout unformatted substitute('assign propath = "&1" .':u, p-progress-propath) + chr(10) .
      100     put stream sout unformatted substitute('do on error undo, leave :':u, p-progress-propath) + chr(10) .
      101     if p-db-connect-string <> ""
      102     then do:
      103       put stream sout unformatted '  connect value("' + p-db-connect-string + '") .':u  + chr(10) .
      104       put stream sout unformatted '  create alias value("src") for database ub.':u  + chr(10) .
      105       put stream sout unformatted '  create alias value("dst") for database ub.':u  + chr(10) .
      106       put stream sout unformatted '  create alias value("db-orig") for database ub.':u  + chr(10) .
      107       put stream sout unformatted '  create alias value("db-copy") for database ub.':u  + chr(10) .
      108       put stream sout unformatted '  create alias value("ubflt") for database ub.':u  + chr(10) .
      109       put stream sout unformatted '  create alias value("ubfltsrc") for database ub.':u  + chr(10) .
      110       put stream sout unformatted '  create alias value("ubfltdst") for database ub.':u  + chr(10) .
      111       put stream sout unformatted '  create alias value("restseq") for database ub.':u  + chr(10) .
      112       put stream sout unformatted '  create alias value("restseqflt") for database ub.':u  + chr(10) .
      113     end.
      114     put stream sout unformatted substitute('  assign propath = "&1" .':u, p-progress-propath) + chr(10) .
      115     put stream sout unformatted substitute('  compile &1 debug-list &2 .':u, p-r-code-name, v-dbg-filename) + chr(10) .
      116     put stream sout unformatted substitute('end.':u, p-progress-propath) + chr(10) .
      117     put stream sout unformatted substitute('quit.':u, p-r-code-name, v-dbg-filename) + chr(10) .
      118     output stream sout close .
      119     assign
      120       file-info :file-name = v-compile-filename
      121       v-compile-filename = file-info :full-pathname
      122     .
      123     run gbl/_tmpfile.p
      124       (input  "prw"
      125       ,input  ".bat"
      126       ,output v-run-filename
      127       ).
      128     output stream sout to value(v-run-filename).
      129     put stream sout unformatted substitute('start /w "/d&4" "&1" -ininame "&2" -basekey "INI" -p "&3"':u, p-module-file-name, p-progress-inifile, v-compile-filename, p-progress-curdir) + chr(10) .
      130     put stream sout unformatted substitute('exit':u) + chr(10) .
      131     output stream sout close .
      132     assign
      133       file-info :file-name = v-run-filename
      134       v-run-filename = file-info :full-pathname
      135     .
      136     os-command value(v-run-filename) .
      137     os-delete value(v-compile-filename) .
      138     os-delete value(v-run-filename) .
      139     assign
      140       p-dbg-file = v-dbg-filename
      141     .
      142   end.
