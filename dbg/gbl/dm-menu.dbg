     5291     define variable v-r-b       as character no-undo.
     5292     do
     5293     on error undo, return error return-value
     5294     :
     5295   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5297     (output v-r-b
     5298     )  .
     5299   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5300   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5301     (input  v-cntxt-obj-type
     5302     ,input  v-cntxt-obj-code
     5303     ,output v-host-code
     5304     )  .
     5305   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5307     (input  v-host-code
     5308     ,output v-base-code
     5309     )  .
     5310       if  v-r-b = 'rubl':u
     5311       and v-base-code = 0
     5312       then do:
     5313         run str/diallog.w
     5314           (input  parparentproc
     5315           ,input  this-procedure
     5316           ,input  "str/send-cur.p":U
     5317           ,input  (v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + "U")
     5318           ,input  no
     5319           ,input  "":U
     5320           ,input  substitute("Отсылка данных по курсам валют на кассы")
     5321           ) no-error.
     5322       end.
     5323       else do:
     5324         run ref/currshop.w (input parparentproc, input v-cntxt-obj-type, input v-cntxt-obj-code).
     5325       end.
     5326     end.
     5327   END PROCEDURE.
