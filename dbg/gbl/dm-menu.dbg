        1   block-level on error undo, throw.
        2   define input  parameter parparentproc     as widget-handle no-undo .
        3   define input  parameter p-menu-handle     as widget-handle no-undo .
        4   define input  parameter p-menu-code       as integer   no-undo .
        5   define input  parameter p-menu-group-code as integer   no-undo .
        6   define output parameter p-menu-control-number as character no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision$":U .
        8   define variable vss-author      as character no-undo initial "$Author$":U .
        9   define variable vss-date        as character no-undo initial "$Date$":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       11   define variable vss-archive     as character no-undo initial "$Archive$":U .
       12   define variable vss-description as character no-undo initial "Создание динамического меню":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3':u,parparentproc,p-menu-handle,p-menu-code,p-menu-group-code)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   define new global shared variable g#library  as handle no-undo .
      325   define new global shared variable g#library2 as handle no-undo .
      326   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327   function octal-to-char return character
      328   ( p-string as character ) :
      329     def var v-asc     as integer no-undo .
      330     def var v-new-asc as integer no-undo .
      331     def var ind       as integer no-undo .
      332     if length(p-string) <> 3 then do:
      333       return ? .
      334     end.
      335     assign
      336       v-asc = 0
      337     .
      338     do ind = 1 to length(p-string)
      339     :
      340       assign
      341         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      342       .
      343       if v-new-asc < 0 or v-new-asc >= 8 then do:
      344         return ? .
      345       end.
      346       assign
      347         v-asc = v-asc * 8 + v-new-asc
      348       .
      349     end.
      350     return chr(v-asc) .
      351   end function .
      352   function char-to-octal return character
      353   ( p-chr as character ) :
      354     def var v-asc    as integer   no-undo .
      355     def var ind      as integer   no-undo .
      356     def var v-string as character no-undo .
      357     if length(p-chr) <> 1 then do:
      358       return ? .
      359     end.
      360     assign
      361       v-asc    = asc(p-chr)
      362       v-string = ""
      363     .
      364     do ind = 1 to 3
      365     :
      366       assign
      367         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      368       .
      369       assign
      370         v-asc = truncate(v-asc / 8, 0)
      371       .
      372     end.
      373     return v-string .
      374   end.
      375   function str-encode return character
      376   (   p-init-string       as character
      377     , p-encode-char       as character
      378     , p-special-char-list as character
      379   ) :
      380     def var p-encode-string as character no-undo .
      381     def var ind                as integer no-undo .
      382     def var v-num-special-char as integer no-undo .
      383     def var v-special-char     as character no-undo .
      384     if p-encode-char = ?
      385     or p-encode-char = "" then do:
      386       assign
      387         p-encode-char = "~~"
      388       .
      389     end.
      390     if p-init-string = ? then do:
      391       return "?" .
      392     end.
      393     if p-init-string = "?" then do:
      394       return p-encode-char + char-to-octal("?") .
      395     end.
      396     assign
      397       v-num-special-char = length(p-special-char-list)
      398       p-encode-string    = replace(p-init-string
      399                                   ,p-encode-char
      400                                   ,p-encode-char + char-to-octal(p-encode-char)
      401                                   )
      402     .
      403     do ind = 1 to v-num-special-char
      404     :
      405       assign
      406         v-special-char = substring(p-special-char-list, ind, 1)
      407       .
      408       if v-special-char <> p-encode-char then do:
      409         assign
      410           p-encode-string = replace (p-encode-string
      411                                     ,v-special-char
      412                                     ,p-encode-char + char-to-octal(v-special-char)
      413                                     )
      414         .
      415       end.
      416     end.
      417     return p-encode-string .
      418   end.
      419   function str-decode returns character
      420     (p-init-string   as character
      421     ,p-encode-char   as character
      422     ) :
      423     def var p-decode-string as character no-undo .
      424     def var ind                       as integer no-undo .
      425     def var v-num-entries-init-string as integer no-undo .
      426     def var v-sub-phrase              as character no-undo .
      427     def var v-special-char            as character no-undo .
      428     if p-encode-char = ?
      429     or p-encode-char = "" then do:
      430       assign
      431         p-encode-char = "~~"
      432       .
      433     end.
      434     if p-init-string = "?" then do:
      435       return ? .
      436     end.
      437     assign
      438       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      439     .
      440     if v-num-entries-init-string > 1 then do:
      441       assign
      442         p-decode-string = entry(1, p-init-string, p-encode-char)
      443       .
      444       do ind = 2 to v-num-entries-init-string
      445       :
      446         assign
      447           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      448         .
      449         assign
      450           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      451         .
      452         if v-special-char <> ? then do:
      453           assign
      454             p-decode-string = p-decode-string
      455                             + v-special-char
      456                             + substring(v-sub-phrase, 4)
      457           .
      458         end.
      459         else do:
      460           assign
      461             p-decode-string = p-decode-string
      462                             + p-encode-char
      463                             + v-sub-phrase
      464           .
      465         end.
      466       end.
      467     end.
      468     else do:
      469       assign
      470         p-decode-string = p-init-string
      471       .
      472     end.
      473     return p-decode-string .
      474   end.
      475   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476     define variable v-cntxt-db-num        as integer   no-undo .
      477     define variable v-cntxt-userid        as character no-undo .
      478     define variable v-cntxt-level         as character no-undo .
      479     define variable v-cntxt-host-code-obj as integer   no-undo .
      480     define variable v-cntxt-obj-type      as character no-undo .
