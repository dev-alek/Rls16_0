     7319   PROCEDURE m_disable-online-check :
     7320     define buffer buf_thbj-attr for ub.thbj-attr .
     7321     define variable p-enable-item as logical   no-undo .
     7322     run chk-goods_add(output p-enable-item)no-error .
     7323     if not p-enable-item then return .
     7324     define variable v-current-db-num as integer   no-undo .
     7325     define variable v-obj-db-num     as integer   no-undo .
     7326     define variable v-CrashCh        as logical   no-undo .
     7327     define variable v-ok             as logical   no-undo .
     7328     message
     7329      "Внимание! При включении аварии продажа маркированной продукции на кассе происходит без проверки в Честном Знаке! Включить аварию?"
     7330       view-as alert-box question buttons yes-no update v-ok .
     7331     if v-ok <> true then do:
     7332         return.
     7333     end.
     7334   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7336     (output v-current-db-num
     7337     )  .
     7338     v-CrashCh = no.
     7339     if v-current-db-num <> 0 then do:
     7340         run chgCrashSituat (v-current-db-num, 'БД':U, yes, yes, output v-CrashCh).
     7341     end.
     7342     else do:
     7343         for each ub.db no-lock :
     7344           run chgCrashSituat (ub.db.db-num, 'БД':U, yes, no, output v-CrashCh).
     7345         end.
     7346         run chgCrashSituat (0, "", yes, no, output v-CrashCh).
     7347     end.
     7348     if v-CrashCh = yes then
     7349     message "Параметр «Аварийная ситуация в ГИС МТ» - включен"
     7350       view-as alert-box.
     7351   END PROCEDURE.
     7352   PROCEDURE m_enable-online-check :
     7353     define buffer buf_thbj-attr for ub.thbj-attr .
     7354     define variable p-enable-item as logical   no-undo .
     7355     run chk-goods_add(output p-enable-item)no-error .
     7356     if not p-enable-item then return .
     7357     define variable v-current-db-num as integer   no-undo .
     7358     define variable v-obj-db-num     as integer   no-undo .
     7359     define variable v-CrashCh        as logical   no-undo .
     7360   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     7362     (output v-current-db-num
     7363     )  .
     7364     v-CrashCh = no.
     7365     if v-current-db-num <> 0 then do:
     7366       run chgCrashSituat (v-current-db-num, 'БД':U, no, yes, output v-CrashCh).
     7367     end.
     7368     else do:
     7369         for each ub.db no-lock :
     7370           run chgCrashSituat (ub.db.db-num, 'БД':U, no, no, output v-CrashCh).
     7371         end.
     7372         run chgCrashSituat (0, "", no, no, output v-CrashCh).
     7373     end.
     7374     if v-CrashCh = yes then
     7375     message "Параметр «Аварийная ситуация в ГИС МТ» - выключен"
     7376       view-as alert-box.
     7377   END PROCEDURE.
     7378   PROCEDURE chgCrashSituat:
     7379      define input  parameter iObjCode as integer no-undo.
     7380      define input  parameter iObjType as character no-undo.
     7381      define input  parameter iValue   as logical no-undo.
     7382      define input  parameter iCreateLocal as logical no-undo.
     7383      define output parameter oChgVal  as logical no-undo.
     7384      define buffer buf_thbj-attr for ub.thbj-attr .
     7385      do transaction
     7386          on error undo, return error:
     7387          oChgVal = no.
     7388          find first buf_thbj-attr exclusive-lock where
     7389                     buf_thbj-attr.obj-code = iObjCode and
     7390                     buf_thbj-attr.obj-type = iObjType and
     7391                     buf_thbj-attr.upper-prop-code = 'gisMT':U and
     7392                     buf_thbj-attr.prop-code = 'crashSituat':U
     7393                 no-wait no-error.
     7394          if not avail buf_thbj-attr and
     7395             iCreateLocal = yes
     7396          then do:
     7397              run crLocalCrashSit (iObjCode,
     7398                                   iObjType,
     7399                                   iValue,
     7400                                   output oChgVal ) no-error.
     7401          end.
     7402          else if avail buf_thbj-attr
     7403          then do:
     7404             buf_thbj-attr.property-value-logical = iValue .
     7405             oChgVal = yes.
     7406          end.
     7407      end.
     7408   END PROCEDURE.
     7409   PROCEDURE crLocalCrashSit:
     7410       define input  parameter iObjCode as integer no-undo.
     7411       define input  parameter iObjType as character no-undo.
     7412       define input  parameter iValue   as logical no-undo.
     7413       define output parameter oChgVal  as logical no-undo.
     7414       define variable v-param-type      as character  no-undo .
     7415       define variable v-value-character as character  no-undo .
     7416       define variable v-value-date      as date       no-undo .
     7417       define variable v-value-decimal   as decimal    no-undo .
     7418       define variable v-value-integer   as integer    no-undo .
     7419       define variable v-value-logical   as logical    no-undo .
     7420       define variable v-tth             as handle     no-undo .
     7421       for each thbjattr_thbj-attr:
     7422         delete thbjattr_thbj-attr.
     7423       end.
     7424       run adm/shattri.p (
     7425         input "init":U
     7426         ,input  iObjType
     7427         ,input  iObjCode
     7428         ,input  'gisMT':U
     7429         ,input  "":U
     7430         ,output v-value-character
     7431         ,output v-value-date
     7432         ,output v-value-decimal
     7433         ,output v-value-integer
     7434         ,output v-value-logical
     7435         ,output v-param-type
     7436         ,INPUT-OUTPUT table thbjattr_thbj-attr
     7437         )  no-error.
     7438       for each thbjattr_thbj-attr
     7439       on error undo, return error return-value
     7440       :
     7441         if thbjattr_thbj-attr.prop-code = 'crashSituat':U
     7442         then do:
     7443             thbjattr_thbj-attr.property-value-logical = iValue.
     7444         end .
     7445         else delete thbjattr_thbj-attr.
     7446       end.
     7447       RUN thbjattr_set-section IN THIS-PROCEDURE (
     7448                input iObjType
     7449               ,input iObjCode
     7450               ,input 'gisMT':U
     7451               ,INPUT table thbjattr_thbj-attr
     7452           ) NO-ERROR.
     7453       if error-status:error then do:
     7454           message "Не удалось сохранить настройки"
     7455           view-as alert-box.
     7456           undo, return error.
     7457       end.
     7458       else oChgVal = yes .
     7459   END PROCEDURE.
