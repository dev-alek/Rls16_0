     8959   procedure m__inp-jewel-set-val :
     8960     define input  parameter p-action as character no-undo .
     8961     define input-output parameter p-value as logical   no-undo .
     8962     do
     8963     on error undo, return error return-value
     8964     :
     8965       case p-action :
     8966         when 'set':u
     8967         then do:
     8968           run set-inp-jewel in parparentproc
     8969             (input  p-value
     8970             ) .
     8971         end.
     8972         when 'get':u
     8973         then do:
     8974           run get-inp-jewel in parparentproc
     8975             (output p-value
     8976             ) .
     8977         end.
     8978       end.
     8979     end.
     8980   end procedure.
