     1538   end procedure.
     1539   define temp-table temp-menu-toggle no-undo
     1540     field item-code      as integer
     1541     field item-handle    as widget-handle
     1542     index xpk is primary unique item-code
     1543     .
     1544   define buffer buf_menu-head      for ub.menu-head .
     1545   define variable v-context-list    as character no-undo .
     1546   do
     1547   on error undo, return error return-value
     1548   :
     1549   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550     run mainmenu_getcntxt in parparentproc
     1551       (output v-cntxt-db-num
     1552       ,output v-cntxt-userid
     1553       ,output v-cntxt-level
     1554       ,output v-cntxt-host-code-obj
     1555       ,output v-cntxt-obj-type
     1556       ,output v-cntxt-obj-code
     1557       ,output v-cntxt-db-num-obj
     1558       ,output v-cntxt-is-admin
     1559       ) .
     1560     case v-cntxt-level
     1561     :
     1562       when 'global':U
     1563       then do:
     1564         assign
     1565           v-context-list = 'global':U
     1566         .
     1567       end.
     1568       when 'firm':U
     1569       then do:
     1570         assign
     1571           v-context-list = 'global':U + chr(44) + 'firm':U
     1572         .
     1573       end.
     1574       when 'object':U
     1575       then do:
     1576         assign
     1577           v-context-list = 'global':U + chr(44) + 'firm':U + chr(44) + 'object':U
     1578         .
     1579       end.
     1580       otherwise do:
     1581         message
     1582           vss-workfile vss-revision vss-description skip
     1583           "Неизвестное значение контекста" skip
     1584           "Контекст" v-cntxt-level skip
     1585           view-as alert-box error .
     1586         undo, return error return-value .
     1587       end.
     1588     end case .
     1589      define variable v-value    as character no-undo .
     1590      define variable v-type     as character no-undo .
     1591      define variable isERPRN as logical no-undo.
     1592       run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-type) no-error.
     1593       isERPRN = v-value eq "yes".
     1594     define stream sinp .
     1595     define stream sout .
     1596     create widget-pool .
     1597     run mainmenu-menu-item-clear in parparentproc .
     1598       find first buf_menu-head
     1599          where buf_menu-head.menu-code = p-menu-code
     1600          no-lock
     1601          .
     1602     assign
     1603         p-menu-control-number = buf_menu-head.control-number
     1604     .
     1605     release buf_menu-head.
     1606     run proc-create-menu-item in this-procedure
     1607       (input  0
     1608       ,input  p-menu-handle
     1609       ,input  true
     1610       ,input  true
     1611       ) .
     1612     run mainmenu-menu-item-open in parparentproc
     1613       (input  0
     1614       ) .
     1615   end.
     1616   procedure proc-create-menu-item :
     1617     define input  parameter p-parent-code   as integer   no-undo .
     1618     define input  parameter p-parent-handle as widget-handle no-undo .
     1619     define input  parameter p-create-menu   as logical   no-undo .
     1620     define input  parameter p-create-browse as logical   no-undo .
     1621     define buffer buf_menu-item for ub.menu-item .
     1622     define buffer buf_temp-menu-toggle for temp-menu-toggle .
     1623     define buffer buf_menu-item-group for ub.menu-item-group .
     1624     define variable v-object-handle         as widget-handle no-undo .
     1625     define variable v-enable-procedure-list as character no-undo .
     1626     define variable v-enable-item           as logical   no-undo .
     1627     define variable v-procedure-enable-item as logical   no-undo .
     1628     define variable v-enable-index          as integer   no-undo .
     1629     define variable v-enable-num-proc       as integer   no-undo .
     1630     define variable v-item-exist            as logical   no-undo .
     1631     define variable v-create-line           as logical   no-undo .
     1632     do
     1633     on error undo, return error return-value
     1634     :
     1635       assign
     1636         v-item-exist  = false
     1637         v-create-line = false
     1638       .
     1639       IF p-menu-code <> 0
     1640       AND NOT CAN-FIND( FIRST buf_menu-item
     1641                         WHERE buf_menu-item.menu-code = p-menu-code
     1642                           AND buf_menu-item.item-code = p-parent-code
     1643                         SHARE-LOCK NO-WAIT
     1644                       ) THEN DO:
     1645          message "Другой пользователь изменил состав меню." SKIP
     1646                  "Перезайдите в TradeHouse или повторно выберите группу меню."
     1647          VIEW-AS ALERT-BOX.
     1648          RETURN.
     1649       END.
     1650       create-menu-item :
     1651       for each buf_menu-item no-lock
     1652         where buf_menu-item.menu-code   = p-menu-code
     1653           and buf_menu-item.parent-code = p-parent-code
     1654       by buf_menu-item.item-code
     1655       on error undo create-menu-item, next create-menu-item
     1656       :
     1657         assign
     1658           v-enable-item = true
     1659         .
     1660         assign
     1661           v-enable-procedure-list = '':u
     1662         .
     1663         if buf_menu-item.item-type = 's-m':u
     1664         then do:
     1665           find first buf_menu-item-group no-lock
     1666             where buf_menu-item-group.menu-code       = p-menu-code
     1667               and buf_menu-item-group.item-code       = buf_menu-item.item-code
     1668               and buf_menu-item-group.item-context    = v-cntxt-level
     1669               and buf_menu-item-group.menu-group-code = p-menu-group-code
     1670             no-error .
     1671           if available buf_menu-item-group
     1672           then do:
     1673             assign
     1674               v-enable-procedure-list = buf_menu-item-group.item-condition
     1675             .
     1676           end.
     1677           else do:
     1678             assign
     1679               v-enable-item = false
     1680             .
     1681           end.
     1682         end.
     1683         else do:
     1684           if lookup(string(p-menu-group-code), buf_menu-item.item-group-id) > 0
     1685           then do:
     1686             assign
     1687               v-enable-procedure-list = buf_menu-item.item-condition
     1688             .
     1689           end.
     1690           else do:
     1691             assign
     1692               v-enable-item = false
     1693             .
     1694           end.
     1695         end.
     1696         if  (buf_menu-item.item-type = 'm-i':U
     1697              or
     1698              buf_menu-item.item-type = 'm-t':U
     1699             )
     1700         and v-enable-item = true
     1701         then do:
     1702           if lookup(buf_menu-item.item-context, v-context-list) > 0
     1703           then do:
     1704           end.
     1705           else do:
     1706             assign
     1707               v-enable-item = false
     1708             .
     1709           end.
     1710         end.
     1711         if v-enable-item = true
     1712         then do:
     1713           if  buf_menu-item.item-condition <> ""
     1714           and buf_menu-item.item-condition <> ?
     1715           then do:
     1716             assign
     1717               v-enable-num-proc = num-entries(v-enable-procedure-list, chr(44))
     1718             .
     1719             check_condition:
     1720             do v-enable-index = 1 to v-enable-num-proc
     1721             :
     1722               run value(entry(v-enable-index,v-enable-procedure-list,chr(44))) in this-procedure
     1723                 (output v-procedure-enable-item
     1724                 ) .
     1725               if v-procedure-enable-item <> true
     1726               then do:
     1727                 assign
     1728                   v-enable-item = false
     1729                 .
     1730                 leave check_condition .
     1731               end.
     1732             end.
     1733           end.
     1734         end.
     1735         if v-enable-item = true
     1736         then do:
     1737           if p-create-menu = true
     1738           then do:
     1739             if buf_menu-item.item-type = 'r-l':U
     1740             then do:
     1741               assign
     1742                 v-create-line = true
     1743               .
     1744             end.
     1745             else do:
     1746               if  v-item-exist  = true
     1747               and v-create-line = true
     1748               then do:
     1749                 create menu-item v-object-handle
     1750                 assign
     1751                   subtype = "rule"
     1752                   parent  = p-parent-handle
     1753                 .
     1754               end.
     1755               assign
     1756                 v-item-exist  = true
     1757                 v-create-line = false
     1758               .
     1759             end.
     1760             case buf_menu-item.item-type
     1761             :
     1762               when 's-m':u
     1763               then do:
     1764                 create sub-menu v-object-handle
     1765                 assign
     1766                   label = buf_menu-item.item-name
     1767                   triggers:
     1768                     on menu-drop
     1769                     persistent run run-menu-drop-procedure in this-procedure
     1770                       (input v-object-handle
     1771                       ).
     1772                     end triggers.
     1773                 .
     1774                 assign
     1775                   v-object-handle :private-data = 's-m':u
     1776                                                 + chr(44) + string(buf_menu-item.item-code)
     1777                 .
     1778               end.
     1779               when 'r-l':u
     1780               then do:
     1781               end.
     1782               when 'm-i':u
     1783               then do:
     1784                 create menu-item v-object-handle
     1785                 assign
     1786                   label = buf_menu-item.item-name
     1787                   triggers:
     1788                     on choose
     1789                     persistent run run-menu-item-procedure in this-procedure
     1790                       (input v-object-handle
     1791                       ).
     1792                     end triggers.
     1793                 assign
     1794                   v-object-handle :private-data = 'm-i':u
     1795                                                 + chr(44) + string(buf_menu-item.item-code)
     1796                                                 + chr(44) + buf_menu-item.item-procedure
     1797                 .
     1798               end.
     1799               when 'm-t':u
     1800               then do:
     1801                 create menu-item v-object-handle
     1802                 assign
     1803                   label        = buf_menu-item.item-name
     1804                   toggle-box   = yes
     1805                   triggers:
     1806                     on value-changed
     1807                     persistent run run-menu-item-procedure in this-procedure
     1808                       (input v-object-handle
     1809                       ).
     1810                     end triggers.
     1811                 assign
     1812                   v-object-handle :private-data = 'm-t':u
     1813                                                 + chr(44) + string(buf_menu-item.item-code)
     1814                                                 + chr(44) + buf_menu-item.item-procedure
     1815                 .
     1816                 create buf_temp-menu-toggle .
     1817                 assign
     1818                   buf_temp-menu-toggle.item-code   = buf_menu-item.item-code
     1819                   buf_temp-menu-toggle.item-handle = v-object-handle
     1820                 .
     1821                 define variable v-object-value as logical   no-undo .
     1822                 case entry(1, buf_menu-item.item-procedure, chr(44))
     1823                 :
     1824                   when 'int':u
     1825                   then do:
     1826                     run value(entry(2, buf_menu-item.item-procedure, chr(44))) in this-procedure
     1827                       (input 'get':u
     1828                       ,input-output v-object-value
     1829                       ) .
     1830                   end.
     1831                   when 'ext':u
     1832                   then do:
     1833                     run value(entry(2, buf_menu-item.item-procedure, chr(44)))
     1834                       (input 'get':u
     1835                       ,input-output v-object-value
     1836                       ) .
     1837                   end.
     1838                   otherwise do:
     1839                     message
     1840                       vss-workfile vss-revision vss-description skip
     1841                       "Внутренняя ошибка" skip
     1842                       "Неизвестный тип процедуры в пункте меню" skip
     1843                       buf_menu-item.item-procedure skip
     1844                       view-as alert-box error .
     1845                     undo create-menu-item, next create-menu-item .
     1846                   end.
     1847                 end case .
     1848                 assign
     1849                   v-object-handle :checked = v-object-value
     1850                 .
     1851               end.
     1852               otherwise do:
     1853                 message
     1854                   vss-workfile vss-revision vss-description skip
     1855                   "Внутренняя ошибка" skip
     1856                   "Неизвестный тип пункта меню" buf_menu-item.item-type skip
     1857                   view-as alert-box error .
     1858                 undo create-menu-item, next create-menu-item .
     1859               end.
     1860             end case .
     1861             if buf_menu-item.item-type <> 'r-l':U
     1862             then do:
     1863               assign
     1864                 v-object-handle :parent = p-parent-handle
     1865               .
     1866             end.
     1867           end.
     1868           if  p-create-browse         = true
     1869           and buf_menu-item.item-type <> 'r-l':u
     1870           then do:
     1871             run mainmenu-menu-item-create in parparentproc
     1872               (input buf_menu-item.item-code
     1873               ,input buf_menu-item.item-type
     1874               ,input buf_menu-item.item-name
     1875               ,input buf_menu-item.item-id
     1876               ,input buf_menu-item.item-procedure
     1877               ,input buf_menu-item.parent-code
     1878               ,input true
     1879               ) .
     1880           end.
     1881         end.
     1882       end.
     1883     end.
     1884   end procedure.
     1885   procedure run-menu-drop-procedure :
     1886     define input  parameter p-item-handle as widget-handle no-undo .
     1887     define variable v-object-handle  as widget-handle no-undo .
     1888     define variable v-item-data      as character no-undo .
     1889     define variable v-item-type      as character no-undo .
     1890     define variable v-procedure-type as character no-undo .
     1891     define variable v-item-procedure as character no-undo .
     1892     do
     1893     on error undo, return error return-value
     1894     :
     1895       assign
     1896         v-item-data = p-item-handle :private-data
     1897       .
     1898       if v-item-data <> 's-m':u
     1899       then do:
     1900         run proc-create-menu-item in this-procedure
     1901           (input  entry(2, v-item-data, chr(44))
     1902           ,input  p-item-handle
     1903           ,input  true
     1904           ,input  false
     1905           ) .
     1906         assign
     1907           p-item-handle :private-data = 's-m':u
     1908         .
     1909       end.
     1910     end.
     1911   end procedure.
     1912   procedure run-menu-item-procedure :
     1913     define input  parameter p-item-handle as widget-handle no-undo .
     1914     define variable v-item-data           as character no-undo .
     1915     define variable v-item-type           as character no-undo .
     1916     define variable v-item-code           as integer   no-undo .
     1917     define variable v-procedure-type      as character no-undo .
     1918     define variable v-item-procedure      as character no-undo .
     1919     define variable v-procedure-parameter as character no-undo .
     1920     define variable v-cur-date-error-code as integer      no-undo.
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       assign
     1925         v-item-data = p-item-handle :private-data
     1926       .
     1927       if num-entries(v-item-data, chr(44)) < 4
     1928       then do:
     1929         message
     1930           vss-workfile vss-revision vss-description skip
     1931           "Внутренняя ошибка" skip
     1932           "Ошибка при доступе к внутренним данным пункта меню" skip
     1933           "Количество полей менее четырех" skip
     1934           p-item-handle skip
     1935           p-item-handle :private-data skip
     1936           view-as alert-box error .
     1937         undo, return error return-value .
     1938       end.
     1939       assign
     1940         v-item-type      = entry(1, v-item-data, chr(44))
     1941         v-item-code      = integer(entry(2, v-item-data, chr(44)))
     1942         v-procedure-type = entry(3, v-item-data, chr(44))
     1943         v-item-procedure = entry(4, v-item-data, chr(44))
     1944       .
     1945       if num-entries(v-item-data, chr(44)) > 4
     1946       then do:
     1947         assign
     1948           v-procedure-parameter = entry(5, v-item-data, chr(44))
     1949         .
     1950       end.
     1951       else do:
     1952         assign
     1953           v-procedure-parameter = '':u
     1954         .
     1955       end.
     1956       run mainmenu-show-item in parparentproc
     1957         (input  v-item-code
     1958         ) .
     1959       run dm-menu-choose-item in this-procedure
     1960         (input  v-item-type
     1961         ,input  v-item-code
     1962         ,input  v-procedure-type
     1963         ,input  v-item-procedure
     1964         ,input  v-procedure-parameter
     1965         ) .
     1966       run mainmenu-menu-item-open in parparentproc
     1967         (input v-item-code
     1968         ) .
     1969       if v-item-procedure <> 'm_exit-exe':u
     1970       then do:
     1971         run mainmenu-disp-mutable in parparentproc (
     1972               output v-cur-date-error-code
     1973         ).
     1974       end.
     1975     end.
     1976   end procedure.
     1977   procedure dm-menu-choose-item :
     1978     define input  parameter p-item-type           as character no-undo .
     1979     define input  parameter p-item-code           as integer   no-undo .
     1980     define input  parameter p-procedure-type      as character no-undo .
     1981     define input  parameter p-item-procedure      as character no-undo .
     1982     define input  parameter p-procedure-parameter as character no-undo .
     1983     define buffer buf_temp-menu-toggle for temp-menu-toggle .
     1984     do
     1985     on error undo, return error return-value
     1986     :
     1987       if transaction = true
     1988       then do:
     1989         message
     1990           vss-workfile vss-revision vss-description skip
     1991           "Внутренняя ошибка" skip
     1992           "Активна транзакция при запуске пункта меню" skip
     1993           "Работа будет продолжена" skip
     1994           "В случае отката транзакция пропадет вся работа," skip
     1995           "сделанная в пункте меню" skip
     1996           view-as alert-box error .
     1997       end.
     1998       if p-item-procedure <> 'm_exit-exe':u
     1999       then do:
     2000         run mainmenu-start-item in parparentproc
     2001           (input  p-item-code
     2002           ) .
     2003       end.
     2004       define variable v-message as character no-undo .
     2005       case p-item-type :
     2006         when 'm-i':u
     2007         then do:
     2008           run choose-menu-item in parparentproc .
     2009           do
     2010           on error   undo, leave
     2011           on end-key undo, leave
     2012           on stop    undo, leave
     2013           :
     2014             case p-procedure-type :
     2015               when 'int':u
     2016               then do:
     2017                 run run-procedure-int in this-procedure
     2018                   (input p-item-procedure
     2019                   ) no-error .
     2020                 if error-status :error
     2021                 then do:
     2022                   run menu-item-get-error-message in this-procedure
     2023                     (input  p-menu-code
     2024                     ,input  p-item-code
     2025                     ,input  p-item-procedure
     2026                     ,input  error-status :get-message(1)
     2027                     ,input  return-value
     2028                     ,output v-message
     2029                     ) .
     2030                   message
     2031                     "Ошибка при вызове пункта меню" skip
     2032                     v-message skip
     2033                     view-as alert-box error .
     2034                 end.
     2035               end.
     2036               when 'ext':u
     2037               then do:
     2038                 run run-procedure-ext in this-procedure
     2039                   (input p-item-procedure
     2040                   ) no-error .
     2041                 if error-status :error
     2042                 then do:
     2043                   run menu-item-get-error-message in this-procedure
     2044                     (input  p-menu-code
     2045                     ,input  p-item-code
     2046                     ,input  p-item-procedure
     2047                     ,input  error-status :get-message(1)
     2048                     ,input  return-value
     2049                     ,output v-message
     2050                     ) .
     2051                   message
     2052                     "Ошибка при вызове пункта меню" skip
     2053                     v-message skip
     2054                     view-as alert-box error .
     2055                 end.
     2056               end.
     2057               when 'par':u
     2058               then do:
     2059                 run run-procedure-par in this-procedure
     2060                   (input  p-item-procedure
     2061                   ) no-error .
     2062                 if error-status :error
     2063                 then do:
     2064                   run menu-item-get-error-message in this-procedure
     2065                     (input  p-menu-code
     2066                     ,input  p-item-code
     2067                     ,input  p-item-procedure
     2068                     ,input  error-status :get-message(1)
     2069                     ,input  return-value
     2070                     ,output v-message
     2071                     ) .
     2072                   message
     2073                     "Ошибка при вызове пункта меню" skip
     2074                     v-message skip
     2075                     view-as alert-box error .
     2076                 end.
     2077               end.
     2078               when 'str':u
     2079               then do:
     2080                 run run-procedure-str in this-procedure
     2081                   (input  p-item-procedure
     2082                   ,input  str-decode(p-procedure-parameter, '':u)
     2083                   ) no-error .
     2084                 if error-status :error
     2085                 then do:
     2086                   run menu-item-get-error-message in this-procedure
     2087                     (input  p-menu-code
     2088                     ,input  p-item-code
     2089                     ,input  p-item-procedure
     2090                     ,input  error-status :get-message(1)
     2091                     ,input  return-value
     2092                     ,output v-message
     2093                     ) .
     2094                   message
     2095                     "Ошибка при вызове пункта меню" skip
     2096                     v-message skip
     2097                     view-as alert-box error .
     2098                 end.
     2099               end.
     2100               when 'pst':u
     2101               then do:
     2102                 run run-procedure-pst in this-procedure
     2103                   (input  p-item-procedure
     2104                   ,input  str-decode(p-procedure-parameter, '':u)
     2105                   ) no-error .
     2106                 if error-status :error
     2107                 then do:
     2108                   run menu-item-get-error-message in this-procedure
     2109                     (input  p-menu-code
     2110                     ,input  p-item-code
     2111                     ,input  p-item-procedure
     2112                     ,input  error-status :get-message(1)
     2113                     ,input  return-value
     2114                     ,output v-message
     2115                     ) .
     2116                   message
     2117                     "Ошибка при вызове пункта меню" skip
     2118                     v-message skip
     2119                     view-as alert-box error .
     2120                 end.
     2121               end.
     2122               otherwise do:
     2123                 message
     2124                   vss-workfile vss-revision vss-description skip
     2125                   "Внутренняя ошибка" skip
     2126                   "Тип пункта" p-item-type skip
     2127                   "Код пункта меню" p-item-code skip
     2128                   "Неизвестный тип процедуры" p-procedure-type skip
     2129                   "Процедура" p-item-procedure skip
     2130                   view-as alert-box error .
     2131               end.
     2132             end case .
     2133           end.
     2134           run deselect-menu-item in parparentproc .
     2135         end.
     2136         when 'm-t':u
     2137         then do:
     2138           define variable v-item-value       as logical   no-undo .
     2139           define variable v-menu-item-handle as widget-handle no-undo .
     2140           case p-procedure-type
     2141           :
     2142             when 'int':u
     2143             then do:
     2144               run value(p-item-procedure) in this-procedure
     2145                 (input  'get':u
     2146                 ,input-output v-item-value
     2147                 ) .
     2148             end.
     2149             otherwise do:
     2150               message
     2151                 vss-workfile vss-revision vss-description skip
     2152                 "Внутренняя ошибка" skip
     2153                 "Код пункта меню" p-item-code skip
     2154                 "Неизвестный тип процедуры" p-procedure-type skip
     2155                 "Процедура" p-item-procedure skip
     2156                 view-as alert-box error .
     2157             end.
     2158           end case .
     2159           assign
     2160             v-item-value = not v-item-value
     2161           .
     2162           case p-procedure-type
     2163           :
     2164             when 'int':u
     2165             then do:
     2166               run value(p-item-procedure) in this-procedure
     2167                 (input  'set':u
     2168                 ,input-output v-item-value
     2169                 ) .
     2170             end.
     2171             otherwise do:
     2172               message
     2173                 vss-workfile vss-revision vss-description skip
     2174                 "Внутренняя ошибка" skip
     2175                 "Код пункта меню" p-item-code skip
     2176                 "Неизвестный тип процедуры" p-procedure-type skip
     2177                 "Процедура" p-item-procedure skip
     2178                 view-as alert-box error .
     2179             end.
     2180           end case .
     2181           find first buf_temp-menu-toggle
     2182             where buf_temp-menu-toggle.item-code = p-item-code
     2183             no-error .
     2184           if available buf_temp-menu-toggle
     2185           then do:
     2186             assign
     2187               v-menu-item-handle = buf_temp-menu-toggle.item-handle
     2188             .
     2189             assign
     2190               v-menu-item-handle :checked = v-item-value
     2191             .
     2192           end.
     2193           run mainmenu-set-menu-toggle in parparentproc
     2194             (input  p-item-code
     2195             ,input  v-item-value
     2196             ) .
     2197         end.
     2198         otherwise do:
     2199           message
     2200             vss-workfile vss-revision vss-description skip
     2201             "Внутренняя ошибка" skip
     2202             "Неизвестный тип пункта меню" p-item-type skip
     2203             "Код пункта меню" p-item-code skip
     2204             "Тип процедуры" p-procedure-type skip
     2205             "Процедура" p-item-procedure skip
     2206             view-as alert-box error .
     2207           undo, return error return-value .
     2208         end.
     2209       end.
     2210       if p-item-procedure <> 'm_exit-exe':u
     2211       then do:
     2212         run mainmenu-stop-item in parparentproc .
     2213       end.
     2214     end.
     2215   end procedure.
     2216   procedure run-procedure-clear-return-value :
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       return '':U .
     2221     end.
     2222   end procedure.
     2223   procedure run-procedure-int :
     2224     define input  parameter p-item-procedure as character no-undo .
     2225     do
     2226     on error undo, retry
     2227     on end-key undo, retry
     2228     on stop undo, retry
     2229     :
     2230       if retry then do:
     2231         message
     2232           "Ошибка при вызове внутренней процедуры" skip
     2233           "Процедура" p-item-procedure skip
     2234           error-status :get-message(1) skip
     2235           return-value skip
     2236           view-as alert-box error .
     2237         undo, return error return-value .
     2238       end.
     2239       run run-procedure-clear-return-value in this-procedure .
     2240       run value(p-item-procedure) in this-procedure .
     2241     end.
     2242   end procedure.
     2243   procedure run-procedure-ext :
     2244     define input  parameter p-item-procedure as character no-undo .
     2245     do
     2246     on error undo, retry
     2247     on end-key undo, retry
     2248     on stop undo, retry
     2249     :
     2250       if retry then do:
     2251         message
     2252           "Ошибка при вызове внешней процедуры" skip
     2253           "Процедура" p-item-procedure skip
     2254           error-status :get-message(1) skip
     2255           return-value skip
     2256           view-as alert-box error .
     2257         undo, return error return-value .
     2258       end.
     2259       run run-procedure-clear-return-value in this-procedure .
     2260       run value(p-item-procedure) .
     2261     end.
     2262   end procedure.
     2263   procedure run-procedure-par :
     2264     define input  parameter p-item-procedure as character no-undo .
     2265     do
     2266     on error undo, retry
     2267     on end-key undo, retry
     2268     on stop undo, retry
     2269     :
     2270       if retry then do:
     2271         message
     2272           "Ошибка при вызове внешней процедуры с параметром parparentproc" skip
     2273           "Процедура" p-item-procedure skip
     2274           error-status :get-message(1) skip
     2275           return-value skip
     2276           view-as alert-box error .
     2277         undo, return error return-value .
     2278       end.
     2279       run run-procedure-clear-return-value in this-procedure .
     2280       run value(p-item-procedure)
     2281         (input  parparentproc
     2282         ) .
     2283     end.
     2284   end procedure.
     2285   procedure run-procedure-str :
     2286     define input  parameter p-item-procedure      as character no-undo .
     2287     define input  parameter p-procedure-parameter as character no-undo .
     2288     do
     2289     on error undo, retry
     2290     on end-key undo, retry
     2291     on stop undo, retry
     2292     :
     2293       if retry then do:
     2294         message
     2295           "Ошибка при вызове внешней процедуры с параметром строка" skip
     2296           "Процедура" p-item-procedure skip
     2297           "Параметр" p-procedure-parameter skip
     2298           error-status :get-message(1) skip
     2299           return-value skip
     2300           view-as alert-box error .
     2301         undo, return error return-value .
     2302       end.
     2303       run run-procedure-clear-return-value in this-procedure .
     2304       run value(p-item-procedure)
     2305         (input p-procedure-parameter
     2306         ) .
     2307     end.
     2308   end procedure.
     2309   procedure run-procedure-pst :
     2310     define input  parameter p-item-procedure      as character no-undo .
     2311     define input  parameter p-procedure-parameter as character no-undo .
     2312     do
     2313     on error undo, retry
     2314     on end-key undo, retry
     2315     on stop undo, retry
     2316     :
     2317       if retry then do:
     2318         message
     2319           "Ошибка при вызове внешней процедуры с параметрами parparentproc, строка" skip
     2320           "Процедура" p-item-procedure skip
     2321           "Параметр" p-procedure-parameter skip
     2322           error-status :get-message(1) skip
     2323           return-value skip
     2324           view-as alert-box error .
     2325         undo, return error return-value .
     2326       end.
     2327       run run-procedure-clear-return-value in this-procedure .
     2328       run value(p-item-procedure)
     2329         (input  parparentproc
     2330         ,input  p-procedure-parameter
     2331         ) .
     2332     end.
     2333   end procedure.
     2334   procedure menu-item-get-error-message :
     2335     define input  parameter p-menu-code      as integer   no-undo .
     2336     define input  parameter p-item-code      as integer   no-undo .
     2337     define input  parameter p-item-procedure as character no-undo .
     2338     define input  parameter p-error-message  as character no-undo .
     2339     define input  parameter p-return-value   as character no-undo .
     2340     define output parameter v-message        as character no-undo .
     2341     define buffer buf_menu-item for ub.menu-item .
     2342     define variable v-item-id as character no-undo .
     2343     do
     2344     on error undo, return error return-value
     2345     :
     2346       find first buf_menu-item no-lock
     2347         where buf_menu-item.menu-code = p-menu-code
     2348           and buf_menu-item.item-code = p-item-code
     2349         no-error .
     2350       if available buf_menu-item
     2351       then do:
     2352         assign
     2353           v-item-id = buf_menu-item.item-id
     2354         .
     2355       end.
     2356       else do:
     2357         assign
     2358           v-item-id = substitute('код &1':U, p-item-code)
     2359         .
     2360       end.
     2361       assign
     2362         v-message = substitute('Пункт меню &2&1Процедура &3&1&4&1&5  '
     2363                               ,chr(10)
     2364                               ,v-item-id
     2365                               ,p-item-procedure
     2366                               ,p-error-message
     2367                               ,p-return-value
     2368                               )
     2369       .
     2370     end.
     2371   end procedure.
     2372   procedure m_sf-new-exe :
     2373     define variable rid# as recid no-undo.
     2374     do on error undo, return error return-value :
     2375       run str/s-f-docs.w ( input parparentproc, input v-cntxt-host-code-obj, "", ?, ?, ?, ?, ?, ?,  input "new", input-output rid# ).
     2376     end.
     2377   end procedure.
     2378   procedure m_sf-fact-exe :
     2379     define variable rid# as recid no-undo.
     2380     do on error undo, return error return-value :
     2381       run str/s-f-docs.w ( input parparentproc, input v-cntxt-host-code-obj, "", ?, ?, ?, ?, ?, ?,  input "fact", input-output rid# ).
     2382     end.
     2383   end procedure.
     2384   procedure m_sf-all-exe :
     2385     define variable rid# as recid no-undo.
     2386     do on error undo, return error return-value :
     2387       run str/s-f-docs.w ( input parparentproc, input v-cntxt-host-code-obj, "", ?, ?, ?, ?, ?, ?, input "all", input-output rid# ).
     2388     end.
     2389   end procedure.
     2390   procedure m_c-fin-doc-del-exe :
     2391   define variable p-fin-doc-type like ub.fin-doc.fin-doc-type initial "":U no-undo .
     2392   define variable p-status_ like ub.fin-doc.status_ initial "":U no-undo .
     2393   define variable v-rid-list as character no-undo .
     2394   define variable v-mode as character no-undo .
     2395   define variable v-obj-type as character no-undo .
     2396   define variable v-obj-code as integer no-undo .
     2397   if num-entries(p-fin-doc-type, chr(4)) > 1
     2398   and entry(2, p-fin-doc-type, chr(4)) =  'объект':U
     2399   then do:
     2400     v-obj-type = v-cntxt-obj-type.
     2401     v-obj-code = v-cntxt-obj-code.
     2402     assign v-mode =  (if p-fin-doc-type = "":U
     2403                        then 'объект':U
     2404                        else (if p-status_ = "":U
     2405                              then "type-object":U
     2406                              else "type-stat-object":U))
     2407     p-fin-doc-type = entry(1, p-fin-doc-type, chr(4))
     2408     .
     2409   end.
     2410   else do:
     2411     assign v-mode =  (if p-fin-doc-type = "":U
     2412                        then 'фирма':U
     2413                        else (if p-status_ = "":U
     2414                              then "type":U
     2415                              else "type-stat":U))
     2416     .
     2417   end.
     2418     do on error undo, return error return-value :
     2419       run str/fincdocdel.w
     2420                 (input parparentproc
     2421                 ,input v-cntxt-host-code-obj
     2422                 ,input v-mode
     2423                 ,input 'все':U
     2424                 ,input v-cntxt-host-code-obj
     2425                 ,input v-obj-type
     2426                 ,input v-obj-code
     2427                 ,input p-status_
     2428                 ,input p-fin-doc-type
     2429                 ,input "":U
     2430                 ,input ?
     2431                 ,input ?
     2432                 ,input "":U
     2433                 ,input "":U
     2434                 ,input 0
     2435                 ,input "":U
     2436                 ,input "":U
     2437                 ,input 0
     2438                 ,input "":U
     2439                 ,input ?
     2440                 ,input 0
     2441                 ,input 0
     2442                 ,input 0
     2443                 ,input 0
     2444                 ,input 0
     2445                 ,input 0
     2446                 ,input 0
     2447       ).
     2448     end.
     2449   end procedure.
