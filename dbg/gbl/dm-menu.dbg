     5930   PROCEDURE m-chk-list-all-off-exe :
     5931   DEFINE VARIABLE varrid-list as character no-undo .
     5932   define variable v-base-code as integer no-undo init ?.
     5933   define variable v-not-show  as logical no-undo .
     5934   define buffer buf_shop for ub.shop.
     5935   define buffer buf_sysconf for ub.sysconf.
     5936   _shop:
     5937   for each buf_shop no-lock,
     5938       first buf_sysconf no-lock where
     5939             buf_sysconf.host-code = buf_shop.host-code :
     5940     if v-base-code <> ?
     5941     AND buf_sysconf.base-code <> v-base-code then do:
     5942       assign
     5943       v-not-show = yes
     5944       .
     5945       leave _shop.
     5946     end.
     5947     assign
     5948     v-base-code = buf_sysconf.base-code
     5949     .
     5950   end.
     5951   if v-not-show then do:
     5952     message
     5953     "В Вашей системе имеются магазины, принадлежащие фирмам с разными базовыми валютами" skip
     5954     "Просмотр ВСЕХ чеков невозможен"
     5955     view-as alert-box error .
     5956   end.
     5957   else do:
     5958     run proc-chk-docs in this-procedure (input '', input 'все':U).
     5959   end.
     5960   END PROCEDURE.
     5961   procedure m-mrkt-petrol-exe :
     5962     run run-mrkt-gds in this-procedure (input yes).
     5963   END procedure.
     5964   procedure m-mrkt-gds-exe :
     5965     run run-mrkt-gds in this-procedure (input no).
     5966   END procedure.
     5967   procedure run-mrkt-gds:
     5968   define input parameter p-is-petrolium as logical no-undo .
     5969   define variable ri-list as character no-undo .
     5970   define variable v-plu-type as character no-undo .
     5971   define variable dflt-cd as character no-undo .
     5972   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5973   define variable v-param-type31 as character no-undo .
     5974   define variable v-value-date31 as date no-undo .
     5975   define variable v-value-decimal31 as decimal no-undo .
     5976   define variable v-value-integer31 as INTEGER no-undo .
     5977   define variable v-value-logical31 AS LOGICAL no-undo .
     5978   define variable v-tth31 as handle no-undo .
     5979   run adm/shattri.p (
     5980       input "get":U
     5981       ,input  v-cntxt-obj-type
     5982       ,input  v-cntxt-obj-code
     5983       ,input  'cd-sending':U
     5984       ,input  'dflt-cd':U
     5985       ,output dflt-cd
     5986       ,output v-value-date31
     5987       ,output v-value-decimal31
     5988       ,output v-value-integer31
     5989       ,output v-value-logical31
     5990       ,output v-param-type31
     5991       ,INPUT-OUTPUT table-handle v-tth31
     5992       )  .
     5993   delete object v-tth31 no-error.
     5994   IF dflt-cd = 'MARIA':U then do:
     5995     assign
     5996     v-plu-type = (if p-is-petrolium
     5997                      then 'топ':U
     5998                      else '':U).
     5999     run str/mrkt-gds.w (
     6000                    input parparentproc
     6001                   ,input '':U
     6002                   ,input 'объект':U
     6003                   ,input v-cntxt-obj-type
     6004                   ,input v-cntxt-obj-code
     6005                   ,input dflt-cd
     6006                   ,input v-plu-type
     6007                   ,input-output ri-list) no-error .
     6008   end.
     6009   else do:
     6010     message
     6011     substitute("Кассы типа &1 на данном объекте не работают", 'MARIA':U)
     6012     view-as alert-box  ERROR.
     6013   end.
     6014   end procedure.
