      523   procedure thbjattr_code_reg :
      524   define input  parameter p-upper-code     as character no-undo .
      525   define input  parameter p-code           as character no-undo .
      526   define output parameter p-label          as character no-undo .
      527   define output parameter p-user-can-edit  as logical   no-undo .
      528   define output parameter p-output-display as logical   no-undo .
      529   define output parameter p-other          as character no-undo .
      530   define output parameter p-prop-list      as character no-undo .
      531   define output parameter p-prop-type-list as character no-undo .
      532   define output parameter p-prop-label-list as character no-undo .
      533   define output parameter p-global          as logical no-undo .
      534   define output parameter p-host           as logical no-undo .
      535   define output parameter p-shop           as logical no-undo .
      536   define output parameter p-store          as logical no-undo .
      537   define output parameter p-db             as logical no-undo .
      538   define output parameter p-region         as logical no-undo .
      539   do
      540   on error undo, return error return-value
      541   :
      542       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      543       (input  p-upper-code
      544       ,input  p-code
      545       ,output p-label
      546       ,output p-user-can-edit
      547       ,output p-output-display
      548       ,output p-other
      549       ,output p-prop-list
      550       ,output p-prop-type-list
      551       ,output p-prop-label-list
      552       ,output p-global
      553       ,output p-host
