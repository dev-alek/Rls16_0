     9055     define input  parameter p-action as character no-undo .
     9056     define input-output parameter p-value as logical   no-undo .
     9057     define variable v-checked as logical   no-undo .
     9058     do
     9059     on error undo, return error return-value
     9060     :
     9061       case p-action :
     9062         when 'set':u
     9063         then do:
     9064           run set-bc-price in parparentproc
     9065             (input  p-value
     9066             ) .
     9067         end.
     9068         when 'get':u
     9069         then do:
     9070           run get-bc-price in parparentproc
     9071             (output p-value
     9072             ) .
     9073         end.
     9074       end.
     9075     end.
     9076   end procedure.
