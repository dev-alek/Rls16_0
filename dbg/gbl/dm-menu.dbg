     5425   FUNCTION BinaryXOR RETURNS INT64(INPUT intOperand1 AS INT64,
     5426                                    INPUT intOperand2 AS INT64)
     5427                                    forward .
     5428   FUNCTION ShiftRight RETURNS INT64(INPUT in_Operand_A AS INT64,
     5429                                     INPUT in_Operand_B AS INTEGER)
     5430                                     forward .
     5431   FUNCTION BinaryAND RETURNS INTEGER (INPUT in_Operand_A AS INT64,
     5432                                       INPUT in_Operand_B AS INT64)
     5433                                       forward .
     5434   FUNCTION intToHex RETURNS CHARACTER (i_iint AS INT64) forward .
     5435   FUNCTION crc32Table RETURNS INT64 EXTENT 256  () forward .
     5436   FUNCTION CRC32 RETURNS INT64 (INPUT mpData AS MEMPTR) forward .
     5437   FUNCTION BinaryXOR RETURNS INT64
     5438   (INPUT intOperand1 AS INT64,
     5439    INPUT intOperand2 AS INT64):
     5440       DEFINE VARIABLE iByteLoop  AS INTEGER NO-UNDO.
     5441       DEFINE VARIABLE iXOResult  AS INT64 NO-UNDO.
     5442       DEFINE VARIABLE lFirstBit  AS LOGICAL NO-UNDO.
     5443       DEFINE VARIABLE lSecondBit AS LOGICAL NO-UNDO.
     5444       iXOResult = 0.
     5445       DO iByteLoop = 1 TO 64:
     5446           ASSIGN
     5447           lFirstBit  = LOGICAL(GET-BITS(intOperand1,iByteLoop  ,1))
     5448           lSecondBit = LOGICAL(GET-BITS(intOperand2,iByteLoop , 1)).
     5449           IF (lFirstBit  AND NOT lSecondBit) OR
     5450              (lSecondBit AND NOT lFirstBit) THEN
     5451               iXOResult = iXOResult + EXP(2, iByteLoop - 1).
     5452       END.
     5453       RETURN iXOResult.
     5454   END .
     5455   FUNCTION ShiftRight RETURNS INT64
     5456   (INPUT in_Operand_A AS INT64,
     5457    INPUT in_Operand_B AS INTEGER):
     5458      RETURN INT64( TRUNCATE( in_Operand_A / EXP(2,in_Operand_B), 0 ) ).
     5459   END .
     5460   FUNCTION BinaryAND RETURNS INTEGER
     5461   (INPUT in_Operand_A AS INT64,
     5462    INPUT in_Operand_B AS INT64):
     5463      DEFINE VARIABLE in_cbit     AS INTEGER     NO-UNDO.
     5464      DEFINE VARIABLE in_result   AS INT64     NO-UNDO.
     5465      DO in_cbit = 1 TO 64:
     5466         IF LOGICAL( GET-BITS( in_Operand_A, in_cbit, 1 ) ) AND
     5467            LOGICAL( GET-BITS( in_Operand_B, in_cbit, 1 ) )
     5468         THEN
     5469            PUT-BITS( in_result, in_cbit, 1 ) = 1.
     5470     END.
     5471     RETURN in_result.
     5472   END .
     5473   FUNCTION intToHex RETURNS CHARACTER
     5474   (i_iint AS INT64):
     5475      DEF VAR chex  AS CHAR NO-UNDO.
     5476      DEF VAR rbyte AS RAW  NO-UNDO.
     5477      DO WHILE i_iint > 0:
     5478         PUT-BYTE( rbyte, 1 ) = i_iint MODULO 256.
     5479         chex = STRING( HEX-ENCODE( rbyte ) ) + chex.
     5480         i_iint = TRUNCATE( i_iint / 256, 0 ).
     5481      END.
     5482      RETURN chex.
     5483   END .
