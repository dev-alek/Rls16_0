      505      run thbjattr_code_reg in this-procedure (
      506                                               p-upper-code,
      507                                               p-code,
      508                                               output p-label,
      509                                               output p-user-can-edit,
      510                                               output p-output-display,
      511                                               output p-other,
      512                                               output p-prop-list,
      513                                               output p-prop-type-list,
      514                                               output p-prop-label-list,
      515                                               output p-global,
      516                                               output p-host,
      517                                               output p-shop,
      518                                               output p-store,
      519                                               output p-db,
      520                                               output p-region
      521                                               ).
