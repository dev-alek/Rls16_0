     1032   procedure cd-attr-tooltip :
     1033     define input  parameter p-ucode   as character no-undo .
     1034     define input  parameter p-code    as character no-undo .
     1035     define output parameter p-tooltip as character no-undo .
     1036     define output parameter p-label   as character no-undo .
     1037     do
