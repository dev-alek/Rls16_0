     6060   PROCEDURE obj-sale-exe :
     6061     define variable rid-list    as character no-undo .
     6062     define variable v-host-code as integer   no-undo .
     6063     do
     6064     on error undo, return error return-value
     6065     :
     6066       if v-cntxt-obj-type = 'маг':U
     6067       then do:
     6068   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6069   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6070     (input  v-cntxt-obj-type
     6071     ,input  v-cntxt-obj-code
     6072     ,output v-host-code
     6073     )  .
     6074         run str/salelist.w
     6075           (input  parparentproc
     6076           ,input  "b-export":U
     6077           ,input  'объект':U
     6078           ,input  v-host-code
     6079           ,input  v-cntxt-obj-type
     6080           ,input  v-cntxt-obj-code
     6081           ,input-output rid-list
     6082           ) no-error.
     6083       end.
