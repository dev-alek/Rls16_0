     6086   PROCEDURE del-sale-exe :
     6087   define variable rid-list    as character no-undo .
     6088   define variable v-host-code as integer   no-undo .
     6089   define variable v-obj-type as character no-undo .
     6090   define variable v-obj-code as integer no-undo .
     6091   define variable v-mode as character no-undo .
     6092   do
     6093   on error undo, return error return-value
     6094   :
     6095     if v-cntxt-obj-type = 'маг':U
     6096     and v-cntxt-level = 'object':U
     6097     then do:
     6098   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6100     (input  v-cntxt-obj-type
     6101     ,input  v-cntxt-obj-code
     6102     ,output v-host-code
     6103     )  .
     6104       assign
     6105       v-mode = 'удаленные':U + chr(44) + 'объект':U
     6106       v-obj-type = v-cntxt-obj-type
     6107       v-obj-code = v-cntxt-obj-code
     6108       .
     6109     end.
     6110     if v-cntxt-level = 'firm':U
     6111     then do:
     6112       assign
     6113       v-mode = 'удаленные':U + chr(44) + 'фирма':U
     6114       v-host-code = v-cntxt-host-code-obj
     6115       v-obj-type = '':U
     6116       v-obj-code = 0
     6117       .
     6118     end.
     6119     if v-cntxt-level = 'global':U
     6120     then do:
     6121       assign
     6122       v-mode = 'удаленные':U
     6123       v-host-code = 0
     6124       v-obj-type = '':U
     6125       v-obj-code = 0
     6126       .
     6127     end.
     6128     run str/salclist.w
     6129       (input  parparentproc
     6130       ,input  "":U
     6131       ,input  v-mode
