    11134   procedure chk-bgefmt-is-analythic :
    11135     define output parameter p-enable-item as logical   no-undo .
    11136     define variable v-bgefmt      as character    no-undo.
    11137     define variable v-param-type      as character  no-undo .
    11138     define variable v-value-character as character  no-undo .
    11139     define variable v-value-date      as date       no-undo .
    11140     define variable v-value-decimal   as decimal    no-undo .
    11141     define variable v-value-integer   as integer    no-undo .
    11142     define variable v-value-logical   as logical    no-undo .
    11143     define variable v-tth             as handle     no-undo .
    11144     do
    11145     on error undo, return error return-value
    11146     :
    11147       run adm/shattri.p ( input "get":U
    11148                         , input  '':u
    11149                         , input  0
    11150                         , input  'bge-export':U
    11151                         , input  'bgefmt':U
    11152                         , output v-value-character
    11153                         , output v-value-date
    11154                         , output v-value-decimal
    11155                         , output v-value-integer
    11156                         , output v-value-logical
    11157                         , output v-param-type
    11158                         , input-output table-handle v-tth
    11159                         ) no-error .
    11160       if error-status :error
    11161       then do:
    11162         assign
    11163           p-enable-item = false
    11164         .
    11165       end.
    11166       else do:
    11167         assign
    11168           v-bgefmt = v-value-character
    11169         .
    11170         if v-bgefmt = 'analythic':u
    11171         then do:
    11172             assign
    11173                 p-enable-item = true
    11174             .
    11175         end.
    11176         else do:
    11177             assign
    11178                 p-enable-item = false
    11179             .
