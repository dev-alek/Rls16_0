     5769   procedure m-gds-ef-exe :
     5770   define variable v-rid-list as character no-undo .
     5771     do
     5772     on error undo, return error
     5773     :
     5774         define variable v-row as rowid no-undo .
     5775         define buffer buf_PromoAction for ub.PromoAction .
     5776         define variable v-PromoName as character no-undo .
     5777       if v-cntxt-db-num = 0 then
     5778       do:
     5779         for each buf_PromoAction exclusive-lock where buf_PromoAction.Status_ = 1 and
     5780           (buf_PromoAction.end-date < today or (buf_PromoAction.changeDate < today and
     5781           buf_PromoAction.changeDate <> 01/01/1970)):
     5782           buf_PromoAction.Status_ = 2 .
     5783           v-PromoName = v-PromoName + chr(10) + buf_PromoAction.nameAction .
     5784         end.
     5785         if v-PromoName <> "" then
     5786         do:
     5787           message "Статус был изменен на Заблокирован для акций:" skip
     5788             skip
     5789             v-PromoName
     5790             view-as alert-box.
     5791         end.
     5792       end.
     5793       run ref/promo.p ( input parparentproc, input false, output v-rid-list) no-error.
     5794     end.
     5795   end procedure.
