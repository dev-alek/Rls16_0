     8754       if error-status :error
     8755       then do:
     8756         if error-status :get-message(1) <> '':U
     8757         then do:
     8758           message
     8759             vss-workfile vss-revision vss-description skip
     8760             "Ошибка при смене объекта процедура trigger-select-context" skip
     8761             error-status :get-message(1) skip
     8762             return-value skip
     8763             view-as alert-box error .
     8764           undo, return error return-value .
     8765         end.
     8766       end.
     8767     end.
     8768   end procedure.
