    13054   PROCEDURE image-procedure-twotpl :
    13055     do
    13056     on error undo, return error return-value
    13057     :
    13058   define variable v-rec-list as character no-undo .
    13059   define variable l-exist-twotpl as logical   no-undo .
    13060   define variable v-str as character no-undo .
    13061   define buffer buf1_price-list-type for ub.price-list-type  .
    13062   define buffer buf2_price-list-type for ub.price-list-type  .
    13063   define buffer buf_BatchProcess  for ub.BatchProcess  .
    13064   define buffer exec_batchprocess for ub.BatchProcess  .
    13065      find first buf_BatchProcess no-lock
    13066           where buf_BatchProcess.bp_type       = 'twotpl':U
    13067             and buf_BatchProcess.bp_status     = 'N':U
    13068                 no-error   .
    13069       if available buf_BatchProcess
    13070       then do:
    13071            find first buf1_price-list-type no-lock where
    13072                 recid(buf1_price-list-type) = int(buf_BatchProcess.CharKey_One) no-error .
    13073            find first buf2_price-list-type no-lock where
    13074                 recid(buf2_price-list-type) = int(buf_BatchProcess.CharKey_Two) no-error .
    13075           if available buf2_price-list-type and available buf1_price-list-type then
    13076              v-str = substitute("ТПЛ &1(&2) &3  и  ТПЛ &4(&5) &6 с приоритетом &7" ,
    13077                       buf1_price-list-type.plt-id ,
    13078                       buf1_price-list-type.plt-db-num,
    13079                       buf1_price-list-type.name ,
    13080                       buf2_price-list-type.plt-id ,
    13081                       buf2_price-list-type.plt-db-num,
    13082                       buf2_price-list-type.name ,
    13083                       buf2_price-list-type.priority ) .
    13084              else v-str = "" .
    13085           v-rec-list = buf_BatchProcess.CharKey_One + ',' + buf_BatchProcess.CharKey_Two .
    13086           run ref/typepric.w (parparentproc , "b-add,b-del,b-chg,mode=twotpl" , input-output v-rec-list ) no-error .
    13087           if error-status :error
    13088           then do:
    13089             message
    13090               vss-workfile vss-revision vss-description skip
    13091               "Ошибка при вызове процедуры" 'ref/typepric.w':U skip
    13092               error-status :get-message(1) skip
    13093               return-value skip
    13094               view-as alert-box error .
    13095           end.
    13096         message
    13097           "Сообщать о двойниках в дальнейшем " skip
    13098            v-str
    13099            '?'
    13100           view-as alert-box question
    13101           buttons yes-no
    13102           update v-ok as log
    13103           .
    13104           if v-ok = false then do:
    13105     find first exec_batchprocess exclusive-lock
    13106       where rowid(exec_batchprocess) = rowid(buf_batchprocess)
    13107       no-error .
    13108     if not available exec_batchprocess then do:
    13109       message
    13110         vss-workfile vss-revision vss-description skip
    13111         "Не найдена запись пересчета архива" skip
    13112         view-as alert-box error .
    13113       undo, return error .
    13114     end.
    13115     if exec_batchprocess.bp_status <> 'N':U then do:
    13116       message
    13117         vss-workfile vss-revision vss-description skip
    13118         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
    13119         "BP_Type"       exec_batchprocess.BP_Type       skip
    13120         "BP_Status"     exec_batchprocess.BP_Status     skip
    13121         "Key#_One"      exec_batchprocess.Key#_One      skip
    13122         "Key#_Two"      exec_batchprocess.Key#_Two      skip
    13123         "Key#_Three"    exec_batchprocess.Key#_Three    skip
    13124         "CharKey_One"   exec_batchprocess.CharKey_One   skip
    13125         "CharKey_Two"   exec_batchprocess.CharKey_Two   skip
    13126         "CharKey_Three" exec_batchprocess.CharKey_Three skip
    13127         view-as alert-box error .
    13128       undo, return error .
    13129     end.
    13130       define variable v-btpr_upd-today-86 as date      no-undo.
    13131     define variable v-btpr_upd-time-86  as integer   no-undo.
    13132     run cur-time in this-procedure ( output v-btpr_upd-today-86
    13133                                    , output v-btpr_upd-time-86
    13134                                    ).
    13135     assign
    13136       exec_batchprocess.bp_status         = 'D':U
    13137       exec_batchprocess.bp_execcounttries = exec_batchprocess.bp_execcounttries + 1
    13138       exec_batchprocess.bp_execuser_id    = v-cntxt-userid
    13139       exec_batchprocess.bp_execsysdate    = v-btpr_upd-today-86
    13140       exec_batchprocess.bp_execsystime    = string(v-btpr_upd-time-86, 'hh:mm')
    13141       exec_batchprocess.bp_execsystimeint = v-btpr_upd-time-86
    13142     .
    13143         end.
    13144       end.
    13145       else do:
    13146            message 'НОВЫЕ Двойники по приоритету в ТПЛ не обнаружены !' view-as alert-box information .
    13147       end.
    13148     run image-display-twotpl in parparentproc .
    13149     end.
    13150   END PROCEDURE.
    13151   procedure chk-is-adoc-nn :
    13152     define output parameter p-enable-item as logical   no-undo .
    13153     define variable v-edoc-nn as character no-undo .
    13154     define variable par-type as character no-undo .
    13155     do
    13156     on error undo, return error return-value
    13157     :
    13158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    13159     (input  'edoc-nn':u
    13160     ,input  '':u
    13161     ,input  '':u
    13162     ,input  0
    13163     ,input  '':u
    13164     ,input  '':u
    13165     ,input  '':u
    13166     ,input  no
    13167     ,output v-edoc-nn
    13168     ,output par-type
    13169     ) no-error .
    13170       if error-status :error
    13171       then do:
    13172           assign
    13173             p-enable-item = false
    13174           .
    13175         return .
    13176       end.
    13177       if v-edoc-nn = 'yes':u
    13178       then do:
    13179         assign
    13180           p-enable-item = true
    13181         .
    13182       end.
    13183       else do:
    13184           assign
    13185             p-enable-item = false
    13186           .
    13187       end.
    13188     end.
    13189   end procedure.
