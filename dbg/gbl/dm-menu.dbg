     4777   procedure m-taxes-exe :
     4778     define variable v-host-code as integer   no-undo .
     4779     define variable ri-list     as character no-undo .
     4780     do
     4781     on error undo, return error return-value
     4782     :
     4783       case v-cntxt-level:
     4784         WHEN 'object':U
     4785         THEN DO:
     4786   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4788     (input  v-cntxt-obj-type
     4789     ,input  v-cntxt-obj-code
     4790     ,output v-host-code
     4791     )  .
     4792            run ref/tax-tree.w
     4793               (input  parparentproc
     4794               ,input  ''
     4795               ,input  'ALL':U
     4796               ,input  v-host-code
     4797               ,input  v-cntxt-obj-type
     4798               ,input  v-cntxt-obj-code
     4799               ,input  ?
     4800               ,input-output ri-list
     4801               ) .
     4802         END.
     4803         WHEN 'firm':U
     4804         THEN DO:
     4805            run ref/tax-tree.w
     4806               (input  parparentproc
     4807               ,input  ''
     4808               ,input  'ALL':U
     4809               ,input  v-cntxt-host-code-obj
     4810               ,input  "":U
     4811               ,input  0
     4812               ,input  ?
     4813               ,input-output ri-list
     4814               ) .
     4815         END.
     4816         OTHERWISE DO:
     4817            run ref/tax-tree.w
     4818               (input  parparentproc
     4819               ,input  ''
     4820               ,input  'ALL':U
     4821               ,input  0
     4822               ,input  ''
     4823               ,input  0
     4824               ,input  ?
     4825               ,input-output ri-list
     4826               ) .
     4827         END.
     4828       END CASE.
     4829     end.
     4830   end procedure.
