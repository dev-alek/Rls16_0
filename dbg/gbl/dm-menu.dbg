    12287     do
    12288     on error undo, return error return-value
    12289     :
    12290        p-enable-item = false  .
    12291       find last buf_global-state no-lock  no-error .
    12292       if error-status :error then do:
    12293          return .
    12294       end.
    12295       if buf_global-state.pl-use-qnty-group  = true  then do:
    12296          p-enable-item = true .
    12297       end.
    12298     end.
    12299   end procedure.
    12300   procedure chk-ukr-ptrl :
    12301     define output parameter p-enable-item as logical no-undo initial no.
    12302     define variable is_OK      as logical   no-undo.
    12303     do on error undo, return error return-value :
    12304       run chk-is-ptrl in this-procedure ( output is_OK ) no-error.
    12305       if error-status :error or is_OK <> yes then do: undo, return error return-value. end.
    12306       if "RUS":U = "UKR":U  then do: assign p-enable-item = yes. end.
    12307     end.
    12308   end procedure.
