     5520           0x72076785, 0x05005713, 0x95BF4A82, 0xE2B87A14, 0x7BB12BAE, 0x0CB61B38,
     5521           0x92D28E9B, 0xE5D5BE0D, 0x7CDCEFB7, 0x0BDBDF21, 0x86D3D2D4, 0xF1D4E242,
     5522           0x68DDB3F8, 0x1FDA836E, 0x81BE16CD, 0xF6B9265B, 0x6FB077E1, 0x18B74777,
     5523           0x88085AE6, 0xFF0F6A70, 0x66063BCA, 0x11010B5C, 0x8F659EFF, 0xF862AE69,
     5524           0x616BFFD3, 0x166CCF45, 0xA00AE278, 0xD70DD2EE, 0x4E048354, 0x3903B3C2,
     5525           0xA7672661, 0xD06016F7, 0x4969474D, 0x3E6E77DB, 0xAED16A4A, 0xD9D65ADC,
     5526           0x40DF0B66, 0x37D83BF0, 0xA9BCAE53, 0xDEBB9EC5, 0x47B2CF7F, 0x30B5FFE9,
     5527           0xBDBDF21C, 0xCABAC28A, 0x53B39330, 0x24B4A3A6, 0xBAD03605, 0xCDD70693,
     5528           0x54DE5729, 0x23D967BF, 0xB3667A2E, 0xC4614AB8, 0x5D681B02, 0x2A6F2B94,
     5529           0xB40BBE37, 0xC30C8EA1, 0x5A05DF1B, 0x2D02EF8D].
     5530       RETURN crc32_tab.
     5531   END .
     5532   FUNCTION CRC32 RETURNS INT64
     5533   (INPUT mpData AS MEMPTR):
     5534       DEFINE VARIABLE IN_BYtes_Size   AS INTEGER   NO-UNDO.
     5535       DEFINE VARIABLE in_byte         AS INTEGER   NO-UNDO.
     5536       DEFINE VARIABLE crc_value       AS INT64     NO-UNDO.
     5537       DEFINE VARIABLE tmp             AS INT64     NO-UNDO.
     5538       DEFINE VARIABLE crc32_tab       AS INT64     NO-UNDO EXTENT 256.
     5539       DEFINE VARIABLE in_loop         AS INTEGER     NO-UNDO.
     5540       crc32_tab = crc32Table().
     5541       crc_value = 0xffffffff.
     5542       In_Bytes_Size = GET-SIZE(mpData).
     5543       DO in_loop = 1 TO In_Bytes_Size:
     5544           tmp = BinaryXOR(crc_value, GET-BYTE(mpData,in_loop )).
     5545           crc_value = BinaryXOR( ShiftRight(crc_value, 8), crc32_tab[BinaryAND(tmp,0x00ff) + 1 ] ).
     5546       END.
     5547       crc_value = BinaryXOR(crc_value, 0xffffffff).
     5548       RETURN crc_value.
     5549   END .
     5550   define temp-table tt-code like code.
     5551   function getCashparamHash returns character ():
     5552       define variable exp as ibs.th.bge.xmlimpexp no-undo.
     5553       define variable hQuery   as handle  no-undo .
     5554       define buffer Buf_code for tt-code.
     5555       define buffer     code for    code.
     5556       FOR EACH code where code.parent begins 'cash-param'
     5557                       and num-entries(code.parent,chr(4)) eq 4
     5558       no-lock:
     5559          create Buf_code.
     5560          buffer-copy code except export_ nwsgbd procview procedit to Buf_code.
     5561       end.
     5562       create query hQuery.
     5563       hQuery:set-buffers(buffer Buf_code :HANDLE).
     5564       hQuery:query-prepare("FOR EACH Buf_code").
     5565       hQuery:query-open ().
     5566       exp = new ibs.th.bge.xmlimpexp ().
     5567       exp:updatetableforxml(hQuery).
     5568       delete object hQuery.
     5569       FOR EACH buf_code:
     5570          delete buf_code.
     5571       end.
     5572       define variable vxmlCode as character  no-undo.
     5573       define variable v-md5-signature as character no-undo.
     5574       exp:xmldom-save  ( "cashparammd5.xml" ).
     5575       vxmlCode = search("cashparammd5.xml").
     5576       run gbl/md5.p (
     5577             input  vxmlCode
     5578            ,output v-md5-signature
     5579            ) .
     5580       os-delete value (vxmlCode).
     5581       delete object exp.
     5582       return encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
     5583     .
     5584   end.
     5585   function getCashParamHashDb returns character (idb as int):
     5586      define buffer code for ub.code.
     5587      find first code where code.parent eq "CashParamHash"
     5588                        and code.code   eq  string(idb)
     5589      no-lock no-error.
     5590      return if available code then Code.CodeValue else ?.
     5591   end.
     5592   procedure saveCashParHash:
     5593      define input  parameter iDb as integer no-undo.
     5594      define buffer code for ub.code.
     5595      find first code where code.parent eq ""
     5596                        and code.code   eq "CashParamHash"
     5597      no-lock no-error.
     5598      if not available code
     5599      then do:
     5600         create code.
     5601         assign
     5602            Code.parent   = ""
     5603            Code.code     = "CashParamHash"
     5604            Code.CodeName = "Конрольная сумма Эталонных параметров для кассы"
     5605         .
     5606      end.
     5607      find first code where code.parent eq "CashParamHash"
     5608                        and code.code   eq  string(idb)
     5609      exclusive-lock no-error.
     5610      if not available code
     5611      then do:
     5612         create Code.
     5613         assign
     5614            code.parent = "CashParamHash"
     5615            code.code   =  string(idb)
     5616            Code.nwsubd = yes
     5617         .
     5618      end.
     5619      Code.CodeName  = string(now).
     5620      Code.CodeValue = getCashparamHash().
     5621   end.
     5622   procedure m-cash-param-exe :
     5623      define variable v-current-db-num as integer   no-undo .
     5624      def var vlist as char no-undo.
     5625   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5626   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5627     (output v-current-db-num
     5628     )  .
     5629      if v-current-db-num ne 0
     5630      then
     5631         run saveCashParHash(v-current-db-num).
     5632      vList = "cashp1,cashp2".
     5633      if vList ne ""
     5634      then do:
     5635         run str/diallog.w (
     5636           input parparentproc
     5637         , input this-procedure
     5638         , input "str/send-all.p":U
     5639         , input ( v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + 'U':U + chr(4) + vList + chr(4) + 'Получение параметров кассы':U + chr(4) + "cash-send=all,SocetLog=cashparam.log")
     5640         , input ?
     5641         , input "":U
     5642         , input substitute("Получение параметров кассы")
     5643         ) no-error.
