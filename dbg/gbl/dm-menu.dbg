    12750   PROCEDURE image-procedure-in-ov :
    12751     do
    12752     on error undo, return error return-value
    12753     :
    12754       message
    12755         "Переоценка после прихода. Функция вызывается через меню."
    12756         view-as alert-box.
    12757     end.
    12758   END PROCEDURE.
    12759   PROCEDURE image-procedure-cd :
    12760     do
    12761     on error undo, return error return-value
    12762     :
    12763       run str/cd-inf.p
    12764         (input parparentproc
    12765         ,input no
    12766         ,input yes
    12767         ) no-error .
    12768       if error-status :error
    12769       then do:
    12770         message
    12771           vss-workfile vss-revision vss-description skip
    12772           "Ошибка при вызове процедуры" 'str/cd-inf.p':U skip
    12773           error-status :get-message(1) skip
    12774           return-value skip
    12775           view-as alert-box error .
    12776       end.
    12777       run image-display-cd in parparentproc .
    12778     end.
    12779   END PROCEDURE.
    12780   PROCEDURE image-procedure-scales :
    12781     do
    12782     on error undo, return error return-value
    12783     :
    12784       run str/diallog.w
    12785         ( input parparentproc
    12786         , input this-procedure
    12787         , input "ref/sendscal.p":U
    12788         , input (v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + chr(63) + chr(4) +
    12789                  "changed":U + chr(4) + '':U + chr(4) + "current":U + chr(4) +
    12790                  string(0))
    12791         , input no
    12792         , input "":U
    12793         , input substitute("Отсылка изменений на весы")
    12794         ) no-error.
    12795       if error-status :error
    12796       then do:
    12797         message
    12798           vss-workfile vss-revision vss-description skip
    12799           "Ошибка при вызове процедуры" 'ref/sendscal.p':U skip
    12800           error-status :get-message(1) skip
    12801           return-value skip
    12802           view-as alert-box error .
    12803       end.
    12804       run image-display-scales in parparentproc .
    12805     end.
    12806   END PROCEDURE.
    12807   PROCEDURE image-procedure-curses :
    12808     do
    12809     on error undo, return error return-value
    12810     :
    12811       run str/diallog.w
    12812         ( input parparentproc
    12813         , input this-procedure
    12814         , input "str/send-cur.p":U
    12815         , input (v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + "U")
    12816         , input no
    12817         , input "":U
    12818         , input substitute("Отсылка данных по курсам валют на кассы")
