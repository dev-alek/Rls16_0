    12230   procedure chk-group-buyer-price :
    12231     define output parameter p-enable-item as logical   no-undo .
    12232     define buffer buf_global-state for ub.global-state  .
    12233     do
    12234     on error undo, return error return-value
    12235     :
    12236       assign
    12237         p-enable-item = false
    12238       .
    12239       find last buf_global-state no-lock  no-error .
    12240       if error-status :error
    12241       then do:
    12242         return .
    12243       end.
    12244       if buf_global-state.pl-use-grp-buy  = true
    12245       then do:
    12246         assign
    12247           p-enable-item = true
    12248         .
    12249       end.
    12250     end.
    12251   end procedure.
