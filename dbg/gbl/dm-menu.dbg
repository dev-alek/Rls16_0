    13323   procedure chk-is-pharm :
    13324     define output parameter p-enable-item as logical   no-undo .
    13325     define variable v-is-pharm  as character no-undo .
    13326     define variable par-type   as character no-undo .
    13327     do
    13328     on error undo, return error return-value
    13329     :
    13330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    13331     (input  'is-pharm'
    13332     ,input  '':u
    13333     ,input  '':u
    13334     ,input  0
    13335     ,input  '':u
    13336     ,input  '':u
    13337     ,input  '':u
    13338     ,input  no
    13339     ,output v-is-pharm
    13340     ,output par-type
    13341     ) no-error .
    13342       if lookup( v-is-pharm, "yes,no" ) = 0
    13343       or v-is-pharm = ?
    13344       or par-type <> 'L':U
    13345       or error-status :error
    13346       then do:
    13347         assign
    13348           v-is-pharm = "no"
    13349         .
    13350       end.
    13351       if v-is-pharm = 'no':u
    13352       then do:
    13353         assign
    13354           p-enable-item = false
    13355         .
    13356       end.
    13357       else do:
    13358         assign
    13359           p-enable-item = true
    13360         .
    13361       end.
    13362     end.
    13363   end procedure.
    13364   PROCEDURE image-procedure-pharm :
    13365   END PROCEDURE.
    13366   PROCEDURE image-procedure-petrol :
    13367   END PROCEDURE.
    13368   PROCEDURE image-procedure-pr-fin :
    13369     do
    13370     on error undo, return error return-value:
    13371        run str/fi-liab1.p (input parparentproc , input 14 , v-cntxt-host-code-obj) .
    13372     end.
    13373   END PROCEDURE.
    13374   procedure promosend :
    13375   define input parameter p-pos-type as character no-undo .
    13376   define input parameter p-action as character no-undo .
    13377    run str/diallog.w (
    13378           input parparentproc
    13379         , input this-procedure
    13380         , input "str/promosend.p":U
    13381         , input (p-pos-type + chr(4) + v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + p-action + chr(4) + "")
    13382         , input no
    13383         , input "":U
    13384         , input substitute("Отсылка промоакций на кассы &1", p-pos-type, 'IBM-XML':U)
    13385     ) no-error.
    13386   end procedure.
