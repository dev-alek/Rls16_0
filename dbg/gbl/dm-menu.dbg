     1401   function cd-attr_get-attr-int returns integer
     1402   (buffer buf_cash-desk for ub.cash-desk
     1403   ,input p-upper-attr-code as character
     1404   ,input p-attr-code as character
     1405   ,output p-mes as character
     1406   ):
     1407     define variable v-return-value as integer   no-undo .
     1408       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr_get-attr-int-proc in g#attr-lib
     1409       (buffer buf_cash-desk
     1410       ,input  p-upper-attr-code
     1411       ,input  p-attr-code
     1412       ,output p-mes
     1413       ,output v-return-value
     1414       ) no-error .
     1415     if error-status :error
     1416     then do:
     1417       assign
     1418         p-mes = substitute("Неизвестная ошибка при вызове процедуры cd-attr_get-attr-int-proc &1 &2"
     1419                           ,error-status :get-message(1)
     1420                           ,return-value
     1421                           )
     1422       .
     1423       return ? .
     1424     end.
     1425     return v-return-value .
     1426   end function.
     1427   function cd-attr_get-attr-log returns logical
     1428   (buffer buf_cash-desk for ub.cash-desk
     1429   ,input p-upper-attr-code as character
     1430   ,input p-attr-code as character
     1431   ,output p-mes as character
     1432   ):
     1433     define variable v-return-value as logical   no-undo .
     1434       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr_get-attr-log-proc in g#attr-lib
     1435       (buffer buf_cash-desk
     1436       ,input  p-upper-attr-code
     1437       ,input  p-attr-code
     1438       ,output p-mes
     1439       ,output v-return-value
     1440       ) no-error .
     1441     if error-status :error
     1442     then do:
     1443       assign
     1444         p-mes = substitute("Неизвестная ошибка при вызове процедуры cd-attr_get-attr-log-proc &1 &2"
     1445                           ,error-status :get-message(1)
     1446                           ,return-value
     1447                           )
     1448       .
     1449       return ? .
     1450     end.
     1451     return v-return-value .
     1452   end function.
     1453   procedure cd-attr_check-marketer :
     1454     define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     1455     define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     1456     define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     1457     define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     1458     define input parameter p-ucode     like ub.cash-desk-attr.upper-attr-code  no-undo .
     1459     define input parameter p-code     like ub.cash-desk-attr.attr-code  no-undo .
     1460     define input parameter p-value as character no-undo .
     1461     define input parameter p-mode  as character no-undo .
     1462     define output parameter p-correct     as logical no-undo .
     1463     define output parameter p-error-code  as character no-undo .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr_check-marketer in g#attr-lib
     1468         (input  p-db-num
     1469         ,input  p-obj-code
     1470         ,input  p-pos-type
     1471         ,input  p-cash-num
     1472         ,input  p-ucode
     1473         ,input  p-code
     1474         ,input  p-value
     1475         ,input  p-mode
     1476         ,output p-correct
     1477         ,output p-error-code
     1478         ) no-error .
     1479       if error-status :error
     1480       then do:
     1481         undo, return error return-value .
     1482       end.
     1483     end.
     1484   end procedure.
     1485   procedure cd-attr-manual-edit :
     1486     define input  parameter p-ucode          as character no-undo .
     1487     define input  parameter p-code           as character no-undo .
     1488     define output parameter p-section-num    as integer no-undo .
     1489     do
     1490     on error undo, return error return-value
     1491     :
     1492           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-manual-edit in g#attr-lib
     1493         (input  p-ucode
     1494         ,input  p-code
     1495         ,output p-section-num
     1496         ) no-error .
