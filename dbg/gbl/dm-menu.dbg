     4166   procedure m-cashp-ref :
     4167     do
     4168     on error undo, return error
     4169     :
     4170     define buffer code for ub.code.
     4171     find first code where code.parent eq ""
     4172                       and code.code eq "cash-param"
     4173     no-lock no-error.
     4174     if not avail code
     4175     then do:
     4176        message "Справочник не найден." view-as alert-box.
     4177        return.
     4178     end.
     4179     run ref/cashpargroup.w ( input  parparentproc
     4180                        ,input  if isERPRN then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U
     4181                        ,input  ""
     4182                        ,input "cash-param"
     4183                        ,input ?
     4184                       ) .
     4185     end.
     4186   end procedure.
     4187   procedure m-code-ref :
     4188     do
     4189     on error undo, return error
     4190     :
