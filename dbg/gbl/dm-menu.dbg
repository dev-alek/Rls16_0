      485   define new global shared variable g#attr-lib  as handle no-undo .
      486   define variable v-attr-lib-variable as handle no-undo .
      487   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      488   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      489   procedure thbjattr_code :
      490      define input  parameter p-upper-code     as character no-undo .
      491      define input  parameter p-code           as character no-undo .
      492      define output parameter p-label          as character no-undo .
      493      define output parameter p-user-can-edit  as logical   no-undo .
      494      define output parameter p-output-display as logical   no-undo .
      495      define output parameter p-other          as character no-undo .
      496      define output parameter p-prop-list      as character no-undo .
      497      define output parameter p-prop-type-list as character no-undo .
      498      define output parameter p-prop-label-list as character no-undo .
      499      define output parameter p-global          as logical no-undo .
      500      define output parameter p-host           as logical no-undo .
      501      define output parameter p-shop           as logical no-undo .
      502      define output parameter p-store          as logical no-undo .
      503      define output parameter p-db             as logical no-undo .
