     8729   procedure m__rfr-exe :
     8730     define variable v-cur-date-error-code as integer      no-undo.
     8731     do
     8732     on error undo, return error return-value
     8733     :
     8734       run mainmenu-disp-mutable in parparentproc (
     8735           output v-cur-date-error-code
     8736       ) no-error.
     8737       if error-status :error
     8738       then do:
     8739         message
     8740           vss-workfile vss-revision vss-description skip
     8741           "Ошибка при вызове процедуры mainmenu-disp-mutable" skip
     8742           error-status :get-message(1) skip
     8743           return-value skip
     8744           view-as alert-box error .
     8745         undo, return error return-value .
     8746       end.
     8747     end.
     8748   end procedure.
     8749   procedure m__st-exe :
     8750     do
