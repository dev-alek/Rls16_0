     9272   procedure m-bpa-ref :
     9273   define variable v-rid-list as character no-undo .
     9274   define variable v-mode     as character no-undo .
     9275   define variable v-value    as character no-undo .
     9276   define variable v-type     as character no-undo .
     9277     do
     9278     on error undo, return error
     9279     :
     9280       run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-type) no-error.
     9281       if v-value = "no" then do:
     9282       if v-cntxt-db-num > 0 then v-mode = 'ПРОСМОТР':U. else v-mode = 'ИЗМЕНЕНИЕ':U .
     9283       end.
     9284       else v-mode = 'ПРОСМОТР':U .
     9285       run ref/bpa.p ( input parparentproc, input v-mode, output v-rid-list) no-error.
     9286     end.
     9287   end procedure.
