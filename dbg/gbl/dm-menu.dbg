    10132   procedure dm-doc-exe :
    10133   define input parameter parlistmode     as character no-undo.
    10134   define input parameter parflag         as logical   no-undo.
    10135   define input parameter parstat         as character no-undo.
    10136   define input parameter partype         as character no-undo.
    10137   define input parameter parinternal     as logical   no-undo.
    10138   define input parameter parext-doc-type as character no-undo.
    10139   define input parameter paris-hold      as logical   no-undo.
    10140   define variable loc-ref-list           as character no-undo.
    10141   define variable v-ok                   as logical   no-undo.
    10142   assign v-ok = yes.
    10143   if parlistmode = 'фирма':U then do:
    10144   define variable vss-include-info70 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10145   do:
    10146     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10147       (input  v-cntxt-db-num
    10148       ,input  v-cntxt-userid
    10149       ,input  0
