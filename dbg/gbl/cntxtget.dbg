        1   block-level on error undo, throw.
        2   define input  parameter p-cntxt-db-num          as integer   no-undo .
        3   define input  parameter p-cntxt-user-id         as character no-undo .
        4   define output parameter p-cntxt-valid           as logical   no-undo .
        5   define output parameter p-cntxt-menu-code       as integer   no-undo .
        6   define output parameter p-cntxt-menu-group-code as integer   no-undo .
        7   define output parameter p-cntxt-level           as character no-undo .
        8   define output parameter p-cntxt-host-code-obj   as integer   no-undo .
        9   define output parameter p-cntxt-obj-type        as character no-undo .
       10   define output parameter p-cntxt-obj-code        as integer   no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: cntxtget.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/cntxtget.p $":U .
       16   define variable vss-description as character no-undo init "Получить контекст по умолчанию при входе в систему".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define buffer buf_menu-group           for ub.menu-group .
       76   define buffer buf_user-context-history for ubflt.user-context-history .
       77   do
       78   on error undo, return error return-value
       79   :
       80     find last buf_user-context-history no-lock
       81       where buf_user-context-history.db-num  = p-cntxt-db-num
       82         and buf_user-context-history.user-id = p-cntxt-user-id
       83       no-error .
       84     if available buf_user-context-history
       85     then do:
       86       find first buf_menu-group no-lock
       87         where buf_menu-group.menu-code     = buf_user-context-history.cntxt-menu-code
       88           and buf_menu-group.menu-group-id = buf_user-context-history.cntxt-menu-group-id
       89         no-error .
       90       if available buf_menu-group
       91       then do:
       92         assign
       93           p-cntxt-valid           = true
       94           p-cntxt-level           = buf_user-context-history.cntxt-level
       95           p-cntxt-host-code-obj   = buf_user-context-history.cntxt-host-code
       96           p-cntxt-obj-type        = buf_user-context-history.cntxt-obj-type
       97           p-cntxt-obj-code        = buf_user-context-history.cntxt-obj-code
       98           p-cntxt-menu-code       = buf_user-context-history.cntxt-menu-code
       99           p-cntxt-menu-group-code = buf_menu-group.menu-group-code
      100         .
      101       end.
      102       else do:
      103         assign
      104           p-cntxt-valid         = false
      105         .
      106       end.
      107     end.
      108     else do:
      109       assign
      110         p-cntxt-valid         = false
      111       .
      112     end.
      113   end.
