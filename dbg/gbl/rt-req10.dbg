      296   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   procedure rt-cnvdc_decode :
      298     define input  parameter p-encoded-str as character no-undo .
      299     define output parameter p-decoded-str as character no-undo .
      300   do
      301   on error undo, return error return-value
      302   :
      303     define variable v-decoded-str as character no-undo .
      304     assign
      305       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      306       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      307       p-decoded-str = v-decoded-str
      308     .
      309   end.
      310   end procedure.
      311   define stream sout .
      312   define stream sinp .
      313   define variable v-status        as character no-undo .
      314   define variable v-error-message as character no-undo .
      315   do
      316   on error undo, return error return-value
      317   :
      318     if p-session-valid = true
      319     then do:
      320       run check-data in this-procedure
      321         (output  v-status
      322         ,output  v-error-message
      323         ) no-error .
      324       if error-status :error
      325       then do:
      326         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      327                                     ,error-status :get-message(1)
      328                                     ,return-value
      329                                     ) .
      330       end.
      331     end.
      332     else do:
      333       assign
      334         v-status        = '1':u
      335         v-error-message = p-error-message
      336       .
      337     end.
      338     define variable v-temp-file-name as character no-undo .
      339     assign
      340       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      341     .
      342     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      343     put stream sout unformatted substitute('status:&1', rtencode(v-status))
      344                                 + chr(10) .
      345     put stream sout unformatted substitute('message:&1',rtencode(v-error-message))
      346                                 + chr(10) .
      347     output stream sout close .
      348     os-delete value(p-directory-out + '/':u + p-file-name) .
      349     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      350               value(p-directory-out + '/':u + p-file-name)
      351               .
      352   end.
      353   procedure check-data :
      354     define output parameter p-status        as character no-undo .
      355     define output parameter p-error-message as character no-undo .
      356     define buffer buf_clients    for ub.clients .
      357     define buffer buf_sysconf    for ub.sysconf .
      358     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      359     define buffer buf_user-login for ub.user-login .
      360     define variable v-is-hold-doc as logical   no-undo .
      361     do
      362     on error undo, return error return-value
      363     :
      364       find first buf_sys-ctrl no-lock .
      365       find first buf_user-login no-lock
      366         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      367           and buf_user-login.status_    = 0
      368           and buf_user-login.user-login = p-user-login
      369         no-error .
      370       if not available buf_user-login
      371       then do:
      372         assign
      373           p-status        = '1':u
      374           p-error-message = substitute("Неизвестный пользователь &1"
      375                                       ,p-user-login
      376                                       )
      377         .
      378         return .
      379       end.
      380       define variable v-obj-code      as integer   no-undo .
      381       define variable v-data-valid    as logical   no-undo .
      382       define variable v-error-message as character no-undo .
      383       if p-obj-code = ""
      384       then do:
      385         assign
      386           p-status        = '1':u
      387           p-error-message = "Не задан код объекта"
      388         .
      389         return .
      390       end.
      391       run integerm in this-procedure
      392         (input  p-obj-code
      393         ,input  false
      394         ,input  false
      395         ,output v-obj-code
      396         ,output v-data-valid
      397         ,output v-error-message
      398         ) .
      399       if v-data-valid <> true
      400       then do:
      401         assign
      402           p-status        = '1':u
      403           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      404                                       ,p-obj-code
      405                                       ,v-error-message
      406                                       )
      407         .
      408         return .
      409       end.
      410       find first buf_clients no-lock
      411         where buf_clients.obj-type = p-obj-type
      412           and buf_clients.obj-code = v-obj-code
      413         no-error .
      414       if not available buf_clients
      415       then do:
      416         assign
      417           p-status        = '1':u
      418           p-error-message = substitute("Не найден объект &1 &2"
      419                                       ,p-obj-type
      420                                       ,v-obj-code
      421                                       )
      422         .
      423         return .
      424       end.
      425       if  p-obj-type <> 'маг':U
      426       and p-obj-type <> 'скл':U
      427       then do:
      428         assign
      429           p-status        = '1':u
      430           p-error-message = substitute("Неправильный тип объекта &1 &2"
      431                                       ,p-obj-type
      432                                       ,v-obj-code
      433                                       )
      434         .
      435         return .
      436       end.
      437       define variable v-host-code as integer   no-undo .
      438       run integerm in this-procedure
      439         (input  p-host-code
      440         ,input  false
      441         ,input  false
      442         ,output v-host-code
      443         ,output v-data-valid
      444         ,output v-error-message
      445         ) .
      446       if v-data-valid <> true
      447       then do:
      448         assign
      449           p-status        = '1':u
      450           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      451                                       ,p-host-code
      452                                       ,v-error-message
      453                                       )
      454         .
      455         return .
      456       end.
      457       define variable v-obj-host-code as integer   no-undo .
      458   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      460     (input  buf_clients.obj-type
      461     ,input  buf_clients.obj-code
      462     ,output v-obj-host-code
      463     )  .
      464       if v-host-code <> v-obj-host-code
      465       then do:
      466         assign
      467           p-status        = '1':u
      468           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      469                                       ,p-host-code
      470                                       ,v-obj-host-code
      471                                       ,buf_clients.obj-type
