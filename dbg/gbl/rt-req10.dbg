      494                                       )
      495         .
      496         return .
      497       end.
      498       define variable v-valid-act   as logical   no-undo .
      499   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   do:
      501     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      502       (input  buf_sys-ctrl.db-num
      503       ,input  buf_user-login.user-id
      504       ,input  0
      505       ,input  'actn_rt-edit-doc_work':U
      506       ,input  'object':U
      507       ,input  v-host-code
      508       ,input  buf_clients.obj-type
      509       ,input  buf_clients.obj-code
      510       ,input  0
      511       ,input  0
      512       ,input  0
