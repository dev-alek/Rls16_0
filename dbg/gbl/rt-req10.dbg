        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as widget-handle no-undo .
        3   define input  parameter p-directory-out as character no-undo .
        4   define input  parameter p-file-name     as character no-undo .
        5   define input  parameter p-session-valid as logical   no-undo .
        6   define input  parameter p-error-message as character no-undo .
        7   define input  parameter p-user-login    as character no-undo .
        8   define input  parameter p-obj-type      as character no-undo .
        9   define input  parameter p-obj-code      as character no-undo .
       10   define input  parameter p-host-code     as character no-undo .
       11   define input  parameter p-doc-type      as character no-undo .
       12   define input  parameter p-doc-code      as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: rt-req10.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req10.p $":U .
       18   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 05. Приемка товара. Выбор по номеру".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure integerm :
       81     define input  parameter p-string      as character no-undo .
       82     define input  parameter p-allow-sign  as logical   no-undo .
       83     define input  parameter p-allow-comma as logical   no-undo .
       84     define output parameter p-value       as integer   no-undo .
       85     define output parameter p-data-valid  as logical   no-undo .
       86     define output parameter p-message     as character no-undo .
       87     define variable v-replace-string as character no-undo .
       88     do
       89     on error undo, return error return-value
       90     :
       91       if p-string = ?
       92       then do:
       93         assign
       94           p-value      = ?
       95           p-data-valid = false
       96           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       97         .
       98         return .
       99       end.
      100       if p-string = ""
      101       then do:
      102         assign
      103           p-value      = ?
      104           p-data-valid = false
      105           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      106         .
      107         return .
      108       end.
      109       assign
      110         p-value = integer(p-string) no-error
      111       .
      112       if error-status :error = true
      113       then do:
      114         assign
      115           p-value      = ?
      116           p-data-valid = false
      117           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      118                                    ,p-string
      119                                    )
      120         .
      121         return .
      122       end.
      123       if index(p-string, ' ':u) > 0
      124       then do:
      125         assign
      126           p-value      = ?
      127           p-data-valid = false
      128           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      129                                    + "Строка содержит символы пробела"
      130                                    ,p-string
      131                                    )
      132         .
      133         return .
      134       end.
      135       assign
      136         v-replace-string = p-string
      137         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      146       .
      147       if p-allow-sign = true
      148       then do:
      149         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      150         then do:
      151           assign
      152             v-replace-string = substring(v-replace-string, 2)
      153           .
      154         end.
      155       end.
      156       else do:
      157         if substring(v-replace-string, 1, 1) = '+':u
      158         then do:
      159           assign
      160             p-value      = ?
      161             p-data-valid = false
      162             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      163                                     + "Задан параметр недопустимости знака челого числа. "
      164                                     + "Строка содержит символ плюс. "
      165                                     ,p-string
      166                                     )
      167           .
      168           return .
      169         end.
      170         if substring(v-replace-string, 1, 1) = '-':u
      171         then do:
      172           assign
      173             p-value      = ?
      174             p-data-valid = false
      175             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      176                                     + "Задан параметр недопустимости знака челого числа. "
      177                                     + "Строка содержит символ минус. "
      178                                     ,p-string
      179                                     )
      180           .
      181           return .
      182         end.
      183       end.
      184       if p-allow-comma = true
      185       then do:
      186         assign
      187           v-replace-string = replace(v-replace-string, ',', '')
      188         .
      189       end.
      190       else do:
      191         if index(v-replace-string, ',') > 0
      192         then do:
      193           assign
      194             p-value      = ?
      195             p-data-valid = false
      196             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      197                                     + "Задан параметр недопустимости знака разделителя тысяч."
      198                                     + "Строка содержит знак разделителя тысяч. "
      199                                     ,p-string
      200                                     )
      201           .
      202           return .
      203         end.
      204       end.
      205       if index(p-string, '.') > 0
      206       then do:
      207         assign
      208           p-value      = ?
      209           p-data-valid = false
      210           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      211                                    + "Строка содержит знак десятичной точки"
      212                                    ,p-string
      213                                    )
      214         .
      215         return .
      216       end.
      217       if v-replace-string <> fill('9', length(v-replace-string))
      218       then do:
      219         assign
      220           p-value      = ?
      221           p-data-valid = false
      222           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      223                                    + "Встречены символы, недопустимые для целого числа '&2'"
      224                                    ,p-string
      225                                    ,replace(v-replace-string, '9', '')
      226                                    )
      227         .
      228         return .
      229       end.
      230       assign
      231         p-data-valid = true
      232         p-message    = ""
      233       .
      234     end.
      235   end procedure.
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   function rtencode returns character
      238     ( p-init-string as character
      239     ) :
      240     define variable v-encode-string as character no-undo .
      241     if p-init-string = ?
      242     then do:
      243       assign
      244         v-encode-string = '?':u
      245       .
      246       return v-encode-string .
      247     end.
      248     if p-init-string = '?':u
      249     then do:
      250       assign
      251         v-encode-string = '~~077':u
      252       .
      253       return v-encode-string .
      254     end.
      255     assign
      256       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      257       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      258       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      259     .
      260     return v-encode-string .
      261   end function .
      262   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   define variable v-rt-cntxt_parparentproc  as handle    no-undo .
      264   define variable v-rt-cntxt_proc-signature as character no-undo .
      265   procedure rt-cntxt_setcntxt :
      266     define input parameter p-cntxt-db-num        as integer   no-undo .
      267     define input parameter p-cntxt-user-id       as character no-undo .
      268     define input parameter p-cntxt-level         as character no-undo .
      269     define input parameter p-cntxt-host-code-obj as integer   no-undo .
      270     define input parameter p-cntxt-obj-type      as character no-undo .
      271     define input parameter p-cntxt-obj-code      as integer   no-undo .
      272     define input parameter p-cntxt-db-num-obj    as integer   no-undo .
      273     define input parameter p-cntxt-is-admin      as logical   no-undo .
      274   do
      275   on error undo, return error return-value
      276   :
      277     run w-reqsrv_setcntxt in parparentproc
      278       ( input p-cntxt-db-num
      279       , input p-cntxt-user-id
      280       , input p-cntxt-level
      281       , input p-cntxt-host-code-obj
      282       , input p-cntxt-obj-type
      283       , input p-cntxt-obj-code
      284       , input p-cntxt-db-num-obj
      285       , input p-cntxt-is-admin
      286       ) .
      287   end.
      288   end procedure.
      289   procedure rt-cntxt_clrcntxt :
