      514       ,output v-valid-act
      515       )  .
      516   end.
      517       if v-valid-act <> true
      518       then do:
      519         assign
      520           p-status        = '1'
      521           p-error-message = substitute( "&1" , return-value )
      522         .
      523         return .
      524       end.
      525       find first buf_sysconf no-lock
      526         where buf_sysconf.host-code = v-host-code
      527         no-error .
      528       if not available buf_sysconf
      529       then do:
      530         assign
      531           p-status        = '1':u
      532           p-error-message = substitute("Не найдена фирма &1"
      533                                       ,v-host-code
      534                                       )
      535         .
      536         return .
