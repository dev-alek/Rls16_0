     1124             end.
     1125             assign
     1126               p-status = '1':u
     1127               p-error-message = substitute("Неизвестный статус &1 складского документа &2"
     1128                                           ,p-status
     1129                                           ,buf_trn-doc.doc-code
     1130                                           )
     1131             .
     1132             return .
     1133           end.
     1134           if v-prod-artic-search = true
     1135           then do:
     1136             find first buf_ext-artic no-lock
     1137               where buf_ext-artic.cli-type  = buf_trn-doc.cli-type
     1138                 and buf_ext-artic.cli-code  = buf_trn-doc.cli-code
     1139                 and buf_ext-artic.ext-artic = p-bar-code
     1140                 and buf_ext-artic.status_   = 'тек':U
     1141             no-error .
     1142             if available buf_ext-artic
     1143             then do:
     1144                 find first buf_goods no-lock
     1145                   where buf_goods.gds-code = buf_ext-artic.gds-code
     1146                 no-error .
     1147                 if available buf_goods
     1148                 then do:
     1149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1150     (input  buf_goods.gds-code
     1151     ,input  ?
     1152     ,output v-bar-code
     1153     ) no-error .
     1154                   if error-status :error
     1155                   then do:
     1156                   assign
     1157                     p-status = '1':u
     1158                     p-error-message = substitute( "&1. &2"
     1159                                                 , return-value
     1160                                                 , error-status :get-message(1)
     1161                                                 )
     1162                   .
     1163                   return .
     1164                   end.
     1165                   assign
     1166                     p-bar-code = string( v-bar-code )
     1167                   .
     1168                 end.
     1169             end.
     1170           end.
     1171           run gbl/rt-bcode.p
     1172             (input  parparentproc
     1173             ,input  p-doc-type + '|':u + buf_trn-doc.doc-code
     1174             ,input  p-bar-code
     1175             ,input  0
     1176             ,input  0
     1177             ,input  no
     1178             ,output p-status
     1179             ,output p-error-message
     1180             ,output p-b-code
     1181             ,output p-artic
     1182             ,output p-name
     1183             ,output v-prod-type
     1184             ,output v-prod-code
     1185             ,output p-prod-name
     1186             ,output p-doc-qnty
     1187             ,output p-unit-base
     1188             ,output p-doc-sum
     1189             ,output p-curr-abbr
     1190             ,output p-deadline-date
     1191             ,output p-price-docf
     1192             ) .
     1193           if p-status <> '0':u
     1194           then do:
     1195             assign
     1196               p-status = '1':u
     1197             .
     1198             return .
     1199           end.
     1200           assign
     1201             p-status        = '0'
     1202             p-error-message = ''
     1203           .
     1204           return .
     1205         end.
     1206         otherwise do:
     1207           assign
     1208             p-status        = '3'
     1209             p-error-message = substitute("Неизвестный тип документа &1"
     1210                                         ,p-doc-type
     1211                                         )
     1212           .
     1213           return .
     1214         end.
     1215       end case .
     1216       assign
     1217         p-status        = '3'
     1218         p-error-message = "Неизвестная ошибка"
     1219       .
     1220       return .
     1221     end.
     1222   end procedure.
