        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as widget-handle no-undo .
        3   define input  parameter p-directory-out as character no-undo .
        4   define input  parameter p-file-name     as character no-undo .
        5   define input  parameter p-session-valid as logical   no-undo .
        6   define input  parameter p-error-message as character no-undo .
        7   define input  parameter p-user-login    as character no-undo .
        8   define input  parameter p-obj-type      as character no-undo .
        9   define input  parameter p-obj-code      as character no-undo .
       10   define input  parameter p-host-code     as character no-undo .
       11   define input  parameter p-doc-type      as character no-undo .
       12   define input  parameter p-doc-code      as character no-undo .
       13   define input  parameter p-bar-code      as character no-undo .
       14   define input  parameter p-prod-artic        as character no-undo .
       15   define input  parameter p-prod-artic-search as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       18   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: rt-req17.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req17.p $":U .
       21   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 17. Приемка товара. Получить информацию о строке накладной по штрих-коду".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure integerm :
       84     define input  parameter p-string      as character no-undo .
       85     define input  parameter p-allow-sign  as logical   no-undo .
       86     define input  parameter p-allow-comma as logical   no-undo .
       87     define output parameter p-value       as integer   no-undo .
       88     define output parameter p-data-valid  as logical   no-undo .
       89     define output parameter p-message     as character no-undo .
       90     define variable v-replace-string as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       if p-string = ?
       95       then do:
       96         assign
       97           p-value      = ?
       98           p-data-valid = false
       99           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      100         .
      101         return .
      102       end.
      103       if p-string = ""
      104       then do:
      105         assign
      106           p-value      = ?
      107           p-data-valid = false
      108           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      109         .
      110         return .
      111       end.
      112       assign
      113         p-value = integer(p-string) no-error
      114       .
      115       if error-status :error = true
      116       then do:
      117         assign
      118           p-value      = ?
      119           p-data-valid = false
      120           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      121                                    ,p-string
      122                                    )
      123         .
      124         return .
      125       end.
      126       if index(p-string, ' ':u) > 0
      127       then do:
      128         assign
      129           p-value      = ?
      130           p-data-valid = false
      131           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      132                                    + "Строка содержит символы пробела"
      133                                    ,p-string
      134                                    )
      135         .
      136         return .
      137       end.
      138       assign
      139         v-replace-string = p-string
      140         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      149       .
      150       if p-allow-sign = true
      151       then do:
      152         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      153         then do:
      154           assign
      155             v-replace-string = substring(v-replace-string, 2)
      156           .
      157         end.
      158       end.
      159       else do:
      160         if substring(v-replace-string, 1, 1) = '+':u
      161         then do:
      162           assign
      163             p-value      = ?
      164             p-data-valid = false
      165             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      166                                     + "Задан параметр недопустимости знака челого числа. "
      167                                     + "Строка содержит символ плюс. "
      168                                     ,p-string
      169                                     )
      170           .
      171           return .
      172         end.
      173         if substring(v-replace-string, 1, 1) = '-':u
      174         then do:
      175           assign
      176             p-value      = ?
      177             p-data-valid = false
      178             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      179                                     + "Задан параметр недопустимости знака челого числа. "
      180                                     + "Строка содержит символ минус. "
      181                                     ,p-string
      182                                     )
      183           .
      184           return .
      185         end.
      186       end.
      187       if p-allow-comma = true
      188       then do:
      189         assign
      190           v-replace-string = replace(v-replace-string, ',', '')
      191         .
      192       end.
      193       else do:
      194         if index(v-replace-string, ',') > 0
      195         then do:
      196           assign
      197             p-value      = ?
      198             p-data-valid = false
      199             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      200                                     + "Задан параметр недопустимости знака разделителя тысяч."
      201                                     + "Строка содержит знак разделителя тысяч. "
      202                                     ,p-string
      203                                     )
      204           .
      205           return .
      206         end.
      207       end.
      208       if index(p-string, '.') > 0
      209       then do:
      210         assign
      211           p-value      = ?
      212           p-data-valid = false
      213           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      214                                    + "Строка содержит знак десятичной точки"
      215                                    ,p-string
      216                                    )
      217         .
      218         return .
      219       end.
      220       if v-replace-string <> fill('9', length(v-replace-string))
      221       then do:
      222         assign
      223           p-value      = ?
      224           p-data-valid = false
      225           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      226                                    + "Встречены символы, недопустимые для целого числа '&2'"
      227                                    ,p-string
      228                                    ,replace(v-replace-string, '9', '')
      229                                    )
      230         .
      231         return .
      232       end.
      233       assign
      234         p-data-valid = true
      235         p-message    = ""
      236       .
      237     end.
      238   end procedure.
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   function rtencode returns character
      241     ( p-init-string as character
      242     ) :
      243     define variable v-encode-string as character no-undo .
      244     if p-init-string = ?
      245     then do:
      246       assign
      247         v-encode-string = '?':u
      248       .
      249       return v-encode-string .
      250     end.
      251     if p-init-string = '?':u
      252     then do:
      253       assign
      254         v-encode-string = '~~077':u
      255       .
      256       return v-encode-string .
      257     end.
      258     assign
      259       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      260       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      261       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      262     .
      263     return v-encode-string .
      264   end function .
      265   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   procedure rt-cnvdc_decode :
      267     define input  parameter p-encoded-str as character no-undo .
      268     define output parameter p-decoded-str as character no-undo .
      269   do
      270   on error undo, return error return-value
      271   :
      272     define variable v-decoded-str as character no-undo .
      273     assign
      274       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      275       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      276       p-decoded-str = v-decoded-str
      277     .
      278   end.
      279   end procedure.
      280   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   define variable v-rt-cntxt_parparentproc  as handle    no-undo .
      282   define variable v-rt-cntxt_proc-signature as character no-undo .
      283   procedure rt-cntxt_setcntxt :
      284     define input parameter p-cntxt-db-num        as integer   no-undo .
      285     define input parameter p-cntxt-user-id       as character no-undo .
      286     define input parameter p-cntxt-level         as character no-undo .
      287     define input parameter p-cntxt-host-code-obj as integer   no-undo .
      288     define input parameter p-cntxt-obj-type      as character no-undo .
      289     define input parameter p-cntxt-obj-code      as integer   no-undo .
      290     define input parameter p-cntxt-db-num-obj    as integer   no-undo .
      291     define input parameter p-cntxt-is-admin      as logical   no-undo .
      292   do
      293   on error undo, return error return-value
      294   :
      295     run w-reqsrv_setcntxt in parparentproc
      296       ( input p-cntxt-db-num
      297       , input p-cntxt-user-id
      298       , input p-cntxt-level
      299       , input p-cntxt-host-code-obj
      300       , input p-cntxt-obj-type
      301       , input p-cntxt-obj-code
      302       , input p-cntxt-db-num-obj
      303       , input p-cntxt-is-admin
      304       ) .
      305   end.
      306   end procedure.
      307   procedure rt-cntxt_clrcntxt :
      308   do
      309   on error undo, return error return-value
      310   :
      311     run w-reqsrv_clrcntxt in parparentproc .
      312   end.
      313   end procedure.
      314   define stream sout .
      315   define variable v-status        as character no-undo .
      316   define variable v-error-message as character no-undo .
      317   define variable v-b-code        as integer   no-undo .
      318   define variable v-artic         as character no-undo .
      319   define variable v-name          as character no-undo .
      320   define variable v-prod-name     as character no-undo .
      321   define variable v-doc-qnty      as character no-undo .
      322   define variable v-unit-base     as character no-undo .
      323   define variable v-doc-sum       as character no-undo .
      324   define variable v-curr-abbr     as character no-undo .
      325   define variable v-deadline-date as character no-undo .
      326   define variable v-price-docf    as character no-undo .
      327   do
      328   on error undo, return error return-value
      329   :
      330     if p-session-valid = true
      331     then do:
      332       run check-data in this-procedure
      333         (output v-status
      334         ,output v-error-message
      335         ,output v-b-code
      336         ,output v-artic
      337         ,output v-name
      338         ,output v-prod-name
      339         ,output v-doc-qnty
      340         ,output v-unit-base
      341         ,output v-doc-sum
      342         ,output v-curr-abbr
      343         ,output v-deadline-date
      344         ,output v-price-docf
      345         ) no-error .
      346       if error-status :error
      347       then do:
      348         run rt-cntxt_clrcntxt in this-procedure .
      349         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      350                                     ,error-status :get-message(1)
      351                                     ,return-value
      352                                     ) .
      353       end.
      354     end.
      355     else do:
      356       assign
      357         v-status        = '1':u
      358         v-error-message = p-error-message
      359         v-artic         = '':u
      360         v-name          = '':u
      361         v-prod-name     = '':u
      362         v-doc-qnty      = '':u
      363         v-unit-base     = '':u
      364         v-doc-sum       = '':u
      365         v-curr-abbr     = '':u
      366         v-deadline-date = '':u
      367         v-price-docf    = '':u
      368       .
      369     end.
      370     define variable v-temp-file-name as character no-undo .
      371     assign
      372       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      373     .
      374     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      375     put stream sout unformatted substitute('status:&1',    rtencode(v-status))
      376                                 + chr(10) .
      377     put stream sout unformatted substitute('message:&1',   rtencode(v-error-message))
      378                                 + chr(10) .
      379     put stream sout unformatted substitute('artic:&1',     rtencode(v-artic))
      380                                 + chr(10) .
      381     put stream sout unformatted substitute('name:&1',      rtencode(v-name))
      382                                 + chr(10) .
      383     put stream sout unformatted substitute('prod_name:&1', rtencode(v-prod-name))
      384                                 + chr(10) .
      385     put stream sout unformatted substitute('doc_qnty:&1',  rtencode(v-doc-qnty))
      386                                 + chr(10) .
      387     put stream sout unformatted substitute('unit_base:&1', rtencode(v-unit-base))
      388                                 + chr(10) .
      389     put stream sout unformatted substitute('doc_sum:&1',   rtencode(v-doc-sum))
      390                                 + chr(10) .
      391     put stream sout unformatted substitute('curr_abbr:&1', rtencode(v-curr-abbr))
      392                                 + chr(10) .
      393     put stream sout unformatted substitute('deadline_date:&1', rtencode(v-deadline-date))
      394                                 + chr(10) .
      395     put stream sout unformatted substitute('price_docf:&1', rtencode(v-price-docf))
      396                                 + chr(10) .
      397     output stream sout close .
      398     os-delete value(p-directory-out + '/':u + p-file-name) .
      399     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      400               value(p-directory-out + '/':u + p-file-name)
      401               .
      402     run rt-cntxt_clrcntxt in this-procedure .
      403   end.
      404   procedure check-data :
      405     define output parameter p-status        as character no-undo .
      406     define output parameter p-error-message as character no-undo .
      407     define output parameter p-b-code        as integer   no-undo .
      408     define output parameter p-artic         as character no-undo .
      409     define output parameter p-name          as character no-undo .
      410     define output parameter p-prod-name     as character no-undo .
      411     define output parameter p-doc-qnty      as character no-undo .
      412     define output parameter p-unit-base     as character no-undo .
      413     define output parameter p-doc-sum       as character no-undo .
      414     define output parameter p-curr-abbr     as character no-undo .
      415     define output parameter p-deadline-date as character no-undo .
      416     define output parameter p-price-docf    as character no-undo .
      417     define buffer buf_clients     for ub.clients .
      418     define buffer buf_sysconf     for ub.sysconf .
      419     define buffer buf_sys-ctrl    for ub.sys-ctrl .
      420     define buffer buf_user-login  for ub.user-login .
      421     define buffer buf_ext-artic   for ub.ext-artic.
      422     define buffer buf_goods       for ub.goods.
      423     define variable v-bar-code          like ub.bar-code.b-code  no-undo .
      424     define variable v-prod-type         as character             no-undo .
      425     define variable v-prod-code         as integer               no-undo .
      426     define variable v-is-hold-doc       as logical               no-undo .
      427     do
      428     on error undo, return error return-value
      429     :
      430       assign
      431         p-price-docf = "0"
      432       .
      433       find first buf_sys-ctrl no-lock .
      434       find first buf_user-login no-lock
      435         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      436           and buf_user-login.status_    = 0
      437           and buf_user-login.user-login = p-user-login
      438         no-error .
      439       if not available buf_user-login
      440       then do:
      441         assign
      442           p-status        = '3'
      443           p-error-message = substitute("Неизвестный пользователь &1"
      444                                       ,p-user-login
      445                                       )
      446         .
      447         return .
      448       end.
      449       define variable v-obj-code      as integer   no-undo .
      450       define variable v-data-valid    as logical   no-undo .
      451       define variable v-error-message as character no-undo .
      452       if p-obj-code = ""
      453       then do:
      454         assign
      455           p-status        = '3'
      456           p-error-message = "Не задан код объекта"
      457         .
      458         return .
      459       end.
      460       run integerm in this-procedure
      461         (input  p-obj-code
      462         ,input  false
      463         ,input  false
      464         ,output v-obj-code
      465         ,output v-data-valid
      466         ,output v-error-message
      467         ) .
      468       if v-data-valid <> true
      469       then do:
      470         assign
      471           p-status        = '3'
      472           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      473                                       ,p-obj-code
      474                                       ,v-error-message
      475                                       )
      476         .
      477         return .
      478       end.
      479       find first buf_clients no-lock
      480         where buf_clients.obj-type = p-obj-type
      481           and buf_clients.obj-code = v-obj-code
      482         no-error .
      483       if not available buf_clients
      484       then do:
      485         assign
      486           p-status        = '3'
      487           p-error-message = substitute("Не найден объект &1 &2"
      488                                       ,p-obj-type
      489                                       ,v-obj-code
      490                                       )
      491         .
      492         return .
      493       end.
      494       if  p-obj-type <> 'маг':U
      495       and p-obj-type <> 'скл':U
      496       then do:
      497         assign
      498           p-status        = '3'
      499           p-error-message = substitute("Неправильный тип объекта &1 &2"
      500                                       ,p-obj-type
      501                                       ,v-obj-code
      502                                       )
      503         .
      504         return .
      505       end.
      506       define variable v-host-code as integer   no-undo .
      507       run integerm in this-procedure
      508         (input  p-host-code
      509         ,input  false
      510         ,input  false
      511         ,output v-host-code
      512         ,output v-data-valid
      513         ,output v-error-message
      514         ) .
      515       if v-data-valid <> true
      516       then do:
      517         assign
      518           p-status        = '3'
      519           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      520                                       ,p-host-code
      521                                       ,v-error-message
      522                                       )
      523         .
      524         return .
      525       end.
      526       define variable v-obj-host-code as integer   no-undo .
      527   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      529     (input  buf_clients.obj-type
      530     ,input  buf_clients.obj-code
      531     ,output v-obj-host-code
