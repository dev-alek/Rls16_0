        1   define input parameter mode as character no-undo.
        2   define input-output parameter notes as character no-undo .
        3   def var vss-revision    as character no-undo init "$Revision$":u .
        4   def var vss-author      as character no-undo init "$Author$":u .
        5   def var vss-date        as character no-undo init "$Date$":u .
        6   def var vss-workfile    as character no-undo init "$Workfile$":u .
        7   def var vss-archive     as character no-undo init "$Archive$":u .
        8   def var vss-description as character no-undo init "Просмотр или редактирование примечания" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   DEFINE BUTTON b-exit AUTO-GO
      124        LABEL "&Выход "
      125        SIZE 8.75 BY 1.
      126   DEFINE BUTTON b-help
      127        LABEL "Помо&щь"
      128        SIZE 8.75 BY 1.
      129   DEFINE VARIABLE ed-notes AS CHARACTER
      130        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      131        SIZE 63.5 BY 6.5
      132         FONT 4
      133        NO-UNDO.
      134   DEFINE FRAME d-notes
      135        b-exit AT ROW 1.5 COL 3
      136        b-help AT ROW 1.5 COL 16
      137        ed-notes AT ROW 3 COL 3 NO-LABEL
      138        SPACE(2.13) SKIP(0.77)
      139       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      140            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      141            TITLE "ПРИМЕЧАНИЕ"
      142            default-button b-exit.
      143   ASSIGN
      144          FRAME d-notes:SCROLLABLE       = FALSE.
      145   on return of ed-notes apply "go" to frame d-notes.
      146   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-notes:PARENT eq ?
      147   THEN FRAME d-notes:PARENT = ACTIVE-WINDOW.
      148   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   on help of frame d-notes
      150   do:
      151     run gbl/app_help.p
      152       (input this-procedure :file-name
      153       ,input ''
      154       ,input ?
      155       ) no-error.
      156     if error-status :error then do:
      157       message
      158         "Ошибка при вызове помощи"
      159         error-status :get-message(1)
      160         view-as alert-box .
      161     end.
      162   end.
      163   run minbtn-set in this-procedure .
      164   on choose of b-help in frame d-notes
      165   do:
      166     apply "help":u to frame d-notes .
      167   end.
      168   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure minbtn-set :
      170       do
      171           on error undo, return error return-value
      172           :
      173           define variable ii              as integer       no-undo .
      174           define variable fh              as widget-handle no-undo .
      175           define variable hh              as widget-handle no-undo .
      176           define variable v-h             as handle        extent 4 no-undo .
      177           define variable v-name-button   as character     no-undo .
      178           define variable v-help-old-x    as decimal       no-undo .
      179           define variable v-help-old-y    as decimal       no-undo .
      180           define variable v-help-old-size as decimal       no-undo .
      181           define variable v-frame-width   as decimal       no-undo .
      182           define variable jj              as integer       no-undo .
      183           do
      184               on error undo, return error
      185               :
      186               assign
      187                   v-frame-width = frame d-notes:width - 0.3
      188                   fh            = frame d-notes:first-child
      189                   hh            = fh:first-child
      190                   ii            = 1
      191                   .
      192               do while valid-handle(hh):
      193                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      194                   do:
      195                       case lc(hh:name) :
      196                           when "b-help" then
      197                               do:
      198                                   hh:load-image-up("cmp/b-help.bmp":u) .
      199                                   hh:load-image-down("cmp/b-help.bmp":u) .
      200                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      201                                   hh:TOOLTIP = "Помощь" .
      202                                   v-help-old-x = hh:column .
      203                                   v-help-old-y = hh:row    .
      204                                   v-help-old-size = hh:width .
      205                                   hh:width-chars = 2.5 .
      206                               end.
      207                           when "b-print" then
      208                               do:
      209                                   hh:load-image("cmp/b-print.bmp":u) .
      210                                   hh:TOOLTIP = "Печать" .
      211                                   v-h[ii] = hh:handle .
      212                                   ii = ii + 1 .
      213                                   hh:width-chars = 3 .
      214                               end.
      215                           when "b-history" or
      216                           when "b-hist" then
      217                               do:
      218                                   hh:load-image("cmp/b-hist.bmp":u) .
      219                                   hh:TOOLTIP = "История" .
      220                                   v-h[ii] = hh:handle .
      221                                   ii = ii + 1 .
      222                                   hh:width-chars = 3 .
      223                               end.
      224                           when "b-sch" then
      225                               do:
      226                                   hh:load-image("cmp/b-sch.bmp":u) .
      227                                   hh:TOOLTIP = "Установка Фильтра" .
      228                                   v-h[ii] = hh:handle .
      229                                   ii = ii + 1 .
      230                                   hh:width-chars = 3 .
      231                               end.
      232                           when "b-hist-user" then
      233                               do:
      234                                   hh:load-image("cmp/b-hist.bmp":u) .
      235                                   hh:TOOLTIP = "История пользователя" .
      236                                   ii = ii + 1 .
      237                               end.
      238                       end case.
      239                   end.
      240                   hh = hh:next-sibling.
      241               end.
      242               b-help:column = v-frame-width - b-help:width-chars.
      243               jj = 0.
      244               repeat ii = 4 to 1 by -1 :
      245                   if valid-handle (v-h[ii] ) then
      246                   do:
      247                       jj  = jj + 1 .
      248                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      249                       v-h[ii]:row    = v-help-old-y .
      250                   end.
      251               end.
      252           end.
      253       end.
      254   end procedure.
      255   ON WINDOW-CLOSE OF FRAME d-notes APPLY "END-ERROR":U TO SELF.
      256   MAIN-BLOCK:
      257   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      258      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      259     assign
      260       ed-notes = notes
      261     .
      262     RUN UI-on.
      263     if mode = 'ПРОСМОТР':U then do:
      264       assign
      265         ed-notes:read-only = true
      266       .
      267     end.
      268     WAIT-FOR GO OF FRAME d-notes focus ed-notes.
      269     if mode <> 'ПРОСМОТР':U then do:
      270       assign
      271         notes = input frame d-notes ed-notes
      272       .
      273     end.
      274   END.
      275   RUN disable_UI.
      276   PROCEDURE disable_UI :
      277     HIDE FRAME d-notes.
      278   END PROCEDURE.
      279   PROCEDURE UI-on :
      280     disp ed-notes with frame d-notes.
      281     ENABLE b-exit b-help ed-notes WITH FRAME d-notes.
      282   END PROCEDURE.
