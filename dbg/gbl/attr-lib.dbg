     2347         message
     2348           substitute("Нельзя установить данный атрибут для клиента с типом &1", p-obj-type)
     2349           view-as alert-box error .
     2350       end.
     2351       run ref/vatrg.w
     2352         (input-output v-value
     2353         ).
     2354       if v-value <> p-value
     2355       then do:
     2356         assign
     2357           p-value  = v-value
     2358           p-setted = yes
     2359         .
     2360       end.
     2361     end.
     2362   end procedure.
     2363   procedure clntattr-main-accholder :
     2364   define input parameter parparentproc as widget-handle no-undo .
     2365   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2366   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2367   define input-output parameter p-value as character no-undo .
     2368   define output parameter p-setted as logical no-undo .
     2369   DEFINE VARIABLE v-value as character no-undo .
     2370   define variable v-holder-obj-type as character no-undo .
     2371   define variable v-holder-obj-code as integer no-undo .
     2372     do
     2373     on error undo, return error
     2374     :
     2375         v-value = p-value.
     2376         if p-obj-type <> 'орг':U
     2377         and p-obj-type <> 'чел':U then do:
     2378           message
     2379           substitute("Нельзя установить данный атрибут для клиента с типом &1", p-obj-type)
     2380           view-as alert-box error .
     2381           undo, return error .
     2382         end.
     2383         if p-value <> '':U then do:
     2384           assign
     2385           v-holder-obj-type = substring(p-value, 1, 3)
     2386           v-holder-obj-code = integer(substring(p-value, 4))
     2387           no-error.
     2388           if error-status:error then do:
     2389             assign
     2390             v-holder-obj-type = '':U
     2391             v-holder-obj-code = 0
     2392             .
     2393           end.
     2394         end.
     2395         run str/clisel.p ( input parparentproc
     2396                       ,input-output v-holder-obj-type
     2397                       ,input-output v-holder-obj-code) no-error.
     2398         if not error-status:error then do:
     2399           if not (v-holder-obj-type = 'орг':U
     2400                  or
     2401                  v-holder-obj-type = 'чел':U) then do:
     2402             message
     2403             substitute("Нельзя назначить держателем основного счета клиента с типом &1", v-holder-obj-type)
     2404             view-as alert-box error .
     2405             undo, return error .
     2406           end.
     2407           assign
     2408           v-value = v-holder-obj-type + "," + string(v-holder-obj-code)
     2409           .
     2410           if v-value <> p-value then do:
     2411             p-value = v-value.
     2412             p-setted = yes.
     2413           end.
     2414        end.
     2415     end.
     2416   end procedure.
     2417   procedure clntattr-veto-man-doc :
     2418   define input parameter parparentproc as widget-handle no-undo .
     2419   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2420   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2421   define input-output parameter p-value as character no-undo .
     2422   define output parameter p-setted as logical no-undo .
     2423   DEFINE VARIABLE v-value as character no-undo .
     2424     do
     2425     on error undo, return error
     2426     :
     2427         v-value = p-value.
     2428         if p-value = '':U then do:
     2429           p-value = "ALL".
     2430           p-setted = yes.
     2431           return.
     2432         end.
     2433         else do:
     2434           message
     2435           "Данный атрибут может либо отсутствовать," skip
     2436           "либо принимать значение ALL"
     2437           view-as alert-box warning.
     2438         end.
     2439     end.
     2440   end procedure.
