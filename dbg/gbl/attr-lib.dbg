     7604               when 'schedule-free':U then do:     assign     p-label = "Расписание произвольных задач"     p-type = 'L':U      p-format = "+/-"     p-label = "Расписание произвольных задач"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
