     2061   procedure clntattr-get-archive-by-type :
     2062     define input  parameter p-archive-type      as character no-undo .
     2063     define output parameter p-archive-attr-list as character no-undo .
     2064     define variable vss-description as character no-undo initial "clntattr-get-archive-by-type-01: возвращает список атрибутов для складского архива".
     2065     do
     2066     on error undo, return error return-value
     2067     :
     2068       case p-archive-type
     2069       :
     2070         when 'arh':U
     2071         then do:
     2072           assign
     2073             p-archive-attr-list = 'arh-detail':U
     2074                 + chr(44) + 'arh-start':U
     2075                 + chr(44) + 'arh-del':U
     2076                 + chr(44) + 'arh-disable':U
     2077                 + chr(44) + 'arh-calc':U
     2078                 + chr(44) + 'arh-rest':U
     2079                 + chr(44) + 'arh-recalc':U
     2080           .
     2081         end.
     2082         when 'ahsp':U
     2083         then do:
     2084           assign
     2085             p-archive-attr-list = 'ahsp-detail':U
     2086                 + chr(44) + 'ahsp-start':U
     2087                 + chr(44) + 'ahsp-del':U
     2088                 + chr(44) + 'ahsp-disable':U
     2089                 + chr(44) + 'ahsp-calc':U
     2090                 + chr(44) + 'ahsp-rest':U
     2091                 + chr(44) + 'ahsp-recalc':U
     2092           .
     2093         end.
     2094         when 'aht':U
     2095         then do:
     2096           assign
     2097             p-archive-attr-list = 'aht-detail':U
     2098                 + chr(44) + 'aht-start':U
     2099                 + chr(44) + 'aht-del':U
     2100                 + chr(44) + 'aht-disable':U
     2101                 + chr(44) + 'aht-calc':U
     2102                 + chr(44) + 'aht-rest':U
     2103                 + chr(44) + 'aht-recalc':U
     2104           .
     2105         end.
     2106         otherwise do:
     2107           message
     2108             vss-workfile vss-revision vss-description skip
     2109             "Ошибка при задании входных параметров" skip
     2110             "Неизвестное значение параметра p-archive-type" skip
     2111             "p-archive-type" p-archive-type skip
     2112             view-as alert-box error .
     2113           undo, return error return-value .
     2114         end.
     2115       end case.
     2116     end.
     2117   end procedure.
     2118   procedure clntattr-requisite-alc-decl :
     2119     define input parameter p-obj-type like ub.clients.obj-type no-undo .
