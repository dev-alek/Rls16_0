     6386   procedure gdsoattr-name :
     6387   do
     6388     on error undo, return error
     6389     :
     6390     define input  parameter p-code           as character no-undo .
     6391     define output parameter p-type           as character no-undo .
     6392     define output parameter p-format         as character no-undo .
     6393     define output parameter p-label          as character no-undo .
     6394     define output parameter p-user-can-edit  as logical   no-undo .
     6395     define output parameter p-output-display as logical   no-undo .
     6396     define output parameter p-other          as character no-undo .
     6397       case p-code :
     6398               when 'lock':U then do:     assign     p-label = "Блокировка атрибутов на изменение"     p-type = 'L':U      p-format = "yes/no"     p-label = "Блокировка атрибутов на изменение"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     6399               when 'scales-code':U then do:     assign     p-label = "Код для весов на объекте"     p-type = 'I':U      p-format = "99999"     p-label = "Код для весов на объекте"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     6400               when 'free-price':U then do:     assign     p-label = "Товар со свободной ценой на кассе"     p-type = 'L':U      p-format = "+/ "     p-label = "Товар со свободной ценой на кассе"     p-user-can-edit  = true     p-output-display = true     p-other = "cd=gds"      .   end.
     6401               when 'sum-grp':U then do:     assign     p-label = "Группа товаров на кассе"     p-type = 'I':U      p-format = "999"     p-label = "Группа товаров на кассе"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-sum-grps/cd=gds"      .   end.
     6402               when 'increase-pc':U then do:     assign     p-label = "Наценка"     p-type = 'D':U      p-format = "99999.99"     p-label = "Наценка"     p-user-can-edit  = true     p-output-display = true     p-other = "init=gds-obj-init-increase-pc"      .   end.
     6403               when 'min-zapas':U then do:     assign     p-label = "Минимальный запас"     p-type = 'D':U      p-format = ">>>>>>>>>9"     p-label = "Минимальный запас"     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     6404               when 'round-method':U then do:     assign     p-label = "Метод округления "     p-type = 'C':U      p-format = "X(21)"     p-label = "Метод округления "     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-round-method"      .   end.
     6405               when 'petrol-purse':U then do:     assign     p-label = "Топливный кошелек (IBM-POS)"     p-type = 'L':U      p-format = "+/-"     p-label = "Топливный кошелек (IBM-POS)"     p-user-can-edit  = true     p-output-display = true     p-other = "cd=gds"      .   end.
     6406               when 'need-auth':U then do:     assign     p-label = "Требует авторизации на кассе (IBM-XML)"     p-type = 'L':U      p-format = "+/-"     p-label = "Требует авторизации на кассе (IBM-XML)"     p-user-can-edit  = true     p-output-display = true     p-other = "cd=gds"      .   end.
     6407               when 'gds-margins':U then do:     assign     p-label = "Диапазоны торговой наценки"     p-type = 'C':U      p-format = "X(21)"     p-label = "Диапазоны торговой наценки"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-gds-margins"      .   end.
     6408               when 'proprietor':U then do:     assign     p-label = "Принадлежность товара объекту"     p-type = 'L':U      p-format = "+/-"     p-label = "Принадлежность товара объекту"     p-user-can-edit  = true     p-output-display = true     p-other = "check-ext=ref\gopropri.p"      .   end.
     6409               when 'fbr-cost-rubl':U then do:     assign     p-label = "Оценочная учетная цена ингредиента"     p-type = 'D':U      p-format = ">>>>>>>>>9.999"     p-label = "Оценочная учетная цена ингредиента"     p-user-can-edit  = true     p-output-display = true     p-other = "":U      .   end.
     6410               when 'no-income-goods':U then do:     assign     p-label = "Запрещен внешний приход и заказ объект-поставщик по товару на объекте"     p-type = 'L':U      p-format = "+/ "     p-label = "Запрещен внешний приход и заказ объект-поставщик по товару на объекте"     p-user-can-edit  = false     p-output-display = false     p-other = "":U      .   end.
     6411               when 'taracode':U then do:     assign     p-label = "Код тары для сканер-весов NCR"     p-type = 'I':U      p-format = "99"     p-label = "Код тары для сканер-весов NCR"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-taracode":U      .   end.
     6412               when 'calories-o':U then do:     assign     p-label = "Энерг.ценность ккал на 100г"     p-type = 'D':U      p-format = ">,>>9.9"     p-label = "Энерг.ценность ккал на 100г"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     6413               when 'protein-o':U then do:     assign     p-label = "Белки г на 100г"     p-type = 'D':U      p-format = ">9.9"     p-label = "Белки г на 100г"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     6414               when 'fat-o':U then do:     assign     p-label = "Жиры г на 100г"     p-type = 'D':U      p-format = ">9.9"     p-label = "Жиры г на 100г"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     6415               when 'carbohydrate-o':U then do:     assign     p-label = "Углеводы г на 100г"     p-type = 'D':U      p-format = ">9.9"     p-label = "Углеводы г на 100г"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     6416               when 'doc-tickets':U then do:     assign     p-label = "Количество ценников"     p-type = 'C':U      p-format = "X(21)"     p-label = "Количество ценников"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-doc-tickets"      .   end.
     6417               when 'normal-wastage-o':U then do:     assign     p-label = "Нормы естественной убыли для топлива кг/т"     p-type = 'C':U      p-format = "X(21)"     p-label = "Нормы естественной убыли для топлива кг/т"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-normal-wastage"      .   end.
     6418               when 'dop-alt-name-o':U then do:     assign     p-label = "Дополнение к названию товара"     p-type = 'C':U      p-format = "X(40)"     p-label = "Дополнение к названию товара"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-dop-alt-name"      .   end.
     6419               when 'dt-seasons':U then do:     assign     p-label = "Сезон ДТ"     p-type = 'C':U      p-format = "X(50)"     p-label = "Сезон ДТ"     p-user-can-edit  = true     p-output-display = true     p-other = "spr=gds-obj-dt-seasons/cd=IBM-XML/send2kassa=promoAction"      .   end.
     6420               when 'change-dt-seasons':U then do:     assign     p-label = "дата/время изменения сезон"     p-type = 'C':U      p-format = "X(50)"     p-label = "дата/время изменения сезон"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     6421               when 'mark-collect-type':U then do:     assign     p-label = "Тип сбора марок"     p-type = 'I':U      p-format = "9"     p-label = "Тип сбора марок"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     6422         otherwise do:
     6423           undo, return error substitute("неизвестный атрибут товара на объекте &1", p-code ).
     6424         end.
     6425       end.
     6426     end.
     6427   end procedure.
     6428   procedure gdsoattr-tooltip :
     6429   do
     6430     on error undo, return error
     6431     :
     6432       define input  parameter p-code    as character no-undo .
     6433       define output parameter p-tooltip as character no-undo .
     6434       define output parameter p-label   as character no-undo .
     6435       case p-code :
     6436               when 'scales-code':U then do:     assign     p-tooltip = "Код для весов, который будет отослан на весы для данного товара на данном объекте"     p-label = "Код для весов на объекте" .   end.
     6437               when 'free-price':U then do:     assign     p-tooltip = "Кассир вручную вводит цену товара на кассе (IBM-POS, IBS TH POS)"     p-label = "Товар со свободной ценой на кассе" .   end.
     6438               when 'sum-grp':U then do:     assign     p-tooltip = "Номер группы товаров на кассе (IBM-POS, IBS TH POS)"     p-label = "Группа товаров на кассе" .   end.
     6439               when 'increase-pc':U then do:     assign     p-tooltip = "Наценка на объекте"     p-label = "Наценка" .   end.
     6440               when 'min-zapas':U then do:     assign     p-tooltip = "Минимальный запас на объекте"     p-label = "Минимальный запас" .   end.
     6441               when 'round-method':U then do:     assign     p-tooltip = "Метод округления цены при расчете переоценки"     p-label = "Метод округления " .   end.
     6442               when 'petrol-purse':U then do:     assign     p-tooltip = "Товар оплачивается топливным кошельком смарт карты (IBM-POS)"     p-label = "Топливный кошелек (IBM-POS)" .   end.
     6443               when 'need-auth':U then do:     assign     p-tooltip = "Товар требует авторизации на кассе (IBM-XML)"     p-label = "Требует авторизации на кассе (IBM-XML)" .   end.
     6444               when 'gds-margins':U then do:     assign     p-tooltip = "Диапазоны торговой наценки при расчете переоценки"     p-label = "Диапазоны торговой наценки" .   end.
     6445               when 'proprietor':U then do:     assign     p-tooltip = "Принадлежность товара объекту в пределах одной ТПСИ"     p-label = "Принадлежность товара объекту" .   end.
     6446               when 'fbr-cost-rubl':U then do:     assign     p-tooltip = "Оценочная учетная цена ингредиента для калькуляционной карточки"     p-label = "Оценочная учетная цена ингредиента" .   end.
     6447               when 'no-income-goods':U then do:     assign     p-tooltip = "Запрещен внешний приход и заказ объект-поставщик по товару на объекте"     p-label = "Запрещен внешний приход и заказ объект-поставщик по товару на объекте" .   end.
     6448               when 'taracode':U then do:     assign     p-tooltip = "Код тары для сканер-весов NCR"     p-label = "Код тары для сканер-весов NCR" .   end.
     6449               when 'calories-o':U then do:     assign     p-tooltip = "Энерг.ценность ккал на 100г"     p-label = "Энерг.ценность ккал на 100г" .   end.
     6450               when 'protein-o':U then do:     assign     p-tooltip = "Белки г на 100г"     p-label = "Белки г на 100г" .   end.
     6451               when 'fat-o':U then do:     assign     p-tooltip = "Жиры г на 100г"     p-label = "Жиры г на 100г" .   end.
     6452               when 'carbohydrate-o':U then do:     assign     p-tooltip = "Углеводы г на 100г"     p-label = "Углеводы г на 100г" .   end.
     6453               when 'doc-tickets':U then do:     assign     p-tooltip = "Способ задания количества ценников при печати из документа"     p-label = "Количество ценников" .   end.
     6454               when 'normal-wastage-o':U then do:     assign     p-tooltip = "Нормы естественной убыли для топлива кг/т"     p-label = "Нормы естественной убыли для топлива кг/т" .   end.
     6455               when 'dop-alt-name-o':U then do:     assign     p-tooltip = "Дополнение к названию товара"     p-label = "Дополнение к названию товара" .   end.
     6456               when 'dt-seasons':U then do:     assign     p-tooltip = "Сезон ДТ"     p-label = "Сезон ДТ" .   end.
     6457               when 'change-dt-seasons':U then do:     assign     p-tooltip = "дата/время изменения сезон"     p-label = "дата/время изменения сезон" .   end.
     6458               when 'mark-collect-type':U then do:     assign     p-tooltip = "Тип сбора марок"     p-label = "Тип сбора марок" .   end.
     6459         otherwise do:
     6460           undo, return error substitute("Неизвестный атрибут товара на объекте &1", p-code ).
     6461         end.
     6462       end.
     6463     end.
     6464   end procedure.
     6465   procedure gdsoattr-value :
     6466    do
     6467     on error undo, return error
     6468     :
     6469       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     6470       define input  parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     6471       define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     6472       define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     6473       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     6474       define output parameter p-type     as character no-undo .
     6475       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     6476       define variable v-format         as character no-undo .
     6477       define variable v-label          as character no-undo .
     6478       define variable v-user-can-edit  as logical   no-undo .
     6479       define variable v-output-display as logical   no-undo .
     6480       define variable v-other          as character no-undo .
     6481       run gdsoattr-name in this-procedure
     6482         (input  p-code
     6483         ,output p-type
     6484         ,output v-format
     6485         ,output v-label
     6486         ,output v-user-can-edit
     6487         ,output v-output-display
     6488         ,output v-other
     6489         ) no-error .
     6490       if error-status :error then do:
     6491         undo, return error return-value .
     6492       end.
     6493       find first buf_gds-obj-attr no-lock where
     6494                  buf_gds-obj-attr.gds-code  = p-gds-code AND
     6495                  buf_gds-obj-attr.obj-type  = p-obj-type AND
     6496                  buf_gds-obj-attr.obj-code  = p-obj-code AND
     6497                  buf_gds-obj-attr.attr-code = p-code
     6498         no-error .
     6499       if avail buf_gds-obj-attr then do:
     6500         assign
     6501           p-value =  buf_gds-obj-attr.attr-value
     6502         .
     6503       end.
     6504       else do:
     6505         assign
     6506           p-value = if p-type = 'L':U then "no":U else ""
     6507         .
     6508       end.
     6509     end.
     6510   end procedure.
     6511   procedure gdsoattr-gds-code :
     6512    do
     6513     on error undo, return error
     6514     :
     6515       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     6516       define input  parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     6517       define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     6518       define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     6519       define output parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     6520       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     6521       define variable v-format         as character no-undo .
     6522       define variable v-label          as character no-undo .
     6523       define variable v-user-can-edit  as logical   no-undo .
     6524       define variable v-output-display as logical   no-undo .
     6525       define variable v-other          as character no-undo .
     6526       find first buf_gds-obj-attr no-lock where
     6527                  buf_gds-obj-attr.obj-type  = p-obj-type AND
     6528                  buf_gds-obj-attr.obj-code  = p-obj-code AND
     6529                  buf_gds-obj-attr.attr-code  = p-code AND
     6530                  buf_gds-obj-attr.attr-value = p-value
     6531         no-error .
     6532       if avail buf_gds-obj-attr then
     6533         p-gds-code =  buf_gds-obj-attr.gds-code.
     6534     end.
     6535   end procedure.
     6536   procedure gdsoattr-write :
     6537     do
     6538     on error undo, return error
     6539     :
     6540       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     6541       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     6542       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     6543       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     6544       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     6545       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     6546       define buffer lock_gds-obj-attr for ub.gds-obj-attr .
     6547       define variable v-type           as character no-undo .
     6548       define variable v-format         as character no-undo .
     6549       define variable v-label          as character no-undo .
     6550       define variable v-user-can-edit  as logical   no-undo .
     6551       define variable v-output-display as logical   no-undo .
     6552       define variable v-other          as character no-undo .
     6553       run gdsoattr-name in this-procedure
     6554         (input  p-code
     6555         ,output v-type
     6556         ,output v-format
     6557         ,output v-label
     6558         ,output v-user-can-edit
     6559         ,output v-output-display
     6560         ,output v-other
     6561         ) no-error .
     6562       if error-status :error then do:
     6563         undo, return error return-value .
     6564       end.
     6565       find first buf_gds-obj-attr exclusive-lock where
     6566                  buf_gds-obj-attr.gds-code  = p-gds-code AND
     6567                  buf_gds-obj-attr.obj-type  = p-obj-type AND
     6568                  buf_gds-obj-attr.obj-code  = p-obj-code AND
     6569                  buf_gds-obj-attr.attr-code = p-code no-error .
     6570       if not available buf_gds-obj-attr then do:
     6571         create buf_gds-obj-attr .
     6572         assign
     6573           buf_gds-obj-attr.gds-code  = p-gds-code
     6574           buf_gds-obj-attr.obj-type  = p-obj-type
     6575           buf_gds-obj-attr.obj-code  = p-obj-code
     6576           buf_gds-obj-attr.attr-code = p-code
     6577           buf_gds-obj-attr.attr-value = p-value no-error
     6578         .
     6579       end.
     6580       ELSE
     6581       ASSIGN
     6582       buf_gds-obj-attr.attr-value = p-value no-error.
     6583     end.
     6584   end procedure.
     6585   procedure gdsoattr-exist :
     6586     do
     6587     on error undo, return error
     6588     :
     6589       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     6590       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     6591       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     6592       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     6593       define output parameter p-exist    as logical no-undo .
     6594       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     6595       define variable v-type           as character no-undo .
     6596       define variable v-format         as character no-undo .
     6597       define variable v-label          as character no-undo .
     6598       define variable v-user-can-edit  as logical   no-undo .
     6599       define variable v-output-display as logical   no-undo .
     6600       define variable v-other          as character no-undo .
     6601       run gdsoattr-name in this-procedure
     6602         (input  p-code
     6603         ,output v-type
     6604         ,output v-format
     6605         ,output v-label
     6606         ,output v-user-can-edit
     6607         ,output v-output-display
     6608         ,output v-other
     6609         ) no-error .
     6610       if error-status :error then do:
     6611         undo, return error return-value .
     6612       end.
     6613       find first buf_gds-obj-attr no-lock where
     6614                  buf_gds-obj-attr.gds-code  = p-gds-code AND
     6615                  buf_gds-obj-attr.obj-type  = p-obj-type AND
     6616                  buf_gds-obj-attr.obj-code  = p-obj-code AND
     6617                  buf_gds-obj-attr.attr-code = p-code no-error .
     6618       if available buf_gds-obj-attr then do:
     6619         P-EXIST = YES.
     6620       end.
     6621     end.
     6622   end procedure.
     6623   procedure gdsoattr-delete :
     6624     do
     6625     on error undo, return error
     6626     :
     6627       define input parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     6628       define input parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     6629       define input parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     6630       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     6631       define output parameter p-deleted  as logical no-undo .
     6632       define buffer buf_gds-obj-attr for ub.gds-obj-attr .
     6633       define variable v-type           as character no-undo .
     6634       define variable v-format         as character no-undo .
     6635       define variable v-label          as character no-undo .
     6636       define variable v-user-can-edit  as logical   no-undo .
     6637       define variable v-output-display as logical   no-undo .
     6638       define variable v-other          as character no-undo .
     6639       run gdsoattr-name in this-procedure
     6640         (input  p-code
     6641         ,output v-type
     6642         ,output v-format
     6643         ,output v-label
     6644         ,output v-user-can-edit
     6645         ,output v-output-display
     6646         ,output v-other
     6647         ) no-error .
     6648       if error-status :error then do:
     6649         undo, return error return-value .
     6650       end.
     6651       find first buf_gds-obj-attr exclusive-lock where
     6652                  buf_gds-obj-attr.gds-code  = p-gds-code AND
     6653                  buf_gds-obj-attr.obj-type  = p-obj-type AND
     6654                  buf_gds-obj-attr.obj-code  = p-obj-code AND
     6655                  buf_gds-obj-attr.attr-code = p-code no-error .
     6656       if not available buf_gds-obj-attr then do:
     6657         P-DELETED = NO.
     6658       end.
     6659       ELSE DO:
     6660          delete buf_gds-obj-attr.
     6661          P-DELETED = YES.
     6662       END.
     6663     end.
     6664   end procedure.
     6665   procedure gds-obj-gds-margins :
     6666   define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     6667   define input parameter p-obj-type like ub.gds-obj-attr.obj-type no-undo .
     6668   define input parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     6669   define input-output parameter p-value as character no-undo .
     6670   define output parameter p-setted as logical no-undo .
     6671   DEFINE VARIABLE v-value as character no-undo .
     6672     do
     6673     on error undo, return error
     6674     :
     6675       assign
     6676       v-value = p-value.
     6677       run ref/gdsprmar.w (
     6678                       input p-gds-code
     6679                      ,input p-obj-type
     6680                      ,input p-obj-code
     6681                      ,input-output v-value) no-error .
     6682       if p-value <> v-value then do:
     6683         assign
     6684         p-setted = yes
     6685         p-value = v-value
     6686         .
     6687       end.
     6688     end.
     6689   end procedure.
