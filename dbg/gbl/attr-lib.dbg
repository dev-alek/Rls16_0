     1895       if index(p-code, chr(4)) > 0 then do:
     1896         p-code = entry(1, p-code, chr(4)).
     1897       end.
     1898       case p-code :
     1899               when 'doc-start':U then do:     assign     p-news = false.   end.
     1900               when 'arh-detail':U then do:     assign     p-news = false.   end.
     1901               when 'arh-start':U then do:     assign     p-news = false.   end.
     1902               when 'ahsp-detail':U then do:     assign     p-news = false.   end.
