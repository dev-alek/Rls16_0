     7609               when 'hist-code':U then do:     assign     p-label = "Исторический код объекта"     p-type = 'C':U      p-format = "x(50)"     p-label = "Исторический код объекта"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
