     1975   procedure clntattr-copy-to :
     1976   do
     1977     on error undo, return error
     1978     :
     1979     define input  parameter p-obj-type as character no-undo .
     1980     define input  parameter p-obj-code as integer   no-undo .
     1981     define input  parameter p-code     as character no-undo .
     1982     define input  parameter p-bh       as handle no-undo .
     1983     define buffer buf-clients-attr for ub.clients-attr.
     1984     define variable v-format         as character no-undo .
     1985     define variable v-label          as character no-undo .
     1986     define variable v-user-can-edit  as logical   no-undo .
     1987     define variable v-output-display as logical   no-undo .
     1988     define variable v-other          as character no-undo .
     1989     define variable v-type           as character no-undo .
     1990     run  clntattr-code  in this-procedure
     1991         (input  p-code
     1992         ,output v-type
     1993         ,output v-format
     1994         ,output v-label
     1995         ,output v-user-can-edit
     1996         ,output v-output-display
     1997         ,output v-other
     1998         ) no-error .
     1999       if error-status :error then do:
     2000         undo, return error return-value .
     2001       end.
     2002       Find first  buf-clients-attr no-lock where
     2003                   buf-clients-attr.attr-code = p-code
     2004               and buf-clients-attr.obj-type = p-obj-type
     2005               and buf-clients-attr.obj-code = p-obj-code
     2006                no-error .
     2007      if not p-bh:available then do:
     2008        p-bh:buffer-create().
     2009      end.
     2010      if avail buf-clients-attr then do:
     2011        assign
     2012        p-bh:buffer-field("attr-value"):buffer-value = buf-clients-attr.attr-value.
     2013      end.
     2014      else do:
     2015        assign
     2016        p-bh:buffer-field("attr-value"):buffer-value = if v-type = 'L':U then "no":U else "".
     2017      end.
     2018   end.
     2019   end procedure.
     2020   procedure clntattr-get-archive-attr :
