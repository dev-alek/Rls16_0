     8197       define variable v-output-display as logical   no-undo .
     8198       define variable v-other          as character no-undo .
     8199       run ext-system-attr-code in this-procedure
     8200         (input  p-code
     8201         ,output v-type
     8202         ,output v-format
     8203         ,output v-label
     8204         ,output v-user-can-edit
     8205         ,output v-output-display
     8206         ,output v-other
     8207         ) no-error .
     8208       if error-status :error then do:
     8209         undo, return error return-value .
     8210       end.
     8211       find first buf_ext-system-attr no-lock
     8212         where buf_ext-system-attr.esys-id   = p-esys-id
     8213           and buf_ext-system-attr.db-num    = p-db-num
     8214           and buf_ext-system-attr.esya-attr-code = p-code
