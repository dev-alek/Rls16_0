     7599               when 'cut-db-list':U then do:     assign     p-label = "Список БД в которых усекаются документы"     p-type = 'C':U      p-format = "X(256)"     p-label = "Список БД в которых усекаются документы"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
