     4707       define input parameter p-obj-type as character no-undo .
     4708       define input parameter p-obj-code as integer   no-undo .
     4709       define output parameter p-DELETED  AS LOGICAL no-undo .
     4710       define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr .
     4711       define variable v-type           as character no-undo .
     4712       define variable v-format         as character no-undo .
     4713       define variable v-range          as integer   no-undo .
     4714       define variable v-label          as character no-undo .
     4715       define variable v-user-can-edit  as logical   no-undo .
     4716       define variable v-output-display as logical   no-undo .
     4717       define variable v-other          as character no-undo .
     4718       run bc-oattr_name in this-procedure
     4719         (input  p-code
     4720         ,output v-type
     4721         ,output v-format
     4722         ,output v-label
     4723         ,output v-range
     4724         ,output v-user-can-edit
     4725         ,output v-output-display
     4726         ,output v-other
     4727         ) no-error .
     4728       if error-status :error then do:
     4729         undo, return error return-value .
     4730       end.
     4731       find first buf_bar-code-obj-attr no-lock where
     4732                 buf_bar-code-obj-attr.b-code  = p-b-code
     4733             AND  buf_bar-code-obj-attr.attr-code = p-code
     4734             and buf_bar-code-obj-attr.obj-type = p-obj-type
     4735             and buf_bar-code-obj-attr.obj-code = p-obj-code
     4736       no-error .
     4737       if not available buf_bar-code-obj-attr then do:
     4738         p-DELETED = NO.
     4739       end.
     4740       ELSE DO:
     4741          delete buf_bar-code-obj-attr.
     4742         p-DELETED = YES.
     4743       END.
     4744     end.
