     5314               when 'IBS-TH-MOB_rec-print':U then do:     if lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-news = logical(entry(lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'true,true' ))     p-from-gbd = logical(entry(lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'true,true' ))     p-from-ubd = logical(entry(lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'true,true' ))     no-error.   end.
     5315         otherwise do:
     5316           p-news = no.
     5317           p-from-ubd = yes.
     5318         end.
     5319       end.
     5320       return ''.
     5321     end.
     5322   end procedure.
     5323   procedure cd-attr-hist :
     5324     do
     5325     on error undo, return error
     5326     :
     5327       define input  parameter p-ucode          as character no-undo .
     5328       define input  parameter p-code           as character no-undo .
     5329       define output parameter p-hist           as logical   no-undo .
     5330       if index(p-code, chr(4)) > 0 then do:
     5331         p-ucode = entry(1, p-ucode, chr(4)).
     5332         p-code = entry(1, p-code, chr(4)).
     5333       end.
     5334       case p-ucode :
     5335               when 'MAGIA-XML_operative':U then do:     if p-code <> '' AND lookup(p-code, 'last-check-date-time':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'last-check-date-time':U ),'false' ))     no-error.   end.
     5336               when 'IBM-XML_general':U then do:     if p-code <> '' AND lookup(p-code, 'use-kbo,easyfuel':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'use-kbo,easyfuel':U ),'true,true' ))     no-error.   end.
     5337               when 'MARIA_operative':U then do:     if p-code <> '' AND lookup(p-code, 'last-check-maria,data-actuality,tot-gds,max-plu,to-send,tot-petrol,max-petrol-plu,petrol-to-send,tot-cli,max-clu,cli-to-send':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'last-check-maria,data-actuality,tot-gds,max-plu,to-send,tot-petrol,max-petrol-plu,petrol-to-send,tot-cli,max-clu,cli-to-send':U ),'false,false,false,false,false,false,false,false,false,false,false' ))     no-error.   end.
     5338               when 'MARIA_general':U then do:     if p-code <> '' AND lookup(p-code, 'max-gds,petrolium-start,petrolium-range,max-cli':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'max-gds,petrolium-start,petrolium-range,max-cli':U ),'true,true,true,true' ))     no-error.   end.
     5339               when 'INFOKIOSK_operative':U then do:     if p-code <> '' AND lookup(p-code, 'last-grp-change,last-prt-change':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'last-grp-change,last-prt-change':U ),'true,true' ))     no-error.   end.
     5340               when 'NCR-GM_general':U then do:     if p-code <> '' AND lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     5341               when 'NCR-AS-R_general':U then do:     if p-code <> '' AND lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     5342               when 'IBS-TH_main':U then do:     if p-code <> '' AND lookup(p-code, 'cash-shift,nalc,salesman-mandatory,manual-discnt,log-level,clear-cash-counter,qnty-change':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'cash-shift,nalc,salesman-mandatory,manual-discnt,log-level,clear-cash-counter,qnty-change':U ),'true,true,true,true,true,true,true' ))     no-error.   end.
     5343               when 'IBS-TH_devices':U then do:     if p-code <> '' AND lookup(p-code, 'cash-drawer-plug,cash-drawer-plug-type,cash-drawer-plug-port,cash-drawer-plug-imp,cash-drawer-open,cash-drawer-limit,card-reader-plug,customer-display-plug,customer-display-adv,keyboard-type,keyboard-layout-id,cashless-system,customer-display-type,customer-display-port,cctv-system,cctv-system-address':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'cash-drawer-plug,cash-drawer-plug-type,cash-drawer-plug-port,cash-drawer-plug-imp,cash-drawer-open,cash-drawer-limit,card-reader-plug,customer-display-plug,customer-display-adv,keyboard-type,keyboard-layout-id,cashless-system,customer-display-type,customer-display-port,cctv-system,cctv-system-address':U ),'true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true' ))     no-error.   end.
     5344               when 'IBS-TH_fisreg':U then do:     if p-code <> '' AND lookup(p-code, 'cash-drawer-level,cash-pay-list,pay-names,cutter,com-port':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'cash-drawer-level,cash-pay-list,pay-names,cutter,com-port':U ),'true,true,true,true,true' ))     no-error.   end.
     5345               when 'IBS-TH_rec-print':U then do:     if p-code <> '' AND lookup(p-code, 'max-netto,advert-text,cliche-lines,print-good-code,rmethod-type,rmethod-coeff,rcpt-ord-slip-print,rcpt-ord-alt-print':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'max-netto,advert-text,cliche-lines,print-good-code,rmethod-type,rmethod-coeff,rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'true,true,true,true,true,true,true,true' ))     no-error.   end.
     5346               when 'IBS-TH_interface':U then do:     if p-code <> '' AND lookup(p-code, 'screen-type,screen-layout-id':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'screen-type,screen-layout-id':U ),'true,true' ))     no-error.   end.
     5347               when 'IBS-TH-MOB_main':U then do:     if p-code <> '' AND lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ),'true,true' ))     no-error.   end.
     5348               when 'IBS-TH-MOB_rec-print':U then do:     if p-code <> '' AND lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-hist = logical(entry(lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'true,true' ))     no-error.   end.
     5349         otherwise do:
     5350           p-hist = no.
     5351         end.
     5352       end.
     5353       return ''.
     5354     end.
     5355   end procedure.
     5356   procedure cd-attr-parse-date-time-proc :
     5357     define input  parameter p-string       as character no-undo .
     5358     define output parameter p-time         as integer   no-undo .
     5359     define output parameter p-return-value as date      no-undo .
     5360     do
     5361     on error undo, return error return-value
     5362     :
     5363       define variable v-date as date.
     5364       define variable v-shift as integer no-undo .
     5365       if index(p-string, "-":U) = 0
     5366       or NOT (length(p-string) = 10
     5367               or
     5368               length(p-string) = 19)
     5369       then do:
     5370         return error.
     5371       end.
     5372       assign
     5373         v-date =  date(
     5374                 int( substr( p-string, 6, 2 ) ) ,
     5375                 int( substr( p-string, 9, 2 ) ),
     5376                 int( substr( p-string, 1, 4 ) )
     5377                   )
     5378       no-error .
     5379       if error-status:error
     5380       then do:
     5381         return error.
     5382       end.
     5383       if index(p-string, ":":U) = 0
     5384       or not (
     5385               length(p-string) = 19
     5386               or
     5387               length(p-string) = 8
     5388               )
     5389       then do:
     5390         return error.
     5391       end.
     5392       if length(p-string) = 19 then v-shift = 11.
     5393       assign
     5394       p-time =  int( substr( p-string, v-shift + 1, 2 ) ) * 3600 +
     5395                 int( substr( p-string, v-shift + 4, 2 ) ) * 60  +
     5396                 int( substr( p-string, v-shift + 7, 2) )
     5397       no-error .
     5398       if error-status:error then do:
     5399         return error.
     5400       end.
     5401       assign
     5402         p-return-value = v-date
     5403       .
     5404     end.
     5405   end procedure.
     5406   procedure last-check-date-time :
     5407     define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     5408     define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     5409     define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
     5410     define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
     5411     define input-output parameter p-character as character no-undo .
     5412     define input-output parameter p-date      as date      no-undo .
     5413     define input-output parameter p-decimal   as decimal   no-undo .
     5414     define input-output parameter p-integer   as integer   no-undo .
     5415     define input-output parameter p-logical   as logical   no-undo .
     5416     define output parameter p-setted as logical no-undo .
     5417     define variable v-value as character no-undo .
     5418     define variable v-codes as character no-undo .
     5419     define variable v-labels as character no-undo .
     5420     define variable v-date as date no-undo .
     5421     define variable v-time as integer no-undo .
     5422     define variable v-date2 as date no-undo .
     5423     define variable v-time2 as integer no-undo .
     5424     define variable v-ok as logical no-undo .
     5425     do
     5426     on error undo, return error
     5427     :
     5428       assign
     5429         v-value = p-character
     5430       .
     5431       run cd-attr-parse-date-time-proc in this-procedure
     5432         (input  v-value
     5433         ,output v-time
     5434         ,output v-date
     5435         ) no-error .
     5436       run gbl/d-time.w (
     5437                       input "Введите дату и время последнего полученного чека по данной кассе"
     5438                      ,input ?
     5439                      ,input 1
     5440                      ,input-output v-date
     5441                      ,input-output v-date2
     5442                      ,input-output v-time
     5443                      ,input-output v-time2
     5444                      ,output v-ok
     5445                      ) no-error .
     5446       assign
     5447       v-value = string(YEAR(v-date), "9999":U) + "-":U +
     5448                string(Month(v-date), "99":U) + "-":U +
     5449                string(DAY(v-date), "99":U) +
     5450                chr(32)  +  string(v-time, "HH:MM:SS":U).
     5451       if
     5452       v-ok and
     5453       p-character <> v-value and v-value <> ? and not error-status:error then do:
     5454         assign
     5455         p-setted = yes
     5456         p-character = v-value
     5457         .
     5458       end.
     5459     end.
     5460   end procedure.
     5461   procedure cd-attr-cd-datetostring-proc :
     5462     define input  parameter p-date         as date      no-undo .
     5463     define output parameter p-return-value as character no-undo .
     5464     do
     5465     on error undo, return error return-value
     5466     :
     5467       assign
     5468         p-return-value = string(YEAR(p-date), "9999":U) + "-":U +
     5469                          string(Month(p-date), "99":U) + "-":U +
     5470                          string(DAY(p-date), "99":U)
     5471       .
     5472     end.
     5473   end procedure.
     5474   procedure cd-attr-last-report-params :
     5475     define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     5476     define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     5477     define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
     5478     define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
     5479     define input-output parameter p-character as character no-undo .
     5480     define input-output parameter p-date      as date      no-undo .
     5481     define input-output parameter p-decimal   as decimal   no-undo .
     5482     define input-output parameter p-integer   as integer   no-undo .
     5483     define input-output parameter p-logical   as logical   no-undo .
     5484     define output parameter p-setted as logical no-undo .
     5485     define variable v-value as character no-undo .
     5486     define variable v-codes as character no-undo .
     5487     define variable v-labels as character no-undo .
     5488     define variable v-date as date no-undo .
     5489     define variable v-time as integer no-undo .
     5490     define variable v-date2 as date no-undo .
     5491     define variable v-time2 as integer no-undo .
     5492     define variable v-shift-num as integer no-undo .
     5493     define variable v-shift-num2 as integer no-undo .
     5494     define variable v-z-count as integer no-undo .
     5495     define variable v-z-count2 as integer no-undo .
     5496     define variable v-chk-num as integer no-undo .
     5497     define variable v-chk-num2 as integer no-undo .
     5498     define variable v-ok as logical no-undo .
     5499     do
     5500     on error undo, return error
     5501     :
     5502       assign
     5503       v-value = p-character
     5504       v-shift-num = (if num-entries(v-value, chr(32)) > 2
     5505                      then integer(entry(3, v-value, chr(32)  ))
     5506                      else 0)
     5507       .
     5508       run cd-attr-parse-date-time-proc in this-procedure
     5509         (input  substring(v-value, 1 , 19)
     5510         ,output v-time
     5511         ,output v-date
     5512         ) no-error .
     5513       run str/lastchkd.w (
     5514                       input "Введите параметры последнего полученного отчета по данной кассе"
     5515                      ,input ?
     5516                      ,input 1
     5517                      ,input "report"
     5518                      ,input-output v-date
     5519                      ,input-output v-date2
     5520                      ,input-output v-time
     5521                      ,input-output v-time2
     5522                      ,input-output v-shift-num
     5523                      ,input-output v-shift-num2
     5524                      ,input-output v-z-count
     5525                      ,input-output v-z-count2
     5526                      ,input-output v-chk-num
     5527                      ,input-output v-chk-num2
     5528                      ,output v-ok
     5529                      )  .
     5530       assign
     5531       v-value = string(YEAR(v-date), "9999":U) + "-":U +
     5532                string(Month(v-date), "99":U) + "-":U +
     5533                string(DAY(v-date), "99":U) +
     5534                chr(32)  +  string(v-time, "HH:MM:SS":U) +
     5535                chr(32) + string(v-shift-num)
     5536                .
     5537       if v-ok and
     5538       p-character <> v-value and v-value <> ? and not error-status:error then do:
     5539         assign
     5540         p-setted = yes
     5541         p-character = v-value
     5542         .
     5543       end.
     5544     end.
     5545   end procedure.
     5546   procedure cd-attr-last-check-params :
     5547     define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     5548     define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     5549     define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
     5550     define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
     5551     define input-output parameter p-character as character no-undo .
     5552     define input-output parameter p-date      as date      no-undo .
     5553     define input-output parameter p-decimal   as decimal   no-undo .
     5554     define input-output parameter p-integer   as integer   no-undo .
     5555     define input-output parameter p-logical   as logical   no-undo .
     5556     define output parameter p-setted as logical no-undo .
     5557     define variable v-value as character no-undo .
     5558     define variable v-codes as character no-undo .
     5559     define variable v-labels as character no-undo .
     5560     define variable v-date as date no-undo .
     5561     define variable v-time as integer no-undo .
     5562     define variable v-date2 as date no-undo .
     5563     define variable v-time2 as integer no-undo .
     5564     define variable v-shift-num as integer no-undo .
     5565     define variable v-shift-num2 as integer no-undo .
     5566     define variable v-z-count as integer no-undo .
     5567     define variable v-z-count2 as integer no-undo .
     5568     define variable v-chk-num as integer no-undo .
     5569     define variable v-chk-num2 as integer no-undo .
     5570     define variable v-ok as logical no-undo .
     5571     do
     5572     on error undo, return error
     5573     :
     5574       assign
     5575       v-value = p-character
     5576       v-shift-num = (if num-entries(v-value, chr(32)) > 2
     5577                      then integer(entry(3, v-value, chr(32)  ))
     5578                      else 0)
     5579       v-z-count =  (if num-entries(v-value, chr(32)) > 3
     5580                     then integer(entry(4, v-value, chr(32) ))
     5581                     else 0)
     5582       v-chk-num = (if num-entries(v-value, chr(32)) > 4
     5583                    then integer(entry(5, v-value, chr(32)))
     5584                    else  0)
     5585       .
     5586       run cd-attr-parse-date-time-proc in this-procedure
     5587         (input  substring(v-value, 1 , 19)
     5588         ,output v-time
     5589         ,output v-date
     5590         ) no-error .
     5591       run str/lastchkd.w (
     5592                       input "Введите параметры последнего полученного чека по данной кассе"
     5593                      ,input ?
     5594                      ,input 1
     5595                      ,input ""
     5596                      ,input-output v-date
     5597                      ,input-output v-date2
     5598                      ,input-output v-time
     5599                      ,input-output v-time2
     5600                      ,input-output v-shift-num
     5601                      ,input-output v-shift-num2
     5602                      ,input-output v-z-count
     5603                      ,input-output v-z-count2
     5604                      ,input-output v-chk-num
     5605                      ,input-output v-chk-num2
     5606                      ,output v-ok
     5607                      ) no-error .
     5608       assign
     5609       v-value = string(YEAR(v-date), "9999":U) + "-":U +
     5610                string(Month(v-date), "99":U) + "-":U +
     5611                string(DAY(v-date), "99":U) +
     5612                chr(32)  +  string(v-time, "HH:MM:SS":U) +
     5613                chr(32) + string(v-shift-num) +
     5614                chr(32) + string(v-z-count) +
     5615                chr(32) + string(v-chk-num)
     5616                .
     5617       if v-ok and
     5618       p-character <> v-value and v-value <> ? and not error-status:error then do:
     5619         assign
     5620         p-setted = yes
     5621         p-character = v-value
     5622         .
     5623       end.
     5624     end.
     5625   end procedure.
     5626   procedure cd-attr-last-check-maria :
     5627   define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     5628   define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     5629   define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
     5630   define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
     5631   define input-output parameter p-value as character no-undo .
     5632   define output parameter p-setted as logical no-undo .
     5633   DEFINE VARIABLE v-value as character no-undo .
     5634   define variable v-date as date no-undo .
     5635   define variable v-p-date as date no-undo .
     5636   define variable v-num-recs as decimal no-undo .
     5637   define variable v-p-num-recs as integer no-undo .
     5638   define variable v-z-count as integer no-undo .
     5639   define variable v-p-z-count as integer no-undo .
     5640   define variable v-ok as logical no-undo .
     5641     do
     5642     on error undo, return error
     5643     :
     5644       assign
     5645       v-value = p-value
     5646       v-date =  (if num-entries(entry(1, v-value, chr(32)), '-') > 1
     5647                 then  date( integer(entry(2, entry(1, v-value, chr(32)), '-':U))
     5648                      ,integer(entry(3, entry(1, v-value, chr(32)), '-':U))
     5649                      ,integer(entry(1, entry(1, v-value, chr(32)), '-':U))
     5650                      )
     5651                      else 01/01/1990)
     5652       v-z-count =  (if num-entries(v-value, chr(32)) > 1
     5653                     then integer(entry(2, v-value, chr(32) ))
     5654                     else 0)
     5655       v-num-recs =  (if num-entries(v-value, chr(32)) > 2
     5656                     then decimal(entry(3, v-value, chr(32) ))
     5657                     else 0)
     5658       v-p-date =  (if num-entries(v-value, chr(32)) > 3
     5659                   then  date( integer(entry(2, entry(4, v-value, chr(32)), '-':U))
     5660                               ,integer(entry(3, entry(4, v-value, chr(32)), '-':U))
     5661                               ,integer(entry(1, entry(4, v-value, chr(32)), '-':U))
     5662                               )
     5663                   else 01/01/1990)
     5664       v-p-z-count =  (if num-entries(v-value, chr(32)) > 4
     5665                     then integer(entry(5, v-value, chr(32) ))
     5666                     else 0)
     5667       v-p-num-recs =  (if num-entries(v-value, chr(32)) > 5
     5668                     then integer(entry(6, v-value, chr(32) ))
     5669                     else 0)
     5670       .
     5671       run ref/lastchkm.w (
     5672                       input "Введите параметры последнего полученного чека по данной кассе"
     5673                      ,input-output v-date
     5674                      ,input-output v-z-count
     5675                      ,input-output v-num-recs
     5676                      ,input-output v-p-date
     5677                      ,input-output v-p-z-count
     5678                      ,input-output v-p-num-recs
     5679                      ,output v-ok
     5680                      ) no-error .
     5681       assign
     5682       v-value = string(YEAR(v-date), "9999":U) + "-":U +
     5683                string(Month(v-date), "99":U) + "-":U +
     5684                string(DAY(v-date), "99":U) +  chr(32) +
     5685                string(v-z-count) + chr(32) +
     5686                string(v-num-recs) + chr(32) +
     5687                string(YEAR(v-p-date), "9999":U) + "-":U +
     5688                string(Month(v-p-date), "99":U) + "-":U +
     5689                string(DAY(v-p-date), "99":U) + chr(32) +
     5690                string(v-p-z-count) + chr(32) +
     5691                string(v-p-num-recs)
     5692                .
     5693       if
     5694       v-ok and
     5695       p-value <> v-value and v-value <> ? and not error-status:error then do:
     5696         assign
     5697         p-setted = yes
     5698         p-value = v-value
     5699         .
     5700       end.
     5701     end.
     5702   end procedure.
     5703   procedure cd-attr-periodic-tasks :
     5704     define input parameter p-db-num like ub.cash-desk-attr.db-num no-undo .
     5705     define input parameter p-obj-code like ub.cash-desk-attr.obj-code no-undo .
     5706     define input parameter p-pos-type like ub.cash-desk-attr.pos-type no-undo .
     5707     define input parameter p-cash-num like ub.cash-desk-attr.cash-num no-undo .
     5708     define input-output parameter p-value as character no-undo .
     5709     define output parameter p-setted as logical no-undo .
     5710     define variable v-value as character no-undo .
     5711     define variable v-ok as logical no-undo .
     5712     define variable v-obj-list as character no-undo .
     5713     define variable v-params as character no-undo .
     5714     do
     5715     on error undo, return error
     5716     :
     5717       assign
     5718       v-value = p-value
     5719       v-obj-list = entry(1, v-value , chr(32) )
     5720       v-params = if num-entries(v-value, chr(32)) > 1 then entry(2, v-value , chr(32) ) else '':U
     5721       .
     5722       run ref/mariatsk.w (
     5723                            input-output v-obj-list
     5724                           ,input-output v-params
     5725                           ,output v-ok
     5726                           ) no-error .
     5727       v-value = v-obj-list + chr(32) + v-params.
     5728       if
     5729       v-ok and
     5730       p-value <> v-value and v-value <> ? and not error-status:error then do:
     5731         assign
     5732         p-setted = yes
     5733         p-value = v-value
     5734         .
     5735       end.
     5736     end.
     5737   end procedure.
     5738   procedure cd-attr_get-attr-int-proc :
     5739     define parameter buffer buf_cash-desk  for ub.cash-desk .
     5740     define input  parameter p-upper-attr-code    as character no-undo .
     5741     define input  parameter p-attr-code    as character no-undo .
     5742     define output parameter p-mes          as character no-undo .
     5743     define output parameter p-return-value as integer   no-undo .
     5744     define variable par-type as character no-undo .
     5745     define variable v-character as character no-undo .
     5746     define variable v-date as date no-undo .
     5747     define variable v-decimal as decimal no-undo .
     5748     define variable v-integer as integer no-undo .
     5749     define variable v-logical as integer no-undo .
     5750     do
     5751     on error undo, return error return-value
     5752     :
     5753       run cd-attr-value in this-procedure
     5754         (input   buf_cash-desk.db-num
     5755         ,input  buf_cash-desk.obj-code
     5756         ,input  buf_cash-desk.pos-type
     5757         ,input  buf_cash-desk.cash-num
     5758         ,input  p-upper-attr-code
     5759         ,input  p-attr-code
     5760         ,output v-character
     5761         ,output v-date
     5762         ,output v-decimal
     5763         ,output v-integer
     5764         ,output v-logical
     5765         ,output par-type
     5766         ) no-error .
     5767       if error-status :error
     5768       then do:
     5769         assign
     5770           p-mes = substitute("Не удалось получить значение атрибута &7 для кассы &1 &2&3:&4&5 &6"
     5771                             ,buf_cash-desk.cash-num
     5772                             , 'маг':U
     5773                             ,buf_cash-desk.obj-code
     5774                             , chr(10)
     5775                             , error-status:get-message(1)
     5776                             , return-value
     5777                             , p-attr-code
     5778                             )
     5779           p-return-value = ?
     5780         .
     5781         return .
     5782       end.
     5783       assign
     5784       p-return-value = v-integer
     5785       .
     5786     end.
     5787   end procedure.
     5788   procedure cd-attr_get-attr-log-proc :
     5789     define parameter buffer buf_cash-desk  for ub.cash-desk .
     5790     define input  parameter p-upper-attr-code    as character no-undo .
     5791     define input  parameter p-attr-code    as character no-undo .
     5792     define output parameter p-mes          as character no-undo .
     5793     define output parameter p-return-value as logical   no-undo .
     5794     define variable v-character as character no-undo .
     5795     define variable v-date as date no-undo .
     5796     define variable v-decimal as decimal no-undo .
     5797     define variable v-integer as integer no-undo .
     5798     define variable v-logical as logical no-undo .
     5799     define variable par-type as character no-undo .
     5800     do
     5801     on error undo, return error return-value
     5802     :
     5803       run cd-attr-value IN THIS-PROCEDURE
     5804         (input  buf_cash-desk.db-num
     5805         ,input  buf_cash-desk.obj-code
     5806         ,input  buf_cash-desk.pos-type
     5807         ,input  buf_cash-desk.cash-num
     5808         ,input  p-upper-attr-code
     5809         ,input  p-attr-code
     5810         ,output v-character
     5811         ,output v-date
     5812         ,output v-decimal
     5813         ,output v-integer
     5814         ,output v-logical
     5815         ,output par-type
     5816         ) no-error .
     5817       if error-status :error
     5818       then do:
     5819         assign
     5820           p-mes = substitute("Не удалось получить значение атрибута &7 для кассы &1 &2&3:&4&5 &6"
     5821                             ,buf_cash-desk.cash-num
     5822                             , 'маг':U
     5823                             ,buf_cash-desk.obj-code
     5824                             , chr(10)
     5825                             , error-status:get-message(1)
     5826                             , return-value
     5827                             , p-attr-code
     5828                             )
     5829           p-return-value = ?
     5830         .
     5831         return.
     5832       end.
     5833       assign
