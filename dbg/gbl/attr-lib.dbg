     4988               when 'IBS-TH-MOB_main':U then do:     assign     p-tooltip = "Основные настройки POS IBS-TH-MOB"     p-label = "Основные настройки"     p-label = p-label +     (if p-code = '':U then '':U else (":" + entry(lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ), ',Обязателен продавец,Тип POS, с которого брать скидки')))     p-tooltip =     (if p-code = '':U then '':U      else (entry(lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ),''))) no-error.   end.
