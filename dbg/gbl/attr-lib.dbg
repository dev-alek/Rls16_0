     1705   procedure clntattr-value :
     1706     do
     1707     on error undo, return error return-value
     1708     :
     1709       define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1710       define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1711       define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1712       define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     1713       define output parameter p-type     as character no-undo .
     1714       define buffer buf_clients-attr for ub.clients-attr .
     1715       define variable v-format         as character no-undo .
     1716       define variable v-label          as character no-undo .
     1717       define variable v-user-can-edit  as logical   no-undo .
     1718       define variable v-output-display as logical   no-undo .
     1719       define variable v-other          as character no-undo .
     1720       run clntattr-code in this-procedure
     1721         (input  p-code
     1722         ,output p-type
     1723         ,output v-format
     1724         ,output v-label
     1725         ,output v-user-can-edit
     1726         ,output v-output-display
     1727         ,output v-other
     1728         ) no-error .
     1729       if error-status :error then do:
     1730         undo, return error return-value .
     1731       end.
     1732       find first buf_clients-attr no-lock
     1733         where buf_clients-attr.obj-type  = p-obj-type
     1734           and buf_clients-attr.obj-code  = p-obj-code
     1735           and buf_clients-attr.attr-code = p-code
     1736         no-error .
     1737       if avail buf_clients-attr then do:
     1738         assign
     1739           p-value =  buf_clients-attr.attr-value
     1740         .
     1741       end.
     1742       else do:
     1743         assign
     1744           p-value = if p-type = 'L':U then "no":U else ""
     1745         .
     1746       end.
     1747     end.
     1748   end procedure.
     1749   procedure clntattr-write :
     1750     do
     1751     on error undo, return error return-value
     1752     :
     1753       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1754       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1755       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1756       define input parameter p-value    like ub.clients-attr.attr-value no-undo .
     1757       define buffer buf_clients-attr for ub.clients-attr .
     1758       define variable v-type           as character no-undo .
     1759       define variable v-format         as character no-undo .
     1760       define variable v-label          as character no-undo .
     1761       define variable v-user-can-edit  as logical   no-undo .
     1762       define variable v-output-display as logical   no-undo .
     1763       define variable v-other          as character no-undo .
     1764       run clntattr-code in this-procedure
     1765         (input  p-code
     1766         ,output v-type
     1767         ,output v-format
     1768         ,output v-label
     1769         ,output v-user-can-edit
     1770         ,output v-output-display
     1771         ,output v-other
     1772         ) no-error .
     1773       if error-status :error then do:
     1774         undo, return error return-value .
     1775       end.
     1776       find first buf_clients-attr exclusive-lock
     1777         where buf_clients-attr.obj-type  = p-obj-type
     1778           and buf_clients-attr.obj-code  = p-obj-code
     1779           and buf_clients-attr.attr-code = p-code
     1780         no-error .
     1781       if not available buf_clients-attr then do:
     1782         create buf_clients-attr .
     1783         assign
     1784           buf_clients-attr.obj-type  = p-obj-type
     1785           buf_clients-attr.obj-code  = p-obj-code
     1786           buf_clients-attr.attr-code = p-code
     1787         .
     1788       end.
     1789       assign
     1790         buf_clients-attr.attr-value = p-value
     1791       .
     1792       release buf_clients-attr no-error.
     1793       if error-status:error then do:
     1794         return error substitute("Ошибка при сохранение атрибута &1 клиента &2&3: &4 &5"
     1795                                , p-code
     1796                                , p-obj-type
     1797                                , p-obj-code
     1798                                , error-status:get-message(1)
     1799                                , return-value ).
     1800       end.
     1801     end.
     1802   end procedure.
     1803   procedure clntattr-exist :
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1808       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1809       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1810       define output parameter p-exist   as logical  no-undo .
     1811       define buffer buf_clients-attr for ub.clients-attr .
     1812       define variable v-type           as character no-undo .
     1813       define variable v-format         as character no-undo .
     1814       define variable v-label          as character no-undo .
     1815       define variable v-user-can-edit  as logical   no-undo .
     1816       define variable v-output-display as logical   no-undo .
     1817       define variable v-other          as character no-undo .
     1818       run clntattr-code in this-procedure
     1819         (input  p-code
     1820         ,output v-type
     1821         ,output v-format
     1822         ,output v-label
     1823         ,output v-user-can-edit
     1824         ,output v-output-display
     1825         ,output v-other
     1826         ) no-error .
     1827       if error-status :error then do:
     1828         undo, return error return-value .
     1829       end.
     1830       find first buf_clients-attr no-lock
     1831         where buf_clients-attr.obj-type  = p-obj-type
     1832           and buf_clients-attr.obj-code  = p-obj-code
     1833           and buf_clients-attr.attr-code = p-code
     1834         no-error .
     1835       if  available buf_clients-attr then do:
     1836         p-exist = yes.
     1837       end.
     1838     end.
     1839   end procedure.
     1840   procedure clntattr-delete :
     1841     do
     1842     on error undo, return error return-value
     1843     :
     1844       define input parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1845       define input parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1846       define input parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1847       define output parameter p-deleted  as logical no-undo.
     1848       define buffer buf_clients-attr for ub.clients-attr .
     1849       define variable v-type           as character no-undo .
     1850       define variable v-format         as character no-undo .
     1851       define variable v-label          as character no-undo .
     1852       define variable v-user-can-edit  as logical   no-undo .
     1853       define variable v-output-display as logical   no-undo .
     1854       define variable v-other          as character no-undo .
     1855       run clntattr-code in this-procedure
     1856         (input  p-code
     1857         ,output v-type
     1858         ,output v-format
     1859         ,output v-label
     1860         ,output v-user-can-edit
     1861         ,output v-output-display
     1862         ,output v-other
     1863         ) no-error .
     1864       if error-status :error then do:
     1865         undo, return error return-value .
     1866       end.
     1867       find first buf_clients-attr exclusive-lock
     1868         where buf_clients-attr.obj-type  = p-obj-type
     1869           and buf_clients-attr.obj-code  = p-obj-code
     1870           and buf_clients-attr.attr-code = p-code
     1871         no-error NO-WAIT.
     1872       if not available buf_clients-attr then do:
     1873         p-deleted = no.
     1874       end.
     1875       else do:
     1876         delete buf_clients-attr no-error .
     1877         if error-status:error then do:
     1878           return error substitute("Ошибка при удалении атрибута &1 клиента &2&3: &4 &5"
     1879                                 , p-code
     1880                                 , p-obj-type
     1881                                 , p-obj-code
     1882                                 , error-status:get-message(1)
     1883                                 , return-value ).
     1884         end.
     1885         p-deleted = yes.
     1886       end.
     1887     end.
     1888   end procedure.
     1889   procedure clntattr-news :
     1890     do
     1891     on error undo, return error
     1892     :
     1893       define input  parameter p-code           as character no-undo .
