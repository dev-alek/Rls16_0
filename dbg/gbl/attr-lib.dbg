     2283   procedure clntattr-cli-clim-grp :
     2284     define input parameter parparentproc as handle no-undo .
     2285     define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2286     define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2287     define input-output parameter p-value as character no-undo .
     2288     define output parameter p-setted as logical no-undo .
     2289     define variable v-code  as character no-undo.
     2290     define variable v-value as character no-undo .
     2291     define variable v-dlg as class ibs.th.ref.dclimgrp no-undo .
     2292     define variable v-err-msg as character no-undo .
     2293     do on error undo, throw :
     2294       v-dlg = new ibs.th.ref.dclimgrp().
     2295       if num-entries (p-value) = 3 then do :
     2296         assign
     2297         v-dlg:climGrp     = entry(1, p-value)
     2298         v-dlg:beginSummer = entry(2, p-value)
     2299         v-dlg:beginWinter = entry(3, p-value)
     2300         .
     2301       end .
     2302       v-dlg:ShowModalDialog().
     2303       if v-dlg:DialogResult = System.Windows.Forms.DialogResult:Ok then do:
     2304         assign
     2305           p-value  = substitute("&1,&2,&3", v-dlg:climGrp, v-dlg:beginSummer, v-dlg:beginWinter)
     2306           p-setted = yes
     2307         .
     2308       end .
     2309       v-err-msg = "" .
     2310       catch exAppErrors as class Progress.Lang.AppError :
     2311         v-err-msg = exAppErrors:ReturnValue .
     2312         if v-err-msg > "" then . else do :
     2313           v-err-msg = exAppErrors:GetMessage(1) .
     2314           if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\attr-lib.p" .
     2315         end .
     2316       end catch .
     2317       catch exProErrors as class Progress.Lang.ProError :
     2318         v-err-msg = exProErrors:GetMessage(1) .
     2319         if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\attr-lib.p" .
     2320       end catch .
     2321       catch exAnyErrors as class Progress.Lang.Error:
     2322         v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\attr-lib.p " + exAnyErrors:GetMessage(1).
     2323       end catch .
     2324       finally :
     2325         if valid-object (v-dlg) then delete object v-dlg .
     2326         if v-err-msg <> "" then undo, throw new Progress.Lang.AppError(
     2327           substitute("&1 c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\attr-lib.p &2", v-err-msg, "clntattr-cli-clim-grp")
     2328         ) .
     2329       end finally .
     2330     end.
     2331   end procedure.
