     9003   procedure assmatat-code :
     9004     define input  parameter p-code           as character no-undo .
     9005     define output parameter p-type           as character no-undo .
     9006     define output parameter p-format         as character no-undo .
     9007     define output parameter p-label          as character no-undo .
     9008     define output parameter p-user-can-edit  as logical   no-undo .
     9009     define output parameter p-output-display as logical   no-undo .
     9010     define output parameter p-other          as character no-undo .
     9011     do
     9012     on error undo, return error
     9013     :
     9014       case p-code :
     9015               when 'RootShablon':U then do:     assign     p-label = "Указание на шаблон"     p-type = 'C':U      p-format = "X(40)"     p-label = "Указание на шаблон"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     9016               when 'alchol-grp':U then do:     assign     p-label = "По умолчанию алкоголь"     p-type = 'C':U      p-format = "X(256)"     p-label = "По умолчанию алкоголь"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     9017               when 'mark-grp':U then do:     assign     p-label = "По умолчанию обязательная маркировка"     p-type = 'C':U      p-format = "X(256)"     p-label = "По умолчанию обязательная маркировка"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     9018               when 'sum-grps':U then do:     assign     p-label = "Группа товаров на кассе"     p-type = 'I':U      p-format = "999"     p-label = "Группа товаров на кассе"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     9019               when 'gg-mark-type':U then do:     assign     p-label = "Тип маркировки"     p-type = 'C':U      p-format = "X(256)"     p-label = "Тип маркировки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     9020               when 'emrc-type':U then do:     assign     p-label = "Тип маркировки"     p-type = 'C':U      p-format = "X(256)"     p-label = "Тип маркировки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     9021         otherwise do:
     9022           undo, return error substitute("неизвестный атрибут ассортиментной матрицы &1", p-code) .
     9023         end.
     9024       end.
     9025     end.
     9026   end procedure.
