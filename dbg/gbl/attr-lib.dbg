     2033             + chr(44) + 'ahsp-del':U
     2034             + chr(44) + 'aht-del':U
     2035             + chr(44) + 'arh-disable':U
     2036             + chr(44) + 'ahsp-disable':U
     2037             + chr(44) + 'aht-disable':U
     2038             + chr(44) + 'arh-calc':U
     2039             + chr(44) + 'ahsp-calc':U
     2040             + chr(44) + 'aht-calc':U
     2041             + chr(44) + 'arh-rest':U
     2042             + chr(44) + 'ahsp-rest':U
     2043             + chr(44) + 'aht-rest':U
     2044             + chr(44) + 'arh-recalc':U
