     2732   procedure thbjattr_value :
     2733     do
     2734     on error undo, return error return-value
     2735     :
     2736       define input  parameter p-obj-type         like ub.thbj-attr.obj-type   no-undo .
     2737       define input  parameter p-obj-code         like ub.thbj-attr.obj-code   no-undo .
     2738       define input  parameter p-upper-code       like ub.thbj-attr.upper-prop-code no-undo .
     2739       define input  parameter p-code             like ub.thbj-attr.prop-code no-undo .
     2740       define output parameter p-value-character  like ub.thbj-attr.property-value-character no-undo .
     2741       define output parameter p-value-date       like ub.thbj-attr.property-value-date no-undo .
     2742       define output parameter p-value-decimal    like ub.thbj-attr.property-value-decimal no-undo .
     2743       define output parameter p-value-integer    like ub.thbj-attr.property-value-integer no-undo .
     2744       define output parameter p-value-logical    like ub.thbj-attr.property-value-logical no-undo .
     2745       define output parameter p-type             as character no-undo .
     2746       define output parameter p-found            as decimal no-undo .
     2747       define buffer buf_thbj-attr for ub.thbj-attr .
     2748       define variable v-label          as character no-undo .
     2749       define variable v-user-can-edit  as logical   no-undo .
     2750       define variable v-output-display as logical   no-undo .
     2751       define variable v-other          as character no-undo .
     2752       define variable v-prop-list as character no-undo .
     2753       define variable v-prop-type-list as character no-undo .
     2754       define variable v-prop-label-list as character no-undo .
     2755       define variable v-global as logical no-undo .
     2756       define variable v-host as logical no-undo .
     2757       define variable v-shop as logical no-undo .
     2758       define variable v-store as logical no-undo .
     2759       define variable v-db as logical no-undo .
     2760       define variable v-region as logical no-undo .
     2761       run thbjattr_code in this-procedure
     2762         (input  p-upper-code
     2763         ,input  p-code
     2764         ,output v-label
     2765         ,output v-user-can-edit
     2766         ,output v-output-display
     2767         ,output v-other
     2768         ,output v-prop-list
     2769         ,output v-prop-type-list
     2770         ,output v-prop-label-list
     2771         ,output v-global
     2772         ,output v-host
     2773         ,output v-shop
     2774         ,output v-store
     2775         ,output v-db
     2776         ,output v-region
     2777         ) no-error .
     2778       if error-status :error then do:
     2779         undo, return error return-value .
     2780       end.
     2781       find first buf_thbj-attr no-lock
     2782         where buf_thbj-attr.obj-type  = p-obj-type
     2783           and buf_thbj-attr.obj-code  = p-obj-code
     2784           and buf_thbj-attr.upper-prop-code = p-upper-code
     2785           and buf_thbj-attr.prop-code = p-code
     2786         no-error .
     2787       if avail buf_thbj-attr then do:
     2788         assign
     2789         p-value-character =  buf_thbj-attr.property-value-character
     2790         p-value-date      =  buf_thbj-attr.property-value-date
     2791         p-value-decimal   =  buf_thbj-attr.property-value-decimal
     2792         p-value-integer   =  buf_thbj-attr.property-value-integer
     2793         p-value-logical   =  buf_thbj-attr.property-value-logical
     2794         p-type            =  buf_thbj-attr.prop-value-type
     2795         p-found           =  1.00
     2796         .
     2797       end.
     2798     end.
     2799   end procedure.
     2800   procedure thbjattr_write :
     2801     do
     2802     on error undo, return error return-value
     2803     :
     2804       define input parameter p-obj-type        like ub.thbj-attr.obj-type   no-undo .
     2805       define input parameter p-obj-code        like ub.thbj-attr.obj-code   no-undo .
     2806       define input parameter p-upper-code      like ub.thbj-attr.upper-prop-code  no-undo .
     2807       define input parameter p-code            like ub.thbj-attr.prop-code  no-undo .
     2808       define input parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
     2809       define input parameter p-value-date      like ub.thbj-attr.property-value-date  no-undo .
     2810       define input parameter p-value-decimal   like ub.thbj-attr.property-value-decimal  no-undo .
     2811       define input parameter p-value-integer   like ub.thbj-attr.property-value-integer  no-undo .
     2812       define input parameter p-value-logical   like ub.thbj-attr.property-value-logical  no-undo .
     2813       define buffer buf_thbj-attr for ub.thbj-attr .
     2814       define variable v-type           as character no-undo .
     2815       define variable v-format         as character no-undo .
     2816       define variable v-label          as character no-undo .
     2817       define variable v-user-can-edit  as logical   no-undo .
     2818       define variable v-output-display as logical   no-undo .
     2819       define variable v-other          as character no-undo .
     2820       define variable v-prop-list as character no-undo .
     2821       define variable v-prop-type-list as character no-undo .
     2822       define variable v-prop-label-list as character no-undo .
     2823       define variable v-global as logical no-undo .
     2824       define variable v-host as logical no-undo .
     2825       define variable v-shop as logical no-undo .
     2826       define variable v-store as logical no-undo .
     2827       define variable v-db as logical no-undo .
     2828       define variable v-dop as character no-undo .
     2829       define variable v-region as logical no-undo .
     2830       run thbjattr_code in this-procedure
     2831         (input  p-upper-code
     2832         ,input  p-code
     2833         ,output v-label
     2834         ,output v-user-can-edit
     2835         ,output v-output-display
     2836         ,output v-other
     2837         ,output v-prop-list
     2838         ,output v-prop-type-list
     2839         ,output v-prop-label-list
     2840         ,output v-global
     2841         ,output v-host
     2842         ,output v-shop
     2843         ,output v-store
     2844         ,output v-db
     2845         ,output v-region
     2846         ) no-error .
     2847       if error-status :error then do:
     2848         undo, return error return-value .
     2849       end.
     2850       find first buf_thbj-attr exclusive-lock
     2851         where buf_thbj-attr.obj-type  = p-obj-type
     2852           and buf_thbj-attr.obj-code  = p-obj-code
     2853           and buf_thbj-attr.upper-prop-code = p-upper-code
     2854           and buf_thbj-attr.prop-code = p-code
     2855         no-error .
     2856       if not available buf_thbj-attr then do:
     2857         create buf_thbj-attr .
     2858         assign
     2859           buf_thbj-attr.obj-type  = p-obj-type
     2860           buf_thbj-attr.obj-code  = p-obj-code
     2861           buf_thbj-attr.upper-prop-code = p-upper-code
     2862           buf_thbj-attr.prop-code = p-code
     2863           v-dop = entry(lookup(p-code, v-prop-list), v-prop-type-list)
     2864           buf_thbj-attr.prop-value-type = v-dop
     2865         .
     2866       end.
     2867       CASE buf_thbj-attr.prop-value-type:
     2868         when 'character':U then do:
     2869           assign
     2870           buf_thbj-attr.property-value-character = p-value-character
     2871           .
     2872         end.
     2873         when 'date':U then do:
     2874           assign
     2875           buf_thbj-attr.property-value-date = p-value-date
     2876           .
     2877         end.
     2878         when 'decimal':U then do:
     2879           assign
     2880           buf_thbj-attr.property-value-decimal = p-value-decimal
     2881           .
     2882         end.
     2883         when 'integer':U then do:
     2884           assign
     2885           buf_thbj-attr.property-value-integer = p-value-integer
     2886           .
     2887         end.
     2888         when 'logical':U then do:
     2889           assign
     2890           buf_thbj-attr.property-value-logical = p-value-logical
     2891           .
     2892         end.
     2893       end case.
     2894       release buf_thbj-attr no-error.
     2895       if error-status:error then do:
     2896         return error substitute("Ошибка при сохранение атрибута &1 &2 объекта TH &3&5: &5 &6"
     2897                                , p-upper-code
     2898                                , p-code
     2899                                , p-obj-type
     2900                                , p-obj-code
     2901                                , error-status:get-message(1)
     2902                                , return-value ).
     2903       end.
     2904     end.
     2905   end procedure.
     2906   procedure thbjattr_delete :
     2907     do
     2908     on error undo, return error return-value
     2909     :
     2910       define input parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     2911       define input parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     2912       define input parameter p-upper-code   like ub.thbj-attr.upper-prop-code  no-undo .
     2913       define input parameter p-code     like ub.thbj-attr.prop-code  no-undo .
     2914       define output parameter p-deleted  as logical no-undo.
     2915       define buffer buf_thbj-attr for ub.thbj-attr .
     2916       define variable v-label          as character no-undo .
     2917       define variable v-user-can-edit  as logical   no-undo .
     2918       define variable v-output-display as logical   no-undo .
     2919       define variable v-other          as character no-undo .
     2920       define variable v-prop-list as character no-undo .
     2921       define variable v-prop-type-list as character no-undo .
     2922       define variable v-prop-label-list as character no-undo .
     2923       define variable v-global as logical no-undo .
     2924       define variable v-host as logical no-undo .
     2925       define variable v-shop as logical no-undo .
     2926       define variable v-store as logical no-undo .
     2927       define variable v-db as logical no-undo .
     2928       define variable v-region as logical no-undo .
     2929       run thbjattr_code in this-procedure
     2930         (input  p-upper-code
     2931         ,input  p-code
     2932         ,output v-label
     2933         ,output v-user-can-edit
     2934         ,output v-output-display
     2935         ,output v-other
     2936         ,output v-prop-list
     2937         ,output v-prop-type-list
     2938         ,output v-prop-label-list
     2939         ,output v-global
     2940         ,output v-host
     2941         ,output v-shop
     2942         ,output v-store
     2943         ,output v-db
     2944         ,output v-region
     2945         ) no-error .
     2946       if error-status :error then do:
     2947         undo, return error return-value .
     2948       end.
     2949       find first buf_thbj-attr exclusive-lock
     2950         where buf_thbj-attr.obj-type  = p-obj-type
     2951           and buf_thbj-attr.obj-code  = p-obj-code
     2952           and buf_thbj-attr.upper-prop-code = p-upper-code
     2953           and buf_thbj-attr.prop-code = p-code
     2954         no-error NO-WAIT.
     2955       if not available buf_thbj-attr then do:
     2956         p-deleted = no.
     2957       end.
     2958       else do:
     2959         delete buf_thbj-attr no-error .
     2960         if error-status:error then do:
     2961           return error substitute("Ошибка при удалении атрибута &1 &2 объекта TH &3&4: &5 &6"
     2962                                 , p-upper-code
     2963                                 , p-code
     2964                                 , p-obj-type
     2965                                 , p-obj-code
     2966                                 , error-status:get-message(1)
     2967                                 , return-value ).
     2968         end.
     2969         p-deleted = yes.
     2970       end.
     2971     end.
     2972   end procedure.
     2973   procedure thbjattr_get-section :
     2974   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     2975   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     2976   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     2977   define input  parameter p-mode as character no-undo .
     2978   define input-output parameter table for thbjattr_thbj-attr.
     2979   define output parameter p-all-found as decimal no-undo .
     2980   define variable v-label          as character no-undo .
     2981   define variable v-user-can-edit  as logical   no-undo .
     2982   define variable v-output-display as logical   no-undo .
     2983   define variable v-other          as character no-undo .
     2984   define variable v-prop-list as character no-undo .
     2985   define variable v-prop-type-list as character no-undo .
     2986   define variable v-prop-label-list as character no-undo .
     2987   define variable v-global as logical no-undo .
     2988   define variable v-host as logical no-undo .
     2989   define variable v-shop as logical no-undo .
     2990   define variable v-store as logical no-undo .
     2991   define variable v-db as logical no-undo .
     2992   define variable v-region as logical no-undo .
     2993   define variable v-jj as integer no-undo .
     2994   define variable v-all-found as decimal no-undo .
     2995   define buffer buf_thbj-attr for ub.thbj-attr.
     2996   define buffer buf_thbjattr_thbj-attr for thbjattr_thbj-attr.
     2997   main-block:
     2998   do
     2999   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3000   :
     3001     run thbjattr_code in this-procedure
     3002       (input  p-upper-code
     3003       ,input  '':U
     3004       ,output v-label
     3005       ,output v-user-can-edit
     3006       ,output v-output-display
     3007       ,output v-other
     3008       ,output v-prop-list
     3009       ,output v-prop-type-list
     3010       ,output v-prop-label-list
     3011       ,output v-global
     3012       ,output v-host
     3013       ,output v-shop
     3014       ,output v-store
     3015       ,output v-db
     3016       ,output v-region
     3017       ) no-error .
     3018     if error-status :error then do:
     3019       undo, return error return-value .
     3020     end.
     3021     for each buf_thbj-attr no-lock where
     3022             buf_thbj-attr.obj-type = p-obj-type
     3023         and buf_thbj-attr.obj-code = p-obj-code
     3024         and buf_thbj-attr.upper-prop-code = p-upper-code
     3025     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     3026        if buf_thbj-attr.prop-code = '':U then next.
     3027       if lookup( buf_thbj-attr.prop-code, v-prop-list) = 0 then next .
     3028       if (lookup("compl", v-prop-type-list, chr(47)) > 0
     3029       and v-prop-type-list <> buf_thbj-attr.prop-value-type)
     3030       or (lookup("compl", v-prop-type-list, chr(47)) = 0
     3031           and entry(lookup( buf_thbj-attr.prop-code, v-prop-list), v-prop-type-list) <> buf_thbj-attr.prop-value-type )
     3032       then next .
     3033       find first buf_thbjattr_thbj-attr where
     3034                 buf_thbjattr_thbj-attr.obj-type = p-obj-type
     3035             and buf_thbjattr_thbj-attr.obj-code = p-obj-code
     3036             and buf_thbjattr_thbj-attr.upper-prop-code = p-upper-code
     3037             and buf_thbjattr_thbj-attr.prop-code = buf_thbj-attr.prop-code no-error.
     3038       if not available buf_thbjattr_thbj-attr then do:
     3039         create buf_thbjattr_thbj-attr.
     3040         assign
     3041         buf_thbjattr_thbj-attr.obj-type = p-obj-type
     3042         buf_thbjattr_thbj-attr.obj-code = p-obj-code
     3043         buf_thbjattr_thbj-attr.upper-prop-code = p-upper-code
     3044         buf_thbjattr_thbj-attr.prop-code = buf_thbj-attr.prop-code
     3045         .
     3046       end.
     3047       buffer-copy buf_thbj-attr
     3048       except obj-type obj-code upper-prop-code prop-code
     3049       to buf_thbjattr_thbj-attr
     3050       .
     3051       assign
     3052       v-jj = v-jj + 1.
     3053       if buf_thbj-attr.prop-value-type = 'void':U then do:
     3054         v-all-found = 0.
     3055         run thbjattr_get-section in this-procedure (
     3056                                                       input p-obj-type
     3057                                                      ,input p-obj-code
     3058                                                      ,input buf_thbj-attr.prop-code
     3059                                                      ,input p-mode
     3060                                                      ,input-output table thbjattr_thbj-attr
     3061                                                      ,output v-all-found
     3062                                                      ) no-error.
     3063         if error-status:error then do:
     3064           undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3065         end.
     3066         if v-all-found < 1 then do:
     3067           v-jj = v-jj - 1.
     3068         end.
     3069       end.
     3070     end.
     3071     assign
     3072     p-all-found = v-jj / num-entries(v-prop-list).
     3073   end.
     3074   end procedure.
     3075   procedure thbjattr_set-section :
     3076   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     3077   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     3078   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     3079   define input parameter table for thbjattr_thbj-attr.
     3080   define variable v-label          as character no-undo .
     3081   define variable v-user-can-edit  as logical   no-undo .
     3082   define variable v-output-display as logical   no-undo .
     3083   define variable v-other          as character no-undo .
     3084   define variable v-prop-list as character no-undo .
     3085   define variable v-prop-type-list as character no-undo .
     3086   define variable v-prop-label-list as character no-undo .
     3087   define variable v-global as logical no-undo .
     3088   define variable v-host as logical no-undo .
     3089   define variable v-shop as logical no-undo .
     3090   define variable v-store as logical no-undo .
     3091   define variable v-db as logical no-undo .
     3092   define variable v-region as logical no-undo .
     3093   define variable v-jj as integer no-undo .
     3094   define variable v-created as logical no-undo .
     3095   define buffer buf_thbj-attr for ub.thbj-attr.
     3096   define buffer buf_thbjattr_thbj-attr for thbjattr_thbj-attr.
     3097   define buffer sys-ctrl for ub.sys-ctrl.
     3098   main-block:
     3099   do
     3100   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3101   :
     3102     run thbjattr_code in this-procedure
     3103       (input  p-upper-code
     3104       ,input  '':U
     3105       ,output v-label
     3106       ,output v-user-can-edit
     3107       ,output v-output-display
     3108       ,output v-other
     3109       ,output v-prop-list
     3110       ,output v-prop-type-list
     3111       ,output v-prop-label-list
     3112       ,output v-global
     3113       ,output v-host
     3114       ,output v-shop
     3115       ,output v-store
     3116       ,output v-db
     3117       ,output v-region
     3118       ) no-error .
     3119     if error-status :error then do:
     3120       undo, return error return-value .
     3121     end.
     3122     find first buf_thbj-attr exclusive-lock where
     3123               buf_thbj-attr.obj-type = p-obj-type
     3124           and buf_thbj-attr.obj-code = p-obj-code
     3125           and buf_thbj-attr.upper-prop-code = p-upper-code
     3126           and buf_thbj-attr.prop-code = '':U  no-error.
     3127     if not available buf_thbj-attr then do:
     3128       create buf_thbj-attr.
     3129       assign
     3130       buf_thbj-attr.obj-type = p-obj-type
     3131       buf_thbj-attr.obj-code = p-obj-code
     3132       buf_thbj-attr.upper-prop-code = p-upper-code
     3133       buf_thbj-attr.prop-code = '':U
     3134       .
     3135     end.
     3136     for each buf_thbjattr_thbj-attr where
     3137           buf_thbjattr_thbj-attr.upper-prop-code = p-upper-code
     3138     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3139     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3140     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3141     :
     3142       if buf_thbjattr_thbj-attr.prop-code = '':U then next.
     3143       if lookup( buf_thbjattr_thbj-attr.prop-code, v-prop-list) = 0 then next .
     3144       if (lookup("compl", v-prop-type-list, chr(47)) > 0
     3145       and v-prop-type-list <> buf_thbjattr_thbj-attr.prop-value-type)
     3146       or (lookup("compl", v-prop-type-list, chr(47)) = 0
     3147           and entry(lookup( buf_thbjattr_thbj-attr.prop-code, v-prop-list), v-prop-type-list) <> buf_thbjattr_thbj-attr.prop-value-type )
     3148       then next .
     3149       v-created = no.
     3150       find first buf_thbj-attr exclusive-lock where
     3151                 buf_thbj-attr.obj-type = p-obj-type
     3152             and buf_thbj-attr.obj-code = p-obj-code
     3153             and buf_thbj-attr.upper-prop-code = buf_thbjattr_thbj-attr.upper-prop-code
     3154             and buf_thbj-attr.prop-code = buf_thbjattr_thbj-attr.prop-code  no-error.
     3155       if not available buf_thbj-attr then do:
     3156         create buf_thbj-attr.
     3157         assign
     3158         buf_thbj-attr.obj-type = p-obj-type
     3159         buf_thbj-attr.obj-code = p-obj-code
     3160         buf_thbj-attr.upper-prop-code = buf_thbjattr_thbj-attr.upper-prop-code
     3161         buf_thbj-attr.prop-code = buf_thbjattr_thbj-attr.prop-code
     3162         buf_thbj-attr.prop-value-type = buf_thbjattr_thbj-attr.prop-value-type
     3163         v-created = yes
     3164         .
     3165       end.
     3166       if  (buf_thbjattr_thbj-attr.obj-type = '':U
     3167       and buf_thbj-attr.obj-type = 'орг':U
     3168       and v-created)
     3169       or (buf_thbjattr_thbj-attr.obj-type = '':U
     3170       and buf_thbj-attr.obj-type = 'скл':U
     3171       and v-created)
     3172       or (buf_thbjattr_thbj-attr.obj-type = '':U
     3173       and buf_thbj-attr.obj-type = 'маг':U
     3174       and v-created)
     3175       or (buf_thbjattr_thbj-attr.obj-type = '':U
     3176       and buf_thbj-attr.obj-type = 'БД':U
     3177       and v-created)
     3178       or (buf_thbjattr_thbj-attr.obj-type = 'орг':U
     3179       and buf_thbj-attr.obj-type = 'скл':U
     3180       and v-created)
     3181       or (buf_thbjattr_thbj-attr.obj-type = 'орг':U
     3182       and buf_thbj-attr.obj-type = 'маг':U
     3183       and v-created)
     3184       or (buf_thbjattr_thbj-attr.obj-type = buf_thbj-attr.obj-type)
     3185       then do:
     3186         buffer-copy
     3187         buf_thbjattr_thbj-attr
     3188         using
     3189         property-value-character
     3190         property-value-date
     3191         property-value-decimal
     3192         property-value-integer
     3193         property-value-logical
     3194         prop-value-type
     3195         to buf_thbj-attr.
     3196       end.
     3197       if buf_thbj-attr.prop-value-type = 'void':U then do:
     3198         run thbjattr_set-section in this-procedure (
     3199                                                       input p-obj-type
     3200                                                      ,input p-obj-code
     3201                                                      ,input buf_thbj-attr.prop-code
     3202                                                      ,input table thbjattr_thbj-attr
     3203                                                      ) no-error.
     3204        if error-status:error then do:
     3205          undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3206        end.
     3207       end.
     3208     end.
     3209      find first sys-ctrl exclusive-lock.
     3210      if     available sys-ctrl
     3211      then do:
     3212         sys-ctrl.whole-send-news = sys-ctrl.whole-send-news + 1.
     3213         if sys-ctrl.whole-send-news > 1000
     3214         then
     3215            sys-ctrl.whole-send-news = 1.
     3216      end.
     3217      release sys-ctrl.
     3218   end.
     3219   end procedure.
     3220   procedure thbjattr_delete-section :
     3221   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     3222   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     3223   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     3224   define buffer buf_thbj-attr for ub.thbj-attr.
     3225   define buffer buf2_thbj-attr for ub.thbj-attr.
     3226   main-block:
     3227   do
     3228   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3229   :
     3230     for each buf_thbj-attr no-lock where
     3231             buf_thbj-attr.obj-type = p-obj-type
     3232         and buf_thbj-attr.obj-code = p-obj-code
     3233         and buf_thbj-attr.upper-prop-code = p-upper-code
     3234     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3235     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3236     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3237     :
     3238       find first buf2_thbj-attr exclusive-lock where
     3239                 rowid(buf2_thbj-attr) = rowid(buf_thbj-attr) no-error.
     3240       delete buf2_thbj-attr.
     3241     end.
     3242   end.
     3243   end procedure.
     3244   procedure thbjattr_legacy :
     3245   do
     3246   on error undo, return error return-value
     3247   :
