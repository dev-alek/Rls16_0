     8533             and buf_pck-rcvd-attr.pack-num  = p-pack-num
     8534             and buf_pck-rcvd-attr.attr-code = p-code
     8535           no-error .
     8536         if available buf_pck-rcvd-attr then do:
     8537           assign
     8538             p-exist = yes
     8539           .
     8540         end.
     8541       end.
     8542       else do:
     8543         find first buf_pck-sent-attr no-lock
     8544           where buf_pck-sent-attr.db-num    = p-db-num
     8545             and buf_pck-sent-attr.pack-num  = p-pack-num
     8546             and buf_pck-sent-attr.attr-code = p-code
     8547           no-error .
     8548         if available buf_pck-sent-attr then do:
     8549           assign
     8550             p-exist = yes
     8551           .
     8552         end.
     8553       end.
     8554     end.
     8555   end procedure.
     8556   procedure pck-attr-delete :
     8557     define input  parameter p-tbl-pck  as   character                   no-undo .
     8558     define input  parameter p-db-num   like ub.pck-rcvd-attr.db-num     no-undo .
     8559     define input  parameter p-pack-num like ub.pck-rcvd-attr.pack-num   no-undo .
     8560     define input  parameter p-code     like ub.pck-rcvd-attr.attr-code  no-undo .
     8561     define output parameter p-deleted  as logical no-undo.
     8562     do
     8563     on error undo, return error
     8564     :
     8565       define buffer buf_pck-sent-attr for ub.pck-sent-attr .
     8566       define buffer buf_pck-rcvd-attr for ub.pck-rcvd-attr .
     8567       define variable v-type           as character no-undo .
     8568       define variable v-format         as character no-undo .
     8569       define variable v-label          as character no-undo .
     8570       define variable v-user-can-edit  as logical   no-undo .
     8571       define variable v-output-display as logical   no-undo .
     8572       define variable v-other          as character no-undo .
     8573       run pck-attr-code in this-procedure
     8574         (input  p-code
     8575         ,output v-type
     8576         ,output v-format
     8577         ,output v-label
     8578         ,output v-user-can-edit
     8579         ,output v-output-display
     8580         ,output v-other
     8581         ) no-error .
     8582       if error-status :error then do:
     8583         undo, return error return-value .
     8584       end.
     8585       if p-tbl-pck = "pck-rcvd":U then do:
     8586         find first buf_pck-rcvd-attr exclusive-lock
     8587           where buf_pck-rcvd-attr.db-num    = p-db-num
     8588             and buf_pck-rcvd-attr.pack-num  = p-pack-num
     8589             and buf_pck-rcvd-attr.attr-code = p-code
     8590           no-error NO-WAIT.
     8591         if not available buf_pck-rcvd-attr then do:
     8592           p-deleted = no.
     8593         end.
     8594         else do:
     8595           delete buf_pck-rcvd-attr.
     8596           p-deleted = yes.
     8597         end.
     8598       end.
     8599       else do:
     8600         find first buf_pck-sent-attr exclusive-lock
     8601           where buf_pck-sent-attr.db-num    = p-db-num
     8602             and buf_pck-sent-attr.pack-num  = p-pack-num
     8603             and buf_pck-sent-attr.attr-code = p-code
     8604           no-error NO-WAIT.
     8605         if not available buf_pck-sent-attr then do:
     8606           p-deleted = no.
     8607         end.
     8608         else do:
     8609           delete buf_pck-sent-attr.
     8610           p-deleted = yes.
     8611         end.
     8612       end.
     8613     end.
     8614   end procedure.
     8615   procedure pck-attr-news :
     8616     define input  parameter p-code           as character no-undo .
     8617     define output parameter p-news           as logical   no-undo .
     8618     do
     8619     on error undo, return error
     8620     :
     8621       case p-code :
     8622               when 'beg-imp-date':U then do:     assign     p-news = no.   end.
     8623               when 'beg-imp-time':U then do:     assign     p-news = no.   end.
     8624         otherwise do:
     8625           undo, return error substitute("неизвестный атрибут принятого пакета &1", p-code ) .
     8626         end.
     8627       end.
     8628     end.
     8629   end procedure.
     8630   procedure pck-attr-manual-edit :
     8631     define input  parameter p-code           as character no-undo .
     8632     define output parameter p-section-num    as integer no-undo .
     8633     do
     8634     on error undo, return error
     8635     :
     8636       case p-code :
     8637               when 'beg-imp-date':U then do:     assign     p-section-num = 0.   end.
     8638               when 'beg-imp-time':U then do:     assign     p-section-num = 0.   end.
     8639         otherwise do:
     8640           undo, return error substitute("неизвестный атрибут принятого пакета &1", p-code ).
     8641         end.
     8642       end.
     8643     end.
     8644   end procedure.
     8645   procedure pck-attr-batch-edit :
     8646     define input  parameter p-code           as character no-undo .
     8647     define output parameter p-section-num    as integer no-undo .
     8648     do
     8649     on error undo, return error
     8650     :
     8651       case p-code :
     8652               when 'beg-imp-date':U then do:     assign     p-section-num = 0.   end.
     8653               when 'beg-imp-time':U then do:     assign     p-section-num = 0.   end.
     8654         otherwise do:
     8655           undo, return error substitute("неизвестный атрибут принятого пакета &1", p-code ).
     8656         end.
     8657       end.
     8658     end.
     8659   end procedure.
     8660   procedure ggoattr-code :
     8661     define input  parameter p-code           as character no-undo .
     8662     define output parameter p-type           as character no-undo .
     8663     define output parameter p-format         as character no-undo .
     8664     define output parameter p-label          as character no-undo .
     8665     define output parameter p-user-can-edit  as logical   no-undo .
     8666     define output parameter p-output-display as logical   no-undo .
     8667     define output parameter p-other          as character no-undo .
     8668     do
     8669     on error undo, return error
     8670     :
     8671       case p-code :
     8672               when 'NotCorrOP':U then do:     assign     p-label = "Запрет на корректировку автоматически рассчитанного заказа ОП"     p-type = 'L':U      p-format = "+/-"     p-label = "Запрет на корректировку автоматически рассчитанного заказа ОП"     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     8673               when 'alc-min-price':U then do:     assign     p-label = "Правила определения минимальной цены алкоголя"     p-type = 'C':U      p-format = "X(256)"     p-label = "Правила определения минимальной цены алкоголя"     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     8674                   when 'marg-pr-paraf':U then do:     assign     p-label = "Правила определения наценки к цене внутреннего прихода партии"     p-type = 'C':U      p-format = "X(256)"     p-label = "Правила определения наценки к цене внутреннего прихода партии"     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     8675               when 'level-dis':U then do:     assign     p-label = "Правила определения границ пороговой наценки"     p-type = 'C':U      p-format = "X(256)"     p-label = "Правила определения границ пороговой наценки"     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     8676               when 'no-inc-auto-rep':U then do:     assign     p-label = "Не учитывать в автоматической отчетности"     p-type = 'C':U      p-format = "X(256)"     p-label = "Не учитывать в автоматической отчетности"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8677               when 'ban-sales-via-cd':U then do:     assign     p-label = "Запрет продажи через кассу"     p-type = 'C':U      p-format = "X(256)"     p-label = "Запрет продажи через кассу"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8678               when 'alchol-grp':U then do:     assign     p-label = "По умолчанию алкоголь"     p-type = 'C':U      p-format = "X(256)"     p-label = "По умолчанию алкоголь"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8679               when 'mark-grp':U then do:     assign     p-label = "По умолчанию обязательная маркировка"     p-type = 'C':U      p-format = "X(256)"     p-label = "По умолчанию обязательная маркировка"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8680               when 'sum-grps':U then do:     assign     p-label = "Группа товаров на кассе"     p-type = 'I':U      p-format = "999"     p-label = "Группа товаров на кассе"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8681               when 'gg-mark-type':U then do:     assign     p-label = "Тип маркировки"     p-type = 'C':U      p-format = "X(256)"     p-label = "Тип маркировки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8682               when 'emrc-type':U then do:     assign     p-label = "Тип маркировки"     p-type = 'C':U      p-format = "X(256)"     p-label = "Тип маркировки"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8683         otherwise do:
     8684           undo, return error substitute("неизвестный атрибут группы товаров на объекте &1", p-code) .
     8685         end.
     8686       end.
     8687     end.
     8688   end procedure.
     8689   procedure ggoattr-tooltip :
     8690     define input  parameter p-code    as character no-undo .
     8691     define output parameter p-tooltip as character no-undo .
     8692     define output parameter p-label   as character no-undo .
     8693     do
     8694     on error undo, return error
     8695     :
     8696       case p-code :
     8697               when 'NotCorrOP':U then do:     assign     p-tooltip = "Запрет на корректировку авт.рассчит.заказа ОП"     p-label = "Запрет на корректировку автоматически рассчитанного заказа ОП" .   end.
     8698               when 'alc-min-price':U then do:     assign     p-tooltip = "Правила определения минимальной цены алкоголя"     p-label = "Правила определения минимальной цены алкоголя" .   end.
     8699               when 'marg-pr-paraf':U then do:     assign     p-tooltip = "Правила определения наценки к цене внутреннего прихода партии"     p-label = "Правила определения наценки к цене внутреннего прихода партии" .   end.
     8700               when 'level-dis':U then do:     assign     p-tooltip = "Правила определения границ пороговой наценки"     p-label = "Правила определения границ пороговой наценки" .   end.
     8701               when 'no-inc-auto-rep':U then do:     assign     p-tooltip = "Не учитывать в автоматической отчетности"     p-label = "Не учитывать в автоматической отчетности" .   end.
     8702               when 'ban-sales-via-cd':U then do:     assign     p-tooltip = "Запрет продажи через кассу"     p-label = "Запрет продажи через кассу" .   end.
     8703               when 'alchol-grp':U then do:     assign     p-tooltip = "По умолчанию алкоголь"     p-label = "По умолчанию алкоголь" .   end.
     8704               when 'mark-grp':U then do:     assign     p-tooltip = "По умолчанию обязательная маркировка"     p-label = "По умолчанию обязательная маркировка" .   end.
     8705               when 'sum-grps':U then do:     assign     p-tooltip = "Группа товаров на кассе"     p-label = "Группа товаров на кассе" .   end.
     8706               when 'gg-mark-type':U then do:     assign     p-tooltip = "Тип маркировки"     p-label = "Тип маркировки" .   end.
     8707               when 'emrc-type':U then do:     assign     p-tooltip = "Тип маркировки"     p-label = "Тип маркировки" .   end.
     8708         otherwise do:
     8709           undo, return error substitute("неизвестный атрибут группы товаров на объекте &1", p-code) .
     8710         end.
     8711       end.
     8712     end.
     8713   end procedure.
     8714   procedure ggoattr-value :
     8715     define input  parameter p-node-code    like ub.gds-grp-obj-attr.node-code     no-undo .
     8716     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8717     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8718     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8719     define input  parameter p-code         like ub.gds-grp-obj-attr.attr-code  no-undo .
     8720     define output parameter p-value        like ub.gds-grp-obj-attr.attr-value no-undo .
     8721     define output parameter p-type         as character no-undo .
     8722     do
     8723     on error undo, return error
     8724     :
     8725       define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     8726       define variable v-format         as character no-undo .
     8727       define variable v-label          as character no-undo .
     8728       define variable v-user-can-edit  as logical   no-undo .
     8729       define variable v-output-display as logical   no-undo .
     8730       define variable v-other          as character no-undo .
     8731       run ggoattr-code in this-procedure
     8732         (input  p-code
     8733         ,output p-type
     8734         ,output v-format
     8735         ,output v-label
     8736         ,output v-user-can-edit
     8737         ,output v-output-display
     8738         ,output v-other
     8739         ) no-error .
     8740       if error-status :error then do:
     8741         undo, return error return-value .
     8742       end.
     8743       find first buf_gds-grp-obj-attr no-lock
     8744         where buf_gds-grp-obj-attr.node-code   = p-node-code
     8745           and buf_gds-grp-obj-attr.host-code   = p-host-code
     8746           and buf_gds-grp-obj-attr.obj-type    = p-obj-type
     8747           and buf_gds-grp-obj-attr.obj-code    = p-obj-code
     8748           and buf_gds-grp-obj-attr.attr-code   = p-code
     8749         no-error .
     8750       if available buf_gds-grp-obj-attr then do:
     8751         assign
     8752           p-value =  buf_gds-grp-obj-attr.attr-value
     8753         .
     8754       end.
     8755       else do:
     8756         if p-obj-type <> "" then do:
     8757             find first buf_gds-grp-obj-attr no-lock
     8758               where buf_gds-grp-obj-attr.node-code   = p-node-code
     8759                 and buf_gds-grp-obj-attr.host-code   = p-host-code
     8760                 and buf_gds-grp-obj-attr.obj-type    = ""
     8761                 and buf_gds-grp-obj-attr.obj-code    = 0
     8762                 and buf_gds-grp-obj-attr.attr-code   = p-code
     8763               no-error .
     8764             if available buf_gds-grp-obj-attr then do:
     8765                 assign
     8766                   p-value =  buf_gds-grp-obj-attr.attr-value
     8767                 .
     8768             end.
     8769             else do:
     8770                   find first buf_gds-grp-obj-attr no-lock
     8771                     where buf_gds-grp-obj-attr.node-code   = p-node-code
     8772                       and buf_gds-grp-obj-attr.host-code   = 0
     8773                       and buf_gds-grp-obj-attr.obj-type    = ""
     8774                       and buf_gds-grp-obj-attr.obj-code    = 0
     8775                       and buf_gds-grp-obj-attr.attr-code   = p-code
     8776                     no-error .
     8777                   if available buf_gds-grp-obj-attr then do:
     8778                       assign
     8779                         p-value =  buf_gds-grp-obj-attr.attr-value
     8780                       .
     8781                   end.
     8782                   else do:
     8783                      assign
     8784                        p-value = if p-type = 'L':U then "no":U else ""
     8785                      .
     8786                    end.
     8787              end.
     8788         end.
     8789         if p-obj-type = "" and p-host-code <> 0 then do:
     8790             find first buf_gds-grp-obj-attr no-lock
     8791               where buf_gds-grp-obj-attr.node-code   = p-node-code
     8792                 and buf_gds-grp-obj-attr.host-code   = 0
     8793                 and buf_gds-grp-obj-attr.obj-type    = ""
     8794                 and buf_gds-grp-obj-attr.obj-code    = 0
     8795                 and buf_gds-grp-obj-attr.attr-code   = p-code
     8796               no-error .
     8797             if available buf_gds-grp-obj-attr then do:
     8798                 assign
     8799                   p-value =  buf_gds-grp-obj-attr.attr-value
     8800                 .
     8801             end.
     8802             else do:
     8803                 assign
     8804                   p-value = if p-type = 'L':U then "no":U else ""
     8805                 .
     8806             end.
     8807         end.
     8808         if p-obj-type = "" and p-host-code = 0 then do:
     8809           assign
     8810             p-value = if p-type = 'L':U then "no":U else ""
     8811           .
     8812         end.
     8813       end.
     8814     end.
     8815   end procedure.
     8816   procedure ggoattr-write :
     8817     define input parameter p-node-code    like ub.gds-grp-obj-attr.node-code     no-undo .
     8818     define input parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8819     define input parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8820     define input parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8821     define input parameter p-code      like ub.gds-grp-obj-attr.attr-code  no-undo .
     8822     define input parameter p-value     like ub.gds-grp-obj-attr.attr-value no-undo .
     8823     do
     8824     on error undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1))
     8825     :
     8826       define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     8827       define variable v-type           as character no-undo .
     8828       define variable v-format         as character no-undo .
     8829       define variable v-label          as character no-undo .
     8830       define variable v-user-can-edit  as logical   no-undo .
     8831       define variable v-output-display as logical   no-undo .
     8832       define variable v-other          as character no-undo .
     8833       run ggoattr-code in this-procedure
     8834         (input  p-code
     8835         ,output v-type
     8836         ,output v-format
     8837         ,output v-label
     8838         ,output v-user-can-edit
     8839         ,output v-output-display
     8840         ,output v-other
     8841         ) no-error .
     8842       if error-status :error then do:
     8843         undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1)) .
     8844       end.
     8845       find first buf_gds-grp-obj-attr exclusive-lock
     8846         where buf_gds-grp-obj-attr.node-code    = p-node-code
     8847           and buf_gds-grp-obj-attr.host-code   = p-host-code
     8848           and buf_gds-grp-obj-attr.obj-type    = p-obj-type
     8849           and buf_gds-grp-obj-attr.obj-code    = p-obj-code
     8850           and buf_gds-grp-obj-attr.attr-code = p-code
     8851         no-error .
     8852       if not available buf_gds-grp-obj-attr then do:
     8853         create buf_gds-grp-obj-attr .
     8854         assign
     8855           buf_gds-grp-obj-attr.host-code   = p-host-code
     8856           buf_gds-grp-obj-attr.obj-type    = p-obj-type
     8857           buf_gds-grp-obj-attr.obj-code    = p-obj-code
     8858           buf_gds-grp-obj-attr.node-code    = p-node-code
     8859           buf_gds-grp-obj-attr.attr-code = p-code
     8860         .
     8861       end.
     8862       assign
     8863         buf_gds-grp-obj-attr.attr-value = p-value
     8864       .
     8865     end.
     8866   end procedure.
     8867   procedure ggoattr-exist :
     8868     define input  parameter p-node-code    like ub.gds-grp-obj-attr.node-code     no-undo .
     8869     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8870     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8871     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8872     define input  parameter p-code      like ub.gds-grp-obj-attr.attr-code  no-undo .
     8873     define output parameter p-exist    as logical  no-undo .
     8874     do
     8875     on error undo, return error
     8876     :
     8877       define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     8878       define variable v-type           as character no-undo .
     8879       define variable v-format         as character no-undo .
     8880       define variable v-label          as character no-undo .
     8881       define variable v-user-can-edit  as logical   no-undo .
     8882       define variable v-output-display as logical   no-undo .
     8883       define variable v-other          as character no-undo .
     8884       run ggoattr-code in this-procedure
     8885         (input  p-code
     8886         ,output v-type
     8887         ,output v-format
     8888         ,output v-label
     8889         ,output v-user-can-edit
     8890         ,output v-output-display
     8891         ,output v-other
     8892         ) no-error .
     8893       if error-status :error then do:
     8894         undo, return error return-value .
     8895       end.
     8896       find first buf_gds-grp-obj-attr no-lock
     8897         where buf_gds-grp-obj-attr.node-code    = p-node-code
     8898           and buf_gds-grp-obj-attr.host-code   = p-host-code
     8899           and buf_gds-grp-obj-attr.obj-type    = p-obj-type
     8900           and buf_gds-grp-obj-attr.obj-code    = p-obj-code
     8901           and buf_gds-grp-obj-attr.attr-code = p-code
     8902         no-error .
     8903       if  available buf_gds-grp-obj-attr then do:
     8904         p-exist = yes.
     8905       end.
     8906     end.
     8907   end procedure.
     8908   procedure ggoattr-delete :
     8909     define input parameter p-node-code   like ub.gds-grp-obj-attr.node-code     no-undo .
     8910     define input  parameter p-host-code    like ub.gds-grp-obj-attr.host-code     no-undo .
     8911     define input  parameter p-obj-type     like ub.gds-grp-obj-attr.obj-type     no-undo .
     8912     define input  parameter p-obj-code     like ub.gds-grp-obj-attr.obj-code     no-undo .
     8913     define input parameter p-code     like ub.gds-grp-obj-attr.attr-code  no-undo .
     8914     define output parameter p-deleted  as logical no-undo.
     8915     do
     8916     on error undo, return error
     8917     :
     8918       define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr .
     8919       define variable v-type           as character no-undo .
     8920       define variable v-format         as character no-undo .
     8921       define variable v-label          as character no-undo .
     8922       define variable v-user-can-edit  as logical   no-undo .
     8923       define variable v-output-display as logical   no-undo .
     8924       define variable v-other          as character no-undo .
     8925       run ggoattr-code in this-procedure
     8926         (input  p-code
     8927         ,output v-type
     8928         ,output v-format
     8929         ,output v-label
     8930         ,output v-user-can-edit
     8931         ,output v-output-display
     8932         ,output v-other
     8933         ) no-error .
     8934       if error-status :error then do:
     8935         undo, return error return-value .
     8936       end.
     8937       find first buf_gds-grp-obj-attr exclusive-lock
     8938         where buf_gds-grp-obj-attr.node-code    = p-node-code
     8939           and buf_gds-grp-obj-attr.host-code   = p-host-code
     8940           and buf_gds-grp-obj-attr.obj-type    = p-obj-type
     8941           and buf_gds-grp-obj-attr.obj-code    = p-obj-code
     8942           and buf_gds-grp-obj-attr.attr-code = p-code
     8943         no-error NO-WAIT.
     8944       if not available buf_gds-grp-obj-attr then do:
     8945         p-deleted = no.
     8946       end.
     8947       else do:
     8948         delete buf_gds-grp-obj-attr.
     8949         p-deleted = yes.
     8950       end.
     8951     end.
     8952   end procedure.
     8953   procedure ggoattr-news :
     8954     define input  parameter p-code           as character no-undo .
     8955     define output parameter p-news           as logical   no-undo .
     8956     do
     8957     on error undo, return error
     8958     :
     8959       case p-code :
     8960               when 'NotCorrOP':U then do:     assign     p-news = true.   end.
     8961               when 'alc-min-price':U then do:     assign     p-news = true.   end.
     8962                   when 'marg-pr-paraf':U then do:     assign     p-news = true.   end.
     8963               when 'level-dis':U then do:     assign     p-news = true.   end.
     8964               when 'no-inc-auto-rep':U then do:     assign     p-news = true.   end.
     8965               when 'ban-sales-via-cd':U then do:     assign     p-news = true.   end.
     8966               when 'alchol-grp':U then do:     assign     p-news = true.   end.
     8967               when 'mark-grp':U then do:     assign     p-news = true.   end.
     8968               when 'sum-grps':U then do:     assign     p-news = true.   end.
     8969               when 'gg-mark-type':U then do:     assign     p-news = true.   end.
     8970               when 'emrc-type':U then do:     assign     p-news = true.   end.
     8971         otherwise do:
     8972           undo, return error substitute("неизвестный атрибут группы товаров на объекте &1", p-code) .
     8973         end.
     8974       end.
     8975     end.
     8976   end procedure.
