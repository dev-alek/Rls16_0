     2462               when 'requisite-alc-decl':U then do:   assign   p-section-num = 1. end.
     2463               when 'division-code':U then do:   assign   p-section-num = 1. end.
     2464               when 'supp-np':U then do:   assign   p-section-num = 1. end.
     2465               when 'own-supp':U then do:   assign   p-section-num = 1. end.
     2466               when 'supp-lgas':U then do:   assign   p-section-num = 1. end.
     2467               when 'tank-farm-for':U then do:   assign   p-section-num = 1. end.
     2468               when 'NPZ':U then do:   assign   p-section-num = 1. end.
