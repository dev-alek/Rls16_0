     8333   procedure pck-attr-code :
     8334     define input  parameter p-code           as character no-undo .
     8335     define output parameter p-type           as character no-undo .
     8336     define output parameter p-format         as character no-undo .
     8337     define output parameter p-label          as character no-undo .
     8338     define output parameter p-user-can-edit  as logical   no-undo .
     8339     define output parameter p-output-display as logical   no-undo .
     8340     define output parameter p-other          as character no-undo .
     8341     do
     8342     on error undo, return error
     8343     :
     8344       case p-code :
     8345               when 'beg-imp-date':U then do:     assign     p-label = "Дата начала приема пакета"     p-type = 'T':U      p-format = "99.99.9999"     p-label = "Дата начала приема пакета"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8346               when 'beg-imp-time':U then do:     assign     p-label = "Время начала разбора пакета"     p-type = 'I':U      p-format = ">>>>>>>>>9"     p-label = "Время начала разбора пакета"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8347         otherwise do:
     8348           undo, return error substitute("неизвестный атрибут принятого пакета &1", p-code ) .
     8349         end.
     8350       end.
     8351     end.
     8352   end procedure.
     8353   procedure pck-attr-tooltip :
     8354     define input  parameter p-code    as character no-undo .
     8355     define output parameter p-tooltip as character no-undo .
     8356     define output parameter p-label   as character no-undo .
     8357     do
     8358     on error undo, return error
     8359     :
     8360       case p-code :
     8361               when 'beg-imp-date':U then do:     assign     p-tooltip = "Дата начала приема пакета"     p-label = "Дата начала приема пакета" .   end.
     8362               when 'beg-imp-time':U then do:     assign     p-tooltip = "Время начала разбора пакета"     p-label = "Время начала разбора пакета" .   end.
     8363         otherwise do:
     8364           undo, return error substitute("неизвестный атрибут принятого пакета &1", p-code ) .
     8365         end.
     8366       end.
     8367     end.
     8368   end procedure.
     8369   procedure pck-attr-value :
     8370     define input  parameter p-tbl-pck   as   character                   no-undo .
     8371     define input  parameter p-db-num    like ub.pck-rcvd-attr.db-num     no-undo .
     8372     define input  parameter p-pack-num  like ub.pck-rcvd-attr.pack-num   no-undo .
     8373     define input  parameter p-code      like ub.pck-rcvd-attr.attr-code  no-undo .
     8374     define output parameter p-value     like ub.pck-rcvd-attr.attr-value no-undo .
     8375     define output parameter p-type      as   character                   no-undo .
     8376     do
     8377     on error undo, return error
     8378     :
     8379       define buffer buf_pck-sent-attr for ub.pck-sent-attr .
     8380       define buffer buf_pck-rcvd-attr for ub.pck-rcvd-attr .
     8381       define variable v-format         as character no-undo .
     8382       define variable v-label          as character no-undo .
     8383       define variable v-user-can-edit  as logical   no-undo .
     8384       define variable v-output-display as logical   no-undo .
     8385       define variable v-other          as character no-undo .
     8386       run pck-attr-code in this-procedure
     8387         (input  p-code
     8388         ,output p-type
     8389         ,output v-format
     8390         ,output v-label
     8391         ,output v-user-can-edit
     8392         ,output v-output-display
     8393         ,output v-other
     8394         ) no-error .
     8395       if error-status :error then do:
     8396         undo, return error return-value .
     8397       end.
     8398       if p-tbl-pck = "pck-rcvd":U then do:
     8399         find first buf_pck-rcvd-attr no-lock
     8400           where buf_pck-rcvd-attr.db-num    = p-db-num
     8401             and buf_pck-rcvd-attr.pack-num  = p-pack-num
     8402             and buf_pck-rcvd-attr.attr-code = p-code
     8403           no-error .
     8404         if available buf_pck-rcvd-attr then do:
     8405           assign
     8406             p-value = buf_pck-rcvd-attr.attr-value
     8407           .
     8408         end.
     8409         else do:
     8410           assign
     8411             p-value = if p-type = 'L':U then "no":U else ""
     8412           .
     8413         end.
     8414       end.
     8415       else do:
     8416         find first buf_pck-sent-attr no-lock
     8417           where buf_pck-sent-attr.db-num    = p-db-num
     8418             and buf_pck-sent-attr.pack-num  = p-pack-num
     8419             and buf_pck-sent-attr.attr-code = p-code
     8420           no-error .
     8421         if available buf_pck-sent-attr then do:
     8422           assign
     8423             p-value = buf_pck-sent-attr.attr-value
     8424           .
     8425         end.
     8426         else do:
     8427           assign
     8428             p-value = if p-type = 'L':U then "no":U else ""
     8429           .
     8430         end.
     8431       end.
     8432     end.
     8433   end procedure.
     8434   procedure pck-attr-write :
     8435     define input parameter p-tbl-pck   as   character                   no-undo .
     8436     define input parameter p-db-num    like ub.pck-rcvd-attr.db-num     no-undo .
     8437     define input parameter p-pack-num  like ub.pck-rcvd-attr.pack-num   no-undo .
     8438     define input parameter p-code      like ub.pck-rcvd-attr.attr-code  no-undo .
     8439     define input parameter p-value     like ub.pck-rcvd-attr.attr-value no-undo .
     8440     do
     8441     on error undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1))
     8442     :
     8443       define buffer buf_pck-sent-attr for ub.pck-sent-attr .
     8444       define buffer buf_pck-rcvd-attr for ub.pck-rcvd-attr .
     8445       define variable v-type           as character no-undo .
     8446       define variable v-format         as character no-undo .
     8447       define variable v-label          as character no-undo .
     8448       define variable v-user-can-edit  as logical   no-undo .
     8449       define variable v-output-display as logical   no-undo .
     8450       define variable v-other          as character no-undo .
     8451       run pck-attr-code in this-procedure
     8452         (input  p-code
     8453         ,output v-type
     8454         ,output v-format
     8455         ,output v-label
     8456         ,output v-user-can-edit
     8457         ,output v-output-display
     8458         ,output v-other
     8459         ) no-error .
     8460       if error-status :error then do:
     8461         undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1)) .
     8462       end.
     8463       if p-tbl-pck = "pck-rcvd":U then do:
     8464         find first buf_pck-rcvd-attr exclusive-lock
     8465           where buf_pck-rcvd-attr.db-num    = p-db-num
     8466             and buf_pck-rcvd-attr.pack-num  = p-pack-num
     8467             and buf_pck-rcvd-attr.attr-code = p-code
     8468           no-error .
     8469         if not available buf_pck-rcvd-attr then do:
     8470           create buf_pck-rcvd-attr .
     8471           assign
     8472             buf_pck-rcvd-attr.db-num    = p-db-num
     8473             buf_pck-rcvd-attr.pack-num  = p-pack-num
     8474             buf_pck-rcvd-attr.attr-code = p-code
     8475           .
     8476         end.
     8477         assign
     8478           buf_pck-rcvd-attr.attr-value = p-value
     8479         .
     8480       end.
     8481       else do:
     8482         find first buf_pck-sent-attr exclusive-lock
     8483           where buf_pck-sent-attr.db-num    = p-db-num
     8484             and buf_pck-sent-attr.pack-num  = p-pack-num
     8485             and buf_pck-sent-attr.attr-code = p-code
     8486           no-error .
     8487         if not available buf_pck-sent-attr then do:
     8488           create buf_pck-sent-attr .
     8489           assign
     8490             buf_pck-sent-attr.db-num    = p-db-num
     8491             buf_pck-sent-attr.pack-num  = p-pack-num
     8492             buf_pck-sent-attr.attr-code = p-code
     8493           .
     8494         end.
     8495         assign
     8496           buf_pck-sent-attr.attr-value = p-value
     8497         .
     8498       end.
     8499     end.
     8500   end procedure.
     8501   procedure pck-attr-exist :
     8502     define input  parameter p-tbl-pck   as   character                   no-undo .
     8503     define input  parameter p-db-num    like ub.pck-rcvd-attr.db-num     no-undo .
     8504     define input  parameter p-pack-num  like ub.pck-rcvd-attr.pack-num   no-undo .
