     9049     on error undo, return error
     9050     :
     9051       define buffer buf_assortment-matrix-attr for ub.assortment-matrix-attr .
     9052       define variable v-format         as character no-undo .
     9053       define variable v-label          as character no-undo .
     9054       define variable v-user-can-edit  as logical   no-undo .
     9055       define variable v-output-display as logical   no-undo .
     9056       define variable v-other          as character no-undo .
     9057       run assmatat-code in this-procedure
     9058         (input  p-code
     9059         ,output p-type
     9060         ,output v-format
     9061         ,output v-label
     9062         ,output v-user-can-edit
     9063         ,output v-output-display
     9064         ,output v-other
     9065         ) no-error .
     9066       if error-status :error then do:
     9067         undo, return error return-value .
     9068       end.
     9069       find first buf_assortment-matrix-attr no-lock
     9070           where  buf_assortment-matrix-attr.asmt-id    = p-asmt-id
     9071           and buf_assortment-matrix-attr.db-num        = p-db-num
     9072           and buf_assortment-matrix-attr.attr-code     = p-code
     9073         no-error .
     9074       if available buf_assortment-matrix-attr then do:
     9075         assign
     9076           p-value =  buf_assortment-matrix-attr.attr-value
     9077         .
     9078       end.
     9079       else do:
     9080           assign
     9081             p-value = if p-type = 'L':U then "no":U else ""
     9082           .
     9083         end.
     9084    end.
     9085   end procedure.
     9086   procedure assmatat-write :
     9087     define input parameter p-asmt-id     like ub.assortment-matrix-attr.asmt-id     no-undo .
     9088     define input parameter p-db-num     like ub.assortment-matrix-attr.db-num     no-undo .
     9089     define input parameter p-code      like ub.assortment-matrix-attr.attr-code  no-undo .
     9090     define input parameter p-value     like ub.assortment-matrix-attr.attr-value no-undo .
     9091     do
     9092     on error undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1))
     9093     :
     9094       define buffer buf_assortment-matrix-attr for ub.assortment-matrix-attr .
     9095       define variable v-type           as character no-undo .
     9096       define variable v-format         as character no-undo .
     9097       define variable v-label          as character no-undo .
     9098       define variable v-user-can-edit  as logical   no-undo .
     9099       define variable v-output-display as logical   no-undo .
     9100       define variable v-other          as character no-undo .
     9101       run assmatat-code in this-procedure
     9102         (input  p-code
     9103         ,output v-type
     9104         ,output v-format
     9105         ,output v-label
     9106         ,output v-user-can-edit
     9107         ,output v-output-display
     9108         ,output v-other
     9109         ) no-error .
     9110       if error-status :error then do:
     9111         undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1)) .
     9112       end.
     9113       find first buf_assortment-matrix-attr exclusive-lock
     9114         where
     9115               buf_assortment-matrix-attr.asmt-id    = p-asmt-id
     9116           and buf_assortment-matrix-attr.db-num    = p-db-num
     9117           and buf_assortment-matrix-attr.attr-code = p-code
     9118         no-error .
     9119       if not available buf_assortment-matrix-attr then do:
     9120         create buf_assortment-matrix-attr .
     9121         assign
     9122           buf_assortment-matrix-attr.asmt-id    = p-asmt-id
     9123           buf_assortment-matrix-attr.db-num    = p-db-num
     9124           buf_assortment-matrix-attr.attr-code = p-code
     9125         .
     9126       end.
     9127       assign
     9128         buf_assortment-matrix-attr.attr-value = p-value
     9129       .
     9130     end.
     9131   end procedure.
