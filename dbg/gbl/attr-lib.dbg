     6038                     when 'NCR-GM_general':U then do:     if lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     6039                     when 'NCR-AS-R_general':U then do:     if lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     6040                     when 'NCR-GM_general':U then do:     if lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     6041                     when 'NCR-AS-R_general':U then do:     if lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'message-by-lim-sum-check,tara-ref':U ),'true,true' ))     no-error.   end.
     6042                     when 'IBM-XML_general':U then do:     if lookup(p-code, 'use-kbo,easyfuel':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'use-kbo,easyfuel':U ),'true,true' ))     no-error.   end.
     6043               when 'IBS-TH_main':U then do:     if lookup(p-code, 'cash-shift,nalc,salesman-mandatory,manual-discnt,log-level,clear-cash-counter,qnty-change':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'cash-shift,nalc,salesman-mandatory,manual-discnt,log-level,clear-cash-counter,qnty-change':U ),'false,false,false,false,false,false,false' ))     no-error.   end.
     6044               when 'IBS-TH_devices':U then do:     if lookup(p-code, 'cash-drawer-plug,cash-drawer-plug-type,cash-drawer-plug-port,cash-drawer-plug-imp,cash-drawer-open,cash-drawer-limit,card-reader-plug,customer-display-plug,customer-display-adv,keyboard-type,keyboard-layout-id,cashless-system,customer-display-type,customer-display-port,cctv-system,cctv-system-address':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'cash-drawer-plug,cash-drawer-plug-type,cash-drawer-plug-port,cash-drawer-plug-imp,cash-drawer-open,cash-drawer-limit,card-reader-plug,customer-display-plug,customer-display-adv,keyboard-type,keyboard-layout-id,cashless-system,customer-display-type,customer-display-port,cctv-system,cctv-system-address':U ),'false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false' ))     no-error.   end.
     6045               when 'IBS-TH_fisreg':U then do:     if lookup(p-code, 'cash-drawer-level,cash-pay-list,pay-names,cutter,com-port':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'cash-drawer-level,cash-pay-list,pay-names,cutter,com-port':U ),'false,false,false,false,false' ))     no-error.   end.
     6046               when 'IBS-TH_rec-print':U then do:     if lookup(p-code, 'max-netto,advert-text,cliche-lines,print-good-code,rmethod-type,rmethod-coeff,rcpt-ord-slip-print,rcpt-ord-alt-print':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'max-netto,advert-text,cliche-lines,print-good-code,rmethod-type,rmethod-coeff,rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'false,false,false,false,false,false,false,false' ))     no-error.   end.
     6047               when 'IBS-TH_interface':U then do:     if lookup(p-code, 'screen-type,screen-layout-id':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'screen-type,screen-layout-id':U ),'false,false' ))     no-error.   end.
     6048               when 'IBS-TH-MOB_main':U then do:     if lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'salesman-mandatory,pos-type-for-discnt':U ),'false,false' ))     no-error.   end.
     6049               when 'IBS-TH-MOB_rec-print':U then do:     if lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ) = 0 then undo, return error substitute("неизвестный атрибут/настройка кассы &1", p-code ).     assign     p-send-param = logical(entry(lookup(p-code, 'rcpt-ord-slip-print,rcpt-ord-alt-print':U ),'false,false' ))     no-error.   end.
     6050         otherwise do:
     6051         end.
     6052       end.
     6053     end.
     6054   end procedure.
     6055   procedure gdshattr-name :
     6056   do
     6057     on error undo, return error
     6058     :
     6059     define input  parameter p-code           as character no-undo .
     6060     define output parameter p-type           as character no-undo .
     6061     define output parameter p-format         as character no-undo .
     6062     define output parameter p-label          as character no-undo .
     6063     define output parameter p-user-can-edit  as logical   no-undo .
     6064     define output parameter p-output-display as logical   no-undo .
     6065     define output parameter p-other          as character no-undo .
     6066       case p-code :
     6067               when 'no-envd':U then do:     assign     p-label = "Не попадает под действие ЕНВД"     p-type = 'L':U      p-format = "+/ "     p-label = "Не попадает под действие ЕНВД"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     6068         otherwise do:
     6069           undo, return error substitute("неизвестный атрибут товара на фирме &1", p-code ).
     6070         end.
     6071       end.
     6072     end.
     6073   end procedure.
     6074   procedure gdshattr-tooltip :
     6075   do
     6076     on error undo, return error
     6077     :
     6078       define input  parameter p-code    as character no-undo .
     6079       define output parameter p-tooltip as character no-undo .
     6080       define output parameter p-label   as character no-undo .
     6081       case p-code :
     6082               when 'no-envd':U then do:     assign     p-tooltip = "Не попадает под действие системы налогообложения ЕНВД, установленной на фирме"     p-label = "Не попадает под действие ЕНВД" .   end.
     6083         otherwise do:
     6084           undo, return error substitute("Неизвестный атрибут товара на фирме &1",  p-code) .
     6085         end.
     6086       end.
     6087     end.
     6088   end procedure.
     6089   procedure gdshattr-value :
     6090   do
     6091     on error undo, return error
     6092     :
     6093     define input  parameter p-code as character no-undo .
     6094     define input  parameter p-obj-type as character no-undo .
     6095     define input  parameter p-obj-code as int no-undo .
     6096     define input  parameter p-gds-code as int no-undo .
     6097     define output parameter p-value as character no-undo .
     6098     define output parameter p-type     as character no-undo .
     6099     define buffer buf-gds-host-attr for ub.gds-host-attr.
     6100     define variable v-format         as character no-undo .
     6101     define variable v-label          as character no-undo .
     6102     define variable v-user-can-edit  as logical   no-undo .
     6103     define variable v-output-display as logical   no-undo .
     6104     define variable v-other          as character no-undo .
     6105     define var attr-host-code as int no-undo .
     6106   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6108     (input  p-obj-type
     6109     ,input  p-obj-code
     6110     ,output attr-host-code
     6111     ) no-error .
     6112    .
     6113       run gdshattr-name in this-procedure
     6114         (input  p-code
     6115         ,output p-type
     6116         ,output v-format
     6117         ,output v-label
     6118         ,output v-user-can-edit
     6119         ,output v-output-display
     6120         ,output v-other
     6121         ) no-error .
     6122       if error-status :error then do:
     6123         undo, return error return-value .
     6124       end.
     6125       Find first  buf-gds-host-attr no-lock where
     6126                   buf-gds-host-attr.host-code = attr-host-code and
     6127                   buf-gds-host-attr.attr-code = p-code and
     6128                   buf-gds-host-attr.gds-code  = p-gds-code no-error .
     6129      if avail buf-gds-host-attr then do:
     6130       assign
     6131       p-value = buf-gds-host-attr.attr-value.
     6132      end.
     6133      else do:
     6134       assign
     6135       p-value = if p-type = 'L':U then "no":U else "".
     6136      end.
     6137   end.
     6138   end procedure.
