     3721               when 'fasovka':U then do:     assign     p-news = true.   end.
     3722                   when 'time-coock':U then do:     assign     p-news = true.   end.
     3723               when 'mark':U then do:     assign     p-news = true.   end.
     3724               when 'sum-grp-gl':U then do:     assign     p-news = true.   end.
     3725               when 'mercur_FGIS':U then do:     assign     p-news = true.   end.
     3726               when 'perishable':U then do:     assign     p-news = true.   end.
     3727               when 'production-only':U then do:     assign     p-news = true.   end.
     3728               when '15x80':U then do:     assign     p-news = true.   end.
     3729               when '8x50':U then do:     assign     p-news = true.   end.
     3730               when '6x50':U then do:     assign     p-news = true.   end.
     3731               when 'calories':U then do:     assign     p-news = true.   end.
     3732               when 'protein':U then do:     assign     p-news = true.   end.
     3733               when 'fat':U then do:     assign     p-news = true.   end.
     3734               when 'carbohydrate':U then do:     assign     p-news = true.   end.
     3735               when 'calc-cal-rec':U then do:     assign     p-news = true.   end.
     3736               when 'cash-parts':U then do:     assign     p-news = true.   end.
     3737               when 'ptrl-as-good':U then do:     assign     p-news = true.   end.
     3738               when 'dflt-insalepr':U then do:     assign     p-news = true.   end.
     3739               when 'gds-ptrl-densities':U then do:     assign     p-news = true.   end.
     3740               when 'gds-CommodityCode':U then do:     assign     p-news = true.   end.
     3741               when 'gds-code-AIS':U then do:     assign     p-news = true.   end.
     3742               when 'length-of':U then do:     assign     p-news = true.   end.
     3743               when 'width-of':U then do:     assign     p-news = true.   end.
     3744               when 'height-of':U then do:     assign     p-news = true.   end.
     3745               when 'qnty-in-box':U then do:     assign     p-news = true.   end.
     3746               when 'weight-box':U then do:     assign     p-news = true.   end.
     3747               when 'qnty-on-pallet':U then do:     assign     p-news = true.   end.
     3748               when 'weight-of-pallet':U then do:     assign     p-news = true.   end.
     3749               when 'fuel-type':U then do:     assign     p-news = true.   end.
     3750               when 'image-list':U then do:     assign     p-news = true.   end.
     3751               when 'MercUnits':U then do:     assign     p-news = true.   end.
     3752               when 'weighed-gds':U then do:     assign     p-news = true.   end.
     3753               when 'IS18Plus':U then do:     assign     p-news = true.   end.
     3754              when 'loyalty-gift':U then do:     assign     p-news = true.   end.
     3755         otherwise do:
     3756           undo, return error substitute("неизвестный глобальный атрибут товара &1", p-code ).
     3757         end.
     3758       end.
     3759     end.
     3760   end procedure.
     3761   procedure gds-attr-copy :
