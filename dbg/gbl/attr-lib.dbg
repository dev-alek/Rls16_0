     9252   procedure attr-write :
     9253      define input  parameter iBuffHand as handle no-undo.
     9254      define input  parameter iCode           as character no-undo .
     9255      define input  parameter iValue          as character no-undo .
     9256      do
     9257      on error undo, return error
     9258      :
     9259         define variable vWhere as character no-undo.
     9260         define variable vTables as character no-undo.
     9261         define variable vTablesAttr as character no-undo.
     9262         define variable vBhTbl as handle no-undo.
     9263         define variable vGroupObj as character no-undo.
     9264         vTables = iBuffHand:table.
     9265         vTablesAttr = vTables + "-attr".
     9266         run gen-where-keyr-tab  in this-procedure
     9267                      (vTables + "-attr",
     9268                       vTables,
     9269                       vTables + "-attr",
     9270                       iBuffHand,
     9271                       "ub",
     9272                       ?,
     9273                       output vWhere).
     9274         create buffer vBhTbl for table vTablesAttr .
     9275         vGroupObj = iBuffHand:buffer-field ("GroupObj"):buffer-value ()no-error.
     9276         if error-status:error
     9277         then do:
     9278            vBhTbl:find-first( substitute("&1 and &2.attr-code eq 'GroupObj'",vwhere,vTablesAttr), no-lock ) no-error .
     9279            vGroupObj = if vBhTbl:available then vBhTbl:buffer-field ("attr-value"):buffer-value () else vTables.
     9280         end.
     9281         run attr-Check-group(vGroupObj,iCode,iValue) no-error.
     9282         if error-status:error
     9283         then
     9284            return error return-value.
     9285         find first xattr where Xattr.GroupObj-code eq  vGroupObj
     9286                            and Xattr.Xattr-Code    eq  iCode
     9287         no-lock no-error.
     9288         if available  Xattr
     9289         then do trans:
     9290            vBhTbl:find-first( substitute("&1 and &2.attr-code eq '&3'",vwhere,vTablesAttr,iCode), exclusive-lock ) no-error .
     9291            if vBhTbl:available
     9292            then do:
     9293               vBhTbl:buffer-field ("attr-value"):buffer-value () = iValue.
     9294            end.
     9295            else do :
     9296               define variable v-field-list as character no-undo.
     9297               define variable vi as integer no-undo.
     9298               run gen-key-field in this-procedure ( input vTables
     9299                                                    ,output v-field-list
     9300                                                 ).
     9301               vBhTbl:buffer-create ().
     9302               do vi = 1 to num-entries(v-field-list,chr(3)):
     9303                  vBhTbl:buffer-field (entry(vi,v-field-list,chr(3))):buffer-value () = iBuffHand:buffer-field (entry(vi,v-field-list,chr(3))):buffer-value ().
     9304               end.
     9305               vBhTbl:buffer-field ("attr-code") :buffer-value () =  iCode.
     9306               vBhTbl:buffer-field ("attr-value"):buffer-value () =  if Xattr.Data-Type eq 'decimal':U
     9307                                                                     then string(decimal (ivalue))
     9308                                                                     else if Xattr.Data-Type eq 'date':U
     9309                                                                     then string(date    (ivalue))
     9310                                                                     else if Xattr.Data-Type eq 'integer':U
     9311                                                                     then string(integer (ivalue))
     9312                                                                     else if Xattr.Data-Type eq 'logical':U
     9313                                                                     then string(logical (ivalue))
     9314                                                                     else                 ivalue no-error.
     9315               if error-status:error
     9316               then
     9317                  return error error-status:get-message (1).
     9318               vBhTbl:buffer-field ("attr-value"):buffer-value () = iValue.
     9319            end.
     9320         end.
     9321         else do:
     9322            return error substitute ("Для группы &1 нет реквизита",vGroupObj,iCode).
     9323         end.
     9324      end.
     9325      finally:
     9326         delete object vBhTbl no-error.
     9327      end.
     9328   end procedure.
     9329   procedure attr-Check-group :
     9330      define input  parameter iGroupObj       as character no-undo.
     9331      define input  parameter iCode           as character no-undo .
     9332      define input  parameter iValue          as character no-undo .
     9333      do
     9334      on error undo, return error
     9335      :
     9336         define variable vdec as character  no-undo.
     9337         define variable vPos as integer no-undo.
     9338         define variable vMaxDec as decimal no-undo init ?.
     9339         define variable vMinDec as decimal no-undo init ?.
     9340         define variable vMaxDat as date no-undo init ?.
     9341         define variable vMinDat as date no-undo init ?.
     9342         define variable vMaxStr as character  no-undo.
     9343         define variable vMinStr as character  no-undo.
     9344         define variable vValDec as decimal no-undo.
     9345         define variable vValDat as date    no-undo.
     9346         define variable vValLog as logical no-undo.
     9347         find first xattr where Xattr.GroupObj-code eq  GroupObj
     9348                            and Xattr.Xattr-Code    eq  iCode
     9349         no-lock no-error.
     9350         if available  Xattr
     9351         then do:
     9352            if Xattr.Data-Type eq 'decimal':U
     9353            then do:
     9354               vValDec = decimal (ivalue) no-error.
     9355               if error-status:error
     9356               then
     9357                  return error substitute ("Для группы &1 значение атрибута &2 должно быть числом. Переданное значение '&3'",iGroupObj,iCode,ivalue).
     9358               if Xattr.Validation ne ""
     9359               then do:
     9360                  vpos = index(Xattr.Validation,"<<").
     9361                  if vpos ne 0
     9362                  then do:
     9363                     vminstr = substring(Xattr.Validation,1,vpos - 1).
     9364                     vmaxStr = substring(Xattr.Validation,vpos + 2).
     9365                     if vminstr ne ""
     9366                     then
     9367                        vmindec = decimal (vminstr)no-error.
     9368                     if vmaxStr ne ""
     9369                     then
     9370                        vmaxdec = decimal (vmaxStr)no-error.
     9371                  end.
     9372               end.
     9373               vdec =  replace(entry(1,Xattr.Data-Format,"."),",","").
     9374               if vdec begins "-"
     9375               then do:
     9376                  assign
     9377                     vmindec = decimal("-" + fill("9",length(vdec) - 1) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "" ) when vmindec eq ?
     9378                     vmaxdec = decimal(      fill("9",length(vdec) - 1) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "")  when vmaxdec eq ?
     9379                  .
     9380               end.
     9381               else
     9382                  assign
     9383                     vmindec = 0                                                                                                               when vmindec eq ?
     9384                     vmaxdec = decimal(      fill("9",length(vdec)    ) + if Xattr.Accuracy > 0 then ("." + fill("9",Xattr.Accuracy)) else "") when vmaxdec eq ?
     9385                  .
     9386               if vmindec > vValDec
     9387               then
     9388                  return error substitute ("Для группы &1 значение атрибута &2 должно быть больше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmindec,vValDec).
     9389               if vmaxdec < vValDec
     9390               then
     9391                  return error substitute ("Для группы &1 значение атрибута &2 должно быть меньше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmaxdec,vValDec).
     9392            end.
     9393            else if Xattr.Data-Type eq 'date':U
     9394            then do :
     9395               vValDat = date (ivalue) no-error.
     9396               if error-status:error
     9397               then
     9398                  return error substitute ("Для группы &1 значение атрибута &2 должно быть числом. Переданное значение '&3'",iGroupObj,iCode,ivalue).
     9399               if Xattr.Validation ne ""
     9400               then do:
     9401                  vpos = index(Xattr.Validation,"<<").
     9402                  if vpos ne 0
     9403                  then do:
     9404                     vminstr = substring(Xattr.Validation,1,vpos - 1).
     9405                     vmaxStr = substring(Xattr.Validation,vpos + 2).
     9406                     if vminstr ne ""
     9407                     then
     9408                        vmindat = date  (vminstr) no-error.
     9409                     if vmaxStr ne ""
     9410                     then
     9411                        vmaxdat = date (vmaxStr) no-error.
     9412                     if vmindat > vValDat
     9413                     then
     9414                        return error substitute ("Для группы &1 значение атрибута &2 должно быть больше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmindat,vValDat).
     9415                     if vmaxdat < vValDat
     9416                     then
     9417                        return error substitute ("Для группы &1 значение атрибута &2 должно быть меньше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmaxdat,vValDat).
     9418                  end.
     9419               end.
     9420            end.
     9421            else if Xattr.Data-Type eq 'integer':U
     9422            then do:
     9423               vValDec = integer (ivalue) no-error.
     9424               if error-status:error
     9425               then
     9426                  return error substitute ("Для группы &1 значение атрибута &2 должно быть числом. Переданное значение '&3'",iGroupObj,iCode,ivalue).
     9427               if vValDec ne decimal (ivalue)
     9428               then
     9429                  return error substitute ("Для группы &1 значение атрибута &2 должно быть целым числом. Переданное значение '&3'",iGroupObj,iCode,ivalue).
     9430               if Xattr.Validation ne ""
     9431               then do:
     9432                  vpos = index(Xattr.Validation,"<<").
     9433                  if vpos ne 0
     9434                  then do:
     9435                     vminstr = substring(Xattr.Validation,1,vpos - 1).
     9436                     vmaxStr = substring(Xattr.Validation,vpos + 2).
     9437                     if vminstr ne ""
     9438                     then
     9439                        vmindec = integer  (vminstr)no-error.
     9440                     if vmaxStr ne ""
     9441                     then
     9442                        vmaxdec = integer (vmaxStr)no-error.
     9443                  end.
     9444               end.
     9445               vdec =  replace(entry(1,Xattr.Data-Format,"."),",","").
     9446               if vdec begins "-"
     9447               then do:
     9448                  assign
     9449                     vmindec = decimal("-" + fill("9",length(vdec) - 1)  ) when vmindec eq ?
     9450                     vmaxdec = decimal(      fill("9",length(vdec) - 1)  ) when vmaxdec eq ?
     9451                  .
     9452               end.
     9453               else
     9454                  assign
     9455                     vmindec = 0                                          when vmindec eq ?
     9456                     vmaxdec = decimal(      fill("9",length(vdec)    ) ) when vmaxdec eq ?
     9457                  .
     9458               if vmindec > vValDec
     9459               then
     9460                  return error substitute ("Для группы &1 значение атрибута &2 должно быть больше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmindec,vValDec).
     9461               if vmaxdec < vValDec
     9462               then
     9463                  return error substitute ("Для группы &1 значение атрибута &2 должно быть меньше или равно &3.  Переданное значение '&4'",iGroupObj,iCode,vmaxdec,vValDec).
     9464            end.
     9465            else if Xattr.Data-Type eq 'logical':U
     9466            then do:
     9467               vValLog = logical (ivalue) no-error.
     9468               if    error-status:error
     9469                  or (    Xattr.Validation ne ""
     9470                      and num-entries(Xattr.Validation,"/") eq 2
     9471                      and ivalue ne entry(1,Xattr.Validation,"/")
     9472                      and ivalue ne entry(2,Xattr.Validation,"/"))
     9473               then
     9474                  return error substitute ("Для группы &1 значение атрибута &2 должно быть числом. Переданное значение '&3'",iGroupObj,iCode,ivalue).
     9475            end.
     9476            else do:
     9477               if Xattr.Domain-Code ne ""
     9478               then do:
     9479                  define variable vParent as character no-undo.
     9480                  define variable vi      as integer no-undo.
     9481                  define variable vValStr as character no-undo.
     9482                  define buffer code for code.
     9483                  vParent = replace(Xattr.Domain-Code, "\", chr(4)).
     9484                  do vi = 1 to num-entries(ivalue):
     9485                     vValStr = entry(vi,ivalue).
     9486                     find first code where code.parent  eq  vParent
     9487                                       and code.status_ ne 1
     9488                                       and code.code    eq vValStr
     9489                     no-lock no-error.
     9490                     if not available code
     9491                     then
     9492                        return error substitute ("Для группы &1 значение атрибута &2 должно в справочнике &4. Переданное значение '&3'",iGroupObj,iCode,vValStr,Xattr.Domain-Code).
     9493                  end.
     9494               end.
     9495               if     Xattr.Validation ne ""
     9496               then do:
     9497                  do vi = 1 to num-entries(ivalue):
     9498                     vValStr = entry(vi,ivalue).
     9499                     if not can-do(Xattr.Validation, vValStr)
     9500                     then
     9501                        return error substitute ("Для группы &1 значение атрибута &2 должно удовлетворять маске '&4'. Переданное значение '&3'",iGroupObj,iCode,vValStr,Xattr.Validation).
     9502                  end.
     9503               end.
     9504            end.
     9505         end.
     9506         else do:
     9507            return error substitute ("Для группы &1 нет реквизита",iGroupObj,iCode).
     9508         end.
     9509      end.
     9510   end procedure.
     9511   procedure attr-read :
     9512      define input   parameter iBuffHand as handle no-undo.
     9513      define input   parameter iCode           as character no-undo .
     9514      define output  parameter oValue          as character no-undo .
     9515      do
     9516      on error undo, return error
     9517      :
     9518         define variable vWhere as character no-undo.
     9519         define variable vTables as character no-undo.
     9520         define variable vTablesAttr as character no-undo.
     9521         define variable vBhTbl as handle no-undo.
     9522         vTables = iBuffHand:table.
     9523         vTablesAttr = vTables + "-attr".
     9524         run GenWhereKeyrTab in this-procedure
     9525                      (vTables + "-attr",
     9526                       vTables,
     9527                       vTables + "-attr",
     9528                       iBuffHand,
     9529                       "ub",
     9530                       ?,
     9531                       output vWhere).
     9532         create buffer vBhTbl for table vTablesAttr .
     9533         oValue = iBuffHand:buffer-field (iCode):buffer-value ()no-error.
     9534         if error-status:error
     9535         then do:
     9536            vBhTbl:find-first( substitute("&1 and &2.attr-code eq '&3'",vwhere,vTablesAttr,icode), no-lock ) no-error .
     9537            oValue = if vBhTbl:available then vBhTbl:buffer-field ("attr-value"):buffer-value () else ?.
     9538         end.
     9539      end.
     9540      finally:
     9541         delete object vBhTbl no-error.
     9542      end.
     9543   end procedure.
     9544   procedure isExemplarGoods:
     9545     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     9546     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     9547     define input  parameter p-gds-code as   integer                    no-undo .
     9548     define output parameter o-result   as   logical                    no-undo.
     9549     define variable vAttrValue as character no-undo.
     9550     define variable vAttrType  as character no-undo.
     9551     define variable EDOParSec  as class ibs.th.gbl.env.prmtrs.edo .
     9552     def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     9553     run gbl/getobjsrvhndl.p (input-output ObjSrv).
     9554     run gds-attr-value in this-procedure
     9555         (input  p-gds-code
     9556         ,input  'mark-type':U
     9557         ,output vAttrValue
     9558         ,output vAttrType
     9559         ) .
     9560     if vAttrValue <> "" then
     9561     do:
     9562       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     9563       o-result = EDOParSec:GetIsEDOForType(vAttrValue).
     9564     end.
     9565     else
     9566       o-result = false.
     9567   end procedure.
     9568   procedure isVolumArticGoods:
     9569     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     9570     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     9571     define input  parameter p-gds-code as   integer                    no-undo .
     9572     define output parameter o-result   as   logical                    no-undo.
     9573     define variable vAttrValue as character no-undo.
     9574     define variable vAttrType  as character no-undo.
     9575     define variable EDOParSec  as class ibs.th.gbl.env.prmtrs.edo .
     9576     def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     9577     run gbl/getobjsrvhndl.p (input-output ObjSrv).
     9578     run gds-attr-value in this-procedure
     9579         (input  p-gds-code
     9580         ,input  'mark-type':U
     9581         ,output vAttrValue
     9582         ,output vAttrType
     9583         ) .
     9584     if vAttrValue <> "" then
     9585     do:
     9586       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     9587       o-result = EDOParSec:GetIsArticForType(vAttrValue).
     9588     end.
     9589     else
     9590       o-result = false.
     9591   end procedure.
