     4160   procedure gds-attr_check-group-np :
     4161   define input parameter p-gds-code like ub.goods-attr.gds-code     no-undo .
     4162   define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     4163   define input parameter p-value as character no-undo .
     4164   define input parameter p-mode  as character no-undo .
     4165   define output parameter p-correct     as logical no-undo .
     4166   define output parameter p-error-code  as character no-undo .
     4167   define buffer buf_goods for ub.goods.
     4168   define buffer buf_gds-host-attr for ub.gds-host-attr.
     4169     define variable v-is-petrolium as logical no-undo .
     4170     define variable v-is-pieces    as logical no-undo .
     4171   do
     4172   on error undo, return error return-value
     4173   :
     4174     CASE p-mode:
     4175       when 'ДОБАВЛЕНИЕ':U then do:
     4176        find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     4177         if not available buf_goods then do:
     4178           return error substitute("(Еще) Нет товара с кодом &1, невозможно выполнить проверку корректности установки атрибута"
     4179                                   , p-gds-code).
     4180         end.
     4181   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4182     (
     4183        input buf_goods.artic
     4184     ,  input buf_goods.prod-type
     4185     ,  input buf_goods.prod-code
     4186     , output v-is-petrolium
     4187     , output v-is-pieces
     4188     ) no-error.
     4189       if error-status:error then do:
     4190         message
     4191           substitute("&1 &2", error-status:get-message(1) , return-value )
     4192         view-as alert-box error.
     4193         return.
     4194       end.
     4195       if not v-is-petrolium then do:
     4196         message
     4197           substitute("Товар-топливо должен иметь топливную единицу измерения для задания диапазона плотности")
     4198         view-as alert-box error.
     4199         return.
     4200       end.
     4201       if v-is-pieces then do:
     4202         message
     4203           substitute("Товар-топливо должен иметь дробную единицу измерения для задания диапазона плотности")
     4204         view-as alert-box error.
     4205         return.
     4206       end.
     4207        if p-error-code <> "" then
     4208           return p-error-code.
     4209       end.
     4210     END CASE.
     4211   end.
     4212   assign
     4213   p-correct = yes.
     4214   end procedure.
     4215   procedure gds-attr_check-is-loyalty-payment :
     4216   define input parameter p-gds-code like ub.goods-attr.gds-code     no-undo .
     4217   define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     4218   define input parameter p-value as character no-undo .
     4219   define input parameter p-mode  as character no-undo .
     4220   define output parameter p-correct     as logical no-undo .
     4221   define output parameter p-error-code  as character no-undo .
     4222   define buffer buf_goods for ub.goods.
     4223   define buffer buf_gds-host-attr for ub.gds-host-attr.
     4224   do
     4225   on error undo, return error return-value
     4226   :
     4227     CASE p-mode:
     4228       when 'ДОБАВЛЕНИЕ':U then do:
     4229        find first buf_goods no-lock where buf_goods.gds-code = p-gds-code.
     4230         if not (
     4231                 buf_goods.gds-type = 'у':U
     4232                 and
     4233                 buf_goods.unit-base = "руб") then do:
     4234           assign
     4235           p-error-code = substitute("Перечисление в систему лояльности должно быть услугой,&1" +
     4236                         "с единицей измерения равной единице измерения национальной валюты (&2)"
     4237                         , chr(10)
     4238                         , "руб"
     4239                         ).
     4240           return p-error-code.
     4241         end.
     4242       end.
     4243     END CASE.
     4244   end.
     4245   assign
     4246   p-correct = yes.
     4247   end procedure.
     4248   procedure gds-attr_init-15x80 :
     4249   define input parameter p-gds-code as integer no-undo .
     4250   define output parameter p-attr-value as character no-undo .
     4251   define variable output-num-lines as integer no-undo init 1.
     4252   define variable v-value as character no-undo .
     4253   define buffer buf_goods for ub.goods.
     4254   do
     4255   on error undo, return error
     4256   :
     4257     if p-gds-code > 0 then do:
     4258       find first buf_goods no-lock where
     4259                 buf_goods.gds-code = p-gds-code  .
     4260         p-attr-value = Break-n-line
     4261           ( INPUT buf_goods.struct,
     4262             INPUT right-trim(fill(string(80) + chr(44), 15), chr(44)),
     4263             OUTPUT output-num-lines
     4264             ) .
     4265     end.
     4266   end.
     4267   end procedure.
     4268   procedure gds-glob-sum-grps :
     4269   define input parameter p-mode  as character no-undo .
     4270   define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     4271   define input-output parameter p-value as integer no-undo .
     4272   define output parameter p-setted as logical no-undo .
     4273   DEFINE VARIABLE rid-list as character no-undo .
     4274   define buffer buf_sum-grp for ub.sum-grp.
     4275     do
     4276     on error undo, return error
     4277     :
     4278       find first buf_sum-grp no-lock where
     4279                  buf_sum-grp.grp-code = integer(p-value) no-error .
     4280       if avail buf_sum-grp then do:
     4281         assign
     4282         rid-list = string(recid(buf_sum-grp))
     4283         .
     4284       end.
     4285       if p-mode = 'ПРОСМОТР':U then do:
     4286       run ref/gds-sumgrp.p ( input this-procedure
     4287                             ,input ""
     4288                             ,input-output rid-list).
     4289       end.
     4290       else do:
     4291         run ref/gds-sumgrp.p ( input this-procedure
     4292                             ,input "b-sel"
     4293                             ,input-output rid-list).
     4294       end.
     4295       if rid-list <> "":U then do:
     4296         find first buf_sum-grp no-lock where
     4297                    recid(buf_sum-grp) = integer(entry(1, rid-list)) no-error .
     4298         if not avail buf_sum-grp then return error.
     4299         assign
     4300         p-value = buf_sum-grp.grp-code
     4301         p-setted = yes
     4302         .
     4303       end.
     4304       else p-setted = no.
     4305     end.
     4306   end procedure.
     4307   procedure gds-attr_init-8x50 :
     4308   define input parameter p-gds-code as integer no-undo .
     4309   define output parameter p-attr-value as character no-undo .
     4310   define variable output-num-lines as integer no-undo .
     4311   define buffer buf_goods for ub.goods.
     4312   do
     4313   on error undo, return error
     4314   :
     4315     if p-gds-code > 0 then do:
     4316       find first buf_goods no-lock where
     4317                 buf_goods.gds-code = p-gds-code  .
     4318       p-attr-value = Break-n-line
     4319         ( INPUT buf_goods.struct,
     4320           INPUT right-trim(fill(string(50) + chr(44), 8), chr(44)),
     4321           OUTPUT output-num-lines
     4322           ) .
     4323     end.
     4324   end.
     4325   end procedure.
     4326   procedure gds-attr_init-6x50 :
     4327   define input parameter p-gds-code as integer no-undo .
     4328   define output parameter p-attr-value as character no-undo .
