     3800               when 'gds-ptrl-densities':U then do:     assign     p-copy = false.   end.
     3801               when 'gds-CommodityCode':U then do:     assign     p-copy = true.   end.
     3802               when 'gds-code-AIS':U then do:     assign     p-copy = true.   end.
     3803               when 'length-of':U then do:     assign     p-copy = true.   end.
