     4997   procedure cd-attr-value :
     4998     do
     4999     on error undo, return error
     5000     :
     5001       define input  parameter p-db-num   like ub.cash-desk-attr.db-num        no-undo .
     5002       define input  parameter p-obj-code like ub.cash-desk-attr.obj-code      no-undo .
     5003       define input  parameter p-pos-type like ub.cash-desk-attr.pos-type      no-undo .
     5004       define input  parameter p-cash-num like ub.cash-desk-attr.cash-num      no-undo .
     5005       define input  parameter p-ucode     like ub.cash-desk-attr.upper-attr-code       no-undo .
     5006       define input  parameter p-code     like ub.cash-desk-attr.attr-code      no-undo .
     5007       define output parameter p-character like ub.cash-desk-attr.attr-value-character  no-undo .
     5008       define output parameter p-date      like ub.cash-desk-attr.attr-value-date       no-undo .
     5009       define output parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal    no-undo .
     5010       define output parameter p-integer   like ub.cash-desk-attr.attr-value-integer    no-undo .
     5011       define output parameter p-logical   like ub.cash-desk-attr.attr-value-logical    no-undo .
     5012       define output parameter p-type     as character no-undo .
     5013       define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     5014       define variable v-format         as character no-undo .
     5015       define variable v-label          as character no-undo .
     5016       define variable v-user-can-edit  as logical   no-undo .
     5017       define variable v-output-display as logical   no-undo .
     5018       define variable v-other          as character no-undo .
     5019       define variable v-prop-list      as character no-undo .
     5020       define variable v-ucode as character no-undo .
     5021       define variable v-code as character no-undo .
     5022       assign
     5023       v-ucode = p-ucode
     5024       v-code = p-code
     5025       .
     5026       if index(p-code, chr(4)) > 0 then do:
     5027         p-ucode = entry(1, p-ucode, chr(4)).
     5028         p-code = entry(1, p-code, chr(4)).
     5029       end.
     5030       run cd-attr-code in this-procedure
     5031         (input  p-ucode
     5032         ,input  p-code
     5033         ,output p-type
     5034         ,output v-format
     5035         ,output v-label
     5036         ,output v-user-can-edit
     5037         ,output v-output-display
     5038         ,output v-other
     5039         ,output v-prop-list
     5040         ) no-error .
     5041       if error-status :error then do:
     5042         undo, return error return-value .
     5043       end.
     5044       find first buf_cash-desk-attr no-lock
     5045         where buf_cash-desk-attr.db-num    = p-db-num
     5046           and buf_cash-desk-attr.obj-code  = p-obj-code
     5047           and buf_cash-desk-attr.pos-type  = p-pos-type
     5048           and buf_cash-desk-attr.cash-num  = p-cash-num
     5049           and buf_cash-desk-attr.upper-attr-code = v-ucode
     5050           and buf_cash-desk-attr.attr-code = v-code
     5051         no-error .
     5052       if avail buf_cash-desk-attr then do:
     5053         assign
     5054           p-character =  buf_cash-desk-attr.attr-value-character
     5055           p-date      =  buf_cash-desk-attr.attr-value-date
     5056           p-decimal   =  buf_cash-desk-attr.attr-value-decimal
     5057           p-integer   =  buf_cash-desk-attr.attr-value-integer
     5058           p-logical   =  buf_cash-desk-attr.attr-value-logical
     5059           p-type      =  buf_cash-desk-attr.attr-value-type.
     5060         .
     5061       end.
     5062     end.
     5063   end procedure.
     5064   procedure cd-attr-write :
     5065     do
     5066     on error undo, return error
     5067     :
     5068       define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5069       define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5070       define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5071       define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5072       define input parameter p-ucode    like ub.cash-desk-attr.upper-attr-code  no-undo .
     5073       define input parameter p-code     like ub.cash-desk-attr.attr-code  no-undo .
     5074       define input parameter p-character like ub.cash-desk-attr.attr-value-character  no-undo .
     5075       define input parameter p-date      like ub.cash-desk-attr.attr-value-date       no-undo .
     5076       define input parameter p-decimal   like ub.cash-desk-attr.attr-value-decimal    no-undo .
     5077       define input parameter p-integer   like ub.cash-desk-attr.attr-value-integer    no-undo .
     5078       define input parameter p-logical   like ub.cash-desk-attr.attr-value-logical    no-undo .
     5079       define buffer buf_cash-desk-attr for ub.cash-desk-attr .
     5080       define variable v-type           as character no-undo .
     5081       define variable v-format         as character no-undo .
     5082       define variable v-label          as character no-undo .
     5083       define variable v-user-can-edit  as logical   no-undo .
     5084       define variable v-output-display as logical   no-undo .
     5085       define variable v-other          as character no-undo .
     5086       define variable v-dop            as character no-undo .
     5087       define variable v-prop-value-list as character no-undo .
     5088       define variable v-prop-list      as character no-undo .
     5089       define variable v-ucode as character no-undo .
     5090       define variable v-code as character no-undo .
     5091       assign
     5092       v-ucode = p-ucode
     5093       v-code = p-code
     5094       .
     5095       if index(p-code, chr(4)) > 0 then do:
     5096         p-ucode = entry(1, p-ucode, chr(4)).
     5097         p-code = entry(1, p-code, chr(4)).
     5098       end.
     5099       run cd-attr-code in this-procedure
     5100         (input  p-ucode
     5101         ,input  p-code
     5102         ,output v-type
     5103         ,output v-format
     5104         ,output v-label
     5105         ,output v-user-can-edit
     5106         ,output v-output-display
     5107         ,output v-other
     5108         ,output v-prop-list
     5109         ) no-error .
     5110       if error-status :error then do:
     5111         undo, return error return-value .
     5112       end.
     5113       find first buf_cash-desk-attr exclusive-lock
     5114         where buf_cash-desk-attr.db-num  = p-db-num
     5115           and buf_cash-desk-attr.obj-code  = p-obj-code
     5116           and buf_cash-desk-attr.pos-type  = p-pos-type
     5117           and buf_cash-desk-attr.cash-num  = p-cash-num
     5118           and buf_cash-desk-attr.upper-attr-code = v-ucode
     5119           and buf_cash-desk-attr.attr-code = v-code
     5120         no-error .
     5121       if not available buf_cash-desk-attr then do:
     5122         create buf_cash-desk-attr .
     5123         assign
     5124         buf_cash-desk-attr.db-num    = p-db-num
     5125         buf_cash-desk-attr.obj-code  = p-obj-code
     5126         buf_cash-desk-attr.pos-type  = p-pos-type
     5127         buf_cash-desk-attr.cash-num  = p-cash-num
     5128         buf_cash-desk-attr.upper-attr-code = v-ucode
     5129         buf_cash-desk-attr.attr-code = v-code
     5130         buf_cash-desk-attr.attr-value-type = v-type
     5131         .
     5132       end.
     5133       CASE buf_cash-desk-attr.attr-value-type:
     5134         when 'character':U then do:
     5135           assign
     5136           buf_cash-desk-attr.attr-value-character = p-character
     5137           .
     5138         end.
     5139         when 'date':U then do:
     5140           assign
     5141           buf_cash-desk-attr.attr-value-date = p-date
     5142           .
     5143         end.
     5144         when 'decimal':U then do:
     5145           assign
     5146           buf_cash-desk-attr.attr-value-decimal = p-decimal
     5147           .
     5148         end.
     5149         when 'integer':U then do:
     5150           assign
     5151           buf_cash-desk-attr.attr-value-integer = p-integer
     5152         .
     5153       end.
     5154         when 'logical':U then do:
     5155       assign
     5156           buf_cash-desk-attr.attr-value-logical = p-logical
     5157       .
     5158         end.
     5159       end case.
     5160       release buf_cash-desk-attr no-error .
     5161       if error-status:error then do:
     5162         undo, return error return-value .
     5163       end.
     5164     end.
     5165   end procedure.
