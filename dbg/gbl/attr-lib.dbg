     4345   procedure gds-attr_check-can-energy-value :
     4346     define input parameter p-gds-code like ub.goods-attr.gds-code     no-undo .
     4347     define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     4348     define input parameter p-value as character no-undo .
     4349     define input parameter p-mode  as character no-undo .
     4350     define output parameter p-correct     as logical no-undo .
     4351     define output parameter p-error-code  as character no-undo .
     4352     define buffer buf_goods for ub.goods.
     4353     define variable v-label as character no-undo .
     4354     define variable v-tool-tip as character no-undo .
     4355     define variable v-value as character no-undo .
     4356     define variable v-type as character no-undo .
     4357     do
     4358     on error undo, return error return-value
     4359     :
     4360       if p-mode = 'удаление':U then do:
     4361         p-correct = yes.
     4362         return.
     4363       end.
     4364       find first buf_goods no-lock where
     4365               buf_goods.gds-code = p-gds-code no-error.
     4366       if not available buf_goods then do:
     4367         return error substitute("(Еще) Нет товара с кодом &1, невозможно выполнить проверку корректности установки атрибута"
     4368                                 , p-gds-code).
     4369       end.
     4370       run  gds-attr-value in this-procedure (
     4371                                               input buf_goods.gds-code
     4372                                              ,input 'calc-cal-rec':U
     4373                                              ,output v-value
     4374                                              ,output v-type) .
     4375       if logical(v-value) = no then do:
     4376         assign
     4377         p-correct = yes.
     4378         return ''.
     4379       end.
     4380       else do:
     4381         run gds-attr-tooltip in this-procedure ( input p-code
     4382                                                 ,output v-tool-tip
     4383                                                 ,output v-label) no-error.
     4384         if error-status:error then do:
     4385           v-label = p-code.
     4386         end.
     4387         assign
     4388         p-error-code = substitute("Запрещено изменение атрибута &1&2" +
     4389                       "на товаре &3 стоит флаг <Расчет энергетической ценности из основного рецепта>"
     4390                       , v-label
     4391                       , chr(10)
     4392                       , buf_goods.gds-code
     4393                       ).
     4394         return p-error-code.
     4395       end.
     4396     end.
     4397   end procedure.
     4398   procedure gds-attr-manual-edit :
     4399   do
     4400     on error undo, return error
     4401     :
     4402     define input  parameter p-code           as character no-undo .
     4403     define output parameter p-section-num    as integer no-undo .
     4404       case p-code :
     4405               when 'alcohol-prod':U then do:     assign     p-section-num = 0.   end.
     4406               when 'egais-name':U then do:     assign     p-section-num = 0.   end.
     4407               when 'ptrl-without-rvs':U then do:     assign     p-section-num = 6.   end.
     4408               when 'office-type':U then do:     assign     p-section-num = 1.   end.
     4409               when 'mark-type':U then do:     assign     p-section-num = 1.   end.
     4410               when 'emrc-type':U then do:     assign     p-section-num = 1.   end.
     4411               when 'item-matter-mark':U then do:     assign     p-section-num = 1.   end.
     4412               when 'type-method-calc':U then do:     assign     p-section-num = 1.   end.
     4413               when 'cash-book-id':U then do:     assign     p-section-num = 1.   end.
     4414               when 'oper-serv-idd':U then do:     assign     p-section-num = 1.   end.
     4415               when 'group-np':U then do:     assign     p-section-num = 6.   end.
     4416               when 'is-loyalty-payment':U then do:     assign     p-section-num = 1.   end.
     4417               when 'ban-bonus':U then do:     assign     p-section-num = 1.   end.
     4418               when 'null-price':U then do:     assign     p-section-num = 1.   end.
     4419               when 'fasovka':U then do:     assign     p-section-num = 1.   end.
     4420               when 'time-coock':U then do:     assign     p-section-num = 1.   end.
     4421               when 'mercur_FGIS':U then do:     assign     p-section-num = 1.   end.
     4422               when 'perishable':U then do:     assign     p-section-num = 1.   end.
     4423               when 'production-only':U then do:     assign     p-section-num = 1.   end.
     4424               when 'mark':U then do:     assign     p-section-num = 0.   end.
     4425               when 'sum-grp-gl':U then do:     assign     p-section-num = 1.   end.
     4426               when '15x80':U then do:     assign     p-section-num = 5.   end.
     4427               when '8x50':U then do:     assign     p-section-num = 5.   end.
     4428               when '6x50':U then do:     assign     p-section-num = 5.   end.
     4429               when 'calories':U then do:     assign     p-section-num = 2.   end.
     4430               when 'protein':U then do:     assign     p-section-num = 2.   end.
     4431               when 'fat':U then do:     assign     p-section-num = 2.   end.
     4432               when 'carbohydrate':U then do:     assign     p-section-num = 2.   end.
     4433               when 'calc-cal-rec':U then do:     assign     p-section-num = 2.   end.
     4434               when 'cash-parts':U then do:     assign     p-section-num = 1.   end.
     4435               when 'ptrl-as-good':U then do:     assign     p-section-num = 6.   end.
     4436               when 'dflt-insalepr':U then do:     assign     p-section-num = 6.   end.
     4437               when 'gds-ptrl-densities':U then do:     assign     p-section-num = 6.   end.
     4438               when 'gds-CommodityCode':U then do:     assign     p-section-num = 1.   end.
     4439               when 'gds-code-AIS':U then do:     assign     p-section-num = 6.   end.
     4440               when 'length-of':U then do:     assign     p-section-num = 3.   end.
     4441               when 'width-of':U then do:     assign     p-section-num = 3.   end.
     4442               when 'height-of':U then do:     assign     p-section-num = 3.   end.
     4443               when 'qnty-in-box':U then do:     assign     p-section-num = 4.   end.
     4444               when 'weight-box':U then do:     assign     p-section-num = 4.   end.
     4445               when 'qnty-on-pallet':U then do:     assign     p-section-num = 4.   end.
     4446               when 'weight-of-pallet':U then do:     assign     p-section-num = 1.   end.
     4447               when 'fuel-type':U then do:     assign     p-section-num = 6.   end.
     4448               when 'image-list':U then do:     assign     p-section-num = 0.   end.
     4449               when 'MercUnits':U then do:     assign     p-section-num = 0.   end.
     4450               when 'weighed-gds':U then do:     assign     p-section-num = 1.   end.
     4451               when 'IS18Plus':U then do:     assign     p-section-num = 4.   end.
     4452               when 'loyalty-gift':U then do:     assign     p-section-num = 4.   end.
     4453         otherwise do:
     4454           undo, return error substitute("неизвестный атрибут товара &1", p-code ).
     4455         end.
     4456       end.
     4457     end.
     4458   end procedure.
     4459   procedure gds-attr-batch-edit :
