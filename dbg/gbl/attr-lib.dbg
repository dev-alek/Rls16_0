     6765   procedure gds-attr-margin-value :
     6766   do
     6767   on error undo, return error
     6768   :
     6769   define input parameter p-gds-code as integer      no-undo.
     6770   define input parameter p-obj-type  as character    no-undo.
     6771   define input parameter p-obj-code  as integer      no-undo.
     6772   define output parameter p-min-value as decimal      no-undo init ?.
     6773   define output parameter p-max-value as decimal      no-undo init ?.
     6774   define output parameter p-increase-pc as decimal      no-undo init ?.
     6775   define output parameter p-rmethod as character no-undo init "":U.
     6776   define output parameter p-base as decimal no-undo init ?.
     6777   define output parameter p-range-margin     as integer      no-undo.
     6778   define output parameter p-exists-margin    as logical no-undo.
     6779   define output parameter p-range-increase     as integer      no-undo.
     6780   define output parameter p-exists-increase  as logical no-undo.
     6781   define output parameter p-range-rmethod     as integer no-undo .
     6782   define output parameter p-exists-rmethod   as logical no-undo .
     6783   define variable v-nume as integer no-undo .
     6784   DEFINE VARIABLE v-min-value as decimal      no-undo.
     6785   DEFINE VARIABLE v-max-value as decimal      no-undo.
     6786   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
     6787   define variable v-rmethod as character no-undo .
     6788   define variable v-base as decimal no-undo .
     6789   define variable v-exists-margin as logical no-undo .
     6790   define variable v-exists-increase as logical no-undo .
     6791   define variable v-exists-rmethod as logical no-undo .
     6792   define variable v-mes as character no-undo .
     6793   define buffer buf_goods for ub.goods.
     6794   define buffer buf_margins-gds-obj-attr      for ub.gds-obj-attr.
     6795   define buffer buf_increase-gds-obj-attr      for ub.gds-obj-attr.
     6796   define buffer buf_round-gds-obj-attr      for ub.gds-obj-attr.
     6797   find first buf_goods no-lock where
     6798              buf_goods.gds-code = p-gds-code no-error .
     6799   if not avail buf_goods then do:
     6800     message
     6801       skip "Не удалось найти товар с кодом" p-gds-code
     6802       view-as alert-box error .
     6803     undo, return error .
     6804   end.
     6805   find first buf_margins-gds-obj-attr no-lock
     6806       where buf_margins-gds-obj-attr.gds-code = p-gds-code
     6807         and buf_margins-gds-obj-attr.attr-code = 'gds-margins':U
     6808         and buf_margins-gds-obj-attr.obj-type  = p-obj-type
     6809         and buf_margins-gds-obj-attr.obj-code  = p-obj-code
     6810   no-error .
     6811   if available buf_margins-gds-obj-attr then do:
     6812     assign
     6813     v-min-value   =  decimal(trim(entry(1, buf_margins-gds-obj-attr.attr-value, "-":U), "%":U))
     6814     v-max-value   =  decimal(trim(entry(2, buf_margins-gds-obj-attr.attr-value, "-":U), "%":U))
     6815     v-exists-margin = v-min-value <> ? and v-max-value <> ?
     6816     .
     6817   end.
     6818   find first buf_increase-gds-obj-attr no-lock
     6819       where buf_increase-gds-obj-attr.gds-code = p-gds-code
     6820         and buf_increase-gds-obj-attr.attr-code = 'increase-pc':U
     6821         and buf_increase-gds-obj-attr.obj-type  = p-obj-type
     6822         and buf_increase-gds-obj-attr.obj-code  = p-obj-code
     6823   no-error .
     6824   if available buf_increase-gds-obj-attr then do:
     6825     assign
     6826     v-increase-pc = decimal(buf_increase-gds-obj-attr.attr-value)
     6827     v-exists-increase = yes
     6828     .
     6829   end.
     6830   find first buf_round-gds-obj-attr no-lock
     6831       where buf_round-gds-obj-attr.gds-code = p-gds-code
     6832         and buf_round-gds-obj-attr.attr-code = 'round-method':U
     6833         and buf_round-gds-obj-attr.obj-type  = p-obj-type
     6834         and buf_round-gds-obj-attr.obj-code  = p-obj-code
     6835   no-error .
     6836   if available buf_round-gds-obj-attr then do:
     6837     assign
     6838     v-rmethod =  entry(1, buf_round-gds-obj-attr.attr-value, chr(32))
     6839     v-nume    = num-entries(buf_round-gds-obj-attr.attr-value, chr(32))
     6840     v-base     = (if v-nume >= 2 and entry(v-nume, buf_round-gds-obj-attr.attr-value, chr(32)) <> "":U
     6841                   then decimal (entry(v-nume, buf_round-gds-obj-attr.attr-value, chr(32)))
     6842                   else 0
     6843                       )
     6844     v-exists-rmethod = yes
     6845     no-error.
     6846     if error-status :error   or (LOOKUP(p-rmethod, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0 and p-rmethod <> "":U)
     6847     then do:
     6848       assign
     6849       v-mes = "Ошибка при чтении метода округления" + chr(10) +
     6850              return-value + chr(10) +
     6851              trim(error-status :get-message(1)) + chr(10) +
     6852              trim(error-status :get-message(2)) + chr(10) +
     6853              trim(error-status :get-message(3)) + chr(10) +
     6854              trim(error-status :get-message(4)) + chr(10) +
     6855              trim(error-status :get-message(5)).
     6856       return error v-mes.
     6857     end.
     6858   end.
     6859   if not (v-exists-margin and v-exists-increase and v-exists-rmethod) then do:
     6860     run grp-obj-margin-value  in this-procedure (
     6861    input  buf_goods.grp-code
     6862   ,input  p-obj-type
     6863   ,input  p-obj-code
     6864   ,output p-min-value
     6865   ,output p-max-value
     6866   ,output p-increase-pc
     6867   ,output p-rmethod
     6868   ,output p-base
     6869   ,output p-range-margin
     6870   ,output p-exists-margin
     6871   ,output p-range-increase
     6872   ,output p-exists-increase
     6873   ,output p-range-rmethod
     6874   ,output p-exists-rmethod ) no-error .
     6875   if error-status:error then do:
     6876       assign
     6877       v-mes = substitute("Ошибка при чтении параметров переоценки из группы для товара &1", p-gds-code) + chr(10) +
     6878              return-value + chr(10) +
     6879              trim(error-status :get-message(1)) + chr(10) +
     6880              trim(error-status :get-message(2)) + chr(10) +
     6881              trim(error-status :get-message(3)) + chr(10) +
     6882              trim(error-status :get-message(4)) + chr(10) +
     6883              trim(error-status :get-message(5)).
     6884         return error v-mes.
     6885   end.
     6886   end.
     6887   assign
     6888   p-min-value = (if v-exists-margin then v-min-value else p-min-value)
     6889   p-max-value = (if v-exists-margin then v-max-value else p-max-value)
     6890   p-exists-margin = (if v-exists-margin then v-exists-margin else p-exists-margin)
     6891   p-increase-pc = (if v-exists-increase then v-increase-pc else p-increase-pc)
     6892   p-rmethod = (if v-exists-rmethod then v-rmethod else p-rmethod)
     6893   p-base    = (if v-exists-rmethod then v-base else p-base)
     6894   p-range-margin  = (if v-exists-margin then (- 1) else p-range-margin)
     6895   p-range-increase = (if v-exists-increase then (- 1) else p-range-increase)
     6896   p-range-rmethod  = (if v-exists-rmethod then  (- 1 )else p-range-rmethod)
     6897   .
     6898   end.
     6899   end procedure.
     6900   procedure gds-o-normal-wastage-value :
     6901   do
     6902   on error undo, return error
     6903   :
     6904     define input-output parameter objNormWast as class ibs.th.ref.normwastsub no-undo.
     6905     define variable v-mes as character no-undo .
     6906     define variable v-value as character no-undo.
     6907     define variable v-type as character no-undo.
     6908     if not valid-object (objNormWast)
     6909     then do:
     6910        message
     6911         skip "objNormWast is null reference"
     6912         view-as alert-box error .
     6913       undo, return error .
     6914     end.
     6915     if not valid-object (objNormWast:ParGdsOAttr)
     6916     then do:
     6917        message
     6918         skip "objNormWast:ParGdsOAttrObj is null reference"
     6919         view-as alert-box error .
     6920       undo, return error .
     6921     end.
     6922     define buffer buf_goods for ub.goods.
     6923     define buffer buf_normal-wastage-gds-obj-attr      for ub.gds-obj-attr.
     6924     find first buf_goods no-lock where
     6925                buf_goods.gds-code = objNormWast:ParGdsOAttr:GdsCode no-error .
     6926     if not avail buf_goods then do:
     6927       message
     6928         skip "Не удалось найти товар с кодом" objNormWast:ParGdsOAttr:GdsCode
     6929         view-as alert-box error .
     6930       undo, return error .
     6931     end.
     6932     find first buf_normal-wastage-gds-obj-attr no-lock
     6933         where buf_normal-wastage-gds-obj-attr.gds-code = objNormWast:ParGdsOAttr:GdsCode
     6934           and buf_normal-wastage-gds-obj-attr.attr-code = 'normal-wastage-o':U
     6935           and buf_normal-wastage-gds-obj-attr.obj-type  = objNormWast:ParGdsOAttr:ObjType
     6936           and buf_normal-wastage-gds-obj-attr.obj-code  = objNormWast:ParGdsOAttr:ObjCode
     6937     no-error .
     6938     if available buf_normal-wastage-gds-obj-attr then do:
     6939       define variable v-temp-str1 as character no-undo .
     6940       v-temp-str1 = buf_normal-wastage-gds-obj-attr.attr-value.
     6941       case num-entries (v-temp-str1, ";"):
     6942         when 2 then do:
     6943           assign
     6944             objNormWast:NormalWastageSummer =  decimal(trim(entry(1, v-temp-str1, ";":U)))
     6945             objNormWast:NormalWastageWinter =  decimal(trim(entry(2, v-temp-str1, ";":U)))
     6946           .
     6947         end.
     6948         when 4 then do:
     6949           assign
     6950             objNormWast:NormalWastageTransSummer   =  decimal(trim(entry(1, v-temp-str1, ";":U)))
     6951             objNormWast:NormalWastageTransWinter   =  decimal(trim(entry(2, v-temp-str1, ";":U)))
     6952             objNormWast:NormalWastageSummer   =  decimal(trim(entry(3, v-temp-str1, ";":U)))
     6953             objNormWast:NormalWastageWinter   =  decimal(trim(entry(4, v-temp-str1, ";":U)))
     6954           .
     6955         end.
     6956         when 0 then do:
     6957           assign
     6958             objNormWast:NormalWastageSummer   =  decimal(trim(v-temp-str1))
     6959             objNormWast:NormalWastageWinter   =  decimal(trim(v-temp-str1))
     6960           .
     6961         end.
     6962       end case.
     6963       find first buf_normal-wastage-gds-obj-attr no-lock
     6964           where buf_normal-wastage-gds-obj-attr.gds-code = objNormWast:ParGdsOAttr:GdsCode
     6965             and buf_normal-wastage-gds-obj-attr.attr-code = 'cli-decommissioned':U
     6966             and buf_normal-wastage-gds-obj-attr.obj-type  = objNormWast:ParGdsOAttr:ObjType
     6967             and buf_normal-wastage-gds-obj-attr.obj-code  = objNormWast:ParGdsOAttr:ObjCode
     6968       no-error .
     6969       run clntattr-value in this-procedure (input objNormWast:ParGdsOAttr:ObjType,
     6970                                             input objNormWast:ParGdsOAttr:ObjCode,
     6971                                             input 'cli-decommissioned':U,
     6972                                             output v-value,
     6973                                             output v-type) no-error.
     6974       objNormWast:IsDecommissioned = (v-value = "yes":u).
     6975       run clntattr-value in this-procedure (input objNormWast:ParGdsOAttr:ObjType,
     6976                                             input objNormWast:ParGdsOAttr:ObjCode,
     6977                                             input 'cli-clim-grp':U,
     6978                                             output v-value,
     6979                                             output v-type) no-error.
     6980       if num-entries(v-value) = 3 then assign
     6981         objNormWast:BeginSummer = date (entry(2, v-value))
     6982         objNormWast:BeginWinter  = date (entry(3, v-value))
     6983       .
     6984       else do:
     6985         objNormWast:BeginSummer = 01/03.
     6986         objNormWast:BeginWinter = 01/10.
     6987       end.
     6988       if objNormWast:ParGdsOAttr:OnDate <> ?
     6989       then do:
     6990         if objNormWast:BeginSummer <= objNormWast:ParGdsOAttr:OnDate and objNormWast:ParGdsOAttr:onDate < objNormWast:BeginWinter
     6991         then do:
     6992           objNormWast:NormalWastageDate = objNormWast:NormalWastageSummer.
     6993           objNormWast:NormalWastageTransDate = objNormWast:NormalWastageTransSummer.
     6994         end.
     6995         else do:
     6996           objNormWast:NormalWastageDate = objNormWast:NormalWastageWinter.
     6997           objNormWast:NormalWastageTransDate = objNormWast:NormalWastageTransWinter.
     6998         end.
     6999       end.
     7000     end.
     7001   end.
     7002   end procedure.
     7003   procedure gdsoattr-copy :
     7004     do
     7005     on error undo, return error
     7006     :
     7007       define input  parameter p-code           as character no-undo .
     7008       define output parameter p-copy           as logical   no-undo .
     7009       case p-code :
     7010               when 'scales-code':U then do:     assign     p-copy = false.   end.
     7011               when 'free-price':U then do:     assign     p-copy = false.   end.
     7012               when 'sum-grp':U then do:     assign     p-copy = true.   end.
     7013               when 'increase-pc':U then do:     assign     p-copy = true.   end.
     7014               when 'min-zapas':U then do:     assign     p-copy = true.   end.
     7015               when 'round-method':U then do:     assign     p-copy = true.   end.
     7016               when 'petrol-purse':U then do:     assign     p-copy = false.   end.
     7017               when 'need-auth':U then do:     assign     p-copy = false.   end.
     7018               when 'gds-margins':U then do:     assign     p-copy = true.   end.
     7019               when 'proprietor':U then do:     assign     p-copy = false.   end.
     7020               when 'fbr-cost-rubl':U then do:     assign     p-copy = true.   end.
     7021               when 'no-income-goods':U then do:     assign     p-copy = true.   end.
     7022               when 'taracode':U then do:     assign     p-copy = true.   end.
     7023               when 'calories-o':U then do:     assign     p-copy = false.   end.
     7024               when 'protein-o':U then do:     assign     p-copy = false.   end.
     7025               when 'fat-o':U then do:     assign     p-copy = false.   end.
     7026               when 'carbohydrate-o':U then do:     assign     p-copy = false.   end.
     7027               when 'doc-tickets':U then do:     assign     p-copy = true.   end.
     7028               when 'normal-wastage-o':U then do:     assign     p-copy = true.   end.
     7029               when 'dop-alt-name-o':U then do:     assign     p-copy = true.   end.
     7030               when 'dt-seasons':U then do:     assign     p-copy = true.   end.
     7031               when 'change-dt-seasons':U then do:     assign     p-copy = false.   end.
     7032               when 'mark-collect-type':U then do:     assign     p-copy = false.   end.
     7033         otherwise do:
     7034           undo, return error substitute("неизвестный атрибут товара на объекте &1",  p-code ).
     7035         end.
     7036       end.
     7037     end.
     7038   end procedure.
     7039   procedure gdsoattr-manual-edit :
