     2474               when 'cli-clim-grp':U then do:   assign   p-section-num = 1. end.
     2475               when 'cli-decommissioned':U then do:   assign   p-section-num = 1. end.
     2476               when 'atd-alarm-schedule':U then do:   assign   p-section-num = 0. end.
     2477               when 'exp-isPM-last-date':U then do:   assign   p-section-num = 1. end.
     2478         otherwise do:
     2479           undo, return error substitute("неизвестный атрибут клиента &1", p-code) .
     2480         end.
     2481       end.
     2482     end.
     2483   end procedure.
