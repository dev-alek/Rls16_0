     6215         undo, return error return-value .
     6216       end.
     6217       find first buf_gds-host-attr exclusive-lock where
     6218                  buf_gds-host-attr.gds-code  = p-gds-code AND
     6219                  buf_gds-host-attr.host-code  = attr-host-code AND
     6220                  buf_gds-host-attr.attr-code = p-code no-error .
     6221       if not available buf_gds-host-attr then do:
