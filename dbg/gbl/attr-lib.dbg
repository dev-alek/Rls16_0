     1617   end procedure.
     1618   procedure clntattr-tooltip :
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       define input  parameter p-code    as character no-undo .
     1623       define output parameter p-tooltip as character no-undo .
     1624       define output parameter p-label   as character no-undo .
