     7060               when 'protein-o':U then do:     assign     p-section-num = 0.   end.
     7061               when 'fat-o':U then do:     assign     p-section-num = 0.   end.
     7062               when 'carbohydrate-o':U then do:     assign     p-section-num = 0.   end.
     7063               when 'doc-tickets':U then do:     assign     p-section-num = 1.   end.
     7064               when 'normal-wastage-o':U then do:     assign     p-section-num = 1.   end.
     7065               when 'dop-alt-name-o':U then do:     assign     p-section-num = 1.   end.
     7066               when 'dt-seasons':U then do:     assign     p-section-num = 2.   end.
     7067         otherwise do:
     7068           undo, return error substitute("неизвестный атрибут товара на объекте &1", p-code ).
     7069         end.
