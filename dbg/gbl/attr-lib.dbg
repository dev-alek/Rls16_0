     7110   procedure gds-obj-sum-grps :
     7111   define input parameter parparentproc as widget-handle no-undo .
     7112   define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     7113   define input parameter p-obj-type like ub.gds-obj-attr.obj-type no-undo .
     7114   define input parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     7115   define input-output parameter p-value as character no-undo .
     7116   define output parameter p-setted as logical no-undo .
     7117   DEFINE VARIABLE rid-list as character no-undo .
     7118   define buffer buf_sum-grp for ub.sum-grp.
     7119     do
     7120     on error undo, return error
     7121     :
     7122       find first buf_sum-grp no-lock where
     7123                  buf_sum-grp.grp-code = integer(p-value) no-error .
     7124       if avail buf_sum-grp then do:
     7125         assign
     7126         rid-list = string(recid(buf_sum-grp))
     7127         .
     7128       end.
     7129       run ref/sum-grps.w ( input parparentproc
     7130                           ,input "b-sel"
     7131                           ,input-output rid-list).
     7132       if rid-list <> "":U then do:
     7133         find first buf_sum-grp no-lock where
     7134                    recid(buf_sum-grp) = integer(entry(1, rid-list)) no-error .
     7135         if not avail buf_sum-grp then return error.
     7136         assign
     7137         p-value = string(buf_sum-grp.grp-code, "999")
     7138         p-setted = yes
     7139         .
     7140       end.
     7141       else p-setted = no.
     7142     end.
     7143   end procedure.
     7144   procedure gds-obj-init-increase-pc :
     7145   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     7146   define input parameter p-obj-type like ub.gds-obj.obj-type no-undo .
     7147   define input parameter p-obj-code like ub.gds-obj.obj-code no-undo .
     7148   define output parameter p-value as character no-undo .
     7149   define buffer buf_goods for ub.goods.
     7150     do
     7151     on error undo, return error
     7152     :
     7153       find first buf_goods no-lock where
     7154                  buf_goods.gds-code = p-gds-code no-error .
     7155       if avail buf_goods then
     7156       assign
     7157       p-value = string(buf_goods.increase-pc)
     7158       .
     7159     end.
     7160   end procedure.
     7161   procedure gds-obj-round-method :
     7162   define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     7163   define input parameter p-obj-type like ub.gds-obj-attr.obj-type no-undo .
     7164   define input parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     7165   define input-output parameter p-value as character no-undo .
     7166   define output parameter p-setted as logical no-undo .
     7167   DEFINE VARIABLE v-value as character no-undo .
     7168     do
     7169     on error undo, return error
     7170     :
     7171       assign
     7172       v-value = p-value.
     7173       run ref/r-method.w (input-output v-value) no-error .
     7174       if p-value <> v-value and v-value <> ? and not error-status:error then do:
     7175         assign
     7176         p-setted = yes
     7177         p-value = v-value
     7178         .
     7179       end.
     7180     end.
     7181   end procedure.
     7182   procedure gds-obj-taracode :
     7183   define input parameter parparentproc as widget-handle no-undo .
     7184   define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     7185   define input parameter p-obj-type like ub.gds-obj-attr.obj-type no-undo .
     7186   define input parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     7187   define input-output parameter p-value as character no-undo .
     7188   define output parameter p-setted as logical no-undo .
     7189   DEFINE VARIABLE rid-list as character no-undo .
     7190   define variable dflt-cd as character no-undo .
     7191   define variable v-obj-db-num as integer no-undo .
     7192   define variable par-type as character no-undo .
     7193   define variable v-value-character as character no-undo .
     7194   define variable v-value-date as date no-undo .
     7195   define variable v-value-decimal as decimal no-undo .
     7196   define variable v-value-integer as INTEGER no-undo .
     7197   define variable v-value-logical AS LOGICAL no-undo .
     7198   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     7199     do
     7200     on error undo, return error return-value
     7201     :
     7202   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     7204     (input  p-obj-type
     7205     ,input  p-obj-code
     7206     ,output v-obj-db-num
     7207     )  .
     7208       run adm/shattri.p (
     7209         input "get":U
     7210         ,input p-obj-type
     7211         ,input p-obj-code
     7212         ,input  'cd-sending':U
     7213         ,input  "dflt-cd":U
     7214         ,output v-value-character
     7215         ,output v-value-date
     7216         ,output v-value-decimal
     7217         ,output v-value-integer
     7218         ,output v-value-logical
     7219         ,output par-type
     7220         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     7221         ) no-error .
     7222       IF not error-status:error then
     7223       assign
     7224       dflt-cd = v-value-character .
     7225       find first buf_cash-desk-attr no-lock where
     7226                 buf_cash-desk-attr.obj-code = p-obj-code
     7227            and  buf_cash-desk-attr.cash-num = 0
     7228            and  buf_cash-desk-attr.pos-type = dflt-cd
     7229            and buf_cash-desk-attr.attr-code = ('tara-ref':U  + chr(4) + p-value)
     7230            and buf_cash-desk-attr.db-num  = v-obj-db-num  no-error .
     7231       if avail buf_cash-desk-attr then do:
     7232         assign
     7233         rid-list = string(recid(buf_cash-desk-attr))
     7234         .
     7235       end.
     7236       run ref/ncrtarac.w ( input parparentproc
     7237                       ,input ?
     7238                       ,input p-obj-type
     7239                       ,input p-obj-code
     7240                       ,input ?
     7241                       ,input ?
     7242                       ,input "b-sel"
     7243                       ,input-output rid-list).
     7244       if rid-list <> "":U then do:
     7245         find first buf_cash-desk-attr no-lock where
     7246                    recid(buf_cash-desk-attr) = integer(entry(1, rid-list)) no-error .
     7247         if not avail buf_cash-desk-attr then return error.
     7248         assign
     7249         p-value = string(integer(entry(2, buf_cash-desk-attr.attr-code, chr(4)) ), "99")
     7250         p-setted = yes
     7251         .
     7252       end.
     7253       else p-setted = no.
     7254     end.
     7255   end procedure.
     7256   procedure gds-obj-attr_check-ptrl-divis :
     7257     define input parameter  p-gds-code    like ub.gds-obj-attr.gds-code no-undo .
     7258     define input parameter  p-obj-type    like ub.gds-obj-attr.obj-type no-undo .
     7259     define input parameter  p-obj-code    like ub.gds-obj-attr.obj-code no-undo .
     7260     define output parameter p-correct     as logical   no-undo .
     7261     define output parameter p-error-code  as character no-undo .
     7262     define buffer buf_goods for ub.goods.
     7263     define variable v-is-petrolium as logical no-undo .
     7264     define variable v-is-pieces    as logical no-undo .
     7265     do
     7266     on error undo, return error return-value
     7267     :
     7268       find first buf_goods no-lock where
     7269               buf_goods.gds-code = p-gds-code no-error.
     7270       if not available buf_goods then do:
     7271         return error substitute("(Еще) Нет товара с кодом &1, невозможно выполнить проверку корректности установки атрибута"
     7272                                 , p-gds-code).
     7273       end.
     7274   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     7275     (
     7276        input buf_goods.artic
     7277     ,  input buf_goods.prod-type
     7278     ,  input buf_goods.prod-code
     7279     , output v-is-petrolium
     7280     , output v-is-pieces
     7281     ) no-error.
     7282       if error-status:error then do:
     7283         assign
     7284         p-error-code =  substitute("&1 &2", error-status:get-message(1) , return-value ).
     7285         return.
     7286       end.
     7287       if not v-is-petrolium then do:
     7288         assign
     7289         p-error-code = substitute("Товар-топливо должен иметь топливную единицу измерения для задания норм естественной убыли для топлива").
     7290         return p-error-code.
     7291       end.
     7292       if v-is-pieces then do:
     7293         assign
     7294         p-error-code = substitute("Товар-топливо должен иметь дробную единицу измерения для задания норм естественной убыли для топлива").
     7295         return p-error-code.
     7296       end.
     7297       assign
     7298       p-correct = yes.
     7299     end.
     7300   end procedure.
     7301   procedure gdspoatr-name :
     7302   do
     7303     on error undo, return error
     7304     :
     7305     define input  parameter p-code           as character no-undo .
     7306     define output parameter p-type           as character no-undo .
     7307     define output parameter p-format         as character no-undo .
     7308     define output parameter p-label          as character no-undo .
     7309     define output parameter p-user-can-edit  as logical   no-undo .
     7310     define output parameter p-output-display as logical   no-undo .
     7311     define output parameter p-other          as character no-undo .
     7312       case p-code :
     7313               when 'corrcoeff-po':U then do:     assign     p-label = "Корр.коэфф для расчета заказов"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Корр.коэфф для расчета заказов"     p-user-can-edit  = true     p-output-display = false     p-other = "init-value=1"      .   end.
     7314               when 'CorrIztDel':U then do:     assign     p-label = "Дата НА ВЫВОД ИЗ АССОРТ"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата НА ВЫВОД ИЗ АССОРТ"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     7315         otherwise do:
     7316           undo, return error substitute("неизвестный атрибут товара для ЗАКАЗОВ на объекте/фирме &1", p-code ).
     7317         end.
     7318       end.
     7319     end.
     7320   end procedure.
     7321   procedure gdspoatr-tooltip :
     7322   do
     7323     on error undo, return error
     7324     :
     7325       define input  parameter p-code    as character no-undo .
     7326       define output parameter p-tooltip as character no-undo .
     7327       define output parameter p-label   as character no-undo .
     7328       case p-code :
     7329               when 'corrcoeff-po':U then do:     assign     p-tooltip = "Корректирующий коэффициент для расчета кол-ва в заказах ОБЪЕКТ-ПОСТАВЩИК"     p-label = "Корр.коэфф для расчета заказов" .   end.
     7330               when 'CorrIztDel':U then do:     assign     p-tooltip = "Дата простановки статуса НА ВЫВОД ИЗ АССОРТИМЕНТА"     p-label = "Дата НА ВЫВОД ИЗ АССОРТ" .   end.
     7331         otherwise do:
     7332           undo, return error substitute("Неизвестный атрибут товара для ЗАКАЗОВ на объекте/фирме &1", p-code ).
     7333         end.
     7334       end.
     7335     end.
     7336   end procedure.
     7337   procedure gdspoatr-value :
     7338    do
     7339     on error undo, return error
     7340     :
     7341       define input  parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     7342       define input  parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     7343       define input  parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     7344       define input  parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     7345       define output parameter p-value    like ub.gds-obj-prop-attr.attr-value no-undo .
     7346       define output parameter p-type     as character no-undo .
     7347       define buffer buf_gds-obj-prop-attr for ub.gds-obj-prop-attr .
     7348       define variable v-format         as character no-undo .
     7349       define variable v-label          as character no-undo .
     7350       define variable v-user-can-edit  as logical   no-undo .
     7351       define variable v-output-display as logical   no-undo .
     7352       define variable v-other          as character no-undo .
     7353       define variable jj as integer no-undo .
     7354       define variable v-found as logical no-undo .
     7355       run gdspoatr-name in this-procedure
     7356         (input  p-code
     7357         ,output p-type
     7358         ,output v-format
     7359         ,output v-label
     7360         ,output v-user-can-edit
     7361         ,output v-output-display
     7362         ,output v-other
     7363         ) no-error .
     7364       if error-status :error then do:
     7365         undo, return error return-value .
     7366       end.
     7367       find first buf_gds-obj-prop-attr no-lock where
     7368                  buf_gds-obj-prop-attr.gds-code  = p-gds-code AND
     7369                  buf_gds-obj-prop-attr.obj-type  = p-obj-type AND
     7370                  buf_gds-obj-prop-attr.obj-code  = p-obj-code AND
     7371                  buf_gds-obj-prop-attr.attr-code = p-code
     7372         no-error .
     7373       if avail buf_gds-obj-prop-attr then do:
     7374         assign
     7375           p-value =  buf_gds-obj-prop-attr.attr-value
     7376         .
     7377       end.
     7378       else do:
     7379         do jj = 1 to num-entries(v-other, chr(47)):
     7380           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "init-value":U then do:
     7381             assign
     7382             p-value = string(entry(2, entry(jj, v-other, chr(47)), "=":U))
     7383             v-found = yes
     7384             .
     7385           end.
     7386         end.
     7387         if not v-found then do:
     7388           assign
     7389           p-value = if p-type = 'L':U then "no":U else ""
     7390           .
     7391         end.
     7392       end.
     7393     end.
     7394   end procedure.
     7395   procedure gdspoatr-write :
     7396     do
     7397     on error undo, return error
     7398     :
     7399       define input parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     7400       define input parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     7401       define input parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     7402       define input parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     7403       define input parameter p-value    like ub.gds-obj-prop-attr.attr-value no-undo .
     7404       define buffer buf_gds-obj-prop-attr for ub.gds-obj-prop-attr .
     7405       define buffer lock_gds-obj-prop-attr for ub.gds-obj-prop-attr .
     7406       define variable v-type           as character no-undo .
     7407       define variable v-format         as character no-undo .
     7408       define variable v-label          as character no-undo .
     7409       define variable v-user-can-edit  as logical   no-undo .
     7410       define variable v-output-display as logical   no-undo .
     7411       define variable v-other          as character no-undo .
     7412       run gdspoatr-name in this-procedure
     7413         (input  p-code
     7414         ,output v-type
     7415         ,output v-format
     7416         ,output v-label
     7417         ,output v-user-can-edit
     7418         ,output v-output-display
     7419         ,output v-other
     7420         ) no-error .
     7421       if error-status :error then do:
     7422         undo, return error return-value .
     7423       end.
     7424       find first buf_gds-obj-prop-attr exclusive-lock where
     7425                  buf_gds-obj-prop-attr.gds-code  = p-gds-code
     7426              AND buf_gds-obj-prop-attr.obj-type  = p-obj-type
     7427              AND buf_gds-obj-prop-attr.obj-code  = p-obj-code
     7428              AND buf_gds-obj-prop-attr.attr-code = p-code no-error .
     7429       if not available buf_gds-obj-prop-attr then do:
     7430         create buf_gds-obj-prop-attr .
     7431         assign
     7432           buf_gds-obj-prop-attr.gds-code  = p-gds-code
     7433           buf_gds-obj-prop-attr.obj-type  = p-obj-type
     7434           buf_gds-obj-prop-attr.obj-code  = p-obj-code
     7435           buf_gds-obj-prop-attr.attr-code = p-code
     7436           buf_gds-obj-prop-attr.attr-value = p-value no-error
     7437         .
     7438       end.
     7439       ELSE
     7440       ASSIGN
     7441       buf_gds-obj-prop-attr.attr-value = p-value no-error.
     7442     end.
     7443   end procedure.
     7444   procedure gdspoatr-exist :
     7445     do
     7446     on error undo, return error
     7447     :
     7448       define input parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     7449       define input parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     7450       define input parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     7451       define input parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     7452       define output parameter p-exist    as logical no-undo .
     7453       define buffer buf_gds-obj-prop-attr for ub.gds-obj-prop-attr .
     7454       define variable v-type           as character no-undo .
     7455       define variable v-format         as character no-undo .
     7456       define variable v-label          as character no-undo .
     7457       define variable v-user-can-edit  as logical   no-undo .
     7458       define variable v-output-display as logical   no-undo .
     7459       define variable v-other          as character no-undo .
     7460       run gdspoatr-name in this-procedure
     7461         (input  p-code
     7462         ,output v-type
     7463         ,output v-format
     7464         ,output v-label
     7465         ,output v-user-can-edit
     7466         ,output v-output-display
     7467         ,output v-other
     7468         ) no-error .
     7469       if error-status :error then do:
     7470         undo, return error return-value .
     7471       end.
     7472       find first buf_gds-obj-prop-attr no-lock where
     7473                  buf_gds-obj-prop-attr.gds-code  = p-gds-code
     7474              AND buf_gds-obj-prop-attr.obj-type  = p-obj-type
     7475              AND buf_gds-obj-prop-attr.obj-code  = p-obj-code
     7476              AND buf_gds-obj-prop-attr.attr-code = p-code no-error .
     7477       if available buf_gds-obj-prop-attr then do:
     7478         P-EXIST = YES.
     7479       end.
     7480     end.
     7481   end procedure.
     7482   procedure gdspoatr-delete :
     7483     do
     7484     on error undo, return error
     7485     :
     7486       define input parameter p-gds-code like ub.gds-obj-prop-attr.gds-code   no-undo .
     7487       define input parameter p-obj-type like ub.gds-obj-prop-attr.obj-type   no-undo .
     7488       define input parameter p-obj-code like ub.gds-obj-prop-attr.obj-code   no-undo .
     7489       define input parameter p-code     like ub.gds-obj-prop-attr.attr-code  no-undo .
     7490       define output parameter p-deleted  as logical no-undo .
     7491       define buffer buf_gds-obj-prop-attr for ub.gds-obj-prop-attr .
     7492       define variable v-type           as character no-undo .
     7493       define variable v-format         as character no-undo .
     7494       define variable v-label          as character no-undo .
     7495       define variable v-user-can-edit  as logical   no-undo .
     7496       define variable v-output-display as logical   no-undo .
     7497       define variable v-other          as character no-undo .
     7498       run gdspoatr-name in this-procedure
     7499         (input  p-code
     7500         ,output v-type
     7501         ,output v-format
     7502         ,output v-label
     7503         ,output v-user-can-edit
     7504         ,output v-output-display
     7505         ,output v-other
     7506         ) no-error .
     7507       if error-status :error then do:
     7508         undo, return error return-value .
     7509       end.
     7510       find first buf_gds-obj-prop-attr exclusive-lock where
     7511                  buf_gds-obj-prop-attr.gds-code  = p-gds-code
     7512              AND buf_gds-obj-prop-attr.obj-type  = p-obj-type
     7513              AND buf_gds-obj-prop-attr.obj-code  = p-obj-code
     7514              AND buf_gds-obj-prop-attr.attr-code = p-code no-error .
     7515       if not available buf_gds-obj-prop-attr then do:
     7516         P-DELETED = NO.
     7517       end.
     7518       ELSE DO:
     7519          delete buf_gds-obj-prop-attr.
     7520          P-DELETED = YES.
     7521       END.
     7522     end.
     7523   end procedure.
     7524   procedure gdspoatr-copy :
     7525     do
     7526     on error undo, return error
     7527     :
     7528       define input  parameter p-code           as character no-undo .
     7529       define output parameter p-copy           as logical   no-undo .
     7530       case p-code :
     7531               when 'corrcoeff-po':U then do:     assign     p-copy = false.   end.
     7532               when 'CorrIztDel':U then do:     assign     p-copy = false.   end.
     7533         otherwise do:
     7534           undo, return error substitute("неизвестный атрибут товара ДЛЯ ЗАКАЗОВ на объекте/фирме &1",  p-code ).
     7535         end.
     7536       end.
     7537     end.
     7538   end procedure.
