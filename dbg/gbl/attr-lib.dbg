     7902   procedure gds-attr_check-can-set-dt-seasons :
     7903     define input  parameter p-gds-code like ub.goods.gds-code     no-undo .
     7904     define output parameter p-can-set  as   logical no-undo .
     7905     define variable v-value as character no-undo .
     7906     define variable v-type as character no-undo .
     7907     run gds-attr-value in this-procedure (
     7908       input p-gds-code
     7909       ,input "fuel-type"
     7910       ,output v-value
     7911       ,output v-type) .
     7912     p-can-set = v-value = "diesel".
     7913   end procedure.
     7914   procedure gds-attr_check-code-dt-seasons :
     7915     define input  parameter p-code     as   integer             no-undo .
     7916     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
     7917     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
     7918     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
     7919     define output parameter p-dt-code  as   integer             no-undo .
     7920     define buffer buf_code for ub.code.
     7921     p-dt-code = 0.
     7922     if can-find(first buf_code where
     7923                     buf_code.code = string(p-code)
     7924                 and buf_code.parent = "DTSeasons") then
     7925     do:
     7926       p-dt-code = p-code.
     7927       run gdsoattr-gds-code in this-procedure
     7928         ("dt-seasons", string(p-code), p-obj-type, p-obj-code, output p-gds-code).
     7929       if p-gds-code = 0 then
     7930         p-gds-code = p-code.
     7931     end.
     7932     else
     7933       p-gds-code = p-code.
     7934   end procedure.
     7935   procedure gds-obj-dt-seasons :
     7936     define input parameter parparentproc as widget-handle no-undo .
     7937     define input parameter p-gds-code like ub.gds-obj-attr.gds-code no-undo .
     7938     define input parameter p-obj-type like ub.gds-obj-attr.obj-type no-undo .
     7939     define input parameter p-obj-code like ub.gds-obj-attr.obj-code no-undo .
     7940     define input-output parameter p-value as character no-undo .
     7941     define output parameter p-setted as logical no-undo .
     7942     define variable rid            as recid no-undo .
     7943     define variable canSetDtSeason as logical no-undo.
     7944     define variable gdsCode        like ub.gds-obj-attr.gds-code no-undo.
     7945     define buffer buf_code       for ub.code.
     7946     define buffer buf_goods      for ub.goods.
     7947     run gds-attr_check-can-set-dt-seasons in this-procedure
     7948       (p-gds-code, output canSetDtSeason).
     7949     if not canSetDtSeason then
     7950     do:
     7951       find first buf_goods where
     7952                  buf_goods.gds-code = p-gds-code
     7953            no-lock no-error.
     7954       message "Атрибут ~"Сезон ДТ~| может быть настроен только для дизельного топлива.~n"
     7955               "Для товара " if available buf_goods then substitute("<&1 &2 &3>",buf_goods.gds-code, buf_goods.artic, buf_goods.gds-name) else ""
     7956               "~nне установлен атрибут ~"Тип топлива~" в значении ~"ДТ~".~n"
     7957               "В установке атрибута «Сезон ДТ» отказано." view-as alert-box.
     7958       p-setted = no.
     7959       return.
     7960     end.
     7961     do
     7962     on error undo, return error
     7963     :
     7964       run ref/dtseasons.p
     7965         (input  parparentproc
     7966         , p-gds-code
     7967         ,output rid
     7968         ) no-error.
     7969       if rid <> ? then
     7970       do:
     7971         find first buf_code no-lock where
     7972                    recid(buf_code) = rid no-error .
     7973         if not avail buf_code then return error.
     7974         run gdsoattr-gds-code in this-procedure
     7975           ("dt-seasons", buf_code.code, p-obj-type, p-obj-code, output gdsCode).
     7976         if gdsCode <> 0 and gdsCode <> p-gds-code then
     7977         do:
     7978           find first buf_goods where
     7979                      buf_goods.gds-code = gdsCode
     7980                no-lock no-error.
     7981           message "Атрибут ~"Сезон ДТ~" может быть настроен только для одного дизельного топлива для одного объекта.~n"
     7982                   "Для товара " if available buf_goods then substitute("<&1 &2 &3>",buf_goods.gds-code, buf_goods.artic, buf_goods.gds-name) else ""
     7983                   "~nуже настроен атрибут ~"Сезон ДТ~" в значении " buf_code.code ".~n"
     7984                   "В установке атрибута «Сезон ДТ» отказано." view-as alert-box.
     7985           undo, return error.
     7986         end.
     7987         assign
     7988           p-value = buf_code.code
     7989           p-setted = yes
     7990         .
     7991       end.
     7992       else
     7993       do:
     7994         if error-status:error then
     7995         do:
     7996           message
     7997             return-value skip
     7998             "В установке атрибута «Сезон ДТ» отказано." view-as alert-box
     7999           .
     8000         end.
     8001         p-setted = no.
     8002       end.
     8003     end.
     8004   end procedure.
     8005   procedure ext-system-attr-code :
     8006     define input  parameter p-code           as character no-undo .
     8007     define output parameter p-type           as character no-undo .
     8008     define output parameter p-format         as character no-undo .
     8009     define output parameter p-label          as character no-undo .
     8010     define output parameter p-user-can-edit  as logical   no-undo .
     8011     define output parameter p-output-display as logical   no-undo .
     8012     define output parameter p-other          as character no-undo .
     8013     do
     8014     on error undo, return error
     8015     :
     8016       case p-code :
     8017               when 'need-gen-new-xpack':U then do:     assign     p-label = "Необходимость формирования нового пакета(ов) для ВС"     p-type = 'L':U      p-format = "+/-"     p-label = "Необходимость формирования нового пакета(ов) для ВС"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     8018               when 'FTP':U then do:     assign     p-label = "FTP"     p-type = 'C':U      p-format = "X(256)"     p-label = "FTP"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8019               when 'Login':U then do:     assign     p-label = "Login"     p-type = 'C':U      p-format = "X(256)"     p-label = "Login"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8020               when 'Password':U then do:     assign     p-label = "Password"     p-type = 'C':U      p-format = "X(256)"     p-label = "Password"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8021               when 'Path':U then do:     assign     p-label = "Путь"     p-type = 'C':U      p-format = "X(256)"     p-label = "Путь"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8022               when 'IN-dir':U then do:     assign     p-label = "Вход"     p-type = 'C':U      p-format = "X(256)"     p-label = "Вход"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8023               when 'OUT-dir':U then do:     assign     p-label = "Исход"     p-type = 'C':U      p-format = "X(256)"     p-label = "Исход"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8024               when 'cert-sign':U then do:     assign     p-label = "Использовать цифровую подпись"     p-type = 'L':U      p-format = "+/-"     p-label = "Использовать цифровую подпись"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8025               when 'cert-sign-subject':U then do:     assign     p-label = "Владелец подписи (Субъект)"     p-type = 'C':U      p-format = "X(256)"     p-label = "Владелец подписи (Субъект)"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8026               when 'cert-sign-issuer':U then do:     assign     p-label = "Издатель подписи"     p-type = 'C':U      p-format = "X(256)"     p-label = "Издатель подписи"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8027               when 'cert-file-ext':U then do:     assign     p-label = "Расширение имени файла"     p-type = 'C':U      p-format = "X(6)"     p-label = "Расширение имени файла"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8028               when 'cert-repository':U then do:     assign     p-label = "Хранилище сертификатов"     p-type = 'I':U      p-format = ">>9"     p-label = "Хранилище сертификатов"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8029               when 'AuthToken':U then do:     assign     p-label = "Токен авторизации"     p-type = 'C':U      p-format = "X(16000)"     p-label = "Токен авторизации"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     8030               when 'AuthTokenDT':U then do:     assign     p-label = "Дата и время запроса токена авторизации"     p-type = 'C':U      p-format = "X(256)"     p-label = "Дата и время запроса токена авторизации"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     8031               when 'host-code':U then do:     assign     p-label = "Код фирмы"     p-type = 'I':U      p-format = ">>>>>>>>>9"     p-label = "Код фирмы"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8032               when 'obj':U then do:     assign     p-label = "Объект"     p-type = 'C':U      p-format = "X(15)"     p-label = "Объект"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8033               when 'user-id':U then do:     assign     p-label = "Пользователь"     p-type = 'C':U      p-format = "X(256)"     p-label = "Пользователь"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8034               when 'server-addr':U then do:     assign     p-label = "Адрес сервера МОТП или Диадок"     p-type = 'C':U      p-format = "X(256)"     p-label = "Адрес сервера МОТП или Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8035               when 'proxy-addr':U then do:     assign     p-label = "Адрес прокси"     p-type = 'C':U      p-format = "X(256)"     p-label = "Адрес прокси"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8036               when 'proxy-login':U then do:     assign     p-label = "Логин прокси"     p-type = 'C':U      p-format = "X(256)"     p-label = "Логин прокси"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8037               when 'proxy-pswd':U then do:     assign     p-label = "Пароль прокси"     p-type = 'C':U      p-format = "X(256)"     p-label = "Пароль прокси"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8038               when 'proxy-ssl':U then do:     assign     p-label = "SSL прокси"     p-type = 'L':U      p-format = "+/-"     p-label = "SSL прокси"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8039               when 'AuthToken-send':U then do:     assign     p-label = "Просроченный токен авторизации"     p-type = 'C':U      p-format = "X(16000)"     p-label = "Просроченный токен авторизации"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     8040               when 'mail-list':U then do:     assign     p-label = "Список адресов эл. почты"     p-type = 'C':U      p-format = "X(1000)"     p-label = "Список адресов эл. почты"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8041               when 'diadoc-user':U then do:     assign     p-label = "Пользователь Диадок"     p-type = 'C':U      p-format = "X(256)"     p-label = "Пользователь Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8042               when 'diadoc-pwd':U then do:     assign     p-label = "Пароль пользователя Диадок"     p-type = 'C':U      p-format = "X(256)"     p-label = "Пароль пользователя Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8043               when 'diadoc-key':U then do:     assign     p-label = "Ключ разработчика Диадок"     p-type = 'C':U      p-format = "X(256)"     p-label = "Ключ разработчика Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8044               when 'diadoc-lastload':U then do:     assign     p-label = "Дата последнего загруженого документа Диадок"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата последнего загруженого документа Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8045               when 'diadoc-ssl':U then do:     assign     p-label = "Отключение проверки шифрования Диадок"     p-type = 'L':U      p-format = "yes/no"     p-label = "Отключение проверки шифрования Диадок"     p-user-can-edit  = true     p-output-display = false     p-other = '':u      .   end.
     8046         otherwise do:
     8047           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
     8048         end.
     8049       end.
     8050     end.
     8051   end procedure.
     8052   procedure ext-system-attr-tooltip :
     8053     define input  parameter p-code    as character no-undo .
     8054     define output parameter p-tooltip as character no-undo .
     8055     define output parameter p-label   as character no-undo .
     8056     do
     8057     on error undo, return error
     8058     :
     8059       case p-code :
     8060               when 'need-gen-new-xpack':U then do:     assign     p-tooltip = "Необходимо ли формировать новый пакет(ы) для внешней системы"     p-label = "Необходимость формирования нового пакета(ов) для ВС" .   end.
     8061               when 'FTP':U then do:     assign     p-tooltip = "FTP (адрес)"     p-label = "FTP" .   end.
     8062               when 'Login':U then do:     assign     p-tooltip = "Login FTP"     p-label = "Login" .   end.
     8063               when 'Password':U then do:     assign     p-tooltip = "Password FTP"     p-label = "Password" .   end.
     8064               when 'Path':U then do:     assign     p-tooltip = "Путь (от HOME-директории)"     p-label = "Путь" .   end.
     8065               when 'IN-dir':U then do:     assign     p-tooltip = "Папка Входящие"     p-label = "Вход" .   end.
     8066               when 'OUT-dir':U then do:     assign     p-tooltip = "Папка исходящие"     p-label = "Исход" .   end.
     8067               when 'cert-sign':U then do:     assign     p-tooltip = "Использовать цифровую подпись при обмене с внешней системой"     p-label = "Использовать цифровую подпись" .   end.
     8068               when 'cert-sign-subject':U then do:     assign     p-tooltip = "Владелец подписи (Субъект)"     p-label = "Владелец подписи (Субъект)" .   end.
     8069               when 'cert-sign-issuer':U then do:     assign     p-tooltip = "Издатель подписи"     p-label = "Издатель подписи" .   end.
     8070               when 'cert-file-ext':U then do:     assign     p-tooltip = "Расширение имени файла с цифровой подписью"     p-label = "Расширение имени файла" .   end.
     8071               when 'cert-repository':U then do:     assign     p-tooltip = "Расположение хранилища сертификатов"     p-label = "Хранилище сертификатов" .   end.
     8072               when 'AuthToken':U then do:     assign     p-tooltip = "Токен авторизации"     p-label = "Токен авторизации" .   end.
     8073               when 'AuthTokenDT':U then do:     assign     p-tooltip = "Дата и время запроса токена авторизации"     p-label = "Дата и время запроса токена авторизации" .   end.
     8074               when 'host-code':U then do:     assign     p-tooltip = "Код фирмы"     p-label = "Код фирмы" .   end.
     8075               when 'obj':U then do:     assign     p-tooltip = "Объект"     p-label = "Объект" .   end.
     8076               when 'user-id':U then do:     assign     p-tooltip = "Пользователь"     p-label = "Пользователь" .   end.
     8077               when 'server-addr':U then do:     assign     p-tooltip = "Адрес сервера МОТП или Диадок"     p-label = "Адрес сервера МОТП или Диадок" .   end.
     8078               when 'proxy-addr':U then do:     assign     p-tooltip = "Адрес прокси"     p-label = "Адрес прокси" .   end.
     8079               when 'proxy-login':U then do:     assign     p-tooltip = "Логин прокси"     p-label = "Логин прокси" .   end.
     8080               when 'proxy-pswd':U then do:     assign     p-tooltip = "Пароль прокси"     p-label = "Пароль прокси" .   end.
     8081               when 'proxy-ssl':U then do:     assign     p-tooltip = "SSL прокси"     p-label = "SSL прокси" .   end.
     8082               when 'AuthToken-send':U then do:     assign     p-tooltip = "Просроченный токен авторизации"     p-label = "Просроченный токен авторизации" .   end.
     8083               when 'mail-list':U then do:     assign     p-tooltip = "Список адресов эл. почты для отправки уведомлений. Указывать через запятую."     p-label = "Список адресов эл. почты" .   end.
     8084               when 'diadoc-user':U then do:     assign     p-tooltip = "Пользователь Диадок"     p-label = "Пользователь Диадок" .   end.
     8085               when 'diadoc-pwd':U then do:     assign     p-tooltip = "Пароль пользователя Диадок"     p-label = "Пароль пользователя Диадок" .   end.
     8086               when 'diadoc-key':U then do:     assign     p-tooltip = "Ключ разработчика Диадок"     p-label = "Ключ разработчика Диадок" .   end.
     8087               when 'diadoc-lastload':U then do:     assign     p-tooltip = "Дата последнего загруженого документа Диадок"     p-label = "Дата последнего загруженого документа Диадок" .   end.
     8088               when 'diadoc-ssl':U then do:     assign     p-tooltip = "Отключение проверки шифрования Диадок"     p-label = "Отключение проверки шифрования Диадок" .   end.
     8089         otherwise do:
     8090           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
     8091         end.
     8092       end.
     8093     end.
     8094   end procedure.
     8095   procedure ext-system-attr-value :
     8096     define input  parameter p-esys-id   like ub.ext-system-attr.esys-id    no-undo .
     8097     define input  parameter p-db-num    like ub.ext-system-attr.db-num     no-undo .
     8098     define input  parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
     8099     define output parameter p-value     like ub.ext-system-attr.esya-attr-value no-undo .
     8100     define output parameter p-type      as character no-undo .
     8101     do
     8102     on error undo, return error
     8103     :
     8104       define buffer buf_ext-system-attr for ub.ext-system-attr .
     8105       define variable v-format         as character no-undo .
     8106       define variable v-label          as character no-undo .
     8107       define variable v-user-can-edit  as logical   no-undo .
     8108       define variable v-output-display as logical   no-undo .
     8109       define variable v-other          as character no-undo .
     8110       run ext-system-attr-code in this-procedure
     8111         (input  p-code
     8112         ,output p-type
     8113         ,output v-format
     8114         ,output v-label
     8115         ,output v-user-can-edit
     8116         ,output v-output-display
     8117         ,output v-other
     8118         ) no-error .
     8119       if error-status :error then do:
     8120         undo, return error return-value .
     8121       end.
     8122       find first buf_ext-system-attr no-lock
     8123         where buf_ext-system-attr.esys-id   = p-esys-id
     8124           and buf_ext-system-attr.db-num    = p-db-num
     8125           and buf_ext-system-attr.esya-attr-code = p-code
     8126         no-error .
     8127       if avail buf_ext-system-attr then do:
     8128         assign
     8129           p-value =  buf_ext-system-attr.esya-attr-value
     8130         .
     8131       end.
     8132       else do:
     8133         assign
     8134           p-value = if p-type = 'L':U then "no":U else ""
     8135         .
     8136       end.
     8137     end.
     8138   end procedure.
     8139   procedure ext-system-attr-write :
     8140     define input parameter p-esys-id   like ub.ext-system-attr.esys-id    no-undo .
     8141     define input parameter p-db-num    like ub.ext-system-attr.db-num     no-undo .
     8142     define input parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
     8143     define input parameter p-value     like ub.ext-system-attr.esya-attr-value no-undo .
     8144     do
     8145     on error undo, return error
     8146     :
     8147       define buffer buf_ext-system-attr for ub.ext-system-attr .
     8148       define variable v-type           as character no-undo .
     8149       define variable v-format         as character no-undo .
     8150       define variable v-label          as character no-undo .
     8151       define variable v-user-can-edit  as logical   no-undo .
     8152       define variable v-output-display as logical   no-undo .
     8153       define variable v-other          as character no-undo .
     8154       run ext-system-attr-code in this-procedure
     8155         (input  p-code
     8156         ,output v-type
     8157         ,output v-format
     8158         ,output v-label
     8159         ,output v-user-can-edit
     8160         ,output v-output-display
     8161         ,output v-other
     8162         ) no-error .
     8163       if error-status :error then do:
     8164         undo, return error return-value .
     8165       end.
     8166       find first buf_ext-system-attr exclusive-lock
     8167         where buf_ext-system-attr.esys-id   = p-esys-id
     8168           and buf_ext-system-attr.db-num    = p-db-num
     8169           and buf_ext-system-attr.esya-attr-code = p-code
     8170         no-error .
     8171       if not available buf_ext-system-attr then do:
     8172         create buf_ext-system-attr .
     8173         assign
     8174           buf_ext-system-attr.esys-id   = p-esys-id
     8175           buf_ext-system-attr.db-num    = p-db-num
     8176           buf_ext-system-attr.esya-attr-code = p-code
     8177         .
     8178       end.
     8179       assign
     8180         buf_ext-system-attr.esya-attr-value = p-value
     8181       .
     8182     end.
     8183   end procedure.
     8184   procedure ext-system-attr-exist :
     8185     define input  parameter p-esys-id   like ub.ext-system-attr.esys-id    no-undo .
     8186     define input  parameter p-db-num    like ub.ext-system-attr.db-num     no-undo .
     8187     define input  parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
     8188     define output parameter p-exist    as logical  no-undo .
     8189     do
     8190     on error undo, return error
     8191     :
     8192       define buffer buf_ext-system-attr for ub.ext-system-attr .
     8193       define variable v-type           as character no-undo .
     8194       define variable v-format         as character no-undo .
     8195       define variable v-label          as character no-undo .
