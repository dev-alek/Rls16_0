        1   block-level on error undo, throw.
        2   using ibs.th.gbl.gbl-hndllib from propath.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Библиотека  процедур".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)Workfile: str-glbt.p Revision ".
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#attr-lib  as handle no-undo .
       71   define variable v-attr-lib-variable as handle no-undo .
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure cur-time :
       78      define output parameter p-today as date      no-undo .
       79      define output parameter p-time  as integer   no-undo .
       80     do
       81     on error undo, return error
       82     :
       83       define variable v-date1 as date      no-undo .
       84       define variable v-date2 as date      no-undo .
       85       define variable v-time  as integer   no-undo .
       86       assign
       87         v-date1 = today
       88         v-time  = time
       89         v-date2 = today
       90       .
       91       if v-date1 <> v-date2
       92       then do:
       93         assign
       94           v-date1 = today
       95           v-time  = v-time
       96         .
       97       end.
       98       assign
       99         p-today = v-date1
      100         p-time  = v-time
      101       .
      102     end.
      103   end.
      104   function cur-time-date returns character
      105   :
      106     return string(today, '99/99/9999':U) .
      107   end.
      108   function cur-time-mjd returns decimal
      109   :
      110     define variable v-date as date      no-undo .
      111     define variable v-time as integer   no-undo .
      112     run cur-time in this-procedure
      113       (output v-date
      114       ,output v-time
      115       ) .
      116     return integer(v-date) - 2400002 + (v-time / 86400) .
      117   end.
      118   function cur-time-get-ending-index returns integer
      119   (input p-number as integer
      120   )
      121   :
      122     if p-number < 0
      123     or p-number = ?
      124     then do:
      125       return 1 .
      126     end.
      127     define variable v-rest as integer   no-undo .
      128     assign
      129       p-number = p-number modulo 100
      130     .
      131     if p-number < 20
      132     then do:
      133       assign
      134         v-rest = p-number
      135       .
      136     end.
      137     else do:
      138       assign
      139         v-rest = p-number modulo 10
      140       .
      141     end.
      142     case v-rest :
      143       when 1
      144       then do:
      145         return 2 .
      146       end.
      147       when 2 or
      148       when 3 or
      149       when 4
      150       then do:
      151         return 3 .
      152       end.
      153       otherwise do:
      154         return 1 .
      155       end.
      156     end case .
      157   end.
      158   procedure cur-time-mjd-to-date :
      159      define input  parameter i-mjd-diff as decimal no-undo.
      160      define output parameter o-Date     as date    no-undo.
      161      define output parameter o-Time     as integer no-undo.
      162      define variable v-day-number as integer   no-undo .
      163      if    i-mjd-diff < 0
      164         or i-mjd-diff = ?
      165      then do:
      166         return "?" .
      167      end.
      168      assign
      169         v-day-number = truncate(i-mjd-diff,0).
      170         o-Date = date(v-day-number + 2400002).
      171         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      172     .
      173   end.
      174   function cur-time-mjd-to-string returns character
      175   (input p-mjd-diff as decimal
      176   )
      177   :
      178     define variable v-day-number as integer   no-undo .
      179     define variable v-seconds    as integer   no-undo .
      180     define variable v-hour       as integer   no-undo .
      181     define variable v-min        as integer   no-undo .
      182     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      183     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      184     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      185     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      186     if p-mjd-diff < 0
      187     or p-mjd-diff = ?
      188     then do:
      189       return "?" .
      190     end.
      191     assign
      192       v-day-number = integer(truncate(p-mjd-diff,0))
      193       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195     if v-seconds > 86400
      196     then do:
      197       assign
      198         v-seconds = 86400 - 1
      199       .
      200     end.
      201     if v-seconds < 0
      202     then do:
      203       assign
      204         v-seconds = 0
      205       .
      206     end.
      207     assign
      208       v-hour = truncate(v-seconds / 3600, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 3600
      212     .
      213     assign
      214       v-min = truncate(v-seconds / 60, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 60
      218     .
      219     return
      220         (if v-day-number <> 0
      221           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0
      225           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      229           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      230           else ""
      231         )
      232       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      233       .
      234   end.
      235   function cur-time-string returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      244   end.
      245   function cur-time-string-sec returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      254   end.
      255   function cur-time-custom  returns character
      256   (input p-prefix as character
      257   ,input p-date-format as character
      258   ,input p-delimiter as character
      259   ,input p-time-format as character
      260   ,input p-suffix as character
      261   )
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return
      270       p-prefix
      271       + string(v-date, p-date-format)
      272       + p-delimiter
      273       + string(v-time, p-time-format)
      274       + p-suffix
      275       .
      276   end.
      277   function cur-time-print  returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-datetime returns datetime
      288   :
      289     define variable v-char as character no-undo .
      290     define variable v-datetime as datetime no-undo .
      291     v-char = cur-time-string().
      292     v-datetime = datetime(v-char).
      293     return  v-datetime.
      294   end.
      295   function cur-time-string-msec returns character
      296   :
      297     define variable v-date as datetime  no-undo .
      298     v-date = now.
      299     return string(v-date) .
      300   end.
      301   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   procedure grp-obj-write :
      303   do
      304   on error undo, return error
      305   :
      306   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      307   define input parameter p-host-code  as integer                          no-undo.
      308   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      309   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      310   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      311   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      312   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      313   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      314   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      315   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      316   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      317   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      318   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      319       find first buf_gds-grp-obj exclusive-lock
      320            where buf_gds-grp-obj.node-code  = p-node-code
      321              and buf_gds-grp-obj.host-code  = p-host-code
      322              and buf_gds-grp-obj.obj-type   = p-obj-type
      323              and buf_gds-grp-obj.obj-code   = p-obj-code
      324       no-error.
      325       if not available buf_gds-grp-obj
      326       then do:
      327           create buf_gds-grp-obj.
      328           assign
      329                   buf_gds-grp-obj.node-code  = p-node-code
      330                   buf_gds-grp-obj.host-code  = p-host-code
      331                   buf_gds-grp-obj.obj-type   = p-obj-type
      332                   buf_gds-grp-obj.obj-code   = p-obj-code
      333           .
      334       end.
      335       assign
      336       buf_gds-grp-obj.min-increase = p-min-increase
      337       buf_gds-grp-obj.max-increase = p-max-increase
      338       buf_gds-grp-obj.increase-pc = p-increase-pc
      339       buf_gds-grp-obj.calc-method = p-calc-method
      340       buf_gds-grp-obj.round-method = p-round-method
      341       buf_gds-grp-obj.round-coef = p-round-coef
      342       buf_gds-grp-obj.cli-type   = p-cli-type
      343       buf_gds-grp-obj.cli-code   = p-cli-code
      344       .
      345   end.
      346   end procedure.
      347   procedure grp-obj-margin-value :
      348   do
      349   on error undo, return error
      350   :
      351   define input parameter p-node-code as integer      no-undo.
      352   define input parameter p-obj-type  as character    no-undo.
      353   define input parameter p-obj-code  as integer      no-undo.
      354   define output parameter p-min-value as decimal      no-undo init ?.
      355   define output parameter p-max-value as decimal      no-undo init ?.
      356   define output parameter p-increase-pc as decimal      no-undo init ?.
      357   define output parameter p-round-method as character no-undo init "":U.
      358   define output parameter p-base as decimal no-undo init ?.
      359   define output parameter p-range-margin     as integer      no-undo.
      360   define output parameter p-exists-margin    as logical      no-undo.
      361   define output parameter p-range-increase     as integer      no-undo.
      362   define output parameter p-exists-increase    as logical      no-undo.
      363   define output parameter p-range-rmethod     as integer no-undo .
      364   define output parameter p-exists-rmethod    as logical no-undo .
      365   define variable v-host-code as integer      no-undo.
      366   DEFINE VARIABLE v-found as logical no-undo .
      367   DEFINE VARIABLE v-exists as logical no-undo .
      368   DEFINE VARIABLE v-range as integer no-undo .
      369   DEFINE VARIABLE jj as integer no-undo .
      370   DEFINE VARIABLE v-margin-found as logical no-undo .
      371   DEFINE VARIABLE v-increase-found as logical no-undo .
      372   DEFINE VARIABLE v-min-value as decimal      no-undo.
      373   DEFINE VARIABLE v-max-value as decimal      no-undo.
      374   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      375   define variable v-round-method as character no-undo .
      376   define variable v-base as decimal no-undo .
      377   define variable v-print-code as character no-undo .
      378   define buffer buf_gds-grp for ub.gds-grp.
      379   find first buf_gds-grp no-lock where
      380              buf_gds-grp.node-code = p-node-code no-error .
      381   if not avail buf_gds-grp and p-node-code <> 0 then do:
      382     message
      383       vss-workfile vss-revision vss-description
      384       skip "Не удалось найти группу товаров с кодом" p-node-code
      385       view-as alert-box error .
      386     undo, return error .
      387   end.
      388   if p-obj-type <> '' then do:
      389   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      391     (input  p-obj-type
      392     ,input  p-obj-code
      393     ,output v-host-code
      394     ) no-error .
      395     if error-status :error
      396     then do:
      397         message
      398           vss-workfile vss-revision vss-description
      399           skip "Не удалось найти фирму объекта"
      400           skip p-obj-type p-obj-code
      401           skip return-value
      402           skip trim(error-status :get-message(1))
      403               trim(error-status :get-message(2))
      404               trim(error-status :get-message(3))
      405               trim(error-status :get-message(4))
      406               trim(error-status :get-message(5))
      407         view-as alert-box error.
      408         undo, return error .
      409     end.
      410   end.
      411   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      412   do while v-found = no and jj < 2:
      413     if v-range <> 3 then do:
      414       find first buf_gds-grp-obj no-lock
      415           where buf_gds-grp-obj.node-code = p-node-code
      416             and buf_gds-grp-obj.host-code = v-host-code
      417             and buf_gds-grp-obj.obj-type  = p-obj-type
      418             and buf_gds-grp-obj.obj-code  = p-obj-code
      419       no-error .
      420     end.
      421     if v-range = 3 or not available buf_gds-grp-obj
      422     then do:
      423        if v-range <> 2 then do:
      424           find first buf_gds-grp-obj no-lock
      425               where buf_gds-grp-obj.node-code = p-node-code
      426                 and buf_gds-grp-obj.host-code = v-host-code
      427                 and buf_gds-grp-obj.obj-type  = ""
      428                 and buf_gds-grp-obj.obj-code  = 0
      429           no-error .
      430         end.
      431         if v-range = 2 or not available buf_gds-grp-obj
      432         then do:
      433             if v-range <> 1 then do:
      434               find first buf_gds-grp-obj no-lock
      435                   where buf_gds-grp-obj.node-code = p-node-code
      436                   and buf_gds-grp-obj.host-code = 0
      437                   and buf_gds-grp-obj.obj-type  = ""
      438                   and buf_gds-grp-obj.obj-code  = 0
      439               no-error .
      440             end.
      441             if v-range = 1 or not available buf_gds-grp-obj
      442             then do:
      443                 assign
      444                     v-exists = no
      445                 .
      446             end.
      447             else do:
      448                 assign
      449                     v-exists = yes
      450                     v-range = 1
      451                 .
      452             end.
      453         end.
      454         else do:
      455             assign
      456                 v-exists = yes
      457                 v-range  = 2
      458             .
      459         end.
      460     end.
      461     else do:
      462         assign
      463             v-exists = yes
      464             v-range  = 3
      465         .
      466     end.
      467     if available buf_gds-grp-obj
      468     then do:
      469       assign
      470       v-min-value    = buf_gds-grp-obj.min-increase
      471       v-max-value    = buf_gds-grp-obj.max-increase
      472       v-increase-pc  = buf_gds-grp-obj.increase-pc
      473       v-round-method = buf_gds-grp-obj.round-method
      474       v-base         = buf_gds-grp-obj.round-coef
      475       .
      476       assign
      477       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      478                           then yes
      479                           else p-exists-margin)
      480       p-range-margin = if p-exists-margin and p-min-value = ?
      481                         then v-range
      482                         else p-range-margin
      483       p-min-value   =  if p-exists-margin and  p-min-value = ?
      484                         then v-min-value
      485                         else p-min-value
      486       p-max-value   =  if p-exists-margin and  p-max-value = ?
      487                         then v-max-value
      488                         else p-max-value
      489       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      490                           then yes
      491                           else p-exists-increase)
      492       p-range-increase = if p-exists-increase and p-increase-pc = ?
      493                         then v-range
      494                         else p-range-increase
      495       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      496                         then v-increase-pc
      497                         else p-increase-pc)
      498       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      499                           then yes
      500                           else p-exists-rmethod
      501       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      502                           then v-range
      503                           else p-range-rmethod)
      504       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      505                           then v-round-method
      506                           else p-round-method)
      507       p-base          = (if p-exists-rmethod and p-base = ?
      508                           then v-base
      509                           else p-base)
      510       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      511       jj = jj + 1
      512       .
      513     end.
      514     else do:
      515       assign
      516       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      517       jj = jj + 1
      518       .
      519     end.
      520   end.
      521   end.
      522   end procedure.
      523   procedure grp-obj-income-cli-value :
      524   do
      525   on error undo, return error
      526   :
      527   define input parameter p-node-code as integer      no-undo.
      528   define input parameter p-obj-type  as character    no-undo.
      529   define input parameter p-obj-code  as integer      no-undo.
      530   define output parameter p-cli-type as character    no-undo init ?.
      531   define output parameter p-cli-code as integer      no-undo init ?.
      532   define output parameter p-range-income-cli     as integer      no-undo.
      533   define output parameter p-exists-income-cli    as logical      no-undo.
      534   define variable v-host-code as integer      no-undo.
      535   DEFINE VARIABLE v-found as logical no-undo .
      536   DEFINE VARIABLE v-exists as logical no-undo .
      537   DEFINE VARIABLE v-range as integer no-undo .
      538   DEFINE VARIABLE jj as integer no-undo .
      539   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      540   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      541   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      542   define buffer buf_gds-grp for ub.gds-grp.
      543   find first buf_gds-grp no-lock where
      544              buf_gds-grp.node-code = p-node-code no-error .
      545   if not avail buf_gds-grp and p-node-code <> 0 then do:
      546     message
      547       vss-workfile vss-revision vss-description
      548       skip "Не удалось найти группу товаров с кодом" p-node-code
      549       view-as alert-box error .
      550     undo, return error .
      551   end.
      552   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      554     (input  p-obj-type
      555     ,input  p-obj-code
      556     ,output v-host-code
      557     ) no-error .
      558   if error-status :error
      559   then do:
      560       message
      561         vss-workfile vss-revision vss-description
      562         skip "Не удалось найти фирму объекта"
      563         skip p-obj-type p-obj-code
      564         skip return-value
      565         skip trim(error-status :get-message(1))
      566              trim(error-status :get-message(2))
      567              trim(error-status :get-message(3))
      568              trim(error-status :get-message(4))
      569              trim(error-status :get-message(5))
      570       view-as alert-box error.
      571       undo, return error .
      572   end.
      573   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      574   do while v-found = no and jj < 2:
      575     if v-range <> 3 then do:
      576       find first buf_gds-grp-obj no-lock
      577           where buf_gds-grp-obj.node-code = p-node-code
      578             and buf_gds-grp-obj.host-code = v-host-code
      579             and buf_gds-grp-obj.obj-type  = p-obj-type
      580             and buf_gds-grp-obj.obj-code  = p-obj-code
      581       no-error .
      582     end.
      583     if v-range = 3 or not available buf_gds-grp-obj
      584     then do:
      585        if v-range <> 2 then do:
      586           find first buf_gds-grp-obj no-lock
      587               where buf_gds-grp-obj.node-code = p-node-code
      588                 and buf_gds-grp-obj.host-code = v-host-code
      589                 and buf_gds-grp-obj.obj-type  = ""
      590                 and buf_gds-grp-obj.obj-code  = 0
      591           no-error .
      592         end.
      593         if v-range = 2 or not available buf_gds-grp-obj
      594         then do:
      595             if v-range <> 1 then do:
      596               find first buf_gds-grp-obj no-lock
      597                   where buf_gds-grp-obj.node-code = p-node-code
      598                   and buf_gds-grp-obj.host-code = 0
      599                   and buf_gds-grp-obj.obj-type  = ""
      600                   and buf_gds-grp-obj.obj-code  = 0
      601               no-error .
      602             end.
      603             if v-range = 1 or not available buf_gds-grp-obj
      604             then do:
      605                 assign
      606                     v-exists = no
      607                 .
      608             end.
      609             else do:
      610                 assign
      611                     v-exists = yes
      612                     v-range = 1
      613                 .
      614             end.
      615         end.
      616         else do:
      617             assign
      618                 v-exists = yes
      619                 v-range  = 2
      620             .
      621         end.
      622     end.
      623     else do:
      624         assign
      625             v-exists = yes
      626             v-range  = 3
      627         .
      628     end.
      629     if available buf_gds-grp-obj
      630     then do:
      631       assign
      632       v-cli-type-value    = buf_gds-grp-obj.cli-type
      633       v-cli-code-value    = buf_gds-grp-obj.cli-code
      634       .
      635       assign
      636       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      637                           then yes
      638                           else p-exists-income-cli)
      639       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      640                         then v-range
      641                         else p-range-income-cli
      642       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      643                         then v-cli-type-value
      644                         else p-cli-type
      645       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      646                         then v-cli-code-value
      647                         else p-cli-code
      648       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      649       jj = jj + 1
      650       .
      651     end.
      652     else do:
      653       assign
      654       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      655       jj = jj + 1
      656       .
      657     end.
      658   end.
      659   end.
      660   end procedure.
      661   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      663   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      664   FUNCTION Break-n-line RETURNS CHARACTER
      665     ( INPUT p-ost as char,
      666       INPUT p-lengths  as character,
      667       OUTPUT output-num-lines as integer
      668       ) :
      669   define variable ii as integer no-undo.
      670   define variable jj as integer no-undo.
      671   define variable linei as character no-undo extent 10.
      672   define variable line-length as integer no-undo extent 10.
      673   define variable num-line as integer no-undo .
      674   define variable v-line as character no-undo .
      675   do ii = 1 to MIN(num-entries(p-lengths), 10):
      676     assign
      677     line-length[ii] = integer(entry(ii, p-lengths))
      678     num-line = ii
      679     .
      680   end.
      681   do jj = 1 to num-line:
      682     if Length ( p-ost ) <= line-length[jj] then do:
      683       assign
      684       output-num-lines = jj
      685       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      686       .
      687       return v-line.
      688     end.
      689     assign
      690     ii = 1
      691     .
      692     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      693     then do:
      694       assign
      695       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      696       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      697       .
      698     end.
      699     else do:
      700       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      701         assign
      702         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      703         ii = ii + 1
      704         .
      705         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      706         assign
      707         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      708         .
      709       END.
      710       assign
      711       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      712       .
      713     end.
      714     assign
      715     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      716     .
      717     if p-ost = "":U then LEAVE.
      718   end.
      719   assign
      720   output-num-lines = jj.
      721   RETURN v-line.
      722   END FUNCTION.
      723   FUNCTION Center-Field RETURNS CHARACTER
      724     ( INPUT p-str as char,
      725       INPUT p-format as integer,
      726       INPUT p-Length as integer,
      727       INPUT p-fill as character
      728       ) :
      729   define variable v-str as character no-undo .
      730   define variable v-left as integer no-undo .
      731   define variable v-dop as integer no-undo .
      732   assign
      733   p-str = trim(p-str)
      734   .
      735   if p-str = "":U then return fill(p-fill, p-length).
      736   if length(p-str) >= p-format then
      737   p-str = substr(p-str, 1, p-format).
      738   else do:
      739     p-format = length(p-str).
      740   end.
      741   if p-format < p-length then do:
      742     assign
      743     v-left = (p-length - p-format )
      744     v-dop = (if v-left modulo 2 = 1
      745              then 1
      746              else 0)
      747     v-left = (if (v-left modulo 2 = 1)
      748              then (v-left - 1 ) / 2
      749              else v-left / 2)
      750     v-str =  fill(p-fill, v-left) +
      751              string(p-str, "X(":U + string(p-format) + ")":U) +
      752              fill(p-fill, v-left) + fill(p-fill, v-dop)
      753     .
      754     return v-str.
      755   end.
      756   else do:
      757     return string(p-str, "X(":U + string(p-length) + ")":U).
      758   end.
      759   END FUNCTION.
      760   FUNCTION Left-Field RETURNS CHARACTER
      761     ( INPUT p-str as char,
      762       INPUT p-format as integer,
      763       INPUT p-Length as integer,
      764       INPUT p-fill as character
      765       ) :
      766   define variable v-str as character no-undo .
      767   define variable v-left as integer no-undo .
      768   define variable v-dop as integer no-undo .
      769   assign
      770   p-str = trim(p-str)
      771   .
      772   if p-str = "":U then return fill(p-fill, p-length).
      773   if length(p-str) >= p-format then
      774   p-str = substr(p-str, 1, p-format).
      775   else do:
      776     p-format = length(p-str).
      777   end.
      778   if p-format < p-length then do:
      779     assign
      780     v-dop =  p-length - p-format
      781     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      782              fill(p-fill, v-dop)
      783     .
      784     return v-str.
      785   end.
      786   else do:
      787     return string(p-str, "X(":U + string(p-length) + ")":U).
      788   end.
      789   END FUNCTION.
      790   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      791     ( INPUT p-sum as decimal,
      792       INPUT p-rub-length as integer,
      793       INPUT p-kop-length as integer,
      794       INPUT p-fill as character,
      795       INPUT p-razr-delim as character,
      796       INPUT p-rub-str  as character,
      797       INPUT p-kop-str  as character
      798       ) :
      799   define variable v-str as character no-undo .
      800   define variable v-format as character no-undo .
      801   define variable v-dopi as integer no-undo .
      802   define variable v-dopi2 as integer no-undo .
      803   assign
      804   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      805   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      806   .
      807   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      808   assign
      809   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      810   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      811   .
      812   assign
      813   v-str = fill(p-fill, p-rub-length - v-dopi) +
      814           string(truncate(p-sum, 0), v-format) +
      815           p-rub-str +
      816           fill(p-fill, p-kop-length - 2) +
      817           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      818   .
      819   return v-str.
      820   END FUNCTION.
      821   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      822     ( INPUT p-sum as decimal,
      823       INPUT p-sum-length as integer,
      824       INPUT p-curr-code as integer,
      825       INPUT p-fill as character,
      826       INPUT p-razr-delim as character
      827       ) :
      828   define variable v-str as character no-undo .
      829   define variable v-format as character no-undo .
      830   define variable v-dopi as integer no-undo .
      831   define variable v-dopi2 as integer no-undo .
      832   define variable v-curr-name as character no-undo .
      833   define buffer buf_currency for ub.currency.
      834   find first buf_currency no-lock where
      835             buf_currency.curr-code = p-curr-code no-error .
      836   if not avail buf_currency
      837   then v-curr-name = "неизвестная валюта".
      838   else
      839   assign
      840   v-curr-name = buf_currency.curr-name
      841   .
      842   assign
      843   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      844   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      845   .
      846   if v-dopi > p-sum-length then return "?".
      847   assign
      848   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      849   v-dopi = length(trim(string(p-sum, v-format)))
      850   .
      851   assign
      852   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      853           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      854           trim(string(p-sum, v-format))
      855   .
      856   return v-str.
      857   END FUNCTION.
      858   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      859   (input v-sum as decimal
      860   ):
      861   define variable v-str as character no-undo .
      862   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      863   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      864   return v-str.
      865   END FUNCTION.
      866   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      867   (input p-sum as decimal
      868    ,input p-curr-code as integer
      869   ):
      870   define variable v-str as character no-undo .
      871   define variable Copeck as character no-undo.
      872   define variable Rouble as character no-undo.
      873   define variable v-Word as character no-undo.
      874   define variable ii as integer init 18 no-undo.
      875   define variable v-str-rubl as character no-undo .
      876   define variable v-kop as integer no-undo .
      877   define buffer buf_currency for ub.currency.
      878   assign
      879   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      880   find first buf_currency no-lock where
      881             buf_currency.curr-code = p-curr-code no-error .
      882   if not available buf_currency then return chr(63).
      883   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      884     CASE substring(v-Word, ii - 3,1):
      885       WHEN "1" THEN DO:
      886         if substring(v-Word, ii - 4,1) = "1" then
      887             Rouble = buf_currency.curr-name-five .
      888         else
      889             Rouble = buf_currency.curr-name-one .
      890       END.
      891       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      892         if substring(v-Word, ii - 4,1) = "1" then
      893            Rouble = buf_currency.curr-name-five .
      894            else
      895            Rouble = buf_currency.curr-name-three .
      896         END.
      897       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      898          Rouble = buf_currency.curr-name-five .
      899       END.
      900     END CASE.
      901   end.
      902   CASE substring(v-Word, ii, 1):
      903     WHEN "1" THEN DO:
      904       if substring(v-Word, ii - 1, 1) = "1" then
      905           Copeck = buf_currency.part-name-five .
      906       else
      907           Copeck = buf_currency.part-name-one .
      908     END.
      909     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      910       if substring(v-Word, ii - 1, 1) = "1" then
      911           Copeck = buf_currency.part-name-five .
      912       else
      913           Copeck = buf_currency.part-name-three .
      914     END.
      915     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      916       Copeck = buf_currency.part-name-five .
      917     END.
      918   END CASE.
      919   run gbl/num-rus.p ( input absolute( p-sum )
      920                , output v-str-rubl).
      921   assign
      922   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      923           ) * 100
      924   .
      925   v-str = ( if p-Sum < 0 then "- " else "" ) +
      926               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      927               string(v-kop, "99":U) + chr(32) + Copeck .
      928   return v-str.
      929   END FUNCTION.
      930   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      931   (input v-sum as decimal,
      932   input v-razr as integer
      933   ):
      934   define variable v-str as character no-undo .
      935   define variable v-dec-separ as character no-undo .
      936   case SESSION:NUMERIC-FORMAT:
      937     when "American":U then do:
      938       assign
      939       v-dec-separ = ".":U
      940       .
      941     end.
      942     when "European":U then do:
      943       assign
      944       v-dec-separ = ",":U
      945       .
      946     end.
      947   END CASE.
      948   assign
      949   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      950   .
      951   return v-str.
      952   END FUNCTION.
      953   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      954     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      955     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      956     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      957   END FUNCTION.
      958   PROCEDURE get-month-name-gen :
      959     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      960     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      961     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      962     DO ON ERROR UNDO, RETURN ERROR :
      963       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      964     END.
      965   END PROCEDURE.
      966   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   procedure gen-key-rec :
      968     define input  parameter p-tbl-name    as character no-undo.
      969     define input  parameter p-bh_tbl-name as handle    no-undo.
      970     define output parameter p-key-rec     as character no-undo.
      971     do
      972     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      973     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      974     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      975     :
      976       define variable fh               as handle    no-undo .
      977       define variable v-ok             as logical   no-undo .
      978       define variable v-inform         as character no-undo .
      979       define variable v-ind            as integer   no-undo .
      980       define variable v-idx-field-qnty as integer   no-undo .
      981       if p-tbl-name = ?
      982         or p-tbl-name = "":U
      983       then do:
      984         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      985       end.
      986       if not p-bh_tbl-name:available then do:
      987         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      988       end.
      989       assign
      990         p-key-rec = p-tbl-name
      991         v-inform  = p-bh_tbl-name:index-information(1)
      992         v-ind     = 2
      993       .
      994       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      995       on error undo, return error
      996       :
      997         assign
      998           v-inform = p-bh_tbl-name:index-information( v-ind )
      999           v-ind    = v-ind + 1
     1000         .
     1001       end.
     1002       if v-inform = ?
     1003         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1004         or entry( 3, v-inform, ",":U ) <> "1":U
     1005       then do:
     1006         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
     1007       end.
     1008       else do:
     1009         assign
     1010           v-idx-field-qnty = num-entries( v-inform ) - 4
     1011         .
     1012         if v-idx-field-qnty < 2 then do:
     1013           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
     1014         end.
     1015         do v-ind = 1 to v-idx-field-qnty by 2
     1016         on error undo, return error
     1017         :
     1018           assign
     1019             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1020             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1021           .
     1022         end.
     1023       end.
     1024       if p-key-rec = ? then do:
     1025         assign
     1026           p-key-rec = "":U
     1027         .
     1028         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
     1029       end.
     1030     end.
     1031     return.
     1032   end procedure.
     1033   procedure gen-where-keyr-tab :
     1034     define input  parameter i-tableSerach as character no-undo.
     1035     define input  parameter i-tablekey   as character  no-undo.
     1036     define input  parameter p-key-rec    as character  no-undo.
     1037     define input  parameter p-key-handle as handle     no-undo .
     1038     define input  parameter p-db-name    as character  no-undo .
     1039     define input  parameter p-tt-handle  as handle     no-undo .
     1040     define output parameter o-Where      as character  no-undo.
     1041     do
     1042     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1043     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1044     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1045     :
     1046       define variable v-full-tbl-name  as character no-undo .
     1047       define variable bh_tbl-name      as handle    no-undo .
     1048       define variable fh_key           as handle    no-undo .
     1049       define variable fh_search        as handle    no-undo .
     1050       define variable v-field-num      as integer   no-undo .
     1051       define variable v-count-fld      as integer   no-undo .
     1052       define variable v-inform         as character no-undo .
     1053       define variable v-ind            as integer   no-undo .
     1054       define variable v-idx-field-qnty as integer   no-undo .
     1055       define variable v-field-name     as character no-undo .
     1056       define variable v-field-val      as character no-undo .
     1057       define variable v-word-link      as character no-undo .
     1058       define variable vTable           as character no-undo.
     1059       define variable bh_tbl-key       as handle    no-undo .
     1060       assign
     1061         p-key-rec = trim( p-key-rec )
     1062       .
     1063       if p-key-handle <> ? then do:
     1064         if not valid-handle(p-key-handle)
     1065            or p-key-handle:type <> "buffer"
     1066         then do:
     1067           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1068         end.
     1069         if num-entries( p-key-rec, chr(3) ) > 1
     1070           or p-key-rec = ?
     1071           or p-key-rec = "":U
     1072         then do:
     1073           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1074         end.
     1075       end.
     1076       else do:
     1077         if p-key-rec = ?
     1078           or p-key-rec = "":U
     1079         then do:
     1080           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1081         end.
     1082       end.
     1083       assign
     1084         vTable = entry( 1 , p-key-rec, chr(3) )
     1085       .
     1086       if p-tt-handle <> ?
     1087         and ( not valid-handle(p-tt-handle)
     1088               or p-tt-handle:type <> "buffer"
     1089             )
     1090       then do:
     1091         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1092       end.
     1093       if p-tt-handle = ? then do:
     1094         assign
     1095           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1096         .
     1097         create buffer bh_tbl-name for table v-full-tbl-name .
     1098       end.
     1099       else do:
     1100         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1101       end.
     1102       assign
     1103         v-inform = bh_tbl-name:index-information(1)
     1104         v-ind    = 2
     1105       .
     1106       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1107       on error undo, return error
     1108       :
     1109         assign
     1110           v-inform = bh_tbl-name:index-information( v-ind )
     1111           v-ind    = v-ind + 1
     1112         .
     1113       end.
     1114       if v-inform = ?
     1115         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1116         or entry( 3, v-inform, ",":U ) <> "1":U
     1117       then do:
     1118         delete object bh_tbl-name no-error.
     1119         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1120       end.
     1121       assign
     1122         v-idx-field-qnty = num-entries( v-inform ) - 4
     1123       .
     1124       if v-idx-field-qnty < 2 then do:
     1125         delete object bh_tbl-name no-error.
     1126         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1127       end.
     1128       assign
     1129         o-where     = "where":U
     1130         v-word-link = "":U
     1131         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1132         v-count-fld = 0
     1133       .
     1134       if i-tablekey ne "" and i-tablekey ne ?
     1135       then do:
     1136         assign
     1137           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1138         .
     1139         create buffer bh_tbl-key for table v-full-tbl-name .
     1140       end.
     1141       if i-tableSerach ne "" and i-tableSerach ne ?
     1142       then do:
     1143         delete object bh_tbl-name no-error.
     1144         assign
     1145           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1146         .
     1147         create buffer bh_tbl-name for table v-full-tbl-name .
     1148       end.
     1149       block_where:
     1150       do v-ind = 1 to v-idx-field-qnty by 2
     1151       on error undo, return error
     1152       :
     1153         assign
     1154           v-count-fld = v-count-fld + 1
     1155         .
     1156         if p-key-handle = ?
     1157           and v-count-fld > v-field-num
     1158         then do:
     1159           leave block_where.
     1160         end.
     1161         define variable VfieldKeyTable as handle no-undo.
     1162         assign
     1163           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1164           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1165         .
     1166         if     bh_tbl-key ne ?
     1167         then do:
     1168            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1169            if VfieldKeyTable eq ?
     1170            then next block_where.
     1171         end.
     1172         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1173         then
     1174            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1175         else
     1176            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1177         if p-key-handle = ? then do:
     1178           assign
     1179             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1180           .
     1181         end.
     1182         else do:
     1183           assign
     1184             fh_key = p-key-handle:buffer-field( v-field-name )
     1185           .
     1186           if fh_key = ?
     1187             or not valid-handle( fh_key )
     1188           then do:
     1189             delete object bh_tbl-name.
     1190             if     bh_tbl-key ne ?
     1191             then
     1192                delete object bh_tbl-key.
     1193             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1194           end.
     1195           assign
     1196             v-field-val = fh_key:buffer-value
     1197           .
     1198         end.
     1199         if fh_search:data-type ="character":U then do:
     1200           assign
     1201             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1202             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1203             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1204             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1205             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1206             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1207             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1208             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1209             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1210             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1211             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1212             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1213             v-field-val = substitute( '"&1"', v-field-val )
     1214           .
     1215         end.
     1216         assign
     1217           o-where = substitute( "&1 &2", o-where, v-field-val )
     1218         .
     1219         if v-word-link = "":U then do:
     1220           assign
     1221             v-word-link = "and":U
     1222           .
     1223         end.
     1224       end.
     1225       delete object bh_tbl-name.
     1226       if     bh_tbl-key ne ?
     1227       then
     1228          delete object bh_tbl-key.
     1229       if p-key-handle = ?
     1230         and v-count-fld <> v-field-num
     1231       then do:
     1232         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1233       end.
     1234     end.
     1235   end procedure.
     1236   procedure gen-hn-keyr-tab :
     1237     define input  parameter i-tableSerach as character no-undo.
     1238     define input  parameter i-tablekey   as character no-undo.
     1239     define input  parameter p-key-rec    as character no-undo.
     1240     define input  parameter p-key-handle as handle    no-undo .
     1241     define input  parameter p-db-name    as character no-undo .
     1242     define input  parameter p-tt-handle  as handle    no-undo .
     1243     define input  parameter p-stts-lock  as integer   no-undo .
     1244     define output parameter o-hn         as handle    no-undo.
     1245     define variable v-full-tbl-name as character no-undo.
     1246     define variable v-where         as character no-undo.
     1247     define variable bh_tbl-name     as handle    no-undo.
     1248     define variable vTable          as character no-undo.
     1249     do
     1250     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1251     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1252     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1253         run gen-where-keyr-tab(i-tableSerach,
     1254                                i-tablekey,
     1255                                p-key-rec,
     1256                                p-key-handle,
     1257                                p-db-name,
     1258                                p-tt-handle,
     1259                                output v-where).
     1260         if i-tableSerach ne "" and i-tableSerach ne ?
     1261         then do:
     1262            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1263            create buffer bh_tbl-name for table v-full-tbl-name .
     1264         end.
     1265         else do:
     1266            if p-tt-handle = ? then do:
     1267               assign
     1268                  vTable = entry( 1 , p-key-rec, chr(3) )
     1269               .
     1270               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1271               create buffer bh_tbl-name for table v-full-tbl-name .
     1272            end.
     1273            else do:
     1274               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1275            end.
     1276         end.
     1277         if p-tt-handle = ? then do:
     1278            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1279         end.
     1280         else do:
     1281            bh_tbl-name:find-first( v-where ) no-error .
     1282         end.
     1283         o-hn = bh_tbl-name.
     1284      end.
     1285   end procedure.
     1286   procedure gen-hn-keyr :
     1287     define input  parameter p-key-rec    as character no-undo.
     1288     define input  parameter p-key-handle as handle    no-undo .
     1289     define input  parameter p-db-name    as character no-undo .
     1290     define input  parameter p-tt-handle  as handle    no-undo .
     1291     define input  parameter p-stts-lock  as integer   no-undo .
     1292     define output parameter o-hn         as handle    no-undo.
     1293     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1294   end.
     1295   procedure gen-row-keyr :
     1296     define input  parameter p-key-rec    as character no-undo.
     1297     define input  parameter p-key-handle as handle    no-undo .
     1298     define input  parameter p-db-name    as character no-undo .
     1299     define input  parameter p-tt-handle  as handle    no-undo .
     1300     define input  parameter p-stts-lock  as integer   no-undo .
     1301     define output parameter p-tbl-row    as rowid     no-undo.
     1302     define output parameter p-tbl-name   as character no-undo.
     1303     define variable vHn as handle no-undo.
     1304       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1305       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1306       p-tbl-name =  vHn:table.
     1307       delete object vHn no-error.
     1308     if p-tbl-row = ? then do:
     1309       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1310     end.
     1311     else do:
     1312       return.
     1313     end.
     1314   end procedure.
     1315   procedure gen-key-fv :
     1316     define input  parameter p-key-rec    as character no-undo .
     1317     define output parameter p-field-list as character no-undo .
     1318     define output parameter p-value-list as character no-undo.
     1319     do
     1320     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1321     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1322     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1323     :
     1324       define variable v-full-tbl-name  as character no-undo .
     1325       define variable bh_tbl-name      as handle    no-undo .
     1326       define variable v-tbl-name       as character no-undo .
     1327       define variable v-field-num      as integer   no-undo .
     1328       define variable v-count-fld      as integer   no-undo .
     1329       define variable v-inform         as character no-undo .
     1330       define variable v-ind            as integer   no-undo .
     1331       define variable v-idx-field-qnty as integer   no-undo .
     1332       define variable v-delim-key      as character no-undo .
     1333       if p-key-rec = ?
     1334         or p-key-rec = "":U
     1335       then do:
     1336         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1337       end.
     1338       assign
     1339         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1340         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1341       .
     1342       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1343       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1344       assign
     1345         v-inform = bh_tbl-name:index-information(1)
     1346         v-ind    = 2
     1347       .
     1348       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1349       on error undo, return error
     1350       :
     1351         assign
     1352           v-inform = bh_tbl-name:index-information( v-ind )
     1353           v-ind    = v-ind + 1
     1354         .
     1355       end.
     1356       if v-inform = ?
     1357         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1358         or entry( 3, v-inform, ",":U ) <> "1":U
     1359       then do:
     1360         delete object bh_tbl-name no-error.
     1361         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1362       end.
     1363       assign
     1364         v-idx-field-qnty = num-entries( v-inform ) - 4
     1365       .
     1366       if v-idx-field-qnty < 2 then do:
     1367         delete object bh_tbl-name no-error.
     1368         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1369       end.
     1370       assign
     1371         p-field-list = "":U
     1372         p-value-list = "":U
     1373         v-delim-key  = "":U
     1374         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1375         v-count-fld  = 0
     1376       .
     1377       block_where:
     1378       do v-ind = 1 to v-idx-field-qnty by 2
     1379       on error undo, return error
     1380       :
     1381         assign
     1382           v-count-fld = v-count-fld + 1
     1383         .
     1384         if v-count-fld > v-field-num then do:
     1385           leave block_where.
     1386         end.
     1387         assign
     1388           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1389           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1390         .
     1391         if v-ind = 1 then do:
     1392           assign
     1393             v-delim-key = chr(3)
     1394           .
     1395         end.
     1396       end.
     1397       delete object bh_tbl-name.
     1398       if v-count-fld <> v-field-num then do:
     1399         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1400       end.
     1401     end.
     1402   end procedure.
     1403   procedure gen-key-field :
     1404     define input  parameter p-table      as character no-undo .
     1405     define output parameter p-field-list as character no-undo .
     1406     do
     1407     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1408     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1409     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1410     :
     1411       define variable v-full-tbl-name  as character no-undo .
     1412       define variable bh_tbl-name      as handle    no-undo .
     1413       define variable v-tbl-name       as character no-undo .
     1414       define variable v-field-num      as integer   no-undo .
     1415       define variable v-count-fld      as integer   no-undo .
     1416       define variable v-inform         as character no-undo .
     1417       define variable v-ind            as integer   no-undo .
     1418       define variable v-idx-field-qnty as integer   no-undo .
     1419       define variable v-delim-key      as character no-undo .
     1420       if p-table = ?
     1421         or p-table = "":U
     1422       then do:
     1423         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1424       end.
     1425       assign
     1426         v-tbl-name      = p-table
     1427         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1428       .
     1429       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1430       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1431       assign
     1432         v-inform = bh_tbl-name:index-information(1)
     1433         v-ind    = 2
     1434       .
     1435       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1436       on error undo, return error
     1437       :
     1438         assign
     1439           v-inform = bh_tbl-name:index-information( v-ind )
     1440           v-ind    = v-ind + 1
     1441         .
     1442       end.
     1443       if v-inform = ?
     1444         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1445         or entry( 3, v-inform, ",":U ) <> "1":U
     1446       then do:
     1447         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1448       end.
     1449       assign
     1450         v-idx-field-qnty = num-entries( v-inform ) - 4
     1451       .
     1452       if v-idx-field-qnty < 2 then do:
     1453         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1454       end.
     1455       assign
     1456         p-field-list = "":U
     1457         v-delim-key  = "":U
     1458         v-count-fld  = 0
     1459       .
     1460       block_where:
     1461       do v-ind = 1 to v-idx-field-qnty by 2
     1462       on error undo, return error
     1463       :
     1464         assign
     1465           v-count-fld = v-count-fld + 1
     1466         .
     1467         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1468         if v-ind = 1 then do:
     1469           assign
     1470             v-delim-key = chr(3)
     1471           .
     1472         end.
     1473       end.
     1474       delete object bh_tbl-name.
     1475     end.
     1476   end procedure.
     1477   if valid-handle (g#attr-lib)
     1478   and g#attr-lib <> this-procedure :handle
     1479   and g#attr-lib :get-signature('attr-lib_testproc':u) <> ""
     1480   then do:
     1481     message
     1482       vss-workfile vss-revision vss-description skip
     1483       "Попытка повторной загрузки библиотеки" skip
     1484       g#attr-lib skip
     1485       g#attr-lib :type skip
     1486       g#attr-lib :file-name skip
     1487       valid-handle(g#attr-lib) skip
     1488       this-procedure :handle skip
     1489       this-procedure :type skip
     1490       this-procedure :file-name skip
     1491       valid-handle(this-procedure) skip
     1492       view-as alert-box error .
     1493     undo, return error return-value .
     1494   end.
     1495   else do:
     1496     assign
     1497       g#attr-lib = this-procedure :handle
     1498     .
     1499     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     1500     gbl-hndllibObj = new gbl-hndllib ().
     1501     gbl-hndllibObj:InitHndl("g#attr-lib", g#attr-lib).
     1502     delete object gbl-hndllibObj.
     1503   end.
     1504   if this-procedure :persistent <> true
     1505   then do:
     1506     message
     1507       vss-workfile vss-revision vss-description skip
     1508       "Ошибка запуска библиотеки" program-name(1) skip
     1509       "Попытка запустить ее как обычную процедуру" skip
     1510       view-as alert-box error .
     1511   end.
     1512   on delete of this-procedure
     1513   do:
     1514     assign
     1515       g#attr-lib = ?
     1516     .
     1517     def var gbl-hndllibObj as class gbl-hndllib no-undo.
     1518     gbl-hndllibObj = new gbl-hndllib ().
     1519     gbl-hndllibObj:InitHndl("g#attr-lib", g#attr-lib).
     1520     delete object gbl-hndllibObj.
     1521     for each thbjattr_thbj-attr:
     1522       delete thbjattr_thbj-attr.
     1523     end.
     1524   end.
     1525   procedure attr-lib_testproc :
     1526   end.
     1527   procedure clntattr-code :
     1528     do
     1529     on error undo, return error return-value
     1530     :
     1531       define input  parameter p-code           as character no-undo .
     1532       define output parameter p-type           as character no-undo .
     1533       define output parameter p-format         as character no-undo .
     1534       define output parameter p-label          as character no-undo .
     1535       define output parameter p-user-can-edit  as logical   no-undo .
     1536       define output parameter p-output-display as logical   no-undo .
     1537       define output parameter p-other          as character no-undo .
     1538       if index(p-code, chr(4)) > 0 then do:
     1539         p-code = entry(1, p-code, chr(4)).
     1540       end.
     1541       case p-code :
     1542               when 'doc-start':U then do:     assign     p-label = "Дата с которой существуют документы"     p-type = 'T':U      p-format = "99/99/9999"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1543               when 'arh-detail':U then do:     assign     p-label = "Дата начала подробного складского архива по товарам"     p-type = 'T':U      p-format = "99/99/9999"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
