     5292       define output parameter p-from-gbd       as logical   no-undo .
     5293       define output parameter p-from-ubd       as logical   no-undo .
     5294       if index(p-code, chr(4)) > 0 then do:
     5295         p-ucode = entry(1, p-ucode, chr(4)).
     5296         p-code = entry(1, p-code, chr(4)).
