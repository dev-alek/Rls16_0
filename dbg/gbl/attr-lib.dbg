     6224           buf_gds-host-attr.gds-code  = p-gds-code
     6225           buf_gds-host-attr.host-code  = attr-host-code
     6226           buf_gds-host-attr.attr-code = p-code
     6227           buf_gds-host-attr.attr-value = p-value no-error
     6228         .
     6229       end.
     6230       ELSE
     6231       assign
     6232       buf_gds-host-attr.attr-value = p-value no-error
     6233       .
     6234     end.
     6235   end procedure.
