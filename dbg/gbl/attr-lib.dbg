     7614               when 'reg-code':U then do:     assign     p-label = "Регион"     p-type = 'I':U      p-format = "999999999"     p-label = "Регион"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     7615               when 'last-nws-sync':U then do:     assign     p-label = "Время последней синхронизации обмена СПН"     p-type = 'C':U      p-format = "X(60)"     p-label = "Время последней синхронизации обмена СПН"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     7616         otherwise do:
     7617           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     7618         end.
     7619       end.
     7620     end.
     7621   end procedure.
     7622   procedure db-attr-tooltip :
     7623     define input  parameter p-code    as character no-undo .
     7624     define output parameter p-tooltip as character no-undo .
     7625     define output parameter p-label   as character no-undo .
     7626     do
     7627     on error undo, return error
     7628     :
     7629       case p-code :
     7630               when 'schedule-nws':U then do:     assign     p-tooltip = "Составлено ли расписание отправки новостей для базы данных"     p-label = "Расписание новостей для БД" .   end.
     7631               when 'schedule-merc':U then do:     assign     p-tooltip = "Составлено ли расписание обмена с ФГИС Меркурий для базы данных"     p-label = "Расписание обмена с ФГИС Меркурий для БД" .   end.
     7632               when 'schedule-hdd':U then do:     assign     p-tooltip = "Составлено ли расписание мониторинга HDD для базы данных"     p-label = "Расписание мониторинга HDD для БД" .   end.
     7633               when 'schedule-motp':U then do:     assign     p-tooltip = "Составлено ли расписание обмена с ИС МОТП для базы данных"     p-label = "Расписание обмена с ИС МОТП для БД" .   end.
     7634               when 'schedule-diadoc':U then do:     assign     p-tooltip = "Составлено ли расписание обмена с Диадок для базы данных"     p-label = "Расписание обмена с Диадок для БД" .   end.
     7635               when 'ver-met':U then do:     assign     p-tooltip = "Версия метаданных"     p-label = "Версия метаданных" .   end.
     7636               when 'schedule-isPM':U then do:     assign     p-tooltip = "Составлено ли расписание выгрузки в ИС ПМ для базы данных"     p-label = "Расписание выгрузки в ИС ПМ для БД" .   end.
     7637               when 'schedule-arc':U then do:     assign     p-tooltip = "Составлено ли расписание расчета архивов для базы данных"     p-label = "Расписание расчета архивов для БД" .   end.
     7638               when 'schedule-exp':U then do:     assign     p-tooltip = "Составлено ли расписание экспорта для базы данных"     p-label = "Расписание экспорта для БД" .   end.
     7639               when 'schedule-oxml':U then do:     assign     p-tooltip = "Составлено ли расписание OpenXML для базы данных"     p-label = "Расписание OpenXML для БД" .   end.
     7640               when 'need-gen-new-pack':U then do:     assign     p-tooltip = "Необходимо ли формировать новый пакет(ы) для базы данных"     p-label = "Необходимость формирования нового пакета(ов) для БД" .   end.
     7641               when 'last-unload-db-key':U then do:     assign     p-tooltip = "Ключ с которым последний раз выгружали БД"     p-label = "Ключ с которым последний раз выгружали БД" .   end.
     7642               when 'schedule-getcd':U then do:     assign     p-tooltip = "Составлено ли расписание получения информации с касс для базы данных"     p-label = "Расписание получения информации с касс для БД" .   end.
     7643               when 'schedule-sale':U then do:     assign     p-tooltip = "Составлено ли расписание обработки документов продаж для базы данных"     p-label = "Расписание обработки документов продаж для БД" .   end.
     7644               when 'schedule-suz':U then do:     assign     p-tooltip = "Составлено ли расписание запуска отчетов для базы данных"     p-label = "Расписание запуска отчетов для БД" .   end.
     7645               when 'cut-date':U then do:     assign     p-tooltip = "Дата по которую усечены документы по БД в ГБД"     p-label = "Дата по которую усечены документы по БД в ГБД" .   end.
     7646               when 'cut-fin-date':U then do:     assign     p-tooltip = "Дата по которую усечены финансовые документы по БД в ГБД"     p-label = "Дата по которую усечены финансовые документы по БД в ГБД" .   end.
     7647               when 'unload-after-cut':U then do:     assign     p-tooltip = "БД выгружена после усечения документов по ней в ГБД"     p-label = "БД выгружена после усечения документов по ней в ГБД" .   end.
     7648               when 'cut-db-list':U then do:     assign     p-tooltip = "Список БД в которых усекаются документы"     p-label = "Список БД в которых усекаются документы" .   end.
     7649               when 'schedule-cbnk':U then do:     assign     p-tooltip = "Составлено ли расписание для эксп/имп в КЛИЕНТ-БАНК"     p-label = "Расписание эксп/имп в КЛИЕНТ-БАНК" .   end.
     7650               when 'arh-disable':U then do:     assign     p-tooltip = "Расчет складского архива по товарам запрещен"     p-label = "Расчет складского архива по товарам запрещен" .   end.
     7651               when 'ahsp-disable':U then do:     assign     p-tooltip = "Расчет складского архива по поставщикам запрещен"     p-label = "Расчет складского архива по поставщикам запрещен" .   end.
     7652               when 'aht-disable':U then do:     assign     p-tooltip = "Расчет складского архива по типам приобретения запрещен"     p-label = "Расчет складского архива по типам приобретения запрещен" .   end.
     7653               when 'schedule-free':U then do:     assign     p-tooltip = "Составлено ли расписание произвольных задач"     p-label = "Расписание произвольных задач" .   end.
     7654               when 'ora-exp-seq':U then do:     assign     p-tooltip = "Номер последней выгрузки в Oracle Retail"     p-label = "Номер последней выгрузки в Oracle Retail" .   end.
     7655               when 'mess-id-video':U then do:     assign     p-tooltip = "Номер сообщения видеонаблюдения"     p-label = "Номер сообщения видеонаблюдения" .   end.
     7656               when 'int-point':U then do:     assign     p-tooltip = "Точка интеграции ERPRN"     p-label = "Точка интеграции ERPRN" .   end.
     7657               when 'ver-code':U then do:     assign     p-tooltip = "Версия справочников"     p-label = "Версия справочников" .   end.
     7658               when 'hist-code':U then do:     assign     p-tooltip = "Исторический код объекта"     p-label = "Исторический код объекта" .   end.
     7659               when 'hist-name':U then do:     assign     p-tooltip = "Историческое наименование объекта"     p-label = "Историческое наименование объекта" .   end.
     7660               when 'asiip':U then do:     assign     p-tooltip = "АСИ IP"     p-label = "АСИ IP" .   end.
     7661               when 'asiport':U then do:     assign     p-tooltip = "АСИ port"     p-label = "АСИ Port" .   end.
     7662               when 'asitype':U then do:     assign     p-tooltip = "АСИ Type"     p-label = "АСИ Type" .   end.
     7663               when 'reg-code':U then do:     assign     p-tooltip = "Регион"     p-label = "Регион" .   end.
     7664               when 'last-nws-sync':U then do:     assign     p-tooltip = "Время последней синхронизации обмена СПН"     p-label = "Время последней синхронизации обмена СПН" .   end.
     7665         otherwise do:
     7666           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     7667         end.
     7668       end.
     7669     end.
     7670   end procedure.
     7671   procedure db-attr-value :
     7672     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     7673     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     7674     define output parameter p-value     like ub.db-attr.attr-value no-undo .
     7675     define output parameter p-type      as character no-undo .
     7676     do
     7677     on error undo, return error
     7678     :
     7679       define buffer buf_db-attr for ub.db-attr .
     7680       define variable v-format         as character no-undo .
     7681       define variable v-label          as character no-undo .
     7682       define variable v-user-can-edit  as logical   no-undo .
     7683       define variable v-output-display as logical   no-undo .
     7684       define variable v-other          as character no-undo .
     7685       run db-attr-code in this-procedure
     7686         (input  p-code
     7687         ,output p-type
     7688         ,output v-format
     7689         ,output v-label
     7690         ,output v-user-can-edit
     7691         ,output v-output-display
     7692         ,output v-other
     7693         ) no-error .
     7694       if error-status :error then do:
     7695         undo, return error return-value .
     7696       end.
     7697       find first buf_db-attr no-lock
     7698         where buf_db-attr.db-num    = p-db-num
     7699           and buf_db-attr.attr-code = p-code
     7700         no-error .
     7701       if avail buf_db-attr then do:
     7702         assign
     7703           p-value =  buf_db-attr.attr-value
     7704         .
     7705       end.
     7706       else do:
     7707         assign
     7708           p-value = if p-type = 'L':U then "no":U else ""
     7709         .
     7710       end.
     7711     end.
     7712   end procedure.
     7713   procedure db-attr-write :
     7714     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
     7715     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
     7716     define input parameter p-value     like ub.db-attr.attr-value no-undo .
     7717     do
     7718     on error undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1))
     7719     :
     7720       define buffer buf_db-attr for ub.db-attr .
     7721       define variable v-type           as character no-undo .
     7722       define variable v-format         as character no-undo .
     7723       define variable v-label          as character no-undo .
     7724       define variable v-user-can-edit  as logical   no-undo .
     7725       define variable v-output-display as logical   no-undo .
     7726       define variable v-other          as character no-undo .
     7727       run db-attr-code in this-procedure
     7728         (input  p-code
     7729         ,output v-type
     7730         ,output v-format
     7731         ,output v-label
     7732         ,output v-user-can-edit
     7733         ,output v-output-display
     7734         ,output v-other
     7735         ) no-error .
     7736       if error-status :error then do:
     7737         undo, return error SUBSTITUTE("&1, &2", return-value, Error-status:get-message(1)) .
     7738       end.
     7739       find first buf_db-attr exclusive-lock
     7740         where buf_db-attr.db-num    = p-db-num
     7741           and buf_db-attr.attr-code = p-code
     7742         no-error .
     7743       if not available buf_db-attr then do:
     7744         create buf_db-attr .
     7745         assign
     7746           buf_db-attr.db-num    = p-db-num
     7747           buf_db-attr.attr-code = p-code
     7748         .
     7749       end.
     7750       assign
     7751         buf_db-attr.attr-value = p-value
     7752       .
     7753     end.
     7754   end procedure.
     7755   procedure db-attr-exist :
     7756     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
     7757     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
     7758     define output parameter p-exist    as logical  no-undo .
     7759     do
     7760     on error undo, return error
     7761     :
     7762       define buffer buf_db-attr for ub.db-attr .
     7763       define variable v-type           as character no-undo .
     7764       define variable v-format         as character no-undo .
     7765       define variable v-label          as character no-undo .
     7766       define variable v-user-can-edit  as logical   no-undo .
     7767       define variable v-output-display as logical   no-undo .
     7768       define variable v-other          as character no-undo .
     7769       run db-attr-code in this-procedure
     7770         (input  p-code
     7771         ,output v-type
     7772         ,output v-format
     7773         ,output v-label
     7774         ,output v-user-can-edit
     7775         ,output v-output-display
     7776         ,output v-other
     7777         ) no-error .
     7778       if error-status :error then do:
     7779         undo, return error return-value .
     7780       end.
     7781       find first buf_db-attr no-lock
     7782         where buf_db-attr.db-num    = p-db-num
     7783           and buf_db-attr.attr-code = p-code
     7784         no-error .
     7785       if  available buf_db-attr then do:
     7786         p-exist = yes.
     7787       end.
     7788     end.
     7789   end procedure.
     7790   procedure db-attr-delete :
     7791     define input parameter p-db-num   like ub.db-attr.db-num     no-undo .
     7792     define input parameter p-code     like ub.db-attr.attr-code  no-undo .
     7793     define output parameter p-deleted  as logical no-undo.
     7794     do
     7795     on error undo, return error
     7796     :
     7797       define buffer buf_db-attr for ub.db-attr .
     7798       define variable v-type           as character no-undo .
     7799       define variable v-format         as character no-undo .
     7800       define variable v-label          as character no-undo .
     7801       define variable v-user-can-edit  as logical   no-undo .
     7802       define variable v-output-display as logical   no-undo .
     7803       define variable v-other          as character no-undo .
     7804       run db-attr-code in this-procedure
     7805         (input  p-code
     7806         ,output v-type
     7807         ,output v-format
     7808         ,output v-label
     7809         ,output v-user-can-edit
     7810         ,output v-output-display
     7811         ,output v-other
     7812         ) no-error .
     7813       if error-status :error then do:
     7814         undo, return error return-value .
     7815       end.
     7816       find first buf_db-attr exclusive-lock
     7817         where buf_db-attr.db-num    = p-db-num
     7818           and buf_db-attr.attr-code = p-code
     7819         no-error NO-WAIT.
     7820       if not available buf_db-attr then do:
     7821         p-deleted = no.
     7822       end.
     7823       else do:
     7824         delete buf_db-attr.
     7825         p-deleted = yes.
     7826       end.
     7827     end.
     7828   end procedure.
     7829   procedure db-attr-news :
     7830     define input  parameter p-code           as character no-undo .
     7831     define output parameter p-news           as logical   no-undo .
     7832     do
     7833     on error undo, return error
     7834     :
     7835       case p-code :
     7836               when 'schedule-nws':U then do:     assign     p-news = no.   end.
     7837               when 'schedule-merc':U then do:     assign     p-news = no.   end.
     7838               when 'schedule-hdd':U then do:     assign     p-news = no.   end.
     7839               when 'schedule-motp':U then do:     assign     p-news = no.   end.
     7840               when 'schedule-diadoc':U then do:     assign     p-news = no.   end.
     7841               when 'ver-met':U then do:     assign     p-news = no.   end.
     7842               when 'schedule-isPM':U then do:     assign     p-news = no.   end.
     7843               when 'schedule-arc':U then do:     assign     p-news = no.   end.
     7844               when 'schedule-exp':U then do:     assign     p-news = no.   end.
     7845               when 'schedule-oxml':U then do:     assign     p-news = no.   end.
     7846               when 'need-gen-new-pack':U then do:     assign     p-news = no.   end.
     7847               when 'last-unload-db-key':U then do:     assign     p-news = no.   end.
     7848               when 'schedule-getcd':U then do:     assign     p-news = no.   end.
     7849               when 'schedule-sale':U then do:     assign     p-news = no.   end.
     7850               when 'schedule-suz':U then do:     assign     p-news = no.   end.
     7851               when 'cut-date':U then do:     assign     p-news = yes.   end.
     7852               when 'cut-fin-date':U then do:     assign     p-news = yes.   end.
     7853               when 'unload-after-cut':U then do:     assign     p-news = yes.   end.
     7854               when 'cut-db-list':U then do:     assign     p-news = no.   end.
     7855               when 'schedule-cbnk':U then do:     assign     p-news = no.   end.
     7856               when 'arh-disable':U then do:     assign     p-news = no.   end.
     7857               when 'ahsp-disable':U then do:     assign     p-news = no.   end.
     7858               when 'aht-disable':U then do:     assign     p-news = no.   end.
     7859               when 'schedule-free':U then do:     assign     p-news = no.   end.
     7860               when 'ora-exp-seq':U then do:     assign     p-news = no.   end.
     7861               when 'mess-id-video':U then do:     assign     p-news = no.   end.
     7862               when 'int-point':U then do:     assign     p-news = yes.   end.
     7863               when 'hist-code':U then do:     assign     p-news = yes.   end.
     7864               when 'hist-name':U then do:     assign     p-news = yes.   end.
     7865               when 'asiip':U then do:     assign     p-news = no.   end.
     7866               when 'asiport':U then do:     assign     p-news = no.   end.
     7867               when 'asitype':U then do:     assign     p-news = no.   end.
     7868               when 'reg-code':U then do:     assign     p-news = true.   end.
     7869               when 'last-nws-sync':U then do:     assign     p-news = no.   end.
     7870         otherwise do:
     7871           undo, return error substitute("неизвестный атрибут БД &1", p-code) .
     7872         end.
     7873       end.
     7874     end.
     7875   end procedure.
     7876   procedure db-attr-manual-edit :
     7877     define input  parameter p-code           as character no-undo .
     7878     define output parameter p-section-num    as integer no-undo .
     7879     do
     7880     on error undo, return error
     7881     :
     7882       case p-code :
     7883         otherwise do:
     7884           undo, return error substitute("неизвестный атрибут БД &1", p-code ).
     7885         end.
     7886       end.
     7887     end.
     7888   end procedure.
     7889   procedure db-attr-batch-edit :
     7890     define input  parameter p-code           as character no-undo .
