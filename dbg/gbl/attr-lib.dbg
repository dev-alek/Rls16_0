     4515   procedure bc-oattr_name :
     4516     define input  parameter p-code           as character no-undo .
     4517     define output parameter p-type           as character no-undo .
     4518     define output parameter p-format         as character no-undo .
     4519     define output parameter p-label          as character no-undo .
     4520     define output parameter p-range          as integer   no-undo .
     4521     define output parameter p-user-can-edit  as logical   no-undo .
     4522     define output parameter p-output-display as logical   no-undo .
     4523     define output parameter p-other          as character no-undo .
     4524     do
     4525     on error undo, return error
     4526     :
     4527       if index(p-code, chr(4)) > 0 then do:
     4528         p-code = entry(1, p-code, chr(4)).
     4529       end.
     4530       case p-code :
     4531               when 'taracode-bc':U then do:     assign     p-label = "Код тары для сканер-весов NCR"     p-type = 'I':U      p-format = "99"     p-label = "Код тары для сканер-весов NCR"     p-range = 2     p-user-can-edit  = true     p-output-display = true     p-other = "spr=bc-oattr_taracode-bc":U      .   end.
     4532         otherwise do:
     4533           undo, return error substitute("неизвестный атрибут бар-кода &1", p-code ).
     4534         end.
     4535       end.
     4536     end.
     4537   end procedure.
     4538   procedure bc-oattr_tooltip :
     4539   do
     4540     on error undo, return error
     4541     :
     4542       define input  parameter p-code    as character no-undo .
     4543       define output parameter p-tooltip as character no-undo .
     4544       define output parameter p-label   as character no-undo .
     4545       if index(p-code, chr(4)) > 0 then do:
     4546         p-code = entry(1, p-code, chr(4)).
     4547       end.
     4548       case p-code :
     4549               when 'taracode-bc':U then do:     assign     p-tooltip = "Код тары для сканер-весов NCR"     p-label = "Код тары для сканер-весов NCR" .   end.
     4550         otherwise do:
     4551           undo, return error substitute("Неизвестный атрибут бар-кода &1", p-code ).
     4552         end.
     4553       end.
     4554     end.
     4555   end procedure.
     4556   procedure bc-oattr_value :
     4557   do
     4558     on error undo, return error
     4559     :
     4560     define input  parameter p-b-code   as integer   no-undo .
     4561     define input  parameter p-code     as character no-undo .
     4562     define input  parameter p-obj-type as character no-undo .
     4563     define input  parameter p-obj-code as integer   no-undo .
     4564     define output parameter p-value    as character no-undo .
     4565     define output parameter p-type     as character no-undo .
     4566     define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr.
     4567     define variable v-format         as character no-undo .
     4568     define variable v-label          as character no-undo .
     4569     define variable v-range          as integer   no-undo .
     4570     define variable v-user-can-edit  as logical   no-undo .
     4571     define variable v-output-display as logical   no-undo .
     4572     define variable v-other          as character no-undo .
     4573     run bc-oattr_name in this-procedure
     4574         (input  p-code
     4575         ,output p-type
     4576         ,output v-format
     4577         ,output v-label
     4578         ,output v-range
     4579         ,output v-user-can-edit
     4580         ,output v-output-display
     4581         ,output v-other
     4582         ) no-error .
     4583     if error-status :error then do:
     4584       undo, return error return-value .
     4585     end.
     4586     Find first  buf_bar-code-obj-attr no-lock where
     4587                 buf_bar-code-obj-attr.attr-code = p-code
     4588             and buf_bar-code-obj-attr.obj-type = p-obj-type
     4589             and buf_bar-code-obj-attr.obj-code = p-obj-code
     4590             and  buf_bar-code-obj-attr.b-code  = p-b-code no-error .
     4591     if avail buf_bar-code-obj-attr then do:
     4592       assign
     4593       p-value = buf_bar-code-obj-attr.attr-value.
     4594     end.
     4595     else do:
     4596       assign
     4597       p-value = if p-type = 'L':U then "no":U else "".
     4598     end.
     4599   end.
     4600   end procedure.
     4601   procedure bc-oattr_write :
     4602     do
     4603     on error undo, return error
     4604     :
     4605       define input parameter p-b-code   like ub.bar-code-obj-attr.b-code   no-undo .
     4606       define input parameter p-code     like ub.bar-code-obj-attr.attr-code  no-undo .
     4607       define input parameter p-obj-type as character no-undo .
     4608       define input parameter p-obj-code as integer   no-undo .
     4609       define input parameter p-value    like ub.bar-code-obj-attr.attr-value no-undo .
     4610       define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr .
     4611       define buffer buf_bar-code      for ub.bar-code.
     4612       define variable v-type           as character no-undo .
     4613       define variable v-format         as character no-undo .
     4614       define variable v-label          as character no-undo .
     4615       define variable v-range          as integer   no-undo .
     4616       define variable v-user-can-edit  as logical   no-undo .
     4617       define variable v-output-display as logical   no-undo .
     4618       define variable v-other          as character no-undo .
     4619       run bc-oattr_name in this-procedure
     4620         (input  p-code
     4621         ,output v-type
     4622         ,output v-format
     4623         ,output v-label
     4624         ,output v-range
     4625         ,output v-user-can-edit
     4626         ,output v-output-display
     4627         ,output v-other
     4628         ) no-error .
     4629       if error-status :error then do:
     4630         undo, return error return-value .
     4631       end.
     4632       find first buf_bar-code-obj-attr exclusive-lock where
     4633                 buf_bar-code-obj-attr.b-code  = p-b-code
     4634             AND  buf_bar-code-obj-attr.attr-code = p-code
     4635             and buf_bar-code-obj-attr.obj-type = p-obj-type
     4636             and buf_bar-code-obj-attr.obj-code = p-obj-code
     4637       no-error .
     4638       if not available buf_bar-code-obj-attr then do:
     4639         find first buf_bar-code no-lock where
     4640                   buf_bar-code.b-code = p-b-code no-error.
     4641         if not available buf_bar-code then do:
     4642           undo, return error substitute("Не найден бар-код &1, для которого сохраняется атрибут &2"
     4643                                                   , p-b-code
     4644                                                   , p-code) .
     4645         end.
     4646         create buf_bar-code-obj-attr .
     4647         assign
     4648         buf_bar-code-obj-attr.b-code  = p-b-code
     4649         buf_bar-code-obj-attr.attr-code = p-code + (if p-obj-type <> '' then  (chr(4) + p-obj-type + chr(4) + string(p-obj-code)) else '')
     4650         buf_bar-code-obj-attr.attr-value = p-value
     4651         buf_bar-code-obj-attr.gds-code = buf_bar-code.gds-code
     4652         .
     4653       end.
     4654       ELSE
     4655       assign
     4656       buf_bar-code-obj-attr.attr-value = p-value no-error
     4657       .
     4658     end.
     4659   end procedure.
     4660   procedure bc-oattr_EXIST :
     4661     do
     4662     on error undo, return error
     4663     :
     4664       define input parameter p-b-code   like ub.bar-code-obj-attr.b-code   no-undo .
     4665       define input parameter p-code     like ub.bar-code-obj-attr.attr-code  no-undo .
     4666       define input parameter p-obj-type as character no-undo .
     4667       define input parameter p-obj-code as integer   no-undo .
     4668       define OUTPUT parameter p-EXIST   AS LOGICAL no-undo .
     4669       define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr .
     4670       define variable v-type           as character no-undo .
     4671       define variable v-format         as character no-undo .
     4672       define variable v-label          as character no-undo .
     4673       define variable v-range          as integer   no-undo .
     4674       define variable v-user-can-edit  as logical   no-undo .
     4675       define variable v-output-display as logical   no-undo .
     4676       define variable v-other          as character no-undo .
     4677       run bc-oattr_name in this-procedure
     4678         (input  p-code
     4679         ,output v-type
     4680         ,output v-format
     4681         ,output v-label
     4682         ,output v-range
     4683         ,output v-user-can-edit
     4684         ,output v-output-display
     4685         ,output v-other
     4686         ) no-error .
     4687       if error-status :error then do:
     4688         undo, return error return-value .
     4689       end.
     4690       find first buf_bar-code-obj-attr no-lock where
     4691                 buf_bar-code-obj-attr.b-code  = p-b-code
     4692             AND  buf_bar-code-obj-attr.attr-code = p-code
     4693             and buf_bar-code-obj-attr.obj-type = p-obj-type
     4694             and buf_bar-code-obj-attr.obj-code = p-obj-code
     4695       no-error .
     4696       if available buf_bar-code-obj-attr then do:
     4697         P-EXIST = YES.
     4698       end.
     4699     end.
     4700   end procedure.
     4701   procedure bc-oattr_DELETE :
     4702     do
