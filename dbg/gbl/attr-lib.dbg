     3405               when 'gds-code-AIS':U then do:     assign     p-label = "Коды АИС"     p-type = 'C':U      p-format = "X(21)"     p-label = "Коды АИС"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3406               when 'length-of':U then do:     assign     p-label = "Длина"     p-type = 'I':U      p-format = ">>>>>>>>9"     p-label = "Длина"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3407               when 'width-of':U then do:     assign     p-label = "Ширина"     p-type = 'I':U      p-format = ">>>>>>>>9"     p-label = "Ширина"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3408               when 'height-of':U then do:     assign     p-label = "Высота"     p-type = 'I':U      p-format = ">>>>>>>>9"     p-label = "Высота"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3409               when 'qnty-in-box':U then do:     assign     p-label = "Количество в коробке"     p-type = 'I':U      p-format = ">>>>>>>>9"     p-label = "Количество в коробке"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3410               when 'weight-box':U then do:     assign     p-label = "Вес коробки (товар + коробка)"     p-type = 'D':U      p-format = ">>>>>>>>9.999"     p-label = "Вес коробки (товар + коробка)"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3411               when 'qnty-on-pallet':U then do:     assign     p-label = "Количество на палете"     p-type = 'I':U      p-format = ">>>>>>>>9"     p-label = "Количество на палете"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3412               when 'weight-of-pallet':U then do:     assign     p-label = "Вес палеты (товар + коробка)"     p-type = 'D':U      p-format = ">>>>>>>>9.999"     p-label = "Вес палеты (товар + коробка)"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3413               when 'fuel-type':U then do:     assign     p-label = "Тип топлива"     p-type = 'C':U      p-format = "X(50)"     p-label = "Тип топлива"     p-user-can-edit  = true     p-output-display = true     p-other = "spr-ext=ref\gds-ft.p/spr-param=fuel-type/check=gds-attr_check-ptrl-divis"      .   end.
     3414               when 'image-list':U then do:     assign     p-label = "Изображения"     p-type = 'C':U      p-format = "X(75)"     p-label = "Изображения"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     3415               when 'MercUnits':U then do:     assign     p-label = "Дополнительные единицы измерения"     p-type = 'C':U      p-format = "X(100)"     p-label = "Дополнительные единицы измерения"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     3416               when 'weighed-gds':U then do:     assign     p-label = "Является весовым товаром"     p-type = 'L':U      p-format = "+/ "     p-label = "Является весовым товаром"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     3417               when 'IS18Plus':U then do:     assign     p-label = "Наличие возрастных ограничений"     p-type = 'I':U      p-format = ">9"     p-label = "Наличие возрастных ограничений"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
     3418               when 'loyalty-gift':U then do:     assign     p-label = "Оплата баллами Семейная команда"     p-type = 'I':U      p-format = ">9"     p-label = "Оплата баллами Семейная команда"     p-user-can-edit  = false     p-output-display = true     p-other = ""      .   end.
     3419         otherwise do:
     3420           undo, return error substitute("неизвестный глобальный атрибут товара &1", p-code ).
     3421         end.
     3422       end.
     3423     end.
     3424   end procedure.
     3425   procedure gds-attr-tooltip :
     3426   do
     3427     on error undo, return error
     3428     :
     3429       define input  parameter p-code    as character no-undo .
     3430       define output parameter p-tooltip as character no-undo .
     3431       define output parameter p-label   as character no-undo .
     3432       case p-code :
     3433               when 'lock':U then do:     assign     p-tooltip = "Блокировка атрибутов на изменение"     p-label = "Блокировка атрибутов на изменение" .   end.
     3434               when 'alcohol-prod':U then do:     assign     p-tooltip = "Алкогольная продукция"     p-label = "Алкогольная продукция" .   end.
     3435               when 'egais-name':U then do:     assign     p-tooltip = "Наименование товара в ЕГАИС"     p-label = "Наименование товара в ЕГАИС" .   end.
     3436               when 'ptrl-without-rvs':U then do:     assign     p-tooltip = "Топливо - сверка не требуется"     p-label = "Топливо - сверка не требуется" .   end.
     3437               when 'office-type':U then do:     assign     p-tooltip = "Тип услуги"     p-label = "Тип услуги" .   end.
     3438               when 'mark-type':U then do:     assign     p-tooltip = "Тип маркировки"     p-label = "Тип маркировки" .   end.
     3439               when 'emrc-type':U then do:     assign     p-tooltip = "Тип ЕМЦ"     p-label = "Тип ЕМЦ" .   end.
     3440               when 'item-matter-mark':U then do:     assign     p-tooltip = "Признак предмета расчета"     p-label = "Признак предмета расчета" .   end.
     3441               when 'type-method-calc':U then do:     assign     p-tooltip = "Признак способа расчета"     p-label = "Признак способа расчета" .   end.
     3442               when 'cash-book-id':U then do:     assign     p-tooltip = "Кассовая книга"     p-label = "Кассовая книга" .   end.
     3443               when 'oper-serv-idd':U then do:     assign     p-tooltip = "Платежный агент"     p-label = "Платежный агент" .   end.
     3444               when 'group-np':U then do:     assign     p-tooltip = "Группа НП"     p-label = "Группа НП" .   end.
     3445               when 'is-loyalty-payment':U then do:     assign     p-tooltip = "Перечисление в систему лояльности"     p-label = "Перечисление в систему лояльности" .   end.
     3446               when 'ban-bonus':U then do:     assign     p-tooltip = "Запрет на участие в бонусных программах\участие в скидке на итог"     p-label = "Запрет на участие в бонусных программах\участие в скидке на итог" .   end.
     3447               when 'null-price':U then do:     assign     p-tooltip = "Разрешена нулевая цена"     p-label = "Разрешена нулевая цена" .   end.
     3448               when 'fasovka':U then do:     assign     p-tooltip = "Товар фасуется"     p-label = "Товар фасуется" .   end.
     3449                   when 'time-coock':U then do:     assign     p-tooltip = "Печатать время приготовления в чеке"     p-label = "Печатать время приготовления в чеке" .   end.
     3450               when 'mark':U then do:     assign     p-tooltip = "Товар требует обязательной маркировки"     p-label = "Товар требует обязательной маркировки" .   end.
     3451               when 'mercur_FGIS':U then do:     assign     p-tooltip = "Является подконтрольным ФГИС Меркурий"     p-label = "Является подконтрольным ФГИС Меркурий" .   end.
     3452               when 'perishable':U then do:     assign     p-tooltip = "Является скоропортящейся продукцией"     p-label = "Является скоропортящейся продукцией" .   end.
     3453               when 'production-only':U then do:     assign     p-tooltip = "Используется только для производства (альтернатива)"     p-label = "Только производство" .   end.
     3454               when 'sum-grp-gl':U then do:     assign     p-tooltip = "Номер группы товаров на кассе (IBM-POS)"     p-label = "Группа товаров на кассе" .   end.
     3455               when '15x80':U then do:     assign     p-tooltip = "Текст поля СОСТАВ для этикетки 15x80 (DIGI-SM)"     p-label = "Текст поля СОСТАВ 15x80 (DIGI-SM)" .   end.
     3456               when '8x50':U then do:     assign     p-tooltip = "Текст поля СОСТАВ для этикетки 8x50 (CAS_LP-16x,SHTRIH-M)"     p-label = "Текст поля СОСТАВ 8x50 (CAS_LP-16x,SHTRIH-M)" .   end.
     3457               when '6x50':U then do:     assign     p-tooltip = "Текст поля СОСТАВ для этикетки 6x50 (CAS_CL5000 CAS_CL5000J)"     p-label = "Текст поля СОСТАВ 6x50 (CAS_CL5000 CAS_CL5000J)" .   end.
     3458               when 'calories':U then do:     assign     p-tooltip = "Энерг.ценность ккал на 100г"     p-label = "Энерг.ценность ккал на 100г" .   end.
     3459               when 'protein':U then do:     assign     p-tooltip = "Белки г на 100г"     p-label = "Белки г на 100г" .   end.
     3460               when 'fat':U then do:     assign     p-tooltip = "Жиры г на 100г"     p-label = "Жиры г на 100г" .   end.
     3461               when 'carbohydrate':U then do:     assign     p-tooltip = "Углеводы г на 100г"     p-label = "Углеводы г на 100г" .   end.
     3462               when 'calc-cal-rec':U then do:     assign     p-tooltip = "Расчет энергетической ценности из основного рецепта"     p-label = "_Расчет энерг.ценн-ти из основного рец-та" .   end.
     3463               when 'cash-parts':U then do:     assign     p-tooltip = "По умолч.торгуется по партиям"     p-label = "По умолч.торгуется по партиям" .   end.
     3464               when 'ptrl-as-good':U then do:     assign     p-tooltip = "ТНП продается через ТРК"     p-label = "ТНП продается через ТРК" .   end.
     3465               when 'dflt-insalepr':U then do:     assign     p-tooltip = "По умолч. приходуется в продаж.ценах"     p-label = "По умолч. приходуется в продаж.ценах" .   end.
     3466               when 'gds-ptrl-densities':U then do:     assign     p-tooltip = "Диапазон плотности"     p-label = "Диапазон плотности" .   end.
     3467               when 'gds-CommodityCode':U then do:     assign     p-tooltip = "Код номенклатурной классификации"     p-label = "Код номенклатурной классификации" .   end.
     3468               when 'gds-code-AIS':U then do:     assign     p-tooltip = "Коды АИС"     p-label = "Коды АИС" .   end.
     3469               when 'length-of':U then do:     assign     p-tooltip = "Длина"     p-label = "Длина" .   end.
     3470               when 'width-of':U then do:     assign     p-tooltip = "Ширина"     p-label = "Ширина" .   end.
     3471               when 'height-of':U then do:     assign     p-tooltip = "Высота"     p-label = "Высота" .   end.
     3472               when 'qnty-in-box':U then do:     assign     p-tooltip = "Количество в коробке"     p-label = "Количество в коробке" .   end.
     3473               when 'weight-box':U then do:     assign     p-tooltip = "Вес коробки (товар + коробка)"     p-label = "Вес коробки (товар + коробка)" .   end.
     3474               when 'qnty-on-pallet':U then do:     assign     p-tooltip = "Количество на палете"     p-label = "Количество на палете" .   end.
     3475               when 'weight-of-pallet':U then do:     assign     p-tooltip = "Вес палеты (товар + коробка)"     p-label = "Вес палеты (товар + коробка)" .   end.
     3476               when 'fuel-type':U then do:     assign     p-tooltip = "Тип топлива"     p-label = "Тип топлива" .   end.
     3477               when 'image-list':U then do:     assign     p-tooltip = "Изображения"     p-label = "Изображения" .   end.
     3478               when 'MercUnits':U then do:     assign     p-tooltip = "Дополнительные единицы измерения"     p-label = "Дополнительные единицы измерения" .   end.
     3479               when 'weighed-gds':U then do:     assign     p-tooltip = "Является весовым товаром"     p-label = "Является весовым товаром" .   end.
     3480               when 'IS18Plus':U then do:     assign     p-tooltip = "Наличие возрастных ограничений"     p-label = "Наличие возрастных ограничений" .   end.
     3481               when 'loyalty-gift':U then do:     assign     p-tooltip = "Оплата баллами Семейная команда"     p-label = "Оплата баллами Семейная команда" .   end.
     3482         otherwise do:
     3483           undo, return error substitute("Неизвестный глобальный атрибут товара &1", p-code ).
     3484         end.
     3485       end.
     3486     end.
     3487   end procedure.
     3488   procedure gds-attr-value :
     3489   do
     3490     on error undo, return error
     3491     :
     3492     define input  parameter p-gds-code as integer   no-undo .
     3493     define input  parameter p-code     as character no-undo .
     3494     define output parameter p-value    as character no-undo .
     3495     define output parameter p-type     as character no-undo .
     3496     define buffer goods          for ub.goods.
     3497     define buffer buf-goods-attr for ub.goods-attr.
     3498     define variable v-format         as character no-undo .
     3499     define variable v-label          as character no-undo .
     3500     define variable v-user-can-edit  as logical   no-undo .
     3501     define variable v-output-display as logical   no-undo .
     3502     define variable v-other          as character no-undo .
     3503       run gds-attr-name in this-procedure
     3504         (input  p-code
     3505         ,output p-type
     3506         ,output v-format
     3507         ,output v-label
     3508         ,output v-user-can-edit
     3509         ,output v-output-display
     3510         ,output v-other
     3511         ) no-error .
     3512       if error-status :error then do:
     3513         undo, return error return-value .
     3514       end.
     3515       Find first  buf-goods-attr no-lock where
     3516                   buf-goods-attr.attr-code = p-code
     3517              and  buf-goods-attr.gds-code  = p-gds-code no-error .
     3518      if avail buf-goods-attr then do:
     3519       assign
     3520       p-value = buf-goods-attr.attr-value.
     3521      end.
     3522      else do:
     3523         find first goods where goods.gds-code eq p-gds-code no-lock no-error.
     3524         if available goods
     3525         then do:
     3526            run ggoattr-value (input  goods.grp-code,
     3527                               input  0,
     3528                               input  "",
     3529                               input  0,
     3530                               input  p-code,
     3531                               output p-value,
     3532                               output p-type) no-error.
     3533            if error-status:error
     3534            then
     3535               p-value = if p-type = 'L':U then "no":U else "".
     3536        end.
     3537        else
     3538           p-value = if p-type = 'L':U then "no":U else "".
     3539        end.
     3540   end.
     3541   end procedure.
     3542   procedure gds-attr-write :
     3543     do
     3544     on error undo, return error
     3545     :
     3546       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3547       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3548       define input parameter p-value    like ub.goods-attr.attr-value no-undo .
     3549       define buffer buf_goods-attr for ub.goods-attr .
     3550       define variable v-type           as character no-undo .
     3551       define variable v-format         as character no-undo .
     3552       define variable v-label          as character no-undo .
     3553       define variable v-user-can-edit  as logical   no-undo .
     3554       define variable v-output-display as logical   no-undo .
     3555       define variable v-other          as character no-undo .
     3556       run gds-attr-name in this-procedure
     3557         (input  p-code
     3558         ,output v-type
     3559         ,output v-format
     3560         ,output v-label
     3561         ,output v-user-can-edit
     3562         ,output v-output-display
     3563         ,output v-other
     3564         ) no-error .
     3565       if error-status :error then do:
     3566         undo, return error return-value .
     3567       end.
     3568       find first buf_goods-attr exclusive-lock where
     3569                  buf_goods-attr.gds-code  = p-gds-code
     3570             AND  buf_goods-attr.attr-code = p-code no-error .
     3571       if not available buf_goods-attr then do:
     3572         create buf_goods-attr .
     3573         assign
     3574           buf_goods-attr.gds-code  = p-gds-code
     3575           buf_goods-attr.attr-code = p-code
     3576           buf_goods-attr.attr-value = p-value no-error
     3577         .
     3578       end.
     3579       ELSE
     3580         buf_goods-attr.attr-value = p-value no-error.
     3581       if error-status :error then do:
     3582         undo, return error return-value .
     3583       end.
     3584     end.
     3585   end procedure.
     3586   procedure gds-attr-EXIST :
     3587     do
     3588     on error undo, return error
     3589     :
     3590       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3591       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3592       define OUTPUT parameter p-EXIST   AS LOGICAL no-undo .
     3593       define buffer buf_goods-attr for ub.goods-attr .
     3594       define variable v-type           as character no-undo .
     3595       define variable v-format         as character no-undo .
     3596       define variable v-label          as character no-undo .
     3597       define variable v-user-can-edit  as logical   no-undo .
     3598       define variable v-output-display as logical   no-undo .
     3599       define variable v-other          as character no-undo .
     3600       run gds-attr-name in this-procedure
     3601         (input  p-code
     3602         ,output v-type
     3603         ,output v-format
     3604         ,output v-label
     3605         ,output v-user-can-edit
     3606         ,output v-output-display
     3607         ,output v-other
     3608         ) no-error .
     3609       if error-status :error then do:
     3610         undo, return error return-value .
     3611       end.
     3612       find first buf_goods-attr NO-lock where
     3613                  buf_goods-attr.gds-code  = p-gds-code
     3614              AND buf_goods-attr.attr-code = p-code no-error .
     3615       if available buf_goods-attr then do:
     3616         P-EXIST = YES.
     3617       end.
     3618     end.
     3619   end procedure.
     3620   procedure gds-attr-DELETE :
     3621     do
     3622     on error undo, return error
     3623     :
     3624       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
     3625       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
     3626       define output parameter p-DELETED  AS LOGICAL no-undo .
     3627       define buffer buf_goods-attr for ub.goods-attr .
     3628       define variable v-type           as character no-undo .
     3629       define variable v-format         as character no-undo .
     3630       define variable v-label          as character no-undo .
     3631       define variable v-user-can-edit  as logical   no-undo .
     3632       define variable v-output-display as logical   no-undo .
     3633       define variable v-other          as character no-undo .
     3634       run gds-attr-name in this-procedure
     3635         (input  p-code
     3636         ,output v-type
     3637         ,output v-format
     3638         ,output v-label
     3639         ,output v-user-can-edit
     3640         ,output v-output-display
     3641         ,output v-other
     3642         ) no-error .
     3643       if error-status :error then do:
     3644         undo, return error return-value .
     3645       end.
     3646       find first buf_goods-attr exclusive-lock where
     3647                  buf_goods-attr.gds-code  = p-gds-code
     3648              AND buf_goods-attr.attr-code = p-code no-error .
     3649       if not available buf_goods-attr then do:
     3650         p-DELETED = NO.
     3651       end.
     3652       ELSE DO:
     3653          delete buf_goods-attr.
     3654         p-DELETED = YES.
     3655       END.
     3656     end.
     3657   end procedure.
     3658   procedure gds-attr-copy-to :
     3659   do
     3660     on error undo, return error
     3661     :
     3662     define input  parameter p-gds-code as integer   no-undo .
     3663     define input  parameter p-code     as character no-undo .
     3664     define input  parameter p-bh       as handle no-undo .
     3665     define buffer buf-goods-attr for ub.goods-attr.
     3666     define variable v-format         as character no-undo .
     3667     define variable v-label          as character no-undo .
     3668     define variable v-user-can-edit  as logical   no-undo .
     3669     define variable v-output-display as logical   no-undo .
     3670     define variable v-other          as character no-undo .
     3671     define variable v-type           as character no-undo .
     3672       run gds-attr-name in this-procedure
     3673         (input  p-code
     3674         ,output v-type
     3675         ,output v-format
     3676         ,output v-label
     3677         ,output v-user-can-edit
     3678         ,output v-output-display
     3679         ,output v-other
     3680         ) no-error .
     3681       if error-status :error then do:
     3682         undo, return error return-value .
     3683       end.
     3684       Find first  buf-goods-attr no-lock where
     3685                   buf-goods-attr.attr-code = p-code
     3686              and  buf-goods-attr.gds-code  = p-gds-code no-error .
     3687      if not p-bh:available then do:
     3688        p-bh:buffer-create().
     3689      end.
     3690      if avail buf-goods-attr then do:
     3691        assign
     3692        p-bh:buffer-field("attr-value"):buffer-value = buf-goods-attr.attr-value.
     3693      end.
     3694      else do:
     3695        assign
     3696        p-bh:buffer-field("attr-value"):buffer-value = if v-type = 'L':U then "no":U else "".
     3697      end.
     3698   end.
     3699   end procedure.
     3700   procedure gds-attr-news :
