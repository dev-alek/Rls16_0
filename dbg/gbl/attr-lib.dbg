     8221   procedure ext-system-attr-delete :
     8222     define input parameter p-esys-id  like ub.ext-system-attr.esys-id    no-undo .
     8223     define input parameter p-db-num   like ub.ext-system-attr.db-num     no-undo .
     8224     define input parameter p-code     like ub.ext-system-attr.esya-attr-code  no-undo .
     8225     define output parameter p-deleted  as logical no-undo.
     8226     do
     8227     on error undo, return error
     8228     :
     8229       define buffer buf_ext-system-attr for ub.ext-system-attr .
     8230       define variable v-type           as character no-undo .
     8231       define variable v-format         as character no-undo .
     8232       define variable v-label          as character no-undo .
     8233       define variable v-user-can-edit  as logical   no-undo .
     8234       define variable v-output-display as logical   no-undo .
     8235       define variable v-other          as character no-undo .
     8236       run ext-system-attr-code in this-procedure
     8237         (input  p-code
     8238         ,output v-type
     8239         ,output v-format
     8240         ,output v-label
     8241         ,output v-user-can-edit
     8242         ,output v-output-display
     8243         ,output v-other
     8244         ) no-error .
     8245       if error-status :error then do:
     8246         undo, return error return-value .
     8247       end.
     8248       find first buf_ext-system-attr exclusive-lock
     8249         where buf_ext-system-attr.esys-id   = p-esys-id
     8250           and buf_ext-system-attr.db-num    = p-db-num
     8251           and buf_ext-system-attr.esya-attr-code = p-code
     8252         no-error NO-WAIT.
     8253       if not available buf_ext-system-attr then do:
     8254         p-deleted = no.
     8255       end.
     8256       else do:
     8257         delete buf_ext-system-attr.
     8258         p-deleted = yes.
     8259       end.
     8260     end.
     8261   end procedure.
     8262   procedure ext-system-attr-news :
     8263     define input  parameter p-code           as character no-undo .
     8264     define output parameter p-news           as logical   no-undo .
     8265     do
     8266     on error undo, return error
     8267     :
     8268       case p-code :
     8269               when 'need-gen-new-xpack':U then do:     assign     p-news = no.   end.
     8270               when 'FTP':U then do:     assign     p-news = yes.   end.
     8271               when 'Login':U then do:     assign     p-news = yes.   end.
     8272               when 'Password':U then do:     assign     p-news = yes.   end.
     8273               when 'Path':U then do:     assign     p-news = yes.   end.
     8274               when 'IN-dir':U then do:     assign     p-news = yes.   end.
     8275               when 'OUT-dir':U then do:     assign     p-news = yes.   end.
     8276               when 'cert-sign':U then do:     assign     p-news = yes.   end.
     8277               when 'cert-sign-subject':U then do:     assign     p-news = yes.   end.
     8278               when 'cert-sign-issuer':U then do:     assign     p-news = yes.   end.
     8279               when 'cert-file-ext':U then do:     assign     p-news = yes.   end.
     8280               when 'cert-repository':U then do:     assign     p-news = yes.   end.
     8281               when 'ver-code':U then do:     assign     p-news = no.   end.
     8282               when 'AuthToken':U then do:     assign     p-news = false.   end.
     8283               when 'AuthTokenDT':U then do:     assign     p-news = false.   end.
     8284               when 'host-code':U then do:     assign     p-news = false.   end.
     8285               when 'obj':U then do:     assign     p-news = false.   end.
     8286               when 'user-id':U then do:     assign     p-news = false.   end.
     8287               when 'server-addr':U then do:     assign     p-news = false.   end.
     8288               when 'proxy-addr':U then do:     assign     p-news = false.   end.
     8289               when 'proxy-login':U then do:     assign     p-news = false.   end.
     8290               when 'proxy-pswd':U then do:     assign     p-news = yes.   end.
     8291               when 'proxy-ssl':U then do:     assign     p-news = false.   end.
     8292               when 'AuthToken-send':U then do:     assign     p-news = false.   end.
     8293               when 'mail-list':U then do:     assign     p-news = false.   end.
     8294               when 'diadoc-user':U then do:     assign     p-news = false.   end.
     8295               when 'diadoc-pwd':U then do:     assign     p-news = false.   end.
     8296               when 'diadoc-key':U then do:     assign     p-news = false.   end.
     8297               when 'diadoc-lastload':U then do:     assign     p-news = false.   end.
     8298               when 'diadoc-ssl':U then do:     assign     p-news = false.   end.
     8299               when 'reg-code':U then do:     assign     p-news = true.   end.
     8300               when 'last-nws-sync':U then do:     assign     p-news = no.   end.
     8301         otherwise do:
     8302           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
     8303         end.
     8304       end.
     8305     end.
     8306   end procedure.
