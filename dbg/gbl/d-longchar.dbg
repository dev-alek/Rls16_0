        1   define input        parameter h-callback    as handle    no-undo .
        2   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        3   DEFINE INPUT-OUTPUT PARAMETER pValue       AS longCHAR NO-UNDO.
        4   DEFINE OUTPUT       PARAMETER p-ok         AS logical   NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных longchar".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       67   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       68   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       69   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       70   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       71   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       74   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       75   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       76   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       77   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       78   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       79   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       80   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       81   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       82   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   function octal-to-char return character
       89   ( p-string as character ) :
       90     def var v-asc     as integer no-undo .
       91     def var v-new-asc as integer no-undo .
       92     def var ind       as integer no-undo .
       93     if length(p-string) <> 3 then do:
       94       return ? .
       95     end.
       96     assign
       97       v-asc = 0
       98     .
       99     do ind = 1 to length(p-string)
      100     :
      101       assign
      102         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      103       .
      104       if v-new-asc < 0 or v-new-asc >= 8 then do:
      105         return ? .
      106       end.
      107       assign
      108         v-asc = v-asc * 8 + v-new-asc
      109       .
      110     end.
      111     return chr(v-asc) .
      112   end function .
      113   function char-to-octal return character
      114   ( p-chr as character ) :
      115     def var v-asc    as integer   no-undo .
      116     def var ind      as integer   no-undo .
      117     def var v-string as character no-undo .
      118     if length(p-chr) <> 1 then do:
      119       return ? .
      120     end.
      121     assign
      122       v-asc    = asc(p-chr)
      123       v-string = ""
      124     .
      125     do ind = 1 to 3
      126     :
      127       assign
      128         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      129       .
      130       assign
      131         v-asc = truncate(v-asc / 8, 0)
      132       .
      133     end.
      134     return v-string .
      135   end.
      136   function str-encode return character
      137   (   p-init-string       as character
      138     , p-encode-char       as character
      139     , p-special-char-list as character
      140   ) :
      141     def var p-encode-string as character no-undo .
      142     def var ind                as integer no-undo .
      143     def var v-num-special-char as integer no-undo .
      144     def var v-special-char     as character no-undo .
      145     if p-encode-char = ?
      146     or p-encode-char = "" then do:
      147       assign
      148         p-encode-char = "~~"
      149       .
      150     end.
      151     if p-init-string = ? then do:
      152       return "?" .
      153     end.
      154     if p-init-string = "?" then do:
      155       return p-encode-char + char-to-octal("?") .
      156     end.
      157     assign
      158       v-num-special-char = length(p-special-char-list)
      159       p-encode-string    = replace(p-init-string
      160                                   ,p-encode-char
      161                                   ,p-encode-char + char-to-octal(p-encode-char)
      162                                   )
      163     .
      164     do ind = 1 to v-num-special-char
      165     :
      166       assign
      167         v-special-char = substring(p-special-char-list, ind, 1)
      168       .
      169       if v-special-char <> p-encode-char then do:
      170         assign
      171           p-encode-string = replace (p-encode-string
      172                                     ,v-special-char
      173                                     ,p-encode-char + char-to-octal(v-special-char)
      174                                     )
      175         .
      176       end.
      177     end.
      178     return p-encode-string .
      179   end.
      180   function str-decode returns character
      181     (p-init-string   as character
      182     ,p-encode-char   as character
      183     ) :
      184     def var p-decode-string as character no-undo .
      185     def var ind                       as integer no-undo .
      186     def var v-num-entries-init-string as integer no-undo .
      187     def var v-sub-phrase              as character no-undo .
      188     def var v-special-char            as character no-undo .
      189     if p-encode-char = ?
      190     or p-encode-char = "" then do:
      191       assign
      192         p-encode-char = "~~"
      193       .
      194     end.
      195     if p-init-string = "?" then do:
      196       return ? .
      197     end.
      198     assign
      199       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      200     .
      201     if v-num-entries-init-string > 1 then do:
      202       assign
      203         p-decode-string = entry(1, p-init-string, p-encode-char)
      204       .
      205       do ind = 2 to v-num-entries-init-string
      206       :
      207         assign
      208           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      209         .
      210         assign
      211           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      212         .
      213         if v-special-char <> ? then do:
      214           assign
      215             p-decode-string = p-decode-string
      216                             + v-special-char
      217                             + substring(v-sub-phrase, 4)
      218           .
      219         end.
      220         else do:
      221           assign
      222             p-decode-string = p-decode-string
      223                             + p-encode-char
      224                             + v-sub-phrase
      225           .
      226         end.
      227       end.
      228     end.
      229     else do:
      230       assign
      231         p-decode-string = p-init-string
      232       .
      233     end.
      234     return p-decode-string .
      235   end.
      236   procedure proc-alt-shift-f2:
      237     if not ibs.th.gbl.gbl-var:rcode
      238   then
      239     run gbl\inidebug.p .
      240   end.
      241   procedure proc-alt-shift-f3:
      242     run gbl/prvssinf.p
      243       ( input this-procedure
      244       ) .
      245   end.
      246   define variable v-inform-launched as logical no-undo initial false .
      247   procedure proc-alt-shift-f4:
      248     define variable v-action as character no-undo .
      249     if v-inform-launched = false then do:
      250       assign
      251         v-inform-launched = true
      252       .
      253       run gbl/d-inform.w
      254         (  input self
      255         ,  input this-procedure
      256         , output v-action
      257         ) no-error .
      258       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      259       assign
      260         v-inform-launched = false
      261       .
      262     end.
      263   end.
      264   procedure proc-alt-f1:
      265     run gbl/corrhelp.p
      266       (input this-procedure
      267       ) .
      268   end .
      269   on alt-shift-f2 anywhere do:
      270     run proc-alt-shift-f2.
      271   end.
      272   on alt-shift-f3 anywhere do:
      273     run proc-alt-shift-f3 in this-procedure .
      274   end.
      275   on alt-shift-f4 anywhere do:
      276     run proc-alt-shift-f4 in this-procedure.
      277   end.
      278   on alt-f1 anywhere do:
      279     run proc-alt-f1 in this-procedure .
      280   end.
      281   define variable lUserPressOK     AS LOGICAL       NO-UNDO INIT False .
      282   define variable sFormat          AS CHARACTER     NO-UNDO .
      283   define variable sBoxProg         AS CHARACTER     NO-UNDO .
      284   define variable heditor          AS WIDGET-HANDLE NO-UNDO .
      285   define variable seditor_Row      AS CHARACTER     NO-UNDO INIT ? .
      286   define variable seditor_Col      AS CHARACTER     NO-UNDO INIT ? .
      287   define variable seditor_Width    AS CHARACTER     NO-UNDO INIT ? .
      288   define variable seditor_Height   AS CHARACTER     NO-UNDO INIT ? .
      289   define variable sEditor_MaxChars AS CHARACTER     NO-UNDO INIT ? .
      290   define variable sCreate_Text1    AS CHARACTER     NO-UNDO INIT ? .
      291   define variable v-read-only      AS LOGICAL       NO-UNDO INIT False .
      292   DEFINE BUTTON b-file
      293        LABEL "В файл"
      294        SIZE 10 BY 1.
      295   DEFINE BUTTON b-help
      296        LABEL "Помо&щь"
      297        SIZE 3 BY 1
      298        BGCOLOR 8 .
      299   DEFINE BUTTON Btn-Choose
      300        LABEL "V"
      301        SIZE 2.5 BY 1.
      302   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      303        LABEL "&Отмена"
      304        SIZE 10 BY 1
      305        BGCOLOR 8 .
      306   DEFINE BUTTON Btn_OK AUTO-GO
      307        LABEL "&Ввод "
      308        SIZE 10 BY 1
      309        BGCOLOR 8 .
      310   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      311        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      312        SIZE 96 BY 16.2
      313        BGCOLOR 15  NO-UNDO.
      314   DEFINE VARIABLE FILL-IN-Text-1 AS CHARACTER FORMAT "X(256)":U
      315         VIEW-AS TEXT
      316        SIZE 41.3 BY .57
      317        FONT 4 NO-UNDO.
      318   DEFINE VARIABLE FILL-IN-Text-2 AS CHARACTER FORMAT "X(256)":U
      319         VIEW-AS TEXT
      320        SIZE 41.3 BY .57
      321        FONT 4 NO-UNDO.
      322   DEFINE FRAME Dialog-Frame
      323        Btn_OK AT ROW 1 COL 1
      324        Btn_Cancel AT ROW 1 COL 11
      325        b-file AT ROW 1 COL 51 WIDGET-ID 6
      326        b-help AT ROW 1 COL 95
      327        Btn-Choose AT ROW 2.87 COL 81.5
      328        EDITOR-1 AT ROW 4 COL 1 NO-LABEL WIDGET-ID 4
      329        FILL-IN-Text-1 AT ROW 2.87 COL 2.5 NO-LABEL
      330        FILL-IN-Text-2 AT ROW 3.77 COL 2.5 NO-LABEL
      331        SPACE(55.59) SKIP(19.05)
      332       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      333            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      334            TITLE "Ввод строкового значения"
      335            CANCEL-BUTTON Btn_Cancel.
      336   ASSIGN
      337          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      338          FRAME Dialog-Frame:HIDDEN           = TRUE.
      339   ASSIGN
      340          Btn-Choose:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      341   ASSIGN
      342          EDITOR-1:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE
      343          EDITOR-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      344   ASSIGN
      345          FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      346   ASSIGN
      347          FILL-IN-Text-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      348   ON GO OF FRAME Dialog-Frame
      349   DO:
      350     IF NOT v-read-only
      351     THEN DO:
      352       IF VALID-HANDLE(heditor)
      353       THEN DO:
      354         if  h-callback <> ?
      355         and valid-handle(h-callback)
      356         then do:
      357           if h-callback :get-signature("cb-d-longcharr-validate") <> ""
      358           then do:
      359             define variable v-ok as logical no-undo .
      360             define variable v-message as character no-undo .
      361             run cb-d-longchar-validate in h-callback
      362               (input  editor-1
      363               ,output v-ok
      364               ,output v-message
      365               ) no-error .
      366             if error-status :error
      367             then do:
      368               message
      369                 vss-workfile vss-revision vss-description skip
      370                 "Ошибка при вызове процедуры проверки допустимости longcharacter" skip
      371                 "Вызывающая программа" h-callback :file-name skip
      372                 "Внутренняя процедура" "cb-d-longchar-validate" skip
      373                 error-status :get-message(1) skip
      374                 return-value skip
      375                 view-as alert-box error .
      376               return no-apply .
      377             end.
      378             if v-ok <> true
      379             then do:
      380               message
      381                 v-message
      382                 view-as alert-box information .
      383               return no-apply .
      384             end.
      385           end.
      386           else do:
      387             message
      388               vss-workfile vss-revision vss-description skip
      389               "Программе был передан указатель на процедуру для проверки character" skip
      390               "В вызывающей программе отсутствует внутренняя процедура" "cb-d-longchar-validate" skip
      391               "Вызывающая программа" h-callback :file-name skip
      392               view-as alert-box error .
      393             return no-apply .
      394           end.
      395         end.
      396         ASSIGN
      397           pValue = heditor:SCREEN-VALUE
      398         .
      399       END.
      400     END.
      401     ASSIGN
      402     p-ok = True
      403     .
      404   END.
      405   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      406   DO:
      407     APPLY "END-ERROR":U TO SELF.
      408   END.
      409   ON CHOOSE OF b-file IN FRAME Dialog-Frame
      410   DO:
      411     run proc-save-file no-error.
      412   END.
      413   ON CHOOSE OF Btn-Choose IN FRAME Dialog-Frame
      414   DO:
      415     define variable var_id   as char no-undo.
      416     define variable var_name as char no-undo.
      417   if session :set-wait-state( "compiler" ) then.
      418     do with frame Dialog-Frame
      419     :
      420       assign
      421         var_id = heditor :screen-value
      422       .
      423       run value(sboxprog) (input-output var_id, input-output var_name).
      424       if var_id <> heditor :screen-value
      425       then do:
      426         assign
      427           heditor :screen-value = var_id
      428         .
      429       end.
      430     end.
      431   if session :set-wait-state( "" ) then.
      432   END.
      433   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   on help of frame Dialog-Frame
      435   do:
      436     run gbl/app_help.p
      437       (input this-procedure :file-name
      438       ,input ''
      439       ,input ?
      440       ) no-error.
      441     if error-status :error then do:
      442       message
      443         "Ошибка при вызове помощи"
      444         error-status :get-message(1)
      445         view-as alert-box .
      446     end.
      447   end.
      448   run minbtn-set in this-procedure .
      449   on choose of b-help in frame Dialog-Frame
      450   do:
      451     apply "help":u to frame Dialog-Frame .
      452   end.
      453   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   procedure minbtn-set :
      455       do
      456           on error undo, return error return-value
      457           :
      458           define variable ii              as integer       no-undo .
      459           define variable fh              as widget-handle no-undo .
      460           define variable hh              as widget-handle no-undo .
      461           define variable v-h             as handle        extent 4 no-undo .
      462           define variable v-name-button   as character     no-undo .
      463           define variable v-help-old-x    as decimal       no-undo .
      464           define variable v-help-old-y    as decimal       no-undo .
      465           define variable v-help-old-size as decimal       no-undo .
      466           define variable v-frame-width   as decimal       no-undo .
      467           define variable jj              as integer       no-undo .
      468           do
      469               on error undo, return error
      470               :
      471               assign
      472                   v-frame-width = frame Dialog-Frame:width - 0.3
      473                   fh            = frame Dialog-Frame:first-child
      474                   hh            = fh:first-child
      475                   ii            = 1
      476                   .
      477               do while valid-handle(hh):
      478                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      479                   do:
      480                       case lc(hh:name) :
      481                           when "b-help" then
      482                               do:
      483                                   hh:load-image-up("cmp/b-help.bmp":u) .
      484                                   hh:load-image-down("cmp/b-help.bmp":u) .
      485                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      486                                   hh:TOOLTIP = "Помощь" .
      487                                   v-help-old-x = hh:column .
      488                                   v-help-old-y = hh:row    .
      489                                   v-help-old-size = hh:width .
      490                                   hh:width-chars = 2.5 .
      491                               end.
      492                           when "b-print" then
      493                               do:
      494                                   hh:load-image("cmp/b-print.bmp":u) .
      495                                   hh:TOOLTIP = "Печать" .
      496                                   v-h[ii] = hh:handle .
      497                                   ii = ii + 1 .
      498                                   hh:width-chars = 3 .
      499                               end.
      500                           when "b-history" or
      501                           when "b-hist" then
      502                               do:
      503                                   hh:load-image("cmp/b-hist.bmp":u) .
      504                                   hh:TOOLTIP = "История" .
      505                                   v-h[ii] = hh:handle .
      506                                   ii = ii + 1 .
      507                                   hh:width-chars = 3 .
      508                               end.
      509                           when "b-sch" then
      510                               do:
      511                                   hh:load-image("cmp/b-sch.bmp":u) .
      512                                   hh:TOOLTIP = "Установка Фильтра" .
      513                                   v-h[ii] = hh:handle .
      514                                   ii = ii + 1 .
      515                                   hh:width-chars = 3 .
      516                               end.
      517                           when "b-hist-user" then
      518                               do:
      519                                   hh:load-image("cmp/b-hist.bmp":u) .
      520                                   hh:TOOLTIP = "История пользователя" .
      521                                   ii = ii + 1 .
      522                               end.
      523                       end case.
      524                   end.
      525                   hh = hh:next-sibling.
      526               end.
      527               b-help:column = v-frame-width - b-help:width-chars.
      528               jj = 0.
      529               repeat ii = 4 to 1 by -1 :
      530                   if valid-handle (v-h[ii] ) then
      531                   do:
      532                       jj  = jj + 1 .
      533                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      534                       v-h[ii]:row    = v-help-old-y .
      535                   end.
      536               end.
      537           end.
      538       end.
      539   end procedure.
      540   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      541   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      542   define variable ind AS INTEGER NO-UNDO.
      543   define variable sElement AS CHARACTER NO-UNDO.
      544   define variable sValue AS CHARACTER NO-UNDO.
      545   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      546     sElement = ENTRY(ind, pParameters, '\').
      547     IF NUM-ENTRIES(sElement, '=') = 2
      548     THEN DO:
      549       sValue   = ENTRY(2, sElement, '=').
      550       CASE ENTRY(1, sElement, '='):
      551         WHEN 'text1'         THEN do: assign FILL-IN-Text-1   = str-decode(sValue, "").             end.
      552         WHEN 'text2'         THEN do: assign FILL-IN-Text-2   = str-decode(sValue, "").             end.
      553         WHEN 'format'        THEN do: assign sFormat          = sValue.                             end.
      554         WHEN 'title'         THEN do: assign FRAME Dialog-Frame:TITLE = sValue.                    end.
      555         WHEN 'boxprog'       THEN do: assign sBoxProg         = sValue.                             end.
      556         WHEN 'editor_Row'    THEN do: assign seditor_Row      = sValue.                             end.
      557         WHEN 'editor_Col'    THEN do: assign seditor_Col      = sValue.                             end.
      558         WHEN 'editor_Height' THEN do: assign seditor_Height   = sValue.                             end.
      559         WHEN 'editor_Width'  THEN do: assign seditor_Width    = sValue.                             end.
      560         WHEN 'max-chars'     THEN do: assign sEditor_MaxChars = sValue.                             end.
      561         WHEN 'Create_Text1'  THEN do: assign sCreate_Text1    = sValue.                             end.
      562         WHEN 'readonly'      THEN do: assign v-read-only      = lookup(sValue, 'yes,true':U) > 0 .  end.
      563       END CASE.
      564     END.
      565   END.
      566   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      567   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      568   define variable hText AS WIDGET-HANDLE NO-UNDO.
      569   DO WITH FRAME Dialog-Frame
      570   :
      571     IF FILL-IN-Text-1 <> ''
      572     THEN DO:
      573       DISPLAY FILL-IN-Text-1.
      574     END.
      575     IF FILL-IN-Text-2 <> ''
      576     THEN DO:
      577       DISPLAY FILL-IN-Text-2.
      578     END.
      579   END.
      580   define variable sText1Label AS CHARACTER NO-UNDO.
      581   IF sCreate_Text1 <> ?
      582   AND NUM-ENTRIES(sCreate_Text1, ';') = 3
      583   THEN DO:
      584     sText1Label = ENTRY(3, sCreate_Text1, ';').
      585     CREATE TEXT hText
      586     ASSIGN
      587       ROW          = INTEGER(ENTRY(1, sCreate_Text1, ';'))
      588       COLUMN       = INTEGER(ENTRY(2, sCreate_Text1, ';'))
      589       FORMAT       = 'X(' + STRING(LENGTH(sText1Label)) + ')'
      590       SCREEN-VALUE = sText1Label
      591       FRAME        = hFrameHandle
      592       SENSITIVE    = FALSE
      593       VISIBLE      = TRUE
      594     .
      595   END.
      596   RUN setup-editor .
      597   MAIN-BLOCK:
      598   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      599      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      600     RUN enable_UI.
      601     run setup-box-button .
      602     run setup-cancel-button .
      603     if not v-read-only then do:
      604       hide
      605       b-file in frame Dialog-Frame .
      606     end.
      607     WAIT-FOR GO OF FRAME Dialog-Frame.
      608   END.
      609   RUN disable_UI.
      610   PROCEDURE disable_UI :
      611     HIDE FRAME Dialog-Frame.
      612   END PROCEDURE.
      613   PROCEDURE enable_UI :
      614     ENABLE Btn_OK Btn_Cancel b-file b-help EDITOR-1
      615         WITH FRAME Dialog-Frame.
      616     VIEW FRAME Dialog-Frame.
      617   END PROCEDURE.
      618   PROCEDURE proc-save-file :
      619   define variable v-file-name as character no-undo .
      620   define variable glog as logical   no-undo .
      621   assign
      622   v-file-name = "report.txt"
      623   .
      624   system-dialog get-file v-file-name
      625   ask-overwrite
      626   save-as
      627   create-test-file
      628   use-filename
      629   initial-dir '.'
      630   update glog
      631   default-extension "txt" .
      632   if glog = true
      633   then do:
      634     define variable v-err-status as integer   no-undo .
      635     copy-lob object pvalue
      636     to file v-file-name no-error .
      637     if error-status :error
      638     then do:
      639       message
      640       substitute("Не удалось вывести ТЕКСТ в файл &1&2"  +
      641                   "&3"
      642                 ,v-file-name
      643                 ,chr(10)
      644                 ,error-status:get-message(1))
      645         view-as alert-box error .
      646     end.
      647     else do:
      648       message
      649       substitute("ТЕКСТ выведен в файл &1", v-file-name)
      650       view-as alert-box information .
      651     end.
      652   end.
      653   apply 'ENTRY':u to btn_cancel in frame Dialog-Frame  .
      654   END PROCEDURE.
      655   PROCEDURE setup-box-button :
      656     DO WITH FRAME Dialog-Frame
      657     :
      658       IF sBoxProg <> ''
      659       THEN DO:
      660         ASSIGN
      661           Btn-Choose:VISIBLE      = True AND NOT v-read-only
      662           Btn-Choose:SENSITIVE    = True AND NOT v-read-only
      663         .
      664       END.
      665       if v-read-only
      666       then do:
      667         assign
      668           Btn_OK :LABEL = "&Выход"
      669         .
      670       end.
      671     END.
      672   END PROCEDURE.
      673   PROCEDURE setup-cancel-button :
      674     do with frame Dialog-Frame
      675     :
      676       if v-read-only = false
      677       then do:
      678         assign
      679           Btn_Cancel :visible   = true
      680           Btn_Cancel :sensitive = true
      681         .
      682       end.
      683       else do:
      684         assign
      685           Btn_Cancel :sensitive = false
      686           Btn_Cancel :visible   = false
      687         .
      688       end.
      689     end.
      690   END PROCEDURE.
      691   PROCEDURE setup-editor :
      692     do with frame Dialog-Frame
      693     :
      694           ASSIGN
      695           EDITOR-1:VISIBLE      = True
      696           editor-1:sensitive    = true
      697           editor-1:read-only    = v-read-only
      698           heditor = editor-1:HANDLE
      699           editor-1:screen-value = pvalue
      700           .
      701         IF FILL-IN-Text-2 = ''
      702         AND seditor_Row = ?
      703         THEN DO:
      704           seditor_Row = '2'.
      705           IF FILL-IN-Text-1 = ''
      706           THEN DO:
      707             seditor_Row = '2'.
      708           END.
      709         END.
      710         IF seditor_Height = ? THEN
      711           seditor_Height = '10'.
      712         IF seditor_Width = ? THEN
      713           seditor_Width = '98'.
      714         IF seditor_col = ?
      715         or seditor_col = ''
      716         THEN
      717           seditor_col = '1'.
      718         IF seditor_row = ?
      719         or seditor_row = ''
      720         THEN
      721           seditor_row = '2'.
      722         assign
      723         EDITOR-1:row    =  decimal(seditor_row)
      724         EDITOR-1:column =  decimal(seditor_col)
      725         EDITOR-1:Width  =  decimal(seditor_Width)
      726         EDITOR-1:height =  decimal(seditor_height)
      727         .
      728         IF  sEditor_MaxChars <> ?
      729         AND sEditor_MaxChars <> ''
      730         AND CAN-SET(EDITOR-1:HANDLE, 'MAX-CHARS')
      731         THEN DO:
      732           ASSIGN
      733             EDITOR-1:MAX-CHARS = INTEGER(sEditor_MaxChars)
      734           .
      735         END.
      736     end.
      737   END PROCEDURE.
