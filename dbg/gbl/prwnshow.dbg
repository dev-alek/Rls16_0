        1   block-level on error undo, throw.
        2   define temp-table temp-prwninfo no-undo
        3     field proc-id           as integer   format ">>>>>9"     label "Процесс"
        4     field progress-version  as character format "X(9)"       label "Версия"
        5     field progress-self     as logical   format "+/-"        label "Сам"
        6     field module-file-name  as character format "x(40)"      label "Исполняемый файл"
        7     field progress-propath  as character format "x(40)"      label "Путь поиска файлов (PROPATH)"
        8     field progress-inifile  as character format "x(40)"      label "Ini файл"
        9     field progress-curdir   as character format "x(40)"      label "Рабочая директория"
       10     field trans-active      as logical   format "+/-"        label "Транз."
       11     field cmd-line          as character format "x(160)"     label "Командная строка"
       12     field message-handle    as integer   format ">>>>>>>>9"  label "Указатель окна"
       13     field message-text      as character format "x(40)"      label "Сообщение"
       14     field proc-name         as character format "x(40)"      label "Имя программы"
       15     field proc-line         as integer   format "->>>>>>>>9" label "Строка"
       16     field r-code-name       as character format "x(40)"      label "Модуль"
       17     field db-connect-string as character format "x(40)"      label "Строка подключения"
       18     field widget-percent    as decimal   format ">>9.99%"    label "WdgUsed"
       19     field widget-num        as integer   format ">>>>>>>>9"  label "WidgNum"
       20     field max-widget-num    as integer   format ">>>>>>>>9"  label "Max widget num"
       21     index xpk is primary unique proc-id
       22     index is-self progress-self
       23   .
       24   define temp-table temp-prwnprocinfo no-undo
       25     field proc-id       as integer   format ">>>9"        label "Процесс"
       26     field proc-level    as integer   format ">>>9"        label "Уровень"
       27     field h-proc        as integer   format ">>>>>>>>>>>" label "Ук.программы"
       28     field proc-name     as character format "x(40)"       label "Имя программы"
       29     field proc-line     as integer   format "->>>>>>>>9"  label "Строка"
       30     field r-code-name   as character format "x(40)"       label "Модуль"
       31     field sub-procedure as logical
       32     field subproc-num   as integer   format ">>>>>9"
       33     index xpk is primary unique proc-id proc-level
       34   .
       35   define temp-table temp-procinfo no-undo
       36     field proc-level    as integer   format ">>>9"         label "Уровень"
       37     field h-proc        as integer   format ">>>>>>>>>>>"  label "Ук.программы"
       38     field proc-name     as character format "x(40)"        label "Имя программы"
       39     field proc-line     as integer   format "->>>>>>>>9"   label "Строка"
       40     field r-code-name   as character format "x(40)"        label "Модуль"
       41     field sub-procedure as logical
       42     field subproc-num   as integer   format ">>>>>9"
       43     index xpk is primary unique proc-level
       44   .
       45   define temp-table temp-window no-undo
       46      field window-handle       as integer   label "Handle"
       47      field window-visible      as logical   label "Visible"
       48      field window-text         as character label "Text"     format "x(20)"
       49      field window-class-atom   as integer   label "Class Atom"
       50      field window-class-name   as character label "Class Name"
       51      field window-message      as logical
       52      field window-message-text as character label "Message"  format "x(60)"
       53      field window-process-id   as integer   label "Process"
       54      field window-thread-id    as integer   label "Thread"
       55   .
       56   define temp-table temp-progress-version-info no-undo
       57      field progress-version as character
       58      field procedure-handle as character
       59      field pgc              as character
       60      field pdb-task         as character
       61      field savename         as character
       62      field the-display      as character
       63      field wic-max-id       as character
       64      index xpk is primary unique progress-version
       65   .
       66   define temp-table temp-dbg-file-header no-undo
       67     field proc-id     as integer   format ">>>9"  label "Процесс"
       68     field r-code-name as character format "x(40)" label "Модуль"
       69     field file-num    as integer   format ">>>9"  label "Номер файла"
       70     index xpk is primary unique proc-id r-code-name
       71     index x-file-num file-num
       72   .
       73   define temp-table temp-dbg-file no-undo
       74     field file-num  as integer   format ">>>9"    label "Номер файла"
       75     field line-num  as integer   format ">>>9"    label "Номер строки"
       76     field line-text as character format "x(200)" label "Строка"
       77     index xpk is primary unique file-num line-num
       78   .
       79   define temp-table temp-show-file no-undo
       80     field line-num  as integer   format ">>>9"    label "Номер строки"
       81     field line-text as character format "x(200)" label "Строка"
       82     index xpk is primary unique line-num
       83   .
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define variable v-info as character no-undo .
       89   define stream sinp .
       90   define stream sout .
       91   DEFINE BUTTON b-about
       92        LABEL "О программе"
       93        SIZE 14.5 BY 1.
       94   DEFINE BUTTON b-cur-dir
       95        LABEL "Cur Dir"
       96        SIZE 10 BY 1.
       97   DEFINE BUTTON b-cur-line
       98        LABEL "Cur Ln"
       99        SIZE 8 BY 1.
      100   DEFINE BUTTON b-debug-file
      101        LABEL "Dbg File"
      102        SIZE 11 BY 1.
      103   DEFINE BUTTON b-exit AUTO-GO
      104        LABEL "&Выход"
      105        SIZE 10 BY 1
      106        BGCOLOR 8 .
      107   DEFINE BUTTON b-export
      108        LABEL "Экспорт"
      109        SIZE 10 BY 1.
      110   DEFINE BUTTON b-propath
      111        LABEL "Propath"
      112        SIZE 10 BY 1.
      113   DEFINE BUTTON b-refresh
      114        LABEL "Обновить"
      115        SIZE 10 BY 1.
      116   DEFINE BUTTON b-terminate
      117        LABEL "Завершить"
      118        SIZE 12 BY 1.
      119   DEFINE VARIABLE fi-info AS CHARACTER FORMAT "X(256)":U
      120         VIEW-AS TEXT
      121        SIZE 92.13 BY .67 NO-UNDO.
      122   DEFINE VARIABLE t-self-view AS LOGICAL INITIAL no
      123        LABEL "Показывать процесс ~"сам~""
      124        VIEW-AS TOGGLE-BOX
      125        SIZE 27.5 BY .83 NO-UNDO.
      126   DEFINE QUERY BROWSE-1 FOR
      127         temp-prwninfo SCROLLING.
      128   DEFINE QUERY BROWSE-2 FOR
      129         temp-prwnprocinfo SCROLLING.
      130   DEFINE BROWSE BROWSE-1
      131     QUERY BROWSE-1 DISPLAY
      132         temp-prwninfo.proc-id
      133         temp-prwninfo.progress-self
      134         temp-prwninfo.progress-version
      135         temp-prwninfo.trans-active
      136         temp-prwninfo.widget-num
      137         temp-prwninfo.message-text format "X(256)" width 100
      138         temp-prwninfo.proc-line
      139         temp-prwninfo.proc-name
      140         temp-prwninfo.module-file-name
      141         temp-prwninfo.max-widget-num
      142         temp-prwninfo.progress-inifile
      143         temp-prwninfo.progress-curdir
      144         temp-prwninfo.progress-propath
      145       WITH NO-ROW-MARKERS SEPARATORS SIZE 126 BY 7.75.
      146   DEFINE BROWSE BROWSE-2
      147     QUERY BROWSE-2 DISPLAY
      148         temp-prwnprocinfo.proc-level
      149         temp-prwnprocinfo.h-proc
      150         temp-prwnprocinfo.proc-name
      151         temp-prwnprocinfo.proc-line
      152         temp-prwnprocinfo.r-code-name
      153         temp-prwnprocinfo.sub-procedure
      154         temp-prwnprocinfo.subproc-num
      155       WITH NO-ROW-MARKERS SEPARATORS SIZE 126 BY 16.46.
      156   DEFINE FRAME Dialog-Frame
      157        b-exit AT ROW 1 COL 1
      158        b-refresh AT ROW 1 COL 11
      159        b-propath AT ROW 1 COL 21
      160        b-cur-dir AT ROW 1 COL 31
      161        b-debug-file AT ROW 1 COL 41
      162        b-cur-line AT ROW 1 COL 52
      163        b-export AT ROW 1 COL 60
      164        b-terminate AT ROW 1 COL 70
      165        b-about AT ROW 1 COL 82
      166        t-self-view AT ROW 3.25 COL 2.5 WIDGET-ID 2
      167        BROWSE-1 AT ROW 4.25 COL 1
      168        BROWSE-2 AT ROW 12.29 COL 1
      169        fi-info AT ROW 2.38 COL 1.13 NO-LABEL
      170        SPACE(33.98) SKIP(25.86)
      171       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      172            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      173            TITLE "Сессии Progress"
      174            DEFAULT-BUTTON b-exit.
      175   ASSIGN
      176          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      177          FRAME Dialog-Frame:HIDDEN           = TRUE.
      178   ASSIGN
      179          BROWSE-1:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      180   ASSIGN
      181          BROWSE-2:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
      182   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      183   DO:
      184     APPLY "END-ERROR":U TO SELF.
      185   END.
      186   ON CHOOSE OF b-about IN FRAME Dialog-Frame
      187   DO:
      188     message
      189       "ProwinShow 1.0" skip
      190       "Программа просмотра процессов Progress" skip
      191       "Автор Михаил Перваков" skip
      192       "Москва, 2003-2006" skip
      193       "" skip
      194       "E-mail: kogosy@mail.ru" skip
      195       view-as alert-box information .
      196   END.
      197   ON CHOOSE OF b-cur-dir IN FRAME Dialog-Frame
      198   DO:
      199   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   if lookup(self :type
      201            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      202            ) = 0
      203   then do:
      204     message
      205       "$Workfile$"
      206       "Указанному интерфейсному элементу фокус не может быть передан" skip
      207       "Интерфейсный элемент" self :name  skip
      208       "Тип" self :type  skip
      209       "Процедура" this-procedure :file-name skip
      210       view-as alert-box .
      211   end.
      212   else do:
      213     apply "entry":u to self  .
      214     if focus :handle <> self :handle  then do:
      215       return no-apply .
      216     end.
      217   end.
      218     define variable v-current-directory as character no-undo .
      219     if available temp-prwninfo
      220     then do:
      221       if temp-prwninfo.progress-curdir = ""
      222       then do:
      223         run get-current-directory in this-procedure
      224           (input  temp-prwninfo.proc-id
      225           ,output v-current-directory
      226           ) .
      227         assign
      228           temp-prwninfo.progress-curdir = v-current-directory
      229         .
      230         display temp-prwninfo.progress-curdir with browse browse-1 .
      231       end.
      232       message
      233         "Сессия Progress 4GL" skip
      234         "Идентификатор процесса" temp-prwninfo.proc-id skip
      235         "Текущая рабочая директория" skip
      236         temp-prwninfo.progress-curdir skip
      237         view-as alert-box information .
      238     end.
      239   END.
      240   ON CHOOSE OF b-cur-line IN FRAME Dialog-Frame
      241   DO:
      242   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   if lookup(self :type
      244            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      245            ) = 0
      246   then do:
      247     message
      248       "$Workfile$"
      249       "Указанному интерфейсному элементу фокус не может быть передан" skip
      250       "Интерфейсный элемент" self :name  skip
      251       "Тип" self :type  skip
      252       "Процедура" this-procedure :file-name skip
      253       view-as alert-box .
      254   end.
      255   else do:
      256     apply "entry":u to self  .
      257     if focus :handle <> self :handle  then do:
      258       return no-apply .
      259     end.
      260   end.
      261     run generate-debug-file in this-procedure
      262       (input 'cur-line':u
      263       ).
      264   END.
      265   ON CHOOSE OF b-debug-file IN FRAME Dialog-Frame
      266   DO:
      267   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268   if lookup(self :type
      269            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      270            ) = 0
      271   then do:
      272     message
      273       "$Workfile$"
      274       "Указанному интерфейсному элементу фокус не может быть передан" skip
      275       "Интерфейсный элемент" self :name  skip
      276       "Тип" self :type  skip
      277       "Процедура" this-procedure :file-name skip
      278       view-as alert-box .
      279   end.
      280   else do:
      281     apply "entry":u to self  .
      282     if focus :handle <> self :handle  then do:
      283       return no-apply .
      284     end.
      285   end.
      286     run generate-debug-file in this-procedure
      287       (input 'debug-file':u
      288       ).
      289   END.
      290   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      291   DO:
      292   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      293   if lookup(self :type
      294            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      295            ) = 0
      296   then do:
      297     message
      298       "$Workfile$"
      299       "Указанному интерфейсному элементу фокус не может быть передан" skip
      300       "Интерфейсный элемент" self :name  skip
      301       "Тип" self :type  skip
      302       "Процедура" this-procedure :file-name skip
      303       view-as alert-box .
      304   end.
      305   else do:
      306     apply "entry":u to self  .
      307     if focus :handle <> self :handle  then do:
      308       return no-apply .
      309     end.
      310   end.
      311     run export-info in this-procedure .
      312   END.
      313   ON CHOOSE OF b-propath IN FRAME Dialog-Frame
      314   DO:
      315   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   if lookup(self :type
      317            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      318            ) = 0
      319   then do:
      320     message
      321       "$Workfile$"
      322       "Указанному интерфейсному элементу фокус не может быть передан" skip
      323       "Интерфейсный элемент" self :name  skip
      324       "Тип" self :type  skip
      325       "Процедура" this-procedure :file-name skip
      326       view-as alert-box .
      327   end.
      328   else do:
      329     apply "entry":u to self  .
      330     if focus :handle <> self :handle  then do:
      331       return no-apply .
      332     end.
      333   end.
      334     run show-propath in this-procedure .
      335   END.
      336   ON CHOOSE OF b-refresh IN FRAME Dialog-Frame
      337   DO:
      338   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   if lookup(self :type
      340            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      341            ) = 0
      342   then do:
      343     message
      344       "$Workfile$"
      345       "Указанному интерфейсному элементу фокус не может быть передан" skip
      346       "Интерфейсный элемент" self :name  skip
      347       "Тип" self :type  skip
      348       "Процедура" this-procedure :file-name skip
      349       view-as alert-box .
      350   end.
      351   else do:
      352     apply "entry":u to self  .
      353     if focus :handle <> self :handle  then do:
      354       return no-apply .
      355     end.
      356   end.
      357     run local-open-query .
      358   END.
      359   ON CHOOSE OF b-terminate IN FRAME Dialog-Frame
      360   DO:
      361     run terminate-process in this-procedure .
      362   END.
      363   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      364   DO:
      365     run show-propath in this-procedure .
      366   END.
      367   ON VALUE-CHANGED OF BROWSE-1 IN FRAME Dialog-Frame
      368   DO:
      369     run local-open-query-prwnprocinfo in this-procedure .
      370   END.
      371   ON DEFAULT-ACTION OF BROWSE-2 IN FRAME Dialog-Frame
      372   DO:
      373     run generate-debug-file in this-procedure
      374       (input 'cur-line':u
      375       ).
      376   END.
      377   ON VALUE-CHANGED OF t-self-view IN FRAME Dialog-Frame
      378   DO:
      379     run local-open-query .
      380   END.
      381   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      382   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      383   define variable v-ok as logical   no-undo .
      384   assign
      385     v-ok = BROWSE-1 :set-repositioned-row(5, 'CONDITIONAL':u)
      386     v-ok = browse-2 :set-repositioned-row(5, 'CONDITIONAL':u)
      387   .
      388   MAIN-BLOCK:
      389   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      390      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      391   :
      392     RUN enable_UI.
      393     assign
      394     temp-prwninfo.progress-version:resizable in browse browse-1 = yes
      395     temp-prwninfo.message-text:resizable     in browse browse-1 = yes
      396     .
      397     WAIT-FOR GO OF FRAME Dialog-Frame.
      398   END.
      399   RUN disable_UI.
      400   PROCEDURE disable_UI :
      401     HIDE FRAME Dialog-Frame.
      402   END PROCEDURE.
      403   PROCEDURE enable_UI :
      404     DISPLAY t-self-view fi-info
      405         WITH FRAME Dialog-Frame.
      406     ENABLE b-exit b-refresh b-propath b-cur-dir b-debug-file b-cur-line b-export
      407            b-terminate b-about t-self-view BROWSE-1 BROWSE-2 fi-info
      408         WITH FRAME Dialog-Frame.
      409     VIEW FRAME Dialog-Frame.
      410     run local-open-query in this-procedure .    run local-open-query-prwnprocinfo in this-procedure .
      411   END PROCEDURE.
      412   PROCEDURE export-info :
      413     define variable v-command-line as character no-undo .
      414     define variable v-num          as integer   no-undo .
      415     define variable v-info-type    as character no-undo .
      416     do
      417     on error undo, return error return-value
      418     :
      419       run gbl/d-askw.w
      420         (input "Вопрос"
      421         ,input "Произвести сбор отладочной информации "
      422         + "и вывод информации в текстовый файл." + chr(10)
      423         + "В любом из режимов не будет производится сбор личной информации." + chr(10)
      424         + "По завершении экспорта в текстовый файл его можно будет просмотреть, "
      425         + "при необходимости удалить лишнюю информацию, "
      426         + "отправить в службу поддержки для определения причины ошибки"
      427         ,input '|^':u
      428         ,input "Краткая"
      429         + '|':u + "Подробная"
      430         + '|':u + "Отказ"
      431         ,input "Собрать минимальное количество информации"
      432             + "|":u + "Собрать максимально подробную информацию "
      433                     + "(запущенные сервисы, программы, установленные программы, "
      434                     + "установленные обновления, сообщения об ошибках из журнала)"
      435             + "|":u
      436         ,input 1
      437         ,input 3
      438         ,output v-num
      439         ).
      440       case v-num
      441       :
      442         when 1
      443         then do:
      444           assign
      445             v-info-type = 'common':u
      446           .
      447         end.
      448         when 2
      449         then do:
      450           assign
      451             v-info-type = 'detail':u
      452           .
      453         end.
      454         when 3
      455         then do:
      456           return .
      457         end.
      458       end case .
      459       define variable v-error-log-file-name as character no-undo .
      460       run gbl/_tmpfile.p
      461         (input "pwn"
      462         ,input ".txt"
      463         ,output v-error-log-file-name
      464         ).
      465       output stream sout to value(v-error-log-file-name) .
      466       define buffer buf_temp-prwninfo for temp-prwninfo .
      467       define buffer buf_temp-prwnprocinfo for temp-prwnprocinfo .
      468       put stream sout unformatted 'ProwinShow 1.0':u + chr(10) .
      469       put stream sout unformatted v-info + chr(10) .
      470       if  available temp-prwninfo
      471       and temp-prwninfo.message-text <> ''
      472       then do:
      473         put stream sout unformatted chr(10) .
      474         put stream sout unformatted chr(10) .
      475         put stream sout unformatted fill('#':u, 80) + chr(10).
      476         put stream sout unformatted substitute("Идентификатор процесса (PID) : &1&2"
      477                                               ,temp-prwninfo.proc-id
      478                                               ,chr(10)
      479                                               ).
      480         put stream sout unformatted substitute('Сообщение                    : &1&2':u
      481                                               ,temp-prwninfo.message-text
      482                                               ,chr(10)
      483                                               ) .
      484         put stream sout unformatted substitute('Процедура                    : &1&2':u
      485                                               ,temp-prwninfo.proc-name
      486                                               ,chr(10)
      487                                               ) .
      488         put stream sout unformatted substitute('Номер строки                 : &1&2':u
      489                                               ,temp-prwninfo.proc-line
      490                                               ,chr(10)
      491                                               ) .
      492         put stream sout unformatted substitute('Файл                         : &1&2':u
      493                                               ,temp-prwninfo.r-code-name
      494                                               ,chr(10)
      495                                               ) .
      496       end.
      497       put stream sout unformatted chr(10) .
      498       for each buf_temp-prwninfo
      499       on error undo, return error return-value
      500       :
      501         put stream sout unformatted chr(10) .
      502         put stream sout unformatted chr(10) .
      503         put stream sout unformatted fill('#':u, 80) + chr(10).
      504         put stream sout unformatted substitute("Идентификатор процесса (PID)            : &1&2"
      505                                               ,buf_temp-prwninfo.proc-id
      506                                               ,chr(10)
      507                                               ).
      508         put stream sout unformatted substitute("Версия Progress                         : &1&2"
      509                                               ,buf_temp-prwninfo.progress-version
      510                                               ,chr(10)
      511                                               ).
      512         put stream sout unformatted substitute("Текущий процесс ProwinShow              : &1&2"
      513                                               ,string(buf_temp-prwninfo.progress-self, "да/нет")
      514                                               ,chr(10)
      515                                               ).
      516         put stream sout unformatted substitute("Исполняемый файл                        : &1&2"
      517                                               ,buf_temp-prwninfo.module-file-name
      518                                               ,chr(10)
      519                                               ).
      520         define variable v-index                as integer   no-undo .
      521         define variable v-num-entries-propath as integer   no-undo .
      522         assign
      523           v-num-entries-propath = num-entries(buf_temp-prwninfo.progress-propath)
      524         .
      525         put stream sout unformatted substitute("Путь поиска файлов Progress (PROPATH)   : &1&2"
      526                                               ,entry(1, buf_temp-prwninfo.progress-propath)
      527                                               ,chr(10)
      528                                               ).
      529         do v-index = 2 to v-num-entries-propath
      530         :
      531           put stream sout unformatted substitute("                                          &1&2"
      532                                                 ,entry(v-index, buf_temp-prwninfo.progress-propath)
      533                                                 ,chr(10)
      534                                                 ).
      535         end.
      536         put stream sout unformatted substitute("Файл конфигурации Progress (*.ini файл) : &1&2"
      537                                               ,buf_temp-prwninfo.progress-inifile
      538                                               ,chr(10)
      539                                               ).
      540         put stream sout unformatted substitute("Рабочая папка                           : &1&2"
      541                                               ,buf_temp-prwninfo.progress-curdir
      542                                               ,chr(10)
      543                                               ).
      544         put stream sout unformatted substitute("Транзакция активна                      : &1&2"
      545                                               ,string(buf_temp-prwninfo.trans-active, "да/нет")
      546                                               ,chr(10)
      547                                               ).
      548         put stream sout unformatted substitute("Указатель окна                          : &1&2"
      549                                               ,buf_temp-prwninfo.message-handle
      550                                               ,chr(10)
      551                                               ).
      552         put stream sout unformatted substitute("Сообщение                               : &1&2"
      553                                               ,buf_temp-prwninfo.message-text
      554                                               ,chr(10)
      555                                               ).
      556         put stream sout unformatted substitute("Имя процедуры                           : &1&2"
      557                                               ,buf_temp-prwninfo.proc-name
      558                                               ,chr(10)
      559                                               ).
      560         put stream sout unformatted substitute("Номер строки                            : &1&2"
      561                                               ,buf_temp-prwninfo.proc-line
      562                                               ,chr(10)
      563                                               ).
      564         put stream sout unformatted substitute("Исполняемый файл                        : &1&2"
      565                                               ,buf_temp-prwninfo.r-code-name
      566                                               ,chr(10)
      567                                               ).
      568         put stream sout unformatted substitute("Строка подключения к БД                 : &1&2"
      569                                               ,buf_temp-prwninfo.db-connect-string
      570                                               ,chr(10)
      571                                               ).
      572         put stream sout unformatted substitute("Количество интерфейсных элементов       : &1&2"
      573                                               ,buf_temp-prwninfo.widget-num
      574                                               ,chr(10)
      575                                               ).
      576         put stream sout unformatted chr(10) .
      577         put stream sout unformatted "Стек вызова процедур" + chr(10).
      578         put stream sout unformatted "Порядок Имя процедуры                          Номер строки   Исполняемый файл" + chr(10).
      579         put stream sout unformatted fill('-':u, 80) + chr(10).
      580         for each buf_temp-prwnprocinfo
      581           where buf_temp-prwnprocinfo.proc-id = buf_temp-prwninfo.proc-id
      582         on error undo, return error return-value
      583         :
      584           put stream sout unformatted substitute(' &1 &2 &3       &4&5':u
      585                                                 ,string(buf_temp-prwnprocinfo.proc-level, '>>,>>9':u)
      586                                                 ,string(buf_temp-prwnprocinfo.proc-name, 'x(40)':u)
      587                                                 ,string(buf_temp-prwnprocinfo.proc-line, '>>,>>9':u)
      588                                                 ,string(buf_temp-prwnprocinfo.r-code-name, 'x(40)':u)
      589                                                 ,chr(10)
      590                                                 ).
      591         end.
      592         put stream sout unformatted fill('-':u, 80) + chr(10).
      593       end.
      594       put stream sout unformatted chr(10).
      595       put stream sout unformatted fill('#':u, 80) + chr(10).
      596       put stream sout unformatted substitute("Информация о компьютере и процессах Progress. Дата &1. Время &2.", string(today, '99/99/9999':u), string(time, 'HH:MM:SS':u)) + chr(10) .
      597       output stream sout close .
      598       define variable v-compinfo-filename as character no-undo .
      599       assign
      600         v-compinfo-filename = search('exe/compinfo.bat':u)
      601       .
      602       if  v-compinfo-filename = ""
      603       and v-compinfo-filename = ?
      604       then do:
      605         message
      606           "Не найден файл определения информации о компьютере" 'exe/compinfo.bat':u skip
      607           "Сбор информации об ошибке будет продолжен" skip
      608           view-as alert-box information  .
      609       end.
      610       else do:
      611         define variable v-full-path        as character no-undo .
      612         define variable v-path             as character no-undo .
      613         define variable v-file-name        as character no-undo .
      614         define variable v-file-name-no-ext as character no-undo .
      615         define variable v-file-name-ext    as character no-undo .
      616         run gbl/filename.p
      617           (input  v-compinfo-filename
      618           ,output v-full-path
      619           ,output v-path
      620           ,output v-file-name
      621           ,output v-file-name-no-ext
      622           ,output v-file-name-ext
      623           ) .
      624         assign
      625           v-command-line =  substitute("&1 &2 &3 &4"
      626                                       ,v-compinfo-filename
      627                                       ,v-path
      628                                       ,v-error-log-file-name
      629                                       ,v-info-type
      630                                       )
      631         .
      632         os-command value(v-command-line).
      633       end.
      634       define variable v-procinfo-filename as character no-undo .
      635       assign
      636         v-procinfo-filename = search('exe/procinfo.bat':u)
      637       .
      638       if  v-procinfo-filename = ""
      639       and v-procinfo-filename = ?
      640       then do:
      641         message
      642           "Не найден файл определения информации о процессе" 'exe/procinfo.bat':u skip
      643           "Сбор информации об ошибке будет продолжен" skip
      644           view-as alert-box information  .
      645       end.
      646       else do:
      647         run gbl/filename.p
      648           (input  v-procinfo-filename
      649           ,output v-full-path
      650           ,output v-path
      651           ,output v-file-name
      652           ,output v-file-name-no-ext
      653           ,output v-file-name-ext
      654           ) .
      655         for each buf_temp-prwninfo
      656         on error undo, return error return-value
      657         :
      658           assign
      659             v-command-line =  substitute("&1 &2 &3 &4"
      660                                         ,v-procinfo-filename
      661                                         ,v-path
      662                                         ,buf_temp-prwninfo.proc-id
      663                                         ,v-error-log-file-name
      664                                         )
      665           .
      666           os-command value(v-command-line).
      667         end.
      668       end.
      669       output stream sout to value(v-error-log-file-name) append .
      670       put stream sout unformatted fill('#':u, 80) + chr(10) .
      671       put stream sout unformatted '>>> EOF <<<':u + chr(10) .
      672       output stream sout close .
      673       os-command no-wait value ('start notepad ' + v-error-log-file-name).
      674     end.
      675   END PROCEDURE.
      676   PROCEDURE generate-debug-file :
      677     define input  parameter p-show-type as character no-undo .
      678     define variable v-current-directory as character no-undo .
      679     if  available temp-prwninfo
      680     and available temp-prwnprocinfo
      681     then do:
      682       find first temp-dbg-file-header
      683         where temp-dbg-file-header.proc-id     = temp-prwninfo.proc-id
      684           and temp-dbg-file-header.r-code-name = temp-prwnprocinfo.r-code-name
      685         no-error .
      686       if not available temp-dbg-file-header
      687       then do:
      688         if temp-prwninfo.progress-curdir = ""
      689         then do:
      690           run get-current-directory in this-procedure
      691             (input  temp-prwninfo.proc-id
      692             ,output v-current-directory
      693             ) .
      694           assign
      695             temp-prwninfo.progress-curdir = v-current-directory
      696           .
      697           display temp-prwninfo.progress-curdir with browse browse-1 .
      698         end.
      699         define variable v-connect-string as character no-undo .
      700         assign
      701           v-connect-string = temp-prwninfo.db-connect-string
      702         .
      703         run gbl/getinist.p
      704           (input  temp-prwninfo.progress-inifile
      705           ,input  "rep-sets"
      706           ,input  "conpar"
      707           ,output v-connect-string
      708           ) .
      709         define variable v-new-connect-string as character no-undo .
      710         if v-connect-string = ?
      711         then do:
      712           assign
      713             v-new-connect-string = ""
      714           .
      715         end.
      716         else do:
      717           if index(v-connect-string, '&1':u) > 0
      718           then do:
      719             assign
      720               v-new-connect-string = substitute(v-connect-string, '-U sysadm -P &1':u)
      721             .
      722           end.
      723           else do:
      724             assign
      725               v-new-connect-string = v-connect-string + ' -U sysadm -P &1':u
      726             .
      727           end.
      728         end.
      729         run gbl/d-prompt.w
      730           ( 'title=':u + "Параметры подключения к базе данных" + '\':u
      731           + 'text1=':u + "Отредактируйте строку подключения к базе данных" + '\':u
      732           + 'text2=':u + "или нажмите Отмену, чтобы не подключаться к базе" + '\':u
      733           + 'format=X(128)\':u
      734           + 'fillin_width=60\':u
      735           + 'type=char\':u
      736           ,input-output v-new-connect-string
      737           ).
      738         if return-value = 'false':u
      739         then do:
      740           assign
      741             v-connect-string = ""
      742           .
      743         end.
      744         else do:
      745           assign
      746             v-connect-string = v-new-connect-string
      747           .
      748         end.
      749         if index(v-connect-string, "&1") > 0
      750         then do:
      751           define variable v-sysadm-passwd as character no-undo .
      752           run gbl/d-prompt.w
      753             ( 'title=':u + "Введите пароль sysadm для базы данных" + '\':u
      754             + 'text1=':u + "Введите пароль sysadm для базы данных" + '\':u
      755             + 'text1=':u + "или нажмите Отмену, чтобы не подключаться к базе" + '\':u
      756             + 'format=X(12)\':u
      757             + 'type=char\':u
      758             + 'blank=yes\':u
      759             ,input-output v-sysadm-passwd
      760             ).
      761           if return-value = 'false':u
      762           then do:
      763             assign
      764               v-connect-string = ""
      765             .
      766           end.
      767           else do:
      768             assign
      769               v-connect-string = substitute(v-connect-string, v-sysadm-passwd)
      770             .
      771           end.
      772         end.
      773         assign
      774           temp-prwninfo.db-connect-string = v-connect-string
      775         .
      776         define variable v-dbg-file       as character no-undo .
      777         run gbl/comp_dbg.p
      778           (input  temp-prwninfo.module-file-name
      779           ,input  temp-prwninfo.progress-curdir
      780           ,input  temp-prwninfo.progress-inifile
      781           ,input  temp-prwninfo.progress-propath
      782           ,input  temp-prwnprocinfo.r-code-name
      783           ,input  temp-prwnprocinfo.proc-line
      784           ,input  temp-prwninfo.db-connect-string
      785           ,output v-dbg-file
      786           ) .
      787         if search(v-dbg-file) = ""
      788         or search(v-dbg-file) = ?
      789         then do:
      790           message
      791             "Ошибка создания *.dbg файла" skip
      792             view-as alert-box error .
      793           undo, return error return-value  .
      794         end.
      795         define variable v-file-num as integer   no-undo .
      796         find last temp-dbg-file-header
      797           use-index x-file-num
      798           no-error .
      799         if available temp-dbg-file-header
      800         then do:
      801           assign
      802             v-file-num = temp-dbg-file-header.file-num + 1
      803           .
      804         end.
      805         else do:
      806           assign
      807             v-file-num = 1
      808           .
      809         end.
      810         create temp-dbg-file-header .
      811         assign
      812           temp-dbg-file-header.proc-id     = temp-prwninfo.proc-id
      813           temp-dbg-file-header.r-code-name = temp-prwnprocinfo.r-code-name
      814           temp-dbg-file-header.file-num    = v-file-num
      815         .
      816         define variable v-line-text as character no-undo .
      817         define variable v-line-num as integer   no-undo .
      818         assign
      819           v-line-num = 0
      820         .
      821         input stream sinp from value(v-dbg-file) .
      822         repeat
      823         :
      824           assign
      825             v-line-text = ""
      826           .
      827           import stream sinp unformatted
      828             v-line-text
      829             .
      830           assign
      831             v-line-num = v-line-num + 1
      832           .
      833           create temp-dbg-file .
      834           assign
      835             temp-dbg-file.file-num  = v-file-num
      836             temp-dbg-file.line-num  = v-line-num
      837             temp-dbg-file.line-text = v-line-text
      838           .
      839         end.
      840         input stream sinp close .
      841         os-delete value(v-dbg-file) .
      842       end.
      843       find first temp-dbg-file-header
      844         where temp-dbg-file-header.proc-id     = temp-prwninfo.proc-id
      845           and temp-dbg-file-header.r-code-name = temp-prwnprocinfo.r-code-name
      846         no-error .
      847       if available temp-dbg-file-header
      848       then do:
      849         case p-show-type :
      850           when 'cur-line':u
      851           then do:
      852             define variable v-program-text as character no-undo .
      853             assign
      854               v-program-text = ""
      855             .
      856             for each temp-dbg-file
      857               where temp-dbg-file.file-num = temp-dbg-file-header.file-num
      858                 and temp-dbg-file.line-num >= temp-prwnprocinfo.proc-line - 10
      859                 and temp-dbg-file.line-num <= temp-prwnprocinfo.proc-line + 10
      860             :
      861               assign
      862                 v-program-text = v-program-text
      863                                 + (if temp-dbg-file.line-num = temp-prwnprocinfo.proc-line
      864                                   then "##>"
      865                                   else "   "
      866                                   )
      867                                 + temp-dbg-file.line-text
      868                                 + chr(10)
      869               .
      870             end.
      871             run gbl/d-prompt.w
      872               (input 'title=Текущая выполняемая строка\'
      873                 + 'type=editor\'
      874                 + 'fillin_width=96\'
      875                 + 'fillin_height=17\'
      876                 + 'readonly=yes\'
      877               , input-output v-program-text
      878               ).
      879           end.
      880           when 'debug-file':u
      881           then do:
      882             for each temp-show-file
      883             :
      884               delete temp-show-file .
      885             end.
      886             for each temp-dbg-file
      887               where temp-dbg-file.file-num = temp-dbg-file-header.file-num
      888             :
      889               create temp-show-file .
      890               assign
      891                 temp-show-file.line-num  = temp-dbg-file.line-num
      892                 temp-show-file.line-text = temp-dbg-file.line-text
      893               .
      894             end.
      895             run gbl/show_dbg.w
      896               (input table temp-show-file
      897               ,input  temp-prwnprocinfo.proc-line
      898               ) .
      899           end.
      900           otherwise do:
      901             message
      902               "Внутренняя ошибка" skip
      903               "Неизвестное значение переменной p-show-type" skip
      904               "p-show-type" p-show-type skip
      905               view-as alert-box error .
      906           end.
      907         end case .
      908       end.
      909       else do:
      910         message
      911           "Ошибка при создании *.dbg файла"
      912           view-as alert-box error .
      913       end.
      914     end.
      915   END PROCEDURE.
      916   PROCEDURE get-current-directory :
      917     define input  parameter p-process-id        as integer   no-undo .
      918     define output parameter p-current-directory as character no-undo .
      919     define variable v-getcurdr-filename as character no-undo .
      920     define variable v-output-filename   as character no-undo .
      921     define variable v-command-line      as character no-undo .
      922     do
      923     on error undo, return error return-value
      924     :
      925       assign
      926         v-getcurdr-filename = search("exe/getcurdr.bat")
      927       .
      928       if  v-getcurdr-filename = ""
      929       and v-getcurdr-filename = ?
      930       then do:
      931         message
      932           "Не найден файл программы определения текущей директории" skip
      933           "exe/getcurdr.bat" skip
      934           view-as alert-box information  .
      935       end.
      936       else do:
      937         define variable v-full-path        as character no-undo .
      938         define variable v-path             as character no-undo .
      939         define variable v-file-name        as character no-undo .
      940         define variable v-file-name-no-ext as character no-undo .
      941         define variable v-file-name-ext    as character no-undo .
      942         run gbl/filename.p
      943           (input  v-getcurdr-filename
      944           ,output v-full-path
      945           ,output v-path
      946           ,output v-file-name
      947           ,output v-file-name-no-ext
      948           ,output v-file-name-ext
      949           ) .
      950         run gbl/_tmpfile.p
      951           (input  "err"
      952           ,input  ".txt"
      953           ,output v-output-filename
      954           ).
      955         output stream sout to value(v-output-filename).
      956         put stream sout unformatted "ERROR" skip .
      957         output stream sout close .
      958         assign
      959           file-info :file-name = v-output-filename
      960           v-output-filename = file-info :full-pathname
      961         .
      962         assign
      963           v-command-line = substitute("&1 &2 &3 &4"
      964             ,v-getcurdr-filename
      965             ,v-path
      966             ,p-process-id
      967             ,v-output-filename
      968             )
      969         .
      970         os-command value(v-command-line).
      971         assign
      972           p-current-directory = ""
      973         .
      974         input stream sout from value(v-output-filename) .
      975         repeat :
      976           import stream sout unformatted p-current-directory .
      977         end.
      978         input stream sout close .
      979         os-delete value(v-output-filename) .
      980         if p-current-directory = "ERROR"
      981         then do:
      982           message
      983             "Ошибка при определении текущей директории программы" skip
      984             view-as alert-box error .
      985           assign
      986             p-current-directory = ""
      987           .
      988         end.
      989       end.
      990     end.
      991   END PROCEDURE.
      992   PROCEDURE local-open-query :
      993     assign
      994       v-info = substitute("Информация о сессиях Progress. Дата &1. Время &2.", string(today, '99/99/9999':u), string(time, 'HH:MM:SS':u))
      995     .
      996     do with frame Dialog-Frame:
      997       assign
      998         fi-info :screen-value = v-info
      999       .
     1000       assign
     1001         t-self-view
     1002       .
     1003     end.
     1004     run gbl/prwninfo.p
     1005       (output table temp-prwninfo
     1006       ,output table temp-prwnprocinfo
     1007       ) .
     1008     if t-self-view = true then do:
     1009       OPEN QUERY BROWSE-1 FOR EACH temp-prwninfo .
     1010     end.
     1011     else do:
     1012       OPEN QUERY BROWSE-1 FOR EACH temp-prwninfo where temp-prwninfo.progress-self = false .
     1013     end.
     1014     define variable v-rowid as rowid no-undo .
     1015     define buffer buf_temp-prwninfo for temp-prwninfo .
     1016     find first buf_temp-prwninfo
     1017       where buf_temp-prwninfo.message-text <> ""
     1018       no-error .
     1019     if available buf_temp-prwninfo
     1020     then do:
     1021       assign
     1022         v-rowid = rowid(buf_temp-prwninfo)
     1023       .
     1024       reposition BROWSE-1 to rowid v-rowid .
     1025     end.
     1026     run local-open-query-prwnprocinfo in this-procedure .
     1027     do with frame Dialog-Frame:
     1028       apply 'entry':u to browse BROWSE-1 .
     1029     end.
     1030   END PROCEDURE.
     1031   PROCEDURE local-open-query-prwnprocinfo :
     1032     if available temp-prwninfo
     1033     then do:
     1034       open query browse-2 for each temp-prwnprocinfo
     1035         where temp-prwnprocinfo.proc-id = temp-prwninfo.proc-id
     1036         by temp-prwnprocinfo.proc-level descending .
     1037     end.
     1038     else do:
     1039       open query browse-2 for each temp-prwnprocinfo where false .
     1040     end.
     1041   END PROCEDURE.
     1042   PROCEDURE show-propath :
     1043     if available temp-prwninfo
     1044     then do:
     1045       message
     1046         "Сессия Progress 4GL" skip
     1047         "Номер процесса" temp-prwninfo.proc-id skip
     1048         "Версия Progress" temp-prwninfo.progress-version skip
     1049         "Транзакция" (if temp-prwninfo.trans-active then "АКТИВНА" else "не активна") skip
     1050         "Ini файл" skip
     1051         temp-prwninfo.progress-inifile skip
     1052         "Propath" skip
     1053         temp-prwninfo.progress-propath skip
     1054         view-as alert-box information .
     1055     end.
     1056   END PROCEDURE.
     1057   PROCEDURE terminate-process :
     1058     if available temp-prwninfo
     1059     then do:
     1060       define variable v-ok as logical   no-undo .
     1061       message
     1062         substitute("Процесс с номером &1 будет завершен."
     1063                   ,temp-prwninfo.proc-id
     1064                   ) skip
     1065         "Продолжить?" skip
     1066         view-as alert-box question buttons yes-no update v-ok .
     1067       if v-ok <> true
     1068       then do:
     1069         return .
     1070       end.
     1071       run gbl/termprc.p
     1072         (input temp-prwninfo.proc-id
     1073         ) .
     1074       run local-open-query .
     1075     end.
     1076   END PROCEDURE.
