        1   block-level on error undo, throw.
        2   define input  parameter p-action    as character no-undo .
        3   define input  parameter p-prog-name as character no-undo .
        4   define input  parameter p-param1    as character no-undo .
        5   define input  parameter p-param2    as character no-undo .
        6   define input  parameter p-param3    as character no-undo .
        7   define output parameter p-ret-value as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: extprog.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/extprog.p $":U .
       13   define variable vss-description as character no-undo init "Процедура запуска внешних программ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   function prepare-path returns character ( input p-nonprepared-path as character ):
       74   define variable v-prepared-path as character no-undo .
       75   assign
       76   v-prepared-path = replace(p-nonprepared-path, chr(92), chr(47))
       77   v-prepared-path = right-trim(v-prepared-path, chr(47))
       78   .
       79   return v-prepared-path.
       80   END FUNCTION.
       81   function prepare-path2 returns character ( input p-nonprepared-path as character ):
       82   define variable v-prepared-path as character no-undo .
       83   assign
       84   v-prepared-path = replace(p-nonprepared-path, chr(47), chr(92))
       85   v-prepared-path = right-trim(v-prepared-path, chr(92))
       86   .
       87   return v-prepared-path.
       88   END FUNCTION.
       89   function quote-spaces returns character ( input p-full-path as character):
       90   define variable v-ii as integer no-undo .
       91   define variable v-result as character no-undo .
       92   do v-ii = 1 to num-entries(p-full-path, chr(92)):
       93     v-result = v-result + (if v-ii = 1 then '' else chr(92)) +
       94                (if index(entry(v-ii, p-full-path, chr(92)), chr(32)) > 0
       95                then  substitute("&1&2&1", chr(34), entry(v-ii, p-full-path, chr(92)))
       96                else entry(v-ii, p-full-path, chr(92))
       97                )
       98     .
       99   end.
      100   return v-result.
      101   end function.
      102   define stream slog .
      103   do
      104   on error undo, return error return-value
      105   :
      106     if p-action = 'exec':U
      107     then do:
      108       case p-prog-name :
      109         when 'rptview':U
      110         then do:
      111           run exec-rptview in this-procedure
      112             (input p-param1
      113             ) .
      114         end.
      115         when 'altprn':U
      116         then do:
      117           run exec-altprn in this-procedure
      118             (input p-param1
      119             ) .
      120         end.
      121         when 'txt2pdf':U
      122         then do:
      123           run exec-txt2pdf in this-procedure
      124             (input p-param1
      125             ,input p-param2
      126             ,input p-param3
      127             ) .
      128         end.
      129         otherwise do:
      130           message
      131             vss-workfile vss-revision vss-description skip
      132             "Ошибка задания входных параметров" skip
      133             view-as alert-box error .
      134           undo, return error .
      135         end.
      136       end.
      137     end.
      138     else do:
      139       message
      140         vss-workfile vss-revision vss-description skip
      141         "Ошибка задания входных параметров" skip
      142         view-as alert-box error .
      143       undo, return error .
      144     end.
      145   end.
      146   procedure exec-rptview :
      147     do
      148     on error undo, return error
      149     :
      150       define input parameter p-file-name as character no-undo .
      151       define variable v-report-full-path        as character no-undo .
      152       define variable v-report-path             as character no-undo .
      153       define variable v-report-file-name        as character no-undo .
      154       define variable v-report-file-name-no-ext as character no-undo .
      155       define variable v-report-file-name-ext    as character no-undo .
      156       run gbl/filename.p
      157         (input  p-file-name
      158         ,output v-report-full-path
      159         ,output v-report-path
      160         ,output v-report-file-name
      161         ,output v-report-file-name-no-ext
      162         ,output v-report-file-name-ext
      163         ) no-error .
      164       if error-status :error
      165       then do:
      166         message
      167           "Ошибка задания входных параметров" skip
      168           "Не найден файл" p-file-name skip
      169           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      170           "и откроете файл в текстовом редакторе" skip
      171           error-status :get-message(1) skip
      172           return-value skip
      173           view-as alert-box error.
      174         undo, return error .
      175       end.
      176       define variable v-rpt-view-full-path        as character no-undo .
      177       define variable v-rpt-view-path             as character no-undo .
      178       define variable v-rpt-view-file-name        as character no-undo .
      179       define variable v-rpt-view-file-name-no-ext as character no-undo .
      180       define variable v-rpt-view-file-name-ext    as character no-undo .
      181       run gbl/filename.p
      182         (input  "exe/rpt-view.bat"
      183         ,output v-rpt-view-full-path
      184         ,output v-rpt-view-path
      185         ,output v-rpt-view-file-name
      186         ,output v-rpt-view-file-name-no-ext
      187         ,output v-rpt-view-file-name-ext
      188         ) no-error .
      189       if error-status :error
      190       then do:
      191         message
      192           "Невозможен просмотр отчета на экране" skip
      193           "Не найден файл rpt-view.bat" skip
      194           "Обратитесь к системному администратору" skip
      195           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      196           "и откроете файл в текстовом редакторе" skip
      197           error-status :get-message(1) skip
      198           return-value skip
      199           view-as alert-box error.
      200         undo, return error .
      201       end.
      202       define variable v-temp-report-name as character no-undo .
      203       run gbl/_tmpfile.p
      204         (input  "r":u
      205         ,input  ".tmp":u
      206         ,output v-temp-report-name
      207         ) .
      208       output stream slog to value(v-temp-report-name) .
      209       output close .
      210       define variable v-delete-full-path        as character no-undo .
      211       define variable v-delete-path             as character no-undo .
      212       define variable v-delete-file-name        as character no-undo .
      213       define variable v-delete-file-name-no-ext as character no-undo .
      214       define variable v-delete-file-name-ext    as character no-undo .
      215       run gbl/filename.p
      216         (input  v-temp-report-name
      217         ,output v-delete-full-path
      218         ,output v-delete-path
      219         ,output v-delete-file-name
      220         ,output v-delete-file-name-no-ext
      221         ,output v-delete-file-name-ext
      222         ) no-error .
      223       if error-status :error
      224       then do:
      225         message
      226           "Невозможен просмотр отчета на экране" skip
      227           "Не найден файл rpt-view.bat" skip
      228           "Обратитесь к системному администратору" skip
      229           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      230           "и откроете файл в текстовом редакторе" skip
      231           error-status :get-message(1) skip
      232           return-value skip
      233           view-as alert-box error.
      234         undo, return error .
      235       end.
      236       if index(chr(32), v-rpt-view-full-path) > 0
      237       or index(chr(32), v-report-full-path) > 0
      238       or index(chr(32), v-temp-report-name) > 0
      239       or index(chr(32), v-rpt-view-path) > 0
      240       or index(chr(32), v-delete-path) > 0
      241       then do:
      242         message
      243           "В имени файлов и директорий не должны содержаться пробелы" skip
      244           "Необходимо проверить текущие настройки системы" skip
      245           "Обратитесь к системному администратору" skip
      246           "Полное имя файла отчета" v-rpt-view-full-path skip
      247           "Путь к отчету" v-report-full-path skip
      248           "Временный файл для просмотра на экране" v-temp-report-name skip
      249           "Путь к программе просмотра на экране" v-rpt-view-path skip
      250           "Путь к временным файлам" v-delete-path skip
      251           view-as alert-box error .
      252         undo, return error .
      253       end.
      254       define variable v-command-string as character no-undo .
      255       assign
      256         v-command-string = v-rpt-view-full-path
      257           + chr(32) + v-report-full-path
      258           + chr(32) + v-temp-report-name
      259           + chr(32) + v-rpt-view-path
      260           + chr(32) + v-delete-path
      261       .
      262       run gbl/open_url.p
      263         (input ' /min ':u + v-command-string
      264         ) .
      265     end.
      266   end procedure.
      267   procedure exec-altprn :
      268     do
      269     on error undo, return error
      270     :
      271       define input parameter p-file-name as character no-undo .
      272       define variable v-temp-report-name as character no-undo .
      273       define variable v-report-full-path        as character no-undo .
      274       define variable v-report-path             as character no-undo .
      275       define variable v-report-file-name        as character no-undo .
      276       define variable v-report-file-name-no-ext as character no-undo .
      277       define variable v-report-file-name-ext    as character no-undo .
      278       run gbl/filename.p
      279         (input  p-file-name
      280         ,output v-report-full-path
      281         ,output v-report-path
      282         ,output v-report-file-name
      283         ,output v-report-file-name-no-ext
      284         ,output v-report-file-name-ext
      285         ) no-error .
      286       if error-status :error
      287       then do:
      288         message
      289           "Ошибка задания входных параметров" skip
      290           "Не найден файл" p-file-name skip
      291           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      292           "и откроете файл в текстовом редакторе" skip
      293           error-status :get-message(1) skip
      294           return-value skip
      295           view-as alert-box error.
      296         undo, return error .
      297       end.
      298       define variable v-alt-prn-full-path        as character no-undo .
      299       define variable v-alt-prn-path             as character no-undo .
      300       define variable v-alt-prn-file-name        as character no-undo .
      301       define variable v-alt-prn-file-name-no-ext as character no-undo .
      302       define variable v-alt-prn-file-name-ext    as character no-undo .
      303       run gbl/filename.p
      304         (input  "exe/alt-prn.bat"
      305         ,output v-alt-prn-full-path
      306         ,output v-alt-prn-path
      307         ,output v-alt-prn-file-name
      308         ,output v-alt-prn-file-name-no-ext
      309         ,output v-alt-prn-file-name-ext
      310         ) no-error .
      311       if error-status :error
      312       then do:
      313         message
      314           "Невозможен просмотр отчета на экране" skip
      315           "Не найден файл alt-prn.bat" skip
      316           "Обратитесь к системному администратору" skip
      317           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      318           "и откроете файл в текстовом редакторе" skip
      319           error-status :get-message(1) skip
      320           return-value skip
      321           view-as alert-box error.
      322         undo, return error .
      323       end.
      324       run gbl/_tmpfile.p
      325         (input  "r":u
      326         ,input  ".txt":u
      327         ,output v-temp-report-name
      328         ) .
      329       run gbl/open_url.p
      330         (input ' /min ':u
      331           + v-alt-prn-full-path
      332           + chr(32) + v-report-full-path
      333           + chr(32) + v-temp-report-name
      334           + chr(32) + v-alt-prn-path
      335         ) .
      336     end.
      337   end procedure.
      338   procedure exec-txt2pdf :
      339     define input  parameter p-text-file-name as character no-undo .
      340     define input  parameter p-pdf-file-name  as character no-undo .
      341     define input  parameter p-landscape      as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       define variable v-convert-pdf as character no-undo .
      346       define variable v-search-name as character no-undo .
      347       assign
      348         v-convert-pdf = "exe/txt2pdf.bat"
      349       .
      350       define variable v-report-full-path        as character no-undo .
      351       define variable v-report-path             as character no-undo .
      352       define variable v-report-file-name        as character no-undo .
      353       define variable v-report-file-name-no-ext as character no-undo .
      354       define variable v-report-file-name-ext    as character no-undo .
      355       run gbl/filename.p
      356         (input  v-convert-pdf
      357         ,output v-report-full-path
      358         ,output v-report-path
      359         ,output v-report-file-name
      360         ,output v-report-file-name-no-ext
      361         ,output v-report-file-name-ext
      362         ) no-error .
      363       if error-status :error
      364       then do:
      365         message
      366           "Ошибка задания входных параметров" skip
      367           "Не найден файл" v-convert-pdf skip
      368           "Вы можете просмотреть отчет, если сохраните отчет в файл" skip
      369           "и откроете файл в текстовом редакторе" skip
      370           error-status :get-message(1) skip
      371           return-value skip
      372           view-as alert-box error.
      373       end.
      374       else do:
      375         define variable v-command-line as character no-undo .
      376         define variable v-to-start as character no-undo .
      377         assign
      378           v-command-line = substitute('&1 "&2" "&3" &4 &5'
      379                                     ,v-report-full-path
      380                                     ,p-text-file-name
      381                                     ,p-pdf-file-name
      382                                     ,v-report-path
      383                                     ,p-landscape
      384                                     )
      385         .
      386         os-command no-console value(v-command-line).
      387         run gbl/open_url.p
      388           (input  quote-spaces(p-pdf-file-name)
      389           ) .
      390       end.
      391     end.
      392   end procedure.
