        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define new global shared variable g#library  as handle no-undo .
        3   define new global shared variable g#library2 as handle no-undo .
        4   define output parameter this-proc-hndl as handle no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Возвращает текущий номер базы данных, пользователя, дату, время и количество секунд".
       11   do:
       12     this-proc-hndl = this-procedure.
       13   end.
       14   procedure curd_burt:
       15   define output parameter p-user-db-num   like ub.contract.user-db-num   no-undo .
       16   define output parameter p-user-name     like ub.contract.user-name     no-undo .
       17   define output parameter p-sys-date      as  date      no-undo .
       18   define output parameter p-sys-time      as  character no-undo .
       19   define output parameter p-sys-time-int  as  integer   no-undo .
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
       22     (output p-user-db-num
       23     ,output p-user-name
       24     ,output p-sys-date
       25     ,output p-sys-time
       26     ,output p-sys-time-int
       27     )  .
       28   end procedure .
