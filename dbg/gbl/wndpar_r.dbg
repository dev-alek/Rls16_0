        1   block-level on error undo, throw.
        2   define input  parameter p-db-num        as integer   no-undo .
        3   define input  parameter p-user-id       as character no-undo .
        4   define input  parameter p-param-code    as character no-undo .
        5   define output parameter p-param-value   as logical   no-undo .
        6   define output parameter p-default-value as logical   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: wndpar_r.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: gbl/wndpar_r.p $":U .
       12   define variable vss-description as character no-undo init "Чтение пользовательских параметров настройки интерфейса".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3':U,p-db-num,p-user-id,p-param-code)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   do
       75   on error undo, return error return-value
       76   :
       77     define variable v-param-value           as character no-undo .
       78     define variable v-param-type            as character no-undo .
       79     define variable v-config-parameter-code as character no-undo .
       80     define buffer buf_user-login for ub.user-login .
       81     define buffer buf_sys-ctrl   for ub.sys-ctrl .
       82     define buffer buf_config     for ub.config .
       83     find first buf_sys-ctrl no-lock .
       84     if p-db-num = ? then do:
       85       assign
       86         p-db-num = buf_sys-ctrl.db-num
       87       .
       88     end.
       89     if p-user-id = "":U then do:
       90       assign
       91         p-user-id = userid( "DICTDB":U )
       92       .
       93     end.
       94     assign
       95       p-param-value   = ?
       96       p-default-value = false
       97     .
       98     find first buf_user-login no-lock
       99       where buf_user-login.db-num  = p-db-num
      100         and buf_user-login.user-id = p-user-id
      101       no-error .
      102     if available buf_user-login then do:
      103       case p-param-code :
      104         when 'wndmax':U
      105         then do:
      106           assign
      107             p-param-value = buf_user-login.user-window-maximize
      108           .
      109         end.
      110         when 'wndstore':U
      111         then do:
      112           assign
      113             p-param-value = buf_user-login.user-window-size-store
      114           .
      115         end.
      116         otherwise do:
      117           message
      118             vss-workfile vss-revision vss-description skip
      119             "Ошибка задания входных параметров" skip
      120             "Неизвестное значение параметра p-param-code" skip
      121             "p-param-code" p-param-code skip
      122             view-as alert-box error .
      123           undo, return error return-value .
      124         end.
      125       end.
      126     end.
      127     case p-param-code :
      128       when 'wndmax':U
      129       then do:
      130         assign
      131           v-config-parameter-code = 'max':U
      132         .
      133       end.
      134       when 'wndstore':U
      135       then do:
      136         assign
      137           v-config-parameter-code = 'store':U
      138         .
      139       end.
      140       otherwise do:
      141         message
      142           vss-workfile vss-revision vss-description skip
      143           "Ошибка задания входных параметров" skip
      144           "Неизвестное значение параметра p-param-code" skip
      145           "p-param-code" p-param-code skip
      146           view-as alert-box error .
      147         undo, return error return-value .
      148       end.
      149     end.
      150     if p-param-value = ? then do:
      151       assign
      152         p-default-value = FALSE
      153       .
      154       define variable v-value-character as character  no-undo .
      155       define variable v-value-date      as date       no-undo .
      156       define variable v-value-decimal   as decimal    no-undo .
      157       define variable v-value-integer   as integer    no-undo .
      158       define variable v-tth             as handle     no-undo .
      159       run adm/shattri.p ( input "get":U
      160                         , input  '':u
      161                         , input  0
      162                         , input  'wnd-size':U
      163                         , input  v-config-parameter-code
      164                         , output v-value-character
      165                         , output v-value-date
      166                         , output v-value-decimal
      167                         , output v-value-integer
      168                         , output p-param-value
      169                         , output v-param-type
      170                         , input-output table-handle v-tth
      171                         ) no-error .
      172       if error-status :error
      173       then do:
      174         assign
      175           p-param-value   = NO
      176         .
      177       end.
      178       delete object v-tth.
      179     end.
      180   end.
