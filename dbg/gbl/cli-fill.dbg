        1   block-level on error undo, throw.
        2   define input parameter  par-run-name as character no-undo .
        3   define input parameter  RS-list-method  as character no-undo .
        4   define input parameter  RS-status as character no-undo .
        5   define input parameter  line-mode as character no-undo .
        6   define input parameter  p-filter-var as character no-undo .
        7   define output parameter lns-cnt as integer no-undo .
        8   define output parameter line-rec as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: cli-fill.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/cli-fill.p $":U .
       14   define variable vss-description as character no-undo init "Фильтр в списке клиентов".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   def shared temp-table cli-list no-undo like ub.clients
       86     field to-del as logical
       87     index obj  is primary unique obj-type obj-code
       88     index cli-name      obj-name
       89     .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define  shared  temp-table cli-list-hist no-undo
       92   field list-table as character
       93   field id as integer
       94   field line as integer
       95   field hist-mode as character
       96   field des as character
       97   field num-recs as integer
       98   field option_ as character
       99   field item_ as character
      100   field status_ as character
      101   field num-add as integer
      102   field num-ignored as integer
      103   field done as logical
      104   field err_ as logical
      105   field err-mes as character
      106   index pi is primary
      107   id
      108   line
      109   index isdone
      110   done
      111   .
      112   define variable dsp-rs     as character format "x(50)" no-undo.
      113   define variable lns-ignore as integer no-undo .
      114   define variable v-prepare-string as character no-undo .
      115   define variable glog as logical no-undo .
      116   define query cli-fill for ub.clients.
      117   define frame abc
      118   dsp-rs no-label
      119   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      120   TITLE par-run-name.
      121   view frame abc.
      122   display dsp-rs
      123   with frame abc.
      124   v-prepare-string = "for each clients where true " + p-filter-var .
      125   glog = query cli-fill:handle:query-prepare(v-prepare-string) no-error.
      126   if not glog
      127   or error-status:error then do:
      128     message
      129     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      130                , chr(10)
      131                , error-status:get-message(1)
      132                , p-filter-var)
      133     view-as alert-box error .
      134     undo, return error .
      135   end.
      136   glog = query cli-fill:handle:query-open() no-error.
      137   if not glog
      138   or error-status:error then do:
      139     message
      140     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      141                , chr(10)
      142                , error-status:get-message(1)
      143                , p-filter-var)
      144     view-as alert-box error .
      145     undo, return error .
      146   end.
      147   REPEAT WITH FRAME abc:
      148     query cli-fill:handle:GET-NEXT().
      149     IF query cli-fill:handle:QUERY-OFF-END THEN LEAVE.
      150     process events.
      151     run ex-cli in this-procedure (input rs-list-method, input rs-status, input line-mode).
      152   end.
      153   glog = query cli-fill:handle:query-close() no-error.
      154   hide frame abc.
      155   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      156   PROCEDURE ex-cli :
      157   define input parameter rs-list-method as character no-undo .
      158   define input parameter rs-status as character no-undo .
      159   define input parameter line-mode as character no-undo .
      160   if rs-list-method = "single":U or
      161     (ub.clients.stts = 0  and rs-status <> 'удаленные':U) or
      162     (ub.clients.stts <> 0 and rs-status <> 'текущие':U) then do:
      163     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
      164       find first cli-list where
      165                  cli-list.obj-type = ub.clients.obj-type AND
      166                  cli-list.obj-code = ub.clients.obj-code no-error.
      167       if available cli-list then do:
      168         if line-mode = 'удаление':U then do:
      169           lns-cnt = lns-cnt + 1.
      170           delete cli-list.
      171         end.
      172         else do:
      173           if cli-list.to-del = ? then .
      174           else do:
      175              lns-cnt = lns-cnt + 1.
      176              cli-list.to-del = ?.
      177           end.
      178         end.
      179       end.
      180     end.
      181     else
      182       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
      183   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   find cli-list
      185     where cli-list.obj-type = clients.obj-type
      186       and cli-list.obj-code = clients.obj-code
      187     no-error .
      188   if available cli-list then do:
      189     assign
      190       cli-list.to-del = no
      191     .
      192   end.
      193   else do:
      194     create cli-list .
      195     buffer-copy clients to cli-list
      196     assign
      197       cli-list.to-del = no
      198     .
      199     assign
      200       lns-cnt = lns-cnt + 1
      201       line-rec = recid (cli-list)
      202     .
      203   end.
      204       end.
      205     disp "Ждите..." + string (lns-cnt) @ dsp-rs with frame abc.
      206   end.
      207   else
      208   assign
      209   lns-ignore = lns-ignore + 1
      210   .
      211   end.
