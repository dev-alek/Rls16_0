        1   DEFINE TEMP-TABLE temp-sel NO-UNDO LIKE ub.clients-attr
        2          field attr-label as character format "X(30)"
        3          field line-num as integer
        4          index pi is primary unique
        5          line-num.
        6   DEFINE INPUT PARAMETER bttns as character no-undo.
        7   DEFINE INPUT PARAMETER ptitle as character no-undo.
        8   DEFINE INPUT PARAMETER pattr-codes as character no-undo.
        9   DEFINE INPUT PARAMETER pattr-labels as character no-undo.
       10   DEFINE INPUT PARAMETER pdelim as character no-undo.
       11   DEFINE INPUT PARAMETER ppresel-codes as character no-undo.
       12   DEFINE OUTPUT PARAMETER psel-codes as character no-undo.
       13   def var vss-revision    as character no-undo init "$Revision$":u .
       14   def var vss-author      as character no-undo init "$Author$":u .
       15   def var vss-date        as character no-undo init "$Date$":u .
       16   def var vss-workfile    as character no-undo init "$Workfile$":u .
       17   def var vss-archive     as character no-undo init "$Archive$":u .
       18   def var vss-description as character no-undo init "Форма выбора из неизвестного количества опций" .
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define variable rid-list as character no-undo.
      134   DEFINE BUTTON B-Help
      135        LABEL "Помо&щь"
      136        SIZE 3 BY 1
      137        BGCOLOR 8 .
      138   DEFINE BUTTON B-mark
      139        LABEL "&*"
      140        SIZE 4 BY 1.
      141   DEFINE BUTTON b-quit AUTO-END-KEY
      142        LABEL "&Выход"
      143        SIZE 10 BY 1
      144        BGCOLOR 8 .
      145   DEFINE BUTTON B-sel AUTO-GO
      146        LABEL "Вы&бор"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>9":U INITIAL 0
      150         VIEW-AS TEXT
      151        SIZE 5 BY 1
      152        FGCOLOR 4  NO-UNDO.
      153   DEFINE QUERY BR-list FOR
      154         temp-sel SCROLLING.
      155   DEFINE BROWSE BR-list
      156     QUERY BR-list DISPLAY
      157         (IF ( CAN-DO (rid-list, string( recid( temp-sel ) ) ) ) THEN ("*") ELSE (" ")) COLUMN-LABEL "*" FORMAT "X(1)":U
      158         temp-sel.attr-label COLUMN-LABEL "Выбор" FORMAT "X(80)":U
      159               WIDTH 80
      160       WITH NO-ROW-MARKERS SEPARATORS SIZE 84.5 BY 19.43.
      161   DEFINE FRAME Dialog-Frame
      162        b-quit AT ROW 1 COL 1
      163        B-mark AT ROW 1 COL 11
      164        B-sel AT ROW 1 COL 21
      165        B-Help AT ROW 1 COL 75
      166        BR-list AT ROW 2.83 COL 1
      167        mark-num AT ROW 1 COL 13.8 COLON-ALIGNED NO-LABEL
      168        SPACE(66.29) SKIP(20.49)
      169       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      170            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      171            TITLE "<insert dialog title>"
      172            DEFAULT-BUTTON B-sel CANCEL-BUTTON b-quit.
      173   ASSIGN
      174          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      175          FRAME Dialog-Frame:HIDDEN           = TRUE.
      176   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      177   DO:
      178     APPLY "END-ERROR":U TO SELF.
      179   END.
      180   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      181   DO:
      182     run proc-b-mark no-error.
      183     if error-status:error then return no-apply.
      184   END.
      185   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      186   DO:
      187     if rid-list = "" then  do:
      188       if available temp-sel then
      189         rid-list = string( recid( temp-sel ) ) .
      190     end.
      191     else do:
      192       if not b-mark:sensitive in frame Dialog-Frame then do:
      193         rid-list = string( recid( temp-sel ) ) .
      194       end.
      195     end.
      196     Run fill-parameter(input pdelim,
      197                        output psel-codes) .
      198   END.
      199   ON LEFT-MOUSE-DBLCLICK OF BR-list IN FRAME Dialog-Frame
      200   DO:
      201      if lookup("b-mark":U, bttns) > 0 then do:
      202         run proc-b-mark no-error.
      203         if error-status:error then return no-apply.
      204      end.
      205      else do:
      206         APPLY "CHOOSE" to b-sel.
      207      end.
      208   END.
      209   ON RETURN OF BR-list IN FRAME Dialog-Frame
      210   DO:
      211      if lookup("b-mark":U, bttns) > 0 then do:
      212         run proc-b-mark no-error.
      213         if error-status:error then return no-apply.
      214      end.
      215      else do:
      216         APPLY "CHOOSE" to b-sel.
      217      end.
      218   END.
      219   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      220   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      221   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   on help of frame Dialog-Frame
      223   do:
      224     run gbl/app_help.p
      225       (input this-procedure :file-name
      226       ,input ''
      227       ,input ?
      228       ) no-error.
      229     if error-status :error then do:
      230       message
      231         "Ошибка при вызове помощи"
      232         error-status :get-message(1)
      233         view-as alert-box .
      234     end.
      235   end.
      236   run minbtn-set in this-procedure .
      237   on choose of b-help in frame Dialog-Frame
      238   do:
      239     apply "help":u to frame Dialog-Frame .
      240   end.
      241   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   procedure minbtn-set :
      243       do
      244           on error undo, return error return-value
      245           :
      246           define variable ii              as integer       no-undo .
      247           define variable fh              as widget-handle no-undo .
      248           define variable hh              as widget-handle no-undo .
      249           define variable v-h             as handle        extent 4 no-undo .
      250           define variable v-name-button   as character     no-undo .
      251           define variable v-help-old-x    as decimal       no-undo .
      252           define variable v-help-old-y    as decimal       no-undo .
      253           define variable v-help-old-size as decimal       no-undo .
      254           define variable v-frame-width   as decimal       no-undo .
      255           define variable jj              as integer       no-undo .
      256           do
      257               on error undo, return error
      258               :
      259               assign
      260                   v-frame-width = frame Dialog-Frame:width - 0.3
      261                   fh            = frame Dialog-Frame:first-child
      262                   hh            = fh:first-child
      263                   ii            = 1
      264                   .
      265               do while valid-handle(hh):
      266                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      267                   do:
      268                       case lc(hh:name) :
      269                           when "b-help" then
      270                               do:
      271                                   hh:load-image-up("cmp/b-help.bmp":u) .
      272                                   hh:load-image-down("cmp/b-help.bmp":u) .
      273                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      274                                   hh:TOOLTIP = "Помощь" .
      275                                   v-help-old-x = hh:column .
      276                                   v-help-old-y = hh:row    .
      277                                   v-help-old-size = hh:width .
      278                                   hh:width-chars = 2.5 .
      279                               end.
      280                           when "b-print" then
      281                               do:
      282                                   hh:load-image("cmp/b-print.bmp":u) .
      283                                   hh:TOOLTIP = "Печать" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-history" or
      289                           when "b-hist" then
      290                               do:
      291                                   hh:load-image("cmp/b-hist.bmp":u) .
      292                                   hh:TOOLTIP = "История" .
      293                                   v-h[ii] = hh:handle .
      294                                   ii = ii + 1 .
      295                                   hh:width-chars = 3 .
      296                               end.
      297                           when "b-sch" then
      298                               do:
      299                                   hh:load-image("cmp/b-sch.bmp":u) .
      300                                   hh:TOOLTIP = "Установка Фильтра" .
      301                                   v-h[ii] = hh:handle .
      302                                   ii = ii + 1 .
      303                                   hh:width-chars = 3 .
      304                               end.
      305                           when "b-hist-user" then
      306                               do:
      307                                   hh:load-image("cmp/b-hist.bmp":u) .
      308                                   hh:TOOLTIP = "История пользователя" .
      309                                   ii = ii + 1 .
      310                               end.
      311                       end case.
      312                   end.
      313                   hh = hh:next-sibling.
      314               end.
      315               b-help:column = v-frame-width - b-help:width-chars.
      316               jj = 0.
      317               repeat ii = 4 to 1 by -1 :
      318                   if valid-handle (v-h[ii] ) then
      319                   do:
      320                       jj  = jj + 1 .
      321                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      322                       v-h[ii]:row    = v-help-old-y .
      323                   end.
      324               end.
      325           end.
      326       end.
      327   end procedure.
      328   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      329   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      330   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      331   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      332   define variable v-diasize-current-frame-width  as decimal   no-undo .
      333   define variable v-diasize-current-frame-height as decimal   no-undo .
      334   define variable v-diasize-change-size          as logical   no-undo .
      335   define variable v-diasize-resize-button        as handle    no-undo .
      336   define variable v-diasize-wndmax               as logical   no-undo .
      337   define variable v-diasize-wndstore             as logical   no-undo .
      338   define variable v-diasize-proc-name            as character no-undo .
      339   define variable v-diasize-browse-handle        as handle    no-undo .
      340   define variable v-diasize-browse-number        as integer   no-undo .
      341   define variable v-diasize-need-full-display    as logical   no-undo init false .
      342   define temp-table temp-diasize-handle no-undo
      343     field handle-value  as handle
      344     field save-position as decimal
      345     index xpk is primary unique handle-value
      346     .
      347   define temp-table temp-browse-handle no-undo
      348     field browse-type   as character
      349     field browse-number as integer
      350     field browse-handle as handle
      351     field original-size as decimal
      352     index xpk is primary unique browse-type browse-number
      353     index xie browse-type browse-handle
      354   .
      355   procedure diasize_change-height :
      356     define input  parameter p-change-value  as decimal   no-undo .
      357     define input  parameter p-move-resize   as logical   no-undo .
      358     define variable v-field-group-handle    as handle    no-undo .
      359     define variable v-object-handle         as handle    no-undo .
      360     define variable v-frame-height          as decimal   no-undo .
      361     define variable v-frame-virtual-height  as decimal   no-undo .
      362     define variable v-browse-height         as decimal   no-undo .
      363     define variable v-window-height         as decimal   no-undo .
      364     define variable v-window-virtual-height as decimal   no-undo .
      365     define variable v-change-sign           as integer   no-undo .
      366     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      367     define buffer buf_temp-browse-handle  for temp-browse-handle .
      368     if p-change-value > 0
      369     then do:
      370       if frame Dialog-Frame :height + p-change-value
      371           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      372       then do:
      373         assign
      374           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      375                           - (frame Dialog-Frame :height-chars)
      376         .
      377         if p-change-value <= 0
      378         then do:
      379           run diasize_position-resize-button in this-procedure .
      380           return .
      381         end.
      382       end.
      383     end.
      384     if p-change-value < 0
      385     then do:
      386       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      387       then do:
      388         assign
      389           p-change-value = v-diasize-orig-frame-height
      390                          - (frame Dialog-Frame :height-chars)
      391         .
      392         if p-change-value >= 0
      393         then do:
      394           run diasize_position-resize-button in this-procedure .
      395           return .
      396         end.
      397       end.
      398     end.
      399     if p-change-value >= 0
      400     then do:
      401       assign
      402         v-change-sign = 1
      403       .
      404     end.
      405     else do:
      406       assign
      407         v-change-sign = -1
      408       .
      409     end.
      410     assign
      411       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      412     .
      413     if p-change-value = 0
      414     then do:
      415       run diasize_position-resize-button in this-procedure .
      416       return .
      417     end.
      418     move_block:
      419     do
      420     on error undo move_block, retry move_block
      421     :
      422       if retry
      423       then do:
      424         do
      425         on error undo move_block, leave move_block
      426         :
      427           if p-change-value > 0
      428           then do:
      429             for each buf_temp-diasize-handle
      430             on error undo, next
      431             :
      432               assign
      433                 v-object-handle = buf_temp-diasize-handle.handle-value
      434               .
      435               if v-object-handle <> v-diasize-resize-button
      436               then do:
      437                 assign
      438                   v-object-handle :row = buf_temp-diasize-handle.save-position
      439                 .
      440               end.
      441             end.
      442             assign
      443               v-diasize-browse-handle :height = v-browse-height
      444             .
      445             for each buf_temp-browse-handle
      446               where buf_temp-browse-handle.browse-type = 'height':u
      447             on error undo, next
      448             :
      449               assign
      450                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      451               .
      452             end.
      453             assign
      454               frame Dialog-Frame :height = v-frame-height
      455             .
      456             if frame Dialog-Frame :scrollable = true
      457             then do:
      458               assign
      459                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      460               .
      461             end.
      462             run diasize_position-resize-button in this-procedure .
      463           end.
      464           else do:
      465             if frame Dialog-Frame :scrollable = true
      466             then do:
      467               assign
      468                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      469               .
      470             end.
      471             assign
      472               frame Dialog-Frame :height = v-frame-height
      473             .
      474             assign
      475               v-diasize-browse-handle :height = v-browse-height
      476             .
      477             for each buf_temp-browse-handle
      478               where buf_temp-browse-handle.browse-type = 'height':u
      479             on error undo, next
      480             :
      481               assign
      482                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      483               .
      484             end.
      485             for each buf_temp-diasize-handle
      486             on error undo, next
      487             :
      488               assign
      489                 v-object-handle = buf_temp-diasize-handle.handle-value
      490               .
      491               if v-object-handle <> v-diasize-resize-button
      492               then do:
      493                 assign
      494                   v-object-handle :row = buf_temp-diasize-handle.save-position
      495                 .
      496               end.
      497             end.
      498             run diasize_position-resize-button in this-procedure .
      499           end.
      500           assign
      501             v-diasize-change-size = false
      502           .
      503           leave move_block .
      504         end.
      505       end.
      506       assign
      507         v-diasize-need-full-display = true
      508       .
      509       if v-diasize-change-size = false
      510       then do:
      511         assign
      512           v-diasize-change-size = true
      513         .
      514       end.
      515       else do:
      516         return .
      517       end.
      518       assign
      519         v-frame-height = frame Dialog-Frame :height
      520         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      521         v-browse-height = v-diasize-browse-handle :height
      522       .
      523       for each buf_temp-browse-handle
      524         where buf_temp-browse-handle.browse-type = 'height':u
      525       :
      526         assign
      527           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      528         .
      529       end.
      530       for each buf_temp-diasize-handle
      531       :
      532         delete buf_temp-diasize-handle .
      533       end.
      534       assign
      535         v-field-group-handle = frame Dialog-Frame :first-child
      536       .
      537       do while valid-handle(v-field-group-handle)
      538       :
      539         assign
      540           v-object-handle = v-field-group-handle :first-child
      541         .
      542         do while valid-handle(v-object-handle)
      543         :
      544           if  v-object-handle <> v-diasize-browse-handle :handle
      545           and can-query(v-object-handle, "row")
      546           and can-query(v-object-handle, "height")
      547           and ( v-object-handle :row > v-diasize-browse-handle :row )
      548           then do:
      549             find first buf_temp-browse-handle
      550               where buf_temp-browse-handle.browse-type   = 'height':u
      551                 and buf_temp-browse-handle.browse-handle = v-object-handle
      552               no-error .
      553             if available buf_temp-browse-handle
      554             then do:
      555             end.
      556             else do:
      557               create buf_temp-diasize-handle .
      558               assign
      559                 buf_temp-diasize-handle.handle-value  = v-object-handle
      560                 buf_temp-diasize-handle.save-position = v-object-handle :row
      561               .
      562             end.
      563           end.
      564           assign
      565             v-object-handle = v-object-handle :next-sibling
      566           .
      567         end.
      568         assign
      569           v-field-group-handle = v-field-group-handle :next-sibling
      570         .
      571       end.
      572       do with frame Dialog-Frame
      573       :
      574         hide v-diasize-resize-button .
      575         assign
      576           v-diasize-resize-button :row    = 1
      577           v-diasize-resize-button :column = 1
      578         .
      579       end.
      580       if p-change-value > 0
      581       then do:
      582         if frame Dialog-Frame :scrollable = true
      583         then do:
      584           assign
      585             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      586             no-error .
      587           if error-status :error
      588           or error-status :get-message(1) <> ""
      589           then do:
      590             undo move_block, retry move_block .
      591           end.
      592         end.
      593         assign
      594           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      595           no-error .
      596         if error-status :error
      597         or error-status :get-message(1) <> ""
      598         then do:
      599           undo move_block, retry move_block .
      600         end.
      601         assign
      602           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      603           no-error .
      604         if error-status :error
      605         or error-status :get-message(1) <> ""
      606         then do:
      607           undo move_block, retry move_block .
      608         end.
      609         for each buf_temp-browse-handle
      610           where buf_temp-browse-handle.browse-type = 'height':u
      611         on error undo move_block, retry move_block
      612         :
      613           assign
      614             buf_temp-browse-handle.browse-handle :height
      615               = buf_temp-browse-handle.browse-handle :height + p-change-value
      616             no-error .
      617           if error-status :error
      618           or error-status :get-message(1) <> ""
      619           then do:
      620             undo move_block, retry move_block .
      621           end.
      622         end.
      623         for each buf_temp-diasize-handle
      624         on error undo move_block, retry move_block
      625         :
      626           assign
      627             v-object-handle = buf_temp-diasize-handle.handle-value
      628           .
      629           if v-object-handle <> v-diasize-resize-button
      630           then do:
      631             assign
      632               v-object-handle :row = v-object-handle :row + p-change-value
      633               no-error .
      634             if error-status :error
      635             or error-status :get-message(1) <> ""
      636             then do:
      637               undo move_block, retry move_block .
      638             end.
      639           end.
      640         end.
      641       end.
      642       else do:
      643         for each buf_temp-diasize-handle
      644         on error undo move_block, retry move_block
      645         :
      646           assign
      647             v-object-handle = buf_temp-diasize-handle.handle-value
      648           .
      649           if v-object-handle <> v-diasize-resize-button
      650           then do:
      651             assign
      652               v-object-handle :row = v-object-handle :row + p-change-value
      653               no-error .
      654             if error-status :error
      655             or error-status :get-message(1) <> ""
      656             then do:
      657               undo move_block, retry move_block .
      658             end.
      659           end.
      660         end.
      661         assign
      662           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      663           no-error .
      664         if error-status :error
      665         or error-status :get-message(1) <> ""
      666         then do:
      667           undo move_block, retry move_block .
      668         end.
      669         for each buf_temp-browse-handle
      670           where buf_temp-browse-handle.browse-type = 'height':u
      671         on error undo move_block, retry move_block
      672         :
      673           assign
      674             buf_temp-browse-handle.browse-handle :height
      675               = buf_temp-browse-handle.browse-handle :height + p-change-value
      676             no-error .
      677           if error-status :error
      678           or error-status :get-message(1) <> ""
      679           then do:
      680             undo move_block, retry move_block .
      681           end.
      682         end.
      683         assign
      684           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      685           no-error .
      686         if error-status :error
      687         or error-status :get-message(1) <> ""
      688         then do:
      689           undo move_block, retry move_block .
      690         end.
      691         if frame Dialog-Frame :scrollable = true
      692         then do:
      693           assign
      694             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      695             no-error .
      696           if error-status :error
      697           or error-status :get-message(1) <> ""
      698           then do:
      699             undo move_block, retry move_block .
      700           end.
      701         end.
      702       end.
      703       if p-move-resize = true
      704       then do:
      705         run diasize_position-resize-button in this-procedure .
      706       end.
      707       if v-diasize-wndstore = true
      708       then do:
      709         if connected("ub") = true
      710         then do:
      711           define variable v-cntxt-db-num        as integer   no-undo .
      712           define variable v-cntxt-userid        as character no-undo .
      713           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      714                                             , OUTPUT v-cntxt-userid
      715                                             ) .
      716           run gbl/wndsizew.p
      717             (input  v-cntxt-db-num
      718             ,input  v-cntxt-userid
      719             ,input  v-diasize-proc-name
      720             ,input  'height':u
      721             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      722             ) .
      723         end.
      724       end.
      725     end.
      726     assign
      727       v-diasize-change-size = false
      728     .
      729   end procedure.
      730   procedure diasize_set-height :
      731     define input  parameter p-new-height  as decimal   no-undo .
      732     define input  parameter p-move-resize as logical   no-undo .
      733     do
      734     on error undo, return error return-value
      735     :
      736       run diasize_change-height in this-procedure
      737         (input  (p-new-height - frame Dialog-Frame :height)
      738         ,input  p-move-resize
      739         ) .
      740     end.
      741   end procedure.
      742   procedure diasize_change-width :
      743     define input  parameter p-change-value as decimal   no-undo .
      744     define input  parameter p-move-resize  as logical   no-undo .
      745     define variable v-field-group-handle   as handle    no-undo .
      746     define variable v-object-handle        as handle    no-undo .
      747     define variable v-frame-width          as decimal   no-undo .
      748     define variable v-frame-virtual-width  as decimal   no-undo .
      749     define variable v-browse-width         as decimal   no-undo .
      750     define variable v-window-width         as decimal   no-undo .
      751     define variable v-window-virtual-width as decimal   no-undo .
      752     define variable v-change-sign          as integer   no-undo .
      753     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      754     define buffer buf_temp-browse-handle  for temp-browse-handle .
      755     if p-change-value > 0
      756     then do:
      757       if frame Dialog-Frame :width + p-change-value >
      758           session :width-chars
      759       then do:
      760         assign
      761           p-change-value = session :width-chars - frame Dialog-Frame :width
      762         .
      763         if p-change-value <= 0
      764         then do:
      765           run diasize_position-resize-button in this-procedure .
      766           return .
      767         end.
      768       end.
      769     end.
      770     if p-change-value < 0
      771     then do:
      772       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      773       then do:
      774         assign
      775           p-change-value = v-diasize-orig-frame-width
      776                          - frame Dialog-Frame :width
      777         .
      778         if p-change-value >= 0
      779         then do:
      780           run diasize_position-resize-button in this-procedure .
      781           return .
      782         end.
      783       end.
      784     end.
      785     if p-change-value >= 0
      786     then do:
      787       assign
      788         v-change-sign = 1
      789       .
      790     end.
      791     else do:
      792       assign
      793         v-change-sign = -1
      794       .
      795     end.
      796     assign
      797       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      798     .
      799     if p-change-value = 0
      800     then do:
      801       run diasize_position-resize-button in this-procedure .
      802       return .
      803     end.
      804     move_block:
      805     do
      806     on error undo move_block, leave move_block
      807     :
      808       if retry
      809       then do:
      810         do
      811         on error undo move_block, leave move_block
      812         :
      813           if p-change-value > 0
      814           then do:
      815             for each buf_temp-diasize-handle
      816             on error undo, next
      817             :
      818               assign
      819                 v-object-handle = buf_temp-diasize-handle.handle-value
      820               .
      821               if v-object-handle <> v-diasize-resize-button
      822               then do:
      823                 assign
      824                   v-object-handle :col = buf_temp-diasize-handle.save-position
      825                 .
      826               end.
      827             end.
      828             assign
      829               v-diasize-browse-handle :width = v-browse-width
      830             .
      831             for each buf_temp-browse-handle
      832               where buf_temp-browse-handle.browse-type = 'width':u
      833             on error undo, next
      834             :
      835               assign
      836                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      837               .
      838             end.
      839             assign
      840               frame Dialog-Frame :width = v-frame-width
      841             .
      842             if frame Dialog-Frame :scrollable = true
      843             then do:
      844               assign
      845                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      846               .
      847             end.
      848             run diasize_position-resize-button in this-procedure .
      849           end.
      850           else do:
      851             if frame Dialog-Frame :scrollable = true
      852             then do:
      853               assign
      854                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      855               .
      856             end.
      857             assign
      858               frame Dialog-Frame :width = v-frame-width
      859             .
      860             for each buf_temp-browse-handle
      861               where buf_temp-browse-handle.browse-type = 'width':u
      862             on error undo, next
      863             :
      864               assign
      865                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      866               .
      867             end.
      868             assign
      869               v-diasize-browse-handle :width = v-browse-width
      870             .
      871             for each buf_temp-diasize-handle
      872             on error undo, next
      873             :
      874               assign
      875                 v-object-handle = buf_temp-diasize-handle.handle-value
      876               .
      877               if v-object-handle <> v-diasize-resize-button
      878               then do:
      879                 assign
      880                   v-object-handle :col = buf_temp-diasize-handle.save-position
      881                 .
      882               end.
      883             end.
      884             run diasize_position-resize-button in this-procedure .
      885           end.
      886           assign
      887             v-diasize-change-size = false
      888           .
      889           leave move_block .
      890         end.
      891       end.
      892       assign
      893         v-diasize-need-full-display = true
      894       .
      895       if v-diasize-change-size = false
      896       then do:
      897         assign
      898           v-diasize-change-size = true
      899         .
      900       end.
      901       else do:
      902         return .
      903       end.
      904       assign
      905         v-frame-width = frame Dialog-Frame :width
      906         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      907         v-browse-width = v-diasize-browse-handle :width
      908       .
      909       for each buf_temp-browse-handle
      910         where buf_temp-browse-handle.browse-type = 'width':u
      911       :
      912         assign
      913           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      914         .
      915       end.
      916       for each buf_temp-diasize-handle
      917       :
      918         delete buf_temp-diasize-handle .
      919       end.
      920       assign
      921         v-field-group-handle = frame Dialog-Frame :first-child
      922       .
      923       do while valid-handle(v-field-group-handle)
      924       :
      925         assign
      926           v-object-handle = v-field-group-handle :first-child
      927         .
      928         do while valid-handle(v-object-handle)
      929         :
      930           if  v-object-handle <> v-diasize-browse-handle :handle
      931           and v-object-handle <> v-diasize-resize-button
      932           and can-query(v-object-handle, "row")
      933           and can-query(v-object-handle, "height")
      934           and ( v-object-handle :col + v-object-handle :width
      935                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      936               )
      937           then do:
      938             find first buf_temp-browse-handle
      939               where buf_temp-browse-handle.browse-type   = 'width':u
      940                 and buf_temp-browse-handle.browse-handle = v-object-handle
      941               no-error .
      942             if available buf_temp-browse-handle
      943             then do:
      944             end.
      945             else do:
      946               create buf_temp-diasize-handle .
      947               assign
      948                 buf_temp-diasize-handle.handle-value  = v-object-handle
      949                 buf_temp-diasize-handle.save-position = v-object-handle :col
      950               .
      951             end.
      952           end.
      953           assign
      954             v-object-handle = v-object-handle :next-sibling
      955           .
      956         end.
      957         assign
      958           v-field-group-handle = v-field-group-handle :next-sibling
      959         .
      960       end.
      961       do with frame Dialog-Frame
      962       :
      963         hide v-diasize-resize-button .
      964         v-diasize-resize-button :row = 1.
      965         v-diasize-resize-button :column = 1.
      966       end.
      967       if p-change-value > 0
      968       then do:
      969         if frame Dialog-Frame :scrollable = true
      970         then do:
      971           assign
      972             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      973             no-error .
      974           if error-status :error
      975           or error-status :get-message(1) <> ""
      976           then do:
      977             undo move_block, retry move_block.
      978           end.
      979         end.
      980         assign
      981           frame Dialog-Frame :width = v-frame-width + p-change-value
      982           no-error .
      983         if error-status :error
      984         or error-status :get-message(1) <> ""
      985         then do:
      986           undo move_block, retry move_block.
      987         end.
      988         assign
      989           v-diasize-browse-handle :width = v-browse-width + p-change-value
      990         no-error .
      991         if error-status :error
      992         or error-status :get-message(1) <> ""
      993         then do:
      994           undo move_block, retry move_block.
      995         end.
      996         for each buf_temp-browse-handle
      997           where buf_temp-browse-handle.browse-type = 'width':u
      998         on error undo move_block, retry move_block
      999         :
     1000           assign
     1001             buf_temp-browse-handle.browse-handle :width
     1002               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1003             no-error .
     1004           if error-status :error
     1005           or error-status :get-message(1) <> ""
     1006           then do:
     1007             undo move_block, retry move_block .
     1008           end.
     1009         end.
     1010         for each buf_temp-diasize-handle
     1011         on error undo move_block, retry move_block
     1012         :
     1013           assign
     1014             v-object-handle = buf_temp-diasize-handle.handle-value
     1015           .
     1016           if v-object-handle <> v-diasize-resize-button
     1017           then do:
     1018             assign
     1019               v-object-handle :col = v-object-handle :col + p-change-value
     1020               no-error .
     1021             if error-status :error
     1022             or error-status :get-message(1) <> ""
     1023             then do:
     1024               undo move_block, retry move_block .
     1025             end.
     1026           end.
     1027         end.
     1028       end.
     1029       else do:
     1030         for each buf_temp-diasize-handle
     1031         on error undo move_block, retry move_block
     1032         :
     1033           assign
     1034             v-object-handle = buf_temp-diasize-handle.handle-value
     1035           .
     1036           if v-object-handle <> v-diasize-resize-button
     1037           then do:
     1038             assign
     1039               v-object-handle :col = v-object-handle :col + p-change-value
     1040               no-error .
     1041             if error-status :error
     1042             or error-status :get-message(1) <> ""
     1043             then do:
     1044               undo move_block, retry move_block .
     1045             end.
     1046           end.
     1047         end.
     1048         for each buf_temp-browse-handle
     1049           where buf_temp-browse-handle.browse-type = 'width':u
     1050         on error undo move_block, retry move_block
     1051         :
     1052           assign
     1053             buf_temp-browse-handle.browse-handle :width
     1054               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1055             no-error .
     1056           if error-status :error
     1057           or error-status :get-message(1) <> ""
     1058           then do:
     1059             undo move_block, retry move_block .
     1060           end.
     1061         end.
     1062         assign
     1063           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1064           no-error .
     1065         if error-status :error
     1066         or error-status :get-message(1) <> ""
     1067         then do:
     1068           undo move_block, retry move_block.
     1069         end.
     1070         assign
     1071           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1072         no-error .
     1073         if error-status :error
     1074         or error-status :get-message(1) <> ""
     1075         then do:
     1076           undo move_block, retry move_block.
     1077         end.
     1078         if frame Dialog-Frame :scrollable = true
     1079         then do:
     1080           assign
     1081             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1082           no-error .
     1083           if error-status :error
     1084           or error-status :get-message(1) <> ""
     1085           then do:
     1086             undo move_block, retry move_block.
     1087           end.
     1088         end.
     1089       end.
     1090       if p-move-resize
     1091       then do:
     1092         run diasize_position-resize-button in this-procedure .
     1093       end.
     1094       if v-diasize-wndstore = true
     1095       then do:
     1096         if connected("ub") = true
     1097         then do:
     1098           define variable v-cntxt-db-num        as integer   no-undo .
     1099           define variable v-cntxt-userid        as character no-undo .
     1100           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1101                                             , OUTPUT v-cntxt-userid
     1102                                             ) .
     1103           run gbl/wndsizew.p
     1104             (input  v-cntxt-db-num
     1105             ,input  v-cntxt-userid
     1106             ,input  v-diasize-proc-name
     1107             ,input  'width':u
     1108             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1109             ) .
     1110         end.
     1111       end.
     1112     end.
     1113     assign
     1114       v-diasize-change-size = false
     1115     .
     1116   end procedure.
     1117   procedure diasize_set-width :
     1118     define input  parameter p-new-width  as decimal   no-undo .
     1119     define input  parameter p-move-resize as logical   no-undo .
     1120     do
     1121     on error undo, return error return-value
     1122     :
     1123       run diasize_change-width in this-procedure
     1124         (input  (p-new-width - frame Dialog-Frame :width)
     1125         ,input  p-move-resize
     1126         ) .
     1127     end.
     1128   end procedure.
     1129   procedure diasize_position-resize-button :
     1130     do with frame Dialog-Frame
     1131     :
     1132       hide v-diasize-resize-button .
     1133       assign
     1134         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1135                     - 1
     1136                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1137         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1138                     - 1
     1139                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1140       .
     1141       view v-diasize-resize-button .
     1142     end.
     1143   end procedure.
     1144   on alt-right anywhere
     1145   do:
     1146     run diasize_change-width in this-procedure
     1147       (input 1
     1148       ,input true
     1149       ) .
     1150     return no-apply .
     1151   end.
     1152   on alt-left anywhere
     1153   do:
     1154     run diasize_change-width in this-procedure
     1155       (input -1
     1156       ,input true
     1157       ) .
     1158     return no-apply .
     1159   end.
     1160   on alt-down anywhere
     1161   do:
     1162     run diasize_change-height in this-procedure
     1163       (input 1
     1164       ,input true
     1165       ) .
     1166     return no-apply .
     1167   end.
     1168   on alt-up anywhere
     1169   do:
     1170     run diasize_change-height in this-procedure
     1171       (input -1
     1172       ,input true
     1173       ) .
     1174     return no-apply .
     1175   end.
     1176   on alt-enter of frame Dialog-Frame
     1177   do:
     1178     run diasize_maximize in this-procedure
     1179       (input  ?
     1180       ).
     1181     return no-apply .
     1182   end.
     1183   procedure diasize_end-move :
     1184     do
     1185     on error undo, return error return-value
     1186     :
     1187       define variable v-row-delta as decimal   no-undo .
     1188       define variable v-col-delta as decimal   no-undo .
     1189       define variable v-new-row as decimal   no-undo .
     1190       define variable v-new-col as decimal   no-undo .
     1191       assign
     1192         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1193         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1194       .
     1195       assign
     1196         v-row-delta = v-new-row - frame Dialog-Frame :height
     1197         v-col-delta = v-new-col - frame Dialog-Frame :width
     1198       .
     1199       run diasize_change-height in this-procedure
     1200         (input v-row-delta
     1201         ,input true
     1202         ) .
     1203       run diasize_change-width in this-procedure
     1204         (input v-col-delta
     1205         ,input true
     1206         ) .
     1207     end.
     1208   end procedure.
     1209   procedure diasize_maximize :
     1210     define input  parameter p-action as logical   no-undo .
     1211     do
     1212     on error undo, return error return-value
     1213     :
     1214       if p-action = ?
     1215       then do:
     1216         if v-diasize-need-maximize = true
     1217         then do:
     1218           assign
     1219             p-action = true
     1220           .
     1221         end.
     1222         else do:
     1223           assign
     1224             p-action = false
     1225           .
     1226         end.
     1227       end.
     1228       if p-action = true
     1229       then do:
     1230         run diasize_change-height in this-procedure
     1231           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1232               - frame Dialog-Frame :height-chars
     1233           ,input true
     1234           ) .
     1235         run diasize_change-width in this-procedure
     1236           (input session :width-chars
     1237               - frame Dialog-Frame :width-chars
     1238           ,input true
     1239           ) .
     1240         assign
     1241           v-diasize-need-maximize = false
     1242         .
     1243       end.
     1244       else do:
     1245         run diasize_change-width in this-procedure
     1246           (input v-diasize-orig-frame-width
     1247               - frame Dialog-Frame :width-chars
     1248           ,input true
     1249           ) .
     1250         run diasize_change-height in this-procedure
     1251           (input v-diasize-orig-frame-height
     1252               - frame Dialog-Frame :height-chars
     1253           ,input true
     1254           ) .
     1255         assign
     1256           v-diasize-need-maximize = true
     1257         .
     1258       end.
     1259     end.
     1260   end procedure.
     1261   procedure diasize_restore-orig-size :
     1262     do
     1263     on error undo, return error return-value
     1264     :
     1265       assign
     1266         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1267         v-diasize-current-frame-height = frame Dialog-Frame :height
     1268       .
     1269       run diasize_set-height in this-procedure
     1270         (input  v-diasize-orig-frame-height
     1271         ,input  true
     1272         ) .
     1273       run diasize_set-width in this-procedure
     1274         (input  v-diasize-orig-frame-width
     1275         ,input  true
     1276         ) .
     1277     end.
     1278   end procedure.
     1279   procedure diasize_restore-current-size :
     1280     do
     1281     on error undo, return error return-value
     1282     :
     1283       run diasize_set-height in this-procedure
     1284         (input  v-diasize-current-frame-height
     1285         ,input  true
     1286         ) .
     1287       run diasize_set-width in this-procedure
     1288         (input  v-diasize-current-frame-width
     1289         ,input  true
     1290         ) .
     1291     end.
     1292   end procedure.
     1293   procedure diasize_set-browse-handle :
     1294     define input  parameter p-browse-handle as handle   no-undo .
     1295     define buffer buf_temp-browse-handle for temp-browse-handle .
     1296     do
     1297     on error undo, return error return-value
     1298     :
     1299       assign
     1300         v-diasize-browse-handle = p-browse-handle
     1301       .
     1302       for each buf_temp-browse-handle
     1303       on error undo, return error return-value
     1304       :
     1305         delete buf_temp-browse-handle .
     1306       end.
     1307     end.
     1308   end procedure.
     1309   procedure diasize_add_browse :
     1310     define input  parameter p-browse-type   as character no-undo .
     1311     define input  parameter p-browse-handle as handle    no-undo .
     1312     define buffer buf_temp-browse-handle for temp-browse-handle .
     1313     do
     1314     on error undo, return error return-value
     1315     :
     1316       assign
     1317         v-diasize-browse-number = v-diasize-browse-number + 1
     1318       .
     1319       create buf_temp-browse-handle .
     1320       assign
     1321         buf_temp-browse-handle.browse-type   = p-browse-type
     1322         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1323         buf_temp-browse-handle.browse-handle = p-browse-handle
     1324       .
     1325     end.
     1326   end procedure.
     1327   procedure diasize_init :
     1328     define variable v-default-value    as logical   no-undo .
     1329     define variable v-restore-saved    as logical   no-undo .
     1330     define variable v-resize-value-str as character no-undo .
     1331     do
     1332     on error undo, return error return-value
     1333     :
     1334       do with frame Dialog-Frame
     1335       :
     1336         assign
     1337           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1338           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1339           v-diasize-browse-handle     = browse BR-list :handle
     1340         .
     1341         create button v-diasize-resize-button
     1342         assign
     1343           parent        = frame Dialog-Frame :first-child
     1344           label         = "s"
     1345           height-pixels = 16
     1346           width-pixels  = 16
     1347           visible       = true
     1348           sensitive     = true
     1349           movable       = true
     1350           triggers:
     1351             on end-move persistent run diasize_end-move in this-procedure .
     1352           end triggers.
     1353         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1354         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1355         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1356         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1357         assign
     1358           v-diasize-wndmax = false
     1359         .
     1360         if connected("ub") = true
     1361         then do:
     1362           define variable v-cntxt-db-num        as integer   no-undo .
     1363           define variable v-cntxt-userid        as character no-undo .
     1364           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1365                                             , OUTPUT v-cntxt-userid
     1366                                             ) .
     1367           run gbl/wndpar_r.p
     1368             (input  v-cntxt-db-num
     1369             ,input  v-cntxt-userid
     1370             ,input  'wndmax':U
     1371             ,output v-diasize-wndmax
     1372             ,output v-default-value
     1373             ) .
     1374         end.
     1375         assign
     1376           v-diasize-wndstore = false
     1377         .
     1378         if connected("ub") = true
     1379         then do:
     1380           run gbl/wndpar_r.p
     1381             (input  v-cntxt-db-num
     1382             ,input  v-cntxt-userid
     1383             ,input  'wndstore':U
     1384             ,output v-diasize-wndstore
     1385             ,output v-default-value
     1386             ) .
     1387         end.
     1388         assign
     1389           v-diasize-proc-name = entry(1, program-name(2), '.')
     1390         .
     1391         if v-diasize-wndstore = true
     1392         then do:
     1393           assign
     1394             v-restore-saved = false
     1395           .
     1396           if connected("ub") = true
     1397           then do:
     1398             run gbl/wndsizer.p
     1399               (input  v-cntxt-db-num
     1400               ,input  v-cntxt-userid
     1401               ,input  v-diasize-proc-name
     1402               ,input  'height':u
     1403               ,output v-resize-value-str
     1404               ) .
     1405             if v-resize-value-str <> '':U
     1406             then do:
     1407               run diasize_change-height in this-procedure
     1408                 (input  integer(v-resize-value-str)
     1409                 ,input  true
     1410                 ) .
     1411               assign
     1412                 v-restore-saved = true
     1413               .
     1414             end.
     1415           end.
     1416           if connected("ub") = true
     1417           then do:
     1418             run gbl/wndsizer.p
     1419               (input  v-cntxt-db-num
     1420               ,input  v-cntxt-userid
     1421               ,input  v-diasize-proc-name
     1422               ,input  'width':u
     1423               ,output v-resize-value-str
     1424               ) .
     1425             if v-resize-value-str <> '':U
     1426             then do:
     1427               run diasize_change-width in this-procedure
     1428                 (input  integer(v-resize-value-str)
     1429                 ,input  true
     1430                 ) .
     1431               assign
     1432                 v-restore-saved = true
     1433               .
     1434             end.
     1435           end.
     1436           if v-restore-saved <> true
     1437           then do:
     1438             if v-diasize-wndmax = true
     1439             then do:
     1440               run diasize_maximize in this-procedure
     1441                 (input  true
     1442                 ) .
     1443             end.
     1444           end.
     1445         end.
     1446         else do:
     1447           if v-diasize-wndmax = true
     1448           then do:
     1449             run diasize_maximize in this-procedure
     1450               (input  true
     1451               ) .
     1452           end.
     1453         end.
     1454       end.
     1455     end.
     1456   end procedure.
     1457   procedure diasize_need-full-display :
     1458     define output parameter p-need-full-display as logical   no-undo .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       assign
     1463         p-need-full-display = v-diasize-need-full-display
     1464       .
     1465       assign
     1466         v-diasize-need-full-display = false
     1467       .
     1468     end.
     1469   end procedure.
     1470   procedure get-context :
     1471      define output parameter p-db-num as integer          no-undo.
     1472      define output parameter p-user-id as character        no-undo.
     1473      define variable v-login               as character    no-undo.
     1474      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1475      define buffer buf_user-login  for ub.user-login .
     1476      do
     1477      on error undo, return error
     1478      :
     1479            FIND FIRST buf_sys-ctrl no-lock.
     1480            ASSIGN
     1481               v-login = USERID("ub")
     1482               p-db-num = buf_sys-ctrl.db-num
     1483            .
     1484            FIND FIRST buf_user-login
     1485                 WHERE buf_user-login.db-num = p-db-num
     1486                   AND buf_user-login.user-login = v-login
     1487                 no-lock
     1488                 no-error
     1489                 .
     1490            IF AVAILABLE buf_user-login
     1491            THEN DO:
     1492               assign
     1493                  p-user-id = buf_user-login.user-id
     1494               .
     1495            END.
     1496      end.
     1497   end procedure.
     1498       run diasize_init in this-procedure .
     1499   MAIN-BLOCK:
     1500   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1501      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1502     run fill-table(pattr-codes, pattr-labels, pdelim) no-error.
     1503     if error-status:error then return.
     1504     RUN MyEnable.
     1505     WAIT-FOR GO OF FRAME Dialog-Frame.
     1506   END.
     1507   RUN disable_UI.
     1508   PROCEDURE disable_UI :
     1509     HIDE FRAME Dialog-Frame.
     1510   END PROCEDURE.
     1511   PROCEDURE enable_UI :
     1512     DISPLAY mark-num
     1513         WITH FRAME Dialog-Frame.
     1514     ENABLE b-quit B-mark B-sel B-Help BR-list mark-num
     1515         WITH FRAME Dialog-Frame.
     1516     VIEW FRAME Dialog-Frame.
     1517     OPEN QUERY BR-list FOR EACH temp-sel NO-LOCK.
     1518   END PROCEDURE.
     1519   PROCEDURE fill-parameter :
     1520   DEFINE INPUT PARAMETER loc-delim as character no-undo.
     1521   DEFINE OUTPUT PARAMETER loc-attr-codes as chAracter no-undo.
     1522   DEFINE BUFFER loc-temp-sel for temp-sel.
     1523   DEFINE VAR ii as integer no-undo.
     1524   DO II = 1 to num-entries(rid-list):
     1525       FIND FIRST loc-temp-sel where
     1526                  recid(loc-temp-sel) = integer(entry(ii, rid-list)) No-error.
     1527       if avail temp-sel then
     1528       loc-attr-codes = loc-attr-codes + (if loc-attr-codes = "" then "" else loc-delim) +
     1529                        loc-temp-sel.attr-code.
     1530   end.
     1531   END PROCEDURE.
     1532   PROCEDURE fill-table :
     1533   DEFINE INPUT PARAMETER loc-attr-codes as character no-undo.
     1534   DEFINE INPUT PARAMETER loc-attr-labels as character no-undo.
     1535   DEFINE INPUT PARAMETER loc-delim as character no-undo.
     1536   def var ii as integer no-undo.
     1537   if num-entries(loc-attr-codes, loc-delim) <> num-entries(loc-attr-labels, loc-delim) then do:
     1538       message
     1539       vss-workfile vss-revision vss-description skip
     1540       "Неправильный вызов программы d-list.w" skip
     1541       "параметр pattr-codes и параметр pattr-labels имют разное количество элементов списка"
     1542       view-as alert-box error.
     1543       return error.
     1544   end.
     1545   for each temp-sel:
     1546   delete temp-sel.
     1547   end.
     1548   do ii = 1 to num-entries(loc-attr-codes, loc-delim):
     1549   if entry(ii, loc-attr-codes, loc-delim) = "" then NEXT.
     1550   create temp-sel.
     1551   assign
     1552   temp-sel.attr-code = entry(ii, loc-attr-codes, loc-delim)
     1553   temp-sel.attr-label = entry(ii, loc-attr-labels, loc-delim)
     1554   temp-sel.line-num = ii
     1555   .
     1556   If lookup(temp-sel.attr-code, ppresel-codes) > 0 then do:
     1557     rid-list = rid-list + (if rid-list = "":U then "":U else chr(44) ) + string(recid(temp-sel)).
     1558   end.
     1559   end.
     1560   END PROCEDURE.
     1561   PROCEDURE MyEnable :
     1562   ENABLE
     1563   b-quit
     1564   B-mark when lookup("b-mark", bttns) > 0
     1565   B-sel when lookup("b-sel", bttns) > 0
     1566   B-Help BR-list
     1567   WITH FRAME Dialog-Frame.
     1568   frame Dialog-Frame:title = ptitle.
     1569     VIEW FRAME Dialog-Frame.
     1570     OPEN QUERY BR-list FOR EACH temp-sel NO-LOCK.
     1571     APPLY "entry" to br-list in frame Dialog-Frame.
     1572   END PROCEDURE.
     1573   PROCEDURE proc-b-mark :
     1574   def var loc#log as logical no-undo.
     1575     if available temp-sel then do:
     1576   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   define variable v-str-recid4 as character no-undo .
     1578   define variable v-num-entry4 as integer   no-undo .
     1579   assign
     1580     v-str-recid4 = trim( string( recid( temp-sel ) , "->>>>>>>>>>>9":U ) )
     1581     v-num-entry4 = lookup( v-str-recid4 , rid-list )
     1582   .
     1583   if v-num-entry4 > 0 then do:
     1584     assign
     1585       entry( v-num-entry4, rid-list ) = "":U
     1586       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1587     .
     1588   end.
     1589   else do:
     1590     assign
     1591       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid4
     1592     .
     1593   end.
     1594       loc#log = br-list:refresh() in frame Dialog-Frame.
     1595       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1596           loc#log = br-List:select-next-row ().
     1597           apply "iteration-changed" to br-List in frame Dialog-Frame.
     1598       end.
     1599       if num-entries( rid-list ) = 0 then
     1600           hide mark-num in frame Dialog-Frame.
     1601       else
     1602           disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1603       end.
     1604       apply "entry" to br-List in frame Dialog-Frame.
     1605   END PROCEDURE.
