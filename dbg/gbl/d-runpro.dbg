        1   define input parameter parparentproc as widget-handle no-undo .
        2   def var vss-revision    as character no-undo init "$Revision$":U .
        3   def var vss-author      as character no-undo init "$Author$":U .
        4   def var vss-date        as character no-undo init "$Date$":U .
        5   def var vss-workfile    as character no-undo init "$Workfile$":U .
        6   def var vss-archive     as character no-undo init "$Archive$":U .
        7   def var vss-description as character no-undo init "Запуск произвольной процедуры с параметрами".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      112   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      113   function objExists return character
      114   (input  ifolder as character,
      115    input  iType   as character  ):
      116       define variable vFileType as character no-undo init "D,F".
      117       define variable vi        as integer no-undo.
      118       define variable vtype as character no-undo.
      119       if iType ne ?
      120       then
      121          vFileType = iType.
      122       do vi = 1 to num-entries(vFileType):
      123          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      124          vtype = file-information:file-type.
      125          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      126             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      127             index(vtype , entry(vi,vFileType )) > 0
      128          then return file-information:full-pathname .
      129          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      130          vtype = file-information:file-type.
      131          if file-information:file-name <> "" and
      132             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      133             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      134             index( vtype, entry(vi,vFileType )) > 0
      135          then return file-information:full-pathname .
      136       end.
      137       return ? .
      138   end.
      139   function SearchFile return character
      140   (input  ifile as character):
      141      return objExists(ifile,?).
      142   end.
      143   function SearchPFile return character
      144   (input inFile as char):
      145        define variable oFile       as character no-undo.
      146        define variable vFileSearch as character no-undo.
      147        define variable vNumEntry   as integer no-undo.
      148        if inFile = "" then return ?.
      149        vNumEntry = num-entries(inFile,".").
      150        vFileSearch = inFile.
      151        if    vNumEntry > 0
      152           and (   entry(vNumEntry,inFile,".") eq "p"
      153                or entry(vNumEntry,inFile,".") eq "w")
      154        then do:
      155           entry(vNumEntry,vFileSearch, ".") = "r".
      156           oFile = search(vFileSearch ).
      157           if oFile eq ?
      158           then
      159              oFile = search(inFile).
      160        end.
      161        else
      162           oFile = search(vFileSearch).
      163        return oFile.
      164     end.
      165   define temp-table temp-param no-undo
      166     field run-name          as character
      167     field run-date          as date
      168     field run-time          as integer
      169     field num-param         as integer
      170     field param1            as character
      171     field param2            as character
      172     field param3            as character
      173     field run-persistent    as logical
      174     field run-parparentproc as logical
      175     index pi is unique primary run-name
      176     index pi1 run-date run-time
      177   .
      178   define stream runpr.
      179   define stream sReadfile.
      180   define variable v-store-file-name as character no-undo initial "d-runpro.txt" .
      181   DEFINE BUTTON b-exit AUTO-GO
      182        LABEL "&Ввод"
      183        SIZE 10 BY 1
      184        BGCOLOR 8 .
      185   DEFINE BUTTON b-help
      186        LABEL "Помо&щь"
      187        SIZE 10 BY 1
      188        BGCOLOR 8 .
      189   DEFINE BUTTON b-quit AUTO-END-KEY
      190        LABEL "&Отмена"
      191        SIZE 10 BY 1
      192        BGCOLOR 8 .
      193   DEFINE VARIABLE COMBO-BOX-1 AS CHARACTER FORMAT "X(256)":U
      194        VIEW-AS COMBO-BOX INNER-LINES 5
      195        DROP-DOWN-LIST
      196        SIZE 46.38 BY 1 NO-UNDO.
      197   DEFINE VARIABLE FI-Parameter1 AS CHARACTER FORMAT "X(256)":U
      198        VIEW-AS FILL-IN
      199        SIZE 35.63 BY 1 NO-UNDO.
      200   DEFINE VARIABLE FI-Parameter2 AS CHARACTER FORMAT "X(256)":U
      201        VIEW-AS FILL-IN
      202        SIZE 35.63 BY 1 NO-UNDO.
      203   DEFINE VARIABLE FI-Parameter3 AS CHARACTER FORMAT "X(256)":U
      204        VIEW-AS FILL-IN
      205        SIZE 35.63 BY 1 NO-UNDO.
      206   DEFINE VARIABLE fi-procedure AS CHARACTER FORMAT "X(256)":U
      207        LABEL "Процедура"
      208        VIEW-AS FILL-IN
      209        SIZE 44.25 BY 1 NO-UNDO.
      210   DEFINE VARIABLE rs-num-parameters AS INTEGER
      211        VIEW-AS RADIO-SET VERTICAL
      212        RADIO-BUTTONS
      213             "Без доп. параметров", 0,
      214   "1 параметр", 1,
      215   "2 параметра", 2,
      216   "3 параметра", 3
      217        SIZE 23 BY 5.04 NO-UNDO.
      218   DEFINE VARIABLE T-compil AS LOGICAL INITIAL no
      219        LABEL "Не компилировать"
      220        VIEW-AS TOGGLE-BOX
      221        SIZE 22 BY .83 NO-UNDO.
      222   DEFINE VARIABLE T-notsign AS LOGICAL INITIAL no
      223        LABEL "Без подписи"
      224        VIEW-AS TOGGLE-BOX
      225        SIZE 17.5 BY .83 NO-UNDO.
      226   DEFINE VARIABLE T-parparentproc AS LOGICAL INITIAL no
      227        LABEL "parparentproc"
      228        VIEW-AS TOGGLE-BOX
      229        SIZE 17.63 BY .79 NO-UNDO.
      230   DEFINE VARIABLE T-persistent AS LOGICAL INITIAL no
      231        LABEL "persistent"
      232        VIEW-AS TOGGLE-BOX
      233        SIZE 17 BY .79 NO-UNDO.
      234   DEFINE FRAME Dialog-Frame
      235        b-exit AT ROW 1 COL 1
      236        b-quit AT ROW 1 COL 11
      237        b-help AT ROW 1 COL 21
      238        COMBO-BOX-1 AT ROW 2.42 COL 14.75 COLON-ALIGNED NO-LABEL
      239        fi-procedure AT ROW 2.5 COL 14.75 COLON-ALIGNED
      240        T-parparentproc AT ROW 4 COL 3
      241        T-persistent AT ROW 4 COL 27
      242        rs-num-parameters AT ROW 5.25 COL 3 NO-LABEL
      243        FI-Parameter1 AT ROW 6.5 COL 25.63 COLON-ALIGNED NO-LABEL
      244        FI-Parameter2 AT ROW 7.88 COL 25.63 COLON-ALIGNED NO-LABEL
      245        FI-Parameter3 AT ROW 9.21 COL 25.63 COLON-ALIGNED NO-LABEL
      246        T-compil AT ROW 10.5 COL 3 WIDGET-ID 2
      247        T-notsign AT ROW 10.5 COL 26 WIDGET-ID 4
      248        SPACE(20.24) SKIP(0.83)
      249       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      250            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      251            TITLE "Запуск процедуры"
      252            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      253   ASSIGN
      254          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      255          FRAME Dialog-Frame:HIDDEN           = TRUE.
      256   ASSIGN
      257          T-compil:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      258   ASSIGN
      259          T-notsign:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      260   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      261   DO:
      262     APPLY "END-ERROR":U TO SELF.
      263   END.
      264   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      265   DO:
      266     run run-procedure in this-procedure no-error.
      267     if error-status:error then do:
      268       message
      269         vss-workfile vss-revision vss-description skip
      270         substitute("Ошибка при запуске процедуры") skip
      271         error-status :get-message(1) skip
      272         return-value skip
      273         view-as alert-box error .
      274       return no-apply .
      275     end.
      276   END.
      277   ON VALUE-CHANGED OF COMBO-BOX-1 IN FRAME Dialog-Frame
      278   DO:
      279     ASSIGN COMBO-BOX-1 .
      280     run display-procedure-parameters in this-procedure .
      281    END.
      282   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      283   on help of frame Dialog-Frame
      284   do:
      285     run gbl/app_help.p
      286       (input this-procedure :file-name
      287       ,input ''
      288       ,input ?
      289       ) no-error.
      290     if error-status :error then do:
      291       message
      292         "Ошибка при вызове помощи"
      293         error-status :get-message(1)
      294         view-as alert-box .
      295     end.
      296   end.
      297   run minbtn-set in this-procedure .
      298   on choose of b-help in frame Dialog-Frame
      299   do:
      300     apply "help":u to frame Dialog-Frame .
      301   end.
      302   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   procedure minbtn-set :
      304       do
      305           on error undo, return error return-value
      306           :
      307           define variable ii              as integer       no-undo .
      308           define variable fh              as widget-handle no-undo .
      309           define variable hh              as widget-handle no-undo .
      310           define variable v-h             as handle        extent 4 no-undo .
      311           define variable v-name-button   as character     no-undo .
      312           define variable v-help-old-x    as decimal       no-undo .
      313           define variable v-help-old-y    as decimal       no-undo .
      314           define variable v-help-old-size as decimal       no-undo .
      315           define variable v-frame-width   as decimal       no-undo .
      316           define variable jj              as integer       no-undo .
      317           do
      318               on error undo, return error
      319               :
      320               assign
      321                   v-frame-width = frame Dialog-Frame:width - 0.3
      322                   fh            = frame Dialog-Frame:first-child
      323                   hh            = fh:first-child
      324                   ii            = 1
      325                   .
      326               do while valid-handle(hh):
      327                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      328                   do:
      329                       case lc(hh:name) :
      330                           when "b-help" then
      331                               do:
      332                                   hh:load-image-up("cmp/b-help.bmp":u) .
      333                                   hh:load-image-down("cmp/b-help.bmp":u) .
      334                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      335                                   hh:TOOLTIP = "Помощь" .
      336                                   v-help-old-x = hh:column .
      337                                   v-help-old-y = hh:row    .
      338                                   v-help-old-size = hh:width .
      339                                   hh:width-chars = 2.5 .
      340                               end.
      341                           when "b-print" then
      342                               do:
      343                                   hh:load-image("cmp/b-print.bmp":u) .
      344                                   hh:TOOLTIP = "Печать" .
      345                                   v-h[ii] = hh:handle .
      346                                   ii = ii + 1 .
      347                                   hh:width-chars = 3 .
      348                               end.
      349                           when "b-history" or
      350                           when "b-hist" then
      351                               do:
      352                                   hh:load-image("cmp/b-hist.bmp":u) .
      353                                   hh:TOOLTIP = "История" .
      354                                   v-h[ii] = hh:handle .
      355                                   ii = ii + 1 .
      356                                   hh:width-chars = 3 .
      357                               end.
      358                           when "b-sch" then
      359                               do:
      360                                   hh:load-image("cmp/b-sch.bmp":u) .
      361                                   hh:TOOLTIP = "Установка Фильтра" .
      362                                   v-h[ii] = hh:handle .
      363                                   ii = ii + 1 .
      364                                   hh:width-chars = 3 .
      365                               end.
      366                           when "b-hist-user" then
      367                               do:
      368                                   hh:load-image("cmp/b-hist.bmp":u) .
      369                                   hh:TOOLTIP = "История пользователя" .
      370                                   ii = ii + 1 .
      371                               end.
      372                       end case.
      373                   end.
      374                   hh = hh:next-sibling.
      375               end.
      376               b-help:column = v-frame-width - b-help:width-chars.
      377               jj = 0.
      378               repeat ii = 4 to 1 by -1 :
      379                   if valid-handle (v-h[ii] ) then
      380                   do:
      381                       jj  = jj + 1 .
      382                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      383                       v-h[ii]:row    = v-help-old-y .
      384                   end.
      385               end.
      386           end.
      387       end.
      388   end procedure.
      389   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      390   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      391   MAIN-BLOCK:
      392   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      393      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      394     if SearchFile(v-store-file-name) <> ?
      395     then do:
      396       run fill-temp in this-procedure .
      397       run fill-combo-box-list in this-procedure .
      398     end.
      399     RUN enable_UI .
      400     if parparentproc <> ?
      401     and valid-handle(parparentproc)
      402     then do:
      403       assign
      404         t-parparentproc :sensitive = true
      405       .
      406     end.
      407     if not objSrv:SystemSetting:DeveloperMode
      408     then
      409        assign
      410           T-compil:hidden  = no
      411           T-notsign:hidden = no
      412        .
      413     for each temp-param
      414     by temp-param.run-date descending
      415     by temp-param.run-time descending
      416     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      417     :
      418       assign
      419         COMBO-BOX-1  :screen-value in frame Dialog-Frame = temp-param.run-name
      420       .
      421       run display-procedure-parameters in this-procedure .
      422       leave .
      423     end.
      424     apply 'entry':u to fi-procedure  in frame Dialog-Frame .
      425     WAIT-FOR GO OF FRAME Dialog-Frame.
      426   END.
      427   RUN disable_UI.
      428   PROCEDURE disable_UI :
      429     HIDE FRAME Dialog-Frame.
      430   END PROCEDURE.
      431   PROCEDURE display-procedure-parameters :
      432     do with frame Dialog-Frame
      433     :
      434       find first temp-param
      435         where temp-param.run-name = combo-box-1 :screen-value
      436         no-error .
      437       if available temp-param
      438       then do:
      439         assign
      440           fi-procedure  :screen-value = temp-param.run-name
      441           rs-num-parameters           = temp-param.num-param
      442           fi-parameter1 :screen-value = temp-param.param1
      443           fi-parameter2 :screen-value = temp-param.param2
      444           fi-parameter3 :screen-value = temp-param.param3
      445           t-persistent                = temp-param.run-persistent
      446         .
      447         if t-parparentproc :sensitive = true then do:
      448           assign
      449             t-parparentproc = temp-param.run-parparentproc
      450           .
      451         end.
      452       end.
      453       display
      454         t-parparentproc
      455         t-persistent
      456         rs-num-parameters
      457         with frame Dialog-Frame .
      458     end.
      459   END PROCEDURE.
      460   PROCEDURE enable_UI :
      461     DISPLAY COMBO-BOX-1 fi-procedure T-parparentproc T-persistent
      462             rs-num-parameters FI-Parameter1 FI-Parameter2 FI-Parameter3 T-compil
      463             T-notsign
      464         WITH FRAME Dialog-Frame.
      465     ENABLE b-exit b-quit b-help COMBO-BOX-1 fi-procedure T-persistent
      466            rs-num-parameters FI-Parameter1 FI-Parameter2 FI-Parameter3 T-compil
      467            T-notsign
      468         WITH FRAME Dialog-Frame.
      469     VIEW FRAME Dialog-Frame.
      470   END PROCEDURE.
      471   PROCEDURE fill-combo-box-list :
      472     do with frame Dialog-Frame
      473     :
      474       define variable v-file-list as character no-undo .
      475       assign
      476         v-file-list = '':U
      477       .
      478       for each temp-param
      479       by temp-param.run-date descending
      480       by temp-param.run-time descending
      481       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      482       :
      483         assign
      484           v-file-list = v-file-list
      485                       + (if v-file-list = '':U then '':U else ',':U )
      486                       + temp-param.run-name
      487         .
      488       end.
      489       assign
      490         combo-box-1 :list-items = v-file-list
      491       .
      492     end.
      493   END PROCEDURE.
      494   PROCEDURE fill-temp :
      495     define variable v-run-name          as character no-undo .
      496     define variable v-run-date          as date      no-undo .
      497     define variable v-run-time          as integer   no-undo .
      498     define variable v-num-param         as integer   no-undo .
      499     define variable v-param1            as character no-undo .
      500     define variable v-param2            as character no-undo .
      501     define variable v-param3            as character no-undo .
      502     define variable v-run-persistent    as logical   no-undo .
      503     define variable v-run-parparentproc as logical   no-undo .
      504     input stream runpr from value(v-store-file-name) .
      505     repeat
      506     :
      507       assign
      508         v-run-name          = '':U
      509         v-run-date          = ?
      510         v-run-time          = 0
      511         v-num-param         = 0
      512         v-param1            = '':U
      513         v-param2            = '':U
      514         v-param3            = '':U
      515         v-run-persistent    = false
      516         v-run-parparentproc = false
      517       .
      518       import stream runpr
      519         v-run-name
      520         v-run-date
      521         v-run-time
      522         v-num-param
      523         v-param1
      524         v-param2
      525         v-param3
      526         v-run-persistent
      527         v-run-parparentproc
      528         .
      529       create temp-param .
      530       assign
      531         temp-param.run-name          = v-run-name
      532         temp-param.run-date          = v-run-date
      533         temp-param.run-time          = v-run-time
      534         temp-param.num-param         = v-num-param
      535         temp-param.param1            = v-param1
      536         temp-param.param2            = v-param2
      537         temp-param.param3            = v-param3
      538         temp-param.run-persistent    = v-run-persistent
      539         temp-param.run-parparentproc = v-run-parparentproc
      540       .
      541     end.
      542     input stream runpr close .
      543   END PROCEDURE.
      544   PROCEDURE run-procedure :
      545     def var lok             as logical   no-undo .
      546     def var h-proc-handle   as handle    no-undo .
      547     def var v-proc-name      as character no-undo .
      548     def var v-num-parameters as integer   no-undo .
      549     def var v-parameter1     as character no-undo .
      550     def var v-parameter2     as character no-undo .
      551     def var v-parameter3     as character no-undo .
      552     define variable  str-tmp as character no-undo .
      553     define variable  num-pt  as integer   no-undo .
      554     do with frame Dialog-Frame:
      555       assign
      556         rs-num-parameters
      557         t-persistent
      558         t-parparentproc
      559         t-compil
      560         t-notsign
      561         .
      562       assign
      563         v-proc-name      = fi-procedure  :screen-value
      564         v-num-parameters = rs-num-parameters
      565         v-parameter1     = fi-parameter1 :screen-value
      566         v-parameter2     = fi-parameter2 :screen-value
      567         v-parameter3     = fi-parameter3 :screen-value
      568       .
      569       if v-proc-name = '':U
      570       then do:
      571         message
      572           "Необходимо ввести имя процедуры"
      573           view-as alert-box information .
      574         apply "entry":U to fi-procedure .
      575         undo, return error .
      576       end.
      577       if SearchFile(v-proc-name) = ?
      578       then do:
      579         search_block:
      580         do
      581         :
      582           define variable v-index-sub-dir       as integer   no-undo .
      583           define variable v-sub-dir-list        as character no-undo .
      584           define variable v-num-entries-sub-dir as integer   no-undo .
      585           define variable v-sub-dir-item        as character no-undo .
      586           define variable v-index-suffix        as integer   no-undo .
      587           define variable v-suffix-list         as character no-undo .
      588           define variable v-num-entries-suffix  as integer   no-undo .
      589           define variable v-suffix-item         as character no-undo .
      590           define variable v-search-proc-name    as character no-undo .
      591           define variable v-use-prog            as logical   no-undo .
      592           assign
      593             v-sub-dir-list        = ',adm/,arc/,bge/,cmp/,cus/,exe/,gbl/,nws/,osn/,rcs/,ref/,rep/,str/,trg/,utl/':U
      594             v-num-entries-sub-dir = num-entries(v-sub-dir-list)
      595             v-suffix-list         = ',.p,.w':U
      596             v-num-entries-suffix  = num-entries(v-suffix-list)
      597           .
      598           do v-index-sub-dir = 1 to v-num-entries-sub-dir
      599           :
      600             assign
      601               v-sub-dir-item = entry(v-index-sub-dir, v-sub-dir-list)
      602             .
      603             do v-index-suffix = 1 to v-num-entries-suffix
      604             :
      605               assign
      606                 v-suffix-item = entry(v-index-suffix, v-suffix-list)
      607               .
      608               assign
      609                 v-search-proc-name = SearchFile(v-sub-dir-item + v-proc-name + v-suffix-item)
      610               .
      611               if v-search-proc-name <> ?
      612               then do:
      613                 message
      614                   substitute("Найдена процедура &1", v-search-proc-name) skip
      615                   "Запустить её?" skip
      616                   view-as alert-box question buttons yes-no update v-use-prog .
      617                 if v-use-prog = true
      618                 then do:
      619                   assign
      620                     v-proc-name = v-sub-dir-item + v-proc-name + v-suffix-item
      621                   .
      622                   leave search_block .
      623                 end.
      624               end.
      625             end.
      626           end.
      627         end.
      628       end.
      629       if SearchFile(v-proc-name) = ?
      630       then do:
      631          message
      632             substitute("Не найдена процедура &1", v-proc-name)
      633          view-as alert-box.
      634          return no-apply.
      635       end.
      636       find first temp-param
      637         where temp-param.run-name = v-proc-name
      638         no-error .
      639       if not available temp-param
      640       then do:
      641         create temp-param .
      642         assign
      643           temp-param.run-name = v-proc-name
      644         .
      645       end.
      646       assign
      647         temp-param.num-param         = v-num-parameters
      648         temp-param.param1            = v-parameter1
      649         temp-param.param2            = v-parameter2
      650         temp-param.param3            = v-parameter3
      651         temp-param.run-persistent    = t-persistent
      652         temp-param.run-date          = today
      653         temp-param.run-time          = time
      654       .
      655       if t-parparentproc :sensitive = true then do:
      656         assign
      657           temp-param.run-parparentproc = t-parparentproc
      658         .
      659       end.
      660       run write-temp in this-procedure .
      661       run fill-combo-box-list in this-procedure .
      662       do
      663       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      664       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      665       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      666       :
      667          define variable vKey as integer no-undo.
      668          define variable vCheksum as character no-undo.
      669          define variable vlogfile as character no-undo.
      670          define variable vText as character no-undo.
      671          define variable vError as logical no-undo init yes.
      672          define variable vParamlist as character no-undo.
      673          if     objSrv:SystemSetting:DeveloperMode
      674             and T-compil:sensitive
      675             and not T-compil
      676          then do:
      677             run utl\compiler.p(input-output v-proc-name).
      678             if v-proc-name eq ?
      679             then return error.
      680          end.
      681          if T-notsign:sensitive
      682             and T-notsign
      683          then
      684             verror = no.
      685          else do:
      686             vKey = random(1,999999999).
      687             define variable vAsyncHelper as class ibs.th.file.AsyncHelperth no-undo.
      688             vAsyncHelper = new ibs.th.file.AsyncHelperth().
      689             vAsyncHelper:MyUser =  "".
      690             vAsyncHelper:MyPass =  "nocrypt:".
      691             vAsyncHelper:MyBachMode = no.
      692             vAsyncHelper:AsyncProc("utl/proc-chekproc", substitute("&1&8&2&8&3&8&4&8&5&8&6&8&7":U
      693                                                       , SearchFile(v-proc-name) ,v-num-parameters, t-parparentproc :checked, vKey,v-parameter1,v-parameter2,v-parameter3,chr(4) ),1).
      694             vAsyncHelper:myTimeOut = 300.
      695             run ibs\th\file\waithelper.p (vAsyncHelper,"proc-chekproc", 1,"Проверка процедуры.").
      696             vtext = "Процедура имеет не правильную подпись.".
      697             vlogfile = vAsyncHelper:getlog(?).
      698             if vAsyncHelper:FileExists(vlogfile)
      699             then do:
      700                input stream sReadfile FROM  VALUE(vlogfile).
      701                repeat:
      702                   import stream sReadfile unformatted vText.
      703                   if vtext begins "error"
      704                   then assign
      705                      vtext = substring(vtext,7)
      706                   .
      707                   else do:
      708                      vCheksum = vText.
      709                      if (vCheksum ne encode(string(vKey * 13)) + string(index(encode(string(vKey)), "k"))
      710    )
      711                      then assign
      712                         vtext = "Процедура имеет не правильную подпись."
      713                      .
      714                      else
      715                         vError = no.
      716                   end.
      717                end.
      718                input stream sReadfile close  .
      719                os-delete value(vlogfile).
      720             end.
      721             else assign
      722                 vtext = "Не получен результат проверки."
      723                 vError = yes.
      724             vAsyncHelper:delworkdir().
      725             delete object vAsyncHelper.
      726          end.
      727          if vError
      728          then do:
      729             run trg/userlog.p (
      730                   input 'run-proc'
      731                   , input (substitute( "&1. Не прошла проверка подписи. &2", vss-workfile, vtext)  + chr(3) + v-proc-name )
      732                   , input ?
      733                   , input ?
      734                   , input "") no-error.
      735             undo, return error substitute( "&1. Не прошла проверка подписи. &2", vss-workfile, vtext) .
      736          end.
      737          else do:
      738             if can-do("true,yes", t-persistent :screen-value)
      739             then do:
      740                 case v-num-parameters :
      741                   when 0
      742                   then do:
      743                      vParamlist = "".
      744                   end.
      745                   when 1
      746                   then do:
      747                      vParamlist = v-parameter1.
      748                   end.
      749                   when 2
      750                   then do:
      751                      vParamlist = v-parameter1 + "|" + v-parameter2.
      752                   end.
      753                   when 3
      754                   then do:
      755                      vParamlist = v-parameter1 + "|" + v-parameter2 + "|" + v-parameter3.
      756                   end.
      757                end.
      758                run trg/userlog.p (
      759                   input 'run-proc'
      760                   , input ("Начато выполнение процедуры "  + chr(3) + v-proc-name  + chr(3) + vParamlist)
      761                   , input ?
      762                   , input ?
      763                   , input "") no-error.
      764                case v-num-parameters :
      765                   when 0
      766                   then do:
      767                      vParamlist = "".
      768                      if parparentproc <> ?
      769                     and valid-handle(parparentproc)
      770                     and t-parparentproc :checked
      771                      then do:
      772                         run value (v-proc-name) persistent set h-proc-handle
      773                            (input vkey
      774                            ,output vCheksum
      775                            ,input parparentproc
      776                          ) no-error .
      777                      end.
      778                      else do:
      779                         run value (v-proc-name) persistent set h-proc-handle
      780                             (input vkey
      781                             ,output vCheksum
      782                              )no-error.
      783                      end.
      784                   end.
      785                   when 1
      786                   then do:
      787                      vParamlist = v-parameter1.
      788                      if parparentproc <> ?
      789                      and valid-handle(parparentproc)
      790                      and t-parparentproc :checked
      791                      then do:
      792                         run value (v-proc-name) persistent set h-proc-handle
      793                            (input vkey
      794                            ,output vCheksum
      795                            ,input parparentproc
      796                            ,input v-parameter1
      797                            )no-error.
      798                      end.
      799                      else do:
      800                         run value (v-proc-name) persistent set h-proc-handle
      801                            (input vkey
      802                            ,output vCheksum
      803                            ,input v-parameter1
      804                            ) no-error .
      805                      end.
      806                   end.
      807                   when 2
      808                   then do:
      809                      vParamlist = v-parameter1 + "|" + v-parameter2.
      810                      if parparentproc <> ?
      811                      and valid-handle(parparentproc)
      812                      and t-parparentproc :checked
      813                      then do:
      814                         run value (v-proc-name) persistent set h-proc-handle
      815                            (input vkey
      816                            ,output vCheksum
      817                            ,input parparentproc
      818                            ,input v-parameter1
      819                            ,input v-parameter2
      820                            ) no-error.
      821                      end.
      822                      else do:
      823                         run value (v-proc-name) persistent set h-proc-handle
      824                            (input vkey
      825                            ,output vCheksum
      826                            ,input v-parameter1
      827                            ,input v-parameter2
      828                            ) no-error.
      829                      end.
      830                   end.
      831                   when 3
      832                   then do:
      833                      vParamlist = v-parameter1 + "|" + v-parameter2 + "|" + v-parameter3.
      834                      if parparentproc <> ?
      835                      and valid-handle(parparentproc)
      836                      and t-parparentproc :checked
      837                      then do:
      838                         run value (v-proc-name) persistent set h-proc-handle
      839                            (input vkey
      840                            ,output vCheksum
      841                            ,input parparentproc
      842                            ,input v-parameter1
      843                            ,input v-parameter2
      844                            ,input v-parameter3
      845                            ) no-error.
      846                      end.
      847                      else do:
      848                         run value (v-proc-name) persistent set h-proc-handle
      849                            (input vkey
      850                            ,output vCheksum
      851                            ,input v-parameter1
      852                            ,input v-parameter2
      853                            ,input v-parameter3
      854                            ) no-error.
      855                      end.
      856                   end.
      857                end case .
      858                if not error-status:error
      859                then
      860                   message
      861                      "Процедура запущена" skip
      862                      "Указатель процедуры" h-proc-handle skip
      863                      view-as alert-box .
      864             end.
      865             else do:
      866                case v-num-parameters :
      867                   when 0
      868                   then do:
      869                      vParamlist = "".
      870                      if parparentproc <> ?
      871                     and valid-handle(parparentproc)
      872                     and t-parparentproc :checked
      873                      then do:
      874                         run value (v-proc-name)
      875                            (input vkey
      876                            ,output vCheksum
      877                            ,input parparentproc
      878                            ) no-error .
      879                      end.
      880                      else do:
      881                         run value (v-proc-name)
      882                            (input vkey
      883                            ,output vCheksum
      884                            ) no-error.
      885                      end.
      886                   end.
      887                   when 1
      888                   then do:
      889                      vParamlist = v-parameter1.
      890                      if parparentproc <> ?
      891                     and valid-handle(parparentproc)
      892                     and t-parparentproc :checked
      893                      then do:
      894                         run value (v-proc-name)
      895                            (input vkey
      896                            ,output vCheksum
      897                            ,input parparentproc
      898                            ,input v-parameter1
      899                            )no-error.
      900                      end.
      901                      else do:
      902                         run value (v-proc-name)
      903                            (input vkey
      904                            ,output vCheksum
      905                            ,input v-parameter1
      906                            )no-error.
      907                      end.
      908                   end.
      909                   when 2
      910                   then do:
      911                      vParamlist = v-parameter1 + "|" + v-parameter2 .
      912                      if parparentproc <> ?
      913                     and valid-handle(parparentproc)
      914                     and t-parparentproc :checked
      915                      then do:
      916                         run value (v-proc-name)
      917                            (input vkey
      918                            ,output vCheksum
      919                            ,input parparentproc
      920                            ,input v-parameter1
      921                            ,input v-parameter2
      922                            )no-error.
      923                      end.
      924                      else do:
      925                         run value (v-proc-name)
      926                            (input vkey
      927                            ,output vCheksum
      928                            ,input v-parameter1
      929                            ,input v-parameter2
      930                            )no-error.
      931                      end.
      932                   end.
      933                   when 3
      934                   then do:
      935                      vParamlist = v-parameter1 + "|" + v-parameter2 + "|" + v-parameter3.
      936                      if parparentproc <> ?
      937                     and valid-handle(parparentproc)
      938                     and t-parparentproc :checked
      939                      then do:
      940                         run value (v-proc-name)
      941                            (input vkey
      942                            ,output vCheksum
      943                            ,input parparentproc
      944                            ,input v-parameter1
      945                            ,input v-parameter2
      946                            ,input v-parameter3
      947                            )no-error.
      948                      end.
      949                      else do:
      950                         run value (v-proc-name)
      951                            (input vkey
      952                            ,output vCheksum
      953                            ,input v-parameter1
      954                            ,input v-parameter2
      955                            ,input v-parameter3
      956                            )no-error.
      957                      end.
      958                   end.
      959                end case.
      960             end.
      961             if not error-status :error
      962             then do:
      963                run trg/userlog.p (
      964                   input 'run-proc'
      965                   , input ("Завершено выполнение процедуры без ошибок "  + chr(3) + v-proc-name  + chr(3) + vParamlist)
      966                   , input ?
      967                   , input ?
      968                   , input "") no-error.
      969                return.
      970             end.
      971             else if  not objSrv:SystemSetting:DeveloperMode
      972             then do:
      973                run trg/userlog.p (
      974                   input 'run-proc'
      975                   , input ("Завершено выполнение процедуры с ошибками "  + chr(3) + v-proc-name + chr(3) + vParamlist)
      976                   , input ?
      977                   , input ?
      978                   , input "") no-error.
      979                undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ).
      980             end.
      981             message "Данная процедура не запустится у клиент."
      982                view-as alert-box warning .
      983             if can-do("true,yes", t-persistent :screen-value)
      984             then do:
      985                case v-num-parameters :
      986                   when 0
      987                   then do:
      988                      if parparentproc <> ?
      989                     and valid-handle(parparentproc)
      990                     and t-parparentproc :checked
      991                      then do:
      992                         run value (v-proc-name) persistent set h-proc-handle
      993                            (input parparentproc
      994                            ) .
      995                      end.
      996                      else do:
      997                         run value (v-proc-name) persistent set h-proc-handle .
      998                      end.
      999                   end.
     1000                   when 1
     1001                   then do:
     1002                      if parparentproc <> ?
     1003                     and valid-handle(parparentproc)
     1004                     and t-parparentproc :checked
     1005                      then do:
     1006                         run value (v-proc-name) persistent set h-proc-handle
     1007                            (input parparentproc
     1008                            ,input v-parameter1
     1009                            ) .
     1010                      end.
     1011                      else do:
     1012                         run value (v-proc-name) persistent set h-proc-handle
     1013                            (input v-parameter1
     1014                            ) .
     1015                      end.
     1016                   end.
     1017                   when 2
     1018                   then do:
     1019                      if parparentproc <> ?
     1020                     and valid-handle(parparentproc)
     1021                     and t-parparentproc :checked
     1022                      then do:
     1023                         run value (v-proc-name) persistent set h-proc-handle
     1024                            (input parparentproc
     1025                            ,input v-parameter1
     1026                            ,input v-parameter2
     1027                            ) .
     1028                      end.
     1029                      else do:
     1030                         run value (v-proc-name) persistent set h-proc-handle
     1031                            (input v-parameter1
     1032                            ,input v-parameter2
     1033                            ) .
     1034                      end.
     1035                   end.
     1036                   when 3
     1037                   then do:
     1038                      if parparentproc <> ?
     1039                     and valid-handle(parparentproc)
     1040                     and t-parparentproc :checked
     1041                      then do:
     1042                         run value (v-proc-name) persistent set h-proc-handle
     1043                            (input parparentproc
     1044                            ,input v-parameter1
     1045                            ,input v-parameter2
     1046                            ,input v-parameter3
     1047                            ) .
     1048                      end.
     1049                      else do:
     1050                         run value (v-proc-name) persistent set h-proc-handle
     1051                            (input v-parameter1
     1052                            ,input v-parameter2
     1053                            ,input v-parameter3
     1054                            ) .
     1055                      end.
     1056                   end.
     1057                end case .
     1058                message
     1059                   "Процедура запущена" skip
     1060                   "Указатель процедуры" h-proc-handle skip
     1061                   view-as alert-box .
     1062             end.
     1063             else do:
     1064                case v-num-parameters :
     1065                   when 0
     1066                   then do:
     1067                      if parparentproc <> ?
     1068                     and valid-handle(parparentproc)
     1069                     and t-parparentproc :checked
     1070                      then do:
     1071                         run value (v-proc-name)
     1072                            (input parparentproc
     1073                            ) .
     1074                      end.
     1075                      else do:
     1076                         run value (v-proc-name)
     1077                            .
     1078                      end.
     1079                   end.
     1080                   when 1
     1081                   then do:
     1082                      if parparentproc <> ?
     1083                     and valid-handle(parparentproc)
     1084                     and t-parparentproc :checked
     1085                      then do:
     1086                         run value (v-proc-name)
     1087                            (input parparentproc
     1088                            ,input v-parameter1
     1089                            ).
     1090                      end.
     1091                      else do:
     1092                         run value (v-proc-name)
     1093                            (input v-parameter1
     1094                            ).
     1095                      end.
     1096                   end.
     1097                   when 2
     1098                   then do:
     1099                      if parparentproc <> ?
     1100                     and valid-handle(parparentproc)
     1101                     and t-parparentproc :checked
     1102                      then do:
     1103                         run value (v-proc-name)
     1104                            (input parparentproc
     1105                            ,input v-parameter1
     1106                            ,input v-parameter2
     1107                            ).
     1108                      end.
     1109                      else do:
     1110                         run value (v-proc-name)
     1111                            (input v-parameter1
     1112                            ,input v-parameter2
     1113                            ).
     1114                      end.
     1115                   end.
     1116                   when 3
     1117                   then do:
     1118                      if parparentproc <> ?
     1119                     and valid-handle(parparentproc)
     1120                     and t-parparentproc :checked
     1121                      then do:
     1122                         run value (v-proc-name)
     1123                            (input parparentproc
     1124                            ,input v-parameter1
     1125                            ,input v-parameter2
     1126                            ,input v-parameter3
     1127                            ).
     1128                      end.
     1129                      else do:
     1130                         run value (v-proc-name)
     1131                            (input v-parameter1
     1132                            ,input v-parameter2
     1133                            ,input v-parameter3
     1134                            ).
     1135                      end.
     1136                   end.
     1137                end case.
     1138                run trg/userlog.p (
     1139                   input 'run-proc'
     1140                   , input ("Выполнена процедура"  + chr(3) + v-proc-name + chr(3) + vParamlist)
     1141                   , input ?
     1142                   , input ?
     1143                   , input "") no-error.
     1144             end.
     1145          end.
     1146       end.
     1147     end.
     1148   END PROCEDURE.
     1149   PROCEDURE write-temp :
     1150     define variable v-ind as integer   no-undo .
     1151     output stream runpr to value(v-store-file-name) .
     1152     for each temp-param
     1153     by temp-param.run-date descending
     1154     by temp-param.run-time descending
     1155     on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1156     :
     1157       if temp-param.run-name <> '':U
     1158       then do:
     1159         export stream runpr temp-param .
     1160         assign
     1161           v-ind = v-ind + 1
     1162         .
     1163         if v-ind >= 10 then do:
     1164           leave .
     1165         end.
     1166       end.
     1167     end.
     1168     output stream runpr close .
     1169   END PROCEDURE.
