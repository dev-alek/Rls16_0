     1124       end.
     1125     end.
     1126     return no-apply .
     1127   end.
     1128   on ctrl-f of f-date-2 in frame Dialog-Frame
     1129   do:
     1130     if (can-query (self, "sensitive")
     1131        and
     1132        self :sensitive = true
     1133        )
     1134     or (can-query (self, "read-only")
     1135        and
     1136        self :read-only = false
     1137        )
     1138     then do:
     1139       if self :handle <> focus :handle
     1140       then do:
     1141         apply "entry":u to self .
     1142       end.
     1143       define variable v-ok            as logical   no-undo .
     1144       define variable v-curr-sv-date  as date      no-undo .
     1145       define variable v-description   as character no-undo .
     1146       assign
     1147         v-curr-sv-date = date(self :screen-value) no-error
     1148       .
     1149       if v-curr-sv-date = ?
     1150       then do:
     1151         run gbl/getcurdt.p
     1152           (output v-curr-sv-date
     1153           ) .
     1154       end.
     1155       if v-curr-sv-date <> ?
     1156       then do:
     1157         run gbl/d-inpday.w
     1158           (input ?
     1159           ,input "Выбор даты"
     1160           ,input v-description
     1161           ,input ""
     1162           ,input-output v-curr-sv-date
     1163           ,output v-ok
     1164           ).
     1165         if v-ok = true
     1166         then do:
     1167           assign
     1168             self :screen-value = string(v-curr-sv-date) .
     1169           .
     1170         end.
     1171       end.
     1172     end.
     1173     return no-apply .
     1174   end.
     1175     define MENU m-ed-date6
     1176       MENU-ITEM m-ed-date6-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1177       MENU-ITEM m-ed-date6-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1178       MENU-ITEM m-ed-date6-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1179       MENU-ITEM m-ed-date6-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1180       .
     1181     if f-date-2 :POPUP-MENU in frame Dialog-Frame = ?
     1182     then do:
     1183       ASSIGN
     1184         f-date-2 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date6 :HANDLE
     1185         f-date-2 :MENU-MOUSE in frame Dialog-Frame = 3
     1186       .
     1187     end.
     1188     define variable v-label-handle6 as handle no-undo .
     1189     assign
     1190       v-label-handle6 = f-date-2 :side-label-handle in frame Dialog-Frame
     1191     .
     1192     if valid-handle (v-label-handle6)
     1193     then do:
     1194       if v-label-handle6 :tooltip = ""
     1195       or v-label-handle6 :tooltip = ?
     1196       then do:
     1197         assign
     1198           v-label-handle6 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1199         .
     1200       end.
     1201     end.
     1202     ON CHOOSE OF MENU-ITEM m-ed-date6-1 in menu m-ed-date6 DO:
     1203       apply "ctrl-b":U to f-date-2 in frame Dialog-Frame .
     1204     END.
     1205     ON CHOOSE OF MENU-ITEM m-ed-date6-2 in menu m-ed-date6 DO:
     1206       apply "ctrl-d":U to f-date-2 in frame Dialog-Frame .
     1207     END.
     1208     ON CHOOSE OF MENU-ITEM m-ed-date6-3 in menu m-ed-date6 DO:
     1209       apply "ctrl-e":U to f-date-2 in frame Dialog-Frame .
     1210     END.
     1211     ON CHOOSE OF MENU-ITEM m-ed-date6-4 in menu m-ed-date6 DO:
     1212       apply "ctrl-f":U to f-date-2 in frame Dialog-Frame .
     1213     END.
     1214   MAIN-BLOCK:
     1215   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1216      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1217     RUN Myenable.
     1218     WAIT-FOR GO OF FRAME Dialog-Frame.
     1219   END.
     1220   RUN disable_UI.
     1221   PROCEDURE disable_UI :
     1222     HIDE FRAME Dialog-Frame.
     1223   END PROCEDURE.
     1224   PROCEDURE enable_UI :
     1225     DISPLAY f-date-1 l-loc-hour-1 l-loc-min-1 l-loc-sec-1 f-date-2 l-loc-hour-2
     1226             l-loc-min-2 l-loc-sec-2 F-delim-11 F-delim-12 F-delim-21 F-delim-22
     1227         WITH FRAME Dialog-Frame.
     1228     ENABLE B-exit b-quit B-Help f-date-1 l-loc-hour-1 l-loc-min-1 l-loc-sec-1
     1229            f-date-2 l-loc-hour-2 l-loc-min-2 l-loc-sec-2 F-delim-11 F-delim-12
     1230            F-delim-21 F-delim-22
     1231         WITH FRAME Dialog-Frame.
     1232     VIEW FRAME Dialog-Frame.
     1233   END PROCEDURE.
     1234   PROCEDURE Myenable :
     1235   ASSIGN
     1236   f-date-1 = p-date-1
     1237   f-date-2 = p-date-2
     1238   l-loc-hour-1  = integer(substring(string(p-time-1, "hh:mm:ss":U), 1, 2))
     1239   l-loc-min-1  = integer(substring(string(p-time-1, "hh:mm:ss":U), 4, 2))
     1240   l-loc-sec-1 = integer(substring(string(p-time-1, "hh:mm:ss":U), 7, 2))
     1241   l-loc-hour-2  = integer(substring(string(p-time-2, "hh:mm:ss":U), 1, 2))
     1242   l-loc-min-2  = integer(substring(string(p-time-2, "hh:mm:ss":U), 4, 2))
     1243   l-loc-sec-2 = integer(substring(string(p-time-2, "hh:mm:ss":U), 7, 2))
     1244   FRAME Dialog-Frame:TITLE = ENTRY(1, p-title-label, chr(4))
     1245   f-date-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 1
     1246                                            THEN ENTRY(2, p-title-label, chr(4))
     1247                                            ELSE f-date-1:LABEL IN FRAME Dialog-Frame)
     1248   f-date-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 2
     1249                                           THEN ENTRY(3, p-title-label, chr(4))
     1250                                           ELSE f-date-2:LABEL IN FRAME Dialog-Frame)
     1251   l-loc-hour-1:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 3
     1252                                               THEN ENTRY(4, p-title-label, chr(4))
     1253                                               ELSE l-loc-hour-1:LABEL IN FRAME Dialog-Frame)
     1254   l-loc-hour-2:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title-label, chr(4)) > 4
     1255                                               THEN ENTRY(5, p-title-label, chr(4))
     1256                                               ELSE l-loc-hour-2:LABEL IN FRAME Dialog-Frame)
     1257   .
     1258   DISPLAY
     1259   f-date-1
     1260   l-loc-hour-1
     1261   l-loc-min-1
     1262   f-delim-11
     1263   WITH FRAME Dialog-Frame.
     1264   IF p-mode = 0 OR p-mode = 1 THEN DO:
     1265       DISPLAY
     1266       l-loc-sec-1
     1267       f-delim-12
     1268       WITH FRAME Dialog-Frame.
     1269   END.
     1270   IF p-mode = 0 OR p-mode = 2 THEN DO:
     1271       DISPLAY
     1272       f-date-2
     1273       l-loc-hour-2
     1274       l-loc-min-2
     1275       f-delim-21
     1276       WITH FRAME Dialog-Frame.
     1277   END.
     1278   IF p-mode = 0 THEN DO:
     1279       DISPLAY
     1280       l-loc-sec-2
     1281       f-delim-22
     1282       WITH FRAME Dialog-Frame.
     1283   END.
     1284   IF p-mode = 2 OR p-mode = 3 THEN DO:
     1285       HIDE
     1286       l-loc-sec-1
     1287       f-delim-12
     1288       IN FRAME Dialog-Frame.
     1289   END.
     1290   IF p-mode = 1 OR p-mode = 3 THEN DO:
     1291       HIDE
     1292       f-date-2
     1293       l-loc-hour-2
     1294       l-loc-min-2
     1295       f-delim-21
     1296       in FRAME Dialog-Frame.
     1297   END.
     1298   IF p-mode = 3 THEN DO:
     1299       HIDE
     1300       l-loc-sec-2
     1301       f-delim-22
     1302       IN FRAME Dialog-Frame.
     1303   END.
     1304   ENABLE
     1305   b-quit
     1306   B-exit
     1307   B-Help
     1308   f-date-1
     1309   l-loc-hour-1
     1310   l-loc-min-1
     1311   l-loc-sec-1 WHEN (p-mode = 0 OR p-mode = 1)
     1312   f-date-2 WHEN (p-mode = 0 OR p-mode = 2)
     1313   l-loc-hour-2 WHEN (p-mode = 0 OR p-mode = 2)
     1314   l-loc-min-2 WHEN (p-mode = 0 OR p-mode = 2)
     1315   l-loc-sec-2 WHEN p-mode = 0
     1316   WITH FRAME Dialog-Frame.
     1317   VIEW FRAME Dialog-Frame.
     1318   END PROCEDURE.
