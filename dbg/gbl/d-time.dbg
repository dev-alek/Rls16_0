      659   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      660   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      661   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   on help of frame Dialog-Frame
      663   do:
      664     run gbl/app_help.p
      665       (input this-procedure :file-name
      666       ,input ''
      667       ,input ?
      668       ) no-error.
      669     if error-status :error then do:
      670       message
      671         "Ошибка при вызове помощи"
      672         error-status :get-message(1)
      673         view-as alert-box .
      674     end.
      675   end.
      676   run minbtn-set in this-procedure .
      677   on choose of b-help in frame Dialog-Frame
      678   do:
      679     apply "help":u to frame Dialog-Frame .
      680   end.
      681   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   procedure minbtn-set :
      683       do
      684           on error undo, return error return-value
      685           :
      686           define variable ii              as integer       no-undo .
      687           define variable fh              as widget-handle no-undo .
      688           define variable hh              as widget-handle no-undo .
      689           define variable v-h             as handle        extent 4 no-undo .
      690           define variable v-name-button   as character     no-undo .
      691           define variable v-help-old-x    as decimal       no-undo .
      692           define variable v-help-old-y    as decimal       no-undo .
      693           define variable v-help-old-size as decimal       no-undo .
      694           define variable v-frame-width   as decimal       no-undo .
      695           define variable jj              as integer       no-undo .
      696           do
      697               on error undo, return error
      698               :
      699               assign
      700                   v-frame-width = frame Dialog-Frame:width - 0.3
      701                   fh            = frame Dialog-Frame:first-child
      702                   hh            = fh:first-child
      703                   ii            = 1
      704                   .
      705               do while valid-handle(hh):
      706                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      707                   do:
      708                       case lc(hh:name) :
      709                           when "b-help" then
      710                               do:
      711                                   hh:load-image-up("cmp/b-help.bmp":u) .
      712                                   hh:load-image-down("cmp/b-help.bmp":u) .
      713                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      714                                   hh:TOOLTIP = "Помощь" .
      715                                   v-help-old-x = hh:column .
      716                                   v-help-old-y = hh:row    .
      717                                   v-help-old-size = hh:width .
      718                                   hh:width-chars = 2.5 .
      719                               end.
      720                           when "b-print" then
      721                               do:
      722                                   hh:load-image("cmp/b-print.bmp":u) .
      723                                   hh:TOOLTIP = "Печать" .
      724                                   v-h[ii] = hh:handle .
      725                                   ii = ii + 1 .
      726                                   hh:width-chars = 3 .
      727                               end.
      728                           when "b-history" or
      729                           when "b-hist" then
      730                               do:
      731                                   hh:load-image("cmp/b-hist.bmp":u) .
      732                                   hh:TOOLTIP = "История" .
      733                                   v-h[ii] = hh:handle .
      734                                   ii = ii + 1 .
      735                                   hh:width-chars = 3 .
      736                               end.
      737                           when "b-sch" then
      738                               do:
      739                                   hh:load-image("cmp/b-sch.bmp":u) .
      740                                   hh:TOOLTIP = "Установка Фильтра" .
      741                                   v-h[ii] = hh:handle .
      742                                   ii = ii + 1 .
      743                                   hh:width-chars = 3 .
      744                               end.
      745                           when "b-hist-user" then
      746                               do:
      747                                   hh:load-image("cmp/b-hist.bmp":u) .
      748                                   hh:TOOLTIP = "История пользователя" .
      749                                   ii = ii + 1 .
      750                               end.
      751                       end case.
      752                   end.
      753                   hh = hh:next-sibling.
      754               end.
      755               b-help:column = v-frame-width - b-help:width-chars.
      756               jj = 0.
      757               repeat ii = 4 to 1 by -1 :
      758                   if valid-handle (v-h[ii] ) then
      759                   do:
      760                       jj  = jj + 1 .
      761                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      762                       v-h[ii]:row    = v-help-old-y .
      763                   end.
      764               end.
      765           end.
      766       end.
      767   end procedure.
      768   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   on ' ' of f-date-1 in frame Dialog-Frame
      770   do:
      771     if (can-query (self, "sensitive")
      772        and
      773        self :sensitive = true
      774        )
      775     or (can-query (self, "read-only")
      776        and
      777        self :read-only = false
      778        )
      779     then do:
      780       assign
      781         self :screen-value = ?
      782       .
      783     end.
      784     return no-apply.
      785   end.
      786   on delete-character of f-date-1 in frame Dialog-Frame
      787   do:
      788     if (can-query (self, "sensitive")
      789        and
      790        self :sensitive = true
      791        )
      792     or (can-query (self, "read-only")
      793        and
      794        self :read-only = false
      795        )
      796     then do:
      797       assign
      798         self :screen-value = ?
      799       .
      800     end.
      801     return no-apply.
      802   end.
      803   on ctrl-d of f-date-1 in frame Dialog-Frame
      804   do:
      805     define variable v-curr-sv-date as date no-undo .
      806     if (can-query (self, "sensitive")
      807        and
      808        self :sensitive = true
      809        )
      810     or (can-query (self, "read-only")
      811        and
      812        self :read-only = false
      813        )
      814     then do:
      815       if self :handle <> focus :handle
      816       then do:
      817         apply "entry":u to self .
      818       end.
      819       run gbl/getcurdt.p
      820         (output v-curr-sv-date
      821         ) .
      822       assign
      823         self :screen-value = string(v-curr-sv-date) .
      824       .
      825     end.
      826     return no-apply.
      827   end.
      828   on ctrl-b of f-date-1 in frame Dialog-Frame
      829   do:
      830     if (can-query (self, "sensitive")
      831        and
      832        self :sensitive = true
      833        )
      834     or (can-query (self, "read-only")
      835        and
      836        self :read-only = false
      837        )
      838     then do:
      839       if self :handle <> focus :handle
      840       then do:
      841         apply "entry":u to self .
      842       end.
      843       define variable v-curr-sv-date as date no-undo .
      844       define variable v-new-sv-date  as date no-undo .
      845       assign
      846         v-curr-sv-date = date(self :screen-value) no-error
      847       .
      848       if v-curr-sv-date = ?
      849       then do:
      850         run gbl/getcurdt.p
      851           (output v-curr-sv-date
      852           ) .
      853       end.
      854       if v-curr-sv-date <> ?
      855       then do:
      856         assign
      857           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      858         .
      859         assign
      860           self :screen-value = string(v-new-sv-date) .
      861         .
      862       end.
      863     end.
      864     return no-apply .
      865   end.
      866   on ctrl-e of f-date-1 in frame Dialog-Frame
      867   do:
      868     if (can-query (self, "sensitive")
      869        and
      870        self :sensitive = true
      871        )
      872     or (can-query (self, "read-only")
      873        and
      874        self :read-only = false
      875        )
      876     then do:
      877       if self :handle <> focus :handle
      878       then do:
      879         apply "entry":u to self .
      880       end.
      881       define variable v-curr-sv-date as date no-undo .
      882       define variable v-new-sv-date  as date no-undo .
      883       assign
      884         v-curr-sv-date = date(self :screen-value) no-error
      885       .
      886       if v-curr-sv-date = ?
      887       then do:
      888         run gbl/getcurdt.p
      889           (output v-curr-sv-date
      890           ) .
      891       end.
      892       if v-curr-sv-date <> ?
      893       then do:
      894         run gbl/lastdate.p
      895           (input  v-curr-sv-date
      896           ,output v-new-sv-date
      897           ).
      898         assign
      899           self :screen-value = string(v-new-sv-date) .
      900         .
      901       end.
      902     end.
      903     return no-apply .
      904   end.
      905   on ctrl-f of f-date-1 in frame Dialog-Frame
      906   do:
      907     if (can-query (self, "sensitive")
      908        and
      909        self :sensitive = true
      910        )
      911     or (can-query (self, "read-only")
      912        and
      913        self :read-only = false
      914        )
      915     then do:
      916       if self :handle <> focus :handle
      917       then do:
      918         apply "entry":u to self .
      919       end.
      920       define variable v-ok            as logical   no-undo .
      921       define variable v-curr-sv-date  as date      no-undo .
      922       define variable v-description   as character no-undo .
      923       assign
      924         v-curr-sv-date = date(self :screen-value) no-error
      925       .
      926       if v-curr-sv-date = ?
      927       then do:
      928         run gbl/getcurdt.p
      929           (output v-curr-sv-date
      930           ) .
      931       end.
      932       if v-curr-sv-date <> ?
      933       then do:
      934         run gbl/d-inpday.w
      935           (input ?
      936           ,input "Выбор даты"
      937           ,input v-description
      938           ,input ""
      939           ,input-output v-curr-sv-date
      940           ,output v-ok
      941           ).
      942         if v-ok = true
      943         then do:
      944           assign
      945             self :screen-value = string(v-curr-sv-date) .
      946           .
      947         end.
      948       end.
      949     end.
      950     return no-apply .
      951   end.
      952     define MENU m-ed-date4
      953       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      954       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      955       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      956       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      957       .
      958     if f-date-1 :POPUP-MENU in frame Dialog-Frame = ?
      959     then do:
      960       ASSIGN
      961         f-date-1 :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      962         f-date-1 :MENU-MOUSE in frame Dialog-Frame = 3
      963       .
      964     end.
      965     define variable v-label-handle4 as handle no-undo .
      966     assign
      967       v-label-handle4 = f-date-1 :side-label-handle in frame Dialog-Frame
      968     .
      969     if valid-handle (v-label-handle4)
      970     then do:
      971       if v-label-handle4 :tooltip = ""
      972       or v-label-handle4 :tooltip = ?
      973       then do:
      974         assign
      975           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      976         .
      977       end.
      978     end.
      979     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      980       apply "ctrl-b":U to f-date-1 in frame Dialog-Frame .
      981     END.
      982     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      983       apply "ctrl-d":U to f-date-1 in frame Dialog-Frame .
      984     END.
      985     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      986       apply "ctrl-e":U to f-date-1 in frame Dialog-Frame .
      987     END.
      988     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      989       apply "ctrl-f":U to f-date-1 in frame Dialog-Frame .
      990     END.
