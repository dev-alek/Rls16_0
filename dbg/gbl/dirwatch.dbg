        1   block-level on error undo, throw.
        2   define input  parameter p-callback-handle    as handle    no-undo .
        3   define input  parameter p-callback-procedure as character no-undo .
        4   define input  parameter p-directory-name     as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: dirwatch.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/dirwatch.p $":U .
       10   define variable vss-description as character no-undo init "Программа ожидания файла".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable v-proc-signature  as character no-undo .
       66   define variable v-directory-name  as character no-undo .
       67   define variable v-change-handle   as integer   no-undo .
       68   define variable v-result          as integer   no-undo .
       69   define variable v-memptr-dir-name as memptr    no-undo .
       70   define variable v-ret-param       as integer   no-undo .
       71   define variable v-terminate-watch as logical   no-undo .
       72   do
       73   on error undo, return error return-value
       74   :
       75     if valid-handle(p-callback-handle) <> true
       76     then do:
       77       undo, return error substitute("Ошибка задания параметров. Неправильно задан указатель на процедуру &1", p-callback-handle) .
       78     end.
       79     assign
       80       v-proc-signature = p-callback-handle :get-signature(p-callback-procedure)
       81     .
       82     if v-proc-signature = ""
       83     or v-proc-signature = ?
       84     then do:
       85       undo, return error substitute("Ошибка задания параметров. Неправильно задано имя процедуры &1", p-callback-procedure) .
       86     end.
       87     assign
       88       file-info :file-name = p-directory-name
       89       v-directory-name     = file-info :full-pathname
       90     .
       91     if v-directory-name = ?
       92     or v-directory-name = ""
       93     then do:
       94       undo, return error substitute("Ошибка задания параметров. Неправильно задано имя директории &1.", p-directory-name) .
       95     end.
       96     if index(file-info :file-type, "D") = 0
       97     then do:
       98       undo, return error substitute("Ошибка задания параметров. Неправильно задано имя директории &1.", p-directory-name) .
       99     end.
      100     assign
      101       set-size(v-memptr-dir-name) = length(v-directory-name) + 1
      102     .
      103     assign
      104       put-string(v-memptr-dir-name, 1) = v-directory-name
      105     .
      106     run FindFirstChangeNotificationA
      107       (input v-memptr-dir-name
      108       ,input 0
      109       ,input 1
      110       ,output v-change-handle
      111       ) .
      112     if v-change-handle = -1
      113     then do:
      114       undo, return error "Ошибка при вызове функции FindFirstChangeNotificationA" .
      115     end.
      116     run value(p-callback-procedure) in p-callback-handle
      117       (output v-terminate-watch
      118       ) .
      119     if v-terminate-watch <> true
      120     then do:
      121       watch_cycle:
      122       do while true
      123       :
      124         run WaitForSingleObject
      125           (input  v-change-handle
      126           ,input  1000
      127           ,output v-result
      128           ) .
      129         if v-result = 0
      130         then do:
      131           run FindNextChangeNotification
      132             (input  v-change-handle
      133             ,output v-result
      134             ) .
      135           if v-result = 0
      136           then do:
      137             run FindCloseChangeNotification
      138               (input  v-change-handle
      139               ,output v-result
      140               ) .
      141             undo, return error "Ошибка при вызове функции FindNextChangeNotification" .
      142           end.
      143         end.
      144         run value(p-callback-procedure) in p-callback-handle
      145           (output v-terminate-watch
      146           ) .
      147         if v-terminate-watch = true
      148         then do:
      149           leave watch_cycle .
      150         end.
      151       end.
      152     end.
      153     run FindCloseChangeNotification
      154       (input  v-change-handle
      155       ,output v-result
      156       ) .
      157   end.
      158   PROCEDURE FindFirstChangeNotificationA EXTERNAL "kernel32.dll"
      159   :
      160       DEFINE INPUT        PARAMETER lpPathName       AS MEMPTR .
      161       DEFINE INPUT        PARAMETER bWatchSubtree    AS LONG   .
      162       DEFINE INPUT        PARAMETER dwNotifyFilter   AS LONG   .
      163       DEFINE RETURN       PARAMETER RetParam         AS LONG   .
      164   END PROCEDURE.
      165   PROCEDURE FindNextChangeNotification EXTERNAL "kernel32.dll"
      166   :
      167       DEFINE INPUT        PARAMETER hChangeHandle    AS LONG   .
      168       DEFINE RETURN       PARAMETER RetParam         AS LONG   .
      169   END PROCEDURE.
      170   PROCEDURE FindCloseChangeNotification EXTERNAL "kernel32.dll"
      171   :
      172       DEFINE INPUT        PARAMETER hChangeHandle    AS LONG.
      173       DEFINE RETURN       PARAMETER RetParam         AS LONG.
      174   END PROCEDURE.
      175   PROCEDURE WaitForSingleObject EXTERNAL "kernel32.dll"
      176   :
      177       DEFINE INPUT        PARAMETER hChangeHandle  AS LONG.
      178       DEFINE INPUT        PARAMETER dwMilliseconds AS LONG.
      179       DEFINE RETURN       PARAMETER RetParam       AS LONG.
      180   END PROCEDURE.
