        1   block-level on error undo, throw.
        2   define output parameter l-order-normal as logical no-undo .
        3   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   def var vss-author      as character no-undo init "$Author: expertek $":U .
        5   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   def var vss-workfile    as character no-undo init "$Workfile: int-ent.p $":U .
        7   def var vss-archive     as character no-undo init "$Archive: gbl/int-ent.p $":U .
        8   def var vss-description as character no-undo init "Определяет порядок, в котором перечислены процедуры в internal-entries".
        9   def var v-first-proc as character no-undo .
       10   assign
       11     v-first-proc = entry(1, this-procedure :internal-entries)
       12   .
       13   if v-first-proc = "test1":u then do:
       14     assign
       15       l-order-normal = true
       16     .
       17     return .
       18   end.
       19   if v-first-proc = "test3":u then do:
       20     assign
       21       l-order-normal = false
       22     .
       23     return .
       24   end.
       25   message
       26     vss-workfile vss-revision vss-description skip
       27     "v-first-proc" v-first-proc skip
       28     "internal-entries" this-procedure :internal-entries skip
       29     view-as alert-box error .
       30   undo, return error .
       31   procedure test1 :
       32   end procedure.
       33   procedure test2 :
       34   end procedure.
       35   procedure test3 :
       36   end procedure.
