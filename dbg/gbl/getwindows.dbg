        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
        4      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
        5   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        6   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
        7     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
        8   FUNCTION GetLastError
        9            RETURNS INTEGER
       10            ()
       11            IN hpWinFunc.
       12   FUNCTION GetParent
       13            RETURNS INTEGER
       14            (input hwnd as INTEGER)
       15            IN hpWinFunc.
       16   FUNCTION ShowLastError
       17            RETURNS INTEGER
       18            ()
       19            IN hpWinFunc.
       20   FUNCTION CreateProcess
       21            RETURNS INTEGER
       22            (input CommandLine as CHAR,
       23             input CurrentDir  as CHAR,
       24             input wShowWindow as INTEGER)
       25            in hpWinFunc.
       26   define output parameter OhpApi as handle no-undo.
       27   OhpApi = hpApi.
