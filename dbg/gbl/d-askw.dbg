        1   define input  parameter p-title               as character no-undo .
        2   define input  parameter p-text                as character no-undo .
        3   define input  parameter p-delimiter           as character no-undo .
        4   define input  parameter p-buttons             as character no-undo .
        5   define input  parameter p-buttons-description as character no-undo .
        6   define input  parameter p-default-button      as integer   no-undo .
        7   define input  parameter p-cancel-button       as integer   no-undo .
        8   define output parameter p-number              as integer   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Универсальный диалог для задания вопроса и выбора действия".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2':u,p-buttons,p-text)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable mCodeMes    as char no-undo.
      118   if num-entries(p-title,"|") > 1
      119   then
      120   assign
      121      mCodeMes = entry(2,p-title,"|")
      122      p-title  = entry(1,p-title,"|")
      123   .
      124   define variable v-buttons    as integer no-undo.
      125   define variable v-need-confirm as logical no-undo extent 5 .
      126   define variable v-first-delimiter  as character no-undo init "|" .
      127   define variable v-second-delimiter as character no-undo init "^" .
      128   DEFINE BUTTON b-help
      129        LABEL "Помо&щь"
      130        SIZE 3 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON Btn_1 AUTO-GO
      133        LABEL "&1"
      134        SIZE 15 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON Btn_2 AUTO-GO
      137        LABEL "&2"
      138        SIZE 15 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON Btn_3 AUTO-GO
      141        LABEL "&3"
      142        SIZE 15 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON Btn_4 AUTO-GO
      145        LABEL "&4"
      146        SIZE 15 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON Btn_5 AUTO-GO
      149        LABEL "&5"
      150        SIZE 15 BY 1
      151        BGCOLOR 8 .
      152   DEFINE VARIABLE description-1 AS CHARACTER
      153        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      154        SIZE 41 BY 2.29 NO-UNDO.
      155   DEFINE VARIABLE description-2 AS CHARACTER
      156        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      157        SIZE 41 BY 2.29 NO-UNDO.
      158   DEFINE VARIABLE description-3 AS CHARACTER
      159        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      160        SIZE 41 BY 2.29 NO-UNDO.
      161   DEFINE VARIABLE description-4 AS CHARACTER
      162        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      163        SIZE 41 BY 2.29 NO-UNDO.
      164   DEFINE VARIABLE description-5 AS CHARACTER
      165        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      166        SIZE 41 BY 2.29 NO-UNDO.
      167   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      168        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      169        SIZE 57.25 BY 4.17
      170        FGCOLOR 4  NO-UNDO.
      171   DEFINE FRAME Dialog-Frame
      172        Btn_1 AT ROW 5.83 COL 3
      173        Btn_2 AT ROW 8.25 COL 3
      174        Btn_3 AT ROW 10.67 COL 3
      175        Btn_4 AT ROW 13.17 COL 3
      176        Btn_5 AT ROW 16.67 COL 3
      177        b-help AT ROW 1 COL 60
      178        EDITOR-1 AT ROW 1.33 COL 3 NO-LABEL
      179        description-1 AT ROW 5.92 COL 19.25 NO-LABEL
      180        description-2 AT ROW 8.33 COL 19.25 NO-LABEL
      181        description-3 AT ROW 10.75 COL 19.25 NO-LABEL
      182        description-4 AT ROW 13.25 COL 19.25 NO-LABEL
      183        description-5 AT ROW 16.25 COL 19.25 NO-LABEL
      184        SPACE(2.99) SKIP(0.24)
      185       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      186            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      187            TITLE "Вопрос".
      188   ASSIGN
      189          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      190          FRAME Dialog-Frame:HIDDEN           = TRUE.
      191   ASSIGN
      192          Btn_1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      193   ASSIGN
      194          Btn_2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      195   ASSIGN
      196          Btn_3:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      197   ASSIGN
      198          Btn_4:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      199   ASSIGN
      200          Btn_5:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      201   ASSIGN
      202          description-1:HIDDEN IN FRAME Dialog-Frame           = TRUE
      203          description-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      204   ASSIGN
      205          description-2:HIDDEN IN FRAME Dialog-Frame           = TRUE
      206          description-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      207   ASSIGN
      208          description-3:HIDDEN IN FRAME Dialog-Frame           = TRUE
      209          description-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      210   ASSIGN
      211          description-4:HIDDEN IN FRAME Dialog-Frame           = TRUE
      212          description-4:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      213   ASSIGN
      214          description-5:HIDDEN IN FRAME Dialog-Frame           = TRUE
      215          description-5:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      216   ASSIGN
      217          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      218   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      219   DO:
      220     RETURN NO-APPLY .
      221   END.
      222   ON CHOOSE OF Btn_1 IN FRAME Dialog-Frame
      223   DO:
      224     if v-need-confirm [1] then do:
      225       define variable lok as logical no-undo .
      226       assign
      227         lok = false
      228       .
      229       message
      230         self :label skip
      231         "" (if description-1 :visible
      232          then description-1 :screen-value
      233          else ""
      234         ) skip
      235         "Продолжить?"
      236         view-as alert-box question buttons yes-no update lok .
      237       if lok <> true then do:
      238         return no-apply .
      239       end.
      240     end.
      241     assign
      242       p-number = 1
      243     .
      244   END.
      245   ON CHOOSE OF Btn_2 IN FRAME Dialog-Frame
      246   DO:
      247     if v-need-confirm [2] then do:
      248       define variable lok as logical no-undo .
      249       assign
      250         lok = false
      251       .
      252       message
      253         self :label skip
      254         "" (if description-2 :visible
      255          then description-2 :screen-value
      256          else ""
      257         ) skip
      258         "Продолжить?"
      259         view-as alert-box question buttons yes-no update lok .
      260       if lok <> true then do:
      261         return no-apply .
      262       end.
      263     end.
      264     assign
      265       p-number = 2
      266     .
      267   END.
      268   ON CHOOSE OF Btn_3 IN FRAME Dialog-Frame
      269   DO:
      270     if v-need-confirm [3] then do:
      271       define variable lok as logical no-undo .
      272       assign
      273         lok = false
      274       .
      275       message
      276         self :label skip
      277         "" (if description-3 :visible
      278          then description-3 :screen-value
      279          else ""
      280         ) skip
      281         "Продолжить?"
      282         view-as alert-box question buttons yes-no update lok .
      283       if lok <> true then do:
      284         return no-apply .
      285       end.
      286     end.
      287     assign
      288       p-number = 3
      289     .
      290   END.
      291   ON CHOOSE OF Btn_4 IN FRAME Dialog-Frame
      292   DO:
      293     if v-need-confirm [4] then do:
      294       define variable lok as logical no-undo .
      295       assign
      296         lok = false
      297       .
      298       message
      299         self :label skip
      300         "" (if description-4 :visible
      301          then description-4 :screen-value
      302          else ""
      303         ) skip
      304         "Продолжить?"
      305         view-as alert-box question buttons yes-no update lok .
      306       if lok <> true then do:
      307         return no-apply .
      308       end.
      309     end.
      310     assign
      311       p-number = 4
      312     .
      313   END.
      314   ON CHOOSE OF Btn_5 IN FRAME Dialog-Frame
      315   DO:
      316     if v-need-confirm [5] then do:
      317       define variable lok as logical no-undo .
      318       assign
      319         lok = false
      320       .
      321       message
      322         self :label skip
      323         "" (if description-5 :visible
      324          then description-5 :screen-value
      325          else ""
      326         ) skip
      327         "Продолжить?"
      328         view-as alert-box question buttons yes-no update lok .
      329       if lok <> true then do:
      330         return no-apply .
      331       end.
      332     end.
      333     assign
      334       p-number = 5
      335     .
      336   END.
      337   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      338   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      339   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      340   on help of frame Dialog-Frame
      341   do:
      342     run gbl/app_help.p
      343       (input this-procedure :file-name
      344       ,input ''
      345       ,input ?
      346       ) no-error.
      347     if error-status :error then do:
      348       message
      349         "Ошибка при вызове помощи"
      350         error-status :get-message(1)
      351         view-as alert-box .
      352     end.
      353   end.
      354   run minbtn-set in this-procedure .
      355   on choose of b-help in frame Dialog-Frame
      356   do:
      357     apply "help":u to frame Dialog-Frame .
      358   end.
      359   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure minbtn-set :
      361       do
      362           on error undo, return error return-value
      363           :
      364           define variable ii              as integer       no-undo .
      365           define variable fh              as widget-handle no-undo .
      366           define variable hh              as widget-handle no-undo .
      367           define variable v-h             as handle        extent 4 no-undo .
      368           define variable v-name-button   as character     no-undo .
      369           define variable v-help-old-x    as decimal       no-undo .
      370           define variable v-help-old-y    as decimal       no-undo .
      371           define variable v-help-old-size as decimal       no-undo .
      372           define variable v-frame-width   as decimal       no-undo .
      373           define variable jj              as integer       no-undo .
      374           do
      375               on error undo, return error
      376               :
      377               assign
      378                   v-frame-width = frame Dialog-Frame:width - 0.3
      379                   fh            = frame Dialog-Frame:first-child
      380                   hh            = fh:first-child
      381                   ii            = 1
      382                   .
      383               do while valid-handle(hh):
      384                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      385                   do:
      386                       case lc(hh:name) :
      387                           when "b-help" then
      388                               do:
      389                                   hh:load-image-up("cmp/b-help.bmp":u) .
      390                                   hh:load-image-down("cmp/b-help.bmp":u) .
      391                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      392                                   hh:TOOLTIP = "Помощь" .
      393                                   v-help-old-x = hh:column .
      394                                   v-help-old-y = hh:row    .
      395                                   v-help-old-size = hh:width .
      396                                   hh:width-chars = 2.5 .
      397                               end.
      398                           when "b-print" then
      399                               do:
      400                                   hh:load-image("cmp/b-print.bmp":u) .
      401                                   hh:TOOLTIP = "Печать" .
      402                                   v-h[ii] = hh:handle .
      403                                   ii = ii + 1 .
      404                                   hh:width-chars = 3 .
      405                               end.
      406                           when "b-history" or
      407                           when "b-hist" then
      408                               do:
      409                                   hh:load-image("cmp/b-hist.bmp":u) .
      410                                   hh:TOOLTIP = "История" .
      411                                   v-h[ii] = hh:handle .
      412                                   ii = ii + 1 .
      413                                   hh:width-chars = 3 .
      414                               end.
      415                           when "b-sch" then
      416                               do:
      417                                   hh:load-image("cmp/b-sch.bmp":u) .
      418                                   hh:TOOLTIP = "Установка Фильтра" .
      419                                   v-h[ii] = hh:handle .
      420                                   ii = ii + 1 .
      421                                   hh:width-chars = 3 .
      422                               end.
      423                           when "b-hist-user" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История пользователя" .
      427                                   ii = ii + 1 .
      428                               end.
      429                       end case.
      430                   end.
      431                   hh = hh:next-sibling.
      432               end.
      433               b-help:column = v-frame-width - b-help:width-chars.
      434               jj = 0.
      435               repeat ii = 4 to 1 by -1 :
      436                   if valid-handle (v-h[ii] ) then
      437                   do:
      438                       jj  = jj + 1 .
      439                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      440                       v-h[ii]:row    = v-help-old-y .
      441                   end.
      442               end.
      443           end.
      444       end.
      445   end procedure.
      446   do with frame Dialog-Frame:
      447     assign
      448       frame Dialog-Frame :title = p-title
      449     .
      450     if length (p-delimiter) >= 1 then do:
      451       assign
      452         v-first-delimiter = substring(p-delimiter, 1, 1)
      453       .
      454     end.
      455     if length (p-delimiter) >= 2 then do:
      456       assign
      457         v-second-delimiter = substring(p-delimiter, 2, 1)
      458       .
      459     end.
      460     assign
      461       v-buttons = num-entries(p-buttons, v-first-delimiter)
      462       editor-1 = p-text
      463     .
      464     if v-buttons > 5 then do:
      465       message
      466         vss-workfile vss-revision vss-description skip
      467         "Количество кнопок больше четырех" skip
      468         "p-buttons" p-buttons skip
      469         view-as alert-box .
      470       undo, return error .
      471     end.
      472     if v-buttons <> num-entries(p-buttons-description, v-first-delimiter) then do:
      473       message
      474         vss-workfile vss-revision vss-description skip
      475         "Ошибка задания входных параметров" skip
      476         "Количество описаний кнопок не совпадает с количество кнопок" skip
      477         "Кнопок" v-buttons skip
      478         "Описаний кнопок" num-entries(p-buttons-description) skip
      479         view-as alert-box error .
      480       undo, return error .
      481     end.
      482     define variable v-button-handle             as handle no-undo extent 5 .
      483     define variable v-button-description-handle as handle no-undo extent 5 .
      484     assign
      485       v-button-handle[1]             = Btn_1         :handle
      486       v-button-handle[2]             = Btn_2         :handle
      487       v-button-handle[3]             = Btn_3         :handle
      488       v-button-handle[4]             = Btn_4         :handle
      489       v-button-handle[5]             = Btn_5         :handle
      490       v-button-description-handle[1] = description-1 :handle
      491       v-button-description-handle[2] = description-2 :handle
      492       v-button-description-handle[3] = description-3 :handle
      493       v-button-description-handle[4] = description-4 :handle
      494       v-button-description-handle[5] = description-5 :handle
      495     .
      496     define variable v-handle             as handle no-undo .
      497     define variable v-handle-description as handle no-undo .
      498     if  p-default-button > 0
      499     and p-default-button <= v-buttons
      500     then do:
      501       assign
      502         v-handle = v-button-handle[p-default-button]
      503       .
      504       assign
      505         v-handle :default = true
      506         frame Dialog-Frame :default-button = v-handle
      507       .
      508     end.
      509     else do:
      510       message
      511         vss-workfile vss-revision vss-description skip
      512         "Не задана кнопка по умолчанию" skip
      513         "p-default-button" p-default-button skip
      514         view-as alert-box .
      515       undo, return error .
      516     end.
      517     if  p-cancel-button > 0
      518     and p-cancel-button <= v-buttons
      519     then do:
      520       assign
      521         v-handle = v-button-handle[p-cancel-button]
      522       .
      523       assign
      524         frame Dialog-Frame :cancel-button = v-handle
      525       .
      526     end.
      527     else do:
      528       message
      529         vss-workfile vss-revision vss-description skip
      530         "Не задана кнопка выбираемая при нажатии Escape" skip
      531         "p-cancel-button" p-cancel-button skip
      532         view-as alert-box .
      533       undo, return error .
      534     end.
      535     if  v-buttons > 1
      536     and p-cancel-button = p-default-button then do:
      537       message
      538         vss-workfile vss-revision vss-description skip
      539         "Номер кнопки по умолчанию совпадает с номером кнопки выбираемой при нажатии Escape" skip
      540         "p-default-button" p-default-button skip
      541         "p-cancel-button"  p-cancel-button  skip
      542         view-as alert-box .
      543     end.
      544     define variable ind as integer no-undo .
      545     do ind = 1 to v-buttons
      546     :
      547       assign
      548         v-handle             = v-button-handle[ind]
      549         v-handle-description = v-button-description-handle[ind]
      550       .
      551       define variable v-button-text      as character no-undo .
      552       define variable v-description-text as character no-undo .
      553       define variable l-sensitive        as logical no-undo .
      554       define variable l-confirm          as logical no-undo .
      555       define variable v-btn-text-ind     as integer no-undo .
      556       assign
      557         v-button-text      = entry(ind, p-buttons, v-first-delimiter)
      558         v-description-text = entry(ind, p-buttons-description, v-first-delimiter)
      559         l-sensitive        = true
      560         l-confirm          = false
      561       .
      562       define variable v-button-attribute as character no-undo .
      563       do v-btn-text-ind = 2 to num-entries(v-button-text, v-second-delimiter )
      564       :
      565         assign
      566           v-button-attribute = entry(v-btn-text-ind, v-button-text, v-second-delimiter)
      567         .
      568         case v-button-attribute :
      569           when 'disable' then do:
      570             assign
      571               l-sensitive = false
      572             .
      573           end.
      574           when 'confirm' then do:
      575             assign
      576               l-confirm = true
      577             .
      578           end.
      579           otherwise do:
      580             message
      581               vss-workfile vss-revision vss-description skip
      582               "Неизвестный атрибут кнопки" skip
      583               "Атрибут" v-button-attribute skip
      584               "Описание кнопки" ind skip
      585               v-button-text skip
      586               view-as alert-box error .
      587           end.
      588         end case .
      589       end.
      590       if num-entries (v-button-text, v-second-delimiter ) >= 1 then do:
      591         assign
      592           v-button-text = entry(1, v-button-text, v-second-delimiter)
      593         .
      594       end.
      595       assign
      596         v-need-confirm [ind] = l-confirm
      597       .
      598       assign
      599         v-handle :label     = v-button-text
      600         v-handle :visible   = true
      601         v-handle :sensitive = l-sensitive
      602       .
      603       if v-description-text = "" then do:
      604         assign
      605           v-handle :width = min(max(v-handle :width
      606                                    ,length(v-button-text) + 2
      607                                    )
      608                                ,frame Dialog-Frame :width - v-handle :column - 1
      609                                )
      610         .
      611       end.
      612       if v-description-text <> "" then do:
      613         assign
      614           v-handle-description :visible      = true
      615           v-handle-description :sensitive    = true
      616           v-handle-description :read-only    = true
      617           v-handle-description :screen-value = v-description-text
      618         .
      619       end.
      620     end.
      621   end.
      622   on cursor-left anywhere do:
      623     apply "back-tab":u to focus .
      624   end.
      625   on cursor-right anywhere do:
      626     apply "tab":u to focus .
      627   end.
      628   MAIN-BLOCK:
      629   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      630      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      631     def var mAnswer as char no-undo.
      632     publish "ResponseToQuestion" (output mAnswer ).
      633     p-number = int (mAnswer) no-error.
      634     if error-status:error
      635     then do:
      636        define variable mbeg as integer no-undo.
      637        mbeg = index("," + mAnswer   , "," + mcodemes + "=") .
      638        mAnswer = substring (mAnswer, mbeg + length(mcodemes) + 1).
      639        mAnswer = entry(1,mAnswer).
      640        p-number = int (mAnswer) no-error.
      641        if error-status:error
      642        then
      643           block-num:
      644           do mbeg = 1 to num-entries (mAnswer):
      645                p-number = int (entry(mbeg, mAnswer)) no-error.
      646                 if not error-status:error
      647                 then
      648                    leave block-num.
      649           end.
      650     end.
      651     if   p-number eq 0
      652     then do:
      653     RUN enable_UI.
      654     if  p-default-button > 0
      655     and p-default-button <= v-buttons
      656     then do:
      657       assign
      658         v-handle = v-button-handle[p-default-button]
      659       .
      660       apply 'entry':u to v-handle .
      661     end.
      662     WAIT-FOR GO OF FRAME Dialog-Frame.
      663     end.
      664   END.
      665   RUN disable_UI.
      666   RETURN.
      667   PROCEDURE disable_UI :
      668     HIDE FRAME Dialog-Frame.
      669   END PROCEDURE.
      670   PROCEDURE enable_UI :
      671     DISPLAY EDITOR-1
      672         WITH FRAME Dialog-Frame.
      673     ENABLE b-help EDITOR-1
      674         WITH FRAME Dialog-Frame.
      675     VIEW FRAME Dialog-Frame.
      676   END PROCEDURE.
