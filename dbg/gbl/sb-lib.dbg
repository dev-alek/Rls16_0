        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: sb-lib.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/sb-lib.p $":U .
        7   define variable vss-description as character no-undo init "Библионтека для обслуживания банковских карт (Сбербанк)".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define new global shared variable g#sb-lib as handle no-undo.
      116   if valid-handle (g#sb-lib)
      117   and g#sb-lib <> this-procedure :handle
      118   and g#sb-lib :get-signature('library_testproc':u) <> ""
      119   then do:
      120     message
      121       vss-workfile vss-revision vss-description skip
      122       "Попытка повторной загрузки библиотеки" skip
      123       g#sb-lib skip
      124       g#sb-lib :type skip
      125       g#sb-lib :file-name skip
      126       valid-handle(g#sb-lib) skip
      127       this-procedure :handle skip
      128       this-procedure :type skip
      129       this-procedure :file-name skip
      130       valid-handle(this-procedure) skip
      131       view-as alert-box error .
      132     undo, return error return-value .
      133   end.
      134   else do:
      135     assign
      136       g#sb-lib = this-procedure :handle
      137     .
      138   end.
      139   if this-procedure :persistent <> true
      140   then do:
      141     message
      142       vss-workfile vss-revision vss-description skip
      143       "Ошибка запуска библиотеки" program-name(1) skip
      144       "Попытка запустить ее как обычную процедуру" skip
      145       view-as alert-box error .
      146   end.
      147   on delete of this-procedure do:
      148     assign
      149       g#sb-lib = ?
      150     .
      151   end.
      152   DEFINE VARIABLE v-sb         AS COM-HANDLE   NO-UNDO .
      153   define variable v-sb-type    as integer      no-undo.
      154   procedure sb-init :
      155   define input parameter  p-cashless-system as character        no-undo.
      156   define output parameter p-message as character        no-undo.
      157   define output parameter p-ok      as logical          no-undo.
      158   define variable v-output    as character    no-undo.
      159   bl:
      160   do
      161   on error undo, return error
      162   :
      163      RELEASE OBJECT v-sb NO-ERROR.
      164      v-sb = ?.
      165      IF  p-cashless-system = 'sberbank':U
      166      THEN DO:
      167         CREATE "SBRFSRV.server":U v-sb NO-ERROR.
      168         IF ERROR-STATUS:ERROR
      169         OR NOT VALID-HANDLE(v-sb)
      170         THEN DO:
      171            ASSIGN
      172               p-message = "Не найден COM-сервер для Сбербанка"
      173            .
      174            RETURN.
      175         END.
      176         assign
      177            v-sb-type = 100
      178         .
      179         v-sb:CONNECT() NO-ERROR.
      180         IF ERROR-STATUS:ERROR
      181         THEN DO:
      182            ASSIGN
      183               p-message = RETURN-VALUE
      184               p-ok      = FALSE
      185            .
      186            RETURN.
      187         END.
      188      END.
      189      assign
      190         p-ok = TRUE
      191      .
      192   end.
      193   end procedure.
      194   PROCEDURE sb-cardinfo :
      195   define output parameter p-card-num as character        no-undo.
      196   define output parameter p-card-type as character        no-undo.
      197   define output parameter p-message as character        no-undo.
      198   define output parameter p-ok          as logical          no-undo.
      199   define variable v-clientcard    as character    no-undo.
      200   define variable v-output    as character    no-undo.
      201   IF VALID-HANDLE(v-sb)
      202   THEN DO
      203   ON ERROR UNDO, RETURN ERROR
      204   :
      205      CASE v-sb-type :
      206         WHEN 100 THEN DO:
      207            p-message = v-sb:Clear() NO-ERROR.
      208            IF ERROR-STATUS:ERROR
      209            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      210            THEN DO:
      211               ASSIGN
      212                  p-ok = FALSE
      213               .
      214               RETURN.
      215            END.
      216            v-sb:sParam(INPUT "CardType", INPUT 0).
      217            v-sb:sParam(INPUT "Amount",   INPUT 0).
      218            v-sb:sParam(INPUT "Track2",  INPUT "").
      219            p-message = v-sb:NFun (INPUT 5000) NO-ERROR.
      220            IF ERROR-STATUS:ERROR
      221            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      222            THEN DO:
      223               ASSIGN
      224                  p-ok = FALSE
      225               .
      226               RETURN.
      227            END.
      228            ASSIGN
      229               p-card-num  = v-sb:gParamString(INPUT "CardName")
      230               p-card-type = v-sb:gParamString(INPUT "CardType")
      231            .
      232            p-message = v-sb:Clear() NO-ERROR.
      233            IF ERROR-STATUS:ERROR
      234            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      235            THEN DO:
      236               ASSIGN
      237                  p-ok = FALSE
      238               .
      239               RETURN.
      240            END.
      241            ASSIGN
      242               p-ok = TRUE
      243            .
      244         END.
      245         OTHERWISE DO:
      246         END.
      247      END CASE.
      248      ASSIGN
      249         p-ok = TRUE
      250      .
      251   END.
      252   ELSE DO:
      253      ASSIGN
      254         p-ok = TRUE
      255      .
      256   END.
      257   END PROCEDURE.
      258   PROCEDURE sb-sale :
      259   define input parameter  p-summ     as decimal          no-undo.
      260   define output parameter p-slip     as character        no-undo.
      261   define output parameter p-card-num as character        no-undo.
      262   define output parameter p-message  as character        no-undo.
      263   define output parameter p-ok       as logical          no-undo.
      264   IF VALID-HANDLE(v-sb)
      265   THEN DO
      266   ON ERROR UNDO, RETURN ERROR
      267   :
      268      CASE v-sb-type :
      269         WHEN 100 THEN DO:
      270            p-message = v-sb:Clear() NO-ERROR.
      271            IF ERROR-STATUS:ERROR
      272            OR (    p-message <> ?
      273                AND p-message <> "":U
      274                AND p-message <> "0":U
      275                )
      276            THEN DO:
      277               ASSIGN
      278                  p-ok = FALSE
      279               .
      280               RETURN.
      281            END.
      282            v-sb:sParam(INPUT "CardType", INPUT 0).
      283            v-sb:sParam(INPUT "Amount",   INPUT TRUNCATE((p-summ * 100), 0)).
      284            v-sb:sParam(INPUT "Track2",  INPUT "").
      285            p-message = v-sb:NFun (INPUT 4000) NO-ERROR.
      286            IF ERROR-STATUS:ERROR
      287            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      288            THEN DO:
      289               ASSIGN
      290                  p-ok = FALSE
      291               .
      292               RETURN.
      293            END.
      294            assign
      295               p-slip      = v-sb:gParamString(INPUT "Cheque")
      296               p-card-num  = v-sb:gParamString(INPUT "ClientCard")
      297            .
      298            p-message = v-sb:Clear() NO-ERROR.
      299            IF ERROR-STATUS:ERROR
      300            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      301            THEN DO:
      302               ASSIGN
      303                  p-ok = FALSE
      304               .
      305               RETURN.
      306            END.
      307            ASSIGN
      308               p-ok = TRUE
      309            .
      310         END.
      311         OTHERWISE DO:
      312         END.
      313      END CASE.
      314   END.
      315   ELSE DO:
      316      ASSIGN
      317         p-ok = TRUE
      318      .
      319   END.
      320   END PROCEDURE.
      321   PROCEDURE sb-ret :
      322   define input parameter  p-summ      as decimal          no-undo .
      323   define input parameter  p-card-num  as character        no-undo .
      324   define output parameter p-slip      as character        no-undo .
      325   define output parameter p-message   as character        no-undo .
      326   define output parameter p-ok        as logical          no-undo .
      327   IF VALID-HANDLE(v-sb)
      328   THEN DO
      329   ON ERROR UNDO, RETURN ERROR
      330   :
      331      CASE v-sb-type :
      332         WHEN 100 THEN DO:
      333            p-message = v-sb:Clear() NO-ERROR.
      334            IF ERROR-STATUS:ERROR
      335            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      336            THEN DO:
      337               ASSIGN
      338                  p-ok = FALSE
      339               .
      340               RETURN.
      341            END.
      342            v-sb:sParam(INPUT "CardType", INPUT 0).
      343            v-sb:sParam(INPUT "Amount",   INPUT TRUNCATE((ABS(p-summ) * 100), 0)).
      344            v-sb:sParam(INPUT "Track2",  INPUT "").
      345            p-message = v-sb:NFun (INPUT 4002) NO-ERROR.
      346            IF ERROR-STATUS:ERROR
      347            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      348            THEN DO:
      349               ASSIGN
      350                  p-ok = FALSE
      351               .
      352               RETURN.
      353            END.
      354            assign
      355               p-slip      = v-sb:gParamString(INPUT "Cheque")
      356               p-card-num  = v-sb:gParamString(INPUT "ClientCard")
      357            .
      358            p-message = v-sb:Clear() NO-ERROR.
      359            IF ERROR-STATUS:ERROR
      360            OR (p-message <> ? AND p-message <> "":U AND p-message <> "0":U)
      361            THEN DO:
      362               ASSIGN
      363                  p-ok = FALSE
      364               .
      365               RETURN.
      366            END.
      367            ASSIGN
      368               p-ok = TRUE
      369            .
      370         END.
      371         OTHERWISE DO:
      372         END.
      373      END CASE.
      374   END.
      375   ELSE DO:
      376      ASSIGN
      377         p-ok = TRUE
      378      .
      379   END.
      380   END PROCEDURE.
