        1   block-level on error undo, throw.
        2   define input parameter par-run-names as character no-undo .
        3   define input parameter Rs-list-method as character no-undo .
        4   define input parameter Rs-status as character no-undo .
        5   define input parameter line-mode as character no-undo .
        6   define input parameter p-filter-var as character no-undo .
        7   define output parameter lns-cnt as integer no-undo .
        8   define output parameter line-rec as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: bb-fill.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/bb-fill.p $":U .
       14   define variable vss-description as character no-undo init "Формирование списка кодов по фильтру".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   def shared temp-table bb-list no-undo like ub.goods
       87     field b-code as integer
       88     field b-str  as character
       89     field f-name like ub.gds-prt.f-name
       90     field bc-cli-base-rate like ub.bar-code.cli-base-rate
       91     field bc-cr-db-num     like ub.bar-code.cr-db-num
       92     field in-code       like ub.bar-code.in-code
       93     field node-code     like ub.bar-code.node-code
       94     field part-code     like ub.bar-code.part-code
       95     field stts_         like ub.bar-code.stts_
       96     field bc-unit-cli      like ub.bar-code.unit-cli
       97     field bc-on-type    like ub.prod-bc.bc-on-type
       98     field bc-on         like ub.prod-bc.bc-on
       99     field pbc-cr-db-num     like ub.prod-bc.cr-db-num
      100     field qnty   as decimal
      101     field to-del as logical
      102     field order-num as integer
      103     field loc-ean as logical
      104     index pi  is primary unique b-code b-str
      105     index art artic prod-type prod-code
      106     index code gds-code
      107     index oi order-num
      108     index ibc-on-type bc-on-type
      109     index iprt
      110     gds-code
      111     node-code
      112     part-code
      113     in-code
      114     unit-cli
      115     b-str
      116     index iprt2
      117     gds-code
      118     node-code
      119     unit-cli
      120     part-code
      121     in-code
      122     b-str
      123     .
      124   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define  shared  temp-table bb-list-hist no-undo
      126   field list-table as character
      127   field id as integer
      128   field line as integer
      129   field hist-mode as character
      130   field des as character
      131   field num-recs as integer
      132   field option_ as character
      133   field item_ as character
      134   field status_ as character
      135   field num-add as integer
      136   field num-ignored as integer
      137   field done as logical
      138   field err_ as logical
      139   field err-mes as character
      140   index pi is primary
      141   id
      142   line
      143   index isdone
      144   done
      145   .
      146   define variable dsp-rs as char format "x(50)" no-undo.
      147   define variable lns-ignore as integer no-undo .
      148   define variable glog as logical no-undo .
      149   define variable v-prepare-string as character no-undo .
      150   define query bb-fill for ub.bar-code, ub.goods.
      151   def frame abc
      152   dsp-rs no-label
      153   with view-as dialog-box SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      154   TITLE par-run-names.
      155   view frame abc.
      156   disp dsp-rs with frame abc.
      157   v-prepare-string = "for each ub.bar-code no-lock where true " +
      158                      p-filter-var  + ", first ub.goods no-lock where ub.goods.gds-code = ub.bar-code.gds-code ".
      159   glog = query bb-fill:handle:query-prepare(v-prepare-string) no-error.
      160   if not glog
      161   or error-status:error then do:
      162     message
      163     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      164                , chr(10)
      165                , error-status:get-message(1)
      166                , p-filter-var)
      167     view-as alert-box error .
      168     undo, return error .
      169   end.
      170   glog = query bb-fill:handle:query-open() no-error.
      171   if not glog
      172   or error-status:error then do:
      173     message
      174     substitute("Ошибка при заполнении по фильтру&1:&2&1Выражение для Фильтра:&1&3"
      175                , chr(10)
      176                , error-status:get-message(1)
      177                , p-filter-var)
      178     view-as alert-box error .
      179     undo, return error .
      180   end.
      181   REPEAT WITH FRAME abc:
      182     query bb-fill:handle:GET-NEXT().
      183     IF query bb-fill:handle:QUERY-OFF-END THEN LEAVE.
      184     process events.
      185     run ex-bbc in this-procedure (input rs-list-method
      186                                  , input rs-status
      187                                  , input line-mode
      188                                  , input no
      189                                  , input "":U
      190                                  , input no
      191                                  , buffer ub.bar-code
      192                                  , buffer ub.prod-bc).
      193   end.
      194   glog = query bb-fill:handle:query-close() no-error.
      195   hide frame abc.
      196   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197   PROCEDURE ex-bbc :
      198   define input parameter rs-list-method as character no-undo .
      199   define input parameter rs-status as character no-undo .
      200   define input parameter line-mode as character no-undo .
      201   define input parameter p-empty-scale as logical no-undo .
      202   define input parameter p-b-str as character no-undo .
      203   define input parameter p-is-loc-ean as logical no-undo .
      204   define parameter buffer buf_bar-code for ub.bar-code.
      205   define parameter buffer buf_prod-bc for ub.prod-bc.
      206   define variable v-f-name like ub.gds-prt.f-name no-undo .
      207   define buffer buf_gds-prt for ub.gds-prt.
      208   if available buf_prod-bc then
      209   p-b-str = buf_prod-bc.b-str.
      210   if rs-list-method begins "single":U or
      211     (ub.goods.stts = 0  and rs-status <> 'удаленные':U) or
      212     (ub.goods.stts <> 0 and rs-status <> 'текущие':U) then do:
      213     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
      214       find first bb-list where bb-list.gds-code  = ub.goods.gds-code
      215                        and bb-list.b-code    = buf_bar-code.b-code
      216                        and bb-list.b-str     = p-b-str  no-error.
      217       if available bb-list then do:
      218         if line-mode = 'удаление':U then do:
      219           lns-cnt = lns-cnt + 1.
      220           delete bb-list.
      221         end.
      222         else do:
      223           if bb-list.to-del = ? then.
      224           else do:
      225             lns-cnt = lns-cnt + 1.
      226             bb-list.to-del = ?.
      227           end.
      228         end.
      229       end.
      230     end.
      231     else
      232       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
      233         if p-empty-scale then  do:
      234         end.
      235         else do:
      236           find first buf_gds-prt no-lock where
      237                     buf_gds-prt.node-code = buf_bar-code.node-code no-error.
      238           if not available buf_gds-prt then v-f-name = "!!!Неизвестный признак шкалы".
      239           else v-f-name = buf_gds-prt.f-name.
      240         end.
      241   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   find first bb-list
      243     where bb-list.gds-code = buf_bar-code.gds-code
      244       and bb-list.b-code   = buf_bar-code.b-code
      245       and bb-list.b-str    = p-b-str
      246     no-error .
      247   if available bb-list then do:
      248     assign
      249       bb-list.to-del = no
      250     .
      251   end.
      252   else do:
      253     define variable v-last4 as integer no-undo .
      254     find last bb-list use-index oi no-error.
      255     if available bb-list then do:
      256       v-last4 = bb-list.order-num .
      257     end.
      258     else do:
      259       v-last4 = 0 .
      260     end.
      261     create bb-list .
      262     buffer-copy ub.goods to bb-list
      263     assign
      264       bb-list.to-del = no
      265       bb-list.order-num = v-last4 + 1
      266       bb-list.b-code = buf_bar-code.b-code
      267       bb-list.bc-cli-base-rate = buf_bar-code.cli-base-rate
      268       bb-list.bc-cr-db-num     = buf_bar-code.cr-db-num
      269       bb-list.in-code       = buf_bar-code.in-code
      270       bb-list.node-code     = buf_bar-code.node-code
      271       bb-list.part-code     = buf_bar-code.part-code
      272       bb-list.stts_         = buf_bar-code.stts_
      273       bb-list.bc-unit-cli   = buf_bar-code.unit-cli
      274       bb-list.b-str         = p-b-str
      275       bb-list.f-name        = v-f-name
      276       bb-list.loc-ean       = p-is-loc-ean
      277       .
      278       if available buf_prod-bc
      279       then
      280       assign
      281       bb-list.bc-on-type    = buf_prod-bc.bc-on-type
      282       bb-list.bc-on         = buf_prod-bc.bc-on
      283       bb-list.pbc-cr-db-num = buf_prod-bc.cr-db-num
      284       .
      285     assign
      286       lns-cnt = lns-cnt + 1
      287       line-rec = recid (bb-list)
      288     .
      289   end.
      290       end.
      291     disp "ЖДИТЕ...    Обработано кодов :" + string (lns-cnt) @ dsp-rs with frame abc.
      292   end.
      293   else
      294   assign
      295   lns-ignore = lns-ignore + 1
      296   .
      297   end.
