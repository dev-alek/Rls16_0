        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Просмотр заблокированных записей".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   DEF VAR sFindRecProgramName AS CHARACTER NO-UNDO.
      111   def var s-loadlock-program  as character no-undo .
      112   def var h-findrec-program   as handle no-undo .
      113   def var h-loadlock-program   as handle no-undo .
      114   DEFINE TEMP-TABLE temp-Lock NO-UNDO
      115     FIELD Lock_RecID     AS RECID     LABEL "RecId":u FORMAT "->>>>>>>>>>>>>>>9"
      116     FIELD Lock_TableName AS CHARACTER LABEL "Table Name":u FORMAT "x(30)"
      117     FIELD Lock_UserName  AS CHARACTER LABEL "User Name":u  format "x(20)"
      118     FIELD Lock_Flags     AS CHARACTER LABEL "Flags":u
      119     FIELD Lock_Type      as character LABEL "Type":u
      120   .
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   procedure cur-time :
      123      define output parameter p-today as date      no-undo .
      124      define output parameter p-time  as integer   no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-date1 as date      no-undo .
      129       define variable v-date2 as date      no-undo .
      130       define variable v-time  as integer   no-undo .
      131       assign
      132         v-date1 = today
      133         v-time  = time
      134         v-date2 = today
      135       .
      136       if v-date1 <> v-date2
      137       then do:
      138         assign
      139           v-date1 = today
      140           v-time  = v-time
      141         .
      142       end.
      143       assign
      144         p-today = v-date1
      145         p-time  = v-time
      146       .
      147     end.
      148   end.
      149   function cur-time-date returns character
      150   :
      151     return string(today, '99/99/9999':U) .
      152   end.
      153   function cur-time-mjd returns decimal
      154   :
      155     define variable v-date as date      no-undo .
      156     define variable v-time as integer   no-undo .
      157     run cur-time in this-procedure
      158       (output v-date
      159       ,output v-time
      160       ) .
      161     return integer(v-date) - 2400002 + (v-time / 86400) .
      162   end.
      163   function cur-time-get-ending-index returns integer
      164   (input p-number as integer
      165   )
      166   :
      167     if p-number < 0
      168     or p-number = ?
      169     then do:
      170       return 1 .
      171     end.
      172     define variable v-rest as integer   no-undo .
      173     assign
      174       p-number = p-number modulo 100
      175     .
      176     if p-number < 20
      177     then do:
      178       assign
      179         v-rest = p-number
      180       .
      181     end.
      182     else do:
      183       assign
      184         v-rest = p-number modulo 10
      185       .
      186     end.
      187     case v-rest :
      188       when 1
      189       then do:
      190         return 2 .
      191       end.
      192       when 2 or
      193       when 3 or
      194       when 4
      195       then do:
      196         return 3 .
      197       end.
      198       otherwise do:
      199         return 1 .
      200       end.
      201     end case .
      202   end.
      203   procedure cur-time-mjd-to-date :
      204      define input  parameter i-mjd-diff as decimal no-undo.
      205      define output parameter o-Date     as date    no-undo.
      206      define output parameter o-Time     as integer no-undo.
      207      define variable v-day-number as integer   no-undo .
      208      if    i-mjd-diff < 0
      209         or i-mjd-diff = ?
      210      then do:
      211         return "?" .
      212      end.
      213      assign
      214         v-day-number = truncate(i-mjd-diff,0).
      215         o-Date = date(v-day-number + 2400002).
      216         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218   end.
      219   function cur-time-mjd-to-string returns character
      220   (input p-mjd-diff as decimal
      221   )
      222   :
      223     define variable v-day-number as integer   no-undo .
      224     define variable v-seconds    as integer   no-undo .
      225     define variable v-hour       as integer   no-undo .
      226     define variable v-min        as integer   no-undo .
      227     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      228     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      229     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      230     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      231     if p-mjd-diff < 0
      232     or p-mjd-diff = ?
      233     then do:
      234       return "?" .
      235     end.
      236     assign
      237       v-day-number = integer(truncate(p-mjd-diff,0))
      238       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240     if v-seconds > 86400
      241     then do:
      242       assign
      243         v-seconds = 86400 - 1
      244       .
      245     end.
      246     if v-seconds < 0
      247     then do:
      248       assign
      249         v-seconds = 0
      250       .
      251     end.
      252     assign
      253       v-hour = truncate(v-seconds / 3600, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 3600
      257     .
      258     assign
      259       v-min = truncate(v-seconds / 60, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 60
      263     .
      264     return
      265         (if v-day-number <> 0
      266           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0
      270           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      274           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      275           else ""
      276         )
      277       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      278       .
      279   end.
      280   function cur-time-string returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-string-sec returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      299   end.
      300   function cur-time-custom  returns character
      301   (input p-prefix as character
      302   ,input p-date-format as character
      303   ,input p-delimiter as character
      304   ,input p-time-format as character
      305   ,input p-suffix as character
      306   )
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return
      315       p-prefix
      316       + string(v-date, p-date-format)
      317       + p-delimiter
      318       + string(v-time, p-time-format)
      319       + p-suffix
      320       .
      321   end.
      322   function cur-time-print  returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      331   end.
      332   function cur-time-datetime returns datetime
      333   :
      334     define variable v-char as character no-undo .
      335     define variable v-datetime as datetime no-undo .
      336     v-char = cur-time-string().
      337     v-datetime = datetime(v-char).
      338     return  v-datetime.
      339   end.
      340   function cur-time-string-msec returns character
      341   :
      342     define variable v-date as datetime  no-undo .
      343     v-date = now.
      344     return string(v-date) .
      345   end.
      346   DEFINE BUTTON b-exit AUTO-GO
      347        LABEL "&Выход"
      348        SIZE 10 BY 1
      349        BGCOLOR 8 .
      350   DEFINE BUTTON b-find
      351        LABEL "Поис&к"
      352        SIZE 10 BY 1.
      353   DEFINE BUTTON b-help
      354        LABEL "Помо&щь"
      355        SIZE 10 BY 1
      356        BGCOLOR 8 .
      357   DEFINE BUTTON b-refresh
      358        LABEL "&Обновить"
      359        SIZE 10 BY 1 TOOLTIP "Обновить список блокировок".
      360   DEFINE VARIABLE FI-RecID AS INTEGER FORMAT ">,>>>,>>>":U INITIAL 0
      361        VIEW-AS FILL-IN
      362        SIZE 14.5 BY 1
      363        BGCOLOR 15  NO-UNDO.
      364   DEFINE VARIABLE FI-ScanTime AS CHARACTER FORMAT "X(15)":U
      365        LABEL "Время сканирования"
      366         VIEW-AS TEXT
      367        SIZE 30.25 BY .63 NO-UNDO.
      368   DEFINE RECTANGLE RECT-1
      369        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      370        SIZE 33.5 BY 1.5.
      371   DEFINE QUERY BROWSE-1 FOR
      372         temp-Lock SCROLLING.
      373   DEFINE BROWSE BROWSE-1
      374     QUERY BROWSE-1 DISPLAY
      375         Lock_RecID
      376         Lock_TableName
      377         Lock_UserName
      378         Lock_Flags
      379       WITH NO-ROW-MARKERS SEPARATORS SIZE 76.5 BY 11.75
      380            BGCOLOR 15 .
      381   DEFINE FRAME Dialog-Frame
      382        BROWSE-1 AT ROW 2.04 COL 1
      383        FI-RecID AT ROW 14.17 COL 6.25 COLON-ALIGNED NO-LABEL
      384        b-find AT ROW 14.17 COL 23.5
      385        b-refresh AT ROW 14.17 COL 37.75
      386        b-help AT ROW 14.17 COL 57.75
      387        b-exit AT ROW 14.17 COL 67.75
      388        FI-ScanTime AT ROW 1.25 COL 19 COLON-ALIGNED
      389        "Описание FLAGS: S - SHARE LOCK, X - EXCLUSIVE LOCK, L - LIMBO TRANSACTION" VIEW-AS TEXT
      390             SIZE 76.25 BY .5 AT ROW 15.75 COL 1.5
      391        "RecID:" VIEW-AS TEXT
      392             SIZE 5.75 BY .5 AT ROW 14.42 COL 2
      393        RECT-1 AT ROW 13.92 COL 1
      394        SPACE(45.99) SKIP(3.40)
      395       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      396            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      397            TITLE "Заблокированные записи".
      398   ASSIGN
      399          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      400          FRAME Dialog-Frame:HIDDEN           = TRUE.
      401   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      402   DO:
      403     APPLY "END-ERROR":U TO SELF.
      404   END.
      405   ON CHOOSE OF b-find IN FRAME Dialog-Frame
      406   DO:
      407     DEF VAR v-recid AS INTEGER NO-UNDO.
      408     DEF VAR sTableName AS CHARACTER NO-UNDO.
      409     assign
      410       v-RecID = INTEGER(FI-RecID :SCREEN-VALUE)
      411     .
      412     run findrec in h-findrec-program
      413        (input v-recid)
      414        .
      415     assign
      416       sTableName = RETURN-VALUE
      417     .
      418     IF sTableName <> "" THEN DO:
      419       MESSAGE
      420         "Record with RECID '" v-recid "' is in table" SKIP
      421         "'" sTableName "'"
      422         VIEW-AS ALERT-BOX INFORMATION.
      423     END.
      424     ELSE DO:
      425       MESSAGE
      426         "Can not locate record with RECID '" v-RecID "'"
      427         VIEW-AS ALERT-BOX WARNING.
      428     END.
      429   END.
      430   ON CHOOSE OF b-refresh IN FRAME Dialog-Frame
      431   DO:
      432     RUN make-temp-table.
      433     OPEN QUERY BROWSE-1 FOR EACH temp-Lock NO-LOCK.
      434   END.
      435   ON DEFAULT-ACTION OF BROWSE-1 IN FRAME Dialog-Frame
      436   DO:
      437   END.
      438   ON RETURN OF FI-RecID IN FRAME Dialog-Frame
      439   DO:
      440     apply "entry":u to b-find .
      441   END.
      442   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   on help of frame Dialog-Frame
      444   do:
      445     run gbl/app_help.p
      446       (input this-procedure :file-name
      447       ,input ''
      448       ,input ?
      449       ) no-error.
      450     if error-status :error then do:
      451       message
      452         "Ошибка при вызове помощи"
      453         error-status :get-message(1)
      454         view-as alert-box .
      455     end.
      456   end.
      457   run minbtn-set in this-procedure .
      458   on choose of b-help in frame Dialog-Frame
      459   do:
      460     apply "help":u to frame Dialog-Frame .
      461   end.
      462   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      463   procedure minbtn-set :
      464       do
      465           on error undo, return error return-value
      466           :
      467           define variable ii              as integer       no-undo .
      468           define variable fh              as widget-handle no-undo .
      469           define variable hh              as widget-handle no-undo .
      470           define variable v-h             as handle        extent 4 no-undo .
      471           define variable v-name-button   as character     no-undo .
      472           define variable v-help-old-x    as decimal       no-undo .
      473           define variable v-help-old-y    as decimal       no-undo .
      474           define variable v-help-old-size as decimal       no-undo .
      475           define variable v-frame-width   as decimal       no-undo .
      476           define variable jj              as integer       no-undo .
      477           do
      478               on error undo, return error
      479               :
      480               assign
      481                   v-frame-width = frame Dialog-Frame:width - 0.3
      482                   fh            = frame Dialog-Frame:first-child
      483                   hh            = fh:first-child
      484                   ii            = 1
      485                   .
      486               do while valid-handle(hh):
      487                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      488                   do:
      489                       case lc(hh:name) :
      490                           when "b-help" then
      491                               do:
      492                                   hh:load-image-up("cmp/b-help.bmp":u) .
      493                                   hh:load-image-down("cmp/b-help.bmp":u) .
      494                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      495                                   hh:TOOLTIP = "Помощь" .
      496                                   v-help-old-x = hh:column .
      497                                   v-help-old-y = hh:row    .
      498                                   v-help-old-size = hh:width .
      499                                   hh:width-chars = 2.5 .
      500                               end.
      501                           when "b-print" then
      502                               do:
      503                                   hh:load-image("cmp/b-print.bmp":u) .
      504                                   hh:TOOLTIP = "Печать" .
      505                                   v-h[ii] = hh:handle .
      506                                   ii = ii + 1 .
      507                                   hh:width-chars = 3 .
      508                               end.
      509                           when "b-history" or
      510                           when "b-hist" then
      511                               do:
      512                                   hh:load-image("cmp/b-hist.bmp":u) .
      513                                   hh:TOOLTIP = "История" .
      514                                   v-h[ii] = hh:handle .
      515                                   ii = ii + 1 .
      516                                   hh:width-chars = 3 .
      517                               end.
      518                           when "b-sch" then
      519                               do:
      520                                   hh:load-image("cmp/b-sch.bmp":u) .
      521                                   hh:TOOLTIP = "Установка Фильтра" .
      522                                   v-h[ii] = hh:handle .
      523                                   ii = ii + 1 .
      524                                   hh:width-chars = 3 .
      525                               end.
      526                           when "b-hist-user" then
      527                               do:
      528                                   hh:load-image("cmp/b-hist.bmp":u) .
      529                                   hh:TOOLTIP = "История пользователя" .
      530                                   ii = ii + 1 .
      531                               end.
      532                       end case.
      533                   end.
      534                   hh = hh:next-sibling.
      535               end.
      536               b-help:column = v-frame-width - b-help:width-chars.
      537               jj = 0.
      538               repeat ii = 4 to 1 by -1 :
      539                   if valid-handle (v-h[ii] ) then
      540                   do:
      541                       jj  = jj + 1 .
      542                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      543                       v-h[ii]:row    = v-help-old-y .
      544                   end.
      545               end.
      546           end.
      547       end.
      548   end procedure.
      549   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      550   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      551   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      552   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      553   define variable v-diasize-current-frame-width  as decimal   no-undo .
      554   define variable v-diasize-current-frame-height as decimal   no-undo .
      555   define variable v-diasize-change-size          as logical   no-undo .
      556   define variable v-diasize-resize-button        as handle    no-undo .
      557   define variable v-diasize-wndmax               as logical   no-undo .
      558   define variable v-diasize-wndstore             as logical   no-undo .
      559   define variable v-diasize-proc-name            as character no-undo .
      560   define variable v-diasize-browse-handle        as handle    no-undo .
      561   define variable v-diasize-browse-number        as integer   no-undo .
      562   define variable v-diasize-need-full-display    as logical   no-undo init false .
      563   define temp-table temp-diasize-handle no-undo
      564     field handle-value  as handle
      565     field save-position as decimal
      566     index xpk is primary unique handle-value
      567     .
      568   define temp-table temp-browse-handle no-undo
      569     field browse-type   as character
      570     field browse-number as integer
      571     field browse-handle as handle
      572     field original-size as decimal
      573     index xpk is primary unique browse-type browse-number
      574     index xie browse-type browse-handle
      575   .
      576   procedure diasize_change-height :
      577     define input  parameter p-change-value  as decimal   no-undo .
      578     define input  parameter p-move-resize   as logical   no-undo .
      579     define variable v-field-group-handle    as handle    no-undo .
      580     define variable v-object-handle         as handle    no-undo .
      581     define variable v-frame-height          as decimal   no-undo .
      582     define variable v-frame-virtual-height  as decimal   no-undo .
      583     define variable v-browse-height         as decimal   no-undo .
      584     define variable v-window-height         as decimal   no-undo .
      585     define variable v-window-virtual-height as decimal   no-undo .
      586     define variable v-change-sign           as integer   no-undo .
      587     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      588     define buffer buf_temp-browse-handle  for temp-browse-handle .
      589     if p-change-value > 0
      590     then do:
      591       if frame Dialog-Frame :height + p-change-value
      592           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      593       then do:
      594         assign
      595           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      596                           - (frame Dialog-Frame :height-chars)
      597         .
      598         if p-change-value <= 0
      599         then do:
      600           run diasize_position-resize-button in this-procedure .
      601           return .
      602         end.
      603       end.
      604     end.
      605     if p-change-value < 0
      606     then do:
      607       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      608       then do:
      609         assign
      610           p-change-value = v-diasize-orig-frame-height
      611                          - (frame Dialog-Frame :height-chars)
      612         .
      613         if p-change-value >= 0
      614         then do:
      615           run diasize_position-resize-button in this-procedure .
      616           return .
      617         end.
      618       end.
      619     end.
      620     if p-change-value >= 0
      621     then do:
      622       assign
      623         v-change-sign = 1
      624       .
      625     end.
      626     else do:
      627       assign
      628         v-change-sign = -1
      629       .
      630     end.
      631     assign
      632       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      633     .
      634     if p-change-value = 0
      635     then do:
      636       run diasize_position-resize-button in this-procedure .
      637       return .
      638     end.
      639     move_block:
      640     do
      641     on error undo move_block, retry move_block
      642     :
      643       if retry
      644       then do:
      645         do
      646         on error undo move_block, leave move_block
      647         :
      648           if p-change-value > 0
      649           then do:
      650             for each buf_temp-diasize-handle
      651             on error undo, next
      652             :
      653               assign
      654                 v-object-handle = buf_temp-diasize-handle.handle-value
      655               .
      656               if v-object-handle <> v-diasize-resize-button
      657               then do:
      658                 assign
      659                   v-object-handle :row = buf_temp-diasize-handle.save-position
      660                 .
      661               end.
      662             end.
      663             assign
      664               v-diasize-browse-handle :height = v-browse-height
      665             .
      666             for each buf_temp-browse-handle
      667               where buf_temp-browse-handle.browse-type = 'height':u
      668             on error undo, next
      669             :
      670               assign
      671                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      672               .
      673             end.
      674             assign
      675               frame Dialog-Frame :height = v-frame-height
      676             .
      677             if frame Dialog-Frame :scrollable = true
      678             then do:
      679               assign
      680                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      681               .
      682             end.
      683             run diasize_position-resize-button in this-procedure .
      684           end.
      685           else do:
      686             if frame Dialog-Frame :scrollable = true
      687             then do:
      688               assign
      689                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      690               .
      691             end.
      692             assign
      693               frame Dialog-Frame :height = v-frame-height
      694             .
      695             assign
      696               v-diasize-browse-handle :height = v-browse-height
      697             .
      698             for each buf_temp-browse-handle
      699               where buf_temp-browse-handle.browse-type = 'height':u
      700             on error undo, next
      701             :
      702               assign
      703                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      704               .
      705             end.
      706             for each buf_temp-diasize-handle
      707             on error undo, next
      708             :
      709               assign
      710                 v-object-handle = buf_temp-diasize-handle.handle-value
      711               .
      712               if v-object-handle <> v-diasize-resize-button
      713               then do:
      714                 assign
      715                   v-object-handle :row = buf_temp-diasize-handle.save-position
      716                 .
      717               end.
      718             end.
      719             run diasize_position-resize-button in this-procedure .
      720           end.
      721           assign
      722             v-diasize-change-size = false
      723           .
      724           leave move_block .
      725         end.
      726       end.
      727       assign
      728         v-diasize-need-full-display = true
      729       .
      730       if v-diasize-change-size = false
      731       then do:
      732         assign
      733           v-diasize-change-size = true
      734         .
      735       end.
      736       else do:
      737         return .
      738       end.
      739       assign
      740         v-frame-height = frame Dialog-Frame :height
      741         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      742         v-browse-height = v-diasize-browse-handle :height
      743       .
      744       for each buf_temp-browse-handle
      745         where buf_temp-browse-handle.browse-type = 'height':u
      746       :
      747         assign
      748           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      749         .
      750       end.
      751       for each buf_temp-diasize-handle
      752       :
      753         delete buf_temp-diasize-handle .
      754       end.
      755       assign
      756         v-field-group-handle = frame Dialog-Frame :first-child
      757       .
      758       do while valid-handle(v-field-group-handle)
      759       :
      760         assign
      761           v-object-handle = v-field-group-handle :first-child
      762         .
      763         do while valid-handle(v-object-handle)
      764         :
      765           if  v-object-handle <> v-diasize-browse-handle :handle
      766           and can-query(v-object-handle, "row")
      767           and can-query(v-object-handle, "height")
      768           and ( v-object-handle :row > v-diasize-browse-handle :row )
      769           then do:
      770             find first buf_temp-browse-handle
      771               where buf_temp-browse-handle.browse-type   = 'height':u
      772                 and buf_temp-browse-handle.browse-handle = v-object-handle
      773               no-error .
      774             if available buf_temp-browse-handle
      775             then do:
      776             end.
      777             else do:
      778               create buf_temp-diasize-handle .
      779               assign
      780                 buf_temp-diasize-handle.handle-value  = v-object-handle
      781                 buf_temp-diasize-handle.save-position = v-object-handle :row
      782               .
      783             end.
      784           end.
      785           assign
      786             v-object-handle = v-object-handle :next-sibling
      787           .
      788         end.
      789         assign
      790           v-field-group-handle = v-field-group-handle :next-sibling
      791         .
      792       end.
      793       do with frame Dialog-Frame
      794       :
      795         hide v-diasize-resize-button .
      796         assign
      797           v-diasize-resize-button :row    = 1
      798           v-diasize-resize-button :column = 1
      799         .
      800       end.
      801       if p-change-value > 0
      802       then do:
      803         if frame Dialog-Frame :scrollable = true
      804         then do:
      805           assign
      806             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      807             no-error .
      808           if error-status :error
      809           or error-status :get-message(1) <> ""
      810           then do:
      811             undo move_block, retry move_block .
      812           end.
      813         end.
      814         assign
      815           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      816           no-error .
      817         if error-status :error
      818         or error-status :get-message(1) <> ""
      819         then do:
      820           undo move_block, retry move_block .
      821         end.
      822         assign
      823           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      824           no-error .
      825         if error-status :error
      826         or error-status :get-message(1) <> ""
      827         then do:
      828           undo move_block, retry move_block .
      829         end.
      830         for each buf_temp-browse-handle
      831           where buf_temp-browse-handle.browse-type = 'height':u
      832         on error undo move_block, retry move_block
      833         :
      834           assign
      835             buf_temp-browse-handle.browse-handle :height
      836               = buf_temp-browse-handle.browse-handle :height + p-change-value
      837             no-error .
      838           if error-status :error
      839           or error-status :get-message(1) <> ""
      840           then do:
      841             undo move_block, retry move_block .
      842           end.
      843         end.
      844         for each buf_temp-diasize-handle
      845         on error undo move_block, retry move_block
      846         :
      847           assign
      848             v-object-handle = buf_temp-diasize-handle.handle-value
      849           .
      850           if v-object-handle <> v-diasize-resize-button
      851           then do:
      852             assign
      853               v-object-handle :row = v-object-handle :row + p-change-value
      854               no-error .
      855             if error-status :error
      856             or error-status :get-message(1) <> ""
      857             then do:
      858               undo move_block, retry move_block .
      859             end.
      860           end.
      861         end.
      862       end.
      863       else do:
      864         for each buf_temp-diasize-handle
      865         on error undo move_block, retry move_block
      866         :
      867           assign
      868             v-object-handle = buf_temp-diasize-handle.handle-value
      869           .
      870           if v-object-handle <> v-diasize-resize-button
      871           then do:
      872             assign
      873               v-object-handle :row = v-object-handle :row + p-change-value
      874               no-error .
      875             if error-status :error
      876             or error-status :get-message(1) <> ""
      877             then do:
      878               undo move_block, retry move_block .
      879             end.
      880           end.
      881         end.
      882         assign
      883           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      884           no-error .
      885         if error-status :error
      886         or error-status :get-message(1) <> ""
      887         then do:
      888           undo move_block, retry move_block .
      889         end.
      890         for each buf_temp-browse-handle
      891           where buf_temp-browse-handle.browse-type = 'height':u
      892         on error undo move_block, retry move_block
      893         :
      894           assign
      895             buf_temp-browse-handle.browse-handle :height
      896               = buf_temp-browse-handle.browse-handle :height + p-change-value
      897             no-error .
      898           if error-status :error
      899           or error-status :get-message(1) <> ""
      900           then do:
      901             undo move_block, retry move_block .
      902           end.
      903         end.
      904         assign
      905           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      906           no-error .
      907         if error-status :error
      908         or error-status :get-message(1) <> ""
      909         then do:
      910           undo move_block, retry move_block .
      911         end.
      912         if frame Dialog-Frame :scrollable = true
      913         then do:
      914           assign
      915             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      916             no-error .
      917           if error-status :error
      918           or error-status :get-message(1) <> ""
      919           then do:
      920             undo move_block, retry move_block .
      921           end.
      922         end.
      923       end.
      924       if p-move-resize = true
      925       then do:
      926         run diasize_position-resize-button in this-procedure .
      927       end.
      928       if v-diasize-wndstore = true
      929       then do:
      930         if connected("ub") = true
      931         then do:
      932           define variable v-cntxt-db-num        as integer   no-undo .
      933           define variable v-cntxt-userid        as character no-undo .
      934           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      935                                             , OUTPUT v-cntxt-userid
      936                                             ) .
      937           run gbl/wndsizew.p
      938             (input  v-cntxt-db-num
      939             ,input  v-cntxt-userid
      940             ,input  v-diasize-proc-name
      941             ,input  'height':u
      942             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      943             ) .
      944         end.
      945       end.
      946     end.
      947     assign
      948       v-diasize-change-size = false
      949     .
      950   end procedure.
      951   procedure diasize_set-height :
      952     define input  parameter p-new-height  as decimal   no-undo .
      953     define input  parameter p-move-resize as logical   no-undo .
      954     do
      955     on error undo, return error return-value
      956     :
      957       run diasize_change-height in this-procedure
      958         (input  (p-new-height - frame Dialog-Frame :height)
      959         ,input  p-move-resize
      960         ) .
      961     end.
      962   end procedure.
      963   procedure diasize_change-width :
      964     define input  parameter p-change-value as decimal   no-undo .
      965     define input  parameter p-move-resize  as logical   no-undo .
      966     define variable v-field-group-handle   as handle    no-undo .
      967     define variable v-object-handle        as handle    no-undo .
      968     define variable v-frame-width          as decimal   no-undo .
      969     define variable v-frame-virtual-width  as decimal   no-undo .
      970     define variable v-browse-width         as decimal   no-undo .
      971     define variable v-window-width         as decimal   no-undo .
      972     define variable v-window-virtual-width as decimal   no-undo .
      973     define variable v-change-sign          as integer   no-undo .
      974     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      975     define buffer buf_temp-browse-handle  for temp-browse-handle .
      976     if p-change-value > 0
      977     then do:
      978       if frame Dialog-Frame :width + p-change-value >
      979           session :width-chars
      980       then do:
      981         assign
      982           p-change-value = session :width-chars - frame Dialog-Frame :width
      983         .
      984         if p-change-value <= 0
      985         then do:
      986           run diasize_position-resize-button in this-procedure .
      987           return .
      988         end.
      989       end.
      990     end.
      991     if p-change-value < 0
      992     then do:
      993       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      994       then do:
      995         assign
      996           p-change-value = v-diasize-orig-frame-width
      997                          - frame Dialog-Frame :width
      998         .
      999         if p-change-value >= 0
     1000         then do:
     1001           run diasize_position-resize-button in this-procedure .
     1002           return .
     1003         end.
     1004       end.
     1005     end.
     1006     if p-change-value >= 0
     1007     then do:
     1008       assign
     1009         v-change-sign = 1
     1010       .
     1011     end.
     1012     else do:
     1013       assign
     1014         v-change-sign = -1
     1015       .
     1016     end.
     1017     assign
     1018       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1019     .
     1020     if p-change-value = 0
     1021     then do:
     1022       run diasize_position-resize-button in this-procedure .
     1023       return .
     1024     end.
     1025     move_block:
     1026     do
     1027     on error undo move_block, leave move_block
     1028     :
     1029       if retry
     1030       then do:
     1031         do
     1032         on error undo move_block, leave move_block
     1033         :
     1034           if p-change-value > 0
     1035           then do:
     1036             for each buf_temp-diasize-handle
     1037             on error undo, next
     1038             :
     1039               assign
     1040                 v-object-handle = buf_temp-diasize-handle.handle-value
     1041               .
     1042               if v-object-handle <> v-diasize-resize-button
     1043               then do:
     1044                 assign
     1045                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1046                 .
     1047               end.
     1048             end.
     1049             assign
     1050               v-diasize-browse-handle :width = v-browse-width
     1051             .
     1052             for each buf_temp-browse-handle
     1053               where buf_temp-browse-handle.browse-type = 'width':u
     1054             on error undo, next
     1055             :
     1056               assign
     1057                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1058               .
     1059             end.
     1060             assign
     1061               frame Dialog-Frame :width = v-frame-width
     1062             .
     1063             if frame Dialog-Frame :scrollable = true
     1064             then do:
     1065               assign
     1066                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1067               .
     1068             end.
     1069             run diasize_position-resize-button in this-procedure .
     1070           end.
     1071           else do:
     1072             if frame Dialog-Frame :scrollable = true
     1073             then do:
     1074               assign
     1075                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1076               .
     1077             end.
     1078             assign
     1079               frame Dialog-Frame :width = v-frame-width
     1080             .
     1081             for each buf_temp-browse-handle
     1082               where buf_temp-browse-handle.browse-type = 'width':u
     1083             on error undo, next
     1084             :
     1085               assign
     1086                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1087               .
     1088             end.
     1089             assign
     1090               v-diasize-browse-handle :width = v-browse-width
     1091             .
     1092             for each buf_temp-diasize-handle
     1093             on error undo, next
     1094             :
     1095               assign
     1096                 v-object-handle = buf_temp-diasize-handle.handle-value
     1097               .
     1098               if v-object-handle <> v-diasize-resize-button
     1099               then do:
     1100                 assign
     1101                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1102                 .
     1103               end.
     1104             end.
     1105             run diasize_position-resize-button in this-procedure .
     1106           end.
     1107           assign
     1108             v-diasize-change-size = false
     1109           .
     1110           leave move_block .
     1111         end.
     1112       end.
     1113       assign
     1114         v-diasize-need-full-display = true
     1115       .
     1116       if v-diasize-change-size = false
     1117       then do:
     1118         assign
     1119           v-diasize-change-size = true
     1120         .
     1121       end.
     1122       else do:
     1123         return .
     1124       end.
     1125       assign
     1126         v-frame-width = frame Dialog-Frame :width
     1127         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1128         v-browse-width = v-diasize-browse-handle :width
     1129       .
     1130       for each buf_temp-browse-handle
     1131         where buf_temp-browse-handle.browse-type = 'width':u
     1132       :
     1133         assign
     1134           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1135         .
     1136       end.
     1137       for each buf_temp-diasize-handle
     1138       :
     1139         delete buf_temp-diasize-handle .
     1140       end.
     1141       assign
     1142         v-field-group-handle = frame Dialog-Frame :first-child
     1143       .
     1144       do while valid-handle(v-field-group-handle)
     1145       :
     1146         assign
     1147           v-object-handle = v-field-group-handle :first-child
     1148         .
     1149         do while valid-handle(v-object-handle)
     1150         :
     1151           if  v-object-handle <> v-diasize-browse-handle :handle
     1152           and v-object-handle <> v-diasize-resize-button
     1153           and can-query(v-object-handle, "row")
     1154           and can-query(v-object-handle, "height")
     1155           and ( v-object-handle :col + v-object-handle :width
     1156                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1157               )
     1158           then do:
     1159             find first buf_temp-browse-handle
     1160               where buf_temp-browse-handle.browse-type   = 'width':u
     1161                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1162               no-error .
     1163             if available buf_temp-browse-handle
     1164             then do:
     1165             end.
     1166             else do:
     1167               create buf_temp-diasize-handle .
     1168               assign
     1169                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1170                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1171               .
     1172             end.
     1173           end.
     1174           assign
     1175             v-object-handle = v-object-handle :next-sibling
     1176           .
     1177         end.
     1178         assign
     1179           v-field-group-handle = v-field-group-handle :next-sibling
     1180         .
     1181       end.
     1182       do with frame Dialog-Frame
     1183       :
     1184         hide v-diasize-resize-button .
     1185         v-diasize-resize-button :row = 1.
     1186         v-diasize-resize-button :column = 1.
     1187       end.
     1188       if p-change-value > 0
     1189       then do:
     1190         if frame Dialog-Frame :scrollable = true
     1191         then do:
     1192           assign
     1193             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1194             no-error .
     1195           if error-status :error
     1196           or error-status :get-message(1) <> ""
     1197           then do:
     1198             undo move_block, retry move_block.
     1199           end.
     1200         end.
     1201         assign
     1202           frame Dialog-Frame :width = v-frame-width + p-change-value
     1203           no-error .
     1204         if error-status :error
     1205         or error-status :get-message(1) <> ""
     1206         then do:
     1207           undo move_block, retry move_block.
     1208         end.
     1209         assign
     1210           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1211         no-error .
     1212         if error-status :error
     1213         or error-status :get-message(1) <> ""
     1214         then do:
     1215           undo move_block, retry move_block.
     1216         end.
     1217         for each buf_temp-browse-handle
     1218           where buf_temp-browse-handle.browse-type = 'width':u
     1219         on error undo move_block, retry move_block
     1220         :
     1221           assign
     1222             buf_temp-browse-handle.browse-handle :width
     1223               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1224             no-error .
     1225           if error-status :error
     1226           or error-status :get-message(1) <> ""
     1227           then do:
     1228             undo move_block, retry move_block .
     1229           end.
     1230         end.
     1231         for each buf_temp-diasize-handle
     1232         on error undo move_block, retry move_block
     1233         :
     1234           assign
     1235             v-object-handle = buf_temp-diasize-handle.handle-value
     1236           .
     1237           if v-object-handle <> v-diasize-resize-button
     1238           then do:
     1239             assign
     1240               v-object-handle :col = v-object-handle :col + p-change-value
     1241               no-error .
     1242             if error-status :error
     1243             or error-status :get-message(1) <> ""
     1244             then do:
     1245               undo move_block, retry move_block .
     1246             end.
     1247           end.
     1248         end.
     1249       end.
     1250       else do:
     1251         for each buf_temp-diasize-handle
     1252         on error undo move_block, retry move_block
     1253         :
     1254           assign
     1255             v-object-handle = buf_temp-diasize-handle.handle-value
     1256           .
     1257           if v-object-handle <> v-diasize-resize-button
     1258           then do:
     1259             assign
     1260               v-object-handle :col = v-object-handle :col + p-change-value
     1261               no-error .
     1262             if error-status :error
     1263             or error-status :get-message(1) <> ""
     1264             then do:
     1265               undo move_block, retry move_block .
     1266             end.
     1267           end.
     1268         end.
     1269         for each buf_temp-browse-handle
     1270           where buf_temp-browse-handle.browse-type = 'width':u
     1271         on error undo move_block, retry move_block
     1272         :
     1273           assign
     1274             buf_temp-browse-handle.browse-handle :width
     1275               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1276             no-error .
     1277           if error-status :error
     1278           or error-status :get-message(1) <> ""
     1279           then do:
     1280             undo move_block, retry move_block .
     1281           end.
     1282         end.
     1283         assign
     1284           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1285           no-error .
     1286         if error-status :error
     1287         or error-status :get-message(1) <> ""
     1288         then do:
     1289           undo move_block, retry move_block.
     1290         end.
     1291         assign
     1292           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1293         no-error .
     1294         if error-status :error
     1295         or error-status :get-message(1) <> ""
     1296         then do:
     1297           undo move_block, retry move_block.
     1298         end.
     1299         if frame Dialog-Frame :scrollable = true
     1300         then do:
     1301           assign
     1302             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1303           no-error .
     1304           if error-status :error
     1305           or error-status :get-message(1) <> ""
     1306           then do:
     1307             undo move_block, retry move_block.
     1308           end.
     1309         end.
     1310       end.
     1311       if p-move-resize
     1312       then do:
     1313         run diasize_position-resize-button in this-procedure .
     1314       end.
     1315       if v-diasize-wndstore = true
     1316       then do:
     1317         if connected("ub") = true
     1318         then do:
     1319           define variable v-cntxt-db-num        as integer   no-undo .
     1320           define variable v-cntxt-userid        as character no-undo .
     1321           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1322                                             , OUTPUT v-cntxt-userid
     1323                                             ) .
     1324           run gbl/wndsizew.p
     1325             (input  v-cntxt-db-num
     1326             ,input  v-cntxt-userid
     1327             ,input  v-diasize-proc-name
     1328             ,input  'width':u
     1329             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1330             ) .
     1331         end.
     1332       end.
     1333     end.
     1334     assign
     1335       v-diasize-change-size = false
     1336     .
     1337   end procedure.
     1338   procedure diasize_set-width :
     1339     define input  parameter p-new-width  as decimal   no-undo .
     1340     define input  parameter p-move-resize as logical   no-undo .
     1341     do
     1342     on error undo, return error return-value
     1343     :
     1344       run diasize_change-width in this-procedure
     1345         (input  (p-new-width - frame Dialog-Frame :width)
     1346         ,input  p-move-resize
     1347         ) .
     1348     end.
     1349   end procedure.
     1350   procedure diasize_position-resize-button :
     1351     do with frame Dialog-Frame
     1352     :
     1353       hide v-diasize-resize-button .
     1354       assign
     1355         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1356                     - 1
     1357                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1358         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1359                     - 1
     1360                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1361       .
     1362       view v-diasize-resize-button .
     1363     end.
     1364   end procedure.
     1365   on alt-right anywhere
     1366   do:
     1367     run diasize_change-width in this-procedure
     1368       (input 1
     1369       ,input true
     1370       ) .
     1371     return no-apply .
     1372   end.
     1373   on alt-left anywhere
     1374   do:
     1375     run diasize_change-width in this-procedure
     1376       (input -1
     1377       ,input true
     1378       ) .
     1379     return no-apply .
     1380   end.
     1381   on alt-down anywhere
     1382   do:
     1383     run diasize_change-height in this-procedure
     1384       (input 1
     1385       ,input true
     1386       ) .
     1387     return no-apply .
     1388   end.
     1389   on alt-up anywhere
     1390   do:
     1391     run diasize_change-height in this-procedure
     1392       (input -1
     1393       ,input true
     1394       ) .
     1395     return no-apply .
     1396   end.
     1397   on alt-enter of frame Dialog-Frame
     1398   do:
     1399     run diasize_maximize in this-procedure
     1400       (input  ?
     1401       ).
     1402     return no-apply .
     1403   end.
     1404   procedure diasize_end-move :
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       define variable v-row-delta as decimal   no-undo .
     1409       define variable v-col-delta as decimal   no-undo .
     1410       define variable v-new-row as decimal   no-undo .
     1411       define variable v-new-col as decimal   no-undo .
     1412       assign
     1413         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1414         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1415       .
     1416       assign
     1417         v-row-delta = v-new-row - frame Dialog-Frame :height
     1418         v-col-delta = v-new-col - frame Dialog-Frame :width
     1419       .
     1420       run diasize_change-height in this-procedure
     1421         (input v-row-delta
     1422         ,input true
     1423         ) .
     1424       run diasize_change-width in this-procedure
     1425         (input v-col-delta
     1426         ,input true
     1427         ) .
     1428     end.
     1429   end procedure.
     1430   procedure diasize_maximize :
     1431     define input  parameter p-action as logical   no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       if p-action = ?
     1436       then do:
     1437         if v-diasize-need-maximize = true
     1438         then do:
     1439           assign
     1440             p-action = true
     1441           .
     1442         end.
     1443         else do:
     1444           assign
     1445             p-action = false
     1446           .
     1447         end.
     1448       end.
     1449       if p-action = true
     1450       then do:
     1451         run diasize_change-height in this-procedure
     1452           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1453               - frame Dialog-Frame :height-chars
     1454           ,input true
     1455           ) .
     1456         run diasize_change-width in this-procedure
     1457           (input session :width-chars
     1458               - frame Dialog-Frame :width-chars
     1459           ,input true
     1460           ) .
     1461         assign
     1462           v-diasize-need-maximize = false
     1463         .
     1464       end.
     1465       else do:
     1466         run diasize_change-width in this-procedure
     1467           (input v-diasize-orig-frame-width
     1468               - frame Dialog-Frame :width-chars
     1469           ,input true
     1470           ) .
     1471         run diasize_change-height in this-procedure
     1472           (input v-diasize-orig-frame-height
     1473               - frame Dialog-Frame :height-chars
     1474           ,input true
     1475           ) .
     1476         assign
     1477           v-diasize-need-maximize = true
     1478         .
     1479       end.
     1480     end.
     1481   end procedure.
     1482   procedure diasize_restore-orig-size :
     1483     do
     1484     on error undo, return error return-value
     1485     :
     1486       assign
     1487         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1488         v-diasize-current-frame-height = frame Dialog-Frame :height
     1489       .
     1490       run diasize_set-height in this-procedure
     1491         (input  v-diasize-orig-frame-height
     1492         ,input  true
     1493         ) .
     1494       run diasize_set-width in this-procedure
     1495         (input  v-diasize-orig-frame-width
     1496         ,input  true
     1497         ) .
     1498     end.
     1499   end procedure.
     1500   procedure diasize_restore-current-size :
     1501     do
     1502     on error undo, return error return-value
     1503     :
     1504       run diasize_set-height in this-procedure
     1505         (input  v-diasize-current-frame-height
     1506         ,input  true
     1507         ) .
     1508       run diasize_set-width in this-procedure
     1509         (input  v-diasize-current-frame-width
     1510         ,input  true
     1511         ) .
     1512     end.
     1513   end procedure.
     1514   procedure diasize_set-browse-handle :
     1515     define input  parameter p-browse-handle as handle   no-undo .
     1516     define buffer buf_temp-browse-handle for temp-browse-handle .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       assign
     1521         v-diasize-browse-handle = p-browse-handle
     1522       .
     1523       for each buf_temp-browse-handle
     1524       on error undo, return error return-value
     1525       :
     1526         delete buf_temp-browse-handle .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure diasize_add_browse :
     1531     define input  parameter p-browse-type   as character no-undo .
     1532     define input  parameter p-browse-handle as handle    no-undo .
     1533     define buffer buf_temp-browse-handle for temp-browse-handle .
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       assign
     1538         v-diasize-browse-number = v-diasize-browse-number + 1
     1539       .
     1540       create buf_temp-browse-handle .
     1541       assign
     1542         buf_temp-browse-handle.browse-type   = p-browse-type
     1543         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1544         buf_temp-browse-handle.browse-handle = p-browse-handle
     1545       .
     1546     end.
     1547   end procedure.
     1548   procedure diasize_init :
     1549     define variable v-default-value    as logical   no-undo .
     1550     define variable v-restore-saved    as logical   no-undo .
     1551     define variable v-resize-value-str as character no-undo .
     1552     do
     1553     on error undo, return error return-value
     1554     :
     1555       do with frame Dialog-Frame
     1556       :
     1557         assign
     1558           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1559           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1560           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1561         .
     1562         create button v-diasize-resize-button
     1563         assign
     1564           parent        = frame Dialog-Frame :first-child
     1565           label         = "s"
     1566           height-pixels = 16
     1567           width-pixels  = 16
     1568           visible       = true
     1569           sensitive     = true
     1570           movable       = true
     1571           triggers:
     1572             on end-move persistent run diasize_end-move in this-procedure .
     1573           end triggers.
     1574         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1575         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1576         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1577         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1578         assign
     1579           v-diasize-wndmax = false
     1580         .
     1581         if connected("ub") = true
     1582         then do:
     1583           define variable v-cntxt-db-num        as integer   no-undo .
     1584           define variable v-cntxt-userid        as character no-undo .
     1585           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1586                                             , OUTPUT v-cntxt-userid
     1587                                             ) .
     1588           run gbl/wndpar_r.p
     1589             (input  v-cntxt-db-num
     1590             ,input  v-cntxt-userid
     1591             ,input  'wndmax':U
     1592             ,output v-diasize-wndmax
     1593             ,output v-default-value
     1594             ) .
     1595         end.
     1596         assign
     1597           v-diasize-wndstore = false
     1598         .
     1599         if connected("ub") = true
     1600         then do:
     1601           run gbl/wndpar_r.p
     1602             (input  v-cntxt-db-num
     1603             ,input  v-cntxt-userid
     1604             ,input  'wndstore':U
     1605             ,output v-diasize-wndstore
     1606             ,output v-default-value
     1607             ) .
     1608         end.
     1609         assign
     1610           v-diasize-proc-name = entry(1, program-name(2), '.')
     1611         .
     1612         if v-diasize-wndstore = true
     1613         then do:
     1614           assign
     1615             v-restore-saved = false
     1616           .
     1617           if connected("ub") = true
     1618           then do:
     1619             run gbl/wndsizer.p
     1620               (input  v-cntxt-db-num
     1621               ,input  v-cntxt-userid
     1622               ,input  v-diasize-proc-name
     1623               ,input  'height':u
     1624               ,output v-resize-value-str
     1625               ) .
     1626             if v-resize-value-str <> '':U
     1627             then do:
     1628               run diasize_change-height in this-procedure
     1629                 (input  integer(v-resize-value-str)
     1630                 ,input  true
     1631                 ) .
     1632               assign
     1633                 v-restore-saved = true
     1634               .
     1635             end.
     1636           end.
     1637           if connected("ub") = true
     1638           then do:
     1639             run gbl/wndsizer.p
     1640               (input  v-cntxt-db-num
     1641               ,input  v-cntxt-userid
     1642               ,input  v-diasize-proc-name
     1643               ,input  'width':u
     1644               ,output v-resize-value-str
     1645               ) .
     1646             if v-resize-value-str <> '':U
     1647             then do:
     1648               run diasize_change-width in this-procedure
     1649                 (input  integer(v-resize-value-str)
     1650                 ,input  true
     1651                 ) .
     1652               assign
     1653                 v-restore-saved = true
     1654               .
     1655             end.
     1656           end.
     1657           if v-restore-saved <> true
     1658           then do:
     1659             if v-diasize-wndmax = true
     1660             then do:
     1661               run diasize_maximize in this-procedure
     1662                 (input  true
     1663                 ) .
     1664             end.
     1665           end.
     1666         end.
     1667         else do:
     1668           if v-diasize-wndmax = true
     1669           then do:
     1670             run diasize_maximize in this-procedure
     1671               (input  true
     1672               ) .
     1673           end.
     1674         end.
     1675       end.
     1676     end.
     1677   end procedure.
     1678   procedure diasize_need-full-display :
     1679     define output parameter p-need-full-display as logical   no-undo .
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       assign
     1684         p-need-full-display = v-diasize-need-full-display
     1685       .
     1686       assign
     1687         v-diasize-need-full-display = false
     1688       .
     1689     end.
     1690   end procedure.
     1691   procedure get-context :
     1692      define output parameter p-db-num as integer          no-undo.
     1693      define output parameter p-user-id as character        no-undo.
     1694      define variable v-login               as character    no-undo.
     1695      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1696      define buffer buf_user-login  for ub.user-login .
     1697      do
     1698      on error undo, return error
     1699      :
     1700            FIND FIRST buf_sys-ctrl no-lock.
     1701            ASSIGN
     1702               v-login = USERID("ub")
     1703               p-db-num = buf_sys-ctrl.db-num
     1704            .
     1705            FIND FIRST buf_user-login
     1706                 WHERE buf_user-login.db-num = p-db-num
     1707                   AND buf_user-login.user-login = v-login
     1708                 no-lock
     1709                 no-error
     1710                 .
     1711            IF AVAILABLE buf_user-login
     1712            THEN DO:
     1713               assign
     1714                  p-user-id = buf_user-login.user-id
     1715               .
     1716            END.
     1717      end.
     1718   end procedure.
     1719       run diasize_init in this-procedure .
     1720   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1721   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1722     RUN make-temp-table.
     1723   MAIN-BLOCK:
     1724   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1725      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1726     RUN enable_UI.
     1727     WAIT-FOR GO OF FRAME Dialog-Frame.
     1728   END.
     1729   RUN disable_UI.
     1730     if valid-handle(h-findrec-program) then do:
     1731       delete procedure h-findrec-program .
     1732     end.
     1733     IF  sFindRecProgramName <> ?
     1734     AND sFindRecProgramName <> '' THEN DO:
     1735       OS-DELETE VALUE(sFindRecProgramName) NO-ERROR.
     1736     END.
     1737     if valid-handle(h-loadlock-program) then do:
     1738       delete procedure h-loadlock-program .
     1739     end.
     1740     if  s-loadlock-program <> ?
     1741     and s-loadlock-program <> "" then do:
     1742       os-delete value(s-loadlock-program) no-error.
     1743     end.
     1744   PROCEDURE disable_UI :
     1745     HIDE FRAME Dialog-Frame.
     1746   END PROCEDURE.
     1747   PROCEDURE enable_UI :
     1748     DISPLAY FI-RecID FI-ScanTime
     1749         WITH FRAME Dialog-Frame.
     1750     ENABLE RECT-1 BROWSE-1 FI-RecID b-find b-refresh b-help b-exit FI-ScanTime
     1751         WITH FRAME Dialog-Frame.
     1752     VIEW FRAME Dialog-Frame.
     1753     OPEN QUERY BROWSE-1 FOR EACH temp-Lock NO-LOCK.
     1754   END PROCEDURE.
     1755   PROCEDURE make-findrec-procedure :
     1756   DEF VAR sTableName AS CHARACTER NO-UNDO.
     1757     run gbl/_tmpfile.p ( "f":u , ".ped":u , OUTPUT sFindRecProgramName ).
     1758     OUTPUT TO VALUE(sFindRecProgramName).
     1759     PUT UNFORMATTED "procedure findrec : ":u + chr(10).
     1760     PUT UNFORMATTED "DEF INPUT PARAMETER pRECID AS RECID NO-UNDO.":u + chr(10).
     1761     define variable v-ind       as integer no-undo .
     1762     define variable v-proc-ind  as integer   no-undo .
     1763     define variable v-proc-name as character no-undo .
     1764     assign
     1765       v-proc-ind = 0
     1766     .
     1767     FOR EACH _File NO-LOCK
     1768       WHERE _File._Tbl-Type <> 'V'
     1769     :
     1770       assign
     1771         sTableName = _File._File-Name
     1772       .
     1773       assign
     1774         v-ind = v-ind + 1 .
     1775       .
     1776       if v-ind modulo 100 = 0
     1777       then do:
     1778         assign
     1779           v-proc-ind = v-proc-ind + 1
     1780           v-proc-name = 'findrec':u + string(v-proc-ind)
     1781         .
     1782         PUT UNFORMATTED
     1783             "  run " + v-proc-name + " in this-procedure (input pRECID) .":U + chr(10).
     1784         PUT UNFORMATTED
     1785             " RETURN return-value .":u + chr(10).
     1786         PUT UNFORMATTED "end procedure.":u + chr(10).
     1787         PUT UNFORMATTED "procedure " + v-proc-name + " : ":u + chr(10).
     1788         PUT UNFORMATTED "DEF INPUT PARAMETER pRECID AS RECID NO-UNDO.":u + chr(10).
     1789       end.
     1790       PUT UNFORMATTED
     1791           " FIND FIRST ":u + sTableName + " NO-LOCK":u
     1792         + " WHERE RECID(":u + sTableName + ") = pRECID NO-ERROR.":u
     1793         + " IF AVAIL ":u + sTableName + " THEN RETURN '":u + sTableName + "'.":u
     1794         + chr(10)
     1795       .
     1796     END.
     1797     PUT UNFORMATTED
     1798         " RETURN ''.":u + chr(10).
     1799     PUT UNFORMATTED "end procedure.":u + chr(10).
     1800     OUTPUT CLOSE.
     1801     run value(sFindRecProgramName) persistent set h-findrec-program .
     1802     run gbl/_tmpfile.p ( "f":u , ".ped":u , OUTPUT s-loadlock-program ) .
     1803     output to value(s-loadlock-program) .
     1804     PUT UNFORMATTED
     1805         "DEFINE TEMP-TABLE temp-Lock NO-UNDO                                        ":u + chr(10)
     1806       + "  FIELD Lock_RecID     AS RECID     LABEL 'RecId'                          ":u + chr(10)
     1807       + "  FIELD Lock_TableName AS CHARACTER LABEL 'Table Name' FORMAT 'x(30)'      ":u + chr(10)
     1808       + "  FIELD Lock_UserName  AS CHARACTER LABEL 'User Name'                      ":u + chr(10)
     1809       + "  FIELD Lock_Flags     AS CHARACTER LABEL 'Flags'                          ":u + chr(10)
     1810       + "  FIELD Lock_Type      as character LABEL 'Type'                           ":u + chr(10)
     1811       + ".                                                                          ":u + chr(10)
     1812       + "                                                                           ":u + chr(10)
     1813       + "procedure fill-lock :                                                      ":u + chr(10)
     1814       + "  define output parameter table for temp-lock .                            ":u + chr(10)
     1815       + "                                                                           ":u + chr(10)
     1816       + "  def var ind as integer no-undo .                                         ":u + chr(10)
     1817       + "                                                                           ":u + chr(10)
     1818       + "  FOR EACH _UserLock NO-LOCK                                               ":u + chr(10)
     1819       + "    WHERE _UserLock._UserLock-Usr <> ?                                     ":u + chr(10)
     1820       + "  :                                                                        ":u + chr(10)
     1821       + "    do ind = 1 to extent(_UserLock._UserLock-Recid)                        ":u + chr(10)
     1822       + "    :                                                                      ":u + chr(10)
     1823       + "      if _UserLock._UserLock-Recid[ind] <> ? then do:                      ":u + chr(10)
     1824       + "        create temp-lock.                                                  ":u + chr(10)
     1825       + "        assign                                                             ":u + chr(10)
     1826       + "          temp-lock.lock_recid    = _UserLock._UserLock-Recid[ind]         ":u + chr(10)
     1827       + "          temp-lock.lock_username = string(_UserLock._UserLock-Usr) + ' '  ":u + chr(10)
     1828       + "                                  + _UserLock._UserLock-Name               ":u + chr(10)
     1829       + "          temp-lock.lock_flags    = _UserLock._UserLock-Flags[ind]         ":u + chr(10)
     1830       + "          temp-lock.Lock_Type     = _UserLock._UserLock-Type[ind]          ":u + chr(10)
     1831       + "        .                                                                  ":u + chr(10)
     1832       + "      end.                                                                 ":u + chr(10)
     1833       + "    end.                                                                   ":u + chr(10)
     1834       + "  END.                                                                     ":u + chr(10)
     1835       + "end procedure .                                                            ":u + chr(10)
     1836     .
     1837     output close .
     1838     run value (s-loadlock-program) persistent set h-loadlock-program .
     1839   END PROCEDURE.
     1840   PROCEDURE make-temp-table :
     1841     define variable v-today as date      no-undo .
     1842     define variable v-time  as integer   no-undo .
     1843     RUN make-findrec-procedure.
     1844     FOR EACH temp-Lock:
     1845       DELETE temp-Lock.
     1846     END.
     1847     run cur-time in this-procedure ( output v-today
     1848                                    , output v-time
     1849                                    ).
     1850     DO WITH FRAME Dialog-Frame:
     1851       ASSIGN
     1852         FI-ScanTime:SCREEN-VALUE = '*** SCANNING ***'
     1853         FI-ScanTime = STRING( v-time, "HH:MM:SS" )
     1854       .
     1855     END.
     1856     if valid-handle (h-loadlock-program) then do:
     1857       run fill-lock in h-loadlock-program
     1858         (output table temp-lock
     1859         ).
     1860     end.
     1861     else do:
     1862       message
     1863         "Невозможно получить информацию о блокировках"
     1864         view-as alert-box error .
     1865     end.
     1866     for each temp-lock
     1867     :
     1868       run findrec in h-findrec-program (input temp-lock.lock_recid) no-error.
     1869       assign
     1870         temp-lock.lock_tablename = return-value
     1871       .
     1872     end.
     1873     DO WITH FRAME Dialog-Frame:
     1874       ASSIGN
     1875         FI-ScanTime:SCREEN-VALUE = FI-ScanTime
     1876       .
     1877     END.
     1878   END PROCEDURE.
