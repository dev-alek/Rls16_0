        1   using Ibs.Th.Gbl.XmlFilder.
        2   block-level on error undo, throw.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: mt-route.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: gbl/mt-route.p $":U .
        8   define variable vss-description as character no-undo init "Маршрутизатор сообщений радиотерминала ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure integerm :
       69     define input  parameter p-string      as character no-undo .
       70     define input  parameter p-allow-sign  as logical   no-undo .
       71     define input  parameter p-allow-comma as logical   no-undo .
       72     define output parameter p-value       as integer   no-undo .
       73     define output parameter p-data-valid  as logical   no-undo .
       74     define output parameter p-message     as character no-undo .
       75     define variable v-replace-string as character no-undo .
       76     do
       77     on error undo, return error return-value
       78     :
       79       if p-string = ?
       80       then do:
       81         assign
       82           p-value      = ?
       83           p-data-valid = false
       84           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       85         .
       86         return .
       87       end.
       88       if p-string = ""
       89       then do:
       90         assign
       91           p-value      = ?
       92           p-data-valid = false
       93           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
       94         .
       95         return .
       96       end.
       97       assign
       98         p-value = integer(p-string) no-error
       99       .
      100       if error-status :error = true
      101       then do:
      102         assign
      103           p-value      = ?
      104           p-data-valid = false
      105           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      106                                    ,p-string
      107                                    )
      108         .
      109         return .
      110       end.
      111       if index(p-string, ' ':u) > 0
      112       then do:
      113         assign
      114           p-value      = ?
      115           p-data-valid = false
      116           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      117                                    + "Строка содержит символы пробела"
      118                                    ,p-string
      119                                    )
      120         .
      121         return .
      122       end.
      123       assign
      124         v-replace-string = p-string
      125         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      126         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      127         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      128         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      129         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      130         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      131         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      132         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      134       .
      135       if p-allow-sign = true
      136       then do:
      137         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      138         then do:
      139           assign
      140             v-replace-string = substring(v-replace-string, 2)
      141           .
      142         end.
      143       end.
      144       else do:
      145         if substring(v-replace-string, 1, 1) = '+':u
      146         then do:
      147           assign
      148             p-value      = ?
      149             p-data-valid = false
      150             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      151                                     + "Задан параметр недопустимости знака челого числа. "
      152                                     + "Строка содержит символ плюс. "
      153                                     ,p-string
      154                                     )
      155           .
      156           return .
      157         end.
      158         if substring(v-replace-string, 1, 1) = '-':u
      159         then do:
      160           assign
      161             p-value      = ?
      162             p-data-valid = false
      163             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      164                                     + "Задан параметр недопустимости знака челого числа. "
      165                                     + "Строка содержит символ минус. "
      166                                     ,p-string
      167                                     )
      168           .
      169           return .
      170         end.
      171       end.
      172       if p-allow-comma = true
      173       then do:
      174         assign
      175           v-replace-string = replace(v-replace-string, ',', '')
      176         .
      177       end.
      178       else do:
      179         if index(v-replace-string, ',') > 0
      180         then do:
      181           assign
      182             p-value      = ?
      183             p-data-valid = false
      184             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      185                                     + "Задан параметр недопустимости знака разделителя тысяч."
      186                                     + "Строка содержит знак разделителя тысяч. "
      187                                     ,p-string
      188                                     )
      189           .
      190           return .
      191         end.
      192       end.
      193       if index(p-string, '.') > 0
      194       then do:
      195         assign
      196           p-value      = ?
      197           p-data-valid = false
      198           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      199                                    + "Строка содержит знак десятичной точки"
      200                                    ,p-string
      201                                    )
      202         .
      203         return .
      204       end.
      205       if v-replace-string <> fill('9', length(v-replace-string))
      206       then do:
      207         assign
      208           p-value      = ?
      209           p-data-valid = false
      210           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      211                                    + "Встречены символы, недопустимые для целого числа '&2'"
      212                                    ,p-string
      213                                    ,replace(v-replace-string, '9', '')
      214                                    )
      215         .
      216         return .
      217       end.
      218       assign
      219         p-data-valid = true
      220         p-message    = ""
      221       .
      222     end.
      223   end procedure.
      224   define new global shared variable g#library  as handle no-undo .
      225   define new global shared variable g#library2 as handle no-undo .
      226   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      227   procedure cur-time :
      228      define output parameter p-today as date      no-undo .
      229      define output parameter p-time  as integer   no-undo .
      230     do
      231     on error undo, return error
      232     :
      233       define variable v-date1 as date      no-undo .
      234       define variable v-date2 as date      no-undo .
      235       define variable v-time  as integer   no-undo .
      236       assign
      237         v-date1 = today
      238         v-time  = time
      239         v-date2 = today
      240       .
      241       if v-date1 <> v-date2
      242       then do:
      243         assign
      244           v-date1 = today
      245           v-time  = v-time
      246         .
      247       end.
      248       assign
      249         p-today = v-date1
      250         p-time  = v-time
      251       .
      252     end.
      253   end.
      254   function cur-time-date returns character
      255   :
      256     return string(today, '99/99/9999':U) .
      257   end.
      258   function cur-time-mjd returns decimal
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return integer(v-date) - 2400002 + (v-time / 86400) .
      267   end.
      268   function cur-time-get-ending-index returns integer
      269   (input p-number as integer
      270   )
      271   :
      272     if p-number < 0
      273     or p-number = ?
      274     then do:
      275       return 1 .
      276     end.
      277     define variable v-rest as integer   no-undo .
      278     assign
      279       p-number = p-number modulo 100
      280     .
      281     if p-number < 20
      282     then do:
      283       assign
      284         v-rest = p-number
      285       .
      286     end.
      287     else do:
      288       assign
      289         v-rest = p-number modulo 10
      290       .
      291     end.
      292     case v-rest :
      293       when 1
      294       then do:
      295         return 2 .
      296       end.
      297       when 2 or
      298       when 3 or
      299       when 4
      300       then do:
      301         return 3 .
      302       end.
      303       otherwise do:
      304         return 1 .
      305       end.
      306     end case .
      307   end.
      308   procedure cur-time-mjd-to-date :
      309      define input  parameter i-mjd-diff as decimal no-undo.
      310      define output parameter o-Date     as date    no-undo.
      311      define output parameter o-Time     as integer no-undo.
      312      define variable v-day-number as integer   no-undo .
      313      if    i-mjd-diff < 0
      314         or i-mjd-diff = ?
      315      then do:
      316         return "?" .
      317      end.
      318      assign
      319         v-day-number = truncate(i-mjd-diff,0).
      320         o-Date = date(v-day-number + 2400002).
      321         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      322     .
      323   end.
      324   function cur-time-mjd-to-string returns character
      325   (input p-mjd-diff as decimal
      326   )
      327   :
      328     define variable v-day-number as integer   no-undo .
      329     define variable v-seconds    as integer   no-undo .
      330     define variable v-hour       as integer   no-undo .
      331     define variable v-min        as integer   no-undo .
      332     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      333     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      334     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      335     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      336     if p-mjd-diff < 0
      337     or p-mjd-diff = ?
      338     then do:
      339       return "?" .
      340     end.
      341     assign
      342       v-day-number = integer(truncate(p-mjd-diff,0))
      343       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      344     .
      345     if v-seconds > 86400
      346     then do:
      347       assign
      348         v-seconds = 86400 - 1
      349       .
      350     end.
      351     if v-seconds < 0
      352     then do:
      353       assign
      354         v-seconds = 0
      355       .
      356     end.
      357     assign
      358       v-hour = truncate(v-seconds / 3600, 0)
      359     .
      360     assign
      361       v-seconds = v-seconds modulo 3600
      362     .
      363     assign
      364       v-min = truncate(v-seconds / 60, 0)
      365     .
      366     assign
      367       v-seconds = v-seconds modulo 60
      368     .
      369     return
      370         (if v-day-number <> 0
      371           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      372           else ""
      373         )
      374       + (if v-day-number <> 0 or v-hour <> 0
      375           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      376           else ""
      377         )
      378       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      379           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      380           else ""
      381         )
      382       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      383       .
      384   end.
      385   function cur-time-string returns character
      386   :
      387     define variable v-date as date      no-undo .
      388     define variable v-time as integer   no-undo .
      389     run cur-time in this-procedure
      390       (output v-date
      391       ,output v-time
      392       ) .
      393     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      394   end.
      395   function cur-time-string-sec returns character
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      404   end.
      405   function cur-time-custom  returns character
      406   (input p-prefix as character
      407   ,input p-date-format as character
      408   ,input p-delimiter as character
      409   ,input p-time-format as character
      410   ,input p-suffix as character
      411   )
      412   :
      413     define variable v-date as date      no-undo .
      414     define variable v-time as integer   no-undo .
      415     run cur-time in this-procedure
      416       (output v-date
      417       ,output v-time
      418       ) .
      419     return
      420       p-prefix
      421       + string(v-date, p-date-format)
      422       + p-delimiter
      423       + string(v-time, p-time-format)
      424       + p-suffix
      425       .
      426   end.
      427   function cur-time-print  returns character
      428   :
      429     define variable v-date as date      no-undo .
      430     define variable v-time as integer   no-undo .
      431     run cur-time in this-procedure
      432       (output v-date
      433       ,output v-time
      434       ) .
      435     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      436   end.
      437   function cur-time-datetime returns datetime
      438   :
      439     define variable v-char as character no-undo .
      440     define variable v-datetime as datetime no-undo .
      441     v-char = cur-time-string().
      442     v-datetime = datetime(v-char).
      443     return  v-datetime.
      444   end.
      445   function cur-time-string-msec returns character
      446   :
      447     define variable v-date as datetime  no-undo .
      448     v-date = now.
      449     return string(v-date) .
      450   end.
      451   define temp-table tt-session no-undo
      452     field session-id        as character
      453     field last-update-date  as date
      454     field last-update-time  as integer
      455   index pi is primary unique
      456     session-id
      457   .
      458   define buffer buf_tt-session for tt-session.
      459   define variable v-xml-filder  as class XmlFilder  no-undo .
      460   define variable v-data-valid        as logical   no-undo .
      461   define variable v-err-message       as character no-undo .
      462   define variable v-device-id         as character no-undo .
      463   define variable v-mt-route_session-timeout  as integer   no-undo .
      464   define variable v-mt-route_user-num         as integer   no-undo .
      465   define variable v-mt-route_pos-code         as integer   no-undo .
      466   define variable v-mt-route_parenthandle     as handle    no-undo .
      467   procedure mt-route_init :
      468     define input  parameter parparentproc     as handle    no-undo .
      469     define input  parameter p-pos-code        as integer   no-undo .
      470     define input  parameter p-user-num        as integer   no-undo .
      471     define input  parameter p-session-timeout as integer   no-undo .
      472   do
      473   on error undo, return error return-value
      474   :
      475     assign
      476       v-mt-route_pos-code         = p-pos-code
      477       v-mt-route_user-num         = p-user-num
      478       v-mt-route_session-timeout  = p-session-timeout
      479       v-mt-route_parenthandle     = parparentproc
      480     .
      481   end.
      482   end procedure.
      483   procedure mt-route_init-session :
      484     define input  parameter p-session-id  as character no-undo .
      485     define output parameter p-registred   as logical   no-undo .
      486     define output parameter p-message     as character no-undo .
      487   do
      488   on error undo, return error return-value
      489   :
      490     define variable v-session-num     as integer   no-undo .
      491     define variable v-session-valid   as logical   no-undo .
      492     define variable v-message         as character no-undo .
      493     run mt-route_check-session in this-procedure ( input p-session-id
      494                                                  , input no
      495                                                  , output v-session-valid
      496                                                  , output v-message
      497                                                  ) .
      498     if v-session-valid = yes
      499     then do:
      500       assign
      501         p-registred = yes
      502       .
      503       return .
      504     end.
      505     for each buf_tt-session:
      506       assign
      507         v-session-num = v-session-num + 1
      508       .
      509     end.
      510     if v-session-num < v-mt-route_user-num
      511     then do:
      512       find first buf_tt-session
      513         where buf_tt-session.session-id = p-session-id
      514       no-error .
      515       if not available buf_tt-session
      516       then do:
      517         define variable v-date as date      no-undo .
      518         define variable v-time as integer   no-undo .
      519         run cur-time in this-procedure ( output v-date
      520                                        , output v-time
      521                                        ) .
      522         create buf_tt-session.
      523         assign
      524           buf_tt-session.session-id       = p-session-id
      525           buf_tt-session.last-update-date = v-date
      526           buf_tt-session.last-update-time = v-time
      527           v-session-num                   = v-session-num + 1
      528           p-registred                     = yes
      529         .
      530         run mt-serv_write-user-num  in v-mt-route_parenthandle ( input v-session-num ) .
      531       end.
      532     end.
      533     else do:
      534       assign
      535         p-message = substitute( "Превышено максимальное число пользователей. Сейчас в системе: &1 ."
      536                               , v-session-num
      537                               )
      538       .
      539     end.
      540   end.
      541   end procedure.
      542   procedure mt-route_delete-session :
      543     define input  parameter p-session-id as character no-undo .
      544   do
      545   on error undo, return error return-value
      546   :
      547     define variable v-session-num as integer   no-undo .
      548     find first buf_tt-session
      549       where buf_tt-session.session-id = p-session-id
      550     no-error .
      551     if available buf_tt-session
      552     then do:
      553       delete buf_tt-session .
      554       for each buf_tt-session:
      555         assign
      556           v-session-num = v-session-num + 1
      557         .
      558       end.
      559       run mt-serv_write-user-num in v-mt-route_parenthandle ( input v-session-num ) .
      560     end.
      561   end.
      562   end procedure.
      563   procedure mt-route_check-session :
      564     define input  parameter p-session-id      as character no-undo .
      565     define input  parameter p-update-session  as logical   no-undo .
      566     define output parameter p-session-valid   as logical   no-undo .
      567     define output parameter p-message         as character no-undo .
      568   do
      569   on error undo, return error return-value
      570   :
      571     define variable v-date    as date      no-undo .
      572     define variable v-time    as integer   no-undo .
      573     define variable v-timeout as integer   no-undo .
      574     find first buf_tt-session
      575       where buf_tt-session.session-id = p-session-id
      576     no-error .
      577     if not available buf_tt-session
      578     then do:
      579       assign
      580         p-session-valid = false
      581         p-message      = substitute(" Не найдена сессия &1" , p-session-id)
      582       .
      583       return .
      584     end.
      585     run cur-time in this-procedure ( output v-date
      586                                    , output v-time
      587                                    ) .
      588     if buf_tt-session.last-update-date > v-date
      589     then do:
      590       assign
      591         p-session-valid = false
      592         p-message      = substitute("Календарная дата открытия сесии &1 отличается." , p-session-id)
      593       .
      594       return .
      595     end.
      596     assign
      597       v-timeout = v-time - buf_tt-session.last-update-time
      598     .
      599     if v-timeout > v-mt-route_session-timeout
      600     then do:
      601       assign
      602         p-session-valid = false
      603         p-message      = substitute( "Превышен таймаут сессии &1.&2Таймаут: &3"
      604                                     , p-session-id
      605                                     , chr(10)
      606                                     , string(v-timeout, "hh:mm:ss")
      607                                     )
      608       .
      609       run mt-route_delete-session in this-procedure (input p-session-id) .
      610       return .
      611     end.
      612     if p-update-session = yes
      613     then do:
      614       assign
      615         buf_tt-session.last-update-date = v-date
      616         buf_tt-session.last-update-time = v-time
      617       .
      618     end.
      619     assign
      620       p-session-valid = true
      621     .
      622   end.
      623   end procedure.
      624   procedure mt-route_update-session :
      625     define input  parameter p-session-id    as character no-undo .
      626   do
      627   on error undo, return error return-value
      628   :
      629     find first buf_tt-session
      630       where buf_tt-session.session-id = p-session-id
      631     no-error .
      632     if available buf_tt-session
      633     then do:
      634       define variable v-date as date      no-undo .
      635       define variable v-time as integer   no-undo .
      636       run cur-time in this-procedure ( output v-date
      637                                       , output v-time
      638                                       ) .
      639       assign
      640         buf_tt-session.last-update-date = v-date
      641         buf_tt-session.last-update-time = v-time
      642       .
      643     end.
      644   end.
      645   end procedure.
      646   procedure mt-route_process-request :
      647     define input  parameter parparentproc   as handle    no-undo .
      648     define input  parameter p-req-num       as integer   no-undo .
      649     define input  parameter p-message-str   as character no-undo .
      650     define output parameter p-send-message  as character no-undo .
      651   do
      652   on error undo, return error return-value
      653   :
      654     v-xml-filder = new XmlFilder() .
      655     run mt-route_init-route in this-procedure ( input   parparentproc
      656                                               , input   p-req-num
      657                                               , input   p-message-str
      658                                               , output  p-send-message
      659                                               ).
      660     delete object v-xml-filder.
      661     assign
      662       v-xml-filder = ?
      663       p-send-message = codepage-convert( p-send-message , "UTF-8" )
      664     .
      665   end.
      666   end procedure.
