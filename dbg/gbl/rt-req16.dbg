        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define input  parameter p-directory-out     as character no-undo .
        4   define input  parameter p-file-name         as character no-undo .
        5   define input  parameter p-session-valid     as logical   no-undo .
        6   define input  parameter p-error-message     as character no-undo .
        7   define input  parameter p-user-login        as character no-undo .
        8   define input  parameter p-obj-type          as character no-undo .
        9   define input  parameter p-obj-code          as character no-undo .
       10   define input  parameter p-host-code         as character no-undo .
       11   define input  parameter p-doc-type          as character no-undo .
       12   define input  parameter p-doc-code          as character no-undo .
       13   define input  parameter p-bar-code          as character no-undo .
       14   define input  parameter p-prod-artic        as character no-undo .
       15   define input  parameter p-prod-artic-search as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       18   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: rt-req16.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req16.p $":U .
       21   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 16. Приемка товара. Получить информацию о строке накладной по штрих-коду".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure integerm :
       84     define input  parameter p-string      as character no-undo .
       85     define input  parameter p-allow-sign  as logical   no-undo .
       86     define input  parameter p-allow-comma as logical   no-undo .
       87     define output parameter p-value       as integer   no-undo .
       88     define output parameter p-data-valid  as logical   no-undo .
       89     define output parameter p-message     as character no-undo .
       90     define variable v-replace-string as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       if p-string = ?
       95       then do:
       96         assign
       97           p-value      = ?
       98           p-data-valid = false
       99           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      100         .
      101         return .
      102       end.
      103       if p-string = ""
      104       then do:
      105         assign
      106           p-value      = ?
      107           p-data-valid = false
      108           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      109         .
      110         return .
      111       end.
      112       assign
      113         p-value = integer(p-string) no-error
      114       .
      115       if error-status :error = true
      116       then do:
      117         assign
      118           p-value      = ?
      119           p-data-valid = false
      120           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      121                                    ,p-string
      122                                    )
      123         .
      124         return .
      125       end.
      126       if index(p-string, ' ':u) > 0
      127       then do:
      128         assign
      129           p-value      = ?
      130           p-data-valid = false
      131           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      132                                    + "Строка содержит символы пробела"
      133                                    ,p-string
      134                                    )
      135         .
      136         return .
      137       end.
      138       assign
      139         v-replace-string = p-string
      140         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      149       .
      150       if p-allow-sign = true
      151       then do:
      152         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      153         then do:
      154           assign
      155             v-replace-string = substring(v-replace-string, 2)
      156           .
      157         end.
      158       end.
      159       else do:
      160         if substring(v-replace-string, 1, 1) = '+':u
      161         then do:
      162           assign
      163             p-value      = ?
      164             p-data-valid = false
      165             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      166                                     + "Задан параметр недопустимости знака челого числа. "
      167                                     + "Строка содержит символ плюс. "
      168                                     ,p-string
      169                                     )
      170           .
      171           return .
      172         end.
      173         if substring(v-replace-string, 1, 1) = '-':u
      174         then do:
      175           assign
      176             p-value      = ?
      177             p-data-valid = false
      178             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      179                                     + "Задан параметр недопустимости знака челого числа. "
      180                                     + "Строка содержит символ минус. "
      181                                     ,p-string
      182                                     )
      183           .
      184           return .
      185         end.
      186       end.
      187       if p-allow-comma = true
      188       then do:
      189         assign
      190           v-replace-string = replace(v-replace-string, ',', '')
      191         .
      192       end.
      193       else do:
      194         if index(v-replace-string, ',') > 0
      195         then do:
      196           assign
      197             p-value      = ?
      198             p-data-valid = false
      199             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      200                                     + "Задан параметр недопустимости знака разделителя тысяч."
      201                                     + "Строка содержит знак разделителя тысяч. "
      202                                     ,p-string
      203                                     )
      204           .
      205           return .
      206         end.
      207       end.
      208       if index(p-string, '.') > 0
      209       then do:
      210         assign
      211           p-value      = ?
      212           p-data-valid = false
      213           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      214                                    + "Строка содержит знак десятичной точки"
      215                                    ,p-string
      216                                    )
      217         .
      218         return .
      219       end.
      220       if v-replace-string <> fill('9', length(v-replace-string))
      221       then do:
      222         assign
      223           p-value      = ?
      224           p-data-valid = false
      225           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      226                                    + "Встречены символы, недопустимые для целого числа '&2'"
      227                                    ,p-string
      228                                    ,replace(v-replace-string, '9', '')
      229                                    )
      230         .
      231         return .
      232       end.
      233       assign
      234         p-data-valid = true
      235         p-message    = ""
      236       .
      237     end.
      238   end procedure.
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   function rtencode returns character
      241     ( p-init-string as character
      242     ) :
      243     define variable v-encode-string as character no-undo .
      244     if p-init-string = ?
      245     then do:
      246       assign
      247         v-encode-string = '?':u
      248       .
      249       return v-encode-string .
      250     end.
      251     if p-init-string = '?':u
      252     then do:
      253       assign
      254         v-encode-string = '~~077':u
      255       .
      256       return v-encode-string .
      257     end.
      258     assign
      259       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      260       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      261       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      262     .
      263     return v-encode-string .
      264   end function .
      265   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   procedure rt-cnvdc_decode :
      267     define input  parameter p-encoded-str as character no-undo .
      268     define output parameter p-decoded-str as character no-undo .
      269   do
      270   on error undo, return error return-value
      271   :
      272     define variable v-decoded-str as character no-undo .
      273     assign
      274       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      275       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      276       p-decoded-str = v-decoded-str
      277     .
      278   end.
      279   end procedure.
      280   define stream sout .
      281   define variable v-status        as character no-undo .
      282   define variable v-error-message as character no-undo .
      283   define variable v-b-code        as integer   no-undo .
      284   define variable v-artic         as character no-undo .
      285   define variable v-name          as character no-undo .
      286   define variable v-prod-name     as character no-undo .
      287   define variable v-unit-cli      as character no-undo .
      288   define variable v-cli-base-rate as character no-undo .
      289   define variable v-price-cli     as character no-undo .
      290   define variable v-vat-pc        as character no-undo .
      291   define variable v-curr-abbr     as character no-undo .
      292   define variable v-unit-base     as character no-undo .
      293   define variable v-doc-qnty      as character no-undo .
      294   define variable v-price-docf    as character no-undo .
      295   define variable v-deadline-date as character no-undo .
      296   do
      297   on error undo, return error return-value
      298   :
      299     if p-session-valid = true
      300     then do:
      301       run check-data in this-procedure
      302         (output v-status
      303         ,output v-error-message
      304         ,output v-b-code
      305         ,output v-artic
      306         ,output v-name
      307         ,output v-prod-name
      308         ,output v-unit-cli
      309         ,output v-cli-base-rate
      310         ,output v-price-cli
      311         ,output v-vat-pc
      312         ,output v-curr-abbr
      313         ,output v-unit-base
      314         ,output v-doc-qnty
      315         ,output v-price-docf
      316         ,output v-deadline-date
      317         ) no-error .
      318       if error-status :error
      319       then do:
      320         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      321                                     ,error-status :get-message(1)
      322                                     ,return-value
      323                                     ) .
      324       end.
      325     end.
      326     else do:
      327       assign
      328         v-status        = '1':u
      329         v-error-message = p-error-message
      330         v-artic         = '':u
      331         v-name          = '':u
      332         v-prod-name     = '':u
      333         v-unit-cli      = '':u
      334         v-cli-base-rate = '':u
      335         v-price-cli     = '':u
      336         v-vat-pc        = '':u
      337         v-curr-abbr     = '':u
      338         v-unit-base     = '':u
      339         v-doc-qnty      = '':u
      340         v-price-docf    = '':u
      341         v-deadline-date = '':u
      342       .
      343     end.
      344     define variable v-temp-file-name as character no-undo .
      345     assign
      346       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      347     .
      348     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      349     put stream sout unformatted substitute('status:&1',       rtencode(v-status))
      350                                 + chr(10) .
      351     put stream sout unformatted substitute('message:&1',      rtencode(v-error-message))
      352                                 + chr(10) .
      353     put stream sout unformatted substitute('artic:&1',        rtencode(v-artic))
      354                                 + chr(10) .
      355     put stream sout unformatted substitute('name:&1',         rtencode(v-name))
      356                                 + chr(10) .
      357     put stream sout unformatted substitute('prod_name:&1',    rtencode(v-prod-name))
      358                                 + chr(10) .
      359     put stream sout unformatted substitute('unit_cli:&1',     rtencode(v-unit-cli))
      360                                 + chr(10) .
      361     put stream sout unformatted substitute('cli_base_rate:&1',rtencode(v-cli-base-rate))
      362                                 + chr(10) .
      363     put stream sout unformatted substitute('price_cli:&1',    rtencode(v-price-cli))
      364                                 + chr(10) .
      365     put stream sout unformatted substitute('curr_abbr:&1',    rtencode(v-curr-abbr))
      366                                 + chr(10) .
      367     put stream sout unformatted substitute('unit_base:&1',    rtencode(v-unit-base))
      368                                 + chr(10) .
      369     put stream sout unformatted substitute('doc_qnty:&1',     rtencode(v-doc-qnty))
      370                                 + chr(10) .
      371     put stream sout unformatted substitute('price_docf:&1',    rtencode(v-price-docf))
      372                                 + chr(10) .
      373     put stream sout unformatted substitute('deadline_date:&1',    rtencode(v-deadline-date))
      374                                 + chr(10) .
      375     output stream sout close .
      376     os-delete value(p-directory-out + '/':u + p-file-name) .
      377     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      378               value(p-directory-out + '/':u + p-file-name)
      379               .
      380   end.
      381   procedure check-data :
      382     define output parameter p-status        as character no-undo .
      383     define output parameter p-error-message as character no-undo .
      384     define output parameter p-b-code        as integer   no-undo .
      385     define output parameter p-artic         as character no-undo .
      386     define output parameter p-name          as character no-undo .
      387     define output parameter p-prod-name     as character no-undo .
      388     define output parameter p-unit-cli      as character no-undo .
      389     define output parameter p-cli-base-rate as character no-undo .
      390     define output parameter p-price-cli     as character no-undo .
      391     define output parameter p-vat-pc        as character no-undo .
      392     define output parameter p-curr-abbr     as character no-undo .
      393     define output parameter p-unit-base     as character no-undo .
      394     define output parameter p-doc-qnty      as character no-undo .
      395     define output parameter p-price-docf    as character no-undo .
      396     define output parameter p-deadline-date as character no-undo .
      397     define buffer buf_clients    for ub.clients .
      398     define buffer buf_sysconf    for ub.sysconf .
      399     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      400     define buffer buf_user-login for ub.user-login .
      401     define buffer buf_ext-artic  for ub.ext-artic.
      402     define buffer buf_goods      for ub.goods.
      403     define variable v-bar-code          like ub.bar-code.b-code  no-undo .
      404     do
      405     on error undo, return error return-value
      406     :
      407       find first buf_sys-ctrl no-lock .
      408       find first buf_user-login no-lock
      409         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      410           and buf_user-login.status_    = 0
      411           and buf_user-login.user-login = p-user-login
      412         no-error .
      413       if not available buf_user-login
      414       then do:
      415         assign
      416           p-status        = '3'
      417           p-error-message = substitute("Неизвестный пользователь &1"
      418                                       ,p-user-login
      419                                       )
      420         .
      421         return .
      422       end.
      423       define variable v-obj-code      as integer   no-undo .
      424       define variable v-data-valid    as logical   no-undo .
      425       define variable v-error-message as character no-undo .
      426       if p-obj-code = ""
      427       then do:
      428         assign
      429           p-status        = '3'
      430           p-error-message = "Не задан код объекта"
      431         .
      432         return .
      433       end.
      434       run integerm in this-procedure
      435         (input  p-obj-code
      436         ,input  false
      437         ,input  false
      438         ,output v-obj-code
      439         ,output v-data-valid
      440         ,output v-error-message
      441         ) .
      442       if v-data-valid <> true
      443       then do:
      444         assign
      445           p-status        = '3'
      446           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      447                                       ,p-obj-code
      448                                       ,v-error-message
      449                                       )
      450         .
      451         return .
      452       end.
      453       find first buf_clients no-lock
      454         where buf_clients.obj-type = p-obj-type
      455           and buf_clients.obj-code = v-obj-code
      456         no-error .
      457       if not available buf_clients
      458       then do:
      459         assign
      460           p-status        = '3'
      461           p-error-message = substitute("Не найден объект &1 &2"
      462                                       ,p-obj-type
      463                                       ,v-obj-code
      464                                       )
      465         .
      466         return .
      467       end.
      468       if  p-obj-type <> 'маг':U
      469       and p-obj-type <> 'скл':U
      470       then do:
      471         assign
      472           p-status        = '3'
      473           p-error-message = substitute("Неправильный тип объекта &1 &2"
      474                                       ,p-obj-type
      475                                       ,v-obj-code
      476                                       )
      477         .
      478         return .
      479       end.
      480       define variable v-host-code as integer   no-undo .
      481       run integerm in this-procedure
      482         (input  p-host-code
      483         ,input  false
      484         ,input  false
      485         ,output v-host-code
      486         ,output v-data-valid
      487         ,output v-error-message
      488         ) .
      489       if v-data-valid <> true
      490       then do:
      491         assign
      492           p-status        = '3'
      493           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      494                                       ,p-host-code
      495                                       ,v-error-message
      496                                       )
      497         .
      498         return .
      499       end.
      500       define variable v-obj-host-code as integer   no-undo .
      501   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      503     (input  buf_clients.obj-type
      504     ,input  buf_clients.obj-code
      505     ,output v-obj-host-code
      506     )  .
      507       if v-host-code <> v-obj-host-code
      508       then do:
      509         assign
      510           p-status        = '3':u
      511           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      512                                       ,p-host-code
      513                                       ,v-obj-host-code
      514                                       ,buf_clients.obj-type
      515                                       ,buf_clients.obj-code
      516                                       )
      517         .
      518         return .
      519       end.
      520       define variable v-object-available as logical   no-undo .
      521   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      523     (input  buf_sys-ctrl.db-num
      524     ,input  0
