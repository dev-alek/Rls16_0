        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-obj-type       as character no-undo .
        5   define input  parameter p-obj-code       as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: rt-req18.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req18.p $":U .
       11   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 18. Инвентаризация. Настройка".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure integerm :
       72     define input  parameter p-string      as character no-undo .
       73     define input  parameter p-allow-sign  as logical   no-undo .
       74     define input  parameter p-allow-comma as logical   no-undo .
       75     define output parameter p-value       as integer   no-undo .
       76     define output parameter p-data-valid  as logical   no-undo .
       77     define output parameter p-message     as character no-undo .
       78     define variable v-replace-string as character no-undo .
       79     do
       80     on error undo, return error return-value
       81     :
       82       if p-string = ?
       83       then do:
       84         assign
       85           p-value      = ?
       86           p-data-valid = false
       87           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       88         .
       89         return .
       90       end.
       91       if p-string = ""
       92       then do:
       93         assign
       94           p-value      = ?
       95           p-data-valid = false
       96           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
       97         .
       98         return .
       99       end.
      100       assign
      101         p-value = integer(p-string) no-error
      102       .
      103       if error-status :error = true
      104       then do:
      105         assign
      106           p-value      = ?
      107           p-data-valid = false
      108           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      109                                    ,p-string
      110                                    )
      111         .
      112         return .
      113       end.
      114       if index(p-string, ' ':u) > 0
      115       then do:
      116         assign
      117           p-value      = ?
      118           p-data-valid = false
      119           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      120                                    + "Строка содержит символы пробела"
      121                                    ,p-string
      122                                    )
      123         .
      124         return .
      125       end.
      126       assign
      127         v-replace-string = p-string
      128         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      129         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      130         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      131         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      132         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      137       .
      138       if p-allow-sign = true
      139       then do:
      140         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      141         then do:
      142           assign
      143             v-replace-string = substring(v-replace-string, 2)
      144           .
      145         end.
      146       end.
      147       else do:
      148         if substring(v-replace-string, 1, 1) = '+':u
      149         then do:
      150           assign
      151             p-value      = ?
      152             p-data-valid = false
      153             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      154                                     + "Задан параметр недопустимости знака челого числа. "
      155                                     + "Строка содержит символ плюс. "
      156                                     ,p-string
      157                                     )
      158           .
      159           return .
      160         end.
      161         if substring(v-replace-string, 1, 1) = '-':u
      162         then do:
      163           assign
      164             p-value      = ?
      165             p-data-valid = false
      166             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      167                                     + "Задан параметр недопустимости знака челого числа. "
      168                                     + "Строка содержит символ минус. "
      169                                     ,p-string
      170                                     )
      171           .
      172           return .
      173         end.
      174       end.
      175       if p-allow-comma = true
      176       then do:
      177         assign
      178           v-replace-string = replace(v-replace-string, ',', '')
      179         .
      180       end.
      181       else do:
      182         if index(v-replace-string, ',') > 0
      183         then do:
      184           assign
      185             p-value      = ?
      186             p-data-valid = false
      187             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      188                                     + "Задан параметр недопустимости знака разделителя тысяч."
      189                                     + "Строка содержит знак разделителя тысяч. "
      190                                     ,p-string
      191                                     )
      192           .
      193           return .
      194         end.
      195       end.
      196       if index(p-string, '.') > 0
      197       then do:
      198         assign
      199           p-value      = ?
      200           p-data-valid = false
      201           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      202                                    + "Строка содержит знак десятичной точки"
      203                                    ,p-string
      204                                    )
      205         .
      206         return .
      207       end.
      208       if v-replace-string <> fill('9', length(v-replace-string))
      209       then do:
      210         assign
      211           p-value      = ?
      212           p-data-valid = false
      213           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      214                                    + "Встречены символы, недопустимые для целого числа '&2'"
      215                                    ,p-string
      216                                    ,replace(v-replace-string, '9', '')
      217                                    )
      218         .
      219         return .
      220       end.
      221       assign
      222         p-data-valid = true
      223         p-message    = ""
      224       .
      225     end.
      226   end procedure.
      227   define new global shared variable g#library  as handle no-undo .
      228   define new global shared variable g#library2 as handle no-undo .
      229   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   function rtencode returns character
      231     ( p-init-string as character
      232     ) :
      233     define variable v-encode-string as character no-undo .
      234     if p-init-string = ?
      235     then do:
      236       assign
      237         v-encode-string = '?':u
      238       .
      239       return v-encode-string .
      240     end.
      241     if p-init-string = '?':u
      242     then do:
      243       assign
      244         v-encode-string = '~~077':u
      245       .
      246       return v-encode-string .
      247     end.
      248     assign
      249       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      250       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      251       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      252     .
      253     return v-encode-string .
      254   end function .
      255   define stream sout .
      256   define variable v-data-valid    as logical   no-undo .
      257   define variable v-error-message as character no-undo .
      258   do
      259   on error undo, return error return-value
      260   :
      261     run check-data in this-procedure
      262       (output  v-data-valid
      263       ,output  v-error-message
      264       ) no-error .
      265     if error-status :error
      266     then do:
      267       undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      268                                   ,error-status :get-message(1)
      269                                   ,return-value
      270                                   ) .
      271     end.
      272     define variable v-temp-file-name as character no-undo .
      273     assign
      274       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      275     .
      276     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      277     if v-data-valid = true
      278     then do:
      279       put stream sout unformatted 'status:0' + chr(10) .
      280       put stream sout unformatted 'message:' + chr(10) .
      281     end.
      282     else do:
      283       put stream sout unformatted 'status:1' + chr(10) .
      284       put stream sout unformatted substitute('message:&1', rtencode(v-error-message)) + chr(10) .
      285     end.
      286     output stream sout close .
      287     os-delete value(p-directory-out + '/':u + p-file-name) .
      288     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      289               value(p-directory-out + '/':u + p-file-name)
      290               .
      291   end.
      292   procedure check-data :
      293     define output parameter p-data-valid    as logical   no-undo .
      294     define output parameter p-error-message as character no-undo .
      295     define buffer buf_clients  for ub.clients .
      296     define buffer buf_sysconf  for ub.sysconf .
      297     do
      298     on error undo, return error return-value
      299     :
      300       define variable v-obj-code      as integer   no-undo .
      301       define variable v-data-valid    as logical   no-undo .
      302       define variable v-error-message as character no-undo .
      303       if p-obj-code = ""
      304       then do:
      305         assign
      306           p-data-valid    = false
      307           p-error-message = "Не задан код объекта"
      308         .
      309         return .
      310       end.
      311       run integerm in this-procedure
      312         (input  p-obj-code
      313         ,input  false
      314         ,input  false
      315         ,output v-obj-code
      316         ,output v-data-valid
      317         ,output v-error-message
      318         ) .
      319       if v-data-valid <> true
      320       then do:
      321         assign
      322           p-data-valid    = false
      323           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      324                                       ,p-obj-code
      325                                       ,v-error-message
      326                                       )
      327         .
      328         return .
      329       end.
      330       find first buf_clients no-lock
      331         where buf_clients.obj-type = p-obj-type
      332           and buf_clients.obj-code = v-obj-code
      333         no-error .
      334       if not available buf_clients
      335       then do:
      336         assign
      337           p-data-valid    = false
      338           p-error-message = substitute("Не найден объект &1 &2"
      339                                       ,p-obj-type
      340                                       ,v-obj-code
      341                                       )
      342         .
      343         return .
      344       end.
      345       if  p-obj-type <> 'маг':U
      346       and p-obj-type <> 'скл':U
      347       then do:
      348         assign
      349           p-data-valid    = false
      350           p-error-message = substitute("Неправильный тип объекта &1 &2"
      351                                       ,p-obj-type
      352                                       ,v-obj-code
      353                                       )
      354         .
      355         return .
      356       end.
      357       assign
      358         p-data-valid    = true
      359         p-error-message = ""
      360       .
      361     end.
      362   end procedure.
