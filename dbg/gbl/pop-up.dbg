        1   block-level on error undo, throw.
        2   define input parameter wh as widget-handle.
        3   define input parameter l-r as logical.
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: pop-up.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: gbl/pop-up.p $":U .
        9   def var vss-description as character no-undo init "Форсировать вывод на экран поп-ап меню привязанного к виджету".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       70      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       71   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       73     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       74   FUNCTION GetLastError
       75            RETURNS INTEGER
       76            ()
       77            IN hpWinFunc.
       78   FUNCTION GetParent
       79            RETURNS INTEGER
       80            (input hwnd as INTEGER)
       81            IN hpWinFunc.
       82   FUNCTION ShowLastError
       83            RETURNS INTEGER
       84            ()
       85            IN hpWinFunc.
       86   FUNCTION CreateProcess
       87            RETURNS INTEGER
       88            (input CommandLine as CHAR,
       89             input CurrentDir  as CHAR,
       90             input wShowWindow as INTEGER)
       91            in hpWinFunc.
       92        run CenterMouseCursor(wh).
       93        run Apply-mouse-menu-click(wh).
       94   return.
       95   PROCEDURE CenterMouseCursor:
       96      DEFINE INPUT PARAMETER  p-wh   AS WIDGET-HANDLE  NO-UNDO.
       97      DEF VAR lppoint     AS MEMPTR  NO-UNDO.
       98      DEF VAR ReturnValue AS INTEGER NO-UNDO.
       99      SET-SIZE(lppoint)= 2 * 4.
      100      PUT-long(lppoint,1 + 0 * 4)=INTEGER(p-wh:WIDTH-PIXELS / 2).
      101      PUT-long(lppoint,1 + 1 * 4)=INTEGER(p-wh:HEIGHT-PIXELS / 2).
      102      RUN ClientToScreen in hpApi (INPUT p-wh:HWND,
      103                                   INPUT GET-POINTER-VALUE(lppoint),
      104                                   OUTPUT ReturnValue).
      105      RUN SetCursorPos in hpApi   (INPUT GET-long(lppoint,1 + 0 * 4),
      106                                   INPUT GET-long(lppoint,1 + 1 * 4),
      107                                   OUTPUT ReturnValue).
      108      SET-SIZE(lppoint)= 0.
      109      END PROCEDURE.
      110   PROCEDURE Apply-mouse-menu-click:
      111      DEFINE INPUT PARAMETER  p-wh   AS WIDGET-HANDLE  NO-UNDO.
      112      DEF VAR ReturnValue AS INTEGER NO-UNDO.
      113      RUN SendMessageA in hpApi (INPUT p-wh:HWND,
      114                                    INPUT (if l-r then 516 else 513),
      115                                    INPUT (if l-r then 2 else 1),
      116                                    INPUT 0,
      117                                    OUTPUT ReturnValue).
      118      RUN SendMessageA in hpApi (INPUT p-wh:HWND,
      119                                    INPUT (if l-r then 517 else 514),
      120                                    INPUT 0,
      121                                    INPUT 0,
      122                                    OUTPUT ReturnValue).
      123   END PROCEDURE.
