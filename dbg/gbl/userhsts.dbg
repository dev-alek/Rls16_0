     1369         VIEW-AS TEXT
     1370        SIZE 6 BY 1
     1371        FGCOLOR 4  NO-UNDO.
     1372   DEFINE QUERY br-host FOR
     1373         ub.user-host SCROLLING.
     1374   DEFINE QUERY br-obj FOR
     1375         ub.user-obj SCROLLING.
     1376   DEFINE BROWSE br-host
     1377     QUERY br-host NO-LOCK DISPLAY
     1378         mark-string(ub.user-host.host-code) @ v-brws-mark
     1379         ub.user-host.host-code format "999999999"
     1380         get-host-name(ub.user-host.host-code) @ v-host-name COLUMN-LABEL "Название" FORMAT "X(40)":U
     1381         get-default-object(ub.user-host.host-code) @ v-default-object COLUMN-LABEL "Главн.объект!межфирм.перем."
     1382       WITH NO-ROW-MARKERS SEPARATORS SIZE 53.5 BY 17 ROW-HEIGHT-CHARS .67.
     1383   DEFINE BROWSE br-obj
     1384     QUERY br-obj NO-LOCK DISPLAY
     1385         ub.user-obj.obj-type column-label "Тип"
     1386         ub.user-obj.obj-code column-label "Код"
     1387         get-object-name(ub.user-obj.obj-type, ub.user-obj.obj-code)   @ v-object-name
     1388         get-object-db-num(ub.user-obj.obj-type, ub.user-obj.obj-code) @ v-object-db-num
     1389       WITH NO-ROW-MARKERS SEPARATORS SIZE 42.5 BY 17 ROW-HEIGHT-CHARS .67.
     1390   DEFINE FRAME Dialog-Frame
     1391        b-quit AT ROW 1 COL 1
     1392        B-mark AT ROW 1 COL 11
     1393        B-sel AT ROW 1 COL 21
     1394        b-action AT ROW 1 COL 31 WIDGET-ID 8
     1395        b-menu AT ROW 1 COL 41 WIDGET-ID 10
     1396        B-Help AT ROW 1 COL 88
     1397        b-add AT ROW 2 COL 1 WIDGET-ID 2
     1398        B-lookup AT ROW 2 COL 11
     1399        B-company AT ROW 2 COL 21
     1400        b-del AT ROW 2 COL 31 WIDGET-ID 4
     1401        B-obj AT ROW 2 COL 55.5
     1402        br-host AT ROW 3.25 COL 1
     1403        br-obj AT ROW 3.25 COL 55.5
     1404        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1405        SPACE(77.99) SKIP(18.45)
     1406       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1407            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1408            TITLE "Список <Своих> фирм системы"
     1409            CANCEL-BUTTON b-quit.
     1410   ASSIGN
     1411          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1412          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1413   ASSIGN
     1414          br-host:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1415   ON GO OF FRAME Dialog-Frame
     1416   DO:
     1417     run choose-select in this-procedure .
     1418   END.
     1419   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1420   DO:
     1421     APPLY "END-ERROR":U TO SELF.
     1422   END.
     1423   ON CHOOSE OF b-action IN FRAME Dialog-Frame
     1424   DO:
     1425      if not available ub.user-host
     1426      then do:
     1427         return no-apply.
     1428      end.
     1429      run str/usractn1.w ( INPUT parparentproc
     1430                         , INPUT ub.user-host.user-id
     1431                         , INPUT ub.user-host.db-num
     1432                         , INPUT 'орг':U
     1433                         , INPUT ub.user-host.host-code
     1434                         ) NO-ERROR.
     1435      if error-status :error
     1436      then do:
     1437           message
     1438                 vss-workfile vss-revision vss-description
     1439              skip(1)
     1440              skip "Ошибка изменения прав пользователя на фирме"
     1441              skip return-value
     1442              skip trim( error-status :get-message( 1 ) )
     1443                 trim( error-status :get-message( 2 ) )
     1444                 trim( error-status :get-message( 3 ) )
     1445           view-as alert-box error.
     1446         return no-apply.
     1447      end.
     1448   END.
     1449   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1450   DO:
     1451     run create_user_host.
     1452     run enable_UI.
     1453     run MyEnable in this-procedure .
     1454   END.
     1455   ON CHOOSE OF B-company IN FRAME Dialog-Frame
     1456   DO:
     1457     define variable v-ok as logical   no-undo .
     1458     if available ub.user-host
     1459     then do:
     1460   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   do:
     1462     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1463       (input  v-cntxt-db-num
     1464       ,input  v-cntxt-userid
     1465       ,input  0
     1466       ,input  'actn_host-reference_lookup':U
     1467       ,input  'global':U
     1468       ,input  0
     1469       ,input  '':U
     1470       ,input  0
     1471       ,input  0
     1472       ,input  0
     1473       ,input  0
     1474       ,input  true
     1475       ,output v-ok
     1476       )  .
     1477   end.
     1478       if v-ok <> true
     1479       then do:
     1480         return no-apply.
     1481       end.
     1482       run adm/config.w
     1483         (input parParentProc
     1484         ,input ub.user-host.host-code
     1485         ,input  'ПРОСМОТР':U
     1486         ,input no
     1487         ) no-error.
     1488       if error-status :error
     1489       then do:
     1490         return no-apply.
     1491       end.
     1492     end.
     1493   END.
     1494   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1495   DO:
     1496      if not available ub.user-host
     1497      then do:
     1498         return no-apply.
     1499      end.
     1500      run delete_user_host.
     1501      run enable_UI.
     1502      run MyEnable in this-procedure .
     1503   END.
     1504   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1505   DO:
     1506   if available ub.user-host
     1507   then do:
     1508     run ref/showcli.p (
     1509       input parParentProc
     1510       ,input 'орг':U
     1511       ,input ub.user-host.host-code
     1512       ).
     1513   end.
     1514   END.
     1515   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1516   DO:
     1517      run choose-mark in this-procedure .
     1518   END.
     1519   ON CHOOSE OF b-menu IN FRAME Dialog-Frame
     1520   DO:
     1521      if not available ub.user-host
     1522      then do:
     1523         return no-apply.
     1524      end.
     1525      run str/usrmngr1.w ( INPUT parparentproc
     1526                         , INPUT ub.user-host.db-num
     1527                         , INPUT ub.user-host.user-id
     1528                         , INPUT 'орг':U
     1529                         , INPUT ub.user-host.host-code
     1530                         ) NO-ERROR.
     1531      if error-status :error
     1532      then do:
     1533           message
     1534                 vss-workfile vss-revision vss-description
     1535              skip(1)
     1536              skip "Ошибка изменения меню пользователя на фирме"
     1537              skip return-value
     1538              skip trim( error-status :get-message( 1 ) )
     1539                 trim( error-status :get-message( 2 ) )
     1540                 trim( error-status :get-message( 3 ) )
     1541           view-as alert-box error.
     1542         return no-apply.
     1543      end.
     1544   END.
     1545   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     1546   DO:
     1547     run br-obj-show-object in this-procedure .
     1548   END.
     1549   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1550   DO:
     1551     assign
     1552       p-select-host-code =  ?
     1553       p-List-select-host-code =  ""
     1554     .
     1555   END.
     1556   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1557   DO:
     1558   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1559   if lookup(self :type
     1560            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1561            ) = 0
     1562   then do:
     1563     message
     1564       "$Workfile$"
     1565       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1566       "Интерфейсный элемент" self :name  skip
     1567       "Тип" self :type  skip
     1568       "Процедура" this-procedure :file-name skip
     1569       view-as alert-box .
     1570   end.
     1571   else do:
     1572     apply "entry":u to self  .
     1573     if focus :handle <> self :handle  then do:
     1574       return no-apply .
     1575     end.
     1576   end.
     1577   END.
     1578   ON DEFAULT-ACTION OF br-host IN FRAME Dialog-Frame
     1579   DO:
     1580      if INDEX ( p-bttns, "b-sel") > 0
     1581      then do:
     1582         apply 'go':u to frame Dialog-Frame .
     1583      end.
     1584      else do:
     1585         run choose-mark in this-procedure .
     1586      end.
     1587   END.
     1588   ON VALUE-CHANGED OF br-host IN FRAME Dialog-Frame
     1589   DO:
     1590     run update-br-host-dependent in this-procedure .
     1591   END.
     1592   ON DEFAULT-ACTION OF br-obj IN FRAME Dialog-Frame
     1593   DO:
     1594     run br-obj-show-object in this-procedure .
     1595   END.
     1596   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1597   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1598   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1599     run mainmenu_getcntxt in parparentproc
     1600       (output v-cntxt-db-num
     1601       ,output v-cntxt-userid
     1602       ,output v-cntxt-level
     1603       ,output v-cntxt-host-code-obj
     1604       ,output v-cntxt-obj-type
     1605       ,output v-cntxt-obj-code
     1606       ,output v-cntxt-db-num-obj
     1607       ,output v-cntxt-is-admin
     1608       ) .
     1609   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1610   on help of frame Dialog-Frame
     1611   do:
     1612     run gbl/app_help.p
     1613       (input this-procedure :file-name
     1614       ,input ''
     1615       ,input ?
     1616       ) no-error.
     1617     if error-status :error then do:
     1618       message
     1619         "Ошибка при вызове помощи"
     1620         error-status :get-message(1)
     1621         view-as alert-box .
     1622     end.
     1623   end.
     1624   run minbtn-set in this-procedure .
     1625   on choose of b-help in frame Dialog-Frame
     1626   do:
     1627     apply "help":u to frame Dialog-Frame .
     1628   end.
     1629   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1630   procedure minbtn-set :
     1631       do
     1632           on error undo, return error return-value
     1633           :
     1634           define variable ii              as integer       no-undo .
     1635           define variable fh              as widget-handle no-undo .
     1636           define variable hh              as widget-handle no-undo .
     1637           define variable v-h             as handle        extent 4 no-undo .
     1638           define variable v-name-button   as character     no-undo .
     1639           define variable v-help-old-x    as decimal       no-undo .
     1640           define variable v-help-old-y    as decimal       no-undo .
     1641           define variable v-help-old-size as decimal       no-undo .
     1642           define variable v-frame-width   as decimal       no-undo .
     1643           define variable jj              as integer       no-undo .
     1644           do
     1645               on error undo, return error
     1646               :
     1647               assign
     1648                   v-frame-width = frame Dialog-Frame:width - 0.3
     1649                   fh            = frame Dialog-Frame:first-child
     1650                   hh            = fh:first-child
     1651                   ii            = 1
     1652                   .
     1653               do while valid-handle(hh):
     1654                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1655                   do:
     1656                       case lc(hh:name) :
     1657                           when "b-help" then
     1658                               do:
     1659                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1660                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1661                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1662                                   hh:TOOLTIP = "Помощь" .
     1663                                   v-help-old-x = hh:column .
     1664                                   v-help-old-y = hh:row    .
     1665                                   v-help-old-size = hh:width .
     1666                                   hh:width-chars = 2.5 .
     1667                               end.
     1668                           when "b-print" then
     1669                               do:
     1670                                   hh:load-image("cmp/b-print.bmp":u) .
     1671                                   hh:TOOLTIP = "Печать" .
     1672                                   v-h[ii] = hh:handle .
     1673                                   ii = ii + 1 .
     1674                                   hh:width-chars = 3 .
     1675                               end.
     1676                           when "b-history" or
     1677                           when "b-hist" then
     1678                               do:
     1679                                   hh:load-image("cmp/b-hist.bmp":u) .
     1680                                   hh:TOOLTIP = "История" .
     1681                                   v-h[ii] = hh:handle .
     1682                                   ii = ii + 1 .
     1683                                   hh:width-chars = 3 .
     1684                               end.
     1685                           when "b-sch" then
     1686                               do:
     1687                                   hh:load-image("cmp/b-sch.bmp":u) .
     1688                                   hh:TOOLTIP = "Установка Фильтра" .
     1689                                   v-h[ii] = hh:handle .
     1690                                   ii = ii + 1 .
     1691                                   hh:width-chars = 3 .
     1692                               end.
     1693                           when "b-hist-user" then
     1694                               do:
     1695                                   hh:load-image("cmp/b-hist.bmp":u) .
     1696                                   hh:TOOLTIP = "История пользователя" .
     1697                                   ii = ii + 1 .
     1698                               end.
     1699                       end case.
     1700                   end.
     1701                   hh = hh:next-sibling.
     1702               end.
     1703               b-help:column = v-frame-width - b-help:width-chars.
     1704               jj = 0.
     1705               repeat ii = 4 to 1 by -1 :
     1706                   if valid-handle (v-h[ii] ) then
     1707                   do:
     1708                       jj  = jj + 1 .
     1709                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1710                       v-h[ii]:row    = v-help-old-y .
     1711                   end.
     1712               end.
     1713           end.
     1714       end.
     1715   end procedure.
     1716   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717   on INS of frame Dialog-Frame anywhere do:
     1718     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1719     return no-apply.
     1720   end.
     1721   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1722   on F8 of frame Dialog-Frame anywhere do:
     1723     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     1724     return no-apply.
     1725   end.
     1726   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1727   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     1728     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     1729     return no-apply.
     1730   end.
     1731   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1732   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1733   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1734   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1735   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1736   define variable v-diasize-current-frame-height as decimal   no-undo .
     1737   define variable v-diasize-change-size          as logical   no-undo .
     1738   define variable v-diasize-resize-button        as handle    no-undo .
     1739   define variable v-diasize-wndmax               as logical   no-undo .
     1740   define variable v-diasize-wndstore             as logical   no-undo .
     1741   define variable v-diasize-proc-name            as character no-undo .
     1742   define variable v-diasize-browse-handle        as handle    no-undo .
     1743   define variable v-diasize-browse-number        as integer   no-undo .
     1744   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1745   define temp-table temp-diasize-handle no-undo
     1746     field handle-value  as handle
     1747     field save-position as decimal
     1748     index xpk is primary unique handle-value
     1749     .
     1750   define temp-table temp-browse-handle no-undo
     1751     field browse-type   as character
     1752     field browse-number as integer
     1753     field browse-handle as handle
     1754     field original-size as decimal
     1755     index xpk is primary unique browse-type browse-number
     1756     index xie browse-type browse-handle
     1757   .
     1758   procedure diasize_change-height :
     1759     define input  parameter p-change-value  as decimal   no-undo .
     1760     define input  parameter p-move-resize   as logical   no-undo .
     1761     define variable v-field-group-handle    as handle    no-undo .
     1762     define variable v-object-handle         as handle    no-undo .
     1763     define variable v-frame-height          as decimal   no-undo .
     1764     define variable v-frame-virtual-height  as decimal   no-undo .
     1765     define variable v-browse-height         as decimal   no-undo .
     1766     define variable v-window-height         as decimal   no-undo .
     1767     define variable v-window-virtual-height as decimal   no-undo .
     1768     define variable v-change-sign           as integer   no-undo .
     1769     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1770     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1771     if p-change-value > 0
     1772     then do:
     1773       if frame Dialog-Frame :height + p-change-value
     1774           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1775       then do:
     1776         assign
     1777           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1778                           - (frame Dialog-Frame :height-chars)
     1779         .
     1780         if p-change-value <= 0
     1781         then do:
     1782           run diasize_position-resize-button in this-procedure .
     1783           return .
     1784         end.
     1785       end.
     1786     end.
     1787     if p-change-value < 0
     1788     then do:
     1789       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1790       then do:
     1791         assign
     1792           p-change-value = v-diasize-orig-frame-height
     1793                          - (frame Dialog-Frame :height-chars)
     1794         .
     1795         if p-change-value >= 0
     1796         then do:
     1797           run diasize_position-resize-button in this-procedure .
     1798           return .
     1799         end.
     1800       end.
     1801     end.
     1802     if p-change-value >= 0
     1803     then do:
     1804       assign
     1805         v-change-sign = 1
     1806       .
     1807     end.
     1808     else do:
     1809       assign
     1810         v-change-sign = -1
     1811       .
     1812     end.
     1813     assign
     1814       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1815     .
     1816     if p-change-value = 0
     1817     then do:
     1818       run diasize_position-resize-button in this-procedure .
     1819       return .
     1820     end.
     1821     move_block:
     1822     do
     1823     on error undo move_block, retry move_block
     1824     :
     1825       if retry
     1826       then do:
     1827         do
     1828         on error undo move_block, leave move_block
     1829         :
     1830           if p-change-value > 0
     1831           then do:
