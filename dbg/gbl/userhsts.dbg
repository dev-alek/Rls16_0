      411   define buffer buf_clients for ub.clients.
      412   define buffer buf_sysconf for ub.sysconf.
      413   define buffer buf_shop for ub.shop.
      414   define buffer buf_store for ub.store.
      415   define buffer buf_db for ub.db.
