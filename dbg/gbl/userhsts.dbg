     2452           where buf_temp-browse-handle.browse-type = 'width':u
     2453         on error undo move_block, retry move_block
     2454         :
     2455           assign
     2456             buf_temp-browse-handle.browse-handle :width
     2457               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2458             no-error .
     2459           if error-status :error
     2460           or error-status :get-message(1) <> ""
     2461           then do:
     2462             undo move_block, retry move_block .
     2463           end.
     2464         end.
     2465         assign
     2466           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2467           no-error .
     2468         if error-status :error
     2469         or error-status :get-message(1) <> ""
     2470         then do:
     2471           undo move_block, retry move_block.
     2472         end.
     2473         assign
     2474           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2475         no-error .
     2476         if error-status :error
     2477         or error-status :get-message(1) <> ""
     2478         then do:
     2479           undo move_block, retry move_block.
     2480         end.
     2481         if frame Dialog-Frame :scrollable = true
     2482         then do:
     2483           assign
     2484             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2485           no-error .
     2486           if error-status :error
     2487           or error-status :get-message(1) <> ""
     2488           then do:
     2489             undo move_block, retry move_block.
     2490           end.
     2491         end.
     2492       end.
     2493       if p-move-resize
     2494       then do:
     2495         run diasize_position-resize-button in this-procedure .
     2496       end.
     2497       if v-diasize-wndstore = true
     2498       then do:
     2499         if connected("ub") = true
     2500         then do:
     2501           define variable v-cntxt-db-num        as integer   no-undo .
     2502           define variable v-cntxt-userid        as character no-undo .
     2503           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2504                                             , OUTPUT v-cntxt-userid
     2505                                             ) .
     2506           run gbl/wndsizew.p
     2507             (input  v-cntxt-db-num
     2508             ,input  v-cntxt-userid
     2509             ,input  v-diasize-proc-name
     2510             ,input  'width':u
     2511             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2512             ) .
     2513         end.
     2514       end.
     2515     end.
     2516     assign
     2517       v-diasize-change-size = false
     2518     .
     2519   end procedure.
     2520   procedure diasize_set-width :
     2521     define input  parameter p-new-width  as decimal   no-undo .
     2522     define input  parameter p-move-resize as logical   no-undo .
     2523     do
     2524     on error undo, return error return-value
     2525     :
     2526       run diasize_change-width in this-procedure
     2527         (input  (p-new-width - frame Dialog-Frame :width)
     2528         ,input  p-move-resize
     2529         ) .
     2530     end.
     2531   end procedure.
     2532   procedure diasize_position-resize-button :
     2533     do with frame Dialog-Frame
     2534     :
     2535       hide v-diasize-resize-button .
     2536       assign
     2537         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2538                     - 1
     2539                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2540         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2541                     - 1
     2542                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2543       .
     2544       view v-diasize-resize-button .
     2545     end.
     2546   end procedure.
     2547   on alt-right anywhere
     2548   do:
     2549     run diasize_change-width in this-procedure
     2550       (input 1
     2551       ,input true
     2552       ) .
     2553     return no-apply .
     2554   end.
     2555   on alt-left anywhere
     2556   do:
     2557     run diasize_change-width in this-procedure
     2558       (input -1
     2559       ,input true
     2560       ) .
     2561     return no-apply .
     2562   end.
     2563   on alt-down anywhere
     2564   do:
     2565     run diasize_change-height in this-procedure
     2566       (input 1
     2567       ,input true
     2568       ) .
     2569     return no-apply .
     2570   end.
     2571   on alt-up anywhere
     2572   do:
     2573     run diasize_change-height in this-procedure
     2574       (input -1
     2575       ,input true
     2576       ) .
     2577     return no-apply .
     2578   end.
     2579   on alt-enter of frame Dialog-Frame
     2580   do:
     2581     run diasize_maximize in this-procedure
     2582       (input  ?
     2583       ).
     2584     return no-apply .
     2585   end.
     2586   procedure diasize_end-move :
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       define variable v-row-delta as decimal   no-undo .
     2591       define variable v-col-delta as decimal   no-undo .
     2592       define variable v-new-row as decimal   no-undo .
     2593       define variable v-new-col as decimal   no-undo .
     2594       assign
     2595         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2596         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2597       .
     2598       assign
     2599         v-row-delta = v-new-row - frame Dialog-Frame :height
     2600         v-col-delta = v-new-col - frame Dialog-Frame :width
     2601       .
     2602       run diasize_change-height in this-procedure
     2603         (input v-row-delta
     2604         ,input true
     2605         ) .
     2606       run diasize_change-width in this-procedure
     2607         (input v-col-delta
     2608         ,input true
     2609         ) .
     2610     end.
     2611   end procedure.
     2612   procedure diasize_maximize :
     2613     define input  parameter p-action as logical   no-undo .
     2614     do
     2615     on error undo, return error return-value
     2616     :
     2617       if p-action = ?
     2618       then do:
     2619         if v-diasize-need-maximize = true
     2620         then do:
     2621           assign
     2622             p-action = true
     2623           .
     2624         end.
     2625         else do:
     2626           assign
     2627             p-action = false
     2628           .
     2629         end.
     2630       end.
     2631       if p-action = true
     2632       then do:
     2633         run diasize_change-height in this-procedure
     2634           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2635               - frame Dialog-Frame :height-chars
     2636           ,input true
     2637           ) .
     2638         run diasize_change-width in this-procedure
     2639           (input session :width-chars
     2640               - frame Dialog-Frame :width-chars
     2641           ,input true
     2642           ) .
     2643         assign
     2644           v-diasize-need-maximize = false
     2645         .
     2646       end.
     2647       else do:
     2648         run diasize_change-width in this-procedure
     2649           (input v-diasize-orig-frame-width
     2650               - frame Dialog-Frame :width-chars
     2651           ,input true
     2652           ) .
     2653         run diasize_change-height in this-procedure
     2654           (input v-diasize-orig-frame-height
     2655               - frame Dialog-Frame :height-chars
     2656           ,input true
     2657           ) .
     2658         assign
     2659           v-diasize-need-maximize = true
     2660         .
     2661       end.
     2662     end.
     2663   end procedure.
     2664   procedure diasize_restore-orig-size :
     2665     do
     2666     on error undo, return error return-value
     2667     :
     2668       assign
     2669         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2670         v-diasize-current-frame-height = frame Dialog-Frame :height
     2671       .
     2672       run diasize_set-height in this-procedure
     2673         (input  v-diasize-orig-frame-height
     2674         ,input  true
     2675         ) .
     2676       run diasize_set-width in this-procedure
     2677         (input  v-diasize-orig-frame-width
     2678         ,input  true
     2679         ) .
     2680     end.
     2681   end procedure.
     2682   procedure diasize_restore-current-size :
     2683     do
     2684     on error undo, return error return-value
     2685     :
     2686       run diasize_set-height in this-procedure
     2687         (input  v-diasize-current-frame-height
     2688         ,input  true
     2689         ) .
     2690       run diasize_set-width in this-procedure
     2691         (input  v-diasize-current-frame-width
     2692         ,input  true
     2693         ) .
     2694     end.
     2695   end procedure.
     2696   procedure diasize_set-browse-handle :
     2697     define input  parameter p-browse-handle as handle   no-undo .
     2698     define buffer buf_temp-browse-handle for temp-browse-handle .
     2699     do
     2700     on error undo, return error return-value
     2701     :
     2702       assign
     2703         v-diasize-browse-handle = p-browse-handle
     2704       .
     2705       for each buf_temp-browse-handle
     2706       on error undo, return error return-value
     2707       :
     2708         delete buf_temp-browse-handle .
     2709       end.
     2710     end.
     2711   end procedure.
     2712   procedure diasize_add_browse :
     2713     define input  parameter p-browse-type   as character no-undo .
     2714     define input  parameter p-browse-handle as handle    no-undo .
     2715     define buffer buf_temp-browse-handle for temp-browse-handle .
     2716     do
     2717     on error undo, return error return-value
     2718     :
     2719       assign
     2720         v-diasize-browse-number = v-diasize-browse-number + 1
     2721       .
     2722       create buf_temp-browse-handle .
     2723       assign
     2724         buf_temp-browse-handle.browse-type   = p-browse-type
     2725         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2726         buf_temp-browse-handle.browse-handle = p-browse-handle
     2727       .
     2728     end.
     2729   end procedure.
     2730   procedure diasize_init :
     2731     define variable v-default-value    as logical   no-undo .
     2732     define variable v-restore-saved    as logical   no-undo .
     2733     define variable v-resize-value-str as character no-undo .
     2734     do
     2735     on error undo, return error return-value
     2736     :
     2737       do with frame Dialog-Frame
     2738       :
     2739         assign
     2740           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2741           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2742           v-diasize-browse-handle     = browse br-host :handle
     2743         .
     2744         create button v-diasize-resize-button
     2745         assign
     2746           parent        = frame Dialog-Frame :first-child
     2747           label         = "s"
     2748           height-pixels = 16
     2749           width-pixels  = 16
     2750           visible       = true
     2751           sensitive     = true
     2752           movable       = true
     2753           triggers:
     2754             on end-move persistent run diasize_end-move in this-procedure .
     2755           end triggers.
     2756         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2757         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2758         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2759         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2760         assign
     2761           v-diasize-wndmax = false
     2762         .
     2763         if connected("ub") = true
     2764         then do:
     2765           define variable v-cntxt-db-num        as integer   no-undo .
     2766           define variable v-cntxt-userid        as character no-undo .
     2767           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2768                                             , OUTPUT v-cntxt-userid
     2769                                             ) .
     2770           run gbl/wndpar_r.p
     2771             (input  v-cntxt-db-num
     2772             ,input  v-cntxt-userid
     2773             ,input  'wndmax':U
     2774             ,output v-diasize-wndmax
     2775             ,output v-default-value
     2776             ) .
     2777         end.
     2778         assign
     2779           v-diasize-wndstore = false
     2780         .
     2781         if connected("ub") = true
     2782         then do:
     2783           run gbl/wndpar_r.p
     2784             (input  v-cntxt-db-num
     2785             ,input  v-cntxt-userid
     2786             ,input  'wndstore':U
     2787             ,output v-diasize-wndstore
     2788             ,output v-default-value
     2789             ) .
     2790         end.
     2791         assign
     2792           v-diasize-proc-name = entry(1, program-name(2), '.')
     2793         .
     2794         if v-diasize-wndstore = true
     2795         then do:
     2796           assign
     2797             v-restore-saved = false
     2798           .
     2799           if connected("ub") = true
     2800           then do:
     2801             run gbl/wndsizer.p
     2802               (input  v-cntxt-db-num
     2803               ,input  v-cntxt-userid
     2804               ,input  v-diasize-proc-name
     2805               ,input  'height':u
     2806               ,output v-resize-value-str
     2807               ) .
     2808             if v-resize-value-str <> '':U
     2809             then do:
     2810               run diasize_change-height in this-procedure
     2811                 (input  integer(v-resize-value-str)
     2812                 ,input  true
     2813                 ) .
     2814               assign
     2815                 v-restore-saved = true
     2816               .
     2817             end.
     2818           end.
     2819           if connected("ub") = true
     2820           then do:
     2821             run gbl/wndsizer.p
     2822               (input  v-cntxt-db-num
     2823               ,input  v-cntxt-userid
     2824               ,input  v-diasize-proc-name
     2825               ,input  'width':u
     2826               ,output v-resize-value-str
     2827               ) .
     2828             if v-resize-value-str <> '':U
     2829             then do:
     2830               run diasize_change-width in this-procedure
     2831                 (input  integer(v-resize-value-str)
     2832                 ,input  true
     2833                 ) .
     2834               assign
     2835                 v-restore-saved = true
     2836               .
     2837             end.
     2838           end.
     2839           if v-restore-saved <> true
     2840           then do:
     2841             if v-diasize-wndmax = true
     2842             then do:
     2843               run diasize_maximize in this-procedure
     2844                 (input  true
     2845                 ) .
     2846             end.
     2847           end.
     2848         end.
     2849         else do:
     2850           if v-diasize-wndmax = true
     2851           then do:
     2852             run diasize_maximize in this-procedure
     2853               (input  true
     2854               ) .
     2855           end.
     2856         end.
     2857       end.
     2858     end.
     2859   end procedure.
     2860   procedure diasize_need-full-display :
     2861     define output parameter p-need-full-display as logical   no-undo .
     2862     do
     2863     on error undo, return error return-value
     2864     :
     2865       assign
     2866         p-need-full-display = v-diasize-need-full-display
     2867       .
     2868       assign
     2869         v-diasize-need-full-display = false
     2870       .
     2871     end.
     2872   end procedure.
     2873   procedure get-context :
     2874      define output parameter p-db-num as integer          no-undo.
     2875      define output parameter p-user-id as character        no-undo.
     2876      define variable v-login               as character    no-undo.
     2877      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2878      define buffer buf_user-login  for ub.user-login .
     2879      do
     2880      on error undo, return error
     2881      :
     2882            FIND FIRST buf_sys-ctrl no-lock.
     2883            ASSIGN
     2884               v-login = USERID("ub")
     2885               p-db-num = buf_sys-ctrl.db-num
     2886            .
     2887            FIND FIRST buf_user-login
     2888                 WHERE buf_user-login.db-num = p-db-num
     2889                   AND buf_user-login.user-login = v-login
     2890                 no-lock
     2891                 no-error
     2892                 .
     2893            IF AVAILABLE buf_user-login
     2894            THEN DO:
     2895               assign
     2896                  p-user-id = buf_user-login.user-id
     2897               .
     2898            END.
     2899      end.
     2900   end procedure.
     2901   run diasize_add_browse in this-procedure
     2902     (input  'width':u
     2903     ,input  browse br-obj :handle
     2904     ) .
     2905   run diasize_init in this-procedure .
     2906   assign
     2907     p-user-select      = false
     2908     p-select-host-code = ?
     2909     p-List-select-host-code = ""
     2910   .
     2911   MAIN-BLOCK:
     2912   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2913      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2914   :
     2915     assign
     2916       v-host-name   :resizable in browse br-host = true
     2917       v-object-name :resizable in browse br-obj  = true
     2918     .
     2919     define variable v-colwidth-data-exist as logical   no-undo .
     2920   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2921   run colwidth-read in this-procedure
     2922     (input  v-cntxt-db-num
     2923     ,input  v-cntxt-userid
     2924     ,input  'gbl/userhsts.w':U
     2925     ,output v-colwidth-data-exist
     2926     )  .
     2927     if v-colwidth-data-exist = true
     2928     then do:
     2929       assign
     2930         v-host-name   :width in browse br-host = v-colwidth-width-01
     2931         v-object-name :width in browse br-obj  = v-colwidth-width-02
     2932       .
     2933     end.
     2934     else do:
     2935       assign
     2936         v-host-name   :width in browse br-host = 25
     2937         v-object-name :width in browse br-obj  = 25
     2938       .
     2939     end.
     2940     RUN MyEnable.
     2941     WAIT-FOR GO OF FRAME Dialog-Frame.
     2942   END.
     2943   assign
     2944     v-colwidth-width-01 = v-host-name   :width in browse br-host
     2945     v-colwidth-width-02 = v-object-name :width in browse br-obj
     2946   .
     2947   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2948   run colwidth-write in this-procedure
     2949     .
     2950   RUN disable_UI.
     2951   PROCEDURE br-obj-show-object :
     2952     do
     2953     on error undo, return error return-value
     2954     :
     2955       if available ub.user-obj
     2956       then do:
     2957         run ref/showcli.p
     2958           (input parparentproc
     2959           ,input ub.user-obj.obj-type
     2960           ,input ub.user-obj.obj-code
     2961           ) no-error.
     2962       end.
     2963     end.
     2964   END PROCEDURE.
     2965   PROCEDURE change-menu :
     2966   define buffer buf_user-menu-group for ub.user-menu-group.
     2967   define buffer buf_menu-group      for ub.menu-group.
     2968   define buffer buf_temp-user-host  for temp-user-host.
     2969   define buffer buf_temp-user-menu-group    for temp-user-menu-group.
     2970   define variable v-menu-group-code    as integer      no-undo.
     2971   define variable v-ok                 as logical      no-undo.
     2972   define variable v-accepted    as logical      no-undo.
     2973   define variable v-changed    as logical      no-undo.
     2974   define variable v-user-menu-group-code    as integer      no-undo.
     2975   do for buf_user-menu-group
     2976      on error undo, return no-apply
     2977      :
     2978      run twowin_clear in this-procedure.
     2979      FOR EACH  buf_menu-group
     2980          NO-LOCK
     2981          on error undo, return error
     2982          :
     2983   define variable vss-include-info22 as character format "X(65)" no-undo
     2984   initial "@(#)$Workfile$ $Revision$".
     2985   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkmngr in g#library2
     2986     (input  buf_menu-group.menu-group-id
     2987     ,input  'firm':U
     2988     ,input  'орг':U
     2989     ,input  ub.user-host.host-code
     2990     ,input  p-db-num
     2991     ,output v-ok
     2992     ) no-error .
     2993          IF NOT v-ok THEN DO:
     2994             NEXT.
     2995          end.
     2996          FIND FIRST buf_temp-user-menu-group
     2997          where buf_temp-user-menu-group.menu-group-code    = buf_menu-group.menu-group-code
     2998          no-lock
     2999          no-error
     3000          .
     3001          run twowin_add-item in this-procedure
     3002            ( input string( buf_menu-group.menu-group-code  )
     3003            , input buf_menu-group.menu-group-name
     3004            , input buf_menu-group.menu-group-description
     3005            , input ( available buf_temp-user-menu-group )
     3006            ) .
     3007      end.
     3008      run gbl/twowin.w
     3009         ( input parparentproc
     3010         , input 1
     3011         , input "Добавление меню фирме"
     3012         , input "":U
     3013         , input "&Тест"
     3014         , input table temp_twowin_items
     3015         , output table temp_twowin_itemsSelected
     3016         , output v-changed
     3017         , output v-accepted
     3018         ) .
     3019      IF NOT v-accepted THEN DO:
     3020         RETURN.
     3021      END.
     3022      find first buf_temp-user-host
     3023         no-error
     3024         .
     3025      if available buf_temp-user-host then do:
     3026      define variable v-list-host    as character    no-undo.
     3027      define variable v-ccc    as integer      no-undo.
     3028         assign
     3029            v-ok  = FALSE
     3030            v-ccc = 0
     3031         .
     3032         FOR EACH buf_temp-user-host
     3033         :
     3034           assign
     3035            v-list-host = SUBSTITUTE("&1&2&3 &4"
     3036                                       , v-list-host
     3037                                       , (if v-list-host = "":U then "":U else chr(10))
     3038                                       , buf_temp-user-host.host-code
     3039                                       , buf_temp-user-host.host-name
     3040                                       )
     3041            v-ccc = v-ccc + 1
     3042           .
     3043         END.
     3044         IF v-ccc > 1 THEN DO:
     3045            message
     3046               "Будет изменен список доступных меню для фирм пользователя:"
     3047               SKIP(1)
     3048               v-list-host
     3049               SKIP(1) "Вы уверены?"
     3050            view-as alert-box buttons yes-no
     3051            update v-ok .
     3052            if v-ok = no then do:
     3053               undo, return.
     3054            end.
     3055         end.
     3056         FOR EACH buf_temp-user-host
     3057         :
     3058            for each  buf_user-menu-group
     3059               where buf_user-menu-group.db-num = p-db-num
     3060                  and buf_user-menu-group.user-id = p-user-id
     3061                  and buf_user-menu-group.host-code = buf_temp-user-host.host-code
     3062                  and buf_user-menu-group.menu-group-context = 'firm':U
     3063               exclusive-lock
     3064               on error undo, return error
     3065               :
     3066               find first temp_twowin_itemsSelected
     3067                     where temp_twowin_itemsSelected.itmExtKey = string( buf_user-menu-group.user-menu-group-code )
     3068               no-error.
     3069               if not available temp_twowin_itemsSelected
     3070               then do:
     3071                  delete buf_user-menu-group.
     3072               end.
     3073            end.
     3074            for each temp_twowin_itemsSelected
     3075            :
     3076               assign
     3077                  v-menu-group-code = integer( temp_twowin_itemsSelected.itmExtKey )
     3078               no-error.
     3079               if error-status :error
     3080               then do:
     3081                  message
     3082                        vss-workfile vss-revision vss-description
     3083                     skip(1)
     3084                     skip "Ошибка передачи первичного ключа из двухоконного интерфейса."
     3085                     skip return-value
     3086                     skip trim( error-status :get-message( 1 ) )
     3087                        trim( error-status :get-message( 2 ) )
     3088                        trim( error-status :get-message( 3 ) )
     3089                  view-as alert-box error.
     3090                  undo, return error.
     3091               end.
     3092               find first  buf_user-menu-group
     3093               where buf_user-menu-group.db-num = p-db-num
     3094                  and buf_user-menu-group.user-id = p-user-id
     3095                  and buf_user-menu-group.host-code = buf_temp-user-host.host-code
     3096                  and buf_user-menu-group.menu-group-context = 'firm':U
     3097                  and buf_user-menu-group.menu-group-code =v-menu-group-code
     3098               no-lock
     3099               no-error
     3100               .
     3101               if not available buf_user-menu-group
     3102               then do:
     3103                  FIND FIRST buf_menu-group
     3104                     WHERE buf_menu-group.menu-code = 0
     3105                     and buf_menu-group.menu-group-code =v-menu-group-code
     3106                     NO-LOCK
     3107                     no-error
     3108                     .
     3109                     if error-status :error
     3110                     then do:
     3111                        message
     3112                              vss-workfile vss-revision vss-description
     3113                           skip(1)
     3114                           skip "Ошибка поиска Меню в системе."
     3115                           skip return-value
     3116                           skip trim( error-status :get-message( 1 ) )
     3117                              trim( error-status :get-message( 2 ) )
     3118                              trim( error-status :get-message( 3 ) )
     3119                        view-as alert-box error.
     3120                        undo, return error.
     3121                     end.
     3122                     assign
     3123                     v-user-menu-group-code = NEXT-VALUE(s-user-menu-group, ub)
     3124                     .
     3125                        CREATE buf_user-menu-group .
     3126                        ASSIGN
     3127                           buf_user-menu-group.db-num               = p-db-num
     3128                           buf_user-menu-group.user-id              = p-user-id
     3129                           buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     3130                           buf_user-menu-group.menu-code            = buf_menu-group.menu-code
     3131                           buf_user-menu-group.menu-group-code      = buf_menu-group.menu-group-code
     3132                           buf_user-menu-group.menu-group-id        = buf_menu-group.menu-group-id
     3133                           buf_user-menu-group.menu-group-context   = 'firm':U
     3134                           buf_user-menu-group.host-code            = buf_temp-user-host.host-code
     3135                           buf_user-menu-group.obj-type             = '':U
     3136                           buf_user-menu-group.obj-code             = 0
     3137                        .
     3138               end.
     3139            end.
     3140         end.
     3141      end.
     3142      else do:
     3143         IF NOT v-changed THEN DO:
     3144            RETURN.
     3145         END.
     3146         for each  buf_user-menu-group
     3147            where buf_user-menu-group.db-num = p-db-num
     3148               and buf_user-menu-group.user-id = p-user-id
     3149               and buf_user-menu-group.host-code = ub.user-host.host-code
     3150               and buf_user-menu-group.menu-group-context = 'firm':U
     3151            exclusive-lock
     3152            on error undo, return error
     3153            :
     3154            find first temp_twowin_itemsSelected
     3155                  where temp_twowin_itemsSelected.itmExtKey = string( buf_user-menu-group.user-menu-group-code )
     3156            no-error.
     3157            if not available temp_twowin_itemsSelected
     3158            then do:
     3159               delete buf_user-menu-group.
     3160            end.
     3161         end.
     3162         for each temp_twowin_itemsSelected
     3163         :
     3164            assign
     3165               v-menu-group-code = integer( temp_twowin_itemsSelected.itmExtKey )
     3166            no-error.
     3167            if error-status :error
     3168            then do:
     3169               message
     3170                     vss-workfile vss-revision vss-description
     3171                  skip(1)
     3172                  skip "Ошибка передачи первичного ключа из двухоконного интерфейса."
     3173                  skip return-value
     3174                  skip trim( error-status :get-message( 1 ) )
     3175                     trim( error-status :get-message( 2 ) )
     3176                     trim( error-status :get-message( 3 ) )
     3177               view-as alert-box error.
     3178               undo, return error.
     3179            end.
     3180            find first  buf_user-menu-group
     3181            where buf_user-menu-group.db-num = p-db-num
     3182               and buf_user-menu-group.user-id = p-user-id
     3183               and buf_user-menu-group.host-code = ub.user-host.host-code
     3184               and buf_user-menu-group.menu-group-context = 'firm':U
     3185               and buf_user-menu-group.menu-group-code =v-menu-group-code
     3186            no-lock
     3187            no-error
     3188            .
     3189            if not available buf_user-menu-group
     3190            then do:
     3191               FIND FIRST buf_menu-group
     3192                  WHERE buf_menu-group.menu-code = 0
     3193                  and buf_menu-group.menu-group-code =v-menu-group-code
     3194                  NO-LOCK
     3195                  no-error
     3196                  .
     3197                  if error-status :error
     3198                  then do:
     3199                     message
     3200                           vss-workfile vss-revision vss-description
     3201                        skip(1)
     3202                        skip "Ошибка поиска Меню в системе."
     3203                        skip return-value
     3204                        skip trim( error-status :get-message( 1 ) )
     3205                           trim( error-status :get-message( 2 ) )
     3206                           trim( error-status :get-message( 3 ) )
     3207                     view-as alert-box error.
     3208                     undo, return error.
     3209                  end.
     3210                  assign
     3211                  v-user-menu-group-code = NEXT-VALUE(s-user-menu-group, ub)
     3212                  .
     3213                     CREATE buf_user-menu-group .
     3214                     ASSIGN
     3215                        buf_user-menu-group.db-num               = p-db-num
     3216                        buf_user-menu-group.user-id              = p-user-id
     3217                        buf_user-menu-group.user-menu-group-code = v-user-menu-group-code
     3218                        buf_user-menu-group.menu-code            = buf_menu-group.menu-code
     3219                        buf_user-menu-group.menu-group-code      = buf_menu-group.menu-group-code
     3220                        buf_user-menu-group.menu-group-id        = buf_menu-group.menu-group-id
     3221                        buf_user-menu-group.menu-group-context   = 'firm':U
     3222                        buf_user-menu-group.host-code            = ub.user-host.host-code
     3223                        buf_user-menu-group.obj-type             = '':U
     3224                        buf_user-menu-group.obj-code             = 0
     3225                     .
     3226            end.
     3227         end.
     3228      end.
     3229   end.
     3230   END PROCEDURE.
     3231   PROCEDURE check-selection :
     3232     define variable v-ok as logical   no-undo .
     3233     define buffer buf_temp-user-host for temp-user-host .
     3234     do
     3235     on error undo, return error return-value
     3236     :
     3237       do with frame Dialog-Frame
     3238       :
     3239         if can-do ( p-bttns, "b-mark")
     3240         then do:
     3241           find first buf_temp-user-host
     3242             no-error .
     3243           if available buf_temp-user-host
     3244           then do:
     3245             message
     3246               "Информация о выбранных элементах будет потеряна" Skip
     3247               "Продолжить?" Skip
     3248               view-as alert-box question buttons yes-no update v-ok .
     3249             if v-ok = true
     3250             then do:
     3251               for each buf_temp-user-host
     3252               on error undo, return error return-value
     3253               :
     3254                 delete buf_temp-user-host .
     3255               end.
     3256             end.
     3257             else do:
     3258               undo, return error return-value .
     3259             end.
     3260           end.
     3261         end.
     3262       end.
     3263     end.
     3264   END PROCEDURE.
     3265   PROCEDURE choose-mark :
     3266     define variable v-log as logical no-undo .
     3267     define buffer buf_temp-user-host for temp-user-host .
     3268     do
     3269     on error undo, return error return-value
     3270     :
     3271       if available ub.user-host
     3272       then do:
     3273         find first buf_temp-user-host
     3274           where buf_temp-user-host.host-code = ub.user-host.host-code
     3275           no-error .
     3276         if available buf_temp-user-host
     3277         then do:
     3278           run userhsts_delete in this-procedure
     3279             ( input  ub.user-host.host-code
     3280             , input  ub.user-host.db-num
     3281             ) .
     3282         end.
     3283         else do:
     3284           run userhsts_append in this-procedure
     3285             ( input  ub.user-host.host-code
     3286             , input  ub.user-host.db-num
     3287             ) .
     3288         end.
     3289         v-log = br-host:refresh() in frame Dialog-Frame.
     3290         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     3291         then do:
     3292           v-log = br-host:select-next-row ().
     3293           run update-br-host-dependent in this-procedure .
     3294         end.
     3295         run display-select-num in this-procedure .
     3296         apply 'entry':U to br-host in frame Dialog-Frame.
     3297       end.
     3298     end.
     3299   END PROCEDURE.
     3300   PROCEDURE choose-select :
     3301     define buffer buf_temp-user-host for temp-user-host .
     3302     do
     3303     on error undo, return error return-value
     3304     :
     3305       do with frame Dialog-Frame
     3306       :
     3307         if available ub.user-host
     3308         then do:
     3309           if INDEX ( p-bttns, "b-mark") > 0
     3310           then do:
     3311             find first buf_temp-user-host
     3312               no-error .
     3313             if not available buf_temp-user-host
     3314             then do:
     3315               run userhsts_append in this-procedure
     3316                 ( input  ub.user-host.host-code
     3317                 , input  ub.user-host.db-num
     3318                 ) .
     3319             end.
     3320             run userhsts_clear in p-callback-handle .
     3321             for each buf_temp-user-host
     3322             on error undo, return error return-value
     3323             :
     3324               run userhsts_append in p-callback-handle
     3325                 ( input  buf_temp-user-host.host-code
     3326                 ) .
     3327             ASSIGN
     3328                p-List-Select-Host-code = p-List-select-host-code +
     3329                                          (IF p-List-select-host-code = "" THEN "" ELSE "," ) +
     3330                                          STRING(buf_temp-user-host.host-code).
     3331             end.
     3332           end.
     3333           else do:
     3334             assign
     3335               p-select-host-code = ub.user-host.host-code
     3336             .
     3337           end.
     3338         end.
     3339       end.
     3340       assign
     3341         p-user-select = true
     3342       .
     3343     end.
     3344   END PROCEDURE.
     3345   PROCEDURE create_user_host :
     3346   DEFINE VARIABLE v-out-host-code AS INTEGER   NO-UNDO.
     3347   DEFINE VARIABLE v-rid-list      AS CHARACTER NO-UNDO .
     3348   define variable v-count         as integer   no-undo.
     3349   define buffer buf_sysconf       FOR ub.sysconf.
     3350   define buffer buf_clients     for ub.clients .
     3351   define buffer buf_user-host      for ub.user-host .
     3352   do
     3353   on error undo, return error return-value
     3354   :
     3355      run adm/sconfs.w ( INPUT parparentproc
     3356                       , INPUT "b-sel,b-mark"
     3357                       , FALSE
     3358                       , p-curr-host-code
     3359                       , OUTPUT v-out-host-code
     3360                       , INPUT-OUTPUT v-rid-list
     3361                       ) .
     3362      IF  v-rid-list <> ""
     3363      AND v-rid-list <> ?
     3364      THEN
     3365      count_:
     3366      DO v-count = 1 to num-entries(v-rid-list)
     3367      transaction
     3368      :
     3369         FIND FIRST buf_sysconf
     3370            WHERE RECID( buf_sysconf ) = INTEGER(ENTRY(v-count, v-rid-list))
     3371            NO-LOCK
     3372            NO-ERROR.
     3373         if ERROR-STATUS :ERROR
     3374         OR NOT AVAILABLE buf_sysconf
     3375         then do:
     3376              NEXT count_.
     3377         end.
     3378         IF CAN-FIND (buf_user-host where buf_user-host.host-code     = buf_sysconf.host-code
     3379                                       and buf_user-host.user-id      = p-user-id
     3380                                       AND buf_user-host.db-num       = p-db-num
     3381                              no-lock)
     3382         then do:
     3383            next count_.
     3384         end.
     3385         CREATE ub.user-host.
     3386         ASSIGN
     3387            ub.user-host.db-num    = p-db-num
     3388            ub.user-host.user-id   = p-user-id
     3389            ub.user-host.host-code = buf_sysconf.host-code
     3390         .
     3391      END.
     3392   END.
     3393   END PROCEDURE.
     3394   PROCEDURE delete_user_host :
     3395     DEFINE VARIABLE v-out-host-code AS INTEGER   NO-UNDO.
     3396     DEFINE VARIABLE v-rid-list      AS CHARACTER NO-UNDO .
     3397     do
     3398     transaction
     3399     on error undo, return error return-value
     3400     :
     3401        define variable v-ok                    as logical   no-undo .
     3402        define variable v-message-text          as character no-undo .
     3403        define variable v-cntxt-valid           as logical   no-undo .
     3404        define variable v-cntxt-menu-code       as integer   no-undo .
     3405        define variable v-cntxt-menu-group-code as integer   no-undo .
     3406        define variable v-cntxt-level           as character no-undo .
     3407        define variable v-cntxt-host-code-obj   as integer   no-undo .
     3408        define variable v-cntxt-obj-type        as character no-undo .
     3409        define variable v-cntxt-obj-code        as integer   no-undo .
     3410        define buffer   buf_user-host for ub.user-host.
     3411        v-ok = no.
     3412        run gbl/cntxtget.p ( INPUT  p-db-num
     3413                           , INPUT  p-user-id
     3414                           , OUTPUT v-cntxt-valid
     3415                           , OUTPUT v-cntxt-menu-code
     3416                           , OUTPUT v-cntxt-menu-group-code
     3417                           , OUTPUT v-cntxt-level
     3418                           , OUTPUT v-cntxt-host-code-obj
     3419                           , OUTPUT v-cntxt-obj-type
     3420                           , OUTPUT v-cntxt-obj-code
     3421                           ) .
     3422        if  v-cntxt-host-code-obj = ub.user-host.host-code
     3423        THEN DO:
     3424           v-message-text = "Удаляемая фирма - текущая для данного пользователя.~n".
     3425        END.
     3426        v-message-text = v-message-text + SUBSTITUTE("Удалить фирму &1 (сделать ее недоступной для данного пользователя) ?", get-host-name(ub.user-host.host-code) ).
     3427        MESSAGE v-message-text
     3428        VIEW-AS ALERT-BOX
     3429        BUTTONS OK-CANCEL
     3430        TITLE "Удаление фирмы":U
     3431        UPDATE v-ok.
     3432        IF NOT v-ok THEN RETURN NO-APPLY.
     3433        run userhsts_delete in this-procedure ( INPUT ub.user-host.host-code
     3434                                              , INPUT ub.user-host.db-num
     3435                                              ) .
     3436        FIND buf_user-host WHERE buf_user-host.db-num    = ub.user-host.db-num
     3437                             AND buf_user-host.user-id   = p-user-id
     3438                             AND buf_user-host.host-code = ub.user-host.host-code
     3439                           EXCLUSIVE-LOCK.
     3440        DELETE buf_user-host.
     3441        IF INDEX("текущая", v-message-text) > 0 THEN DO:
     3442           run gbl/cntxtstr.p ( INPUT  p-db-num
     3443                              , INPUT  p-user-id
     3444                              , INPUT  v-cntxt-menu-code
     3445                              , INPUT  v-cntxt-menu-group-code
     3446                              , INPUT  'global':U
     3447                              , INPUT  ""
     3448                              , INPUT  ""
     3449                              , INPUT  ""
     3450                              )  .
     3451           MESSAGE "Удалена текущая фирма для данного пользователя." skip (2)
     3452                   "Пользователю по умолчанию выставлен контекст без фирмы"
     3453           VIEW-AS ALERT-BOX WARNING.
     3454        END.
     3455     end.
     3456   END PROCEDURE.
     3457   PROCEDURE disable_UI :
     3458     HIDE FRAME Dialog-Frame.
     3459   END PROCEDURE.
     3460   PROCEDURE display-select-num :
     3461     do
     3462     on error undo, return error return-value
     3463     :
     3464       assign
     3465         mark-num = string(v-total-select-num)
     3466       .
     3467       if v-total-select-num = 0
     3468       then do:
     3469         hide
     3470           mark-num
     3471           in frame Dialog-Frame.
     3472       end.
     3473       else do:
     3474         display
     3475           mark-num
     3476           with frame Dialog-Frame.
     3477       end.
     3478     end.
     3479   END PROCEDURE.
     3480   PROCEDURE enable_UI :
     3481     DISPLAY mark-num
     3482         WITH FRAME Dialog-Frame.
     3483     ENABLE b-quit B-mark B-sel b-action b-menu B-Help b-add B-lookup B-company
     3484            b-del B-obj br-host br-obj mark-num
     3485         WITH FRAME Dialog-Frame.
     3486     VIEW FRAME Dialog-Frame.
     3487     run open-query-user-host in this-procedure .    run open-query-user-obj in this-procedure .
     3488   END PROCEDURE.
     3489   PROCEDURE fill-temp-menu-group :
     3490   do
     3491   on error undo, return error
     3492   :
     3493   define buffer buf_temp-user-host    for temp-user-host.
     3494   define buffer buf_user-menu-group   for ub.user-menu-group.
     3495   define buffer buf_menu-group        for ub.menu-group.
     3496   define variable v-sel-host-count    as integer      no-undo.
     3497      find first buf_temp-user-host
     3498         no-error
     3499         .
     3500      if NOT available buf_temp-user-host then do:
     3501         empty temp-table temp-user-menu-group.
     3502         FOR EACH  buf_user-menu-group
     3503            WHERE buf_user-menu-group.db-num     = p-db-num
     3504               AND buf_user-menu-group.user-id   = p-user-id
     3505               AND buf_user-menu-group.host-code = ub.user-host.host-code
     3506               AND buf_user-menu-group.menu-group-context = 'firm':U
     3507            NO-LOCK
     3508            ,
     3509            FIRST buf_menu-group
     3510            WHERE buf_menu-group.menu-code       = buf_user-menu-group.menu-code
     3511              AND buf_menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     3512            NO-LOCK
     3513            :
     3514            create temp-user-menu-group.
     3515            assign
     3516               temp-user-menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     3517               temp-user-menu-group.menu-group-name = buf_menu-group.menu-group-name
     3518               temp-user-menu-group.menu-group-description = buf_menu-group.menu-group-description
     3519               temp-user-menu-group.sel-color       = 0
     3520            .
     3521         END.
     3522     END.
     3523     else do:
     3524        empty temp-table temp-user-menu-group.
     3525        assign
     3526           v-sel-host-count = 0
     3527        .
     3528        for each buf_temp-user-host
     3529        :
     3530           assign
     3531              v-sel-host-count = v-sel-host-count + 1
     3532           .
     3533        end.
     3534        for each buf_temp-user-host
     3535        :
     3536            FOR EACH  buf_user-menu-group
     3537               WHERE buf_user-menu-group.db-num     = p-db-num
     3538                  AND buf_user-menu-group.user-id   = p-user-id
     3539                  AND buf_user-menu-group.host-code = buf_temp-user-host.host-code
     3540                  AND buf_user-menu-group.menu-group-context = 'firm':U
     3541               NO-LOCK
     3542               ,
     3543               FIRST buf_menu-group
     3544               WHERE buf_menu-group.menu-code       = buf_user-menu-group.menu-code
     3545               AND buf_menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     3546               NO-LOCK
     3547               :
     3548               find first temp-user-menu-group
     3549                  where temp-user-menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     3550                  no-error
     3551                  .
     3552               IF NOT AVAILABLE temp-user-menu-group then do:
     3553                  create temp-user-menu-group.
     3554                  assign
     3555                     temp-user-menu-group.menu-group-code = buf_user-menu-group.menu-group-code
     3556                     temp-user-menu-group.menu-group-name = buf_menu-group.menu-group-name
     3557                     temp-user-menu-group.sel-color       = v-sel-host-count
     3558                     temp-user-menu-group.menu-group-description = buf_menu-group.menu-group-description
     3559                  .
     3560               end.
     3561               assign
     3562                  temp-user-menu-group.sel-color = temp-user-menu-group.sel-color - 1
     3563               .
     3564            END.
     3565        end.
     3566     end.
     3567   end.
     3568   END PROCEDURE.
     3569   PROCEDURE get-host-name-proc :
     3570     define input  parameter p-host-code as integer   no-undo .
     3571     define output parameter p-host-name as character no-undo .
     3572     define buffer buf_clients for ub.clients .
     3573     do
     3574     on error undo, return error return-value
     3575     :
     3576       find first buf_clients no-lock
     3577         where buf_clients.obj-type = 'орг':U
     3578           and buf_clients.obj-code = p-host-code
     3579         no-error .
     3580       if available buf_clients
     3581       then do:
     3582         assign
     3583           p-host-name = (if buf_clients.stts = 0
     3584                          then buf_clients.obj-name
     3585                          else (substring (buf_clients.obj-name, 1, 20)
     3586                               + fill (" " , 20 - length (substring (buf_clients.obj-name, 1, 20)))
     3587                               + '---  УДАЛЕН  ---':U
     3588                               )
     3589                         )
     3590         .
     3591       end.
     3592     end.
     3593   END PROCEDURE.
     3594   PROCEDURE get-object-db-num-proc :
     3595     define input  parameter p-obj-type      as character no-undo .
     3596     define input  parameter p-obj-code      as integer   no-undo .
     3597     define output parameter p-object-db-num as integer   no-undo .
     3598     define buffer buf_clients for ub.clients .
     3599     do
     3600     on error undo, return error return-value
     3601     :
     3602       find first buf_clients no-lock
     3603         where buf_clients.obj-type = p-obj-type
     3604           and buf_clients.obj-code = p-obj-code
     3605         no-error .
     3606       if available buf_clients
     3607       then do:
     3608         assign
     3609           p-object-db-num = buf_clients.db-num
     3610         .
     3611       end.
     3612       else do:
     3613         assign
     3614           p-object-db-num = ?
     3615         .
     3616       end.
     3617     end.
     3618   END PROCEDURE.
     3619   PROCEDURE get-object-name-proc :
     3620     define input  parameter p-obj-type    as character no-undo .
     3621     define input  parameter p-obj-code    as integer   no-undo .
     3622     define output parameter p-object-name as character no-undo .
     3623     define buffer buf_clients for ub.clients .
     3624     do
     3625     on error undo, return error return-value
     3626     :
     3627       find first buf_clients no-lock
     3628         where buf_clients.obj-type = p-obj-type
     3629           and buf_clients.obj-code = p-obj-code
     3630         no-error .
     3631       if available buf_clients
     3632       then do:
     3633         assign
     3634           p-object-name = buf_clients.obj-name
     3635         .
     3636       end.
     3637       else do:
     3638         assign
     3639           p-object-name = ?
     3640         .
     3641       end.
     3642     end.
     3643   END PROCEDURE.
     3644   PROCEDURE host-default-object :
     3645      define input parameter p-host-code as integer no-undo .
     3646      define output parameter p-obj-type as character no-undo .
     3647      define output parameter p-obj-code as integer no-undo .
     3648      define buffer buf_firm for ub.firm .
     3649      find first buf_firm no-lock
     3650        where buf_firm.firm-code = p-host-code
     3651        no-error .
     3652      if available buf_firm then do:
     3653        assign
     3654          p-obj-type = main-obj-type
     3655          p-obj-code = main-obj-code
     3656        .
     3657      end.
     3658   END PROCEDURE.
     3659   PROCEDURE mark-string-proc :
     3660     define input  parameter p-host-code   as integer   no-undo .
     3661     define output parameter p-mark-string as character no-undo .
     3662     define buffer buf_temp-user-host for temp-user-host .
     3663     do
     3664     on error undo, return error return-value
     3665     :
     3666       find first buf_temp-user-host
     3667            where buf_temp-user-host.host-code = p-host-code
     3668            no-error
     3669            .
     3670       if available buf_temp-user-host
     3671       then do:
     3672         assign
     3673           p-mark-string = '*':U
     3674         .
     3675       end.
     3676       else do:
     3677         assign
     3678           p-mark-string = '':U
     3679         .
     3680       end.
     3681     end.
     3682   END PROCEDURE.
     3683   PROCEDURE MyEnable :
     3684     do
     3685     on error undo, return error return-value
     3686     :
     3687       disable
     3688       all
     3689       with frame dialog-frame
     3690       .
     3691       define variable v-user-name as character no-undo .
     3692       assign
     3693         frame dialog-frame :title = substitute("Фирмы пользователя &1"
     3694                                               , usrnickf( p-user-id )
     3695                                               )
     3696       .
     3697       enable
     3698         b-quit
     3699         b-sel  when can-do ( p-bttns, "b-sel")
     3700         b-mark when can-do ( p-bttns, "b-mark")
     3701         b-add  when can-do ( p-bttns, "b-add")
     3702         b-del  when can-do ( p-bttns, "b-add")
     3703         b-lookup
     3704         b-company
     3705         b-action
     3706         b-menu
     3707         b-help
     3708         br-host
     3709         br-obj
     3710         b-obj
     3711       with frame dialog-frame.
     3712       view frame dialog-frame.
     3713       run open-query-user-host in this-procedure .    run open-query-user-obj in this-procedure .
     3714       hide
     3715         mark-num
     3716         in frame Dialog-Frame .
     3717       if p-curr-host-code <> ?
     3718       then do:
     3719         define variable v-user-host-rowid as rowid no-undo .
     3720         define buffer buf_reposition_user-host for ub.user-host .
     3721         find first buf_reposition_user-host no-lock
     3722           where buf_reposition_user-host.db-num    = p-db-num
     3723             and buf_reposition_user-host.user-id   = p-user-id
     3724             and buf_reposition_user-host.host-code = p-curr-host-code
     3725           no-error .
     3726         if available buf_reposition_user-host
     3727         then do:
     3728           reposition br-host to rowid rowid(buf_reposition_user-host) no-error .
     3729         end.
     3730       end.
     3731       apply 'entry':U to br-host .
     3732       run update-br-host-dependent in this-procedure .
     3733     end.
     3734   END PROCEDURE.
     3735   PROCEDURE open-query-user-host :
     3736     do
     3737     on error undo, return error return-value
     3738     :
     3739       open query br-host for each ub.user-host no-lock
     3740            where ub.user-host.db-num  = p-db-num
     3741              and ub.user-host.user-id = p-user-id
     3742            indexed-reposition
     3743            .
     3744     end.
     3745   END PROCEDURE.
     3746   PROCEDURE open-query-user-obj :
     3747     do
     3748     on error undo, return error return-value
     3749     :
     3750       do
     3751       on error undo, return error return-value
     3752       :
     3753         if available ub.user-host
     3754         then do:
     3755           open query br-obj
     3756             for each ub.user-obj
     3757                no-lock
     3758                where ub.user-obj.db-num    = ub.user-host.db-num
     3759                  and ub.user-obj.user-id   = ub.user-host.user-id
     3760                  and ub.user-obj.host-code = ub.user-host.host-code
     3761                   by ub.user-obj.obj-type
     3762                   by ub.user-obj.obj-code
     3763             indexed-reposition
     3764             .
     3765         end.
     3766         else do:
     3767           open query br-obj for  each ub.user-obj no-lock
     3768                where ub.user-obj.db-num  = 0
     3769                  and ub.user-obj.user-id = '':U
     3770              indexed-reposition
     3771             .
     3772         end.
     3773       end.
     3774     end.
     3775   END PROCEDURE.
     3776   PROCEDURE update-br-host-dependent :
     3777     do
     3778     on error undo, return error return-value
     3779     :
     3780       run open-query-user-obj in this-procedure .
     3781       IF AVAILABLE ub.user-obj THEN DO:
     3782          enable b-obj
     3783          with frame dialog-frame.
     3784       END.
     3785       ELSE do:
     3786          disable b-obj
     3787          with frame dialog-frame.
     3788       end.
     3789     end.
     3790   END PROCEDURE.
     3791   PROCEDURE userhsts_append :
     3792     define input  parameter p-host-code as integer   no-undo .
     3793     define input  parameter p-db-num    as integer   no-undo .
     3794     define buffer buf_temp-user-host for temp-user-host .
     3795     do
     3796     on error undo, return error return-value
     3797     :
     3798       find first buf_temp-user-host
     3799            where buf_temp-user-host.host-code = p-host-code
     3800              and buf_temp-user-host.db-num    = p-db-num
     3801            no-error
     3802            .
     3803       if not available buf_temp-user-host
     3804       then do:
     3805         create buf_temp-user-host .
     3806         assign
     3807           buf_temp-user-host.host-code = p-host-code
     3808           buf_temp-user-host.db-num    = p-db-num
     3809         .
     3810         assign
     3811           buf_temp-user-host.host-name = get-host-name(p-host-code)
     3812           v-total-select-num = v-total-select-num + 1
     3813         .
     3814       end.
     3815     end.
     3816   END PROCEDURE.
     3817   PROCEDURE userhsts_delete :
     3818     define input  parameter p-host-code as integer   no-undo .
     3819     define input  parameter p-db-num    as integer   no-undo .
     3820     define buffer buf_temp-user-host for temp-user-host .
     3821     do
     3822     on error undo, return error return-value
     3823     :
     3824       find first buf_temp-user-host
     3825         where buf_temp-user-host.host-code = p-host-code
     3826           and buf_temp-user-host.db-num    = p-db-num
     3827         no-error .
     3828       if available buf_temp-user-host
     3829       then do:
     3830         delete buf_temp-user-host .
     3831         assign
     3832           v-total-select-num = v-total-select-num - 1
     3833         .
     3834       end.
     3835     end.
     3836   END PROCEDURE.
     3837   FUNCTION get-curr-name RETURNS CHARACTER
     3838     ( input p-curr-code as integer ) :
     3839     find first ub.currency no-lock where
     3840                    ub.currency.curr-code = p-curr-code no-error.
     3841       if available ub.currency then do:
     3842           return ub.currency.curr-abbr.
     3843       end.
     3844       else do:
     3845           return chr(63).
     3846       end.
     3847   END FUNCTION.
     3848   FUNCTION get-default-object RETURNS CHARACTER
     3849     ( input p-host-code as integer ) :
     3850     define variable v-obj-type as character no-undo .
     3851     define variable v-obj-code as integer no-undo .
     3852     run host-default-object
     3853       (input p-host-code
     3854       ,output v-obj-type
     3855       ,output v-obj-code
     3856       ) .
     3857     if v-obj-type <> "" then do:
     3858       return substitute('&1 &2':u, v-obj-type, v-obj-code) .
     3859     end.
     3860     else do:
     3861       return "" .
     3862     end.
     3863   END FUNCTION.
     3864   FUNCTION get-host-name RETURNS CHARACTER
     3865     ( INPUT p-host-code AS integer ) :
     3866     define variable v-host-name as character no-undo .
     3867     run get-host-name-proc in this-procedure
     3868       (input  p-host-code
     3869       ,output v-host-name
     3870       ) .
     3871     return v-host-name .
     3872   END FUNCTION.
     3873   FUNCTION get-object-db-num RETURNS INTEGER
     3874     ( INPUT p-obj-type AS CHARACTER, INPUT p-obj-code AS integer ) :
     3875     define variable v-object-db-num as integer   no-undo .
     3876     run get-object-db-num-proc in this-procedure
     3877       (input  p-obj-type
     3878       ,input  p-obj-code
     3879       ,output v-object-db-num
     3880       ) .
     3881     return v-object-db-num .
     3882   END FUNCTION.
     3883   FUNCTION get-object-name RETURNS CHARACTER
     3884     ( INPUT p-obj-type AS CHARACTER, INPUT p-obj-code AS integer ) :
     3885     define variable v-object-name as character no-undo .
     3886     run get-object-name-proc in this-procedure
     3887       (input  p-obj-type
     3888       ,input  p-obj-code
     3889       ,output v-object-name
     3890       ) .
     3891     return v-object-name .
     3892   END FUNCTION.
     3893   FUNCTION mark-string RETURNS CHARACTER
     3894     ( INPUT p-host-code AS integer ) :
     3895     define variable v-mark-string as character no-undo .
     3896     run mark-string-proc in this-procedure
     3897       (input  p-host-code
     3898       ,output v-mark-string
     3899       ) .
     3900     return v-mark-string .
     3901   END FUNCTION.
