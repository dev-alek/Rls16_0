      417   on error undo, return error
      418   :
      419   assign
      420   vattr-codes = "":U
      421   vattr-labels = "":U
      422   .
      423   _II:
      424   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      425     run thbjattr_code (
      426                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      427                         ,input   '':U
      428                         ,output  attr-label
      429                         ,output  attr-user-can-edit
      430                         ,output  attr-output-display
      431                         ,output  attr-other
      432                         ,output v-prop-list
      433                         ,output v-prop-type-list
      434                         ,output v-prop-label-list
      435                         ,output v-global
      436                         ,output v-host
      437                         ,output v-shop
      438                         ,output v-store
      439                         ,output v-db
      440                       ) no-error.
      441       .
      442       if NOT error-status:error
      443       and attr-user-can-edit
      444       and index(attr-other, "spr-ext=") > 0
      445       anD (if p-obj-type = 'маг':U
      446            then v-shop
      447            else (if p-obj-type = 'скл':U
      448                  then v-store
      449                  else (if p-obj-type = 'орг':U
      450                        then v-host
      451                        else (if p-obj-type = 'БД':U
      452                             then v-db
      453                             else v-global)
      454                       )
      455                  )
      456            ) then do:
      457         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      459     (input  'tpsi'
      460     ,input  0
      461     ,input  ''
      462     ,input  0
      463     ,input  ''
      464     ,input  ''
      465     ,input  ''
      466     ,input  no
      467     ,output conf-par
      468     ,output par-type
      469     ) no-error .
      470           if error-status:error
      471           or (conf-par <> "yes") then next _ii.
      472         end.
      473         assign
      474         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      475         vattr-labels = vattr-labels + chr(44) + attr-label
      476         .
      477       end.
      478   end.
      479   CASE p-mode:
      480     when 'ПРОСМОТР':U then do:
      481       assign
      482       v-title = "Выберите типы параметров для просмотра".
      483     end.
      484     when 'ИЗМЕНЕНИЕ':U then do:
      485       assign
      486       v-title = "Выберите типы параметров для редактирования".
      487     end.
      488     when  'КОПИРОВАНИЕ':U then do:
      489       assign
      490       v-title = "Выберите типы параметров для копирования".
      491     end.
      492   END CASE.
      493   run gbl/d-list.w (
      494                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      495                 ,INPUT v-title
      496                 ,INPUT vattr-codes
      497                 ,INPUT vattr-labels
      498                 ,INPUT chr(44)
      499                 ,INPUT "":U
      500                 ,output v-attr-code).
      501   IF v-attr-code = "":u THEN do:
      502     RETURN ''.
      503   end.
      504   if p-mode = 'ПРОСМОТР':U
      505   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      506     run thbjattr_code  in this-procedure (
      507          input   v-attr-code
      508         ,input   '':U
      509         ,output  attr-label
      510         ,output  attr-user-can-edit
      511         ,output  attr-output-display
      512         ,output  attr-other
      513         ,output v-prop-list
      514         ,output v-prop-type-list
      515         ,output v-prop-label-list
      516         ,output v-global
      517         ,output v-host
      518         ,output v-shop
      519         ,output v-store
      520         ,output v-db
      521     ).
      522     do ii = 1 to num-entries(attr-other, chr(47)):
      523       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      524         assign
      525         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      526       end.
      527     end.
      528     run value(v-spr) (
      529                      input parparentproc
      530                     ,input p-mode
      531                     ,input p-obj-type
      532                     ,input p-obj-code
      533                     ).
      534   end.
      535   else do:
      536      if p-obj-type = 'маг':U then do:
      537       message
      538       "Выберите магазин для копирования ПАРАМЕТРОВ"
      539       view-as alert-box WARNING.
      540         run adm/shops.w ( input parparentproc
      541                          ,input "b-sel"
      542                          ,input-output v-rid-list
      543                          ,no ).
      544        if v-rid-list = "":U then return.
      545        find first buf_shop no-lock where
      546                 recid(buf_shop) = integer(v-rid-list) .
      547        v-from-obj-code = buf_shop.obj-code.
      548      end.
      549      if p-obj-type = 'орг':U then do:
      550         message
      551         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      552         view-as alert-box WARNING.
      553         run adm/sconfs.w (
      554               input parParentProc
      555             , input "b-sel":U
      556             , input no
      557             , input 0
      558             , output v-firm-code
      559             , input-output v-rid-list
      560         ) no-error.
      561         if v-rid-list = "":U then return.
      562       find first buf_sysconf no-lock
      563                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      564       v-from-obj-code = buf_sysconf.host-code.
      565      end.
      566      if p-obj-type = 'скл':U then do:
      567       message
      568       "Выберите склад для копирования ПАРАМЕТРОВ"
      569       view-as alert-box WARNING.
      570         run adm/stores.w ( input parparentproc
      571                           ,input "b-sel"
      572                           ,input-output v-rid-list
      573                           ,input no ).
      574        if v-rid-list = "":U then return.
      575        find first buf_store no-lock where
      576                 recid(buf_store) = integer(v-rid-list) .
      577        v-from-obj-code = buf_store.obj-code.
      578      end.
      579      if p-obj-type = 'БД':U then do:
      580         message
      581         "Выберите БД для копирования ПАРАМЕТРОВ"
      582         view-as alert-box WARNING.
      583         run adm/dbs.w (
      584               input parParentProc
      585             , input 'ПРОСМОТР':U
      586             , output v-rec
      587         ) no-error.
      588         if v-rec = ? then return.
      589       find first buf_db no-lock
      590                         where recid(buf_db) = v-rec.
      591       v-from-obj-code = buf_db.db-num.
      592      end.
      593      if (p-obj-type = 'маг':U
      594      AND p-obj-code = buf_shop.obj-code )
      595      or (p-obj-type = 'скл':U
      596      AND p-obj-code = buf_store.obj-code )
      597      or (p-obj-type = 'орг':U
      598      AND p-obj-code = buf_sysconf.host-code )
      599      or (p-obj-type = 'БД':U
      600      AND p-obj-code = buf_db.db-num )
      601      or (p-obj-type = '':U
      602      AND p-obj-code = 0 )
      603      then do:
      604        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      605        view-as alert-box error .
      606        return error .
      607      end.
      608      run waitfram-show in this-procedure ( input "Ждите..." ).
      609      DO ii = 1 to num-entries(v-attr-code):
      610         for each thbjattr_thbj-attr:
      611           delete thbjattr_thbj-attr.
      612         end.
      613         assign
      614         v-ii = v-ii + 1.
      615         run thbjattr_get-section  in this-procedure (
      616              input  p-obj-type
      617             ,input  v-from-obj-code
      618             ,input  entry(ii, v-attr-code)
      619             ,input '':U
      620             ,input-output table thbjattr_thbj-attr
      621             ,output v-found
      622                                                 ) no-error .
      623         if not error-status:error then do:
      624           run thbjattr_set-section in this-procedure (
      625                                                  input p-obj-type
      626                                                 ,input p-obj-code
      627                                                 ,input entry(ii, v-attr-code)
      628                                                 ,input table thbjattr_thbj-attr ) no-error .
      629           if not error-status:error then
      630           assign
      631           v-ok = v-ok + 1
      632           .
      633         end.
      634      end.
      635      run waitfram-hide in this-procedure .
      636      if v-ii = v-ok then do:
      637         message
      638         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      639                    , v-ok
      640                    , p-obj-type
      641                    , p-obj-code
      642                    , p-obj-type
      643                    , v-from-obj-code
      644                    )
      645         view-as alert-box .
      646      end.
      647      else do:
      648         message
      649         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      650                    , v-ii
      651                    , v-ok
      652                    , p-obj-type
      653                    , p-obj-code
      654                    , p-obj-type
      655                    , v-from-obj-code
      656                    )
      657         view-as alert-box WARNING.
      658      end.
      659   end.
      660   end.
      661   end procedure.
      662   procedure proc-alt-shift-f2:
      663     if not ibs.th.gbl.gbl-var:rcode
      664   then
      665     run gbl\inidebug.p .
      666   end.
      667   procedure proc-alt-shift-f3:
      668     run gbl/prvssinf.p
      669       ( input this-procedure
      670       ) .
      671   end.
      672   define variable v-inform-launched as logical no-undo initial false .
      673   procedure proc-alt-shift-f4:
      674     define variable v-action as character no-undo .
      675     if v-inform-launched = false then do:
      676       assign
      677         v-inform-launched = true
      678       .
      679       run gbl/d-inform.w
      680         (  input self
      681         ,  input this-procedure
      682         , output v-action
      683         ) no-error .
      684       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      685       assign
      686         v-inform-launched = false
      687       .
      688     end.
      689   end.
      690   procedure proc-alt-f1:
      691     run gbl/corrhelp.p
      692       (input this-procedure
      693       ) .
      694   end .
      695   on alt-shift-f2 anywhere do:
      696     run proc-alt-shift-f2.
      697   end.
      698   on alt-shift-f3 anywhere do:
      699     run proc-alt-shift-f3 in this-procedure .
      700   end.
      701   on alt-shift-f4 anywhere do:
      702     run proc-alt-shift-f4 in this-procedure.
      703   end.
      704   on alt-f1 anywhere do:
      705     run proc-alt-f1 in this-procedure .
      706   end.
      707   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   define variable v-waitfram-action01         as character   no-undo .
      709   define variable v-waitfram-action02         as character   no-undo .
      710   define variable v-waitfram-action03         as character   no-undo .
      711   define variable mWaitFramTextBeg            as character   no-undo.
      712   define variable mWaitFramTextEnd            as character   no-undo.
      713   define variable mWaitFramView               as logical     no-undo.
      714   define variable mWaitProcEvent              as logical     no-undo init yes.
      715   define variable mWaitFramInterval           as integer     no-undo init 1 .
      716   define variable mWaitFramStop               as logical     no-undo.
      717   define variable mWaitFramStopUser           as logical     no-undo.
      718   define variable mWaitFramStopTimeOut        as logical     no-undo.
      719   define variable mWaitFramStartProc          as datetime-tz no-undo.
      720   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      721   define button B-WaitFramStop auto-end-key
      722        label "Стоп"
      723        size 10 by 1 tooltip "Остоновить процесс".
      724   define button B-viewProcInfo
      725        label "Информация"
      726        size 15 by 1 tooltip "Информация о процесс".
      727   define frame waitfram
      728     v-waitfram-action01 format "x(72)" no-label skip
      729     v-waitfram-action02 format "x(72)" no-label skip
      730     v-waitfram-action03 format "x(72)" no-label skip
      731     B-viewProcInfo
      732     B-WaitFramStop at row 4 col 30
      733     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      734     .
      735   define new global shared variable mBatchMode as logical no-undo init ?.
      736   define variable mFramBachModHandle as handle no-undo.
      737   mFramBachModHandle = frame waitfram:handle.
      738   define variable mFameOldVis as logical no-undo.
      739   define variable mVisCUrentVin as logical no-undo.
      740   if session:batch-mode
      741   then
      742      mBatchMode = yes.
      743   if mBatchMode = ? then do:
      744     mVisCUrentVin = current-window:visible.
      745     mFameOldVis = mFramBachModHandle:visible.
      746     mFramBachModHandle:visible  = yes.
      747     mBatchMode = mFramBachModHandle:visible ne yes.
      748     mFramBachModHandle:visible = mFameOldVis.
      749     current-window:visible = mVisCUrentVin.
      750   end.
      751    if  log-manager:logfile-name ne ?
      752     then DO:
      753         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      754         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      755         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      756     end.
      757   on choose of B-WaitFramStop in frame waitfram
      758   do:
      759     mWaitFramStop = yes.
      760     mWaitFramStopUser = yes.
      761   end.
      762   function waitfram-check-timeout returns logical():
      763      define variable vtime as int64 no-undo.
      764      if mWaitFramStopTimeOut
      765      then
      766         return yes.
      767      vtime = ( now - mWaitFramStartProc ) / 1000 .
      768      if     mWaitFramTimeOut ne ?
      769         and mWaitFramTimeOut ne 0
      770         and mWaitFramTimeOut lt vtime
      771      then do:
      772         mWaitFramStopTimeOut = yes.
      773      end.
      774      return mWaitFramStopTimeOut.
      775   end.
      776   procedure waitfram-hide :
      777     if not session:batch-mode
      778     then do
      779     on error undo, return error return-value
      780     :
      781       pause 0 before-hide .
      782       if not mBatchMode then
      783         hide frame waitfram .
      784     if     not mWaitFramView
      785        and mWaitProcEvent
      786     then
      787       process events .
      788     end.
      789   end procedure.
      790   procedure waitfram-show :
      791     define input  parameter p-message as character no-undo .
      792     define variable v-left-margin as integer   no-undo .
      793     if not session:batch-mode
      794     then do
      795     on error undo, return error return-value
      796     :
      797       if length(p-message) <= 70 then do:
      798         assign
      799           v-left-margin = integer((70 - length(p-message)) / 2)
      800         .
      801         assign
      802           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      803         .
      804         assign
      805           v-waitfram-action01 = " "
      806           v-waitfram-action02 = " "
      807                                    + fill(" ", v-left-margin)
      808                                    + p-message
      809           v-waitfram-action03 = " "
      810         .
      811       end.
      812       else do:
      813         define variable vRindex1 as integer no-undo.
      814         define variable vRindex2 as integer no-undo.
      815         vRindex1 = r-index(p-message," ",70).
      816         if vRindex1 = 0
      817         then
      818            vRindex1 = 70.
      819         if length(p-message)  <= vRindex1 + 70 then do:
      820           assign
      821             v-waitfram-action01 = " "
      822             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      823             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      824           .
      825         end.
      826         else do:
      827           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      828           if vRindex2 <= vRindex1
      829           then
      830              vRindex2 = vRindex1 + 70.
      831           assign
      832             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      833             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      834             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      835           .
      836         end.
      837       end.
      838       B-viewProcInfo:visible   in frame waitfram = no.
      839       B-viewProcInfo:sensitive in frame waitfram = no.
      840       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      841       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      842       if  (   mWaitFramView
      843          or  mWaitProcEvent)
      844          and not mBatchMode
      845       then
      846          display
      847             v-waitfram-action01 skip
      848             v-waitfram-action02 skip
      849             v-waitfram-action03 skip
      850          with frame waitfram .
      851       if     mWaitFramView
      852          then do:
      853             if     mWaitFramInterval ne ?
      854                and not mBatchMode
      855             then
      856                wait-for go of frame waitfram pause mWaitFramInterval.
      857          end.
      858          else
      859             if     mWaitProcEvent
      860                and not mBatchMode
      861             then
      862                process events .
      863     end.
      864   end procedure.
      865      procedure waitfram-show-this:
      866         define input  parameter iInterval as int64 no-undo.
      867         define variable vtime as int64 no-undo.
      868         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      869         mWaitFramInterval = iInterval.
      870         run waitfram-show (substitute("&1&2 &3&4" ,
      871                                       mWaitFramTextBeg ,
      872                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      873                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      874                                       mWaitFramTextEnd
      875                                      )
      876                           ).
      877      end.
      878      procedure WaitFramRunPause:
      879         define input  parameter iInterval as dec no-undo.
      880         define variable vStart  as datetime-tz no-undo.
      881         define variable vend    as datetime-tz no-undo.
      882         define variable vint as int64 no-undo.
      883         define variable vOk as logical no-undo.
      884         vStart = now.
      885         vend   = vStart.
      886         publish "WaitFramPause" (iInterval,output vOk).
      887         vend   =  now.
      888         vint = vend - vStart.
      889         vint = iInterval - vint / 1000.
      890         if     not mWaitFramStop
      891            and (   vint > 0
      892                 or (    not vOk
      893                     and iInterval eq ?
      894                     )
      895                 )
      896         then
      897            run waitfram-show-this (iInterval).
      898         vend   =  now.
      899         vint = vend - vStart.
      900         vint = iInterval - vint / 1000.
      901         if     not mWaitFramStop
      902            and vint > 0
      903         then do:
      904            run gbl/pause.p (vint * 1000).
      905         end.
      906         if iInterval ne ?
      907         then
      908            publish "WaitFramStop".
      909         waitfram-check-timeout().
      910      end.
      911      procedure WaitFramWaitFor:
      912         define input  parameter iInterval as dec no-undo.
      913         assign
      914            mWaitFramStartProc   = now
      915            mWaitFramStopUser    = no
      916            mWaitFramStopTimeOut = no
      917         .
      918         block-wait:
      919         do while not mWaitFramStop:
      920            run WaitFramRunPause (iInterval).
      921            if  waitfram-check-timeout()
      922            then do:
      923               leave block-wait.
      924            end.
      925         end.
      926         run waitfram-hide.
      927      end.
      928   procedure waitfram-join :
      929     define input  parameter p-line-1  as character no-undo .
      930     define input  parameter p-line-2  as character no-undo .
      931     define input  parameter p-line-3  as character no-undo .
      932     define output parameter p-message as character no-undo .
      933     do
      934     on error undo, return error return-value
      935     :
      936       assign
      937         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      938                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      939                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      940       .
      941     end.
      942   end procedure.
      943   function waitfram-join-function returns character
      944     (input p-line-1 as character
      945     ,input p-line-2 as character
      946     ,input p-line-3 as character
      947     ).
      948     define variable v-message as character no-undo .
      949     run waitfram-join in this-procedure
      950       (input  p-line-1
      951       ,input  p-line-2
      952       ,input  p-line-3
      953       ,output v-message
      954       ) .
      955     return v-message .
      956   end function .
