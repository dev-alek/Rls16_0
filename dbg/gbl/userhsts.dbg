     1333   DEFINE BUTTON b-action
     1334        LABEL "Права"
     1335        SIZE 10 BY 1 TOOLTIP "Права, доступные пользователю на фирме".
     1336   DEFINE BUTTON b-add
     1337        LABEL "&Добавить"
     1338        SIZE 10 BY 1.
