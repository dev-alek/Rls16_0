        1   define input parameter p-mainmenu-handle as handle    no-undo .
        2   define input parameter c-point           as character no-undo .
        3   define input parameter c-title           as character no-undo .
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Интерфейс работы с утилитами".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,c-point,c-title)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      117   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
      118     define variable p-entry   as logical   no-undo .
      119     define variable v-ind as integer   no-undo .
      120     if p-delimiter = "*":U then do:
      121       message
      122         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
      123         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
      124         view-as alert-box error .
      125       return ? .
      126     end.
      127     assign
      128       p-entry = true
      129     .
      130     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
      131       assign
      132         p-entry = false
      133       .
      134       if num-entries( p-list, "*":U ) > 1 then do:
      135         block_check-list:
      136         do v-ind = 1 to num-entries( p-list, p-delimiter )
      137         :
      138           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
      139             assign
      140               p-entry = true
      141             .
      142             leave block_check-list .
      143           end.
      144         end.
      145       end.
      146     end.
      147     return p-entry .
      148   end function .
      149   define new global shared variable g#library  as handle no-undo .
      150   define new global shared variable g#library2 as handle no-undo .
      151   if index (c-point, "%") > 0 then do:
      152     message "Указатель вызова интерфейса работы с утилитами не может содержать знак '%'."
      153     view-as alert-box error.
      154     return error.
      155   end.
      156   define temp-table br-proc no-undo
      157     field proc-index      as integer
      158     field proc-file       as character format "x(15)" label "Процедура"
      159     field proc-name       as character format "x(60)" label "Название"
      160     field c-point         as character
      161     field proc-install    as logical                  label "Автом. инст."
      162     field mainmenu-handle as logical                  label "Указатель меню"
      163     field proc-db-ver     as character format "x(10)" label "Версия БД"
      164     field proc-run-order  as character format "x(10)" label "Порядок запуска"
      165     field proc-client     as character format "x(10)" label "Для клиента"
      166     index i-up            is unique proc-index c-point
      167     index i-name          is primary c-point proc-name
      168     index i-file          proc-index c-point proc-file
      169   .
      170   DEFINE BUTTON b-help
      171        LABEL "Помо&щь"
      172        SIZE 10 BY 1
      173        BGCOLOR 8 .
      174   DEFINE BUTTON b-quit AUTO-GO
      175        LABEL "&Выход "
      176        SIZE 10 BY 1
      177        BGCOLOR 8 .
      178   DEFINE BUTTON b-sel
      179        LABEL "_ В&ыполнить"
      180        SIZE 12 BY 1.
      181   DEFINE BUTTON i-exit
      182        IMAGE-UP FILE "cmp/i-run.bmp":U
      183        IMAGE-DOWN FILE "cmp/i-run.bmp":U
      184        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
      185        LABEL ""
      186        SIZE 2.5 BY .75.
      187   DEFINE VARIABLE find-file AS CHARACTER FORMAT "x(30)":U
      188        VIEW-AS FILL-IN
      189        SIZE 30.5 BY 1 NO-UNDO.
      190   DEFINE VARIABLE find-name AS CHARACTER FORMAT "x(60)":U
      191        VIEW-AS FILL-IN
      192        SIZE 60.5 BY 1 NO-UNDO.
      193   DEFINE QUERY br-proc FOR
      194         br-proc SCROLLING.
      195   DEFINE BROWSE br-proc
      196     QUERY br-proc DISPLAY
      197         proc-name
      198         proc-file  format "x(30)"
      199         proc-install
      200         proc-db-ver
      201         proc-run-order
      202       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.75 BY 15.92.
      203   DEFINE FRAME d-menubrsw
      204        br-proc AT ROW 2.63 COL 1
      205        b-quit AT ROW 1 COL 1
      206        b-sel AT ROW 1 COL 11
      207        i-exit AT ROW 1.13 COL 11 WIDGET-ID 4
      208        b-help AT ROW 1 COL 70.5
      209        find-name AT ROW 20.71 COL 1.5 NO-LABEL
      210        find-file AT ROW 20.71 COL 60.25 COLON-ALIGNED NO-LABEL
      211        "названию" VIEW-AS TEXT
      212             SIZE 8.5 BY 1 AT ROW 19.71 COL 1.5
      213             FGCOLOR 4
      214        "процедуре" VIEW-AS TEXT
      215             SIZE 9.5 BY 1 AT ROW 19.71 COL 62.25
      216             FGCOLOR 4
      217        "ПОИСК ПО:" VIEW-AS TEXT
      218             SIZE 9.5 BY 1 AT ROW 18.71 COL 1.5
      219             BGCOLOR 3 FGCOLOR 15
      220        SPACE(69.73) SKIP(2.74)
      221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      223            TITLE "Утилиты"
      224            DEFAULT-BUTTON b-quit.
      225   ASSIGN
      226          FRAME d-menubrsw:SCROLLABLE       = FALSE
      227          FRAME d-menubrsw:HIDDEN           = TRUE.
      228   ON WINDOW-CLOSE OF FRAME d-menubrsw
      229   DO:
      230     APPLY "END-ERROR":U TO SELF.
      231   END.
      232   ON CHOOSE OF b-sel IN FRAME d-menubrsw
      233   DO:
      234     do
      235     on stop  undo, return no-apply
      236     on error undo, return no-apply
      237     :
      238        run trg/userlog.p (
      239                   input 'run-proc'
      240                   , input ('Запущено выполнение процедуры: "'
      241                   + br-proc.proc-name +  '"' + chr(3) + br-proc.proc-file )
      242                   , input ?
      243                   , input ?
      244                   , input "") no-error.
      245       if br-proc.proc-install then do:
      246         if br-proc.mainmenu-handle then do:
      247           run value (br-proc.proc-file)
      248             (input  p-mainmenu-handle
      249             ,input  false
      250             ) no-error .
      251         end.
      252         else do:
      253           run value (br-proc.proc-file)
      254             (input false
      255             ) no-error .
      256         end.
      257       end.
      258       else do:
      259         if br-proc.mainmenu-handle then do:
      260           run value (br-proc.proc-file)
      261             (input  p-mainmenu-handle
      262             ) no-error .
      263         end.
      264         else do:
      265           run value (br-proc.proc-file) no-error .
      266         end.
      267       end.
      268     end.
      269     run trg/userlog.p (
      270                   input 'run-proc'
      271                   , input ('Завершено выполнение процедуры' + (if error-status:error then ' с ошибкой "' else ' без ошибок "')
      272                   + br-proc.proc-name +  '"' + chr(3) + br-proc.proc-file )
      273                   , input ?
      274                   , input ?
      275                   , input "") no-error.
      276     apply "ENTRY":U to br-proc in frame d-menubrsw.
      277     return no-apply.
      278   END.
      279   ON MOUSE-SELECT-DBLCLICK OF br-proc IN FRAME d-menubrsw
      280   DO:
      281     apply "CHOOSE":U to b-sel in frame d-menubrsw.
      282     apply "ENTRY":U to br-proc in frame d-menubrsw.
      283     return no-apply.
      284   END.
      285   ON RETURN OF br-proc IN FRAME d-menubrsw
      286   DO:
      287     apply "CHOOSE":U to b-sel in frame d-menubrsw.
      288     apply "ENTRY":U to br-proc in frame d-menubrsw.
      289     return no-apply.
      290   END.
      291   ON MOUSE-SELECT-DBLCLICK OF find-file IN FRAME d-menubrsw
      292   DO:
      293     DEFINE VARIABLE rr AS RECID NO-UNDO.
      294     DEFINE BUFFER buf_proc FOR br-proc.
      295     DO ON STOP  UNDO, RETURN NO-APPLY
      296        ON ERROR UNDO, RETURN NO-APPLY :
      297       ASSIGN find-file.
      298       ASSIGN rr = ( IF AVAILABLE br-proc THEN RECID( br-proc ) ELSE ? ).
      299       FIND FIRST buf_proc WHERE RECID( buf_proc ) = rr NO-ERROR.
      300       IF NOT AVAILABLE buf_proc THEN DO: FIND FIRST buf_proc WHERE buf_proc.c-point = c-point. END.
      301       FIND NEXT buf_proc WHERE
      302                 buf_proc.c-point   =      c-point   AND
      303                 buf_proc.proc-file BEGINS find-file NO-ERROR.
      304       IF NOT AVAILABLE buf_proc THEN DO:
      305         FIND FIRST buf_proc WHERE
      306                    buf_proc.c-point   =      c-point   AND
      307                    buf_proc.proc-file BEGINS find-file NO-ERROR.
      308         IF NOT AVAILABLE buf_proc THEN DO:
      309           MESSAGE "Утилита" '"' + find-file + '"' "не найдена!" VIEW-AS ALERT-BOX INFORMATION.
      310           APPLY "ENTRY":U TO find-file IN FRAME d-menubrsw.
      311           RETURN NO-APPLY.
      312         END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      313       END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      314       REPOSITION br-proc TO RECID rr NO-ERROR.
      315       IF ERROR-STATUS :ERROR THEN DO: REPOSITION br-proc TO ROW 1. END.
      316     END.
      317     APPLY "ENTRY":U TO br-proc IN FRAME d-menubrsw.
      318     RETURN NO-APPLY.
      319   END.
      320   ON RETURN OF find-file IN FRAME d-menubrsw
      321   DO:
      322     DEFINE VARIABLE rr AS RECID NO-UNDO.
      323     DEFINE BUFFER buf_proc FOR br-proc.
      324     DO ON STOP  UNDO, RETURN NO-APPLY
      325        ON ERROR UNDO, RETURN NO-APPLY :
      326       ASSIGN find-file.
      327       ASSIGN rr = ( IF AVAILABLE br-proc THEN RECID( br-proc ) ELSE ? ).
      328       FIND FIRST buf_proc WHERE RECID( buf_proc ) = rr NO-ERROR.
      329       IF NOT AVAILABLE buf_proc THEN DO: FIND FIRST buf_proc WHERE buf_proc.c-point = c-point. END.
      330       FIND NEXT buf_proc WHERE
      331                 buf_proc.c-point   =      c-point   AND
      332                 buf_proc.proc-file BEGINS find-file NO-ERROR.
      333       IF NOT AVAILABLE buf_proc THEN DO:
      334         FIND FIRST buf_proc WHERE
      335                    buf_proc.c-point   =      c-point   AND
      336                    buf_proc.proc-file BEGINS find-file NO-ERROR.
      337         IF NOT AVAILABLE buf_proc THEN DO:
      338           MESSAGE "Утилита" '"' + find-file + '"' "не найдена!" VIEW-AS ALERT-BOX INFORMATION.
      339           APPLY "ENTRY":U TO find-file IN FRAME d-menubrsw.
      340           RETURN NO-APPLY.
      341         END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      342       END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      343       REPOSITION br-proc TO RECID rr NO-ERROR.
      344       IF ERROR-STATUS :ERROR THEN DO: REPOSITION br-proc TO ROW 1. END.
      345     END.
      346     APPLY "ENTRY":U TO br-proc IN FRAME d-menubrsw.
      347     RETURN NO-APPLY.
      348   END.
      349   ON MOUSE-SELECT-DBLCLICK OF find-name IN FRAME d-menubrsw
      350   DO:
      351     DEFINE VARIABLE rr AS RECID NO-UNDO.
      352     DEFINE BUFFER buf_proc FOR br-proc.
      353     DO ON STOP  UNDO, RETURN NO-APPLY
      354        ON ERROR UNDO, RETURN NO-APPLY :
      355       ASSIGN find-name.
      356       ASSIGN rr = ( IF AVAILABLE br-proc THEN RECID( br-proc ) ELSE ? ).
      357       FIND FIRST buf_proc WHERE RECID( buf_proc ) = rr NO-ERROR.
      358       IF NOT AVAILABLE buf_proc THEN DO: FIND FIRST buf_proc WHERE buf_proc.c-point = c-point. END.
      359       FIND NEXT buf_proc WHERE
      360                 buf_proc.c-point   =      c-point   AND
      361                 buf_proc.proc-name BEGINS find-name NO-ERROR.
      362       IF NOT AVAILABLE buf_proc THEN DO:
      363         FIND FIRST buf_proc WHERE
      364                    buf_proc.c-point   =      c-point   AND
      365                    buf_proc.proc-name BEGINS find-name NO-ERROR.
      366         IF NOT AVAILABLE buf_proc THEN DO:
      367           MESSAGE
      368             "Утилита с названием"   SKIP
      369             '  "' + find-name + '"' SKIP
      370             "не найдена!"
      371           VIEW-AS ALERT-BOX INFORMATION.
      372           APPLY "ENTRY":U TO find-name IN FRAME d-menubrsw.
      373           RETURN NO-APPLY.
      374         END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      375       END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      376       REPOSITION br-proc TO RECID rr NO-ERROR.
      377       IF ERROR-STATUS :ERROR THEN DO: REPOSITION br-proc TO ROW 1. END.
      378     END.
      379     APPLY "ENTRY":U TO br-proc IN FRAME d-menubrsw.
      380     RETURN NO-APPLY.
      381   END.
      382   ON RETURN OF find-name IN FRAME d-menubrsw
      383   DO:
      384     DEFINE VARIABLE rr AS RECID NO-UNDO.
      385     DEFINE BUFFER buf_proc FOR br-proc.
      386     DO ON STOP  UNDO, RETURN NO-APPLY
      387        ON ERROR UNDO, RETURN NO-APPLY :
      388       ASSIGN find-name.
      389       ASSIGN rr = ( IF AVAILABLE br-proc THEN RECID( br-proc ) ELSE ? ).
      390       FIND FIRST buf_proc WHERE RECID( buf_proc ) = rr NO-ERROR.
      391       IF NOT AVAILABLE buf_proc THEN DO: FIND FIRST buf_proc WHERE buf_proc.c-point = c-point. END.
      392       FIND NEXT buf_proc WHERE
      393                 buf_proc.c-point   =      c-point   AND
      394                 buf_proc.proc-name BEGINS find-name NO-ERROR.
      395       IF NOT AVAILABLE buf_proc THEN DO:
      396         FIND FIRST buf_proc WHERE
      397                    buf_proc.c-point   =      c-point   AND
      398                    buf_proc.proc-name BEGINS find-name NO-ERROR.
      399         IF NOT AVAILABLE buf_proc THEN DO:
      400           MESSAGE
      401             "Утилита с названием"   SKIP
      402             '  "' + find-name + '"' SKIP
      403             "не найдена!"
      404           VIEW-AS ALERT-BOX INFORMATION.
      405           APPLY "ENTRY":U TO find-name IN FRAME d-menubrsw.
      406           RETURN NO-APPLY.
      407         END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      408       END.                      ELSE DO: ASSIGN rr = RECID( buf_proc ). END.
      409       REPOSITION br-proc TO RECID rr NO-ERROR.
      410       IF ERROR-STATUS :ERROR THEN DO: REPOSITION br-proc TO ROW 1. END.
      411     END.
      412     APPLY "ENTRY":U TO br-proc IN FRAME d-menubrsw.
      413     RETURN NO-APPLY.
      414   END.
      415   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-menubrsw:PARENT eq ?
      416   THEN FRAME d-menubrsw:PARENT = ACTIVE-WINDOW.
      417   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   on help of frame d-menubrsw
      419   do:
      420     run gbl/app_help.p
      421       (input this-procedure :file-name
      422       ,input ''
      423       ,input ?
      424       ) no-error.
      425     if error-status :error then do:
      426       message
      427         "Ошибка при вызове помощи"
      428         error-status :get-message(1)
      429         view-as alert-box .
      430     end.
      431   end.
      432   run minbtn-set in this-procedure .
      433   on choose of b-help in frame d-menubrsw
      434   do:
      435     apply "help":u to frame d-menubrsw .
      436   end.
      437   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   procedure minbtn-set :
      439       do
      440           on error undo, return error return-value
      441           :
      442           define variable ii              as integer       no-undo .
      443           define variable fh              as widget-handle no-undo .
      444           define variable hh              as widget-handle no-undo .
      445           define variable v-h             as handle        extent 4 no-undo .
      446           define variable v-name-button   as character     no-undo .
      447           define variable v-help-old-x    as decimal       no-undo .
      448           define variable v-help-old-y    as decimal       no-undo .
      449           define variable v-help-old-size as decimal       no-undo .
      450           define variable v-frame-width   as decimal       no-undo .
      451           define variable jj              as integer       no-undo .
      452           do
      453               on error undo, return error
      454               :
      455               assign
      456                   v-frame-width = frame d-menubrsw:width - 0.3
      457                   fh            = frame d-menubrsw:first-child
      458                   hh            = fh:first-child
      459                   ii            = 1
      460                   .
      461               do while valid-handle(hh):
      462                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      463                   do:
      464                       case lc(hh:name) :
      465                           when "b-help" then
      466                               do:
      467                                   hh:load-image-up("cmp/b-help.bmp":u) .
      468                                   hh:load-image-down("cmp/b-help.bmp":u) .
      469                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      470                                   hh:TOOLTIP = "Помощь" .
      471                                   v-help-old-x = hh:column .
      472                                   v-help-old-y = hh:row    .
      473                                   v-help-old-size = hh:width .
      474                                   hh:width-chars = 2.5 .
      475                               end.
      476                           when "b-print" then
      477                               do:
      478                                   hh:load-image("cmp/b-print.bmp":u) .
      479                                   hh:TOOLTIP = "Печать" .
      480                                   v-h[ii] = hh:handle .
      481                                   ii = ii + 1 .
      482                                   hh:width-chars = 3 .
      483                               end.
      484                           when "b-history" or
      485                           when "b-hist" then
      486                               do:
      487                                   hh:load-image("cmp/b-hist.bmp":u) .
      488                                   hh:TOOLTIP = "История" .
      489                                   v-h[ii] = hh:handle .
      490                                   ii = ii + 1 .
      491                                   hh:width-chars = 3 .
      492                               end.
      493                           when "b-sch" then
      494                               do:
      495                                   hh:load-image("cmp/b-sch.bmp":u) .
      496                                   hh:TOOLTIP = "Установка Фильтра" .
      497                                   v-h[ii] = hh:handle .
      498                                   ii = ii + 1 .
      499                                   hh:width-chars = 3 .
      500                               end.
      501                           when "b-hist-user" then
      502                               do:
      503                                   hh:load-image("cmp/b-hist.bmp":u) .
      504                                   hh:TOOLTIP = "История пользователя" .
      505                                   ii = ii + 1 .
      506                               end.
      507                       end case.
      508                   end.
      509                   hh = hh:next-sibling.
      510               end.
      511               b-help:column = v-frame-width - b-help:width-chars.
      512               jj = 0.
      513               repeat ii = 4 to 1 by -1 :
      514                   if valid-handle (v-h[ii] ) then
      515                   do:
      516                       jj  = jj + 1 .
      517                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      518                       v-h[ii]:row    = v-help-old-y .
      519                   end.
      520               end.
      521           end.
      522       end.
      523   end procedure.
      524   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      525   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      526   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      527   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      528   define variable v-diasize-current-frame-width  as decimal   no-undo .
      529   define variable v-diasize-current-frame-height as decimal   no-undo .
      530   define variable v-diasize-change-size          as logical   no-undo .
      531   define variable v-diasize-resize-button        as handle    no-undo .
      532   define variable v-diasize-wndmax               as logical   no-undo .
      533   define variable v-diasize-wndstore             as logical   no-undo .
      534   define variable v-diasize-proc-name            as character no-undo .
      535   define variable v-diasize-browse-handle        as handle    no-undo .
      536   define variable v-diasize-browse-number        as integer   no-undo .
      537   define variable v-diasize-need-full-display    as logical   no-undo init false .
      538   define temp-table temp-diasize-handle no-undo
      539     field handle-value  as handle
      540     field save-position as decimal
      541     index xpk is primary unique handle-value
      542     .
      543   define temp-table temp-browse-handle no-undo
      544     field browse-type   as character
      545     field browse-number as integer
      546     field browse-handle as handle
      547     field original-size as decimal
      548     index xpk is primary unique browse-type browse-number
      549     index xie browse-type browse-handle
      550   .
      551   procedure diasize_change-height :
      552     define input  parameter p-change-value  as decimal   no-undo .
      553     define input  parameter p-move-resize   as logical   no-undo .
      554     define variable v-field-group-handle    as handle    no-undo .
      555     define variable v-object-handle         as handle    no-undo .
      556     define variable v-frame-height          as decimal   no-undo .
      557     define variable v-frame-virtual-height  as decimal   no-undo .
      558     define variable v-browse-height         as decimal   no-undo .
      559     define variable v-window-height         as decimal   no-undo .
      560     define variable v-window-virtual-height as decimal   no-undo .
      561     define variable v-change-sign           as integer   no-undo .
      562     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      563     define buffer buf_temp-browse-handle  for temp-browse-handle .
      564     if p-change-value > 0
      565     then do:
      566       if frame d-menubrsw :height + p-change-value
      567           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      568       then do:
      569         assign
      570           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      571                           - (frame d-menubrsw :height-chars)
      572         .
      573         if p-change-value <= 0
      574         then do:
      575           run diasize_position-resize-button in this-procedure .
      576           return .
      577         end.
      578       end.
      579     end.
      580     if p-change-value < 0
      581     then do:
      582       if frame d-menubrsw :height + p-change-value < v-diasize-orig-frame-height
      583       then do:
      584         assign
      585           p-change-value = v-diasize-orig-frame-height
      586                          - (frame d-menubrsw :height-chars)
      587         .
      588         if p-change-value >= 0
      589         then do:
      590           run diasize_position-resize-button in this-procedure .
      591           return .
      592         end.
      593       end.
      594     end.
      595     if p-change-value >= 0
      596     then do:
      597       assign
      598         v-change-sign = 1
      599       .
      600     end.
      601     else do:
      602       assign
      603         v-change-sign = -1
      604       .
      605     end.
      606     assign
      607       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      608     .
      609     if p-change-value = 0
      610     then do:
      611       run diasize_position-resize-button in this-procedure .
      612       return .
      613     end.
      614     move_block:
      615     do
      616     on error undo move_block, retry move_block
      617     :
      618       if retry
      619       then do:
      620         do
      621         on error undo move_block, leave move_block
      622         :
      623           if p-change-value > 0
      624           then do:
      625             for each buf_temp-diasize-handle
      626             on error undo, next
      627             :
      628               assign
      629                 v-object-handle = buf_temp-diasize-handle.handle-value
      630               .
      631               if v-object-handle <> v-diasize-resize-button
      632               then do:
      633                 assign
      634                   v-object-handle :row = buf_temp-diasize-handle.save-position
      635                 .
      636               end.
      637             end.
      638             assign
      639               v-diasize-browse-handle :height = v-browse-height
      640             .
      641             for each buf_temp-browse-handle
      642               where buf_temp-browse-handle.browse-type = 'height':u
      643             on error undo, next
      644             :
      645               assign
      646                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      647               .
      648             end.
      649             assign
      650               frame d-menubrsw :height = v-frame-height
      651             .
      652             if frame d-menubrsw :scrollable = true
      653             then do:
      654               assign
      655                 frame d-menubrsw :virtual-height = v-frame-virtual-height
      656               .
      657             end.
      658             run diasize_position-resize-button in this-procedure .
      659           end.
      660           else do:
      661             if frame d-menubrsw :scrollable = true
      662             then do:
      663               assign
      664                 frame d-menubrsw :virtual-height = v-frame-virtual-height
      665               .
      666             end.
      667             assign
      668               frame d-menubrsw :height = v-frame-height
      669             .
      670             assign
      671               v-diasize-browse-handle :height = v-browse-height
      672             .
      673             for each buf_temp-browse-handle
      674               where buf_temp-browse-handle.browse-type = 'height':u
      675             on error undo, next
      676             :
      677               assign
      678                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      679               .
      680             end.
      681             for each buf_temp-diasize-handle
      682             on error undo, next
      683             :
      684               assign
      685                 v-object-handle = buf_temp-diasize-handle.handle-value
      686               .
      687               if v-object-handle <> v-diasize-resize-button
      688               then do:
      689                 assign
      690                   v-object-handle :row = buf_temp-diasize-handle.save-position
      691                 .
      692               end.
      693             end.
      694             run diasize_position-resize-button in this-procedure .
      695           end.
      696           assign
      697             v-diasize-change-size = false
      698           .
      699           leave move_block .
      700         end.
      701       end.
      702       assign
      703         v-diasize-need-full-display = true
      704       .
      705       if v-diasize-change-size = false
      706       then do:
      707         assign
      708           v-diasize-change-size = true
      709         .
      710       end.
      711       else do:
      712         return .
      713       end.
      714       assign
      715         v-frame-height = frame d-menubrsw :height
      716         v-frame-virtual-height = frame d-menubrsw :virtual-height
      717         v-browse-height = v-diasize-browse-handle :height
      718       .
      719       for each buf_temp-browse-handle
      720         where buf_temp-browse-handle.browse-type = 'height':u
      721       :
      722         assign
      723           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      724         .
      725       end.
      726       for each buf_temp-diasize-handle
      727       :
      728         delete buf_temp-diasize-handle .
      729       end.
      730       assign
      731         v-field-group-handle = frame d-menubrsw :first-child
      732       .
      733       do while valid-handle(v-field-group-handle)
      734       :
      735         assign
      736           v-object-handle = v-field-group-handle :first-child
      737         .
      738         do while valid-handle(v-object-handle)
      739         :
      740           if  v-object-handle <> v-diasize-browse-handle :handle
      741           and can-query(v-object-handle, "row")
      742           and can-query(v-object-handle, "height")
      743           and ( v-object-handle :row > v-diasize-browse-handle :row )
      744           then do:
      745             find first buf_temp-browse-handle
      746               where buf_temp-browse-handle.browse-type   = 'height':u
      747                 and buf_temp-browse-handle.browse-handle = v-object-handle
      748               no-error .
      749             if available buf_temp-browse-handle
      750             then do:
      751             end.
      752             else do:
      753               create buf_temp-diasize-handle .
      754               assign
      755                 buf_temp-diasize-handle.handle-value  = v-object-handle
      756                 buf_temp-diasize-handle.save-position = v-object-handle :row
      757               .
      758             end.
      759           end.
      760           assign
      761             v-object-handle = v-object-handle :next-sibling
      762           .
      763         end.
      764         assign
      765           v-field-group-handle = v-field-group-handle :next-sibling
      766         .
      767       end.
      768       do with frame d-menubrsw
      769       :
      770         hide v-diasize-resize-button .
      771         assign
      772           v-diasize-resize-button :row    = 1
      773           v-diasize-resize-button :column = 1
      774         .
      775       end.
      776       if p-change-value > 0
      777       then do:
      778         if frame d-menubrsw :scrollable = true
      779         then do:
      780           assign
      781             frame d-menubrsw :virtual-height = frame d-menubrsw :virtual-height + p-change-value
      782             no-error .
      783           if error-status :error
      784           or error-status :get-message(1) <> ""
      785           then do:
      786             undo move_block, retry move_block .
      787           end.
      788         end.
      789         assign
      790           frame d-menubrsw :height = frame d-menubrsw :height + p-change-value
      791           no-error .
      792         if error-status :error
      793         or error-status :get-message(1) <> ""
      794         then do:
      795           undo move_block, retry move_block .
      796         end.
      797         assign
      798           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      799           no-error .
      800         if error-status :error
      801         or error-status :get-message(1) <> ""
      802         then do:
      803           undo move_block, retry move_block .
      804         end.
      805         for each buf_temp-browse-handle
      806           where buf_temp-browse-handle.browse-type = 'height':u
      807         on error undo move_block, retry move_block
      808         :
      809           assign
      810             buf_temp-browse-handle.browse-handle :height
      811               = buf_temp-browse-handle.browse-handle :height + p-change-value
      812             no-error .
      813           if error-status :error
      814           or error-status :get-message(1) <> ""
      815           then do:
      816             undo move_block, retry move_block .
      817           end.
      818         end.
      819         for each buf_temp-diasize-handle
      820         on error undo move_block, retry move_block
      821         :
      822           assign
      823             v-object-handle = buf_temp-diasize-handle.handle-value
      824           .
      825           if v-object-handle <> v-diasize-resize-button
      826           then do:
      827             assign
      828               v-object-handle :row = v-object-handle :row + p-change-value
      829               no-error .
      830             if error-status :error
      831             or error-status :get-message(1) <> ""
      832             then do:
      833               undo move_block, retry move_block .
      834             end.
      835           end.
      836         end.
      837       end.
      838       else do:
      839         for each buf_temp-diasize-handle
      840         on error undo move_block, retry move_block
      841         :
      842           assign
      843             v-object-handle = buf_temp-diasize-handle.handle-value
      844           .
      845           if v-object-handle <> v-diasize-resize-button
      846           then do:
      847             assign
      848               v-object-handle :row = v-object-handle :row + p-change-value
      849               no-error .
      850             if error-status :error
      851             or error-status :get-message(1) <> ""
      852             then do:
      853               undo move_block, retry move_block .
      854             end.
      855           end.
      856         end.
      857         assign
      858           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      859           no-error .
      860         if error-status :error
      861         or error-status :get-message(1) <> ""
      862         then do:
      863           undo move_block, retry move_block .
      864         end.
      865         for each buf_temp-browse-handle
      866           where buf_temp-browse-handle.browse-type = 'height':u
      867         on error undo move_block, retry move_block
      868         :
      869           assign
      870             buf_temp-browse-handle.browse-handle :height
      871               = buf_temp-browse-handle.browse-handle :height + p-change-value
      872             no-error .
      873           if error-status :error
      874           or error-status :get-message(1) <> ""
      875           then do:
      876             undo move_block, retry move_block .
      877           end.
      878         end.
      879         assign
      880           frame d-menubrsw :height = frame d-menubrsw :height + p-change-value
      881           no-error .
      882         if error-status :error
      883         or error-status :get-message(1) <> ""
      884         then do:
      885           undo move_block, retry move_block .
      886         end.
      887         if frame d-menubrsw :scrollable = true
      888         then do:
      889           assign
      890             frame d-menubrsw :virtual-height = frame d-menubrsw :virtual-height + p-change-value
      891             no-error .
      892           if error-status :error
      893           or error-status :get-message(1) <> ""
      894           then do:
      895             undo move_block, retry move_block .
      896           end.
      897         end.
      898       end.
      899       if p-move-resize = true
      900       then do:
      901         run diasize_position-resize-button in this-procedure .
      902       end.
      903       if v-diasize-wndstore = true
      904       then do:
      905         if connected("ub") = true
      906         then do:
      907           define variable v-cntxt-db-num        as integer   no-undo .
      908           define variable v-cntxt-userid        as character no-undo .
      909           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      910                                             , OUTPUT v-cntxt-userid
      911                                             ) .
      912           run gbl/wndsizew.p
      913             (input  v-cntxt-db-num
      914             ,input  v-cntxt-userid
      915             ,input  v-diasize-proc-name
      916             ,input  'height':u
      917             ,input  string(frame d-menubrsw :height - v-diasize-orig-frame-height)
      918             ) .
      919         end.
      920       end.
      921     end.
      922     assign
      923       v-diasize-change-size = false
      924     .
      925   end procedure.
      926   procedure diasize_set-height :
      927     define input  parameter p-new-height  as decimal   no-undo .
      928     define input  parameter p-move-resize as logical   no-undo .
      929     do
      930     on error undo, return error return-value
      931     :
      932       run diasize_change-height in this-procedure
      933         (input  (p-new-height - frame d-menubrsw :height)
      934         ,input  p-move-resize
      935         ) .
      936     end.
      937   end procedure.
      938   procedure diasize_change-width :
      939     define input  parameter p-change-value as decimal   no-undo .
      940     define input  parameter p-move-resize  as logical   no-undo .
      941     define variable v-field-group-handle   as handle    no-undo .
      942     define variable v-object-handle        as handle    no-undo .
      943     define variable v-frame-width          as decimal   no-undo .
      944     define variable v-frame-virtual-width  as decimal   no-undo .
      945     define variable v-browse-width         as decimal   no-undo .
      946     define variable v-window-width         as decimal   no-undo .
      947     define variable v-window-virtual-width as decimal   no-undo .
      948     define variable v-change-sign          as integer   no-undo .
      949     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      950     define buffer buf_temp-browse-handle  for temp-browse-handle .
      951     if p-change-value > 0
      952     then do:
      953       if frame d-menubrsw :width + p-change-value >
      954           session :width-chars
      955       then do:
      956         assign
      957           p-change-value = session :width-chars - frame d-menubrsw :width
      958         .
      959         if p-change-value <= 0
      960         then do:
      961           run diasize_position-resize-button in this-procedure .
      962           return .
      963         end.
      964       end.
      965     end.
      966     if p-change-value < 0
      967     then do:
      968       if frame d-menubrsw :width + p-change-value < v-diasize-orig-frame-width
      969       then do:
      970         assign
      971           p-change-value = v-diasize-orig-frame-width
      972                          - frame d-menubrsw :width
      973         .
      974         if p-change-value >= 0
      975         then do:
      976           run diasize_position-resize-button in this-procedure .
      977           return .
      978         end.
      979       end.
      980     end.
      981     if p-change-value >= 0
      982     then do:
      983       assign
      984         v-change-sign = 1
      985       .
      986     end.
      987     else do:
      988       assign
      989         v-change-sign = -1
      990       .
      991     end.
      992     assign
      993       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      994     .
      995     if p-change-value = 0
      996     then do:
      997       run diasize_position-resize-button in this-procedure .
      998       return .
      999     end.
     1000     move_block:
     1001     do
     1002     on error undo move_block, leave move_block
     1003     :
     1004       if retry
     1005       then do:
     1006         do
     1007         on error undo move_block, leave move_block
     1008         :
     1009           if p-change-value > 0
     1010           then do:
     1011             for each buf_temp-diasize-handle
     1012             on error undo, next
     1013             :
     1014               assign
     1015                 v-object-handle = buf_temp-diasize-handle.handle-value
     1016               .
     1017               if v-object-handle <> v-diasize-resize-button
     1018               then do:
     1019                 assign
     1020                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1021                 .
     1022               end.
     1023             end.
     1024             assign
     1025               v-diasize-browse-handle :width = v-browse-width
     1026             .
     1027             for each buf_temp-browse-handle
     1028               where buf_temp-browse-handle.browse-type = 'width':u
     1029             on error undo, next
     1030             :
     1031               assign
     1032                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1033               .
     1034             end.
     1035             assign
     1036               frame d-menubrsw :width = v-frame-width
     1037             .
     1038             if frame d-menubrsw :scrollable = true
     1039             then do:
     1040               assign
     1041                 frame d-menubrsw :virtual-width = v-frame-virtual-width
     1042               .
     1043             end.
     1044             run diasize_position-resize-button in this-procedure .
     1045           end.
     1046           else do:
     1047             if frame d-menubrsw :scrollable = true
     1048             then do:
     1049               assign
     1050                 frame d-menubrsw :virtual-width = v-frame-virtual-width
     1051               .
     1052             end.
     1053             assign
     1054               frame d-menubrsw :width = v-frame-width
     1055             .
     1056             for each buf_temp-browse-handle
     1057               where buf_temp-browse-handle.browse-type = 'width':u
     1058             on error undo, next
     1059             :
     1060               assign
     1061                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1062               .
     1063             end.
     1064             assign
     1065               v-diasize-browse-handle :width = v-browse-width
     1066             .
     1067             for each buf_temp-diasize-handle
     1068             on error undo, next
     1069             :
     1070               assign
     1071                 v-object-handle = buf_temp-diasize-handle.handle-value
     1072               .
     1073               if v-object-handle <> v-diasize-resize-button
     1074               then do:
     1075                 assign
     1076                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1077                 .
     1078               end.
     1079             end.
     1080             run diasize_position-resize-button in this-procedure .
     1081           end.
     1082           assign
     1083             v-diasize-change-size = false
     1084           .
     1085           leave move_block .
     1086         end.
     1087       end.
     1088       assign
     1089         v-diasize-need-full-display = true
     1090       .
     1091       if v-diasize-change-size = false
     1092       then do:
     1093         assign
     1094           v-diasize-change-size = true
     1095         .
     1096       end.
     1097       else do:
     1098         return .
     1099       end.
     1100       assign
     1101         v-frame-width = frame d-menubrsw :width
     1102         v-frame-virtual-width = frame d-menubrsw :virtual-width
     1103         v-browse-width = v-diasize-browse-handle :width
     1104       .
     1105       for each buf_temp-browse-handle
     1106         where buf_temp-browse-handle.browse-type = 'width':u
     1107       :
     1108         assign
     1109           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1110         .
     1111       end.
     1112       for each buf_temp-diasize-handle
     1113       :
     1114         delete buf_temp-diasize-handle .
     1115       end.
     1116       assign
     1117         v-field-group-handle = frame d-menubrsw :first-child
     1118       .
     1119       do while valid-handle(v-field-group-handle)
     1120       :
     1121         assign
     1122           v-object-handle = v-field-group-handle :first-child
     1123         .
     1124         do while valid-handle(v-object-handle)
     1125         :
     1126           if  v-object-handle <> v-diasize-browse-handle :handle
     1127           and v-object-handle <> v-diasize-resize-button
     1128           and can-query(v-object-handle, "row")
     1129           and can-query(v-object-handle, "height")
     1130           and ( v-object-handle :col + v-object-handle :width
     1131                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1132               )
     1133           then do:
     1134             find first buf_temp-browse-handle
     1135               where buf_temp-browse-handle.browse-type   = 'width':u
     1136                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1137               no-error .
     1138             if available buf_temp-browse-handle
     1139             then do:
     1140             end.
     1141             else do:
     1142               create buf_temp-diasize-handle .
     1143               assign
     1144                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1145                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1146               .
     1147             end.
     1148           end.
     1149           assign
     1150             v-object-handle = v-object-handle :next-sibling
     1151           .
     1152         end.
     1153         assign
     1154           v-field-group-handle = v-field-group-handle :next-sibling
     1155         .
     1156       end.
     1157       do with frame d-menubrsw
     1158       :
     1159         hide v-diasize-resize-button .
     1160         v-diasize-resize-button :row = 1.
     1161         v-diasize-resize-button :column = 1.
     1162       end.
     1163       if p-change-value > 0
     1164       then do:
     1165         if frame d-menubrsw :scrollable = true
     1166         then do:
     1167           assign
     1168             frame d-menubrsw :virtual-width = frame d-menubrsw :virtual-width + p-change-value
     1169             no-error .
     1170           if error-status :error
     1171           or error-status :get-message(1) <> ""
     1172           then do:
     1173             undo move_block, retry move_block.
     1174           end.
     1175         end.
     1176         assign
     1177           frame d-menubrsw :width = v-frame-width + p-change-value
     1178           no-error .
     1179         if error-status :error
     1180         or error-status :get-message(1) <> ""
     1181         then do:
     1182           undo move_block, retry move_block.
     1183         end.
     1184         assign
     1185           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1186         no-error .
     1187         if error-status :error
     1188         or error-status :get-message(1) <> ""
     1189         then do:
     1190           undo move_block, retry move_block.
     1191         end.
     1192         for each buf_temp-browse-handle
     1193           where buf_temp-browse-handle.browse-type = 'width':u
     1194         on error undo move_block, retry move_block
     1195         :
     1196           assign
     1197             buf_temp-browse-handle.browse-handle :width
     1198               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1199             no-error .
     1200           if error-status :error
     1201           or error-status :get-message(1) <> ""
     1202           then do:
     1203             undo move_block, retry move_block .
     1204           end.
     1205         end.
     1206         for each buf_temp-diasize-handle
     1207         on error undo move_block, retry move_block
     1208         :
     1209           assign
     1210             v-object-handle = buf_temp-diasize-handle.handle-value
     1211           .
     1212           if v-object-handle <> v-diasize-resize-button
     1213           then do:
     1214             assign
     1215               v-object-handle :col = v-object-handle :col + p-change-value
     1216               no-error .
     1217             if error-status :error
     1218             or error-status :get-message(1) <> ""
     1219             then do:
     1220               undo move_block, retry move_block .
     1221             end.
     1222           end.
     1223         end.
     1224       end.
     1225       else do:
     1226         for each buf_temp-diasize-handle
     1227         on error undo move_block, retry move_block
     1228         :
     1229           assign
     1230             v-object-handle = buf_temp-diasize-handle.handle-value
     1231           .
     1232           if v-object-handle <> v-diasize-resize-button
     1233           then do:
     1234             assign
     1235               v-object-handle :col = v-object-handle :col + p-change-value
     1236               no-error .
     1237             if error-status :error
     1238             or error-status :get-message(1) <> ""
     1239             then do:
     1240               undo move_block, retry move_block .
     1241             end.
     1242           end.
     1243         end.
     1244         for each buf_temp-browse-handle
     1245           where buf_temp-browse-handle.browse-type = 'width':u
     1246         on error undo move_block, retry move_block
     1247         :
     1248           assign
     1249             buf_temp-browse-handle.browse-handle :width
     1250               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1251             no-error .
     1252           if error-status :error
     1253           or error-status :get-message(1) <> ""
     1254           then do:
     1255             undo move_block, retry move_block .
     1256           end.
     1257         end.
     1258         assign
     1259           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1260           no-error .
     1261         if error-status :error
     1262         or error-status :get-message(1) <> ""
     1263         then do:
     1264           undo move_block, retry move_block.
     1265         end.
     1266         assign
     1267           frame d-menubrsw :width = frame d-menubrsw :width + p-change-value
     1268         no-error .
     1269         if error-status :error
     1270         or error-status :get-message(1) <> ""
     1271         then do:
     1272           undo move_block, retry move_block.
     1273         end.
     1274         if frame d-menubrsw :scrollable = true
     1275         then do:
     1276           assign
     1277             frame d-menubrsw :virtual-width = frame d-menubrsw :virtual-width + p-change-value
     1278           no-error .
     1279           if error-status :error
     1280           or error-status :get-message(1) <> ""
     1281           then do:
     1282             undo move_block, retry move_block.
     1283           end.
     1284         end.
     1285       end.
     1286       if p-move-resize
     1287       then do:
     1288         run diasize_position-resize-button in this-procedure .
     1289       end.
     1290       if v-diasize-wndstore = true
     1291       then do:
     1292         if connected("ub") = true
     1293         then do:
     1294           define variable v-cntxt-db-num        as integer   no-undo .
     1295           define variable v-cntxt-userid        as character no-undo .
     1296           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1297                                             , OUTPUT v-cntxt-userid
     1298                                             ) .
     1299           run gbl/wndsizew.p
     1300             (input  v-cntxt-db-num
     1301             ,input  v-cntxt-userid
     1302             ,input  v-diasize-proc-name
     1303             ,input  'width':u
     1304             ,input  string(frame d-menubrsw :width - v-diasize-orig-frame-width)
     1305             ) .
     1306         end.
     1307       end.
     1308     end.
     1309     assign
     1310       v-diasize-change-size = false
     1311     .
     1312   end procedure.
     1313   procedure diasize_set-width :
     1314     define input  parameter p-new-width  as decimal   no-undo .
     1315     define input  parameter p-move-resize as logical   no-undo .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319       run diasize_change-width in this-procedure
     1320         (input  (p-new-width - frame d-menubrsw :width)
     1321         ,input  p-move-resize
     1322         ) .
     1323     end.
     1324   end procedure.
     1325   procedure diasize_position-resize-button :
     1326     do with frame d-menubrsw
     1327     :
     1328       hide v-diasize-resize-button .
     1329       assign
     1330         v-diasize-resize-button :row = frame d-menubrsw :height - v-diasize-resize-button :height
     1331                     - 1
     1332                     - (frame d-menubrsw :border-bottom-pixels / session :pixels-per-row)
     1333         v-diasize-resize-button :col = frame d-menubrsw :width - v-diasize-resize-button :width
     1334                     - 1
     1335                     - (frame d-menubrsw :border-right-pixels / session :pixels-per-column)
     1336       .
     1337       view v-diasize-resize-button .
     1338     end.
     1339   end procedure.
     1340   on alt-right anywhere
     1341   do:
     1342     run diasize_change-width in this-procedure
     1343       (input 1
     1344       ,input true
     1345       ) .
     1346     return no-apply .
     1347   end.
     1348   on alt-left anywhere
     1349   do:
     1350     run diasize_change-width in this-procedure
     1351       (input -1
     1352       ,input true
     1353       ) .
     1354     return no-apply .
     1355   end.
     1356   on alt-down anywhere
     1357   do:
     1358     run diasize_change-height in this-procedure
     1359       (input 1
     1360       ,input true
     1361       ) .
     1362     return no-apply .
     1363   end.
     1364   on alt-up anywhere
     1365   do:
     1366     run diasize_change-height in this-procedure
     1367       (input -1
     1368       ,input true
     1369       ) .
     1370     return no-apply .
     1371   end.
     1372   on alt-enter of frame d-menubrsw
     1373   do:
     1374     run diasize_maximize in this-procedure
     1375       (input  ?
     1376       ).
     1377     return no-apply .
     1378   end.
     1379   procedure diasize_end-move :
     1380     do
     1381     on error undo, return error return-value
     1382     :
     1383       define variable v-row-delta as decimal   no-undo .
     1384       define variable v-col-delta as decimal   no-undo .
     1385       define variable v-new-row as decimal   no-undo .
     1386       define variable v-new-col as decimal   no-undo .
     1387       assign
     1388         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1389         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1390       .
     1391       assign
     1392         v-row-delta = v-new-row - frame d-menubrsw :height
     1393         v-col-delta = v-new-col - frame d-menubrsw :width
     1394       .
     1395       run diasize_change-height in this-procedure
     1396         (input v-row-delta
     1397         ,input true
     1398         ) .
     1399       run diasize_change-width in this-procedure
     1400         (input v-col-delta
     1401         ,input true
     1402         ) .
     1403     end.
     1404   end procedure.
     1405   procedure diasize_maximize :
     1406     define input  parameter p-action as logical   no-undo .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       if p-action = ?
     1411       then do:
     1412         if v-diasize-need-maximize = true
     1413         then do:
     1414           assign
     1415             p-action = true
     1416           .
     1417         end.
     1418         else do:
     1419           assign
     1420             p-action = false
     1421           .
     1422         end.
     1423       end.
     1424       if p-action = true
     1425       then do:
     1426         run diasize_change-height in this-procedure
     1427           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1428               - frame d-menubrsw :height-chars
     1429           ,input true
     1430           ) .
     1431         run diasize_change-width in this-procedure
     1432           (input session :width-chars
     1433               - frame d-menubrsw :width-chars
     1434           ,input true
     1435           ) .
     1436         assign
     1437           v-diasize-need-maximize = false
     1438         .
     1439       end.
     1440       else do:
     1441         run diasize_change-width in this-procedure
     1442           (input v-diasize-orig-frame-width
     1443               - frame d-menubrsw :width-chars
     1444           ,input true
     1445           ) .
     1446         run diasize_change-height in this-procedure
     1447           (input v-diasize-orig-frame-height
     1448               - frame d-menubrsw :height-chars
     1449           ,input true
     1450           ) .
     1451         assign
     1452           v-diasize-need-maximize = true
     1453         .
     1454       end.
     1455     end.
     1456   end procedure.
     1457   procedure diasize_restore-orig-size :
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       assign
     1462         v-diasize-current-frame-width  = frame d-menubrsw :width
     1463         v-diasize-current-frame-height = frame d-menubrsw :height
     1464       .
     1465       run diasize_set-height in this-procedure
     1466         (input  v-diasize-orig-frame-height
     1467         ,input  true
     1468         ) .
     1469       run diasize_set-width in this-procedure
     1470         (input  v-diasize-orig-frame-width
     1471         ,input  true
     1472         ) .
     1473     end.
     1474   end procedure.
     1475   procedure diasize_restore-current-size :
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       run diasize_set-height in this-procedure
     1480         (input  v-diasize-current-frame-height
     1481         ,input  true
     1482         ) .
     1483       run diasize_set-width in this-procedure
     1484         (input  v-diasize-current-frame-width
     1485         ,input  true
     1486         ) .
     1487     end.
     1488   end procedure.
     1489   procedure diasize_set-browse-handle :
     1490     define input  parameter p-browse-handle as handle   no-undo .
     1491     define buffer buf_temp-browse-handle for temp-browse-handle .
     1492     do
     1493     on error undo, return error return-value
     1494     :
     1495       assign
     1496         v-diasize-browse-handle = p-browse-handle
     1497       .
     1498       for each buf_temp-browse-handle
     1499       on error undo, return error return-value
     1500       :
     1501         delete buf_temp-browse-handle .
     1502       end.
     1503     end.
     1504   end procedure.
     1505   procedure diasize_add_browse :
     1506     define input  parameter p-browse-type   as character no-undo .
     1507     define input  parameter p-browse-handle as handle    no-undo .
     1508     define buffer buf_temp-browse-handle for temp-browse-handle .
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       assign
     1513         v-diasize-browse-number = v-diasize-browse-number + 1
     1514       .
     1515       create buf_temp-browse-handle .
     1516       assign
     1517         buf_temp-browse-handle.browse-type   = p-browse-type
     1518         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1519         buf_temp-browse-handle.browse-handle = p-browse-handle
     1520       .
     1521     end.
     1522   end procedure.
     1523   procedure diasize_init :
     1524     define variable v-default-value    as logical   no-undo .
     1525     define variable v-restore-saved    as logical   no-undo .
     1526     define variable v-resize-value-str as character no-undo .
     1527     do
     1528     on error undo, return error return-value
     1529     :
     1530       do with frame d-menubrsw
     1531       :
     1532         assign
     1533           v-diasize-orig-frame-height = frame d-menubrsw :height
     1534           v-diasize-orig-frame-width  = frame d-menubrsw :width
     1535           v-diasize-browse-handle     = browse br-proc :handle
     1536         .
     1537         create button v-diasize-resize-button
     1538         assign
     1539           parent        = frame d-menubrsw :first-child
     1540           label         = "s"
     1541           height-pixels = 16
     1542           width-pixels  = 16
     1543           visible       = true
     1544           sensitive     = true
     1545           movable       = true
     1546           triggers:
     1547             on end-move persistent run diasize_end-move in this-procedure .
     1548           end triggers.
     1549         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1550         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1551         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1552         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1553         assign
     1554           v-diasize-wndmax = false
     1555         .
     1556         if connected("ub") = true
     1557         then do:
     1558           define variable v-cntxt-db-num        as integer   no-undo .
     1559           define variable v-cntxt-userid        as character no-undo .
     1560           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1561                                             , OUTPUT v-cntxt-userid
     1562                                             ) .
     1563           run gbl/wndpar_r.p
     1564             (input  v-cntxt-db-num
     1565             ,input  v-cntxt-userid
     1566             ,input  'wndmax':U
     1567             ,output v-diasize-wndmax
     1568             ,output v-default-value
     1569             ) .
     1570         end.
     1571         assign
     1572           v-diasize-wndstore = false
     1573         .
     1574         if connected("ub") = true
     1575         then do:
     1576           run gbl/wndpar_r.p
     1577             (input  v-cntxt-db-num
     1578             ,input  v-cntxt-userid
     1579             ,input  'wndstore':U
     1580             ,output v-diasize-wndstore
     1581             ,output v-default-value
     1582             ) .
     1583         end.
     1584         assign
     1585           v-diasize-proc-name = entry(1, program-name(2), '.')
     1586         .
     1587         if v-diasize-wndstore = true
     1588         then do:
     1589           assign
     1590             v-restore-saved = false
     1591           .
     1592           if connected("ub") = true
     1593           then do:
     1594             run gbl/wndsizer.p
     1595               (input  v-cntxt-db-num
     1596               ,input  v-cntxt-userid
     1597               ,input  v-diasize-proc-name
     1598               ,input  'height':u
     1599               ,output v-resize-value-str
     1600               ) .
     1601             if v-resize-value-str <> '':U
     1602             then do:
     1603               run diasize_change-height in this-procedure
     1604                 (input  integer(v-resize-value-str)
     1605                 ,input  true
     1606                 ) .
     1607               assign
     1608                 v-restore-saved = true
     1609               .
     1610             end.
     1611           end.
     1612           if connected("ub") = true
     1613           then do:
     1614             run gbl/wndsizer.p
     1615               (input  v-cntxt-db-num
     1616               ,input  v-cntxt-userid
     1617               ,input  v-diasize-proc-name
     1618               ,input  'width':u
     1619               ,output v-resize-value-str
     1620               ) .
     1621             if v-resize-value-str <> '':U
     1622             then do:
     1623               run diasize_change-width in this-procedure
     1624                 (input  integer(v-resize-value-str)
     1625                 ,input  true
     1626                 ) .
     1627               assign
     1628                 v-restore-saved = true
     1629               .
     1630             end.
     1631           end.
     1632           if v-restore-saved <> true
     1633           then do:
     1634             if v-diasize-wndmax = true
     1635             then do:
     1636               run diasize_maximize in this-procedure
     1637                 (input  true
     1638                 ) .
     1639             end.
     1640           end.
     1641         end.
     1642         else do:
     1643           if v-diasize-wndmax = true
     1644           then do:
     1645             run diasize_maximize in this-procedure
     1646               (input  true
     1647               ) .
     1648           end.
     1649         end.
     1650       end.
     1651     end.
     1652   end procedure.
     1653   procedure diasize_need-full-display :
     1654     define output parameter p-need-full-display as logical   no-undo .
     1655     do
     1656     on error undo, return error return-value
     1657     :
     1658       assign
     1659         p-need-full-display = v-diasize-need-full-display
     1660       .
     1661       assign
     1662         v-diasize-need-full-display = false
     1663       .
     1664     end.
     1665   end procedure.
     1666   procedure get-context :
     1667      define output parameter p-db-num as integer          no-undo.
     1668      define output parameter p-user-id as character        no-undo.
     1669      define variable v-login               as character    no-undo.
     1670      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1671      define buffer buf_user-login  for ub.user-login .
     1672      do
     1673      on error undo, return error
     1674      :
     1675            FIND FIRST buf_sys-ctrl no-lock.
     1676            ASSIGN
     1677               v-login = USERID("ub")
     1678               p-db-num = buf_sys-ctrl.db-num
     1679            .
     1680            FIND FIRST buf_user-login
     1681                 WHERE buf_user-login.db-num = p-db-num
     1682                   AND buf_user-login.user-login = v-login
     1683                 no-lock
     1684                 no-error
     1685                 .
     1686            IF AVAILABLE buf_user-login
     1687            THEN DO:
     1688               assign
     1689                  p-user-id = buf_user-login.user-id
     1690               .
     1691            END.
     1692      end.
     1693   end procedure.
     1694       run diasize_init in this-procedure .
     1695   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   do:
     1697     br-proc :SET-REPOSITIONED-ROW(10, "CONDITIONAL") .
     1698   end.
     1699   MAIN-BLOCK:
     1700   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1701      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK :
     1702     RUN load-br-proc-table IN THIS-PROCEDURE.
     1703     RUN enable_UI          IN THIS-PROCEDURE.
     1704     ASSIGN FRAME d-menubrsw :TITLE = c-title.
     1705     WAIT-FOR GO OF FRAME d-menubrsw FOCUS br-proc.
     1706   END.
     1707   RUN disable_UI IN THIS-PROCEDURE.
     1708   PROCEDURE create-br-proc :
     1709     define input  parameter p-index       as integer   no-undo .
     1710     define input  parameter p-proc-name   as character no-undo .
     1711     define input  parameter p-proc-handle as handle    no-undo .
     1712     define input  parameter p-curr-sys-key as character no-undo .
     1713     define buffer buf_br-proc for br-proc .
     1714     define variable v-c-point         as character no-undo .
     1715     define variable v-proc-name       as character no-undo .
     1716     define variable v-proc-file       as character no-undo .
     1717     define variable v-proc-install    as logical   no-undo .
     1718     define variable v-mainmenu-handle as logical   no-undo .
     1719     define variable v-proc-db-ver     as character no-undo .
     1720     define variable v-proc-run-order  as character no-undo .
     1721     define variable v-proc-client     as character no-undo .
     1722     do
     1723     on error undo, return error return-value
     1724     :
     1725       run value(p-proc-name) in p-proc-handle
     1726         (output v-c-point
     1727         ,output v-proc-name
     1728         ,output v-proc-file
     1729         ,output v-proc-install
     1730         ,output v-mainmenu-handle
     1731         ,output v-proc-db-ver
     1732         ,output v-proc-run-order
     1733         ,output v-proc-client
     1734         ) no-error .
     1735       if error-status :error
     1736       then do:
     1737         if error-status :get-message(1) <> ""
     1738         then do:
     1739           message
     1740             vss-workfile vss-revision vss-description skip
     1741             "Ошибка при вызове процедуры создания пункта меню" p-proc-name skip
     1742             error-status :get-message(1) skip
     1743             return-value skip
     1744             view-as alert-box error .
     1745         end.
     1746         undo, return .
     1747       end.
     1748       if v-proc-client = "":U
     1749         or caps( p-curr-sys-key ) = 'ExpertekIBS':U
     1750         or check-entry-with-mask( p-curr-sys-key, v-proc-client, chr(44) ) = true
     1751       then do:
     1752         create buf_br-proc .
     1753         assign
     1754           buf_br-proc.proc-index      = p-index
     1755           buf_br-proc.c-point         = v-c-point
     1756           buf_br-proc.proc-name       = v-proc-name
     1757           buf_br-proc.proc-file       = v-proc-file
     1758           buf_br-proc.proc-install    = v-proc-install
     1759           buf_br-proc.mainmenu-handle = v-mainmenu-handle
     1760           buf_br-proc.proc-db-ver     = v-proc-db-ver
     1761           buf_br-proc.proc-run-order  = v-proc-run-order
     1762           buf_br-proc.proc-client     = v-proc-client
     1763         .
     1764       end.
     1765     end.
     1766   END PROCEDURE.
     1767   PROCEDURE disable_UI :
     1768     HIDE FRAME d-menubrsw.
     1769   END PROCEDURE.
     1770   PROCEDURE enable_UI :
     1771     DISPLAY find-name find-file
     1772         WITH FRAME d-menubrsw.
     1773     ENABLE br-proc b-quit b-sel i-exit b-help find-name find-file
     1774         WITH FRAME d-menubrsw.
     1775     VIEW FRAME d-menubrsw.
     1776     OPEN QUERY br-proc FOR EACH br-proc where br-proc.c-point = c-point.
     1777   END PROCEDURE.
     1778   PROCEDURE load-br-proc-table :
     1779     def var v-handle  as handle no-undo .
     1780     def var v-handle2 as handle no-undo .
     1781     define variable v-curr-sys-key as character no-undo .
     1782   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1783   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1784     (output v-curr-sys-key
     1785     ) no-error .
     1786     run gbl/menuload.p persistent set v-handle .
     1787     run gbl/menuloa2.p persistent set v-handle2 .
     1788     def var v-ind           as integer   no-undo .
     1789     def var v-internal-proc  as character no-undo .
     1790     def var v-internal-proc2 as character no-undo .
     1791     define variable v-ord-index as integer   no-undo .
     1792     define variable v-internal-entry-order-normal as logical   no-undo .
     1793     define variable v-num-entries-internal-proc   as integer   no-undo .
     1794     run gbl/int-ent.p
     1795       (output v-internal-entry-order-normal
     1796       ).
     1797     assign
     1798       v-internal-proc = v-handle :internal-entries
     1799       v-internal-proc2 = v-handle2 :internal-entries
     1800     .
     1801     assign
     1802       v-num-entries-internal-proc = num-entries(v-internal-proc)
     1803     .
     1804       if v-internal-entry-order-normal = true
     1805     then do:
     1806       do v-ind = 1 to v-num-entries-internal-proc by 1
     1807       :
     1808         assign
     1809           v-ord-index = v-ord-index + 1
     1810         .
     1811         if entry(1, entry(v-ind, v-internal-proc), "%") = c-point then do:
     1812           run create-br-proc in this-procedure
     1813             ( input v-ord-index
     1814             , input entry(v-ind, v-internal-proc)
     1815             , input v-handle
     1816             , input v-curr-sys-key
     1817             ) .
     1818         end.
     1819       end.
     1820     end.
     1821     else do:
     1822       do v-ind = v-num-entries-internal-proc to 1 by -1
     1823       :
     1824         assign
     1825           v-ord-index = v-ord-index + 1
     1826         .
     1827         if entry(1, entry(v-ind, v-internal-proc), "%") = c-point then do:
     1828           run create-br-proc in this-procedure
     1829             ( input v-ord-index
     1830             , input entry(v-ind, v-internal-proc)
     1831             , input v-handle
     1832             , input v-curr-sys-key
     1833           ) .
     1834         end.
     1835       end.
     1836     end.
     1837     assign
     1838       v-num-entries-internal-proc = num-entries(v-internal-proc2)
     1839     .
     1840       if v-internal-entry-order-normal = true
     1841     then do:
     1842       do v-ind = 1 to v-num-entries-internal-proc by 1
     1843       :
     1844         assign
     1845           v-ord-index = v-ord-index + 1
     1846         .
     1847         if entry(1, entry(v-ind, v-internal-proc2), "%") = c-point then do:
     1848           run create-br-proc in this-procedure
     1849             ( input v-ord-index
     1850             , input entry(v-ind, v-internal-proc2)
     1851             , input v-handle2
     1852             , input v-curr-sys-key
     1853             ) .
     1854         end.
     1855       end.
     1856     end.
     1857     else do:
     1858       do v-ind = v-num-entries-internal-proc to 1 by -1
     1859       :
     1860         assign
     1861           v-ord-index = v-ord-index + 1
     1862         .
     1863         if entry(1, entry(v-ind, v-internal-proc2), "%") = c-point then do:
     1864           run create-br-proc in this-procedure
     1865             ( input v-ord-index
     1866             , input entry(v-ind, v-internal-proc2)
     1867             , input v-handle2
     1868             , input v-curr-sys-key
     1869             ) .
     1870         end.
     1871       end.
     1872     end.
     1873     delete procedure v-handle .
     1874     delete procedure v-handle2.
     1875   END PROCEDURE.
