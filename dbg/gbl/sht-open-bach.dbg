      676                   assign
      677                       ub.shift-param.obj-code   = buf_shift-obj.obj-code
      678                       ub.shift-param.obj-type   = buf_shift-obj.obj-type
      679                       ub.shift-param.shift-date = buf_shift-obj.shift-date
      680                       ub.shift-param.shift-name = buf_shift-obj.shift-name
      681                       ub.shift-param.shift-num  = buf_shift-obj.shift-num
      682                       .
