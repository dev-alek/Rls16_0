      850         return error.
      851       end.
      852   end.
      853   if varobj-date - s-date > 4 then do:
      854     run put-mes(no ,substitute("Календарная дата объекта &1~nСменная дата &2 ~nРазница &3~nРазница должна составлять не более 4 дней."
      855                                ,varobj-date
      856                                ,s-date
      857                                ,v-sys-date - s-date
      858     ),no,"").
