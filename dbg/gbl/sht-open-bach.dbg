      924         v-value-logical = FALSE
      925      .
      926   end.
      927   if v-value-logical then do:
      928     for each bf-trb_shift-obj where bf-trb_shift-obj.obj-type    = p-curr-obj-type and
      929                                     bf-trb_shift-obj.obj-code    = p-curr-obj-code and
      930                                     bf-trb_shift-obj.shift-date  = s-date          and
      931                                     bf-trb_shift-obj.shift-name  > s-name          on error undo, return error return-value :
      932         run put-mes(no ,substitute("По настройкам конфигурации (newordsh) вам запрещено добавлять смены с меньшим номером после смены с большим номером в одном сменном дне.~nНа объекте &1 &2 есть смена:~nДата смены &3~nПорядок смены &4~nНомер смены &5"
      933                                ,bf-trb_shift-obj.obj-type
      934                                ,bf-trb_shift-obj.obj-code
      935                                ,bf-trb_shift-obj.shift-date
      936                                ,bf-trb_shift-obj.shift-num
      937                                ,bf-trb_shift-obj.shift-name
      938     ),no,"").
      939       return error.
      940     end.
      941   end.
      942   start-shift:
      943   do transaction on error undo start-shift, return on stop undo start-shift, return:
      944     if not available buf_shift-obj then do:
      945       create buf_shift-obj.
      946       assign
      947         buf_shift-obj.host-code     = v-host-code
      948         buf_shift-obj.obj-type      = p-curr-obj-type
      949         buf_shift-obj.obj-code      = p-curr-obj-code
      950         buf_shift-obj.shift-date    = s-date
      951         buf_shift-obj.shift-num     = s-num
      952         buf_shift-obj.shift-name    = s-name
      953         buf_shift-obj.open-date     = s-date
      954       .
      955     end.
      956     assign
      957       buf_shift-obj.status_ = 'тек':U
      958       buf_shift-obj.open-sys-date = v-sys-date
      959       buf_shift-obj.open-sys-time = v-sys-time
      960       buf_shift-obj.open-time     = s-time
      961     .
      962     if varupd-obj-date = yes then do:
      963   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtset in g#library
      965     (input p-curr-obj-type
      966     ,input p-curr-obj-code
      967     ,input s-date
      968     ) no-error .
      969        if error-status:error then do:
      970          run put-mes(no ,"Ошибка при установке календарной даты.",no,"").
      971           return error.
      972        end.
      973     end.
      974   end.
      975   if not mbachMode
      976   then
      977       message
      978         "Новая смена открыта."
      979       view-as alert-box.
      980   end.
      981   mOk =yes.
      982   oOk = mOk.
