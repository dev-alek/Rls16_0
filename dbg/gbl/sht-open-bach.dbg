      691   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      693     (input  p-curr-obj-type
      694     ,input  p-curr-obj-code
      695     ,output s-date
      696     )  .
      697    find last open-shift where
      698              open-shift.obj-type = p-curr-obj-type and
      699              open-shift.obj-code = p-curr-obj-code and
      700              open-shift.shift-date = today
      701             use-index pi no-error.
      702    s-num  = (if available open-shift then open-shift.shift-num else 0) + 1.
      703    s-name = "11".
      704    s-time = time.
      705    e-time = time.
      706       if v-cancel = yes
