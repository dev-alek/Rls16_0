      830      run put-mes(no ,substitute("Дата смены &1~nДата на сервере &2~n Разница ~nЭта разница должна быть меньше 10 дней!"
      831                                ,s-date
      832                                ,v-sys-date
      833                                ,v-sys-date - s-date
      834     ),no,"").
      835      return error.
      836   end.
      837   if not mBachMode
      838   then do:
      839       run str/dskshtop.p (
