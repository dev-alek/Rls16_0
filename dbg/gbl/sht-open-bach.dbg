      821   if s-date > v-sys-date then do:
      822     run put-mes(no ,substitute("Дата смены &1~nДата на сервере &2~n Дата смены не может быть больше даты на сервере"
      823                                ,s-date
      824                                ,v-sys-date
      825     ),no,"").
      826      return error.
      827   end.
      828   if s-date < v-sys-date - 10 and
