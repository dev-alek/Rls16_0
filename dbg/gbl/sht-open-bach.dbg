        1   block-level on error undo, throw.
        2   define input  parameter iUtil as class ibs.th.utl.method-for-draw-utility no-undo.
        3   define output parameter oOk as logical no-undo.
        4   procedure put-mes:
        5   define input  parameter iVss    as logical   no-undo.
        6   define input  parameter iText   as character no-undo.
        7   define input  parameter iGetMes as logical   no-undo.
        8   define input  parameter iRetval as character no-undo.
        9   iUtil:put-log(substitute("&1  &2 &3 &4 &5 &6 &7"
       10                            ,iText
       11                            ,if iGetMes then trim(error-status :get-message(1)) else ""
       12                            ,if iGetMes then trim(error-status :get-message(2)) else ""
       13                            ,if iGetMes then trim(error-status :get-message(3)) else ""
       14                            ,if iGetMes then trim(error-status :get-message(4)) else ""
       15                            ,if iGetMes then trim(error-status :get-message(5)) else ""
       16                            ,iRetval)
       17     ).
       18   end procedure.
       19   define input parameter parparentproc as widget-handle no-undo .
       20   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
       21   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
       22   define variable mOk as logical no-undo.
       23   define variable mBachMode as logical no-undo.
       24      mBachMode = yes.
       25   define variable vss-revision    as character no-undo init "$Revision$":U .
       26   define variable vss-author      as character no-undo init "$Author$":U .
       27   define variable vss-date        as character no-undo init "$Date$":U .
       28   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       29   define variable vss-archive     as character no-undo init "$Archive$":U .
       30   define variable vss-description as character no-undo init "Открытие смены".
       31   procedure vss-get-info :
       32     define output parameter p-vss-revision    like vss-revision    no-undo .
       33     define output parameter p-vss-author      like vss-author      no-undo .
       34     define output parameter p-vss-date        like vss-date        no-undo .
       35     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       36     define output parameter p-vss-archive     like vss-archive     no-undo .
       37     define output parameter p-vss-description like vss-description no-undo .
       38     assign
       39       p-vss-revision    = vss-revision
       40       p-vss-author      = vss-author
       41       p-vss-date        = vss-date
       42       p-vss-workfile    = vss-workfile
       43       p-vss-archive     = vss-archive
       44       p-vss-description = vss-description
       45     .
       46   end procedure.
       47   procedure vss-get-parameters :
       48     define output parameter p-vss-parameters as character no-undo .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   define new global shared variable g#library  as handle no-undo .
       90   define new global shared variable g#library2 as handle no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure cur-time :
       93      define output parameter p-today as date      no-undo .
       94      define output parameter p-time  as integer   no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       define variable v-date1 as date      no-undo .
       99       define variable v-date2 as date      no-undo .
      100       define variable v-time  as integer   no-undo .
      101       assign
      102         v-date1 = today
      103         v-time  = time
      104         v-date2 = today
      105       .
      106       if v-date1 <> v-date2
      107       then do:
      108         assign
      109           v-date1 = today
      110           v-time  = v-time
      111         .
      112       end.
      113       assign
      114         p-today = v-date1
      115         p-time  = v-time
      116       .
      117     end.
      118   end.
      119   function cur-time-date returns character
      120   :
      121     return string(today, '99/99/9999':U) .
      122   end.
      123   function cur-time-mjd returns decimal
      124   :
      125     define variable v-date as date      no-undo .
      126     define variable v-time as integer   no-undo .
      127     run cur-time in this-procedure
      128       (output v-date
      129       ,output v-time
      130       ) .
      131     return integer(v-date) - 2400002 + (v-time / 86400) .
      132   end.
      133   function cur-time-get-ending-index returns integer
      134   (input p-number as integer
      135   )
      136   :
      137     if p-number < 0
      138     or p-number = ?
      139     then do:
      140       return 1 .
      141     end.
      142     define variable v-rest as integer   no-undo .
      143     assign
      144       p-number = p-number modulo 100
      145     .
      146     if p-number < 20
      147     then do:
      148       assign
      149         v-rest = p-number
      150       .
      151     end.
      152     else do:
      153       assign
      154         v-rest = p-number modulo 10
      155       .
      156     end.
      157     case v-rest :
      158       when 1
      159       then do:
      160         return 2 .
      161       end.
      162       when 2 or
      163       when 3 or
      164       when 4
      165       then do:
      166         return 3 .
      167       end.
      168       otherwise do:
      169         return 1 .
      170       end.
      171     end case .
      172   end.
      173   procedure cur-time-mjd-to-date :
      174      define input  parameter i-mjd-diff as decimal no-undo.
      175      define output parameter o-Date     as date    no-undo.
      176      define output parameter o-Time     as integer no-undo.
      177      define variable v-day-number as integer   no-undo .
      178      if    i-mjd-diff < 0
      179         or i-mjd-diff = ?
      180      then do:
      181         return "?" .
      182      end.
      183      assign
      184         v-day-number = truncate(i-mjd-diff,0).
      185         o-Date = date(v-day-number + 2400002).
      186         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188   end.
      189   function cur-time-mjd-to-string returns character
      190   (input p-mjd-diff as decimal
      191   )
      192   :
      193     define variable v-day-number as integer   no-undo .
      194     define variable v-seconds    as integer   no-undo .
      195     define variable v-hour       as integer   no-undo .
      196     define variable v-min        as integer   no-undo .
      197     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      198     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      199     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      200     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      201     if p-mjd-diff < 0
      202     or p-mjd-diff = ?
      203     then do:
      204       return "?" .
      205     end.
      206     assign
      207       v-day-number = integer(truncate(p-mjd-diff,0))
      208       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210     if v-seconds > 86400
      211     then do:
      212       assign
      213         v-seconds = 86400 - 1
      214       .
      215     end.
      216     if v-seconds < 0
      217     then do:
      218       assign
      219         v-seconds = 0
      220       .
      221     end.
      222     assign
      223       v-hour = truncate(v-seconds / 3600, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 3600
      227     .
      228     assign
      229       v-min = truncate(v-seconds / 60, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 60
      233     .
      234     return
      235         (if v-day-number <> 0
      236           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0
      240           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      244           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      245           else ""
      246         )
      247       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      248       .
      249   end.
      250   function cur-time-string returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      259   end.
      260   function cur-time-string-sec returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      269   end.
      270   function cur-time-custom  returns character
      271   (input p-prefix as character
      272   ,input p-date-format as character
      273   ,input p-delimiter as character
      274   ,input p-time-format as character
      275   ,input p-suffix as character
      276   )
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return
      285       p-prefix
      286       + string(v-date, p-date-format)
      287       + p-delimiter
      288       + string(v-time, p-time-format)
      289       + p-suffix
      290       .
      291   end.
      292   function cur-time-print  returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-datetime returns datetime
      303   :
      304     define variable v-char as character no-undo .
      305     define variable v-datetime as datetime no-undo .
      306     v-char = cur-time-string().
      307     v-datetime = datetime(v-char).
      308     return  v-datetime.
      309   end.
      310   function cur-time-string-msec returns character
      311   :
      312     define variable v-date as datetime  no-undo .
      313     v-date = now.
      314     return string(v-date) .
      315   end.
      316   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317     define variable v-cntxt-db-num        as integer   no-undo .
      318     define variable v-cntxt-userid        as character no-undo .
      319     define variable v-cntxt-level         as character no-undo .
      320     define variable v-cntxt-host-code-obj as integer   no-undo .
      321     define variable v-cntxt-obj-type      as character no-undo .
      322     define variable v-cntxt-obj-code      as integer   no-undo .
      323     define variable v-cntxt-db-num-obj    as integer   no-undo .
      324     define variable v-cntxt-is-admin      as logical   no-undo .
      325   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   procedure integerm :
      327     define input  parameter p-string      as character no-undo .
      328     define input  parameter p-allow-sign  as logical   no-undo .
      329     define input  parameter p-allow-comma as logical   no-undo .
      330     define output parameter p-value       as integer   no-undo .
      331     define output parameter p-data-valid  as logical   no-undo .
      332     define output parameter p-message     as character no-undo .
      333     define variable v-replace-string as character no-undo .
      334     do
      335     on error undo, return error return-value
      336     :
      337       if p-string = ?
      338       then do:
      339         assign
      340           p-value      = ?
      341           p-data-valid = false
      342           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      343         .
      344         return .
      345       end.
      346       if p-string = ""
      347       then do:
      348         assign
      349           p-value      = ?
      350           p-data-valid = false
      351           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      352         .
      353         return .
      354       end.
      355       assign
      356         p-value = integer(p-string) no-error
      357       .
      358       if error-status :error = true
      359       then do:
      360         assign
      361           p-value      = ?
      362           p-data-valid = false
      363           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      364                                    ,p-string
      365                                    )
      366         .
      367         return .
      368       end.
      369       if index(p-string, ' ':u) > 0
      370       then do:
      371         assign
      372           p-value      = ?
      373           p-data-valid = false
      374           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      375                                    + "Строка содержит символы пробела"
      376                                    ,p-string
      377                                    )
      378         .
      379         return .
      380       end.
      381       assign
      382         v-replace-string = p-string
      383         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      384         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      385         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      386         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      387         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      388         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      389         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      390         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      391         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      392       .
      393       if p-allow-sign = true
      394       then do:
      395         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      396         then do:
      397           assign
      398             v-replace-string = substring(v-replace-string, 2)
      399           .
      400         end.
      401       end.
      402       else do:
      403         if substring(v-replace-string, 1, 1) = '+':u
      404         then do:
      405           assign
      406             p-value      = ?
      407             p-data-valid = false
      408             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      409                                     + "Задан параметр недопустимости знака челого числа. "
      410                                     + "Строка содержит символ плюс. "
      411                                     ,p-string
      412                                     )
      413           .
      414           return .
      415         end.
      416         if substring(v-replace-string, 1, 1) = '-':u
      417         then do:
      418           assign
      419             p-value      = ?
      420             p-data-valid = false
      421             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      422                                     + "Задан параметр недопустимости знака челого числа. "
      423                                     + "Строка содержит символ минус. "
      424                                     ,p-string
      425                                     )
      426           .
      427           return .
      428         end.
      429       end.
      430       if p-allow-comma = true
      431       then do:
      432         assign
      433           v-replace-string = replace(v-replace-string, ',', '')
      434         .
      435       end.
      436       else do:
      437         if index(v-replace-string, ',') > 0
      438         then do:
      439           assign
      440             p-value      = ?
      441             p-data-valid = false
      442             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      443                                     + "Задан параметр недопустимости знака разделителя тысяч."
      444                                     + "Строка содержит знак разделителя тысяч. "
      445                                     ,p-string
      446                                     )
      447           .
      448           return .
      449         end.
      450       end.
      451       if index(p-string, '.') > 0
      452       then do:
      453         assign
      454           p-value      = ?
      455           p-data-valid = false
      456           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      457                                    + "Строка содержит знак десятичной точки"
      458                                    ,p-string
      459                                    )
      460         .
      461         return .
      462       end.
      463       if v-replace-string <> fill('9', length(v-replace-string))
      464       then do:
      465         assign
      466           p-value      = ?
      467           p-data-valid = false
      468           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      469                                    + "Встречены символы, недопустимые для целого числа '&2'"
      470                                    ,p-string
      471                                    ,replace(v-replace-string, '9', '')
      472                                    )
      473         .
      474         return .
      475       end.
      476       assign
      477         p-data-valid = true
      478         p-message    = ""
      479       .
      480     end.
      481   end procedure.
      482   define variable f-date   as date    no-undo.
      483   define variable f-time   as integer no-undo.
      484   define variable s-date   as date    no-undo.
      485   define variable e-date   as date    no-undo.
      486   define variable s-time   as integer no-undo.
      487   define variable e-time   as integer no-undo.
      488   define variable s-num      as integer   no-undo.
      489   define variable s-name     as character no-undo.
      490   define variable s-name-int as integer   no-undo.
      491   define variable is-super as log     no-undo.
      492   define variable varupd-obj-date as logical initial no   no-undo.
      493   define variable varobj-date     as date                 no-undo.
      494   define variable v-sys-date      as date                 no-undo.
      495   define variable v-sys-time      as integer              no-undo.
      496   define variable v-cancel        as logical              no-undo.
      497   define variable glog as logical no-undo .
      498   define variable v-host-code like ub.sysconf.host-code no-undo .
      499   define buffer bf-trb_shift-obj   for ub.shift-obj .
      500   define buffer open-shift         for ub.shift-obj .
      501   define buffer buf_shift-obj      for ub.shift-obj .
      502   define buffer closed-shift       for ub.shift-obj .
      503   do
      504   on error undo, return error return-value + error-status:get-message(1) + error-status:get-message(2)
      505   :
      506   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      508     (input  p-curr-obj-type
      509     ,input  p-curr-obj-code
      510     ,output v-host-code
      511     )  .
      512   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513     run mainmenu_getcntxt in parparentproc
      514       (output v-cntxt-db-num
      515       ,output v-cntxt-userid
      516       ,output v-cntxt-level
      517       ,output v-cntxt-host-code-obj
      518       ,output v-cntxt-obj-type
      519       ,output v-cntxt-obj-code
      520       ,output v-cntxt-db-num-obj
      521       ,output v-cntxt-is-admin
      522       ) .
      523   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      525     (input  p-curr-obj-type
      526     ,input  p-curr-obj-code
      527     ,input  'shift-on=request'
      528     ,output glog
      529     ) no-error .
      530   if error-status :error then do:
      531     run put-mes(yes ,"Ошибка при запуске процедуры objat",yes,return-value).
      532     return error.
      533   end.
      534   run cur-time in this-procedure ( output v-sys-date
      535                                  , output v-sys-time
      536                                  ) no-error.
      537   if error-status:error then do:
      538       run put-mes(yes ,"Ошибка при чтении системной даты.",yes,return-value).
      539       undo, return error .
      540   end.
      541   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
