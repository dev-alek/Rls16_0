      880      vardata-valid <> yes then do:
      881        run put-mes(no ,"Ошибка при заведении номера смены. ",yes,varmessage).
      882    return error.
      883   end.
      884   if s-name-int < 1 then do:
      885     run put-mes(no ,"Номер смены может быть только положительным целым числом.",no,"").
      886     return error.
      887   end.
      888   for each bf-trb_shift-obj where bf-trb_shift-obj.obj-type    = p-curr-obj-type and
      889                                   bf-trb_shift-obj.obj-code    = p-curr-obj-code and
      890                                   bf-trb_shift-obj.shift-date  = s-date          and
      891                                   bf-trb_shift-obj.shift-name  = s-name          and
      892                                   bf-trb_shift-obj.status_    <> 'ожд':U on error undo, return error return-value :
      893    run put-mes(no ,substitute("Запрещено добавлять смены с одним номером в одном сменном дне.~nНа объекте &1 &2 есть смена:~nДата смены &3~nПорядок смены &4~nНомер смены &5"
      894                                ,bf-trb_shift-obj.obj-type
      895                                ,bf-trb_shift-obj.obj-code
      896                                ,bf-trb_shift-obj.shift-date
      897                                ,bf-trb_shift-obj.shift-num
      898                                ,bf-trb_shift-obj.shift-name
      899     ),no,"").
      900     return error.
      901   end.
      902   define variable v-value-character as character  no-undo .
      903   define variable v-value-date      as date       no-undo .
      904   define variable v-value-decimal   as decimal    no-undo .
      905   define variable v-value-integer   as integer    no-undo .
      906   define variable v-value-logical   as logical    no-undo .
      907   define variable v-tth             as handle     no-undo .
      908   define variable v-param-type            as character no-undo .
      909   run adm/shattri.p ( input "get":U
      910                     , input  '':u
      911                     , input  0
      912                     , input  'obj-date':U
      913                     , input  'newordsh':U
      914                     , output v-value-character
      915                     , output v-value-date
      916                     , output v-value-decimal
      917                     , output v-value-integer
      918                     , output v-value-logical
      919                     , output v-param-type
      920                     , input-output table-handle v-tth
      921                     ) no-error .
      922   if error-status :error then do:
