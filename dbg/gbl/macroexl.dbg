        1   block-level on error undo, throw.
        2   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
        4   procedure paramls-clear :
        5     define buffer buf_temp-param for temp-param .
        6     do
        7     on error undo, return error return-value
        8     :
        9       for each buf_temp-param
       10       on error undo, return error
       11       :
       12         delete buf_temp-param .
       13       end.
       14     end.
       15   end procedure.
       16   procedure paramls-write :
       17     define input  parameter p-code     as character no-undo .
       18     define input  parameter p-sub-code as character no-undo .
       19     define input  parameter p-value    as character no-undo .
       20     define buffer buf_temp-param for temp-param .
       21     do
       22     on error undo, return error return-value
       23     :
       24       find first buf_temp-param
       25         where buf_temp-param.param-code     = p-code
       26           and buf_temp-param.param-sub-code = p-sub-code
       27         no-error .
       28       if not available buf_temp-param then do:
       29         create buf_temp-param .
       30         assign
       31           buf_temp-param.param-code     = p-code
       32           buf_temp-param.param-sub-code = p-sub-code
       33         .
       34       end.
       35       assign
       36         buf_temp-param.param-value = p-value
       37       .
       38     end.
       39   end procedure.
       40   procedure paramls-read :
       41     define input  parameter p-code          as character no-undo .
       42     define input  parameter p-sub-code      as character no-undo .
       43     define input  parameter p-default-value as character no-undo .
       44     define output parameter p-value         as character no-undo .
       45     define buffer buf_temp-param for temp-param .
       46     do
       47     on error undo, return error return-value
       48     :
       49       find first buf_temp-param
       50         where buf_temp-param.param-code     = p-code
       51           and buf_temp-param.param-sub-code = p-sub-code
       52         no-error .
       53       if available buf_temp-param then do:
       54         assign
       55           p-value = buf_temp-param.param-value
       56         .
       57       end.
       58       else do:
       59         assign
       60           p-value = p-default-value
       61         .
       62       end.
       63     end.
       64   end procedure.
       65   procedure paramls-append :
       66     define input  parameter p-code     as character no-undo .
       67     define input  parameter p-sub-code as character no-undo .
       68     define input  parameter p-value    as character no-undo .
       69     define buffer buf_temp-param for temp-param .
       70     do
       71     on error undo, return error return-value
       72     :
       73       find first buf_temp-param
       74            where buf_temp-param.param-code     = p-code
       75              and buf_temp-param.param-sub-code = p-sub-code
       76         no-error .
       77       if not available buf_temp-param then do:
       78         create buf_temp-param .
       79         assign
       80           buf_temp-param.param-code     = p-code
       81           buf_temp-param.param-sub-code = p-sub-code
       82           buf_temp-param.param-value    = p-value
       83         .
       84       end.
       85       else do:
       86           assign
       87               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
       88           .
       89       end.
       90     end.
       91   end procedure.
       92   define input-output parameter table for temp-param .
       93   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       94   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       95   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       96   define variable vss-workfile    as character no-undo init "$Workfile: macroexl.p $":U .
       97   define variable vss-archive     as character no-undo init "$Archive: gbl/macroexl.p $":U .
       98   define variable vss-description as character no-undo init "Программа запуска excel и выполнения программы макро".
       99   procedure vss-get-info :
      100     define output parameter p-vss-revision    like vss-revision    no-undo .
      101     define output parameter p-vss-author      like vss-author      no-undo .
      102     define output parameter p-vss-date        like vss-date        no-undo .
      103     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      104     define output parameter p-vss-archive     like vss-archive     no-undo .
      105     define output parameter p-vss-description like vss-description no-undo .
      106     assign
      107       p-vss-revision    = vss-revision
      108       p-vss-author      = vss-author
      109       p-vss-date        = vss-date
      110       p-vss-workfile    = vss-workfile
      111       p-vss-archive     = vss-archive
      112       p-vss-description = vss-description
      113     .
      114   end procedure.
      115   procedure vss-get-parameters :
      116     define output parameter p-vss-parameters as character no-undo .
      117   end procedure.
      118   define new global shared variable g#vssrevis-logger as handle    no-undo .
      119   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      120   define variable v-vssrevis-logger                   as handle    no-undo .
      121   procedure vss-logevent :
      122     define input  parameter p-extra-paramters as character no-undo .
      123     define variable v-vssrevis-parameters as character no-undo .
      124     do
      125     on error undo, return error return-value
      126     :
      127       if  valid-handle(v-vssrevis-logger)
      128       and v-vssrevis-logger :get-signature("logevent") <> ""
      129       then do:
      130         run vss-get-parameters in this-procedure
      131           (output v-vssrevis-parameters
      132           ).
      133         run logevent in v-vssrevis-logger
      134           (input vss-workfile
      135           ,input vss-revision
      136           ,input v-vssrevis-parameters
      137           ,input p-extra-paramters
      138           ).
      139       end.
      140     end.
      141   end procedure.
      142   assign
      143     v-vssrevis-logger = g#vssrevis-logger
      144   .
      145   if  valid-handle(v-vssrevis-logger)
      146   and v-vssrevis-logger :get-signature("logevent") <> ""
      147   then do:
      148     assign
      149       v-vssrevis-logevent = true
      150     .
      151     run vss-logevent in this-procedure (input vss-description) .
      152   end.
      153   define new global shared variable g#language as character no-undo .
      154   if g#language <> '' and g#language <> 'rus':U then do:
      155     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      156   end.
      157   define buffer buf_temp-param for temp-param .
      158   define variable chExcelApp   as com-handle no-undo .
      159   define variable chWorkBook   as com-handle no-undo .
      160   define variable chCodeModule as com-handle no-undo .
      161   define variable v-ind              as integer   no-undo .
      162   define variable v-excel-macro-file as character no-undo .
      163   define variable v-ok               as logical   no-undo .
      164   do
      165   on error undo, return error
      166   :
      167     define variable v-excel-file-name as character no-undo .
      168     define variable v-read-password   as character no-undo .
      169     define variable v-write-password  as character no-undo .
      170     define variable v-excel-dir-name  as character no-undo .
      171     run paramls-read in this-procedure
      172       (input  "saveas"
      173       ,input  "excel-file-name"
      174       ,input  ""
      175       ,output v-excel-file-name
      176       ) .
      177     define variable v-rowsgroup-enable-str as character no-undo .
      178     define variable v-rowsgroup-enable     as logical   no-undo .
      179     run paramls-read in this-procedure
      180       (input  "rowsgroup-enable"
      181       ,input  ""
      182       ,input  "false"
      183       ,output v-rowsgroup-enable-str
      184       ) .
      185     if lookup(v-rowsgroup-enable-str, 'yes,true':u) > 0
      186     then do:
      187       assign
      188         v-rowsgroup-enable = true
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rowsgroup-enable = false
      194       .
      195     end.
      196     if v-excel-file-name = ""
      197     or v-excel-file-name = ?
      198     then do:
      199       run gbl/_tmpfile.p
      200         (input  ""
      201         ,input  ".xls"
      202         ,output v-excel-file-name
      203         ) .
      204       run gbl/d-file.p
      205         (input-output v-excel-file-name
      206         ,input-output v-excel-dir-name
      207         ,input  (" Все файлы EXCEL (*.xls) ")
      208         ,input  ("*.xls":U)
      209         ,input  chr(44)
      210         ,input  (".xls":U)
      211         ,input  no
      212         ,input  yes
      213         ,input  yes
      214         ,input  "Введите имя файла"
      215         ,output v-ok
      216         ) .
      217       if v-ok <> true then do:
      218         undo, return error .
      219       end.
      220       if search(v-excel-file-name) <> ? then do:
      221         os-delete value(v-excel-file-name) .
      222       end.
      223     end.
      224     run paramls-read in this-procedure
      225       (input  "saveas"
      226       ,input  "read-password"
      227       ,input  ""
      228       ,output v-read-password
      229       ) .
      230     run paramls-read in this-procedure
      231       (input  "saveas"
      232       ,input  "write-password"
      233       ,input  ""
      234       ,output v-write-password
      235       ) .
      236     define variable v-column-list as character no-undo .
      237     run paramls-read in this-procedure
      238       (input  "charcol"
      239       ,input  ""
      240       ,input  ""
      241       ,output v-column-list
      242       ) .
      243     create "Excel.Application" chExcelApp no-error .
      244     if error-status :error then do:
      245       message
      246         "Ошибка при запуске Excel" skip
      247         error-status :get-message(1) skip
      248         view-as alert-box error .
      249       undo, return error .
      250     end.
      251     define variable v-excel-visible-char as character no-undo .
      252     run paramls-read
      253       (input "option"
      254       ,input "visible"
      255       ,input "true"
      256       ,output v-excel-visible-char
      257       ) .
      258     assign
      259       chExcelApp :Visible = lookup(v-excel-visible-char, "true,yes") > 0
      260     .
      261     assign
      262       chExcelApp :WindowState = -4143
      263       chExcelApp :Visible     = True
      264       chExcelApp :Interactive = False
      265     .
      266     assign
      267       chWorkBook = chExcelApp :Workbooks :Add()
      268     .
      269     assign
      270       chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      271     .
      272     define variable num-of-lines as integer no-undo .
      273     assign
      274     num-of-lines = chCodeModule :CountOfLines.
      275     chCodeModule:DeleteLines(1, num-of-lines).
      276     run export-macro in this-procedure
      277       (input v-rowsgroup-enable
      278       ) .
      279     for each buf_temp-param
      280       where buf_temp-param.param-code = "file"
      281     by buf_temp-param.param-sub-code descending
      282     on error undo, return error
      283     :
      284       assign
      285         file-info :file-name = buf_temp-param.param-value
      286       .
      287       assign
      288         v-excel-macro-file = file-info :full-pathname
      289       .
      290       if v-excel-macro-file = ?
      291       or v-excel-macro-file = ""
      292       then do:
      293         message
      294           vss-workfile vss-revision vss-description skip
      295           "Ошибка задания входных параметров" skip
      296           "Не найден файл" buf_temp-param.param-value skip
      297           "param-code" buf_temp-param.param-code skip
      298           "param-sub-code" buf_temp-param.param-sub-code skip
      299           view-as alert-box error .
      300         undo, next .
      301       end.
      302       assign
      303         v-ok = chWorkbook :DDEExec(v-excel-macro-file, buf_temp-param.param-sub-code, v-column-list)
      304       .
      305       define variable v-rowsgroup-sub-code as character no-undo .
      306       assign
      307         v-rowsgroup-sub-code = buf_temp-param.param-sub-code + ',':u
      308       .
      309       if v-rowsgroup-enable = true
      310       then do:
      311         define buffer buf_rowsgroup_temp-param for temp-param .
      312         for each buf_rowsgroup_temp-param
      313           where buf_rowsgroup_temp-param.param-code = 'rowsgroup':u
      314             and buf_rowsgroup_temp-param.param-sub-code begins v-rowsgroup-sub-code
      315         on error undo, return error return-value
      316         :
      317           assign
      318             v-ok = chWorkBook :rowsgroup(buf_rowsgroup_temp-param.param-value) no-error
      319           .
      320         end.
      321       end.
      322     end.
      323     for each buf_temp-param
      324       where buf_temp-param.param-code = "command"
      325     by buf_temp-param.param-sub-code
      326     on error undo, leave
      327     :
      328       assign
      329         v-ok = chWorkbook :DDEExecCommand(buf_temp-param.param-value)
      330       .
      331     end.
      332     run clear-macro in this-procedure .
      333     assign
      334       chExcelApp :DisplayAlerts = False
      335     .
      336     define variable v-default-excel-file-name as character no-undo .
      337     assign
      338       v-default-excel-file-name = chWorkBook :FullName
      339     .
      340     if  v-read-password <> ""
      341     and v-write-password <> "" then do:
      342       assign
      343         v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143  ,v-read-password ,v-write-password , , , ) no-error
      344       .
      345     end.
      346     else do:
      347       if v-write-password <> "" then do:
      348         assign
      349           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , ,v-write-password , , , ) no-error
      350         .
      351       end.
      352       else do:
      353         assign
      354           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , , , , , ) no-error
      355         .
      356       end.
      357     end.
      358     assign
      359       chExcelApp :DisplayAlerts = True
      360     .
      361     assign
      362       v-excel-file-name = chWorkBook :FullName
      363     .
      364     if v-excel-file-name = v-default-excel-file-name
      365     or v-excel-file-name = ? then do:
      366       release object chCodeModule no-error .
      367       release object chWorkBook   no-error .
      368       release object chExcelApp   no-error .
      369       message
      370         "Ошибка при сохранении файла" skip
      371         "Сохраните Excel файл вручную" skip
      372         view-as alert-box information .
      373     end.
      374     else do:
      375       assign
      376         chWorkBook :Saved = true
      377       .
      378       assign
      379         v-ok = chWorkBook :Close
      380       .
      381       release object chCodeModule no-error .
      382       release object chWorkBook   no-error .
      383       assign
      384         v-ok = chExcelApp:Quit() no-error
      385       .
      386       release object chExcelApp   no-error .
      387       run gbl/open_url.p (v-excel-file-name) .
      388     end.
      389   end.
      390   procedure append-macro-line :
      391     define input  parameter p-macro-str as character no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       assign
      396         v-ind = v-ind + 1
      397       .
      398       assign
      399         v-ok = chCodeModule :InsertLines(v-ind, p-macro-str )
      400       .
      401     end.
      402   end procedure.
      403   procedure export-test-macro :
      404     assign
      405       v-ind = 0
      406     .
      407     do
      408     on error undo, return error return-value
      409     :
      410       run append-macro-line (input 'Sub HelloWorld()').
      411       run append-macro-line (input '  MsgBox "HelloWorld"').
      412       run append-macro-line (input 'End Sub').
      413     end.
      414   end procedure.
      415   procedure export-macro :
      416     define input  parameter p-export-rowsgroup-macro as logical   no-undo .
      417     assign
      418       v-ind = 0
      419     .
      420     do
      421     on error undo, return error return-value
      422     :
      423       run append-macro-line (input 'Sub DDEExec(FileName$, SheetName$, numColList$)').
      424       run append-macro-line (input '  Application.ScreenUpdating = False').
      425       run append-macro-line (input '  Application.Interactive = False').
      426       run append-macro-line (input '  Set NewSheet = Sheets.Add(Type:=xlWorksheet)').
      427       run append-macro-line (input '  NewSheet.Name = SheetName$').
      428       run append-macro-line (input '  dim ind as long').
      429       run append-macro-line (input '  dim vshowmess as boolean').
      430       run append-macro-line (input '  vshowmess = true').
      431       run append-macro-line (input '  callList(numColList$)').
      432       run append-macro-line (input '  Open FileName$ For Input As #1').
      433       run append-macro-line (input '  ind = 0').
      434       run append-macro-line (input '  Do Until EOF(1)').
      435       run append-macro-line (input '    Line Input #1, vCommand').
      436       run append-macro-line (input '    ind = ind + 1').
      437       run append-macro-line (input '    if ind mod 3000 = 0 then').
      438       run append-macro-line (input '      Application.StatusBar = "Импорт из " & FileName$ & " Строк " & CStr(ind)').
      439       run append-macro-line (input '      Application.ScreenUpdating = True').
      440       run append-macro-line (input '      Application.ScreenUpdating = False').
      441       run append-macro-line (input '    end if').
      442       run append-macro-line (input '    On Error Resume Next').
      443       run append-macro-line (input '    ExecuteExcel4Macro (vCommand)').
      444       run append-macro-line (input '    If (Err.Number <> 0) and (vshowmess = true) Then').
      445       run append-macro-line (input '      Dim vCancelMacro As Integer').
      446       run append-macro-line (input '      vCancelMacro = MsgBox("Ошибка " & Err.Number & Chr(13) & "Команда " & vCommand & Chr(13) & "Файл " & FileName$ & Chr(13) & "Строка файла " & ind & Chr(13) & "Yes - Продолжить выполнение программы" & Chr(13) & "No - Продолжить выполнение программы и не выводить сообщения об ошибках" & Chr(13) & "Cancel - Прервать выполнение программы" & Chr(13), vbYesNoCancel)').
      447       run append-macro-line (input '      Select Case vCancelMacro').
      448       run append-macro-line (input '        Case vbYes').
      449       run append-macro-line (input '        Case vbNo').
      450       run append-macro-line (input '          vshowmess = false').
      451       run append-macro-line (input '        Case vbCancel').
      452       run append-macro-line (input '          Close #1').
      453       run append-macro-line (input '          Exit Sub').
      454       run append-macro-line (input '      End Select').
      455       run append-macro-line (input '    End If').
      456       run append-macro-line (input '    On Error GoTo 0').
      457       run append-macro-line (input '  Loop').
      458       run append-macro-line (input '  Close #1').
      459       run append-macro-line (input '  Application.StatusBar = "Импорт из " & FileName$ & " завершен"').
      460       run append-macro-line (input '  Application.ScreenUpdating = True').
      461       run append-macro-line (input '  Application.Interactive = True').
      462       run append-macro-line (input 'End Sub').
      463       run append-macro-line (input 'Sub DDEExecCommand(vCommand$)').
      464       run append-macro-line (input '   ExecuteExcel4Macro (vCommand$)').
      465       run append-macro-line (input 'End Sub').
      466       run append-macro-line (input 'Sub FormatColumnNumber(numCol As Integer)').
      467       run append-macro-line (input '  Columns(numCol).NumberFormat = "@"').
      468       run append-macro-line (input 'End Sub').
      469       run append-macro-line (input 'Sub callList(sList As String)').
      470       run append-macro-line (input '  Dim iPos0 As Integer, iPos As Integer').
      471       run append-macro-line (input '  Dim sDelimiter As String').
      472       run append-macro-line (input '  sDelimiter = ","').
      473       run append-macro-line (input '  If sList = "" Then').
      474       run append-macro-line (input '      Exit Sub').
      475       run append-macro-line (input '  End If').
      476       run append-macro-line (input '  iPos0 = 0').
      477       run append-macro-line (input '  iPos = InStr(1, sList, sDelimiter, vbBinaryCompare)').
      478       run append-macro-line (input '  If iPos = 0 Then').
      479       run append-macro-line (input '      FormatColumnNumber(Cint(sList))').
      480       run append-macro-line (input '      Exit Sub').
      481       run append-macro-line (input '  End If').
      482       run append-macro-line (input '  While True').
      483       run append-macro-line (input '      FormatColumnNumber(Cint(Mid(sList, iPos0 + 1, IIf(iPos = 0, Len(sList), iPos - iPos0 - 1))))').
      484       run append-macro-line (input '      If iPos = 0 Then').
      485       run append-macro-line (input '          Exit Sub').
      486       run append-macro-line (input '      End If').
      487       run append-macro-line (input '      iPos0 = iPos').
      488       run append-macro-line (input '      iPos = InStr(iPos + 1, sList, sDelimiter)').
      489       run append-macro-line (input '  Wend').
      490       run append-macro-line (input 'End Sub').
      491       if p-export-rowsgroup-macro = true
      492       then do:
      493         run append-macro-line (input 'Sub rowsgroup(srange As String)').
      494         run append-macro-line (input '  Rows(srange).Group').
      495         run append-macro-line (input 'End Sub').
      496       end.
      497     end.
      498   end procedure.
      499   procedure clear-macro :
      500     define variable v-num-lines as integer   no-undo .
      501     do
      502     on error undo, return error return-value
      503     :
      504       assign
      505         v-num-lines = chCodeModule :CountOfLines
      506       .
      507       chCodeModule :DeleteLines(1, v-num-lines) .
      508     end.
      509   end procedure.
