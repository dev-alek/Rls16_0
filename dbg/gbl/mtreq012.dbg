        1   block-level on error undo, throw.
        2   define input  parameter p-parparentproc as handle    no-undo .
        3   define input  parameter p-device-id     as character no-undo .
        4   define input  parameter p-user-login    as character no-undo .
        5   define input  parameter p-user-password as character no-undo .
        6   define output parameter p-logged-in     as logical   no-undo .
        7   define output parameter p-send-message  as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: mtreq012.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq012.p $":U .
       13   define variable vss-description as character no-undo init "Авторизация пользователя МТ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   do
       73   on error undo, return error return-value
       74   :
       75     define variable hdocument     as handle    no-undo .
       76     define variable hroot         as handle    no-undo .
       77     define variable hchild        as handle    no-undo .
       78     define variable htext         as handle    no-undo .
       79     define variable v-ok          as logical   no-undo .
       80     define variable v-message     as longchar  no-undo .
       81     define variable v-err-message as character no-undo .
       82     run check-data in this-procedure ( output v-ok , output v-err-message ) .
       83     create x-document hdocument.
       84     create x-noderef hroot.
       85     create x-noderef hchild.
       86     create x-noderef htext.
       87     hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
       88     hdocument:APPEND-CHILD(hRoot).
       89     hdocument:create-node(hChild, "stts", "ELEMENT").
       90     hRoot:append-child(hChild).
       91     hdocument:create-node(hText, "", "TEXT").
       92     hChild:append-child(hText).
       93     hText:node-value = substitute( "&1" , (if v-ok then 0 else 1)).
       94     hdocument:create-node(hChild, "errmsg", "ELEMENT").
       95     hRoot:append-child(hChild).
       96     hdocument:create-node(hText, "", "TEXT").
       97     hChild:append-child(hText).
       98     hText:node-value = v-err-message .
       99     hdocument:create-node(hChild, "deviceid", "ELEMENT").
      100     hRoot:append-child(hChild).
      101     hdocument:create-node(hText, "", "TEXT").
      102     hChild:append-child(hText).
      103     hText:node-value = p-device-id.
      104     hdocument:save("LONGCHAR", v-message).
      105     delete object hdocument .
      106     delete object hroot     .
      107     delete object hchild    .
      108     delete object htext     .
      109     assign
      110       hdocument = ?
      111       hroot     = ?
      112       hchild    = ?
      113       htext     = ?
      114       p-send-message = v-message
      115       p-logged-in    = v-ok
      116     .
      117   end.
      118   procedure check-data :
      119     define output parameter p-data-valid    as logical   no-undo .
      120     define output parameter p-error-message as character no-undo .
      121     define buffer buf_user        for ub._user.
      122     define buffer buf_user-login  for ub.user-login.
      123     define variable v-check-password as character no-undo .
      124   do
      125   on error undo, return error return-value
      126   :
      127     run adm/pswd-enc.p ( input encode(p-user-password)
      128                         , output v-check-password
      129                         ).
      130     assign
      131       v-check-password = encode(v-check-password)
      132     .
      133     find first buf_user no-lock
      134       where buf_user._userid = p-user-login
      135       no-error .
      136     if not available buf_user
      137     then do:
      138       assign
      139         p-data-valid = false
      140         p-error-message  = substitute( "Неизвестный пользователь &1" , p-user-login )
      141       .
      142       return .
      143     end.
      144     if buf_user._Password <> v-check-password
      145     then do:
      146       assign
      147         p-data-valid = false
      148         p-error-message  = "Неправильный пароль. "
      149       .
      150       return .
      151     end.
      152     find first buf_user-login no-lock
      153       where buf_user-login.user-login = p-user-login
      154     no-error .
      155     if available buf_user-login
      156     then do:
      157       assign
      158         p-data-valid = true
      159       .
      160     end.
      161     else do:
      162         assign
      163             p-data-valid    = false
      164             p-error-message = substitute( "Не найден пользователь &1", p-user-login)
      165         .
      166         return .
      167     end.
      168     assign
      169       p-data-valid = true
      170     .
      171   end.
      172   end procedure.
