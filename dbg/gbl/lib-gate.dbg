        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: lib-gate.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: gbl/lib-gate.p $":U .
        8   define variable vss-description as character no-undo initial "Библиотека процедур для работы GATE":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define new global shared variable g#lib-gate as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable tempcxml_v-num_ as integer no-undo .
       81   define  temp-table temp-xml-tables no-undo
       82   field order as integer
       83   field tbl-name as character
       84   field tbl-handle_ as handle
       85   field table-handle_ as handle
       86   field uniq-gate-rec as character
       87   field gate-name as character
       88   field gate-handle_ as handle
       89   field is-parent as logical
       90   index pi is unique primary
       91   uniq-gate-rec
       92   tbl-name
       93   index iorder
       94   order
       95   index gr
       96   uniq-gate-rec
       97   index gh
       98   gate-handle_
       99   index iparent
      100   is-parent
      101   .
      102   define  temp-table temp-xml-records no-undo
      103   field tbl-name as character
      104   field uniq-key-rec as character
      105   index pi is unique primary
      106   tbl-name
      107   uniq-key-rec
      108   .
      109   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   define  variable garbcoll_ii as integer no-undo .
      111   define  temp-table temp-gc no-undo
      112   field ii as integer
      113   field obj-r as handle
      114   field cn as character
      115   index pi is unique primary
      116   ii
      117   index icn
      118   cn.
      119   procedure garbcoll_create-gc-entry :
      120   define input parameter p-cn as character no-undo .
      121   define input parameter p-obj-r as handle no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       create temp-gc.
      126       assign
      127       temp-gc.ii = garbcoll_ii
      128       garbcoll_ii = garbcoll_ii + 1
      129       temp-gc.cn = p-cn
      130       temp-gc.obj-r = p-obj-r
      131       .
      132     end.
      133   end procedure.
      134   procedure garbcoll_clear :
      135     do
      136     on error undo, return error
      137     :
      138       for each temp-gc:
      139         delete object temp-gc.obj-r.
      140         delete temp-gc.
      141       end.
      142     end.
      143   end procedure.
      144   if valid-handle (g#lib-gate)
      145   and g#lib-gate <> this-procedure :handle
      146   and g#lib-gate :get-signature('lib-gate_clear-fill-option':u) <> ""
      147   then do:
      148     message
      149       vss-workfile vss-revision vss-description skip
      150       "Попытка повторной загрузки библиотеки для работы с GATE" skip
      151       g#lib-gate skip
      152       g#lib-gate :type skip
      153       g#lib-gate :file-name skip
      154       valid-handle(g#lib-gate) skip
      155       this-procedure :handle skip
      156       this-procedure :type skip
      157       this-procedure :file-name skip
      158       valid-handle(this-procedure) skip
      159       view-as alert-box error .
      160     undo, return error .
      161   end.
      162   else do:
      163     assign
      164       g#lib-gate = this-procedure :handle
      165     .
      166   end.
      167   define temp-table temp-gate no-undo
      168   field gate-handle_ as handle
      169   field uniq-gate-rec as character
      170   field schema-name as character
      171   field gate-name as character
      172   index pi is unique primary
      173   uniq-gate-rec
      174   index ischema-name
      175   schema-name
      176   .
      177   define stream outstream .
      178   define variable v-route-data_ as class Route-data_ no-undo .
      179   on delete of this-procedure do:
      180     run lib-gate_clear-gates in this-procedure .
      181     assign
      182     g#lib-gate = ?
      183     .
      184   end.
      185   procedure lib-gate_gate-start :
      186   define output parameter p-lb-handle as handle no-undo .
      187   p-lb-handle = this-procedure:handle.
      188   return ''.
      189   end procedure.
      190   procedure lib-gate_clear-gates:
      191   define buffer buf_temp-gate for temp-gate.
      192   do
      193   on error undo, return error return-value
      194   :
      195     for each buf_temp-gate where
      196     on error undo, return error :
      197       run gate-clear in this-procedure ( input buf_temp-gate.gate-handle_
      198                                         ,input buffer temp-xml-tables:handle
      199                                          ) no-error.
      200       delete buf_temp-gate.
      201     end.
      202     if valid-object(v-route-data_) then do:
      203       delete object v-route-data_.
      204     end.
      205   end.
      206   end procedure.
      207   procedure lib-gate_route-data_ :
      208   define input parameter parparentproc as widget-handle no-undo .
      209   define input parameter p-parent-handle as handle no-undo .
      210   define input parameter p-log-handle  as handle no-undo .
      211   define input parameter p-gc-handle  as handle no-undo .
      212   define output parameter p-route-data_ as class Route-data_ no-undo .
      213   main-block:
      214   do
      215   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      216   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      217   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      218   :
      219   if not valid-object(v-route-data_) then do:
      220       v-route-data_ = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input p-gc-handle, input this-procedure:handle) .
      221     p-route-data_ = v-route-data_.
      222   end.
      223   else do:
      224     v-route-data_:route-data_init ( input parparentproc, input p-parent-handle, input p-log-handle, input p-gc-handle, input this-procedure:handle).
      225     v-route-data_:route-data_clear-data().
      226     p-route-data_ = v-route-data_.
      227   end.
      228   end.
      229   end procedure.
      230   procedure lib-gate_display-gates :
      231   define input parameter p-file-name as character no-undo .
      232   do
      233   on error undo, return error
      234   :
      235     if p-file-name <> '' then do:
      236       output stream outstream to value(p-file-name).
      237       for each temp-gate:
      238         put stream outstream unformatted
      239         temp-gate.uniq-gate-rec chr(32)
      240         temp-gate.schema-name chr(32)
      241         string(temp-gate.gate-handle)
      242         skip.
      243       end.
      244       put stream outstream skip(2).
      245       for each temp-xml-tables:
      246         put stream outstream unformatted
      247         temp-xml-tables.order chr(32)
      248         temp-xml-tables.tbl-name chr(32)
      249         temp-xml-tables.gate-name chr(32)
      250         skip.
      251       end.
      252       if valid-object(v-route-data_) then do:
      253         put stream outstream unformatted
      254         "route-data_" chr(32) v-route-data_:name_ skip.
      255       end.
      256       output stream outstream close.
      257     end.
      258   end.
      259   end procedure.
      260   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263   procedure gen-key-rec :
      264     define input  parameter p-tbl-name    as character no-undo.
      265     define input  parameter p-bh_tbl-name as handle    no-undo.
      266     define output parameter p-key-rec     as character no-undo.
      267     do
      268     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      269     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      270     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      271     :
      272       define variable fh               as handle    no-undo .
      273       define variable v-ok             as logical   no-undo .
      274       define variable v-inform         as character no-undo .
      275       define variable v-ind            as integer   no-undo .
      276       define variable v-idx-field-qnty as integer   no-undo .
      277       if p-tbl-name = ?
      278         or p-tbl-name = "":U
      279       then do:
      280         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      281       end.
      282       if not p-bh_tbl-name:available then do:
      283         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      284       end.
      285       assign
      286         p-key-rec = p-tbl-name
      287         v-inform  = p-bh_tbl-name:index-information(1)
      288         v-ind     = 2
      289       .
      290       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      291       on error undo, return error
      292       :
      293         assign
      294           v-inform = p-bh_tbl-name:index-information( v-ind )
      295           v-ind    = v-ind + 1
      296         .
      297       end.
      298       if v-inform = ?
      299         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      300         or entry( 3, v-inform, ",":U ) <> "1":U
      301       then do:
      302         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      303       end.
      304       else do:
      305         assign
      306           v-idx-field-qnty = num-entries( v-inform ) - 4
      307         .
      308         if v-idx-field-qnty < 2 then do:
      309           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      310         end.
      311         do v-ind = 1 to v-idx-field-qnty by 2
      312         on error undo, return error
      313         :
      314           assign
      315             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      316             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      317           .
      318         end.
      319       end.
      320       if p-key-rec = ? then do:
      321         assign
      322           p-key-rec = "":U
      323         .
      324         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      325       end.
      326     end.
      327     return.
      328   end procedure.
      329   procedure gen-where-keyr-tab :
      330     define input  parameter i-tableSerach as character no-undo.
      331     define input  parameter i-tablekey   as character  no-undo.
      332     define input  parameter p-key-rec    as character  no-undo.
      333     define input  parameter p-key-handle as handle     no-undo .
      334     define input  parameter p-db-name    as character  no-undo .
      335     define input  parameter p-tt-handle  as handle     no-undo .
      336     define output parameter o-Where      as character  no-undo.
      337     do
      338     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      339     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      340     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      341     :
      342       define variable v-full-tbl-name  as character no-undo .
      343       define variable bh_tbl-name      as handle    no-undo .
      344       define variable fh_key           as handle    no-undo .
      345       define variable fh_search        as handle    no-undo .
      346       define variable v-field-num      as integer   no-undo .
      347       define variable v-count-fld      as integer   no-undo .
      348       define variable v-inform         as character no-undo .
      349       define variable v-ind            as integer   no-undo .
      350       define variable v-idx-field-qnty as integer   no-undo .
      351       define variable v-field-name     as character no-undo .
      352       define variable v-field-val      as character no-undo .
      353       define variable v-word-link      as character no-undo .
      354       define variable vTable           as character no-undo.
      355       define variable bh_tbl-key       as handle    no-undo .
      356       assign
      357         p-key-rec = trim( p-key-rec )
      358       .
      359       if p-key-handle <> ? then do:
      360         if not valid-handle(p-key-handle)
      361            or p-key-handle:type <> "buffer"
      362         then do:
      363           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      364         end.
      365         if num-entries( p-key-rec, chr(3) ) > 1
      366           or p-key-rec = ?
      367           or p-key-rec = "":U
      368         then do:
      369           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      370         end.
      371       end.
      372       else do:
      373         if p-key-rec = ?
      374           or p-key-rec = "":U
      375         then do:
      376           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      377         end.
      378       end.
      379       assign
      380         vTable = entry( 1 , p-key-rec, chr(3) )
      381       .
      382       if p-tt-handle <> ?
      383         and ( not valid-handle(p-tt-handle)
      384               or p-tt-handle:type <> "buffer"
      385             )
      386       then do:
      387         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      388       end.
      389       if p-tt-handle = ? then do:
      390         assign
      391           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      392         .
      393         create buffer bh_tbl-name for table v-full-tbl-name .
      394       end.
      395       else do:
      396         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      397       end.
      398       assign
      399         v-inform = bh_tbl-name:index-information(1)
      400         v-ind    = 2
      401       .
      402       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      403       on error undo, return error
      404       :
      405         assign
      406           v-inform = bh_tbl-name:index-information( v-ind )
      407           v-ind    = v-ind + 1
      408         .
      409       end.
      410       if v-inform = ?
      411         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      412         or entry( 3, v-inform, ",":U ) <> "1":U
      413       then do:
      414         delete object bh_tbl-name no-error.
      415         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      416       end.
      417       assign
      418         v-idx-field-qnty = num-entries( v-inform ) - 4
      419       .
      420       if v-idx-field-qnty < 2 then do:
      421         delete object bh_tbl-name no-error.
      422         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      423       end.
      424       assign
      425         o-where     = "where":U
      426         v-word-link = "":U
      427         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      428         v-count-fld = 0
      429       .
      430       if i-tablekey ne "" and i-tablekey ne ?
      431       then do:
      432         assign
      433           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      434         .
      435         create buffer bh_tbl-key for table v-full-tbl-name .
      436       end.
      437       if i-tableSerach ne "" and i-tableSerach ne ?
      438       then do:
      439         delete object bh_tbl-name no-error.
      440         assign
      441           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      442         .
      443         create buffer bh_tbl-name for table v-full-tbl-name .
      444       end.
      445       block_where:
      446       do v-ind = 1 to v-idx-field-qnty by 2
      447       on error undo, return error
      448       :
      449         assign
      450           v-count-fld = v-count-fld + 1
      451         .
      452         if p-key-handle = ?
      453           and v-count-fld > v-field-num
      454         then do:
      455           leave block_where.
      456         end.
      457         define variable VfieldKeyTable as handle no-undo.
      458         assign
      459           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      460           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      461         .
      462         if     bh_tbl-key ne ?
      463         then do:
      464            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      465            if VfieldKeyTable eq ?
      466            then next block_where.
      467         end.
      468         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      469         then
      470            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      471         else
      472            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      473         if p-key-handle = ? then do:
      474           assign
      475             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      476           .
      477         end.
      478         else do:
      479           assign
      480             fh_key = p-key-handle:buffer-field( v-field-name )
      481           .
      482           if fh_key = ?
      483             or not valid-handle( fh_key )
      484           then do:
      485             delete object bh_tbl-name.
      486             if     bh_tbl-key ne ?
      487             then
      488                delete object bh_tbl-key.
      489             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      490           end.
      491           assign
      492             v-field-val = fh_key:buffer-value
      493           .
      494         end.
      495         if fh_search:data-type ="character":U then do:
      496           assign
      497             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      498             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      499             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      500             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      501             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      502             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      503             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      504             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      505             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      506             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      507             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      508             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      509             v-field-val = substitute( '"&1"', v-field-val )
      510           .
      511         end.
      512         assign
      513           o-where = substitute( "&1 &2", o-where, v-field-val )
      514         .
      515         if v-word-link = "":U then do:
      516           assign
      517             v-word-link = "and":U
      518           .
      519         end.
      520       end.
      521       delete object bh_tbl-name.
      522       if     bh_tbl-key ne ?
      523       then
      524          delete object bh_tbl-key.
      525       if p-key-handle = ?
      526         and v-count-fld <> v-field-num
      527       then do:
      528         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      529       end.
      530     end.
      531   end procedure.
      532   procedure gen-hn-keyr-tab :
      533     define input  parameter i-tableSerach as character no-undo.
      534     define input  parameter i-tablekey   as character no-undo.
      535     define input  parameter p-key-rec    as character no-undo.
      536     define input  parameter p-key-handle as handle    no-undo .
      537     define input  parameter p-db-name    as character no-undo .
      538     define input  parameter p-tt-handle  as handle    no-undo .
      539     define input  parameter p-stts-lock  as integer   no-undo .
      540     define output parameter o-hn         as handle    no-undo.
      541     define variable v-full-tbl-name as character no-undo.
      542     define variable v-where         as character no-undo.
      543     define variable bh_tbl-name     as handle    no-undo.
      544     define variable vTable          as character no-undo.
      545     do
      546     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      547     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      548     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      549         run gen-where-keyr-tab(i-tableSerach,
      550                                i-tablekey,
      551                                p-key-rec,
      552                                p-key-handle,
      553                                p-db-name,
      554                                p-tt-handle,
      555                                output v-where).
      556         if i-tableSerach ne "" and i-tableSerach ne ?
      557         then do:
      558            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      559            create buffer bh_tbl-name for table v-full-tbl-name .
      560         end.
      561         else do:
      562            if p-tt-handle = ? then do:
      563               assign
      564                  vTable = entry( 1 , p-key-rec, chr(3) )
      565               .
      566               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      567               create buffer bh_tbl-name for table v-full-tbl-name .
      568            end.
      569            else do:
      570               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      571            end.
      572         end.
      573         if p-tt-handle = ? then do:
      574            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      575         end.
      576         else do:
      577            bh_tbl-name:find-first( v-where ) no-error .
      578         end.
      579         o-hn = bh_tbl-name.
      580      end.
      581   end procedure.
      582   procedure gen-hn-keyr :
      583     define input  parameter p-key-rec    as character no-undo.
      584     define input  parameter p-key-handle as handle    no-undo .
      585     define input  parameter p-db-name    as character no-undo .
      586     define input  parameter p-tt-handle  as handle    no-undo .
      587     define input  parameter p-stts-lock  as integer   no-undo .
      588     define output parameter o-hn         as handle    no-undo.
      589     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      590   end.
      591   procedure gen-row-keyr :
      592     define input  parameter p-key-rec    as character no-undo.
      593     define input  parameter p-key-handle as handle    no-undo .
      594     define input  parameter p-db-name    as character no-undo .
      595     define input  parameter p-tt-handle  as handle    no-undo .
      596     define input  parameter p-stts-lock  as integer   no-undo .
      597     define output parameter p-tbl-row    as rowid     no-undo.
      598     define output parameter p-tbl-name   as character no-undo.
      599     define variable vHn as handle no-undo.
      600       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      601       p-tbl-row = if vHn:available then vHn:rowid else ?.
      602       p-tbl-name =  vHn:table.
      603       delete object vHn no-error.
      604     if p-tbl-row = ? then do:
      605       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      606     end.
      607     else do:
      608       return.
      609     end.
      610   end procedure.
      611   procedure gen-key-fv :
      612     define input  parameter p-key-rec    as character no-undo .
      613     define output parameter p-field-list as character no-undo .
      614     define output parameter p-value-list as character no-undo.
      615     do
      616     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      617     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      618     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      619     :
      620       define variable v-full-tbl-name  as character no-undo .
      621       define variable bh_tbl-name      as handle    no-undo .
      622       define variable v-tbl-name       as character no-undo .
      623       define variable v-field-num      as integer   no-undo .
      624       define variable v-count-fld      as integer   no-undo .
      625       define variable v-inform         as character no-undo .
      626       define variable v-ind            as integer   no-undo .
      627       define variable v-idx-field-qnty as integer   no-undo .
      628       define variable v-delim-key      as character no-undo .
      629       if p-key-rec = ?
      630         or p-key-rec = "":U
      631       then do:
      632         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      633       end.
      634       assign
      635         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      636         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      637       .
      638       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      639       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      640       assign
      641         v-inform = bh_tbl-name:index-information(1)
      642         v-ind    = 2
      643       .
      644       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      645       on error undo, return error
      646       :
      647         assign
      648           v-inform = bh_tbl-name:index-information( v-ind )
      649           v-ind    = v-ind + 1
      650         .
      651       end.
      652       if v-inform = ?
      653         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      654         or entry( 3, v-inform, ",":U ) <> "1":U
      655       then do:
      656         delete object bh_tbl-name no-error.
      657         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      658       end.
      659       assign
      660         v-idx-field-qnty = num-entries( v-inform ) - 4
      661       .
      662       if v-idx-field-qnty < 2 then do:
      663         delete object bh_tbl-name no-error.
      664         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      665       end.
      666       assign
      667         p-field-list = "":U
      668         p-value-list = "":U
      669         v-delim-key  = "":U
      670         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      671         v-count-fld  = 0
      672       .
      673       block_where:
      674       do v-ind = 1 to v-idx-field-qnty by 2
      675       on error undo, return error
      676       :
      677         assign
      678           v-count-fld = v-count-fld + 1
      679         .
      680         if v-count-fld > v-field-num then do:
      681           leave block_where.
      682         end.
      683         assign
      684           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      685           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      686         .
      687         if v-ind = 1 then do:
      688           assign
      689             v-delim-key = chr(3)
      690           .
      691         end.
      692       end.
      693       delete object bh_tbl-name.
      694       if v-count-fld <> v-field-num then do:
      695         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      696       end.
      697     end.
      698   end procedure.
      699   procedure gen-key-field :
      700     define input  parameter p-table      as character no-undo .
      701     define output parameter p-field-list as character no-undo .
      702     do
      703     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      704     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      705     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      706     :
      707       define variable v-full-tbl-name  as character no-undo .
      708       define variable bh_tbl-name      as handle    no-undo .
      709       define variable v-tbl-name       as character no-undo .
      710       define variable v-field-num      as integer   no-undo .
      711       define variable v-count-fld      as integer   no-undo .
      712       define variable v-inform         as character no-undo .
      713       define variable v-ind            as integer   no-undo .
      714       define variable v-idx-field-qnty as integer   no-undo .
      715       define variable v-delim-key      as character no-undo .
      716       if p-table = ?
      717         or p-table = "":U
      718       then do:
      719         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      720       end.
      721       assign
      722         v-tbl-name      = p-table
      723         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      724       .
      725       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      726       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      727       assign
      728         v-inform = bh_tbl-name:index-information(1)
      729         v-ind    = 2
      730       .
      731       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      732       on error undo, return error
      733       :
      734         assign
      735           v-inform = bh_tbl-name:index-information( v-ind )
      736           v-ind    = v-ind + 1
      737         .
      738       end.
      739       if v-inform = ?
      740         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      741         or entry( 3, v-inform, ",":U ) <> "1":U
      742       then do:
      743         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      744       end.
      745       assign
      746         v-idx-field-qnty = num-entries( v-inform ) - 4
      747       .
      748       if v-idx-field-qnty < 2 then do:
      749         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      750       end.
      751       assign
      752         p-field-list = "":U
      753         v-delim-key  = "":U
      754         v-count-fld  = 0
      755       .
      756       block_where:
      757       do v-ind = 1 to v-idx-field-qnty by 2
      758       on error undo, return error
      759       :
      760         assign
      761           v-count-fld = v-count-fld + 1
      762         .
      763         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      764         if v-ind = 1 then do:
      765           assign
      766             v-delim-key = chr(3)
      767           .
      768         end.
      769       end.
      770       delete object bh_tbl-name.
      771     end.
      772   end procedure.
      773   procedure get-gate-file-name :
      774   define input parameter p-gate-rec as character no-undo .
      775   define output  parameter p-gate-file-name as character no-undo .
      776   define buffer buf_clob-data for ub.clob-data.
      777   define variable v-tbl-row as rowid no-undo .
      778   define variable v-tbl-name as character no-undo .
      779   run gen-row-keyr in this-procedure ( input p-gate-rec
      780                                       ,input ?
      781                                       ,input "ub"
      782                                       ,input ?
      783                                       ,input no-lock
      784                                       ,output v-tbl-row
      785                                       ,output v-tbl-name) no-error.
      786   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      787                                                           ,vss-include-info2
      788                                                           ,p-gate-rec).
      789   find first buf_clob-data no-lock where
      790             rowid(buf_clob-data) = v-tbl-row no-error.
      791   if not available buf_clob-data then do:
      792     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      793                                                             ,vss-include-info2
      794                                                             ,p-gate-rec).
      795   end.
      796   p-gate-file-name = buf_clob-data.file-name.
      797   end procedure.
      798   procedure get-gate-rec :
      799   define input  parameter p-gate-name as character no-undo .
      800   define output parameter p-gate-rec as character no-undo .
      801   define buffer buf_clob-bind for ub.clob-bind.
      802   define buffer buf_clob-data for ub.clob-data.
      803   main-block:
      804   do
      805   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      806   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      807   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      808   :
      809       find first buf_clob-bind no-lock where
      810                 buf_clob-bind.uniq-key-rec = p-gate-name
      811             and buf_clob-bind.field-name = '':U
      812             and buf_clob-bind.part-num = 1
      813             and buf_clob-bind.resource-type = 'gate':U
      814             no-error.
      815       if not available buf_clob-bind then do:
      816         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      817                                         , p-gate-name
      818                                         ).
      819       end.
      820       find first buf_clob-data no-lock where
      821                 buf_clob-data.db-num = buf_clob-bind.db-num
      822             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      823       if not available buf_clob-data then do:
      824         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      825                                         , buf_clob-bind.db-num
      826                                         , buf_clob-bind.int64-id
      827                                         , p-gate-name
      828                                         ).
      829       end.
      830       run gen-key-rec in this-procedure ( input 'clob-data':U
      831                                 ,input buffer buf_clob-data:handle
      832                                 ,output p-gate-rec).
      833   end.
      834   end procedure.
      835   procedure get-gate-by-name :
      836   define input  parameter p-gate-name as character no-undo .
      837   define output parameter p-gate-rec as character no-undo .
      838   define output parameter p-dsh as handle no-undo .
      839   define input-output  parameter p-xmlh as handle no-undo .
      840   define variable v-ii as integer   no-undo .
      841   define variable glog as logical   no-undo .
      842   define variable v-longchar as longchar no-undo .
      843   define variable v-txmlh as handle no-undo .
      844   define variable v-db-num as integer no-undo .
      845   define variable v-int64-id as int64 no-undo .
      846   define buffer buf_clob-bind for ub.clob-bind.
      847   define buffer buf_clob-data for ub.clob-data.
      848   main-block:
      849   do
      850   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      851   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      852   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      853   :
      854     define buffer buf_temp-gate for temp-gate.
      855     define variable v-field-list as character no-undo .
      856     define variable v-value-list as character no-undo .
      857     find first buf_temp-gate where
      858               buf_temp-gate.schema-name = p-gate-name no-error.
      859     if available buf_temp-gate then do:
      860       run gen-key-fv in this-procedure ( input buf_temp-gate.uniq-gate-rec
      861                                        ,output v-field-list
      862                                        ,output v-value-list).
      863       assign
      864       v-db-num = integer(entry(lookup("db-num":U
      865                                         , v-field-list
      866                                         , chr(3))
      867                                   , v-value-list, chr(3)))
      868       v-int64-id = int64(entry(lookup("int64-id":U
      869                                         , v-field-list
      870                                         , chr(3))
      871                                   , v-value-list, chr(3)))
      872       no-error .
      873       find first buf_clob-bind no-lock where
      874                 buf_clob-bind.uniq-key-rec = p-gate-name
      875             and buf_clob-bind.field-name = '':U
      876             and buf_clob-bind.part-num = 1
      877             and buf_clob-bind.resource-type = 'gate':U
      878             and buf_clob-bind.db-num = v-db-num
      879             and buf_clob-bind.int64-id = v-int64-id
      880             no-error.
      881      if available buf_clob-bind then do:
      882         p-gate-rec = buf_temp-gate.uniq-gate-rec.
      883         p-dsh = buf_temp-gate.gate-handle_.
      884         p-xmlh = (if not valid-handle(p-xmlh)
      885                   then buffer temp-xml-tables:handle
      886                   else p-xmlh).
      887         return.
      888       end.
      889     end.
      890       find first buf_clob-bind no-lock where
      891                 buf_clob-bind.uniq-key-rec = p-gate-name
      892             and buf_clob-bind.field-name = '':U
      893             and buf_clob-bind.part-num = 1
      894             and buf_clob-bind.resource-type = 'gate':U
      895             no-error.
      896       if not available buf_clob-bind then do:
      897         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      898                                         , p-gate-name
      899                                         ).
      900       end.
      901       find first buf_clob-data no-lock where
      902                 buf_clob-data.db-num = buf_clob-bind.db-num
      903             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      904       if not available buf_clob-data then do:
      905         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      906                                         , buf_clob-bind.db-num
      907                                         , buf_clob-bind.int64-id
      908                                         , p-gate-name
      909                                         ).
      910       end.
      911       assign
      912       v-longchar = buf_clob-data.cdata
      913       .
      914       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
      915       if error-status :error then do:
      916         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
      917       end.
      918       create dataset p-dsh .
      919       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
      920                                     , v-longchar
      921                                     , ?
      922                                     , ?
      923                                     , ?
      924                                     ) no-error.
      925       v-longchar = '':U.
      926       if error-status :error
      927       or not glog
      928       then do:
      929         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
      930       end.
      931       if not valid-handle(p-xmlh)
      932       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
      933         create temp-table v-txmlh.
      934         v-txmlh:create-like(buffer temp-xml-tables:handle).
      935         v-txmlh:temp-table-prepare("temp-xml-tables").
      936         p-xmlh = v-txmlh:default-buffer-handle.
      937       end.
      938       run gen-key-rec in this-procedure ( input 'clob-data':U
      939                                 ,input buffer buf_clob-data:handle
      940                                 ,output p-gate-rec).
      941       do v-ii = 1 to p-dsh:num-buffers:
      942         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
      943         if not p-xmlh:available then do:
      944           p-xmlh:buffer-create().
      945           assign
      946           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
      947           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
      948           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
      949           p-xmlh::gate-handle_ = p-dsh
      950           p-xmlh::uniq-gate-rec = p-gate-rec
      951           p-xmlh::gate-name = p-dsh:name
      952           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
      953           .
      954           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
      955             assign
      956             p-xmlh::order = -3.
      957           end.
      958         end.
      959       end.
      960         create buf_temp-gate.
      961         assign
      962         buf_temp-gate.gate-handle_ = p-dsh
      963         buf_temp-gate.uniq-gate-rec = p-gate-rec
      964         buf_temp-gate.schema-name = p-gate-name
      965         .
      966   end.
      967   end procedure.
      968   procedure get-gate-by-rec :
      969   define input  parameter p-gate-rec as character no-undo .
      970   define output parameter p-dsh as handle no-undo .
      971   define input-output  parameter p-xmlh as handle no-undo .
      972   define input-output parameter p-longchar  as longchar no-undo .
      973   define variable v-ii as integer   no-undo .
      974   define variable glog as logical   no-undo .
      975   define variable v-rowid as rowid no-undo .
      976   define variable v-tbl-name as character no-undo .
      977   define variable v-longchar as longchar no-undo .
      978   define variable v-txmlh as handle no-undo .
      979   define buffer buf_clob-data for ub.clob-data.
      980   main-block:
      981   do
      982   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
      983   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
      984   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
      985   :
      986     define buffer buf_temp-gate for temp-gate.
      987     find first buf_temp-gate where
      988               buf_temp-gate.uniq-gate-rec = p-gate-rec no-error.
      989     if available buf_temp-gate then do:
      990         p-gate-rec = buf_temp-gate.uniq-gate-rec.
      991         p-dsh = buf_temp-gate.gate-handle_.
      992         p-xmlh = (if not valid-handle(p-xmlh)
      993                   then buffer temp-xml-tables:handle
      994                   else p-xmlh).
      995         return.
      996     end.
      997     run gen-row-keyr in this-procedure (
      998                                           input  p-gate-rec
      999                                           ,input  ?
     1000                                           ,input  "ub"
     1001                                           ,input  ?
     1002                                           ,input  NO-LOCK
     1003                                           ,output v-rowid
     1004                                           ,output v-tbl-name   ) no-error.
     1005       find first buf_clob-data no-lock where
     1006                 rowid(buf_clob-data) = v-rowid  no-error.
     1007       if not available buf_clob-data then do:
     1008         undo, return error substitute("Не найден CLOB  &1"
     1009                                         , p-gate-rec
     1010                                         ).
     1011       end.
     1012       assign
     1013       v-longchar = buf_clob-data.cdata
     1014       .
     1015       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1016       if error-status :error then do:
     1017         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1018       end.
     1019       create dataset p-dsh .
     1020       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1021                                     , v-longchar
     1022                                     , ?
     1023                                     , ?
     1024                                     , ?
     1025                                     ) no-error.
     1026       define variable v-esm as character no-undo .
     1027       v-esm = error-status:get-message(1) .
     1028       if p-longchar <> ? then do:
     1029         p-longchar = v-longchar.
     1030       end.
     1031       v-longchar = '':U.
     1032       if error-status :error
     1033       or not glog
     1034       then do:
     1035         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1036                                      , p-gate-rec
     1037                                      , p-gate-rec
     1038                                      , v-esm
     1039                                      ).
     1040       end.
     1041       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1042       if not valid-handle(p-xmlh)
     1043       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1044         create temp-table v-txmlh.
     1045         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1046         v-txmlh:temp-table-prepare("temp-xml-tables").
     1047         p-xmlh = v-txmlh:default-buffer-handle.
     1048       end.
     1049       do v-ii = 1 to p-dsh:num-buffers:
     1050         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1051         if not p-xmlh:available then do:
     1052           p-xmlh:buffer-create().
     1053           assign
     1054           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1055           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1056           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1057           p-xmlh::gate-handle_ = p-dsh
     1058           p-xmlh::uniq-gate-rec = p-gate-rec
     1059           p-xmlh::gate-name = p-dsh:name
     1060           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1061           .
     1062           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1063             assign
     1064             p-xmlh::order = -3.
     1065           end.
     1066           p-xmlh:buffer-release().
     1067         end.
     1068       end.
     1069   end.
     1070   end procedure.
     1071   procedure get-gate-by-file :
     1072   define input  parameter p-schema-file-name as character no-undo .
     1073   define input  parameter p-gate-rec as character no-undo .
     1074   define output parameter p-dsh as handle no-undo .
     1075   define input-output  parameter p-xmlh as handle no-undo .
     1076   define variable v-ii as integer   no-undo .
     1077   define variable glog as logical   no-undo .
     1078   define variable v-rowid as rowid no-undo .
     1079   define variable v-tbl-name as character no-undo .
     1080   define variable v-longchar as longchar no-undo .
     1081   define variable v-txmlh as handle no-undo .
     1082   main-block:
     1083   do
     1084   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1))
     1085   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info2 )
     1086   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info2 )
     1087   :
     1088       COPY-LOB
     1089       FROM  FILE p-schema-file-name
     1090       TO  OBJECT v-longchar
     1091       no-convert
     1092       NO-ERROR .
     1093       if error-status :error then do:
     1094           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1095                                     , p-schema-file-name
     1096                                 , chr(10)
     1097                                 , error-status:get-message(1) ).
     1098       end.
     1099       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1100       if error-status :error then do:
     1101         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1102       end.
     1103       create dataset p-dsh .
     1104       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1105                                     , v-longchar
     1106                                     , ?
     1107                                     , ?
     1108                                     , ?
     1109                                     ) no-error.
     1110       v-longchar = ''.
     1111       if error-status :error
     1112       or not glog
     1113       then do:
     1114         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1115                                      , p-schema-file-name
     1116                                      ,chr(10)
     1117                                      , error-status:get-message(1)
     1118                                      ).
     1119       end.
     1120       if not valid-handle(p-xmlh)
     1121       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1122         create temp-table v-txmlh.
     1123         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1124         v-txmlh:temp-table-prepare("temp-xml-tables").
     1125         p-xmlh = v-txmlh:default-buffer-handle.
     1126       end.
     1127       do v-ii = 1 to p-dsh:num-buffers:
     1128         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1129                                      ,p-dsh:get-buffer-handle(v-ii):name
     1130                                      ,p-gate-rec
     1131                                      )) no-error.
     1132         if not p-xmlh:available then do:
     1133           p-xmlh:buffer-create().
     1134           assign
     1135           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1136           p-xmlh::uniq-gate-rec = p-gate-rec
     1137           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1138           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1139           p-xmlh::gate-handle_ = p-dsh
     1140           p-xmlh::gate-name = p-dsh:name
     1141           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1142           .
     1143           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1144             assign
     1145             p-xmlh::order = -3.
     1146           end.
     1147           p-xmlh:buffer-release().
     1148         end.
     1149       end.
     1150   end.
     1151   end procedure.
     1152   procedure gate-clear :
     1153   define input  parameter p-dsh as handle no-undo .
     1154   define input  parameter p-xmlh as handle no-undo .
     1155   define variable v-dsh as handle no-undo .
     1156   define variable v-th as handle no-undo .
     1157     do
     1158     on error undo, return error return-value
     1159     :
     1160       if valid-handle(p-dsh) then do:
     1161         delete object p-dsh.
     1162         v-dsh = p-dsh.
     1163         p-dsh = ?.
     1164       end.
     1165       repeat while true:
     1166         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1167                            , share-lock) no-error.
     1168         if p-xmlh:available then do:
     1169           assign
     1170           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1171           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1172           and valid-handle(v-th)
     1173           and v-th:dynamic = yes
     1174           then do:
     1175             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1176             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1177           end.
     1178           p-xmlh:buffer-delete().
     1179         end.
     1180         else do:
     1181           leave.
     1182         end.
     1183       end.
     1184       if p-xmlh:dynamic = yes
     1185       and valid-handle(p-xmlh)
     1186       then do:
     1187         delete object p-xmlh:table-handle.
     1188         p-xmlh = ?.
     1189       end.
     1190       v-dsh = ?.
     1191     end.
     1192   end procedure.
     1193   procedure all-gates-clear :
     1194   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1195   do
     1196   on error undo, return error
     1197   :
     1198     for each buf_temp-xml-tables
     1199     break
     1200     by buf_temp-xml-tables.uniq-gate-rec
     1201     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1202     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1203     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1204     :
     1205         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1206           delete object buf_temp-xml-tables.gate-handle_.
     1207           buf_temp-xml-tables.gate-handle_ = ?.
     1208         end.
     1209         if valid-handle(buf_temp-xml-tables.table-handle_)
     1210         and buf_temp-xml-tables.table-handle_:dynamic = no
     1211         then do:
     1212           delete object buf_temp-xml-tables.table-handle_.
     1213           buf_temp-xml-tables.table-handle_ = ?.
     1214         end.
     1215         delete buf_temp-xml-tables.
     1216     end.
     1217   end.
     1218   end procedure.
     1219   procedure fix-schemalocation :
     1220   define input-output  parameter p-longchar as longchar no-undo .
     1221   DEFINE VARIABLE hdoc AS HANDLE.
     1222   DEFINE VARIABLE hroot AS HANDLE.
     1223   DEFINE VARIABLE hnode-child AS HANDLE.
     1224   DEFINE VARIABLE hnode-attr AS HANDLE.
     1225   define variable v-jj as integer   no-undo .
     1226   define variable ok as logical   no-undo .
     1227   define variable v-path1                    as character                no-undo .
     1228   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1229   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1230   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1231   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1232   define variable v-schema-location          as character                no-undo .
     1233   do
     1234   on error undo, return error return-value
     1235   :
     1236     CREATE X-DOCUMENT hdoc.
     1237     CREATE X-noderef hroot.
     1238     CREATE X-noderef hnode-child.
     1239     CREATE X-noderef hnode-attr.
     1240     hdoc:load("longchar", p-longchar, no) no-error.
     1241     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1242     hdoc:get-document-element(hroot).
     1243     _repeat:
     1244     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1245       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1246       if not ok then next.
     1247       if hNode-Child:local-name = "include"
     1248       then do:
     1249         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1250           v-schema-location = hnode-attr:node-value.
     1251           run gbl/filename.p (
     1252                           input "exe/" + hnode-attr:node-value
     1253                         ,output v-full-path1
     1254                         ,output v-path1
     1255                         ,output v-file-name1
     1256                         ,output v-file-name-no-ext1
     1257                         ,output v-file-name-ext1
     1258                         ) no-error .
     1259           if error-status :error then do:
     1260             delete object hnode-attr.
     1261             delete object hnode-child.
     1262             delete object hroot.
     1263             delete object hdoc.
     1264             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1265           end.
     1266         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1267         leave  _repeat.
     1268       end.
     1269     END.
     1270     hdoc:save("longchar", p-longchar).
     1271     delete object hnode-attr.
     1272     delete object hnode-child.
     1273     delete object hroot.
     1274     delete object hdoc.
     1275   end.
     1276   end procedure.
     1277   procedure gate-clb_fill-xml-tables :
     1278   define input parameter p-dsh as handle no-undo .
     1279   define input-output parameter p-xmlh as handle no-undo .
     1280   define variable v-ii as integer no-undo .
     1281     do
     1282     on error undo, return error
     1283     :
     1284       do v-ii = 1 to p-dsh:num-buffers:
     1285         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1286         if not p-xmlh:available then do:
     1287           p-xmlh:buffer-create().
     1288           assign
     1289           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1290           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1291           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1292           p-xmlh::gate-handle_ = p-dsh
     1293           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1294           p-xmlh::gate-name = p-dsh:name
     1295           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1296           .
     1297           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1298             assign
     1299             p-xmlh::order = -3.
     1300           end.
     1301           p-xmlh:buffer-release().
     1302         end.
     1303       end.
     1304     end.
     1305   end procedure.
     1306   procedure all-gates-empty :
     1307   define buffer buf_temp-xml-tables for temp-xml-tables.
     1308   do
     1309   on error undo, return error
     1310   :
     1311     for each buf_temp-xml-tables
     1312     break
     1313     by buf_temp-xml-tables.uniq-gate-rec
     1314     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1315     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1316     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1317     :
     1318       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1319         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1320       end.
     1321     end.
     1322   end.
     1323   end procedure.
