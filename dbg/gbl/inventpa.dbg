     1001   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1002   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1003   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   on help of frame Dialog-Frame
     1005   do:
     1006     run gbl/app_help.p
     1007       (input this-procedure :file-name
     1008       ,input ''
     1009       ,input ?
     1010       ) no-error.
     1011     if error-status :error then do:
     1012       message
     1013         "Ошибка при вызове помощи"
     1014         error-status :get-message(1)
     1015         view-as alert-box .
     1016     end.
     1017   end.
     1018   run minbtn-set in this-procedure .
     1019   on choose of b-help in frame Dialog-Frame
     1020   do:
     1021     apply "help":u to frame Dialog-Frame .
     1022   end.
     1023   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   procedure minbtn-set :
     1025       do
     1026           on error undo, return error return-value
     1027           :
     1028           define variable ii              as integer       no-undo .
     1029           define variable fh              as widget-handle no-undo .
     1030           define variable hh              as widget-handle no-undo .
     1031           define variable v-h             as handle        extent 4 no-undo .
     1032           define variable v-name-button   as character     no-undo .
     1033           define variable v-help-old-x    as decimal       no-undo .
     1034           define variable v-help-old-y    as decimal       no-undo .
     1035           define variable v-help-old-size as decimal       no-undo .
     1036           define variable v-frame-width   as decimal       no-undo .
     1037           define variable jj              as integer       no-undo .
     1038           do
     1039               on error undo, return error
     1040               :
     1041               assign
     1042                   v-frame-width = frame Dialog-Frame:width - 0.3
     1043                   fh            = frame Dialog-Frame:first-child
     1044                   hh            = fh:first-child
     1045                   ii            = 1
     1046                   .
     1047               do while valid-handle(hh):
     1048                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1049                   do:
     1050                       case lc(hh:name) :
     1051                           when "b-help" then
     1052                               do:
     1053                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1054                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1055                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1056                                   hh:TOOLTIP = "Помощь" .
     1057                                   v-help-old-x = hh:column .
     1058                                   v-help-old-y = hh:row    .
     1059                                   v-help-old-size = hh:width .
     1060                                   hh:width-chars = 2.5 .
     1061                               end.
     1062                           when "b-print" then
     1063                               do:
     1064                                   hh:load-image("cmp/b-print.bmp":u) .
     1065                                   hh:TOOLTIP = "Печать" .
     1066                                   v-h[ii] = hh:handle .
     1067                                   ii = ii + 1 .
     1068                                   hh:width-chars = 3 .
     1069                               end.
     1070                           when "b-history" or
     1071                           when "b-hist" then
     1072                               do:
     1073                                   hh:load-image("cmp/b-hist.bmp":u) .
     1074                                   hh:TOOLTIP = "История" .
     1075                                   v-h[ii] = hh:handle .
     1076                                   ii = ii + 1 .
     1077                                   hh:width-chars = 3 .
     1078                               end.
     1079                           when "b-sch" then
     1080                               do:
     1081                                   hh:load-image("cmp/b-sch.bmp":u) .
     1082                                   hh:TOOLTIP = "Установка Фильтра" .
     1083                                   v-h[ii] = hh:handle .
     1084                                   ii = ii + 1 .
     1085                                   hh:width-chars = 3 .
     1086                               end.
     1087                           when "b-hist-user" then
     1088                               do:
     1089                                   hh:load-image("cmp/b-hist.bmp":u) .
     1090                                   hh:TOOLTIP = "История пользователя" .
     1091                                   ii = ii + 1 .
     1092                               end.
     1093                       end case.
     1094                   end.
     1095                   hh = hh:next-sibling.
     1096               end.
     1097               b-help:column = v-frame-width - b-help:width-chars.
     1098               jj = 0.
     1099               repeat ii = 4 to 1 by -1 :
     1100                   if valid-handle (v-h[ii] ) then
     1101                   do:
     1102                       jj  = jj + 1 .
     1103                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1104                       v-h[ii]:row    = v-help-old-y .
     1105                   end.
     1106               end.
     1107           end.
     1108       end.
     1109   end procedure.
     1110   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   on ' ' of mxpcdcp in frame Dialog-Frame
     1112   do:
     1113     if (can-query (self, "sensitive")
     1114        and
     1115        self :sensitive = true
     1116        )
     1117     or (can-query (self, "read-only")
     1118        and
     1119        self :read-only = false
     1120        )
     1121     then do:
     1122       assign
     1123         self :screen-value = ?
     1124       .
     1125     end.
     1126     return no-apply.
     1127   end.
     1128   on delete-character of mxpcdcp in frame Dialog-Frame
     1129   do:
     1130     if (can-query (self, "sensitive")
     1131        and
     1132        self :sensitive = true
     1133        )
     1134     or (can-query (self, "read-only")
     1135        and
     1136        self :read-only = false
     1137        )
     1138     then do:
     1139       assign
     1140         self :screen-value = ?
     1141       .
     1142     end.
     1143     return no-apply.
     1144   end.
     1145   on ctrl-d of mxpcdcp in frame Dialog-Frame
     1146   do:
     1147     define variable v-curr-sv-date as date no-undo .
     1148     if (can-query (self, "sensitive")
     1149        and
     1150        self :sensitive = true
     1151        )
     1152     or (can-query (self, "read-only")
     1153        and
     1154        self :read-only = false
     1155        )
     1156     then do:
     1157       if self :handle <> focus :handle
     1158       then do:
     1159         apply "entry":u to self .
     1160       end.
     1161       run gbl/getcurdt.p
     1162         (output v-curr-sv-date
     1163         ) .
     1164       assign
     1165         self :screen-value = string(v-curr-sv-date) .
     1166       .
     1167     end.
     1168     return no-apply.
     1169   end.
     1170   on ctrl-b of mxpcdcp in frame Dialog-Frame
     1171   do:
     1172     if (can-query (self, "sensitive")
     1173        and
     1174        self :sensitive = true
     1175        )
     1176     or (can-query (self, "read-only")
     1177        and
     1178        self :read-only = false
     1179        )
     1180     then do:
     1181       if self :handle <> focus :handle
     1182       then do:
     1183         apply "entry":u to self .
     1184       end.
     1185       define variable v-curr-sv-date as date no-undo .
     1186       define variable v-new-sv-date  as date no-undo .
     1187       assign
     1188         v-curr-sv-date = date(self :screen-value) no-error
     1189       .
     1190       if v-curr-sv-date = ?
     1191       then do:
     1192         run gbl/getcurdt.p
     1193           (output v-curr-sv-date
     1194           ) .
     1195       end.
     1196       if v-curr-sv-date <> ?
     1197       then do:
     1198         assign
     1199           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1200         .
     1201         assign
     1202           self :screen-value = string(v-new-sv-date) .
     1203         .
     1204       end.
     1205     end.
     1206     return no-apply .
     1207   end.
     1208   on ctrl-e of mxpcdcp in frame Dialog-Frame
     1209   do:
     1210     if (can-query (self, "sensitive")
     1211        and
     1212        self :sensitive = true
     1213        )
     1214     or (can-query (self, "read-only")
     1215        and
     1216        self :read-only = false
     1217        )
     1218     then do:
     1219       if self :handle <> focus :handle
     1220       then do:
     1221         apply "entry":u to self .
     1222       end.
     1223       define variable v-curr-sv-date as date no-undo .
     1224       define variable v-new-sv-date  as date no-undo .
     1225       assign
     1226         v-curr-sv-date = date(self :screen-value) no-error
     1227       .
     1228       if v-curr-sv-date = ?
     1229       then do:
     1230         run gbl/getcurdt.p
     1231           (output v-curr-sv-date
     1232           ) .
     1233       end.
     1234       if v-curr-sv-date <> ?
     1235       then do:
     1236         run gbl/lastdate.p
     1237           (input  v-curr-sv-date
     1238           ,output v-new-sv-date
     1239           ).
     1240         assign
     1241           self :screen-value = string(v-new-sv-date) .
     1242         .
     1243       end.
     1244     end.
     1245     return no-apply .
     1246   end.
     1247   on ctrl-f of mxpcdcp in frame Dialog-Frame
     1248   do:
     1249     if (can-query (self, "sensitive")
     1250        and
     1251        self :sensitive = true
     1252        )
     1253     or (can-query (self, "read-only")
     1254        and
     1255        self :read-only = false
     1256        )
     1257     then do:
     1258       if self :handle <> focus :handle
     1259       then do:
     1260         apply "entry":u to self .
     1261       end.
     1262       define variable v-ok            as logical   no-undo .
     1263       define variable v-curr-sv-date  as date      no-undo .
     1264       define variable v-description   as character no-undo .
     1265       assign
     1266         v-curr-sv-date = date(self :screen-value) no-error
     1267       .
     1268       if v-curr-sv-date = ?
     1269       then do:
     1270         run gbl/getcurdt.p
     1271           (output v-curr-sv-date
     1272           ) .
     1273       end.
     1274       if v-curr-sv-date <> ?
     1275       then do:
     1276         run gbl/d-inpday.w
     1277           (input ?
     1278           ,input "Выбор даты"
     1279           ,input v-description
     1280           ,input ""
     1281           ,input-output v-curr-sv-date
     1282           ,output v-ok
     1283           ).
     1284         if v-ok = true
     1285         then do:
     1286           assign
     1287             self :screen-value = string(v-curr-sv-date) .
     1288           .
     1289         end.
     1290       end.
     1291     end.
     1292     return no-apply .
     1293   end.
     1294     define MENU m-ed-date8
     1295       MENU-ITEM m-ed-date8-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1296       MENU-ITEM m-ed-date8-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1297       MENU-ITEM m-ed-date8-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1298       MENU-ITEM m-ed-date8-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
