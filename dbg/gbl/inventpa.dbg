     1317           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1318         .
     1319       end.
     1320     end.
     1321     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
     1322       apply "ctrl-b":U to mxpcdcp in frame Dialog-Frame .
     1323     END.
     1324     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
     1325       apply "ctrl-d":U to mxpcdcp in frame Dialog-Frame .
     1326     END.
     1327     ON CHOOSE OF MENU-ITEM m-ed-date8-3 in menu m-ed-date8 DO:
     1328       apply "ctrl-e":U to mxpcdcp in frame Dialog-Frame .
     1329     END.
     1330     ON CHOOSE OF MENU-ITEM m-ed-date8-4 in menu m-ed-date8 DO:
     1331       apply "ctrl-f":U to mxpcdcp in frame Dialog-Frame .
     1332     END.
     1333   MAIN-BLOCK:
     1334   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1335      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1336   if p-obj-type <> "" then
     1337      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
     1338   define variable loc#log as logical   no-undo .
     1339   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   do:
     1341     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1342       (input  g#db-num
     1343       ,input  g#userid
     1344       ,input  0
     1345       ,input  'actn_nakl-par_lookup':U
     1346       ,input  'object':U
     1347       ,input  v-cntxt-host-code-obj
     1348       ,input  v-cntxt-obj-type
     1349       ,input  v-cntxt-obj-code
     1350       ,input  0
     1351       ,input  0
     1352       ,input  0
     1353       ,input  true
     1354       ,output loc#log
     1355       )  .
     1356   end.
     1357      if loc#log <> yes then do: return error. end.
     1358       run init-tt.
     1359       run enable_UI.
     1360       run init-proc.
     1361     WAIT-FOR GO OF FRAME Dialog-Frame.
     1362   END.
     1363   run disable_UI.
     1364   PROCEDURE disable_UI :
     1365     HIDE FRAME Dialog-Frame.
     1366   END PROCEDURE.
     1367   PROCEDURE enable_UI :
     1368     DISPLAY invclcsp invdnull pstunqtn invclcas invclcwt inv-prs wastage mxpcdcp
     1369             mxpcicp mxsmdcp mxsmicp pstgrp pstunit izlcstpr minus v-invclcsp
     1370             v-invdnull v-pstunqtn v-invclcas v-invclcwt v-inv-prs v-wastage
     1371             v-mxpcdcp v-mxpcicp v-mxsmdcp v-mxsmicp v-pstgrp v-pstunit v-izlcstpr
     1372             v-minus
     1373         WITH FRAME Dialog-Frame.
     1374     ENABLE B-exit I-mxpcdcp I-invclcsp I-invdnull I-pstunqtn I-mxsmdcp I-mxsmicp
     1375            I-wastage I-mxpcicp I-invclcwt I-invclcas I-inv-prs I-pstgrp I-pstunit
     1376            I-izlcstpr I-minus B-quit B-Help B-2 invclcsp B-3 invdnull B-4
     1377            pstunqtn invclcas invclcwt inv-prs B-7 wastage B-1 mxpcdcp B-9 mxpcicp
     1378            B-5 mxsmdcp B-6 mxsmicp B-8 pstgrp B-11 pstunit B-10 izlcstpr B-12
     1379            minus v-invclcsp v-invdnull v-pstunqtn v-invclcas v-invclcwt
     1380            v-inv-prs v-wastage v-mxpcdcp v-mxpcicp v-mxsmdcp v-mxsmicp v-pstgrp
     1381            v-pstunit v-izlcstpr v-minus
     1382         WITH FRAME Dialog-Frame.
     1383     VIEW FRAME Dialog-Frame.
     1384   END PROCEDURE.
     1385   PROCEDURE fill-widgets :
     1386   define variable v-value-character as character no-undo .
     1387   define variable v-value-date as date no-undo .
     1388   define variable v-value-decimal as decimal no-undo .
     1389   define variable v-value-integer as INTEGER no-undo .
     1390   define variable v-value-logical AS LOGICAL no-undo .
     1391   define variable v-param-type as character no-undo .
     1392   define variable v-param-value as character no-undo .
     1393   for each thbjattr_thbj-attr:
     1394     delete thbjattr_thbj-attr.
     1395   end.
     1396   for each thbjattr_thbj-attr-g:
     1397     delete thbjattr_thbj-attr-g.
     1398   end.
     1399   for each temp-thbj-attr:
     1400     delete temp-thbj-attr.
     1401   end.
     1402   run adm/shattri.p (
     1403       input "init":U
     1404     , input p-obj-type
     1405     , input p-obj-code
     1406     , input 'inv-obj':U
     1407     , input "":U
     1408     , output v-value-character
     1409     , output v-value-date
     1410     , output v-value-decimal
     1411     , output v-value-integer
     1412     , output v-value-logical
     1413     , output v-param-type
     1414     , input-output TABLE-HANDLE v-tth
     1415     ) no-error .
     1416   if error-status:error then do:
     1417     message
     1418     "Не удалось получить начальные значения настроек" skip
     1419     error-status:get-message(1) return-value
     1420     view-as alert-box error .
     1421     undo, return error .
     1422   end.
     1423   run adm/shattri.p (
     1424       input "init":U
     1425     , input ""
     1426     , input 0
     1427     , input 'inv-global':U
     1428     , input "":U
     1429     , output v-value-character
     1430     , output v-value-date
     1431     , output v-value-decimal
     1432     , output v-value-integer
     1433     , output v-value-logical
     1434     , output v-param-type
     1435     , input-output TABLE-HANDLE v-tthg
     1436     ) no-error .
     1437   if error-status:error then do:
     1438     message
     1439     "Не удалось получить начальные значения настроек" skip
     1440     error-status:get-message(1) return-value
     1441     view-as alert-box error .
     1442     undo, return error .
     1443   end.
     1444   FOR EACH thbjattr_thbj-attr-g
     1445   :
     1446   IF thbjattr_thbj-attr-g.prop-code = 'invclcwt':U THEN DO:     invclcwt = thbjattr_thbj-attr-g.property-value-logical.     invclcwt:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display invclcwt with frame Dialog-Frame . END.
     1447   IF thbjattr_thbj-attr-g.prop-code = 'invclcas':U THEN DO:     invclcas = thbjattr_thbj-attr-g.property-value-logical.     invclcas:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display invclcas with frame Dialog-Frame . END.
     1448   IF thbjattr_thbj-attr-g.prop-code = 'inv-prs':U THEN DO:     inv-prs = thbjattr_thbj-attr-g.property-value-integer.     inv-prs:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display inv-prs with frame Dialog-Frame . END.
     1449     create temp-thbj-attr.
     1450     buffer-copy thbjattr_thbj-attr-g to temp-thbj-attr.
     1451   end.
     1452   FOR EACH thbjattr_thbj-attr
     1453   :
     1454   IF thbjattr_thbj-attr.prop-code = 'mxpcdcp':U THEN DO:     mxpcdcp = thbjattr_thbj-attr.property-value-decimal.     mxpcdcp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display mxpcdcp with frame Dialog-Frame . END.
     1455   IF thbjattr_thbj-attr.prop-code = 'invclcsp':U THEN DO:     invclcsp = thbjattr_thbj-attr.property-value-logical.     invclcsp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display invclcsp with frame Dialog-Frame . END.
     1456   IF thbjattr_thbj-attr.prop-code = 'invdnull':U THEN DO:     invdnull = thbjattr_thbj-attr.property-value-logical.     invdnull:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display invdnull with frame Dialog-Frame . END.
     1457   IF thbjattr_thbj-attr.prop-code = 'pstunqtn':U THEN DO:     pstunqtn = thbjattr_thbj-attr.property-value-logical.     pstunqtn:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display pstunqtn with frame Dialog-Frame . END.
     1458   IF thbjattr_thbj-attr.prop-code = 'mxsmdcp':U THEN DO:     mxsmdcp = thbjattr_thbj-attr.property-value-decimal.     mxsmdcp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display mxsmdcp with frame Dialog-Frame . END.
     1459   IF thbjattr_thbj-attr.prop-code = 'mxsmicp':U THEN DO:     mxsmicp = thbjattr_thbj-attr.property-value-decimal.     mxsmicp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display mxsmicp with frame Dialog-Frame . END.
     1460   IF thbjattr_thbj-attr.prop-code = 'wastage':U THEN DO:     wastage = thbjattr_thbj-attr.property-value-logical.     wastage:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display wastage with frame Dialog-Frame . END.
     1461   IF thbjattr_thbj-attr.prop-code = 'pstgrp':U THEN DO:     pstgrp = thbjattr_thbj-attr.property-value-logical.     pstgrp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display pstgrp with frame Dialog-Frame . END.
     1462   IF thbjattr_thbj-attr.prop-code = 'pstunit':U THEN DO:     pstunit = thbjattr_thbj-attr.property-value-logical.     pstunit:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display pstunit with frame Dialog-Frame . END.
     1463   IF thbjattr_thbj-attr.prop-code = 'mxpcicp':U THEN DO:     mxpcicp = thbjattr_thbj-attr.property-value-decimal.     mxpcicp:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display mxpcicp with frame Dialog-Frame . END.
     1464   IF thbjattr_thbj-attr.prop-code = 'izlcstpr':U THEN DO:     izlcstpr = thbjattr_thbj-attr.property-value-logical.     izlcstpr:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display izlcstpr with frame Dialog-Frame . END.
     1465   IF thbjattr_thbj-attr.prop-code = 'minus':U THEN DO:     minus = thbjattr_thbj-attr.property-value-logical.     minus:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr)).     display minus with frame Dialog-Frame . END.
     1466     create temp-thbj-attr.
     1467     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1468   END.
     1469   define variable v-tooltip as character no-undo .
     1470   define variable v-label   as character no-undo .
     1471   define variable v-tooltip-code as character no-undo .
     1472   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "mxpcdcp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-mxpcdcp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-mxpcdcp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1473   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "invclcsp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invclcsp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invclcsp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1474   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "mxsmdcp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-mxsmdcp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-mxsmdcp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1475   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "mxsmicp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-mxsmicp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-mxsmicp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1476   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "invdnull"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invdnull:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invdnull:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1477   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "pstunqtn"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-pstunqtn:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-pstunqtn:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1478   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "wastage"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-wastage:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-wastage:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1479   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "pstgrp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-pstgrp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-pstgrp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1480   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "pstunit"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-pstunit:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-pstunit:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1481   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "mxpcicp"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-mxpcicp:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-mxpcicp:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1482   run thbjattr_tooltip in this-procedure (    input   'inv-global':U   ,input  "invclcwt"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invclcwt:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invclcwt:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1483   run thbjattr_tooltip in this-procedure (    input   'inv-global':U   ,input  "invclcas"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-invclcas:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-invclcas:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1484   run thbjattr_tooltip in this-procedure (    input   'inv-global':U   ,input  "inv-prs"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-inv-prs:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-inv-prs:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1485   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "izlcstpr"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-izlcstpr:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-izlcstpr:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1486   run thbjattr_tooltip in this-procedure (    input   'inv-obj':U   ,input  "minus"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-minus:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  I-minus:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1487   END PROCEDURE.
     1488   PROCEDURE init-proc :
     1489   define variable v-i as integer   no-undo .
     1490   define variable v-value-character as character no-undo .
     1491   define variable v-value-date as date no-undo .
     1492   define variable v-value-decimal as decimal no-undo .
     1493   define variable v-value-integer as INTEGER no-undo .
     1494   define variable v-value-logical AS LOGICAL no-undo .
     1495   define variable v-type as character no-undo .
     1496   define variable v-value as character no-undo .
     1497   define variable v-found as decimal   no-undo .
     1498     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1499       find first obj_thbj-attr exclusive-lock where
     1500                 obj_thbj-attr.obj-type = p-obj-type
     1501           and   obj_thbj-attr.obj-code = p-obj-code
     1502           and   obj_thbj-attr.upper-prop-code = 'inv-obj':U
     1503           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
     1504        if locked obj_thbj-attr then do:
     1505           message
     1506           vss-workfile vss-revision vss-description skip
     1507           'inv-obj':U skip
     1508           "Запись ПАРАМЕТРОВ  занята"
     1509           view-as alert-box error .
     1510           undo, return error.
     1511         end.
     1512       find first glb_thbj-attr exclusive-lock where
     1513                 glb_thbj-attr.obj-type = ""
     1514           and   glb_thbj-attr.obj-code = 0
     1515           and   glb_thbj-attr.upper-prop-code = 'inv-global':U
     1516           and   glb_thbj-attr.prop-code = '':u no-wait no-error.
     1517        if locked glb_thbj-attr then do:
     1518           message
     1519           vss-workfile vss-revision vss-description skip
     1520           'inv-global':U skip
     1521           "Запись Глобальных ПАРАМЕТРОВ  занята"
     1522           view-as alert-box error .
     1523           undo, return error.
     1524         end.
     1525     end.
     1526     else do:
     1527       find first obj_thbj-attr no-lock where
     1528             obj_thbj-attr.obj-type = p-obj-type
     1529       and   obj_thbj-attr.obj-code = p-obj-code
     1530       and   obj_thbj-attr.upper-prop-code = 'inv-obj':U
     1531       and   obj_thbj-attr.prop-code = '':u no-error.
     1532       find first glb_thbj-attr no-lock where
     1533             glb_thbj-attr.obj-type = ""
     1534       and   glb_thbj-attr.obj-code = 0
     1535       and   glb_thbj-attr.upper-prop-code = 'inv-global':U
     1536       and   glb_thbj-attr.prop-code = '':u no-error.
     1537     end.
     1538     if not available obj_thbj-attr then do:
     1539       assign
     1540         v-to-create-trn  = true
     1541         .
     1542       message
     1543       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1544                   chr(10))
     1545                    view-as alert-box warning.
     1546     end.
     1547     if not available glb_thbj-attr then do:
     1548       assign
     1549         v-to-create-trn-g  = true
     1550         .
     1551       message
     1552       substitute ("Внимание!!!&1Гл.Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1553                   chr(10))
     1554                    view-as alert-box warning.
     1555     end.
     1556     run fill-widgets in this-procedure no-error.
     1557     if error-status:error then undo, return error.
     1558     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1559        disable
     1560        mxpcdcp
     1561        invclcsp
     1562        mxsmdcp
     1563        mxsmicp
     1564        invdnull
     1565        pstunqtn
     1566        wastage
     1567        mxpcicp
     1568        invclcwt
     1569        invclcas
     1570        inv-prs
     1571        pstgrp
     1572        pstunit
     1573        izlcstpr
     1574        minus
     1575        with frame Dialog-Frame.
     1576        B-exit:label = "Вы&ход"  .
     1577        hide B-quit in frame Dialog-Frame .
     1578     END.
     1579     if not ( p-obj-type = "" and p-obj-code = 0 ) then do:
     1580        disable
     1581          pstgrp
     1582          invclcwt
     1583          invclcas
     1584          inv-prs
     1585        with frame Dialog-Frame.
     1586     end.
     1587   end procedure.
     1588   PROCEDURE init-tt :
     1589   END PROCEDURE.
     1590   PROCEDURE save-proc :
     1591   define variable v-value-character as character no-undo .
     1592   define variable v-value-date as date no-undo .
     1593   define variable v-value-decimal as decimal no-undo .
     1594   define variable v-value-integer as INTEGER no-undo .
     1595   define variable v-value-logical AS LOGICAL no-undo .
     1596   define variable v-sale-add as character no-undo .
     1597   define variable v-trf-type like ub.clients.obj-type no-undo .
     1598   define variable v-trf-code like ub.clients.obj-code no-undo .
     1599   define variable v-param-type as character no-undo .
     1600   define variable wh as widget-handle no-undo .
     1601   define variable fh as widget-handle no-undo .
     1602   define variable v-same as logical no-undo .
     1603   define variable v-sameg as logical no-undo .
     1604   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1605   define variable loc#log as logical   no-undo .
     1606   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   do:
     1608     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1609       (input  g#db-num
     1610       ,input  g#userid
     1611       ,input  0
     1612       ,input  'actn_nakl-par_update':U
     1613       ,input  'object':U
     1614       ,input  v-cntxt-host-code-obj
     1615       ,input  v-cntxt-obj-type
     1616       ,input  v-cntxt-obj-code
     1617       ,input  0
     1618       ,input  0
     1619       ,input  0
     1620       ,input  true
     1621       ,output loc#log
     1622       )  .
     1623   end.
     1624     if loc#log <> yes then do: return error. end.
     1625   ASSIGN
     1626       mxpcdcp FRAME Dialog-Frame
     1627       invclcsp
     1628       mxsmdcp
     1629       mxsmicp
     1630       invdnull
     1631       pstunqtn
     1632       wastage
     1633       mxpcicp
     1634       invclcwt
     1635       invclcas
     1636       inv-prs
     1637       pstgrp
     1638       pstunit
     1639       izlcstpr
     1640       minus
     1641    .
     1642   assign
     1643     fh = frame Dialog-Frame:first-child
     1644     wh = fh:first-child
     1645     .
     1646   do while valid-handle(wh):
     1647     if wh:private-data begins "recid2=" then do:
     1648       find first thbjattr_thbj-attr where
     1649                  recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '='))
     1650                  no-error .
     1651       if available thbjattr_thbj-attr then do:
     1652       assign
     1653       buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1654              thbjattr_thbj-attr.obj-type = p-obj-type.
     1655              thbjattr_thbj-attr.obj-code = p-obj-code.
     1656       end.
     1657     end.
     1658     if wh:private-data begins "recid3=" then do:
     1659       find first thbjattr_thbj-attr-g where
     1660                  recid(thbjattr_thbj-attr-g) = integer(entry(2, wh:private-data, '='))
     1661                  no-error .
     1662       if available thbjattr_thbj-attr-g then do:
     1663       assign
     1664       buffer thbjattr_thbj-attr-g:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1665       end.
     1666     end.
     1667     wh = wh:next-sibling.
     1668   end.
     1669   v-same = yes.
     1670   for each thbjattr_thbj-attr where
     1671            thbjattr_thbj-attr.obj-type = p-obj-type and
     1672            thbjattr_thbj-attr.obj-code = p-obj-code ,
     1673       first temp-thbj-attr where
     1674             temp-thbj-attr.obj-type = p-obj-type
     1675         and temp-thbj-attr.obj-code = p-obj-code
     1676         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1677         and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code :
     1678      buffer-compare
     1679      thbjattr_thbj-attr
     1680      to temp-thbj-attr
     1681      save result in v-same.
     1682      if not v-same then leave.
     1683   end.
     1684   v-same = no.
     1685   v-sameg = yes.
     1686   for each thbjattr_thbj-attr-g ,
     1687       first temp-thbj-attr where
     1688             temp-thbj-attr.obj-type = ""
     1689         and temp-thbj-attr.obj-code = 0
     1690         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-g.upper-prop-code
     1691         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-g.prop-code :
     1692      buffer-compare
     1693      thbjattr_thbj-attr-g
     1694      to temp-thbj-attr
     1695      save result in v-sameg.
     1696      if not v-sameg then leave.
     1697   end.
     1698   v-sameg = no.
     1699   do transaction
     1700   on error undo, return error return-value
     1701   :
     1702     run thbjattr_set-section in this-procedure (
     1703           input p-obj-type
     1704         , input p-obj-code
     1705         , input 'inv-obj':U
     1706         , input table thbjattr_thbj-attr
     1707     ) no-error.
     1708     if error-status:error then do:
     1709       message error-status:get-message(1)  skip
     1710       return-value
     1711       view-as alert-box.
     1712       undo, return error.
     1713     end.
     1714     if p-obj-type = "" and p-obj-code = 0  then do:
     1715         run thbjattr_set-section in this-procedure (
     1716               input p-obj-type
     1717             , input p-obj-code
     1718             , input 'inv-global':U
     1719             , input table thbjattr_thbj-attr-g
     1720         ) no-error.
     1721         if error-status:error then do:
     1722           message error-status:get-message(1)  skip
     1723           return-value
     1724           view-as alert-box.
     1725           undo, return error.
     1726         end.
     1727     end.
     1728   end.
     1729   END PROCEDURE.
