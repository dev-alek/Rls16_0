     1302       ASSIGN
     1303         mxpcdcp :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
     1304         mxpcdcp :MENU-MOUSE in frame Dialog-Frame = 3
     1305       .
     1306     end.
     1307     define variable v-label-handle8 as handle no-undo .
     1308     assign
