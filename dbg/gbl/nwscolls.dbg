        1   DEFINE BUFFER buF_BatchProcess FOR ub.BatchProcess.
        2   DEFINE BUFFER X_db FOR ub.db.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter bttns as character no-undo .
        5   define input parameter p-mode as character no-undo .
        6   define input parameter p-db-num like ub.db.db-num no-undo .
        7   define input parameter p-subject as character no-undo .
        8   define input parameter p-uniq-key-rec as character no-undo .
        9   define input-output param p-rid-list    as  char no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Список неразобранных коллизий, возникших в СПН".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   define new global shared variable g#library  as handle no-undo .
      325   define new global shared variable g#library2 as handle no-undo .
      326   procedure proc-alt-shift-f2:
      327     if not ibs.th.gbl.gbl-var:rcode
      328   then
      329     run gbl\inidebug.p .
      330   end.
      331   procedure proc-alt-shift-f3:
      332     run gbl/prvssinf.p
      333       ( input this-procedure
      334       ) .
      335   end.
      336   define variable v-inform-launched as logical no-undo initial false .
      337   procedure proc-alt-shift-f4:
      338     define variable v-action as character no-undo .
      339     if v-inform-launched = false then do:
      340       assign
      341         v-inform-launched = true
      342       .
      343       run gbl/d-inform.w
      344         (  input self
      345         ,  input this-procedure
      346         , output v-action
      347         ) no-error .
      348       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      349       assign
      350         v-inform-launched = false
      351       .
      352     end.
      353   end.
      354   procedure proc-alt-f1:
      355     run gbl/corrhelp.p
      356       (input this-procedure
      357       ) .
      358   end .
      359   on alt-shift-f2 anywhere do:
      360     run proc-alt-shift-f2.
      361   end.
      362   on alt-shift-f3 anywhere do:
      363     run proc-alt-shift-f3 in this-procedure .
      364   end.
      365   on alt-shift-f4 anywhere do:
      366     run proc-alt-shift-f4 in this-procedure.
      367   end.
      368   on alt-f1 anywhere do:
      369     run proc-alt-f1 in this-procedure .
      370   end.
      371   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   procedure progs-name :
      373     define input  parameter p-action-code         as character no-undo .
      374     define output parameter p-main-prog-name      as character no-undo .
      375     define output parameter p-list-db-proc-name   as character no-undo .
      376     define output parameter p-commit-proc-name    as character no-undo .
      377     define output parameter p-execution-proc-name as character no-undo .
      378     define output parameter p-recover-proc-name   as character no-undo .
      379     define output parameter p-after-proc-name     as character no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       case p-action-code :
      384               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      385               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      386               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      387               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      388               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      389               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      390               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      391               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      392               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      393               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      394               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      395               otherwise do:
      396           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      397         end.
      398       end case.
      399     end.
      400     return.
      401   end procedure.
      402   procedure progs-title :
      403     define input  parameter p-action-code         as character no-undo .
      404     define output parameter p-action-title      as character no-undo .
      405     do
      406     on error undo, return error
      407     :
      408       case p-action-code :
      409               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      410               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      411               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      412               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      413               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      414               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      415               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      416               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      417               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      418               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      419               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      420               otherwise do:
      421           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      422         end.
      423       end case.
      424     end.
      425     return.
      426   end procedure.
      427   FUNCTION progs-title-function returns character(
      428      input  p-action-code         as character):
      429   define variable p-action-title      as character no-undo .
      430     do
      431     on error undo, return error
      432     :
      433       case p-action-code :
      434               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      435               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      436               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      437               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      438               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      439               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      440               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      441               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      442               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      443               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      444               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      445               otherwise do:
      446           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info1, p-action-code ).
      447         end.
      448       end case.
      449     end.
      450     return p-action-title.
      451   end FUNCTION.
      452   procedure get-row-keyr-string :
      453    define input  parameter p-key-rec  as character no-undo.
      454    define output parameter p-tbl-title as character no-undo.
      455    define output parameter p-rec-string  as character no-undo.
      456     do
      457     on error undo, return error
      458     :
      459       define variable v-full-tbl-name as character no-undo .
      460       define variable bh_tbl-name     as handle    no-undo .
      461       define variable fh              as handle    no-undo .
      462       define variable v-ok            as logical   no-undo .
      463       define variable v-field-num     as integer   no-undo .
      464       define variable v-count-fld     as integer   no-undo .
      465       define variable v-tbl-name as character no-undo.
      466       if p-key-rec = ?
      467         or p-key-rec = "":U
      468       then do:
      469         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      470       end.
      471       assign
      472         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      473         v-full-tbl-name = "ub.":U + v-tbl-name
      474         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      475         p-rec-string         = "":U
      476         v-count-fld     = 0
      477       .
      478       find ub._file
      479         where ub._file._file-name = v-tbl-name
      480         no-error.
      481       if not available ub._file then do:
      482         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info1, v-tbl-name ).
      483       end.
      484       assign
      485       p-tbl-title = ub._file._file-label
      486       .
      487       find ub._index
      488         where recid( ub._index  ) = ub._file._prime-index
      489         no-error.
      490       if not available ub._index
      491         or LC( ub._index._index-name ) = "default":U
      492       then do:
      493         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      494       end.
      495       block_where :
      496       for each ub._index-field of ub._index  ,
      497           each ub._field of _index-field
      498           break by _index-seq
      499       on error undo, return error
      500       :
      501         assign
      502           v-count-fld = v-count-fld + 1
      503         .
      504         if v-count-fld > v-field-num then do:
      505           leave block_where.
      506         end.
      507         if p-rec-string = "":U then do:
      508           assign
      509             p-rec-string = "":U
      510           .
      511         end.
      512         else do:
      513           assign
      514             p-rec-string = p-rec-string + chr(32) + chr(44)
      515           .
      516         end.
      517         assign
      518           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      519         .
      520       end.
      521       if v-count-fld <> v-field-num then do:
      522         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      523       end.
      524     end.
      525     return.
      526   end procedure.
      527   FUNCTION uniq-key-rec-string-f returns character(
      528      input  p-uniq-key-rec         as character):
      529   define variable v-tbl-title as character no-undo .
      530   define variable v-rec-string as character no-undo .
      531     do
      532     on error undo, return error
      533     :
      534       run get-row-keyr-string in this-procedure (
      535                                                 input p-uniq-key-rec
      536                                                 ,output v-tbl-title
      537                                                 ,output v-rec-string).
      538       assign
      539       v-rec-string = (if v-tbl-title <> ? and
      540                       v-tbl-title <> "":U
      541                       then (v-tbl-title + ":")
      542                      else "":U) + chr(32) + v-rec-string
      543       .
      544     end.
      545     return v-rec-string.
      546   end FUNCTION.
      547   procedure create_db-rec_route :
      548     define input parameter p1-uniq-key-rec as character no-undo .
      549     define input parameter p1-action       as character no-undo .
      550     define input parameter p1-operation    as character no-undo .
      551     define input parameter p1-send-db-list as character no-undo .
      552     define input parameter p1-db-init      as integer   no-undo .
      553     define input parameter p1-parameters   as character no-undo .
      554     define input parameter p1-answer-code  as integer   no-undo .
      555     define input parameter p1-answer-msg   as character no-undo .
      556     do
      557     on error undo, return error
      558     :
      559       define variable v-command     as character no-undo .
      560       define variable v-ind         as integer   no-undo .
      561       define variable v-num-entries as integer   no-undo .
      562       define variable v-curr-db     as integer   no-undo .
      563       define variable v-db-for-send as character no-undo .
      564       define variable v-db-num      as integer   no-undo .
      565       define variable v-db-num-char as character no-undo .
      566       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      567       find first buf_sys-ctrl no-lock .
      568       assign
      569         v-curr-db     = buf_sys-ctrl.db-num
      570         v-db-for-send = "":U
      571       .
      572       if v-curr-db = 0 then do:
      573         if p1-answer-code >= 0 then do:
      574           if v-curr-db <> p1-db-init then do:
      575             assign
      576               v-db-for-send = string( p1-db-init )
      577             .
      578           end.
      579         end.
      580         else do:
      581           assign
      582             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      583           .
      584           do v-ind = 1 to v-num-entries:
      585             assign
      586               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      587               v-db-num      = integer( v-db-num-char )
      588             .
      589             if v-db-num <> v-curr-db
      590               and v-db-num <> p1-db-init
      591             then do:
      592               if v-db-for-send = "":U then do:
      593                 assign
      594                   v-db-for-send = v-db-num-char
      595                 .
      596               end.
      597               else do:
      598                 assign
      599                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      600                 .
      601               end.
      602             end.
      603           end.
      604         end.
      605       end.
      606       else do:
      607         assign
      608           v-db-for-send = "0":U
      609         .
      610       end.
      611       if v-db-for-send <> "":U then do:
      612         assign
      613           v-command = "command":U + chr(1)
      614                       + "two-commit":U + chr(1)
      615                       + p1-action + chr(1)
      616                       + p1-operation + chr(1)
      617                       + p1-uniq-key-rec + chr(1)
      618                       + string( p1-db-init ) + chr(1)
      619                       + p1-parameters + chr(1)
      620                       + string( p1-answer-code ) + chr(1)
      621                       + p1-answer-msg
      622         .
      623         run nws/cr-route.p ( input 'send-cmd':U
      624                       ,input v-command
      625                       ,input ?
      626                       ,input v-db-for-send
      627                       ) no-error .
      628         if error-status :error then do:
      629           return error return-value.
      630         end.
      631       end.
      632     end.
      633     return.
      634   end procedure.
      635   procedure create_msg_route :
      636     define input parameter p2-send-db-list as character no-undo .
      637     define input parameter p2-msg          as character no-undo .
      638     do
      639     on error undo, return error
      640     :
      641       define variable v-msg-command as character no-undo .
      642       define variable v-ind         as integer   no-undo .
      643       define variable v-num-entries as integer   no-undo .
      644       define variable v-curr-db     as integer   no-undo .
      645       define variable v-db-for-send as character no-undo .
      646       define variable v-db-num      as integer   no-undo .
      647       define variable v-db-num-char as character no-undo .
      648       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      649       find first buf_sys-ctrl no-lock .
      650       assign
      651         v-curr-db     = buf_sys-ctrl.db-num
      652         v-db-for-send = "":U
      653       .
      654       if v-curr-db = 0 then do:
      655         assign
      656           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      657         .
      658         do v-ind = 1 to v-num-entries:
      659           assign
      660             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      661             v-db-num      = integer( v-db-num-char )
      662           .
      663           if v-db-num <> v-curr-db then do:
      664             if v-db-for-send = "":U then do:
      665               assign
      666                 v-db-for-send = v-db-num-char
      667               .
      668             end.
      669             else do:
      670               assign
      671                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      672               .
      673             end.
      674           end.
      675         end.
      676       end.
      677       else do:
      678         assign
      679           v-db-for-send = "0":U
      680         .
      681       end.
      682       if v-db-for-send <> "":U then do:
      683         assign
      684           v-msg-command = "command":U + chr(1)
      685                           + "message-to-log":U + chr(1)
      686                           + p2-msg
      687         .
      688         run nws/cr-route.p ( input 'send-cmd':U
      689                       ,input v-msg-command
      690                       ,input ?
      691                       ,input v-db-for-send
      692                       ) no-error .
      693         if error-status :error then do:
      694           return error substitute( "&1&2&3"
      695                                     , return-value
      696                                     , chr(10)
      697                                     , error-status :get-message(1)
      698                                   ).
      699         end.
      700       end.
      701     end.
      702     return.
      703   end procedure.
      704   function get-send-db-list returns character
      705     ( input p-curr-db     as integer
      706      ,input p-all-db-list as character
      707     )
      708   :
      709     define variable v-send-db-list as character no-undo .
      710     if p-curr-db = 0 then do:
      711       assign
      712         v-send-db-list = p-all-db-list
      713       .
      714     end.
      715     else do:
      716       assign
      717         v-send-db-list = string(p-curr-db)
      718       .
      719     end.
      720     return v-send-db-list .
      721   end function .
      722   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      723   procedure gen-key-rec :
      724     define input  parameter p-tbl-name    as character no-undo.
      725     define input  parameter p-bh_tbl-name as handle    no-undo.
      726     define output parameter p-key-rec     as character no-undo.
      727     do
      728     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      729     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      730     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      731     :
      732       define variable fh               as handle    no-undo .
      733       define variable v-ok             as logical   no-undo .
      734       define variable v-inform         as character no-undo .
      735       define variable v-ind            as integer   no-undo .
      736       define variable v-idx-field-qnty as integer   no-undo .
      737       if p-tbl-name = ?
      738         or p-tbl-name = "":U
      739       then do:
      740         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      741       end.
      742       if not p-bh_tbl-name:available then do:
      743         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      744       end.
      745       assign
      746         p-key-rec = p-tbl-name
      747         v-inform  = p-bh_tbl-name:index-information(1)
      748         v-ind     = 2
      749       .
      750       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      751       on error undo, return error
      752       :
      753         assign
      754           v-inform = p-bh_tbl-name:index-information( v-ind )
      755           v-ind    = v-ind + 1
      756         .
      757       end.
      758       if v-inform = ?
      759         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      760         or entry( 3, v-inform, ",":U ) <> "1":U
      761       then do:
      762         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      763       end.
      764       else do:
      765         assign
      766           v-idx-field-qnty = num-entries( v-inform ) - 4
      767         .
      768         if v-idx-field-qnty < 2 then do:
      769           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      770         end.
      771         do v-ind = 1 to v-idx-field-qnty by 2
      772         on error undo, return error
      773         :
      774           assign
      775             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      776             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      777           .
      778         end.
      779       end.
      780       if p-key-rec = ? then do:
      781         assign
      782           p-key-rec = "":U
      783         .
      784         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      785       end.
      786     end.
      787     return.
      788   end procedure.
      789   procedure gen-where-keyr-tab :
      790     define input  parameter i-tableSerach as character no-undo.
      791     define input  parameter i-tablekey   as character  no-undo.
      792     define input  parameter p-key-rec    as character  no-undo.
      793     define input  parameter p-key-handle as handle     no-undo .
      794     define input  parameter p-db-name    as character  no-undo .
      795     define input  parameter p-tt-handle  as handle     no-undo .
      796     define output parameter o-Where      as character  no-undo.
      797     do
      798     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      799     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      800     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      801     :
      802       define variable v-full-tbl-name  as character no-undo .
      803       define variable bh_tbl-name      as handle    no-undo .
      804       define variable fh_key           as handle    no-undo .
      805       define variable fh_search        as handle    no-undo .
      806       define variable v-field-num      as integer   no-undo .
      807       define variable v-count-fld      as integer   no-undo .
      808       define variable v-inform         as character no-undo .
      809       define variable v-ind            as integer   no-undo .
      810       define variable v-idx-field-qnty as integer   no-undo .
      811       define variable v-field-name     as character no-undo .
      812       define variable v-field-val      as character no-undo .
      813       define variable v-word-link      as character no-undo .
      814       define variable vTable           as character no-undo.
      815       define variable bh_tbl-key       as handle    no-undo .
      816       assign
      817         p-key-rec = trim( p-key-rec )
      818       .
      819       if p-key-handle <> ? then do:
      820         if not valid-handle(p-key-handle)
      821            or p-key-handle:type <> "buffer"
      822         then do:
      823           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      824         end.
      825         if num-entries( p-key-rec, chr(3) ) > 1
      826           or p-key-rec = ?
      827           or p-key-rec = "":U
      828         then do:
      829           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      830         end.
      831       end.
      832       else do:
      833         if p-key-rec = ?
      834           or p-key-rec = "":U
      835         then do:
      836           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      837         end.
      838       end.
      839       assign
      840         vTable = entry( 1 , p-key-rec, chr(3) )
      841       .
      842       if p-tt-handle <> ?
      843         and ( not valid-handle(p-tt-handle)
      844               or p-tt-handle:type <> "buffer"
      845             )
      846       then do:
      847         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      848       end.
      849       if p-tt-handle = ? then do:
      850         assign
      851           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      852         .
      853         create buffer bh_tbl-name for table v-full-tbl-name .
      854       end.
      855       else do:
      856         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      857       end.
      858       assign
      859         v-inform = bh_tbl-name:index-information(1)
      860         v-ind    = 2
      861       .
      862       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      863       on error undo, return error
      864       :
      865         assign
      866           v-inform = bh_tbl-name:index-information( v-ind )
      867           v-ind    = v-ind + 1
      868         .
      869       end.
      870       if v-inform = ?
      871         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      872         or entry( 3, v-inform, ",":U ) <> "1":U
      873       then do:
      874         delete object bh_tbl-name no-error.
      875         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      876       end.
      877       assign
      878         v-idx-field-qnty = num-entries( v-inform ) - 4
      879       .
      880       if v-idx-field-qnty < 2 then do:
      881         delete object bh_tbl-name no-error.
      882         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      883       end.
      884       assign
      885         o-where     = "where":U
      886         v-word-link = "":U
      887         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      888         v-count-fld = 0
      889       .
      890       if i-tablekey ne "" and i-tablekey ne ?
      891       then do:
      892         assign
      893           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      894         .
      895         create buffer bh_tbl-key for table v-full-tbl-name .
      896       end.
      897       if i-tableSerach ne "" and i-tableSerach ne ?
      898       then do:
      899         delete object bh_tbl-name no-error.
      900         assign
      901           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      902         .
      903         create buffer bh_tbl-name for table v-full-tbl-name .
      904       end.
      905       block_where:
      906       do v-ind = 1 to v-idx-field-qnty by 2
      907       on error undo, return error
      908       :
      909         assign
      910           v-count-fld = v-count-fld + 1
      911         .
      912         if p-key-handle = ?
      913           and v-count-fld > v-field-num
      914         then do:
      915           leave block_where.
      916         end.
      917         define variable VfieldKeyTable as handle no-undo.
      918         assign
      919           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      920           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      921         .
      922         if     bh_tbl-key ne ?
      923         then do:
      924            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      925            if VfieldKeyTable eq ?
      926            then next block_where.
      927         end.
      928         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      929         then
      930            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      931         else
      932            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      933         if p-key-handle = ? then do:
      934           assign
      935             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      936           .
      937         end.
      938         else do:
      939           assign
      940             fh_key = p-key-handle:buffer-field( v-field-name )
      941           .
      942           if fh_key = ?
      943             or not valid-handle( fh_key )
      944           then do:
      945             delete object bh_tbl-name.
      946             if     bh_tbl-key ne ?
      947             then
      948                delete object bh_tbl-key.
      949             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      950           end.
      951           assign
      952             v-field-val = fh_key:buffer-value
      953           .
      954         end.
      955         if fh_search:data-type ="character":U then do:
      956           assign
      957             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      958             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      959             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      960             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      961             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      962             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      963             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      964             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      965             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      966             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      967             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      968             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      969             v-field-val = substitute( '"&1"', v-field-val )
      970           .
      971         end.
      972         assign
      973           o-where = substitute( "&1 &2", o-where, v-field-val )
      974         .
      975         if v-word-link = "":U then do:
      976           assign
      977             v-word-link = "and":U
      978           .
      979         end.
      980       end.
      981       delete object bh_tbl-name.
      982       if     bh_tbl-key ne ?
      983       then
      984          delete object bh_tbl-key.
      985       if p-key-handle = ?
      986         and v-count-fld <> v-field-num
      987       then do:
      988         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      989       end.
      990     end.
      991   end procedure.
      992   procedure gen-hn-keyr-tab :
      993     define input  parameter i-tableSerach as character no-undo.
      994     define input  parameter i-tablekey   as character no-undo.
      995     define input  parameter p-key-rec    as character no-undo.
      996     define input  parameter p-key-handle as handle    no-undo .
      997     define input  parameter p-db-name    as character no-undo .
      998     define input  parameter p-tt-handle  as handle    no-undo .
      999     define input  parameter p-stts-lock  as integer   no-undo .
     1000     define output parameter o-hn         as handle    no-undo.
     1001     define variable v-full-tbl-name as character no-undo.
     1002     define variable v-where         as character no-undo.
     1003     define variable bh_tbl-name     as handle    no-undo.
     1004     define variable vTable          as character no-undo.
     1005     do
     1006     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1007     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1008     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1009         run gen-where-keyr-tab(i-tableSerach,
     1010                                i-tablekey,
     1011                                p-key-rec,
     1012                                p-key-handle,
     1013                                p-db-name,
     1014                                p-tt-handle,
     1015                                output v-where).
     1016         if i-tableSerach ne "" and i-tableSerach ne ?
     1017         then do:
     1018            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1019            create buffer bh_tbl-name for table v-full-tbl-name .
     1020         end.
     1021         else do:
     1022            if p-tt-handle = ? then do:
     1023               assign
     1024                  vTable = entry( 1 , p-key-rec, chr(3) )
     1025               .
     1026               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1027               create buffer bh_tbl-name for table v-full-tbl-name .
     1028            end.
     1029            else do:
     1030               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1031            end.
     1032         end.
     1033         if p-tt-handle = ? then do:
     1034            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1035         end.
     1036         else do:
     1037            bh_tbl-name:find-first( v-where ) no-error .
     1038         end.
     1039         o-hn = bh_tbl-name.
     1040      end.
     1041   end procedure.
     1042   procedure gen-hn-keyr :
     1043     define input  parameter p-key-rec    as character no-undo.
     1044     define input  parameter p-key-handle as handle    no-undo .
     1045     define input  parameter p-db-name    as character no-undo .
     1046     define input  parameter p-tt-handle  as handle    no-undo .
     1047     define input  parameter p-stts-lock  as integer   no-undo .
     1048     define output parameter o-hn         as handle    no-undo.
     1049     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1050   end.
     1051   procedure gen-row-keyr :
     1052     define input  parameter p-key-rec    as character no-undo.
     1053     define input  parameter p-key-handle as handle    no-undo .
     1054     define input  parameter p-db-name    as character no-undo .
     1055     define input  parameter p-tt-handle  as handle    no-undo .
     1056     define input  parameter p-stts-lock  as integer   no-undo .
     1057     define output parameter p-tbl-row    as rowid     no-undo.
     1058     define output parameter p-tbl-name   as character no-undo.
     1059     define variable vHn as handle no-undo.
     1060       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1061       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1062       p-tbl-name =  vHn:table.
     1063       delete object vHn no-error.
     1064     if p-tbl-row = ? then do:
     1065       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
     1066     end.
     1067     else do:
     1068       return.
     1069     end.
     1070   end procedure.
     1071   procedure gen-key-fv :
     1072     define input  parameter p-key-rec    as character no-undo .
     1073     define output parameter p-field-list as character no-undo .
     1074     define output parameter p-value-list as character no-undo.
     1075     do
     1076     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1077     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1078     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1079     :
     1080       define variable v-full-tbl-name  as character no-undo .
     1081       define variable bh_tbl-name      as handle    no-undo .
     1082       define variable v-tbl-name       as character no-undo .
     1083       define variable v-field-num      as integer   no-undo .
     1084       define variable v-count-fld      as integer   no-undo .
     1085       define variable v-inform         as character no-undo .
     1086       define variable v-ind            as integer   no-undo .
     1087       define variable v-idx-field-qnty as integer   no-undo .
     1088       define variable v-delim-key      as character no-undo .
     1089       if p-key-rec = ?
     1090         or p-key-rec = "":U
     1091       then do:
     1092         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
     1093       end.
     1094       assign
     1095         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1096         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1097       .
     1098       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1099       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
     1100       assign
     1101         v-inform = bh_tbl-name:index-information(1)
     1102         v-ind    = 2
     1103       .
     1104       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1105       on error undo, return error
     1106       :
     1107         assign
     1108           v-inform = bh_tbl-name:index-information( v-ind )
     1109           v-ind    = v-ind + 1
     1110         .
     1111       end.
     1112       if v-inform = ?
     1113         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1114         or entry( 3, v-inform, ",":U ) <> "1":U
     1115       then do:
     1116         delete object bh_tbl-name no-error.
     1117         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
     1118       end.
     1119       assign
     1120         v-idx-field-qnty = num-entries( v-inform ) - 4
     1121       .
     1122       if v-idx-field-qnty < 2 then do:
     1123         delete object bh_tbl-name no-error.
     1124         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
     1125       end.
     1126       assign
     1127         p-field-list = "":U
     1128         p-value-list = "":U
     1129         v-delim-key  = "":U
     1130         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1131         v-count-fld  = 0
     1132       .
     1133       block_where:
     1134       do v-ind = 1 to v-idx-field-qnty by 2
     1135       on error undo, return error
     1136       :
     1137         assign
     1138           v-count-fld = v-count-fld + 1
     1139         .
     1140         if v-count-fld > v-field-num then do:
     1141           leave block_where.
     1142         end.
     1143         assign
     1144           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1145           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1146         .
     1147         if v-ind = 1 then do:
     1148           assign
     1149             v-delim-key = chr(3)
     1150           .
     1151         end.
     1152       end.
     1153       delete object bh_tbl-name.
     1154       if v-count-fld <> v-field-num then do:
     1155         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
     1156       end.
     1157     end.
     1158   end procedure.
     1159   procedure gen-key-field :
     1160     define input  parameter p-table      as character no-undo .
     1161     define output parameter p-field-list as character no-undo .
     1162     do
     1163     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1164     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1165     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1166     :
     1167       define variable v-full-tbl-name  as character no-undo .
     1168       define variable bh_tbl-name      as handle    no-undo .
     1169       define variable v-tbl-name       as character no-undo .
     1170       define variable v-field-num      as integer   no-undo .
     1171       define variable v-count-fld      as integer   no-undo .
     1172       define variable v-inform         as character no-undo .
     1173       define variable v-ind            as integer   no-undo .
     1174       define variable v-idx-field-qnty as integer   no-undo .
     1175       define variable v-delim-key      as character no-undo .
     1176       if p-table = ?
     1177         or p-table = "":U
     1178       then do:
     1179         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
     1180       end.
     1181       assign
     1182         v-tbl-name      = p-table
     1183         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1184       .
     1185       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1186       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
     1187       assign
     1188         v-inform = bh_tbl-name:index-information(1)
     1189         v-ind    = 2
     1190       .
     1191       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1192       on error undo, return error
     1193       :
     1194         assign
     1195           v-inform = bh_tbl-name:index-information( v-ind )
     1196           v-ind    = v-ind + 1
     1197         .
     1198       end.
     1199       if v-inform = ?
     1200         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1201         or entry( 3, v-inform, ",":U ) <> "1":U
     1202       then do:
     1203         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
     1204       end.
     1205       assign
     1206         v-idx-field-qnty = num-entries( v-inform ) - 4
     1207       .
     1208       if v-idx-field-qnty < 2 then do:
     1209         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
     1210       end.
     1211       assign
     1212         p-field-list = "":U
     1213         v-delim-key  = "":U
     1214         v-count-fld  = 0
     1215       .
     1216       block_where:
     1217       do v-ind = 1 to v-idx-field-qnty by 2
     1218       on error undo, return error
     1219       :
     1220         assign
     1221           v-count-fld = v-count-fld + 1
     1222         .
     1223         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1224         if v-ind = 1 then do:
     1225           assign
     1226             v-delim-key = chr(3)
     1227           .
     1228         end.
     1229       end.
     1230       delete object bh_tbl-name.
     1231     end.
     1232   end procedure.
     1233   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234   define variable c-point  as character no-undo .
     1235   define variable tbl      as character no-undo .
     1236   define variable join-tbl as character no-undo .
     1237   define variable fld      as character no-undo .
     1238   define variable lab      as character no-undo .
     1239   define variable spr      as character no-undo .
     1240   define variable dim      as character no-undo .
     1241   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   procedure fltfield-clear :
     1243     define output parameter loc-fld as character no-undo.
     1244     define output parameter loc-lab as character no-undo .
     1245     define output parameter loc-spr as character no-undo .
     1246     define output parameter loc-dim as character no-undo .
     1247     assign
     1248       loc-fld = ""
     1249       loc-lab = ""
     1250       loc-spr = ""
     1251       loc-dim = "0"
     1252     .
     1253   end procedure .
     1254   procedure fltfield-add :
     1255     define input        parameter par-fld as character no-undo.
     1256     define input        parameter par-lab as character no-undo .
     1257     define input        parameter par-spr as character no-undo .
     1258     define input-output parameter loc-fld as character no-undo.
     1259     define input-output parameter loc-lab as character no-undo .
     1260     define input-output parameter loc-spr as character no-undo .
     1261     define input-output parameter loc-dim as character no-undo .
     1262     do
     1263     on error undo, return error
     1264     :
     1265       assign
     1266       loc-fld = if loc-dim = '0'
     1267                 then par-fld
     1268                 else (loc-fld + chr(44) + par-fld)
     1269       loc-lab = if loc-dim = '0'
     1270                 then par-lab
     1271                 else (loc-lab + chr(44) + par-lab)
     1272       loc-spr = if loc-dim = '0'
     1273                 then par-spr
     1274                 else (loc-spr + chr(44) + par-spr)
     1275       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1276                 string(integer(if num-entries(loc-dim) > 1
     1277                               then entry(2, loc-dim)
     1278                               else entry(1, loc-dim)
     1279                               ) + 1)
     1280       no-error
     1281       .
     1282     end.
     1283   end procedure.
     1284   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1285     define variable v-cntxt-db-num        as integer   no-undo .
     1286     define variable v-cntxt-userid        as character no-undo .
     1287     define variable v-cntxt-level         as character no-undo .
     1288     define variable v-cntxt-host-code-obj as integer   no-undo .
     1289     define variable v-cntxt-obj-type      as character no-undo .
     1290     define variable v-cntxt-obj-code      as integer   no-undo .
     1291     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1292     define variable v-cntxt-is-admin      as logical   no-undo .
     1293   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1295   procedure fltopend_fltopend :
     1296   define input parameter p-parent-handle as handle no-undo .
     1297   define input parameter p-qh as handle no-undo .
     1298   define input parameter p-flt-open-open-query  as character no-undo .
     1299   define input parameter p-where-cond as character no-undo .
     1300   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1301   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1302   define input parameter p-indexed-reposition as character no-undo .
     1303     do
     1304     on error undo, return error
     1305     :
     1306   define variable v-prepare-string as character no-undo .
     1307   define variable glog as logical no-undo .
     1308   assign
     1309   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1310                      p-where-cond + chr(32)  +
     1311                      p-use-indFIRST-query-tail + chr(32) +
     1312                      p-use-ind-sort-clmn-by + chr(32) +
     1313                      p-indexed-reposition
     1314   .
     1315   assign
     1316   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1317   if not glog
     1318   or error-status:error then do:
     1319     message error-status:get-message(1) view-as alert-box .
     1320     undo, return error .
     1321   end.
     1322   assign
     1323   glog = p-qh:query-open no-error .
     1324   if not glog
     1325   or error-status:error then do:
     1326     message error-status:get-message(1) view-as alert-box .
     1327     undo, return error .
     1328   end.
     1329     end.
     1330   end procedure.
     1331   procedure fltopend_fltfindd :
     1332   define input parameter p-parent-handle as handle no-undo .
     1333   define input parameter p-qh as handle no-undo .
     1334   define input parameter p-rowid as rowid no-undo .
     1335   define input parameter p-next as logical no-undo .
     1336   define input parameter p-lock as integer no-undo .
     1337   define input parameter p-bh as handle no-undo .
     1338   define input parameter p-where-cond as character no-undo .
     1339   define input parameter p-use-index-phrase as character no-undo .
     1340   define variable glog as logical no-undo .
     1341   define variable v-qh as handle no-undo .
     1342   define variable v-bh as handle no-undo .
     1343   define variable v-recid as recid no-undo .
     1344   define variable v-prepare-string as character no-undo .
     1345   do
     1346   on error undo, return error
     1347   on stop undo, return error
     1348   :
     1349     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1350     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1351     create query v-qh.
     1352     v-qh:set-buffers(v-bh).
     1353     v-prepare-string = substitute("for each &1 &2 &3"
     1354                                     ,v-bh:name
     1355                                     ,p-where-cond
     1356                                     ,p-use-index-phrase).
     1357     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1358     if not glog then do:
     1359       delete object v-qh.
     1360       delete object v-bh.
     1361       undo, return error .
     1362     end.
     1363     glog = v-qh:query-open no-error .
     1364     if not glog then do:
     1365       delete object v-qh.
     1366       delete object v-bh.
     1367       undo, return error .
     1368     end.
     1369     if p-next then do:
     1370       v-qh:reposition-to-rowid(p-rowid) no-error .
     1371       glog = v-qh:get-next( p-lock) no-error .
     1372       glog = v-qh:get-next( p-lock) no-error .
     1373       if not glog or v-qh:query-off-end = yes then do:
     1374         glog = v-qh:get-first( p-lock) no-error .
     1375       end.
     1376     end.
     1377     else do:
     1378       glog = v-qh:get-first( p-lock) no-error .
     1379     end.
     1380     v-recid = v-bh:recid no-error .
     1381     delete object v-qh.
     1382     delete object v-bh.
     1383     return string(v-recid) .
     1384   end.
     1385   end procedure.
     1386   procedure fltopend_fltfindq :
     1387   define input parameter p-parent-handle as handle no-undo .
     1388   define input parameter p-qh as handle no-undo .
     1389   define input parameter p-next as logical no-undo .
     1390   define input parameter p-lock as integer no-undo .
     1391   define input parameter p-flt-open-open-query  as character no-undo .
     1392   define input parameter p-where-cond as character no-undo .
     1393   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1394   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1395   define input parameter p-indexed-reposition as character no-undo .
     1396   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1397   define variable glog as logical no-undo .
     1398   define variable v-qh as handle no-undo .
     1399   define variable v-bh as handle no-undo extent 18.
     1400   define variable v-rowid as rowid no-undo extent 18.
     1401   define variable v-ii as integer no-undo .
     1402   define variable v-prepare-string as character no-undo .
     1403   do
     1404   on error undo, return error
     1405   on stop undo, return error
     1406   :
     1407     create query v-qh.
     1408     do v-ii = 1 to p-qh:num-buffers:
     1409       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1410       assign
     1411       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1412       no-error.
     1413       v-qh:add-buffer(v-bh[v-ii]).
     1414     end.
     1415     assign
     1416     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1417                       p-where-cond + chr(32)  +
     1418                       p-use-indFIRST-query-tail + chr(32) +
     1419                       p-use-ind-sort-clmn-by + chr(32) +
     1420                       p-indexed-reposition
     1421     .
     1422     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1423     if not glog then do:
     1424       delete object v-qh.
     1425       do v-ii = 1 to p-qh:num-buffers:
     1426         delete object v-bh[v-ii].
     1427       end.
     1428       undo, return error .
     1429     end.
     1430     glog = v-qh:query-open no-error .
     1431     if not glog then do:
     1432       delete object v-qh.
     1433       do v-ii = 1 to p-qh:num-buffers:
     1434         delete object v-bh[v-ii].
     1435       end.
     1436       undo, return error .
     1437     end.
     1438     if p-next then do:
     1439       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1440       glog = v-qh:get-next( p-lock) no-error .
     1441       glog = v-qh:get-next( p-lock) no-error .
     1442       if not glog or v-qh:query-off-end = yes then do:
     1443         glog = v-qh:get-first( p-lock) no-error .
     1444       end.
     1445     end.
     1446     else do:
     1447       glog = v-qh:get-first( p-lock) no-error .
     1448     end.
     1449     do v-ii = 1 to p-qh:num-buffers:
     1450       assign
     1451       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1452       no-error.
     1453     end.
     1454     delete object v-qh.
     1455     do v-ii = 1 to p-qh:num-buffers:
     1456       delete object v-bh[v-ii].
     1457     end.
     1458   end.
     1459   end procedure.
     1460   define variable sort-column-name as character no-undo .
     1461   define variable filter-pointr as character no-undo init "Неразобранные коллизии СПН" .
     1462   define variable filter-point0 as character no-undo init "nwscolls" .
     1463   define variable filter-point as character no-undo .
     1464   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1465   define variable v-tbl-row  as rowid     no-undo.
     1466   define variable v-tbl-name as character no-undo.
     1467   define variable v-coll-name as character no-undo.
     1468   define variable v-uniq-key-rec as character no-undo.
     1469   FUNCTION subject-title-function RETURNS CHARACTER
     1470     (INPUT p-subject AS CHARACTER)  FORWARD.
     1471   DEFINE BUTTON B-Help
     1472        LABEL "Помо&щь"
     1473        SIZE 3 BY 1
     1474        BGCOLOR 8 .
     1475   DEFINE BUTTON b-quit AUTO-END-KEY
     1476        LABEL "&Выход"
     1477        SIZE 10 BY 1
     1478        BGCOLOR 8 .
     1479   DEFINE BUTTON B-sch
     1480        LABEL "&Фильтр"
     1481        SIZE 3 BY 1.
     1482   DEFINE BUTTON B-solve
     1483        LABEL "Разобрать  коллизию"
     1484        SIZE 20 BY 1.
     1485   DEFINE QUERY BR-colls FOR
     1486         buF_BatchProcess SCROLLING.
     1487   DEFINE BROWSE BR-colls
     1488     QUERY BR-colls NO-LOCK DISPLAY
     1489         buF_BatchProcess.Key#_Two COLUMN-LABEL "Критич!ность" FORMAT ">9":U WIDTH 7
     1490   subject-title-function(buF_BatchProcess.CharKey_two) @ v-coll-name COLUMN-LABEL "Тип коллизии" FORMAT "X(20)"
     1491   uniq-key-rec-string-f(buF_BatchProcess.CharKey_one) @ v-uniq-key-rec COLUMN-LABEL "Запись" FORMAT "X(40)"
     1492   buF_BatchProcess.CharKey_Three COLUMN-LABEL "Значение!предмета!коллизии" FORMAT "X(20)":U
     1493   buF_BatchProcess.Key#_One COLUMN-LABEL "№ БД!источ-ка" FORMAT ">>>>>>9":U WIDTH 14
     1494       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17 FIT-LAST-COLUMN.
     1495   DEFINE FRAME Dialog-Frame
     1496        b-quit AT ROW 1 COL 1
     1497        B-solve AT ROW 1 COL 31
     1498        B-sch AT ROW 1 COL 92
     1499        B-Help AT ROW 1 COL 95
     1500        BR-colls AT ROW 3 COL 1
     1501        SPACE(0.62) SKIP(0.16)
     1502       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1503            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1504            TITLE "Неразобранные коллизии, возникшие в СПН"
     1505            CANCEL-BUTTON b-quit.
     1506   ASSIGN
     1507          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1508          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1509   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1510   DO:
     1511     APPLY "END-ERROR":U TO SELF.
     1512   END.
     1513   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1514   DO:
     1515     RUN proc-b-sch IN this-procedure NO-ERROR.
     1516   END.
     1517   ON CHOOSE OF B-solve IN FRAME Dialog-Frame
     1518   DO:
     1519     RUN proc-b-solve IN THIS-PROCEDURE NO-ERROR.
     1520     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1521   END.
     1522   ON MOUSE-SELECT-DBLCLICK OF BR-colls IN FRAME Dialog-Frame
     1523   or RETURN OF br-colls IN FRAME Dialog-Frame DO:
     1524     APPLY "CHOOSE" TO b-solve.
     1525   END.
     1526   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1527   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1528   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   on help of frame Dialog-Frame
     1530   do:
     1531     run gbl/app_help.p
     1532       (input this-procedure :file-name
     1533       ,input ''
     1534       ,input ?
     1535       ) no-error.
     1536     if error-status :error then do:
     1537       message
     1538         "Ошибка при вызове помощи"
     1539         error-status :get-message(1)
     1540         view-as alert-box .
     1541     end.
     1542   end.
     1543   run minbtn-set in this-procedure .
     1544   on choose of b-help in frame Dialog-Frame
     1545   do:
     1546     apply "help":u to frame Dialog-Frame .
     1547   end.
     1548   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1549   procedure minbtn-set :
     1550       do
     1551           on error undo, return error return-value
     1552           :
     1553           define variable ii              as integer       no-undo .
     1554           define variable fh              as widget-handle no-undo .
     1555           define variable hh              as widget-handle no-undo .
     1556           define variable v-h             as handle        extent 4 no-undo .
     1557           define variable v-name-button   as character     no-undo .
     1558           define variable v-help-old-x    as decimal       no-undo .
     1559           define variable v-help-old-y    as decimal       no-undo .
     1560           define variable v-help-old-size as decimal       no-undo .
     1561           define variable v-frame-width   as decimal       no-undo .
     1562           define variable jj              as integer       no-undo .
     1563           do
     1564               on error undo, return error
     1565               :
     1566               assign
     1567                   v-frame-width = frame Dialog-Frame:width - 0.3
     1568                   fh            = frame Dialog-Frame:first-child
     1569                   hh            = fh:first-child
     1570                   ii            = 1
     1571                   .
     1572               do while valid-handle(hh):
     1573                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1574                   do:
     1575                       case lc(hh:name) :
     1576                           when "b-help" then
     1577                               do:
     1578                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1579                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1580                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1581                                   hh:TOOLTIP = "Помощь" .
     1582                                   v-help-old-x = hh:column .
     1583                                   v-help-old-y = hh:row    .
     1584                                   v-help-old-size = hh:width .
     1585                                   hh:width-chars = 2.5 .
     1586                               end.
     1587                           when "b-print" then
     1588                               do:
     1589                                   hh:load-image("cmp/b-print.bmp":u) .
     1590                                   hh:TOOLTIP = "Печать" .
     1591                                   v-h[ii] = hh:handle .
     1592                                   ii = ii + 1 .
     1593                                   hh:width-chars = 3 .
     1594                               end.
     1595                           when "b-history" or
     1596                           when "b-hist" then
     1597                               do:
     1598                                   hh:load-image("cmp/b-hist.bmp":u) .
     1599                                   hh:TOOLTIP = "История" .
     1600                                   v-h[ii] = hh:handle .
     1601                                   ii = ii + 1 .
     1602                                   hh:width-chars = 3 .
     1603                               end.
     1604                           when "b-sch" then
     1605                               do:
     1606                                   hh:load-image("cmp/b-sch.bmp":u) .
     1607                                   hh:TOOLTIP = "Установка Фильтра" .
     1608                                   v-h[ii] = hh:handle .
     1609                                   ii = ii + 1 .
     1610                                   hh:width-chars = 3 .
     1611                               end.
     1612                           when "b-hist-user" then
     1613                               do:
     1614                                   hh:load-image("cmp/b-hist.bmp":u) .
     1615                                   hh:TOOLTIP = "История пользователя" .
     1616                                   ii = ii + 1 .
     1617                               end.
     1618                       end case.
     1619                   end.
     1620                   hh = hh:next-sibling.
     1621               end.
     1622               b-help:column = v-frame-width - b-help:width-chars.
     1623               jj = 0.
     1624               repeat ii = 4 to 1 by -1 :
     1625                   if valid-handle (v-h[ii] ) then
     1626                   do:
     1627                       jj  = jj + 1 .
     1628                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1629                       v-h[ii]:row    = v-help-old-y .
     1630                   end.
     1631               end.
     1632           end.
     1633       end.
     1634   end procedure.
     1635   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1636   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1637   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1638   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1639   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1640   define variable v-diasize-current-frame-height as decimal   no-undo .
     1641   define variable v-diasize-change-size          as logical   no-undo .
     1642   define variable v-diasize-resize-button        as handle    no-undo .
     1643   define variable v-diasize-wndmax               as logical   no-undo .
     1644   define variable v-diasize-wndstore             as logical   no-undo .
     1645   define variable v-diasize-proc-name            as character no-undo .
     1646   define variable v-diasize-browse-handle        as handle    no-undo .
     1647   define variable v-diasize-browse-number        as integer   no-undo .
     1648   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1649   define temp-table temp-diasize-handle no-undo
     1650     field handle-value  as handle
     1651     field save-position as decimal
     1652     index xpk is primary unique handle-value
     1653     .
     1654   define temp-table temp-browse-handle no-undo
     1655     field browse-type   as character
     1656     field browse-number as integer
     1657     field browse-handle as handle
     1658     field original-size as decimal
     1659     index xpk is primary unique browse-type browse-number
     1660     index xie browse-type browse-handle
     1661   .
     1662   procedure diasize_change-height :
     1663     define input  parameter p-change-value  as decimal   no-undo .
     1664     define input  parameter p-move-resize   as logical   no-undo .
     1665     define variable v-field-group-handle    as handle    no-undo .
     1666     define variable v-object-handle         as handle    no-undo .
     1667     define variable v-frame-height          as decimal   no-undo .
     1668     define variable v-frame-virtual-height  as decimal   no-undo .
     1669     define variable v-browse-height         as decimal   no-undo .
     1670     define variable v-window-height         as decimal   no-undo .
     1671     define variable v-window-virtual-height as decimal   no-undo .
     1672     define variable v-change-sign           as integer   no-undo .
     1673     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1674     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1675     if p-change-value > 0
     1676     then do:
     1677       if frame Dialog-Frame :height + p-change-value
     1678           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1679       then do:
     1680         assign
     1681           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1682                           - (frame Dialog-Frame :height-chars)
     1683         .
     1684         if p-change-value <= 0
     1685         then do:
     1686           run diasize_position-resize-button in this-procedure .
     1687           return .
     1688         end.
     1689       end.
     1690     end.
     1691     if p-change-value < 0
     1692     then do:
     1693       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1694       then do:
     1695         assign
     1696           p-change-value = v-diasize-orig-frame-height
     1697                          - (frame Dialog-Frame :height-chars)
     1698         .
     1699         if p-change-value >= 0
     1700         then do:
     1701           run diasize_position-resize-button in this-procedure .
     1702           return .
     1703         end.
     1704       end.
     1705     end.
     1706     if p-change-value >= 0
     1707     then do:
     1708       assign
     1709         v-change-sign = 1
     1710       .
     1711     end.
     1712     else do:
     1713       assign
     1714         v-change-sign = -1
     1715       .
     1716     end.
     1717     assign
     1718       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1719     .
     1720     if p-change-value = 0
     1721     then do:
     1722       run diasize_position-resize-button in this-procedure .
     1723       return .
     1724     end.
     1725     move_block:
     1726     do
     1727     on error undo move_block, retry move_block
     1728     :
     1729       if retry
     1730       then do:
     1731         do
     1732         on error undo move_block, leave move_block
     1733         :
     1734           if p-change-value > 0
     1735           then do:
     1736             for each buf_temp-diasize-handle
     1737             on error undo, next
     1738             :
     1739               assign
     1740                 v-object-handle = buf_temp-diasize-handle.handle-value
     1741               .
     1742               if v-object-handle <> v-diasize-resize-button
     1743               then do:
     1744                 assign
     1745                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1746                 .
     1747               end.
     1748             end.
     1749             assign
     1750               v-diasize-browse-handle :height = v-browse-height
     1751             .
     1752             for each buf_temp-browse-handle
     1753               where buf_temp-browse-handle.browse-type = 'height':u
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1758               .
     1759             end.
     1760             assign
     1761               frame Dialog-Frame :height = v-frame-height
     1762             .
     1763             if frame Dialog-Frame :scrollable = true
     1764             then do:
     1765               assign
     1766                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1767               .
     1768             end.
     1769             run diasize_position-resize-button in this-procedure .
     1770           end.
     1771           else do:
     1772             if frame Dialog-Frame :scrollable = true
     1773             then do:
     1774               assign
     1775                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1776               .
     1777             end.
     1778             assign
     1779               frame Dialog-Frame :height = v-frame-height
     1780             .
     1781             assign
     1782               v-diasize-browse-handle :height = v-browse-height
     1783             .
     1784             for each buf_temp-browse-handle
     1785               where buf_temp-browse-handle.browse-type = 'height':u
     1786             on error undo, next
     1787             :
     1788               assign
     1789                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1790               .
     1791             end.
     1792             for each buf_temp-diasize-handle
     1793             on error undo, next
     1794             :
     1795               assign
     1796                 v-object-handle = buf_temp-diasize-handle.handle-value
     1797               .
     1798               if v-object-handle <> v-diasize-resize-button
     1799               then do:
     1800                 assign
     1801                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1802                 .
     1803               end.
     1804             end.
     1805             run diasize_position-resize-button in this-procedure .
     1806           end.
     1807           assign
     1808             v-diasize-change-size = false
     1809           .
     1810           leave move_block .
     1811         end.
     1812       end.
     1813       assign
     1814         v-diasize-need-full-display = true
     1815       .
     1816       if v-diasize-change-size = false
     1817       then do:
     1818         assign
     1819           v-diasize-change-size = true
     1820         .
     1821       end.
     1822       else do:
     1823         return .
     1824       end.
     1825       assign
     1826         v-frame-height = frame Dialog-Frame :height
     1827         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1828         v-browse-height = v-diasize-browse-handle :height
     1829       .
     1830       for each buf_temp-browse-handle
     1831         where buf_temp-browse-handle.browse-type = 'height':u
     1832       :
     1833         assign
     1834           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1835         .
     1836       end.
     1837       for each buf_temp-diasize-handle
     1838       :
     1839         delete buf_temp-diasize-handle .
     1840       end.
     1841       assign
     1842         v-field-group-handle = frame Dialog-Frame :first-child
     1843       .
     1844       do while valid-handle(v-field-group-handle)
     1845       :
     1846         assign
     1847           v-object-handle = v-field-group-handle :first-child
     1848         .
     1849         do while valid-handle(v-object-handle)
     1850         :
     1851           if  v-object-handle <> v-diasize-browse-handle :handle
     1852           and can-query(v-object-handle, "row")
     1853           and can-query(v-object-handle, "height")
     1854           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1855           then do:
     1856             find first buf_temp-browse-handle
     1857               where buf_temp-browse-handle.browse-type   = 'height':u
     1858                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1859               no-error .
     1860             if available buf_temp-browse-handle
     1861             then do:
     1862             end.
     1863             else do:
     1864               create buf_temp-diasize-handle .
     1865               assign
     1866                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1867                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1868               .
     1869             end.
     1870           end.
     1871           assign
     1872             v-object-handle = v-object-handle :next-sibling
     1873           .
     1874         end.
     1875         assign
     1876           v-field-group-handle = v-field-group-handle :next-sibling
     1877         .
     1878       end.
     1879       do with frame Dialog-Frame
     1880       :
     1881         hide v-diasize-resize-button .
     1882         assign
     1883           v-diasize-resize-button :row    = 1
     1884           v-diasize-resize-button :column = 1
     1885         .
     1886       end.
     1887       if p-change-value > 0
     1888       then do:
     1889         if frame Dialog-Frame :scrollable = true
     1890         then do:
     1891           assign
     1892             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1893             no-error .
     1894           if error-status :error
     1895           or error-status :get-message(1) <> ""
     1896           then do:
     1897             undo move_block, retry move_block .
     1898           end.
     1899         end.
     1900         assign
     1901           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1902           no-error .
     1903         if error-status :error
     1904         or error-status :get-message(1) <> ""
     1905         then do:
     1906           undo move_block, retry move_block .
     1907         end.
     1908         assign
     1909           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1910           no-error .
     1911         if error-status :error
     1912         or error-status :get-message(1) <> ""
     1913         then do:
     1914           undo move_block, retry move_block .
     1915         end.
     1916         for each buf_temp-browse-handle
     1917           where buf_temp-browse-handle.browse-type = 'height':u
     1918         on error undo move_block, retry move_block
     1919         :
     1920           assign
     1921             buf_temp-browse-handle.browse-handle :height
     1922               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1923             no-error .
     1924           if error-status :error
     1925           or error-status :get-message(1) <> ""
     1926           then do:
     1927             undo move_block, retry move_block .
     1928           end.
     1929         end.
     1930         for each buf_temp-diasize-handle
     1931         on error undo move_block, retry move_block
     1932         :
     1933           assign
     1934             v-object-handle = buf_temp-diasize-handle.handle-value
     1935           .
     1936           if v-object-handle <> v-diasize-resize-button
     1937           then do:
     1938             assign
     1939               v-object-handle :row = v-object-handle :row + p-change-value
     1940               no-error .
     1941             if error-status :error
     1942             or error-status :get-message(1) <> ""
     1943             then do:
     1944               undo move_block, retry move_block .
     1945             end.
     1946           end.
     1947         end.
     1948       end.
     1949       else do:
     1950         for each buf_temp-diasize-handle
     1951         on error undo move_block, retry move_block
     1952         :
     1953           assign
     1954             v-object-handle = buf_temp-diasize-handle.handle-value
     1955           .
     1956           if v-object-handle <> v-diasize-resize-button
     1957           then do:
     1958             assign
     1959               v-object-handle :row = v-object-handle :row + p-change-value
     1960               no-error .
     1961             if error-status :error
     1962             or error-status :get-message(1) <> ""
     1963             then do:
     1964               undo move_block, retry move_block .
     1965             end.
     1966           end.
     1967         end.
     1968         assign
     1969           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1970           no-error .
     1971         if error-status :error
     1972         or error-status :get-message(1) <> ""
     1973         then do:
     1974           undo move_block, retry move_block .
     1975         end.
     1976         for each buf_temp-browse-handle
     1977           where buf_temp-browse-handle.browse-type = 'height':u
     1978         on error undo move_block, retry move_block
     1979         :
     1980           assign
     1981             buf_temp-browse-handle.browse-handle :height
     1982               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1983             no-error .
     1984           if error-status :error
     1985           or error-status :get-message(1) <> ""
     1986           then do:
     1987             undo move_block, retry move_block .
     1988           end.
     1989         end.
     1990         assign
     1991           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1992           no-error .
     1993         if error-status :error
     1994         or error-status :get-message(1) <> ""
     1995         then do:
     1996           undo move_block, retry move_block .
     1997         end.
     1998         if frame Dialog-Frame :scrollable = true
     1999         then do:
     2000           assign
     2001             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2002             no-error .
     2003           if error-status :error
     2004           or error-status :get-message(1) <> ""
     2005           then do:
     2006             undo move_block, retry move_block .
     2007           end.
     2008         end.
     2009       end.
     2010       if p-move-resize = true
     2011       then do:
     2012         run diasize_position-resize-button in this-procedure .
     2013       end.
     2014       if v-diasize-wndstore = true
     2015       then do:
     2016         if connected("ub") = true
     2017         then do:
     2018           define variable v-cntxt-db-num        as integer   no-undo .
     2019           define variable v-cntxt-userid        as character no-undo .
     2020           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2021                                             , OUTPUT v-cntxt-userid
     2022                                             ) .
     2023           run gbl/wndsizew.p
     2024             (input  v-cntxt-db-num
     2025             ,input  v-cntxt-userid
     2026             ,input  v-diasize-proc-name
     2027             ,input  'height':u
     2028             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2029             ) .
     2030         end.
     2031       end.
     2032     end.
     2033     assign
     2034       v-diasize-change-size = false
     2035     .
     2036   end procedure.
     2037   procedure diasize_set-height :
     2038     define input  parameter p-new-height  as decimal   no-undo .
     2039     define input  parameter p-move-resize as logical   no-undo .
     2040     do
     2041     on error undo, return error return-value
     2042     :
     2043       run diasize_change-height in this-procedure
     2044         (input  (p-new-height - frame Dialog-Frame :height)
     2045         ,input  p-move-resize
     2046         ) .
     2047     end.
     2048   end procedure.
     2049   procedure diasize_change-width :
     2050     define input  parameter p-change-value as decimal   no-undo .
     2051     define input  parameter p-move-resize  as logical   no-undo .
     2052     define variable v-field-group-handle   as handle    no-undo .
     2053     define variable v-object-handle        as handle    no-undo .
     2054     define variable v-frame-width          as decimal   no-undo .
     2055     define variable v-frame-virtual-width  as decimal   no-undo .
     2056     define variable v-browse-width         as decimal   no-undo .
     2057     define variable v-window-width         as decimal   no-undo .
     2058     define variable v-window-virtual-width as decimal   no-undo .
     2059     define variable v-change-sign          as integer   no-undo .
     2060     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2061     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2062     if p-change-value > 0
     2063     then do:
     2064       if frame Dialog-Frame :width + p-change-value >
     2065           session :width-chars
     2066       then do:
     2067         assign
     2068           p-change-value = session :width-chars - frame Dialog-Frame :width
     2069         .
     2070         if p-change-value <= 0
     2071         then do:
     2072           run diasize_position-resize-button in this-procedure .
     2073           return .
     2074         end.
     2075       end.
     2076     end.
     2077     if p-change-value < 0
     2078     then do:
     2079       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2080       then do:
     2081         assign
     2082           p-change-value = v-diasize-orig-frame-width
     2083                          - frame Dialog-Frame :width
     2084         .
     2085         if p-change-value >= 0
     2086         then do:
     2087           run diasize_position-resize-button in this-procedure .
     2088           return .
     2089         end.
     2090       end.
     2091     end.
     2092     if p-change-value >= 0
     2093     then do:
     2094       assign
     2095         v-change-sign = 1
     2096       .
     2097     end.
     2098     else do:
     2099       assign
     2100         v-change-sign = -1
     2101       .
     2102     end.
     2103     assign
     2104       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2105     .
     2106     if p-change-value = 0
     2107     then do:
     2108       run diasize_position-resize-button in this-procedure .
     2109       return .
     2110     end.
     2111     move_block:
     2112     do
     2113     on error undo move_block, leave move_block
     2114     :
     2115       if retry
     2116       then do:
     2117         do
     2118         on error undo move_block, leave move_block
     2119         :
     2120           if p-change-value > 0
     2121           then do:
     2122             for each buf_temp-diasize-handle
     2123             on error undo, next
     2124             :
     2125               assign
     2126                 v-object-handle = buf_temp-diasize-handle.handle-value
     2127               .
     2128               if v-object-handle <> v-diasize-resize-button
     2129               then do:
     2130                 assign
     2131                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2132                 .
     2133               end.
     2134             end.
     2135             assign
     2136               v-diasize-browse-handle :width = v-browse-width
     2137             .
     2138             for each buf_temp-browse-handle
     2139               where buf_temp-browse-handle.browse-type = 'width':u
     2140             on error undo, next
     2141             :
     2142               assign
     2143                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2144               .
     2145             end.
     2146             assign
     2147               frame Dialog-Frame :width = v-frame-width
     2148             .
     2149             if frame Dialog-Frame :scrollable = true
     2150             then do:
     2151               assign
     2152                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2153               .
     2154             end.
     2155             run diasize_position-resize-button in this-procedure .
     2156           end.
     2157           else do:
     2158             if frame Dialog-Frame :scrollable = true
     2159             then do:
     2160               assign
     2161                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2162               .
     2163             end.
     2164             assign
     2165               frame Dialog-Frame :width = v-frame-width
     2166             .
     2167             for each buf_temp-browse-handle
     2168               where buf_temp-browse-handle.browse-type = 'width':u
     2169             on error undo, next
     2170             :
     2171               assign
     2172                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2173               .
     2174             end.
     2175             assign
     2176               v-diasize-browse-handle :width = v-browse-width
     2177             .
     2178             for each buf_temp-diasize-handle
     2179             on error undo, next
     2180             :
     2181               assign
     2182                 v-object-handle = buf_temp-diasize-handle.handle-value
     2183               .
     2184               if v-object-handle <> v-diasize-resize-button
     2185               then do:
     2186                 assign
     2187                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2188                 .
     2189               end.
     2190             end.
     2191             run diasize_position-resize-button in this-procedure .
     2192           end.
     2193           assign
     2194             v-diasize-change-size = false
     2195           .
     2196           leave move_block .
     2197         end.
     2198       end.
     2199       assign
     2200         v-diasize-need-full-display = true
     2201       .
     2202       if v-diasize-change-size = false
     2203       then do:
     2204         assign
     2205           v-diasize-change-size = true
     2206         .
     2207       end.
     2208       else do:
     2209         return .
     2210       end.
     2211       assign
     2212         v-frame-width = frame Dialog-Frame :width
     2213         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2214         v-browse-width = v-diasize-browse-handle :width
     2215       .
     2216       for each buf_temp-browse-handle
     2217         where buf_temp-browse-handle.browse-type = 'width':u
     2218       :
     2219         assign
     2220           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2221         .
     2222       end.
     2223       for each buf_temp-diasize-handle
     2224       :
     2225         delete buf_temp-diasize-handle .
     2226       end.
     2227       assign
     2228         v-field-group-handle = frame Dialog-Frame :first-child
     2229       .
     2230       do while valid-handle(v-field-group-handle)
     2231       :
     2232         assign
     2233           v-object-handle = v-field-group-handle :first-child
     2234         .
     2235         do while valid-handle(v-object-handle)
     2236         :
     2237           if  v-object-handle <> v-diasize-browse-handle :handle
     2238           and v-object-handle <> v-diasize-resize-button
     2239           and can-query(v-object-handle, "row")
     2240           and can-query(v-object-handle, "height")
     2241           and ( v-object-handle :col + v-object-handle :width
     2242                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2243               )
     2244           then do:
     2245             find first buf_temp-browse-handle
     2246               where buf_temp-browse-handle.browse-type   = 'width':u
     2247                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2248               no-error .
     2249             if available buf_temp-browse-handle
     2250             then do:
     2251             end.
     2252             else do:
     2253               create buf_temp-diasize-handle .
     2254               assign
     2255                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2256                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2257               .
     2258             end.
     2259           end.
     2260           assign
     2261             v-object-handle = v-object-handle :next-sibling
     2262           .
     2263         end.
     2264         assign
     2265           v-field-group-handle = v-field-group-handle :next-sibling
     2266         .
     2267       end.
     2268       do with frame Dialog-Frame
     2269       :
     2270         hide v-diasize-resize-button .
     2271         v-diasize-resize-button :row = 1.
     2272         v-diasize-resize-button :column = 1.
     2273       end.
     2274       if p-change-value > 0
     2275       then do:
     2276         if frame Dialog-Frame :scrollable = true
     2277         then do:
     2278           assign
     2279             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2280             no-error .
     2281           if error-status :error
     2282           or error-status :get-message(1) <> ""
     2283           then do:
     2284             undo move_block, retry move_block.
     2285           end.
     2286         end.
     2287         assign
     2288           frame Dialog-Frame :width = v-frame-width + p-change-value
     2289           no-error .
     2290         if error-status :error
     2291         or error-status :get-message(1) <> ""
     2292         then do:
     2293           undo move_block, retry move_block.
     2294         end.
     2295         assign
     2296           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2297         no-error .
     2298         if error-status :error
     2299         or error-status :get-message(1) <> ""
     2300         then do:
     2301           undo move_block, retry move_block.
     2302         end.
     2303         for each buf_temp-browse-handle
     2304           where buf_temp-browse-handle.browse-type = 'width':u
     2305         on error undo move_block, retry move_block
     2306         :
     2307           assign
     2308             buf_temp-browse-handle.browse-handle :width
     2309               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2310             no-error .
     2311           if error-status :error
     2312           or error-status :get-message(1) <> ""
     2313           then do:
     2314             undo move_block, retry move_block .
     2315           end.
     2316         end.
     2317         for each buf_temp-diasize-handle
     2318         on error undo move_block, retry move_block
     2319         :
     2320           assign
     2321             v-object-handle = buf_temp-diasize-handle.handle-value
     2322           .
     2323           if v-object-handle <> v-diasize-resize-button
     2324           then do:
     2325             assign
     2326               v-object-handle :col = v-object-handle :col + p-change-value
     2327               no-error .
     2328             if error-status :error
     2329             or error-status :get-message(1) <> ""
     2330             then do:
     2331               undo move_block, retry move_block .
     2332             end.
     2333           end.
     2334         end.
     2335       end.
     2336       else do:
     2337         for each buf_temp-diasize-handle
     2338         on error undo move_block, retry move_block
     2339         :
     2340           assign
     2341             v-object-handle = buf_temp-diasize-handle.handle-value
     2342           .
     2343           if v-object-handle <> v-diasize-resize-button
     2344           then do:
     2345             assign
     2346               v-object-handle :col = v-object-handle :col + p-change-value
     2347               no-error .
     2348             if error-status :error
     2349             or error-status :get-message(1) <> ""
     2350             then do:
     2351               undo move_block, retry move_block .
     2352             end.
     2353           end.
     2354         end.
     2355         for each buf_temp-browse-handle
     2356           where buf_temp-browse-handle.browse-type = 'width':u
     2357         on error undo move_block, retry move_block
     2358         :
     2359           assign
     2360             buf_temp-browse-handle.browse-handle :width
     2361               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2362             no-error .
     2363           if error-status :error
     2364           or error-status :get-message(1) <> ""
     2365           then do:
     2366             undo move_block, retry move_block .
     2367           end.
     2368         end.
     2369         assign
     2370           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2371           no-error .
     2372         if error-status :error
     2373         or error-status :get-message(1) <> ""
     2374         then do:
     2375           undo move_block, retry move_block.
     2376         end.
     2377         assign
     2378           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2379         no-error .
     2380         if error-status :error
     2381         or error-status :get-message(1) <> ""
     2382         then do:
     2383           undo move_block, retry move_block.
     2384         end.
     2385         if frame Dialog-Frame :scrollable = true
     2386         then do:
     2387           assign
     2388             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2389           no-error .
     2390           if error-status :error
     2391           or error-status :get-message(1) <> ""
     2392           then do:
     2393             undo move_block, retry move_block.
     2394           end.
     2395         end.
     2396       end.
     2397       if p-move-resize
     2398       then do:
     2399         run diasize_position-resize-button in this-procedure .
     2400       end.
     2401       if v-diasize-wndstore = true
     2402       then do:
     2403         if connected("ub") = true
     2404         then do:
     2405           define variable v-cntxt-db-num        as integer   no-undo .
     2406           define variable v-cntxt-userid        as character no-undo .
     2407           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2408                                             , OUTPUT v-cntxt-userid
     2409                                             ) .
     2410           run gbl/wndsizew.p
     2411             (input  v-cntxt-db-num
     2412             ,input  v-cntxt-userid
     2413             ,input  v-diasize-proc-name
     2414             ,input  'width':u
     2415             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2416             ) .
     2417         end.
     2418       end.
     2419     end.
     2420     assign
     2421       v-diasize-change-size = false
     2422     .
     2423   end procedure.
     2424   procedure diasize_set-width :
     2425     define input  parameter p-new-width  as decimal   no-undo .
     2426     define input  parameter p-move-resize as logical   no-undo .
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       run diasize_change-width in this-procedure
     2431         (input  (p-new-width - frame Dialog-Frame :width)
     2432         ,input  p-move-resize
     2433         ) .
     2434     end.
     2435   end procedure.
     2436   procedure diasize_position-resize-button :
     2437     do with frame Dialog-Frame
     2438     :
     2439       hide v-diasize-resize-button .
     2440       assign
     2441         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2442                     - 1
     2443                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2444         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2445                     - 1
     2446                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2447       .
     2448       view v-diasize-resize-button .
     2449     end.
     2450   end procedure.
     2451   on alt-right anywhere
     2452   do:
     2453     run diasize_change-width in this-procedure
     2454       (input 1
     2455       ,input true
     2456       ) .
     2457     return no-apply .
     2458   end.
     2459   on alt-left anywhere
     2460   do:
     2461     run diasize_change-width in this-procedure
     2462       (input -1
     2463       ,input true
     2464       ) .
     2465     return no-apply .
     2466   end.
     2467   on alt-down anywhere
     2468   do:
     2469     run diasize_change-height in this-procedure
     2470       (input 1
     2471       ,input true
     2472       ) .
     2473     return no-apply .
     2474   end.
     2475   on alt-up anywhere
     2476   do:
     2477     run diasize_change-height in this-procedure
     2478       (input -1
     2479       ,input true
     2480       ) .
     2481     return no-apply .
     2482   end.
     2483   on alt-enter of frame Dialog-Frame
     2484   do:
     2485     run diasize_maximize in this-procedure
     2486       (input  ?
     2487       ).
     2488     return no-apply .
     2489   end.
     2490   procedure diasize_end-move :
     2491     do
     2492     on error undo, return error return-value
     2493     :
     2494       define variable v-row-delta as decimal   no-undo .
     2495       define variable v-col-delta as decimal   no-undo .
     2496       define variable v-new-row as decimal   no-undo .
     2497       define variable v-new-col as decimal   no-undo .
     2498       assign
     2499         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2500         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2501       .
     2502       assign
     2503         v-row-delta = v-new-row - frame Dialog-Frame :height
     2504         v-col-delta = v-new-col - frame Dialog-Frame :width
     2505       .
     2506       run diasize_change-height in this-procedure
     2507         (input v-row-delta
     2508         ,input true
     2509         ) .
     2510       run diasize_change-width in this-procedure
     2511         (input v-col-delta
     2512         ,input true
     2513         ) .
     2514     end.
     2515   end procedure.
     2516   procedure diasize_maximize :
     2517     define input  parameter p-action as logical   no-undo .
     2518     do
     2519     on error undo, return error return-value
     2520     :
     2521       if p-action = ?
     2522       then do:
     2523         if v-diasize-need-maximize = true
     2524         then do:
     2525           assign
     2526             p-action = true
     2527           .
     2528         end.
     2529         else do:
     2530           assign
     2531             p-action = false
     2532           .
     2533         end.
     2534       end.
     2535       if p-action = true
     2536       then do:
     2537         run diasize_change-height in this-procedure
     2538           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2539               - frame Dialog-Frame :height-chars
     2540           ,input true
     2541           ) .
     2542         run diasize_change-width in this-procedure
     2543           (input session :width-chars
     2544               - frame Dialog-Frame :width-chars
     2545           ,input true
     2546           ) .
     2547         assign
     2548           v-diasize-need-maximize = false
     2549         .
     2550       end.
     2551       else do:
     2552         run diasize_change-width in this-procedure
     2553           (input v-diasize-orig-frame-width
     2554               - frame Dialog-Frame :width-chars
     2555           ,input true
     2556           ) .
     2557         run diasize_change-height in this-procedure
     2558           (input v-diasize-orig-frame-height
     2559               - frame Dialog-Frame :height-chars
     2560           ,input true
     2561           ) .
     2562         assign
     2563           v-diasize-need-maximize = true
     2564         .
     2565       end.
     2566     end.
     2567   end procedure.
     2568   procedure diasize_restore-orig-size :
     2569     do
     2570     on error undo, return error return-value
     2571     :
     2572       assign
     2573         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2574         v-diasize-current-frame-height = frame Dialog-Frame :height
     2575       .
     2576       run diasize_set-height in this-procedure
     2577         (input  v-diasize-orig-frame-height
     2578         ,input  true
     2579         ) .
     2580       run diasize_set-width in this-procedure
     2581         (input  v-diasize-orig-frame-width
     2582         ,input  true
     2583         ) .
     2584     end.
     2585   end procedure.
     2586   procedure diasize_restore-current-size :
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       run diasize_set-height in this-procedure
     2591         (input  v-diasize-current-frame-height
     2592         ,input  true
     2593         ) .
     2594       run diasize_set-width in this-procedure
     2595         (input  v-diasize-current-frame-width
     2596         ,input  true
     2597         ) .
     2598     end.
     2599   end procedure.
     2600   procedure diasize_set-browse-handle :
     2601     define input  parameter p-browse-handle as handle   no-undo .
     2602     define buffer buf_temp-browse-handle for temp-browse-handle .
     2603     do
     2604     on error undo, return error return-value
     2605     :
     2606       assign
     2607         v-diasize-browse-handle = p-browse-handle
     2608       .
     2609       for each buf_temp-browse-handle
     2610       on error undo, return error return-value
     2611       :
     2612         delete buf_temp-browse-handle .
     2613       end.
     2614     end.
     2615   end procedure.
     2616   procedure diasize_add_browse :
     2617     define input  parameter p-browse-type   as character no-undo .
     2618     define input  parameter p-browse-handle as handle    no-undo .
     2619     define buffer buf_temp-browse-handle for temp-browse-handle .
     2620     do
     2621     on error undo, return error return-value
     2622     :
     2623       assign
     2624         v-diasize-browse-number = v-diasize-browse-number + 1
     2625       .
     2626       create buf_temp-browse-handle .
     2627       assign
     2628         buf_temp-browse-handle.browse-type   = p-browse-type
     2629         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2630         buf_temp-browse-handle.browse-handle = p-browse-handle
     2631       .
     2632     end.
     2633   end procedure.
     2634   procedure diasize_init :
     2635     define variable v-default-value    as logical   no-undo .
     2636     define variable v-restore-saved    as logical   no-undo .
     2637     define variable v-resize-value-str as character no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       do with frame Dialog-Frame
     2642       :
     2643         assign
     2644           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2645           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2646           v-diasize-browse-handle     = browse BR-colls :handle
     2647         .
     2648         create button v-diasize-resize-button
     2649         assign
     2650           parent        = frame Dialog-Frame :first-child
     2651           label         = "s"
     2652           height-pixels = 16
     2653           width-pixels  = 16
     2654           visible       = true
     2655           sensitive     = true
     2656           movable       = true
     2657           triggers:
     2658             on end-move persistent run diasize_end-move in this-procedure .
     2659           end triggers.
     2660         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2661         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2662         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2663         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2664         assign
     2665           v-diasize-wndmax = false
     2666         .
     2667         if connected("ub") = true
     2668         then do:
     2669           define variable v-cntxt-db-num        as integer   no-undo .
     2670           define variable v-cntxt-userid        as character no-undo .
     2671           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2672                                             , OUTPUT v-cntxt-userid
     2673                                             ) .
     2674           run gbl/wndpar_r.p
     2675             (input  v-cntxt-db-num
     2676             ,input  v-cntxt-userid
     2677             ,input  'wndmax':U
     2678             ,output v-diasize-wndmax
     2679             ,output v-default-value
     2680             ) .
     2681         end.
     2682         assign
     2683           v-diasize-wndstore = false
     2684         .
     2685         if connected("ub") = true
     2686         then do:
     2687           run gbl/wndpar_r.p
     2688             (input  v-cntxt-db-num
     2689             ,input  v-cntxt-userid
     2690             ,input  'wndstore':U
     2691             ,output v-diasize-wndstore
     2692             ,output v-default-value
     2693             ) .
     2694         end.
     2695         assign
     2696           v-diasize-proc-name = entry(1, program-name(2), '.')
     2697         .
     2698         if v-diasize-wndstore = true
     2699         then do:
     2700           assign
     2701             v-restore-saved = false
     2702           .
     2703           if connected("ub") = true
     2704           then do:
     2705             run gbl/wndsizer.p
     2706               (input  v-cntxt-db-num
     2707               ,input  v-cntxt-userid
     2708               ,input  v-diasize-proc-name
     2709               ,input  'height':u
     2710               ,output v-resize-value-str
     2711               ) .
     2712             if v-resize-value-str <> '':U
     2713             then do:
     2714               run diasize_change-height in this-procedure
     2715                 (input  integer(v-resize-value-str)
     2716                 ,input  true
     2717                 ) .
     2718               assign
     2719                 v-restore-saved = true
     2720               .
     2721             end.
     2722           end.
     2723           if connected("ub") = true
     2724           then do:
     2725             run gbl/wndsizer.p
     2726               (input  v-cntxt-db-num
     2727               ,input  v-cntxt-userid
     2728               ,input  v-diasize-proc-name
     2729               ,input  'width':u
     2730               ,output v-resize-value-str
     2731               ) .
     2732             if v-resize-value-str <> '':U
     2733             then do:
     2734               run diasize_change-width in this-procedure
     2735                 (input  integer(v-resize-value-str)
     2736                 ,input  true
     2737                 ) .
     2738               assign
     2739                 v-restore-saved = true
     2740               .
     2741             end.
     2742           end.
     2743           if v-restore-saved <> true
     2744           then do:
     2745             if v-diasize-wndmax = true
     2746             then do:
     2747               run diasize_maximize in this-procedure
     2748                 (input  true
     2749                 ) .
     2750             end.
     2751           end.
     2752         end.
     2753         else do:
     2754           if v-diasize-wndmax = true
     2755           then do:
     2756             run diasize_maximize in this-procedure
     2757               (input  true
     2758               ) .
     2759           end.
     2760         end.
     2761       end.
     2762     end.
     2763   end procedure.
     2764   procedure diasize_need-full-display :
     2765     define output parameter p-need-full-display as logical   no-undo .
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769       assign
     2770         p-need-full-display = v-diasize-need-full-display
     2771       .
     2772       assign
     2773         v-diasize-need-full-display = false
     2774       .
     2775     end.
     2776   end procedure.
     2777   procedure get-context :
     2778      define output parameter p-db-num as integer          no-undo.
     2779      define output parameter p-user-id as character        no-undo.
     2780      define variable v-login               as character    no-undo.
     2781      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2782      define buffer buf_user-login  for ub.user-login .
     2783      do
     2784      on error undo, return error
     2785      :
     2786            FIND FIRST buf_sys-ctrl no-lock.
     2787            ASSIGN
     2788               v-login = USERID("ub")
     2789               p-db-num = buf_sys-ctrl.db-num
     2790            .
     2791            FIND FIRST buf_user-login
     2792                 WHERE buf_user-login.db-num = p-db-num
     2793                   AND buf_user-login.user-login = v-login
     2794                 no-lock
     2795                 no-error
     2796                 .
     2797            IF AVAILABLE buf_user-login
     2798            THEN DO:
     2799               assign
     2800                  p-user-id = buf_user-login.user-id
     2801               .
     2802            END.
     2803      end.
     2804   end procedure.
     2805       run diasize_init in this-procedure .
     2806   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2807   on F2 of frame Dialog-Frame anywhere do:
     2808     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2809     return no-apply.
     2810   end.
     2811   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2812   procedure set-filter-name :
     2813   define input parameter p-filter-name as character no-undo .
     2814     do with frame Dialog-Frame:
     2815       if p-filter-name > "" then do:
     2816         assign
     2817           frame Dialog-Frame:title
     2818             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2819         .
     2820         assign
     2821           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2822         .
     2823       end.
     2824       else do:
     2825         assign
     2826           b-sch :tooltip = ""
     2827         .
     2828       end.
     2829     end.
     2830   end procedure.
     2831   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2832   do:
     2833     BR-colls :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2834   end.
     2835   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   on f5 of frame Dialog-Frame anywhere
     2837   do:
     2838      run refresh in this-procedure no-error.
     2839       apply "VALUE-CHANGED" to BR-colls.
     2840   end.
     2841   def var sort-labelBR-colls   as character no-undo .
     2842   def var sort-clmnBR-colls    as handle    no-undo .
     2843   def var cur-clmnBR-colls     as handle    no-undo .
     2844   def var cur-clmn-locBR-colls as integer   no-undo .
     2845   def var re-queryBR-colls     as logical   initial no no-undo .
     2846   on start-search, ctrl-o of BR-colls in frame Dialog-Frame do:
     2847      run sort-brBR-colls
     2848        (input (if available buf_batchprocess
     2849                then recid(buf_batchprocess)
     2850                else ?
     2851               )
     2852        ).
     2853   end.
     2854   PROCEDURE sort-brBR-colls :
     2855     define input parameter p-recid as recid no-undo .
     2856     if re-queryBR-colls = no then do:
     2857       assign
     2858          cur-clmnBR-colls = BR-colls:current-column in frame Dialog-Frame
     2859       .
     2860       if sort-clmnBR-colls <> ? then sort-clmnBR-colls:column-fgcolor = 0.
     2861       if cur-clmnBR-colls = sort-clmnBR-colls then do:
     2862         assign
     2863            sort-labelBR-colls = ""
     2864            sort-clmnBR-colls = ?
     2865         .
     2866        end.
     2867        else do:
     2868          assign
     2869            sort-labelBR-colls = cur-clmnBR-colls:label
     2870            sort-clmnBR-colls  = cur-clmnBR-colls
     2871            sort-clmnBR-colls:column-fgcolor = 4
     2872          .
     2873        end.
     2874      end.
     2875     assign
     2876       cur-clmn-locBR-colls = 1
     2877     .
     2878     def var column-handle as handle no-undo .
     2879     column-handle = BR-colls:first-column.
     2880     do while valid-handle(column-handle) :
     2881       if column-handle = cur-clmnBR-colls then do:
     2882         leave .
     2883       end.
     2884       column-handle = column-handle:NEXT-COLUMN.
     2885       assign
     2886         cur-clmn-locBR-colls = cur-clmn-locBR-colls + 1
     2887       .
     2888     end.
     2889     case sort-labelBR-colls:
     2890           when buF_BatchProcess.Key#_Two:label in browse BR-colls then DO:    assign       sort-column-name = "buF_BatchProcess.Key#_Two"     .     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).   . END.
     2891           when 'Тип коллизии'  then DO:   assign       sort-column-name = substitute('dynamic-funciotn(&1subject-title-function&1, buF_BatchProcess.CharKey_two)', chr(34))     .     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).   . END.
     2892           when 'Запись'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1uniq-key-rec-string-f&1, buF_BatchProcess.CharKey_one)', chr(34))     .     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).   . END.
     2893           when buF_BatchProcess.CharKey_Three:label in browse BR-colls then DO:    assign       sort-column-name = "buF_BatchProcess.CharKey_Three"     .     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).   . END.
     2894           when buF_BatchProcess.Key#_One:label in browse BR-colls then DO:    assign       sort-column-name = "buF_BatchProcess.Key#_One"     .     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).   . END.
     2895       otherwise do:
     2896         assign
     2897           sort-column-name = ""
     2898         .
     2899          RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).
     2900           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-colls') then do:
     2901             run mv-brw-defaultBR-colls.
     2902           end.
     2903         if sort-labelBR-colls <> "" then do:
     2904           assign
     2905             cur-clmnBR-colls:column-fgcolor = 0
     2906           .
     2907         end.
     2908         assign
     2909           cur-clmn-locBR-colls = ?
     2910         .
     2911       end.
     2912     end case.
     2913       if cur-clmn-locBR-colls <> ? then do:
     2914         if can-do( this-procedure:internal-entries, 'ch-clmnBR-colls') then do:
     2915           run ch-clmnBR-colls in this-procedure (cur-clmn-locBR-colls).
     2916         end.
     2917       end.
     2918     if p-recid <> ? then do:
     2919       reposition BR-colls to recid p-recid no-error.
     2920       apply "value-changed" to BR-colls in frame Dialog-Frame.
     2921     end.
     2922     apply "entry" to BR-colls in frame Dialog-Frame.
     2923   END PROCEDURE.
     2924   procedure re-open-query-srt-clmnBR-colls:
     2925   if cur-clmnBR-colls = ? then do:
     2926       RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).
     2927   end.
     2928   else do:
     2929      assign re-queryBR-colls = yes.
     2930      run sort-brBR-colls
     2931        (input (if available buf_batchprocess
     2932                then recid(buf_batchprocess)
     2933                else ?
     2934               )
     2935        ).
     2936      assign re-queryBR-colls = no.
     2937   end.
     2938   end.
     2939   MAIN-BLOCK:
     2940   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2941      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2942   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2943     run mainmenu_getcntxt in parparentproc
     2944       (output v-cntxt-db-num
     2945       ,output v-cntxt-userid
     2946       ,output v-cntxt-level
     2947       ,output v-cntxt-host-code-obj
     2948       ,output v-cntxt-obj-type
     2949       ,output v-cntxt-obj-code
     2950       ,output v-cntxt-db-num-obj
     2951       ,output v-cntxt-is-admin
     2952       ) .
     2953    if LOOKUP(p-mode, ('все':U + chr(4) +
     2954                       "db-num":U + chr(4) +
     2955                       "subject":U + chr(4) +
     2956                       "uniq-key-rec":U),
     2957                   chr(4)) = 0
     2958        then dO:
     2959       message
     2960       vss-workfile vss-revision vss-description skip
     2961       "Неверное значение параметров вызова p-mode"
     2962       p-mode
     2963       view-as alert-box ERROR.
     2964       return error .
     2965    end.
     2966    IF p-mode = "db-num":U THEN DO:
     2967      FIND FIRST X_db NO-LOCK WHERE X_db.db-num = p-db-num NO-ERROR.
     2968      IF NOT AVAILABLE X_db THEN DO:
     2969            message
     2970            vss-workfile vss-revision vss-description skip
     2971            "Неверное значение параметров вызова p-db-num"
     2972            p-db-num
     2973            view-as alert-box ERROR.
     2974            return error .
     2975       END.
     2976     END.
     2977     IF p-mode = "subject":U THEN DO:
     2978       IF LOOKUP (p-subject, 'ncoll_inn':U) = 0 THEN DO:
     2979         message
     2980         vss-workfile vss-revision vss-description skip
     2981         "Неверное значение параметров вызова p-subject"
     2982         p-subject
     2983         view-as alert-box ERROR.
     2984         return error .
     2985       END.
     2986     END.
     2987     IF p-mode = "uniq-key-rec":U THEN DO:
     2988       RUN gen-row-keyr IN THIS-PROCEDURE
     2989         ( input  p-uniq-key-rec
     2990          ,input  ?
     2991          ,input  "ub":U
     2992          ,input  ?
     2993          ,input  share-lock
     2994          ,output v-tbl-row
     2995          ,output v-tbl-name
     2996         ) NO-ERROR.
     2997       IF error-status:error THEN DO:
     2998         message
     2999         vss-workfile vss-revision vss-description skip
     3000         "Неверное значение параметров вызова p-uniq-key-rec"
     3001         p-uniq-key-rec
     3002         view-as alert-box ERROR.
     3003         return error .
     3004       END.
     3005     END.
     3006     RUN Myenable IN THIS-PROCEDURE.
     3007     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input no).
     3008     WAIT-FOR GO OF FRAME Dialog-Frame.
     3009   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3010   DEF VAR cur-clmn-numbr-colls as INT EXTENT 5 no-undo.
     3011   DEF VAR varmvibr-colls       as INT no-undo.
     3012   DEF VAR varmvjbr-colls       as INT no-undo.
     3013   DEF VAR varmvkbr-colls       as INT no-undo.
     3014   DEF VAR varmvlbr-colls       as INT no-undo.
     3015   DEF VAR move-elementbr-colls as INT no-undo.
     3016   def var jjbr-colls           as int no-undo.
     3017   do varmvibr-colls = 1 to EXTENT(cur-clmn-numbr-colls):
     3018     ASSIGN cur-clmn-numbr-colls[varmvibr-colls] = varmvibr-colls.
     3019   END.
     3020   RUN start-mv-clmnbr-colls.
     3021   PROCEDURE start-mv-clmnbr-colls:
     3022   def var old-session as logical no-undo.
     3023      old-session = SESSION:IMMEDIATE-DISPLAY.
     3024      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3025          IF  p-mode = 'все':U  THEN DO:
     3026      DO jjbr-colls = NUM-ENTRIES('1,2,3,4,5') TO 1 BY -1:
     3027        RUN re-move-clmnbr-colls ( cur-clmn-numbr-colls[INTEGER(ENTRY (jjbr-colls, '1,2,3,4,5'))] , 1).
     3028      END.
     3029          END.
     3030          IF  p-mode = 'db-num':U  THEN DO:
     3031      DO jjbr-colls = NUM-ENTRIES('1,2,3,4,5') TO 1 BY -1:
     3032        RUN re-move-clmnbr-colls ( cur-clmn-numbr-colls[INTEGER(ENTRY (jjbr-colls, '1,2,3,4,5'))] , 1).
     3033      END.
     3034          END.
     3035          IF  p-mode = 'subject':U  THEN DO:
     3036      DO jjbr-colls = NUM-ENTRIES('1,3,4,5,2') TO 1 BY -1:
     3037        RUN re-move-clmnbr-colls ( cur-clmn-numbr-colls[INTEGER(ENTRY (jjbr-colls, '1,3,4,5,2'))] , 1).
     3038      END.
     3039          END.
     3040          IF  p-mode = 'uniq-key-rec':U  THEN DO:
     3041      DO jjbr-colls = NUM-ENTRIES('1,2,4,5б3') TO 1 BY -1:
     3042        RUN re-move-clmnbr-colls ( cur-clmn-numbr-colls[INTEGER(ENTRY (jjbr-colls, '1,2,4,5б3'))] , 1).
     3043      END.
     3044          END.
     3045      SESSION:IMMEDIATE-DISPLAY = old-session.
     3046   END.
     3047   ON ctrl-cursor-right OF BROWSE br-colls do:
     3048     RUN re-move-clmnbr-colls ( 1, 5).
     3049   END.
     3050   ON ctrl-cursor-left OF BROWSE br-colls do:
     3051     RUN re-move-clmnbr-colls (5, 1).
     3052   END.
     3053   PROCEDURE re-move-clmnbr-colls:
     3054     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3055     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3056     DO varmvibr-colls = 1 TO EXTENT(cur-clmn-numbr-colls):
     3057       if cur-clmn-numbr-colls[varmvibr-colls] = source-column THEN cur-clmn-numbr-colls[varmvibr-colls] = -1.
     3058     END.
     3059     if br-colls:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3060     if source-column > target-column THEN
     3061     DO varmvjbr-colls = source-column - 1 to target-column BY -1:
     3062       DO varmvibr-colls = 1 TO EXTENT(cur-clmn-numbr-colls):
     3063           if cur-clmn-numbr-colls[varmvibr-colls] = varmvjbr-colls THEN DO:
     3064             cur-clmn-numbr-colls[varmvibr-colls] = cur-clmn-numbr-colls[varmvibr-colls] + 1.
     3065           END.
     3066       END.
     3067     END.
     3068     ELSE
     3069     DO varmvjbr-colls = source-column + 1 to target-column:
     3070       DO varmvibr-colls = 1 TO EXTENT(cur-clmn-numbr-colls):
     3071         if cur-clmn-numbr-colls[varmvibr-colls] = varmvjbr-colls THEN DO:
     3072           cur-clmn-numbr-colls[varmvibr-colls] = cur-clmn-numbr-colls[varmvibr-colls] - 1.
     3073         END.
     3074       END.
     3075     END.
     3076     DO varmvibr-colls = 1 TO EXTENT(cur-clmn-numbr-colls):
     3077       if cur-clmn-numbr-colls[varmvibr-colls] = -1 THEN cur-clmn-numbr-colls[varmvibr-colls] = target-column.
     3078     END.
     3079   END PROCEDURE.
     3080   PROCEDURE ch-clmnbr-colls:
     3081     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3082     if cur-clmn-loc <= 1 then do:
     3083       return .
     3084     end.
     3085     DO varmvibr-colls = 1 TO EXTENT(cur-clmn-numbr-colls):
     3086       if cur-clmn-numbr-colls[varmvibr-colls] = cur-clmn-loc THEN move-elementbr-colls = varmvibr-colls.
     3087     END.
     3088     RUN re-move-clmnbr-colls (cur-clmn-loc, 1).
     3089   END PROCEDURE.
     3090   PROCEDURE mv-brw-defaultbr-colls:
     3091   def var old-session as logical no-undo.
     3092     old-session = SESSION:IMMEDIATE-DISPLAY.
     3093     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3094     do varmvlbr-colls = 1 to EXTENT(cur-clmn-numbr-colls):
     3095       RUN re-move-clmnbr-colls (cur-clmn-numbr-colls[varmvlbr-colls], varmvlbr-colls).
     3096     END.
     3097     RUN start-mv-clmnbr-colls.
     3098     SESSION:IMMEDIATE-DISPLAY = old-session.
     3099   END PROCEDURE.
     3100   .
     3101   END.
     3102   RUN disable_UI.
     3103   PROCEDURE disable_UI :
     3104     HIDE FRAME Dialog-Frame.
     3105   END PROCEDURE.
     3106   PROCEDURE enable_UI :
     3107     ENABLE b-quit B-solve B-sch B-Help BR-colls
     3108         WITH FRAME Dialog-Frame.
     3109     VIEW FRAME Dialog-Frame.
     3110   END PROCEDURE.
     3111   PROCEDURE MyEnable :
     3112   ENABLE
     3113   b-quit
