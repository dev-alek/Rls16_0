     3916   PROCEDURE proc-b-sch :
     3917   assign
     3918     tbl = 'batchprocess'
     3919     join-tbl = 'buf_batchprocess'
     3920     fld = ""
     3921     lab = ""
     3922     spr = ""
     3923     dim = '0'
     3924     .
     3925   run fltfield-add in this-procedure('Key#_Two', 'Критичность', '',
     3926   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3927   run fltfield-add in this-procedure('Key#_One', '№ БД источника', 'db',
     3928   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3929   run fltfield-add in this-procedure('CharKey_Three', 'Значение предмета коллизии', '',
     3930   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3931   run fltfield-add in this-procedure('CharKey_two', 'Тип коллизии', 'nws-coll_codes',
     3932   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3933   Filter-Block:
     3934   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3935       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3936       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3937     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     3938     run OpenBr in this-procedure ( input yes, input no, input '':U).
     3939   END.
     3940   END PROCEDURE.
     3941   PROCEDURE proc-b-solve :
     3942   define variable ri as recid no-undo.
     3943   define variable glog as logical no-undo .
     3944   define variable v-tbl-row as rowid no-undo .
     3945   define buffer buf_firm for ub.firm.
     3946   define buffer buf_person for ub.person.
     3947   define buffer buf_clients for ub.clients.
     3948   IF NOT AVAILABLE buf_batchprocess THEN UNDO, RETURN ERROR.
     3949   assign
     3950   v-doc-rec = recid(buf_batchprocess).
     3951   CASE buf_batchprocess.charkey_two:
     3952       WHEN 'ncoll_inn':U THEN DO:
     3953   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3954   do:
     3955     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3956       (input  v-cntxt-db-num
     3957       ,input  v-cntxt-userid
     3958       ,input  0
     3959       ,input  'actn_client-reference_update':U
     3960       ,input  'global':U
     3961       ,input  0
     3962       ,input  '':U
     3963       ,input  0
     3964       ,input  0
     3965       ,input  0
     3966       ,input  0
     3967       ,input  true
     3968       ,output glog
     3969       )  .
     3970   end.
     3971          if not glog then return .
     3972          run  gen-row-keyr  in this-procedure
     3973            ( input  buf_batchprocess.charkey_one
     3974             ,input ?
     3975             ,input "ub":U
     3976             ,input ?
     3977             ,input share-lock
     3978             ,output v-tbl-row
     3979             ,output v-tbl-name
     3980            ).
     3981          CASE v-tbl-name:
     3982            when 'firm':U then do:
     3983              find first buf_firm no-lock where
     3984                       rowid(buf_firm) = v-tbl-row .
     3985              find first buf_clients no-lock where
     3986                         buf_clients.obj-type = 'орг':U
     3987                    and buf_clients.obj-code = buf_firm.firm-code .
     3988            end.
     3989            when 'person':U then do:
     3990              find first buf_person no-lock where
     3991                       rowid(buf_person) = v-tbl-row .
     3992              find first buf_clients no-lock where
     3993                         buf_clients.obj-type = 'чел':U
     3994                    and buf_clients.obj-code = buf_person.psn-code .
     3995            end.
     3996          END CASE.
     3997          ri = recid( buf_clients ) .
     3998          MESSAGE
     3999          substitute("Для разбора коллизии Вам необходимо изменить ИНН КОНТРАГЕНТА &1&2"
     4000                    , buf_clients.obj-type
     4001                    , buf_clients.obj-code
     4002                    )
     4003         VIEW-AS ALERT-BOX.
     4004          CASE buf_clients.obj-type:
     4005            when 'орг':U  then
     4006            run ref/firmi.w (
     4007                      input parParentProc
     4008                     ,input 'ИЗМЕНЕНИЕ':U
     4009                     ,input buf_clients.obj-code
     4010                     ,input 0
     4011                     ,input "cli-all"
     4012                     ,input-output  ri) .
     4013            when 'чел':U then
     4014             run ref/personi.w (
     4015                        input parParentProc
     4016                       ,input 'ИЗМЕНЕНИЕ':U
     4017                       ,input buf_Clients.obj-code
     4018                       ,input 0
     4019                       ,input "cli-all"
     4020                       ,input-output  ri) .
     4021           END CASE .
     4022           if ri <> ? then do:
     4023             run openbr in this-procedure ( input yes, input no, input "").
     4024             reposition br-colls to recid v-doc-rec no-error.
     4025             apply "ENTRY" to br-colls in frame Dialog-Frame .
     4026           end.
     4027       END.
     4028   END CASE.
     4029   END PROCEDURE.
     4030   PROCEDURE refresh :
     4031   DEFINE VARIABLE v-doc-rec AS RECID no-undo.
     4032   IF NOT AVAILABLE buf_batchprocess THEN RETURN.
     4033   v-doc-rec = RECID(buf_batchprocess).
     4034   run openbr in this-procedure ( input yes, input no, input "").
     4035   reposition br-colls to recid v-doc-rec no-error.
     4036   END PROCEDURE.
     4037   FUNCTION subject-title-function RETURNS CHARACTER
     4038     (INPUT p-subject AS CHARACTER) :
     4039   define variable v-name as character no-undo .
     4040   assign
     4041   v-name = entry (lookup (p-subject, 'ncoll_inn':U), 'Коллизия по ИНН':U) no-error .
     4042   RETURN v-name.
     4043   END FUNCTION.
