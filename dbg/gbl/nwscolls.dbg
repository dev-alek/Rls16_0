     3172         ) no-error .
     3173     assign
     3174       l-filter-open-18 = false
     3175     .
     3176     if flt-rec-18 <> ?
     3177       or sort-column-phrase > ""
     3178     then do:
     3179       define variable  parameter-2-18 as character no-undo .
     3180       define variable  parameter-3-18 as character no-undo .
     3181       define variable  parameter-4-18 as character no-undo .
     3182       define variable  parameter-5-18 as character no-undo .
     3183       define variable  parameter-6-18 as character no-undo .
     3184       define variable  parameter-7-18 as character no-undo .
     3185         assign
     3186         parameter-3-18 =
     3187                                 "FOR EACH buf_batchprocess"
     3188         parameter-4-18 =
     3189           (
     3190             if (" buf_batchprocess.bp_type = 'coll':u  and buf_batchprocess.bp_status = 'N':U " + " " + where-phrase-18) <> ""
     3191             then " buf_batchprocess.bp_type = 'coll':u  and buf_batchprocess.bp_status = 'N':U " + " " + where-phrase-18
     3192             else "true"
     3193           )
     3194         parameter-5-18 = (" " + "" + " " + "")
     3195         parameter-6-18 = if sort-phrase-18 = ''
     3196                              then
     3197           (
     3198           " " + "  " +
     3199             " " + sort-column-phrase +
     3200           " " + "  "
     3201           )
     3202                              else
