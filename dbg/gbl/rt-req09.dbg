        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as widget-handle no-undo .
        3   define input  parameter p-directory-out     as character no-undo .
        4   define input  parameter p-file-name         as character no-undo .
        5   define input  parameter p-session-valid     as logical   no-undo .
        6   define input  parameter p-error-message     as character no-undo .
        7   define input  parameter p-user-login        as character no-undo .
        8   define input  parameter p-obj-type          as character no-undo .
        9   define input  parameter p-obj-code          as character no-undo .
       10   define input  parameter p-host-code         as character no-undo .
       11   define input  parameter p-doc-type          as character no-undo .
       12   define input  parameter p-doc-code          as character no-undo .
       13   define input  parameter p-bar-code          as character no-undo .
       14   define input  parameter p-fact-qnty         as character no-undo .
       15   define input  parameter p-prod-artic        as character no-undo .
       16   define input  parameter p-prod-artic-search as character no-undo .
       17   define input  parameter p-deadline-date     as character no-undo .
       18   define input  parameter p-cop-check         as character no-undo .
       19   define input  parameter p-price-docf        as character no-undo .
       20   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       21   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       22   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile: rt-req09.p $":U .
       24   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req09.p $":U .
       25   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 09. Приемка товара. Редактирование фактических количеств".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure integerm :
       88     define input  parameter p-string      as character no-undo .
       89     define input  parameter p-allow-sign  as logical   no-undo .
       90     define input  parameter p-allow-comma as logical   no-undo .
       91     define output parameter p-value       as integer   no-undo .
       92     define output parameter p-data-valid  as logical   no-undo .
       93     define output parameter p-message     as character no-undo .
       94     define variable v-replace-string as character no-undo .
       95     do
       96     on error undo, return error return-value
       97     :
       98       if p-string = ?
       99       then do:
      100         assign
      101           p-value      = ?
      102           p-data-valid = false
      103           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      104         .
      105         return .
      106       end.
      107       if p-string = ""
      108       then do:
      109         assign
      110           p-value      = ?
      111           p-data-valid = false
      112           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      113         .
      114         return .
      115       end.
      116       assign
      117         p-value = integer(p-string) no-error
      118       .
      119       if error-status :error = true
      120       then do:
      121         assign
      122           p-value      = ?
      123           p-data-valid = false
      124           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      125                                    ,p-string
      126                                    )
      127         .
      128         return .
      129       end.
      130       if index(p-string, ' ':u) > 0
      131       then do:
      132         assign
      133           p-value      = ?
      134           p-data-valid = false
      135           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      136                                    + "Строка содержит символы пробела"
      137                                    ,p-string
      138                                    )
      139         .
      140         return .
      141       end.
      142       assign
      143         v-replace-string = p-string
      144         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      150         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      151         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      152         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      153       .
      154       if p-allow-sign = true
      155       then do:
      156         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      157         then do:
      158           assign
      159             v-replace-string = substring(v-replace-string, 2)
      160           .
      161         end.
      162       end.
      163       else do:
      164         if substring(v-replace-string, 1, 1) = '+':u
      165         then do:
      166           assign
      167             p-value      = ?
      168             p-data-valid = false
      169             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      170                                     + "Задан параметр недопустимости знака челого числа. "
      171                                     + "Строка содержит символ плюс. "
      172                                     ,p-string
      173                                     )
      174           .
      175           return .
      176         end.
      177         if substring(v-replace-string, 1, 1) = '-':u
      178         then do:
      179           assign
      180             p-value      = ?
      181             p-data-valid = false
      182             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      183                                     + "Задан параметр недопустимости знака челого числа. "
      184                                     + "Строка содержит символ минус. "
      185                                     ,p-string
      186                                     )
      187           .
      188           return .
      189         end.
      190       end.
      191       if p-allow-comma = true
      192       then do:
      193         assign
      194           v-replace-string = replace(v-replace-string, ',', '')
      195         .
      196       end.
      197       else do:
      198         if index(v-replace-string, ',') > 0
      199         then do:
      200           assign
      201             p-value      = ?
      202             p-data-valid = false
      203             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      204                                     + "Задан параметр недопустимости знака разделителя тысяч."
      205                                     + "Строка содержит знак разделителя тысяч. "
      206                                     ,p-string
      207                                     )
      208           .
      209           return .
      210         end.
      211       end.
      212       if index(p-string, '.') > 0
      213       then do:
      214         assign
      215           p-value      = ?
      216           p-data-valid = false
      217           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      218                                    + "Строка содержит знак десятичной точки"
      219                                    ,p-string
      220                                    )
      221         .
      222         return .
      223       end.
      224       if v-replace-string <> fill('9', length(v-replace-string))
      225       then do:
      226         assign
      227           p-value      = ?
      228           p-data-valid = false
      229           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      230                                    + "Встречены символы, недопустимые для целого числа '&2'"
      231                                    ,p-string
      232                                    ,replace(v-replace-string, '9', '')
      233                                    )
      234         .
      235         return .
      236       end.
      237       assign
      238         p-data-valid = true
      239         p-message    = ""
      240       .
      241     end.
      242   end procedure.
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   function rtencode returns character
      245     ( p-init-string as character
      246     ) :
      247     define variable v-encode-string as character no-undo .
      248     if p-init-string = ?
      249     then do:
      250       assign
      251         v-encode-string = '?':u
      252       .
      253       return v-encode-string .
      254     end.
      255     if p-init-string = '?':u
      256     then do:
      257       assign
      258         v-encode-string = '~~077':u
      259       .
      260       return v-encode-string .
      261     end.
      262     assign
      263       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      264       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      265       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      266     .
      267     return v-encode-string .
      268   end function .
      269   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      270   procedure rt-cnvdc_decode :
      271     define input  parameter p-encoded-str as character no-undo .
      272     define output parameter p-decoded-str as character no-undo .
      273   do
      274   on error undo, return error return-value
      275   :
      276     define variable v-decoded-str as character no-undo .
      277     assign
      278       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      279       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      280       p-decoded-str = v-decoded-str
      281     .
      282   end.
      283   end procedure.
      284   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      285   define variable v-rt-cntxt_parparentproc  as handle    no-undo .
      286   define variable v-rt-cntxt_proc-signature as character no-undo .
      287   procedure rt-cntxt_setcntxt :
      288     define input parameter p-cntxt-db-num        as integer   no-undo .
      289     define input parameter p-cntxt-user-id       as character no-undo .
      290     define input parameter p-cntxt-level         as character no-undo .
      291     define input parameter p-cntxt-host-code-obj as integer   no-undo .
      292     define input parameter p-cntxt-obj-type      as character no-undo .
      293     define input parameter p-cntxt-obj-code      as integer   no-undo .
      294     define input parameter p-cntxt-db-num-obj    as integer   no-undo .
      295     define input parameter p-cntxt-is-admin      as logical   no-undo .
      296   do
      297   on error undo, return error return-value
      298   :
      299     run w-reqsrv_setcntxt in parparentproc
      300       ( input p-cntxt-db-num
      301       , input p-cntxt-user-id
      302       , input p-cntxt-level
      303       , input p-cntxt-host-code-obj
      304       , input p-cntxt-obj-type
      305       , input p-cntxt-obj-code
      306       , input p-cntxt-db-num-obj
      307       , input p-cntxt-is-admin
      308       ) .
      309   end.
      310   end procedure.
      311   procedure rt-cntxt_clrcntxt :
      312   do
      313   on error undo, return error return-value
      314   :
      315     run w-reqsrv_clrcntxt in parparentproc .
      316   end.
      317   end procedure.
      318   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   procedure strtdate :
      320     define input  parameter p-str         as character no-undo .
      321     define output parameter p-value       as date      no-undo .
      322     define output parameter p-data-valid  as logical   no-undo .
      323     define output parameter p-message     as character no-undo .
      324   do
      325   on error undo, return error return-value
      326   :
      327     define variable v-value       as date      no-undo .
      328     define variable v-i           as integer   no-undo .
      329     define variable v-num         as integer   no-undo .
      330     define variable v-delim       as character no-undo .
      331     define variable v-delim-list  as character no-undo .
      332     define variable v-day         as integer   no-undo .
      333     define variable v-month       as integer   no-undo .
      334     define variable v-year        as integer   no-undo .
      335     define variable v-day-str     as character no-undo .
      336     define variable v-month-str   as character no-undo .
      337     define variable v-year-str    as character no-undo .
      338     assign
      339       p-value       = ?
      340       p-data-valid  = false
      341     .
      342     if p-str = ?
      343     then do:
      344       assign
      345         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      346       .
      347       return .
      348     end.
      349     if p-str = ""
      350     then do:
      351       assign
      352         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      353       .
      354       return .
      355     end.
      356     if length(p-str)  > 10
      357     then do:
      358       assign
      359         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      360       .
      361       return .
      362     end.
      363     assign
      364       v-delim-list = '/,-,.':U
      365     .
      366     _delim:
      367     do v-i = 1 to num-entries( v-delim-list )
      368     :
      369       assign
      370         v-delim = entry( v-i , v-delim-list )
      371         v-num   = num-entries( p-str , v-delim )
      372       .
      373       if v-num <> 3
      374       then do:
      375         assign
      376           v-delim = ''
      377         .
      378       end.
      379       else do:
      380         leave _delim.
      381       end.
      382     end.
      383     if v-delim = ''
      384     then do:
      385       assign
      386         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      387       .
      388       return .
      389     end.
      390     assign
      391       v-day-str   = entry( 1, p-str , v-delim)
      392       v-month-str = entry( 2, p-str , v-delim)
      393       v-year-str  = entry( 3, p-str , v-delim)
      394     .
      395     if  length(v-day-str) > 2   or
      396         length(v-day-str) < 1   or
      397         length(v-month-str) > 2 or
      398         length(v-month-str) < 1 or
      399         (
      400           length(v-year-str) <> 2 and
      401           length(v-year-str) <> 4
      402         )
      403     then do:
      404       assign
      405         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      406       .
      407       return .
      408     end.
      409     if length( v-year-str ) = 2
      410     then do:
      411       assign
      412         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      413       .
      414     end.
      415     assign
      416       v-day   = integer( v-day-str )
      417       v-month = integer( v-month-str)
      418       v-year  = integer( v-year-str)
      419     no-error .
      420     if error-status :error
      421     then do:
      422       assign
      423         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      424       .
      425       return .
      426     end.
      427     if v-day < 1  or
      428        v-day > 31 or
      429        v-month < 1 or
      430        v-month > 12 or
      431        v-year < 0   or
      432        v-year > 5000
      433     then do:
      434       assign
      435         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      436       .
      437       return .
      438     end.
      439     assign
      440       v-value = date( v-month, v-day, v-year )
      441     no-error .
      442     if error-status :error
      443     then do:
      444       assign
      445         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      446       .
      447       return .
      448     end.
      449     assign
      450       p-value       = v-value
      451       p-data-valid  = true
      452     .
      453   end.
      454   end procedure.
      455   define stream sout .
      456   define variable v-status          as character no-undo .
      457   define variable v-error-message   as character no-undo .
      458   define variable v-unique-doc-code as character no-undo .
      459   define variable v-b-code          as character no-undo .
      460   define variable v-artic           as character no-undo .
      461   define variable v-name            as character no-undo .
      462   define variable v-prod-type       as character no-undo .
      463   define variable v-prod-code       as integer   no-undo .
      464   define variable v-prod-name       as character no-undo .
      465   define variable v-doc-qnty        as character no-undo .
      466   define variable v-unit-base       as character no-undo .
      467   define variable v-doc-sum         as character no-undo .
      468   define variable v-curr-abbr       as character no-undo .
      469   do
      470   on error undo, return error return-value
      471   :
      472     if p-session-valid = true
      473     then do:
      474       run check-data in this-procedure
      475         (output  v-status
      476         ,output  v-error-message
      477         ) no-error .
      478       if error-status :error
      479       then do:
      480         run rt-cntxt_clrcntxt in this-procedure .
      481         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      482                                     ,error-status :get-message(1)
      483                                     ,return-value
      484                                     ) .
      485       end.
      486     end.
      487     else do:
      488       assign
      489         v-status        = '1':u
      490         v-error-message = p-error-message
      491       .
      492     end.
      493     define variable v-temp-file-name as character no-undo .
      494     assign
      495       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      496     .
      497     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      498     put stream sout unformatted substitute('status:&1', rtencode(v-status))
      499                                 + chr(10) .
      500     put stream sout unformatted substitute('message:&1',rtencode(v-error-message))
      501                                 + chr(10) .
      502     output stream sout close .
      503     os-delete value(p-directory-out + '/':u + p-file-name) .
      504     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      505               value(p-directory-out + '/':u + p-file-name)
      506               .
      507     run rt-cntxt_clrcntxt in this-procedure .
      508   end.
      509   procedure check-data :
      510     define output parameter p-status        as character no-undo .
      511     define output parameter p-error-message as character no-undo .
      512     define buffer buf_clients     for ub.clients .
      513     define buffer buf_sysconf     for ub.sysconf .
      514     define buffer buf_sys-ctrl    for ub.sys-ctrl .
      515     define buffer buf_user-login  for ub.user-login .
      516     define buffer buf_ext-artic   for ub.ext-artic.
      517     define buffer buf_goods       for ub.goods.
      518     define variable v-bar-code        like ub.bar-code.b-code  no-undo .
      519     define variable v-last-date-str   as date      no-undo .
      520     define variable v-price-docf      as character no-undo .
      521     define variable v-inp-price       as decimal   no-undo .
      522     define variable v-is-hold-doc     as logical   no-undo .
      523     do
      524     on error undo, return error return-value
      525     :
      526       find first buf_sys-ctrl no-lock .
      527       find first buf_user-login no-lock
      528         where buf_user-login.db-num     = buf_sys-ctrl.db-num
      529           and buf_user-login.status_    = 0
      530           and buf_user-login.user-login = p-user-login
      531         no-error .
      532       if not available buf_user-login
      533       then do:
      534         assign
      535           p-status        = '1':u
      536           p-error-message = substitute("Неизвестный пользователь &1"
      537                                       ,p-user-login
      538                                       )
      539         .
      540         return .
      541       end.
      542       define variable v-obj-code      as integer   no-undo .
      543       define variable v-data-valid    as logical   no-undo .
