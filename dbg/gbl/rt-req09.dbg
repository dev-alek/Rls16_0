     1475               ,output p-error-message
     1476               ,output v-b-code
     1477               ,output v-artic
     1478               ,output v-name
     1479               ,output v-prod-type
     1480               ,output v-prod-code
     1481               ,output v-prod-name
     1482               ,output v-doc-qnty
     1483               ,output v-unit-base
     1484               ,output v-doc-sum
     1485               ,output v-curr-abbr
     1486               ,output v-last-date-str
     1487               ,output v-price-docf
     1488               ) .
     1489             if p-status <> '0':u
