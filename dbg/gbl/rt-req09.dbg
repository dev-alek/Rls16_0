     1251             run gbl/rt-bcode.p
     1252               (input  parparentproc
     1253               ,input  v-unique-doc-code
     1254               ,input  p-bar-code
     1255               ,input  v-fact-qnty
     1256               ,input  v-inp-price
     1257               ,input  v-cop-check
     1258               ,output p-status
     1259               ,output p-error-message
     1260               ,output v-b-code
     1261               ,output v-artic
     1262               ,output v-name
     1263               ,output v-prod-type
     1264               ,output v-prod-code
     1265               ,output v-prod-name
     1266               ,output v-doc-qnty
     1267               ,output v-unit-base
     1268               ,output v-doc-sum
     1269               ,output v-curr-abbr
     1270               ,output v-last-date-str
     1271               ,output v-price-docf
     1272               ) .
     1273             if p-status <> '0':u
     1274             then do:
