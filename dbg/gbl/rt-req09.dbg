     1344             or buf_trn-doc.obj-code <> v-obj-code
     1345             then do:
     1346               assign
     1347                 p-status        = '1':u
     1348                 p-error-message = substitute("Документ &1 принадлежит объекту &2 &3"
     1349                                             ,v-search-doc-code
     1350                                             ,p-obj-type
     1351                                             ,v-obj-code
     1352                                             )
     1353               .
     1354               undo main_block, return .
     1355             end.
     1356             case buf_trn-doc.ext-doc-type
     1357             :
     1358               when 'ev':U
     1359               then do:
     1360               end.
     1361               when 'ee':U
     1362               then do:
     1363   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1364   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     1365     (input  buf_trn-doc.doc-code
     1366     ,output v-is-hold-doc
     1367     )  .
     1368                 if v-is-hold-doc <> yes
     1369                 then do:
     1370                   assign
     1371                     p-status        = '1':u
     1372                     p-error-message = substitute("Документ внешнего расхода &1 не межфирменный"
     1373                                                 ,v-search-doc-code
     1374                                                 )
     1375                   .
     1376                   undo main_block, return .
     1377                 end.
     1378               end.
     1379               otherwise do:
     1380                 assign
