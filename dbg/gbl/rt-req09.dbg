     1420               end.
     1421               assign
     1422                 p-status = '1':u
     1423                 p-error-message = substitute("Неизвестный статус &1 складского документа &2"
     1424                                             ,p-status
     1425                                             ,v-unique-doc-code
     1426                                             )
     1427               .
     1428               undo main_block, return .
     1429             end.
     1430             if v-prod-artic-search = true
     1431             then do:
     1432               find first buf_ext-artic no-lock
     1433                 where buf_ext-artic.cli-type  = buf_trn-doc.cli-type
     1434                   and buf_ext-artic.cli-code  = buf_trn-doc.cli-code
     1435                   and buf_ext-artic.ext-artic = p-bar-code
     1436                   and buf_ext-artic.status_   = 'тек':U
     1437               no-error .
