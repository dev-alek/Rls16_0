     1276                 p-status = '1':u
     1277               .
     1278               undo main_block, return .
     1279             end.
     1280             define variable v-curr-qnty       as decimal   no-undo .
     1281             define variable v-set-qnty        as decimal   no-undo .
     1282             define variable v-curr-last-date  as date      no-undo .
     1283             define variable v-curr-price-docf as decimal   no-undo .
     1284             if v-fact-qnty > 0 then do:
