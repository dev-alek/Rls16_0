     1520               p-error-message = substitute("Неизвестный тип документа &1"
     1521                                           ,p-doc-type
     1522                                           )
     1523             .
     1524             undo main_block, return .
     1525           end.
     1526         end case .
     1527       end.
     1528       assign
     1529         p-status        = '1'
     1530         p-error-message = "Неизвестная ошибка"
     1531       .
     1532       return .
     1533     end.
     1534   end procedure.
