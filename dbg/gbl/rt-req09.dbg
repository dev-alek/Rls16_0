     1404               (input  v-unique-doc-code
     1405               ,input  buf_user-login.user-id
     1406               ,input  '':u
     1407               ,input  'check':u
     1408               ,input "":U
     1409               ,output p-status
     1410               ,output p-error-message
     1411               ) .
     1412             if p-status <> '1':u
