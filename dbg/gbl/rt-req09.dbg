     1492             end.
     1493             run gbl/rt-lined.p
     1494               (input  v-unique-doc-code
     1495               ,input  v-b-code
     1496               ,input  v-fact-qnty
     1497               ,input  v-last-date
     1498               ,input  ( if v-inp-price <> ? then v-inp-price else decimal(v-price-docf) )
     1499               ,input  buf_user-login.user-id
     1500               ,input  'create-update'
     1501               ,output p-status
     1502               ,output p-error-message
     1503               ) .
     1504             if p-status <> '0':u
     1505             then do:
     1506               assign
