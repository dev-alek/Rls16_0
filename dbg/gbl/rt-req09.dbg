     1126                       p-bar-code = string( v-bar-code )
     1127                     .
     1128                   end.
     1129               end.
     1130             end.
     1131             run gbl/rt-bcode.p
     1132               (input  parparentproc
     1133               ,input  v-unique-doc-code
     1134               ,input  p-bar-code
     1135               ,input  v-fact-qnty
     1136               ,input  v-inp-price
     1137               ,input  v-cop-check
     1138               ,output p-status
     1139               ,output p-error-message
     1140               ,output v-b-code
     1141               ,output v-artic
