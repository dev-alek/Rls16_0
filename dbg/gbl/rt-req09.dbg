     1309               ,input  ( if v-inp-price <> ? then v-inp-price else decimal(v-price-docf) )
     1310               ,input  buf_user-login.user-id
     1311               ,input  'create-update'
     1312               ,output p-status
     1313               ,output p-error-message
     1314               ) .
     1315             if p-status <> '0':u
     1316             then do:
     1317               assign
     1318                 p-status        = '1':u
     1319               .
     1320               undo main_block, return .
     1321             end.
     1322             assign
     1323               p-status        = '0':u
     1324               p-error-message = '':u
     1325             .
     1326             return .
     1327           end.
     1328           when 'РН':U
     1329           then do:
     1330             find first buf_trn-doc exclusive-lock
     1331               where buf_trn-doc.doc-code = v-search-doc-code
     1332               no-error .
     1333             if not available buf_trn-doc
     1334             then do:
     1335               assign
     1336                 p-status        = '1':u
