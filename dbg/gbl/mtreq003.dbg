        1   block-level on error undo, throw.
        2   define input  parameter parparentproc       as handle    no-undo .
        3   define input  parameter p-device-id         as character no-undo .
        4   define input  parameter p-user-login        as character no-undo .
        5   define input  parameter p-obj-type          as character no-undo .
        6   define input  parameter p-obj-code          as integer   no-undo .
        7   define input  parameter p-doc-code          as character no-undo .
        8   define input  parameter p-line-num          as integer   no-undo .
        9   define input  parameter p-mode              as character no-undo .
       10   define input  parameter p-src-code          as character no-undo .
       11   define input  parameter p-src-qnty          as decimal   no-undo .
       12   define input  parameter p-pump              as integer   no-undo .
       13   define input  parameter p-nozzle-code       as integer   no-undo .
       14   define input  parameter p-pl-code           as integer   no-undo .
       15   define input  parameter p-write-off-code    as integer   no-undo .
       16   define input  parameter p-pass-gds          as integer   no-undo .
       17   define input  parameter p-fbr-depart        as integer   no-undo .
       18   define output parameter p-send-message  as character no-undo .
       19   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       20   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       21   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile: mtreq003.p $":U .
       23   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq003.p $":U .
       24   define variable vss-description as character no-undo init "Мобильный терминал. Ввод строки чека".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure integerm :
       87     define input  parameter p-string      as character no-undo .
       88     define input  parameter p-allow-sign  as logical   no-undo .
       89     define input  parameter p-allow-comma as logical   no-undo .
       90     define output parameter p-value       as integer   no-undo .
       91     define output parameter p-data-valid  as logical   no-undo .
       92     define output parameter p-message     as character no-undo .
       93     define variable v-replace-string as character no-undo .
       94     do
       95     on error undo, return error return-value
       96     :
       97       if p-string = ?
       98       then do:
       99         assign
      100           p-value      = ?
      101           p-data-valid = false
      102           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      103         .
      104         return .
      105       end.
      106       if p-string = ""
      107       then do:
      108         assign
      109           p-value      = ?
      110           p-data-valid = false
      111           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      112         .
      113         return .
      114       end.
      115       assign
      116         p-value = integer(p-string) no-error
      117       .
      118       if error-status :error = true
      119       then do:
      120         assign
      121           p-value      = ?
      122           p-data-valid = false
      123           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      124                                    ,p-string
      125                                    )
      126         .
      127         return .
      128       end.
      129       if index(p-string, ' ':u) > 0
      130       then do:
      131         assign
      132           p-value      = ?
      133           p-data-valid = false
      134           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      135                                    + "Строка содержит символы пробела"
      136                                    ,p-string
      137                                    )
      138         .
      139         return .
      140       end.
      141       assign
      142         v-replace-string = p-string
      143         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      150         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      151         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      152       .
      153       if p-allow-sign = true
      154       then do:
      155         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      156         then do:
      157           assign
      158             v-replace-string = substring(v-replace-string, 2)
      159           .
      160         end.
      161       end.
      162       else do:
      163         if substring(v-replace-string, 1, 1) = '+':u
      164         then do:
      165           assign
      166             p-value      = ?
      167             p-data-valid = false
      168             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      169                                     + "Задан параметр недопустимости знака челого числа. "
      170                                     + "Строка содержит символ плюс. "
      171                                     ,p-string
      172                                     )
      173           .
      174           return .
      175         end.
      176         if substring(v-replace-string, 1, 1) = '-':u
      177         then do:
      178           assign
      179             p-value      = ?
      180             p-data-valid = false
      181             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      182                                     + "Задан параметр недопустимости знака челого числа. "
      183                                     + "Строка содержит символ минус. "
      184                                     ,p-string
      185                                     )
      186           .
      187           return .
      188         end.
      189       end.
      190       if p-allow-comma = true
      191       then do:
      192         assign
      193           v-replace-string = replace(v-replace-string, ',', '')
      194         .
      195       end.
      196       else do:
      197         if index(v-replace-string, ',') > 0
      198         then do:
      199           assign
      200             p-value      = ?
      201             p-data-valid = false
      202             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      203                                     + "Задан параметр недопустимости знака разделителя тысяч."
      204                                     + "Строка содержит знак разделителя тысяч. "
      205                                     ,p-string
      206                                     )
      207           .
      208           return .
      209         end.
      210       end.
      211       if index(p-string, '.') > 0
      212       then do:
      213         assign
      214           p-value      = ?
      215           p-data-valid = false
      216           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      217                                    + "Строка содержит знак десятичной точки"
      218                                    ,p-string
      219                                    )
      220         .
      221         return .
      222       end.
      223       if v-replace-string <> fill('9', length(v-replace-string))
      224       then do:
      225         assign
      226           p-value      = ?
      227           p-data-valid = false
      228           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      229                                    + "Встречены символы, недопустимые для целого числа '&2'"
      230                                    ,p-string
      231                                    ,replace(v-replace-string, '9', '')
      232                                    )
      233         .
      234         return .
      235       end.
      236       assign
      237         p-data-valid = true
      238         p-message    = ""
      239       .
      240     end.
      241   end procedure.
      242   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   define new global shared variable g#libthpos as handle no-undo .
      244   do
      245   on error undo, return error return-value
      246   :
      247     define variable v-sendmemptr  as memptr   no-undo .
      248     define variable hdocument as handle    no-undo .
      249     define variable hroot     as handle    no-undo .
      250     define variable hchild    as handle    no-undo .
      251     define variable htext     as handle    no-undo .
      252     define variable icounter        as integer   no-undo .
      253     define variable v-ok            as logical   no-undo .
      254     define variable v-message       as longchar  no-undo .
      255     define variable v-err-message   as character no-undo .
      256     define variable v-setted        as logical   no-undo .
      257     define variable v-b-code        as character no-undo .
      258     define variable v-gds-code      as integer   no-undo .
      259     define variable v-chk-name      as character no-undo .
      260     define variable v-second-name   as character no-undo .
      261     define variable v-src-price     as decimal   no-undo .
      262     define variable v-src-discnt    as decimal   no-undo .
      263     define variable v-src-sum       as decimal   no-undo .
      264     define variable v-src-sum-netto as decimal   no-undo .
      265     define variable v-tot-doc       as decimal   no-undo .
      266     define variable v-src-qnty-out  as decimal   no-undo .
      267     run check-data in this-procedure ( output v-ok
      268                                      , output v-err-message
      269                                      , output v-setted
      270                                      , output v-b-code
      271                                      , output v-gds-code
      272                                      , output v-chk-name
      273                                      , output v-second-name
      274                                      , output v-src-price
      275                                      , output v-src-discnt
      276                                      , output v-src-sum
      277                                      , output v-src-sum-netto
      278                                      , output v-tot-doc
      279                                      , output v-src-qnty-out
      280                                      ) .
      281     create x-document hdocument.
      282     create x-noderef hroot.
      283     create x-noderef hchild.
      284     create x-noderef htext.
      285     hdocument:encoding = "UTF-8" .
      286     hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
      287     hdocument:APPEND-CHILD(hRoot).
      288     hdocument:create-node(hChild, "stts", "ELEMENT").
      289     hRoot:append-child(hChild).
      290     hdocument:create-node(hText, "", "TEXT").
      291     hChild:append-child(hText).
      292     hText:node-value = substitute( "&1" , (if v-ok then 0 else 1)).
      293     hdocument:create-node(hChild, "errmsg", "ELEMENT").
      294     hRoot:append-child(hChild).
      295     hdocument:create-node(hText, "", "TEXT").
      296     hChild:append-child(hText).
      297     hText:node-value = v-err-message .
      298     hdocument:create-node(hChild, "deviceid", "ELEMENT").
      299     hRoot:append-child(hChild).
      300     hdocument:create-node(hText, "", "TEXT").
      301     hChild:append-child(hText).
      302     hText:node-value = p-device-id.
      303     hdocument:create-node(hChild, "setted", "ELEMENT").
      304     hRoot:append-child(hChild).
      305     hdocument:create-node(hText, "", "TEXT").
      306     hChild:append-child(hText).
      307     hText:node-value = substitute( "&1" , if v-setted then 0 else 1 ).
      308     hdocument:create-node(hChild, "bcode", "ELEMENT").
      309     hRoot:append-child(hChild).
      310     hdocument:create-node(hText, "", "TEXT").
      311     hChild:append-child(hText).
      312     hText:node-value = substitute( "&1", string(v-b-code) ).
      313     hdocument:create-node(hChild, "gdscode", "ELEMENT").
      314     hRoot:append-child(hChild).
      315     hdocument:create-node(hText, "", "TEXT").
      316     hChild:append-child(hText).
      317     hText:node-value = substitute( "&1", string(v-gds-code) ).
      318     hdocument:create-node(hChild, "chkname", "ELEMENT").
      319     hRoot:append-child(hChild).
      320     hdocument:create-node(hText, "", "TEXT").
      321     hChild:append-child(hText).
      322     hText:node-value = substitute( "&1", v-chk-name ).
      323     hdocument:create-node(hChild, "secondname", "ELEMENT").
      324     hRoot:append-child(hChild).
      325     hdocument:create-node(hText, "", "TEXT").
      326     hChild:append-child(hText).
      327     hText:node-value = substitute( "&1", v-second-name ).
      328     hdocument:create-node(hChild, "srcprice", "ELEMENT").
      329     hRoot:append-child(hChild).
      330     hdocument:create-node(hText, "", "TEXT").
      331     hChild:append-child(hText).
      332     hText:node-value = substitute( "&1", string(v-src-price)).
      333     hdocument:create-node(hChild, "srcdiscnt", "ELEMENT").
      334     hRoot:append-child(hChild).
      335     hdocument:create-node(hText, "", "TEXT").
      336     hChild:append-child(hText).
      337     hText:node-value = substitute( "&1", string(v-src-discnt) ).
      338     hdocument:create-node(hChild, "srcsum", "ELEMENT").
      339     hRoot:append-child(hChild).
      340     hdocument:create-node(hText, "", "TEXT").
      341     hChild:append-child(hText).
      342     hText:node-value = substitute( "&1", string(v-src-sum) ).
      343     hdocument:create-node(hChild, "srcsumnetto", "ELEMENT").
      344     hRoot:append-child(hChild).
      345     hdocument:create-node(hText, "", "TEXT").
      346     hChild:append-child(hText).
      347     hText:node-value = substitute( "&1", string(v-src-sum-netto) ).
      348     hdocument:create-node(hChild, "totdoc", "ELEMENT").
      349     hRoot:append-child(hChild).
      350     hdocument:create-node(hText, "", "TEXT").
      351     hChild:append-child(hText).
      352     hText:node-value = substitute( "&1", string(v-tot-doc) ).
      353     hdocument:create-node(hChild, "srcqnty", "ELEMENT").
      354     hRoot:append-child(hChild).
      355     hdocument:create-node(hText, "", "TEXT").
      356     hChild:append-child(hText).
      357     hText:node-value = substitute( "&1", string(v-src-qnty-out) ).
      358     hdocument:save("LONGCHAR", v-message).
      359     delete object hdocument .
      360     delete object hroot     .
      361     delete object hchild    .
      362     delete object htext     .
      363     assign
      364       hdocument      = ?
      365       hroot          = ?
      366       hchild         = ?
      367       htext          = ?
      368       p-send-message = v-message
      369     .
      370   end.
      371   procedure check-data :
      372     define output parameter p-data-valid    as logical   no-undo .
      373     define output parameter p-error-message as character no-undo .
      374     define output parameter p-setted        as logical   no-undo .
      375     define output parameter p-b-code        as integer   no-undo .
      376     define output parameter p-gds-code      as integer   no-undo .
      377     define output parameter p-chk-name      as character no-undo .
      378     define output parameter p-second-name   as character no-undo .
      379     define output parameter p-src-price     as decimal   no-undo .
      380     define output parameter p-src-discnt    as decimal   no-undo .
      381     define output parameter p-src-sum       as decimal   no-undo .
      382     define output parameter p-src-sum-netto as decimal   no-undo .
      383     define output parameter p-tot-doc       as decimal   no-undo .
      384     define output parameter p-src-qnty-out  as decimal   no-undo .
      385     define buffer buf_clients       for ub.clients .
      386     define buffer buf_sysconf       for ub.sysconf .
      387     define buffer buf_sys-ctrl      for ub.sys-ctrl .
      388     define buffer buf_user-login    for ub.user-login .
      389   do
      390   on error undo, return error return-value
      391   :
      392   end.
      393   end procedure.
