      362   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure is-tpsi-object :
      364   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      365   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      366   define output parameter p-is-tpsi-object as logical no-undo .
      367   define variable vss-description as character no-undo init "is-tpsi-object-01: получение признака объекта - участвует в TPSI".
      368   define variable conf-par as character no-undo .
      369   define variable par-type as character no-undo .
      370   define variable v-attr-value as character no-undo .
      371   define variable v-attr-type as character no-undo .
      372   define variable v-is-tpsi-object as logical no-undo .
      373   define buffer buf_clients for ub.clients.
      374     do
      375     on error undo, return error
      376     :
      377       find first buf_clients no-lock where
      378                 buf_clients.obj-type = p-obj-type
      379             AND buf_clients.obj-code = p-obj-code no-error .
      380       if not available buf_clients then do:
      381         return error substitute("&1 &2&3 не найден объект", vss-description, p-obj-type, p-obj-code).
      382       end.
      383       if not (buf_clients.db-num = g#db-num  or g#db-num = 0) then do:
      384         return error substitute("&1 &2&3 нельзя определить значение свойства УЧАСТВУЕТ В ТСПИ не в ГБД и не в свое УБД", vss-description, p-obj-type, p-obj-code).
      385       end.
      386       run clntattr-value  in this-procedure (
      387             input  'орг':U
      388           ,input   buf_clients.host-code
      389           ,input   'als-gds':U
      390           ,output v-attr-value
      391           ,output v-attr-type
      392                                               ) no-error .
      393       if not error-status:error
      394       and logical (v-attr-value) = yes then do:
      395         assign
      396         v-is-tpsi-object = yes
      397         .
      398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      399     (input  'tpsi'
      400     ,input  0
      401     ,input  ''
      402     ,input  0
      403     ,input  ''
      404     ,input  ''
      405     ,input  ''
      406     ,input  no
      407     ,output conf-par
      408     ,output par-type
      409     ) no-error .
      410         if not error-status:error
      411         and v-is-tpsi-object
      412         and (conf-par = "yes") then do:
      413           assign
      414           p-is-tpsi-object = yes
      415           .
      416         end.
      417       end.
      418     end.
      419   end procedure.
      420   do
      421   on error undo, return error
      422   :
      423      run is-tpsi-object in this-procedure (
      424                                              input p-obj-type
      425                                             ,input p-obj-code
      426                                             ,output p-is-tpsi-object
      427                                            )
      428                                            no-error.
      429      if error-status:error then return error return-value .
      430   end.
