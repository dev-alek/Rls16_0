        1   define input        parameter p-connect       as character no-undo .
        2   define input        parameter p-fltConnect    as character no-undo .
        3   define input        parameter p-user-login    as character no-undo .
        4   define input        parameter p-user-password as character no-undo .
        5   define input-output parameter p-connected     as logical   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: 1d8a718f013f, 3351, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: druban $":U .
        8   define variable vss-date        as character no-undo init "$Date: 2020/06/19 14:54:04 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: dbconnnodisc.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/dbconnnodisc.p $":U .
       11   define variable vss-description as character no-undo init "Процедура подключения к базе данных".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable v-connect-option    as character no-undo .
       71   define variable v-user-passwd       as character no-undo .
       72   define variable v-usr-flt-pswd      as character no-undo .
       73   do
       74   on error undo, return error return-value
       75   on stop undo, return error return-value
       76   on end-key undo, return error return-value
       77   :
       78     run adm/pswd-enc.p
       79       (input  encode(p-user-password)
       80       ,output p-user-password
       81       ).
       82     assign
       83       v-user-passwd = substitute("-U &1 -P &2":U
       84                                 ,p-user-login
       85                                 ,p-user-password
       86                                 )
       87       v-usr-flt-pswd = substitute("-ld ubflt -U usr-flt -P usr-flt":U)
       88     .
       89     connect value(substitute(p-connect, v-user-passwd, v-user-passwd)) no-error .
       90     if error-status :error
       91     then do:
       92        def var vtext as char no-undo.
       93        vtext =  substitute( "Не удалось подключиться к основной БД с параметрами: &2&1&2&3 Неизвестный пользователь или пароль"
       94                                ,substitute(p-connect)
       95                                ,chr(10)
       96                              ).
       97        connect value(substitute(p-connect)) no-error .
       98        IF error-status :error
       99        then
      100           vtext =  substitute( "Не удалось подключиться к основной БД с параметрами: &2&1&2&3 Не найдена база данных."
      101                                ,substitute(p-connect)
      102                                ,chr(10)
      103                              ).
      104       return error vtext.  end.
      105     if p-fltConnect <> ?
      106     then do:
      107       connect value(substitute(p-fltConnect, v-usr-flt-pswd, v-usr-flt-pswd)) no-error .
      108       if error-status :error
      109       then do:
      110         return error substitute( "Не удалось подключиться к БД настроек пользователя с параметрами: &2&1&2&3"
      111                                 ,p-fltConnect
      112                                 ,chr(10)
      113                                 ,error-status :get-message(1)
      114                               ).
      115       end.
      116       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ubflt':U) ) > 0
      117       then do:
      118         return error substitute( "Нет доступа на запись в БД настроек пользователя с параметрами: &2&1"
      119                                 ,p-fltConnect
      120                                 ,chr(10)
      121                               ).
      122       end.
      123     end.
      124     else do:
      125       create alias ubflt for database ub .
      126     end.
      127     assign
      128       p-connected = true
      129     .
      130   end.
