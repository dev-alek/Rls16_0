        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: update.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/update.p $":U .
        7   define variable vss-description as character no-undo init "Проверка соответствия r-cod- ов внутренним структурам данных и запуск выправляющих утилит".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   procedure get-ro_get-read-only :
       68     define output parameter p-ro-set as logical   no-undo .
       69     do
       70     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info0, return-value, error-status :get-message( 1 ) )
       71     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info0 )
       72     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info0 )
       73     :
       74       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
       75       then do:
       76         assign
       77           p-ro-set = true
       78         .
       79       end.
       80       else do:
       81         assign
       82           p-ro-set = false
       83         .
       84       end.
       85     end.
       86   end procedure.
       87   define buffer buf_sys-ctrl for ub.sys-ctrl.
       88   define variable v-proc-name        as character no-undo .
       89   define variable v-sys-key          as character no-undo .
       90   define variable v-get-ro_read-only as logical   no-undo .
       91   main-block:
       92   do
       93   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       94   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       95   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       96   :
       97     if transaction then do:
       98       message
       99         vss-workfile vss-revision vss-description skip
      100         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
      101         view-as alert-box error
      102       .
      103       return error .
      104     end.
      105     assign
      106       v-get-ro_read-only = false
      107     .
      108     run get-ro_get-read-only in this-procedure
      109       ( output v-get-ro_read-only
      110       ) .
      111     run trg/fixattrp.p ( input no
      112                         ,input v-get-ro_read-only
      113                          ) no-error .
      114     if error-status:error then do:
      115       message
      116         vss-workfile vss-revision vss-description skip
      117         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация атрибутов)" skip
      118         error-status :get-message(1) skip
      119         return-value skip
      120         view-as alert-box error .
      121       return error .
      122     end.
      123     run trg/fixdr.p ( input no
      124                      ,input v-get-ro_read-only
      125                     ) no-error .
      126     if error-status:error then do:
      127       message
      128         vss-workfile vss-revision vss-description skip
      129         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Правила скидок)" skip
      130         error-status :get-message(1) skip
      131         return-value skip
      132         view-as alert-box error .
      133       return error .
      134     end.
      135     run trg/fixhn.p ( input no
      136                      ,input v-get-ro_read-only
      137                      ) no-error .
      138     if error-status:error then do:
      139       message
      140         vss-workfile vss-revision vss-description skip
      141         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Настройка ист/маршр)" skip
      142         error-status :get-message(1) skip
      143         return-value skip
      144         view-as alert-box error .
      145       return error .
      146     end.
      147     run trg/fixcstml.p ( input no
      148                         ,input v-get-ro_read-only
      149                        ) no-error .
      150     if error-status:error then do:
      151       message
      152         vss-workfile vss-revision vss-description skip
      153         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация настраиваемых полей)" skip
      154         error-status :get-message(1) skip
      155         return-value skip
      156         view-as alert-box error .
      157       return error .
      158     end.
      159     run trg/fix-gate.p ( input no
      160                         ,input v-get-ro_read-only
      161                        ) no-error .
      162     if error-status:error then do:
      163       message
      164         vss-workfile vss-revision vss-description skip
      165         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация Gate)" skip
      166         error-status :get-message(1) skip
      167         return-value skip
      168         view-as alert-box error .
      169       return error .
      170     end.
      171     run trg/fixrum.p ( input no
      172                       ,input v-get-ro_read-only
      173                     ) no-error .
      174     if error-status:error then do:
      175       message
      176         vss-workfile vss-revision vss-description skip
      177         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация RUM)" skip
      178         error-status :get-message(1) skip
      179         return-value skip
      180         view-as alert-box error .
      181       return error .
      182     end.
      183     run trg/fix-lay.p ( input no
      184                         ,input v-get-ro_read-only) no-error .
      185     if error-status:error then do:
      186       message
      187         vss-workfile vss-revision vss-description skip
      188         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация раскладок)" skip
      189         error-status :get-message(1) skip
      190         return-value skip
      191         view-as alert-box error .
      192       return error .
      193     end.
      194     run trg/fixthbj.p ( input no
      195                         ,input v-get-ro_read-only) no-error .
      196     if error-status:error then do:
      197       message
      198         vss-workfile vss-revision vss-description skip
      199         "Ошибка при проверке соответствия r-cod-ов внутренним структурам данных (Конфигурация настроек по объектам TH)" skip
      200         error-status :get-message(1) skip
      201         return-value skip
      202         view-as alert-box error .
      203       return error .
      204     end.
      205     run adm/fix-par.p ( input no
      206                       , input v-get-ro_read-only
      207                       ) no-error .
      208     if error-status:error then do:
      209       message
      210         vss-workfile vss-revision vss-description skip
      211         "Ошибка при проверке/инициализации параметров при запуске ТН" skip
      212         error-status :get-message(1) skip
      213         return-value skip
      214         view-as alert-box error .
      215       return error .
      216     end.
      217     run adm/fix-atgo.p ( input no
      218                         , input v-get-ro_read-only
      219                         ) no-error .
      220     if error-status:error then do:
      221       message
      222         vss-workfile vss-revision vss-description skip
      223         "Ошибка при проверке/инициализации атрибутов при запуске ТН" skip
      224         error-status :get-message(1) skip
      225         return-value skip
      226         view-as alert-box error .
      227       return error .
      228     end.
      229     find first buf_sys-ctrl no-lock .
      230     assign
      231       v-sys-key   = buf_sys-ctrl.sys-key
      232       v-proc-name = search( substitute("utl/&1_on.r", v-sys-key))
      233     .
      234     if v-proc-name = ?
      235     or v-proc-name = '' then do:
      236       assign
      237         v-proc-name = search( substitute("utl/&1_on.p", v-sys-key))
      238       .
      239     end.
      240     if v-proc-name <> ?
      241     and v-proc-name <> '' then do:
      242       run value(v-proc-name) ( input ?
      243                              , input v-get-ro_read-only
      244                              ) no-error.
      245       if error-status:error then do:
      246         message
      247           vss-workfile vss-revision vss-description skip
      248           substitute("Ошибка при специфической проверке и обновлении корректности текущей конфигурации &1", v-sys-key) skip
      249           error-status :get-message(1) skip
      250           return-value skip
      251           view-as alert-box error .
      252         return error .
      253       end.
      254     end.
      255   end.
