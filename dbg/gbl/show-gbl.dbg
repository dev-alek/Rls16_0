      123   procedure check-ap-version :
      124   define output parameter p-check as logical no-undo .
      125   define variable v-dopi1 as integer no-undo .
      126   define variable v-dopi2 as integer no-undo .
      127   define variable v-dopi3 as integer no-undo .
      128   define variable v-dopi4 as integer no-undo .
      129   define buffer buf_attr-prop for ub.attr-prop .
      130     do
      131     on error undo, return error
      132     :
      133       find first buf_attr-prop no-lock where
      134                 buf_attr-prop.node-code = 0
      135             and buf_attr-prop.table-name = '':U
      136             and buf_attr-prop.templ-rl-root = 0   no-error.
      137       if (not available buf_attr-prop
      138       or buf_attr-prop.property-value <> "v15_1.3" )
      139       then do:
      140         assign
      141         v-dopi1 = integer(entry(2, buf_attr-prop.property-value, "."))
      142         v-dopi2 = integer(entry(2, "v15_1.3", "."))
      143         v-dopi3 = integer(entry(2, entry(1, buf_attr-prop.property-value, "."), "_"))
      144         v-dopi4 = integer(entry(2, entry(1, "v15_1.3", "."), "_"))
      145         no-error .
      146         if error-status:error
      147         or v-dopi2 > v-dopi1
      148         or v-dopi4 > v-dopi3
      149         or left-trim(entry(1, buf_attr-prop.property-value, "."), "v":U) < "15"
      150         then do:
      151           assign
      152           p-check = yes.
      153         end.
      154       end.
      155     end.
      156   end procedure.
      157   procedure get-ap-version :
      158   define output parameter p-ap-version as character no-undo init ?.
      159   define buffer buf_attr-prop for ub.attr-prop .
      160   find first buf_attr-prop no-lock where
      161             buf_attr-prop.node-code = 0
      162         and buf_attr-prop.table-name = '':U
      163         and buf_attr-prop.templ-rl-root = 0   no-error.
      164   if available buf_attr-prop then do:
      165     p-ap-version = buf_attr-prop.property-value.
      166   end.
      167   end procedure.
