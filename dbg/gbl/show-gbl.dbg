      478                 buf_thbj-attr.obj-type = '':U
      479             and buf_thbj-attr.obj-code = 0
      480             and buf_thbj-attr.prop-code = ''
      481             and buf_thbj-attr.upper-prop-code = '' no-error .
      482       if (not available buf_thbj-attr
      483       or buf_thbj-attr.property-value-character <> "v15_1.1" )
      484       then do:
      485         assign
      486         v-dopi1 = integer(entry(2, buf_thbj-attr.property-value-character, "."))
      487         v-dopi2 = integer(entry(2, "v15_1.1", "."))
      488         v-dopi3 = integer(entry(2, entry(1, buf_thbj-attr.property-value-character, "."), "_"))
      489         v-dopi4 = integer(entry(2, entry(1, "v15_1.1", "."), "_"))
      490         no-error .
      491         if error-status:error
      492         or v-dopi2 > v-dopi1
      493         or v-dopi4 > v-dopi3
      494         or left-trim(entry(1, buf_thbj-attr.property-value-character, "."), "v":U) < "15"
      495         then do:
      496           assign
      497           p-check = yes.
      498         end.
      499       end.
      500     end.
      501   end procedure.
      502   procedure get-thbj-version :
      503   define output parameter p-thbj-version as character no-undo init ?.
      504   define buffer buf_thbj-attr for ub.thbj-attr.
      505   do
      506   on error undo, return error
      507   :
      508     find first buf_thbj-attr no-lock where
      509               buf_thbj-attr.obj-type = '':U
      510           and buf_thbj-attr.obj-code = 0
      511           and buf_thbj-attr.prop-code = ''
      512           and buf_thbj-attr.upper-prop-code = '' no-error .
      513     if available buf_thbj-attr then do:
      514       p-thbj-version = buf_thbj-attr.property-value-character.
      515     end.
      516   end.
      517   end procedure.
