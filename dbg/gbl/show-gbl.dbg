      215   procedure disrules-fill-properties:
      216   define input  parameter p-templ-rl-root as integer   no-undo .
      217   define buffer buf_drt-prop for ub.drt-prop.
      218   define buffer buf_temp-drt-prop for temp-drt-prop.
