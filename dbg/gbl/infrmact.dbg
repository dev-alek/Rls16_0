        1   block-level on error undo, throw.
        2   define input parameter h_focus-widget      as handle    no-undo .
        3   define input parameter h_current-procedure as handle    no-undo .
        4   define input parameter p-action            as character no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: infrmact.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: gbl/infrmact.p $":U .
       10   def var vss-description as character no-undo init "Программа обработки событий в информационном диалоге".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable v-proc-name as character no-undo .
       66   do
       67   on error undo, return error return-value
       68   :
       69     case entry(1, p-action) :
       70       when "":u then do:
       71       end.
       72       when "run":U then do:
       73         if num-entries(p-action) = 2
       74         then do:
       75           assign
       76             v-proc-name = entry(2, p-action)
       77           .
       78           if lookup(h_current-procedure :file-name
       79                     ,'gbl/mainmenu.w'
       80                     ) > 0 then do:
       81             run value(v-proc-name) .
       82           end.
       83           else do:
       84             message
       85               "Программа может быть запущена только из главного окна модуля." skip
       86               "Вы пытаетесь запустить его из программы" h_current-procedure :file-name skip
       87               "Закройте все окна и поробуйте еще раз" skip
       88               view-as alert-box information .
       89           end.
       90         end.
       91         else do:
       92           message
       93             vss-workfile vss-revision vss-description skip
       94             "Неизвестное событие" skip
       95             "p-action" p-action skip
       96             view-as alert-box error .
       97         end.
       98       end.
       99       when "runpersistent":u then do:
      100         if num-entries(p-action) = 2
      101         then do:
      102           assign
      103             v-proc-name = entry(2, p-action)
      104           .
      105           if lookup(h_current-procedure :file-name
      106                     ,'gbl/mainmenu.w'
      107                     ) > 0 then do:
      108             run value(v-proc-name) persistent.
      109           end.
      110           else do:
      111             message
      112               "Программа может быть запущена только из главного окна модуля." skip
      113               "Вы пытаетесь запустить его из программы" h_current-procedure :file-name skip
      114               "Закройте все окна и поробуйте еще раз" skip
      115               view-as alert-box information .
      116           end.
      117         end.
      118         else do:
      119           message
      120             vss-workfile vss-revision vss-description skip
      121             "Неизвестное событие" skip
      122             "p-action" p-action skip
      123             view-as alert-box error .
      124         end.
      125       end.
      126       otherwise do:
      127         message
      128           vss-workfile vss-revision vss-description skip
      129           "Неизвестное событие" skip
      130           "p-action" p-action skip
      131           view-as alert-box error .
      132       end.
      133     end.
      134   end.
