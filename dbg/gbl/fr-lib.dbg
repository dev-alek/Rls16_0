     3162         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     3163      .
     3164   END.
     3165   END PROCEDURE.
     3166   PROCEDURE fr-FeedDocument :
     3167   define input  parameter p-count       as integer          no-undo.
     3168   define output parameter p-err-message as character        no-undo.
     3169   define output parameter p-ok          as logical          no-undo.
     3170   if v-fr-type = 200 then
     3171   do:
     3172     define variable v-i as integer   no-undo .
     3173     define variable v-inn  as character no-undo .
     3174     define variable v-regn as character no-undo .
     3175     define variable v-str-reg  as character no-undo .
     3176     define variable v-str-reg1 as character no-undo .
     3177     run fr-GetFiscalNums( output v-str-reg ,
     3178                           output v-str-reg1 ,
     3179                           output v-i) .
     3180     if v-i = 0 then
     3181     do:
     3182         run Fr-Answer(input 3,
     3183                          input 15,
     3184                          output v-inn )
     3185                          .
     3186         v-str-reg1 = "ИНН: " + v-inn .
     3187         run Fr-Answer(input 4,
     3188                          input 15,
     3189                          output v-regn )
     3190                          .
     3191         v-str-reg = "Рег. N:" + v-regn .
     3192         v-str-reg = v-str-reg + fill(" ",6) + v-str-reg1 .
     3193         run fr-print-str(input v-str-reg ,
     3194                        output p-err-message ,
     3195                        output p-ok )
     3196                        .
     3197         run Fr-GetDate( output v-i ,
     3198                         output v-regn,
     3199                         output v-inn ) .
     3200         v-regn = string(date(v-regn),"99-99-9999") .
     3201         v-str-reg = v-regn + fill(" ",40 - length(v-regn) - length(v-inn) - 1) + substr(v-inn,1,2) + ":" + substr(v-inn,3,2) .
     3202         run fr-print-str(input v-str-reg ,
     3203                        output p-err-message ,
     3204                        output p-ok )
     3205                        .
     3206     end.
     3207     do v-i = 3 to p-count :
     3208       run fr-print-str(input ' ' ,
     3209                        output p-err-message ,
     3210                        output p-ok )
     3211                        .
     3212     end .
     3213     p-ok = yes .
     3214     return .
     3215   end.
     3216   IF VALID-HANDLE(v-fr)
     3217   THEN DO
     3218   ON ERROR UNDO, RETURN ERROR
     3219   :
     3220      CASE v-fr-type :
     3221         WHEN 100 THEN DO:
     3222            ASSIGN
     3223               v-fr:Password        = 1
     3224               v-fr:StringQuantity  = p-count
     3225            .
     3226            v-fr:FeedDocument() NO-ERROR.
     3227            IF ERROR-STATUS:ERROR
     3228            OR v-fr:ResultCode <> 0
     3229            THEN DO:
     3230               ASSIGN
     3231                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     3232                                          , RETURN-VALUE
     3233                                          , ERROR-STATUS:GET-MESSAGE(1)
     3234                                          , v-fr:ResultCodeDescription
     3235                                          )
     3236                  p-ok = FALSE
     3237               .
     3238               RETURN.
     3239            END.
     3240            v-fr:GetECRStatus().
     3241            DO WHILE v-fr:ResultCode <> 0:
     3242               v-fr:GetECRStatus().
     3243            END.
     3244         END.
     3245         OTHERWISE DO:
     3246         END.
     3247      END CASE.
     3248      ASSIGN
     3249         p-ok = TRUE
     3250         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     3251      .
     3252   END.
     3253   END PROCEDURE.
     3254   procedure fr-open-chk :
     3255   define input  parameter p-chk-type as integer          no-undo.
     3256   define output parameter p-chk-num  as integer          no-undo.
     3257   define output parameter p-err-message as character        no-undo.
     3258   define output parameter p-ok          as logical          no-undo.
     3259   define variable v-return        as int no-undo .
     3260   define variable v-num-chek      as char no-undo .
     3261   def var         v-statusConst   as char no-undo .
     3262   def var         v-statusCurrent as char no-undo .
     3263   define variable v-chk-type as integer   no-undo .
     3264   define variable         v-datefirstdoc       as character no-undo .
     3265   define variable         v-timefirstdoc       as character no-undo .
     3266   do
     3267   on error undo, return error
     3268   :
     3269      CASE v-fr-type :
     3270         WHEN 100 THEN DO:
     3271            ASSIGN
     3272               v-fr:Password     = 1
     3273            .
     3274            v-fr:CheckType = p-chk-type.
     3275            v-fr:OpenCheck() NO-ERROR.
     3276            IF ERROR-STATUS:ERROR
     3277            OR v-fr:ResultCode <> 0
     3278            THEN DO:
     3279               ASSIGN
     3280                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     3281                                            , RETURN-VALUE
     3282                                            , ERROR-STATUS:GET-MESSAGE(1)
     3283                                            , v-fr:ResultCodeDescription
     3284                                            )
     3285               .
     3286               RETURN.
     3287            END.
     3288            p-chk-num = INT(v-fr:OpenDocumentNumber).
     3289            ASSIGN
     3290            p-ok = TRUE
     3291            p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     3292            .
     3293         END.
     3294         when 200 then
     3295         do :
     3296           do
     3297           on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3298           on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3299           on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3300           :
     3301            run Fr-GetStatusCurrent( output v-statusConst ,
     3302                                     output v-statusCurrent ,
     3303                                     output v-return
     3304                                    ).
     3305            if substr(v-statusCurrent,14,3) = "000" then
     3306            do:
     3307              if p-chk-type = 6 then
     3308              do:
     3309                v-chk-type = 2 .
     3310              end.
     3311              else
     3312              do:
     3313                v-chk-type = 0.
     3314              end.
     3315              run Fr-StartReceiptPlus(input  v-chk-type ,
     3316                                      input "" ,
     3317                                      output p-chk-num ,
     3318                                      output v-return
     3319                                      )
     3320                                      .
     3321            end .
     3322            if v-return = 0 then
     3323            do:
     3324              run Fr-FirstDoc.
     3325              assign
     3326                 p-ok = yes
     3327                 p-err-message = ''
     3328                        .
     3329            end.
     3330            else
     3331            do:
     3332              assign
     3333                  p-ok = no .
     3334              run Fr-ErrorMessage(output p-err-message) .
     3335            end.
     3336           end.
     3337         end .
     3338         OTHERWISE DO:
     3339         END.
     3340      END CASE.
     3341      .
     3342   end.
     3343   end procedure.
     3344   procedure fr-firstDoc:
     3345   define variable         v-datefirstdoc       as character no-undo .
     3346   define variable         v-timefirstdoc       as character no-undo .
     3347   define variable         v-return       as integer no-undo .
     3348              run Fr-ReadCMOS(input 7 ,
     3349                       input 6 ,
     3350                       output v-datefirstdoc ,
     3351                       output v-return) .
     3352             run Fr-ReadCMOS(input 13 ,
     3353                       input 4 ,
     3354                       output v-timefirstdoc ,
     3355                       output v-return) .
     3356             if v-timefirstdoc = "0000" then
     3357             do:
     3358               run Fr-GetDate(output v-return,
     3359                              output v-datefirstdoc ,
     3360                              output v-timefirstdoc )
     3361                              .
     3362               run Fr-WriteCMOS(input 7 ,
     3363                                input v-datefirstdoc ,
     3364                                output v-return).
     3365               run Fr-WriteCMOS(input 13 ,
     3366                                input v-timefirstdoc ,
     3367                                output v-return).
     3368             end.
     3369   end procedure .
     3370   procedure Fr-OpenDLL:
     3371   define input  parameter p-com-port as character no-undo .
     3372   define output parameter v-return as int no-undo .
     3373   define variable v-OpName as char no-undo .
     3374   define variable v-Psw    as char no-undo .
     3375   define variable v-DevName as char no-undo .
     3376   def    var      v-FlagOem as int  no-undo .
     3377    assign
     3378       v-OpName = "Иванов"
     3379       v-Psw    = "AERF"
     3380       v-DevName = p-com-port
     3381       v-FlagOem = 0
     3382       .
     3383   run OpenDLL
     3384         (input v-OpName ,
     3385          input v-Psw ,
     3386          input v-DevName ,
     3387          input v-FlagOem ,
     3388          output v-Return)
     3389          .
     3390    if v-return = 0 then
     3391    do:
     3392       RUN StartSeans(OUTPUT v-Return)
     3393          .
     3394    end.
     3395   end procedure.
     3396   procedure Fr-GetFiscalNums:
     3397    def output parameter p-Type-KKM     as char no-undo .
     3398    def output parameter p-SerialNumKKM as char no-undo .
     3399    def output parameter p-Return       as int  no-undo .
     3400    def var v-return     as int    no-undo .
     3401    def var v-Responce   as memptr no-undo .
     3402    def var v-c-Responce as char   no-undo .
     3403    def var v-err-msg    as char   no-undo .
     3404    def var v-creturn    as char   no-undo .
     3405    def var v-count      as int    no-undo .
     3406    run GetFiscalNums(output p-return) .
     3407    if p-return = 0 then
     3408    do:
     3409       set-size(v-responce) = 20 .
     3410       run GetFldStr(7,output v-Responce,output v-creturn ) .
     3411       p-serialNumKKM = get-string(v-Responce,1) .
     3412       set-size(v-responce) = 0 .
     3413       set-size(v-responce) = 60 .
     3414       run GetFldStr(5,output v-Responce,output v-creturn ) .
     3415       p-type-KKM = get-string(v-Responce,1) .
     3416       set-size(v-responce) = 0 .
     3417    end.
     3418   end procedure.
     3419   Procedure Fr-ChangeOpName :
     3420   def input  parameter p-opName as char no-undo .
     3421   def output parameter p-return as int  no-undo .
     3422   run ChangeOpName( input p-OpName,
     3423                   output p-return) .
     3424   end procedure .
     3425   procedure Fr-GetResource:
     3426   def output parameter p-return    as int no-undo .
     3427   def output parameter p-LastShift as int no-undo .
     3428   def output parameter p-DateFirstDoc as char no-undo .
     3429   def output parameter p-TimeFirstDoc as char no-undo .
     3430   run GetResource(output p-return) .
     3431   if p-return = 0 then
     3432   do:
     3433     run Fr-Answer-i(3, output p-LastShift) .
     3434     run Fr-Answer(2,16,output p-DateFirstDoc) .
     3435     run Fr-Answer(1,16,output p-TimeFirstDoc) .
     3436   end.
     3437   end procedure .
     3438   procedure Fr-GetDate:
     3439   def output parameter v-return    as int  no-undo .
     3440   def output parameter v-dateKKM   as char no-undo .
     3441   def output parameter v-timeKKM   as char no-undo .
     3442   def var v-flds-Count as int no-undo .
     3443   def var v-Responce   as memptr no-undo.
     3444   def var v-length     as int no-undo .
     3445   v-length = 16 .
     3446   run GetDate(output v-return) .
     3447   if v-return = 0 then
     3448   do:
     3449       run Fr-Answer(input 1,
     3450                     input v-length ,
     3451                     output v-timeKKM ) .
     3452       run Fr-Answer(input 2,
     3453                     input v-length ,
     3454                     output v-dateKKM ) .
     3455   end.
     3456   end procedure .
     3457   procedure Fr-GetSerialNum:
     3458   define output parameter v-return    as int no-undo .
     3459   define output parameter v-SerialNum as char no-undo.
     3460   run GetSerialNum(output v-return) .
     3461   if v-return = 0 then
     3462   do:
     3463     run Fr-Answer(1,
     3464                  16,
     3465                  output v-SerialNum) .
     3466   end.
     3467   end procedure .
     3468   procedure Fr-StartReceiptPlus:
     3469   def input parameter v-pay      as int no-undo .
     3470   define input  parameter v-FreeField as character no-undo .
     3471   def output parameter v-ChekNum as int no-undo .
     3472   def output parameter v-return  as int no-undo .
     3473   def var v-copy    as int no-undo .
     3474   def var v-tableNo as char no-undo .
     3475   def var v-PlaceNo as char no-undo .
     3476   def var v-AccountNo as char no-undo .
     3477   assign
     3478          v-copy = 1
     3479          v-tableNo = ''
     3480          v-placeNo = ''
     3481          v-AccountNo = ''
     3482          .
     3483   run StartReceiptPlus( input v-pay ,
     3484                     input v-copy ,
     3485                     input v-tableNO ,
     3486                     input v-placeNo ,
     3487                     input v-AccountNo ,
     3488                     input v-FreeField ,
     3489                     output v-return ) .
     3490   if v-return = 0 then
     3491   do:
     3492     run Fr-answer-i(1 , output v-ChekNum) .
     3493   end.
     3494   end procedure .
     3495   procedure Fr-ItemReceiptPlus:
     3496   def input parameter v-WareName   as char format 'x(40)' label " Наименование товара,услуги"
     3497                 no-undo.
     3498   def input parameter v-WareCode   as char format 'x(20)' label " Баркод " no-undo .
     3499   def input parameter v-Measure    as char format 'x(3)' label "Единица измерения" no-undo .
     3500   def input parameter v-SecId      as char format 'x(20)' label "Секция" no-undo .
     3501   def input parameter v-FreeField  as char format 'x(255)' no-undo .
     3502   def input parameter v-price      as int  format '>>>>>>>>>>>>>9' label "Цена в копейках" no-undo .
     3503   def input parameter v-Count      as int  format '->>>>>>>>>>>>9' label "кол-во" no-undo .
     3504   def input parameter v-WareType   as int  format '>9' label 'Тип товара' initial 1 no-undo .
     3505   def input parameter v-discount   as int  format '->>>>>>>>>>>>9' label " скидка " no-undo .
     3506   def output parameter v-return    as int no-undo .
     3507   def output parameter v-itogo     as char no-undo .
     3508   def output parameter v-Itogo-Str as char no-undo .
     3509   def output parameter v-Disc-Str  as char no-undo .
     3510   def var v-TaxType  as int format '9' label "НДС(0-18.00,1-10.00)"
     3511      initial 9 no-undo .
     3512   define variable v-Free-disc as character no-undo .
     3513   if v-Price * v-Count / 1000 + v-discount < 0 then
     3514   do:
     3515     message "Скидка по строке " v-discount skip
     3516             "больше суммы товара " v-Price * v-Count / 1000 " все в копейках"
     3517             view-as alert-box title "ошибка" .
     3518     return .
     3519   end.
     3520   if v-discount <> 0  then
     3521   do:
     3522     assign
     3523     v-Free-disc = v-FreeField
     3524     v-FreeField = ""
     3525     .
     3526   end.
     3527   if v-Count < 0 then
     3528       v-FreeField = " АННУЛЯЦИЯ ТОВАРА "  .
     3529   run ItemReceiptPlus(
     3530                   input v-WareName ,
     3531                   input v-WareCode ,
     3532                   input v-Measure  ,
     3533                   input v-SecId    ,
     3534                   input v-FreeField,
     3535                   input v-Price ,
     3536                   input v-Count ,
     3537                   input v-WareType ,
     3538                   output v-return )
     3539                   .
     3540   if v-return = 0 then
     3541   do:
     3542       run Fr-answer( input 1,
     3543                      input 19,
     3544                      output v-Itogo)
     3545                      .
     3546       run Fr-answer( input 2,
     3547                      input 19,
     3548                      output v-Itogo-Str)
     3549                      .
     3550   end.
     3551   if v-discount <> 0 and v-return = 0 then
     3552   do:
     3553     run Fr-StrComissionReceiptPlus( input v-discount ,
     3554                                     input v-Free-Disc ,
     3555                                     output v-Itogo ,
     3556                                     output v-Disc-Str,
     3557                                     output v-return)
     3558                                     .
     3559   end .
     3560   end procedure .
     3561   procedure Fr-ComissionReceiptPlus:
     3562   def input parameter   v-OType      as int format '9' label "1-скидка(0-наценка)" no-undo .
     3563   def input parameter   v-Sum        as int format '>>>>>>>>>>>>>9' label "сумма скидки" no-undo .
     3564   def input parameter   v-FreeField  as char format 'x(255)' no-undo .
     3565   def output parameter  v-itogo      as char no-undo .
     3566   def output parameter  v-itogo-disc as char no-undo .
     3567   def output parameter  v-return     as int no-undo .
     3568   def var v-Percent  as int format '>>>>>>>>>>>>>9' label "Процент скидки" no-undo .
     3569   def var v-creturn as char no-undo .
     3570   assign v-Percent = 0 .
     3571     run ComissionReceiptPlus(
     3572                        input v-OType ,
     3573                        input v-Percent ,
     3574                        input v-Sum ,
     3575                        input v-FreeField ,
     3576                        output v-Return
     3577                        ) .
     3578   if v-return = 0 then
     3579   do:
     3580       run Fr-answer( 1 , 19 ,output v-itogo) .
     3581       run Fr-answer( 2 , 19 ,output v-itogo-disc) .
     3582   end.
     3583   end procedure .
     3584   procedure Fr-StrComissionReceiptPlus :
     3585   def input parameter  v-Discount as int no-undo.
     3586   def input parameter  v-Message  as char no-undo .
     3587   def output parameter v-Itogo    as char no-undo .
     3588   def output parameter v-str-disc as char no-undo .
     3589   def output parameter v-Return   as int no-undo .
     3590   def var v-OType    as int no-undo .
     3591   def var v-Percent  as int no-undo .
     3592   def var v-Sum      as int no-undo .
     3593   def var v-FreeField as char format 'x(255)' no-undo .
     3594     assign
     3595     v-OType = 0
     3596     v-FreeField = v-Message
     3597     v-Sum = abs(v-discount)
     3598     .
     3599     if v-discount < 0 then v-OType = 1 .
     3600     run ComissionReceiptPlus(
     3601                        input v-OType ,
     3602                        input v-Percent ,
     3603                        input v-Sum ,
     3604                        input v-FreeField ,
     3605                        output v-Return
     3606                        ) .
     3607    if v-return = 0 then
     3608    do:
     3609       run Fr-answer(1,19,output v-Itogo) .
     3610       run Fr-answer(2,19,output v-Str-Disc) .
     3611    end .
     3612   end procedure .
     3613   procedure Fr-WriteCMOS:
     3614   def input parameter  p-offs     as int no-undo .
     3615   def input parameter  p-operator as char no-undo .
     3616   def output parameter p-return   as int no-undo.
     3617   run WriteCMOS( input p-offs ,
     3618                  input p-operator ,
     3619                  output p-return ) .
     3620   end procedure .
     3621   procedure Fr-TotalReceiptPlus:
     3622   define input  parameter v-FreeField as char no-undo .
     3623   define output parameter v-ItogoSum  as char no-undo .
     3624   define output parameter v-return    as int  no-undo .
     3625   run TotalReceiptPlus(input v-FreeField ,
     3626                        output v-return) .
     3627   if v-return = 0 then
     3628   do :
     3629      run Fr-Answer(input 1, input 19 ,output v-ItogoSum) .
     3630   end .
     3631   end procedure .
     3632   procedure Fr-SubTotalReceiptPlus:
     3633   define input  parameter v-FreeField as char no-undo .
     3634   define output parameter v-ItogoSum  as char no-undo .
     3635   define output parameter v-return    as int  no-undo .
     3636   run SubTotalReceiptPlus(input v-FreeField ,
     3637                        output v-return) .
     3638   if v-return = 0 then
