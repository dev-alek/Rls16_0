     2554   :
     2555      CASE v-fr-type :
     2556         WHEN 100 THEN DO:
     2557            v-fr:GetECRStatus().
     2558            DO WHILE v-fr:ResultCode <> 0:
     2559               v-fr:GetECRStatus().
     2560            END.
     2561            v-fr:Password = 1.
     2562            v-fr:StringForPrinting = p-string.
     2563            v-fr:PrintWideString() NO-ERROR.
     2564            IF ERROR-STATUS:ERROR
     2565            OR v-fr:ResultCode <> 0
     2566            THEN DO:
     2567               ASSIGN
     2568                  p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     2569                                          , RETURN-VALUE
     2570                                          , ERROR-STATUS:GET-MESSAGE(1)
     2571                                          , v-fr:ResultCodeDescription
     2572                                          , v-fr:ResultCode
     2573                                          )
     2574               .
     2575               RETURN.
     2576            END.
     2577         END.
     2578         OTHERWISE DO:
     2579         END.
     2580      END CASE.
     2581      ASSIGN
     2582         p-ok = TRUE
     2583         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2584      .
     2585   END.
     2586   END PROCEDURE.
     2587   PROCEDURE fr-get-reg :
     2588   define input  parameter p-reg-type     as character        no-undo.
     2589   define input  parameter p-reg-num      as integer          no-undo.
     2590   define output parameter p-reg-value    as character        no-undo.
     2591   define output parameter p-reg-name     as character        no-undo.
     2592   define output parameter p-err-message  as character        no-undo.
     2593   define output parameter p-ok           as logical          no-undo.
     2594   if v-fr-type = 200 then
     2595   do:
     2596     define variable v-CashMony as character no-undo .
     2597     define variable v-return   as integer   no-undo .
     2598     do
     2599     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2600     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2601     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2602     :
     2603       if p-reg-type = 'cash' then
     2604       do:
     2605        case p-reg-num:
     2606         when 241 then
     2607         do:
     2608           run Fr-GetMony(1,14,
     2609                         output v-CashMony) .
     2610            assign
     2611              p-ok = yes
     2612              p-reg-value = v-CashMony
     2613              p-reg-name  = "Наличность в кассе"
     2614              .
     2615         end .
     2616         when 0 then
     2617         do:
     2618           run Fr-ReadCMOS(input 31 ,
     2619                       input 14 ,
     2620                       output v-CashMony ,
     2621                       output v-return).
     2622           if v-return = 0 then
     2623           do:
     2624            assign
     2625              p-ok = yes
     2626              p-reg-value = v-CashMony
     2627              p-reg-name  = "Итого продаж"
     2628              .
     2629           end.
     2630         end.
     2631        when 80 then
     2632         do:
     2633           run Fr-ReadCMOS(input 45 ,
     2634                       input 14 ,
     2635                       output v-CashMony ,
     2636                       output v-return)
     2637                       .
     2638           if v-return = 0 then
     2639           do:
     2640            assign
     2641              p-ok = yes
     2642              p-reg-value = v-CashMony
     2643              p-reg-name  = "Итого пласт.карт"
     2644              .
     2645           end.
     2646         end.
     2647        when 76 then
     2648         do:
     2649           run Fr-ReadCMOS(input 59 ,
     2650                       input 14 ,
     2651                       output v-CashMony ,
     2652                       output v-return).
     2653           if v-return = 0 then
     2654           do:
     2655            assign
     2656              p-ok = yes
     2657              p-reg-value = v-CashMony
     2658              p-reg-name  = "Итого "
     2659              .
     2660           end.
     2661         end.
     2662        when 2 then
     2663         do:
     2664           run Fr-ReadCMOS(input 73 ,
     2665                       input 12 ,
     2666                       output v-CashMony ,
     2667                       output v-return).
     2668           if v-return = 0 then
     2669           do:
     2670            assign
     2671              p-ok = yes
     2672              p-reg-value = v-CashMony
     2673              p-reg-name  = "Итого возврат"
     2674              .
     2675           end.
     2676         end.
     2677        when 72 then
     2678         do:
     2679           run Fr-ReadCMOS(input 85 ,
     2680                       input 14 ,
     2681                       output v-CashMony ,
     2682                       output v-return).
     2683           if v-return = 0 then
     2684           do:
     2685            assign
     2686              p-ok = yes
     2687              p-reg-value = v-CashMony
     2688              p-reg-name  = "Итого наличных"
     2689              .
     2690           end.
     2691         end.
     2692        OTHERWISE
     2693         DO:
     2694          assign
     2695            p-ok = yes
     2696            p-reg-value = '0'
     2697            p-reg-name  = "прим08тк"
     2698            .
     2699         END.
     2700        end case .
     2701       end.
     2702       else
     2703       do :
     2704          assign
     2705            p-ok = yes
     2706            p-reg-value = '0'
     2707            p-reg-name  = "прим08тк"
     2708            .
     2709       end.
     2710     end.
     2711     return .
     2712   end.
     2713   IF VALID-HANDLE(v-fr)
     2714   THEN DO
     2715   ON ERROR UNDO, RETURN ERROR
     2716   :
     2717      CASE v-fr-type :
     2718         WHEN 100 THEN DO:
     2719            ASSIGN
     2720               v-fr:Password = 1
     2721               v-fr:RegisterNumber = p-reg-num
     2722            .
     2723            case p-reg-type:
     2724               when "cash" THEN DO:
     2725                  v-fr:GetCashReg() NO-ERROR.
     2726                  IF ERROR-STATUS:ERROR
     2727                  OR v-fr:ResultCode <> 0
     2728                  THEN DO:
     2729                     ASSIGN
     2730                        p-err-message = SUBSTITUTE( "&1 &2 &3"
     2731                                                , RETURN-VALUE
     2732                                                , ERROR-STATUS:GET-MESSAGE(1)
     2733                                                , v-fr:ResultCodeDescription
     2734                                                )
     2735                     .
     2736                     RETURN.
     2737                  END.
     2738                  ASSIGN
     2739                     p-reg-value = v-fr:ContentsOfCashRegister
     2740                     p-reg-name  = v-fr:NameCashReg
     2741                  .
     2742               END.
     2743               WHEN "oper" THEN DO:
     2744                  v-fr:GetOperationReg() NO-ERROR.
     2745                  IF ERROR-STATUS:ERROR
     2746                  OR v-fr:ResultCode <> 0
     2747                  THEN DO:
     2748                     ASSIGN
     2749                        p-err-message = SUBSTITUTE( "&1 &2 &3"
     2750                                                , RETURN-VALUE
     2751                                                , ERROR-STATUS:GET-MESSAGE(1)
     2752                                                , v-fr:ResultCodeDescription
     2753                                                )
     2754                     .
     2755                     RETURN.
     2756                  END.
     2757                  ASSIGN
     2758                     p-reg-value = v-fr:ContentsOfOperationRegister
     2759                     p-reg-name  = v-fr:NameOperationReg
     2760                  .
     2761               END.
     2762               OTHERWISE DO:
     2763               END.
     2764            END CASE.
     2765         END.
     2766         OTHERWISE DO:
     2767         END.
     2768      END CASE.
     2769      ASSIGN
     2770         p-ok = TRUE
     2771         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2772      .
     2773   END.
     2774   END PROCEDURE.
     2775   PROCEDURE fr-x-rep :
     2776   define output parameter p-err-message as character        no-undo.
     2777   define output parameter p-ok          as logical          no-undo.
     2778   if v-fr-type = 200 then
     2779   do:
     2780     def var v-return as int no-undo .
     2781     do
     2782     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2783     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2784     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2785     :
     2786       run Xreport(output v-return).
     2787       if v-return = 0 then
     2788       do:
     2789          assign
     2790            p-ok = yes
     2791            p-err-message = ""
     2792            .
     2793       end.
     2794       else
     2795       do:
     2796          assign
     2797            p-ok = no
     2798            .
     2799          run Fr-errorMessage(output p-err-message) .
     2800       end .
     2801     end.
     2802     return .
     2803   end.
     2804   IF VALID-HANDLE(v-fr)
     2805   THEN DO
     2806   ON ERROR UNDO, RETURN ERROR
     2807   :
     2808      CASE v-fr-type :
     2809         WHEN 100 THEN DO:
     2810            v-fr:GetECRStatus() NO-ERROR.
     2811            IF ERROR-STATUS:ERROR
     2812            OR v-fr:ResultCode <> 0
     2813            THEN DO:
     2814               ASSIGN
     2815                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2816                                            , RETURN-VALUE
     2817                                            , ERROR-STATUS:GET-MESSAGE(1)
     2818                                            , v-fr:ResultCodeDescription
     2819                                            )
     2820                  p-ok = FALSE
     2821               .
     2822               RETURN.
     2823            END.
     2824            IF v-fr:ECRMode = 2
     2825            OR v-fr:ECRMode = 3
     2826            OR v-fr:ECRMode = 4
     2827            THEN DO:
     2828               v-fr:Password = 30.
     2829               v-fr:PrintReportWithoutCleaning() NO-ERROR.
     2830               IF ERROR-STATUS:ERROR
     2831               OR v-fr:ResultCode <> 0
     2832               THEN DO:
     2833                  ASSIGN
     2834                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     2835                                             , RETURN-VALUE
     2836                                             , ERROR-STATUS:GET-MESSAGE(1)
     2837                                             , v-fr:ResultCodeDescription
     2838                                             )
     2839                     p-ok = FALSE
     2840                  .
     2841                  RETURN.
     2842               END.
     2843            END.
     2844         END.
     2845         OTHERWISE DO:
     2846         END.
     2847      END CASE.
     2848      ASSIGN
     2849         p-ok = TRUE
     2850         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2851      .
     2852   END.
     2853   END PROCEDURE.
     2854   PROCEDURE fr-CashIncome :
     2855   define input parameter p-summ as decimal          no-undo.
     2856   define output parameter p-err-message as character        no-undo.
     2857   define output parameter p-ok          as logical          no-undo.
     2858   define variable v-SumTo  as integer   no-undo .
     2859   define variable v-return as integer   no-undo .
     2860   if v-fr-type = 200 then
     2861   do:
     2862     do
     2863     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2864     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2865     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2866     :
     2867        v-sumTo = abs(p-summ) * 100 .
     2868        run ToCash(input v-SumTo , output v-return ) .
     2869        if v-return = 0 then
     2870        do:
     2871          assign
     2872           p-ok = yes
     2873           p-err-message = ""
     2874           .
     2875        end.
     2876        else
     2877        do:
     2878          assign
     2879            p-ok = no .
     2880          run Fr-errorMessage(output p-err-message) .
     2881        end.
     2882     end.
     2883     return .
     2884   end.
     2885   IF VALID-HANDLE(v-fr)
     2886   THEN DO
     2887   ON ERROR UNDO, RETURN ERROR
     2888   :
     2889      CASE v-fr-type :
     2890         WHEN 100 THEN DO:
     2891            v-fr:Password = 1.
     2892            v-fr:Summ1 = ABSOLUTE(p-summ).
     2893            v-fr:CashIncome() NO-ERROR.
     2894            IF ERROR-STATUS:ERROR
     2895            OR v-fr:ResultCode <> 0
     2896            THEN DO:
     2897               ASSIGN
     2898                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2899                                          , RETURN-VALUE
     2900                                          , ERROR-STATUS:GET-MESSAGE(1)
     2901                                          , v-fr:ResultCodeDescription
     2902                                          )
     2903                  p-ok = FALSE
     2904               .
     2905               RETURN.
     2906            END.
     2907         END.
     2908         OTHERWISE DO:
     2909         END.
     2910      END CASE.
     2911      ASSIGN
     2912         p-ok = TRUE
     2913         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2914      .
     2915   END.
     2916   END PROCEDURE.
     2917   PROCEDURE fr-CashOutcome :
     2918   define input parameter p-summ as decimal          no-undo.
     2919   define output parameter p-err-message as character        no-undo.
     2920   define output parameter p-ok          as logical          no-undo.
     2921   define variable v-SumNal  as decimal   no-undo .
     2922   define variable v-SumFrom as integer   no-undo .
     2923   define variable v-return  as integer   no-undo .
     2924   define variable v-SumTo  as decimal   no-undo .
     2925   if v-fr-type = 200 then
     2926   do:
     2927     do
     2928     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2929     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2930     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2931     :
     2932        run Fr-GetMony(input 1,input 14, output v-SumNal) .
     2933        if p-summ > v-sumNal  then
     2934        do:
     2935          p-err-message = substitute("Вы хотите изъять денег &1 больше чем в кассе &2",p-summ,v-SumNal) .
     2936          message p-err-message
     2937          view-as alert-box title "Ошибка" .
     2938          assign
     2939          p-ok = no
     2940          .
     2941          return .
     2942        end.
     2943        v-sumfrom = abs(p-summ) * 100 .
     2944        run FromCash(input v-Sumfrom , output v-return ) .
     2945        if v-return = 0 then
     2946        do:
     2947          assign
     2948           p-ok = yes
     2949           p-err-message = ""
     2950           .
     2951        end.
     2952        else
     2953        do:
     2954          assign
     2955            p-ok = no .
     2956          run Fr-errorMessage(output p-err-message) .
     2957        end.
     2958     end.
     2959     return .
     2960   end.
     2961   IF VALID-HANDLE(v-fr)
     2962   THEN DO
     2963   ON ERROR UNDO, RETURN ERROR
     2964   :
     2965     CASE v-fr-type :
     2966       WHEN 100 THEN DO:
     2967         v-fr:Password = 1.
     2968         v-fr:Summ1 = ABSOLUTE(p-summ).
     2969         v-fr:CashOutcome() NO-ERROR.
     2970         IF ERROR-STATUS:ERROR
     2971         or v-fr:ResultCode = 70
     2972         THEN DO:
     2973           ASSIGN
     2974           p-err-message = SUBSTITUTE( "&1 &2 &3"
     2975                                   , RETURN-VALUE
     2976                                   , ERROR-STATUS:GET-MESSAGE(1)
     2977                                   , v-fr:ResultCodeDescription
     2978                                   )
     2979           p-ok = FALSE
     2980           .
     2981           RETURN.
     2982         END.
     2983         IF v-fr:ResultCode <> 0
     2984         THEN DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     2985           v-fr:GetECRStatus().
     2986         END.
     2987       END.
     2988       OTHERWISE DO:
     2989       END.
     2990     END CASE.
     2991     ASSIGN
     2992     p-ok = TRUE
     2993     p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2994     .
     2995   END.
     2996   END PROCEDURE.
     2997   PROCEDURE fr-cut :
     2998   define input  parameter p-not-full    as logical          no-undo.
     2999   define output parameter p-err-message as character        no-undo.
     3000   define output parameter p-ok          as logical          no-undo.
     3001   if v-fr-type = 200 then
     3002   do:
     3003     define variable v-return as integer   no-undo .
     3004     run FreeDocCutPlus(input 1,output v-return) .
     3005     p-ok = yes .
     3006     return .
     3007   end.
     3008   IF VALID-HANDLE(v-fr)
     3009   THEN DO
     3010   ON ERROR UNDO, RETURN ERROR
     3011   :
     3012      CASE v-fr-type :
     3013         WHEN 100 THEN DO:
     3014            ASSIGN
     3015               v-fr:Password = 1
     3016            .
     3017            v-fr:CutCheck() NO-ERROR.
     3018            IF ERROR-STATUS:ERROR
     3019            OR v-fr:ResultCode <> 0
     3020            THEN DO:
     3021               ASSIGN
     3022                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     3023                                          , RETURN-VALUE
     3024                                          , ERROR-STATUS:GET-MESSAGE(1)
     3025                                          , v-fr:ResultCodeDescription
     3026                                          )
     3027                  p-ok = FALSE
     3028               .
     3029               RETURN.
     3030            END.
     3031         END.
     3032         OTHERWISE DO:
     3033         END.
     3034      END CASE.
     3035      ASSIGN
     3036         p-ok = TRUE
     3037         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     3038      .
     3039   END.
     3040   END PROCEDURE.
     3041   PROCEDURE fr-DocTitle :
     3042   define input  parameter p-doc-number  as character          no-undo.
     3043   define input  parameter p-doc-name    as character          no-undo.
     3044   define output parameter p-err-message as character        no-undo.
     3045   define output parameter p-ok          as logical          no-undo.
     3046   if v-fr-type = 200 then
     3047   do:
     3048     do
     3049     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3050     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3051     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3052     :
     3053       define variable v-return as integer   no-undo .
     3054       define variable v-SerNum as character no-undo .
     3055       run GetSerialNum(output v-return) .
     3056       if v-return <> 0  then
     3057       do:
     3058         assign p-ok = no .
     3059         run fr-Error-message(output p-err-message) .
     3060         return .
     3061       end.
     3062       else
     3063       do:
     3064         run Fr-Answer(input 1,
     3065                          input 11,
     3066                          output v-serNum )
     3067                          .
     3068         run fr-print-str("Серийный N: " + v-SerNum,
     3069                 output p-err-message ,
     3070                 output p-ok )
     3071                 .
     3072       end.
     3073       run fr-print-str(p-doc-name ,
     3074                 output p-err-message ,
     3075                 output p-ok )
     3076                 .
     3077     end.
     3078         .
     3079     p-ok = yes .
     3080     return .
     3081   end.
     3082   IF VALID-HANDLE(v-fr)
     3083   THEN DO
     3084   ON ERROR UNDO, RETURN ERROR
     3085   :
     3086     CASE v-fr-type :
     3087       WHEN 100 THEN DO:
     3088         ASSIGN
     3089         v-fr:Password        = 1
     3090         v-fr:DocumentNumber  = p-doc-number
     3091         v-fr:DocumentName    = string(p-doc-name, "X(29)")
     3092         .
     3093         v-fr:GetECRStatus().
     3094         DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     3095           v-fr:GetECRStatus().
     3096         END.
     3097         v-fr:PrintDocumentTitle() NO-ERROR.
     3098         IF ERROR-STATUS:ERROR
     3099         OR v-fr:ResultCode <> 0
     3100         THEN DO:
     3101           ASSIGN
     3102           p-err-message = SUBSTITUTE( "&1 &2 &3"
     3103                                   , RETURN-VALUE
     3104                                   , ERROR-STATUS:GET-MESSAGE(1)
     3105                                   , v-fr:ResultCodeDescription
     3106                                   )
     3107           p-ok = FALSE
     3108           .
     3109           RETURN.
     3110         END.
     3111         v-fr:GetECRStatus().
     3112         DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     3113           v-fr:GetECRStatus().
     3114         END.
     3115       END.
     3116       OTHERWISE DO:
     3117       END.
     3118     END CASE.
     3119     ASSIGN
     3120     p-ok = TRUE
     3121     p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     3122     .
     3123   END.
     3124   END PROCEDURE.
     3125   PROCEDURE fr-OutputReceipt :
     3126   define output parameter p-err-message as character        no-undo.
     3127   define output parameter p-ok          as logical          no-undo.
     3128   if v-fr-type = 200 then
     3129   do:
     3130     p-ok = yes .
     3131     return .
     3132   end.
     3133   IF VALID-HANDLE(v-fr)
     3134   THEN DO
     3135   ON ERROR UNDO, RETURN ERROR
     3136   :
     3137      CASE v-fr-type :
     3138         WHEN 100 THEN DO:
