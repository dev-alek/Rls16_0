        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 8daa160be6fd, 983, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: PGridchina $":U .
        4   define variable vss-date        as character no-undo init "$Date: Fri Jun 23 11:47:54 2017 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: fr-lib.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/fr-lib.p $":U .
        7   define variable vss-description as character no-undo init "Библиотека для работы с фискальным регистратором".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define new global shared variable g#fr-lib as handle no-undo.
      116   if valid-handle (g#fr-lib)
      117   and g#fr-lib <> this-procedure :handle
      118   and g#fr-lib :get-signature('library_testproc':u) <> ""
      119   then do:
      120     message
      121       vss-workfile vss-revision vss-description skip
      122       "Попытка повторной загрузки библиотеки" skip
      123       g#fr-lib skip
      124       g#fr-lib :type skip
      125       g#fr-lib :file-name skip
      126       valid-handle(g#fr-lib) skip
      127       this-procedure :handle skip
      128       this-procedure :type skip
      129       this-procedure :file-name skip
      130       valid-handle(this-procedure) skip
      131       view-as alert-box error .
      132     undo, return error return-value .
      133   end.
      134   else do:
      135     assign
      136       g#fr-lib = this-procedure :handle
      137     .
      138   end.
      139   if this-procedure :persistent <> true
      140   then do:
      141     message
      142       vss-workfile vss-revision vss-description skip
      143       "Ошибка запуска библиотеки" program-name(1) skip
      144       "Попытка запустить ее как обычную процедуру" skip
      145       view-as alert-box error .
      146   end.
      147   on delete of this-procedure do:
      148     assign
      149       g#fr-lib = ?
      150     .
      151   end.
      152   DEFINE VARIABLE v-fr          AS COM-HANDLE     NO-UNDO .
      153   DEFINE VARIABLE v-fr-type     AS INTEGER INIT ? NO-UNDO .
      154   DEFINE VARIABLE v-fr-FiskSts  AS INTEGER INIT -1 NO-UNDO.
      155   DEFINE VARIABLE v-fr-ShiftNum AS INTEGER INIT -1 NO-UNDO.
      156   DEFINE VARIABLE v-fr-KKMNum   AS character INIT "":U NO-UNDO.
      157   DEFINE VARIABLE v-fr-TimOut     AS INTEGER     INIT 5000 NO-UNDO.
      158   DEFINE VARIABLE v-fr-LastDoc    AS INTEGER     INIT -1 NO-UNDO.
      159   DEFINE VARIABLE v-fr-LastDate   AS DATE        NO-UNDO.
      160   DEFINE VARIABLE v-fr-LastTime   AS INTEGER     INIT -1 NO-UNDO.
      161   DEFINE VARIABLE v-fr-ch-beg     AS character   NO-UNDO.
      162   DEFINE VARIABLE v-fr-ch-end     AS character   INIT "             СПАСИБО ЗА ПОКУПКУ" NO-UNDO.
      163   DEFINE VARIABLE v-fr-AF         AS character   INIT "->>>>>>>>>>>>>>>>>>>>9.99":U NO-UNDO.
      164   DEFINE VARIABLE v-fr-QF         AS character   INIT "->>>>>>>>>>>>>>>>>>>>9.999":U NO-UNDO.
      165   DEFINE VARIABLE v-fr-QF2        AS character   INIT "->>>>>>>>>>>>>>>>>>>>9":U NO-UNDO.
      166   DEFINE VARIABLE v-fr-trim       AS character   INIT " ":U NO-UNDO.
      167   define variable v-cd-mode       as character    no-undo.
      168   define variable v-cd-submode    as character    no-undo.
      169   define variable v-model    as integer      no-undo.
      170   define variable v-cash-drawer-plug    as logical      no-undo.
      171   PROCEDURE fr-init :
      172   define input parameter p-dc-number     as integer        no-undo.
      173   define input parameter p-shop-number   as integer        no-undo.
      174   define input parameter p-serial-number as character        no-undo.
      175   define input  parameter p-fr-type      as character      no-undo .
      176   define input  parameter p-com-port     as character      no-undo .
      177   define output parameter p-fr-model     as integer        no-undo.
      178   define output parameter p-err-message  as character      no-undo.
      179   define output parameter p-ok           as logical        no-undo.
      180   define variable v-ok                 as logical      no-undo.
      181   define variable v-err-message        as character    no-undo.
      182   define variable v-i                  as integer      no-undo .
      183   define variable v-return             as int          no-undo .
      184   define variable v-Type-KKM           as char         no-undo .
      185   define variable v-Ser-Num            as char         no-undo .
      186   define variable v-LastShiftNum       as int          no-undo .
      187   define variable         v-datefirstdoc       as character no-undo .
      188   define variable         v-timefirstdoc       as character no-undo .
      189   define variable         v-cLastShiftNum      as char      no-undo .
      190   define variable v-status-current as character no-undo .
      191   define variable v-status-const   as character no-undo .
      192       case p-fr-type:
      193         when 'prim08tk':U then v-fr-type = 200 .
      194         when 'shtrih-fr-k-01':U then v-fr-type = 100 .
      195       end case .
      196   if v-fr-type = ? then
      197   do:
      198      assign
      199         p-err-message = "Не определен фискальный регистратор"
      200         p-ok = no
      201         error-status:error = yes
      202         .
      203      return error.
      204   end.
      205   bl:
      206   DO
      207   ON ERROR UNDO, RETURN ERROR
      208   :
      209    case v-fr-type :
      210      when 100 then
      211     _shtrikh:
      212      DO:
      213         RELEASE OBJECT v-fr NO-ERROR.
      214         v-fr = ?.
      215         CREATE "AddIn.DrvFR":U v-fr CONNECT NO-ERROR.
      216         IF ERROR-STATUS:ERROR
      217         OR NOT VALID-HANDLE(v-fr)
      218         THEN DO:
      219            CREATE "AddIn.DrvFR":U v-fr NO-ERROR.
      220         END.
      221         IF ERROR-STATUS:ERROR
      222         OR NOT VALID-HANDLE(v-fr)
      223         THEN DO:
      224            ASSIGN
      225               p-err-message = "Не найден COM-сервер для ФР Штрих"
      226               p-ok = FALSE
      227            .
      228            LEAVE _shtrikh.
      229         END.
      230         v-fr:Password = 1.
      231         v-fr:CONNECT() NO-ERROR.
      232         IF ERROR-STATUS:ERROR
      233         OR v-fr:ResultCode <> 0
      234         THEN DO:
      235            ASSIGN
      236               p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription + STRING(v-fr:ResultCode) ELSE ""
      237               p-ok = FALSE
      238            .
      239            LEAVE _shtrikh.
      240         END.
      241         IF INT(v-fr:ECRMode) = 8 THEN
      242         DO:
      243            x_v-fr-check_re_bl:
      244            DO WHILE YES:
      245               v-fr:GetECRStatus().
      246               DO WHILE v-fr:ResultCode <> 0:
      247                     IF v-fr:ResultCode = -1
      248                     THEN DO:
      249                     END.
      250                     v-fr:GetECRStatus().
      251               END.
      252               CASE INTEGER(v-fr:ECRAdvancedMode):
      253                  WHEN 0 THEN DO:
      254                     LEAVE x_v-fr-check_re_bl.
      255                  END.
      256                  WHEN 3 OR
      257                  WHEN 5
      258                  THEN DO:
      259                     v-fr:ContinuePrint().
      260                  END.
      261                  OTHERWISE DO:
      262                     ASSIGN
      263                        p-err-message = v-fr:ECRAdvancedModeDescription
      264                        p-ok          = TRUE
      265                     .
      266                     RETURN.
      267                  END.
      268               END CASE.
      269            END.
      270            v-fr:Password = 30.
      271            v-fr:SysAdminCancelCheck().
      272            v-fr:Password = 1.
      273            IF v-fr:ResultCode <> 0
      274            THEN DO:
      275               ASSIGN
      276                  p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
      277                  p-ok = FALSE
      278               .
      279               RETURN.
      280            END.
      281         END.
      282         v-fr:GetECRStatus() NO-ERROR.
      283         IF ERROR-STATUS:ERROR
      284         OR v-fr:ResultCode <> 0
      285         THEN DO:
      286            ASSIGN
      287               p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription + STRING(v-fr:ResultCode) ELSE ""
      288               p-ok = FALSE
      289            .
      290            RETURN.
      291         END.
      292         IF v-fr:SerialNumber <> p-serial-number
      293         THEN DO:
      294            assign
      295               p-err-message = SUBSTITUTE ( "Серийный номер ФР (&1) отличается от указанного в настройках (&2)"
      296                                       , v-fr:SerialNumber
      297                                       , p-serial-number
      298                                       )
      299               p-ok      = FALSE
      300            .
      301            RETURN.
      302         END.
      303         v-fr:GetDeviceMetrics() NO-ERROR.
      304         IF ERROR-STATUS:ERROR
      305         OR v-fr:ResultCode <> 0
      306         THEN DO:
      307            ASSIGN
      308               p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription + STRING(v-fr:ResultCode) ELSE ""
      309               p-ok = FALSE
      310            .
      311            RETURN.
      312         END.
      313         ASSIGN
      314            p-fr-model = v-fr:UModel
      315            v-model    = v-fr:UModel
      316            p-ok = yes
      317            p-err-message = ""
      318         .
      319      END.
      320      when 200 then
      321      do:
      322       do
      323       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      324       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      325       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      326        :
      327        run fr-openDll(input p-com-port,
      328                        output v-return) .
      329        run Fr-GetStatusCurrent(output v-status-const ,
      330                                output v-status-current ,
      331                                output v-return )
      332                               .
      333         if substr(v-status-const,12,1) = '1' then
      334         do:
      335            message "Чековая лента близка к концу"
      336               view-as alert-box title "Сообщение".
      337         end.
      338         if substr(v-status-const,11,1) = '1' then
      339         do:
      340            message "Печать остановлена из-за конца бумаги"
      341               view-as alert-box title "Сообщение".
      342         end.
      343         if substr(v-status-const,10,1) = '1' then
      344         do:
      345            message "Открыта крышка принтера"
      346               view-as alert-box title "Сообщение".
      347         end.
      348         if substr(v-status-current,12,1) = "1" then
      349         do:
      350            message "Необходимо снять Z-отчет"
      351                         view-as alert-box title "Сообщение".
      352         end.
      353        if v-return = 0 or v-return = 21 then
      354        do:
      355          run Fr-GetFiscalNums (output v-Type-KKM,
      356                                output v-Ser-num,
      357                                output v-return).
      358          if v-return = 0 then
      359          do:
      360             if v-Ser-Num <> p-serial-number then
      361             do:
      362               assign
      363                 p-err-message = SUBSTITUTE ( "Серийный номер ФР (&1) отличается от указанного в настройках (&2)"
      364                                       , v-Ser-num
      365                                       , p-serial-number
      366                                       )
      367                 p-ok = False
      368                 .
      369               return .
      370             end.
      371             p-fr-model = 8 .
      372             assign p-ok = yes
      373                    p-err-message = ""
      374                      .
      375             run Fr-GetResource(output v-return ,
      376                                output v-lastshiftnum ,
      377                                output v-datefirstdoc ,
      378                                output v-timefirstdoc) .
      379             if v-return = 0 then
      380             do :
      381               v-cLastShiftNUm = string(v-lastShiftNum,'9999999') .
      382               run Fr-WriteCMOS(input 0 ,
      383                                input v-cLastShiftNum ,
      384                                output v-return).
      385               run Fr-WriteCMOS(input 7 ,
      386                                input v-datefirstdoc ,
      387                                output v-return).
      388               run Fr-WriteCMOS(input 13 ,
      389                                input v-timefirstdoc ,
      390                                output v-return).
      391             end .
      392             if substr(v-status-current,5,1) = "0" then
      393             do:
      394               run Fr-SetDate(output v-return) .
      395             end.
      396          end .
      397        end .
      398        else
      399        do :
      400          assign
      401            p-ok = no
      402            p-err-message = " "
      403            .
      404          if v-return = 194 then
      405          do:
      406            p-err-message = "Необходимо включить фискальный регистратор" .
      407          end.
      408          return .
      409        end .
      410       end .
      411      end .
      412     end case .
      413   END.
      414   END PROCEDURE.
      415   PROCEDURE fr-set :
      416   define input parameter  p-pay-chk               as character        no-undo.
      417   define input parameter  p-z-zero                as logical          no-undo.
      418   define input parameter  p-cashier-name          as character        no-undo.
      419   define input parameter  p-cash-drawer-plug      as logical          no-undo.
      420   define input parameter  p-cash-drawer-plug-imp  as integer          no-undo.
      421   define input parameter  p-cutter                as logical          no-undo.
      422   define input parameter  p-cash-drawer-level     as integer          no-undo.
      423   define input parameter  p-publ-chk              as character     no-undo.
      424   define input parameter  p-head-chk              as character     no-undo.
      425   define input parameter  p-print-good-code       as logical          no-undo.
      426   define input parameter  p-max-netto             as DECIMAL          no-undo.
      427   define input parameter  p-cash-shift            as logical          no-undo.
      428   define input parameter  p-cash-drawer-open      as logical          no-undo.
      429   define input parameter  p-cash-drawer-limit     as DECIMAL          no-undo.
      430   define input  parameter p-clear-cash-counter    as logical          no-undo .
      431   define output parameter p-err-message as character        no-undo.
      432   define output parameter p-ok          as logical          no-undo.
      433   define variable v-Return as int no-undo .
      434   define variable v-cashier-name  as char no-undo .
      435   define variable v-header as character extent 6 no-undo .
      436   define variable v-i as integer   no-undo .
      437   define variable v-const-status as character no-undo .
      438   define variable v-current-status as character no-undo .
      439   define variable v-clear-cash-counter as char no-undo .
      440   define variable v-cutter as character no-undo .
      441      CASE v-fr-type :
      442      when 200 then
      443      do:
      444        do
      445        on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      446        on stop   undo, return error substitute( "&1. stop", vss-workfile )
      447        on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      448        :
      449          v-cashier-name = replace(p-cashier-name, "Кассир", "") .
      450          run Fr-ChangeOpName( input v-cashier-name,
      451                             output v-Return) .
      452          if v-Return = 0 then
      453          do:
      454             run Fr-GetStatusCurrent(output v-const-status,
      455                                     output v-current-status,
      456                                     output v-return
      457                                     ) .
      458             if substr(v-current-status,5,1) = '0' then
      459             do:
      460               assign
      461               v-cutter = "1"
      462               v-clear-cash-counter = "0".
      463               if p-cutter then
      464               do:
      465                 assign
      466                    v-cutter = '0'.
      467               end.
      468               if p-clear-cash-counter then
      469               do:
      470                 assign
      471                    v-clear-cash-counter = '1'.
      472               end.
      473               run Fr-SetParamDoc(input v-clear-cash-counter,
      474                                  input v-cutter)
      475                                  .
      476               DO v-i = 1 to NUM-ENTRIES(p-head-chk, chr(4)) :
      477                 assign
      478                   v-header[v-i] = ENTRY(v-i , p-head-chk, chr(4)) .
      479               END .
      480               run SetHeaderNew( input v-header[1],
      481                    input v-header[2],
      482                    input v-header[3],
      483                    input v-header[4],
      484                    input '',
      485                    input '',
      486                    output v-return )
      487                    .
      488               assign
      489                 v-header = ''
      490                 .
      491               DO v-i = 1 to NUM-ENTRIES(p-publ-chk, chr(4)) :
      492                 assign
      493                   v-header[v-i] = ENTRY(v-i , p-publ-chk, chr(4)) .
      494               END .
      495               run SetTail( input v-header[1],
      496                    input v-header[2],
      497                    input v-header[3],
      498                    input v-header[4],
      499                    output v-return )
      500                    .
      501               DO v-i = 1 to NUM-ENTRIES(p-pay-chk, chr(4)):
      502                 IF v-i > 4 THEN LEAVE .
      503               END.
      504             end.
      505             assign
      506               p-ok = yes
      507               p-err-message = "" .
      508          end.
      509        end.
      510      end.
      511      WHEN 100 THEN DO:
      512   IF VALID-HANDLE(v-fr)
      513   THEN DO
      514   ON ERROR UNDO, RETURN ERROR
      515   :
      516      ASSIGN
      517         v-cash-drawer-plug = p-cash-drawer-plug
      518      .
      519         v-fr:GetECRStatus().
      520         IF v-fr:ResultCode <> 0
      521         THEN DO:
      522            assign
      523               p-err-message = v-fr:ResultCodeDescription
      524               p-ok      = FALSE
      525            .
      526            RETURN.
      527         END.
      528         IF v-fr:ECRMode = 10
      529         THEN DO:
      530            v-fr:Password = 30.
      531            v-fr:InterruptTest().
      532            IF v-fr:ResultCode <> 0
      533            THEN DO:
      534               assign
      535                  p-err-message = v-fr:ResultCodeDescription
      536                  p-ok      = FALSE
      537               .
      538               RETURN.
      539            END.
      540         END.
      541         v-fr:Password = 30.
      542         ASSIGN
      543         v-fr:TableNumber = 1
      544         v-fr:RowNumber = 1
      545         v-fr:FieldNumber = 2
      546         v-fr:ValueOfFieldInteger = IF p-z-zero THEN 1 ELSE 0
      547         .
      548         v-fr:GetFieldStruct().
      549         v-fr:WriteTable().
      550         ASSIGN
      551         v-fr:TableNumber = 1
      552         v-fr:RowNumber = 1
      553         v-fr:FieldNumber = 7
      554         v-fr:ValueOfFieldInteger = IF p-cash-drawer-plug THEN 1 ELSE 0
      555         .
      556         v-fr:GetFieldStruct().
      557         v-fr:WriteTable().
      558         ASSIGN
      559            v-fr:FieldNumber = 8
      560            v-fr:ValueOfFieldInteger = IF p-cutter  THEN 2 ELSE 0
      561         .
      562         v-fr:GetFieldStruct().
      563         v-fr:WriteTable().
      564         define variable v-count    as integer      no-undo.
      565         define variable v-found as logical no-undo .
      566         v-found = no.
      567         _publ:
      568         DO v-count = 1 to NUM-ENTRIES(p-publ-chk, chr(4)):
      569           v-found = length(ENTRY(v-count, p-publ-chk, chr(4))) > 0 or v-found.
      570           ASSIGN
      571           v-fr:TableNumber  = 4
      572           v-fr:RowNumber    = v-count
      573           v-fr:FieldNumber  = 1
      574           v-fr:ValueOfFieldString = ENTRY(v-count, p-publ-chk, chr(4))
      575            .
      576           IF v-count > 3 THEN LEAVE _publ.
      577           v-fr:GetFieldStruct().
      578           v-fr:WriteTable().
      579         END.
      580         ASSIGN
      581         v-fr:TableNumber = 1
      582         v-fr:RowNumber = 1
      583         v-fr:FieldNumber = 44
      584         v-fr:ValueOfFieldInteger = 3
      585         .
      586         v-fr:GetFieldStruct().
      587         define variable v-adv-lines-num as integer no-undo .
      588         v-adv-lines-num =  v-fr:MAXValueOfField.
      589         v-fr:WriteTable().
      590         ASSIGN
      591         v-fr:TableNumber = 1
      592         v-fr:RowNumber = 1
      593         v-fr:FieldNumber = 4
      594         v-fr:ValueOfFieldInteger = (if v-found then 1 else 0)
      595         .
      596         v-fr:GetFieldStruct().
      597         v-fr:WriteTable().
      598         v-found = no.
      599         define variable v-line as character no-undo .
      600         _clish:
      601         DO v-count = 1 to 6  :
      602           if v-count < 3 then do:
      603             v-line = ''.
      604           end.
      605           else do:
      606             assign
      607             v-line = ENTRY(v-count - 2, p-head-chk, chr(4))
      608             v-found = length(v-line) > 0 or v-found.
      609           end.
      610           ASSIGN
      611           v-fr:TableNumber = 4
      612           v-fr:RowNumber   = v-count + v-adv-lines-num
      613           v-fr:FieldNumber = 1
      614           v-fr:ValueOfFieldString = v-line
      615            .
      616           IF v-count > 6 THEN LEAVE _clish.
      617           v-fr:GetFieldStruct().
      618           v-fr:WriteTable().
      619         END.
      620         ASSIGN
      621         v-fr:TableNumber = 1
      622         v-fr:RowNumber = 1
      623         v-fr:FieldNumber = 46
      624         v-fr:ValueOfFieldInteger = (if v-found then 1 else 0)
      625         .
      626         v-fr:GetFieldStruct().
      627         v-fr:WriteTable().
      628         ASSIGN
      629            v-fr:TableNumber = 2
      630            v-fr:RowNumber   = 1
      631            v-fr:FieldNumber = 2
      632            v-fr:ValueOfFieldString = p-cashier-name
      633         .
      634         v-fr:GetFieldStruct().
      635         v-fr:WriteTable().
      636         _set_pay:
      637         DO v-count = 1 to NUM-ENTRIES(p-pay-chk, chr(4)):
      638            IF v-count > 4 THEN LEAVE _set_pay.
      639            ASSIGN
      640               v-fr:TableNumber = 5
      641               v-fr:RowNumber   = v-count + 1
      642               v-fr:FieldNumber = 1
      643               v-fr:ValueOfFieldString = ENTRY(v-count, p-pay-chk, chr(4))
      644            .
      645            v-fr:GetFieldStruct().
      646            v-fr:WriteTable().
      647         END.
      648         v-fr:GetECRStatus().
      649         IF v-fr:ResultCode <> 0
      650         THEN DO:
      651            assign
      652               p-err-message = v-fr:ResultCodeDescription
      653               p-ok      = FALSE
      654            .
      655            RETURN.
      656         END.
      657      ASSIGN
      658         p-ok = TRUE
      659         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
      660      .
      661      END.
      662   END.
      663      OTHERWISE DO:
      664      END.
      665      END CASE.
      666   END PROCEDURE.
      667   PROCEDURE fr-dtset :
      668   define output parameter p-err-message as character        no-undo.
      669   define output parameter p-ok          as logical          no-undo.
      670   define variable   v-return    as integer no-undo .
      671   case v-fr-type :
      672     when 100 then
      673     do:
      674       IF VALID-HANDLE(v-fr)
      675       THEN DO
      676       ON ERROR UNDO, RETURN ERROR
      677       :
      678          ASSIGN
      679               v-fr:Password = 30.
      680               v-fr:date     = TODAY
      681            .
      682            v-fr:SetDate() NO-ERROR.
      683            IF ERROR-STATUS:ERROR
      684            OR v-fr:ResultCode <> 0
      685            THEN DO:
      686               ASSIGN
      687                  p-err-message = SUBSTITUTE( "&1 &2 &3"
      688                                            , RETURN-VALUE
      689                                            , ERROR-STATUS:GET-MESSAGE(1)
      690                                            , v-fr:ResultCodeDescription
      691                                            )
      692                  p-ok = FALSE
      693               .
      694               RETURN.
      695            END.
      696            assign p-ok = yes
      697                   p-err-message = IF v-fr:ResultCode <> 0 then v-Fr:ResultCodeDescription else ""
      698                   .
      699       END.
      700     end.
      701     when 200 then
      702     do:
      703       do
      704       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      705       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      706       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      707       :
      708        run Fr-SetDate(output v-return) .
      709        if v-return = 0 then
      710        do:
      711           assign
      712             p-ok = yes
      713             p-err-message = "" .
      714        end.
      715        else
      716        do:
      717           assign
      718              p-ok = no .
      719           run Fr-ErrorMessage(output p-err-message) .
      720        end.
      721       end.
      722     end.
      723         OTHERWISE DO:
      724         END.
      725   END CASE.
      726   END PROCEDURE.
      727   PROCEDURE fr-dtget :
      728   define output parameter p-date         as date             no-undo.
      729   define output parameter p-err-message  as character        no-undo.
      730   define output parameter p-ok           as logical          no-undo.
      731   define variable    v-return   as int  no-undo .
      732   define variable    v-dateKKm  as char no-undo .
      733   define variable    v-timeKKM  as char no-undo .
      734   case v-fr-type :
      735    when 100 then
      736    do:
      737     IF VALID-HANDLE(v-fr)
      738       THEN DO
      739        ON ERROR UNDO, RETURN ERROR
      740       :
      741      ASSIGN
      742         p-date         = v-fr:date
      743         p-ok           = TRUE
      744         p-err-message  = v-fr:ResultCodeDescription
      745      .
      746     END.
      747    end.
      748    when 200 then
      749    do:
      750      do
      751      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      752      on stop   undo, return error substitute( "&1. stop", vss-workfile )
      753      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      754      :
      755       run Fr-GetDate(output v-return  ,
      756                      output v-dateKKM ,
      757                      output v-timeKKM
      758                      )
      759                      .
      760       if v-return = 0  then
      761       do:
      762        assign
      763          p-date = date(v-dateKKM)
      764          p-ok = yes
      765          p-err-message =  ''.
      766       end.
      767       else
      768       do:
      769         run Fr-ErrorMessage(output p-err-message) .
      770         assign p-ok = no .
      771       end.
      772      end.
      773    end.
      774    end case .
      775   END PROCEDURE.
      776   PROCEDURE fr-tmset :
      777   define output parameter p-err-message as character        no-undo .
      778   define output parameter p-ok          as logical          no-undo .
      779   define variable  v-return as int no-undo .
      780   case v-fr-type :
      781     when 100 then
      782     do:
      783       IF VALID-HANDLE(v-fr)
      784       THEN DO
      785       ON ERROR UNDO, RETURN ERROR
      786       :
      787            ASSIGN
      788               v-fr:Password = 30.
      789               v-fr:ConfirmDate().
      790               v-fr:TIME = TIME / 86400.
      791            .
      792            v-fr:SetTime() NO-ERROR .
      793            IF ERROR-STATUS:ERROR
      794            OR v-fr:ResultCode <> 0
      795            THEN DO:
      796               ASSIGN
      797                  p-err-message = SUBSTITUTE( "&1 &2 &3"
      798                                            , RETURN-VALUE
      799                                            , ERROR-STATUS:GET-MESSAGE(1)
      800                                            , v-fr:ResultCodeDescription
      801                                            )
      802                  p-ok = FALSE
      803               .
      804               RETURN .
      805            END .
      806            assign p-ok = yes
      807                   p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
      808                   .
      809       end .
      810     end .
      811     when 200 then
      812     do:
      813       do
      814       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      815       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      816       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      817       :
      818        run Fr-SetDate(output v-return) .
      819        if v-return = 0 then
      820        do:
      821           assign
      822             p-ok = yes
      823             p-err-message = "" .
      824        end.
      825        else
      826        do:
      827           assign
      828              p-ok = no .
      829           run Fr-ErrorMessage(output p-err-message) .
      830        end .
      831       end.
      832     end .
      833   end case .
      834   END PROCEDURE.
      835   PROCEDURE fr-tmget :
      836   define output parameter p-time        as integer        no-undo.
      837   define output parameter p-err-message as character        no-undo.
      838   define output parameter p-ok          as logical          no-undo.
      839   define variable    v-return   as int  no-undo .
      840   define variable    v-dateKKm  as char no-undo .
      841   define variable    v-timeKKM  as char no-undo .
      842   case v-fr-type :
      843     when 100 then
      844     do:
      845       IF VALID-HANDLE(v-fr)
      846       THEN DO
      847       ON ERROR UNDO, RETURN ERROR
      848       :
      849        ASSIGN
      850         p-time = (INT(ENTRY(1, v-fr:TimeStr, ":":U)) * 3600) + (INT(ENTRY(2, v-fr:TimeStr, ":":U)) * 60) + INT(ENTRY(3, v-fr:TimeStr, ":":U))
      851         p-ok = TRUE
      852         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
      853           .
      854       END.
      855     end.
      856   when 200 then
      857    do:
      858       do
      859       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      860       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      861       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      862       :
      863         run Fr-GetDate(output v-return ,
      864                      output v-dateKKM ,
      865                      output v-timeKKM
      866                       )
      867                      .
      868        if v-return = 0  then
      869        do:
      870          assign
      871            p-time = int(substr(v-timeKKM,1,2)) * 3600 + int(substr(v-timeKKM,3,2)) * 60
      872            p-ok = yes
      873            p-err-message =  ''.
      874        end.
      875        else
      876        do:
      877           run Fr-ErrorMessage(output p-err-message) .
      878           assign p-ok = no .
      879        end.
      880       end.
      881    end.
      882   end case .
      883   END PROCEDURE.
      884   PROCEDURE fr-ctrl :
      885   define input parameter  p-dr-open            as logical          no-undo.
      886   define output parameter p-err-message        as character        no-undo.
      887   define output parameter p-ok                 as logical          no-undo.
      888   define output parameter p-fr-mode            as integer      no-undo.
      889   define output parameter p-fr-time            as integer      no-undo.
      890   define output parameter p-fr-date            as date         no-undo.
      891   define output parameter p-fr-last-shift-date as date         no-undo.
      892   define output parameter p-fr-last-shift-num  as integer      no-undo.
      893   define output parameter p-fr-lic             as character    no-undo.
      894   define output parameter p-fr-shift-open      as integer      no-undo.
      895   define output parameter p-fr-serial          as char      no-undo.
      896   define variable         v-return             as integer   no-undo .
      897   define variable         v-datefirstdoc       as character no-undo .
      898   define variable         v-timefirstdoc       as character no-undo .
      899   define variable         v-dateKKm            as character no-undo .
      900   define variable         v-timeKKM            as character no-undo .
      901   define variable         v-serialNum          as character no-undo .
      902   define variable         v-responce           as memptr    no-undo .
      903   define variable         v-creturn            as char no-undo .
      904   define variable         v-cLastShiftNum      as char no-undo .
      905   define variable         v-status-const       as character no-undo .
      906   define variable         v-status-current     as character no-undo .
      907   case v-fr-type:
      908    when 200 then
      909    do:
      910       do
      911       on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      912       on stop   undo, return error substitute( "&1. stop", vss-workfile )
      913       on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      914       :
      915         run Fr-GetStatusCurrent(output v-status-const ,
      916                                 output v-status-current ,
      917                                 output v-return )
      918                               .
      919         if substr(v-status-const,12,1) = '1' then
      920         do:
      921            message "Чековая лента близка к концу"
      922               view-as alert-box title "Сообщение".
      923         end.
      924         if substr(v-status-const,11,1) = '1' then
      925         do:
      926            message "Печать остановлена из-за конца бумаги"
      927               view-as alert-box title "Сообщение".
      928         end.
      929         if substr(v-status-const,10,1) = '1' then
      930         do:
      931            message "Открыта крышка принтера"
      932               view-as alert-box title "Сообщение".
      933         end.
      934         if substr(v-status-current,9,1) = '0' then
      935         do:
      936            RUN StartSeans(OUTPUT v-Return) .
      937         end.
      938         run Fr-ReadCMOS(input 0 ,
      939                       input 7 ,
      940                       output v-cLastShiftNum ,
      941                       output v-return) .
      942         run Fr-ReadCMOS(input 7 ,
      943                       input 6 ,
      944                       output v-datefirstdoc ,
      945                       output v-return) .
      946         run Fr-ReadCMOS(input 13 ,
      947                       input 4 ,
      948                       output v-timefirstdoc ,
      949                       output v-return) .
      950         if v-return = 0 then
      951         do:
      952           assign
      953             p-fr-last-shift-num = int(v-cLastShiftNum)
      954             p-fr-last-shift-date = today - 1
      955             .
      956           run Fr-GetDate(output v-return,
      957                        output v-dateKKM,
      958                        output v-timeKKM) .
      959           if v-return = 0 then
      960           do:
      961             run Fr-GetSerialNUM(output v-return, output v-serialNum) .
      962             if v-return = 0 then
      963             do:
      964               assign
      965                 p-ok = yes
      966                 p-fr-mode = 0
      967                 p-fr-serial = v-serialNum
      968                 p-fr-time  = int(substr(v-timeKKM,1,2)) * 3600 + int(substr(v-timeKKM,3,2)) * 60
      969                .
      970               if v-timefirstdoc = "0000" then
      971               do:
      972                 p-fr-shift-open = 0 .
      973               end .
      974               else
      975               do:
      976                   assign
      977                     .
      978               end.
      979               run fr-prim08ECRstatus(output p-fr-mode,output p-err-message) .
      980             end.
      981           end .
      982         end.
      983         if substr(v-status-current,12,1) = '1' then
      984         do:
      985              assign
      986                p-fr-shift-open = 24
      987                p-ok = no
      988                 .
      989              return .
      990         end.
      991         if substr(v-status-current,5,1) = '0' then
      992         do:
      993              assign
      994                p-fr-shift-open = 0
      995                .
      996         end.
      997         else
      998         do:
      999              assign
     1000                p-fr-shift-open = 1
     1001                .
     1002         end.
     1003         if v-return <> 0 then
     1004         do:
     1005           assign p-ok = no .
     1006           run GetLastDllError(output v-return) .
     1007           set-size(v-Responce) = 120 .
     1008           run GetErrorMessage(output v-Responce ,output v-creturn) .
     1009           p-err-message = get-string(v-Responce,1) .
     1010           set-size(v-Responce) = 0 .
     1011           p-err-message = string(v-return) + ' - ' + p-err-message .
     1012         end.
     1013       end.
     1014    end.
     1015    when 100 then
     1016    do:
     1017     IF VALID-HANDLE(v-fr)
     1018     THEN DO
     1019     ON ERROR UNDO, RETURN ERROR
     1020      :
     1021            v-fr:GetECRStatus() NO-ERROR.
     1022            IF ERROR-STATUS:ERROR
     1023            OR v-fr:ResultCode <> 0
     1024            THEN DO:
     1025               ASSIGN
     1026                  p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1027                                            , RETURN-VALUE
     1028                                            , ERROR-STATUS:GET-MESSAGE(1)
     1029                                            , v-fr:ResultCodeDescription
     1030                                            , v-fr:ResultCode
     1031                                            )
     1032                  p-ok = FALSE
     1033               .
     1034               RETURN.
     1035            END.
     1036            ASSIGN
     1037               p-fr-mode            = v-fr:ECRMode
     1038               p-fr-time            = (INT(ENTRY(1, v-fr:TimeStr, ":":U)) * 3600) + (INT(ENTRY(2, v-fr:TimeStr, ":":U)) * 60) + INT(ENTRY(3, v-fr:TimeStr, ":":U))
     1039               p-fr-date            = v-fr:date
     1040               p-fr-last-shift-date = v-fr:LastSessionDate
     1041               p-fr-last-shift-num  = v-fr:LastSessionNumber
     1042               p-fr-serial          = v-fr:SerialNumber
     1043               p-fr-shift-open      = IF v-fr:IsFMSessionOpen THEN 1 ELSE 0
     1044            .
     1045            IF v-fr:IsDrawerOpen
     1046            AND NOT p-dr-open
     1047            THEN DO:
     1048               ASSIGN
     1049                  p-err-message = "Закройте денежный ящик."
     1050               .
     1051               RETURN.
     1052            END.
     1053            IF NOT v-fr:LicenseIsPresent
     1054            THEN DO:
     1055               ASSIGN
     1056                  p-err-message = "Нет лицензии"
     1057               .
     1058               RETURN.
     1059            END.
     1060            IF v-fr:IsFM24HoursOver
     1061            THEN DO:
     1062               ASSIGN
     1063                  p-fr-shift-open = 24
     1064                  p-err-message   = "Истекли 24 часа открытой смены"
     1065               .
     1066               RETURN.
     1067            END.
     1068            IF v-fr:IsLastFMRecordCorrupted
     1069            THEN DO:
     1070               ASSIGN
     1071                  p-err-message = "Последняя запись ВФПИ спорчена"
     1072               .
     1073               RETURN.
     1074            END.
     1075      END.
     1076      ASSIGN
     1077         p-ok = TRUE
     1078         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1079      .
     1080    end.
     1081    OTHERWISE DO:
     1082    END.
     1083   END CASE.
     1084   END PROCEDURE.
     1085   PROCEDURE fr-add-sale :
     1086   define input parameter p-barcode       AS character   NO-UNDO .
     1087   define input parameter p-name          AS character   NO-UNDO .
     1088   define input parameter p-price         AS DECIMAL     NO-UNDO .
     1089   define input parameter p-qnty          AS DECIMAL     NO-UNDO .
     1090   define input parameter p-unit-base     AS character   NO-UNDO .
     1091   define input parameter p-d-card        AS character   NO-UNDO .
     1092   define input parameter p-discount      AS DECIMAL     NO-UNDO .
     1093   define output parameter p-err-message  as character   no-undo .
     1094   define output parameter p-ok           as logical     no-undo .
     1095   define variable v-statusConst   as char no-undo .
     1096   define variable v-statusCurrent as char no-undo .
     1097   define variable v-return        as int  no-undo .
     1098   define variable v-chek-num      as int  no-undo .
     1099   define variable v-prim-price    as int  no-undo .
     1100   define variable v-prim-qty    as int  no-undo .
     1101   define variable v-prim-dsc    as int  no-undo .
     1102   define variable v-OType       as int  no-undo .
     1103   define variable v-itogo       as char no-undo .
     1104   define variable v-itogo-str   as char no-undo .
     1105   define variable v-disc-str    as char no-undo .
     1106   define variable v-Free-Field as character no-undo .
     1107   if v-fr-type = 200 then
     1108   do:
     1109      do
     1110      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1111      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1112      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1113      :
     1114        run Fr-GetStatusCurrent(output v-StatusConst ,
     1115                              output v-StatusCurrent ,
     1116                              output v-return )
     1117                              .
     1118        if substr(v-StatusCurrent,14,3) = '000' then
     1119        do:
     1120          assign
     1121            v-Free-Field = "" .
     1122          if p-d-card <> "" then
     1123          do:
     1124             assign
     1125                v-Free-Field = "  Диск.карта  N " + p-d-card .
     1126          end.
     1127          run Fr-StartReceiptPlus (input  0 ,
     1128                                   input  v-Free-Field ,
     1129                                 output v-chek-num,
     1130                                 output v-return
     1131                                         ) .
     1132          run Fr-FirstDoc.
     1133        end.
     1134        assign v-prim-price = p-price * 100
     1135               v-prim-qty   = p-qnty  * 1000
     1136               v-prim-dsc   = p-discount * 100 .
     1137        run Fr-ItemReceiptPlus( input p-name ,
     1138                              input p-barcode ,
     1139                              input substr(p-unit-base,1,3) ,
     1140                              input "" ,
     1141                              input fill('-',40) ,
     1142                              input v-prim-price ,
     1143                              input v-prim-qty ,
     1144                              input 1 ,
     1145                              input v-prim-dsc ,
     1146                             output v-Return ,
     1147                             output v-Itogo ,
     1148                             output v-Itogo-str ,
     1149                             output v-Disc-str
     1150                              ) .
     1151        if v-return = 0 then
     1152        do:
     1153          assign
     1154            p-ok = yes
     1155            p-err-message = "" .
     1156        end.
     1157        else
     1158        do:
     1159          assign p-ok = no .
     1160          run Fr-ErrorMessage(output p-err-message) .
     1161        end.
     1162      end.
     1163      return .
     1164   end.
     1165   IF VALID-HANDLE(v-fr)
     1166   THEN DO
     1167   ON ERROR UNDO, RETURN ERROR
     1168   :
     1169      CASE v-fr-type:
     1170         WHEN 100 THEN DO:
     1171            IF p-qnty > 0
     1172            THEN DO:
     1173               ASSIGN
     1174                  v-fr:Password          = 1
     1175                  v-fr:Quantity          = p-qnty
     1176                  v-fr:Price             = p-price
     1177                  v-fr:Department        = 0
     1178                  v-fr:StringForPrinting = p-name
     1179               .
     1180               v-fr:Sale() NO-ERROR.
     1181               IF ERROR-STATUS:ERROR
     1182               OR v-fr:ResultCode <> 0
     1183               THEN DO:
     1184                  ASSIGN
     1185                     p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1186                                             , RETURN-VALUE
     1187                                             , ERROR-STATUS:GET-MESSAGE(1)
     1188                                             , v-fr:ResultCodeDescription
     1189                                             , v-fr:ECRMode
     1190                                             )
     1191                     p-ok = FALSE
     1192                  .
     1193                  RETURN.
     1194               END.
     1195            END.
     1196            ELSE DO:
     1197               IF p-qnty < 0
     1198               THEN DO:
     1199                  ASSIGN
     1200                     v-fr:Password          = 1
     1201                     v-fr:Quantity          = p-qnty
     1202                     v-fr:Price             = p-price
     1203                     v-fr:Department        = 0
     1204                     v-fr:StringForPrinting = p-name
     1205                  .
     1206                  v-fr:Storno() NO-ERROR.
     1207                  IF ERROR-STATUS:ERROR
     1208                  OR v-fr:ResultCode <> 0
     1209                  THEN DO:
     1210                     ASSIGN
     1211                        p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1212                                                , RETURN-VALUE
     1213                                                , ERROR-STATUS:GET-MESSAGE(1)
     1214                                                , v-fr:ResultCodeDescription
     1215                                                , v-fr:ECRMode
     1216                                                )
     1217                        p-ok = FALSE
     1218                     .
     1219                     RETURN.
     1220                  END.
     1221               END.
     1222               ELSE DO:
     1223               END.
     1224            END.
     1225            IF p-discount < 0 THEN
     1226            DO:
     1227               ASSIGN
     1228                  v-fr:Summ1 = - p-discount
     1229                  v-fr:StringForPrinting = "":U
     1230               .
     1231               v-fr:Discount() NO-ERROR.
     1232               IF ERROR-STATUS:ERROR
     1233               OR v-fr:ResultCode <> 0
     1234               THEN DO:
     1235                  ASSIGN
     1236                     p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1237                                             , RETURN-VALUE
     1238                                             , ERROR-STATUS:GET-MESSAGE(1)
     1239                                             , v-fr:ResultCodeDescription
     1240                                             , v-fr:ECRMode
     1241                                             )
     1242                  .
     1243                  RETURN.
     1244               END.
     1245            END.
     1246            ELSE IF p-discount > 0 THEN
     1247            DO:
     1248               ASSIGN
     1249                  v-fr:Summ1 = p-discount
     1250                  v-fr:StringForPrinting = "":U
     1251               .
     1252               v-fr:Charge() NO-ERROR.
     1253               IF ERROR-STATUS:ERROR
     1254               OR v-fr:ResultCode <> 0
     1255               THEN DO:
     1256                  ASSIGN
     1257                     p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1258                                             , RETURN-VALUE
     1259                                             , ERROR-STATUS:GET-MESSAGE(1)
     1260                                             , v-fr:ResultCodeDescription
     1261                                             , v-fr:ECRMode
     1262                                             )
     1263                  .
     1264                  RETURN.
     1265               END.
     1266            END.
     1267         END.
     1268         OTHERWISE DO:
     1269         END.
     1270      END CASE.
     1271      ASSIGN
     1272         p-ok = TRUE
     1273         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1274      .
     1275   END.
     1276   END PROCEDURE.
     1277   PROCEDURE fr-add-ret :
     1278   define input parameter p-barcode       AS character   NO-UNDO .
     1279   define input parameter p-name          AS character   NO-UNDO .
     1280   define input parameter p-price         AS DECIMAL     NO-UNDO .
     1281   define input parameter p-qnty          AS DECIMAL     NO-UNDO .
     1282   define input parameter p-unit-base     AS character   NO-UNDO .
     1283   define input parameter p-d-card        AS character   NO-UNDO .
     1284   define input parameter p-discount      AS DECIMAL     NO-UNDO .
     1285   define output parameter p-err-message  as character   no-undo .
     1286   define output parameter p-ok           as logical     no-undo .
     1287   define variable v-statusConst   as char no-undo .
     1288   define variable v-statusCurrent as char no-undo .
     1289   define variable v-return        as int  no-undo .
     1290   define variable v-chek-num      as int  no-undo .
     1291   define variable v-prim-price    as int  no-undo .
     1292   define variable v-prim-qty    as int  no-undo .
     1293   define variable v-prim-dsc    as int  no-undo .
     1294   define variable v-OType       as int  no-undo .
     1295   define variable v-itogo       as char no-undo .
     1296   define variable v-itogo-str   as char no-undo .
     1297   define variable v-disc-str    as char no-undo .
     1298   define variable v-Free-Field  as character no-undo .
     1299   if v-fr-type = 200 then
     1300   do:
     1301      do
     1302      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1303      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1304      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1305      :
     1306        run Fr-GetStatusCurrent(output v-StatusConst ,
     1307                              output v-StatusCurrent ,
     1308                              output v-return )
     1309                              .
     1310        if substr(v-StatusCurrent,14,3) = '000' then
     1311        do:
     1312          assign
     1313            v-Free-Field = "" .
     1314          if p-d-card <> "" then
     1315          do:
     1316             assign
     1317                v-Free-Field = " Диск.карта  N " + p-d-card .
     1318          end.
     1319          run Fr-StartReceiptPlus (input  2 ,
     1320                                   input v-Free-Field,
     1321                                 output v-chek-num,
     1322                                 output v-return ) .
     1323          run Fr-FirstDoc.
     1324        end.
     1325        assign v-prim-price = p-price * 100
     1326               v-prim-qty   = p-qnty  * 1000
     1327               v-prim-dsc   = p-discount * 100 .
     1328        run Fr-ItemReceiptPlus( input p-name ,
     1329                              input p-barcode ,
     1330                              input substr(p-unit-base,1,3) ,
     1331                              input "" ,
     1332                              input "ВОЗВРАТ ТОВАРА" ,
     1333                              input v-prim-price ,
     1334                              input v-prim-qty ,
     1335                              input 1 ,
     1336                              input v-prim-dsc ,
     1337                             output v-Return ,
     1338                             output v-Itogo ,
     1339                             output v-Itogo-str ,
     1340                             output v-Disc-str
     1341                              ) .
     1342        if v-return = 0 then
     1343        do:
     1344          assign
     1345            p-ok = yes
     1346            p-err-message = "" .
     1347        end.
     1348        else
     1349        do:
     1350          assign p-ok = no .
     1351          run Fr-ErrorMessage(output p-err-message) .
     1352        end.
     1353      end.
     1354      return .
     1355   end.
     1356   IF VALID-HANDLE(v-fr)
     1357   THEN DO
     1358   ON ERROR UNDO, RETURN ERROR
     1359   :
     1360      CASE v-fr-type:
     1361         WHEN 100 THEN DO:
     1362            IF p-qnty > 0
     1363            THEN DO:
     1364               v-fr:Password = 1.
     1365               v-fr:Quantity          = p-qnty.
     1366               v-fr:Price             = p-price.
     1367               v-fr:Department        = 0.
     1368               v-fr:StringForPrinting = p-name.
     1369               v-fr:ReturnSale() NO-ERROR.
     1370               IF ERROR-STATUS:ERROR
     1371               OR v-fr:ResultCode <> 0
     1372               THEN DO:
     1373                  ASSIGN
     1374                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     1375                                             , RETURN-VALUE
     1376                                             , ERROR-STATUS:GET-MESSAGE(1)
     1377                                             , v-fr:ResultCodeDescription
     1378                                             )
     1379                     p-ok = FALSE
     1380                  .
     1381                  RETURN.
     1382               END.
     1383            END.
     1384            ELSE DO:
     1385               IF p-qnty < 0
     1386               THEN DO:
     1387                  v-fr:Password = 1.
     1388                  v-fr:Quantity          = p-qnty.
     1389                  v-fr:Price             = p-price.
     1390                  v-fr:Department        = 0.
     1391                  v-fr:StringForPrinting = p-name.
     1392                  v-fr:Storno() NO-ERROR.
     1393                  IF ERROR-STATUS:ERROR
     1394                  OR v-fr:ResultCode <> 0
     1395                  THEN DO:
     1396                     ASSIGN
     1397                        p-err-message = SUBSTITUTE( "&1 &2 &3"
     1398                                                , RETURN-VALUE
     1399                                                , ERROR-STATUS:GET-MESSAGE(1)
     1400                                                , v-fr:ResultCodeDescription
     1401                                                )
     1402                        p-ok = FALSE
     1403                     .
     1404                     RETURN.
     1405                  END.
     1406               END.
     1407               ELSE DO:
     1408               END.
     1409            END.
     1410            IF p-discount < 0 THEN
     1411            DO:
     1412               v-fr:Summ1 = 0.00 - p-discount.
     1413               v-fr:StringForPrinting = "":U.
     1414               v-fr:Discount() NO-ERROR.
     1415               IF ERROR-STATUS:ERROR
     1416               OR v-fr:ResultCode <> 0
     1417               THEN DO:
     1418                  ASSIGN
     1419                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     1420                                             , RETURN-VALUE
     1421                                             , ERROR-STATUS:GET-MESSAGE(1)
     1422                                             , v-fr:ResultCodeDescription
     1423                                             )
     1424                  .
     1425                  RETURN.
     1426               END.
     1427            END.
     1428            ELSE IF p-discount > 0 THEN
     1429            DO:
     1430               v-fr:Summ1 = 0.00 - p-discount.
     1431               v-fr:StringForPrinting = "":U.
     1432               v-fr:Charge() NO-ERROR.
     1433               IF ERROR-STATUS:ERROR
     1434               OR v-fr:ResultCode <> 0
     1435               THEN DO:
     1436                  ASSIGN
     1437                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     1438                                             , RETURN-VALUE
     1439                                             , ERROR-STATUS:GET-MESSAGE(1)
     1440                                             , v-fr:ResultCodeDescription
     1441                                             )
     1442                  .
     1443                  RETURN.
     1444               END.
     1445            END.
     1446         END.
     1447         OTHERWISE DO:
     1448         END.
     1449      END CASE.
     1450      ASSIGN
     1451         p-ok = TRUE
     1452         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1453      .
     1454   END.
     1455   END PROCEDURE.
     1456   PROCEDURE fr-add-annul :
     1457   define input parameter p-barcode       AS character   NO-UNDO .
     1458   define input parameter p-name          AS character   NO-UNDO .
     1459   define input parameter p-price         AS DECIMAL     NO-UNDO .
     1460   define input parameter p-qnty          AS DECIMAL     NO-UNDO .
     1461   define input parameter p-discount      AS DECIMAL     NO-UNDO .
     1462   define output parameter p-err-message  as character   no-undo .
     1463   define output parameter p-ok           as logical     no-undo .
     1464   if v-fr-type = 200 then
     1465   do:
     1466      do
     1467      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1468      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1469      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1470      :
     1471      end.
     1472      return .
     1473   end.
     1474   IF VALID-HANDLE(v-fr)
     1475   THEN DO
     1476   ON ERROR UNDO, RETURN ERROR
     1477   :
     1478      CASE v-fr-type:
     1479         WHEN 100 THEN DO:
     1480            v-fr:Quantity          = p-qnty.
     1481            v-fr:Price             = p-price.
     1482            v-fr:Department        = 0.
     1483            v-fr:StringForPrinting = p-barcode + " ":U + p-name.
     1484            v-fr:Storno().
     1485            IF p-discount < 0 THEN
     1486            DO:
     1487               v-fr:Summ1 = 0.00 - p-discount.
     1488               v-fr:StringForPrinting = "":U.
     1489               v-fr:StornoDiscount().
     1490            END.
     1491            ELSE IF p-discount > 0 THEN
     1492            DO:
     1493               v-fr:Summ1 = 0.00 - p-discount.
     1494               v-fr:StringForPrinting = "":U.
     1495               v-fr:StornoCharge().
     1496            END.
     1497         END.
     1498         OTHERWISE DO:
     1499         END.
     1500      END CASE.
     1501      ASSIGN
     1502         p-ok = TRUE
     1503         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1504      .
     1505   END.
     1506   END PROCEDURE.
     1507   PROCEDURE fr-close :
     1508   define output parameter p-err-message as character        no-undo.
     1509   define output parameter p-ok          as logical          no-undo.
     1510   def var v-return as int no-undo .
     1511   if v-fr-type = 200 then
     1512   do:
     1513      do
     1514      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1515      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1516      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1517      :
     1518        run CloseDll(output v-return) .
     1519        if v-return = 0 then
     1520        do:
     1521          assign
     1522            p-ok = yes
     1523            p-err-message = "" .
     1524        end.
     1525        else
     1526        do:
     1527           assign p-ok = no .
     1528           run Fr-ErrorMessage (output p-err-message) .
     1529        end.
     1530      end.
     1531      return .
     1532   end .
     1533   IF VALID-HANDLE(v-fr)
     1534   THEN DO
     1535   ON ERROR UNDO, RETURN ERROR
     1536   :
     1537      CASE v-fr-type :
     1538         WHEN 100 THEN DO:
     1539            v-fr:Disconnect NO-ERROR.
     1540            IF ERROR-STATUS:ERROR
     1541            THEN DO:
     1542               ASSIGN
     1543                  p-err-message = SUBSTITUTE("&1 &2", RETURN-VALUE, ERROR-STATUS:GET-MESSAGE(1))
     1544               .
     1545               RETURN.
     1546            END.
     1547         END.
     1548         OTHERWISE DO:
     1549         END.
     1550      END CASE.
     1551      RELEASE OBJECT v-fr NO-ERROR.
     1552      IF ERROR-STATUS:ERROR
     1553      THEN DO:
     1554         ASSIGN
     1555            p-err-message = SUBSTITUTE("&1 &2", RETURN-VALUE, ERROR-STATUS:GET-MESSAGE(1))
     1556         .
     1557         RETURN.
     1558      END.
     1559      assign
     1560         v-fr      = ?
     1561         p-ok    = TRUE
     1562      .
     1563   END.
     1564   END PROCEDURE.
     1565   PROCEDURE fr-usrad :
     1566   DEFINE INPUT  PARAMETER Idn            AS INTEGER     NO-UNDO.
     1567   DEFINE INPUT  PARAMETER Name           AS CHARACTER   NO-UNDO.
     1568   DEFINE INPUT  PARAMETER id             AS INTEGER     NO-UNDO.
     1569   DEFINE OUTPUT PARAMETER p-err-message  AS CHARACTER   NO-UNDO.
     1570   DEFINE OUTPUT PARAMETER p-ok           AS LOGICAL     NO-UNDO.
     1571   IF VALID-HANDLE(v-fr)
     1572   THEN DO
     1573   ON ERROR UNDO, RETURN ERROR
     1574   :
     1575      NAME = TRIM(NAME).
     1576      CASE v-fr-type :
     1577         WHEN 100 THEN DO:
     1578            v-fr:Password = 30.
     1579            v-fr:TableNumber = 2.
     1580            v-fr:RowNumber = 1.
     1581            v-fr:FieldNumber = 2.
     1582            v-fr:ValueOfFieldString = NAME.
     1583            v-fr:GetFieldStruct().
     1584               v-fr:Password = 1.
     1585               v-fr:Password = 30.
     1586            v-fr:WriteTable().
     1587            v-fr:Password = 1.
     1588         END.
     1589         OTHERWISE DO:
     1590         END.
     1591      END CASE.
     1592      ASSIGN
     1593         p-ok = TRUE
     1594         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1595      .
     1596   END.
     1597   END PROCEDURE.
     1598   PROCEDURE fr-chkcl :
     1599   define input parameter p-summ-1        AS DEC         NO-UNDO .
     1600   define input parameter p-summ-2        AS DEC         NO-UNDO .
     1601   define input parameter p-summ-3        AS DEC         NO-UNDO .
     1602   define input parameter p-summ-4        AS DEC         NO-UNDO .
     1603   define input parameter p-card          AS CHAR        NO-UNDO .
     1604   define output parameter p-chk-num      as integer     no-undo .
     1605   define output parameter p-rest-summ    as decimal     no-undo .
     1606   define output parameter p-err-message  as character   no-undo .
     1607   define output parameter p-ok           as logical     no-undo .
     1608   if v-fr-type = 200 then
     1609   do:
     1610     def var v-return as int no-undo .
     1611     define variable v-ItogoSum  as character no-undo .
     1612     define variable v-SurChargeSum as character no-undo .
     1613     define variable v-ChangeSum as character no-undo .
     1614     define variable v-summ-1    as integer  extent 4 no-undo .
     1615     define variable v-num-doc as integer   no-undo .
     1616     define variable v-CashMony as decimal   no-undo .
     1617     define variable v-CashMonyStr as char   no-undo .
     1618     define variable v-i as integer   no-undo .
     1619      do
     1620      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1621      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1622      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1623      :
     1624        run Fr-TotalReceiptPlus( input "",output v-ItogoSum,output v-return) .
     1625         v-summ-1[1] = abs( p-summ-1) * 100 .
     1626         v-summ-1[2] = abs( p-summ-2) * 100 .
     1627         v-summ-1[3] = abs( p-summ-3) * 100 .
     1628         v-summ-1[4] = abs( p-summ-4) * 100 .
     1629        do v-i = 1 to 4 :
     1630          if v-summ-1[v-i] > 0 then
     1631          do:
     1632            run TenderReceiptPlus(input v-i - 1 ,
     1633                     input v-summ-1[v-i],
     1634                     input '' ,
     1635                     input '' ,
     1636                     output v-return ) .
     1637            if v-return = 0 then
     1638            do :
     1639              run Fr-Answer(1,14,output v-ChangeSum) .
     1640              run Fr-Answer(2,14,output v-SurChargeSum) .
     1641              if deci(v-SurChargeSum) > 0 then
     1642              do:
     1643                p-rest-summ = - deci(v-SurChargeSum) .
     1644              end.
     1645              else
     1646              do:
     1647                p-rest-summ = deci(v-changeSum) .
     1648              end.
     1649            end .
     1650            else
     1651            do :
     1652              run Fr-error-message(output p-err-message) .
     1653              assign p-ok = no .
     1654              undo , return .
     1655            end .
     1656          end.
     1657        end.
     1658        run CloseReceipt(output v-return ) .
     1659        if v-return = 0 then
     1660        do:
     1661          run Fr-GetNumbers(output p-chk-num,
     1662                            output v-num-doc,
     1663                            output v-return  )
     1664                            .
     1665          p-chk-num = p-chk-num + 1 .
     1666          run Fr-GetMony( 1 , 14 , output v-CashMony) .
     1667          v-CashMonyStr = string(v-cashMony,">>>>>>>>>>9.99") .
     1668          run Fr-WriteCMOS(input 17 ,
     1669                           input v-CashMonyStr ,
     1670                           output v-return).
     1671          assign
     1672             p-ok = yes
     1673             p-err-message = ""
     1674           .
     1675        end .
     1676        else
     1677        do:
     1678          assign
     1679           p-ok = no .
     1680          run Fr-ErrorMessage(output p-err-message) .
     1681        end.
     1682      end.
     1683      return .
     1684   end .
     1685   IF VALID-HANDLE(v-fr)
     1686   THEN DO
     1687   ON ERROR UNDO, RETURN ERROR
     1688   :
     1689      CASE v-fr-type :
     1690         WHEN 100 THEN DO:
     1691            v-fr:Password = 1.
     1692            v-fr:GetECRStatus() NO-ERROR.
     1693            IF ERROR-STATUS:ERROR
     1694            OR v-fr:ResultCode <> 0
     1695            THEN DO:
     1696               ASSIGN
     1697                  p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1698                  p-ok  = FALSE
     1699               .
     1700            END.
     1701            v-fr:CheckSubTotal() NO-ERROR.
     1702            IF ERROR-STATUS:ERROR
     1703            OR v-fr:ResultCode <> 0
     1704            THEN DO:
     1705               ASSIGN
     1706                  p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     1707                                          , RETURN-VALUE
     1708                                          , ERROR-STATUS:GET-MESSAGE(1)
     1709                                          , v-fr:ResultCodeDescription
     1710                                          , v-fr:ECRMode
     1711                                          )
     1712                  p-ok = FALSE
     1713               .
     1714               RETURN.
     1715            END.
     1716            ASSIGN
     1717               v-fr:Password = 1
     1718               v-fr:StringForPrinting = "------------------------------------"
     1719               v-fr:Summ1 = ABS(p-summ-1)
     1720               v-fr:Summ2 = ABS(p-summ-2)
     1721               v-fr:Summ3 = ABS(p-summ-3)
     1722               v-fr:Summ4 = ABS(p-summ-4)
     1723            .
     1724            v-fr:CloseCheck() NO-ERROR.
     1725            IF ERROR-STATUS:ERROR
     1726            OR v-fr:ResultCode <> 0
     1727            THEN DO:
     1728               ASSIGN
     1729                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     1730                                          , RETURN-VALUE
     1731                                          , ERROR-STATUS:GET-MESSAGE(1)
     1732                                          , v-fr:ResultCodeDescription
     1733                                          )
     1734                  p-ok = FALSE
     1735               .
     1736               RETURN.
     1737            END.
     1738            DO WHILE INT(v-fr:ECRMode) = 8 :
     1739               pause 1.
     1740               v-fr:GetECRStatus() NO-ERROR.
     1741               IF ERROR-STATUS:ERROR
     1742               OR v-fr:ResultCode <> 0
     1743               THEN DO:
     1744                  ASSIGN
     1745                     p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1746                     p-ok  = FALSE
     1747                  .
     1748               END.
     1749            END.
     1750            ASSIGN
     1751               p-chk-num   = INT(v-fr:OpenDocumentNumber)
     1752               p-rest-summ = v-fr:Change
     1753            .
     1754         END.
     1755         OTHERWISE DO:
     1756         END.
     1757      END CASE.
     1758      ASSIGN
     1759         p-ok = TRUE
     1760         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1761      .
     1762   END.
     1763   END PROCEDURE.
     1764   procedure fr-chk-annul :
     1765   define output parameter p-chk-num  as integer          no-undo.
     1766   define output parameter p-err-message as character        no-undo.
     1767   define output parameter p-ok          as logical          no-undo.
     1768   def var v-return         as int no-undo .
     1769   def var v-StatusConst    as char no-undo .
     1770   def var v-StatusCurrent  as char no-undo .
     1771   if v-fr-type = 200 then
     1772   do:
     1773     do
     1774     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1775     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1776     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1777     :
     1778      run Fr-GetStatusCurrent(output v-StatusConst ,
     1779                              output v-StatusCurrent ,
     1780                              output v-return )
     1781                              .
     1782      if substr(v-StatusCurrent,14,3) = '000' then
     1783      do:
     1784        return .
     1785      end.
     1786      run CancelReceipt(output v-return) .
     1787      if v-return = 0 then
     1788      do:
     1789        assign
     1790            p-ok = yes
     1791            p-err-message  = "".
     1792      end.
     1793      else
     1794      do:
     1795        assign
     1796            p-ok = no .
     1797        run Fr-ErrorMessage(output p-err-message) .
     1798      end.
     1799     end.
     1800     return .
     1801   end .
     1802   do
     1803   on error undo, return error
     1804   :
     1805      CASE v-fr-type :
     1806         WHEN 100 THEN DO:
     1807            ASSIGN
     1808               v-fr:Password     = 1
     1809            .
     1810            v-fr:CancelCheck() NO-ERROR.
     1811            IF ERROR-STATUS:ERROR
     1812            OR v-fr:ResultCode <> 0
     1813            THEN DO:
     1814               ASSIGN
     1815                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     1816                                            , RETURN-VALUE
     1817                                            , ERROR-STATUS:GET-MESSAGE(1)
     1818                                            , v-fr:ResultCodeDescription
     1819                                            )
     1820               .
     1821               RETURN.
     1822            END.
     1823            DO WHILE INT(v-fr:ECRMode) = 8 :
     1824               v-fr:GetECRStatus() NO-ERROR.
     1825               IF ERROR-STATUS:ERROR
     1826               OR v-fr:ResultCode <> 0
     1827               THEN DO:
     1828                  ASSIGN
     1829                     p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1830                     p-ok  = FALSE
     1831                  .
     1832               END.
     1833            END.
     1834            p-chk-num = INT(v-fr:OpenDocumentNumber).
     1835         END.
     1836         OTHERWISE DO:
     1837         END.
     1838      END CASE.
     1839      ASSIGN
     1840         p-ok = TRUE
     1841         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1842      .
     1843   end.
     1844   end procedure.
     1845   PROCEDURE fr-draop :
     1846   define output parameter p-err-message as character        no-undo .
     1847   define output parameter p-ok          as logical          no-undo .
     1848   define variable         v-return      as integer   no-undo .
     1849   if v-fr-type = 200 then
     1850   do :
     1851      do
     1852      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1853      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1854      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1855      :
     1856        run CashDriverOpen(output v-return ) .
     1857        if v-return = 0 then
     1858        do:
     1859           assign p-ok = yes
     1860                  p-err-message = ""
     1861                  .
     1862        end.
     1863        else
     1864        do:
     1865          assign p-ok = no .
     1866          run Fr-ErrorMessage(output p-err-message) .
     1867        end .
     1868      end .
     1869      return .
     1870   end .
     1871   IF VALID-HANDLE(v-fr)
     1872   THEN DO
     1873   ON ERROR UNDO, RETURN ERROR
     1874   :
     1875      CASE v-fr-type :
     1876         WHEN 100 THEN DO:
     1877            ASSIGN
     1878               v-fr:Password     = 1
     1879               v-fr:DrawerNumber = 0
     1880            .
     1881            v-fr:OpenDrawer NO-ERROR.
     1882            IF ERROR-STATUS:ERROR
     1883            OR v-fr:ResultCode <> 0
     1884            THEN DO:
     1885               ASSIGN
     1886                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     1887                                            , RETURN-VALUE
     1888                                            , ERROR-STATUS:GET-MESSAGE(1)
     1889                                            , v-fr:ResultCodeDescription
     1890                                            )
     1891               .
     1892               RETURN.
     1893            END.
     1894         END.
     1895         OTHERWISE DO:
     1896         END.
     1897      END CASE.
     1898      ASSIGN
     1899         p-ok = TRUE
     1900      .
     1901   END.
     1902   END PROCEDURE.
     1903   PROCEDURE fr-shtop :
     1904   define output parameter p-err-message as character        no-undo.
     1905   define output parameter p-ok          as logical          no-undo.
     1906      define variable v-param1 as character no-undo .
     1907      define variable v-param2 as character no-undo .
     1908      define variable v-return as integer   no-undo .
     1909   if v-fr-type = 200 then
     1910   do:
     1911      do
     1912      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1913      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1914      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1915      :
     1916        run Fr-GetParamDoc(output v-return,
     1917                           output v-param1,
     1918                           output v-param2)
     1919                           .
     1920        if substr(v-param1,7,2) = '10' then
     1921        do:
     1922           run ShiftOpen(input "",output v-return) .
     1923           if v-return = 0 then
     1924           do:
     1925              assign
     1926                 p-ok = yes
     1927                 p-err-message = "" .
     1928           end.
     1929           else
     1930           do:
     1931             assign
     1932                 p-ok = no .
     1933             run Fr-ErrorMessage(output p-err-message) .
     1934           end.
     1935        end.
     1936        else
     1937        do:
     1938        end.
     1939      end.
     1940      return .
     1941   end.
     1942   IF VALID-HANDLE(v-fr)
     1943   THEN DO
     1944   ON ERROR UNDO, RETURN ERROR
     1945   :
     1946      CASE v-fr-type :
     1947         WHEN 100 THEN DO:
     1948            ASSIGN
     1949               v-fr:Password     = 1
     1950               v-fr:CheckType    = 0
     1951            .
     1952            v-fr:OpenCheck() NO-ERROR.
     1953            IF ERROR-STATUS:ERROR
     1954            OR v-fr:ResultCode <> 0
     1955            THEN DO:
     1956               ASSIGN
     1957                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     1958                                          , RETURN-VALUE
     1959                                          , ERROR-STATUS:GET-MESSAGE(1)
     1960                                          , v-fr:ResultCodeDescription
     1961                                          )
     1962               .
     1963               RETURN.
     1964            END.
     1965            ASSIGN
     1966               v-fr:Password     = 1
     1967            .
     1968            v-fr:CancelCheck() NO-ERROR.
     1969            IF ERROR-STATUS:ERROR
     1970            OR v-fr:ResultCode <> 0
     1971            THEN DO:
     1972               ASSIGN
     1973                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     1974                                          , RETURN-VALUE
     1975                                          , ERROR-STATUS:GET-MESSAGE(1)
     1976                                          , v-fr:ResultCodeDescription
     1977                                          )
     1978               .
     1979               RETURN.
     1980            END.
     1981         END.
     1982         OTHERWISE DO:
     1983         END.
     1984      END CASE.
     1985      ASSIGN
     1986         p-ok = TRUE
     1987         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     1988      .
     1989   END.
     1990   END PROCEDURE.
     1991   PROCEDURE fr-shtcl :
     1992   define output parameter p-err-message as character        no-undo.
     1993   define output parameter p-ok          as logical          no-undo.
     1994   if v-fr-type = 200 then
     1995   do:
     1996     def var v-return as int no-undo .
     1997     define variable v-cLastShiftNum      as char      no-undo .
     1998     define variable v-CashMony           as decimal   no-undo .
     1999     define variable v-CashMonyStr        as character no-undo .
     2000     define variable v-datefirstdoc       as character no-undo .
     2001     define variable v-timefirstdoc       as character no-undo .
     2002     define variable v-LastShiftNum       as int      no-undo .
     2003     do
     2004     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2005     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2006     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2007     :
     2008       run Fr-GetMony( 9 , 14 , output v-CashMony) .
     2009       v-CashMonyStr = string(v-cashMony,">>>>>>>>>>9.99") .
     2010       run Fr-WriteCMOS(input 31 ,
     2011                        input v-CashMonyStr ,
     2012                        output v-return).
     2013       run Fr-GetMony( 11 , 14 , output v-CashMony) .
     2014       v-CashMonyStr = string(v-cashMony,">>>>>>>>>>9.99") .
     2015       run Fr-WriteCMOS(input 45 ,
     2016                        input v-CashMonyStr ,
     2017                        output v-return).
     2018       run Fr-GetMony( 13 , 14 , output v-CashMony) .
     2019       v-CashMonyStr = string(v-cashMony,">>>>>>>>>>9.99") .
     2020       run Fr-WriteCMOS(input 59 ,
     2021                        input v-CashMonyStr ,
     2022                        output v-return).
     2023       run Fr-GetMony( 17 , 12 , output v-CashMony) .
     2024       v-CashMonyStr = string(v-cashMony,">>>>>>>>9.99") .
     2025       run Fr-WriteCMOS(input 73 ,
     2026                        input v-CashMonyStr ,
     2027                        output v-return).
     2028       run Fr-GetMony( 19 , 14 , output v-CashMony) .
     2029       v-CashMonyStr = string(v-cashMony,">>>>>>>>>>9.99") .
     2030       run Fr-WriteCMOS(input 85 ,
     2031                        input v-CashMonyStr ,
     2032                        output v-return).
     2033       run Fr-ReadCMOS(input 0 ,
     2034                       input 7 ,
     2035                       output v-cLastShiftNum ,
     2036                       output v-return) .
     2037       run EKLEJournalReport( input int(v-cLastShiftNum) + 1 , output v-return) .
     2038       run ShiftClose( output v-return).
     2039       if v-return = 0 then
     2040       do:
     2041             run Fr-GetResource(output v-return ,
     2042                                output v-lastshiftnum ,
     2043                                output v-datefirstdoc ,
     2044                                output v-timefirstdoc) .
     2045             if v-return = 0 then
     2046             do :
     2047               assign p-ok = yes
     2048                      p-err-message = ""
     2049                      .
     2050               v-cLastShiftNUm = string(v-lastShiftNum,'9999999') .
     2051               run Fr-WriteCMOS(input 0 ,
     2052                                input v-cLastShiftNum ,
     2053                                output v-return).
     2054               run Fr-WriteCMOS(input 7 ,
     2055                                input v-datefirstdoc ,
     2056                                output v-return).
     2057               run Fr-WriteCMOS(input 13 ,
     2058                                input v-timefirstdoc ,
     2059                                output v-return).
     2060             end .
     2061         assign
     2062           p-ok = yes
     2063           p-err-message = '' .
     2064       end.
     2065       else
     2066       do:
     2067         assign
     2068           p-ok = no .
     2069         run Fr-ErrorMessage(output p-err-message) .
     2070       end .
     2071     end.
     2072     return .
     2073   end .
     2074   IF VALID-HANDLE(v-fr)
     2075   THEN DO
     2076   ON ERROR UNDO, RETURN ERROR
     2077   :
     2078      CASE v-fr-type :
     2079         WHEN 100 THEN DO:
     2080            v-fr:GetECRStatus() NO-ERROR.
     2081            IF ERROR-STATUS:ERROR
     2082            OR v-fr:ResultCode <> 0
     2083            THEN DO:
     2084               ASSIGN
     2085                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2086                                            , RETURN-VALUE
     2087                                            , ERROR-STATUS:GET-MESSAGE(1)
     2088                                            , v-fr:ResultCodeDescription
     2089                                            )
     2090               .
     2091               RETURN.
     2092            END.
     2093            IF v-fr:ECRMode = 8
     2094            THEN
     2095            _ann-doc:
     2096            DO:
     2097               x_v-fr-check_re_bl:
     2098               DO WHILE YES:
     2099                  v-fr:GetECRStatus().
     2100                  DO WHILE v-fr:ResultCode <> 0:
     2101                        IF v-fr:ResultCode = -1
     2102                        THEN DO:
     2103                        END.
     2104                        v-fr:GetECRStatus().
     2105                  END.
     2106                  CASE INTEGER(v-fr:ECRAdvancedMode):
     2107                     WHEN 0 THEN DO:
     2108                        LEAVE x_v-fr-check_re_bl.
     2109                     END.
     2110                     WHEN 3 OR
     2111                     WHEN 5
     2112                     THEN DO:
     2113                        v-fr:ContinuePrint().
     2114                     END.
     2115                     OTHERWISE DO:
     2116                        ASSIGN
     2117                           p-err-message = v-fr:ECRAdvancedModeDescription
     2118                           p-ok          = TRUE
     2119                        .
     2120                     END.
     2121                  END CASE.
     2122               END.
     2123               v-fr:Password = 30.
     2124               v-fr:SysAdminCancelCheck().
     2125               v-fr:Password = 1.
     2126               IF v-fr:ResultCode <> 0
     2127               THEN DO:
     2128                  ASSIGN
     2129                     p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2130                  .
     2131                  LEAVE _ann-doc.
     2132               END.
     2133            END.
     2134            v-fr:GetECRStatus() NO-ERROR.
     2135            IF ERROR-STATUS:ERROR
     2136            OR v-fr:ResultCode <> 0
     2137            THEN DO:
     2138               ASSIGN
     2139                  p-err-message = SUBSTITUTE( "-2 &1 &2 &3"
     2140                                            , RETURN-VALUE
     2141                                            , ERROR-STATUS:GET-MESSAGE(1)
     2142                                            , v-fr:ResultCodeDescription
     2143                                            )
     2144               .
     2145               RETURN.
     2146            END.
     2147            DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     2148               v-fr:GetECRStatus().
     2149            END.
     2150            IF v-fr:ECRMode = 2
     2151            OR v-fr:ECRMode = 3
     2152            THEN DO:
     2153               v-fr:Password = 30.
     2154               v-fr:PrintReportWithCleaning() NO-ERROR.
     2155               IF ERROR-STATUS:ERROR
     2156               THEN DO:
     2157                  ASSIGN
     2158                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     2159                                             , RETURN-VALUE
     2160                                             , ERROR-STATUS:GET-MESSAGE(1)
     2161                                             , v-fr:ResultCodeDescription
     2162                                             )
     2163                  .
     2164                  RETURN.
     2165               END.
     2166               IF v-fr:ResultCode <> 0
     2167               THEN
     2168               DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     2169                  v-fr:GetECRStatus().
     2170               END.
     2171            END.
     2172         END.
     2173         OTHERWISE DO:
     2174         END.
     2175      END CASE.
     2176      ASSIGN
     2177         p-ok = TRUE
     2178         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2179      .
     2180   END.
     2181   END PROCEDURE.
     2182   PROCEDURE fr-ShowProperties :
     2183   define output parameter p-err-message as character        no-undo.
     2184   define output parameter p-ok          as logical          no-undo.
     2185   IF VALID-HANDLE(v-fr)
     2186   THEN DO
     2187   ON ERROR UNDO, RETURN ERROR
     2188   :
     2189      CASE v-fr-type :
     2190         WHEN 100 THEN DO:
     2191            v-fr:Password = 30.
     2192            v-fr:ShowProperties.
     2193         END.
     2194         OTHERWISE DO:
     2195         END.
     2196      END CASE.
     2197      ASSIGN
     2198         p-ok = TRUE
     2199         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2200      .
     2201   END.
     2202   END PROCEDURE.
     2203   PROCEDURE fr-discount :
     2204   define input  parameter p-discount    as decimal          no-undo.
     2205   define input  parameter p-name        as character        no-undo.
     2206   define output parameter p-err-message as character        no-undo.
     2207   define output parameter p-ok          as logical          no-undo.
     2208   define variable v-OType    as int no-undo .
     2209   define variable v-discount as int no-undo .
     2210   define variable v-return   as int no-undo .
     2211   define variable v-itogo    as char no-undo .
     2212   define variable v-itogo-disc    as char no-undo .
     2213   if v-fr-type = 200 then
     2214   do:
     2215      do
     2216      on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2217      on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2218      on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2219      :
     2220        if p-discount < 0 then
     2221        do:
     2222          assign
     2223            v-discount = - p-discount * 100
     2224            v-OType = 0 .
     2225        end .
     2226        else
     2227        do:
     2228          assign
     2229           v-discount =  p-discount * 100
     2230           v-OType = 1 .
     2231        end.
     2232        run Fr-SubTotalReceiptPlus( input "", output v-itogo , output v-return ) .
     2233        run Fr-ComissionReceiptPlus( input v-OType ,
     2234                                   input v-discount ,
     2235                                   input p-name ,
     2236                                   output v-itogo ,
     2237                                   output v-itogo-disc ,
     2238                                   output v-return )
     2239                                   .
     2240        if v-return = 0 then
     2241        do:
     2242          assign p-ok = yes
     2243               p-err-message = "".
     2244        end .
     2245        else
     2246        do:
     2247          assign p-ok = no .
     2248          run Fr-ErrorMessage(output p-err-message ) .
     2249        end.
     2250      end.
     2251      return .
     2252   end.
     2253   IF VALID-HANDLE(v-fr)
     2254   THEN DO
     2255   ON ERROR UNDO, RETURN ERROR
     2256   :
     2257      CASE v-fr-type :
     2258         WHEN 100 THEN DO:
     2259            IF p-discount > 0
     2260            THEN DO:
     2261               v-fr:Password          = 1.
     2262               v-fr:Summ1             = p-discount.
     2263               v-fr:StringForPrinting = p-name.
     2264               v-fr:Discount() NO-ERROR.
     2265               IF ERROR-STATUS:ERROR
     2266               OR v-fr:ResultCode <> 0
     2267               THEN DO:
     2268                  ASSIGN
     2269                     p-err-message = SUBSTITUTE( "&1 &2 &3"
     2270                                             , RETURN-VALUE
     2271                                             , ERROR-STATUS:GET-MESSAGE(1)
     2272                                             , v-fr:ResultCodeDescription
     2273                                             )
     2274                  .
     2275                  RETURN.
     2276               END.
     2277            END.
     2278            ELSE DO:
     2279               IF p-discount < 0
     2280               THEN DO:
     2281                  v-fr:Password          = 1.
     2282                  v-fr:Summ1             = ABS(p-discount).
     2283                  v-fr:StringForPrinting = p-name.
     2284                  v-fr:Charge() NO-ERROR.
     2285                  IF ERROR-STATUS:ERROR
     2286                  OR v-fr:ResultCode <> 0
     2287                  THEN DO:
     2288                     ASSIGN
     2289                        p-err-message = SUBSTITUTE( "&1 &2 &3"
     2290                                                , RETURN-VALUE
     2291                                                , ERROR-STATUS:GET-MESSAGE(1)
     2292                                                , v-fr:ResultCodeDescription
     2293                                                )
     2294                     .
     2295                     RETURN.
     2296                  END.
     2297               END.
     2298            END.
     2299         END.
     2300         OTHERWISE DO:
     2301         END.
     2302      END CASE.
     2303      ASSIGN
     2304         p-ok = TRUE
     2305         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2306      .
     2307   END.
     2308   END PROCEDURE.
     2309   PROCEDURE fr-subtotal :
     2310   define output parameter p-err-message as character        no-undo.
     2311   define output parameter p-ok          as logical          no-undo.
     2312   if v-fr-type = 200 then
     2313   do:
     2314     define variable v-itogo as character no-undo .
     2315     define variable v-return as integer   no-undo .
     2316     do
     2317     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2318     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2319     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2320     :
     2321       run Fr-SubTotalReceiptPlus(input "", output v-itogo , output v-return ) .
     2322       if v-return = 0 then
     2323       do:
     2324         assign
     2325         p-ok = yes
     2326         .
     2327       end.
     2328       else
     2329       do:
     2330         assign p-ok = no .
     2331         run Fr-errorMessage(output p-err-message) .
     2332       end.
     2333     end.
     2334     return .
     2335   end.
     2336   IF VALID-HANDLE(v-fr)
     2337   THEN DO
     2338   ON ERROR UNDO, RETURN ERROR
     2339   :
     2340      CASE v-fr-type :
     2341         WHEN 100 THEN DO:
     2342            v-fr:Password          = 1.
     2343            v-fr:CheckSubTotal() NO-ERROR.
     2344            IF ERROR-STATUS:ERROR
     2345            OR v-fr:ResultCode <> 0
     2346            THEN DO:
     2347               ASSIGN
     2348                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2349                                          , RETURN-VALUE
     2350                                          , ERROR-STATUS:GET-MESSAGE(1)
     2351                                          , v-fr:ResultCodeDescription
     2352                                          )
     2353               .
     2354               RETURN.
     2355            END.
     2356            v-fr:Password          = 1.
     2357            v-fr:StringForPrinting = FILL("-", 48).
     2358            v-fr:PrintString() NO-ERROR.
     2359            IF ERROR-STATUS:ERROR
     2360            OR v-fr:ResultCode <> 0
     2361            THEN DO:
     2362               ASSIGN
     2363                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2364                                          , RETURN-VALUE
     2365                                          , ERROR-STATUS:GET-MESSAGE(1)
     2366                                          , v-fr:ResultCodeDescription
     2367                                          )
     2368               .
     2369               RETURN.
     2370            END.
     2371            v-fr:Password          = 1.
     2372            v-fr:StringForPrinting = SUBSTITUTE("Подитог:&1&2", FILL(" ", (31 - LENGTH(STRING(v-fr:Summ1)))), v-fr:Summ1).
     2373            v-fr:PrintString() NO-ERROR.
     2374            IF ERROR-STATUS:ERROR
     2375            OR v-fr:ResultCode <> 0
     2376            THEN DO:
     2377               ASSIGN
     2378                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2379                                          , RETURN-VALUE
     2380                                          , ERROR-STATUS:GET-MESSAGE(1)
     2381                                          , v-fr:ResultCodeDescription
     2382                                          )
     2383               .
     2384               RETURN.
     2385            END.
     2386         END.
     2387         OTHERWISE DO:
     2388         END.
     2389      END CASE.
     2390      ASSIGN
     2391         p-ok = TRUE
     2392         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2393      .
     2394   END.
     2395   END PROCEDURE.
     2396   PROCEDURE fr-subtotal-without-print :
     2397   define output parameter p-summ-total  as decimal          no-undo.
     2398   define output parameter p-err-message as character        no-undo.
     2399   define output parameter p-ok          as logical          no-undo.
     2400   if v-fr-type = 200 then
     2401   do:
     2402     define variable v-itogo as character no-undo .
     2403     define variable v-return as integer   no-undo .
     2404     do
     2405     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2406     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2407     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2408     :
     2409       run Fr-SubTotalReceiptPlus(input "", output v-itogo , output v-return ) .
     2410       if v-return = 0 then
     2411       do:
     2412         assign
     2413           p-ok = yes
     2414           p-summ-total = deci(v-itogo)
     2415           .
     2416       end.
     2417       else
     2418       do:
     2419          assign p-ok = no .
     2420          run Fr-errorMessage(output p-err-message) .
     2421       end.
     2422     end.
     2423     return .
     2424   end.
     2425   IF VALID-HANDLE(v-fr)
     2426   THEN DO
     2427   ON ERROR UNDO, RETURN ERROR
     2428   :
     2429      CASE v-fr-type :
     2430         WHEN 100 THEN DO:
     2431            v-fr:Password          = 1.
     2432            v-fr:CheckSubTotal() NO-ERROR.
     2433            IF ERROR-STATUS:ERROR
     2434            OR v-fr:ResultCode <> 0
     2435            THEN DO:
     2436               ASSIGN
     2437                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     2438                                          , RETURN-VALUE
     2439                                          , ERROR-STATUS:GET-MESSAGE(1)
     2440                                          , v-fr:ResultCodeDescription
     2441                                          )
     2442               .
     2443               RETURN.
     2444            END.
     2445            ASSIGN
     2446               p-summ-total = v-fr:Summ1
     2447            .
     2448         END.
     2449         OTHERWISE DO:
     2450         END.
     2451      END CASE.
     2452      ASSIGN
     2453         p-ok = TRUE
     2454         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2455      .
     2456   END.
     2457   END PROCEDURE.
     2458   PROCEDURE fr-print-str :
     2459   define input parameter  p-string as character        no-undo.
     2460   define output parameter p-err-message as character        no-undo.
     2461   define output parameter p-ok          as logical          no-undo.
     2462   define variable v-string as character no-undo .
     2463   define variable v-return as integer   no-undo .
     2464   if v-fr-type = 200 then
     2465   do:
     2466     do
     2467     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2468     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2469     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2470     :
     2471        run OpenFDoc(output v-return) .
     2472        if v-return = 0 then
     2473        do:
     2474          run PrintOEMDoc(input p-string ,
     2475                              input length(p-string) ,
     2476                              output v-return )
     2477                              .
     2478          run CloseFDoc(output v-return) .
     2479        end .
     2480     end .
     2481     p-ok = yes .
     2482     return .
     2483   end.
     2484   IF VALID-HANDLE(v-fr)
     2485   THEN DO
     2486   ON ERROR UNDO, RETURN ERROR
     2487   :
     2488      CASE v-fr-type :
     2489         WHEN 100 THEN DO:
     2490            v-fr:GetECRStatus().
     2491            DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     2492               v-fr:GetECRStatus().
     2493            END.
     2494            v-fr:Password = 1.
     2495            v-fr:StringForPrinting = p-string.
     2496            v-fr:PrintString() NO-ERROR.
     2497            IF ERROR-STATUS:ERROR
     2498            OR v-fr:ResultCode <> 0
     2499            THEN DO:
     2500               ASSIGN
     2501                  p-err-message = SUBSTITUTE( "&1 &2 &3 &4"
     2502                                          , RETURN-VALUE
     2503                                          , ERROR-STATUS:GET-MESSAGE(1)
     2504                                          , v-fr:ResultCodeDescription
     2505                                          , v-fr:ResultCode
     2506                                          )
     2507               .
     2508               RETURN.
     2509            END.
     2510            v-fr:GetECRStatus().
     2511            DO WHILE (v-fr:ResultCode <> 0 OR v-fr:ECRAdvancedMode <> 0):
     2512               v-fr:GetECRStatus().
     2513            END.
     2514         END.
     2515         OTHERWISE DO:
     2516         END.
     2517      END CASE.
     2518      ASSIGN
     2519         p-ok = TRUE
     2520         p-err-message = IF v-fr:ResultCode <> 0 THEN v-fr:ResultCodeDescription ELSE ""
     2521      .
     2522   END.
     2523   END PROCEDURE.
     2524   PROCEDURE fr-wide-print-str :
     2525   define input parameter  p-string as character        no-undo.
     2526   define output parameter p-err-message as character        no-undo.
     2527   define output parameter p-ok          as logical          no-undo.
     2528   if v-fr-type = 200 then
     2529   do:
     2530     define variable v-return as integer   no-undo .
     2531     do
     2532     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2533     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     2534     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     2535     :
     2536        run OpenFDoc(output v-return) .
     2537        if v-return = 0 then
     2538        do:
     2539          run FontSelectFDoc(33,output v-return) .
     2540          run PrintOEMDoc(input p-string ,
     2541                              input length(p-string) ,
     2542                              output v-return )
     2543                              .
     2544          run FontSelectFDoc(1,output v-return) .
     2545          run CloseFDoc(output v-return) .
     2546        end .
     2547     end.
     2548     assign p-ok = yes .
     2549     return .
     2550   end.
     2551   IF VALID-HANDLE(v-fr)
     2552   THEN DO
