     3140               v-fr:Password        = 1
     3141            .
     3142            v-fr:OutputReceipt() NO-ERROR.
     3143            IF ERROR-STATUS:ERROR
     3144            OR v-fr:ResultCode <> 0
     3145            THEN DO:
     3146               ASSIGN
     3147                  p-err-message = SUBSTITUTE( "&1 &2 &3"
     3148                                          , RETURN-VALUE
     3149                                          , ERROR-STATUS:GET-MESSAGE(1)
     3150                                          , v-fr:ResultCodeDescription
     3151                                          )
     3152                  p-ok = FALSE
     3153               .
