     3643   procedure Fr-GetParamDoc :
     3644   define output parameter v-return       as integer   no-undo .
     3645   define output parameter v-res-current1 as character no-undo .
     3646   define output parameter v-res-current2 as character no-undo .
     3647   define variable v-param-i1 as integer   no-undo .
     3648   define variable v-param-i2 as integer   no-undo .
     3649    run GetParamDoc(output v-return) .
     3650    if v-return = 0 then
     3651    do:
     3652         run GetFldWord( 5, output v-param-i1) .
     3653         RUN ReadStatusCurrentNew(v-param-i1,
     3654                                           16,
     3655                         output v-res-current1 )
     3656            .
     3657         run GetFldWord( 6, output v-param-i2) .
     3658          RUN ReadStatusCurrentNew(v-param-i2 ,
     3659                                           16 ,
     3660                         output v-res-current2 )
     3661                         .
     3662    end .
     3663   end procedure .
     3664   procedure Fr-GetMony :
     3665     define input  parameter p-num-Par    as integer   no-undo.
     3666     define input  parameter p-length-par as integer   no-undo .
     3667     define output parameter p-CashMony   as deci   no-undo .
     3668     def var v-mony-c as char no-undo .
     3669     define variable v-return as integer   no-undo .
     3670     run GetMony (output v-return) .
     3671     if v-return = 0  then
     3672     do :
     3673        Run Fr-Answer(p-num-par,
     3674                      p-length-par ,
     3675               output v-mony-c)
     3676               .
     3677        p-Cashmony = deci( v-mony-c)
     3678         .
     3679     end .
     3680   end procedure .
     3681   procedure Fr-GetNumbers:
     3682   define output parameter p-num-chek as integer   no-undo .
     3683   define output parameter p-num-doc  as integer   no-undo .
     3684   define output parameter p-return   as integer   no-undo .
     3685   do
     3686   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3687   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3688   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3689   :
     3690     run GetNumbers(output p-return).
     3691     if p-return = 0 then
     3692     do:
     3693         run GetFldWord( 5, output p-num-doc ) .
     3694         run GetFldWord( 6, output p-num-chek ) .
     3695     end.
     3696   end.
     3697   end procedure .
     3698   procedure Fr-ReadCMOS:
     3699   def input  parameter v-offs   as int no-undo .
     3700   def input  parameter v-num    as int no-undo .
     3701   def output parameter v-operator as char no-undo .
     3702   def output parameter v-return as int no-undo .
     3703   def var v-Flds-Count as int no-undo .
     3704   def var v-i as int no-undo .
     3705   run ReadCMOS( input v-offs ,
     3706                 input v-num ,
     3707                 output v-return ) .
     3708   if v-return = 0 then
     3709   do:
     3710       run GetFldsCount(output v-flds-Count) .
     3711       do v-i = 5 to v-flds-Count :
     3712         run GetFldByte( v-i , output v-return ) .
     3713         if v-return = 0 then leave .
     3714         v-operator = v-operator + chr(v-return,Session:charset,'ibm866') .
     3715       end.
     3716   end.
     3717   end procedure .
     3718   procedure Fr-Answer:
     3719   def input parameter  p-num    as int no-undo .
     3720   def input parameter  p-length as int no-undo .
     3721   def output parameter p-answer as char no-undo .
     3722   def var v-Flds-Count as int no-undo .
     3723   def var v-responce  as memptr no-undo .
     3724   def var v-creturn   as char   no-undo .
     3725       run GetFldsCount(output v-flds-Count) .
     3726       set-size(v-responce ) = p-length .
     3727       run GetFldStr(input v-flds-Count - p-num ,
     3728        output v-responce ,
     3729        output v-creturn ) .
     3730       p-answer = get-string(v-responce,1) .
     3731       set-size(v-responce) = 0 .
     3732   end procedure .
     3733   procedure Fr-Answer-i :
     3734   def input parameter  p-num    as int no-undo .
     3735   def output parameter p-answer as int  no-undo .
     3736   def var v-Flds-Count as int no-undo .
     3737       run GetFldsCount(output v-flds-Count) .
     3738       run GetFldWord(input v-flds-Count - p-num ,
     3739        output p-answer) .
     3740   end procedure .
     3741   Procedure Fr-ErrorMessage :
     3742   def output parameter p-err-message as char no-undo .
     3743   define variable  v-return    as integer no-undo .
     3744   define variable  v-responce  as memptr  no-undo .
     3745   define variable  v-creturn   as char    no-undo .
     3746   define variable  v-c-Responce as char   no-undo .
     3747   run GetLastDllError(output v-return) .
     3748   set-size(v-Responce) = 120 .
     3749   run GetErrorMessage(output v-Responce , output v-creturn ) .
     3750   v-c-Responce = get-string(v-Responce , 1) .
     3751   set-size(v-Responce) = 0 .
     3752   p-err-message = string(v-return) + " - " + v-c-Responce .
     3753   end procedure.
     3754   procedure Fr-Error:
     3755   def var v-proc     as char no-undo .
     3756   def var v-int-proc as char no-undo .
     3757   def var v-ext-proc as char no-undo .
     3758   def var v-Responce as memptr no-undo.
     3759   def var v-creturn as char no-undo.
     3760   def var v-return as int no-undo.
     3761   def var v-Answer as char no-undo .
     3762   def var v-c-Responce as char no-undo.
     3763   v-proc = program-name(2) .
     3764   if index(v-proc,' ') > 0 then
     3765   do :
     3766     v-int-proc = trim(substr(v-proc ,1 , index(v-proc,' '))) .
     3767     v-ext-proc = substr(v-proc , index(v-proc,' ') + 1) .
     3768   end .
     3769   else
     3770   do:
     3771     assign v-int-proc = ''
     3772            v-ext-proc = v-proc .
     3773   end .
     3774      run GetLastDllError(output v-return) .
     3775      set-size(v-Responce) = 120.
     3776      run GetErrorMessage(output v-Responce ,output v-creturn).
     3777      v-c-Responce = get-string(v-Responce,1).
     3778      set-size(v-Responce) = 0.
     3779      if v-int-proc = '' then
     3780        message "           процедура" v-ext-proc skip
     3781            'v-return = ' v-return skip
     3782             'v-c-responce = ' v-c-responce
     3783              view-as alert-box .
     3784      else
     3785        message "Внутренняя процедура" v-int-proc skip
     3786              "           процедура" v-ext-proc skip
     3787                'v-return = ' v-return skip
     3788                'v-c-responce = ' v-c-responce
     3789                view-as alert-box .
     3790   end procedure.
     3791   procedure Fr-SetDate:
     3792   def output parameter v-return as int no-undo .
     3793   def var v-Responce as memptr no-undo.
     3794   def var v-creturn as char no-undo.
     3795   def var     ctime as char no-undo .
     3796   def var v-Answer as char no-undo .
     3797   def var v-lenmsg as int  no-undo .
     3798     run SetDate(output v-return) .
     3799     if v-return = 0 then
     3800     do:
     3801       set-size(v-Responce) = 120.
     3802       run GetCommand(output v-Responce ,output v-creturn).
     3803       v-Answer = get-string(v-Responce,1).
     3804       ctime = string(time,"HH:MM:SS" ) .
     3805       ctime = substr(ctime,1,2) + substr(ctime,4,2) .
     3806       v-Answer = substr(v-answer,1,16) + ctime  .
     3807       v-lenmsg = length(v-answer) .
     3808       put-string(v-responce,1) = v-Answer .
     3809       run DllComWritePlus(input v-Responce,input v-lenmsg,output v-return) .
     3810     end .
     3811   end procedure .
     3812   procedure Fr-GetStatusCurrent:
     3813     def output parameter v-res-const    as char no-undo .
     3814     def output parameter v-res-current  as char no-undo .
     3815     def output parameter v-return       as int no-undo .
     3816     DEF VAR v-status-const AS INT NO-UNDO .
     3817     DEF VAR v-status-curr  AS INT NO-UNDO .
     3818     run GetStatus(output v-return) .
     3819     if v-return = 0 then
     3820     do :
     3821       RUN GetFldByte(1 , OUTPUT v-status-const) .
     3822       RUN ReadStatusCurrent(v-status-const,
     3823                                             8,
     3824                         output v-res-const)
     3825                         .
     3826       RUN GetFldWord(2 , OUTPUT v-status-curr ) .
     3827       RUN ReadStatusCurrent(v-status-curr,
     3828                                           16,
     3829                         output v-res-current )
     3830                             .
     3831       run CheckStatusNum(2, 2, output v-return) .
     3832       v-res-const = v-res-const + string(v-return) .
     3833       run CheckStatusNum(3, 2, output v-return) .
     3834       v-res-const = v-res-const + string(v-return) .
     3835       run CheckStatusNum(3, 5, output v-return) .
     3836       v-res-const = v-res-const + string(v-return) .
     3837       run CheckStatusNum(5, 3, output v-return) .
     3838       v-res-const = v-res-const + string(v-return) .
     3839     end.
     3840   end procedure .
     3841   procedure Fr-SetParamDoc:
     3842     define input  parameter p-clear-cash-counter as character no-undo .
     3843     def input parameter     p-cutter              as char      no-undo .
     3844     def var v-res-current1 as char no-undo .
     3845     def var v-res-current2 as char no-undo .
     3846     def var v-param-i1     as int no-undo .
     3847     def var v-param-i2     as int no-undo .
     3848     def var v-return       as int  no-undo .
     3849     def var v-res-current3 as char no-undo .
     3850     define variable v-i as integer   no-undo .
     3851     Run Fr-ParamDoc(output v-param-i1,
     3852                     output v-param-i2,
     3853                     output v-return ).
     3854     if v-return = 0 then
     3855     do:
     3856           RUN ReadStatusCurrent(v-param-i1,
     3857                                           16,
     3858                         output v-res-current1 )
     3859                         .
     3860           RUN ReadStatusCurrent(v-param-i2,
     3861                                           16,
     3862                         output v-res-current2 )
     3863                         .
     3864           v-res-current2 = substr(v-res-current2,1,10) + p-cutter +
     3865                            substr(v-res-current2,12,4) + p-clear-cash-counter .
     3866           do v-i = 1 to 16:
     3867             v-res-current3 = v-res-current3 + substr(v-res-current2,
     3868                                                      16 - (v-i - 1),1)
     3869                                                      .
     3870           end.
     3871           RUN WriteStatusCurrent(v-res-current3,
     3872                                           16,
     3873                         output v-param-i2 )
     3874                         .
     3875           run SetParamDoc(input v-param-i1,
     3876                           input v-param-i2,
     3877                           input 15 ,
     3878                           output v-return) .
     3879     end.
     3880   end procedure .
     3881   procedure Fr-ParamDoc:
     3882    def output parameter v-param-i1 as int no-undo .
     3883    def output parameter v-param-i2 as int no-undo .
     3884    def output parameter v-return   as int    no-undo .
     3885    def var v-flds-Count as int  no-undo .
     3886    run GetParamDoc(output v-return) .
     3887    if v-return = 0 then
     3888    do:
     3889       run GetFldsCount(output v-flds-Count) .
     3890       if v-flds-Count > 6 then
     3891       do:
     3892         run GetFldWord( 5, output v-param-i1) .
     3893            .
     3894         run GetFldWord( 6, output v-param-i2) .
     3895                         .
     3896       end.
     3897    end .
     3898   end procedure .
     3899   procedure Fr-Prim08ECRStatus:
     3900    def output parameter p-fr-mode     as int  no-undo .
     3901    def output parameter p-err-message as char no-undo .
     3902   def var v-status-const   as char no-undo .
     3903   def var v-status-current as char no-undo .
     3904   def var v-return         as int  no-undo .
     3905   run Fr-GetStatusCurrent(output v-status-const ,
     3906                           output v-status-current ,
     3907                           output v-return )
     3908                           .
     3909   if substr(v-status-const,5,4) = '1000' then
     3910   do:
     3911      assign
     3912         p-fr-mode = 0 .
     3913   end.
     3914   if substr(v-status-const,1,1) = '0' then
     3915   do:
     3916     assign
     3917     p-err-message = "ККМ не присвоен серийный номер" .
     3918   end.
     3919   if substr(v-status-const,2,1) = '1' then
     3920   do:
     3921     assign
     3922     p-err-message = "Количество перерегистраций исчерпано"
     3923     p-fr-mode = 5.
     3924   end.
     3925   if substr(v-status-const,3,1) = '1' then
     3926   do:
     3927     assign
     3928     p-err-message = "Фискальная память исчерпана "
     3929     p-fr-mode = 5.
     3930   end.
     3931   if substr(v-status-const,4,1) = '1' then
     3932   do:
     3933     p-err-message = "Осталось менее 30 закрытий смен"  .
     3934   end.
     3935   if p-fr-mode = 0 then
     3936   do:
     3937      if substr(v-status-current,5,1) = '0' then
     3938      do:
     3939         p-fr-mode = 4.
     3940      end.
     3941      if substr(v-status-current,10,1) = '1' then
     3942      do:
     3943         p-fr-mode = 9.
     3944      end.
     3945      if substr(v-status-current,5,1) = '0' then
     3946      do:
     3947         p-fr-mode = 3.
     3948      end.
     3949      else
     3950      do:
     3951        p-fr-mode = 2.
     3952      end.
     3953      if substr(v-status-current,14,3) <> '000' and substr(v-status-current,14,3) <> '' then
     3954      do:
     3955         p-fr-mode = 8.
     3956      end.
     3957   end.
     3958   end procedure .
     3959   PROCEDURE WriteStatusCurrent :
     3960   def input  parameter p-res as char .
     3961   def input  parameter p-length-param as int  no-undo .
     3962   def output parameter p-param-i1       as int no-undo .
     3963   def var v-i as int no-undo .
     3964   def var v-par-bit1 as int no-undo .
     3965         do v-i = 1 to p-length-param :
     3966           v-par-bit1 = int(substr(p-res,v-i,1)) .
     3967           put-bits(p-param-i1,v-i,1) = v-par-bit1.
     3968         end.
     3969   END PROCEDURE.
     3970   procedure ReadStatusCurrent:
     3971   def input parameter p-param-i1     as int no-undo .
     3972   def input parameter p-length-param as int no-undo .
     3973   def output parameter v-cres        as char no-undo .
     3974   def var v-i as int no-undo .
     3975   def var v-par-bit1 as int no-undo .
     3976         do v-i = 1 to p-length-param:
     3977           v-par-bit1 = get-bits(p-param-i1,v-i,1) .
     3978           v-cres = string(v-par-bit1) + v-cres .
     3979         end.
     3980   end procedure.
