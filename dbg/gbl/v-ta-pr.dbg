      648   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      649   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      650   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   on help of frame Dialog-Frame
      652   do:
      653     run gbl/app_help.p
      654       (input this-procedure :file-name
      655       ,input ''
      656       ,input ?
      657       ) no-error.
      658     if error-status :error then do:
      659       message
      660         "Ошибка при вызове помощи"
      661         error-status :get-message(1)
      662         view-as alert-box .
      663     end.
      664   end.
      665   run minbtn-set in this-procedure .
      666   on choose of b-help in frame Dialog-Frame
      667   do:
      668     apply "help":u to frame Dialog-Frame .
      669   end.
      670   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   procedure minbtn-set :
      672       do
      673           on error undo, return error return-value
      674           :
      675           define variable ii              as integer       no-undo .
      676           define variable fh              as widget-handle no-undo .
      677           define variable hh              as widget-handle no-undo .
      678           define variable v-h             as handle        extent 4 no-undo .
      679           define variable v-name-button   as character     no-undo .
      680           define variable v-help-old-x    as decimal       no-undo .
      681           define variable v-help-old-y    as decimal       no-undo .
      682           define variable v-help-old-size as decimal       no-undo .
      683           define variable v-frame-width   as decimal       no-undo .
      684           define variable jj              as integer       no-undo .
      685           do
      686               on error undo, return error
      687               :
      688               assign
      689                   v-frame-width = frame Dialog-Frame:width - 0.3
      690                   fh            = frame Dialog-Frame:first-child
      691                   hh            = fh:first-child
      692                   ii            = 1
      693                   .
      694               do while valid-handle(hh):
      695                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      696                   do:
      697                       case lc(hh:name) :
      698                           when "b-help" then
      699                               do:
      700                                   hh:load-image-up("cmp/b-help.bmp":u) .
      701                                   hh:load-image-down("cmp/b-help.bmp":u) .
      702                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      703                                   hh:TOOLTIP = "Помощь" .
      704                                   v-help-old-x = hh:column .
      705                                   v-help-old-y = hh:row    .
      706                                   v-help-old-size = hh:width .
      707                                   hh:width-chars = 2.5 .
      708                               end.
      709                           when "b-print" then
      710                               do:
      711                                   hh:load-image("cmp/b-print.bmp":u) .
      712                                   hh:TOOLTIP = "Печать" .
      713                                   v-h[ii] = hh:handle .
      714                                   ii = ii + 1 .
      715                                   hh:width-chars = 3 .
      716                               end.
      717                           when "b-history" or
      718                           when "b-hist" then
      719                               do:
      720                                   hh:load-image("cmp/b-hist.bmp":u) .
      721                                   hh:TOOLTIP = "История" .
      722                                   v-h[ii] = hh:handle .
      723                                   ii = ii + 1 .
      724                                   hh:width-chars = 3 .
      725                               end.
      726                           when "b-sch" then
      727                               do:
      728                                   hh:load-image("cmp/b-sch.bmp":u) .
      729                                   hh:TOOLTIP = "Установка Фильтра" .
      730                                   v-h[ii] = hh:handle .
      731                                   ii = ii + 1 .
      732                                   hh:width-chars = 3 .
      733                               end.
      734                           when "b-hist-user" then
      735                               do:
      736                                   hh:load-image("cmp/b-hist.bmp":u) .
      737                                   hh:TOOLTIP = "История пользователя" .
      738                                   ii = ii + 1 .
      739                               end.
      740                       end case.
      741                   end.
      742                   hh = hh:next-sibling.
      743               end.
      744               b-help:column = v-frame-width - b-help:width-chars.
      745               jj = 0.
      746               repeat ii = 4 to 1 by -1 :
      747                   if valid-handle (v-h[ii] ) then
      748                   do:
      749                       jj  = jj + 1 .
      750                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      751                       v-h[ii]:row    = v-help-old-y .
      752                   end.
      753               end.
      754           end.
      755       end.
      756   end procedure.
      757   MAIN-BLOCK:
      758   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      759      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      760     run init-tt in this-procedure .
      761     run enable_ui in this-procedure .
      762     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      763        disable
      764        pr-calc-cost
      765        pr-calc-cost-gr
      766        pr-calc-cost-novat
      767        pr-calc-cost-novat-gr
      768        pr-calc-costobj
      769        pr-calc-cost-wbill
      770        pr-calc-cost-wbill-novat
      771        pr-calc-fix
      772        pr-calc-goods
      773        pr-calc-grp
      774        pr-calc-last
      775        pr-calc-last-gr
      776        pr-calc-lastobj
      777        pr-calc-new
      778        pr-calc-no
      779        pr-calc-obj
      780        pr-calc-old
      781        pr-calc-old-novat
      782        pr-calc-ov
      783        pr-calc-pdf
      784        pr-calc-rsrv
      785        pr-calc-rsrv-gr
      786        pr-calc-slt
      787        pr-calc-slt-wbill
      788        pr-calc-wbill
      789        pr-calc-wbill-novat
      790        pr-common
      791        pr-calc-prod
      792        pr-calc-prod-vat
      793        pr-calc-level-prod
      794        pr-calc-level-prod-vat
      795        pr-calc-specif
      796        with frame Dialog-Frame.
      797        B-ok:label = "Вы&ход"  .
      798        hide B-cancel in frame Dialog-Frame .
      799     end.
      800     WAIT-FOR GO OF FRAME Dialog-Frame.
      801   END.
      802   RUN disable_UI.
      803   PROCEDURE disable_UI :
      804     HIDE FRAME Dialog-Frame.
      805   END PROCEDURE.
      806   PROCEDURE enable_UI :
      807     DISPLAY pr-calc-goods pr-calc-slt pr-calc-grp pr-calc-slt-wbill pr-calc-cost
      808             pr-calc-cost-gr pr-calc-costobj pr-calc-rsrv-gr pr-calc-rsrv
      809             pr-calc-last-gr pr-calc-last pr-calc-cost-novat-gr pr-calc-lastobj
      810             pr-common pr-calc-old pr-calc-prod pr-calc-new pr-calc-prod-vat
      811             pr-calc-obj pr-calc-no pr-calc-wbill pr-calc-fix pr-calc-wbill-novat
      812             pr-calc-level-prod pr-calc-cost-novat pr-calc-level-prod-VAT
      813             pr-calc-old-novat pr-calc-specif pr-calc-ov pr-calc-pdf
      814             pr-calc-cost-wbill pr-calc-cost-wbill-novat
      815         WITH FRAME Dialog-Frame.
      816     ENABLE B-ok B-cancel B-Help I-pr-calc-goods I-pr-calc-grp I-pr-calc-cost
      817            I-pr-calc-costobj I-pr-calc-rsrv I-pr-calc-last I-pr-calc-lastobj
      818            I-pr-calc-old I-pr-calc-new I-pr-calc-obj I-pr-calc-wbill
      819            I-pr-calc-wbill-novat I-pr-calc-cost-novat I-pr-calc-old-novat
      820            I-pr-calc-ov I-pr-calc-pdf I-pr-calc-cost-wbill
      821            I-pr-calc-cost-wbill-novat I-pr-calc-slt I-pr-calc-slt-wbill
      822            I-pr-calc-cost-gr I-pr-calc-rsrv-gr I-pr-calc-last-gr
      823            I-pr-calc-novat-gr I-pr-common I-pr-calc-no I-pr-calc-fix
      824            I-pr-calc-prod I-pr-calc-prod-vat I-pr-calc-level-prod
      825            I-pr-calc-level-prod-VAT I-pr-calc-specif pr-calc-goods pr-calc-slt
      826            pr-calc-grp pr-calc-slt-wbill pr-calc-cost pr-calc-cost-gr
      827            pr-calc-costobj pr-calc-rsrv-gr pr-calc-rsrv pr-calc-last-gr
      828            pr-calc-last pr-calc-cost-novat-gr pr-calc-lastobj pr-common
      829            pr-calc-old pr-calc-prod pr-calc-new pr-calc-prod-vat pr-calc-obj
      830            pr-calc-no pr-calc-wbill pr-calc-fix pr-calc-wbill-novat
      831            pr-calc-level-prod pr-calc-cost-novat pr-calc-level-prod-VAT
      832            pr-calc-old-novat pr-calc-specif pr-calc-ov pr-calc-pdf
      833            pr-calc-cost-wbill pr-calc-cost-wbill-novat
      834         WITH FRAME Dialog-Frame.
      835     VIEW FRAME Dialog-Frame.
      836   END PROCEDURE.
      837   PROCEDURE init-tt :
      838   if lookup ('Учетная':U,p-list ) > 0 then             pr-calc-cost               = true .
      839   if lookup ('УчетнаяS':U,p-list ) > 0 then          pr-calc-cost-gr            = true .
      840   if lookup ('Учет-безНДС':U,p-list ) > 0 then       pr-calc-cost-novat         = true .
      841   if lookup ('Учет-НДСS':U,p-list ) > 0 then    pr-calc-cost-novat-gr      = true .
      842   if lookup ('Учет-объект':U,p-list ) > 0 then          pr-calc-costobj            = true .
      843   if lookup ('Учет+накл':U,p-list ) > 0 then       pr-calc-cost-wbill         = true .
      844   if lookup ('Уч+накл-НДС':U,p-list ) > 0 then pr-calc-cost-wbill-novat   = true .
      845   if lookup ('Не-считать':U,p-list ) > 0 then              pr-calc-fix                = true .
      846   if lookup ('Товар':U,p-list ) > 0 then            pr-calc-goods              = true .
      847   if lookup ('Группа':U,p-list ) > 0 then              pr-calc-grp                = true .
      848   if lookup ('Приходная':U,p-list ) > 0 then             pr-calc-last               = true .
      849   if lookup ('ПриходнаяS':U,p-list ) > 0 then          pr-calc-last-gr            = true .
      850   if lookup ('Прих-объект':U,p-list ) > 0 then          pr-calc-lastobj            = true .
      851   if lookup ('Новая':U,p-list ) > 0 then              pr-calc-new                = true .
      852   if lookup ('Отсутствует':U,p-list ) > 0 then               pr-calc-no                 = true .
      853   if lookup ('Объект':U,p-list ) > 0 then              pr-calc-obj                = true .
      854   if lookup ('Старая':U,p-list ) > 0 then              pr-calc-old                = true .
      855   if lookup ('Стар-безНДС':U,p-list ) > 0 then        pr-calc-old-novat          = true .
      856   if lookup ('Переоценка':U,p-list ) > 0 then               pr-calc-ov                 = true .
      857   if lookup ('ДокФормЦены':U,p-list ) > 0 then              pr-calc-pdf                = true .
      858   if lookup ('Учет-резерв':U,p-list ) > 0 then             pr-calc-rsrv               = true .
      859   if lookup ('Учет-рзрвS':U,p-list ) > 0 then          pr-calc-rsrv-gr            = true .
      860   if lookup ('НсП':U,p-list ) > 0 then              pr-calc-slt                = true .
      861   if lookup ('НсП+накл':U,p-list ) > 0 then        pr-calc-slt-wbill          = true .
      862   if lookup ('Накладная':U,p-list ) > 0 then            pr-calc-wbill              = true .
      863   if lookup ('Накл-безНДС':U,p-list ) > 0 then      pr-calc-wbill-novat        = true .
      864   if lookup ('Единая':U,p-list ) > 0 then                pr-common                  = true .
      865   if lookup ('Производит':U,p-list ) > 0 then             pr-calc-prod               = true .
      866   if lookup ('Произв-НДС':U,p-list ) > 0 THEN         pr-calc-prod-vat           = true .
      867   if lookup ('ПорогПр-НДС':U,p-list ) > 0 THEN       pr-calc-level-prod         = true .
      868   if lookup ('ПорогПр+НДС':U,p-list ) > 0 THEN   pr-calc-level-prod-vat     = true .
      869   if lookup ('Спецификация':U,p-list ) > 0 THEN           pr-calc-specif             = true .
      870   END PROCEDURE.
