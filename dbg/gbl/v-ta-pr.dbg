      484         .
      485   p-list = "".
      486   if pr-calc-cost               = true  then p-list = p-list + 'Учетная':U             + ","  .
      487   if pr-calc-cost-gr            = true  then p-list = p-list + 'УчетнаяS':U          + ","  .
      488   if pr-calc-cost-novat         = true  then p-list = p-list + 'Учет-безНДС':U       + ","  .
      489   if pr-calc-cost-novat-gr      = true  then p-list = p-list + 'Учет-НДСS':U    + ","  .
      490   if pr-calc-costobj            = true  then p-list = p-list + 'Учет-объект':U          + ","  .
      491   if pr-calc-cost-wbill         = true  then p-list = p-list + 'Учет+накл':U       + ","  .
      492   if pr-calc-cost-wbill-novat   = true  then p-list = p-list + 'Уч+накл-НДС':U + ","  .
      493   if pr-calc-fix                = true  then p-list = p-list + 'Не-считать':U              + ","  .
      494   if pr-calc-goods              = true  then p-list = p-list + 'Товар':U            + ","  .
      495   if pr-calc-grp                = true  then p-list = p-list + 'Группа':U              + ","  .
      496   if pr-calc-last               = true  then p-list = p-list + 'Приходная':U             + ","  .
      497   if pr-calc-last-gr            = true  then p-list = p-list + 'ПриходнаяS':U          + ","  .
      498   if pr-calc-lastobj            = true  then p-list = p-list + 'Прих-объект':U          + ","  .
      499   if pr-calc-new                = true  then p-list = p-list + 'Новая':U              + ","  .
      500   if pr-calc-no                 = true  then p-list = p-list + 'Отсутствует':U               + ","  .
      501   if pr-calc-obj                = true  then p-list = p-list + 'Объект':U              + ","  .
      502   if pr-calc-old                = true  then p-list = p-list + 'Старая':U              + ","  .
      503   if pr-calc-old-novat          = true  then p-list = p-list + 'Стар-безНДС':U        + ","  .
      504   if pr-calc-ov                 = true  then p-list = p-list + 'Переоценка':U               + ","  .
      505   if pr-calc-pdf                = true  then p-list = p-list + 'ДокФормЦены':U              + ","  .
      506   if pr-calc-rsrv               = true  then p-list = p-list + 'Учет-резерв':U             + ","  .
      507   if pr-calc-rsrv-gr            = true  then p-list = p-list + 'Учет-рзрвS':U          + ","  .
      508   if pr-calc-slt                = true  then p-list = p-list + 'НсП':U              + ","  .
      509   if pr-calc-slt-wbill          = true  then p-list = p-list + 'НсП+накл':U        + ","  .
      510   if pr-calc-wbill              = true  then p-list = p-list + 'Накладная':U            + ","  .
      511   if pr-calc-wbill-novat        = true  then p-list = p-list + 'Накл-безНДС':U      + ","  .
      512   if pr-common                  = true  then p-list = p-list + 'Единая':U                + ","  .
      513   if pr-calc-prod               = true  then p-list = p-list + 'Производит':U             + ","  .
      514   if pr-calc-prod-vat           = true  then p-list = p-list + 'Произв-НДС':U         + ","  .
      515   if pr-calc-level-prod         = true  then p-list = p-list + 'ПорогПр-НДС':U       + ","  .
      516   if pr-calc-level-prod-vat     = true  then p-list = p-list + 'ПорогПр+НДС':U   + ","  .
      517   if pr-calc-specif             = true  then p-list = p-list + 'Спецификация':U           + ","  .
      518   p-list = trim (p-list ,",") .
      519   END.
