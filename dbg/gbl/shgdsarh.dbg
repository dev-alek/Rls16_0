        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-gds-code as integer   no-undo .
        4   define input  parameter p-obj-type as character no-undo .
        5   define input  parameter p-obj-code as integer   no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile: shgdsarh.p $":U .
       10   define variable vss-archive     as character no-undo initial "$Archive: gbl/shgdsarh.p $":U .
       11   define variable vss-description as character no-undo initial "Показать складской архив по товару на объекте".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define new shared temp-table tt-goods no-undo like ub.goods.
       92   define new shared temp-table tt-clients no-undo like ub.clients.
       93   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   procedure local-gds_inf :
       95     for each tt-goods
       96     :
       97       delete tt-goods.
       98     end.
       99     for each tt-clients
      100     :
      101       delete tt-clients.
      102     end.
      103     create tt-goods.
      104     buffer-copy ub.goods to tt-goods.
      105     create tt-clients.
      106     assign
      107       tt-clients.obj-type = p-obj-type
      108       tt-clients.obj-code = p-obj-code
      109     .
      110     define variable v-ok as logical   no-undo .
      111     define variable v-chk-act-host-code as integer   no-undo .
      112   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      114     (input  tt-clients.obj-type
      115     ,input  tt-clients.obj-code
      116     ,output v-chk-act-host-code
      117     )  .
      118   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   do:
      120     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      121       (input  v-cntxt-db-num
      122       ,input  v-cntxt-userid
      123       ,input  0
      124       ,input  'actn_reference_archive':U
      125       ,input  'firm':U
      126       ,input  v-chk-act-host-code
      127       ,input  '':U
      128       ,input  0
      129       ,input  0
      130       ,input  0
      131       ,input  0
      132       ,input  true
      133       ,output v-ok
      134       )  .
      135   end.
      136     if v-ok then do:
      137       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
      138     end.
      139   end procedure.
      140   do
      141   on error undo, return error return-value
      142   :
      143   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144     run mainmenu_getcntxt in parparentproc
      145       (output v-cntxt-db-num
      146       ,output v-cntxt-userid
      147       ,output v-cntxt-level
      148       ,output v-cntxt-host-code-obj
      149       ,output v-cntxt-obj-type
      150       ,output v-cntxt-obj-code
      151       ,output v-cntxt-db-num-obj
      152       ,output v-cntxt-is-admin
      153       ) .
      154     find first ub.goods no-lock
      155       where ub.goods.gds-code = p-gds-code
      156       .
      157     run local-gds_inf in this-procedure .
      158   end.
