        1   block-level on error undo, throw.
        2   define input  parameter p-parparentproc as handle    no-undo .
        3   define input  parameter p-message       as longchar  no-undo .
        4   define output parameter p-out-message   as longchar  no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: mtreq12.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq12.p $":U .
       10   define variable vss-description as character no-undo init "Авторизация пользователя МТ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   do
       70   on error undo, return error return-value
       71   :
       72       define buffer buf_user-login for ub.user-login.
       73       define variable v-sendmemptr  as memptr   no-undo .
       74       define variable v-sendstr     as longchar no-undo .
       75       define variable hdocument as handle    no-undo .
       76       define variable hroot     as handle    no-undo .
       77       define variable hchild    as handle    no-undo .
       78       define variable htext     as handle    no-undo .
       79       define variable icounter        as integer   no-undo .
       80       define variable v-userlogin     as character no-undo .
       81       define variable v-userpassword  as character no-undo .
       82       create x-document hdocument.
       83       create x-noderef hroot.
       84       create x-noderef hchild.
       85       create x-noderef htext.
       86       hDocument:load( "LONGCHAR", p-message, no ) NO-ERROR.
       87       hDocument:get-document-element( hRoot ).
       88       assign
       89         v-userlogin     = ?
       90         v-userpassword  = ?
       91       .
       92       repeat iCounter = 1 to hRoot:num-children
       93       :
       94           hRoot:get-child(hChild,iCounter).
       95           if hChild:subtype <> 'ELEMENT' or hChild:num-children = 0 then next.
       96           if hChild:NAME = "user"
       97           then do:
       98             hChild:get-child( hText ,1 ).
       99             assign
      100               v-userlogin = trim(hText:NODE-VALUE)
      101             .
      102           end.
      103           if hChild:NAME = "password"
      104           then do:
      105             hChild:get-child( hText ,1 ).
      106             assign
      107               v-userpassword = trim(hText:NODE-VALUE)
      108             .
      109           end.
      110       end.
      111       delete object hdocument .
      112       delete object hroot     .
      113       delete object hchild    .
      114       delete object htext     .
      115       assign
      116         hdocument = ?
      117         hroot     = ?
      118         hchild    = ?
      119         htext     = ?
      120       .
      121       if v-userlogin <> ? and v-userpassword <> ?
      122       then do:
      123         define variable v-ok as integer no-undo.
      124         define variable v-err-message as character no-undo.
      125         find first buf_user-login no-lock
      126           where buf_user-login.user-login = v-userlogin
      127         no-error .
      128         if available buf_user-login
      129         then do:
      130           assign
      131             v-ok = 0
      132           .
      133         end.
      134         else do:
      135             assign
      136                 v-ok = 1
      137                 v-err-message = substitute( "Не найден пользователь &1", v-userlogin)
      138             .
      139         end.
      140       end.
      141       create x-document hdocument.
      142       create x-noderef hroot.
      143       create x-noderef hchild.
      144       create x-noderef htext.
      145       hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
      146       hdocument:APPEND-CHILD(hRoot).
      147       hdocument:create-node(hChild, "stts", "ELEMENT").
      148       hRoot:append-child(hChild).
      149       hdocument:create-node(hText, "", "TEXT").
      150       hChild:append-child(hText).
      151       hText:node-value = substitute( "&1" , v-ok).
      152       hdocument:create-node(hChild, "errmsg", "ELEMENT").
      153       hRoot:append-child(hChild).
      154       hdocument:create-node(hText, "", "TEXT").
      155       hChild:append-child(hText).
      156       hText:node-value = v-err-message .
      157       hdocument:save("LONGCHAR", p-out-message).
      158       delete object hdocument .
      159       delete object hroot     .
      160       delete object hchild    .
      161       delete object htext     .
      162       assign
      163         hdocument = ?
      164         hroot     = ?
      165         hchild    = ?
      166         htext     = ?
      167       .
      168   end.
