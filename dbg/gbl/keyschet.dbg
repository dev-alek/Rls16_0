        1   block-level on error undo, throw.
        2   define input parameter p-schet as character no-undo .
        3   define input parameter p-bik as character no-undo .
        4   define input parameter p-curr-code like ub.currency.curr-code no-undo .
        5   define input parameter p-is-credit as logical no-undo .
        6   define output parameter p-correct as logical no-undo .
        7   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   def var vss-author      as character no-undo init "$Author: expertek $":U .
        9   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   def var vss-workfile    as character no-undo init "$Workfile: keyschet.p $":U .
       11   def var vss-archive     as character no-undo init "$Archive: gbl/keyschet.p $":U .
       12   def var vss-description as character no-undo init "Проверка валидности номера лицевого счета".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define variable v-key as character no-undo .
       68   define variable v-key-check as character no-undo .
       69   define variable kc as integer no-undo .
       70   define variable kc-check as integer no-undo .
       71   define variable v-int as integer no-undo .
       72   define variable v-dop as character no-undo .
       73   define variable v-dopi as integer no-undo .
       74   define buffer buf_currency for ub.currency.
       75   function sum-ml-razr returns integer(INPUT p-key as character):
       76   define variable v-sum-ml-razr as integer no-undo .
       77   define variable v-ves-coeff as integer no-undo .
       78   define variable ii as integer no-undo .
       79   define variable v-razr-value as integer no-undo extent 23.
       80   do ii = 1 to length(p-key):
       81     CASE  ii modulo 3:
       82       when 1 then assign
       83       v-ves-coeff = 7.
       84       when 2 then assign
       85       v-ves-coeff = 1.
       86       when 0 then assign
       87       v-ves-coeff = 3.
       88     END CASE.
       89     assign
       90     v-razr-value[ii] = integer(substr(p-key, ii, 1)) * v-ves-coeff
       91     no-error
       92     .
       93     if error-status:error then return ?.
       94     assign
       95     v-sum-ml-razr = v-sum-ml-razr + (v-razr-value[ii] modulo 10)
       96     .
       97   end.
       98   return v-sum-ml-razr.
       99   END FUNCTION.
      100   if length(p-schet) <> 20 then do:
      101     return substitute("Неверная длина номера счета &1 (должна быть 20)", length(p-schet)).
      102   end.
      103   find first buf_currency no-lock where
      104           buf_currency.curr-code = p-curr-code no-error.
      105   if available buf_currency
      106   and buf_currency.okv-code <> 0 then do:
      107     assign
      108     v-dopi = integer(substring(p-schet, 6, 3))
      109     no-error .
      110     if error-status:error  or (v-dopi <> buf_currency.okv-code and not (v-dopi = 810 and buf_currency.okv-code = 643)  ) then do:
      111       return substitute("Несоответствие счета коду валюты по ОКВ: код валюты: &1, код валюты по ОКВ &2, соответствующие символы в счете -(позиции 6-8): &3"
      112                        , p-curr-code
      113                        , buf_currency.okv-code
      114                        , substring(p-schet, 6, 3)).
      115     end.
      116   end.
      117   assign
      118   v-key = (if p-is-credit
      119           then  substr(p-bik, 7, 3)
      120           else ("0":U + substr(p-bik, 5, 2))
      121           ) +
      122           p-schet
      123   v-dop = v-key
      124   .
      125   assign
      126   v-key = substring(v-dop, 1, 11) + "0":U
      127   v-key = v-key + substring(v-dop, 13)
      128   v-dop = v-key
      129   .
      130   if length(p-bik) <> 9 then do:
      131     return substitute("Неверная длина БИК &1 (должна быть 9)", length(p-bik)).
      132   end.
      133   assign
      134   KC = ((sum-ml-razr(v-key) modulo 10) * 3) modulo 10
      135   no-error
      136   .
      137   if error-status:error  then do:
      138     return "Неверные символы в номере счета".
      139   end.
      140   assign
      141   v-key-check = substring(v-dop, 1, 11) + string(KC) + substring(v-dop, 13)
      142   .
      143   assign
      144   KC-check = (sum-ml-razr(v-key-check) modulo 10)
      145   no-error .
      146   if error-status:error  then do:
      147     return  "Неверные символы в номере счета".
      148   end.
      149   assign
      150   p-correct = (kc-check = 0) AND (string(KC) = substring(p-schet, 9, 1))
      151   .
      152   if not p-correct then do:
      153     return  "Неверное значение номера счета".
      154   end.
