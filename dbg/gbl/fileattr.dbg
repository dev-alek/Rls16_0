        1   block-level on error undo, throw.
        2   define input  parameter p-file-name     as character no-undo .
        3   define input  parameter p-attrib-action as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: fileattr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/fileattr.p $":U .
        9   define variable vss-description as character no-undo init "Изменить атрибуты файла".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   do
       65   on error undo, return error return-value
       66   :
       67     define variable v-memptr-file-name as memptr    no-undo .
       68     define variable v-file-attributes  as integer   no-undo .
       69     assign
       70       set-size(v-memptr-file-name) = length(p-file-name) + 1
       71     .
       72     assign
       73       put-string(v-memptr-file-name, 1) = p-file-name
       74     .
       75     run GetFileAttributesA
       76       (input  get-pointer-value(v-memptr-file-name)
       77       ,output v-file-attributes
       78       ) .
       79     if v-file-attributes = -1
       80     then do:
       81       assign
       82         set-size(v-memptr-file-name) = 0
       83       .
       84       undo, return error "Ошибка чтения атрибутов" .
       85     end.
       86     define variable v-index   as integer   no-undo .
       87     define variable v-bits    as logical   no-undo extent 32 .
       88     define variable v-big-num as int64     no-undo .
       89     do v-index = 1 to 32
       90     :
       91       assign
       92         v-bits[v-index] = false
       93       .
       94     end.
       95     if v-file-attributes < 0
       96     then do:
       97       assign
       98         v-bits[1] = true
       99       .
      100     end.
      101     assign
      102       v-big-num = 256 * 256 * 256 * 64
      103     .
      104     do v-index = 2 to 32
      105     :
      106       if v-file-attributes < v-big-num
      107       then do:
      108         assign
      109           v-bits[v-index] = false
      110         .
      111       end.
      112       else do:
      113         assign
      114           v-bits[v-index] = true
      115         .
      116         assign
      117           v-file-attributes = v-file-attributes - v-big-num
      118         .
      119       end.
      120       assign
      121         v-big-num = v-big-num / 2
      122       .
      123     end.
      124     case p-attrib-action
      125     :
      126       when 'readonly-clear':u
      127       then do:
      128         assign
      129           v-bits[32] = false
      130         .
      131       end.
      132       when 'readonly-set':u
      133       then do:
      134         assign
      135           v-bits[32] = true
      136         .
      137       end.
      138       otherwise do:
      139         assign
      140           set-size(v-memptr-file-name) = 0
      141         .
      142         undo, return error "Неизвестное значение параметра" .
      143       end.
      144     end case .
      145     assign
      146       v-big-num         = 1
      147       v-file-attributes = 0
      148     .
      149     do v-index = 32 to 1 by -1
      150     :
      151       if v-bits[v-index] = true
      152       then do:
      153         assign
      154           v-file-attributes = v-file-attributes + v-big-num
      155         .
      156       end.
      157       assign
      158         v-big-num = v-big-num * 2
      159       .
      160     end.
      161     define variable v-ret-val as integer   no-undo .
      162     run SetFileAttributesA
      163       (input  get-pointer-value(v-memptr-file-name)
      164       ,input  v-file-attributes
      165       ,output v-ret-val
      166       ) .
      167     assign
      168       set-size(v-memptr-file-name) = 0
      169     .
      170     if v-ret-val = 0
      171     then do:
      172       run GetLastError
      173         (output v-ret-val
      174         ) .
      175       undo, return error substitute("Ошибка при установке атрибута &1"
      176                                     ,v-ret-val
      177                                     )
      178         .
      179     end.
      180   end.
      181   PROCEDURE GetFileAttributesA EXTERNAL "kernel32.dll"
      182   :
      183       DEFINE INPUT        PARAMETER lpFileName AS LONG .
      184       DEFINE RETURN       PARAMETER RetParam   AS LONG .
      185   END PROCEDURE.
      186   PROCEDURE SetFileAttributesA EXTERNAL "kernel32.dll"
      187   :
      188       DEFINE INPUT  PARAMETER lpFileName       AS LONG .
      189       DEFINE INPUT  PARAMETER dwFileAttributes AS LONG .
      190       DEFINE RETURN PARAMETER RetParam         AS LONG .
      191   END PROCEDURE.
      192   PROCEDURE GetLastError EXTERNAL "kernel32.dll"
      193   :
      194       DEFINE RETURN       PARAMETER RetParam  AS LONG .
      195   END PROCEDURE.
