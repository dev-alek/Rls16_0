        1   block-level on error undo, throw.
        2   define input  parameter p-path as character no-undo .
        3   define output parameter p-unc as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: get-unc.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/get-unc.p $":U .
        9   define variable vss-description as character no-undo init "Получение UNC".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   PROCEDURE WNetGetConnectionA EXTERNAL "mpr.dll" :
       69     DEFINE INPUT        PARAMETER lpDrive    AS CHARACTER.
       70     DEFINE OUTPUT       PARAMETER lpUNCName  AS CHARACTER.
       71     DEFINE INPUT-OUTPUT PARAMETER lpnLength  AS LONG.
       72     DEFINE RETURN       PARAMETER RetBool    AS LONG.
       73   END PROCEDURE.
       74   PROCEDURE WSACleanup EXTERNAL "wsock32.dll" :
       75     DEFINE RETURN       PARAMETER RetBool    AS LONG.
       76   END PROCEDURE.
       77   PROCEDURE gethostname EXTERNAL "wsock32.dll" :
       78     DEFINE OUTPUT       PARAMETER p-Hostname      AS CHARACTER.
       79     DEFINE INPUT        PARAMETER p-Length        AS LONG.
       80     DEFINE RETURN       PARAMETER p-Return        AS LONG.
       81   END PROCEDURE.
       82   PROCEDURE PathIsRelative External "shell32.dll" :
       83    define input         parameter p-path     as character.
       84    DEFINE RETURN        PARAMETER pRetBoll   as Long.
       85   END PROCEDURE.
       86   DEFINE VARIABLE Drive_Name AS CHARACTER NO-UNDO .
       87   DEFINE VARIABLE namelen AS INTEGER NO-UNDO INITIAL 100.
       88   DEFINE VARIABLE retBool AS INTEGER NO-UNDO.
       89   DEFINE VARIABLE cClientName AS CHARACTER   NO-UNDO.
       90   define variable v-var as integer   no-undo .
       91   if ((substring(p-path, 2, 2) = ":\"
       92   or substring(p-path, 2, 2) = ":/")
       93   and index("ABCDEFGHIJKLMNOPQRSTUVXYZ", substring(p-path, 1, 1)) > 0
       94   )
       95   then do:
       96     Drive_Name = substring(p-path, 1, 2).
       97     p-UNC = FILL("x", namelen).
       98     RUN WNetGetConnectionA ( Drive_Name
       99                             ,OUTPUT p-unc
      100                             ,INPUT-OUTPUT namelen
      101                             ,OUTPUT retBool).
      102     IF retBool = 0 THEN do:
      103       p-UNC = SUBSTRING(p-unc, 1, namelen).
      104       p-unc = trim(p-unc) + (if length(p-path) > 2 then substring(p-path, 3) else '').
      105     end.
      106     ELSE do:
      107       if retBool = 2250 then do:
      108         ASSIGN
      109         namelen = 100
      110         cclientname = FILL(" ", namelen)
      111         .
      112         RUN gethostname (OUTPUT cclientname,
      113                         INPUT  namelen,
      114                         OUTPUT retBool).
      115         IF retBool NE 0 THEN DO:
      116           RUN WSACleanup (OUTPUT retBool).
      117           undo, return error substitute("Ошибка при получении имени компьютера:&1&2"
      118                                         , chr(10)
      119                                         , retbool).
      120         END.
      121         p-unc = ENTRY(1, cclientname, CHR(0)).
      122         .
      123         p-unc = substitute("\\&1\&2$&3", p-unc , substring(p-path, 1, 1), substring(p-path, 3)).
      124       end.
      125       else do:
      126        case retBool:
      127          when 1200 then do:
      128            undo, return error substitute("Ошибка при определении UNC - 1200  -The string pointed to by the lpLocalName parameter is invalid.").
      129          end.
      130          when 234 then do:
      131            undo, return error substitute("Ошибка при определении UNC - 234  - The buffer is too small. The lpnLength parameter points to a variable that contains the required buffer size. More entries are available with subsequent calls.").
      132          end.
      133          when 1201 then do:
      134            undo, return error substitute("Ошибка при определении UNC - 1201 - The device is not currently connected, but it is a persistent connection. For more information, see the following Remarks section.").
      135          end.
      136          when 1222 then do:
      137            undo, return error substitute("Ошибка при определении UNC -  1222 - The network is unavailable.").
      138          end.
      139          when 1208 then do:
      140            undo, return error substitute("Ошибка при определении UNC -  1208  = A network-specific error occurred. To obtain a description of the error, call the WNetGetLastError function.").
      141          end.
      142          when 1203 then do:
      143            undo, return error substitute("Ошибка при определении UNC -  1203  - None of the providers recognize the local name as having a connection. However, the network is not available for at least one provider to whom the connection may belong.").
      144          end.
      145        end case.
      146      end.
      147    end.
      148   end.
      149   else do:
      150     if p-path begins "\\" then do:
      151       p-unc = p-path.
      152     end.
      153     else do:
      154       undo, return error substitute("Не удалось определить UNC для &1", p-path).
      155     end.
      156   end.
