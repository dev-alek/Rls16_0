        1   define input        parameter h-callback    as handle    no-undo .
        2   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        3   DEFINE INPUT-OUTPUT PARAMETER pValue       AS CHARACTER NO-UNDO.
        4   DEFINE OUTPUT       PARAMETER p-ok         AS logical   NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       67   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       68   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       69   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       70   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       71   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       74   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       75   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       76   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       77   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       78   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       79   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       80   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       81   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       82   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   function octal-to-char return character
       89   ( p-string as character ) :
       90     def var v-asc     as integer no-undo .
       91     def var v-new-asc as integer no-undo .
       92     def var ind       as integer no-undo .
       93     if length(p-string) <> 3 then do:
       94       return ? .
       95     end.
       96     assign
       97       v-asc = 0
       98     .
       99     do ind = 1 to length(p-string)
      100     :
      101       assign
      102         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      103       .
      104       if v-new-asc < 0 or v-new-asc >= 8 then do:
      105         return ? .
      106       end.
      107       assign
      108         v-asc = v-asc * 8 + v-new-asc
      109       .
      110     end.
      111     return chr(v-asc) .
      112   end function .
      113   function char-to-octal return character
      114   ( p-chr as character ) :
      115     def var v-asc    as integer   no-undo .
      116     def var ind      as integer   no-undo .
      117     def var v-string as character no-undo .
      118     if length(p-chr) <> 1 then do:
      119       return ? .
      120     end.
      121     assign
      122       v-asc    = asc(p-chr)
      123       v-string = ""
      124     .
      125     do ind = 1 to 3
      126     :
      127       assign
      128         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      129       .
      130       assign
      131         v-asc = truncate(v-asc / 8, 0)
      132       .
      133     end.
      134     return v-string .
      135   end.
      136   function str-encode return character
      137   (   p-init-string       as character
      138     , p-encode-char       as character
      139     , p-special-char-list as character
      140   ) :
      141     def var p-encode-string as character no-undo .
      142     def var ind                as integer no-undo .
      143     def var v-num-special-char as integer no-undo .
      144     def var v-special-char     as character no-undo .
      145     if p-encode-char = ?
      146     or p-encode-char = "" then do:
      147       assign
      148         p-encode-char = "~~"
      149       .
      150     end.
      151     if p-init-string = ? then do:
      152       return "?" .
      153     end.
      154     if p-init-string = "?" then do:
      155       return p-encode-char + char-to-octal("?") .
      156     end.
      157     assign
      158       v-num-special-char = length(p-special-char-list)
      159       p-encode-string    = replace(p-init-string
      160                                   ,p-encode-char
      161                                   ,p-encode-char + char-to-octal(p-encode-char)
      162                                   )
      163     .
      164     do ind = 1 to v-num-special-char
      165     :
      166       assign
      167         v-special-char = substring(p-special-char-list, ind, 1)
      168       .
      169       if v-special-char <> p-encode-char then do:
      170         assign
      171           p-encode-string = replace (p-encode-string
      172                                     ,v-special-char
      173                                     ,p-encode-char + char-to-octal(v-special-char)
      174                                     )
      175         .
      176       end.
      177     end.
      178     return p-encode-string .
      179   end.
      180   function str-decode returns character
      181     (p-init-string   as character
      182     ,p-encode-char   as character
      183     ) :
      184     def var p-decode-string as character no-undo .
      185     def var ind                       as integer no-undo .
      186     def var v-num-entries-init-string as integer no-undo .
      187     def var v-sub-phrase              as character no-undo .
      188     def var v-special-char            as character no-undo .
      189     if p-encode-char = ?
      190     or p-encode-char = "" then do:
      191       assign
      192         p-encode-char = "~~"
      193       .
      194     end.
      195     if p-init-string = "?" then do:
      196       return ? .
      197     end.
      198     assign
      199       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      200     .
      201     if v-num-entries-init-string > 1 then do:
      202       assign
      203         p-decode-string = entry(1, p-init-string, p-encode-char)
      204       .
      205       do ind = 2 to v-num-entries-init-string
      206       :
      207         assign
      208           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      209         .
      210         assign
      211           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      212         .
      213         if v-special-char <> ? then do:
      214           assign
      215             p-decode-string = p-decode-string
      216                             + v-special-char
      217                             + substring(v-sub-phrase, 4)
      218           .
      219         end.
      220         else do:
      221           assign
      222             p-decode-string = p-decode-string
      223                             + p-encode-char
      224                             + v-sub-phrase
      225           .
      226         end.
      227       end.
      228     end.
      229     else do:
      230       assign
      231         p-decode-string = p-init-string
      232       .
      233     end.
      234     return p-decode-string .
      235   end.
      236   procedure proc-alt-shift-f2:
      237     if not ibs.th.gbl.gbl-var:rcode
      238   then
      239     run gbl\inidebug.p .
      240   end.
      241   procedure proc-alt-shift-f3:
      242     run gbl/prvssinf.p
      243       ( input this-procedure
      244       ) .
      245   end.
      246   define variable v-inform-launched as logical no-undo initial false .
      247   procedure proc-alt-shift-f4:
      248     define variable v-action as character no-undo .
      249     if v-inform-launched = false then do:
      250       assign
      251         v-inform-launched = true
      252       .
      253       run gbl/d-inform.w
      254         (  input self
      255         ,  input this-procedure
      256         , output v-action
      257         ) no-error .
      258       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      259       assign
      260         v-inform-launched = false
      261       .
      262     end.
      263   end.
      264   procedure proc-alt-f1:
      265     run gbl/corrhelp.p
      266       (input this-procedure
      267       ) .
      268   end .
      269   on alt-shift-f2 anywhere do:
      270     run proc-alt-shift-f2.
      271   end.
      272   on alt-shift-f3 anywhere do:
      273     run proc-alt-shift-f3 in this-procedure .
      274   end.
      275   on alt-shift-f4 anywhere do:
      276     run proc-alt-shift-f4 in this-procedure.
      277   end.
      278   on alt-f1 anywhere do:
      279     run proc-alt-f1 in this-procedure .
      280   end.
      281   define variable lUserPressOK     AS LOGICAL       NO-UNDO INIT False .
      282   define variable sFormat          AS CHARACTER     NO-UNDO .
      283   define variable sBoxProg         AS CHARACTER     NO-UNDO .
      284   define variable lBlank           AS LOGICAL       NO-UNDO .
      285   define variable v-password       as logical   no-undo .
      286   define variable hFillIn          AS WIDGET-HANDLE NO-UNDO .
      287   define variable sFillIn_Row      AS CHARACTER     NO-UNDO INIT ? .
      288   define variable sFillIn_Col      AS CHARACTER     NO-UNDO INIT ? .
      289   define variable sFillIn_Width    AS CHARACTER     NO-UNDO INIT ? .
      290   define variable sFillIn_Height   AS CHARACTER     NO-UNDO INIT ? .
      291   define variable sEditor_MaxChars AS CHARACTER     NO-UNDO INIT ? .
      292   define variable sCreate_Text1    AS CHARACTER     NO-UNDO INIT ? .
      293   define variable v-read-only      AS LOGICAL       NO-UNDO INIT False .
      294   DEFINE BUTTON b-help
      295        LABEL "Помо&щь"
      296        SIZE 3 BY 1
      297        BGCOLOR 8 .
      298   DEFINE BUTTON Btn-Choose
      299        LABEL "V"
      300        SIZE 2.5 BY 1.
      301   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      302        LABEL "&Отмена"
      303        SIZE 10 BY 1
      304        BGCOLOR 8 .
      305   DEFINE BUTTON Btn_OK AUTO-GO
      306        LABEL "&Ввод "
      307        SIZE 10 BY 1
      308        BGCOLOR 8 .
      309   DEFINE VARIABLE FILL-IN-Character AS CHARACTER FORMAT "X(256)":U
      310        VIEW-AS FILL-IN
      311        SIZE 41.3 BY 1
      312        BGCOLOR 15  NO-UNDO.
      313   DEFINE VARIABLE FILL-IN-Text-1 AS CHARACTER FORMAT "X(256)":U
      314         VIEW-AS TEXT
      315        SIZE 41.3 BY .57
      316        FONT 4 NO-UNDO.
      317   DEFINE VARIABLE FILL-IN-Text-2 AS CHARACTER FORMAT "X(256)":U
      318         VIEW-AS TEXT
      319        SIZE 41.3 BY .57
      320        FONT 4 NO-UNDO.
      321   DEFINE FRAME Dialog-Frame
      322        Btn_OK AT ROW 1 COL 1
      323        Btn_Cancel AT ROW 1 COL 11
      324        b-help AT ROW 1 COL 43
      325        FILL-IN-Character AT ROW 4 COL 2 NO-LABEL
      326        Btn-Choose AT ROW 4 COL 43.5
      327        FILL-IN-Text-1 AT ROW 2.13 COL 2.5 NO-LABEL
      328        FILL-IN-Text-2 AT ROW 3.03 COL 2.5 NO-LABEL
      329        SPACE(2.59) SKIP(3.62)
      330       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      331            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      332            TITLE "Ввод строкового значения"
      333            CANCEL-BUTTON Btn_Cancel.
      334   ASSIGN
      335          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      336          FRAME Dialog-Frame:HIDDEN           = TRUE.
      337   ASSIGN
      338          Btn-Choose:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      339   ASSIGN
      340          FILL-IN-Character:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      341   ASSIGN
      342          FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      343   ASSIGN
      344          FILL-IN-Text-2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      345   ON GO OF FRAME Dialog-Frame
      346   DO:
      347     IF NOT v-read-only
      348     THEN DO:
      349       IF VALID-HANDLE(hFillIn)
      350       THEN DO:
      351         if  h-callback <> ?
      352         and valid-handle(h-callback)
      353         then do:
      354           if h-callback :get-signature("cb-d-character-validate") <> ""
      355           then do:
      356             define variable v-ok as logical no-undo .
      357             define variable v-message as character no-undo .
      358             run cb-d-character-validate in h-callback
      359               (input  fill-in-character
      360               ,output v-ok
      361               ,output v-message
      362               ) no-error .
      363             if error-status :error
      364             then do:
      365               message
      366                 vss-workfile vss-revision vss-description skip
      367                 "Ошибка при вызове процедуры проверки допустимости character" skip
      368                 "Вызывающая программа" h-callback :file-name skip
      369                 "Внутренняя процедура" "cb-d-character-validate" skip
      370                 error-status :get-message(1) skip
      371                 return-value skip
      372                 view-as alert-box error .
      373               return no-apply .
      374             end.
      375             if v-ok <> true
      376             then do:
      377               message
      378                 v-message
      379                 view-as alert-box information .
      380               return no-apply .
      381             end.
      382           end.
      383           else do:
      384             message
      385               vss-workfile vss-revision vss-description skip
      386               "Программе был передан указатель на процедуру для проверки character" skip
      387               "В вызывающей программе отсутствует внутренняя процедура" "cb-d-character-validate" skip
      388               "Вызывающая программа" h-callback :file-name skip
      389               view-as alert-box error .
      390             return no-apply .
      391           end.
      392         end.
      393         ASSIGN
      394           pValue = hFillIn:SCREEN-VALUE
      395         .
      396       END.
      397     END.
      398     ASSIGN
      399     p-ok = True
      400     .
      401   END.
      402   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      403   DO:
      404     APPLY "END-ERROR":U TO SELF.
      405   END.
      406   ON CHOOSE OF Btn-Choose IN FRAME Dialog-Frame
      407   DO:
      408     define variable var_id   as char no-undo.
      409     define variable var_name as char no-undo.
      410   if session :set-wait-state( "compiler" ) then.
      411     do with frame Dialog-Frame
      412     :
      413       assign
      414         var_id = hfillin :screen-value
      415       .
      416       run value(sboxprog) (input-output var_id, input-output var_name).
      417       if var_id <> hfillin :screen-value
      418       then do:
      419         assign
      420           hfillin :screen-value = var_id
      421         .
      422       end.
      423     end.
      424   if session :set-wait-state( "" ) then.
      425   END.
      426   ON RETURN OF FILL-IN-Character IN FRAME Dialog-Frame
      427   DO:
      428     APPLY "CHOOSE":U TO Btn_OK.
      429   END.
      430   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   on help of frame Dialog-Frame
      432   do:
      433     run gbl/app_help.p
      434       (input this-procedure :file-name
      435       ,input ''
      436       ,input ?
      437       ) no-error.
      438     if error-status :error then do:
      439       message
      440         "Ошибка при вызове помощи"
      441         error-status :get-message(1)
      442         view-as alert-box .
      443     end.
      444   end.
      445   run minbtn-set in this-procedure .
      446   on choose of b-help in frame Dialog-Frame
      447   do:
      448     apply "help":u to frame Dialog-Frame .
      449   end.
      450   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451   procedure minbtn-set :
      452       do
      453           on error undo, return error return-value
      454           :
      455           define variable ii              as integer       no-undo .
      456           define variable fh              as widget-handle no-undo .
      457           define variable hh              as widget-handle no-undo .
      458           define variable v-h             as handle        extent 4 no-undo .
      459           define variable v-name-button   as character     no-undo .
      460           define variable v-help-old-x    as decimal       no-undo .
      461           define variable v-help-old-y    as decimal       no-undo .
      462           define variable v-help-old-size as decimal       no-undo .
      463           define variable v-frame-width   as decimal       no-undo .
      464           define variable jj              as integer       no-undo .
      465           do
      466               on error undo, return error
      467               :
      468               assign
      469                   v-frame-width = frame Dialog-Frame:width - 0.3
      470                   fh            = frame Dialog-Frame:first-child
      471                   hh            = fh:first-child
      472                   ii            = 1
      473                   .
      474               do while valid-handle(hh):
      475                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      476                   do:
      477                       case lc(hh:name) :
      478                           when "b-help" then
      479                               do:
      480                                   hh:load-image-up("cmp/b-help.bmp":u) .
      481                                   hh:load-image-down("cmp/b-help.bmp":u) .
      482                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      483                                   hh:TOOLTIP = "Помощь" .
      484                                   v-help-old-x = hh:column .
      485                                   v-help-old-y = hh:row    .
      486                                   v-help-old-size = hh:width .
      487                                   hh:width-chars = 2.5 .
      488                               end.
      489                           when "b-print" then
      490                               do:
      491                                   hh:load-image("cmp/b-print.bmp":u) .
      492                                   hh:TOOLTIP = "Печать" .
      493                                   v-h[ii] = hh:handle .
      494                                   ii = ii + 1 .
      495                                   hh:width-chars = 3 .
      496                               end.
      497                           when "b-history" or
      498                           when "b-hist" then
      499                               do:
      500                                   hh:load-image("cmp/b-hist.bmp":u) .
      501                                   hh:TOOLTIP = "История" .
      502                                   v-h[ii] = hh:handle .
      503                                   ii = ii + 1 .
      504                                   hh:width-chars = 3 .
      505                               end.
      506                           when "b-sch" then
      507                               do:
      508                                   hh:load-image("cmp/b-sch.bmp":u) .
      509                                   hh:TOOLTIP = "Установка Фильтра" .
      510                                   v-h[ii] = hh:handle .
      511                                   ii = ii + 1 .
      512                                   hh:width-chars = 3 .
      513                               end.
      514                           when "b-hist-user" then
      515                               do:
      516                                   hh:load-image("cmp/b-hist.bmp":u) .
      517                                   hh:TOOLTIP = "История пользователя" .
      518                                   ii = ii + 1 .
      519                               end.
      520                       end case.
      521                   end.
      522                   hh = hh:next-sibling.
      523               end.
      524               b-help:column = v-frame-width - b-help:width-chars.
      525               jj = 0.
      526               repeat ii = 4 to 1 by -1 :
      527                   if valid-handle (v-h[ii] ) then
      528                   do:
      529                       jj  = jj + 1 .
      530                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      531                       v-h[ii]:row    = v-help-old-y .
      532                   end.
      533               end.
      534           end.
      535       end.
      536   end procedure.
      537   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      538   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      539   define variable ind AS INTEGER NO-UNDO.
      540   define variable sElement AS CHARACTER NO-UNDO.
      541   define variable sValue AS CHARACTER NO-UNDO.
      542   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      543     sElement = ENTRY(ind, pParameters, '\').
      544     IF NUM-ENTRIES(sElement, '=') = 2
      545     THEN DO:
      546       sValue   = ENTRY(2, sElement, '=').
      547       CASE ENTRY(1, sElement, '='):
      548         WHEN 'text1'         THEN do: assign FILL-IN-Text-1   = str-decode(sValue, "").             end.
      549         WHEN 'text2'         THEN do: assign FILL-IN-Text-2   = str-decode(sValue, "").             end.
      550         WHEN 'format'        THEN do: assign sFormat          = sValue.                             end.
      551         WHEN 'blank'         THEN do: assign lBlank           = lookup(sValue, 'true,yes':U) > 0.   end.
      552         WHEN 'password'      THEN do: assign v-password       = lookup(sValue, 'true,yes':U) > 0.   end.
      553         WHEN 'title'         THEN do: assign FRAME Dialog-Frame:TITLE = sValue.                    end.
      554         WHEN 'boxprog'       THEN do: assign sBoxProg         = sValue.                             end.
      555         WHEN 'FillIn_Row'    THEN do: assign sFillIn_Row      = sValue.                             end.
      556         WHEN 'FillIn_Col'    THEN do: assign sFillIn_Col      = sValue.                             end.
      557         WHEN 'FillIn_Height' THEN do: assign sFillIn_Height   = sValue.                             end.
      558         WHEN 'FillIn_Width'  THEN do: assign sFillIn_Width    = sValue.                             end.
      559         WHEN 'max-chars'     THEN do: assign sEditor_MaxChars = sValue.                             end.
      560         WHEN 'Create_Text1'  THEN do: assign sCreate_Text1    = sValue.                             end.
      561         WHEN 'readonly'      THEN do: assign v-read-only      = lookup(sValue, 'yes,true':U) > 0 .  end.
      562       END CASE.
      563     END.
      564   END.
      565   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      566   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      567   define variable hText AS WIDGET-HANDLE NO-UNDO.
      568   DO WITH FRAME Dialog-Frame
      569   :
      570     IF FILL-IN-Text-1 <> ''
      571     THEN DO:
      572       DISPLAY FILL-IN-Text-1.
      573     END.
      574     IF FILL-IN-Text-2 <> ''
      575     THEN DO:
      576       DISPLAY FILL-IN-Text-2.
      577     END.
      578   END.
      579   define variable sText1Label AS CHARACTER NO-UNDO.
      580   IF sCreate_Text1 <> ?
      581   AND NUM-ENTRIES(sCreate_Text1, ';') = 3
      582   THEN DO:
      583     sText1Label = ENTRY(3, sCreate_Text1, ';').
      584     CREATE TEXT hText
      585     ASSIGN
      586       ROW          = INTEGER(ENTRY(1, sCreate_Text1, ';'))
      587       COLUMN       = INTEGER(ENTRY(2, sCreate_Text1, ';'))
      588       FORMAT       = 'X(' + STRING(LENGTH(sText1Label)) + ')'
      589       SCREEN-VALUE = sText1Label
      590       FRAME        = hFrameHandle
      591       SENSITIVE    = FALSE
      592       VISIBLE      = TRUE
      593     .
      594   END.
      595   RUN setup-fill-in .
      596   MAIN-BLOCK:
      597   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      598      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      599     RUN enable_UI.
      600     run setup-box-button .
      601     run setup-cancel-button .
      602     WAIT-FOR GO OF FRAME Dialog-Frame.
      603   END.
      604   RUN disable_UI.
      605   PROCEDURE disable_UI :
      606     HIDE FRAME Dialog-Frame.
      607   END PROCEDURE.
      608   PROCEDURE enable_UI :
      609     ENABLE Btn_OK Btn_Cancel b-help
      610         WITH FRAME Dialog-Frame.
      611     VIEW FRAME Dialog-Frame.
      612   END PROCEDURE.
      613   PROCEDURE setup-box-button :
      614     DO WITH FRAME Dialog-Frame
      615     :
      616       IF sBoxProg <> ''
      617       THEN DO:
      618         ASSIGN
      619           Btn-Choose:VISIBLE      = True AND NOT v-read-only
      620           Btn-Choose:SENSITIVE    = True AND NOT v-read-only
      621         .
      622       END.
      623       if v-read-only
      624       then do:
      625         assign
      626           Btn_OK :LABEL = "&Выход"
      627         .
      628       end.
      629     END.
      630   END PROCEDURE.
      631   PROCEDURE setup-cancel-button :
      632     do with frame Dialog-Frame
      633     :
      634       if v-read-only = false
      635       then do:
      636         assign
      637           Btn_Cancel :visible   = true
      638           Btn_Cancel :sensitive = true
      639         .
      640       end.
      641       else do:
      642         assign
      643           Btn_Cancel :sensitive = false
      644           Btn_Cancel :visible   = false
      645         .
      646       end.
      647     end.
      648   END PROCEDURE.
      649   PROCEDURE setup-fill-in :
      650   DO WITH FRAME Dialog-Frame
      651     :
      652           ASSIGN
      653             FILL-IN-Character :VISIBLE      = True
      654             FILL-IN-Character :SENSITIVE    = True AND NOT v-read-only
      655             hFillIn = FILL-IN-Character:HANDLE
      656           .
      657     END.
      658     IF VALID-HANDLE(hFillIn)
      659     THEN DO:
      660       IF CAN-SET(hFillIn, 'BLANK')
      661       THEN DO:
      662         ASSIGN
      663           hFillIn:BLANK        = lBlank
      664         .
      665       END.
      666       IF CAN-SET(hFillIn, 'PASSWORD-FIELD')
      667       THEN DO:
      668         ASSIGN
      669           hFillIn:PASSWORD-FIELD = v-password
      670         .
      671       END.
      672       IF sFormat <> ''
      673       AND CAN-SET(hFillIn, 'FORMAT')
      674       THEN DO:
      675         ASSIGN
      676           hFillIn:FORMAT       = sFormat
      677         .
      678       END.
      679       IF CAN-SET(hFillIn, 'SCREEN-VALUE')
      680       THEN DO:
      681           ASSIGN
      682             hFillIn :SCREEN-VALUE = pValue
      683           .
      684       END.
      685       IF  sFillIn_Row <> ?
      686       AND sFillIn_Row <> ''
      687       AND CAN-SET(hFillIn, 'ROW')
      688       THEN DO:
      689         ASSIGN
      690           hFillIn:ROW          = DECIMAL(sFillIn_Row)
      691         .
      692       END.
      693       IF  sFillIn_Col  <> ?
      694       AND sFillIn_Col <> ''
      695       AND CAN-SET(hFillIn, 'COL')
      696       THEN DO:
      697         define variable v-new-col as decimal   no-undo .
      698         assign
      699           v-new-col = DECIMAL(sFillIn_Col)
      700         .
      701         if v-new-col + hFillIn :width + 1.5 >= frame Dialog-Frame:width
      702         then do:
      703           assign
      704             frame Dialog-Frame:width = v-new-col + hFillIn :width + 1.5
      705           .
      706         end.
      707         ASSIGN
      708           hFillIn:COL = v-new-col
      709         .
      710       END.
      711       define variable eFillIn_Width AS DECIMAL NO-UNDO.
      712       eFillIn_Width = DECIMAL(sFillIn_Width).
      713       IF eFillIn_Width = ? THEN
      714         eFillIn_Width = hFillIn:WIDTH.
      715       IF hFillIn:COL + eFillIn_Width + 1.5 >= FRAME Dialog-Frame:WIDTH
      716       THEN DO:
      717         ASSIGN
      718           FRAME Dialog-Frame:WIDTH = hFillIn:COL + eFillIn_Width + 1.5
      719         .
      720       END.
      721       IF  sFillIn_Width  <> ?
      722       AND sFillIn_Width <> ''
      723       AND CAN-SET(hFillIn, 'WIDTH')
      724       THEN DO:
      725         ASSIGN
      726           hFillIn:WIDTH        = DECIMAL(sFillIn_Width)
      727         .
      728       END.
      729       define variable eFillIn_Height AS DECIMAL NO-UNDO.
      730       eFillIn_Height = DECIMAL(sFillIn_Height).
      731       IF eFillIn_Height = ? THEN
      732         eFillIn_Height = hFillIn:HEIGHT.
      733       define variable eHeightDelta AS DECIMAL NO-UNDO.
      734       assign
      735         eHeightDelta = hFillIn:ROW + eFillIn_HEIGHT + 2.2 - FRAME Dialog-Frame:HEIGHT
      736       .
      737       IF eHeightDelta > 0
      738       THEN DO:
      739         ASSIGN
      740           FRAME Dialog-Frame:HEIGHT = FRAME Dialog-Frame:HEIGHT + eHeightDelta
      741           Btn_Cancel:ROW             = Btn_Cancel:ROW + eHeightDelta
      742           b-help:ROW               = b-help:ROW   + eHeightDelta
      743           Btn_OK:ROW                 = Btn_OK:ROW     + eHeightDelta
      744         .
      745       END.
      746       IF  sFillIn_Height  <> ?
      747       AND sFillIn_Height <> ''
      748       AND CAN-SET(hFillIn, 'HEIGHT')
      749       THEN DO:
      750         ASSIGN
      751           hFillIn:HEIGHT       = DECIMAL(sFillIn_Height)
      752         .
      753       END.
      754       IF hFillIn:MOVE-TO-TOP() THEN .
      755     END.
      756     pValue = ''.
      757   END PROCEDURE.
