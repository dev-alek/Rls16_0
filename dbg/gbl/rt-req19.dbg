        1   block-level on error undo, throw.
        2   define input  parameter parparentproc    as widget-handle no-undo .
        3   define input  parameter p-directory-out  as character no-undo .
        4   define input  parameter p-file-name      as character no-undo .
        5   define input  parameter p-obj-type       as character no-undo .
        6   define input  parameter p-obj-code       as character no-undo .
        7   define input  parameter p-bar-code       as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: rt-req19.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req19.p $":U .
       13   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 19. Инвентаризация. Информация о товаре".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure integerm :
       74     define input  parameter p-string      as character no-undo .
       75     define input  parameter p-allow-sign  as logical   no-undo .
       76     define input  parameter p-allow-comma as logical   no-undo .
       77     define output parameter p-value       as integer   no-undo .
       78     define output parameter p-data-valid  as logical   no-undo .
       79     define output parameter p-message     as character no-undo .
       80     define variable v-replace-string as character no-undo .
       81     do
       82     on error undo, return error return-value
       83     :
       84       if p-string = ?
       85       then do:
       86         assign
       87           p-value      = ?
       88           p-data-valid = false
       89           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       90         .
       91         return .
       92       end.
       93       if p-string = ""
       94       then do:
       95         assign
       96           p-value      = ?
       97           p-data-valid = false
       98           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
       99         .
      100         return .
      101       end.
      102       assign
      103         p-value = integer(p-string) no-error
      104       .
      105       if error-status :error = true
      106       then do:
      107         assign
      108           p-value      = ?
      109           p-data-valid = false
      110           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      111                                    ,p-string
      112                                    )
      113         .
      114         return .
      115       end.
      116       if index(p-string, ' ':u) > 0
      117       then do:
      118         assign
      119           p-value      = ?
      120           p-data-valid = false
      121           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      122                                    + "Строка содержит символы пробела"
      123                                    ,p-string
      124                                    )
      125         .
      126         return .
      127       end.
      128       assign
      129         v-replace-string = p-string
      130         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      131         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      132         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      133         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      139       .
      140       if p-allow-sign = true
      141       then do:
      142         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      143         then do:
      144           assign
      145             v-replace-string = substring(v-replace-string, 2)
      146           .
      147         end.
      148       end.
      149       else do:
      150         if substring(v-replace-string, 1, 1) = '+':u
      151         then do:
      152           assign
      153             p-value      = ?
      154             p-data-valid = false
      155             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      156                                     + "Задан параметр недопустимости знака челого числа. "
      157                                     + "Строка содержит символ плюс. "
      158                                     ,p-string
      159                                     )
      160           .
      161           return .
      162         end.
      163         if substring(v-replace-string, 1, 1) = '-':u
      164         then do:
      165           assign
      166             p-value      = ?
      167             p-data-valid = false
      168             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      169                                     + "Задан параметр недопустимости знака челого числа. "
      170                                     + "Строка содержит символ минус. "
      171                                     ,p-string
      172                                     )
      173           .
      174           return .
      175         end.
      176       end.
      177       if p-allow-comma = true
      178       then do:
      179         assign
      180           v-replace-string = replace(v-replace-string, ',', '')
      181         .
      182       end.
      183       else do:
      184         if index(v-replace-string, ',') > 0
      185         then do:
      186           assign
      187             p-value      = ?
      188             p-data-valid = false
      189             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      190                                     + "Задан параметр недопустимости знака разделителя тысяч."
      191                                     + "Строка содержит знак разделителя тысяч. "
      192                                     ,p-string
      193                                     )
      194           .
      195           return .
      196         end.
      197       end.
      198       if index(p-string, '.') > 0
      199       then do:
      200         assign
      201           p-value      = ?
      202           p-data-valid = false
      203           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      204                                    + "Строка содержит знак десятичной точки"
      205                                    ,p-string
      206                                    )
      207         .
      208         return .
      209       end.
      210       if v-replace-string <> fill('9', length(v-replace-string))
      211       then do:
      212         assign
      213           p-value      = ?
      214           p-data-valid = false
      215           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      216                                    + "Встречены символы, недопустимые для целого числа '&2'"
      217                                    ,p-string
      218                                    ,replace(v-replace-string, '9', '')
      219                                    )
      220         .
      221         return .
      222       end.
      223       assign
      224         p-data-valid = true
      225         p-message    = ""
      226       .
      227     end.
      228   end procedure.
      229   define new global shared variable g#library  as handle no-undo .
      230   define new global shared variable g#library2 as handle no-undo .
      231   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   function rtencode returns character
      233     ( p-init-string as character
      234     ) :
      235     define variable v-encode-string as character no-undo .
      236     if p-init-string = ?
      237     then do:
      238       assign
      239         v-encode-string = '?':u
      240       .
      241       return v-encode-string .
      242     end.
      243     if p-init-string = '?':u
      244     then do:
      245       assign
      246         v-encode-string = '~~077':u
      247       .
      248       return v-encode-string .
      249     end.
      250     assign
      251       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      252       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      253       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      254     .
      255     return v-encode-string .
      256   end function .
      257   define stream sout .
      258   define variable v-status        as character no-undo .
      259   define variable v-error-message as character no-undo .
      260   define variable v-artic         as character no-undo .
      261   define variable v-name          as character no-undo .
      262   define variable v-prod-name     as character no-undo .
      263   define variable v-price-sale    as character no-undo .
      264   do
      265   on error undo, return error return-value
      266   :
      267     run check-data in this-procedure
      268       (output v-status
      269       ,output v-error-message
      270       ,output v-artic
      271       ,output v-name
      272       ,output v-prod-name
      273       ,output v-price-sale
      274       ) no-error .
      275     if error-status :error
      276     then do:
      277       undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      278                                   ,error-status :get-message(1)
      279                                   ,return-value
      280                                   ) .
      281     end.
      282     define variable v-temp-file-name as character no-undo .
      283     assign
      284       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      285     .
      286     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      287     put stream sout unformatted substitute('status:&1' ,    rtencode(v-status))
      288       + chr(10) .
      289     put stream sout unformatted substitute('message:&1',    rtencode(v-error-message))
      290       + chr(10) .
      291     put stream sout unformatted substitute('artic:&1',      rtencode(v-artic))
      292       + chr(10) .
      293     put stream sout unformatted substitute('name:&1',       rtencode(v-name))
      294       + chr(10) .
      295     put stream sout unformatted substitute('prod_name:&1',  rtencode(v-prod-name))
      296       + chr(10) .
      297     put stream sout unformatted substitute('price_sale:&1', rtencode(v-price-sale))
      298       + chr(10) .
      299     output stream sout close .
      300     os-delete value(p-directory-out + '/':u + p-file-name) .
      301     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      302               value(p-directory-out + '/':u + p-file-name)
      303               .
      304   end.
      305   procedure check-data :
      306     define output parameter p-status        as character no-undo .
      307     define output parameter p-error-message as character no-undo .
      308     define output parameter p-artic         as character no-undo .
      309     define output parameter p-name          as character no-undo .
      310     define output parameter p-prod-name     as character no-undo .
      311     define output parameter p-price-sale    as character no-undo .
      312     define buffer buf_clients  for ub.clients .
      313     define buffer buf_sysconf  for ub.sysconf .
      314     define buffer buf_bar-code for ub.bar-code .
      315     define buffer buf_goods    for ub.goods .
      316     define variable v-b-code as integer   no-undo .
      317     do
      318     on error undo, return error return-value
      319     :
      320       define variable v-obj-code      as integer   no-undo .
      321       define variable v-data-valid    as logical   no-undo .
      322       define variable v-error-message as character no-undo .
      323       if p-obj-code = ""
      324       then do:
      325         assign
      326           p-status        = '1':u
      327           p-error-message = "Не задан код объекта"
      328         .
      329         return .
      330       end.
      331       run integerm in this-procedure
      332         (input  p-obj-code
      333         ,input  false
      334         ,input  false
      335         ,output v-obj-code
      336         ,output v-data-valid
      337         ,output v-error-message
      338         ) .
      339       if v-data-valid <> true
      340       then do:
      341         assign
      342           p-status        = '1':u
      343           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      344                                       ,p-obj-code
      345                                       ,v-error-message
      346                                       )
      347         .
      348         return .
      349       end.
      350       find first buf_clients no-lock
      351         where buf_clients.obj-type = p-obj-type
      352           and buf_clients.obj-code = v-obj-code
      353         no-error .
      354       if not available buf_clients
      355       then do:
      356         assign
      357           p-status        = '1':u
      358           p-error-message = substitute("Не найден объект &1 &2"
      359                                       ,p-obj-type
      360                                       ,v-obj-code
      361                                       )
      362         .
      363         return .
      364       end.
      365       if  p-obj-type <> 'маг':U
      366       and p-obj-type <> 'скл':U
      367       then do:
      368         assign
      369           p-status        = '1':u
      370           p-error-message = substitute("Неправильный тип объекта &1 &2"
      371                                       ,p-obj-type
      372                                       ,v-obj-code
      373                                       )
      374         .
      375         return .
      376       end.
      377       run gbl/getbcode.p
      378         (input  parparentproc
      379         ,input  p-bar-code
      380         ,input  ""
      381         ,input  0
      382         ,input  false
      383         ,output v-b-code
      384         ) .
      385       if v-b-code = ?
      386       then do:
      387         assign
      388           p-status        = '1':u
      389           p-error-message = substitute('Не найден штрих-код &1'
      390                                       ,p-bar-code
      391                                       )
      392         .
      393         return .
      394       end.
      395       find first buf_bar-code no-lock
      396         where buf_bar-code.b-code = v-b-code
      397         no-error .
      398       if not available buf_bar-code
      399       then do:
      400         assign
      401           p-status        = '1':u
      402           p-error-message = substitute('Ошибка поиска записи bar-code &1'
      403                                       ,v-b-code
      404                                       )
      405         .
      406         return .
      407       end.
      408       find first buf_goods no-lock
      409         where buf_goods.gds-code = buf_bar-code.gds-code
      410         no-error .
      411       if not available buf_goods
      412       then do:
      413         assign
      414           p-status        = '1':u
      415           p-error-message = substitute('Ошибка поиска записи товар с кодом &1 для бар-кода &2'
      416                                       ,buf_bar-code.gds-code
      417                                       ,v-b-code
      418                                       )
      419         .
      420         return .
      421       end.
      422       find first buf_clients no-lock
      423         where buf_clients.obj-type = buf_goods.prod-type
      424           and buf_clients.obj-code = buf_goods.prod-code
      425         no-error .
      426       if not available buf_clients
      427       then do:
      428         assign
      429           p-status        = '1':u
      430           p-error-message = substitute("Ошибка при поиске записи поставщика &1 &2 для товара с кодом &3"
      431                                       ,buf_goods.prod-type
      432                                       ,buf_goods.prod-code
      433                                       ,buf_goods.gds-code
      434                                       )
      435         .
      436         return .
      437       end.
      438       define variable v-prc-doc-num     as character no-undo .
      439       define variable v-prc-price-sale  as decimal   no-undo .
      440       define variable v-prc-road-tax    as decimal   no-undo .
      441       define variable v-prc-excise      as decimal   no-undo .
      442   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      444     (input  p-obj-type
      445     ,input  v-obj-code
      446     ,input  v-b-code
      447     ,input  0
      448     ,input  0
      449     ,output v-prc-doc-num
      450     ,output v-prc-price-sale
      451     ,output v-prc-road-tax
      452     ,output v-prc-excise
      453     ) no-error .
      454       if error-status :error
      455       then do:
      456         assign
      457           p-status        = '1':u
      458           p-error-message = substitute('Ошибка поиске записи переоценки для штрих кода &1 &2 &3'
      459                                       ,p-bar-code
      460                                       ,error-status :get-message(1)
      461                                       ,return-value
      462                                       )
      463         .
      464         return .
      465       end.
      466       if v-prc-price-sale = ?
      467       then do:
      468         assign
      469           v-prc-price-sale = 0
      470         .
      471       end.
      472       assign
      473         p-artic      = buf_goods.artic
      474         p-name       = buf_goods.gds-name
      475         p-prod-name  = buf_clients.obj-name
      476         p-price-sale = string(v-prc-price-sale)
      477       .
      478       assign
      479         p-status        = '0':u
      480         p-error-message = ""
      481       .
      482     end.
      483   end procedure.
