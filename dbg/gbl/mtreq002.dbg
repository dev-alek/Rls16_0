        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as handle    no-undo .
        3   define input  parameter p-device-id     as character no-undo .
        4   define input  parameter p-user-login    as character no-undo .
        5   define input  parameter p-obj-type      as character no-undo .
        6   define input  parameter p-obj-code      as integer   no-undo .
        7   define input  parameter p-pos-num       as integer   no-undo .
        8   define output parameter p-send-message  as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: mtreq002.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: gbl/mtreq002.p $":U .
       14   define variable vss-description as character no-undo init "Мобильный терминал. Открытие чека на кассе".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure integerm :
       77     define input  parameter p-string      as character no-undo .
       78     define input  parameter p-allow-sign  as logical   no-undo .
       79     define input  parameter p-allow-comma as logical   no-undo .
       80     define output parameter p-value       as integer   no-undo .
       81     define output parameter p-data-valid  as logical   no-undo .
       82     define output parameter p-message     as character no-undo .
       83     define variable v-replace-string as character no-undo .
       84     do
       85     on error undo, return error return-value
       86     :
       87       if p-string = ?
       88       then do:
       89         assign
       90           p-value      = ?
       91           p-data-valid = false
       92           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       93         .
       94         return .
       95       end.
       96       if p-string = ""
       97       then do:
       98         assign
       99           p-value      = ?
      100           p-data-valid = false
      101           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      102         .
      103         return .
      104       end.
      105       assign
      106         p-value = integer(p-string) no-error
      107       .
      108       if error-status :error = true
      109       then do:
      110         assign
      111           p-value      = ?
      112           p-data-valid = false
      113           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      114                                    ,p-string
      115                                    )
      116         .
      117         return .
      118       end.
      119       if index(p-string, ' ':u) > 0
      120       then do:
      121         assign
      122           p-value      = ?
      123           p-data-valid = false
      124           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      125                                    + "Строка содержит символы пробела"
      126                                    ,p-string
      127                                    )
      128         .
      129         return .
      130       end.
      131       assign
      132         v-replace-string = p-string
      133         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      134         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      135         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      136         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      137         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      138         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      142       .
      143       if p-allow-sign = true
      144       then do:
      145         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      146         then do:
      147           assign
      148             v-replace-string = substring(v-replace-string, 2)
      149           .
      150         end.
      151       end.
      152       else do:
      153         if substring(v-replace-string, 1, 1) = '+':u
      154         then do:
      155           assign
      156             p-value      = ?
      157             p-data-valid = false
      158             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      159                                     + "Задан параметр недопустимости знака челого числа. "
      160                                     + "Строка содержит символ плюс. "
      161                                     ,p-string
      162                                     )
      163           .
      164           return .
      165         end.
      166         if substring(v-replace-string, 1, 1) = '-':u
      167         then do:
      168           assign
      169             p-value      = ?
      170             p-data-valid = false
      171             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      172                                     + "Задан параметр недопустимости знака челого числа. "
      173                                     + "Строка содержит символ минус. "
      174                                     ,p-string
      175                                     )
      176           .
      177           return .
      178         end.
      179       end.
      180       if p-allow-comma = true
      181       then do:
      182         assign
      183           v-replace-string = replace(v-replace-string, ',', '')
      184         .
      185       end.
      186       else do:
      187         if index(v-replace-string, ',') > 0
      188         then do:
      189           assign
      190             p-value      = ?
      191             p-data-valid = false
      192             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      193                                     + "Задан параметр недопустимости знака разделителя тысяч."
      194                                     + "Строка содержит знак разделителя тысяч. "
      195                                     ,p-string
      196                                     )
      197           .
      198           return .
      199         end.
      200       end.
      201       if index(p-string, '.') > 0
      202       then do:
      203         assign
      204           p-value      = ?
      205           p-data-valid = false
      206           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      207                                    + "Строка содержит знак десятичной точки"
      208                                    ,p-string
      209                                    )
      210         .
      211         return .
      212       end.
      213       if v-replace-string <> fill('9', length(v-replace-string))
      214       then do:
      215         assign
      216           p-value      = ?
      217           p-data-valid = false
      218           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      219                                    + "Встречены символы, недопустимые для целого числа '&2'"
      220                                    ,p-string
      221                                    ,replace(v-replace-string, '9', '')
      222                                    )
      223         .
      224         return .
      225       end.
      226       assign
      227         p-data-valid = true
      228         p-message    = ""
      229       .
      230     end.
      231   end procedure.
      232   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   define new global shared variable g#libthpos as handle no-undo .
      234   do
      235   on error undo, return error return-value
      236   :
      237     define variable v-sendmemptr  as memptr   no-undo .
      238     define variable hdocument as handle    no-undo .
      239     define variable hroot     as handle    no-undo .
      240     define variable hchild    as handle    no-undo .
      241     define variable htext     as handle    no-undo .
      242     define variable icounter        as integer   no-undo .
      243     define variable v-ok          as logical   no-undo .
      244     define variable v-message     as longchar  no-undo .
      245     define variable v-err-message as character no-undo .
      246     define variable v-doc-code          as character no-undo .
      247     define variable v-exch-rate         as decimal   no-undo .
      248     define variable v-exch-scale        as integer   no-undo .
      249     define variable v-cash-rate         as decimal   no-undo .
      250     define variable v-cash-scale        as integer   no-undo .
      251     run check-data in this-procedure ( output v-ok
      252                                      , output v-err-message
      253                                      , output v-doc-code
      254                                      , output v-exch-rate
      255                                      , output v-exch-scale
      256                                      , output v-cash-rate
      257                                      , output v-cash-scale
      258                                      ) .
      259     create x-document hdocument.
      260     create x-noderef hroot.
      261     create x-noderef hchild.
      262     create x-noderef htext.
      263     hdocument:encoding = "UTF-8" .
      264     hdocument:CREATE-NODE(hRoot,"msg","ELEMENT").
      265     hdocument:APPEND-CHILD(hRoot).
      266     hdocument:create-node(hChild, "stts", "ELEMENT").
      267     hRoot:append-child(hChild).
      268     hdocument:create-node(hText, "", "TEXT").
      269     hChild:append-child(hText).
      270     hText:node-value = substitute( "&1" , (if v-ok then 0 else 1)).
      271     hdocument:create-node(hChild, "errmsg", "ELEMENT").
      272     hRoot:append-child(hChild).
      273     hdocument:create-node(hText, "", "TEXT").
      274     hChild:append-child(hText).
      275     hText:node-value = v-err-message .
      276     hdocument:create-node(hChild, "deviceid", "ELEMENT").
      277     hRoot:append-child(hChild).
      278     hdocument:create-node(hText, "", "TEXT").
      279     hChild:append-child(hText).
      280     hText:node-value = p-device-id.
      281     hdocument:create-node(hChild, "chkcode", "ELEMENT").
      282     hRoot:append-child(hChild).
      283     hdocument:create-node(hText, "", "TEXT").
      284     hChild:append-child(hText).
      285     hText:node-value = v-doc-code .
      286     hdocument:create-node(hChild, "exchrate", "ELEMENT").
      287     hRoot:append-child(hChild).
      288     hdocument:create-node(hText, "", "TEXT").
      289     hChild:append-child(hText).
      290     hText:node-value = string(v-exch-rate) .
      291     hdocument:create-node(hChild, "exchscale", "ELEMENT").
      292     hRoot:append-child(hChild).
      293     hdocument:create-node(hText, "", "TEXT").
      294     hChild:append-child(hText).
      295     hText:node-value = string(v-exch-scale) .
      296     hdocument:create-node(hChild, "cashrate", "ELEMENT").
      297     hRoot:append-child(hChild).
      298     hdocument:create-node(hText, "", "TEXT").
      299     hChild:append-child(hText).
      300     hText:node-value = string(v-cash-rate) .
      301     hdocument:create-node(hChild, "cashscale", "ELEMENT").
      302     hRoot:append-child(hChild).
      303     hdocument:create-node(hText, "", "TEXT").
      304     hChild:append-child(hText).
      305     hText:node-value = string(v-cash-scale) .
      306     hdocument:save("LONGCHAR", v-message).
      307     delete object hdocument .
      308     delete object hroot     .
      309     delete object hchild    .
      310     delete object htext     .
      311     assign
      312       hdocument      = ?
      313       hroot          = ?
      314       hchild         = ?
      315       htext          = ?
      316       p-send-message = v-message
      317     .
      318   end.
      319   procedure check-data :
      320     define output parameter p-data-valid    as logical   no-undo .
      321     define output parameter p-error-message as character no-undo .
      322     define output parameter p-doc-code      as character no-undo .
      323     define output parameter p-exch-rate     as decimal   no-undo .
      324     define output parameter p-exch-scale    as integer   no-undo .
      325     define output parameter p-cash-rate     as decimal   no-undo .
      326     define output parameter p-cash-scale    as integer   no-undo .
      327     define buffer buf_clients       for ub.clients .
      328     define buffer buf_sysconf       for ub.sysconf .
      329     define buffer buf_sys-ctrl      for ub.sys-ctrl .
      330     define buffer buf_user-login    for ub.user-login .
      331     define buffer buf_user-account  for ub.user-account.
      332     define buffer buf_staff         for ub.staff.
      333   do
      334   on error undo, return error return-value
      335   :
      336     find first buf_sys-ctrl no-lock .
      337     find first buf_user-login no-lock
      338       where buf_user-login.db-num     = buf_sys-ctrl.db-num
      339         and buf_user-login.status_    = 0
      340         and buf_user-login.user-login = p-user-login
      341       no-error .
      342     if not available buf_user-login
      343     then do:
      344       assign
      345         p-data-valid    = false
      346         p-error-message = substitute("Неизвестный пользователь &1"
      347                                     , p-user-login
      348                                     )
      349       .
      350       return .
      351     end.
      352     define variable v-obj-code      as integer   no-undo .
      353     define variable v-data-valid    as logical   no-undo .
      354     define variable v-error-message as character no-undo .
      355     find first buf_clients no-lock
      356       where buf_clients.obj-type = p-obj-type
      357         and buf_clients.obj-code = p-obj-code
      358       no-error .
      359     if not available buf_clients
      360     then do:
      361       assign
      362         p-data-valid    = false
      363         p-error-message = substitute( "Не найден объект &1 &2"
      364                                     , p-obj-type
      365                                     , p-obj-code
      366                                     )
      367       .
      368       return .
      369     end.
      370     if  p-obj-type <> 'маг':U
      371     and p-obj-type <> 'скл':U
      372     then do:
      373       assign
      374         p-data-valid    = false
      375         p-error-message = substitute("Неправильный тип объекта &1 &2"
      376                                     , p-obj-type
      377                                     , p-obj-code
      378                                     )
      379       .
      380       return .
      381     end.
      382     define variable v-host-code as integer   no-undo .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      385     (input  buf_clients.obj-type
      386     ,input  buf_clients.obj-code
      387     ,output v-host-code
      388     )  .
      389     define variable v-object-available as logical   no-undo .
      390   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      392     (input  buf_sys-ctrl.db-num
      393     ,input  0
      394     ,input  buf_user-login.user-id
      395     ,input  buf_clients.obj-type
      396     ,input  buf_clients.obj-code
      397     ,output v-object-available
      398     )  .
      399     if v-object-available <> true
      400     then do:
      401       assign
      402         p-data-valid    = false
      403         p-error-message = substitute("Пользователю не доступен объект &1 &2"
      404                                     ,buf_clients.obj-type
      405                                     ,buf_clients.obj-code
      406                                     )
      407       .
      408       return .
      409     end.
      410     define variable v-serial-code       as character no-undo .
      411     define variable v-r-b               as character no-undo .
      412     define variable v-base-code         as integer   no-undo .
      413     define variable v-cash-num          as integer   no-undo .
      414     define variable v-pos-type          as character no-undo .
      415     define variable v-chk-type          as integer   no-undo .
      416     define variable v-cashier           as integer   no-undo .
      417     define variable v-cashier-psn-code  as integer   no-undo .
      418     define variable v-doc-code          as character no-undo .
      419     define variable v-exch-rate         as decimal   no-undo .
      420     define variable v-exch-scale        as integer   no-undo .
      421     define variable v-cash-rate         as decimal   no-undo .
      422     define variable v-cash-scale        as integer   no-undo .
      423     assign
      424       v-pos-type = 'IBS-TH-MOB':U
      425       v-cash-num = p-pos-num
      426       v-chk-type = integer('201':U)
      427     .
      428     main-block :
      429     do transaction
      430     :
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_create-context in g#libthpos
      433     (input  parparentproc
      434     ,input  ?
      435     ,input  buf_sys-ctrl.db-num
      436     ,input  buf_clients.obj-code
      437     ,input  v-pos-type
      438     ,input  p-pos-num
      439     ,output v-serial-code
      440     ,output v-r-b
      441     ,output v-base-code
      442     ) no-error .
      443       if error-status :error
      444       then do:
      445         assign
      446           p-error-message = substitute( "Ошибка создания контекста кассы.&1&2&1&3&1&4&1&5"
      447                                       , chr(10)
      448                                       , return-value
      449                                       , error-status :get-message(1)
      450                                       , error-status :get-message(2)
      451                                       , error-status :get-message(3)
      452                                       )
      453         .
      454         undo main-block , return .
      455       end.
      456      find first buf_user-account no-lock
      457       where buf_user-account.user-id = buf_user-login.user-id
      458      no-error .
      459      if not available buf_user-account
      460      then do:
      461         assign
      462           p-error-message = substitute( "Не найдена запись user-acount для пользователя id = &1"
      463                                       , buf_user-login.user-id
      464                                       )
      465         .
      466         undo main-block , return .
      467      end.
      468      find first buf_staff no-lock
      469       where buf_staff.role        = 'C':U
      470         and buf_staff.role-level  = 'db':U
      471         and buf_staff.date-start  <= today
      472         and buf_staff.date-end    >= today
      473         and buf_staff.psn-code    = buf_user-account.psn-code
      474         and buf_staff.db-num      = buf_sys-ctrl.db-num
      475      no-error.
      476      if not available buf_staff
      477      then do:
      478         assign
      479           p-error-message = substitute( "Пользователь&1id:&2&1Фамилия:&3&1Псевдоним:&4&1БД:&5&1не является кассиром. Работа с кассой невозможна."
      480                                       , chr(10)
      481                                       , buf_user-account.user-id
      482                                       , buf_user-account.last-name
      483                                       , buf_user-account.nik
      484                                       , buf_sys-ctrl.db-num
      485                                       )
      486         .
      487         undo main-block , return .
      488      end.
      489      assign
      490         v-cashier          = buf_staff.staff-code
      491         v-cashier-psn-code = buf_user-account.psn-code
      492      .
      493   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   if (valid-handle(g#libthpos) <> true) then do:   run str/libthpos.p persistent no-error .   if error-status :error or (valid-handle(g#libthpos) <> true) then do:     message       "Error starting nws/libthpos.p" skip       g#libthpos skip       g#libthpos :type skip       g#libthpos :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libthpos_create-chk-doc in g#libthpos
      495     (input  buf_sys-ctrl.db-num
      496     ,input  buf_clients.obj-code
      497     ,input  v-pos-type
      498     ,input  v-cash-num
      499     ,input  v-chk-type
      500     ,input  v-cashier
      501     ,input  v-cashier-psn-code
      502     ,output v-doc-code
      503     ,output v-exch-rate
      504     ,output v-exch-scale
      505     ,output v-cash-rate
      506     ,output v-cash-scale
      507     ) no-error .
      508       if error-status:error then do:
      509         assign
      510           p-error-message = substitute( "Ошибка открытия чека.&1&2&1&3&1&4&1&5"
      511                                       , chr(10)
      512                                       , return-value
      513                                       , error-status :get-message(1)
      514                                       , error-status :get-message(2)
      515                                       , error-status :get-message(3)
      516                                       )
      517         .
      518         undo main-block , return .
      519       end.
      520     end.
      521     assign
      522       p-data-valid    = true
      523       p-error-message = ""
      524       p-doc-code      = v-doc-code
      525       p-exch-rate     = v-exch-rate
      526       p-exch-scale    = v-exch-scale
      527       p-cash-rate     = v-cash-rate
      528       p-cash-scale    = v-cash-scale
      529     .
      530   end.
      531   end procedure.
