        1   define variable vss-include-info0 as character format "X(65)" no-undo
        2   initial "@(#)$Workfile$ $Revision$".
        3   define temp-table temp_onewin_items no-undo
        4       field itm-key       as integer
        5       field itmExtKey     as character
        6       field itmName       as character
        7       field itmDesc       as character
        8       field itmSelected   as logical
        9       index pi is primary unique
       10           itm-key
       11       index ie
       12           itmExtKey
       13   .
       14   define temp-table temp_onewin_itemsSelected no-undo
       15       field its-key   as integer
       16       field itm-key   as integer
       17       field itmExtKey as character
       18       index pi is primary unique
       19           its-key
       20       index im
       21           itm-key
       22   .
       23   define variable v-onewin0-itm-key    as integer      no-undo.
       24   procedure onewin_clear :
       25       define buffer buf_temp_onewin_items        for temp_onewin_items.
       26   do
       27   for buf_temp_onewin_items
       28   on error undo, return error
       29   :
       30       empty temp-table buf_temp_onewin_items.
       31   end.
       32   end procedure.
       33   procedure onewin_add-item :
       34   define input parameter p-ext-key   as character        no-undo.
       35   define input parameter p-item-name as character        no-undo.
       36   define input parameter p-item-desc as character        no-undo.
       37   define input parameter p-selected  as logical          no-undo.
       38       define buffer buf_temp_onewin_items        for temp_onewin_items.
       39   do
       40   for buf_temp_onewin_items
       41   on error undo, return error
       42   :
       43       find last buf_temp_onewin_items no-error.
       44       if available buf_temp_onewin_items then do:
       45         v-onewin0-itm-key = buf_temp_onewin_items.itm-key.
       46       end.
       47       else do:
       48         v-onewin0-itm-key = 0.
       49       end.
       50       assign
       51           v-onewin0-itm-key = v-onewin0-itm-key + 1
       52       .
       53       create buf_temp_onewin_items.
       54       assign
       55       buf_temp_onewin_items.itm-key      = v-onewin0-itm-key
       56       buf_temp_onewin_items.itmExtKey    = p-ext-key
       57       buf_temp_onewin_items.itmName      = p-item-name
       58       buf_temp_onewin_items.itmDesc      = p-item-desc
       59       buf_temp_onewin_items.itmSelected  = p-selected
       60       .
       61       if p-selected then do:
       62         run onewin_create-selection  in this-procedure ( input v-onewin0-itm-key
       63                                                         ,input p-ext-key).
       64       end.
       65   end.
       66   end procedure.
       67   procedure onewin_create-selection :
       68   define input parameter p-itm-key as integer no-undo .
       69   define input parameter p-itmextkey as character no-undo .
       70   define variable v-counter as integer no-undo .
       71   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
       72   do
       73   on error undo, return error
       74   :
       75     find last buf_temp_onewin_itemsSelected use-index pi no-error.
       76     if available buf_temp_onewin_itemsSelected then do:
       77       v-counter = buf_temp_onewin_itemsSelected.its-key.
       78     end.
       79     find first buf_temp_onewin_itemsSelected where
       80          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
       81     if not available buf_temp_onewin_itemsSelected then do:
       82       create buf_temp_onewin_itemsSelected.
       83       assign
       84       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
       85       v-counter = v-counter + 1
       86       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
       87       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
       88       .
       89     end.
       90   end.
       91   end procedure.
       92   procedure onewin_check-item :
       93   define input parameter p-ext-key   as character        no-undo.
       94   define output parameter p-exists as logical no-undo .
       95   define buffer buf_temp_onewin_items for temp_onewin_items.
       96   find first buf_temp_onewin_items where
       97   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
       98   if available buf_temp_onewin_items then do:
       99     p-exists = yes.
      100   end.
      101   end procedure.
      102   define input parameter parparentproc    as widget-handle    no-undo.
      103   define input parameter p-mode               as integer          no-undo.
      104   define input parameter p-title              as character        no-undo.
      105   define input parameter p-runfilename        as character        no-undo.
      106   define input parameter p-runfilelabel       as character        no-undo.
      107   define input parameter table for temp_onewin_items .
      108   define output parameter table for temp_onewin_itemsSelected .
      109   define output parameter p-cur-ext-key       as character        no-undo.
      110   define output parameter p-accepted          as logical          no-undo.
      111   define variable vss-revision    as character no-undo init "$Revision$":U .
      112   define variable vss-author      as character no-undo init "$Author$":U .
      113   define variable vss-date        as character no-undo init "$Date$":U .
      114   define variable vss-workfile    as character no-undo init "$Workfile$":U .
      115   define variable vss-archive     as character no-undo init "$Archive$":U .
      116   define variable vss-description as character no-undo init "Однооконный интерфейс для выбора из небольшого количества записей".
      117   procedure vss-get-info :
      118     define output parameter p-vss-revision    like vss-revision    no-undo .
      119     define output parameter p-vss-author      like vss-author      no-undo .
      120     define output parameter p-vss-date        like vss-date        no-undo .
      121     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      122     define output parameter p-vss-archive     like vss-archive     no-undo .
      123     define output parameter p-vss-description like vss-description no-undo .
      124     assign
      125       p-vss-revision    = vss-revision
      126       p-vss-author      = vss-author
      127       p-vss-date        = vss-date
      128       p-vss-workfile    = vss-workfile
      129       p-vss-archive     = vss-archive
      130       p-vss-description = vss-description
      131     .
      132   end procedure.
      133   procedure vss-get-parameters :
      134     define output parameter p-vss-parameters as character no-undo .
      135   end procedure.
      136   define new global shared variable g#vssrevis-logger as handle    no-undo .
      137   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      138   define variable v-vssrevis-logger                   as handle    no-undo .
      139   procedure vss-logevent :
      140     define input  parameter p-extra-paramters as character no-undo .
      141     define variable v-vssrevis-parameters as character no-undo .
      142     do
      143     on error undo, return error return-value
      144     :
      145       if  valid-handle(v-vssrevis-logger)
      146       and v-vssrevis-logger :get-signature("logevent") <> ""
      147       then do:
      148         run vss-get-parameters in this-procedure
      149           (output v-vssrevis-parameters
      150           ).
      151         run logevent in v-vssrevis-logger
      152           (input vss-workfile
      153           ,input vss-revision
      154           ,input v-vssrevis-parameters
      155           ,input p-extra-paramters
      156           ).
      157       end.
      158     end.
      159   end procedure.
      160   assign
      161     v-vssrevis-logger = g#vssrevis-logger
      162   .
      163   if  valid-handle(v-vssrevis-logger)
      164   and v-vssrevis-logger :get-signature("logevent") <> ""
      165   then do:
      166     assign
      167       v-vssrevis-logevent = true
      168     .
      169     run vss-logevent in this-procedure (input vss-description) .
      170   end.
      171   define new global shared variable g#language as character no-undo .
      172   if g#language <> '' and g#language <> 'rus':U then do:
      173     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      174   end.
      175   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      177   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      178   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      179   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      180   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      181   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      182   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      183   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      184   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      185   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      186   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      187   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      188   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      189   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      190   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      191   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      192   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      193   procedure proc-alt-shift-f2:
      194     if not ibs.th.gbl.gbl-var:rcode
      195   then
      196     run gbl\inidebug.p .
      197   end.
      198   procedure proc-alt-shift-f3:
      199     run gbl/prvssinf.p
      200       ( input this-procedure
      201       ) .
      202   end.
      203   define variable v-inform-launched as logical no-undo initial false .
      204   procedure proc-alt-shift-f4:
      205     define variable v-action as character no-undo .
      206     if v-inform-launched = false then do:
      207       assign
      208         v-inform-launched = true
      209       .
      210       run gbl/d-inform.w
      211         (  input self
      212         ,  input this-procedure
      213         , output v-action
      214         ) no-error .
      215       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      216       assign
      217         v-inform-launched = false
      218       .
      219     end.
      220   end.
      221   procedure proc-alt-f1:
      222     run gbl/corrhelp.p
      223       (input this-procedure
      224       ) .
      225   end .
      226   on alt-shift-f2 anywhere do:
      227     run proc-alt-shift-f2.
      228   end.
      229   on alt-shift-f3 anywhere do:
      230     run proc-alt-shift-f3 in this-procedure .
      231   end.
      232   on alt-shift-f4 anywhere do:
      233     run proc-alt-shift-f4 in this-procedure.
      234   end.
      235   on alt-f1 anywhere do:
      236     run proc-alt-f1 in this-procedure .
      237   end.
      238   define variable v-onewin-close-enabled      as logical      no-undo.
      239   define variable v-onewin-selected-rowid     as rowid        no-undo.
      240   DEFINE VARIABLE v-parent-handle AS HANDLE NO-UNDO.
      241   define buffer buf_right_temp_onewin_items             for temp_onewin_items.
      242   define buffer buf_left_temp_onewin_items              for temp_onewin_items.
      243   define buffer buf_temp_onewin_itemsSelected           for temp_onewin_itemsSelected.
      244   DEFINE BUTTON B-add
      245        LABEL "&Добавить"
      246        SIZE 10 BY 1.
      247   DEFINE BUTTON b-close AUTO-END-KEY DEFAULT
      248        LABEL "&Отмена"
      249        SIZE 10 BY 1
      250        BGCOLOR 8 .
      251   DEFINE BUTTON B-del
      252        LABEL "&Удалить"
      253        SIZE 10 BY 1.
      254   DEFINE BUTTON b-down
      255        IMAGE-UP FILE "btn-down-arrow":U
      256        IMAGE-DOWN FILE "btn-down-arrow":U
      257        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      258        LABEL ""
      259        SIZE 4.1 BY 1.
      260   DEFINE BUTTON b-exit AUTO-GO
      261        LABEL "&Ввод"
      262        SIZE 10 BY 1
      263        BGCOLOR 8 .
      264   DEFINE BUTTON b-help
      265        LABEL "Помощ&ь"
      266        SIZE 3 BY 1
      267        BGCOLOR 8 .
      268   DEFINE BUTTON b-up
      269        IMAGE-UP FILE "btn-up-arrow":U
      270        IMAGE-DOWN FILE "btn-up-arrow":U
      271        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      272        LABEL ""
      273        SIZE 4.1 BY 1.
      274   DEFINE BUTTON bt-filter DEFAULT
      275        LABEL "&ФПоиск"
      276        SIZE 10 BY 1 TOOLTIP "Поиск с фильтром строки во всех текстовых полях"
      277        BGCOLOR 8 .
      278   DEFINE BUTTON bt-not-sel-all
      279        LABEL "&+"
      280        SIZE 3 BY 1 TOOLTIP "Выбрать все".
      281   DEFINE BUTTON bt-not-sel-desel-all
      282        LABEL "-"
      283        SIZE 3 BY 1 TOOLTIP "Отменить выбор".
      284   DEFINE BUTTON bt-not-sel-reverse
      285        LABEL "/"
      286        SIZE 3 BY 1 TOOLTIP "Инвертировать выбор".
      287   DEFINE BUTTON bt-not-sel-sel
      288        LABEL "&*"
      289        SIZE 3 BY 1 TOOLTIP "Выбрать".
      290   DEFINE BUTTON bt-properties DEFAULT
      291        LABEL "&Свойства"
      292        SIZE 15 BY 1
      293        BGCOLOR 8 .
      294   DEFINE VARIABLE ed-desc-not-sel AS CHARACTER
      295        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      296        SIZE 62 BY 2.5
      297        FGCOLOR 4  NO-UNDO.
      298   DEFINE VARIABLE fi-filter AS CHARACTER FORMAT "X(256)":U
      299        VIEW-AS FILL-IN
      300        SIZE 18 BY 1 NO-UNDO.
      301   DEFINE VARIABLE tb-filter AS LOGICAL INITIAL no
      302        LABEL ""
      303        VIEW-AS TOGGLE-BOX
      304        SIZE 2.6 BY .8 NO-UNDO.
      305   DEFINE QUERY br-table FOR
      306         buf_right_temp_onewin_items SCROLLING.
      307   DEFINE BROWSE br-table
      308     QUERY br-table NO-LOCK DISPLAY
      309         buf_right_temp_onewin_items.itmSelected column-label " *" format " */  "
      310         buf_right_temp_onewin_items.itmName column-label " Список" format "X(40)"
      311       WITH NO-LABELS NO-ROW-MARKERS SEPARATORS SIZE 62 BY 17.07 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      312   DEFINE FRAME Dialog-Frame
      313        b-exit AT ROW 1 COL 2 NO-TAB-STOP
      314        b-close AT ROW 1 COL 12 NO-TAB-STOP
      315        bt-filter AT ROW 1 COL 22 NO-TAB-STOP
      316        fi-filter AT ROW 1 COL 30.3 COLON-ALIGNED NO-LABEL
      317        tb-filter AT ROW 1 COL 51.3
      318        B-add AT ROW 1 COL 54 WIDGET-ID 6
      319        B-del AT ROW 1 COL 64 WIDGET-ID 8
      320        b-help AT ROW 1 COL 74 NO-TAB-STOP
      321        bt-not-sel-sel AT ROW 2.43 COL 2 NO-TAB-STOP
      322        bt-not-sel-all AT ROW 2.43 COL 5 NO-TAB-STOP
      323        bt-not-sel-desel-all AT ROW 2.43 COL 8 NO-TAB-STOP
      324        bt-not-sel-reverse AT ROW 2.43 COL 11 NO-TAB-STOP
      325        bt-properties AT ROW 2.5 COL 49 NO-TAB-STOP
      326        br-table AT ROW 3.67 COL 2
      327        b-up AT ROW 7.4 COL 71 WIDGET-ID 2 NO-TAB-STOP
      328        b-down AT ROW 8.47 COL 71 WIDGET-ID 4 NO-TAB-STOP
      329        ed-desc-not-sel AT ROW 21 COL 2 NO-LABEL NO-TAB-STOP
      330        SPACE(13.69) SKIP(0.26)
      331       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      332            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      333            TITLE "Выбор из списка"
      334            CANCEL-BUTTON b-close.
      335   ASSIGN
      336          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      337          FRAME Dialog-Frame:HIDDEN           = TRUE.
      338   ASSIGN
      339          bt-filter:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      340   ASSIGN
      341          bt-properties:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      342   ASSIGN
      343          ed-desc-not-sel:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      344   ASSIGN
      345          fi-filter:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      346   ON GO OF FRAME Dialog-Frame
      347   DO:
      348       if v-onewin-close-enabled = no
      349       then do:
      350           undo, return no-apply.
      351       end.
      352       else do:
      353           assign
      354               p-accepted = yes
      355           .
      356           run check-data in this-procedure.
      357           run assign-export-table in this-procedure .
      358           assign
      359               p-cur-ext-key = ( if available buf_right_temp_onewin_items then buf_right_temp_onewin_items.itmExtKey else "":U )
      360           .
      361       end.
      362   END.
      363   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      364   DO:
      365       APPLY "END-ERROR":U TO SELF.
      366   END.
      367   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      368   DO:
      369     RUN onewin_custom-add-item IN v-parent-handle ( input this-procedure:handle  ) NO-ERROR.
      370     IF ERROR-STATUS:ERROR THEN DO:
      371        RETURN NO-APPLY.
      372     END.
      373     run local-open-query in this-procedure .
      374   END.
      375   ON CHOOSE OF b-close IN FRAME Dialog-Frame
      376   DO:
      377       assign
      378           v-onewin-close-enabled  = yes
      379           p-accepted              = no
      380       .
      381   END.
      382   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      383   DO:
      384   DEFINE buffer dEL_temp_onewin_items FOR temp_onewin_items.
      385     IF NOT AVAILABLE buf_right_temp_onewin_items THEN DO:
      386        RETURN NO-APPLY.
      387     END.
      388     find first dEL_temp_onewin_items where recid(dEL_temp_onewin_items) = recid(buf_right_temp_onewin_items).
      389     DELETE del_temp_onewin_items.
      390     run local-open-query in this-procedure .
      391   END.
      392   ON CHOOSE OF b-down IN FRAME Dialog-Frame
      393   DO:
      394   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   if lookup(self :type
      396            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      397            ) = 0
      398   then do:
      399     message
      400       "$Workfile$"
      401       "Указанному интерфейсному элементу фокус не может быть передан" skip
      402       "Интерфейсный элемент" self :name  skip
      403       "Тип" self :type  skip
      404       "Процедура" this-procedure :file-name skip
      405       view-as alert-box .
      406   end.
      407   else do:
      408     apply "entry":u to self  .
      409     if focus :handle <> self :handle  then do:
      410       return no-apply .
      411     end.
      412   end.
      413   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      414   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      415   define variable v-rec as recid no-undo .
      416   DEFINE BUFFER down_right_temp_onewin_items FOR temp_onewin_items.
      417   IF NOT AVAILABLE buf_right_temp_onewin_items THEN RETURN NO-APPLY.
      418   FIND last down_right_temp_onewin_items WHERE
      419               USE-INDEX pi .
      420    IF buf_right_temp_onewin_items.itm-key = down_right_temp_onewin_items.itm-key THEN DO:
      421        BELL.
      422        RETURN NO-APPLY.
      423    END.
      424    ASSIGN
      425    v-rec = recid(buf_right_temp_onewin_items)
      426    v-old = buf_right_temp_onewin_items.itm-key
      427    .
      428    FIND FIRST down_right_temp_onewin_items WHERE
      429               down_right_temp_onewin_items.itm-key > v-old use-index pi NO-ERROR.
      430    if available down_right_temp_onewin_items then do:
      431      v-new = down_right_temp_onewin_items.itm-key.
      432    end.
      433    else do:
      434      bell.
      435      return no-apply.
      436    end.
      437    ASSIGN
      438    buf_right_temp_onewin_items.itm-key = 0.
      439    RELEASE buf_right_temp_onewin_items.
      440    down_right_temp_onewin_items.itm-key = v-old.
      441    RELEASE down_right_temp_onewin_items.
      442    FIND FIRST down_right_temp_onewin_items WHERE
      443               down_right_temp_onewin_items.itm-key = 0.
      444    ASSIGN
      445    down_right_temp_onewin_items.itm-key = v-new.
      446    RELEASE down_right_temp_onewin_items.
      447    run local-open-query in this-procedure .
      448    reposition br-table to recid v-rec.
      449   END.
      450   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      451   or F2 of frame Dialog-Frame anywhere
      452   DO:
      453   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   if lookup(self :type
      455            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      456            ) = 0
      457   then do:
      458     message
      459       "$Workfile$"
      460       "Указанному интерфейсному элементу фокус не может быть передан" skip
      461       "Интерфейсный элемент" self :name  skip
      462       "Тип" self :type  skip
      463       "Процедура" this-procedure :file-name skip
      464       view-as alert-box .
      465   end.
      466   else do:
      467     apply "entry":u to self  .
      468     if focus :handle <> self :handle  then do:
      469       return no-apply .
      470     end.
      471   end.
      472       assign
      473           v-onewin-close-enabled = yes
      474       .
      475   END.
      476   ON CHOOSE OF b-up IN FRAME Dialog-Frame
      477   DO:
      478   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   if lookup(self :type
      480            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      481            ) = 0
      482   then do:
      483     message
      484       "$Workfile$"
      485       "Указанному интерфейсному элементу фокус не может быть передан" skip
      486       "Интерфейсный элемент" self :name  skip
      487       "Тип" self :type  skip
      488       "Процедура" this-procedure :file-name skip
      489       view-as alert-box .
      490   end.
      491   else do:
      492     apply "entry":u to self  .
      493     if focus :handle <> self :handle  then do:
      494       return no-apply .
      495     end.
      496   end.
      497   DEFINE VARIABLE v-new AS INTEGER NO-UNDO.
      498   DEFINE VARIABLE v-old AS INTEGER NO-UNDO.
      499   define variable v-rec as recid no-undo .
      500   DEFINE BUFFER up_right_temp_onewin_items FOR temp_onewin_items.
      501   IF NOT AVAILABLE buf_right_temp_onewin_items THEN RETURN NO-APPLY.
      502   IF buf_right_temp_onewin_items.itm-key = 1 THEN DO:
      503     BELL.
      504     RETURN NO-APPLY.
      505   END.
      506   ASSIGN
      507   v-rec = recid(buf_right_temp_onewin_items)
      508   v-old = buf_right_temp_onewin_items.itm-key
      509   .
      510   FIND last up_right_temp_onewin_items WHERE
      511             up_right_temp_onewin_items.itm-key < v-old use-index pi NO-ERROR.
      512   if available up_right_temp_onewin_items then do:
      513     v-new = up_right_temp_onewin_items.itm-key.
      514   end.
      515   else do:
      516     bell.
      517     return no-apply.
      518   end.
      519   ASSIGN
      520   buf_right_temp_onewin_items.itm-key = 0.
      521   RELEASE buf_right_temp_onewin_items.
      522   up_right_temp_onewin_items.itm-key = v-old.
      523   RELEASE up_right_temp_onewin_items.
      524   FIND FIRST up_right_temp_onewin_items WHERE
      525             up_right_temp_onewin_items.itm-key = 0.
      526   ASSIGN
      527   up_right_temp_onewin_items.itm-key = v-new.
      528   RELEASE up_right_temp_onewin_items.
      529   run local-open-query in this-procedure .
      530   reposition br-table to recid v-rec.
      531   END.
      532   ON insert-mode OF br-table IN FRAME Dialog-Frame
      533   or " " of br-table in frame dialog-frame
      534   DO:
      535       if p-mode = 1
      536       then do:
      537         apply "choose":u to bt-not-sel-sel.
      538       end.
      539   END.
      540   ON MOUSE-SELECT-CLICK OF br-table IN FRAME Dialog-Frame
      541   DO:
      542       if p-mode = 1
      543       and buf_right_temp_onewin_items.itmselected:visible in browse br-table
      544       then do:
      545           if available buf_right_temp_onewin_items
      546           then do:
      547               assign
      548                   buf_right_temp_onewin_items.itmSelected = not( buf_right_temp_onewin_items.itmSelected )
      549               .
      550               display
      551                   itmSelected
      552               with browse br-table .
      553               apply "entry" to br-table.
      554           end.
      555       end.
      556   END.
      557   ON ROW-DISPLAY OF br-table IN FRAME Dialog-Frame
      558   DO:
      559       define buffer buf_temp_onewin_itemsSelected    for temp_onewin_itemsSelected.
      560       if available buf_right_temp_onewin_items
      561       then do:
      562           find first buf_temp_onewin_itemsSelected
      563                where buf_temp_onewin_itemsSelected.itm-key = buf_right_temp_onewin_items.itm-key
      564           no-error.
      565           if available buf_temp_onewin_itemsSelected
      566           then do:
      567               assign
      568                   buf_right_temp_onewin_items.itmName :bgcolor in browse br-table = GRAY_COLOR
      569                   buf_right_temp_onewin_items.itmSelected :bgcolor in browse br-table = GRAY_COLOR
      570               .
      571           end.
      572       end.
      573   END.
      574   ON VALUE-CHANGED OF br-table IN FRAME Dialog-Frame
      575   or entry of br-table IN FRAME Dialog-Frame
      576   DO:
      577       if available buf_right_temp_onewin_items
      578       then do:
      579           assign
      580               ed-desc-not-sel = buf_right_temp_onewin_items.itmDesc
      581           .
      582       end.
      583       else do:
      584           assign
      585               ed-desc-not-sel = "":U
      586           .
      587       end.
      588       display
      589           ed-desc-not-sel
      590       with frame Dialog-Frame.
      591   END.
      592   ON CHOOSE OF bt-filter IN FRAME Dialog-Frame
      593   DO:
      594       define variable v-new-filter    as character    no-undo.
      595       define variable v-accepted      as logical      no-undo.
      596       run gbl/onewinf.w (
      597             input fi-filter
      598           , output v-new-filter
      599           , output v-accepted
      600       ).
      601       if v-accepted = yes
      602       then do:
      603           assign
      604               fi-filter = v-new-filter
      605           .
      606           if fi-filter = "":U
      607           then do:
      608               assign
      609                   tb-filter = no
      610               .
      611           end.
      612           else do:
      613               assign
      614                   tb-filter = yes
      615               .
      616           end.
      617           display
      618               fi-filter
      619               tb-filter
      620           with frame Dialog-Frame.
      621           run local-open-query in this-procedure .
      622           apply "entry":U to br-table.
      623       end.
      624   END.
      625   ON CHOOSE OF bt-not-sel-all IN FRAME Dialog-Frame
      626   DO:
      627       if fi-filter = "":U
      628       or tb-filter = no
      629       then do:
      630           for each buf_right_temp_onewin_items
      631              where buf_right_temp_onewin_items.itmSelected = no
      632           :
      633               assign
      634                   buf_right_temp_onewin_items.itmSelected = yes
      635               .
      636           end.
      637       end.
      638       else do:
      639           for each buf_right_temp_onewin_items
      640              where buf_right_temp_onewin_items.itmSelected = no
      641                and index( buf_right_temp_onewin_items.itmName, fi-filter ) <> 0
      642           :
      643               assign
      644                   buf_right_temp_onewin_items.itmSelected = yes
      645               .
      646           end.
      647       end.
      648       br-table :refresh().
      649       apply "entry" to br-table.
      650   END.
      651   ON CHOOSE OF bt-not-sel-desel-all IN FRAME Dialog-Frame
      652   DO:
      653       for each buf_right_temp_onewin_items
      654       :
      655           assign
      656               buf_right_temp_onewin_items.itmSelected = no
      657           .
      658       end.
      659       br-table :refresh().
      660       apply "entry" to br-table.
      661   END.
      662   ON CHOOSE OF bt-not-sel-reverse IN FRAME Dialog-Frame
      663   DO:
      664       for each buf_right_temp_onewin_items
      665       :
      666           assign
      667               buf_right_temp_onewin_items.itmSelected = not( buf_right_temp_onewin_items.itmSelected )
      668           .
      669       end.
      670       br-table :refresh().
      671       apply "entry" to br-table.
      672   END.
      673   ON CHOOSE OF bt-not-sel-sel IN FRAME Dialog-Frame
      674   DO:
      675       if available buf_right_temp_onewin_items
      676       then do:
      677           assign
      678               buf_right_temp_onewin_items.itmSelected = not( buf_right_temp_onewin_items.itmSelected )
      679           .
      680           display
      681               itmSelected
      682           with browse br-table .
      683           run select-and-move-down in this-procedure (
      684                 input browse br-table :handle
      685               , input query br-table :handle
      686           ).
      687           apply "entry" to br-table.
      688       end.
      689   END.
      690   ON CHOOSE OF bt-properties IN FRAME Dialog-Frame
      691   DO:
      692       if available buf_right_temp_onewin_items
      693       then do:
      694           run value( p-runfilename ) (
      695                 input parparentproc
      696               , input buf_right_temp_onewin_items.itmExtKey
      697           ) no-error.
      698           if error-status :error
      699           then do:
      700               message
      701                        vss-workfile vss-revision vss-description
      702                   skip(1)
      703                   skip "Ошибка выполнения процедуры" p-runfilename
      704                   skip return-value
      705                   skip trim( error-status :get-message( 1 ) )
      706                        trim( error-status :get-message( 2 ) )
      707                        trim( error-status :get-message( 3 ) )
      708               view-as alert-box error.
      709               undo, return no-apply.
      710           end.
      711       end.
      712   END.
      713   ON VALUE-CHANGED OF tb-filter IN FRAME Dialog-Frame
      714   DO:
      715       assign
      716           tb-filter
      717       .
      718       run local-open-query in this-procedure .
      719       apply "entry":U to br-table.
      720   END.
      721   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      722   on help of frame Dialog-Frame
      723   do:
      724     run gbl/app_help.p
      725       (input this-procedure :file-name
      726       ,input ''
      727       ,input ?
      728       ) no-error.
      729     if error-status :error then do:
      730       message
      731         "Ошибка при вызове помощи"
      732         error-status :get-message(1)
      733         view-as alert-box .
      734     end.
      735   end.
      736   run minbtn-set in this-procedure .
      737   on choose of b-help in frame Dialog-Frame
      738   do:
      739     apply "help":u to frame Dialog-Frame .
      740   end.
      741   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   procedure minbtn-set :
      743       do
      744           on error undo, return error return-value
      745           :
      746           define variable ii              as integer       no-undo .
      747           define variable fh              as widget-handle no-undo .
      748           define variable hh              as widget-handle no-undo .
      749           define variable v-h             as handle        extent 4 no-undo .
      750           define variable v-name-button   as character     no-undo .
      751           define variable v-help-old-x    as decimal       no-undo .
      752           define variable v-help-old-y    as decimal       no-undo .
      753           define variable v-help-old-size as decimal       no-undo .
      754           define variable v-frame-width   as decimal       no-undo .
      755           define variable jj              as integer       no-undo .
      756           do
      757               on error undo, return error
      758               :
      759               assign
      760                   v-frame-width = frame Dialog-Frame:width - 0.3
      761                   fh            = frame Dialog-Frame:first-child
      762                   hh            = fh:first-child
      763                   ii            = 1
      764                   .
      765               do while valid-handle(hh):
      766                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      767                   do:
      768                       case lc(hh:name) :
      769                           when "b-help" then
      770                               do:
      771                                   hh:load-image-up("cmp/b-help.bmp":u) .
      772                                   hh:load-image-down("cmp/b-help.bmp":u) .
      773                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      774                                   hh:TOOLTIP = "Помощь" .
      775                                   v-help-old-x = hh:column .
      776                                   v-help-old-y = hh:row    .
      777                                   v-help-old-size = hh:width .
      778                                   hh:width-chars = 2.5 .
      779                               end.
      780                           when "b-print" then
      781                               do:
      782                                   hh:load-image("cmp/b-print.bmp":u) .
      783                                   hh:TOOLTIP = "Печать" .
      784                                   v-h[ii] = hh:handle .
      785                                   ii = ii + 1 .
      786                                   hh:width-chars = 3 .
      787                               end.
      788                           when "b-history" or
      789                           when "b-hist" then
      790                               do:
      791                                   hh:load-image("cmp/b-hist.bmp":u) .
      792                                   hh:TOOLTIP = "История" .
      793                                   v-h[ii] = hh:handle .
      794                                   ii = ii + 1 .
      795                                   hh:width-chars = 3 .
      796                               end.
      797                           when "b-sch" then
      798                               do:
      799                                   hh:load-image("cmp/b-sch.bmp":u) .
      800                                   hh:TOOLTIP = "Установка Фильтра" .
      801                                   v-h[ii] = hh:handle .
      802                                   ii = ii + 1 .
      803                                   hh:width-chars = 3 .
      804                               end.
      805                           when "b-hist-user" then
      806                               do:
      807                                   hh:load-image("cmp/b-hist.bmp":u) .
      808                                   hh:TOOLTIP = "История пользователя" .
      809                                   ii = ii + 1 .
      810                               end.
      811                       end case.
      812                   end.
      813                   hh = hh:next-sibling.
      814               end.
      815               b-help:column = v-frame-width - b-help:width-chars.
      816               jj = 0.
      817               repeat ii = 4 to 1 by -1 :
      818                   if valid-handle (v-h[ii] ) then
      819                   do:
      820                       jj  = jj + 1 .
      821                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      822                       v-h[ii]:row    = v-help-old-y .
      823                   end.
      824               end.
      825           end.
      826       end.
      827   end procedure.
      828   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   on CTRL-F7 of frame Dialog-Frame anywhere do:
      830     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame Dialog-Frame. END.
      831     return no-apply.
      832   end.
      833   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      834   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      835   MAIN-BLOCK:
      836   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      837      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      838     ASSIGN
      839     v-parent-handle = THIS-PROCEDURE:INSTANTIATING-PROCEDURE.
      840     run init-fields in this-procedure.
      841     RUN enable_UI.
      842     run ui-disable-all in this-procedure.
      843     run ui-enable in this-procedure.
      844     apply "entry" to br-table.
      845     WAIT-FOR GO OF FRAME Dialog-Frame.
      846   END.
      847   RUN disable_UI.
      848   PROCEDURE assign-export-table :
      849       define variable v-counter    as integer      no-undo.
      850       define buffer buf_temp_onewin_itemsSelected    for temp_onewin_itemsSelected.
      851       define buffer buf_temp_onewin_items            for temp_onewin_items.
      852   do
      853   for buf_temp_onewin_items
      854     , buf_temp_onewin_itemsSelected
      855   on error undo, return error
      856   :
      857       empty temp-table
      858           buf_temp_onewin_itemsSelected
      859       .
      860       for each buf_temp_onewin_items
      861           where buf_temp_onewin_items.itmSelected = yes
      862       on error undo, return error
      863       :
      864           run onewin_create-selection in this-procedure ( input buf_temp_onewin_items.itm-key
      865                                                          ,input buf_temp_onewin_items.itmExtKey
      866                                                          ).
      867       end.
      868   end.
      869   END PROCEDURE.
      870   PROCEDURE change-properties :
      871   define input parameter p-id     as integer          no-undo.
      872   do
      873   on error undo, return error
      874   :
      875   end.
      876   END PROCEDURE.
      877   PROCEDURE check-data :
      878   do
      879   on error undo, return error
      880   :
      881   end.
      882   END PROCEDURE.
      883   PROCEDURE disable_UI :
      884     HIDE FRAME Dialog-Frame.
      885   END PROCEDURE.
      886   PROCEDURE enable_UI :
      887     DISPLAY fi-filter tb-filter ed-desc-not-sel
      888         WITH FRAME Dialog-Frame.
      889     ENABLE b-exit b-close bt-filter tb-filter B-add B-del b-help bt-properties
      890            br-table b-up b-down ed-desc-not-sel
      891         WITH FRAME Dialog-Frame.
      892     VIEW FRAME Dialog-Frame.
      893     run local-open-query in this-procedure .
      894   END PROCEDURE.
      895   PROCEDURE init-fields :
      896       define variable v-counter    as integer      no-undo.
      897       define buffer buf_temp_onewin_items         for temp_onewin_items.
      898       define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected.
      899   do
      900   for buf_temp_onewin_items
      901     , buf_temp_onewin_itemsSelected
      902   on error undo, return error
      903   :
      904       if p-title <> "":U
      905       then do:
      906           assign
      907               frame Dialog-Frame :title = p-title
      908           .
      909       end.
      910       for each buf_temp_onewin_items
      911          where buf_temp_onewin_items.itmSelected = yes
      912       on error undo, return error
      913       :
      914           assign
      915               v-counter = v-counter + 1
      916           .
      917           create buf_temp_onewin_itemsSelected.
      918           assign
      919               buf_temp_onewin_itemsSelected.its-key   = v-counter
      920               buf_temp_onewin_itemsSelected.itm-key   = buf_temp_onewin_items.itm-key
      921               buf_temp_onewin_itemsSelected.itmExtKey = buf_temp_onewin_items.itmExtKey
      922           .
      923           assign
      924               v-onewin-selected-rowid = rowid( buf_temp_onewin_items )
      925           .
      926           if p-mode = 0
      927           or p-mode = 2
      928           then do:
      929               assign
      930                   buf_temp_onewin_items.itmSelected = no
      931               .
      932           end.
      933       end.
      934   end.
      935   END PROCEDURE.
      936   PROCEDURE local-open-query :
      937   do
      938   with frame Dialog-Frame
      939   on error undo, return error
      940   :
      941   if b-up:visible in frame Dialog-Frame then do:
      942     if fi-filter = "":U
      943     or tb-filter = no
      944     then do:
      945       open query br-table
      946           for each buf_right_temp_onewin_items no-lock
      947           by buf_right_temp_onewin_items.itm-key
      948       .
      949       assign
      950       fi-filter :bgcolor = GREY_COLOR
      951       bt-filter :bgcolor = GREY_COLOR
      952       .
      953     end.
      954     else do:
      955       open query br-table
      956           for each buf_right_temp_onewin_items no-lock
      957               where index( buf_right_temp_onewin_items.itmName, fi-filter ) <> 0
      958           by buf_right_temp_onewin_items.itm-key
      959       .
      960       assign
      961       fi-filter :bgcolor = RED_COLOR
      962       bt-filter :bgcolor = RED_COLOR
      963       .
      964     end.
      965   end.
      966   else do:
      967       if fi-filter = "":U
      968       or tb-filter = no
      969       then do:
      970           open query br-table
      971               for each buf_right_temp_onewin_items no-lock
      972               by buf_right_temp_onewin_items.itmName
      973           .
      974           assign
      975               fi-filter :bgcolor = GREY_COLOR
      976               bt-filter :bgcolor = GREY_COLOR
      977           .
      978       end.
      979       else do:
      980           open query br-table
      981               for each buf_right_temp_onewin_items no-lock
      982                  where index( buf_right_temp_onewin_items.itmName, fi-filter ) <> 0
      983               by buf_right_temp_onewin_items.itmName
      984           .
      985           assign
      986               fi-filter :bgcolor = RED_COLOR
      987               bt-filter :bgcolor = RED_COLOR
      988           .
      989       end.
      990   end.
      991   end.
      992   END PROCEDURE.
      993   PROCEDURE select-and-move-down :
      994   define input parameter p-browse-handle  as handle           no-undo.
      995   define input parameter p-query-handle   as handle           no-undo.
      996       define variable v-focused-row       as integer  no-undo.
      997       define variable v-repositioned-row  as integer  no-undo.
      998   do
      999   with frame Dialog-Frame
     1000   on error undo, return error
     1001   :
     1002           assign
     1003               v-focused-row      = p-browse-handle :focused-row
     1004               v-repositioned-row = p-query-handle  :current-result-row
     1005           .
     1006           p-query-handle :get-next ().
     1007           if p-query-handle :query-off-end = no
     1008           then do:
     1009               if v-focused-row > p-browse-handle :height - 2
     1010               then do:
     1011                   assign
     1012                       v-repositioned-row  = v-repositioned-row + 1
     1013                   .
     1014               end.
     1015               else do:
     1016                   assign
     1017                       v-focused-row       = v-focused-row + 1
     1018                       v-repositioned-row  = v-repositioned-row + 1
     1019                   .
     1020               end.
     1021               p-browse-handle :set-repositioned-row( v-focused-row, "ALWAYS").
     1022               p-query-handle  :reposition-to-row( v-repositioned-row ).
     1023           end.
     1024   end.
     1025   END PROCEDURE.
     1026   PROCEDURE ui-disable-all :
     1027   do
     1028   with frame Dialog-Frame
     1029   on error undo, return error
     1030   :
     1031       disable
     1032           all
     1033           except
     1034               b-exit
     1035               b-help
     1036               br-table
     1037       .
     1038   end.
     1039   END PROCEDURE.
     1040   PROCEDURE ui-enable :
     1041   define variable v-bttns as character no-undo .
     1042   do
     1043   with frame Dialog-Frame
     1044   on error undo, return error
     1045   :
     1046       enable
     1047           bt-filter
     1048           fi-filter
     1049           tb-filter
     1050           ed-desc-not-sel
     1051       .
     1052     case p-mode:
     1053       when 1 then do:
     1054               enable
     1055                   b-close
     1056                   bt-not-sel-sel
     1057                   bt-not-sel-desel-all
     1058                   bt-not-sel-all
     1059                   bt-not-sel-reverse
     1060               .
     1061           end.
     1062         when 2 then do:
     1063               enable
     1064                   b-close
     1065               .
     1066               reposition br-table to rowid( v-onewin-selected-rowid ) no-error.
     1067           end.
     1068         when 0 then do:
     1069               assign
     1070                   b-exit :label = "В&ыход"
     1071               .
     1072           end.
     1073       end case.
     1074       if p-runfilename <> "":U
     1075       then do:
     1076           assign
     1077               bt-properties :visible      = yes
     1078               bt-properties :sensitive    = yes
     1079           .
     1080           if p-runfilelabel <> "":U
     1081           then do:
     1082               assign
     1083                   bt-properties :label = p-runfilelabel
     1084               .
     1085           end.
     1086       end.
     1087       else do:
     1088           assign
     1089               bt-properties :visible      = no
     1090           .
     1091       end.
     1092     IF LOOKUP("onewin_get-bttns", v-parent-handle:INTERNAL-ENTRIES) > 0 THEN DO:
     1093       run onewin_get-bttns in v-parent-handle ( output v-bttns).
     1094       if lookup("bt-not-sel-sel", v-bttns) = 0 then do:
     1095         disable
     1096         bt-not-sel-sel
     1097         with frame Dialog-Frame .
     1098         hide
     1099         bt-not-sel-sel
     1100         in frame Dialog-Frame .
     1101       end.
     1102       if lookup("bt-not-sel-desel-all", v-bttns) = 0 then do:
     1103         disable
     1104         bt-not-sel-desel-all
     1105         with frame Dialog-Frame .
     1106         hide
     1107         bt-not-sel-desel-all
     1108         in frame Dialog-Frame .
     1109       end.
     1110       if lookup("bt-not-sel-all", v-bttns) = 0 then do:
     1111         disable
     1112         bt-not-sel-all
     1113         with frame Dialog-Frame .
     1114         hide
     1115         bt-not-sel-all
     1116         in frame Dialog-Frame .
     1117       end.
     1118       if lookup("bt-not-sel-reverse", v-bttns) = 0 then do:
     1119         disable
     1120         bt-not-sel-reverse
     1121         with frame Dialog-Frame .
     1122         hide
     1123         bt-not-sel-reverse
     1124         in frame Dialog-Frame .
     1125       end.
     1126       IF LOOKUP("b-exit", v-bttns) > 0 THEN DO:
     1127         enable
     1128         b-exit
     1129         with frame Dialog-Frame .
     1130       end.
     1131       else do:
     1132         hide
     1133         b-exit
     1134         in frame Dialog-Frame .
     1135       end.
     1136       IF LOOKUP("onewin_custom-add-item", v-parent-handle:INTERNAL-ENTRIES) > 0
     1137       and lookup("b-add", v-bttns) > 0
     1138       THEN DO:
     1139         enable
     1140         b-add
     1141         with frame Dialog-Frame .
     1142       end.
     1143       else do:
     1144         hide
     1145         b-add
     1146         in frame Dialog-Frame .
     1147       end.
     1148       IF LOOKUP("b-del", v-bttns) > 0 THEN DO:
     1149         enable
     1150         b-del
     1151         with frame Dialog-Frame .
     1152       end.
     1153       else do:
     1154         hide
     1155         b-del
     1156         in frame Dialog-Frame .
     1157       end.
     1158       IF LOOKUP("b-up", v-bttns) > 0 THEN DO:
     1159         enable
     1160         b-up
     1161         with frame Dialog-Frame .
     1162       end.
     1163       else do:
     1164         hide
     1165         b-up
     1166         in frame Dialog-Frame .
     1167       end.
     1168       IF LOOKUP("b-down", v-bttns) > 0 THEN DO:
     1169         enable
     1170         b-down
     1171         with frame Dialog-Frame .
     1172       end.
     1173       else do:
     1174         hide
     1175         b-down
     1176         in frame Dialog-Frame .
     1177       end.
     1178     end.
     1179     if bt-not-sel-sel:visible in frame Dialog-Frame = no
     1180     and bt-not-sel-desel-all:visible in frame Dialog-Frame = no
     1181     and bt-not-sel-all:visible in frame Dialog-Frame = no
     1182     and bt-not-sel-reverse:visible in frame Dialog-Frame = no then do:
     1183       assign
     1184       buf_right_temp_onewin_items.itmselected:visible in browse br-table = no.
     1185     end.
     1186   end.
     1187   END PROCEDURE.
