      597   if not glog then do:
      598     run put-mes(no ,substitute("Вы не имеете прав для работы со сменами.~nОбъект:&1 &2", p-curr-obj-type, p-curr-obj-code),no,"").
      599     return error.
      600   end.
      601   find last open-shift where
      602             open-shift.obj-type = p-curr-obj-type and
      603             open-shift.obj-code = p-curr-obj-code and
      604             open-shift.status_ = 'тек':U
      605             use-index pi no-error.
      606   if available open-shift then do:
