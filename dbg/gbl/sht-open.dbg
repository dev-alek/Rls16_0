      812     end.
      813     if s-date > closed-shift.shift-date then do:
      814       if s-num <> 1 then do:
      815         run put-mes(no ,substitute("Последняя закрытая смена:&1 Порядок: &2~nПоследняя смена закрыта не сегодня.~nНовая смена должна иметь порядок 1."
      816                                ,closed-shift.shift-date
      817                                ,closed-shift.shift-num
      818     ),no,"").
      819         return error.
      820       end.
      821     end.
      822   end.
      823   if s-date > v-sys-date then do:
      824     run put-mes(no ,substitute("Дата смены &1~nДата на сервере &2~n Дата смены не может быть больше даты на сервере"
      825                                ,s-date
      826                                ,v-sys-date
      827     ),no,"").
      828      return error.
      829   end.
      830   if s-date < v-sys-date - 10 and
      831      is-super = no then do:
      832      run put-mes(no ,substitute("Дата смены &1~nДата на сервере &2~n Разница ~nЭта разница должна быть меньше 10 дней!"
      833                                ,s-date
      834                                ,v-sys-date
      835                                ,v-sys-date - s-date
      836     ),no,"").
      837      return error.
      838   end.
      839   if not mBachMode
      840   then do:
      841       run str/dskshtop.p (
      842                        input parparentproc
      843                       ,input no
      844                       ,input p-curr-obj-type
      845                       ,input p-curr-obj-code
      846                       ,input s-date
      847                       ,input s-num
      848           ,input s-name
      849                       ) no-error.
      850       if error-status :error then do:
      851         run put-mes(yes ,"Ошибка при проверке кассовых запретов",yes,return-value).
      852         return error.
      853       end.
      854   end.
      855   if varobj-date - s-date > 4 then do:
      856     run put-mes(no ,substitute("Календарная дата объекта &1~nСменная дата &2 ~nРазница &3~nРазница должна составлять не более 4 дней."
      857                                ,varobj-date
      858                                ,s-date
      859                                ,v-sys-date - s-date
      860     ),no,"").
      861   end.
