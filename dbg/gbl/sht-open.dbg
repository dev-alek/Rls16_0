        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define variable mOk as logical no-undo.
        5   define variable mBachMode as logical no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Открытие смены".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   procedure cur-time :
       74      define output parameter p-today as date      no-undo .
       75      define output parameter p-time  as integer   no-undo .
       76     do
       77     on error undo, return error
       78     :
       79       define variable v-date1 as date      no-undo .
       80       define variable v-date2 as date      no-undo .
       81       define variable v-time  as integer   no-undo .
       82       assign
       83         v-date1 = today
       84         v-time  = time
       85         v-date2 = today
       86       .
       87       if v-date1 <> v-date2
       88       then do:
       89         assign
       90           v-date1 = today
       91           v-time  = v-time
       92         .
       93       end.
       94       assign
       95         p-today = v-date1
       96         p-time  = v-time
       97       .
       98     end.
       99   end.
      100   function cur-time-date returns character
      101   :
      102     return string(today, '99/99/9999':U) .
      103   end.
      104   function cur-time-mjd returns decimal
      105   :
      106     define variable v-date as date      no-undo .
      107     define variable v-time as integer   no-undo .
      108     run cur-time in this-procedure
      109       (output v-date
      110       ,output v-time
      111       ) .
      112     return integer(v-date) - 2400002 + (v-time / 86400) .
      113   end.
      114   function cur-time-get-ending-index returns integer
      115   (input p-number as integer
      116   )
      117   :
      118     if p-number < 0
      119     or p-number = ?
      120     then do:
      121       return 1 .
      122     end.
      123     define variable v-rest as integer   no-undo .
      124     assign
      125       p-number = p-number modulo 100
      126     .
      127     if p-number < 20
      128     then do:
      129       assign
      130         v-rest = p-number
      131       .
      132     end.
      133     else do:
      134       assign
      135         v-rest = p-number modulo 10
      136       .
      137     end.
      138     case v-rest :
      139       when 1
      140       then do:
      141         return 2 .
      142       end.
      143       when 2 or
      144       when 3 or
      145       when 4
      146       then do:
      147         return 3 .
      148       end.
      149       otherwise do:
      150         return 1 .
      151       end.
      152     end case .
      153   end.
      154   procedure cur-time-mjd-to-date :
      155      define input  parameter i-mjd-diff as decimal no-undo.
      156      define output parameter o-Date     as date    no-undo.
      157      define output parameter o-Time     as integer no-undo.
      158      define variable v-day-number as integer   no-undo .
      159      if    i-mjd-diff < 0
      160         or i-mjd-diff = ?
      161      then do:
      162         return "?" .
      163      end.
      164      assign
      165         v-day-number = truncate(i-mjd-diff,0).
      166         o-Date = date(v-day-number + 2400002).
      167         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      168     .
      169   end.
      170   function cur-time-mjd-to-string returns character
      171   (input p-mjd-diff as decimal
      172   )
      173   :
      174     define variable v-day-number as integer   no-undo .
      175     define variable v-seconds    as integer   no-undo .
      176     define variable v-hour       as integer   no-undo .
      177     define variable v-min        as integer   no-undo .
      178     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      179     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      180     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      181     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      182     if p-mjd-diff < 0
      183     or p-mjd-diff = ?
      184     then do:
      185       return "?" .
      186     end.
      187     assign
      188       v-day-number = integer(truncate(p-mjd-diff,0))
      189       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      190     .
      191     if v-seconds > 86400
      192     then do:
      193       assign
      194         v-seconds = 86400 - 1
      195       .
      196     end.
      197     if v-seconds < 0
      198     then do:
      199       assign
      200         v-seconds = 0
      201       .
      202     end.
      203     assign
      204       v-hour = truncate(v-seconds / 3600, 0)
      205     .
      206     assign
      207       v-seconds = v-seconds modulo 3600
      208     .
      209     assign
      210       v-min = truncate(v-seconds / 60, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 60
      214     .
      215     return
      216         (if v-day-number <> 0
      217           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0
      221           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      225           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      226           else ""
      227         )
      228       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      229       .
      230   end.
      231   function cur-time-string returns character
      232   :
      233     define variable v-date as date      no-undo .
      234     define variable v-time as integer   no-undo .
      235     run cur-time in this-procedure
      236       (output v-date
      237       ,output v-time
      238       ) .
      239     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      240   end.
      241   function cur-time-string-sec returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      250   end.
      251   function cur-time-custom  returns character
      252   (input p-prefix as character
      253   ,input p-date-format as character
      254   ,input p-delimiter as character
      255   ,input p-time-format as character
      256   ,input p-suffix as character
      257   )
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return
      266       p-prefix
      267       + string(v-date, p-date-format)
      268       + p-delimiter
      269       + string(v-time, p-time-format)
      270       + p-suffix
      271       .
      272   end.
      273   function cur-time-print  returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      282   end.
      283   function cur-time-datetime returns datetime
      284   :
      285     define variable v-char as character no-undo .
      286     define variable v-datetime as datetime no-undo .
      287     v-char = cur-time-string().
      288     v-datetime = datetime(v-char).
      289     return  v-datetime.
      290   end.
      291   function cur-time-string-msec returns character
      292   :
      293     define variable v-date as datetime  no-undo .
      294     v-date = now.
      295     return string(v-date) .
      296   end.
      297   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298     define variable v-cntxt-db-num        as integer   no-undo .
      299     define variable v-cntxt-userid        as character no-undo .
      300     define variable v-cntxt-level         as character no-undo .
      301     define variable v-cntxt-host-code-obj as integer   no-undo .
      302     define variable v-cntxt-obj-type      as character no-undo .
      303     define variable v-cntxt-obj-code      as integer   no-undo .
      304     define variable v-cntxt-db-num-obj    as integer   no-undo .
      305     define variable v-cntxt-is-admin      as logical   no-undo .
      306   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure integerm :
      308     define input  parameter p-string      as character no-undo .
      309     define input  parameter p-allow-sign  as logical   no-undo .
      310     define input  parameter p-allow-comma as logical   no-undo .
      311     define output parameter p-value       as integer   no-undo .
      312     define output parameter p-data-valid  as logical   no-undo .
      313     define output parameter p-message     as character no-undo .
      314     define variable v-replace-string as character no-undo .
      315     do
      316     on error undo, return error return-value
      317     :
      318       if p-string = ?
      319       then do:
      320         assign
      321           p-value      = ?
      322           p-data-valid = false
      323           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      324         .
      325         return .
      326       end.
      327       if p-string = ""
      328       then do:
      329         assign
      330           p-value      = ?
      331           p-data-valid = false
      332           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      333         .
      334         return .
      335       end.
      336       assign
      337         p-value = integer(p-string) no-error
      338       .
      339       if error-status :error = true
      340       then do:
      341         assign
      342           p-value      = ?
      343           p-data-valid = false
      344           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      345                                    ,p-string
      346                                    )
      347         .
      348         return .
      349       end.
      350       if index(p-string, ' ':u) > 0
      351       then do:
      352         assign
      353           p-value      = ?
      354           p-data-valid = false
      355           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      356                                    + "Строка содержит символы пробела"
      357                                    ,p-string
      358                                    )
      359         .
      360         return .
      361       end.
      362       assign
      363         v-replace-string = p-string
      364         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      365         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      366         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      367         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      368         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      369         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      370         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      371         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      372         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      373       .
      374       if p-allow-sign = true
      375       then do:
      376         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      377         then do:
      378           assign
      379             v-replace-string = substring(v-replace-string, 2)
      380           .
      381         end.
      382       end.
      383       else do:
      384         if substring(v-replace-string, 1, 1) = '+':u
      385         then do:
      386           assign
      387             p-value      = ?
      388             p-data-valid = false
      389             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      390                                     + "Задан параметр недопустимости знака челого числа. "
      391                                     + "Строка содержит символ плюс. "
      392                                     ,p-string
      393                                     )
      394           .
      395           return .
      396         end.
      397         if substring(v-replace-string, 1, 1) = '-':u
      398         then do:
      399           assign
      400             p-value      = ?
      401             p-data-valid = false
      402             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      403                                     + "Задан параметр недопустимости знака челого числа. "
      404                                     + "Строка содержит символ минус. "
      405                                     ,p-string
      406                                     )
      407           .
      408           return .
      409         end.
      410       end.
      411       if p-allow-comma = true
      412       then do:
      413         assign
      414           v-replace-string = replace(v-replace-string, ',', '')
      415         .
      416       end.
      417       else do:
      418         if index(v-replace-string, ',') > 0
      419         then do:
      420           assign
      421             p-value      = ?
      422             p-data-valid = false
      423             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      424                                     + "Задан параметр недопустимости знака разделителя тысяч."
      425                                     + "Строка содержит знак разделителя тысяч. "
      426                                     ,p-string
      427                                     )
      428           .
      429           return .
      430         end.
      431       end.
      432       if index(p-string, '.') > 0
      433       then do:
      434         assign
      435           p-value      = ?
      436           p-data-valid = false
      437           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      438                                    + "Строка содержит знак десятичной точки"
      439                                    ,p-string
      440                                    )
      441         .
      442         return .
      443       end.
      444       if v-replace-string <> fill('9', length(v-replace-string))
      445       then do:
      446         assign
      447           p-value      = ?
      448           p-data-valid = false
      449           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      450                                    + "Встречены символы, недопустимые для целого числа '&2'"
      451                                    ,p-string
      452                                    ,replace(v-replace-string, '9', '')
      453                                    )
      454         .
      455         return .
      456       end.
      457       assign
      458         p-data-valid = true
      459         p-message    = ""
      460       .
      461     end.
      462   end procedure.
      463   define variable f-date   as date    no-undo.
      464   define variable f-time   as integer no-undo.
      465   define variable s-date   as date    no-undo.
      466   define variable e-date   as date    no-undo.
      467   define variable s-time   as integer no-undo.
      468   define variable e-time   as integer no-undo.
      469   define variable s-num      as integer   no-undo.
      470   define variable s-name     as character no-undo.
      471   define variable s-name-int as integer   no-undo.
      472   define variable is-super as log     no-undo.
      473   define variable varupd-obj-date as logical initial no   no-undo.
      474   define variable varobj-date     as date                 no-undo.
      475   define variable v-sys-date      as date                 no-undo.
      476   define variable v-sys-time      as integer              no-undo.
      477   define variable v-cancel        as logical              no-undo.
      478   define variable glog as logical no-undo .
      479   define variable v-host-code like ub.sysconf.host-code no-undo .
      480   define buffer bf-trb_shift-obj   for ub.shift-obj .
      481   define buffer open-shift         for ub.shift-obj .
      482   define buffer buf_shift-obj      for ub.shift-obj .
      483   define buffer closed-shift       for ub.shift-obj .
      484   procedure put-mes:
      485   define input  parameter iVss    as logical   no-undo.
      486   define input  parameter iText   as character no-undo.
      487   define input  parameter iGetMes as logical   no-undo.
      488   define input  parameter iRetval as character no-undo.
      489   message if ivss then vss-workfile else ""
      490           if ivss then vss-revision else ""
      491           if ivss then vss-description else ""
      492           if ivss then "~n" else ""
      493           iText skip
      494           if iGetMes then trim(error-status :get-message(1)) else ""
      495           if iGetMes then trim(error-status :get-message(2)) else ""
      496           if iGetMes then trim(error-status :get-message(3)) else ""
      497           if iGetMes then trim(error-status :get-message(4)) else ""
      498           if iGetMes then trim(error-status :get-message(5)) else ""
      499           skip
      500           iRetval
      501      view-as alert-box error .
      502   end procedure.
      503   do
      504   on error undo, return error return-value + error-status:get-message(1) + error-status:get-message(2)
      505   :
      506   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      508     (input  p-curr-obj-type
      509     ,input  p-curr-obj-code
      510     ,output v-host-code
      511     )  .
      512   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513     run mainmenu_getcntxt in parparentproc
      514       (output v-cntxt-db-num
      515       ,output v-cntxt-userid
      516       ,output v-cntxt-level
      517       ,output v-cntxt-host-code-obj
      518       ,output v-cntxt-obj-type
      519       ,output v-cntxt-obj-code
      520       ,output v-cntxt-db-num-obj
      521       ,output v-cntxt-is-admin
      522       ) .
      523   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      525     (input  p-curr-obj-type
      526     ,input  p-curr-obj-code
      527     ,input  'shift-on=request'
      528     ,output glog
      529     ) no-error .
      530   if error-status :error then do:
      531     run put-mes(yes ,"Ошибка при запуске процедуры objat",yes,return-value).
      532     return error.
      533   end.
      534   run cur-time in this-procedure ( output v-sys-date
      535                                  , output v-sys-time
      536                                  ) no-error.
      537   if error-status:error then do:
      538       run put-mes(yes ,"Ошибка при чтении системной даты.",yes,return-value).
      539       undo, return error .
      540   end.
      541   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
