      667                   ub.shift-param.obj-type = buf_shift-obj.obj-type and
      668                   ub.shift-param.shift-date = buf_shift-obj.shift-date and
      669                   ub.shift-param.shift-name = buf_shift-obj.shift-name and
      670                   ub.shift-param.shift-num = buf_shift-obj.shift-num and
      671                   ub.shift-param.gds-code = 0 and
      672                   ub.shift-param.pl-code = 0 no-error .
      673               if not available (ub.shift-param) then
      674               do:
      675                   create ub.shift-param .
      676                   assign
      677                       ub.shift-param.obj-code   = buf_shift-obj.obj-code
      678                       ub.shift-param.obj-type   = buf_shift-obj.obj-type
      679                       ub.shift-param.shift-date = buf_shift-obj.shift-date
      680                       ub.shift-param.shift-name = buf_shift-obj.shift-name
      681                       ub.shift-param.shift-num  = buf_shift-obj.shift-num
      682                       .
