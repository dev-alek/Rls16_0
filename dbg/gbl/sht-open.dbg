      883        run put-mes(no ,"Ошибка при заведении номера смены. ",yes,varmessage).
      884    return error.
      885   end.
      886   if s-name-int < 1 then do:
      887     run put-mes(no ,"Номер смены может быть только положительным целым числом.",no,"").
      888     return error.
      889   end.
      890   for each bf-trb_shift-obj where bf-trb_shift-obj.obj-type    = p-curr-obj-type and
      891                                   bf-trb_shift-obj.obj-code    = p-curr-obj-code and
      892                                   bf-trb_shift-obj.shift-date  = s-date          and
      893                                   bf-trb_shift-obj.shift-name  = s-name          and
      894                                   bf-trb_shift-obj.status_    <> 'ожд':U on error undo, return error return-value :
      895    run put-mes(no ,substitute("Запрещено добавлять смены с одним номером в одном сменном дне.~nНа объекте &1 &2 есть смена:~nДата смены &3~nПорядок смены &4~nНомер смены &5"
      896                                ,bf-trb_shift-obj.obj-type
      897                                ,bf-trb_shift-obj.obj-code
      898                                ,bf-trb_shift-obj.shift-date
      899                                ,bf-trb_shift-obj.shift-num
      900                                ,bf-trb_shift-obj.shift-name
      901     ),no,"").
      902     return error.
      903   end.
      904   define variable v-value-character as character  no-undo .
      905   define variable v-value-date      as date       no-undo .
      906   define variable v-value-decimal   as decimal    no-undo .
      907   define variable v-value-integer   as integer    no-undo .
      908   define variable v-value-logical   as logical    no-undo .
      909   define variable v-tth             as handle     no-undo .
      910   define variable v-param-type            as character no-undo .
      911   run adm/shattri.p ( input "get":U
      912                     , input  '':u
      913                     , input  0
      914                     , input  'obj-date':U
      915                     , input  'newordsh':U
      916                     , output v-value-character
      917                     , output v-value-date
      918                     , output v-value-decimal
      919                     , output v-value-integer
      920                     , output v-value-logical
      921                     , output v-param-type
      922                     , input-output table-handle v-tth
      923                     ) no-error .
      924   if error-status :error then do:
      925      assign
      926         v-value-logical = FALSE
      927      .
      928   end.
      929   if v-value-logical then do:
      930     for each bf-trb_shift-obj where bf-trb_shift-obj.obj-type    = p-curr-obj-type and
      931                                     bf-trb_shift-obj.obj-code    = p-curr-obj-code and
      932                                     bf-trb_shift-obj.shift-date  = s-date          and
      933                                     bf-trb_shift-obj.shift-name  > s-name          on error undo, return error return-value :
      934         run put-mes(no ,substitute("По настройкам конфигурации (newordsh) вам запрещено добавлять смены с меньшим номером после смены с большим номером в одном сменном дне.~nНа объекте &1 &2 есть смена:~nДата смены &3~nПорядок смены &4~nНомер смены &5"
      935                                ,bf-trb_shift-obj.obj-type
      936                                ,bf-trb_shift-obj.obj-code
      937                                ,bf-trb_shift-obj.shift-date
      938                                ,bf-trb_shift-obj.shift-num
      939                                ,bf-trb_shift-obj.shift-name
      940     ),no,"").
      941       return error.
      942     end.
      943   end.
      944   start-shift:
      945   do transaction on error undo start-shift, return on stop undo start-shift, return:
      946     if not available buf_shift-obj then do:
      947       create buf_shift-obj.
      948       assign
      949         buf_shift-obj.host-code     = v-host-code
      950         buf_shift-obj.obj-type      = p-curr-obj-type
      951         buf_shift-obj.obj-code      = p-curr-obj-code
      952         buf_shift-obj.shift-date    = s-date
      953         buf_shift-obj.shift-num     = s-num
      954         buf_shift-obj.shift-name    = s-name
      955         buf_shift-obj.open-date     = s-date
      956       .
      957     end.
      958     assign
      959       buf_shift-obj.status_ = 'тек':U
      960       buf_shift-obj.open-sys-date = v-sys-date
      961       buf_shift-obj.open-sys-time = v-sys-time
      962       buf_shift-obj.open-time     = s-time
      963     .
      964     if varupd-obj-date = yes then do:
      965   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtset in g#library
      967     (input p-curr-obj-type
      968     ,input p-curr-obj-code
      969     ,input s-date
      970     ) no-error .
      971        if error-status:error then do:
      972          run put-mes(no ,"Ошибка при установке календарной даты.",no,"").
      973           return error.
      974        end.
      975     end.
      976   end.
      977   if not mbachMode
      978   then
      979       message
      980         "Новая смена открыта."
      981       view-as alert-box.
      982   end.
      983   mOk =yes.
      984   run ref/shftpers.w ( INPUT parparentproc
      985                      , INPUT p-curr-obj-type
      986                      , INPUT p-curr-obj-code
      987                      , INPUT s-date
      988                      , INPUT s-num
      989                      , INPUT "b-add,b-add-next"
      990                      , INPUT 'смена-объект-откр':U) no-error.
