      658               buf_shift-obj.open-sys-time = v-sys-time
      659           .
      660           define buffer bf_shift-param for ub.shift-param .
      661           find first bf_shift-param no-lock where bf_shift-param.obj-code = 0 and
      662               bf_shift-param.obj-type = "" and
      663               bf_shift-param.shift-date = 01.01.1900  no-error .
      664           if available (bf_shift-param) then
