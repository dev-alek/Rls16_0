      615   find first buf_shift-obj no-lock
      616        where buf_shift-obj.obj-type = p-curr-obj-type
      617          and buf_shift-obj.obj-code = p-curr-obj-code
      618          and buf_shift-obj.status_ = 'ожд':U
      619   use-index pi no-error.
      620   if available buf_shift-obj
      621   then do:
      622       do transaction
      623       on error undo, return error "Ошибка обработки запланированной смены" :
      624           find first buf_shift-obj exclusive-lock
      625                where buf_shift-obj.obj-type   = p-curr-obj-type
      626                  and buf_shift-obj.obj-code    = p-curr-obj-code
      627                  and buf_shift-obj.status_     = 'ожд':U
      628           use-index pi no-error.
      629           assign
      630               s-date = buf_shift-obj.shift-date
      631               s-time = v-sys-time
      632               s-num  = buf_shift-obj.shift-num
      633               s-name = buf_shift-obj.shift-name
      634           .
      635           run gbl/shift.w (
      636                 input parparentproc
