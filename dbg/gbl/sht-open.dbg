      684               assign
      685                   ub.shift-param.prc-dev-mass   = bf_shift-param.prc-dev-mass
      686                   ub.shift-param.dev-paid-trans = bf_shift-param.dev-paid-trans .
      687           end.
      688       end.
      689   end.
      690   else do:
      691       run gbl/shift.w (
      692                       input parparentproc
      693                     , input p-curr-obj-type
      694                     , input p-curr-obj-code
      695                       ,  input-output s-date
      696                     , input-output e-date
      697                       , input-output s-time
      698                     , input-output e-time
      699                       , input-output s-num
      700                       , input-output s-name
      701                       , input ""
      702                       , output v-cancel
      703                   ) no-error.
      704       if error-status:error then do:
