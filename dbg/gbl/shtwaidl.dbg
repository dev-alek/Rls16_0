        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: shtwaidl.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/shtwaidl.p $":U .
        9   define variable vss-description as character no-undo init "Удаление ожидаемой смены".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable v-err-mess as character no-undo .
       80   define variable v-host-code as integer no-undo .
       81   define variable obj-db-num as integer no-undo .
       82   define buffer buf_shift-obj for ub.shift-obj.
       83   main-block:
       84   do
       85   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       86   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       87   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       88   :
       89     find first buf_shift-obj exclusive-lock where
       90           recid(buf_shift-obj) = p-rec .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
       93     (input  buf_shift-obj.obj-type
       94     ,input  buf_shift-obj.obj-code
       95     ,output obj-db-num
       96     )  .
       97     if g#db-num <> obj-db-num then do:
       98       v-err-mess = substitute("Ожидаемую смену можно удалить только в БД объекта").
       99       run err-mess in this-procedure ( input-output v-err-mess) .
      100       undo main-block, return error (if p-silent then v-err-mess else '').
      101     end.
      102     if buf_shift-obj.status_ <> 'ожд':U then do:
      103       v-err-mess = substitute("Удалить можно только Ожидаемую смену").
      104       run err-mess in this-procedure ( input-output v-err-mess) .
      105       undo main-block, return error (if p-silent then v-err-mess else '').
      106     end.
      107     delete buf_shift-obj no-error.
      108     if error-status:error then do:
      109       v-err-mess = substitute("Ошибка при удалении :&1&2&1&3"
      110                               , chr(10)
      111                               , error-status:get-message(1)
      112                               , return-value ).
      113       run err-mess in this-procedure ( input-output v-err-mess) .
      114       undo main-block, return error (if p-silent then v-err-mess else '').
      115     end.
      116   end.
      117   PROCEDURE err-mess:
      118     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      119     CASE p-silent:
      120       when yes then do:
      121         assign
      122         p-mess = substitute("(Ожидамемая) Смена на объекте: &1&2 от &3 номер &4 порядок &5:&6&7"
      123                            , buf_shift-obj.obj-type
      124                            , buf_shift-obj.obj-code
      125                            , string(buf_shift-obj.shift-date, "99/99/9999")
      126                            , buf_shift-obj.shift-name
      127                            , buf_shift-obj.shift-num
      128                            , chr(10)
      129                            , p-mess)
      130         .
      131       end.
      132       when no then do:
      133         message
      134         p-mess
      135         view-as alert-box error .
      136       end.
      137     end.
      138   END PROCEDURE.
