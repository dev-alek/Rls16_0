     3219   procedure read-param-data :
     3220     define input  parameter p-file-name as character no-undo .
     3221     define buffer buf_temp-param for temp-param .
     3222     define variable v-read-string as character no-undo .
     3223     define variable v-param-code  as character no-undo .
     3224     define variable v-param-value as character no-undo .
     3225     do
     3226     on error undo, return error return-value
     3227     :
     3228       for each buf_temp-param
     3229       on error undo, return error return-value
     3230       :
     3231         delete buf_temp-param .
     3232       end.
     3233       input stream sinp from value (p-file-name) .
     3234       repeat
     3235       :
     3236         assign
     3237           v-read-string = ''
     3238         .
     3239         import stream sinp unformatted v-read-string .
     3240         if num-entries(v-read-string, ':':u) <> 2
     3241         then do:
     3242           undo, return error substitute("Ошибка структуры строки файла &1", v-read-string) .
     3243         end.
     3244         assign
     3245           v-param-code  = entry(1, v-read-string, ':':u)
     3246           v-param-value = str-decode(entry(2, v-read-string, ':':u), '')
     3247         .
     3248         find first buf_temp-param
     3249           where buf_temp-param.param-code = v-param-code
     3250           no-error .
     3251         if available buf_temp-param
     3252         then do:
     3253           undo, return error substitute("Попытка повторного создания параметра с кодом &1", v-param-code) .
     3254         end.
     3255         create buf_temp-param .
     3256         assign
     3257           buf_temp-param.param-code     = v-param-code
     3258           buf_temp-param.param-value    = v-param-value
     3259         .
     3260       end.
     3261       input stream sinp close .
     3262     end.
     3263   end procedure.
     3264   procedure get-param-data :
     3265     define input  parameter p-param-code     as character no-undo .
     3266     define output parameter p-param-value    as character no-undo .
     3267     define buffer buf_temp-param for temp-param .
     3268     do
     3269     on error undo, return error return-value
     3270     :
     3271       find first buf_temp-param
     3272         where buf_temp-param.param-code = p-param-code
     3273         no-error .
     3274       if available buf_temp-param
     3275       then do:
     3276         assign
     3277           p-param-value = buf_temp-param.param-value
     3278         .
     3279       end.
     3280       else do:
     3281         undo, return error substitute("Не найден параметр &1", p-param-code) .
     3282       end.
     3283     end.
     3284   end procedure.
     3285   procedure gen-session-id :
     3286     define output parameter p-session-id    as character no-undo .
     3287     define variable v-session-id as character no-undo .
     3288     define buffer buf_temp-session for temp-session .
     3289     define variable v-char-list as character no-undo .
     3290     assign
     3291       v-char-list = '0123456789abcdefghijklmnopqrstuvwxyz'
     3292     .
     3293     do
     3294     on error undo, return error return-value
     3295     :
     3296       do while true
     3297       :
     3298         assign
     3299           v-session-id = substring(v-char-list, random(1,length(v-char-list)), 1)
     3300                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3301                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3302                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3303                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3304                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3305                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3306                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3307                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3308                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3309                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3310                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3311                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3312                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3313                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3314                        + substring(v-char-list, random(1,length(v-char-list)), 1)
     3315         .
     3316         find first buf_temp-session
     3317           where buf_temp-session.session-id = v-session-id
     3318           no-error .
     3319         if not available buf_temp-session
     3320         then do:
     3321           assign
     3322             p-session-id = v-session-id
     3323           .
     3324           return .
     3325         end.
     3326       end.
     3327     end.
     3328   end procedure.
     3329   procedure register-session-id :
     3330     define input  parameter p-session-id    as character no-undo .
     3331     define input  parameter p-user-login    as character no-undo .
     3332     define input  parameter p-remote-device as character no-undo .
     3333     define buffer buf_temp-session for temp-session .
     3334     do
     3335     on error undo, return error return-value
     3336     :
     3337       find first buf_temp-session
     3338         where buf_temp-session.session-id = p-session-id
     3339         no-error .
     3340       if available buf_temp-session
     3341       then do:
     3342         undo, return error substitute("Уже существует сессия с идентификатором &1", p-session-id) .
     3343       end.
     3344       for each buf_temp-session
     3345         where buf_temp-session.session-remote-device = p-remote-device
     3346       on error undo, return error return-value
     3347       :
     3348         run delete-session in this-procedure
     3349           (input buf_temp-session.session-id
     3350           ) .
     3351       end.
     3352       assign
     3353         v-current-user-num = v-current-user-num + 1
     3354       .
     3355       create buf_temp-session .
     3356       assign
     3357         buf_temp-session.session-id            = p-session-id
     3358         buf_temp-session.session-user-login    = p-user-login
     3359         buf_temp-session.session-remote-device = p-remote-device
     3360       .
     3361       assign
     3362         buf_temp-session.session-start-time = sys-time_get-mjd-func()
     3363         buf_temp-session.session-last-request-time = buf_temp-session.session-start-time
     3364       .
     3365     end.
     3366   end procedure.
     3367   procedure validate-session :
     3368     define input  parameter p-session-id    as character no-undo .
     3369     define input  parameter p-remote-device as character no-undo .
     3370     define output parameter p-session-valid as logical   no-undo .
     3371     define output parameter p-message       as character no-undo .
     3372     define buffer buf_temp-session for temp-session .
     3373     do
     3374     on error undo, return error return-value
     3375     :
     3376       find first buf_temp-session
     3377         where buf_temp-session.session-id = p-session-id
     3378         no-error .
     3379       if not available buf_temp-session
     3380       then do:
     3381         assign
     3382           p-session-valid = false
     3383           p-message       = substitute("Неизвестный идентификатор сессии &1", p-session-id)
     3384         .
     3385         return .
     3386       end.
     3387       if buf_temp-session.session-remote-device <> p-remote-device
     3388       then do:
     3389         assign
     3390           p-session-valid = false
     3391           p-message       = "Не совпадает адрес удаленного компьютера с адресом сессии. "
     3392                           + substitute("Адрес удаленного компьютера &1", p-remote-device)
     3393         .
     3394         return .
     3395       end.
     3396       define variable v-cur-time-mjd as decimal   no-undo .
     3397       assign
     3398         v-cur-time-mjd = sys-time_get-mjd-func()
     3399       .
     3400       if v-cur-time-mjd > buf_temp-session.session-last-request-time + 0.03
     3401       then do:
     3402         assign
     3403           p-session-valid = false
     3404           p-message       = "Превышено предельное время неактивного состояния сессии. "
     3405                           + "Сессия автоматически завершена"
     3406         .
     3407         run delete-session in this-procedure
     3408           (input p-session-id
     3409           ) .
     3410         return .
     3411       end.
     3412       assign
     3413         buf_temp-session.session-last-request-time = v-cur-time-mjd
     3414       .
     3415       assign
     3416         p-session-valid = true
     3417       .
     3418     end.
     3419   end procedure.
     3420   procedure delete-session :
     3421     define input  parameter p-session-id    as character no-undo .
     3422     define buffer buf_temp-session for temp-session .
     3423     do
     3424     on error undo, return error return-value
     3425     :
     3426       find first buf_temp-session
     3427         where buf_temp-session.session-id = p-session-id
     3428         no-error .
     3429       if available buf_temp-session
     3430       then do:
     3431         assign
     3432           v-current-user-num = v-current-user-num - 1
     3433         .
     3434         delete buf_temp-session .
     3435       end.
     3436     end.
     3437   end procedure.
