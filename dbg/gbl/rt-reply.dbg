        1   block-level on error undo, throw.
        2   define input  parameter p-max-user-num as integer   no-undo .
        3   define input  parameter p-rtexpdt      as date      no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: rt-reply.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-reply.p $":U .
        9   define variable vss-description as character no-undo init "Процедура формирования ответов для радиотерминала".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure sys-time_get-sys :
       70     define output parameter p-year         as integer   no-undo .
       71     define output parameter p-month        as integer   no-undo .
       72     define output parameter p-day          as integer   no-undo .
       73     define output parameter p-hour         as integer   no-undo .
       74     define output parameter p-minute       as integer   no-undo .
       75     define output parameter p-second       as integer   no-undo .
       76     define output parameter p-milliseconds as integer   no-undo .
       77     define variable v-system-time-structure as memptr    no-undo.
       78     do
       79     on error undo, return error return-value
       80     :
       81       assign
       82         set-size(v-system-time-structure) = 16
       83       .
       84       run GetSystemTime
       85         (input  get-pointer-value(v-system-time-structure)
       86         ) .
       87       assign
       88         p-year         = get-short(v-system-time-structure,  1)
       89         p-month        = get-short(v-system-time-structure,  3)
       90         p-day          = get-short(v-system-time-structure,  7)
       91         p-hour         = get-short(v-system-time-structure,  9)
       92         p-minute       = get-short(v-system-time-structure, 11)
       93         p-second       = get-short(v-system-time-structure, 13)
       94         p-milliseconds = get-short(v-system-time-structure, 15)
       95       .
       96       assign
       97         set-size(v-system-time-structure) = 0
       98       .
       99     end.
      100   end procedure.
      101   procedure sys-time_get-comp-user-name :
      102     define output parameter p-computer-name as character no-undo .
      103     define output parameter p-user-name     as character no-undo .
      104     define output parameter p-process-pid   as integer   no-undo .
      105     define variable v-return-value  as integer   no-undo .
      106     define variable v-buffer-length as integer   no-undo .
      107     define variable v-buffer-memptr as memptr    no-undo .
      108     do
      109     on error undo, return error return-value
      110     :
      111       assign
      112         v-buffer-length = 1024
      113         set-size(v-buffer-memptr) = v-buffer-length + 4
      114       .
      115       assign
      116         put-long(v-buffer-memptr, 1) = v-buffer-length
      117       .
      118       run GetComputerNameA
      119         (input  get-pointer-value(v-buffer-memptr) + 4
      120         ,input  get-pointer-value(v-buffer-memptr)
      121         ,output v-return-value
      122         ) .
      123       if v-return-value <> 0
      124       then do:
      125         assign
      126           p-computer-name = get-string(v-buffer-memptr, 5)
      127         .
      128       end.
      129       assign
      130         put-long(v-buffer-memptr, 1) = v-buffer-length
      131       .
      132       run GetUserNameA
      133         (input  get-pointer-value(v-buffer-memptr) + 4
      134         ,input  get-pointer-value(v-buffer-memptr)
      135         ,output v-return-value
      136         ) .
      137       if v-return-value <> 0
      138       then do:
      139         assign
      140           p-user-name = get-string(v-buffer-memptr, 5)
      141         .
      142       end.
      143       run GetCurrentProcessId
      144         (output p-process-pid
      145         ) .
      146       assign
      147         set-size(v-buffer-memptr) = 0
      148       .
      149     end.
      150   end procedure.
      151   procedure sys-time_get-http :
      152     define output parameter p-http-time as character no-undo .
      153     define variable v-year         as integer   no-undo .
      154     define variable v-month        as integer   no-undo .
      155     define variable v-day-of-week  as integer   no-undo .
      156     define variable v-day          as integer   no-undo .
      157     define variable v-hour         as integer   no-undo .
      158     define variable v-minute       as integer   no-undo .
      159     define variable v-second       as integer   no-undo .
      160     define variable v-milliseconds as integer   no-undo .
      161     do
      162     on error undo, return error return-value
      163     :
      164       run sys-time_get-sys in this-procedure
      165         (output v-year
      166         ,output v-month
      167         ,output v-day
      168         ,output v-hour
      169         ,output v-minute
      170         ,output v-second
      171         ,output v-milliseconds
      172         ) .
      173       assign
      174         v-day-of-week = weekday(date(v-month, v-day, v-year))
      175         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      176                     + ', ':u
      177                     + string(v-day, '99':u)
      178                     + ' ':u
      179                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      180                     + ' ':u
      181                     + string(v-year, '9999':u)
      182                     + ' ':u
      183                     + string(v-hour, '99':u)
      184                     + ':':u
      185                     + string(v-minute, '99':u)
      186                     + ':':u
      187                     + string(v-second, '99':u)
      188                     + ' ':u
      189                     + 'GMT':u
      190       .
      191     end.
      192   end procedure.
      193   procedure sys-time_set-sys :
      194     define input  parameter p-year         as integer   no-undo .
      195     define input  parameter p-month        as integer   no-undo .
      196     define input  parameter p-day          as integer   no-undo .
      197     define input  parameter p-hour         as integer   no-undo .
      198     define input  parameter p-minute       as integer   no-undo .
      199     define input  parameter p-second       as integer   no-undo .
      200     define input  parameter p-milliseconds as integer   no-undo .
      201     define variable v-system-time-structure as memptr    no-undo.
      202     define variable v-return-value as integer   no-undo .
      203     define variable v-day-of-week  as integer   no-undo .
      204     do
      205     on error undo, return error return-value
      206     :
      207       assign
      208         v-day-of-week = weekday(date(p-month, p-day, p-year))
      209       .
      210       assign
      211         set-size(v-system-time-structure) = 16
      212       .
      213       assign
      214         put-short(v-system-time-structure,  1) = p-year
      215         put-short(v-system-time-structure,  3) = p-month
      216         put-short(v-system-time-structure,  5) = v-day-of-week
      217         put-short(v-system-time-structure,  7) = p-day
      218         put-short(v-system-time-structure,  9) = p-hour
      219         put-short(v-system-time-structure, 11) = p-minute
      220         put-short(v-system-time-structure, 13) = p-second
      221         put-short(v-system-time-structure, 15) = p-milliseconds
      222       .
      223       run SetSystemTime
      224         (input  get-pointer-value(v-system-time-structure)
      225         ,output v-return-value
      226         ) .
      227       assign
      228         set-size(v-system-time-structure) = 0
      229       .
      230       if v-return-value = 0
      231       then do:
      232         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      233       end.
      234     end.
      235   end procedure.
      236   procedure sys-time_sys-to-mjd :
      237     define input  parameter p-year         as integer   no-undo .
      238     define input  parameter p-month        as integer   no-undo .
      239     define input  parameter p-day          as integer   no-undo .
      240     define input  parameter p-hour         as integer   no-undo .
      241     define input  parameter p-minute       as integer   no-undo .
      242     define input  parameter p-second       as integer   no-undo .
      243     define input  parameter p-milliseconds as integer   no-undo .
      244     define output parameter p-mjd          as decimal   no-undo .
      245     define variable v-year-correction as decimal   no-undo .
      246     define variable v-shift-year as decimal   no-undo .
      247     do
      248     on error undo, return error return-value
      249     :
      250       assign
      251         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      252         v-shift-year      = decimal(p-year) + v-year-correction
      253         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      254               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      255               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      256               + decimal(p-day) - 2432076.0
      257               + p-hour / 24.0
      258               + p-minute / 1440.0
      259               + p-second / 86400.0
      260               + p-milliseconds / 86400000.0
      261       .
      262     end.
      263   end procedure.
      264   procedure sys-time_sys-to-loc :
      265     define input  parameter p-sys-year         as integer   no-undo .
      266     define input  parameter p-sys-month        as integer   no-undo .
      267     define input  parameter p-sys-day          as integer   no-undo .
      268     define input  parameter p-sys-hour         as integer   no-undo .
      269     define input  parameter p-sys-minute       as integer   no-undo .
      270     define input  parameter p-sys-second       as integer   no-undo .
      271     define input  parameter p-sys-milliseconds as integer   no-undo .
      272     define output parameter p-loc-year         as integer   no-undo .
      273     define output parameter p-loc-month        as integer   no-undo .
      274     define output parameter p-loc-day          as integer   no-undo .
      275     define output parameter p-loc-hour         as integer   no-undo .
      276     define output parameter p-loc-minute       as integer   no-undo .
      277     define output parameter p-loc-second       as integer   no-undo .
      278     define output parameter p-loc-milliseconds as integer   no-undo .
      279     define variable v-system-time-structure as memptr    no-undo.
      280     define variable v-return-value          as integer   no-undo .
      281     define variable v-sys-day-of-week       as integer   no-undo .
      282     do
      283     on error undo, return error return-value
      284     :
      285       assign
      286         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      287       .
      288       assign
      289         set-size(v-system-time-structure) = 32
      290       .
      291       assign
      292         put-short(v-system-time-structure,  1) = p-sys-year
      293         put-short(v-system-time-structure,  3) = p-sys-month
      294         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      295         put-short(v-system-time-structure,  7) = p-sys-day
      296         put-short(v-system-time-structure,  9) = p-sys-hour
      297         put-short(v-system-time-structure, 11) = p-sys-minute
      298         put-short(v-system-time-structure, 13) = p-sys-second
      299         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      300       .
      301       run SystemTimeToTzSpecificLocalTime
      302         (input  0
      303         ,input  get-pointer-value(v-system-time-structure)
      304         ,input  get-pointer-value(v-system-time-structure) + 16
      305         ,output v-return-value
      306         ) .
      307       assign
      308         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      309         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      310         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      311         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      312         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      313         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      314         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      315       .
      316       assign
      317         set-size(v-system-time-structure) = 0
      318       .
      319       if v-return-value = 0
      320       then do:
      321         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      322       end.
      323     end.
      324   end procedure.
      325   procedure sys-time_mjd-to-sys :
      326     define input  parameter p-mjd          as decimal   no-undo .
      327     define output parameter p-year         as integer   no-undo .
      328     define output parameter p-month        as integer   no-undo .
      329     define output parameter p-day          as integer   no-undo .
      330     define output parameter p-hour         as integer   no-undo .
      331     define output parameter p-minute       as integer   no-undo .
      332     define output parameter p-second       as integer   no-undo .
      333     define output parameter p-milliseconds as integer   no-undo .
      334     define variable v-year-correction as decimal   no-undo .
      335     define variable v-shift-year      as decimal   no-undo .
      336     define variable v-conv-date     as date      no-undo .
      337     define variable v-int-part      as integer   no-undo .
      338     define variable v-fraction-part as decimal   no-undo .
      339     do
      340     on error undo, return error return-value
      341     :
      342       assign
      343         v-int-part      = integer(truncate(p-mjd, 0))
      344         v-fraction-part = p-mjd - v-int-part
      345         v-conv-date     = date(11, 17, 1858) + v-int-part
      346         p-year          = year(v-conv-date)
      347         p-month         = month(v-conv-date)
      348         p-day           = day(v-conv-date)
      349         v-fraction-part = v-fraction-part * 24.0
      350         p-hour          = integer(truncate(v-fraction-part, 0))
      351         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      352         p-minute        = integer(truncate(v-fraction-part, 0))
      353         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      354         p-second        = integer(truncate(v-fraction-part, 0))
      355         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      356         p-milliseconds  = integer(v-fraction-part)
      357       .
      358     end.
      359   end procedure.
      360   procedure sys-time_mjd-to-loc :
      361     define input  parameter p-mjd              as decimal   no-undo .
      362     define output parameter p-loc-year         as integer   no-undo .
      363     define output parameter p-loc-month        as integer   no-undo .
      364     define output parameter p-loc-day          as integer   no-undo .
      365     define output parameter p-loc-hour         as integer   no-undo .
      366     define output parameter p-loc-minute       as integer   no-undo .
      367     define output parameter p-loc-second       as integer   no-undo .
      368     define output parameter p-loc-milliseconds as integer   no-undo .
      369     define variable v-sys-year         as integer   no-undo .
      370     define variable v-sys-month        as integer   no-undo .
      371     define variable v-sys-day          as integer   no-undo .
      372     define variable v-sys-hour         as integer   no-undo .
      373     define variable v-sys-minute       as integer   no-undo .
      374     define variable v-sys-second       as integer   no-undo .
      375     define variable v-sys-milliseconds as integer   no-undo .
      376     do
      377     on error undo, return error return-value
      378     :
      379       run sys-time_mjd-to-sys
      380         (input  p-mjd
      381         ,output v-sys-year
      382         ,output v-sys-month
      383         ,output v-sys-day
      384         ,output v-sys-hour
      385         ,output v-sys-minute
      386         ,output v-sys-second
      387         ,output v-sys-milliseconds
      388         ) .
      389       run sys-time_sys-to-loc
      390         (input  v-sys-year
      391         ,input  v-sys-month
      392         ,input  v-sys-day
      393         ,input  v-sys-hour
      394         ,input  v-sys-minute
      395         ,input  v-sys-second
      396         ,input  v-sys-milliseconds
      397         ,output p-loc-year
      398         ,output p-loc-month
      399         ,output p-loc-day
      400         ,output p-loc-hour
      401         ,output p-loc-minute
      402         ,output p-loc-second
      403         ,output p-loc-milliseconds
      404         ) .
      405     end.
      406   end procedure.
      407   function sys-time_get-mjd-func returns decimal
      408   :
      409     define variable v-year         as integer   no-undo .
      410     define variable v-month        as integer   no-undo .
      411     define variable v-day          as integer   no-undo .
      412     define variable v-hour         as integer   no-undo .
      413     define variable v-minute       as integer   no-undo .
      414     define variable v-second       as integer   no-undo .
      415     define variable v-milliseconds as integer   no-undo .
      416     define variable v-mjd          as decimal   no-undo .
      417     run sys-time_get-sys in this-procedure
      418       (output v-year
      419       ,output v-month
      420       ,output v-day
      421       ,output v-hour
      422       ,output v-minute
      423       ,output v-second
      424       ,output v-milliseconds
      425       ) .
      426     run sys-time_sys-to-mjd in this-procedure
      427       (input  v-year
      428       ,input  v-month
      429       ,input  v-day
      430       ,input  v-hour
      431       ,input  v-minute
      432       ,input  v-second
      433       ,input  v-milliseconds
      434       ,output v-mjd
      435       ) .
      436     return v-mjd .
      437   end function .
      438   function sys-time_get-sys-str-func returns character
      439   :
      440     define variable v-utc-time as character no-undo .
      441     define variable v-year         as integer   no-undo .
      442     define variable v-month        as integer   no-undo .
      443     define variable v-day          as integer   no-undo .
      444     define variable v-hour         as integer   no-undo .
      445     define variable v-minute       as integer   no-undo .
      446     define variable v-second       as integer   no-undo .
      447     define variable v-milliseconds as integer   no-undo .
      448     run sys-time_get-sys in this-procedure
      449       (output v-year
      450       ,output v-month
      451       ,output v-day
      452       ,output v-hour
      453       ,output v-minute
      454       ,output v-second
      455       ,output v-milliseconds
      456       ) .
      457     assign
      458       v-utc-time  = 'UTC ':u
      459                   + string(v-year,         '9999':u)
      460                   + '/':u
      461                   + string(v-month,        '99':u)
      462                   + '/':u
      463                   + string(v-day,          '99':u)
      464                   + ' ':u
      465                   + string(v-hour,         '99':u)
      466                   + ':':u
      467                   + string(v-minute,       '99':u)
      468                   + ':':u
      469                   + string(v-second,       '99':u)
      470                   + ' ':u
      471                   + string(v-milliseconds, '999':u)
      472     .
      473     return v-utc-time.
      474   end function .
      475   function sys-time_mjd-to-loc-str-func returns character
      476     (v-sys-mjd as decimal)
      477   :
      478     define variable v-loc-str          as character no-undo .
      479     define variable v-loc-year         as integer   no-undo .
      480     define variable v-loc-month        as integer   no-undo .
      481     define variable v-loc-day          as integer   no-undo .
      482     define variable v-loc-hour         as integer   no-undo .
      483     define variable v-loc-minute       as integer   no-undo .
      484     define variable v-loc-second       as integer   no-undo .
      485     define variable v-loc-milliseconds as integer   no-undo .
      486     run sys-time_mjd-to-loc in this-procedure
      487       (input  v-sys-mjd
      488       ,output v-loc-year
      489       ,output v-loc-month
      490       ,output v-loc-day
      491       ,output v-loc-hour
      492       ,output v-loc-minute
      493       ,output v-loc-second
      494       ,output v-loc-milliseconds
      495       ) .
      496     assign
      497       v-loc-str = substitute('&1/&2/&3 &4:&5'
      498                             ,string(v-loc-day,    '99':U)
      499                             ,string(v-loc-month,  '99':U)
      500                             ,string(v-loc-year,   '9999':U)
      501                             ,string(v-loc-hour,   '99':U)
      502                             ,string(v-loc-minute, '99':U)
      503                             )
      504     .
      505     return v-loc-str .
      506   end function .
      507   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      508   :
      509     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      510   END PROCEDURE.
      511   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      512   :
      513     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      514     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      515   END PROCEDURE.
      516   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      517   :
      518     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      519     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      520   END PROCEDURE.
