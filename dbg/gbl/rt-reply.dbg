      544   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   function octal-to-char return character
      546   ( p-string as character ) :
      547     def var v-asc     as integer no-undo .
      548     def var v-new-asc as integer no-undo .
      549     def var ind       as integer no-undo .
      550     if length(p-string) <> 3 then do:
      551       return ? .
      552     end.
      553     assign
      554       v-asc = 0
      555     .
      556     do ind = 1 to length(p-string)
      557     :
      558       assign
      559         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      560       .
      561       if v-new-asc < 0 or v-new-asc >= 8 then do:
      562         return ? .
      563       end.
      564       assign
      565         v-asc = v-asc * 8 + v-new-asc
      566       .
      567     end.
      568     return chr(v-asc) .
      569   end function .
      570   function char-to-octal return character
      571   ( p-chr as character ) :
      572     def var v-asc    as integer   no-undo .
      573     def var ind      as integer   no-undo .
      574     def var v-string as character no-undo .
      575     if length(p-chr) <> 1 then do:
      576       return ? .
      577     end.
      578     assign
      579       v-asc    = asc(p-chr)
      580       v-string = ""
      581     .
      582     do ind = 1 to 3
      583     :
      584       assign
      585         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      586       .
      587       assign
      588         v-asc = truncate(v-asc / 8, 0)
      589       .
      590     end.
      591     return v-string .
      592   end.
      593   function str-encode return character
      594   (   p-init-string       as character
      595     , p-encode-char       as character
      596     , p-special-char-list as character
      597   ) :
      598     def var p-encode-string as character no-undo .
      599     def var ind                as integer no-undo .
      600     def var v-num-special-char as integer no-undo .
      601     def var v-special-char     as character no-undo .
      602     if p-encode-char = ?
      603     or p-encode-char = "" then do:
      604       assign
      605         p-encode-char = "~~"
      606       .
      607     end.
      608     if p-init-string = ? then do:
      609       return "?" .
      610     end.
      611     if p-init-string = "?" then do:
      612       return p-encode-char + char-to-octal("?") .
      613     end.
      614     assign
      615       v-num-special-char = length(p-special-char-list)
      616       p-encode-string    = replace(p-init-string
      617                                   ,p-encode-char
      618                                   ,p-encode-char + char-to-octal(p-encode-char)
      619                                   )
      620     .
      621     do ind = 1 to v-num-special-char
      622     :
      623       assign
      624         v-special-char = substring(p-special-char-list, ind, 1)
      625       .
      626       if v-special-char <> p-encode-char then do:
      627         assign
      628           p-encode-string = replace (p-encode-string
      629                                     ,v-special-char
      630                                     ,p-encode-char + char-to-octal(v-special-char)
      631                                     )
      632         .
      633       end.
      634     end.
      635     return p-encode-string .
      636   end.
      637   function str-decode returns character
      638     (p-init-string   as character
      639     ,p-encode-char   as character
      640     ) :
      641     def var p-decode-string as character no-undo .
      642     def var ind                       as integer no-undo .
      643     def var v-num-entries-init-string as integer no-undo .
      644     def var v-sub-phrase              as character no-undo .
      645     def var v-special-char            as character no-undo .
      646     if p-encode-char = ?
      647     or p-encode-char = "" then do:
      648       assign
      649         p-encode-char = "~~"
      650       .
      651     end.
      652     if p-init-string = "?" then do:
      653       return ? .
      654     end.
      655     assign
      656       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      657     .
      658     if v-num-entries-init-string > 1 then do:
      659       assign
      660         p-decode-string = entry(1, p-init-string, p-encode-char)
      661       .
      662       do ind = 2 to v-num-entries-init-string
      663       :
      664         assign
      665           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      666         .
      667         assign
      668           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      669         .
      670         if v-special-char <> ? then do:
      671           assign
      672             p-decode-string = p-decode-string
      673                             + v-special-char
      674                             + substring(v-sub-phrase, 4)
      675           .
      676         end.
      677         else do:
      678           assign
      679             p-decode-string = p-decode-string
      680                             + p-encode-char
      681                             + v-sub-phrase
      682           .
      683         end.
      684       end.
      685     end.
      686     else do:
      687       assign
      688         p-decode-string = p-init-string
      689       .
      690     end.
      691     return p-decode-string .
      692   end.
