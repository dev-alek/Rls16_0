      784            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      785   DEFINE FRAME Dialog-Frame
      786        Copy-AgeConfirm AT ROW 30.25 COL 97 HELP
      787             "Наследовать изменения на все секции" WIDGET-ID 236
      788        TxtCopy AT ROW 2.67 COL 95 COLON-ALIGNED NO-LABEL WIDGET-ID 220
      789        TxtCopy-2 AT ROW 3.38 COL 95 COLON-ALIGNED NO-LABEL WIDGET-ID 222
      790        Proxytext AT ROW 6.96 COL 39 COLON-ALIGNED NO-LABEL WIDGET-ID 152
      791        RECT-1 AT ROW 2.21 COL 1.5 WIDGET-ID 116
      792        RECT-2 AT ROW 7.21 COL 3 WIDGET-ID 150
      793        RECT-3 AT ROW 2.42 COL 96 WIDGET-ID 218
      794        SPACE(5.00) SKIP(0.60)
      795       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      796            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      797            TITLE "Настройки для подключения к ГИС МТ и проверки КМ"
      798            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      799   ASSIGN
      800          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      801          FRAME Dialog-Frame:HIDDEN           = TRUE.
      802   ON GO OF FRAME Dialog-Frame
      803   DO:
      804     run save-proc in this-procedure no-error.
      805     if error-status :error then return no-apply.
      806   END.
      807   ON VALUE-CHANGED OF cdnTurnOn IN FRAME Dialog-Frame
      808   DO:
      809       ASSIGN cdnTurnOn.
      810       if cdnTurnOn then do:
      811          disable gisAdress with frame Dialog-Frame .
      812          enable cdnAdress with frame Dialog-Frame .
      813      end.
      814      else do:
      815          enable gisAdress with frame Dialog-Frame .
      816          disable cdnAdress with frame Dialog-Frame .
      817      end.
      818   END.
      819   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      820   DO:
      821     APPLY "END-ERROR":U TO SELF.
      822   END.
      823   ON ENTRY OF OflinePswd IN FRAME Dialog-Frame
      824   DO:
      825      self:SET-SELECTION(1,length (OflinePswd:screen-value) + 1).
      826   END.
      827   ON ENTRY OF MaxApiToken IN FRAME Dialog-Frame
      828   DO:
      829      self:SET-SELECTION(1,length (MaxApiToken:screen-value) + 1).
      830   END.
      831   ON VALUE-CHANGED OF AgeConfirmBox IN FRAME Dialog-Frame
      832   DO:
      833      assign AgeConfirmBox.
      834      AgeConfirm = lookup(AgeConfirmBox, AgeConfirmBox:LIST-ITEMS,",") - 1.
      835   END.
      836   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      837   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      838   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      839   on help of frame Dialog-Frame
      840   do:
      841     run gbl/app_help.p
      842       (input this-procedure :file-name
      843       ,input ''
      844       ,input ?
      845       ) no-error.
      846     if error-status :error then do:
      847       message
      848         "Ошибка при вызове помощи"
      849         error-status :get-message(1)
      850         view-as alert-box .
      851     end.
      852   end.
      853   run minbtn-set in this-procedure .
      854   on choose of b-help in frame Dialog-Frame
      855   do:
      856     apply "help":u to frame Dialog-Frame .
      857   end.
      858   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   procedure minbtn-set :
      860       do
      861           on error undo, return error return-value
      862           :
      863           define variable ii              as integer       no-undo .
      864           define variable fh              as widget-handle no-undo .
      865           define variable hh              as widget-handle no-undo .
      866           define variable v-h             as handle        extent 4 no-undo .
      867           define variable v-name-button   as character     no-undo .
      868           define variable v-help-old-x    as decimal       no-undo .
      869           define variable v-help-old-y    as decimal       no-undo .
      870           define variable v-help-old-size as decimal       no-undo .
      871           define variable v-frame-width   as decimal       no-undo .
      872           define variable jj              as integer       no-undo .
      873           do
      874               on error undo, return error
      875               :
      876               assign
      877                   v-frame-width = frame Dialog-Frame:width - 0.3
      878                   fh            = frame Dialog-Frame:first-child
      879                   hh            = fh:first-child
      880                   ii            = 1
      881                   .
      882               do while valid-handle(hh):
      883                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      884                   do:
      885                       case lc(hh:name) :
      886                           when "b-help" then
      887                               do:
      888                                   hh:load-image-up("cmp/b-help.bmp":u) .
      889                                   hh:load-image-down("cmp/b-help.bmp":u) .
      890                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      891                                   hh:TOOLTIP = "Помощь" .
      892                                   v-help-old-x = hh:column .
      893                                   v-help-old-y = hh:row    .
      894                                   v-help-old-size = hh:width .
      895                                   hh:width-chars = 2.5 .
      896                               end.
      897                           when "b-print" then
      898                               do:
      899                                   hh:load-image("cmp/b-print.bmp":u) .
      900                                   hh:TOOLTIP = "Печать" .
      901                                   v-h[ii] = hh:handle .
      902                                   ii = ii + 1 .
      903                                   hh:width-chars = 3 .
      904                               end.
      905                           when "b-history" or
      906                           when "b-hist" then
      907                               do:
      908                                   hh:load-image("cmp/b-hist.bmp":u) .
      909                                   hh:TOOLTIP = "История" .
      910                                   v-h[ii] = hh:handle .
      911                                   ii = ii + 1 .
      912                                   hh:width-chars = 3 .
      913                               end.
      914                           when "b-sch" then
      915                               do:
      916                                   hh:load-image("cmp/b-sch.bmp":u) .
      917                                   hh:TOOLTIP = "Установка Фильтра" .
      918                                   v-h[ii] = hh:handle .
      919                                   ii = ii + 1 .
      920                                   hh:width-chars = 3 .
      921                               end.
      922                           when "b-hist-user" then
      923                               do:
      924                                   hh:load-image("cmp/b-hist.bmp":u) .
      925                                   hh:TOOLTIP = "История пользователя" .
      926                                   ii = ii + 1 .
      927                               end.
      928                       end case.
      929                   end.
      930                   hh = hh:next-sibling.
      931               end.
      932               b-help:column = v-frame-width - b-help:width-chars.
      933               jj = 0.
      934               repeat ii = 4 to 1 by -1 :
      935                   if valid-handle (v-h[ii] ) then
      936                   do:
      937                       jj  = jj + 1 .
      938                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      939                       v-h[ii]:row    = v-help-old-y .
      940                   end.
      941               end.
      942           end.
      943       end.
      944   end procedure.
      945   MAIN-BLOCK:
      946   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      947      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      948       RUN init-tt.
      949       RUN enable_UI.
      950       RUN fill-widgets.
      951     WAIT-FOR GO OF FRAME Dialog-Frame.
      952   END.
      953   RUN disable_UI.
      954   PROCEDURE disable_UI :
      955     HIDE FRAME Dialog-Frame.
      956   END PROCEDURE.
      957   PROCEDURE enable_UI :
      958     if p-obj-type = "" and p-obj-code = 0
      959     then do:
      960         DISPLAY gisAdress cdnTurnOn cdnAdress Copy-cdnAdress registrationKey
      961               Copy-registrationKey adressPort Copy-adressPort login password
      962               Copy-LogPass dopParam Copy-dopParam OflineAdress Copy-OflineAdress
      963               OflineLogin waitTime Copy-waitTime
      964               Resp_TH_required Copy-Resp MACC_Timeout Copy-Timeout maxTime
      965               timeFalStart banDate cdnTimeUpdate MACC_PORT Copy-THport
      966               LMCHzPort Copy-LMCHzPort addTimeoutPIoT Copy-addTimeoutPIoT
      967               UpdateRequest crashSituat cdnChange cdnRepeat
      968               TxtCopy TxtCopy-2 Proxytext MaxApiToken Copy-MaxApiToken
      969               AgeConfirmBox Copy-AgeConfirm
      970         WITH FRAME Dialog-Frame.
      971         ENABLE B-exit RECT-1 RECT-2 RECT-3 B-quit B-Help gisAdress cdnTurnOn
      972                cdnAdress Copy-cdnAdress registrationKey Copy-registrationKey
      973                adressPort Copy-adressPort login password Copy-LogPass dopParam
      974                Copy-dopParam OflineAdress Copy-OflineAdress OflineLogin OflinePswd
      975                waitTime Copy-waitTime Resp_TH_required Copy-Resp
      976                MACC_Timeout Copy-Timeout maxTime timeFalStart banDate cdnTimeUpdate
      977                MACC_PORT Copy-THport LMCHzPort Copy-LMCHzPort addTimeoutPIoT Copy-addTimeoutPIoT
      978                UpdateRequest crashSituat cdnChange cdnRepeat Proxytext MaxApiToken Copy-MaxApiToken
      979                AgeConfirmBox Copy-AgeConfirm
      980         WITH FRAME Dialog-Frame.
      981         MACC_IP:VISIBLE = false.
      982         VIEW FRAME Dialog-Frame.
      983     end.
      984     else if p-obj-type = 'регион':U then do:
      985        DISPLAY gisAdress cdnTurnOn cdnAdress Copy-cdnAdress registrationKey
      986               Copy-registrationKey adressPort Copy-adressPort login password
      987               Copy-LogPass dopParam Copy-dopParam OflineAdress Copy-OflineAdress
      988               OflineLogin waitTime Copy-waitTime
      989               Resp_TH_required Copy-Resp MACC_Timeout Copy-Timeout
      990               MACC_PORT Copy-THport LMCHzPort Copy-LMCHzPort addTimeoutPIoT
      991               Copy-addTimeoutPIoT crashSituat TxtCopy TxtCopy-2 Proxytext
      992               MaxApiToken Copy-MaxApiToken AgeConfirmBox Copy-AgeConfirm
      993         WITH FRAME Dialog-Frame.
      994         ENABLE B-exit RECT-1 RECT-2 RECT-3 B-quit B-Help gisAdress cdnTurnOn
      995                cdnAdress Copy-cdnAdress registrationKey Copy-registrationKey
      996                adressPort Copy-adressPort login password Copy-LogPass dopParam
      997                Copy-dopParam OflineAdress Copy-OflineAdress OflineLogin OflinePswd
      998                waitTime Copy-waitTime Resp_TH_required Copy-Resp
      999                MACC_Timeout Copy-Timeout MACC_PORT Copy-THport LMCHzPort
     1000                Copy-LMCHzPort addTimeoutPIoT Copy-addTimeoutPIoT
     1001                crashSituat Proxytext MaxApiToken Copy-MaxApiToken
     1002                AgeConfirmBox Copy-AgeConfirm
     1003         WITH FRAME Dialog-Frame.
     1004         ASSIGN
     1005            maxTime:VISIBLE = false
     1006            timeFalStart:VISIBLE = false
     1007            banDate:VISIBLE = false
     1008            cdnTimeUpdate:VISIBLE = false
     1009            cdnRepeat:VISIBLE = false
     1010            cdnChange:VISIBLE = false
     1011            UpdateRequest:VISIBLE = false
     1012            MACC_IP:VISIBLE = false
     1013         .
     1014         VIEW FRAME Dialog-Frame.
     1015     end.
     1016     else do:
     1017         DISPLAY OflineAdress OflineLogin OflinePswd gisAdress cdnTurnOn
     1018                 cdnAdress registrationKey adressPort login password
     1019                 dopParam waitTime Proxytext crashSituat
     1020                 MACC_Timeout Resp_TH_required MACC_IP MACC_PORT LMCHzPort
     1021                 addTimeoutPIoT MaxApiToken AgeConfirmBox
     1022             WITH FRAME Dialog-Frame.
     1023         ENABLE B-exit B-quit OflineAdress OflineLogin OflinePswd gisAdress cdnTurnOn
     1024                 cdnAdress registrationKey adressPort login password
     1025                 dopParam waitTime crashSituat MACC_Timeout Resp_TH_required
     1026                 MACC_IP MACC_PORT LMCHzPort addTimeoutPIoT MaxApiToken AgeConfirmBox
     1027             WITH FRAME Dialog-Frame.
     1028         ASSIGN
     1029            maxTime:VISIBLE = false
     1030            timeFalStart:VISIBLE = false
     1031            banDate:VISIBLE = false
     1032            cdnTimeUpdate:VISIBLE = false
     1033            cdnRepeat:VISIBLE = false
     1034            cdnChange:VISIBLE = false
     1035            UpdateRequest:VISIBLE = false
     1036            Copy-cdnAdress:VISIBLE = false
     1037            Copy-registrationKey:VISIBLE = false
     1038            Copy-adressPort:VISIBLE = false
     1039            Copy-LogPass:VISIBLE = false
     1040            Copy-dopParam:VISIBLE = false
     1041            Copy-OflineAdress:VISIBLE = false
     1042            Copy-waitTime:VISIBLE = false
     1043            Copy-Resp:VISIBLE = false
     1044            Copy-Timeout:VISIBLE = false
     1045            Copy-THport:VISIBLE = false
     1046            Copy-LMCHzPort:VISIBLE = false
     1047            Copy-addTimeoutPIoT:VISIBLE = false
     1048            TxtCopy:VISIBLE = false
     1049            TxtCopy-2:VISIBLE = false
     1050            RECT-3:VISIBLE = false
     1051            Copy-AgeConfirm:VISIBLE = false
     1052            Copy-MaxApiToken:VISIBLE = false
     1053         .
     1054         VIEW FRAME Dialog-Frame.
     1055     end.
     1056   END PROCEDURE.
     1057   PROCEDURE fill-widgets :
     1058   define variable v-value-character as character no-undo .
     1059   define variable v-value-date as date no-undo .
     1060   define variable v-value-decimal as decimal no-undo .
     1061   define variable v-value-integer as INTEGER no-undo .
     1062   define variable v-value-logical AS LOGICAL no-undo .
     1063   define variable v-param-type as character no-undo .
     1064   define variable v-param-value as character no-undo .
     1065   for each temp-thbj-attr:
     1066     delete temp-thbj-attr.
     1067   end.
     1068   run adm/shattri.p (
     1069       input "init":U
     1070     , input p-obj-type
     1071     , input p-obj-code
     1072     , input 'gisMT':U
     1073     , input "":U
     1074     , output v-value-character
     1075     , output v-value-date
     1076     , output v-value-decimal
     1077     , output v-value-integer
     1078     , output v-value-logical
     1079     , output v-param-type
     1080     , input-output TABLE-HANDLE v-tth
     1081     ) no-error .
     1082   if error-status:error then do:
     1083     message
     1084     "Не удалось получить начальные значения настроек" skip
     1085     error-status:get-message(1) return-value
     1086     view-as alert-box error .
     1087     undo, return error .
     1088   end.
     1089   FOR EACH temp-thbj-attr
     1090     :
     1091       if p-obj-type eq "" and p-obj-code = 0
     1092       then do:
     1093           IF temp-thbj-attr.prop-code = 'maxTime':U THEN DO:
     1094              maxTime = temp-thbj-attr.property-value-integer.
     1095              display maxTime with frame Dialog-Frame .
     1096           END.
     1097           else IF temp-thbj-attr.prop-code = 'timeFalStart':U THEN DO:
     1098              timeFalStart = temp-thbj-attr.property-value-integer.
     1099              display timeFalStart with frame Dialog-Frame .
     1100           END.
     1101           else IF temp-thbj-attr.prop-code = 'crashSituat':U THEN DO:
     1102              crashSituat = temp-thbj-attr.property-value-logical.
     1103              display crashSituat with frame Dialog-Frame .
     1104           END.
     1105           else IF temp-thbj-attr.prop-code = 'banDate':U THEN DO:
     1106              banDate = temp-thbj-attr.property-value-integer.
     1107              display banDate with frame Dialog-Frame .
     1108           END.
     1109           else IF temp-thbj-attr.prop-code = 'cdnRepeat':U THEN DO:
     1110              cdnRepeat = temp-thbj-attr.property-value-logical.
     1111              display cdnRepeat with frame Dialog-Frame .
     1112           END.
     1113           else IF temp-thbj-attr.prop-code = 'cdnChange':U THEN DO:
     1114              cdnChange = temp-thbj-attr.property-value-logical.
     1115              display cdnChange with frame Dialog-Frame .
     1116           END.
     1117           else IF temp-thbj-attr.prop-code = 'cdnTimeUpdate':U THEN DO:
     1118              cdnTimeUpdate = temp-thbj-attr.property-value-integer.
     1119              display cdnTimeUpdate with frame Dialog-Frame .
     1120           END.
     1121           else IF temp-thbj-attr.prop-code = 'UpdateRequest':U THEN DO:
     1122              UpdateRequest = temp-thbj-attr.property-value-logical.
     1123              display UpdateRequest with frame Dialog-Frame .
     1124           END.
     1125       end.
     1126       IF temp-thbj-attr.prop-code = 'adressPort':U THEN DO:
     1127           adressPort = temp-thbj-attr.property-value-character.
     1128           display adressPort with frame Dialog-Frame .
     1129        END.
     1130        else IF temp-thbj-attr.prop-code = 'dopParam':U THEN DO:
     1131           dopParam = temp-thbj-attr.property-value-character.
     1132           display dopParam with frame Dialog-Frame .
     1133        END.
     1134        else IF temp-thbj-attr.prop-code = 'gisAdress':U THEN DO:
     1135           gisAdress = temp-thbj-attr.property-value-character.
     1136           display gisAdress with frame Dialog-Frame .
     1137        END.
     1138        else IF temp-thbj-attr.prop-code = 'proxyLogin':U THEN DO:
     1139           login = temp-thbj-attr.property-value-character.
     1140           display login with frame Dialog-Frame .
     1141        END.
     1142        else IF temp-thbj-attr.prop-code = 'proxyPswd':U THEN DO:
     1143           password = temp-thbj-attr.property-value-character.
     1144           display password with frame Dialog-Frame .
     1145        END.
     1146        else IF temp-thbj-attr.prop-code = 'regKey':U THEN DO:
     1147           registrationKey = temp-thbj-attr.property-value-character.
     1148           display registrationKey with frame Dialog-Frame .
     1149        END.
     1150        else IF temp-thbj-attr.prop-code = 'waitTime':U THEN DO:
     1151           waitTime = temp-thbj-attr.property-value-decimal.
     1152           display waitTime with frame Dialog-Frame .
     1153        END.
     1154        else IF temp-thbj-attr.prop-code = 'cdnTurnOn':U THEN DO:
     1155           cdnTurnOn = temp-thbj-attr.property-value-logical.
     1156           display cdnTurnOn with frame Dialog-Frame .
     1157        END.
     1158        else IF temp-thbj-attr.prop-code = 'cdnAdress':U THEN DO:
     1159           cdnAdress = temp-thbj-attr.property-value-character.
     1160           display cdnAdress with frame Dialog-Frame .
     1161        END.
     1162       else IF temp-thbj-attr.prop-code = 'OflineAdress':U THEN DO:
     1163          OflineAdress = temp-thbj-attr.property-value-character.
     1164          display OflineAdress with frame Dialog-Frame .
     1165       END.
     1166       else IF temp-thbj-attr.prop-code = 'OflineLogin':U THEN DO:
     1167          OflineLogin = temp-thbj-attr.property-value-character.
     1168          display OflineLogin with frame Dialog-Frame .
     1169       END.
     1170       else IF temp-thbj-attr.prop-code = 'OflinePswd':U THEN DO:
     1171          OflinePswd = fill("*",length (temp-thbj-attr.property-value-character)).
     1172          display OflinePswd with frame Dialog-Frame .
     1173       END.
     1174       else IF temp-thbj-attr.prop-code = 'crashSituat':U THEN DO:
     1175          crashSituat = temp-thbj-attr.property-value-logical.
     1176          display crashSituat with frame Dialog-Frame .
     1177       END.
     1178       else if temp-thbj-attr.prop-code = 'MACC_Timeout':U then do:
     1179          MACC_Timeout = temp-thbj-attr.property-value-decimal.
     1180          display MACC_Timeout with frame Dialog-Frame .
     1181       end.
     1182       else if temp-thbj-attr.prop-code = 'Resp_TH_required':U then do:
     1183       if available temp-thbj-attr
     1184       then
     1185          Resp_TH_required = if temp-thbj-attr.property-value-integer = 1 then "Да" else "Нет".
     1186          display Resp_TH_required with frame Dialog-Frame .
     1187       end.
     1188       else if temp-thbj-attr.prop-code = 'TH_IP':U
     1189               and p-obj-type = 'БД':U
     1190       then do:
     1191          MACC_IP = temp-thbj-attr.property-value-character.
     1192          display MACC_IP with frame Dialog-Frame .
     1193       end.
     1194       else if temp-thbj-attr.prop-code = 'TH_Port':U then do:
     1195          MACC_PORT = temp-thbj-attr.property-value-character.
     1196          display MACC_PORT with frame Dialog-Frame .
     1197       end.
     1198       else if temp-thbj-attr.prop-code = 'LmCHzPort':U then do:
     1199          LMCHzPort = temp-thbj-attr.property-value-character.
     1200          display LMCHzPort with frame Dialog-Frame .
     1201       end.
     1202       else if temp-thbj-attr.prop-code = 'AddTimeoutPIoT':U then do:
     1203          AddTimeoutPIoT = temp-thbj-attr.property-value-decimal.
     1204          display AddTimeoutPIoT with frame Dialog-Frame .
     1205       end.
     1206       else if temp-thbj-attr.prop-code = 'MaxApiToken':U then do:
     1207          MaxApiToken = fill("*",length (temp-thbj-attr.property-value-character)).
     1208          display MaxApiToken with frame Dialog-Frame .
     1209       end.
     1210       else if temp-thbj-attr.prop-code = 'AgeConfirm':U then do:
     1211          AgeConfirm = temp-thbj-attr.property-value-integer.
     1212       end.
     1213       else if p-obj-type ne ""
     1214       then do:
     1215          delete temp-thbj-attr.
     1216       end.
     1217   END.
     1218      if p-mode NE 'ПРОСМОТР':U then do:
     1219          if cdnTurnOn then do:
     1220             disable gisAdress with frame Dialog-Frame .
     1221             enable cdnAdress with frame Dialog-Frame .
     1222          end.
     1223          else do:
     1224             enable gisAdress with frame Dialog-Frame .
     1225             disable cdnAdress with frame Dialog-Frame .
     1226          end.
     1227      end.
     1228      AgeConfirmBox =  entry((AgeConfirm + 1), AgeConfirmBox:LIST-ITEMS,",").
     1229      display AgeConfirmBox  with frame Dialog-Frame .
     1230      if p-mode = 'ПРОСМОТР':U then do:
     1231         disable all WITH FRAME Dialog-Frame .
     1232         ENABLE B-quit b-help WITH FRAME Dialog-Frame.
     1233         B-quit:label = "Вы&ход"  .
     1234         hide B-exit in frame Dialog-Frame .
     1235      end.
     1236   END PROCEDURE.
     1237   PROCEDURE init-tt :
     1238   END PROCEDURE.
     1239   PROCEDURE save-proc :
     1240   define variable v-value-character as character no-undo .
     1241   define variable v-value-date as date no-undo .
     1242   define variable v-value-decimal as decimal no-undo .
     1243   define variable v-value-integer as INTEGER no-undo .
     1244   define variable v-value-logical AS LOGICAL no-undo .
     1245   define variable v-param-type as character no-undo .
     1246   define variable v-gds-copy-list as character no-undo .
     1247   define variable v-gdsreffi as character no-undo .
     1248   define variable wh as widget-handle no-undo .
     1249   define variable fh as widget-handle no-undo .
     1250   define variable v-same as logical no-undo .
     1251   define buffer buf_temp-thbj-attr for temp-thbj-attr .
     1252   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1253   ASSIGN FRAME Dialog-Frame
     1254       adressPort
     1255       dopParam
     1256       gisAdress
     1257       login
     1258       password
     1259       maxTime
     1260       registrationKey
     1261       timeFalStart
     1262       waitTime
     1263       crashSituat
     1264       banDate
     1265       cdnTurnOn
     1266       cdnAdress
     1267       cdnRepeat
     1268       cdnChange
     1269       cdnTimeUpdate
     1270       UpdateRequest
     1271       OflineAdress
     1272       OflineLogin
     1273       OflinePswd
     1274       MACC_Timeout
     1275       Resp_TH_required
     1276       MACC_IP
     1277       MACC_PORT
     1278       LMCHzPort
     1279       AddTimeoutPIoT
     1280       MaxApiToken
     1281       Copy-cdnAdress
     1282       Copy-registrationKey
     1283       Copy-adressPort
     1284       Copy-LogPass
     1285       Copy-dopParam
     1286       Copy-OflineAdress
     1287       Copy-waitTime
     1288       Copy-Resp
     1289       Copy-Timeout
     1290       Copy-THport
     1291       Copy-LMCHzPort
     1292       Copy-addTimeoutPIoT
     1293       Copy-AgeConfirm
     1294       Copy-MaxApiToken
     1295       .
     1296       for each temp-thbj-attr where
     1297                temp-thbj-attr.obj-type = p-obj-type and
     1298                temp-thbj-attr.obj-code = p-obj-code:
     1299          case temp-thbj-attr.prop-code:
     1300              when 'adressPort':U
     1301              then do:
     1302                 if temp-thbj-attr.property-value-character <> adressPort
     1303                 then do:
     1304                    create thbjattr-list.
     1305                    buffer-copy temp-thbj-attr to thbjattr-list.
     1306                 end.
     1307                 temp-thbj-attr.property-value-character = adressPort.
     1308              end.
     1309              when 'dopParam':U then
     1310                 temp-thbj-attr.property-value-character = dopParam.
     1311              when 'gisAdress':U then
     1312                 temp-thbj-attr.property-value-character = gisAdress.
     1313              when 'proxyLogin':U
     1314              then do:
     1315                  if temp-thbj-attr.property-value-character <> login
     1316                 then do:
     1317                    create thbjattr-list.
     1318                    buffer-copy temp-thbj-attr to thbjattr-list.
     1319                 end.
     1320                 temp-thbj-attr.property-value-character = login.
     1321              end.
     1322              when  'proxyPswd':U
     1323              then do:
     1324                 if temp-thbj-attr.property-value-character <> password
     1325                 then do:
     1326                    create thbjattr-list.
     1327                    buffer-copy temp-thbj-attr to thbjattr-list.
     1328                 end.
     1329                 temp-thbj-attr.property-value-character = password.
     1330              end.
     1331              when 'maxTime':U
     1332              then do:
     1333                 if temp-thbj-attr.property-value-integer <> maxTime
     1334                 then do:
     1335                    create thbjattr-list.
     1336                    buffer-copy temp-thbj-attr to thbjattr-list.
     1337                 end.
     1338                 temp-thbj-attr.property-value-integer = maxTime.
     1339              end.
     1340              when 'regKey':U then
     1341                 temp-thbj-attr.property-value-character = registrationKey.
     1342              when 'timeFalStart':U
     1343              then do:
     1344                 if temp-thbj-attr.property-value-integer = timeFalStart
     1345                 then do:
     1346                    create thbjattr-list.
     1347                    buffer-copy temp-thbj-attr to thbjattr-list.
     1348                 end.
     1349                 temp-thbj-attr.property-value-integer = timeFalStart.
     1350              end.
     1351              when 'waitTime':U
     1352              then do:
     1353                  if temp-thbj-attr.property-value-decimal <> waitTime
     1354                  then do:
     1355                     create thbjattr-list.
     1356                     buffer-copy temp-thbj-attr to thbjattr-list.
     1357                  end.
     1358                  temp-thbj-attr.property-value-decimal = waitTime.
     1359              end.
     1360              when 'crashSituat':U
     1361              then do:
     1362                 if temp-thbj-attr.property-value-logical <> crashSituat
     1363                 then do:
     1364                    create thbjattr-list.
     1365                    buffer-copy temp-thbj-attr to thbjattr-list.
     1366                 end.
     1367                 temp-thbj-attr.property-value-logical = crashSituat.
     1368              end.
     1369              when 'banDate':U
     1370              then do:
     1371                 if temp-thbj-attr.property-value-integer <> banDate
     1372                 then do:
     1373                    create thbjattr-list.
     1374                    buffer-copy temp-thbj-attr to thbjattr-list.
     1375                 end.
     1376                 temp-thbj-attr.property-value-integer = banDate.
     1377              end.
     1378              when 'cdnTurnOn':U then
     1379                 temp-thbj-attr.property-value-logical = cdnTurnOn.
     1380              when 'cdnAdress':U then
     1381                 temp-thbj-attr.property-value-character = cdnAdress.
     1382              when 'cdnRepeat':U then
     1383                 temp-thbj-attr.property-value-logical = cdnRepeat.
     1384              when 'cdnChange':U then
     1385                 temp-thbj-attr.property-value-logical = cdnChange.
     1386              when 'cdnTimeUpdate':U then
     1387                 temp-thbj-attr.property-value-integer = cdnTimeUpdate.
     1388              when 'UpdateRequest':U then
     1389                 temp-thbj-attr.property-value-logical = UpdateRequest.
     1390              when 'OflineAdress':U then
     1391                 temp-thbj-attr.property-value-character = OflineAdress.
     1392              when 'OflineLogin':U
     1393              then do:
     1394                 if temp-thbj-attr.property-value-character <> OflineLogin
     1395                 then do:
     1396                    create thbjattr-list.
     1397                    buffer-copy temp-thbj-attr to thbjattr-list.
     1398                 end.
     1399                 temp-thbj-attr.property-value-character = OflineLogin.
     1400              end.
     1401              when 'OflinePswd':U
     1402              then do:
     1403                 if (OflinePswd eq "" or (replace(OflinePswd,"*","") ne "" and OflinePswd ne ?)) then
     1404                 do:
     1405                    if temp-thbj-attr.property-value-character <> OflinePswd
     1406                    then do:
     1407                       create thbjattr-list.
     1408                       buffer-copy temp-thbj-attr to thbjattr-list.
     1409                    end.
     1410                    temp-thbj-attr.property-value-character = OflinePswd.
     1411                 end.
     1412              end.
     1413              when 'MACC_Timeout':U
     1414              then do:
     1415                  if temp-thbj-attr.property-value-decimal <> MACC_Timeout
     1416                  then do:
     1417                     create thbjattr-list.
     1418                     buffer-copy temp-thbj-attr to thbjattr-list.
     1419                  end.
     1420                  temp-thbj-attr.property-value-decimal = MACC_Timeout.
     1421              end.
     1422              when 'Resp_TH_required':U
     1423              then do:
     1424                  if (temp-thbj-attr.property-value-integer = 0 and Resp_TH_required = "Да") or
     1425                     (temp-thbj-attr.property-value-integer = 1 and Resp_TH_required <> "Да")
     1426                  then do:
     1427                     create thbjattr-list.
     1428                     buffer-copy temp-thbj-attr to thbjattr-list.
     1429                  end.
     1430                  temp-thbj-attr.property-value-integer = if Resp_TH_required = "Да" then 1 else 0.
     1431              end.
     1432              when 'TH_IP':U then do:
     1433                 if MACC_IP <> "" and temp-thbj-attr.property-value-character <> MACC_IP
     1434                 then do:
     1435                    create thbjattr-list.
     1436                    buffer-copy temp-thbj-attr to thbjattr-list.
     1437                 end.
     1438                 temp-thbj-attr.property-value-character = MACC_IP.
     1439              end.
     1440              when 'TH_Port':U then do:
     1441                 if temp-thbj-attr.property-value-character <> MACC_PORT
     1442                 then do:
     1443                    create thbjattr-list.
     1444                    buffer-copy temp-thbj-attr to thbjattr-list.
     1445                 end.
     1446                 temp-thbj-attr.property-value-character = MACC_PORT.
     1447              end.
     1448              when 'LmCHzPort':U then do:
     1449                 if temp-thbj-attr.property-value-character <> LMCHzPort
     1450                 then do:
     1451                    create thbjattr-list.
     1452                    buffer-copy temp-thbj-attr to thbjattr-list.
     1453                 end.
     1454                 temp-thbj-attr.property-value-character = LMCHzPort.
     1455              end.
     1456              when 'AddTimeoutPIoT':U then do:
     1457                 if temp-thbj-attr.property-value-decimal <> AddTimeoutPIoT
     1458                 then do:
     1459                    create thbjattr-list.
     1460                    buffer-copy temp-thbj-attr to thbjattr-list.
     1461                 end.
     1462                 temp-thbj-attr.property-value-decimal = AddTimeoutPIoT.
     1463              end.
     1464              when 'MaxApiToken':U then do:
     1465                 if (MaxApiToken eq "" or (replace(MaxApiToken,"*","") ne "" and MaxApiToken ne ?)) then
     1466                 do:
     1467                     if temp-thbj-attr.property-value-character <> MaxApiToken
     1468                     then do:
     1469                        create thbjattr-list.
     1470                        buffer-copy temp-thbj-attr to thbjattr-list.
     1471                     end.
     1472                     temp-thbj-attr.property-value-character = MaxApiToken.
     1473                 end.
     1474              end.
     1475              when 'AgeConfirm':U then do:
     1476                 if temp-thbj-attr.property-value-integer <> AgeConfirm
     1477                 then do:
     1478                    create thbjattr-list.
     1479                    buffer-copy temp-thbj-attr to thbjattr-list.
     1480                 end.
     1481                 temp-thbj-attr.property-value-integer = AgeConfirm.
     1482              end.
     1483          end.
     1484       end.
     1485       do transaction:
     1486           RUN thbjattr_set-section IN THIS-PROCEDURE (
     1487                input p-obj-type
     1488               ,input p-obj-code
     1489               ,input 'gisMT':U
     1490               ,INPUT table temp-thbj-attr
     1491           ) NO-ERROR.
     1492           if error-status:error then do:
     1493               message "Не удалось сохранить настройки"
     1494               view-as alert-box.
     1495               undo, return error.
     1496           end.
     1497           if p-obj-type eq 'БД':U and
     1498              can-find(first thbjattr-list) then
     1499           run str/diallog.w (
     1500               input parparentproc
     1501             , input this-procedure
     1502             , input "str/send-all.p":U
     1503             , input ( p-obj-type + chr(4) + string(p-obj-code) + chr(4) + 'U':U + chr(4) + 'gismt':U + chr(4) + 'Передача параметров работы с ТСПИоТ':U)
     1504             , input ?
     1505             , input "":U
     1506             , input substitute("Отсылка параметров работы с ТСПИоТ")
     1507             ) no-error.
     1508           if p-obj-type ne 'БД':U and
     1509              (Copy-cdnAdress       or
     1510               Copy-registrationKey or
     1511               Copy-adressPort      or
     1512               Copy-LogPass         or
     1513               Copy-dopParam        or
     1514               Copy-OflineAdress    or
     1515               Copy-waitTime        or
     1516               Copy-Resp            or
     1517               Copy-Timeout         or
     1518               Copy-THport          or
     1519               Copy-LMCHzPort       or
     1520               Copy-addTimeoutPIoT  or
     1521               Copy-MaxApiToken     or
     1522               Copy-AgeConfirm)
     1523           then do:
     1524               MESSAGE "Подтверждаете изменение значений в локальных секциях?"
     1525                   VIEW-AS ALERT-BOX QUESTION
     1526                   BUTTONS YES-NO
     1527                   UPDATE v-copy AS LOGICAL.
     1528               if v-copy then do:
     1529                  run ObjCodeCreate.
     1530                  if Copy-cdnAdress then run PropCopy('cdnAdress':U).
     1531                  if Copy-registrationKey then run PropCopy('regKey':U).
     1532                  if Copy-adressPort then run PropCopy('adressPort':U).
     1533                  if Copy-LogPass then do:
     1534                     run PropCopy('proxyLogin':U).
     1535                     run PropCopy('proxyPswd':U).
     1536                  end.
     1537                  if Copy-dopParam then run PropCopy('dopParam':U).
     1538                  if Copy-OflineAdress then run PropCopy('OflineAdress':U).
     1539                  if Copy-waitTime then run PropCopy('waitTime':U).
     1540                  if Copy-Resp then run PropCopy('Resp_TH_required':U).
     1541                  if Copy-Timeout then run PropCopy('MACC_Timeout':U).
     1542                  if Copy-THport then run PropCopy('TH_Port':U).
     1543                  if Copy-LMCHzPort then run PropCopy('LmCHzPort':U).
     1544                  if Copy-addTimeoutPIoT then run PropCopy('AddTimeoutPIoT':U).
     1545                  if Copy-MaxApiToken then run PropCopy('MaxApiToken':U).
     1546                  if Copy-AgeConfirm then run PropCopy('AgeConfirm':U).
     1547               end.
     1548            end.
     1549       end.
     1550   END PROCEDURE.
     1551   PROCEDURE ObjCodeCreate:
     1552      define buffer buf_thbj-attr for ub.thbj-attr.
     1553      define variable v-reg-code as integer no-undo.
     1554      bth:
     1555      for each buf_thbj-attr no-lock where
     1556              (buf_thbj-attr.obj-type = 'БД':U
     1557           and buf_thbj-attr.prop-code       = ''
     1558           and buf_thbj-attr.upper-prop-code = 'gisMT':U
     1559               )
     1560           or (p-obj-type = ""
     1561           and buf_thbj-attr.obj-type = 'регион':U
     1562           and buf_thbj-attr.prop-code       = ''
     1563           and buf_thbj-attr.upper-prop-code = 'gisMT':U)
     1564           :
     1565         if p-obj-type = 'регион':U then do:
     1566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run regcode in g#library
     1568     (input  buf_thbj-attr.obj-type
     1569     ,input  buf_thbj-attr.obj-code
     1570     ,output v-reg-code
     1571     )  .
     1572             if v-reg-code <> p-obj-code then next bth.
     1573         end.
     1574         find first x_thbj-attr where
     1575             x_thbj-attr.obj-type = buf_thbj-attr.obj-type and
     1576             x_thbj-attr.obj-code = buf_thbj-attr.obj-code no-error .
     1577         if not available x_thbj-attr then do:
     1578           create  x_thbj-attr.
     1579           buffer-copy buf_thbj-attr to X_thbj-attr.
     1580         end.
     1581      end.
     1582   END PROCEDURE.
     1583   PROCEDURE PropCopy:
     1584       define input parameter p-prop-code as character no-undo.
     1585       define buffer buf_thbj-attr for ub.thbj-attr.
     1586       define buffer thbj-attr for ub.thbj-attr.
     1587       find first thbj-attr where
     1588                  thbj-attr.obj-type = p-obj-type
     1589              and thbj-attr.obj-code = p-obj-code
     1590              and thbj-attr.upper-prop-code = 'gisMT':U
     1591              and thbj-attr.prop-code = p-prop-code
     1592            no-lock no-error.
     1593       if avail thbj-attr then
     1594       do transaction:
     1595           for each x_thbj-attr:
     1596              find first buf_thbj-attr exclusive-lock where
     1597                         buf_thbj-attr.obj-type = x_thbj-attr.obj-type
     1598                     and buf_thbj-attr.obj-code = x_thbj-attr.obj-code
     1599                     and buf_thbj-attr.upper-prop-code = 'gisMT':U
     1600                     and buf_thbj-attr.prop-code = p-prop-code
     1601              no-wait no-error.
     1602              if not avail buf_thbj-attr
     1603                 and not locked buf_thbj-attr
     1604              then do:
     1605                  create buf_thbj-attr.
     1606                  assign
     1607                     buf_thbj-attr.obj-type = 'БД':U
     1608                     buf_thbj-attr.obj-code = x_thbj-attr.obj-code
     1609                     .
     1610              end.
     1611              if avail buf_thbj-attr then
     1612              buffer-copy  thbj-attr except obj-type obj-code to buf_thbj-attr.
     1613           end.
     1614       end.
     1615   END PROCEDURE.
