      439   procedure onewin_clear :
      440       define buffer buf_temp_onewin_items        for temp_onewin_items.
      441   do
      442   for buf_temp_onewin_items
      443   on error undo, return error
      444   :
      445       empty temp-table buf_temp_onewin_items.
      446   end.
      447   end procedure.
      448   procedure onewin_add-item :
      449   define input parameter p-ext-key   as character        no-undo.
      450   define input parameter p-item-name as character        no-undo.
      451   define input parameter p-item-desc as character        no-undo.
      452   define input parameter p-selected  as logical          no-undo.
      453       define buffer buf_temp_onewin_items        for temp_onewin_items.
      454   do
      455   for buf_temp_onewin_items
      456   on error undo, return error
      457   :
      458       find last buf_temp_onewin_items no-error.
      459       if available buf_temp_onewin_items then do:
      460         v-onewin2-itm-key = buf_temp_onewin_items.itm-key.
      461       end.
      462       else do:
      463         v-onewin2-itm-key = 0.
      464       end.
      465       assign
      466           v-onewin2-itm-key = v-onewin2-itm-key + 1
      467       .
      468       create buf_temp_onewin_items.
      469       assign
      470       buf_temp_onewin_items.itm-key      = v-onewin2-itm-key
      471       buf_temp_onewin_items.itmExtKey    = p-ext-key
      472       buf_temp_onewin_items.itmName      = p-item-name
      473       buf_temp_onewin_items.itmDesc      = p-item-desc
      474       buf_temp_onewin_items.itmSelected  = p-selected
      475       .
      476   end.
      477   end procedure.
      478   procedure onewin_create-selection :
      479   define input parameter p-itm-key as integer no-undo .
      480   define input parameter p-itmextkey as character no-undo .
      481   define variable v-counter as integer no-undo .
      482   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      483   do
      484   on error undo, return error
      485   :
      486     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      487     if available buf_temp_onewin_itemsSelected then do:
      488       v-counter = buf_temp_onewin_itemsSelected.its-key.
      489     end.
      490     find first buf_temp_onewin_itemsSelected where
      491          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      492     if not available buf_temp_onewin_itemsSelected then do:
      493       create buf_temp_onewin_itemsSelected.
      494       assign
      495       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      496       v-counter = v-counter + 1
      497       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      498       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      499       .
      500     end.
      501   end.
      502   end procedure.
      503   procedure onewin_check-item :
      504   define input parameter p-ext-key   as character        no-undo.
      505   define output parameter p-exists as logical no-undo .
      506   define buffer buf_temp_onewin_items for temp_onewin_items.
      507   find first buf_temp_onewin_items where
      508   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      509   if available buf_temp_onewin_items then do:
      510     p-exists = yes.
      511   end.
      512   end procedure.
