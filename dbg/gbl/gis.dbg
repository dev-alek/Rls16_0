      188       ,output p-output-display
      189       ,output p-other
      190       ,output p-prop-list
      191       ,output p-prop-type-list
      192       ,output p-prop-label-list
      193       ,output p-global
      194       ,output p-host
      195       ,output p-shop
      196       ,output p-store
      197       ,output p-db
      198       ,output p-region
      199       ) no-error .
      200     if error-status :error
      201     then do:
      202       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      203     end.
      204   end.
      205   end procedure.
