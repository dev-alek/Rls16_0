      172   define output parameter p-prop-type-list as character no-undo .
      173   define output parameter p-prop-label-list as character no-undo .
      174   define output parameter p-global          as logical no-undo .
      175   define output parameter p-host           as logical no-undo .
      176   define output parameter p-shop           as logical no-undo .
      177   define output parameter p-store          as logical no-undo .
      178   define output parameter p-db             as logical no-undo .
      179   define output parameter p-region         as logical no-undo .
      180   do
      181   on error undo, return error return-value
      182   :
      183       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      184       (input  p-upper-code
      185       ,input  p-code
      186       ,output p-label
