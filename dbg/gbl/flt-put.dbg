        1   block-level on error undo, throw.
        2   define input parameter c-p as character no-undo .
        3   define input parameter g#report-num as integer no-undo .
        4   define output parameter flt-rec as recid no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: flt-put.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/flt-put.p $":U .
       10   define variable vss-description as character no-undo init "Сохраняет условие выборки фильтра во временные файлы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2',c-p, g#report-num)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable ii as integer no-undo.
       84   define variable jj as integer no-undo.
       85   assign
       86     flt-rec = ?
       87   .
       88   if num-entries(c-p, chr(4)) > 1 then do:
       89     assign
       90     c-p        = entry(1, c-p, chr(4))
       91     .
       92   end.
       93   find ubflt.usr-flt no-lock
       94     where ubflt.usr-flt.user-name = g#userid
       95       and ubflt.usr-flt.call-point = c-p
       96     no-error .
       97   if available ubflt.usr-flt then do:
       98     find ubflt.filter no-lock
       99       where ubflt.filter.call-point = ubflt.usr-flt.call-point
      100         and ubflt.filter.naim       = ubflt.usr-flt.naim
      101       no-error .
      102     if available ubflt.filter then do:
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   define variable v-flt-put-ind1 as integer   no-undo .
      105   define variable v-flt-put-ind-sort1 as integer   no-undo .
      106   output to value(string(g#report-num) + ".whr").
      107   put .
      108   if num-entries(ubflt.filter.where-ysl) > 0 then do:
      109      put unformatted 'and ('.
      110      do v-flt-put-ind1 = 1 to num-entries(ubflt.filter.where-ysl):
      111        put unformatted entry(v-flt-put-ind1, ubflt.filter.where-ysl) skip.
      112      end.
      113      put unformatted ')'.
      114   end.
      115   output close.
      116   output to value(string(g#report-num) + ".srt").
      117   put .
      118   do v-flt-put-ind1 = 1 to num-entries(ubflt.filter.fields-sort):
      119      if  entry(v-flt-put-ind1, ubflt.filter.fields-sort) <> "" then do:
      120          do v-flt-put-ind-sort1 = 1 to num-entries(entry(v-flt-put-ind1, ubflt.filter.fields-sort),'*'):
      121               put  unformatted " by " + entry(v-flt-put-ind-sort1,entry(v-flt-put-ind1, ubflt.filter.fields-sort),'*').
      122               if entry(v-flt-put-ind1, ubflt.filter.lst-cend) = '1' then put " descending".
      123           end.
      124      end.
      125   end.
      126   output close.
      127       assign
      128         flt-rec = recid (ubflt.filter)
      129       .
      130     end.
      131     else do:
      132       assign
      133         flt-rec = ?
      134       .
      135     end.
      136   end.
      137   else do:
      138     assign
      139       flt-rec = ?
      140     .
      141   end.
      142   if flt-rec = ? then do:
      143   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   output to value(string(g#report-num) + ".whr") .
      145   put.
      146   output close.
      147   output to value(string(g#report-num) + ".srt"). .
      148   put.
      149   output close.
      150   end.
