        1   block-level on error undo, throw.
        2   define input  parameter p-month as integer   no-undo .
        3   define input  parameter p-year  as integer   no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: expertek $":U .
        6   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: prnmonth.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: gbl/prnmonth.p $":U .
        9   def var vss-description as character no-undo init "Печать календаря на один месяц".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define new shared variable RepPathName        as character no-undo .
       73   define new shared variable PrintRubl          as logical   no-undo .
       74   define variable v-month-name   as character no-undo .
       75   define variable v-month-offset as integer   no-undo .
       76   define variable v-ind       as integer   no-undo .
       77   define variable v-row       as integer   no-undo .
       78   define variable v-last-day  as integer   no-undo .
       79   define variable v-day-label as integer   no-undo extent 42 .
       80   define variable v-day-row   as integer   no-undo .
       81   define variable v-day-col   as integer   no-undo .
       82   define stream PrnLibStream .
       83   do
       84   on error undo, return error return-value
       85   :
       86     run gbl/monthnam.p
       87       (input  p-month
       88       ,output v-month-name
       89       ).
       90     run gbl/lastday.p
       91       (input  date(p-month, 1, p-year)
       92       ,output v-last-day
       93       ).
       94     assign
       95       v-month-offset = (weekday(date(p-month, 1, p-year)) + 5) mod 7
       96     .
       97     do v-ind = 1 to v-last-day
       98     :
       99       assign
      100         v-day-label[v-ind + v-month-offset] = v-ind
      101       .
      102     end.
      103     output stream PrnLibStream to value('prnmonth.txt':u) .
      104     put stream PrnLibStream unformatted
      105       substitute("Календарь на &1 &2 года", v-month-name, p-year)
      106       chr(10) .
      107     put stream PrnLibStream unformatted
      108       ":-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:"
      109       chr(10) .
      110     put stream PrnLibStream unformatted
      111       ": Понедельник             : Вторник                 : Среда                   : Четверг                 : Пятница                 : Суббота                 : Воскресенье             :"
      112       chr(10) .
      113     put stream PrnLibStream unformatted
      114       ":-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:-------------------------:"
      115       chr(10) .
      116     do v-day-row = 0 to 5
      117     :
      118       do v-row = 1 to 7
      119       :
      120         do v-day-col = 1 to 7
      121         :
      122           assign
      123             v-ind = v-day-row * 7 + v-day-col
      124           .
      125           if v-day-label[v-ind] <> 0
      126           then do:
      127             case v-row
      128             :
      129               when 1
      130               then do:
      131                 put stream PrnLibStream unformatted
      132                   ": " + substring(string(v-day-label[v-ind], ">9") + fill(" ", 24), 1, 24)
      133                   .
      134               end.
      135               when 7
      136               then do:
      137                 put stream PrnLibStream unformatted
      138                   ":" + fill("-", 25)
      139                   .
      140               end.
      141               otherwise do:
      142                 put stream PrnLibStream unformatted
      143                   ":" + fill(" ", 25)
      144                   .
      145               end.
      146             end.
      147           end.
      148           else do:
      149             if  v-row = 7
      150             and v-ind + 7 <= 42
      151             and v-day-label[v-ind + 7] <> 0
      152             then do:
      153               put stream PrnLibStream unformatted
      154                 ":" + fill("-", 25)
      155                 .
      156             end.
      157             else do:
      158               put stream PrnLibStream unformatted
      159                 fill(" ", 26)
      160                 .
      161             end.
      162           end.
      163           if (v-ind modulo 7 = 0
      164           and v-day-label[v-ind] <> 0
      165             )
      166           or (v-ind modulo 7 <> 0
      167           and v-day-label[v-ind] <> 0
      168           and v-ind + 1 <= 42
      169           and v-day-label[v-ind + 1] = 0
      170             )
      171           then do:
      172             put stream PrnLibStream unformatted
      173               ":"
      174               .
      175           end.
      176           if v-ind modulo 7 = 0
      177           then do:
      178             if  v-ind = 42
      179             and v-row = 7
      180             then do:
      181             end.
      182             else do:
      183               put stream PrnLibStream unformatted
      184                 chr(10) .
      185             end.
      186           end.
      187         end.
      188       end.
      189     end.
      190     output stream PrnLibStream close .
      191     define variable v-user-action as character no-undo .
      192     define variable v-printed     as logical   no-undo .
      193     run gbl/prnfilen.w
      194       (input  substitute("Календарь на &1 &2 года"
      195                         ,v-month-name
      196                         ,p-year
      197                         )
      198       ,input  8
      199       ,input  'prnmonth.txt':u
      200       ,input  7
      201       ,output v-user-action
      202       ,output v-printed
      203       ) .
      204   end.
