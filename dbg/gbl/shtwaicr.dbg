        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter p-obj-type as character no-undo .
        6   define input parameter p-obj-code as integer no-undo .
        7   define input parameter p-shift-date as date no-undo .
        8   define input parameter p-shift-num as integer no-undo .
        9   define input parameter p-shift-name as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: shtwaicr.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/shtwaicr.p $":U .
       15   define variable vss-description as character no-undo init "Создание ожидаемой смены".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable v-err-mess as character no-undo .
       86   define variable v-host-code as integer no-undo .
       87   define variable obj-db-num as integer no-undo .
       88   define buffer buf_shift-obj for ub.shift-obj.
       89   if p-mode <> 'ДОБАВЛЕНИЕ':U
       90   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       91     message vss-workfile vss-revision vss-description skip
       92             "Неверный параметр p-mode - " p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   main-block:
       97   do
       98   on error undo, return error
       99   :
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      102     (input  p-obj-type
      103     ,input  p-obj-code
      104     ,output v-host-code
      105     )  .
      106   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      108     (input  p-obj-type
      109     ,input  p-obj-code
      110     ,output obj-db-num
      111     )  .
      112     if g#db-num <> obj-db-num then do:
      113       v-err-mess = substitute("Ожидаемую смену можно создать/изменить только в БД объекта").
      114       run err-mess in this-procedure ( input-output v-err-mess) .
      115       undo main-block, return error (if p-silent then v-err-mess else '').
      116     end.
      117     if p-shift-date = ? then do:
      118       v-err-mess = substitute("Не задана дата ожидаемой смены").
      119       run err-mess in this-procedure ( input-output v-err-mess) .
      120       undo main-block, return error (if p-silent then v-err-mess else '').
      121     end.
      122     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      123       find first buf_shift-obj no-lock
      124         where buf_shift-obj.obj-type = p-obj-type
      125           and buf_shift-obj.obj-code = p-obj-code
      126           and buf_shift-obj.shift-date = p-shift-date
      127           and  buf_shift-obj.shift-num = p-shift-num
      128         no-error .
      129       if available buf_shift-obj then do:
      130         v-err-mess = substitute("Уже есть смена за дату: &1&2          порядок: &3"
      131                             ,string(p-shift-date, "99/99/9999")
      132                             ,chr(10)
      133                             ,p-shift-num).
      134         run err-mess in this-procedure ( input-output v-err-mess) .
      135         undo, return error (if p-silent then v-err-mess else '').
      136       end.
      137       create buf_shift-obj.
      138       assign
      139         buf_shift-obj.host-code  = v-host-code
      140         buf_shift-obj.obj-type   = p-obj-type
      141         buf_shift-obj.obj-code   = p-obj-code
      142         buf_shift-obj.shift-date = p-shift-date
      143         buf_shift-obj.shift-num  = p-shift-num
      144         buf_shift-obj.shift-name = p-shift-name
      145         buf_shift-obj.status_    = 'ожд':U
      146         buf_shift-obj.fact-order = 0
      147         p-rec = recid(buf_shift-obj)
      148       .
      149     end.
      150     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      151       find first buf_shift-obj exclusive-lock
      152         where recid(buf_shift-obj) = p-rec
      153       .
      154       if buf_shift-obj.obj-type <> p-obj-type
      155       or buf_shift-obj.obj-code <> p-obj-code
      156       or buf_shift-obj.shift-date <> p-shift-date
      157       or buf_shift-obj.shift-num <> p-shift-num
      158       then do:
      159          v-err-mess = "Для уже имеющейся смены нельзя менять дату смены и/или порядок смены".
      160           run err-mess in this-procedure ( input-output v-err-mess) .
      161           undo, return error (if p-silent then v-err-mess else '').
      162       end.
      163       if buf_shift-obj.status_ <> 'ожд':U then do:
      164          v-err-mess = "Можно изменить только ожидаемую смену".
      165           run err-mess in this-procedure ( input-output v-err-mess) .
      166           undo, return error (if p-silent then v-err-mess else '').
      167       end.
      168       assign
      169       buf_shift-obj.shift-name = p-shift-name
      170       .
      171     end.
      172     release buf_shift-obj no-error.
      173     if error-status:error then do:
      174       v-err-mess = substitute("Ошибка при сохранении :&1&2&1&3"
      175                               , chr(10)
      176                               , error-status:get-message(1)
      177                               , return-value ).
      178       run err-mess in this-procedure ( input-output v-err-mess) .
      179       undo main-block, return error (if p-silent then v-err-mess else '').
      180     end.
      181   end.
      182   PROCEDURE err-mess:
      183     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      184     CASE p-silent:
      185       when yes then do:
      186         assign
      187         p-mess = substitute("(Ожидамемая) Смена на объекте: &1&2 от &3 номер &4 порядок &5:&6&7"
      188                            , p-obj-type
      189                            , p-obj-code
      190                            , string(p-shift-date, "99/99/9999")
      191                            , p-shift-name
      192                            , p-shift-num
      193                            , chr(10)
      194                            , p-mess)
      195         .
      196       end.
      197       when no then do:
      198         message
      199         p-mess
      200         view-as alert-box error .
      201       end.
      202     end.
      203   END PROCEDURE.
