     4648   PROCEDURE choose-image :
     4649     define input  parameter p-private-data as character no-undo .
     4650     define buffer buf_temp-image for temp-image .
     4651     do
     4652     on error undo, return error return-value
     4653     :
     4654       find first buf_temp-image
     4655         where buf_temp-image.image-code = integer(p-private-data)
     4656         no-error .
     4657       if not available buf_temp-image
     4658       then do:
     4659         message
     4660           vss-workfile vss-revision vss-description skip
     4661           "Внутренняя ошибка" skip
     4662           "Не найдено описание изображения с кодом" p-private-data skip
     4663           view-as alert-box error .
     4664         undo, return error return-value .
     4665       end.
     4666       case entry(1, buf_temp-image.image-procedure, chr(44))
     4667       :
     4668         when 'int':U
     4669         then do:
     4670           run run-procedure-int in g#dm-menu-handle
     4671             (input entry(2, buf_temp-image.image-procedure, chr(44))
     4672             ) .
     4673         end.
     4674       end case.
     4675     end.
     4676   END PROCEDURE.
     4677   PROCEDURE choose-menu-item :
     4678     do
     4679     on error undo, return error return-value
     4680     :
     4681       if v-menu-item-choose = true
     4682       then do:
     4683         message
     4684           "Вы уже выбрали пункт меню" skip
     4685           view-as alert-box information .
     4686         undo, return error .
     4687       end.
     4688       assign
     4689         v-menu-item-choose = true
     4690       .
     4691     end.
     4692   END PROCEDURE.
     4693   PROCEDURE create-dm-menu :
     4694     if not valid-handle (g#dm-menu-handle)
     4695     then do:
     4696       run gbl/dm-menu.p persistent set g#dm-menu-handle
     4697         ( input  this-procedure
     4698         , input  menu-bar-handle
     4699         , input  v-cntxt-menu-code
     4700         , input  v-cntxt-menu-group-code
     4701         , output v-menu-control-number
     4702         ) no-error.
     4703       if error-status :error
     4704       then do:
     4705         message
     4706           "Ошибка вызова процедуры dm-menu.p" skip
     4707           error-status :get-message(1) skip
     4708           return-value skip
     4709           view-as alert-box error .
     4710         return error.
     4711       end.
     4712     end.
     4713   END PROCEDURE.
     4714   PROCEDURE delete-dm-menu :
     4715     if valid-handle (g#dm-menu-handle)
     4716     then do:
     4717       run clear-menu in g#dm-menu-handle no-error .
     4718       if error-status :error
     4719       then do:
     4720         message
     4721           "Ошибка при очистке меню" skip
     4722           error-status :get-message(1) skip
     4723           return-value skip
     4724           view-as alert-box error .
     4725         return error .
     4726       end.
     4727       delete procedure g#dm-menu-handle .
     4728       assign
     4729         g#dm-menu-handle = ?
     4730       .
     4731     end.
     4732   END PROCEDURE.
     4733   PROCEDURE delete-menu-item :
     4734     define input  parameter p-item-code as integer   no-undo .
     4735     define buffer buf_temp-menu-item for temp-menu-item .
     4736     do
     4737     on error undo, return error return-value
     4738     :
     4739       for each buf_temp-menu-item
     4740         where buf_temp-menu-item.parent-code = p-item-code
     4741       on error undo, return error return-value
     4742       :
     4743         if buf_temp-menu-item.item-type = 's-m':U
     4744         then do:
     4745           run delete-menu-item in this-procedure
     4746             (input buf_temp-menu-item.item-code
     4747             ) .
     4748         end.
     4749         delete buf_temp-menu-item .
     4750       end.
     4751     end.
     4752   END PROCEDURE.
     4753   PROCEDURE deselect-menu-item :
     4754     do
     4755     on error undo, return error return-value
     4756     :
     4757       assign
     4758         v-menu-item-choose = false
     4759       .
     4760     end.
     4761   END PROCEDURE.
     4762   PROCEDURE disable_UI :
     4763     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     4764     THEN DELETE WIDGET C-Win.
     4765     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4766   END PROCEDURE.
     4767   PROCEDURE disp-static :
     4768     define variable v-host-name like ub.clients.obj-name no-undo .
     4769     define variable v-curr-abbr like ub.currency.curr-abbr no-undo .
     4770     define variable v-retail like ub.sysconf.ord-prt no-undo .
     4771     define buffer buf_clients for ub.clients .
     4772     define buffer buf_menu-group for ub.menu-group .
     4773     do
     4774     on error undo, return error return-value
     4775     :
     4776       assign
     4777         fi-db-num             = string(v-cntxt-db-num)
     4778         fi-user-login         = '':U
     4779         fi-user-name          = '':U
     4780         fi-host               = '':U
     4781         fi-host-basecode-desc = '':U
     4782         fi-host-description   = '':U
     4783         fi-obj                = '':U
     4784         fi-obj-description    = '':U
     4785         t-obj-active          = ?
     4786         fi-menu-group-name    = '':U
     4787       .
     4788       define buffer buf_user-account for ub.user-account .
     4789       define buffer buf_user-login   for ub.user-login .
     4790       find first buf_user-account no-lock
     4791         where buf_user-account.user-id = v-cntxt-user-id
     4792         no-error .
     4793       if available buf_user-account
     4794       then do:
     4795         assign
     4796           fi-user-name = substitute('&1 &2 &3':U
     4797                                   ,buf_user-account.last-name
     4798                                   ,buf_user-account.first-name
     4799                                   ,buf_user-account.second-name
     4800                                   )
     4801         .
     4802       end.
     4803       find first buf_user-login no-lock
     4804         where buf_user-login.db-num  = v-cntxt-db-num
     4805           and buf_user-login.user-id = v-cntxt-user-id
     4806         no-error .
     4807       if available buf_user-login
     4808       then do:
     4809         assign
     4810           fi-user-login = buf_user-login.user-login
     4811           fi-nickname   = usrnickf(buf_user-login.user-id)
     4812         .
     4813       end.
     4814       find first buf_menu-group no-lock
     4815         where buf_menu-group.menu-code       = v-cntxt-menu-code
     4816           and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     4817         no-error .
     4818       if available buf_menu-group
     4819       then do:
     4820         assign
     4821           fi-menu-group-name = buf_menu-group.menu-group-name
     4822         .
     4823         run menu-item-display-full-name in this-procedure .
     4824       end.
     4825       if v-cntxt-level = 'firm':U
     4826       or v-cntxt-level = 'object':U
     4827       then do:
     4828         assign
     4829           fi-host = substitute('&1 &2':U
     4830                               ,'орг':U
     4831                               ,v-cntxt-host-code-obj
     4832                               )
     4833         .
     4834         find buf_clients no-lock
     4835           where buf_clients.obj-type = 'орг':U
     4836             and buf_clients.obj-code = v-cntxt-host-code-obj
     4837           no-error .
     4838         if available buf_clients
     4839         then do:
     4840           assign
     4841             fi-host-description = buf_clients.obj-name
     4842           .
     4843         end.
     4844         define variable v-base-code as integer   no-undo .
     4845   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4846   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4847     (input  v-cntxt-host-code-obj
     4848     ,output v-base-code
     4849     )  .
     4850         define buffer buf_currency for ub.currency .
     4851         find buf_currency no-lock
     4852           where buf_currency.curr-code = v-base-code
     4853           .
     4854         assign
     4855           fi-host-basecode-desc = buf_currency.curr-abbr
     4856         .
     4857       end.
     4858       if v-cntxt-level = 'object':U
     4859       then do:
     4860         assign
     4861           fi-obj  = substitute('&1 &2':U
     4862                               ,v-cntxt-obj-type
     4863                               ,v-cntxt-obj-code
     4864                               )
     4865         .
     4866         find buf_clients no-lock
     4867           where buf_clients.obj-type = v-cntxt-obj-type
     4868             and buf_clients.obj-code = v-cntxt-obj-code
     4869           no-error .
     4870         if available buf_clients
     4871         then do:
     4872           assign
     4873             fi-obj-description = buf_clients.obj-name
     4874           .
     4875         end.
     4876         define variable v-obj-active as logical   no-undo .
     4877   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4878   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4879     (input  v-cntxt-obj-type
     4880     ,input  v-cntxt-obj-code
     4881     ,input  'active=request':U
     4882     ,output v-obj-active
     4883     )  .
     4884         assign
     4885           t-obj-active = v-obj-active
     4886         .
     4887       end.
     4888       do with frame DEFAULT-FRAME
     4889       :
     4890         assign
     4891           fi-nickname:screen-value = fi-nickname
     4892           fi-user-login:screen-value = fi-user-login
     4893           fi-user-name:screen-value = fi-user-name
     4894           fi-nickname:visible = yes
     4895           fi-user-login:visible = yes
     4896           fi-user-name:visible = yes
     4897            .
     4898         if v-cntxt-level = 'global':U
     4899         then do:
     4900           assign
     4901             fi-host               :visible = no
     4902             fi-host-basecode-desc :visible = no
     4903             fi-obj                :visible = no
     4904             fi-obj-description    :visible = no
     4905             t-obj-active          :visible = no
     4906             fi-host-description            = "Без фирмы объекта."
     4907             fi-host-description   :screen-value = fi-host-description
     4908             fi-host-description   :visible = yes
     4909           .
     4910         end.
     4911         if v-cntxt-level = 'firm':U
     4912         then do:
     4913           assign
     4914             fi-host              :screen-value = fi-host
     4915             fi-host-basecode-desc:screen-value = fi-host-basecode-desc
     4916             fi-host-description  :screen-value = fi-host-description
     4917             fi-host              :visible      = yes
     4918             fi-host-basecode-desc:visible      = yes
     4919             fi-host-description  :visible      = yes
     4920             fi-obj               :visible      = no
     4921             fi-obj-description   :visible      = no
     4922             t-obj-active         :visible      = no
     4923            .
     4924         end.
     4925         if v-cntxt-level = 'object':U
     4926         then do:
     4927           assign
     4928             fi-host              :screen-value = fi-host
     4929             fi-host-basecode-desc:screen-value = fi-host-basecode-desc
     4930             fi-host-description  :screen-value = fi-host-description
     4931             fi-obj               :screen-value = fi-obj
     4932             fi-obj-description   :screen-value = fi-obj-description
     4933             t-obj-active         :screen-value = string(t-obj-active)
     4934             fi-host              :visible      = yes
     4935             fi-host-basecode-desc:visible      = yes
     4936             fi-host-description  :visible      = yes
     4937             fi-obj               :visible      = yes
     4938             fi-obj-description   :visible      = yes
     4939             t-obj-active         :visible      = yes
     4940              .
     4941         end.
     4942       end.
     4943       define variable v-arm-title as character no-undo .
     4944       run set-mainmenu-title in this-procedure
     4945         no-error .
     4946       if error-status :error
     4947       then do:
     4948         message
     4949           vss-workfile vss-revision vss-description skip
     4950           "Ошибка при изменении заголовка окна" skip
     4951           error-status :get-message(1) skip
     4952           return-value skip
     4953           view-as alert-box error .
     4954         return error.
     4955       end.
     4956     end.
     4957   END PROCEDURE.
