     6880     (input  'scpgpref':u
     6881     ,input  '':u
     6882     ,input  '':u
     6883     ,input  0
     6884     ,input  '':u
     6885     ,input  '':u
     6886     ,input  '':u
     6887     ,input  no
     6888     ,output varpgscales-pref
