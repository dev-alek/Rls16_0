      123   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      124   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      125   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      126   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      127   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      128   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      129   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      130   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      131   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
