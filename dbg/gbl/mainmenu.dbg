     1474          IMAGE-36:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1475   ASSIGN
     1476          IMAGE-37:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1477   ASSIGN
     1478          IMAGE-38:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1479   ASSIGN
     1480          IMAGE-39:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1481   ASSIGN
     1482          IMAGE-4:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1483   ASSIGN
     1484          IMAGE-5:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1485   ASSIGN
     1486          IMAGE-6:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1487   ASSIGN
     1488          IMAGE-7:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1489   ASSIGN
     1490          IMAGE-8:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1491   ASSIGN
     1492          IMAGE-9:HIDDEN IN FRAME DEFAULT-FRAME           = TRUE.
     1493   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     1494   THEN C-Win:HIDDEN = no.
     1495   ON END-ERROR OF C-Win
     1496   OR ENDKEY OF C-Win ANYWHERE DO:
     1497     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
     1498   END.
     1499   ON WINDOW-CLOSE OF C-Win
     1500   DO:
     1501     APPLY "CLOSE":U TO THIS-PROCEDURE.
     1502     RETURN NO-APPLY.
     1503   END.
     1504   ON CHOOSE OF b-copy IN FRAME DEFAULT-FRAME
     1505   DO:
     1506     run menu-item-copy-full-name in this-procedure .
     1507   END.
     1508   ON CHOOSE OF b-open-gds IN FRAME DEFAULT-FRAME
     1509   DO:
     1510     assign
     1511       fi-bar-code
     1512     .
     1513     run search-bar-code in this-procedure .
     1514   END.
     1515   ON CHOOSE OF b-search-bar-code IN FRAME DEFAULT-FRAME
     1516   DO:
     1517     define variable v-bar-code as character no-undo .
     1518     assign
     1519       fi-bar-code
     1520     .
     1521     run search-bar-code in this-procedure .
     1522     run str/bc-ab.p
     1523       (input  this-procedure :handle
     1524       ,input  v-cntxt-obj-type
     1525       ,input  v-cntxt-obj-code
     1526       ,input  fi-bar-code
     1527       ,output v-bar-code
     1528       ) no-error .
     1529     apply "entry" to fi-bar-code in frame DEFAULT-FRAME.
     1530     run search-bar-code in this-procedure .
     1531   END.
     1532   ON CHOOSE OF b-show-date IN FRAME DEFAULT-FRAME
     1533   DO:
     1534     define variable v-disp-date as date      no-undo .
     1535     define variable v-ok        as logical   no-undo .
     1536     assign
     1537       v-disp-date = date(fi-obj-date :screen-value)
     1538     .
     1539     run gbl/d-inpday.w
     1540       (input ?
     1541       ,input "Календарь"
     1542       ,input ""
     1543       ,input ""
     1544       ,input-output v-disp-date
     1545       ,output v-ok
     1546       ) .
     1547   END.
     1548   ON DEFAULT-ACTION OF br-menu-item IN FRAME DEFAULT-FRAME
     1549   DO:
     1550     run menu-item-choose in this-procedure .
     1551   END.
     1552   ON MOUSE-SELECT-CLICK OF br-menu-item IN FRAME DEFAULT-FRAME
     1553   DO:
     1554     if available temp-menu-item
     1555     then do:
     1556       if  temp-menu-item.item-type  = 's-m':U
     1557       then do:
     1558         run menu-item-choose in this-procedure .
     1559       end.
     1560     end.
     1561   END.
     1562   ON ROW-DISPLAY OF br-menu-item IN FRAME DEFAULT-FRAME
     1563   DO:
     1564     if available temp-menu-item then do:
     1565         assign
     1566           v-show-display-name :fgcolor in browse br-menu-item = black_color
     1567           v-show-display-name :bgcolor in browse br-menu-item = gray_color
     1568         .
     1569     end.
     1570   END.
     1571   ON VALUE-CHANGED OF br-menu-item IN FRAME DEFAULT-FRAME
     1572   DO:
     1573       define buffer buf_menu-group for ub.menu-group .
     1574       find first buf_menu-group no-lock
     1575         where buf_menu-group.menu-code       = v-cntxt-menu-code
     1576           and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     1577         no-error .
     1578       if available buf_menu-group
     1579       then do:
     1580         assign
     1581           fi-menu-group-name = buf_menu-group.menu-group-name
     1582         .
     1583       end.
     1584     run menu-item-display-full-name in this-procedure .
     1585   END.
     1586   ON RETURN OF fi-bar-code IN FRAME DEFAULT-FRAME
     1587   DO:
     1588     run search-bar-code in this-procedure .
     1589   END.
     1590   ON ANY-KEY OF fi-bar-code IN FRAME DEFAULT-FRAME
     1591   DO:
     1592     if lastkey = 308 then
     1593       return no-apply.
     1594   END.
     1595   ASSIGN CURRENT-WINDOW                = C-Win
     1596          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
     1597   assign
     1598      parparentproc = this-procedure
     1599   .
     1600   PROCEDURE SetCurrentDirectoryA EXTERNAL "kernel32.dll"
     1601   :
