      134   define new global shared variable g#libbcrcn as handle no-undo .
      135   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure cur-time :
      137      define output parameter p-today as date      no-undo .
      138      define output parameter p-time  as integer   no-undo .
      139     do
      140     on error undo, return error
      141     :
      142       define variable v-date1 as date      no-undo .
      143       define variable v-date2 as date      no-undo .
      144       define variable v-time  as integer   no-undo .
      145       assign
      146         v-date1 = today
      147         v-time  = time
      148         v-date2 = today
      149       .
      150       if v-date1 <> v-date2
      151       then do:
      152         assign
      153           v-date1 = today
      154           v-time  = v-time
      155         .
      156       end.
      157       assign
      158         p-today = v-date1
      159         p-time  = v-time
      160       .
      161     end.
      162   end.
      163   function cur-time-date returns character
      164   :
      165     return string(today, '99/99/9999':U) .
      166   end.
      167   function cur-time-mjd returns decimal
      168   :
      169     define variable v-date as date      no-undo .
      170     define variable v-time as integer   no-undo .
      171     run cur-time in this-procedure
      172       (output v-date
      173       ,output v-time
      174       ) .
      175     return integer(v-date) - 2400002 + (v-time / 86400) .
      176   end.
      177   function cur-time-get-ending-index returns integer
      178   (input p-number as integer
      179   )
      180   :
      181     if p-number < 0
      182     or p-number = ?
      183     then do:
      184       return 1 .
      185     end.
      186     define variable v-rest as integer   no-undo .
      187     assign
      188       p-number = p-number modulo 100
      189     .
      190     if p-number < 20
      191     then do:
      192       assign
      193         v-rest = p-number
      194       .
      195     end.
      196     else do:
      197       assign
      198         v-rest = p-number modulo 10
      199       .
      200     end.
      201     case v-rest :
      202       when 1
      203       then do:
      204         return 2 .
      205       end.
      206       when 2 or
      207       when 3 or
      208       when 4
      209       then do:
      210         return 3 .
      211       end.
      212       otherwise do:
      213         return 1 .
      214       end.
      215     end case .
      216   end.
      217   procedure cur-time-mjd-to-date :
      218      define input  parameter i-mjd-diff as decimal no-undo.
      219      define output parameter o-Date     as date    no-undo.
      220      define output parameter o-Time     as integer no-undo.
      221      define variable v-day-number as integer   no-undo .
      222      if    i-mjd-diff < 0
      223         or i-mjd-diff = ?
      224      then do:
      225         return "?" .
      226      end.
      227      assign
      228         v-day-number = truncate(i-mjd-diff,0).
      229         o-Date = date(v-day-number + 2400002).
      230         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232   end.
      233   function cur-time-mjd-to-string returns character
      234   (input p-mjd-diff as decimal
      235   )
      236   :
      237     define variable v-day-number as integer   no-undo .
      238     define variable v-seconds    as integer   no-undo .
      239     define variable v-hour       as integer   no-undo .
      240     define variable v-min        as integer   no-undo .
      241     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      242     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      243     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      244     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      245     if p-mjd-diff < 0
      246     or p-mjd-diff = ?
      247     then do:
      248       return "?" .
      249     end.
      250     assign
      251       v-day-number = integer(truncate(p-mjd-diff,0))
      252       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      253     .
      254     if v-seconds > 86400
      255     then do:
      256       assign
      257         v-seconds = 86400 - 1
      258       .
      259     end.
      260     if v-seconds < 0
      261     then do:
      262       assign
      263         v-seconds = 0
      264       .
      265     end.
      266     assign
      267       v-hour = truncate(v-seconds / 3600, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 3600
      271     .
      272     assign
      273       v-min = truncate(v-seconds / 60, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 60
      277     .
      278     return
      279         (if v-day-number <> 0
      280           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0
      284           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      288           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      289           else ""
      290         )
      291       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      292       .
      293   end.
      294   function cur-time-string returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-string-sec returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      313   end.
      314   function cur-time-custom  returns character
      315   (input p-prefix as character
      316   ,input p-date-format as character
      317   ,input p-delimiter as character
      318   ,input p-time-format as character
      319   ,input p-suffix as character
      320   )
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return
      329       p-prefix
      330       + string(v-date, p-date-format)
      331       + p-delimiter
      332       + string(v-time, p-time-format)
      333       + p-suffix
      334       .
      335   end.
      336   function cur-time-print  returns character
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      345   end.
      346   function cur-time-datetime returns datetime
      347   :
      348     define variable v-char as character no-undo .
      349     define variable v-datetime as datetime no-undo .
      350     v-char = cur-time-string().
      351     v-datetime = datetime(v-char).
      352     return  v-datetime.
      353   end.
      354   function cur-time-string-msec returns character
      355   :
      356     define variable v-date as datetime  no-undo .
      357     v-date = now.
      358     return string(v-date) .
      359   end.
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   DEFINE new SHARED TEMP-TABLE TT-tnved NO-UNDO
      362   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
      363   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
      364   INDEX tnved IS UNIQUE PRIMARY  tnved.
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      367   define  shared variable RepPathName        as character no-undo .
      368   define  shared variable PrintRubl          as logical   no-undo .
      369   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   define variable v-waitfram-action01         as character   no-undo .
      371   define variable v-waitfram-action02         as character   no-undo .
      372   define variable v-waitfram-action03         as character   no-undo .
      373   define variable mWaitFramTextBeg            as character   no-undo.
      374   define variable mWaitFramTextEnd            as character   no-undo.
      375   define variable mWaitFramView               as logical     no-undo.
      376   define variable mWaitProcEvent              as logical     no-undo init yes.
      377   define variable mWaitFramInterval           as integer     no-undo init 1 .
      378   define variable mWaitFramStop               as logical     no-undo.
      379   define variable mWaitFramStopUser           as logical     no-undo.
      380   define variable mWaitFramStopTimeOut        as logical     no-undo.
      381   define variable mWaitFramStartProc          as datetime-tz no-undo.
      382   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      383   define button B-WaitFramStop auto-end-key
      384        label "Стоп"
      385        size 10 by 1 tooltip "Остоновить процесс".
      386   define button B-viewProcInfo
      387        label "Информация"
      388        size 15 by 1 tooltip "Информация о процесс".
      389   define frame waitfram
      390     v-waitfram-action01 format "x(72)" no-label skip
      391     v-waitfram-action02 format "x(72)" no-label skip
      392     v-waitfram-action03 format "x(72)" no-label skip
      393     B-viewProcInfo
      394     B-WaitFramStop at row 4 col 30
      395     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      396     .
      397   define new global shared variable mBatchMode as logical no-undo init ?.
      398   define variable mFramBachModHandle as handle no-undo.
      399   mFramBachModHandle = frame waitfram:handle.
      400   define variable mFameOldVis as logical no-undo.
      401   define variable mVisCUrentVin as logical no-undo.
      402   if session:batch-mode
      403   then
      404      mBatchMode = yes.
      405   if mBatchMode = ? then do:
      406     mVisCUrentVin = current-window:visible.
      407     mFameOldVis = mFramBachModHandle:visible.
      408     mFramBachModHandle:visible  = yes.
      409     mBatchMode = mFramBachModHandle:visible ne yes.
      410     mFramBachModHandle:visible = mFameOldVis.
      411     current-window:visible = mVisCUrentVin.
      412   end.
      413    if  log-manager:logfile-name ne ?
      414     then DO:
      415         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      416         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      417         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      418     end.
      419   on choose of B-WaitFramStop in frame waitfram
      420   do:
      421     mWaitFramStop = yes.
      422     mWaitFramStopUser = yes.
      423   end.
      424   function waitfram-check-timeout returns logical():
      425      define variable vtime as int64 no-undo.
      426      if mWaitFramStopTimeOut
      427      then
      428         return yes.
      429      vtime = ( now - mWaitFramStartProc ) / 1000 .
      430      if     mWaitFramTimeOut ne ?
      431         and mWaitFramTimeOut ne 0
      432         and mWaitFramTimeOut lt vtime
      433      then do:
      434         mWaitFramStopTimeOut = yes.
      435      end.
      436      return mWaitFramStopTimeOut.
      437   end.
      438   procedure waitfram-hide :
      439     if not session:batch-mode
      440     then do
      441     on error undo, return error return-value
      442     :
      443       pause 0 before-hide .
      444       if not mBatchMode then
      445         hide frame waitfram .
      446     end.
      447   end procedure.
      448   procedure waitfram-show :
      449     define input  parameter p-message as character no-undo .
      450     define variable v-left-margin as integer   no-undo .
      451     if not session:batch-mode
      452     then do
      453     on error undo, return error return-value
      454     :
      455       if length(p-message) <= 70 then do:
      456         assign
      457           v-left-margin = integer((70 - length(p-message)) / 2)
      458         .
      459         assign
      460           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      461         .
      462         assign
      463           v-waitfram-action01 = " "
      464           v-waitfram-action02 = " "
      465                                    + fill(" ", v-left-margin)
      466                                    + p-message
      467           v-waitfram-action03 = " "
      468         .
      469       end.
      470       else do:
      471         define variable vRindex1 as integer no-undo.
      472         define variable vRindex2 as integer no-undo.
      473         vRindex1 = r-index(p-message," ",70).
      474         if vRindex1 = 0
      475         then
      476            vRindex1 = 70.
      477         if length(p-message)  <= vRindex1 + 70 then do:
      478           assign
      479             v-waitfram-action01 = " "
      480             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      481             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      482           .
      483         end.
      484         else do:
      485           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      486           if vRindex2 <= vRindex1
      487           then
      488              vRindex2 = vRindex1 + 70.
      489           assign
      490             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      491             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      493           .
      494         end.
      495       end.
      496       B-viewProcInfo:visible   in frame waitfram = no.
      497       B-viewProcInfo:sensitive in frame waitfram = no.
      498       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      499       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      500       if  (   mWaitFramView
      501          or  mWaitProcEvent)
      502          and not mBatchMode
      503       then
      504          display
      505             v-waitfram-action01 skip
      506             v-waitfram-action02 skip
      507             v-waitfram-action03 skip
      508          with frame waitfram .
      509     end.
      510   end procedure.
      511      procedure waitfram-show-this:
      512         define input  parameter iInterval as int64 no-undo.
      513         define variable vtime as int64 no-undo.
      514         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      515         mWaitFramInterval = iInterval.
      516         run waitfram-show (substitute("&1&2 &3&4" ,
      517                                       mWaitFramTextBeg ,
      518                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      519                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      520                                       mWaitFramTextEnd
      521                                      )
      522                           ).
      523      end.
      524      procedure WaitFramRunPause:
      525         define input  parameter iInterval as dec no-undo.
      526         define variable vStart  as datetime-tz no-undo.
      527         define variable vend    as datetime-tz no-undo.
      528         define variable vint as int64 no-undo.
      529         define variable vOk as logical no-undo.
      530         vStart = now.
      531         vend   = vStart.
      532         publish "WaitFramPause" (iInterval,output vOk).
      533         vend   =  now.
      534         vint = vend - vStart.
      535         vint = iInterval - vint / 1000.
      536         if     not mWaitFramStop
      537            and (   vint > 0
      538                 or (    not vOk
      539                     and iInterval eq ?
      540                     )
      541                 )
      542         then
      543            run waitfram-show-this (iInterval).
      544         vend   =  now.
      545         vint = vend - vStart.
      546         vint = iInterval - vint / 1000.
      547         if     not mWaitFramStop
      548            and vint > 0
      549         then do:
      550            run gbl/pause.p (vint * 1000).
      551         end.
      552         if iInterval ne ?
      553         then
      554            publish "WaitFramStop".
      555         waitfram-check-timeout().
      556      end.
      557      procedure WaitFramWaitFor:
      558         define input  parameter iInterval as dec no-undo.
      559         assign
      560            mWaitFramStartProc   = now
      561            mWaitFramStopUser    = no
      562            mWaitFramStopTimeOut = no
      563         .
      564         block-wait:
      565         do while not mWaitFramStop:
      566            run WaitFramRunPause (iInterval).
      567            if  waitfram-check-timeout()
      568            then do:
      569               leave block-wait.
      570            end.
      571         end.
      572         run waitfram-hide.
      573      end.
      574   procedure waitfram-join :
      575     define input  parameter p-line-1  as character no-undo .
      576     define input  parameter p-line-2  as character no-undo .
      577     define input  parameter p-line-3  as character no-undo .
      578     define output parameter p-message as character no-undo .
      579     do
      580     on error undo, return error return-value
      581     :
      582       assign
      583         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      584                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      585                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      586       .
      587     end.
      588   end procedure.
      589   function waitfram-join-function returns character
      590     (input p-line-1 as character
      591     ,input p-line-2 as character
      592     ,input p-line-3 as character
      593     ).
      594     define variable v-message as character no-undo .
      595     run waitfram-join in this-procedure
      596       (input  p-line-1
      597       ,input  p-line-2
      598       ,input  p-line-3
      599       ,output v-message
      600       ) .
      601     return v-message .
      602   end function .
