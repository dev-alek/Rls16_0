      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      118   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      119   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      120   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      121   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
