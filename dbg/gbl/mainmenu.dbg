      857   procedure placelib_write-attr:
      858   define input  parameter p-code     like ub.place-attr.attr-code .
      859   define input  parameter p-obj-code like ub.place-attr.obj-code .
      860   define input  parameter p-obj-type like ub.place-attr.obj-type .
      861   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      862   define input  parameter p-value    like ub.place-attr.attr-value .
      863   define output parameter p-ok       as logical.
      864   define buffer buf_place-attr for ub.place-attr .
      865     do on error undo, return error return-value :
      866        p-ok = false.
      867        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      868                                                   and buf_place-attr.obj-code    = p-obj-code
      869                                                   and buf_place-attr.obj-type    = p-obj-type
      870                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      871        if not available buf_place-attr then do :
      872           create buf_place-attr.
      873           assign
      874             buf_place-attr.attr-code   = p-code
      875             buf_place-attr.attr-value  = p-value
      876             buf_place-attr.obj-code    = p-obj-code
      877             buf_place-attr.obj-type    = p-obj-type
      878             buf_place-attr.pl-code     = p-pl-code
      879           .
      880           p-ok = true.
      881        end.
      882        else do:
      883           buf_place-attr.attr-value  = p-value .
      884           p-ok = true.
      885        end.
      886     end.
      887   end.
      888   procedure placelib_get-attr:
      889   define input  parameter  p-code     like ub.place-attr.attr-code .
      890   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      891   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      892   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      893   define output parameter  p-value    like ub.place-attr.attr-value .
      894   define output parameter  p-ok       as logical.
      895   define buffer buf_place-attr for ub.place-attr .
      896     do on error undo, return error return-value :
      897        p-ok = false.
      898        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      899                                                   and buf_place-attr.obj-code    = p-obj-code
      900                                                   and buf_place-attr.obj-type    = p-obj-type
      901                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      902        if available buf_place-attr then do :
      903          p-value = buf_place-attr.attr-value.
      904          p-ok = true.
      905        end.
      906        else do :
      907          p-ok = false.
      908        end.
      909     end.
      910   end.
      911   procedure placelib_del-attr:
      912   define input parameter  p-code     like ub.place-attr.attr-code .
      913   define input parameter  p-obj-code like ub.place-attr.obj-code .
      914   define input parameter  p-obj-type like ub.place-attr.obj-type .
      915   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      916   define input parameter  p-value    like ub.place-attr.attr-value .
      917   define output parameter p-ok       as logical.
      918   define buffer buf_place-attr for ub.place-attr .
      919     do on error undo, return error return-value :
      920        p-ok = false.
      921        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      922                                                   and buf_place-attr.obj-code    = p-obj-code
      923                                                   and buf_place-attr.obj-type    = p-obj-type
      924                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      925        if available buf_place-attr then do :
      926           delete buf_place-attr.
      927           p-ok = true.
      928        end.
      929     end.
      930   end.
      931   function is-gas returns logical
      932           (input p-gds-code as integer):
      933   define variable result as logical no-undo.
      934   define variable c-value as character no-undo.
      935   define variable c-type as character no-undo.
      936   do on error undo, return error:
      937           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      938         (input  p-gds-code
      939         ,input  'fuel-type':U
      940         ,output c-value
      941         ,output c-type) no-error.
      942   end.
      943   result = logical(c-value = 'metan':U) no-error.
      944   return result.
      945   end function.
