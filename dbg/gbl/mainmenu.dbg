     6950   PROCEDURE select-context :
     6951     define input  parameter p-cntxt-valid as logical   no-undo .
     6952     define output parameter p-user-select as logical   no-undo .
     6953     define variable v-select-cntxt-menu-code       as integer   no-undo .
     6954     define variable v-select-cntxt-menu-group-code as integer   no-undo .
     6955     define variable v-select-cntxt-level           as character no-undo .
     6956     define variable v-select-cntxt-host-code-obj   as integer   no-undo .
     6957     define variable v-select-cntxt-obj-type        as character no-undo .
     6958     define variable v-select-cntxt-obj-code        as integer   no-undo .
     6959     define variable v-select-cntxt-db-num-obj      as integer   no-undo .
     6960     define variable v-select-cntxt-valid           as logical   no-undo .
     6961     do
     6962     on error undo, return error return-value
     6963     :
     6964       assign
     6965         p-user-select = false
     6966       .
     6967       if p-cntxt-valid = true
     6968       then do:
     6969         assign
     6970           v-select-cntxt-menu-code       = v-cntxt-menu-code
     6971           v-select-cntxt-menu-group-code = v-cntxt-menu-group-code
     6972           v-select-cntxt-level           = v-cntxt-level
     6973           v-select-cntxt-host-code-obj   = v-cntxt-host-code-obj
     6974           v-select-cntxt-obj-type        = v-cntxt-obj-type
     6975           v-select-cntxt-obj-code        = v-cntxt-obj-code
     6976         .
     6977       end.
     6978       else do:
     6979         assign
     6980           v-select-cntxt-menu-code       = 0
     6981           v-select-cntxt-menu-group-code = 0
     6982           v-select-cntxt-level           = 'global':U
     6983           v-select-cntxt-host-code-obj   = 0
     6984           v-select-cntxt-obj-type        = '':U
     6985           v-select-cntxt-obj-code        = 0
     6986         .
     6987       end.
     6988       assign
     6989         v-select-cntxt-valid = false
     6990       .
     6991       _loop-select:
     6992       do while v-select-cntxt-valid = false
     6993       on error undo, return error return-value
     6994       :
     6995         run gbl/cntxtsel.w
     6996           (input  this-procedure :handle
     6997           ,input  v-cntxt-db-num
     6998           ,input  0
     6999           ,input  v-cntxt-user-id
     7000           ,input  v-select-cntxt-menu-code
     7001           ,input  v-select-cntxt-menu-group-code
     7002           ,input  v-select-cntxt-level
     7003           ,input  v-select-cntxt-host-code-obj
     7004           ,input  v-select-cntxt-obj-type
     7005           ,input  v-select-cntxt-obj-code
     7006           ,output v-select-cntxt-menu-code
     7007           ,output v-select-cntxt-menu-group-code
     7008           ,output v-select-cntxt-level
     7009           ,output v-select-cntxt-host-code-obj
     7010           ,output v-select-cntxt-obj-type
     7011           ,output v-select-cntxt-obj-code
     7012           ,output v-user-select
     7013           ) .
     7014         if v-user-select <> true
     7015         then do:
     7016           assign
     7017             p-user-select = false
     7018           .
     7019           return .
     7020         end.
     7021         define variable v-chk-usr-numa as logical   no-undo .
     7022         define variable v-work-usr-num as integer   no-undo .
     7023         define buffer bf_menu-group     for ub.menu-group .
     7024         run chk-usr-numa in this-procedure
     7025            (output v-chk-usr-numa
     7026            ) .
     7027         if v-chk-usr-numa = true
     7028         then do:
     7029            FIND FIRST bf_menu-group
     7030               WHERE bf_menu-group.menu-code        = v-select-cntxt-menu-code
     7031                  AND bf_menu-group.menu-group-code  = v-select-cntxt-menu-group-code
     7032               NO-LOCK
     7033               no-error
     7034               .
     7035           if not available bf_menu-group
     7036           then do:
     7037           message
     7038               vss-workfile vss-revision vss-description skip
     7039               "Неизвестный код группы пунктов меню" skip
     7040               "Код меню" v-select-cntxt-menu-code skip
     7041               "Код группы пунктов меню" v-select-cntxt-menu-group-code skip
     7042               view-as alert-box error .
     7043               undo _loop-select, return error return-value .
     7044           end.
     7045   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7046     (input  bf_menu-group.menu-group-licence-param
     7047     ,input  0
     7048     ,input  '':U
     7049     ,input  0
     7050     ,input  '':U
     7051     ,input  '':U
     7052     ,input  '':U
     7053     ,input  yes
     7054     ,output v-param-value
     7055     ,output v-param-type
     7056     ) no-error .
     7057            if error-status :error
     7058            then do:
     7059            message
     7060               vss-workfile vss-revision vss-description skip
     7061               "Ошибка чтения конфигурационного параметра" bf_menu-group.menu-group-licence-param skip
     7062               error-status :get-message(1) skip
     7063               return-value skip
     7064               view-as alert-box error .
     7065            undo, return error return-value .
     7066            end.
     7067            run adm/isanybdy.p
     7068                  (input  true
     7069                  ,input  bf_menu-group.menu-code
     7070                  ,input  bf_menu-group.menu-group-id
     7071                  ,output v-work-usr-num
     7072                  ).
     7073            if v-work-usr-num >= integer(v-param-value)
     7074            then do:
     7075                  message
     7076                     "Превышено максимальное количество пользователей, работающих в группе меню" bf_menu-group.menu-group-description skip
     7077                     "Количество лицензий" integer(v-param-value) skip
     7078                     "Работает пользователей" v-work-usr-num skip
     7079                     return-value skip
     7080                  view-as alert-box error .
     7081                  UNDO _loop-select, RETRY _loop-select.
     7082            end.
     7083         END.
     7084         if v-select-cntxt-level = 'object':U
     7085         then do:
     7086   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     7088     (input  v-select-cntxt-obj-type
     7089     ,input  v-select-cntxt-obj-code
     7090     ,output v-select-cntxt-db-num-obj
     7091     )  .
     7092         end.
     7093         else do:
     7094           assign
     7095             v-select-cntxt-db-num-obj = ?
     7096           .
     7097         end.
     7098         run gbl/cntxtchk.p
     7099           (input  v-cntxt-db-num
     7100           ,input  v-cntxt-user-id
     7101           ,input  v-select-cntxt-menu-code
     7102           ,input  v-select-cntxt-menu-group-code
     7103           ,input  v-select-cntxt-level
     7104           ,input  v-select-cntxt-host-code-obj
     7105           ,input  v-select-cntxt-obj-type
     7106           ,input  v-select-cntxt-obj-code
     7107           ,input  v-select-cntxt-db-num-obj
     7108           ,output v-select-cntxt-valid
     7109           ,output v-cntxt-error-message
     7110           ) no-error .
     7111         if error-status :error
     7112         then do:
     7113           message
     7114             vss-workfile vss-revision vss-description skip
     7115             "Ошибка при проверке контекста" skip
     7116             error-status :get-message(1) skip
     7117             return-value skip
     7118             view-as alert-box error .
     7119           undo, return error return-value .
     7120         end.
     7121         if v-select-cntxt-valid = false
     7122         then do:
     7123           message
     7124             v-cntxt-error-message skip
     7125             "" skip
     7126             "Необходимо выбрать текущую Группу меню, Фирму, Объект" skip
     7127             view-as alert-box information .
     7128         end.
     7129       end.
     7130       assign
     7131         p-user-select = true
     7132       .
     7133       assign
     7134         v-cntxt-menu-code       = v-select-cntxt-menu-code
     7135         v-cntxt-menu-group-code = v-select-cntxt-menu-group-code
     7136         v-cntxt-level           = v-select-cntxt-level
     7137         v-cntxt-host-code-obj   = v-select-cntxt-host-code-obj
     7138         v-cntxt-obj-type        = v-select-cntxt-obj-type
     7139         v-cntxt-obj-code        = v-select-cntxt-obj-code
     7140         v-cntxt-db-num-obj      = v-select-cntxt-db-num-obj
     7141       .
     7142       run gbl/cntxtstr.p
     7143         (input  v-cntxt-db-num
     7144         ,input  v-cntxt-user-id
     7145         ,input  v-cntxt-menu-code
     7146         ,input  v-cntxt-menu-group-code
     7147         ,input  v-cntxt-level
     7148         ,input  v-cntxt-host-code-obj
     7149         ,input  v-cntxt-obj-type
     7150         ,input  v-cntxt-obj-code
     7151         ) .
     7152     end.
     7153   END PROCEDURE.
     7154   PROCEDURE select-menu-group :
     7155     define input  parameter p-menu-group-code as integer   no-undo .
     7156     define buffer buf_menu-group for ub.menu-group .
     7157     define variable v-new-menu-group-id      as character no-undo .
     7158     define variable v-previous-menu-group-id as character no-undo .
     7159     define variable v-cur-date-error-code    as integer      no-undo.
     7160     do
     7161     on error undo, return error return-value
     7162     :
     7163       assign
     7164           v-cur-date-error-code = 1
     7165       .
     7166       choose-item:
     7167       do while v-cur-date-error-code = 1
     7168       on error undo, return error
     7169       :
     7170           find first buf_menu-group no-lock
     7171           where buf_menu-group.menu-code       = v-cntxt-menu-code
     7172               and buf_menu-group.menu-group-code = p-menu-group-code
     7173           no-error .
     7174           if not available buf_menu-group
     7175           then do:
     7176           message
     7177               vss-workfile vss-revision vss-description skip
     7178               "Неизвестный код группы пунктов меню" skip
     7179               "Код меню" v-cntxt-menu-code skip
     7180               "Код группы пунктов меню" p-menu-group-code skip
     7181               view-as alert-box error .
     7182               undo choose-item, return error return-value .
     7183           end.
     7184           assign
     7185           v-new-menu-group-id = buf_menu-group.menu-group-id
     7186           .
     7187           define variable v-chk-usr-numa as logical   no-undo .
     7188           define variable v-work-usr-num as integer   no-undo .
     7189           define buffer bf_menu-group     for ub.menu-group .
     7190           run chk-usr-numa in this-procedure
     7191              (output v-chk-usr-numa
     7192              ) .
     7193           if v-chk-usr-numa = true
     7194           then do:
     7195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7196     (input  buf_menu-group.menu-group-licence-param
     7197     ,input  0
     7198     ,input  '':U
     7199     ,input  0
     7200     ,input  '':U
     7201     ,input  '':U
     7202     ,input  '':U
     7203     ,input  yes
     7204     ,output v-param-value
     7205     ,output v-param-type
     7206     ) no-error .
     7207               if error-status :error
     7208               then do:
     7209               message
     7210                  vss-workfile vss-revision vss-description skip
     7211                  "Ошибка чтения конфигурационного параметра" buf_menu-group.menu-group-licence-param skip
     7212                  error-status :get-message(1) skip
     7213                  return-value skip
     7214                  view-as alert-box error .
     7215               undo, return error return-value .
     7216               end.
     7217               run adm/isanybdy.p
     7218                     (input  true
     7219                     ,input  buf_menu-group.menu-code
     7220                     ,input  buf_menu-group.menu-group-id
     7221                     ,output v-work-usr-num
     7222                     ).
     7223               if v-work-usr-num >= integer(v-param-value)
     7224               then do:
     7225                     message
     7226                        "Превышено максимальное количество пользователей, работающих в группе меню" buf_menu-group.menu-group-description skip
     7227                        "Количество лицензий" integer(v-param-value) skip
     7228                        "Работает пользователей" v-work-usr-num skip
     7229                        return-value skip
     7230                     view-as alert-box error .
     7231                     undo choose-item, return .
     7232               end.
     7233           END.
     7234           find first buf_menu-group no-lock
     7235           where buf_menu-group.menu-code       = v-cntxt-menu-code
     7236               and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     7237           no-error .
     7238           if available buf_menu-group
     7239           then do:
     7240               assign
     7241                   v-cntxt-previous-menu-group-id = buf_menu-group.menu-group-id
     7242               .
     7243           end.
     7244           else do:
     7245               assign
     7246                   v-cntxt-previous-menu-group-id = '':U
     7247               .
     7248           end.
     7249           find first buf_menu-group no-lock
     7250           where buf_menu-group.menu-code     = v-cntxt-menu-code
     7251               and buf_menu-group.menu-group-id = v-new-menu-group-id
     7252           no-error .
     7253           if not available buf_menu-group
     7254           then do:
     7255               message
     7256                   vss-workfile vss-revision vss-description skip
     7257                   "Неизвестный код группы пунктов меню" skip
     7258                   "Код меню" v-cntxt-menu-code skip
     7259                   "Идентификатор группы пунктов меню" v-new-menu-group-id skip
     7260               view-as alert-box error .
     7261               undo choose-item, return error return-value .
     7262           end.
     7263           assign
     7264               v-cntxt-menu-group-code = buf_menu-group.menu-group-code
     7265           .
     7266           run delete-dm-menu in this-procedure
     7267           no-error .
     7268           if error-status :error
     7269           then do:
     7270               message
     7271                   vss-workfile vss-revision vss-description skip
     7272                   "Ошибка при удалении меню" skip
     7273                   error-status :get-message(1) skip
     7274                   return-value skip
     7275               view-as alert-box error .
     7276               undo choose-item, return error return-value .
     7277           end.
     7278           run create-dm-menu in this-procedure
     7279           no-error .
     7280           if error-status :error
     7281           then do:
     7282               message
     7283                   vss-workfile vss-revision vss-description skip
     7284                   "Ошибка при создании меню" skip
     7285                   error-status :get-message(1) skip
     7286                   return-value skip
     7287               view-as alert-box error .
     7288               undo choose-item, return error return-value .
     7289           end.
     7290           do with frame DEFAULT-FRAME
     7291           :
     7292               assign
     7293                   fi-menu-group-name = buf_menu-group.menu-group-name
     7294               .
     7295           end.
     7296           APPLY "value-changed" TO br-menu-item.
     7297           run disp-static in this-procedure
     7298           no-error .
     7299           if error-status :error
     7300           then do:
     7301               message
     7302                   vss-workfile vss-revision vss-description skip
     7303                   "Ошибка при вызове процедуры disp-static" skip
     7304                   error-status :get-message(1) skip
     7305                   return-value skip
     7306               view-as alert-box error .
     7307               undo choose-item, return error return-value .
     7308           end.
     7309           run mainmenu-disp-mutable in this-procedure (
     7310               output v-cur-date-error-code
     7311           )  no-error.
     7312           if error-status :error
     7313           then do:
     7314               message
     7315                   vss-workfile vss-revision vss-description skip
     7316                   "Ошибка при вызове процедуры mainmenu-disp-mutable" skip
     7317                   error-status :get-message(1) skip
     7318                   return-value skip
     7319               view-as alert-box error .
     7320               undo choose-item, return error .
     7321           end.
     7322           run gbl/cntxtstr.p
     7323            ( input  v-cntxt-db-num
     7324            , input  v-cntxt-user-id
     7325            , input  v-cntxt-menu-code
     7326            , input  v-cntxt-menu-group-code
     7327            , input  v-cntxt-level
     7328            , input  v-cntxt-host-code-obj
     7329            , input  v-cntxt-obj-type
     7330            , input  v-cntxt-obj-code
     7331            ) .
     7332       end.
     7333   end.
     7334   END PROCEDURE.
     7335   PROCEDURE select-previous-menu-group-id :
     7336     define buffer buf_menu-group for ub.menu-group .
     7337     do
     7338     on error undo, return error return-value
     7339     :
     7340       if v-cntxt-previous-menu-group-id <> ""
     7341       and v-cntxt-previous-menu-group-id <> ?
     7342       THEN DO:
     7343         find first buf_menu-group no-lock
     7344            where buf_menu-group.menu-code = v-cntxt-menu-code
     7345            and buf_menu-group.menu-group-id = v-cntxt-previous-menu-group-id
     7346            no-error .
     7347       END.
     7348       else do:
     7349         find first buf_menu-group no-lock
     7350            where buf_menu-group.menu-code = v-cntxt-menu-code
     7351            and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     7352            no-error .
     7353       end.
     7354       if not available buf_menu-group
     7355       then do:
     7356         message
     7357           vss-workfile vss-revision vss-description skip
     7358           "Не найдена группа пунктов меню" skip
     7359           view-as alert-box error .
     7360         undo, return error return-value .
     7361       end.
     7362       run select-menu-group in this-procedure
     7363         (input buf_menu-group.menu-group-code
     7364         ) .
     7365     end.
     7366   END PROCEDURE.
