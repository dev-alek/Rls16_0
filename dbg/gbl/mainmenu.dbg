     5356   PROCEDURE image-display-ord-do :
     5357     do
     5358     on error undo, return error return-value
     5359     :
     5360       define variable l-exist-ord-do as logical no-undo .
     5361       assign
     5362       l-exist-ord-do   = false .
     5363    if   can-find (first ub.ord-doc no-lock  where ub.ord-doc.cycle-day > 0
     5364           and ub.ord-doc.host-code = v-cntxt-host-code-obj
     5365           and (integer(today - ub.ord-doc.doc-date) >= ub.ord-doc.cycle-day)
     5366           and ub.ord-doc.order-type = 1
     5367           and ub.ord-doc.status_ <> 'новый':U
     5368           )
     5369            or
     5370          can-find ( first ub.ord-doc no-lock  where
     5371              ub.ord-doc.host-code = v-cntxt-host-code-obj
     5372           and ub.ord-doc.order-type = 4
     5373           and ub.ord-doc.status_ <> 'новый':U
     5374            )
     5375           then do:
     5376            l-exist-ord-do = true .
     5377           end.
     5378       assign
     5379         l-exist-ord-do =   can-find (first ub.ord-doc where ub.ord-doc.cycle-day > 0
     5380                             and ub.ord-doc.host-code = v-cntxt-host-code-obj
     5381                             and (integer(today - ub.ord-doc.doc-date) >= ub.ord-doc.cycle-day)
     5382                             and ub.ord-doc.order-type = 1
     5383                             and ub.ord-doc.status_ <> 'новый':U
     5384                             no-lock)
     5385       .
     5386       run image-display-update-visible in this-procedure
     5387         (input l-exist-ord-do
     5388         ,input 'ord-do':U
     5389         ) .
     5390     end.
     5391   END PROCEDURE.
