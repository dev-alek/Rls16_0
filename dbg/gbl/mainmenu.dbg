      627   procedure godendo-date-to-offset :
      628     define input  parameter p-today  as date      no-undo .
      629     define input  parameter p-date   as date      no-undo .
      630     define output parameter p-offset as integer   no-undo .
      631     do
      632     on error undo, return error return-value
      633     :
      634       if p-date  = ?
      635       or p-today = ?
      636       then do:
      637         assign
      638           p-offset = ?
      639         .
      640       end.
      641       else do:
      642         assign
      643           p-offset = p-date - p-today + 1
      644         .
      645       end.
      646     end.
      647   end procedure.
      648   procedure godendo-offset-to-date :
      649     define input  parameter p-today  as date      no-undo .
      650     define input  parameter p-offset as integer   no-undo .
      651     define output parameter p-date   as date      no-undo .
      652     do
      653     on error undo, return error return-value
      654     :
      655       if p-today  = ?
      656       or p-offset = ?
      657       then do:
      658         assign
      659           p-date = ?
      660         .
      661       end.
      662       else do:
      663         assign
      664           p-date = p-offset + p-today - 1
      665         .
      666       end.
      667     end.
      668   end procedure.
      669   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   define variable v-uh9 as handle no-undo .
      671   define variable v-found9 as logical no-undo .
      672   v-uh9 = session:first-procedure no-error.
      673   do while valid-handle(v-uh9):
      674     if v-uh9:type = "PROCEDURE" then do:
      675       if v-uh9:file-name = "gbl/mainproc.p" then do:
      676         v-found9 = yes.
      677         leave.
      678       end.
      679     end.
      680     v-uh9 = v-uh9:next-sibling no-error.
      681   end.
      682   if not v-found9 then do:
      683     run gbl/mainproc.p persistent.
      684   end.
