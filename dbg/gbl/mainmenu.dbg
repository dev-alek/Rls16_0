     3260         run chk-usr-numa in this-procedure
     3261            (output v-chk-usr-numa
     3262            ) .
     3263         if v-chk-usr-numa = true
     3264         then do:
     3265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3266     (input  buf_menu-group.menu-group-licence-param
     3267     ,input  0
     3268     ,input  '':U
     3269     ,input  0
     3270     ,input  '':U
     3271     ,input  '':U
     3272     ,input  '':U
     3273     ,input  yes
     3274     ,output v-param-value
     3275     ,output v-param-type
     3276     ) no-error .
     3277               if error-status :error
     3278               then do:
     3279               message
     3280                  vss-workfile vss-revision vss-description skip
     3281                  "Ошибка чтения конфигурационного параметра" buf_menu-group.menu-group-licence-param skip
     3282                  error-status :get-message(1) skip
     3283                  return-value skip
     3284                  view-as alert-box error .
     3285               undo, return error return-value .
     3286               end.
     3287               run adm/isanybdy.p
     3288               (input  true
     3289               ,input  buf_menu-group.menu-code
     3290               ,input  buf_menu-group.menu-group-id
     3291               ,output v-work-usr-num
     3292               ).
     3293               if v-work-usr-num >= integer(v-param-value)
     3294               then do:
     3295                  message
     3296                  "Превышено максимальное количество пользователей, работающих в группе меню" buf_menu-group.menu-group-description skip
     3297                  "Количество лицензий" integer(v-param-value) skip
     3298                  "Работает пользователей" v-work-usr-num skip
     3299                  return-value skip
     3300                  view-as alert-box error .
     3301                  assign
     3302                     v-cntxt-valid = false
     3303                  .
     3304                  UNDO user-number, retry user-number.
     3305               end.
     3306         END.
     3307     END.
     3308     run create-dm-menu in this-procedure
     3309       no-error .
     3310     if error-status :error
     3311     then do:
     3312       message
     3313         vss-workfile vss-revision vss-description skip
     3314         "Ошибка при создании меню" skip
     3315         error-status :get-message(1) skip
     3316         return-value skip
     3317         view-as alert-box error .
     3318       undo, return error return-value .
     3319     end.
     3320     run logo in this-procedure .
