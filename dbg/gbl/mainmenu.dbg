     7397   PROCEDURE set-mainmenu-title :
     7398     define buffer buf_clients for ub.clients .
     7399     define variable v-version-name     as character no-undo .
     7400     define variable v-version-name-str as character no-undo .
     7401     define variable v-host-str         as character no-undo .
     7402     define variable v-obj-str          as character no-undo .
     7403     define variable v-user-str         as character no-undo .
     7404     define variable v-db-num-str       as character no-undo .
     7405     define variable v-user-id-str      as character no-undo .
     7406     define variable v-process-id-str   as character no-undo .
     7407     do
     7408     on error undo, return error return-value
     7409     :
     7410       assign
     7411         v-host-str = '':U
     7412         v-obj-str  = '':U
     7413       .
     7414       case v-cntxt-level
     7415       :
     7416         when 'global':U
     7417         then do:
     7418         end.
     7419         when 'firm':U
     7420         then do:
     7421           find first buf_clients no-lock
     7422             where buf_clients.obj-type = 'орг':U
     7423               and buf_clients.obj-code = v-cntxt-host-code-obj
     7424             no-error .
     7425           if available buf_clients
     7426           then do:
     7427             assign
     7428               v-host-str = substitute("Фирма: &1 &2"
     7429                                       ,buf_clients.obj-type
     7430                                       ,buf_clients.obj-code
     7431                                       )
     7432             .
     7433           end.
     7434         end.
     7435         when 'object':U
     7436         then do:
     7437           find first buf_clients no-lock
     7438             where buf_clients.obj-type = 'орг':U
     7439               and buf_clients.obj-code = v-cntxt-host-code-obj
     7440             no-error .
     7441           if available buf_clients
     7442           then do:
     7443             assign
     7444               v-host-str = substitute("Фирма: &1 &2"
     7445                                       ,buf_clients.obj-type
     7446                                       ,buf_clients.obj-code
     7447                                       )
     7448             .
     7449           end.
     7450           find first buf_clients no-lock
     7451             where buf_clients.obj-type = v-cntxt-obj-type
     7452               and buf_clients.obj-code = v-cntxt-obj-code
     7453             no-error .
     7454           if available buf_clients
     7455           then do:
     7456             assign
     7457               v-obj-str = substitute("Объект: &1 &2"
     7458                                     ,buf_clients.obj-type
     7459                                     ,buf_clients.obj-code
     7460                                     )
     7461             .
     7462           end.
     7463         end.
     7464         otherwise do:
     7465           message
     7466             vss-workfile vss-revision vss-description skip
     7467             "Неизвестное значение переменной уровень контекста" skip
     7468             "Значение" v-cntxt-level skip
     7469             view-as alert-box error .
     7470           undo, return error return-value .
     7471         end.
     7472       end case .
     7473       run gbl/getvers.p
     7474         (output v-version-name
     7475         ) .
     7476       assign
     7477         v-version-name-str = substitute("TH &1", v-version-name)
     7478       .
     7479       assign
     7480         v-db-num-str = substitute("БД: &1", v-cntxt-db-num)
     7481       .
     7482       assign
     7483         v-user-id-str = substitute("Пользователь: &1", fi-user-login)
     7484       .
     7485       assign
     7486         v-process-id-str = substitute("PID: &1", v-cntxt-process-id)
     7487       .
     7488   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     7489   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     7490       define variable v-title as character no-undo .
     7491       if objSrv:SystemSetting:DeveloperMode then
     7492         v-title = substitute('&1, &2, &3&4&5, &6, PID &7 &8':U
     7493                             ,fi-menu-group-name
     7494                             ,entry( 2,v-db-num-str,":")
     7495                             ,(if v-host-str <> '':U
     7496                                 then entry( 2,v-host-str,":") + ', ':U
     7497                                 else '':U
     7498                               )
     7499                             , (if v-obj-str <> '':U
     7500                                 then entry( 2,v-obj-str,":") + ', ':U
     7501                                 else '':U
     7502                               )
     7503                             ,entry( 2,v-user-id-str,":")
     7504                             ,v-version-name-str
     7505                             ,v-cntxt-process-id
     7506                             ,dbparam("ub")
     7507                             )
     7508       .
     7509       else
     7510       assign
     7511         v-title = substitute('&1, &2, &3&4&5, &6, PID &7 &8':U
     7512                             ,fi-menu-group-name
     7513                             ,v-db-num-str
     7514                             ,(if v-host-str <> '':U
     7515                                 then v-host-str + ', ':U
     7516                                 else '':U
     7517                               )
     7518                             , (if v-obj-str <> '':U
     7519                                 then v-obj-str + ', ':U
     7520                                 else '':U
     7521                               )
     7522                             ,v-user-id-str
     7523                             ,v-version-name-str
     7524                             ,v-cntxt-process-id
     7525                             ,""
     7526                             )
     7527       .
     7528       assign
     7529         C-Win :title = v-title
     7530       .
     7531     end.
     7532   END PROCEDURE.
     7533   PROCEDURE set-quest-print :
     7534     define input parameter p-quest-print as logical no-undo .
     7535     define buffer buf_user-login for ub.user-login .
     7536     do
     7537     on error undo, return error
     7538     :
     7539       assign
     7540         v-cntxt-quest-print = p-quest-print
     7541       .
     7542       find first buf_user-login exclusive-lock
     7543         where buf_user-login.db-num  = v-cntxt-db-num
     7544           and buf_user-login.user-id = v-cntxt-user-id
     7545         no-error .
     7546       if available buf_user-login then do:
     7547         assign
     7548           buf_user-login.quest-print = v-cntxt-quest-print
     7549         .
     7550       end.
     7551     end.
     7552   END PROCEDURE.
     7553   PROCEDURE trigger-select-context :
     7554       define variable v-cur-date-error-code   as integer      no-undo.
     7555       define variable v-user-select           as logical      no-undo.
     7556   do
     7557   on error undo, return error return-value
     7558   :
     7559       assign
     7560           v-cur-date-error-code = 1
     7561       .
     7562       choose-item:
     7563       do while v-cur-date-error-code = 1
     7564       on error undo, return error
     7565       :
     7566           run select-context in this-procedure
     7567           (input  true
     7568           ,output v-user-select
     7569           ) .
     7570           if v-user-select <> true
     7571           then do:
     7572               UNDO, return ERROR.
     7573           end.
     7574           run delete-dm-menu in this-procedure
     7575           no-error .
     7576           if error-status :error
     7577           then do:
     7578               message
     7579                   vss-workfile vss-revision vss-description skip
     7580                   "Ошибка при удалении меню" skip
     7581                   error-status :get-message(1) skip
     7582                   return-value skip
     7583               view-as alert-box error .
     7584               undo choose-item, return error return-value .
     7585           end.
     7586           run create-dm-menu in this-procedure
     7587           no-error .
     7588           if error-status :error
     7589           then do:
     7590               message
     7591                   vss-workfile vss-revision vss-description skip
     7592                   "Ошибка при создании меню" skip
     7593                   error-status :get-message(1) skip
     7594                   return-value skip
     7595               view-as alert-box error .
     7596               undo choose-item, return error return-value .
     7597           end.
     7598           run disp-static in this-procedure
     7599           no-error .
     7600           if error-status :error
     7601           then do:
     7602               message
     7603                   vss-workfile vss-revision vss-description skip
     7604                   "Ошибка при вызове процедуры disp-static" skip
     7605                   error-status :get-message(1) skip
     7606                   return-value skip
     7607               view-as alert-box error .
     7608               undo choose-item, return error return-value .
     7609           end.
     7610           run mainmenu-disp-mutable in this-procedure (
     7611               output v-cur-date-error-code
     7612           )  no-error.
     7613           if error-status :error
     7614           then do:
     7615               if v-cur-date-error-code <> 1
     7616               then do:
     7617                   message
     7618                       vss-workfile vss-revision vss-description skip
     7619                       "Ошибка при вызове процедуры mainmenu-disp-mutable" skip
     7620                       error-status :get-message(1) skip
     7621                       return-value skip
     7622                   view-as alert-box error .
     7623                   undo choose-item, return error .
     7624               end.
     7625           end.
     7626           run select-menu-group  IN THIS-PROCEDURE ( INPUT v-cntxt-menu-group-code) NO-ERROR.
     7627           if error-status :error
     7628           then do:
     7629               undo, retry.
     7630           END.
     7631       end.
     7632   end.
     7633   END PROCEDURE.
     7634   PROCEDURE update-image :
     7635     define buffer buf_temp-image for temp-image .
     7636     define buffer buf_temp-check-image for temp-check-image .
     7637     define buffer buf_menu-group for ub.menu-group .
     7638     define buffer buf_user-menu-group for ub.user-menu-group .
     7639     define variable v-enable-item                    as logical   no-undo .
     7640     define variable v-image-code                     as integer   no-undo .
     7641     define variable v-check-image-index              as integer   no-undo .
     7642     define variable v-check-image-name               as character no-undo .
     7643     define variable v-check-image-context            as character no-undo .
     7644     define variable v-check-image-menu-group-id-list as character no-undo .
     7645     define variable v-check-image-procedure-list     as character no-undo .
     7646     define variable v-check-image-visible-procedure  as character no-undo .
     7647     define variable v-check-image-image-procedure    as character no-undo .
     7648     define variable v-check-image-image-file-name    as character no-undo .
     7649     define variable v-check-image-image-name         as character no-undo .
     7650     define variable v-sel-img-file-name              as character no-undo .
     7651     do
     7652     on error undo, return error return-value
     7653     :
     7654       for each buf_temp-image
     7655       on error undo, return error return-value
     7656       :
     7657         assign
     7658           buf_temp-image.image-visible   = false
     7659           buf_temp-image.image-procedure = '':U
     7660           buf_temp-image.image-file-name = '':U
     7661         .
     7662       end.
     7663       assign
     7664         v-image-code = 0
     7665       .
     7666       for each buf_menu-group no-lock
     7667       on error undo, return error return-value
     7668       :
     7669   define variable vss-include-info31 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7670   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usmgrava in g#library2
     7671     (input  v-cntxt-db-num
     7672     ,input  0
     7673     ,input  v-cntxt-user-id
     7674     ,input  buf_menu-group.menu-code
     7675     ,input  buf_menu-group.menu-group-code
     7676     ,input  v-cntxt-level
     7677     ,input  v-cntxt-host-code-obj
     7678     ,input  v-cntxt-obj-type
     7679     ,input  v-cntxt-obj-code
     7680     ,output v-enable-item
     7681     )  .
     7682         if  v-enable-item = true
     7683         then do:
     7684           assign
     7685             v-image-code = v-image-code + 1
     7686           .
     7687           if v-image-code = 12 then do:
     7688             assign
     7689               v-image-code = 14
     7690             .
     7691           end.
     7692           find first buf_temp-image
     7693             where buf_temp-image.image-code = v-image-code
     7694             no-error .
     7695           if  available buf_temp-image
     7696           then do:
     7697             assign
     7698               v-sel-img-file-name = substring( buf_menu-group.button-image-name , 1 , index( buf_menu-group.button-image-name , '.') - 1)
     7699                             + 's'
     7700                             + substring( buf_menu-group.button-image-name , index( buf_menu-group.button-image-name , '.') )
     7701               buf_temp-image.image-visible          = true
     7702               buf_temp-image.image-handle :sensitive = true
     7703               buf_temp-image.image-file-name        = buf_menu-group.button-image-name
     7704               buf_temp-image.image-sel-file-name    = v-sel-img-file-name
     7705               buf_temp-image.image-procedure        = buf_menu-group.menu-group-procedure
     7706               buf_temp-image.image-handle :TOOLTIP  = buf_menu-group.menu-group-description
     7707             .
     7708           end.
     7709           if v-cntxt-menu-group-code = buf_menu-group.menu-group-code then do:
     7710               assign
     7711                 buf_temp-image.image-handle :sensitive = false
     7712                 v-sel-img-file-name                 = buf_temp-image.image-file-name
     7713                 buf_temp-image.image-file-name      = buf_temp-image.image-sel-file-name
     7714                 buf_temp-image.image-sel-file-name  = v-sel-img-file-name
     7715               .
     7716           end.
     7717           else do :
     7718             assign
     7719               buf_temp-image.image-handle :sensitive = true
     7720             .
     7721            end.
     7722         end.
     7723       end.
     7724       find first buf_temp-image
     7725         where buf_temp-image.image-code = 12
     7726         no-error .
     7727       if available buf_temp-image then do:
     7728         assign
     7729           buf_temp-image.image-visible          = true
     7730           buf_temp-image.image-file-name        = "cmp/btn-rfr.bmp":U
     7731           buf_temp-image.image-procedure        = "int,m__rfr-exe"
     7732           buf_temp-image.image-handle :TOOLTIP  = "Обновить экран"
     7733         .
     7734       end.
     7735       if v-cntxt-previous-menu-group-id <> ""
     7736       and v-cntxt-previous-menu-group-id <> ?
     7737       THEN DO:
     7738         find first buf_menu-group no-lock
     7739            where buf_menu-group.menu-code = v-cntxt-menu-code
     7740            and buf_menu-group.menu-group-id = v-cntxt-previous-menu-group-id
     7741            no-error .
     7742       END.
     7743       else do:
     7744         find first buf_menu-group no-lock
     7745            where buf_menu-group.menu-code = v-cntxt-menu-code
     7746            and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     7747            no-error .
     7748       end.
     7749       if not available buf_menu-group
     7750       then do:
     7751         message
     7752           vss-workfile vss-revision vss-description skip
     7753           "Не найдена группа пунктов меню" skip
     7754           view-as alert-box error .
     7755         undo, return error return-value .
     7756       end.
     7757       find first buf_temp-image
     7758         where buf_temp-image.image-code = 13
     7759         no-error .
     7760       if  available buf_temp-image
     7761       then do:
     7762         assign
     7763           buf_temp-image.image-visible            = true
     7764           buf_temp-image.image-procedure          = buf_menu-group.menu-group-procedure
     7765           buf_temp-image.image-handle :TOOLTIP    = buf_menu-group.menu-group-description
     7766         .
     7767         if v-cntxt-menu-group-code = buf_menu-group.menu-group-code then do:
     7768           assign
     7769             buf_temp-image.image-handle :sensitive  = false
     7770             buf_temp-image.image-file-name          = "cmp/btn-bck.bmp":U
     7771           .
     7772         end.
     7773         else do:
     7774           assign
     7775             buf_temp-image.image-handle :sensitive  = true
     7776             buf_temp-image.image-file-name          = buf_menu-group.button-image-name
     7777           .
     7778         end.
     7779       end.
     7780       assign
     7781         v-check-image-index = 0
     7782         v-image-code = INTEGER ( TRUNCATE ( ( v-image-code - 0.5  ) / 13 , 0 ) + 1 ) * 13
     7783       .
     7784       for each buf_temp-check-image
     7785       on error undo, return error return-value
     7786       :
     7787         delete buf_temp-check-image .
     7788       end.
     7789   define variable v-lamp-name as character no-undo .
     7790       v-lamp-name = search("cmp/image.txt").
     7791       input stream sinp from value(v-lamp-name) .
     7792       repeat
     7793       :
     7794         assign
     7795           v-check-image-name               = '':U
     7796           v-check-image-context            = '':U
     7797           v-check-image-menu-group-id-list = '':U
     7798           v-check-image-procedure-list     = '':U
     7799           v-check-image-visible-procedure  = '':U
     7800           v-check-image-image-procedure    = '':U
     7801           v-check-image-image-file-name    = '':U
     7802           v-check-image-image-name         = '':U
     7803         .
     7804         import stream sinp
     7805           v-check-image-name
     7806           v-check-image-context
     7807           v-check-image-menu-group-id-list
     7808           v-check-image-procedure-list
     7809           v-check-image-visible-procedure
     7810           v-check-image-image-procedure
     7811           v-check-image-image-file-name
     7812           v-check-image-image-name
     7813           .
     7814         assign
     7815           v-check-image-index = v-check-image-index + 1
     7816         .
     7817         create buf_temp-check-image .
     7818         assign
     7819           buf_temp-check-image.check-image-index              = v-check-image-index
     7820           buf_temp-check-image.check-image-name               = v-check-image-name
     7821           buf_temp-check-image.check-image-context            = v-check-image-context
     7822           buf_temp-check-image.check-image-menu-group-id-list = v-check-image-menu-group-id-list
     7823           buf_temp-check-image.check-image-procedure-list     = v-check-image-procedure-list
     7824           buf_temp-check-image.check-image-visible-procedure  = v-check-image-visible-procedure
     7825           buf_temp-check-image.check-image-image-procedure    = v-check-image-image-procedure
     7826           buf_temp-check-image.check-image-image-file-name    = v-check-image-image-file-name
     7827           buf_temp-check-image.check-image-image-name         = v-check-image-image-name
     7828         .
     7829       end.
     7830       input stream sinp close .
     7831       find first buf_menu-group no-lock
     7832         where buf_menu-group.menu-code       = v-cntxt-menu-code
     7833           and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     7834         no-error .
     7835       if not available buf_menu-group
     7836       then do:
     7837         message
     7838           vss-workfile vss-revision vss-description skip
     7839           "Не найдена текущая группа меню" skip
     7840           "Код меню" v-cntxt-menu-code skip
     7841           "Код группы меню" v-cntxt-menu-group-code skip
     7842           view-as alert-box error .
     7843         undo, return error return-value .
     7844       end.
     7845       define variable v-need-show-image as logical   no-undo .
     7846       for each buf_temp-check-image
     7847       on error undo, return error return-value
     7848       :
     7849         assign
     7850           v-need-show-image = true
     7851         .
     7852         if lookup(buf_menu-group.menu-group-id, buf_temp-check-image.check-image-menu-group-id-list) = 0
     7853         then do:
     7854           assign
     7855             v-need-show-image = false
     7856           .
     7857         end.
     7858         if v-need-show-image = true
     7859         then do:
     7860           if buf_temp-check-image.check-image-context = 'global':U
     7861           or (buf_temp-check-image.check-image-context = 'firm':U
     7862               and
     7863               (v-cntxt-level = 'firm':U
     7864                 or
     7865                 v-cntxt-level = 'object':U
     7866               )
     7867              )
     7868           or (buf_temp-check-image.check-image-context = 'object':U
     7869               and
     7870               v-cntxt-level = 'object':U
     7871              )
     7872           then do:
     7873           end.
     7874           else do:
     7875             assign
     7876               v-need-show-image = false
     7877             .
     7878           end.
     7879         end.
     7880         if v-need-show-image = true
     7881         then do:
     7882           if buf_temp-check-image.check-image-procedure-list = ''
     7883           then do:
     7884           end.
     7885           else do:
     7886             define variable v-check-index as integer   no-undo .
     7887             define variable v-num-entries-procedure-list as integer   no-undo .
     7888             assign
     7889               v-num-entries-procedure-list = num-entries(buf_temp-check-image.check-image-procedure-list)
     7890             .
     7891             check_block :
     7892             do v-check-index = 1 to v-num-entries-procedure-list
     7893             :
     7894               run value(entry(v-check-index, buf_temp-check-image.check-image-procedure-list)) in this-procedure
     7895                 (output v-need-show-image
     7896                 ) .
     7897               if v-need-show-image <> true
     7898               then do:
     7899                 leave check_block .
     7900               end.
     7901             end.
     7902           end.
     7903         end.
     7904         if v-need-show-image <> true
     7905         then do:
     7906           delete buf_temp-check-image .
     7907         end.
     7908       end.
     7909       define variable v-check-image-visible-proc-list as character no-undo .
     7910       assign
     7911         v-check-image-visible-proc-list = '':U
     7912       .
     7913       for each buf_temp-check-image
     7914       on error undo, return error return-value
     7915       :
     7916         if lookup(buf_temp-check-image.check-image-visible-procedure, v-check-image-visible-proc-list) = 0
     7917         then do:
     7918           assign
     7919             v-check-image-visible-proc-list = v-check-image-visible-proc-list
     7920                                             + (if v-check-image-visible-proc-list <> '':U then ',':U else '':U )
     7921                                             + buf_temp-check-image.check-image-visible-procedure
     7922           .
     7923         end.
     7924       end.
     7925       assign
     7926         v-num-entries-procedure-list = num-entries(v-check-image-visible-proc-list)
     7927       .
     7928       do v-check-index = 1 to v-num-entries-procedure-list
     7929       :
     7930         run value(entry(v-check-index, v-check-image-visible-proc-list)) in this-procedure .
     7931       end.
     7932       for each buf_temp-check-image
     7933       :
     7934         assign
     7935           v-image-code = v-image-code + 1
     7936         .
     7937         find first buf_temp-image
     7938           where buf_temp-image.image-code = v-image-code
     7939           no-error .
     7940         if available buf_temp-image
     7941         then do:
     7942           assign
     7943             buf_temp-image.image-visible   = true
     7944             buf_temp-image.image-handle :sensitive = true
     7945             buf_temp-image.image-file-name = buf_temp-check-image.check-image-image-file-name
     7946             buf_temp-image.image-procedure = buf_temp-check-image.check-image-image-procedure
     7947             buf_temp-image.image-handle :tooltip = buf_temp-check-image.check-image-image-name
     7948           .
     7949         end.
     7950       end.
     7951       for each buf_temp-image
     7952       on error undo, return error return-value
     7953       :
     7954         if buf_temp-image.image-visible = true
     7955         then do:
     7956           assign
     7957             buf_temp-image.image-handle :visible = true
     7958           .
     7959           if
     7960               buf_temp-image.image-handle:image <> buf_temp-image.image-file-name
     7961           then do:
     7962               buf_temp-image.image-handle:load-image(buf_temp-image.image-file-name) .
     7963           end.
     7964           if buf_temp-image.image-code > 8 then do:
     7965               buf_temp-image.image-handle :width-chars  =  3 .
     7966               buf_temp-image.image-handle :height-chars =  1 .
     7967           end.
     7968         end.
     7969         else do:
     7970             if buf_temp-image.image-handle:image <> "" then do:
     7971           buf_temp-image.image-handle :load-image(?) .
     7972           assign
     7973             buf_temp-image.image-handle :visible = false
     7974           .
     7975           end.
     7976         end.
     7977       end.
     7978     end.
     7979   END PROCEDURE.
     7980   PROCEDURE ver-movepar :
     7981     do
     7982     on error undo, return error return-value
     7983     :
     7984     find first ub.config  no-lock where
     7985                ub.config.param-code  = "type-vat"  and
     7986                ub.config.db-num      = v-cntxt-db-num  no-error .
     7987     end.
     7988   END PROCEDURE.
     7989   FUNCTION get-display-name RETURNS CHARACTER
     7990     ( buffer buf_temp-menu-item for temp-menu-item ) :
     7991     if available buf_temp-menu-item
     7992     then do:
     7993       return fill(" ", buf_temp-menu-item.num-level * 2)
     7994            + (if buf_temp-menu-item.item-type = 's-m':U
     7995               then (if buf_temp-menu-item.show-child = '+':u
     7996                     then chr(187) + ' ':U
     7997                     else chr(171) + ' ':U
     7998                    )
     7999               else chr(149) + ' ':U
     8000              )
     8001            + buf_temp-menu-item.display-name
     8002            .
     8003     end.
     8004     else do:
     8005       return '':U .
     8006     end.
     8007   END FUNCTION.
     8008   PROCEDURE image-display-ovrorc :
     8009     do
     8010     on error undo, return error return-value
     8011     :
     8012       define variable l-exist-ovrorc as log no-undo init false .
     8013       define buffer buf_price-doc for ub.price-doc.
     8014       define buffer buf_trn-doc   for ub.trn-doc.
     8015       define buffer buf_ord-doc   for ub.ord-doc.
     8016       find first buf_ord-doc no-lock
     8017         where buf_ord-doc.cli-type  = v-cntxt-obj-type
     8018           and buf_ord-doc.cli-code  = v-cntxt-obj-code
     8019           and buf_ord-doc.doc-type  = 'ОР':U
     8020           and buf_ord-doc.status_   = 'запрос':U
     8021               no-error .
     8022          if not available buf_ord-doc then do:
     8023             assign
     8024               l-exist-ovrorc = false
     8025             .
     8026           end.
     8027       else do:
     8028       find first buf_trn-doc no-lock
     8029         where buf_trn-doc.obj-type  = v-cntxt-obj-type
     8030           and buf_trn-doc.obj-code  = v-cntxt-obj-code
     8031           and buf_trn-doc.ext-doc-type  = 'iv':U
     8032           and buf_trn-doc.status_   = 'запрос':U
     8033           and buf_trn-doc.flag_     = true
     8034           no-error .
     8035       if not available buf_trn-doc then do:
     8036          l-exist-ovrorc = false .
     8037       end.
     8038       else do:
     8039           find first buf_price-doc no-lock
     8040             where buf_price-doc.obj-type    = v-cntxt-obj-type
     8041               and buf_price-doc.obj-code    = v-cntxt-obj-code
     8042               and buf_price-doc.status_     = 'акт':U
     8043               and
     8044               ( buf_price-doc.fact-date  >  buf_trn-doc.real-date-create or
     8045               ( buf_price-doc.fact-date  =  buf_trn-doc.real-date-create and
     8046                 buf_price-doc.fact-time  >=  buf_trn-doc.real-time-create ))
     8047               no-error .
     8048           if available buf_price-doc then do:
     8049             assign
     8050               l-exist-ovrorc = yes
     8051             .
     8052           end.
     8053       end.
     8054       end.
     8055       run image-display-update-visible in this-procedure
     8056         (input l-exist-ovrorc
     8057         ,input 'ovrorc':U
     8058         ) .
     8059     end.
     8060   END PROCEDURE.
     8061   PROCEDURE image-display-qntorc :
     8062     do
     8063     on error undo, return error return-value
     8064     :
     8065       define variable l-exist-qntorc as log no-undo init false .
     8066       define buffer buf_gds-obj   for ub.gds-obj.
     8067       define buffer buf_trn-doc   for ub.trn-doc.
     8068       define buffer buf_doc-line  for ub.doc-line.
     8069       define buffer buf_ord-doc   for ub.ord-doc.
     8070       find first buf_ord-doc no-lock
     8071         where buf_ord-doc.cli-type  = v-cntxt-obj-type
     8072           and buf_ord-doc.cli-code  = v-cntxt-obj-code
     8073           and buf_ord-doc.doc-type  = 'ОР':U
     8074           and buf_ord-doc.status_   = 'запрос':U
     8075               no-error .
     8076          if not available buf_ord-doc then do:
     8077             assign
     8078               l-exist-qntorc = false
     8079             .
     8080           end.
     8081       else do:
     8082       find first buf_trn-doc no-lock
     8083         where buf_trn-doc.obj-type  = v-cntxt-obj-type
     8084           and buf_trn-doc.obj-code  = v-cntxt-obj-code
     8085           and buf_trn-doc.ext-doc-type  = 'iv':U
     8086           and buf_trn-doc.status_   = 'запрос':U
     8087           and buf_trn-doc.flag_     = true
     8088           no-error .
     8089       if not available buf_trn-doc then do:
     8090          l-exist-qntorc = false .
     8091       end.
     8092       else do:
     8093          for each buf_doc-line no-lock where
     8094                   buf_doc-line.doc-code = buf_trn-doc.doc-code :
     8095           find first buf_gds-obj no-lock
     8096             where buf_gds-obj.obj-type    = v-cntxt-obj-type
     8097               and buf_gds-obj.obj-code    = v-cntxt-obj-code
     8098               and buf_gds-obj.artic       = buf_doc-line.artic
     8099               and buf_gds-obj.prod-type   = buf_doc-line.prod-type
     8100               and buf_gds-obj.prod-code   = buf_doc-line.prod-code no-error .
     8101                if error-status :error then do:
     8102                   l-exist-qntorc = false .
     8103                   leave.
     8104                end.
     8105                   l-exist-qntorc = true .
     8106                   if buf_gds-obj.fact-qnty < buf_doc-line.fact-qnty then do:
     8107                       l-exist-qntorc = false .
     8108                       leave.
     8109                   end.
     8110           end.
     8111       end.
     8112       end.
     8113       run image-display-update-visible in this-procedure
     8114         (input l-exist-qntorc
     8115         ,input 'qntorc':U
     8116         ) .
     8117     end.
     8118   END PROCEDURE.
     8119   PROCEDURE image-display-srgdn :
     8120     do
     8121     on error undo, return error return-value
     8122     :
     8123   define variable l-exist as log no-undo init false .
     8124   define variable v-srok as integer   no-undo .
     8125   define variable v-value-character  as character no-undo .
     8126   define variable v-value-decimal    as decimal   no-undo .
     8127   define variable v-value-integer    as integer   no-undo .
     8128   define variable v-value-logical    as logical   no-undo .
     8129   define variable v-value-type       as character no-undo .
     8130   define variable v-value-date       as date      no-undo .
     8131   define variable v-today as date      no-undo .
     8132   define variable v-time as integer   no-undo .
     8133   define variable v-godendo as date      no-undo .
     8134     empty temp-table thbjattr_thbj-attr .
     8135     run adm/shattri.p (
     8136          input "get":U
     8137         ,input v-cntxt-obj-type
     8138         ,input v-cntxt-obj-code
     8139         ,input 'Ass-obj':U
     8140         ,input 'crit-srokgod':U
     8141         ,output v-value-character
     8142         ,output v-value-date
     8143         ,output v-value-decimal
     8144         ,output v-srok
     8145         ,output v-value-logical
     8146         ,output v-value-type
     8147         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8148         ) no-error .
     8149       if v-srok = 0 then do:
     8150          l-exist = false  .
     8151           run image-display-update-visible in this-procedure
     8152             (input l-exist
     8153             ,input 'srgdn':U
     8154             ) .
     8155          return .
     8156       end.
     8157       else do:
     8158         l-exist = true .
     8159       end.
     8160       run cur-time in this-procedure (
     8161             output v-today
     8162           , output v-time
     8163       ).
     8164       run godendo-offset-to-date in this-procedure (
     8165             input  v-today
     8166           , input  v-srok
     8167           , output v-godendo
     8168       ).
     8169       define buffer buf_parts for ub.parts  .
     8170       find first buf_parts no-lock where
     8171                  buf_parts.obj-type = v-cntxt-obj-type and
     8172                  buf_parts.obj-code = v-cntxt-obj-code and
     8173                  buf_parts.last-date <= v-godendo and
     8174                  buf_parts.out-code = 'free-zone':U no-error .
     8175       if available buf_parts then do:
     8176          l-exist = true .
     8177       end.
     8178       else do:
     8179         l-exist = false .
     8180       end.
     8181       run image-display-update-visible in this-procedure
     8182         (input l-exist
     8183         ,input 'srgdn':U
     8184         ) .
     8185     end.
     8186   END PROCEDURE.
     8187   PROCEDURE image-display-defec :
     8188     do
     8189     on error undo, return error return-value
     8190     :
     8191       define variable l-exist as log no-undo init false .
     8192       assign
     8193         l-exist = false
     8194       .
     8195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8196     (input  'is-pharm':U
     8197     ,input  0
     8198     ,input  '':U
     8199     ,input  0
     8200     ,input  '':U
     8201     ,input  '':U
     8202     ,input  '':U
     8203     ,input  no
     8204     ,output v-param-value
     8205     ,output v-param-type
     8206     ) no-error .
     8207       if not error-status :error
     8208         and v-param-value = 'yes':U
     8209       then do:
     8210         define buffer buf_parts for ub.parts  .
     8211         find first buf_parts no-lock where
     8212                    buf_parts.obj-type = v-cntxt-obj-type and
     8213                    buf_parts.obj-code = v-cntxt-obj-code and
     8214                    buf_parts.defect = logical('yes':U) and
     8215                    buf_parts.out-code = 'free-zone':U no-error .
     8216         if available buf_parts then do:
     8217            l-exist = true .
     8218         end.
     8219       end.
     8220       run image-display-update-visible in this-procedure
     8221         (input l-exist
     8222         ,input 'defec':U
     8223         ) .
     8224     end.
     8225   END PROCEDURE.
     8226   PROCEDURE image-display-pharm :
     8227   define variable v-pharm      as logical   no-undo .
     8228   define variable v-attr-value as character no-undo .
     8229   define variable v-attr-type  as character no-undo .
     8230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8231     (input  'is-pharm'
     8232     ,input  ''
     8233     ,input  ''
     8234     ,input  0
     8235     ,input  ''
     8236     ,input  ''
     8237     ,input  ''
     8238     ,input  no
     8239     ,output v-attr-value
     8240     ,output v-attr-type
     8241     ) no-error .
     8242       if error-status :error
     8243       then do:
     8244         v-pharm = false .
     8245       end.
     8246       else do:
     8247          if lookup(v-attr-value, "true,yes") > 0 then do:
     8248   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$workfile: $ $revision: $".
     8249   define variable v-o-pharm    as character no-undo .
     8250   define variable v-o-var-type as character no-undo .
     8251     run clntattr-value in this-procedure
     8252       ( input   v-cntxt-obj-type ,
     8253         input   v-cntxt-obj-code ,
     8254         input  'pharm':U,
     8255         output v-o-pharm    ,
     8256         output v-o-var-type )
     8257        no-error .
     8258     if v-o-pharm <> "yes":u or error-status :error then do:
     8259        v-attr-value = "no"  .
     8260     end.
     8261          end.
     8262         assign
     8263           v-pharm = lookup(v-attr-value, "true,yes") > 0
     8264         .
     8265       end.
     8266       run image-display-update-visible in this-procedure
     8267         (input v-pharm
     8268         ,input 'pharm':U
     8269         ) .
     8270   END PROCEDURE.
     8271   PROCEDURE image-display-petrol :
     8272   define variable v-attr-value as character no-undo .
     8273   define variable v-attr-type  as character no-undo .
     8274   define variable v-shift-on   as logical   no-undo .
     8275   define variable l-exist      as logical   no-undo .
     8276   define buffer bf_goods   for ub.goods    .
     8277   define buffer bf_units   for ub.units    .
     8278   define buffer bf_gds-obj for ub.gds-obj  .
     8279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8280     (input  'is-ptrl'
     8281     ,input  ''
     8282     ,input  ''
     8283     ,input  0
     8284     ,input  ''
     8285     ,input  ''
     8286     ,input  ''
     8287     ,input  no
     8288     ,output v-attr-value
     8289     ,output v-attr-type
     8290     ) no-error .
     8291       if error-status :error
     8292         or v-attr-value = 'no'
     8293         or v-attr-value = 'false'
     8294       then do:
     8295         l-exist = false .
     8296       end.
     8297       else do:
     8298   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8300     (input  v-cntxt-obj-type
     8301     ,input  v-cntxt-obj-code
     8302     ,input  'shift-on=request'
     8303     ,output v-shift-on
     8304     ) no-error .
     8305         if v-shift-on = false then do:
     8306             l-exist = false .
     8307          end.
     8308          else do:
     8309           for each bf_units no-lock
     8310             where lookup( 'топ':U, bf_units.type) > 0
     8311             ,each bf_goods no-lock
     8312             where bf_goods.unit-base = bf_units.unit-name
     8313             ,first bf_gds-obj no-lock
     8314             where bf_gds-obj.obj-type  = v-cntxt-obj-type
     8315               and bf_gds-obj.obj-code  = v-cntxt-obj-code
     8316               and bf_gds-obj.artic     = bf_goods.artic
     8317               and bf_gds-obj.prod-type = bf_goods.prod-type
     8318               and bf_gds-obj.prod-code = bf_goods.prod-code
     8319           :
     8320             l-exist = true .
     8321             leave .
     8322           end.
     8323         end.
     8324       end.
     8325       run image-display-update-visible in this-procedure
     8326         (input l-exist
     8327         ,input 'petrol':U
     8328         ) .
     8329   END PROCEDURE.
     8330   PROCEDURE image-display-pr-fin :
     8331   define variable v-attr-value as character no-undo.
     8332   define variable v-attr-type  as character no-undo.
     8333   define variable l-is-fin     as logical no-undo.
     8334   define buffer   buf_fin-ob   for ub.fin-ob.
     8335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     8336     (input  'is-fin':U
     8337     ,input  ''
     8338     ,input  ''
     8339     ,input  0
     8340     ,input  ''
     8341     ,input  ''
     8342     ,input  ''
     8343     ,input  no
     8344     ,output v-attr-value
     8345     ,output v-attr-type
     8346     ) no-error .
     8347       if error-status :error
     8348          or v-attr-value = 'no'
     8349          or v-attr-value = 'false'
     8350       then do:
     8351         l-is-fin = false.
     8352       end.
     8353       else do:
     8354         if can-find(first buf_fin-ob where (buf_fin-ob.host-code = v-cntxt-host-code-obj and buf_fin-ob.sum-rubl > buf_fin-ob.con-sum-rubl)
     8355                                and buf_fin-ob.pay-date < (today - 1))
     8356         then l-is-fin = true.
     8357       end.
     8358       run image-display-update-visible in this-procedure
     8359         (input l-is-fin
     8360         ,input 'pr-fin':U
     8361         ) .
     8362   END PROCEDURE.
