     3084           end.
     3085           return no-apply .
     3086       end.
     3087   pause 0 before-hide.
     3088   assign
     3089     SESSION :SYSTEM-ALERT-BOXES = yes
     3090   .
     3091   MAIN-BLOCK:
     3092   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3093      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3094     define variable v-sys-key     as character no-undo .
     3095     define variable v-param-value as character no-undo .
     3096     define variable v-param-type  as character no-undo .
     3097     assign
     3098       v-cntxt-developer = false
     3099     .
     3100   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     3101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     3102     (output v-sys-key
     3103     ) no-error .
     3104     if v-sys-key = 'ExpertekIBS':U
     3105     then do:
     3106       assign
     3107         v-cntxt-developer = true
     3108       .
     3109     end.
     3110     run gbl/getconn.p
     3111       (output v-connect-usr
     3112       ,output v-connect-device
     3113       ,output v-userio-id
     3114       ) .
     3115     RUN enable_UI.
     3116       image-54:move-to-bottom().
     3117     run fill-temp-image in this-procedure .
     3118     CREATE MENU MENU-BAR-handle.
     3119     C-Win :MENUBAR = MENU-BAR-handle.
     3120     define variable v-user-select         as logical   no-undo .
     3121     define variable v-cntxt-valid         as logical   no-undo .
     3122     define variable v-cntxt-error-message as character no-undo .
     3123     define variable v-cur-date-error-code as integer      no-undo.
     3124     run gbl/actn-upd.p
     3125         (input this-procedure
     3126         ) no-error .
     3127      if error-status :error
     3128      then do:
     3129         message
     3130            vss-workfile vss-revision vss-description skip
     3131            "Ошибка при обновлении прав" skip
     3132            error-status :get-message(1) skip
     3133            return-value skip
     3134            view-as alert-box error .
     3135         undo, return no-apply return-value .
     3136      end.
     3137      define buffer buf_cd-events      for ub.cd-events .
     3138      define variable v-version    as integer      no-undo.
     3139      FIND LAST buf_cd-events NO-LOCK NO-ERROR.
     3140      IF AVAILABLE buf_cd-events
     3141      THEN DO:
     3142         ASSIGN
     3143            v-version = buf_cd-events.version
     3144         .
     3145         RELEASE buf_cd-events.
     3146      END.
     3147      ELSE DO:
     3148         ASSIGN
     3149            v-version = 0
     3150         .
     3151      END.
     3152      run utl/cdevload.p ( INPUT THIS-PROCEDURE
     3153                         , INPUT-OUTPUT v-version
     3154                         ) .
     3155      define buffer buf_sys-ctrl      for ub.sys-ctrl.
     3156      find first buf_sys-ctrl no-lock.
     3157      run gbl/menu-upd.p
     3158         (input  this-procedure
     3159         ,input  ?
     3160         ,input  0
     3161         ,input  buf_sys-ctrl.db-num
     3162         ) no-error .
     3163      if error-status :error
     3164      then do:
     3165         message
     3166            vss-workfile vss-revision vss-description skip
     3167            "Ошибка при обновлении меню" skip
     3168            error-status :get-message(1) skip
     3169            return-value skip
     3170            view-as alert-box error .
     3171         undo, return no-apply return-value .
     3172      end.
     3173      release buf_sys-ctrl.
     3174     run get-last-context in this-procedure
     3175       (output v-cntxt-db-num
     3176       ,output v-cntxt-user-id
     3177       ,output v-cntxt-process-id
     3178       ,output v-cntxt-password
     3179       ,output v-cntxt-valid
     3180       ,output v-cntxt-level
     3181       ,output v-cntxt-host-code-obj
     3182       ,output v-cntxt-obj-type
     3183       ,output v-cntxt-obj-code
     3184       ,output v-cntxt-db-num-obj
     3185       ,output v-cntxt-menu-code
     3186       ,output v-cntxt-menu-group-code
     3187       ,output v-cntxt-report-num
     3188       ,output v-cntxt-quest-print
     3189       ,output v-cntxt-inp-jewel
     3190       ,output v-cntxt-gds-engl
     3191       ,output v-cntxt-bc-price
     3192       ,output v-cntxt-is-admin
     3193       ) .
     3194      if v-cntxt-valid = true
     3195      then do:
     3196         run gbl/cntxtchk.p
     3197            (input  v-cntxt-db-num
     3198            ,input  v-cntxt-user-id
     3199            ,input  v-cntxt-menu-code
     3200            ,input  v-cntxt-menu-group-code
     3201            ,input  v-cntxt-level
     3202            ,input  v-cntxt-host-code-obj
     3203            ,input  v-cntxt-obj-type
     3204            ,input  v-cntxt-obj-code
     3205            ,input  v-cntxt-db-num-obj
     3206            ,output v-cntxt-valid
     3207            ,output v-cntxt-error-message
     3208            ) .
     3209      end.
     3210      run gbl/code-upd.p(input  this-procedure)  no-error .
     3211      if error-status :error
     3212      then do:
     3213         message
     3214            vss-workfile vss-revision vss-description skip
     3215            "Ошибка при обновлении справочников" skip
     3216            error-status :get-message(1) skip
     3217            return-value skip
     3218            view-as alert-box error .
     3219         undo, return no-apply return-value .
     3220      end.
     3221      run gbl/verinfo.p.
     3222      run utl/chgpsw.p (yes) no-error.
     3223      if error-status:error
     3224      then do:
     3225         message return-value view-as alert-box.
     3226         return error return-value .
     3227      end.
     3228     user-number:
     3229     DO
     3230     ON ERROR   UNDO user-number, RETRY user-number
     3231     ON END-KEY UNDO user-number, RETURN:
     3232         IF RETRY
     3233         OR v-cntxt-valid = false
     3234         then do:
     3235            run select-context in this-procedure
     3236               (input  false
     3237               ,output v-user-select
     3238               ) .
     3239            if v-user-select <> true
     3240            then do:
     3241               return .
     3242            end.
     3243         end.
     3244         define buffer buf_menu-group for ub.menu-group .
     3245         find first buf_menu-group no-lock
     3246            where buf_menu-group.menu-code       = v-cntxt-menu-code
     3247               and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     3248            no-error .
     3249         if not available buf_menu-group
     3250         then do:
     3251            message
     3252               vss-workfile vss-revision vss-description skip
     3253               "Ошибка при поиске группы пунктов меню" skip
