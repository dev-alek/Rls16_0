     5093   PROCEDURE get-last-context :
     5094     define output parameter p-cntxt-db-num                  as integer   no-undo .
     5095     define output parameter p-cntxt-user-id                 as character no-undo .
     5096     define output parameter p-cntxt-process-id              as integer   no-undo .
     5097     define output parameter p-cntxt-password                as character no-undo .
     5098     define output parameter p-cntxt-valid                   as logical   no-undo .
     5099     define output parameter p-cntxt-level                   as character no-undo .
     5100     define output parameter p-cntxt-host-code-obj           as integer   no-undo .
     5101     define output parameter p-cntxt-obj-type                as character no-undo .
     5102     define output parameter p-cntxt-obj-code                as integer   no-undo .
     5103     define output parameter p-cntxt-db-num-obj              as integer   no-undo .
     5104     define output parameter p-cntxt-menu-code               as integer   no-undo .
     5105     define output parameter p-cntxt-menu-group-code         as integer   no-undo .
     5106     define output parameter p-cntxt-report-num              as integer   no-undo .
     5107     define output parameter p-cntxt-quest-print             as logical   no-undo .
     5108     define output parameter p-cntxt-inp-jewel               as logical   no-undo .
     5109     define output parameter p-cntxt-gds-engl                as logical   no-undo .
     5110     define output parameter p-cntxt-bc-price                as logical   no-undo .
     5111     define output parameter p-cntxt-is-admin                as logical   no-undo .
     5112     define buffer buf_user-login for ub.user-login .
     5113     do
     5114     on error undo, return error return-value
     5115     :
     5116       assign
     5117         p-cntxt-user-id  = p-user-id
     5118         p-cntxt-password = p-password
     5119       .
     5120       run gbl/getprcid.p
     5121         (output p-cntxt-process-id
     5122         ) .
     5123       define buffer buf_sys-ctrl for ub.sys-ctrl .
     5124       find first buf_sys-ctrl no-lock .
     5125       assign
     5126         p-cntxt-db-num = buf_sys-ctrl.db-num
     5127       .
     5128       run gbl/cntxtget.p
     5129         (input  p-cntxt-db-num
     5130         ,input  p-cntxt-user-id
     5131         ,output p-cntxt-valid
     5132         ,output p-cntxt-menu-code
     5133         ,output p-cntxt-menu-group-code
     5134         ,output p-cntxt-level
     5135         ,output p-cntxt-host-code-obj
     5136         ,output p-cntxt-obj-type
     5137         ,output p-cntxt-obj-code
     5138         ) .
     5139       if p-cntxt-level = 'object':U
     5140       then do:
     5141   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     5143     (input  p-cntxt-obj-type
     5144     ,input  p-cntxt-obj-code
     5145     ,output p-cntxt-db-num-obj
     5146     ) no-error .
     5147       end.
     5148       else do:
     5149         assign
     5150           p-cntxt-db-num-obj = ?
     5151         .
     5152       end.
     5153       assign
     5154         p-cntxt-report-num = ibs.th.gbl.gbl-inipar:cntxt-report-num .
     5155       .
     5156       find first buf_user-login no-lock
     5157         where buf_user-login.db-num  = p-cntxt-db-num
     5158           and buf_user-login.user-id = p-cntxt-user-id
     5159         no-error .
     5160       if available buf_user-login
     5161       then do:
     5162         assign
     5163               p-cntxt-quest-print = buf_user-login.quest-print
     5164               p-cntxt-is-admin    = buf_user-login.user-administrator
     5165         .
     5166       end.
     5167     end.
     5168   END PROCEDURE.
