     5209   PROCEDURE image-display-as-min :
     5210   define buffer x-gds-obj-prop for ub.gds-obj-prop.
     5211   define buffer x-gds-obj      for ub.gds-obj.
     5212   define variable l-exist-as-min as log no-undo .
     5213     do
     5214     on error undo, return error return-value
     5215     :
     5216      l-exist-as-min = false  .
     5217      for  EACH x-gds-obj-prop no-lock WHERE
     5218                x-gds-obj-prop.gdop-assort-min = true AND
     5219                x-gds-obj-prop.obj-code = v-cntxt-obj-code  AND
     5220                x-gds-obj-prop.obj-type = v-cntxt-obj-type  ,
     5221                   EACH x-gds-obj no-lock WHERE
     5222                        x-gds-obj.gds-code = x-gds-obj-prop.gds-code AND
     5223                        x-gds-obj.obj-code = x-gds-obj-prop.obj-code AND
     5224                        x-gds-obj.obj-type = x-gds-obj-prop.obj-type and
     5225                        x-gds-obj.fact-qnty < x-gds-obj-prop.gdop-min-stock
     5226                        :
     5227         l-exist-as-min = true .
     5228         leave.
     5229       end.
     5230       run image-display-update-visible in this-procedure
     5231         (input l-exist-as-min
     5232         ,input 'as-min':U
     5233         ) .
     5234     end.
     5235   END PROCEDURE.
     5236   PROCEDURE image-display-cd :
     5237     do
     5238     on error undo, return error return-value
     5239     :
     5240       def var l-exist-cd as log no-undo .
     5241       define variable v-send as logical no-undo .
     5242       define buffer buf_BatchProcess for ub.batchProcess .
     5243       assign
     5244       l-exist-cd =
     5245           can-find (first  buf_BatchProcess no-lock
     5246           where buf_BatchProcess.bp_type       = 'gds':U
     5247             and buf_BatchProcess.bp_status     = 'N':U
     5248                   )
     5249           or
     5250           can-find (first  buf_BatchProcess no-lock
     5251           where buf_BatchProcess.bp_type       = 'goa':U
     5252             and buf_BatchProcess.bp_status     = 'N':U
     5253                   )
     5254           or
     5255           can-find (first  buf_BatchProcess no-lock
     5256           where buf_BatchProcess.bp_type       = 'dcard':U
     5257             and buf_BatchProcess.bp_status     = 'N':U
     5258                   )
     5259           or
     5260           can-find (first  buf_BatchProcess no-lock
     5261           where buf_BatchProcess.bp_type       = 'slr':U
     5262             and buf_BatchProcess.bp_status     = 'N':U
     5263                   )
     5264           or
     5265           can-find (first  buf_BatchProcess no-lock
     5266           where buf_BatchProcess.bp_type       = 'cshr':U
     5267             and buf_BatchProcess.bp_status     = 'N':U
     5268                   )
     5269       .
     5270       run str/mrkt-ts.p
     5271                   (input v-cntxt-obj-type
     5272                   ,input v-cntxt-obj-code
     5273                   ,input '':U
     5274                   ,output v-send) no-error .
     5275       if error-status:error then do:
     5276         message
     5277           vss-workfile vss-revision vss-description skip
     5278           "Ошибка при вызове процедуры" 'str/mrkt-ts.p':U skip
     5279           error-status:get-message(1) skip
     5280           return-value skip
     5281           view-as alert-box error .
     5282         undo, return error .
     5283       end.
     5284       assign
     5285         l-exist-cd = l-exist-cd or v-send
     5286       .
     5287       run image-display-update-visible in this-procedure
     5288         (input l-exist-cd
     5289         ,input 'cd':U
     5290         ) .
     5291     end.
     5292   END PROCEDURE.
     5293   PROCEDURE image-display-curses :
     5294     do
     5295     on error undo, return error return-value
     5296     :
