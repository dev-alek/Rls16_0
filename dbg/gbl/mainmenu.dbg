     5520   PROCEDURE image-display-update-visible :
     5521     define input  parameter p-image-visible as logical   no-undo .
     5522     define input  parameter p-image-name    as character no-undo .
     5523     define buffer buf_temp-check-image for temp-check-image .
     5524     do
     5525     on error undo, return error return-value
     5526     :
     5527       if p-image-visible <> true
     5528       then do:
     5529         find first buf_temp-check-image
     5530           where buf_temp-check-image.check-image-name = p-image-name
     5531           no-error .
     5532         if available buf_temp-check-image
     5533         then do:
     5534           find first temp-image where
     5535                      temp-image.image-file-name = buf_temp-check-image.check-image-image-file-name no-error .
     5536            if available temp-image then do:
     5537             assign
     5538               temp-image.image-visible = false
     5539               temp-image.image-handle :sensitive = false
     5540               temp-image.image-handle :visible = false
     5541             .
     5542           end.
     5543           delete buf_temp-check-image .
     5544         end.
     5545       end.
     5546       else do:
     5547         find first buf_temp-check-image
     5548           where buf_temp-check-image.check-image-name = p-image-name
     5549           no-error .
     5550         if available buf_temp-check-image
     5551         then do:
     5552           find first temp-image where
     5553                      temp-image.image-file-name = buf_temp-check-image.check-image-image-file-name no-error .
     5554            if available temp-image then do:
     5555             assign
     5556               temp-image.image-handle :sensitive = true
     5557             .
     5558           end.
     5559           end.
     5560       end.
     5561     end.
     5562   END PROCEDURE.
     5563   PROCEDURE image-display-vozper :
     5564     do
     5565     on error undo, return error return-value
     5566     :
     5567       define variable l-exist-vozper as log no-undo .
     5568       define buffer buf_trn-doc for ub.trn-doc.
     5569       define buffer buf_clients for ub.clients.
     5570       _trn-doc:
     5571       for each buf_trn-doc no-lock
     5572         where
     5573           (   buf_trn-doc.obj-type      = v-cntxt-obj-type
     5574           and buf_trn-doc.obj-code      = v-cntxt-obj-code
     5575           and buf_trn-doc.internal      = yes
     5576           and buf_trn-doc.doc-type      = 'возврат':U
     5577           and buf_trn-doc.ext-doc-type  = 'rv':U
     5578           and buf_trn-doc.status_       = 'накл':U
     5579           )
     5580           or
     5581           (   buf_trn-doc.obj-type      = v-cntxt-obj-type
     5582           and buf_trn-doc.obj-code      = v-cntxt-obj-code
     5583           and buf_trn-doc.internal      = yes
     5584           and buf_trn-doc.doc-type      = 'возврат':U
     5585           and buf_trn-doc.ext-doc-type  = 'rv':U
     5586           and buf_trn-doc.status_       = 'разрешен':U
     5587           )
     5588       :
     5589             assign
     5590               l-exist-vozper = yes
     5591             .
     5592             leave _trn-doc.
     5593       end .
     5594       run image-display-update-visible in this-procedure
     5595         (input l-exist-vozper
     5596         ,input 'vozper':U
     5597         ) .
     5598     end.
     5599   END PROCEDURE.
     5600   PROCEDURE image-display-wth :
     5601     do
     5602     on error undo, return error return-value
     5603     :
     5604       define variable v-notes as character no-undo .
     5605       DEFINE VARIABLE  l-exist-all-ck-wth as logical no-undo .
     5606       DEFINE VARIABLE  l-exist-err-ck-wth as logical no-undo .
     5607       DEFINE VARIABLE  l-exist-awth   as logical no-undo .
     5608       DEFINE VARIABLE  l-exist-ck-wth as logical no-undo .
     5609       if v-cntxt-obj-type = 'маг':U
     5610       and v-cntxt-db-num = v-cntxt-db-num-obj then do:
     5611         run str/chk-winf.p (
     5612                         input THIS-PROCEDURE
     5613                         ,input v-cntxt-host-code-obj
     5614                         ,input v-cntxt-obj-type
     5615                         ,input v-cntxt-obj-code
     5616                         ,input no
     5617                         ,input no
     5618                         ,input ?
     5619                         ,output v-notes
     5620                         ,output l-exist-ck-wth
     5621                         ,output l-exist-err-ck-wth
     5622                         ,output l-exist-awth) no-error.
     5623         if error-status :error
     5624         then do:
     5625           message
     5626             vss-workfile vss-revision vss-description skip
     5627             "Ошибка при вызове процедуры" 'str/chk-winf.p':U skip
     5628             error-status :get-message(1) skip
     5629             return-value skip
     5630             view-as alert-box error .
     5631         end.
     5632       end.
     5633       assign
     5634         l-exist-ck-wth = l-exist-ck-wth or l-exist-err-ck-wth
     5635       .
     5636       run image-display-update-visible in this-procedure
     5637         (input l-exist-ck-wth
     5638         ,input 'ck-wth':U
     5639         ) .
     5640       run image-display-update-visible in this-procedure
     5641         (input l-exist-awth
     5642         ,input 'awth':U
     5643         ) .
     5644     end.
     5645   END PROCEDURE.
     5646   PROCEDURE load-tnved :
     5647     do
     5648     on error undo, return error return-value
     5649     :
     5650       define variable custvalue   as character no-undo .
     5651       define variable custtype    as character no-undo .
     5652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5653     (input  'is-custm':U
     5654     ,input  '':U
     5655     ,input  '':U
     5656     ,input  0
     5657     ,input  '':U
     5658     ,input  '':U
     5659     ,input  '':U
     5660     ,input  no
     5661     ,output custvalue
     5662     ,output custtype
     5663     ) no-error .
     5664       if custvalue = "yes"
     5665       then do:
     5666         if not can-find (first tt-tnved)
     5667         then do:
     5668           get-key-value section "custom" key "rep-tnved" value tnved-fn.
     5669           run ref/l-tnved.p
     5670             (input search(tnved-fn)
     5671             ).
     5672         end.
     5673       end.
     5674     end.
     5675   END PROCEDURE.
     5676   PROCEDURE logo :
     5677   do with frame DEFAULT-FRAME:
     5678     if  v-logo-image-visible
     5679     and v-cntxt-level = 'object':U
     5680     then do:
     5681       assign
     5682         v-logo-image-visible = false
     5683       .
     5684     end.
     5685   end.
     5686   END PROCEDURE.
     5687   PROCEDURE mainmenu-disp-mutable :
     5688   define output parameter p-cur-date-error-code   as integer          no-undo.
     5689     define variable v-obj-shift           as logical      no-undo .
     5690     define variable v-shift-date          as date         no-undo .
     5691     define variable v-shift-num           as integer      no-undo .
     5692     define variable v-shift-name          as character    no-undo .
     5693     define variable v-result              as integer      no-undo .
     5694     define variable v-time                as integer      no-undo .
     5695     do
     5696     on error undo, return error return-value
     5697     :
     5698       assign
     5699         file-info :file-name = '.'
     5700       .
     5701       if v-work-file = ""
     5702       then do:
     5703         assign
     5704           v-work-file = file-info :full-pathname
     5705         .
     5706       end.
     5707       else do:
     5708         if v-work-file <> file-info :full-pathname
     5709         then do:
     5710           message
     5711             vss-workfile vss-revision vss-description skip
     5712             "Рабочая директория изменилась" skip
     5713             "Новая рабочая директория" file-info :full-pathname skip
     5714             "Старая рабочая директория" v-work-file skip
     5715             view-as alert-box error .
     5716           run SetCurrentDirectoryA
     5717             (input  v-work-file
     5718             ,output v-result
     5719             ).
     5720           assign
     5721             file-info :file-name = '.'
     5722           .
     5723           if v-work-file = file-info :full-pathname
     5724           then do:
     5725             message
     5726               "Рабочая директория восстановлена" skip
     5727               "Текущая рабочая директория" file-info :full-pathname skip
     5728               view-as alert-box information .
     5729           end.
     5730           else do:
     5731             message
     5732               "Рабочая директория не восстановлена" skip
     5733               "Текущая рабочая директория" file-info :full-pathname skip
     5734               "Пожалуйста завершите работу программы" skip
     5735               view-as alert-box error .
     5736           end.
     5737         end.
     5738       end.
     5739       do with frame DEFAULT-FRAME
     5740       :
     5741         assign
     5742           fi-obj-date           = ?
     5743           fi-close-date         = ?
     5744           fi-shift-date         = ?
     5745           fi-shift-name         = '':U
     5746           fi-shift-order        = '':U
     5747         .
     5748           if v-cntxt-level = 'global':U
     5749           or v-cntxt-level = 'firm':U
     5750           then do:
     5751               run cur-time in this-procedure (
     5752                   output fi-obj-date
     5753                 , output v-time ) .
     5754               assign
     5755                   fi-shift-date :visible      = no
     5756                   fi-shift-name :visible      = no
     5757                   fi-shift-order:visible      = no
     5758                   b-show-date   :visible      = no
     5759                   fi-obj-date   :screen-value = string(fi-obj-date,"99/99/9999":U)
     5760                   fi-obj-date   :visible      = yes
     5761               .
     5762           end.
     5763           if v-cntxt-level = 'object':U
     5764           then do:
     5765               run adm/cur-date.w (
     5766                     input this-procedure
     5767                   , input v-cntxt-obj-type
     5768                   , input v-cntxt-obj-code
     5769                   , input '':u
     5770                   , output p-cur-date-error-code
     5771               ) no-error .
     5772               if error-status :error
     5773               then do:
     5774                   message
     5775                   "Ошибка установки текущей даты на объекте!"
     5776                   view-as alert-box error.
     5777                   undo, return error.
     5778               end.
     5779   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     5781     (input  v-cntxt-obj-type
     5782     ,input  v-cntxt-obj-code
     5783     ,output fi-obj-date
     5784     ) no-error .
     5785               if error-status :error
     5786               then do:
     5787                   message
     5788                   "Текущая дата не установлена!"
     5789                   view-as alert-box error.
     5790                   undo, return error.
     5791               end.
     5792   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5794     (input  v-cntxt-obj-type
     5795     ,input  v-cntxt-obj-code
     5796     ,input  'shift-on=request'
     5797     ,output v-obj-shift
     5798     ) no-error .
     5799               if error-status :error
     5800               then do:
     5801               message
     5802                   vss-workfile vss-revision vss-description skip
     5803                   "Ошибка при запуске процедуры objat" skip
     5804                   error-status :get-message(1) skip
     5805                   return-value skip
     5806                   view-as alert-box error .
     5807               return.
     5808               end.
     5809               if v-obj-shift = true
     5810               then do:
     5811   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5812   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     5813     (input  v-cntxt-obj-type
     5814     ,input  v-cntxt-obj-code
     5815     ,output v-shift-date
     5816     ,output v-shift-num
     5817     ,output v-shift-name
     5818     ) no-error .
     5819                   if error-status :error
     5820                   then do:
     5821                       assign
     5822                           fi-shift-date         = ?
     5823                           fi-shift-name         = '':U
     5824                           fi-shift-order        = '':U
     5825                       .
     5826                   end.
     5827                   else do:
     5828                       assign
     5829                           fi-shift-date         = string(v-shift-date, '99/99/9999':U)
     5830                           fi-shift-name         = v-shift-name
     5831                           fi-shift-order        = string(v-shift-num)
     5832                       .
     5833                   end.
     5834                   assign
     5835                       fi-shift-date:screen-value  = fi-shift-date
     5836                       fi-shift-name:screen-value  = fi-shift-name
     5837                       fi-shift-order:screen-value = fi-shift-order
     5838                       fi-shift-date:visible       = yes
     5839                       fi-shift-name:visible       = yes
     5840                       fi-shift-order:visible      = yes
     5841                   .
     5842               end.
     5843               else do:
     5844                  assign
     5845                     fi-shift-date :visible       = no
     5846                     fi-shift-name :visible       = no
     5847                     fi-shift-order:visible       = no
     5848                  .
     5849               end.
     5850               assign
     5851                   fi-obj-date:screen-value = string(fi-obj-date, '99/99/9999':U)
     5852                   fi-obj-date:visible      = yes
     5853                   b-show-date:visible      = yes
     5854               .
     5855               run proc-check-RVD in this-procedure .
     5856               run proc-check-place-imp in this-procedure .
     5857           end.
     5858           run proc-fi-close-date in this-procedure
     5859               ( output fi-close-date  ) .
     5860           if fi-close-date = ? then hide fi-close-date.
     5861           else assign
     5862                   fi-close-date :screen-value  = string(fi-close-date, '99/99/9999':U)
     5863                   fi-close-date :visible       = yes
     5864                .
     5865       end.
     5866       run update-image in this-procedure
     5867         no-error .
     5868       if error-status :error
     5869       then do:
     5870         message
     5871           vss-workfile vss-revision vss-description skip
     5872           "Ошибка при обновлении картинок" skip
     5873           error-status :get-message(1) skip
     5874           return-value skip
     5875           view-as alert-box error .
     5876         return error.
     5877       end.
     5878     end.
     5879   END PROCEDURE.
     5880   PROCEDURE mainmenu-menu-item-clear :
     5881     define buffer buf_temp-menu-item for temp-menu-item .
     5882     do
     5883     on error undo, return error return-value
     5884     :
     5885       for each buf_temp-menu-item
     5886       on error undo, return error return-value
     5887       :
     5888         delete buf_temp-menu-item .
     5889       end.
     5890     end.
     5891   END PROCEDURE.
     5892   PROCEDURE mainmenu-menu-item-create :
     5893     define input  parameter p-item-code      as integer   no-undo .
     5894     define input  parameter p-item-type      as character no-undo .
     5895     define input  parameter p-item-name      as character no-undo .
     5896     define input  parameter p-item-id        as character no-undo .
     5897     define input  parameter p-item-procedure as character no-undo .
     5898     define input  parameter p-parent-code    as integer   no-undo .
     5899     define input  parameter p-show-menu-item as logical   no-undo .
     5900     define buffer buf_temp-menu-item for temp-menu-item .
     5901     define buffer buf_parent_temp-menu-item for temp-menu-item .
     5902     define variable v-parent-full-name as character no-undo .
     5903     do
     5904     on error undo, return error return-value
     5905     :
     5906       IF CAN-FIND ( FIRST buf_temp-menu-item
     5907                     WHERE buf_temp-menu-item.item-code = p-item-code
     5908                     NO-LOCK
     5909                   ) THEN RETURN.
     5910       create buf_temp-menu-item .
     5911       assign
     5912         buf_temp-menu-item.item-code      = p-item-code
     5913         buf_temp-menu-item.item-type      = p-item-type
     5914         buf_temp-menu-item.item-name      = p-item-name
     5915         buf_temp-menu-item.item-id        = p-item-id
     5916         buf_temp-menu-item.item-procedure = p-item-procedure
     5917         buf_temp-menu-item.parent-code    = p-parent-code
     5918         buf_temp-menu-item.show-menu-item = p-show-menu-item
     5919       .
     5920       find first buf_parent_temp-menu-item
     5921         where buf_parent_temp-menu-item.item-code = buf_temp-menu-item.parent-code
     5922         no-error .
     5923       if not available buf_parent_temp-menu-item
     5924       then do:
     5925         assign
     5926           buf_temp-menu-item.num-level = 0
     5927           v-parent-full-name           = ""
     5928         .
     5929       end.
     5930       else do:
     5931         assign
     5932           buf_temp-menu-item.num-level = buf_parent_temp-menu-item.num-level + 1
     5933           v-parent-full-name           = buf_parent_temp-menu-item.full-name
     5934         .
     5935         if buf_parent_temp-menu-item.show-menu-item = false
     5936         then do:
     5937           assign
     5938             buf_temp-menu-item.show-menu-item = false
     5939           .
     5940         end.
     5941       end.
     5942       assign
     5943         buf_temp-menu-item.show-child   = ""
     5944         buf_temp-menu-item.display-name = replace(buf_temp-menu-item.item-name
     5945                                                  ,"&"
     5946                                                  ,""
     5947                                                  )
     5948         buf_temp-menu-item.full-name    = v-parent-full-name
     5949                                         + (if v-parent-full-name <> ""
     5950                                            then '/':U
     5951                                            else '':U
     5952                                           )
     5953                                         + replace(buf_temp-menu-item.item-name
     5954                                                  ,"&"
     5955                                                  ,""
     5956                                                  )
     5957       .
     5958       if buf_temp-menu-item.item-type = 's-m':U
     5959       then do:
     5960         assign
     5961           buf_temp-menu-item.show-child = '+':U
     5962         .
     5963       end.
     5964       define variable v-item-value     as logical   no-undo .
     5965       define variable v-procedure-type as character no-undo .
     5966       define variable v-item-procedure as character no-undo .
     5967       if buf_temp-menu-item.item-type = 'm-t':U
     5968       then do:
     5969         assign
     5970           v-procedure-type = entry(1, buf_temp-menu-item.item-procedure, chr(44))
     5971           v-item-procedure = entry(2, buf_temp-menu-item.item-procedure, chr(44))
     5972         .
     5973         case v-procedure-type
     5974         :
     5975           when 'int':U
     5976           then do:
     5977             run value(v-item-procedure) in g#dm-menu-handle
     5978               (input  'get':U
     5979               ,input-output v-item-value
     5980               ) .
     5981           end.
     5982           when 'ext':U
     5983           then do:
     5984             run value(v-item-procedure)
     5985               (input  'get':U
     5986               ,input-output v-item-value
     5987               ) .
     5988           end.
     5989           otherwise do:
     5990             message
     5991               vss-workfile vss-revision vss-description skip
     5992               "Внутренняя ошибка" skip
     5993               "Код пункта меню" buf_temp-menu-item.item-code skip
     5994               "Неизвестный тип процедуры" v-procedure-type skip
     5995               "Процедура" v-item-procedure skip
     5996               view-as alert-box error .
     5997           end.
     5998         end case .
     5999         if v-item-value = true
     6000         then do:
     6001           assign
     6002             buf_temp-menu-item.display-name = '*':U + ' ':U + buf_temp-menu-item.display-name
     6003           .
     6004         end.
     6005         else do:
     6006           assign
     6007             buf_temp-menu-item.display-name = '_':U + ' ':U + buf_temp-menu-item.display-name
     6008           .
     6009         end.
     6010       end.
     6011       if buf_temp-menu-item.item-type = 'r-l':U
     6012       then do:
     6013         assign
     6014           buf_temp-menu-item.display-name = fill(" ", buf_temp-menu-item.num-level * 2)
     6015                                           + fill('-', 80)
     6016           buf_temp-menu-item.full-name    = ""
     6017         .
     6018       end.
     6019     end.
     6020   END PROCEDURE.
     6021   PROCEDURE mainmenu-menu-item-create-parent :
     6022     define input  parameter p-parent-code as integer   no-undo .
     6023     define buffer buf_temp-menu-item      for temp-menu-item .
     6024     define buffer buf_menu-item           for ub.menu-item .
     6025     define buffer buf_temp-menu-item-open for temp-menu-item-open .
     6026     do
     6027     on error undo, return error return-value
     6028     :
     6029       find first buf_temp-menu-item
     6030         where buf_temp-menu-item.item-code = p-parent-code
     6031         no-error .
     6032       if not available buf_temp-menu-item
     6033       then do:
     6034         find first buf_menu-item no-lock
     6035           where buf_menu-item.menu-code = v-cntxt-menu-code
     6036             and buf_menu-item.item-code = p-parent-code
     6037           no-error .
     6038         if not available buf_menu-item
     6039         then do:
     6040           message
     6041             vss-workfile vss-revision vss-description skip
     6042             "Внутренняя ошибка" skip
     6043             "Ошибка при поиске пункта меню" skip
     6044             "menu-code" v-cntxt-menu-code skip
     6045             "item-code" p-parent-code skip
     6046             view-as alert-box error .
     6047           undo, return error return-value .
     6048         end.
     6049         run mainmenu-menu-item-create-parent in this-procedure
     6050           (input  buf_menu-item.parent-code
     6051           ) .
     6052         find first buf_temp-menu-item
     6053           where buf_temp-menu-item.item-code = buf_menu-item.parent-code
     6054           .
     6055         assign
     6056           buf_temp-menu-item.show-child = '-':U
     6057         .
     6058         find first buf_temp-menu-item-open
     6059           where buf_temp-menu-item-open.item-code = buf_temp-menu-item.item-code
     6060           no-error .
     6061         if not available buf_temp-menu-item-open
     6062         then do:
     6063           create buf_temp-menu-item-open .
     6064           assign
     6065             buf_temp-menu-item-open.item-code = buf_temp-menu-item.item-code
     6066           .
     6067         end.
     6068         run proc-create-menu-item in g#dm-menu-handle
     6069           (input  buf_menu-item.parent-code
     6070           ,input  ?
     6071           ,input  false
     6072           ,input  true
     6073           ) .
     6074       end.
     6075     end.
     6076   END PROCEDURE.
     6077   PROCEDURE mainmenu-menu-item-open :
     6078     define input  parameter p-item-code as integer   no-undo .
     6079     define buffer buf_temp-menu-item for temp-menu-item .
     6080     define variable v-item-id as character no-undo .
     6081     do
     6082     on error undo, return error return-value
     6083     :
     6084       open query br-menu-item
     6085         for each temp-menu-item
     6086           where temp-menu-item.show-menu-item = true
     6087         by temp-menu-item.item-code .
     6088       if p-item-code <> 0
     6089       then do:
     6090         find first buf_temp-menu-item
     6091           where buf_temp-menu-item.item-code = p-item-code
     6092           no-error .
     6093         if  available buf_temp-menu-item
     6094         and buf_temp-menu-item.show-menu-item = true
     6095         then do:
     6096           reposition br-menu-item to rowid rowid(buf_temp-menu-item) .
     6097         end.
     6098       end.
     6099       run menu-item-display-full-name in this-procedure .
     6100     end.
     6101   END PROCEDURE.
     6102   PROCEDURE mainmenu-set-menu-toggle :
     6103     define input  parameter p-item-code  as integer   no-undo .
     6104     define input  parameter p-item-value as logical   no-undo .
     6105     define buffer buf_temp-menu-item for temp-menu-item .
     6106     do
     6107     on error undo, return error return-value
     6108     :
     6109       find first buf_temp-menu-item
     6110         where buf_temp-menu-item.item-code = p-item-code
     6111         no-error .
     6112       if available buf_temp-menu-item
     6113       then do:
     6114         if p-item-value = true
     6115         then do:
     6116           assign
     6117             substring(buf_temp-menu-item.display-name, 1, 1) = '*':U
     6118           .
     6119         end.
     6120         else do:
     6121           assign
     6122             substring(buf_temp-menu-item.display-name, 1, 1) = '_':U
     6123           .
     6124         end.
     6125       end.
     6126       else do:
     6127         message
     6128           "Пункт меню не найден" skip
     6129           p-item-code skip
     6130           view-as alert-box error .
     6131       end.
     6132     end.
     6133   END PROCEDURE.
     6134   PROCEDURE mainmenu-show-item :
     6135     define input  parameter p-item-code as integer   no-undo .
     6136     do
     6137     on error undo, return error return-value
     6138     :
     6139       run mainmenu-menu-item-create-parent in this-procedure
     6140         (input  p-item-code
     6141         ) .
     6142       run mainmenu-menu-item-open in this-procedure
     6143         (input p-item-code
     6144         ) .
     6145     end.
     6146   END PROCEDURE.
     6147   PROCEDURE mainmenu-start-item :
     6148     define input  parameter p-item-code as integer   no-undo .
     6149     define buffer buf_menu-user-call for ubflt.menu-user-call .
     6150     define buffer buf_temp-menu-item for temp-menu-item .
     6151     define buffer buf_menu-item      for ub.menu-item .
     6152     do
     6153     on error undo, return error return-value
     6154     :
     6155       assign
     6156         v-menu-user-call-rowid = ?
     6157       .
     6158       run mainmenu-menu-item-create-parent in this-procedure
     6159         (input  p-item-code
     6160         ) .
     6161       find first buf_temp-menu-item
     6162         where buf_temp-menu-item.item-code = p-item-code
     6163         no-error .
     6164       if not available buf_temp-menu-item
     6165       then do:
     6166         message
     6167           vss-workfile vss-revision vss-description skip
     6168           "Внутренняя ошибка" skip
     6169           "Не найден пункт меню с кодом" p-item-code skip
     6170           view-as alert-box error .
     6171         return .
     6172       end.
     6173       define buffer buf_menu-group for ub.menu-group .
     6174       find first buf_menu-group no-lock
     6175         where buf_menu-group.menu-code       = v-cntxt-menu-code
     6176           and buf_menu-group.menu-group-code = v-cntxt-menu-group-code
     6177         no-error .
     6178       if available buf_menu-group and buf_menu-group.menu-group-id eq "adm"
     6179       then
     6180          run trg/userlog.p (
     6181                   input 'run-proc'
     6182                   , input ('Выбран пункт меню '
     6183                   + buf_temp-menu-item.full-name +  '"' + chr(3) + buf_temp-menu-item.item-procedure )
     6184                   , input ?
     6185                   , input ?
     6186                   , input "") no-error.
     6187       define variable v-sys-time-mjd as decimal   no-undo .
     6188       define variable v-arm-title    as character no-undo .
     6189       run gbl/getustat.p
     6190         (input  v-userio-id
     6191         ,output v-sys-time-mjd
     6192         ,output v-userio-ai-read
     6193         ,output v-userio-ai-write
     6194         ,output v-userio-bi-read
     6195         ,output v-userio-bi-write
     6196         ,output v-userio-db-access
     6197         ,output v-userio-db-read
     6198         ,output v-userio-db-write
     6199         ) .
     6200       define variable v-menu-user-call-id as integer   no-undo .
     6201       assign
     6202         v-menu-user-call-id = dynamic-next-value( "s-menu-user-call":U, "ubflt":U)
     6203       .
     6204       find first buf_menu-user-call exclusive-lock
     6205         where buf_menu-user-call.db-num                 = v-cntxt-db-num
     6206           and buf_menu-user-call.user-id                = v-cntxt-user-id
     6207           and buf_menu-user-call.stop-menu-user-call-id = 0
     6208         no-error .
     6209       if available buf_menu-user-call
     6210       then do:
     6211         assign
     6212           buf_menu-user-call.stop-mjd               = v-sys-time-mjd
     6213           buf_menu-user-call.stop-menu-user-call-id = v-menu-user-call-id
     6214         .
     6215         assign
     6216           v-menu-user-call-id = dynamic-next-value( "s-menu-user-call":U, "ubflt":U)
     6217         .
     6218       end.
     6219       create buf_menu-user-call .
     6220       assign
     6221         buf_menu-user-call.db-num                 = v-cntxt-db-num
     6222         buf_menu-user-call.menu-user-call-id      = v-menu-user-call-id
     6223         buf_menu-user-call.user-id                = v-cntxt-user-id
     6224         buf_menu-user-call.menu-code              = v-cntxt-menu-code
     6225         buf_menu-user-call.start-mjd              = v-sys-time-mjd
     6226         buf_menu-user-call.stop-mjd               = 0
     6227         buf_menu-user-call.stop-menu-user-call-id = 0
     6228         buf_menu-user-call.menu-code              = v-cntxt-menu-code
     6229         buf_menu-user-call.item-id                = buf_temp-menu-item.item-id
     6230         buf_menu-user-call.cntxt-level            = v-cntxt-level
     6231         buf_menu-user-call.cntxt-host-code        = v-cntxt-host-code-obj
     6232         buf_menu-user-call.cntxt-obj-type         = v-cntxt-obj-type
     6233         buf_menu-user-call.cntxt-obj-code         = v-cntxt-obj-code
     6234         buf_menu-user-call.item-procedure         = buf_temp-menu-item.item-procedure
     6235         buf_menu-user-call.full-name              = buf_temp-menu-item.full-name
     6236         buf_menu-user-call.param-value            = ''
     6237         buf_menu-user-call.userio-ai-read         = 0
     6238         buf_menu-user-call.userio-ai-write        = 0
     6239         buf_menu-user-call.userio-bi-read         = 0
     6240         buf_menu-user-call.userio-bi-write        = 0
     6241         buf_menu-user-call.userio-db-access       = 0
     6242         buf_menu-user-call.userio-db-read         = 0
     6243         buf_menu-user-call.userio-db-write        = 0
     6244         buf_menu-user-call.connect-usr            = string(v-connect-usr)
     6245         buf_menu-user-call.connect-device         = v-connect-device
     6246       .
     6247       assign
     6248         v-menu-user-call-rowid = rowid(buf_menu-user-call)
     6249       .
     6250     end.
     6251   END PROCEDURE.
     6252   PROCEDURE mainmenu-stop-item :
     6253     define buffer buf_menu-user-call for ubflt.menu-user-call .
     6254     define variable v-sys-time-mjd         as decimal   no-undo .
     6255     define variable v-new-userio-ai-read   as decimal   no-undo .
     6256     define variable v-new-userio-ai-write  as decimal   no-undo .
     6257     define variable v-new-userio-bi-read   as decimal   no-undo .
     6258     define variable v-new-userio-bi-write  as decimal   no-undo .
     6259     define variable v-new-userio-db-access as decimal   no-undo .
     6260     define variable v-new-userio-db-read   as decimal   no-undo .
     6261     define variable v-new-userio-db-write  as decimal   no-undo .
     6262     do
     6263     on error undo, return error return-value
     6264     :
     6265       if v-menu-user-call-rowid = ?
     6266       then do:
     6267         message
     6268           vss-workfile vss-revision vss-description skip
     6269           "Внутренняя ошибка" skip
     6270           "Неопределенное значение указателя v-menu-user-call-rowid" skip
     6271           "Работа программы будет продолжена" skip
     6272           view-as alert-box error .
     6273         return .
     6274       end.
     6275       do transaction
     6276       on error undo, return error return-value
     6277       :
     6278         find first buf_menu-user-call exclusive-lock
     6279           where rowid(buf_menu-user-call) = v-menu-user-call-rowid
     6280           no-error .
     6281         if not available buf_menu-user-call
     6282         then do:
     6283           message
     6284             vss-workfile vss-revision vss-description skip
     6285             "Внутренняя ошибка" skip
     6286             "Ошибка при поиске записи buf_menu-user-call" skip
     6287             "Неверное значение указателя v-menu-user-call-rowid" skip
     6288             "Работа программы будет продолжена" skip
     6289             view-as alert-box error .
     6290           return .
     6291         end.
     6292         run gbl/getustat.p
     6293           (input  v-userio-id
     6294           ,output v-sys-time-mjd
     6295           ,output v-new-userio-ai-read
     6296           ,output v-new-userio-ai-write
     6297           ,output v-new-userio-bi-read
     6298           ,output v-new-userio-bi-write
     6299           ,output v-new-userio-db-access
     6300           ,output v-new-userio-db-read
     6301           ,output v-new-userio-db-write
     6302           ) .
     6303         define variable v-menu-user-call-id as integer   no-undo .
     6304         assign
     6305           v-menu-user-call-id = dynamic-next-value( "s-menu-user-call":U, "ubflt":U)
     6306         .
     6307         assign
     6308           buf_menu-user-call.stop-mjd               = v-sys-time-mjd
     6309           buf_menu-user-call.stop-menu-user-call-id = v-menu-user-call-id
     6310           buf_menu-user-call.userio-ai-read         = v-new-userio-ai-read
     6311                                                     - v-userio-ai-read
     6312           buf_menu-user-call.userio-ai-write        = v-new-userio-ai-write
     6313                                                     - v-userio-ai-write
     6314           buf_menu-user-call.userio-bi-read         = v-new-userio-bi-read
     6315                                                     - v-userio-bi-read
     6316           buf_menu-user-call.userio-bi-write        = v-new-userio-bi-write
     6317                                                     - v-userio-bi-write
     6318           buf_menu-user-call.userio-db-access       = v-new-userio-db-access
     6319                                                     - v-userio-db-access
     6320           buf_menu-user-call.userio-db-read         = v-new-userio-db-read
     6321                                                     - v-userio-db-read
     6322           buf_menu-user-call.userio-db-write        = v-new-userio-db-write
     6323                                                     - v-userio-db-write
     6324         .
     6325       end.
     6326     end.
     6327   END PROCEDURE.
     6328   PROCEDURE mainmenu_getcntxt :
     6329     define output parameter p-cntxt-db-num        as integer   no-undo .
     6330     define output parameter p-cntxt-user-id       as character no-undo .
     6331     define output parameter p-cntxt-level         as character no-undo .
     6332     define output parameter p-cntxt-host-code-obj as integer   no-undo .
     6333     define output parameter p-cntxt-obj-type      as character no-undo .
     6334     define output parameter p-cntxt-obj-code      as integer   no-undo .
     6335     define output parameter p-cntxt-db-num-obj    as integer   no-undo .
     6336     define output parameter p-cntxt-is-admin      as logical   no-undo .
     6337     do
     6338     on error undo, return error
     6339     :
     6340       assign
     6341         p-cntxt-db-num        = v-cntxt-db-num
     6342         p-cntxt-user-id       = v-cntxt-user-id
     6343         p-cntxt-level         = v-cntxt-level
     6344         p-cntxt-host-code-obj = v-cntxt-host-code-obj
     6345         p-cntxt-obj-type      = v-cntxt-obj-type
     6346         p-cntxt-obj-code      = v-cntxt-obj-code
     6347         p-cntxt-db-num-obj    = v-cntxt-db-num-obj
     6348         p-cntxt-is-admin      = v-cntxt-is-admin
     6349       .
     6350     end.
     6351   END PROCEDURE.
     6352   PROCEDURE menu-item-choose :
     6353       define variable v-procedure-parameter as character no-undo .
     6354       define variable v-load                as logical      no-undo.
     6355       define variable v-new                 as logical      no-undo.
     6356       define variable v-cur-date-error-code as integer      no-undo.
     6357       define buffer buf_menu-head    for ub.menu-head.
     6358   do
     6359   on error undo, return error return-value
     6360   :
     6361       run check-load-menu IN THIS-PROCEDURE
     6362           ( OUTPUT v-load
     6363           , output v-new
     6364           ) .
     6365       IF v-load = TRUE then do:
     6366           message
     6367               "Производится загрузка меню другим пользователем." SKIP
     6368               "Для корректной работы системы необходимо подождать."
     6369           view-as alert-box.
     6370           run waitfram-show in this-procedure ( input "Происходит загрузка меню. Ждите..." ).
     6371           REPEAT :
     6372               find first buf_menu-head
     6373               where buf_menu-head.menu-code = 0
     6374               exclusive-lock
     6375               no-error
     6376               no-wait
     6377               .
     6378               IF AVAILABLE buf_menu-head THEN DO:
     6379               run waitfram-hide in this-procedure .
     6380               release buf_menu-head.
     6381               run delete-dm-menu in this-procedure
     6382                   no-error .
     6383               run create-dm-menu in this-procedure
     6384                   no-error .
     6385               if error-status :error
     6386               then do:
     6387                   message
     6388                       vss-workfile vss-revision vss-description skip
     6389                       "Ошибка при создании меню" skip
     6390                       error-status :get-message(1) skip
     6391                       return-value skip
     6392                   view-as alert-box error .
     6393                   undo, return error return-value .
     6394               end.
     6395               RETURN.
     6396               END.
     6397               pause 10 no-message.
     6398           END.
     6399       end.
     6400       IF v-new then do:
     6401           message
     6402               "Другой пользователь произвел перезагрузку меню." SKIP
     6403               "Для корректной работы меню будет обновлено."
     6404           view-as alert-box.
     6405           run delete-dm-menu in this-procedure
     6406               no-error .
     6407           run create-dm-menu in this-procedure
     6408               no-error .
     6409           if error-status :error
     6410           then do:
     6411               message
     6412               vss-workfile vss-revision vss-description skip
     6413               "Ошибка при создании меню" skip
     6414               error-status :get-message(1) skip
     6415               return-value skip
     6416               view-as alert-box error .
     6417               undo, return error return-value .
     6418           end.
     6419           RETURN.
     6420       end.
     6421       if available temp-menu-item
     6422       then do:
     6423           case temp-menu-item.item-type
     6424           :
     6425               when 'm-i':U or
     6426               when 'm-t':U
     6427               then do:
     6428               if num-entries(temp-menu-item.item-procedure, chr(44)) > 2
     6429               then do:
     6430                   assign
     6431                   v-procedure-parameter = entry(3, temp-menu-item.item-procedure, chr(44))
     6432                   .
     6433               end.
     6434               else do:
     6435                   assign
     6436                   v-procedure-parameter = '':U
     6437                   .
     6438               end.
     6439               run dm-menu-choose-item in g#dm-menu-handle
     6440                   (input  temp-menu-item.item-type
     6441                   ,input  temp-menu-item.item-code
     6442                   ,input  entry(1, temp-menu-item.item-procedure, chr(44))
     6443                   ,input  entry(2, temp-menu-item.item-procedure, chr(44))
     6444                   ,input  v-procedure-parameter
     6445                   ) .
     6446               if temp-menu-item.item-type = 'm-t':U
     6447               then do:
     6448                   display
     6449                   get-display-name(buffer temp-menu-item) @ v-show-display-name
     6450                   with browse br-menu-item .
     6451               end.
     6452               end.
     6453               when 's-m':U
     6454               then do:
     6455               case temp-menu-item.show-child
     6456               :
     6457                   when '+':U
     6458                   then do:
     6459                   run menu-item-expand in this-procedure .
     6460                   end.
     6461                   when '-':U
     6462                   then do:
     6463                   run menu-item-collapse in this-procedure .
     6464                   end.
     6465                   otherwise do:
     6466                   message
     6467                       vss-workfile vss-revision vss-description skip
     6468                       "Внутренняя ошибка" skip
     6469                       "Неизвестное значение поля show-child" skip
     6470                       "temp-menu-item.show-child" temp-menu-item.show-child skip
     6471                       view-as alert-box error .
     6472                   end.
     6473               end case .
     6474               run mainmenu-menu-item-open in this-procedure
     6475                   (input  temp-menu-item.item-code
     6476                   ) .
     6477               end.
     6478           end case .
     6479       end.
     6480   end.
     6481   END PROCEDURE.
     6482   PROCEDURE menu-item-collapse :
     6483     define buffer buf_temp-menu-item-open for temp-menu-item-open .
     6484     do
     6485     on error undo, return error return-value
     6486     :
     6487       if  available temp-menu-item
     6488       and temp-menu-item.item-type = 's-m':U
     6489       and temp-menu-item.show-child = '-':U
     6490       then do:
     6491         assign
     6492           temp-menu-item.show-child = '+':U
     6493         .
     6494         find first buf_temp-menu-item-open
     6495           where buf_temp-menu-item-open.item-code = temp-menu-item.item-code
     6496           no-error .
     6497         if available buf_temp-menu-item-open
     6498         then do:
     6499           delete buf_temp-menu-item-open .
     6500         end.
     6501         run delete-menu-item in this-procedure
     6502           (input  temp-menu-item.item-code
     6503           ) .
     6504       end.
     6505     end.
     6506   END PROCEDURE.
     6507   PROCEDURE menu-item-copy-full-name :
     6508     define variable v-arm-title      as character no-undo .
     6509     do
     6510     on error undo, return error return-value
     6511     :
     6512       do with frame DEFAULT-FRAME
     6513       :
     6514         run gbl/clipbrd.p
     6515           (input  temp-menu-item.full-name
     6516           ) .
     6517       end.
     6518     end.
     6519   END PROCEDURE.
     6520   PROCEDURE menu-item-display-full-name :
     6521     do
     6522     on error undo, return error return-value
     6523     :
     6524       if available temp-menu-item
     6525       then do:
     6526         do with frame DEFAULT-FRAME
     6527         :
     6528           assign
     6529             ed-menu-item-name :screen-value = fi-menu-group-name + "/" + temp-menu-item.full-name
     6530           .
     6531         end.
     6532       end.
     6533     end.
     6534   END PROCEDURE.
     6535   PROCEDURE menu-item-expand :
     6536     define buffer buf_temp-menu-item-open for temp-menu-item-open .
     6537     do
     6538     on error undo, return error return-value
     6539     :
     6540       if  available temp-menu-item
     6541       and temp-menu-item.item-type = 's-m':U
     6542       and temp-menu-item.show-child = '+':U
     6543       then do:
     6544         assign
     6545           temp-menu-item.show-child = '-':U
     6546         .
     6547         find first buf_temp-menu-item-open
     6548           where buf_temp-menu-item-open.item-code = temp-menu-item.item-code
     6549           no-error .
     6550         if not available buf_temp-menu-item-open
     6551         then do:
     6552           create buf_temp-menu-item-open .
     6553           assign
     6554             buf_temp-menu-item-open.item-code = temp-menu-item.item-code
     6555           .
     6556         end.
     6557         run proc-create-menu-item in g#dm-menu-handle
     6558           (input  temp-menu-item.item-code
     6559           ,input  ?
     6560           ,input  false
     6561           ,input  true
     6562           ) .
     6563         run menu-item-expand-open in this-procedure
     6564           (input temp-menu-item.item-code
     6565           ) .
     6566       end.
     6567     end.
     6568   END PROCEDURE.
     6569   PROCEDURE menu-item-expand-open :
     6570     define input  parameter p-item-code as integer   no-undo .
     6571     define buffer buf_temp-menu-item for temp-menu-item .
     6572     define buffer buf_temp-menu-item-open for temp-menu-item-open .
     6573     do
     6574     on error undo, return error return-value
     6575     :
     6576       for each buf_temp-menu-item
     6577         where buf_temp-menu-item.parent-code = p-item-code
     6578       on error undo, return error return-value
     6579       :
     6580         find first buf_temp-menu-item-open
     6581           where buf_temp-menu-item-open.item-code = buf_temp-menu-item.item-code
     6582           no-error .
     6583         if  available buf_temp-menu-item-open
     6584         and buf_temp-menu-item.show-child = '+':U
     6585         then do:
     6586           assign
     6587             buf_temp-menu-item.show-child = '-':U
     6588           .
     6589           run proc-create-menu-item in g#dm-menu-handle
     6590             (input  buf_temp-menu-item.item-code
     6591             ,input  ?
     6592             ,input  false
     6593             ,input  true
     6594             ) .
     6595         end.
     6596         run menu-item-expand-open in this-procedure
     6597           (input buf_temp-menu-item.item-code
     6598           ) .
     6599       end.
     6600     end.
     6601   END PROCEDURE.
     6602   PROCEDURE menu-item-open-in-multiedit :
     6603     define variable v-ok          as logical   no-undo .
     6604     define buffer buf_menu-item for ub.menu-item .
     6605     do
     6606     on error undo, return error return-value
     6607     :
     6608       if  available temp-menu-item
     6609       and temp-menu-item.item-type <> 's-m':u
     6610       then do:
     6611         find first buf_menu-item no-lock
     6612           where buf_menu-item.item-code = temp-menu-item.item-code
     6613           no-error .
     6614         if not available buf_menu-item
     6615         then do:
     6616           message
     6617             "Не найден пункт меню с кодом" temp-menu-item.item-code skip
     6618             view-as alert-box error .
     6619           undo, return error return-value .
     6620         end.
     6621         assign
     6622           v-ok = true
     6623         .
     6624         message
     6625           "Открыть файл в multiedit" skip
     6626           "Код пункта меню" temp-menu-item.item-code skip
     6627           "Идентификатор пункта меню" buf_menu-item.item-id skip
     6628           "Процедура" temp-menu-item.item-procedure skip
     6629           "Продолжить?"
     6630           view-as alert-box question buttons yes-no update v-ok .
     6631         if v-ok = true
     6632         then do:
     6633           run utl/meopen.p
     6634             (input buf_menu-item.item-id
     6635             ,input temp-menu-item.item-procedure
     6636             ) .
     6637         end.
     6638       end.
     6639     end.
     6640   END PROCEDURE.
     6641   procedure proc-check-place-imp :
     6642     define buffer buf_place for ub.place .
     6643     define buffer buf_place-attr for ub.place-attr .
     6644     define buffer buf_pl-gds for ub.pl-gds .
     6645     define buffer buf_goods for ub.goods .
     6646     define variable v-pending-message as character no-undo .
     6647     define variable v-applied-message as character no-undo .
     6648     define variable v-ok-pending as logical no-undo .
     6649     define variable v-ok-applied as logical no-undo .
     6650     define variable v-place-mess as character no-undo .
     6651     assign
     6652       v-ok-pending = no
     6653       v-ok-applied = no
     6654       v-pending-message = "Внимание! После закрытия смены будет осуществлен переход на новые градуировочные таблицы для резервуаров:"
     6655       v-applied-message = "Внимание! Новые градуировочные таблицы применены для резервуаров:"
     6656     .
     6657     for each buf_place-attr no-lock where buf_place-attr.obj-type = v-cntxt-obj-type
     6658                                       and buf_place-attr.obj-code = v-cntxt-obj-code
     6659                                       and buf_place-attr.attr-code = "message-table-version"
     6660     :
     6661       find first buf_place no-lock where buf_place.obj-type = buf_place-attr.obj-type
     6662                                      and buf_place.obj-code = buf_place-attr.obj-code
     6663                                      and buf_place.pl-code  = buf_place-attr.pl-code
     6664                                      no-error .
     6665       find first buf_pl-gds no-lock where buf_pl-gds.obj-type = buf_place-attr.obj-type
     6666                                       and buf_pl-gds.obj-code = buf_place-attr.obj-code
     6667                                       and buf_pl-gds.pl-code  = buf_place-attr.pl-code
     6668                                       no-error .
     6669       if available buf_pl-gds
     6670       then do :
     6671         find first buf_goods no-lock where buf_goods.gds-code = buf_pl-gds.gds-code no-error .
     6672       end .
     6673       if buf_place-attr.attr-value = "pending"
     6674       then do :
     6675         assign
     6676           v-place-mess = "Резервуар " + (if available buf_place then buf_place.loc1 else "?") +
     6677                          " код " + string(buf_place-attr.pl-code) +
     6678                          " " + (if available buf_place then buf_place.pl-name else "") +
     6679                          " c " + (if available buf_goods then buf_goods.gds-name else "?")
     6680           v-ok-pending = yes
     6681           v-pending-message = v-pending-message + chr(10) + v-place-mess
     6682         .
     6683       end .
     6684       if buf_place-attr.attr-value = "applied"
     6685       then do :
     6686         assign
     6687           v-place-mess = "Резервуар " + (if available buf_place then buf_place.loc1 else "?") +
     6688                          " код " + string(buf_place-attr.pl-code) +
     6689                          " " + (if available buf_place then buf_place.pl-name else "") +
     6690                          " c " + (if available buf_goods then buf_goods.gds-name else "?")
     6691           v-ok-applied = yes
     6692           v-applied-message = v-applied-message + chr(10) + v-place-mess
     6693         .
     6694       end .
     6695     end .
     6696     if v-ok-pending
     6697     then do :
     6698       run ref/message_place-imp.w (input v-pending-message) .
     6699     end .
     6700     if v-ok-applied
     6701     then do :
     6702       run ref/message_place-imp.w (input v-applied-message) .
     6703     end .
     6704     for each buf_place-attr exclusive-lock where buf_place-attr.obj-type = v-cntxt-obj-type
     6705                                              and buf_place-attr.obj-code = v-cntxt-obj-code
     6706                                              and buf_place-attr.attr-code = "message-table-version"
     6707     :
     6708       delete buf_place-attr .
     6709     end .
     6710   end procedure .
     6711   procedure proc-check-RVD :
     6712     define buffer buf_place for ub.place .
     6713     define buffer buf_place-attr for ub.place-attr .
     6714     define buffer buf_clients-attr for ub.clients-attr .
     6715     define buffer buf_pl-gds for ub.pl-gds .
     6716     define buffer buf_goods for ub.goods .
     6717     define buffer buf_place-attr2 for ub.place-attr .
     6718     define variable v-message as character no-undo .
     6719     define variable v-attr-value as character no-undo .
     6720     define variable v-attr-type as character no-undo .
     6721     define variable v-ok as logical no-undo init no .
     6722     if v-cntxt-db-num = 0 then return .
     6723     find first buf_place-attr no-lock where buf_place-attr.obj-type = v-cntxt-obj-type
     6724                                         and buf_place-attr.obj-code = v-cntxt-obj-code
     6725                                         and buf_place-attr.attr-code = "place-need-RVD-rvs"
     6726                                         and logical(buf_place-attr.attr-value) = yes
     6727                                         no-error .
     6728     if available buf_place-attr
     6729     then do :
     6730       v-message = "Установлено разрешение РВД. Необходимо выполнить ручные замеры параметров НП и внести их в документ сверки. Резервуары и параметры, требующие ручных замеров:" + chr(10) .
     6731       for each buf_place-attr no-lock where buf_place-attr.obj-type = v-cntxt-obj-type
     6732                                         and buf_place-attr.obj-code = v-cntxt-obj-code
     6733                                         and buf_place-attr.attr-code = "place-need-RVD-rvs"
     6734                                         and logical(buf_place-attr.attr-value) = yes,
     6735       first buf_place no-lock where buf_place.obj-type = v-cntxt-obj-type
     6736                                 and buf_place.obj-code = v-cntxt-obj-code
     6737                                 and buf_place.pl-code = buf_place-attr.pl-code
     6738                                 and buf_place.status_ = "",
     6739       first buf_pl-gds no-lock where buf_pl-gds.obj-type = v-cntxt-obj-type
     6740                                  and buf_pl-gds.obj-code = v-cntxt-obj-code
     6741                                  and buf_pl-gds.pl-code = buf_place.pl-code,
     6742       first buf_goods no-lock where buf_goods.gds-code = buf_pl-gds.gds-code
     6743       :
     6744         if is-gas(buf_goods.gds-code) then next .
     6745         v-ok = yes .
     6746         v-message = v-message + " Резервуар " + buf_place.loc1 + " код " + string(buf_place.pl-code) + " " + buf_place.pl-name + " с " + buf_goods.gds-name + chr(10) .
     6747         for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = v-cntxt-obj-type
     6748                                             and buf_place-attr2.obj-code = v-cntxt-obj-code
     6749                                             and buf_place-attr2.pl-code  = buf_place.pl-code
     6750                                             and buf_place-attr2.attr-code = "place-rvd-dnsty"
     6751                                             and logical(buf_place-attr2.attr-value) = yes
     6752                                             :
     6753           v-message = v-message + "   - Плотность" + chr(10) .
     6754         end .
     6755         for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = v-cntxt-obj-type
     6756                                             and buf_place-attr2.obj-code = v-cntxt-obj-code
     6757                                             and buf_place-attr2.pl-code  = buf_place.pl-code
     6758                                             and buf_place-attr2.attr-code = "place-rvd-tmp"
     6759                                             and logical(buf_place-attr2.attr-value) = yes
     6760                                             :
     6761           v-message = v-message + "   - Температура" + chr(10) .
     6762         end .
     6763         for first buf_place-attr2 no-lock where buf_place-attr2.obj-type = v-cntxt-obj-type
     6764                                             and buf_place-attr2.obj-code = v-cntxt-obj-code
     6765                                             and buf_place-attr2.pl-code  = buf_place.pl-code
     6766                                             and buf_place-attr2.attr-code = "place-rvd-lvl"
     6767                                             and logical(buf_place-attr2.attr-value) = yes
     6768                                             :
     6769           v-message = v-message + "   - Уровень" + chr(10) .
     6770         end .
     6771       end .
     6772       if v-ok
     6773       then do :
     6774         message v-message view-as alert-box title "Внимание!" .
     6775       end .
     6776     end .
     6777   end procedure .
     6778   PROCEDURE proc-fi-close-date :
     6779   define output  parameter p-date as date      no-undo .
     6780   define variable v-value-character  as character no-undo .
     6781   define variable v-value-decimal    as decimal   no-undo .
     6782   define variable v-value-integer    as integer   no-undo .
     6783   define variable v-value-logical    as logical   no-undo .
     6784   define variable v-value-type       as character no-undo .
     6785   empty temp-table thbjattr_thbj-attr .
     6786   case v-cntxt-level :
     6787   when 'object':U then do:
     6788     run adm/shattri.p (
     6789          input "get":U
     6790         ,input v-cntxt-obj-type
     6791         ,input v-cntxt-obj-code
     6792         ,input 'nakl_par':U
     6793         ,input  "date-close-period"
     6794         ,output v-value-character
     6795         ,output p-date
     6796         ,output v-value-decimal
     6797         ,output v-value-integer
     6798         ,output v-value-logical
     6799         ,output v-value-type
     6800         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6801         ) no-error .
     6802   end.
     6803   when 'firm':U then do:
     6804     run adm/shattri.p (
     6805          input "get":U
     6806         ,input 'орг':U
     6807         ,input v-cntxt-host-code-obj
     6808         ,input 'nakl_par':U
     6809         ,input  "date-close-period"
     6810         ,output v-value-character
     6811         ,output p-date
     6812         ,output v-value-decimal
     6813         ,output v-value-integer
     6814         ,output v-value-logical
     6815         ,output v-value-type
     6816         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6817         ) no-error .
     6818   end.
     6819   when 'global':U then do:
     6820     run adm/shattri.p (
     6821          input "get":U
     6822         ,input ""
     6823         ,input 0
     6824         ,input 'nakl_par':U
     6825         ,input  "date-close-period"
     6826         ,output v-value-character
     6827         ,output p-date
     6828         ,output v-value-decimal
     6829         ,output v-value-integer
     6830         ,output v-value-logical
     6831         ,output v-value-type
     6832         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6833         ) no-error .
     6834   end.
     6835   end case.
     6836   if error-status :error then message
     6837     error-status :get-message(1) skip
     6838     return-value skip
     6839     "Ошибка"
     6840     view-as alert-box error
     6841   .
     6842   END PROCEDURE.
     6843   PROCEDURE run-help :
     6844     APPLY "HELP":U TO FRAME DEFAULT-FRAME.
     6845   END PROCEDURE.
     6846   PROCEDURE search-bar-code :
     6847     define variable varresult   as character                no-undo.
