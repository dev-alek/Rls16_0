     1605   PROCEDURE OpenFile EXTERNAL "kernel32.dll" :
     1606       DEFINE INPUT PARAMETER lpszFileName as MEMPTR .
     1607       DEFINE INPUT-OUTPUT PARAMETER lpOpenBuff as MEMPTR .
     1608       DEFINE INPUT PARAMETER fuMode as SHORT.
     1609       DEFINE RETURN PARAMETER RetValue as SHORT .
     1610   END PROCEDURE .
     1611   on "ALT-F10":U of frame DEFAULT-FRAME anywhere
