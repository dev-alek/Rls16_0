     5006         create buf_temp-image . assign buf_temp-image.image-code = 16 buf_temp-image.image-handle = image-16 :handle .
     5007         create buf_temp-image . assign buf_temp-image.image-code = 17 buf_temp-image.image-handle = image-17 :handle .
     5008         create buf_temp-image . assign buf_temp-image.image-code = 18 buf_temp-image.image-handle = image-18 :handle .
     5009         create buf_temp-image . assign buf_temp-image.image-code = 19 buf_temp-image.image-handle = image-19 :handle .
     5010         create buf_temp-image . assign buf_temp-image.image-code = 20 buf_temp-image.image-handle = image-20 :handle .
     5011         create buf_temp-image . assign buf_temp-image.image-code = 21 buf_temp-image.image-handle = image-21 :handle .
     5012         create buf_temp-image . assign buf_temp-image.image-code = 22 buf_temp-image.image-handle = image-22 :handle .
     5013         create buf_temp-image . assign buf_temp-image.image-code = 23 buf_temp-image.image-handle = image-23 :handle .
     5014         create buf_temp-image . assign buf_temp-image.image-code = 24 buf_temp-image.image-handle = image-24 :handle .
     5015         create buf_temp-image . assign buf_temp-image.image-code = 25 buf_temp-image.image-handle = image-25 :handle .
     5016         create buf_temp-image . assign buf_temp-image.image-code = 26 buf_temp-image.image-handle = image-26 :handle .
     5017         create buf_temp-image . assign buf_temp-image.image-code = 27 buf_temp-image.image-handle = image-27 :handle .
     5018         create buf_temp-image . assign buf_temp-image.image-code = 28 buf_temp-image.image-handle = image-28 :handle .
     5019         create buf_temp-image . assign buf_temp-image.image-code = 29 buf_temp-image.image-handle = image-29 :handle .
     5020         create buf_temp-image . assign buf_temp-image.image-code = 30 buf_temp-image.image-handle = image-30 :handle .
     5021         create buf_temp-image . assign buf_temp-image.image-code = 31 buf_temp-image.image-handle = image-31 :handle .
     5022         create buf_temp-image . assign buf_temp-image.image-code = 32 buf_temp-image.image-handle = image-32 :handle .
     5023         create buf_temp-image . assign buf_temp-image.image-code = 33 buf_temp-image.image-handle = image-33 :handle .
     5024         create buf_temp-image . assign buf_temp-image.image-code = 34 buf_temp-image.image-handle = image-34 :handle .
     5025         create buf_temp-image . assign buf_temp-image.image-code = 35 buf_temp-image.image-handle = image-35 :handle .
