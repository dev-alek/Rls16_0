     3335     )  no-error.
     3336     if error-status :error
     3337     then do:
     3338       message
     3339         vss-workfile vss-revision vss-description skip
     3340         "Ошибка при вызове процедуры mainmenu-disp-mutable" skip
     3341         error-status :get-message(1) skip
     3342         return-value skip
     3343         view-as alert-box error .
     3344       undo, return error return-value .
     3345     end.
     3346     if transaction = true
     3347     then do:
     3348       message
     3349         vss-workfile vss-revision vss-description skip
     3350         "Активна транзакция" skip
     3351         "В главном окне не должно быть активной транзакции" skip
     3352         "Невозможно продолжить работу системы" skip
     3353         view-as alert-box error .
     3354       undo, return error return-value .
     3355     end.
     3356     run diasize_init in this-procedure .
     3357     run load-tnved in this-procedure .
     3358     run ver-movepar in this-procedure .
     3359     if not this-procedure:persistent
     3360     then do:
     3361       wait-for close of this-procedure.
     3362     end.
     3363     os-delete value( string(v-cntxt-report-num) + ".srt" ) .
     3364     os-delete value( string(v-cntxt-report-num) + ".whr" ) .
     3365     os-delete value( "tmp_" + string(v-cntxt-report-num) + ".xml" ) .
     3366     define variable v-out-dir as character no-undo .
     3367     get-key-value section 'kassa-ibm':U key 'out':U value v-out-dir .
     3368     if v-out-dir <> ? then do:
     3369       if  substring(v-out-dir, length(v-out-dir), 1) <> '/':U
     3370       and substring(v-out-dir, length(v-out-dir), 1) <> '\':U
     3371       then do:
     3372         assign
     3373           v-out-dir = v-out-dir + '/':U
     3374         .
     3375       end.
     3376       define buffer buf_scales for ub.scales .
     3377       for each buf_scales no-lock
     3378         where buf_scales.db-num = v-cntxt-db-num
     3379       on error undo, next
     3380       :
     3381         os-delete value( v-out-dir + 'plu':U + string(v-cntxt-report-num) +
     3382                         '.':U + string(buf_scales.scales-num, '999':U ) ) .
     3383       end.
     3384     end.
     3385     define variable RetOpenFile     as integer   no-undo .
     3386     define variable lp_filename     as memptr    no-undo .
     3387     define variable lp_openbuff     as memptr    no-undo .
     3388     define variable Mode            as integer   no-undo .
     3389     assign
     3390       Mode                    = 512
     3391       set-size( lp_FileName ) = 128
     3392       set-size( lp_OpenBuff ) = 288
     3393     .
     3394     if  get-size( lp_FileName ) <> 0
     3395     and get-size( lp_OpenBuff ) <> 0
     3396     then do:
     3397       assign
     3398         put-string( lp_FileName, 1 ) = string( session:temp-directory
     3399                                             + "rpt" + string( v-cntxt-report-num ) )
     3400       .
     3401       run openfile
     3402         (input lp_filename
     3403         ,input-output lp_openbuff
     3404         ,input mode
     3405         ,output retopenfile
     3406         ) .
     3407       assign
     3408         put-string( lp_FileName, 1 ) = string( session:temp-directory
     3409                                             + "plt" + string( v-cntxt-report-num )
     3410                                             )
     3411       .
     3412       run openfile
     3413         (input lp_filename
     3414         ,input-output lp_openbuff
     3415         ,input mode
     3416         ,output retopenfile
     3417         ) .
     3418       assign
     3419         set-size( lp_OpenBuff ) = 0
     3420         set-size( lp_FileName ) = 0
     3421       .
     3422     end.
     3423     run delete-dm-menu in this-procedure
     3424       no-error .
     3425   END.
     3426   PROCEDURE bc-brief :
     3427     define input parameter v-bar-code as integer   no-undo .
     3428     define variable v-r-b-abbr   as character no-undo .
     3429     define variable v-doc-num    as character no-undo .
     3430     define variable v-price-sale as decimal   no-undo .
     3431     define variable v-road-tax   as decimal   no-undo .
     3432     define variable v-excise     as decimal   no-undo .
     3433     define variable v-fact-qnty  as decimal   no-undo .
     3434     define variable v-qnty-type  as character no-undo .
     3435     define variable v-qnty-recid as recid     no-undo .
     3436     define buffer buf_bar-code for ub.bar-code .
     3437     define buffer buf_goods    for ub.goods .
     3438     do
     3439     on error undo, return error return-value
     3440     :
     3441       assign
     3442         fi-gds-artic      = '':U
     3443         fi-gds-name       = '':U
     3444         fi-gds-qnty       = '':U
     3445         fi-gds-price-sale = '':U
     3446       .
     3447       find buf_bar-code no-lock
     3448         where buf_bar-code.b-code = v-bar-code
     3449         no-error .
     3450       if available buf_bar-code
     3451       then do:
     3452         find buf_goods no-lock
     3453           where buf_goods.gds-code = buf_bar-code.gds-code
     3454           no-error .
     3455         if available buf_goods
     3456         then do:
     3457           assign
     3458             fi-gds-artic = substitute('&1 &2 &3':U
     3459                                      ,buf_goods.artic
     3460                                      ,buf_goods.prod-type
     3461                                      ,buf_goods.prod-code
     3462                                      )
     3463             fi-gds-name  = buf_goods.gds-name
     3464           .
     3465         end.
     3466         if v-cntxt-level = 'object':U
     3467         then do:
     3468   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     3470     (input  v-cntxt-host-code-obj
     3471     ,output v-r-b-abbr
     3472     )  .
     3473   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3475     (input  v-cntxt-obj-type
     3476     ,input  v-cntxt-obj-code
     3477     ,input  buf_bar-code.b-code
     3478     ,input  0
     3479     ,input  0
     3480     ,output v-doc-num
     3481     ,output v-price-sale
     3482     ,output v-road-tax
     3483     ,output v-excise
     3484     )  .
     3485   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeqnt in g#library
     3487     (input  v-cntxt-obj-type
     3488     ,input  v-cntxt-obj-code
     3489     ,input  buf_bar-code.b-code
     3490     ,input  0
     3491     ,output v-fact-qnty
     3492     ,output v-qnty-type
     3493     ,output v-qnty-recid
     3494     )  .
     3495           assign
     3496             fi-gds-price-sale = substitute('&1 &2'
     3497                                           ,v-price-sale
     3498                                           ,v-r-b-abbr
     3499                                           )
     3500             fi-gds-qnty       = substitute('&1 &2'
     3501                                           ,v-fact-qnty
     3502                                           ,buf_goods.unit-base
     3503                                           )
     3504           .
     3505         end.
     3506       end.
     3507       do with frame DEFAULT-FRAME:
     3508          assign
     3509            fi-gds-artic     :screen-value = fi-gds-artic
     3510            fi-gds-name      :screen-value = fi-gds-name
     3511            fi-gds-qnty      :screen-value = fi-gds-qnty
     3512            fi-gds-price-sale:screen-value = fi-gds-price-sale
     3513            fi-gds-artic     :visible      = yes
     3514            fi-gds-name      :visible      = yes
     3515            fi-gds-qnty      :visible      = yes
     3516            fi-gds-price-sale:visible      = yes
     3517            .
     3518        end.
     3519     end.
     3520   END PROCEDURE.
     3521   PROCEDURE check-load-menu :
     3522   define output parameter p-locked as logical no-undo .
     3523   define output parameter p-new    as logical no-undo .
     3524   define buffer buf_menu-head for ub.menu-head .
     3525   do
     3526   on error undo, return error
     3527   :
     3528       find first buf_menu-head
     3529            where buf_menu-head.menu-code = 0
     3530            exclusive-lock
     3531            no-error
     3532            no-wait
     3533            .
     3534       if not available buf_menu-head
     3535       AND locked buf_menu-head then do:
     3536            assign
     3537               p-locked = TRUE
     3538            .
     3539       end.
     3540       ELSE do:
     3541         IF v-menu-control-number <> buf_menu-head.control-number then do:
     3542            assign
     3543               p-new = TRUE
     3544            .
     3545         end.
     3546       END.
     3547   end.
     3548   END PROCEDURE.
