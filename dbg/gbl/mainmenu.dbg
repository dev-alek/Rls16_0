     3063       run db-attr-value in this-procedure ( input v-cntxt-db-num
     3064                                             , input 'mess-id-video':U
     3065                                             , output v-db-attr-value
     3066                                             , output v-db-attr-type
     3067                                             ) no-error .
     3068       assign
