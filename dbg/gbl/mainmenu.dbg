     1695   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1696   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1697   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1698   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1699   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1700   define variable v-diasize-current-frame-height as decimal   no-undo .
     1701   define variable v-diasize-change-size          as logical   no-undo .
     1702   define variable v-diasize-resize-button        as handle    no-undo .
     1703   define variable v-diasize-wndmax               as logical   no-undo .
     1704   define variable v-diasize-wndstore             as logical   no-undo .
     1705   define variable v-diasize-proc-name            as character no-undo .
     1706   define variable v-diasize-browse-handle        as handle    no-undo .
     1707   define variable v-diasize-browse-number        as integer   no-undo .
     1708   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1709   define temp-table temp-diasize-handle no-undo
     1710     field handle-value  as handle
     1711     field save-position as decimal
     1712     index xpk is primary unique handle-value
     1713     .
     1714   define temp-table temp-browse-handle no-undo
     1715     field browse-type   as character
     1716     field browse-number as integer
     1717     field browse-handle as handle
     1718     field original-size as decimal
     1719     index xpk is primary unique browse-type browse-number
     1720     index xie browse-type browse-handle
     1721   .
     1722   procedure diasize_change-height :
     1723     define input  parameter p-change-value  as decimal   no-undo .
     1724     define input  parameter p-move-resize   as logical   no-undo .
     1725     define variable v-field-group-handle    as handle    no-undo .
     1726     define variable v-object-handle         as handle    no-undo .
     1727     define variable v-frame-height          as decimal   no-undo .
     1728     define variable v-frame-virtual-height  as decimal   no-undo .
     1729     define variable v-browse-height         as decimal   no-undo .
     1730     define variable v-window-height         as decimal   no-undo .
     1731     define variable v-window-virtual-height as decimal   no-undo .
     1732     define variable v-change-sign           as integer   no-undo .
     1733     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1734     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1735     if p-change-value > 0
     1736     then do:
     1737       if frame DEFAULT-FRAME :height + p-change-value
     1738           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1739       then do:
     1740         assign
     1741           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1742                           - (frame DEFAULT-FRAME :height-chars)
     1743         .
     1744         if p-change-value <= 0
     1745         then do:
     1746           run diasize_position-resize-button in this-procedure .
     1747           return .
     1748         end.
     1749       end.
     1750     end.
     1751     if p-change-value < 0
     1752     then do:
     1753       if frame DEFAULT-FRAME :height + p-change-value < v-diasize-orig-frame-height
     1754       then do:
     1755         assign
     1756           p-change-value = v-diasize-orig-frame-height
     1757                          - (frame DEFAULT-FRAME :height-chars)
     1758         .
     1759         if p-change-value >= 0
     1760         then do:
     1761           run diasize_position-resize-button in this-procedure .
     1762           return .
     1763         end.
     1764       end.
     1765     end.
     1766     if p-change-value >= 0
     1767     then do:
     1768       assign
     1769         v-change-sign = 1
     1770       .
     1771     end.
     1772     else do:
     1773       assign
     1774         v-change-sign = -1
     1775       .
     1776     end.
     1777     assign
     1778       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1779     .
     1780     if p-change-value = 0
     1781     then do:
     1782       run diasize_position-resize-button in this-procedure .
     1783       return .
     1784     end.
     1785     move_block:
     1786     do
     1787     on error undo move_block, retry move_block
     1788     :
     1789       if retry
     1790       then do:
     1791         do
     1792         on error undo move_block, leave move_block
     1793         :
     1794           if p-change-value > 0
     1795           then do:
     1796             for each buf_temp-diasize-handle
     1797             on error undo, next
     1798             :
     1799               assign
     1800                 v-object-handle = buf_temp-diasize-handle.handle-value
     1801               .
     1802               if v-object-handle <> v-diasize-resize-button
     1803               then do:
     1804                 assign
     1805                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1806                 .
     1807               end.
     1808             end.
     1809             assign
     1810               v-diasize-browse-handle :height = v-browse-height
     1811             .
     1812             for each buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type = 'height':u
     1814             on error undo, next
     1815             :
     1816               assign
     1817                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1818               .
     1819             end.
     1820             assign
     1821               frame DEFAULT-FRAME :height = v-frame-height
     1822             .
     1823             if frame DEFAULT-FRAME :scrollable = true
     1824             then do:
     1825               assign
     1826                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
     1827               .
     1828             end.
     1829             assign
     1830               C-Win :height = v-window-height
     1831               C-Win :virtual-height = v-window-virtual-height
     1832             .
     1833             run diasize_position-resize-button in this-procedure .
     1834           end.
     1835           else do:
     1836             assign
     1837               C-Win :virtual-height = v-window-virtual-height
     1838               C-Win :height = v-window-height
     1839             .
     1840             if frame DEFAULT-FRAME :scrollable = true
     1841             then do:
     1842               assign
     1843                 frame DEFAULT-FRAME :virtual-height = v-frame-virtual-height
     1844               .
     1845             end.
     1846             assign
     1847               frame DEFAULT-FRAME :height = v-frame-height
     1848             .
     1849             assign
     1850               v-diasize-browse-handle :height = v-browse-height
     1851             .
     1852             for each buf_temp-browse-handle
     1853               where buf_temp-browse-handle.browse-type = 'height':u
     1854             on error undo, next
     1855             :
     1856               assign
     1857                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1858               .
     1859             end.
     1860             for each buf_temp-diasize-handle
     1861             on error undo, next
     1862             :
     1863               assign
     1864                 v-object-handle = buf_temp-diasize-handle.handle-value
     1865               .
     1866               if v-object-handle <> v-diasize-resize-button
     1867               then do:
     1868                 assign
     1869                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1870                 .
     1871               end.
     1872             end.
     1873             run diasize_position-resize-button in this-procedure .
     1874           end.
     1875           assign
     1876             v-diasize-change-size = false
     1877           .
     1878           leave move_block .
     1879         end.
     1880       end.
     1881       assign
     1882         v-diasize-need-full-display = true
     1883       .
     1884       if v-diasize-change-size = false
     1885       then do:
     1886         assign
     1887           v-diasize-change-size = true
     1888         .
     1889       end.
     1890       else do:
     1891         return .
     1892       end.
     1893       assign
     1894         v-frame-height = frame DEFAULT-FRAME :height
     1895         v-frame-virtual-height = frame DEFAULT-FRAME :virtual-height
     1896         v-browse-height = v-diasize-browse-handle :height
     1897       .
     1898       assign
     1899         v-window-height = C-Win :height
     1900         v-window-virtual-height = C-Win :virtual-height
     1901       .
     1902       for each buf_temp-browse-handle
     1903         where buf_temp-browse-handle.browse-type = 'height':u
     1904       :
     1905         assign
     1906           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1907         .
     1908       end.
     1909       for each buf_temp-diasize-handle
     1910       :
     1911         delete buf_temp-diasize-handle .
     1912       end.
     1913       assign
     1914         v-field-group-handle = frame DEFAULT-FRAME :first-child
     1915       .
     1916       do while valid-handle(v-field-group-handle)
     1917       :
     1918         assign
     1919           v-object-handle = v-field-group-handle :first-child
     1920         .
     1921         do while valid-handle(v-object-handle)
     1922         :
     1923           if  v-object-handle <> v-diasize-browse-handle :handle
     1924           and can-query(v-object-handle, "row")
     1925           and can-query(v-object-handle, "height")
     1926           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1927           then do:
     1928             find first buf_temp-browse-handle
     1929               where buf_temp-browse-handle.browse-type   = 'height':u
     1930                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1931               no-error .
     1932             if available buf_temp-browse-handle
     1933             then do:
     1934             end.
     1935             else do:
     1936               create buf_temp-diasize-handle .
     1937               assign
     1938                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1939                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1940               .
     1941             end.
     1942           end.
     1943           assign
     1944             v-object-handle = v-object-handle :next-sibling
     1945           .
     1946         end.
     1947         assign
     1948           v-field-group-handle = v-field-group-handle :next-sibling
     1949         .
     1950       end.
     1951       do with frame DEFAULT-FRAME
     1952       :
     1953         hide v-diasize-resize-button .
     1954         assign
     1955           v-diasize-resize-button :row    = 1
     1956           v-diasize-resize-button :column = 1
     1957         .
     1958       end.
     1959       if p-change-value > 0
     1960       then do:
     1961         assign
     1962           C-Win :virtual-height = C-Win :virtual-height + p-change-value
     1963         no-error .
     1964         if error-status :error
     1965         or error-status :get-message(1) <> ""
     1966         then do:
     1967           undo move_block, retry move_block .
     1968         end.
     1969         assign
     1970           C-Win :height = C-Win :height + p-change-value
     1971         no-error .
     1972         if error-status :error
     1973         or error-status :get-message(1) <> ""
     1974         then do:
     1975           undo move_block, retry move_block .
     1976         end.
     1977         if frame DEFAULT-FRAME :scrollable = true
     1978         then do:
     1979           assign
     1980             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     1981             no-error .
     1982           if error-status :error
     1983           or error-status :get-message(1) <> ""
     1984           then do:
     1985             undo move_block, retry move_block .
     1986           end.
     1987         end.
     1988         assign
     1989           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     1990           no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block .
     1995         end.
     1996         assign
     1997           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1998           no-error .
     1999         if error-status :error
     2000         or error-status :get-message(1) <> ""
     2001         then do:
     2002           undo move_block, retry move_block .
     2003         end.
     2004         for each buf_temp-browse-handle
     2005           where buf_temp-browse-handle.browse-type = 'height':u
     2006         on error undo move_block, retry move_block
     2007         :
     2008           assign
     2009             buf_temp-browse-handle.browse-handle :height
     2010               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2011             no-error .
     2012           if error-status :error
     2013           or error-status :get-message(1) <> ""
     2014           then do:
     2015             undo move_block, retry move_block .
     2016           end.
     2017         end.
     2018         for each buf_temp-diasize-handle
     2019         on error undo move_block, retry move_block
     2020         :
     2021           assign
     2022             v-object-handle = buf_temp-diasize-handle.handle-value
     2023           .
     2024           if v-object-handle <> v-diasize-resize-button
     2025           then do:
     2026             assign
     2027               v-object-handle :row = v-object-handle :row + p-change-value
     2028               no-error .
     2029             if error-status :error
     2030             or error-status :get-message(1) <> ""
     2031             then do:
     2032               undo move_block, retry move_block .
     2033             end.
     2034           end.
     2035         end.
     2036       end.
     2037       else do:
     2038         for each buf_temp-diasize-handle
     2039         on error undo move_block, retry move_block
     2040         :
     2041           assign
     2042             v-object-handle = buf_temp-diasize-handle.handle-value
     2043           .
     2044           if v-object-handle <> v-diasize-resize-button
     2045           then do:
     2046             assign
     2047               v-object-handle :row = v-object-handle :row + p-change-value
     2048               no-error .
     2049             if error-status :error
     2050             or error-status :get-message(1) <> ""
     2051             then do:
     2052               undo move_block, retry move_block .
     2053             end.
     2054           end.
     2055         end.
     2056         assign
     2057           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2058           no-error .
     2059         if error-status :error
     2060         or error-status :get-message(1) <> ""
     2061         then do:
     2062           undo move_block, retry move_block .
     2063         end.
     2064         for each buf_temp-browse-handle
     2065           where buf_temp-browse-handle.browse-type = 'height':u
     2066         on error undo move_block, retry move_block
     2067         :
     2068           assign
     2069             buf_temp-browse-handle.browse-handle :height
     2070               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2071             no-error .
     2072           if error-status :error
     2073           or error-status :get-message(1) <> ""
     2074           then do:
     2075             undo move_block, retry move_block .
     2076           end.
     2077         end.
     2078         assign
     2079           frame DEFAULT-FRAME :height = frame DEFAULT-FRAME :height + p-change-value
     2080           no-error .
     2081         if error-status :error
     2082         or error-status :get-message(1) <> ""
     2083         then do:
     2084           undo move_block, retry move_block .
     2085         end.
     2086         if frame DEFAULT-FRAME :scrollable = true
     2087         then do:
     2088           assign
     2089             frame DEFAULT-FRAME :virtual-height = frame DEFAULT-FRAME :virtual-height + p-change-value
     2090             no-error .
     2091           if error-status :error
     2092           or error-status :get-message(1) <> ""
     2093           then do:
     2094             undo move_block, retry move_block .
     2095           end.
     2096         end.
     2097         assign
     2098           C-Win :height = C-Win :height + p-change-value
     2099         no-error .
     2100         if error-status :error
     2101         or error-status :get-message(1) <> ""
     2102         then do:
     2103           undo move_block, retry move_block .
     2104         end.
     2105         assign
     2106           C-Win :virtual-height = C-Win :virtual-height + p-change-value
     2107         no-error .
     2108         if error-status :error
     2109         or error-status :get-message(1) <> ""
     2110         then do:
     2111           undo move_block, retry move_block .
     2112         end.
     2113       end.
     2114       if p-move-resize = true
     2115       then do:
     2116         run diasize_position-resize-button in this-procedure .
     2117       end.
     2118       if v-diasize-wndstore = true
     2119       then do:
     2120         if connected("ub") = true
     2121         then do:
     2122           define variable v-cntxt-db-num        as integer   no-undo .
     2123           define variable v-cntxt-userid        as character no-undo .
     2124           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2125                                             , OUTPUT v-cntxt-userid
     2126                                             ) .
     2127           run gbl/wndsizew.p
     2128             (input  v-cntxt-db-num
     2129             ,input  v-cntxt-userid
     2130             ,input  v-diasize-proc-name
     2131             ,input  'height':u
     2132             ,input  string(frame DEFAULT-FRAME :height - v-diasize-orig-frame-height)
     2133             ) .
     2134         end.
     2135       end.
     2136     end.
     2137     assign
     2138       v-diasize-change-size = false
     2139     .
     2140   end procedure.
     2141   procedure diasize_set-height :
     2142     define input  parameter p-new-height  as decimal   no-undo .
     2143     define input  parameter p-move-resize as logical   no-undo .
     2144     do
     2145     on error undo, return error return-value
     2146     :
     2147       run diasize_change-height in this-procedure
     2148         (input  (p-new-height - frame DEFAULT-FRAME :height)
     2149         ,input  p-move-resize
     2150         ) .
     2151     end.
     2152   end procedure.
     2153   procedure diasize_change-width :
     2154     define input  parameter p-change-value as decimal   no-undo .
     2155     define input  parameter p-move-resize  as logical   no-undo .
     2156     define variable v-field-group-handle   as handle    no-undo .
     2157     define variable v-object-handle        as handle    no-undo .
     2158     define variable v-frame-width          as decimal   no-undo .
     2159     define variable v-frame-virtual-width  as decimal   no-undo .
     2160     define variable v-browse-width         as decimal   no-undo .
     2161     define variable v-window-width         as decimal   no-undo .
     2162     define variable v-window-virtual-width as decimal   no-undo .
     2163     define variable v-change-sign          as integer   no-undo .
     2164     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2165     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2166     if p-change-value > 0
     2167     then do:
     2168       if frame DEFAULT-FRAME :width + p-change-value >
     2169           session :width-chars
     2170       then do:
     2171         assign
     2172           p-change-value = session :width-chars - frame DEFAULT-FRAME :width
     2173         .
     2174         if p-change-value <= 0
     2175         then do:
     2176           run diasize_position-resize-button in this-procedure .
     2177           return .
     2178         end.
     2179       end.
     2180     end.
     2181     if p-change-value < 0
     2182     then do:
     2183       if frame DEFAULT-FRAME :width + p-change-value < v-diasize-orig-frame-width
     2184       then do:
     2185         assign
     2186           p-change-value = v-diasize-orig-frame-width
     2187                          - frame DEFAULT-FRAME :width
     2188         .
     2189         if p-change-value >= 0
     2190         then do:
     2191           run diasize_position-resize-button in this-procedure .
     2192           return .
     2193         end.
     2194       end.
     2195     end.
     2196     if p-change-value >= 0
     2197     then do:
     2198       assign
     2199         v-change-sign = 1
     2200       .
     2201     end.
     2202     else do:
     2203       assign
     2204         v-change-sign = -1
     2205       .
     2206     end.
     2207     assign
     2208       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2209     .
     2210     if p-change-value = 0
     2211     then do:
     2212       run diasize_position-resize-button in this-procedure .
     2213       return .
     2214     end.
     2215     move_block:
     2216     do
     2217     on error undo move_block, leave move_block
     2218     :
     2219       if retry
     2220       then do:
     2221         do
     2222         on error undo move_block, leave move_block
     2223         :
     2224           if p-change-value > 0
     2225           then do:
     2226             for each buf_temp-diasize-handle
     2227             on error undo, next
     2228             :
     2229               assign
     2230                 v-object-handle = buf_temp-diasize-handle.handle-value
     2231               .
     2232               if v-object-handle <> v-diasize-resize-button
     2233               then do:
     2234                 assign
     2235                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2236                 .
     2237               end.
     2238             end.
     2239             assign
     2240               v-diasize-browse-handle :width = v-browse-width
     2241             .
     2242             for each buf_temp-browse-handle
     2243               where buf_temp-browse-handle.browse-type = 'width':u
     2244             on error undo, next
     2245             :
     2246               assign
     2247                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2248               .
     2249             end.
     2250             assign
     2251               frame DEFAULT-FRAME :width = v-frame-width
     2252             .
     2253             if frame DEFAULT-FRAME :scrollable = true
     2254             then do:
     2255               assign
     2256                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     2257               .
     2258             end.
     2259             assign
     2260               C-Win :width = v-window-width
     2261               C-Win :virtual-width = v-window-virtual-width
     2262             .
     2263             run diasize_position-resize-button in this-procedure .
     2264           end.
     2265           else do:
     2266             assign
     2267               C-Win :virtual-width = v-window-virtual-width
     2268               C-Win :width = v-window-width
     2269             .
     2270             if frame DEFAULT-FRAME :scrollable = true
     2271             then do:
     2272               assign
     2273                 frame DEFAULT-FRAME :virtual-width = v-frame-virtual-width
     2274               .
     2275             end.
     2276             assign
     2277               frame DEFAULT-FRAME :width = v-frame-width
     2278             .
     2279             for each buf_temp-browse-handle
     2280               where buf_temp-browse-handle.browse-type = 'width':u
     2281             on error undo, next
     2282             :
     2283               assign
     2284                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2285               .
     2286             end.
     2287             assign
     2288               v-diasize-browse-handle :width = v-browse-width
     2289             .
     2290             for each buf_temp-diasize-handle
     2291             on error undo, next
     2292             :
     2293               assign
     2294                 v-object-handle = buf_temp-diasize-handle.handle-value
     2295               .
     2296               if v-object-handle <> v-diasize-resize-button
     2297               then do:
     2298                 assign
     2299                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2300                 .
     2301               end.
     2302             end.
     2303             run diasize_position-resize-button in this-procedure .
     2304           end.
     2305           assign
     2306             v-diasize-change-size = false
     2307           .
     2308           leave move_block .
     2309         end.
     2310       end.
     2311       assign
     2312         v-diasize-need-full-display = true
     2313       .
     2314       if v-diasize-change-size = false
     2315       then do:
     2316         assign
     2317           v-diasize-change-size = true
     2318         .
     2319       end.
     2320       else do:
     2321         return .
     2322       end.
     2323       assign
     2324         v-frame-width = frame DEFAULT-FRAME :width
     2325         v-frame-virtual-width = frame DEFAULT-FRAME :virtual-width
     2326         v-browse-width = v-diasize-browse-handle :width
     2327       .
     2328       assign
     2329         v-window-width = C-Win :width
     2330         v-window-virtual-width = C-Win :virtual-width
     2331       .
     2332       for each buf_temp-browse-handle
     2333         where buf_temp-browse-handle.browse-type = 'width':u
     2334       :
     2335         assign
     2336           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2337         .
     2338       end.
     2339       for each buf_temp-diasize-handle
     2340       :
     2341         delete buf_temp-diasize-handle .
     2342       end.
     2343       assign
     2344         v-field-group-handle = frame DEFAULT-FRAME :first-child
     2345       .
     2346       do while valid-handle(v-field-group-handle)
     2347       :
     2348         assign
     2349           v-object-handle = v-field-group-handle :first-child
     2350         .
     2351         do while valid-handle(v-object-handle)
     2352         :
     2353           if  v-object-handle <> v-diasize-browse-handle :handle
     2354           and v-object-handle <> v-diasize-resize-button
     2355           and can-query(v-object-handle, "row")
     2356           and can-query(v-object-handle, "height")
     2357           and ( v-object-handle :col + v-object-handle :width
     2358                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2359               )
     2360           then do:
     2361             find first buf_temp-browse-handle
     2362               where buf_temp-browse-handle.browse-type   = 'width':u
     2363                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2364               no-error .
     2365             if available buf_temp-browse-handle
     2366             then do:
     2367             end.
     2368             else do:
     2369               create buf_temp-diasize-handle .
     2370               assign
     2371                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2372                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2373               .
     2374             end.
     2375           end.
     2376           assign
     2377             v-object-handle = v-object-handle :next-sibling
     2378           .
     2379         end.
     2380         assign
     2381           v-field-group-handle = v-field-group-handle :next-sibling
     2382         .
     2383       end.
     2384       do with frame DEFAULT-FRAME
     2385       :
     2386         hide v-diasize-resize-button .
     2387         v-diasize-resize-button :row = 1.
     2388         v-diasize-resize-button :column = 1.
     2389       end.
     2390       if p-change-value > 0
     2391       then do:
     2392         assign
     2393           C-Win :virtual-width = C-Win :virtual-width + p-change-value
     2394         no-error .
     2395         if error-status :error
     2396         or error-status :get-message(1) <> ""
     2397         then do:
     2398           undo move_block, retry move_block .
     2399         end.
     2400         assign
     2401           C-Win :width = C-Win :width + p-change-value
     2402         no-error .
     2403         if error-status :error
     2404         or error-status :get-message(1) <> ""
     2405         then do:
     2406           undo move_block, retry move_block .
     2407         end.
     2408         if frame DEFAULT-FRAME :scrollable = true
     2409         then do:
     2410           assign
     2411             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     2412             no-error .
     2413           if error-status :error
     2414           or error-status :get-message(1) <> ""
     2415           then do:
     2416             undo move_block, retry move_block.
     2417           end.
     2418         end.
     2419         assign
     2420           frame DEFAULT-FRAME :width = v-frame-width + p-change-value
     2421           no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         assign
     2428           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2429         no-error .
     2430         if error-status :error
     2431         or error-status :get-message(1) <> ""
     2432         then do:
     2433           undo move_block, retry move_block.
     2434         end.
     2435         for each buf_temp-browse-handle
     2436           where buf_temp-browse-handle.browse-type = 'width':u
     2437         on error undo move_block, retry move_block
     2438         :
     2439           assign
     2440             buf_temp-browse-handle.browse-handle :width
     2441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2442             no-error .
     2443           if error-status :error
     2444           or error-status :get-message(1) <> ""
     2445           then do:
     2446             undo move_block, retry move_block .
     2447           end.
     2448         end.
     2449         for each buf_temp-diasize-handle
     2450         on error undo move_block, retry move_block
     2451         :
     2452           assign
     2453             v-object-handle = buf_temp-diasize-handle.handle-value
     2454           .
     2455           if v-object-handle <> v-diasize-resize-button
     2456           then do:
     2457             assign
     2458               v-object-handle :col = v-object-handle :col + p-change-value
     2459               no-error .
     2460             if error-status :error
     2461             or error-status :get-message(1) <> ""
     2462             then do:
     2463               undo move_block, retry move_block .
     2464             end.
     2465           end.
     2466         end.
     2467       end.
     2468       else do:
     2469         for each buf_temp-diasize-handle
     2470         on error undo move_block, retry move_block
     2471         :
     2472           assign
     2473             v-object-handle = buf_temp-diasize-handle.handle-value
     2474           .
     2475           if v-object-handle <> v-diasize-resize-button
     2476           then do:
     2477             assign
     2478               v-object-handle :col = v-object-handle :col + p-change-value
     2479               no-error .
     2480             if error-status :error
     2481             or error-status :get-message(1) <> ""
     2482             then do:
     2483               undo move_block, retry move_block .
     2484             end.
     2485           end.
     2486         end.
     2487         for each buf_temp-browse-handle
     2488           where buf_temp-browse-handle.browse-type = 'width':u
     2489         on error undo move_block, retry move_block
     2490         :
     2491           assign
     2492             buf_temp-browse-handle.browse-handle :width
     2493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2494             no-error .
     2495           if error-status :error
     2496           or error-status :get-message(1) <> ""
     2497           then do:
     2498             undo move_block, retry move_block .
     2499           end.
     2500         end.
     2501         assign
     2502           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2503           no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         assign
     2510           frame DEFAULT-FRAME :width = frame DEFAULT-FRAME :width + p-change-value
     2511         no-error .
     2512         if error-status :error
     2513         or error-status :get-message(1) <> ""
     2514         then do:
     2515           undo move_block, retry move_block.
     2516         end.
     2517         if frame DEFAULT-FRAME :scrollable = true
     2518         then do:
     2519           assign
     2520             frame DEFAULT-FRAME :virtual-width = frame DEFAULT-FRAME :virtual-width + p-change-value
     2521           no-error .
     2522           if error-status :error
     2523           or error-status :get-message(1) <> ""
     2524           then do:
     2525             undo move_block, retry move_block.
     2526           end.
     2527         end.
     2528         assign
     2529           C-Win :width = C-Win :width + p-change-value
     2530         no-error .
     2531         if error-status :error
     2532         or error-status :get-message(1) <> ""
     2533         then do:
     2534           undo move_block, retry move_block .
     2535         end.
     2536         assign
     2537           C-Win :virtual-width = C-Win :virtual-width + p-change-value
     2538         no-error .
     2539         if error-status :error
     2540         or error-status :get-message(1) <> ""
     2541         then do:
     2542           undo move_block, retry move_block .
     2543         end.
     2544       end.
     2545       if p-move-resize
     2546       then do:
     2547         run diasize_position-resize-button in this-procedure .
     2548       end.
     2549       if v-diasize-wndstore = true
     2550       then do:
     2551         if connected("ub") = true
     2552         then do:
     2553           define variable v-cntxt-db-num        as integer   no-undo .
     2554           define variable v-cntxt-userid        as character no-undo .
     2555           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2556                                             , OUTPUT v-cntxt-userid
     2557                                             ) .
     2558           run gbl/wndsizew.p
     2559             (input  v-cntxt-db-num
     2560             ,input  v-cntxt-userid
     2561             ,input  v-diasize-proc-name
     2562             ,input  'width':u
     2563             ,input  string(frame DEFAULT-FRAME :width - v-diasize-orig-frame-width)
     2564             ) .
     2565         end.
     2566       end.
     2567     end.
     2568     assign
     2569       v-diasize-change-size = false
     2570     .
     2571   end procedure.
     2572   procedure diasize_set-width :
     2573     define input  parameter p-new-width  as decimal   no-undo .
     2574     define input  parameter p-move-resize as logical   no-undo .
     2575     do
     2576     on error undo, return error return-value
     2577     :
     2578       run diasize_change-width in this-procedure
     2579         (input  (p-new-width - frame DEFAULT-FRAME :width)
     2580         ,input  p-move-resize
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_position-resize-button :
     2585     do with frame DEFAULT-FRAME
     2586     :
     2587       hide v-diasize-resize-button .
     2588       assign
     2589         v-diasize-resize-button :row = frame DEFAULT-FRAME :height - v-diasize-resize-button :height
     2590                     - 1
     2591                     - (frame DEFAULT-FRAME :border-bottom-pixels / session :pixels-per-row)
     2592         v-diasize-resize-button :col = frame DEFAULT-FRAME :width - v-diasize-resize-button :width
     2593                     - 1
     2594                     - (frame DEFAULT-FRAME :border-right-pixels / session :pixels-per-column)
     2595       .
     2596       view v-diasize-resize-button .
     2597     end.
     2598   end procedure.
     2599   on alt-right anywhere
     2600   do:
     2601     run diasize_change-width in this-procedure
     2602       (input 1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-left anywhere
     2608   do:
     2609     run diasize_change-width in this-procedure
     2610       (input -1
     2611       ,input true
     2612       ) .
     2613     return no-apply .
     2614   end.
     2615   on alt-down anywhere
     2616   do:
     2617     run diasize_change-height in this-procedure
     2618       (input 1
     2619       ,input true
     2620       ) .
     2621     return no-apply .
     2622   end.
     2623   on alt-up anywhere
     2624   do:
     2625     run diasize_change-height in this-procedure
     2626       (input -1
     2627       ,input true
     2628       ) .
     2629     return no-apply .
     2630   end.
     2631   on alt-enter of frame DEFAULT-FRAME
     2632   do:
     2633     run diasize_maximize in this-procedure
     2634       (input  ?
     2635       ).
     2636     return no-apply .
     2637   end.
     2638   procedure diasize_end-move :
     2639     do
     2640     on error undo, return error return-value
     2641     :
     2642       define variable v-row-delta as decimal   no-undo .
     2643       define variable v-col-delta as decimal   no-undo .
     2644       define variable v-new-row as decimal   no-undo .
     2645       define variable v-new-col as decimal   no-undo .
     2646       assign
     2647         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2648         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2649       .
     2650       assign
     2651         v-row-delta = v-new-row - frame DEFAULT-FRAME :height
     2652         v-col-delta = v-new-col - frame DEFAULT-FRAME :width
     2653       .
     2654       run diasize_change-height in this-procedure
     2655         (input v-row-delta
     2656         ,input true
     2657         ) .
     2658       run diasize_change-width in this-procedure
     2659         (input v-col-delta
     2660         ,input true
     2661         ) .
     2662     end.
     2663   end procedure.
     2664   procedure diasize_maximize :
     2665     define input  parameter p-action as logical   no-undo .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       if p-action = ?
     2670       then do:
     2671         if v-diasize-need-maximize = true
     2672         then do:
     2673           assign
     2674             p-action = true
     2675           .
     2676         end.
     2677         else do:
     2678           assign
     2679             p-action = false
     2680           .
     2681         end.
     2682       end.
     2683       if p-action = true
     2684       then do:
     2685         run diasize_change-height in this-procedure
     2686           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2687               - frame DEFAULT-FRAME :height-chars
     2688           ,input true
     2689           ) .
     2690         run diasize_change-width in this-procedure
     2691           (input session :width-chars
     2692               - frame DEFAULT-FRAME :width-chars
     2693           ,input true
     2694           ) .
     2695         assign
     2696           v-diasize-need-maximize = false
     2697         .
     2698       end.
     2699       else do:
     2700         run diasize_change-width in this-procedure
     2701           (input v-diasize-orig-frame-width
     2702               - frame DEFAULT-FRAME :width-chars
     2703           ,input true
     2704           ) .
     2705         run diasize_change-height in this-procedure
     2706           (input v-diasize-orig-frame-height
     2707               - frame DEFAULT-FRAME :height-chars
     2708           ,input true
     2709           ) .
     2710         assign
     2711           v-diasize-need-maximize = true
     2712         .
     2713       end.
     2714     end.
     2715   end procedure.
     2716   procedure diasize_restore-orig-size :
     2717     do
     2718     on error undo, return error return-value
     2719     :
     2720       assign
     2721         v-diasize-current-frame-width  = frame DEFAULT-FRAME :width
     2722         v-diasize-current-frame-height = frame DEFAULT-FRAME :height
     2723       .
     2724       run diasize_set-height in this-procedure
     2725         (input  v-diasize-orig-frame-height
     2726         ,input  true
     2727         ) .
     2728       run diasize_set-width in this-procedure
     2729         (input  v-diasize-orig-frame-width
     2730         ,input  true
     2731         ) .
     2732     end.
     2733   end procedure.
     2734   procedure diasize_restore-current-size :
     2735     do
     2736     on error undo, return error return-value
     2737     :
     2738       run diasize_set-height in this-procedure
     2739         (input  v-diasize-current-frame-height
     2740         ,input  true
     2741         ) .
     2742       run diasize_set-width in this-procedure
     2743         (input  v-diasize-current-frame-width
     2744         ,input  true
     2745         ) .
     2746     end.
     2747   end procedure.
     2748   procedure diasize_set-browse-handle :
     2749     define input  parameter p-browse-handle as handle   no-undo .
     2750     define buffer buf_temp-browse-handle for temp-browse-handle .
     2751     do
     2752     on error undo, return error return-value
     2753     :
     2754       assign
     2755         v-diasize-browse-handle = p-browse-handle
     2756       .
     2757       for each buf_temp-browse-handle
     2758       on error undo, return error return-value
     2759       :
     2760         delete buf_temp-browse-handle .
     2761       end.
     2762     end.
     2763   end procedure.
     2764   procedure diasize_add_browse :
     2765     define input  parameter p-browse-type   as character no-undo .
     2766     define input  parameter p-browse-handle as handle    no-undo .
     2767     define buffer buf_temp-browse-handle for temp-browse-handle .
     2768     do
     2769     on error undo, return error return-value
     2770     :
     2771       assign
     2772         v-diasize-browse-number = v-diasize-browse-number + 1
     2773       .
     2774       create buf_temp-browse-handle .
     2775       assign
     2776         buf_temp-browse-handle.browse-type   = p-browse-type
     2777         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2778         buf_temp-browse-handle.browse-handle = p-browse-handle
     2779       .
     2780     end.
     2781   end procedure.
     2782   procedure diasize_init :
     2783     define variable v-default-value    as logical   no-undo .
     2784     define variable v-restore-saved    as logical   no-undo .
     2785     define variable v-resize-value-str as character no-undo .
     2786     do
     2787     on error undo, return error return-value
     2788     :
     2789       do with frame DEFAULT-FRAME
     2790       :
     2791         assign
     2792           v-diasize-orig-frame-height = frame DEFAULT-FRAME :height
     2793           v-diasize-orig-frame-width  = frame DEFAULT-FRAME :width
     2794           v-diasize-browse-handle     = br-menu-item :handle
     2795         .
     2796         create button v-diasize-resize-button
     2797         assign
     2798           parent        = frame DEFAULT-FRAME :first-child
     2799           label         = "s"
     2800           height-pixels = 16
     2801           width-pixels  = 16
     2802           visible       = true
     2803           sensitive     = true
     2804           movable       = true
     2805           triggers:
     2806             on end-move persistent run diasize_end-move in this-procedure .
     2807           end triggers.
     2808         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2809         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2810         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2811         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2812         assign
     2813           v-diasize-wndmax = false
     2814         .
     2815         if connected("ub") = true
     2816         then do:
     2817           define variable v-cntxt-db-num        as integer   no-undo .
     2818           define variable v-cntxt-userid        as character no-undo .
     2819           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2820                                             , OUTPUT v-cntxt-userid
     2821                                             ) .
     2822           run gbl/wndpar_r.p
     2823             (input  v-cntxt-db-num
     2824             ,input  v-cntxt-userid
     2825             ,input  'wndmax':U
     2826             ,output v-diasize-wndmax
     2827             ,output v-default-value
     2828             ) .
     2829         end.
     2830         assign
     2831           v-diasize-wndstore = false
     2832         .
     2833         if connected("ub") = true
     2834         then do:
     2835           run gbl/wndpar_r.p
     2836             (input  v-cntxt-db-num
     2837             ,input  v-cntxt-userid
     2838             ,input  'wndstore':U
     2839             ,output v-diasize-wndstore
     2840             ,output v-default-value
     2841             ) .
     2842         end.
     2843         assign
     2844           v-diasize-proc-name = entry(1, program-name(2), '.')
     2845         .
     2846         if v-diasize-wndstore = true
     2847         then do:
     2848           assign
     2849             v-restore-saved = false
     2850           .
     2851           if connected("ub") = true
     2852           then do:
     2853             run gbl/wndsizer.p
     2854               (input  v-cntxt-db-num
     2855               ,input  v-cntxt-userid
     2856               ,input  v-diasize-proc-name
     2857               ,input  'height':u
     2858               ,output v-resize-value-str
     2859               ) .
     2860             if v-resize-value-str <> '':U
     2861             then do:
     2862               run diasize_change-height in this-procedure
     2863                 (input  integer(v-resize-value-str)
     2864                 ,input  true
     2865                 ) .
     2866               assign
     2867                 v-restore-saved = true
     2868               .
     2869             end.
     2870           end.
     2871           if connected("ub") = true
     2872           then do:
     2873             run gbl/wndsizer.p
     2874               (input  v-cntxt-db-num
     2875               ,input  v-cntxt-userid
     2876               ,input  v-diasize-proc-name
     2877               ,input  'width':u
     2878               ,output v-resize-value-str
     2879               ) .
     2880             if v-resize-value-str <> '':U
     2881             then do:
     2882               run diasize_change-width in this-procedure
     2883                 (input  integer(v-resize-value-str)
     2884                 ,input  true
     2885                 ) .
     2886               assign
     2887                 v-restore-saved = true
     2888               .
     2889             end.
     2890           end.
     2891           if v-restore-saved <> true
     2892           then do:
     2893             if v-diasize-wndmax = true
     2894             then do:
     2895               run diasize_maximize in this-procedure
     2896                 (input  true
     2897                 ) .
     2898             end.
     2899           end.
     2900         end.
     2901         else do:
     2902           if v-diasize-wndmax = true
     2903           then do:
     2904             run diasize_maximize in this-procedure
     2905               (input  true
     2906               ) .
     2907           end.
     2908         end.
     2909       end.
     2910     end.
     2911   end procedure.
     2912   procedure diasize_need-full-display :
     2913     define output parameter p-need-full-display as logical   no-undo .
     2914     do
     2915     on error undo, return error return-value
     2916     :
     2917       assign
     2918         p-need-full-display = v-diasize-need-full-display
     2919       .
     2920       assign
     2921         v-diasize-need-full-display = false
     2922       .
     2923     end.
     2924   end procedure.
     2925   procedure get-context :
     2926      define output parameter p-db-num as integer          no-undo.
     2927      define output parameter p-user-id as character        no-undo.
     2928      define variable v-login               as character    no-undo.
     2929      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2930      define buffer buf_user-login  for ub.user-login .
     2931      do
     2932      on error undo, return error
     2933      :
     2934            FIND FIRST buf_sys-ctrl no-lock.
     2935            ASSIGN
     2936               v-login = USERID("ub")
     2937               p-db-num = buf_sys-ctrl.db-num
     2938            .
     2939            FIND FIRST buf_user-login
     2940                 WHERE buf_user-login.db-num = p-db-num
     2941                   AND buf_user-login.user-login = v-login
     2942                 no-lock
     2943                 no-error
     2944                 .
     2945            IF AVAILABLE buf_user-login
     2946            THEN DO:
     2947               assign
     2948                  p-user-id = buf_user-login.user-id
     2949               .
     2950            END.
     2951      end.
     2952   end procedure.
     2953   on "CTRL-K":U anywhere do:
     2954     run gbl/hotkey.p
     2955       (input "calc":U
     2956       ,input focus
     2957       ).
     2958   end.
     2959   ON +, CURSOR-RIGHT OF br-menu-item IN FRAME DEFAULT-FRAME
     2960   DO:
     2961     run menu-item-expand in this-procedure .
     2962     run mainmenu-menu-item-open in this-procedure
     2963       (input  temp-menu-item.item-code
     2964       ) .
     2965     return no-apply.
     2966   END.
     2967   ON -, CURSOR-LEFT OF br-menu-item IN FRAME DEFAULT-FRAME
     2968   DO:
     2969     define buffer buf_temp-menu-item for temp-menu-item .
     2970     if  available temp-menu-item
     2971     and ( temp-menu-item.item-type = 'm-i':U
     2972           or
     2973           (temp-menu-item.item-type = 's-m':U
     2974            and
     2975            temp-menu-item.show-child = '+':U
     2976           )
     2977         )
     2978     then do:
     2979       find first buf_temp-menu-item
     2980         where buf_temp-menu-item.item-code = temp-menu-item.parent-code
     2981         no-error .
     2982       if available buf_temp-menu-item
     2983       then do:
     2984         reposition br-menu-item to rowid rowid(buf_temp-menu-item) .
     2985       end.
     2986     end.
     2987     run menu-item-collapse in this-procedure .
     2988     run mainmenu-menu-item-open in this-procedure
     2989       (input  temp-menu-item.item-code
     2990       ) .
     2991     return no-apply.
     2992   END.
     2993   on close of this-procedure
     2994       do:
     2995   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2996     (input  'is-cctv'
     2997     ,input  ''
     2998     ,input  ''
     2999     ,input  0
     3000     ,input  ''
     3001     ,input  ''
     3002     ,input  ''
     3003     ,input  no
     3004     ,output par-is-cctv
     3005     ,output par-type
     3006     ) no-error .
     3007           is-cctv = lookup(par-is-cctv, "true,yes":U) > 0 .
     3008           if is-cctv then
     3009           do:
     3010               v-vid-param =
     3011                   "SHOP_NUM=" + string(v-cntxt-obj-code) + chr(4) +
     3012                   "Login=" + fi-user-login + chr(4) +
     3013                   "THname=" + fi-nickname .
     3014       run db-attr-value in this-procedure ( input v-cntxt-db-num
     3015                                             , input 'mess-id-video':U
     3016                                             , output v-db-attr-value
     3017                                             , output v-db-attr-type
     3018                                             ) no-error .
     3019       assign
     3020         v-mess-id = integer (v-db-attr-value) no-error.
     3021       if v-mess-id = ?
     3022         then v-mess-id = 0.
     3023       v-vid-param = v-vid-param + chr(4) +
     3024        "MESSAGE_ID=" + string (v-mess-id)
     3025       .
     3026       v-mess-id = v-mess-id + 1.
     3027       run db-attr-write in this-procedure ( input v-cntxt-db-num
     3028                                           , input 'mess-id-video':U
     3029                                           , input string (v-mess-id)
     3030                                           ) no-error .
     3031               run trg/video-action.p (input 63,
     3032                   input v-vid-param,
     3033                   output v-vid-ok,
     3034                   output v-vid-mes) .
     3035           end.
     3036           run disable_ui .
     3037       end.
     3038   on window-close of C-Win
     3039   do:
     3040     apply 'close':U to this-procedure .
     3041   end.
     3042   on endkey, end-error of C-Win anywhere
     3043       do:
     3044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3045     (input  'is-cctv'
     3046     ,input  ''
     3047     ,input  ''
     3048     ,input  0
     3049     ,input  ''
     3050     ,input  ''
     3051     ,input  ''
     3052     ,input  no
     3053     ,output par-is-cctv
     3054     ,output par-type
     3055     ) no-error .
     3056           is-cctv = lookup(par-is-cctv, "true,yes":U) > 0 .
     3057           if is-cctv then
     3058           do:
     3059               v-vid-param =
     3060                   "SHOP_NUM=" + string(v-cntxt-obj-code) + chr(4) +
