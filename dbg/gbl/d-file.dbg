        1   block-level on error undo, throw.
        2   define input-output parameter p-file-id           as character no-undo .
        3   define input-output parameter p-file-directory    as character no-undo .
        4   define input        parameter p-filter-names      as character no-undo .
        5   define input        parameter p-filter-values     as character no-undo .
        6   define input        parameter p-filter-delimiter  as character no-undo .
        7   define input        parameter p-default-extension as character no-undo .
        8   define input        parameter p-must-exist        as logical   no-undo .
        9   define input        parameter p-save-as           as logical   no-undo .
       10   define input        parameter p-use-filename      as logical   no-undo .
       11   define input        parameter p-title             as character no-undo .
       12   define output       parameter p-choose            as logical   no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: d-file.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/d-file.p $":U .
       18   define variable vss-description as character no-undo init "Äטאכמד גûבמנא פאיכא גגמהא ט גûגמהא   ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define variable v-filter-name as character no-undo extent 10 .
       78   define variable v-filter-value as character no-undo extent 10 .
       79   DEFINE VARIABLE ii as integer no-undo .
       80   do ii = 1 to num-entries(p-filter-names, p-filter-delimiter):
       81     assign
       82     v-filter-name[ii] = entry(ii, p-filter-names, p-filter-delimiter)
       83     v-filter-value[ii] = entry(ii, p-filter-values, p-filter-delimiter)
       84     no-error.
       85   end.
       86   if p-must-exist then do:
       87     if p-save-as then do:
       88       if p-use-filename then do:
       89         SYSTEM-DIALOG GET-FILE p-file-id
       90         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
       91         INITIAL-FILTER 1
       92         ASK-OVERWRITE
       93         DEFAULT-EXTENSION p-default-extension
       94         INITIAL-DIR p-file-directory
       95         MUST-EXIST
       96         SAVE-AS
       97         TITLE p-title
       98         USE-FILENAME
       99         UPDATE p-choose .
      100       end.
      101       else do:
      102         SYSTEM-DIALOG GET-FILE p-file-id
      103         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      104         INITIAL-FILTER 1
      105         ASK-OVERWRITE
      106         DEFAULT-EXTENSION p-default-extension
      107         INITIAL-DIR p-file-directory
      108         MUST-EXIST
      109         SAVE-AS
      110         TITLE p-title
      111         UPDATE p-choose .
      112       end.
      113     end.
      114     else do:
      115       if p-use-filename then do:
      116         SYSTEM-DIALOG GET-FILE p-file-id
      117         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      118         INITIAL-FILTER 1
      119         ASK-OVERWRITE
      120         DEFAULT-EXTENSION p-default-extension
      121         INITIAL-DIR p-file-directory
      122         MUST-EXIST
      123         TITLE p-title
      124         USE-FILENAME
      125         UPDATE p-choose .
      126       end.
      127       else do:
      128         SYSTEM-DIALOG GET-FILE p-file-id
      129         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      130         INITIAL-FILTER 1
      131         ASK-OVERWRITE
      132         DEFAULT-EXTENSION p-default-extension
      133         INITIAL-DIR p-file-directory
      134         MUST-EXIST
      135         TITLE p-title
      136         UPDATE p-choose .
      137       end.
      138     end.
      139   end.
      140   else do:
      141     if p-save-as then do:
      142       if p-use-filename then do:
      143         SYSTEM-DIALOG GET-FILE p-file-id
      144         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      145         INITIAL-FILTER 1
      146         ASK-OVERWRITE
      147         DEFAULT-EXTENSION p-default-extension
      148         INITIAL-DIR p-file-directory
      149         SAVE-AS
      150         TITLE p-title
      151         USE-FILENAME
      152         UPDATE p-choose .
      153       end.
      154       else do:
      155         SYSTEM-DIALOG GET-FILE p-file-id
      156         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      157         INITIAL-FILTER 1
      158         ASK-OVERWRITE
      159         DEFAULT-EXTENSION p-default-extension
      160         INITIAL-DIR p-file-directory
      161         SAVE-AS
      162         TITLE p-title
      163         UPDATE p-choose .
      164       end.
      165     end.
      166     else do:
      167       if p-use-filename then do:
      168         SYSTEM-DIALOG GET-FILE p-file-id
      169         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      170         INITIAL-FILTER 1
      171         ASK-OVERWRITE
      172         DEFAULT-EXTENSION p-default-extension
      173         INITIAL-DIR p-file-directory
      174         TITLE p-title
      175         USE-FILENAME
      176         UPDATE p-choose .
      177       end.
      178       else do:
      179         SYSTEM-DIALOG GET-FILE p-file-id
      180         filters v-filter-name[1] v-filter-value[1] ,                   v-filter-name[2] v-filter-value[2] ,                   v-filter-name[3] v-filter-value[3] ,                   v-filter-name[4] v-filter-value[4] ,                   v-filter-name[5] v-filter-value[5] ,                   v-filter-name[6] v-filter-value[6] ,                   v-filter-name[7] v-filter-value[7] ,                   v-filter-name[8] v-filter-value[8] ,                   v-filter-name[9] v-filter-value[9] ,                   v-filter-name[10] v-filter-value[10]
      181         INITIAL-FILTER 1
      182         ASK-OVERWRITE
      183         DEFAULT-EXTENSION p-default-extension
      184         INITIAL-DIR p-file-directory
      185         TITLE p-title
      186         UPDATE p-choose .
      187       end.
      188     end.
      189   end.
      190   if not p-choose then do:
      191     assign
      192       p-file-id = ''
      193     .
      194   end.
