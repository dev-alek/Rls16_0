        1   block-level on error undo, throw.
        2   define input parameter wh as widget-handle.
        3   define input parameter wh-1 as widget-handle.
        4   define input parameter l-r as logical.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: frcclick.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/frcclick.p $":U .
       10   define variable vss-description as character no-undo init "Имитировать нажатие мыши".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
       71      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
       72   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       74     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       75   FUNCTION GetLastError
       76            RETURNS INTEGER
       77            ()
       78            IN hpWinFunc.
       79   FUNCTION GetParent
       80            RETURNS INTEGER
       81            (input hwnd as INTEGER)
       82            IN hpWinFunc.
       83   FUNCTION ShowLastError
       84            RETURNS INTEGER
       85            ()
       86            IN hpWinFunc.
       87   FUNCTION CreateProcess
       88            RETURNS INTEGER
       89            (input CommandLine as CHAR,
       90             input CurrentDir  as CHAR,
       91             input wShowWindow as INTEGER)
       92            in hpWinFunc.
       93   do
       94   on error undo, return error return-value
       95   :
       96     run MouseCursor in this-procedure
       97       (input wh
       98       ,input WH-1
       99       ).
      100     run Apply-mouse-menu-click in this-procedure
      101       (input wh
      102       ).
      103     return.
      104   end.
      105   PROCEDURE MouseCursor:
      106      DEFINE INPUT PARAMETER  p-wh   AS WIDGET-HANDLE  NO-UNDO.
      107      DEFINE INPUT PARAMETER  p-wh-1   AS WIDGET-HANDLE  NO-UNDO.
      108      define variable lppoint     AS MEMPTR  NO-UNDO.
      109      define variable ReturnValue AS INTEGER NO-UNDO.
      110      SET-SIZE(lppoint)= 2 * 4.
      111    IF P-WH-1 = ? THEN DO:
      112         PUT-long(lppoint,1 + 0 * 4)=INTEGER(p-wh:WIDTH-PIXELS / 2).
      113         PUT-long(lppoint,1 + 1 * 4)=INTEGER(p-wh:HEIGHT-PIXELS / 2).
      114     END.
      115     ELSE DO:
      116         PUT-long(lppoint,1 + 0 * 4)=INTEGER(P-WH-1:x + p-wh-1:WIDTH-PIXELS / 2).
      117         PUT-long(lppoint,1 + 1 * 4)=INTEGER(P-WH-1:y - p-wh-1:HEIGHT-PIXELS / 2).
      118     END.
      119      RUN ClientToScreen in hpApi (INPUT p-wh:HWND,
      120                                   INPUT GET-POINTER-VALUE(lppoint),
      121                                   OUTPUT ReturnValue).
      122      RUN SetCursorPos in hpApi   (INPUT GET-long(lppoint,1 + 0 * 4),
      123                                   INPUT GET-long(lppoint,1 + 1 * 4),
      124                                   OUTPUT ReturnValue).
      125      SET-SIZE(lppoint)= 0.
      126      END PROCEDURE.
      127   PROCEDURE Apply-mouse-menu-click:
      128      DEFINE INPUT PARAMETER  p-wh   AS WIDGET-HANDLE  NO-UNDO.
      129      define variable ReturnValue AS INTEGER NO-UNDO.
      130      RUN SendMessageA in hpApi (INPUT p-wh:HWND,
      131                                    INPUT (if l-r then 516 else 513),
      132                                    INPUT (if l-r then 2 else 1),
      133                                    INPUT 0,
      134                                    OUTPUT ReturnValue).
      135      RUN SendMessageA in hpApi (INPUT p-wh:HWND,
      136                                    INPUT (if l-r then 517 else 514),
      137                                    INPUT 0,
      138                                    INPUT 0,
      139                                    OUTPUT ReturnValue).
      140   END PROCEDURE.
