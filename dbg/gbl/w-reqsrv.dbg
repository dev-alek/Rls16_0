        1   CREATE WIDGET-POOL.
        2   define input  parameter p-user-login    as character no-undo .
        3   define input  parameter p-user-password as character no-undo .
        4   define input  parameter p-auto-start    as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Окно запуска сервера обработки запросов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   procedure sys-time_get-sys :
      116     define output parameter p-year         as integer   no-undo .
      117     define output parameter p-month        as integer   no-undo .
      118     define output parameter p-day          as integer   no-undo .
      119     define output parameter p-hour         as integer   no-undo .
      120     define output parameter p-minute       as integer   no-undo .
      121     define output parameter p-second       as integer   no-undo .
      122     define output parameter p-milliseconds as integer   no-undo .
      123     define variable v-system-time-structure as memptr    no-undo.
      124     do
      125     on error undo, return error return-value
      126     :
      127       assign
      128         set-size(v-system-time-structure) = 16
      129       .
      130       run GetSystemTime
      131         (input  get-pointer-value(v-system-time-structure)
      132         ) .
      133       assign
      134         p-year         = get-short(v-system-time-structure,  1)
      135         p-month        = get-short(v-system-time-structure,  3)
      136         p-day          = get-short(v-system-time-structure,  7)
      137         p-hour         = get-short(v-system-time-structure,  9)
      138         p-minute       = get-short(v-system-time-structure, 11)
      139         p-second       = get-short(v-system-time-structure, 13)
      140         p-milliseconds = get-short(v-system-time-structure, 15)
      141       .
      142       assign
      143         set-size(v-system-time-structure) = 0
      144       .
      145     end.
      146   end procedure.
      147   procedure sys-time_get-comp-user-name :
      148     define output parameter p-computer-name as character no-undo .
      149     define output parameter p-user-name     as character no-undo .
      150     define output parameter p-process-pid   as integer   no-undo .
      151     define variable v-return-value  as integer   no-undo .
      152     define variable v-buffer-length as integer   no-undo .
      153     define variable v-buffer-memptr as memptr    no-undo .
      154     do
      155     on error undo, return error return-value
      156     :
      157       assign
      158         v-buffer-length = 1024
      159         set-size(v-buffer-memptr) = v-buffer-length + 4
      160       .
      161       assign
      162         put-long(v-buffer-memptr, 1) = v-buffer-length
      163       .
      164       run GetComputerNameA
      165         (input  get-pointer-value(v-buffer-memptr) + 4
      166         ,input  get-pointer-value(v-buffer-memptr)
      167         ,output v-return-value
      168         ) .
      169       if v-return-value <> 0
      170       then do:
      171         assign
      172           p-computer-name = get-string(v-buffer-memptr, 5)
      173         .
      174       end.
      175       assign
      176         put-long(v-buffer-memptr, 1) = v-buffer-length
      177       .
      178       run GetUserNameA
      179         (input  get-pointer-value(v-buffer-memptr) + 4
      180         ,input  get-pointer-value(v-buffer-memptr)
      181         ,output v-return-value
      182         ) .
      183       if v-return-value <> 0
      184       then do:
      185         assign
      186           p-user-name = get-string(v-buffer-memptr, 5)
      187         .
      188       end.
      189       run GetCurrentProcessId
      190         (output p-process-pid
      191         ) .
      192       assign
      193         set-size(v-buffer-memptr) = 0
      194       .
      195     end.
      196   end procedure.
      197   procedure sys-time_get-http :
      198     define output parameter p-http-time as character no-undo .
      199     define variable v-year         as integer   no-undo .
      200     define variable v-month        as integer   no-undo .
      201     define variable v-day-of-week  as integer   no-undo .
      202     define variable v-day          as integer   no-undo .
      203     define variable v-hour         as integer   no-undo .
      204     define variable v-minute       as integer   no-undo .
      205     define variable v-second       as integer   no-undo .
      206     define variable v-milliseconds as integer   no-undo .
      207     do
      208     on error undo, return error return-value
      209     :
      210       run sys-time_get-sys in this-procedure
      211         (output v-year
      212         ,output v-month
      213         ,output v-day
      214         ,output v-hour
      215         ,output v-minute
      216         ,output v-second
      217         ,output v-milliseconds
      218         ) .
      219       assign
      220         v-day-of-week = weekday(date(v-month, v-day, v-year))
      221         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      222                     + ', ':u
      223                     + string(v-day, '99':u)
      224                     + ' ':u
      225                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      226                     + ' ':u
      227                     + string(v-year, '9999':u)
      228                     + ' ':u
      229                     + string(v-hour, '99':u)
      230                     + ':':u
      231                     + string(v-minute, '99':u)
      232                     + ':':u
      233                     + string(v-second, '99':u)
      234                     + ' ':u
      235                     + 'GMT':u
      236       .
      237     end.
      238   end procedure.
      239   procedure sys-time_set-sys :
      240     define input  parameter p-year         as integer   no-undo .
      241     define input  parameter p-month        as integer   no-undo .
      242     define input  parameter p-day          as integer   no-undo .
      243     define input  parameter p-hour         as integer   no-undo .
      244     define input  parameter p-minute       as integer   no-undo .
      245     define input  parameter p-second       as integer   no-undo .
      246     define input  parameter p-milliseconds as integer   no-undo .
      247     define variable v-system-time-structure as memptr    no-undo.
      248     define variable v-return-value as integer   no-undo .
      249     define variable v-day-of-week  as integer   no-undo .
      250     do
      251     on error undo, return error return-value
      252     :
      253       assign
      254         v-day-of-week = weekday(date(p-month, p-day, p-year))
      255       .
      256       assign
      257         set-size(v-system-time-structure) = 16
      258       .
      259       assign
      260         put-short(v-system-time-structure,  1) = p-year
      261         put-short(v-system-time-structure,  3) = p-month
      262         put-short(v-system-time-structure,  5) = v-day-of-week
      263         put-short(v-system-time-structure,  7) = p-day
      264         put-short(v-system-time-structure,  9) = p-hour
      265         put-short(v-system-time-structure, 11) = p-minute
      266         put-short(v-system-time-structure, 13) = p-second
      267         put-short(v-system-time-structure, 15) = p-milliseconds
      268       .
      269       run SetSystemTime
      270         (input  get-pointer-value(v-system-time-structure)
      271         ,output v-return-value
      272         ) .
      273       assign
      274         set-size(v-system-time-structure) = 0
      275       .
      276       if v-return-value = 0
      277       then do:
      278         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      279       end.
      280     end.
      281   end procedure.
      282   procedure sys-time_sys-to-mjd :
      283     define input  parameter p-year         as integer   no-undo .
      284     define input  parameter p-month        as integer   no-undo .
      285     define input  parameter p-day          as integer   no-undo .
      286     define input  parameter p-hour         as integer   no-undo .
      287     define input  parameter p-minute       as integer   no-undo .
      288     define input  parameter p-second       as integer   no-undo .
      289     define input  parameter p-milliseconds as integer   no-undo .
      290     define output parameter p-mjd          as decimal   no-undo .
      291     define variable v-year-correction as decimal   no-undo .
      292     define variable v-shift-year as decimal   no-undo .
      293     do
      294     on error undo, return error return-value
      295     :
      296       assign
      297         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      298         v-shift-year      = decimal(p-year) + v-year-correction
      299         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      300               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      301               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      302               + decimal(p-day) - 2432076.0
      303               + p-hour / 24.0
      304               + p-minute / 1440.0
      305               + p-second / 86400.0
      306               + p-milliseconds / 86400000.0
      307       .
      308     end.
      309   end procedure.
      310   procedure sys-time_sys-to-loc :
      311     define input  parameter p-sys-year         as integer   no-undo .
      312     define input  parameter p-sys-month        as integer   no-undo .
      313     define input  parameter p-sys-day          as integer   no-undo .
      314     define input  parameter p-sys-hour         as integer   no-undo .
      315     define input  parameter p-sys-minute       as integer   no-undo .
      316     define input  parameter p-sys-second       as integer   no-undo .
      317     define input  parameter p-sys-milliseconds as integer   no-undo .
      318     define output parameter p-loc-year         as integer   no-undo .
      319     define output parameter p-loc-month        as integer   no-undo .
      320     define output parameter p-loc-day          as integer   no-undo .
      321     define output parameter p-loc-hour         as integer   no-undo .
      322     define output parameter p-loc-minute       as integer   no-undo .
      323     define output parameter p-loc-second       as integer   no-undo .
      324     define output parameter p-loc-milliseconds as integer   no-undo .
      325     define variable v-system-time-structure as memptr    no-undo.
      326     define variable v-return-value          as integer   no-undo .
      327     define variable v-sys-day-of-week       as integer   no-undo .
      328     do
      329     on error undo, return error return-value
      330     :
      331       assign
      332         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      333       .
      334       assign
      335         set-size(v-system-time-structure) = 32
      336       .
      337       assign
      338         put-short(v-system-time-structure,  1) = p-sys-year
      339         put-short(v-system-time-structure,  3) = p-sys-month
      340         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      341         put-short(v-system-time-structure,  7) = p-sys-day
      342         put-short(v-system-time-structure,  9) = p-sys-hour
      343         put-short(v-system-time-structure, 11) = p-sys-minute
      344         put-short(v-system-time-structure, 13) = p-sys-second
      345         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      346       .
      347       run SystemTimeToTzSpecificLocalTime
      348         (input  0
      349         ,input  get-pointer-value(v-system-time-structure)
      350         ,input  get-pointer-value(v-system-time-structure) + 16
      351         ,output v-return-value
      352         ) .
      353       assign
      354         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      355         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      356         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      357         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      358         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      359         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      360         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      361       .
      362       assign
      363         set-size(v-system-time-structure) = 0
      364       .
      365       if v-return-value = 0
      366       then do:
      367         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      368       end.
      369     end.
      370   end procedure.
      371   procedure sys-time_mjd-to-sys :
      372     define input  parameter p-mjd          as decimal   no-undo .
      373     define output parameter p-year         as integer   no-undo .
      374     define output parameter p-month        as integer   no-undo .
      375     define output parameter p-day          as integer   no-undo .
      376     define output parameter p-hour         as integer   no-undo .
      377     define output parameter p-minute       as integer   no-undo .
      378     define output parameter p-second       as integer   no-undo .
      379     define output parameter p-milliseconds as integer   no-undo .
      380     define variable v-year-correction as decimal   no-undo .
      381     define variable v-shift-year      as decimal   no-undo .
      382     define variable v-conv-date     as date      no-undo .
      383     define variable v-int-part      as integer   no-undo .
      384     define variable v-fraction-part as decimal   no-undo .
      385     do
      386     on error undo, return error return-value
      387     :
      388       assign
      389         v-int-part      = integer(truncate(p-mjd, 0))
      390         v-fraction-part = p-mjd - v-int-part
      391         v-conv-date     = date(11, 17, 1858) + v-int-part
      392         p-year          = year(v-conv-date)
      393         p-month         = month(v-conv-date)
      394         p-day           = day(v-conv-date)
      395         v-fraction-part = v-fraction-part * 24.0
      396         p-hour          = integer(truncate(v-fraction-part, 0))
      397         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      398         p-minute        = integer(truncate(v-fraction-part, 0))
      399         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      400         p-second        = integer(truncate(v-fraction-part, 0))
      401         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      402         p-milliseconds  = integer(v-fraction-part)
      403       .
      404     end.
      405   end procedure.
      406   procedure sys-time_mjd-to-loc :
      407     define input  parameter p-mjd              as decimal   no-undo .
      408     define output parameter p-loc-year         as integer   no-undo .
      409     define output parameter p-loc-month        as integer   no-undo .
      410     define output parameter p-loc-day          as integer   no-undo .
      411     define output parameter p-loc-hour         as integer   no-undo .
      412     define output parameter p-loc-minute       as integer   no-undo .
      413     define output parameter p-loc-second       as integer   no-undo .
      414     define output parameter p-loc-milliseconds as integer   no-undo .
      415     define variable v-sys-year         as integer   no-undo .
      416     define variable v-sys-month        as integer   no-undo .
      417     define variable v-sys-day          as integer   no-undo .
      418     define variable v-sys-hour         as integer   no-undo .
      419     define variable v-sys-minute       as integer   no-undo .
      420     define variable v-sys-second       as integer   no-undo .
      421     define variable v-sys-milliseconds as integer   no-undo .
      422     do
      423     on error undo, return error return-value
      424     :
      425       run sys-time_mjd-to-sys
      426         (input  p-mjd
      427         ,output v-sys-year
      428         ,output v-sys-month
      429         ,output v-sys-day
      430         ,output v-sys-hour
      431         ,output v-sys-minute
      432         ,output v-sys-second
      433         ,output v-sys-milliseconds
      434         ) .
      435       run sys-time_sys-to-loc
      436         (input  v-sys-year
      437         ,input  v-sys-month
      438         ,input  v-sys-day
      439         ,input  v-sys-hour
      440         ,input  v-sys-minute
      441         ,input  v-sys-second
      442         ,input  v-sys-milliseconds
      443         ,output p-loc-year
      444         ,output p-loc-month
      445         ,output p-loc-day
      446         ,output p-loc-hour
      447         ,output p-loc-minute
      448         ,output p-loc-second
      449         ,output p-loc-milliseconds
      450         ) .
      451     end.
      452   end procedure.
      453   function sys-time_get-mjd-func returns decimal
      454   :
      455     define variable v-year         as integer   no-undo .
      456     define variable v-month        as integer   no-undo .
      457     define variable v-day          as integer   no-undo .
      458     define variable v-hour         as integer   no-undo .
      459     define variable v-minute       as integer   no-undo .
      460     define variable v-second       as integer   no-undo .
      461     define variable v-milliseconds as integer   no-undo .
      462     define variable v-mjd          as decimal   no-undo .
      463     run sys-time_get-sys in this-procedure
      464       (output v-year
      465       ,output v-month
      466       ,output v-day
      467       ,output v-hour
      468       ,output v-minute
      469       ,output v-second
      470       ,output v-milliseconds
      471       ) .
      472     run sys-time_sys-to-mjd in this-procedure
      473       (input  v-year
      474       ,input  v-month
      475       ,input  v-day
      476       ,input  v-hour
      477       ,input  v-minute
      478       ,input  v-second
      479       ,input  v-milliseconds
      480       ,output v-mjd
      481       ) .
      482     return v-mjd .
      483   end function .
      484   function sys-time_get-sys-str-func returns character
      485   :
      486     define variable v-utc-time as character no-undo .
      487     define variable v-year         as integer   no-undo .
      488     define variable v-month        as integer   no-undo .
      489     define variable v-day          as integer   no-undo .
      490     define variable v-hour         as integer   no-undo .
      491     define variable v-minute       as integer   no-undo .
      492     define variable v-second       as integer   no-undo .
      493     define variable v-milliseconds as integer   no-undo .
      494     run sys-time_get-sys in this-procedure
      495       (output v-year
      496       ,output v-month
      497       ,output v-day
      498       ,output v-hour
      499       ,output v-minute
      500       ,output v-second
      501       ,output v-milliseconds
      502       ) .
      503     assign
      504       v-utc-time  = 'UTC ':u
      505                   + string(v-year,         '9999':u)
      506                   + '/':u
      507                   + string(v-month,        '99':u)
      508                   + '/':u
      509                   + string(v-day,          '99':u)
      510                   + ' ':u
      511                   + string(v-hour,         '99':u)
      512                   + ':':u
      513                   + string(v-minute,       '99':u)
      514                   + ':':u
      515                   + string(v-second,       '99':u)
      516                   + ' ':u
      517                   + string(v-milliseconds, '999':u)
      518     .
      519     return v-utc-time.
      520   end function .
      521   function sys-time_mjd-to-loc-str-func returns character
      522     (v-sys-mjd as decimal)
      523   :
      524     define variable v-loc-str          as character no-undo .
      525     define variable v-loc-year         as integer   no-undo .
      526     define variable v-loc-month        as integer   no-undo .
      527     define variable v-loc-day          as integer   no-undo .
      528     define variable v-loc-hour         as integer   no-undo .
      529     define variable v-loc-minute       as integer   no-undo .
      530     define variable v-loc-second       as integer   no-undo .
      531     define variable v-loc-milliseconds as integer   no-undo .
      532     run sys-time_mjd-to-loc in this-procedure
      533       (input  v-sys-mjd
      534       ,output v-loc-year
      535       ,output v-loc-month
      536       ,output v-loc-day
      537       ,output v-loc-hour
      538       ,output v-loc-minute
      539       ,output v-loc-second
      540       ,output v-loc-milliseconds
      541       ) .
      542     assign
      543       v-loc-str = substitute('&1/&2/&3 &4:&5'
      544                             ,string(v-loc-day,    '99':U)
      545                             ,string(v-loc-month,  '99':U)
      546                             ,string(v-loc-year,   '9999':U)
      547                             ,string(v-loc-hour,   '99':U)
      548                             ,string(v-loc-minute, '99':U)
      549                             )
      550     .
      551     return v-loc-str .
      552   end function .
      553   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      554   :
      555     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      556   END PROCEDURE.
      557   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      558   :
      559     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      560     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      561   END PROCEDURE.
      562   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      563   :
      564     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      565     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      566   END PROCEDURE.
      567   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      568   :
      569     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      570     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      571     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      572     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      573   END PROCEDURE.
      574   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      575   :
      576     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      577     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      578     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      579   END PROCEDURE.
      580   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      581   :
      582     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      583     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      584     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      585   END PROCEDURE.
      586   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      587   :
      588     DEFINE RETURN PARAMETER RetVal          AS LONG.
      589   END PROCEDURE.
      590   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
