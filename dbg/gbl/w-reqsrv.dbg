      614   define new  shared variable g#news-source-db as integer no-undo.
      615   define new  shared variable g#esys-source-esys as integer no-undo.
      616   define new  shared variable g#db-num as integer   no-undo .
      617   define new  shared variable g#userid as character no-undo .
      618   define new  shared variable g#passwd as character no-undo .
      619   define variable v-rtusrnum as integer   no-undo .
      620   define variable v-rtexpdt  as date      no-undo .
      621   define stream sinp .
      622   define stream sout .
      623   define variable v-server-running     as logical   no-undo .
      624   define variable v-rt-reply-handle    as handle    no-undo .
      625   define variable v-stop-server        as logical   no-undo .
      626   define variable v-full-dir-name      as character no-undo .
      627   define variable v-directory-in       as character no-undo .
      628   define variable v-directory-out      as character no-undo .
      629   define variable v-description-number as integer   no-undo .
      630   define variable v-cntxt-db-num        as integer   no-undo .
      631   define variable v-cntxt-user-id       as character no-undo .
      632   define variable v-cntxt-level         as character no-undo .
      633   define variable v-cntxt-host-code-obj as integer   no-undo .
      634   define variable v-cntxt-obj-type      as character no-undo .
      635   define variable v-cntxt-obj-code      as integer   no-undo .
      636   define variable v-cntxt-db-num-obj    as integer   no-undo .
      637   define variable v-cntxt-is-admin      as logical   no-undo .
      638   define variable v-cntxt-report-num    as integer   no-undo .
      639   define buffer buf_sys-ctrl   for ub.sys-ctrl .
      640   define buffer buf_user-login for ub.user-login .
      641   DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.
      642   DEFINE BUTTON b-exit
      643        LABEL "&Выход"
      644        SIZE 10 BY 1.
      645   DEFINE BUTTON b-sel-dir
      646        IMAGE-UP FILE "btn-down-arrow":U
      647        IMAGE-DOWN FILE "btn-down-arrow":U
      648        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      649        LABEL ""
      650        SIZE 3 BY 1.
      651   DEFINE BUTTON b-start DEFAULT
      652        LABEL "Ста&рт"
      653        SIZE 10 BY 1.
      654   DEFINE BUTTON b-stop
      655        LABEL "Сто&п"
      656        SIZE 10 BY 1.
      657   DEFINE VARIABLE fi-description-01 AS CHARACTER FORMAT "X(256)":U
      658         VIEW-AS TEXT
      659        SIZE 85.5 BY .67 NO-UNDO.
      660   DEFINE VARIABLE fi-description-02 AS CHARACTER FORMAT "X(256)":U
      661         VIEW-AS TEXT
      662        SIZE 85.5 BY .67 NO-UNDO.
      663   DEFINE VARIABLE fi-description-03 AS CHARACTER FORMAT "X(256)":U
      664         VIEW-AS TEXT
      665        SIZE 85.5 BY .67 NO-UNDO.
      666   DEFINE VARIABLE fi-description-04 AS CHARACTER FORMAT "X(256)":U
      667         VIEW-AS TEXT
      668        SIZE 85.5 BY .67 NO-UNDO.
      669   DEFINE VARIABLE fi-directory AS CHARACTER FORMAT "X(256)":U
      670        LABEL "Директория обмена запросами"
      671        VIEW-AS FILL-IN
      672        SIZE 56 BY 1 NO-UNDO.
      673   DEFINE VARIABLE fi-message-01 AS CHARACTER FORMAT "X(256)":U
      674         VIEW-AS TEXT
      675        SIZE 89 BY .67 NO-UNDO.
      676   DEFINE VARIABLE fi-message-02 AS CHARACTER FORMAT "X(256)":U
      677         VIEW-AS TEXT
      678        SIZE 89 BY .67 NO-UNDO.
      679   DEFINE VARIABLE fi-message-03 AS CHARACTER FORMAT "X(256)":U
      680         VIEW-AS TEXT
      681        SIZE 89 BY .67 NO-UNDO.
      682   DEFINE VARIABLE fi-message-04 AS CHARACTER FORMAT "X(256)":U
      683         VIEW-AS TEXT
      684        SIZE 89 BY .67 NO-UNDO.
      685   DEFINE VARIABLE fi-message-05 AS CHARACTER FORMAT "X(256)":U
      686         VIEW-AS TEXT
      687        SIZE 89 BY .67 NO-UNDO.
      688   DEFINE VARIABLE fi-message-06 AS CHARACTER FORMAT "X(256)":U
      689         VIEW-AS TEXT
      690        SIZE 89 BY .67 NO-UNDO.
      691   DEFINE VARIABLE fi-message-07 AS CHARACTER FORMAT "X(256)":U
      692         VIEW-AS TEXT
      693        SIZE 89 BY .67 NO-UNDO.
      694   DEFINE VARIABLE fi-message-08 AS CHARACTER FORMAT "X(256)":U
      695         VIEW-AS TEXT
      696        SIZE 89 BY .67 NO-UNDO.
      697   DEFINE VARIABLE fi-message-09 AS CHARACTER FORMAT "X(256)":U
      698         VIEW-AS TEXT
      699        SIZE 89 BY .67 NO-UNDO.
      700   DEFINE VARIABLE fi-message-10 AS CHARACTER FORMAT "X(256)":U
      701         VIEW-AS TEXT
      702        SIZE 89 BY .67 NO-UNDO.
      703   DEFINE VARIABLE fi-message-11 AS CHARACTER FORMAT "X(256)":U
      704         VIEW-AS TEXT
      705        SIZE 89 BY .67 NO-UNDO.
      706   DEFINE VARIABLE fi-message-12 AS CHARACTER FORMAT "X(256)":U
      707         VIEW-AS TEXT
      708        SIZE 89 BY .67 NO-UNDO.
      709   DEFINE FRAME DEFAULT-FRAME
      710        b-exit AT ROW 1 COL 1
      711        b-start AT ROW 1 COL 11
      712        b-stop AT ROW 1 COL 21
      713        fi-directory AT ROW 2 COL 30 COLON-ALIGNED
      714        b-sel-dir AT ROW 2 COL 88
      715        fi-description-01 AT ROW 3.5 COL 2 NO-LABEL
      716        fi-description-02 AT ROW 4.5 COL 2 NO-LABEL
      717        fi-description-03 AT ROW 5.5 COL 2 NO-LABEL
      718        fi-description-04 AT ROW 6.5 COL 2 NO-LABEL
      719        fi-message-01 AT ROW 9.5 COL 2 NO-LABEL
      720        fi-message-02 AT ROW 10.5 COL 2 NO-LABEL
      721        fi-message-03 AT ROW 11.5 COL 2 NO-LABEL
      722        fi-message-04 AT ROW 12.5 COL 2 NO-LABEL
      723        fi-message-05 AT ROW 13.5 COL 2 NO-LABEL
      724        fi-message-06 AT ROW 14.5 COL 2 NO-LABEL
      725        fi-message-07 AT ROW 15.5 COL 2 NO-LABEL
      726        fi-message-08 AT ROW 16.5 COL 2 NO-LABEL
      727        fi-message-09 AT ROW 17.5 COL 2 NO-LABEL
      728        fi-message-10 AT ROW 18.5 COL 2 NO-LABEL
      729        fi-message-11 AT ROW 19.5 COL 2 NO-LABEL
      730        fi-message-12 AT ROW 20.5 COL 2 NO-LABEL
      731       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      732            SIDE-LABELS NO-UNDERLINE THREE-D
      733            AT COL 1 ROW 1
      734            SIZE 97.13 BY 20.21
      735            DEFAULT-BUTTON b-start.
      736   IF SESSION:DISPLAY-TYPE = "GUI":U THEN
      737     CREATE WINDOW C-Win ASSIGN
      738            HIDDEN             = YES
      739            TITLE              = "Сервер обработки запросов"
      740            HEIGHT             = 20.21
      741            WIDTH              = 97.13
      742            MAX-HEIGHT         = 20.21
      743            MAX-WIDTH          = 97.13
      744            VIRTUAL-HEIGHT     = 20.21
      745            VIRTUAL-WIDTH      = 97.13
      746            RESIZE             = yes
      747            SCROLL-BARS        = no
      748            STATUS-AREA        = no
      749            BGCOLOR            = ?
      750            FGCOLOR            = ?
      751            KEEP-FRAME-Z-ORDER = yes
      752            THREE-D            = yes
      753            MESSAGE-AREA       = no
      754            SENSITIVE          = yes.
      755   ELSE C-Win = CURRENT-WINDOW.
      756   IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
      757   THEN C-Win:HIDDEN = no.
      758   ON END-ERROR OF C-Win
      759   OR ENDKEY OF C-Win ANYWHERE DO:
      760     IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
      761   END.
      762   ON WINDOW-CLOSE OF C-Win
      763   DO:
      764     if v-server-running <> true
      765     then do:
      766       apply "close":u to this-procedure.
      767     end.
      768     return no-apply.
      769   END.
      770   ON CHOOSE OF b-exit IN FRAME DEFAULT-FRAME
      771   DO:
      772     if v-server-running <> true
      773     then do:
      774       apply 'close':u to this-procedure .
      775     end.
      776   END.
      777   ON CHOOSE OF b-sel-dir IN FRAME DEFAULT-FRAME
      778   DO:
      779     define variable v-dir-name  as character no-undo .
      780     define variable v-dir-type  as character no-undo .
      781     define variable v-can-write as logical   no-undo .
      782     run gbl/dir-sel.p
      783       (output v-dir-name
      784       ,output v-dir-type
      785       ,output v-can-write
      786       ) .
      787     if v-dir-name <> ""
      788     then do:
      789       assign
      790         fi-directory :screen-value = v-dir-name
      791       .
      792     end.
      793   END.
      794   ON CHOOSE OF b-start IN FRAME DEFAULT-FRAME
      795   DO:
      796     if v-server-running <> true
      797     then do:
      798       if fi-directory :screen-value = ""
      799       then do:
      800         message
      801           "Задайте директорию обмена запросами" skip
      802           view-as alert-box information .
      803         apply 'entry':u to fi-directory .
      804         return no-apply .
      805       end.
      806       assign
      807         file-info :file-name = fi-directory :screen-value
      808       .
      809       assign
      810         v-full-dir-name = file-info :full-pathname
      811       .
      812       if v-full-dir-name = ?
      813       or v-full-dir-name = ""
      814       then do:
      815         message
      816           "Ошибка задания директории" skip
      817           "" fi-directory :screen-value skip
      818           view-as alert-box error .
      819         apply 'entry':u to fi-directory .
      820         return no-apply .
      821       end.
      822       assign
      823         v-directory-in  = v-full-dir-name + '/' + 'in':u
      824         v-directory-out = v-full-dir-name + '/' + 'out':u
      825       .
      826       run gbl/dir-cre.p
      827         (input  v-directory-in
      828         ) .
      829       run gbl/dir-cre.p
      830         (input  v-directory-out
      831         ) .
      832       assign
      833         v-server-running = true
      834         v-stop-server    = false
      835       .
      836       assign
      837         b-exit  :sensitive      = false
      838         b-start :sensitive      = false
      839         b-stop  :sensitive      = true
      840         b-sel-dir :sensitive    = false
      841         fi-directory :read-only = true
      842       .
      843       assign
      844         fi-description-01 :screen-value = "Сервер запускается"
      845       .
      846       run gbl/req-serv.p
      847         (input this-procedure :handle
      848         ,input v-directory-in
      849         ,input v-directory-out
      850         ) no-error .
      851       if error-status :error
      852       then do:
      853         message
      854           "Ошибка при запуске программы req-serv.p" skip
      855           error-status :get-message(1) skip
      856           return-value
      857           view-as alert-box error .
      858       end.
      859       if valid-handle(v-rt-reply-handle) = true
      860       then do:
      861         delete procedure v-rt-reply-handle .
      862       end.
      863       assign
      864         fi-description-01 :screen-value = ""
      865       .
      866       assign
      867         b-exit  :sensitive      = true
      868         b-start :sensitive      = true
      869         b-stop  :sensitive      = false
      870         b-sel-dir :sensitive    = true
      871         fi-directory :read-only = false
      872       .
      873       assign
      874         v-server-running = false
      875       .
      876     end.
      877   END.
      878   ON CHOOSE OF b-stop IN FRAME DEFAULT-FRAME
      879   DO:
      880     define variable v-ok as logical   no-undo .
      881     if v-server-running = true
      882     then do:
      883       if v-stop-server = false
      884       then do:
      885         message
      886           "Остановить сервер обработки запросов" skip
      887           "Продолжить?" skip
      888           view-as alert-box question buttons yes-no update v-ok .
      889         if v-ok = true
      890         then do:
      891           assign
      892             v-stop-server = true
      893           .
      894         end.
      895       end.
      896     end.
      897   END.
      898   ASSIGN CURRENT-WINDOW                = C-Win
      899          THIS-PROCEDURE:CURRENT-WINDOW = C-Win.
      900   ON CLOSE OF THIS-PROCEDURE
      901      RUN disable_UI.
      902   PAUSE 0 BEFORE-HIDE.
      903   MAIN-BLOCK:
      904   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      905      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      906     RUN enable_UI.
      907     find first buf_sys-ctrl no-lock .
      908     find buf_user-login no-lock
      909       where buf_user-login.db-num     = buf_sys-ctrl.db-num
      910         and buf_user-login.status_    = 0
      911         and buf_user-login.user-login = p-user-login
      912       no-error .
      913     if not available buf_user-login
      914     then do:
      915       message
      916         "Не найден пользователь" skip
      917         p-user-login skip
      918         view-as alert-box error .
      919       undo, return error return-value .
      920     end.
      921     run gbl/set-gbl.p
      922       (input true
      923       ,input buf_user-login.user-id
      924       ,input p-user-password
      925       ) .
      926     define variable v-rtexch-chr               as character no-undo .
      927     define variable v-rtexch-type              as character no-undo .
      928     define variable v-rtusrnum-chr             as character no-undo .
      929     define variable v-rtusrnum-type            as character no-undo .
      930     define variable v-rtexpdt-chr              as character no-undo .
      931     define variable v-rtexpdt-type             as character no-undo .
      932   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      933     (input  'rtexch':u
      934     ,input  0
      935     ,input  ''
      936     ,input  0
      937     ,input  ''
      938     ,input  ''
      939     ,input  ''
      940     ,input  no
      941     ,output v-rtexch-chr
      942     ,output v-rtexch-type
      943     ) no-error .
      944     if error-status :error
      945     or v-rtexch-chr <> "yes"
      946     then do:
      947       message
      948         "Отсутствуют права для работы с радиотерминалом" skip
      949         "Параметр rtexch" skip
      950         view-as alert-box error .
      951       undo, return error return-value .
      952     end.
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      954     (input  'rtusrnum':u
      955     ,input  0
      956     ,input  ''
      957     ,input  0
      958     ,input  ''
      959     ,input  ''
      960     ,input  ''
      961     ,input  no
      962     ,output v-rtusrnum-chr
      963     ,output v-rtusrnum-type
      964     ) no-error .
      965     if error-status :error
      966     then do:
      967       message
      968         "Не задано количество пользователей для работы с радиотерминалом" skip
      969         "Параметр rtusrnum" skip
      970         view-as alert-box error .
      971       undo, return error return-value .
      972     end.
      973     assign
      974       v-rtusrnum = integer(v-rtusrnum-chr) no-error
      975     .
      976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      977     (input  'rtexpdt':u
      978     ,input  0
      979     ,input  ''
      980     ,input  0
      981     ,input  ''
      982     ,input  ''
      983     ,input  ''
      984     ,input  no
      985     ,output v-rtexpdt-chr
      986     ,output v-rtexpdt-type
      987     ) no-error .
      988     if error-status :error
      989     then do:
      990       message
      991         "Не задан срок окончания лицензии для работы с радиотерминалом" skip
      992         "Параметр rtexpdt" skip
      993         view-as alert-box error .
      994       undo, return error return-value .
      995     end.
      996     assign
      997       v-rtexpdt = date(v-rtexpdt-chr) no-error
      998     .
      999     if v-rtexpdt = ?
     1000     then do:
     1001       assign
     1002         v-rtexpdt = date(01/01/5000)
     1003       .
     1004     end.
     1005     assign
     1006       session :time-source = 'ub':U
     1007     .
     1008     if today > v-rtexpdt
     1009     then do:
     1010       message
     1011         "Истек срок действия лицензии для работы с радиотерминалом" skip
     1012         "Сегодня" today skip
     1013         "Срок окончания лицензии" v-rtexpdt skip
     1014         "Параметр rtexpdt" skip
     1015         view-as alert-box error .
     1016       undo, return error return-value .
     1017     end.
     1018     assign
     1019       fi-description-02 :screen-value = substitute("Максимальное количество пользователей &1", v-rtusrnum )
     1020       fi-description-03 :screen-value = substitute("Срок окончания лицензии &1", string(v-rtexpdt, '99/99/9999'))
     1021     .
     1022     if v-rtexpdt - today < 15
     1023     then do:
     1024       assign
     1025         fi-description-04 :screen-value = substitute("ВНИМАНИЕ!!! До окончания лиценизии осталось &1 дней", v-rtexpdt - today)
     1026       .
     1027     end.
     1028     define buffer rtexch-lock_batchprocess for ub.batchprocess .
     1029     run gbl/lock-prc.p
     1030       (input 'rtex':U
     1031       ,input 0
     1032       ,input 0
     1033       ,input 0
     1034       ,input ""
     1035       ,input ""
     1036       ,input ""
     1037       ,input ",,,,,,Обработка запросов радиотерминала"
     1038       ,input true
     1039       ,buffer rtexch-lock_batchprocess
     1040       ) no-error .
     1041     if error-status :error
     1042     then do:
     1043       message
     1044         vss-workfile vss-revision vss-description skip
     1045         "Сервер обработки запросов радиотерминала уже запущен" skip
     1046         "Невозможно запустить второй сервер обработки запросов для той-же базы данных" skip
     1047         error-status :get-message(1) skip
     1048         return-value skip
     1049         view-as alert-box error .
     1050       return .
     1051     end.
     1052     assign
     1053       v-cntxt-report-num = dynamic-next-value( "next-report":U, "ubflt":U) .
     1054     .
     1055     do with frame DEFAULT-FRAME
     1056     :
     1057       assign
     1058         b-stop  :sensitive = false
     1059       .
     1060       define variable v-exch-dir as character no-undo .
     1061       get-key-value section 'radio-terminal' key 'exch-dir' value v-exch-dir .
     1062       if v-exch-dir = ?
     1063       then do:
     1064         message
     1065           'Отсутствует ключ exch-dir в секции radio-terminal в progress.ini'
     1066           view-as alert-box error .
     1067       end.
     1068       else do:
     1069         assign
     1070           fi-directory :screen-value = v-exch-dir
     1071         .
     1072       end.
     1073       apply 'entry':u to fi-directory .
     1074       assign
     1075         v-description-number = 0
     1076       .
     1077       if p-auto-start = true
     1078       then do:
     1079         apply 'choose':u to b-start .
     1080       end.
     1081     end.
     1082     IF NOT THIS-PROCEDURE:PERSISTENT THEN
     1083       WAIT-FOR CLOSE OF THIS-PROCEDURE.
     1084   END.
     1085   PROCEDURE disable_UI :
     1086     IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
     1087     THEN DELETE WIDGET C-Win.
     1088     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1089   END PROCEDURE.
     1090   PROCEDURE enable_UI :
     1091     DISPLAY fi-directory fi-description-01 fi-description-02 fi-description-03
     1092             fi-description-04 fi-message-01 fi-message-02 fi-message-03
     1093             fi-message-04 fi-message-05 fi-message-06 fi-message-07 fi-message-08
     1094             fi-message-09 fi-message-10 fi-message-11 fi-message-12
     1095         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     1096     ENABLE b-exit b-start b-stop fi-directory b-sel-dir fi-description-01
     1097            fi-description-02 fi-description-03 fi-description-04
     1098         WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
     1099     VIEW C-Win.
     1100   END PROCEDURE.
     1101   PROCEDURE get-utc-time-string :
     1102     define output parameter p-utc-time as character no-undo .
     1103     define variable v-year         as integer   no-undo .
     1104     define variable v-month        as integer   no-undo .
     1105     define variable v-day          as integer   no-undo .
     1106     define variable v-hour         as integer   no-undo .
     1107     define variable v-minute       as integer   no-undo .
     1108     define variable v-second       as integer   no-undo .
     1109     define variable v-milliseconds as integer   no-undo .
     1110     do
     1111     on error undo, return error return-value
     1112     :
     1113       run sys-time_get-sys in this-procedure
     1114         (output v-year
     1115         ,output v-month
     1116         ,output v-day
     1117         ,output v-hour
     1118         ,output v-minute
     1119         ,output v-second
     1120         ,output v-milliseconds
     1121         ) .
     1122       assign
     1123         p-utc-time  = 'UTC ':u
     1124                     + string(v-year,         '9999':u)
     1125                     + '/':u
     1126                     + string(v-month,        '99':u)
     1127                     + '/':u
     1128                     + string(v-day,          '99':u)
     1129                     + ' ':u
     1130                     + string(v-hour,         '99':u)
     1131                     + ':':u
     1132                     + string(v-minute,       '99':u)
     1133                     + ':':u
     1134                     + string(v-second,       '99':u)
     1135                     + ' ':u
     1136                     + string(v-milliseconds, '999':u)
     1137       .
     1138     end.
     1139   END PROCEDURE.
     1140   PROCEDURE w-reqsrv_check-stop :
     1141     define output parameter p-stop-server as logical   no-undo .
     1142     do
     1143     on error undo, return error return-value
     1144     :
     1145       process events .
     1146       assign
     1147         p-stop-server = v-stop-server
     1148       .
     1149     end.
     1150   END PROCEDURE.
     1151   PROCEDURE w-reqsrv_process-request :
     1152     define input  parameter p-file-name as character no-undo .
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156       if valid-handle(v-rt-reply-handle) <> true
     1157       then do:
     1158         run gbl/rt-reply.p persistent set v-rt-reply-handle
     1159           (input v-rtusrnum
     1160           ,input v-rtexpdt
     1161           ).
     1162       end.
     1163       run rt-reply_process-request in v-rt-reply-handle
     1164         (input  this-procedure
     1165         ,input  v-directory-in
     1166         ,input  v-directory-out
     1167         ,input  p-file-name
     1168         ) no-error .
     1169       if error-status :error
     1170       then do:
     1171         define variable v-utc-time as character no-undo .
     1172         run get-utc-time-string in this-procedure
     1173           (output v-utc-time
     1174           ) .
     1175         run w-reqsrv_show-request in this-procedure
     1176           (input substitute('&1 error &2':u
     1177                            ,p-file-name
     1178                            ,return-value
     1179                            )
     1180           ) .
     1181         output stream sout to value(v-full-dir-name + '/':u + 'w-reqsrv.err':u ) append .
     1182         put stream sout unformatted v-utc-time + ' ' + p-file-name .
     1183         put stream sout unformatted "Ошибка при обработке запроса" + chr(10) .
     1184         put stream sout unformatted error-status :get-message(1) + chr(10) .
     1185         put stream sout unformatted return-value + chr(10) .
     1186         define variable v-read-string as character no-undo .
     1187         input stream sinp from value(v-directory-in + '/' + p-file-name) .
     1188         repeat
     1189         :
     1190           assign
     1191             v-read-string = '':u
     1192           .
     1193           import stream sinp unformatted v-read-string .
     1194           put stream sout unformatted v-read-string + chr(10) .
     1195         end.
     1196         input stream sinp close .
     1197         output stream sout close .
     1198         define variable v-temp-file-name  as character no-undo .
     1199         define variable v-error-file-name as character no-undo .
     1200         assign
     1201           v-temp-file-name  = entry(1, p-file-name, '.':u) + '.tmp':u
     1202           v-error-file-name = entry(1, p-file-name, '.':u) + '.err':u
     1203         .
     1204         output stream sout to value(v-directory-out + '/':u + v-temp-file-name) .
     1205         put stream sout "error" .
     1206         output stream sout close .
     1207         os-delete value(v-directory-out + '/':u + v-error-file-name) .
     1208         os-rename value(v-directory-out + '/':u + v-temp-file-name)
     1209                   value(v-directory-out + '/':u + v-error-file-name)
     1210                   .
     1211       end.
     1212       os-delete value(v-directory-in + '/' + p-file-name) .
     1213       view frame DEFAULT-FRAME
     1214         .
     1215     end.
     1216   END PROCEDURE.
     1217   PROCEDURE w-reqsrv_show-description :
     1218     define input  parameter p-description as character no-undo .
     1219     do with frame DEFAULT-FRAME
     1220     :
     1221       assign
     1222         fi-description-01 :screen-value = p-description
     1223       .
     1224     end.
     1225   END PROCEDURE.
     1226   PROCEDURE w-reqsrv_show-request :
     1227     define input  parameter p-request-data as character no-undo .
     1228     define variable v-ok as logical   no-undo .
     1229     define variable v-utc-time as character no-undo .
     1230     define variable v-message  as character no-undo .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       do with frame DEFAULT-FRAME
     1235       :
     1236         run get-utc-time-string in this-procedure
     1237           (output v-utc-time
     1238           ) .
     1239         assign
     1240           v-message = v-utc-time
     1241                     + " "
     1242                     + p-request-data
     1243         .
     1244         assign
     1245           v-description-number = v-description-number + 1
     1246         .
     1247         if v-description-number < 1
     1248         or v-description-number > 12
     1249         then do:
     1250           assign
     1251             v-description-number = 1
     1252           .
     1253         end.
     1254         define variable v-display-handle as widget-handle no-undo .
     1255         define variable v-hide-handle    as widget-handle no-undo .
     1256         case v-description-number
     1257         :
     1258           when 1
     1259           then do:
     1260             assign
     1261               v-display-handle = fi-message-01 :handle
     1262               v-hide-handle    = fi-message-12 :handle
     1263             .
     1264           end.
     1265           when 2
     1266           then do:
     1267             assign
     1268               v-display-handle = fi-message-02 :handle
     1269               v-hide-handle    = fi-message-01 :handle
     1270             .
     1271           end.
     1272           when 3
     1273           then do:
     1274             assign
     1275               v-display-handle = fi-message-03 :handle
     1276               v-hide-handle    = fi-message-02 :handle
     1277             .
     1278           end.
     1279           when 4
     1280           then do:
     1281             assign
     1282               v-display-handle = fi-message-04 :handle
     1283               v-hide-handle    = fi-message-03 :handle
     1284             .
     1285           end.
     1286           when 5
     1287           then do:
     1288             assign
     1289               v-display-handle = fi-message-05 :handle
     1290               v-hide-handle    = fi-message-04 :handle
     1291             .
     1292           end.
     1293           when 6
     1294           then do:
     1295             assign
     1296               v-display-handle = fi-message-06 :handle
     1297               v-hide-handle    = fi-message-05 :handle
     1298             .
     1299           end.
     1300           when 7
     1301           then do:
     1302             assign
     1303               v-display-handle = fi-message-07 :handle
     1304               v-hide-handle    = fi-message-06 :handle
     1305             .
     1306           end.
     1307           when 8
     1308           then do:
     1309             assign
     1310               v-display-handle = fi-message-08 :handle
     1311               v-hide-handle    = fi-message-07 :handle
     1312             .
     1313           end.
     1314           when 9
     1315           then do:
     1316             assign
     1317               v-display-handle = fi-message-09 :handle
     1318               v-hide-handle    = fi-message-08 :handle
     1319             .
     1320           end.
     1321           when 10
     1322           then do:
     1323             assign
     1324               v-display-handle = fi-message-10 :handle
     1325               v-hide-handle    = fi-message-09 :handle
     1326             .
     1327           end.
     1328           when 11
     1329           then do:
     1330             assign
     1331               v-display-handle = fi-message-11 :handle
     1332               v-hide-handle    = fi-message-10 :handle
     1333             .
     1334           end.
     1335           when 12
     1336           then do:
     1337             assign
     1338               v-display-handle = fi-message-12 :handle
     1339               v-hide-handle    = fi-message-11 :handle
     1340             .
     1341           end.
     1342         end case .
     1343         assign
     1344           v-display-handle :screen-value = v-message
     1345           v-display-handle :fgcolor      = WHITE_COLOR
     1346           v-display-handle :bgcolor      = BLUE_COLOR
     1347           v-hide-handle    :fgcolor      = BROWN_COLOR
     1348           v-hide-handle    :bgcolor      = GREY_COLOR
     1349         .
     1350       end.
     1351       process events .
     1352     end.
     1353   END PROCEDURE.
     1354   PROCEDURE mainmenu_getcntxt :
     1355     define output parameter p-cntxt-db-num        as integer   no-undo .
     1356     define output parameter p-cntxt-user-id       as character no-undo .
     1357     define output parameter p-cntxt-level         as character no-undo .
     1358     define output parameter p-cntxt-host-code-obj as integer   no-undo .
     1359     define output parameter p-cntxt-obj-type      as character no-undo .
     1360     define output parameter p-cntxt-obj-code      as integer   no-undo .
     1361     define output parameter p-cntxt-db-num-obj    as integer   no-undo .
     1362     define output parameter p-cntxt-is-admin      as logical   no-undo .
     1363     do on error undo, return error return-value
     1364     :
     1365       assign
     1366         p-cntxt-db-num         = v-cntxt-db-num
     1367         p-cntxt-user-id        = v-cntxt-user-id
     1368         p-cntxt-level          = v-cntxt-level
     1369         p-cntxt-host-code-obj  = v-cntxt-host-code-obj
     1370         p-cntxt-obj-type       = v-cntxt-obj-type
     1371         p-cntxt-obj-code       = v-cntxt-obj-code
     1372         p-cntxt-db-num-obj     = v-cntxt-db-num-obj
     1373         p-cntxt-is-admin       = v-cntxt-is-admin
     1374       .
     1375     end.
     1376   END PROCEDURE.
     1377   PROCEDURE get-report-num :
     1378     define output parameter p-report-num as integer no-undo .
     1379     do
     1380     on error undo, return error
     1381     :
     1382       assign
     1383         p-report-num = v-cntxt-report-num
     1384       .
     1385     end.
     1386   END PROCEDURE.
     1387   PROCEDURE w-reqsrv_setcntxt :
     1388     define input parameter p-cntxt-db-num        as integer   no-undo .
     1389     define input parameter p-cntxt-user-id       as character no-undo .
     1390     define input parameter p-cntxt-level         as character no-undo .
     1391     define input parameter p-cntxt-host-code-obj as integer   no-undo .
     1392     define input parameter p-cntxt-obj-type      as character no-undo .
     1393     define input parameter p-cntxt-obj-code      as integer   no-undo .
     1394     define input parameter p-cntxt-db-num-obj    as integer   no-undo .
     1395     define input parameter p-cntxt-is-admin      as logical   no-undo .
     1396     do on error undo, return error return-value
     1397     :
     1398       if p-cntxt-level <> 'object':U then do:
     1399         run w-reqsrv_clrcntxt in this-procedure .
     1400         return .
     1401       end.
     1402       assign
     1403         v-cntxt-db-num         = p-cntxt-db-num
     1404         v-cntxt-user-id        = p-cntxt-user-id
     1405         v-cntxt-level          = p-cntxt-level
     1406         v-cntxt-host-code-obj  = p-cntxt-host-code-obj
     1407         v-cntxt-obj-type       = p-cntxt-obj-type
     1408         v-cntxt-obj-code       = p-cntxt-obj-code
     1409         v-cntxt-db-num-obj     = p-cntxt-db-num-obj
     1410         v-cntxt-is-admin       = p-cntxt-is-admin
     1411       .
     1412     end.
     1413   END PROCEDURE.
     1414   PROCEDURE w-reqsrv_clrcntxt :
     1415     do on error undo, return error return-value
     1416     :
     1417       assign
     1418         v-cntxt-db-num         = buf_sys-ctrl.db-num
     1419         v-cntxt-user-id        = buf_user-login.user-id
     1420         v-cntxt-level          = 'global':U
     1421         v-cntxt-host-code-obj  = 0
     1422         v-cntxt-obj-type       = ''
     1423         v-cntxt-obj-code       = 0
     1424         v-cntxt-db-num-obj     = 0
     1425         v-cntxt-is-admin       = no
     1426       .
     1427     end.
     1428   END PROCEDURE.
     1429   PROCEDURE get-userid :
     1430     define output parameter p-user-id as character    no-undo .
     1431     do
     1432     on error undo, return error
     1433     :
     1434       assign
     1435         p-user-id = v-cntxt-user-id
     1436       .
     1437     end.
     1438   END PROCEDURE.
     1439   PROCEDURE w-reqsrv_print-log :
     1440     define input  parameter p-msg as character no-undo .
     1441     define variable v-message   as character no-undo .
     1442     define variable v-utc-time  as character no-undo .
     1443   do
     1444   on error undo, return error return-value
     1445   :
     1446     assign
     1447       v-message = trim(p-msg)
     1448     .
     1449     if v-message <> ? and v-message <> ''
     1450     then do:
     1451       run get-utc-time-string in this-procedure ( output v-utc-time ) .
     1452       output stream sout to value(v-full-dir-name + '/':u + 'w-reqsrv.err':u ) append .
     1453       put stream sout unformatted substitute("&1 &2" , v-utc-time , v-message ) .
     1454       output stream sout close.
     1455     end.
     1456   end.
     1457   END PROCEDURE.
     1458   PROCEDURE get-db-num :
     1459     define output parameter p-cntxt-db-num as integer   no-undo .
     1460     do
     1461     on error undo, return error return-value
     1462     :
     1463       assign
     1464         p-cntxt-db-num = buf_sys-ctrl.db-num
     1465       .
     1466     end.
     1467   END PROCEDURE.
     1468   PROCEDURE is-radioterminal :
     1469     define output parameter p-ask as logical   no-undo .
     1470     do
     1471     on error undo, return error return-value
     1472     :
     1473       assign
     1474         p-ask = true
     1475       .
     1476     end.
     1477   END PROCEDURE.
