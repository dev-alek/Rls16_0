      439   procedure onewin_clear :
      440       define buffer buf_temp_onewin_items        for temp_onewin_items.
      441   do
      442   for buf_temp_onewin_items
      443   on error undo, return error
      444   :
      445       empty temp-table buf_temp_onewin_items.
      446   end.
      447   end procedure.
      448   procedure onewin_add-item :
      449   define input parameter p-ext-key   as character        no-undo.
      450   define input parameter p-item-name as character        no-undo.
      451   define input parameter p-item-desc as character        no-undo.
      452   define input parameter p-selected  as logical          no-undo.
      453       define buffer buf_temp_onewin_items        for temp_onewin_items.
      454   do
      455   for buf_temp_onewin_items
      456   on error undo, return error
      457   :
      458       find last buf_temp_onewin_items no-error.
      459       if available buf_temp_onewin_items then do:
      460         v-onewin2-itm-key = buf_temp_onewin_items.itm-key.
      461       end.
      462       else do:
      463         v-onewin2-itm-key = 0.
      464       end.
      465       assign
      466           v-onewin2-itm-key = v-onewin2-itm-key + 1
      467       .
      468       create buf_temp_onewin_items.
      469       assign
      470       buf_temp_onewin_items.itm-key      = v-onewin2-itm-key
      471       buf_temp_onewin_items.itmExtKey    = p-ext-key
      472       buf_temp_onewin_items.itmName      = p-item-name
      473       buf_temp_onewin_items.itmDesc      = p-item-desc
      474       buf_temp_onewin_items.itmSelected  = p-selected
      475       .
      476   end.
      477   end procedure.
      478   procedure onewin_create-selection :
      479   define input parameter p-itm-key as integer no-undo .
      480   define input parameter p-itmextkey as character no-undo .
      481   define variable v-counter as integer no-undo .
      482   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      483   do
      484   on error undo, return error
      485   :
      486     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      487     if available buf_temp_onewin_itemsSelected then do:
      488       v-counter = buf_temp_onewin_itemsSelected.its-key.
      489     end.
      490     find first buf_temp_onewin_itemsSelected where
      491          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      492     if not available buf_temp_onewin_itemsSelected then do:
      493       create buf_temp_onewin_itemsSelected.
      494       assign
      495       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      496       v-counter = v-counter + 1
      497       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      498       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      499       .
      500     end.
      501   end.
      502   end procedure.
      503   procedure onewin_check-item :
      504   define input parameter p-ext-key   as character        no-undo.
      505   define output parameter p-exists as logical no-undo .
      506   define buffer buf_temp_onewin_items for temp_onewin_items.
      507   find first buf_temp_onewin_items where
      508   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      509   if available buf_temp_onewin_items then do:
      510     p-exists = yes.
      511   end.
      512   end procedure.
      513   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      514   define buffer buf_ext-system for ub.ext-system.
      515   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected.
      516   define variable v-tth     as handle no-undo .
      517   define variable v-tth-host as handle no-undo .
      518   define variable v-to-create-host as logical no-undo.
      519   define variable str-attr as character no-undo .
      520   assign
      521   v-tth      = buffer temp-thbj-attr:table-handle .
      522   DEFINE BUTTON B-egais-exsys
      523        IMAGE-UP FILE "btn-down-arrow":U
      524        IMAGE-DOWN FILE "btn-down-arrow":U
      525        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      526        LABEL "Btn 1"
      527        SIZE 4 BY 1.
      528   DEFINE BUTTON B-exit AUTO-GO
      529        LABEL "&Ввод"
      530        SIZE 10 BY 1.
      531   DEFINE BUTTON B-Help
      532        LABEL "&Help"
      533        SIZE 10 BY 1.
      534   DEFINE BUTTON B-quit AUTO-END-KEY
      535        LABEL "&Отмена"
      536        SIZE 10 BY 1.
      537   DEFINE VARIABLE f-egais-exsys AS CHARACTER FORMAT "X(256)":U
      538        VIEW-AS FILL-IN NATIVE
      539        SIZE 49.5 BY 1
      540        FGCOLOR 3  NO-UNDO.
      541   DEFINE VARIABLE v-egais-exsys AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      542        LABEL "Код ВС для обмена"
      543        VIEW-AS FILL-IN
      544        SIZE 9 BY 1 TOOLTIP "Код внешней системы, используемой для обмена" NO-UNDO.
      545   DEFINE VARIABLE v-egais-fsrar AS CHARACTER FORMAT "X(256)":U
      546        LABEL "Код ФСРАР"
      547        VIEW-AS FILL-IN
      548        SIZE 64.88 BY 1 NO-UNDO.
      549   DEFINE VARIABLE v-egais-inn AS CHARACTER FORMAT "X(12)":U
      550        LABEL "ИНН объекта"
      551        VIEW-AS FILL-IN
      552        SIZE 64.88 BY 1 NO-UNDO.
      553   DEFINE VARIABLE v-egais-utm AS CHARACTER FORMAT "X(256)":U
      554        LABEL "Адрес УТМ"
      555        VIEW-AS FILL-IN
      556        SIZE 64.88 BY 1 TOOLTIP "255.255.255.255:65536" NO-UNDO.
      557   DEFINE VARIABLE v-egais-ver-xsd AS CHARACTER FORMAT "X(256)":U
      558        LABEL "Версия xsd схем"
      559        VIEW-AS COMBO-BOX INNER-LINES 12
      560        LIST-ITEMS "1","2"
      561        SIZE 64.88 BY 1 NO-UNDO
      562        .
      563   DEFINE RECTANGLE RECT-1
      564        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      565        SIZE 85 BY 7.5.
      566   DEFINE FRAME Dialog-Frame
      567        B-exit AT ROW 1 COL 1
      568        B-quit AT ROW 1 COL 11
      569        B-Help AT ROW 1 COL 74.63
      570        v-egais-fsrar AT ROW 3.13 COL 17.63 COLON-ALIGNED WIDGET-ID 118
      571        v-egais-utm AT ROW 4.71 COL 17.63 COLON-ALIGNED WIDGET-ID 132
      572        v-egais-exsys AT ROW 4.75 COL 19.63 COLON-ALIGNED WIDGET-ID 22
      573        B-egais-exsys AT ROW 4.75 COL 30.75 WIDGET-ID 24
      574        f-egais-exsys AT ROW 4.75 COL 33 COLON-ALIGNED NO-LABEL WIDGET-ID 128
      575        v-egais-ver-xsd AT ROW 6.25 COL 17.63 COLON-ALIGNED WIDGET-ID 134
      576        v-egais-inn AT ROW 7.5 COL 17.63 COLON-ALIGNED WIDGET-ID 136
      577        "ИНН заполняется только в случае, если ИНН объекта отличается от ИНН фирмы" VIEW-AS TEXT
      578             SIZE 81.5 BY .67 AT ROW 8.75 COL 3 WIDGET-ID 138
      579        RECT-1 AT ROW 2.25 COL 1.5 WIDGET-ID 116
      580        SPACE(0.62) SKIP(0.28)
      581       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      582            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      583            TITLE "Настройки для обмена с ЕГАИС"
      584            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      585   ASSIGN
      586          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      587          FRAME Dialog-Frame:HIDDEN           = TRUE.
      588   ASSIGN
      589          B-egais-exsys:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      590   ASSIGN
      591          f-egais-exsys:HIDDEN IN FRAME Dialog-Frame           = TRUE
      592          f-egais-exsys:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      593   ASSIGN
      594          v-egais-exsys:HIDDEN IN FRAME Dialog-Frame           = TRUE
      595          v-egais-exsys:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      596   ASSIGN
      597          v-egais-fsrar:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      598   ASSIGN
      599          v-egais-inn:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      600   ASSIGN
      601          v-egais-utm:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      602   ASSIGN
      603          v-egais-ver-xsd:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      604   ON GO OF FRAME Dialog-Frame
      605   DO:
      606     run save-proc in this-procedure no-error.
      607     if error-status :error then return no-apply.
      608   END.
      609   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      610   DO:
      611     APPLY "END-ERROR":U TO SELF.
      612   END.
      613   ON CHOOSE OF B-egais-exsys IN FRAME Dialog-Frame
      614   DO:
      615   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      616   define variable v-uniq-key-rec as character no-undo .
      617   define variable v-ok as logical no-undo .
      618   run bge/oxmlexts.p (
      619         input parparentproc
      620       , input 2
      621       , input ''
      622       , input v-uniq-key-rec
      623       , output v-rid-list
      624       , output v-ok
      625   ).
      626       if v-ok then do:
      627               v-egais-exsys = int(entry(2,v-rid-list,chr(3))).
      628            find first buf_ext-system no-lock where buf_ext-system.esys-id = v-egais-exsys.
      629                 if AVAILABLE buf_ext-system then do:
      630                    v-egais-exsys = buf_ext-system.esys-id.
      631                    f-egais-exsys = buf_ext-system.esys-name.
      632                    display v-egais-exsys with frame Dialog-Frame .
      633                    display f-egais-exsys with frame Dialog-Frame .
      634            end.
      635       end.
      636   end.
      637   ON LEAVE OF v-egais-exsys IN FRAME Dialog-Frame
      638   DO:
      639     find first buf_ext-system where buf_ext-system.esys-id = v-egais-exsys no-lock no-error.
      640                 if AVAILABLE buf_ext-system then do:
      641                    f-egais-exsys = buf_ext-system.esys-name.
      642                    display v-egais-exsys with frame Dialog-Frame .
      643                    display f-egais-exsys with frame Dialog-Frame .
      644            end.
      645     WAIT-FOR GO OF FRAME Dialog-Frame.
      646   END.
      647   ON LEAVE OF v-egais-inn IN FRAME Dialog-Frame
      648   DO:
      649     disp 1.
      650   END.
      651   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      652   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      653   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   on help of frame Dialog-Frame
      655   do:
      656     run gbl/app_help.p
      657       (input this-procedure :file-name
      658       ,input ''
      659       ,input ?
      660       ) no-error.
      661     if error-status :error then do:
      662       message
      663         "Ошибка при вызове помощи"
      664         error-status :get-message(1)
      665         view-as alert-box .
      666     end.
      667   end.
      668   run minbtn-set in this-procedure .
      669   on choose of b-help in frame Dialog-Frame
      670   do:
      671     apply "help":u to frame Dialog-Frame .
      672   end.
      673   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674   procedure minbtn-set :
      675       do
      676           on error undo, return error return-value
      677           :
      678           define variable ii              as integer       no-undo .
      679           define variable fh              as widget-handle no-undo .
      680           define variable hh              as widget-handle no-undo .
      681           define variable v-h             as handle        extent 4 no-undo .
      682           define variable v-name-button   as character     no-undo .
      683           define variable v-help-old-x    as decimal       no-undo .
      684           define variable v-help-old-y    as decimal       no-undo .
      685           define variable v-help-old-size as decimal       no-undo .
      686           define variable v-frame-width   as decimal       no-undo .
      687           define variable jj              as integer       no-undo .
      688           do
      689               on error undo, return error
      690               :
      691               assign
      692                   v-frame-width = frame Dialog-Frame:width - 0.3
      693                   fh            = frame Dialog-Frame:first-child
      694                   hh            = fh:first-child
      695                   ii            = 1
      696                   .
      697               do while valid-handle(hh):
      698                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      699                   do:
      700                       case lc(hh:name) :
      701                           when "b-help" then
      702                               do:
      703                                   hh:load-image-up("cmp/b-help.bmp":u) .
      704                                   hh:load-image-down("cmp/b-help.bmp":u) .
      705                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      706                                   hh:TOOLTIP = "Помощь" .
      707                                   v-help-old-x = hh:column .
      708                                   v-help-old-y = hh:row    .
      709                                   v-help-old-size = hh:width .
      710                                   hh:width-chars = 2.5 .
      711                               end.
      712                           when "b-print" then
      713                               do:
      714                                   hh:load-image("cmp/b-print.bmp":u) .
      715                                   hh:TOOLTIP = "Печать" .
      716                                   v-h[ii] = hh:handle .
      717                                   ii = ii + 1 .
      718                                   hh:width-chars = 3 .
      719                               end.
      720                           when "b-history" or
      721                           when "b-hist" then
      722                               do:
      723                                   hh:load-image("cmp/b-hist.bmp":u) .
      724                                   hh:TOOLTIP = "История" .
      725                                   v-h[ii] = hh:handle .
      726                                   ii = ii + 1 .
      727                                   hh:width-chars = 3 .
      728                               end.
      729                           when "b-sch" then
      730                               do:
      731                                   hh:load-image("cmp/b-sch.bmp":u) .
      732                                   hh:TOOLTIP = "Установка Фильтра" .
      733                                   v-h[ii] = hh:handle .
      734                                   ii = ii + 1 .
      735                                   hh:width-chars = 3 .
      736                               end.
      737                           when "b-hist-user" then
      738                               do:
      739                                   hh:load-image("cmp/b-hist.bmp":u) .
      740                                   hh:TOOLTIP = "История пользователя" .
      741                                   ii = ii + 1 .
      742                               end.
      743                       end case.
      744                   end.
      745                   hh = hh:next-sibling.
      746               end.
      747               b-help:column = v-frame-width - b-help:width-chars.
      748               jj = 0.
      749               repeat ii = 4 to 1 by -1 :
      750                   if valid-handle (v-h[ii] ) then
      751                   do:
      752                       jj  = jj + 1 .
      753                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      754                       v-h[ii]:row    = v-help-old-y .
      755                   end.
      756               end.
      757           end.
      758       end.
      759   end procedure.
      760   MAIN-BLOCK:
      761   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      762      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      763     if p-obj-type <> "" then do:
      764        FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (if p-obj-type = 'орг':U then " фирма" else " маг") + STRING(p-obj-code) .
      765     end.
      766       RUN init-tt.
      767       RUN enable_UI.
      768       RUN fill-widgets.
      769     WAIT-FOR GO OF FRAME Dialog-Frame.
      770   END.
      771   RUN disable_UI.
      772   PROCEDURE disable_UI :
      773     HIDE FRAME Dialog-Frame.
      774   END PROCEDURE.
      775   PROCEDURE enable_UI :
      776           ENABLE B-exit B-quit B-Help RECT-1
      777           WITH FRAME Dialog-Frame.
      778    if p-obj-type = "" then do:
      779       DISPLAY v-egais-exsys f-egais-exsys
      780         WITH FRAME Dialog-Frame.
      781         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      782           ENABLE v-egais-exsys f-egais-exsys b-egais-exsys
      783           WITH FRAME Dialog-Frame.
      784           HIDE v-egais-fsrar v-egais-utm v-egais-ver-xsd v-egais-inn
      785           IN FRAME Dialog-Frame.
      786         end.
      787    end.
      788    else do:
      789      DISPLAY v-egais-fsrar v-egais-utm v-egais-ver-xsd v-egais-inn
      790         WITH FRAME Dialog-Frame.
      791         if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      792           ENABLE v-egais-fsrar v-egais-utm v-egais-ver-xsd v-egais-inn
      793           WITH FRAME Dialog-Frame.
      794           HIDE v-egais-exsys f-egais-exsys b-egais-exsys
      795           IN FRAME Dialog-Frame.
      796         end.
      797    end.
      798     VIEW FRAME Dialog-Frame.
      799   END PROCEDURE.
      800   PROCEDURE fill-widgets :
      801   define variable v-value-character as character no-undo .
      802   define variable v-value-date as date no-undo .
      803   define variable v-value-decimal as decimal no-undo .
      804   define variable v-value-integer as INTEGER no-undo .
      805   define variable v-value-logical AS LOGICAL no-undo .
      806   define variable v-param-type as character no-undo .
      807   define variable v-param-value as character no-undo .
      808   for each temp-thbj-attr:
      809     delete temp-thbj-attr.
      810   end.
      811   run adm/shattri.p (
      812       input "init":U
      813     , input p-obj-type
      814     , input p-obj-code
      815     , input 'egais':U
      816     , input "":U
      817     , output v-value-character
      818     , output v-value-date
      819     , output v-value-decimal
      820     , output v-value-integer
      821     , output v-value-logical
      822     , output v-param-type
      823     , input-output TABLE-HANDLE v-tth
      824     ) no-error .
      825   if error-status:error then do:
      826     message
      827     "Не удалось получить начальные значения настроек" skip
      828     error-status:get-message(1) return-value
      829     view-as alert-box error .
      830     undo, return error .
      831   end.
      832   FOR EACH temp-thbj-attr
      833     :
      834     if p-obj-type = "" then do:
      835       IF temp-thbj-attr.prop-code = 'egais-exsys':U THEN DO:
      836          find first buf_ext-system no-lock
      837             where buf_ext-system.esys-id = temp-thbj-attr.property-value-integer
      838          no-error.
      839          if AVAILABLE buf_ext-system then do:
      840              v-egais-exsys = buf_ext-system.esys-id.
      841              f-egais-exsys = buf_ext-system.esys-name.
      842              display v-egais-exsys with frame Dialog-Frame .
      843              display f-egais-exsys with frame Dialog-Frame .
      844          end.
      845       END.
      846     end.
      847     else do:
      848       IF temp-thbj-attr.prop-code = 'egais-fsrar':U THEN DO:
      849          v-egais-fsrar = temp-thbj-attr.property-value-character.
      850          display v-egais-fsrar with frame Dialog-Frame .
      851       END.
      852       IF temp-thbj-attr.prop-code = 'egais-utm':U THEN DO:
      853          v-egais-utm = temp-thbj-attr.property-value-character.
      854          display v-egais-utm with frame Dialog-Frame .
      855       END.
      856       IF temp-thbj-attr.prop-code = 'egais-ver-xsd':U THEN DO:
      857          v-egais-ver-xsd = temp-thbj-attr.property-value-character.
      858          display v-egais-ver-xsd with frame Dialog-Frame .
      859       END.
      860       IF temp-thbj-attr.prop-code = 'egais-inn':U THEN DO:
      861          v-egais-inn = temp-thbj-attr.property-value-character.
      862          display v-egais-inn with frame Dialog-Frame .
      863       END.
      864     end.
      865   END.
      866   END PROCEDURE.
      867   PROCEDURE init-tt :
      868   END PROCEDURE.
      869   PROCEDURE save-proc :
      870   define variable v-value-character as character no-undo .
      871   define variable v-value-date as date no-undo .
      872   define variable v-value-decimal as decimal no-undo .
      873   define variable v-value-integer as INTEGER no-undo .
      874   define variable v-value-logical AS LOGICAL no-undo .
      875   define variable v-param-type as character no-undo .
      876   define variable v-gds-copy-list as character no-undo .
      877   define variable v-gdsreffi as character no-undo .
      878   define variable wh as widget-handle no-undo .
      879   define variable fh as widget-handle no-undo .
      880   define variable v-same as logical no-undo .
      881   define buffer buf_temp-thbj-attr for temp-thbj-attr .
      882   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
      883   if p-obj-type = "" then do:
      884   ASSIGN FRAME Dialog-Frame
      885       v-egais-exsys
      886       .
      887       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'egais-exsys':U .
      888       temp-thbj-attr.property-value-integer = v-egais-exsys.
      889   end.
      890   else do:
      891   ASSIGN FRAME Dialog-Frame
      892       v-egais-fsrar
      893       v-egais-utm
      894       v-egais-ver-xsd
      895       v-egais-inn
      896       .
      897       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'egais-fsrar':U .
      898       temp-thbj-attr.property-value-character = v-egais-fsrar.
      899       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'egais-utm':U .
      900       temp-thbj-attr.property-value-character = v-egais-utm.
      901       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'egais-ver-xsd':U .
      902       temp-thbj-attr.property-value-character = v-egais-ver-xsd.
      903       find first temp-thbj-attr where temp-thbj-attr.prop-code = 'egais-inn':U no-error.
      904       if not available (temp-thbj-attr) then do:
      905         create temp-thbj-attr.
      906         find first buf_temp-thbj-attr.
      907         buffer-copy buf_temp-thbj-attr except buf_temp-thbj-attr.prop-value-type to temp-thbj-attr.
      908       end.
      909       temp-thbj-attr.property-value-character = v-egais-inn.
      910   end.
      911       do transaction:
      912           RUN thbjattr_set-section IN THIS-PROCEDURE (
      913                input p-obj-type
      914               ,input p-obj-code
      915               ,input 'egais':U
      916               ,INPUT table temp-thbj-attr
      917           ) NO-ERROR.
      918           if error-status:error then do:
      919               message "Не удалось сохранить настройки"
      920               view-as alert-box.
      921               undo, return error.
      922           end.
      923       end.
      924   END PROCEDURE.
