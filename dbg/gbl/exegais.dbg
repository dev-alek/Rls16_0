      164   procedure thbjattr_code_reg :
      165   define input  parameter p-upper-code     as character no-undo .
      166   define input  parameter p-code           as character no-undo .
      167   define output parameter p-label          as character no-undo .
      168   define output parameter p-user-can-edit  as logical   no-undo .
      169   define output parameter p-output-display as logical   no-undo .
      170   define output parameter p-other          as character no-undo .
