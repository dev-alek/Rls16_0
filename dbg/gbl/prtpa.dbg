      568   procedure twowin_add-item :
      569   define input parameter p-ext-key   as character        no-undo.
      570   define input parameter p-item-name as character        no-undo.
      571   define input parameter p-item-desc as character        no-undo.
      572   define input parameter p-selected  as logical          no-undo.
      573       define buffer buf_temp_twowin_items        for temp_twowin_items.
      574   do
      575   for buf_temp_twowin_items
      576   on error undo, return error
      577   :
      578       assign
      579           v-twowin5-itm-key = v-twowin5-itm-key + 1
      580       .
      581       create temp_twowin_items.
      582       assign
      583           temp_twowin_items.itm-key      = v-twowin5-itm-key
