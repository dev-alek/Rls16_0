     2664   IF thbjattr_thbj-attr-o.prop-code = 'outR':U THEN DO:     outR = thbjattr_thbj-attr-o.property-value-character.     outR:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr-o)).     display outR with frame Dialog-Frame . END.
     2665   IF thbjattr_thbj-attr-o.prop-code = 'outB':U THEN DO:     outB = thbjattr_thbj-attr-o.property-value-character.     outB:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr-o)).     display outB with frame Dialog-Frame . END.
