     2722   PROCEDURE init-proc :
     2723   define variable v-i as integer   no-undo .
     2724   define variable v-value-character as character no-undo .
     2725   define variable v-value-date as date no-undo .
     2726   define variable v-value-decimal as decimal no-undo .
     2727   define variable v-value-integer as INTEGER no-undo .
     2728   define variable v-value-logical AS LOGICAL no-undo .
     2729   define variable v-type as character no-undo .
     2730   define variable v-value as character no-undo .
     2731   define variable v-found as decimal   no-undo .
     2732     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2733     if p-type = "obj":U then do:
     2734       find first obj_thbj-attr exclusive-lock where
     2735                 obj_thbj-attr.obj-type = p-obj-type
     2736           and   obj_thbj-attr.obj-code = p-obj-code
     2737           and   obj_thbj-attr.upper-prop-code = 'prt-obj':U
     2738           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
     2739        if locked obj_thbj-attr then do:
     2740           message
     2741           vss-workfile vss-revision vss-description skip
     2742           'prt-obj':U skip
     2743           "Запись ПАРАМЕТРОВ по объектам занята"
     2744           view-as alert-box error .
     2745           undo, return error.
     2746         end.
     2747      end.
     2748      if p-type = "firm":U then do:
     2749       find first frm_thbj-attr exclusive-lock where
     2750                 frm_thbj-attr.obj-type = v-obj-type
     2751           and   frm_thbj-attr.obj-code = v-obj-code
     2752           and   frm_thbj-attr.upper-prop-code = 'prt-firm':U
     2753           and   frm_thbj-attr.prop-code = '':u no-wait no-error.
     2754        if locked frm_thbj-attr then do:
     2755           message
     2756           vss-workfile vss-revision vss-description skip
     2757           'prt-obj':U skip
     2758           "Запись ПАРАМЕТРОВ по фирмам занята"
     2759           view-as alert-box error .
     2760           undo, return error.
     2761         end.
     2762       end.
     2763       if p-type = "glob":U then do:
     2764       find first glb_thbj-attr exclusive-lock where
     2765                 glb_thbj-attr.obj-type = ""
     2766           and   glb_thbj-attr.obj-code = 0
     2767           and   glb_thbj-attr.upper-prop-code = 'prt-glob':U
     2768           and   glb_thbj-attr.prop-code = '':u no-wait no-error.
     2769        if locked glb_thbj-attr then do:
     2770           message
     2771           vss-workfile vss-revision vss-description skip
     2772           'prt-glob':U skip
     2773           "Запись Глобальных ПАРАМЕТРОВ  занята"
     2774           view-as alert-box error .
     2775           undo, return error.
     2776         end.
     2777        end.
     2778     end.
     2779     else do:
     2780       if p-type = "obj":U then do:
     2781       find first obj_thbj-attr no-lock where
     2782             obj_thbj-attr.obj-type = p-obj-type
     2783       and   obj_thbj-attr.obj-code = p-obj-code
     2784       and   obj_thbj-attr.upper-prop-code = 'prt-obj':U
     2785       and   obj_thbj-attr.prop-code = '':u no-error.
     2786       end.
     2787       if p-type = "glob":U then do:
     2788       find first glb_thbj-attr no-lock where
     2789             glb_thbj-attr.obj-type = ""
     2790       and   glb_thbj-attr.obj-code = 0
     2791       and   glb_thbj-attr.upper-prop-code = 'prt-glob':U
     2792       and   glb_thbj-attr.prop-code = '':u no-error.
     2793       end.
     2794       if p-type = "firm":U then do:
     2795       find first frm_thbj-attr no-lock where
     2796             frm_thbj-attr.obj-type = v-obj-type
     2797       and   frm_thbj-attr.obj-code = v-obj-code
     2798       and   frm_thbj-attr.upper-prop-code = 'prt-firm':U
     2799       and   frm_thbj-attr.prop-code = '':u no-error.
     2800       end.
     2801     end.
     2802   if p-type = "obj":U then do:
     2803     if not available obj_thbj-attr then do:
     2804       assign
     2805         v-to-create-prt  = true
     2806         .
     2807       message
     2808       substitute ("Внимание!!!&1Параметра obj НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2809                   chr(10))
     2810                    view-as alert-box warning.
     2811     end.
     2812   end.
     2813   if p-type = "glob":U then do:
     2814     if not available glb_thbj-attr then do:
     2815       assign
     2816         v-to-create-prt-g  = true
     2817         .
     2818       message
     2819       substitute ("Внимание!!!&1Гл.Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2820                   chr(10))
     2821                    view-as alert-box warning.
     2822     end.
     2823   end.
     2824   if p-type = "firm":U then do:
     2825     if not available frm_thbj-attr then do:
     2826       assign
     2827         v-to-create-prt-f  = true
     2828         .
     2829       message
     2830       substitute ("Внимание!!!&1 firm Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     2831                   chr(10))
     2832                    view-as alert-box warning.
     2833     end.
     2834   end.
     2835     run fill-widgets in this-procedure no-error.
     2836     if error-status:error then undo, return error.
     2837     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     2838        disable
     2839        with frame Dialog-Frame.
     2840        B-exit:label = "Вы&ход"  .
     2841        hide B-quit in frame Dialog-Frame .
     2842     END.
     2843     if p-type = "glob":U then do:
     2844       disable all EXCEPT B-exit B-quit B-Help with frame Dialog-Frame.
     2845       enable
     2846        invprn0  I-invprn0  v-invprn0
     2847         outprncd I-outprncd v-outprncd
     2848         outrecv   I-outrecv B-outrecv v-outrecv
     2849         rep-artic I-rep-artic   v-rep-artic
     2850         outprops  I-outprops  v-outprops
     2851         sort-prd  I-sort-prd    v-sort-prd
     2852         torg2-no   I-torg2-no v-torg2-no
     2853        with frame Dialog-Frame.
     2854     end.
     2855     if p-type = "firm":U then do:
     2856       disable all EXCEPT B-exit B-quit B-Help with frame Dialog-Frame.
     2857       enable
     2858         I-factur01  factur01  v-factur01  B-14
     2859         I-incurrat  incurrat  v-incurrat  B-15
     2860         I-tick-w  tick-w    v-tick-w  B-16
     2861        with frame Dialog-Frame.
     2862     end.
     2863     if p-type = "obj":U then do:
     2864       disable all EXCEPT B-exit B-quit B-Help with frame Dialog-Frame.
     2865       enable
     2866         fgdsnind  B-20  I-fgdsnind  v-fgdsnind
     2867         outssdoc  B-1 I-outssdoc  v-outssdoc
     2868         in-docpr  B-2 I-in-docpr  v-in-docpr
     2869         outR    B-24  I-outR    v-outR
     2870         outB    B-18  I-outb    v-outb
     2871         outogr    B-13  I-outogr  v-outogr
     2872         outC    B-27  I-outc    v-outc
     2873         FILL-IN-1
     2874         outdisc   B-3 I-outdisc   B-outdisc v-outdisc
     2875         outegrp   B-4 I-outegrp B-outegrp v-outegrp
     2876         outobj    B-9   I-outobj  B-outobj  v-outobj
     2877         outappr   B-5 I-outappr B-outappr   v-outappr
     2878         outdate   B-6 I-outdate   B-outdate v-outdate
     2879         outnum    B-8 I-outnum  B-outnum  v-outnum
     2880         outhold   B-7 I-outhold B-outhold v-outhold
     2881         outsubs   B-12  I-outsubs B-outsubs v-outsubs
     2882         outt12    B-25  I-outt12  B-outt12  v-outt12
     2883         outprim   B-26  I-outprim B-outprim v-outprim
     2884         outrubl   B-19  I-outrubl B-outrubl v-outrubl
     2885         outares   B-21  I-outares B-outares v-outares
     2886         outsend   B-22  I-outsend B-outsend v-outsend
     2887         outasend  B-23  I-outasend  B-outasend  v-outasend
     2888        with frame Dialog-Frame.
     2889     end.
     2890   end procedure.
     2891   PROCEDURE init-tt :
     2892       v-obj-type = p-obj-type .
     2893       v-obj-code = p-obj-code .
     2894       if p-obj-type <> 'орг':U  and p-obj-type <> "" then  do:
     2895   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2897     (input  p-obj-type
     2898     ,input  p-obj-code
     2899     ,output v-host-code
     2900     )  .
     2901           v-obj-type = 'орг':U      .
     2902           v-obj-code = v-host-code .
     2903       end.
     2904   END PROCEDURE.
     2905   PROCEDURE save-proc :
     2906   define variable v-value-character as character no-undo .
     2907   define variable v-value-date as date no-undo .
     2908   define variable v-value-decimal as decimal no-undo .
     2909   define variable v-value-integer as INTEGER no-undo .
     2910   define variable v-value-logical AS LOGICAL no-undo .
     2911   define variable v-sale-add as character no-undo .
     2912   define variable v-trf-type like ub.clients.obj-type no-undo .
     2913   define variable v-trf-code like ub.clients.obj-code no-undo .
     2914   define variable v-param-type as character no-undo .
     2915   define variable wh as widget-handle no-undo .
     2916   define variable fh as widget-handle no-undo .
     2917   define variable v-same as logical no-undo .
     2918   define variable v-sameg as logical no-undo .
     2919   define variable v-samef as logical no-undo .
     2920   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     2921   define variable loc#log as logical   no-undo .
     2922   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2923   do:
     2924     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2925       (input  g#db-num
     2926       ,input  g#userid
     2927       ,input  0
     2928       ,input  'actn_nakl-par_update':U
     2929       ,input  'object':U
     2930       ,input  v-cntxt-host-code-obj
     2931       ,input  v-cntxt-obj-type
     2932       ,input  v-cntxt-obj-code
     2933       ,input  0
     2934       ,input  0
     2935       ,input  0
     2936       ,input  true
     2937       ,output loc#log
     2938       )  .
     2939   end.
     2940     if loc#log <> yes then do: return error. end.
     2941   if p-type = "glob" then do:
     2942     ASSIGN
     2943   invprn0 FRAME Dialog-Frame
     2944   outprncd
     2945   outrecv
     2946   rep-artic
     2947   outprops
     2948   sort-prd
     2949   torg2-no
     2950    .
     2951   end.
     2952   if p-type = "obj" then do:
     2953     ASSIGN
     2954       fgdsnind FRAME Dialog-Frame
     2955       in-docpr
     2956       outappr
     2957       outdate
     2958       outdisc
     2959       outegrp
     2960       outhold
     2961       outnum
     2962       outobj
     2963       invprn0
     2964       outprncd
     2965       outrecv
     2966       sort-prd
     2967       torg2-no
     2968       outprops
     2969       outprim
     2970       outrubl
     2971       outssdoc
     2972       outsubs
     2973       outt12
     2974       outares
     2975       outsend
     2976       outasend
     2977       outR
     2978       outB
     2979       outogr
     2980       outC
     2981       rep-artic
     2982    .
     2983   end.
     2984   if p-type = "firm" then do:
     2985     ASSIGN
     2986   factur01
     2987   incurrat
     2988   tick-w
     2989    .
     2990   end.
     2991   assign
     2992     fh = frame Dialog-Frame:first-child
     2993     wh = fh:first-child
     2994     .
     2995   do while valid-handle(wh):
     2996     if wh:private-data begins "recid2=" then do:
     2997       find first thbjattr_thbj-attr-o where
     2998                  recid(thbjattr_thbj-attr-o) = integer(entry(2, wh:private-data, '='))
     2999                  no-error .
     3000       if available thbjattr_thbj-attr-o then do:
     3001       assign
     3002       buffer thbjattr_thbj-attr-o:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3003       end.
     3004     end.
     3005     if wh:private-data begins "recid3=" then do:
     3006       find first thbjattr_thbj-attr-g where
     3007                  recid(thbjattr_thbj-attr-g) = integer(entry(2, wh:private-data, '='))
     3008                  no-error .
     3009       if available thbjattr_thbj-attr-g then do:
     3010           assign
     3011              buffer thbjattr_thbj-attr-g:buffer-field ("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3012       end.
     3013     end.
     3014     if wh:private-data begins "recid4=" then do:
     3015       find first thbjattr_thbj-attr-f where
     3016                  recid(thbjattr_thbj-attr-f) = integer(entry(2, wh:private-data, '='))
     3017                  no-error .
     3018       if available thbjattr_thbj-attr-f then do:
     3019       assign
     3020       buffer thbjattr_thbj-attr-f:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     3021       end.
     3022     end.
     3023     wh = wh:next-sibling.
     3024   end.
     3025   do transaction
     3026   on error undo, return error return-value
     3027   :
     3028     run thbjattr_set-section in this-procedure (
     3029           input p-obj-type
     3030         , input p-obj-code
     3031         , input 'prt-obj':U
     3032         , input table thbjattr_thbj-attr-o
     3033     ) no-error.
     3034     if error-status:error then do:
     3035       message error-status:get-message(1)  skip
     3036       return-value
     3037       view-as alert-box.
     3038       undo, return error.
     3039     end.
     3040     if ( p-obj-type = "" and p-obj-code = 0 ) or p-obj-type = 'орг':U then do:
     3041         run thbjattr_set-section in this-procedure (
     3042               input p-obj-type
     3043             , input p-obj-code
     3044             , input 'prt-firm':U
     3045             , input table thbjattr_thbj-attr-f
     3046         ) no-error.
     3047         if error-status:error then do:
     3048           message error-status:get-message(1)  skip
     3049           return-value
     3050           view-as alert-box.
     3051           undo, return error.
     3052         end.
     3053     end.
     3054     if p-obj-type = "" and p-obj-code = 0  then do:
     3055         run thbjattr_set-section in this-procedure (
     3056               input p-obj-type
     3057             , input p-obj-code
     3058             , input 'prt-glob':U
     3059             , input table thbjattr_thbj-attr-g
     3060         ) no-error.
     3061         if error-status:error then do:
     3062           message error-status:get-message(1)  skip
     3063           return-value
     3064           view-as alert-box.
     3065           undo, return error.
     3066         end.
     3067     end.
     3068   end.
     3069   END PROCEDURE.
     3070   PROCEDURE twowin_custom-add-item :
     3071   DEFINE INPUT PARAMETER p-twowin-handle AS HANDLE NO-UNDO.
     3072   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3073   define variable v-ii as integer no-undo .
     3074   define variable v-is-petrolium as logical no-undo .
     3075   define variable v-is-pieces as logical no-undo .
     3076   define variable v-b-code as integer no-undo .
     3077   define variable v-exists as logical no-undo .
     3078   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     3079   define buffer buf_goods for ub.goods.
     3080   define buffer buf_temp_twowin_items for temp_twowin_items.
     3081   case v-twowin-point :
     3082   end case.
     3083   END PROCEDURE.
     3084   PROCEDURE twowin_get-bttns :
     3085   DEFINE OUTPUT PARAMETER p-bttns as character no-undo .
     3086   if p-mode = 'ПРОСМОТР':U then do:
     3087     p-bttns = "".
     3088   end.
     3089   else do:
     3090     p-bttns = "b-add,b-del,b-up,b-down,b-exit".
     3091   end.
     3092   END PROCEDURE.
