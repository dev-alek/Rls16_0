     2534   END PROCEDURE.
     2535   PROCEDURE fill-widgets :
     2536   define variable v-value-character as character no-undo .
     2537   define variable v-value-date as date no-undo .
     2538   define variable v-value-decimal as decimal no-undo .
     2539   define variable v-value-integer as INTEGER no-undo .
     2540   define variable v-value-logical AS LOGICAL no-undo .
     2541   define variable v-param-type as character no-undo .
     2542   define variable v-param-value as character no-undo .
     2543   for each thbjattr_thbj-attr:
     2544     delete thbjattr_thbj-attr.
     2545   end.
     2546   for each thbjattr_thbj-attr-o:
     2547     delete thbjattr_thbj-attr-o.
     2548   end.
     2549   for each thbjattr_thbj-attr-g:
     2550     delete thbjattr_thbj-attr-g.
     2551   end.
     2552   for each thbjattr_thbj-attr-f:
     2553     delete thbjattr_thbj-attr-f.
     2554   end.
     2555   for each temp-thbj-attr:
     2556     delete temp-thbj-attr.
     2557   end.
     2558   if p-type = 'glob' then do:
     2559   run adm/shattri.p (
     2560       input "init":U
     2561     , input ""
     2562     , input 0
     2563     , input 'prt-glob':U
     2564     , input "":U
     2565     , output v-value-character
     2566     , output v-value-date
     2567     , output v-value-decimal
     2568     , output v-value-integer
     2569     , output v-value-logical
     2570     , output v-param-type
     2571     , input-output TABLE-HANDLE v-tthg
     2572     ) no-error .
     2573   if error-status:error then do:
     2574     message
     2575     "Не удалось получить начальные значения настроек GLOB" skip
     2576     error-status:get-message(1) skip
     2577     return-value
     2578     view-as alert-box error .
     2579     undo, return error .
     2580   end.
     2581   end.
     2582   if p-type = 'firm' then do:
     2583   run adm/shattri.p (
     2584       input "init":U
     2585     , input v-obj-type
     2586     , input v-obj-code
     2587     , input 'prt-firm':U
     2588     , input "":U
     2589     , output v-value-character
     2590     , output v-value-date
     2591     , output v-value-decimal
     2592     , output v-value-integer
     2593     , output v-value-logical
     2594     , output v-param-type
     2595     , input-output TABLE-HANDLE v-tthf
     2596     ) no-error .
     2597   if error-status:error then do:
     2598     message
     2599     "Не удалось получить начальные значения настроек firm" skip
     2600     error-status:get-message(1) return-value
     2601     view-as alert-box error .
     2602     undo, return error .
     2603   end.
     2604   end.
     2605   if p-type = 'obj' then do:
     2606   run adm/shattri.p (
     2607       input "init":U
     2608     , input p-obj-type
     2609     , input p-obj-code
     2610     , input 'prt-obj':U
     2611     , input "":U
     2612     , output v-value-character
     2613     , output v-value-date
     2614     , output v-value-decimal
     2615     , output v-value-integer
     2616     , output v-value-logical
     2617     , output v-param-type
     2618     , input-output TABLE-HANDLE v-ttho
     2619     ) no-error .
     2620   if error-status:error then do:
     2621     message
     2622     "Не удалось получить начальные значения настроек OBJ" skip
     2623     error-status:get-message(1) skip
     2624     return-value skip
     2625     view-as alert-box error .
     2626     undo, return error .
     2627   end.
     2628   end.
     2629   if p-type = "glob" then do:
     2630   FOR EACH thbjattr_thbj-attr-g
     2631   :
     2632   IF thbjattr_thbj-attr-g.prop-code = 'invprn0':U THEN DO:     invprn0 = thbjattr_thbj-attr-g.property-value-logical.     invprn0:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display invprn0 with frame Dialog-Frame . END.
     2633   IF thbjattr_thbj-attr-g.prop-code = 'outprncd':U THEN DO:     outprncd = thbjattr_thbj-attr-g.property-value-logical.     outprncd:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display outprncd with frame Dialog-Frame . END.
     2634   IF thbjattr_thbj-attr-g.prop-code = 'outrecv':U THEN DO:     outrecv = thbjattr_thbj-attr-g.property-value-character.     outrecv:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display outrecv with frame Dialog-Frame . END.
     2635   IF thbjattr_thbj-attr-g.prop-code = 'sort-prd':U THEN DO:     sort-prd = thbjattr_thbj-attr-g.property-value-logical.     sort-prd:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display sort-prd with frame Dialog-Frame . END.
     2636   IF thbjattr_thbj-attr-g.prop-code = 'torg2-no':U THEN DO:     torg2-no = thbjattr_thbj-attr-g.property-value-logical.     torg2-no:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display torg2-no with frame Dialog-Frame . END.
     2637   IF thbjattr_thbj-attr-g.prop-code = 'outprops':U THEN DO:     outprops = thbjattr_thbj-attr-g.property-value-logical.     outprops:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display outprops with frame Dialog-Frame . END.
     2638   IF thbjattr_thbj-attr-g.prop-code = 'rep-artic':U THEN DO:     rep-artic = thbjattr_thbj-attr-g.property-value-logical.     rep-artic:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display rep-artic with frame Dialog-Frame . END.
     2639     create temp-thbj-attr.
     2640     buffer-copy thbjattr_thbj-attr-g to temp-thbj-attr.
     2641   end.
     2642   end.
     2643   if p-type = "obj" then do:
