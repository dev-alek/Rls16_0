     2220   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2221   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2222   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2223   on help of frame Dialog-Frame
     2224   do:
     2225     run gbl/app_help.p
     2226       (input this-procedure :file-name
     2227       ,input ''
     2228       ,input ?
     2229       ) no-error.
     2230     if error-status :error then do:
     2231       message
     2232         "Ошибка при вызове помощи"
     2233         error-status :get-message(1)
     2234         view-as alert-box .
     2235     end.
     2236   end.
     2237   run minbtn-set in this-procedure .
     2238   on choose of b-help in frame Dialog-Frame
     2239   do:
     2240     apply "help":u to frame Dialog-Frame .
     2241   end.
     2242   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2243   procedure minbtn-set :
     2244       do
     2245           on error undo, return error return-value
     2246           :
     2247           define variable ii              as integer       no-undo .
     2248           define variable fh              as widget-handle no-undo .
     2249           define variable hh              as widget-handle no-undo .
     2250           define variable v-h             as handle        extent 4 no-undo .
     2251           define variable v-name-button   as character     no-undo .
     2252           define variable v-help-old-x    as decimal       no-undo .
     2253           define variable v-help-old-y    as decimal       no-undo .
     2254           define variable v-help-old-size as decimal       no-undo .
     2255           define variable v-frame-width   as decimal       no-undo .
     2256           define variable jj              as integer       no-undo .
     2257           do
     2258               on error undo, return error
     2259               :
     2260               assign
     2261                   v-frame-width = frame Dialog-Frame:width - 0.3
     2262                   fh            = frame Dialog-Frame:first-child
     2263                   hh            = fh:first-child
     2264                   ii            = 1
     2265                   .
     2266               do while valid-handle(hh):
     2267                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2268                   do:
     2269                       case lc(hh:name) :
     2270                           when "b-help" then
     2271                               do:
     2272                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2273                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2274                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2275                                   hh:TOOLTIP = "Помощь" .
     2276                                   v-help-old-x = hh:column .
     2277                                   v-help-old-y = hh:row    .
     2278                                   v-help-old-size = hh:width .
     2279                                   hh:width-chars = 2.5 .
     2280                               end.
     2281                           when "b-print" then
     2282                               do:
     2283                                   hh:load-image("cmp/b-print.bmp":u) .
     2284                                   hh:TOOLTIP = "Печать" .
     2285                                   v-h[ii] = hh:handle .
     2286                                   ii = ii + 1 .
     2287                                   hh:width-chars = 3 .
     2288                               end.
     2289                           when "b-history" or
     2290                           when "b-hist" then
     2291                               do:
     2292                                   hh:load-image("cmp/b-hist.bmp":u) .
     2293                                   hh:TOOLTIP = "История" .
     2294                                   v-h[ii] = hh:handle .
     2295                                   ii = ii + 1 .
     2296                                   hh:width-chars = 3 .
     2297                               end.
     2298                           when "b-sch" then
     2299                               do:
     2300                                   hh:load-image("cmp/b-sch.bmp":u) .
     2301                                   hh:TOOLTIP = "Установка Фильтра" .
     2302                                   v-h[ii] = hh:handle .
     2303                                   ii = ii + 1 .
     2304                                   hh:width-chars = 3 .
     2305                               end.
     2306                           when "b-hist-user" then
     2307                               do:
     2308                                   hh:load-image("cmp/b-hist.bmp":u) .
     2309                                   hh:TOOLTIP = "История пользователя" .
     2310                                   ii = ii + 1 .
     2311                               end.
     2312                       end case.
     2313                   end.
     2314                   hh = hh:next-sibling.
     2315               end.
     2316               b-help:column = v-frame-width - b-help:width-chars.
     2317               jj = 0.
     2318               repeat ii = 4 to 1 by -1 :
     2319                   if valid-handle (v-h[ii] ) then
     2320                   do:
     2321                       jj  = jj + 1 .
     2322                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2323                       v-h[ii]:row    = v-help-old-y .
     2324                   end.
     2325               end.
     2326           end.
     2327       end.
     2328   end procedure.
     2329      outR:Radio-BUTTONS in frame Dialog-Frame   = "Не печатать,no_print,Руководитель фирмы,ruk_firm,Директор объекта,dir_obj" .
     2330      outB:Radio-BUTTONS in frame Dialog-Frame   = "Не печатать,no_print,Гл. бух. фирмы,glbuh_firm,Бухгалтер объекта,buh_obj"  .
     2331      outogr:Radio-BUTTONS in frame Dialog-Frame  = "Не печатать,no_print,Руководитель фирмы,ruk_firm,Директор объекта,dir_obj,Менеджер документа,manag_doc".
     2332      outC:Radio-BUTTONS in frame Dialog-Frame   = "Не печатать,no_print,Кладовщик документа,clad_doc,Кладовщик объекта,clad_obj"  .
     2333   MAIN-BLOCK:
     2334   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2335      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2336   if p-obj-type <> "" then
     2337      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
     2338   define variable loc#log as logical   no-undo .
     2339   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2340   do:
     2341     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2342       (input  g#db-num
     2343       ,input  g#userid
     2344       ,input  0
     2345       ,input  'actn_nakl-par_lookup':U
     2346       ,input  'object':U
     2347       ,input  v-cntxt-host-code-obj
     2348       ,input  v-cntxt-obj-type
     2349       ,input  v-cntxt-obj-code
     2350       ,input  0
     2351       ,input  0
     2352       ,input  0
     2353       ,input  true
     2354       ,output loc#log
     2355       )  .
     2356   end.
     2357      if loc#log <> yes then do: return error. end.
     2358       run init-tt.
     2359       run enable_UI.
     2360       run init-proc.
     2361       fl = 'new' .
     2362     WAIT-FOR GO OF FRAME Dialog-Frame.
     2363   END.
     2364   run disable_UI.
     2365   PROCEDURE disable_UI :
     2366     HIDE FRAME Dialog-Frame.
     2367   END PROCEDURE.
     2368   PROCEDURE enable_UI :
     2369     if p-type = "glob" then
     2370     do:
     2371       DISPLAY FILL-IN-4
     2372         invprn0  I-invprn0  v-invprn0
     2373         outprncd I-outprncd v-outprncd
     2374         outrecv   I-outrecv B-outrecv v-outrecv
     2375         rep-artic I-rep-artic   v-rep-artic
