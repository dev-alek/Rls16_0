      448           itmExtKey
      449   .
      450   define temp-table temp_onewin_itemsSelected no-undo
      451       field its-key   as integer
      452       field itm-key   as integer
      453       field itmExtKey as character
      454       index pi is primary unique
      455           its-key
      456       index im
      457           itm-key
      458   .
      459   define variable v-onewin4-itm-key    as integer      no-undo.
      460   procedure onewin_clear :
      461       define buffer buf_temp_onewin_items        for temp_onewin_items.
      462   do
      463   for buf_temp_onewin_items
      464   on error undo, return error
      465   :
      466       empty temp-table buf_temp_onewin_items.
      467   end.
      468   end procedure.
      469   procedure onewin_add-item :
      470   define input parameter p-ext-key   as character        no-undo.
      471   define input parameter p-item-name as character        no-undo.
      472   define input parameter p-item-desc as character        no-undo.
      473   define input parameter p-selected  as logical          no-undo.
      474       define buffer buf_temp_onewin_items        for temp_onewin_items.
      475   do
      476   for buf_temp_onewin_items
      477   on error undo, return error
      478   :
      479       find last buf_temp_onewin_items no-error.
      480       if available buf_temp_onewin_items then do:
      481         v-onewin4-itm-key = buf_temp_onewin_items.itm-key.
      482       end.
      483       else do:
      484         v-onewin4-itm-key = 0.
      485       end.
      486       assign
      487           v-onewin4-itm-key = v-onewin4-itm-key + 1
      488       .
      489       create buf_temp_onewin_items.
      490       assign
      491       buf_temp_onewin_items.itm-key      = v-onewin4-itm-key
      492       buf_temp_onewin_items.itmExtKey    = p-ext-key
      493       buf_temp_onewin_items.itmName      = p-item-name
      494       buf_temp_onewin_items.itmDesc      = p-item-desc
      495       buf_temp_onewin_items.itmSelected  = p-selected
      496       .
      497   end.
      498   end procedure.
      499   procedure onewin_create-selection :
      500   define input parameter p-itm-key as integer no-undo .
      501   define input parameter p-itmextkey as character no-undo .
      502   define variable v-counter as integer no-undo .
      503   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      504   do
      505   on error undo, return error
      506   :
      507     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      508     if available buf_temp_onewin_itemsSelected then do:
      509       v-counter = buf_temp_onewin_itemsSelected.its-key.
      510     end.
      511     find first buf_temp_onewin_itemsSelected where
      512          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      513     if not available buf_temp_onewin_itemsSelected then do:
      514       create buf_temp_onewin_itemsSelected.
      515       assign
      516       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      517       v-counter = v-counter + 1
      518       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      519       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      520       .
      521     end.
      522   end.
      523   end procedure.
      524   procedure onewin_check-item :
      525   define input parameter p-ext-key   as character        no-undo.
      526   define output parameter p-exists as logical no-undo .
      527   define buffer buf_temp_onewin_items for temp_onewin_items.
      528   find first buf_temp_onewin_items where
      529   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      530   if available buf_temp_onewin_items then do:
      531     p-exists = yes.
      532   end.
      533   end procedure.
