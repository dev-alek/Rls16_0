      131   procedure thbjattr_code :
      132      define input  parameter p-upper-code     as character no-undo .
      133      define input  parameter p-code           as character no-undo .
      134      define output parameter p-label          as character no-undo .
      135      define output parameter p-user-can-edit  as logical   no-undo .
      136      define output parameter p-output-display as logical   no-undo .
      137      define output parameter p-other          as character no-undo .
      138      define output parameter p-prop-list      as character no-undo .
      139      define output parameter p-prop-type-list as character no-undo .
      140      define output parameter p-prop-label-list as character no-undo .
      141      define output parameter p-global          as logical no-undo .
      142      define output parameter p-host           as logical no-undo .
      143      define output parameter p-shop           as logical no-undo .
      144      define output parameter p-store          as logical no-undo .
      145      define output parameter p-db             as logical no-undo .
      146      define variable p-region as logical no-undo.
      147      run thbjattr_code_reg in this-procedure (
      148                                               p-upper-code,
      149                                               p-code,
      150                                               output p-label,
      151                                               output p-user-can-edit,
      152                                               output p-output-display,
      153                                               output p-other,
      154                                               output p-prop-list,
      155                                               output p-prop-type-list,
      156                                               output p-prop-label-list,
      157                                               output p-global,
      158                                               output p-host,
      159                                               output p-shop,
      160                                               output p-store,
      161                                               output p-db,
      162                                               output p-region
      163                                               ).
