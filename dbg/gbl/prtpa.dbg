     1560   ON CHOOSE OF B-outappr IN FRAME Dialog-Frame
     1561   DO:
     1562    if p-mode = 'ПРОСМОТР':U then return .
     1563       run twowin_clear in this-procedure.
     1564       define variable v-accepted      as logical      no-undo.
     1565       define variable v-cur-ext-key   as character    no-undo.
     1566       run twowin_add-item in this-procedure ( input "",  input   "ПУСТО" , input "" , input no ).
     1567       run twowin_add-item in this-procedure ( input 'torg12',  input  "ТОРГ12", input "Печатная форма ТОРГ-12",            input (if lookup ('torg12' , outappr ) > 0 then  true  else false )  ).
     1568       run twowin_add-item in this-procedure ( input 'torg13',  input  "ТОРГ13", input "Печатная форма ТОРГ-13",            input (if lookup ('torg13' , outappr ) > 0 then  true  else false )  ).
     1569       run twowin_add-item in this-procedure ( input 'torg16',  input  "ТОРГ16", input "Печатная форма ТОРГ-16",            input (if lookup ('torg16' , outappr ) > 0 then  true  else false )  ).
     1570       run twowin_add-item in this-procedure ( input 'factur',  input  "Счет-фактура", input "Печатная форма Счет-фактура", input (if lookup ('factur' , outappr ) > 0 then  true  else false )  ).
     1571       run twowin_add-item in this-procedure ( input 'schet',   input  "Счет",         input "Печатная форма Счет",         input (if lookup ('schet'  , outappr ) > 0 then  true  else false )  ).
     1572       run gbl/twowin.w (
     1573             input ?
     1574           , input 1
     1575           , input "Выбор из списка форм"
     1576           , input ""
     1577           , input ""
     1578           , input table temp_twowin_items
     1579           , output table temp_twowin_itemsSelected_col
     1580           , output v-cur-ext-key
     1581           , output v-accepted
     1582       ).
     1583       if v-accepted and can-find (first temp_twowin_itemsSelected_col) then do:
     1584       outappr = ''.
     1585       for each temp_twowin_itemsSelected_col
     1586       :
     1587         outappr = outappr + temp_twowin_itemsSelected_col.itmExtKey + "," .
     1588       end.
     1589       outappr = trim(outappr,"," ).
     1590    end.
     1591    DISPLAY outappr with FRAME Dialog-Frame.
     1592   END.
