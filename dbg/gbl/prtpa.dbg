     2039       run twowin_add-item in this-procedure ( input 'factur',   input  "Счет-фактура", input "Печатная форма Счет-фактура",                      input ( if lookup ('factur',  outsubs ) > 0 then  true  else false )  ).
     2040       run twowin_add-item in this-procedure ( input 'facturn',   input  "Счет-фактура с окр", input "Печатная форма Счет-фактура с округлением", input ( if lookup ('facturn',  outsubs ) > 0 then  true  else false ) ).
     2041       run twowin_add-item in this-procedure ( input 'schet',    input  "Счет",         input "Печатная форма Счет",                              input ( if lookup ('schet',   outsubs ) > 0 then  true  else false )  ).
     2042       run twowin_add-item in this-procedure ( input 'oldinp',   input  "Приходная Накладная", input "Печатная форма по ПН",                      input ( if lookup ('oldinp',  outsubs ) > 0 then  true  else false )  ).
     2043       run twowin_add-item in this-procedure ( input 'oldexp',   input  "Накладная Расходная", input "Печатная форма по РН",                      input ( if lookup ('oldexp',  outsubs ) > 0 then  true  else false )  ).
     2044       run gbl/twowin.w (
     2045             input ?
     2046           , input 1
     2047           , input "Выбор из списка форм"
     2048           , input ""
     2049           , input ""
     2050           , input table temp_twowin_items
     2051           , output table temp_twowin_itemsSelected_col
     2052           , output v-cur-ext-key
     2053           , output v-accepted
     2054       ).
     2055       if v-accepted and can-find (first temp_twowin_itemsSelected_col) then do:
     2056       outsubs = ''.
     2057       for each temp_twowin_itemsSelected_col
     2058       :
     2059         outsubs = outsubs + temp_twowin_itemsSelected_col.itmExtKey + "," .
     2060       end.
     2061       outsubs = trim(outsubs,"," ).
     2062    end.
     2063    DISPLAY outsubs with FRAME Dialog-Frame.
     2064   END.
     2065   ON CHOOSE OF B-outt12 IN FRAME Dialog-Frame
     2066   DO:
     2067    if p-mode = 'ПРОСМОТР':U then return .
