        1   block-level on error undo, throw.
        2   define input parameter  p-action as character no-undo .
        3   define output parameter p-permit as logical no-undo .
        4   def var vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
        5   def var vss-author      as character no-undo init "$Author: DRuban $":U .
        6   def var vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
        7   def var vss-workfile    as character no-undo init "$Workfile: authoriz_main.p $":U .
        8   def var vss-archive     as character no-undo init "$Archive: gbl/authoriz_main.p $":U .
        9   def var vss-description as character no-undo init "Программа авторизации пользователя для выполнения определенного действия".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure cur-time :
       70      define output parameter p-today as date      no-undo .
       71      define output parameter p-time  as integer   no-undo .
       72     do
       73     on error undo, return error
       74     :
       75       define variable v-date1 as date      no-undo .
       76       define variable v-date2 as date      no-undo .
       77       define variable v-time  as integer   no-undo .
       78       assign
       79         v-date1 = today
       80         v-time  = time
       81         v-date2 = today
       82       .
       83       if v-date1 <> v-date2
       84       then do:
       85         assign
       86           v-date1 = today
       87           v-time  = v-time
       88         .
       89       end.
       90       assign
       91         p-today = v-date1
       92         p-time  = v-time
       93       .
       94     end.
       95   end.
       96   function cur-time-date returns character
       97   :
       98     return string(today, '99/99/9999':U) .
       99   end.
      100   function cur-time-mjd returns decimal
      101   :
      102     define variable v-date as date      no-undo .
      103     define variable v-time as integer   no-undo .
      104     run cur-time in this-procedure
      105       (output v-date
      106       ,output v-time
      107       ) .
      108     return integer(v-date) - 2400002 + (v-time / 86400) .
      109   end.
      110   function cur-time-get-ending-index returns integer
      111   (input p-number as integer
      112   )
      113   :
      114     if p-number < 0
      115     or p-number = ?
      116     then do:
      117       return 1 .
      118     end.
      119     define variable v-rest as integer   no-undo .
      120     assign
      121       p-number = p-number modulo 100
      122     .
      123     if p-number < 20
      124     then do:
      125       assign
      126         v-rest = p-number
      127       .
      128     end.
      129     else do:
      130       assign
      131         v-rest = p-number modulo 10
      132       .
      133     end.
      134     case v-rest :
      135       when 1
      136       then do:
      137         return 2 .
      138       end.
      139       when 2 or
      140       when 3 or
      141       when 4
      142       then do:
      143         return 3 .
      144       end.
      145       otherwise do:
      146         return 1 .
      147       end.
      148     end case .
      149   end.
      150   procedure cur-time-mjd-to-date :
      151      define input  parameter i-mjd-diff as decimal no-undo.
      152      define output parameter o-Date     as date    no-undo.
      153      define output parameter o-Time     as integer no-undo.
      154      define variable v-day-number as integer   no-undo .
      155      if    i-mjd-diff < 0
      156         or i-mjd-diff = ?
      157      then do:
      158         return "?" .
      159      end.
      160      assign
      161         v-day-number = truncate(i-mjd-diff,0).
      162         o-Date = date(v-day-number + 2400002).
      163         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      164     .
      165   end.
      166   function cur-time-mjd-to-string returns character
      167   (input p-mjd-diff as decimal
      168   )
      169   :
      170     define variable v-day-number as integer   no-undo .
      171     define variable v-seconds    as integer   no-undo .
      172     define variable v-hour       as integer   no-undo .
      173     define variable v-min        as integer   no-undo .
      174     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      175     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      176     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      177     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      178     if p-mjd-diff < 0
      179     or p-mjd-diff = ?
      180     then do:
      181       return "?" .
      182     end.
      183     assign
      184       v-day-number = integer(truncate(p-mjd-diff,0))
      185       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187     if v-seconds > 86400
      188     then do:
      189       assign
      190         v-seconds = 86400 - 1
      191       .
      192     end.
      193     if v-seconds < 0
      194     then do:
      195       assign
      196         v-seconds = 0
      197       .
      198     end.
      199     assign
      200       v-hour = truncate(v-seconds / 3600, 0)
      201     .
      202     assign
      203       v-seconds = v-seconds modulo 3600
      204     .
      205     assign
      206       v-min = truncate(v-seconds / 60, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 60
      210     .
      211     return
      212         (if v-day-number <> 0
      213           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      214           else ""
      215         )
      216       + (if v-day-number <> 0 or v-hour <> 0
      217           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      218           else ""
      219         )
      220       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      221           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      222           else ""
      223         )
      224       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      225       .
      226   end.
      227   function cur-time-string returns character
      228   :
      229     define variable v-date as date      no-undo .
      230     define variable v-time as integer   no-undo .
      231     run cur-time in this-procedure
      232       (output v-date
      233       ,output v-time
      234       ) .
      235     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      236   end.
      237   function cur-time-string-sec returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      246   end.
      247   function cur-time-custom  returns character
      248   (input p-prefix as character
      249   ,input p-date-format as character
      250   ,input p-delimiter as character
      251   ,input p-time-format as character
      252   ,input p-suffix as character
      253   )
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return
      262       p-prefix
      263       + string(v-date, p-date-format)
      264       + p-delimiter
      265       + string(v-time, p-time-format)
      266       + p-suffix
      267       .
      268   end.
      269   function cur-time-print  returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-datetime returns datetime
      280   :
      281     define variable v-char as character no-undo .
      282     define variable v-datetime as datetime no-undo .
      283     v-char = cur-time-string().
      284     v-datetime = datetime(v-char).
      285     return  v-datetime.
      286   end.
      287   function cur-time-string-msec returns character
      288   :
      289     define variable v-date as datetime  no-undo .
      290     v-date = now.
      291     return string(v-date) .
      292   end.
      293   if not ibs.th.gbl.gbl-var:rcode  and not session:debug-alert
      294   then do:
      295      p-permit = yes.
      296      return.
      297   end.
      298   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      299   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      300   define variable v-today as date      no-undo.
      301   define variable v-time  as integer   no-undo.
      302   assign
      303     p-permit = false
      304   .
      305   FUNCTION make-num-string RETURN CHAR
      306   ( input in-str as character )
      307   :
      308     def var v-out-str as character no-undo .
      309     assign
      310       v-out-str = ''
      311     .
      312     def var ind as integer no-undo .
      313     do ind = 1 to length(in-str) :
      314       assign
      315         v-out-str = v-out-str + string(asc( substring(in-str, ind, 1)) - asc(' '))
      316       .
      317     end.
      318     return v-out-str .
      319   end.
      320   def var v-user-name as character no-undo .
      321   def var passwd as character no-undo .
      322   run input-user-and-passwd in this-procedure
      323     (output v-user-name
      324     ,output passwd
      325     ) no-error .
      326   if error-status :error then do:
      327     return .
      328   end.
      329   case passwd :
      330     when "request" then do:
      331       run request-passwd in this-procedure .
      332     end.
      333     when "generate" then do:
      334       run generate-passwd in this-procedure .
      335     end.
      336     when "rndgen" then do:
      337       run random-passwd in this-procedure .
      338     end.
      339     otherwise do:
      340       run check-passwd in this-procedure
      341         (input  v-user-name
      342         ,input  passwd
      343         ) .
      344     end.
      345   end.
      346   return .
      347   procedure input-user-and-passwd :
      348     define output parameter p-user-name as character no-undo .
      349     define output parameter p-password  as character no-undo .
      350     assign
      351       p-user-name = 'sysadm'
      352     .
      353     define buffer buf__User for ub._User .
      354     find first buf__User no-lock
      355       where buf__User._Userid = p-user-name
      356       no-error .
      357     if not available buf__User then do:
      358       run gbl/d-prompt.w (
      359           'title=Введите имя пользователя\'
      360         + 'text1=Введите имя пользователя\'
      361         + 'format=x(20)\'
      362         + 'type=char\'
      363         ,input-output p-user-name
      364         ).
      365       if return-value = 'false':u then do:
      366         return error .
      367       end.
      368     end.
      369     find first buf__User no-lock
      370       where buf__User._Userid = p-user-name
      371       no-error .
      372     if not available buf__User then do:
      373       message
      374         "Пользователь" p-user-name "недоступен"
      375         view-as alert-box .
      376       return error .
      377     end.
      378     run gbl/d-prompt.w (
      379         'title=Password Prompter\':u
      380       + 'text1=Enter password for user "':u + p-user-name + '"\':u
      381       + 'text2=or enter "request" to receive one time password (generate, rndgen)\':u
      382       + 'format=x(40)\':u
      383       + 'password=yes\':u
      384       + 'type=char\':u
      385       ,input-output p-password
      386       ).
      387     if return-value = 'false':u then do:
      388       return error .
      389     end.
      390   end procedure.
      391   procedure generate-passwd :
      392     def var v-passwd as character no-undo .
      393     def var v-seed as character no-undo .
      394     if not objSrv:SystemSetting:DeveloperMode
      395     then do:
      396        run gbl/d-prompt.w (
      397           'title=One time password generation\'
      398         + 'text1=Enter password\'
      399         + 'format=x(40)\'
      400         + 'password=yes\'
      401         + 'type=char\'
      402         ,input-output v-passwd
      403         ).
      404        if encode(v-passwd) <> "idZiiziQdcZKcbba" then do:
      405          run trg/userlog.p (
      406                    input 'one-pwd'
      407                   , input ("Введен неправильный пароль для генерации одноразового пароля"  + chr(3) + program-name(3) )
      408                   , input ?
      409                   , input ?
      410                   , input "") no-error.
      411          message
      412            "Incorrect one time generation password"
      413          view-as alert-box error .
      414          return .
      415        end.
      416     end.
      417     run gbl/d-prompt.w (
      418         'title=One time password\'
      419       + 'text1=Input client seed\'
      420       + 'format=x(40)\'
      421       + 'type=char\'
      422       ,input-output v-seed
      423       ).
      424     assign
      425       v-passwd = make-num-string(substring(encode( 'ab' + v-seed ), 1, 7))
      426     .
      427     run gbl/d-prompt.w (
      428         'title=One time password\'
      429       + 'text1=Client seed: "' + v-seed + '"\'
      430       + 'text2=Send this password to the client\'
      431       + 'format=x(40)\'
      432       + 'type=char\'
      433       ,input-output v-passwd
      434       ).
      435       run trg/userlog.p (
      436                   input 'one-pwd'
      437                   , input ("Сгенерирован одноразовый пароль"  + chr(3) + program-name(3) )
      438                   , input ?
      439                   , input ?
      440                   , input "") no-error.
      441   end procedure.
      442   procedure request-passwd :
      443     def var v-passwd         as character no-undo .
      444     def var v-seed           as character no-undo .
      445     def var v-new-seed       as character no-undo .
      446     def var v-must-be-passwd as character no-undo .
      447     run cur-time in this-procedure ( output v-today
      448                                    , output v-time
      449                                    ).
      450     assign
      451       v-seed = make-num-string
      452               (substring
      453                 ( encode( p-action + string ( v-today ) + string(etime) )
      454                 , 1
      455                 , 7
      456                 )
      457               )
      458     .
      459     assign
      460       v-passwd = v-seed
      461     .
      462     assign
      463       v-must-be-passwd = make-num-string(substring(encode( 'ab' + v-seed ), 1, 7))
      464     .
      465     def var ind as integer no-undo .
      466     do ind = 1 to 3
      467     :
      468       run gbl/d-prompt.w (
      469           'title=Password Prompter\'
      470         + 'text1=Give seed "' + v-seed + '" to developers of system\'
      471         + 'text2=Enter recieved password\'
      472         + 'format=x(40)\'
      473         + 'type=char\'
      474         ,input-output v-passwd
      475         ).
      476       if return-value = 'false':u then do:
      477         return .
      478       end.
      479       if v-passwd = v-must-be-passwd then do:
      480          run trg/userlog.p (
      481                   input 'one-pwd'
      482                   , input (substitute( "Введен правильный одноразовый пароль попытка № &1",ind)  + chr(3) + program-name(3) )
      483                   , input ?
      484                   , input ?
      485                   , input "") no-error.
      486         run permit-action in this-procedure .
      487         return .
      488       end.
      489       run trg/userlog.p (
      490                   input 'one-pwd'
      491                   , input (substitute( "Введен неправильный одноразовый пароль попытка № &1",ind)  + chr(3) + program-name(3) )
      492                   , input ?
      493                   , input ?
      494                   , input "") no-error.
      495       if ind < 3 then do:
      496         message
      497           "One-time password incorrect" skip
      498           "Try once more" skip
      499           view-as alert-box error .
      500       end.
      501       else do:
      502         message
      503           "One-time password incorrect" skip
      504           view-as alert-box error .
      505       end.
      506     end.
      507   end procedure.
      508   procedure check-passwd :
      509     define input  parameter p-user-name as character no-undo .
      510     define input  parameter p-password  as character no-undo .
      511     define buffer buf__User for ub._User .
      512     find first buf__User no-lock
      513       where buf__User._Userid = p-user-name
      514       no-error .
      515     if not available buf__User then do:
      516       message
      517         "Пользователь" p-user-name "недоступен"
      518         view-as alert-box .
      519       return error .
      520     end.
      521     if encode(p-password) = buf__User._Password or objSrv:SystemSetting:DeveloperMode then do:
      522        run trg/userlog.p (
      523                   input 'one-pwd'
      524                   , input (substitute("Введен пароль для &1", p-user-name)  + chr(3) + program-name(3) )
      525                   , input ?
      526                   , input ?
      527                   , input "") no-error.
      528       run permit-action in this-procedure .
      529     end.
      530     else do:
      531       run trg/userlog.p (
      532                   input 'one-pwd'
      533                   , input (substitute("Неправильно введен пароль для &1", p-user-name)  + chr(3) + program-name(3) )
      534                   , input ?
      535                   , input ?
      536                   , input "") no-error.
      537       message
      538         "Неправильно введен пароль для " p-user-name
      539         view-as alert-box .
      540     end.
      541   end procedure.
      542   procedure random-passwd :
      543     def var ind as integer no-undo .
      544     def var v-passwd as character no-undo .
      545     assign
      546       v-passwd = ""
      547     .
      548     do ind = 1 to 5
      549     :
      550       assign
      551         v-passwd = v-passwd + chr( random( asc('a'), asc('z') ) )
      552       .
      553     end.
      554     do ind = 1 to 3
      555     :
      556       assign
      557         v-passwd =  v-passwd + string(random( 0, 9 ))
      558       .
      559     end.
      560     message
      561       "Random password" skip
      562       v-passwd skip
      563       encode(v-passwd) skip
      564       view-as alert-box .
      565   end procedure.
      566   procedure permit-action :
      567     do
      568     on error undo, return error
      569     :
      570       assign
      571         p-permit = true
      572       .
      573     end.
      574   end procedure.
