        1   define input  parameter parparentproc         as widget-handle no-undo .
        2   define input  parameter p-title               as character no-undo .
        3   define input  parameter p-text                as character no-undo .
        4   define input  parameter p-delimiter           as character no-undo .
        5   define input  parameter p-buttons-visible     as character no-undo .
        6   define input  parameter p-buttons             as character no-undo .
        7   define input  parameter p-buttons-description as character no-undo .
        8   define input  parameter p-default-button      as integer   no-undo .
        9   define input  parameter p-cancel-button       as integer   no-undo .
       10   define input  parameter p-text-button         as character no-undo .
       11   define input  parameter p-curr-obj-type       as character no-undo .
       12   define input  parameter p-curr-obj-code       as integer no-undo .
       13   define input  parameter p-shift-date          as date no-undo .
       14   define input  parameter p-shift-num           as integer no-undo .
       15   define input  parameter p-shift-name          as character no-undo .
       16   define output parameter p-number              as character no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Универсальный диалог для задания вопроса и выбора действия".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41       assign
       42         p-vss-parameters = substitute('&1|&2':u,p-buttons,p-text)
       43       .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   function fnc-convert-dot-to-colon returns character
       87       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
       88   function fnc-convert-dot-to-colon returns character
       89   (input p-data as decimal, input p-accur as character, input p-num as integer):
       90       define variable result as character no-undo.
       91       define variable v-str-result as character no-undo.
       92       if p-data = ? then p-data = 0 .
       93       p-data = round(p-data, p-num).
       94       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
       95       return v-str-result.
       96   END FUNCTION.
       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  stream PrnLibStream.
       99   procedure prn-lib-prn-file :
      100     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      101     define input parameter p-DIsabledoptions as integer no-undo .
      102     define variable v-report-name as character no-undo .
      103     define variable v-user-action as character no-undo .
      104     define variable v-printed     as logical   no-undo .
      105     define variable v-exist       as logical   no-undo .
      106     do
      107       on error undo, return error
      108       :
      109       run prn-lib-get-report-name  in this-procedure (
      110         input parParentProc
      111         ,output v-report-name
      112         ).
      113   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      115     (input  v-report-name
      116     ,input  2
      117     ,output v-exist
      118     )  .
      119       if NOT v-exist then
      120       DO:
      121         Message
      122           "Нет заданий на печать ! "
      123           view-as alert-box .
      124         Return  .
      125       End.
      126       run gbl/prnfilen.w
      127         (input  ""
      128         ,input  p-DisabledOptions
      129         ,input  string(v-report-name )
      130         ,input  7
      131         ,output v-user-action
      132         ,output v-printed
      133         ) .
      134       if v-printed then
      135       do:
      136         return "YES" .
      137       end.
      138       else
      139       do:
      140         return "NO" .
      141       end.
      142     end.
      143   end procedure.
      144   procedure prn-lib-open-stream :
      145     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      146     define input parameter p-page-size    as integer no-undo .
      147     define input parameter p-is-stream    as logical no-undo .
      148     define input parameter p-append       as logical no-undo .
      149     define variable v-report-name as character no-undo .
      150     do
      151       on error undo, return error
      152       :
      153       run prn-lib-get-report-name  in this-procedure (
      154         input parParentProc
      155         ,output v-report-name
      156         ).
      157       if p-is-stream then
      158       do:
      159         if p-append then
      160         do:
      161           output stream PrnLibStream to value( v-report-name )
      162             page-size value(p-page-size) append .
      163         end.
      164         if not p-append then
      165         do:
      166           output stream PrnLibStream to value( v-report-name )
      167             page-size value(p-page-size) .
      168         end.
      169       end.
      170       if not p-is-stream then
      171       do:
      172         if p-append then
      173         do:
      174           output to value( v-report-name )
      175             page-size value(p-page-size) append .
      176         end.
      177         if not p-append then
      178         do:
      179           output to value( v-report-name )
      180             page-size value(p-page-size) .
      181         end.
      182       end.
      183     end.
      184   end procedure.
      185   procedure prn-lib-open-exp :
      186     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      187     define input parameter p-is-stream    as logical no-undo .
      188     define input parameter p-is-append    as logical no-undo .
      189     define output parameter p-ReportFileName as char init "report" no-undo.
      190     define output parameter p-process as logical no-undo .
      191     define variable glog as logical no-undo .
      192     do
      193       on error undo, return error
      194       :
      195       SYSTEM-DIALOG GET-FILE p-ReportFileName
      196         TITLE      "Укажите путь"
      197         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      198         ASK-OVERWRITE
      199         CREATE-TEST-FILE
      200         SAVE-AS
      201         USE-FILENAME
      202         DEFAULT-EXTENSION "txt"
      203         UPDATE glog
      204         .
      205       if not glog then  return.
      206       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      207       if p-is-stream then
      208       do:
      209         if p-is-append then
      210         do:
      211           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      212         end.
      213         else
      214         do:
      215           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      216         end.
      217       end.
      218       else
      219       do:
      220         if p-is-append then
      221         do:
      222           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      223         end.
      224         else
      225         do:
      226           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      227         end.
      228       end.
      229       p-process = yes.
      230     end.
      231   end procedure.
      232   procedure prn-lib-get-report-name :
      233     define input parameter parParentProc  as widget-handle no-undo.
      234     define output parameter p-report-name as character no-undo .
      235     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      236   end procedure.
      237   procedure prn-lib-reportviewer-report-name :
      238     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      239     define input parameter p-report-name-html as character no-undo .
      240     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      241   end procedure.
      242   procedure prn-lib-reportviewer :
      243     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      244     define input parameter p-report-name-html as character no-undo .
      245     define input parameter p-param        as character no-undo .
      246     define variable v-excel           as character no-undo init 'TRUE' .
      247     define variable v-value-character as character no-undo .
      248     define variable v-value-integer   as character no-undo .
      249     define variable v-value-date      as date      no-undo .
      250     define variable v-value-decimal   as decimal   no-undo .
      251     define variable rep-excel         as logical   no-undo .
      252     define variable excel-string      as character no-undo .
      253     define variable v-param-type      as character no-undo .
      254     define variable v-tth             as handle    no-undo .
      255     run adm/shattri.p (
      256       input "get":U
      257       ,input  ""
      258       ,input  0
      259       ,input  'report-glob':U
      260       ,input  'rep-excel':U
      261       ,output v-value-character
      262       ,output v-value-date
      263       ,output v-value-decimal
      264       ,output v-value-integer
      265       ,output rep-excel
      266       ,output v-param-type
      267       ,INPUT-OUTPUT table-handle v-tth
      268       )  .
      269     if rep-excel then v-excel = "TRUE" .
      270     else v-excel = "FALSE" .
      271     if p-param eq ""
      272     then
      273        p-param = "EXCEL:" + v-excel.
      274     else
      275        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      276     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      277   end procedure.
      278   define  shared temp-table tt-susp-chk no-undo like ub.susp-chk .
      279   define variable mCodeMes as char no-undo.
      280   if num-entries(p-title,"|") > 1
      281       then
      282       assign
      283           mCodeMes = entry(2,p-title,"|")
      284           p-title  = entry(1,p-title,"|")
      285           .
      286   define variable v-buttons          as integer   no-undo.
      287   define variable v-need-confirm     as logical   no-undo extent 5 .
      288   define variable v-first-delimiter  as character no-undo init "|" .
      289   define variable v-second-delimiter as character no-undo init "^" .
      290   define stream Out-Stream .
      291   define stream OutStr-html.
      292   function Str-chk-type returns character
      293       (input p-chk-type as character) forward .
      294   DEFINE BUTTON Btn_1
      295        LABEL "&1"
      296        SIZE 15 BY 1.21
      297        BGCOLOR 8 .
      298   DEFINE BUTTON Btn_2 AUTO-GO
      299        LABEL "&2"
      300        SIZE 15 BY 1.21
      301        BGCOLOR 8 .
      302   DEFINE BUTTON Btn_3 AUTO-GO
      303        LABEL "&3"
      304        SIZE 15 BY 1.21
      305        BGCOLOR 8 .
      306   DEFINE BUTTON Btn_cancel AUTO-GO
      307        LABEL "Отмена"
      308        SIZE 15 BY 1.21
      309        BGCOLOR 8 .
      310   DEFINE BUTTON Btn_close AUTO-GO
      311        LABEL "Закрыть смену с расхождениями"
      312        SIZE 41 BY 1.21
      313        BGCOLOR 8 .
      314   DEFINE BUTTON Btn_print
      315        LABEL "&Печать"
      316        SIZE 15 BY 1.21
      317        BGCOLOR 8 .
      318   DEFINE VARIABLE description-1 AS CHARACTER
      319        VIEW-AS EDITOR
      320        SIZE 41 BY 2 NO-UNDO.
      321   DEFINE VARIABLE description-2 AS CHARACTER
      322        VIEW-AS EDITOR
      323        SIZE 41 BY 2 NO-UNDO.
      324   DEFINE VARIABLE description-3 AS CHARACTER
      325        VIEW-AS EDITOR
      326        SIZE 41 BY 2 NO-UNDO.
      327   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      328        VIEW-AS EDITOR
      329        SIZE 41 BY 2
      330        FGCOLOR 4  NO-UNDO.
      331   DEFINE FRAME Dialog-Frame
      332        Btn_1 AT ROW 4.21 COL 45
      333        Btn_2 AT ROW 6.29 COL 45
      334        Btn_3 AT ROW 8.38 COL 45
      335        Btn_close AT ROW 10.25 COL 3
      336        Btn_cancel AT ROW 10.25 COL 45
      337        EDITOR-1 AT ROW 1.67 COL 3 NO-LABEL
      338        description-1 AT ROW 3.79 COL 3 NO-LABEL
      339        description-2 AT ROW 5.88 COL 3 NO-LABEL
      340        description-3 AT ROW 8 COL 3 NO-LABEL
      341        Btn_print AT ROW 2.17 COL 45 WIDGET-ID 2
      342        SPACE(1.74) SKIP(8.69)
      343       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      344            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      345            TITLE "Вопрос".
      346   ASSIGN
      347          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      348          FRAME Dialog-Frame:HIDDEN           = TRUE.
      349   ASSIGN
      350          Btn_1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      351   ASSIGN
      352          Btn_2:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      353   ASSIGN
      354          Btn_3:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      355   ASSIGN
      356          Btn_cancel:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      357   ASSIGN
      358          Btn_close:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      359   ASSIGN
      360          Btn_print:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      361   ASSIGN
      362          description-1:HIDDEN IN FRAME Dialog-Frame           = TRUE
      363          description-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      364   ASSIGN
      365          description-2:HIDDEN IN FRAME Dialog-Frame           = TRUE
      366          description-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      367   ASSIGN
      368          description-3:HIDDEN IN FRAME Dialog-Frame           = TRUE
      369          description-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      370   ASSIGN
      371          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      372   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      373   DO:
      374           RETURN NO-APPLY .
      375       END.
      376   ON CHOOSE OF Btn_1 IN FRAME Dialog-Frame
      377   DO:
      378           if v-need-confirm [1] then
      379           do:
      380               define variable lok as logical no-undo .
      381               assign
      382                   lok = false
      383                   .
      384               message
      385                   self :label skip
      386                   "" (if description-1 :visible
      387                   then description-1 :screen-value
      388                   else ""
      389                   ) skip
      390                   "Продолжить?"
      391                   view-as alert-box question buttons yes-no update lok .
      392               if lok <> true then
      393               do:
      394                   return no-apply .
      395               end.
      396           end.
      397           assign
      398               p-number = entry(1,p-text-button,v-first-delimiter)
      399               .
      400           if p-number <> "cancel" and p-number <> "closeWith" then
      401           do:
      402               run diff-number no-error.
      403           end.
      404       END.
      405   ON CHOOSE OF Btn_2 IN FRAME Dialog-Frame
      406   DO:
      407           if v-need-confirm [2] then
      408           do:
      409               define variable lok as logical no-undo .
      410               assign
      411                   lok = false
      412                   .
      413               message
      414                   self :label skip
      415                   "" (if description-2 :visible
      416                   then description-2 :screen-value
      417                   else ""
      418                   ) skip
      419                   "Продолжить?"
      420                   view-as alert-box question buttons yes-no update lok .
      421               if lok <> true then
      422               do:
      423                   return no-apply .
      424               end.
      425           end.
      426           assign
      427               p-number = entry(2,p-text-button,v-first-delimiter)
      428               .
      429           if p-number <> "cancel" and p-number <> "closeWith" then
      430           do:
      431               run diff-number no-error.
      432               Btn_2:auto-go in frame Dialog-Frame = false.
      433           end.
      434       END.
      435   ON CHOOSE OF Btn_3 IN FRAME Dialog-Frame
      436   DO:
      437           if v-need-confirm [3] then
      438           do:
      439               define variable lok as logical no-undo .
      440               assign
      441                   lok = false
      442                   .
      443               message
      444                   self :label skip
      445                   "" (if description-3 :visible
      446                   then description-3 :screen-value
      447                   else ""
      448                   ) skip
      449                   "Продолжить?"
      450                   view-as alert-box question buttons yes-no update lok .
      451               if lok <> true then
      452               do:
      453                   return no-apply .
      454               end.
      455           end.
      456           assign
      457               p-number = entry(3,p-text-button,v-first-delimiter)
      458               .
      459           if p-number <> "cancel" and p-number <> "closeWith" then
      460           do:
      461               run diff-number no-error.
      462               Btn_3:auto-go in frame Dialog-Frame = false.
      463           end.
      464       END.
      465   ON CHOOSE OF Btn_cancel IN FRAME Dialog-Frame
      466   DO:
      467           assign
      468               p-number = "cancel"
      469               .
      470       END.
      471   ON CHOOSE OF Btn_close IN FRAME Dialog-Frame
      472   DO:
      473           assign
      474               p-number = "closeWith"
      475               .
      476       END.
      477   ON CHOOSE OF Btn_print IN FRAME Dialog-Frame
      478   DO:
      479           run proc-b-print in this-procedure no-error.
      480           if error-status:error then return no-apply.
      481       END.
      482   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      483       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      484   do with frame Dialog-Frame:
      485       assign
      486           frame Dialog-Frame :title = p-title
      487           .
      488       if length (p-delimiter) >= 1 then
      489       do:
      490           assign
      491               v-first-delimiter = substring(p-delimiter, 1, 1)
      492               .
      493       end.
      494       if length (p-delimiter) >= 2 then
      495       do:
      496           assign
      497               v-second-delimiter = substring(p-delimiter, 2, 1)
      498               .
      499       end.
      500       assign
      501           v-buttons = num-entries(p-buttons, v-first-delimiter)
      502           editor-1  = p-text
      503           .
      504       if v-buttons > 5 then
      505       do:
      506           message
      507               vss-workfile vss-revision vss-description skip
      508               "Количество кнопок больше четырех" skip
      509               "p-buttons" p-buttons skip
      510               view-as alert-box .
      511           undo, return error .
      512       end.
      513       if v-buttons <> num-entries(p-buttons-description, v-first-delimiter) then
      514       do:
      515           message
      516               vss-workfile vss-revision vss-description skip
      517               "Ошибка задания входных параметров" skip
      518               "Количество описаний кнопок не совпадает с количество кнопок" skip
      519               "Кнопок" v-buttons skip
      520               "Описаний кнопок" num-entries(p-buttons-description) skip
      521               view-as alert-box error .
      522           undo, return error .
      523       end.
      524       define variable ii                as integer   no-undo .
      525       define variable v-but             as integer   no-undo .
      526       define variable v-but-text        as character no-undo .
      527       define variable v-desc-text       as character no-undo .
      528       define variable v-visible-buttons as logical   no-undo .
      529       do ii = 1 to v-buttons
      530           :
      531           v-visible-buttons  = logical(entry(ii,p-buttons-visible, v-first-delimiter)) .
      532           if v-visible-buttons then
      533           do:
      534               if v-but = 0 then
      535               do:
      536                   assign
      537                       v-but-text  = entry(ii, p-buttons, v-first-delimiter)
      538                       v-desc-text = entry(ii, p-buttons-description, v-first-delimiter)
      539                       v-but       = v-but + 1 .
      540                   .
      541               end.
      542               else
      543               do:
      544                   assign
      545                       v-but-text  = v-but-text + v-first-delimiter + entry(ii, p-buttons, v-first-delimiter)
      546                       v-desc-text = v-desc-text + v-first-delimiter + entry(ii, p-buttons-description, v-first-delimiter)
      547                       v-but       = v-but + 1
      548                       .
      549               end.
      550           end.
      551       end.
      552       v-buttons = v-but .
      553       p-buttons-description = v-desc-text .
      554       p-buttons = v-but-text .
      555       p-cancel-button = v-buttons .
      556       p-default-button = p-cancel-button - 1 .
      557       define variable v-button-handle             as handle no-undo extent 5 .
      558       define variable v-button-description-handle as handle no-undo extent 5 .
      559       assign
      560           v-button-handle[1]             = Btn_1         :handle
      561           v-button-handle[2]             = Btn_2         :handle
      562           v-button-handle[3]             = Btn_3         :handle
      563           v-button-handle[4]             = Btn_close         :handle
      564           v-button-handle[5]             = Btn_cancel         :handle
      565           v-button-description-handle[1] = description-1 :handle
      566           v-button-description-handle[2] = description-2 :handle
      567           v-button-description-handle[3] = description-3 :handle
      568           .
      569       define variable v-handle             as handle no-undo .
      570       define variable v-handle-description as handle no-undo .
      571       if  p-default-button > 0
      572           and p-default-button <= v-buttons
      573           then
      574       do:
      575           assign
      576               v-handle = v-button-handle[p-default-button]
      577               .
      578           assign
      579               v-handle :default                   = true
      580               frame Dialog-Frame :default-button = v-handle
      581               .
      582       end.
      583       else
      584       do:
      585           message
      586               vss-workfile vss-revision vss-description skip
      587               "Не задана кнопка по умолчанию" skip
      588               "p-default-button" p-default-button skip
      589               view-as alert-box .
      590           undo, return error .
      591       end.
      592       if  p-cancel-button > 0
      593           and p-cancel-button <= v-buttons
      594           then
      595       do:
      596           assign
      597               v-handle = v-button-handle[p-cancel-button]
      598               .
      599           assign
      600               frame Dialog-Frame :cancel-button = v-handle
      601               .
      602       end.
      603       else
      604       do:
      605           message
      606               vss-workfile vss-revision vss-description skip
      607               "Не задана кнопка выбираемая при нажатии Escape" skip
      608               "p-cancel-button" p-cancel-button skip
      609               view-as alert-box .
      610           undo, return error .
      611       end.
      612       if  v-buttons > 1
      613           and p-cancel-button = p-default-button then
      614       do:
      615           message
      616               vss-workfile vss-revision vss-description skip
      617               "Номер кнопки по умолчанию совпадает с номером кнопки выбираемой при нажатии Escape" skip
      618               "p-default-button" p-default-button skip
      619               "p-cancel-button"  p-cancel-button  skip
      620               view-as alert-box .
      621       end.
      622       define variable ind as integer no-undo .
      623       do ind = 1 to v-buttons
      624           :
      625           assign
      626               v-handle             = v-button-handle[ind]
      627               v-handle-description = v-button-description-handle[ind]
      628               .
      629           define variable v-button-text      as character no-undo .
      630           define variable v-description-text as character no-undo .
      631           define variable l-sensitive        as logical   no-undo .
      632           define variable l-confirm          as logical   no-undo .
      633           define variable v-btn-text-ind     as integer   no-undo .
      634           assign
      635               v-button-text      = entry(ind, p-buttons, v-first-delimiter)
      636               v-description-text = entry(ind, p-buttons-description, v-first-delimiter)
      637               v-visible-buttons  = logical(entry(ind,p-buttons-visible, v-first-delimiter))
      638               l-sensitive        = true
      639               l-confirm          = false
      640               .
      641           define variable v-button-attribute as character no-undo .
      642           do v-btn-text-ind = 2 to num-entries(v-button-text, v-second-delimiter )
      643               :
      644               assign
      645                   v-button-attribute = entry(v-btn-text-ind, v-button-text, v-second-delimiter)
      646                   .
      647               case v-button-attribute :
      648                   when 'disable' then
      649                       do:
      650                           assign
      651                               l-sensitive = false
      652                               .
      653                       end.
      654                   when 'confirm' then
      655                       do:
      656                           assign
      657                               l-confirm = true
      658                               .
      659                       end.
      660                   otherwise
      661                   do:
      662                       message
      663                           vss-workfile vss-revision vss-description skip
      664                           "Неизвестный атрибут кнопки" skip
      665                           "Атрибут" v-button-attribute skip
      666                           "Описание кнопки" ind skip
      667                           v-button-text skip
      668                           view-as alert-box error .
      669                   end.
      670               end case .
      671           end.
      672           if num-entries (v-button-text, v-second-delimiter ) >= 1 then
      673           do:
      674               assign
      675                   v-button-text = entry(1, v-button-text, v-second-delimiter)
      676                   .
      677           end.
      678           assign
      679               v-need-confirm [ind] = l-confirm
      680               .
      681           assign
      682               v-handle :label     = v-button-text
      683               v-handle :visible   = true
      684               v-handle :sensitive = l-sensitive
      685               .
      686           if v-description-text = "" then
      687           do:
      688               assign
      689                   v-handle :width = min(max(v-handle :width
      690                                    ,length(v-button-text) + 2
      691                                    )
      692                                ,frame Dialog-Frame :width - v-handle :column - 1
      693                                )
      694                   .
      695           end.
      696           if v-description-text <> "" then
      697           do:
      698               assign
      699                   v-handle-description :visible      = true
      700                   v-handle-description :sensitive    = true
      701                   v-handle-description :read-only    = true
      702                   v-handle-description :screen-value = v-description-text
      703                   .
      704           end.
      705       end.
      706   end.
      707   on cursor-left anywhere
      708       do:
      709           apply "back-tab":u to focus .
      710       end.
      711   on cursor-right anywhere
      712       do:
      713           apply "tab":u to focus .
      714       end.
      715   MAIN-BLOCK:
      716   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      717       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      718       def var mAnswer as char no-undo.
      719       publish "ResponseToQuestion" (output mAnswer ).
      720       p-number = (mAnswer) no-error.
      721       if error-status:error
      722           then
      723       do:
      724           define variable mbeg as integer no-undo.
      725           mbeg = index("," + mAnswer   , "," + mcodemes + "=") .
      726           mAnswer = substring (mAnswer, mbeg + length(mcodemes) + 1).
      727           mAnswer = entry(1,mAnswer).
      728           p-number = (mAnswer) no-error.
      729           if error-status:error
      730               then
      731           block-num:
      732           do mbeg = 1 to num-entries (mAnswer):
      733               p-number = entry(mbeg, mAnswer) no-error.
      734               if not error-status:error
      735                   then
      736                   leave block-num.
      737           end.
      738       end.
      739       if   p-number eq ""
      740           then
      741       do:
      742           RUN enable_UI.
      743           if  p-default-button > 0
      744               and p-default-button <= v-buttons
      745               then
      746           do:
      747               assign
      748                   v-handle = v-button-handle[p-default-button]
      749                   .
      750               apply 'entry':u to v-handle .
      751           end.
      752           WAIT-FOR GO OF FRAME Dialog-Frame.
      753       end.
      754   END.
      755   RUN disable_UI.
      756   RETURN.
      757   PROCEDURE disable_UI :
      758     HIDE FRAME Dialog-Frame.
      759   END PROCEDURE.
      760   PROCEDURE enable_UI :
      761       DISPLAY EDITOR-1 Btn_print Btn_close Btn_cancel
      762           WITH FRAME Dialog-Frame.
      763       ENABLE EDITOR-1 Btn_print Btn_cancel Btn_close
      764           WITH FRAME Dialog-Frame.
      765       VIEW FRAME Dialog-Frame.
      766   END PROCEDURE.
      767   procedure diff-number:
      768       define variable v-ok as logical no-undo .
      769       case p-number:
      770           when "errorMass" then
      771               do:
      772                   run str/diffShiftClose.w (
      773                       input parparentproc,
      774                       input 'ПРОСМОТР':U,
      775                       input p-curr-obj-type,
      776                       input p-curr-obj-code,
      777                       input p-shift-date,
      778                       input p-shift-num,
      779                       input p-shift-name,
      780                       input "diff-mass",
      781                       output v-ok)  .
      782               end.
      783           when "errorTRK" then
      784               do:
      785                   run str/diffShiftClose.w (
      786                       input parparentproc,
      787                       input 'ПРОСМОТР':U,
      788                       input p-curr-obj-type,
      789                       input p-curr-obj-code,
      790                       input p-shift-date,
      791                       input p-shift-num,
      792                       input p-shift-name,
      793                       input "diff-TRK",
      794                       output v-ok) no-error .
      795               end.
      796           when "errorCheck" then
      797               do:
      798                   run str/susp-chk.w (
      799                       input parparentproc,
      800                       input 'ПРОСМОТР':U,
      801                       input p-curr-obj-type,
      802                       input p-curr-obj-code,
      803                       input p-shift-date,
      804                       input p-shift-num,
      805                       input p-shift-name,
      806                       output table tt-susp-chk,
      807                       output v-ok) no-error .
      808               end .
      809       end.
      810   end.
      811   PROCEDURE proc-b-print :
      812       define VARIABLE p-report-id         as character no-undo .
      813       define variable v-file-name-rep-htm as character no-undo .
      814       define variable dev-paid-trans      as decimal   no-undo .
      815       define variable prc-dev-mass        as decimal   no-undo .
      816       define buffer buf_shiftParam for ub.shift-param .
      817       define buffer buf_goods      for ub.goods .
      818       define buffer buf_susp-chk   for ub.susp-chk .
      819       define buffer bf_shift-obj   for ub.shift-obj .
      820       run get-report-num (output p-report-id).
      821       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      822       find first bf_shift-obj no-lock where bf_shift-obj.obj-code = p-curr-obj-code and
      823           bf_shift-obj.obj-type = p-curr-obj-type and
      824           bf_shift-obj.shift-date = p-shift-date and
      825           bf_shift-obj.Shift-num = p-shift-num no-error .
      826       if not available (bf_shift-obj) then return error.
      827       find first buf_shiftParam no-lock where buf_shiftParam.obj-code = bf_shift-obj.obj-code and
      828           buf_shiftParam.obj-type = bf_shift-obj.obj-type and
      829           buf_shiftParam.shift-date = bf_shift-obj.shift-date and
      830           buf_shiftParam.shift-num = bf_shift-obj.shift-num and
      831           buf_shiftParam.gds-code = 0 and
      832           buf_shiftParam.pl-code = 0 no-error .
      833       if not available (buf_shiftParam) then
      834       do:
      835           find first buf_shiftparam no-lock where buf_shiftparam.obj-code = 0 and
      836               buf_shiftparam.obj-type = "" and
      837               buf_shiftparam.shift-date = 01/01/1900 no-error .
      838           if not available (buf_shiftparam) then
      839           do:
      840               assign
      841                   prc-dev-mass   = 0.65
      842                   dev-paid-trans = 1
      843                   .
      844           end.
      845           else
      846           do:
      847               assign
      848                   prc-dev-mass   = buf_shiftparam.prc-dev-mass
      849                   dev-paid-trans = buf_shiftparam.dev-paid-trans
      850                   .
      851           end.
      852       end.
      853       else
      854           assign
      855               dev-paid-trans = buf_shiftParam.dev-paid-trans
      856               prc-dev-mass   = buf_shiftParam.prc-dev-mass
      857               .
      858       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      859       put stream OutStr-html unformatted
      860           "<!DOCTYPE HTML>" skip
      861           ' <html>' skip
      862           '  <head>' skip
      863           '   <meta charset="utf-8">' skip
      864           '    <style type="text/css">' skip
      865           '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      866           '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      867           '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      868           '   </style>' skip
      869           '  </head>' skip
      870           .
      871       put stream OutStr-html unformatted
      872           '<body>' skip
      873           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      874           '<thead>' skip
      875           .
      876       put stream OutStr-html unformatted
      877           '<tr class="set_columns">' skip
      878           '<td style="width: 100px;"></td>' skip
      879           '<td style="width: 200px;"></td>' skip
      880           '<td style="width: 100px;"></td>' skip
      881           '<td style="width: 150px;"></td>' skip
      882           '<td style="width: 150px;"></td>' skip
      883           '<td style="width: 150px;"></td>' skip
      884           '<td style="width: 150px;"></td>' skip
      885           '<td style="width: 150px;"></td>' skip
      886           '<td style="width: 350px;"></td>' skip
      887           '</tr>' skip
      888           .
      889       put stream OutStr-html unformatted
      890           '<tr>' skip
      891           '<td colspan="9" style="text-align: left;">АЗК №' + string(bf_shift-obj.obj-code) + ' </td>' skip
      892           '</tr>' skip
      893           .
      894       put stream OutStr-html unformatted
      895           '<tr>' skip
      896           '<td colspan="9" style="text-align: center; font-weight: bold;">Выявленные ошибки при закрыии смены</td>' skip
      897           '</tr>' skip
      898           .
      899       put stream OutStr-html unformatted
      900           '<tr>' skip
      901           '<td colspan="9" style="text-align: left;">Смена: ' + string(p-shift-num) + ' от ' + string(p-shift-date,"99.99.9999") + '</td>' skip
      902           '</tr>' skip
      903           .
      904       put stream OutStr-html unformatted
      905           '<tr style="height:25px;">' skip
      906           '<td colspan="9" style="text-align: left;"></td>' skip
      907           '</tr>' skip
      908           .
      909       put stream OutStr-html unformatted
      910           '</thead>' skip
      911           '<tbody>' skip.
      912       v-visible-buttons = false .
      913       v-visible-buttons  = logical(entry(1,p-buttons-visible, v-first-delimiter)) .
      914       if v-visible-buttons then do:
      915       put stream OutStr-html unformatted
      916           '<TR style="height:55px;">' skip
      917           '<TD text_wrap="true" colspan="9" style="text-align: center; font-weight:bold;">Проверка отклонений по 1 части сменного отчета. Отклонение между расчетной и фактической массой топлива на конец смены.</TD>' skip
      918           '</tr>' skip
      919           '<tr>' skip
      920           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Код топлива</TD>' skip
      921           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
      922           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
      923           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Расч. остаток на конец смены, кг</TD>' skip
      924           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. остаток на конец смены, кг</TD>' skip
      925           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Допустимое отклонение, кг</TD>' skip
      926           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Факт. отклонение по остаткам, кг</TD>' skip
      927           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, кг</TD>' skip
      928           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина расхождения/номер заявки в ЦДС</TD>' skip
      929           '</TR>'skip
      930           .
      931       for each buf_shiftParam no-lock
      932           where buf_shiftParam.obj-code = p-curr-obj-code
      933           and buf_shiftParam.obj-type = p-curr-obj-type
      934           and buf_shiftParam.shift-date = p-shift-date
      935           and buf_shiftParam.shift-num = p-shift-num
      936           and buf_shiftParam.error-mass:
      937           find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
      938           if not available (buf_goods) then next .
      939           put stream OutStr-html unformatted
      940               '<TR>' skip
      941               '<TD text_wrap="true">' + string(buf_goods.gds-code) + '</TD>' skip
      942               '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
      943               '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
      944               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.system-cli-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.system-cli-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      945               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.fact-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.fact-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      946               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.dev-mass <> ? then fnc-convert-dot-to-colon(buf_shiftParam.dev-mass,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      947               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-stock-end <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-stock-end,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      948               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end),">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end) <> ? then fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-mass - buf_shiftParam.diff-stock-end),">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
      949               '<TD text_wrap="true" style="width: 350px;">' + string(buf_shiftParam.disc-diffMass) + '</TD>' skip
      950               '</tr>' skip
      951               .
      952       end.
      953       put stream OutStr-html unformatted
      954           '<thead>' skip
      955           '<TR  style="height:25px;">' skip
      956           '<TD text_wrap="true" colspan="9" style="text-align: left;">* Процент допустимого отклонения массы топлива = ' + string(prc-dev-mass,"9.99") + '%</TD>' skip
      957           '</tr>' skip
      958           '<TR  style="height:25px;">' skip
      959           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
      960           '</tr>' skip
      961           '<TR  style="height:25px;">' skip
      962           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
      963           '</tr>' skip
      964           .
      965       put stream OutStr-html unformatted
      966           '<TR  style="height:25px;">' skip
      967           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
      968           '</tr>' skip
      969           '</thead>' skip
      970           .
      971       end.
      972       v-visible-buttons = false .
      973       v-visible-buttons  = logical(entry(2,p-buttons-visible, v-first-delimiter)) .
      974       if v-visible-buttons then do:
      975       put stream OutStr-html unformatted
      976           '<TR style="height:55px;">' skip
      977           '<TD text_wrap="true" height:25px; colspan="9" style="text-align: center; font-weight:bold;">Проверка отклонений по 9 части сменного отчета. Отклонения между объемом продаж топлива на кассе и объемом по счетчикам ТРК.</TD>' skip
      978           '</tr>' skip
      979           '<tr>' skip
      980           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Код топлива</TD>' skip
      981           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Наименование</TD>' skip
      982           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ резервуара</TD>' skip
      983           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж на кассе, л</TD>' skip
      984           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Объем продаж по счетчикам ТРК, л</TD>' skip
      985           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Техпролив, л</TD>' skip
      986           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Разница по кассе и ТРК, л</TD>' skip
      987           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Превышение допустимого отклонения на, л</TD>' skip
      988           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина расхождения/номер заявки в ЦДС</TD>' skip
      989           '</TR>'skip
      990           .
      991       for each buf_shiftParam no-lock
      992           where buf_shiftParam.obj-code = p-curr-obj-code
      993           and buf_shiftParam.obj-type = p-curr-obj-type
      994           and buf_shiftParam.shift-date = p-shift-date
      995           and buf_shiftParam.shift-num = p-shift-num
      996           and buf_shiftParam.error-paid-trans:
      997           find first buf_goods no-lock where buf_goods.gds-code = buf_shiftParam.gds-code no-error .
      998           if not available (buf_goods) then next .
      999           put stream OutStr-html unformatted
     1000               '<TR>' skip
     1001               '<TD text_wrap="true">' + string(buf_goods.gds-code) + '</TD>' skip
     1002               '<TD text_wrap="true">' + buf_goods.gds-name + '</TD>' skip
     1003               '<TD text_wrap="true" style="text-align: center;">' + string(buf_shiftParam.loc1) + '</TD>' skip
     1004               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.cash-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.cash-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1005               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.meas-qnty <> ? then fnc-convert-dot-to-colon(buf_shiftParam.meas-qnty,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1006               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.tech-refuell <> ? then fnc-convert-dot-to-colon(buf_shiftParam.tech-refuell,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1007               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if buf_shiftParam.diff-cash-trk <> ? then fnc-convert-dot-to-colon(buf_shiftParam.diff-cash-trk,"->>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1008               '<td text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk),">>>>>>>>>>>>>9.99",2) + '" style="text-align: center;">' + if absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk) <> ? then fnc-convert-dot-to-colon(absolute(buf_shiftParam.dev-paid-trans - buf_shiftParam.diff-cash-trk),">>>>>>>>>>>9.99",2) + '</td>' else "" + '</td>' skip
     1009               '<TD text_wrap="true" style="width: 350px;">' + string(buf_shiftParam.disc-diffTRK) + '</TD>' skip
     1010               '</tr>' skip
     1011               .
     1012       end.
     1013       put stream OutStr-html unformatted
     1014           '<thead>' skip
     1015           '<TR style="height:25px;">' skip
     1016           '<TD text_wrap="true" colspan="9" style="text-align: left;">*Допустимое отклонение между объемом продаж топлива на кассе и объемом по счетчикам ТРК = ' + string(dev-paid-trans,"9.99") + 'л</TD>' skip
     1017           '</tr>' skip
     1018           '<TR style="height:25px;">' skip
     1019           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
     1020           '</tr>' skip
     1021           '<TR style="height:25px;">' skip
     1022           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
     1023           '</tr>' skip
     1024           .
     1025       put stream OutStr-html unformatted
     1026           '<TR style="height:25px;">' skip
     1027           '<TD text_wrap="true" colspan="9" style="text-align: left;"></TD>' skip
     1028           '</tr>' skip
     1029           '</thead>' skip
     1030           .
     1031   end.
     1032       v-visible-buttons = false .
     1033       v-visible-buttons  = logical(entry(3,p-buttons-visible, v-first-delimiter)) .
     1034       if v-visible-buttons then do:
     1035       put stream OutStr-html unformatted
     1036           '<TR style="height:55px;">' skip
     1037           '<TD text_wrap="true" colspan="9" style="text-align: center; font-weight:bold;">"Подозрительные" чеки.</TD>' skip
     1038           '</tr>' skip
     1039           '<tr>' skip
     1040           '<TD text_wrap="true" colspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Признак</TD>' skip
     1041           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека в ТН</TD>' skip
     1042           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Тип чека</TD>' skip
     1043           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ чека на кассе</TD>' skip
     1044           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">№ кассы</TD>' skip
     1045           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Дата/время</TD>' skip
     1046           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Причина возникновения чека</TD>' skip
     1047           '<TD text_wrap="true" style="text-align: center; font-weight:bold; background-color: silver;">Ссылка на "корректный" чек</TD>' skip
     1048           '</TR>' skip
     1049           .
     1050       for each buf_susp-chk no-lock
     1051           where buf_susp-chk.obj-code = p-curr-obj-code
     1052           and buf_susp-chk.obj-type = p-curr-obj-type
     1053           and buf_susp-chk.shift-date = p-shift-date
     1054           and buf_susp-chk.shift-num = p-shift-num:
     1055           put stream OutStr-html unformatted
     1056               '<TR>' skip
     1057               '<TD text_wrap="true" colspan="2" style="text-align: center;">' + buf_susp-chk.office + '</TD>' skip
     1058               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.doc-code) + '</TD>' skip
     1059               '<TD text_wrap="true" style="text-align: center;">' + Str-chk-type(string(buf_susp-chk.chk-type)) + '</TD>' skip
     1060               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.chk-num) + '</TD>' skip
     1061               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.pay-desk) + '</TD>' skip
     1062               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.chk-date,"99.99.9999") + '/' + string(buf_susp-chk.chk-time,"hh:mm") + '</TD>' skip
     1063               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.reason-name) + '</TD>' skip
     1064               '<TD text_wrap="true" style="text-align: center;">' + string(buf_susp-chk.link-chk) + '</TD>' skip
     1065               '</tr>' skip
     1066               .
     1067       end.
     1068       end.
     1069       put stream OutStr-html unformatted
     1070           '</tbody>' skip .
     1071       put stream OutStr-html unformatted
     1072           '</table>' skip
     1073           '</body>' skip
     1074           '</html>' skip
     1075           .
     1076       output stream OutStr-html close.
     1077       run prn-lib-reportviewer-report-name in this-procedure (
     1078           input parparentproc
     1079           ,input v-file-name-rep-htm
     1080           ) .
     1081       if error-status:error then
     1082       do:
     1083           message return-value view-as alert-box.
     1084           return .
     1085       end.
     1086   END PROCEDURE.
     1087   PROCEDURE get-report-num :
     1088       define output parameter p-report-num as integer no-undo .
     1089       do
     1090           on error undo, return error return-value
     1091           :
     1092           run gbl/getrpnum.p (output p-report-num).
     1093       end.
     1094   END PROCEDURE.
     1095   function Str-chk-type returns character
     1096       (input p-chk-type as character):
     1097       define variable v-num-element   as integer   no-undo.
     1098       define variable p-name-chk-type as character no-undo .
     1099       v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     1100       p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     1101       if p-chk-type <> "" and v-num-element = 0 then
     1102       do:
     1103           message "Ошибка 115." view-as alert-box.
     1104       end.
     1105       else return p-name-chk-type .
     1106   end function.
