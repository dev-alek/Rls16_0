     1146         :
     1147           assign
     1148             v-object-handle = buf_temp-diasize-handle.handle-value
     1149           .
     1150           if v-object-handle <> v-diasize-resize-button
     1151           then do:
     1152             assign
     1153               v-object-handle :col = v-object-handle :col + p-change-value
     1154               no-error .
     1155             if error-status :error
     1156             or error-status :get-message(1) <> ""
     1157             then do:
     1158               undo move_block, retry move_block .
     1159             end.
     1160           end.
     1161         end.
     1162       end.
     1163       else do:
     1164         for each buf_temp-diasize-handle
     1165         on error undo move_block, retry move_block
     1166         :
     1167           assign
     1168             v-object-handle = buf_temp-diasize-handle.handle-value
     1169           .
     1170           if v-object-handle <> v-diasize-resize-button
     1171           then do:
     1172             assign
     1173               v-object-handle :col = v-object-handle :col + p-change-value
     1174               no-error .
     1175             if error-status :error
     1176             or error-status :get-message(1) <> ""
     1177             then do:
     1178               undo move_block, retry move_block .
     1179             end.
     1180           end.
     1181         end.
     1182         for each buf_temp-browse-handle
     1183           where buf_temp-browse-handle.browse-type = 'width':u
     1184         on error undo move_block, retry move_block
     1185         :
     1186           assign
     1187             buf_temp-browse-handle.browse-handle :width
     1188               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1189             no-error .
     1190           if error-status :error
     1191           or error-status :get-message(1) <> ""
     1192           then do:
     1193             undo move_block, retry move_block .
     1194           end.
     1195         end.
     1196         assign
     1197           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1198           no-error .
     1199         if error-status :error
     1200         or error-status :get-message(1) <> ""
     1201         then do:
     1202           undo move_block, retry move_block.
     1203         end.
     1204         assign
     1205           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     1206         no-error .
     1207         if error-status :error
     1208         or error-status :get-message(1) <> ""
     1209         then do:
     1210           undo move_block, retry move_block.
     1211         end.
     1212         if frame DIALOG-1 :scrollable = true
     1213         then do:
     1214           assign
     1215             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1216           no-error .
     1217           if error-status :error
     1218           or error-status :get-message(1) <> ""
     1219           then do:
     1220             undo move_block, retry move_block.
     1221           end.
     1222         end.
     1223       end.
     1224       if p-move-resize
     1225       then do:
     1226         run diasize_position-resize-button in this-procedure .
     1227       end.
     1228       if v-diasize-wndstore = true
     1229       then do:
     1230         if connected("ub") = true
     1231         then do:
     1232           define variable v-cntxt-db-num        as integer   no-undo .
     1233           define variable v-cntxt-userid        as character no-undo .
     1234           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1235                                             , OUTPUT v-cntxt-userid
     1236                                             ) .
     1237           run gbl/wndsizew.p
     1238             (input  v-cntxt-db-num
     1239             ,input  v-cntxt-userid
     1240             ,input  v-diasize-proc-name
     1241             ,input  'width':u
     1242             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     1243             ) .
     1244         end.
     1245       end.
     1246     end.
     1247     assign
     1248       v-diasize-change-size = false
     1249     .
     1250   end procedure.
     1251   procedure diasize_set-width :
     1252     define input  parameter p-new-width  as decimal   no-undo .
     1253     define input  parameter p-move-resize as logical   no-undo .
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257       run diasize_change-width in this-procedure
     1258         (input  (p-new-width - frame DIALOG-1 :width)
     1259         ,input  p-move-resize
     1260         ) .
     1261     end.
     1262   end procedure.
     1263   procedure diasize_position-resize-button :
     1264     do with frame DIALOG-1
     1265     :
     1266       hide v-diasize-resize-button .
     1267       assign
     1268         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     1269                     - 1
     1270                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     1271         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     1272                     - 1
     1273                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     1274       .
     1275       view v-diasize-resize-button .
     1276     end.
     1277   end procedure.
     1278   on alt-right anywhere
     1279   do:
     1280     run diasize_change-width in this-procedure
     1281       (input 1
     1282       ,input true
     1283       ) .
     1284     return no-apply .
     1285   end.
     1286   on alt-left anywhere
     1287   do:
     1288     run diasize_change-width in this-procedure
     1289       (input -1
     1290       ,input true
     1291       ) .
     1292     return no-apply .
     1293   end.
     1294   on alt-down anywhere
     1295   do:
     1296     run diasize_change-height in this-procedure
     1297       (input 1
     1298       ,input true
     1299       ) .
     1300     return no-apply .
     1301   end.
     1302   on alt-up anywhere
     1303   do:
     1304     run diasize_change-height in this-procedure
     1305       (input -1
     1306       ,input true
     1307       ) .
     1308     return no-apply .
     1309   end.
     1310   on alt-enter of frame DIALOG-1
     1311   do:
     1312     run diasize_maximize in this-procedure
     1313       (input  ?
     1314       ).
     1315     return no-apply .
     1316   end.
     1317   procedure diasize_end-move :
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       define variable v-row-delta as decimal   no-undo .
     1322       define variable v-col-delta as decimal   no-undo .
     1323       define variable v-new-row as decimal   no-undo .
     1324       define variable v-new-col as decimal   no-undo .
     1325       assign
     1326         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1327         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1328       .
     1329       assign
     1330         v-row-delta = v-new-row - frame DIALOG-1 :height
     1331         v-col-delta = v-new-col - frame DIALOG-1 :width
     1332       .
     1333       run diasize_change-height in this-procedure
     1334         (input v-row-delta
     1335         ,input true
     1336         ) .
     1337       run diasize_change-width in this-procedure
     1338         (input v-col-delta
     1339         ,input true
     1340         ) .
     1341     end.
     1342   end procedure.
     1343   procedure diasize_maximize :
     1344     define input  parameter p-action as logical   no-undo .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       if p-action = ?
     1349       then do:
     1350         if v-diasize-need-maximize = true
     1351         then do:
     1352           assign
     1353             p-action = true
     1354           .
     1355         end.
     1356         else do:
     1357           assign
     1358             p-action = false
     1359           .
     1360         end.
     1361       end.
     1362       if p-action = true
     1363       then do:
     1364         run diasize_change-height in this-procedure
     1365           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1366               - frame DIALOG-1 :height-chars
     1367           ,input true
     1368           ) .
     1369         run diasize_change-width in this-procedure
     1370           (input session :width-chars
     1371               - frame DIALOG-1 :width-chars
     1372           ,input true
     1373           ) .
     1374         assign
     1375           v-diasize-need-maximize = false
     1376         .
     1377       end.
     1378       else do:
     1379         run diasize_change-width in this-procedure
     1380           (input v-diasize-orig-frame-width
     1381               - frame DIALOG-1 :width-chars
     1382           ,input true
     1383           ) .
     1384         run diasize_change-height in this-procedure
     1385           (input v-diasize-orig-frame-height
     1386               - frame DIALOG-1 :height-chars
     1387           ,input true
     1388           ) .
     1389         assign
     1390           v-diasize-need-maximize = true
     1391         .
     1392       end.
     1393     end.
     1394   end procedure.
     1395   procedure diasize_restore-orig-size :
     1396     do
     1397     on error undo, return error return-value
     1398     :
     1399       assign
     1400         v-diasize-current-frame-width  = frame DIALOG-1 :width
     1401         v-diasize-current-frame-height = frame DIALOG-1 :height
     1402       .
     1403       run diasize_set-height in this-procedure
     1404         (input  v-diasize-orig-frame-height
     1405         ,input  true
     1406         ) .
     1407       run diasize_set-width in this-procedure
     1408         (input  v-diasize-orig-frame-width
     1409         ,input  true
     1410         ) .
     1411     end.
     1412   end procedure.
     1413   procedure diasize_restore-current-size :
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417       run diasize_set-height in this-procedure
     1418         (input  v-diasize-current-frame-height
     1419         ,input  true
     1420         ) .
     1421       run diasize_set-width in this-procedure
     1422         (input  v-diasize-current-frame-width
     1423         ,input  true
     1424         ) .
     1425     end.
     1426   end procedure.
     1427   procedure diasize_set-browse-handle :
     1428     define input  parameter p-browse-handle as handle   no-undo .
     1429     define buffer buf_temp-browse-handle for temp-browse-handle .
     1430     do
     1431     on error undo, return error return-value
     1432     :
     1433       assign
     1434         v-diasize-browse-handle = p-browse-handle
     1435       .
     1436       for each buf_temp-browse-handle
     1437       on error undo, return error return-value
     1438       :
     1439         delete buf_temp-browse-handle .
     1440       end.
     1441     end.
     1442   end procedure.
     1443   procedure diasize_add_browse :
     1444     define input  parameter p-browse-type   as character no-undo .
     1445     define input  parameter p-browse-handle as handle    no-undo .
     1446     define buffer buf_temp-browse-handle for temp-browse-handle .
     1447     do
     1448     on error undo, return error return-value
     1449     :
     1450       assign
     1451         v-diasize-browse-number = v-diasize-browse-number + 1
     1452       .
     1453       create buf_temp-browse-handle .
     1454       assign
     1455         buf_temp-browse-handle.browse-type   = p-browse-type
     1456         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1457         buf_temp-browse-handle.browse-handle = p-browse-handle
     1458       .
     1459     end.
     1460   end procedure.
     1461   procedure diasize_init :
     1462     define variable v-default-value    as logical   no-undo .
     1463     define variable v-restore-saved    as logical   no-undo .
     1464     define variable v-resize-value-str as character no-undo .
     1465     do
     1466     on error undo, return error return-value
     1467     :
     1468       do with frame DIALOG-1
     1469       :
     1470         assign
     1471           v-diasize-orig-frame-height = frame DIALOG-1 :height
     1472           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     1473           v-diasize-browse-handle     = browse BR-sel-fields :handle
     1474         .
     1475         create button v-diasize-resize-button
     1476         assign
     1477           parent        = frame DIALOG-1 :first-child
     1478           label         = "s"
     1479           height-pixels = 16
     1480           width-pixels  = 16
     1481           visible       = true
     1482           sensitive     = true
     1483           movable       = true
     1484           triggers:
     1485             on end-move persistent run diasize_end-move in this-procedure .
     1486           end triggers.
     1487         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1488         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1489         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1490         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1491         assign
     1492           v-diasize-wndmax = false
     1493         .
     1494         if connected("ub") = true
     1495         then do:
     1496           define variable v-cntxt-db-num        as integer   no-undo .
     1497           define variable v-cntxt-userid        as character no-undo .
     1498           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1499                                             , OUTPUT v-cntxt-userid
     1500                                             ) .
     1501           run gbl/wndpar_r.p
     1502             (input  v-cntxt-db-num
     1503             ,input  v-cntxt-userid
     1504             ,input  'wndmax':U
     1505             ,output v-diasize-wndmax
     1506             ,output v-default-value
     1507             ) .
     1508         end.
     1509         assign
     1510           v-diasize-wndstore = false
     1511         .
     1512         if connected("ub") = true
     1513         then do:
     1514           run gbl/wndpar_r.p
     1515             (input  v-cntxt-db-num
     1516             ,input  v-cntxt-userid
     1517             ,input  'wndstore':U
     1518             ,output v-diasize-wndstore
     1519             ,output v-default-value
     1520             ) .
     1521         end.
     1522         assign
     1523           v-diasize-proc-name = entry(1, program-name(2), '.')
     1524         .
     1525         if v-diasize-wndstore = true
     1526         then do:
     1527           assign
     1528             v-restore-saved = false
     1529           .
     1530           if connected("ub") = true
     1531           then do:
     1532             run gbl/wndsizer.p
     1533               (input  v-cntxt-db-num
     1534               ,input  v-cntxt-userid
     1535               ,input  v-diasize-proc-name
     1536               ,input  'height':u
     1537               ,output v-resize-value-str
     1538               ) .
     1539             if v-resize-value-str <> '':U
     1540             then do:
     1541               run diasize_change-height in this-procedure
     1542                 (input  integer(v-resize-value-str)
     1543                 ,input  true
     1544                 ) .
     1545               assign
     1546                 v-restore-saved = true
     1547               .
     1548             end.
     1549           end.
     1550           if connected("ub") = true
     1551           then do:
     1552             run gbl/wndsizer.p
     1553               (input  v-cntxt-db-num
     1554               ,input  v-cntxt-userid
     1555               ,input  v-diasize-proc-name
     1556               ,input  'width':u
     1557               ,output v-resize-value-str
     1558               ) .
     1559             if v-resize-value-str <> '':U
     1560             then do:
     1561               run diasize_change-width in this-procedure
     1562                 (input  integer(v-resize-value-str)
     1563                 ,input  true
     1564                 ) .
     1565               assign
     1566                 v-restore-saved = true
     1567               .
     1568             end.
     1569           end.
     1570           if v-restore-saved <> true
     1571           then do:
     1572             if v-diasize-wndmax = true
     1573             then do:
     1574               run diasize_maximize in this-procedure
     1575                 (input  true
     1576                 ) .
     1577             end.
     1578           end.
     1579         end.
     1580         else do:
     1581           if v-diasize-wndmax = true
     1582           then do:
     1583             run diasize_maximize in this-procedure
     1584               (input  true
     1585               ) .
     1586           end.
     1587         end.
     1588       end.
     1589     end.
     1590   end procedure.
     1591   procedure diasize_need-full-display :
     1592     define output parameter p-need-full-display as logical   no-undo .
     1593     do
     1594     on error undo, return error return-value
     1595     :
     1596       assign
     1597         p-need-full-display = v-diasize-need-full-display
     1598       .
     1599       assign
     1600         v-diasize-need-full-display = false
     1601       .
     1602     end.
     1603   end procedure.
     1604   procedure get-context :
     1605      define output parameter p-db-num as integer          no-undo.
     1606      define output parameter p-user-id as character        no-undo.
     1607      define variable v-login               as character    no-undo.
     1608      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1609      define buffer buf_user-login  for ub.user-login .
     1610      do
     1611      on error undo, return error
     1612      :
     1613            FIND FIRST buf_sys-ctrl no-lock.
     1614            ASSIGN
     1615               v-login = USERID("ub")
     1616               p-db-num = buf_sys-ctrl.db-num
     1617            .
     1618            FIND FIRST buf_user-login
     1619                 WHERE buf_user-login.db-num = p-db-num
     1620                   AND buf_user-login.user-login = v-login
     1621                 no-lock
     1622                 no-error
     1623                 .
     1624            IF AVAILABLE buf_user-login
     1625            THEN DO:
     1626               assign
     1627                  p-user-id = buf_user-login.user-id
     1628               .
     1629            END.
     1630      end.
     1631   end procedure.
     1632       run diasize_init in this-procedure .
     1633   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1634   on end-error, stop of frame DIALOG-1 do:
     1635        p-rec = ?.
     1636        return "undo":u.
     1637   end.
     1638   MAIN-BLOCK:
     1639   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1640      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1641   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1642     run mainmenu_getcntxt in parparentproc
     1643       (output v-cntxt-db-num
     1644       ,output v-cntxt-userid
     1645       ,output v-cntxt-level
     1646       ,output v-cntxt-host-code-obj
     1647       ,output v-cntxt-obj-type
     1648       ,output v-cntxt-obj-code
     1649       ,output v-cntxt-db-num-obj
     1650       ,output v-cntxt-is-admin
     1651       ) .
     1652     if num-entries(c-point, chr(4)) > 2 then do:
     1653       c-title = entry(3, c-point, chr(4) ).
     1654       c-point = entry(1, c-point, chr(4) ) + chr(4) +  entry(2, c-point, chr(4) ).
     1655     end.
     1656     else do:
     1657       c-title = entry(1, c-point, chr(4) ).
     1658     end.
     1659     assign frame DIALOG-1:title = substitute("Ш А Б Л О Н Ы   П Е Ч А Т И    (&1)", c-title).
     1660     RUN enable_UI in this-procedure .
     1661     if lookup(bttn, "btn-exit":U) = 0 then do:
     1662       hide
     1663       btn-exit
     1664       in frame DIALOG-1.
     1665     end.
     1666     reposition browser-1 to recid p-rec no-error.
     1667     apply "value-changed" to browser-1 in frame DIALOG-1.
     1668     WAIT-FOR GO OF FRAME DIALOG-1 focus browser-1.
     1669   END.
     1670   RUN disable_UI.
     1671   PROCEDURE disable_UI :
     1672     HIDE FRAME DIALOG-1.
     1673   END PROCEDURE.
     1674   PROCEDURE enable_UI :
     1675     DISPLAY flt-name f-num-clmn f-length
     1676         WITH FRAME DIALOG-1.
     1677     ENABLE Btn_Cancel Btn_OK btn-exit b-help BROWSER-1 BR-sel-fields btn-add
     1678            btn-del btn-update
     1679         WITH FRAME DIALOG-1.
     1680     OPEN QUERY BROWSER-1 FOR EACH ubflt.filter       WHERE ubflt.filter.call-point = c-point NO-LOCK.
     1681   END PROCEDURE.
     1682   PROCEDURE fill-table :
     1683   define variable ii as integer no-undo.
     1684   for each t-f :
     1685       delete t-f.
     1686   end.
     1687   if available ubflt.filter then do:
     1688     assign
     1689           v-num-clmn = num-entries(ubflt.filter.fields-sort)
     1690           v-length = 0
     1691           .
     1692       do ii = 1 to v-num-clmn:
     1693           create t-f.
     1694           assign
     1695           t-f.field-name = string(ii)
     1696           t-f.field-label = entry(ii,ubflt.filter.fields-sort-rus)
     1697           t-f.field-size = entry(ii,ubflt.filter.where-ysl)
     1698          v-length = v-length + integer(entry(ii, ubflt.filter.Where-ysl))
     1699           .
     1700       end.
     1701   end.
     1702   OPEN QUERY br-sel-fields FOR EACH t-f no-lock.
     1703   APPLY "ENTRY" to BROWSER-1 in frame DIALOG-1.
     1704   END PROCEDURE.
