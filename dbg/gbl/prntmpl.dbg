      570               then do:
      571                 assign
      572                   v-object-handle :row = buf_temp-diasize-handle.save-position
      573                 .
      574               end.
      575             end.
      576             assign
      577               v-diasize-browse-handle :height = v-browse-height
      578             .
      579             for each buf_temp-browse-handle
      580               where buf_temp-browse-handle.browse-type = 'height':u
      581             on error undo, next
      582             :
      583               assign
      584                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      585               .
      586             end.
      587             assign
      588               frame DIALOG-1 :height = v-frame-height
      589             .
      590             if frame DIALOG-1 :scrollable = true
      591             then do:
      592               assign
      593                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
      594               .
      595             end.
