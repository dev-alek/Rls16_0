        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter  bttn        as character no-undo .
        3   define input parameter c-point as character no-undo .
        4   define input parameter tbl     as character no-undo .
        5   define input parameter buf     as character no-undo .
        6   define input parameter fld     as character no-undo .
        7   define input parameter lab     as character no-undo .
        8   define input parameter spr     as character no-undo .
        9   define input parameter p-size  as character no-undo .
       10   define input parameter p-format as character no-undo .
       11   define input parameter dim     as character no-undo .
       12   define input-output parameter p-rec as recid no-undo .
       13   define output parameter P-LENGTH as integer no-undo .
       14   define output parameter P-NUM-CLMN as integer no-undo .
       15   define variable vss-revision    as character no-undo initial "$Revision$":U .
       16   define variable vss-author      as character no-undo initial "$Author$":U .
       17   define variable vss-date        as character no-undo initial "$Date$":U .
       18   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       19   define variable vss-archive     as character no-undo initial "$Archive$":U .
       20   define variable vss-description as character no-undo initial "Выбор шаблона печати".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define temp-table t-f no-undo
      126   field table-name as character
      127   field field-name as character
      128   field field-name-0 as character
      129   field field-format as character
      130   field field-type as character
      131   field field-size as character
      132   field field-csize as integer
      133   field field-label as character
      134   field field-clabel as character
      135   field field-spr as character
      136   field field-table-order as integer
      137   field field-order as integer
      138   index pi is unique primary
      139   table-name
      140   field-name
      141   index iorder
      142   field-order
      143   index itorder
      144   table-name
      145   field-table-order
      146   .
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148     define variable v-cntxt-db-num        as integer   no-undo .
      149     define variable v-cntxt-userid        as character no-undo .
      150     define variable v-cntxt-level         as character no-undo .
      151     define variable v-cntxt-host-code-obj as integer   no-undo .
      152     define variable v-cntxt-obj-type      as character no-undo .
      153     define variable v-cntxt-obj-code      as integer   no-undo .
      154     define variable v-cntxt-db-num-obj    as integer   no-undo .
      155     define variable v-cntxt-is-admin      as logical   no-undo .
      156   DEFINE VARIABLE kl AS INTEGER INITIAL 0.
      157   define variable MethodReturn AS LOGICAL.
      158   define variable ID AS RECID.
      159   define variable IDENT AS RECID.
      160   define variable c-title as character no-undo .
      161   define variable ii as integer no-undo.
      162   define variable rec as recid no-undo.
      163   define variable v-length as integer no-undo.
      164   define variable v-num-clmn as integer no-undo.
      165   DEFINE BUTTON b-help DEFAULT
      166        LABEL "Помо&щь":L
      167        SIZE 10 BY 1
      168        BGCOLOR 8 .
      169   DEFINE BUTTON btn-add
      170        LABEL "&Добавить":L
      171        SIZE 8.75 BY 1.17 TOOLTIP "Добавить новый шаблон".
      172   DEFINE BUTTON btn-del
      173        LABEL "&Удалить":L
      174        SIZE 8.75 BY 1.17 TOOLTIP "Удалить ранее существующий шаблон".
      175   DEFINE BUTTON btn-exit AUTO-GO
      176        LABEL "&Отменить":L
      177        SIZE 10 BY 1 TOOLTIP "Отменить действие установок шаблона".
      178   DEFINE BUTTON btn-update
      179        LABEL "&Изменить":L
      180        SIZE 9 BY 1.17 TOOLTIP "Изменить установки выбранного шаблона".
      181   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      182        LABEL "&Выход "
      183        SIZE 10 BY 1 TOOLTIP "Выход без изменений"
      184        BGCOLOR 8 .
      185   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      186        LABEL "&Применить":L
      187        SIZE 10 BY 1 TOOLTIP "Применить установки выбранного шаблона"
      188        BGCOLOR 8 .
      189   DEFINE VARIABLE f-length AS CHARACTER FORMAT "X(5)":U
      190        VIEW-AS FILL-IN
      191        SIZE 9.13 BY 1 NO-UNDO.
      192   DEFINE VARIABLE f-num-clmn AS CHARACTER FORMAT "X(3)":U
      193        VIEW-AS FILL-IN
      194        SIZE 6.13 BY 1 NO-UNDO.
      195   DEFINE VARIABLE flt-name AS CHARACTER FORMAT "X(256)":U
      196        VIEW-AS FILL-IN
      197        SIZE 97.88 BY 1
      198        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      199   DEFINE QUERY BR-sel-fields FOR
      200         t-f SCROLLING.
      201   DEFINE QUERY BROWSER-1 FOR
      202         ubflt.filter SCROLLING.
      203   DEFINE BROWSE BR-sel-fields
      204     QUERY BR-sel-fields DISPLAY
      205         t-f.field-label format "X(30)" column-label "Название поля"
      206   t-f.field-size format "X(5)" column-label "Длина"
      207       WITH NO-ROW-MARKERS SEPARATORS SIZE 38.88 BY 13.71.
      208   DEFINE BROWSE BROWSER-1
      209     QUERY BROWSER-1 NO-LOCK DISPLAY
      210         ubflt.filter.Naim COLUMN-LABEL "Имя шаблона"
      211       WITH SEPARATORS SIZE 48.5 BY 13.75.
      212   DEFINE FRAME DIALOG-1
      213        Btn_Cancel AT ROW 1 COL 1
      214        Btn_OK AT ROW 1 COL 11
      215        btn-exit AT ROW 1 COL 21
      216        b-help AT ROW 1 COL 61
      217        flt-name AT ROW 2.54 COL 1 NO-LABEL
      218        f-num-clmn AT ROW 3.63 COL 90.63 COLON-ALIGNED NO-LABEL
      219        f-length AT ROW 3.75 COL 67.88 COLON-ALIGNED NO-LABEL
      220        BROWSER-1 AT ROW 6.08 COL 1
      221        BR-sel-fields AT ROW 6.08 COL 60.13
      222        btn-add AT ROW 6.17 COL 50.13
      223        btn-del AT ROW 7.67 COL 50.13
      224        btn-update AT ROW 9.17 COL 50.13
      225        "Кол-во полей" VIEW-AS TEXT
      226             SIZE 12.5 BY .67 AT ROW 3.83 COL 79.88
      227             BGCOLOR 1 FGCOLOR 15
      228        "Длина шаблона" VIEW-AS TEXT
      229             SIZE 14.5 BY .67 AT ROW 3.92 COL 54.5
      230             BGCOLOR 1 FGCOLOR 15
      231        "Список шаблонов" VIEW-AS TEXT
      232             SIZE 48.63 BY .67 AT ROW 5.04 COL 1
      233             BGCOLOR 1 FGCOLOR 15
      234        "Список полей" VIEW-AS TEXT
      235             SIZE 39.25 BY .67 AT ROW 5.04 COL 59.75
      236             BGCOLOR 1 FGCOLOR 15
      237        SPACE(0.74) SKIP(14.28)
      238       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      239            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      240            TITLE "Шаблоны печати":L
      241            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      242   ASSIGN
      243          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      244   ON MOUSE-SELECT-DBLCLICK OF BROWSER-1 IN FRAME DIALOG-1
      245   DO:
      246   apply "choose" to  btn_ok.
      247   END.
      248   ON RETURN OF BROWSER-1 IN FRAME DIALOG-1
      249   DO:
      250   apply "choose" to  btn_ok.
      251   END.
      252   ON VALUE-CHANGED OF BROWSER-1 IN FRAME DIALOG-1
      253   DO:
      254    IF AVAILABLE(ubflt.filter) THEN DO:
      255       flt-name = ubflt.filter.naim.
      256       Kl = ubflt.filter.Num-flt.
      257       assign
      258           v-num-clmn = num-entries(ubflt.filter.fields-sort)
      259           v-length = 0
      260           .
      261       run fill-table in this-procedure.
      262       IDENT = RECID(ubflt.filter).
      263       DISPLAY
      264       flt-name
      265         string(v-length, ">>>>9") @ f-length
      266       string(v-num-clmn, ">>9") @ f-num-clmn
      267       with frame DIALOG-1.
      268     END.
      269     ELSE do:
      270       run fill-table in this-procedure.
      271       display
      272       "":U @ f-length
      273       "":U @ f-num-clmn
      274       with frame DIALOG-1.
      275     end.
      276   END.
      277   ON CHOOSE OF btn-add IN FRAME DIALOG-1
      278   DO:
      279     Kl = 0.
      280     run gbl/updprint.w (c-point,Tbl,Buf,Fld,Lab,Spr,p-size,p-format,Dim,Kl,OUTPUT ID, OUTPUT P-LENGTH, OUTPUT P-NUM-CLMN).
      281     IF ID = ? THEN ID = IDENT.
      282     RUN enable_UI.
      283     REPOSITION BROWSER-1 TO RECID id no-error.
      284     APPLY "ITERATION-CHANGED" TO BROWSER-1.
      285     apply "entry" to browser-1.
      286   END.
      287   ON CHOOSE OF btn-del IN FRAME DIALOG-1
      288   do:
      289   define variable v-flt-rec as recid no-undo .
      290   do on stop  undo, return:
      291     if available ubflt.filter then do:
      292        flt-name = "".
      293          get prev browser-1.
      294        if not available ubflt.filter then do:
      295           get first browser-1.
      296           get next browser-1.
      297           end.
      298        v-flt-rec = recid(ubflt.filter).
      299        FIND FIRST ubflt.filter WHERE ubflt.filter.Num-flt = Kl EXCLUSIVE-LOCK NO-ERROR.
      300        DELETE ubflt.filter.
      301        find ubflt.filter where recid(ubflt.filter) = v-flt-rec no-lock no-error.
      302        RUN enable_UI.
      303        REPOSITION BROWSER-1 TO RECID v-flt-rec no-error.
      304        APPLY "VALUE-CHANGED" TO BROWSER-1.
      305        apply "entry" to browser-1.
      306        END.
      307   end.
      308   END.
      309   ON CHOOSE OF btn-exit IN FRAME DIALOG-1
      310   DO:
      311      p-rec = ?.
      312      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      313                           and ubflt.usr-flt.call-point = ubflt.filter.call-point
      314                           no-error.
      315      if available ubflt.usr-flt then delete ubflt.usr-flt.
      316   END.
      317   ON CHOOSE OF btn-update IN FRAME DIALOG-1
      318   DO:
      319     FIND FIRST ubflt.filter WHERE ubflt.filter.Num-flt = Kl EXCLUSIVE-LOCK NO-ERROR no-wait.
      320     IF AVAILABLE(ubflt.filter) THEN DO:
      321        Kl = ubflt.filter.Num-flt.
      322        run gbl/updprint.w  (c-point,Tbl,Buf,Fld,Lab,Spr,p-size,p-format,Dim,Kl,output ID, OUTPUT P-LENGTH, OUTPUT P-NUM-CLMN).
      323        IF ID = ? THEN ID = IDENT.
      324        RUN enable_UI.
      325        REPOSITION BROWSER-1 TO RECID id no-error.
      326        APPLY "ITERATION-CHANGED" TO BROWSER-1.
      327        apply "entry" to browser-1.
      328        END.
      329      else
      330        if locked ubflt.filter then
      331           message 'Шаблон в данный момент корректируется другим пользователем'.
      332   END.
      333   ON CHOOSE OF Btn_Cancel IN FRAME DIALOG-1
      334   DO:
      335        p-rec = ?.
      336        return  "undo".
      337   END.
      338   ON CHOOSE OF Btn_OK IN FRAME DIALOG-1
      339   DO:
      340   if available ubflt.filter  then do:
      341      p-rec = recid(ubflt.filter).
      342      find ubflt.usr-flt where ubflt.usr-flt.user-name = v-cntxt-userid
      343                           and ubflt.usr-flt.call-point = ubflt.filter.call-point
      344                           no-error.
      345      if not available ubflt.usr-flt then create ubflt.usr-flt.
      346      assign
      347      ubflt.usr-flt.user-name = v-cntxt-userid
      348      ubflt.usr-flt.call-point    = ubflt.filter.call-point
      349      ubflt.usr-flt.naim = ubflt.filter.naim.
      350      end.
      351   else p-rec = ?.
      352   END.
      353   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      354   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      355   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   on help of frame DIALOG-1
      357   do:
      358     run gbl/app_help.p
      359       (input this-procedure :file-name
      360       ,input ''
      361       ,input ?
      362       ) no-error.
      363     if error-status :error then do:
      364       message
      365         "Ошибка при вызове помощи"
      366         error-status :get-message(1)
      367         view-as alert-box .
      368     end.
      369   end.
      370   run minbtn-set in this-procedure .
      371   on choose of b-help in frame DIALOG-1
      372   do:
      373     apply "help":u to frame DIALOG-1 .
      374   end.
      375   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure minbtn-set :
      377       do
      378           on error undo, return error return-value
      379           :
      380           define variable ii              as integer       no-undo .
      381           define variable fh              as widget-handle no-undo .
      382           define variable hh              as widget-handle no-undo .
      383           define variable v-h             as handle        extent 4 no-undo .
      384           define variable v-name-button   as character     no-undo .
      385           define variable v-help-old-x    as decimal       no-undo .
      386           define variable v-help-old-y    as decimal       no-undo .
      387           define variable v-help-old-size as decimal       no-undo .
      388           define variable v-frame-width   as decimal       no-undo .
      389           define variable jj              as integer       no-undo .
      390           do
      391               on error undo, return error
      392               :
      393               assign
      394                   v-frame-width = frame DIALOG-1:width - 0.3
      395                   fh            = frame DIALOG-1:first-child
      396                   hh            = fh:first-child
      397                   ii            = 1
      398                   .
      399               do while valid-handle(hh):
      400                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      401                   do:
      402                       case lc(hh:name) :
      403                           when "b-help" then
      404                               do:
      405                                   hh:load-image-up("cmp/b-help.bmp":u) .
      406                                   hh:load-image-down("cmp/b-help.bmp":u) .
      407                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      408                                   hh:TOOLTIP = "Помощь" .
      409                                   v-help-old-x = hh:column .
      410                                   v-help-old-y = hh:row    .
      411                                   v-help-old-size = hh:width .
      412                                   hh:width-chars = 2.5 .
      413                               end.
      414                           when "b-print" then
      415                               do:
      416                                   hh:load-image("cmp/b-print.bmp":u) .
      417                                   hh:TOOLTIP = "Печать" .
      418                                   v-h[ii] = hh:handle .
      419                                   ii = ii + 1 .
      420                                   hh:width-chars = 3 .
      421                               end.
      422                           when "b-history" or
      423                           when "b-hist" then
      424                               do:
      425                                   hh:load-image("cmp/b-hist.bmp":u) .
      426                                   hh:TOOLTIP = "История" .
      427                                   v-h[ii] = hh:handle .
      428                                   ii = ii + 1 .
      429                                   hh:width-chars = 3 .
      430                               end.
      431                           when "b-sch" then
      432                               do:
      433                                   hh:load-image("cmp/b-sch.bmp":u) .
      434                                   hh:TOOLTIP = "Установка Фильтра" .
      435                                   v-h[ii] = hh:handle .
      436                                   ii = ii + 1 .
      437                                   hh:width-chars = 3 .
      438                               end.
      439                           when "b-hist-user" then
      440                               do:
      441                                   hh:load-image("cmp/b-hist.bmp":u) .
      442                                   hh:TOOLTIP = "История пользователя" .
      443                                   ii = ii + 1 .
      444                               end.
      445                       end case.
      446                   end.
      447                   hh = hh:next-sibling.
      448               end.
      449               b-help:column = v-frame-width - b-help:width-chars.
      450               jj = 0.
      451               repeat ii = 4 to 1 by -1 :
      452                   if valid-handle (v-h[ii] ) then
      453                   do:
      454                       jj  = jj + 1 .
      455                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      456                       v-h[ii]:row    = v-help-old-y .
      457                   end.
      458               end.
      459           end.
      460       end.
      461   end procedure.
      462   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      463   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      464   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      465   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      466   define variable v-diasize-current-frame-width  as decimal   no-undo .
      467   define variable v-diasize-current-frame-height as decimal   no-undo .
      468   define variable v-diasize-change-size          as logical   no-undo .
      469   define variable v-diasize-resize-button        as handle    no-undo .
      470   define variable v-diasize-wndmax               as logical   no-undo .
      471   define variable v-diasize-wndstore             as logical   no-undo .
      472   define variable v-diasize-proc-name            as character no-undo .
      473   define variable v-diasize-browse-handle        as handle    no-undo .
      474   define variable v-diasize-browse-number        as integer   no-undo .
      475   define variable v-diasize-need-full-display    as logical   no-undo init false .
      476   define temp-table temp-diasize-handle no-undo
      477     field handle-value  as handle
      478     field save-position as decimal
      479     index xpk is primary unique handle-value
      480     .
      481   define temp-table temp-browse-handle no-undo
      482     field browse-type   as character
      483     field browse-number as integer
      484     field browse-handle as handle
      485     field original-size as decimal
      486     index xpk is primary unique browse-type browse-number
      487     index xie browse-type browse-handle
      488   .
      489   procedure diasize_change-height :
      490     define input  parameter p-change-value  as decimal   no-undo .
      491     define input  parameter p-move-resize   as logical   no-undo .
      492     define variable v-field-group-handle    as handle    no-undo .
      493     define variable v-object-handle         as handle    no-undo .
      494     define variable v-frame-height          as decimal   no-undo .
      495     define variable v-frame-virtual-height  as decimal   no-undo .
      496     define variable v-browse-height         as decimal   no-undo .
      497     define variable v-window-height         as decimal   no-undo .
      498     define variable v-window-virtual-height as decimal   no-undo .
      499     define variable v-change-sign           as integer   no-undo .
      500     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      501     define buffer buf_temp-browse-handle  for temp-browse-handle .
      502     if p-change-value > 0
      503     then do:
      504       if frame DIALOG-1 :height + p-change-value
      505           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      506       then do:
      507         assign
      508           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      509                           - (frame DIALOG-1 :height-chars)
      510         .
      511         if p-change-value <= 0
      512         then do:
      513           run diasize_position-resize-button in this-procedure .
      514           return .
      515         end.
      516       end.
      517     end.
      518     if p-change-value < 0
      519     then do:
      520       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
      521       then do:
      522         assign
      523           p-change-value = v-diasize-orig-frame-height
      524                          - (frame DIALOG-1 :height-chars)
      525         .
      526         if p-change-value >= 0
      527         then do:
      528           run diasize_position-resize-button in this-procedure .
      529           return .
      530         end.
      531       end.
      532     end.
      533     if p-change-value >= 0
      534     then do:
      535       assign
      536         v-change-sign = 1
      537       .
      538     end.
      539     else do:
      540       assign
      541         v-change-sign = -1
      542       .
      543     end.
      544     assign
      545       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      546     .
      547     if p-change-value = 0
      548     then do:
      549       run diasize_position-resize-button in this-procedure .
      550       return .
      551     end.
      552     move_block:
      553     do
      554     on error undo move_block, retry move_block
      555     :
      556       if retry
      557       then do:
      558         do
      559         on error undo move_block, leave move_block
      560         :
      561           if p-change-value > 0
      562           then do:
      563             for each buf_temp-diasize-handle
      564             on error undo, next
      565             :
      566               assign
      567                 v-object-handle = buf_temp-diasize-handle.handle-value
      568               .
