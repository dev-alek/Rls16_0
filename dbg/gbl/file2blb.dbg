        1   block-level on error undo, throw.
        2   define input parameter p-mode      as character no-undo .
        3   define input parameter p-blob-mode as character no-undo .
        4   define input parameter p-bh        as handle no-undo.
        5   define input parameter p-uniq-key-rec as character no-undo .
        6   define input parameter p-field as character no-undo .
        7   define input parameter p-descr as character no-undo .
        8   define input-output parameter p-part-num as integer no-undo .
        9   define input parameter p-resource-type as character no-undo .
       10   define input-output parameter p-blob-db-num as integer no-undo .
       11   define input-output parameter p-int64-id as int64 no-undo .
       12   define input parameter p-file as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: file2blb.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: gbl/file2blb.p $":U .
       18   define variable vss-description as character no-undo init "Копирование файла в blob".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure gen-key-rec :
       90     define input  parameter p-tbl-name    as character no-undo.
       91     define input  parameter p-bh_tbl-name as handle    no-undo.
       92     define output parameter p-key-rec     as character no-undo.
       93     do
       94     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       95     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       96     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       97     :
       98       define variable fh               as handle    no-undo .
       99       define variable v-ok             as logical   no-undo .
      100       define variable v-inform         as character no-undo .
      101       define variable v-ind            as integer   no-undo .
      102       define variable v-idx-field-qnty as integer   no-undo .
      103       if p-tbl-name = ?
      104         or p-tbl-name = "":U
      105       then do:
      106         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      107       end.
      108       if not p-bh_tbl-name:available then do:
      109         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      110       end.
      111       assign
      112         p-key-rec = p-tbl-name
      113         v-inform  = p-bh_tbl-name:index-information(1)
      114         v-ind     = 2
      115       .
      116       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      117       on error undo, return error
      118       :
      119         assign
      120           v-inform = p-bh_tbl-name:index-information( v-ind )
      121           v-ind    = v-ind + 1
      122         .
      123       end.
      124       if v-inform = ?
      125         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      126         or entry( 3, v-inform, ",":U ) <> "1":U
      127       then do:
      128         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      129       end.
      130       else do:
      131         assign
      132           v-idx-field-qnty = num-entries( v-inform ) - 4
      133         .
      134         if v-idx-field-qnty < 2 then do:
      135           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      136         end.
      137         do v-ind = 1 to v-idx-field-qnty by 2
      138         on error undo, return error
      139         :
      140           assign
      141             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      142             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      143           .
      144         end.
      145       end.
      146       if p-key-rec = ? then do:
      147         assign
      148           p-key-rec = "":U
      149         .
      150         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      151       end.
      152     end.
      153     return.
      154   end procedure.
      155   procedure gen-where-keyr-tab :
      156     define input  parameter i-tableSerach as character no-undo.
      157     define input  parameter i-tablekey   as character  no-undo.
      158     define input  parameter p-key-rec    as character  no-undo.
      159     define input  parameter p-key-handle as handle     no-undo .
      160     define input  parameter p-db-name    as character  no-undo .
      161     define input  parameter p-tt-handle  as handle     no-undo .
      162     define output parameter o-Where      as character  no-undo.
      163     do
      164     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      165     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      166     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      167     :
      168       define variable v-full-tbl-name  as character no-undo .
      169       define variable bh_tbl-name      as handle    no-undo .
      170       define variable fh_key           as handle    no-undo .
      171       define variable fh_search        as handle    no-undo .
      172       define variable v-field-num      as integer   no-undo .
      173       define variable v-count-fld      as integer   no-undo .
      174       define variable v-inform         as character no-undo .
      175       define variable v-ind            as integer   no-undo .
      176       define variable v-idx-field-qnty as integer   no-undo .
      177       define variable v-field-name     as character no-undo .
      178       define variable v-field-val      as character no-undo .
      179       define variable v-word-link      as character no-undo .
      180       define variable vTable           as character no-undo.
      181       define variable bh_tbl-key       as handle    no-undo .
      182       assign
      183         p-key-rec = trim( p-key-rec )
      184       .
      185       if p-key-handle <> ? then do:
      186         if not valid-handle(p-key-handle)
      187            or p-key-handle:type <> "buffer"
      188         then do:
      189           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      190         end.
      191         if num-entries( p-key-rec, chr(3) ) > 1
      192           or p-key-rec = ?
      193           or p-key-rec = "":U
      194         then do:
      195           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      196         end.
      197       end.
      198       else do:
      199         if p-key-rec = ?
      200           or p-key-rec = "":U
      201         then do:
      202           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      203         end.
      204       end.
      205       assign
      206         vTable = entry( 1 , p-key-rec, chr(3) )
      207       .
      208       if p-tt-handle <> ?
      209         and ( not valid-handle(p-tt-handle)
      210               or p-tt-handle:type <> "buffer"
      211             )
      212       then do:
      213         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      214       end.
      215       if p-tt-handle = ? then do:
      216         assign
      217           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      218         .
      219         create buffer bh_tbl-name for table v-full-tbl-name .
      220       end.
      221       else do:
      222         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      223       end.
      224       assign
      225         v-inform = bh_tbl-name:index-information(1)
      226         v-ind    = 2
      227       .
      228       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      229       on error undo, return error
      230       :
      231         assign
      232           v-inform = bh_tbl-name:index-information( v-ind )
      233           v-ind    = v-ind + 1
      234         .
      235       end.
      236       if v-inform = ?
      237         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      238         or entry( 3, v-inform, ",":U ) <> "1":U
      239       then do:
      240         delete object bh_tbl-name no-error.
      241         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      242       end.
      243       assign
      244         v-idx-field-qnty = num-entries( v-inform ) - 4
      245       .
      246       if v-idx-field-qnty < 2 then do:
      247         delete object bh_tbl-name no-error.
      248         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      249       end.
      250       assign
      251         o-where     = "where":U
      252         v-word-link = "":U
      253         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      254         v-count-fld = 0
      255       .
      256       if i-tablekey ne "" and i-tablekey ne ?
      257       then do:
      258         assign
      259           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      260         .
      261         create buffer bh_tbl-key for table v-full-tbl-name .
      262       end.
      263       if i-tableSerach ne "" and i-tableSerach ne ?
      264       then do:
      265         delete object bh_tbl-name no-error.
      266         assign
      267           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      268         .
      269         create buffer bh_tbl-name for table v-full-tbl-name .
      270       end.
      271       block_where:
      272       do v-ind = 1 to v-idx-field-qnty by 2
      273       on error undo, return error
      274       :
      275         assign
      276           v-count-fld = v-count-fld + 1
      277         .
      278         if p-key-handle = ?
      279           and v-count-fld > v-field-num
      280         then do:
      281           leave block_where.
      282         end.
      283         define variable VfieldKeyTable as handle no-undo.
      284         assign
      285           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      286           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      287         .
      288         if     bh_tbl-key ne ?
      289         then do:
      290            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      291            if VfieldKeyTable eq ?
      292            then next block_where.
      293         end.
      294         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      295         then
      296            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      297         else
      298            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      299         if p-key-handle = ? then do:
      300           assign
      301             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      302           .
      303         end.
      304         else do:
      305           assign
      306             fh_key = p-key-handle:buffer-field( v-field-name )
      307           .
      308           if fh_key = ?
      309             or not valid-handle( fh_key )
      310           then do:
      311             delete object bh_tbl-name.
      312             if     bh_tbl-key ne ?
      313             then
      314                delete object bh_tbl-key.
      315             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      316           end.
      317           assign
      318             v-field-val = fh_key:buffer-value
      319           .
      320         end.
      321         if fh_search:data-type ="character":U then do:
      322           assign
      323             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      324             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      325             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      326             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      327             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      328             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      329             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      330             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      331             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      332             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      333             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      334             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      335             v-field-val = substitute( '"&1"', v-field-val )
      336           .
      337         end.
      338         assign
      339           o-where = substitute( "&1 &2", o-where, v-field-val )
      340         .
      341         if v-word-link = "":U then do:
      342           assign
      343             v-word-link = "and":U
      344           .
      345         end.
      346       end.
      347       delete object bh_tbl-name.
      348       if     bh_tbl-key ne ?
      349       then
      350          delete object bh_tbl-key.
      351       if p-key-handle = ?
      352         and v-count-fld <> v-field-num
      353       then do:
      354         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      355       end.
      356     end.
      357   end procedure.
      358   procedure gen-hn-keyr-tab :
      359     define input  parameter i-tableSerach as character no-undo.
      360     define input  parameter i-tablekey   as character no-undo.
      361     define input  parameter p-key-rec    as character no-undo.
      362     define input  parameter p-key-handle as handle    no-undo .
      363     define input  parameter p-db-name    as character no-undo .
      364     define input  parameter p-tt-handle  as handle    no-undo .
      365     define input  parameter p-stts-lock  as integer   no-undo .
      366     define output parameter o-hn         as handle    no-undo.
      367     define variable v-full-tbl-name as character no-undo.
      368     define variable v-where         as character no-undo.
      369     define variable bh_tbl-name     as handle    no-undo.
      370     define variable vTable          as character no-undo.
      371     do
      372     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      373     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      374     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      375         run gen-where-keyr-tab(i-tableSerach,
      376                                i-tablekey,
      377                                p-key-rec,
      378                                p-key-handle,
      379                                p-db-name,
      380                                p-tt-handle,
      381                                output v-where).
      382         if i-tableSerach ne "" and i-tableSerach ne ?
      383         then do:
      384            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      385            create buffer bh_tbl-name for table v-full-tbl-name .
      386         end.
      387         else do:
      388            if p-tt-handle = ? then do:
      389               assign
      390                  vTable = entry( 1 , p-key-rec, chr(3) )
      391               .
      392               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      393               create buffer bh_tbl-name for table v-full-tbl-name .
      394            end.
      395            else do:
      396               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      397            end.
      398         end.
      399         if p-tt-handle = ? then do:
      400            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      401         end.
      402         else do:
      403            bh_tbl-name:find-first( v-where ) no-error .
      404         end.
      405         o-hn = bh_tbl-name.
      406      end.
      407   end procedure.
      408   procedure gen-hn-keyr :
      409     define input  parameter p-key-rec    as character no-undo.
      410     define input  parameter p-key-handle as handle    no-undo .
      411     define input  parameter p-db-name    as character no-undo .
      412     define input  parameter p-tt-handle  as handle    no-undo .
      413     define input  parameter p-stts-lock  as integer   no-undo .
      414     define output parameter o-hn         as handle    no-undo.
      415     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      416   end.
      417   procedure gen-row-keyr :
      418     define input  parameter p-key-rec    as character no-undo.
      419     define input  parameter p-key-handle as handle    no-undo .
      420     define input  parameter p-db-name    as character no-undo .
      421     define input  parameter p-tt-handle  as handle    no-undo .
      422     define input  parameter p-stts-lock  as integer   no-undo .
      423     define output parameter p-tbl-row    as rowid     no-undo.
      424     define output parameter p-tbl-name   as character no-undo.
      425     define variable vHn as handle no-undo.
      426       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      427       p-tbl-row = if vHn:available then vHn:rowid else ?.
      428       p-tbl-name =  vHn:table.
      429       delete object vHn no-error.
      430     if p-tbl-row = ? then do:
      431       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      432     end.
      433     else do:
      434       return.
      435     end.
      436   end procedure.
      437   procedure gen-key-fv :
      438     define input  parameter p-key-rec    as character no-undo .
      439     define output parameter p-field-list as character no-undo .
      440     define output parameter p-value-list as character no-undo.
      441     do
      442     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      443     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      444     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      445     :
      446       define variable v-full-tbl-name  as character no-undo .
      447       define variable bh_tbl-name      as handle    no-undo .
      448       define variable v-tbl-name       as character no-undo .
      449       define variable v-field-num      as integer   no-undo .
      450       define variable v-count-fld      as integer   no-undo .
      451       define variable v-inform         as character no-undo .
      452       define variable v-ind            as integer   no-undo .
      453       define variable v-idx-field-qnty as integer   no-undo .
      454       define variable v-delim-key      as character no-undo .
      455       if p-key-rec = ?
      456         or p-key-rec = "":U
      457       then do:
      458         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      459       end.
      460       assign
      461         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      462         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      463       .
      464       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      465       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      466       assign
      467         v-inform = bh_tbl-name:index-information(1)
      468         v-ind    = 2
      469       .
      470       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      471       on error undo, return error
      472       :
      473         assign
      474           v-inform = bh_tbl-name:index-information( v-ind )
      475           v-ind    = v-ind + 1
      476         .
      477       end.
      478       if v-inform = ?
      479         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      480         or entry( 3, v-inform, ",":U ) <> "1":U
      481       then do:
      482         delete object bh_tbl-name no-error.
      483         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      484       end.
      485       assign
      486         v-idx-field-qnty = num-entries( v-inform ) - 4
      487       .
      488       if v-idx-field-qnty < 2 then do:
      489         delete object bh_tbl-name no-error.
      490         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      491       end.
      492       assign
      493         p-field-list = "":U
      494         p-value-list = "":U
      495         v-delim-key  = "":U
      496         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      497         v-count-fld  = 0
      498       .
      499       block_where:
      500       do v-ind = 1 to v-idx-field-qnty by 2
      501       on error undo, return error
      502       :
      503         assign
      504           v-count-fld = v-count-fld + 1
      505         .
      506         if v-count-fld > v-field-num then do:
      507           leave block_where.
      508         end.
      509         assign
      510           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      511           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      512         .
      513         if v-ind = 1 then do:
      514           assign
      515             v-delim-key = chr(3)
      516           .
      517         end.
      518       end.
      519       delete object bh_tbl-name.
      520       if v-count-fld <> v-field-num then do:
      521         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      522       end.
      523     end.
      524   end procedure.
      525   procedure gen-key-field :
      526     define input  parameter p-table      as character no-undo .
      527     define output parameter p-field-list as character no-undo .
      528     do
      529     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      530     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      531     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      532     :
      533       define variable v-full-tbl-name  as character no-undo .
      534       define variable bh_tbl-name      as handle    no-undo .
      535       define variable v-tbl-name       as character no-undo .
      536       define variable v-field-num      as integer   no-undo .
      537       define variable v-count-fld      as integer   no-undo .
      538       define variable v-inform         as character no-undo .
      539       define variable v-ind            as integer   no-undo .
      540       define variable v-idx-field-qnty as integer   no-undo .
      541       define variable v-delim-key      as character no-undo .
      542       if p-table = ?
      543         or p-table = "":U
      544       then do:
      545         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      546       end.
      547       assign
      548         v-tbl-name      = p-table
      549         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      550       .
      551       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      552       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      553       assign
      554         v-inform = bh_tbl-name:index-information(1)
      555         v-ind    = 2
      556       .
      557       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      558       on error undo, return error
      559       :
      560         assign
      561           v-inform = bh_tbl-name:index-information( v-ind )
      562           v-ind    = v-ind + 1
      563         .
      564       end.
      565       if v-inform = ?
      566         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      567         or entry( 3, v-inform, ",":U ) <> "1":U
      568       then do:
      569         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      570       end.
      571       assign
      572         v-idx-field-qnty = num-entries( v-inform ) - 4
      573       .
      574       if v-idx-field-qnty < 2 then do:
      575         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      576       end.
      577       assign
      578         p-field-list = "":U
      579         v-delim-key  = "":U
      580         v-count-fld  = 0
      581       .
      582       block_where:
      583       do v-ind = 1 to v-idx-field-qnty by 2
      584       on error undo, return error
      585       :
      586         assign
      587           v-count-fld = v-count-fld + 1
      588         .
      589         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      590         if v-ind = 1 then do:
      591           assign
      592             v-delim-key = chr(3)
      593           .
      594         end.
      595       end.
      596       delete object bh_tbl-name.
      597     end.
      598   end procedure.
      599   define variable v-path                    as character                no-undo .
      600   DEFINE VARIABLE v-full-path               as character                no-undo .
      601   DEFINE VARIABLE v-file-name               as character                no-undo .
      602   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      603   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      604   define variable v-uniq-key-rec            as character no-undo .
      605   define variable v-md5-signature           as character no-undo .
      606   define variable v-part-num as integer no-undo .
      607   define variable glog as logical no-undo .
      608   define variable v-int64-id as int64 no-undo .
      609   define variable v-blob-db-num as integer no-undo .
      610   define variable v-longchar1 as longchar no-undo .
      611   define variable v-longchar2 as longchar no-undo .
      612   define variable v-file-size as integer no-undo .
      613   define variable v-save-blob as logical no-undo .
      614   define buffer buf_blob-data for ub.blob-data.
      615   define buffer other_blob-data for ub.blob-data.
      616   define buffer other_blob-bind for ub.blob-bind.
      617   define buffer self_blob-bind for ub.blob-bind.
      618   FUNCTION is-abs-path returns logical ( input p-path-string as character):
      619   if index(p-path-string, ":") > 0
      620   or p-path-string begins (chr(47) + chr(47))
      621   or p-path-string begins (chr(92) + chr(92))
      622   or (index(p-path-string, chr(47)) = 0
      623   and index(p-path-string, chr(92)) = 0) then return yes.
      624   return no.
      625   end function.
      626   do
      627   on error undo, return error
      628   :
      629   if p-mode <> 'ПРОСМОТР':U   and
      630      p-mode <> 'удаление':U  then do:
      631       run gbl/filename.p (
      632                      input p-file
      633                     ,output v-full-path
      634                     ,output v-path
      635                     ,output v-file-name
      636                     ,output v-file-name-no-ext
      637                     ,output v-file-name-ext
      638                     ) no-error .
      639     if error-status:error then do:
      640       return error substitute("Не удается найти файл &1", p-file).
      641     end.
      642   end.
      643   if p-resource-type = 'data':U then do:
      644     run gen-key-rec in this-procedure ( input p-bh:table
      645                                       ,input p-bh
      646                                       ,output v-uniq-key-rec) no-error .
      647     if error-status:error then do:
      648       return error return-value .
      649     end.
      650     glog = p-bh:find-current( exclusive-lock) no-error.
      651     if error-status:error
      652     or not glog
      653     then do:
      654       undo, return error substitute("Не удалось заблокировать &1 для записи файла &2  в blob&3&4&3&5"
      655                                     ,v-uniq-key-rec
      656                                     ,p-file
      657                                     ,chr(10)
      658                                     , error-status:get-message(1)
      659                                     , return-value ).
      660     end.
      661   end.
      662   else do:
      663     v-uniq-key-rec = p-uniq-key-rec.
      664   end.
      665   case p-mode :
      666     when 'ПРОСМОТР':U then do:
      667       find first self_blob-bind  no-lock where
      668               self_blob-bind.uniq-key-rec = v-uniq-key-rec
      669           and self_blob-bind.field-name = p-field
      670           and self_blob-bind.part-num = p-part-num
      671           no-error.
      672       if not available self_blob-bind then do:
      673         undo, return error substitute("Не найдена ссылка на blob для &1 &2 номер части &3"
      674                                       ,v-uniq-key-rec
      675                                       ,p-field
      676                                       ,p-part-num).
      677       end.
      678       find first buf_blob-data  no-lock where
      679               buf_blob-data.db-num = self_blob-bind.db-num
      680           and buf_blob-data.int64-id = self_blob-bind.int64-id no-error.
      681       if not available buf_blob-data then do:
      682         undo, return error substitute("Не найден blob БД &1 id &2 для &3 &4 номер части &5"
      683                                       ,self_blob-bind.db-num
      684                                       ,self_blob-bind.int64-id
      685                                       ,v-uniq-key-rec
      686                                       ,p-field
      687                                       ,p-part-num).
      688       end.
      689       assign
      690       p-blob-db-num = self_blob-bind.db-num
      691       p-int64-id = self_blob-bind.int64-id
      692       .
      693       v-full-path = string(session :temp-directory) + 'tempBlob.jpg' .
      694       COPY-LOB
      695         FROM  OBJECT buf_blob-data.bdata
      696         TO    FILE   v-full-path
      697         No-convert
      698         NO-ERROR .
      699         if error-status :error then
      700         message
      701           vss-workfile vss-revision vss-description skip
      702           error-status :get-message(1) skip
      703           return-value skip
      704           "Ошибка"
      705           view-as alert-box error
      706         .
      707        os-command silent value( 'start ' + v-full-path ) .
      708       return '':U.
      709     end.
      710     when 'ДОБАВЛЕНИЕ':U then do:
      711       run gbl/md5.p (
      712                               input  v-full-path
      713                               ,output v-md5-signature
      714                               ) no-error .
      715       if error-status:error then do:
      716         undo, return error substitute("&1 &2 &3&4&5&4&6"
      717                                       ,vss-workfile
      718                                       ,vss-revision
      719                                       ,vss-description
      720                                       ,chr(10)
      721                                       , error-status:get-message(1)
      722                                       , return-value ).
      723       end.
      724       assign
      725       file-info:file-name = v-full-path.
      726       v-file-size = file-info:file-size.
      727       if v-file-size > 100000000 then do:
      728         undo, return error substitute("Слишком большой файл &1 (> 100000000Б)", v-full-path).
      729       end.
      730       if not (p-blob-db-num = ?
      731               and
      732               p-int64-id = 0) then do:
      733         find first buf_blob-data  share-lock where
      734                 buf_blob-data.db-num = p-blob-db-num
      735             and buf_blob-data.int64-id = p-int64-id no-error.
      736         if not available buf_blob-data then do:
      737           undo, return error substitute("Не найден blob БД &1 id &2"
      738                                         ,p-blob-db-num
      739                                         ,p-int64-id).
      740         end.
      741       end.
      742       find last self_blob-bind  no-lock where
      743               self_blob-bind.uniq-key-rec = v-uniq-key-rec
      744           and self_blob-bind.field-name = p-field no-error.
      745       if available self_blob-bind then do:
      746         assign
      747         v-part-num = self_blob-bind.part-num + 1.
      748       end.
      749       else do:
      750         v-part-num = 1.
      751       end.
      752       if not available buf_blob-data then do:
      753         create buf_blob-data.
      754         assign
      755         buf_blob-data.int64-id   = next-value( s-blob-int64, ub)
      756         buf_blob-data.db-num = g#db-num
      757         buf_blob-data.crc-field  = v-md5-signature
      758         buf_blob-data.file-size  = v-file-size
      759         buf_blob-data.resource-type = p-resource-type
      760         .
      761         buf_blob-data.file-name_ = (if is-abs-path(p-file) then v-file-name else p-file).
      762         COPY-LOB
      763         FROM  FILE v-full-path
      764         TO  OBJECT buf_blob-data.bdata
      765         No-convert
      766         NO-ERROR .
      767         if error-status:error then do:
      768           if error-status :error then do:
      769             v-longchar1 = '':U.
      770             v-longchar2 = '':U.
      771             undo, return error substitute("Ошибка при записи файла в БД&1:&2&3"
      772                                           , v-full-path
      773                                           , chr(10)
      774                                           , error-status:get-message(1) ).
      775           end.
      776         end.
      777       end.
      778       create self_blob-bind.
      779       assign
      780       self_blob-bind.uniq-key-rec = v-uniq-key-rec
      781       self_blob-bind.field-name = p-field
      782       self_blob-bind.part-num = v-part-num
      783       self_blob-bind.resource-type = p-resource-type
      784       self_blob-bind.db-num = buf_blob-data.db-num
      785       self_blob-bind.int64-id = buf_blob-data.int64-id
      786       self_blob-bind.descr = p-descr
      787       p-part-num = self_blob-bind.part-num
      788       p-blob-db-num = self_blob-bind.db-num
      789       p-int64-id = self_blob-bind.int64-id
      790       .
      791       release self_blob-bind no-error.
      792       if error-status:error then do:
      793         undo, return error substitute("&1 &2 &3Ошибки при сохранении связи BLOB с записью-владельцем &4 &5 &6&7&6&8"
      794                                       ,vss-workfile
      795                                       ,vss-revision
      796                                       ,vss-description
      797                                       ,v-uniq-key-rec
      798                                       ,p-field
      799                                       ,chr(10)
      800                                       , error-status:get-message(1)
      801                                       , return-value ).
      802       end.
      803       release buf_blob-data no-error.
      804       if error-status:error then do:
      805         undo, return error substitute("&1 &2 &3Ошибки при сохранении BLOB для &6&7&6&8"
      806                                       ,vss-workfile
      807                                       ,vss-revision
      808                                       ,vss-description
      809                                       ,v-uniq-key-rec
      810                                       ,p-field
      811                                       ,chr(10)
      812                                       , error-status:get-message(1)
      813                                       , return-value ).
      814       end.
      815     end.
      816     when 'ИЗМЕНЕНИЕ':U then do:
      817       if p-blob-mode <> "override"
      818       and p-blob-mode <> "add-new" then do:
      819         undo, return error  substitute("Неверное значение параметра p-clob-mode = &1", p-blob-mode).
      820       end.
      821       v-save-blob = yes.
      822       run gbl/md5.p (
      823                               input  v-full-path
      824                               ,output v-md5-signature
      825                               ) no-error .
      826       if error-status:error then do:
      827         undo, return error substitute("&1 &2 &3&4&5&4&6"
      828                                       ,vss-workfile
      829                                       ,vss-revision
      830                                       ,vss-description
      831                                       ,chr(10)
      832                                       , error-status:get-message(1)
      833                                       , return-value ).
      834       end.
      835       assign
      836       file-info:file-name = v-full-path.
      837       v-file-size = file-info:file-size.
      838       if v-file-size > 100000000 then do:
      839         undo, return error substitute("Слишком большой файл &1 (> 100000000Б)", v-full-path).
      840       end.
      841       find first self_blob-bind  exclusive-lock where
      842               self_blob-bind.uniq-key-rec = v-uniq-key-rec
      843           and self_blob-bind.field-name = p-field
      844           and self_blob-bind.part-num = p-part-num
      845           no-error.
      846       if not available self_blob-bind then do:
      847         undo, return error substitute("Не найдена ссылка на blob для &1 &2 номер части &3"
      848                                       ,v-uniq-key-rec
      849                                       ,p-field
      850                                       ,p-part-num).
      851       end.
      852       find first buf_blob-data  share-lock where
      853               buf_blob-data.db-num = self_blob-bind.db-num
      854           and buf_blob-data.int64-id = self_blob-bind.int64-id no-error.
      855       if not available buf_blob-data then do:
      856         undo, return error substitute("Не найден blob БД &1 id &2 для &3 &4 номер части &5"
      857                                       ,self_blob-bind.db-num
      858                                       ,self_blob-bind.int64-id
      859                                       ,v-uniq-key-rec
      860                                       ,p-field
      861                                       ,p-part-num).
      862       end.
      863       if p-blob-mode = "override" then do:
      864         for each other_blob-bind no-lock where
      865                   other_blob-bind.db-num = self_blob-bind.db-num
      866               and other_blob-bind.int64-id = self_blob-bind.int64-id:
      867           if not (other_blob-bind.uniq-key-rec = self_blob-bind.uniq-key-rec
      868                   and
      869                   other_blob-bind.field-name = self_blob-bind.field-name
      870                   and
      871                   other_blob-bind.part-num = self_blob-bind.part-num
      872                   ) then leave.
      873         end.
      874       end.
      875       if available other_blob-bind
      876       or p-blob-mode = "add-new"
      877       then do:
      878         create buf_blob-data.
      879         assign
      880         buf_blob-data.int64-id   = next-value( s-blob-int64, ub)
      881         buf_blob-data.db-num = g#db-num
      882         buf_blob-data.crc-field  = v-md5-signature
      883         buf_blob-data.file-size  = v-file-size
      884         buf_blob-data.resource-type = p-resource-type
      885         v-save-blob = yes
      886         .
      887         buf_blob-data.file-name_ = (if is-abs-path(p-file) then v-file-name else p-file)
      888         .
      889       end.
      890       else do:
      891         if buf_blob-data.crc-field = v-md5-signature
      892         and buf_blob-data.file-name_ = (if is-abs-path(p-file) then v-file-name else p-file) then do:
      893           v-save-blob = no.
      894         end.
      895         if v-save-blob then do:
      896           assign
      897           buf_blob-data.crc-field  = v-md5-signature
      898           buf_blob-data.file-size  = v-file-size
      899           buf_blob-data.file-name_ = (if is-abs-path(p-file) then v-file-name else p-file)
      900           .
      901         end.
      902       end.
      903       if v-save-blob then do:
      904         COPY-LOB
      905         FROM  FILE v-full-path
      906         TO  OBJECT buf_blob-data.bdata
      907         No-convert
      908         NO-ERROR .
      909         if error-status :error then do:
      910           undo, return error substitute("Ошибка при записи файла в БД&1:&2&3"
      911                                         , v-full-path
      912                                         , chr(10)
      913                                         , error-status:get-message(1) ).
      914         end.
      915         assign
      916         self_blob-bind.resource-type = p-resource-type
      917         self_blob-bind.db-num = buf_blob-data.db-num
      918         self_blob-bind.int64-id = buf_blob-data.int64-id
      919         self_blob-bind.descr = p-descr
      920         p-part-num = self_blob-bind.part-num
      921         p-blob-db-num = self_blob-bind.db-num
      922         p-int64-id = self_blob-bind.int64-id
      923         .
      924       end.
      925       release self_blob-bind no-error.
      926       if error-status:error then do:
      927         undo, return error substitute("&1 &2 &3Ошибки при сохранении связи BLOB с записью-владельцем &4 &5 &6&7&6&8"
      928                                       ,vss-workfile
      929                                       ,vss-revision
      930                                       ,vss-description
      931                                       ,v-uniq-key-rec
      932                                       ,p-field
      933                                       ,chr(10)
      934                                       , error-status:get-message(1)
      935                                       , return-value ).
      936       end.
      937       release buf_blob-data no-error.
      938       if error-status:error then do:
      939         undo, return error substitute("&1 &2 &3Ошибки при сохранении BLOB для &6&7&6&8"
      940                                       ,vss-workfile
      941                                       ,vss-revision
      942                                       ,vss-description
      943                                       ,v-uniq-key-rec
      944                                       ,p-field
      945                                       ,chr(10)
      946                                       , error-status:get-message(1)
      947                                       , return-value ).
      948       end.
      949     end.
      950     when 'удаление':U then do:
      951       if p-blob-mode <> "delete"
      952       and p-blob-mode <> "leave" then do:
      953         undo, return error  substitute("Неверное значение параметра p-blob-mode = &1", p-blob-mode).
      954       end.
      955       find first self_blob-bind  exclusive-lock where
      956               self_blob-bind.uniq-key-rec = v-uniq-key-rec
      957           and self_blob-bind.field-name = p-field
      958           and self_blob-bind.part-num = p-part-num
      959           no-error.
      960       if not available self_blob-bind then do:
      961         undo, return error substitute("Не найдена ссылка на blob для &1 &2 номер части &3"
      962                                       ,v-uniq-key-rec
      963                                       ,p-field
      964                                       ,p-part-num).
      965       end.
      966       assign
      967       v-blob-db-num = self_blob-bind.db-num
      968       v-int64-id = self_blob-bind.int64-id
      969       .
      970       delete self_blob-bind no-error .
      971       if error-status:error then do:
      972         undo, return error substitute("&1 &2 &3Ошибки при удалении связи BLOB с записью-владельцем &4 &5 &6&7&6&8"
      973                                       ,vss-workfile
      974                                       ,vss-revision
      975                                       ,vss-description
      976                                       ,v-uniq-key-rec
      977                                       ,p-field
      978                                       ,chr(10)
      979                                       , error-status:get-message(1)
      980                                       , return-value ).
      981       end.
      982       if p-blob-mode = "delete" then do:
      983         find first buf_blob-data exclusive-lock where
      984                   buf_blob-data.db-num = v-blob-db-num
      985              and  buf_blob-data.int64-id  = v-int64-id.
      986         delete buf_blob-data no-error.
      987         if error-status:error then do:
      988           undo, return error substitute("&1 &2 &3Ошибки при удалении BLOB для &6&7&6&8"
      989                                         ,vss-workfile
      990                                         ,vss-revision
      991                                         ,vss-description
      992                                         ,v-uniq-key-rec
      993                                         ,p-field
      994                                         ,chr(10)
      995                                         , error-status:get-message(1)
      996                                         , return-value ).
      997         end.
      998       end.
      999       assign
     1000       p-part-num = ?
     1001       p-blob-db-num = ?
     1002       p-int64-id = 0
     1003       .
     1004     end.
     1005     otherwise do:
     1006       undo, return error  substitute("Неверное значение параметра p-mode = &1", p-mode).
     1007     end.
     1008   end case.
     1009   end.
