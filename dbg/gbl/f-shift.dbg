      397   define buffer buf_shift-obj for ub.shift-obj.
      398   DEFINE BUTTON B-exit AUTO-GO
      399        LABEL "&Ввод"
      400        SIZE 10 BY 1
      401        BGCOLOR 8 .
      402   DEFINE BUTTON B-Help
      403        LABEL "Помо&щь"
      404        SIZE 10 BY 1
      405        BGCOLOR 8 .
      406   DEFINE BUTTON b-quit AUTO-END-KEY
      407        LABEL "&Отмена"
      408        SIZE 10 BY 1
      409        BGCOLOR 8 .
      410   DEFINE BUTTON B-sht
      411        IMAGE-UP FILE "btn-down-arrow":U
      412        IMAGE-DOWN FILE "btn-down-arrow":U
      413        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      414        LABEL "Btn 1"
      415        SIZE 3 BY .88.
      416   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      417        VIEW-AS FILL-IN
      418        SIZE 7 BY 1
      419        BGCOLOR 8  NO-UNDO.
      420   DEFINE VARIABLE f-obj-type AS CHARACTER FORMAT "X(3)":U
      421        LABEL "Объект"
      422        VIEW-AS FILL-IN
      423        SIZE 5 BY 1
      424        BGCOLOR 8  NO-UNDO.
      425   DEFINE VARIABLE f-shift-date AS DATE FORMAT "99/99/9999":U
      426        LABEL "Дата смены"
      427        VIEW-AS FILL-IN
      428        SIZE 12 BY 1
      429        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
      430   DEFINE VARIABLE f-shift-name AS CHARACTER FORMAT "X(3)":U
      431        LABEL "№ смены"
      432        VIEW-AS FILL-IN
      433        SIZE 3 BY 1
      434        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
      435   DEFINE VARIABLE f-shift-num AS INTEGER FORMAT ">9":U INITIAL 1
      436        LABEL "Пор. смены"
      437        VIEW-AS FILL-IN
      438        SIZE 5 BY 1
      439        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
      440   DEFINE FRAME Dialog-Frame
      441        B-exit AT ROW 1 COL 1
      442        b-quit AT ROW 1 COL 11
      443        B-Help AT ROW 1 COL 54.88
      444        f-obj-type AT ROW 3 COL 13.5 COLON-ALIGNED
      445        f-obj-code AT ROW 3 COL 20.5 COLON-ALIGNED NO-LABEL
      446        f-shift-date AT ROW 5 COL 13 COLON-ALIGNED
      447        f-shift-name AT ROW 5 COL 35 COLON-ALIGNED
      448        f-shift-num AT ROW 5 COL 51.5 COLON-ALIGNED
      449        B-sht AT ROW 5 COL 59.5
      450        SPACE(4.62) SKIP(1.32)
      451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      453            TITLE "Выбор смены"
      454            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      455   ASSIGN
      456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      457          FRAME Dialog-Frame:HIDDEN           = TRUE.
      458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      459   DO:
      460     APPLY "END-ERROR":U TO SELF.
      461   END.
      462   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      463   DO:
      464     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      465     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      466   END.
      467   ON CHOOSE OF B-sht IN FRAME Dialog-Frame
      468   DO:
      469     v-confirm = NO.
      470     run proc-sht IN THIS-PROCEDURE NO-ERROR.
      471     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      472   END.
      473   ON LEAVE OF f-shift-date IN FRAME Dialog-Frame
      474   DO:
      475       if input frame Dialog-Frame f-shift-date <> f-shift-date then do:
      476       assign
      477         f-shift-name   = ""
      478         f-shift-num = 0
      479         v-confirm = NO.
      480       display
      481       f-shift-name
      482       f-shift-num with frame Dialog-Frame.
      483       apply "entry" to f-shift-name in frame Dialog-Frame.
      484       return no-apply.
      485     end.
      486   END.
      487   ON RETURN OF f-shift-date IN FRAME Dialog-Frame
      488   DO:
      489     apply "entry" to f-shift-name in frame Dialog-Frame.
      490     return no-apply.
      491   END.
      492   ON LEAVE OF f-shift-name IN FRAME Dialog-Frame
      493   DO:
      494     IF INPUT FRAME Dialog-Frame f-shift-name <> f-shift-name THEN DO:
      495         v-confirm = NO.
      496     END.
      497     run proc-shift-name in this-procedure no-error .
      498     if error-status:error then do:
      499       return no-apply.
      500     end.
      501   END.
      502   ON RETURN OF f-shift-name IN FRAME Dialog-Frame
      503   DO:
      504     apply "entry" to b-exit in frame Dialog-Frame.
      505     return no-apply.
      506   END.
      507   ON LEAVE OF f-shift-num IN FRAME Dialog-Frame
      508   DO:
      509       IF INPUT FRAME Dialog-Frame f-shift-num <> f-shift-num THEN DO:
      510           v-confirm = NO.
      511       END.
      512     run proc-shift-num IN this-procedure no-error.
      513     if error-status:error then do:
      514       return no-apply.
      515     end.
      516   END.
      517   ON RETURN OF f-shift-num IN FRAME Dialog-Frame
      518   DO:
      519       apply "entry" to b-exit in frame Dialog-Frame.
      520     return no-apply.
      521   END.
      522   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      523   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      524   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   on help of frame Dialog-Frame
      526   do:
      527     run gbl/app_help.p
      528       (input this-procedure :file-name
      529       ,input ''
      530       ,input ?
      531       ) no-error.
      532     if error-status :error then do:
      533       message
      534         "Ошибка при вызове помощи"
      535         error-status :get-message(1)
      536         view-as alert-box .
      537     end.
      538   end.
      539   run minbtn-set in this-procedure .
      540   on choose of b-help in frame Dialog-Frame
      541   do:
      542     apply "help":u to frame Dialog-Frame .
      543   end.
      544   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   procedure minbtn-set :
      546       do
      547           on error undo, return error return-value
      548           :
      549           define variable ii              as integer       no-undo .
      550           define variable fh              as widget-handle no-undo .
      551           define variable hh              as widget-handle no-undo .
      552           define variable v-h             as handle        extent 4 no-undo .
      553           define variable v-name-button   as character     no-undo .
      554           define variable v-help-old-x    as decimal       no-undo .
      555           define variable v-help-old-y    as decimal       no-undo .
      556           define variable v-help-old-size as decimal       no-undo .
      557           define variable v-frame-width   as decimal       no-undo .
      558           define variable jj              as integer       no-undo .
      559           do
      560               on error undo, return error
      561               :
      562               assign
      563                   v-frame-width = frame Dialog-Frame:width - 0.3
      564                   fh            = frame Dialog-Frame:first-child
      565                   hh            = fh:first-child
      566                   ii            = 1
      567                   .
      568               do while valid-handle(hh):
      569                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      570                   do:
      571                       case lc(hh:name) :
      572                           when "b-help" then
      573                               do:
      574                                   hh:load-image-up("cmp/b-help.bmp":u) .
      575                                   hh:load-image-down("cmp/b-help.bmp":u) .
      576                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      577                                   hh:TOOLTIP = "Помощь" .
      578                                   v-help-old-x = hh:column .
      579                                   v-help-old-y = hh:row    .
      580                                   v-help-old-size = hh:width .
      581                                   hh:width-chars = 2.5 .
      582                               end.
      583                           when "b-print" then
      584                               do:
      585                                   hh:load-image("cmp/b-print.bmp":u) .
      586                                   hh:TOOLTIP = "Печать" .
      587                                   v-h[ii] = hh:handle .
      588                                   ii = ii + 1 .
      589                                   hh:width-chars = 3 .
      590                               end.
      591                           when "b-history" or
      592                           when "b-hist" then
      593                               do:
      594                                   hh:load-image("cmp/b-hist.bmp":u) .
      595                                   hh:TOOLTIP = "История" .
      596                                   v-h[ii] = hh:handle .
      597                                   ii = ii + 1 .
      598                                   hh:width-chars = 3 .
      599                               end.
      600                           when "b-sch" then
      601                               do:
      602                                   hh:load-image("cmp/b-sch.bmp":u) .
      603                                   hh:TOOLTIP = "Установка Фильтра" .
      604                                   v-h[ii] = hh:handle .
      605                                   ii = ii + 1 .
      606                                   hh:width-chars = 3 .
      607                               end.
      608                           when "b-hist-user" then
      609                               do:
      610                                   hh:load-image("cmp/b-hist.bmp":u) .
      611                                   hh:TOOLTIP = "История пользователя" .
      612                                   ii = ii + 1 .
      613                               end.
      614                       end case.
      615                   end.
      616                   hh = hh:next-sibling.
      617               end.
      618               b-help:column = v-frame-width - b-help:width-chars.
      619               jj = 0.
      620               repeat ii = 4 to 1 by -1 :
      621                   if valid-handle (v-h[ii] ) then
      622                   do:
      623                       jj  = jj + 1 .
      624                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      625                       v-h[ii]:row    = v-help-old-y .
      626                   end.
      627               end.
      628           end.
      629       end.
      630   end procedure.
      631   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   on F1 of frame Dialog-Frame anywhere do:
      633     if b-Help :sensitive then DO: apply "CHOOSE":U to b-Help in frame Dialog-Frame. END.
      634     return no-apply.
      635   end.
      636   MAIN-BLOCK:
      637   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      638      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      639   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640     run mainmenu_getcntxt in parparentproc
      641       (output v-cntxt-db-num
      642       ,output v-cntxt-userid
      643       ,output v-cntxt-level
      644       ,output v-cntxt-host-code-obj
      645       ,output v-cntxt-obj-type
      646       ,output v-cntxt-obj-code
      647       ,output v-cntxt-db-num-obj
      648       ,output v-cntxt-is-admin
      649       ) .
      650     RUN proc-start IN THIS-PROCEDURE NO-ERROR.
      651     IF ERROR-STATUS:ERROR THEN RETURN ERROR.
      652     RUN Myenable.
      653     WAIT-FOR GO OF FRAME Dialog-Frame.
      654   END.
      655   RUN disable_UI.
      656   PROCEDURE disable_UI :
      657     HIDE FRAME Dialog-Frame.
      658   END PROCEDURE.
      659   PROCEDURE enable_UI :
      660     DISPLAY f-obj-type f-obj-code f-shift-date f-shift-name f-shift-num
      661         WITH FRAME Dialog-Frame.
      662     ENABLE B-exit b-quit B-Help f-obj-type f-obj-code f-shift-date f-shift-name
      663            f-shift-num B-sht
      664         WITH FRAME Dialog-Frame.
      665     VIEW FRAME Dialog-Frame.
      666   END PROCEDURE.
      667   PROCEDURE MyEnable :
      668   FRAME Dialog-Frame:TITLE = FRAME Dialog-Frame:TITLE + (IF p-obj-code <> 0
      669                                                            THEN (p-obj-type + STRING(p-obj-code))
      670                                                            ELSE '':U)
      671   .
      672   DISPLAY
      673   f-obj-type
      674   f-obj-code
      675   f-shift-date
      676   f-shift-name
      677   f-shift-num
      678   WITH FRAME Dialog-Frame.
      679   ENABLE
      680   B-exit
      681   b-quit
      682   B-Help
      683   f-shift-date WHEN (p-obj-code <> 0)
      684   f-shift-name WHEN (p-obj-code <> 0)
      685   f-shift-num WHEN (p-obj-code <> 0)
      686   B-sht WITH FRAME Dialog-Frame.
      687   VIEW FRAME Dialog-Frame.
      688   IF f-shift-date:SENSITIVE THEN DO:
      689       APPLY "ENTRY" TO f-shift-date.
      690   END.
      691   ELSE DO:
      692      APPLY "ENTRY" TO b-sht.
      693   END.
      694   END PROCEDURE.
      695   PROCEDURE proc-save :
      696   if input frame Dialog-Frame f-shift-date = ? then do:
      697     MESSAGE
      698     "Вы не ввели дату смены"
      699      VIEW-AS ALERT-BOX ERROR.
      700     UNDO, RETURN ERROR.
      701   END.
      702   IF NOT p-mandatory
      703   AND v-confirm THEN DO:
      704   END.
      705   ELSE DO:
      706       IF INPUT FRAME Dialog-Frame f-shift-num = 0  THEN
      707       RUN proc-shift-name IN THIS-PROCEDURE NO-ERROR.
      708       ELSE
      709       RUN proc-shift-num IN THIS-PROCEDURE NO-ERROR.
      710       IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
      711   END.
      712   if znak = "=" then do:
      713    assign
      714      join-tbl = " AND "
      715      join_rus = " И "
      716    .
      717   end.
      718   else do:
      719    assign
      720      join-tbl = " OR "
      721      join_rus = " ИЛИ "
      722    .
      723   end.
      724   assign
      725    vh = frame Dialog-Frame :first-child
      726   .
      727   do while ( vh <> ? ):
      728     assign fh = vh :first-child.
      729     _DO:
      730     do while ( fh <> ? ) :
      731       if fh :type = 'fill-in'
      732       then do:
      733         if p-obj-code > 0 and
      734         (fh:name = "f-obj-type"
      735         or
      736         fh:name = "f-obj-code") then do:
      737           assign
      738             fh = fh :next-sibling
      739           .
      740           next _do.
      741         end.
      742         if next-fill-in then do:
      743           assign
      744             str     = str     + (if fh:name <> 'f-shift-name' then join-tbl else '')
      745             str_rus = str_rus + (if fh:name <> 'f-shift-num' then join_rus else '')
      746           .
      747         end.
      748         assign
      749           next-fill-in = yes
      750         .
      751         assign
      752         ss            = fh :screen-value
      753         s_description = fh :screen-value
      754         aa            = ( if fh :data-type = "character" then '"' else '' )
      755         .
      756         if fh :data-type = "date"
      757         then do:
      758           define variable v-date as date      no-undo .
      759           assign
      760             v-date = date(fh :screen-value)
      761           .
      762           if v-date = ?
      763           then do:
      764             assign
      765               ss             = chr(63)
      766               s_description = "НЕ_ЗАДАНА"
      767             .
      768           end.
      769           else do:
      770             assign
      771              ss             = 'date(':u + string(month(v-date))
      772                             + '~~054':u + string(day(v-date))
      773                             + '~~054':u + string(year(v-date))
      774                             + ')':u
      775               s_description = string(v-date, "99/99/9999")
      776             .
      777           end.
      778         end.
      779         if fh :data-type = "character"
      780         then do:
      781           run replace-special-char in this-procedure
      782             (input  ss
      783             ,output ss
      784             ) .
      785           assign
      786             s_description = replace(s_description, ',', '~~054')
      787           .
      788         end.
      789         if fh:name = 'f-shift-name' then do:
      790           assign
      791             str     = str
      792             str_rus = str_rus + entry( 2, fh :private-data ) + " " + znak + " " +
      793                       substitute("&1(&2)"
      794                                  ,f-shift-name:screen-value
      795                                  ,f-shift-num:screen-value).
      796           .
      797         END.
      798         ELSE DO:
      799           assign
      800             str     = str     + entry( 1, fh :private-data ) + " " + znak + " " + aa + ss            + aa
      801             str_rus = str_rus + (if fh:name <> 'f-shift-num'
      802                                  then  (entry( 2, fh :private-data ) + " " + znak + " " + aa + s_description + aa)
      803                                  else '')
      804           .
      805         END.
      806       end.
      807       assign
      808         fh = fh :next-sibling
      809       .
      810     end.
      811     assign
      812       vh = vh :next-sibling
      813     .
      814   end.
      815   assign
      816    str     = "(" + str     + ")"
      817    str_rus = "(" + str_rus + ")"
      818   .
      819   END PROCEDURE.
      820   PROCEDURE proc-shift-name :
      821   define buffer buf_shift-obj   for ub.shift-obj.
      822   define variable v-find-shift as integer initial 0.
      823   define variable v-shift-date like ub.shift-obj.shift-date no-undo.
      824   define variable v-shift-num  like ub.shift-obj.shift-num  no-undo.
      825   define variable glog as logical no-undo .
      826   if input frame Dialog-Frame f-shift-date <> ? then do:
      827   for each  buf_shift-obj no-lock  where
      828            buf_shift-obj.obj-type   = f-obj-type
      829       AND  buf_shift-obj.obj-code   = f-obj-code
      830       AND  buf_shift-obj.shift-date = input frame Dialog-Frame f-shift-date
      831       AND  buf_shift-obj.shift-name = input frame Dialog-Frame f-shift-name
      832       on error undo, return error return-value :
      833     assign
      834       v-find-shift = v-find-shift + 1
      835       v-shift-date = buf_shift-obj.shift-date
      836       v-shift-num  = buf_shift-obj.shift-num.
      837   end.
      838   if v-find-shift = 0
      839   or v-find-shift > 1 then do:
      840     if v-find-shift = 0 then do:
      841       message substitute("Не найдена смена: &1&2&3" +
      842                          "Дата &4 Номер смены &5."
      843                          ,p-obj-type
      844                          ,p-obj-code
      845                          ,chr(10)
      846                          ,input frame Dialog-Frame f-shift-date
      847                          ,input frame Dialog-Frame f-shift-name)
      848       view-as alert-box error.
      849     end.
      850     else do:
      851       message
      852       SUBSTITUTE("Найдено более одной смены с одним номером в сменном дне.&1" +
      853                 "Объект: &2&3 Дата &4 Номер смены &5."
      854                 ,chr(10)
      855                 ,p-obj-type
      856                 ,p-obj-code
      857                 ,input frame Dialog-Frame f-shift-date
      858                 ,input frame Dialog-Frame f-shift-name)
      859       view-as alert-box error.
      860     end.
      861     if not p-mandatory
      862     and v-find-shift = 0
      863     then do:
      864       message
      865       "Хотите задать значения даты смены/№ смены, не соответвующие ни одной из имеющихся в БД смен?"
      866       view-as alert-box question buttons YES-NO update glog.
      867       if glog then do:
      868         assign frame Dialog-Frame
      869         f-shift-name.
      870         v-confirm = YES.
      871         return.
      872       end.
      873     end.
      874     display
      875     f-shift-name
      876     with frame Dialog-Frame.
      877     run proc-sht IN THIS-PROCEDURE no-error.
      878     if error-status:error then do:
      879       return error.
      880     end.
      881   end.
      882   else do:
      883     assign frame Dialog-Frame
      884     f-shift-name.
      885   end.
      886   end.
      887   END PROCEDURE.
      888   PROCEDURE proc-shift-num :
      889   define variable glog as logical no-undo .
      890   define buffer buf_shift-obj   for ub.shift-obj.
      891   if input frame Dialog-Frame f-shift-date <> ? then do:
      892   find first buf_shift-obj where
      893              buf_shift-obj.obj-type   = f-obj-type
      894          and buf_shift-obj.obj-code   = f-obj-code
      895          AND buf_shift-obj.shift-date = input frame Dialog-Frame f-shift-date
      896          and buf_shift-obj.shift-num  = input frame Dialog-Frame f-shift-num  no-lock no-error.
      897   if not available buf_shift-obj then do:
      898     message substitute("Не найдена смена: &1&2&3"  +
      899                        "Дата &4 Порядок смены &5."
      900                        ,p-obj-type
      901                        ,p-obj-code
      902                        , chr(10)
      903                        ,input frame Dialog-Frame f-shift-date
      904                        ,input frame Dialog-Frame f-shift-num)
      905     view-as alert-box error.
      906     if not p-mandatory then do:
      907       message
      908       "Хотите задать значения даты смены/№ смены, не соответвующие ни одной из имеющихся в БД смен?"
      909       view-as alert-box question buttons YES-NO update glog.
      910       if glog then do:
      911         assign frame Dialog-Frame
      912         f-shift-num
      913         v-confirm = YES
      914         .
      915         return.
      916       end.
      917     end.
      918     display
      919     f-shift-num
      920     with frame Dialog-Frame.
      921     run proc-sht IN this-procedure no-error.
      922     if error-status:error then do:
      923       return error.
      924     end.
      925   end.
      926   else do:
      927     assign
      928     f-shift-date = buf_shift-obj.shift-date
      929     f-shift-num  = buf_shift-obj.shift-num
      930     f-shift-name = buf_shift-obj.shift-name.
      931     display
      932     f-shift-date
      933     f-shift-num
      934     f-shift-name
      935     with frame Dialog-Frame.
      936   end.
      937   end.
      938   END PROCEDURE.
      939   PROCEDURE proc-sht :
      940   define buffer buf_shift-obj   for ub.shift-obj.
      941   define variable v-rid-list as character no-undo.
      942   define variable v-recid    as recid     no-undo.
      943   assign
      944   v-rid-list = "".
      945   run str/sht-all.w (input parparentproc
      946                , INPUT v-cntxt-obj-type
      947                , input v-cntxt-obj-code
      948                , input 'b-sel'
      949                , input (if p-obj-code > 0 then 'obj' else 'all')
      950                , INPUT (if p-obj-type <> '':U then p-obj-type else v-cntxt-obj-type)
      951                , input (if p-obj-code <> 0 then p-obj-code else v-cntxt-obj-code)
      952                , input '':u
      953                , input-output v-rid-list) no-error.
      954   if error-status:error
      955   or v-rid-list = "":u then do:
      956     return error.
      957   end.
      958   else do:
      959     assign
      960     v-recid = integer (entry(1, v-rid-list)).
      961     find first buf_shift-obj NO-LOCK where
      962              recid(buf_shift-obj) = v-recid no-error.
      963     assign
      964     f-obj-type   = buf_shift-obj.obj-type
      965     f-obj-code   = buf_shift-obj.obj-code
      966     f-shift-date = buf_shift-obj.shift-date
      967     f-shift-num  = buf_shift-obj.shift-num
      968     f-shift-name    = buf_shift-obj.shift-name.
      969     display
      970     f-obj-type
      971     f-obj-code
      972     f-shift-date
      973     f-shift-num
      974     f-shift-name
      975     with frame Dialog-Frame.
      976   end.
      977   END PROCEDURE.
      978   PROCEDURE proc-start :
      979   define variable vdopstr as character no-undo .
      980   define variable v-param-list as character no-undo .
      981   define variable ii as integer no-undo .
      982   if num-entries(spr, chr(4)) > 1 then do:
      983   assign
      984   vdopstr = spr
      985   spr = entry(1, vdopstr, chr(4) )
      986   .
      987   entry(1, vdopstr, chr(4) ) = ''.
      988   v-param-list = substring(vdopstr, 2).
      989   end.
      990   IF v-param-list <> '':U THEN DO:
      991       ASSIGN
      992       p-obj-type = ENTRY(1, v-param-list, chr(4))
      993       p-obj-code = integer(ENTRY(2, v-param-list, chr(4)))
      994       p-mandatory = LOGICAL(ENTRY(3, v-param-list, chr(4)))
      995       NO-ERROR
      996       .
      997       IF ERROR-STATUS:ERROR  THEN DO:
      998           UNDO, RETURN ERROR.
      999       END.
     1000     ASSIGN
     1001     f-obj-type = p-obj-type
     1002     f-obj-code = p-obj-code
     1003     .
     1004   END.
     1005   ASSIGN
     1006   f-shift-name:PRIVATE-DATA IN FRAME Dialog-Frame = ",Номер смены".
     1007   do ii = 1 to num-entries(fld, '*'):
     1008     if entry(2, entry(ii, fld, '*'), '.') = "shift-date" then do:
     1009       assign
     1010       f-shift-date:private-data IN FRAME Dialog-Frame = entry(ii, fld, '*') + chr(44) +
     1011                                                          replace(entry(ii, lab, '*'), "&", '').
     1012     end.
     1013     if entry(2, entry(ii, fld, '*'), '.') = "shift-num" then do:
     1014       assign
     1015       f-shift-num:private-data IN FRAME Dialog-Frame = entry(ii, fld, '*') + chr(44) +
     1016                                                         replace(entry(ii, lab, '*'), "&", '').
     1017     end.
     1018     if entry(2, entry(ii, fld, '*'), '.') = "obj-type" then do:
     1019       assign
     1020       f-obj-type:private-data IN FRAME Dialog-Frame = entry(ii, fld, '*') + chr(44) +
     1021                                                        replace(entry(ii, lab, '*'), "&", '').
     1022     end.
     1023     if entry(2, entry(ii, fld, '*'), '.') = "obj-code" then do:
     1024       assign
     1025       f-obj-code:private-data IN FRAME Dialog-Frame = entry(ii, fld, '*') + chr(44) +
     1026                                                        replace(entry(ii, lab, '*'), "&", '').
     1027     end.
     1028   END.
     1029   END PROCEDURE.
     1030   PROCEDURE replace-special-char :
     1031   define input  parameter p-in-string    as character no-undo .
     1032     define output parameter p-out-string   as character no-undo .
     1033     define variable v-out-string   as character no-undo .
     1034     define variable v-enclose-char as character no-undo .
     1035     do
     1036     on error undo, return error return-value
     1037     :
     1038       assign
     1039         v-out-string   = p-in-string
     1040         v-enclose-char = '"'
     1041       .
     1042       if index(v-out-string, '"') > 0
     1043       then do:
     1044         assign
     1045           v-out-string = replace(v-out-string, '"', v-enclose-char + ' + chr(' + string(asc('"')) + ') + ' + v-enclose-char)
     1046         .
     1047       end.
     1048       if index(v-out-string, '~~') > 0
     1049       then do:
     1050         assign
     1051           v-out-string = replace(v-out-string, '~~', v-enclose-char + ' + chr(' + string(asc('~~')) + ') + ' + v-enclose-char)
     1052         .
     1053       end.
     1054       if index(v-out-string, ',') > 0
     1055       then do:
     1056         assign
     1057           v-out-string = replace(v-out-string, ',', v-enclose-char + ' + chr(' + string(asc(',')) + ') + ' + v-enclose-char)
     1058         .
     1059       end.
     1060       if index(v-out-string, "'") > 0
     1061       then do:
     1062         assign
     1063           v-out-string = replace(v-out-string, "'", v-enclose-char + ' + chr(' + string(asc("'")) + ') + ' + v-enclose-char)
     1064         .
     1065       end.
     1066       if index(v-out-string, '/') > 0
     1067       then do:
     1068         assign
     1069           v-out-string = replace(v-out-string, '/', v-enclose-char + ' + chr(' + string(asc('/')) + ') + ' + v-enclose-char)
     1070         .
     1071       end.
     1072       assign
     1073         p-out-string = v-out-string
     1074       .
     1075     end.
     1076   END PROCEDURE.
