      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376     define variable v-cntxt-db-num        as integer   no-undo .
      377     define variable v-cntxt-userid        as character no-undo .
      378     define variable v-cntxt-level         as character no-undo .
