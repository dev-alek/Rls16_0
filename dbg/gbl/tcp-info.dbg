        1   block-level on error undo, throw.
        2   define output parameter p-host-name  as character no-undo .
        3   define output parameter p-ip-address as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: tcp-info.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: gbl/tcp-info.p $":U .
        9   define variable vss-description as character no-undo init "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   do
       65   on error undo, return error return-value
       66   :
       67     run gettcpinfo in this-procedure
       68       (output p-host-name
       69       ,output p-ip-address
       70       ).
       71   end.
       72   PROCEDURE GetTcpInfo:
       73     DEFINE OUTPUT PARAMETER p-TcpName AS CHARACTER NO-UNDO.
       74     DEFINE OUTPUT PARAMETER p-TcpAddr AS CHARACTER NO-UNDO.
       75     do
       76     on error undo, return error return-value
       77     :
       78       DEFINE VARIABLE w-TcpName AS CHARACTER NO-UNDO.
       79       DEFINE VARIABLE w-Length AS INTEGER NO-UNDO.
       80       DEFINE VARIABLE w-Return AS INTEGER NO-UNDO.
       81       DEFINE VARIABLE ptr-WsaData AS MEMPTR NO-UNDO.
       82       DEFINE VARIABLE w-Hostent AS INTEGER NO-UNDO.
       83       DEFINE VARIABLE ptr-Hostent AS MEMPTR NO-UNDO.
       84       DEFINE VARIABLE ptr-AddrString AS MEMPTR NO-UNDO.
       85       DEFINE VARIABLE ptr-AddrList AS MEMPTR NO-UNDO.
       86       DEFINE VARIABLE ptr-ListEntry AS MEMPTR NO-UNDO.
       87       DEFINE VARIABLE w-TcpLong AS INTEGER NO-UNDO.
       88       ASSIGN p-TcpName = ?
       89       p-TcpAddr = ?
       90       .
       91       SET-SIZE(ptr-WsaData) = 403.
       92       RUN WSAStartup
       93         (INPUT 257
       94         ,INPUT GET-POINTER-VALUE(ptr-WsaData)
       95         ,OUTPUT w-Return
       96         ).
       97       SET-SIZE(ptr-WsaData) = 0.
       98       IF w-Return <> 0
       99       THEN DO:
      100         undo, return error "Ошибка при инициализации библиотеки WINSOCK" .
      101       END.
      102       ASSIGN
      103         w-Length = 100
      104         w-TcpName = FILL(" ", w-Length)
      105       .
      106       RUN gethostname
      107         (OUTPUT w-TcpName
      108         ,INPUT  w-Length
      109         ,OUTPUT w-Return
      110         ).
      111       IF w-Return <> 0
      112       THEN DO:
      113         RUN WSACleanup
      114           (OUTPUT w-Return
      115           ).
      116         undo, return error "Ошибка при получении имени компьютера" .
      117       END.
      118       assign
      119         p-TcpName = ENTRY(1,w-TcpName,CHR(0))
      120       .
      121       RUN gethostbyname
      122         (INPUT w-TcpName
      123         ,OUTPUT w-Hostent
      124         ).
      125       IF w-Hostent EQ 0
      126       THEN DO:
      127         RUN WSACleanup
      128           (OUTPUT w-Return
      129           ).
      130         undo, return error "Ошибка при получении адреса компьютера по имени" .
      131       END.
      132       assign
      133         SET-POINTER-VALUE(ptr-Hostent) = w-Hostent
      134       .
      135       assign
      136         SET-POINTER-VALUE(ptr-AddrList)  = GET-LONG(ptr-Hostent, 13)
      137         SET-POINTER-VALUE(ptr-ListEntry) = GET-LONG(ptr-AddrList, 1)
      138         w-TcpLong                        = GET-LONG(ptr-ListEntry, 1)
      139       .
      140       RUN inet_ntoa
      141         (INPUT w-TcpLong
      142         ,OUTPUT ptr-AddrString
      143         ).
      144       assign
      145         p-TcpAddr = GET-STRING(ptr-AddrString, 1)
      146       .
      147       RUN WSACleanup
      148         (OUTPUT w-Return
      149         ).
      150     end.
      151   END PROCEDURE.
      152   PROCEDURE gethostname EXTERNAL "wsock32.dll" :
      153   DEFINE OUTPUT PARAMETER p-Hostname AS CHARACTER.
      154   DEFINE INPUT PARAMETER p-Length AS LONG.
      155   DEFINE RETURN PARAMETER p-Return AS LONG.
      156   END PROCEDURE.
      157   PROCEDURE gethostbyname EXTERNAL "wsock32.dll" :
      158   DEFINE INPUT PARAMETER p-Name AS CHARACTER.
      159   DEFINE RETURN PARAMETER p-Hostent AS LONG.
      160   END PROCEDURE.
      161   PROCEDURE inet_ntoa EXTERNAL "wsock32.dll" :
      162   DEFINE INPUT PARAMETER p-AddrStruct AS LONG.
      163   DEFINE RETURN PARAMETER p-AddrString AS MEMPTR.
      164   END PROCEDURE.
      165   PROCEDURE WSAStartup EXTERNAL "wsock32.dll" :
      166   DEFINE INPUT PARAMETER p-VersionReq AS SHORT.
      167   DEFINE INPUT PARAMETER ptr-WsaData AS LONG.
      168   DEFINE RETURN PARAMETER p-Return AS LONG.
      169   END PROCEDURE.
      170   PROCEDURE WSACleanup EXTERNAL "wsock32":
      171   DEFINE RETURN PARAMETER p-Return AS LONG.
      172   END PROCEDURE.
