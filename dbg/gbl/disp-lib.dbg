        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: disp-lib.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: gbl/disp-lib.p $":U .
        7   define variable vss-description as character no-undo init "Библионтека для обслуживания банковских карт (Сбербанк)".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define new global shared variable g#disp-lib as handle no-undo.
      116   if valid-handle (g#disp-lib)
      117   and g#disp-lib <> this-procedure :handle
      118   and g#disp-lib :get-signature('library_testproc':u) <> ""
      119   then do:
      120     message
      121       vss-workfile vss-revision vss-description skip
      122       "Попытка повторной загрузки библиотеки" skip
      123       g#disp-lib skip
      124       g#disp-lib :type skip
      125       g#disp-lib :file-name skip
      126       valid-handle(g#disp-lib) skip
      127       this-procedure :handle skip
      128       this-procedure :type skip
      129       this-procedure :file-name skip
      130       valid-handle(this-procedure) skip
      131       view-as alert-box error .
      132     undo, return error return-value .
      133   end.
      134   else do:
      135     assign
      136       g#disp-lib = this-procedure :handle
      137     .
      138   end.
      139   if this-procedure :persistent <> true
      140   then do:
      141     message
      142       vss-workfile vss-revision vss-description skip
      143       "Ошибка запуска библиотеки" program-name(1) skip
      144       "Попытка запустить ее как обычную процедуру" skip
      145       view-as alert-box error .
      146   end.
      147   on delete of this-procedure do:
      148     assign
      149       g#disp-lib = ?
      150     .
      151   end.
      152   DEFINE VARIABLE v-disp          AS COM-HANDLE     NO-UNDO .
      153   define variable v-disp-type    as integer      no-undo.
      154   define variable v-disp-Open    as logical      no-undo.
      155   define variable v-str-len      as integer      no-undo.
      156   DEFINE VARIABLE CtrlFrame-2     AS WIDGET-HANDLE NO-UNDO.
      157   DEFINE VARIABLE chCtrlFrame-2   AS COMPONENT-HANDLE NO-UNDO.
      158   DEFINE FRAME Dialog-Frame-2
      159              SPACE(9.13) SKIP(1.57)
      160           WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      161            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      162            TITLE ""
      163            .
      164   procedure disp-init :
      165   define input parameter  p-first-string          as character      no-undo .
      166   define input parameter  p-second-string         as character      no-undo .
      167   define input parameter  p-customer-display-type as character        no-undo .
      168   define input parameter  p-customer-display-port as integer        no-undo .
      169   define output parameter p-message               as character      no-undo .
      170   define output parameter p-ok                    as logical        no-undo .
      171   bl:
      172   do
      173   on error undo, return error
      174   :
      175      RELEASE OBJECT v-disp NO-ERROR.
      176      v-disp = ?.
      177      CASE p-customer-display-type:
      178         WHEN 'Shtrih-M_v_A1.40':U
      179         THEN DO:
      180            CREATE "DrvDspl.v1_2":U v-disp NO-ERROR.
      181            IF ERROR-STATUS:ERROR
      182            OR NOT VALID-HANDLE(v-disp)
      183            THEN DO:
      184               ASSIGN
      185                  p-message = "Не найден COM-сервер для дисплея покупателя"
      186               .
      187               RETURN.
      188            END.
      189            assign
      190               v-disp-Open = YES
      191               v-disp-type = 201
      192               v-str-len   = 20
      193            .
      194            v-disp:CONNECT() NO-ERROR.
      195            IF ERROR-STATUS:ERROR
      196            THEN DO:
      197               ASSIGN
      198                  p-message = RETURN-VALUE
      199                  p-ok = FALSE
      200               .
      201               RETURN.
      202            END.
      203            v-disp:InitialDispl () NO-ERROR.
      204            IF ERROR-STATUS:ERROR
      205            THEN DO:
      206               ASSIGN
      207                  p-message = RETURN-VALUE
      208                  p-ok = FALSE
      209               .
      210               RETURN.
      211            END.
      212            v-disp:Test () NO-ERROR.
      213            IF ERROR-STATUS:ERROR
      214            THEN DO:
      215               ASSIGN
      216                  p-message = RETURN-VALUE
      217                  p-ok = FALSE
      218               .
      219               RETURN.
      220            END.
      221            run disp-str IN THIS-PROCEDURE ( INPUT  p-first-string
      222                                          , INPUT  p-second-string
      223                                          , OUTPUT p-message
      224                                          , OUTPUT p-ok
      225                                          ) .
      226         END.
      227         WHEN 'Posiflex-pd2800-320':U THEN
      228         DO:
      229          DEF VAR v-pd     AS COM-HANDLE NO-UNDO .
      230          run control_load in this-procedure  .
      231          DEF VAR v-i AS INT NO-UNDO .
      232          v-pd = chCtrlFrame-2:controls .
      233          v-disp = v-pd:ITEM(1) .
      234          IF VALID-HANDLE(v-disp) THEN
      235          DO:
      236              v-i = v-disp:OPEN("pd320") .
      237              v-i = v-disp:ClaimDevice(0) .
      238              IF v-disp:claimed THEN
      239              DO:
      240                assign
      241                  v-disp:DeviceEnabled = YES
      242                  v-disp-open = yes
      243                  v-disp:CharacterSet = 866
      244                  v-str-len = v-disp:DeviceColumns
      245                  v-disp-type = 320
      246                  .
      247                  run disp-str IN THIS-PROCEDURE ( INPUT  p-first-string
      248                                          , INPUT  p-second-string
      249                                          , OUTPUT p-message
      250                                          , OUTPUT p-ok
      251                                          ) .
      252              END.
      253          END.
      254         END.
      255         OTHERWISE DO:
      256         end.
      257      END CASE.
      258      assign
      259         p-ok = TRUE
      260      .
      261   end.
      262   end procedure.
      263   PROCEDURE disp-str :
      264   define input parameter  p-first-string    as character        no-undo.
      265   define input parameter  p-second-string   as character        no-undo.
      266   define output parameter p-message as character        no-undo.
      267   define output parameter p-ok          as logical          no-undo.
      268   define variable v-line    as character    no-undo.
      269   IF VALID-HANDLE(v-disp)
      270   THEN DO
      271   ON ERROR UNDO, RETURN ERROR
      272   :
      273      CASE v-disp-type :
      274         WHEN 201 THEN DO:
      275            run disp-clear IN THIS-PROCEDURE ( OUTPUT p-message
      276                                             , OUTPUT  p-ok
      277                                             ) .
      278            run disp-fmt IN THIS-PROCEDURE ( INPUT  p-first-string
      279                                           , INPUT  p-second-string
      280                                           , OUTPUT v-line
      281                                           , OUTPUT p-message
      282                                           , OUTPUT  p-ok
      283                                           ) .
      284            v-disp:EnterStr( INPUT 0, INPUT v-line ) NO-ERROR.
      285            IF ERROR-STATUS:ERROR
      286            THEN DO:
      287               ASSIGN
      288                  p-message = RETURN-VALUE
      289                  p-ok = FALSE
      290               .
      291               RETURN.
      292            END.
      293         END.
      294         WHEN 320 THEN DO:
      295               run disp-clear IN THIS-PROCEDURE ( OUTPUT p-message
      296                                             , OUTPUT  p-ok
      297                                             ) .
      298                  v-disp:DisplayTextAT(2,1,
      299                        codepage-convert(substr(p-first-string,1,v-str-len),"ibm866",SESSION:CHARSET),6)
      300                        .
      301                  v-disp:DisplayTextAT(1,1,
      302                            codepage-convert(substr(p-second-string,1,v-str-len),"ibm866",SESSION:CHARSET),6)
      303                            .
      304         END.
      305         OTHERWISE DO:
      306         end.
      307      END CASE.
      308      ASSIGN
      309         p-ok = TRUE
      310      .
      311   END.
      312   ELSE DO:
      313      ASSIGN
      314         p-ok = TRUE
      315      .
      316   END.
      317   END PROCEDURE.
      318   PROCEDURE disp-fmt :
      319   define input parameter  p-line-1    as character        no-undo.
      320   define input parameter  p-line-2    as character        no-undo.
      321   define output parameter p-out-line  as character        no-undo.
      322   define output parameter p-message   as character        no-undo.
      323   define output parameter p-ok        as logical          no-undo.
      324   IF VALID-HANDLE(v-disp)
      325   THEN DO
      326   ON ERROR UNDO, RETURN ERROR
      327   :
      328      IF num-entries(p-line-1, chr(4)) >= 2
      329      THEN DO:
      330         assign
      331            p-line-2 = entry(2, p-line-1, chr(4))
      332            p-line-1 = entry(1, p-line-1, chr(4))
      333         .
      334      END.
      335      ASSIGN
      336         p-line-1 = TRIM(p-line-1)
      337         p-line-2 = TRIM(p-line-2)
      338      .
      339      IF LENGTH(p-line-1) <= v-str-len
      340      THEN DO:
      341         ASSIGN
      342            p-line-1 = p-line-1 + FILL(" ", v-str-len - LENGTH(p-line-1) )
      343         .
      344      END.
      345      ELSE DO:
      346         ASSIGN
      347            p-line-1 = SUBSTRING(p-line-1, 1, v-str-len)
      348         .
      349      END.
      350      IF LENGTH(p-line-2) <= v-str-len
      351      THEN DO:
      352         ASSIGN
      353            p-line-2 = p-line-2 + FILL(" ", v-str-len - LENGTH(p-line-2) )
      354         .
      355      END.
      356      ELSE DO:
      357         ASSIGN
      358            p-line-2 = SUBSTRING(p-line-2, 1, v-str-len)
      359         .
      360      END.
      361      ASSIGN
      362         p-out-line = p-line-1 + p-line-2
      363         p-ok = TRUE
      364      .
      365   END.
      366   ELSE DO:
      367      ASSIGN
      368         p-ok = TRUE
      369      .
      370   END.
      371   END PROCEDURE.
      372   PROCEDURE disp-clear :
      373   define output parameter p-message as character        no-undo.
      374   define output parameter p-ok          as logical          no-undo.
      375   IF VALID-HANDLE(v-disp)
      376   THEN DO
      377   ON ERROR UNDO, RETURN ERROR
      378   :
      379      CASE v-disp-type :
      380         WHEN 201 THEN DO:
      381            v-disp:ClearDispl () NO-ERROR.
      382            IF ERROR-STATUS:ERROR
      383            THEN DO:
      384               ASSIGN
      385                  p-message = RETURN-VALUE
      386                  p-ok = FALSE
      387               .
      388               RETURN.
      389            END.
      390            ASSIGN
      391               p-ok = TRUE
      392            .
      393         END.
      394         WHEN 320 THEN DO:
      395            v-disp:ClearText() .
      396            ASSIGN
      397               p-ok = TRUE
      398            .
      399         END.
      400         OTHERWISE DO:
      401         end.
      402      END CASE.
      403   END.
      404   ELSE DO:
      405      ASSIGN
      406         p-ok = TRUE
      407      .
      408   END.
      409   END PROCEDURE.
      410   PROCEDURE disp-beg :
      411   define output parameter p-message as character        no-undo.
      412   define output parameter p-ok      as logical          no-undo.
      413   IF VALID-HANDLE(v-disp)
      414   THEN DO
      415   ON ERROR UNDO, RETURN ERROR
      416   :
      417      CASE v-disp-type :
      418         WHEN 201 THEN DO:
      419            ASSIGN
      420               p-ok = TRUE
      421            .
      422         END.
      423         OTHERWISE DO:
      424         END.
      425      END CASE.
      426   END.
      427   ELSE DO:
      428      ASSIGN
      429         p-ok = TRUE
      430      .
      431   END.
      432   END PROCEDURE.
      433   PROCEDURE disp-terminate :
      434   define output parameter p-message as character        no-undo.
      435   define output parameter p-ok      as logical          no-undo.
      436   IF VALID-HANDLE(v-disp)
      437   THEN DO
      438   ON ERROR UNDO, RETURN ERROR
      439   :
      440      CASE v-disp-type :
      441         WHEN 201 THEN DO:
      442            ASSIGN
      443               p-ok = TRUE
      444            .
      445         END.
      446         WHEN 320 THEN DO:
      447           v-disp:ReleaseDevice() .
      448           v-disp:close() .
      449         END.
      450         OTHERWISE DO:
      451         end.
      452      END CASE.
      453   assign
      454         p-ok = yes .
      455   END.
      456   ELSE DO:
      457      ASSIGN
      458         p-ok = TRUE
      459      .
      460   END.
      461   END PROCEDURE.
      462   PROCEDURE control_load :
      463   DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
      464   DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.
      465   CREATE CONTROL-FRAME CtrlFrame-2 ASSIGN
      466          FRAME           = frame dialog-frame-2:handle
      467          ROW             = 3.38
      468          COLUMN          = 18
      469          HEIGHT          = 4.76
      470          WIDTH           = 20
      471          WIDGET-ID       = 8
      472          HIDDEN          = yes
      473          SENSITIVE       = yes.
      474   OCXFile = SEARCH( "gbl\dp2800_320.wrx":U ).
      475   IF OCXFile = ? THEN
      476     OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
      477                        R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U)
      478                        + "wrx":U).
      479   IF OCXFile <> ? THEN
      480   DO:
      481     ASSIGN
      482       chCtrlFrame-2 = CtrlFrame-2:COM-HANDLE
      483       UIB_S = chCtrlFrame-2:LoadControls( OCXFile, "CtrlFrame-2":U)
      484       CtrlFrame-2:NAME = "CtrlFrame-2":U
      485     .
      486     RUN initialize-controls IN THIS-PROCEDURE NO-ERROR.
      487   END.
      488   ELSE MESSAGE "gbl/dp2800_320.wrx":U SKIP(1)
      489                VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".
      490   END PROCEDURE.
