     1795                  comb:inner-lines = num-entries(vlistValue).
     1796               comb = entry(1,comb:list-items).
     1797               disp comb with frame DIALOG-1.
     1798               enable comb  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1799               assign
     1800                  in-char     :visible = no
     1801                  in-date     :visible = no
     1802                  toggle-date :visible = no
     1803                  in-dec      :visible = no
     1804                  in-int      :visible = no
     1805                  in-log      :visible = no
     1806               .
     1807            end.
     1808            else do:
     1809               frame DIALOG-1:title = "Введите символьное значение".
     1810               disp in-char with frame DIALOG-1.
     1811               enable in-char  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1812               assign
     1813                  comb        :visible = no
     1814                  in-date     :visible = no
     1815                  toggle-date :visible = no
     1816                  in-dec      :visible = no
     1817                  in-int      :visible = no
     1818                  in-log      :visible = no
     1819               .
     1820            end.
     1821         end.
     1822         when "date" then do:
     1823            frame DIALOG-1:title = "Введите дату".
     1824            run cur-time in this-procedure (output in-date, output v-time).
     1825            disp in-date toggle-date with frame DIALOG-1.
     1826            enable in-date toggle-date Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1827            assign
     1828               comb        :visible = no
     1829               in-char     :visible = no
     1830               in-dec      :visible = no
     1831               in-int      :visible = no
     1832               in-log      :visible = no
     1833            .
     1834         end.
     1835         when "decimal" then do:
     1836            frame DIALOG-1:title = "Введите десятичное значение".
     1837            disp in-dec with frame DIALOG-1.
     1838            enable in-dec  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1839            assign
     1840               comb        :visible = no
     1841               in-date     :visible = no
     1842               toggle-date :visible = no
     1843               in-char     :visible = no
     1844               in-int      :visible = no
     1845               in-log      :visible = no
     1846            .
     1847         end.
     1848         when "integer" then do:
     1849          mCashDevice      = new ibs.th.str.cash.CashDevice().
     1850          do v-ii = 1 to mCashDevice:mapType:GetItem(v-ii):
     1851              objType = mCashDevice:CurrProp.
     1852              v-device-kind = v-device-kind + chr(44) + objType:Label_ .
     1853              v-device-integer = v-device-integer + chr(44) + string(objType:KeyIntDB) .
     1854          end.
     1855            if    can-do( "course-type,purch-code,hist-action,receipt-code,wth-receipt-code,cd-device-kind", spr )
     1856               or vlistValue ne ?
     1857            then do:
     1858               frame DIALOG-1:title = "Выберите значение".
     1859               if vlistValue eq ?
     1860               then
     1861                  case spr :
     1862                     when "course-type" then assign vlistValue = "ЦБ,ММВБ" vlistValueRet = "1,2".
     1863                     when "purch-code"  then assign vlistValue = 'выкуп,консигнация,ответственное хранение,старая консигнация':U
     1864                                                    vlistValueRet = '1,2,3,4':U
     1865                                        .
     1866                     when "hist-action"  then
     1867                        assign
     1868                           vlistValue    = 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U
     1869                           vlistValueRet = '99,1,2,3,4,9,51,79':U
     1870                        .
     1871                     when "receipt-code" then assign vlistValue    = 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U
     1872                                                     vlistValueRet = '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U
     1873                                              .
     1874                     when "wth-receipt-code" then assign vlistValue    = 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U
     1875                                                         vlistValueRet = '2,3,4,5,7':U
     1876                                                  .
     1877                     when "cd-device-kind" then do:
     1878                         assign
     1879                         vlistValue = trim(v-device-kind,",")
     1880                         vlistValueRet = trim(v-device-integer,",")
     1881                         .
     1882                     end.
     1883                  end case.
     1884               comb:list-items   = vlistValue.
     1885               if num-entries(vlistValue) > 2
     1886               then
     1887                  comb:inner-lines = num-entries(vlistValue).
     1888               assign comb = entry( 1, comb:list-items ).
     1889               disp comb with frame DIALOG-1.
     1890               enable comb  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1891               assign
     1892                  in-char:visible = no
     1893                  in-date:visible = no
     1894                  toggle-date:visible = no
     1895                  in-dec:visible  = no
     1896                  in-int:visible    = no
     1897                  in-log:visible   = no.
     1898            end.
     1899            else do:
     1900               frame DIALOG-1:title = "Введите целое значение".
     1901               disp in-int with frame DIALOG-1.
     1902               enable in-int  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1903               assign
     1904                  comb        :visible = no
     1905                  in-date     :visible = no
     1906                  toggle-date :visible = no
     1907                  in-dec      :visible = no
     1908                  in-char     :visible = no
     1909                  in-log      :visible = no
     1910               .
     1911            end.
     1912         end.
     1913         when "logical" then do:
     1914            frame DIALOG-1:title = "Выберите логическое значение".
     1915            disp in-log with frame DIALOG-1.
     1916            enable in-log  Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1917            assign
     1918               comb        :visible = no
     1919               in-date     :visible = no
     1920               toggle-date :visible = no
     1921               in-dec      :visible = no
     1922               in-int      :visible = no
     1923               in-char     :visible = no
     1924            .
     1925         end.
     1926      end case.
     1927   end procedure.
