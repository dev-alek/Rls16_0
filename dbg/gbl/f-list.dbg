     1643                     when "tbl-name"            then vlistValue = 'накладная,переоценка,гр-товаров,гр-блюд,гр-клиентов,автопров.,проводки,состав_проводки,группа_проводок,инвойсы,счета,аналитика,баланс,форма,корреспонденция,рецепт,рецепт,производство,продажа,доп-БК,фирма,человек,магазин,склад,ТО,ставки_на_товар,категория_налога,ТРК,пистолет_ТРК,склд.место,д-карта,маг-курс,признак,товар,оплата,кас_тов,ставки_на_товар,ед_изм,суммы,смена,МЦ,номинал_МЦ,место_хран_МЦ,док_перемщ_МЦ,конфигурация,принтер_кухни,группа_тов-принтер_кухни':U.
