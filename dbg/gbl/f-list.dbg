      905   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      906        LABEL "&Отмена":L
      907        SIZE 10 BY 1.17 TOOLTIP "Отменить формирование критерия"
      908        BGCOLOR 8 .
      909   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      910        LABEL "&Сохранить":L
      911        SIZE 10 BY 1.17 TOOLTIP "Сохранить сформированный критерий"
      912        BGCOLOR 8 .
      913   DEFINE VARIABLE comb AS CHARACTER FORMAT "X(256)":U
      914        VIEW-AS COMBO-BOX INNER-LINES 5
      915        LIST-ITEMS " "
      916        SIZE 41 BY 1 NO-UNDO.
      917   DEFINE VARIABLE in-char AS CHARACTER FORMAT "X(256)":U
      918        VIEW-AS FILL-IN
      919        SIZE 25.5 BY 1 NO-UNDO.
      920   DEFINE VARIABLE in-date AS DATE FORMAT "99/99/9999":U
      921        VIEW-AS FILL-IN
      922        SIZE 11.5 BY 1 NO-UNDO.
      923   DEFINE VARIABLE in-dec AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99":U INITIAL 0
      924        VIEW-AS FILL-IN
      925        SIZE 25.5 BY 1 NO-UNDO.
      926   DEFINE VARIABLE in-int AS INTEGER FORMAT "->>,>>>,>>>,>>9":U INITIAL 0
      927        VIEW-AS FILL-IN
      928        SIZE 25.5 BY 1 NO-UNDO.
      929   DEFINE VARIABLE list AS CHARACTER
      930        VIEW-AS SELECTION-LIST SINGLE
      931        SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      932        SIZE 41.5 BY 5.5 NO-UNDO.
      933   DEFINE VARIABLE togl AS LOGICAL INITIAL no
      934        LABEL "Включительно":L
      935        VIEW-AS TOGGLE-BOX
      936        SIZE 15 BY .83 NO-UNDO.
      937   DEFINE VARIABLE in-log AS CHARACTER
      938        VIEW-AS RADIO-SET VERTICAL
      939        RADIO-BUTTONS
      940             "Да (Истино)", "TRUE",
      941   "Нет (Ложь)", "FALSE"
      942        SIZE 14 BY 2.25 NO-UNDO.
      943   DEFINE VARIABLE toggle-date AS LOGICAL INITIAL no
      944        LABEL "СЕГОДНЯ +/- ДНЕЙ"
      945        VIEW-AS TOGGLE-BOX
      946        SIZE 21 BY .83 NO-UNDO.
      947   DEFINE FRAME DIALOG-1
      948        in-int AT ROW 1.5 COL 3 NO-LABEL
      949        in-dec AT ROW 1.5 COL 3 NO-LABEL
      950        in-date AT ROW 1.5 COL 3 NO-LABEL
      951        in-log  AT ROW 1.5    COL  4.5 NO-LABEL
      952        toggle-date  AT ROW 1.5  COL 15
      953        in-char AT ROW 1.5 COL 3 NO-LABEL
      954        comb AT ROW 1.5 COL 1 COLON-ALIGNED NO-LABEL
      955        b-spr AT ROW 1.5 COL 31.5
      956        b-add AT ROW 2.75 COL 3
      957        b-del AT ROW 2.75 COL 13
      958        b-help AT ROW 2.75 COL 25.5
      959        list AT ROW 4.25 COL 3 NO-LABEL
      960        togl AT ROW 9.75 COL 3
      961        Btn_OK AT ROW 10.75 COL 3
      962        Btn_Cancel AT ROW 10.75 COL 34.75
      963        SPACE(2.12) SKIP(0.24)
      964       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      965            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      966            TITLE "":L
      967            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      968   ASSIGN
      969          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      970   ASSIGN
      971          b-spr:HIDDEN IN FRAME DIALOG-1           = TRUE.
      972   ON CHOOSE OF b-add IN FRAME DIALOG-1
      973   DO:
      974   define variable s-private as character no-undo .
      975     case type:
      976        when "character" then do:
      977           if comb:visible
      978           then do:
      979             s = input frame DIALOG-1 comb.
      980             if vlistValueRet ne ?
      981             then do:
      982                k = comb:lookup(s).
      983                s = entry( k, comb:list-items).
      984                s-private = entry( k, vlistValueRet)          .
      985              end.
      986           end.
      987           else s = input frame DIALOG-1 in-char.
      988        end.
      989        when "date" then
      990        assign
      991        s = if (input frame DIALOG-1 in-date = "":U or
      992                input frame DIALOG-1 in-date = ? or
      993                input frame DIALOG-1 in-date = "?")
      994            then chr(63)
      995            else string(input frame DIALOG-1 in-date, "99/99/9999").
      996        when "decimal" then s = string(input frame DIALOG-1 in-dec).
      997        when "integer" then do:
      998           if    comb:visible in frame DIALOG-1
      999           then do:
     1000              assign
     1001                 s         =  input frame DIALOG-1 comb
     1002                 s-private =  entry(lookup(s,vlistValue), vlistValueRet) when vlistValueRet ne ?
     1003             .
     1004           end.
     1005           else do:
     1006              assign
     1007                 s = string(input frame DIALOG-1 in-int)
     1008              .
     1009           end.
     1010        end.
     1011        end case.
     1012        k = lookup( s, list:list-items ).
     1013        if k = 0 or k = ? then do:
     1014           if list:add-last( s )
     1015           then do:
     1016              assign
     1017                 list:private-data = list:private-data + (if list:private-data = "":u then "":U else chr(44)) + s-private.
     1018           end.
     1019        end.
     1020     apply "entry" to btn_cancel in frame DIALOG-1.
     1021   END.
     1022   ON CHOOSE OF b-del IN FRAME DIALOG-1
     1023   DO:
     1024       define variable k as integer no-undo .
     1025     assign list.
     1026     if list:delete( list ) then do:
     1027       if comb:visible then do:
     1028         replace(list:private-data, entry(lookup(comb, comb:list-items), vlistValueRet), "":U) no-error .
     1029         replace(list:private-data, (chr(44) + chr(44)), chr(44)).
     1030       end.
     1031     end.
     1032       def var vValue as character no-undo .
     1033       list:private-data = "" .
     1034       do k = 1 to num-entries(list:list-items):
     1035           vValue = entry(k,list:list-items) .
     1036           list:private-data = list:private-data + chr(44) + entry(lookup(vValue,vListValue,","),vListValueRet,",") .
     1037       end.
     1038       list:private-data = trim(list:private-data,",") .
     1039   END.
     1040   ON CHOOSE OF b-spr IN FRAME DIALOG-1
     1041   DO:
     1042     define variable grp-rec as recid no-undo.
     1043     define variable ref-rec as recid no-undo.
     1044     define variable grps as char no-undo.
     1045     define variable gdss as char no-undo.
     1046     define variable grp_name as char no-undo.
     1047     define variable ref-list as char no-undo.
     1048     define variable out-an as int no-undo.
     1049     define buffer buf_db for ub.db.
     1050     define variable  rid-list as character no-undo .
     1051     case spr:
     1052            when 'pay' then do:
     1053               run ref/paytype.w ( input parparentproc, "b-sel", output  rid-list ).
     1054               find ub.pay-type where recid ( ub.pay-type ) = integer( rid-list) no-lock no-error.
     1055               if available ub.pay-type then do:
     1056                  in-int = ub.pay-type.obj-code.
     1057                  disp in-int with frame DIALOG-1.
     1058                  apply "choose" to b-add.
     1059                  return no-apply.
     1060               end.
     1061            end.
     1062            when 'curr' then do:
     1063               assign
     1064               ref-rec = ?.
     1065               run ref/currency.w (parparentproc, "b-sel", input-output ref-rec ).
     1066               if ref-rec = ? then return no-apply.
     1067               find ub.currency where recid ( ub.currency ) = ref-rec no-lock.
     1068               if available ub.currency then do:
     1069                  in-int = ub.currency.curr-code.
     1070                  disp in-int with frame DIALOG-1.
     1071                  apply "choose" to b-add.
     1072                  return no-apply.
     1073               end.
     1074            end.
     1075            when 'unit' then do:
     1076               run ref/units.w (
     1077                             input parparentproc
     1078                           , input yes
     1079                           , output ref-rec).
     1080               if ref-rec = ? then return no-apply.
     1081               find ub.units where recid ( ub.units ) = ref-rec no-lock.
     1082               if available ub.units then do:
     1083                  in-char = ub.units.unit-name.
     1084                  disp in-char with frame DIALOG-1.
     1085                  apply "choose" to b-add.
     1086                  return no-apply.
     1087               end.
     1088            end.
     1089            when 'country' then do:
     1090               run ref/countris.w (input parparentproc
     1091                              ,input "b-sel"
     1092                              ,input-output rid-list).
     1093               if ref-rec = ? then return no-apply.
     1094               find ub.country where recid ( ub.country ) = integer(rid-list) no-lock.
     1095               if available ub.country then do:
     1096                  in-char = ub.country.alpha1.
     1097                  disp in-char with frame DIALOG-1.
     1098                  apply "choose" to b-add.
     1099                  return no-apply.
     1100               end.
     1101            end.
     1102            when 'prt' then do:
     1103               run ref/gdsprts.w ( parparentproc, yes, output ref-rec).
     1104               find  ub.gds-prt where recid ( ub.gds-prt ) = ref-rec no-lock.
     1105               if available ub.gds-prt then do:
     1106                  in-int = ub.gds-prt.upper-code.
     1107                  disp in-int with frame DIALOG-1.
     1108                  apply "choose" to b-add.
     1109                  return no-apply.
     1110               end.
     1111            end.
     1112            when 'cligrp' then do:
     1113                     ref-list = "".
     1114                     run ref/cli-grps.w (input parparentproc, "b-sel", input-output ref-list).
     1115                     grp-rec = int(ref-list).
     1116                     if grp-rec <> 0 then do:
     1117                        find ub.cli-grp where recid(ub.cli-grp) = grp-rec.
     1118                        run cli-grplib-get-full-name in this-procedure(input ub.cli-grp.node-code, output grp_name).
     1119                        in-char = grp_name.
     1120                        disp in-char with frame DIALOG-1.
     1121                        apply "choose" to b-add.
     1122                        return no-apply.
     1123                     end.
     1124            end.
     1125            when 'gdsgrp' then do:
     1126             ref-list = "".
     1127             run ref/gds-grp.w ( input parparentproc
     1128                                ,input "b-sel"
     1129                                ,input '':U
     1130                                ,input 0
     1131                                ,input-output ref-list).
     1132             grp-rec = int(ref-list).
     1133             if grp-rec <> 0 then do:
     1134                 find ub.gds-grp where recid(ub.gds-grp) = grp-rec.
     1135                 run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output grp_name).
     1136                 in-char = grp_name.
     1137                 disp in-char with frame DIALOG-1.
     1138                 apply "choose" to b-add.
     1139                 return no-apply.
     1140             end.
     1141             else apply "entry" to b-spr.
     1142            end.
     1143            when 'db' then do:
     1144             run adm/dbs.w (
     1145                           input parparentproc
     1146                          ,input 'ПРОСМОТР':U
     1147                          ,output ref-rec).
     1148             if ref-rec <> ? then do:
     1149               find first buf_db no-lock where recid(buf_db) = ref-rec no-error.
     1150               if available buf_db then do:
     1151                 assign
     1152                 in-int = buf_db.db-num
     1153                 .
     1154                 disp in-int with frame DIALOG-1.
     1155                 apply "choose" to b-add in frame DIALOG-1.
     1156                 return no-apply.
     1157               end.
     1158               else apply "entry":U to b-spr in frame DIALOG-1.
     1159             end.
     1160            end.
     1161     end case.
     1162   END.
     1163   ON VALUE-CHANGED OF comb IN FRAME DIALOG-1
     1164   DO:
     1165   apply "choose" to b-add in frame DIALOG-1.
     1166   END.
     1167   ON RETURN OF in-char IN FRAME DIALOG-1
     1168   DO:
     1169   apply "choose" to b-add in frame DIALOG-1.
     1170   END.
     1171   ON RETURN OF in-date IN FRAME DIALOG-1
     1172   DO:
     1173   apply "choose" to b-add in frame DIALOG-1.
     1174   END.
     1175   ON RETURN OF in-dec IN FRAME DIALOG-1
     1176   DO:
     1177   apply "choose" to b-add in frame DIALOG-1.
     1178   END.
     1179   ON RETURN OF in-int IN FRAME DIALOG-1
     1180   DO:
     1181   apply "choose" to b-add in frame DIALOG-1.
     1182   END.
     1183   ON VALUE-CHANGED OF list IN FRAME DIALOG-1
     1184   DO:
     1185     assign list.
     1186     case type:
     1187        when "character" then do:
     1188           if comb:visible
     1189           then do:
     1190              comb = list.
     1191              disp comb with frame DIALOG-1.
     1192           end.
     1193           else do:
     1194              in-char = list.
     1195              disp in-char with frame DIALOG-1.
     1196           end.
     1197        end.
     1198        when "date" then do:
     1199           in-date = date(list).
     1200           disp in-date with frame DIALOG-1.
     1201        end.
     1202        when "decimal" then do:
     1203           in-dec = decimal(list).
     1204           disp in-dec with frame DIALOG-1.
     1205        end.
     1206        when "integer" then do:
     1207           if comb:visible
     1208           then do:
     1209              comb = list.
     1210              disp comb with frame DIALOG-1.
     1211           end.
     1212           else do:
     1213              in-int = integer( list ).
     1214              disp in-int with frame DIALOG-1.
     1215           end.
     1216        end.
     1217     end case.
     1218   END.
     1219   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1220   on F1 of frame DIALOG-1 anywhere do:
     1221     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame DIALOG-1. END.
     1222     return no-apply.
     1223   end.
     1224   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1225   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1226   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1227   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   on help of frame DIALOG-1
     1229   do:
     1230     run gbl/app_help.p
     1231       (input this-procedure :file-name
     1232       ,input ''
     1233       ,input ?
     1234       ) no-error.
     1235     if error-status :error then do:
     1236       message
     1237         "Ошибка при вызове помощи"
     1238         error-status :get-message(1)
     1239         view-as alert-box .
     1240     end.
     1241   end.
     1242   run minbtn-set in this-procedure .
     1243   on choose of b-help in frame DIALOG-1
     1244   do:
     1245     apply "help":u to frame DIALOG-1 .
     1246   end.
     1247   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   procedure minbtn-set :
     1249       do
     1250           on error undo, return error return-value
     1251           :
     1252           define variable ii              as integer       no-undo .
     1253           define variable fh              as widget-handle no-undo .
     1254           define variable hh              as widget-handle no-undo .
     1255           define variable v-h             as handle        extent 4 no-undo .
     1256           define variable v-name-button   as character     no-undo .
     1257           define variable v-help-old-x    as decimal       no-undo .
     1258           define variable v-help-old-y    as decimal       no-undo .
     1259           define variable v-help-old-size as decimal       no-undo .
     1260           define variable v-frame-width   as decimal       no-undo .
     1261           define variable jj              as integer       no-undo .
     1262           do
     1263               on error undo, return error
     1264               :
     1265               assign
     1266                   v-frame-width = frame DIALOG-1:width - 0.3
     1267                   fh            = frame DIALOG-1:first-child
     1268                   hh            = fh:first-child
     1269                   ii            = 1
     1270                   .
     1271               do while valid-handle(hh):
     1272                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1273                   do:
     1274                       case lc(hh:name) :
     1275                           when "b-help" then
     1276                               do:
     1277                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1278                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1279                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1280                                   hh:TOOLTIP = "Помощь" .
     1281                                   v-help-old-x = hh:column .
     1282                                   v-help-old-y = hh:row    .
     1283                                   v-help-old-size = hh:width .
     1284                                   hh:width-chars = 2.5 .
     1285                               end.
     1286                           when "b-print" then
     1287                               do:
     1288                                   hh:load-image("cmp/b-print.bmp":u) .
     1289                                   hh:TOOLTIP = "Печать" .
     1290                                   v-h[ii] = hh:handle .
     1291                                   ii = ii + 1 .
     1292                                   hh:width-chars = 3 .
     1293                               end.
     1294                           when "b-history" or
     1295                           when "b-hist" then
     1296                               do:
     1297                                   hh:load-image("cmp/b-hist.bmp":u) .
     1298                                   hh:TOOLTIP = "История" .
     1299                                   v-h[ii] = hh:handle .
     1300                                   ii = ii + 1 .
     1301                                   hh:width-chars = 3 .
     1302                               end.
     1303                           when "b-sch" then
     1304                               do:
     1305                                   hh:load-image("cmp/b-sch.bmp":u) .
     1306                                   hh:TOOLTIP = "Установка Фильтра" .
     1307                                   v-h[ii] = hh:handle .
     1308                                   ii = ii + 1 .
     1309                                   hh:width-chars = 3 .
     1310                               end.
     1311                           when "b-hist-user" then
     1312                               do:
     1313                                   hh:load-image("cmp/b-hist.bmp":u) .
     1314                                   hh:TOOLTIP = "История пользователя" .
     1315                                   ii = ii + 1 .
     1316                               end.
     1317                       end case.
     1318                   end.
     1319                   hh = hh:next-sibling.
     1320               end.
     1321               b-help:column = v-frame-width - b-help:width-chars.
     1322               jj = 0.
     1323               repeat ii = 4 to 1 by -1 :
     1324                   if valid-handle (v-h[ii] ) then
     1325                   do:
     1326                       jj  = jj + 1 .
     1327                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1328                       v-h[ii]:row    = v-help-old-y .
     1329                   end.
     1330               end.
     1331           end.
     1332       end.
     1333   end procedure.
     1334   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   on ' ' of in-date in frame DIALOG-1
     1336   do:
     1337     if (can-query (self, "sensitive")
     1338        and
     1339        self :sensitive = true
     1340        )
     1341     or (can-query (self, "read-only")
     1342        and
     1343        self :read-only = false
     1344        )
     1345     then do:
     1346       assign
     1347         self :screen-value = ?
     1348       .
     1349     end.
     1350     return no-apply.
     1351   end.
     1352   on delete-character of in-date in frame DIALOG-1
     1353   do:
     1354     if (can-query (self, "sensitive")
     1355        and
     1356        self :sensitive = true
     1357        )
     1358     or (can-query (self, "read-only")
     1359        and
     1360        self :read-only = false
     1361        )
     1362     then do:
     1363       assign
     1364         self :screen-value = ?
     1365       .
     1366     end.
     1367     return no-apply.
     1368   end.
     1369   on ctrl-d of in-date in frame DIALOG-1
     1370   do:
     1371     define variable v-curr-sv-date as date no-undo .
     1372     if (can-query (self, "sensitive")
     1373        and
     1374        self :sensitive = true
     1375        )
     1376     or (can-query (self, "read-only")
     1377        and
     1378        self :read-only = false
     1379        )
     1380     then do:
     1381       if self :handle <> focus :handle
     1382       then do:
     1383         apply "entry":u to self .
     1384       end.
     1385       run gbl/getcurdt.p
     1386         (output v-curr-sv-date
     1387         ) .
     1388       assign
     1389         self :screen-value = string(v-curr-sv-date) .
     1390       .
     1391     end.
     1392     return no-apply.
     1393   end.
     1394   on ctrl-b of in-date in frame DIALOG-1
     1395   do:
     1396     if (can-query (self, "sensitive")
     1397        and
     1398        self :sensitive = true
     1399        )
     1400     or (can-query (self, "read-only")
     1401        and
     1402        self :read-only = false
     1403        )
     1404     then do:
     1405       if self :handle <> focus :handle
     1406       then do:
     1407         apply "entry":u to self .
     1408       end.
     1409       define variable v-curr-sv-date as date no-undo .
     1410       define variable v-new-sv-date  as date no-undo .
     1411       assign
     1412         v-curr-sv-date = date(self :screen-value) no-error
     1413       .
     1414       if v-curr-sv-date = ?
     1415       then do:
     1416         run gbl/getcurdt.p
     1417           (output v-curr-sv-date
     1418           ) .
     1419       end.
     1420       if v-curr-sv-date <> ?
     1421       then do:
     1422         assign
     1423           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1424         .
     1425         assign
     1426           self :screen-value = string(v-new-sv-date) .
     1427         .
     1428       end.
     1429     end.
     1430     return no-apply .
     1431   end.
     1432   on ctrl-e of in-date in frame DIALOG-1
     1433   do:
     1434     if (can-query (self, "sensitive")
     1435        and
     1436        self :sensitive = true
     1437        )
     1438     or (can-query (self, "read-only")
     1439        and
     1440        self :read-only = false
     1441        )
     1442     then do:
     1443       if self :handle <> focus :handle
     1444       then do:
     1445         apply "entry":u to self .
     1446       end.
     1447       define variable v-curr-sv-date as date no-undo .
     1448       define variable v-new-sv-date  as date no-undo .
     1449       assign
     1450         v-curr-sv-date = date(self :screen-value) no-error
     1451       .
     1452       if v-curr-sv-date = ?
     1453       then do:
     1454         run gbl/getcurdt.p
     1455           (output v-curr-sv-date
     1456           ) .
     1457       end.
     1458       if v-curr-sv-date <> ?
     1459       then do:
     1460         run gbl/lastdate.p
     1461           (input  v-curr-sv-date
     1462           ,output v-new-sv-date
     1463           ).
     1464         assign
     1465           self :screen-value = string(v-new-sv-date) .
     1466         .
     1467       end.
     1468     end.
     1469     return no-apply .
     1470   end.
     1471   on ctrl-f of in-date in frame DIALOG-1
     1472   do:
     1473     if (can-query (self, "sensitive")
     1474        and
     1475        self :sensitive = true
     1476        )
     1477     or (can-query (self, "read-only")
     1478        and
     1479        self :read-only = false
     1480        )
     1481     then do:
     1482       if self :handle <> focus :handle
     1483       then do:
     1484         apply "entry":u to self .
     1485       end.
     1486       define variable v-ok            as logical   no-undo .
     1487       define variable v-curr-sv-date  as date      no-undo .
     1488       define variable v-description   as character no-undo .
     1489       assign
     1490         v-curr-sv-date = date(self :screen-value) no-error
     1491       .
     1492       if v-curr-sv-date = ?
     1493       then do:
     1494         run gbl/getcurdt.p
     1495           (output v-curr-sv-date
     1496           ) .
     1497       end.
     1498       if v-curr-sv-date <> ?
     1499       then do:
     1500         run gbl/d-inpday.w
     1501           (input ?
     1502           ,input "Выбор даты"
     1503           ,input v-description
     1504           ,input ""
     1505           ,input-output v-curr-sv-date
     1506           ,output v-ok
     1507           ).
     1508         if v-ok = true
     1509         then do:
     1510           assign
     1511             self :screen-value = string(v-curr-sv-date) .
     1512           .
     1513         end.
     1514       end.
     1515     end.
     1516     return no-apply .
     1517   end.
     1518     define MENU m-ed-date9
     1519       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1520       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1521       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1522       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1523       .
     1524     if in-date :POPUP-MENU in frame DIALOG-1 = ?
     1525     then do:
     1526       ASSIGN
     1527         in-date :POPUP-MENU in frame DIALOG-1 = MENU m-ed-date9 :HANDLE
     1528         in-date :MENU-MOUSE in frame DIALOG-1 = 3
     1529       .
     1530     end.
     1531     define variable v-label-handle9 as handle no-undo .
     1532     assign
     1533       v-label-handle9 = in-date :side-label-handle in frame DIALOG-1
     1534     .
     1535     if valid-handle (v-label-handle9)
     1536     then do:
     1537       if v-label-handle9 :tooltip = ""
     1538       or v-label-handle9 :tooltip = ?
     1539       then do:
     1540         assign
     1541           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1542         .
     1543       end.
     1544     end.
     1545     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1546       apply "ctrl-b":U to in-date in frame DIALOG-1 .
     1547     END.
     1548     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1549       apply "ctrl-d":U to in-date in frame DIALOG-1 .
     1550     END.
     1551     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1552       apply "ctrl-e":U to in-date in frame DIALOG-1 .
     1553     END.
     1554     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1555       apply "ctrl-f":U to in-date in frame DIALOG-1 .
     1556     END.
     1557   MAIN-BLOCK:
     1558   DO ON ERROR    UNDO MAIN-BLOCK, return error
     1559         ON STOP       UNDO MAIN-BLOCK, return error
     1560         ON END-KEY UNDO MAIN-BLOCK, return error :
     1561     if can-do( "cligrp,gdsgrp,pay,curr,unit,prt,country,db", spr ) then
     1562        assign
     1563          b-spr:sensitive = yes
     1564          b-spr:visible     = yes
     1565          togl                   = yes.
     1566     RUN UI_on.
     1567     WAIT-FOR GO OF FRAME DIALOG-1.
     1568     assign list.
     1569     if list:num-items = 0 then return error.
     1570     assign incl = input frame DIALOG-1 togl.
     1571     assign
     1572     sel_list_rus = list:list-items
     1573     sel_list     = (if vlistValueRet ne ? then list:private-data else list:list-items)
     1574     .
     1575   END.
     1576   RUN disable_UI.
     1577   PROCEDURE disable_UI :
     1578     HIDE FRAME DIALOG-1.
     1579   END PROCEDURE.
     1580   PROCEDURE enable_UI :
     1581     DISPLAY in-int in-dec in-date in-char comb list togl
     1582         WITH FRAME DIALOG-1.
     1583     ENABLE in-int in-dec in-date in-char comb b-add b-del list togl Btn_OK
     1584            Btn_Cancel b-help
     1585         WITH FRAME DIALOG-1.
     1586   END PROCEDURE.
     1587   PROCEDURE UI_on :
     1588   assign
     1589   list:private-data in frame DIALOG-1 = "".
     1590     disp togl with frame DIALOG-1.
     1591     enable b-add b-del list togl Btn_OK Btn_Cancel b-help with frame DIALOG-1.
     1592   run InitForm.
     1593   toggle-date:visible = false.
     1594   END PROCEDURE.
     1595   procedure InitForm :
     1596      define variable v-time as integer no-undo .
     1597      define variable dca as integer no-undo .
     1598      define variable v-label as character no-undo .
     1599      define variable v-tooltip as character no-undo .
     1600      define variable ii as integer no-undo .
     1601      define variable v-device-kind as character no-undo .
     1602      define variable v-device-integer as character no-undo .
     1603      DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     1604      define variable objType    as ibs.th.gbl.propmap no-undo.
     1605      define variable mCashDevice      as ibs.th.str.cash.CashDevice no-undo.
     1606      assign
     1607         vlistValue    = ""
     1608         vlistValueRet = ""
     1609      .
     1610      publish "getComboList" (spr,output vlistValue, output vlistValueRet).
     1611      if vlistValue eq ""
     1612      then
     1613         vlistValue = ?.
     1614      if vlistValueRet eq ""
     1615      then
     1616         vlistValueRet = ?.
     1617      case type:
     1618         when "character" then do:
     1619            if can-do( "trn-stat,trn-type,order-status-all,order-type-all,ext-doc-type,pr-stat,fbr-stat,gds-type,form-type,actions," +
     1620                        "tbl-name,purch-code,fin-doc-stat,fin-doc-type,fin-ext-doc-type," +
     1621                        "gds-hist-subject,cli-hist-subject,dc-hist-subject,dc-type-hist-subject,tax-hist-subject,hist-source-type,scl-hist-subject," +
     1622                        "contract-type,usl-opl,db-rec-attr-type,db-rec-attr-cmd,nws-coll_codes," +
     1623                        "gds-grp-hist-subject,cli-grp-hist-subject,fbr-gds-grp-hist-subject,plc-hist-subject,pmp-hist-subject,nzl-hist-subject," +
     1624                        "sht-hist-subject,sert-hist-subject," +
     1625                        "cd-types,cd-types-real,cd-types-discnt,rcv-type-all,wth-ext-type", spr )
     1626               or vlistValue ne ?
     1627            then do:
     1628               frame DIALOG-1:title = "Выберите значение".
     1629               if vlistValue eq ?
     1630               then
     1631                  case spr:
     1632                     when "trn-stat"            then vlistValue = 'запрос,накл,разрешен,факт,касс,прво,готов,отказ':U.
     1633                     when "order-status-all"    then vlistValue = 'новый,факт,согласование,отказ,поставка,закрыто,распределение,запрос,разрешено,отгружено'.
     1634                     when "order-type-all"      then vlistValue = 'ОФ,ФП,ОП,ОО,ОР,ПО'.
     1635                     when "trn-type"            then vlistValue = 'при,рас,спи,возврат,инв':U.
