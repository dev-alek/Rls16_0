     1637                     when "fin-doc-stat"        then vlistValue = 'новый,разрешен,банк,факт,отказ':U.
     1638                     when "fin-doc-type"        then vlistValue = 'пко,рко,ппп,рпп,апп,апр':U.
     1639                     when "pr-stat"             then vlistValue = ',приказ,разрешен,акт':U.
     1640                     when "fbr-stat"            then vlistValue = ',разрешен,факт':U.
     1641                     when "gds-type"            then vlistValue = 'т,у':U.
