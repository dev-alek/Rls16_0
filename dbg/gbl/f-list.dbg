        1   define input  parameter parparentproc as widget-handle no-undo .
        2   define input  parameter spr          as character no-undo .
        3   define input  parameter type         as character no-undo .
        4   define output parameter sel_list     as character no-undo .
        5   define output parameter sel_list_rus as character no-undo .
        6   define output parameter incl         as logical   no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Редактирование фильтров - списки".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2':u,spr,type)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define variable flt-rec as recid no-undo.
      132   define variable g#report-num as integer no-undo .
      133   run get-report-num  in parparentproc ( output g#report-num ).
      134   define variable vss-include-info1 as character format "X(65)" no-undo
      135   initial "@(#)$Workfile$ $Revision$".
      136   procedure grplib-get-full-name :
      137      define input parameter p-node-code  as integer      no-undo.
      138      define output parameter p-full-name as character    no-undo.
      139      do
      140   on error undo, return error
      141   :
      142       define variable v-upper-code    as integer           no-undo.
      143       define buffer buf_gds-grp       for ub.gds-grp.
      144       define buffer buf_upper_gds-grp for ub.gds-grp.
      145       find first buf_gds-grp no-lock
      146            where buf_gds-grp.node-code = p-node-code
      147       no-error.
      148       if not available buf_gds-grp
      149       then do:
      150           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      151       end.
      152       assign
      153           p-full-name  = ""
      154           v-upper-code = 1
      155       .
      156       do while buf_gds-grp.upper-code <> 0
      157       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      158       :
      159           assign
      160               p-full-name  = buf_gds-grp.node-name
      161                            + (if p-full-name <> "" then chr(47) else "")
      162                            + p-full-name
      163               v-upper-code = buf_gds-grp.upper-code
      164           .
      165           find first buf_gds-grp no-lock
      166                where buf_gds-grp.node-code = v-upper-code
      167           no-error.
      168           if not available buf_gds-grp
      169           then do:
      170               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      171                                   + string( v-upper-code )
      172                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      173           end.
      174       end.
      175       assign
      176       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      177       .
      178   end.
      179   end .
      180   procedure grplib-get-node-from-full-name :
      181   define input parameter p-full-name as character no-undo .
      182   define output parameter p-node-code as integer no-undo .
      183   define variable v-ii as integer no-undo .
      184   define variable v-upper-code as integer no-undo .
      185   define variable v-root-code as integer no-undo .
      186   define variable v-entry as character no-undo .
      187   define buffer buf_gds-grp       for ub.gds-grp.
      188   do
      189   on error undo, return error
      190   :
      191     find first buf_gds-grp no-lock
      192         where buf_gds-grp.upper-code = 0
      193     no-error .
      194     if not available buf_gds-grp
      195     then do:
      196         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      197     end.
      198     else do:
      199       assign
      200       v-root-code = buf_gds-grp.node-code
      201       .
      202     end.
      203     v-upper-code = v-root-code.
      204     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      205       assign
      206       v-entry = entry(v-ii, p-full-name, chr(47)).
      207       if v-entry = '' then leave.
      208       find first buf_gds-grp no-lock where
      209                 buf_gds-grp.node-name = v-entry
      210             and buf_gds-grp.upper-code = v-upper-code
      211             no-error.
      212       if not available buf_gds-grp then do:
      213         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      214       end.
      215       else do:
      216         p-node-code = buf_gds-grp.node-code.
      217         v-upper-code = buf_gds-grp.node-code.
      218       end.
      219     end.
      220   end.
      221   end .
      222   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      223   procedure cli-grplib-get-full-name :
      224      define input parameter  p-node-code  as integer      no-undo.
      225      define output parameter p-full-name as character    no-undo.
      226   do
      227   on error undo, return error
      228   :
      229       define variable v-upper-code    as integer           no-undo.
      230       define buffer buf_cli-grp       for ub.cli-grp.
      231       define buffer buf_upper_cli-grp for ub.cli-grp.
      232       find first buf_cli-grp no-lock
      233            where buf_cli-grp.node-code = p-node-code
      234       no-error.
      235       if not available buf_cli-grp
      236       then do:
      237           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      238       end.
      239       assign
      240           p-full-name  = ""
      241           v-upper-code = 1
      242       .
      243       do while buf_cli-grp.upper-code <> 0
      244       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      245       :
      246           assign
      247               p-full-name  = buf_cli-grp.node-name
      248                            + (if p-full-name <> "" then chr(47) else "")
      249                            + p-full-name
      250               v-upper-code = buf_cli-grp.upper-code
      251           .
      252           find first buf_cli-grp no-lock
      253                where buf_cli-grp.node-code = v-upper-code
      254           no-error.
      255           if not available buf_cli-grp
      256           then do:
      257               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      258                                   + string( v-upper-code )
      259                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      260           end.
      261       end.
      262       assign
      263       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      264       .
      265   end.
      266   end .
      267   procedure cgrplib-get-node-from-full-name :
      268   define input parameter p-full-name as character no-undo .
      269   define output parameter p-node-code as integer no-undo .
      270   define variable v-ii as integer no-undo .
      271   define variable v-upper-code as integer no-undo .
      272   define variable v-root-code as integer no-undo .
      273   define variable v-entry as character no-undo .
      274   define buffer buf_cli-grp       for ub.cli-grp.
      275   do
      276   on error undo, return error
      277   :
      278     find first buf_cli-grp no-lock
      279         where buf_cli-grp.upper-code = 0
      280     no-error .
      281     if not available buf_cli-grp
      282     then do:
      283         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      284     end.
      285     else do:
      286       assign
      287       v-root-code = buf_cli-grp.node-code
      288       .
      289     end.
      290     v-upper-code = v-root-code.
      291     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      292       assign
      293       v-entry = entry(v-ii, p-full-name, chr(47)).
      294       if v-entry = '' then leave.
      295       find first buf_cli-grp no-lock where
      296                 buf_cli-grp.node-name = v-entry
      297             and buf_cli-grp.upper-code = v-upper-code
      298             no-error.
      299       if not available buf_cli-grp then do:
      300         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      301       end.
      302       else do:
      303         p-node-code = buf_cli-grp.node-code.
      304         v-upper-code = buf_cli-grp.node-code.
      305       end.
      306     end.
      307   end.
      308   end .
      309   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure progs-name :
      311     define input  parameter p-action-code         as character no-undo .
      312     define output parameter p-main-prog-name      as character no-undo .
      313     define output parameter p-list-db-proc-name   as character no-undo .
      314     define output parameter p-commit-proc-name    as character no-undo .
      315     define output parameter p-execution-proc-name as character no-undo .
      316     define output parameter p-recover-proc-name   as character no-undo .
      317     define output parameter p-after-proc-name     as character no-undo .
      318     do
      319     on error undo, return error
      320     :
      321       case p-action-code :
      322               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      323               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      324               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      325               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      326               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      327               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      328               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      329               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      330               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      331               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      332               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      333               otherwise do:
      334           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      335         end.
      336       end case.
      337     end.
      338     return.
      339   end procedure.
      340   procedure progs-title :
      341     define input  parameter p-action-code         as character no-undo .
      342     define output parameter p-action-title      as character no-undo .
      343     do
      344     on error undo, return error
      345     :
      346       case p-action-code :
      347               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      348               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      349               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      350               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      351               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      352               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      353               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      354               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      355               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      356               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      357               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      358               otherwise do:
      359           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      360         end.
      361       end case.
      362     end.
      363     return.
      364   end procedure.
      365   FUNCTION progs-title-function returns character(
      366      input  p-action-code         as character):
      367   define variable p-action-title      as character no-undo .
      368     do
      369     on error undo, return error
      370     :
      371       case p-action-code :
      372               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      373               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      374               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      375               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      376               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      377               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      378               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      379               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      380               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      381               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      382               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      383               otherwise do:
      384           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info3, p-action-code ).
      385         end.
      386       end case.
      387     end.
      388     return p-action-title.
      389   end FUNCTION.
      390   procedure get-row-keyr-string :
      391    define input  parameter p-key-rec  as character no-undo.
      392    define output parameter p-tbl-title as character no-undo.
      393    define output parameter p-rec-string  as character no-undo.
      394     do
      395     on error undo, return error
      396     :
      397       define variable v-full-tbl-name as character no-undo .
      398       define variable bh_tbl-name     as handle    no-undo .
      399       define variable fh              as handle    no-undo .
      400       define variable v-ok            as logical   no-undo .
      401       define variable v-field-num     as integer   no-undo .
      402       define variable v-count-fld     as integer   no-undo .
      403       define variable v-tbl-name as character no-undo.
      404       if p-key-rec = ?
      405         or p-key-rec = "":U
      406       then do:
      407         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      408       end.
      409       assign
      410         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      411         v-full-tbl-name = "ub.":U + v-tbl-name
      412         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      413         p-rec-string         = "":U
      414         v-count-fld     = 0
      415       .
      416       find ub._file
      417         where ub._file._file-name = v-tbl-name
      418         no-error.
      419       if not available ub._file then do:
      420         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info3, v-tbl-name ).
      421       end.
      422       assign
      423       p-tbl-title = ub._file._file-label
      424       .
      425       find ub._index
      426         where recid( ub._index  ) = ub._file._prime-index
      427         no-error.
      428       if not available ub._index
      429         or LC( ub._index._index-name ) = "default":U
      430       then do:
      431         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      432       end.
      433       block_where :
      434       for each ub._index-field of ub._index  ,
      435           each ub._field of _index-field
      436           break by _index-seq
      437       on error undo, return error
      438       :
      439         assign
      440           v-count-fld = v-count-fld + 1
      441         .
      442         if v-count-fld > v-field-num then do:
      443           leave block_where.
      444         end.
      445         if p-rec-string = "":U then do:
      446           assign
      447             p-rec-string = "":U
      448           .
      449         end.
      450         else do:
      451           assign
      452             p-rec-string = p-rec-string + chr(32) + chr(44)
      453           .
      454         end.
      455         assign
      456           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      457         .
      458       end.
      459       if v-count-fld <> v-field-num then do:
      460         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      461       end.
      462     end.
      463     return.
      464   end procedure.
      465   FUNCTION uniq-key-rec-string-f returns character(
      466      input  p-uniq-key-rec         as character):
      467   define variable v-tbl-title as character no-undo .
      468   define variable v-rec-string as character no-undo .
      469     do
      470     on error undo, return error
      471     :
      472       run get-row-keyr-string in this-procedure (
      473                                                 input p-uniq-key-rec
      474                                                 ,output v-tbl-title
      475                                                 ,output v-rec-string).
      476       assign
      477       v-rec-string = (if v-tbl-title <> ? and
      478                       v-tbl-title <> "":U
      479                       then (v-tbl-title + ":")
      480                      else "":U) + chr(32) + v-rec-string
      481       .
      482     end.
      483     return v-rec-string.
      484   end FUNCTION.
      485   procedure create_db-rec_route :
      486     define input parameter p1-uniq-key-rec as character no-undo .
      487     define input parameter p1-action       as character no-undo .
      488     define input parameter p1-operation    as character no-undo .
      489     define input parameter p1-send-db-list as character no-undo .
      490     define input parameter p1-db-init      as integer   no-undo .
      491     define input parameter p1-parameters   as character no-undo .
      492     define input parameter p1-answer-code  as integer   no-undo .
      493     define input parameter p1-answer-msg   as character no-undo .
      494     do
      495     on error undo, return error
      496     :
      497       define variable v-command     as character no-undo .
      498       define variable v-ind         as integer   no-undo .
      499       define variable v-num-entries as integer   no-undo .
      500       define variable v-curr-db     as integer   no-undo .
      501       define variable v-db-for-send as character no-undo .
      502       define variable v-db-num      as integer   no-undo .
      503       define variable v-db-num-char as character no-undo .
      504       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      505       find first buf_sys-ctrl no-lock .
      506       assign
      507         v-curr-db     = buf_sys-ctrl.db-num
      508         v-db-for-send = "":U
      509       .
      510       if v-curr-db = 0 then do:
      511         if p1-answer-code >= 0 then do:
      512           if v-curr-db <> p1-db-init then do:
      513             assign
      514               v-db-for-send = string( p1-db-init )
      515             .
      516           end.
      517         end.
      518         else do:
      519           assign
      520             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      521           .
      522           do v-ind = 1 to v-num-entries:
      523             assign
      524               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      525               v-db-num      = integer( v-db-num-char )
      526             .
      527             if v-db-num <> v-curr-db
      528               and v-db-num <> p1-db-init
      529             then do:
      530               if v-db-for-send = "":U then do:
      531                 assign
      532                   v-db-for-send = v-db-num-char
      533                 .
      534               end.
      535               else do:
      536                 assign
      537                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      538                 .
      539               end.
      540             end.
      541           end.
      542         end.
      543       end.
      544       else do:
      545         assign
      546           v-db-for-send = "0":U
      547         .
      548       end.
      549       if v-db-for-send <> "":U then do:
      550         assign
      551           v-command = "command":U + chr(1)
      552                       + "two-commit":U + chr(1)
      553                       + p1-action + chr(1)
      554                       + p1-operation + chr(1)
      555                       + p1-uniq-key-rec + chr(1)
      556                       + string( p1-db-init ) + chr(1)
      557                       + p1-parameters + chr(1)
      558                       + string( p1-answer-code ) + chr(1)
      559                       + p1-answer-msg
      560         .
      561         run nws/cr-route.p ( input 'send-cmd':U
      562                       ,input v-command
      563                       ,input ?
      564                       ,input v-db-for-send
      565                       ) no-error .
      566         if error-status :error then do:
      567           return error return-value.
      568         end.
      569       end.
      570     end.
      571     return.
      572   end procedure.
      573   procedure create_msg_route :
      574     define input parameter p2-send-db-list as character no-undo .
      575     define input parameter p2-msg          as character no-undo .
      576     do
      577     on error undo, return error
      578     :
      579       define variable v-msg-command as character no-undo .
      580       define variable v-ind         as integer   no-undo .
      581       define variable v-num-entries as integer   no-undo .
      582       define variable v-curr-db     as integer   no-undo .
      583       define variable v-db-for-send as character no-undo .
      584       define variable v-db-num      as integer   no-undo .
      585       define variable v-db-num-char as character no-undo .
      586       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      587       find first buf_sys-ctrl no-lock .
      588       assign
      589         v-curr-db     = buf_sys-ctrl.db-num
      590         v-db-for-send = "":U
      591       .
      592       if v-curr-db = 0 then do:
      593         assign
      594           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      595         .
      596         do v-ind = 1 to v-num-entries:
      597           assign
      598             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      599             v-db-num      = integer( v-db-num-char )
      600           .
      601           if v-db-num <> v-curr-db then do:
      602             if v-db-for-send = "":U then do:
      603               assign
      604                 v-db-for-send = v-db-num-char
      605               .
      606             end.
      607             else do:
      608               assign
      609                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      610               .
      611             end.
      612           end.
      613         end.
      614       end.
      615       else do:
      616         assign
      617           v-db-for-send = "0":U
      618         .
      619       end.
      620       if v-db-for-send <> "":U then do:
      621         assign
      622           v-msg-command = "command":U + chr(1)
      623                           + "message-to-log":U + chr(1)
      624                           + p2-msg
      625         .
      626         run nws/cr-route.p ( input 'send-cmd':U
      627                       ,input v-msg-command
      628                       ,input ?
      629                       ,input v-db-for-send
      630                       ) no-error .
      631         if error-status :error then do:
      632           return error substitute( "&1&2&3"
      633                                     , return-value
      634                                     , chr(10)
      635                                     , error-status :get-message(1)
      636                                   ).
      637         end.
      638       end.
      639     end.
      640     return.
      641   end procedure.
      642   function get-send-db-list returns character
      643     ( input p-curr-db     as integer
      644      ,input p-all-db-list as character
      645     )
      646   :
      647     define variable v-send-db-list as character no-undo .
      648     if p-curr-db = 0 then do:
      649       assign
      650         v-send-db-list = p-all-db-list
      651       .
      652     end.
      653     else do:
      654       assign
      655         v-send-db-list = string(p-curr-db)
      656       .
      657     end.
      658     return v-send-db-list .
      659   end function .
      660   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   procedure cur-time :
      662      define output parameter p-today as date      no-undo .
      663      define output parameter p-time  as integer   no-undo .
      664     do
      665     on error undo, return error
      666     :
      667       define variable v-date1 as date      no-undo .
      668       define variable v-date2 as date      no-undo .
      669       define variable v-time  as integer   no-undo .
      670       assign
      671         v-date1 = today
      672         v-time  = time
      673         v-date2 = today
      674       .
      675       if v-date1 <> v-date2
      676       then do:
      677         assign
      678           v-date1 = today
      679           v-time  = v-time
      680         .
      681       end.
      682       assign
      683         p-today = v-date1
      684         p-time  = v-time
      685       .
      686     end.
      687   end.
      688   function cur-time-date returns character
      689   :
      690     return string(today, '99/99/9999':U) .
      691   end.
      692   function cur-time-mjd returns decimal
      693   :
      694     define variable v-date as date      no-undo .
      695     define variable v-time as integer   no-undo .
      696     run cur-time in this-procedure
      697       (output v-date
      698       ,output v-time
      699       ) .
      700     return integer(v-date) - 2400002 + (v-time / 86400) .
      701   end.
      702   function cur-time-get-ending-index returns integer
      703   (input p-number as integer
      704   )
      705   :
      706     if p-number < 0
      707     or p-number = ?
      708     then do:
      709       return 1 .
      710     end.
      711     define variable v-rest as integer   no-undo .
      712     assign
      713       p-number = p-number modulo 100
      714     .
      715     if p-number < 20
      716     then do:
      717       assign
      718         v-rest = p-number
      719       .
      720     end.
      721     else do:
      722       assign
      723         v-rest = p-number modulo 10
      724       .
      725     end.
      726     case v-rest :
      727       when 1
      728       then do:
      729         return 2 .
      730       end.
      731       when 2 or
      732       when 3 or
      733       when 4
      734       then do:
      735         return 3 .
      736       end.
      737       otherwise do:
      738         return 1 .
      739       end.
      740     end case .
      741   end.
      742   procedure cur-time-mjd-to-date :
      743      define input  parameter i-mjd-diff as decimal no-undo.
      744      define output parameter o-Date     as date    no-undo.
      745      define output parameter o-Time     as integer no-undo.
      746      define variable v-day-number as integer   no-undo .
      747      if    i-mjd-diff < 0
      748         or i-mjd-diff = ?
      749      then do:
      750         return "?" .
      751      end.
      752      assign
      753         v-day-number = truncate(i-mjd-diff,0).
      754         o-Date = date(v-day-number + 2400002).
      755         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      756     .
      757   end.
      758   function cur-time-mjd-to-string returns character
      759   (input p-mjd-diff as decimal
      760   )
      761   :
      762     define variable v-day-number as integer   no-undo .
      763     define variable v-seconds    as integer   no-undo .
      764     define variable v-hour       as integer   no-undo .
      765     define variable v-min        as integer   no-undo .
      766     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      767     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      768     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      769     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      770     if p-mjd-diff < 0
      771     or p-mjd-diff = ?
      772     then do:
      773       return "?" .
      774     end.
      775     assign
      776       v-day-number = integer(truncate(p-mjd-diff,0))
      777       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      778     .
      779     if v-seconds > 86400
      780     then do:
      781       assign
      782         v-seconds = 86400 - 1
      783       .
      784     end.
      785     if v-seconds < 0
      786     then do:
      787       assign
      788         v-seconds = 0
      789       .
      790     end.
      791     assign
      792       v-hour = truncate(v-seconds / 3600, 0)
      793     .
      794     assign
      795       v-seconds = v-seconds modulo 3600
      796     .
      797     assign
      798       v-min = truncate(v-seconds / 60, 0)
      799     .
      800     assign
      801       v-seconds = v-seconds modulo 60
      802     .
      803     return
      804         (if v-day-number <> 0
      805           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      806           else ""
      807         )
      808       + (if v-day-number <> 0 or v-hour <> 0
      809           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      810           else ""
      811         )
      812       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      813           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      814           else ""
      815         )
      816       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      817       .
      818   end.
      819   function cur-time-string returns character
      820   :
      821     define variable v-date as date      no-undo .
      822     define variable v-time as integer   no-undo .
      823     run cur-time in this-procedure
      824       (output v-date
      825       ,output v-time
      826       ) .
      827     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      828   end.
      829   function cur-time-string-sec returns character
      830   :
      831     define variable v-date as date      no-undo .
      832     define variable v-time as integer   no-undo .
      833     run cur-time in this-procedure
      834       (output v-date
      835       ,output v-time
      836       ) .
      837     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      838   end.
      839   function cur-time-custom  returns character
      840   (input p-prefix as character
      841   ,input p-date-format as character
      842   ,input p-delimiter as character
      843   ,input p-time-format as character
      844   ,input p-suffix as character
      845   )
      846   :
      847     define variable v-date as date      no-undo .
      848     define variable v-time as integer   no-undo .
      849     run cur-time in this-procedure
      850       (output v-date
      851       ,output v-time
      852       ) .
      853     return
      854       p-prefix
      855       + string(v-date, p-date-format)
      856       + p-delimiter
      857       + string(v-time, p-time-format)
      858       + p-suffix
      859       .
      860   end.
      861   function cur-time-print  returns character
      862   :
      863     define variable v-date as date      no-undo .
      864     define variable v-time as integer   no-undo .
      865     run cur-time in this-procedure
      866       (output v-date
      867       ,output v-time
      868       ) .
      869     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      870   end.
      871   function cur-time-datetime returns datetime
      872   :
      873     define variable v-char as character no-undo .
      874     define variable v-datetime as datetime no-undo .
      875     v-char = cur-time-string().
      876     v-datetime = datetime(v-char).
      877     return  v-datetime.
      878   end.
      879   function cur-time-string-msec returns character
      880   :
      881     define variable v-date as datetime  no-undo .
      882     v-date = now.
      883     return string(v-date) .
      884   end.
      885   define variable k as int no-undo.
      886   define variable s as char no-undo.
      887   define variable v_type     as char no-undo.
      888   define variable vlistValue    as character no-undo.
      889   define variable vlistValueRet as character no-undo.
      890   DEFINE BUTTON b-add
      891        LABEL "&Добавить":L
      892        SIZE 8.75 BY 1.17 TOOLTIP "Ввести в список значение".
      893   DEFINE BUTTON b-del
      894        LABEL "&Удалить":L
      895        SIZE 8.75 BY 1.17 TOOLTIP "Удалить ранее включенное в список значение".
      896   DEFINE BUTTON b-help
      897        LABEL "Помо&щь"
      898        SIZE 8.75 BY 1.17 TOOLTIP "Интерактивная помощь в формате *.html".
      899   DEFINE BUTTON b-spr
      900        IMAGE-UP FILE "btn-left-arrow":U
      901        IMAGE-DOWN FILE "btn-left-arrow":U
      902        IMAGE-INSENSITIVE FILE "btn-left-arrow":U
      903        LABEL "":L
