        1   define input  parameter p-msg          as character no-undo .
        2   define input  parameter p-default-answ as logical   no-undo .
        3   define input  parameter p-timeout      as integer   no-undo .
        4   define output parameter p-answer       as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Вопрос с автоответом через промежуток времени".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable log-exit as logical   no-undo .
      115   DEFINE BUTTON b-no AUTO-END-KEY DEFAULT
      116        LABEL "&Нет"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON b-yes AUTO-GO DEFAULT
      120        LABEL "&Да"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE VARIABLE f-msg AS CHARACTER FORMAT "X(256)":U
      124         VIEW-AS TEXT
      125        SIZE 39 BY .67 NO-UNDO.
      126   DEFINE VARIABLE f-wait AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      127        LABEL "Ожидание ответа (сек)"
      128         VIEW-AS TEXT
      129        SIZE 7 BY .67 NO-UNDO.
      130   DEFINE FRAME Dialog-Frame
      131        b-yes AT ROW 4.25 COL 11
      132        b-no AT ROW 4.25 COL 22.5
      133        f-msg AT ROW 1.5 COL 2.5 NO-LABEL
      134        f-wait AT ROW 3 COL 27.5 COLON-ALIGNED
      135        SPACE(6.49) SKIP(2.07)
      136       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER NO-HELP
      137            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      138            TITLE "Вопрос"
      139            CANCEL-BUTTON b-no.
      140   ASSIGN
      141          FRAME Dialog-Frame:SCROLLABLE       = FALSE.
      142   ASSIGN
      143          f-msg:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      144   ASSIGN
      145          f-wait:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE
      146          f-wait:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      147   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      148   DO:
      149     APPLY "END-ERROR":U TO SELF.
      150   END.
      151   ON CHOOSE OF b-no IN FRAME Dialog-Frame
      152   DO:
      153     assign
      154       log-exit = TRUE
      155       p-answer = FALSE
      156     .
      157   END.
      158   ON CHOOSE OF b-yes IN FRAME Dialog-Frame
      159   DO:
      160     assign
      161       log-exit = TRUE
      162       p-answer = TRUE
      163     .
      164   END.
      165   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      166   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      167   MAIN-BLOCK:
      168   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      169      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      170     define variable start-time as int64     no-undo .
      171     define variable v-length   as integer   no-undo .
      172     define variable lh         as handle    no-undo .
      173     define variable v-delta    as integer   no-undo .
      174     assign
      175       v-length = length( p-msg )
      176     .
      177     if v-length > 90 then do:
      178       message
      179         vss-workfile vss-revision vss-description skip
      180         substitute( "Сообщение должно быть не больше 90 символов!" ) skip
      181         substitute( "Ваше сообщение длиной &1 символов.", v-length ) skip
      182         view-as alert-box error .
      183       return error "Сообщение должно быть не больше 90 символов!".
      184     end.
      185     if v-length > 39 then do:
      186       assign
      187         v-delta                         = ( v-length - 39 ) / 2
      188         f-msg:width-chars               = v-length
      189         frame Dialog-Frame:width-chars = f-msg:width-chars + 4
      190         b-yes:column                    = b-yes:column + v-delta
      191         b-no:column                     = b-no:column + v-delta
      192         f-wait:column                   = f-wait:column + v-delta
      193       .
      194       if valid-handle(f-wait:side-label-handle) then do:
      195         assign
      196           lh        = f-wait:side-label-handle
      197           lh:column = lh:column + v-delta
      198         .
      199       end.
      200     end.
      201     assign
      202       f-msg    = p-msg
      203       log-exit = false
      204       p-answer = p-default-answ
      205     .
      206     RUN enable_UI.
      207     assign
      208       start-time = etime
      209     .
      210     do while not log-exit:
      211       display
      212         ( p-timeout - ( etime - start-time ) / 1000 ) @ f-wait
      213         with frame Dialog-Frame
      214         no-error
      215       .
      216       wait-for
      217         go of frame Dialog-Frame
      218         or close of this-procedure
      219         or choose of b-yes in frame Dialog-Frame
      220         or choose of b-no in frame Dialog-Frame
      221         focus frame Dialog-Frame
      222         pause 1
      223       .
      224       if etime - start-time > p-timeout * 1000 then do:
      225         leave .
      226       end.
      227     end.
      228   END.
      229   RUN disable_UI.
      230   PROCEDURE disable_UI :
      231     HIDE FRAME Dialog-Frame.
      232   END PROCEDURE.
      233   PROCEDURE enable_UI :
      234     DISPLAY f-msg f-wait
      235         WITH FRAME Dialog-Frame.
      236     ENABLE b-yes b-no f-wait
      237         WITH FRAME Dialog-Frame.
      238   END PROCEDURE.
