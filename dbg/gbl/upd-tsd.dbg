      763   ON CHOOSE OF b-down IN FRAME DIALOG-1
      764   DO:
      765   define variable v-order as integer no-undo.
      766   define variable v-rec as recid no-undo.
      767   define buffer buf_sel-t-f for t-f.
      768   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if lookup(self :type
      770            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      771            ) = 0
      772   then do:
      773     message
      774       "$Workfile$"
      775       "Указанному интерфейсному элементу фокус не может быть передан" skip
      776       "Интерфейсный элемент" self :name  skip
      777       "Тип" self :type  skip
      778       "Процедура" this-procedure :file-name skip
      779       view-as alert-box .
      780   end.
      781   else do:
      782     apply "entry":u to self  .
      783     if focus :handle <> self :handle  then do:
      784       return no-apply .
      785     end.
      786   end.
      787     if not available sel_t-f then do:
      788       return no-apply.
      789   end.
      790   assign
      791   v-rec = recid(sel_t-f).
      792   find last buf_sel-t-f use-index iorder no-error.
      793   if avail buf_sel-t-f then do:
      794       v-order = buf_sel-t-f.field-order.
      795   end.
      796   if sel_t-f.field-order = v-order then do:
      797       return no-apply.
      798   end.
      799   assign
      800   v-order = sel_t-f.field-order.
      801   find first buf_sel-t-f where
      802               buf_SEL-T-F.field-order > v-order
      803               and buf_sel-t-f.field-order > 0 use-index iorder no-error.
      804       if not available buf_sel-t-f then do:
      805           return no-apply.
      806       end.
      807   assign
      808   sel_t-f.field-order = buf_sel-t-f.field-order
      809   buf_sel-t-f.field-order = v-order
      810   .
      811     APPLY "VALUE-CHANGED" to Rs-tabs.
      812    OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      813     run enable-buttons in this-procedure.
      814     REPOSITION br-sel-fields to recid v-rec no-error.
      815     apply "ENTRY" to br-sel-fields.
      816     APPLY "Value-changed" to BR-sel-fields.
      817   END.
      818   ON CHOOSE OF b-up IN FRAME DIALOG-1
      819   DO:
      820   define variable v-order as integer no-undo.
