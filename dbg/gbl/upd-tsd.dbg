      896       "Указанному интерфейсному элементу фокус не может быть передан" skip
      897       "Интерфейсный элемент" self :name  skip
      898       "Тип" self :type  skip
      899       "Процедура" this-procedure :file-name skip
      900       view-as alert-box .
      901   end.
      902   else do:
      903     apply "entry":u to self  .
      904     if focus :handle <> self :handle  then do:
      905       return no-apply .
      906     end.
      907   end.
      908   if not avail t-f then return no-apply.
      909   find last buf_t-f no-lock use-index iorder no-error.
      910   if avail buf_t-f then do:
      911       assign
      912       v-max-order = buf_t-f.field-order
      913       .
      914   end.
      915   Find first buf_t-f where
      916                recid(buf_t-f) = recid(t-f).
      917   assign
      918   buf_t-f.field-order = v-max-order + 1
      919   v-num-clmn = v-num-clmn +  1
      920   v-length = v-length + INTEGER(t-f.field-SIZE)
      921   .
      922   APPLY "VALUE-CHANGED" to Rs-tabs.
      923   OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      924   RUN PROC-N-L IN THIS-PROCEDURE.
      925   run enable-buttons in this-procedure.
      926   REPOSITION br-sel-fields to recid recid(buf_t-f) no-error.
      927   apply "ENTRY" to br-sel-fields.
      928   APPLY "Value-changed" to BR-sel-fields.
      929   browse br-sel-fields:set-repositioned-row(5, "CONDITIONAL").
      930   END.
      931   ON CHOOSE OF btn-codes IN FRAME DIALOG-1
      932   DO:
      933   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   if lookup(self :type
      935            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
