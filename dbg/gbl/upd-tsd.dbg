      946   else do:
      947     apply "entry":u to self  .
      948     if focus :handle <> self :handle  then do:
      949       return no-apply .
      950     end.
      951   end.
      952   run adm/to-cd.w ( 'ИЗМЕНЕНИЕ':U ,
      953   INPUT v-host-code,
      954   INPUT p-obj-type,
      955   INPUT p-obj-code,
      956   INPUT ("Типы кодов для вывода в файл ТСД" + chr(32) + p-obj-type +
      957   string(p-obj-code)),
      958   INPUT-OUTPUT temp-shop.all-prt,
      959   INPUT-OUTPUT temp-shop.cd-bc-alt,
