      836   else do:
      837     apply "entry":u to self  .
      838     if focus :handle <> self :handle  then do:
      839       return no-apply .
      840     end.
      841   end.
      842     if not available sel_t-f then do:
      843       return no-apply.
      844   end.
      845   if sel_t-f.field-order = 1 then do:
      846       return no-apply.
      847   end.
      848   assign
      849   v-order = sel_t-f.field-order
      850   v-rec = recid(sel_t-f).
      851   .
      852   find last buf_sel-t-f where
      853               buf_SEL-T-F.field-order < v-order
      854               and buf_sel-t-f.field-order > 0 use-index iorder  no-error.
      855       if not available buf_sel-t-f then do:
      856           return no-apply.
      857       end.
      858   assign
      859   sel_t-f.field-order = buf_sel-t-f.field-order
      860   buf_sel-t-f.field-order = v-order
      861   .
      862     APPLY "VALUE-CHANGED" to Rs-tabs.
      863    OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
      864    run enable-buttons in this-procedure.
