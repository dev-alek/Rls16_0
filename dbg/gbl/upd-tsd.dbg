      961   INPUT-OUTPUT temp-shop.cd-loc-alt,
      962   INPUT-OUTPUT temp-shop.cd-loc-base,
      963   INPUT-OUTPUT temp-shop.cd-parts-all,
      964   INPUT-OUTPUT temp-shop.cd-parts-not-blank,
      965   INPUT-OUTPUT temp-shop.cd-parts-ser,
