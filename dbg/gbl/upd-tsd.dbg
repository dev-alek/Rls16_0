        1   define input parameter  parparentproc as widget-handle no-undo .
        2   define input parameter  p-obj-type  like ub.clients.obj-type no-undo .
        3   define input parameter  p-obj-code  like ub.clients.obj-code no-undo .
        4   define input parameter  c-point     as character no-undo .
        5   define input parameter  list-tabls  as character no-undo .
        6   define input parameter  list-buf    as character no-undo .
        7   define input parameter  list-fields as character no-undo .
        8   define input parameter  list-labels as character no-undo .
        9   define input parameter  list-spr    as character no-undo .
       10   define input parameter  list-size    as character no-undo .
       11   define input parameter  list-size-min    as character no-undo .
       12   define input parameter  list-format    as character no-undo .
       13   define input parameter  list-dim    as character no-undo .
       14   define input parameter  kl          as integer   no-undo .
       15   define output parameter ident       as recid     no-undo .
       16   define output parameter P-LENGTH       as INTEGER     no-undo .
       17   define output parameter P-NUM-CLMN       as INTEGER     no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "Создание и редактирование шаблона печати".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42       assign
       43         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,c-point,list-tabls,list-buf,list-fields,list-labels,list-spr,list-dim,kl)
       44       .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   procedure proc-alt-shift-f2:
       97     if not ibs.th.gbl.gbl-var:rcode
       98   then
       99     run gbl\inidebug.p .
      100   end.
      101   procedure proc-alt-shift-f3:
      102     run gbl/prvssinf.p
      103       ( input this-procedure
      104       ) .
      105   end.
      106   define variable v-inform-launched as logical no-undo initial false .
      107   procedure proc-alt-shift-f4:
      108     define variable v-action as character no-undo .
      109     if v-inform-launched = false then do:
      110       assign
      111         v-inform-launched = true
      112       .
      113       run gbl/d-inform.w
      114         (  input self
      115         ,  input this-procedure
      116         , output v-action
      117         ) no-error .
      118       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      119       assign
      120         v-inform-launched = false
      121       .
      122     end.
      123   end.
      124   procedure proc-alt-f1:
      125     run gbl/corrhelp.p
      126       (input this-procedure
      127       ) .
      128   end .
      129   on alt-shift-f2 anywhere do:
      130     run proc-alt-shift-f2.
      131   end.
      132   on alt-shift-f3 anywhere do:
      133     run proc-alt-shift-f3 in this-procedure .
      134   end.
      135   on alt-shift-f4 anywhere do:
      136     run proc-alt-shift-f4 in this-procedure.
      137   end.
      138   on alt-f1 anywhere do:
      139     run proc-alt-f1 in this-procedure .
      140   end.
      141   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   procedure factord :
      143     define input  parameter p-fact-date            as date    no-undo .
      144     define input  parameter p-fact-time            as integer no-undo .
      145     define input  parameter p-fact-num             as integer no-undo .
      146     define input  parameter p-shift-date           as date    no-undo .
      147     define input  parameter p-shift-num            as integer no-undo .
      148     define input  parameter p-shift-on             as logical no-undo .
      149     define output parameter p-fact-order           as decimal no-undo .
      150     define output parameter p-shift-end-fact-order as decimal no-undo .
      151     define output parameter p-day-end-fact-order   as decimal no-undo .
      152     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      153     if p-fact-date = ?
      154     then do:
      155       return error "Не указана фактическая дата" .
      156     end.
      157     define variable v-fact-date-num as integer no-undo .
      158     assign
      159       v-fact-date-num = integer(p-fact-date)
      160     .
      161     if p-fact-num = ?
      162     or p-fact-num = 0
      163     then do:
      164       return error "Не задан p-fact-num " + string(p-fact-num) .
      165     end.
      166     if p-fact-num < 0
      167     then do:
      168       return error "Отрицательный fact-num " + string(p-fact-num) .
      169     end.
      170     if p-fact-num >= 100000000
      171     then do:
      172       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      173     end.
      174     if p-shift-on = true
      175     then do:
      176       if p-shift-date = ?
      177       then do:
      178         return error "Не задана дата смены" .
      179       end.
      180       if p-shift-num = ?
      181       or p-shift-num = 0
      182       then do:
      183         return error "Не задан номер смены" .
      184       end.
      185     end.
      186     else do:
      187       assign
      188         p-shift-date = p-fact-date
      189         p-shift-num  = 24
      190       .
      191     end.
      192     define variable v-shift-offset as integer no-undo .
      193     if p-shift-date = p-fact-date
      194     then do:
      195       assign
      196         v-shift-offset = 1
      197       .
      198     end.
      199     if p-shift-date < p-fact-date
      200     then do:
      201       assign
      202         v-shift-offset = 0
      203       .
      204     end.
      205     if p-shift-date > p-fact-date
      206     then do:
      207       message
      208         vss-workfile vss-revision vss-description skip
      209         "Неправильная дата закрытия смены" skip
      210         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      211         view-as alert-box error .
      212       undo, return error
      213         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      214           ,string(p-fact-date, '99/99/9999':U)
      215           ,string(p-shift-date, '99/99/9999':U)
      216           )
      217       .
      218     end.
      219     if p-shift-num < 1
      220     or p-shift-num > 24
      221     then do:
      222       message
      223         vss-workfile vss-revision vss-description skip
      224         "Неправильный номер смены" skip
      225         "p-shift-num" p-shift-num skip
      226         view-as alert-box error .
      227       undo, return error return-value .
      228     end.
      229     assign
      230       p-fact-order           = v-fact-date-num
      231                              + v-shift-offset * 0.5
      232                              + p-shift-num    * 0.02 - 0.01
      233                              + p-fact-num     * 0.0000000001
      234       p-shift-end-fact-order = v-fact-date-num
      235                              + v-shift-offset * 0.5
      236                              + p-shift-num    * 0.02
      237       p-day-end-fact-order   = v-fact-date-num
      238                              + 0.99
      239     .
      240     if p-fact-order           <= v-fact-date-num
      241     or p-shift-end-fact-order <= v-fact-date-num
      242     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      243     or p-shift-end-fact-order >= p-day-end-fact-order
      244     then do:
      245       message
      246         vss-workfile vss-revision vss-description skip
      247         "Внутренняя ошибка при генерации фактического номера" skip
      248         "p-fact-date"            p-fact-date            skip
      249         "p-fact-time"            p-fact-time            skip
      250         "p-fact-num"             p-fact-num             skip
      251         "p-shift-date"           p-shift-date           skip
      252         "p-shift-num"            p-shift-num            skip
      253         "p-shift-on"             p-shift-on             skip
      254         "p-shift-end-fact-order" p-shift-end-fact-order skip
      255         "p-day-end-fact-order"   p-day-end-fact-order   skip
      256         "v-fact-date-num"        v-fact-date-num        skip
      257         view-as alert-box error .
      258       undo, return error return-value .
      259     end.
      260   end procedure.
      261   procedure day-begin-fact-order :
      262     define input  parameter p-fact-date            as date    no-undo .
      263     define output parameter p-day-begin-fact-order as decimal no-undo .
      264     do
      265     on error undo, return error return-value
      266     :
      267       if p-fact-date = ?
      268       then do:
      269         assign
      270           p-day-begin-fact-order = 0
      271         .
      272       end.
      273       else do:
      274         assign
      275           p-day-begin-fact-order = integer(p-fact-date)
      276         .
      277       end.
      278     end.
      279   end procedure.
      280   procedure factord-max-fact-order :
      281     define output parameter p-max-fact-order as decimal   no-undo .
      282     do
      283     on error undo, return error return-value
      284     :
      285       run day-begin-fact-order in this-procedure
      286         (input  date(1, 1, 5000)
      287         ,output p-max-fact-order
      288         ) .
      289     end.
      290   end procedure.
      291   procedure factord-cut-archive :
      292     define input  parameter p-obj-type             as character no-undo .
      293     define input  parameter p-obj-code             as integer   no-undo .
      294     define input  parameter p-fact-date            as date      no-undo .
      295     define output parameter p-shift-on             as logical   no-undo .
      296     define output parameter p-shift-date           as date      no-undo .
      297     define output parameter p-shift-num            as integer   no-undo .
      298     define output parameter p-day-end-fact-order   as decimal   no-undo .
      299     define output parameter p-shift-end-fact-order as decimal   no-undo .
      300     define variable v-fact-order as decimal   no-undo .
      301     define buffer buf_shift-obj for ub.shift-obj .
      302     do
      303     on error undo, return error return-value
      304     :
      305   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      307     (input  p-obj-type
      308     ,input  p-obj-code
      309     ,input  'shift-on=request'
      310     ,output p-shift-on
      311     ) no-error .
      312       if error-status :error
      313       then do:
      314         message
      315           vss-workfile vss-revision vss-description skip
      316           "Ошибка при определении атрибута объекта" skip
      317           "Объект" p-obj-type p-obj-code skip
      318           error-status :get-message(1) skip
      319           return-value skip
      320           view-as alert-box error .
      321         undo, return error return-value .
      322       end.
      323       if p-shift-on = false
      324       then do:
      325         assign
      326           p-shift-date               = ?
      327           p-shift-num                = 0
      328         .
      329       end.
      330       else do:
      331         find first buf_shift-obj share-lock
      332           where buf_shift-obj.obj-type   = p-obj-type
      333             and buf_shift-obj.obj-code   = p-obj-code
      334             and buf_shift-obj.shift-date > p-fact-date
      335           use-index pi
      336           no-error .
      337         if not available buf_shift-obj
      338         or buf_shift-obj.status_ <> 'зкр':U
      339         then do:
      340           message
      341             vss-workfile vss-revision vss-description skip
      342             "Невозможно вычислить последнюю смену" skip
      343             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      344             "Объект" p-obj-type p-obj-code skip
      345             "Дата" p-fact-date skip
      346             view-as alert-box error .
      347           undo, return error return-value .
      348         end.
      349         find last buf_shift-obj share-lock
      350           where buf_shift-obj.obj-type = p-obj-type
      351             and buf_shift-obj.obj-code = p-obj-code
      352             and buf_shift-obj.shift-date <= p-fact-date
      353           use-index pi
      354           no-error .
      355         if available buf_shift-obj
      356         then do:
      357           if  buf_shift-obj.status_ = 'зкр':U
      358           then do:
      359             assign
      360               p-shift-date = buf_shift-obj.shift-date
      361               p-shift-num  = buf_shift-obj.shift-num
      362             .
      363           end.
      364           else do:
      365             message
      366               vss-workfile vss-revision vss-description skip
      367               "Невозможно вычислить последнюю смену" skip
      368               "Статус смены отличен от статуса" 'зкр':U skip
      369               "Объект" p-obj-type p-obj-code skip
      370               "Дата" p-fact-date skip
      371               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      372               view-as alert-box error .
      373             undo, return error return-value .
      374           end.
      375         end.
      376         else do:
      377           assign
      378             p-shift-date = p-fact-date - 1
      379             p-shift-num  = 1
      380           .
      381         end.
      382       end.
      383       run factord in this-procedure
      384         (input  p-fact-date
      385         ,input  1
      386         ,input  1
      387         ,input  p-shift-date
      388         ,input  p-shift-num
      389         ,input  p-shift-on
      390         ,output v-fact-order
      391         ,output p-shift-end-fact-order
      392         ,output p-day-end-fact-order
      393         ) no-error .
      394       if error-status :error
      395       then do:
      396         message
      397           vss-workfile vss-revision vss-description skip
      398           "Ошибка при вызове процедуры factord"
      399           error-status :get-message(1) skip
      400           return-value skip
      401           view-as alert-box error .
      402         undo, return error return-value .
      403       end.
      404     end.
      405   end procedure.
      406   procedure factord-lock-shift :
      407     define input  parameter p-obj-type  as character no-undo .
      408     define input  parameter p-obj-code  as integer   no-undo .
      409     define input  parameter p-fact-date as date      no-undo .
      410     define parameter buffer buf_shift-obj for ub.shift-obj .
      411     define variable v-shift-on      as logical   no-undo .
      412     define variable v-extra-message as character no-undo .
      413     define variable v-error as character no-undo .
      414     do
      415     on error undo, return error return-value
      416     :
      417   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      419     (input  p-obj-type
      420     ,input  p-obj-code
      421     ,input  'shift-on=request'
      422     ,output v-shift-on
      423     ) no-error .
      424       if error-status :error
      425       then do:
      426         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      427         undo, return error v-error .
      428       end.
      429       if v-shift-on = true
      430       then do:
      431         find first buf_shift-obj share-lock
      432           where buf_shift-obj.obj-type   = p-obj-type
      433             and buf_shift-obj.obj-code   = p-obj-code
      434             and buf_shift-obj.shift-date > p-fact-date
      435           use-index pi
      436           no-error .
      437         if not available buf_shift-obj
      438         or buf_shift-obj.status_ <> 'зкр':U
      439         then do:
      440           find last buf_shift-obj
      441             where buf_shift-obj.obj-type = p-obj-type
      442               and buf_shift-obj.obj-code = p-obj-code
      443               and buf_shift-obj.status_  = 'зкр':U
      444             use-index stts
      445             no-error .
      446           if available buf_shift-obj
      447           then do:
      448             assign
      449               v-extra-message =
      450                     substitute("Дата начала последеней закрытой смены на объекте &1"
      451                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      452                               )
      453             .
      454           end.
      455           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      456           undo, return error v-error .
      457         end.
      458       end.
      459     end.
      460   end procedure.
      461   procedure factord-end-day :
      462     define input  parameter p-fact-date            as date    no-undo .
      463     define output parameter p-day-end-fact-order   as decimal no-undo .
      464     do
      465     on error undo, return error return-value
      466     :
      467       if p-fact-date = ?
      468       then do:
      469         return error "Не указана фактическая дата" .
      470       end.
      471       assign
      472         p-day-end-fact-order = integer(p-fact-date) + 0.99
      473       .
      474     end.
      475   end procedure.
      476   procedure factord-to-date :
      477     define input  parameter p-fact-order as decimal no-undo .
      478     define output parameter p-fact-date  as date    no-undo .
      479     define variable v-ref-date  as date      no-undo .
      480     define variable v-ref-delta as integer   no-undo .
      481     do
      482     on error undo, return error return-value
      483     :
      484       if p-fact-order = ?
      485       or p-fact-order = 0
      486       then do:
      487         return error "Не указан fact-order" .
      488       end.
      489       assign
      490         v-ref-date  = date(1, 1, 2000)
      491       .
      492       assign
      493         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      494       .
      495       assign
      496         p-fact-date = v-ref-date + v-ref-delta
      497       .
      498     end.
      499   end procedure.
      500   procedure factord-to-fact-num :
      501     define input  parameter p-fact-order as decimal no-undo .
      502     define output parameter p-fact-num   as integer no-undo .
      503     define variable v-fact-order-trunc as decimal no-undo .
      504     do
      505     on error undo, return error return-value
      506     :
      507       if p-fact-order = ?
      508       or p-fact-order = 0
      509       then do:
      510         return error "Не указан fact-order" .
      511       end.
      512       assign
      513        v-fact-order-trunc = truncate(p-fact-order, 2)
      514       .
      515       assign
      516         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      517       .
      518     end.
      519   end procedure.
      520   procedure factord-to-shift-num :
      521     define input  parameter p-fact-order as decimal no-undo .
      522     define output parameter p-shift-num   as integer no-undo .
      523     define variable  p-shift-numd  as decimal   no-undo .
      524     define variable v-fact-order-trunc as decimal no-undo .
      525     do
      526     on error undo, return error return-value
      527     :
      528       if p-fact-order = ?
      529       or p-fact-order = 0
      530       then do:
      531         return error "Не указан fact-order" .
      532       end.
      533       assign
      534        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      535       .
      536       if v-fact-order-trunc < 0.5 then do:
      537         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      538       end.
      539       assign
      540         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      541         .
      542        assign
      543         p-shift-num = truncate (p-shift-numd , 0)
      544       .
      545     end.
      546   end procedure.
      547   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   FUNCTION yearofst RETURNS integer
      549     ( input p-year as integer ) :
      550   DEFINE VARIABLE v-year-true as integer no-undo .
      551   DEFINE VARIABLE v-y-o as integer no-undo .
      552   DEFINE VARIABLE v-ost as integer no-undo .
      553   if p-year < 0 or p-year > 99 then return ?.
      554   assign
      555   v-y-o = session:year-offset
      556   v-ost = (v-y-o MODULO 100)
      557   v-year-true = (if p-year < v-ost
      558                  then (v-y-o + (v-y-o MODULO 100) + p-year)
      559                  else (v-y-o - v-ost + p-year))
      560   .
      561   return v-year-true.
      562   END FUNCTION.
