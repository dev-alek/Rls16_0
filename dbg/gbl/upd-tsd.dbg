      866     apply "ENTRY" to br-sel-fields.
      867      APPLY "Value-changed" to BR-sel-fields.
      868   END.
      869   ON MOUSE-SELECT-DBLCLICK OF BR-fields IN FRAME DIALOG-1
      870   DO:
      871     APPLY "CHOOSE" to btn-add.
      872   END.
      873   ON VALUE-CHANGED OF BR-sel-fields IN FRAME DIALOG-1
      874   DO:
      875     if not avail sel_t-f then return no-apply.
      876     if sel_t-f.field-size = sel_t-f.field-size-min  then do:
      877       assign
      878       sel_t-f.field-csize:read-only in browse BR-sel-fields = yes.
      879     end.
      880     else do:
      881         assign
      882         sel_t-f.field-csize:read-only in browse BR-sel-fields = no.
      883        end.
      884   END.
      885   ON CHOOSE OF btn-add IN FRAME DIALOG-1
      886   DO:
      887   define variable v-max-order as integer no-undo.
      888   define buffer buf_t-f for t-f.
      889   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if lookup(self :type
      891            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      892            ) = 0
      893   then do:
      894     message
