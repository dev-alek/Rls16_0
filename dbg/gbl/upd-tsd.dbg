      972   ON CHOOSE OF btn-remove IN FRAME DIALOG-1
      973   DO:
      974   define variable v-order as integer no-undo.
      975   define buffer buf_t-f for t-f.
      976   define buffer buf1_t-f for t-f.
      977   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   if lookup(self :type
      979            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      980            ) = 0
      981   then do:
      982     message
      983       "$Workfile$"
      984       "Указанному интерфейсному элементу фокус не может быть передан" skip
      985       "Интерфейсный элемент" self :name  skip
      986       "Тип" self :type  skip
      987       "Процедура" this-procedure :file-name skip
      988       view-as alert-box .
      989   end.
      990   else do:
      991     apply "entry":u to self  .
      992     if focus :handle <> self :handle  then do:
      993       return no-apply .
      994     end.
      995   end.
      996   if not available sel_t-f then do:
      997       return no-apply.
      998   end.
      999    find first buf_t-f where
     1000            recid(buf_t-f) = recid(sel_t-f)
     1001    .
     1002    v-order = buf_t-f.field-order.
     1003   assign
     1004   buf_t-f.field-order = 0
     1005   v-num-clmn = v-num-clmn -  1
     1006   v-length = v-length - INTEGER(sel_t-f.field-SIZE)
     1007   .
     1008   for each buf_t-f where
     1009                buf_t-f.field-order > v-order:
     1010       find first buf1_t-f where
     1011                   recid(buf1_t-f) = recid(buf_t-f).
     1012       assign
     1013       buf1_t-f.field-order =   buf1_t-f.field-order - 1
     1014       .
     1015   END.
     1016   APPLY "VALUE-CHANGED" to Rs-tabs.
     1017   OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
     1018   RUN PROC-N-L IN THIS-PROCEDURE.
     1019   run enable-buttons in this-procedure.
     1020   REPOSITION br-sel-fields to row v-order - 1 no-error.
     1021   apply "ENTRY" to br-sel-fields.
     1022    APPLY "Value-changed" to BR-sel-fields.
     1023   END.
     1024   ON CHOOSE OF Btn_Cancel IN FRAME DIALOG-1
     1025   DO:
     1026   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   if lookup(self :type
     1028            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1029            ) = 0
     1030   then do:
     1031     message
     1032       "$Workfile$"
     1033       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1034       "Интерфейсный элемент" self :name  skip
     1035       "Тип" self :type  skip
     1036       "Процедура" this-procedure :file-name skip
     1037       view-as alert-box .
     1038   end.
     1039   else do:
     1040     apply "entry":u to self  .
     1041     if focus :handle <> self :handle  then do:
     1042       return no-apply .
     1043     end.
     1044   end.
     1045   END.
     1046   ON CHOOSE OF Btn_OK IN FRAME DIALOG-1
     1047   DO:
     1048   define variable v-file-name as character no-undo.
     1049   define buffer buf_sel-t-f for t-f.
     1050   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1051   if lookup(self :type
     1052            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1053            ) = 0
     1054   then do:
     1055     message
     1056       "$Workfile$"
     1057       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1058       "Интерфейсный элемент" self :name  skip
     1059       "Тип" self :type  skip
     1060       "Процедура" this-procedure :file-name skip
     1061       view-as alert-box .
     1062   end.
     1063   else do:
     1064     apply "entry":u to self  .
     1065     if focus :handle <> self :handle  then do:
     1066       return no-apply .
     1067     end.
     1068   end.
     1069   if (can-find(ubflt.filter where ubflt.filter.call-point = c-point
     1070          and ubflt.filter.naim = input frame DIALOG-1 ubflt.filter.naim) and v-new) or
     1071          input frame DIALOG-1 ubflt.filter.naim = "" then do:
     1072       if input frame DIALOG-1 ubflt.filter.naim = ""
     1073       then
     1074       message "Пустое имя фильтра недопустимо".
     1075       else message "Фильтр с таким именем уже сущестует".
     1076       apply "entry" to ubflt.filter.naim.
     1077       return no-apply.
     1078   end.
     1079   id = recid(ubflt.filter).
     1080   IDENT = RECID(ubflt.filter).
     1081   assign
     1082   select3 = "":U
     1083   select3-size = "":U
     1084   select3-size-min = "":U
     1085   select3-csize = "":U
     1086   select3-format = "":U
     1087   select3-type = "":U
     1088   select3-codes = "":U
     1089   select3-label = "":U
     1090   s-delim
     1091   f-rec-num
     1092   cb-scl-format
     1093   cb-pg-format
     1094   .
     1095   APPLY "Value-changed" to s-delim.
     1096   run check-delim in this-procedure (chr(int(s-delim))) no-error.
     1097   if error-status:error then return no-apply.
     1098   for each buf_sel-t-f no-lock where
     1099            buf_sel-t-f.field-order > 0
     1100   by buf_sel-t-f.field-order
     1101            :
     1102     assign
     1103     v-file-name = "":U.
     1104     do ii = 1 to num-entries(buf_sel-t-f.field-name, '*':U):
     1105         assign
     1106         v-file-name = v-file-name + '*':U + buf_sel-t-f.table-name + ".":U + entry(ii, buf_sel-t-f.field-name, '*':U)
     1107         .
     1108     end.
     1109     assign
     1110     v-file-name = left-trim(v-file-name , '*':U)
     1111     .
     1112     assign
     1113     select3 = select3 + chr(44) + v-file-name
     1114     select3-size = select3-size + chr(44) + buf_sel-t-f.field-size
     1115     select3-size-min = select3-size-min + chr(44) + buf_sel-t-f.field-size-min
     1116     select3-csize = select3-csize + chr(44) + buf_sel-t-f.field-csize
     1117     select3-format = select3-format + chr(4) + buf_sel-t-f.field-format
     1118     select3-type = select3-type + chr(44) + buf_sel-t-f.field-type
     1119     select3-label = select3-label + chr(44) + buf_sel-t-f.field-clabel
     1120     .
     1121   end.
     1122   if lookup("function.b-code-tsd":U, select3) = 0 then do:
     1123       message
     1124       "Нельзя создать шаблон вывода без поля БАР-КОД"
     1125       view-as alert-box error.
     1126       return no-apply.
     1127   end.
     1128   assign
     1129   select3-codes =
     1130                   (if temp-shop.all-prt then "all-prt":U else "":U) + chr(44) +
     1131                   (if temp-shop.cd-bc-alt then "cd-bc-alt":U else "":U) + chr(44) +
     1132                   (if temp-shop.cd-bc-base then "cd-bc-base":U else "":U) + chr(44) +
     1133                   (if temp-shop.cd-loc-alt then "cd-loc-alt":U else "":U) + chr(44) +
     1134                   (if temp-shop.cd-loc-base then "cd-loc-base":U else "":U) + chr(44) +
     1135                   (if temp-shop.cd-parts-all then "cd-parts-all":U else "":U) + chr(44) +
     1136                   (if temp-shop.cd-parts-not-blank then "cd-parts-not-blank":U else "":U) + chr(44) +
     1137                   (if temp-shop.cd-parts-ser then "cd-parts-ser":U else "":U) + chr(44) +
     1138                   (if temp-shop.cd-pb-alt then "cd-pb-alt":U else "":U) + chr(44) +
     1139                   (if temp-shop.cd-pb-base then "cd-pb-base":U else "":U) + chr(44) +
     1140                   (if temp-shop.cd-sc-base then "cd-sc-base":U else "":U)
     1141   .
     1142   if trim(select3-codes, chr(44)) = "all-prt":u or trim(select3-codes, chr(44)) = "":U then do:
     1143       message
     1144       "Необходимо указать хотя бы один тип кода для вывода"
     1145       view-as alert-box error.
     1146       return no-apply.
     1147   end.
     1148   assign
     1149   Filter.naim = input frame DIALOG-1 ubflt.filter.naim
     1150   Filter.call-point = c-point
     1151   Filter.Tbl = List-Tabls
     1152   Filter.Flds = List-Fields
     1153   Filter.Fields-sort = left-trim(SELECT3, chr(44))
     1154   Filter.Fields-sort-rus = left-trim(SELECT3-label, chr(44)) + chr(4) +
     1155                            left-trim(SELECT3-codes, chr(44)) + chr(4) +
     1156                            s-delim + chr(4) +
     1157                            string(f-rec-num)  + chr(4) + cb-scl-format + chr(4) + cb-pg-format
     1158   Filter.Where-ysl = left-trim(select3-size, chr(44)) + chr(4) +
     1159                                       left-trim(select3-size-min, chr(44)) + chr(4) +
     1160                                       left-trim(select3-csize, chr(44))
     1161   Filter.Where-ysl-rus = left-trim(select3-format, chr(4))
     1162   Filter.lst-cend = left-trim(select3-type, chr(44))
     1163   .
     1164   END.
     1165   ON VALUE-CHANGED OF RS-tabs IN FRAME DIALOG-1
     1166   DO:
     1167   if rs-tabs:visible in frame DIALOG-1 then
     1168     assign
     1169     rs-tabs.
     1170   OPEN QUERY br-fields FOR EACH t-f no-lock where t-f.table-name = RS-tabs
     1171   and t-f.field-order = 0 use-index itorder.
     1172   END.
     1173   ON VALUE-CHANGED OF S-delim IN FRAME DIALOG-1
     1174   DO:
     1175     assign
     1176     S-delim
     1177     .
     1178     Assign
     1179     f-delim = chr(int(s-delim))
     1180     f-delim = (if f-delim = '':U then 'нет' else f-delim)
     1181     .
     1182     display f-delim
     1183     with frame DIALOG-1
     1184     .
     1185   END.
     1186   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
     1187   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
     1188   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
     1189   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   on help of frame DIALOG-1
     1191   do:
     1192     run gbl/app_help.p
     1193       (input this-procedure :file-name
     1194       ,input ''
     1195       ,input ?
     1196       ) no-error.
     1197     if error-status :error then do:
     1198       message
     1199         "Ошибка при вызове помощи"
     1200         error-status :get-message(1)
     1201         view-as alert-box .
     1202     end.
     1203   end.
     1204   run minbtn-set in this-procedure .
     1205   on choose of b-help in frame DIALOG-1
     1206   do:
     1207     apply "help":u to frame DIALOG-1 .
     1208   end.
     1209   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   procedure minbtn-set :
     1211       do
     1212           on error undo, return error return-value
     1213           :
     1214           define variable ii              as integer       no-undo .
     1215           define variable fh              as widget-handle no-undo .
     1216           define variable hh              as widget-handle no-undo .
     1217           define variable v-h             as handle        extent 4 no-undo .
     1218           define variable v-name-button   as character     no-undo .
     1219           define variable v-help-old-x    as decimal       no-undo .
     1220           define variable v-help-old-y    as decimal       no-undo .
     1221           define variable v-help-old-size as decimal       no-undo .
     1222           define variable v-frame-width   as decimal       no-undo .
     1223           define variable jj              as integer       no-undo .
     1224           do
     1225               on error undo, return error
     1226               :
     1227               assign
     1228                   v-frame-width = frame DIALOG-1:width - 0.3
     1229                   fh            = frame DIALOG-1:first-child
     1230                   hh            = fh:first-child
     1231                   ii            = 1
     1232                   .
     1233               do while valid-handle(hh):
     1234                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1235                   do:
     1236                       case lc(hh:name) :
     1237                           when "b-help" then
     1238                               do:
     1239                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1240                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1241                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1242                                   hh:TOOLTIP = "Помощь" .
     1243                                   v-help-old-x = hh:column .
     1244                                   v-help-old-y = hh:row    .
     1245                                   v-help-old-size = hh:width .
     1246                                   hh:width-chars = 2.5 .
     1247                               end.
     1248                           when "b-print" then
     1249                               do:
     1250                                   hh:load-image("cmp/b-print.bmp":u) .
     1251                                   hh:TOOLTIP = "Печать" .
     1252                                   v-h[ii] = hh:handle .
     1253                                   ii = ii + 1 .
     1254                                   hh:width-chars = 3 .
     1255                               end.
     1256                           when "b-history" or
     1257                           when "b-hist" then
     1258                               do:
     1259                                   hh:load-image("cmp/b-hist.bmp":u) .
     1260                                   hh:TOOLTIP = "История" .
     1261                                   v-h[ii] = hh:handle .
     1262                                   ii = ii + 1 .
     1263                                   hh:width-chars = 3 .
     1264                               end.
     1265                           when "b-sch" then
     1266                               do:
     1267                                   hh:load-image("cmp/b-sch.bmp":u) .
     1268                                   hh:TOOLTIP = "Установка Фильтра" .
     1269                                   v-h[ii] = hh:handle .
     1270                                   ii = ii + 1 .
     1271                                   hh:width-chars = 3 .
     1272                               end.
     1273                           when "b-hist-user" then
     1274                               do:
     1275                                   hh:load-image("cmp/b-hist.bmp":u) .
     1276                                   hh:TOOLTIP = "История пользователя" .
     1277                                   ii = ii + 1 .
     1278                               end.
     1279                       end case.
     1280                   end.
     1281                   hh = hh:next-sibling.
     1282               end.
     1283               b-help:column = v-frame-width - b-help:width-chars.
     1284               jj = 0.
     1285               repeat ii = 4 to 1 by -1 :
     1286                   if valid-handle (v-h[ii] ) then
     1287                   do:
     1288                       jj  = jj + 1 .
     1289                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1290                       v-h[ii]:row    = v-help-old-y .
     1291                   end.
     1292               end.
     1293           end.
     1294       end.
     1295   end procedure.
     1296   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1297   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1298   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1299   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1300   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1301   define variable v-diasize-current-frame-height as decimal   no-undo .
     1302   define variable v-diasize-change-size          as logical   no-undo .
     1303   define variable v-diasize-resize-button        as handle    no-undo .
     1304   define variable v-diasize-wndmax               as logical   no-undo .
     1305   define variable v-diasize-wndstore             as logical   no-undo .
     1306   define variable v-diasize-proc-name            as character no-undo .
     1307   define variable v-diasize-browse-handle        as handle    no-undo .
     1308   define variable v-diasize-browse-number        as integer   no-undo .
     1309   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1310   define temp-table temp-diasize-handle no-undo
     1311     field handle-value  as handle
     1312     field save-position as decimal
     1313     index xpk is primary unique handle-value
     1314     .
     1315   define temp-table temp-browse-handle no-undo
     1316     field browse-type   as character
     1317     field browse-number as integer
     1318     field browse-handle as handle
     1319     field original-size as decimal
     1320     index xpk is primary unique browse-type browse-number
     1321     index xie browse-type browse-handle
     1322   .
     1323   procedure diasize_change-height :
     1324     define input  parameter p-change-value  as decimal   no-undo .
     1325     define input  parameter p-move-resize   as logical   no-undo .
     1326     define variable v-field-group-handle    as handle    no-undo .
     1327     define variable v-object-handle         as handle    no-undo .
     1328     define variable v-frame-height          as decimal   no-undo .
     1329     define variable v-frame-virtual-height  as decimal   no-undo .
     1330     define variable v-browse-height         as decimal   no-undo .
     1331     define variable v-window-height         as decimal   no-undo .
     1332     define variable v-window-virtual-height as decimal   no-undo .
     1333     define variable v-change-sign           as integer   no-undo .
     1334     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1335     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1336     if p-change-value > 0
     1337     then do:
     1338       if frame DIALOG-1 :height + p-change-value
     1339           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1340       then do:
     1341         assign
     1342           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1343                           - (frame DIALOG-1 :height-chars)
     1344         .
     1345         if p-change-value <= 0
     1346         then do:
     1347           run diasize_position-resize-button in this-procedure .
     1348           return .
     1349         end.
     1350       end.
     1351     end.
     1352     if p-change-value < 0
     1353     then do:
     1354       if frame DIALOG-1 :height + p-change-value < v-diasize-orig-frame-height
     1355       then do:
     1356         assign
     1357           p-change-value = v-diasize-orig-frame-height
     1358                          - (frame DIALOG-1 :height-chars)
     1359         .
     1360         if p-change-value >= 0
     1361         then do:
     1362           run diasize_position-resize-button in this-procedure .
     1363           return .
     1364         end.
     1365       end.
     1366     end.
     1367     if p-change-value >= 0
     1368     then do:
     1369       assign
     1370         v-change-sign = 1
     1371       .
     1372     end.
     1373     else do:
     1374       assign
     1375         v-change-sign = -1
     1376       .
     1377     end.
     1378     assign
     1379       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1380     .
     1381     if p-change-value = 0
     1382     then do:
     1383       run diasize_position-resize-button in this-procedure .
     1384       return .
     1385     end.
     1386     move_block:
     1387     do
     1388     on error undo move_block, retry move_block
     1389     :
     1390       if retry
     1391       then do:
     1392         do
     1393         on error undo move_block, leave move_block
     1394         :
     1395           if p-change-value > 0
     1396           then do:
     1397             for each buf_temp-diasize-handle
     1398             on error undo, next
     1399             :
     1400               assign
     1401                 v-object-handle = buf_temp-diasize-handle.handle-value
     1402               .
     1403               if v-object-handle <> v-diasize-resize-button
     1404               then do:
     1405                 assign
     1406                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1407                 .
     1408               end.
     1409             end.
     1410             assign
     1411               v-diasize-browse-handle :height = v-browse-height
     1412             .
     1413             for each buf_temp-browse-handle
     1414               where buf_temp-browse-handle.browse-type = 'height':u
     1415             on error undo, next
     1416             :
     1417               assign
     1418                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1419               .
     1420             end.
     1421             assign
     1422               frame DIALOG-1 :height = v-frame-height
     1423             .
     1424             if frame DIALOG-1 :scrollable = true
     1425             then do:
     1426               assign
     1427                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1428               .
     1429             end.
     1430             run diasize_position-resize-button in this-procedure .
     1431           end.
     1432           else do:
     1433             if frame DIALOG-1 :scrollable = true
     1434             then do:
     1435               assign
     1436                 frame DIALOG-1 :virtual-height = v-frame-virtual-height
     1437               .
     1438             end.
     1439             assign
     1440               frame DIALOG-1 :height = v-frame-height
     1441             .
     1442             assign
     1443               v-diasize-browse-handle :height = v-browse-height
     1444             .
     1445             for each buf_temp-browse-handle
     1446               where buf_temp-browse-handle.browse-type = 'height':u
     1447             on error undo, next
     1448             :
     1449               assign
     1450                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1451               .
     1452             end.
     1453             for each buf_temp-diasize-handle
     1454             on error undo, next
     1455             :
     1456               assign
     1457                 v-object-handle = buf_temp-diasize-handle.handle-value
     1458               .
     1459               if v-object-handle <> v-diasize-resize-button
     1460               then do:
     1461                 assign
     1462                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1463                 .
     1464               end.
     1465             end.
     1466             run diasize_position-resize-button in this-procedure .
     1467           end.
     1468           assign
     1469             v-diasize-change-size = false
     1470           .
     1471           leave move_block .
     1472         end.
     1473       end.
     1474       assign
     1475         v-diasize-need-full-display = true
     1476       .
     1477       if v-diasize-change-size = false
     1478       then do:
     1479         assign
     1480           v-diasize-change-size = true
     1481         .
     1482       end.
     1483       else do:
     1484         return .
     1485       end.
     1486       assign
     1487         v-frame-height = frame DIALOG-1 :height
     1488         v-frame-virtual-height = frame DIALOG-1 :virtual-height
     1489         v-browse-height = v-diasize-browse-handle :height
     1490       .
     1491       for each buf_temp-browse-handle
     1492         where buf_temp-browse-handle.browse-type = 'height':u
     1493       :
     1494         assign
     1495           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1496         .
     1497       end.
     1498       for each buf_temp-diasize-handle
     1499       :
     1500         delete buf_temp-diasize-handle .
     1501       end.
     1502       assign
     1503         v-field-group-handle = frame DIALOG-1 :first-child
     1504       .
     1505       do while valid-handle(v-field-group-handle)
     1506       :
     1507         assign
     1508           v-object-handle = v-field-group-handle :first-child
     1509         .
     1510         do while valid-handle(v-object-handle)
     1511         :
     1512           if  v-object-handle <> v-diasize-browse-handle :handle
     1513           and can-query(v-object-handle, "row")
     1514           and can-query(v-object-handle, "height")
     1515           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1516           then do:
     1517             find first buf_temp-browse-handle
     1518               where buf_temp-browse-handle.browse-type   = 'height':u
     1519                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1520               no-error .
     1521             if available buf_temp-browse-handle
     1522             then do:
     1523             end.
     1524             else do:
     1525               create buf_temp-diasize-handle .
     1526               assign
     1527                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1528                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1529               .
     1530             end.
     1531           end.
     1532           assign
     1533             v-object-handle = v-object-handle :next-sibling
     1534           .
     1535         end.
     1536         assign
     1537           v-field-group-handle = v-field-group-handle :next-sibling
     1538         .
     1539       end.
     1540       do with frame DIALOG-1
     1541       :
     1542         hide v-diasize-resize-button .
     1543         assign
     1544           v-diasize-resize-button :row    = 1
     1545           v-diasize-resize-button :column = 1
     1546         .
     1547       end.
     1548       if p-change-value > 0
     1549       then do:
     1550         if frame DIALOG-1 :scrollable = true
     1551         then do:
     1552           assign
     1553             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1554             no-error .
     1555           if error-status :error
     1556           or error-status :get-message(1) <> ""
     1557           then do:
     1558             undo move_block, retry move_block .
     1559           end.
     1560         end.
     1561         assign
     1562           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1563           no-error .
     1564         if error-status :error
     1565         or error-status :get-message(1) <> ""
     1566         then do:
     1567           undo move_block, retry move_block .
     1568         end.
     1569         assign
     1570           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1571           no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block .
     1576         end.
     1577         for each buf_temp-browse-handle
     1578           where buf_temp-browse-handle.browse-type = 'height':u
     1579         on error undo move_block, retry move_block
     1580         :
     1581           assign
     1582             buf_temp-browse-handle.browse-handle :height
     1583               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1584             no-error .
     1585           if error-status :error
     1586           or error-status :get-message(1) <> ""
     1587           then do:
     1588             undo move_block, retry move_block .
     1589           end.
     1590         end.
     1591         for each buf_temp-diasize-handle
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             v-object-handle = buf_temp-diasize-handle.handle-value
     1596           .
     1597           if v-object-handle <> v-diasize-resize-button
     1598           then do:
     1599             assign
     1600               v-object-handle :row = v-object-handle :row + p-change-value
     1601               no-error .
     1602             if error-status :error
     1603             or error-status :get-message(1) <> ""
     1604             then do:
     1605               undo move_block, retry move_block .
     1606             end.
     1607           end.
     1608         end.
     1609       end.
     1610       else do:
     1611         for each buf_temp-diasize-handle
     1612         on error undo move_block, retry move_block
     1613         :
     1614           assign
     1615             v-object-handle = buf_temp-diasize-handle.handle-value
     1616           .
     1617           if v-object-handle <> v-diasize-resize-button
     1618           then do:
     1619             assign
     1620               v-object-handle :row = v-object-handle :row + p-change-value
     1621               no-error .
     1622             if error-status :error
     1623             or error-status :get-message(1) <> ""
     1624             then do:
     1625               undo move_block, retry move_block .
     1626             end.
     1627           end.
     1628         end.
     1629         assign
     1630           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1631           no-error .
     1632         if error-status :error
     1633         or error-status :get-message(1) <> ""
     1634         then do:
     1635           undo move_block, retry move_block .
     1636         end.
     1637         for each buf_temp-browse-handle
     1638           where buf_temp-browse-handle.browse-type = 'height':u
     1639         on error undo move_block, retry move_block
     1640         :
     1641           assign
     1642             buf_temp-browse-handle.browse-handle :height
     1643               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1644             no-error .
     1645           if error-status :error
     1646           or error-status :get-message(1) <> ""
     1647           then do:
     1648             undo move_block, retry move_block .
     1649           end.
     1650         end.
     1651         assign
     1652           frame DIALOG-1 :height = frame DIALOG-1 :height + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block .
     1658         end.
     1659         if frame DIALOG-1 :scrollable = true
     1660         then do:
     1661           assign
     1662             frame DIALOG-1 :virtual-height = frame DIALOG-1 :virtual-height + p-change-value
     1663             no-error .
     1664           if error-status :error
     1665           or error-status :get-message(1) <> ""
     1666           then do:
     1667             undo move_block, retry move_block .
     1668           end.
     1669         end.
     1670       end.
     1671       if p-move-resize = true
     1672       then do:
     1673         run diasize_position-resize-button in this-procedure .
     1674       end.
     1675       if v-diasize-wndstore = true
     1676       then do:
     1677         if connected("ub") = true
     1678         then do:
     1679           define variable v-cntxt-db-num        as integer   no-undo .
     1680           define variable v-cntxt-userid        as character no-undo .
     1681           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1682                                             , OUTPUT v-cntxt-userid
     1683                                             ) .
     1684           run gbl/wndsizew.p
     1685             (input  v-cntxt-db-num
     1686             ,input  v-cntxt-userid
     1687             ,input  v-diasize-proc-name
     1688             ,input  'height':u
     1689             ,input  string(frame DIALOG-1 :height - v-diasize-orig-frame-height)
     1690             ) .
     1691         end.
     1692       end.
     1693     end.
     1694     assign
     1695       v-diasize-change-size = false
     1696     .
     1697   end procedure.
     1698   procedure diasize_set-height :
     1699     define input  parameter p-new-height  as decimal   no-undo .
     1700     define input  parameter p-move-resize as logical   no-undo .
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704       run diasize_change-height in this-procedure
     1705         (input  (p-new-height - frame DIALOG-1 :height)
     1706         ,input  p-move-resize
     1707         ) .
     1708     end.
     1709   end procedure.
     1710   procedure diasize_change-width :
     1711     define input  parameter p-change-value as decimal   no-undo .
     1712     define input  parameter p-move-resize  as logical   no-undo .
     1713     define variable v-field-group-handle   as handle    no-undo .
     1714     define variable v-object-handle        as handle    no-undo .
     1715     define variable v-frame-width          as decimal   no-undo .
     1716     define variable v-frame-virtual-width  as decimal   no-undo .
     1717     define variable v-browse-width         as decimal   no-undo .
     1718     define variable v-window-width         as decimal   no-undo .
     1719     define variable v-window-virtual-width as decimal   no-undo .
     1720     define variable v-change-sign          as integer   no-undo .
     1721     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1722     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1723     if p-change-value > 0
     1724     then do:
     1725       if frame DIALOG-1 :width + p-change-value >
     1726           session :width-chars
     1727       then do:
     1728         assign
     1729           p-change-value = session :width-chars - frame DIALOG-1 :width
     1730         .
     1731         if p-change-value <= 0
     1732         then do:
     1733           run diasize_position-resize-button in this-procedure .
     1734           return .
     1735         end.
     1736       end.
     1737     end.
     1738     if p-change-value < 0
     1739     then do:
     1740       if frame DIALOG-1 :width + p-change-value < v-diasize-orig-frame-width
     1741       then do:
     1742         assign
     1743           p-change-value = v-diasize-orig-frame-width
     1744                          - frame DIALOG-1 :width
     1745         .
     1746         if p-change-value >= 0
     1747         then do:
     1748           run diasize_position-resize-button in this-procedure .
     1749           return .
     1750         end.
     1751       end.
     1752     end.
     1753     if p-change-value >= 0
     1754     then do:
     1755       assign
     1756         v-change-sign = 1
     1757       .
     1758     end.
     1759     else do:
     1760       assign
     1761         v-change-sign = -1
     1762       .
     1763     end.
     1764     assign
     1765       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1766     .
     1767     if p-change-value = 0
     1768     then do:
     1769       run diasize_position-resize-button in this-procedure .
     1770       return .
     1771     end.
     1772     move_block:
     1773     do
     1774     on error undo move_block, leave move_block
     1775     :
     1776       if retry
     1777       then do:
     1778         do
     1779         on error undo move_block, leave move_block
     1780         :
     1781           if p-change-value > 0
     1782           then do:
     1783             for each buf_temp-diasize-handle
     1784             on error undo, next
     1785             :
     1786               assign
     1787                 v-object-handle = buf_temp-diasize-handle.handle-value
     1788               .
     1789               if v-object-handle <> v-diasize-resize-button
     1790               then do:
     1791                 assign
     1792                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1793                 .
     1794               end.
     1795             end.
     1796             assign
     1797               v-diasize-browse-handle :width = v-browse-width
     1798             .
     1799             for each buf_temp-browse-handle
     1800               where buf_temp-browse-handle.browse-type = 'width':u
     1801             on error undo, next
     1802             :
     1803               assign
     1804                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1805               .
     1806             end.
     1807             assign
     1808               frame DIALOG-1 :width = v-frame-width
     1809             .
     1810             if frame DIALOG-1 :scrollable = true
     1811             then do:
     1812               assign
     1813                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1814               .
     1815             end.
     1816             run diasize_position-resize-button in this-procedure .
     1817           end.
     1818           else do:
     1819             if frame DIALOG-1 :scrollable = true
     1820             then do:
     1821               assign
     1822                 frame DIALOG-1 :virtual-width = v-frame-virtual-width
     1823               .
     1824             end.
     1825             assign
     1826               frame DIALOG-1 :width = v-frame-width
     1827             .
     1828             for each buf_temp-browse-handle
     1829               where buf_temp-browse-handle.browse-type = 'width':u
     1830             on error undo, next
     1831             :
     1832               assign
     1833                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1834               .
     1835             end.
     1836             assign
     1837               v-diasize-browse-handle :width = v-browse-width
     1838             .
     1839             for each buf_temp-diasize-handle
     1840             on error undo, next
     1841             :
     1842               assign
     1843                 v-object-handle = buf_temp-diasize-handle.handle-value
     1844               .
     1845               if v-object-handle <> v-diasize-resize-button
     1846               then do:
     1847                 assign
     1848                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1849                 .
     1850               end.
     1851             end.
     1852             run diasize_position-resize-button in this-procedure .
     1853           end.
     1854           assign
     1855             v-diasize-change-size = false
     1856           .
     1857           leave move_block .
     1858         end.
     1859       end.
     1860       assign
     1861         v-diasize-need-full-display = true
     1862       .
     1863       if v-diasize-change-size = false
     1864       then do:
     1865         assign
     1866           v-diasize-change-size = true
     1867         .
     1868       end.
     1869       else do:
     1870         return .
     1871       end.
     1872       assign
     1873         v-frame-width = frame DIALOG-1 :width
     1874         v-frame-virtual-width = frame DIALOG-1 :virtual-width
     1875         v-browse-width = v-diasize-browse-handle :width
     1876       .
     1877       for each buf_temp-browse-handle
     1878         where buf_temp-browse-handle.browse-type = 'width':u
     1879       :
     1880         assign
     1881           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1882         .
     1883       end.
     1884       for each buf_temp-diasize-handle
     1885       :
     1886         delete buf_temp-diasize-handle .
     1887       end.
     1888       assign
     1889         v-field-group-handle = frame DIALOG-1 :first-child
     1890       .
     1891       do while valid-handle(v-field-group-handle)
     1892       :
     1893         assign
     1894           v-object-handle = v-field-group-handle :first-child
     1895         .
     1896         do while valid-handle(v-object-handle)
     1897         :
     1898           if  v-object-handle <> v-diasize-browse-handle :handle
     1899           and v-object-handle <> v-diasize-resize-button
     1900           and can-query(v-object-handle, "row")
     1901           and can-query(v-object-handle, "height")
     1902           and ( v-object-handle :col + v-object-handle :width
     1903                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1904               )
     1905           then do:
     1906             find first buf_temp-browse-handle
     1907               where buf_temp-browse-handle.browse-type   = 'width':u
     1908                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1909               no-error .
     1910             if available buf_temp-browse-handle
     1911             then do:
     1912             end.
     1913             else do:
     1914               create buf_temp-diasize-handle .
     1915               assign
     1916                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1917                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1918               .
     1919             end.
     1920           end.
     1921           assign
     1922             v-object-handle = v-object-handle :next-sibling
     1923           .
     1924         end.
     1925         assign
     1926           v-field-group-handle = v-field-group-handle :next-sibling
     1927         .
     1928       end.
     1929       do with frame DIALOG-1
     1930       :
     1931         hide v-diasize-resize-button .
     1932         v-diasize-resize-button :row = 1.
     1933         v-diasize-resize-button :column = 1.
     1934       end.
     1935       if p-change-value > 0
     1936       then do:
     1937         if frame DIALOG-1 :scrollable = true
     1938         then do:
     1939           assign
     1940             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block.
     1946           end.
     1947         end.
     1948         assign
     1949           frame DIALOG-1 :width = v-frame-width + p-change-value
     1950           no-error .
     1951         if error-status :error
     1952         or error-status :get-message(1) <> ""
     1953         then do:
     1954           undo move_block, retry move_block.
     1955         end.
     1956         assign
     1957           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1958         no-error .
     1959         if error-status :error
     1960         or error-status :get-message(1) <> ""
     1961         then do:
     1962           undo move_block, retry move_block.
     1963         end.
     1964         for each buf_temp-browse-handle
     1965           where buf_temp-browse-handle.browse-type = 'width':u
     1966         on error undo move_block, retry move_block
     1967         :
     1968           assign
     1969             buf_temp-browse-handle.browse-handle :width
     1970               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1971             no-error .
     1972           if error-status :error
     1973           or error-status :get-message(1) <> ""
     1974           then do:
     1975             undo move_block, retry move_block .
     1976           end.
     1977         end.
     1978         for each buf_temp-diasize-handle
     1979         on error undo move_block, retry move_block
     1980         :
     1981           assign
     1982             v-object-handle = buf_temp-diasize-handle.handle-value
     1983           .
     1984           if v-object-handle <> v-diasize-resize-button
     1985           then do:
     1986             assign
     1987               v-object-handle :col = v-object-handle :col + p-change-value
     1988               no-error .
     1989             if error-status :error
     1990             or error-status :get-message(1) <> ""
     1991             then do:
     1992               undo move_block, retry move_block .
     1993             end.
     1994           end.
     1995         end.
     1996       end.
     1997       else do:
     1998         for each buf_temp-diasize-handle
     1999         on error undo move_block, retry move_block
     2000         :
     2001           assign
     2002             v-object-handle = buf_temp-diasize-handle.handle-value
     2003           .
     2004           if v-object-handle <> v-diasize-resize-button
     2005           then do:
     2006             assign
     2007               v-object-handle :col = v-object-handle :col + p-change-value
     2008               no-error .
     2009             if error-status :error
     2010             or error-status :get-message(1) <> ""
     2011             then do:
     2012               undo move_block, retry move_block .
     2013             end.
     2014           end.
     2015         end.
     2016         for each buf_temp-browse-handle
     2017           where buf_temp-browse-handle.browse-type = 'width':u
     2018         on error undo move_block, retry move_block
     2019         :
     2020           assign
     2021             buf_temp-browse-handle.browse-handle :width
     2022               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2023             no-error .
     2024           if error-status :error
     2025           or error-status :get-message(1) <> ""
     2026           then do:
     2027             undo move_block, retry move_block .
     2028           end.
     2029         end.
     2030         assign
     2031           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2032           no-error .
     2033         if error-status :error
     2034         or error-status :get-message(1) <> ""
     2035         then do:
     2036           undo move_block, retry move_block.
     2037         end.
     2038         assign
     2039           frame DIALOG-1 :width = frame DIALOG-1 :width + p-change-value
     2040         no-error .
     2041         if error-status :error
     2042         or error-status :get-message(1) <> ""
     2043         then do:
     2044           undo move_block, retry move_block.
     2045         end.
     2046         if frame DIALOG-1 :scrollable = true
     2047         then do:
     2048           assign
     2049             frame DIALOG-1 :virtual-width = frame DIALOG-1 :virtual-width + p-change-value
     2050           no-error .
     2051           if error-status :error
     2052           or error-status :get-message(1) <> ""
     2053           then do:
     2054             undo move_block, retry move_block.
     2055           end.
     2056         end.
     2057       end.
     2058       if p-move-resize
     2059       then do:
     2060         run diasize_position-resize-button in this-procedure .
     2061       end.
     2062       if v-diasize-wndstore = true
     2063       then do:
     2064         if connected("ub") = true
     2065         then do:
     2066           define variable v-cntxt-db-num        as integer   no-undo .
     2067           define variable v-cntxt-userid        as character no-undo .
     2068           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2069                                             , OUTPUT v-cntxt-userid
     2070                                             ) .
     2071           run gbl/wndsizew.p
     2072             (input  v-cntxt-db-num
     2073             ,input  v-cntxt-userid
     2074             ,input  v-diasize-proc-name
     2075             ,input  'width':u
     2076             ,input  string(frame DIALOG-1 :width - v-diasize-orig-frame-width)
     2077             ) .
     2078         end.
     2079       end.
     2080     end.
     2081     assign
     2082       v-diasize-change-size = false
     2083     .
     2084   end procedure.
     2085   procedure diasize_set-width :
     2086     define input  parameter p-new-width  as decimal   no-undo .
     2087     define input  parameter p-move-resize as logical   no-undo .
     2088     do
     2089     on error undo, return error return-value
     2090     :
     2091       run diasize_change-width in this-procedure
     2092         (input  (p-new-width - frame DIALOG-1 :width)
     2093         ,input  p-move-resize
     2094         ) .
     2095     end.
     2096   end procedure.
     2097   procedure diasize_position-resize-button :
     2098     do with frame DIALOG-1
     2099     :
     2100       hide v-diasize-resize-button .
     2101       assign
     2102         v-diasize-resize-button :row = frame DIALOG-1 :height - v-diasize-resize-button :height
     2103                     - 1
     2104                     - (frame DIALOG-1 :border-bottom-pixels / session :pixels-per-row)
     2105         v-diasize-resize-button :col = frame DIALOG-1 :width - v-diasize-resize-button :width
     2106                     - 1
     2107                     - (frame DIALOG-1 :border-right-pixels / session :pixels-per-column)
     2108       .
     2109       view v-diasize-resize-button .
     2110     end.
     2111   end procedure.
     2112   on alt-right anywhere
     2113   do:
     2114     run diasize_change-width in this-procedure
     2115       (input 1
     2116       ,input true
     2117       ) .
     2118     return no-apply .
     2119   end.
     2120   on alt-left anywhere
     2121   do:
     2122     run diasize_change-width in this-procedure
     2123       (input -1
     2124       ,input true
     2125       ) .
     2126     return no-apply .
     2127   end.
     2128   on alt-down anywhere
     2129   do:
     2130     run diasize_change-height in this-procedure
     2131       (input 1
     2132       ,input true
     2133       ) .
     2134     return no-apply .
     2135   end.
     2136   on alt-up anywhere
     2137   do:
     2138     run diasize_change-height in this-procedure
     2139       (input -1
     2140       ,input true
     2141       ) .
     2142     return no-apply .
     2143   end.
     2144   on alt-enter of frame DIALOG-1
     2145   do:
     2146     run diasize_maximize in this-procedure
     2147       (input  ?
     2148       ).
     2149     return no-apply .
     2150   end.
     2151   procedure diasize_end-move :
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       define variable v-row-delta as decimal   no-undo .
     2156       define variable v-col-delta as decimal   no-undo .
     2157       define variable v-new-row as decimal   no-undo .
     2158       define variable v-new-col as decimal   no-undo .
     2159       assign
     2160         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2161         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2162       .
     2163       assign
     2164         v-row-delta = v-new-row - frame DIALOG-1 :height
     2165         v-col-delta = v-new-col - frame DIALOG-1 :width
     2166       .
     2167       run diasize_change-height in this-procedure
     2168         (input v-row-delta
     2169         ,input true
     2170         ) .
     2171       run diasize_change-width in this-procedure
     2172         (input v-col-delta
     2173         ,input true
     2174         ) .
     2175     end.
     2176   end procedure.
     2177   procedure diasize_maximize :
     2178     define input  parameter p-action as logical   no-undo .
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       if p-action = ?
     2183       then do:
     2184         if v-diasize-need-maximize = true
     2185         then do:
     2186           assign
     2187             p-action = true
     2188           .
     2189         end.
     2190         else do:
     2191           assign
     2192             p-action = false
     2193           .
     2194         end.
     2195       end.
     2196       if p-action = true
     2197       then do:
     2198         run diasize_change-height in this-procedure
     2199           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2200               - frame DIALOG-1 :height-chars
     2201           ,input true
     2202           ) .
     2203         run diasize_change-width in this-procedure
     2204           (input session :width-chars
     2205               - frame DIALOG-1 :width-chars
     2206           ,input true
     2207           ) .
     2208         assign
     2209           v-diasize-need-maximize = false
     2210         .
     2211       end.
     2212       else do:
     2213         run diasize_change-width in this-procedure
     2214           (input v-diasize-orig-frame-width
     2215               - frame DIALOG-1 :width-chars
     2216           ,input true
     2217           ) .
     2218         run diasize_change-height in this-procedure
     2219           (input v-diasize-orig-frame-height
     2220               - frame DIALOG-1 :height-chars
     2221           ,input true
     2222           ) .
     2223         assign
     2224           v-diasize-need-maximize = true
     2225         .
     2226       end.
     2227     end.
     2228   end procedure.
     2229   procedure diasize_restore-orig-size :
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       assign
     2234         v-diasize-current-frame-width  = frame DIALOG-1 :width
     2235         v-diasize-current-frame-height = frame DIALOG-1 :height
     2236       .
     2237       run diasize_set-height in this-procedure
     2238         (input  v-diasize-orig-frame-height
     2239         ,input  true
     2240         ) .
     2241       run diasize_set-width in this-procedure
     2242         (input  v-diasize-orig-frame-width
     2243         ,input  true
     2244         ) .
     2245     end.
     2246   end procedure.
     2247   procedure diasize_restore-current-size :
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       run diasize_set-height in this-procedure
     2252         (input  v-diasize-current-frame-height
     2253         ,input  true
     2254         ) .
     2255       run diasize_set-width in this-procedure
     2256         (input  v-diasize-current-frame-width
     2257         ,input  true
     2258         ) .
     2259     end.
     2260   end procedure.
     2261   procedure diasize_set-browse-handle :
     2262     define input  parameter p-browse-handle as handle   no-undo .
     2263     define buffer buf_temp-browse-handle for temp-browse-handle .
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       assign
     2268         v-diasize-browse-handle = p-browse-handle
     2269       .
     2270       for each buf_temp-browse-handle
     2271       on error undo, return error return-value
     2272       :
     2273         delete buf_temp-browse-handle .
     2274       end.
     2275     end.
     2276   end procedure.
     2277   procedure diasize_add_browse :
     2278     define input  parameter p-browse-type   as character no-undo .
     2279     define input  parameter p-browse-handle as handle    no-undo .
     2280     define buffer buf_temp-browse-handle for temp-browse-handle .
     2281     do
     2282     on error undo, return error return-value
     2283     :
     2284       assign
     2285         v-diasize-browse-number = v-diasize-browse-number + 1
     2286       .
     2287       create buf_temp-browse-handle .
     2288       assign
     2289         buf_temp-browse-handle.browse-type   = p-browse-type
     2290         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2291         buf_temp-browse-handle.browse-handle = p-browse-handle
     2292       .
     2293     end.
     2294   end procedure.
     2295   procedure diasize_init :
     2296     define variable v-default-value    as logical   no-undo .
     2297     define variable v-restore-saved    as logical   no-undo .
     2298     define variable v-resize-value-str as character no-undo .
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       do with frame DIALOG-1
     2303       :
     2304         assign
     2305           v-diasize-orig-frame-height = frame DIALOG-1 :height
     2306           v-diasize-orig-frame-width  = frame DIALOG-1 :width
     2307           v-diasize-browse-handle     = browse br-sel-fields :handle
     2308         .
     2309         create button v-diasize-resize-button
     2310         assign
     2311           parent        = frame DIALOG-1 :first-child
     2312           label         = "s"
     2313           height-pixels = 16
     2314           width-pixels  = 16
     2315           visible       = true
     2316           sensitive     = true
     2317           movable       = true
     2318           triggers:
     2319             on end-move persistent run diasize_end-move in this-procedure .
     2320           end triggers.
     2321         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2322         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2323         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2324         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2325         assign
     2326           v-diasize-wndmax = false
     2327         .
     2328         if connected("ub") = true
     2329         then do:
     2330           define variable v-cntxt-db-num        as integer   no-undo .
     2331           define variable v-cntxt-userid        as character no-undo .
     2332           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2333                                             , OUTPUT v-cntxt-userid
     2334                                             ) .
     2335           run gbl/wndpar_r.p
     2336             (input  v-cntxt-db-num
     2337             ,input  v-cntxt-userid
     2338             ,input  'wndmax':U
     2339             ,output v-diasize-wndmax
     2340             ,output v-default-value
     2341             ) .
     2342         end.
     2343         assign
     2344           v-diasize-wndstore = false
     2345         .
     2346         if connected("ub") = true
     2347         then do:
     2348           run gbl/wndpar_r.p
     2349             (input  v-cntxt-db-num
     2350             ,input  v-cntxt-userid
     2351             ,input  'wndstore':U
     2352             ,output v-diasize-wndstore
     2353             ,output v-default-value
     2354             ) .
     2355         end.
     2356         assign
     2357           v-diasize-proc-name = entry(1, program-name(2), '.')
     2358         .
     2359         if v-diasize-wndstore = true
     2360         then do:
     2361           assign
     2362             v-restore-saved = false
     2363           .
     2364           if connected("ub") = true
     2365           then do:
     2366             run gbl/wndsizer.p
     2367               (input  v-cntxt-db-num
     2368               ,input  v-cntxt-userid
     2369               ,input  v-diasize-proc-name
     2370               ,input  'height':u
     2371               ,output v-resize-value-str
     2372               ) .
     2373             if v-resize-value-str <> '':U
     2374             then do:
     2375               run diasize_change-height in this-procedure
     2376                 (input  integer(v-resize-value-str)
     2377                 ,input  true
     2378                 ) .
     2379               assign
     2380                 v-restore-saved = true
     2381               .
     2382             end.
     2383           end.
     2384           if connected("ub") = true
     2385           then do:
     2386             run gbl/wndsizer.p
     2387               (input  v-cntxt-db-num
     2388               ,input  v-cntxt-userid
     2389               ,input  v-diasize-proc-name
     2390               ,input  'width':u
     2391               ,output v-resize-value-str
     2392               ) .
     2393             if v-resize-value-str <> '':U
     2394             then do:
     2395               run diasize_change-width in this-procedure
     2396                 (input  integer(v-resize-value-str)
     2397                 ,input  true
     2398                 ) .
     2399               assign
     2400                 v-restore-saved = true
     2401               .
     2402             end.
     2403           end.
     2404           if v-restore-saved <> true
     2405           then do:
     2406             if v-diasize-wndmax = true
     2407             then do:
     2408               run diasize_maximize in this-procedure
     2409                 (input  true
     2410                 ) .
     2411             end.
     2412           end.
     2413         end.
     2414         else do:
     2415           if v-diasize-wndmax = true
     2416           then do:
     2417             run diasize_maximize in this-procedure
     2418               (input  true
     2419               ) .
     2420           end.
     2421         end.
     2422       end.
     2423     end.
     2424   end procedure.
     2425   procedure diasize_need-full-display :
     2426     define output parameter p-need-full-display as logical   no-undo .
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       assign
     2431         p-need-full-display = v-diasize-need-full-display
     2432       .
     2433       assign
     2434         v-diasize-need-full-display = false
     2435       .
     2436     end.
     2437   end procedure.
     2438   procedure get-context :
     2439      define output parameter p-db-num as integer          no-undo.
     2440      define output parameter p-user-id as character        no-undo.
     2441      define variable v-login               as character    no-undo.
     2442      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2443      define buffer buf_user-login  for ub.user-login .
     2444      do
     2445      on error undo, return error
     2446      :
     2447            FIND FIRST buf_sys-ctrl no-lock.
     2448            ASSIGN
     2449               v-login = USERID("ub")
     2450               p-db-num = buf_sys-ctrl.db-num
     2451            .
     2452            FIND FIRST buf_user-login
     2453                 WHERE buf_user-login.db-num = p-db-num
     2454                   AND buf_user-login.user-login = v-login
     2455                 no-lock
     2456                 no-error
     2457                 .
     2458            IF AVAILABLE buf_user-login
     2459            THEN DO:
     2460               assign
     2461                  p-user-id = buf_user-login.user-id
     2462               .
     2463            END.
     2464      end.
     2465   end procedure.
     2466       run diasize_init in this-procedure .
     2467   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2468   do:
     2469     br-sel-fields :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2470   end.
     2471     fill-in-3 = 'Доступные поля'.
     2472     fill-in-4 = 'Выбранные поля'.
     2473   MAIN-BLOCK:
     2474   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2475     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2476   if not avail temp-shop then
     2477   create temp-shop.
     2478   IF Kl <> 0 THEN DO:
     2479      FIND FIRST ubflt.filter WHERE ubflt.filter.Num-flt = Kl.
     2480      assign
     2481      select3 = ubflt.filter.Fields-sort
     2482      select3-label = entry(1, ubflt.filter.Fields-sort-rus, chr(4))
     2483      select3-codes = entry(2, ubflt.filter.Fields-sort-rus, chr(4))
     2484      select3-size = entry(1, ubflt.filter.Where-ysl, chr(4))
     2485      select3-size-min = entry(2, ubflt.filter.Where-ysl, chr(4))
     2486      select3-csize = entry(3, ubflt.filter.Where-ysl, chr(4))
     2487      select3-format = ubflt.filter.Where-ysl-rus
     2488      select3-type = ubflt.filter.lst-cend
     2489      .
     2490     assign
     2491     temp-shop.all-prt              = (lookup("all-prt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     2492     temp-shop.cd-bc-alt            = (lookup("cd-bc-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2493     temp-shop.cd-bc-base           = (lookup("cd-bc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     2494     temp-shop.cd-loc-alt           = (lookup("cd-loc-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     2495     temp-shop.cd-loc-base          = (lookup("cd-loc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     2496     temp-shop.cd-parts-all         = (lookup("cd-parts-all":U, entry(2, ubflt.filter.fields-sort-rus, chr(4))) > 0)
     2497     temp-shop.cd-parts-not-blank   = (lookup("cd-parts-not-blank":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2498     temp-shop.cd-parts-ser         = (lookup("cd-part-ser":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2499     temp-shop.cd-pb-alt            = (lookup("cd-pb-alt":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2500     temp-shop.cd-pb-base           = (lookup("cd-pb-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2501     temp-shop.cd-sc-base           = (lookup("cd-sc-base":U, entry(2, ubflt.filter.fields-sort-rus, chr(4)))  > 0)
     2502     .
     2503   END.
     2504   ELSE DO:
     2505      CREATE ubflt.filter.
     2506      assign
     2507      ubflt.filter.call-point = c-point
     2508      Kl = Num-flt
     2509      .
     2510      v-new = yes.
     2511      if p-obj-type = 'маг':U then do:
     2512       find first ub.shop no-lock where
     2513                  ub.shop.obj-code = p-obj-code no-error .
     2514       if avail ub.shop then do:
     2515         buffer-copy ub.shop to temp-shop.
     2516       end.
     2517      end.
     2518   END.
     2519   assign
     2520   jj             = 0
     2521   .
     2522   run fill-table in this-procedure no-error.
     2523   RUN MYenable.
     2524   apply "VALUE-CHANGED" to RS-tabs.
     2525   RUN PROC-N-L IN THIS-PROCEDURE.
     2526   WAIT-FOR GO OF FRAME DIALOG-1 focus br-fields.
     2527   if undo_ then undo,retry.
     2528   END.
     2529   RUN disable_UI.
     2530   PROCEDURE check-delim :
     2531   define input parameter p-delim as character no-undo.
     2532   END PROCEDURE.
     2533   PROCEDURE disable_UI :
     2534     HIDE FRAME DIALOG-1.
     2535   END PROCEDURE.
     2536   PROCEDURE enable-buttons :
     2537    if available t-f then do:
     2538       enable
     2539       btn-add
     2540       with frame DIALOG-1.
     2541     end.
     2542     if available sel_t-f then do:
     2543       enable
     2544       btn-remove
     2545       b-down b-up
     2546       with frame DIALOG-1.
     2547     end.
     2548   END PROCEDURE.
     2549   PROCEDURE enable_UI :
     2550     DISPLAY RS-tabs f-num-clmn f-delim S-delim f-length f-rec-num CB-scl-format
     2551             CB-pg-format FILL-IN-4 FILL-IN-3
     2552         WITH FRAME DIALOG-1.
     2553     IF AVAILABLE ubflt.Filter THEN
     2554       DISPLAY ubflt.Filter.Naim
     2555         WITH FRAME DIALOG-1.
     2556     ENABLE Btn_OK Btn_Cancel b-help RECT-1 ubflt.Filter.Naim RS-tabs f-delim S-delim
     2557            f-rec-num CB-scl-format CB-pg-format BR-sel-fields BR-fields
     2558         WITH FRAME DIALOG-1.
     2559     OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
     2560   END PROCEDURE.
     2561   PROCEDURE fill-table :
     2562   define variable v-label as character no-undo .
     2563   list-tabls_block:
     2564   do ii = 1 to num-entries(List-Buf):
     2565     assign
     2566     file-name = entry(ii, List-tabls).
     2567     list-dim_block:
     2568     do kk = jj + 1 to jj + int(entry(ii,List-dim)):
     2569       if file-name = "function":U OR index(entry(1, entry(kk, list-spr), '.'), "ATTR":u) > 0 then do:
     2570         create t-f.
     2571         assign
     2572         t-f.table-name = file-name
     2573         t-f.field-name = entry(kk, List-Fields)
     2574         t-f.field-type  = entry(2, entry(kk, list-spr), '.')
     2575         t-f.field-label = entry(kk,List-Labels)
     2576         t-f.field-clabel = t-f.field-label
     2577         t-f.field-spr = "":U
     2578         t-f.field-size = entry(kk,List-Size)
     2579         t-f.field-size-min = entry(kk,List-Size-min)
     2580         t-f.field-format = entry(kk,List-format, chr(4))
     2581         t-f.field-table-order = kk
     2582         .
     2583       end.
     2584       else do:
     2585         find first _File where _File-Name = file-name.
     2586         id = recid(_File).
     2587         do ll = 1 to num-entries(entry(kk, List-Fields),'*'):
     2588           find _Field no-lock where
     2589               _Field._Field-name =  entry(ll,entry(kk, List-Fields),'*')
     2590           and _Field._File-Recid = id
     2591           no-error .
     2592           if not available _Field then do:
     2593             message
     2594             vss-workfile vss-revision vss-description skip
     2595             "Неизвестное поле" entry(ll,entry(kk, List-Fields),'*') skip
     2596             "Таблица" entry(ii, List-Tabls)
     2597             view-as alert-box error .
     2598             next list-dim_block .
     2599           end.
     2600           find first t-f where
     2601                      t-f.table-name = _File._File-name
     2602                  AND t-f.field-name = entry(kk, List-Fields)
     2603           no-error.
     2604           if not available t-f then do:
     2605             create t-f.
     2606             assign
     2607             t-f.table-name = _File._File-name
     2608             t-f.field-name = entry(kk, List-Fields)
     2609             t-f.field-spr = entry(kk,List-spr)
     2610             t-f.field-size = entry(kk,List-Size)
     2611             t-f.field-size = entry(kk,List-Size-min)
     2612             t-f.field-format = entry(kk,List-format, chr(4))
     2613             t-f.field-table-order = kk
     2614             .
     2615           end.
     2616           if _field._label = ? then do:
     2617             assign
     2618             v-label = chr(63)
     2619             .
     2620           end.
     2621           else do:
     2622             if current-language = "english" or current-language = "romanian" then do:
     2623               if current-language = "english" then
     2624               v-label = (if entry(2,_field._desc,"`") <> ? then entry(2,_field._desc,"`") else chr(63)).
     2625               else
     2626               v-label = (if entry(3,_field._desc,"`") <> ? then entry(3,_field._desc,"`") else chr(63)).
     2627             end.
     2628             else do:
     2629               v-label = (if _field._label <> ? then _field._label else chr(63)).
     2630             end.
     2631           end.
     2632           assign
     2633           t-f.field-name-0 = t-f.field-name-0 +
     2634                              (if t-f.field-name-0 = "":U
     2635                               then "":U
     2636                               else '*':U) +
     2637                              entry(ll,entry(kk, List-Fields), '*':U)
     2638           t-f.field-label  = if entry(kk,List-Labels) <> ""
     2639                              then entry(kk,List-Labels)
     2640                              else t-f.field-label  +
     2641                              (if t-f.field-label = "":U
     2642                               then "":U
     2643                               else '*':U) +
     2644                               v-label
     2645           t-f.field-clabel = t-f.field-label
     2646           t-f.field-type   = t-f.field-type  +
     2647                              (if t-f.field-type = "":U
     2648                               then "":U
     2649                               else '*':U) +
     2650                               _field._data-type
     2651           t-f.field-format = entry(kk, list-format, chr(4))
     2652           .
     2653         end.
     2654       end.
     2655       if avail t-f then do:
     2656         assign
     2657         t-f.field-order =  lookup(t-f.table-name + ".":U + t-f.field-name, select3)
     2658         t-f.field-csize = if v-new
     2659                           then t-f.field-size
     2660                           else  (if t-f.field-order > 0
     2661                                 then entry(t-f.field-order, entry(3, ubflt.filter.where-ysl, chr(4)))
     2662                                 else t-f.field-size)
     2663         v-num-clmn = v-num-clmn +  (if   t-f.field-order > 0 then 1 else 0)
     2664         v-length = v-length + (if   t-f.field-order > 0
     2665                                then integer(entry(t-f.field-order, entry(3, ubflt.filter.where-ysl, chr(4))))
     2666                                else 0)
     2667         v-delim = if v-new then chr(int(entry(1, string(asc(chr(44))) + ',1,2,3,4,5,6,7,0,59':U))) else chr(int(entry(3, ubflt.filter.fields-sort-rus, chr(4))))
     2668         v-rec-num = if v-new then 50000 else int(entry(4, ubflt.filter.fields-sort-rus, chr(4)))
     2669         v-scl-format = (IF v-new OR NUM-ENTRIES(ubflt.filter.fields-sort-rus, chr(4)) < 5
     2670                   THEN "99999":U
     2671                   ELSE ENTRY(5, ubflt.filter.fields-sort-rus, chr(4)))
     2672         v-pg-format = (IF v-new OR NUM-ENTRIES(ubflt.filter.fields-sort-rus, chr(4)) < 6
     2673                   THEN "99999":U
     2674                   ELSE ENTRY(6, ubflt.filter.fields-sort-rus, chr(4)))
     2675         .
     2676       end.
     2677     end.
     2678     jj = jj + int(entry(ii,List-dim)).
     2679   end.
     2680   END PROCEDURE.
     2681   PROCEDURE MyEnable :
     2682   define variable v-delim-str as character no-undo.
     2683   DEFINE VARIABLE v-cb-scl-format AS CHARACTER NO-UNDO.
     2684   DEFINE VARIABLE v-cb-pg-format AS CHARACTER NO-UNDO.
     2685   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2686   define variable varscales-pref as character no-undo .
     2687   define variable varpgscales-pref as character no-undo .
     2688   define variable varscales-pref-type16 as character no-undo.
     2689   varscales-pref  = ?.
     2690   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2691     (input  'sclspref':u
     2692     ,input  '':u
     2693     ,input  '':u
     2694     ,input  0
     2695     ,input  '':u
     2696     ,input  '':u
     2697     ,input  '':u
     2698     ,input  no
     2699     ,output varscales-pref
     2700     ,output varscales-pref-type16
     2701     ) no-error .
     2702   if varscales-pref = ? then do:
     2703     assign
     2704     varscales-pref = '21,23,25':U.
     2705   end.
     2706   define variable varpgscales-pref-type16 as character no-undo.
     2707   varpgscales-pref  = ?.
     2708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2709     (input  'scpgpref':u
     2710     ,input  '':u
     2711     ,input  '':u
     2712     ,input  0
     2713     ,input  '':u
     2714     ,input  '':u
     2715     ,input  '':u
     2716     ,input  no
     2717     ,output varpgscales-pref
     2718     ,output varpgscales-pref-type16
     2719     ) no-error .
     2720   if varpgscales-pref = ? then do:
     2721     assign
     2722     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     2723   end.
     2724   ASSIGN
     2725   v-cb-scl-format = ">>>>9":U + chr(44) +
     2726                     "99999":U .
     2727   DO ii = 1 TO NUM-ENTRIES(varscales-pref):
     2728      ASSIGN
     2729      v-cb-scl-format = v-cb-scl-format + chr(44) + ENTRY(ii, varscales-pref) + "99999":U.
     2730   END.
     2731   ASSIGN
     2732   cb-scl-format:LIST-ITEMS IN FRAME DIALOG-1  = v-cb-scl-format
     2733   cb-scl-format = v-scl-format
     2734   .
     2735   ASSIGN
     2736   v-cb-pg-format = ">>>>9":U + chr(44) +
     2737                     "99999":U .
     2738   DO ii = 1 TO NUM-ENTRIES(varpgscales-pref):
     2739      ASSIGN
     2740      v-cb-pg-format = v-cb-pg-format + chr(44) + substring(ENTRY(ii, varpgscales-pref), 1, 2) + "99999":U.
     2741   END.
     2742   ASSIGN
     2743   cb-pg-format:LIST-ITEMS IN FRAME DIALOG-1  = v-cb-pg-format
     2744   cb-pg-format = v-pg-format
     2745   .
     2746   do ii = 1 to num-entries(list-tabls):
     2747   assign
     2748   v-rb = v-rb +
     2749              (if v-rb = "":U then "":U else chr(44)) +
     2750               entry(ii, list-buf) + chr(44) + entry(ii, list-tabls) .
     2751   .
     2752   end.
     2753   assign rs-tabs:radio-buttons in frame DIALOG-1 = v-rb.
     2754   if num-entries(list-tabls) > 1 then do:
     2755   display
     2756    RS-tabs
     2757   with frame DIALOG-1.
     2758   Enable
     2759   Rs-tabs
     2760   with frame DIALOG-1.
     2761   end.
     2762   else do:
     2763       assign
     2764       rs-tabs = list-tabls.
     2765       hide
     2766       rs-tabs in frame DIALOG-1.
     2767   end.
     2768   assign s-delim:list-items in frame DIALOG-1 = string(asc(chr(44))) + ',1,2,3,4,5,6,7,0,59':U.
     2769   assign
     2770   s-delim = if v-delim = '':U then '0' else string(asc(v-delim))
     2771   .
     2772    DISPLAY
     2773    FILL-IN-3
     2774    FILL-IN-4
     2775    s-delim
     2776     v-rec-num @ f-rec-num
     2777    CB-SCL-FORMAT
     2778    CB-pg-FORMAT
     2779    WITH FRAME DIALOG-1 .
     2780     IF AVAILABLE ubflt.filter THEN
     2781       DISPLAY ubflt.filter.Naim
     2782         WITH FRAME DIALOG-1.
     2783     hide b-down b-up
     2784     in frame DIALOG-1.
     2785     ENABLE
     2786     Btn_OK
     2787     RECT-1
     2788     Btn_Cancel
     2789     b-help
     2790     ubflt.filter.Naim
     2791     BR-fields
     2792     BR-sel-fields
     2793     S-delim
     2794     btn-codes
     2795     f-rec-num
     2796     CB-SCL-FORMAT
     2797     cb-pg-format
     2798     WITH FRAME DIALOG-1 .
     2799     OPEN QUERY BR-sel-fields FOR EACH sel_t-f no-lock where sel_t-f.field-order > 0 use-index iorder.
     2800     APPLY "Value-changed" to BR-sel-fields.
     2801     if Rs-tabs:visible in frame DIALOG-1 then
     2802     APPLY "Value-changed" to rs-tabs.
     2803     APPLY "Value-changed" to s-delim.
     2804     run enable-buttons in this-procedure.
     2805   END PROCEDURE.
     2806   PROCEDURE PROC-N-L :
     2807   display
     2808   string(v-num-clmn, ">>9") @ f-num-clmn
     2809   string(v-length, ">>>>9") @ f-length
     2810   (if v-delim = '':u then 'нет' else v-delim) @ f-delim
     2811   WITH FRAME DIALOG-1.
     2812   END PROCEDURE.
