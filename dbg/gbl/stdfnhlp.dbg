     2981           p-help = 'Возвращает отцентрированную строку.'                               + chr(10) + chr(10) +
     2982                    "ФОРМАТ ВЫЗОВА:"                                                    + chr(10) +
     2983                    "ShiftRightSymbol RETURNS CHARACTER ( INPUT InString AS CHARACTER"  + chr(10) +
     2984                    "                                   , INPUT Symbol   AS CHARACTER"  + chr(10) +
     2985                    "                                   , INPUT Lenght   AS INTEGER"    + chr(10) + chr(10) +
     2986                    "                                   ) ."                            + chr(10) + chr(10) +
     2987                    "ПРИМЕР:"                                                           + chr(10) + chr(10) +
     2988                    '/* **************************************************** *\' + chr(10) +
     2989                    ' *                                                      *'  + chr(10) +
     2990                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
