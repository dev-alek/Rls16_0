      831       end.
      832       when 'Stamp57'
      833       then do:
      834         assign
      835           p-help = "Заголовок отчета. Возвращает строку, содержащую дату и "    +
      836                    "время печати и номер страницы длиной 57 символов."          + chr(10)     +
      837                    "Если дата и/или время не заданы, то берутся текущие."       + chr(10)     + chr(10) +
      838                    "ФОРМАТ ВЫЗОВА:"                                             + chr(10)     +
      839                    "Stamp57 RETURNS CHARACTER ( INPUT print-date AS DATE"       + chr(10)     +
      840                    "                          , INPUT print-time AS INTEGER"    + chr(10)     +
      841                    "                          , INPUT curr-page  AS INTEGER"    + chr(10)     + chr(10) +
      842                    "                           ) ."                             + chr(10)     + chr(10) +
      843                    "ПРИМЕР:"                                                    + chr(10)     + chr(10) +
      844                    '/* **************************************************** *\' + chr(10) +
      845                    ' *                                                      *'  + chr(10) +
      846                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      847                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      848                                                                            '*'  + chr(10) +
      849                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      850                    ' *                                                      *'  + chr(10) +
      851                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      852                    ' *                                                      *'  + chr(10) +
      853                    '\* **************************************************** */' + chr(10) + chr(10) +
      854                    "~&SCOPED-DEFINE f-l Stamp57"                                + chr(10)     + chr(10) +
      855                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                             + chr(10)     + chr(10) +
      856                    "DEFINE VARIABLE t_curr-date AS DATE    NO-UNDO ."           + chr(10)     +
      857                    "DEFINE VARIABLE j_curr-time AS INTEGER NO-UNDO ."           + chr(10)     +
      858                    "DEFINE VARIABLE j_curr-page AS INTEGER NO-UNDO ."           + chr(10)     + chr(10) +
      859                    "ASSIGN"                                                     + chr(10)     +
      860                    "  t_curr-date = TODAY"                                      + chr(10)     +
      861                    "  j_curr-time = TIME + 120"                                 + chr(10)     +
      862                    "  j_curr-page = 2"                                          + chr(10)     + chr(10) +
      863                    "."                                                          + chr(10)     + chr(10) +
      864                    "IF t_curr-date <> TODAY"                                    + chr(10)     +
      865                    "THEN DO:"                                                   + chr(10)     +
      866                    "  ASSIGN"                                                   + chr(10)     +
      867                    "    t_curr-date = TODAY"                                    + chr(10)     +
      868                    "    j_curr-time = TIME + 120"                               + chr(10)     +
      869                    "  ."                                                        + chr(10)     +
      870                    "END."                                                       + chr(10)     + chr(10) +
      871                    'MESSAGE'                                                    + chr(10)     +
      872                    '  ~'"~' + Stamp57( ?,           ?,           ?           ) + ~'"~' SKIP( 0 )' + chr(10) +
      873                    '  ~'"~' + Stamp57( t_curr-date, j_curr-time, j_curr-page ) + ~'"~''           + chr(10) +
      874                    'VIEW-AS ALERT-BOX .'                                        + chr(10)
      875         .
      876       end.
      877       when 'Round-M'
      878       then do:
      879         assign
      880           p-help = "Возвращает округленное действительное число."                   + chr(10) +
      881                    "Первый параметр - число, которое нужно округлить."              + chr(10) +
      882                    "Второй параметр - порядок округления."                          + chr(10) +
      883                    "Если порядок округления отрицательный, то округляются "         +
      884                    "цифры слева от десятичной точки, т.е.:"                         + chr(10) +
      885                    "  Round-M( 123.0, -1 ) = 120.0, Round-M( 123.0, -2 ) = 100.0."  + chr(10) + chr(10) +
      886                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10) +
      887                    "Round-M RETURNS DECIMAL ( INPUT decimal-number AS DECIMAL"      + chr(10) +
      888                    "                        , INPUM round-order    AS INTEGER"      + chr(10) +
      889                    "                        ) ."                                    + chr(10) + chr(10) +
      890                    "ПРИМЕР:"                                                        + chr(10) + chr(10) +
      891                    '/* **************************************************** *\' + chr(10) +
      892                    ' *                                                      *'  + chr(10) +
      893                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      894                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      895                                                                            '*'  + chr(10) +
      896                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      897                    ' *                                                      *'  + chr(10) +
      898                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      899                    ' *                                                      *'  + chr(10) +
      900                    '\* **************************************************** */' + chr(10) + chr(10) +
      901                    "~&SCOPED-DEFINE f-l Round-M"                                    + chr(10) + chr(10) +
      902                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10) + chr(10) +
      903                    "DEFINE VARIABLE d_num AS DECIMAL NO-UNDO INITIAL -1234.98765 ." + chr(10) + chr(10) +
      904                    'MESSAGE'                                                        + chr(10) +
