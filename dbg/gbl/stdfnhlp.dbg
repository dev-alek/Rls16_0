      927                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      928                    ' *                                                      *'  + chr(10) +
      929                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      930                    ' *                                                      *'  + chr(10) +
