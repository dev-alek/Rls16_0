     1023       when 'PutInt'
     1024       then do:
     1025         assign
     1026           p-help = 'Конвертация целого числа в строку с подавлением ведущих нулей ' +
     1027                    'и разбивкой на разряды.'                                        + chr(10) + chr(10) +
     1028                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10) +
     1029                    "PutInt RETURNS CHARACTER ( INPUT INTEGER ) ."                   + chr(10) + chr(10) +
     1030                    "ПРИМЕР:"                                                        + chr(10) + chr(10) +
     1031                    '/* **************************************************** *\' + chr(10) +
     1032                    ' *                                                      *'  + chr(10) +
     1033                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1034                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1035                                                                            '*'  + chr(10) +
     1036                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1037                    ' *                                                      *'  + chr(10) +
     1038                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1039                    ' *                                                      *'  + chr(10) +
     1040                    '\* **************************************************** */' + chr(10) + chr(10) +
     1041                    "~&SCOPED-DEFINE f-l PutInt"                                     + chr(10) + chr(10) +
     1042                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10) + chr(10) +
     1043                    'DEFINE VARIABLE j_num AS INTEGER NO-UNDO INITIAL 12345 .'       + chr(10) + chr(10) +
     1044                    'MESSAGE'                                                        + chr(10) +
     1045                    '          j_num   SKIP( 0 )'                                    + chr(10) +
     1046                    '  PutInt( j_num ) SKIP( 0 )'                                    + chr(10) +
     1047                    'VIEW-AS ALERT-BOX .'                                            + chr(10)
     1048         .
     1049       end.
     1050       when 'PutSum'
     1051       then do:
     1052         assign
     1053           p-help = 'Конвертация действительного числа в строку с подавлением ведущих ' +
     1054                    'нулей и разбивкой на разряды.'                                     + chr(10) + chr(10) +
     1055                    "ФОРМАТ ВЫЗОВА:"                                                    + chr(10) +
     1056                    "PutSum RETURNS CHARACTER ( INPUT INTEGER ) ."                      + chr(10) + chr(10) +
     1057                    "ПРИМЕР:"                                                           + chr(10) + chr(10) +
     1058                    '/* **************************************************** *\' + chr(10) +
     1059                    ' *                                                      *'  + chr(10) +
     1060                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1061                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1062                                                                            '*'  + chr(10) +
     1063                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1064                    ' *                                                      *'  + chr(10) +
     1065                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1066                    ' *                                                      *'  + chr(10) +
     1067                    '\* **************************************************** */' + chr(10) + chr(10) +
     1068                    "~&SCOPED-DEFINE f-l PutSum"                                        + chr(10) + chr(10) +
     1069                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                    + chr(10) + chr(10) +
     1070                    "DEFINE VARIABLE d_num AS DECIMAL NO-UNDO INITIAL -12345678.967 ."  + chr(10) + chr(10) +
     1071                    'MESSAGE'                                                           + chr(10) +
     1072                    '          d_num   SKIP( 0 )'                                       + chr(10) +
     1073                    '  PutSum( d_num ) SKIP( 0 )'                                       + chr(10) +
     1074                    'VIEW-AS ALERT-BOX .'                                               + chr(10)
     1075         .
     1076       end.
     1077       when 'PutAcc'
     1078       then do:
     1079         assign
     1080           p-help = 'Конвертация бухгалтерского счета и субсчета в строку.'               + chr(10) + chr(10) +
     1081                    "ФОРМАТ ВЫЗОВА:"                                                      + chr(10) +
     1082                    "PutAcc RETURNS CHARACTER ( INPUT i-num AS INTEGER"                   + chr(10) + chr(10) +
     1083                    "                         , INPUT i-sub AS INTEGER"                   + chr(10) + chr(10) +
     1084                    "                         ) ."                                        + chr(10) + chr(10) +
     1085                    "ПРИМЕР:"                                                             + chr(10) + chr(10) +
     1086                    '/* **************************************************** *\' + chr(10) +
     1087                    ' *                                                      *'  + chr(10) +
     1088                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1089                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1090                                                                            '*'  + chr(10) +
     1091                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1092                    ' *                                                      *'  + chr(10) +
     1093                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1094                    ' *                                                      *'  + chr(10) +
     1095                    '\* **************************************************** */' + chr(10) + chr(10) +
     1096                    "~&SCOPED-DEFINE f-l PutAcc"                                          + chr(10) + chr(10) +
     1097                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                      + chr(10) + chr(10) +
     1098                    'MESSAGE'                                                             + chr(10) +
     1099                    '  PutAcc( 42, 0 ) + ", " + PutAcc( 60, 2 )'                          + chr(10) +
     1100                    'VIEW-AS ALERT-BOX .'                                                 + chr(10) +
     1101                    "ПРИМЕЧАНИЕ:"                                                         + chr(10) +
     1102                    'По функции "верхнего" уровня PutAcc "включается" ее функция "нижнего" уровня '     + chr(10) +
     1103                    'Int2Char (которая может "включаться" и самостоятельно).'             + chr(10)
     1104         .
     1105       end.
     1106       when 'Rec2Char'
     1107       then do:
     1108         assign
     1109           p-help = "Конвертация RECID'а записи в строку."                  + chr(10) + chr(10) +
     1110                    "ФОРМАТ ВЫЗОВА:"                                        + chr(10) +
     1111                    "Rec2Char RETURNS CHARACTER ( INPUT RECID ) ."          + chr(10) + chr(10) +
     1112                    "ПРИМЕР:"                                               + chr(10) + chr(10) +
     1113                    '/* **************************************************** *\' + chr(10) +
     1114                    ' *                                                      *'  + chr(10) +
     1115                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1116                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1117                                                                            '*'  + chr(10) +
     1118                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1119                    ' *                                                      *'  + chr(10) +
     1120                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1121                    ' *                                                      *'  + chr(10) +
     1122                    '\* **************************************************** */' + chr(10) + chr(10) +
     1123                    "~&SCOPED-DEFINE f-l Rec2Char"                          + chr(10) + chr(10) +
     1124                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                        + chr(10) + chr(10) +
     1125                    'FIND LAST ub.bgh-doc NO-LOCK NO-ERROR .'               + chr(10) +
     1126                    'IF AVAILABLE ub.bgh-doc'                               + chr(10) +
     1127                    'THEN DO:'                                              + chr(10) +
     1128                    '  MESSAGE'                                             + chr(10) +
     1129                    '    Rec2Char( RECID( ub.bgh-doc ) )'                   + chr(10) +
     1130                    '  VIEW-AS ALERT-BOX .'                                 + chr(10) +
     1131                    'END.'                                                  + chr(10) +
     1132                    'ELSE DO:'                                              + chr(10) +
     1133                    '  MESSAGE'                                             + chr(10) +
     1134                    '    "Запись ~~"Бухгалтерские проводки~~" не найдена!"' + chr(10) +
     1135                    '  VIEW-AS ALERT-BOX .'                                 + chr(10) +
     1136                    'END.'                                                  + chr(10)
     1137         .
     1138       end.
     1139       when 'Roubles' or
     1140       when 'Copecks'
     1141       then do:
     1142         assign
     1143           p-help = 'Слово ' + ( if p-name = "Roubles" then '"рубли"' else '"копейки"' )         +
     1144                    ' в сумме.'                                                      + chr(10) + chr(10) +
     1145                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10) +
     1146                    "Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) ."         + chr(10) + chr(10) +
     1147                    "ПРИМЕР:"                                                        + chr(10) + chr(10) +
     1148                    '/* **************************************************** *\' + chr(10) +
     1149                    ' *                                                      *'  + chr(10) +
     1150                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1151                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1152                                                                            '*'  + chr(10) +
     1153                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1154                    ' *                                                      *'  + chr(10) +
     1155                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1156                    ' *                                                      *'  + chr(10) +
     1157                    '\* **************************************************** */' + chr(10) + chr(10) +
     1158                    "~&SCOPED-DEFINE f-l Roubles,Copecks,get-dec"                    + chr(10) + chr(10) +
     1159                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10) + chr(10) +
     1160                    "DEFINE VARIABLE d_num1 AS DECIMAL NO-UNDO INITIAL 789.65 ."     + chr(10) +
     1161                    "DEFINE VARIABLE d_num2 AS DECIMAL NO-UNDO INITIAL 562.41 ."     + chr(10) +
     1162                    "DEFINE VARIABLE d_num3 AS DECIMAL NO-UNDO INITIAL 341.23 ."     + chr(10) + chr(10) +
     1163                    'MESSAGE'                                                        + chr(10) +
     1164                    '  d_num1 "-" TRUNCATE( d_num1, 0 ) Roubles( d_num1 )'           + chr(10) +
     1165                    '             get-dec(  d_num1    ) Copecks( d_num1 ) SKIP( 0 )' + chr(10) +
     1166                    '  d_num2 "-" TRUNCATE( d_num2, 0 ) Roubles( d_num2 )'           + chr(10) +
     1167                    '             get-dec(  d_num2    ) Copecks( d_num2 ) SKIP( 0 )' + chr(10) +
     1168                    '  d_num3 "-" TRUNCATE( d_num3, 0 ) Roubles( d_num3 )'           + chr(10) +
     1169                    '             get-dec(  d_num3    ) Copecks( d_num3 ) SKIP( 0 )' + chr(10) +
     1170                    'VIEW-AS ALERT-BOX .'                                            + chr(10)
     1171         .
     1172       end.
     1173       when 'get-decade-word'
     1174       then do:
     1175         assign
     1176           p-help = "Возвращает разряд числа прописью при разбивке на триады (вспомогательная функция " + chr(10) +
     1177                    'для функции "число прописью").'                                      + chr(10) + chr(10) +
     1178                    "ФОРМАТ ВЫЗОВА:"                                                      + chr(10) +
     1179                    "get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER"          + chr(10) +
     1180                    "                                  , INPUT i-num AS INTEGER"          + chr(10) +
     1181                    "                                  ) ."                               + chr(10) + chr(10) +
     1182                    "ПАРАМЕТРЫ:"                                                          + chr(10) +
     1183                    "i-dec - цифра, означающая разряд цифры:"                             + chr(10) +
     1184                    "        1 - единицы (от 0 до 9), третья цифра в триаде, в десятках - не 1;"        + chr(10) +
     1185                    "        2 - единицы (от 10 до 19), третья цифра в триаде, в десятках - 1;"         + chr(10) +
     1186                    "        3 - десятки (от 10 до 90), вторая цифра в триаде;"           + chr(10) +
     1187                    "        4 - сотни   (от 100 до 900), первая цифра в триаде;"         + chr(10) +
     1188                    "i-num - цифра (от 0 до 9), которая будет возвращена прописью."       + chr(10) + chr(10) +
     1189                    "ПРИМЕР:"                                                             + chr(10) + chr(10) +
     1190                    '/* **************************************************** *\' + chr(10) +
     1191                    ' *                                                      *'  + chr(10) +
     1192                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1193                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1194                                                                            '*'  + chr(10) +
     1195                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1196                    ' *                                                      *'  + chr(10) +
     1197                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1198                    ' *                                                      *'  + chr(10) +
     1199                    '\* **************************************************** */' + chr(10) + chr(10) +
     1200                    "~&SCOPED-DEFINE f-l Word-Sum"                                        + chr(10) + chr(10) +
     1201                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                      + chr(10) + chr(10) +
     1202                    'DEFINE VARIABLE v-list  AS CHARACTER NO-UNDO INITIAL "008,019,256":U .'            + chr(10) +
     1203                    'DEFINE VARIABLE v-triad AS CHARACTER NO-UNDO .'                      + chr(10) +
     1204                    'DEFINE VARIABLE v-word  AS CHARACTER NO-UNDO .'                      + chr(10) +
     1205                    'DEFINE VARIABLE jj      AS INTEGER   NO-UNDO .'                      + chr(10) +
     1206                    'DEFINE VARIABLE j1      AS INTEGER   NO-UNDO .'                      + chr(10) +
     1207                    'DEFINE VARIABLE j-digit AS INTEGER   NO-UNDO .'                      + chr(10) +
     1208                    'DEFINE VARIABLE j-order AS INTEGER   NO-UNDO .'                      + chr(10) + chr(10) +
     1209                    'DO jj = 1 TO NUM-ENTRIES( v-list ) :'                                + chr(10) +
     1210                    '  ASSIGN'                                                            + chr(10) +
     1211                    '    v-triad = ENTRY( jj, v-list )'                                   + chr(10) +
     1212                    '  .'                                                                 + chr(10) +
     1213                    '  REPEAT j1 = 1 TO 3 :'                                              + chr(10) +
     1214                    '    ASSIGN'                                                          + chr(10) +
     1215                    '      j-digit = INTEGER( SUBSTRING( v-triad, j1, 1 ) )'              + chr(10) +
     1216                    '      j-order = ( 5 - j1 ) -'                                        + chr(10) +
     1217                    '      ( IF j1 = 3 AND SUBSTRING( v-triad, 2, 1 ) <> "1" THEN 1 ELSE 0 )'           + chr(10) +
     1218                    '      v-word  = get-decade-word( j-order, j-digit )'                 + chr(10) +
     1219                    '    .'                                                               + chr(10) +
     1220                    '    DISPLAY'                                                         + chr(10) +
     1221                    '      jj      FORMAT ">>9.":U'                                       + chr(10) +
     1222                    '      v-triad FORMAT "x(3)":U'                                       + chr(10) +
     1223                    '      j-digit FORMAT "9":U'                                          + chr(10) +
     1224                    '      j-order FORMAT "9":U'                                          + chr(10) +
     1225                    '      v-word  FORMAT "x(30)":U'                                      + chr(10) +
     1226                    '    WITH NO-LABELS NO-UNDERLINE NO-BOX .'                            + chr(10) +
     1227                    '  END.'                                                              + chr(10) +
     1228                    'END.'                                                                + chr(10) + chr(10) +
     1229                    "ПРИМЕЧАНИЕ:"                                                         + chr(10) +
     1230                    'Обратите внимание, что включается функция "Word-Sum" - функция "верхнего" уровня,' + chr(10) +
     1231                    '- по которой "включаются" все функции ее "нижнего" уровня, в том числе и функция ' + chr(10) +
     1232                    'get-decade-word.'                                                    + chr(10)
     1233         .
     1234       end.
     1235       when 'get-dec-word-eng'
     1236       then do:
     1237         assign
     1238           p-help = "Возвращает разряд числа прописью при разбивке на триады (вспомогательная функция " + chr(10) +
     1239                    'для функции "число прописью").'                                      + chr(10) + chr(10) +
     1240                    "ФОРМАТ ВЫЗОВА:"                                                      + chr(10) +
     1241                    "get-dec-word-eng RETURNS CHARACTER ( INPUT i-dec AS INTEGER"         + chr(10) +
     1242                    "                                   , INPUT i-num AS INTEGER"         + chr(10) +
     1243                    "                                   ) ."                              + chr(10) + chr(10) +
     1244                    "ПАРАМЕТРЫ:"                                                          + chr(10) +
     1245                    "i-dec - цифра, означающая разряд цифры:"                             + chr(10) +
     1246                    "        1 - единицы (от 0 до 9), третья цифра в триаде, в десятках - не 1;"        + chr(10) +
     1247                    "        2 - единицы (от 10 до 19), третья цифра в триаде, в десятках - 1;"         + chr(10) +
     1248                    "        3 - десятки (от 10 до 90), вторая цифра в триаде;"           + chr(10) +
     1249                    "        4 - сотни   (от 100 до 900), первая цифра в триаде;"         + chr(10) +
     1250                    "i-num - цифра (от 0 до 9), которая будет возвращена прописью."       + chr(10) + chr(10) +
     1251                    "ПРИМЕР:"                                                             + chr(10) + chr(10) +
     1252                    '/* **************************************************** *\' + chr(10) +
     1253                    ' *                                                      *'  + chr(10) +
     1254                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1255                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1256                                                                            '*'  + chr(10) +
     1257                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1258                    ' *                                                      *'  + chr(10) +
     1259                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1260                    ' *                                                      *'  + chr(10) +
     1261                    '\* **************************************************** */' + chr(10) + chr(10) +
     1262                    "~&SCOPED-DEFINE f-l Word-Sum-Eng"                                    + chr(10) + chr(10) +
     1263                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                      + chr(10) + chr(10) +
     1264                    'DEFINE VARIABLE v-list  AS CHARACTER NO-UNDO INITIAL "008,019,256":U .'            + chr(10) +
     1265                    'DEFINE VARIABLE v-triad AS CHARACTER NO-UNDO .'                      + chr(10) +
     1266                    'DEFINE VARIABLE v-word  AS CHARACTER NO-UNDO .'                      + chr(10) +
     1267                    'DEFINE VARIABLE jj      AS INTEGER   NO-UNDO .'                      + chr(10) +
     1268                    'DEFINE VARIABLE j1      AS INTEGER   NO-UNDO .'                      + chr(10) +
     1269                    'DEFINE VARIABLE j-digit AS INTEGER   NO-UNDO .'                      + chr(10) +
     1270                    'DEFINE VARIABLE j-order AS INTEGER   NO-UNDO .'                      + chr(10) + chr(10) +
     1271                    'DO jj = 1 TO NUM-ENTRIES( v-list ) :'                                + chr(10) +
     1272                    '  ASSIGN'                                                            + chr(10) +
     1273                    '    v-triad = ENTRY( jj, v-list )'                                   + chr(10) +
     1274                    '  .'                                                                 + chr(10) +
     1275                    '  REPEAT j1 = 1 TO 3 :'                                              + chr(10) +
     1276                    '    ASSIGN'                                                          + chr(10) +
     1277                    '      j-digit = INTEGER( SUBSTRING( v-triad, j1, 1 ) )'              + chr(10) +
     1278                    '      j-order = ( 5 - j1 ) -'                                        + chr(10) +
     1279                    '                ( IF j1 = 3 AND SUBSTRING( v-triad, 2, 1 ) <> "1" THEN 1 ELSE 0 )' + chr(10) +
     1280                    '      v-word  = get-dec-word-eng( j-order, j-digit )'                + chr(10) +
     1281                    '    .'                                                               + chr(10) +
     1282                    '    DISPLAY'                                                         + chr(10) +
     1283                    '      jj      FORMAT ">>9.":U'                                       + chr(10) +
     1284                    '      v-triad FORMAT "x(3)":U'                                       + chr(10) +
     1285                    '      j-digit FORMAT "9":U'                                          + chr(10) +
     1286                    '      j-order FORMAT "9":U'                                          + chr(10) +
     1287                    '      v-word  FORMAT "x(30)":U'                                      + chr(10) +
     1288                    '    WITH NO-LABELS NO-UNDERLINE NO-BOX .'                            + chr(10) +
     1289                    '  END.'                                                              + chr(10) +
     1290                    'END.'                                                                + chr(10) + chr(10) +
     1291                    "ПРИМЕЧАНИЕ:"                                                         + chr(10) +
     1292                    'Обратите внимание, что включается функция "Word-Sum-Eng" - функция "верхнего" '    + chr(10) +
     1293                    'уровня, - по которой "включаются" все функции ее "нижнего" уровня, в том числе и ' + chr(10) +
     1294                    'функция get-dec-word-eng.'                                                         + chr(10)
     1295         .
     1296       end.
     1297       when 'Word-Sum'
     1298       then do:
     1299         assign
     1300           p-help = 'Возвращает сумму прописью от целой части действительного числа.' + chr(10) + chr(10) +
     1301                    "ФОРМАТ ВЫЗОВА:"                                                  + chr(10) +
     1302                    "Word-Sum RETURNS CHARACTER ( INPUT DECIMAL ) ."                  + chr(10) + chr(10) +
     1303                    "ПРИМЕР:"                                                         + chr(10) + chr(10) +
     1304                    '/* **************************************************** *\' + chr(10) +
     1305                    ' *                                                      *'  + chr(10) +
     1306                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1307                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1308                                                                            '*'  + chr(10) +
     1309                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1310                    ' *                                                      *'  + chr(10) +
     1311                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
