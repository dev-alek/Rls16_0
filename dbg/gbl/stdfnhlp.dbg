     1744       when 'addn-list'
     1745       then do:
     1746         assign
     1747           p-help = 'Добавить новый элемент в список на указанную позицию. Возвращает "новый" список (с добавленной '  +
     1748                    'записью).'                                                            + chr(10) + chr(10) +
     1749                    "ФОРМАТ ВЫЗОВА:"                                                       + chr(10) +
     1750                    "addn-list RETURNS CHARACTER ( INPUT i-list      AS CHARACTER"         + chr(10) +
     1751                    "                            , INPUT i-item      AS CHARACTER"         + chr(10) +
     1752                    "                            , INPUT i-delimiter AS CHARACTER"         + chr(10) +
     1753                    "                            , INPUT i-pos       AS INTEGER"           + chr(10) +
     1754                    "                            ) ."                                      + chr(10) + chr(10) +
     1755                    "ПАРАМЕТРЫ:"                                                           + chr(10) +
     1756                    '  i-list      - список, из которого нужно удалить элемент;'           + chr(10) +
     1757                    '  i-item      - элемент, который нужно удалить из списка;'            + chr(10) +
     1758                    '  i-delimiter - разделитель в списке; если не указан, то ",";'        + chr(10) +
     1759                    '  i-pos       - номер позиции, на которую нужно добавить элемент.'    + chr(10) + chr(10) +
     1760                    'Если номер позиции не указан или равен "0", то элемент добавляется на 1-ю позицию.' + chr(10) +
     1761                    'Если количество элементов в списке меньше указанной позиции, то '     +
     1762                    'список "расширяется" пустыми '                                        + chr(10) +
     1763                    'значениями, и элемент добавляется на последнюю позицию.'              + chr(10) + chr(10) +
     1764                    "ПРИМЕР:"                                                              + chr(10) + chr(10) +
     1765                    '/* **************************************************** *\' + chr(10) +
     1766                    ' *                                                      *'  + chr(10) +
     1767                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1768                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1769                                                                            '*'  + chr(10) +
     1770                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1771                    ' *                                                      *'  + chr(10) +
     1772                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1773                    ' *                                                      *'  + chr(10) +
     1774                    '\* **************************************************** */' + chr(10) + chr(10) +
     1775                    "~&SCOPED-DEFINE f-l addn-list"                                        + chr(10) + chr(10) +
     1776                    "~{ cmp/str-glbl.i        ~}"                                          + chr(10) +
     1777                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                       + chr(10) + chr(10) +
     1778                    'DEFINE VARIABLE jj      AS INTEGER   NO-UNDO INITIAL 0 .'             + chr(10) +
     1779                    'DEFINE VARIABLE j1      AS INTEGER   NO-UNDO INITIAL 0 .'             + chr(10) +
     1780                    'DEFINE VARIABLE v_delim AS CHARACTER NO-UNDO INITIAL "":U .'          + chr(10) +
     1781                    'DEFINE VARIABLE v_list  AS CHARACTER NO-UNDO INITIAL "":U .'          + chr(10) +
     1782                    'DEFINE VARIABLE v_item  AS CHARACTER NO-UNDO INITIAL "":U .'          + chr(10) + chr(10) +
     1783                    'ASSIGN'                                                               + chr(10) +
     1784                    '  v_list  = "Aa,Bb,Cc,Dd,Ee,Ff,Gg,Hh"'                                + chr(10) +
     1785                    '  v_item  = "xx"'                                                     + chr(10) +
     1786                    '  v_delim = ~{~&comma-char~}'                                         + chr(10) +
     1787                    '  j1      = NUM-ENTRIES( v_list, v_delim )'                           + chr(10) +
     1788                    '.'                                                                    + chr(10) +
     1789                    'MESSAGE'                                                              + chr(10) +
     1790                    '  "Список:"           v_list j1  SKIP( 0 )'                           + chr(10) +
     1791                    '  "Разделитель:"      v_delim    SKIP( 0 )'                           + chr(10) +
     1792                    '  "Элемент:"          v_item "?" SKIP( 1 )'                           + chr(10) +
     1793                    '  "После добавления:" addn-list( v_list, v_item, v_delim, ? )'        + chr(10) +
     1794                    'VIEW-AS ALERT-BOX .'                                                  + chr(10) +
     1795                    'DO jj = 1 TO j1 + 1 :'                                                + chr(10) +
     1796                    '  MESSAGE'                                                            + chr(10) +
     1797                    '    "Список:"           v_list j1 SKIP( 0 )'                          + chr(10) +
     1798                    '    "Разделитель:"      v_delim   SKIP( 0 )'                          + chr(10) +
     1799                    '    "Элемент:"          v_item jj SKIP( 1 )'                          + chr(10) +
     1800                    '    "После добавления:" addn-list( v_list, v_item, v_delim, jj )'     + chr(10) +
     1801                    '  VIEW-AS ALERT-BOX .'                                                + chr(10) +
     1802                    'END.'                                                                 + chr(10) +
     1803                    'MESSAGE'                                                              + chr(10) +
     1804                    '  "Список:"           v_list  j1     SKIP( 0 )'                       + chr(10) +
     1805                    '  "Разделитель:"      v_delim        SKIP( 0 )'                       + chr(10) +
     1806                    '  "Элемент:"          v_item  j1 * 2 SKIP( 1 )'                       + chr(10) +
     1807                    '  "После добавления:" addn-list( v_list, v_item, v_delim, j1 * 2 )'   + chr(10) +
     1808                    'VIEW-AS ALERT-BOX .'                                                  + chr(10)
     1809         .
     1810       end.
