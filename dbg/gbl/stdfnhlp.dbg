     1965                    ' *                                                      *'  + chr(10) +
     1966                    '\* **************************************************** */' + chr(10) + chr(10) +
     1967                    "~&SCOPED-DEFINE f-l is-marked"                                       + chr(10) + chr(10) +
     1968                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                      + chr(10) + chr(10) +
     1969                    'DEFINE VARIABLE v_list  AS CHARACTER NO-UNDO INITIAL "":U .'         + chr(10) +
     1970                    'DEFINE VARIABLE v_item1 AS CHARACTER NO-UNDO INITIAL "":U .'         + chr(10) +
