      954                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      955                    ' *                                                      *'  + chr(10) +
      956                    '\* **************************************************** */' + chr(10) + chr(10) +
      957                    "~&SCOPED-DEFINE f-l get-dec"                                   + chr(10) + chr(10) +
      958                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                + chr(10) + chr(10) +
