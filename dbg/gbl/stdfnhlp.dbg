     3024                    "ФОРМАТ ВЫЗОВА:"                                                     + chr(10) +
     3025                    "Digital RETURNS LOGICAL ( INPUT CHARACTER ) ."                      + chr(10) + chr(10) +
     3026                    "ПРИМЕР:"                                                            + chr(10) + chr(10) +
     3027                    '/* **************************************************** *\' + chr(10) +
     3028                    ' *                                                      *'  + chr(10) +
     3029                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
