     1990                    "                           , INPUT i-item      AS CHARACTER"            + chr(10) +
     1991                    "                           , INPUT i-delimiter AS CHARACTER"            + chr(10) +
     1992                    "                           ) ."                                         + chr(10) + chr(10) +
     1993                    "ПАРАМЕТРЫ:"                                                             + chr(10) +
