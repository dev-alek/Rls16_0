      979                    ' *                                                      *'  + chr(10) +
      980                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      981                    ' *                                                      *'  + chr(10) +
      982                    '\* **************************************************** */' + chr(10) + chr(10) +
      983                    "~&SCOPED-DEFINE f-l RedLine"                                             + chr(10) + chr(10) +
      984                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                          + chr(10) + chr(10) +
      985                    'DEFINE VARIABLE v_str AS CHARACTER NO-UNDO INITIAL "красная строка" .'   + chr(10) + chr(10) +
      986                    'MESSAGE'                                                                 + chr(10) +
      987                    '        v_str   "-->" RedLine(       v_str )   SKIP( 0 )'                + chr(10) +
      988                    '  CAPS( v_str ) "-->" RedLine( CAPS( v_str ) ) SKIP( 0 )'                + chr(10) +
      989                    '  LC( SUBSTRING( v_str, 1, 1 ) ) + CAPS( SUBSTRING( v_str, 2 ) ) "-->"'                + chr(10) +
      990                    '  RedLine( LC( SUBSTRING( v_str, 1, 1 ) ) + CAPS( SUBSTRING( v_str, 2 ) ) ) SKIP( 0 )' + chr(10) +
      991                    '  CAPS( SUBSTRING( v_str, 1, 1 ) ) + LC( SUBSTRING( v_str, 2 ) ) "-->"'                + chr(10) +
