     1997                    "ПРИМЕР:"                                                                + chr(10) + chr(10) +
     1998                    '/* **************************************************** *\' + chr(10) +
     1999                    ' *                                                      *'  + chr(10) +
     2000                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
