     2997                    '\* **************************************************** */' + chr(10) + chr(10) +
     2998                    "~&SCOPED-DEFINE f-l ShiftRightSymbol"                              + chr(10) + chr(10) +
     2999                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                    + chr(10) + chr(10) +
     3000                    'DEFINE VARIABLE c-str1   AS CHARACTER NO-UNDO .'                   + chr(10) +
     3001                    'DEFINE VARIABLE c-str2   AS CHARACTER NO-UNDO .'                   + chr(10) +
