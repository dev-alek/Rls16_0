     1900         assign
     1901           p-help = 'Пометить / снять отметку "выбрано" с записи. Возвращает "новый" список (соответственно, '  +
     1902                    'с помеченной или без помеченной записи).'                      + chr(10) + chr(10) +
     1903                    "ФОРМАТ ВЫЗОВА:"                                                + chr(10) +
     1904                    "ChooseMark RETURNS CHARACTER ( INPUT i-list      AS CHARACTER" + chr(10) +
     1905                    "                             , INPUT i-item      AS CHARACTER" + chr(10) +
     1906                    "                             , INPUT i-delimiter AS CHARACTER" + chr(10) +
     1907                    "                             ) ."                              + chr(10) + chr(10) +
     1908                    "ПАРАМЕТРЫ:"                                                    + chr(10) +
     1909                    '  i-list      - список;'                                       + chr(10) +
     1910                    '  i-item      - элемент;'                                      + chr(10) +
     1911                    '  i-delimiter - разделитель в списке; если не указан, то ",".' + chr(10) + chr(10) +
     1912                    "ПРИМЕР:"                                                       + chr(10) + chr(10) +
     1913                    '/* **************************************************** *\' + chr(10) +
     1914                    ' *                                                      *'  + chr(10) +
     1915                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     1916                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     1917                                                                            '*'  + chr(10) +
     1918                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
