     2809                    "MonthNameCaseRus RETURNS CHARACTER ( INPUT Month AS INTEGER"      + chr(10) +
     2810                    "                                   , INPUT Case  AS INTEGER"      + chr(10) +
     2811                    "                                   ) ."                           + chr(10) + chr(10) +
     2812                    "ПРИМЕР:"                                                          + chr(10) + chr(10) +
     2813                    '/* **************************************************** *\' + chr(10) +
     2814                    ' *                                                      *'  + chr(10) +
     2815                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2816                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2817                                                                            '*'  + chr(10) +
     2818                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2819                    ' *                                                      *'  + chr(10) +
     2820                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2821                    ' *                                                      *'  + chr(10) +
     2822                    '\* **************************************************** */' + chr(10) + chr(10) +
     2823                    "~&SCOPED-DEFINE f-l MonthNameRusCase"                             + chr(10) + chr(10) +
     2824                    "~{ cmp/str-glbl.i        ~}"                                      + chr(10) +
     2825                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                   + chr(10) + chr(10) +
     2826                    "DEFINE VARIABLE jCase      AS INTEGER   NO-UNDO ."                + chr(10) +
     2827                    "DEFINE VARIABLE curr-month AS INTEGER   NO-UNDO ."                + chr(10) +
     2828                    "DEFINE VARIABLE word-month AS CHARACTER NO-UNDO EXTENT 6 ."       + chr(10) +
     2829                    "DEFINE VARIABLE l_log      AS LOGICAL   NO-UNDO INITIAL YES ."    + chr(10) + chr(10) +
     2830                    "DO curr-month = 1 TO 12 :"                                                      + chr(10) +
     2831                    "  DO jCase = 1 TO EXTENT( word-month ) :"                                       + chr(10) +
     2832                    "    ASSIGN"                                                                     + chr(10) +
     2833                    "      word-month[ jCase ] = MonthNameRusCase( curr-month, jCase )"              + chr(10) +
     2834                    "    ."                                                                          + chr(10) +
     2835                    "  END. /* jCase */"                                                             + chr(10) +
     2836                    '  MESSAGE'                                                                      + chr(10) +
     2837                    '    "Месяц:" curr-month                             SKIP( 1 )'                  + chr(10) +
     2838                    '    "1) именительный:" ~{~&tabulation~} word-month[ 1 ] SKIP( 0 )'              + chr(10) +
     2839                    '    "2) родительный:"  ~{~&tabulation~} word-month[ 2 ] SKIP( 0 )'              + chr(10) +
     2840                    '    "3) дательный:"    ~{~&tabulation~} word-month[ 3 ] SKIP( 0 )'              + chr(10) +
     2841                    '    "4) винительный:"  ~{~&tabulation~} word-month[ 4 ] SKIP( 0 )'              + chr(10) +
     2842                    '    "5) творительный:" ~{~&tabulation~} word-month[ 5 ] SKIP( 0 )'              + chr(10) +
     2843                    '    "6) предложный:"   ~{~&tabulation~} word-month[ 6 ] SKIP( 1 )'              + chr(10) +
     2844                    '  VIEW-AS ALERT-BOX BUTTONS OK-CANCEL UPDATE l_log .'                           + chr(10) +
     2845                    '  IF l_log <> YES'                                                              + chr(10) +
     2846                    '  THEN DO:'                                                                     + chr(10) +
     2847                    '    LEAVE .'                                                                    + chr(10) +
     2848                    '  END.'                                                                         + chr(10) +
     2849                    "END. /* curr-month */"                                                          + chr(10)
     2850         .
     2851       end.
     2852       when 'Centering'
     2853       then do:
     2854         assign
     2855           p-help = 'Возвращает отцентрированную строку.'                              + chr(10) + chr(10) +
     2856                    "ФОРМАТ ВЫЗОВА:"                                                   + chr(10) +
