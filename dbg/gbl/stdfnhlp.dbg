      960                    'MESSAGE'                                                       + chr(10) +
      961                    '  "Число:"                  d_num   SKIP( 0 )'                 + chr(10) +
      962                    '  "дробная часть:" get-dec( d_num )'                           + chr(10) +
      963                    'VIEW-AS ALERT-BOX .'                                           + chr(10)
      964         .
