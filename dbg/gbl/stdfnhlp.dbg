      913                    "Первый параметр - число, которое нужно обрезать."               + chr(10)   +
      914                    "Второй параметр - количество знаков, которые нужно отбросить."  + chr(10)   +
      915                    "Если порядок отрицательный, то отбрасываются цифры слева от десятичной точки:"  + chr(10) +
      916                    "  Trunc-M( 567.0, -1 ) = 560.0, Trunc-M( 567.0, -2 ) = 500.0."  + chr(10)   + chr(10) +
      917                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10)   +
      918                    "Trunc-M RETURNS DECIMAL ( INPUT decimal-number AS DECIMAL"      + chr(10)   +
      919                    "                        , INPUM truncate-order AS INTEGER"      + chr(10)   +
      920                    "                        ) ."                                    + chr(10)   + chr(10) +
      921                    "ПРИМЕР:"                                                        + chr(10)   + chr(10) +
      922                    '/* **************************************************** *\' + chr(10) +
      923                    ' *                                                      *'  + chr(10) +
      924                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      925                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
