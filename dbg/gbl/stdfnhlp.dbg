     2958                    'DEFINE VARIABLE j-length AS INTEGER   NO-UNDO .'             + chr(10) + chr(10) +
     2959                    'ASSIGN'                                                      + chr(10) +
     2960                    '  c-str1   = "сдвинуть вправо"'                              + chr(10) +
     2961                    '  j-length = LENGTH( c-str1 )'                               + chr(10) +
