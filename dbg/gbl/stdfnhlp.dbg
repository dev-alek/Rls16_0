     2866                    ' *                                                      *'  + chr(10) +
     2867                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2868                    ' *                                                      *'  + chr(10) +
     2869                    '\* **************************************************** */' + chr(10) + chr(10) +
     2870                    "~&SCOPED-DEFINE f-l Centering"                                    + chr(10) + chr(10) +
     2871                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                   + chr(10) + chr(10) +
     2872                    'DEFINE VARIABLE c-str1   AS CHARACTER NO-UNDO .'                  + chr(10) +
     2873                    'DEFINE VARIABLE c-str2   AS CHARACTER NO-UNDO .'                  + chr(10) +
     2874                    'DEFINE VARIABLE c-str3   AS CHARACTER NO-UNDO .'                  + chr(10) +
     2875                    'DEFINE VARIABLE j-length AS INTEGER   NO-UNDO .'                  + chr(10) + chr(10) +
     2876                    'ASSIGN'                                                           + chr(10) +
     2877                    '  c-str1   = "отцентрированная строка"'                           + chr(10) +
     2878                    '  j-length = LENGTH( c-str1 )'                                    + chr(10) +
     2879                    '  c-str2   = Centering( c-str1, j-length + 5 )'                   + chr(10) +
     2880                    '  c-str3   = Centering( c-str1, j-length + 6 )'                   + chr(10) +
     2881                    '.'                                                                + chr(10) +
     2882                    'MESSAGE'                                                          + chr(10) +
     2883                    '  ~'"~' + c-str1 + ~'"~' LENGTH( c-str1 ) SKIP( 0 )'              + chr(10) +
     2884                    '  ~'"~' + c-str2 + ~'"~' LENGTH( c-str2 ) "  L:" INDEX( c-str2, c-str1 ) - 1'   + chr(10) +
     2885                    '  "R:" LENGTH( c-str2 ) - ( j-length + INDEX( c-str2, c-str1 ) ) + 1 SKIP( 0 )' + chr(10) +
     2886                    '  ~'"~' + c-str3 + ~'"~' LENGTH( c-str3 )  " L:" INDEX( c-str3, c-str1 ) - 1'   + chr(10) +
     2887                    '  "R:" LENGTH( c-str3 ) - ( j-length + INDEX( c-str3, c-str1 ) ) + 1 SKIP( 0 )' + chr(10) +
     2888                    'VIEW-AS ALERT-BOX .'                                                            + chr(10)
     2889         .
     2890       end.
     2891       when 'CenteringSymbol'
     2892       then do:
     2893         assign
     2894           p-help = 'Возвращает отцентрированную заданным символом строку.'                + chr(10) + chr(10) +
     2895                    "ФОРМАТ ВЫЗОВА:"                                                       + chr(10) +
