        1   block-level on error undo, throw.
        2   define input parameter p-func-name as character no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision: 89462fe805e0, 527, rls $":U .
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo initial "$Date: Thu Mar 17 18:42:35 2016 +0400 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: stdfnhlp.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: gbl/stdfnhlp.p $":U .
        8   define variable vss-description as character no-undo initial "Описание функций из std-func.i":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable Help_Editor as character no-undo view-as editor    scrollbar-vertical               size-chars 98.00 by 17.25 .
      113   define variable Func_Name   as character no-undo view-as combo-box list-items '':U    inner-lines 1 size-chars 36.00 by  1.00 sort format "x(32)":U .
      114   define variable num_funcs   as integer   no-undo view-as fill-in                                    size-chars 16.50 by  1.00 format "->,>>>,>>>,>>9.":U .
      115   define variable j_func      as integer   no-undo view-as fill-in                                    size-chars 16.50 by  1.00 format "->,>>>,>>>,>>9":U .
      116   define button Btn_Exit label "Вы&ход" size-chars 10.00 by 1.00 default auto-end-key .
      117   define frame fr-D-FunctionHelp
      118     Func_Name   at row  1.50 col  1.50    label "Функция"
      119     j_func      at row  1.50 col 47.00 no-label                 fgcolor  4
      120     num_funcs   at row  1.50 col 67.75    label "Всего функций" fgcolor  4
      121     Help_Editor at row  3.00 col  1.50 no-label                 bgcolor 15
      122     Btn_Exit    at row 20.75 col 44.00 skip( 0.25 )
      123   with view-as dialog-box keep-tab-order side-labels no-underline three-d scrollable
      124        title "Описание функций" default-button Btn_Exit cancel-button Btn_Exit.
      125   assign
      126     frame fr-D-FunctionHelp :scrollable = no
      127   .
      128   assign
      129     Help_Editor :read-only in frame fr-D-FunctionHelp = yes
      130   .
      131   on value-changed of Func_Name in frame fr-D-FunctionHelp
      132   do:
      133   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   if lookup(self :type
      135            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      136            ) = 0
      137   then do:
      138     message
      139       "$Workfile$"
      140       "Указанному интерфейсному элементу фокус не может быть передан" skip
      141       "Интерфейсный элемент" self :name  skip
      142       "Тип" self :type  skip
      143       "Процедура" this-procedure :file-name skip
      144       view-as alert-box .
      145   end.
      146   else do:
      147     apply "entry":u to self  .
      148     if focus :handle <> self :handle  then do:
      149       return no-apply .
      150     end.
      151   end.
      152     assign
      153       Func_Name
      154     .
      155     assign
      156       j_func = Func_Name :lookup( Func_Name )
      157     .
      158     run GetFunctionHelp1 in this-procedure
      159       (  input Func_Name
      160       , output Help_Editor
      161       ) .
      162     display j_func Help_Editor with frame fr-D-FunctionHelp .
      163   end.
      164   if valid-handle( active-window ) and
      165      frame fr-D-FunctionHelp :parent = ?
      166   then do:
      167     frame fr-D-FunctionHelp :parent = active-window .
      168   end.
      169   if current-window :window-state = window-minimized
      170   then do:
      171      current-window :window-state = window-normal .
      172   end.
      173   on window-close of frame fr-D-FunctionHelp
      174   do:
      175     apply "END-ERROR":U to frame fr-D-FunctionHelp.
      176   end.
      177   Main-Block:
      178   DO
      179   on error   undo Main-Block, leave Main-Block
      180   on end-key undo Main-Block, leave Main-Block
      181   on stop    undo Main-Block, leave Main-Block
      182   :
      183     assign
      184       Func_Name :list-items  = 'LastMonthDate,LastMonthDay,LastDay-MY,LastDate-MY,NextMonth,NextYear,PrevMonth,PrevYear,NextMonth-MY,NextYear-MY,MonthNameRus,MonthNameRusGen,MonthNameRusCase,CalcMonthes,CalcMonth-MY,DateTimeHeader,PrevMonth-MY,PrevYear-MY,MonthNameEng,TimeStamp,Round-M,Trunc-M,get-dec,RedLine,Word-Sum,Total-Word,PutAcc,Roubles,Copecks,Word-Sum-Eng,Word-Curr,Int2Char,PutInt,PutSum,Stamp57,WeekDay-Full,WeekDay-Short,WeekDay-Shrt3,WeekDay-Rus,WeekDay-Full-Eng,WeekDay-Eng2,WeekDay-Eng3,Week-Num,Week-From,Week-Till,Week-Date,Week-Date-Eng,Rec2Char,DelEntry,addl-list,addf-list,addn-list,super-pos,sets-union,sets-intersection,ChooseMark,is-marked,MarkSign,Int2Hex,Hex2Int,Int2Octal,Oct2Int,Int2Bin,Bin2Int,Int2Base,Base2Int,Base2Int64,DateNum,NumDays,KeyStamp,Leap-Year,Leap-Year-d,Sparse,SparseSymbol,Compress,CompressSymbol,Centering,CenteringSymbol,ShiftRight,ShiftRightSymbol,Digital' + ',' + 'get-decade-word,get-dec-word-eng':U
      185       Func_Name :inner-lines = 9
      186     .
      187     assign
      188       num_funcs = num-entries( Func_Name :list-items )
      189       j_func    = Func_Name :lookup( p-func-name )
      190     .
      191     assign
      192       Func_Name = Func_Name :entry( ( if j_func > 0 then j_func else 1 ) )
      193     .
      194     assign
      195       j_func    = Func_Name :lookup( Func_Name )
      196     .
      197     display Func_Name Help_Editor num_funcs j_func with frame fr-D-FunctionHelp .
      198     enable  Func_Name Help_Editor Btn_Exit         with frame fr-D-FunctionHelp .
      199     apply   'VALUE-CHANGED':U  to Func_Name          in frame fr-D-FunctionHelp .
      200     wait-for endkey of frame fr-D-FunctionHelp .
      201   end.
      202   hide frame fr-D-FunctionHelp no-pause .
      203   procedure GetFunctionHelp1 :
      204     define  input parameter p-name as character no-undo .
      205     define output parameter p-help as character no-undo .
      206     case p-name :
      207       when 'LastMonthDate'
      208       then do:
      209         assign
      210           p-help = "Возвращает дату последнего дня текущего месяца." + chr(10) + chr(10) +
      211                    "ФОРМАТ ВЫЗОВА:"                                  + chr(10) +
      212                    "LastMonthDate RETURNS DATE ( INPUT DATE ) ."     + chr(10) + chr(10) +
      213                    "ПРИМЕР:"                                         + chr(10) + chr(10) +
      214                    '/* **************************************************** *\' + chr(10) +
      215                    ' *                                                      *'  + chr(10) +
      216                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      217                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      218                                                                            '*'  + chr(10) +
      219                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      220                    ' *                                                      *'  + chr(10) +
      221                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      222                    ' *                                                      *'  + chr(10) +
      223                    '\* **************************************************** */' + chr(10) + chr(10) +
      224                    "~&SCOPED-DEFINE f-l LastMonthDate"               + chr(10) + chr(10) +
      225                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                  + chr(10) + chr(10) +
      226                    "DEFINE VARIABLE t_curr-date AS DATE NO-UNDO ."   + chr(10) +
      227                    "DEFINE VARIABLE t_last-date AS DATE NO-UNDO ."   + chr(10) + chr(10) +
      228                    "ASSIGN"                                          + chr(10) +
      229                    "  t_curr-date = TODAY"                           + chr(10) +
      230                    "  t_last-date = LastMonthDate( t_curr-date )"    + chr(10) +
      231                    "."                                               + chr(10) +
      232                    'MESSAGE'                                         + chr(10) +
      233                    '  "Дата последнего дня месяца:" t_last-date'     + chr(10) +
      234                    'VIEW-AS ALERT-BOX .'                             + chr(10)
      235         .
      236       end.
      237       when 'LastMonthDay'
      238       then do:
      239         assign
      240           p-help = "Возвращает последний день текущего месяца."       + chr(10) + chr(10) +
      241                    "ФОРМАТ ВЫЗОВА:"                                   + chr(10) +
      242                    "LastMonthDate RETURNS INTEGER ( INPUT DATE ) ."   + chr(10) + chr(10) +
      243                    "ПРИМЕР:"                                          + chr(10) + chr(10) +
      244                    '/* **************************************************** *\' + chr(10) +
      245                    ' *                                                      *'  + chr(10) +
      246                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      247                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      248                                                                            '*'  + chr(10) +
      249                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      250                    ' *                                                      *'  + chr(10) +
      251                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      252                    ' *                                                      *'  + chr(10) +
      253                    '\* **************************************************** */' + chr(10) + chr(10) +
      254                    "~&SCOPED-DEFINE f-l LastMonthDay"                 + chr(10) + chr(10) +
      255                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                   + chr(10) + chr(10) +
      256                    "DEFINE VARIABLE t_curr-date AS DATE    NO-UNDO ." + chr(10) +
      257                    "DEFINE VARIABLE j_last-day  AS INTEGER NO-UNDO ." + chr(10) + chr(10) +
      258                    "ASSIGN"                                           + chr(10) +
      259                    "  t_curr-date = TODAY"                            + chr(10) +
      260                    "  j_last-day  = LastMonthDay( t_curr-date )"      + chr(10) +
      261                    "."                                                + chr(10) +
      262                    'MESSAGE'                                          + chr(10) +
      263                    '  "Последний день месяца:" j_last-day'            + chr(10) +
      264                    'VIEW-AS ALERT-BOX .'                              + chr(10)
      265         .
      266       end.
      267       when 'LastDate-MY'
      268       then do:
      269         assign
      270           p-help = "Возвращает дату последнего дня текущего месяца по месяцу и году." + chr(10) + chr(10) +
      271                    "ФОРМАТ ВЫЗОВА:"                                                   + chr(10) +
      272                    "LastDate-MY RETURNS INTEGER ( INPUT Month AS INTEGER,"            + chr(10) +
      273                    "                              INPUT Year  AS INTEGER ) ."         + chr(10) + chr(10) +
