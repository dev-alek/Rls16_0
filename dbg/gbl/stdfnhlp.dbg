     2858                    "                              INPUT Lenght   AS INTEGER ) ."      + chr(10) + chr(10) +
     2859                    "ПРИМЕР:"                                                          + chr(10) + chr(10) +
     2860                    '/* **************************************************** *\' + chr(10) +
     2861                    ' *                                                      *'  + chr(10) +
     2862                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2863                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2864                                                                            '*'  + chr(10) +
