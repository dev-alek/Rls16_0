     1920                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1921                    ' *                                                      *'  + chr(10) +
     1922                    '\* **************************************************** */' + chr(10) + chr(10) +
     1923                    "~&SCOPED-DEFINE f-l ChooseMark"                                + chr(10) + chr(10) +
     1924                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                + chr(10) + chr(10) +
     1925                    'DEFINE VARIABLE v_lst1 AS CHARACTER NO-UNDO INITIAL "":U .'    + chr(10) +
     1926                    'DEFINE VARIABLE v_lst2 AS CHARACTER NO-UNDO INITIAL "":U .'    + chr(10) +
     1927                    'DEFINE VARIABLE v_item AS CHARACTER NO-UNDO INITIAL "":U .'    + chr(10) + chr(10) +
     1928                    'ASSIGN'                                                        + chr(10) +
     1929                    '  v_lst1 = "Aa,Bb,Cc,xx,Dd,Ee,Ff"'                             + chr(10) +
     1930                    '  v_lst2 = "Aa,Bb,Cc,Dd,Ee,Ff"'                                + chr(10) +
     1931                    '  v_item = "xx"'                                               + chr(10) +
     1932                    '.'                                                             + chr(10) +
     1933                    'MESSAGE'                                                       + chr(10) +
     1934                    '  "Список:"                v_lst1              SKIP( 0 )'      + chr(10) +
     1935                    '  "Элемент:"                       v_item      SKIP( 0 )'      + chr(10) +
     1936                    '  "Результат:" ChooseMark( v_lst1, v_item, ? ) SKIP( 1 )'      + chr(10) +
     1937                    '  "Список:"                v_lst2              SKIP( 0 )'      + chr(10) +
     1938                    '  "Элемент:"                       v_item      SKIP( 0 )'      + chr(10) +
     1939                    '  "Результат:" ChooseMark( v_lst2, v_item, ? ) SKIP( 0 )'      + chr(10) +
     1940                    'VIEW-AS ALERT-BOX .'                                           + chr(10)
     1941         .
     1942       end.
     1943       when 'is-marked'
     1944       then do:
     1945         assign
     1946           p-help = 'Возвращает - помечена запись или нет.'                               + chr(10) + chr(10) +
     1947                    "ФОРМАТ ВЫЗОВА:"                                                      + chr(10) +
     1948                    "is-marked RETURNS LOGICAL ( INPUT i-list      AS CHARACTER"          + chr(10) +
     1949                    "                          , INPUT i-item      AS CHARACTER"          + chr(10) +
     1950                    "                          , INPUT i-delimiter AS CHARACTER"          + chr(10) +
     1951                    "                          ) ."                                       + chr(10) + chr(10) +
     1952                    "ПАРАМЕТРЫ:"                                                          + chr(10) +
