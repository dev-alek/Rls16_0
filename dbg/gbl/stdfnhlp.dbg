     1821                    "ПАРАМЕТРЫ:"                                                           + chr(10) +
     1822                    '  i-list-1    - 1-й список, из которого вычитается 2-й;'              + chr(10) +
     1823                    '  i-list-2    - 2-й список, который вычитается из 1-го;'              + chr(10) +
     1824                    '  i-delimiter - разделитель в списках; если не указан, то ",".'       + chr(10) + chr(10) +
     1825                    "ПРИМЕР:"                                                              + chr(10) + chr(10) +
     1826                    '/* **************************************************** *\' + chr(10) +
     1827                    ' *                                                      *'  + chr(10) +
     1828                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
