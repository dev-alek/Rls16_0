     2909                    '\* **************************************************** */' + chr(10) + chr(10) +
     2910                    "~&SCOPED-DEFINE f-l Centering,CenteringSymbol"                        + chr(10) + chr(10) +
     2911                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                       + chr(10) + chr(10) +
     2912                    'DEFINE VARIABLE c-str1   AS CHARACTER NO-UNDO .'                      + chr(10) +
     2913                    'DEFINE VARIABLE c-str2   AS CHARACTER NO-UNDO .'                      + chr(10) +
     2914                    'DEFINE VARIABLE c-str3   AS CHARACTER NO-UNDO .'                      + chr(10) +
     2915                    'DEFINE VARIABLE j-length AS INTEGER   NO-UNDO .'                      + chr(10) + chr(10) +
     2916                    'ASSIGN'                                                               + chr(10) +
     2917                    '  c-str1   = "отцентрированная строка"'                               + chr(10) +
     2918                    '  j-length = LENGTH( c-str1 )'                                        + chr(10) +
     2919                    '  c-str2   = CenteringSymbol( '                                       +
