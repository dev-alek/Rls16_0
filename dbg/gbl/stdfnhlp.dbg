      823                    ' *                                                      *'  + chr(10) +
      824                    '\* **************************************************** */' + chr(10) + chr(10) +
      825                    "~&SCOPED-DEFINE f-l TimeStamp"                     + chr(10) + chr(10) +
      826                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                    + chr(10) + chr(10) +
