     3033                    ' *                                                      *'  + chr(10) +
     3034                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     3035                    ' *                                                      *'  + chr(10) +
     3036                    '\* **************************************************** */' + chr(10) + chr(10) +
     3037                    "~&SCOPED-DEFINE f-l Digital"                                        + chr(10) + chr(10) +
     3038                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                     + chr(10) + chr(10) +
     3039                    'DEFINE VARIABLE c-str1 AS CHARACTER NO-UNDO .'                      + chr(10) +
     3040                    'DEFINE VARIABLE c-str2 AS CHARACTER NO-UNDO .'                      + chr(10) +
     3041                    'DEFINE VARIABLE c-str3 AS CHARACTER NO-UNDO .'                      + chr(10) +
     3042                    'DEFINE VARIABLE c-str4 AS CHARACTER NO-UNDO .'                      + chr(10) + chr(10) +
     3043                    'ASSIGN'                                                             + chr(10) +
     3044                    '  c-str1 = "-123456789.0"'                                          + chr(10) +
     3045                    '  c-str2 = "+123456789.0"'                                          + chr(10) +
     3046                    '  c-str3 = "0.987654321"'                                           + chr(10) +
     3047                    '  c-str4 = "1234567890-0987654321"'                                 + chr(10) +
     3048                    '.'                                                                  + chr(10) +
     3049                    'MESSAGE'                                                            + chr(10) +
     3050                    '  ~'"~' + c-str1 + ~'"~''                                           +
     3051                     ' STRING( Digital( c-str1 ), "ЧИСЛО/СТРОКА":U )'                    + chr(10) +
