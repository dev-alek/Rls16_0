      816                    ' *                                                      *'  + chr(10) +
      817                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      818                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      819                                                                            '*'  + chr(10) +
