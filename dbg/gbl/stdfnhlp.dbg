     1643                                                                            '*'  + chr(10) +
     1644                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1645                    ' *                                                      *'  + chr(10) +
     1646                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1647                    ' *                                                      *'  + chr(10) +
     1648                    '\* **************************************************** */' + chr(10) + chr(10) +
     1649                    "~&SCOPED-DEFINE f-l DelEntry"                                   + chr(10) + chr(10) +
     1650                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10) + chr(10) +
     1651                    'DEFINE VARIABLE v_list AS CHARACTER NO-UNDO INITIAL "":U .'     + chr(10) +
     1652                    'DEFINE VARIABLE v_item AS CHARACTER NO-UNDO INITIAL "":U .'     + chr(10) + chr(10) +
     1653                    'ASSIGN'                                                         + chr(10) +
     1654                    '  v_list = "Aa,Bb,Cc,xx,Dd,Ee,Ff"'                              + chr(10) +
     1655                    '  v_item = "xx"'                                                + chr(10) +
     1656                    '.'                                                              + chr(10) +
     1657                    'MESSAGE'                                                        + chr(10) +
     1658                    '  "Список:"                   v_list              SKIP( 0 )'    + chr(10) +
     1659                    '  "Элемент:"                          v_item      SKIP( 1 )'    + chr(10) +
     1660                    '  "После удаления:" DelEntry( v_list, v_item, ? ) SKIP( 0 )'    + chr(10) +
     1661                    'VIEW-AS ALERT-BOX .'                                            + chr(10)
     1662         .
     1663       end.
     1664       when 'addl-list'
     1665       then do:
     1666         assign
     1667           p-help = 'Добавить новый элемент в список на последнее место. Возвращает "новый" '      +
     1668                    'список (с добавленной записью).'                                + chr(10) + chr(10) +
     1669                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10) +
     1670                    "addl-list RETURNS CHARACTER ( INPUT i-list      AS CHARACTER,"  + chr(10) +
     1671                    "                              INPUT i-item      AS CHARACTER,"  + chr(10) +
     1672                    "                            , INPUT i-delimiter AS CHARACTER"   + chr(10) +
     1673                    "                            ) ."                                + chr(10) + chr(10) +
     1674                    "ПАРАМЕТРЫ:"                                                     + chr(10) +
     1675                    '  i-list      - список, из которого нужно удалить элемент;'     + chr(10) +
     1676                    '  i-item      - элемент, который нужно удалить из списка;'      + chr(10) +
     1677                    '  i-delimiter - разделитель в списке; если не указан, то ",".'  + chr(10) + chr(10) +
     1678                    "ПРИМЕР:"                                                        + chr(10) + chr(10) +
     1679                    '/* **************************************************** *\' + chr(10) +
     1680                    ' *                                                      *'  + chr(10) +
