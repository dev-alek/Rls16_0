     1010                    ' *                                                      *'  + chr(10) +
     1011                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1012                    ' *                                                      *'  + chr(10) +
     1013                    '\* **************************************************** */' + chr(10) + chr(10) +
     1014                    "~&SCOPED-DEFINE f-l Int2Char"                                   + chr(10) + chr(10) +
     1015                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10) + chr(10) +
     1016                    'DEFINE VARIABLE j_num AS INTEGER NO-UNDO INITIAL 12345 .'       + chr(10) + chr(10) +
     1017                    'MESSAGE'                                                        + chr(10) +
     1018                    '            j_num   SKIP( 0 )'                                  + chr(10) +
