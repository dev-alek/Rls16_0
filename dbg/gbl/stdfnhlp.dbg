     2924                    'MESSAGE'                                                              + chr(10) +
     2925                    '  ~'"~' + c-str1 + ~'"~' LENGTH( c-str1 ) SKIP( 0 )'                  + chr(10) +
     2926                    '  ~'"~' + c-str2 + ~'"~' LENGTH( c-str2 ) "  L:" INDEX( c-str2, c-str1 ) - 1'       + chr(10) +
