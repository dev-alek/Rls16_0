      943           p-help = 'Возвращает дробную часть действительного числа в виде целого.' + chr(10) + chr(10) +
      944                    "ФОРМАТ ВЫЗОВА:"                                                + chr(10) +
      945                    "get-dec RETURNS INTEGER ( INPUT decimal_number AS DECIMAL ) ." + chr(10) + chr(10) +
      946                    "ПРИМЕР:"                                                       + chr(10) + chr(10) +
      947                    '/* **************************************************** *\' + chr(10) +
      948                    ' *                                                      *'  + chr(10) +
      949                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      950                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
