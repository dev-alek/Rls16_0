     2007                    '\* **************************************************** */' + chr(10) + chr(10) +
     2008                    "~&SCOPED-DEFINE f-l MarkSign"                                           + chr(10) + chr(10) +
     2009                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                         + chr(10) + chr(10) +
     2010                    'DEFINE VARIABLE v_lst1 AS CHARACTER NO-UNDO INITIAL "":U .'             + chr(10) +
