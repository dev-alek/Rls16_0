     2946                                                                            '*'  + chr(10) +
     2947                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2948                    ' *                                                      *'  + chr(10) +
     2949                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2950                    ' *                                                      *'  + chr(10) +
     2951                    '\* **************************************************** */' + chr(10) + chr(10) +
     2952                    "~&SCOPED-DEFINE f-l ShiftRight"                              + chr(10) + chr(10) +
     2953                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                              + chr(10) + chr(10) +
     2954                    'DEFINE VARIABLE c-str0   AS CHARACTER NO-UNDO .'             + chr(10) +
     2955                    'DEFINE VARIABLE c-str1   AS CHARACTER NO-UNDO .'             + chr(10) +
     2956                    'DEFINE VARIABLE c-str2   AS CHARACTER NO-UNDO .'             + chr(10) +
