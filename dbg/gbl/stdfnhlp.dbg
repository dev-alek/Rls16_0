      970                    "ФОРМАТ ВЫЗОВА:"                                                          + chr(10) +
      971                    "RedLine RETURNS CHARACTER ( INPUT CHARACTER ) ."                         + chr(10) + chr(10) +
      972                    "ПРИМЕР:"                                                                 + chr(10) + chr(10) +
      973                    '/* **************************************************** *\' + chr(10) +
      974                    ' *                                                      *'  + chr(10) +
      975                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
