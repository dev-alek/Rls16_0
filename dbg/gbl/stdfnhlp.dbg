     1844                    '  v_list2 = "Ff,Gg,Hh,Ii,Jj,Kk,Ll,Mm"'                                + chr(10) +
     1845                    '  v_delim = ~{~&comma-char~}'                                         + chr(10) +
     1846                    '.'                                                                    + chr(10) +
     1847                    'MESSAGE'                                                              + chr(10) +
     1848                    '  "1-й список:"                v_list1                     SKIP( 0 )' + chr(10) +
     1849                    '  "2-й список:"                         v_list2            SKIP( 0 )' + chr(10) +
