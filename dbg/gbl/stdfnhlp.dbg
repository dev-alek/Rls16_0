     1698                    '  "Список:"                      v_list              SKIP( 0 )' + chr(10) +
     1699                    '  "Элемент:"                             v_item      SKIP( 1 )' + chr(10) +
     1700                    '  "После добавления:" addl-list( v_list, v_item, ? ) SKIP( 0 )' + chr(10) +
     1701                    'VIEW-AS ALERT-BOX .'                                            + chr(10)
     1702         .
     1703       end.
     1704       when 'addf-list'
     1705       then do:
     1706         assign
