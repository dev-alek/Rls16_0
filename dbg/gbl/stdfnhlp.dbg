      706                    '\* **************************************************** */' + chr(10) + chr(10) +
      707                    "~&SCOPED-DEFINE f-l LastMonthDate,CalcMonthes"                 + chr(10) + chr(10) +
      708                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                + chr(10) + chr(10) +
      709                    "DEFINE VARIABLE t_curr-date AS DATE    NO-UNDO ."              + chr(10) +
      710                    "DEFINE VARIABLE t_date-from AS DATE    NO-UNDO ."              + chr(10) +
      711                    "DEFINE VARIABLE t_date-till AS DATE    NO-UNDO ."              + chr(10) +
      712                    "DEFINE VARIABLE num-monthes AS INTEGER NO-UNDO ."              + chr(10) + chr(10) +
      713                    "ASSIGN"                                                        + chr(10) +
      714                    "  t_curr-date = TODAY"                                         + chr(10) +
      715                    "  t_date-from = DATE( MONTH( t_curr-date ), 1, YEAR(  t_curr-date ) - 1 )"   + chr(10) +
      716                    "  t_date-till = LastMonthDate( t_curr-date )"                  + chr(10) +
      717                    "  num-monthes = CalcMonthes( t_date-from, t_date-till )"       + chr(10) +
      718                    '.'                                                             + chr(10) +
      719                    'MESSAGE'                                                       + chr(10) +
      720                    '  "Диапазон дат с:" t_date-from "по:" t_date-till SKIP( 0 )'   + chr(10) +
      721                    '  "Количество месяцев:" num-monthes'                           + chr(10) +
      722                    'VIEW-AS ALERT-BOX .'                                           + chr(10)
      723         .
      724       end.
      725       when 'CalcMonth-MY'
      726       then do:
      727         assign
      728           p-help = "Возвращает количество месяцев в интервале дат, " +
      729                    "заданных через месяцы и годы."                                               + chr(10) +
      730                                                                                                    chr(10) +
      731                    "ФОРМАТ ВЫЗОВА:"                                                              + chr(10) +
      732                    "CalcMonth-MY RETURNS INTEGER ( INPUT year-from  AS INTEGER"                  + chr(10) +
      733                    "                             , INPUT month-from AS INTEGER"                  + chr(10) +
      734                    "                             , INPUT year-till  AS INTEGER"                  + chr(10) +
      735                    "                             , INPUT month_till AS INTEGER"                  + chr(10) +
      736                    "                             ) ."                                            + chr(10) +
      737                                                                                                    chr(10) +
      738                    "ПРИМЕР:"                                                                     + chr(10) +
      739                                                                                                    chr(10) +
      740                    '/* **************************************************** *\' + chr(10) +
      741                    ' *                                                      *'  + chr(10) +
      742                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      743                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      744                                                                            '*'  + chr(10) +
      745                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      746                    ' *                                                      *'  + chr(10) +
      747                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      748                    ' *                                                      *'  + chr(10) +
      749                    '\* **************************************************** */' + chr(10) + chr(10) +
      750                    "~&SCOPED-DEFINE f-l CalcMonth-MY,MonthNameRus,MonthNameRusGen"               + chr(10) +
      751                                                                                                    chr(10) +
      752                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                              + chr(10) +
      753                                                                                                    chr(10) +
      754                    "DEFINE VARIABLE date_from   AS DATE    NO-UNDO ."                            + chr(10) +
      755                    "DEFINE VARIABLE date_till   AS DATE    NO-UNDO ."                            + chr(10) +
      756                    "DEFINE VARIABLE month_from  AS INTEGER NO-UNDO ."                            + chr(10) +
      757                    "DEFINE VARIABLE year_from   AS INTEGER NO-UNDO ."                            + chr(10) +
      758                    "DEFINE VARIABLE month_till  AS INTEGER NO-UNDO ."                            + chr(10) +
      759                    "DEFINE VARIABLE year_till   AS INTEGER NO-UNDO ."                            + chr(10) +
      760                    "DEFINE VARIABLE num-monthes AS INTEGER NO-UNDO ."                            + chr(10) +
      761                                                                                                    chr(10) +
      762                    "ASSIGN"                                                                      + chr(10) +
      763                    "  date_from   = TODAY - 31"                                                  + chr(10) +
      764                    "  date_till   = TODAY + 31"                                                  + chr(10) +
      765                    "  month_from  = MONTH( date_from )"                                          + chr(10) +
      766                    "  month_till  = MONTH( date_till )"                                          + chr(10) +
      767                    "  year_from   = YEAR(  date_from ) - 1"                                      + chr(10) +
      768                    "  year_till   = YEAR(  date_till ) + 1"                                      + chr(10) +
      769                    "  num-monthes = CalcMonth-MY( year_from, month_from,year_till, month_till )" + chr(10) +
      770                    "."                                                                           + chr(10) +
      771                    'MESSAGE'                                                                     + chr(10) +
      772                    '  "Диапазон дат:  с " MonthNameRusGen( month_from ) year_from'               + chr(10) +
      773                    '               " по " MonthNameRus(    month_till ) year_till SKIP( 0 )'     + chr(10) +
      774                    '  "Количество месяцев:" num-monthes'                                         + chr(10) +
      775                    'VIEW-AS ALERT-BOX .'                                                         + chr(10)
      776         .
      777       end.
      778       when 'DateTimeHeader'
      779       then do:
      780         assign
      781           p-help = "Заголовок отчета. Возвращает строку, содержащую текущие дату и " +
      782                    "время печати длиной 30 символов."                  + chr(10) + chr(10) +
      783                    "ФОРМАТ ВЫЗОВА:"                                    + chr(10) +
      784                    "DateTimeHeader RETURNS CHARACTER ( INPUT DATE ) ." + chr(10) + chr(10) +
      785                    "ПРИМЕР:"                                           + chr(10) + chr(10) +
      786                    '/* **************************************************** *\' + chr(10) +
      787                    ' *                                                      *'  + chr(10) +
      788                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      789                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      790                                                                            '*'  + chr(10) +
      791                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      792                    ' *                                                      *'  + chr(10) +
      793                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      794                    ' *                                                      *'  + chr(10) +
      795                    '\* **************************************************** */' + chr(10) + chr(10) +
      796                    "~&SCOPED-DEFINE f-l DateTimeHeader"                + chr(10) + chr(10) +
      797                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                    + chr(10) + chr(10) +
      798                    "DEFINE VARIABLE t_curr-date AS DATE NO-UNDO ."     + chr(10) + chr(10) +
      799                    "ASSIGN"                                            + chr(10) + chr(10) +
      800                    "  t_curr-date = TODAY"                             + chr(10) + chr(10) +
