     2529                    "ФОРМАТ ВЫЗОВА:"                                           + chr(10) +
     2530                    "Week-Date RETURNS DATE ( INPUT i-week AS INTEGER"         + chr(10) +
     2531                    "                       , INPUT i-day  AS INTEGER"         + chr(10) +
     2532                    "                       , INPUT i-year AS INTEGER"         + chr(10) +
     2533                    "                       ) ."                               + chr(10) + chr(10) +
