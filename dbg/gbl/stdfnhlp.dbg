      932                    "~&SCOPED-DEFINE f-l Trunc-M"                                    + chr(10)   + chr(10) +
      933                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                 + chr(10)   + chr(10) +
      934                    "DEFINE VARIABLE d_num AS DECIMAL NO-UNDO INITIAL -9876.12345 ." + chr(10)   + chr(10) +
      935                    'MESSAGE'                                                        + chr(10)   +
      936                    '  "Число:" d_num "обрезано до:" Trunc-M( d_num, -3 )'           + chr(10)   +
      937                    'VIEW-AS ALERT-BOX .'                                            + chr(10)
      938         .
      939       end.
