     1622         .
     1623       end.
     1624       when 'DelEntry'
     1625       then do:
     1626         assign
     1627           p-help = 'Снять отметку "выбрано" с записи. Возвращает "новый" список (без удаленной '  +
     1628                    'записи).'                                                       + chr(10) + chr(10) +
     1629                    "ФОРМАТ ВЫЗОВА:"                                                 + chr(10) +
     1630                    "DelEntry RETURNS CHARACTER ( INPUT i-list      AS CHARACTER"    + chr(10) +
     1631                    "                           , INPUT i-item      AS CHARACTER"    + chr(10) +
     1632                    "                           , INPUT i-delimiter AS CHARACTER"    + chr(10) +
     1633                    "                           ) ."                                 + chr(10) + chr(10) +
     1634                    "ПАРАМЕТРЫ:"                                                     + chr(10) +
     1635                    '  i-list      - список, из которого нужно удалить элемент;'     + chr(10) +
     1636                    '  i-item      - элемент, который нужно удалить из списка;'      + chr(10) +
     1637                    '  i-delimiter - разделитель в списке; если не указан, то ",".'  + chr(10) + chr(10) +
     1638                    "ПРИМЕР:"                                                        + chr(10) + chr(10) +
     1639                    '/* **************************************************** *\' + chr(10) +
     1640                    ' *                                                      *'  + chr(10) +
     1641                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
