     1684                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     1685                    ' *                                                      *'  + chr(10) +
     1686                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     1687                    ' *                                                      *'  + chr(10) +
     1688                    '\* **************************************************** */' + chr(10) + chr(10) +
     1689                    "~&SCOPED-DEFINE f-l addl-list"                                  + chr(10) + chr(10) +
