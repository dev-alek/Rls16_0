      380                    ' *                                                      *'  + chr(10) +
      381                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      382                    ' *                                                      *'  + chr(10) +
      383                    '\* **************************************************** */' + chr(10) + chr(10) +
      384                    "~&SCOPED-DEFINE f-l NextMonth-MY"                       + chr(10) + chr(10) +
