     2928                    '  ~'"~' + c-str3 + ~'"~' LENGTH( c-str3 )  " L:" INDEX( c-str3, c-str1 ) - 1'       + chr(10) +
     2929                    '  "R:" LENGTH( c-str3 ) - ( j-length + INDEX( c-str3, c-str1 ) ) + 1 SKIP( 0 )'     + chr(10) +
     2930                    'VIEW-AS ALERT-BOX .'                                                                + chr(10)
     2931         .
     2932       end.
     2933       when 'ShiftRight'
     2934       then do:
     2935         assign
     2936           p-help = 'Возвращает отцентрированную строку.'                         + chr(10) + chr(10) +
     2937                    "ФОРМАТ ВЫЗОВА:"                                              + chr(10) +
     2938                    "ShiftRight RETURNS CHARACTER ( INPUT InString AS CHARACTER"  + chr(10) +
     2939                    "                             , INPUT Lenght   AS INTEGER"    + chr(10) +
     2940                    "                             ) ."                            + chr(10) + chr(10) +
     2941                    "ПРИМЕР:"                                                     + chr(10) + chr(10) +
     2942                    '/* **************************************************** *\' + chr(10) +
     2943                    ' *                                                      *'  + chr(10) +
     2944                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
