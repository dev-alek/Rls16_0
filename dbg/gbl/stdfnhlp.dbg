      321                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                              + chr(10) + chr(10) +
      322                    "DEFINE VARIABLE t_curr-date AS DATE    NO-UNDO ."            + chr(10) +
      323                    "DEFINE VARIABLE curr-month  AS INTEGER NO-UNDO ."            + chr(10) +
      324                    "DEFINE VARIABLE curr-year   AS INTEGER NO-UNDO ."            + chr(10) +
      325                    "DEFINE VARIABLE t_last-day  AS INTEGER NO-UNDO ."            + chr(10) + chr(10) +
      326                    "ASSIGN"                                                      + chr(10) +
      327                    "  t_curr-date = TODAY"                                       + chr(10) +
      328                    "  curr-month  = MONTH( t_curr-date )"                        + chr(10) +
      329                    "  curr-year   = YEAR(  t_curr-date )"                        + chr(10) +
