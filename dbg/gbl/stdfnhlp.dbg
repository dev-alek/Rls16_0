     2032                    "ФОРМАТ ВЫЗОВА:"                                 + chr(10) +
     2033                    "NumDays RETURNS INTEGER ( INPUT DATE ) ."       + chr(10) + chr(10) +
     2034                    "ПРИМЕР:"                                        + chr(10) + chr(10) +
     2035                    '/* **************************************************** *\' + chr(10) +
     2036                    ' *                                                      *'  + chr(10) +
     2037                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
