     1711                    "                              INPUT i-item      AS CHARACTER,"  + chr(10) +
     1712                    "                            , INPUT i-delimiter AS CHARACTER"   + chr(10) +
     1713                    "                            ) ."                                + chr(10) + chr(10) +
     1714                    "ПАРАМЕТРЫ:"                                                     + chr(10) +
     1715                    '  i-list      - список, из которого нужно удалить элемент;'     + chr(10) +
