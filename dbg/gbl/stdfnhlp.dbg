     2042                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2043                    ' *                                                      *'  + chr(10) +
     2044                    '\* **************************************************** */' + chr(10) + chr(10) +
     2045                    "~&SCOPED-DEFINE f-l NumDays"                    + chr(10) + chr(10) +
     2046                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                 + chr(10) + chr(10) +
     2047                    'DEFINE VARIABLE t_date AS DATE NO-UNDO .'       + chr(10) + chr(10) +
     2048                    'ASSIGN'                                         + chr(10) +
     2049                    '  t_date = TODAY'                               + chr(10) +
     2050                    '.'                                              + chr(10) +
     2051                    'MESSAGE'                                        + chr(10) +
     2052                    '  "Сегодня:"       t_date                         SKIP( 0 )'  + chr(10) +
