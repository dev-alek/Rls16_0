      312                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
      313                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
      314                                                                            '*'  + chr(10) +
      315                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
      316                    ' *                                                      *'  + chr(10) +
      317                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
      318                    ' *                                                      *'  + chr(10) +
      319                    '\* **************************************************** */' + chr(10) + chr(10) +
