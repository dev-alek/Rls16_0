     2204                    "ФОРМАТ ВЫЗОВА:"                                                  + chr(10) +
     2205                    "Base2Int RETURNS INTEGER ( INPUT i-image AS CHARACTER"           + chr(10) +
     2206                    "                         , INPUT i-base  AS INTEGER"             + chr(10) +
     2207                    "                         ) ."                                    + chr(10) + chr(10) +
     2208                    "ПАРАМЕТРЫ:"                                                      + chr(10) +
     2209                    '  i-image - целое число, которое нужно сконвертировать;'         + chr(10) +
     2210                    '  i-base  - основание, по которому нужно сконвертировать число.' + chr(10) + chr(10) +
     2211                    "ПРИМЕР:"                                                         + chr(10) + chr(10) +
     2212                    '/* **************************************************** *\' + chr(10) +
     2213                    ' *                                                      *'  + chr(10) +
     2214                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2215                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2216                                                                            '*'  + chr(10) +
     2217                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2218                    ' *                                                      *'  + chr(10) +
     2219                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2220                    ' *                                                      *'  + chr(10) +
     2221                    '\* **************************************************** */' + chr(10) + chr(10) +
     2222                    "~&SCOPED-DEFINE f-l Base2Int"                                    + chr(10) + chr(10) +
     2223                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                  + chr(10) + chr(10) +
     2224                    'DEFINE VARIABLE c_num  AS CHARACTER NO-UNDO INITIAL "GЖ" .'      + chr(10) +
     2225                    'DEFINE VARIABLE j_base AS INTEGER   NO-UNDO INITIAL 60 .'        + chr(10) + chr(10) +
     2226                    'MESSAGE'                                                         + chr(10) +
     2227                    '  c_num "по основанию" j_base "-->"'                             + chr(10) +
     2228                    '  Base2Int( c_num, j_base )'                                     + chr(10) +
     2229                    'VIEW-AS ALERT-BOX .'                                             + chr(10)
     2230         .
     2231       end.
     2232       when 'Base2Int64'
     2233       then do:
     2234         assign
     2235           p-help = 'Конвертация целого числа в целое число по заданному основанию.'  + chr(10) + chr(10) +
     2236                    "ФОРМАТ ВЫЗОВА:"                                                  + chr(10) +
     2237                    "Base2Int64 RETURNS INT64 ( INPUT i-image AS CHARACTER"           + chr(10) +
     2238                    "                         , INPUT i-base  AS INTEGER"             + chr(10) +
     2239                    "                         ) ."                                    + chr(10) + chr(10) +
     2240                    "ПАРАМЕТРЫ:"                                                      + chr(10) +
     2241                    '  i-image - целое число, которое нужно сконвертировать;'         + chr(10) +
     2242                    '  i-base  - основание, по которому нужно сконвертировать число.' + chr(10) + chr(10) +
     2243                    "ПРИМЕР:"                                                         + chr(10) + chr(10) +
     2244                    '/* **************************************************** *\' + chr(10) +
     2245                    ' *                                                      *'  + chr(10) +
     2246                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2247                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2248                                                                            '*'  + chr(10) +
     2249                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2250                    ' *                                                      *'  + chr(10) +
     2251                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2252                    ' *                                                      *'  + chr(10) +
     2253                    '\* **************************************************** */' + chr(10) + chr(10) +
     2254                    "~&SCOPED-DEFINE f-l Base2Int64"                                  + chr(10) + chr(10) +
     2255                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                  + chr(10) + chr(10) +
     2256                    'DEFINE VARIABLE c_num  AS CHARACTER NO-UNDO INITIAL "GЖ" .'      + chr(10) +
     2257                    'DEFINE VARIABLE j_base AS INTEGER   NO-UNDO INITIAL 60 .'        + chr(10) + chr(10) +
     2258                    'MESSAGE'                                                         + chr(10) +
     2259                    '  c_num "по основанию" j_base "-->"'                             + chr(10) +
     2260                    '  Base2Int64( c_num, j_base )'                                   + chr(10) +
     2261                    'VIEW-AS ALERT-BOX .'                                             + chr(10)
     2262         .
     2263       end.
     2264       when 'Int2Octal'
     2265       then do:
     2266         assign
     2267           p-help = 'Конвертация целого числа в его 8-ричное представление.' + chr(10) + chr(10) +
     2268                    "ФОРМАТ ВЫЗОВА:"                                         + chr(10) +
     2269                    "Int2Octal RETURNS CHARACTER ( INPUT INTEGER ) ."        + chr(10) + chr(10) +
     2270                    "ПРИМЕР:"                                                + chr(10) + chr(10) +
     2271                    '/* **************************************************** *\' + chr(10) +
     2272                    ' *                                                      *'  + chr(10) +
     2273                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2274                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2275                                                                            '*'  + chr(10) +
     2276                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2277                    ' *                                                      *'  + chr(10) +
     2278                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2279                    ' *                                                      *'  + chr(10) +
     2280                    '\* **************************************************** */' + chr(10) + chr(10) +
     2281                    "~&SCOPED-DEFINE f-l Int2Octal"                          + chr(10) + chr(10) +
     2282                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                         + chr(10) + chr(10) +
     2283                    'DEFINE VARIABLE j_num AS INTEGER NO-UNDO INITIAL 493 .' + chr(10) + chr(10) +
     2284                    'MESSAGE'                                                + chr(10) +
     2285                    '  j_num "-->" Int2Octal( j_num )'                       + chr(10) +
     2286                    'VIEW-AS ALERT-BOX .'                                    + chr(10)
     2287         .
     2288       end.
     2289       when 'Oct2Int'
     2290       then do:
     2291         assign
     2292           p-help = 'Конвертация 8-ричного целого числа в 10-тичное.'            + chr(10) + chr(10) +
     2293                    "ФОРМАТ ВЫЗОВА:"                                             + chr(10) +
     2294                    "Oct2Int RETURNS INTEGER ( INPUT CHARACTER ) ."              + chr(10) + chr(10) +
     2295                    "ПРИМЕР:"                                                    + chr(10) + chr(10) +
     2296                    '/* **************************************************** *\' + chr(10) +
     2297                    ' *                                                      *'  + chr(10) +
     2298                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2299                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2300                                                                            '*'  + chr(10) +
     2301                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2302                    ' *                                                      *'  + chr(10) +
     2303                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2304                    ' *                                                      *'  + chr(10) +
     2305                    '\* **************************************************** */' + chr(10) + chr(10) +
     2306                    "~&SCOPED-DEFINE f-l Oct2Int"                                + chr(10) + chr(10) +
     2307                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                             + chr(10) + chr(10) +
     2308                    'DEFINE VARIABLE c_num AS CHARACTER NO-UNDO INITIAL "377" .' + chr(10) + chr(10) +
     2309                    'MESSAGE'                                                    + chr(10) +
     2310                    '  c_num "-->" Oct2Int( c_num )'                             + chr(10) +
     2311                    'VIEW-AS ALERT-BOX .'                                        + chr(10)
     2312         .
     2313       end.
     2314       when 'Int2Bin'
     2315       then do:
     2316         assign
     2317           p-help = 'Конвертация целого числа в его двоичное представление.' + chr(10) + chr(10) +
     2318                    "ФОРМАТ ВЫЗОВА:"                                         + chr(10) +
     2319                    "Int2Bin RETURNS CHARACTER ( INPUT INTEGER ) ."          + chr(10) + chr(10) +
     2320                    "ПРИМЕР:"                                                + chr(10) + chr(10) +
     2321                    '/* **************************************************** *\' + chr(10) +
     2322                    ' *                                                      *'  + chr(10) +
     2323                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2324                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2325                                                                            '*'  + chr(10) +
     2326                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2327                    ' *                                                      *'  + chr(10) +
     2328                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2329                    ' *                                                      *'  + chr(10) +
     2330                    '\* **************************************************** */' + chr(10) + chr(10) +
     2331                    "~&SCOPED-DEFINE f-l Int2Bin"                            + chr(10) + chr(10) +
     2332                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                         + chr(10) + chr(10) +
     2333                    'DEFINE VARIABLE j_num AS INTEGER NO-UNDO INITIAL 15 .'  + chr(10) + chr(10) +
     2334                    'MESSAGE'                                                + chr(10) +
     2335                    '  j_num "-->" Int2Bin( j_num )'                         + chr(10) +
     2336                    'VIEW-AS ALERT-BOX .'                                    + chr(10)
     2337         .
     2338       end.
     2339       when 'Bin2Int'
     2340       then do:
     2341         assign
     2342           p-help = 'Конвертация двоичного целого числа в 10-тичное.'              + chr(10) + chr(10) +
     2343                    "ФОРМАТ ВЫЗОВА:"                                               + chr(10) +
     2344                    "Bin2Int RETURNS INTEGER ( INPUT CHARACTER ) ."                + chr(10) + chr(10) +
     2345                    "ПРИМЕР:"                                                      + chr(10) + chr(10) +
     2346                    '/* **************************************************** *\' + chr(10) +
     2347                    ' *                                                      *'  + chr(10) +
     2348                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2349                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2350                                                                            '*'  + chr(10) +
     2351                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2352                    ' *                                                      *'  + chr(10) +
     2353                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2354                    ' *                                                      *'  + chr(10) +
     2355                    '\* **************************************************** */' + chr(10) + chr(10) +
     2356                    "~&SCOPED-DEFINE f-l Bin2Int"                                  + chr(10) + chr(10) +
     2357                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                               + chr(10) + chr(10) +
     2358                    'DEFINE VARIABLE c_num AS CHARACTER NO-UNDO INITIAL "11111" .' + chr(10) + chr(10) +
     2359                    'MESSAGE'                                                      + chr(10) +
     2360                    '  c_num "-->" Bin2Int( c_num )'                               + chr(10) +
     2361                    'VIEW-AS ALERT-BOX .'                                          + chr(10)
     2362         .
     2363       end.
     2364       otherwise do:
     2365         run GetFunctionHelp2 in this-procedure
     2366           (  input p-name
     2367           , output p-help
     2368           ) .
     2369       end.
     2370     end case.
     2371   end procedure.
     2372   procedure GetFunctionHelp2 :
     2373     define  input parameter p-name as character no-undo .
     2374     define output parameter p-help as character no-undo .
     2375     case p-name :
     2376       when 'sets-intersection'
     2377       then do:
     2378         assign
     2379           p-help = 'Пересечение двух множеств, заданных списками. '                            +
     2380                    'Возвращает результирующее множество (список).'                             + chr(10) + chr(10) +
     2381                    "ФОРМАТ ВЫЗОВА:"                                                            + chr(10) +
     2382                    "sets-intersection RETURNS CHARACTER ( INPUT i-list-1    AS CHARACTER"      + chr(10) +
     2383                    "                                    , INPUT i-list-2    AS CHARACTER"      + chr(10) +
     2384                    "                                    , INPUT i-delimiter AS CHARACTER"      + chr(10) +
     2385                    "                                    ) ."                                   + chr(10) + chr(10) +
     2386                    "ПАРАМЕТРЫ:"                                                                + chr(10) +
     2387                    '  i-list-1    - 1-й список;'                                               + chr(10) +
     2388                    '  i-list-2    - 2-й список;'                                               + chr(10) +
     2389                    '  i-delimiter - разделитель в списках; если не указан, то ",".'            + chr(10) + chr(10) +
     2390                    "ПРИМЕР:"                                                                   + chr(10) + chr(10) +
     2391                    '/* **************************************************** *\' + chr(10) +
     2392                    ' *                                                      *'  + chr(10) +
     2393                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2394                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2395                                                                            '*'  + chr(10) +
     2396                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2397                    ' *                                                      *'  + chr(10) +
     2398                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2399                    ' *                                                      *'  + chr(10) +
     2400                    '\* **************************************************** */' + chr(10) + chr(10) +
     2401                    "~&SCOPED-DEFINE f-l sets-intersection"                                     + chr(10) + chr(10) +
     2402                    "~{ cmp/str-glbl.i        ~}"                                               + chr(10) +
     2403                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                                            + chr(10) + chr(10) +
     2404                    'DEFINE VARIABLE v_list1 AS CHARACTER NO-UNDO INITIAL "":U .'               + chr(10) +
     2405                    'DEFINE VARIABLE v_list2 AS CHARACTER NO-UNDO INITIAL "":U .'               + chr(10) +
     2406                    'DEFINE VARIABLE v_delim AS CHARACTER NO-UNDO INITIAL "":U .'               + chr(10) + chr(10) +
     2407                    'ASSIGN'                                                                    + chr(10) +
     2408                    '  v_list1 = "Aa,Bb,Cc,Dd,Ee,Ff,Gg,Hh"'                                     + chr(10) +
     2409                    '  v_list2 = "Ff,Gg,Hh,Ii,Jj,Kk,Ll,Mm"'                                     + chr(10) +
     2410                    '  v_delim = ~{~&comma-char~}'                                              + chr(10) +
     2411                    '.'                                                                         + chr(10) +
     2412                    'MESSAGE'                                                                   + chr(10) +
     2413                    '  "1-й список:"                     v_list1                     SKIP( 0 )' + chr(10) +
     2414                    '  "2-й список:"                              v_list2            SKIP( 0 )' + chr(10) +
     2415                    '  "Пересечение:" sets-intersection( v_list1, v_list2, v_delim ) SKIP( 0 )' + chr(10) +
     2416                    'VIEW-AS ALERT-BOX .'                                                       + chr(10)
     2417         .
     2418       end.
     2419       when 'Week-Num'
     2420       then do:
     2421         assign
     2422           p-help = 'Возвращает номер недели по дате.'                   + chr(10) + chr(10) +
     2423                    "ФОРМАТ ВЫЗОВА:"                                     + chr(10) +
     2424                    "Week-Num RETURNS INTEGER ( INPUT DATE ) ."          + chr(10) + chr(10) +
     2425                    "ПРИМЕР:"                                            + chr(10) + chr(10) +
     2426                    '/* **************************************************** *\' + chr(10) +
     2427                    ' *                                                      *'  + chr(10) +
     2428                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2429                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2430                                                                            '*'  + chr(10) +
     2431                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2432                    ' *                                                      *'  + chr(10) +
     2433                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2434                    ' *                                                      *'  + chr(10) +
     2435                    '\* **************************************************** */' + chr(10) + chr(10) +
     2436                    "~&SCOPED-DEFINE f-l Week-Num"                       + chr(10) + chr(10) +
     2437                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                     + chr(10) + chr(10) +
     2438                    'DEFINE VARIABLE t_date AS DATE NO-UNDO INITIAL ? .' + chr(10) + chr(10) +
     2439                    'ASSIGN'                                             + chr(10) +
     2440                    '  t_date = TODAY'                                   + chr(10) +
     2441                    '.'                                                  + chr(10) +
     2442                    'MESSAGE'                                            + chr(10) +
     2443                    '  "Дата:"                   t_date   SKIP( 0 )'     + chr(10) +
     2444                    '  "Номер недели:" Week-Num( t_date ) SKIP( 0 )'     + chr(10) +
     2445                    'VIEW-AS ALERT-BOX .'                                + chr(10)
     2446         .
     2447       end.
     2448       when 'Week-From'
     2449       then do:
     2450         assign
     2451           p-help = 'Возвращает дату начала недели.'                        + chr(10) + chr(10) +
     2452                    "ФОРМАТ ВЫЗОВА:"                                        + chr(10) +
     2453                    "Week-From RETURNS DATE ( INPUT i-week AS INTEGER,"     + chr(10) +
     2454                    "                       , INPUT i-year AS INTEGER"      + chr(10) +
     2455                    "                       ) ."                            + chr(10) + chr(10) +
     2456                    "ПАРАМЕТРЫ:"                                            + chr(10) +
     2457                    '  i-week - номер недели в году;'                       + chr(10) +
     2458                    '  i-year - год; если не указан, то берется текущий.'   + chr(10) + chr(10) +
     2459                    "ПРИМЕР:"                                               + chr(10) + chr(10) +
     2460                    '/* **************************************************** *\' + chr(10) +
     2461                    ' *                                                      *'  + chr(10) +
     2462                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2463                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2464                                                                            '*'  + chr(10) +
     2465                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2466                    ' *                                                      *'  + chr(10) +
     2467                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2468                    ' *                                                      *'  + chr(10) +
     2469                    '\* **************************************************** */' + chr(10) + chr(10) +
     2470                    "~&SCOPED-DEFINE f-l Week-Num,Week-From"                + chr(10) + chr(10) +
     2471                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                        + chr(10) + chr(10) +
     2472                    'DEFINE VARIABLE t_date AS DATE    NO-UNDO INITIAL ? .' + chr(10) +
     2473                    'DEFINE VARIABLE j_week AS INTEGER NO-UNDO INITIAL 0 .' + chr(10) + chr(10) +
     2474                    'ASSIGN'                                                + chr(10) +
     2475                    '  t_date = TODAY'                                      + chr(10) +
     2476                    '  j_week = Week-Num( t_date )'                         + chr(10) +
     2477                    '.'                                                     + chr(10) +
     2478                    'MESSAGE'                                               + chr(10) +
     2479                    '  "Дата начала текущей недели:"'                       + chr(10) +
     2480                    '  Week-From( j_week, YEAR( t_date ) ) SKIP( 1 )'       + chr(10) +
     2481                    '  "Номер недели:" Week-Num( t_date )  SKIP( 0 )'       + chr(10) +
     2482                    '  "Текущая дата:" t_date              SKIP( 0 )'       + chr(10) +
     2483                    'VIEW-AS ALERT-BOX .'                                   + chr(10)
     2484         .
     2485       end.
     2486       when 'Week-Till'
     2487       then do:
     2488         assign
     2489           p-help = 'Возвращает дату окончания недели.'                     + chr(10) + chr(10) +
     2490                    "ФОРМАТ ВЫЗОВА:"                                        + chr(10) +
     2491                    "Week-Till RETURNS DATE ( INPUT i-week AS INTEGER"      + chr(10) +
     2492                    "                       , INPUT i-year AS INTEGER"      + chr(10) +
     2493                    "                       ) ."                            + chr(10) + chr(10) +
     2494                    "ПАРАМЕТРЫ:"                                            + chr(10) +
     2495                    '  i-week - номер недели в году;'                       + chr(10) +
     2496                    '  i-year - год; если не указан, то берется текущий.'   + chr(10) + chr(10) +
     2497                    "ПРИМЕР:"                                               + chr(10) + chr(10) +
     2498                    '/* **************************************************** *\' + chr(10) +
     2499                    ' *                                                      *'  + chr(10) +
     2500                    ' * Файл: stdfnhlp.p                                     *'  + chr(10) +
     2501                    ' * Функция: ' + p-name + fill( ' ':U, 44 - length( p-name ) )             +
     2502                                                                            '*'  + chr(10) +
     2503                    ' * Автор: Булгаков Андрей Николаевич                    *'  + chr(10) +
     2504                    ' *                                                      *'  + chr(10) +
     2505                    ' * Описание стандартных функций из std-func.i (помощь). *'  + chr(10) +
     2506                    ' *                                                      *'  + chr(10) +
     2507                    '\* **************************************************** */' + chr(10) + chr(10) +
     2508                    "~&SCOPED-DEFINE f-l Week-Num,Week-Till"                + chr(10) + chr(10) +
     2509                    "~{ gbl/std-func.i ~{~&f-l~} ~}"                        + chr(10) + chr(10) +
     2510                    'DEFINE VARIABLE t_date AS DATE    NO-UNDO INITIAL ? .' + chr(10) +
     2511                    'DEFINE VARIABLE j_week AS INTEGER NO-UNDO INITIAL 0 .' + chr(10) + chr(10) +
     2512                    'ASSIGN'                                                + chr(10) +
     2513                    '  t_date = TODAY'                                      + chr(10) +
     2514                    '  j_week = Week-Num( t_date )'                         + chr(10) +
     2515                    '.'                                                     + chr(10) +
