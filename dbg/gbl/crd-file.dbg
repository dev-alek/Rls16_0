        1   DEFINE OUTPUT PARAMETER p-first-track AS CHARACTER NO-UNDO.
        2   DEFINE OUTPUT PARAMETER p-valid-date AS DATE NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-prefix AS character NO-UNDO.
        4   def var vss-revision    as character no-undo init "$Revision$":U .
        5   def var vss-author      as character no-undo init "$Author$":U .
        6   def var vss-date        as character no-undo init "$Date$":U .
        7   def var vss-workfile    as character no-undo init "$Workfile$":U .
        8   def var vss-archive     as character no-undo init "$Archive$":U .
        9   def var vss-description as character no-undo init "Параметры для изготовления карт".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   define new global shared variable g#library  as handle no-undo .
      319   define new global shared variable g#library2 as handle no-undo .
      320   define   shared variable g#auto as logical no-undo.
      321   define   shared variable g#news as logical no-undo.
      322   define   shared variable g#oxml as logical no-undo.
      323   define   shared variable g#esys as logical no-undo.
      324   define   shared variable g#news-source-db as integer no-undo.
      325   define   shared variable g#esys-source-esys as integer no-undo.
      326   define   shared variable g#db-num as integer   no-undo .
      327   define   shared variable g#userid as character no-undo .
      328   define   shared variable g#passwd as character no-undo .
      329   procedure proc-alt-shift-f2:
      330     if not ibs.th.gbl.gbl-var:rcode
      331   then
      332     run gbl\inidebug.p .
      333   end.
      334   procedure proc-alt-shift-f3:
      335     run gbl/prvssinf.p
      336       ( input this-procedure
      337       ) .
      338   end.
      339   define variable v-inform-launched as logical no-undo initial false .
      340   procedure proc-alt-shift-f4:
      341     define variable v-action as character no-undo .
      342     if v-inform-launched = false then do:
      343       assign
      344         v-inform-launched = true
      345       .
      346       run gbl/d-inform.w
      347         (  input self
      348         ,  input this-procedure
      349         , output v-action
      350         ) no-error .
      351       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      352       assign
      353         v-inform-launched = false
      354       .
      355     end.
      356   end.
      357   procedure proc-alt-f1:
      358     run gbl/corrhelp.p
      359       (input this-procedure
      360       ) .
      361   end .
      362   on alt-shift-f2 anywhere do:
      363     run proc-alt-shift-f2.
      364   end.
      365   on alt-shift-f3 anywhere do:
      366     run proc-alt-shift-f3 in this-procedure .
      367   end.
      368   on alt-shift-f4 anywhere do:
      369     run proc-alt-shift-f4 in this-procedure.
      370   end.
      371   on alt-f1 anywhere do:
      372     run proc-alt-f1 in this-procedure .
      373   end.
      374    DEFINE VARIABLE v-result AS CHARACTER NO-UNDO.
      375   DEFINE BUTTON B-exit AUTO-GO
      376        LABEL "&Ввод"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE BUTTON B-Help
      380        LABEL "Помо&щь"
      381        SIZE 10 BY 1
      382        BGCOLOR 8 .
      383   DEFINE BUTTON b-quit AUTO-END-KEY
      384        LABEL "&Отмена"
      385        SIZE 10 BY 1
      386        BGCOLOR 8 .
      387   DEFINE VARIABLE f-prefix AS CHARACTER FORMAT "X(18)":U
      388        LABEL "Префикс"
      389        VIEW-AS FILL-IN
      390        SIZE 13 BY 1 NO-UNDO.
      391   DEFINE VARIABLE f-valid-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      392        LABEL "Дата истечения срока действия"
      393        VIEW-AS FILL-IN
      394        SIZE 12 BY 1 NO-UNDO.
      395   DEFINE VARIABLE RS-codir AS CHARACTER
      396        VIEW-AS RADIO-SET VERTICAL
      397        RADIO-BUTTONS
      398             "Не выводить 1-ю дорожку  (имя держателя)", "",
      399   "WINDOWS 1251", "1251",
      400   "KOI8-R", "KOI8-R",
      401   "DOS", "ibm866"
      402        SIZE 50 BY 2.63 NO-UNDO.
      403   DEFINE FRAME Dialog-Frame
      404        B-exit AT ROW 1 COL 1
      405        b-quit AT ROW 1 COL 11
      406        B-Help AT ROW 1 COL 54.88
      407        RS-codir AT ROW 2.25 COL 3 NO-LABEL
      408        f-valid-date AT ROW 6 COL 32.5 COLON-ALIGNED
      409        f-prefix AT ROW 9 COL 32 COLON-ALIGNED
      410        "(для карт, у которых срок действия не определен)" VIEW-AS TEXT
      411             SIZE 48.5 BY 1 AT ROW 7 COL 3
      412             FGCOLOR 4
      413        SPACE(13.37) SKIP(2.20)
      414       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      415            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      416            TITLE "Параметры для изготовления карт"
      417            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      418   ASSIGN
      419          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      420          FRAME Dialog-Frame:HIDDEN           = TRUE.
      421   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      422   DO:
      423     APPLY "END-ERROR":U TO SELF.
      424   END.
      425   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      426   DO:
      427     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      428     DEFINE VARIABLE ii AS integer NO-UNDO.
      429     ASSIGN
      430     rs-codir
      431     f-valid-date
      432     f-prefix
      433     .
      434     IF f-valid-date = ?
      435     OR f-valid-date <  TODAY THEN DO:
      436         MESSAGE
      437         "Неверно задата дата"
      438         VIEW-AS ALERT-BOX ERROR.
      439         RETURN NO-APPLY.
      440     END.
      441     DO ii = 1 TO LENGTH(f-prefix):
      442       IF INDEX("0123456789", SUBSTRING(f-prefix, ii, 1)) = 0 THEN DO:
      443           MESSAGE
      444           "Неверный (нецифровой) префикс"
      445           VIEW-AS ALERT-BOX ERROR.
      446           RETURN NO-APPLY.
      447       END.
      448     END.
      449     ASSIGN
      450     p-first-track = rs-codir
      451     p-valid-date = f-valid-date
      452     p-prefix = f-prefix
      453     .
      454     MESSAGE
      455     "В файле для изготовления карт" SKIP(0)
      456     (IF p-first-track <> '':U
      457     THEN substitute("1-я дорожка с именем держателя формируется в кодировке &1", p-first-track)
      458     ELSE "не выводится 1-я дорожка") SKIP(0)
      459     substitute("префикс для всех карт будет взят равным &1", p-prefix) SKIP(0)
      460     substitute("дата истечения срока действия для карт, у которых срок действия НЕ ОПРЕДЕЛЕН, будет взята равной &1", string(p-valid-date, "99/99/9999")) SKIP(0)
      461     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      462     IF NOT glog THEN DO:
      463         RETURN NO-APPLY.
      464     END.
      465   END.
      466   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      467   DO:
      468     v-result = "error".
      469   END.
      470   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      471   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      472   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      473   on help of frame Dialog-Frame
      474   do:
      475     run gbl/app_help.p
      476       (input this-procedure :file-name
      477       ,input ''
      478       ,input ?
      479       ) no-error.
      480     if error-status :error then do:
      481       message
      482         "Ошибка при вызове помощи"
      483         error-status :get-message(1)
      484         view-as alert-box .
      485     end.
      486   end.
      487   run minbtn-set in this-procedure .
      488   on choose of b-help in frame Dialog-Frame
      489   do:
      490     apply "help":u to frame Dialog-Frame .
      491   end.
      492   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   procedure minbtn-set :
      494       do
      495           on error undo, return error return-value
      496           :
      497           define variable ii              as integer       no-undo .
      498           define variable fh              as widget-handle no-undo .
      499           define variable hh              as widget-handle no-undo .
      500           define variable v-h             as handle        extent 4 no-undo .
      501           define variable v-name-button   as character     no-undo .
      502           define variable v-help-old-x    as decimal       no-undo .
      503           define variable v-help-old-y    as decimal       no-undo .
      504           define variable v-help-old-size as decimal       no-undo .
      505           define variable v-frame-width   as decimal       no-undo .
      506           define variable jj              as integer       no-undo .
      507           do
      508               on error undo, return error
      509               :
      510               assign
      511                   v-frame-width = frame Dialog-Frame:width - 0.3
      512                   fh            = frame Dialog-Frame:first-child
      513                   hh            = fh:first-child
      514                   ii            = 1
      515                   .
      516               do while valid-handle(hh):
      517                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      518                   do:
      519                       case lc(hh:name) :
      520                           when "b-help" then
      521                               do:
      522                                   hh:load-image-up("cmp/b-help.bmp":u) .
      523                                   hh:load-image-down("cmp/b-help.bmp":u) .
      524                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      525                                   hh:TOOLTIP = "Помощь" .
      526                                   v-help-old-x = hh:column .
      527                                   v-help-old-y = hh:row    .
      528                                   v-help-old-size = hh:width .
      529                                   hh:width-chars = 2.5 .
      530                               end.
      531                           when "b-print" then
      532                               do:
      533                                   hh:load-image("cmp/b-print.bmp":u) .
      534                                   hh:TOOLTIP = "Печать" .
      535                                   v-h[ii] = hh:handle .
      536                                   ii = ii + 1 .
      537                                   hh:width-chars = 3 .
      538                               end.
      539                           when "b-history" or
      540                           when "b-hist" then
      541                               do:
      542                                   hh:load-image("cmp/b-hist.bmp":u) .
      543                                   hh:TOOLTIP = "История" .
      544                                   v-h[ii] = hh:handle .
      545                                   ii = ii + 1 .
      546                                   hh:width-chars = 3 .
      547                               end.
      548                           when "b-sch" then
      549                               do:
      550                                   hh:load-image("cmp/b-sch.bmp":u) .
      551                                   hh:TOOLTIP = "Установка Фильтра" .
      552                                   v-h[ii] = hh:handle .
      553                                   ii = ii + 1 .
      554                                   hh:width-chars = 3 .
      555                               end.
      556                           when "b-hist-user" then
      557                               do:
      558                                   hh:load-image("cmp/b-hist.bmp":u) .
      559                                   hh:TOOLTIP = "История пользователя" .
      560                                   ii = ii + 1 .
      561                               end.
      562                       end case.
      563                   end.
      564                   hh = hh:next-sibling.
      565               end.
      566               b-help:column = v-frame-width - b-help:width-chars.
      567               jj = 0.
      568               repeat ii = 4 to 1 by -1 :
      569                   if valid-handle (v-h[ii] ) then
      570                   do:
      571                       jj  = jj + 1 .
      572                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      573                       v-h[ii]:row    = v-help-old-y .
      574                   end.
      575               end.
      576           end.
      577       end.
      578   end procedure.
      579   MAIN-BLOCK:
      580   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      581      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      582     RUN enable_UI.
      583     WAIT-FOR GO OF FRAME Dialog-Frame.
      584     RETURN v-result.
      585   END.
      586   RUN disable_UI.
      587   PROCEDURE disable_UI :
      588     HIDE FRAME Dialog-Frame.
      589   END PROCEDURE.
      590   PROCEDURE enable_UI :
      591     DISPLAY RS-codir f-valid-date f-prefix
      592         WITH FRAME Dialog-Frame.
      593     ENABLE B-exit b-quit B-Help RS-codir f-valid-date f-prefix
      594         WITH FRAME Dialog-Frame.
      595     VIEW FRAME Dialog-Frame.
      596   END PROCEDURE.
