        1   block-level on error undo, throw.
        2   define input  parameter p-directory-out  as character no-undo .
        3   define input  parameter p-file-name      as character no-undo .
        4   define input  parameter p-session-valid  as logical   no-undo .
        5   define input  parameter p-error-message  as character no-undo .
        6   define input  parameter p-user-login     as character no-undo .
        7   define input  parameter p-obj-type       as character no-undo .
        8   define input  parameter p-obj-code       as character no-undo .
        9   define input  parameter p-host-code      as character no-undo .
       10   define input  parameter p-cli-type       as character no-undo .
       11   define input  parameter p-cli-code       as character no-undo .
       12   define input  parameter p-doc-type       as character no-undo .
       13   define input  parameter p-doc-status     as character no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: rt-req06.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req06.p $":U .
       19   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 06. Приемка товара. Выбор по номеру".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure integerm :
       82     define input  parameter p-string      as character no-undo .
       83     define input  parameter p-allow-sign  as logical   no-undo .
       84     define input  parameter p-allow-comma as logical   no-undo .
       85     define output parameter p-value       as integer   no-undo .
       86     define output parameter p-data-valid  as logical   no-undo .
       87     define output parameter p-message     as character no-undo .
       88     define variable v-replace-string as character no-undo .
       89     do
       90     on error undo, return error return-value
       91     :
       92       if p-string = ?
       93       then do:
       94         assign
       95           p-value      = ?
       96           p-data-valid = false
       97           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
       98         .
       99         return .
      100       end.
      101       if p-string = ""
      102       then do:
      103         assign
      104           p-value      = ?
      105           p-data-valid = false
      106           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      107         .
      108         return .
      109       end.
      110       assign
      111         p-value = integer(p-string) no-error
      112       .
      113       if error-status :error = true
      114       then do:
      115         assign
      116           p-value      = ?
      117           p-data-valid = false
      118           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      119                                    ,p-string
      120                                    )
      121         .
      122         return .
      123       end.
      124       if index(p-string, ' ':u) > 0
      125       then do:
      126         assign
      127           p-value      = ?
      128           p-data-valid = false
      129           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      130                                    + "Строка содержит символы пробела"
      131                                    ,p-string
      132                                    )
      133         .
      134         return .
      135       end.
      136       assign
      137         v-replace-string = p-string
      138         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      139         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      140         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      141         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      147       .
      148       if p-allow-sign = true
      149       then do:
      150         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      151         then do:
      152           assign
      153             v-replace-string = substring(v-replace-string, 2)
      154           .
      155         end.
      156       end.
      157       else do:
      158         if substring(v-replace-string, 1, 1) = '+':u
      159         then do:
      160           assign
      161             p-value      = ?
      162             p-data-valid = false
      163             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      164                                     + "Задан параметр недопустимости знака челого числа. "
      165                                     + "Строка содержит символ плюс. "
      166                                     ,p-string
      167                                     )
      168           .
      169           return .
      170         end.
      171         if substring(v-replace-string, 1, 1) = '-':u
      172         then do:
      173           assign
      174             p-value      = ?
      175             p-data-valid = false
      176             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      177                                     + "Задан параметр недопустимости знака челого числа. "
      178                                     + "Строка содержит символ минус. "
      179                                     ,p-string
      180                                     )
      181           .
      182           return .
      183         end.
      184       end.
      185       if p-allow-comma = true
      186       then do:
      187         assign
      188           v-replace-string = replace(v-replace-string, ',', '')
      189         .
      190       end.
      191       else do:
      192         if index(v-replace-string, ',') > 0
      193         then do:
      194           assign
      195             p-value      = ?
      196             p-data-valid = false
      197             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      198                                     + "Задан параметр недопустимости знака разделителя тысяч."
      199                                     + "Строка содержит знак разделителя тысяч. "
      200                                     ,p-string
      201                                     )
      202           .
      203           return .
      204         end.
      205       end.
      206       if index(p-string, '.') > 0
      207       then do:
      208         assign
      209           p-value      = ?
      210           p-data-valid = false
      211           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      212                                    + "Строка содержит знак десятичной точки"
      213                                    ,p-string
      214                                    )
      215         .
      216         return .
      217       end.
      218       if v-replace-string <> fill('9', length(v-replace-string))
      219       then do:
      220         assign
      221           p-value      = ?
      222           p-data-valid = false
      223           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      224                                    + "Встречены символы, недопустимые для целого числа '&2'"
      225                                    ,p-string
      226                                    ,replace(v-replace-string, '9', '')
      227                                    )
      228         .
      229         return .
      230       end.
      231       assign
      232         p-data-valid = true
      233         p-message    = ""
      234       .
      235     end.
      236   end procedure.
      237   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   function rtencode returns character
      239     ( p-init-string as character
      240     ) :
      241     define variable v-encode-string as character no-undo .
      242     if p-init-string = ?
      243     then do:
      244       assign
      245         v-encode-string = '?':u
      246       .
      247       return v-encode-string .
      248     end.
      249     if p-init-string = '?':u
      250     then do:
      251       assign
      252         v-encode-string = '~~077':u
      253       .
      254       return v-encode-string .
      255     end.
      256     assign
      257       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      258       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      259       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      260     .
      261     return v-encode-string .
      262   end function .
      263   define stream sout .
      264   define variable v-status        as character no-undo .
      265   define variable v-error-message as character no-undo .
      266   do
      267   on error undo, return error return-value
      268   :
      269     if p-session-valid = true
      270     then do:
      271       run check-data in this-procedure
      272         (output  v-status
      273         ,output  v-error-message
      274         ) no-error .
      275       if error-status :error
      276       then do:
      277         undo, return error substitute("ошибка при вызове функции check-data. &1, &2"
      278                                     ,error-status :get-message(1)
      279                                     ,return-value
      280                                     ) .
      281       end.
      282     end.
      283     else do:
      284       assign
      285         v-status        = '1'
      286         v-error-message = p-error-message
      287       .
      288     end.
      289     define variable v-temp-file-name as character no-undo .
      290     assign
      291       v-temp-file-name = entry(1, p-file-name, '.':u) + '.tmp':u
      292     .
      293     output stream sout to value(p-directory-out + '/':u + v-temp-file-name) .
      294     put stream sout unformatted substitute('status:&1', rtencode(v-status))
      295                                 + chr(10) .
      296     put stream sout unformatted substitute('message:&1',rtencode(v-error-message))
      297                                 + chr(10) .
      298     output stream sout close .
      299     os-delete value(p-directory-out + '/':u + p-file-name) .
      300     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      301               value(p-directory-out + '/':u + p-file-name)
      302               .
      303   end.
      304   procedure check-data :
      305     define output parameter p-status        as character no-undo .
      306     define output parameter p-error-message as character no-undo .
      307     define buffer buf_clients    for ub.clients .
      308     define buffer buf_sysconf    for ub.sysconf .
      309     define buffer buf_sys-ctrl   for ub.sys-ctrl .
      310     define buffer buf_user-login for ub.user-login .
      311     do
      312     on error undo, return error return-value
      313     :
      314       find first buf_sys-ctrl no-lock .
      315       find first buf_user-login no-lock
      316         where buf_user-login.db-num = buf_sys-ctrl.db-num
      317           and buf_user-login.status_    = 0
      318           and buf_user-login.user-login = p-user-login
      319         no-error .
      320       if not available buf_user-login
      321       then do:
      322         assign
      323           p-status        = '1':u
      324           p-error-message = substitute("Неизвестный пользователь &1"
      325                                       ,p-user-login
      326                                       )
      327         .
      328         return .
      329       end.
      330       define variable v-obj-code      as integer   no-undo .
      331       define variable v-data-valid    as logical   no-undo .
      332       define variable v-error-message as character no-undo .
      333       if p-obj-code = ""
      334       then do:
      335         assign
      336           p-status        = '1':u
      337           p-error-message = "Не задан код объекта"
      338         .
      339         return .
      340       end.
      341       run integerm in this-procedure
      342         (input  p-obj-code
      343         ,input  false
      344         ,input  false
      345         ,output v-obj-code
      346         ,output v-data-valid
      347         ,output v-error-message
      348         ) .
      349       if v-data-valid <> true
      350       then do:
      351         assign
      352           p-status        = '1':u
      353           p-error-message = substitute("Ошибка преобразования кода объекта &1. &2"
      354                                       ,p-obj-code
      355                                       ,v-error-message
      356                                       )
      357         .
      358         return .
      359       end.
      360       find first buf_clients no-lock
      361         where buf_clients.obj-type = p-obj-type
      362           and buf_clients.obj-code = v-obj-code
      363         no-error .
      364       if not available buf_clients
      365       then do:
      366         assign
      367           p-status        = '1':u
      368           p-error-message = substitute("Не найден объект &1 &2"
      369                                       ,p-obj-type
      370                                       ,v-obj-code
      371                                       )
      372         .
      373         return .
      374       end.
      375       if  p-obj-type <> 'маг':U
      376       and p-obj-type <> 'скл':U
      377       then do:
      378         assign
      379           p-status        = '1':u
      380           p-error-message = substitute("Неправильный тип объекта &1 &2"
      381                                       ,p-obj-type
      382                                       ,v-obj-code
      383                                       )
      384         .
      385         return .
      386       end.
      387       define variable v-host-code as integer   no-undo .
      388       run integerm in this-procedure
      389         (input  p-host-code
      390         ,input  false
      391         ,input  false
      392         ,output v-host-code
      393         ,output v-data-valid
      394         ,output v-error-message
      395         ) .
      396       if v-data-valid <> true
      397       then do:
      398         assign
      399           p-status        = '1':u
      400           p-error-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      401                                       ,p-host-code
      402                                       ,v-error-message
      403                                       )
      404         .
      405         return .
      406       end.
      407       define variable v-obj-host-code as integer   no-undo .
      408   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      410     (input  buf_clients.obj-type
      411     ,input  buf_clients.obj-code
      412     ,output v-obj-host-code
      413     )  .
      414       if v-host-code <> v-obj-host-code
      415       then do:
      416         assign
      417           p-status        = '1':u
      418           p-error-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      419                                       ,p-host-code
      420                                       ,v-obj-host-code
      421                                       ,buf_clients.obj-type
      422                                       ,buf_clients.obj-code
      423                                       )
      424         .
      425         return .
      426       end.
      427       define variable v-object-available as logical   no-undo .
      428   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      430     (input  buf_sys-ctrl.db-num
      431     ,input  0
      432     ,input  buf_user-login.user-id
      433     ,input  buf_clients.obj-type
      434     ,input  buf_clients.obj-code
      435     ,output v-object-available
      436     )  .
      437       if v-object-available <> true
      438       then do:
      439         assign
      440           p-status        = '1':u
      441           p-error-message = substitute("Пользователю не доступен объект &1 &2"
      442                                       ,buf_clients.obj-type
      443                                       ,buf_clients.obj-code
      444                                       )
      445         .
      446         return .
      447       end.
      448       define variable v-valid-act   as logical   no-undo .
      449   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      450   do:
      451     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      452       (input  buf_sys-ctrl.db-num
      453       ,input  buf_user-login.user-id
      454       ,input  0
      455       ,input  'actn_rt-check-price_work':U
      456       ,input  'object':U
      457       ,input  v-host-code
      458       ,input  buf_clients.obj-type
      459       ,input  buf_clients.obj-code
      460       ,input  0
      461       ,input  0
      462       ,input  0
      463       ,input  false
      464       ,output v-valid-act
      465       )  .
      466   end.
      467       if v-valid-act <> true
      468       then do:
      469         assign
      470           p-status        = '1':u
      471           p-error-message = return-value
      472         .
      473         return .
      474       end.
      475       define variable v-cli-code      as integer   no-undo .
      476       if p-cli-code = ""
      477       then do:
      478         assign
      479           p-status        = '1':u
      480           p-error-message = "Не задан код поставщика"
      481         .
      482         return .
      483       end.
      484       run integerm in this-procedure
      485         (input  p-cli-code
      486         ,input  false
      487         ,input  false
      488         ,output v-cli-code
      489         ,output v-data-valid
      490         ,output v-error-message
      491         ) .
      492       if v-data-valid <> true
      493       then do:
      494         assign
      495           p-status        = '1':u
      496           p-error-message = substitute("Ошибка преобразования кода поставщика &1. &2"
      497                                       ,p-obj-code
      498                                       ,v-error-message
      499                                       )
      500         .
      501         return .
      502       end.
      503       find first buf_clients no-lock
      504         where buf_clients.obj-type = p-cli-type
      505           and buf_clients.obj-code = v-cli-code
      506         no-error .
      507       if not available buf_clients
      508       then do:
      509         assign
      510           p-status        = '1':u
      511           p-error-message = substitute("Не найден поставщик &1 &2"
      512                                       ,p-cli-type
      513                                       ,v-cli-code
      514                                       )
      515         .
      516         return .
      517       end.
      518       find first buf_sysconf no-lock
      519         where buf_sysconf.host-code = v-host-code
      520         no-error .
      521       if not available buf_sysconf
      522       then do:
      523         assign
      524           p-status        = '1':u
      525           p-error-message = substitute("Не найдена фирма &1"
      526                                       ,v-host-code
      527                                       )
      528         .
      529         return .
      530       end.
      531       case p-doc-type
      532       :
      533         when 'ПТ':u
      534         then do:
      535           if lookup(p-doc-status, 'поставка':u) = 0
      536           then do:
      537             assign
      538               p-status        = '1':u
      539               p-error-message = substitute("Не известный статус документа поставки &1"
      540                                           ,p-doc-status
      541                                           )
      542             .
      543             return .
      544           end.
      545           assign
      546             p-status        = '0':u
      547             p-error-message = '':u
      548           .
      549           return .
      550         end.
      551         when 'ПН':u
      552         then do:
      553           if lookup(p-doc-status, 'накл-':u + chr(44) + 'накл+':u) = 0
      554           then do:
      555             assign
      556               p-status        = '1':u
      557               p-error-message = substitute("Не известный статус документа внешнего прихода &1"
      558                                           ,p-doc-status
      559                                           )
      560             .
      561             return .
      562           end.
      563           define variable v-flag as logical   no-undo .
      564           if p-doc-status = 'накл-':u
      565           then do:
      566             assign
      567               v-flag = false
      568             .
      569           end.
      570           if p-doc-status = 'накл+':u
      571           then do:
      572             assign
      573               v-flag = true
      574             .
      575           end.
      576           assign
      577             p-status        = '0':u
      578             p-error-message = '':u
      579           .
      580           return .
      581         end.
      582         when 'ОР':U
      583         then do:
      584           if lookup(p-doc-status, 'запрос':u) = 0
      585           then do:
      586             assign
      587               p-status        = '1':u
      588               p-error-message = substitute( "Недопустимый статус заявки &1"
      589                                           , p-doc-status
      590                                           )
      591             .
      592             return .
      593           end.
      594           assign
      595             p-status        = '0':u
      596             p-error-message = '':u
      597           .
      598           return .
      599         end.
      600         when 'РН'
      601         then do:
      602           if lookup(p-doc-status, 'накл-':u) = 0
      603           then do:
      604             assign
      605               p-status        = '1':u
      606               p-error-message = substitute("Не известный статус документа внешнего расхода &1"
      607                                           ,p-doc-status
      608                                           )
      609             .
      610             return .
      611           end.
      612           assign
      613             p-status        = '0':u
      614             p-error-message = '':u
      615           .
      616           return .
      617         end.
      618         otherwise do:
      619           assign
      620             p-status        = '1':u
      621             p-error-message = substitute("Неизвестный тип документа &1"
      622                                         ,p-doc-type
      623                                         )
      624           .
      625           return .
      626         end.
      627       end case .
      628       assign
      629         p-status        = '1':u
      630         p-error-message = "rt-req06.p. Неизвестная ошибка"
      631       .
      632       return .
      633     end.
      634   end procedure.
