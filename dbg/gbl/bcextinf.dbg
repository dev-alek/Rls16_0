      137         when '08':U then do: assign p-info = p-info + "США и Канада"             . end.
      138         when '09':U then do: assign p-info = p-info + "США и Канада"             . end.
      139         when '10':U then do: assign p-info = p-info + "США и Канада"             . end.
      140         when '11':U then do: assign p-info = p-info + "США и Канада"             . end.
      141         when '12':U then do: assign p-info = p-info + "США и Канада"             . end.
      142         when '13':U then do: assign p-info = p-info + "США и Канада"             . end.
      143         when '20':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
      144         when '21':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
      145         when '22':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
      146         when '23':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
      147         when '24':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
      148         when '25':U then do: assign p-info = p-info + "Внутренняя нумерация"     . end.
