      191             when '385':U then do: assign p-info = p-info + "Хорватия"                     . end.
      192             when '387':U then do: assign p-info = p-info + "Босния-Герцеговина"           . end.
      193             when '470':U then do: assign p-info = p-info + "Япония"                       . end.
      194             when '471':U then do: assign p-info = p-info + "Тайвань"                      . end.
