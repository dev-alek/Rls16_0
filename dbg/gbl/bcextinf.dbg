        1   block-level on error undo, throw.
        2   define input  parameter p-bcode-type as character no-undo .
        3   define input  parameter p-b-str      as character no-undo .
        4   define output parameter p-info       as character no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: bcextinf.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: gbl/bcextinf.p $":U .
       10   def var vss-description as character no-undo init "Вернуть расширенную информацию о бар-коде".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   do
       66   on error undo, return error return-value
       67   :
       68     if p-bcode-type <> 'EAN13':U then do:
       69       message
       70         vss-workfile vss-revision vss-description skip
       71         "Ошибка задания входных параметров" skip
       72         "p-bcode-type" p-bcode-type skip
       73         view-as alert-box error .
       74       undo, return error .
       75     end.
       76     if p-bcode-type = "EAN13" then do:
       77       if length(p-b-str) <> 13 then do:
       78         return .
       79       end.
       80       assign
       81         p-info = 'EAN13 | ':u
       82       .
       83       define variable v-ind             as integer   no-undo .
       84       define variable v-char-ind        as integer   no-undo .
       85       define variable v-check-sum       as integer   no-undo .
       86       define variable v-check-sum-digit as character no-undo .
       87       define variable v-ind-mult        as integer   no-undo extent 12
       88         INIT [1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3 ] .
       89       define variable v-check-sum-dig   as character no-undo extent 10
       90         INIT ['0':U, '9':U, '8':U, '7':U, '6':U, '5':U, '4':U, '3':U, '2':U, '1':U] .
       91       assign
       92         v-check-sum = 0
       93       .
       94       do v-ind = 1 to 12
       95       :
       96         assign
       97           v-char-ind = index('0123456789':U, substring( p-b-str, v-ind, 1)) - 1
       98         .
       99         if v-char-ind >= 0
      100         and v-check-sum >= 0
      101         then do:
      102           assign
      103             v-check-sum = v-check-sum
      104                         + v-char-ind * v-ind-mult[v-ind]
      105           .
      106         end.
      107         else do:
      108           assign
      109             v-check-sum = -1
      110           .
      111         end.
      112       end.
      113       if v-check-sum > 0 then do:
      114         assign
      115           v-check-sum-digit = v-check-sum-dig[ v-check-sum mod 10 + 1]
      116         .
      117       end.
      118       if v-check-sum-digit = substring(p-b-str, 13, 1) then do:
      119         assign
      120           p-info = p-info + "Контр. сумма ПРАВИЛЬНАЯ | "
      121         .
      122       end.
      123       else do:
      124         assign
      125           p-info = p-info + "Контр. сумма ОШИБКА     | "
      126         .
      127       end.
      128       case substring(p-b-str, 1, 2) :
      129         when '00':U then do: assign p-info = p-info + "США и Канада"             . end.
      130         when '01':U then do: assign p-info = p-info + "США и Канада"             . end.
      131         when '02':U then do: assign p-info = p-info + "США и Канада"             . end.
      132         when '03':U then do: assign p-info = p-info + "США и Канада"             . end.
      133         when '04':U then do: assign p-info = p-info + "США и Канада"             . end.
      134         when '05':U then do: assign p-info = p-info + "США и Канада"             . end.
