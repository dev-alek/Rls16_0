      159         when '36':U then do: assign p-info = p-info + "Франция"                  . end.
      160         when '37':U then do: assign p-info = p-info + "Франция"                  . end.
      161         when '40':U then do: assign p-info = p-info + "Германия"                 . end.
      162         when '41':U then do: assign p-info = p-info + "Германия"                 . end.
      163         when '42':U then do: assign p-info = p-info + "Германия"                 . end.
      164         when '43':U then do: assign p-info = p-info + "Германия"                 . end.
      165         when '44':U then do: assign p-info = p-info + "Германия"                 . end.
      166         when '45':U then do: assign p-info = p-info + "Япония"                   . end.
      167         when '46':U then do: assign p-info = p-info + "РОССИЯ"                   . end.
