        1   block-level on error undo, throw.
        2   define input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter parrec-doc as recid no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: 2014/01/27 14:27:46 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: calc-trn.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: gbl/calc-trn.p $":U .
        9   define variable vss-description as character no-undo initial "Пересчет накладных по ее RECID без shared переменных.":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#lib-trn  as handle no-undo .
       69   define new global shared variable g#lib-trn2 as handle no-undo .
       70   define new global shared variable g#lib-trn3 as handle no-undo .
       71   define new global shared variable g#lib-trn4 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212     end.
      213   end procedure.
      214      procedure waitfram-show-this:
      215         define input  parameter iInterval as int64 no-undo.
      216         define variable vtime as int64 no-undo.
      217         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      218         mWaitFramInterval = iInterval.
      219         run waitfram-show (substitute("&1&2 &3&4" ,
      220                                       mWaitFramTextBeg ,
      221                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      222                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      223                                       mWaitFramTextEnd
      224                                      )
      225                           ).
      226      end.
      227      procedure WaitFramRunPause:
      228         define input  parameter iInterval as dec no-undo.
      229         define variable vStart  as datetime-tz no-undo.
      230         define variable vend    as datetime-tz no-undo.
      231         define variable vint as int64 no-undo.
      232         define variable vOk as logical no-undo.
      233         vStart = now.
      234         vend   = vStart.
      235         publish "WaitFramPause" (iInterval,output vOk).
      236         vend   =  now.
      237         vint = vend - vStart.
      238         vint = iInterval - vint / 1000.
      239         if     not mWaitFramStop
      240            and (   vint > 0
      241                 or (    not vOk
      242                     and iInterval eq ?
      243                     )
      244                 )
      245         then
      246            run waitfram-show-this (iInterval).
      247         vend   =  now.
      248         vint = vend - vStart.
      249         vint = iInterval - vint / 1000.
      250         if     not mWaitFramStop
      251            and vint > 0
      252         then do:
      253            run gbl/pause.p (vint * 1000).
      254         end.
      255         if iInterval ne ?
      256         then
      257            publish "WaitFramStop".
      258         waitfram-check-timeout().
      259      end.
      260      procedure WaitFramWaitFor:
      261         define input  parameter iInterval as dec no-undo.
      262         assign
      263            mWaitFramStartProc   = now
      264            mWaitFramStopUser    = no
      265            mWaitFramStopTimeOut = no
      266         .
      267         block-wait:
      268         do while not mWaitFramStop:
      269            run WaitFramRunPause (iInterval).
      270            if  waitfram-check-timeout()
      271            then do:
      272               leave block-wait.
      273            end.
      274         end.
      275         run waitfram-hide.
      276      end.
      277   procedure waitfram-join :
      278     define input  parameter p-line-1  as character no-undo .
      279     define input  parameter p-line-2  as character no-undo .
      280     define input  parameter p-line-3  as character no-undo .
      281     define output parameter p-message as character no-undo .
      282     do
      283     on error undo, return error return-value
      284     :
      285       assign
      286         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      287                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      288                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      289       .
      290     end.
      291   end procedure.
      292   function waitfram-join-function returns character
      293     (input p-line-1 as character
      294     ,input p-line-2 as character
      295     ,input p-line-3 as character
      296     ).
      297     define variable v-message as character no-undo .
      298     run waitfram-join in this-procedure
      299       (input  p-line-1
      300       ,input  p-line-2
      301       ,input  p-line-3
      302       ,output v-message
      303       ) .
      304     return v-message .
      305   end function .
      306   define buffer t-doc for ub.trn-doc.
      307   define variable v-recalc as logical   no-undo .
      308   find t-doc exclusive-lock where recid(t-doc) = parrec-doc.
      309   t-doc.bge-date = ? .
      310   if t-doc.doc-type = 'при':U and
      311      not t-doc.internal         then do:
      312   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-in in g#lib-trn
      313   ( input parparentproc  ,
      314     input recid(t-doc)  ,
      315     input this-procedure   )
      316   no-error.
      317   end.
      318   else do:
      319     if t-doc.doc-type = 'инв':U then do:
      320   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-inv in g#lib-trn
      321   (
      322   input recid(t-doc),
      323   input this-procedure
      324   )
      325   no-error.
      326       if t-doc.status_ = 'факт':U then do:
      327         run utl/uaddsum.p (
      328                          input t-doc.doc-code
      329                         ,input no
      330                         ,input no
      331                         ,input no
      332                          ).
      333       end.
      334     end.
      335     else do:
      336        if t-doc.ext-doc-type = 'ee':U and
      337           ( (t-doc.status_ = 'накл':U and t-doc.flag_ = true ) or
      338              t-doc.status_ = 'разрешен':U or
      339              t-doc.status_ = 'факт':U )
      340        then v-recalc = false .
      341        else v-recalc = true  .
      342   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_calc-out in g#lib-trn
      343   (
      344     input recid(t-doc)
      345   , input v-recalc
      346   , input this-procedure
      347   )
      348   no-error.
      349     end.
      350   end.
      351   if error-status :error then do:
      352      message "Ошибка при пересчете документа!!!" skip
      353              "calc-trn.p" skip
      354              error-status :get-message(1) skip
      355              return-value
      356              view-as alert-box error.
      357      return error.
      358   end.
