        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-reference as character no-undo .
        4   define input-output parameter p-date as date no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: getrefdt.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/getrefdt.p $":U .
       10   define variable vss-description as character no-undo init "Получение даты по выбору сущностей из различных справочников".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81     define variable v-cntxt-db-num        as integer   no-undo .
       82     define variable v-cntxt-userid        as character no-undo .
       83     define variable v-cntxt-level         as character no-undo .
       84     define variable v-cntxt-host-code-obj as integer   no-undo .
       85     define variable v-cntxt-obj-type      as character no-undo .
       86     define variable v-cntxt-obj-code      as integer   no-undo .
       87     define variable v-cntxt-db-num-obj    as integer   no-undo .
       88     define variable v-cntxt-is-admin      as logical   no-undo .
       89   define variable v-rid-list as character no-undo .
       90   define variable v-mode as character no-undo .
       91   define variable v-code-schet as integer no-undo .
       92   define variable v-curr-code as integer no-undo .
       93   do
       94   on error undo, return error
       95   :
       96     message p-reference view-as alert-box .
       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98     run mainmenu_getcntxt in parparentproc
       99       (output v-cntxt-db-num
      100       ,output v-cntxt-userid
      101       ,output v-cntxt-level
      102       ,output v-cntxt-host-code-obj
      103       ,output v-cntxt-obj-type
      104       ,output v-cntxt-obj-code
      105       ,output v-cntxt-db-num-obj
      106       ,output v-cntxt-is-admin
      107       ) .
      108     case entry(1, p-reference, chr(4) ):
      109       when "finsttms" then do:
      110          if entry(2, p-reference, chr(4)) = "ext-type-stat-start" then do:
      111            assign
      112            v-mode = "ext-type-stat-start"
      113            v-code-schet = 0
      114            v-curr-code = ?
      115            .
      116          end.
      117          if entry(2, p-reference, chr(4)) =  "ext-type-stat-end"
      118          or entry(2, p-reference, chr(4)) =  "ext-type-stat-end1"
      119          then do:
      120            assign
      121            v-mode = "ext-type-stat-end"
      122            v-code-schet = 0
      123            v-curr-code = ?
      124            .
      125          end.
      126          if entry(2, p-reference, chr(4)) = "code-schet-end":U
      127          or entry(2, p-reference, chr(4)) = "code-schet-start":U
      128          or entry(2, p-reference, chr(4)) = "code-schet-end1":U then do:
      129            assign
      130            v-mode = "code-schet"
      131            v-code-schet = integer(entry(3, p-reference, chr(4)))
      132            v-curr-code = ?
      133            .
      134          end.
      135          if entry(2, p-reference, chr(4)) = "currency-start":U
      136          or entry(2, p-reference, chr(4)) = "currency-end":U
      137          or entry(2, p-reference, chr(4)) = "currency-end1":U then do:
      138            assign
      139            v-mode = "currency"
      140            v-code-schet = 0
      141            v-curr-code = integer(entry(3, p-reference, chr(4)))
      142            .
      143          end.
      144         define buffer buf_fin-statement for ub.fin-statement.
      145         run ref/finsttms.w (
      146                        input parparentproc
      147                       ,input v-cntxt-host-code-obj
      148                       ,input "b-sel":U
      149                       ,input v-mode
      150                       ,input v-cntxt-host-code-obj
      151                       ,input 'факт':U
      152                       ,input 'стд':U
      153                       ,input 'стд':U
      154                       ,input ?
      155                       ,input ?
      156                       ,input 0
      157                       ,input v-code-schet
      158                       ,input v-curr-code
      159                       ,input-output v-rid-list) no-error .
      160         if v-rid-list = '':U then return.
      161         find first buf_fin-statement no-lock where
      162                   recid(buf_fin-statement) = integer(v-rid-list) no-error.
      163         if available buf_fin-statement then do:
      164           if entry(2, p-reference, chr(4)) = "ext-type-stat-start"
      165           or entry(2, p-reference, chr(4)) = "code-schet-start"
      166           or entry(2, p-reference, chr(4)) = "currency-start"
      167           then do:
      168             assign
      169             p-date = buf_fin-statement.start-date.
      170           end.
      171           if entry(2, p-reference, chr(4)) = "ext-type-stat-end"
      172           or entry(2, p-reference, chr(4)) = "code-schet-end"
      173           or entry(2, p-reference, chr(4)) = "currency-end"
      174           then do:
      175             assign
      176             p-date = buf_fin-statement.end-date.
      177           end.
      178           if entry(2, p-reference, chr(4)) = "ext-type-stat-end1"
      179           or entry(2, p-reference, chr(4)) = "code-schet-end1"
      180           or entry(2, p-reference, chr(4)) = "currency-end1"
      181           then do:
      182             assign
      183             p-date = buf_fin-statement.end-date + 1.
      184           end.
      185         end.
      186       end.
      187       otherwise do:
      188         message
      189         substitute("Не определен или неверно определен справочник &1 для выбора даты", p-reference)
      190         view-as alert-box error .
      191         return .
      192       end.
      193     end case.
      194   end.
