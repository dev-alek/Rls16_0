        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список всех окон сессии".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE VAR show_levels AS INTEGER NO-UNDO.
      112   DEFINE VAR save_recid  AS RECID   NO-UNDO.
      113   DEFINE VAR mode        AS CHAR    NO-UNDO INITIAL "ALL".
      114   DEFINE TEMP-TABLE tt NO-UNDO
      115     FIELD handle       AS HANDLE
      116     FIELD name         AS CHAR
      117     FIELD level        AS INTEGER
      118     FIELD parent-recid AS RECID
      119     FIELD expanded     AS LOGICAL
      120     FIELD visible      AS LOGICAL
      121     .
      122   DEFINE BUFFER x_tt FOR tt.
      123   DEFINE BUTTON btn_collapse
      124        LABEL "-":L
      125        SIZE 4 BY 1.
      126   DEFINE BUTTON btn_expand
      127        LABEL "+":L
      128        SIZE 4 BY 1.
      129   DEFINE BUTTON btn_level-1
      130        LABEL "1":L
      131        SIZE 4 BY 1.
      132   DEFINE BUTTON btn_level-2
      133        LABEL "2":L
      134        SIZE 4 BY 1.
      135   DEFINE BUTTON btn_level-3
      136        LABEL "3":L
      137        SIZE 4 BY 1.
      138   DEFINE BUTTON btn_level-4
      139        LABEL "4":L
      140        SIZE 4 BY 1.
      141   DEFINE BUTTON btn_level-5
      142        LABEL "5":L
      143        SIZE 4 BY 1.
      144   DEFINE BUTTON btn_level-all
      145        LABEL "...":L
      146        SIZE 4 BY 1.
      147   DEFINE VARIABLE levels AS CHARACTER FORMAT "X(21)":U
      148         VIEW-AS TEXT
      149        SIZE 17 BY .96.
      150   DEFINE QUERY wlist FOR
      151         tt SCROLLING.
      152   DEFINE BROWSE wlist
      153     QUERY wlist DISPLAY
      154         FILL("     ",tt.level - 1) +
      155                   (IF NOT CAN-FIND (FIRST x_tt WHERE x_tt.parent-recid eq RECID(tt))
      156                    THEN "  "
      157                    ELSE (IF tt.expanded THEN "- " ELSE "+ " )) +
      158                   tt.name FORMAT "X(70)"
      159       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.63 BY 14.83.
      160   DEFINE FRAME D-Dialog
      161        btn_expand AT ROW 1.5 COL 4.38
      162        btn_collapse AT ROW 1.5 COL 8.38
      163        btn_level-1 AT ROW 1.5 COL 30.38
      164        btn_level-2 AT ROW 1.5 COL 34.38
      165        btn_level-3 AT ROW 1.5 COL 38.38
      166        btn_level-4 AT ROW 1.5 COL 42.38
      167        btn_level-5 AT ROW 1.5 COL 46.38
      168        btn_level-all AT ROW 1.5 COL 50.38
      169        wlist AT ROW 2.75 COL 4.25
      170        levels AT ROW 1.54 COL 11.38 COLON-ALIGNED NO-LABEL
      171        SPACE(56.36) SKIP(15.99)
      172       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      173            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      174            TITLE "<insert SmartDialog title>".
      175   ASSIGN
      176          FRAME D-Dialog:SCROLLABLE       = FALSE
      177          FRAME D-Dialog:HIDDEN           = TRUE.
      178   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      179   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      180   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      181   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      182   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      183   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      184   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      185   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      186       ASSIGN adm-object-hdl = FRAME D-Dialog:HANDLE.
      187   RUN ensure-broker.
      188   THIS-PROCEDURE:ADM-DATA =
      189        'ADM1.1~`':U +
      190        'SmartDialog~`':U +
      191        'DIALOG-BOX~`':U +
      192        'NO ~`':U +
      193        '~`':U +
      194        'tt~`':U +
      195        '~`':U +
      196        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      197           + "~`":U +
      198        'Layout,Hide-on-Init~`':U +
      199        '~`':U +
      200        '~`':U +
      201        '~`~`~`~`~`~`~`~`~`~`~`':U +
      202        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      203            THEN "^^":U
      204        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      205             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      206   PROCEDURE adm-apply-entry :
      207     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      208   END PROCEDURE.
      209   PROCEDURE adm-destroy :
      210    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      211   END PROCEDURE.
      212   PROCEDURE adm-disable :
      213       DISABLE btn_expand btn_collapse btn_level-1 btn_level-2 btn_level-3 btn_level-4 btn_level-5 btn_level-all wlist levels WITH FRAME D-Dialog.
      214       RUN dispatch ('disable-fields':U).
      215       RUN set-attribute-list ('ENABLED=no':U).
      216       RETURN.
      217   END PROCEDURE.
      218   PROCEDURE adm-edit-attribute-list :
      219         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      220         RETURN.
      221   END PROCEDURE.
      222   PROCEDURE adm-enable :
      223       ENABLE UNLESS-HIDDEN btn_expand btn_collapse btn_level-1 btn_level-2 btn_level-3 btn_level-4 btn_level-5 btn_level-all wlist levels WITH FRAME D-Dialog.
      224       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      225       RUN set-attribute-list ('ENABLED=yes':U).
      226       RETURN.
      227   END PROCEDURE.
      228   PROCEDURE adm-exit :
      229        RUN notify ('exit':U).
      230     RETURN.
      231   END PROCEDURE.
      232   PROCEDURE adm-hide :
      233     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      234   END PROCEDURE.
      235   PROCEDURE adm-initialize :
      236     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      237   END PROCEDURE.
      238   PROCEDURE adm-show-errors :
      239       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      240       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      241           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      242       END.
      243       RETURN.
      244   END PROCEDURE.
      245   PROCEDURE adm-UIB-mode :
      246     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      247   END PROCEDURE.
      248   PROCEDURE adm-view :
      249     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      250   END PROCEDURE.
      251   PROCEDURE dispatch :
      252       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      253       RUN broker-dispatch IN adm-broker-hdl
      254           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      255       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      256   END PROCEDURE.
      257   PROCEDURE ensure-broker :
      258   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      259   IF RETURN-VALUE NE "ADM-Broker":U THEN
      260   DO:
      261       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      262       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      263   END.
      264   END PROCEDURE.
      265   PROCEDURE get-attribute :
      266     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      267     RUN broker-get-attribute IN adm-broker-hdl
      268         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      269     RETURN RETURN-VALUE.
      270   END PROCEDURE.
      271   PROCEDURE get-attribute-list :
      272     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      273     RUN broker-get-attribute-list IN adm-broker-hdl
      274         (INPUT THIS-PROCEDURE,
      275          INPUT ?,
      276          OUTPUT p-attr-list) NO-ERROR.
      277     RETURN.
      278   END PROCEDURE.
      279   PROCEDURE new-state :
      280     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      281     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      282     RETURN.
      283   END PROCEDURE.
      284   PROCEDURE notify :
      285     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      286     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      287     IF RETURN-VALUE = "ADM-ERROR":U THEN
      288         RETURN "ADM-ERROR":U.
      289     RETURN.
      290   END PROCEDURE.
      291   PROCEDURE set-attribute-list :
      292     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      293     RUN ensure-broker.
      294     RUN broker-set-attribute-list IN adm-broker-hdl
      295         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      296     RETURN.
      297   END PROCEDURE.
      298   PROCEDURE set-position :
      299       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      300       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      301       IF VALID-HANDLE(adm-object-hdl) THEN
      302       DO:
      303           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      304           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      305           DO:
      306             IF p-row = 0 THEN p-row =
      307               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      308             IF p-col = 0 THEN p-col =
      309               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      310           END.
      311           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      312           DO:
      313             parent-hdl = adm-object-hdl:PARENT.
      314             IF p-row = 0 THEN p-row =
      315               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      316                 parent-hdl:ROW.
      317             IF p-col = 0 THEN p-col =
      318               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      319                 parent-hdl:COL.
      320           END.
      321           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      322           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      323         ASSIGN adm-object-hdl:ROW    =   p-row
      324                adm-object-hdl:COLUMN =   p-col.
      325       END.
      326       RETURN.
      327   END PROCEDURE.
      328   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      329       STRING(adm-object-hdl)).
      330   PAUSE 0 BEFORE-HIDE.
      331   PROCEDURE adm-change-page :
      332     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      333     END PROCEDURE.
      334   PROCEDURE delete-page :
      335     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      336     RUN broker-delete-page IN adm-broker-hdl
      337         (INPUT THIS-PROCEDURE, INPUT p-page#).
      338     END PROCEDURE.
      339   PROCEDURE init-object :
      340     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      341     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      342     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      343     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      344     RUN broker-init-object IN adm-broker-hdl
      345         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      346          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      347     RETURN.
      348   END PROCEDURE.
      349   PROCEDURE init-pages :
      350     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      351     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      352         INPUT p-page-list) NO-ERROR.
      353     END PROCEDURE.
      354   PROCEDURE select-page :
      355     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      356     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      357         INPUT p-page#) NO-ERROR.
      358     END PROCEDURE.
      359   PROCEDURE view-page :
      360     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      361     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      362         INPUT p-page#).
      363     END PROCEDURE.
      364   ON WINDOW-CLOSE OF FRAME D-Dialog
      365   DO:
      366     APPLY "END-ERROR":U TO SELF.
      367   END.
      368   ON CHOOSE OF btn_collapse IN FRAME D-Dialog
      369   DO:
      370     DEFINE BUFFER child_tt FOR tt.
      371     IF AVAILABLE tt AND tt.expanded THEN DO:
      372       IF CAN-FIND (FIRST child_tt WHERE child_tt.parent-recid eq RECID(tt))
      373       THEN DO:
      374         save_recid = RECID(tt).
      375         RUN set_expansion (RECID(tt), NO).
      376         RUN reopen_query.
      377       END.
      378     END.
      379   END.
      380   ON CHOOSE OF btn_expand IN FRAME D-Dialog
      381   DO:
      382     IF AVAILABLE tt AND tt.expanded eq NO THEN DO:
      383       save_recid = RECID(tt).
      384       RUN set_expansion (RECID(tt), YES).
      385       RUN reopen_query.
      386     END.
      387   END.
      388   ON CHOOSE OF btn_level-1 IN FRAME D-Dialog
      389   DO:
      390     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      391            show_levels = integer(self:LABEL)
      392            levels:SCREEN-VALUE = "Level 1"
      393            .
      394     RUN reopen_query.
      395   END.
      396   ON CHOOSE OF btn_level-2 IN FRAME D-Dialog
      397   DO:
      398     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      399            show_levels = integer(self:LABEL)
      400            levels:SCREEN-VALUE = "Levels 1 - " + SELF:LABEL
      401            .
      402     RUN reopen_query.
      403   END.
      404   ON CHOOSE OF btn_level-3 IN FRAME D-Dialog
      405   DO:
      406     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      407            show_levels = integer(self:LABEL)
      408            levels:SCREEN-VALUE = "Levels 1 - " + SELF:LABEL
      409            .
      410     RUN reopen_query.
      411   END.
      412   ON CHOOSE OF btn_level-4 IN FRAME D-Dialog
      413   DO:
      414     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      415            show_levels = integer(self:LABEL)
      416            levels:SCREEN-VALUE = "Levels 1 - " + SELF:LABEL
      417            .
      418     RUN reopen_query.
      419   END.
      420   ON CHOOSE OF btn_level-5 IN FRAME D-Dialog
      421   DO:
      422     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      423            show_levels = integer(self:LABEL)
      424            levels:SCREEN-VALUE = "Levels 1 - " + SELF:LABEL
      425            .
      426     RUN reopen_query.
      427   END.
      428   ON CHOOSE OF btn_level-all IN FRAME D-Dialog
      429   DO:
      430     ASSIGN save_recid = IF AVAILABLE tt THEN RECID(tt) ELSE ?
      431            show_levels = 1000000
      432            levels:SCREEN-VALUE = "All Levels"
      433            .
      434     RUN reopen_query.
      435   END.
      436   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   on help of frame D-Dialog
      438   do:
      439     run gbl/app_help.p
      440       (input this-procedure :file-name
      441       ,input ''
      442       ,input ?
      443       ) no-error.
      444     if error-status :error then do:
      445       message
      446         "Ошибка при вызове помощи"
      447         error-status :get-message(1)
      448         view-as alert-box .
      449     end.
      450   end.
      451   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      452   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      453   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      454   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      455   define variable v-diasize-current-frame-width  as decimal   no-undo .
      456   define variable v-diasize-current-frame-height as decimal   no-undo .
      457   define variable v-diasize-change-size          as logical   no-undo .
      458   define variable v-diasize-resize-button        as handle    no-undo .
      459   define variable v-diasize-wndmax               as logical   no-undo .
      460   define variable v-diasize-wndstore             as logical   no-undo .
      461   define variable v-diasize-proc-name            as character no-undo .
      462   define variable v-diasize-browse-handle        as handle    no-undo .
      463   define variable v-diasize-browse-number        as integer   no-undo .
      464   define variable v-diasize-need-full-display    as logical   no-undo init false .
      465   define temp-table temp-diasize-handle no-undo
      466     field handle-value  as handle
      467     field save-position as decimal
      468     index xpk is primary unique handle-value
      469     .
      470   define temp-table temp-browse-handle no-undo
      471     field browse-type   as character
      472     field browse-number as integer
      473     field browse-handle as handle
      474     field original-size as decimal
      475     index xpk is primary unique browse-type browse-number
      476     index xie browse-type browse-handle
      477   .
      478   procedure diasize_change-height :
      479     define input  parameter p-change-value  as decimal   no-undo .
      480     define input  parameter p-move-resize   as logical   no-undo .
      481     define variable v-field-group-handle    as handle    no-undo .
      482     define variable v-object-handle         as handle    no-undo .
      483     define variable v-frame-height          as decimal   no-undo .
      484     define variable v-frame-virtual-height  as decimal   no-undo .
      485     define variable v-browse-height         as decimal   no-undo .
      486     define variable v-window-height         as decimal   no-undo .
      487     define variable v-window-virtual-height as decimal   no-undo .
      488     define variable v-change-sign           as integer   no-undo .
      489     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      490     define buffer buf_temp-browse-handle  for temp-browse-handle .
      491     if p-change-value > 0
      492     then do:
      493       if frame D-Dialog :height + p-change-value
      494           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      495       then do:
      496         assign
      497           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      498                           - (frame D-Dialog :height-chars)
      499         .
      500         if p-change-value <= 0
      501         then do:
      502           run diasize_position-resize-button in this-procedure .
      503           return .
      504         end.
      505       end.
      506     end.
      507     if p-change-value < 0
      508     then do:
      509       if frame D-Dialog :height + p-change-value < v-diasize-orig-frame-height
      510       then do:
      511         assign
