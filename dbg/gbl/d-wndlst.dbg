     1161             assign
     1162               v-object-handle :col = v-object-handle :col + p-change-value
     1163               no-error .
     1164             if error-status :error
     1165             or error-status :get-message(1) <> ""
     1166             then do:
     1167               undo move_block, retry move_block .
     1168             end.
     1169           end.
     1170         end.
     1171         for each buf_temp-browse-handle
     1172           where buf_temp-browse-handle.browse-type = 'width':u
     1173         on error undo move_block, retry move_block
     1174         :
     1175           assign
     1176             buf_temp-browse-handle.browse-handle :width
     1177               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1178             no-error .
     1179           if error-status :error
     1180           or error-status :get-message(1) <> ""
     1181           then do:
     1182             undo move_block, retry move_block .
     1183           end.
     1184         end.
     1185         assign
     1186           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1187           no-error .
     1188         if error-status :error
     1189         or error-status :get-message(1) <> ""
     1190         then do:
     1191           undo move_block, retry move_block.
     1192         end.
     1193         assign
     1194           frame D-Dialog :width = frame D-Dialog :width + p-change-value
     1195         no-error .
     1196         if error-status :error
     1197         or error-status :get-message(1) <> ""
     1198         then do:
     1199           undo move_block, retry move_block.
     1200         end.
     1201         if frame D-Dialog :scrollable = true
     1202         then do:
     1203           assign
     1204             frame D-Dialog :virtual-width = frame D-Dialog :virtual-width + p-change-value
     1205           no-error .
     1206           if error-status :error
     1207           or error-status :get-message(1) <> ""
     1208           then do:
     1209             undo move_block, retry move_block.
     1210           end.
     1211         end.
     1212       end.
     1213       if p-move-resize
     1214       then do:
     1215         run diasize_position-resize-button in this-procedure .
     1216       end.
     1217       if v-diasize-wndstore = true
     1218       then do:
     1219         if connected("ub") = true
     1220         then do:
     1221           define variable v-cntxt-db-num        as integer   no-undo .
     1222           define variable v-cntxt-userid        as character no-undo .
     1223           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1224                                             , OUTPUT v-cntxt-userid
     1225                                             ) .
     1226           run gbl/wndsizew.p
     1227             (input  v-cntxt-db-num
     1228             ,input  v-cntxt-userid
     1229             ,input  v-diasize-proc-name
     1230             ,input  'width':u
     1231             ,input  string(frame D-Dialog :width - v-diasize-orig-frame-width)
     1232             ) .
     1233         end.
     1234       end.
     1235     end.
     1236     assign
     1237       v-diasize-change-size = false
     1238     .
     1239   end procedure.
     1240   procedure diasize_set-width :
     1241     define input  parameter p-new-width  as decimal   no-undo .
     1242     define input  parameter p-move-resize as logical   no-undo .
     1243     do
     1244     on error undo, return error return-value
     1245     :
     1246       run diasize_change-width in this-procedure
     1247         (input  (p-new-width - frame D-Dialog :width)
     1248         ,input  p-move-resize
     1249         ) .
     1250     end.
     1251   end procedure.
     1252   procedure diasize_position-resize-button :
     1253     do with frame D-Dialog
     1254     :
     1255       hide v-diasize-resize-button .
     1256       assign
     1257         v-diasize-resize-button :row = frame D-Dialog :height - v-diasize-resize-button :height
     1258                     - 1
     1259                     - (frame D-Dialog :border-bottom-pixels / session :pixels-per-row)
     1260         v-diasize-resize-button :col = frame D-Dialog :width - v-diasize-resize-button :width
     1261                     - 1
     1262                     - (frame D-Dialog :border-right-pixels / session :pixels-per-column)
     1263       .
     1264       view v-diasize-resize-button .
     1265     end.
     1266   end procedure.
     1267   on alt-right anywhere
     1268   do:
     1269     run diasize_change-width in this-procedure
     1270       (input 1
     1271       ,input true
     1272       ) .
     1273     return no-apply .
     1274   end.
     1275   on alt-left anywhere
     1276   do:
     1277     run diasize_change-width in this-procedure
     1278       (input -1
     1279       ,input true
     1280       ) .
     1281     return no-apply .
     1282   end.
     1283   on alt-down anywhere
     1284   do:
     1285     run diasize_change-height in this-procedure
     1286       (input 1
     1287       ,input true
     1288       ) .
     1289     return no-apply .
     1290   end.
     1291   on alt-up anywhere
     1292   do:
     1293     run diasize_change-height in this-procedure
     1294       (input -1
     1295       ,input true
     1296       ) .
     1297     return no-apply .
     1298   end.
     1299   on alt-enter of frame D-Dialog
     1300   do:
     1301     run diasize_maximize in this-procedure
     1302       (input  ?
     1303       ).
     1304     return no-apply .
     1305   end.
     1306   procedure diasize_end-move :
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310       define variable v-row-delta as decimal   no-undo .
     1311       define variable v-col-delta as decimal   no-undo .
     1312       define variable v-new-row as decimal   no-undo .
     1313       define variable v-new-col as decimal   no-undo .
     1314       assign
     1315         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1316         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1317       .
     1318       assign
     1319         v-row-delta = v-new-row - frame D-Dialog :height
     1320         v-col-delta = v-new-col - frame D-Dialog :width
     1321       .
     1322       run diasize_change-height in this-procedure
     1323         (input v-row-delta
     1324         ,input true
     1325         ) .
     1326       run diasize_change-width in this-procedure
     1327         (input v-col-delta
     1328         ,input true
     1329         ) .
     1330     end.
     1331   end procedure.
     1332   procedure diasize_maximize :
     1333     define input  parameter p-action as logical   no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       if p-action = ?
     1338       then do:
     1339         if v-diasize-need-maximize = true
     1340         then do:
     1341           assign
     1342             p-action = true
     1343           .
     1344         end.
     1345         else do:
     1346           assign
     1347             p-action = false
     1348           .
     1349         end.
     1350       end.
     1351       if p-action = true
     1352       then do:
     1353         run diasize_change-height in this-procedure
     1354           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1355               - frame D-Dialog :height-chars
     1356           ,input true
     1357           ) .
     1358         run diasize_change-width in this-procedure
     1359           (input session :width-chars
     1360               - frame D-Dialog :width-chars
     1361           ,input true
     1362           ) .
     1363         assign
     1364           v-diasize-need-maximize = false
     1365         .
     1366       end.
     1367       else do:
     1368         run diasize_change-width in this-procedure
     1369           (input v-diasize-orig-frame-width
     1370               - frame D-Dialog :width-chars
     1371           ,input true
     1372           ) .
     1373         run diasize_change-height in this-procedure
     1374           (input v-diasize-orig-frame-height
     1375               - frame D-Dialog :height-chars
     1376           ,input true
     1377           ) .
     1378         assign
     1379           v-diasize-need-maximize = true
     1380         .
     1381       end.
     1382     end.
     1383   end procedure.
     1384   procedure diasize_restore-orig-size :
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       assign
     1389         v-diasize-current-frame-width  = frame D-Dialog :width
     1390         v-diasize-current-frame-height = frame D-Dialog :height
     1391       .
     1392       run diasize_set-height in this-procedure
     1393         (input  v-diasize-orig-frame-height
     1394         ,input  true
     1395         ) .
     1396       run diasize_set-width in this-procedure
     1397         (input  v-diasize-orig-frame-width
     1398         ,input  true
     1399         ) .
     1400     end.
     1401   end procedure.
     1402   procedure diasize_restore-current-size :
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       run diasize_set-height in this-procedure
     1407         (input  v-diasize-current-frame-height
     1408         ,input  true
     1409         ) .
     1410       run diasize_set-width in this-procedure
     1411         (input  v-diasize-current-frame-width
     1412         ,input  true
     1413         ) .
     1414     end.
     1415   end procedure.
     1416   procedure diasize_set-browse-handle :
     1417     define input  parameter p-browse-handle as handle   no-undo .
     1418     define buffer buf_temp-browse-handle for temp-browse-handle .
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       assign
     1423         v-diasize-browse-handle = p-browse-handle
     1424       .
     1425       for each buf_temp-browse-handle
     1426       on error undo, return error return-value
     1427       :
     1428         delete buf_temp-browse-handle .
     1429       end.
     1430     end.
     1431   end procedure.
     1432   procedure diasize_add_browse :
     1433     define input  parameter p-browse-type   as character no-undo .
     1434     define input  parameter p-browse-handle as handle    no-undo .
     1435     define buffer buf_temp-browse-handle for temp-browse-handle .
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439       assign
     1440         v-diasize-browse-number = v-diasize-browse-number + 1
     1441       .
     1442       create buf_temp-browse-handle .
     1443       assign
     1444         buf_temp-browse-handle.browse-type   = p-browse-type
     1445         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1446         buf_temp-browse-handle.browse-handle = p-browse-handle
     1447       .
     1448     end.
     1449   end procedure.
     1450   procedure diasize_init :
     1451     define variable v-default-value    as logical   no-undo .
     1452     define variable v-restore-saved    as logical   no-undo .
     1453     define variable v-resize-value-str as character no-undo .
     1454     do
     1455     on error undo, return error return-value
     1456     :
     1457       do with frame D-Dialog
     1458       :
     1459         assign
     1460           v-diasize-orig-frame-height = frame D-Dialog :height
     1461           v-diasize-orig-frame-width  = frame D-Dialog :width
     1462           v-diasize-browse-handle     = browse wlist :handle
     1463         .
     1464         create button v-diasize-resize-button
     1465         assign
     1466           parent        = frame D-Dialog :first-child
     1467           label         = "s"
     1468           height-pixels = 16
     1469           width-pixels  = 16
     1470           visible       = true
     1471           sensitive     = true
     1472           movable       = true
     1473           triggers:
     1474             on end-move persistent run diasize_end-move in this-procedure .
     1475           end triggers.
     1476         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1477         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1478         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1479         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1480         assign
     1481           v-diasize-wndmax = false
     1482         .
     1483         if connected("ub") = true
     1484         then do:
     1485           define variable v-cntxt-db-num        as integer   no-undo .
     1486           define variable v-cntxt-userid        as character no-undo .
     1487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1488                                             , OUTPUT v-cntxt-userid
     1489                                             ) .
     1490           run gbl/wndpar_r.p
     1491             (input  v-cntxt-db-num
     1492             ,input  v-cntxt-userid
     1493             ,input  'wndmax':U
     1494             ,output v-diasize-wndmax
     1495             ,output v-default-value
     1496             ) .
     1497         end.
     1498         assign
     1499           v-diasize-wndstore = false
     1500         .
     1501         if connected("ub") = true
     1502         then do:
     1503           run gbl/wndpar_r.p
     1504             (input  v-cntxt-db-num
     1505             ,input  v-cntxt-userid
     1506             ,input  'wndstore':U
     1507             ,output v-diasize-wndstore
     1508             ,output v-default-value
     1509             ) .
     1510         end.
     1511         assign
     1512           v-diasize-proc-name = entry(1, program-name(2), '.')
     1513         .
     1514         if v-diasize-wndstore = true
     1515         then do:
     1516           assign
     1517             v-restore-saved = false
     1518           .
     1519           if connected("ub") = true
     1520           then do:
     1521             run gbl/wndsizer.p
     1522               (input  v-cntxt-db-num
     1523               ,input  v-cntxt-userid
     1524               ,input  v-diasize-proc-name
     1525               ,input  'height':u
     1526               ,output v-resize-value-str
     1527               ) .
     1528             if v-resize-value-str <> '':U
     1529             then do:
     1530               run diasize_change-height in this-procedure
     1531                 (input  integer(v-resize-value-str)
     1532                 ,input  true
     1533                 ) .
     1534               assign
     1535                 v-restore-saved = true
     1536               .
     1537             end.
     1538           end.
     1539           if connected("ub") = true
     1540           then do:
     1541             run gbl/wndsizer.p
     1542               (input  v-cntxt-db-num
     1543               ,input  v-cntxt-userid
     1544               ,input  v-diasize-proc-name
     1545               ,input  'width':u
     1546               ,output v-resize-value-str
     1547               ) .
     1548             if v-resize-value-str <> '':U
     1549             then do:
     1550               run diasize_change-width in this-procedure
     1551                 (input  integer(v-resize-value-str)
     1552                 ,input  true
     1553                 ) .
     1554               assign
     1555                 v-restore-saved = true
     1556               .
     1557             end.
     1558           end.
     1559           if v-restore-saved <> true
     1560           then do:
     1561             if v-diasize-wndmax = true
     1562             then do:
     1563               run diasize_maximize in this-procedure
     1564                 (input  true
     1565                 ) .
     1566             end.
     1567           end.
     1568         end.
     1569         else do:
     1570           if v-diasize-wndmax = true
     1571           then do:
     1572             run diasize_maximize in this-procedure
     1573               (input  true
     1574               ) .
     1575           end.
     1576         end.
     1577       end.
     1578     end.
     1579   end procedure.
     1580   procedure diasize_need-full-display :
     1581     define output parameter p-need-full-display as logical   no-undo .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585       assign
     1586         p-need-full-display = v-diasize-need-full-display
     1587       .
     1588       assign
     1589         v-diasize-need-full-display = false
     1590       .
     1591     end.
     1592   end procedure.
     1593   procedure get-context :
     1594      define output parameter p-db-num as integer          no-undo.
     1595      define output parameter p-user-id as character        no-undo.
     1596      define variable v-login               as character    no-undo.
     1597      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1598      define buffer buf_user-login  for ub.user-login .
     1599      do
     1600      on error undo, return error
     1601      :
     1602            FIND FIRST buf_sys-ctrl no-lock.
     1603            ASSIGN
     1604               v-login = USERID("ub")
     1605               p-db-num = buf_sys-ctrl.db-num
     1606            .
     1607            FIND FIRST buf_user-login
     1608                 WHERE buf_user-login.db-num = p-db-num
     1609                   AND buf_user-login.user-login = v-login
     1610                 no-lock
     1611                 no-error
     1612                 .
     1613            IF AVAILABLE buf_user-login
     1614            THEN DO:
     1615               assign
     1616                  p-user-id = buf_user-login.user-id
     1617               .
     1618            END.
     1619      end.
     1620   end procedure.
     1621       run diasize_init in this-procedure .
     1622   do:
     1623     wlist :set-repositioned-row( 5, "conditional" ) .
     1624   end.
     1625   ON DEFAULT-ACTION OF wlist IN FRAME D-Dialog DO:
     1626     DEFINE BUFFER child_tt FOR tt.
     1627     IF AVAILABLE tt THEN DO:
     1628       IF CAN-FIND (FIRST child_tt WHERE child_tt.parent-recid eq RECID(tt))
     1629       THEN DO:
     1630         save_recid = RECID(tt).
     1631         RUN set_expansion (RECID(tt), NOT tt.expanded).
     1632         RUN reopen_query.
     1633       END.
     1634     END.
     1635   END.
     1636   def var l-user-defined-objects as logical   no-undo .
     1637   def var l-all-objects          as logical   no-undo .
     1638   assign
     1639     l-user-defined-objects = false
     1640     l-all-objects          = true
     1641   .
     1642   RUN create_list (SESSION, 1, ?).
     1643   ASSIGN show_levels = 1000000
     1644           levels:SCREEN-VALUE = "All Levels".
     1645   .
     1646   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     1647       MESSAGE "A SmartDialog is not intended ":U SKIP
     1648               "to be run Persistent or to be placed ":U SKIP
     1649               "in another SmartObject at UIB design time.":U
     1650               VIEW-AS ALERT-BOX ERROR.
     1651       RUN disable_UI.
     1652       DELETE PROCEDURE THIS-PROCEDURE.
     1653       RETURN.
     1654   END.
     1655   RUN dispatch ('create-objects':U).
     1656   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME D-Dialog:PARENT eq ?
     1657   THEN FRAME D-Dialog:PARENT = ACTIVE-WINDOW.
     1658   MAIN-BLOCK:
     1659   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1660      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1661     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
     1662     WAIT-FOR GO OF FRAME D-Dialog.
     1663   END.
     1664   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
     1665   PROCEDURE adm-create-objects :
     1666   END PROCEDURE.
     1667   PROCEDURE adm-row-available :
     1668     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1669     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1670     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1671     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1672     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1673     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1674     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1675     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1676     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1677     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1678     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1679     IF adm-updating-record THEN RETURN.
     1680     RUN get-attribute ('FIELDS-ENABLED':U).
     1681     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1682     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1683         OUTPUT link-handle) NO-ERROR.
     1684     IF link-handle = "":U THEN
     1685         RETURN.
     1686     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1687     IF NUM-ENTRIES(link-handle) > 1 THEN
     1688         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1689             "encountered more than one RECORD-SOURCE.":U SKIP
     1690             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1691                VIEW-AS ALERT-BOX ERROR.
     1692     RUN get-attribute ('Key-Name':U).
     1693     key-name = RETURN-VALUE.
     1694     IF key-name = "":U THEN key-name = ?.
     1695     IF key-name NE ? THEN DO:
     1696       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1697         NO-ERROR.
     1698       IF key-value NE ? THEN
     1699         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1700     END.
     1701   IF VALID-HANDLE (adm-object-hdl) THEN
     1702       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1703   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1704   END PROCEDURE.
     1705   PROCEDURE create_list :
     1706     DEF INPUT PARAMETER phParent AS WIDGET  NO-UNDO.
     1707     DEF INPUT PARAMETER pLevel   AS INTEGER NO-UNDO.
     1708     DEF INPUT PARAMETER prParent AS RECID   NO-UNDO.
     1709     DEF VAR elist AS CHARACTER     NO-UNDO INITIAL "User Interface Builder,PROGRESS,PRO*Tools,Data Dictionary,Procedure Editor,Data Administration,Librarian,Results,Translation Manager,Application Compiler,Control Hierarchy,Run Procedure,Color Changer,PRO*Spy".
     1710     DEF VAR h     AS WIDGET-HANDLE NO-UNDO.
     1711     h = phParent:FIRST-CHILD.
     1712     DO WHILE VALID-HANDLE(h):
     1713        IF h:TYPE = "WINDOW" AND mode = "NO-ADE" THEN
     1714          IF CAN-DO(elist,TRIM(h:TITLE))        OR
     1715            h:TITLE = ?                         OR
     1716            h:TITLE BEGINS "Procedure -"        OR
     1717            h:TITLE BEGINS "Procedure Editor -" OR
     1718            h:TITLE BEGINS "User Interface Builder -" THEN DO:
     1719              ASSIGN h = h:NEXT-SIBLING.
     1720              NEXT.
     1721          END.
     1722       CREATE tt.
     1723       ASSIGN tt.level = pLevel
     1724              tt.parent-recid = prParent
     1725              tt.expanded = YES
     1726              tt.visible = YES
     1727              tt.handle = h
     1728              tt.name =  LC(h:TYPE) + ": "
     1729              .
     1730       CASE h:TYPE:
     1731         WHEN "WINDOW":U OR WHEN "DIALOG-BOX":U THEN
     1732           tt.name = tt.name + (IF h:TITLE EQ ? THEN STRING(h) ELSE h:TITLE).
     1733         WHEN "FRAME":U THEN DO:
     1734           tt.name = tt.name + IF h:TITLE eq ? THEN STRING(h) ELSE h:TITLE.
     1735           END.
     1736         WHEN "FIELD-GROUP":U THEN
     1737           tt.name = tt.name + STRING(h).
     1738         OTHERWISE DO:
     1739           IF CAN-QUERY(h, "LABEL":U) AND h:LABEL ne ? AND h:LABEL ne "":U THEN
     1740             tt.name = tt.name + h:LABEL.
     1741           ELSE IF CAN-QUERY(h, "NAME-":U) AND h:NAME ne ? THEN
     1742             tt.name = tt.name + h:NAME.
     1743           ELSE IF CAN-QUERY(h, "SCREEN-VALUE":U) AND h:SCREEN-VALUE ne ? THEN
     1744             tt.name = tt.name + "'":U + h:SCREEN-VALUE + "'":U.
     1745           ELSE tt.name = tt.name + "@ X=" + STRING(h:X) + ", Y=" + STRING(h:Y).
     1746         END.
     1747       END CASE.
     1748       IF CAN-QUERY(h,"FIRST-CHILD") THEN RUN create_list (h, pLevel + 1, RECID(tt)).
     1749       h = h:NEXT-SIBLING.
     1750     END.
     1751   END PROCEDURE.
     1752   PROCEDURE disable_UI :
     1753     HIDE FRAME D-Dialog.
     1754   END PROCEDURE.
     1755   PROCEDURE enable_UI :
     1756     DISPLAY levels
     1757         WITH FRAME D-Dialog.
     1758     ENABLE btn_expand btn_collapse btn_level-1 btn_level-2 btn_level-3
     1759            btn_level-4 btn_level-5 btn_level-all wlist levels
     1760         WITH FRAME D-Dialog.
     1761     VIEW FRAME D-Dialog.
     1762     OPEN QUERY wlist FOR EACH tt   WHERE tt.level <= show_levels AND tt.visible .
     1763   END PROCEDURE.
     1764   PROCEDURE Refresh :
     1765     DEF VAR xname LIKE tt.name.
     1766     run adecomm/_setcurs.p ("WAIT").
     1767     IF save_recid <> ? THEN DO:
     1768         FIND x_tt WHERE RECID(x_tt) = save_recid NO-ERROR.
     1769         IF AVAILABLE x_tt THEN xname = x_tt.name.
     1770         ELSE save_recid = ?.
     1771     END.
     1772     FOR EACH tt: DELETE tt. END.
     1773     RUN create_list (SESSION, 1, ?).
     1774     IF xname <> "" AND save_recid <> ? THEN DO:
     1775         FIND FIRST tt WHERE tt.name = xname NO-ERROR.
     1776         IF NOT AVAILABLE tt THEN DO:
     1777             FIND FIRST tt NO-ERROR.
     1778             IF AVAILABLE tt THEN save_recid = RECID(tt).
     1779         END.
     1780         ELSE save_recid = RECID(tt).
     1781     END.
     1782     RUN reopen_query.
     1783     run adecomm/_setcurs.p ("").
     1784   END PROCEDURE.
     1785   PROCEDURE reopen_query :
     1786     OPEN QUERY wlist FOR EACH tt   WHERE tt.level <= show_levels AND tt.visible .
     1787     IF save_recid NE ? THEN DO:
     1788         FIND FIRST x_tt WHERE RECID(x_tt) = save_recid NO-ERROR.
     1789         IF AVAILABLE x_tt THEN DO:
     1790             DO WHILE x_tt.level > show_levels:
     1791                 save_recid = x_tt.parent-recid.
     1792                 FIND x_tt WHERE RECID(x_tt) = save_recid.
     1793             END.
     1794             REPOSITION wlist TO RECID save_recid.
     1795         END.
     1796     END.
     1797   END PROCEDURE.
     1798   PROCEDURE send-records :
     1799     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1800     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1801     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1802     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1803     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1804     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1805         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1806         CASE ENTRY(i, p-tbl-list):
     1807       WHEN "tt":U THEN p-rowid-list = p-rowid-list +
     1808           IF AVAILABLE tt THEN STRING(ROWID(tt))
     1809           ELSE "?":U.
     1810           OTHERWISE
     1811           DO:
     1812               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1813                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1814               IF link-handle NE "":U THEN
     1815               DO:
     1816                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1817                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1818                               "encountered more than one RECORD-SOURCE.":U SKIP
     1819                               "The first will be used.":U
     1820                               VIEW-AS ALERT-BOX ERROR.
     1821                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1822                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1823                   p-rowid-list = p-rowid-list + rowid-string.
     1824               END.
     1825               ELSE
     1826               DO:
     1827                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1828                           "does not match tables in send-records":U
     1829                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1830                           "Check that objects are linked properly and that":U
     1831                           "database qualification is consistent.":U
     1832                       VIEW-AS ALERT-BOX ERROR.
     1833                   RETURN ERROR.
     1834               END.
     1835           END.
     1836           END CASE.
     1837       END.
     1838   END PROCEDURE.
     1839   PROCEDURE set_expansion :
     1840     DEFINE INPUT PARAMETER pRecid  AS RECID   NO-UNDO.
     1841     DEFINE INPUT PARAMETER pExpand AS LOGICAL NO-UNDO.
     1842     DEFINE BUFFER child_tt FOR tt.
     1843     FIND tt WHERE RECID(tt) eq pRECID NO-ERROR.
     1844     IF AVAILABLE tt THEN DO:
     1845       tt.expanded = pExpand.
     1846       FOR EACH child_tt WHERE child_tt.parent-recid eq pRecid:
     1847         RUN set_visible (RECID(child_tt), pExpand).
     1848       END.
     1849     END.
     1850   END PROCEDURE.
     1851   PROCEDURE set_visible :
     1852     DEFINE INPUT PARAMETER pRecid   AS RECID   NO-UNDO.
     1853     DEFINE INPUT PARAMETER pVisible AS LOGICAL NO-UNDO.
     1854     DEFINE BUFFER child_tt FOR tt.
     1855     FIND tt WHERE RECID(tt) eq pRECID NO-ERROR.
     1856     IF AVAILABLE tt THEN DO:
     1857       tt.visible = pVisible.
     1858       FOR EACH child_tt WHERE child_tt.parent-recid eq pRecid:
     1859         IF NOT pVisible OR (tt.expanded AND pVisible)
     1860         THEN RUN set_visible (RECID(child_tt), pVisible).
     1861       END.
     1862     END.
     1863   END PROCEDURE.
     1864   PROCEDURE state-changed :
     1865     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1866     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1867   END PROCEDURE.
