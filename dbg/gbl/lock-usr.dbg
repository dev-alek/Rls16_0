        1   block-level on error undo, throw.
        2   define input  parameter p-user-id         as character no-undo .
        3   define input  parameter p-resource-key    as character no-undo .
        4   define input  parameter p-message-on      as logical   no-undo .
        5   define input  parameter p-message-txt     as character no-undo .
        6   define input  parameter p-max-user-lock   as integer   no-undo .
        7   define parameter buffer lock_batchprocess for ub.batchprocess .
        8   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   def var vss-author      as character no-undo init "$Author: expertek $":U .
       10   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   def var vss-workfile    as character no-undo init "$Workfile: lock-usr.p $":U .
       12   def var vss-archive     as character no-undo init "$Archive: gbl/lock-usr.p $":U .
       13   def var vss-description as character no-undo init "Программа блокировки ресурсов".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('':u,p-user-id,p-resource-key,p-message-on,p-max-user-lock)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   def buffer buf_batchprocess for ub.batchprocess .
      301   def buffer delete_batchprocess for ub.batchprocess .
      302   define buffer trylock_batchprocess for ub.batchprocess .
      303   define variable g#userid as character no-undo .
      304   assign
      305     g#userid = p-user-id
      306   .
      307   do
      308   on error undo, return error
      309   :
      310     if p-resource-key = ?
      311     or p-resource-key = ""
      312     or length(p-resource-key) > 4
      313     then do:
      314       message
      315         vss-workfile vss-revision vss-description skip
      316         "Ошибка задания параметров" skip
      317         "Код ресурса должен быть задан"
      318         "и не может превышать 4 символа" skip
      319         "Код ресурса" p-resource-key skip
      320         view-as alert-box error .
      321       undo, return error .
      322     end.
      323     def var v-bp_type like ub.batchprocess.bp_type no-undo .
      324     assign
      325       v-bp_type = 'lusr':u + p-resource-key
      326     .
      327     define variable v-count-lock as integer   no-undo .
      328     assign
      329       v-count-lock = 0
      330     .
      331     define variable v-Key#_One as integer   no-undo .
      332     define variable v-prev-Key#_One as integer   no-undo .
      333     assign
      334       v-Key#_One = 0
      335       v-prev-Key#_One = 1
      336     .
      337     for each buf_batchprocess no-lock
      338       where buf_batchprocess.bp_type = v-bp_type
      339         and buf_batchprocess.bp_status = 'N':U
      340     by buf_batchprocess.Key#_One
      341     on error undo, return error return-value
      342     :
      343       do transaction
      344       on error undo, return error return-value
      345       :
      346         find first trylock_batchprocess exclusive-lock
      347           where recid(trylock_batchprocess) = recid(buf_batchprocess)
      348           no-error
      349           no-wait
      350           .
      351         if available trylock_batchprocess then do:
      352           delete trylock_batchprocess .
      353           next .
      354         end.
      355         else do:
      356           assign
      357             v-count-lock = v-count-lock + 1
      358           .
      359         end.
      360         if buf_batchprocess.Key#_one > v-prev-Key#_One + 1
      361         then do:
      362           assign
      363             v-Key#_One = v-prev-Key#_One + 1
      364           .
      365         end.
      366         assign
      367           v-prev-Key#_One = buf_batchprocess.Key#_one
      368         .
      369         if p-max-user-lock < v-count-lock + 1 then do:
      370           if p-message-on
      371           then do:
      372             message
      373               substitute(p-message-txt, p-max-user-lock) skip
      374               view-as alert-box error .
      375           end.
      376           undo, return error .
      377         end.
      378       end.
      379     end.
      380     if v-key#_one = 0
      381     then do:
      382       assign
      383         v-Key#_One = v-prev-Key#_One + 1
      384       .
      385     end.
      386     do transaction
      387     on error undo, return error return-value
      388     :
      389     find first ub.batchprocess no-lock
      390       where ub.batchprocess.bp_type   = v-bp_type
      391         and ub.batchprocess.bp_status = 'N':U
      392         and  ub.batchprocess.key#_one  = v-Key#_One
      393     no-error .
      394     if not available ub.BatchProcess then do:
      395       create ub.BatchProcess .
      396           define variable v-btpr_upd-today-1 as date      no-undo.
      397       define variable v-btpr_upd-time-1  as integer   no-undo.
      398       run cur-time in this-procedure ( output v-btpr_upd-today-1
      399                                      , output v-btpr_upd-time-1
      400                                      ).
      401       assign
      402         ub.BatchProcess.BP_Type       = v-bp_type
      403         ub.BatchProcess.BP_Status     = 'N':U
      404         ub.BatchProcess.BatchProcess# = next-value( s-btpr, ub )
      405         ub.BatchProcess.User_ID       = g#userid
      406         ub.BatchProcess.BP_SysDate    = v-btpr_upd-today-1
      407         ub.BatchProcess.BP_SysTime    = string( v-btpr_upd-time-1, 'HH:MM' )
      408         ub.BatchProcess.BP_SysTimeInt = v-btpr_upd-time-1
      409       .
      410       assign
      411         ub.BatchProcess.Key#_One      = v-Key#_One
      412       .
      413     end.
      414       validate ub.batchprocess .
      415     end.
      416     run lock-record in this-procedure
      417       (buffer ub.batchprocess
      418       ,buffer lock_batchprocess
      419       ) no-error .
      420     if error-status :error then do:
      421       if error-status :get-message(1) <> "" then do:
      422         message
      423           vss-workfile vss-revision vss-description skip
      424           "Ошибка при вызове процедуры lock-record" skip
      425           view-as alert-box error .
      426       end.
      427       undo, return error .
      428     end.
      429   end.
      430   procedure lock-record :
      431     define parameter buffer other_batchprocess for ub.batchprocess .
      432     define parameter buffer buf_batchprocess for ub.batchprocess .
      433     def var v-resource-id as character no-undo .
      434     do
      435     on error undo, return error
      436     :
      437       find buf_batchprocess exclusive-lock
      438         where recid(buf_batchprocess) = recid(other_batchprocess)
      439         no-wait
      440         no-error .
      441       if not available buf_batchprocess then do:
      442         if locked buf_batchprocess then do:
      443           if p-message-on then do:
      444             message
      445               "Другой пользователь уже захватил ресурс" skip
      446               "Пользователь" other_batchprocess.bp_execuser_id skip
      447               "Дата начала работы " other_batchprocess.bp_execsysdate skip
      448               "Время начала работы " other_batchprocess.bp_execsystime skip
      449               v-resource-id skip
      450               view-as alert-box error .
      451           end.
      452         end.
      453         else do:
      454           message
      455             vss-workfile vss-revision vss-description skip
      456             "Внутренняя ошибка при блокировании ресурса" skip
      457             "Отсутствует запись о блокировке ресурса" skip
      458             view-as alert-box error.
      459         end.
      460         undo, return error.
      461       end.
      462       assign
      463         lock_batchprocess.bp_execuser_id    = g#userid
      464         lock_batchprocess.bp_execsysdate    = today
      465         lock_batchprocess.bp_execsystime    = string(time, 'hh:mm')
      466       .
      467     end.
      468   end procedure.
