        1   block-level on error undo, throw.
        2   define input  parameter parparentproc   as handle    no-undo.
        3   define input  parameter p-b-c           as character no-undo .
        4   define output parameter p-bar-code      as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: scanbc.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/scanbc.p $":U .
       10   define variable vss-description as character no-undo init "Распознавание бар-кода".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1':u,p-b-c)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable is-err as logical   no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   DEFINE TEMP-TABLE in-bc NO-UNDO
       71        FIELD nm        as INTEGER
       72        FIELD bar-str   AS CHARACTER
       73        FIELD bar-code  as CHARACTER
       74        FIELD rez       as CHARACTER
       75        FIELD err-msg   as CHARACTER
       76        FIELD des       as CHARACTER
       77        INDEX pi IS PRIMARY nm.
       78   DEFINE new SHARED TEMP-TABLE un-bc NO-UNDO
       79        FIELD nm             as INTEGER
       80        FIELD bar-code       as CHARACTER
       81        FIELD entity         as character
       82        FIELD b-c            as INTEGER
       83        FIELD rate           as DECIMAL
       84        FIELD TYPE-bc        as CHARACTER
       85        FIELD wt             as DECIMAL
       86        FIELD file-qnty      as decimal
       87        FIELD scn-qnty       as DECIMAL
       88        FIELD scn-pl         as CHARACTER
       89        FIELD artic          LIKE ub.goods.artic
       90        FIELD prod-type      LIKE ub.goods.prod-type
       91        FIELD prod-code      LIKE ub.goods.prod-code
       92        FIELD gds-name       LIKE ub.goods.gds-name
       93        FIELD prod-name      LIKE ub.clients.obj-name
       94        FIELD unit-base      LIKE ub.goods.unit-base
       95        FIELD units-type     LIKE ub.units.type
       96        FIELD f-name         LIKE ub.gds-prt.f-name
       97        FIELD in-code        LIKE ub.parts.in-code
       98        FIELD fact-date      LIKE ub.parts.fact-date
       99        FIELD part-code      LIKE ub.parts.part-code
      100        FIELD rez            as CHARACTER
      101        FIELD err-msg        as CHARACTER
      102        FIELD des            as CHARACTER
      103        FIELD pl-name        AS CHARACTER
      104        FIELD loc1           AS CHARACTER
      105        FIELD loc2           AS CHARACTER
      106        FIELD loc3           AS CHARACTER
      107        FIELD loc4           AS CHARACTER
      108        FIELD unit-name      LIKE ub.units.unit-name
      109        FIELD long-name      LIKE ub.units.long-name
      110        FIELD b-c-base       LIKE ub.bar-code.b-code
      111        FIELD unit-name-base LIKE ub.units.unit-name
      112        FIELD long-name-base LIKE ub.units.long-name
      113        INDEX pi IS PRIMARY  nm
      114        INDEX bar-code bar-code
      115        INDEX b-c b-c
      116        INDEX file-qnty file-qnty.
      117   DEFINE new SHARED TEMP-TABLE anlz-bc NO-UNDO
      118        FIELD nm       as INTEGER
      119        FIELD b-c      as integer
      120        FIELD scn-qnty as DECIMAL
      121        FIELD scn-pl   as CHARACTER
      122        FIELD rez      as CHARACTER
      123        FIELD err-msg  as CHARACTER
      124        FIELD des      as CHARACTER
      125        FIELD upd-line as logical initial no
      126        INDEX pi IS PRIMARY nm
      127        INDEX b-c b-c.
      128   DEFINE new SHARED TEMP-TABLE main-bc NO-UNDO
      129        FIELD nm       as INTEGER
      130        FIELD b-c      as integer
      131        FIELD scn-qnty as DECIMAL
      132        FIELD scn-pl   as CHARACTER
      133        FIELD rez      as CHARACTER
      134        FIELD des      as CHARACTER
      135        INDEX pi IS PRIMARY nm
      136        INDEX b-c b-c.
      137   do
      138   on error undo, return error return-value
      139   :
      140     for each un-bc
      141     on error undo, return error return-value
      142     :
      143       delete un-bc.
      144     end.
      145     run str/bc-anlz.p
      146       (input parparentproc
      147       ,input  'code-add':u
      148       ,input  p-b-c
      149       ,input  yes
      150       ,output is-err
      151       ,output table in-bc
      152       ) no-error .
      153     if error-status :error then do:
      154       message
      155         vss-workfile vss-revision vss-description skip
      156         "Ошибка при анализе бар-кода" skip
      157         "Бар-код" p-b-c skip
      158         view-as alert-box error.
      159       undo, return error.
      160     end.
      161     find last un-bc no-error.
      162     if  available un-bc
      163     and un-bc.rez <> "ERR"
      164     then do:
      165        assign
      166          p-bar-code = un-bc.b-c
      167        .
      168     end.
      169     else do:
      170       undo, return error.
      171     end.
      172   end.
