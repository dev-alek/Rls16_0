        1   block-level on error undo, throw.
        2   define input  parameter p-unique-doc-code as character no-undo .
        3   define input  parameter p-b-code          as integer   no-undo .
        4   define input  parameter p-set-qnty        as decimal   no-undo .
        5   define input  parameter p-last-date       as date      no-undo .
        6   define input  parameter p-price-docf      as decimal   no-undo .
        7   define input  parameter p-user-id         as character no-undo .
        8   define input  parameter p-action          as character no-undo .
        9   define output parameter p-status          as character no-undo .
       10   define output parameter p-error-message   as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: rt-lined.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-lined.p $":U .
       16   define variable vss-description as character no-undo init "–адиотерминал. «арегистрировать количество по строке документа".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure cur-time :
       77      define output parameter p-today as date      no-undo .
       78      define output parameter p-time  as integer   no-undo .
       79     do
       80     on error undo, return error
       81     :
       82       define variable v-date1 as date      no-undo .
       83       define variable v-date2 as date      no-undo .
       84       define variable v-time  as integer   no-undo .
       85       assign
       86         v-date1 = today
       87         v-time  = time
       88         v-date2 = today
       89       .
       90       if v-date1 <> v-date2
       91       then do:
       92         assign
       93           v-date1 = today
       94           v-time  = v-time
       95         .
       96       end.
       97       assign
       98         p-today = v-date1
       99         p-time  = v-time
      100       .
      101     end.
      102   end.
      103   function cur-time-date returns character
      104   :
      105     return string(today, '99/99/9999':U) .
      106   end.
      107   function cur-time-mjd returns decimal
      108   :
      109     define variable v-date as date      no-undo .
      110     define variable v-time as integer   no-undo .
      111     run cur-time in this-procedure
      112       (output v-date
      113       ,output v-time
      114       ) .
      115     return integer(v-date) - 2400002 + (v-time / 86400) .
      116   end.
      117   function cur-time-get-ending-index returns integer
      118   (input p-number as integer
      119   )
      120   :
      121     if p-number < 0
      122     or p-number = ?
      123     then do:
      124       return 1 .
      125     end.
      126     define variable v-rest as integer   no-undo .
      127     assign
      128       p-number = p-number modulo 100
      129     .
      130     if p-number < 20
      131     then do:
      132       assign
      133         v-rest = p-number
      134       .
      135     end.
      136     else do:
      137       assign
      138         v-rest = p-number modulo 10
      139       .
      140     end.
      141     case v-rest :
      142       when 1
      143       then do:
      144         return 2 .
      145       end.
      146       when 2 or
      147       when 3 or
      148       when 4
      149       then do:
      150         return 3 .
      151       end.
      152       otherwise do:
      153         return 1 .
      154       end.
      155     end case .
      156   end.
      157   procedure cur-time-mjd-to-date :
      158      define input  parameter i-mjd-diff as decimal no-undo.
      159      define output parameter o-Date     as date    no-undo.
      160      define output parameter o-Time     as integer no-undo.
      161      define variable v-day-number as integer   no-undo .
      162      if    i-mjd-diff < 0
      163         or i-mjd-diff = ?
      164      then do:
      165         return "?" .
      166      end.
      167      assign
      168         v-day-number = truncate(i-mjd-diff,0).
      169         o-Date = date(v-day-number + 2400002).
      170         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      171     .
      172   end.
      173   function cur-time-mjd-to-string returns character
      174   (input p-mjd-diff as decimal
      175   )
      176   :
      177     define variable v-day-number as integer   no-undo .
      178     define variable v-seconds    as integer   no-undo .
      179     define variable v-hour       as integer   no-undo .
      180     define variable v-min        as integer   no-undo .
      181     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дн€" ] .
      182     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      183     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      184     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      185     if p-mjd-diff < 0
      186     or p-mjd-diff = ?
      187     then do:
      188       return "?" .
      189     end.
      190     assign
      191       v-day-number = integer(truncate(p-mjd-diff,0))
      192       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      193     .
      194     if v-seconds > 86400
      195     then do:
      196       assign
      197         v-seconds = 86400 - 1
      198       .
      199     end.
      200     if v-seconds < 0
      201     then do:
      202       assign
      203         v-seconds = 0
      204       .
      205     end.
      206     assign
      207       v-hour = truncate(v-seconds / 3600, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 3600
      211     .
      212     assign
      213       v-min = truncate(v-seconds / 60, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 60
      217     .
      218     return
      219         (if v-day-number <> 0
      220           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0
      224           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      228           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      229           else ""
      230         )
      231       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      232       .
      233   end.
      234   function cur-time-string returns character
      235   :
      236     define variable v-date as date      no-undo .
      237     define variable v-time as integer   no-undo .
      238     run cur-time in this-procedure
      239       (output v-date
      240       ,output v-time
      241       ) .
      242     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      243   end.
      244   function cur-time-string-sec returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      253   end.
      254   function cur-time-custom  returns character
      255   (input p-prefix as character
      256   ,input p-date-format as character
      257   ,input p-delimiter as character
      258   ,input p-time-format as character
      259   ,input p-suffix as character
      260   )
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return
      269       p-prefix
      270       + string(v-date, p-date-format)
      271       + p-delimiter
      272       + string(v-time, p-time-format)
      273       + p-suffix
      274       .
      275   end.
      276   function cur-time-print  returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return "ƒата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      285   end.
      286   function cur-time-datetime returns datetime
      287   :
      288     define variable v-char as character no-undo .
      289     define variable v-datetime as datetime no-undo .
      290     v-char = cur-time-string().
      291     v-datetime = datetime(v-char).
      292     return  v-datetime.
      293   end.
      294   function cur-time-string-msec returns character
      295   :
      296     define variable v-date as datetime  no-undo .
      297     v-date = now.
      298     return string(v-date) .
      299   end.
      300   define buffer buf_batchprocess for ub.batchprocess .
      301   do
      302   on error undo, return error return-value
      303   :
      304     case p-action
      305     :
      306       when 'create-update':u
      307       then do:
      308         find first buf_batchprocess exclusive-lock
      309           where buf_batchprocess.bp_type     = 'rt-line':U
      310             and buf_batchprocess.bp_status   = 'N':U
      311             and buf_batchprocess.charkey_one = p-unique-doc-code
      312             and buf_batchprocess.key#_one    = p-b-code
      313           no-error .
      314         if not available buf_batchprocess
      315         then do:
      316           create buf_batchprocess .
      317           define variable v-btpr_upd-today as date      no-undo .
      318           define variable v-btpr_upd-time  as integer   no-undo .
      319           run cur-time in this-procedure
      320             (output v-btpr_upd-today
      321             ,output v-btpr_upd-time
      322             ).
      323           assign
      324             buf_batchprocess.bp_type        = 'rt-line':U
      325             buf_batchprocess.bp_status      = 'N':U
      326             buf_batchprocess.batchprocess#  = next-value(s-btpr, ub)
      327             buf_batchprocess.user_id        = p-user-id
      328             buf_batchprocess.bp_sysdate     = v-btpr_upd-today
      329             buf_batchprocess.bp_systime     = string( v-btpr_upd-time, 'hh:mm' )
      330             buf_batchprocess.bp_systimeint  = v-btpr_upd-time
      331             buf_batchprocess.charkey_one    = p-unique-doc-code
      332             buf_batchprocess.key#_one       = p-b-code
      333           .
      334         end.
      335         assign
      336           buf_batchprocess.bp_execsystime = string( p-set-qnty )
      337         .
      338         if p-last-date <> ?
      339         then do:
      340           assign
      341             buf_batchprocess.charkey_two    = string( p-last-date , "99/99/9999" )
      342           .
      343         end.
      344         if p-price-docf <> ?
      345         then do:
      346           assign
      347             buf_batchprocess.charkey_three  = string( p-price-docf )
      348           .
      349         end.
      350         assign
      351           p-status        = '0':u
      352           p-error-message = ''
      353         .
      354         return .
      355       end.
      356       otherwise do:
      357         undo, return error substitute("Ќеизвестное значение параметра p-action &1", p-action)
      358           .
      359       end.
      360     end.
      361   end.
