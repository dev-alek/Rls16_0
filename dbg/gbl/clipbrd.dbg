        1   block-level on error undo, throw.
        2   define input  parameter p-text as character no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: clipbrd.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: gbl/clipbrd.p $":U .
        8   define variable vss-description as character no-undo init "Записать строку в буфер обмена (clipboard)".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
       65     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
       66   FUNCTION GetLastError
       67            RETURNS INTEGER
       68            ()
       69            IN hpWinFunc.
       70   FUNCTION GetParent
       71            RETURNS INTEGER
       72            (input hwnd as INTEGER)
       73            IN hpWinFunc.
       74   FUNCTION ShowLastError
       75            RETURNS INTEGER
       76            ()
       77            IN hpWinFunc.
       78   FUNCTION CreateProcess
       79            RETURNS INTEGER
       80            (input CommandLine as CHAR,
       81             input CurrentDir  as CHAR,
       82             input wShowWindow as INTEGER)
       83            in hpWinFunc.
       84   define variable v-return-value as integer   no-undo .
       85   do
       86   on error undo, return error return-value
       87   :
       88     run OpenClipboard
       89       (input  0
       90       ,output v-return-value
       91       ) .
       92     if v-return-value = 0
       93     then do:
       94       message
       95         vss-workfile vss-revision vss-description skip
       96         "Ошибка при вызове функции OpenClipboard" skip
       97         ShowLastError() skip
       98         view-as alert-box error .
       99       undo, return error return-value .
      100     end.
      101     run EmptyClipboard
      102       (output v-return-value
      103       ) .
      104     define variable hMem-unicode          as integer   no-undo .
      105     define variable hMem-ansi             as integer   no-undo .
      106     define variable hGlobal-unicode       as integer   no-undo .
      107     define variable hGlobal-ansi          as integer   no-undo .
      108     define variable v-buffer-size-unicode as integer   no-undo .
      109     define variable v-buffer-size-ansi    as integer   no-undo .
      110     assign
      111       v-buffer-size-unicode = (length(p-text) + 1) * 2
      112       v-buffer-size-ansi    = length(p-text) + 1
      113     .
      114     run GlobalAlloc
      115       (input  2
      116       ,input  v-buffer-size-unicode
      117       ,output hMem-unicode
      118       ) .
      119     if hMem-unicode = 0
      120     then do:
      121       message
      122         vss-workfile vss-revision vss-description skip
      123         "Ошибка при вызове функции GlobalAlloc" skip
      124         ShowLastError() skip
      125         view-as alert-box error .
      126       run CloseClipboard
      127         (output v-return-value
      128         ) .
      129       undo, return error return-value .
      130     end.
      131     run GlobalAlloc
      132       (input  2
      133       ,input  v-buffer-size-ansi
      134       ,output hMem-ANSI
      135       ) .
      136     if hMem-ANSI = 0
      137     then do:
      138       message
      139         vss-workfile vss-revision vss-description skip
      140         "Ошибка при вызове функции GlobalAlloc" skip
      141         ShowLastError() skip
      142         view-as alert-box error .
      143       run CloseClipboard
      144         (output v-return-value
      145         ) .
      146       run GlobalFree
      147         (input  hMem-unicode
      148         ,output v-return-value
      149         ) .
      150       undo, return error return-value .
      151     end.
      152     run GlobalLock
      153       (input  hMem-unicode
      154       ,output hGlobal-unicode
      155       ) .
      156     run GlobalLock
      157       (input  hMem-ansi
      158       ,output hGlobal-ansi
      159       ) .
      160     define variable v-data as memptr no-undo .
      161     define variable v-data-ansi as memptr no-undo .
      162     assign
      163       set-size(v-data) = length(p-text) + 1
      164       set-pointer-value(v-data-ansi) = hGlobal-ansi
      165     .
      166     assign
      167       put-string(v-data, 1) = p-text
      168       put-string(v-data-ansi, 1) = p-text
      169     .
      170     run MultiByteToWideChar
      171       (input  0
      172       ,input  0
      173       ,input  get-pointer-value(v-data)
      174       ,input  -1
      175       ,input  hGlobal-unicode
      176       ,input  v-buffer-size-unicode
      177       ,output v-return-value
      178       ) .
      179     if v-return-value = 0
      180     then do:
      181       message
      182         vss-workfile vss-revision vss-description skip
      183         "Ошибка при вызове процедуры MultiByteToWideChar" skip
      184         view-as alert-box error .
      185     end.
      186     assign
      187       set-size(v-data) = 0
      188     .
      189     run GlobalUnlock
      190       (input  hMem-unicode
      191       ,output v-return-value
      192       ) .
      193     run GlobalUnlock
      194       (input  hMem-ansi
      195       ,output v-return-value
      196       ) .
      197     run SetClipboardData
      198       (input  1
      199       ,input  hMem-ansi
      200       ,output v-return-value
      201       ) .
      202     if v-return-value = 0
      203     then do:
      204       run CloseClipboard
      205         (output v-return-value
      206         ) .
      207       run GlobalFree
      208         (input  hMem-unicode
      209         ,output v-return-value
      210         ) .
      211       run GlobalFree
      212         (input  hMem-ansi
      213         ,output v-return-value
      214         ) .
      215       message
      216         vss-workfile vss-revision vss-description skip
      217         "Ошибка при вызове функции SetClipboardData" skip
      218         ShowLastError() skip
      219         view-as alert-box error .
      220       undo, return error return-value .
      221     end.
      222     run SetClipboardData
      223       (input  13
      224       ,input  hMem-unicode
      225       ,output v-return-value
      226       ) .
      227     if v-return-value = 0
      228     then do:
      229       run CloseClipboard
      230         (output v-return-value
      231         ) .
      232       run GlobalFree
      233         (input  hMem-unicode
      234         ,output v-return-value
      235         ) .
      236       message
      237         vss-workfile vss-revision vss-description skip
      238         "Ошибка при вызове функции SetClipboardData" skip
      239         ShowLastError() skip
      240         view-as alert-box error .
      241       undo, return error return-value .
      242     end.
      243     run CloseClipboard
      244       (output v-return-value
      245       ) .
      246   end.
      247   PROCEDURE MultiByteToWideChar EXTERNAL "kernel32.dll" :
      248     define input  parameter uCodePage      as long .
      249     define input  parameter dwFlags        as long .
      250     define input  parameter lpMultiByteStr as long .
      251     define input  parameter cbMubtiByte    as long .
      252     define input  parameter lpWideCharStr  as long .
      253     define input  parameter cbMultiByte    as long .
      254     define return parameter iRetCode       as long .
      255   END.
      256   PROCEDURE GlobalAlloc EXTERNAL "kernel32.dll" :
      257     DEFINE INPUT  PARAMETER uFlags     AS LONG .
      258     DEFINE INPUT  PARAMETER dwBytes    AS LONG .
      259     DEFINE RETURN PARAMETER hMem       AS LONG .
      260   END PROCEDURE.
      261   PROCEDURE GlobalFree EXTERNAL "kernel32.dll" :
      262     DEFINE INPUT  PARAMETER hMem   AS LONG .
      263     DEFINE RETURN PARAMETER Result AS LONG .
      264   END PROCEDURE.
      265   PROCEDURE GlobalLock EXTERNAL "kernel32.dll" :
      266     DEFINE INPUT  PARAMETER hMem       AS LONG .
      267     DEFINE RETURN PARAMETER hGlobal    AS LONG .
      268   END PROCEDURE.
      269   PROCEDURE GlobalUnlock EXTERNAL "kernel32.dll" :
      270     DEFINE INPUT  PARAMETER hGlobal     AS LONG .
      271     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      272   END PROCEDURE.
      273   PROCEDURE OpenClipboard EXTERNAL "user32.dll" :
      274     DEFINE INPUT  PARAMETER hWnd        AS LONG .
      275     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      276   END PROCEDURE.
      277   PROCEDURE SetClipboardData EXTERNAL "user32.dll" :
      278     DEFINE INPUT  PARAMETER uFormat     AS LONG .
      279     DEFINE INPUT  PARAMETER hMem        AS LONG .
      280     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      281   END PROCEDURE.
      282   PROCEDURE EmptyClipboard EXTERNAL "user32.dll" :
      283     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      284   END PROCEDURE.
      285   PROCEDURE CloseClipboard EXTERNAL "user32.dll" :
      286     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      287   END PROCEDURE.
