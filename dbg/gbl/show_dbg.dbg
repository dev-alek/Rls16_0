        1   define temp-table temp-prwninfo no-undo
        2     field proc-id           as integer   format ">>>>>9"     label "Процесс"
        3     field progress-version  as character format "X(9)"       label "Версия"
        4     field progress-self     as logical   format "+/-"        label "Сам"
        5     field module-file-name  as character format "x(40)"      label "Исполняемый файл"
        6     field progress-propath  as character format "x(40)"      label "Путь поиска файлов (PROPATH)"
        7     field progress-inifile  as character format "x(40)"      label "Ini файл"
        8     field progress-curdir   as character format "x(40)"      label "Рабочая директория"
        9     field trans-active      as logical   format "+/-"        label "Транз."
       10     field cmd-line          as character format "x(160)"     label "Командная строка"
       11     field message-handle    as integer   format ">>>>>>>>9"  label "Указатель окна"
       12     field message-text      as character format "x(40)"      label "Сообщение"
       13     field proc-name         as character format "x(40)"      label "Имя программы"
       14     field proc-line         as integer   format "->>>>>>>>9" label "Строка"
       15     field r-code-name       as character format "x(40)"      label "Модуль"
       16     field db-connect-string as character format "x(40)"      label "Строка подключения"
       17     field widget-percent    as decimal   format ">>9.99%"    label "WdgUsed"
       18     field widget-num        as integer   format ">>>>>>>>9"  label "WidgNum"
       19     field max-widget-num    as integer   format ">>>>>>>>9"  label "Max widget num"
       20     index xpk is primary unique proc-id
       21     index is-self progress-self
       22   .
       23   define temp-table temp-prwnprocinfo no-undo
       24     field proc-id       as integer   format ">>>9"        label "Процесс"
       25     field proc-level    as integer   format ">>>9"        label "Уровень"
       26     field h-proc        as integer   format ">>>>>>>>>>>" label "Ук.программы"
       27     field proc-name     as character format "x(40)"       label "Имя программы"
       28     field proc-line     as integer   format "->>>>>>>>9"  label "Строка"
       29     field r-code-name   as character format "x(40)"       label "Модуль"
       30     field sub-procedure as logical
       31     field subproc-num   as integer   format ">>>>>9"
       32     index xpk is primary unique proc-id proc-level
       33   .
       34   define temp-table temp-procinfo no-undo
       35     field proc-level    as integer   format ">>>9"         label "Уровень"
       36     field h-proc        as integer   format ">>>>>>>>>>>"  label "Ук.программы"
       37     field proc-name     as character format "x(40)"        label "Имя программы"
       38     field proc-line     as integer   format "->>>>>>>>9"   label "Строка"
       39     field r-code-name   as character format "x(40)"        label "Модуль"
       40     field sub-procedure as logical
       41     field subproc-num   as integer   format ">>>>>9"
       42     index xpk is primary unique proc-level
       43   .
       44   define temp-table temp-window no-undo
       45      field window-handle       as integer   label "Handle"
       46      field window-visible      as logical   label "Visible"
       47      field window-text         as character label "Text"     format "x(20)"
       48      field window-class-atom   as integer   label "Class Atom"
       49      field window-class-name   as character label "Class Name"
       50      field window-message      as logical
       51      field window-message-text as character label "Message"  format "x(60)"
       52      field window-process-id   as integer   label "Process"
       53      field window-thread-id    as integer   label "Thread"
       54   .
       55   define temp-table temp-progress-version-info no-undo
       56      field progress-version as character
       57      field procedure-handle as character
       58      field pgc              as character
       59      field pdb-task         as character
       60      field savename         as character
       61      field the-display      as character
       62      field wic-max-id       as character
       63      index xpk is primary unique progress-version
       64   .
       65   define temp-table temp-dbg-file-header no-undo
       66     field proc-id     as integer   format ">>>9"  label "Процесс"
       67     field r-code-name as character format "x(40)" label "Модуль"
       68     field file-num    as integer   format ">>>9"  label "Номер файла"
       69     index xpk is primary unique proc-id r-code-name
       70     index x-file-num file-num
       71   .
       72   define temp-table temp-dbg-file no-undo
       73     field file-num  as integer   format ">>>9"    label "Номер файла"
       74     field line-num  as integer   format ">>>9"    label "Номер строки"
       75     field line-text as character format "x(200)" label "Строка"
       76     index xpk is primary unique file-num line-num
       77   .
       78   define temp-table temp-show-file no-undo
       79     field line-num  as integer   format ">>>9"    label "Номер строки"
       80     field line-text as character format "x(200)" label "Строка"
       81     index xpk is primary unique line-num
       82   .
       83   define input  parameter table for temp-show-file .
       84   define input  parameter p-line-num as integer   no-undo .
       85   define variable vss-revision    as character no-undo init "$Revision$":U .
       86   define variable vss-author      as character no-undo init "$Author$":U .
       87   define variable vss-date        as character no-undo init "$Date$":U .
       88   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       89   define variable vss-archive     as character no-undo init "$Archive$":U .
       90   define variable vss-description as character no-undo init "Просмотр файла".
       91   procedure vss-get-info :
       92     define output parameter p-vss-revision    like vss-revision    no-undo .
       93     define output parameter p-vss-author      like vss-author      no-undo .
       94     define output parameter p-vss-date        like vss-date        no-undo .
       95     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       96     define output parameter p-vss-archive     like vss-archive     no-undo .
       97     define output parameter p-vss-description like vss-description no-undo .
       98     assign
       99       p-vss-revision    = vss-revision
      100       p-vss-author      = vss-author
      101       p-vss-date        = vss-date
      102       p-vss-workfile    = vss-workfile
      103       p-vss-archive     = vss-archive
      104       p-vss-description = vss-description
      105     .
      106   end procedure.
      107   procedure vss-get-parameters :
      108     define output parameter p-vss-parameters as character no-undo .
      109   end procedure.
      110   define new global shared variable g#vssrevis-logger as handle    no-undo .
      111   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      112   define variable v-vssrevis-logger                   as handle    no-undo .
      113   procedure vss-logevent :
      114     define input  parameter p-extra-paramters as character no-undo .
      115     define variable v-vssrevis-parameters as character no-undo .
      116     do
      117     on error undo, return error return-value
      118     :
      119       if  valid-handle(v-vssrevis-logger)
      120       and v-vssrevis-logger :get-signature("logevent") <> ""
      121       then do:
      122         run vss-get-parameters in this-procedure
      123           (output v-vssrevis-parameters
      124           ).
      125         run logevent in v-vssrevis-logger
      126           (input vss-workfile
      127           ,input vss-revision
      128           ,input v-vssrevis-parameters
      129           ,input p-extra-paramters
      130           ).
      131       end.
      132     end.
      133   end procedure.
      134   assign
      135     v-vssrevis-logger = g#vssrevis-logger
      136   .
      137   if  valid-handle(v-vssrevis-logger)
      138   and v-vssrevis-logger :get-signature("logevent") <> ""
      139   then do:
      140     assign
      141       v-vssrevis-logevent = true
      142     .
      143     run vss-logevent in this-procedure (input vss-description) .
      144   end.
      145   define new global shared variable g#language as character no-undo .
      146   if g#language <> '' and g#language <> 'rus':U then do:
      147     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      148   end.
      149   procedure proc-alt-shift-f2:
      150     if not ibs.th.gbl.gbl-var:rcode
      151   then
      152     run gbl\inidebug.p .
      153   end.
      154   procedure proc-alt-shift-f3:
      155     run gbl/prvssinf.p
      156       ( input this-procedure
      157       ) .
      158   end.
      159   define variable v-inform-launched as logical no-undo initial false .
      160   procedure proc-alt-shift-f4:
      161     define variable v-action as character no-undo .
      162     if v-inform-launched = false then do:
      163       assign
      164         v-inform-launched = true
      165       .
      166       run gbl/d-inform.w
      167         (  input self
      168         ,  input this-procedure
      169         , output v-action
      170         ) no-error .
      171       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      172       assign
      173         v-inform-launched = false
      174       .
      175     end.
      176   end.
      177   procedure proc-alt-f1:
      178     run gbl/corrhelp.p
      179       (input this-procedure
      180       ) .
      181   end .
      182   on alt-shift-f2 anywhere do:
      183     run proc-alt-shift-f2.
      184   end.
      185   on alt-shift-f3 anywhere do:
      186     run proc-alt-shift-f3 in this-procedure .
      187   end.
      188   on alt-shift-f4 anywhere do:
      189     run proc-alt-shift-f4 in this-procedure.
      190   end.
      191   on alt-f1 anywhere do:
      192     run proc-alt-f1 in this-procedure .
      193   end.
      194   DEFINE BUTTON b-exit AUTO-GO
      195        LABEL "&Выход"
      196        SIZE 10 BY 1
      197        BGCOLOR 8 .
      198   DEFINE BUTTON b-goto
      199        LABEL "&Перейти"
      200        SIZE 10 BY 1.
      201   DEFINE BUTTON b-help
      202        LABEL "Помо&щь"
      203        SIZE 10 BY 1
      204        BGCOLOR 8 .
      205   DEFINE BUTTON b-search
      206        LABEL "По&иск"
      207        SIZE 10 BY 1.
      208   DEFINE QUERY BROWSE-3 FOR
      209         temp-show-file SCROLLING.
      210   DEFINE BROWSE BROWSE-3
      211     QUERY BROWSE-3 DISPLAY
      212         temp-show-file.line-text
      213       WITH NO-ROW-MARKERS SEPARATORS SIZE 126 BY 28 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      214   DEFINE FRAME Dialog-Frame
      215        b-exit AT ROW 1 COL 1
      216        b-goto AT ROW 1 COL 11
      217        b-search AT ROW 1 COL 21
      218        b-help AT ROW 1 COL 31
      219        BROWSE-3 AT ROW 2.25 COL 1.5
      220        SPACE(0.24) SKIP(0.20)
      221       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      222            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      223            TITLE "Просмотр файла"
      224            DEFAULT-BUTTON b-exit.
      225   ASSIGN
      226          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      227          FRAME Dialog-Frame:HIDDEN           = TRUE.
      228   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      229   DO:
      230     APPLY "END-ERROR":U TO SELF.
      231   END.
      232   ON CHOOSE OF b-goto IN FRAME Dialog-Frame
      233   DO:
      234     define variable v-max-line      as integer   no-undo .
      235     define variable v-max-line-char as character no-undo .
      236     define buffer buf_temp-show-file for temp-show-file .
      237     find last buf_temp-show-file
      238       use-index xpk
      239       no-error .
      240     if available buf_temp-show-file
      241     then do:
      242       assign
      243         v-max-line = buf_temp-show-file.line-num
      244       .
      245     end.
      246     else do:
      247       message
      248         "В файле нет ни одной строки" skip
      249         "Нельзя произвести переход по номеру строки" skip
      250         view-as alert-box error .
      251       return no-apply .
      252     end.
      253     assign
      254       v-max-line-char = string(v-max-line)
      255     .
      256     run gbl/d-prompt.w (
      257         'title=':u + "Введите номер строки" + '\':u
      258       + 'text1=':u + "Введите номер строки" + '\':u
      259       + 'text2=':u + substitute("от 1 до &1", v-max-line) + '\':u
      260       + 'format=>>>>>>9\':u
      261       + 'type=int\':u
      262       ,input-output v-max-line-char
      263       ).
      264     if return-value = 'false':u
      265     then do:
      266       return no-apply .
      267     end.
      268     assign
      269       v-max-line = integer(v-max-line-char)
      270     .
      271     find first buf_temp-show-file
      272       where buf_temp-show-file.line-num = v-max-line
      273       no-error .
      274     if available buf_temp-show-file
      275     then do:
      276       reposition BROWSE-3 to rowid rowid(buf_temp-show-file) .
      277     end.
      278     else do:
      279       message
      280         "В файле отсутствует строка с номером" v-max-line skip
      281         view-as alert-box error .
      282       undo, return no-apply .
      283     end.
      284   END.
      285   ON CHOOSE OF b-search IN FRAME Dialog-Frame
      286   DO:
      287     define variable v-search-string as character no-undo .
      288     define variable v-ok            as logical   no-undo .
      289     run gbl/d-prompt.w (
      290         'title=':u + "Введите строку поиска" + '\':u
      291       + 'text1=':u + "Введите строку поиска" + '\':u
      292       + 'format=x(255)\':u
      293       + 'type=char\':u
      294       + 'fillin_width=60\':u
      295       ,input-output v-search-string
      296       ).
      297     if return-value = 'false':u
      298     then do:
      299       return no-apply .
      300     end.
      301     define buffer buf_temp-show-file for temp-show-file .
      302     define variable v-start-search-num as integer   no-undo .
      303     define variable v-last-search-num  as integer   no-undo .
      304     define variable v-can-wrap         as logical   no-undo .
      305     define variable v-find-str         as logical   no-undo .
      306     assign
      307       v-start-search-num = temp-show-file.line-num
      308       v-can-wrap         = true
      309       v-find-str         = false
      310     .
      311     assign
      312       v-last-search-num = temp-show-file.line-num
      313     .
      314     search_block :
      315     do while true
      316     :
      317       find first buf_temp-show-file
      318         where buf_temp-show-file.line-num = v-last-search-num
      319         no-error .
      320       if not available buf_temp-show-file
      321       then do:
      322         if  v-start-search-num > 1
      323         and v-can-wrap = true
      324         then do:
      325           message
      326             "Строка не найдена" skip
      327             "Строка поиска" v-search-string  skip
      328             "Продолжить поиск с начала файла?" skip
      329             view-as alert-box question buttons yes-no update v-ok
      330             .
      331           if v-ok = true
      332           then do:
      333             assign
      334               v-can-wrap = false
      335             .
      336             find first buf_temp-show-file
      337               use-index xpk
      338               no-error .
      339           end.
      340           else do:
      341             leave search_block .
      342           end.
      343         end.
      344         else do:
      345           leave search_block .
      346         end.
      347       end.
      348       if buf_temp-show-file.line-text matches '*':u + v-search-string + '*':u
      349       then do:
      350         assign
      351           v-find-str = true
      352         .
      353         reposition BROWSE-3 to rowid rowid(buf_temp-show-file) .
      354         leave search_block .
      355       end.
      356       assign
      357         v-last-search-num = v-last-search-num + 1
      358       .
      359     end.
      360     if v-find-str <> true
      361     then do:
      362       message
      363         "Строка поиска на найдена" skip
      364         "Строка поиска" v-search-string skip
      365         view-as alert-box error .
      366     end.
      367   END.
      368   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      369   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      370   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   do:
      372     BROWSE-3 :SET-REPOSITIONED-ROW(10, "CONDITIONAL") .
      373   end.
      374   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   on help of frame Dialog-Frame
      376   do:
      377     run gbl/app_help.p
      378       (input this-procedure :file-name
      379       ,input ''
      380       ,input ?
      381       ) no-error.
      382     if error-status :error then do:
      383       message
      384         "Ошибка при вызове помощи"
      385         error-status :get-message(1)
      386         view-as alert-box .
      387     end.
      388   end.
      389   run minbtn-set in this-procedure .
      390   on choose of b-help in frame Dialog-Frame
      391   do:
      392     apply "help":u to frame Dialog-Frame .
      393   end.
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   procedure minbtn-set :
      396       do
      397           on error undo, return error return-value
      398           :
      399           define variable ii              as integer       no-undo .
      400           define variable fh              as widget-handle no-undo .
      401           define variable hh              as widget-handle no-undo .
      402           define variable v-h             as handle        extent 4 no-undo .
      403           define variable v-name-button   as character     no-undo .
      404           define variable v-help-old-x    as decimal       no-undo .
      405           define variable v-help-old-y    as decimal       no-undo .
      406           define variable v-help-old-size as decimal       no-undo .
      407           define variable v-frame-width   as decimal       no-undo .
      408           define variable jj              as integer       no-undo .
      409           do
      410               on error undo, return error
      411               :
      412               assign
      413                   v-frame-width = frame Dialog-Frame:width - 0.3
      414                   fh            = frame Dialog-Frame:first-child
      415                   hh            = fh:first-child
      416                   ii            = 1
      417                   .
      418               do while valid-handle(hh):
      419                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      420                   do:
      421                       case lc(hh:name) :
      422                           when "b-help" then
      423                               do:
      424                                   hh:load-image-up("cmp/b-help.bmp":u) .
      425                                   hh:load-image-down("cmp/b-help.bmp":u) .
      426                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      427                                   hh:TOOLTIP = "Помощь" .
      428                                   v-help-old-x = hh:column .
      429                                   v-help-old-y = hh:row    .
      430                                   v-help-old-size = hh:width .
      431                                   hh:width-chars = 2.5 .
      432                               end.
      433                           when "b-print" then
      434                               do:
      435                                   hh:load-image("cmp/b-print.bmp":u) .
      436                                   hh:TOOLTIP = "Печать" .
      437                                   v-h[ii] = hh:handle .
      438                                   ii = ii + 1 .
      439                                   hh:width-chars = 3 .
      440                               end.
      441                           when "b-history" or
      442                           when "b-hist" then
      443                               do:
      444                                   hh:load-image("cmp/b-hist.bmp":u) .
      445                                   hh:TOOLTIP = "История" .
      446                                   v-h[ii] = hh:handle .
      447                                   ii = ii + 1 .
      448                                   hh:width-chars = 3 .
      449                               end.
      450                           when "b-sch" then
      451                               do:
      452                                   hh:load-image("cmp/b-sch.bmp":u) .
      453                                   hh:TOOLTIP = "Установка Фильтра" .
      454                                   v-h[ii] = hh:handle .
      455                                   ii = ii + 1 .
      456                                   hh:width-chars = 3 .
      457                               end.
      458                           when "b-hist-user" then
      459                               do:
      460                                   hh:load-image("cmp/b-hist.bmp":u) .
      461                                   hh:TOOLTIP = "История пользователя" .
      462                                   ii = ii + 1 .
      463                               end.
      464                       end case.
      465                   end.
      466                   hh = hh:next-sibling.
      467               end.
      468               b-help:column = v-frame-width - b-help:width-chars.
      469               jj = 0.
      470               repeat ii = 4 to 1 by -1 :
      471                   if valid-handle (v-h[ii] ) then
      472                   do:
      473                       jj  = jj + 1 .
      474                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      475                       v-h[ii]:row    = v-help-old-y .
      476                   end.
      477               end.
      478           end.
      479       end.
      480   end procedure.
      481   MAIN-BLOCK:
      482   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      483      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      484     RUN enable_UI.
      485     define buffer buf_temp-show-file for temp-show-file .
      486     find first buf_temp-show-file
      487       where buf_temp-show-file.line-num = p-line-num
      488       no-error .
      489     if available buf_temp-show-file
      490     then do:
      491       reposition BROWSE-3 to rowid rowid(buf_temp-show-file) .
      492     end.
      493     WAIT-FOR GO OF FRAME Dialog-Frame.
      494   END.
      495   RUN disable_UI.
      496   PROCEDURE disable_UI :
      497     HIDE FRAME Dialog-Frame.
      498   END PROCEDURE.
      499   PROCEDURE enable_UI :
      500     ENABLE b-exit b-goto b-search b-help BROWSE-3
      501         WITH FRAME Dialog-Frame.
      502     VIEW FRAME Dialog-Frame.
      503     OPEN QUERY BROWSE-3 FOR EACH temp-show-file by temp-show-file.line-num   indexed-reposition .
      504   END PROCEDURE.
