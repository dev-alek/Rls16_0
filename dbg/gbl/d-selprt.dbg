        1   define output parameter v-node-code as integer   no-undo .
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Выбор шкалы признаков".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define temp-table temp-prt-root no-undo     field node-code  as integer label 'Код'     field prt-level  as integer label 'Уровней'     field node-name like ub.gds-prt.node-name format 'x(40)' label 'Название' column-label 'Название'     index pk is primary unique node-code     index ie1 node-name     .
      123   DEFINE BUTTON b-exit AUTO-END-KEY
      124        LABEL "&Выход"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-help
      128        LABEL "Помо&щь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-sel AUTO-GO
      132        LABEL "Вы&бор"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE QUERY BROWSE-1 FOR
      136         temp-prt-root SCROLLING.
      137   DEFINE BROWSE BROWSE-1
      138     QUERY BROWSE-1 DISPLAY
      139         node-name
      140         prt-level
      141       WITH NO-ROW-MARKERS SEPARATORS SIZE 54.13 BY 14.46.
      142   DEFINE FRAME Dialog-Frame
      143        b-exit AT ROW 1 COL 1
      144        b-sel AT ROW 1 COL 11
      145        b-help AT ROW 1 COL 21
      146        BROWSE-1 AT ROW 2.5 COL 1.5
      147        SPACE(0.86) SKIP(0.49)
      148       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      149            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      150            TITLE "Шкалы"
      151            DEFAULT-BUTTON b-exit.
      152   ASSIGN
      153          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      154          FRAME Dialog-Frame:HIDDEN           = TRUE.
      155   ON GO OF FRAME Dialog-Frame
      156   DO:
      157     if available temp-prt-root
      158     then do:
      159       assign
      160         v-node-code = temp-prt-root.node-code
      161       .
      162     end.
      163   END.
      164   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      165   DO:
      166     APPLY "END-ERROR":U TO SELF.
      167   END.
      168   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      169   DO:
      170   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   if lookup(self :type
      172            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      173            ) = 0
      174   then do:
      175     message
      176       "$Workfile$"
      177       "Указанному интерфейсному элементу фокус не может быть передан" skip
      178       "Интерфейсный элемент" self :name  skip
      179       "Тип" self :type  skip
      180       "Процедура" this-procedure :file-name skip
      181       view-as alert-box .
      182   end.
      183   else do:
      184     apply "entry":u to self  .
      185     if focus :handle <> self :handle  then do:
      186       return no-apply .
      187     end.
      188   end.
      189   END.
      190   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      191   DO:
      192   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   if lookup(self :type
      194            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      195            ) = 0
      196   then do:
      197     message
      198       "$Workfile$"
      199       "Указанному интерфейсному элементу фокус не может быть передан" skip
      200       "Интерфейсный элемент" self :name  skip
      201       "Тип" self :type  skip
      202       "Процедура" this-procedure :file-name skip
      203       view-as alert-box .
      204   end.
      205   else do:
      206     apply "entry":u to self  .
      207     if focus :handle <> self :handle  then do:
      208       return no-apply .
      209     end.
      210   end.
      211   END.
      212   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      213   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      214   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   on help of frame Dialog-Frame
      216   do:
      217     run gbl/app_help.p
      218       (input this-procedure :file-name
      219       ,input ''
      220       ,input ?
      221       ) no-error.
      222     if error-status :error then do:
      223       message
      224         "Ошибка при вызове помощи"
      225         error-status :get-message(1)
      226         view-as alert-box .
      227     end.
      228   end.
      229   run minbtn-set in this-procedure .
      230   on choose of b-help in frame Dialog-Frame
      231   do:
      232     apply "help":u to frame Dialog-Frame .
      233   end.
      234   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   procedure minbtn-set :
      236       do
      237           on error undo, return error return-value
      238           :
      239           define variable ii              as integer       no-undo .
      240           define variable fh              as widget-handle no-undo .
      241           define variable hh              as widget-handle no-undo .
      242           define variable v-h             as handle        extent 4 no-undo .
      243           define variable v-name-button   as character     no-undo .
      244           define variable v-help-old-x    as decimal       no-undo .
      245           define variable v-help-old-y    as decimal       no-undo .
      246           define variable v-help-old-size as decimal       no-undo .
      247           define variable v-frame-width   as decimal       no-undo .
      248           define variable jj              as integer       no-undo .
      249           do
      250               on error undo, return error
      251               :
      252               assign
      253                   v-frame-width = frame Dialog-Frame:width - 0.3
      254                   fh            = frame Dialog-Frame:first-child
      255                   hh            = fh:first-child
      256                   ii            = 1
      257                   .
      258               do while valid-handle(hh):
      259                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      260                   do:
      261                       case lc(hh:name) :
      262                           when "b-help" then
      263                               do:
      264                                   hh:load-image-up("cmp/b-help.bmp":u) .
      265                                   hh:load-image-down("cmp/b-help.bmp":u) .
      266                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      267                                   hh:TOOLTIP = "Помощь" .
      268                                   v-help-old-x = hh:column .
      269                                   v-help-old-y = hh:row    .
      270                                   v-help-old-size = hh:width .
      271                                   hh:width-chars = 2.5 .
      272                               end.
      273                           when "b-print" then
      274                               do:
      275                                   hh:load-image("cmp/b-print.bmp":u) .
      276                                   hh:TOOLTIP = "Печать" .
      277                                   v-h[ii] = hh:handle .
      278                                   ii = ii + 1 .
      279                                   hh:width-chars = 3 .
      280                               end.
      281                           when "b-history" or
      282                           when "b-hist" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История" .
      286                                   v-h[ii] = hh:handle .
      287                                   ii = ii + 1 .
      288                                   hh:width-chars = 3 .
      289                               end.
      290                           when "b-sch" then
      291                               do:
      292                                   hh:load-image("cmp/b-sch.bmp":u) .
      293                                   hh:TOOLTIP = "Установка Фильтра" .
      294                                   v-h[ii] = hh:handle .
      295                                   ii = ii + 1 .
      296                                   hh:width-chars = 3 .
      297                               end.
      298                           when "b-hist-user" then
      299                               do:
      300                                   hh:load-image("cmp/b-hist.bmp":u) .
      301                                   hh:TOOLTIP = "История пользователя" .
      302                                   ii = ii + 1 .
      303                               end.
      304                       end case.
      305                   end.
      306                   hh = hh:next-sibling.
      307               end.
      308               b-help:column = v-frame-width - b-help:width-chars.
      309               jj = 0.
      310               repeat ii = 4 to 1 by -1 :
      311                   if valid-handle (v-h[ii] ) then
      312                   do:
      313                       jj  = jj + 1 .
      314                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      315                       v-h[ii]:row    = v-help-old-y .
      316                   end.
      317               end.
      318           end.
      319       end.
      320   end procedure.
      321   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      322   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      323   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      324   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      325   define variable v-diasize-current-frame-width  as decimal   no-undo .
      326   define variable v-diasize-current-frame-height as decimal   no-undo .
      327   define variable v-diasize-change-size          as logical   no-undo .
      328   define variable v-diasize-resize-button        as handle    no-undo .
      329   define variable v-diasize-wndmax               as logical   no-undo .
      330   define variable v-diasize-wndstore             as logical   no-undo .
      331   define variable v-diasize-proc-name            as character no-undo .
      332   define variable v-diasize-browse-handle        as handle    no-undo .
      333   define variable v-diasize-browse-number        as integer   no-undo .
      334   define variable v-diasize-need-full-display    as logical   no-undo init false .
      335   define temp-table temp-diasize-handle no-undo
      336     field handle-value  as handle
      337     field save-position as decimal
      338     index xpk is primary unique handle-value
      339     .
      340   define temp-table temp-browse-handle no-undo
      341     field browse-type   as character
      342     field browse-number as integer
      343     field browse-handle as handle
      344     field original-size as decimal
      345     index xpk is primary unique browse-type browse-number
      346     index xie browse-type browse-handle
      347   .
      348   procedure diasize_change-height :
      349     define input  parameter p-change-value  as decimal   no-undo .
      350     define input  parameter p-move-resize   as logical   no-undo .
      351     define variable v-field-group-handle    as handle    no-undo .
      352     define variable v-object-handle         as handle    no-undo .
      353     define variable v-frame-height          as decimal   no-undo .
      354     define variable v-frame-virtual-height  as decimal   no-undo .
      355     define variable v-browse-height         as decimal   no-undo .
      356     define variable v-window-height         as decimal   no-undo .
      357     define variable v-window-virtual-height as decimal   no-undo .
      358     define variable v-change-sign           as integer   no-undo .
      359     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      360     define buffer buf_temp-browse-handle  for temp-browse-handle .
      361     if p-change-value > 0
      362     then do:
      363       if frame Dialog-Frame :height + p-change-value
      364           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      365       then do:
      366         assign
      367           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      368                           - (frame Dialog-Frame :height-chars)
      369         .
      370         if p-change-value <= 0
      371         then do:
      372           run diasize_position-resize-button in this-procedure .
      373           return .
      374         end.
      375       end.
      376     end.
      377     if p-change-value < 0
      378     then do:
      379       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      380       then do:
      381         assign
      382           p-change-value = v-diasize-orig-frame-height
      383                          - (frame Dialog-Frame :height-chars)
      384         .
      385         if p-change-value >= 0
      386         then do:
      387           run diasize_position-resize-button in this-procedure .
      388           return .
      389         end.
      390       end.
      391     end.
      392     if p-change-value >= 0
      393     then do:
      394       assign
      395         v-change-sign = 1
      396       .
      397     end.
      398     else do:
      399       assign
      400         v-change-sign = -1
      401       .
      402     end.
      403     assign
      404       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      405     .
      406     if p-change-value = 0
      407     then do:
      408       run diasize_position-resize-button in this-procedure .
      409       return .
      410     end.
      411     move_block:
      412     do
      413     on error undo move_block, retry move_block
      414     :
      415       if retry
      416       then do:
      417         do
      418         on error undo move_block, leave move_block
      419         :
      420           if p-change-value > 0
      421           then do:
      422             for each buf_temp-diasize-handle
      423             on error undo, next
      424             :
      425               assign
      426                 v-object-handle = buf_temp-diasize-handle.handle-value
      427               .
      428               if v-object-handle <> v-diasize-resize-button
      429               then do:
      430                 assign
      431                   v-object-handle :row = buf_temp-diasize-handle.save-position
      432                 .
      433               end.
      434             end.
      435             assign
      436               v-diasize-browse-handle :height = v-browse-height
      437             .
      438             for each buf_temp-browse-handle
      439               where buf_temp-browse-handle.browse-type = 'height':u
      440             on error undo, next
      441             :
      442               assign
      443                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      444               .
      445             end.
      446             assign
      447               frame Dialog-Frame :height = v-frame-height
      448             .
      449             if frame Dialog-Frame :scrollable = true
      450             then do:
      451               assign
      452                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      453               .
      454             end.
      455             run diasize_position-resize-button in this-procedure .
      456           end.
      457           else do:
      458             if frame Dialog-Frame :scrollable = true
      459             then do:
      460               assign
      461                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      462               .
      463             end.
      464             assign
      465               frame Dialog-Frame :height = v-frame-height
      466             .
      467             assign
      468               v-diasize-browse-handle :height = v-browse-height
      469             .
      470             for each buf_temp-browse-handle
      471               where buf_temp-browse-handle.browse-type = 'height':u
      472             on error undo, next
      473             :
      474               assign
      475                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      476               .
      477             end.
      478             for each buf_temp-diasize-handle
      479             on error undo, next
      480             :
      481               assign
      482                 v-object-handle = buf_temp-diasize-handle.handle-value
      483               .
      484               if v-object-handle <> v-diasize-resize-button
      485               then do:
      486                 assign
      487                   v-object-handle :row = buf_temp-diasize-handle.save-position
      488                 .
      489               end.
      490             end.
      491             run diasize_position-resize-button in this-procedure .
      492           end.
      493           assign
      494             v-diasize-change-size = false
      495           .
      496           leave move_block .
      497         end.
      498       end.
      499       assign
      500         v-diasize-need-full-display = true
      501       .
      502       if v-diasize-change-size = false
      503       then do:
      504         assign
      505           v-diasize-change-size = true
      506         .
      507       end.
      508       else do:
      509         return .
      510       end.
      511       assign
      512         v-frame-height = frame Dialog-Frame :height
      513         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      514         v-browse-height = v-diasize-browse-handle :height
      515       .
      516       for each buf_temp-browse-handle
      517         where buf_temp-browse-handle.browse-type = 'height':u
      518       :
      519         assign
      520           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      521         .
      522       end.
      523       for each buf_temp-diasize-handle
      524       :
      525         delete buf_temp-diasize-handle .
      526       end.
      527       assign
      528         v-field-group-handle = frame Dialog-Frame :first-child
      529       .
      530       do while valid-handle(v-field-group-handle)
      531       :
      532         assign
      533           v-object-handle = v-field-group-handle :first-child
      534         .
      535         do while valid-handle(v-object-handle)
      536         :
      537           if  v-object-handle <> v-diasize-browse-handle :handle
      538           and can-query(v-object-handle, "row")
      539           and can-query(v-object-handle, "height")
      540           and ( v-object-handle :row > v-diasize-browse-handle :row )
      541           then do:
      542             find first buf_temp-browse-handle
      543               where buf_temp-browse-handle.browse-type   = 'height':u
      544                 and buf_temp-browse-handle.browse-handle = v-object-handle
      545               no-error .
      546             if available buf_temp-browse-handle
      547             then do:
      548             end.
      549             else do:
      550               create buf_temp-diasize-handle .
      551               assign
      552                 buf_temp-diasize-handle.handle-value  = v-object-handle
      553                 buf_temp-diasize-handle.save-position = v-object-handle :row
      554               .
      555             end.
      556           end.
      557           assign
      558             v-object-handle = v-object-handle :next-sibling
      559           .
      560         end.
      561         assign
      562           v-field-group-handle = v-field-group-handle :next-sibling
      563         .
      564       end.
      565       do with frame Dialog-Frame
      566       :
      567         hide v-diasize-resize-button .
      568         assign
      569           v-diasize-resize-button :row    = 1
      570           v-diasize-resize-button :column = 1
      571         .
      572       end.
      573       if p-change-value > 0
      574       then do:
      575         if frame Dialog-Frame :scrollable = true
      576         then do:
      577           assign
      578             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      579             no-error .
      580           if error-status :error
      581           or error-status :get-message(1) <> ""
      582           then do:
      583             undo move_block, retry move_block .
      584           end.
      585         end.
      586         assign
      587           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      588           no-error .
      589         if error-status :error
      590         or error-status :get-message(1) <> ""
      591         then do:
      592           undo move_block, retry move_block .
      593         end.
      594         assign
      595           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      596           no-error .
      597         if error-status :error
      598         or error-status :get-message(1) <> ""
      599         then do:
      600           undo move_block, retry move_block .
      601         end.
      602         for each buf_temp-browse-handle
      603           where buf_temp-browse-handle.browse-type = 'height':u
      604         on error undo move_block, retry move_block
      605         :
      606           assign
      607             buf_temp-browse-handle.browse-handle :height
      608               = buf_temp-browse-handle.browse-handle :height + p-change-value
      609             no-error .
      610           if error-status :error
      611           or error-status :get-message(1) <> ""
      612           then do:
      613             undo move_block, retry move_block .
      614           end.
      615         end.
      616         for each buf_temp-diasize-handle
      617         on error undo move_block, retry move_block
      618         :
      619           assign
      620             v-object-handle = buf_temp-diasize-handle.handle-value
      621           .
      622           if v-object-handle <> v-diasize-resize-button
      623           then do:
      624             assign
      625               v-object-handle :row = v-object-handle :row + p-change-value
      626               no-error .
      627             if error-status :error
      628             or error-status :get-message(1) <> ""
      629             then do:
      630               undo move_block, retry move_block .
      631             end.
      632           end.
      633         end.
      634       end.
      635       else do:
      636         for each buf_temp-diasize-handle
      637         on error undo move_block, retry move_block
      638         :
      639           assign
      640             v-object-handle = buf_temp-diasize-handle.handle-value
      641           .
      642           if v-object-handle <> v-diasize-resize-button
      643           then do:
      644             assign
      645               v-object-handle :row = v-object-handle :row + p-change-value
      646               no-error .
      647             if error-status :error
      648             or error-status :get-message(1) <> ""
      649             then do:
      650               undo move_block, retry move_block .
      651             end.
      652           end.
      653         end.
      654         assign
      655           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      656           no-error .
      657         if error-status :error
      658         or error-status :get-message(1) <> ""
      659         then do:
      660           undo move_block, retry move_block .
      661         end.
      662         for each buf_temp-browse-handle
      663           where buf_temp-browse-handle.browse-type = 'height':u
      664         on error undo move_block, retry move_block
      665         :
      666           assign
      667             buf_temp-browse-handle.browse-handle :height
      668               = buf_temp-browse-handle.browse-handle :height + p-change-value
      669             no-error .
      670           if error-status :error
      671           or error-status :get-message(1) <> ""
      672           then do:
      673             undo move_block, retry move_block .
      674           end.
      675         end.
      676         assign
      677           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      678           no-error .
      679         if error-status :error
      680         or error-status :get-message(1) <> ""
      681         then do:
      682           undo move_block, retry move_block .
      683         end.
      684         if frame Dialog-Frame :scrollable = true
      685         then do:
      686           assign
      687             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      688             no-error .
      689           if error-status :error
      690           or error-status :get-message(1) <> ""
      691           then do:
      692             undo move_block, retry move_block .
      693           end.
      694         end.
      695       end.
      696       if p-move-resize = true
      697       then do:
      698         run diasize_position-resize-button in this-procedure .
      699       end.
      700       if v-diasize-wndstore = true
      701       then do:
      702         if connected("ub") = true
      703         then do:
      704           define variable v-cntxt-db-num        as integer   no-undo .
      705           define variable v-cntxt-userid        as character no-undo .
      706           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      707                                             , OUTPUT v-cntxt-userid
      708                                             ) .
      709           run gbl/wndsizew.p
      710             (input  v-cntxt-db-num
      711             ,input  v-cntxt-userid
      712             ,input  v-diasize-proc-name
      713             ,input  'height':u
      714             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      715             ) .
      716         end.
      717       end.
      718     end.
      719     assign
      720       v-diasize-change-size = false
      721     .
      722   end procedure.
      723   procedure diasize_set-height :
      724     define input  parameter p-new-height  as decimal   no-undo .
      725     define input  parameter p-move-resize as logical   no-undo .
      726     do
      727     on error undo, return error return-value
      728     :
      729       run diasize_change-height in this-procedure
      730         (input  (p-new-height - frame Dialog-Frame :height)
      731         ,input  p-move-resize
      732         ) .
      733     end.
      734   end procedure.
      735   procedure diasize_change-width :
      736     define input  parameter p-change-value as decimal   no-undo .
      737     define input  parameter p-move-resize  as logical   no-undo .
      738     define variable v-field-group-handle   as handle    no-undo .
      739     define variable v-object-handle        as handle    no-undo .
      740     define variable v-frame-width          as decimal   no-undo .
      741     define variable v-frame-virtual-width  as decimal   no-undo .
      742     define variable v-browse-width         as decimal   no-undo .
      743     define variable v-window-width         as decimal   no-undo .
      744     define variable v-window-virtual-width as decimal   no-undo .
      745     define variable v-change-sign          as integer   no-undo .
      746     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      747     define buffer buf_temp-browse-handle  for temp-browse-handle .
      748     if p-change-value > 0
      749     then do:
      750       if frame Dialog-Frame :width + p-change-value >
      751           session :width-chars
      752       then do:
      753         assign
      754           p-change-value = session :width-chars - frame Dialog-Frame :width
      755         .
      756         if p-change-value <= 0
      757         then do:
      758           run diasize_position-resize-button in this-procedure .
      759           return .
      760         end.
      761       end.
      762     end.
      763     if p-change-value < 0
      764     then do:
      765       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      766       then do:
      767         assign
      768           p-change-value = v-diasize-orig-frame-width
      769                          - frame Dialog-Frame :width
      770         .
      771         if p-change-value >= 0
      772         then do:
      773           run diasize_position-resize-button in this-procedure .
      774           return .
      775         end.
      776       end.
      777     end.
      778     if p-change-value >= 0
      779     then do:
      780       assign
      781         v-change-sign = 1
      782       .
      783     end.
      784     else do:
      785       assign
      786         v-change-sign = -1
      787       .
      788     end.
      789     assign
      790       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      791     .
      792     if p-change-value = 0
      793     then do:
      794       run diasize_position-resize-button in this-procedure .
      795       return .
      796     end.
      797     move_block:
      798     do
      799     on error undo move_block, leave move_block
      800     :
      801       if retry
      802       then do:
      803         do
      804         on error undo move_block, leave move_block
      805         :
      806           if p-change-value > 0
      807           then do:
      808             for each buf_temp-diasize-handle
      809             on error undo, next
      810             :
      811               assign
      812                 v-object-handle = buf_temp-diasize-handle.handle-value
      813               .
      814               if v-object-handle <> v-diasize-resize-button
      815               then do:
      816                 assign
      817                   v-object-handle :col = buf_temp-diasize-handle.save-position
      818                 .
      819               end.
      820             end.
      821             assign
      822               v-diasize-browse-handle :width = v-browse-width
      823             .
      824             for each buf_temp-browse-handle
      825               where buf_temp-browse-handle.browse-type = 'width':u
      826             on error undo, next
      827             :
      828               assign
      829                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      830               .
      831             end.
      832             assign
      833               frame Dialog-Frame :width = v-frame-width
      834             .
      835             if frame Dialog-Frame :scrollable = true
      836             then do:
      837               assign
      838                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      839               .
      840             end.
      841             run diasize_position-resize-button in this-procedure .
      842           end.
      843           else do:
      844             if frame Dialog-Frame :scrollable = true
      845             then do:
      846               assign
      847                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      848               .
      849             end.
      850             assign
      851               frame Dialog-Frame :width = v-frame-width
      852             .
      853             for each buf_temp-browse-handle
      854               where buf_temp-browse-handle.browse-type = 'width':u
      855             on error undo, next
      856             :
      857               assign
      858                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      859               .
      860             end.
      861             assign
      862               v-diasize-browse-handle :width = v-browse-width
      863             .
      864             for each buf_temp-diasize-handle
      865             on error undo, next
      866             :
      867               assign
      868                 v-object-handle = buf_temp-diasize-handle.handle-value
      869               .
      870               if v-object-handle <> v-diasize-resize-button
      871               then do:
      872                 assign
      873                   v-object-handle :col = buf_temp-diasize-handle.save-position
      874                 .
      875               end.
      876             end.
      877             run diasize_position-resize-button in this-procedure .
      878           end.
      879           assign
      880             v-diasize-change-size = false
      881           .
      882           leave move_block .
      883         end.
      884       end.
      885       assign
      886         v-diasize-need-full-display = true
      887       .
      888       if v-diasize-change-size = false
      889       then do:
      890         assign
      891           v-diasize-change-size = true
      892         .
      893       end.
      894       else do:
      895         return .
      896       end.
      897       assign
      898         v-frame-width = frame Dialog-Frame :width
      899         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      900         v-browse-width = v-diasize-browse-handle :width
      901       .
      902       for each buf_temp-browse-handle
      903         where buf_temp-browse-handle.browse-type = 'width':u
      904       :
      905         assign
      906           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      907         .
      908       end.
      909       for each buf_temp-diasize-handle
      910       :
      911         delete buf_temp-diasize-handle .
      912       end.
      913       assign
      914         v-field-group-handle = frame Dialog-Frame :first-child
      915       .
      916       do while valid-handle(v-field-group-handle)
      917       :
      918         assign
      919           v-object-handle = v-field-group-handle :first-child
      920         .
      921         do while valid-handle(v-object-handle)
      922         :
      923           if  v-object-handle <> v-diasize-browse-handle :handle
      924           and v-object-handle <> v-diasize-resize-button
      925           and can-query(v-object-handle, "row")
      926           and can-query(v-object-handle, "height")
      927           and ( v-object-handle :col + v-object-handle :width
      928                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      929               )
      930           then do:
      931             find first buf_temp-browse-handle
      932               where buf_temp-browse-handle.browse-type   = 'width':u
      933                 and buf_temp-browse-handle.browse-handle = v-object-handle
      934               no-error .
      935             if available buf_temp-browse-handle
      936             then do:
      937             end.
      938             else do:
      939               create buf_temp-diasize-handle .
      940               assign
      941                 buf_temp-diasize-handle.handle-value  = v-object-handle
      942                 buf_temp-diasize-handle.save-position = v-object-handle :col
      943               .
      944             end.
      945           end.
      946           assign
      947             v-object-handle = v-object-handle :next-sibling
      948           .
      949         end.
      950         assign
      951           v-field-group-handle = v-field-group-handle :next-sibling
      952         .
      953       end.
      954       do with frame Dialog-Frame
      955       :
      956         hide v-diasize-resize-button .
      957         v-diasize-resize-button :row = 1.
      958         v-diasize-resize-button :column = 1.
      959       end.
      960       if p-change-value > 0
      961       then do:
      962         if frame Dialog-Frame :scrollable = true
      963         then do:
      964           assign
      965             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      966             no-error .
      967           if error-status :error
      968           or error-status :get-message(1) <> ""
      969           then do:
      970             undo move_block, retry move_block.
      971           end.
      972         end.
      973         assign
      974           frame Dialog-Frame :width = v-frame-width + p-change-value
      975           no-error .
      976         if error-status :error
      977         or error-status :get-message(1) <> ""
      978         then do:
      979           undo move_block, retry move_block.
      980         end.
      981         assign
      982           v-diasize-browse-handle :width = v-browse-width + p-change-value
      983         no-error .
      984         if error-status :error
      985         or error-status :get-message(1) <> ""
      986         then do:
      987           undo move_block, retry move_block.
      988         end.
      989         for each buf_temp-browse-handle
      990           where buf_temp-browse-handle.browse-type = 'width':u
      991         on error undo move_block, retry move_block
      992         :
      993           assign
      994             buf_temp-browse-handle.browse-handle :width
      995               = buf_temp-browse-handle.browse-handle :width + p-change-value
      996             no-error .
      997           if error-status :error
      998           or error-status :get-message(1) <> ""
      999           then do:
     1000             undo move_block, retry move_block .
     1001           end.
     1002         end.
     1003         for each buf_temp-diasize-handle
     1004         on error undo move_block, retry move_block
     1005         :
     1006           assign
     1007             v-object-handle = buf_temp-diasize-handle.handle-value
     1008           .
     1009           if v-object-handle <> v-diasize-resize-button
     1010           then do:
     1011             assign
     1012               v-object-handle :col = v-object-handle :col + p-change-value
     1013               no-error .
     1014             if error-status :error
     1015             or error-status :get-message(1) <> ""
     1016             then do:
     1017               undo move_block, retry move_block .
     1018             end.
     1019           end.
     1020         end.
     1021       end.
     1022       else do:
     1023         for each buf_temp-diasize-handle
     1024         on error undo move_block, retry move_block
     1025         :
     1026           assign
     1027             v-object-handle = buf_temp-diasize-handle.handle-value
     1028           .
     1029           if v-object-handle <> v-diasize-resize-button
     1030           then do:
     1031             assign
     1032               v-object-handle :col = v-object-handle :col + p-change-value
     1033               no-error .
     1034             if error-status :error
     1035             or error-status :get-message(1) <> ""
     1036             then do:
     1037               undo move_block, retry move_block .
     1038             end.
     1039           end.
     1040         end.
     1041         for each buf_temp-browse-handle
     1042           where buf_temp-browse-handle.browse-type = 'width':u
     1043         on error undo move_block, retry move_block
     1044         :
     1045           assign
     1046             buf_temp-browse-handle.browse-handle :width
     1047               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1048             no-error .
     1049           if error-status :error
     1050           or error-status :get-message(1) <> ""
     1051           then do:
     1052             undo move_block, retry move_block .
     1053           end.
     1054         end.
     1055         assign
     1056           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1057           no-error .
     1058         if error-status :error
     1059         or error-status :get-message(1) <> ""
     1060         then do:
     1061           undo move_block, retry move_block.
     1062         end.
     1063         assign
     1064           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1065         no-error .
     1066         if error-status :error
     1067         or error-status :get-message(1) <> ""
     1068         then do:
     1069           undo move_block, retry move_block.
     1070         end.
     1071         if frame Dialog-Frame :scrollable = true
     1072         then do:
     1073           assign
     1074             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1075           no-error .
     1076           if error-status :error
     1077           or error-status :get-message(1) <> ""
     1078           then do:
     1079             undo move_block, retry move_block.
     1080           end.
     1081         end.
     1082       end.
     1083       if p-move-resize
     1084       then do:
     1085         run diasize_position-resize-button in this-procedure .
     1086       end.
     1087       if v-diasize-wndstore = true
     1088       then do:
     1089         if connected("ub") = true
     1090         then do:
     1091           define variable v-cntxt-db-num        as integer   no-undo .
     1092           define variable v-cntxt-userid        as character no-undo .
     1093           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1094                                             , OUTPUT v-cntxt-userid
     1095                                             ) .
     1096           run gbl/wndsizew.p
     1097             (input  v-cntxt-db-num
     1098             ,input  v-cntxt-userid
     1099             ,input  v-diasize-proc-name
     1100             ,input  'width':u
     1101             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1102             ) .
     1103         end.
     1104       end.
     1105     end.
     1106     assign
     1107       v-diasize-change-size = false
     1108     .
     1109   end procedure.
     1110   procedure diasize_set-width :
     1111     define input  parameter p-new-width  as decimal   no-undo .
     1112     define input  parameter p-move-resize as logical   no-undo .
     1113     do
     1114     on error undo, return error return-value
     1115     :
     1116       run diasize_change-width in this-procedure
     1117         (input  (p-new-width - frame Dialog-Frame :width)
     1118         ,input  p-move-resize
     1119         ) .
     1120     end.
     1121   end procedure.
     1122   procedure diasize_position-resize-button :
     1123     do with frame Dialog-Frame
     1124     :
     1125       hide v-diasize-resize-button .
     1126       assign
     1127         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1128                     - 1
     1129                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1130         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1131                     - 1
     1132                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1133       .
     1134       view v-diasize-resize-button .
     1135     end.
     1136   end procedure.
     1137   on alt-right anywhere
     1138   do:
     1139     run diasize_change-width in this-procedure
     1140       (input 1
     1141       ,input true
     1142       ) .
     1143     return no-apply .
     1144   end.
     1145   on alt-left anywhere
     1146   do:
     1147     run diasize_change-width in this-procedure
     1148       (input -1
     1149       ,input true
     1150       ) .
     1151     return no-apply .
     1152   end.
     1153   on alt-down anywhere
     1154   do:
     1155     run diasize_change-height in this-procedure
     1156       (input 1
     1157       ,input true
     1158       ) .
     1159     return no-apply .
     1160   end.
     1161   on alt-up anywhere
     1162   do:
     1163     run diasize_change-height in this-procedure
     1164       (input -1
     1165       ,input true
     1166       ) .
     1167     return no-apply .
     1168   end.
     1169   on alt-enter of frame Dialog-Frame
     1170   do:
     1171     run diasize_maximize in this-procedure
     1172       (input  ?
     1173       ).
     1174     return no-apply .
     1175   end.
     1176   procedure diasize_end-move :
     1177     do
     1178     on error undo, return error return-value
     1179     :
     1180       define variable v-row-delta as decimal   no-undo .
     1181       define variable v-col-delta as decimal   no-undo .
     1182       define variable v-new-row as decimal   no-undo .
     1183       define variable v-new-col as decimal   no-undo .
     1184       assign
     1185         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1186         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1187       .
     1188       assign
     1189         v-row-delta = v-new-row - frame Dialog-Frame :height
     1190         v-col-delta = v-new-col - frame Dialog-Frame :width
     1191       .
     1192       run diasize_change-height in this-procedure
     1193         (input v-row-delta
     1194         ,input true
     1195         ) .
     1196       run diasize_change-width in this-procedure
     1197         (input v-col-delta
     1198         ,input true
     1199         ) .
     1200     end.
     1201   end procedure.
     1202   procedure diasize_maximize :
     1203     define input  parameter p-action as logical   no-undo .
     1204     do
     1205     on error undo, return error return-value
     1206     :
     1207       if p-action = ?
     1208       then do:
     1209         if v-diasize-need-maximize = true
     1210         then do:
     1211           assign
     1212             p-action = true
     1213           .
     1214         end.
     1215         else do:
     1216           assign
     1217             p-action = false
     1218           .
     1219         end.
     1220       end.
     1221       if p-action = true
     1222       then do:
     1223         run diasize_change-height in this-procedure
     1224           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1225               - frame Dialog-Frame :height-chars
     1226           ,input true
     1227           ) .
     1228         run diasize_change-width in this-procedure
     1229           (input session :width-chars
     1230               - frame Dialog-Frame :width-chars
     1231           ,input true
     1232           ) .
     1233         assign
     1234           v-diasize-need-maximize = false
     1235         .
     1236       end.
     1237       else do:
     1238         run diasize_change-width in this-procedure
     1239           (input v-diasize-orig-frame-width
     1240               - frame Dialog-Frame :width-chars
     1241           ,input true
     1242           ) .
     1243         run diasize_change-height in this-procedure
     1244           (input v-diasize-orig-frame-height
     1245               - frame Dialog-Frame :height-chars
     1246           ,input true
     1247           ) .
     1248         assign
     1249           v-diasize-need-maximize = true
     1250         .
     1251       end.
     1252     end.
     1253   end procedure.
     1254   procedure diasize_restore-orig-size :
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258       assign
     1259         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1260         v-diasize-current-frame-height = frame Dialog-Frame :height
     1261       .
     1262       run diasize_set-height in this-procedure
     1263         (input  v-diasize-orig-frame-height
     1264         ,input  true
     1265         ) .
     1266       run diasize_set-width in this-procedure
     1267         (input  v-diasize-orig-frame-width
     1268         ,input  true
     1269         ) .
     1270     end.
     1271   end procedure.
     1272   procedure diasize_restore-current-size :
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       run diasize_set-height in this-procedure
     1277         (input  v-diasize-current-frame-height
     1278         ,input  true
     1279         ) .
     1280       run diasize_set-width in this-procedure
     1281         (input  v-diasize-current-frame-width
     1282         ,input  true
     1283         ) .
     1284     end.
     1285   end procedure.
     1286   procedure diasize_set-browse-handle :
     1287     define input  parameter p-browse-handle as handle   no-undo .
     1288     define buffer buf_temp-browse-handle for temp-browse-handle .
     1289     do
     1290     on error undo, return error return-value
     1291     :
     1292       assign
     1293         v-diasize-browse-handle = p-browse-handle
     1294       .
     1295       for each buf_temp-browse-handle
     1296       on error undo, return error return-value
     1297       :
     1298         delete buf_temp-browse-handle .
     1299       end.
     1300     end.
     1301   end procedure.
     1302   procedure diasize_add_browse :
     1303     define input  parameter p-browse-type   as character no-undo .
     1304     define input  parameter p-browse-handle as handle    no-undo .
     1305     define buffer buf_temp-browse-handle for temp-browse-handle .
     1306     do
     1307     on error undo, return error return-value
     1308     :
     1309       assign
     1310         v-diasize-browse-number = v-diasize-browse-number + 1
     1311       .
     1312       create buf_temp-browse-handle .
     1313       assign
     1314         buf_temp-browse-handle.browse-type   = p-browse-type
     1315         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1316         buf_temp-browse-handle.browse-handle = p-browse-handle
     1317       .
     1318     end.
     1319   end procedure.
     1320   procedure diasize_init :
     1321     define variable v-default-value    as logical   no-undo .
     1322     define variable v-restore-saved    as logical   no-undo .
     1323     define variable v-resize-value-str as character no-undo .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       do with frame Dialog-Frame
     1328       :
     1329         assign
     1330           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1331           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1332           v-diasize-browse-handle     = browse BROWSE-1 :handle
     1333         .
     1334         create button v-diasize-resize-button
     1335         assign
     1336           parent        = frame Dialog-Frame :first-child
     1337           label         = "s"
     1338           height-pixels = 16
     1339           width-pixels  = 16
     1340           visible       = true
     1341           sensitive     = true
     1342           movable       = true
     1343           triggers:
     1344             on end-move persistent run diasize_end-move in this-procedure .
     1345           end triggers.
     1346         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1347         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1348         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1349         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1350         assign
     1351           v-diasize-wndmax = false
     1352         .
     1353         if connected("ub") = true
     1354         then do:
     1355           define variable v-cntxt-db-num        as integer   no-undo .
     1356           define variable v-cntxt-userid        as character no-undo .
     1357           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1358                                             , OUTPUT v-cntxt-userid
     1359                                             ) .
     1360           run gbl/wndpar_r.p
     1361             (input  v-cntxt-db-num
     1362             ,input  v-cntxt-userid
     1363             ,input  'wndmax':U
     1364             ,output v-diasize-wndmax
     1365             ,output v-default-value
     1366             ) .
     1367         end.
     1368         assign
     1369           v-diasize-wndstore = false
     1370         .
     1371         if connected("ub") = true
     1372         then do:
     1373           run gbl/wndpar_r.p
     1374             (input  v-cntxt-db-num
     1375             ,input  v-cntxt-userid
     1376             ,input  'wndstore':U
     1377             ,output v-diasize-wndstore
     1378             ,output v-default-value
     1379             ) .
     1380         end.
     1381         assign
     1382           v-diasize-proc-name = entry(1, program-name(2), '.')
     1383         .
     1384         if v-diasize-wndstore = true
     1385         then do:
     1386           assign
     1387             v-restore-saved = false
     1388           .
     1389           if connected("ub") = true
     1390           then do:
     1391             run gbl/wndsizer.p
     1392               (input  v-cntxt-db-num
     1393               ,input  v-cntxt-userid
     1394               ,input  v-diasize-proc-name
     1395               ,input  'height':u
     1396               ,output v-resize-value-str
     1397               ) .
     1398             if v-resize-value-str <> '':U
     1399             then do:
     1400               run diasize_change-height in this-procedure
     1401                 (input  integer(v-resize-value-str)
     1402                 ,input  true
     1403                 ) .
     1404               assign
     1405                 v-restore-saved = true
     1406               .
     1407             end.
     1408           end.
     1409           if connected("ub") = true
     1410           then do:
     1411             run gbl/wndsizer.p
     1412               (input  v-cntxt-db-num
     1413               ,input  v-cntxt-userid
     1414               ,input  v-diasize-proc-name
     1415               ,input  'width':u
     1416               ,output v-resize-value-str
     1417               ) .
     1418             if v-resize-value-str <> '':U
     1419             then do:
     1420               run diasize_change-width in this-procedure
     1421                 (input  integer(v-resize-value-str)
     1422                 ,input  true
     1423                 ) .
     1424               assign
     1425                 v-restore-saved = true
     1426               .
     1427             end.
     1428           end.
     1429           if v-restore-saved <> true
     1430           then do:
     1431             if v-diasize-wndmax = true
     1432             then do:
     1433               run diasize_maximize in this-procedure
     1434                 (input  true
     1435                 ) .
     1436             end.
     1437           end.
     1438         end.
     1439         else do:
     1440           if v-diasize-wndmax = true
     1441           then do:
     1442             run diasize_maximize in this-procedure
     1443               (input  true
     1444               ) .
     1445           end.
     1446         end.
     1447       end.
     1448     end.
     1449   end procedure.
     1450   procedure diasize_need-full-display :
     1451     define output parameter p-need-full-display as logical   no-undo .
     1452     do
     1453     on error undo, return error return-value
     1454     :
     1455       assign
     1456         p-need-full-display = v-diasize-need-full-display
     1457       .
     1458       assign
     1459         v-diasize-need-full-display = false
     1460       .
     1461     end.
     1462   end procedure.
     1463   procedure get-context :
     1464      define output parameter p-db-num as integer          no-undo.
     1465      define output parameter p-user-id as character        no-undo.
     1466      define variable v-login               as character    no-undo.
     1467      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1468      define buffer buf_user-login  for ub.user-login .
     1469      do
     1470      on error undo, return error
     1471      :
     1472            FIND FIRST buf_sys-ctrl no-lock.
     1473            ASSIGN
     1474               v-login = USERID("ub")
     1475               p-db-num = buf_sys-ctrl.db-num
     1476            .
     1477            FIND FIRST buf_user-login
     1478                 WHERE buf_user-login.db-num = p-db-num
     1479                   AND buf_user-login.user-login = v-login
     1480                 no-lock
     1481                 no-error
     1482                 .
     1483            IF AVAILABLE buf_user-login
     1484            THEN DO:
     1485               assign
     1486                  p-user-id = buf_user-login.user-id
     1487               .
     1488            END.
     1489      end.
     1490   end procedure.
     1491       run diasize_init in this-procedure .
     1492   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493   do:
     1494     BROWSE-1 :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1495   end.
     1496   run fill-temp-table in this-procedure .
     1497   MAIN-BLOCK:
     1498   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1499      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1500     RUN enable_UI.
     1501     WAIT-FOR GO OF FRAME Dialog-Frame.
     1502   END.
     1503   RUN disable_UI.
     1504   PROCEDURE disable_UI :
     1505     HIDE FRAME Dialog-Frame.
     1506   END PROCEDURE.
     1507   PROCEDURE enable_UI :
     1508     ENABLE b-exit b-sel b-help BROWSE-1
     1509         WITH FRAME Dialog-Frame.
     1510     VIEW FRAME Dialog-Frame.
     1511     OPEN QUERY BROWSE-1 FOR EACH temp-prt-root .
     1512   END PROCEDURE.
     1513   PROCEDURE fill-temp-table :
     1514     define buffer buf_gds-prt for ub.gds-prt .
     1515     define buffer buf_temp-prt-root for temp-prt-root .
     1516     do
     1517     on error undo, return error return-value
     1518     :
     1519       define variable v-prt-level as integer   no-undo .
     1520       for each buf_gds-prt no-lock
     1521         where buf_gds-prt.root = true
     1522       on error undo, return error
     1523       :
     1524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtlevel in g#library
     1525     (input  buf_gds-prt.node-code
     1526     ,output v-prt-level
     1527     )  .
     1528         if v-prt-level > 1
     1529         then do:
     1530           create buf_temp-prt-root .
     1531           assign
     1532             buf_temp-prt-root.node-code = buf_gds-prt.node-code
     1533             buf_temp-prt-root.prt-level = v-prt-level - 1
     1534             buf_temp-prt-root.node-name = buf_gds-prt.node-name
     1535           .
     1536         end.
     1537       end.
     1538     end.
     1539   END PROCEDURE.
