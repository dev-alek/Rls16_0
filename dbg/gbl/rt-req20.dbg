      297   define variable v-doc-line-01   as character no-undo .
      298   define variable v-artic-01      as character no-undo .
      299   define variable v-name-01       as character no-undo .
      300   define variable v-doc-qnty-01   as character no-undo .
      301   define variable v-gds-code-01   as character no-undo .
      302   define variable v-unit-base-01  as character no-undo .
      303   define variable v-doc-line-02   as character no-undo .
