      491                                 + chr(10) .
      492     put stream sout unformatted substitute('unit_base_05:&1',  rtencode(v-unit-base-05) )
      493                                 + chr(10) .
      494     output stream sout close .
      495     os-delete value(p-directory-out + '/':u + p-file-name) .
      496     os-rename value(p-directory-out + '/':u + v-temp-file-name)
      497               value(p-directory-out + '/':u + p-file-name)
      498               .
      499   end.
      500   procedure check-data :
      501     define output parameter p-status        as character no-undo .
      502     define output parameter p-message       as character no-undo .
      503     define output parameter p-doc-line-01   as character no-undo .
      504     define output parameter p-artic-01      as character no-undo .
      505     define output parameter p-name-01       as character no-undo .
      506     define output parameter p-doc-qnty-01   as character no-undo .
      507     define output parameter p-gds-code-01   as character no-undo .
      508     define output parameter p-unit-base-01  as character no-undo .
      509     define output parameter p-doc-line-02   as character no-undo .
      510     define output parameter p-artic-02      as character no-undo .
      511     define output parameter p-name-02       as character no-undo .
      512     define output parameter p-doc-qnty-02   as character no-undo .
      513     define output parameter p-gds-code-02   as character no-undo .
      514     define output parameter p-unit-base-02  as character no-undo .
      515     define output parameter p-doc-line-03   as character no-undo .
      516     define output parameter p-artic-03      as character no-undo .
      517     define output parameter p-name-03       as character no-undo .
      518     define output parameter p-doc-qnty-03   as character no-undo .
      519     define output parameter p-gds-code-03   as character no-undo .
      520     define output parameter p-unit-base-03  as character no-undo .
      521     define output parameter p-doc-line-04   as character no-undo .
      522     define output parameter p-artic-04      as character no-undo .
      523     define output parameter p-name-04       as character no-undo .
      524     define output parameter p-doc-qnty-04   as character no-undo .
      525     define output parameter p-gds-code-04   as character no-undo .
      526     define output parameter p-unit-base-04  as character no-undo .
      527     define output parameter p-doc-line-05   as character no-undo .
      528     define output parameter p-artic-05      as character no-undo .
      529     define output parameter p-name-05       as character no-undo .
      530     define output parameter p-doc-qnty-05   as character no-undo .
      531     define output parameter p-gds-code-05   as character no-undo .
      532     define output parameter p-unit-base-05  as character no-undo .
      533     define output parameter p-doc-line-06   as character no-undo .
      534     define output parameter p-artic-06      as character no-undo .
      535     define output parameter p-name-06       as character no-undo .
      536     define output parameter p-doc-qnty-06   as character no-undo .
      537     define output parameter p-gds-code-06   as character no-undo .
      538     define output parameter p-unit-base-06  as character no-undo .
      539     define buffer buf_clients            for ub.clients .
      540     define buffer buf_sysconf            for ub.sysconf .
      541     define buffer buf_sys-ctrl           for ub.sys-ctrl .
      542     define buffer buf_user-login         for ub.user-login .
      543     define buffer buf_goods              for ub.goods.
      544     define buffer buf_trn-doc            for ub.trn-doc.
      545     define buffer buf_doc-line           for ub.doc-line.
      546     define buffer buf_ord-doc            for ub.ord-doc .
      547     define buffer buf_ord-doc-rcv        for ub.ord-doc-rcv.
      548     define buffer buf_ord-line-rcv       for ub.ord-line-rcv.
      549     define buffer buf_temp-doc-line-list for temp-doc-line-list.
      550     define query q_temp-doc-line-list for buf_temp-doc-line-list .
      551     define variable v-forward-direction as logical   no-undo .
      552     define variable v-i                 as integer   no-undo .
      553   do
      554   on error undo, return error return-value
      555   :
      556       find first buf_sys-ctrl no-lock .
      557       find first buf_user-login no-lock
      558         where buf_user-login.db-num = buf_sys-ctrl.db-num
      559           and buf_user-login.status_    = 0
      560           and buf_user-login.user-login = p-user-login
      561         no-error .
      562       if not available buf_user-login
      563       then do:
      564         assign
      565           p-status        = '1':u
      566           p-message = substitute("Неизвестный пользователь &1"
      567                                       ,p-user-login
      568                                       )
      569         .
      570         return .
      571       end.
      572       define variable v-obj-code      as integer   no-undo .
      573       define variable v-data-valid    as logical   no-undo .
      574       define variable v-error-message as character no-undo .
      575       if p-obj-code = ""
      576       then do:
      577         assign
      578           p-status        = '1':u
      579           p-message = "Не задан код объекта"
      580         .
      581         return .
      582       end.
      583       run integerm in this-procedure
      584         (input  p-obj-code
      585         ,input  false
      586         ,input  false
      587         ,output v-obj-code
      588         ,output v-data-valid
      589         ,output v-error-message
      590         ) .
      591       if v-data-valid <> true
      592       then do:
      593         assign
      594           p-status        = '1':u
      595           p-message = substitute("Ошибка преобразования кода объекта &1. &2"
      596                                       ,p-obj-code
      597                                       ,v-error-message
      598                                       )
      599         .
      600         return .
      601       end.
      602       find first buf_clients no-lock
      603         where buf_clients.obj-type = p-obj-type
      604           and buf_clients.obj-code = v-obj-code
      605         no-error .
      606       if not available buf_clients
      607       then do:
      608         assign
      609           p-status        = '1':u
      610           p-message = substitute("Не найден объект &1 &2"
      611                                       ,p-obj-type
      612                                       ,v-obj-code
      613                                       )
      614         .
      615         return .
      616       end.
      617       if  p-obj-type <> 'маг':U
      618       and p-obj-type <> 'скл':U
      619       then do:
      620         assign
      621           p-status        = '1':u
      622           p-message = substitute("Неправильный тип объекта &1 &2"
      623                                       ,p-obj-type
      624                                       ,v-obj-code
      625                                       )
      626         .
      627         return .
      628       end.
      629       define variable v-host-code as integer   no-undo .
      630       run integerm in this-procedure
      631         (input  p-host-code
      632         ,input  false
      633         ,input  false
      634         ,output v-host-code
      635         ,output v-data-valid
      636         ,output v-error-message
      637         ) .
      638       if v-data-valid <> true
      639       then do:
      640         assign
      641           p-status        = '1':u
      642           p-message = substitute("Ошибка преобразования кода фирмы &1. &2"
      643                                       ,p-host-code
      644                                       ,v-error-message
      645                                       )
      646         .
      647         return .
      648       end.
      649       define variable v-obj-host-code as integer   no-undo .
      650   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      652     (input  buf_clients.obj-type
      653     ,input  buf_clients.obj-code
      654     ,output v-obj-host-code
      655     )  .
      656       if v-host-code <> v-obj-host-code
      657       then do:
      658         assign
      659           p-status        = '1':u
      660           p-message = substitute("Заданный код фирмы &1 отличается от кода фирмы &2 объекта &3 &4."
      661                                       ,p-host-code
      662                                       ,v-obj-host-code
      663                                       ,buf_clients.obj-type
      664                                       ,buf_clients.obj-code
      665                                       )
      666         .
      667         return .
      668       end.
      669       define variable v-object-available as logical   no-undo .
      670   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      672     (input  buf_sys-ctrl.db-num
      673     ,input  0
      674     ,input  buf_user-login.user-id
      675     ,input  buf_clients.obj-type
      676     ,input  buf_clients.obj-code
      677     ,output v-object-available
      678     )  .
      679       if v-object-available <> true
      680       then do:
      681         assign
      682           p-status        = '1':u
      683           p-message = substitute("Пользователю не доступен объект &1 &2"
      684                                       ,buf_clients.obj-type
      685                                       ,buf_clients.obj-code
      686                                       )
      687         .
      688         return .
      689       end.
      690       define variable v-valid-act   as logical   no-undo .
      691   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   do:
      693     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      694       (input  buf_sys-ctrl.db-num
      695       ,input  buf_user-login.user-id
      696       ,input  0
      697       ,input  'actn_rt-edit-doc_work':U
      698       ,input  'object':U
      699       ,input  v-host-code
      700       ,input  buf_clients.obj-type
      701       ,input  buf_clients.obj-code
      702       ,input  0
      703       ,input  0
      704       ,input  0
      705       ,input  false
      706       ,output v-valid-act
      707       )  .
      708   end.
      709       if v-valid-act <> true
      710       then do:
      711         assign
      712           p-status        = '1'
      713           p-message = substitute( "&1" , return-value )
      714         .
      715         return .
      716       end.
      717       define variable v-cli-code as integer   no-undo .
      718       if lookup(p-direction, '0,1,2,3') = 0
      719       then do:
      720         assign
      721           p-status        = '1':u
      722           p-message = substitute("Неизвестная команда позиционирования &1"
      723                                       ,p-direction
      724                                       )
      725         .
      726         return .
      727       end.
      728       define variable v-gds-code-first  as integer   no-undo .
      729       if p-doc-line-first = ""
      730       then do:
      731         assign
      732           v-gds-code-first = -1
      733         .
      734       end.
      735       else do:
      736         run integerm in this-procedure
      737           (input  p-doc-line-first
      738           ,input  false
      739           ,input  false
      740           ,output v-gds-code-first
      741           ,output v-data-valid
      742           ,output v-error-message
      743           ) .
      744         if v-data-valid <> true then do:
      745           assign
      746             p-status        = '1':u
      747             p-message = substitute("Ошибка преобразования кода первой строки списка - &1. &2"
      748                                         ,p-doc-line-first
      749                                         ,v-error-message
      750                                         )
      751           .
      752           return .
      753         end.
      754       end.
      755       define variable v-gds-code-last   as integer   no-undo .
      756       if p-doc-line-last = ""
      757       then do:
      758         assign
      759           v-gds-code-last = -1
      760         .
      761       end.
      762       else do:
      763         run integerm in this-procedure
      764           (input  p-doc-line-last
      765           ,input  false
      766           ,input  false
      767           ,output v-gds-code-last
      768           ,output v-data-valid
      769           ,output v-error-message
      770           ) .
      771         if v-data-valid <> true then do:
      772           assign
      773             p-status        = '1':u
      774             p-message = substitute("Ошибка преобразования кода последней строки списка - &1. &2"
      775                                         ,p-doc-line-last
      776                                         ,v-error-message
      777                                         )
      778           .
      779           return .
      780         end.
      781       end.
      782       define variable v-search-doc-code as character no-undo .
      783       run rt-cnvdc_decode in this-procedure ( input p-doc-code
      784                                             , output v-search-doc-code
      785                                             ) .
      786       case p-doc-type
      787       :
      788         when 'ПТ':u
      789         then do:
      790           find first buf_ord-doc-rcv no-lock
      791             where buf_ord-doc-rcv.rcv-code = v-search-doc-code
      792           no-error .
      793           if not available buf_ord-doc-rcv
      794           then do:
      795             assign
      796               p-status        = '1':u
      797               p-message = substitute("Не найден документ поставки &1"
      798                                           ,v-search-doc-code
      799                                           )
      800             .
      801             return .
      802           end.
      803           find first buf_ord-doc no-lock
      804             where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code
      805           no-error .
      806           if not available buf_ord-doc then do:
      807             assign
      808               p-status        = '1':u
      809               p-message = substitute("Не найден документ заказа &1 на основании документа поставки &2"
      810                                           ,buf_ord-doc-rcv.doc-code
      811                                           ,v-search-doc-code
      812                                           )
      813             .
      814             return .
      815           end.
      816           define buffer reposition_ord-line-rcv for ub.ord-line-rcv.
      817           define query q_ord-line-rcv for buf_ord-line-rcv scrolling .
      818           open query q_ord-line-rcv
      819             for each buf_ord-line-rcv no-lock
      820               where buf_ord-line-rcv.doc-code = buf_ord-doc-rcv.doc-code
      821                 and buf_ord-line-rcv.rcv-code = buf_ord-doc-rcv.rcv-code
      822             by buf_ord-line-rcv.line-num
      823           .
      824           case p-direction :
      825             when '0':U then do:
      826               assign
      827                 v-forward-direction = true
      828               .
      829               get first q_ord-line-rcv .
      830             end.
      831             when '1':U then do:
      832               assign
      833                 v-forward-direction = false
      834               .
      835               find first buf_goods no-lock
      836                 where buf_goods.gds-code = v-gds-code-first
      837               no-error .
      838               if available buf_goods
      839               then do:
      840                 find first reposition_ord-line-rcv no-lock
      841                   where reposition_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      842                     and reposition_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
      843                     and reposition_ord-line-rcv.artic     = buf_goods.artic
      844                     and reposition_ord-line-rcv.prod-type = buf_goods.prod-type
      845                     and reposition_ord-line-rcv.prod-code = buf_goods.prod-code
      846                 no-error.
      847                 if available reposition_ord-line-rcv
      848                 then do:
      849                   reposition q_ord-line-rcv to rowid rowid(reposition_ord-line-rcv) no-error .
      850                   get next q_ord-line-rcv.
      851                   if not available buf_ord-line-rcv
      852                   then do:
      853                     get first q_ord-line-rcv .
      854                   end.
      855                   else do:
      856                     get prev q_ord-line-rcv.
      857                     if not available buf_ord-line-rcv
      858                     then do:
      859                       assign
      860                         v-forward-direction = true
      861                       .
      862                       get first q_ord-line-rcv .
      863                     end.
      864                   end.
      865                 end.
      866               end.
      867             end.
      868             when '2':U then do:
      869               assign
      870                 v-forward-direction = true
      871               .
      872               find first buf_goods no-lock
      873                 where buf_goods.gds-code = v-gds-code-last
      874               no-error .
      875               if available buf_goods
      876               then do:
      877                 find first reposition_ord-line-rcv no-lock
      878                   where reposition_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      879                     and reposition_ord-line-rcv.rcv-code  = buf_ord-doc-rcv.rcv-code
      880                     and reposition_ord-line-rcv.artic     = buf_goods.artic
      881                     and reposition_ord-line-rcv.prod-type = buf_goods.prod-type
      882                     and reposition_ord-line-rcv.prod-code = buf_goods.prod-code
      883                 no-error.
      884                 if available reposition_ord-line-rcv
      885                 then do:
      886                   reposition q_ord-line-rcv to rowid rowid(reposition_ord-line-rcv) no-error .
      887                   get next q_ord-line-rcv .
      888                   if not available buf_ord-line-rcv
      889                   then do:
      890                     get first q_ord-line-rcv .
      891                   end.
      892                   else do:
      893                     get next q_ord-line-rcv .
      894                     if not available buf_ord-line-rcv
      895                     then do:
      896                       assign
      897                         v-forward-direction = false
      898                       .
      899                       get last q_ord-line-rcv .
      900                     end.
      901                   end.
      902                 end.
      903               end.
      904             end.
      905             when '3':U then do:
      906               assign
      907                 v-forward-direction = false
      908               .
      909               get last q_ord-line-rcv .
      910             end.
      911             otherwise do:
      912               assign
      913                 p-status        = '1':u
      914                 p-message = substitute("Неизвестное значение переменной p-direction &1"
      915                                             ,p-direction
      916                                             )
      917               .
      918               return .
      919             end.
      920           end case.
      921           if not available buf_ord-line-rcv
      922           then do:
      923             assign
      924               p-status  = '1':u
      925               p-message = substitute( "В документе &1 нет ни одной строки." , v-search-doc-code )
      926             .
      927             return .
      928           end.
      929           for each buf_temp-doc-line-list
      930           on error undo, return error return-value
      931           :
      932             delete buf_temp-doc-line-list .
      933           end.
      934           _scan_cycle:
      935           do v-i = 1 to 5
      936           :
      937             if available buf_ord-line-rcv
      938             then do:
      939               find first buf_goods no-lock
      940                 where buf_goods.artic     = buf_ord-line-rcv.artic
      941                   and buf_goods.prod-type = buf_ord-line-rcv.prod-type
      942                   and buf_goods.prod-code = buf_ord-line-rcv.prod-code
      943               no-error .
      944               if not available buf_goods
      945               then do:
      946                 assign
      947                   p-status        = '1':u
      948                   p-message = substitute( 'Не найден товар &1 &2 &3 по строке в документе поставки &4':u
      949                                               ,buf_ord-line-rcv.artic
      950                                               ,buf_ord-line-rcv.prod-type
      951                                               ,buf_ord-line-rcv.prod-code
      952                                               ,buf_ord-line-rcv.rcv-code
      953                                               )
      954                 .
      955                 return .
      956               end.
      957               create buf_temp-doc-line-list .
      958               assign
      959                 buf_temp-doc-line-list.temp-order = ( if v-forward-direction = true then v-i else - v-i )
      960                 buf_temp-doc-line-list.doc-line   = string( buf_ord-line-rcv.line-num )
      961                 buf_temp-doc-line-list.artic      = buf_ord-line-rcv.artic
      962                 buf_temp-doc-line-list.name       = buf_goods.gds-name
      963                 buf_temp-doc-line-list.doc-qnty   = string( buf_ord-line-rcv.qnty )
      964                 buf_temp-doc-line-list.gds-code   = string( buf_goods.gds-code    )
      965                 buf_temp-doc-line-list.unit-base  = buf_goods.unit-base
      966               .
      967             end.
      968             if v-forward-direction = true
      969             then do:
      970               get next q_ord-line-rcv .
      971             end.
      972             else do:
      973               get prev q_ord-line-rcv .
      974             end.
      975             if not available buf_ord-line-rcv
      976             then do:
      977               leave _scan_cycle .
      978             end.
      979           end.
      980         end.
      981         when 'ПН':u or
      982         when 'РН':u
      983         then do:
      984           find first buf_trn-doc no-lock
      985             where buf_trn-doc.doc-code = v-search-doc-code
      986           no-error .
      987           if not available buf_trn-doc
      988           then do:
      989             assign
      990               p-status        = '1':u
      991               p-message = substitute("Не найден документ &1"
      992                                           ,v-search-doc-code
      993                                           )
      994             .
      995             return .
      996           end.
      997           define buffer reposition_doc-line for ub.doc-line.
      998           define query q_buf_doc-line for buf_doc-line scrolling .
      999           open query q_buf_doc-line
     1000             for each buf_doc-line no-lock
     1001               where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1002             by buf_doc-line.line-num
     1003           .
     1004           case p-direction :
     1005             when '0':U then do:
     1006               assign
     1007                 v-forward-direction = true
     1008               .
     1009               get first q_buf_doc-line .
     1010             end.
     1011             when '1':U then do:
     1012               assign
     1013                 v-forward-direction = false
     1014               .
     1015               find first buf_goods no-lock
     1016                 where buf_goods.gds-code = v-gds-code-first
     1017               no-error .
     1018               if available buf_goods
     1019               then do:
     1020                 find first reposition_doc-line no-lock
     1021                   where reposition_doc-line.doc-code  = buf_trn-doc.doc-code
     1022                     and reposition_doc-line.artic     = buf_goods.artic
     1023                     and reposition_doc-line.prod-type = buf_goods.prod-type
     1024                     and reposition_doc-line.prod-code = buf_goods.prod-code
     1025                 no-error .
     1026                 if available reposition_doc-line
     1027                 then do:
     1028                   reposition q_buf_doc-line to rowid rowid(reposition_doc-line) no-error .
     1029                   get next q_buf_doc-line .
     1030                   if not available buf_doc-line
     1031                   then do:
     1032                     get first q_buf_doc-line .
     1033                   end.
     1034                   else do:
     1035                     get prev q_buf_doc-line .
     1036                     if not available buf_doc-line
     1037                     then do:
     1038                       assign
     1039                         v-forward-direction = true
     1040                       .
     1041                       get first q_buf_doc-line .
     1042                     end.
     1043                   end.
     1044                 end.
     1045               end.
     1046             end.
     1047             when '2':U then do:
     1048               assign
     1049                 v-forward-direction = true
     1050               .
     1051               find first buf_goods no-lock
     1052                 where buf_goods.gds-code = v-gds-code-last
     1053               no-error .
     1054               if available buf_goods
     1055               then do:
     1056                 find first reposition_doc-line no-lock
     1057                   where reposition_doc-line.doc-code  = buf_trn-doc.doc-code
     1058                     and reposition_doc-line.artic     = buf_goods.artic
     1059                     and reposition_doc-line.prod-type = buf_goods.prod-type
     1060                     and reposition_doc-line.prod-code = buf_goods.prod-code
     1061                 no-error .
     1062                 if available reposition_doc-line
     1063                 then do:
     1064                   reposition q_buf_doc-line to rowid rowid(reposition_doc-line) no-error .
     1065                   get next q_buf_doc-line .
     1066                   if not available buf_doc-line
     1067                   then do:
     1068                     get first q_buf_doc-line .
     1069                   end.
     1070                   else do:
     1071                     get next q_buf_doc-line .
     1072                     if not available buf_doc-line
     1073                     then do:
     1074                       assign
     1075                         v-forward-direction = false
     1076                       .
     1077                       get last q_buf_doc-line .
     1078                     end.
     1079                   end.
     1080                 end.
     1081               end.
     1082             end.
     1083             when '3':U then do:
     1084               assign
     1085                 v-forward-direction = false
     1086               .
     1087               get last q_buf_doc-line .
     1088             end.
     1089             otherwise do:
     1090               assign
     1091                 p-status        = '1':u
     1092                 p-message = substitute("Неизвестное значение переменной p-direction &1"
     1093                                             ,p-direction
     1094                                             )
     1095               .
     1096               return .
     1097             end.
     1098           end case.
     1099           if not available buf_doc-line
     1100           then do:
     1101             assign
     1102               p-status  = '1':u
     1103               p-message = substitute( "В документе &1 нет ни одной строки." , v-search-doc-code )
     1104             .
