     1316                 buf_temp-doc-line-list.doc-line   = string( buf_ord-line.line-num )
     1317                 buf_temp-doc-line-list.artic      = buf_ord-line.artic
     1318                 buf_temp-doc-line-list.name       = buf_goods.gds-name
