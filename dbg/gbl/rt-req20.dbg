     1194                 where buf_goods.gds-code = v-gds-code-first
     1195               no-error .
     1196               if available buf_goods
     1197               then do:
     1198                 find first reposition_ord-line no-lock
     1199                   where reposition_ord-line.doc-code  = buf_ord-doc.doc-code
     1200                     and reposition_ord-line.artic     = buf_goods.artic
     1201                     and reposition_ord-line.prod-type = buf_goods.prod-type
     1202                     and reposition_ord-line.prod-code = buf_goods.prod-code
     1203                 no-error.
     1204                 if available reposition_ord-line
     1205                 then do:
     1206                   reposition q_ord-line to rowid rowid(reposition_ord-line) no-error .
     1207                   get next q_ord-line.
     1208                   if not available buf_ord-line
     1209                   then do:
     1210                     get first q_ord-line.
     1211                   end.
