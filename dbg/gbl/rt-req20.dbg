      335     if p-session-valid = true then do:
      336       run check-data in this-procedure ( output v-status
      337                                        , output v-message
      338                                        , output v-doc-line-01
      339                                        , output v-artic-01
      340                                        , output v-name-01
      341                                        , output v-doc-qnty-01
      342                                        , output v-gds-code-01
      343                                        , output v-unit-base-01
      344                                        , output v-doc-line-02
      345                                        , output v-artic-02
      346                                        , output v-name-02
      347                                        , output v-doc-qnty-02
      348                                        , output v-gds-code-02
      349                                        , output v-unit-base-02
      350                                        , output v-doc-line-03
      351                                        , output v-artic-03
      352                                        , output v-name-03
      353                                        , output v-doc-qnty-03
      354                                        , output v-gds-code-03
      355                                        , output v-unit-base-03
      356                                        , output v-doc-line-04
      357                                        , output v-artic-04
      358                                        , output v-name-04
