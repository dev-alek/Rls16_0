        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle  no-undo .
        3   define input parameter p-directory-out  as character      no-undo .
        4   define input parameter p-file-name      as character      no-undo .
        5   define input parameter p-session-valid  as logical        no-undo .
        6   define input parameter p-error-message  as character      no-undo .
        7   define input parameter p-user-login     as character      no-undo .
        8   define input parameter p-obj-type       as character      no-undo .
        9   define input parameter p-obj-code       as character      no-undo .
       10   define input parameter p-host-code      as character      no-undo .
       11   define input parameter p-cli-type       as character      no-undo .
       12   define input parameter p-cli-code       as character      no-undo .
       13   define input parameter p-doc-code       as character      no-undo .
       14   define input parameter p-doc-type       as character      no-undo .
       15   define input parameter p-doc-status     as character      no-undo .
       16   define input parameter p-doc-line-first as character      no-undo .
       17   define input parameter p-doc-line-last  as character      no-undo .
       18   define input parameter p-direction      as character      no-undo .
       19   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       20   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       21   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile: rt-req20.p $":U .
       23   define variable vss-archive     as character no-undo init "$Archive: gbl/rt-req20.p $":U .
       24   define variable vss-description as character no-undo init "Обрабока запроса радиотерминала 20. Приемка товара. Список строк документа поставки".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure integerm :
       85     define input  parameter p-string      as character no-undo .
       86     define input  parameter p-allow-sign  as logical   no-undo .
       87     define input  parameter p-allow-comma as logical   no-undo .
       88     define output parameter p-value       as integer   no-undo .
       89     define output parameter p-data-valid  as logical   no-undo .
       90     define output parameter p-message     as character no-undo .
       91     define variable v-replace-string as character no-undo .
       92     do
       93     on error undo, return error return-value
       94     :
       95       if p-string = ?
       96       then do:
       97         assign
       98           p-value      = ?
       99           p-data-valid = false
      100           p-message    = "Ошибка задания входных параметров. Не задана строка для преобразования"
      101         .
      102         return .
      103       end.
      104       if p-string = ""
      105       then do:
      106         assign
      107           p-value      = ?
      108           p-data-valid = false
      109           p-message    = "Ошибка задания входных параметров. Задана пустая строка для преобразования"
      110         .
      111         return .
      112       end.
      113       assign
      114         p-value = integer(p-string) no-error
      115       .
      116       if error-status :error = true
      117       then do:
      118         assign
      119           p-value      = ?
      120           p-data-valid = false
      121           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'"
      122                                    ,p-string
      123                                    )
      124         .
      125         return .
      126       end.
      127       if index(p-string, ' ':u) > 0
      128       then do:
      129         assign
      130           p-value      = ?
      131           p-data-valid = false
      132           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      133                                    + "Строка содержит символы пробела"
      134                                    ,p-string
      135                                    )
      136         .
      137         return .
      138       end.
      139       assign
      140         v-replace-string = p-string
      141         v-replace-string = replace(v-replace-string, '0':u, '9':u)
      142         v-replace-string = replace(v-replace-string, '1':u, '9':u)
      143         v-replace-string = replace(v-replace-string, '2':u, '9':u)
      144         v-replace-string = replace(v-replace-string, '3':u, '9':u)
      145         v-replace-string = replace(v-replace-string, '4':u, '9':u)
      146         v-replace-string = replace(v-replace-string, '5':u, '9':u)
      147         v-replace-string = replace(v-replace-string, '6':u, '9':u)
      148         v-replace-string = replace(v-replace-string, '7':u, '9':u)
      149         v-replace-string = replace(v-replace-string, '8':u, '9':u)
      150       .
      151       if p-allow-sign = true
      152       then do:
      153         if index('+-':u, substring(v-replace-string, 1, 1)) > 0
      154         then do:
      155           assign
      156             v-replace-string = substring(v-replace-string, 2)
      157           .
      158         end.
      159       end.
      160       else do:
      161         if substring(v-replace-string, 1, 1) = '+':u
      162         then do:
      163           assign
      164             p-value      = ?
      165             p-data-valid = false
      166             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      167                                     + "Задан параметр недопустимости знака челого числа. "
      168                                     + "Строка содержит символ плюс. "
      169                                     ,p-string
      170                                     )
      171           .
      172           return .
      173         end.
      174         if substring(v-replace-string, 1, 1) = '-':u
      175         then do:
      176           assign
      177             p-value      = ?
      178             p-data-valid = false
      179             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      180                                     + "Задан параметр недопустимости знака челого числа. "
      181                                     + "Строка содержит символ минус. "
      182                                     ,p-string
      183                                     )
      184           .
      185           return .
      186         end.
      187       end.
      188       if p-allow-comma = true
      189       then do:
      190         assign
      191           v-replace-string = replace(v-replace-string, ',', '')
      192         .
      193       end.
      194       else do:
      195         if index(v-replace-string, ',') > 0
      196         then do:
      197           assign
      198             p-value      = ?
      199             p-data-valid = false
      200             p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      201                                     + "Задан параметр недопустимости знака разделителя тысяч."
      202                                     + "Строка содержит знак разделителя тысяч. "
      203                                     ,p-string
      204                                     )
      205           .
      206           return .
      207         end.
      208       end.
      209       if index(p-string, '.') > 0
      210       then do:
      211         assign
      212           p-value      = ?
      213           p-data-valid = false
      214           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      215                                    + "Строка содержит знак десятичной точки"
      216                                    ,p-string
      217                                    )
      218         .
      219         return .
      220       end.
      221       if v-replace-string <> fill('9', length(v-replace-string))
      222       then do:
      223         assign
      224           p-value      = ?
      225           p-data-valid = false
      226           p-message    = substitute("Ошибка при преобразовании к целому числу строки '&1'. "
      227                                    + "Встречены символы, недопустимые для целого числа '&2'"
      228                                    ,p-string
      229                                    ,replace(v-replace-string, '9', '')
      230                                    )
      231         .
      232         return .
      233       end.
      234       assign
      235         p-data-valid = true
      236         p-message    = ""
      237       .
      238     end.
      239   end procedure.
      240   define new global shared variable g#library  as handle no-undo .
      241   define new global shared variable g#library2 as handle no-undo .
      242   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   function rtencode returns character
      244     ( p-init-string as character
      245     ) :
      246     define variable v-encode-string as character no-undo .
      247     if p-init-string = ?
      248     then do:
      249       assign
      250         v-encode-string = '?':u
      251       .
      252       return v-encode-string .
      253     end.
      254     if p-init-string = '?':u
      255     then do:
      256       assign
      257         v-encode-string = '~~077':u
      258       .
      259       return v-encode-string .
      260     end.
      261     assign
      262       v-encode-string = replace(p-init-string,   '~~':u,      '~~176':u)
      263       v-encode-string = replace(v-encode-string, ':':u,       '~~072':u)
      264       v-encode-string = replace(v-encode-string, chr(10), '~~015':u)
      265     .
      266     return v-encode-string .
      267   end function .
      268   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      269   procedure rt-cnvdc_decode :
      270     define input  parameter p-encoded-str as character no-undo .
      271     define output parameter p-decoded-str as character no-undo .
      272   do
      273   on error undo, return error return-value
      274   :
      275     define variable v-decoded-str as character no-undo .
      276     assign
      277       v-decoded-str = replace(p-encoded-str,  'c':u, 'с':u )
      278       v-decoded-str = replace(v-decoded-str,  'm':u, 'м':u )
      279       p-decoded-str = v-decoded-str
      280     .
      281   end.
      282   end procedure.
      283   define stream sout.
      284   define temp-table temp-doc-line-list no-undo
      285     field temp-order as integer
