     1398           p-doc-qnty-03   = buf_temp-doc-line-list.doc-qnty
     1399           p-gds-code-03   = buf_temp-doc-line-list.gds-code
     1400           p-unit-base-03  = buf_temp-doc-line-list.unit-base
