     1169                                     ,v-search-doc-code
     1170                                     )
     1171             .
     1172             return .
     1173           end.
     1174           define buffer reposition_ord-line for ub.ord-line.
     1175           define buffer buf_ord-line        for ub.ord-line.
     1176           define query q_ord-line for buf_ord-line scrolling .
     1177           open query q_ord-line
     1178             for each buf_ord-line no-lock
     1179               where buf_ord-line.doc-code = buf_ord-doc.doc-code
     1180             by buf_ord-line.line-num
     1181           .
