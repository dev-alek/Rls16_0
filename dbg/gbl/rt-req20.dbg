     1154             then do:
     1155               leave _scan_cycle .
     1156             end.
     1157           end.
     1158         end.
     1159         when 'ОР':u
     1160         then do:
     1161           find first buf_ord-doc no-lock
     1162             where buf_ord-doc.doc-code = v-search-doc-code
     1163           no-error .
