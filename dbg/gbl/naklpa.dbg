      639   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      640   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      641   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   on help of frame Dialog-Frame
      643   do:
      644     run gbl/app_help.p
      645       (input this-procedure :file-name
      646       ,input ''
      647       ,input ?
      648       ) no-error.
      649     if error-status :error then do:
      650       message
      651         "Ошибка при вызове помощи"
      652         error-status :get-message(1)
      653         view-as alert-box .
      654     end.
      655   end.
      656   run minbtn-set in this-procedure .
      657   on choose of b-help in frame Dialog-Frame
      658   do:
      659     apply "help":u to frame Dialog-Frame .
      660   end.
      661   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   procedure minbtn-set :
      663       do
      664           on error undo, return error return-value
      665           :
      666           define variable ii              as integer       no-undo .
      667           define variable fh              as widget-handle no-undo .
      668           define variable hh              as widget-handle no-undo .
      669           define variable v-h             as handle        extent 4 no-undo .
      670           define variable v-name-button   as character     no-undo .
      671           define variable v-help-old-x    as decimal       no-undo .
      672           define variable v-help-old-y    as decimal       no-undo .
      673           define variable v-help-old-size as decimal       no-undo .
      674           define variable v-frame-width   as decimal       no-undo .
      675           define variable jj              as integer       no-undo .
      676           do
      677               on error undo, return error
      678               :
      679               assign
      680                   v-frame-width = frame Dialog-Frame:width - 0.3
      681                   fh            = frame Dialog-Frame:first-child
      682                   hh            = fh:first-child
      683                   ii            = 1
      684                   .
      685               do while valid-handle(hh):
      686                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      687                   do:
      688                       case lc(hh:name) :
      689                           when "b-help" then
      690                               do:
      691                                   hh:load-image-up("cmp/b-help.bmp":u) .
      692                                   hh:load-image-down("cmp/b-help.bmp":u) .
      693                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      694                                   hh:TOOLTIP = "Помощь" .
      695                                   v-help-old-x = hh:column .
      696                                   v-help-old-y = hh:row    .
      697                                   v-help-old-size = hh:width .
      698                                   hh:width-chars = 2.5 .
      699                               end.
      700                           when "b-print" then
      701                               do:
      702                                   hh:load-image("cmp/b-print.bmp":u) .
      703                                   hh:TOOLTIP = "Печать" .
      704                                   v-h[ii] = hh:handle .
      705                                   ii = ii + 1 .
      706                                   hh:width-chars = 3 .
      707                               end.
      708                           when "b-history" or
      709                           when "b-hist" then
      710                               do:
      711                                   hh:load-image("cmp/b-hist.bmp":u) .
      712                                   hh:TOOLTIP = "История" .
      713                                   v-h[ii] = hh:handle .
      714                                   ii = ii + 1 .
      715                                   hh:width-chars = 3 .
      716                               end.
      717                           when "b-sch" then
      718                               do:
      719                                   hh:load-image("cmp/b-sch.bmp":u) .
      720                                   hh:TOOLTIP = "Установка Фильтра" .
      721                                   v-h[ii] = hh:handle .
      722                                   ii = ii + 1 .
      723                                   hh:width-chars = 3 .
      724                               end.
      725                           when "b-hist-user" then
      726                               do:
      727                                   hh:load-image("cmp/b-hist.bmp":u) .
      728                                   hh:TOOLTIP = "История пользователя" .
      729                                   ii = ii + 1 .
      730                               end.
      731                       end case.
      732                   end.
      733                   hh = hh:next-sibling.
      734               end.
      735               b-help:column = v-frame-width - b-help:width-chars.
      736               jj = 0.
      737               repeat ii = 4 to 1 by -1 :
      738                   if valid-handle (v-h[ii] ) then
      739                   do:
      740                       jj  = jj + 1 .
      741                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      742                       v-h[ii]:row    = v-help-old-y .
      743                   end.
      744               end.
      745           end.
      746       end.
      747   end procedure.
      748   MAIN-BLOCK:
      749   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      750      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      751   if p-obj-type <> "" then
      752      frame Dialog-Frame:title = frame Dialog-Frame:title + (if p-obj-type = 'орг':U then " фирма" else " маг") + string(p-obj-code) .
      753   define variable loc#log as logical   no-undo .
      754   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      755   do:
      756     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      757       (input  g#db-num
      758       ,input  g#userid
      759       ,input  0
      760       ,input  'actn_global-trn_lookup':U
      761       ,input  'global':U
      762       ,input  0
      763       ,input  '':U
      764       ,input  0
      765       ,input  0
      766       ,input  0
      767       ,input  0
      768       ,input  true
      769       ,output loc#log
      770       )  .
      771   end.
      772     if loc#log <> yes then do: return error. end.
      773       run init-tt.
      774       run enable_UI.
      775       run init-proc.
      776     WAIT-FOR GO OF FRAME Dialog-Frame.
      777   END.
      778   run disable_UI.
      779   PROCEDURE disable_UI :
      780     HIDE FRAME Dialog-Frame.
      781   END PROCEDURE.
      782   PROCEDURE enable_UI :
      783     DISPLAY contr-in-income-NP contr-in-income-CPT contr-in-expense-NP
      784             contr-in-expense-CPT contr-qnty-spec contr-recount
      785             v-contr-in-income-NP v-contr-in-income-CPT v-contr-in-expense-NP
      786             v-contr-in-expense-CPT v-contr-qnty-spec v-contr-recount
      787         WITH FRAME Dialog-Frame.
      788     ENABLE B-exit B-quit B-Help I-contr-in-income-NP I-contr-in-expense-NP
      789            I-contr-qnty-spec I-contr-in-expense-CPT I-contr-in-income-CPT
      790            I-contr-recount B-2 contr-in-income-NP B-3 contr-in-income-CPT B-4
      791            contr-in-expense-NP B-5 contr-in-expense-CPT B-6 contr-qnty-spec B-7
      792            contr-recount v-contr-in-income-NP v-contr-in-income-CPT
      793            v-contr-in-expense-NP v-contr-in-expense-CPT v-contr-qnty-spec
      794            v-contr-recount
      795         WITH FRAME Dialog-Frame.
      796     VIEW FRAME Dialog-Frame.
      797   END PROCEDURE.
      798   PROCEDURE fill-widgets :
      799   define variable v-value-character as character no-undo .
      800   define variable v-value-date as date no-undo .
      801   define variable v-value-decimal as decimal no-undo .
      802   define variable v-value-integer as INTEGER no-undo .
      803   define variable v-value-logical AS LOGICAL no-undo .
      804   define variable v-param-type as character no-undo .
      805   define variable v-param-value as character no-undo .
      806   for each thbjattr_thbj-attr:
      807     delete thbjattr_thbj-attr.
      808   end.
      809   for each thbjattr_thbj-attr-trn:
      810     delete thbjattr_thbj-attr-trn.
      811   end.
      812   for each temp-thbj-attr:
      813     delete temp-thbj-attr.
      814   end.
      815   run adm/shattri.p (
      816       input "init":U
      817     , input p-obj-type
      818     , input p-obj-code
      819     , input 'contr-in':U
      820     , input "":U
      821     , output v-value-character
      822     , output v-value-date
      823     , output v-value-decimal
      824     , output v-value-integer
      825     , output v-value-logical
      826     , output v-param-type
      827     , input-output TABLE-HANDLE v-tth-trn
      828     ) no-error .
      829   if error-status:error then do:
      830     message
      831     "Не удалось получить начальные значения настроек" skip
      832     error-status:get-message(1) return-value
      833     view-as alert-box error .
      834     undo, return error .
      835   end.
      836   FOR EACH thbjattr_thbj-attr-trn  where
      837            thbjattr_thbj-attr-trn.obj-type =  p-obj-type and
      838            thbjattr_thbj-attr-trn.obj-code =  p-obj-code
      839   :
      840     IF thbjattr_thbj-attr-trn.prop-code = 'contr-in-income-NP':U THEN DO:
      841        contr-in-income-NP = thbjattr_thbj-attr-trn.property-value-logical.
      842        contr-in-income-NP:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      843        display contr-in-income-NP with frame Dialog-Frame .
      844     end.
      845     IF thbjattr_thbj-attr-trn.prop-code = 'contr-in-income':U THEN DO:
      846        contr-in-income-CPT = thbjattr_thbj-attr-trn.property-value-logical.
      847        contr-in-income-CPT:PRIVATE-DATA IN FRAME Dialog-Frame  = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      848        display contr-in-income-CPT with frame Dialog-Frame .
      849     END.
      850     IF thbjattr_thbj-attr-trn.prop-code = 'contr-in-expense-NP':U THEN DO:
      851        contr-in-expense-NP = thbjattr_thbj-attr-trn.property-value-logical.
      852        contr-in-expense-NP:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      853        display contr-in-expense-NP with frame Dialog-Frame .
      854     END.
      855     IF thbjattr_thbj-attr-trn.prop-code = 'contr-in-expense':U THEN DO:
      856        contr-in-expense-CPT = thbjattr_thbj-attr-trn.property-value-logical.
      857        contr-in-expense-CPT:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      858        display contr-in-expense-CPT with frame Dialog-Frame .
      859     END.
      860     IF thbjattr_thbj-attr-trn.prop-code = 'contr-qnty-spec':U THEN DO:
      861        contr-qnty-spec = thbjattr_thbj-attr-trn.property-value-logical.
      862        contr-qnty-spec:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      863        display contr-qnty-spec with frame Dialog-Frame .
      864     END.
      865     IF thbjattr_thbj-attr-trn.prop-code = 'contr-recount':U THEN DO:
      866        contr-recount = thbjattr_thbj-attr-trn.property-value-logical.
      867        contr-recount:private-data = "recid2=" + string(recid(thbjattr_thbj-attr-trn)).
      868        display contr-recount with frame Dialog-Frame .
      869     END.
      870     create temp-thbj-attr.
      871     buffer-copy thbjattr_thbj-attr-trn to temp-thbj-attr.
      872   END.
