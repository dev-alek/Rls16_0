      146      run thbjattr_code_reg in this-procedure (
      147                                               p-upper-code,
      148                                               p-code,
      149                                               output p-label,
      150                                               output p-user-can-edit,
      151                                               output p-output-display,
      152                                               output p-other,
      153                                               output p-prop-list,
      154                                               output p-prop-type-list,
      155                                               output p-prop-label-list,
      156                                               output p-global,
      157                                               output p-host,
