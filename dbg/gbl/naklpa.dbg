      925   I-contr-qnty-spec:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
      926   run thbjattr_tooltip in this-procedure (
      927                input   'contr-in':U
      928               ,input  "contr-recount"
      929               ,output v-tooltip
      930               ,output v-label
      931               ,output v-tooltip-code
      932               ) no-error .
      933   v-contr-recount:screen-value = entry(2,v-label,":") .
      934   v-contr-recount:MOVE-TO-Top( ).
      935   I-contr-recount:private-data = REPLACE ( v-tooltip-code , '`' , ',' ) .
      936   END PROCEDURE.
      937   PROCEDURE init-proc :
      938   define variable v-i as integer   no-undo .
      939   define variable v-value-character as character no-undo .
      940   define variable v-value-date as date no-undo .
      941   define variable v-value-decimal as decimal no-undo .
      942   define variable v-value-integer as INTEGER no-undo .
      943   define variable v-value-logical AS LOGICAL no-undo .
      944   define variable v-type as character no-undo .
      945   define variable v-value as character no-undo .
      946   define variable v-found as decimal   no-undo .
      947     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      948       find first ord_thbj-attr exclusive-lock where
      949                 ord_thbj-attr.obj-type = p-obj-type
      950           and   ord_thbj-attr.obj-code = p-obj-code
      951           and   ord_thbj-attr.upper-prop-code = 'contr-in':U
      952           and   ord_thbj-attr.prop-code = '':u no-wait no-error.
      953        if locked ord_thbj-attr then do:
      954           message
      955           vss-workfile vss-revision vss-description skip
      956           'contr-in':U skip
      957           "Запись Глобальных ПАРАМЕТРОВ  занята"
      958           view-as alert-box error .
      959           undo, return error.
      960         end.
      961     end.
      962     else do:
      963       find first ord_thbj-attr no-lock where
      964             ord_thbj-attr.obj-type = p-obj-type
      965       and   ord_thbj-attr.obj-code = p-obj-code
      966       and   ord_thbj-attr.upper-prop-code = 'contr-in':U
      967       and   ord_thbj-attr.prop-code = '':u no-error.
      968     end.
      969     if not available ord_thbj-attr then do:
      970       assign
      971         v-to-create-trn  = true
      972         .
      973       message
      974       substitute ("Внимание!!!&1Параметра &1 НЕТ в БД!&2Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      975                   'contr-in':U,
      976                   chr(10))
      977                    view-as alert-box warning.
      978     end.
      979     run fill-widgets in this-procedure no-error.
      980     if error-status:error then undo, return error.
      981     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      982        disable
      983           contr-in-income-CPT
      984           contr-in-income-NP
      985           contr-in-expense-CPT
      986           contr-in-expense-NP
      987           contr-qnty-spec
      988           contr-recount
      989           with frame Dialog-Frame.
      990        B-exit:label = "Вы&ход"  .
      991        hide B-quit in frame Dialog-Frame .
      992     END.
      993   end procedure.
      994   PROCEDURE init-tt :
      995   END PROCEDURE.
      996   PROCEDURE save-proc :
      997   define variable v-value-character as character no-undo .
      998   define variable v-value-date as date no-undo .
      999   define variable v-value-decimal as decimal no-undo .
     1000   define variable v-value-integer as INTEGER no-undo .
     1001   define variable v-value-logical AS LOGICAL no-undo .
     1002   define variable v-sale-add as character no-undo .
     1003   define variable v-trf-type like ub.clients.obj-type no-undo .
     1004   define variable v-trf-code like ub.clients.obj-code no-undo .
     1005   define variable v-param-type as character no-undo .
     1006   define variable wh as widget-handle no-undo .
     1007   define variable fh as widget-handle no-undo .
     1008   define variable v-same as logical no-undo .
     1009   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1010   define variable loc#log as logical   no-undo .
     1011   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   do:
     1013     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1014       (input  g#db-num
     1015       ,input  g#userid
     1016       ,input  0
     1017       ,input  'actn_global-trn_update':U
     1018       ,input  'global':U
     1019       ,input  0
     1020       ,input  '':U
     1021       ,input  0
     1022       ,input  0
     1023       ,input  0
     1024       ,input  0
     1025       ,input  true
     1026       ,output loc#log
     1027       )  .
     1028   end.
     1029     if loc#log <> yes then do: return error. end.
     1030   ASSIGN
     1031       contr-in-income-CPT FRAME Dialog-Frame
     1032       contr-in-income-NP FRAME Dialog-Frame
     1033       contr-in-expense-CPT FRAME Dialog-Frame
     1034       contr-in-expense-NP FRAME Dialog-Frame
     1035       contr-qnty-spec
     1036       contr-recount
     1037       .
     1038   assign
     1039     fh = frame Dialog-Frame:first-child
     1040     wh = fh:first-child
     1041     .
     1042   do while valid-handle(wh):
     1043     if wh:private-data begins "recid2=" then do:
     1044       find first thbjattr_thbj-attr-trn where
     1045                 recid(thbjattr_thbj-attr-trn) = integer(entry(2, wh:private-data, '=')).
     1046       assign
     1047       buffer thbjattr_thbj-attr-trn:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1048              thbjattr_thbj-attr-trn.obj-type = p-obj-type.
     1049              thbjattr_thbj-attr-trn.obj-code = p-obj-code.
     1050     end.
     1051     wh = wh:next-sibling.
     1052   end.
     1053   v-same = yes.
     1054   for each thbjattr_thbj-attr-trn,
     1055       first temp-thbj-attr where
     1056             temp-thbj-attr.obj-type = thbjattr_thbj-attr-trn.obj-type
     1057         and temp-thbj-attr.obj-code = thbjattr_thbj-attr-trn.obj-code
     1058         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-trn.upper-prop-code
     1059         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-trn.prop-code:
     1060      buffer-compare
     1061      thbjattr_thbj-attr-trn
     1062      to temp-thbj-attr
     1063      save result in v-same.
     1064      if not v-same then leave.
     1065   end.
     1066   v-same = no.
     1067   IF v-same  and not v-to-create THEN RETURN.
     1068   do TRANSACTION
     1069   on error undo, return error return-value
     1070   :
     1071     run thbjattr_set-section in this-procedure (
     1072           input p-obj-type
     1073         , input p-obj-code
     1074         , input 'contr-in':U
     1075         , input table thbjattr_thbj-attr-trn
     1076     ) no-error.
     1077     if error-status:error then do:
     1078       message error-status:get-message(1)  skip
     1079       return-value
     1080       view-as alert-box.
     1081       undo, return error.
     1082     end.
     1083   end.
     1084   END PROCEDURE.
