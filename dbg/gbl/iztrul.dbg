      125   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      126   procedure thbjattr_code :
      127      define input  parameter p-upper-code     as character no-undo .
      128      define input  parameter p-code           as character no-undo .
      129      define output parameter p-label          as character no-undo .
      130      define output parameter p-user-can-edit  as logical   no-undo .
      131      define output parameter p-output-display as logical   no-undo .
      132      define output parameter p-other          as character no-undo .
      133      define output parameter p-prop-list      as character no-undo .
      134      define output parameter p-prop-type-list as character no-undo .
      135      define output parameter p-prop-label-list as character no-undo .
      136      define output parameter p-global          as logical no-undo .
      137      define output parameter p-host           as logical no-undo .
      138      define output parameter p-shop           as logical no-undo .
      139      define output parameter p-store          as logical no-undo .
      140      define output parameter p-db             as logical no-undo .
      141      define variable p-region as logical no-undo.
      142      run thbjattr_code_reg in this-procedure (
      143                                               p-upper-code,
      144                                               p-code,
      145                                               output p-label,
      146                                               output p-user-can-edit,
      147                                               output p-output-display,
      148                                               output p-other,
      149                                               output p-prop-list,
      150                                               output p-prop-type-list,
      151                                               output p-prop-label-list,
      152                                               output p-global,
      153                                               output p-host,
      154                                               output p-shop,
      155                                               output p-store,
      156                                               output p-db,
      157                                               output p-region
      158                                               ).
      159   end procedure.
      160   procedure thbjattr_code_reg :
      161   define input  parameter p-upper-code     as character no-undo .
      162   define input  parameter p-code           as character no-undo .
      163   define output parameter p-label          as character no-undo .
      164   define output parameter p-user-can-edit  as logical   no-undo .
      165   define output parameter p-output-display as logical   no-undo .
      166   define output parameter p-other          as character no-undo .
      167   define output parameter p-prop-list      as character no-undo .
      168   define output parameter p-prop-type-list as character no-undo .
      169   define output parameter p-prop-label-list as character no-undo .
      170   define output parameter p-global          as logical no-undo .
      171   define output parameter p-host           as logical no-undo .
      172   define output parameter p-shop           as logical no-undo .
      173   define output parameter p-store          as logical no-undo .
      174   define output parameter p-db             as logical no-undo .
      175   define output parameter p-region         as logical no-undo .
      176   do
      177   on error undo, return error return-value
      178   :
      179       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      180       (input  p-upper-code
      181       ,input  p-code
      182       ,output p-label
      183       ,output p-user-can-edit
      184       ,output p-output-display
      185       ,output p-other
      186       ,output p-prop-list
      187       ,output p-prop-type-list
      188       ,output p-prop-label-list
      189       ,output p-global
      190       ,output p-host
      191       ,output p-shop
      192       ,output p-store
      193       ,output p-db
      194       ,output p-region
      195       ) no-error .
      196     if error-status :error
      197     then do:
      198       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      199     end.
      200   end.
      201   end procedure.
