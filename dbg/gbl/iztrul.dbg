      412   define input  parameter  parparentproc as handle no-undo .
      413   define temp-table tt-izt no-undo
      414       field nn              as INTEGER
      415       field izt-event-name  as character
      416       field izt-event-code  as character
      417       FIELD izd-new         AS LOGICAL
      418       FIELD izd-com         AS LOGICAL
      419       FIELD izd-del         AS LOGICAL
      420       FIELD izd-spec        AS LOGICAL
      421       FIELD izd-empty       AS LOGICAL
      422   index pi nn
      423   index by1 izt-event-name
      424   index by2 izt-event-code
      425   .
      426   DEFINE BUTTON B-def
      427        LABEL "По умолчанию"
      428        SIZE 17 BY 1 TOOLTIP "Вернуть расстановку по умолчанию"
      429        BGCOLOR 8 .
      430   DEFINE BUTTON B-exit AUTO-GO
      431        LABEL "В&вод"
      432        SIZE 10 BY 1
      433        BGCOLOR 8 .
      434   DEFINE BUTTON B-Help
      435        LABEL "&Help"
      436        SIZE 5 BY 1
      437        BGCOLOR 8 .
      438   DEFINE BUTTON B-quit AUTO-END-KEY
      439        LABEL "Отмена"
      440        SIZE 10 BY 1
      441        BGCOLOR 8 .
      442   DEFINE RECTANGLE RECT-1
      443        EDGE-PIXELS 0
      444        SIZE 97 BY 1
      445        BGCOLOR 3 .
      446   DEFINE QUERY BROWSE-2 FOR
      447   tt-izt.
      448   DEFINE BROWSE BROWSE-2
      449     QUERY BROWSE-2 DISPLAY
      450         tt-izt.izt-event-name    FORMAT "X(56)" COLUMN-LABEL "Событие"
      451   tt-izt.izd-new          COLUMN-LABEL "Новый" VIEW-AS TOGGLE-BOX
      452   tt-izt.izd-com          COLUMN-LABEL "Основная" VIEW-AS TOGGLE-BOX
      453   tt-izt.izd-del          COLUMN-LABEL "На вывод" VIEW-AS TOGGLE-BOX
      454   tt-izt.izd-spec         COLUMN-LABEL "Нештатный" VIEW-AS TOGGLE-BOX
      455   tt-izt.izd-empty        COLUMN-LABEL "Пусто"  VIEW-AS TOGGLE-BOX
      456       ENABLE
      457       tt-izt.izd-new
      458       tt-izt.izd-com
      459       tt-izt.izd-del
      460       tt-izt.izd-spec
      461       tt-izt.izd-empty
      462       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 19 FIT-LAST-COLUMN.
      463   DEFINE FRAME wind1
      464        B-exit AT ROW 1 COL 1
      465        B-quit AT ROW 1 COL 11
      466        B-def AT ROW 1 COL 21 WIDGET-ID 6
      467        B-Help AT ROW 1 COL 93.5
      468        BROWSE-2 AT ROW 3 COL 1.5 WIDGET-ID 200
      469        "Действия с товаром разрешены" VIEW-AS TEXT
      470             SIZE 29 BY .67 AT ROW 2.21 COL 36.63 WIDGET-ID 2
      471             BGCOLOR 3 FGCOLOR 15
      472        RECT-1 AT ROW 2 COL 1.5 WIDGET-ID 4
      473        SPACE(0.37) SKIP(19.20)
      474       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      475            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      476            TITLE "Правила работы ИЖТ"
      477            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      478   ASSIGN
      479          FRAME wind1:SCROLLABLE       = FALSE
      480          FRAME wind1:HIDDEN           = TRUE.
      481   ASSIGN
      482          BROWSE-2:NUM-LOCKED-COLUMNS IN FRAME wind1     = 1.
      483   ON WINDOW-CLOSE OF FRAME wind1
      484   DO:
      485     APPLY "END-ERROR":U TO SELF.
      486   END.
      487   ON CHOOSE OF B-def IN FRAME wind1
      488   DO:
      489     RUN def-proc.
      490   END.
      491   ON CHOOSE OF B-exit IN FRAME wind1
      492   DO:
      493     RUN save-proc.
      494   END.
      495   ON CHOOSE OF B-Help IN FRAME wind1
      496   OR HELP OF FRAME wind1
      497   DO:
      498   END.
      499   ON ITERATION-CHANGED OF BROWSE-2 IN FRAME wind1
      500   DO:
      501    run rrr .
      502   END.
      503   ON ROW-DISPLAY OF BROWSE-2 IN FRAME wind1
      504   DO:
      505     if tt-izt.izt-event-code = 'scu-grp-matr':U    or
      506        tt-izt.izt-event-code = 'scu-grp-specif':U  then do:
      507         tt-izt.izd-new        :bgcolor in browse BROWSE-2   = 8  .
      508         tt-izt.izd-com        :bgcolor in browse BROWSE-2   = 8  .
      509         tt-izt.izd-del        :bgcolor in browse BROWSE-2   = 8  .
      510         tt-izt.izd-spec       :bgcolor in browse BROWSE-2   = 8  .
      511         tt-izt.izd-empty      :bgcolor in browse BROWSE-2   = 8  .
      512     end.
      513     else do:
      514         tt-izt.izd-new        :bgcolor in browse BROWSE-2   = ?  .
      515         tt-izt.izd-com        :bgcolor in browse BROWSE-2   = ?   .
      516         tt-izt.izd-del        :bgcolor in browse BROWSE-2   = ?   .
      517         tt-izt.izd-spec       :bgcolor in browse BROWSE-2   = ?   .
      518         tt-izt.izd-empty      :bgcolor in browse BROWSE-2   = ?   .
      519     end.
      520     if tt-izt.izt-event-code = 'delete-matr-rest':U  or
      521        tt-izt.izt-event-code = 'delete-matr-norest':U then do:
      522         tt-izt.izd-new        :bgcolor in browse BROWSE-2   = 8  .
      523         tt-izt.izd-com        :bgcolor in browse BROWSE-2   = 8  .
      524         tt-izt.izd-spec       :bgcolor in browse BROWSE-2   = 8  .
      525         tt-izt.izd-empty      :bgcolor in browse BROWSE-2   = 8  .
      526     end.
      527     else do:
      528         tt-izt.izd-new        :bgcolor in browse BROWSE-2   = ?  .
      529         tt-izt.izd-com        :bgcolor in browse BROWSE-2   = ?   .
      530         tt-izt.izd-spec       :bgcolor in browse BROWSE-2   = ?   .
      531         tt-izt.izd-empty      :bgcolor in browse BROWSE-2   = ?   .
      532     end.
      533   END.
      534   ON ROW-ENTRY OF BROWSE-2 IN FRAME wind1
      535   DO:
      536   run rrr .
      537   END.
      538   ON VALUE-CHANGED OF BROWSE-2 IN FRAME wind1
      539   DO:
      540            run rrr .
      541     END.
      542   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME wind1:PARENT eq ?
      543   THEN FRAME wind1:PARENT = ACTIVE-WINDOW.
      544   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   on help of frame wind1
      546   do:
      547     run gbl/app_help.p
      548       (input this-procedure :file-name
      549       ,input ''
      550       ,input ?
      551       ) no-error.
      552     if error-status :error then do:
      553       message
      554         "Ошибка при вызове помощи"
      555         error-status :get-message(1)
      556         view-as alert-box .
      557     end.
      558   end.
      559   run minbtn-set in this-procedure .
      560   on choose of b-help in frame wind1
      561   do:
      562     apply "help":u to frame wind1 .
      563   end.
      564   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure minbtn-set :
      566       do
      567           on error undo, return error return-value
      568           :
      569           define variable ii              as integer       no-undo .
      570           define variable fh              as widget-handle no-undo .
      571           define variable hh              as widget-handle no-undo .
      572           define variable v-h             as handle        extent 4 no-undo .
      573           define variable v-name-button   as character     no-undo .
      574           define variable v-help-old-x    as decimal       no-undo .
      575           define variable v-help-old-y    as decimal       no-undo .
      576           define variable v-help-old-size as decimal       no-undo .
      577           define variable v-frame-width   as decimal       no-undo .
      578           define variable jj              as integer       no-undo .
      579           do
      580               on error undo, return error
      581               :
      582               assign
      583                   v-frame-width = frame wind1:width - 0.3
      584                   fh            = frame wind1:first-child
      585                   hh            = fh:first-child
      586                   ii            = 1
      587                   .
      588               do while valid-handle(hh):
      589                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      590                   do:
      591                       case lc(hh:name) :
      592                           when "b-help" then
      593                               do:
      594                                   hh:load-image-up("cmp/b-help.bmp":u) .
      595                                   hh:load-image-down("cmp/b-help.bmp":u) .
      596                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      597                                   hh:TOOLTIP = "Помощь" .
      598                                   v-help-old-x = hh:column .
      599                                   v-help-old-y = hh:row    .
      600                                   v-help-old-size = hh:width .
      601                                   hh:width-chars = 2.5 .
      602                               end.
      603                           when "b-print" then
      604                               do:
      605                                   hh:load-image("cmp/b-print.bmp":u) .
      606                                   hh:TOOLTIP = "Печать" .
      607                                   v-h[ii] = hh:handle .
      608                                   ii = ii + 1 .
      609                                   hh:width-chars = 3 .
      610                               end.
      611                           when "b-history" or
      612                           when "b-hist" then
      613                               do:
      614                                   hh:load-image("cmp/b-hist.bmp":u) .
      615                                   hh:TOOLTIP = "История" .
      616                                   v-h[ii] = hh:handle .
      617                                   ii = ii + 1 .
      618                                   hh:width-chars = 3 .
      619                               end.
      620                           when "b-sch" then
      621                               do:
      622                                   hh:load-image("cmp/b-sch.bmp":u) .
      623                                   hh:TOOLTIP = "Установка Фильтра" .
      624                                   v-h[ii] = hh:handle .
      625                                   ii = ii + 1 .
      626                                   hh:width-chars = 3 .
      627                               end.
      628                           when "b-hist-user" then
      629                               do:
      630                                   hh:load-image("cmp/b-hist.bmp":u) .
      631                                   hh:TOOLTIP = "История пользователя" .
      632                                   ii = ii + 1 .
      633                               end.
      634                       end case.
      635                   end.
      636                   hh = hh:next-sibling.
      637               end.
      638               b-help:column = v-frame-width - b-help:width-chars.
      639               jj = 0.
      640               repeat ii = 4 to 1 by -1 :
      641                   if valid-handle (v-h[ii] ) then
      642                   do:
      643                       jj  = jj + 1 .
      644                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      645                       v-h[ii]:row    = v-help-old-y .
      646                   end.
      647               end.
      648           end.
      649       end.
      650   end procedure.
      651   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      652   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      653   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      654   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      655   define variable v-diasize-current-frame-width  as decimal   no-undo .
      656   define variable v-diasize-current-frame-height as decimal   no-undo .
      657   define variable v-diasize-change-size          as logical   no-undo .
      658   define variable v-diasize-resize-button        as handle    no-undo .
      659   define variable v-diasize-wndmax               as logical   no-undo .
      660   define variable v-diasize-wndstore             as logical   no-undo .
      661   define variable v-diasize-proc-name            as character no-undo .
      662   define variable v-diasize-browse-handle        as handle    no-undo .
      663   define variable v-diasize-browse-number        as integer   no-undo .
      664   define variable v-diasize-need-full-display    as logical   no-undo init false .
      665   define temp-table temp-diasize-handle no-undo
      666     field handle-value  as handle
      667     field save-position as decimal
      668     index xpk is primary unique handle-value
      669     .
      670   define temp-table temp-browse-handle no-undo
      671     field browse-type   as character
      672     field browse-number as integer
      673     field browse-handle as handle
      674     field original-size as decimal
      675     index xpk is primary unique browse-type browse-number
      676     index xie browse-type browse-handle
      677   .
      678   procedure diasize_change-height :
      679     define input  parameter p-change-value  as decimal   no-undo .
      680     define input  parameter p-move-resize   as logical   no-undo .
      681     define variable v-field-group-handle    as handle    no-undo .
      682     define variable v-object-handle         as handle    no-undo .
      683     define variable v-frame-height          as decimal   no-undo .
      684     define variable v-frame-virtual-height  as decimal   no-undo .
      685     define variable v-browse-height         as decimal   no-undo .
      686     define variable v-window-height         as decimal   no-undo .
      687     define variable v-window-virtual-height as decimal   no-undo .
      688     define variable v-change-sign           as integer   no-undo .
      689     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      690     define buffer buf_temp-browse-handle  for temp-browse-handle .
      691     if p-change-value > 0
      692     then do:
      693       if frame wind1 :height + p-change-value
      694           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      695       then do:
      696         assign
      697           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      698                           - (frame wind1 :height-chars)
      699         .
      700         if p-change-value <= 0
      701         then do:
      702           run diasize_position-resize-button in this-procedure .
      703           return .
      704         end.
      705       end.
      706     end.
      707     if p-change-value < 0
      708     then do:
      709       if frame wind1 :height + p-change-value < v-diasize-orig-frame-height
      710       then do:
      711         assign
      712           p-change-value = v-diasize-orig-frame-height
      713                          - (frame wind1 :height-chars)
      714         .
      715         if p-change-value >= 0
      716         then do:
      717           run diasize_position-resize-button in this-procedure .
      718           return .
      719         end.
      720       end.
      721     end.
      722     if p-change-value >= 0
      723     then do:
      724       assign
      725         v-change-sign = 1
      726       .
      727     end.
      728     else do:
      729       assign
      730         v-change-sign = -1
      731       .
      732     end.
      733     assign
      734       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      735     .
      736     if p-change-value = 0
      737     then do:
      738       run diasize_position-resize-button in this-procedure .
      739       return .
      740     end.
      741     move_block:
      742     do
      743     on error undo move_block, retry move_block
      744     :
      745       if retry
      746       then do:
      747         do
      748         on error undo move_block, leave move_block
      749         :
      750           if p-change-value > 0
      751           then do:
      752             for each buf_temp-diasize-handle
      753             on error undo, next
      754             :
      755               assign
      756                 v-object-handle = buf_temp-diasize-handle.handle-value
      757               .
      758               if v-object-handle <> v-diasize-resize-button
      759               then do:
      760                 assign
      761                   v-object-handle :row = buf_temp-diasize-handle.save-position
      762                 .
      763               end.
      764             end.
      765             assign
      766               v-diasize-browse-handle :height = v-browse-height
      767             .
      768             for each buf_temp-browse-handle
      769               where buf_temp-browse-handle.browse-type = 'height':u
      770             on error undo, next
      771             :
      772               assign
      773                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      774               .
      775             end.
      776             assign
      777               frame wind1 :height = v-frame-height
      778             .
      779             if frame wind1 :scrollable = true
      780             then do:
      781               assign
      782                 frame wind1 :virtual-height = v-frame-virtual-height
      783               .
      784             end.
      785             run diasize_position-resize-button in this-procedure .
      786           end.
      787           else do:
      788             if frame wind1 :scrollable = true
      789             then do:
      790               assign
      791                 frame wind1 :virtual-height = v-frame-virtual-height
      792               .
      793             end.
      794             assign
      795               frame wind1 :height = v-frame-height
      796             .
      797             assign
      798               v-diasize-browse-handle :height = v-browse-height
      799             .
      800             for each buf_temp-browse-handle
      801               where buf_temp-browse-handle.browse-type = 'height':u
      802             on error undo, next
      803             :
      804               assign
      805                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      806               .
      807             end.
      808             for each buf_temp-diasize-handle
      809             on error undo, next
      810             :
      811               assign
      812                 v-object-handle = buf_temp-diasize-handle.handle-value
      813               .
      814               if v-object-handle <> v-diasize-resize-button
      815               then do:
      816                 assign
      817                   v-object-handle :row = buf_temp-diasize-handle.save-position
      818                 .
      819               end.
      820             end.
      821             run diasize_position-resize-button in this-procedure .
      822           end.
      823           assign
      824             v-diasize-change-size = false
      825           .
      826           leave move_block .
      827         end.
      828       end.
      829       assign
      830         v-diasize-need-full-display = true
      831       .
      832       if v-diasize-change-size = false
      833       then do:
      834         assign
      835           v-diasize-change-size = true
      836         .
      837       end.
      838       else do:
      839         return .
      840       end.
      841       assign
      842         v-frame-height = frame wind1 :height
      843         v-frame-virtual-height = frame wind1 :virtual-height
      844         v-browse-height = v-diasize-browse-handle :height
      845       .
      846       for each buf_temp-browse-handle
      847         where buf_temp-browse-handle.browse-type = 'height':u
      848       :
      849         assign
      850           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      851         .
      852       end.
      853       for each buf_temp-diasize-handle
      854       :
      855         delete buf_temp-diasize-handle .
      856       end.
      857       assign
      858         v-field-group-handle = frame wind1 :first-child
      859       .
      860       do while valid-handle(v-field-group-handle)
      861       :
      862         assign
      863           v-object-handle = v-field-group-handle :first-child
      864         .
      865         do while valid-handle(v-object-handle)
      866         :
      867           if  v-object-handle <> v-diasize-browse-handle :handle
      868           and can-query(v-object-handle, "row")
      869           and can-query(v-object-handle, "height")
      870           and ( v-object-handle :row > v-diasize-browse-handle :row )
      871           then do:
      872             find first buf_temp-browse-handle
      873               where buf_temp-browse-handle.browse-type   = 'height':u
      874                 and buf_temp-browse-handle.browse-handle = v-object-handle
      875               no-error .
      876             if available buf_temp-browse-handle
      877             then do:
      878             end.
      879             else do:
      880               create buf_temp-diasize-handle .
      881               assign
      882                 buf_temp-diasize-handle.handle-value  = v-object-handle
      883                 buf_temp-diasize-handle.save-position = v-object-handle :row
      884               .
      885             end.
      886           end.
      887           assign
      888             v-object-handle = v-object-handle :next-sibling
      889           .
      890         end.
      891         assign
      892           v-field-group-handle = v-field-group-handle :next-sibling
      893         .
      894       end.
      895       do with frame wind1
      896       :
      897         hide v-diasize-resize-button .
      898         assign
      899           v-diasize-resize-button :row    = 1
      900           v-diasize-resize-button :column = 1
      901         .
      902       end.
      903       if p-change-value > 0
      904       then do:
      905         if frame wind1 :scrollable = true
      906         then do:
      907           assign
      908             frame wind1 :virtual-height = frame wind1 :virtual-height + p-change-value
      909             no-error .
      910           if error-status :error
      911           or error-status :get-message(1) <> ""
      912           then do:
      913             undo move_block, retry move_block .
      914           end.
      915         end.
      916         assign
      917           frame wind1 :height = frame wind1 :height + p-change-value
      918           no-error .
      919         if error-status :error
      920         or error-status :get-message(1) <> ""
      921         then do:
      922           undo move_block, retry move_block .
      923         end.
      924         assign
      925           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      926           no-error .
      927         if error-status :error
      928         or error-status :get-message(1) <> ""
      929         then do:
      930           undo move_block, retry move_block .
      931         end.
      932         for each buf_temp-browse-handle
      933           where buf_temp-browse-handle.browse-type = 'height':u
      934         on error undo move_block, retry move_block
      935         :
      936           assign
      937             buf_temp-browse-handle.browse-handle :height
      938               = buf_temp-browse-handle.browse-handle :height + p-change-value
      939             no-error .
      940           if error-status :error
      941           or error-status :get-message(1) <> ""
      942           then do:
      943             undo move_block, retry move_block .
      944           end.
      945         end.
      946         for each buf_temp-diasize-handle
      947         on error undo move_block, retry move_block
      948         :
      949           assign
      950             v-object-handle = buf_temp-diasize-handle.handle-value
      951           .
      952           if v-object-handle <> v-diasize-resize-button
      953           then do:
      954             assign
      955               v-object-handle :row = v-object-handle :row + p-change-value
      956               no-error .
      957             if error-status :error
      958             or error-status :get-message(1) <> ""
      959             then do:
      960               undo move_block, retry move_block .
      961             end.
      962           end.
      963         end.
      964       end.
      965       else do:
      966         for each buf_temp-diasize-handle
      967         on error undo move_block, retry move_block
      968         :
      969           assign
      970             v-object-handle = buf_temp-diasize-handle.handle-value
      971           .
      972           if v-object-handle <> v-diasize-resize-button
      973           then do:
      974             assign
      975               v-object-handle :row = v-object-handle :row + p-change-value
      976               no-error .
      977             if error-status :error
      978             or error-status :get-message(1) <> ""
      979             then do:
      980               undo move_block, retry move_block .
      981             end.
      982           end.
      983         end.
      984         assign
      985           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      986           no-error .
      987         if error-status :error
      988         or error-status :get-message(1) <> ""
      989         then do:
      990           undo move_block, retry move_block .
      991         end.
      992         for each buf_temp-browse-handle
      993           where buf_temp-browse-handle.browse-type = 'height':u
      994         on error undo move_block, retry move_block
      995         :
      996           assign
      997             buf_temp-browse-handle.browse-handle :height
      998               = buf_temp-browse-handle.browse-handle :height + p-change-value
      999             no-error .
     1000           if error-status :error
     1001           or error-status :get-message(1) <> ""
     1002           then do:
     1003             undo move_block, retry move_block .
     1004           end.
     1005         end.
     1006         assign
     1007           frame wind1 :height = frame wind1 :height + p-change-value
     1008           no-error .
     1009         if error-status :error
     1010         or error-status :get-message(1) <> ""
     1011         then do:
     1012           undo move_block, retry move_block .
     1013         end.
     1014         if frame wind1 :scrollable = true
     1015         then do:
     1016           assign
     1017             frame wind1 :virtual-height = frame wind1 :virtual-height + p-change-value
     1018             no-error .
     1019           if error-status :error
     1020           or error-status :get-message(1) <> ""
     1021           then do:
     1022             undo move_block, retry move_block .
     1023           end.
     1024         end.
     1025       end.
     1026       if p-move-resize = true
     1027       then do:
     1028         run diasize_position-resize-button in this-procedure .
     1029       end.
     1030       if v-diasize-wndstore = true
     1031       then do:
     1032         if connected("ub") = true
     1033         then do:
     1034           define variable v-cntxt-db-num        as integer   no-undo .
     1035           define variable v-cntxt-userid        as character no-undo .
     1036           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1037                                             , OUTPUT v-cntxt-userid
     1038                                             ) .
     1039           run gbl/wndsizew.p
     1040             (input  v-cntxt-db-num
     1041             ,input  v-cntxt-userid
     1042             ,input  v-diasize-proc-name
     1043             ,input  'height':u
     1044             ,input  string(frame wind1 :height - v-diasize-orig-frame-height)
     1045             ) .
     1046         end.
     1047       end.
     1048     end.
     1049     assign
     1050       v-diasize-change-size = false
     1051     .
     1052   end procedure.
     1053   procedure diasize_set-height :
     1054     define input  parameter p-new-height  as decimal   no-undo .
     1055     define input  parameter p-move-resize as logical   no-undo .
     1056     do
     1057     on error undo, return error return-value
     1058     :
     1059       run diasize_change-height in this-procedure
     1060         (input  (p-new-height - frame wind1 :height)
     1061         ,input  p-move-resize
     1062         ) .
     1063     end.
     1064   end procedure.
     1065   procedure diasize_change-width :
     1066     define input  parameter p-change-value as decimal   no-undo .
     1067     define input  parameter p-move-resize  as logical   no-undo .
     1068     define variable v-field-group-handle   as handle    no-undo .
     1069     define variable v-object-handle        as handle    no-undo .
     1070     define variable v-frame-width          as decimal   no-undo .
     1071     define variable v-frame-virtual-width  as decimal   no-undo .
     1072     define variable v-browse-width         as decimal   no-undo .
     1073     define variable v-window-width         as decimal   no-undo .
     1074     define variable v-window-virtual-width as decimal   no-undo .
     1075     define variable v-change-sign          as integer   no-undo .
     1076     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1077     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1078     if p-change-value > 0
     1079     then do:
     1080       if frame wind1 :width + p-change-value >
     1081           session :width-chars
     1082       then do:
     1083         assign
     1084           p-change-value = session :width-chars - frame wind1 :width
     1085         .
     1086         if p-change-value <= 0
     1087         then do:
     1088           run diasize_position-resize-button in this-procedure .
     1089           return .
     1090         end.
     1091       end.
     1092     end.
     1093     if p-change-value < 0
     1094     then do:
     1095       if frame wind1 :width + p-change-value < v-diasize-orig-frame-width
     1096       then do:
     1097         assign
     1098           p-change-value = v-diasize-orig-frame-width
     1099                          - frame wind1 :width
     1100         .
     1101         if p-change-value >= 0
     1102         then do:
     1103           run diasize_position-resize-button in this-procedure .
     1104           return .
     1105         end.
     1106       end.
     1107     end.
     1108     if p-change-value >= 0
     1109     then do:
     1110       assign
     1111         v-change-sign = 1
     1112       .
     1113     end.
     1114     else do:
     1115       assign
     1116         v-change-sign = -1
     1117       .
     1118     end.
     1119     assign
     1120       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1121     .
     1122     if p-change-value = 0
     1123     then do:
     1124       run diasize_position-resize-button in this-procedure .
     1125       return .
     1126     end.
     1127     move_block:
     1128     do
     1129     on error undo move_block, leave move_block
     1130     :
     1131       if retry
     1132       then do:
     1133         do
     1134         on error undo move_block, leave move_block
     1135         :
     1136           if p-change-value > 0
     1137           then do:
     1138             for each buf_temp-diasize-handle
     1139             on error undo, next
     1140             :
     1141               assign
     1142                 v-object-handle = buf_temp-diasize-handle.handle-value
     1143               .
     1144               if v-object-handle <> v-diasize-resize-button
     1145               then do:
     1146                 assign
     1147                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1148                 .
     1149               end.
     1150             end.
     1151             assign
     1152               v-diasize-browse-handle :width = v-browse-width
     1153             .
     1154             for each buf_temp-browse-handle
     1155               where buf_temp-browse-handle.browse-type = 'width':u
     1156             on error undo, next
     1157             :
     1158               assign
     1159                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1160               .
     1161             end.
     1162             assign
     1163               frame wind1 :width = v-frame-width
     1164             .
     1165             if frame wind1 :scrollable = true
     1166             then do:
     1167               assign
     1168                 frame wind1 :virtual-width = v-frame-virtual-width
     1169               .
     1170             end.
     1171             run diasize_position-resize-button in this-procedure .
     1172           end.
     1173           else do:
     1174             if frame wind1 :scrollable = true
     1175             then do:
     1176               assign
     1177                 frame wind1 :virtual-width = v-frame-virtual-width
     1178               .
     1179             end.
     1180             assign
     1181               frame wind1 :width = v-frame-width
     1182             .
     1183             for each buf_temp-browse-handle
     1184               where buf_temp-browse-handle.browse-type = 'width':u
     1185             on error undo, next
     1186             :
     1187               assign
     1188                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1189               .
     1190             end.
     1191             assign
     1192               v-diasize-browse-handle :width = v-browse-width
     1193             .
     1194             for each buf_temp-diasize-handle
     1195             on error undo, next
     1196             :
     1197               assign
     1198                 v-object-handle = buf_temp-diasize-handle.handle-value
     1199               .
     1200               if v-object-handle <> v-diasize-resize-button
     1201               then do:
     1202                 assign
     1203                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1204                 .
     1205               end.
     1206             end.
     1207             run diasize_position-resize-button in this-procedure .
     1208           end.
     1209           assign
     1210             v-diasize-change-size = false
     1211           .
     1212           leave move_block .
     1213         end.
     1214       end.
     1215       assign
     1216         v-diasize-need-full-display = true
     1217       .
     1218       if v-diasize-change-size = false
     1219       then do:
     1220         assign
     1221           v-diasize-change-size = true
     1222         .
     1223       end.
     1224       else do:
     1225         return .
     1226       end.
     1227       assign
     1228         v-frame-width = frame wind1 :width
     1229         v-frame-virtual-width = frame wind1 :virtual-width
     1230         v-browse-width = v-diasize-browse-handle :width
     1231       .
     1232       for each buf_temp-browse-handle
     1233         where buf_temp-browse-handle.browse-type = 'width':u
     1234       :
     1235         assign
     1236           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1237         .
     1238       end.
     1239       for each buf_temp-diasize-handle
     1240       :
     1241         delete buf_temp-diasize-handle .
     1242       end.
     1243       assign
     1244         v-field-group-handle = frame wind1 :first-child
     1245       .
     1246       do while valid-handle(v-field-group-handle)
     1247       :
     1248         assign
     1249           v-object-handle = v-field-group-handle :first-child
     1250         .
     1251         do while valid-handle(v-object-handle)
     1252         :
     1253           if  v-object-handle <> v-diasize-browse-handle :handle
     1254           and v-object-handle <> v-diasize-resize-button
     1255           and can-query(v-object-handle, "row")
     1256           and can-query(v-object-handle, "height")
     1257           and ( v-object-handle :col + v-object-handle :width
     1258                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1259               )
     1260           then do:
     1261             find first buf_temp-browse-handle
     1262               where buf_temp-browse-handle.browse-type   = 'width':u
     1263                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1264               no-error .
     1265             if available buf_temp-browse-handle
     1266             then do:
     1267             end.
     1268             else do:
     1269               create buf_temp-diasize-handle .
     1270               assign
     1271                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1272                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1273               .
     1274             end.
     1275           end.
     1276           assign
     1277             v-object-handle = v-object-handle :next-sibling
     1278           .
     1279         end.
     1280         assign
     1281           v-field-group-handle = v-field-group-handle :next-sibling
     1282         .
     1283       end.
     1284       do with frame wind1
     1285       :
     1286         hide v-diasize-resize-button .
     1287         v-diasize-resize-button :row = 1.
     1288         v-diasize-resize-button :column = 1.
     1289       end.
     1290       if p-change-value > 0
     1291       then do:
     1292         if frame wind1 :scrollable = true
     1293         then do:
     1294           assign
     1295             frame wind1 :virtual-width = frame wind1 :virtual-width + p-change-value
     1296             no-error .
     1297           if error-status :error
     1298           or error-status :get-message(1) <> ""
     1299           then do:
     1300             undo move_block, retry move_block.
     1301           end.
     1302         end.
     1303         assign
     1304           frame wind1 :width = v-frame-width + p-change-value
     1305           no-error .
     1306         if error-status :error
     1307         or error-status :get-message(1) <> ""
     1308         then do:
     1309           undo move_block, retry move_block.
     1310         end.
     1311         assign
     1312           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1313         no-error .
     1314         if error-status :error
     1315         or error-status :get-message(1) <> ""
     1316         then do:
     1317           undo move_block, retry move_block.
     1318         end.
     1319         for each buf_temp-browse-handle
     1320           where buf_temp-browse-handle.browse-type = 'width':u
     1321         on error undo move_block, retry move_block
     1322         :
     1323           assign
     1324             buf_temp-browse-handle.browse-handle :width
     1325               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1326             no-error .
     1327           if error-status :error
     1328           or error-status :get-message(1) <> ""
     1329           then do:
     1330             undo move_block, retry move_block .
     1331           end.
     1332         end.
     1333         for each buf_temp-diasize-handle
     1334         on error undo move_block, retry move_block
     1335         :
     1336           assign
     1337             v-object-handle = buf_temp-diasize-handle.handle-value
     1338           .
     1339           if v-object-handle <> v-diasize-resize-button
     1340           then do:
     1341             assign
     1342               v-object-handle :col = v-object-handle :col + p-change-value
     1343               no-error .
     1344             if error-status :error
     1345             or error-status :get-message(1) <> ""
     1346             then do:
     1347               undo move_block, retry move_block .
     1348             end.
     1349           end.
     1350         end.
     1351       end.
     1352       else do:
     1353         for each buf_temp-diasize-handle
     1354         on error undo move_block, retry move_block
     1355         :
     1356           assign
     1357             v-object-handle = buf_temp-diasize-handle.handle-value
     1358           .
     1359           if v-object-handle <> v-diasize-resize-button
     1360           then do:
     1361             assign
     1362               v-object-handle :col = v-object-handle :col + p-change-value
     1363               no-error .
     1364             if error-status :error
     1365             or error-status :get-message(1) <> ""
     1366             then do:
     1367               undo move_block, retry move_block .
     1368             end.
     1369           end.
     1370         end.
     1371         for each buf_temp-browse-handle
     1372           where buf_temp-browse-handle.browse-type = 'width':u
     1373         on error undo move_block, retry move_block
     1374         :
     1375           assign
     1376             buf_temp-browse-handle.browse-handle :width
     1377               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1378             no-error .
     1379           if error-status :error
     1380           or error-status :get-message(1) <> ""
     1381           then do:
     1382             undo move_block, retry move_block .
     1383           end.
     1384         end.
     1385         assign
     1386           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1387           no-error .
     1388         if error-status :error
     1389         or error-status :get-message(1) <> ""
     1390         then do:
     1391           undo move_block, retry move_block.
     1392         end.
     1393         assign
     1394           frame wind1 :width = frame wind1 :width + p-change-value
     1395         no-error .
     1396         if error-status :error
     1397         or error-status :get-message(1) <> ""
     1398         then do:
     1399           undo move_block, retry move_block.
     1400         end.
     1401         if frame wind1 :scrollable = true
     1402         then do:
     1403           assign
     1404             frame wind1 :virtual-width = frame wind1 :virtual-width + p-change-value
     1405           no-error .
     1406           if error-status :error
     1407           or error-status :get-message(1) <> ""
     1408           then do:
     1409             undo move_block, retry move_block.
     1410           end.
     1411         end.
     1412       end.
     1413       if p-move-resize
     1414       then do:
     1415         run diasize_position-resize-button in this-procedure .
     1416       end.
     1417       if v-diasize-wndstore = true
     1418       then do:
     1419         if connected("ub") = true
     1420         then do:
     1421           define variable v-cntxt-db-num        as integer   no-undo .
     1422           define variable v-cntxt-userid        as character no-undo .
     1423           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1424                                             , OUTPUT v-cntxt-userid
     1425                                             ) .
     1426           run gbl/wndsizew.p
     1427             (input  v-cntxt-db-num
     1428             ,input  v-cntxt-userid
     1429             ,input  v-diasize-proc-name
     1430             ,input  'width':u
     1431             ,input  string(frame wind1 :width - v-diasize-orig-frame-width)
     1432             ) .
     1433         end.
     1434       end.
     1435     end.
     1436     assign
     1437       v-diasize-change-size = false
     1438     .
     1439   end procedure.
     1440   procedure diasize_set-width :
     1441     define input  parameter p-new-width  as decimal   no-undo .
     1442     define input  parameter p-move-resize as logical   no-undo .
     1443     do
     1444     on error undo, return error return-value
     1445     :
     1446       run diasize_change-width in this-procedure
     1447         (input  (p-new-width - frame wind1 :width)
     1448         ,input  p-move-resize
     1449         ) .
     1450     end.
     1451   end procedure.
     1452   procedure diasize_position-resize-button :
     1453     do with frame wind1
     1454     :
     1455       hide v-diasize-resize-button .
     1456       assign
     1457         v-diasize-resize-button :row = frame wind1 :height - v-diasize-resize-button :height
     1458                     - 1
     1459                     - (frame wind1 :border-bottom-pixels / session :pixels-per-row)
     1460         v-diasize-resize-button :col = frame wind1 :width - v-diasize-resize-button :width
     1461                     - 1
     1462                     - (frame wind1 :border-right-pixels / session :pixels-per-column)
     1463       .
     1464       view v-diasize-resize-button .
     1465     end.
     1466   end procedure.
     1467   on alt-right anywhere
     1468   do:
     1469     run diasize_change-width in this-procedure
     1470       (input 1
     1471       ,input true
     1472       ) .
     1473     return no-apply .
     1474   end.
     1475   on alt-left anywhere
     1476   do:
     1477     run diasize_change-width in this-procedure
     1478       (input -1
     1479       ,input true
     1480       ) .
     1481     return no-apply .
     1482   end.
     1483   on alt-down anywhere
     1484   do:
     1485     run diasize_change-height in this-procedure
     1486       (input 1
     1487       ,input true
     1488       ) .
     1489     return no-apply .
     1490   end.
     1491   on alt-up anywhere
     1492   do:
     1493     run diasize_change-height in this-procedure
     1494       (input -1
     1495       ,input true
     1496       ) .
     1497     return no-apply .
     1498   end.
     1499   on alt-enter of frame wind1
     1500   do:
     1501     run diasize_maximize in this-procedure
     1502       (input  ?
     1503       ).
     1504     return no-apply .
     1505   end.
     1506   procedure diasize_end-move :
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       define variable v-row-delta as decimal   no-undo .
     1511       define variable v-col-delta as decimal   no-undo .
     1512       define variable v-new-row as decimal   no-undo .
     1513       define variable v-new-col as decimal   no-undo .
     1514       assign
     1515         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1516         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1517       .
     1518       assign
     1519         v-row-delta = v-new-row - frame wind1 :height
     1520         v-col-delta = v-new-col - frame wind1 :width
     1521       .
     1522       run diasize_change-height in this-procedure
     1523         (input v-row-delta
     1524         ,input true
     1525         ) .
     1526       run diasize_change-width in this-procedure
     1527         (input v-col-delta
     1528         ,input true
     1529         ) .
     1530     end.
     1531   end procedure.
     1532   procedure diasize_maximize :
     1533     define input  parameter p-action as logical   no-undo .
     1534     do
     1535     on error undo, return error return-value
     1536     :
     1537       if p-action = ?
     1538       then do:
     1539         if v-diasize-need-maximize = true
     1540         then do:
     1541           assign
     1542             p-action = true
     1543           .
     1544         end.
     1545         else do:
     1546           assign
     1547             p-action = false
     1548           .
     1549         end.
     1550       end.
     1551       if p-action = true
     1552       then do:
     1553         run diasize_change-height in this-procedure
     1554           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1555               - frame wind1 :height-chars
     1556           ,input true
     1557           ) .
     1558         run diasize_change-width in this-procedure
     1559           (input session :width-chars
     1560               - frame wind1 :width-chars
     1561           ,input true
     1562           ) .
     1563         assign
     1564           v-diasize-need-maximize = false
     1565         .
     1566       end.
     1567       else do:
     1568         run diasize_change-width in this-procedure
     1569           (input v-diasize-orig-frame-width
     1570               - frame wind1 :width-chars
     1571           ,input true
     1572           ) .
     1573         run diasize_change-height in this-procedure
     1574           (input v-diasize-orig-frame-height
     1575               - frame wind1 :height-chars
     1576           ,input true
     1577           ) .
     1578         assign
     1579           v-diasize-need-maximize = true
     1580         .
     1581       end.
     1582     end.
     1583   end procedure.
     1584   procedure diasize_restore-orig-size :
     1585     do
     1586     on error undo, return error return-value
     1587     :
     1588       assign
     1589         v-diasize-current-frame-width  = frame wind1 :width
     1590         v-diasize-current-frame-height = frame wind1 :height
     1591       .
     1592       run diasize_set-height in this-procedure
     1593         (input  v-diasize-orig-frame-height
     1594         ,input  true
     1595         ) .
     1596       run diasize_set-width in this-procedure
     1597         (input  v-diasize-orig-frame-width
     1598         ,input  true
     1599         ) .
     1600     end.
     1601   end procedure.
     1602   procedure diasize_restore-current-size :
     1603     do
     1604     on error undo, return error return-value
     1605     :
     1606       run diasize_set-height in this-procedure
     1607         (input  v-diasize-current-frame-height
     1608         ,input  true
     1609         ) .
     1610       run diasize_set-width in this-procedure
     1611         (input  v-diasize-current-frame-width
     1612         ,input  true
     1613         ) .
     1614     end.
     1615   end procedure.
     1616   procedure diasize_set-browse-handle :
     1617     define input  parameter p-browse-handle as handle   no-undo .
     1618     define buffer buf_temp-browse-handle for temp-browse-handle .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       assign
     1623         v-diasize-browse-handle = p-browse-handle
     1624       .
     1625       for each buf_temp-browse-handle
     1626       on error undo, return error return-value
     1627       :
     1628         delete buf_temp-browse-handle .
     1629       end.
     1630     end.
     1631   end procedure.
     1632   procedure diasize_add_browse :
     1633     define input  parameter p-browse-type   as character no-undo .
     1634     define input  parameter p-browse-handle as handle    no-undo .
     1635     define buffer buf_temp-browse-handle for temp-browse-handle .
     1636     do
     1637     on error undo, return error return-value
     1638     :
     1639       assign
     1640         v-diasize-browse-number = v-diasize-browse-number + 1
     1641       .
     1642       create buf_temp-browse-handle .
     1643       assign
     1644         buf_temp-browse-handle.browse-type   = p-browse-type
     1645         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1646         buf_temp-browse-handle.browse-handle = p-browse-handle
     1647       .
     1648     end.
     1649   end procedure.
     1650   procedure diasize_init :
     1651     define variable v-default-value    as logical   no-undo .
     1652     define variable v-restore-saved    as logical   no-undo .
     1653     define variable v-resize-value-str as character no-undo .
     1654     do
     1655     on error undo, return error return-value
     1656     :
     1657       do with frame wind1
     1658       :
     1659         assign
     1660           v-diasize-orig-frame-height = frame wind1 :height
     1661           v-diasize-orig-frame-width  = frame wind1 :width
     1662           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1663         .
     1664         create button v-diasize-resize-button
     1665         assign
     1666           parent        = frame wind1 :first-child
     1667           label         = "s"
     1668           height-pixels = 16
     1669           width-pixels  = 16
     1670           visible       = true
     1671           sensitive     = true
     1672           movable       = true
     1673           triggers:
     1674             on end-move persistent run diasize_end-move in this-procedure .
     1675           end triggers.
     1676         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1677         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1678         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1679         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1680         assign
     1681           v-diasize-wndmax = false
     1682         .
     1683         if connected("ub") = true
     1684         then do:
     1685           define variable v-cntxt-db-num        as integer   no-undo .
     1686           define variable v-cntxt-userid        as character no-undo .
     1687           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1688                                             , OUTPUT v-cntxt-userid
     1689                                             ) .
     1690           run gbl/wndpar_r.p
     1691             (input  v-cntxt-db-num
     1692             ,input  v-cntxt-userid
     1693             ,input  'wndmax':U
     1694             ,output v-diasize-wndmax
     1695             ,output v-default-value
     1696             ) .
     1697         end.
     1698         assign
     1699           v-diasize-wndstore = false
     1700         .
     1701         if connected("ub") = true
     1702         then do:
     1703           run gbl/wndpar_r.p
     1704             (input  v-cntxt-db-num
     1705             ,input  v-cntxt-userid
     1706             ,input  'wndstore':U
     1707             ,output v-diasize-wndstore
     1708             ,output v-default-value
     1709             ) .
     1710         end.
     1711         assign
     1712           v-diasize-proc-name = entry(1, program-name(2), '.')
     1713         .
     1714         if v-diasize-wndstore = true
     1715         then do:
     1716           assign
     1717             v-restore-saved = false
     1718           .
     1719           if connected("ub") = true
     1720           then do:
     1721             run gbl/wndsizer.p
     1722               (input  v-cntxt-db-num
     1723               ,input  v-cntxt-userid
     1724               ,input  v-diasize-proc-name
     1725               ,input  'height':u
     1726               ,output v-resize-value-str
     1727               ) .
     1728             if v-resize-value-str <> '':U
     1729             then do:
     1730               run diasize_change-height in this-procedure
     1731                 (input  integer(v-resize-value-str)
     1732                 ,input  true
     1733                 ) .
     1734               assign
     1735                 v-restore-saved = true
     1736               .
     1737             end.
     1738           end.
     1739           if connected("ub") = true
     1740           then do:
     1741             run gbl/wndsizer.p
     1742               (input  v-cntxt-db-num
     1743               ,input  v-cntxt-userid
     1744               ,input  v-diasize-proc-name
     1745               ,input  'width':u
     1746               ,output v-resize-value-str
     1747               ) .
     1748             if v-resize-value-str <> '':U
     1749             then do:
     1750               run diasize_change-width in this-procedure
     1751                 (input  integer(v-resize-value-str)
     1752                 ,input  true
     1753                 ) .
     1754               assign
     1755                 v-restore-saved = true
     1756               .
     1757             end.
     1758           end.
     1759           if v-restore-saved <> true
     1760           then do:
     1761             if v-diasize-wndmax = true
     1762             then do:
     1763               run diasize_maximize in this-procedure
     1764                 (input  true
     1765                 ) .
     1766             end.
     1767           end.
     1768         end.
     1769         else do:
     1770           if v-diasize-wndmax = true
     1771           then do:
     1772             run diasize_maximize in this-procedure
     1773               (input  true
     1774               ) .
     1775           end.
     1776         end.
     1777       end.
     1778     end.
     1779   end procedure.
     1780   procedure diasize_need-full-display :
     1781     define output parameter p-need-full-display as logical   no-undo .
     1782     do
     1783     on error undo, return error return-value
     1784     :
     1785       assign
     1786         p-need-full-display = v-diasize-need-full-display
     1787       .
     1788       assign
     1789         v-diasize-need-full-display = false
     1790       .
     1791     end.
     1792   end procedure.
     1793   procedure get-context :
     1794      define output parameter p-db-num as integer          no-undo.
     1795      define output parameter p-user-id as character        no-undo.
     1796      define variable v-login               as character    no-undo.
     1797      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1798      define buffer buf_user-login  for ub.user-login .
     1799      do
     1800      on error undo, return error
     1801      :
     1802            FIND FIRST buf_sys-ctrl no-lock.
     1803            ASSIGN
     1804               v-login = USERID("ub")
     1805               p-db-num = buf_sys-ctrl.db-num
     1806            .
     1807            FIND FIRST buf_user-login
     1808                 WHERE buf_user-login.db-num = p-db-num
     1809                   AND buf_user-login.user-login = v-login
     1810                 no-lock
     1811                 no-error
     1812                 .
     1813            IF AVAILABLE buf_user-login
     1814            THEN DO:
     1815               assign
     1816                  p-user-id = buf_user-login.user-id
     1817               .
     1818            END.
     1819      end.
     1820   end procedure.
     1821       run diasize_init in this-procedure .
     1822   MAIN-BLOCK:
     1823   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1824      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1825     RUN init-tt.
     1826     RUN enable_UI.
     1827     if g#db-num > 0 then do:
     1828         hide B-exit B-def in frame wind1 .
     1829         b-quit:label = "Выход" .
     1830     end.
     1831     WAIT-FOR GO OF FRAME wind1.
     1832   END.
     1833   RUN disable_UI.
     1834   PROCEDURE def-proc :
     1835   find first ub.thbj-attr exclusive-lock where
     1836                 ub.thbj-attr.obj-code                     =  0   and
     1837                 ub.thbj-attr.obj-type                     =  ""  and
     1838                 ub.thbj-attr.prop-code                    = 'izt-rul':U  and
     1839                 ub.thbj-attr.prop-value-type              = 'character':U  and
     1840                 ub.thbj-attr.upper-prop-code              = 'izt-rul':U
     1841                 no-error  .
     1842   if available ub.thbj-attr then do:
     1843      delete ub.thbj-attr.
     1844   end.
     1845     run gbl/clearlib.p .
     1846     run init-tt .
     1847     run enable_ui .
     1848   END PROCEDURE.
     1849   PROCEDURE disable_UI :
     1850     HIDE FRAME wind1.
     1851   END PROCEDURE.
     1852   PROCEDURE enable_UI :
     1853     ENABLE B-exit B-quit B-def B-Help RECT-1 BROWSE-2
     1854         WITH FRAME wind1.
     1855     VIEW FRAME wind1.
     1856     OPEN QUERY BROWSE-2 FOR EACH tt-izt.
     1857   END PROCEDURE.
     1858   PROCEDURE init-tt :
     1859   define variable v-nn  as integer   no-undo .
     1860   define variable i as integer   no-undo .
     1861   empty temp-table tt-izt .
     1862   v-nn = num-entries ('ie-rest,ie-norest,iv-rest,iv-norest,mf_ie-rest,mf_ie-norest,ee-rest,ee-norest,ev-rest,ev-norest,cli_ev-rest,cli_ev-norest,mf_ee-rest,mf_ee-norest,cli_mf_ee-rest,cli_mf_ee-norest,ОП-rest,ОП-norest,ОР-rest,ОР-norest,cli_ОР-rest,cli_ОР-norest,ОО-rest,ОО-norest,cli_ОО-rest,cli_ОО-norest,ОФ-rest,ОФ-norest,ПО-rest,ПО-norest,rcv-rest,rcv-norest,cli_rcv-rest,cli_rcv-norest,scu-grp-matr,scu-grp-specif,delete-matr-rest,delete-matr-norest,ФП-rest,ФП-norest':U) .
     1863   do i = 1 to v-nn :
     1864     CREATE tt-izt.
     1865     ASSIGN
     1866       tt-izt.nn              =  i
     1867       tt-izt.izt-event-name  = entry( i, 'Внешний приход: остатки на объекте есть,Внешний приход: остатков нет,Внутрений приход: остатки на объекте есть,Внутренний приход: остатков нет,Межфирменный приход: остатки на объекте есть,Межфирменный приход: остатков нет,Внешний расход: остатки  есть,Внешний расход: остатков нет,Внутрений расход: остатки на объекте есть,Внутренний расход: остатков нет,Внутрений расход: остатки на объекте приемнике есть,Внутренний расход: остатков на объекте приемнике нет,Межфирменный расход: остатки на объекте есть,Межфирменный расход: остатков нет,Межфирменный расход: остатки на приемнике есть,Межфирменный расход: остатков на приемнике нет,Заказ ОП: остатки на объекте есть,Заказ ОП: остатков нет,Заказ ОРЦ: остатки на объекте есть,Заказ ОРЦ: остатков на объекте нет,Заказ ОРЦ: остатки на объекте приемнике есть,Заказ ОРЦ: остатков на объекте приемнике нет,Заказ ОO: остатки на объекте есть,Заказ ОO: остатков на объекте нет,Заказ ОO: остатки на объекте приемнике есть,Заказ ОO: остатков на объекте приемнике нет,Заказ ОФ: остатки на объекте есть,Заказ ОФ: остатков нет,Заказ Покупателя: остатки на объекте есть,Заказ Покупателя: остатков нет,Поставка (закрытие): остатки на объекте есть,Поставка (закрытие): остатков нет,Поставка (закрытие): остатки на объекте приемнике есть,Поставка (закрытие): остатков на объекте приемнике нет,Подсчет SCU по группам в Ассортиментной матрице,Подсчет SCU по группам в Спецификации,Удаление товара из матрицы: остатки на объекте есть,Удаление товара из матрицы: остатков на объекте нет,Заказ ФП: остатки на объекте есть,Заказ ФП: остатков нет':U)
     1868       tt-izt.izt-event-code  = entry( i, 'ie-rest,ie-norest,iv-rest,iv-norest,mf_ie-rest,mf_ie-norest,ee-rest,ee-norest,ev-rest,ev-norest,cli_ev-rest,cli_ev-norest,mf_ee-rest,mf_ee-norest,cli_mf_ee-rest,cli_mf_ee-norest,ОП-rest,ОП-norest,ОР-rest,ОР-norest,cli_ОР-rest,cli_ОР-norest,ОО-rest,ОО-norest,cli_ОО-rest,cli_ОО-norest,ОФ-rest,ОФ-norest,ПО-rest,ПО-norest,rcv-rest,rcv-norest,cli_rcv-rest,cli_rcv-norest,scu-grp-matr,scu-grp-specif,delete-matr-rest,delete-matr-norest,ФП-rest,ФП-norest':U )
     1869     .
     1870   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1871   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run iztrul in g#library2
     1872     (input  tt-izt.izt-event-code
     1873     ,output tt-izt.izd-new
     1874     ,output tt-izt.izd-com
     1875     ,output tt-izt.izd-del
     1876     ,output tt-izt.izd-spec
     1877     ,output tt-izt.izd-empty
     1878     ) no-error .
     1879       if error-status :error then message
     1880         vss-workfile vss-revision vss-description skip
     1881         error-status :get-message(1) skip
     1882         return-value skip
     1883         ""
     1884         view-as alert-box error
     1885       .
     1886   end.
     1887   END PROCEDURE.
     1888   PROCEDURE save-proc :
     1889   define variable v-str as character no-undo .
     1890   v-str = "".
     1891       for each tt-izt by tt-izt.nn :
     1892         v-str = v-str + tt-izt.izt-event-code  + "," +
     1893                 string (tt-izt.izd-new) + "," +
     1894                 string (tt-izt.izd-com) + "," +
     1895                 string (tt-izt.izd-del) + "," +
     1896                 string (tt-izt.izd-spec) + "," +
     1897                 string (tt-izt.izd-empty)  + ";" .
     1898       end.
     1899   v-str = trim(v-str, ";") .
     1900   empty temp-table thbjattr_thbj-attr.
     1901   create thbjattr_thbj-attr.
     1902   assign
     1903   thbjattr_thbj-attr.obj-code                     =  0
     1904   thbjattr_thbj-attr.obj-type                     =  ""
     1905   thbjattr_thbj-attr.prop-code                    = 'izt-rul':U
     1906   thbjattr_thbj-attr.prop-value-type              = 'character':U
     1907   thbjattr_thbj-attr.property-value-character     = v-str
     1908   thbjattr_thbj-attr.upper-prop-code              = 'izt-rul':U
     1909   .
     1910     run thbjattr_set-section in this-procedure (
     1911           input ""
     1912         , input 0
     1913         , input 'izt-rul':U
     1914         , input table thbjattr_thbj-attr
     1915     ) no-error.
     1916     if error-status:error then do:
     1917       message error-status:get-message(1)  skip
     1918       return-value
     1919       "Вернулась из thbjattr_set-section"
     1920       view-as alert-box.
     1921       undo, return error.
     1922     end.
     1923    run gbl/clearlib.p .
     1924   END PROCEDURE.
     1925   PROCEDURE rrr :
     1926       if tt-izt.izt-event-code = 'scu-grp-matr':U    or
     1927        tt-izt.izt-event-code = 'scu-grp-specif':U  then do:
     1928         tt-izt.izd-new        :read-only in browse BROWSE-2   = true  .
     1929         tt-izt.izd-com        :read-only in browse BROWSE-2   = true  .
     1930         tt-izt.izd-del        :read-only in browse BROWSE-2   = true  .
     1931         tt-izt.izd-spec       :read-only in browse BROWSE-2   = true  .
     1932         tt-izt.izd-empty      :read-only in browse BROWSE-2   = true  .
     1933     end.
     1934     else do:
     1935           if tt-izt.izt-event-code = 'delete-matr-rest':U  or
     1936             tt-izt.izt-event-code = 'delete-matr-norest':U then do:
     1937               tt-izt.izd-new        :read-only in browse BROWSE-2   = true  .
     1938               tt-izt.izd-com        :read-only in browse BROWSE-2   = true  .
     1939               tt-izt.izd-del        :read-only in browse BROWSE-2   = false   .
     1940               tt-izt.izd-spec       :read-only in browse BROWSE-2   = true  .
     1941               tt-izt.izd-empty      :read-only in browse BROWSE-2   = true  .
     1942           end.
     1943           else do:
     1944               tt-izt.izd-new        :read-only in browse BROWSE-2   = false  .
     1945               tt-izt.izd-com        :read-only in browse BROWSE-2   = false   .
     1946               tt-izt.izd-spec       :read-only in browse BROWSE-2   = false   .
     1947               tt-izt.izd-empty      :read-only in browse BROWSE-2   = false   .
     1948               tt-izt.izd-del        :read-only in browse BROWSE-2   = false   .
     1949           end.
     1950     end.
     1951   END PROCEDURE.
