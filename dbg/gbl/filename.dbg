        1   block-level on error undo, throw.
        2   define input  parameter p-search-file-name as character no-undo .
        3   define output parameter p-full-path        as character no-undo .
        4   define output parameter p-path             as character no-undo .
        5   define output parameter p-file-name        as character no-undo .
        6   define output parameter p-file-name-no-ext as character no-undo .
        7   define output parameter p-file-name-ext    as character no-undo .
        8   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   def var vss-author      as character no-undo init "$Author: expertek $":U .
       10   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   def var vss-workfile    as character no-undo init "$Workfile: filename.p $":U .
       12   def var vss-archive     as character no-undo init "$Archive: gbl/filename.p $":U .
       13   def var vss-description as character no-undo init "Возвращает компоненты имени файла".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1',p-search-file-name)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   do
       76   on error undo, return error return-value
       77   :
       78     def var v-full-pathname as character no-undo .
       79     define variable v-path-split as integer   no-undo .
       80     assign
       81       v-full-pathname = search(p-search-file-name)
       82     .
       83     if v-full-pathname = ""
       84     or v-full-pathname = ?
       85     then do:
       86       return error substitute("Файл &1 не найден", p-search-file-name) .
       87     end.
       88     assign
       89       file-info :file-name = v-full-pathname
       90     .
       91     assign
       92       v-full-pathname = file-info :full-pathname
       93     .
       94     assign
       95       p-full-path = v-full-pathname
       96     .
       97     if index(file-info :file-type, 'F':U) = 0
       98     then do:
       99       undo, return error "В качестве параметра указан не файл" + chr(32) + v-full-pathname .
      100     end.
      101     assign
      102       v-path-split = r-index(p-full-path, '\':u)
      103     .
      104     if v-path-split = 0 then do:
      105       undo, return error "Невозможно определить имя файла" + chr(32) + v-full-pathname .
      106     end.
      107     assign
      108       p-path      = substring(p-full-path, 1, v-path-split - 1)
      109       p-file-name = substring(p-full-path, v-path-split + 1)
      110     .
      111     define variable v-ext-split as integer   no-undo .
      112     assign
      113       v-ext-split = r-index(p-file-name, '.':u)
      114     .
      115     if v-ext-split > 0 then do:
      116       assign
      117         p-file-name-no-ext = substring(p-file-name, 1, v-ext-split - 1)
      118         p-file-name-ext    = substring(p-file-name, v-ext-split + 1)
      119       .
      120     end.
      121     else do:
      122       assign
      123         p-file-name-no-ext = p-file-name
      124         p-file-name-ext    = ""
      125       .
      126     end.
      127     if p-file-name-ext = "" then do:
      128       assign
      129         p-file-name = p-file-name-no-ext
      130       .
      131     end.
      132     assign
      133       p-full-path = p-path + '\':u + p-file-name
      134     .
      135   end.
