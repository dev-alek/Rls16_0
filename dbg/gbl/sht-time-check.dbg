        1   block-level on error undo, throw.
        2   define input parameter p-shift-date as date no-undo.
        3   define input parameter p-shift-num as integer no-undo.
        4   define input parameter p-obj-type as character no-undo.
        5   define input parameter p-obj-code as integer no-undo.
        6   define input parameter p-start-time as integer no-undo.
        7   define input parameter p-end-time as integer no-undo.
        8   define input parameter p-start-date as date no-undo.
        9   define input parameter p-end-date as date no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: sht-time-check.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: gbl/sht-time-check.p $":U .
       15   define variable vss-description as character no-undo init "Изменение времени закрытой смены".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable prev-timestamp as decimal no-undo.
       75   define variable next-timestamp as decimal no-undo.
       76   define variable new-start-timestamp as decimal no-undo.
       77   define variable new-end-timestamp as decimal no-undo.
       78   define buffer bf_curr-shift-obj for ub.shift-obj.
       79   define buffer bf_prev-shift-obj for ub.shift-obj.
       80   define buffer bf_next-shift-obj for ub.shift-obj.
       81   find first bf_curr-shift-obj no-lock
       82       where bf_curr-shift-obj.obj-type = p-obj-type
       83       and bf_curr-shift-obj.obj-code = p-obj-code
       84       and bf_curr-shift-obj.shift-date = p-shift-date
       85       and bf_curr-shift-obj.shift-num = p-shift-num
       86       no-error.
       87   if not available bf_curr-shift-obj then
       88       return error subst("Смена &1 &2 на объекте &3 &4 не найдена", p-shift-date, p-shift-num, p-obj-type, p-obj-code).
       89   if bf_curr-shift-obj.status_ <> 'зкр':U then
       90       return error "Время смены можно менять только при статусе <Закрыта>".
       91   find first bf_prev-shift-obj no-lock
       92       where recid(bf_prev-shift-obj) = recid(bf_curr-shift-obj).
       93   find prev bf_prev-shift-obj no-lock
       94       where bf_prev-shift-obj.obj-type = p-obj-type
       95       and bf_prev-shift-obj.obj-code = p-obj-code
       96       no-error.
       97   find first bf_next-shift-obj no-lock
       98       where recid(bf_next-shift-obj) = recid(bf_curr-shift-obj).
       99   find next bf_next-shift-obj no-lock
      100       where bf_next-shift-obj.obj-type = p-obj-type
      101       and bf_next-shift-obj.obj-code = p-obj-code
      102       and bf_next-shift-obj.open-date <> ?
      103       no-error.
      104   if p-start-date >= p-end-date AND p-start-time >= p-end-time then
      105       return error "Новое время открытия смены должно быть меньше закрытия".
      106   assign
      107       new-start-timestamp = int(bf_curr-shift-obj.open-date) * 60 * 60 * 60 * 24 + p-start-time
      108       new-end-timestamp = int(if bf_curr-shift-obj.close-date <> ? then bf_curr-shift-obj.close-date else p-shift-date) * 60 * 60 * 60 * 24 + p-end-time
      109       prev-timestamp = int(bf_prev-shift-obj.close-date) * 60 * 60 * 60 * 24 + bf_prev-shift-obj.close-time when available bf_prev-shift-obj
      110       next-timestamp = int(bf_next-shift-obj.open-date) * 60 * 60 * 60 * 24 + bf_next-shift-obj.open-time when available bf_next-shift-obj
      111   .
      112   if available bf_next-shift-obj and new-end-timestamp >= next-timestamp then
      113       return error "Время открытия смены должно быть больше времени закрытия предыдущей смены".
      114   if available bf_prev-shift-obj and new-start-timestamp <= prev-timestamp then
      115       return error "Время закрытия смены должно быть меньше времени открытия следующей смены".
