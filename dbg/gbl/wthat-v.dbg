        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code like ub.wth-doc-attr.doc-code   no-undo .
        3   define input  parameter p-code     like ub.wth-doc-attr.attr-code  no-undo .
        4   define output parameter p-value    like ub.wth-doc-attr.attr-value no-undo .
        5   define output parameter p-type     as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: wthat-v.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: gbl/wthat-v.p $":U .
       11   define variable vss-description as character no-undo init "Считать значение атрибута документа МЦ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3',p-doc-code,p-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   procedure wthcattr-sprcli :
       74   define input parameter parparentproc  as widget-handle no-undo.
       75   define input parameter p-mode  as character no-undo.
       76   define input-output parameter p-value as character no-undo .
       77   define output parameter p-setted as logical no-undo .
       78     DEFINE VARIABLE v-value as character no-undo .
       79     define variable v-cli-type as character no-undo .
       80     define variable v-cli-code as integer no-undo .
       81     define buffer buf_clients   for ub.clients.
       82     define variable v_rid as character no-undo.
       83     define variable ref-rec as recid no-undo .
       84     do
       85     on error undo, return error
       86     :
       87         v-value = p-value.
       88      if p-value <> '':U then do:
       89       assign
       90       v-cli-type = substring(p-value, 1, 3)
       91       v-cli-code = integer(substring(p-value, 4))
       92       no-error.
       93       if error-status:error then do:
       94         assign
       95         v-cli-type = '':U
       96         v-cli-code = 0
       97         .
       98       end.
       99      end.
      100      FIND FIRST buf_clients NO-LOCK WHERE
      101               buf_clients.obj-type = v-cli-type AND
      102               buf_clients.obj-code = v-cli-code  NO-ERROR.
      103      IF available(buf_clients) then do:
      104       run ref/cli-all.w (
      105                   input parparentproc
      106                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      107                  ,input v-cli-type
      108                  ,input 'все':U
      109                  ,input 'все':U
      110                  ,input RECID( buf_clients )
      111                  ,input ",,,,,,NO"
      112                  ,input ?
      113                  ,OUTPUT v_rid ).
      114     END.
      115     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      116       run ref/cli-all.w (
      117                    input parparentproc
      118                   ,INPUT "b-sel":U
      119                  ,input  v-cli-type
      120                  ,input 'все':U
      121                  ,input 'текущие':U
      122                  ,input ?
      123                  ,input ",,,,,,NO"
      124                  ,input ?
      125                  ,OUTPUT v_rid ).
      126     END.
      127     else do:
      128       message
      129       if p-value = "":U then 'Атрибут не задан!'
      130       else substitute('Не найден клиент &1',p-value)
      131       view-as alert-box warning.
      132     end.
      133     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      134       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      135       IF ERROR-STATUS:ERROR THEN DO:
      136           RETURN NO-APPLY.
      137       END.
      138       FIND FIRST buf_clients NO-LOCK WHERE
      139                  RECID( buf_clients ) = ref-rec NO-ERROR.
      140       IF AVAIL buf_clients THEN DO:
      141         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      142       end.
      143     end.
      144     if v-value <> p-value then do:
      145       p-value = v-value.
      146       p-setted = yes.
      147     end.
      148     end.
      149   end procedure.
      150     define new global shared variable g#wthcalib as handle no-undo.
      151   do
      152   on error undo, return error return-value
      153   :
      154   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
      155                           input p-code ,
      156                          output p-value ,
      157                          output p-type ) no-error .
      158       if error-status :error
      159       then do:
      160           if error-status :get-message(1) <> ""
      161           then do:
      162           message
      163               vss-workfile vss-revision vss-description skip
      164               "Ошибка при вызове процедуры" 'wthat-v.p':u skip
      165               "Документ" p-doc-code skip
      166               "Атрибут" p-code skip
      167               "Значение" p-value skip
      168               error-status :get-message(1) skip
      169               return-value skip
      170               view-as alert-box error .
      171           end.
      172           undo, return error return-value .
      173       end.
      174   end.
