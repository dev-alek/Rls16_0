     1023   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1024   on help of frame Dialog-Frame
     1025   do:
     1026     run gbl/app_help.p
     1027       (input this-procedure :file-name
     1028       ,input ''
     1029       ,input ?
     1030       ) no-error.
     1031     if error-status :error then do:
     1032       message
     1033         "Ошибка при вызове помощи"
     1034         error-status :get-message(1)
     1035         view-as alert-box .
     1036     end.
