     1368       ,input  v-cntxt-obj-type
     1369       ,input  v-cntxt-obj-code
     1370       ,input  0
     1371       ,input  0
     1372       ,input  0
     1373       ,input  true
     1374       ,output loc#log
     1375       )  .
     1376   end.
     1377      if loc#log <> yes then do: return error. end.
     1378       run init-tt.
