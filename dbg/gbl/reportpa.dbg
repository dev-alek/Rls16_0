      908   DO:
      909   define variable v-rid-list as character no-undo .
      910    if p-mode = 'ПРОСМОТР':U then return .
      911       run ref/gds-grp.w (
      912                     input parparentproc
      913                   , input ('b-sel')
      914                   , input v-cntxt-obj-type
      915                   , input v-cntxt-obj-code
      916                   , input-output v-rid-list) NO-ERROR.
      917    if error-status :error or v-rid-list = "" then return no-apply .
      918    define buffer buf_gds-grp for ub.gds-grp  .
      919    find first buf_gds-grp no-lock where recid(buf_gds-grp) = int(v-rid-list) no-error .
      920    if error-status :error then return no-apply .
      921    alcgrpgd   = buf_gds-grp.node-code .
      922    s-alcgrpgd = buf_gds-grp.node-name .
      923    DISPLAY alcgrpgd s-alcgrpgd  with FRAME Dialog-Frame.
      924   END.
