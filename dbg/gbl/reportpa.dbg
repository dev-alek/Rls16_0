     1038   run minbtn-set in this-procedure .
     1039   on choose of b-help in frame Dialog-Frame
     1040   do:
     1041     apply "help":u to frame Dialog-Frame .
     1042   end.
     1043   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   procedure minbtn-set :
     1045       do
     1046           on error undo, return error return-value
     1047           :
     1048           define variable ii              as integer       no-undo .
     1049           define variable fh              as widget-handle no-undo .
     1050           define variable hh              as widget-handle no-undo .
     1051           define variable v-h             as handle        extent 4 no-undo .
     1052           define variable v-name-button   as character     no-undo .
     1053           define variable v-help-old-x    as decimal       no-undo .
     1054           define variable v-help-old-y    as decimal       no-undo .
     1055           define variable v-help-old-size as decimal       no-undo .
     1056           define variable v-frame-width   as decimal       no-undo .
     1057           define variable jj              as integer       no-undo .
     1058           do
     1059               on error undo, return error
     1060               :
     1061               assign
     1062                   v-frame-width = frame Dialog-Frame:width - 0.3
     1063                   fh            = frame Dialog-Frame:first-child
     1064                   hh            = fh:first-child
     1065                   ii            = 1
     1066                   .
     1067               do while valid-handle(hh):
     1068                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1069                   do:
     1070                       case lc(hh:name) :
     1071                           when "b-help" then
     1072                               do:
     1073                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1074                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1075                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1076                                   hh:TOOLTIP = "Помощь" .
     1077                                   v-help-old-x = hh:column .
     1078                                   v-help-old-y = hh:row    .
     1079                                   v-help-old-size = hh:width .
     1080                                   hh:width-chars = 2.5 .
     1081                               end.
     1082                           when "b-print" then
     1083                               do:
     1084                                   hh:load-image("cmp/b-print.bmp":u) .
     1085                                   hh:TOOLTIP = "Печать" .
     1086                                   v-h[ii] = hh:handle .
     1087                                   ii = ii + 1 .
     1088                                   hh:width-chars = 3 .
     1089                               end.
     1090                           when "b-history" or
     1091                           when "b-hist" then
     1092                               do:
     1093                                   hh:load-image("cmp/b-hist.bmp":u) .
     1094                                   hh:TOOLTIP = "История" .
     1095                                   v-h[ii] = hh:handle .
     1096                                   ii = ii + 1 .
     1097                                   hh:width-chars = 3 .
     1098                               end.
     1099                           when "b-sch" then
     1100                               do:
     1101                                   hh:load-image("cmp/b-sch.bmp":u) .
     1102                                   hh:TOOLTIP = "Установка Фильтра" .
     1103                                   v-h[ii] = hh:handle .
     1104                                   ii = ii + 1 .
     1105                                   hh:width-chars = 3 .
     1106                               end.
     1107                           when "b-hist-user" then
     1108                               do:
     1109                                   hh:load-image("cmp/b-hist.bmp":u) .
     1110                                   hh:TOOLTIP = "История пользователя" .
     1111                                   ii = ii + 1 .
     1112                               end.
     1113                       end case.
     1114                   end.
     1115                   hh = hh:next-sibling.
     1116               end.
     1117               b-help:column = v-frame-width - b-help:width-chars.
     1118               jj = 0.
     1119               repeat ii = 4 to 1 by -1 :
     1120                   if valid-handle (v-h[ii] ) then
     1121                   do:
     1122                       jj  = jj + 1 .
     1123                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1124                       v-h[ii]:row    = v-help-old-y .
     1125                   end.
     1126               end.
     1127           end.
     1128       end.
     1129   end procedure.
     1130   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1131   on ' ' of ardecldt in frame Dialog-Frame
     1132   do:
     1133     if (can-query (self, "sensitive")
     1134        and
     1135        self :sensitive = true
     1136        )
     1137     or (can-query (self, "read-only")
     1138        and
     1139        self :read-only = false
     1140        )
     1141     then do:
     1142       assign
     1143         self :screen-value = ?
     1144       .
     1145     end.
     1146     return no-apply.
     1147   end.
     1148   on delete-character of ardecldt in frame Dialog-Frame
     1149   do:
     1150     if (can-query (self, "sensitive")
     1151        and
     1152        self :sensitive = true
     1153        )
     1154     or (can-query (self, "read-only")
     1155        and
     1156        self :read-only = false
     1157        )
     1158     then do:
     1159       assign
     1160         self :screen-value = ?
     1161       .
     1162     end.
     1163     return no-apply.
     1164   end.
     1165   on ctrl-d of ardecldt in frame Dialog-Frame
     1166   do:
     1167     define variable v-curr-sv-date as date no-undo .
     1168     if (can-query (self, "sensitive")
     1169        and
     1170        self :sensitive = true
     1171        )
     1172     or (can-query (self, "read-only")
     1173        and
     1174        self :read-only = false
     1175        )
     1176     then do:
     1177       if self :handle <> focus :handle
     1178       then do:
     1179         apply "entry":u to self .
     1180       end.
     1181       run gbl/getcurdt.p
     1182         (output v-curr-sv-date
     1183         ) .
     1184       assign
     1185         self :screen-value = string(v-curr-sv-date) .
     1186       .
     1187     end.
     1188     return no-apply.
     1189   end.
     1190   on ctrl-b of ardecldt in frame Dialog-Frame
     1191   do:
     1192     if (can-query (self, "sensitive")
     1193        and
     1194        self :sensitive = true
     1195        )
     1196     or (can-query (self, "read-only")
     1197        and
     1198        self :read-only = false
     1199        )
     1200     then do:
     1201       if self :handle <> focus :handle
     1202       then do:
     1203         apply "entry":u to self .
     1204       end.
     1205       define variable v-curr-sv-date as date no-undo .
     1206       define variable v-new-sv-date  as date no-undo .
     1207       assign
     1208         v-curr-sv-date = date(self :screen-value) no-error
     1209       .
     1210       if v-curr-sv-date = ?
     1211       then do:
     1212         run gbl/getcurdt.p
     1213           (output v-curr-sv-date
     1214           ) .
     1215       end.
     1216       if v-curr-sv-date <> ?
     1217       then do:
     1218         assign
     1219           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1220         .
     1221         assign
     1222           self :screen-value = string(v-new-sv-date) .
     1223         .
     1224       end.
     1225     end.
     1226     return no-apply .
     1227   end.
     1228   on ctrl-e of ardecldt in frame Dialog-Frame
     1229   do:
     1230     if (can-query (self, "sensitive")
     1231        and
     1232        self :sensitive = true
     1233        )
     1234     or (can-query (self, "read-only")
     1235        and
     1236        self :read-only = false
     1237        )
     1238     then do:
     1239       if self :handle <> focus :handle
     1240       then do:
     1241         apply "entry":u to self .
     1242       end.
     1243       define variable v-curr-sv-date as date no-undo .
     1244       define variable v-new-sv-date  as date no-undo .
     1245       assign
     1246         v-curr-sv-date = date(self :screen-value) no-error
     1247       .
     1248       if v-curr-sv-date = ?
     1249       then do:
     1250         run gbl/getcurdt.p
     1251           (output v-curr-sv-date
     1252           ) .
     1253       end.
     1254       if v-curr-sv-date <> ?
     1255       then do:
     1256         run gbl/lastdate.p
     1257           (input  v-curr-sv-date
     1258           ,output v-new-sv-date
     1259           ).
     1260         assign
     1261           self :screen-value = string(v-new-sv-date) .
     1262         .
     1263       end.
     1264     end.
     1265     return no-apply .
     1266   end.
     1267   on ctrl-f of ardecldt in frame Dialog-Frame
     1268   do:
     1269     if (can-query (self, "sensitive")
     1270        and
     1271        self :sensitive = true
     1272        )
     1273     or (can-query (self, "read-only")
     1274        and
     1275        self :read-only = false
     1276        )
     1277     then do:
     1278       if self :handle <> focus :handle
     1279       then do:
     1280         apply "entry":u to self .
     1281       end.
     1282       define variable v-ok            as logical   no-undo .
     1283       define variable v-curr-sv-date  as date      no-undo .
     1284       define variable v-description   as character no-undo .
     1285       assign
     1286         v-curr-sv-date = date(self :screen-value) no-error
     1287       .
     1288       if v-curr-sv-date = ?
     1289       then do:
     1290         run gbl/getcurdt.p
     1291           (output v-curr-sv-date
     1292           ) .
     1293       end.
     1294       if v-curr-sv-date <> ?
     1295       then do:
     1296         run gbl/d-inpday.w
     1297           (input ?
     1298           ,input "Выбор даты"
     1299           ,input v-description
     1300           ,input ""
     1301           ,input-output v-curr-sv-date
     1302           ,output v-ok
     1303           ).
     1304         if v-ok = true
     1305         then do:
     1306           assign
     1307             self :screen-value = string(v-curr-sv-date) .
     1308           .
     1309         end.
     1310       end.
     1311     end.
     1312     return no-apply .
     1313   end.
