     1384   END.
     1385   run disable_UI.
     1386   PROCEDURE disable_UI :
     1387     HIDE FRAME Dialog-Frame.
     1388   END PROCEDURE.
     1389   PROCEDURE enable_UI :
     1390     DISPLAY actuate prt-z-no sum-from sum-step sum-to sumvals xl-delim rep-sort
     1391             ardecldt shft-qty rep-shift-format rep-password alcgrpgd cplot cdens
     1392             rep-excel F-button-1 F-button-2 v-actuate v-prt-z-no FILL-IN-2
     1393             v-sum-from v-sum-step v-sum-to v-sumvals v-xl-delim v-rep-sort
     1394             v-ardecldt v-shft-qty v-alcgrpgd s-alcgrpgd v-cplot v-cdens
     1395         WITH FRAME Dialog-Frame.
     1396     ENABLE B-exit BUTTON-1 B-quit B-Help I-actuate BUTTON-2 I-ardecldt I-rep-sort
     1397            I-sum-from I-sum-step I-sum-to I-sumvals I-prt-z-no I-shft-qty RECT-2
     1398            I-xl-delim I-alcgrpgd I-cplot I-cdens I-rep-excel actuate B-10
     1399            prt-z-no sum-from sum-step sum-to sumvals B-17 xl-delim rep-sort
     1400            B-set_rep-sort ardecldt B-11 shft-qty rep-shift-format
     1401            B-alcgrpgd cplot B-set_cplot cdens F-button-1 F-button-2
     1402            v-actuate v-prt-z-no FILL-IN-2 v-sum-from v-sum-step v-sum-to
     1403            v-sumvals v-xl-delim v-rep-sort v-ardecldt v-shft-qty v-alcgrpgd
     1404            v-cplot v-cdens
     1405         WITH FRAME Dialog-Frame.
     1406     VIEW FRAME Dialog-Frame.
     1407   END PROCEDURE.
     1408   PROCEDURE fill-widgets :
     1409   define variable v-value-character as character no-undo .
     1410   define variable v-value-date as date no-undo .
     1411   define variable v-value-decimal as decimal no-undo .
     1412   define variable v-value-integer as INTEGER no-undo .
     1413   define variable v-value-logical AS LOGICAL no-undo .
     1414   define variable v-param-type as character no-undo .
     1415   define variable v-param-value as character no-undo .
     1416   for each thbjattr_thbj-attr:
     1417     delete thbjattr_thbj-attr.
     1418   end.
     1419   for each thbjattr_thbj-attr-o:
     1420     delete thbjattr_thbj-attr-o.
     1421   end.
     1422   for each thbjattr_thbj-attr-g:
     1423     delete thbjattr_thbj-attr-g.
     1424   end.
     1425   for each thbjattr_thbj-attr-f:
     1426     delete thbjattr_thbj-attr-f.
     1427   end.
     1428   for each temp-thbj-attr:
     1429     delete temp-thbj-attr.
     1430   end.
     1431   if p-type = 'glob' then do:
     1432     run adm/shattri.p (
     1433         input "init":U
     1434       , input ""
     1435       , input 0
     1436       , input 'report-glob':U
     1437       , input "":U
     1438       , output v-value-character
     1439       , output v-value-date
     1440       , output v-value-decimal
     1441       , output v-value-integer
     1442       , output v-value-logical
     1443       , output v-param-type
     1444       , input-output TABLE-HANDLE v-tthg
     1445       ) no-error .
     1446     if error-status:error then do:
     1447       message
     1448       "Не удалось получить начальные значения настроек GLOB" skip
     1449       error-status:get-message(1) skip
     1450       return-value
     1451       view-as alert-box error .
     1452       undo, return error .
     1453   end.
     1454   end.
     1455   if p-type = 'firm' then do:
     1456       run adm/shattri.p (
     1457           input "init":U
     1458         , input v-obj-type
     1459         , input v-obj-code
     1460         , input 'report-firm':U
     1461         , input "":U
     1462         , output v-value-character
     1463         , output v-value-date
     1464         , output v-value-decimal
     1465         , output v-value-integer
     1466         , output v-value-logical
     1467         , output v-param-type
     1468         , input-output TABLE-HANDLE v-tthf
     1469         ) no-error .
     1470       if error-status:error then do:
     1471         message
     1472         "Не удалось получить начальные значения настроек firm" skip
     1473         error-status:get-message(1) return-value
     1474         view-as alert-box error .
     1475         undo, return error .
     1476       end.
     1477   end.
     1478   if p-type = 'obj' then do:
     1479       run adm/shattri.p (
     1480           input "init":U
     1481         , input p-obj-type
     1482         , input p-obj-code
     1483         , input 'report-obj':U
     1484         , input "":U
     1485         , output v-value-character
     1486         , output v-value-date
     1487         , output v-value-decimal
     1488         , output v-value-integer
     1489         , output v-value-logical
     1490         , output v-param-type
     1491         , input-output TABLE-HANDLE v-ttho
     1492         ) no-error .
     1493       if error-status:error then do:
     1494         message
     1495         "Не удалось получить начальные значения настроек OBJ" skip
     1496         error-status:get-message(1) skip
     1497         return-value skip
     1498         view-as alert-box error .
     1499         undo, return error .
     1500       end.
     1501   end.
     1502   FOR EACH thbjattr_thbj-attr-g :
     1503     case thbjattr_thbj-attr-g.prop-code :
     1504   when 'actuate':U THEN DO:     actuate = thbjattr_thbj-attr-g.property-value-logical.     actuate:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display actuate with frame Dialog-Frame . END.
     1505   when 'ardecldt':U THEN DO:     ardecldt = thbjattr_thbj-attr-g.property-value-date.     ardecldt:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display ardecldt with frame Dialog-Frame . END.
     1506   when 'rep-sort':U THEN DO:     rep-sort = thbjattr_thbj-attr-g.property-value-character.     rep-sort:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display rep-sort with frame Dialog-Frame . END.
     1507   when 'sum-from':U THEN DO:     sum-from = thbjattr_thbj-attr-g.property-value-decimal.     sum-from:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display sum-from with frame Dialog-Frame . END.
     1508   when 'sum-step':U THEN DO:     sum-step = thbjattr_thbj-attr-g.property-value-decimal.     sum-step:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display sum-step with frame Dialog-Frame . END.
     1509   when 'sum-to':U THEN DO:     sum-to = thbjattr_thbj-attr-g.property-value-decimal.     sum-to:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display sum-to with frame Dialog-Frame . END.
     1510   when 'sumvals':U THEN DO:     sumvals = thbjattr_thbj-attr-g.property-value-character.     sumvals:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display sumvals with frame Dialog-Frame . END.
     1511   when 'alcgrpgd':U THEN DO:     alcgrpgd = thbjattr_thbj-attr-g.property-value-integer.     alcgrpgd:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display alcgrpgd with frame Dialog-Frame . END.
     1512   when 'rep-shift-format':U THEN DO:     rep-shift-format = thbjattr_thbj-attr-g.property-value-integer.     rep-shift-format:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display rep-shift-format with frame Dialog-Frame . END.
     1513   when 'cplot':U THEN DO:     cplot = thbjattr_thbj-attr-g.property-value-character.     cplot:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display cplot with frame Dialog-Frame . END.
     1514   when 'cdens':U THEN DO:     cdens = thbjattr_thbj-attr-g.property-value-integer.     cdens:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display cdens with frame Dialog-Frame . END.
     1515   when 'rep-excel':U THEN DO:     rep-excel = thbjattr_thbj-attr-g.property-value-logical.     rep-excel:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display rep-excel with frame Dialog-Frame . END.
     1516   when 'rep-password':U THEN DO:     rep-password = thbjattr_thbj-attr-g.property-value-logical.     rep-password:private-data in frame Dialog-Frame = "recid3=" + string(recid(thbjattr_thbj-attr-g)).     display rep-password with frame Dialog-Frame . END.
     1517       otherwise .
     1518     end case .
     1519     create temp-thbj-attr.
     1520     buffer-copy thbjattr_thbj-attr-g to temp-thbj-attr.
     1521   end.
     1522   FOR EACH thbjattr_thbj-attr-o
     1523   :
     1524   IF thbjattr_thbj-attr-o.prop-code = 'prt-z-no':U THEN DO:     prt-z-no = thbjattr_thbj-attr-o.property-value-logical.     prt-z-no:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr-o)).     display prt-z-no with frame Dialog-Frame . END.
     1525   IF thbjattr_thbj-attr-o.prop-code = 'shft-qty':U THEN DO:     shft-qty = thbjattr_thbj-attr-o.property-value-character.     shft-qty:private-data in frame Dialog-Frame = "recid2=" + string(recid(thbjattr_thbj-attr-o)).     display shft-qty with frame Dialog-Frame . END.
     1526     create temp-thbj-attr.
     1527     buffer-copy thbjattr_thbj-attr-o to temp-thbj-attr.
     1528   END.
     1529   FOR EACH thbjattr_thbj-attr-f
     1530   :
     1531   IF thbjattr_thbj-attr-f.prop-code = 'xl-delim':U THEN DO:     xl-delim = thbjattr_thbj-attr-f.property-value-character.     xl-delim:private-data in frame Dialog-Frame = "recid4=" + string(recid(thbjattr_thbj-attr-f)).     display xl-delim with frame Dialog-Frame . END.
     1532     create temp-thbj-attr.
     1533     buffer-copy thbjattr_thbj-attr-f to temp-thbj-attr.
     1534   end.
     1535   define variable v-tooltip as character no-undo .
     1536   define variable v-label   as character no-undo .
     1537   define variable v-tooltip-code as character no-undo .
     1538   run thbjattr_tooltip in this-procedure (    input   'report-obj':U   ,input  "prt-z-no"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-prt-z-no:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-prt-z-no = v-prt-z-no:screen-value .  I-prt-z-no:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1539   run thbjattr_tooltip in this-procedure (    input   'report-obj':U   ,input  "shft-qty"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-shft-qty:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-shft-qty = v-shft-qty:screen-value .  I-shft-qty:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1540   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "actuate"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-actuate:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-actuate = v-actuate:screen-value .  I-actuate:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1541   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "alcgrpgd"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-alcgrpgd:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-alcgrpgd = v-alcgrpgd:screen-value .  I-alcgrpgd:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1542   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "ardecldt"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-ardecldt:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-ardecldt = v-ardecldt:screen-value .  I-ardecldt:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1543   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "rep-sort"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-rep-sort:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-rep-sort = v-rep-sort:screen-value .  I-rep-sort:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1544   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "cplot"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-cplot:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-cplot = v-cplot:screen-value .  I-cplot:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1545   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "cdens"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-cdens:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-cdens = v-cdens:screen-value .  I-cdens:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1546   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "sum-from"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-sum-from:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-sum-from = v-sum-from:screen-value .  I-sum-from:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1547   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "sum-step"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-sum-step:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-sum-step = v-sum-step:screen-value .  I-sum-step:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1548   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "sum-to"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-sum-to:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-sum-to = v-sum-to:screen-value .  I-sum-to:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1549   run thbjattr_tooltip in this-procedure (    input   'report-glob':U   ,input  "sumvals"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-sumvals:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-sumvals = v-sumvals:screen-value .  I-sumvals:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1550   run thbjattr_tooltip in this-procedure (    input   'report-firm':U   ,input  "xl-delim"   ,output v-tooltip   ,output v-label   ,output v-tooltip-code   ) no-error . v-xl-delim:screen-value = REPLACE ( entry(2,v-label,":") , "`" , "," ) .  v-xl-delim = v-xl-delim:screen-value .  I-xl-delim:private-data = REPLACE ( v-tooltip-code , "`" , "," ) .
     1551    define buffer buf_gds-grp for ub.gds-grp  .
     1552    find first buf_gds-grp no-lock where buf_gds-grp.node-code = alcgrpgd no-error .
     1553    if available buf_gds-grp then do:
     1554    alcgrpgd   = buf_gds-grp.node-code .
     1555    s-alcgrpgd = buf_gds-grp.node-name .
     1556    DISPLAY alcgrpgd s-alcgrpgd  with FRAME Dialog-Frame.
     1557    end.
     1558   END PROCEDURE.
     1559   PROCEDURE init-proc :
     1560   define variable v-i as integer   no-undo .
     1561   define variable v-value-character as character no-undo .
     1562   define variable v-value-date as date no-undo .
     1563   define variable v-value-decimal as decimal no-undo .
     1564   define variable v-value-integer as INTEGER no-undo .
     1565   define variable v-value-logical AS LOGICAL no-undo .
     1566   define variable v-type as character no-undo .
     1567   define variable v-value as character no-undo .
     1568   define variable v-found as decimal   no-undo .
     1569     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1570       find first obj_thbj-attr exclusive-lock where
     1571                 obj_thbj-attr.obj-type = p-obj-type
     1572           and   obj_thbj-attr.obj-code = p-obj-code
     1573           and   obj_thbj-attr.upper-prop-code = 'report-obj':U
     1574           and   obj_thbj-attr.prop-code = '':u no-wait no-error.
     1575        if locked obj_thbj-attr then do:
     1576           message
     1577           vss-workfile vss-revision vss-description skip
     1578           'report-obj':U skip
     1579           "Запись ПАРАМЕТРОВ по объектам занята"
     1580           view-as alert-box error .
     1581           undo, return error.
     1582         end.
     1583       find first frm_thbj-attr exclusive-lock where
     1584                 frm_thbj-attr.obj-type = v-obj-type
     1585           and   frm_thbj-attr.obj-code = v-obj-code
     1586           and   frm_thbj-attr.upper-prop-code = 'report-firm':U
     1587           and   frm_thbj-attr.prop-code = '':u no-wait no-error.
     1588        if locked frm_thbj-attr then do:
     1589           message
     1590           vss-workfile vss-revision vss-description skip
     1591           'report-obj':U skip
     1592           "Запись ПАРАМЕТРОВ по фирмам занята"
     1593           view-as alert-box error .
     1594           undo, return error.
     1595         end.
     1596       find first glb_thbj-attr exclusive-lock where
     1597                 glb_thbj-attr.obj-type = ""
     1598           and   glb_thbj-attr.obj-code = 0
     1599           and   glb_thbj-attr.upper-prop-code = 'report-glob':U
     1600           and   glb_thbj-attr.prop-code = '':u no-wait no-error.
     1601        if locked glb_thbj-attr then do:
     1602           message
     1603           vss-workfile vss-revision vss-description skip
     1604           'report-glob':U skip
     1605           "Запись Глобальных ПАРАМЕТРОВ  занята"
     1606           view-as alert-box error .
     1607           undo, return error.
     1608         end.
     1609     end.
     1610     else do:
     1611       find first obj_thbj-attr no-lock where
     1612             obj_thbj-attr.obj-type = p-obj-type
     1613       and   obj_thbj-attr.obj-code = p-obj-code
     1614       and   obj_thbj-attr.upper-prop-code = 'report-obj':U
     1615       and   obj_thbj-attr.prop-code = '':u no-error.
     1616       find first glb_thbj-attr no-lock where
     1617             glb_thbj-attr.obj-type = ""
     1618       and   glb_thbj-attr.obj-code = 0
     1619       and   glb_thbj-attr.upper-prop-code = 'report-glob':U
     1620       and   glb_thbj-attr.prop-code = '':u no-error.
     1621       find first frm_thbj-attr no-lock where
     1622             frm_thbj-attr.obj-type = v-obj-type
     1623       and   frm_thbj-attr.obj-code = v-obj-code
     1624       and   frm_thbj-attr.upper-prop-code = 'report-firm':U
     1625       and   frm_thbj-attr.prop-code = '':u no-error.
     1626     end.
     1627     if not available obj_thbj-attr then do:
     1628       assign
     1629         v-to-create-report  = true
     1630         .
     1631       message
     1632       substitute ("Внимание!!!&1Параметра obj НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1633                   chr(10))
     1634                    view-as alert-box warning.
     1635     end.
     1636     if not available glb_thbj-attr then do:
     1637       assign
     1638         v-to-create-report-g  = true
     1639         .
     1640       message
     1641       substitute ("Внимание!!!&1Гл.Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1642                   chr(10))
     1643                    view-as alert-box warning.
     1644     end.
     1645     if not available frm_thbj-attr then do:
     1646       assign
     1647         v-to-create-report-f  = true
     1648         .
     1649       message
     1650       substitute ("Внимание!!!&1 firm Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     1651                   chr(10))
     1652                    view-as alert-box warning.
     1653     end.
     1654     run fill-widgets in this-procedure no-error.
     1655     if error-status:error then undo, return error.
     1656     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1657        disable
     1658        rep-shift-format rep-excel rep-password
     1659        with frame Dialog-Frame.
     1660        B-exit:label = "Вы&ход"  .
     1661        hide B-quit in frame Dialog-Frame .
     1662     END.
     1663       if not ( p-obj-type = "" and p-obj-code = 0 ) then do:
     1664        disable
     1665        actuate
     1666        alcgrpgd
     1667        ardecldt
     1668        rep-sort
     1669        sum-from
     1670        sum-step
     1671        sum-to
     1672        sumvals
     1673        cplot
     1674        rep-shift-format
     1675        cdens
     1676        with frame Dialog-Frame.
     1677        hide rep-excel rep-password I-rep-excel in frame Dialog-Frame .
     1678     end.
     1679     if not ( p-obj-type = 'орг':U or  ( p-obj-type = "" and p-obj-code = 0 ) ) then do:
     1680        disable
     1681        xl-delim
     1682        with frame Dialog-Frame.
     1683     end.
     1684     if p-type = 'glob' then
     1685     enable
     1686     rep-sort
     1687     cplot
     1688     rep-shift-format
     1689     cdens
     1690     rep-excel
     1691     rep-password
     1692     with frame Dialog-Frame .
     1693   end procedure.
     1694   PROCEDURE init-tt :
     1695       v-obj-type = p-obj-type .
     1696       v-obj-code = p-obj-code .
     1697       if p-obj-type <> 'орг':U  and p-obj-type <> "" then  do:
     1698   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1699   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1700     (input  p-obj-type
     1701     ,input  p-obj-code
     1702     ,output v-host-code
     1703     )  .
     1704           v-obj-type = 'орг':U      .
     1705           v-obj-code = v-host-code .
     1706       end.
     1707   END PROCEDURE.
     1708   PROCEDURE onewin_custom-add-item :
     1709   DEFINE INPUT PARAMETER p-onewin-handle AS HANDLE NO-UNDO.
     1710   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1711   define variable v-ii as integer no-undo .
     1712   define variable v-is-petrolium as logical no-undo .
     1713   define variable v-is-pieces as logical no-undo .
     1714   define variable v-b-code as integer no-undo .
     1715   define variable v-exists as logical no-undo .
     1716   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1717   define buffer buf_goods for ub.goods.
     1718   define buffer buf_temp_onewin_items for temp_onewin_items.
     1719   case v-onewin-point :
     1720     when 'cplot':U then do:
     1721       run ref/cashpays.w (
     1722                      input parparentproc
     1723                     ,input "b-mark,b-sel":U
     1724                     ,input 'все':U
     1725                     ,input 0
     1726                     ,input ''
     1727                     ,input 0
     1728                     ,output v-rid-list) no-error.
     1729       IF NOT ERROR-STATUS:ERROR
     1730       AND v-rid-list <> '' THEN DO:
     1731         _ii:
     1732         do v-ii = 1 to num-entries(v-rid-list):
     1733           FIND FIRST buf_cash-pay NO-LOCK WHERE
     1734                     RECID(buf_cash-pay) = INTEGER(entry(v-ii, v-rid-list)) NO-ERROR.
     1735           IF AVAILABLE buf_cash-pay THEN DO:
     1736             if buf_cash-pay.curr-code <> 0 then do:
     1737               message
     1738               substitute("Нельзя добавить тип кассового платежа с валютой, отличной от национальной&1"  +
     1739                         "Игнорируем выбор платежа &2 (код &3 валюта &4)"
     1740                         , chr(10)
     1741                         , buf_cash-pay.obj-name
     1742                         , buf_cash-pay.cdpay-code
     1743                         , buf_cash-pay.curr-code
     1744                         )
     1745               view-as alert-box warning .
     1746               next _ii.
     1747             end.
     1748             find first buf_temp_onewin_items where
     1749                     buf_temp_onewin_items.itmextkey = string(buf_cash-pay.cdpay-code) no-error.
     1750             if not available temp_onewin_items then do:
     1751               run onewin_check-item in p-onewin-handle (
     1752                                                          input string(buf_cash-pay.cdpay-code)
     1753                                                         ,output v-exists) no-error.
     1754               if v-exists then do:
     1755                 message
     1756                 "Вы уже выбрали этот тип кассового платежа!"
     1757                 view-as alert-box warning.
     1758                 return.
     1759               end.
     1760               run onewin_add-item in p-onewin-handle (
     1761                     input string(buf_cash-pay.cdpay-code)
     1762                   , input substitute("&1-&2"
     1763                                     , string(buf_cash-pay.cdpay-code, ">>>>9")
     1764                                     , buf_cash-pay.obj-name
     1765                                     )
     1766                   , ''
     1767                   , input yes
     1768               ).
     1769             end.
     1770             else do:
     1771               message
     1772               "Вы уже выбрали этот тип кассового платежа!"
     1773               view-as alert-box warning.
     1774               return.
     1775             end.
     1776           END.
     1777         end.
     1778       END.
     1779     end.
     1780     when 'rep-sort':U then do:
     1781       run ref/gds-ref.p ( input parparentproc
     1782                         , input "b-sel,b-mark"
     1783                         , input 'текущие':U
     1784                         , input 'все':U
     1785                         , input ?
     1786                         , input ?
     1787                         , input ?
     1788                         , input ?
     1789                         , input ?
     1790                         , input ?
     1791                         , input ?
     1792                         , input ?
     1793                         , output v-rid-list
     1794                         ) no-error.
     1795       IF NOT ERROR-STATUS:ERROR
     1796       AND v-rid-list <> '' THEN DO:
     1797         _ii:
     1798         do v-ii = 1 to num-entries(v-rid-list):
     1799           FIND FIRST buf_goods NO-LOCK WHERE
     1800                     RECID(buf_goods) = INTEGER(entry(v-ii, v-rid-list)) NO-ERROR.
     1801           IF AVAILABLE buf_goods THEN DO:
     1802   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1803     (
     1804        input buf_goods.artic
     1805     ,  input buf_goods.prod-type
     1806     ,  input buf_goods.prod-code
     1807     , output v-is-petrolium
     1808     , output v-is-pieces
     1809     ) no-error.
     1810             if error-status:error
     1811             or not v-is-petrolium
     1812             or v-is-pieces then do:
     1813               message
     1814               substitute("Нельзя добавить товар с кодом &1 &2"  +
     1815                         "Он не является весовым топливом&2" +
     1816                         "Игнорируем выбор товара"
     1817                         , buf_goods.gds-code
     1818                         , chr(10)
     1819                         )
     1820               view-as alert-box warning .
     1821               next _II.
     1822             end.
     1823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1824     (input  buf_goods.gds-code
     1825     ,input  ?
     1826     ,output v-b-code
     1827     ) no-error .
     1828             if not error-status:error then do:
     1829               find first buf_temp_onewin_items where
     1830                       buf_temp_onewin_items.itmextkey = string(buf_goods.gds-code) no-error.
     1831               if not available temp_onewin_items then do:
     1832                 run onewin_check-item in p-onewin-handle (
     1833                                                           input string(buf_goods.gds-code)
     1834                                                           ,output v-exists) no-error.
     1835                 if v-exists then do:
     1836                   message
     1837                   "Вы уже выбрали этот товар!"
     1838                   view-as alert-box warning.
     1839                   return.
     1840                 end.
     1841                 run onewin_add-item in p-onewin-handle (
     1842                       input string(buf_goods.gds-code)
     1843                     , input substitute("&1-&2"
     1844                                       , string(buf_goods.gds-code)
     1845                                       , buf_goods.gds-name
     1846                                       )
     1847                     , ''
     1848                     , input yes
     1849                 ).
     1850               end.
     1851               else do:
     1852                 message
     1853                 "Вы уже выбрали этот товар!"
     1854                 view-as alert-box warning.
     1855                 return.
     1856               end.
     1857             end.
     1858           end.
     1859         END.
     1860       end.
     1861     end.
     1862   end case.
     1863   END PROCEDURE.
     1864   PROCEDURE onewin_get-bttns :
     1865   DEFINE OUTPUT PARAMETER p-bttns as character no-undo .
     1866   if p-mode = 'ПРОСМОТР':U or not p-type = 'glob'  then do:
     1867     p-bttns = "".
     1868   end.
     1869   else do:
     1870     p-bttns = "b-add,b-del,b-up,b-down,b-exit".
     1871   end.
     1872   END PROCEDURE.
     1873   PROCEDURE proc-set_cplot :
     1874   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1875   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     1876   DEFINE VARIABLE v-local-cplot AS CHARACTER NO-UNDO.
     1877   DEFINE VARIABLE v-cur-ext-key AS CHARACTER NO-UNDO.
     1878   DEFINE VARIABLE v-accepted AS logical NO-UNDO.
     1879   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     1880   define buffer buf_temp_onewin_items for temp_onewin_items.
     1881   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected.
     1882   run onewin_clear in this-procedure.
     1883   _ii:
     1884   DO v-ii = 1 TO NUM-ENTRIES(cplot):
     1885     FIND FIRST buf_cash-pay NO-LOCK WHERE
     1886               buf_cash-pay.cdpay-code = INTEGER(ENTRY(v-ii, cplot) )
     1887          AND buf_cash-pay.curr-code = 0 NO-ERROR.
     1888     IF AVAILABLE buf_cash-pay THEN DO:
     1889           run onewin_add-item in this-procedure (
     1890                 input string(buf_cash-pay.cdpay-code)
     1891               , input substitute("&1-&2"
     1892                                  , string(buf_cash-pay.cdpay-code, ">>>>9")
     1893                                  , buf_cash-pay.obj-name
     1894                                  )
     1895               , ''
     1896               , input yes
     1897           ).
     1898     END.
     1899   END.
     1900   v-onewin-point = 'cplot':U.
     1901   run gbl/onewin.w (
     1902         input parparentproc
     1903       , input 1
     1904       , input v-cplot
     1905       , input "":U
     1906       , input "&Тест"
     1907       , input table temp_onewin_items
     1908       , output table temp_onewin_itemsSelected
     1909       , output v-cur-ext-key
     1910       , output v-accepted
     1911   ).
     1912   IF v-accepted THEN DO:
     1913     FOR EACH buf_temp_onewin_itemsSelected:
     1914       FIND FIRST buf_cash-pay NO-LOCK WHERE
     1915                 buf_cash-pay.cdpay-code = integer(buf_temp_onewin_itemsSelected.itmextkey)
     1916           AND    buf_cash-pay.curr-code = 0
     1917           NO-ERROR.
     1918       IF AVAILABLE buf_cash-pay THEN DO:
     1919         v-local-cplot = v-local-cplot + (IF v-local-cplot = '' THEN '' ELSE chr(44)) +
     1920                         STRING(buf_cash-pay.cdpay-code).
     1921       END.
     1922     END.
     1923     ASSIGN
     1924     cplot = v-local-cplot.
     1925     cplot:SCREEN-VALUE IN FRAME Dialog-Frame = v-local-cplot.
     1926   END.
     1927   END PROCEDURE.
     1928   PROCEDURE proc-set_rep-sort :
     1929   define variable v-ii as integer no-undo .
     1930   define variable v-rid-list as character no-undo .
     1931   define variable v-local_rep-sort as character no-undo .
     1932   define variable v-b-code as integer no-undo .
     1933   DEFINE VARIABLE v-cur-ext-key AS CHARACTER NO-UNDO.
     1934   DEFINE VARIABLE v-accepted AS logical NO-UNDO.
     1935   define buffer buf_temp_onewin_items for temp_onewin_items.
     1936   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected.
     1937   run onewin_clear in this-procedure.
     1938   define buffer buf_goods for ub.goods.
     1939   define buffer buf_bar-code for ub.bar-code.
     1940   do v-ii = 1 to num-entries(rep-sort):
     1941     find first buf_goods no-lock where
     1942             buf_goods.gds-code = integer(entry(v-ii, rep-sort)) no-error.
     1943     if available buf_goods then do:
     1944     run onewin_add-item in this-procedure (
     1945           input string(buf_goods.gds-code)
     1946         , input substitute("&1 - &2"
     1947                             ,buf_goods.gds-code
     1948                             ,buf_goods.gds-name)
     1949         , ''
     1950         , input yes
     1951     ).
     1952     end.
     1953   end.
     1954   v-onewin-point = 'rep-sort':U.
     1955   run gbl/onewin.w (
     1956         input parparentproc
     1957       , input 1
     1958       , input v-rep-sort
     1959       , input "":U
     1960       , input "&Тест"
     1961       , input table temp_onewin_items
     1962       , output table temp_onewin_itemsSelected
     1963       , output v-cur-ext-key
     1964       , output v-accepted
     1965   ).
     1966   IF v-accepted THEN DO:
     1967     FOR EACH buf_temp_onewin_itemsSelected:
     1968       find first buf_goods no-lock where
     1969                 buf_goods.gds-code = integer(buf_temp_onewin_itemsSelected.itmextkey) no-error.
     1970       if available buf_goods then do:
     1971         assign
     1972         v-local_rep-sort = v-local_rep-sort +
     1973                             (if v-local_rep-sort = '' then '' else chr(44)) +
     1974                             trim(string(buf_goods.gds-code)).
     1975       end.
     1976     end.
     1977     assign
     1978     rep-sort = v-local_rep-sort.
     1979     rep-sort:screen-value in frame Dialog-Frame = v-local_rep-sort.
     1980   end.
     1981   END PROCEDURE.
     1982   PROCEDURE save-proc :
     1983   define variable v-value-character as character no-undo .
     1984   define variable v-value-date as date no-undo .
     1985   define variable v-value-decimal as decimal no-undo .
     1986   define variable v-value-integer as INTEGER no-undo .
     1987   define variable v-value-logical AS LOGICAL no-undo .
     1988   define variable v-sale-add as character no-undo .
     1989   define variable v-trf-type like ub.clients.obj-type no-undo .
     1990   define variable v-trf-code like ub.clients.obj-code no-undo .
     1991   define variable v-param-type as character no-undo .
     1992   define variable wh as widget-handle no-undo .
     1993   define variable fh as widget-handle no-undo .
     1994   define variable v-same as logical no-undo .
     1995   define variable v-sameg as logical no-undo .
     1996   define variable v-samef as logical no-undo .
     1997   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
     1998   define variable loc#log as logical   no-undo .
     1999   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2000   do:
     2001     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2002       (input  ibs.th.gbl.gbl-var:g#db-num
     2003       ,input  ibs.th.gbl.gbl-var:g#userid
     2004       ,input  0
     2005       ,input  'actn_nakl-par_update':U
     2006       ,input  'object':U
     2007       ,input  v-cntxt-host-code-obj
     2008       ,input  v-cntxt-obj-type
     2009       ,input  v-cntxt-obj-code
     2010       ,input  0
     2011       ,input  0
     2012       ,input  0
     2013       ,input  true
     2014       ,output loc#log
     2015       )  .
     2016   end.
     2017     if loc#log <> yes then do: return error. end.
     2018   ASSIGN
     2019       actuate FRAME Dialog-Frame
     2020       alcgrpgd
     2021       ardecldt
     2022       rep-sort
     2023       sum-from
     2024       sum-step
     2025       sum-to
     2026       sumvals
     2027       prt-z-no
     2028       shft-qty
     2029       cplot
     2030       rep-shift-format
     2031       rep-excel
     2032       rep-password
     2033       cdens
     2034    .
     2035   assign
     2036     fh = frame Dialog-Frame:first-child
     2037     wh = fh:first-child
     2038     .
     2039   do while valid-handle(wh):
     2040     if wh:private-data begins "recid2=" then do:
     2041       find first thbjattr_thbj-attr-o where
     2042                  recid(thbjattr_thbj-attr-o) = integer(entry(2, wh:private-data, '='))
     2043                  no-error .
     2044       if available thbjattr_thbj-attr-o then do:
     2045       assign
     2046       buffer thbjattr_thbj-attr-o:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2047       end.
     2048     end.
     2049     if wh:private-data begins "recid3=" then do:
     2050       find first thbjattr_thbj-attr-g where
     2051                  recid(thbjattr_thbj-attr-g) = integer(entry(2, wh:private-data, '='))
     2052                  no-error .
     2053       if available thbjattr_thbj-attr-g then do:
     2054           assign
     2055              buffer thbjattr_thbj-attr-g:buffer-field ("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2056       end.
     2057     end.
     2058     if wh:private-data begins "recid4=" then do:
     2059       find first thbjattr_thbj-attr-f where
     2060                  recid(thbjattr_thbj-attr-f) = integer(entry(2, wh:private-data, '='))
     2061                  no-error .
     2062       if available thbjattr_thbj-attr-f then do:
     2063       assign
     2064       buffer thbjattr_thbj-attr-f:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     2065       end.
     2066     end.
     2067     wh = wh:next-sibling.
     2068   end.
     2069   do transaction
     2070   on error undo, return error return-value
     2071   :
     2072     run thbjattr_set-section in this-procedure (
     2073           input p-obj-type
     2074         , input p-obj-code
     2075         , input 'report-obj':U
     2076         , input table thbjattr_thbj-attr-o
     2077     ) no-error.
     2078     if error-status:error then do:
     2079       message error-status:get-message(1)  skip
     2080       return-value
     2081       view-as alert-box.
     2082       undo, return error.
     2083     end.
     2084     if ( p-obj-type = "" and p-obj-code = 0 ) or p-obj-type = 'орг':U then do:
     2085         run thbjattr_set-section in this-procedure (
     2086               input p-obj-type
     2087             , input p-obj-code
     2088             , input 'report-firm':U
     2089             , input table thbjattr_thbj-attr-f
     2090         ) no-error.
     2091         if error-status:error then do:
     2092           message error-status:get-message(1)  skip
     2093           return-value
     2094           view-as alert-box.
     2095           undo, return error.
     2096         end.
     2097     end.
     2098     if p-obj-type = "" and p-obj-code = 0  then do:
     2099         run thbjattr_set-section in this-procedure (
     2100               input p-obj-type
     2101             , input p-obj-code
     2102             , input 'report-glob':U
     2103             , input table thbjattr_thbj-attr-g
     2104         ) no-error.
     2105         if error-status:error then do:
     2106           message error-status:get-message(1)  skip
     2107           return-value
     2108           view-as alert-box.
     2109           undo, return error.
     2110         end.
     2111     end.
     2112   end.
     2113   END PROCEDURE.
