     1358   define variable loc#log as logical   no-undo .
     1359   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   do:
     1361     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1362       (input  g#db-num
     1363       ,input  g#userid
     1364       ,input  0
     1365       ,input  'actn_nakl-par_lookup':U
