        1   block-level on error undo, throw.
        2   using ibs.th.gbl.sys.objsrv.
        3   define variable ObjSrv as class objsrv no-undo.
        4   define new global shared variable g#libobj  as handle no-undo .
        5   procedure GetObjServ:
        6     define input-output parameter objServ as class objsrv no-undo.
        7     if not valid-object (ObjSrv)
        8     then do:
        9       ObjSrv = new objsrv().
       10       ObjSrv:Initialization().
       11     end.
       12     else do:
       13      find first sys-ctrl no-lock.
       14      if     available sys-ctrl
       15         and sys-ctrl.whole-send-news ne ObjSrv:upd
       16      then
       17         ObjSrv:RefrashObject(sys-ctrl.whole-send-news).
       18      release sys-ctrl.
       19     end.
       20     objServ = ObjSrv.
       21   end.
       22   on delete of this-procedure do:
       23     if valid-object (ObjSrv)
       24       then delete object ObjSrv.
       25     assign
       26       g#libobj = ?
       27     .
       28   end.
       29   main:
       30   do:
       31     if valid-handle (g#libobj)
       32     and g#libobj <> this-procedure :handle
       33     then do:
       34       message
       35         "Попытка повторной загрузки библиотеки" skip
       36         g#libobj skip
       37         g#libobj :type skip
       38         g#libobj :file-name skip
       39         valid-handle(g#libobj) skip
       40         this-procedure :handle skip
       41         this-procedure :type skip
       42         this-procedure :file-name skip
       43         valid-handle(this-procedure) skip
       44         view-as alert-box error .
       45       undo, return error return-value .
       46     end.
       47     else do:
       48       assign
       49         g#libobj = this-procedure :handle
       50       .
       51     end.
       52     if this-procedure :persistent <> true
       53     then do:
       54       message
       55         "Ошибка запуска библиотеки" program-name(1) skip
       56         "Попытка запустить ее как обычную процедуру" skip
       57         view-as alert-box error .
       58     end.
       59   end.
