      599       MENU-ITEM m-ed-date2-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      600       .
      601     if date-b :POPUP-MENU in frame get-rep = ?
      602     then do:
      603       ASSIGN
      604         date-b :POPUP-MENU in frame get-rep = MENU m-ed-date2 :HANDLE
      605         date-b :MENU-MOUSE in frame get-rep = 3
      606       .
      607     end.
      608     define variable v-label-handle2 as handle no-undo .
      609     assign
      610       v-label-handle2 = date-b :side-label-handle in frame get-rep
      611     .
      612     if valid-handle (v-label-handle2)
      613     then do:
      614       if v-label-handle2 :tooltip = ""
      615       or v-label-handle2 :tooltip = ?
      616       then do:
      617         assign
      618           v-label-handle2 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      619         .
      620       end.
      621     end.
      622     ON CHOOSE OF MENU-ITEM m-ed-date2-1 in menu m-ed-date2 DO:
      623       apply "ctrl-b":U to date-b in frame get-rep .
      624     END.
      625     ON CHOOSE OF MENU-ITEM m-ed-date2-2 in menu m-ed-date2 DO:
      626       apply "ctrl-d":U to date-b in frame get-rep .
      627     END.
      628     ON CHOOSE OF MENU-ITEM m-ed-date2-3 in menu m-ed-date2 DO:
      629       apply "ctrl-e":U to date-b in frame get-rep .
      630     END.
      631     ON CHOOSE OF MENU-ITEM m-ed-date2-4 in menu m-ed-date2 DO:
      632       apply "ctrl-f":U to date-b in frame get-rep .
      633     END.
      634   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   on ' ' of date-e in frame get-rep
      636   do:
      637     if (can-query (self, "sensitive")
      638        and
      639        self :sensitive = true
      640        )
      641     or (can-query (self, "read-only")
      642        and
      643        self :read-only = false
      644        )
      645     then do:
      646       assign
      647         self :screen-value = ?
      648       .
      649     end.
      650     return no-apply.
      651   end.
      652   on delete-character of date-e in frame get-rep
      653   do:
      654     if (can-query (self, "sensitive")
      655        and
      656        self :sensitive = true
      657        )
      658     or (can-query (self, "read-only")
      659        and
      660        self :read-only = false
      661        )
      662     then do:
      663       assign
      664         self :screen-value = ?
      665       .
      666     end.
      667     return no-apply.
      668   end.
      669   on ctrl-d of date-e in frame get-rep
      670   do:
      671     define variable v-curr-sv-date as date no-undo .
      672     if (can-query (self, "sensitive")
      673        and
      674        self :sensitive = true
      675        )
      676     or (can-query (self, "read-only")
      677        and
      678        self :read-only = false
      679        )
      680     then do:
      681       if self :handle <> focus :handle
      682       then do:
      683         apply "entry":u to self .
      684       end.
      685       run gbl/getcurdt.p
      686         (output v-curr-sv-date
      687         ) .
      688       assign
      689         self :screen-value = string(v-curr-sv-date) .
      690       .
      691     end.
      692     return no-apply.
      693   end.
      694   on ctrl-b of date-e in frame get-rep
      695   do:
      696     if (can-query (self, "sensitive")
      697        and
      698        self :sensitive = true
      699        )
      700     or (can-query (self, "read-only")
      701        and
      702        self :read-only = false
      703        )
      704     then do:
      705       if self :handle <> focus :handle
      706       then do:
      707         apply "entry":u to self .
      708       end.
      709       define variable v-curr-sv-date as date no-undo .
      710       define variable v-new-sv-date  as date no-undo .
      711       assign
      712         v-curr-sv-date = date(self :screen-value) no-error
      713       .
      714       if v-curr-sv-date = ?
      715       then do:
      716         run gbl/getcurdt.p
      717           (output v-curr-sv-date
      718           ) .
      719       end.
      720       if v-curr-sv-date <> ?
      721       then do:
      722         assign
      723           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      724         .
      725         assign
      726           self :screen-value = string(v-new-sv-date) .
      727         .
      728       end.
      729     end.
      730     return no-apply .
      731   end.
      732   on ctrl-e of date-e in frame get-rep
      733   do:
      734     if (can-query (self, "sensitive")
      735        and
      736        self :sensitive = true
      737        )
      738     or (can-query (self, "read-only")
      739        and
      740        self :read-only = false
      741        )
      742     then do:
      743       if self :handle <> focus :handle
      744       then do:
      745         apply "entry":u to self .
      746       end.
      747       define variable v-curr-sv-date as date no-undo .
      748       define variable v-new-sv-date  as date no-undo .
      749       assign
      750         v-curr-sv-date = date(self :screen-value) no-error
      751       .
      752       if v-curr-sv-date = ?
      753       then do:
      754         run gbl/getcurdt.p
      755           (output v-curr-sv-date
      756           ) .
      757       end.
      758       if v-curr-sv-date <> ?
      759       then do:
      760         run gbl/lastdate.p
      761           (input  v-curr-sv-date
      762           ,output v-new-sv-date
      763           ).
      764         assign
      765           self :screen-value = string(v-new-sv-date) .
      766         .
      767       end.
      768     end.
      769     return no-apply .
      770   end.
      771   on ctrl-f of date-e in frame get-rep
      772   do:
      773     if (can-query (self, "sensitive")
      774        and
      775        self :sensitive = true
      776        )
      777     or (can-query (self, "read-only")
      778        and
      779        self :read-only = false
      780        )
      781     then do:
      782       if self :handle <> focus :handle
      783       then do:
      784         apply "entry":u to self .
      785       end.
      786       define variable v-ok            as logical   no-undo .
      787       define variable v-curr-sv-date  as date      no-undo .
      788       define variable v-description   as character no-undo .
      789       assign
      790         v-curr-sv-date = date(self :screen-value) no-error
      791       .
      792       if v-curr-sv-date = ?
      793       then do:
      794         run gbl/getcurdt.p
      795           (output v-curr-sv-date
      796           ) .
      797       end.
      798       if v-curr-sv-date <> ?
      799       then do:
      800         run gbl/d-inpday.w
      801           (input ?
      802           ,input "Выбор даты"
      803           ,input v-description
      804           ,input ""
      805           ,input-output v-curr-sv-date
      806           ,output v-ok
      807           ).
      808         if v-ok = true
      809         then do:
      810           assign
      811             self :screen-value = string(v-curr-sv-date) .
      812           .
      813         end.
      814       end.
      815     end.
      816     return no-apply .
      817   end.
      818     define MENU m-ed-date4
      819       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      820       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      821       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      822       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      823       .
      824     if date-e :POPUP-MENU in frame get-rep = ?
      825     then do:
      826       ASSIGN
      827         date-e :POPUP-MENU in frame get-rep = MENU m-ed-date4 :HANDLE
      828         date-e :MENU-MOUSE in frame get-rep = 3
      829       .
      830     end.
      831     define variable v-label-handle4 as handle no-undo .
      832     assign
      833       v-label-handle4 = date-e :side-label-handle in frame get-rep
      834     .
      835     if valid-handle (v-label-handle4)
      836     then do:
      837       if v-label-handle4 :tooltip = ""
      838       or v-label-handle4 :tooltip = ?
      839       then do:
      840         assign
      841           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      842         .
      843       end.
      844     end.
      845     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      846       apply "ctrl-b":U to date-e in frame get-rep .
      847     END.
      848     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      849       apply "ctrl-d":U to date-e in frame get-rep .
      850     END.
      851     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      852       apply "ctrl-e":U to date-e in frame get-rep .
      853     END.
      854     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      855       apply "ctrl-f":U to date-e in frame get-rep .
      856     END.
      857   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   on help of frame get-rep
      859   do:
      860     run gbl/app_help.p
      861       (input this-procedure :file-name
      862       ,input ''
      863       ,input ?
      864       ) no-error.
      865     if error-status :error then do:
      866       message
      867         "Ошибка при вызове помощи"
      868         error-status :get-message(1)
      869         view-as alert-box .
      870     end.
      871   end.
      872   run minbtn-set in this-procedure .
      873   on choose of b-help in frame get-rep
      874   do:
      875     apply "help":u to frame get-rep .
      876   end.
      877   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   procedure minbtn-set :
      879       do
      880           on error undo, return error return-value
      881           :
      882           define variable ii              as integer       no-undo .
      883           define variable fh              as widget-handle no-undo .
      884           define variable hh              as widget-handle no-undo .
      885           define variable v-h             as handle        extent 4 no-undo .
      886           define variable v-name-button   as character     no-undo .
      887           define variable v-help-old-x    as decimal       no-undo .
      888           define variable v-help-old-y    as decimal       no-undo .
      889           define variable v-help-old-size as decimal       no-undo .
      890           define variable v-frame-width   as decimal       no-undo .
      891           define variable jj              as integer       no-undo .
      892           do
      893               on error undo, return error
      894               :
      895               assign
      896                   v-frame-width = frame get-rep:width - 0.3
      897                   fh            = frame get-rep:first-child
      898                   hh            = fh:first-child
      899                   ii            = 1
      900                   .
      901               do while valid-handle(hh):
      902                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      903                   do:
      904                       case lc(hh:name) :
      905                           when "b-help" then
      906                               do:
      907                                   hh:load-image-up("cmp/b-help.bmp":u) .
      908                                   hh:load-image-down("cmp/b-help.bmp":u) .
      909                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      910                                   hh:TOOLTIP = "Помощь" .
      911                                   v-help-old-x = hh:column .
      912                                   v-help-old-y = hh:row    .
      913                                   v-help-old-size = hh:width .
      914                                   hh:width-chars = 2.5 .
      915                               end.
      916                           when "b-print" then
      917                               do:
      918                                   hh:load-image("cmp/b-print.bmp":u) .
      919                                   hh:TOOLTIP = "Печать" .
      920                                   v-h[ii] = hh:handle .
      921                                   ii = ii + 1 .
      922                                   hh:width-chars = 3 .
      923                               end.
      924                           when "b-history" or
      925                           when "b-hist" then
      926                               do:
      927                                   hh:load-image("cmp/b-hist.bmp":u) .
      928                                   hh:TOOLTIP = "История" .
      929                                   v-h[ii] = hh:handle .
      930                                   ii = ii + 1 .
      931                                   hh:width-chars = 3 .
      932                               end.
      933                           when "b-sch" then
      934                               do:
      935                                   hh:load-image("cmp/b-sch.bmp":u) .
      936                                   hh:TOOLTIP = "Установка Фильтра" .
      937                                   v-h[ii] = hh:handle .
      938                                   ii = ii + 1 .
      939                                   hh:width-chars = 3 .
      940                               end.
      941                           when "b-hist-user" then
      942                               do:
      943                                   hh:load-image("cmp/b-hist.bmp":u) .
      944                                   hh:TOOLTIP = "История пользователя" .
      945                                   ii = ii + 1 .
      946                               end.
      947                       end case.
      948                   end.
      949                   hh = hh:next-sibling.
      950               end.
      951               b-help:column = v-frame-width - b-help:width-chars.
      952               jj = 0.
      953               repeat ii = 4 to 1 by -1 :
      954                   if valid-handle (v-h[ii] ) then
      955                   do:
      956                       jj  = jj + 1 .
      957                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      958                       v-h[ii]:row    = v-help-old-y .
      959                   end.
      960               end.
      961           end.
      962       end.
      963   end procedure.
      964   MAIN-BLOCK:
      965   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      966      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      967      define variable v-time  as integer   no-undo.
      968     if p-from-date = ? OR p-to-date = ?
      969     then do:
      970         run cur-time in this-procedure ( output p-to-date
      971                                        , output v-time
      972                                        ).
      973         assign
      974             p-from-date = date( month( p-to-date ), 01, year( p-to-date ))
      975         .
      976     end.
      977     assign
      978         date-b = p-from-date
      979         date-e = p-to-date
      980         .
      981     RUN enable_UI.
      982     APPLY "ENTRY" TO date-b IN FRAME get-rep.
      983     WAIT-FOR GO OF FRAME get-rep.
      984   END.
      985   RUN disable_UI.
      986   PROCEDURE disable_UI :
      987     HIDE FRAME get-rep.
      988   END PROCEDURE.
      989   PROCEDURE enable_UI :
      990     DISPLAY date-e date-b
      991         WITH FRAME get-rep.
      992     ENABLE b-ok RECT-3 b-quit b-help date-e date-b
      993         WITH FRAME get-rep.
      994   END PROCEDURE.
