        1   DEFINE OUTPUT PARAMETER is-ok AS LOGICAL INITIAL FALSE NO-UNDO.
        2   define input-output parameter p-from-date as date no-undo .
        3   define input-output parameter p-to-date as date no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Задание диапазона дат: начало - конец".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   procedure cur-time :
      117      define output parameter p-today as date      no-undo .
      118      define output parameter p-time  as integer   no-undo .
      119     do
      120     on error undo, return error
      121     :
      122       define variable v-date1 as date      no-undo .
      123       define variable v-date2 as date      no-undo .
      124       define variable v-time  as integer   no-undo .
      125       assign
      126         v-date1 = today
      127         v-time  = time
      128         v-date2 = today
      129       .
      130       if v-date1 <> v-date2
      131       then do:
      132         assign
      133           v-date1 = today
      134           v-time  = v-time
      135         .
      136       end.
      137       assign
      138         p-today = v-date1
      139         p-time  = v-time
      140       .
      141     end.
      142   end.
      143   function cur-time-date returns character
      144   :
      145     return string(today, '99/99/9999':U) .
      146   end.
      147   function cur-time-mjd returns decimal
      148   :
      149     define variable v-date as date      no-undo .
      150     define variable v-time as integer   no-undo .
      151     run cur-time in this-procedure
      152       (output v-date
      153       ,output v-time
      154       ) .
      155     return integer(v-date) - 2400002 + (v-time / 86400) .
      156   end.
      157   function cur-time-get-ending-index returns integer
      158   (input p-number as integer
      159   )
      160   :
      161     if p-number < 0
      162     or p-number = ?
      163     then do:
      164       return 1 .
      165     end.
      166     define variable v-rest as integer   no-undo .
      167     assign
      168       p-number = p-number modulo 100
      169     .
      170     if p-number < 20
      171     then do:
      172       assign
      173         v-rest = p-number
      174       .
      175     end.
      176     else do:
      177       assign
      178         v-rest = p-number modulo 10
      179       .
      180     end.
      181     case v-rest :
      182       when 1
      183       then do:
      184         return 2 .
      185       end.
      186       when 2 or
      187       when 3 or
      188       when 4
      189       then do:
      190         return 3 .
      191       end.
      192       otherwise do:
      193         return 1 .
      194       end.
      195     end case .
      196   end.
      197   procedure cur-time-mjd-to-date :
      198      define input  parameter i-mjd-diff as decimal no-undo.
      199      define output parameter o-Date     as date    no-undo.
      200      define output parameter o-Time     as integer no-undo.
      201      define variable v-day-number as integer   no-undo .
      202      if    i-mjd-diff < 0
      203         or i-mjd-diff = ?
      204      then do:
      205         return "?" .
      206      end.
      207      assign
      208         v-day-number = truncate(i-mjd-diff,0).
      209         o-Date = date(v-day-number + 2400002).
      210         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      211     .
      212   end.
      213   function cur-time-mjd-to-string returns character
      214   (input p-mjd-diff as decimal
      215   )
      216   :
      217     define variable v-day-number as integer   no-undo .
      218     define variable v-seconds    as integer   no-undo .
      219     define variable v-hour       as integer   no-undo .
      220     define variable v-min        as integer   no-undo .
      221     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      222     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      223     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      224     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      225     if p-mjd-diff < 0
      226     or p-mjd-diff = ?
      227     then do:
      228       return "?" .
      229     end.
      230     assign
      231       v-day-number = integer(truncate(p-mjd-diff,0))
      232       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      233     .
      234     if v-seconds > 86400
      235     then do:
      236       assign
      237         v-seconds = 86400 - 1
      238       .
      239     end.
      240     if v-seconds < 0
      241     then do:
      242       assign
      243         v-seconds = 0
      244       .
      245     end.
      246     assign
      247       v-hour = truncate(v-seconds / 3600, 0)
      248     .
      249     assign
      250       v-seconds = v-seconds modulo 3600
      251     .
      252     assign
      253       v-min = truncate(v-seconds / 60, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 60
      257     .
      258     return
      259         (if v-day-number <> 0
      260           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      261           else ""
      262         )
      263       + (if v-day-number <> 0 or v-hour <> 0
      264           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      265           else ""
      266         )
      267       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      268           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      269           else ""
      270         )
      271       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      272       .
      273   end.
      274   function cur-time-string returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-string-sec returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      293   end.
      294   function cur-time-custom  returns character
      295   (input p-prefix as character
      296   ,input p-date-format as character
      297   ,input p-delimiter as character
      298   ,input p-time-format as character
      299   ,input p-suffix as character
      300   )
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return
      309       p-prefix
      310       + string(v-date, p-date-format)
      311       + p-delimiter
      312       + string(v-time, p-time-format)
      313       + p-suffix
      314       .
      315   end.
      316   function cur-time-print  returns character
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      325   end.
      326   function cur-time-datetime returns datetime
      327   :
      328     define variable v-char as character no-undo .
      329     define variable v-datetime as datetime no-undo .
      330     v-char = cur-time-string().
      331     v-datetime = datetime(v-char).
      332     return  v-datetime.
      333   end.
      334   function cur-time-string-msec returns character
      335   :
      336     define variable v-date as datetime  no-undo .
      337     v-date = now.
      338     return string(v-date) .
      339   end.
      340   DEFINE BUTTON b-help DEFAULT
      341        LABEL "Помо&щь"
      342        SIZE 12 BY 1
      343        BGCOLOR 8 .
      344   DEFINE BUTTON b-ok AUTO-GO DEFAULT
      345        LABEL "&Ввод "
      346        SIZE 12 BY 1
      347        BGCOLOR 8 .
      348   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      349        LABEL "&Отмена"
      350        SIZE 12 BY 1
      351        BGCOLOR 8 .
      352   DEFINE VARIABLE date-b AS DATE FORMAT "99/99/9999":U
      353        LABEL "С"
      354        VIEW-AS FILL-IN
      355        SIZE 11 BY 1 NO-UNDO.
      356   DEFINE VARIABLE date-e AS DATE FORMAT "99/99/9999":U
      357        LABEL "По"
      358        VIEW-AS FILL-IN
      359        SIZE 11 BY 1 NO-UNDO.
      360   DEFINE RECTANGLE RECT-3
      361        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      362        SIZE 36 BY 2.67.
      363   DEFINE FRAME get-rep
      364        b-ok AT ROW 1 COL 1
      365        b-quit AT ROW 1 COL 13
      366        b-help AT ROW 1 COL 25
      367        date-e AT ROW 3.33 COL 21.5 COLON-ALIGNED
      368        date-b AT ROW 3.38 COL 4 COLON-ALIGNED
      369        RECT-3 AT ROW 2.5 COL 1
      370        SPACE(0.49) SKIP(0.24)
      371       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      372            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      373            TITLE "Задайте период"
      374            CANCEL-BUTTON b-quit.
      375   ASSIGN
      376          FRAME get-rep:SCROLLABLE       = FALSE.
      377   ON CHOOSE OF b-ok IN FRAME get-rep
      378   DO:
      379       assign
      380           date-b
      381           date-e
      382           .
      383       if date-e < date-b then
      384           do:
      385               message "Дата начала периода не может быть больше даты окончания!" view-as alert-box ERROR.
      386               APPLY "ENTRY" TO date-b IN FRAME get-rep.
      387               return no-apply.
      388           end.
      389       else
      390           do:
      391               assign
      392                   p-from-date = date-b
      393                   p-to-date = date-e
      394                   is-ok = yes
      395                   .
      396           end.
      397   END.
      398   ON RETURN OF date-b IN FRAME get-rep
      399   DO:
      400       APPLY "ENTRY" TO date-e IN FRAME get-rep.
      401       RETURN NO-APPLY.
      402   END.
      403   ON RETURN OF date-e IN FRAME get-rep
      404   DO:
      405       APPLY "CHOOSE" TO b-ok IN FRAME get-rep.
      406       RETURN NO-APPLY.
      407   END.
      408   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME get-rep:PARENT eq ?
      409   THEN FRAME get-rep:PARENT = ACTIVE-WINDOW.
      410   ON WINDOW-CLOSE OF FRAME get-rep APPLY "END-ERROR":U TO SELF.
      411   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   on ' ' of date-b in frame get-rep
      413   do:
      414     if (can-query (self, "sensitive")
      415        and
      416        self :sensitive = true
      417        )
      418     or (can-query (self, "read-only")
      419        and
      420        self :read-only = false
      421        )
      422     then do:
      423       assign
      424         self :screen-value = ?
      425       .
      426     end.
      427     return no-apply.
      428   end.
      429   on delete-character of date-b in frame get-rep
      430   do:
      431     if (can-query (self, "sensitive")
      432        and
      433        self :sensitive = true
      434        )
      435     or (can-query (self, "read-only")
      436        and
      437        self :read-only = false
      438        )
      439     then do:
      440       assign
      441         self :screen-value = ?
      442       .
      443     end.
      444     return no-apply.
      445   end.
      446   on ctrl-d of date-b in frame get-rep
      447   do:
      448     define variable v-curr-sv-date as date no-undo .
      449     if (can-query (self, "sensitive")
      450        and
      451        self :sensitive = true
      452        )
      453     or (can-query (self, "read-only")
      454        and
      455        self :read-only = false
      456        )
      457     then do:
      458       if self :handle <> focus :handle
      459       then do:
      460         apply "entry":u to self .
      461       end.
      462       run gbl/getcurdt.p
      463         (output v-curr-sv-date
      464         ) .
      465       assign
      466         self :screen-value = string(v-curr-sv-date) .
      467       .
      468     end.
      469     return no-apply.
      470   end.
      471   on ctrl-b of date-b in frame get-rep
      472   do:
      473     if (can-query (self, "sensitive")
      474        and
      475        self :sensitive = true
      476        )
      477     or (can-query (self, "read-only")
      478        and
      479        self :read-only = false
      480        )
      481     then do:
      482       if self :handle <> focus :handle
      483       then do:
      484         apply "entry":u to self .
      485       end.
      486       define variable v-curr-sv-date as date no-undo .
      487       define variable v-new-sv-date  as date no-undo .
      488       assign
      489         v-curr-sv-date = date(self :screen-value) no-error
      490       .
      491       if v-curr-sv-date = ?
      492       then do:
      493         run gbl/getcurdt.p
      494           (output v-curr-sv-date
      495           ) .
      496       end.
      497       if v-curr-sv-date <> ?
      498       then do:
      499         assign
      500           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      501         .
      502         assign
      503           self :screen-value = string(v-new-sv-date) .
      504         .
      505       end.
      506     end.
      507     return no-apply .
      508   end.
      509   on ctrl-e of date-b in frame get-rep
      510   do:
      511     if (can-query (self, "sensitive")
      512        and
      513        self :sensitive = true
      514        )
      515     or (can-query (self, "read-only")
      516        and
      517        self :read-only = false
      518        )
      519     then do:
      520       if self :handle <> focus :handle
      521       then do:
      522         apply "entry":u to self .
      523       end.
      524       define variable v-curr-sv-date as date no-undo .
      525       define variable v-new-sv-date  as date no-undo .
      526       assign
      527         v-curr-sv-date = date(self :screen-value) no-error
      528       .
      529       if v-curr-sv-date = ?
      530       then do:
      531         run gbl/getcurdt.p
      532           (output v-curr-sv-date
      533           ) .
      534       end.
      535       if v-curr-sv-date <> ?
      536       then do:
      537         run gbl/lastdate.p
      538           (input  v-curr-sv-date
      539           ,output v-new-sv-date
      540           ).
      541         assign
      542           self :screen-value = string(v-new-sv-date) .
      543         .
      544       end.
      545     end.
      546     return no-apply .
      547   end.
      548   on ctrl-f of date-b in frame get-rep
      549   do:
      550     if (can-query (self, "sensitive")
      551        and
      552        self :sensitive = true
      553        )
      554     or (can-query (self, "read-only")
      555        and
      556        self :read-only = false
      557        )
      558     then do:
      559       if self :handle <> focus :handle
      560       then do:
      561         apply "entry":u to self .
      562       end.
      563       define variable v-ok            as logical   no-undo .
      564       define variable v-curr-sv-date  as date      no-undo .
      565       define variable v-description   as character no-undo .
      566       assign
      567         v-curr-sv-date = date(self :screen-value) no-error
      568       .
      569       if v-curr-sv-date = ?
      570       then do:
      571         run gbl/getcurdt.p
      572           (output v-curr-sv-date
      573           ) .
      574       end.
      575       if v-curr-sv-date <> ?
      576       then do:
      577         run gbl/d-inpday.w
      578           (input ?
      579           ,input "Выбор даты"
      580           ,input v-description
      581           ,input ""
      582           ,input-output v-curr-sv-date
      583           ,output v-ok
      584           ).
      585         if v-ok = true
      586         then do:
      587           assign
      588             self :screen-value = string(v-curr-sv-date) .
      589           .
      590         end.
      591       end.
      592     end.
      593     return no-apply .
      594   end.
      595     define MENU m-ed-date2
      596       MENU-ITEM m-ed-date2-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      597       MENU-ITEM m-ed-date2-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
