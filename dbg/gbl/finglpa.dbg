      899   add-conn-avt:label = entry(2,v-label,":") .
      900   I-add-conn-avt:private-data = v-tooltip-code .
      901   run thbjattr_tooltip in this-procedure (
      902                input   'fin-global':U
      903               ,input  "del-conn-avt"
      904               ,output v-tooltip
      905               ,output v-label
      906               ,output v-tooltip-code
      907               ) no-error .
      908                               .
      909   del-conn-avt:label = entry(2,v-label,":") .
      910   I-del-conn-avt:private-data = v-tooltip-code .
      911   run thbjattr_tooltip in this-procedure (
      912                input   'fin-global':U
      913               ,input  "fo-gen"
      914               ,output v-tooltip
      915               ,output v-label
      916               ,output v-tooltip-code
      917               ) no-error .
      918   v-fo-gen:screen-value = entry(2,v-label,":") .
      919   I-fo-gen:private-data = v-tooltip-code .
      920   END PROCEDURE.
      921   PROCEDURE init-proc :
      922   define variable v-i as integer   no-undo .
      923   define variable v-value-character as character no-undo .
      924   define variable v-value-date as date no-undo .
      925   define variable v-value-decimal as decimal no-undo .
      926   define variable v-value-integer as INTEGER no-undo .
      927   define variable v-value-logical AS LOGICAL no-undo .
      928   define variable v-type as character no-undo .
      929   define variable v-value as character no-undo .
      930   define variable v-found as decimal   no-undo .
      931     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      932       find first buf_thbj-attr exclusive-lock where
      933                 buf_thbj-attr.obj-type = ""
      934           and   buf_thbj-attr.obj-code = 0
      935           and   buf_thbj-attr.upper-prop-code = 'fin-global':U
      936           and   buf_thbj-attr.prop-code = '':u no-wait no-error.
      937        if locked buf_thbj-attr then do:
      938           message
      939           vss-workfile vss-revision vss-description skip
      940           'fin-global':U skip
      941           "Запись Глобальных ПАРАМЕТРОВ для взаиморасчетов  занята"
      942           view-as alert-box error .
      943           undo, return error.
      944         end.
      945     end.
      946     else do:
      947       find first buf_thbj-attr no-lock where
      948             buf_thbj-attr.obj-type = ""
      949       and   buf_thbj-attr.obj-code = 0
      950       and   buf_thbj-attr.upper-prop-code = 'fin-global':U
      951       and   buf_thbj-attr.prop-code = '':u no-error.
      952     end.
      953     if not available buf_thbj-attr then do:
      954       assign
      955         v-to-create  = true
      956         .
      957       message
      958       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
      959                   chr(10))
      960                    view-as alert-box warning.
      961     end.
      962     run fill-widgets in this-procedure no-error.
      963     if error-status:error then undo, return error.
      964     apply "value-changed":u to fo-buyer-nws in frame Dialog-Frame.
      965     if p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      966        disable fo-buyer-nws
      967                fo-supp-nws
      968                fo-fact
      969                fo-mc-mode
      970                add-conn-avt
      971                del-conn-avt
      972                            fo-gen-ord
      973                fo-gen-nakl
      974                fo-nakl-status_
      975                with frame Dialog-Frame.
      976        B-exit:label = "Вы&ход"  .
      977        hide B-quit in frame Dialog-Frame .
      978        if not fo-gen-nakl then hide fo-nakl-status_ v-stat-text in frame Dialog-Frame .
      979        else v-stat-text:FGCOLOR = 7 .
      980     END.
      981   end procedure.
      982   PROCEDURE init-tt :
      983   END PROCEDURE.
      984   PROCEDURE save-proc :
      985   define variable v-value-character as character no-undo .
      986   define variable v-value-date as date no-undo .
      987   define variable v-value-decimal as decimal no-undo .
      988   define variable v-value-integer as INTEGER no-undo .
      989   define variable v-value-logical AS LOGICAL no-undo .
      990   define variable v-trf-type like ub.clients.obj-type no-undo .
      991   define variable v-trf-code like ub.clients.obj-code no-undo .
      992   define variable v-param-type as character no-undo .
      993   define variable wh as widget-handle no-undo .
      994   define variable fh as widget-handle no-undo .
      995   define variable v-same as logical no-undo .
      996   IF p-mode = 'ПРОСМОТР':U THEN RETURN .
      997   define variable loc#log as logical   no-undo .
      998   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   do:
     1000     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1001       (input  g#db-num
     1002       ,input  g#userid
     1003       ,input  0
     1004       ,input  'actn_global-fin_update':U
     1005       ,input  'global':U
     1006       ,input  0
     1007       ,input  '':U
     1008       ,input  0
     1009       ,input  0
     1010       ,input  0
     1011       ,input  0
     1012       ,input  true
     1013       ,output loc#log
     1014       )  .
     1015   end.
     1016     if loc#log <> yes then do: return error. end.
     1017   ASSIGN
     1018       fo-buyer-nws  FRAME Dialog-Frame
     1019       fo-supp-nws
     1020       fo-fact
     1021       fo-mc-mode
     1022       add-conn-avt
     1023       del-conn-avt
     1024       fo-gen-ord
     1025       fo-gen-nakl
     1026       fo-nakl-status_
     1027       .
     1028    assign
     1029       fh = frame Dialog-Frame:first-child
     1030       wh = fh:first-child
     1031       .
     1032   do while valid-handle(wh):
     1033     if wh:private-data begins "recid=" then do:
     1034       find first thbjattr_thbj-attr-fin where
     1035                 recid(thbjattr_thbj-attr-fin) = integer(entry(2, wh:private-data, '=')).
     1036       assign
     1037       buffer thbjattr_thbj-attr-fin:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1038              thbjattr_thbj-attr-fin.obj-type = p-obj-type.
     1039              thbjattr_thbj-attr-fin.obj-code = p-obj-code.
     1040     end.
     1041     wh = wh:next-sibling.
     1042   end.
     1043   find first thbjattr_thbj-attr-fin where thbjattr_thbj-attr-fin.prop-code = 'fo-gen':U .
     1044              thbjattr_thbj-attr-fin.obj-type = p-obj-type.
     1045              thbjattr_thbj-attr-fin.obj-code = p-obj-code.
     1046   if      not fo-gen-ord and not fo-gen-nakl             then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 0 .
     1047   else if     fo-gen-ord and not fo-gen-nakl             then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 1 .
     1048   else if not fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "накл +"
     1049                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 2 .
     1050   else if     fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "накл +"
     1051                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 3 .
     1052   else if not fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "разр"
     1053                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 4 .
     1054   else if     fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "разр"
     1055                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 5 .
     1056   else if not fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "факт"
     1057                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 6 .
     1058   else if     fo-gen-ord and     fo-gen-nakl and fo-nakl-status_ = "факт"
     1059                                                          then assign buffer thbjattr_thbj-attr-fin:buffer-field("property-value-integer"):buffer-value = 7 .
     1060   v-same = yes.
     1061   for each thbjattr_thbj-attr-fin,
     1062       first temp-thbj-attr where
     1063             temp-thbj-attr.obj-type = thbjattr_thbj-attr-fin.obj-type
     1064         and temp-thbj-attr.obj-code = thbjattr_thbj-attr-fin.obj-code
     1065         and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr-fin.upper-prop-code
     1066         and temp-thbj-attr.prop-code = thbjattr_thbj-attr-fin.prop-code:
     1067      buffer-compare
     1068      thbjattr_thbj-attr-fin
     1069      to temp-thbj-attr
     1070      save result in v-same.
     1071      if not v-same then leave.
     1072   end.
     1073   do TRANSACTION
     1074   on error undo, return error return-value
     1075   :
     1076     run thbjattr_set-section in this-procedure (
     1077          input ""
     1078         ,input 0
     1079         ,input 'fin-global':U
     1080         ,input table thbjattr_thbj-attr-fin
     1081     ) no-error.
     1082     if error-status:error then do:
     1083       message error-status:get-message(1)  skip
     1084       return-value
     1085       view-as alert-box.
     1086       undo, return error.
     1087     end.
     1088   end.
     1089   END PROCEDURE.
