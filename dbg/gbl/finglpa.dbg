      518        LABEL "Накладных"
      519        VIEW-AS TOGGLE-BOX
      520        SIZE 15.25 BY .79
      521        FGCOLOR 4  NO-UNDO.
      522   DEFINE VARIABLE fo-gen-ord AS LOGICAL INITIAL no
      523        LABEL "Заказов"
      524        VIEW-AS TOGGLE-BOX
      525        SIZE 80 BY .79
      526        FGCOLOR 4  NO-UNDO.
      527   DEFINE FRAME Dialog-Frame
      528        B-exit AT ROW 1 COL 1
      529        B-quit AT ROW 1 COL 11
      530        B-Help AT ROW 1 COL 74.5
      531        fo-buyer-nws AT ROW 3 COL 4.75 NO-LABEL WIDGET-ID 2
      532        fo-supp-nws AT ROW 6 COL 4.75 NO-LABEL WIDGET-ID 12
      533        fo-fact AT ROW 8.58 COL 5 WIDGET-ID 38
      534        fo-mc-mode AT ROW 11.5 COL 5 NO-LABEL WIDGET-ID 44
      535        add-conn-avt AT ROW 14.25 COL 5.5 WIDGET-ID 38
      536        del-conn-avt AT ROW 15.92 COL 5.5 WIDGET-ID 38
      537        fo-gen-ord AT ROW 18.46 COL 5.5 WIDGET-ID 60
      538        fo-nakl-status_ AT ROW 19.25 COL 25.88 COLON-ALIGNED NO-LABEL WIDGET-ID 64
      539        fo-gen-nakl AT ROW 19.42 COL 5.5 WIDGET-ID 62
      540        v-fo-buyer-nws AT ROW 2.25 COL 1.5 NO-LABEL WIDGET-ID 6
      541        v-fo-supp-nws AT ROW 5.25 COL 1.5 NO-LABEL WIDGET-ID 18
      542        v-fo-mc-mode AT ROW 10.25 COL 1.5 NO-LABEL WIDGET-ID 40
      543        v-fo-gen AT ROW 17.25 COL 1.75 NO-LABEL WIDGET-ID 70
      544        v-stat-text AT ROW 19.46 COL 15.75 COLON-ALIGNED NO-LABEL WIDGET-ID 68
      545        I-fo-buyer-nws AT ROW 2.96 COL 1 WIDGET-ID 10
      546        I-fo-supp-nws AT ROW 6 COL 1 WIDGET-ID 34
      547        I-fo-fact AT ROW 8.58 COL 1 WIDGET-ID 36
      548        I-add-conn-avt AT ROW 14.25 COL 1.5 WIDGET-ID 36
      549        I-del-conn-avt AT ROW 15.92 COL 1.5 WIDGET-ID 36
      550        I-fo-mc-mode AT ROW 11.25 COL 1 WIDGET-ID 42
      551        I-fo-gen AT ROW 18.42 COL 1 WIDGET-ID 58
      552        SPACE(83.12) SKIP(0.53)
      553       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      554            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      555            TITLE "Настройки для блока Взаиморасчеты"
      556            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit WIDGET-ID 100.
      557   ASSIGN
      558          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      559          FRAME Dialog-Frame:HIDDEN           = TRUE.
      560   ASSIGN
      561          v-fo-buyer-nws:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      562   ASSIGN
      563          v-fo-gen:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      564   ASSIGN
      565          v-fo-mc-mode:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      566   ASSIGN
      567          v-fo-supp-nws:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      568   ASSIGN
      569          v-stat-text:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      570   ON GO OF FRAME Dialog-Frame
      571   DO:
      572     run save-proc in this-procedure no-error.
      573     if error-status :error then return no-apply.
      574   END.
      575   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      576   DO:
      577     APPLY "END-ERROR":U TO SELF.
      578   END.
      579   ON VALUE-CHANGED OF fo-gen-nakl IN FRAME Dialog-Frame
      580   DO:
      581     IF fo-gen-nakl:SCREEN-VALUE = "yes" THEN DO :
      582        enable  fo-nakl-status_ v-stat-text with frame Dialog-Frame .
      583        display fo-nakl-status_ v-stat-text with frame Dialog-Frame .
      584     end.
      585     ELSE HIDE fo-nakl-status_ v-stat-text in frame Dialog-Frame .
      586   END.
      587   ON MOUSE-SELECT-CLICK OF I-add-conn-avt IN FRAME Dialog-Frame
      588   DO:
      589     MESSAGE I-add-conn-avt:private-data  VIEW-AS ALERT-BOX INFORMATION.
      590   END.
      591   ON MOUSE-SELECT-CLICK OF I-del-conn-avt IN FRAME Dialog-Frame
      592   DO:
      593     MESSAGE I-del-conn-avt:private-data  VIEW-AS ALERT-BOX INFORMATION.
      594   END.
      595   ON MOUSE-SELECT-CLICK OF I-fo-buyer-nws IN FRAME Dialog-Frame
      596   DO:
      597     MESSAGE I-fo-buyer-nws:private-data  VIEW-AS ALERT-BOX INFORMATION.
      598   END.
      599   ON MOUSE-SELECT-CLICK OF I-fo-fact IN FRAME Dialog-Frame
      600   DO:
      601     MESSAGE I-fo-fact:private-data  VIEW-AS ALERT-BOX INFORMATION.
      602   END.
      603   ON MOUSE-SELECT-CLICK OF I-fo-gen IN FRAME Dialog-Frame
