      613     MESSAGE I-fo-supp-nws:private-data  VIEW-AS ALERT-BOX INFORMATION.
      614   END.
      615   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      616   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      617   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   on help of frame Dialog-Frame
      619   do:
      620     run gbl/app_help.p
      621       (input this-procedure :file-name
      622       ,input ''
      623       ,input ?
      624       ) no-error.
      625     if error-status :error then do:
      626       message
      627         "Ошибка при вызове помощи"
      628         error-status :get-message(1)
      629         view-as alert-box .
      630     end.
      631   end.
      632   run minbtn-set in this-procedure .
      633   on choose of b-help in frame Dialog-Frame
      634   do:
      635     apply "help":u to frame Dialog-Frame .
      636   end.
      637   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   procedure minbtn-set :
      639       do
      640           on error undo, return error return-value
      641           :
      642           define variable ii              as integer       no-undo .
      643           define variable fh              as widget-handle no-undo .
      644           define variable hh              as widget-handle no-undo .
      645           define variable v-h             as handle        extent 4 no-undo .
      646           define variable v-name-button   as character     no-undo .
      647           define variable v-help-old-x    as decimal       no-undo .
      648           define variable v-help-old-y    as decimal       no-undo .
      649           define variable v-help-old-size as decimal       no-undo .
      650           define variable v-frame-width   as decimal       no-undo .
      651           define variable jj              as integer       no-undo .
      652           do
      653               on error undo, return error
      654               :
      655               assign
      656                   v-frame-width = frame Dialog-Frame:width - 0.3
      657                   fh            = frame Dialog-Frame:first-child
      658                   hh            = fh:first-child
      659                   ii            = 1
      660                   .
      661               do while valid-handle(hh):
      662                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      663                   do:
      664                       case lc(hh:name) :
      665                           when "b-help" then
      666                               do:
      667                                   hh:load-image-up("cmp/b-help.bmp":u) .
      668                                   hh:load-image-down("cmp/b-help.bmp":u) .
      669                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      670                                   hh:TOOLTIP = "Помощь" .
      671                                   v-help-old-x = hh:column .
      672                                   v-help-old-y = hh:row    .
      673                                   v-help-old-size = hh:width .
      674                                   hh:width-chars = 2.5 .
      675                               end.
      676                           when "b-print" then
      677                               do:
      678                                   hh:load-image("cmp/b-print.bmp":u) .
      679                                   hh:TOOLTIP = "Печать" .
      680                                   v-h[ii] = hh:handle .
      681                                   ii = ii + 1 .
      682                                   hh:width-chars = 3 .
      683                               end.
      684                           when "b-history" or
      685                           when "b-hist" then
      686                               do:
      687                                   hh:load-image("cmp/b-hist.bmp":u) .
      688                                   hh:TOOLTIP = "История" .
      689                                   v-h[ii] = hh:handle .
      690                                   ii = ii + 1 .
      691                                   hh:width-chars = 3 .
      692                               end.
      693                           when "b-sch" then
      694                               do:
      695                                   hh:load-image("cmp/b-sch.bmp":u) .
      696                                   hh:TOOLTIP = "Установка Фильтра" .
      697                                   v-h[ii] = hh:handle .
      698                                   ii = ii + 1 .
      699                                   hh:width-chars = 3 .
      700                               end.
      701                           when "b-hist-user" then
      702                               do:
      703                                   hh:load-image("cmp/b-hist.bmp":u) .
      704                                   hh:TOOLTIP = "История пользователя" .
      705                                   ii = ii + 1 .
      706                               end.
      707                       end case.
      708                   end.
      709                   hh = hh:next-sibling.
      710               end.
      711               b-help:column = v-frame-width - b-help:width-chars.
      712               jj = 0.
      713               repeat ii = 4 to 1 by -1 :
      714                   if valid-handle (v-h[ii] ) then
      715                   do:
      716                       jj  = jj + 1 .
      717                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      718                       v-h[ii]:row    = v-help-old-y .
      719                   end.
      720               end.
      721           end.
      722       end.
      723   end procedure.
      724   MAIN-BLOCK:
      725   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      726      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      727   define variable loc#log as logical   no-undo .
      728   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      729   do:
      730     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      731       (input  g#db-num
      732       ,input  g#userid
      733       ,input  0
      734       ,input  'actn_global-fin_lookup':U
      735       ,input  'global':U
      736       ,input  0
      737       ,input  '':U
      738       ,input  0
      739       ,input  0
      740       ,input  0
      741       ,input  0
      742       ,input  true
      743       ,output loc#log
      744       )  .
      745   end.
      746     if loc#log <> yes then do: return error. end.
      747       RUN init-tt.
      748       RUN enable_UI.
      749       RUN init-proc.
      750     WAIT-FOR GO OF FRAME Dialog-Frame.
      751   END.
      752   RUN disable_UI.
      753   PROCEDURE disable_UI :
      754     HIDE FRAME Dialog-Frame.
      755   END PROCEDURE.
      756   PROCEDURE enable_UI :
      757     DISPLAY fo-buyer-nws fo-supp-nws fo-fact fo-mc-mode add-conn-avt del-conn-avt
      758             fo-gen-ord fo-nakl-status_ fo-gen-nakl v-fo-buyer-nws v-fo-supp-nws
      759             v-fo-mc-mode v-fo-gen v-stat-text
      760         WITH FRAME Dialog-Frame.
      761     ENABLE B-exit B-quit B-Help I-fo-buyer-nws I-fo-supp-nws I-fo-fact
      762            I-add-conn-avt I-del-conn-avt I-fo-mc-mode I-fo-gen fo-buyer-nws
      763            fo-supp-nws fo-fact fo-mc-mode add-conn-avt del-conn-avt fo-gen-ord
      764            fo-nakl-status_ fo-gen-nakl v-fo-buyer-nws v-fo-supp-nws v-fo-mc-mode
      765            v-fo-gen v-stat-text
      766         WITH FRAME Dialog-Frame.
      767     VIEW FRAME Dialog-Frame.
      768   END PROCEDURE.
      769   PROCEDURE fill-widgets :
      770   define variable v-value-character as character no-undo .
      771   define variable v-value-date as date no-undo .
      772   define variable v-value-decimal as decimal no-undo .
      773   define variable v-value-integer as INTEGER no-undo .
      774   define variable v-value-logical AS LOGICAL no-undo .
      775   define variable v-param-type as character no-undo .
      776   define variable v-param-value as character no-undo .
      777   for each thbjattr_thbj-attr-fin:
      778     delete thbjattr_thbj-attr-fin.
      779   end.
      780   for each temp-thbj-attr:
      781     delete temp-thbj-attr.
      782   end.
      783   run adm/shattri.p (
      784       input "init":U
      785     , input ""
      786     , input 0
      787     , input 'fin-global':U
      788     , input "":U
      789     , output v-value-character
      790     , output v-value-date
      791     , output v-value-decimal
      792     , output v-value-integer
      793     , output v-value-logical
      794     , output v-param-type
      795     , input-output TABLE-HANDLE v-tth-abc
      796     ) no-error .
      797   if error-status:error
      798   and not available buf_thbj-attr then do:
      799     message
      800     "Не удалось получить начальные значения настроек" skip
      801     error-status:get-message(1) return-value
      802     view-as alert-box error .
      803     undo, return error .
      804   end.
      805   FOR EACH thbjattr_thbj-attr-fin:
      806     IF thbjattr_thbj-attr-fin.prop-code = 'fo-buyer-nws':U THEN DO:
      807        fo-buyer-nws = thbjattr_thbj-attr-fin.property-value-integer.
      808        fo-buyer-nws:PRIVATE-DATA IN FRAME Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      809        display fo-buyer-nws with frame Dialog-Frame .
      810     END.
      811     IF thbjattr_thbj-attr-fin.prop-code = 'fo-supp-nws':U THEN DO:
      812        fo-supp-nws = thbjattr_thbj-attr-fin.property-value-integer.
      813        fo-supp-nws:private-data = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      814        display fo-supp-nws with frame Dialog-Frame .
      815     END.
      816     IF thbjattr_thbj-attr-fin.prop-code = 'fo-fact':U THEN DO:
      817        fo-fact = thbjattr_thbj-attr-fin.property-value-logical.
      818        fo-fact:private-data = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      819        display fo-fact with frame Dialog-Frame .
      820     END.
      821     IF thbjattr_thbj-attr-fin.prop-code = 'fo-mc-mode':U THEN DO:
      822        fo-mc-mode = thbjattr_thbj-attr-fin.property-value-integer.
      823        fo-mc-mode:private-data = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      824        display fo-mc-mode with frame Dialog-Frame .
      825     END.
      826     IF thbjattr_thbj-attr-fin.prop-code = 'add-conn-avt':U THEN DO:
      827        add-conn-avt = thbjattr_thbj-attr-fin.property-value-logical.
      828        add-conn-avt:private-data = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      829        display add-conn-avt with frame Dialog-Frame .
      830     END.
      831     IF thbjattr_thbj-attr-fin.prop-code = 'del-conn-avt':U THEN DO:
      832        del-conn-avt = thbjattr_thbj-attr-fin.property-value-logical.
      833        del-conn-avt:private-data = "recid=" + string(recid(thbjattr_thbj-attr-fin)).
      834        display del-conn-avt with frame Dialog-Frame .
      835     END.
      836     IF thbjattr_thbj-attr-fin.prop-code = 'fo-gen':U THEN DO:
      837        fo-gen-ord = if ((thbjattr_thbj-attr-fin.property-value-integer + 1) MODULO 2 = 0) then true else false.
      838        display fo-gen-ord with frame Dialog-Frame .
      839        fo-gen-nakl = if (thbjattr_thbj-attr-fin.property-value-integer >= 2) then true else false.
      840        display fo-gen-nakl with frame Dialog-Frame .
      841             if (thbjattr_thbj-attr-fin.property-value-integer = 2 or thbjattr_thbj-attr-fin.property-value-integer = 3) then fo-nakl-status_ = "накл +".
      842        else if (thbjattr_thbj-attr-fin.property-value-integer = 4 or thbjattr_thbj-attr-fin.property-value-integer = 5) then fo-nakl-status_ = "разр"  .
      843        else if (thbjattr_thbj-attr-fin.property-value-integer = 6 or thbjattr_thbj-attr-fin.property-value-integer = 7) then fo-nakl-status_ = "факт"  .
      844        display fo-nakl-status_ with frame Dialog-Frame .
      845             if (thbjattr_thbj-attr-fin.property-value-integer = 0 or thbjattr_thbj-attr-fin.property-value-integer = 1) then
      846                                       hide v-stat-text fo-nakl-status_ in frame Dialog-Frame .
      847     END.
      848     create temp-thbj-attr.
      849     buffer-copy thbjattr_thbj-attr-fin to temp-thbj-attr.
      850   END.
      851   define variable v-tooltip as character no-undo .
