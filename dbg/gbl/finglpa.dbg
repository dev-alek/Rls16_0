      890   I-fo-mc-mode:private-data = v-tooltip-code .
      891   run thbjattr_tooltip in this-procedure (
      892                input   'fin-global':U
      893               ,input  "add-conn-avt"
      894               ,output v-tooltip
      895               ,output v-label
      896               ,output v-tooltip-code
      897               ) no-error .
