      459         VIEW-AS TEXT
      460        SIZE 81 BY .67
      461        FGCOLOR 4  NO-UNDO.
      462   DEFINE VARIABLE v-stat-text AS CHARACTER FORMAT "X(256)":U INITIAL "в статусе"
