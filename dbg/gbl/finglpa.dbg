      506        LABEL ""
      507        VIEW-AS TOGGLE-BOX
      508        SIZE 80 BY .83 NO-UNDO.
      509   DEFINE VARIABLE del-conn-avt AS LOGICAL INITIAL no
      510        LABEL ""
      511        VIEW-AS TOGGLE-BOX
      512        SIZE 80 BY .83 NO-UNDO.
