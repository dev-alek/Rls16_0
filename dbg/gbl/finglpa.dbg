      472        FILENAME "cmp/info.bmp":U
      473        SIZE 3 BY 2.04.
      474   DEFINE IMAGE I-fo-fact
      475        FILENAME "cmp/info.bmp":U
      476        SIZE 3 BY .75.
      477   DEFINE IMAGE I-fo-gen
      478        FILENAME "cmp/info.bmp":U
      479        SIZE 3 BY 1.75.
      480   DEFINE IMAGE I-fo-mc-mode
      481        FILENAME "cmp/info.bmp":U
      482        SIZE 3 BY 2.04.
      483   DEFINE IMAGE I-fo-supp-nws
      484        FILENAME "cmp/info.bmp":U
      485        SIZE 3 BY 1.75.
      486   DEFINE VARIABLE fo-buyer-nws AS INTEGER
      487        VIEW-AS RADIO-SET VERTICAL
      488        RADIO-BUTTONS
      489             "Создаются на активной стороне", 0,
      490   "Только в ГБД", 1
      491        SIZE 33.75 BY 2 NO-UNDO.
      492   DEFINE VARIABLE fo-mc-mode AS INTEGER
