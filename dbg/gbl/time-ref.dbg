        1   DEFINE OUTPUT PARAMETER vhour as integer NO-UNDO.
        2   DEFINE OUTPUT PARAMETER vmin as integer NO-UNDO.
        3   def var vss-revision    as character no-undo init "$Revision$":u .
        4   def var vss-author      as character no-undo init "$Author$":u .
        5   def var vss-date        as character no-undo init "$Date$":u .
        6   def var vss-workfile    as character no-undo init "$Workfile$":u .
        7   def var vss-archive     as character no-undo init "$Archive$":u .
        8   def var vss-description as character no-undo init "Партии товаров с двумя ед измерения" .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   procedure proc-alt-shift-f2:
       64     if not ibs.th.gbl.gbl-var:rcode
       65   then
       66     run gbl\inidebug.p .
       67   end.
       68   procedure proc-alt-shift-f3:
       69     run gbl/prvssinf.p
       70       ( input this-procedure
       71       ) .
       72   end.
       73   define variable v-inform-launched as logical no-undo initial false .
       74   procedure proc-alt-shift-f4:
       75     define variable v-action as character no-undo .
       76     if v-inform-launched = false then do:
       77       assign
       78         v-inform-launched = true
       79       .
       80       run gbl/d-inform.w
       81         (  input self
       82         ,  input this-procedure
       83         , output v-action
       84         ) no-error .
       85       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       86       assign
       87         v-inform-launched = false
       88       .
       89     end.
       90   end.
       91   procedure proc-alt-f1:
       92     run gbl/corrhelp.p
       93       (input this-procedure
       94       ) .
       95   end .
       96   on alt-shift-f2 anywhere do:
       97     run proc-alt-shift-f2.
       98   end.
       99   on alt-shift-f3 anywhere do:
      100     run proc-alt-shift-f3 in this-procedure .
      101   end.
      102   on alt-shift-f4 anywhere do:
      103     run proc-alt-shift-f4 in this-procedure.
      104   end.
      105   on alt-f1 anywhere do:
      106     run proc-alt-f1 in this-procedure .
      107   end.
      108   DEFINE BUTTON B-exit AUTO-GO
      109        LABEL "&Ввод"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON B-Help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-quit AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE ch-colon AS CHARACTER FORMAT "X(1)":U INITIAL ":"
      121         VIEW-AS TEXT
      122        SIZE 2 BY 1 NO-UNDO.
      123   DEFINE VARIABLE FILL-hour AS INTEGER FORMAT "99":U INITIAL 0
      124        VIEW-AS FILL-IN
      125        SIZE 4 BY 1 NO-UNDO.
      126   DEFINE VARIABLE FILL-min AS INTEGER FORMAT "99":U INITIAL 0
      127        VIEW-AS FILL-IN
      128        SIZE 4 BY 1 NO-UNDO.
      129   DEFINE FRAME Dialog-Frame
      130        B-exit AT ROW 1 COL 1.13
      131        b-quit AT ROW 1 COL 11.13
      132        B-Help AT ROW 1 COL 21
      133        FILL-hour AT ROW 3.5 COL 5.88 COLON-ALIGNED NO-LABEL
      134        FILL-min AT ROW 3.54 COL 13.88 COLON-ALIGNED NO-LABEL
      135        ch-colon AT ROW 3.54 COL 11 COLON-ALIGNED NO-LABEL
      136        SPACE(16.74) SKIP(1.08)
      137       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      138            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      139            TITLE "Введите время"
      140            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      141   ASSIGN
      142          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      143          FRAME Dialog-Frame:HIDDEN           = TRUE.
      144   ON GO OF FRAME Dialog-Frame
      145   DO:
      146     assign
      147     vhour = fill-hour
      148     vmin = fill-min
      149     .
      150   END.
      151   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      152   DO:
      153     APPLY "END-ERROR":U TO SELF.
      154   END.
      155   ON LEAVE OF FILL-hour IN FRAME Dialog-Frame
      156   DO:
      157     ASSIGN FILL-HOUR.
      158     if fill-hour > 23 then do:
      159       BELL.
      160       RETURN NO-APPLY.
      161     end.
      162   END.
      163   ON LEAVE OF FILL-min IN FRAME Dialog-Frame
      164   DO:
      165       ASSIGN FILL-min.
      166     if fill-min > 59 then do:
      167       BELL.
      168       RETURN NO-APPLY.
      169     end.
      170   END.
      171   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      172   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      173   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   on help of frame Dialog-Frame
      175   do:
      176     run gbl/app_help.p
      177       (input this-procedure :file-name
      178       ,input ''
      179       ,input ?
      180       ) no-error.
      181     if error-status :error then do:
      182       message
      183         "Ошибка при вызове помощи"
      184         error-status :get-message(1)
      185         view-as alert-box .
      186     end.
      187   end.
      188   run minbtn-set in this-procedure .
      189   on choose of b-help in frame Dialog-Frame
      190   do:
      191     apply "help":u to frame Dialog-Frame .
      192   end.
      193   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   procedure minbtn-set :
      195       do
      196           on error undo, return error return-value
      197           :
      198           define variable ii              as integer       no-undo .
      199           define variable fh              as widget-handle no-undo .
      200           define variable hh              as widget-handle no-undo .
      201           define variable v-h             as handle        extent 4 no-undo .
      202           define variable v-name-button   as character     no-undo .
      203           define variable v-help-old-x    as decimal       no-undo .
      204           define variable v-help-old-y    as decimal       no-undo .
      205           define variable v-help-old-size as decimal       no-undo .
      206           define variable v-frame-width   as decimal       no-undo .
      207           define variable jj              as integer       no-undo .
      208           do
      209               on error undo, return error
      210               :
      211               assign
      212                   v-frame-width = frame Dialog-Frame:width - 0.3
      213                   fh            = frame Dialog-Frame:first-child
      214                   hh            = fh:first-child
      215                   ii            = 1
      216                   .
      217               do while valid-handle(hh):
      218                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      219                   do:
      220                       case lc(hh:name) :
      221                           when "b-help" then
      222                               do:
      223                                   hh:load-image-up("cmp/b-help.bmp":u) .
      224                                   hh:load-image-down("cmp/b-help.bmp":u) .
      225                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      226                                   hh:TOOLTIP = "Помощь" .
      227                                   v-help-old-x = hh:column .
      228                                   v-help-old-y = hh:row    .
      229                                   v-help-old-size = hh:width .
      230                                   hh:width-chars = 2.5 .
      231                               end.
      232                           when "b-print" then
      233                               do:
      234                                   hh:load-image("cmp/b-print.bmp":u) .
      235                                   hh:TOOLTIP = "Печать" .
      236                                   v-h[ii] = hh:handle .
      237                                   ii = ii + 1 .
      238                                   hh:width-chars = 3 .
      239                               end.
      240                           when "b-history" or
      241                           when "b-hist" then
      242                               do:
      243                                   hh:load-image("cmp/b-hist.bmp":u) .
      244                                   hh:TOOLTIP = "История" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-sch" then
      250                               do:
      251                                   hh:load-image("cmp/b-sch.bmp":u) .
      252                                   hh:TOOLTIP = "Установка Фильтра" .
      253                                   v-h[ii] = hh:handle .
      254                                   ii = ii + 1 .
      255                                   hh:width-chars = 3 .
      256                               end.
      257                           when "b-hist-user" then
      258                               do:
      259                                   hh:load-image("cmp/b-hist.bmp":u) .
      260                                   hh:TOOLTIP = "История пользователя" .
      261                                   ii = ii + 1 .
      262                               end.
      263                       end case.
      264                   end.
      265                   hh = hh:next-sibling.
      266               end.
      267               b-help:column = v-frame-width - b-help:width-chars.
      268               jj = 0.
      269               repeat ii = 4 to 1 by -1 :
      270                   if valid-handle (v-h[ii] ) then
      271                   do:
      272                       jj  = jj + 1 .
      273                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      274                       v-h[ii]:row    = v-help-old-y .
      275                   end.
      276               end.
      277           end.
      278       end.
      279   end procedure.
      280   MAIN-BLOCK:
      281   DO ON ERROR    UNDO MAIN-BLOCK, return error
      282         ON STOP       UNDO MAIN-BLOCK, return error
      283         ON END-KEY UNDO MAIN-BLOCK, return error :
      284     RUN enable_UI.
      285     APPLY "ENTRY" to FILL-hour.
      286     WAIT-FOR GO OF FRAME Dialog-Frame.
      287   END.
      288   RUN disable_UI.
      289   PROCEDURE disable_UI :
      290     HIDE FRAME Dialog-Frame.
      291   END PROCEDURE.
      292   PROCEDURE enable_UI :
      293     DISPLAY FILL-hour FILL-min ch-colon
      294         WITH FRAME Dialog-Frame.
      295     ENABLE B-exit b-quit B-Help FILL-hour FILL-min ch-colon
      296         WITH FRAME Dialog-Frame.
      297     VIEW FRAME Dialog-Frame.
      298   END PROCEDURE.
