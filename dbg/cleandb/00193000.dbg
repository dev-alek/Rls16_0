        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 17/09/2025":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00193000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00193000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога чистки БД.".
        8   define buffer wth-doc for ub.wth-doc.
        9   define buffer buf_wth-doc for ub.wth-doc.
       10   define stream LogStream.
       11   on delete of ub.wth-doc   override do: end.
       12   define new global shared variable g#language as character no-undo .
       13   if g#language <> '' and g#language <> 'rus':U then do:
       14     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       15   end.
       16   define input parameter vardate-actual-docs    as date      no-undo.
       17   define input parameter varcall-back           as handle no-undo.
       18   define variable vDeleted as int64     no-undo.
       19   define variable vResult  as character no-undo.
       20   define buffer buf_clients for ub.clients.
       21   find ub.sys-ctrl no-lock.
       22   if not available ub.sys-ctrl then do:
       23      return error "Не найдена уникальная запись sys-ctrl.".
       24   end.
       25   for each buf_clients no-lock
       26      where buf_clients.db-num <> ?
       27   :
       28     for each wth-doc no-lock where
       29              wth-doc.host-code = buf_clients.host-code
       30          and wth-doc.obj-type  = buf_clients.obj-type
       31          and wth-doc.obj-code  = buf_clients.obj-code
       32          and wth-doc.status_   = 'факт':U
       33          and wth-doc.fact-date < vardate-actual-docs
       34     use-index stat-fact
       35     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       36     :
       37       run cleanTables in this-procedure.
       38       find first buf_wth-doc exclusive-lock where
       39              recid(buf_wth-doc) = recid(wth-doc) no-error no-wait.
       40   if not avail buf_wth-doc then
       41   do:
       42     undo, return error "Ошибка удаления wth-doc. Запись занята другим пользователем.".
       43   end.
       44   delete buf_wth-doc.
       45   vDeleted = vDeleted + 1.
       46     end.
       47   end.
       48   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Мат. ценности", vDeleted).
       49   return vResult.
       50   procedure cleanTables :
       51       define buffer wth-doc-attr for ub.wth-doc-attr.
       52   on delete of ub.wth-doc-attr override do: end.
       53   for each wth-doc-attr exclusive-lock
       54        where wth-doc-attr.doc-code = wth-doc.doc-code
       55   on error undo, return error
       56   :
       57         delete wth-doc-attr no-error.
       58         if error-status:error then
       59           undo, return error error-status:get-message(1).
       60         vDeleted = vDeleted + 1.
       61   end.
       62       define buffer wth-line for ub.wth-line.
       63   on delete of ub.wth-line override do: end.
       64   for each wth-line exclusive-lock
       65        where wth-line.doc-code = wth-doc.doc-code
       66   on error undo, return error
       67   :
       68         delete wth-line no-error.
       69         if error-status:error then
       70           undo, return error error-status:get-message(1).
       71         vDeleted = vDeleted + 1.
       72   end.
       73       define buffer wth-line-attr for ub.wth-line-attr.
       74   on delete of ub.wth-line-attr override do: end.
       75   for each wth-line-attr exclusive-lock
       76        where wth-line-attr.doc-code = wth-doc.doc-code
       77   on error undo, return error
       78   :
       79         delete wth-line-attr no-error.
       80         if error-status:error then
       81           undo, return error error-status:get-message(1).
       82         vDeleted = vDeleted + 1.
       83   end.
       84       define buffer wth-dtl for ub.wth-dtl.
       85   on delete of ub.wth-dtl override do: end.
       86   for each wth-dtl exclusive-lock
       87        where wth-dtl.doc-code = wth-doc.doc-code
       88   on error undo, return error
       89   :
       90         delete wth-dtl no-error.
       91         if error-status:error then
       92           undo, return error error-status:get-message(1).
       93         vDeleted = vDeleted + 1.
       94   end.
       95       define buffer wth-dtl-attr for ub.wth-dtl-attr.
       96   on delete of ub.wth-dtl-attr override do: end.
       97   for each wth-dtl-attr exclusive-lock
       98        where wth-dtl-attr.doc-code = wth-doc.doc-code
       99   on error undo, return error
      100   :
      101         delete wth-dtl-attr no-error.
      102         if error-status:error then
      103           undo, return error error-status:get-message(1).
      104         vDeleted = vDeleted + 1.
      105   end.
      106       define buffer wth-parts for ub.wth-parts.
      107   on delete of ub.wth-parts override do: end.
      108   for each wth-parts exclusive-lock
      109        where wth-parts.out-code = wth-doc.doc-code
      110   on error undo, return error
      111   :
      112         delete wth-parts no-error.
      113         if error-status:error then
      114           undo, return error error-status:get-message(1).
      115         vDeleted = vDeleted + 1.
      116   end.
      117       define buffer chk-doc for ub.chk-doc.
      118   on delete of ub.chk-doc override do: end.
      119   for each chk-doc exclusive-lock
      120        where chk-doc.out-code = wth-doc.doc-code
      121   on error undo, return error
      122   :
      123         delete chk-doc no-error.
      124         if error-status:error then
      125           undo, return error error-status:get-message(1).
      126         vDeleted = vDeleted + 1.
      127   end.
      128       define buffer c-chk-doc for ub.c-chk-doc.
      129   on delete of ub.c-chk-doc override do: end.
      130   for each c-chk-doc exclusive-lock
      131        where c-chk-doc.out-code = wth-doc.doc-code
      132   on error undo, return error
      133   :
      134         delete c-chk-doc no-error.
      135         if error-status:error then
      136           undo, return error error-status:get-message(1).
      137         vDeleted = vDeleted + 1.
      138   end.
      139       define buffer chk-doc-attr for ub.chk-doc-attr.
      140   on delete of ub.chk-doc-attr override do: end.
      141   for each chk-doc-attr exclusive-lock
      142        where chk-doc-attr.out-code = wth-doc.doc-code
      143   on error undo, return error
      144   :
      145         delete chk-doc-attr no-error.
      146         if error-status:error then
      147           undo, return error error-status:get-message(1).
      148         vDeleted = vDeleted + 1.
      149   end.
      150       define buffer c-chk-doc-attr for ub.c-chk-doc-attr.
      151   on delete of ub.c-chk-doc-attr override do: end.
      152   for each c-chk-doc-attr exclusive-lock
      153        where c-chk-doc-attr.out-code = wth-doc.doc-code
      154   on error undo, return error
      155   :
      156         delete c-chk-doc-attr no-error.
      157         if error-status:error then
      158           undo, return error error-status:get-message(1).
      159         vDeleted = vDeleted + 1.
      160   end.
      161       define buffer chk-pay for ub.chk-pay.
      162   on delete of ub.chk-pay override do: end.
      163   for each chk-pay exclusive-lock
      164        where chk-pay.out-code = wth-doc.doc-code
      165   on error undo, return error
      166   :
      167         delete chk-pay no-error.
      168         if error-status:error then
      169           undo, return error error-status:get-message(1).
      170         vDeleted = vDeleted + 1.
      171   end.
      172       define buffer c-chk-pay for ub.c-chk-pay.
      173   on delete of ub.c-chk-pay override do: end.
      174   for each c-chk-pay exclusive-lock
      175        where c-chk-pay.out-code = wth-doc.doc-code
      176   on error undo, return error
      177   :
      178         delete c-chk-pay no-error.
      179         if error-status:error then
      180           undo, return error error-status:get-message(1).
      181         vDeleted = vDeleted + 1.
      182   end.
      183       define buffer chk-pay-attr for ub.chk-pay-attr.
      184   on delete of ub.chk-pay-attr override do: end.
      185   for each chk-pay-attr exclusive-lock
      186        where chk-pay-attr.out-code = wth-doc.doc-code
      187   on error undo, return error
      188   :
      189         delete chk-pay-attr no-error.
      190         if error-status:error then
      191           undo, return error error-status:get-message(1).
      192         vDeleted = vDeleted + 1.
      193   end.
      194       define buffer doc-attr for ub.doc-attr.
      195   on delete of ub.doc-attr override do: end.
      196   for each doc-attr exclusive-lock
      197        where doc-attr.doc-code = wth-doc.doc-code
      198   on error undo, return error
      199   :
      200         delete doc-attr no-error.
      201         if error-status:error then
      202           undo, return error error-status:get-message(1).
      203         vDeleted = vDeleted + 1.
      204   end.
      205       define buffer c-doc-attr for ub.c-doc-attr.
      206   on delete of ub.c-doc-attr override do: end.
      207   for each c-doc-attr exclusive-lock
      208        where c-doc-attr.doc-code = wth-doc.doc-code
      209   on error undo, return error
      210   :
      211         delete c-doc-attr no-error.
      212         if error-status:error then
      213           undo, return error error-status:get-message(1).
      214         vDeleted = vDeleted + 1.
      215   end.
      216       define buffer c-wth-doc for ub.c-wth-doc.
      217   on delete of ub.c-wth-doc override do: end.
      218   for each c-wth-doc exclusive-lock
      219        where c-wth-doc.doc-code = wth-doc.doc-code
      220   on error undo, return error
      221   :
      222         delete c-wth-doc no-error.
      223         if error-status:error then
      224           undo, return error error-status:get-message(1).
      225         vDeleted = vDeleted + 1.
      226   end.
      227       define buffer c-wth-line for ub.c-wth-line.
      228   on delete of ub.c-wth-line override do: end.
      229   for each c-wth-line exclusive-lock
      230        where c-wth-line.doc-code = wth-doc.doc-code
      231   on error undo, return error
      232   :
      233         delete c-wth-line no-error.
      234         if error-status:error then
      235           undo, return error error-status:get-message(1).
      236         vDeleted = vDeleted + 1.
      237   end.
      238       define buffer c-wth-dtl     for ub.c-wth-dtl.
      239       on delete of ub.c-wth-dtl    override do: end.
      240       for each c-wth-dtl exclusive-lock
      241          where c-wth-dtl.doc-code         = wth-doc.doc-code
      242       on error undo, return error
      243       :
      244         define buffer c-wth-parts for ub.c-wth-parts.
      245   on delete of ub.c-wth-parts override do: end.
      246   for each c-wth-parts exclusive-lock
      247       where c-wth-parts.obj-type = wth-doc.obj-type
      248              and c-wth-parts.obj-code = wth-doc.obj-code
      249              and c-wth-parts.w-p-code = c-wth-dtl.w-p-code
      250              and c-wth-parts.wth-code = c-wth-dtl.wth-code
      251              and c-wth-parts.par-code = c-wth-dtl.par-code
      252              and c-wth-parts.out-code = wth-doc.doc-code
      253   on error undo, return error
      254   :
      255         delete c-wth-parts no-error.
      256         if error-status:error then
      257           undo, return error error-status:get-message(1).
      258         vDeleted = vDeleted + 1.
      259   end.
      260         delete c-wth-dtl.
      261         vDeleted = vDeleted + 1.
      262       end.
      263   end procedure.
