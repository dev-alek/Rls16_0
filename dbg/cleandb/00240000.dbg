        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 03/10/2025":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00240000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00240000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога чистки БД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer schet-fact-doc     for ub.schet-fact-doc.
       22   define buffer buf_schet-fact-doc for ub.schet-fact-doc.
       23   on delete of ub.schet-fact-doc override do: end.
       24   for each buf_clients no-lock where
       25            buf_clients.db-num <> ?
       26   :
       27     for each schet-fact-doc no-lock where
       28             schet-fact-doc.obj-type  = buf_clients.obj-type
       29         and schet-fact-doc.obj-code  = buf_clients.obj-code
       30         and schet-fact-doc.fact-date < vardate-actual-docs
       31     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       32     :
       33       run cleanTables in this-procedure.
       34       find first buf_schet-fact-doc exclusive-lock where
       35              recid(buf_schet-fact-doc) = recid(schet-fact-doc) no-error no-wait.
       36   if not avail buf_schet-fact-doc then
       37   do:
       38     undo, return error "Ошибка удаления schet-fact-doc. Запись занята другим пользователем.".
       39   end.
       40   delete buf_schet-fact-doc.
       41   vDeleted = vDeleted + 1.
       42     end.
       43   end.
       44   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Счета-фактуры с историей", vDeleted).
       45   return vResult.
       46   procedure cleanTables :
       47     define buffer factur-connect           for ub.factur-connect.
       48     define buffer factur-connect-attr      for ub.factur-connect-attr.
       49     define buffer factur-connect-line      for ub.factur-connect-line.
       50     define buffer factur-connect-line-attr for ub.factur-connect-line-attr.
       51     on delete of ub.factur-connect               override do: end.
       52     on delete of ub.factur-connect-attr          override do: end.
       53     on delete of ub.factur-connect-line          override do: end.
       54     on delete of ub.factur-connect-line-attr     override do: end.
       55     define buffer schet-fact-doc-attr for ub.schet-fact-doc-attr.
       56   on delete of ub.schet-fact-doc-attr override do: end.
       57   for each schet-fact-doc-attr exclusive-lock
       58        where schet-fact-doc-attr.doc-code = schet-fact-doc.doc-code and schet-fact-doc-attr.db-num   = schet-fact-doc.db-num
       59   on error undo, return error
       60   :
       61         delete schet-fact-doc-attr no-error.
       62         if error-status:error then
       63           undo, return error error-status:get-message(1).
       64         vDeleted = vDeleted + 1.
       65   end.
       66     define buffer schet-fact-line for ub.schet-fact-line.
       67   on delete of ub.schet-fact-line override do: end.
       68   for each schet-fact-line exclusive-lock
       69        where schet-fact-line.doc-code = schet-fact-doc.doc-code and schet-fact-line.db-num   = schet-fact-doc.db-num
       70   on error undo, return error
       71   :
       72         delete schet-fact-line no-error.
       73         if error-status:error then
       74           undo, return error error-status:get-message(1).
       75         vDeleted = vDeleted + 1.
       76   end.
       77     define buffer c-schet-fact-line for ub.c-schet-fact-line.
       78   on delete of ub.c-schet-fact-line override do: end.
       79   for each c-schet-fact-line exclusive-lock
       80        where c-schet-fact-line.doc-code = schet-fact-doc.doc-code and c-schet-fact-line.db-num   = schet-fact-doc.db-num
       81   on error undo, return error
       82   :
       83         delete c-schet-fact-line no-error.
       84         if error-status:error then
       85           undo, return error error-status:get-message(1).
       86         vDeleted = vDeleted + 1.
       87   end.
       88     define buffer schet-fact-line-attr for ub.schet-fact-line-attr.
       89   on delete of ub.schet-fact-line-attr override do: end.
       90   for each schet-fact-line-attr exclusive-lock
       91        where schet-fact-line-attr.doc-code = schet-fact-doc.doc-code and schet-fact-line-attr.db-num   = schet-fact-doc.db-num
       92   on error undo, return error
       93   :
       94         delete schet-fact-line-attr no-error.
       95         if error-status:error then
       96           undo, return error error-status:get-message(1).
       97         vDeleted = vDeleted + 1.
       98   end.
       99     define buffer c-schet-fact-doc for ub.c-schet-fact-doc.
      100   on delete of ub.c-schet-fact-doc override do: end.
      101   for each c-schet-fact-doc exclusive-lock
      102        where c-schet-fact-doc.doc-code = schet-fact-doc.doc-code and c-schet-fact-doc.db-num   = schet-fact-doc.db-num
      103   on error undo, return error
      104   :
      105         delete c-schet-fact-doc no-error.
      106         if error-status:error then
      107           undo, return error error-status:get-message(1).
      108         vDeleted = vDeleted + 1.
      109   end.
      110     for each factur-connect exclusive-lock where
      111              factur-connect.factur-doc-code = schet-fact-doc.doc-code
      112          and factur-connect.db-num          = schet-fact-doc.db-num
      113     :
      114       for each factur-connect-attr exclusive-lock where
      115                factur-connect-attr.db-num       = factur-connect.db-num
      116            and factur-connect-attr.connect-code = factur-connect.connect-code
      117       :
      118         delete factur-connect-attr.
      119         vDeleted = vDeleted + 1.
      120       end.
      121       for each factur-connect-line exclusive-lock where
      122                factur-connect-line.db-num       =  factur-connect.db-num
      123            and factur-connect-line.connect-code = factur-connect.connect-code
      124       :
      125         delete factur-connect-line.
      126         vDeleted = vDeleted + 1.
      127       end.
      128       for each factur-connect-line-attr exclusive-lock where
      129                factur-connect-line-attr.db-num       =  factur-connect.db-num
      130            and factur-connect-line-attr.connect-code = factur-connect.connect-code
      131       :
      132         delete factur-connect-line-attr.
      133         vDeleted = vDeleted + 1.
      134       end.
      135       delete factur-connect.
      136       vDeleted = vDeleted + 1.
      137     end.
      138   end procedure.
