      168     define buffer doc-pl     for ub.doc-pl.
      169     on delete of ub.doc-pl  override do: end.
      170     for each doc-pl exclusive-lock where
      171              doc-pl.out-code = trn-doc.doc-code
      172     :
      173       define buffer c-doc-pl for ub.c-doc-pl.
      174   on delete of ub.c-doc-pl override do: end.
      175   for each c-doc-pl exclusive-lock
      176       where c-doc-pl.obj-type = doc-pl.obj-type
      177             and c-doc-pl.obj-code = doc-pl.obj-code
      178             and c-doc-pl.pl-code  = doc-pl.pl-code
      179             and c-doc-pl.out-code = doc-pl.out-code
      180             and c-doc-pl.gds-code = doc-pl.gds-code
      181   on error undo, return error
