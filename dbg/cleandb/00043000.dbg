      201         vDeleted = vDeleted + 1.
      202   end.
      203       delete doc-pl.
      204       vDeleted = vDeleted + 1.
      205     end.
      206     define buffer doc-pl-pump     for ub.doc-pl-pump.
      207     on delete of ub.doc-pl-pump  override do: end.
      208     for each doc-pl-pump exclusive-lock where
      209              doc-pl-pump.out-code = trn-doc.doc-code
      210     :
