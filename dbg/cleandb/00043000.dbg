      214       where c-doc-pl-pump.obj-type  = doc-pl-pump.obj-type
      215             and c-doc-pl-pump.obj-code  = doc-pl-pump.obj-code
      216             and c-doc-pl-pump.pl-code   = doc-pl-pump.pl-code
      217             and c-doc-pl-pump.pump-code = doc-pl-pump.pump-code
      218             and c-doc-pl-pump.out-code  = doc-pl-pump.out-code
      219             and c-doc-pl-pump.gds-code  = doc-pl-pump.gds-code
      220   on error undo, return error
