      334     define buffer parts for ub.parts.
      335     define buffer goods for ub.goods.
      336     on delete of ub.parts  override do: end.
      337     for each parts exclusive-lock where
      338              parts.out-code = trn-doc.doc-code,
      339         first goods no-lock where
      340               goods.artic     =  parts.artic
      341           and goods.prod-type =  parts.prod-type
      342           and goods.prod-code =  parts.prod-code
      343     :
