        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 15 2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00043000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00043000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer trn-doc     for ub.trn-doc .
       22   define buffer buf_trn-doc for ub.trn-doc .
       23   on delete of ub.trn-doc         override do: end.
       24   for each buf_clients no-lock
       25      where buf_clients.db-num <> ?
       26   :
       27     for each trn-doc no-lock where
       28              trn-doc.obj-type   = buf_clients.obj-type
       29          and trn-doc.obj-code   = buf_clients.obj-code
       30          and trn-doc.doc-date  < vardate-actual-docs
       31     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       32     :
       33       run cleanTable in this-procedure.
       34       find first buf_trn-doc exclusive-lock where
       35              recid(buf_trn-doc) = recid(trn-doc) no-error no-wait.
       36   if not avail buf_trn-doc then
       37   do:
       38     undo, return error "Ошибка удаления trn-doc. Запись занята другим пользователем.".
       39   end.
       40   delete buf_trn-doc.
       41   vDeleted = vDeleted + 1.
       42     end.
       43   end.
       44   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Накладные, История по накладным, Кассовый отчет с историей, Документы инвентаризации с историей, Кассовые чеки с историей, Архив скл. док. по контрактам", vDeleted).
       45   return vResult.
       46   procedure cleanTable:
       47     define buffer doc-attr for ub.doc-attr.
       48   on delete of ub.doc-attr override do: end.
       49   for each doc-attr exclusive-lock
       50       where doc-attr.doc-code = trn-doc.doc-code
       51   on error undo, return error
       52   :
       53         delete doc-attr no-error.
       54         if error-status:error then
       55           undo, return error error-status:get-message(1).
       56         vDeleted = vDeleted + 1.
       57   end.
       58     define buffer c-doc-attr for ub.c-doc-attr.
       59   on delete of ub.c-doc-attr override do: end.
       60   for each c-doc-attr exclusive-lock
       61       where c-doc-attr.doc-code = trn-doc.doc-code
       62   on error undo, return error
       63   :
       64         delete c-doc-attr no-error.
       65         if error-status:error then
       66           undo, return error error-status:get-message(1).
       67         vDeleted = vDeleted + 1.
       68   end.
       69     define buffer doc-line for ub.doc-line.
       70   on delete of ub.doc-line override do: end.
       71   for each doc-line exclusive-lock
       72       where doc-line.doc-code = trn-doc.doc-code
       73   on error undo, return error
       74   :
       75         delete doc-line no-error.
       76         if error-status:error then
       77           undo, return error error-status:get-message(1).
       78         vDeleted = vDeleted + 1.
       79   end.
       80     define buffer doc-line-attr for ub.doc-line-attr.
       81   on delete of ub.doc-line-attr override do: end.
       82   for each doc-line-attr exclusive-lock
       83       where doc-line-attr.doc-code = trn-doc.doc-code
       84   on error undo, return error
       85   :
       86         delete doc-line-attr no-error.
       87         if error-status:error then
       88           undo, return error error-status:get-message(1).
       89         vDeleted = vDeleted + 1.
       90   end.
       91     define buffer c-doc-line-attr for ub.c-doc-line-attr.
       92   on delete of ub.c-doc-line-attr override do: end.
       93   for each c-doc-line-attr exclusive-lock
       94        where c-doc-line-attr.doc-code = trn-doc.doc-code
       95   on error undo, return error
       96   :
       97         delete c-doc-line-attr no-error.
       98         if error-status:error then
       99           undo, return error error-status:get-message(1).
      100         vDeleted = vDeleted + 1.
      101   end.
