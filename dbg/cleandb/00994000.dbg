        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: b1849e93de2b, 967, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 03/10/2025":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00994000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00994000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога чистки БД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define variable v-tbl-row as rowid no-undo .
       22   define variable v-tbl-name as character no-undo .
       23   define variable v-bh as handle no-undo .
       24   define variable lob-reslist-date-egais as character no-undo .
       25   define variable v-ii as integer no-undo .
       26   define variable v-entry as character no-undo .
       27   define variable v-doc-code as character no-undo .
       28   define buffer clob-bind     for ub.clob-bind.
       29   define buffer buf_clob-bind for ub.clob-bind.
       30   define buffer clob-data     for ub.clob-data.
       31   on delete of ub.clob-bind             override do: end.
       32   on delete of ub.clob-data             override do: end.
       33   lob-reslist-date-egais = 'egais-ab':U + chr(44) + 'egais-awo':U + chr(44)
       34     + chr(44) + 'egais-ab_shop':U + chr(44) + 'egais-awo_shop':U.
       35   do v-ii = 1 to num-entries(lob-reslist-date-egais):
       36     v-entry = entry(v-ii, lob-reslist-date-egais).
       37     cicl0_:
       38     for each clob-bind no-lock where
       39              clob-bind.resource-type = v-entry
       40          and clob-bind.sys-date      < vardate-actual-docs
       41     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       42     :
       43       for each clob-data exclusive-lock where
       44                clob-data.db-num = clob-bind.db-num
       45            and clob-data.int64-id = clob-bind.int64-id
       46       :
       47         delete clob-data.
       48         vDeleted = vDeleted + 1.
       49       end.
       50       find first buf_clob-bind exclusive-lock where
       51              recid(buf_clob-bind) = recid(clob-bind) no-error no-wait.
       52   if not avail buf_clob-bind then
       53   do:
       54     undo, return error "Ошибка удаления clob-bind. Запись занята другим пользователем.".
       55   end.
       56   delete buf_clob-bind.
       57   vDeleted = vDeleted + 1.
       58     end.
       59   end.
       60   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Двоичные данные документов", vDeleted).
       61   return vResult.
