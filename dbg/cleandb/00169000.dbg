        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 15 2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00043000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00169000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define variable v-fact-order               as decimal      no-undo.
       22   define variable v-shift-end-fact-order     as decimal      no-undo.
       23   define variable v-day-end-fact-order       as decimal      no-undo.
       24   define buffer shift-obj        for ub.shift-obj.
       25   define buffer shift-obj-attr   for ub.shift-obj-attr.
       26   define buffer shift-staff      for ub.shift-staff.
       27   define buffer c-shift-staff    for ub.c-shift-staff.
       28   define buffer shift-staff-attr for ub.shift-staff-attr.
       29   define buffer obj-date         for ub.obj-date.
       30   define buffer c-sht-hist       for ub.c-sht-hist.
       31   on delete of ub.shift-obj override do: end.
       32   on delete of ub.obj-date  override do: end.
       33   on delete of ub.shift-obj-attr  override do: end.
       34   on delete of ub.shift-staff  override do: end.
       35   on delete of ub.shift-staff-attr  override do: end.
       36   on delete of ub.c-shift-staff  override do: end.
       37   on delete of ub.c-sht-hist  override do: end.
       38   run factord in this-procedure (
       39       input vardate-actual-docs - 1
       40     , input 0
       41     , input 1
       42     , input vardate-actual-docs - 1
       43     , input 1
       44     , input yes
       45     , output v-fact-order
       46     , output v-shift-end-fact-order
       47     , output v-day-end-fact-order
       48   ).
       49   for each buf_clients no-lock
       50      where buf_clients.db-num <> ?
       51   :
       52     for each shift-obj exclusive-lock
       53        where shift-obj.obj-type     = buf_clients.obj-type
       54          and shift-obj.obj-code     = buf_clients.obj-code
       55          and shift-obj.shift-date  < vardate-actual-docs
       56          and shift-obj.status_ = 'зкр':U
       57     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       58     :
       59       define buffer c-shift-obj for ub.c-shift-obj.
       60   on delete of ub.c-shift-obj override do: end.
       61   for each c-shift-obj exclusive-lock
       62       where c-shift-obj.obj-type   = shift-obj.obj-type
       63            and c-shift-obj.obj-code   = shift-obj.obj-code
       64            and c-shift-obj.shift-date = shift-obj.shift-date
       65            and c-shift-obj.shift-num  = shift-obj.shift-num
       66   on error undo, return error
       67   :
       68         delete c-shift-obj no-error.
       69         if error-status:error then
       70           undo, return error error-status:get-message(1).
       71         vDeleted = vDeleted + 1.
       72   end.
       73       delete shift-obj.
       74       vDeleted = vDeleted + 1.
       75     end.
       76     for each shift-staff exclusive-lock
       77        where shift-staff.obj-type    = buf_clients.obj-type
       78          and shift-staff.obj-code    = buf_clients.obj-code
       79          and shift-staff.shift-date  < vardate-actual-docs
       80     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       81     :
       82       delete shift-staff.
       83       vDeleted = vDeleted + 1.
       84     end.
       85     for each c-shift-staff exclusive-lock
       86        where c-shift-staff.obj-type    = buf_clients.obj-type
       87          and c-shift-staff.obj-code    = buf_clients.obj-code
       88          and c-shift-staff.shift-date  < vardate-actual-docs
       89     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       90     :
       91       delete c-shift-staff.
       92       vDeleted = vDeleted + 1.
       93     end.
       94     for each shift-staff-attr exclusive-lock
       95        where shift-staff-attr.obj-type    = buf_clients.obj-type
       96          and shift-staff-attr.obj-code    = buf_clients.obj-code
       97          and shift-staff-attr.shift-date  < vardate-actual-docs
       98     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       99     :
      100       delete shift-staff-attr.
      101       vDeleted = vDeleted + 1.
      102     end.
      103     for each shift-obj-attr exclusive-lock
      104        where shift-obj-attr.obj-type    = buf_clients.obj-type
      105          and shift-obj-attr.obj-code    = buf_clients.obj-code
      106          and shift-obj-attr.shift-date < vardate-actual-docs
      107     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      108     :
      109       delete shift-obj-attr.
      110       vDeleted = vDeleted + 1.
      111     end.
      112     for each obj-date exclusive-lock
      113        where obj-date.obj-type      = buf_clients.obj-type
      114          and obj-date.obj-code      = buf_clients.obj-code
      115          and obj-date.fact-order    <= v-shift-end-fact-order
      116          and obj-date.status_       = 'зкр':U
      117     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      118     :
      119       delete obj-date.
      120       vDeleted = vDeleted + 1.
      121     end.
      122     for each c-sht-hist exclusive-lock
      123        where c-sht-hist.obj-type    = buf_clients.obj-type
      124          and c-sht-hist.obj-code    = buf_clients.obj-code
      125          and c-sht-hist.shift-date  < vardate-actual-docs
      126     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
      127     :
      128       delete c-sht-hist.
      129       vDeleted = vDeleted + 1.
      130     end.
      131   end.
      132   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Смена на объекте с историей, Персонал смены с историей", vDeleted).
      133   return vResult.
      134   procedure factord :
      135     define input  parameter p-fact-date            as date    no-undo .
      136     define input  parameter p-fact-time            as integer no-undo .
      137     define input  parameter p-fact-num             as integer no-undo .
      138     define input  parameter p-shift-date           as date    no-undo .
      139     define input  parameter p-shift-num            as integer no-undo .
      140     define input  parameter p-shift-on             as logical no-undo .
      141     define output parameter p-fact-order           as decimal no-undo .
      142     define output parameter p-shift-end-fact-order as decimal no-undo .
      143     define output parameter p-day-end-fact-order   as decimal no-undo .
      144     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      145     if p-fact-date = ? then do:
      146       return error "Не указана фактическая дата" .
      147     end.
      148     define variable v-fact-date-num as integer no-undo .
      149     assign
      150       v-fact-date-num = integer(p-fact-date)
      151     .
      152     if p-fact-num = ?
      153     or p-fact-num = 0 then do:
      154       return error "Не задан p-fact-num " + string(p-fact-num) .
      155     end.
      156     if p-fact-num < 0 then do:
      157       return error "Отрицательный fact-num " + string(p-fact-num) .
      158     end.
      159     if p-fact-num >= 100000000 then do:
      160       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      161     end.
      162     if p-shift-on = true then do:
      163       if p-shift-date = ?
      164       then do:
      165         return error "Не задана дата смены" .
      166       end.
      167       if p-shift-num = ?
      168       or p-shift-num = 0
      169       then do:
      170         return error "Не задан номер смены" .
      171       end.
      172     end.
      173     else do:
      174       assign
      175         p-shift-date = p-fact-date
      176         p-shift-num  = 24
      177       .
      178     end.
      179     define variable v-shift-offset as integer no-undo .
      180     if p-shift-date = p-fact-date then do:
      181       assign
      182         v-shift-offset = 1
      183       .
      184     end.
      185     if p-shift-date < p-fact-date then do:
      186       assign
      187         v-shift-offset = 0
      188       .
      189     end.
      190     if p-shift-date > p-fact-date then do:
      191       message
      192         vss-workfile vss-revision vss-description skip
      193         "Неправильная дата закрытия смены" skip
      194         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      195         view-as alert-box error .
      196       undo, return error
      197         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      198           ,string(p-fact-date, '99/99/9999':U)
      199           ,string(p-shift-date, '99/99/9999':U)
      200           )
      201       .
      202     end.
      203     if p-shift-num < 1
      204     or p-shift-num > 24 then do:
      205       message
      206         vss-workfile vss-revision vss-description skip
      207         "Неправильный номер смены" skip
      208         "p-shift-num" p-shift-num skip
      209         view-as alert-box error .
      210       undo, return error return-value .
      211     end.
      212     assign
      213       p-fact-order           = v-fact-date-num
      214                              + v-shift-offset * 0.5
      215                              + p-shift-num    * 0.02 - 0.01
      216                              + p-fact-num     * 0.0000000001
      217       p-shift-end-fact-order = v-fact-date-num
      218                              + v-shift-offset * 0.5
      219                              + p-shift-num    * 0.02
      220       p-day-end-fact-order   = v-fact-date-num
      221                              + 0.99
      222     .
      223     if p-fact-order           <= v-fact-date-num
      224     or p-shift-end-fact-order <= v-fact-date-num
      225     or p-fact-order           >= p-shift-end-fact-order
      226     or p-shift-end-fact-order >= p-day-end-fact-order
      227     then do:
      228       message
      229         vss-workfile vss-revision vss-description skip
      230         "Внутренняя ошибка при генерации фактического номера" skip
      231         "p-fact-date"            p-fact-date            skip
      232         "p-fact-time"            p-fact-time            skip
      233         "p-fact-num"             p-fact-num             skip
      234         "p-shift-date"           p-shift-date           skip
      235         "p-shift-num"            p-shift-num            skip
      236         "p-shift-on"             p-shift-on             skip
      237         "p-shift-end-fact-order" p-shift-end-fact-order skip
      238         "p-day-end-fact-order"   p-day-end-fact-order   skip
      239         "v-fact-date-num"        v-fact-date-num        skip
      240         view-as alert-box error .
      241       undo, return error return-value .
      242     end.
      243   end procedure.
