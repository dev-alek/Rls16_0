        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 17 2025  $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00061000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00061000.p $":U .
        7   define variable vss-description as character no-undo init "Чистка УБД1.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer cd-doc            for ub.cd-doc.
       22   define buffer buf_cd-doc        for ub.cd-doc.
       23   define buffer cd-event-log      for ub.cd-event-log.
       24   define buffer buf_cd-event-log  for ub.cd-event-log.
       25   on delete of ub.cd-doc            override do: end.
       26   on delete of ub.cd-event-log      override do: end.
       27   for each buf_clients no-lock
       28       where buf_clients.db-num <> ?
       29   :
       30     for each cd-doc no-lock where
       31              cd-doc.obj-type    = buf_clients.obj-type
       32          and cd-doc.obj-code    = buf_clients.obj-code
       33          and cd-doc.datekey_one < vardate-actual-docs
       34     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       35     :
       36       run cleanTable in this-procedure.
       37       find first buf_cd-doc exclusive-lock where
       38              recid(buf_cd-doc) = recid(cd-doc) no-error no-wait.
       39   if not avail buf_cd-doc then
       40   do:
       41     undo, return error "Ошибка удаления cd-doc. Запись занята другим пользователем.".
       42   end.
       43   delete buf_cd-doc.
       44   vDeleted = vDeleted + 1.
       45     end.
       46     for each cd-event-log no-lock where
       47              cd-event-log.obj-type   = buf_clients.obj-type
       48          and cd-event-log.obj-code   = buf_clients.obj-code
       49          and cd-event-log.event-date < vardate-actual-docs
       50     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       51     :
       52       define buffer cd-event-log-attr for ub.cd-event-log-attr.
       53   on delete of ub.cd-event-log-attr override do: end.
       54   for each cd-event-log-attr exclusive-lock
       55       where cd-event-log-attr.db-num   = cd-event-log.db-num
       56            and cd-event-log-attr.trans-id = cd-event-log.trans-id
       57   on error undo, return error
       58   :
       59         delete cd-event-log-attr no-error.
       60         if error-status:error then
       61           undo, return error error-status:get-message(1).
       62         vDeleted = vDeleted + 1.
       63   end.
       64       find first buf_cd-event-log exclusive-lock where
       65              recid(buf_cd-event-log) = recid(cd-event-log) no-error no-wait.
       66   if not avail buf_cd-event-log then
       67   do:
       68     undo, return error "Ошибка удаления cd-event-log. Запись занята другим пользователем.".
       69   end.
       70   delete buf_cd-event-log.
       71   vDeleted = vDeleted + 1.
       72     end.
       73   end.
       74   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Документы на кассе с историей", vDeleted).
       75   return vResult.
       76   procedure cleanTable :
       77     define buffer cd-doc-attr for ub.cd-doc-attr.
       78   on delete of ub.cd-doc-attr override do: end.
       79   for each cd-doc-attr exclusive-lock
       80       where cd-doc-attr.obj-type = cd-doc.obj-type       and cd-doc-attr.obj-code = cd-doc.obj-code       and cd-doc-attr.pos-type = cd-doc.pos-type       and cd-doc-attr.doc-type = cd-doc.doc-type       and cd-doc-attr.doc-code = cd-doc.doc-code
       81   on error undo, return error
       82   :
       83         delete cd-doc-attr no-error.
       84         if error-status:error then
       85           undo, return error error-status:get-message(1).
       86         vDeleted = vDeleted + 1.
       87   end.
       88     define buffer cd-doc-line for ub.cd-doc-line.
       89   on delete of ub.cd-doc-line override do: end.
       90   for each cd-doc-line exclusive-lock
       91       where cd-doc-line.obj-type = cd-doc.obj-type       and cd-doc-line.obj-code = cd-doc.obj-code       and cd-doc-line.pos-type = cd-doc.pos-type       and cd-doc-line.doc-type = cd-doc.doc-type       and cd-doc-line.doc-code = cd-doc.doc-code
       92   on error undo, return error
       93   :
       94         delete cd-doc-line no-error.
       95         if error-status:error then
       96           undo, return error error-status:get-message(1).
       97         vDeleted = vDeleted + 1.
       98   end.
       99     define buffer cd-doc-line-attr for ub.cd-doc-line-attr.
      100   on delete of ub.cd-doc-line-attr override do: end.
      101   for each cd-doc-line-attr exclusive-lock
      102       where cd-doc-line-attr.obj-type = cd-doc.obj-type       and cd-doc-line-attr.obj-code = cd-doc.obj-code       and cd-doc-line-attr.pos-type = cd-doc.pos-type       and cd-doc-line-attr.doc-type = cd-doc.doc-type       and cd-doc-line-attr.doc-code = cd-doc.doc-code
      103   on error undo, return error
      104   :
      105         delete cd-doc-line-attr no-error.
      106         if error-status:error then
      107           undo, return error error-status:get-message(1).
      108         vDeleted = vDeleted + 1.
      109   end.
      110     define buffer c-cd-doc for ub.c-cd-doc.
      111   on delete of ub.c-cd-doc override do: end.
      112   for each c-cd-doc exclusive-lock
      113       where c-cd-doc.obj-type = cd-doc.obj-type       and c-cd-doc.obj-code = cd-doc.obj-code       and c-cd-doc.pos-type = cd-doc.pos-type       and c-cd-doc.doc-type = cd-doc.doc-type       and c-cd-doc.doc-code = cd-doc.doc-code
      114   on error undo, return error
      115   :
      116         delete c-cd-doc no-error.
      117         if error-status:error then
      118           undo, return error error-status:get-message(1).
      119         vDeleted = vDeleted + 1.
      120   end.
      121     define buffer c-cd-doc-line for ub.c-cd-doc-line.
      122   on delete of ub.c-cd-doc-line override do: end.
      123   for each c-cd-doc-line exclusive-lock
      124       where c-cd-doc-line.obj-type = cd-doc.obj-type       and c-cd-doc-line.obj-code = cd-doc.obj-code       and c-cd-doc-line.pos-type = cd-doc.pos-type       and c-cd-doc-line.doc-type = cd-doc.doc-type       and c-cd-doc-line.doc-code = cd-doc.doc-code
      125   on error undo, return error
      126   :
      127         delete c-cd-doc-line no-error.
      128         if error-status:error then
      129           undo, return error error-status:get-message(1).
      130         vDeleted = vDeleted + 1.
      131   end.
      132   end procedure.
