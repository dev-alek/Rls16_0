      183     define buffer price-all for ub.price-all.
      184     define buffer price-all-attr for ub.price-all-attr.
      185     on delete of ub.price-all      override do: end.
      186     on delete of ub.price-all-attr override do: end.
      187     for each price-all exclusive-lock
      188        where price-all.plt-id     = price-doc-forming.plt-id
      189          and price-all.plt-db-num = price-doc-forming.plt-db-num
      190          and price-all.pdf-id     = price-doc-forming.pdf-id
      191          and price-all.pdf-db     = price-doc-forming.pdf-db
      192     on error undo, return error
      193     :
      194       for each price-all-attr exclusive-lock
      195          where price-all-attr.pal-p      = price-all.pal-p
      196            and price-all-attr.pal-id     = price-all.pal-id
      197            and price-all-attr.pal-db-num = price-all.pal-db-num
      198       on error undo, return error
      199       :
      200         delete price-all-attr.
      201         vDeleted = vDeleted + 1.
      202       end.
      203       delete price-all.
      204       vDeleted = vDeleted + 1.
      205     end.
      206   end procedure.
