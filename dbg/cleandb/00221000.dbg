        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 03/10/2025":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00221000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00221000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога чистки БД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer price-doc-forming     for ub.price-doc-forming.
       22   define buffer buf_price-doc-forming for ub.price-doc-forming.
       23   on delete of ub.price-doc-forming           override do: end.
       24   for each price-doc-forming no-lock
       25      where price-doc-forming.sys-date < vardate-actual-docs
       26   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       27       :
       28     run cleanTables in this-procedure.
       29     find first buf_price-doc-forming exclusive-lock where
       30              recid(buf_price-doc-forming) = recid(price-doc-forming) no-error no-wait.
       31   if not avail buf_price-doc-forming then
       32   do:
       33     undo, return error "Ошибка удаления price-doc-forming. Запись занята другим пользователем.".
       34   end.
       35   delete buf_price-doc-forming.
       36   vDeleted = vDeleted + 1.
       37   end.
       38   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Документ формирования цены с историей", vDeleted).
       39   return vResult.
       40   procedure cleanTables :
       41     define buffer c-price-doc-forming for ub.c-price-doc-forming.
       42   on delete of ub.c-price-doc-forming override do: end.
       43   for each c-price-doc-forming exclusive-lock
       44   on error undo, return error
       45   :
       46         delete c-price-doc-forming no-error.
       47         if error-status:error then
       48           undo, return error error-status:get-message(1).
       49         vDeleted = vDeleted + 1.
       50   end.
       51     define buffer price-doc-forming-attr for ub.price-doc-forming-attr.
       52   on delete of ub.price-doc-forming-attr override do: end.
       53   for each price-doc-forming-attr exclusive-lock
       54       where price-doc-forming-attr.plt-id     = price-doc-forming.plt-id       and price-doc-forming-attr.plt-db-num = price-doc-forming.plt-db-num       and price-doc-forming-attr.pdf-id     = price-doc-forming.pdf-id       and price-doc-forming-attr.pdf-db     = price-doc-forming.pdf-db
       55   on error undo, return error
       56   :
       57         delete price-doc-forming-attr no-error.
       58         if error-status:error then
       59           undo, return error error-status:get-message(1).
       60         vDeleted = vDeleted + 1.
       61   end.
       62     define buffer c-price-doc-forming-attr for ub.c-price-doc-forming-attr.
       63   on delete of ub.c-price-doc-forming-attr override do: end.
       64   for each c-price-doc-forming-attr exclusive-lock
       65       where c-price-doc-forming-attr.plt-id     = price-doc-forming.plt-id       and c-price-doc-forming-attr.plt-db-num = price-doc-forming.plt-db-num       and c-price-doc-forming-attr.pdf-id     = price-doc-forming.pdf-id       and c-price-doc-forming-attr.pdf-db     = price-doc-forming.pdf-db
       66   on error undo, return error
       67   :
       68         delete c-price-doc-forming-attr no-error.
       69         if error-status:error then
       70           undo, return error error-status:get-message(1).
       71         vDeleted = vDeleted + 1.
       72   end.
       73     define buffer price-doc-forming-gds for ub.price-doc-forming-gds.
       74   on delete of ub.price-doc-forming-gds override do: end.
       75   for each price-doc-forming-gds exclusive-lock
       76       where price-doc-forming-gds.plt-id     = price-doc-forming.plt-id       and price-doc-forming-gds.plt-db-num = price-doc-forming.plt-db-num       and price-doc-forming-gds.pdf-id     = price-doc-forming.pdf-id       and price-doc-forming-gds.pdf-db     = price-doc-forming.pdf-db
       77   on error undo, return error
       78   :
       79         delete price-doc-forming-gds no-error.
       80         if error-status:error then
       81           undo, return error error-status:get-message(1).
       82         vDeleted = vDeleted + 1.
       83   end.
       84     define buffer c-price-doc-forming-gds for ub.c-price-doc-forming-gds.
       85   on delete of ub.c-price-doc-forming-gds override do: end.
       86   for each c-price-doc-forming-gds exclusive-lock
       87       where c-price-doc-forming-gds.plt-id     = price-doc-forming.plt-id       and c-price-doc-forming-gds.plt-db-num = price-doc-forming.plt-db-num       and c-price-doc-forming-gds.pdf-id     = price-doc-forming.pdf-id       and c-price-doc-forming-gds.pdf-db     = price-doc-forming.pdf-db
       88   on error undo, return error
       89   :
       90         delete c-price-doc-forming-gds no-error.
       91         if error-status:error then
       92           undo, return error error-status:get-message(1).
       93         vDeleted = vDeleted + 1.
       94   end.
       95     define buffer price-doc-forming-gdsattr for ub.price-doc-forming-gdsattr.
       96   on delete of ub.price-doc-forming-gdsattr override do: end.
       97   for each price-doc-forming-gdsattr exclusive-lock
       98       where price-doc-forming-gdsattr.plt-id     = price-doc-forming.plt-id       and price-doc-forming-gdsattr.plt-db-num = price-doc-forming.plt-db-num       and price-doc-forming-gdsattr.pdf-id     = price-doc-forming.pdf-id       and price-doc-forming-gdsattr.pdf-db     = price-doc-forming.pdf-db
       99   on error undo, return error
      100   :
      101         delete price-doc-forming-gdsattr no-error.
      102         if error-status:error then
      103           undo, return error error-status:get-message(1).
      104         vDeleted = vDeleted + 1.
      105   end.
      106     define buffer c-price-doc-forming-gdsattr for ub.c-price-doc-forming-gdsattr.
      107   on delete of ub.c-price-doc-forming-gdsattr override do: end.
      108   for each c-price-doc-forming-gdsattr exclusive-lock
