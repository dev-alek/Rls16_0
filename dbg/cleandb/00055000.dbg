        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 15 2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00055000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00055000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer fbr-doc      for ub.fbr-doc.
       22   define buffer buf_fbr-doc  for ub.fbr-doc.
       23   define buffer fbr-pln      for ub.fbr-pln.
       24   define buffer buf_fbr-pln  for ub.fbr-pln.
       25   on delete of ub.fbr-doc override do: end.
       26   on delete of ub.fbr-pln override do: end.
       27   for each buf_clients no-lock
       28       where buf_clients.db-num <> ?
       29   :
       30     for each fbr-doc no-lock
       31        where fbr-doc.obj-type  = buf_clients.obj-type
       32          and fbr-doc.obj-code  = buf_clients.obj-code
       33          and fbr-doc.fact-date < vardate-actual-docs
       34     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       35     :
       36       run cleanFbrTable in this-procedure.
       37       find first buf_fbr-doc exclusive-lock where
       38              recid(buf_fbr-doc) = recid(fbr-doc) no-error no-wait.
       39   if not avail buf_fbr-doc then
       40   do:
       41     undo, return error "Ошибка удаления fbr-doc. Запись занята другим пользователем.".
       42   end.
       43   delete buf_fbr-doc.
       44   vDeleted = vDeleted + 1.
       45     end.
       46     for each fbr-pln no-lock
       47        where fbr-pln.obj-type  = buf_clients.obj-type
       48          and fbr-pln.obj-code  = buf_clients.obj-code
       49          and fbr-pln.fact-date < vardate-actual-docs
       50     on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       51     :
       52       run cleanPlnTable in this-procedure.
       53       find first buf_fbr-pln exclusive-lock where
       54              recid(buf_fbr-pln) = recid(fbr-pln) no-error no-wait.
       55   if not avail buf_fbr-pln then
       56   do:
       57     undo, return error "Ошибка удаления fbr-pln. Запись занята другим пользователем.".
       58   end.
       59   delete buf_fbr-pln.
       60   vDeleted = vDeleted + 1.
       61     end.
       62   end.
       63   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Документы производства с историей Документы план-меню c историей", vDeleted).
       64   return vResult.
       65   procedure cleanFbrTable :
       66     define buffer fbr-line       for ub.fbr-line.
       67     define buffer fbr-recipe     for ub.fbr-recipe.
       68     on delete of ub.fbr-line   override do: end.
       69     on delete of ub.fbr-recipe override do: end.
       70     for each fbr-line exclusive-lock
       71        where fbr-line.doc-code = fbr-doc.doc-code
       72     :
       73       if fbr-line.recipe-code <> ? and
       74          fbr-line.recipe-code <> "":U
       75       then do:
       76         if fbr-line.is-comp = yes
       77         then do:
       78           define buffer recipe-develop for ub.recipe-develop.
       79   on delete of ub.recipe-develop override do: end.
       80   for each recipe-develop exclusive-lock
       81       where recipe-develop.recipe-code = fbr-line.recipe-code
       82                and recipe-develop.doc-code = fbr-line.doc-code
       83   on error undo, return error
       84   :
       85         delete recipe-develop no-error.
       86         if error-status:error then
       87           undo, return error error-status:get-message(1).
       88         vDeleted = vDeleted + 1.
       89   end.
       90           define buffer c-recipe-develop for ub.c-recipe-develop.
       91   on delete of ub.c-recipe-develop override do: end.
       92   for each c-recipe-develop exclusive-lock
       93       where c-recipe-develop.recipe-code = fbr-line.recipe-code
       94                and c-recipe-develop.doc-code = fbr-line.doc-code
       95   on error undo, return error
       96   :
       97         delete c-recipe-develop no-error.
       98         if error-status:error then
       99           undo, return error error-status:get-message(1).
      100         vDeleted = vDeleted + 1.
      101   end.
      102           for each fbr-recipe exclusive-lock
      103              where fbr-recipe.doc-code    = fbr-line.doc-code
      104                and fbr-recipe.recipe-code = fbr-line.recipe-code
      105           :
      106             define buffer fbr-recipe-gds for ub.fbr-recipe-gds.
      107   on delete of ub.fbr-recipe-gds override do: end.
      108   for each fbr-recipe-gds exclusive-lock
      109       where fbr-recipe-gds.doc-code = fbr-recipe.doc-code
      110                  and fbr-recipe-gds.recipe-code = fbr-recipe.recipe-code
      111   on error undo, return error
      112   :
      113         delete fbr-recipe-gds no-error.
      114         if error-status:error then
      115           undo, return error error-status:get-message(1).
      116         vDeleted = vDeleted + 1.
      117   end.
      118             delete fbr-recipe.
      119             vDeleted = vDeleted + 1.
      120           end.
      121         end.
      122       end.
      123       delete fbr-line.
      124       vDeleted = vDeleted + 1.
      125     end.
      126     define buffer doc-attr for ub.doc-attr.
      127   on delete of ub.doc-attr override do: end.
      128   for each doc-attr exclusive-lock
      129       where doc-attr.doc-code = fbr-doc.doc-code
      130   on error undo, return error
      131   :
      132         delete doc-attr no-error.
      133         if error-status:error then
      134           undo, return error error-status:get-message(1).
      135         vDeleted = vDeleted + 1.
      136   end.
      137     define buffer c-fbr-doc for ub.c-fbr-doc.
      138   on delete of ub.c-fbr-doc override do: end.
      139   for each c-fbr-doc exclusive-lock
      140       where c-fbr-doc.doc-code = fbr-doc.doc-code
      141   on error undo, return error
      142   :
      143         delete c-fbr-doc no-error.
      144         if error-status:error then
      145           undo, return error error-status:get-message(1).
      146         vDeleted = vDeleted + 1.
      147   end.
      148     define buffer c-doc-attr for ub.c-doc-attr.
      149   on delete of ub.c-doc-attr override do: end.
      150   for each c-doc-attr exclusive-lock
      151       where c-doc-attr.doc-code = fbr-doc.doc-code
      152   on error undo, return error
      153   :
      154         delete c-doc-attr no-error.
      155         if error-status:error then
      156           undo, return error error-status:get-message(1).
      157         vDeleted = vDeleted + 1.
      158   end.
      159     define buffer c-fbr-line for ub.c-fbr-line.
      160   on delete of ub.c-fbr-line override do: end.
      161   for each c-fbr-line exclusive-lock
      162       where c-fbr-line.doc-code = fbr-doc.doc-code
      163   on error undo, return error
      164   :
      165         delete c-fbr-line no-error.
      166         if error-status:error then
      167           undo, return error error-status:get-message(1).
      168         vDeleted = vDeleted + 1.
      169   end.
      170     define buffer fbr-history for ub.fbr-history.
      171   on delete of ub.fbr-history override do: end.
      172   for each fbr-history exclusive-lock
      173       where fbr-history.obj-type = fbr-doc.obj-type and fbr-history.obj-code = fbr-doc.obj-code and fbr-history.doc-code = fbr-doc.doc-code
      174   on error undo, return error
      175   :
      176         delete fbr-history no-error.
      177         if error-status:error then
      178           undo, return error error-status:get-message(1).
      179         vDeleted = vDeleted + 1.
      180   end.
      181   end procedure.
      182   procedure cut-pln-table :
      183     define buffer fbr-pln-line   for ub.fbr-pln-line.
      184     on delete of ub.fbr-pln-line override do: end.
      185     define buffer c-fbr-pln for ub.c-fbr-pln.
      186   on delete of ub.c-fbr-pln override do: end.
      187   for each c-fbr-pln exclusive-lock
      188        where c-fbr-pln.doc-code  = fbr-pln.doc-code
      189   on error undo, return error
      190   :
      191         delete c-fbr-pln no-error.
      192         if error-status:error then
      193           undo, return error error-status:get-message(1).
      194         vDeleted = vDeleted + 1.
      195   end.
      196     for each fbr-pln-line exclusive-lock
      197        where fbr-pln-line.doc-code = fbr-pln.doc-code
      198     :
      199       define buffer c-fbr-pln-line for ub.c-fbr-pln-line.
      200   on delete of ub.c-fbr-pln-line override do: end.
      201   for each c-fbr-pln-line exclusive-lock
      202        where c-fbr-pln-line.doc-code     = fbr-pln.doc-code and              c-fbr-pln-line.fbr-obj-type = fbr-pln-line.fbr-obj-type  and              c-fbr-pln-line.fbr-obj-code = fbr-pln-line.fbr-obj-code  and              c-fbr-pln-line.gds-code     = fbr-pln-line.gds-code      and              c-fbr-pln-line.recipe-code  = fbr-pln-line.recipe-code
      203   on error undo, return error
      204   :
      205         delete c-fbr-pln-line no-error.
      206         if error-status:error then
      207           undo, return error error-status:get-message(1).
      208         vDeleted = vDeleted + 1.
      209   end.
      210       delete fbr-pln-line.
      211       vDeleted = vDeleted + 1.
      212     end.
      213     define buffer fbr-history for ub.fbr-history.
      214   on delete of ub.fbr-history override do: end.
      215   for each fbr-history exclusive-lock
      216        where fbr-history.obj-type = fbr-pln.obj-type        and fbr-history.obj-code = fbr-pln.obj-code        and fbr-history.doc-code = fbr-pln.doc-code
      217   on error undo, return error
      218   :
      219         delete fbr-history no-error.
      220         if error-status:error then
      221           undo, return error error-status:get-message(1).
      222         vDeleted = vDeleted + 1.
      223   end.
      224   end procedure.
