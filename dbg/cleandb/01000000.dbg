        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 13.10.2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 01000000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/01000000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД..".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define input parameter vardate-actual-docs    as date      no-undo.
       15   define input parameter varcall-back           as handle no-undo.
       16   define variable vDeleted as int64     no-undo.
       17   define variable vResult  as character no-undo.
       18   define buffer buf_clients for ub.clients.
       19   find ub.sys-ctrl no-lock.
       20   if not available ub.sys-ctrl then do:
       21      return error "Не найдена уникальная запись sys-ctrl.".
       22   end.
       23   define buffer utd            for ub.utd.
       24   define buffer buf_utd        for ub.utd.
       25   on delete of ub.utd       override do: end.
       26   for each buf_clients no-lock where
       27            buf_clients.db-num <> ?
       28   :
       29     for each utd no-lock
       30        where utd.host-code    = buf_clients.host-code
       31          and utd.DocumentDate < vardate-actual-docs
       32          and utd.sts          = 8
       33     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       34     :
       35       run cleanTable in this-procedure.
       36       find first buf_utd exclusive-lock where
       37              recid(buf_utd) = recid(utd) no-error no-wait.
       38   if not avail buf_utd then
       39   do:
       40     undo, return error "Ошибка удаления utd. Запись занята другим пользователем.".
       41   end.
       42   delete buf_utd.
       43   vDeleted = vDeleted + 1.
       44     end.
       45   end.
       46   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Упд с историей", vDeleted).
       47   return vResult.
       48   procedure cleanTable:
       49     define buffer utd-attr for ub.utd-attr.
       50   on delete of ub.utd-attr override do: end.
       51   for each utd-attr exclusive-lock
       52        where utd-attr.db-num = utd.db-num
       53           and utd-attr.doc-id = utd.doc-id
       54   on error undo, return error
       55   :
       56         delete utd-attr no-error.
       57         if error-status:error then
       58           undo, return error error-status:get-message(1).
       59         vDeleted = vDeleted + 1.
       60   end.
       61     define buffer utd-err for ub.utd-err.
       62   on delete of ub.utd-err override do: end.
       63   for each utd-err exclusive-lock
       64        where utd-err.db-num = utd.db-num
       65           and utd-err.doc-id = utd.doc-id
       66   on error undo, return error
       67   :
       68         delete utd-err no-error.
       69         if error-status:error then
       70           undo, return error error-status:get-message(1).
       71         vDeleted = vDeleted + 1.
       72   end.
       73     define buffer utd-err-attr for ub.utd-err-attr.
       74   on delete of ub.utd-err-attr override do: end.
       75   for each utd-err-attr exclusive-lock
       76        where utd-err-attr.db-num = utd.db-num
       77           and utd-err-attr.doc-id = utd.doc-id
       78   on error undo, return error
       79   :
       80         delete utd-err-attr no-error.
       81         if error-status:error then
       82           undo, return error error-status:get-message(1).
       83         vDeleted = vDeleted + 1.
       84   end.
       85     define buffer utd-lines for ub.utd-lines.
       86   on delete of ub.utd-lines override do: end.
       87   for each utd-lines exclusive-lock
       88        where utd-lines.db-num = utd.db-num
       89           and utd-lines.doc-id = utd.doc-id
       90   on error undo, return error
       91   :
       92         delete utd-lines no-error.
       93         if error-status:error then
       94           undo, return error error-status:get-message(1).
       95         vDeleted = vDeleted + 1.
       96   end.
       97     define buffer utd-lines-attr for ub.utd-lines-attr.
       98   on delete of ub.utd-lines-attr override do: end.
       99   for each utd-lines-attr exclusive-lock
      100        where utd-lines-attr.db-num = utd.db-num
      101           and utd-lines-attr.doc-id = utd.doc-id
      102   on error undo, return error
      103   :
      104         delete utd-lines-attr no-error.
      105         if error-status:error then
      106           undo, return error error-status:get-message(1).
      107         vDeleted = vDeleted + 1.
      108   end.
      109     define buffer utd-marking-lines for ub.utd-marking-lines.
      110   on delete of ub.utd-marking-lines override do: end.
      111   for each utd-marking-lines exclusive-lock
      112        where utd-marking-lines.db-num = utd.db-num
      113           and utd-marking-lines.doc-id = utd.doc-id
      114   on error undo, return error
      115   :
      116         delete utd-marking-lines no-error.
      117         if error-status:error then
      118           undo, return error error-status:get-message(1).
      119         vDeleted = vDeleted + 1.
      120   end.
      121     define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
      122   on delete of ub.utd-marking-lines-attr override do: end.
      123   for each utd-marking-lines-attr exclusive-lock
      124        where utd-marking-lines-attr.db-num = utd.db-num
      125           and utd-marking-lines-attr.doc-id = utd.doc-id
      126   on error undo, return error
      127   :
      128         delete utd-marking-lines-attr no-error.
      129         if error-status:error then
      130           undo, return error error-status:get-message(1).
      131         vDeleted = vDeleted + 1.
      132   end.
      133     define buffer c-utd for ub.c-utd.
      134   on delete of ub.c-utd override do: end.
      135   for each c-utd exclusive-lock
      136        where c-utd.db-num = utd.db-num
      137           and c-utd.doc-id = utd.doc-id
      138   on error undo, return error
      139   :
      140         delete c-utd no-error.
      141         if error-status:error then
      142           undo, return error error-status:get-message(1).
      143         vDeleted = vDeleted + 1.
      144   end.
      145     define buffer c-utd-head for ub.c-utd-head.
      146   on delete of ub.c-utd-head override do: end.
      147   for each c-utd-head exclusive-lock
      148        where c-utd-head.db-num = utd.db-num
      149           and c-utd-head.doc-id = utd.doc-id
      150   on error undo, return error
      151   :
      152         delete c-utd-head no-error.
      153         if error-status:error then
      154           undo, return error error-status:get-message(1).
      155         vDeleted = vDeleted + 1.
      156   end.
      157     define buffer c-utd-attr for ub.c-utd-attr.
      158   on delete of ub.c-utd-attr override do: end.
      159   for each c-utd-attr exclusive-lock
      160        where c-utd-attr.db-num = utd.db-num
      161           and c-utd-attr.doc-id = utd.doc-id
      162   on error undo, return error
      163   :
      164         delete c-utd-attr no-error.
      165         if error-status:error then
      166           undo, return error error-status:get-message(1).
      167         vDeleted = vDeleted + 1.
      168   end.
      169     define buffer c-utd-err for ub.c-utd-err.
      170   on delete of ub.c-utd-err override do: end.
      171   for each c-utd-err exclusive-lock
      172        where c-utd-err.db-num = utd.db-num
      173           and c-utd-err.doc-id = utd.doc-id
      174   on error undo, return error
      175   :
      176         delete c-utd-err no-error.
      177         if error-status:error then
      178           undo, return error error-status:get-message(1).
      179         vDeleted = vDeleted + 1.
      180   end.
      181     define buffer c-utd-err-attr for ub.c-utd-err-attr.
      182   on delete of ub.c-utd-err-attr override do: end.
      183   for each c-utd-err-attr exclusive-lock
      184        where c-utd-err-attr.db-num = utd.db-num
      185           and c-utd-err-attr.doc-id = utd.doc-id
      186   on error undo, return error
      187   :
      188         delete c-utd-err-attr no-error.
      189         if error-status:error then
      190           undo, return error error-status:get-message(1).
      191         vDeleted = vDeleted + 1.
      192   end.
      193     define buffer c-utd-lines for ub.c-utd-lines.
      194   on delete of ub.c-utd-lines override do: end.
      195   for each c-utd-lines exclusive-lock
      196        where c-utd-lines.db-num = utd.db-num
      197           and c-utd-lines.doc-id = utd.doc-id
      198   on error undo, return error
      199   :
      200         delete c-utd-lines no-error.
      201         if error-status:error then
      202           undo, return error error-status:get-message(1).
      203         vDeleted = vDeleted + 1.
      204   end.
      205     define buffer c-utd-lines-attr for ub.c-utd-lines-attr.
      206   on delete of ub.c-utd-lines-attr override do: end.
      207   for each c-utd-lines-attr exclusive-lock
      208        where c-utd-lines-attr.db-num = utd.db-num
      209           and c-utd-lines-attr.doc-id = utd.doc-id
      210   on error undo, return error
      211   :
      212         delete c-utd-lines-attr no-error.
      213         if error-status:error then
      214           undo, return error error-status:get-message(1).
      215         vDeleted = vDeleted + 1.
      216   end.
      217     define buffer c-utd-marking-lines for ub.c-utd-marking-lines.
      218   on delete of ub.c-utd-marking-lines override do: end.
      219   for each c-utd-marking-lines exclusive-lock
      220        where c-utd-marking-lines.db-num = utd.db-num
      221           and c-utd-marking-lines.doc-id = utd.doc-id
      222   on error undo, return error
      223   :
      224         delete c-utd-marking-lines no-error.
      225         if error-status:error then
      226           undo, return error error-status:get-message(1).
      227         vDeleted = vDeleted + 1.
      228   end.
      229     define buffer c-utd-marking-lines-attr for ub.c-utd-marking-lines-attr.
      230   on delete of ub.c-utd-marking-lines-attr override do: end.
      231   for each c-utd-marking-lines-attr exclusive-lock
      232        where c-utd-marking-lines-attr.db-num = utd.db-num
      233           and c-utd-marking-lines-attr.doc-id = utd.doc-id
      234   on error undo, return error
      235   :
      236         delete c-utd-marking-lines-attr no-error.
      237         if error-status:error then
      238           undo, return error error-status:get-message(1).
      239         vDeleted = vDeleted + 1.
      240   end.
      241   end procedure.
