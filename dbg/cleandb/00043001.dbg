        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 15 2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00043000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00043000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer trn-doc    for ub.trn-doc .
       22   define buffer parts      for ub.parts .
       23   define buffer buf_parts  for ub.parts .
       24   define buffer free_parts for ub.parts .
       25   on delete of ub.parts         override do: end.
       26   for each parts no-lock where
       27            parts.out-code  = 'out-zone':U
       28        and (parts.fact-date < vardate-actual-docs
       29             or parts.fact-date = ?)
       30   on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       31   :
       32     find first trn-doc no-lock where
       33                trn-doc.doc-code = parts.in-code
       34     no-error.
       35     if not avail trn-doc and
       36        not can-find(first free_parts where
       37                           free_parts.obj-type  = parts.obj-type
       38                       and free_parts.obj-code  = parts.obj-code
       39                       and free_parts.artic     = parts.artic
       40                       and free_parts.prod-type = parts.prod-type
       41                       and free_parts.prod-code = parts.prod-code
       42                       and free_parts.in-code   = parts.in-code
       43                       and free_parts.out-code  = 'free-zone':U
       44                       and free_parts.part-code = parts.part-code
       45                       and free_parts.fact-qnty > 0) then
       46     do:
       47       run cleanTable in this-procedure.
       48       find first buf_parts exclusive-lock where
       49              recid(buf_parts) = recid(parts) no-error no-wait.
       50   if not avail buf_parts then
       51   do:
       52     undo, return error "Ошибка удаления parts. Запись занята другим пользователем.".
       53   end.
       54   delete buf_parts.
       55   vDeleted = vDeleted + 1.
       56     end.
       57   end.
       58   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Партии. расходная зона", vDeleted).
       59   return vResult.
       60   procedure cleanTable:
       61     define buffer goods for ub.goods.
       62     for first goods no-lock where
       63               goods.artic     =  parts.artic
       64           and goods.prod-type =  parts.prod-type
       65           and goods.prod-code =  parts.prod-code
       66     :
       67       define buffer parts-attr for ub.parts-attr.
       68   on delete of ub.parts-attr override do: end.
       69   for each parts-attr exclusive-lock
       70       where parts-attr.in-code   = parts.in-code
       71            and parts-attr.gds-code  = goods.gds-code
       72            and parts-attr.part-code = parts.part-code
       73   on error undo, return error
       74   :
       75         delete parts-attr no-error.
       76         if error-status:error then
       77           undo, return error error-status:get-message(1).
       78         vDeleted = vDeleted + 1.
       79   end.
       80       define buffer c-parts-attr for ub.c-parts-attr.
       81   on delete of ub.c-parts-attr override do: end.
       82   for each c-parts-attr exclusive-lock
       83       where c-parts-attr.in-code   = parts.in-code
       84            and c-parts-attr.gds-code  = goods.gds-code
       85            and c-parts-attr.part-code = parts.part-code
       86   on error undo, return error
       87   :
       88         delete c-parts-attr no-error.
       89         if error-status:error then
       90           undo, return error error-status:get-message(1).
       91         vDeleted = vDeleted + 1.
       92   end.
       93     end.
       94     define buffer c-parts for ub.c-parts.
       95   on delete of ub.c-parts override do: end.
       96   for each c-parts exclusive-lock
       97       where c-parts.obj-type  = parts.obj-type
       98           and c-parts.obj-code  = parts.obj-code
       99           and c-parts.artic     = parts.artic
      100           and c-parts.prod-type = parts.prod-type
      101           and c-parts.prod-code = parts.prod-code
      102           and c-parts.in-code   = parts.in-code
      103           and c-parts.out-code  = parts.out-code
      104           and c-parts.part-code = parts.part-code
      105   on error undo, return error
      106   :
      107         delete c-parts no-error.
      108         if error-status:error then
      109           undo, return error error-status:get-message(1).
      110         vDeleted = vDeleted + 1.
      111   end.
      112   end procedure.
