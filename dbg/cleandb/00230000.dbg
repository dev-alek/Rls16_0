        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: 03/10/2025":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00230000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00230000.p $".
        7   define variable vss-description as character no-undo init "Файл пирога чистки БД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define buffer add-doc                for ub.add-doc                  .
       22   define buffer buf_add-doc            for ub.add-doc                  .
       23   on delete of ub.add-doc               override do: end.
       24   for each buf_clients no-lock
       25      where buf_clients.db-num <> ?
       26   :
       27     for each add-doc no-lock where
       28              add-doc.obj-type   = buf_clients.obj-type
       29          and add-doc.obj-code   = buf_clients.obj-code
       30          and add-doc.status_    = 'акт':U
       31          and add-doc.fact-date  < vardate-actual-docs
       32     on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       33     :
       34       run cleanTables in this-procedure.
       35       find first buf_add-doc exclusive-lock where
       36              recid(buf_add-doc) = recid(add-doc) no-error no-wait.
       37   if not avail buf_add-doc then
       38   do:
       39     undo, return error "Ошибка удаления add-doc. Запись занята другим пользователем.".
       40   end.
       41   delete buf_add-doc.
       42   vDeleted = vDeleted + 1.
       43     end.
       44   end.
       45   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Документы доп.расходов с историей", vDeleted).
       46   return vResult.
       47   procedure cleanTable :
       48     define buffer c-add-doc for ub.c-add-doc.
       49   on delete of ub.c-add-doc override do: end.
       50   for each c-add-doc exclusive-lock
       51        where c-add-doc.doc-code = add-doc.doc-code
       52   on error undo, return error
       53   :
       54         delete c-add-doc no-error.
       55         if error-status:error then
       56           undo, return error error-status:get-message(1).
       57         vDeleted = vDeleted + 1.
       58   end.
       59     define buffer add-line for ub.add-line.
       60   on delete of ub.add-line override do: end.
       61   for each add-line exclusive-lock
       62        where add-line.doc-code = add-doc.doc-code
       63   on error undo, return error
       64   :
       65         delete add-line no-error.
       66         if error-status:error then
       67           undo, return error error-status:get-message(1).
       68         vDeleted = vDeleted + 1.
       69   end.
       70     define buffer c-add-line for ub.c-add-line.
       71   on delete of ub.c-add-line override do: end.
       72   for each c-add-line exclusive-lock
       73        where c-add-line.doc-code = add-doc.doc-code
       74   on error undo, return error
       75   :
       76         delete c-add-line no-error.
       77         if error-status:error then
       78           undo, return error error-status:get-message(1).
       79         vDeleted = vDeleted + 1.
       80   end.
       81     define buffer add-trn for ub.add-trn.
       82   on delete of ub.add-trn override do: end.
       83   for each add-trn exclusive-lock
       84        where add-trn.doc-code = add-doc.doc-code
       85   on error undo, return error
       86   :
       87         delete add-trn no-error.
       88         if error-status:error then
       89           undo, return error error-status:get-message(1).
       90         vDeleted = vDeleted + 1.
       91   end.
       92     define buffer add-trn-attr for ub.add-trn-attr.
       93   on delete of ub.add-trn-attr override do: end.
       94   for each add-trn-attr exclusive-lock
       95        where add-trn-attr.doc-code = add-doc.doc-code
       96   on error undo, return error
       97   :
       98         delete add-trn-attr no-error.
       99         if error-status:error then
      100           undo, return error error-status:get-message(1).
      101         vDeleted = vDeleted + 1.
      102   end.
      103   end procedure.
