        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 36493b7e3299, 155, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: sibintek-soft $":U .
        4   define variable vss-date        as character no-undo init "$Date: Sep 15 2025 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: 00045000.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: cleandb/00045000.p $".
        7   define variable vss-description as character no-undo init "Чистка УБД.".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define input parameter vardate-actual-docs    as date      no-undo.
       13   define input parameter varcall-back           as handle no-undo.
       14   define variable vDeleted as int64     no-undo.
       15   define variable vResult  as character no-undo.
       16   define buffer buf_clients for ub.clients.
       17   find ub.sys-ctrl no-lock.
       18   if not available ub.sys-ctrl then do:
       19      return error "Не найдена уникальная запись sys-ctrl.".
       20   end.
       21   define variable v-temp-date     as date no-undo.
       22   define variable v-doc-num       as character no-undo .
       23   define variable v-fact-order    as decimal no-undo .
       24   define variable find-fact-order as decimal no-undo .
       25   define variable v-qnty        like ub.parts.qnty no-undo .
       26   define variable v-sale-base     as decimal   no-undo .
       27   define buffer price-doc      for ub.price-doc.
       28   define buffer buf_price-doc  for ub.price-doc.
       29   define buffer buf_price-list for ub.price-list.
       30   define temp-table tt-price-list like ub.price-list.
       31   on delete of ub.price-doc  override do: end.
       32   on write  of ub.price-doc  override do: end.
       33   on write  of ub.price-list override do: end.
       34   assign
       35     v-temp-date     = vardate-actual-docs - 1
       36     v-fact-order    =  integer(v-temp-date) + 0.97 + 2 * 0.0000000001
       37     find-fact-order =  integer(v-temp-date) + 0.99
       38   .
       39   for each buf_clients no-lock where
       40            buf_clients.db-num <> ?
       41   on error undo, return error SUBSTITUTE("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
       42   :
       43     v-doc-num = "2-" + buf_clients.obj-type
       44               + string( buf_clients.obj-code)
       45               + "_" + string(v-temp-date).
       46     if buf_clients.obj-type  = 'маг':U OR buf_clients.obj-type  = 'скл':U then DO:
       47        for each price-doc no-lock where
       48                 price-doc.obj-type   = buf_clients.obj-type  and
       49                 price-doc.obj-code   = buf_clients.obj-code  and
       50                 price-doc.status_    = 'акт':U      and
       51                 price-doc.fact-date  < vardate-actual-docs
       52        :
       53          RUN cleanTable no-error .
       54          if error-status:error then
       55            undo, return error return-value.
       56          find first buf_price-doc exclusive-lock where
       57              recid(buf_price-doc) = recid(price-doc) no-error no-wait.
       58   if not avail buf_price-doc then
       59   do:
       60     undo, return error "Ошибка удаления price-doc. Запись занята другим пользователем.".
       61   end.
       62   delete buf_price-doc.
       63   vDeleted = vDeleted + 1.
       64        end.
       65        if can-find(first buf_price-list where
       66                          buf_price-list.doc-num = v-doc-num) then
       67        do:
       68         create buf_price-doc .
       69         assign
       70             buf_price-doc.PS         = "Переоценка создана в процессе обрезания базы (по товарам на объекте) "
       71             buf_price-doc.creid      =  USERID("адм")
       72             buf_price-doc.doc-date   =  v-temp-date
       73             buf_price-doc.doc-num    =  v-doc-num
       74             buf_price-doc.fact-date  =  v-temp-date
       75             buf_price-doc.fact-num   =  2
       76             buf_price-doc.fact-order =  v-fact-order
       77             buf_price-doc.fact-time  =  time
       78             buf_price-doc.host-code  =  buf_clients.host-code
       79             buf_price-doc.obj-type   =  buf_clients.obj-type
       80             buf_price-doc.obj-code   =  buf_clients.obj-code
       81             buf_price-doc.sale-base  =  v-sale-base
       82             buf_price-doc.rest-qnty  =  v-qnty
       83             buf_price-doc.shift-date =  ?
       84             buf_price-doc.shift-num  =  ?
       85             buf_price-doc.status_    = 'акт':U
       86             buf_price-doc.cr-db-num  =  0
       87         .
       88        end.
       89     end.
       90   end.
       91   vResult = substitute("Произведена чистка таблиц: &1~nУдалено записей - &2.", "Переоценка с историей", vDeleted).
       92   return vResult.
       93   procedure cleanTable :
       94     define buffer price-list     for ub.price-list.
       95     on delete of ub.price-list  override do: end.
       96     for each price-list exclusive-lock where
       97              price-list.doc-num = price-doc.doc-num
       98     :
       99       run saveLastPriceList in this-procedure (buffer price-list) no-error.
      100       if error-status:error then return error return-value.
      101       if price-list.main-price = yes then do:
      102         define buffer parts for ub.parts.
      103   on delete of ub.parts override do: end.
      104   for each parts exclusive-lock
      105        where parts.out-code  = price-doc.doc-num
      106               and parts.obj-code  = price-doc.obj-code
      107               and parts.obj-type  = price-doc.obj-type
      108               and parts.artic     = price-list.artic
      109               and parts.prod-code = price-list.prod-code
      110               and parts.prod-type = price-list.prod-type
      111   on error undo, return error
      112   :
      113         delete parts no-error.
      114         if error-status:error then
      115           undo, return error error-status:get-message(1).
      116         vDeleted = vDeleted + 1.
      117   end.
      118       end.
      119       delete price-list.
      120       vDeleted = vDeleted + 1.
      121     end.
      122     define buffer price-list-attr for ub.price-list-attr.
      123   on delete of ub.price-list-attr override do: end.
      124   for each price-list-attr exclusive-lock
      125        where price-list-attr.doc-num = price-doc.doc-num
      126   on error undo, return error
      127   :
      128         delete price-list-attr no-error.
      129         if error-status:error then
      130           undo, return error error-status:get-message(1).
      131         vDeleted = vDeleted + 1.
      132   end.
      133     define buffer doc-attr for ub.doc-attr.
      134   on delete of ub.doc-attr override do: end.
      135   for each doc-attr exclusive-lock
      136        where doc-attr.doc-code = price-doc.doc-num
      137   on error undo, return error
      138   :
      139         delete doc-attr no-error.
      140         if error-status:error then
      141           undo, return error error-status:get-message(1).
      142         vDeleted = vDeleted + 1.
      143   end.
      144     define buffer c-doc-attr for ub.c-doc-attr.
      145   on delete of ub.c-doc-attr override do: end.
      146   for each c-doc-attr exclusive-lock
      147        where c-doc-attr.doc-code = price-doc.doc-num
      148   on error undo, return error
      149   :
      150         delete c-doc-attr no-error.
      151         if error-status:error then
      152           undo, return error error-status:get-message(1).
      153         vDeleted = vDeleted + 1.
      154   end.
      155     define buffer c-price-doc for ub.c-price-doc.
      156   on delete of ub.c-price-doc override do: end.
      157   for each c-price-doc exclusive-lock
      158        where c-price-doc.doc-num = price-doc.doc-num
      159   on error undo, return error
      160   :
      161         delete c-price-doc no-error.
      162         if error-status:error then
      163           undo, return error error-status:get-message(1).
      164         vDeleted = vDeleted + 1.
      165   end.
      166     define buffer c-price-list for ub.c-price-list.
      167   on delete of ub.c-price-list override do: end.
      168   for each c-price-list exclusive-lock
      169        where c-price-list.doc-num = price-doc.doc-num
      170   on error undo, return error
      171   :
      172         delete c-price-list no-error.
      173         if error-status:error then
      174           undo, return error error-status:get-message(1).
      175         vDeleted = vDeleted + 1.
      176   end.
      177     define buffer c-price-list-attr for ub.c-price-list-attr.
      178   on delete of ub.c-price-list-attr override do: end.
      179   for each c-price-list-attr exclusive-lock
      180        where c-price-list-attr.doc-num = price-doc.doc-num
      181   on error undo, return error
      182   :
      183         delete c-price-list-attr no-error.
      184         if error-status:error then
      185           undo, return error error-status:get-message(1).
      186         vDeleted = vDeleted + 1.
      187   end.
      188   end procedure.
      189   procedure saveLastPriceList:
      190     define parameter buffer in-price-list for ub.price-list.
      191     define buffer buf_price-list for ub.price-list.
      192     find first buf_price-list no-lock where
      193                buf_price-list.obj-type   = in-price-list.obj-type
      194            and buf_price-list.obj-code   = in-price-list.obj-code
      195            and buf_price-list.b-code     = in-price-list.b-code
      196            and buf_price-list.price-type = in-price-list.price-type
      197            and buf_price-list.fact-order > in-price-list.fact-order
      198            and buf_price-list.fact-order < find-fact-order
      199     no-error.
      200     if not avail buf_price-list and
      201        not can-find(first buf_price-list no-lock where
      202                           buf_price-list.doc-num     = v-doc-num
      203                       and buf_price-list.price-type = in-price-list.price-type
      204                       and buf_price-list.b-code     = in-price-list.b-code)
      205     then do:
      206       create buf_price-list.
      207       buffer-copy in-price-list to buf_price-list assign
      208         buf_price-list.doc-num     = v-doc-num
      209         buf_price-list.fact-order  = v-fact-order
      210         buf_price-list.calc-method = 'Не-считать':U
      211         buf_price-list.price-prev  = 0
      212       .
      213       assign
      214         v-sale-base = v-sale-base + buf_price-list.price-sale * buf_price-list.doc-qnty .
      215         v-qnty      = v-qnty + buf_price-list.doc-qnty .
      216       .
      217       run copy-parts in this-procedure (
      218          input  buf_price-list.doc-num
      219         ,input  buf_price-list.obj-type
      220         ,input  buf_price-list.obj-code
      221         ,input  buf_price-list.artic
      222         ,input  buf_price-list.prod-type
      223         ,input  buf_price-list.prod-code
      224       ) no-error .
      225       if error-status:error then return error return-value.
      226     end.
      227   end procedure.
      228   procedure copy-parts :
      229     define input parameter  p-out-code         like ub.parts.out-code  no-undo .
      230     define input parameter  p-obj-type         like ub.parts.obj-type  no-undo .
      231     define input parameter  p-obj-code         like ub.parts.obj-code  no-undo .
      232     define input parameter  p-artic            like ub.parts.artic     no-undo .
      233     define input parameter  p-prod-type        like ub.parts.prod-type no-undo .
      234     define input parameter  p-prod-code        like ub.parts.prod-code no-undo .
      235     def buffer parts     for ub.parts .
      236     def buffer buf_parts for ub.parts .
      237     do
      238     on error undo, return error
      239     :
      240       for each parts
      241         where parts.obj-type  = p-obj-type
      242           and parts.obj-code  = p-obj-code
      243           and parts.artic     = p-artic
      244           and parts.prod-type = p-prod-type
      245           and parts.prod-code = p-prod-code
      246           and parts.rsrv-free = yes
      247           and parts.status_   = no
      248           and parts.in-code   <> parts.out-code
      249           and parts.fact-date >= vardate-actual-docs
      250       on error undo, return error
      251       :
      252         run partcopy_pr-docw in this-procedure
      253           (input  p-out-code
      254           ,buffer parts
      255           ,buffer buf_parts
      256           ) no-error .
      257         if error-status :error then
      258           return error
      259             "Ошибка при создании партии~n" +
      260             substitute("Объект: &1 &2~n", parts.obj-type, parts.obj-code) +
      261             substitute("Артикул: &1 &2 &3~n", parts.artic, parts.prod-type, parts.prod-code) +
      262             substitute("Партия: &1 &2 ~n", parts.in-code, parts.part-code) +
      263             substitute("Резерв: &1~n", p-out-code).
      264         define variable v-parts-qnty     like ub.parts.qnty no-undo .
      265         define variable v-parts-cli-qnty like ub.parts.cli-qnty no-undo .
      266         if parts.out-code = 'free-zone':U then do:
      267           assign
      268             v-parts-qnty     = parts.qnty
      269             v-parts-cli-qnty = parts.cli-qnty
      270           .
      271         end.
      272         else do:
      273           assign
      274             v-parts-qnty     = abs(parts.qnty)
      275             v-parts-cli-qnty = abs(parts.cli-qnty)
      276           .
      277         end.
      278         assign
      279           buf_parts.qnty      = buf_parts.qnty     + v-parts-qnty
      280           buf_parts.fact-qnty = buf_parts.qnty
      281           buf_parts.real-qnty = buf_parts.qnty
      282           buf_parts.cli-qnty  = buf_parts.cli-qnty + v-parts-cli-qnty
      283         .
      284       end.
      285     end.
      286   end procedure.
      287   procedure partcopy_pr-docw :
      288     define variable vMsg as character no-undo.
      289     define input parameter  p-out-code         like ub.parts.out-code no-undo .
      290     define parameter buffer buf_orig_parts     for ub.parts .
      291     define parameter buffer buf_parts          for ub.parts .
      292     do transaction
      293     on error undo, return error
      294     :
      295       find first buf_parts exclusive-lock
      296         where buf_parts.obj-type  = buf_orig_parts.obj-type
      297           and buf_parts.obj-code  = buf_orig_parts.obj-code
      298           and buf_parts.artic     = buf_orig_parts.artic
      299           and buf_parts.prod-type = buf_orig_parts.prod-type
      300           and buf_parts.prod-code = buf_orig_parts.prod-code
      301           and buf_parts.in-code   = buf_orig_parts.in-code
      302           and buf_parts.out-code  = p-out-code
      303           and buf_parts.part-code = buf_orig_parts.part-code
      304         no-error.
      305       if not available buf_parts then do:
      306         create buf_parts .
      307         buffer-copy buf_orig_parts to buf_parts
      308         assign
      309           buf_parts.out-code  = p-out-code
      310           buf_parts.status_   = yes
      311           buf_parts.rsrv-free = ?
      312           buf_parts.doc-type  = 'акт':U
      313           buf_parts.PS        = 'архив переоценки ' + p-out-code
      314           buf_parts.qnty      = 0
      315           buf_parts.fact-qnty = 0
      316           buf_parts.real-qnty = 0
      317           buf_parts.cli-qnty  = 0
      318         .
      319         validate buf_parts .
      320       end.
      321       else do:
      322         if buf_parts.status_   <> yes
      323         or buf_parts.rsrv-free <> ?
      324         or buf_parts.doc-type  <> 'акт':U
      325         or buf_parts.PS        <> 'архив переоценки ' + p-out-code then
      326         do:
      327           vMsg =
      328             "Ошибка при поиске архивной партии, привязанной к переоценке~n" +
      329             substitute("Переоценка: &1~n", p-out-code) +
      330             substitute("Артикул: &1 &2 &3~n", buf_parts.artic, buf_parts.prod-type, buf_parts.prod-code) +
      331             substitute("status_: &1~n", buf_parts.status_) +
      332             substitute("rsrv-free: &1~n", buf_parts.rsrv-free) +
      333             substitute("doc-type: &1~n", buf_parts.doc-type) +
      334             substitute("PS: &1~n", buf_parts.PS)
      335           .
      336           if valid-handle(varcall-back) then
      337             run callback-write-to-log in varcall-back (
      338               input vMsg
      339             ) no-error .
      340           put unformatted
      341             "Ошибка при поиске архивной партии, привязанной к переоценке" skip
      342             "Переоценка: " p-out-code skip
      343             "Артикул: "    buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      344             "status_: "    buf_parts.status_   skip
      345             "rsrv-free: "  buf_parts.rsrv-free skip
      346             "doc-type: "   buf_parts.doc-type  skip
      347             "PS: "         buf_parts.PS skip
      348           .
      349           undo, return error .
      350         end.
      351       end.
      352     end.
      353   end procedure.
