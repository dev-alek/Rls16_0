     2436   procedure get-db-list-for-d-card3 :
     2437   define input parameter p-d-card as character no-undo .
     2438   define variable v-current-db-processed as logical no-undo .
     2439   define buffer buf_clients  for ub.clients.
     2440   define buffer buf_dis-obj for ub.dis-obj.
     2441   define buffer buf_temp-smart-route for temp-smart-route.
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       for each buf_dis-obj no-lock where
     2446               buf_dis-obj.d-card = p-d-card,
     2447          first buf_clients no-lock where
     2448               buf_clients.obj-type = buf_dis-obj.obj-type
     2449           and buf_clients.obj-code = buf_dis-obj.obj-code
     2450       break by
     2451       buf_clients.db-num:
     2452         if first-of(buf_Clients.db-num) then do:
     2453           find first buf_temp-smart-route no-lock where
     2454                 buf_temp-smart-route.key-field = p-d-card
     2455             and buf_temp-smart-route.db-num = buf_clients.db-num
     2456                 no-error.
     2457           if available buf_temp-smart-route then return.
     2458           create buf_temp-smart-route.
     2459           assign
     2460           buf_temp-smart-route.key-field = p-d-card
     2461           buf_temp-smart-route.db-num = buf_clients.db-num
     2462           .
     2463           if buf_clients.db-num = g#db-num then do:
     2464             v-current-db-processed = yes.
     2465           end.
     2466         end.
     2467       end.
     2468       if not v-current-db-processed then do:
     2469         find first buf_temp-smart-route no-lock where
     2470               buf_temp-smart-route.key-field = p-d-card
     2471           and buf_temp-smart-route.db-num = g#db-num
     2472               no-error.
     2473         if not available buf_temp-smart-route then do:
     2474           create buf_temp-smart-route.
     2475           assign
     2476           buf_temp-smart-route.key-field = p-d-card
     2477           buf_temp-smart-route.db-num = g#db-num
     2478           .
     2479         end.
     2480       end.
     2481     end.
     2482   end procedure.
