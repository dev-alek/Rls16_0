      476   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   define new global shared variable g#lib-nws as handle no-undo .
      478   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   procedure gen-key-rec :
      481     define input  parameter p-tbl-name    as character no-undo.
      482     define input  parameter p-bh_tbl-name as handle    no-undo.
      483     define output parameter p-key-rec     as character no-undo.
      484     do
      485     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      486     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      487     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      488     :
      489       define variable fh               as handle    no-undo .
      490       define variable v-ok             as logical   no-undo .
      491       define variable v-inform         as character no-undo .
      492       define variable v-ind            as integer   no-undo .
      493       define variable v-idx-field-qnty as integer   no-undo .
      494       if p-tbl-name = ?
      495         or p-tbl-name = "":U
      496       then do:
      497         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
      498       end.
      499       if not p-bh_tbl-name:available then do:
      500         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
      501       end.
      502       assign
      503         p-key-rec = p-tbl-name
      504         v-inform  = p-bh_tbl-name:index-information(1)
      505         v-ind     = 2
      506       .
      507       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      508       on error undo, return error
      509       :
      510         assign
      511           v-inform = p-bh_tbl-name:index-information( v-ind )
      512           v-ind    = v-ind + 1
      513         .
      514       end.
      515       if v-inform = ?
      516         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      517         or entry( 3, v-inform, ",":U ) <> "1":U
      518       then do:
      519         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
      520       end.
      521       else do:
      522         assign
      523           v-idx-field-qnty = num-entries( v-inform ) - 4
      524         .
      525         if v-idx-field-qnty < 2 then do:
      526           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
      527         end.
      528         do v-ind = 1 to v-idx-field-qnty by 2
      529         on error undo, return error
      530         :
      531           assign
      532             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      533             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      534           .
      535         end.
      536       end.
      537       if p-key-rec = ? then do:
      538         assign
      539           p-key-rec = "":U
      540         .
      541         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
      542       end.
      543     end.
      544     return.
      545   end procedure.
      546   procedure gen-where-keyr-tab :
      547     define input  parameter i-tableSerach as character no-undo.
      548     define input  parameter i-tablekey   as character  no-undo.
      549     define input  parameter p-key-rec    as character  no-undo.
      550     define input  parameter p-key-handle as handle     no-undo .
      551     define input  parameter p-db-name    as character  no-undo .
      552     define input  parameter p-tt-handle  as handle     no-undo .
      553     define output parameter o-Where      as character  no-undo.
      554     do
      555     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      556     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      557     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      558     :
      559       define variable v-full-tbl-name  as character no-undo .
      560       define variable bh_tbl-name      as handle    no-undo .
      561       define variable fh_key           as handle    no-undo .
      562       define variable fh_search        as handle    no-undo .
      563       define variable v-field-num      as integer   no-undo .
      564       define variable v-count-fld      as integer   no-undo .
      565       define variable v-inform         as character no-undo .
      566       define variable v-ind            as integer   no-undo .
      567       define variable v-idx-field-qnty as integer   no-undo .
      568       define variable v-field-name     as character no-undo .
      569       define variable v-field-val      as character no-undo .
      570       define variable v-word-link      as character no-undo .
      571       define variable vTable           as character no-undo.
      572       define variable bh_tbl-key       as handle    no-undo .
      573       assign
      574         p-key-rec = trim( p-key-rec )
      575       .
      576       if p-key-handle <> ? then do:
      577         if not valid-handle(p-key-handle)
      578            or p-key-handle:type <> "buffer"
      579         then do:
      580           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
      581         end.
      582         if num-entries( p-key-rec, chr(3) ) > 1
      583           or p-key-rec = ?
      584           or p-key-rec = "":U
      585         then do:
      586           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
      587         end.
      588       end.
      589       else do:
      590         if p-key-rec = ?
      591           or p-key-rec = "":U
      592         then do:
      593           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      594         end.
      595       end.
      596       assign
      597         vTable = entry( 1 , p-key-rec, chr(3) )
      598       .
      599       if p-tt-handle <> ?
      600         and ( not valid-handle(p-tt-handle)
      601               or p-tt-handle:type <> "buffer"
      602             )
      603       then do:
      604         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
      605       end.
      606       if p-tt-handle = ? then do:
      607         assign
      608           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      609         .
      610         create buffer bh_tbl-name for table v-full-tbl-name .
      611       end.
      612       else do:
      613         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      614       end.
      615       assign
      616         v-inform = bh_tbl-name:index-information(1)
      617         v-ind    = 2
      618       .
      619       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      620       on error undo, return error
      621       :
      622         assign
      623           v-inform = bh_tbl-name:index-information( v-ind )
      624           v-ind    = v-ind + 1
      625         .
      626       end.
      627       if v-inform = ?
      628         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      629         or entry( 3, v-inform, ",":U ) <> "1":U
      630       then do:
      631         delete object bh_tbl-name no-error.
      632         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
      633       end.
      634       assign
      635         v-idx-field-qnty = num-entries( v-inform ) - 4
      636       .
      637       if v-idx-field-qnty < 2 then do:
      638         delete object bh_tbl-name no-error.
      639         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
      640       end.
      641       assign
      642         o-where     = "where":U
      643         v-word-link = "":U
      644         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      645         v-count-fld = 0
      646       .
      647       if i-tablekey ne "" and i-tablekey ne ?
      648       then do:
      649         assign
      650           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      651         .
      652         create buffer bh_tbl-key for table v-full-tbl-name .
      653       end.
      654       if i-tableSerach ne "" and i-tableSerach ne ?
      655       then do:
      656         delete object bh_tbl-name no-error.
      657         assign
      658           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      659         .
      660         create buffer bh_tbl-name for table v-full-tbl-name .
      661       end.
      662       block_where:
      663       do v-ind = 1 to v-idx-field-qnty by 2
      664       on error undo, return error
      665       :
      666         assign
      667           v-count-fld = v-count-fld + 1
      668         .
      669         if p-key-handle = ?
      670           and v-count-fld > v-field-num
      671         then do:
      672           leave block_where.
      673         end.
      674         define variable VfieldKeyTable as handle no-undo.
      675         assign
      676           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      677           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      678         .
      679         if     bh_tbl-key ne ?
      680         then do:
      681            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      682            if VfieldKeyTable eq ?
      683            then next block_where.
      684         end.
      685         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      686         then
      687            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      688         else
      689            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      690         if p-key-handle = ? then do:
      691           assign
      692             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      693           .
      694         end.
      695         else do:
      696           assign
      697             fh_key = p-key-handle:buffer-field( v-field-name )
      698           .
      699           if fh_key = ?
      700             or not valid-handle( fh_key )
      701           then do:
      702             delete object bh_tbl-name.
      703             if     bh_tbl-key ne ?
      704             then
      705                delete object bh_tbl-key.
      706             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
      707           end.
      708           assign
      709             v-field-val = fh_key:buffer-value
      710           .
      711         end.
      712         if fh_search:data-type ="character":U then do:
      713           assign
      714             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      715             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      716             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      717             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      718             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      719             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      720             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      721             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      722             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      723             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      724             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      725             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      726             v-field-val = substitute( '"&1"', v-field-val )
      727           .
      728         end.
      729         assign
      730           o-where = substitute( "&1 &2", o-where, v-field-val )
      731         .
      732         if v-word-link = "":U then do:
      733           assign
      734             v-word-link = "and":U
      735           .
      736         end.
      737       end.
      738       delete object bh_tbl-name.
      739       if     bh_tbl-key ne ?
      740       then
      741          delete object bh_tbl-key.
      742       if p-key-handle = ?
      743         and v-count-fld <> v-field-num
      744       then do:
      745         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
      746       end.
      747     end.
      748   end procedure.
      749   procedure gen-hn-keyr-tab :
      750     define input  parameter i-tableSerach as character no-undo.
      751     define input  parameter i-tablekey   as character no-undo.
      752     define input  parameter p-key-rec    as character no-undo.
      753     define input  parameter p-key-handle as handle    no-undo .
      754     define input  parameter p-db-name    as character no-undo .
      755     define input  parameter p-tt-handle  as handle    no-undo .
      756     define input  parameter p-stts-lock  as integer   no-undo .
      757     define output parameter o-hn         as handle    no-undo.
      758     define variable v-full-tbl-name as character no-undo.
      759     define variable v-where         as character no-undo.
      760     define variable bh_tbl-name     as handle    no-undo.
      761     define variable vTable          as character no-undo.
      762     do
      763     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      764     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      765     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      766         run gen-where-keyr-tab(i-tableSerach,
      767                                i-tablekey,
      768                                p-key-rec,
      769                                p-key-handle,
      770                                p-db-name,
      771                                p-tt-handle,
      772                                output v-where).
      773         if i-tableSerach ne "" and i-tableSerach ne ?
      774         then do:
      775            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      776            create buffer bh_tbl-name for table v-full-tbl-name .
      777         end.
      778         else do:
      779            if p-tt-handle = ? then do:
      780               assign
      781                  vTable = entry( 1 , p-key-rec, chr(3) )
      782               .
      783               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      784               create buffer bh_tbl-name for table v-full-tbl-name .
      785            end.
      786            else do:
      787               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      788            end.
      789         end.
      790         if p-tt-handle = ? then do:
      791            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      792         end.
      793         else do:
      794            bh_tbl-name:find-first( v-where ) no-error .
      795         end.
      796         o-hn = bh_tbl-name.
      797      end.
      798   end procedure.
      799   procedure gen-hn-keyr :
      800     define input  parameter p-key-rec    as character no-undo.
      801     define input  parameter p-key-handle as handle    no-undo .
      802     define input  parameter p-db-name    as character no-undo .
      803     define input  parameter p-tt-handle  as handle    no-undo .
      804     define input  parameter p-stts-lock  as integer   no-undo .
      805     define output parameter o-hn         as handle    no-undo.
      806     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      807   end.
      808   procedure gen-row-keyr :
      809     define input  parameter p-key-rec    as character no-undo.
      810     define input  parameter p-key-handle as handle    no-undo .
      811     define input  parameter p-db-name    as character no-undo .
      812     define input  parameter p-tt-handle  as handle    no-undo .
      813     define input  parameter p-stts-lock  as integer   no-undo .
      814     define output parameter p-tbl-row    as rowid     no-undo.
      815     define output parameter p-tbl-name   as character no-undo.
      816     define variable vHn as handle no-undo.
      817       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      818       p-tbl-row = if vHn:available then vHn:rowid else ?.
      819       p-tbl-name =  vHn:table.
      820       delete object vHn no-error.
      821     if p-tbl-row = ? then do:
      822       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
      823     end.
      824     else do:
      825       return.
      826     end.
      827   end procedure.
      828   procedure gen-key-fv :
      829     define input  parameter p-key-rec    as character no-undo .
      830     define output parameter p-field-list as character no-undo .
      831     define output parameter p-value-list as character no-undo.
      832     do
      833     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      834     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      835     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      836     :
      837       define variable v-full-tbl-name  as character no-undo .
      838       define variable bh_tbl-name      as handle    no-undo .
      839       define variable v-tbl-name       as character no-undo .
      840       define variable v-field-num      as integer   no-undo .
      841       define variable v-count-fld      as integer   no-undo .
      842       define variable v-inform         as character no-undo .
      843       define variable v-ind            as integer   no-undo .
      844       define variable v-idx-field-qnty as integer   no-undo .
      845       define variable v-delim-key      as character no-undo .
      846       if p-key-rec = ?
      847         or p-key-rec = "":U
      848       then do:
      849         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
      850       end.
      851       assign
      852         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      853         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      854       .
      855       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      856       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
      857       assign
      858         v-inform = bh_tbl-name:index-information(1)
      859         v-ind    = 2
      860       .
      861       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      862       on error undo, return error
      863       :
      864         assign
      865           v-inform = bh_tbl-name:index-information( v-ind )
      866           v-ind    = v-ind + 1
      867         .
      868       end.
      869       if v-inform = ?
      870         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      871         or entry( 3, v-inform, ",":U ) <> "1":U
      872       then do:
      873         delete object bh_tbl-name no-error.
      874         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      875       end.
      876       assign
      877         v-idx-field-qnty = num-entries( v-inform ) - 4
      878       .
      879       if v-idx-field-qnty < 2 then do:
      880         delete object bh_tbl-name no-error.
      881         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      882       end.
      883       assign
      884         p-field-list = "":U
      885         p-value-list = "":U
      886         v-delim-key  = "":U
      887         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      888         v-count-fld  = 0
      889       .
      890       block_where:
      891       do v-ind = 1 to v-idx-field-qnty by 2
      892       on error undo, return error
      893       :
      894         assign
      895           v-count-fld = v-count-fld + 1
      896         .
      897         if v-count-fld > v-field-num then do:
      898           leave block_where.
      899         end.
      900         assign
      901           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      902           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      903         .
      904         if v-ind = 1 then do:
      905           assign
      906             v-delim-key = chr(3)
      907           .
      908         end.
      909       end.
      910       delete object bh_tbl-name.
      911       if v-count-fld <> v-field-num then do:
      912         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
      913       end.
      914     end.
      915   end procedure.
      916   procedure gen-key-field :
      917     define input  parameter p-table      as character no-undo .
      918     define output parameter p-field-list as character no-undo .
      919     do
      920     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      921     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      922     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      923     :
      924       define variable v-full-tbl-name  as character no-undo .
      925       define variable bh_tbl-name      as handle    no-undo .
      926       define variable v-tbl-name       as character no-undo .
      927       define variable v-field-num      as integer   no-undo .
      928       define variable v-count-fld      as integer   no-undo .
      929       define variable v-inform         as character no-undo .
      930       define variable v-ind            as integer   no-undo .
      931       define variable v-idx-field-qnty as integer   no-undo .
      932       define variable v-delim-key      as character no-undo .
      933       if p-table = ?
      934         or p-table = "":U
      935       then do:
      936         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
      937       end.
      938       assign
      939         v-tbl-name      = p-table
      940         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      941       .
      942       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      943       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
      944       assign
      945         v-inform = bh_tbl-name:index-information(1)
      946         v-ind    = 2
      947       .
      948       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      949       on error undo, return error
      950       :
      951         assign
      952           v-inform = bh_tbl-name:index-information( v-ind )
      953           v-ind    = v-ind + 1
      954         .
      955       end.
      956       if v-inform = ?
      957         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      958         or entry( 3, v-inform, ",":U ) <> "1":U
      959       then do:
      960         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
      961       end.
      962       assign
      963         v-idx-field-qnty = num-entries( v-inform ) - 4
      964       .
      965       if v-idx-field-qnty < 2 then do:
      966         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
      967       end.
      968       assign
      969         p-field-list = "":U
      970         v-delim-key  = "":U
      971         v-count-fld  = 0
      972       .
      973       block_where:
      974       do v-ind = 1 to v-idx-field-qnty by 2
      975       on error undo, return error
      976       :
      977         assign
      978           v-count-fld = v-count-fld + 1
      979         .
      980         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      981         if v-ind = 1 then do:
      982           assign
      983             v-delim-key = chr(3)
      984           .
      985         end.
      986       end.
      987       delete object bh_tbl-name.
      988     end.
      989   end procedure.
      990   define SHARED temp-table temp-cmd no-undo
      991   field cmd-code as integer
      992   field db-list as character
      993   index pi is unique primary
      994   db-list
      995   index icmd
      996   cmd-code
      997   .
      998   define SHARED temp-table temp-smart-route no-undo
      999   field key-field as character
     1000   field db-num as integer
     1001   index pi is unique primary
     1002   key-field
     1003   db-num
     1004   .
     1005   define SHARED temp-table temp-no-route no-undo
     1006   field rec-ord as integer
     1007   field db-num as integer
     1008   index pi is unique primary
     1009   db-num
     1010   rec-ord
     1011   index iro
     1012   rec-ord
     1013   .
     1014   define SHARED temp-table temp-smart-link no-undo
     1015   field uniq-key-rec as character
     1016   field key-field as character
     1017   field rec-ord as integer
     1018   field is-smart as logical
     1019   index pi is unique primary
     1020   key-field
