     2151   procedure get-db-list-for-d-card:
     2152   define input parameter p-d-card as character no-undo .
     2153   define variable v-current-db-processed as logical no-undo .
     2154   define buffer buf_clients  for ub.clients.
     2155   define buffer buf_dis-obj for ub.dis-obj.
     2156   define buffer buf_temp-smart-route for temp-smart-route.
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       for each buf_dis-obj no-lock where
     2161               buf_dis-obj.d-card = p-d-card,
     2162          first buf_clients no-lock where
     2163               buf_clients.obj-type = buf_dis-obj.obj-type
     2164           and buf_clients.obj-code = buf_dis-obj.obj-code
     2165       break by
     2166       buf_clients.db-num:
     2167         if first-of(buf_Clients.db-num) then do:
     2168           find first buf_temp-smart-route no-lock where
     2169                 buf_temp-smart-route.key-field = p-d-card
     2170             and buf_temp-smart-route.db-num = buf_clients.db-num
     2171                 no-error.
     2172           if available buf_temp-smart-route then return.
     2173           create buf_temp-smart-route.
     2174           assign
     2175           buf_temp-smart-route.key-field = p-d-card
     2176           buf_temp-smart-route.db-num = buf_clients.db-num
     2177           .
     2178           if buf_clients.db-num = g#db-num then do:
     2179             v-current-db-processed = yes.
     2180           end.
     2181         end.
     2182       end.
     2183       if not v-current-db-processed then do:
     2184         find first buf_temp-smart-route no-lock where
     2185               buf_temp-smart-route.key-field = p-d-card
     2186           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2187         if not available buf_temp-smart-route then do:
     2188           create buf_temp-smart-route.
     2189           assign
     2190           buf_temp-smart-route.key-field = p-d-card
     2191           buf_temp-smart-route.db-num = g#db-num
     2192           .
     2193         end.
     2194       end.
     2195     end.
     2196   end procedure.
