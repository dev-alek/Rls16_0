     2611     for each buf_term-dis-time-rule no-lock where
     2612             buf_term-dis-time-rule.upper-time-rule-num = buf_dis-time-rule.time-rule-num:
     2613       if buf_term-dis-time-rule.time-from <= p-time
     2614       and buf_term-dis-time-rule.time-to >= p-time
     2615       and buffer buf_term-dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2616       then do:
     2617         return yes.
     2618       end.
     2619     end.
     2620   end.
     2621   return no.
     2622   end function.
     2623   FUNCTION DIS-TIME-RULE_00010 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2624   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2625   find first buf_dis-time-rule no-lock where
     2626             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2627   if available buf_dis-time-rule
     2628   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2629     if buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes
     2630     then do:
     2631       return yes.
     2632     end.
     2633   end.
     2634   return no.
     2635   end function.
     2636   FUNCTION DIS-TIME-RULE_00011 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2637   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2638   find first buf_dis-time-rule no-lock where
     2639             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2640   if available buf_dis-time-rule
     2641   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2642     if (buf_dis-time-rule.week-day-0 = yes
     2643     or (buffer buf_dis-time-rule:buffer-field("week-day-" + string(loc-weekday(p-date) )):buffer-value = yes))
     2644     and (buf_dis-time-rule.time-from <= p-time
     2645     and buf_dis-time-rule.time-to >= p-time)
     2646     then do:
     2647       return yes.
     2648     end.
     2649   end.
     2650   return no.
     2651   end function.
     2652   FUNCTION DIS-TIME-RULE_00012 returns logical ( input p-time-rule-num as integer, input p-date as date, input p-time as integer):
     2653   define buffer buf_dis-time-rule for ub.dis-time-rule.
     2654   find first buf_dis-time-rule no-lock where
     2655             buf_dis-time-rule.time-rule-num = p-time-rule-num no-error.
     2656   if available buf_dis-time-rule
     2657   and buf_dis-time-rule.sts = integer ('0':U) then do:
     2658     if buf_dis-time-rule.time-from <= p-time
     2659     then do:
     2660       return yes.
     2661     end.
     2662   end.
     2663   return no.
     2664   end function.
     2665   FUNCTION dis-rule_00059 returns integer ( input p-rule-num as integer
     2666                                           , input p-date as date
     2667                                           , input p-time as integer
     2668                                           , input p-tot-sum as decimal ):
     2669   define variable v-delta as decimal no-undo .
     2670   define variable v-start as logical no-undo init yes.
     2671   define variable v-dis-kat-value as integer no-undo .
     2672   define buffer buf_dis-rule for ub.dis-rule.
     2673   define buffer buf_term-dis-rule for ub.dis-rule.
     2674   find first buf_dis-rule no-lock where
     2675           buf_dis-rule.rule-num = p-rule-num no-error.
     2676   if available buf_dis-rule
     2677   and buf_dis-rule.sts = integer('0':U)
     2678   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     2679   then do:
     2680     for each buf_term-dis-rule no-lock where
     2681             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     2682       if buf_term-dis-rule.tot-sum <= p-tot-sum then do:
     2683         if v-start
     2684         or v-delta  > (p-tot-sum - buf_term-dis-rule.tot-sum)
     2685         then do:
     2686           assign
     2687           v-dis-kat-value = buf_term-dis-rule.dis-kat
     2688           v-start = no
     2689           v-delta = p-tot-sum - buf_term-dis-rule.tot-sum
     2690           .
     2691         end.
     2692       end.
     2693     end.
     2694     return v-dis-kat-value.
     2695   end.
     2696   return 0.
     2697   end function.
     2698   on delete of this-procedure do:
     2699     run garbcoll_clear in this-procedure .
     2700   end.
     2701   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     2702   if return-value = "return" then return ''.
     2703    define variable Card1 as class Dis-card_ no-undo .
     2704   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2705    define variable Tot-sum-obj1 as class Dis-tot_obj no-undo .
     2706   Tot-sum-obj1 = new Dis-tot_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     2707    define variable Discount-obj1 as class Discount_obj no-undo .
     2708   Discount-obj1 = new Discount_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save, input 26) .
     2709    define variable v-netto-sum1 as  decimal no-undo .
     2710   if not this-procedure:persistent then do:
     2711     run proc-main in this-procedure ( input p-type
     2712                                 ,input p-emitent-host-code ) no-error .
     2713     if error-status:error then do:
     2714         run garbcoll_clear in this-procedure .
     2715         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2716     end.
     2717     run garbcoll_clear in this-procedure .
     2718     empty temp-table temp-dis-rule.
     2719   end.
     2720   procedure proc-main :
     2721   define input parameter p-type like ub.dis-card.type no-undo .
     2722   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     2723   _main:
     2724   do
     2725   on error undo, return error return-value
     2726   :
     2727   assign
     2728   v-emitent-host-code = p-emitent-host-code
     2729   v-type = p-type.
     2730     _d-card:
     2731     for each temp-d-card where
     2732             temp-d-card.type = p-type
     2733         and temp-d-card.emitent-host-code = p-emitent-host-code
     2734     break
     2735     by temp-d-card.d-card
     2736     On error undo _d-card, retry _d-card:
     2737       if temp-d-card.d-card = '_' then next.
     2738       num-rec = num-rec + 1.
     2739       if retry then do:
     2740         if p-ruleset-id = 5 then do:
     2741           num-rec-calc-err = num-rec-calc-err + 1.
     2742           undo _d-card, next _d-card .
     2743         end.
     2744         else do:
     2745           undo _main, return error return-value .
     2746         end.
     2747       end.
     2748       assign
     2749       v-current-d-card = temp-d-card.d-card
     2750       v-netto-sum1 = 0
     2751       .
     2752      IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     2753       IF  Tot-sum-obj1:find_Dis-tot_obj( INPUT v-current-d-card, INPUT v-current-obj-type, INPUT v-current-obj-code) = true  THEN do:
     2754         IF  p-r-b = "rubl" AND p-is-over = false  THEN do:
     2755            v-netto-sum1 = Tot-sum-obj1:pay-tot-rubl .
     2756         end.
     2757         IF  p-r-b = "rubl" AND p-is-over = true  THEN do:
     2758            v-netto-sum1 = Tot-sum-obj1:pay-tot-rubl_byf# .
     2759         end.
     2760         IF  p-r-b = "base" AND p-is-over = false  THEN do:
     2761            v-netto-sum1 = Tot-sum-obj1:pay-tot-base .
     2762         end.
     2763         IF  p-r-b = "base" AND p-is-over = true  THEN do:
     2764            v-netto-sum1 = Tot-sum-obj1:pay-tot-base_byf# .
     2765         end.
     2766       end.
     2767      end.
     2768   IF  Discount-obj1:find_discount_obj( INPUT v-current-d-card, INPUT v-current-obj-type, INPUT v-current-obj-code) = false  THEN do:
     2769     IF  Discount-obj1:create_discount_obj( INPUT v-current-d-card, INPUT v-current-obj-type, INPUT v-current-obj-code) = false  THEN do:
     2770        undo _main, return error v-last-error-message .
     2771     end.
     2772   end.
     2773    DIscount-obj1:category = dis-rule_00059( INPUT p-rule-num-obj, INPUT v-current-doc-date, INPUT v-current-doc-time, INPUT v-netto-sum1) .
     2774    IF  Discount-obj1:discount_objsave( ) = false  THEN do:
     2775      undo _main, return error v-last-error-message .
     2776   end.
     2777   Card1:Dis-card_release_ ( ) .
     2778   Tot-sum-obj1:Dis-tot_objrelease_ ( ) .
     2779   Discount-obj1:Discount_objrelease_ ( ) .
     2780         num-rec-ok = num-rec-ok + 1.
     2781         if p-ruleset-id = 5 then do:
     2782           run set-num-rec in p-parent-handle ( input num-rec
     2783                                               ,input num-rec-calc-err
     2784                                               ,input num-rec-value-err
     2785                                               ,input num-rec-ok
     2786                                               ,input no
     2787                                               ) no-error .
     2788         end.
     2789       end.
     2790       if p-ruleset-id = 5 then do:
     2791         run set-num-rec in p-parent-handle ( input num-rec
     2792                                             ,input num-rec-calc-err
     2793                                             ,input num-rec-value-err
     2794                                             ,input num-rec-ok
     2795                                             ,input yes
     2796                                             ) no-error .
     2797       end.
     2798     end.
     2799   end procedure.
     2800   procedure load-ruleset-context :
     2801   define input parameter p-ruleset-id as integer no-undo .
     2802   define buffer buf_rule-call-param for ub.rule-call-param.
     2803   define buffer buf_dis-rule for ub.dis-rule.
     2804     do
     2805     on error undo, return error
     2806     :
     2807    find first buf_rule-call-param no-lock where
     2808   buf_rule-call-param.codex_id = p-codex-id
     2809   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2810   and buf_rule-call-param.call_id = p-call-id
     2811   and buf_rule-call-param.order_id = p-order-id
     2812   and buf_rule-call-param.rule_id = p-rule-id
     2813   and buf_rule-call-param.param-name = "p-r-b"
     2814    no-error.
     2815   if available buf_rule-call-param then do:
     2816   assign p-r-b = buf_rule-call-param.param-value-character.
     2817   end.
     2818    find first buf_rule-call-param no-lock where
     2819   buf_rule-call-param.codex_id = p-codex-id
     2820   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2821   and buf_rule-call-param.call_id = p-call-id
     2822   and buf_rule-call-param.order_id = p-order-id
     2823   and buf_rule-call-param.rule_id = p-rule-id
     2824   and buf_rule-call-param.param-name = "p-is-over"
     2825    no-error.
     2826   if available buf_rule-call-param then do:
     2827   assign p-is-over = buf_rule-call-param.param-value-logical.
     2828   end.
     2829    for each buf_rule-call-param no-lock where
     2830   buf_rule-call-param.codex_id = p-codex-id
     2831   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2832   and buf_rule-call-param.call_id = p-call-id
     2833   and buf_rule-call-param.order_id = p-order-id
     2834   and buf_rule-call-param.rule_id = p-rule-id
     2835   and buf_rule-call-param.param-name = "p-rule-num-obj"
     2836   and buf_rule-call-param.p-index > 0,
     2837     first Buf_dis-rule no-lock where
     2838           buf_dis-rule.rule-num = buf_rule-call-param.param-value-integer:
     2839     find first temp-dis-rule no-lock where
     2840               temp-dis-rule.rule-num = buf_dis-rule.rule-num no-error.
     2841     if not available temp-dis-rule then do:
     2842       create temp-dis-rule.
     2843       buffer-copy buf_dis-rule to temp-dis-rule.
     2844       release temp-dis-rule.
     2845     end.
     2846   end.
     2847       assign
     2848       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2849       .
     2850       case p-ruleset-id:
     2851         when 1 then do:
     2852           assign
     2853           v-sign = 1
     2854           v-current-host-code = p-host-code
     2855           v-current-obj-type = p-obj-type
     2856           v-current-obj-code = p-obj-code
     2857           v-current-db-num = g#db-num
     2858           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2859           v-current-doc-code = p-doc-code
     2860           v-current-doc-date = p-doc-date
     2861           v-current-doc-fact-date = p-fact-date
     2862           v-current-date = p-doc-date
     2863           v-current-fact-date = p-fact-date
     2864           .
     2865         end.
     2866         when 2 then do:
     2867           assign
     2868           v-sign = -1
     2869           v-current-host-code = p-host-code
     2870           v-current-obj-type = p-obj-type
     2871           v-current-obj-code = p-obj-code
     2872           v-current-db-num = g#db-num
     2873           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2874           v-current-doc-code = p-doc-code
     2875           v-current-doc-date = p-doc-date
     2876           v-current-doc-fact-date = p-fact-date
     2877           v-current-date = p-doc-date
     2878           v-current-fact-date = p-fact-date
     2879           .
     2880         end.
     2881         when 3 then do:
     2882           assign
     2883           v-sign = 1
     2884           v-current-host-code = p-host-code
     2885           v-current-obj-type = p-obj-type
     2886           v-current-obj-code = p-obj-code
     2887           v-current-db-num = g#db-num
     2888           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2889           v-current-doc-code = p-doc-code
     2890           v-current-doc-date = p-doc-date
     2891           v-current-doc-time = 0
     2892           v-current-doc-fact-date = p-fact-date
     2893           v-current-date = p-doc-date
     2894           v-current-fact-date = p-fact-date
     2895           .
     2896         end.
     2897         when 4 then do:
     2898           assign
     2899           v-sign = -1
     2900           v-current-host-code = p-host-code
     2901           v-current-obj-type = p-obj-type
     2902           v-current-obj-code = p-obj-code
     2903           v-current-db-num = g#db-num
     2904           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2905           v-current-doc-code = p-doc-code
     2906           v-current-doc-date = p-doc-date
     2907           v-current-doc-time = 0
     2908           v-current-doc-fact-date = p-fact-date
     2909           v-current-date = p-doc-date
     2910           v-current-fact-date = p-fact-date
     2911           .
     2912         end.
     2913         otherwise do:
     2914           undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     2915         end.
     2916       end case.
     2917       find first temp-dis-rule no-lock where
     2918                   temp-dis-rule.obj-type = v-current-obj-type
     2919               and temp-dis-rule.obj-code = v-current-obj-code no-error.
     2920       if not available temp-dis-rule then do:
     2921         find first temp-dis-rule no-lock where
     2922                     temp-dis-rule.host-code = v-current-host-code no-error.
     2923       end.
     2924       if not available temp-dis-rule then do:
     2925         empty temp-table temp-dis-rule.
     2926         return "return".
     2927       end.
     2928       p-rule-num-obj = temp-dis-rule.rule-num.
     2929     end.
     2930   end procedure.
     2931   procedure delete-procedure :
     2932     do
     2933     on error undo, return error
     2934     :
     2935         run garbcoll_clear in this-procedure .
     2936     end.
     2937   end procedure.
