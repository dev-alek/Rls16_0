      100   define new global shared variable g#vssrevis-logger as handle    no-undo .
      101   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      102   define variable v-vssrevis-logger                   as handle    no-undo .
      103   procedure vss-logevent :
      104     define input  parameter p-extra-paramters as character no-undo .
      105     define variable v-vssrevis-parameters as character no-undo .
      106     do
      107     on error undo, return error return-value
      108     :
      109       if  valid-handle(v-vssrevis-logger)
      110       and v-vssrevis-logger :get-signature("logevent") <> ""
      111       then do:
      112         run vss-get-parameters in this-procedure
      113           (output v-vssrevis-parameters
      114           ).
      115         run logevent in v-vssrevis-logger
      116           (input vss-workfile
      117           ,input vss-revision
      118           ,input v-vssrevis-parameters
      119           ,input p-extra-paramters
      120           ).
      121       end.
      122     end.
      123   end procedure.
      124   assign
      125     v-vssrevis-logger = g#vssrevis-logger
      126   .
      127   if  valid-handle(v-vssrevis-logger)
      128   and v-vssrevis-logger :get-signature("logevent") <> ""
      129   then do:
      130     assign
      131       v-vssrevis-logevent = true
      132     .
      133     run vss-logevent in this-procedure (input vss-description) .
      134   end.
