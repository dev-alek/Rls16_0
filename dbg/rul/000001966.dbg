     1582     index ifn full-name
     1583     index is-term
     1584     is-term
     1585     node-name
     1586     index level
     1587     upper-code
     1588     node-name
     1589     index level-num
     1590     lvl-num
     1591     upper-code
     1592     node-name
     1593     index oi order-num
     1594     index isel to-sel
     1595     .
     1596   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   define  SHARED  temp-table ggrp-list-hist no-undo
     1598   field list-table as character
     1599   field id as integer
     1600   field line as integer
     1601   field hist-mode as character
     1602   field des as character
     1603   field num-recs as integer
     1604   field option_ as character
     1605   field item_ as character
     1606   field status_ as character
     1607   field num-add as integer
     1608   field num-ignored as integer
     1609   field done as logical
     1610   field err_ as logical
     1611   field err-mes as character
     1612   index pi is primary
     1613   id
     1614   line
     1615   index isdone
     1616   done
     1617   .
     1618   define variable vss-include-info11 as character format "X(65)" no-undo
     1619   initial "@(#)$Workfile$ $Revision$".
     1620   define temp-table temp_grplib_grp no-undo
     1621       field sel           as character
     1622       field nabor         as character
     1623       field full-name     as character
     1624       field print-code    as character
     1625       field sort-name     as character
     1626       field node-code     as integer
     1627       field upper-code    as integer
     1628       field calc-method   as character
     1629       field round-method  as character
     1630       field increase-pc   as decimal
     1631       field min-marg      as character
     1632       field max-marg      as character
     1633       field cli-type      as character
     1634       field cli-code      as integer
     1635       field notcorr      as character
     1636       field name          as character
     1637       field level         as integer
     1638       field mark          as character
     1639       index pi is primary unique sort-name
     1640       index fn full-name
     1641       index nc is unique node-code
     1642       index sl sel
     1643       index uc upper-code
     1644   .
     1645   define temp-table temp_grplib_found-grp no-undo
     1646       field full-name   as character
     1647       field sort-name   as character
     1648       field node-code   as integer
     1649       field level       as integer
     1650       field is-terminal as logical
     1651       index pi is primary unique sort-name
     1652       index fn full-name
     1653       index lv level
     1654       index it is-terminal
     1655   .
     1656   define temp-table temp_found-result-nodelist no-undo
     1657       field node-code     as recid
     1658       field processed     as logical
     1659       field sort-name     as character
     1660       field full-name     as character
     1661       index pi is primary unique node-code
     1662       index ps processed
     1663   .
     1664   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1665   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1666   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1667   procedure grplib-get-parameters :
     1668   define input parameter p-store-type     as character        no-undo.
     1669   define input parameter p-store-code     as integer          no-undo.
     1670   do
     1671   on error undo, return error
     1672   :
     1673       assign
     1674           v-grplib-not-fill-extra-info = no
     1675       .
     1676   end.
     1677   end procedure.
     1678   procedure grplib-get-sort-name :
     1679   do
     1680   on error undo, return error
     1681   :
     1682   define input parameter p-node-code  as integer      no-undo.
     1683   define output parameter p-sort-name as character    no-undo.
     1684       define variable v-upper-code    as integer           no-undo.
     1685       define buffer buf_gds-grp       for ub.gds-grp.
     1686       define buffer buf_upper_gds-grp for ub.gds-grp.
     1687       find first buf_gds-grp no-lock
     1688            where buf_gds-grp.node-code = p-node-code
     1689       no-error.
     1690       if not available buf_gds-grp
     1691       then do:
     1692           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1693       end.
     1694       assign
     1695           p-sort-name  = ""
     1696           v-upper-code = 1
     1697       .
     1698       do while buf_gds-grp.upper-code <> 0
     1699       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1700       :
     1701           assign
     1702               p-sort-name  = buf_gds-grp.node-name
     1703                            + (if p-sort-name <> "" then chr(2) else "")
     1704                            + p-sort-name
     1705               v-upper-code = buf_gds-grp.upper-code
     1706           .
     1707           find first buf_gds-grp no-lock
     1708                where buf_gds-grp.node-code = v-upper-code
     1709           no-error.
     1710           if not available buf_gds-grp
     1711           then do:
     1712               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1713                                   + string( v-upper-code )
     1714                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1715           end.
     1716       end.
     1717   end.
     1718   end procedure.
     1719   define variable vss-include-info12 as character format "X(65)" no-undo
     1720   initial "@(#)$Workfile$ $Revision$".
     1721   procedure grplib-get-full-name :
     1722      define input parameter p-node-code  as integer      no-undo.
     1723      define output parameter p-full-name as character    no-undo.
     1724      do
     1725   on error undo, return error
     1726   :
     1727       define variable v-upper-code    as integer           no-undo.
     1728       define buffer buf_gds-grp       for ub.gds-grp.
     1729       define buffer buf_upper_gds-grp for ub.gds-grp.
     1730       find first buf_gds-grp no-lock
     1731            where buf_gds-grp.node-code = p-node-code
     1732       no-error.
     1733       if not available buf_gds-grp
     1734       then do:
     1735           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1736       end.
     1737       assign
     1738           p-full-name  = ""
     1739           v-upper-code = 1
     1740       .
     1741       do while buf_gds-grp.upper-code <> 0
     1742       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1743       :
     1744           assign
     1745               p-full-name  = buf_gds-grp.node-name
     1746                            + (if p-full-name <> "" then chr(47) else "")
     1747                            + p-full-name
     1748               v-upper-code = buf_gds-grp.upper-code
     1749           .
     1750           find first buf_gds-grp no-lock
     1751                where buf_gds-grp.node-code = v-upper-code
     1752           no-error.
     1753           if not available buf_gds-grp
     1754           then do:
     1755               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1756                                   + string( v-upper-code )
     1757                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1758           end.
     1759       end.
     1760       assign
     1761       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1762       .
     1763   end.
     1764   end .
     1765   procedure grplib-get-node-from-full-name :
     1766   define input parameter p-full-name as character no-undo .
     1767   define output parameter p-node-code as integer no-undo .
     1768   define variable v-ii as integer no-undo .
     1769   define variable v-upper-code as integer no-undo .
     1770   define variable v-root-code as integer no-undo .
     1771   define variable v-entry as character no-undo .
     1772   define buffer buf_gds-grp       for ub.gds-grp.
     1773   do
     1774   on error undo, return error
     1775   :
     1776     find first buf_gds-grp no-lock
     1777         where buf_gds-grp.upper-code = 0
     1778     no-error .
     1779     if not available buf_gds-grp
     1780     then do:
     1781         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1782     end.
     1783     else do:
     1784       assign
     1785       v-root-code = buf_gds-grp.node-code
     1786       .
     1787     end.
     1788     v-upper-code = v-root-code.
     1789     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1790       assign
     1791       v-entry = entry(v-ii, p-full-name, chr(47)).
     1792       if v-entry = '' then leave.
     1793       find first buf_gds-grp no-lock where
     1794                 buf_gds-grp.node-name = v-entry
     1795             and buf_gds-grp.upper-code = v-upper-code
     1796             no-error.
     1797       if not available buf_gds-grp then do:
     1798         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1799       end.
     1800       else do:
     1801         p-node-code = buf_gds-grp.node-code.
     1802         v-upper-code = buf_gds-grp.node-code.
     1803       end.
     1804     end.
     1805   end.
     1806   end .
     1807   procedure grplib-get-root-code :
     1808   do
     1809   on error undo, return error
     1810   :
     1811   define output parameter p-root-code as integer      no-undo.
     1812       define buffer buf_gds-grp       for ub.gds-grp.
     1813       find first buf_gds-grp no-lock
     1814           where buf_gds-grp.upper-code = 0
     1815       no-error .
     1816       if not available buf_gds-grp
     1817       then do:
     1818           undo, return error .
     1819       end.
     1820       else do:
     1821           assign
     1822               p-root-code = buf_gds-grp.node-code
     1823           .
     1824       end.
     1825   end.
     1826   end procedure.
     1827   procedure grplib-find-grp-by-full-name :
     1828   do
     1829   on error undo, return error
     1830   :
     1831   define input parameter p-search-name  as character    no-undo.
     1832   define input parameter p-fill-path    as logical      no-undo.
     1833   define output parameter p-found       as logical      no-undo.
     1834       define variable v-upper-code    as integer          no-undo.
     1835       define variable v-counter       as integer           no-undo.
     1836       define variable v-level         as integer           no-undo.
     1837       define variable v-full-name     as character         no-undo.
     1838       define variable v-sort-name     as character         no-undo.
     1839       define buffer buf_gds-grp       for ub.gds-grp.
     1840       assign
     1841           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1842       .
     1843       run grplib-get-root-code ( output v-upper-code ) no-error .
     1844       if error-status :error
     1845       then do:
     1846           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1847       end.
     1848       assign
     1849           v-full-name  = ""
     1850           v-level      = num-entries( p-search-name, chr(2) )
     1851       .
     1852       for each temp_grplib_found-grp
     1853       :
     1854           delete temp_grplib_found-grp.
     1855       end.
     1856       start-name-analyze:
     1857       do v-counter = 1 to v-level
     1858       :
     1859           if v-counter < v-level
     1860           then do:
     1861               find first buf_gds-grp no-lock
     1862                    where buf_gds-grp.upper-code = v-upper-code
     1863                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1864               no-error .
     1865               if not available buf_gds-grp
     1866               then do:
     1867                   assign
     1868                       v-full-name  = p-search-name
     1869                       v-sort-name  = p-search-name
     1870                   .
     1871                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1872               end.
     1873               else do:
     1874                   assign
     1875                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1876                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1877                       v-upper-code = buf_gds-grp.node-code
     1878                   .
     1879                   if p-fill-path = yes
     1880                   then do:
     1881                       create temp_grplib_found-grp.
     1882                       assign
     1883                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1884                           temp_grplib_found-grp.sort-name = v-sort-name
     1885                           temp_grplib_found-grp.node-code = v-upper-code
     1886                           temp_grplib_found-grp.level     = v-counter
     1887                       .
     1888                   end.
     1889               end.
     1890           end.
     1891           else do:
     1892               for each buf_gds-grp no-lock
     1893                  where buf_gds-grp.upper-code = v-upper-code
     1894                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1895               :
     1896                   assign
     1897                       p-found = yes
     1898                   .
     1899                   create temp_grplib_found-grp.
     1900                   assign
     1901                       temp_grplib_found-grp.full-name = v-full-name
     1902                                                           + (if v-full-name = "" then "" else chr(47) )
     1903                                                           + buf_gds-grp.node-name + chr(47)
     1904                       temp_grplib_found-grp.sort-name = v-sort-name
     1905                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1906                                                           + buf_gds-grp.node-name
     1907                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1908                       temp_grplib_found-grp.level     = v-level
     1909                   .
     1910               end.
     1911               if p-found = no
     1912               then do:
     1913                   assign
     1914                       v-full-name  = p-search-name
     1915                       v-sort-name  = p-search-name
     1916                   .
     1917                   for each temp_grplib_found-grp
     1918                   :
     1919                       delete temp_grplib_found-grp.
     1920                   end.
     1921                   assign
     1922                       p-found = no
     1923                   .
     1924               end.
     1925           end.
     1926       end.
     1927   end.
     1928   end procedure.
     1929   procedure grplib-find-all-subgroup :
     1930   do
     1931   on error undo, return error
     1932   :
     1933   define input parameter p-start-node-code    as integer      no-undo.
     1934   define input parameter p-terminal-only      as logical      no-undo.
     1935       define variable v-start-full-name   as character     no-undo.
     1936       define variable v-start-sort-name   as character     no-undo.
     1937       define variable v-not-found         as logical       no-undo.
     1938       define variable v-is-terminal       as logical       no-undo.
     1939       define buffer buf_gds-grp           for ub.gds-grp.
     1940       create temp_found-result-nodelist.
     1941       assign
     1942           temp_found-result-nodelist.node-code = p-start-node-code
     1943           temp_found-result-nodelist.processed = no
     1944       .
     1945       run grplib-get-full-name in this-procedure (
     1946             input p-start-node-code
     1947           , output v-start-full-name
     1948       ).
     1949       run grplib-get-full-name in this-procedure (
     1950             input p-start-node-code
     1951           , output v-start-sort-name
     1952       ).
     1953       process-nodes:
     1954       do while yes
     1955       :
     1956           find first temp_found-result-nodelist
     1957                where temp_found-result-nodelist.node-code = p-start-node-code
     1958           .
     1959           assign
     1960               temp_found-result-nodelist.processed = yes
     1961           .
     1962           for each buf_gds-grp no-lock
     1963              where buf_gds-grp.upper-code = p-start-node-code
     1964           on error undo, return error
     1965           :
     1966               run grplib-is-terminal in this-procedure (
     1967                     input buf_gds-grp.node-code
     1968                   , output v-is-terminal
     1969               ).
     1970               if v-is-terminal = yes
     1971               then do:
     1972                   create temp_grplib_found-grp.
     1973                   assign
     1974                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1975                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1976                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1977                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1978                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1979                       temp_grplib_found-grp.is-terminal = yes
     1980                   .
     1981               end.
     1982               else do:
     1983                   create temp_found-result-nodelist.
     1984                   assign
     1985                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1986                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1987                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1988                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1989                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1990                       temp_found-result-nodelist.processed = no
     1991                   .
     1992                   if p-terminal-only = no
     1993                   then do:
     1994                       create temp_grplib_found-grp.
     1995                       assign
     1996                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1997                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1998                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1999                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     2000                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     2001                           temp_grplib_found-grp.is-terminal = no
     2002                       .
     2003                   end.
     2004               end.
     2005           end.
     2006           find first temp_found-result-nodelist
     2007                where temp_found-result-nodelist.processed = no
     2008           no-error.
     2009           if not available temp_found-result-nodelist
     2010           then do:
     2011               leave process-nodes.
     2012           end.
     2013           else do:
     2014               assign
     2015                   p-start-node-code = temp_found-result-nodelist.node-code
     2016                   v-start-full-name = temp_found-result-nodelist.full-name
     2017                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2018               .
     2019           end.
     2020       end.
     2021   end.
     2022   end procedure.
     2023   procedure grplib-expand-name :
     2024   define input parameter p-start-name as character        no-undo.
     2025   define output parameter p-end-name  as character        no-undo.
     2026       define variable v-is-terminal   as logical      no-undo.
     2027       define variable v-found         as character    no-undo.
     2028       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     2029   do
     2030   for buf_temp_grplib_found-grp
     2031   on error undo, return error
     2032   :
     2033       run grplib-find-grp-by-full-name in this-procedure (
     2034             input p-start-name
     2035           , input no
     2036           , output v-found
     2037       ) no-error.
     2038       run grplib-get-max-substring in this-procedure (
     2039                   input length( p-start-name )
     2040                 , output p-end-name
     2041       ) no-error .
     2042       if error-status :error
     2043       then do:
     2044           assign
     2045               p-end-name = ""
     2046           .
     2047       end.
     2048       else do:
     2049           find first temp_grplib_found-grp
     2050               where temp_grplib_found-grp.full-name = p-end-name
     2051           no-error.
     2052           if available temp_grplib_found-grp
     2053           then do:
     2054               find first buf_temp_grplib_found-grp
     2055                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     2056                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     2057               no-error.
     2058               if not available buf_temp_grplib_found-grp
     2059               then do:
     2060                   run grplib-is-terminal in this-procedure (
     2061                       input temp_grplib_found-grp.node-code
     2062                       , output v-is-terminal
     2063                   ).
     2064               end.
     2065           end.
     2066       end.
     2067   end.
     2068   end procedure.
     2069   procedure grplib-get-max-substring :
     2070   do
     2071   on error undo, return error
     2072   :
     2073   define input parameter p-min-substring-length   as integer      no-undo.
     2074   define output parameter p-substring             as character    no-undo.
     2075           define variable v-char-counter  as integer           no-undo.
     2076           define variable v-current-char  as character         no-undo.
     2077           define variable v-names-counter  as integer           no-undo.
     2078           define variable v-base-string   as character         no-undo.
     2079           assign
     2080               v-char-counter  = p-min-substring-length
     2081           .
     2082           find first temp_grplib_found-grp no-error.
     2083           if not available temp_grplib_found-grp
     2084           then do:
     2085               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2086           end.
     2087           else do:
     2088               assign
     2089                   v-base-string  = temp_grplib_found-grp.full-name
     2090                   v-char-counter = 0
     2091               .
     2092               counter-block:
     2093               do while yes
     2094               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2095               :
     2096                   assign
     2097                       v-char-counter  = v-char-counter + 1
     2098                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2099                       v-names-counter = 0
     2100                   .
     2101                   compare-block:
     2102                   for each temp_grplib_found-grp
     2103                   :
     2104                       assign
     2105                           v-names-counter = v-names-counter + 1
     2106                       .
     2107                       if v-names-counter = 1
     2108                       then do:
     2109                           next compare-block.
     2110                       end.
     2111                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2112                       then do:
     2113                           leave counter-block.
     2114                       end.
     2115                   end.
     2116                   if v-names-counter = 1
     2117                   then do:
     2118                       assign
     2119                           p-substring = v-base-string
     2120                       .
     2121                       return.
     2122                   end.
     2123               end.
     2124               assign
     2125                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2126               .
     2127           end.
     2128   end.
     2129   end procedure.
     2130   procedure grplib-is-terminal :
     2131   do
     2132   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     2133   :
     2134   define input parameter p-node-code      as integer      no-undo.
     2135   define output parameter p-is-terminal   as logical      no-undo.
     2136       define buffer buf_gds-grp       for ub.gds-grp.
     2137       find first buf_gds-grp no-lock
     2138           where buf_gds-grp.upper-code = p-node-code
     2139       no-error .
     2140       if not available buf_gds-grp
     2141       then do:
     2142           assign
     2143               p-is-terminal = yes
     2144           .
     2145       end.
     2146       else do:
     2147           assign
     2148               p-is-terminal = no
     2149           .
     2150       end.
     2151   end.
     2152   end procedure.
     2153   procedure grplib-have-goods :
     2154   do
     2155   on error undo, return error
     2156   :
     2157   define input parameter p-node-code      as integer      no-undo.
     2158   define output parameter p-have-goods   as logical      no-undo.
     2159       define buffer buf_goods         for ub.goods.
     2160       find first buf_goods no-lock
     2161            where buf_goods.grp-code = p-node-code
     2162       no-error .
     2163       if available buf_goods
     2164       then do:
     2165           assign
     2166               p-have-goods = yes
     2167           .
     2168       end.
     2169       else do:
     2170           assign
     2171               p-have-goods = no
     2172           .
     2173       end.
     2174   end.
     2175   end procedure.
     2176   procedure grplib-find-by-substring :
     2177   do
     2178   on error undo, return error
     2179   :
     2180   define input parameter p-start-code         as integer      no-undo.
     2181   define input parameter p-full-search-string as character    no-undo.
     2182   define output parameter p-found-code        as integer      no-undo.
     2183   define output parameter p-full-name         as character    no-undo.
     2184       define variable v-start-code     as integer           no-undo.
     2185       define variable v-found          as logical  init no  no-undo.
     2186       define buffer buf_gds-grp       for ub.gds-grp.
     2187       search-grp:
     2188       for each buf_gds-grp no-lock
     2189           where buf_gds-grp.node-code > p-start-code
     2190       :
     2191           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     2192           then do:
     2193               assign
     2194                   p-found-code = buf_gds-grp.node-code
     2195                   v-found      = yes
     2196               .
     2197               run grplib-get-full-name in this-procedure (
     2198                     input p-found-code
     2199                   , output p-full-name
     2200               ) no-error .
     2201               if error-status :error
     2202               then do:
     2203                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2204               end.
     2205               leave search-grp.
     2206           end.
     2207       end.
     2208       if v-found = yes
     2209       then do:
     2210       end.
     2211       else do:
     2212           assign
     2213               p-full-name  = ""
     2214               p-found-code = 0
     2215           .
     2216       end.
     2217   end.
     2218   end procedure.
     2219   procedure grplib-analyze-grp-name :
     2220   do
     2221   on error undo, return error
     2222   :
     2223   define input parameter p-grp-name       as character            no-undo.
     2224   define input parameter p-upper-code     as integer              no-undo.
     2225   define output parameter p-error-message as character init ""    no-undo.
     2226       define variable v-char-list     as character    no-undo.
     2227       define variable v-char-counter  as integer      no-undo.
     2228       define variable v-full-name     as character    no-undo.
     2229       if p-grp-name = "" then do:
     2230           assign
     2231               p-error-message = "Название группы не может быть пустым.".
     2232           .
     2233       end.
     2234       else do:
     2235           assign
     2236               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2237           .
     2238           do v-char-counter = 1 to num-entries( v-char-list )
     2239           :
     2240               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2241               then do:
     2242                   assign
     2243                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2244                   .
     2245                   return.
     2246               end.
     2247           end.
     2248           if p-upper-code > 0
     2249           then do:
     2250               run grplib-get-full-name in this-procedure (
     2251                     input p-upper-code
     2252                   , output v-full-name
     2253               ) no-error .
     2254               if error-status :error
     2255               then do:
     2256                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2257               end.
     2258               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     2259               then do:
     2260                   assign
     2261                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     2262                   .
     2263               end.
     2264           end.
     2265       end.
     2266   end.
     2267   end procedure.
     2268   procedure grplib-get-lvl-num :
     2269   define input parameter p-node-code  as integer      no-undo.
     2270   define output parameter p-lvl-num   as integer      no-undo.
     2271       define variable v-full-name    as character    no-undo.
     2272   do
     2273   on error undo, return error
     2274   :
     2275       run grplib-get-full-name in this-procedure (
     2276             input p-node-code
     2277           , output v-full-name
     2278       ).
     2279       assign
     2280           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2281       .
     2282       if p-lvl-num = -1
     2283       then do:
     2284           assign
     2285               p-lvl-num = 0
     2286           .
     2287       end.
     2288   end.
     2289   end procedure.
     2290   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2291   procedure grp-obj-write :
     2292   do
     2293   on error undo, return error
     2294   :
     2295   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
     2296   define input parameter p-host-code  as integer                          no-undo.
     2297   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
     2298   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
     2299   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
     2300   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
     2301   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
     2302   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
     2303   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
     2304   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
     2305   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
     2306   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
     2307   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2308       find first buf_gds-grp-obj exclusive-lock
     2309            where buf_gds-grp-obj.node-code  = p-node-code
     2310              and buf_gds-grp-obj.host-code  = p-host-code
     2311              and buf_gds-grp-obj.obj-type   = p-obj-type
     2312              and buf_gds-grp-obj.obj-code   = p-obj-code
     2313       no-error.
     2314       if not available buf_gds-grp-obj
     2315       then do:
     2316           create buf_gds-grp-obj.
     2317           assign
     2318                   buf_gds-grp-obj.node-code  = p-node-code
     2319                   buf_gds-grp-obj.host-code  = p-host-code
     2320                   buf_gds-grp-obj.obj-type   = p-obj-type
     2321                   buf_gds-grp-obj.obj-code   = p-obj-code
     2322           .
     2323       end.
     2324       assign
     2325       buf_gds-grp-obj.min-increase = p-min-increase
     2326       buf_gds-grp-obj.max-increase = p-max-increase
     2327       buf_gds-grp-obj.increase-pc = p-increase-pc
     2328       buf_gds-grp-obj.calc-method = p-calc-method
     2329       buf_gds-grp-obj.round-method = p-round-method
     2330       buf_gds-grp-obj.round-coef = p-round-coef
     2331       buf_gds-grp-obj.cli-type   = p-cli-type
     2332       buf_gds-grp-obj.cli-code   = p-cli-code
     2333       .
     2334   end.
     2335   end procedure.
     2336   procedure grp-obj-margin-value :
     2337   do
     2338   on error undo, return error
     2339   :
     2340   define input parameter p-node-code as integer      no-undo.
     2341   define input parameter p-obj-type  as character    no-undo.
     2342   define input parameter p-obj-code  as integer      no-undo.
     2343   define output parameter p-min-value as decimal      no-undo init ?.
     2344   define output parameter p-max-value as decimal      no-undo init ?.
     2345   define output parameter p-increase-pc as decimal      no-undo init ?.
     2346   define output parameter p-round-method as character no-undo init "":U.
     2347   define output parameter p-base as decimal no-undo init ?.
     2348   define output parameter p-range-margin     as integer      no-undo.
     2349   define output parameter p-exists-margin    as logical      no-undo.
     2350   define output parameter p-range-increase     as integer      no-undo.
     2351   define output parameter p-exists-increase    as logical      no-undo.
     2352   define output parameter p-range-rmethod     as integer no-undo .
     2353   define output parameter p-exists-rmethod    as logical no-undo .
     2354   define variable v-host-code as integer      no-undo.
     2355   DEFINE VARIABLE v-found as logical no-undo .
     2356   DEFINE VARIABLE v-exists as logical no-undo .
     2357   DEFINE VARIABLE v-range as integer no-undo .
     2358   DEFINE VARIABLE jj as integer no-undo .
     2359   DEFINE VARIABLE v-margin-found as logical no-undo .
     2360   DEFINE VARIABLE v-increase-found as logical no-undo .
     2361   DEFINE VARIABLE v-min-value as decimal      no-undo.
     2362   DEFINE VARIABLE v-max-value as decimal      no-undo.
     2363   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
     2364   define variable v-round-method as character no-undo .
     2365   define variable v-base as decimal no-undo .
     2366   define variable v-print-code as character no-undo .
     2367   define buffer buf_gds-grp for ub.gds-grp.
     2368   find first buf_gds-grp no-lock where
     2369              buf_gds-grp.node-code = p-node-code no-error .
     2370   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2371     message
     2372       vss-workfile vss-revision vss-description
     2373       skip "Не удалось найти группу товаров с кодом" p-node-code
     2374       view-as alert-box error .
     2375     undo, return error .
     2376   end.
     2377   if p-obj-type <> '' then do:
     2378   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2380     (input  p-obj-type
     2381     ,input  p-obj-code
     2382     ,output v-host-code
     2383     ) no-error .
     2384     if error-status :error
     2385     then do:
     2386         message
     2387           vss-workfile vss-revision vss-description
     2388           skip "Не удалось найти фирму объекта"
     2389           skip p-obj-type p-obj-code
     2390           skip return-value
     2391           skip trim(error-status :get-message(1))
     2392               trim(error-status :get-message(2))
     2393               trim(error-status :get-message(3))
     2394               trim(error-status :get-message(4))
     2395               trim(error-status :get-message(5))
     2396         view-as alert-box error.
     2397         undo, return error .
     2398     end.
     2399   end.
     2400   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2401   do while v-found = no and jj < 2:
     2402     if v-range <> 3 then do:
     2403       find first buf_gds-grp-obj no-lock
     2404           where buf_gds-grp-obj.node-code = p-node-code
     2405             and buf_gds-grp-obj.host-code = v-host-code
     2406             and buf_gds-grp-obj.obj-type  = p-obj-type
     2407             and buf_gds-grp-obj.obj-code  = p-obj-code
     2408       no-error .
     2409     end.
     2410     if v-range = 3 or not available buf_gds-grp-obj
     2411     then do:
     2412        if v-range <> 2 then do:
     2413           find first buf_gds-grp-obj no-lock
     2414               where buf_gds-grp-obj.node-code = p-node-code
     2415                 and buf_gds-grp-obj.host-code = v-host-code
     2416                 and buf_gds-grp-obj.obj-type  = ""
     2417                 and buf_gds-grp-obj.obj-code  = 0
     2418           no-error .
     2419         end.
     2420         if v-range = 2 or not available buf_gds-grp-obj
     2421         then do:
     2422             if v-range <> 1 then do:
     2423               find first buf_gds-grp-obj no-lock
     2424                   where buf_gds-grp-obj.node-code = p-node-code
     2425                   and buf_gds-grp-obj.host-code = 0
     2426                   and buf_gds-grp-obj.obj-type  = ""
     2427                   and buf_gds-grp-obj.obj-code  = 0
     2428               no-error .
     2429             end.
     2430             if v-range = 1 or not available buf_gds-grp-obj
     2431             then do:
     2432                 assign
     2433                     v-exists = no
     2434                 .
     2435             end.
     2436             else do:
     2437                 assign
     2438                     v-exists = yes
     2439                     v-range = 1
     2440                 .
     2441             end.
     2442         end.
     2443         else do:
     2444             assign
     2445                 v-exists = yes
     2446                 v-range  = 2
     2447             .
     2448         end.
     2449     end.
     2450     else do:
     2451         assign
     2452             v-exists = yes
     2453             v-range  = 3
     2454         .
     2455     end.
     2456     if available buf_gds-grp-obj
     2457     then do:
     2458       assign
     2459       v-min-value    = buf_gds-grp-obj.min-increase
     2460       v-max-value    = buf_gds-grp-obj.max-increase
     2461       v-increase-pc  = buf_gds-grp-obj.increase-pc
     2462       v-round-method = buf_gds-grp-obj.round-method
     2463       v-base         = buf_gds-grp-obj.round-coef
     2464       .
     2465       assign
     2466       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
     2467                           then yes
     2468                           else p-exists-margin)
     2469       p-range-margin = if p-exists-margin and p-min-value = ?
     2470                         then v-range
     2471                         else p-range-margin
     2472       p-min-value   =  if p-exists-margin and  p-min-value = ?
     2473                         then v-min-value
     2474                         else p-min-value
     2475       p-max-value   =  if p-exists-margin and  p-max-value = ?
     2476                         then v-max-value
     2477                         else p-max-value
     2478       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
     2479                           then yes
     2480                           else p-exists-increase)
     2481       p-range-increase = if p-exists-increase and p-increase-pc = ?
     2482                         then v-range
     2483                         else p-range-increase
     2484       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
     2485                         then v-increase-pc
     2486                         else p-increase-pc)
     2487       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
     2488                           then yes
     2489                           else p-exists-rmethod
     2490       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
     2491                           then v-range
     2492                           else p-range-rmethod)
     2493       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
     2494                           then v-round-method
     2495                           else p-round-method)
     2496       p-base          = (if p-exists-rmethod and p-base = ?
     2497                           then v-base
     2498                           else p-base)
     2499       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
     2500       jj = jj + 1
     2501       .
     2502     end.
     2503     else do:
     2504       assign
     2505       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
     2506       jj = jj + 1
     2507       .
     2508     end.
     2509   end.
     2510   end.
     2511   end procedure.
     2512   procedure grp-obj-income-cli-value :
     2513   do
     2514   on error undo, return error
     2515   :
     2516   define input parameter p-node-code as integer      no-undo.
     2517   define input parameter p-obj-type  as character    no-undo.
     2518   define input parameter p-obj-code  as integer      no-undo.
     2519   define output parameter p-cli-type as character    no-undo init ?.
     2520   define output parameter p-cli-code as integer      no-undo init ?.
     2521   define output parameter p-range-income-cli     as integer      no-undo.
     2522   define output parameter p-exists-income-cli    as logical      no-undo.
     2523   define variable v-host-code as integer      no-undo.
     2524   DEFINE VARIABLE v-found as logical no-undo .
     2525   DEFINE VARIABLE v-exists as logical no-undo .
     2526   DEFINE VARIABLE v-range as integer no-undo .
     2527   DEFINE VARIABLE jj as integer no-undo .
     2528   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     2529   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     2530   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     2531   define buffer buf_gds-grp for ub.gds-grp.
     2532   find first buf_gds-grp no-lock where
     2533              buf_gds-grp.node-code = p-node-code no-error .
     2534   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2535     message
     2536       vss-workfile vss-revision vss-description
     2537       skip "Не удалось найти группу товаров с кодом" p-node-code
     2538       view-as alert-box error .
     2539     undo, return error .
     2540   end.
     2541   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2543     (input  p-obj-type
     2544     ,input  p-obj-code
     2545     ,output v-host-code
     2546     ) no-error .
     2547   if error-status :error
     2548   then do:
     2549       message
     2550         vss-workfile vss-revision vss-description
     2551         skip "Не удалось найти фирму объекта"
     2552         skip p-obj-type p-obj-code
     2553         skip return-value
     2554         skip trim(error-status :get-message(1))
     2555              trim(error-status :get-message(2))
     2556              trim(error-status :get-message(3))
     2557              trim(error-status :get-message(4))
     2558              trim(error-status :get-message(5))
     2559       view-as alert-box error.
     2560       undo, return error .
     2561   end.
     2562   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2563   do while v-found = no and jj < 2:
     2564     if v-range <> 3 then do:
     2565       find first buf_gds-grp-obj no-lock
     2566           where buf_gds-grp-obj.node-code = p-node-code
     2567             and buf_gds-grp-obj.host-code = v-host-code
     2568             and buf_gds-grp-obj.obj-type  = p-obj-type
     2569             and buf_gds-grp-obj.obj-code  = p-obj-code
     2570       no-error .
     2571     end.
     2572     if v-range = 3 or not available buf_gds-grp-obj
     2573     then do:
     2574        if v-range <> 2 then do:
     2575           find first buf_gds-grp-obj no-lock
     2576               where buf_gds-grp-obj.node-code = p-node-code
     2577                 and buf_gds-grp-obj.host-code = v-host-code
     2578                 and buf_gds-grp-obj.obj-type  = ""
     2579                 and buf_gds-grp-obj.obj-code  = 0
     2580           no-error .
     2581         end.
     2582         if v-range = 2 or not available buf_gds-grp-obj
     2583         then do:
     2584             if v-range <> 1 then do:
     2585               find first buf_gds-grp-obj no-lock
     2586                   where buf_gds-grp-obj.node-code = p-node-code
     2587                   and buf_gds-grp-obj.host-code = 0
     2588                   and buf_gds-grp-obj.obj-type  = ""
     2589                   and buf_gds-grp-obj.obj-code  = 0
     2590               no-error .
     2591             end.
     2592             if v-range = 1 or not available buf_gds-grp-obj
     2593             then do:
     2594                 assign
     2595                     v-exists = no
     2596                 .
     2597             end.
     2598             else do:
     2599                 assign
     2600                     v-exists = yes
     2601                     v-range = 1
     2602                 .
     2603             end.
     2604         end.
     2605         else do:
     2606             assign
     2607                 v-exists = yes
     2608                 v-range  = 2
     2609             .
     2610         end.
     2611     end.
     2612     else do:
     2613         assign
     2614             v-exists = yes
     2615             v-range  = 3
     2616         .
     2617     end.
     2618     if available buf_gds-grp-obj
     2619     then do:
     2620       assign
     2621       v-cli-type-value    = buf_gds-grp-obj.cli-type
     2622       v-cli-code-value    = buf_gds-grp-obj.cli-code
     2623       .
     2624       assign
     2625       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     2626                           then yes
     2627                           else p-exists-income-cli)
     2628       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     2629                         then v-range
     2630                         else p-range-income-cli
     2631       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     2632                         then v-cli-type-value
     2633                         else p-cli-type
     2634       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     2635                         then v-cli-code-value
     2636                         else p-cli-code
     2637       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     2638       jj = jj + 1
     2639       .
     2640     end.
     2641     else do:
     2642       assign
     2643       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     2644       jj = jj + 1
     2645       .
     2646     end.
     2647   end.
     2648   end.
     2649   end procedure.
     2650   define temp-table temp-gds-grp-obj no-undo like ub.gds-grp-obj.
     2651   define variable v-current-node-code as integer no-undo .
     2652   define variable v-current-host-code as integer no-undo .
     2653   define variable v-current-obj-type as character no-undo .
     2654   define variable v-current-obj-code as integer no-undo .
     2655   define variable v-current-lock as integer no-undo .
     2656   define variable v-current-wait as integer no-undo .
     2657   define variable v-save as integer no-undo .
     2658   define variable v-esys-cmd-proc-handle as handle no-undo .
     2659   define variable v-esys-cmd-code as integer no-undo .
     2660   define variable log-file-name                as character      no-undo init "process-gds-grp-list.txt".
     2661   define variable v-view-log                   as logical        no-undo .
     2662   define variable v-stop                       as logical        no-undo .
     2663   define variable v-current-db-num as integer no-undo .
     2664   define variable v-last-error-message as character no-undo .
     2665   define variable file-name as char.
     2666   define variable v-sign as integer no-undo .
     2667   define variable v-gate-rec as character no-undo .
     2668   define variable num-rec as integer no-undo .
     2669   define variable num-rec-ok as integer no-undo .
     2670   define variable v-esys-id-list-start as character no-undo .
     2671   define variable v-pck-num-rec as integer no-undo init 1000.
     2672   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2673   procedure set-error :
     2674   define input parameter p-mess as character no-undo .
     2675     do
     2676     on error undo, return error
     2677     :
     2678        assign
     2679        v-last-error-message = p-mess.
     2680     end.
     2681   end procedure.
     2682   define buffer buf_temp-cmd for temp-cmd.
     2683   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     2684    define variable p-esys-id-list as integer no-undo.
     2685    define variable p-xsd-file as character no-undo.
     2686   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2687   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     2688   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     2689   function context_begin-esys-command return logical
     2690   (
     2691       input p-esys-id-list as character
     2692      ,input-output p-esys-cmd-proc-handle as handle
     2693      ,output p-esys-cmd-code as integer
     2694   ):
     2695      if not valid-handle(p-esys-cmd-proc-handle )
     2696      then do:
     2697        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     2698        if error-status :error
     2699        then do:
     2700           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     2701                                              "&5&4&6"
     2702                                              ,vss-workfile
     2703                                              ,vss-revision
     2704                                              ,vss-description
     2705                                              ,chr(10)
     2706                                              ,error-status:get-message(1)
     2707                                              ,return-value )).
     2708        end.
     2709        run begin-create-command in p-esys-cmd-proc-handle
     2710          (input 'cmd-esys-general':U
     2711          ,input p-esys-id-list
     2712          ,output p-esys-cmd-code
     2713          ) no-error.
     2714        if error-status :error
     2715        then do:
     2716          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     2717                                                           , 'cmd-esys-general':U
     2718                                                           , error-status:get-message(1)
     2719                                                           , return-value
     2720                                                           )).
     2721          return no .
     2722        end.
     2723        return yes.
     2724      end.
     2725   end.
     2726   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2727   function context_send-esys-command return logical
     2728   (
     2729       input p-esys-id-list as character
     2730      ,input p-esys-cmd-proc-handle as handle
     2731      ,input p-esys-cmd-code as integer
     2732      ,input p-user-id as character
     2733   ):
     2734      define variable v-dmp-ord-int64 as int64 no-undo .
     2735      if valid-handle(p-esys-cmd-proc-handle )
     2736      then do:
     2737         run send-command-esys in p-esys-cmd-proc-handle
     2738             (input p-esys-cmd-code
     2739             ,input p-esys-id-list
     2740             ,input p-user-id
     2741             ,output v-dmp-ord-int64
     2742             ) no-error.
     2743         if error-status :error
     2744         then do:
     2745            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     2746                                                           , p-esys-id-list
     2747                                                           , p-cmd-code
     2748                                                           , chr(10)
     2749                                                           , error-status:get-message(1)
     2750                                                           , return-value
     2751                                                           )).
     2752            return no .
     2753         end.
     2754         delete procedure p-esys-cmd-proc-handle no-error.
     2755         return yes.
     2756      end.
     2757      else do:
     2758         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     2759                                                       , p-esys-id-list
     2760                                                       , p-cmd-code
     2761                                                       , chr(10)
     2762                                                       , error-status:get-message(1)
     2763                                                       , return-value
     2764                                                       )).
     2765         return no .
     2766      end.
     2767   end.
     2768   on delete of this-procedure do:
     2769     run garbcoll_clear in this-procedure .
     2770     for each temp-gds-grp-obj:
     2771       delete temp-gds-grp-obj.
     2772     end.
     2773   end.
     2774   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     2775   if error-status:error then do:
     2776     undo, return error return-value .
     2777   end.
     2778   define variable ExpData1 as class Route-data_ no-undo .
     2779   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     2780   if not this-procedure:persistent then do:
     2781     run proc-main in this-procedure no-error .
     2782     if error-status:error then do:
     2783       run garbcoll_clear in this-procedure .
     2784       for each temp-gds-grp-obj:
     2785         delete temp-gds-grp-obj.
     2786       end.
     2787       undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     2788     end.
     2789     run garbcoll_clear in this-procedure .
     2790     for each temp-gds-grp-obj:
     2791       delete temp-gds-grp-obj.
     2792     end.
     2793   end.
     2794   procedure proc-main :
     2795   _main:
     2796   do
     2797   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     2798   :
     2799     define variable v-ii as integer no-undo .
     2800     define variable v-pck-num-rec as integer no-undo init 1000.
     2801     define variable v-next-file as logical no-undo .
     2802     define variable v-margins-range     as integer           no-undo.
     2803     define variable v-margins-exists    as logical           no-undo.
     2804     define variable v-increase-range    as integer           no-undo.
     2805     define variable v-increase-exists   as logical           no-undo.
     2806     define variable v-min-marg          as decimal           no-undo.
     2807     define variable v-max-marg          as decimal           no-undo.
     2808     define variable v-increase-pc       as decimal           no-undo.
     2809     define variable v-round-method      as character         no-undo .
     2810     define variable v-rmethod-range     as integer           no-undo .
     2811     define variable v-rmethod-exists    as logical           no-undo .
     2812     define variable v-base              as decimal           no-undo .
     2813     define variable v-round-method-str  as character         no-undo .
     2814     define variable v-root-code         as integer no-undo .
     2815     define buffer buf_gds-grp for ub.gds-grp.
     2816     define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2817     define buffer buf_ext-system for ub.ext-system.
     2818     for each temp-gds-grp-obj:
     2819       delete temp-gds-grp-obj.
     2820     end.
     2821     create temp-gds-grp-obj.
     2822     run grplib-get-root-code in this-procedure ( output v-root-code) .
     2823     _stroka:
     2824     for each ggrp-list
     2825     break
     2826     by entry(1, ggrp-list.full-name, chr(47))
     2827     On error undo _stroka, next _stroka
     2828     :
     2829       if ggrp-list.node-code = v-root-code then do:
     2830               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Корневая группа товаров не экспортируется (вн код.&1)", ggrp-list.node-code)).                      assign v-view-log = yes.
     2831         next _stroka.
     2832       end.
     2833       assign
     2834       v-current-node-code = ggrp-list.node-code
     2835       num-rec = num-rec + 1
     2836       temp-gds-grp-obj.round-method = ?
     2837       temp-gds-grp-obj.round-coef = ?
     2838       .
     2839       IF num-rec = 1
     2840       or num-rec modulo v-pck-num-rec = 1
     2841       THEN do:
     2842         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     2843           undo _main, return error v-last-error-message .
     2844         end.
     2845         IF  context_begin-esys-command( input v-esys-id-list-start, input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     2846           undo _main, return error v-last-error-message .
     2847         end.
     2848       end.
     2849       if p-save >= 0 then do:
     2850         find first buf_gds-grp exclusive-lock where
     2851                   buf_gds-grp.node-code = ggrp-list.node-code no-error.
     2852       end.
     2853       else do:
     2854         find first buf_gds-grp no-lock where
     2855                   buf_gds-grp.node-code = ggrp-list.node-code no-error.
     2856       end.
     2857       if not available buf_gds-grp then do:
     2858               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена содержащаяся в списке группа товаров с вн.кодом &1", ggrp-list.node-code)).                      assign v-view-log = yes.
     2859         next _stroka.
     2860       end.
     2861       find first buf_gds-grp-obj no-lock where
     2862               buf_gds-grp-obj.node-code  = ggrp-list.node-code
     2863              and buf_gds-grp-obj.host-code  = 0
     2864              and buf_gds-grp-obj.obj-type   = "":U
     2865              and buf_gds-grp-obj.obj-code   = 0 no-error  .
     2866       ExpData1:route-data_create-record( INPUT "gds-grp-01") .
     2867       ExpData1:route-data_copy-record( INPUT "gds-grp-01", INPUT  (buffer ggrp-list:handle) ) .
     2868       ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2869                                       , INPUT "full-name"
     2870                                       , INPUT (buffer ggrp-list:handle:buffer-field("full-name")) ) .
     2871       if available buf_gds-grp-obj then do:
     2872         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2873                                         , INPUT "round-method"
     2874                                         , INPUT (buffer buf_gds-grp-obj:handle:buffer-field("round-method")) ) .
     2875         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2876                                         , INPUT "round-coef"
     2877                                         , INPUT (buffer buf_gds-grp-obj:handle:buffer-field("round-coef")) ) .
     2878       end.
     2879       else do:
     2880         run grp-obj-margin-value in this-procedure (
     2881                                   input ggrp-list.node-code
     2882                                 , input ""
     2883                                 , input 0
     2884                                 , output v-min-marg
     2885                                 , output v-max-marg
     2886                                 , output v-increase-pc
     2887                                 , output v-round-method
     2888                                 , output v-base
     2889                                 , output v-margins-range
     2890                                 , output v-margins-exists
     2891                                 , output v-increase-range
     2892                                 , output v-increase-exists
     2893                                 , output v-rmethod-range
     2894                                 , output v-rmethod-exists
     2895                             ) no-error .
     2896         assign
     2897         temp-gds-grp-obj.round-method = v-round-method
     2898         temp-gds-grp-obj.round-coef = v-base
     2899         .
     2900         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2901                                         , INPUT "round-method"
     2902                                         , INPUT (buffer temp-gds-grp-obj:handle:buffer-field("round-method")) ) .
     2903         ExpData1:route-data_copy-field( INPUT "gds-grp-01"
     2904                                         , INPUT "round-coef"
     2905                                         , INPUT (buffer temp-gds-grp-obj:handle:buffer-field("round-coef")) ) .
     2906       end.
     2907       IF  ExpData1:esys-add-dump( INPUT "gds-grp-01", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     2908         undo _main, return error v-last-error-message .
     2909       end.
     2910       num-rec-ok = num-rec-ok + 1.
     2911       run write-counter in p-log-handle ( input substitute("Обработано групп товаров: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2912       run get-stop-state in p-log-handle ( output v-stop) no-error .
     2913       if v-stop then do:
     2914           run write-log-and-file in p-log-handle (
     2915                                                   input 1
     2916                                                 , input log-file-name
     2917                                                 , input 1
     2918                                                 , input substitute("Процесс прерван пользователем")).
     2919           leave _stroka.
     2920       end.
     2921       if num-rec modulo v-pck-num-rec = 0 then do:
     2922         v-next-file = yes.
     2923       end.
     2924       if last( entry(1, ggrp-list.full-name, chr(47)))
     2925       or (v-next-file and last-of(entry(1, ggrp-list.full-name, chr(47))))
     2926       then do:
     2927         v-next-file = no.
     2928         IF  context_send-esys-command( input v-esys-id-list-start, input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     2929           undo _main, return error v-last-error-message .
     2930         end.
     2931               ExpData1:Route-data_clear-data ( ) .
     2932       end.
     2933     end.
     2934     ExpData1:route-data_clear-xmlschema ( ).
     2935     run write-log-and-file in p-log-handle (
     2936           input 1
     2937         , input log-file-name
     2938         , input 1
     2939         , input substitute("Обработано групп товаров: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2940     ExpData1:route-data_clear-xmlschema ( ).
     2941   end.
     2942   end procedure.
     2943   procedure load-ruleset-context :
     2944   define input parameter p-ruleset-id as integer no-undo .
     2945   define buffer buf_rule-call-param for tt0-rule-call-param.
     2946   define buffer buf_ext-system for ub.ext-system.
     2947     do
     2948     on error undo, return error
     2949     :
     2950   for each buf_rule-call-param no-lock where
     2951   buf_rule-call-param.codex_id = p-codex-id
     2952   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2953   and buf_rule-call-param.call_id = p-call-id
     2954   and buf_rule-call-param.order_id = p-order-id
     2955   and buf_rule-call-param.rule_id = p-rule-id
     2956   and buf_rule-call-param.param-name = "p-esys-id-list",
     2957     first buf_ext-system no-lock where
     2958           buf_Ext-system.esys-id = buf_rule-call-param.param-value-integer
     2959       and buf_Ext-system.db-num = 0
     2960       and buf_Ext-system.esys-have-export = yes
     2961       and buf_Ext-system.esys-db-num-exp = g#db-num:
     2962     v-esys-id-list-start = v-esys-id-list-start + (if v-esys-id-list-start = '' then '' else chr(1)) + string(buf_ext-system.esys-id).
     2963     assign
     2964     v-pck-num-rec = min(v-pck-num-rec, (if buf_ext-system.esys-max-p-size > 0
     2965                                         then buf_ext-system.esys-max-p-size
     2966                                         else v-pck-num-rec)).
     2967   end.
     2968   if v-esys-id-list-start = '' then return "return".
     2969     find first buf_rule-call-param no-lock where
     2970   buf_rule-call-param.codex_id = p-codex-id
     2971   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2972   and buf_rule-call-param.call_id = p-call-id
     2973   and buf_rule-call-param.order_id = p-order-id
     2974   and buf_rule-call-param.rule_id = p-rule-id
     2975   and buf_rule-call-param.param-name = "p-xsd-file"
     2976    no-error.
     2977   if available buf_rule-call-param then do:
     2978   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2979   end.
     2980       case p-ruleset-id:
     2981         when 1 then do:
     2982           assign
     2983           v-sign = 1
     2984           v-current-host-code = p-host-code
     2985           v-current-obj-type = p-obj-type
     2986           v-current-obj-code = p-obj-code
     2987           v-current-db-num = g#db-num
     2988           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2989           file-name  = p-process-file-name
     2990           .
     2991         end.
     2992       end case.
     2993     end.
     2994   end procedure.
