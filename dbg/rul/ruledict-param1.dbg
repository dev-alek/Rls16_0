        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-entry-id as integer no-undo .
        6   define input parameter        p-language as character no-undo .
        7   define input parameter        p-param-num as integer no-undo .
        8   define input parameter        p-param-name as character no-undo .
        9   define input parameter        p-param-label as character no-undo .
       10   define input parameter        p-param-data-type as character no-undo .
       11   define input parameter        p-param-2-data-type as character no-undo .
       12   define input parameter        p-param-3-data-type as character no-undo .
       13   define input parameter        p-param-mode as character no-undo .
       14   define input parameter        p-documentation as character no-undo .
       15   define input parameter        p-init-value-character as character no-undo .
       16   define input parameter        p-init-value-date as date no-undo .
       17   define input parameter        p-init-value-decimal as decimal no-undo .
       18   define input parameter        p-init-value-integer as integer no-undo .
       19   define input parameter        p-init-value-logical as logical no-undo .
       20   define variable vss-revision    as character no-undo init "$Revision$":U .
       21   define variable vss-author      as character no-undo init "$Author$":U .
       22   define variable vss-date        as character no-undo init "$Date$":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       24   define variable vss-archive     as character no-undo init "$Archive$":U .
       25   define variable vss-description as character no-undo init "Сохранение изменений ruledict-param".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define   shared variable g#auto as logical no-undo.
       87   define   shared variable g#news as logical no-undo.
       88   define   shared variable g#oxml as logical no-undo.
       89   define   shared variable g#esys as logical no-undo.
       90   define   shared variable g#news-source-db as integer no-undo.
       91   define   shared variable g#esys-source-esys as integer no-undo.
       92   define   shared variable g#db-num as integer   no-undo .
       93   define   shared variable g#userid as character no-undo .
       94   define   shared variable g#passwd as character no-undo .
       95   define variable v-mess as character no-undo .
       96   define variable v-ii as integer no-undo .
       97   define variable v-uniq-key-rec as character no-undo .
       98   define variable v-clob-db-num as integer   no-undo init ?.
       99   define variable v-int64-id as integer   no-undo init 0.
      100   define variable v-part-num as integer   no-undo .
      101   define buffer buf_ruledict-param for ub.ruledict-param.
      102   define buffer buf_ruledict for ub.ruledict.
      103   if p-mode <> 'ДОБАВЛЕНИЕ':U
      104   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      105     message vss-workfile vss-revision vss-description skip
      106             "Неверный параметр p-mode - " p-mode
      107     view-as alert-box error .
      108     return error '':u.
      109   end.
      110   if g#db-num <> 0 then do:
      111     message vss-workfile vss-revision vss-description skip
      112             "Запрещено вызывать процедуру в УБД"
      113     view-as alert-box error .
      114     return error '':u.
      115   end.
      116   _main:
      117   do for buf_ruledict-param
      118   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      119   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      120   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      121   :
      122     if p-param-name = '':u then do:
      123       assign
      124       v-mess = "Имя параметра не может быть пустым".
      125       run err-mess in this-procedure ( input-output v-mess).
      126       return error (if p-silent = yes then v-mess else 'param-name':U).
      127     end.
      128     if p-param-label = '':u then do:
      129       assign
      130       v-mess = "Лейбл параметра не может быть пустым".
      131       run err-mess in this-procedure ( input-output v-mess).
      132       return error (if p-silent = yes then v-mess else 'param-lable':U).
      133     end.
      134     if p-param-num = 0 then do:
      135       assign
      136       v-mess = "№ параметра не может = 0".
      137       run err-mess in this-procedure ( input-output v-mess).
      138       return error (if p-silent = yes then v-mess else 'param-num':U).
      139     end.
      140     if lookup(p-param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle':U + chr(44) + 'longchar':U) = 0
      141     then do:
      142       assign
      143       v-mess = substitute("Неверное значение типа параметра: &1", p-param-data-type).
      144       run err-mess in this-procedure ( input-output v-mess).
      145       return error (if p-silent = yes then v-mess else 'param-data-type':U).
      146     end.
      147     if lookup(p-param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u) = 0
      148     then do:
      149       assign
      150       v-mess = substitute("Неверное значение моды параметра: &1", p-param-mode).
      151       run err-mess in this-procedure ( input-output v-mess).
      152       return error (if p-silent = yes then v-mess else 'param-mode':U).
      153     end.
      154     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      155       find first buf_ruledict-param exclusive-lock where
      156                 buf_ruledict-param.entry-id = p-entry-id
      157             and buf_ruledict-param.language = p-language
      158             and buf_ruledict-param.param-num = p-param-num no-error.
      159       if available buf_ruledict-param then do:
      160         assign
      161         v-mess = "Уже существует ruledict-param c таким ID термина, языком и № пар-ра".
      162         run err-mess in this-procedure ( input-output v-mess).
      163         return error (if p-silent = yes then v-mess else '':U).
      164       end.
      165       find first buf_ruledict no-lock where
      166                 buf_Ruledict.entry-id = p-entry-id no-error.
      167       if not available buf_ruledict then do:
      168         assign
      169         v-mess = "Не найден термин".
      170         run err-mess in this-procedure ( input-output v-mess).
      171         return error (if p-silent = yes then v-mess else '':U).
      172       end.
      173       create buf_ruledict-param.
      174       assign
      175       buf_ruledict-param.entry-id = p-entry-id
      176       buf_ruledict-param.language = p-language
      177       buf_ruledict-param.param-num = p-param-num
      178       .
      179     end.
      180     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      181       find first buf_ruledict-param exclusive-lock where
      182                 recid(buf_ruledict-param) = p-rec .
      183       if buf_ruledict-param.entry-id <> p-entry-id
      184       or buf_ruledict-param.language <> p-language
      185       or buf_ruledict-param.param-num <> p-param-num
      186       then do:
      187         assign
      188         v-mess = substitute("Для уже существующего ruledict-param невозможно изменение ID термина, языка и № пар-ра1" +
      189                                 "старые значения ID термина, языка и № пар-ра: &2, &3 и &4"
      190                                 , chr(10)
      191                                 , buf_ruledict-param.entry-id
      192                                 , buf_ruledict-param.language
      193                                 , buf_Ruledict-param.param-num)
      194         .
      195         run err-mess in this-procedure ( input-output v-mess).
      196         return error (if p-silent = yes then v-mess else '':U).
      197       end.
      198     end.
      199     do v-ii = 1 to num-entries(p-param-3-data-type):
      200       if not (entry(v-ii, p-param-3-data-type) = "LIST"
      201               or
      202               entry(v-ii, p-param-3-data-type) = "READ-ONLY"
      203               or
      204               entry(v-ii, p-param-3-data-type) = "SORTED-LIST"
      205               ) then do:
      206         assign
      207         v-mess = substitute("Неизвестный тип данных3 = &1"
      208                                 , chr(10)
      209                                 , p-param-3-data-type )
      210         .
      211         run err-mess in this-procedure ( input-output v-mess).
      212         return error (if p-silent = yes then v-mess else '':U).
      213       end.
      214     end.
      215     assign
      216     buf_ruledict-param.param-name          = p-param-name
      217     buf_ruledict-param.param-label         = p-param-label
      218     buf_ruledict-param.param-data-type     = p-param-data-type
      219     buf_ruledict-param.param-2-data-type   = p-param-2-data-type
      220     buf_ruledict-param.param-3-data-type   = p-param-3-data-type
      221     buf_ruledict-param.param-mode          = p-param-mode
      222     buf_ruledict-param.documentation       = p-documentation
      223     buf_ruledict-param.init-value-character = (if p-param-data-type = 'character':U
      224                                                then p-init-value-character
      225                                                else '':U)
      226     buf_ruledict-param.init-value-date      = (if p-param-data-type = 'date':U
      227                                                then p-init-value-date
      228                                                else ?)
      229     buf_ruledict-param.init-value-decimal   = (if p-param-data-type = 'decimal':U
      230                                                then p-init-value-decimal
      231                                                else 0.0)
      232     buf_ruledict-param.init-value-integer   = (if p-param-data-type = 'integer':U
      233                                                then p-init-value-integer
      234                                                else 0)
      235     buf_ruledict-param.init-value-logical   = (if p-param-data-type = 'logical':U
      236                                                then p-init-value-logical
      237                                                else no)
      238     .
      239     if buf_ruledict-param.param-data-type = 'character':U
      240     and buf_ruledict-param.param-2-data-type = "xsd"
      241     then do:
      242       run rul/rdp-clob.p ( buffer buf_ruledict-param
      243                           ,input p-mode) no-error.
      244       if error-status:error then  do:
      245         v-mess = substitute("Не удалось сохранить CLOB &1:&2&3&2&4"
      246                             ,buf_ruledict-param.init-value-character
      247                             ,chr(10)
      248                             , error-status:get-message(1)
      249                             , return-value ).
      250         run err-mess in this-procedure ( input-output v-mess).
      251         return error (if p-silent = yes then v-mess else '':U).
      252       end.
      253     end.
      254   end.
      255   PROCEDURE err-mess:
      256     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      257     CASE p-silent:
      258       when yes then do:
      259         assign
      260         p-mess = substitute("ruledict-param ID термина: &1 язык: &2: № пар-ра &3:&4&5"
      261                            , p-entry-id
      262                            , p-language
      263                            , p-param-num
      264                            , chr(10)
      265                            , p-mess)
      266         .
      267       end.
      268       when no then do:
      269         message
      270         p-mess
      271         view-as alert-box error .
      272       end.
      273     end.
      274   END PROCEDURE.
