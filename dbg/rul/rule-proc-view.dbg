        1   block-level on error undo, throw.
        2   define input parameter p-pchain-type as character no-undo .
        3   define input parameter p-pchain-id as character no-undo .
        4   define input parameter p-start-from as integer no-undo .
        5   define input parameter p-call-id as character no-undo .
        6   define input parameter p-profile-id as integer no-undo .
        7   define input parameter p-once-more as integer no-undo .
        8   define input parameter p-mode as character no-undo .
        9   define input parameter p-txt-cont-handle as handle no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Просмотр правил, запускающихся в rum, для конкретного процесса и конкретного вызова".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define temp-table temp-pchain-link-rule no-undo
       76   field pchain-type as character
       77   field pchain-id as character
       78   field start-from as integer
       79   field link-id as integer
       80   field codex_id as integer
       81   field ruleset_id as integer
       82   field run-DB0 as integer
       83   field run-RDB as integer
       84   field order_id as integer
       85   field rule_id as integer
       86   field profile_id as integer
       87   field once-more as integer
       88   field can-calc as logical
       89   field can-run as logical
       90   field link-btwn-profiles as integer
       91   index pi is unique primary
       92   pchain-type
       93   pchain-id
       94   start-from
       95   link-id
       96   order_id
       97   .
       98   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define temp-table temp-string no-undo
      100   field v-string as character
      101   field string-num as integer
      102   index pi is unique primary string-num.
      103   procedure temp-string_clear :
      104     define buffer buf_temp-string for temp-string .
      105     do
      106     on error undo, return error return-value
      107     :
      108       for each buf_temp-string
      109       on error undo, return error
      110       :
      111         delete buf_temp-string.
      112       end.
      113     end.
      114   end procedure.
      115   procedure temp-string_write :
      116     define input  parameter p-v-string    as character no-undo .
      117     define variable v-string-num as integer no-undo .
      118     define buffer buf_temp-string for temp-string .
      119     do
      120     on error undo, return error return-value
      121     :
      122       find last buf_temp-string no-error .
      123       if not available buf_temp-string then do:
      124         create buf_temp-string .
      125         assign
      126         buf_temp-string.string-num     = 1
      127         buf_temp-string.v-string       = p-v-string
      128         .
      129       end.
      130       else do:
      131         v-string-num = buf_temp-string.string-num.
      132         create buf_temp-string .
      133         assign
      134         buf_temp-string.string-num = v-string-num + 1
      135         buf_temp-string.v-string = p-v-string
      136         .
      137       end.
      138     end.
      139   end procedure.
      140   procedure temp-string_read :
      141     define input  parameter p-string-num    as integer   no-undo .
      142     define output parameter p-v-string      as character no-undo .
      143     define buffer buf_temp-string for temp-string .
      144     do
      145     on error undo, return error return-value
      146     :
      147       find first buf_temp-string
      148         where buf_temp-string.string-num     = p-string-num
      149         no-error .
      150       if available buf_temp-string then do:
      151         assign
      152           p-v-string = buf_temp-string.v-string
      153         .
      154       end.
      155       else do:
      156         assign
      157           p-v-string = '':U
      158         .
      159       end.
      160     end.
      161   end procedure.
      162   procedure temp-string_append :
      163     define input  parameter p-string-num  as integer   no-undo .
      164     define input  parameter p-v-string    as character no-undo .
      165     define input  parameter p-append-char as character no-undo .
      166     define buffer buf_temp-string for temp-string .
      167     do
      168     on error undo, return error return-value
      169     :
      170       find first buf_temp-string
      171            where buf_temp-string.string-num = p-string-num
      172         no-error .
      173       if not available buf_temp-string then do:
      174         create buf_temp-string .
      175         assign
      176           buf_temp-string.string-num  = p-string-num
      177           buf_temp-string.v-string    = p-v-string
      178         .
      179       end.
      180       else do:
      181           assign
      182           buf_temp-string.v-string = buf_temp-string.v-string + p-append-char + p-v-string
      183           .
      184       end.
      185     end.
      186   end procedure.
      187   procedure temp-string_get-last-num:
      188   define output parameter p-string-num  as integer   no-undo .
      189   define buffer buf_temp-string for temp-string .
      190   find last buf_temp-string no-error.
      191   if available buf_temp-string then do:
      192     p-string-num = buf_temp-string.string-num.
      193   end.
      194   end procedure.
      195   procedure temp-string_delete-range:
      196   define input parameter p-first-string-num  as integer   no-undo .
      197   define input parameter p-last-string-num  as integer   no-undo .
      198   define buffer buf_temp-string for temp-string .
      199   for each buf_temp-string where
      200           buf_temp-string.string-num >= p-first-string-num
      201       and buf_temp-string.string-num <= p-last-string-num:
      202     delete buf_temp-string.
      203   end.
      204   end procedure.
      205   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      206   procedure display-rule-call-params :
      207   define input parameter p-mode as character no-undo .
      208   define input parameter p-codex-id as integer no-undo .
      209   define input parameter p-ruleset-id as integer no-undo .
      210   define input parameter p-call-id as character no-undo .
      211   define input parameter p-once-more as integer no-undo .
      212   define input parameter p-order-id as integer no-undo .
      213   define input parameter p-handle as handle no-undo .
      214   define buffer buf_rule-call-param for ub.rule-call-param.
      215   define variable v-string as character no-undo .
      216   do
      217   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      218   :
      219     run temp-string_write in p-handle ( input "ПАРАМЕТРЫ").
      220     if p-mode = "text"
      221     or p-mode = "text-temp"
      222     then do:
      223       run temp-string_write in p-handle ( input "").
      224     end.
      225     _rr:
      226     for each buf_rule-call-param no-lock where
      227             buf_rule-call-param.codex_id = p-codex-id
      228         and buf_rule-call-param.ruleset_id = p-ruleset-id
      229         and buf_rule-call-param.call_id = p-call-id
      230         and buf_rule-call-param.order_id = p-order-id:
      231       if p-once-more >= 0 and
      232       buf_rule-call-param.once-more <> p-once-more then next.
      233       v-string = '':U.
      234       if lookup("LIST", buf_rule-call-param.param-3-data-type) > 0 then do:
      235         if buf_rule-call-param.p-index = 0 then do:
      236           assign
      237           v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
      238           run temp-string_write in p-handle ( input v-string).
      239           next _rr.
      240         end.
      241         else do:
      242           assign
      243           v-string = fill( chr(32), length(buf_rule-call-param.param-label) + 2).
      244         end.
      245       end.
      246       else do:
      247         assign
      248         v-string = buf_rule-call-param.param-label +  chr(32)  + "=".
      249       end.
      250       CASE buf_rule-call-param.param-data-type:
      251         when 'character':U then do:
      252           v-string = v-string + buf_rule-call-param.param-value-character.
      253         end.
      254         when 'date':U then do:
      255           v-string = v-string + string(buf_rule-call-param.param-value-date, "99/99/9999").
      256         end.
      257         when 'logical':U then do:
      258           v-string = v-string + string(buf_rule-call-param.param-value-logical, "ДА/НЕТ").
      259         end.
      260         when 'decimal':U then do:
      261           v-string = v-string + string(buf_rule-call-param.param-value-decimal).
      262         end.
      263         when 'integer':U then do:
      264           v-string = v-string + string(buf_rule-call-param.param-value-integer).
      265         end.
      266       END CASE.
      267       run temp-string_write in p-handle ( input v-string).
      268     end.
      269     if p-mode = "text"
      270     or p-mode = "text-temp"
      271     then do:
      272       run temp-string_write in p-handle ( input "").
      273     end.
      274   end.
      275   end procedure.
      276   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      277   procedure display-ruledict-params :
      278   define input parameter p-mode as character no-undo .
      279   define input parameter p-rule-id as integer no-undo .
      280   define buffer buf_ruledict-param for ub.ruledict-param.
      281   define buffer buf_ruledict for ub.ruledict.
      282   define buffer buf_rule for ub.rule.
      283   define variable v-string as character no-undo .
      284   do
      285   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      286   :
      287     find first buf_rule no-lock where
      288               buf_rule.rule_id = p-rule-id.
      289     find first buf_ruledict no-lock where
      290               buf_ruledict.entry-type = 'rule':U
      291           and buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
      292     run temp-string_write in this-procedure ( input "ПАРАМЕТРЫ").
      293     if p-mode = "text" then do:
      294       run temp-string_write in this-procedure ( input "").
      295     end.
      296     for each buf_ruledict-param no-lock where
      297             buf_ruledict-param.entry-id = buf_ruledict.entry-id:
      298       assign
      299       v-string = substitute("&1 (&2) (&3)"
      300                             , buf_ruledict-param.param-label
      301                             , buf_ruledict-param.param-data-type
      302                             , buf_ruledict-param.param-name).
      303       run temp-string_write in this-procedure ( input v-string).
      304     end.
      305   end.
      306   end procedure.
      307   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure gen-key-rec :
      310     define input  parameter p-tbl-name    as character no-undo.
      311     define input  parameter p-bh_tbl-name as handle    no-undo.
      312     define output parameter p-key-rec     as character no-undo.
      313     do
      314     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      315     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      316     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      317     :
      318       define variable fh               as handle    no-undo .
      319       define variable v-ok             as logical   no-undo .
      320       define variable v-inform         as character no-undo .
      321       define variable v-ind            as integer   no-undo .
      322       define variable v-idx-field-qnty as integer   no-undo .
      323       if p-tbl-name = ?
      324         or p-tbl-name = "":U
      325       then do:
      326         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      327       end.
      328       if not p-bh_tbl-name:available then do:
      329         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      330       end.
      331       assign
      332         p-key-rec = p-tbl-name
      333         v-inform  = p-bh_tbl-name:index-information(1)
      334         v-ind     = 2
      335       .
      336       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      337       on error undo, return error
      338       :
      339         assign
      340           v-inform = p-bh_tbl-name:index-information( v-ind )
      341           v-ind    = v-ind + 1
      342         .
      343       end.
      344       if v-inform = ?
      345         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      346         or entry( 3, v-inform, ",":U ) <> "1":U
      347       then do:
      348         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      349       end.
      350       else do:
      351         assign
      352           v-idx-field-qnty = num-entries( v-inform ) - 4
      353         .
      354         if v-idx-field-qnty < 2 then do:
      355           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      356         end.
      357         do v-ind = 1 to v-idx-field-qnty by 2
      358         on error undo, return error
      359         :
      360           assign
      361             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      362             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      363           .
      364         end.
      365       end.
      366       if p-key-rec = ? then do:
      367         assign
      368           p-key-rec = "":U
      369         .
      370         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      371       end.
      372     end.
      373     return.
      374   end procedure.
      375   procedure gen-where-keyr-tab :
      376     define input  parameter i-tableSerach as character no-undo.
      377     define input  parameter i-tablekey   as character  no-undo.
      378     define input  parameter p-key-rec    as character  no-undo.
      379     define input  parameter p-key-handle as handle     no-undo .
      380     define input  parameter p-db-name    as character  no-undo .
      381     define input  parameter p-tt-handle  as handle     no-undo .
      382     define output parameter o-Where      as character  no-undo.
      383     do
      384     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      385     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      386     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      387     :
      388       define variable v-full-tbl-name  as character no-undo .
      389       define variable bh_tbl-name      as handle    no-undo .
      390       define variable fh_key           as handle    no-undo .
      391       define variable fh_search        as handle    no-undo .
      392       define variable v-field-num      as integer   no-undo .
      393       define variable v-count-fld      as integer   no-undo .
      394       define variable v-inform         as character no-undo .
      395       define variable v-ind            as integer   no-undo .
      396       define variable v-idx-field-qnty as integer   no-undo .
      397       define variable v-field-name     as character no-undo .
      398       define variable v-field-val      as character no-undo .
      399       define variable v-word-link      as character no-undo .
      400       define variable vTable           as character no-undo.
      401       define variable bh_tbl-key       as handle    no-undo .
      402       assign
      403         p-key-rec = trim( p-key-rec )
      404       .
      405       if p-key-handle <> ? then do:
      406         if not valid-handle(p-key-handle)
      407            or p-key-handle:type <> "buffer"
      408         then do:
      409           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      410         end.
      411         if num-entries( p-key-rec, chr(3) ) > 1
      412           or p-key-rec = ?
      413           or p-key-rec = "":U
      414         then do:
      415           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      416         end.
      417       end.
      418       else do:
      419         if p-key-rec = ?
      420           or p-key-rec = "":U
      421         then do:
      422           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      423         end.
      424       end.
      425       assign
      426         vTable = entry( 1 , p-key-rec, chr(3) )
      427       .
      428       if p-tt-handle <> ?
      429         and ( not valid-handle(p-tt-handle)
      430               or p-tt-handle:type <> "buffer"
      431             )
      432       then do:
      433         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      434       end.
      435       if p-tt-handle = ? then do:
      436         assign
      437           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      438         .
      439         create buffer bh_tbl-name for table v-full-tbl-name .
      440       end.
      441       else do:
      442         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      443       end.
      444       assign
      445         v-inform = bh_tbl-name:index-information(1)
      446         v-ind    = 2
      447       .
      448       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      449       on error undo, return error
      450       :
      451         assign
      452           v-inform = bh_tbl-name:index-information( v-ind )
      453           v-ind    = v-ind + 1
      454         .
      455       end.
      456       if v-inform = ?
      457         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      458         or entry( 3, v-inform, ",":U ) <> "1":U
      459       then do:
      460         delete object bh_tbl-name no-error.
      461         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      462       end.
      463       assign
      464         v-idx-field-qnty = num-entries( v-inform ) - 4
      465       .
      466       if v-idx-field-qnty < 2 then do:
      467         delete object bh_tbl-name no-error.
      468         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      469       end.
      470       assign
      471         o-where     = "where":U
      472         v-word-link = "":U
      473         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      474         v-count-fld = 0
      475       .
      476       if i-tablekey ne "" and i-tablekey ne ?
      477       then do:
      478         assign
      479           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      480         .
      481         create buffer bh_tbl-key for table v-full-tbl-name .
      482       end.
      483       if i-tableSerach ne "" and i-tableSerach ne ?
      484       then do:
      485         delete object bh_tbl-name no-error.
      486         assign
      487           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      488         .
      489         create buffer bh_tbl-name for table v-full-tbl-name .
      490       end.
      491       block_where:
      492       do v-ind = 1 to v-idx-field-qnty by 2
      493       on error undo, return error
      494       :
      495         assign
      496           v-count-fld = v-count-fld + 1
      497         .
      498         if p-key-handle = ?
      499           and v-count-fld > v-field-num
      500         then do:
      501           leave block_where.
      502         end.
      503         define variable VfieldKeyTable as handle no-undo.
      504         assign
      505           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      506           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      507         .
      508         if     bh_tbl-key ne ?
      509         then do:
      510            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      511            if VfieldKeyTable eq ?
      512            then next block_where.
      513         end.
      514         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      515         then
      516            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      517         else
      518            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      519         if p-key-handle = ? then do:
      520           assign
      521             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      522           .
      523         end.
      524         else do:
      525           assign
      526             fh_key = p-key-handle:buffer-field( v-field-name )
      527           .
      528           if fh_key = ?
      529             or not valid-handle( fh_key )
      530           then do:
      531             delete object bh_tbl-name.
      532             if     bh_tbl-key ne ?
      533             then
      534                delete object bh_tbl-key.
      535             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      536           end.
      537           assign
      538             v-field-val = fh_key:buffer-value
      539           .
      540         end.
      541         if fh_search:data-type ="character":U then do:
      542           assign
      543             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      544             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      545             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      546             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      547             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      548             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      549             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      550             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      551             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      552             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      553             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      554             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      555             v-field-val = substitute( '"&1"', v-field-val )
      556           .
      557         end.
      558         assign
      559           o-where = substitute( "&1 &2", o-where, v-field-val )
      560         .
      561         if v-word-link = "":U then do:
      562           assign
      563             v-word-link = "and":U
      564           .
      565         end.
      566       end.
      567       delete object bh_tbl-name.
      568       if     bh_tbl-key ne ?
      569       then
      570          delete object bh_tbl-key.
      571       if p-key-handle = ?
      572         and v-count-fld <> v-field-num
      573       then do:
      574         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      575       end.
      576     end.
      577   end procedure.
      578   procedure gen-hn-keyr-tab :
      579     define input  parameter i-tableSerach as character no-undo.
      580     define input  parameter i-tablekey   as character no-undo.
      581     define input  parameter p-key-rec    as character no-undo.
      582     define input  parameter p-key-handle as handle    no-undo .
      583     define input  parameter p-db-name    as character no-undo .
      584     define input  parameter p-tt-handle  as handle    no-undo .
      585     define input  parameter p-stts-lock  as integer   no-undo .
      586     define output parameter o-hn         as handle    no-undo.
      587     define variable v-full-tbl-name as character no-undo.
      588     define variable v-where         as character no-undo.
      589     define variable bh_tbl-name     as handle    no-undo.
      590     define variable vTable          as character no-undo.
      591     do
      592     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      593     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      594     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      595         run gen-where-keyr-tab(i-tableSerach,
      596                                i-tablekey,
      597                                p-key-rec,
      598                                p-key-handle,
      599                                p-db-name,
      600                                p-tt-handle,
      601                                output v-where).
      602         if i-tableSerach ne "" and i-tableSerach ne ?
      603         then do:
      604            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      605            create buffer bh_tbl-name for table v-full-tbl-name .
      606         end.
      607         else do:
      608            if p-tt-handle = ? then do:
      609               assign
      610                  vTable = entry( 1 , p-key-rec, chr(3) )
      611               .
      612               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      613               create buffer bh_tbl-name for table v-full-tbl-name .
      614            end.
      615            else do:
      616               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      617            end.
      618         end.
      619         if p-tt-handle = ? then do:
      620            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      621         end.
      622         else do:
      623            bh_tbl-name:find-first( v-where ) no-error .
      624         end.
      625         o-hn = bh_tbl-name.
      626      end.
      627   end procedure.
      628   procedure gen-hn-keyr :
      629     define input  parameter p-key-rec    as character no-undo.
      630     define input  parameter p-key-handle as handle    no-undo .
      631     define input  parameter p-db-name    as character no-undo .
      632     define input  parameter p-tt-handle  as handle    no-undo .
      633     define input  parameter p-stts-lock  as integer   no-undo .
      634     define output parameter o-hn         as handle    no-undo.
      635     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      636   end.
      637   procedure gen-row-keyr :
      638     define input  parameter p-key-rec    as character no-undo.
      639     define input  parameter p-key-handle as handle    no-undo .
      640     define input  parameter p-db-name    as character no-undo .
      641     define input  parameter p-tt-handle  as handle    no-undo .
      642     define input  parameter p-stts-lock  as integer   no-undo .
      643     define output parameter p-tbl-row    as rowid     no-undo.
      644     define output parameter p-tbl-name   as character no-undo.
      645     define variable vHn as handle no-undo.
      646       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      647       p-tbl-row = if vHn:available then vHn:rowid else ?.
      648       p-tbl-name =  vHn:table.
      649       delete object vHn no-error.
      650     if p-tbl-row = ? then do:
      651       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      652     end.
      653     else do:
      654       return.
      655     end.
      656   end procedure.
      657   procedure gen-key-fv :
      658     define input  parameter p-key-rec    as character no-undo .
      659     define output parameter p-field-list as character no-undo .
      660     define output parameter p-value-list as character no-undo.
      661     do
      662     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      663     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      664     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      665     :
      666       define variable v-full-tbl-name  as character no-undo .
      667       define variable bh_tbl-name      as handle    no-undo .
      668       define variable v-tbl-name       as character no-undo .
      669       define variable v-field-num      as integer   no-undo .
      670       define variable v-count-fld      as integer   no-undo .
      671       define variable v-inform         as character no-undo .
      672       define variable v-ind            as integer   no-undo .
      673       define variable v-idx-field-qnty as integer   no-undo .
      674       define variable v-delim-key      as character no-undo .
      675       if p-key-rec = ?
      676         or p-key-rec = "":U
      677       then do:
      678         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      679       end.
      680       assign
      681         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      682         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      683       .
      684       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      685       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
      686       assign
      687         v-inform = bh_tbl-name:index-information(1)
      688         v-ind    = 2
      689       .
      690       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      691       on error undo, return error
      692       :
      693         assign
      694           v-inform = bh_tbl-name:index-information( v-ind )
      695           v-ind    = v-ind + 1
      696         .
      697       end.
      698       if v-inform = ?
      699         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      700         or entry( 3, v-inform, ",":U ) <> "1":U
      701       then do:
      702         delete object bh_tbl-name no-error.
      703         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      704       end.
      705       assign
      706         v-idx-field-qnty = num-entries( v-inform ) - 4
      707       .
      708       if v-idx-field-qnty < 2 then do:
      709         delete object bh_tbl-name no-error.
      710         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      711       end.
      712       assign
      713         p-field-list = "":U
      714         p-value-list = "":U
      715         v-delim-key  = "":U
      716         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      717         v-count-fld  = 0
      718       .
      719       block_where:
      720       do v-ind = 1 to v-idx-field-qnty by 2
      721       on error undo, return error
      722       :
      723         assign
      724           v-count-fld = v-count-fld + 1
      725         .
      726         if v-count-fld > v-field-num then do:
      727           leave block_where.
      728         end.
      729         assign
      730           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      731           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      732         .
      733         if v-ind = 1 then do:
      734           assign
      735             v-delim-key = chr(3)
      736           .
      737         end.
      738       end.
      739       delete object bh_tbl-name.
      740       if v-count-fld <> v-field-num then do:
      741         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
      742       end.
      743     end.
      744   end procedure.
      745   procedure gen-key-field :
      746     define input  parameter p-table      as character no-undo .
      747     define output parameter p-field-list as character no-undo .
      748     do
      749     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      750     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      752     :
      753       define variable v-full-tbl-name  as character no-undo .
      754       define variable bh_tbl-name      as handle    no-undo .
      755       define variable v-tbl-name       as character no-undo .
      756       define variable v-field-num      as integer   no-undo .
      757       define variable v-count-fld      as integer   no-undo .
      758       define variable v-inform         as character no-undo .
      759       define variable v-ind            as integer   no-undo .
      760       define variable v-idx-field-qnty as integer   no-undo .
      761       define variable v-delim-key      as character no-undo .
      762       if p-table = ?
      763         or p-table = "":U
      764       then do:
      765         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
      766       end.
      767       assign
      768         v-tbl-name      = p-table
      769         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      770       .
      771       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      772       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
      773       assign
      774         v-inform = bh_tbl-name:index-information(1)
      775         v-ind    = 2
      776       .
      777       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      778       on error undo, return error
      779       :
      780         assign
      781           v-inform = bh_tbl-name:index-information( v-ind )
      782           v-ind    = v-ind + 1
      783         .
      784       end.
      785       if v-inform = ?
      786         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      787         or entry( 3, v-inform, ",":U ) <> "1":U
      788       then do:
      789         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
      790       end.
      791       assign
      792         v-idx-field-qnty = num-entries( v-inform ) - 4
      793       .
      794       if v-idx-field-qnty < 2 then do:
      795         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
      796       end.
      797       assign
      798         p-field-list = "":U
      799         v-delim-key  = "":U
      800         v-count-fld  = 0
      801       .
      802       block_where:
      803       do v-ind = 1 to v-idx-field-qnty by 2
      804       on error undo, return error
      805       :
      806         assign
      807           v-count-fld = v-count-fld + 1
      808         .
      809         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      810         if v-ind = 1 then do:
      811           assign
      812             v-delim-key = chr(3)
      813           .
      814         end.
      815       end.
      816       delete object bh_tbl-name.
      817     end.
      818   end procedure.
      819   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   FUNCTION get-region RETURNS CHARACTER
      821     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      822     define variable par-region as character no-undo.
      823     if parhost-code = 0 and
      824          parobj-type = "":U and
      825          parobj-code = 0 then do:
      826          par-region = "Глобально".
      827          return par-region.
      828       end.
      829       if parobj-type = 'орг':U then do:
      830          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      831          return par-region.
      832       end.
      833       if parobj-type = 'регион':U
      834       then do:
      835          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      836          return par-region.
      837       end.
      838       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      839       return par-region.
      840   END FUNCTION.
      841   FUNCTION get-objregion RETURNS CHARACTER
      842     (  input parobj-type as character, input parobj-code as integer ) :
      843     define variable par-region as character no-undo.
      844     if  parobj-type = "":U and
      845         parobj-code = 0
      846     then do:
      847        par-region = "Глобально".
      848     end.
      849     else if parobj-type = 'орг':U
      850     then do:
      851        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      852     end.
      853     else if parobj-type = 'регион':U
      854     then do:
      855        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      856     end.
      857     else
      858        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      859     return par-region.
      860   END FUNCTION.
      861   FUNCTION calldscr returns character ( input p-call-id as character):
      862   define variable v-descr as character no-undo .
      863   define variable v-field-list as character no-undo .
      864   define variable v-value-list as character no-undo.
      865   define variable v-prop-label as character no-undo .
      866   define variable v-node-label as character no-undo .
      867   define variable v-dt-code as integer no-undo .
      868   define variable v-host-code as integer no-undo .
      869   define variable v-obj-type as character no-undo .
      870   define variable v-obj-code as integer no-undo .
      871   define variable v-label as character no-undo .
      872   define variable v-node-code as integer no-undo .
      873   define buffer buf_prop-head for ub.prop-head.
      874   define buffer buf_prop-ref for ub.prop-ref.
      875   define buffer buf_prop-map for ub.prop-map.
      876   run gen-key-fv in this-procedure ( input p-call-id
      877                                     ,output v-field-list
      878                                     ,output v-value-list) no-error .
      879   if error-status:error then return p-call-id.
      880   CASE entry(1, p-call-id, chr(3)):
      881     when 'dis-card-type':U then do:
      882       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      883                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      884                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      885                            ).
      886     end.
      887     when 'dis-card':U then do:
      888       v-descr = substitute("ДК: № &1"
      889                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      890                            ).
      891     end.
      892     when 'dis-card-property':U then do:
      893       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      894       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      895       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      896       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      897       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      898       find first buf_prop-ref no-lock where
      899                 buf_prop-ref.dt-code = v-dt-code no-error .
      900       if available buf_prop-ref then do:
      901         find first buf_prop-head no-lock where
      902                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      903         v-prop-label = buf_prop-head.prop-label.
      904         find first buf_prop-map no-lock where
      905                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      906               and buf_prop-map.node-code = v-node-code no-error .
      907         if available buf_prop-map then do:
      908           v-label = buf_prop-map.node-label.
      909         end.
      910       end.
      911       v-descr = substitute("ДК: № &1 &2:&3 &4"
      912                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      913                            ,v-prop-label
      914                            ,v-label
      915                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      916                            ).
      917     end.
      918     when 'clients':U then do:
      919       v-descr = substitute("&1&2"
      920                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      921                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      922                            ).
      923     end.
      924     when 'ext-system':U then do:
      925       v-descr = substitute("Внешняя система &1"
      926                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      927                            ).
      928     end.
      929     WHEN 'thbj-attr':U then do:
      930       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      931       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      932       then do:
      933         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      934           v-descr = "Операции с товарами".
      935         end.
      936         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      937           v-descr = "Операции с клиентами".
      938         end.
      939         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      940           v-descr = "Операции с группами товаров".
      941         end.
      942         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      943           v-descr = "Операции с группами клиентов".
      944         end.
      945         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      946           v-descr = "Операции с чеками на POS IBS-TH".
      947         end.
      948         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      949           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      950         end.
      951         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      952           v-descr = "Операции в системе электронного документооборота".
      953         end.
      954         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      955           v-descr = "Операции со справочниками".
      956         end.
      957         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      958           v-descr = "Операции с ДНЦ и переоценками".
      959         end.
      960         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      961           v-descr = "Отчеты".
      962         end.
      963         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      964           v-descr = "Операции с заказами".
      965         end.
      966       end.
      967     end.
      968     when 'cash-desk':U then do:
      969       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      970                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      971                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      972                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      973                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      974                            ).
      975     end.
      976     when 'ext-file':U then do:
      977       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      978                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      979                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      980                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      981                            ).
      982     end.
      983   end case.
      984   return v-descr.
      985   end function.
      986   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   define variable v-waitfram-action01         as character   no-undo .
      988   define variable v-waitfram-action02         as character   no-undo .
      989   define variable v-waitfram-action03         as character   no-undo .
      990   define variable mWaitFramTextBeg            as character   no-undo.
      991   define variable mWaitFramTextEnd            as character   no-undo.
      992   define variable mWaitFramView               as logical     no-undo.
      993   define variable mWaitProcEvent              as logical     no-undo init yes.
      994   define variable mWaitFramInterval           as integer     no-undo init 1 .
      995   define variable mWaitFramStop               as logical     no-undo.
      996   define variable mWaitFramStopUser           as logical     no-undo.
      997   define variable mWaitFramStopTimeOut        as logical     no-undo.
      998   define variable mWaitFramStartProc          as datetime-tz no-undo.
      999   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1000   define button B-WaitFramStop auto-end-key
     1001        label "Стоп"
     1002        size 10 by 1 tooltip "Остоновить процесс".
     1003   define button B-viewProcInfo
     1004        label "Информация"
     1005        size 15 by 1 tooltip "Информация о процесс".
     1006   define frame waitfram
     1007     v-waitfram-action01 format "x(72)" no-label skip
     1008     v-waitfram-action02 format "x(72)" no-label skip
     1009     v-waitfram-action03 format "x(72)" no-label skip
     1010     B-viewProcInfo
     1011     B-WaitFramStop at row 4 col 30
     1012     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1013     .
     1014   define new global shared variable mBatchMode as logical no-undo init ?.
     1015   define variable mFramBachModHandle as handle no-undo.
     1016   mFramBachModHandle = frame waitfram:handle.
     1017   define variable mFameOldVis as logical no-undo.
     1018   define variable mVisCUrentVin as logical no-undo.
     1019   if session:batch-mode
     1020   then
     1021      mBatchMode = yes.
     1022   if mBatchMode = ? then do:
     1023     mVisCUrentVin = current-window:visible.
     1024     mFameOldVis = mFramBachModHandle:visible.
     1025     mFramBachModHandle:visible  = yes.
     1026     mBatchMode = mFramBachModHandle:visible ne yes.
     1027     mFramBachModHandle:visible = mFameOldVis.
     1028     current-window:visible = mVisCUrentVin.
     1029   end.
     1030    if  log-manager:logfile-name ne ?
     1031     then DO:
     1032         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1033         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1034         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1035     end.
     1036   on choose of B-WaitFramStop in frame waitfram
     1037   do:
     1038     mWaitFramStop = yes.
     1039     mWaitFramStopUser = yes.
     1040   end.
     1041   function waitfram-check-timeout returns logical():
     1042      define variable vtime as int64 no-undo.
     1043      if mWaitFramStopTimeOut
     1044      then
     1045         return yes.
     1046      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1047      if     mWaitFramTimeOut ne ?
     1048         and mWaitFramTimeOut ne 0
     1049         and mWaitFramTimeOut lt vtime
     1050      then do:
     1051         mWaitFramStopTimeOut = yes.
     1052      end.
     1053      return mWaitFramStopTimeOut.
     1054   end.
     1055   procedure waitfram-hide :
     1056     if not session:batch-mode
     1057     then do
     1058     on error undo, return error return-value
     1059     :
     1060       pause 0 before-hide .
     1061       if not mBatchMode then
     1062         hide frame waitfram .
     1063     if     not mWaitFramView
     1064        and mWaitProcEvent
     1065     then
     1066       process events .
     1067     end.
     1068   end procedure.
     1069   procedure waitfram-show :
     1070     define input  parameter p-message as character no-undo .
     1071     define variable v-left-margin as integer   no-undo .
     1072     if not session:batch-mode
     1073     then do
     1074     on error undo, return error return-value
     1075     :
     1076       if length(p-message) <= 70 then do:
     1077         assign
     1078           v-left-margin = integer((70 - length(p-message)) / 2)
     1079         .
     1080         assign
     1081           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1082         .
     1083         assign
     1084           v-waitfram-action01 = " "
     1085           v-waitfram-action02 = " "
     1086                                    + fill(" ", v-left-margin)
     1087                                    + p-message
     1088           v-waitfram-action03 = " "
     1089         .
     1090       end.
     1091       else do:
     1092         define variable vRindex1 as integer no-undo.
     1093         define variable vRindex2 as integer no-undo.
     1094         vRindex1 = r-index(p-message," ",70).
     1095         if vRindex1 = 0
     1096         then
     1097            vRindex1 = 70.
     1098         if length(p-message)  <= vRindex1 + 70 then do:
     1099           assign
     1100             v-waitfram-action01 = " "
     1101             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1102             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1103           .
     1104         end.
     1105         else do:
     1106           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1107           if vRindex2 <= vRindex1
     1108           then
     1109              vRindex2 = vRindex1 + 70.
     1110           assign
     1111             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1112             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1113             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1114           .
     1115         end.
     1116       end.
     1117       B-viewProcInfo:visible   in frame waitfram = no.
     1118       B-viewProcInfo:sensitive in frame waitfram = no.
     1119       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1120       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1121       if  (   mWaitFramView
     1122          or  mWaitProcEvent)
     1123          and not mBatchMode
     1124       then
     1125          display
     1126             v-waitfram-action01 skip
     1127             v-waitfram-action02 skip
     1128             v-waitfram-action03 skip
     1129          with frame waitfram .
     1130       if     mWaitFramView
     1131          then do:
     1132             if     mWaitFramInterval ne ?
     1133                and not mBatchMode
     1134             then
     1135                wait-for go of frame waitfram pause mWaitFramInterval.
     1136          end.
     1137          else
     1138             if     mWaitProcEvent
     1139                and not mBatchMode
     1140             then
     1141                process events .
     1142     end.
     1143   end procedure.
     1144      procedure waitfram-show-this:
     1145         define input  parameter iInterval as int64 no-undo.
     1146         define variable vtime as int64 no-undo.
     1147         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1148         mWaitFramInterval = iInterval.
     1149         run waitfram-show (substitute("&1&2 &3&4" ,
     1150                                       mWaitFramTextBeg ,
     1151                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1152                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1153                                       mWaitFramTextEnd
     1154                                      )
     1155                           ).
     1156      end.
     1157      procedure WaitFramRunPause:
     1158         define input  parameter iInterval as dec no-undo.
     1159         define variable vStart  as datetime-tz no-undo.
     1160         define variable vend    as datetime-tz no-undo.
     1161         define variable vint as int64 no-undo.
     1162         define variable vOk as logical no-undo.
     1163         vStart = now.
     1164         vend   = vStart.
     1165         publish "WaitFramPause" (iInterval,output vOk).
     1166         vend   =  now.
     1167         vint = vend - vStart.
     1168         vint = iInterval - vint / 1000.
     1169         if     not mWaitFramStop
     1170            and (   vint > 0
     1171                 or (    not vOk
     1172                     and iInterval eq ?
     1173                     )
     1174                 )
     1175         then
     1176            run waitfram-show-this (iInterval).
     1177         vend   =  now.
     1178         vint = vend - vStart.
     1179         vint = iInterval - vint / 1000.
     1180         if     not mWaitFramStop
     1181            and vint > 0
     1182         then do:
     1183            run gbl/pause.p (vint * 1000).
     1184         end.
     1185         if iInterval ne ?
     1186         then
     1187            publish "WaitFramStop".
     1188         waitfram-check-timeout().
     1189      end.
     1190      procedure WaitFramWaitFor:
     1191         define input  parameter iInterval as dec no-undo.
     1192         assign
     1193            mWaitFramStartProc   = now
     1194            mWaitFramStopUser    = no
     1195            mWaitFramStopTimeOut = no
     1196         .
     1197         block-wait:
     1198         do while not mWaitFramStop:
     1199            run WaitFramRunPause (iInterval).
     1200            if  waitfram-check-timeout()
     1201            then do:
     1202               leave block-wait.
     1203            end.
     1204         end.
     1205         run waitfram-hide.
     1206      end.
     1207   procedure waitfram-join :
     1208     define input  parameter p-line-1  as character no-undo .
     1209     define input  parameter p-line-2  as character no-undo .
     1210     define input  parameter p-line-3  as character no-undo .
     1211     define output parameter p-message as character no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       assign
     1216         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1217                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1218                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1219       .
     1220     end.
     1221   end procedure.
     1222   function waitfram-join-function returns character
     1223     (input p-line-1 as character
     1224     ,input p-line-2 as character
     1225     ,input p-line-3 as character
     1226     ).
     1227     define variable v-message as character no-undo .
     1228     run waitfram-join in this-procedure
     1229       (input  p-line-1
     1230       ,input  p-line-2
     1231       ,input  p-line-3
     1232       ,output v-message
     1233       ) .
     1234     return v-message .
     1235   end function .
     1236   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   define temp-table temp-edge no-undo
     1238   field from-link-id as integer
     1239   field to-link-id as integer
     1240   field from-order_id as integer
     1241   field to-order_id as integer
     1242   field edge-type as character
     1243   index pi is unique primary
     1244   from-link-id
     1245   to-link-id
     1246   from-order_id
     1247   to-order_id
     1248   index isearch
     1249   to-link-id
     1250   to-order_id
     1251   .
     1252   function break-string-for-dot returns character (input p-string as character, input p-line-length AS INTEGER):
     1253   define variable v-string as character no-undo .
     1254   define variable v-output-string as character no-undo .
     1255   define variable v-entry as character no-undo .
     1256   define variable v-index as integer no-undo .
     1257   v-string = p-string.
     1258   v-output-string = p-string.
     1259   do while length(v-string) > p-line-length :
     1260     ASSIGN
     1261     v-entry = substring(v-string, 1, p-line-length)
     1262     v-index = r-index(v-entry, chr(32)).
     1263     if v-index > 0
     1264     and v-index <= p-line-length then do:
     1265        assign
     1266        v-output-string = v-output-string + substring(v-entry, 1, v-index - 1)  + '\N'.
     1267        v-string = substring(v-string, v-index + 1)
     1268        no-error.
     1269        if error-status:error then leave.
     1270     end.
     1271     ELSE DO:
     1272         assign
     1273         v-output-string = v-output-string + v-entry.
     1274         v-string = substring(v-string, 71)
     1275         no-error.
     1276     END.
     1277   end.
     1278   return v-output-string.
     1279   end.
     1280   define variable v-can-calc-string as character no-undo .
     1281   define variable v-label as character no-undo .
     1282   define variable v-name as character no-undo .
     1283   define variable v-node-name as character no-undo .
     1284   define variable v-proc-name as character no-undo .
     1285   define variable v-name-full as character no-undo .
     1286   define variable err-file as character no-undo .
     1287   define variable res as character no-undo .
     1288   define variable v-cmdln as character no-undo .
     1289   define variable v-before-string-num as integer no-undo .
     1290   define variable v-after-string-num as integer no-undo .
     1291   define variable v-param-string-num as integer no-undo .
     1292   define variable v-prev-node-name as character no-undo .
     1293   define variable v-fill-color as character no-undo .
     1294   define variable v-blank as integer no-undo .
     1295   define variable v-first-node-name as character no-undo .
     1296   define variable v-last-node-name as character no-undo .
     1297   define variable v-short-file-name as character no-undo .
     1298   define variable v-path                    as character                no-undo .
     1299   DEFINE VARIABLE v-full-path               as character                no-undo .
     1300   DEFINE VARIABLE v-file-name               as character                no-undo .
     1301   DEFINE VARIABLE v-file-name-cmd           as character                no-undo .
     1302   DEFINE VARIABLE v-file-name-dot           as character                no-undo .
     1303   DEFINE VARIABLE v-file-name-gif           as character                no-undo .
     1304   define variable v-file-name-html          as character                no-undo .
     1305   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1306   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1307   define variable v-prev-link-id as integer no-undo .
     1308   define variable v-prev-order-id as integer no-undo .
     1309   define variable v-handle as handle no-undo .
     1310   define buffer buf_rule-process for ub.rule-process .
     1311   define buffer buf_temp-pchain-link-rule for temp-pchain-link-rule .
     1312   define buffer buf_rule-by-call for ub.rule-by-call.
     1313   define buffer buf_rule-by-profile for ub.rule-by-profile.
     1314   define buffer buf_rule-profile for ub.rule-profile.
     1315   define buffer buf_rule for ub.rule.
     1316   define buffer buf_ruleset for ub.ruleset.
     1317   define buffer buf_TEMP-STRING  for temp-string.
     1318   define buffer buf_temp-edge for temp-edge.
     1319   define stream outstream.
     1320   main-block:
     1321   do
     1322   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1323   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1324   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1325   :
     1326     for each buf_temp-pchain-link-rule:
     1327       delete buf_temp-pchain-link-rule.
     1328     end.
     1329     if p-txt-cont-handle = ?
     1330     or not valid-handle(p-txt-cont-handle)
     1331     then do:
     1332       v-handle = this-procedure:handle.
     1333     end.
     1334     else do:
     1335       v-handle = p-txt-cont-handle.
     1336     end.
     1337     run temp-string_clear in v-handle .
     1338     if p-profile-id > 0 then do:
     1339       find first buf_rule-profile no-lock where
     1340                 buf_rule-profile.profile_id = p-profile-id.
     1341     end.
     1342     case p-pchain-type:
     1343       when 'dis-card-type':U then do:
     1344           v-proc-name = entry (lookup (p-pchain-id, 'sale-close,sale-delete,trn-doc-close,trn-doc-delete,sale-xml-import,text-import,text-export,one-card-recalc,one-card-check,one-card-add,batch-card-recalc,stop-list-import,payment-on-card,fin-doc-on-card,delete-fin-doc-from-card':U) + 1, ',' + 'Закрытие продажи на факт,Удаление закрытой продажи,Закрытие накл. с ДК на факт,Удаление накл. с ДК,Импорт продаж в XML виде,Импорт данных в текст.виде,Экспорт данных в текст.виде,Пересчет по одной карте,Проверка одной карты,Добавление одной карты,Пересчет карт,Импорт стоплиста,Внесение средств на карту,Внес.пл-жа на карту через сист.взаиморасчетов,Удал.пл-жа с карты через сист.взаиморасчетов':U).
     1345       end.
     1346     end case.
     1347     v-name-full =  substitute("&1: выполнение процесса &2 &3"
     1348                                             , (if p-call-id = '':U
     1349                                                 then buf_rule-profile.name
     1350                                                 else calldscr( p-call-id))
     1351                                             , v-proc-name
     1352                                             , (if p-start-from = 0
     1353                                                 then "Актив.сторона-ГБД"
     1354                                                 else (if p-start-from = 1
     1355                                                       then "Актив.сторона-УБД"
     1356                                                       else "")
     1357                                                       )
     1358                                             ).
     1359     for each buf_rule-process where
     1360             buf_rule-process.pchain-type = p-pchain-type
     1361         and buf_rule-process.pchain-id = p-pchain-id
     1362         and buf_rule-process.start-from = p-start-from:
     1363       if p-call-id = '':u then do:
     1364         for each buf_rule-by-profile no-lock where
     1365                 buf_rule-by-profile.profile_id = p-profile-id
     1366             and buf_rule-by-profile.codex_id = buf_rule-process.codex_id
     1367             and buf_rule-by-profile.ruleset_id = buf_rule-process.ruleset_id:
     1368           create buf_temp-pchain-link-rule.
     1369           buffer-copy buf_rule-process to buf_temp-pchain-link-rule.
     1370           buffer-copy buf_rule-by-profile to buf_temp-pchain-link-rule
     1371           assign
     1372           buf_temp-pchain-link-rule.order_id = buf_rule-by-profile.rp_order_id
     1373           buf_temp-pchain-link-rule.can-calc = not (buf_rule-by-profile.is_dynamic)
     1374           .
     1375         end.
     1376       end.
     1377       else do:
     1378         for each buf_rule-by-call no-lock where
     1379             buf_rule-by-call.call_id = p-call-id
     1380         and buf_rule-by-call.codex_id = buf_rule-process.codex_id
     1381         and buf_rule-by-call.ruleset_id = buf_rule-process.ruleset_id:
     1382           if p-profile-id > 0
     1383           and buf_rule-by-call.profile_id <> p-profile-id then next.
     1384           if p-once-more >= 0
     1385           and buf_rule-by-call.once-more <> p-once-more then next.
     1386           create buf_temp-pchain-link-rule.
     1387           buffer-copy buf_rule-process to buf_temp-pchain-link-rule.
     1388           buffer-copy buf_rule-by-call to buf_temp-pchain-link-rule.
     1389         end.
     1390       end.
     1391     end.
     1392     case p-mode:
     1393       when "text"
     1394       or when "text-temp"
     1395       then do:
     1396         for each buf_temp-pchain-link-rule
     1397         break
     1398         by buf_temp-pchain-link-rule.pchain-id
     1399         by buf_temp-pchain-link-rule.start-from
     1400         by buf_temp-pchain-link-rule.link-id:
     1401           if first-of(buf_temp-pchain-link-rule.link-id) then do:
     1402             find first buf_ruleset no-lock where
     1403                       buf_ruleset.codex_id = buf_temp-pchain-link-rule.codex_id
     1404                   and buf_ruleset.ruleset_id = buf_temp-pchain-link-rule.ruleset_id.
     1405             run temp-string_write in v-handle ( input fill("=", 80)).
     1406             run temp-string_write in v-handle ( input  substitute("&1:   &2"
     1407                                                                         ,(if buf_temp-pchain-link-rule.run-db0 > 0
     1408                                                                           then "ГБД"
     1409                                                                           else "УБД")
     1410                                                                         ,CAPS(buf_ruleset.name))).
     1411           end.
     1412           find first buf_rule no-lock where
     1413                     buf_rule.rule_id = buf_temp-pchain-link-rule.rule_id.
     1414           if p-call-id = '':U then do:
     1415             if buf_temp-pchain-link-rule.can-calc = false then do:
     1416               v-can-calc-string = "[Вкл/Выкл] ".
     1417             end.
     1418             else do:
     1419               v-can-calc-string = '':U.
     1420             end.
     1421           end.
     1422           else do:
     1423             if buf_temp-pchain-link-rule.can-calc = false then do:
     1424               v-can-calc-string = '[Выкл] ':U.
     1425             end.
     1426             else do:
     1427               v-can-calc-string = '[Вкл] ':U.
     1428             end.
     1429           end.
     1430           if p-call-id = '':U then do:
     1431             run temp-string_write in v-handle ( input substitute("Правило &1", buf_rule.rule_id)).
     1432           end.
     1433           else do:
     1434             run temp-string_write in v-handle ( input substitute("Правило &1, Профайл &2"
     1435                                                                       , buf_rule.rule_id
     1436                                                                       , buf_temp-pchain-link-rule.profile_id
     1437                                                                       )).
     1438           end.
     1439           run temp-string_write in v-handle ( input substitute("&1&2&3&4"
     1440                                                                     ,v-can-calc-string
     1441                                                                     ,buf_rule.name
     1442                                                                     ,chr(10)
     1443                                                                     ,buf_rule.documentation)).
     1444           if p-call-id = '':U then do:
     1445             RUN display-ruledict-params IN v-handle (
     1446                                                              input p-mode
     1447                                                             ,input buf_rule.rule_id).
     1448           end.
     1449           else do:
     1450             if p-mode = "text" then do:
     1451             RUN display-rule-call-params IN THIS-PROCEDURE (
     1452                                                                input p-mode
     1453                                                               ,INPUT buf_temp-pchain-link-rule.codex_id
     1454                                                               ,INPUT buf_temp-pchain-link-rule.ruleset_id
     1455                                                               ,INPUT p-call-id
     1456                                                               ,input p-once-more
     1457                                                               ,INPUT buf_temp-pchain-link-rule.order_id
     1458                                                               ,input v-handle
     1459                                                               ).
     1460           end.
     1461             if p-mode = "text-temp" then do:
     1462               RUN display-rule-call-params IN v-handle (
     1463                                                                 input p-mode
     1464                                                                 ,INPUT buf_temp-pchain-link-rule.codex_id
     1465                                                                 ,INPUT buf_temp-pchain-link-rule.ruleset_id
     1466                                                                 ,INPUT p-call-id
     1467                                                                 ,input p-once-more
     1468                                                                 ,INPUT buf_temp-pchain-link-rule.order_id
     1469                                                                 ,input v-handle
     1470                                                                 ).
     1471             end.
     1472           end.
     1473           if last-of(buf_temp-pchain-link-rule.link-id) then do:
     1474             run temp-string_write in v-handle ( input fill(chr(10), 2)).
     1475           end.
     1476           else do:
     1477             run temp-string_write in v-handle ( input fill(chr(10), 1)).
     1478           end.
     1479         end.
     1480         if v-handle = this-procedure:handle then do:
     1481         run gbl/notese.w ( INPUT THIS-PROCEDURE:HANDLE
     1482                             ,input v-name-full).
     1483       end.
     1484       end.
     1485       when "graph" then do:
     1486         for each buf_temp-pchain-link-rule
     1487         break
     1488         by buf_temp-pchain-link-rule.pchain-id
     1489         by buf_temp-pchain-link-rule.start-from
     1490         by buf_temp-pchain-link-rule.link-id:
     1491           if buf_temp-pchain-link-rule.link-btwn-profiles >= 0 then do:
     1492             create buf_temp-edge.
     1493             assign
     1494             buf_temp-edge.from-link-id = v-prev-link-id
     1495             buf_temp-edge.to-link-id   = buf_temp-pchain-link-rule.link-id
     1496             buf_temp-edge.from-order_id = v-prev-order-id
     1497             buf_temp-edge.to-order_id = buf_temp-pchain-link-rule.order_id
     1498             .
     1499           end.
     1500           assign
     1501           v-prev-link-id = buf_temp-pchain-link-rule.link-id
     1502           v-prev-order-id = buf_temp-pchain-link-rule.order_id
     1503           .
     1504         end.
     1505         run temp-string_write in this-procedure ( input substitute("digraph ruleproc ~{"
     1506                                                                   )).
     1507         run temp-string_write in this-procedure ( input substitute("compaund=true;"
     1508                                                                   )).
     1509         run temp-string_write in this-procedure ( input substitute("rankdir=TB;"
     1510                                                                   )).
     1511         run temp-string_write in this-procedure ( input substitute("ratio=auto;"
     1512                                                                   )).
     1513         for each buf_temp-pchain-link-rule
     1514         break
     1515         by buf_temp-pchain-link-rule.pchain-id
     1516         by buf_temp-pchain-link-rule.start-from
     1517         by buf_temp-pchain-link-rule.link-id:
     1518           if first-of(buf_temp-pchain-link-rule.link-id) then do:
     1519             find first buf_ruleset no-lock where
     1520                       buf_ruleset.codex_id = buf_temp-pchain-link-rule.codex_id
     1521                   and buf_ruleset.ruleset_id = buf_temp-pchain-link-rule.ruleset_id.
     1522              run temp-string_write in this-procedure ( input substitute("subgraph cluster&1_&2 ~{"
     1523                                                                        , buf_temp-pchain-link-rule.codex_id
     1524                                                                        , buf_temp-pchain-link-rule.ruleset_id
     1525                                                                        )).
     1526              run temp-string_write in this-procedure ( input substitute("node  [style=filled, fontsize=12];")).
     1527             run temp-string_write in this-procedure ( input substitute('nodesep=0.30;')).
     1528             run temp-string_write in this-procedure ( input substitute('ranksep=0.30;')).
     1529           end.
     1530           v-node-name = substitute("n&1_&2"
     1531                                     , buf_temp-pchain-link-rule.link-id
     1532                                     , buf_temp-pchain-link-rule.order_id).
     1533           find first buf_rule no-lock where
     1534                     buf_rule.rule_id = buf_temp-pchain-link-rule.rule_id.
     1535           if p-call-id = '':U then do:
     1536             if buf_temp-pchain-link-rule.can-calc = false then do:
     1537               v-can-calc-string = "[Вкл/Выкл] ".
     1538               v-fill-color = "yellow".
     1539             end.
     1540             else do:
     1541               v-can-calc-string = '':U.
     1542               v-fill-color = "palegreen".
     1543             end.
     1544           end.
     1545           else do:
     1546             if buf_temp-pchain-link-rule.can-calc = false then do:
     1547               v-can-calc-string = '[Выкл] ':U.
     1548               v-fill-color = "lightgrey".
     1549             end.
     1550             else do:
     1551               v-can-calc-string = '[Вкл] ':U.
     1552               v-fill-color = "palegreen".
     1553             end.
     1554           end.
     1555           if p-call-id = '':U then do:
     1556             v-label = substitute("Правило &1", buf_rule.rule_id).
     1557           end.
     1558           else do:
     1559             v-label = substitute("Правило &1, Профайл &2"
     1560                                 , buf_rule.rule_id
     1561                                 , buf_temp-pchain-link-rule.profile_id
     1562                                 ).
     1563           end.
     1564           v-label = substitute("&1&2&3&4&5&6"
     1565                               ,v-label
     1566                               ,"\n"
     1567                               ,v-can-calc-string
     1568                               ,buf_rule.name
     1569                               ,  "\n"
     1570                               ,buf_rule.documentation).
     1571           run temp-string_write in this-procedure ( input substitute('&1 [label="&2", fillcolor=&3, shape=box, style=filled, group=&1];'
     1572                                                                       ,v-node-name
     1573                                                                       ,v-label
     1574                                                                       ,v-fill-color
     1575                                                                       )).
     1576           run temp-string_get-last-num in this-procedure ( output v-before-string-num).
     1577           if p-call-id = '':U then do:
     1578             v-blank = 1.
     1579             RUN display-ruledict-params IN THIS-PROCEDURE (   input p-mode
     1580                                                             ,input buf_rule.rule_id).
     1581           end.
     1582           else do:
     1583             v-blank = 2.
     1584             if p-mode = "text" then do:
     1585             RUN display-rule-call-params IN THIS-PROCEDURE (
     1586                                                                input p-mode
     1587                                                               ,INPUT buf_temp-pchain-link-rule.codex_id
     1588                                                               ,INPUT buf_temp-pchain-link-rule.ruleset_id
     1589                                                               ,INPUT p-call-id
     1590                                                               ,input p-once-more
     1591                                                               ,INPUT buf_temp-pchain-link-rule.order_id
     1592                                                               ,input v-handle
     1593                                                               ).
     1594           end.
     1595             if p-mode = "text-temp" then do:
     1596               RUN display-rule-call-params IN v-handle (
     1597                                                                 input p-mode
     1598                                                                 ,INPUT buf_temp-pchain-link-rule.codex_id
     1599                                                                 ,INPUT buf_temp-pchain-link-rule.ruleset_id
     1600                                                                 ,INPUT p-call-id
     1601                                                                 ,input p-once-more
     1602                                                                 ,INPUT buf_temp-pchain-link-rule.order_id
     1603                                                                 ,input v-handle
     1604                                                                 ).
     1605             end.
     1606           end.
     1607           run temp-string_get-last-num in this-procedure ( output v-after-string-num).
     1608           v-prev-node-name = substitute("&1", v-node-name).
     1609           if (v-after-string-num - v-before-string-num) > v-blank then do:
     1610             run temp-string_get-last-num in this-procedure ( output v-param-string-num).
     1611             run temp-string_write in this-procedure ( input substitute('p&1 [shape=record,label="~{'
     1612                                                                        ,v-node-name
     1613                                                                        )).
     1614             for each buf_temp-string where
     1615                     buf_temp-string.string-num > v-before-string-num
     1616                and buf_temp-string.string-num <= v-after-string-num
     1617             break
     1618             by buf_temp-string.string-num:
     1619               run temp-string_read in this-procedure (
     1620                                                         input buf_temp-string.string-num
     1621                                                         ,output v-label).
     1622               if v-label > '':U then do:
     1623                 run temp-string_append in this-procedure (
     1624                                                           input (v-param-string-num + 1)
     1625                                                           ,input substitute("<f&1>&2&3"
     1626                                                                             ,buf_temp-string.string-num
     1627                                                                             ,replace(v-label, "|", "/")
     1628                                                                             ,(if last(buf_temp-string.string-num)
     1629                                                                               then ''
     1630                                                                               else "|")
     1631                                                                             )
     1632                                                           ,input '':U).
     1633              end.
     1634              run temp-string_delete-range in this-procedure ( input buf_temp-string.string-num
     1635                                                               ,input buf_temp-string.string-num).
     1636             end.
     1637             run temp-string_append in this-procedure (
     1638                                                       input v-param-string-num + 1
     1639                                                      ,input substitute('~}"];')
     1640                                                       ,input '').
     1641             run temp-string_write in this-procedure ( input substitute('~{rank=same; p&1; &1;~}'
     1642                                                                       ,v-node-name
     1643                                                                         )).
     1644           end.
     1645           else do:
     1646              run temp-string_delete-range in this-procedure ( input (v-before-string-num + 1)
     1647                                                              ,input v-after-string-num
     1648                                                              ).
     1649           end.
     1650           find first buf_temp-edge where
     1651                     buf_temp-edge.to-link-id = buf_temp-pchain-link-rule.link-id
     1652                 and buf_temp-edge.to-order_id = buf_temp-pchain-link-rule.order_id no-error.
     1653           if available buf_temp-edge
     1654           and buf_temp-edge.from-link-id > 0
     1655           then do:
     1656              run temp-string_write in this-procedure ( input substitute("n&1_&2:s->n&3_&4:n [weight=1000000];"
     1657                                                                          ,buf_temp-edge.from-link-id
     1658                                                                          ,buf_temp-edge.from-order_id
     1659                                                                          ,buf_temp-edge.to-link-id
     1660                                                                          ,buf_temp-edge.to-order_id
     1661                                                                            )).
     1662           end.
     1663           if last-of(buf_temp-pchain-link-rule.link-id) then do:
     1664              v-label = substitute("&1:   &2"
     1665                                   ,(if buf_temp-pchain-link-rule.run-db0 > 0
     1666                                     then "ГБД"
     1667                                     else "УБД")
     1668                                   ,CAPS(buf_ruleset.name)).
     1669              run temp-string_write in this-procedure ( input substitute('label ="&1";'
     1670                                                                         ,v-label)).
     1671              run temp-string_write in this-procedure ( input "~}").
     1672           end.
     1673         end.
     1674         run temp-string_write in this-procedure ( input "~}").
     1675         v-name = substitute( "&1_&2_3_&4_5"
     1676                           ,p-pchain-type
     1677                           ,p-pchain-id
     1678                           ,replace(p-call-id, chr(3), "")
     1679                           ,p-profile-id).
     1680         output stream outstream to value( v-name  + ".dot") convert target "UTF-8" .
     1681         for each buf_temp-string
     1682         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1683         :
     1684           put stream outstream unformatted buf_temp-string.v-string chr(10).
     1685         end.
     1686         output stream outstream close.
     1687         run gbl/_tmpfile.p ( input ""
     1688                             ,input  ""
     1689                             ,output err-file) .
     1690         assign
     1691         v-short-file-name = v-name + ".dot"
     1692         .
     1693         run gbl/filename.p (
     1694                       input  v-short-file-name
     1695                       ,output v-file-name-dot
     1696                       ,output v-path
     1697                       ,output v-file-name
     1698                       ,output v-file-name-no-ext
     1699                       ,output v-file-name-ext
     1700                       ) no-error .
     1701         if error-status:error then do:
     1702           message
     1703           return-value
     1704           view-as alert-box ERROR.
     1705           return.
     1706         end.
     1707         run rep/killspac.p ( input-output v-file-name-dot).
     1708         assign
     1709         v-file-name-gif = replace(v-file-name-dot, ".dot", ".gif")
     1710         .
     1711         assign
     1712         v-short-file-name = "exe/graphviz/dot.exe".
     1713         run gbl/filename.p (
     1714                       input  v-short-file-name
     1715                       ,output v-file-name-cmd
     1716                       ,output v-path
     1717                       ,output v-file-name
     1718                       ,output v-file-name-no-ext
     1719                       ,output v-file-name-ext
     1720                       ) no-error .
     1721         if error-status:error then do:
     1722           message
     1723           return-value
     1724           view-as alert-box ERROR.
     1725           return.
     1726         end.
     1727         assign
     1728         err-file = err-file + ".err":u
     1729         v-cmdln = substitute('"&1" -Tgif &2 -o &3 -Gcharset=UTF-8 > &4'
     1730                             ,v-file-name-cmd
     1731                             ,v-file-name-dot
     1732                             ,v-file-name-gif
     1733                             ,err-file
     1734                             ).
     1735         .
     1736         run gbl/syn.p
     1737           (input v-cmdln
     1738           ,input "":U
     1739           ,input "Ждите! Идет форматирование файла..."
     1740           ,output res
     1741           ) no-error .
     1742         run waitfram-hide in this-procedure .
     1743         run gbl/filename.p (
     1744                       input  v-file-name-gif
     1745                       ,output v-full-path
     1746                       ,output v-path
     1747                       ,output v-file-name
     1748                       ,output v-file-name-no-ext
     1749                       ,output v-file-name-ext
     1750                       ) no-error .
     1751         if error-status:error then do:
     1752           message
     1753           return-value
     1754           view-as alert-box ERROR.
     1755           return.
     1756         end.
     1757         run rep/killspac.p ( input-output v-full-path).
     1758         v-file-name-html = replace(v-file-name-dot, ".dot", ".html").
     1759         output stream Outstream to value(v-file-name-html).
     1760         put stream Outstream unformatted
     1761         substitute('<IMG SRC="&1.gif" ALT="&2">', v-name, v-name-full)
     1762         skip.
     1763         output stream Outstream close.
     1764         run gbl/open_url.p ( input  v-file-name-html) no-error .
     1765         if search("grafdisp.dbg") = ? then do:
     1766           os-delete value(v-file-name-dot).
     1767         end.
     1768         os-delete value(err-file).
     1769       end.
     1770       otherwise do:
     1771         message
     1772         substitute("Неверный параметр p-mode=&1 при вызове показа процесса", p-mode)
     1773         view-as alert-box .
     1774       end.
     1775     end case.
     1776   end.
     1777   PROCEDURE request-add-line :
     1778   DEFINE INPUT PARAMETER p-notes-handle AS HANDLE NO-UNDO.
     1779   DEFINE BUFFER buf_temp-string FOR temp-string.
     1780   for each buf_temp-string:
     1781       RUN add-line IN p-notes-handle ( INPUT buf_temp-string.v-string).
     1782       RUN add-line IN p-notes-handle ( INPUT chr(10)).
     1783     end.
     1784   END PROCEDURE.
