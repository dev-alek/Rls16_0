     1444   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1445   procedure thdl-prc_map-obj :
     1446     define input  parameter p-obj-type  as character no-undo .
     1447     define input  parameter p-obj-code  as integer   no-undo .
     1448     define output parameter p-code      as integer   no-undo .
     1449     define buffer buf_store   for ub.store.
     1450     define buffer buf_shop    for ub.shop.
     1451     define buffer buf_clients for ub.clients.
     1452   do for
     1453     buf_store
     1454   , buf_shop
     1455   , buf_clients
     1456   on error undo, return error return-value
     1457   :
     1458     assign
     1459       p-code = ?
     1460     .
     1461     case p-obj-type
     1462     :
     1463       when 'маг':U
     1464       then do:
     1465         find first buf_shop no-lock
     1466           where buf_shop.obj-code = p-obj-code
     1467         no-error .
     1468         if not available buf_shop
     1469         then do:
     1470           return error substitute( "Не найден магазин с кодом:&1":U , p-obj-code ) .
     1471         end.
     1472         assign
     1473           p-code = buf_shop.obj-code
     1474         .
     1475       end.
     1476       when 'скл':U
     1477       then do:
     1478         find first buf_store no-lock
     1479           where buf_store.obj-code = p-obj-code
     1480         no-error .
     1481         if not available buf_store
     1482         then do:
     1483           return error substitute( "Не найден склад с кодом:&1":U , p-obj-code ) .
     1484         end.
     1485         assign
     1486           p-code = 100000 + buf_store.obj-code
     1487         .
     1488       end.
     1489       when 'чел':U
     1490       then do:
     1491         find first buf_clients no-lock
     1492           where buf_clients.obj-type = p-obj-type
     1493             and buf_clients.obj-code = p-obj-code
     1494         no-error .
     1495         if not available buf_clients
     1496         then do:
     1497           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1498         end.
     1499         assign
     1500           p-code = buf_clients.obj-code
     1501         .
     1502       end.
     1503       when 'орг':U
     1504       then do:
     1505         find first buf_clients no-lock
     1506           where buf_clients.obj-type = p-obj-type
     1507             and buf_clients.obj-code = p-obj-code
     1508         no-error .
     1509         if not available buf_clients
     1510         then do:
     1511           return error substitute( "Не найден контрагент &1 &2" , p-obj-type, p-obj-code ) .
     1512         end.
     1513         assign
     1514           p-code = 1000000000 + buf_clients.obj-code
     1515         .
     1516       end.
     1517       otherwise do:
     1518         return error substitute( "Недопустимый тип контрагента:&1":U , p-obj-type ).
     1519       end.
     1520     end case.
     1521   end.
     1522   end procedure.
     1523   procedure thdl-prc_unmap-store :
     1524     define input  parameter p-code      as integer   no-undo .
     1525     define output parameter p-obj-type  as character no-undo .
     1526     define output parameter p-obj-code  as integer   no-undo .
     1527     define buffer buf_store   for ub.store.
     1528     define buffer buf_shop    for ub.shop.
     1529     define variable v-code as integer   no-undo .
     1530   do for
     1531     buf_store
     1532   , buf_shop
     1533   on error undo, return error return-value
     1534   :
     1535     assign
     1536       p-obj-type = ?
     1537       p-obj-code = ?
     1538     .
     1539     if p-code > 100000
     1540     then do :
     1541       assign
     1542         v-code = p-code - 100000
     1543       .
     1544       find first buf_store no-lock
     1545         where buf_store.obj-code = v-code
     1546       no-error .
     1547       if not available buf_store
     1548       then do:
     1549         return .
     1550       end.
     1551       assign
     1552         p-obj-type = 'скл':U
     1553         p-obj-code = buf_store.obj-code
     1554       .
     1555     end.
     1556     else do:
     1557       find first buf_shop no-lock
     1558         where buf_shop.obj-code = p-code
     1559       no-error .
     1560       if not available buf_shop
     1561       then do:
     1562         return .
     1563       end.
     1564       assign
     1565         p-obj-type = 'маг':U
     1566         p-obj-code = buf_shop.obj-code
     1567       .
     1568     end.
     1569   end.
     1570   end procedure.
     1571   procedure thdl-prc_unmap-agent :
     1572     define input  parameter p-code      as integer   no-undo .
     1573     define output parameter p-obj-type  as character no-undo .
     1574     define output parameter p-obj-code  as integer   no-undo .
     1575     define variable v-code as integer   no-undo .
     1576     define buffer buf_clients for ub.clients.
     1577   do for
     1578     buf_clients
     1579   on error undo, return error return-value
     1580   :
     1581     assign
     1582       p-obj-type = ?
     1583       p-obj-code = ?
     1584     .
     1585     if p-code > 1000000000
     1586     then do:
     1587       assign
     1588         v-code = p-code - 1000000000
     1589       .
     1590       find first buf_clients no-lock
     1591         where buf_clients.obj-type = 'орг':U
     1592           and buf_clients.obj-code = v-code
     1593       no-error .
     1594       if not available buf_clients
     1595       then do:
     1596         return .
     1597       end.
     1598       assign
     1599         p-obj-type = 'орг':U
     1600         p-obj-code = buf_clients.obj-code
     1601       .
     1602     end.
     1603     else do:
     1604       find first buf_clients no-lock
     1605         where buf_clients.obj-type = 'чел':U
     1606           and buf_clients.obj-code = p-code
     1607       no-error .
     1608       if not available buf_clients
     1609       then do:
     1610         return .
     1611       end.
     1612       assign
     1613         p-obj-type = 'чел':U
     1614         p-obj-code = buf_clients.obj-code
     1615       .
     1616     end.
     1617   end.
     1618   end procedure.
