      797   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   function octal-to-char return character
      799   ( p-string as character ) :
      800     def var v-asc     as integer no-undo .
      801     def var v-new-asc as integer no-undo .
      802     def var ind       as integer no-undo .
      803     if length(p-string) <> 3 then do:
      804       return ? .
      805     end.
      806     assign
      807       v-asc = 0
      808     .
      809     do ind = 1 to length(p-string)
      810     :
      811       assign
      812         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      813       .
      814       if v-new-asc < 0 or v-new-asc >= 8 then do:
      815         return ? .
      816       end.
      817       assign
      818         v-asc = v-asc * 8 + v-new-asc
      819       .
      820     end.
      821     return chr(v-asc) .
      822   end function .
      823   function char-to-octal return character
      824   ( p-chr as character ) :
      825     def var v-asc    as integer   no-undo .
      826     def var ind      as integer   no-undo .
      827     def var v-string as character no-undo .
      828     if length(p-chr) <> 1 then do:
      829       return ? .
      830     end.
      831     assign
      832       v-asc    = asc(p-chr)
      833       v-string = ""
      834     .
      835     do ind = 1 to 3
      836     :
      837       assign
      838         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      839       .
      840       assign
      841         v-asc = truncate(v-asc / 8, 0)
      842       .
      843     end.
      844     return v-string .
      845   end.
      846   function str-encode return character
      847   (   p-init-string       as character
      848     , p-encode-char       as character
      849     , p-special-char-list as character
      850   ) :
      851     def var p-encode-string as character no-undo .
      852     def var ind                as integer no-undo .
      853     def var v-num-special-char as integer no-undo .
      854     def var v-special-char     as character no-undo .
      855     if p-encode-char = ?
      856     or p-encode-char = "" then do:
      857       assign
      858         p-encode-char = "~~"
      859       .
      860     end.
      861     if p-init-string = ? then do:
      862       return "?" .
      863     end.
      864     if p-init-string = "?" then do:
      865       return p-encode-char + char-to-octal("?") .
      866     end.
      867     assign
      868       v-num-special-char = length(p-special-char-list)
      869       p-encode-string    = replace(p-init-string
      870                                   ,p-encode-char
      871                                   ,p-encode-char + char-to-octal(p-encode-char)
      872                                   )
      873     .
      874     do ind = 1 to v-num-special-char
      875     :
      876       assign
      877         v-special-char = substring(p-special-char-list, ind, 1)
      878       .
      879       if v-special-char <> p-encode-char then do:
      880         assign
      881           p-encode-string = replace (p-encode-string
      882                                     ,v-special-char
      883                                     ,p-encode-char + char-to-octal(v-special-char)
      884                                     )
      885         .
      886       end.
      887     end.
      888     return p-encode-string .
      889   end.
      890   function str-decode returns character
      891     (p-init-string   as character
      892     ,p-encode-char   as character
      893     ) :
      894     def var p-decode-string as character no-undo .
      895     def var ind                       as integer no-undo .
      896     def var v-num-entries-init-string as integer no-undo .
      897     def var v-sub-phrase              as character no-undo .
      898     def var v-special-char            as character no-undo .
      899     if p-encode-char = ?
      900     or p-encode-char = "" then do:
      901       assign
      902         p-encode-char = "~~"
      903       .
      904     end.
      905     if p-init-string = "?" then do:
      906       return ? .
      907     end.
      908     assign
      909       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      910     .
      911     if v-num-entries-init-string > 1 then do:
      912       assign
      913         p-decode-string = entry(1, p-init-string, p-encode-char)
      914       .
      915       do ind = 2 to v-num-entries-init-string
      916       :
      917         assign
      918           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      919         .
      920         assign
      921           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      922         .
      923         if v-special-char <> ? then do:
      924           assign
      925             p-decode-string = p-decode-string
      926                             + v-special-char
      927                             + substring(v-sub-phrase, 4)
      928           .
      929         end.
      930         else do:
      931           assign
      932             p-decode-string = p-decode-string
      933                             + p-encode-char
      934                             + v-sub-phrase
      935           .
      936         end.
      937       end.
      938     end.
      939     else do:
      940       assign
      941         p-decode-string = p-init-string
      942       .
      943     end.
      944     return p-decode-string .
      945   end.
      946   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      948   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      949     field cst-code                like ub.trn-doc.cst-code
      950     field part-code               like ub.parts.part-code
      951     .
      952   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      953   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      954   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      955   function hvrdtax return logical (input parrecid as recid):
      956   define variable varresult as logical no-undo.
      957   run hvrdtax-proc (input parrecid, output varresult).
      958   return varresult.
      959   end function.
      960   procedure hvrdtax-proc:
      961   define input  parameter parrecid  as recid   no-undo.
      962   define output parameter parresult as logical no-undo.
      963   define buffer bf_goods for ub.goods.
      964   define buffer bf_units for ub.units.
      965   define buffer rt_tax   for ub.tax.
      966   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      967   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      968   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      969   if available rt_tax and
      970       can-find(first ub.tax-units No-LOCK WHERE
      971                      ub.tax-units.tax-code = rt_tax.tax-code AND
      972                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      973                                                       else assign parresult = no.
      974   end procedure.
      975   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      976   define new global shared variable g#lib-calc as handle no-undo .
      977   procedure plgdsfnd :
      978     define input  parameter p-chk-and-chs    as logical               no-undo .
      979     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      980     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      981     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      982     define output parameter p-reserv-pl-code as   logical             no-undo .
      983     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      984     define buffer buf_goods         for ub.goods .
      985     define buffer buf_pl-gds        for ub.pl-gds .
      986     define buffer buf_second_pl-gds for ub.pl-gds .
      987     find first buf_goods no-lock where
      988                buf_goods.gds-code = p-gds-code no-error .
      989     if not available buf_goods
      990     then do:
      991       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      992     end.
      993   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      995     (input  p-obj-type
      996     ,input  p-obj-code
      997     ,input  buf_goods.artic
      998     ,input  buf_goods.prod-type
      999     ,input  buf_goods.prod-code
     1000     ,input  'place-rsrv=request'
     1001     ,output p-reserv-pl-code
     1002     ) no-error .
     1003     if error-status :error
     1004     then do:
     1005       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1006     end.
     1007     if p-reserv-pl-code = no
     1008     then do:
     1009       return .
     1010     end.
     1011     if p-chk-and-chs <> yes
     1012     then do:
     1013       return .
     1014     end.
     1015     find first buf_pl-gds no-lock where
     1016                buf_pl-gds.obj-type = p-obj-type and
     1017                buf_pl-gds.obj-code = p-obj-code and
     1018                buf_pl-gds.gds-code = p-gds-code no-error .
     1019     if not available buf_pl-gds
     1020     then do:
     1021       return error "К товару не привязано ни одного места хранения" .
     1022     end.
     1023     find first buf_second_pl-gds no-lock where
     1024                buf_second_pl-gds.obj-type  = p-obj-type          and
     1025                buf_second_pl-gds.obj-code  = p-obj-code          and
     1026                buf_second_pl-gds.gds-code  = p-gds-code          and
     1027                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1028     if not available buf_second_pl-gds
     1029     then do:
     1030       assign
     1031         p-pl-code = buf_pl-gds.pl-code
     1032       .
     1033     end.
     1034     else do:
     1035       if not valid-handle( parparentproc )
     1036       then do:
     1037         return error "Не выбрано место хранения " + chr(10) .
     1038       end.
     1039       run str/plgdssel.p
     1040         (
     1041            input parparentproc
     1042         ,  input p-obj-type
     1043         ,  input p-obj-code
     1044         ,  input p-gds-code
     1045         , output p-pl-code
     1046         ) no-error .
     1047       if error-status :error
     1048       then do:
     1049         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1050                                , 'plgdssel.p':U
     1051                                , chr(10)
     1052                                , error-status :get-message( 1 )
     1053                                , return-value
     1054                                ) .
     1055       end.
     1056       if p-pl-code = ? or
     1057          p-pl-code = 0
     1058       then do:
     1059         return error "Не выбрано место хранения " + chr(10) .
     1060       end.
     1061     end.
     1062   end procedure.
     1063   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   define temp-table tt-trn-doc  no-undo like ub.trn-doc.
     1065   define temp-table tt-doc-line no-undo like ub.doc-line
     1066   field cst-code like ub.trn-doc.cst-code
     1067   .
     1068   define temp-table tt-doc-line-attr no-undo like ub.doc-line-attr.
     1069   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     1070   define temp-table tt-parts    no-undo like ub.parts.
     1071   procedure lib-trn_copy-inqu :
     1072   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     1073   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     1074   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     1075   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     1076   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     1077   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     1078   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     1079   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     1080   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1081   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     1082   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     1083   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     1084   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     1085   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     1086   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     1087   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     1088   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     1089   define input parameter parinp-discnt-type as   logical                no-undo.
     1090   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     1091   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     1092   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     1093   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     1094   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     1095   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     1096   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     1097   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     1098   define input parameter table for tt-doc-line.
     1099   define input parameter table for tt-gds-dtl.
     1100   define input parameter table for tt-parts.
     1101   define input parameter paruse-parts       as   logical                no-undo.
     1102   define input parameter parall-qnty        as   logical                no-undo.
     1103   define input parameter parfix-price       as   logical                no-undo.
     1104   define buffer crt_trn-doc  for ub.trn-doc.
     1105   define buffer crt_goods    for ub.goods.
     1106   define buffer crt_doc-line for ub.doc-line.
     1107   define buffer crt_gds-dtl  for ub.gds-dtl.
     1108   define variable end-price    as   logical              no-undo.
     1109   define variable real-type    like ub.goods.gds-type    no-undo.
     1110   define variable legal-node   like ub.gds-prt.node-code no-undo.
     1111   define variable chg-qnty     like ub.gds-dtl.fact-qnty no-undo.
     1112   define variable varchg-qnty  like ub.gds-dtl.fact-qnty no-undo.
     1113   define variable varfact-qnty like ub.gds-dtl.fact-qnty no-undo.
     1114   define variable g-log        as   logical              no-undo.
     1115   define variable mem-qnty like chg-qnty no-undo.
     1116   define variable dflt-cd as character no-undo .
     1117   c-l:
     1118   do on error undo, return error return-value :
     1119   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     1120   assign
     1121       paruse-parts = false
     1122       .
     1123   assign
     1124     end-price = no.
     1125   if parinp-discnt-type = yes and
     1126      parinp-discnt-pc   = 0   and
     1127      can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type)
     1128      then do:
     1129     assign
     1130       crt_trn-doc.tot-calc    = partot-calc
     1131       crt_trn-doc.discnt-pc   = pardiscnt-pc
     1132       crt_trn-doc.discnt-type = pardiscnt-type.
     1133   end.
     1134   if parinp-agnt = ? then do:
     1135     assign
     1136       crt_trn-doc.agnt = paragnt.
     1137   end.
     1138   if parinp-boss = ? then do:
     1139     assign
     1140       crt_trn-doc.boss = parboss.
     1141   end.
     1142   if parinp-wrkr = ? then do:
     1143     assign
     1144       crt_trn-doc.wrkr = parwrkr.
     1145   end.
     1146   if parinp-base-rate  = ? then do:
     1147     assign
     1148       crt_trn-doc.base-rate  = parbase-rate.
     1149   end.
     1150   if parinp-base-scale = ? then do:
     1151     assign
     1152       crt_trn-doc.base-scale = parbase-scale.
     1153   end.
     1154   find first tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock no-error.
     1155   if available tt-doc-line then do:
     1156     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1157                      and crt_goods.prod-type = tt-doc-line.prod-type
     1158                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1159     if crt_goods.gds-type = 'у':U and
     1160        (crt_trn-doc.doc-type <> 'рас':U or crt_trn-doc.internal) then do:
     1161       return error "В данный документ нельзя копировать услуги.".
     1162     end.
     1163     assign
     1164       real-type = crt_goods.gds-type.
     1165     find first crt_doc-line where crt_doc-line.doc-code = crt_trn-doc.doc-code no-lock no-error.
     1166     if available crt_doc-line then do:
     1167       find crt_goods where crt_goods.artic     = crt_doc-line.artic
     1168                        and crt_goods.prod-type = crt_doc-line.prod-type
     1169                        and crt_goods.prod-code = crt_doc-line.prod-code no-lock.
     1170       if crt_goods.gds-type <> real-type then do:
     1171         return error "Услуги и товары не могут быть добавлены в один и тот же документ.".
     1172       end.
     1173     end.
     1174     else do:
     1175       assign
     1176         crt_trn-doc.office = (if real-type = 'у':U then yes else no).
     1177     end.
     1178   end.
     1179   r-l:
     1180   for each tt-doc-line where tt-doc-line.doc-code = pardoc-code no-lock on error undo, return error return-value :
     1181     find crt_goods where crt_goods.artic     = tt-doc-line.artic
     1182                      and crt_goods.prod-type = tt-doc-line.prod-type
     1183                      and crt_goods.prod-code = tt-doc-line.prod-code no-lock.
     1184   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclno in g#lib-trn
     1185      (
     1186       input crt_trn-doc.doc-code
     1187      ,input crt_trn-doc.obj-type
     1188      ,input crt_trn-doc.obj-code
     1189      ,input crt_goods.artic
     1190      ,input crt_goods.prod-type
     1191      ,input crt_goods.prod-code
     1192      ,input crt_goods.gds-name
     1193      ,input crt_goods.prt-root
     1194      ,input ?
     1195      ,input ?
     1196      ,input parcash-pay      ) no-error.
     1197     if error-status:error then do:
     1198       undo c-l, return error return-value.
     1199     end.
     1200     if return-value = "next" then do:
     1201       next r-l.
     1202     end.
     1203     find first crt_doc-line where crt_doc-line.doc-code  = crt_trn-doc.doc-code and
     1204                                   crt_doc-line.artic     = crt_goods.artic      and
     1205                                   crt_doc-line.prod-type = crt_goods.prod-type  and
     1206                                   crt_doc-line.prod-code = crt_goods.prod-code .
     1207     for each tt-gds-dtl where tt-gds-dtl.prod-type = tt-doc-line.prod-type and
     1208                               tt-gds-dtl.prod-code = tt-doc-line.prod-code and
     1209                               tt-gds-dtl.artic     = tt-doc-line.artic     and
     1210                               tt-gds-dtl.doc-code  = tt-doc-line.doc-code no-lock
     1211                               break by tt-gds-dtl.artic
     1212                                     by tt-gds-dtl.prod-type
     1213                                     by tt-gds-dtl.prod-code
     1214                               :
     1215   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_lgl-node in g#lib-trn
     1216     ( input  tt-gds-dtl.artic
     1217      ,input  tt-gds-dtl.prod-type
     1218      ,input  tt-gds-dtl.prod-code
     1219      ,input  tt-gds-dtl.prt-code
     1220      ,input  tt-doc-line.obj-type
     1221      ,input  tt-doc-line.obj-code
     1222      ,output legal-node
     1223     ) no-error .
     1224       if error-status:error then do:
     1225          undo c-l, return error substitute ("&1 &2", return-value, error-status:get-message (1)).
     1226       end.
     1227   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     1228     ( input crt_trn-doc.obj-code
     1229      ,input crt_trn-doc.obj-type
     1230      ,input crt_trn-doc.doc-code
     1231      ,input crt_goods.artic
     1232      ,input crt_goods.prod-code
     1233      ,input crt_goods.prod-type
     1234      ,input legal-node
     1235      ,input yes
     1236     ) no-error .
     1237        if error-status:error then do:
     1238           return error substitute ("Ошибка при создании признака &1.", return-value) .
     1239        end.
     1240        find first crt_gds-dtl where crt_gds-dtl.doc-code  = crt_trn-doc.doc-code and
     1241                                     crt_gds-dtl.artic     = crt_goods.artic      and
     1242                                     crt_gds-dtl.prod-code = crt_goods.prod-code  and
     1243                                     crt_gds-dtl.prod-type = crt_goods.prod-type  and
     1244                                     crt_gds-dtl.prt-code  = legal-node.
     1245       assign
     1246         crt_gds-dtl.ov             = parfix-price
     1247         crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     1248         crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     1249         crt_gds-dtl.new-price-sale = tt-gds-dtl.new-price-sale
     1250         .
     1251       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     1252         assign
     1253           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     1254           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     1255           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     1256           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     1257       end.
     1258       if end-price then do:
     1259         assign
     1260           crt_gds-dtl.ov             = yes
     1261           crt_gds-dtl.price-base     = tt-gds-dtl.price-base - tt-gds-dtl.discnt-base
     1262           crt_gds-dtl.discnt-base    = 0
     1263           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl - tt-gds-dtl.discnt-rubl
     1264           crt_gds-dtl.discnt-rubl    = 0
     1265           crt_gds-dtl.discnt-pc      = 0
     1266           crt_gds-dtl.discnt-type    = yes.
     1267       end.
     1268   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     1270     ( input recid(crt_gds-dtl)
     1271     , input no
     1272     , input ?
     1273     ) no-error.
     1274           if error-status:error then do:
     1275             undo c-l, return error return-value.
     1276           end.
     1277       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     1278          crt_gds-dtl.ov then do:
     1279         undo c-l, return error "При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник.".
     1280       end.
     1281       if paruse-parts then do:
     1282          if first-of (tt-gds-dtl.prod-code) then do:
     1283            for each tt-parts :
     1284              assign
     1285                chg-qnty = tt-parts.fact-qnty
     1286                mem-qnty = chg-qnty.
     1287              assign
     1288              crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1289              crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1290            end.
     1291            assign
     1292              crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + tt-gds-dtl.fact-qnty
     1293              crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty.
     1294            assign
     1295              varchg-qnty  = varchg-qnty  + tt-gds-dtl.fact-qnty
     1296              varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1297            if crt_gds-dtl.doc-qnty = 0 then do:
     1298              delete crt_gds-dtl.
     1299            end.
     1300          end.
     1301       end.
     1302       else do:
     1303         assign
     1304           chg-qnty = tt-gds-dtl.fact-qnty
     1305           mem-qnty = chg-qnty.
     1306         assign
     1307           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     1308           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     1309           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     1310           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty.
     1311         assign
     1312         varchg-qnty  = varchg-qnty  + chg-qnty
     1313         varfact-qnty = varfact-qnty + tt-gds-dtl.fact-qnty.
     1314         if crt_gds-dtl.doc-qnty = 0 then do:
     1315           delete crt_gds-dtl.
     1316         end.
     1317       end.
     1318     end.
     1319     if crt_doc-line.doc-qnty = 0 then do:
     1320       delete crt_doc-line.
     1321     end.
     1322   end.
     1323   end.
     1324   end procedure.
     1325   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326     define variable v-cntxt-db-num        as integer   no-undo .
     1327     define variable v-cntxt-userid        as character no-undo .
     1328     define variable v-cntxt-level         as character no-undo .
     1329     define variable v-cntxt-host-code-obj as integer   no-undo .
     1330     define variable v-cntxt-obj-type      as character no-undo .
     1331     define variable v-cntxt-obj-code      as integer   no-undo .
     1332     define variable v-cntxt-db-num-obj    as integer   no-undo .
