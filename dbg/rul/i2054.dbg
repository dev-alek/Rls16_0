       54   define dataset thdoc for temp_doc-header, temp_doc-line.
       55   define input  parameter parparentproc as widget-handle no-undo .
       56   define input  parameter p-log-handle  as handle no-undo .
       57   define input  parameter table for  temp_doc-header.
       58   define input  parameter table for  temp_doc-line.
       59   define output parameter p-ok-doc as integer   no-undo .
       60   define variable vss-revision    as character no-undo init "$Revision$":U .
       61   define variable vss-author      as character no-undo init "$Author$":U .
       62   define variable vss-date        as character no-undo init "$Date$":U .
       63   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       64   define variable vss-archive     as character no-undo init "$Archive$":U .
       65   define variable vss-description as character no-undo init "Импорт из внешней системы DKLink".
       66   procedure vss-get-info :
       67     define output parameter p-vss-revision    like vss-revision    no-undo .
       68     define output parameter p-vss-author      like vss-author      no-undo .
       69     define output parameter p-vss-date        like vss-date        no-undo .
       70     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       71     define output parameter p-vss-archive     like vss-archive     no-undo .
