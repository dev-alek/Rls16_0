       73     assign
       74       p-vss-revision    = vss-revision
       75       p-vss-author      = vss-author
       76       p-vss-date        = vss-date
       77       p-vss-workfile    = vss-workfile
       78       p-vss-archive     = vss-archive
       79       p-vss-description = vss-description
       80     .
       81   end procedure.
       82   procedure vss-get-parameters :
       83     define output parameter p-vss-parameters as character no-undo .
       84   end procedure.
       85   define new global shared variable g#vssrevis-logger as handle    no-undo .
       86   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       87   define variable v-vssrevis-logger                   as handle    no-undo .
       88   procedure vss-logevent :
       89     define input  parameter p-extra-paramters as character no-undo .
       90     define variable v-vssrevis-parameters as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       if  valid-handle(v-vssrevis-logger)
       95       and v-vssrevis-logger :get-signature("logevent") <> ""
       96       then do:
       97         run vss-get-parameters in this-procedure
       98           (output v-vssrevis-parameters
       99           ).
      100         run logevent in v-vssrevis-logger
      101           (input vss-workfile
      102           ,input vss-revision
      103           ,input v-vssrevis-parameters
      104           ,input p-extra-paramters
      105           ).
      106       end.
      107     end.
      108   end procedure.
      109   assign
      110     v-vssrevis-logger = g#vssrevis-logger
      111   .
      112   if  valid-handle(v-vssrevis-logger)
      113   and v-vssrevis-logger :get-signature("logevent") <> ""
      114   then do:
      115     assign
      116       v-vssrevis-logevent = true
      117     .
      118     run vss-logevent in this-procedure (input vss-description) .
      119   end.
      120   define new global shared variable g#language as character no-undo .
      121   if g#language <> '' and g#language <> 'rus':U then do:
      122     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      123   end.
      124   define new global shared variable g#library  as handle no-undo .
      125   define new global shared variable g#library2 as handle no-undo .
      126   define new global shared variable g#lib-trn  as handle no-undo .
      127   define new global shared variable g#lib-trn2 as handle no-undo .
      128   define new global shared variable g#lib-trn3 as handle no-undo .
      129   define new global shared variable g#lib-trn4 as handle no-undo .
      130   define new global shared variable g#libbcrcn as handle no-undo .
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable to-day       as date no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure doc-code:
      135   define input  parameter parmode          as   character           no-undo.
      136   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      137   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      138   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      139   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      140   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      141   define variable vardb-remote     as   logical             no-undo.
      142   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      143   define variable v-delimiter as character no-undo .
      144   do
      145   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      146   :
      147   find first buf_sys-ctrl no-lock .
      148   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      149     CASE parmode:
      150       when "main":u then do:
      151         if vardb-remote then do:
      152           assign
      153             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      154         end.
      155         else do:
      156           assign
      157             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      158         end.
      159       end.
      160       when "trio" then do:
      161         assign
      162           pardoc-code = replace (parroot-doc-code, "=", "*").
      163       end.
      164       otherwise do:
      165         assign
      166         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      167         no-error
      168         .
      169         if error-status:error  then do:
      170           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      171                                         ,chr(10)
      172                                         ,parmode
      173                                         ).
      174         end.
      175         if num-entries(parmode) = 1
      176         and parmode <> "chip":U
      177         and parmode <> "chip_s":U
      178         then do:
      179           assign
      180           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      181         end.
      182         else if (lookup("chip":U, parmode) > 0
      183                  or
      184                  lookup("chip_s":U, parmode) > 0) then do:
      185           assign
      186             vartemp-doc-code = parroot-doc-code.
      187           do while true:
      188             if index (vartemp-doc-code , ".") = 0 then
      189               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      190             else
      191               vartemp-doc-code  =
      192               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      193               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      194               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      195             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      196           end.
      197           assign
      198             pardoc-code = vartemp-doc-code.
      199         end.
      200       end.
      201     end CASE.
      202     if pardoc-code = '':U
      203     or (parroot-doc-code <> '':U
      204     and pardoc-code = parroot-doc-code) then do:
      205       undo, return error substitute("Ошибка при генерации номера документа&1"
      206                                     ,chr(10)).
      207     end.
      208   end.
      209   end. // procedure/method
      210   function get-doc-code-int64 returns int64
      211     ( input p-doc-code as character ) :
      212     define variable v-ind              as integer   no-undo .
      213     define variable v-num-entries      as integer   no-undo .
      214     define variable v-doc-code-int64   as int64     no-undo .
      215     define variable v-canonic-doc-code as character no-undo .
      216     assign
      217       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      218       v-canonic-doc-code = p-doc-code
      219     .
      220     do v-ind = 1 to v-num-entries
      221     :
      222       assign
      223         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      224       .
      225     end.
      226     assign
      227       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      228     .
      229     return v-doc-code-int64 .
      230   end. // function/method
      231   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   define variable v-waitfram-action01         as character   no-undo .
      233   define variable v-waitfram-action02         as character   no-undo .
      234   define variable v-waitfram-action03         as character   no-undo .
      235   define variable mWaitFramTextBeg            as character   no-undo.
      236   define variable mWaitFramTextEnd            as character   no-undo.
      237   define variable mWaitFramView               as logical     no-undo.
      238   define variable mWaitProcEvent              as logical     no-undo init yes.
      239   define variable mWaitFramInterval           as integer     no-undo init 1 .
      240   define variable mWaitFramStop               as logical     no-undo.
      241   define variable mWaitFramStopUser           as logical     no-undo.
      242   define variable mWaitFramStopTimeOut        as logical     no-undo.
      243   define variable mWaitFramStartProc          as datetime-tz no-undo.
      244   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      245   define button B-WaitFramStop auto-end-key
      246        label "Стоп"
      247        size 10 by 1 tooltip "Остоновить процесс".
      248   define button B-viewProcInfo
      249        label "Информация"
      250        size 15 by 1 tooltip "Информация о процесс".
      251   define frame waitfram
      252     v-waitfram-action01 format "x(72)" no-label skip
      253     v-waitfram-action02 format "x(72)" no-label skip
      254     v-waitfram-action03 format "x(72)" no-label skip
      255     B-viewProcInfo
      256     B-WaitFramStop at row 4 col 30
      257     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      258     .
      259   define new global shared variable mBatchMode as logical no-undo init ?.
      260   define variable mFramBachModHandle as handle no-undo.
      261   mFramBachModHandle = frame waitfram:handle.
      262   define variable mFameOldVis as logical no-undo.
      263   define variable mVisCUrentVin as logical no-undo.
      264   if session:batch-mode
      265   then
      266      mBatchMode = yes.
      267   if mBatchMode = ? then do:
      268     mVisCUrentVin = current-window:visible.
      269     mFameOldVis = mFramBachModHandle:visible.
      270     mFramBachModHandle:visible  = yes.
      271     mBatchMode = mFramBachModHandle:visible ne yes.
      272     mFramBachModHandle:visible = mFameOldVis.
      273     current-window:visible = mVisCUrentVin.
      274   end.
      275    if  log-manager:logfile-name ne ?
      276     then DO:
      277         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      278         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      279         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      280     end.
      281   on choose of B-WaitFramStop in frame waitfram
      282   do:
      283     mWaitFramStop = yes.
      284     mWaitFramStopUser = yes.
      285   end.
      286   function waitfram-check-timeout returns logical():
      287      define variable vtime as int64 no-undo.
      288      if mWaitFramStopTimeOut
      289      then
      290         return yes.
      291      vtime = ( now - mWaitFramStartProc ) / 1000 .
      292      if     mWaitFramTimeOut ne ?
      293         and mWaitFramTimeOut ne 0
      294         and mWaitFramTimeOut lt vtime
      295      then do:
      296         mWaitFramStopTimeOut = yes.
      297      end.
      298      return mWaitFramStopTimeOut.
      299   end.
      300   procedure waitfram-hide :
      301     if not session:batch-mode
      302     then do
      303     on error undo, return error return-value
      304     :
      305       pause 0 before-hide .
      306       if not mBatchMode then
      307         hide frame waitfram .
      308     if     not mWaitFramView
      309        and mWaitProcEvent
      310     then
      311       process events .
      312     end.
      313   end procedure.
      314   procedure waitfram-show :
      315     define input  parameter p-message as character no-undo .
      316     define variable v-left-margin as integer   no-undo .
      317     if not session:batch-mode
      318     then do
      319     on error undo, return error return-value
      320     :
      321       if length(p-message) <= 70 then do:
      322         assign
      323           v-left-margin = integer((70 - length(p-message)) / 2)
      324         .
      325         assign
      326           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      327         .
      328         assign
      329           v-waitfram-action01 = " "
      330           v-waitfram-action02 = " "
      331                                    + fill(" ", v-left-margin)
      332                                    + p-message
      333           v-waitfram-action03 = " "
      334         .
      335       end.
      336       else do:
      337         define variable vRindex1 as integer no-undo.
      338         define variable vRindex2 as integer no-undo.
      339         vRindex1 = r-index(p-message," ",70).
      340         if vRindex1 = 0
      341         then
      342            vRindex1 = 70.
      343         if length(p-message)  <= vRindex1 + 70 then do:
      344           assign
      345             v-waitfram-action01 = " "
      346             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      347             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      348           .
      349         end.
      350         else do:
      351           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      352           if vRindex2 <= vRindex1
      353           then
      354              vRindex2 = vRindex1 + 70.
      355           assign
      356             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      357             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      358             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      359           .
      360         end.
      361       end.
      362       B-viewProcInfo:visible   in frame waitfram = no.
      363       B-viewProcInfo:sensitive in frame waitfram = no.
      364       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      365       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      366       if  (   mWaitFramView
      367          or  mWaitProcEvent)
      368          and not mBatchMode
      369       then
      370          display
      371             v-waitfram-action01 skip
      372             v-waitfram-action02 skip
      373             v-waitfram-action03 skip
      374          with frame waitfram .
      375       if     mWaitFramView
      376          then do:
      377             if     mWaitFramInterval ne ?
      378                and not mBatchMode
      379             then
      380                wait-for go of frame waitfram pause mWaitFramInterval.
      381          end.
      382          else
      383             if     mWaitProcEvent
      384                and not mBatchMode
      385             then
      386                process events .
      387     end.
      388   end procedure.
      389      procedure waitfram-show-this:
      390         define input  parameter iInterval as int64 no-undo.
      391         define variable vtime as int64 no-undo.
      392         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      393         mWaitFramInterval = iInterval.
      394         run waitfram-show (substitute("&1&2 &3&4" ,
      395                                       mWaitFramTextBeg ,
      396                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      397                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      398                                       mWaitFramTextEnd
      399                                      )
      400                           ).
      401      end.
      402      procedure WaitFramRunPause:
      403         define input  parameter iInterval as dec no-undo.
      404         define variable vStart  as datetime-tz no-undo.
      405         define variable vend    as datetime-tz no-undo.
      406         define variable vint as int64 no-undo.
      407         define variable vOk as logical no-undo.
      408         vStart = now.
      409         vend   = vStart.
      410         publish "WaitFramPause" (iInterval,output vOk).
      411         vend   =  now.
      412         vint = vend - vStart.
      413         vint = iInterval - vint / 1000.
      414         if     not mWaitFramStop
      415            and (   vint > 0
      416                 or (    not vOk
      417                     and iInterval eq ?
      418                     )
      419                 )
      420         then
      421            run waitfram-show-this (iInterval).
      422         vend   =  now.
      423         vint = vend - vStart.
      424         vint = iInterval - vint / 1000.
      425         if     not mWaitFramStop
      426            and vint > 0
      427         then do:
      428            run gbl/pause.p (vint * 1000).
      429         end.
      430         if iInterval ne ?
      431         then
      432            publish "WaitFramStop".
      433         waitfram-check-timeout().
      434      end.
      435      procedure WaitFramWaitFor:
      436         define input  parameter iInterval as dec no-undo.
      437         assign
      438            mWaitFramStartProc   = now
      439            mWaitFramStopUser    = no
      440            mWaitFramStopTimeOut = no
      441         .
      442         block-wait:
      443         do while not mWaitFramStop:
      444            run WaitFramRunPause (iInterval).
      445            if  waitfram-check-timeout()
      446            then do:
      447               leave block-wait.
      448            end.
      449         end.
      450         run waitfram-hide.
      451      end.
      452   procedure waitfram-join :
      453     define input  parameter p-line-1  as character no-undo .
      454     define input  parameter p-line-2  as character no-undo .
      455     define input  parameter p-line-3  as character no-undo .
      456     define output parameter p-message as character no-undo .
      457     do
      458     on error undo, return error return-value
      459     :
      460       assign
      461         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      462                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      463                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      464       .
      465     end.
      466   end procedure.
      467   function waitfram-join-function returns character
      468     (input p-line-1 as character
      469     ,input p-line-2 as character
      470     ,input p-line-3 as character
      471     ).
      472     define variable v-message as character no-undo .
      473     run waitfram-join in this-procedure
      474       (input  p-line-1
      475       ,input  p-line-2
      476       ,input  p-line-3
      477       ,output v-message
      478       ) .
      479     return v-message .
      480   end function .
      481   function cross-list returns logical (
      482     input parfirst-stream  as character,
      483     input parsecond-stream as character,
      484     input pardelim         as character).
      485     if pardelim = ""
      486     or pardelim = ?
      487     then do:
      488       assign
      489         pardelim = ","
      490       .
      491     end.
      492     define variable vari            as integer no-undo .
      493     define variable varresult-cross as logical no-undo .
      494     assign
      495       varresult-cross = no
      496     .
      497     def var v-num-parfirst-stream as integer no-undo .
      498     assign
      499       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      500     .
      501     do vari = 1 to v-num-parfirst-stream
      502     :
      503       if lookup(entry(vari, parfirst-stream, pardelim)
      504                ,parsecond-stream
      505                ,pardelim
      506                ) > 0 then do:
      507         assign
      508           varresult-cross = yes
      509         .
      510         leave.
      511       end.
      512     end.
      513     return varresult-cross .
      514   end function.
      515   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      516   define new global shared variable g#attr-lib  as handle no-undo .
      517   define variable v-attr-lib-variable as handle no-undo .
      518   procedure clntattr-code :
      519     define input  parameter p-code           as character no-undo .
      520     define output parameter p-type           as character no-undo .
      521     define output parameter p-format         as character no-undo .
      522     define output parameter p-label          as character no-undo .
      523     define output parameter p-user-can-edit  as logical   no-undo .
      524     define output parameter p-output-display as logical   no-undo .
      525     define output parameter p-other          as character no-undo .
      526     do
