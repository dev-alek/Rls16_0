     1687   define variable v-gds-code        as integer   no-undo .
     1688   define buffer buf_temp_doc-header for temp_doc-header.
     1689   define buffer buf_temp_doc-line   for temp_doc-line.
     1690   define buffer buf_temp2_doc-line  for temp2_doc-line.
     1691   define buffer buf_trn-doc         for ub.trn-doc.
     1692   define buffer t-doc               for ub.trn-doc.
     1693   define buffer buf_doc-line        for ub.doc-line.
     1694   define buffer buf_ord-doc-rcv     for ub.ord-doc-rcv.
     1695   define buffer buf_ord-doc         for ub.ord-doc.
     1696   define buffer buf_contract        for ub.contract.
     1697   define buffer buf_currency        for ub.currency.
     1698   define buffer buf_sysconf         for ub.sysconf.
     1699   define buffer new_trn-doc         for ub.trn-doc.
     1700   define buffer buf_goods           for ub.goods.
     1701   define buffer buf_bar-code        for ub.bar-code .
     1702   define buffer buf_prod-bc         for ub.prod-bc .
     1703   define buffer buf_place           for ub.place .
     1704   define buffer buf_contract-specif for ub.contract-specif.
     1705   define buffer buf_gds-obj         for ub.gds-obj.
     1706   define buffer buf_gds-dtl         for ub.gds-dtl.
     1707   define variable v-ok as integer   no-undo .
     1708   _main-block:
     1709   do
     1710   on error    undo _main-block , return error return-value
     1711   on end-key  undo _main-block , return error return-value
     1712   :
     1713     _temp_doc-header:
     1714     for each buf_temp_doc-header
     1715     :
     1716       if buf_temp_doc-header.action = 'D':U
     1717       then do:
     1718         next _temp_doc-header.
     1719       end.
     1720       find first buf_temp_doc-line
     1721         where buf_temp_doc-line.doc-id = buf_temp_doc-header.doc-id no-error.
     1722       if not available buf_temp_doc-line then do:
     1723          run pcall-log-file in p-log-handle (input substitute("....Полученный документ &1 ПУСТ....", buf_temp_doc-header.doc-id)) .
     1724          next _temp_doc-header.
     1725       end.
     1726       case buf_temp_doc-header.type
     1727       :
     1728         when 0 or
     1729         when 1 or
     1730         when 3 or
     1731         when 4 or
     1732         when 5 or
     1733         when 6
     1734         then do:
     1735           run utl/i2054-01.p ( input parparentproc
     1736                              , input p-log-handle
     1737                              , input table temp_doc-header
     1738                              , input table temp_doc-line
     1739                              , input buf_temp_doc-header.doc-id
     1740                              , output v-k
     1741                              ) no-error .
     1742           if error-status :error = yes
     1743           then do:
     1744             assign
     1745                 v-end-message =  substitute( "Ошибка вызова utl/i2054-01.p. &1&2&3":U
     1746                                             , return-value
     1747                                             , chr(10)
     1748                                             , error-status :get-message(1)
     1749                                             )
     1750             .
     1751             run pcall-log-file in p-log-handle (input v-end-message) .
     1752             if buf_temp_doc-header.type = 6
     1753             then do:
     1754               next _temp_doc-header.
     1755             end.
     1756             else do:
     1757               undo _main-block, return error v-end-message.
     1758             end.
     1759           end.
     1760         end.
     1761         when 2
     1762         then do:
     1763           run utl/i2054-02.p ( input parparentproc
     1764                              , input p-log-handle
     1765                              , input table temp_doc-header
     1766                              , input table temp_doc-line
     1767                              , input buf_temp_doc-header.doc-id
     1768                              , output v-k
     1769                              ) no-error .
     1770           if error-status :error = yes
     1771           then do:
     1772             assign
     1773                 v-end-message =  substitute( "Ошибка вызова utl/i2054-02.p. &1&2&3":U
     1774                                             , return-value
     1775                                             , chr(10)
     1776                                             , error-status :get-message(1)
     1777                                             )
     1778             .
     1779             run pcall-log-file in p-log-handle (input v-end-message) .
     1780             undo _main-block, return error v-end-message.
     1781           end.
     1782         end.
     1783         otherwise do :
     1784            next _temp_doc-header.
     1785         end.
     1786       end case.
     1787       assign
     1788         v-ok = v-ok + v-k
     1789       .
     1790     end.
     1791     assign
     1792       p-ok-doc = p-ok-doc + v-ok
     1793     .
     1794   end.
