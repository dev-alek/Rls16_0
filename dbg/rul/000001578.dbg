     1416         view-as alert-box error .
     1417       undo, return error .
     1418     end.
     1419     find first buf_temp-hist-nws-option where
     1420               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1421           and buf_temp-hist-nws-option.db-num = g#db-num
     1422           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1423           and buf_temp-hist-nws-option.charkey_one = p-type
     1424           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1425     if not available buf_temp-hist-nws-option then do:
     1426       find first last_temp-hist-nws-option where
     1427                last_temp-hist-nws-option.db-num = g#db-num
     1428             and last_temp-hist-nws-option.hn-id < 0 no-error.
     1429       create buf_temp-hist-nws-option.
     1430       assign
     1431       buf_temp-hist-nws-option.db-num = g#db-num
     1432       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1433                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1434                                   else -1 )
     1435       buf_temp-hist-nws-option.table-name = 'dis-host':U
     1436       buf_temp-hist-nws-option.key#_one = 2
     1437       buf_temp-hist-nws-option.charkey_one = p-type
     1438       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1439       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1440       .
     1441   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1443     (input  g#db-num
     1444     ,input  buffer buf_temp-hist-nws-option:handle
     1445     )  .
     1446     end.
     1447     run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'dis-host':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_dis-host:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord1                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-host':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1448     if g#db-num = 0 then do:
     1449      case buf_temp-hist-nws-option.smart-nws:
     1450         when integer('0':U)
     1451         or
     1452         when integer('10':U) then do:
     1453           if buf_dis-host.dt-code = 0
     1454           and buf_dis-host.host-code  = 0
     1455           and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     1456             run create-smart-route-link in this-procedure ( input 'dis-host':U
     1457                                                         ,input buffer buf_dis-host:handle
     1458                                                         ,input buf_dis-host.d-card
     1459                                                         ,input v-rec-ord1
     1460                                                         ,input no
     1461                                                         ).
     1462             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1463                                                       ,input -1).
     1464           end.
     1465           else do:
     1466             run get-db-list-for-d-card2  in this-procedure ( input buf_dis-host.d-card).
     1467             run create-smart-route-link in this-procedure ( input 'dis-host':U
     1468                                                         ,input buffer buf_dis-host:handle
     1469                                                         ,input buf_dis-host.d-card
     1470                                                         ,input v-rec-ord1
     1471                                                         ,input yes
     1472                                                         ).
     1473           end.
     1474         end.
     1475         when integer('1':U) then do:
     1476           if buf_dis-host.dt-code = 0
     1477           and buf_dis-host.host-code  = 0
     1478           and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     1479             run create-smart-route-link in this-procedure ( input 'dis-host':U
     1480                                                         ,input buffer buf_dis-host:handle
     1481                                                         ,input buf_dis-host.d-card
     1482                                                         ,input v-rec-ord1
     1483                                                         ,input no
     1484                                                         ).
     1485             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1486                                                       ,input -1).
     1487           end.
     1488         end.
     1489         otherwise do:
     1490           run create-smart-route-link in this-procedure ( input 'dis-host':U
     1491                                                       ,input buffer buf_dis-host:handle
     1492                                                       ,input buf_dis-host.d-card
     1493                                                       ,input v-rec-ord1
     1494                                                       ,input no
     1495                                                       ).
     1496           run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1497                                                     ,input -1).
     1498         end.
     1499       end.
     1500     end.
     1501   end.
     1502   end procedure.
     1503   procedure get-db-list-for-d-card2 :
     1504   define input parameter p-d-card as character no-undo .
     1505   define variable v-current-db-processed as logical no-undo .
     1506   define buffer buf_clients  for ub.clients.
     1507   define buffer buf_dis-obj for ub.dis-obj.
     1508   define buffer buf_temp-smart-route for temp-smart-route.
     1509     do
     1510     on error undo, return error return-value
     1511     :
     1512       for each buf_dis-obj no-lock where
     1513               buf_dis-obj.d-card = p-d-card,
     1514          first buf_clients no-lock where
     1515               buf_clients.obj-type = buf_dis-obj.obj-type
     1516           and buf_clients.obj-code = buf_dis-obj.obj-code
     1517       break by
     1518       buf_clients.db-num:
     1519         if first-of(buf_Clients.db-num) then do:
     1520           find first buf_temp-smart-route no-lock where
     1521                 buf_temp-smart-route.key-field = p-d-card
     1522             and buf_temp-smart-route.db-num = buf_clients.db-num
     1523                 no-error.
     1524           if available buf_temp-smart-route then return.
     1525           create buf_temp-smart-route.
     1526           assign
     1527           buf_temp-smart-route.key-field = p-d-card
     1528           buf_temp-smart-route.db-num = buf_clients.db-num
     1529           .
     1530           if buf_clients.db-num = g#db-num then do:
     1531             v-current-db-processed = yes.
     1532           end.
     1533         end.
     1534       end.
     1535       if not v-current-db-processed then do:
     1536         find first buf_temp-smart-route no-lock where
     1537               buf_temp-smart-route.key-field = p-d-card
     1538           and buf_temp-smart-route.db-num = g#db-num  no-error.
     1539         if not available buf_temp-smart-route then do:
     1540           create buf_temp-smart-route.
     1541           assign
     1542           buf_temp-smart-route.key-field = p-d-card
     1543           buf_temp-smart-route.db-num = g#db-num
     1544           .
     1545         end.
     1546       end.
     1547     end.
     1548   end procedure.
     1549   on delete of this-procedure do:
     1550     run garbcoll_clear in this-procedure .
     1551   end.
     1552   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     1553    define variable Card1 as class Dis-card_ no-undo .
     1554   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     1555    define variable Tot-sum1 as class Dis-tot_ no-undo .
     1556   Tot-sum1 = new Dis-tot_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     1557   if not this-procedure:persistent then do:
     1558     run proc-main in this-procedure ( input p-type
     1559                                 ,input p-emitent-host-code ) no-error .
     1560     if error-status:error then do:
     1561         run garbcoll_clear in this-procedure .
     1562         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1563     end.
     1564   end.
     1565   procedure proc-main :
     1566   define input parameter p-type like ub.dis-card.type no-undo .
     1567   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1568   _main:
     1569   do
     1570   on error undo, return error return-value
     1571   :
     1572       for each temp-d-card where
     1573             temp-d-card.type = p-type
     1574         and temp-d-card.emitent-host-code = p-emitent-host-code
     1575     On error undo _main, return error return-value
     1576     :
     1577       assign
     1578       v-current-d-card = temp-d-card.d-card
     1579       .
     1580   _1578:
     1581   do:
     1582   IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     1583     _1579:
     1584     do:
     1585     IF  Tot-sum1:find_dis-tot_( INPUT v-current-d-card) = false  THEN do:
     1586       _1580:
     1587       do:
     1588       IF  Tot-sum1:create_dis-tot_( INPUT v-current-d-card) = false  THEN do:
     1589         _1581:
     1590         do:
     1591          undo _main, return error v-last-error-message .
     1592         end.
     1593       end.
     1594       IF  Tot-sum1:dis-tot_save( ) = false  THEN do:
     1595         _1582:
     1596         do:
     1597          undo _main, return error v-last-error-message .
     1598         end.
     1599       end.
     1600       end.
     1601     end.
     1602     end.
     1603   end.
     1604   end.
     1605   Card1:Dis-card_release_ ( ) .
     1606   Tot-sum1:Dis-tot_release_ ( ) .
     1607       end.
     1608     end.
     1609   end procedure.
     1610   procedure load-ruleset-context :
     1611   define input parameter p-ruleset-id as integer no-undo .
     1612   define buffer buf_rule-call-param for ub.rule-call-param.
     1613     do
     1614     on error undo, return error
     1615     :
     1616       assign
     1617       vh_dis-card-sale_obj = buffer temp-d-card:handle
     1618       .
     1619       case p-ruleset-id:
     1620         when 1 then do:
     1621           assign
     1622           v-sign = 1
     1623           v-current-host-code = p-host-code
     1624           v-current-obj-type = p-obj-type
     1625           v-current-obj-code = p-obj-code
     1626           v-current-db-num = g#db-num
     1627           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1628           v-current-date = p-doc-date
     1629           .
     1630         end.
     1631       end case.
     1632     end.
     1633   end procedure.
