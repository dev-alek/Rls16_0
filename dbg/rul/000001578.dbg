     1207   procedure dis-hsth_write-dis-host-rul :
     1208   define parameter buffer buf_dis-host for ub.dis-host .
     1209   define input parameter p-type as character no-undo .
     1210   define input parameter p-emitent-host-code as integer no-undo .
     1211   define input parameter p-dtm-code as integer no-undo .
     1212   define input parameter p-action as integer no-undo .
     1213   define variable v-date as date      no-undo.
     1214   define variable v-time  as integer   no-undo.
     1215   define variable v-rec-ord1 as integer no-undo .
     1216   define variable v-rec-ord2 as integer no-undo .
     1217   define variable v-rec-ord3 as integer no-undo .
     1218   define variable v-rec-hno as integer no-undo .
