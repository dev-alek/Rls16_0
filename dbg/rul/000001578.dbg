     1026   .
     1027   define SHARED temp-table temp-nws-outline no-undo
     1028   like ub.nws-outline.
     1029   procedure create-smart-route :
     1030   define input parameter p-key-field as character no-undo .
     1031   define input parameter p-db-num as integer no-undo .
     1032   define buffer buf_temp-smart-route for temp-smart-route.
     1033     do
     1034     on error undo, return error
     1035     :
     1036       find first buf_temp-smart-route where
     1037                 buf_temp-smart-route.key-field = p-key-field
     1038             and buf_temp-smart-route.db-num = p-db-num no-error.
     1039       if not available buf_temp-smart-route then do:
     1040         create buf_temp-smart-route.
     1041         assign
     1042         buf_temp-smart-route.key-field = p-key-field
     1043         buf_temp-smart-route.db-num = p-db-num
     1044         .
     1045       end.
     1046     end.
     1047   end procedure.
     1048   procedure create-smart-route-link :
     1049   define input parameter p-tbl-name as character no-undo .
     1050   define input parameter p-bh_tbl-name as handle no-undo .
     1051   define input parameter p-key-field as character no-undo .
     1052   define input parameter p-rec-ord as integer no-undo .
     1053   define input parameter p-is-smart as logical no-undo .
     1054   define variable v-key-rec as character no-undo .
     1055   define buffer buf_temp-smart-link for temp-smart-link.
     1056     do
     1057     on error undo, return error
     1058     :
     1059       run gen-key-rec in this-procedure ( input p-tbl-name
     1060                                          ,input p-bh_tbl-name
     1061                                          ,output v-key-rec     ).
     1062      find first buf_temp-smart-link where
     1063                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1064              and buf_temp-smart-link.key-field = p-key-field
     1065              and buf_temp-smart-link.rec-ord = p-rec-ord
     1066              no-error .
     1067      if not available buf_temp-smart-link then do:
     1068        create buf_temp-smart-link.
     1069        assign
     1070        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1071        buf_temp-smart-link.key-field = p-key-field
     1072        buf_temp-smart-link.rec-ord = p-rec-ord
     1073        buf_temp-smart-link.is-smart = p-is-smart
     1074        .
     1075      end.
     1076     end.
     1077   end procedure.
     1078   procedure create-nws-outline :
     1079   define input parameter p-cmd-proc-handle as handle no-undo .
     1080   define input parameter p-cmd-code as integer no-undo .
     1081   define input parameter p-outline-type as character no-undo .
     1082   define input parameter p-charkey_one as character no-undo .
     1083   define input parameter p-charkey_two as character no-undo .
     1084   define input parameter p-charkey_three as character no-undo .
     1085   define input parameter p-key#_one as integer no-undo .
     1086   define input parameter p-key#_two as integer no-undo .
     1087   define input parameter p-key#_three as integer no-undo .
     1088   define variable v-no-id as integer no-undo .
     1089   define variable v-rec-ord as integer no-undo .
     1090     do
     1091     on error undo, return error return-value
     1092     :
     1093       find last temp-nws-outline use-index pi no-error .
     1094       v-no-id = (if available temp-nws-outline
     1095                  then (temp-nws-outline.no-id  + 1)
     1096                  else 1).
     1097       create temp-nws-outline.
     1098       assign
     1099       temp-nws-outline.charkeY_one = p-charkey_one
     1100       temp-nws-outline.charkeY_two = p-charkey_two
     1101       temp-nws-outline.charkeY_three = p-charkey_three
     1102       temp-nws-outline.key#_one = p-key#_one
     1103       temp-nws-outline.key#_two = p-key#_two
     1104       temp-nws-outline.key#_three = p-key#_three
     1105       temp-nws-outline.no-id = v-no-id
     1106       temp-nws-outline.outline-type = p-outline-type
     1107       .
     1108                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1109       run  create-smart-route in this-procedure (
     1110                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1111                                                  ,input -1).
     1112       run create-smart-route-link in this-procedure (
     1113                                                      input 'nws-outline':U
     1114                                                     ,input (buffer temp-nws-outline:handle)
     1115                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1116                                                     ,input v-rec-ord
     1117                                                     ,input no
     1118                                                     ).
     1119     end.
     1120   end procedure.
     1121   procedure create-no-route :
     1122   define input parameter p-rec-ord as integer no-undo .
     1123   define input parameter p-db-num as integer no-undo .
     1124   define buffer buf_temp-no-route for temp-no-route.
     1125   do
     1126   on error undo, return error
     1127   :
     1128      find first buf_temp-no-route where
     1129                 buf_temp-no-route.rec-ord = p-rec-ord
     1130              and buf_temp-no-route.db-num = p-db-num no-error .
     1131      if not available buf_temp-no-route then do:
     1132        create buf_temp-no-route.
     1133        assign
     1134        buf_temp-no-route.rec-ord = p-rec-ord
     1135        buf_temp-no-route.db-num = p-db-num
     1136        .
     1137      end.
     1138   end.
     1139   end procedure.
     1140   procedure clear-from-rec-ord :
     1141   define input parameter p-rec-ord as integer no-undo .
     1142   define buffer buf_temp-no-route for temp-no-route.
     1143   define buffer buf_temp-smart-link for temp-smart-link.
     1144   do
     1145   on error undo, return error
     1146   :
     1147   for each buf_temp-no-route where
     1148           buf_temp-no-route.rec-ord > p-rec-ord:
     1149     delete buf_temp-no-route.
     1150   end.
     1151   for each buf_temp-smart-link where
     1152           buf_temp-smart-link.rec-ord > p-rec-ord:
     1153      delete buf_temp-smart-link.
     1154   end.
     1155   end.
     1156   end procedure.
