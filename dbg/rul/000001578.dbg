     1221   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1222   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1223   do
     1224   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1225   :
     1226     if not available buf_dis-host then do:
     1227       message
     1228         vss-workfile vss-revision vss-description skip
     1229         "Ошибка задания входных параметров" skip
     1230         "Не определена ДК" skip
     1231         view-as alert-box error .
     1232       undo, return error .
     1233     end.
     1234     find first buf_temp-hist-nws-option where
     1235               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1236           and buf_temp-hist-nws-option.db-num = g#db-num
     1237           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1238           and buf_temp-hist-nws-option.charkey_one = p-type
     1239           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1240     if not available buf_temp-hist-nws-option then do:
     1241       find first last_temp-hist-nws-option where
     1242                last_temp-hist-nws-option.db-num = g#db-num
     1243            and last_temp-hist-nws-option.hn-id < 0 no-error.
     1244       create buf_temp-hist-nws-option.
     1245       assign
     1246       buf_temp-hist-nws-option.db-num = g#db-num
     1247       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1248                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1249                                   else -1 )
     1250       buf_temp-hist-nws-option.table-name = 'dis-host':U
     1251       buf_temp-hist-nws-option.key#_one = p-dtm-code
     1252       buf_temp-hist-nws-option.charkey_one = p-type
     1253       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1254       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1255       .
     1256   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1258     (input  g#db-num
     1259     ,input  buffer buf_temp-hist-nws-option:handle
     1260     )  .
     1261     end.
     1262     if not g#news
     1263     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1264       return.
     1265     end.
     1266     if g#news
     1267     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1268       return.
     1269     end.
     1270     run cur-time in this-procedure(output v-date, output v-time).
     1271     create buf_c-dis-host.
     1272     buffer-copy buf_dis-host to buf_c-dis-host
     1273     assign
     1274     buf_c-dis-host.d-card             = buf_dis-host.d-card
     1275     buf_c-dis-host.host-code          = buf_dis-host.host-code
     1276     buf_c-dis-host.card-num           = buf_dis-host.card-num
     1277     buf_c-dis-host.dt-code            = buf_dis-host.dt-code
     1278     buf_c-dis-host.main-card          = buf_dis-host.main-card
     1279     buf_c-dis-host.first-main-card    = buf_dis-host.first-main-card
     1280     buf_c-dis-host.first-card         = buf_dis-host.first-card
     1281     buf_c-dis-host.chip-num           = next-value (s-dc-chip, ub)
     1282     buf_c-dis-host.corr-time          = v-time
     1283     buf_c-dis-host.corr-user-db-num   = g#db-num
     1284     buf_c-dis-host.corr-user-name     = (if g#news
     1285                                         then (chr(4) +  'СПН':U)
     1286                                         else (if g#esys
     1287                                               then (chr(4) +  'ВС':U)
     1288                                               else g#userid)
     1289                                         )
     1290     buf_c-dis-host.corr-date          = v-date
     1291     .
     1292     create buf_c-dc-hist.
     1293     buffer-copy buf_c-dis-host to buf_c-dc-hist
     1294     assign
     1295     buf_c-dc-hist.action = p-action
     1296     buf_c-dc-hist.subject = 'dis-host':U
     1297     buf_c-dc-hist.host-code =  buf_dis-host.host-code
     1298     buf_c-dc-hist.is-news = g#news
     1299     buf_c-dc-hist.source-type = p-doc-type
     1300     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1301                                  then '':U
     1302                                  else p-doc-code)
     1303     .
     1304     if g#db-num > 0
     1305     or (g#db-num = 0
     1306     and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1307     then do:
     1308       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-host':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-host:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-host':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1309       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1310       if g#db-num = 0 then do:
     1311         case  buf_temp-hist-nws-option.smart-nws :
     1312           when integer('0':U)
     1313           or
     1314           when integer('10':U)
     1315           then do:
     1316            if buf_dis-host.dt-code = 0
     1317             and buf_dis-host.host-code  = 0
     1318             and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     1319               run create-smart-route-link in this-procedure ( input 'c-dis-host':U
     1320                                                           ,input buffer buf_c-dis-host:handle
     1321                                                           ,input buf_dis-host.d-card
     1322                                                           ,input v-rec-ord2
     1323                                                           ,input no
     1324                                                           ).
     1325               run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1326                                                           ,input buffer buf_c-dc-hist:handle
     1327                                                           ,input buf_dis-host.d-card
     1328                                                           ,input v-rec-ord3
     1329                                                           ,input no
     1330                                                           ).
     1331               run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1332                                                         ,input -1).
     1333             end.
     1334             else do:
     1335               run get-db-list-for-d-card2  in this-procedure ( input buf_dis-host.d-card).
     1336               run create-smart-route-link in this-procedure ( input 'c-dis-host':U
     1337                                                           ,input buffer buf_c-dis-host:handle
     1338                                                           ,input buf_dis-host.d-card
     1339                                                           ,input v-rec-ord2
     1340                                                           ,input yes
     1341                                                           ).
     1342               run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1343                                                           ,input buffer buf_c-dc-hist:handle
     1344                                                           ,input buf_dis-host.d-card
     1345                                                           ,input v-rec-ord3
     1346                                                           ,input yes
     1347                                                           ).
     1348             end.
     1349           end.
     1350           when integer('1':U) then do:
     1351            if buf_dis-host.dt-code = 0
     1352             and buf_dis-host.host-code  = 0
     1353             and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     1354               run create-smart-route-link in this-procedure ( input 'c-dis-host':U
     1355                                                           ,input buffer buf_c-dis-host:handle
     1356                                                           ,input buf_dis-host.d-card
     1357                                                           ,input v-rec-ord2
     1358                                                           ,input no
     1359                                                           ).
     1360               run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1361                                                           ,input buffer buf_c-dc-hist:handle
     1362                                                           ,input buf_dis-host.d-card
     1363                                                           ,input v-rec-ord3
     1364                                                           ,input no
     1365                                                           ).
     1366               run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1367                                                         ,input -1).
     1368             end.
     1369           end.
     1370           otherwise do:
     1371             run create-smart-route-link in this-procedure ( input 'c-dis-host':U
     1372                                                         ,input buffer buf_c-dis-host:handle
     1373                                                         ,input buf_dis-host.d-card
     1374                                                         ,input v-rec-ord2
     1375                                                         ,input no
     1376                                                         ).
     1377             run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1378                                                         ,input buffer buf_c-dc-hist:handle
     1379                                                         ,input buf_dis-host.d-card
     1380                                                         ,input v-rec-ord3
     1381                                                         ,input no
     1382                                                         ).
     1383             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     1384                                                       ,input -1).
     1385           end.
     1386         end case.
     1387       end.
     1388     end.
     1389   end.
     1390   end procedure.
     1391   procedure dis-hsth_send-dis-host-rul :
     1392   define parameter buffer buf_dis-host for ub.dis-host .
     1393   define input parameter p-type as character no-undo .
     1394   define input parameter p-emitent-host-code as integer no-undo .
     1395   define input parameter p-dtm-code as integer no-undo .
     1396   define input parameter p-action as integer no-undo .
     1397   define variable v-date as date      no-undo.
     1398   define variable v-time  as integer   no-undo.
     1399   define variable v-rec-ord1 as integer no-undo .
     1400   define variable v-rec-ord2 as integer no-undo .
     1401   define variable v-rec-ord3 as integer no-undo .
     1402   define variable v-rec-hno as integer no-undo .
     1403   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1404   define buffer buf_c-dis-host for ub.c-dis-host.
     1405   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1406   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1407   do
     1408   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1409   :
