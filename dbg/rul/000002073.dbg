     1901   .
     1902   procedure get-header-by-rec :
     1903   define input  parameter p-gate-rec as character no-undo .
     1904   define output parameter p-tth as handle no-undo .
     1905   define variable v-ii as integer   no-undo .
     1906   define variable glog as logical   no-undo .
     1907   define variable v-rowid as rowid no-undo .
     1908   define variable v-tbl-name as character no-undo .
     1909   define variable v-longchar as longchar no-undo .
     1910   define variable v-txmlh as handle no-undo .
     1911   define buffer buf_clob-data for ub.clob-data.
     1912   main-block:
     1913   do
     1914   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1915   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1916   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1917   :
     1918     run gen-row-keyr in  this-procedure  (
     1919                                           input  p-gate-rec
     1920                                           ,input  ?
     1921                                           ,input  "ub"
     1922                                           ,input  ?
     1923                                           ,input  NO-LOCK
     1924                                           ,output v-rowid
     1925                                           ,output v-tbl-name   ) no-error.
     1926       find first buf_clob-data no-lock where
     1927                 rowid(buf_clob-data) = v-rowid  no-error.
     1928       if not available buf_clob-data then do:
     1929         undo, return error substitute("Не найден CLOB  &1"
     1930                                         , p-gate-rec
     1931                                         ).
     1932       end.
     1933       assign
     1934       v-longchar = buf_clob-data.cdata
     1935       .
     1936       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1937       if error-status :error then do:
     1938         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1939       end.
     1940       create temp-table p-tth .
     1941       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1942                                     , v-longchar
     1943                                     , ?
     1944                                     , ?
     1945                                     , ?
     1946                                     ) no-error.
     1947       v-longchar = '':U.
     1948       define variable v-esm as character no-undo .
     1949       v-esm = error-status:get-message(1).
     1950       if error-status :error
     1951       or not glog
     1952       then do:
     1953         delete object p-tth no-error.
     1954         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1955                                    , p-gate-rec
     1956                                    , buf_clob-data.file-name_
     1957                                    , chr(10)
     1958                                    , v-esm
     1959                                     ).
     1960       end.
     1961   end.
     1962   end procedure.
     1963   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   define temp-table ORDER-t no-undo
