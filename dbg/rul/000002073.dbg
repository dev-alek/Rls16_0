     3529   function context_begin-esys-command return logical
     3530   (
     3531       input p-esys-id-list as character
     3532      ,input-output p-esys-cmd-proc-handle as handle
     3533      ,output p-esys-cmd-code as integer
     3534   ):
     3535      if not valid-handle(p-esys-cmd-proc-handle )
     3536      then do:
     3537        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3538        if error-status :error
     3539        then do:
     3540           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3541                                              "&5&4&6"
     3542                                              ,vss-workfile
     3543                                              ,vss-revision
     3544                                              ,vss-description
     3545                                              ,chr(10)
     3546                                              ,error-status:get-message(1)
     3547                                              ,return-value )).
     3548        end.
     3549        run begin-create-command in p-esys-cmd-proc-handle
     3550          (input 'cmd-esys-general':U
     3551          ,input p-esys-id-list
     3552          ,output p-esys-cmd-code
     3553          ) no-error.
     3554        if error-status :error
     3555        then do:
     3556          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3557                                                           , 'cmd-esys-general':U
     3558                                                           , error-status:get-message(1)
     3559                                                           , return-value
     3560                                                           )).
     3561          return no .
     3562        end.
     3563        return yes.
     3564      end.
     3565   end.
     3566   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3567   function context_send-esys-command return int64
     3568   (
     3569       input p-esys-id-list as character
     3570      ,input p-esys-cmd-proc-handle as handle
     3571      ,input p-esys-cmd-code as integer
     3572      ,input p-user-id as character
     3573   ):
