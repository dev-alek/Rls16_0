     3595         return v-dmp-ord-int64.
     3596      end.
     3597      else do:
     3598         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3599                                                       , p-esys-id-list
     3600                                                       , p-cmd-code
     3601                                                       , chr(10)
     3602                                                       , error-status:get-message(1)
     3603                                                       , return-value
     3604                                                       )).
