     2011   data-relation r2 for HEAD-t, POSITION-t relation-fields ( NUMBER, NUMBER) nested
     2012   data-relation r3 for POSITION-t, CHARACTERISTIC-t  relation-fields ( NUMBER, NUMBER, POSITIONNUMBER, POSITIONNUMBER ) nested
     2013   .
     2014   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2016   procedure proc-ord-code :
     2017   define input  parameter  p-type as character no-undo .
     2018   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     2019   define input  parameter  v-cntxt-obj-type as character no-undo .
     2020   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     2021   define input  parameter  p-i-doc    as character no-undo .
     2022   define output parameter  p-ord-doc  as character no-undo .
     2023   define variable          v-idop     as character no-undo .
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027   case p-type :
     2028       when "main-no-ver" then do:
     2029         if  (v-cntxt-db-num <> 0) then
     2030           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     2031         else
     2032           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     2033       end.
     2034       when "main" then do:
     2035             do while true:
     2036             if  (v-cntxt-db-num <> 0) then
     2037               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     2038             else
     2039               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     2040             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     2041             End.
     2042       end.
     2043       when "chip" then do:
     2044         assign
     2045           v-idop = p-i-doc .
     2046         do while true :
     2047           if index (v-idop , ".") = 0 then
     2048             v-idop  = replace (v-idop , "-", "-1.").
     2049           else
     2050             v-idop  =
     2051             substring (v-idop , 1, index (v-idop, "-")) +
     2052             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     2053             substring (v-idop, index (v-idop, ".")).
     2054           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     2055         end.
     2056         assign
     2057           p-ord-doc = v-idop.
     2058       end.
     2059   end case.
     2060     end.
     2061   end procedure.
     2062   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2063   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2065   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2066   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2067   procedure ordlineattr-value :
     2068     do
     2069     on error undo, return error return-value
     2070     :
     2071       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2072       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2073       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2074       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2075       define output parameter p-type     as character no-undo .
     2076       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2077       define variable v-format         as character no-undo .
     2078       define variable v-fillin_width   as integer   no-undo .
     2079       define variable v-fillin_height  as integer   no-undo .
     2080       define variable v-label          as character no-undo .
     2081       define variable v-user-can-edit  as logical   no-undo .
     2082       define variable v-output-display as logical   no-undo .
     2083       define variable v-other          as character no-undo .
     2084       define variable v-proc           as character no-undo .
     2085       define variable v-func           as character no-undo .
     2086       define variable v-sort           as integer   no-undo .
     2087       run ordlineattr-code in this-procedure
     2088         (input  p-code
     2089         ,output p-type
     2090         ,output v-format
     2091         ,output v-fillin_width
     2092         ,output v-fillin_height
     2093         ,output v-label
     2094         ,output v-user-can-edit
     2095         ,output v-output-display
     2096         ,output v-proc
     2097         ,output v-func
     2098         ,output v-sort
     2099         ,output v-other
     2100         ) no-error .
     2101       if error-status :error then do:
     2102         undo, return error return-value .
     2103       end.
     2104       find first buf_ord-line-attr no-lock
     2105         where buf_ord-line-attr.doc-code  = p-doc-code
     2106           and buf_ord-line-attr.gds-code  = p-gds-code
     2107           and buf_ord-line-attr.attr-code = p-code
     2108         no-error .
     2109       if avail buf_ord-line-attr then do:
     2110         assign
     2111           p-value =  buf_ord-line-attr.attr-value
     2112         .
     2113       end.
     2114       else do:
     2115         assign
     2116           p-value = if p-type = 'L':U then "no":U else ""
     2117         .
     2118       end.
     2119     end.
     2120   end procedure.
     2121   procedure ordlineattr-write :
     2122     do
     2123     on error undo, return error return-value
     2124     :
     2125       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2126       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2127       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2128       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2129       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2130       define variable v-type           as character no-undo .
     2131       define variable v-format         as character no-undo .
     2132       define variable v-fillin_width   as integer   no-undo .
     2133       define variable v-fillin_height  as integer   no-undo .
     2134       define variable v-label          as character no-undo .
     2135       define variable v-user-can-edit  as logical   no-undo .
     2136       define variable v-output-display as logical   no-undo .
     2137       define variable v-other          as character no-undo .
     2138       define variable v-proc           as character no-undo .
     2139       define variable v-func           as character no-undo .
     2140       define variable v-sort           as integer   no-undo .
     2141       run ordlineattr-code in this-procedure
     2142         (input  p-code
     2143         ,output v-type
     2144         ,output v-format
     2145         ,output v-fillin_width
     2146         ,output v-fillin_height
     2147         ,output v-label
     2148         ,output v-user-can-edit
     2149         ,output v-output-display
     2150         ,output v-proc
     2151         ,output v-func
     2152         ,output v-sort
     2153         ,output v-other
     2154         ) no-error .
     2155       if error-status :error then do:
     2156         message
     2157           vss-workfile vss-revision vss-description skip
     2158           error-status :get-message(1) skip
     2159           return-value skip
     2160           ""
     2161           view-as alert-box error
     2162         .
     2163         undo, return error return-value .
     2164       end.
     2165       find first buf_ord-line-attr exclusive-lock
     2166         where buf_ord-line-attr.doc-code  = p-doc-code
     2167           and buf_ord-line-attr.gds-code  = p-gds-code
     2168           and buf_ord-line-attr.attr-code = p-code
     2169         no-error .
     2170       if not available buf_ord-line-attr then do:
     2171         create buf_ord-line-attr .
     2172         assign
     2173           buf_ord-line-attr.doc-code   = p-doc-code
     2174           buf_ord-line-attr.gds-code   = p-gds-code
     2175           buf_ord-line-attr.attr-code  = p-code
     2176         .
     2177       end.
     2178       assign
     2179         buf_ord-line-attr.attr-value = p-value
     2180       .
     2181   end.
     2182   end procedure.
     2183   procedure ordlineattr-exist :
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2188       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2189       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2190       define output parameter p-exist   as logical  no-undo .
     2191       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2192       define variable v-type           as character no-undo .
     2193       define variable v-format         as character no-undo .
     2194       define variable v-fillin_width   as integer   no-undo .
     2195       define variable v-fillin_height  as integer   no-undo .
     2196       define variable v-label          as character no-undo .
     2197       define variable v-user-can-edit  as logical   no-undo .
     2198       define variable v-output-display as logical   no-undo .
     2199       define variable v-other          as character no-undo .
     2200       define variable v-proc           as character no-undo .
     2201       define variable v-func           as character no-undo .
     2202       define variable v-sort           as integer   no-undo .
     2203       run ordlineattr-code in this-procedure
     2204         (input  p-code
     2205         ,output v-type
     2206         ,output v-format
     2207         ,output v-fillin_width
     2208         ,output v-fillin_height
     2209         ,output v-label
     2210         ,output v-user-can-edit
     2211         ,output v-output-display
     2212         ,output v-proc
     2213         ,output v-func
     2214         ,output v-sort
     2215         ,output v-other
     2216         ) no-error .
     2217       if error-status :error then do:
     2218         undo, return error return-value .
     2219       end.
     2220       find first buf_ord-line-attr no-lock
     2221         where buf_ord-line-attr.doc-code  = p-doc-code
     2222           and buf_ord-line-attr.gds-code = p-gds-code
     2223           and buf_ord-line-attr.attr-code = p-code
     2224         no-error .
     2225       if  available buf_ord-line-attr then do:
     2226         p-exist = yes.
     2227       end.
     2228     end.
     2229   end procedure.
     2230   procedure ordlineattr-delete :
     2231     do
     2232     on error undo, return error return-value
     2233     :
     2234       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2235       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2236       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2237       define output parameter p-deleted  as logical no-undo.
     2238       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2239       define variable v-type           as character no-undo .
     2240       define variable v-format         as character no-undo .
     2241       define variable v-fillin_width   as integer   no-undo .
     2242       define variable v-fillin_height  as integer   no-undo .
     2243       define variable v-label          as character no-undo .
     2244       define variable v-user-can-edit  as logical   no-undo .
     2245       define variable v-output-display as logical   no-undo .
     2246       define variable v-proc           as character no-undo .
     2247       define variable v-func           as character no-undo .
     2248       define variable v-sort           as integer   no-undo .
     2249       define variable v-other          as character no-undo .
     2250       run ordlineattr-code in this-procedure
     2251         (input  p-code
     2252         ,output v-type
     2253         ,output v-format
     2254         ,output v-fillin_width
     2255         ,output v-fillin_height
     2256         ,output v-label
     2257         ,output v-user-can-edit
     2258         ,output v-output-display
     2259         ,output v-proc
     2260         ,output v-func
     2261         ,output v-sort
     2262         ,output v-other
     2263         ) no-error .
     2264       if error-status :error then do:
     2265         undo, return error return-value .
     2266       end.
     2267       find first buf_ord-line-attr exclusive-lock
     2268         where buf_ord-line-attr.doc-code  = p-doc-code
     2269           and buf_ord-line-attr.gds-code  = p-gds-code
     2270           and buf_ord-line-attr.attr-code = p-code
     2271         no-error NO-WAIT.
     2272       if not available buf_ord-line-attr then do:
     2273         p-deleted = no.
     2274       end.
     2275       else do:
     2276         delete buf_ord-line-attr.
     2277         p-deleted = yes.
     2278       end.
     2279     end.
     2280   end procedure.
     2281   procedure ordlineattr-code :
     2282     do on error undo, return error return-value
     2283     :
     2284       define input  parameter p-code           as character no-undo .
     2285       define output parameter p-type           as character no-undo .
     2286       define output parameter p-format         as character no-undo .
     2287       define output parameter p-fillin_width   as integer   no-undo .
     2288       define output parameter p-fillin_height  as integer   no-undo .
     2289       define output parameter p-label          as character no-undo .
     2290       define output parameter p-user-can-edit  as logical   no-undo .
     2291       define output parameter p-output-display as logical   no-undo .
     2292       define output parameter p-proc           as character no-undo .
     2293       define output parameter p-func           as character no-undo .
     2294       define output parameter p-sort           as integer   no-undo .
     2295       define output parameter p-other          as character no-undo .
     2296       case p-code :
     2297               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2298               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2299         otherwise do:
     2300           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     2301         end.
     2302       end.
     2303     end.
     2304   end procedure.
     2305   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     2306   define variable v-ii as integer   no-undo .
     2307   define variable v-dop as character no-undo .
     2308   define variable v-dop1 as character no-undo .
     2309   define variable v-mess as character no-undo .
     2310   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2311     v-dop = entry(v-ii, p-mess, chr(4) ).
     2312     case entry(1, v-dop, "="):
     2313       when 'pack-num':U then do:
     2314         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2315       end.
     2316       when 'route':U then do:
     2317         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2318       end.
     2319       when 'ediiterchangeid':U then do:
     2320         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2321       end.
     2322       when 'price-up':U then do:
     2323         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2324       end.
     2325       when 'price-down':U then do:
     2326         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2327       end.
     2328       when 'vat-change':U then do:
     2329         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2330       end.
     2331       when 'ps':U then do:
     2332         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2333       end.
     2334       when 'info':U then do:
     2335         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2336       end.
     2337       when 'qnty-up':U then do:
     2338         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2339       end.
     2340       when 'qnty-down':U then do:
     2341         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2342       end.
     2343       when 'bstr-change':U then do:
     2344         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2345       end.
     2346       when 'shipdate-change':U then do:
     2347         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2348       end.
     2349       when 'clioutdoc-change':U then do:
     2350         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2351       end.
     2352     end case.
     2353     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     2354   end.
     2355   return v-mess.
     2356   end function.
     2357   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     2358   define variable v-ii as integer   no-undo .
     2359   define variable v-dop as character no-undo .
     2360   define variable v-dop1 as character no-undo .
     2361   define variable v-mess as character no-undo .
     2362   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2363     v-dop = entry(v-ii, p-mess, chr(4) ).
     2364     case entry(1, v-dop, "="):
     2365       when 'pack-num':U then do:
     2366         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2367       end.
     2368       when 'route':U then do:
     2369         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2370       end.
     2371       when 'ediiterchangeid':U then do:
     2372         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2373       end.
     2374       when 'price-up':U then do:
     2375         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2376       end.
     2377       when 'price-down':U then do:
     2378         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2379       end.
     2380       when 'vat-change':U then do:
     2381         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2382       end.
     2383       when 'ps':U then do:
     2384         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2385       end.
     2386       when 'info':U then do:
     2387         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2388       end.
     2389       when 'qnty-up':U then do:
     2390         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2391       end.
     2392       when 'qnty-down':U then do:
     2393         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2394       end.
     2395       when 'bstr-change':U then do:
     2396         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2397       end.
     2398       when 'shipdate-change':U then do:
     2399         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2400       end.
     2401       when 'clioutdoc-change':U then do:
     2402         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2403       end.
     2404     end case.
     2405     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2406   end.
     2407   return v-mess.
     2408   end function.
     2409   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2410   define variable v-ii as integer   no-undo .
     2411   define variable v-dop as character no-undo .
     2412   define variable v-dop1 as character no-undo .
     2413   define variable v-value as character no-undo .
     2414   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2415     v-dop = entry(v-ii, p-mess, chr(4) ).
     2416     if entry(1, v-dop, "=") = p-key then do:
     2417       return entry(2, v-dop, "=").
     2418     end.
     2419   end.
     2420   return v-value.
     2421   end function.
     2422   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2423                                                        ,input p-key as character
     2424                                                        ,input p-value as character):
     2425   define variable v-dop as character no-undo .
     2426   define variable v-modificator as character no-undo .
     2427   assign
     2428   v-modificator = entry(2, p-key, "-") no-error .
     2429   case v-modificator:
     2430     when "up" then do:
     2431       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2432     end.
     2433     when "down" then do:
     2434       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2435     end.
     2436     when "change" then do:
     2437       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2438     end.
     2439     otherwise do:
     2440       v-dop = substitute("&1=&2", p-key, p-value).
     2441     end.
     2442   end case.
     2443   if p-mess = ''
     2444   or p-mess = ? then do:
     2445     return v-dop .
     2446   end.
     2447   else do:
     2448     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2449   end.
     2450   end function.
     2451   procedure create-edi-state :
     2452   define input  parameter p-tbl-name   as character no-undo .
     2453   define input  parameter p-doc-code   as character no-undo .
     2454   define input  parameter p-cli-type   as character no-undo .
     2455   define input  parameter p-cli-code   as integer   no-undo .
     2456   define input  parameter p-act        as character no-undo .
     2457   define input  parameter p-state      as character no-undo .
     2458   define input  parameter p-err        as integer   no-undo .
     2459   define input  parameter p-des        as character no-undo .
     2460   define input  parameter p-mess       as character no-undo .
     2461   define input  parameter p-dm         as integer  no-undo .
     2462   define input-output parameter p-date       as date no-undo .
     2463   define input-output parameter p-time       as integer no-undo .
     2464   define buffer buf_EDI-status for ub.EDI-status  .
     2465   define variable v-time as integer   no-undo .
     2466   define variable v-date as date   no-undo .
     2467   do
     2468   on error undo, return error return-value
     2469   :
     2470     if p-date = ? then do:
     2471       run cur-time in this-procedure ( output v-date, output v-time).
     2472     end.
     2473     else do:
     2474       assign
     2475       v-date = p-date
     2476       v-time = p-time
     2477       .
     2478     end.
     2479     find first buf_edi-status exclusive-lock where
     2480                 buf_edi-status.date-status = v-date
     2481             and buf_edi-status.time-status = v-time
     2482             and buf_edi-status.tbl-name    = p-tbl-name
     2483             and buf_edi-status.doc-code    = p-doc-code no-error .
     2484     if not available buf_edi-status  then do:
     2485       create buf_edi-status.
     2486     end.
     2487     assign
     2488     buf_edi-status.act         = p-act        .
     2489     buf_edi-status.cli-type    = p-cli-type   .
     2490     buf_edi-status.cli-code    = p-cli-code   .
     2491     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2492     buf_edi-status.doc-code    = p-doc-code   .
     2493     buf_edi-status.err-code    = p-err        .
     2494     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2495     buf_edi-status.state       = p-state      .
     2496     buf_edi-status.tbl-name    = p-tbl-name   .
     2497     buf_edi-status.date-status = v-date       .
     2498     buf_edi-status.time-status = v-time       .
     2499     buf_edi-status.whole-send-news = p-dm     .
     2500     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2501                                       else (if g#esys
     2502                                             then (chr(4) +  'ВС':U)
     2503                                             else g#userid)
     2504                                       )       .
     2505     assign
     2506     p-date = buf_edi-status.date-status
     2507     p-time = buf_edi-status.time-status
     2508     .
     2509   end.
     2510   end procedure.
     2511   procedure update-edi-state-light :
     2512   define input  parameter p-tbl-name   as character no-undo .
     2513   define input  parameter p-doc-code   as character no-undo .
     2514   define input  parameter p-date-status as date no-undo .
     2515   define input  parameter p-time-status as integer no-undo .
     2516   define input  parameter p-state      as character no-undo .
     2517   define input  parameter p-err        as integer   no-undo .
     2518   define input  parameter p-des        as character no-undo .
     2519   define input  parameter p-mess       as character no-undo .
     2520   define buffer buf_edi-status for ub.edi-status.
     2521   do
     2522   on error undo, return error
     2523   :
     2524     find first buf_edi-status exclusive-lock where
     2525                 buf_edi-status.date-status = p-date-status
     2526             and buf_edi-status.time-status = p-time-status
     2527             and buf_edi-status.tbl-name    = p-tbl-name
     2528             and buf_edi-status.doc-code    = p-doc-code no-error .
     2529     if available buf_edi-status  then do:
     2530       assign
     2531       buf_edi-status.des-err     = p-des        .
     2532       buf_edi-status.err-code    = p-err        .
     2533       buf_edi-status.mess-id     = p-mess       .
     2534       buf_edi-status.state       = p-state      .
     2535     end.
     2536   end.
     2537   end procedure.
     2538   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   PROCEDURE write-bonus :
     2540   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2541   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2542   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2543   define input  parameter v-bonus as decimal   no-undo .
     2544     do
     2545     on error undo, return error return-value
     2546     :
     2547       find first ub.contract-specif-attr exclusive-lock  where
     2548                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2549                  ub.contract-specif-attr.host-code    = p-host-code     and
     2550                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2551                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2552                 no-error .
     2553         if not available ub.contract-specif-attr then do:
     2554            create ub.contract-specif-attr .
     2555            assign
     2556                 ub.contract-specif-attr.contract-num = p-contract-num
     2557                 ub.contract-specif-attr.host-code    = p-host-code
     2558                 ub.contract-specif-attr.gds-code     = p-gds-code
     2559                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2560            .
     2561         end.
     2562         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2563   end.
     2564   END PROCEDURE.
     2565   PROCEDURE read-bonus :
     2566   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2567   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2568   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2569   define output parameter v-bonus as decimal   no-undo .
     2570     do
     2571     on error undo, return error return-value
     2572     :
     2573   find first ub.contract-specif-attr no-lock  where
     2574              ub.contract-specif-attr.contract-num = p-contract-num  and
     2575              ub.contract-specif-attr.host-code    = p-host-code     and
     2576              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2577              ub.contract-specif-attr.attr-code    = 'bonus':U
     2578              no-error .
     2579      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2580                                           else  v-bonus = 0 .
     2581   end.
     2582   END PROCEDURE.
     2583   PROCEDURE write-prc-min :
     2584   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
