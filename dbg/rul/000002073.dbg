     2705       find first buf_ord-doc-rcv exclusive-lock where
     2706                buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     2707            and buf_ord-doc-rcv.sub-par begins string(trim(p-ext-rcv-code) + chr(4)) no-error .
     2708     if available buf_ord-doc-rcv then do:
