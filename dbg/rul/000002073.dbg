     2626              ub.contract-specif-attr.contract-num = p-contract-num  and
     2627              ub.contract-specif-attr.host-code    = p-host-code     and
     2628              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2629              ub.contract-specif-attr.attr-code    = 'prc-min':U
