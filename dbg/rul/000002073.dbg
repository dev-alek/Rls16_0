     2635   PROCEDURE write-retro-bonus :
     2636   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2637   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2638   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2639   define input  parameter v-retro-bonus as character   no-undo .
     2640     do
     2641     on error undo, return error return-value
     2642     :
     2643       find first ub.contract-specif-attr exclusive-lock  where
     2644                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2645                 ub.contract-specif-attr.host-code    = p-host-code     and
     2646                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2647                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2648                 no-error .
     2649         if not available ub.contract-specif-attr then do:
     2650            create ub.contract-specif-attr .
     2651            assign
     2652                 ub.contract-specif-attr.contract-num = p-contract-num
     2653                 ub.contract-specif-attr.host-code    = p-host-code
     2654                 ub.contract-specif-attr.gds-code     = p-gds-code
     2655                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2656            .
     2657            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2658            if error-status:error then
     2659               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2660         end.
     2661         else do:
     2662            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2663            if error-status:error then
     2664               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2665         end.
     2666       find first ub.contract-specif exclusive-lock where
     2667           ub.contract-specif.contract-num = p-contract-num and
     2668           ub.contract-specif.host-code    = p-host-code    and
     2669           ub.contract-specif.gds-code     = p-gds-code.
     2670           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2671   end.
     2672   END PROCEDURE.
     2673   PROCEDURE read-retro-bonus :
     2674   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2675   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
