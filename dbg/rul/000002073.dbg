     3585            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3586                                                           , p-esys-id-list
     3587                                                           , p-cmd-code
     3588                                                           , chr(10)
     3589                                                           , error-status:get-message(1)
     3590                                                           , return-value
     3591                                                           )).
     3592            return 0.
     3593         end.
