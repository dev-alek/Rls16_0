     4374   procedure load-ruleset-context :
     4375   define input parameter p-ruleset-id as integer no-undo .
     4376   define buffer buf_rule-call-param for ub.rule-call-param.
     4377     do
     4378     on error undo, return error
     4379     :
     4380     find first buf_rule-call-param no-lock where
     4381   buf_rule-call-param.codex_id = p-codex-id
     4382   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4383   and buf_rule-call-param.call_id = p-call-id
     4384   and buf_rule-call-param.order_id = p-order-id
     4385   and buf_rule-call-param.rule_id = p-rule-id
     4386   and buf_rule-call-param.param-name = "p-xsd-file"
     4387    no-error.
     4388   if available buf_rule-call-param then do:
     4389   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4390   end.
     4391       case p-ruleset-id:
     4392         when 2
     4393         then do:
     4394           assign
     4395           v-sign = 2
     4396           v-current-host-code = p-host-code
     4397           v-current-obj-type = p-obj-type
     4398           v-current-obj-code = p-obj-code
     4399           v-current-db-num = g#db-num
     4400           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4401           file-name  = p-process-file-name
     4402           .
     4403         end.
     4404       end case.
     4405     end.
     4406   end procedure.
