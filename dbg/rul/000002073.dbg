     2592                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2593                 ub.contract-specif-attr.host-code    = p-host-code     and
     2594                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2595                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2596                 no-error .
     2597         if not available ub.contract-specif-attr then do:
     2598            create ub.contract-specif-attr .
     2599            assign
     2600                 ub.contract-specif-attr.contract-num = p-contract-num
     2601                 ub.contract-specif-attr.host-code    = p-host-code
     2602                 ub.contract-specif-attr.gds-code     = p-gds-code
     2603                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2604                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2605            .
     2606         end.
     2607         else do:
     2608            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2609         end.
     2610       find first ub.contract-specif exclusive-lock where
     2611           ub.contract-specif.contract-num = p-contract-num and
     2612           ub.contract-specif.host-code    = p-host-code    and
     2613           ub.contract-specif.gds-code     = p-gds-code.
     2614           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2615   end.
     2616   END PROCEDURE.
     2617   PROCEDURE read-prc-min :
     2618   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2619   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2620   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2621   define output parameter v-prc-min as decimal   no-undo .
