        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-codex-id as integer no-undo .
        6   define input parameter        p-ruleset-id as integer no-undo .
        7   define input parameter        p-dtm-code as integer no-undo .
        8   define input parameter        p-is-dynamic as logical no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Сохранение привязки prop-head к ruleset".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable v-mess as character no-undo .
       85   define variable v-entry as character no-undo .
       86   define buffer buf_ruleset for dictdb.ruleset.
       87   define buffer buf_prop-ruleset for dictdb.prop-ruleset.
       88   define buffer buf_prop-head for dictdb.prop-head.
       89   if p-mode <> 'ДОБАВЛЕНИЕ':U
       90   and p-mode <> 'ИЗМЕНЕНИЕ':U
       91   then do:
       92     message vss-workfile vss-revision vss-description skip
       93             "Неверный параметр p-mode - " p-mode
       94     view-as alert-box error .
       95     return error '':u.
       96   end.
       97   _main:
       98   do for buf_ruleset
       99   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      100   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      101   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      102   :
      103     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      104       find first buf_ruleset no-lock where
      105                 buf_ruleset.codex_id = p-codex-id
      106             and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      107       if not available buf_ruleset then do:
      108         assign
      109         v-mess = "Не найден ruleset c таким кодексом и набором правил".
      110         run err-mess in this-procedure ( input-output v-mess).
      111         return error (if p-silent = yes then v-mess else '':U).
      112       end.
      113       find first buf_prop-head no-lock where
      114                 buf_prop-head.dtm-code = p-dtm-code no-error.
      115       if not available buf_prop-head then do:
      116         assign
      117         v-mess = "Не найден prop-head c таким dtm-code".
      118         run err-mess in this-procedure ( input-output v-mess).
      119         return error (if p-silent = yes then v-mess else '':U).
      120       end.
      121       create buf_prop-ruleset.
      122       assign
      123       buf_prop-ruleset.codex_id = p-codex-id
      124       buf_prop-ruleset.ruleset_id = p-ruleset-id
      125       buf_prop-ruleset.dtm-code = p-dtm-code
      126       buf_prop-ruleset.is_dynamic = p-is-dynamic
      127       .
      128     end.
      129     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      130       find first buf_prop-ruleset exclusive-lock where
      131                 recid(buf_prop-ruleset) = p-rec .
      132       if buf_prop-ruleset.codex_id <> p-codex-id
      133       or buf_prop-ruleset.ruleset_id <> p-ruleset-id
      134       or buf_prop-ruleset.dtm-code <> p-dtm-code
      135       then do:
      136         assign
      137         v-mess = substitute("Для уже существующего prop-ruleset невозможно изменеие кодекса, набора правил и кода объекта &1" +
      138                                 "старые значения кодекса и набора правил: &2, &3 и &4"
      139                                 , chr(10)
      140                                 , buf_prop-ruleset.codex_id
      141                                 , buf_prop-ruleset.ruleset_id
      142                                 , buf_prop-ruleset.dtm-code
      143                                 )
      144         .
      145       end.
      146     end.
      147     assign
      148     buf_prop-ruleset.is_dynamic = p-is-dynamic
      149     .
      150   end.
      151   PROCEDURE err-mess:
      152     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      153     CASE p-silent:
      154       when yes then do:
      155         assign
      156         p-mess = substitute("prop-ruleset кодекс: &1 набор: &2 объект &3: &4"
      157                            , p-codex-id
      158                            , p-ruleset-id
      159                            , p-dtm-code
      160                            , p-mess)
      161         .
      162       end.
      163       when no then do:
      164         message
      165         p-mess
      166         view-as alert-box error .
      167       end.
      168     end.
      169   END PROCEDURE.
