        1   DEFINE BUFFER locked_rule-process FOR ub.rule-process.
        2   DEFINE TEMP-TABLE tt-rule-process NO-UNDO LIKE ub.rule-process.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        5   define input parameter p-pchain-type as character no-undo .
        6   define input parameter p-pchain-id as character no-undo .
        7   define input parameter p-start-from as integer no-undo .
        8   define input parameter p-link-id as integer no-undo .
        9   DEFINE INPUT-OUTPUT PARAMETER p-rec AS RECID NO-UNDO.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Карточка rule-process".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable v-waitfram-action01         as character   no-undo .
       72   define variable v-waitfram-action02         as character   no-undo .
       73   define variable v-waitfram-action03         as character   no-undo .
       74   define variable mWaitFramTextBeg            as character   no-undo.
       75   define variable mWaitFramTextEnd            as character   no-undo.
       76   define variable mWaitFramView               as logical     no-undo.
       77   define variable mWaitProcEvent              as logical     no-undo init yes.
       78   define variable mWaitFramInterval           as integer     no-undo init 1 .
       79   define variable mWaitFramStop               as logical     no-undo.
       80   define variable mWaitFramStopUser           as logical     no-undo.
       81   define variable mWaitFramStopTimeOut        as logical     no-undo.
       82   define variable mWaitFramStartProc          as datetime-tz no-undo.
       83   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       84   define button B-WaitFramStop auto-end-key
       85        label "Стоп"
       86        size 10 by 1 tooltip "Остоновить процесс".
       87   define button B-viewProcInfo
       88        label "Информация"
       89        size 15 by 1 tooltip "Информация о процесс".
       90   define frame waitfram
       91     v-waitfram-action01 format "x(72)" no-label skip
       92     v-waitfram-action02 format "x(72)" no-label skip
       93     v-waitfram-action03 format "x(72)" no-label skip
       94     B-viewProcInfo
       95     B-WaitFramStop at row 4 col 30
       96     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       97     .
       98   define new global shared variable mBatchMode as logical no-undo init ?.
       99   define variable mFramBachModHandle as handle no-undo.
      100   mFramBachModHandle = frame waitfram:handle.
      101   define variable mFameOldVis as logical no-undo.
      102   define variable mVisCUrentVin as logical no-undo.
      103   if session:batch-mode
      104   then
      105      mBatchMode = yes.
      106   if mBatchMode = ? then do:
      107     mVisCUrentVin = current-window:visible.
      108     mFameOldVis = mFramBachModHandle:visible.
      109     mFramBachModHandle:visible  = yes.
      110     mBatchMode = mFramBachModHandle:visible ne yes.
      111     mFramBachModHandle:visible = mFameOldVis.
      112     current-window:visible = mVisCUrentVin.
      113   end.
      114    if  log-manager:logfile-name ne ?
      115     then DO:
      116         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      117         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      118         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      119     end.
      120   on choose of B-WaitFramStop in frame waitfram
      121   do:
      122     mWaitFramStop = yes.
      123     mWaitFramStopUser = yes.
      124   end.
      125   function waitfram-check-timeout returns logical():
      126      define variable vtime as int64 no-undo.
      127      if mWaitFramStopTimeOut
      128      then
      129         return yes.
      130      vtime = ( now - mWaitFramStartProc ) / 1000 .
      131      if     mWaitFramTimeOut ne ?
      132         and mWaitFramTimeOut ne 0
      133         and mWaitFramTimeOut lt vtime
      134      then do:
      135         mWaitFramStopTimeOut = yes.
      136      end.
      137      return mWaitFramStopTimeOut.
      138   end.
      139   procedure waitfram-hide :
      140     if not session:batch-mode
      141     then do
      142     on error undo, return error return-value
      143     :
      144       pause 0 before-hide .
      145       if not mBatchMode then
      146         hide frame waitfram .
      147     if     not mWaitFramView
      148        and mWaitProcEvent
      149     then
      150       process events .
      151     end.
      152   end procedure.
      153   procedure waitfram-show :
      154     define input  parameter p-message as character no-undo .
      155     define variable v-left-margin as integer   no-undo .
      156     if not session:batch-mode
      157     then do
      158     on error undo, return error return-value
      159     :
      160       if length(p-message) <= 70 then do:
      161         assign
      162           v-left-margin = integer((70 - length(p-message)) / 2)
      163         .
      164         assign
      165           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      166         .
      167         assign
      168           v-waitfram-action01 = " "
      169           v-waitfram-action02 = " "
      170                                    + fill(" ", v-left-margin)
      171                                    + p-message
      172           v-waitfram-action03 = " "
      173         .
      174       end.
      175       else do:
      176         define variable vRindex1 as integer no-undo.
      177         define variable vRindex2 as integer no-undo.
      178         vRindex1 = r-index(p-message," ",70).
      179         if vRindex1 = 0
      180         then
      181            vRindex1 = 70.
      182         if length(p-message)  <= vRindex1 + 70 then do:
      183           assign
      184             v-waitfram-action01 = " "
      185             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      186             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      187           .
      188         end.
      189         else do:
      190           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      191           if vRindex2 <= vRindex1
      192           then
      193              vRindex2 = vRindex1 + 70.
      194           assign
      195             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      197             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      198           .
      199         end.
      200       end.
      201       B-viewProcInfo:visible   in frame waitfram = no.
      202       B-viewProcInfo:sensitive in frame waitfram = no.
      203       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      204       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       if  (   mWaitFramView
      206          or  mWaitProcEvent)
      207          and not mBatchMode
      208       then
      209          display
      210             v-waitfram-action01 skip
      211             v-waitfram-action02 skip
      212             v-waitfram-action03 skip
      213          with frame waitfram .
      214       if     mWaitFramView
      215          then do:
      216             if     mWaitFramInterval ne ?
      217                and not mBatchMode
      218             then
      219                wait-for go of frame waitfram pause mWaitFramInterval.
      220          end.
      221          else
      222             if     mWaitProcEvent
      223                and not mBatchMode
      224             then
      225                process events .
      226     end.
      227   end procedure.
      228      procedure waitfram-show-this:
      229         define input  parameter iInterval as int64 no-undo.
      230         define variable vtime as int64 no-undo.
      231         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      232         mWaitFramInterval = iInterval.
      233         run waitfram-show (substitute("&1&2 &3&4" ,
      234                                       mWaitFramTextBeg ,
      235                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      236                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      237                                       mWaitFramTextEnd
      238                                      )
      239                           ).
      240      end.
      241      procedure WaitFramRunPause:
      242         define input  parameter iInterval as dec no-undo.
      243         define variable vStart  as datetime-tz no-undo.
      244         define variable vend    as datetime-tz no-undo.
      245         define variable vint as int64 no-undo.
      246         define variable vOk as logical no-undo.
      247         vStart = now.
      248         vend   = vStart.
      249         publish "WaitFramPause" (iInterval,output vOk).
      250         vend   =  now.
      251         vint = vend - vStart.
      252         vint = iInterval - vint / 1000.
      253         if     not mWaitFramStop
      254            and (   vint > 0
      255                 or (    not vOk
      256                     and iInterval eq ?
      257                     )
      258                 )
      259         then
      260            run waitfram-show-this (iInterval).
      261         vend   =  now.
      262         vint = vend - vStart.
      263         vint = iInterval - vint / 1000.
      264         if     not mWaitFramStop
      265            and vint > 0
      266         then do:
      267            run gbl/pause.p (vint * 1000).
      268         end.
      269         if iInterval ne ?
      270         then
      271            publish "WaitFramStop".
      272         waitfram-check-timeout().
      273      end.
      274      procedure WaitFramWaitFor:
      275         define input  parameter iInterval as dec no-undo.
      276         assign
      277            mWaitFramStartProc   = now
      278            mWaitFramStopUser    = no
      279            mWaitFramStopTimeOut = no
      280         .
      281         block-wait:
      282         do while not mWaitFramStop:
      283            run WaitFramRunPause (iInterval).
      284            if  waitfram-check-timeout()
      285            then do:
      286               leave block-wait.
      287            end.
      288         end.
      289         run waitfram-hide.
      290      end.
      291   procedure waitfram-join :
      292     define input  parameter p-line-1  as character no-undo .
      293     define input  parameter p-line-2  as character no-undo .
      294     define input  parameter p-line-3  as character no-undo .
      295     define output parameter p-message as character no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       assign
      300         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      301                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      303       .
      304     end.
      305   end procedure.
      306   function waitfram-join-function returns character
      307     (input p-line-1 as character
      308     ,input p-line-2 as character
      309     ,input p-line-3 as character
      310     ).
      311     define variable v-message as character no-undo .
      312     run waitfram-join in this-procedure
      313       (input  p-line-1
      314       ,input  p-line-2
      315       ,input  p-line-3
      316       ,output v-message
      317       ) .
      318     return v-message .
      319   end function .
      320   define new global shared variable g#language as character no-undo .
      321   if g#language <> '' and g#language <> 'rus':U then do:
      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   procedure proc-alt-shift-f2:
      325     if not ibs.th.gbl.gbl-var:rcode
      326   then
      327     run gbl\inidebug.p .
      328   end.
      329   procedure proc-alt-shift-f3:
      330     run gbl/prvssinf.p
      331       ( input this-procedure
      332       ) .
      333   end.
      334   define variable v-inform-launched as logical no-undo initial false .
      335   procedure proc-alt-shift-f4:
      336     define variable v-action as character no-undo .
      337     if v-inform-launched = false then do:
      338       assign
      339         v-inform-launched = true
      340       .
      341       run gbl/d-inform.w
      342         (  input self
      343         ,  input this-procedure
      344         , output v-action
      345         ) no-error .
      346       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      347       assign
      348         v-inform-launched = false
      349       .
      350     end.
      351   end.
      352   procedure proc-alt-f1:
      353     run gbl/corrhelp.p
      354       (input this-procedure
      355       ) .
      356   end .
      357   on alt-shift-f2 anywhere do:
      358     run proc-alt-shift-f2.
      359   end.
      360   on alt-shift-f3 anywhere do:
      361     run proc-alt-shift-f3 in this-procedure .
      362   end.
      363   on alt-shift-f4 anywhere do:
      364     run proc-alt-shift-f4 in this-procedure.
      365   end.
      366   on alt-f1 anywhere do:
      367     run proc-alt-f1 in this-procedure .
      368   end.
      369   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   procedure gen-key-rec :
      371     define input  parameter p-tbl-name    as character no-undo.
      372     define input  parameter p-bh_tbl-name as handle    no-undo.
      373     define output parameter p-key-rec     as character no-undo.
      374     do
      375     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      376     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      377     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      378     :
      379       define variable fh               as handle    no-undo .
      380       define variable v-ok             as logical   no-undo .
      381       define variable v-inform         as character no-undo .
      382       define variable v-ind            as integer   no-undo .
      383       define variable v-idx-field-qnty as integer   no-undo .
      384       if p-tbl-name = ?
      385         or p-tbl-name = "":U
      386       then do:
      387         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      388       end.
      389       if not p-bh_tbl-name:available then do:
      390         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      391       end.
      392       assign
      393         p-key-rec = p-tbl-name
      394         v-inform  = p-bh_tbl-name:index-information(1)
      395         v-ind     = 2
      396       .
      397       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      398       on error undo, return error
      399       :
      400         assign
      401           v-inform = p-bh_tbl-name:index-information( v-ind )
      402           v-ind    = v-ind + 1
      403         .
      404       end.
      405       if v-inform = ?
      406         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      407         or entry( 3, v-inform, ",":U ) <> "1":U
      408       then do:
      409         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      410       end.
      411       else do:
      412         assign
      413           v-idx-field-qnty = num-entries( v-inform ) - 4
      414         .
      415         if v-idx-field-qnty < 2 then do:
      416           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      417         end.
      418         do v-ind = 1 to v-idx-field-qnty by 2
      419         on error undo, return error
      420         :
      421           assign
      422             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      423             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      424           .
      425         end.
      426       end.
      427       if p-key-rec = ? then do:
      428         assign
      429           p-key-rec = "":U
      430         .
      431         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      432       end.
      433     end.
      434     return.
      435   end procedure.
      436   procedure gen-where-keyr-tab :
      437     define input  parameter i-tableSerach as character no-undo.
      438     define input  parameter i-tablekey   as character  no-undo.
      439     define input  parameter p-key-rec    as character  no-undo.
      440     define input  parameter p-key-handle as handle     no-undo .
      441     define input  parameter p-db-name    as character  no-undo .
      442     define input  parameter p-tt-handle  as handle     no-undo .
      443     define output parameter o-Where      as character  no-undo.
      444     do
      445     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      446     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      447     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      448     :
      449       define variable v-full-tbl-name  as character no-undo .
      450       define variable bh_tbl-name      as handle    no-undo .
      451       define variable fh_key           as handle    no-undo .
      452       define variable fh_search        as handle    no-undo .
      453       define variable v-field-num      as integer   no-undo .
      454       define variable v-count-fld      as integer   no-undo .
      455       define variable v-inform         as character no-undo .
      456       define variable v-ind            as integer   no-undo .
      457       define variable v-idx-field-qnty as integer   no-undo .
      458       define variable v-field-name     as character no-undo .
      459       define variable v-field-val      as character no-undo .
      460       define variable v-word-link      as character no-undo .
      461       define variable vTable           as character no-undo.
      462       define variable bh_tbl-key       as handle    no-undo .
      463       assign
      464         p-key-rec = trim( p-key-rec )
      465       .
      466       if p-key-handle <> ? then do:
      467         if not valid-handle(p-key-handle)
      468            or p-key-handle:type <> "buffer"
      469         then do:
      470           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      471         end.
      472         if num-entries( p-key-rec, chr(3) ) > 1
      473           or p-key-rec = ?
      474           or p-key-rec = "":U
      475         then do:
      476           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      477         end.
      478       end.
      479       else do:
      480         if p-key-rec = ?
      481           or p-key-rec = "":U
      482         then do:
      483           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      484         end.
      485       end.
      486       assign
      487         vTable = entry( 1 , p-key-rec, chr(3) )
      488       .
      489       if p-tt-handle <> ?
      490         and ( not valid-handle(p-tt-handle)
      491               or p-tt-handle:type <> "buffer"
      492             )
      493       then do:
      494         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      495       end.
      496       if p-tt-handle = ? then do:
      497         assign
      498           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      499         .
      500         create buffer bh_tbl-name for table v-full-tbl-name .
      501       end.
      502       else do:
      503         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      504       end.
      505       assign
      506         v-inform = bh_tbl-name:index-information(1)
      507         v-ind    = 2
      508       .
      509       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      510       on error undo, return error
      511       :
      512         assign
      513           v-inform = bh_tbl-name:index-information( v-ind )
      514           v-ind    = v-ind + 1
      515         .
      516       end.
      517       if v-inform = ?
      518         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      519         or entry( 3, v-inform, ",":U ) <> "1":U
      520       then do:
      521         delete object bh_tbl-name no-error.
      522         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      523       end.
      524       assign
      525         v-idx-field-qnty = num-entries( v-inform ) - 4
      526       .
      527       if v-idx-field-qnty < 2 then do:
      528         delete object bh_tbl-name no-error.
      529         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      530       end.
      531       assign
      532         o-where     = "where":U
      533         v-word-link = "":U
      534         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      535         v-count-fld = 0
      536       .
      537       if i-tablekey ne "" and i-tablekey ne ?
      538       then do:
      539         assign
      540           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      541         .
      542         create buffer bh_tbl-key for table v-full-tbl-name .
      543       end.
      544       if i-tableSerach ne "" and i-tableSerach ne ?
      545       then do:
      546         delete object bh_tbl-name no-error.
      547         assign
      548           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      549         .
      550         create buffer bh_tbl-name for table v-full-tbl-name .
      551       end.
      552       block_where:
      553       do v-ind = 1 to v-idx-field-qnty by 2
      554       on error undo, return error
      555       :
      556         assign
      557           v-count-fld = v-count-fld + 1
      558         .
      559         if p-key-handle = ?
      560           and v-count-fld > v-field-num
      561         then do:
      562           leave block_where.
      563         end.
      564         define variable VfieldKeyTable as handle no-undo.
      565         assign
      566           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      567           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      568         .
      569         if     bh_tbl-key ne ?
      570         then do:
      571            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      572            if VfieldKeyTable eq ?
      573            then next block_where.
      574         end.
      575         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      576         then
      577            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      578         else
      579            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      580         if p-key-handle = ? then do:
      581           assign
      582             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      583           .
      584         end.
      585         else do:
      586           assign
      587             fh_key = p-key-handle:buffer-field( v-field-name )
      588           .
      589           if fh_key = ?
      590             or not valid-handle( fh_key )
      591           then do:
      592             delete object bh_tbl-name.
      593             if     bh_tbl-key ne ?
      594             then
      595                delete object bh_tbl-key.
      596             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      597           end.
      598           assign
      599             v-field-val = fh_key:buffer-value
      600           .
      601         end.
      602         if fh_search:data-type ="character":U then do:
      603           assign
      604             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      605             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      606             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      607             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      608             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      609             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      610             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      611             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      612             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      613             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      614             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      615             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      616             v-field-val = substitute( '"&1"', v-field-val )
      617           .
      618         end.
      619         assign
      620           o-where = substitute( "&1 &2", o-where, v-field-val )
      621         .
      622         if v-word-link = "":U then do:
      623           assign
      624             v-word-link = "and":U
      625           .
      626         end.
      627       end.
      628       delete object bh_tbl-name.
      629       if     bh_tbl-key ne ?
      630       then
      631          delete object bh_tbl-key.
      632       if p-key-handle = ?
      633         and v-count-fld <> v-field-num
      634       then do:
      635         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      636       end.
      637     end.
      638   end procedure.
      639   procedure gen-hn-keyr-tab :
      640     define input  parameter i-tableSerach as character no-undo.
      641     define input  parameter i-tablekey   as character no-undo.
      642     define input  parameter p-key-rec    as character no-undo.
      643     define input  parameter p-key-handle as handle    no-undo .
      644     define input  parameter p-db-name    as character no-undo .
      645     define input  parameter p-tt-handle  as handle    no-undo .
      646     define input  parameter p-stts-lock  as integer   no-undo .
      647     define output parameter o-hn         as handle    no-undo.
      648     define variable v-full-tbl-name as character no-undo.
      649     define variable v-where         as character no-undo.
      650     define variable bh_tbl-name     as handle    no-undo.
      651     define variable vTable          as character no-undo.
      652     do
      653     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      654     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      655     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      656         run gen-where-keyr-tab(i-tableSerach,
      657                                i-tablekey,
      658                                p-key-rec,
      659                                p-key-handle,
      660                                p-db-name,
      661                                p-tt-handle,
      662                                output v-where).
      663         if i-tableSerach ne "" and i-tableSerach ne ?
      664         then do:
      665            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      666            create buffer bh_tbl-name for table v-full-tbl-name .
      667         end.
      668         else do:
      669            if p-tt-handle = ? then do:
      670               assign
      671                  vTable = entry( 1 , p-key-rec, chr(3) )
      672               .
      673               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      674               create buffer bh_tbl-name for table v-full-tbl-name .
      675            end.
      676            else do:
      677               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      678            end.
      679         end.
      680         if p-tt-handle = ? then do:
      681            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      682         end.
      683         else do:
      684            bh_tbl-name:find-first( v-where ) no-error .
      685         end.
      686         o-hn = bh_tbl-name.
      687      end.
      688   end procedure.
      689   procedure gen-hn-keyr :
      690     define input  parameter p-key-rec    as character no-undo.
      691     define input  parameter p-key-handle as handle    no-undo .
      692     define input  parameter p-db-name    as character no-undo .
      693     define input  parameter p-tt-handle  as handle    no-undo .
      694     define input  parameter p-stts-lock  as integer   no-undo .
      695     define output parameter o-hn         as handle    no-undo.
      696     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      697   end.
      698   procedure gen-row-keyr :
      699     define input  parameter p-key-rec    as character no-undo.
      700     define input  parameter p-key-handle as handle    no-undo .
      701     define input  parameter p-db-name    as character no-undo .
      702     define input  parameter p-tt-handle  as handle    no-undo .
      703     define input  parameter p-stts-lock  as integer   no-undo .
      704     define output parameter p-tbl-row    as rowid     no-undo.
      705     define output parameter p-tbl-name   as character no-undo.
      706     define variable vHn as handle no-undo.
      707       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      708       p-tbl-row = if vHn:available then vHn:rowid else ?.
      709       p-tbl-name =  vHn:table.
      710       delete object vHn no-error.
      711     if p-tbl-row = ? then do:
      712       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      713     end.
      714     else do:
      715       return.
      716     end.
      717   end procedure.
      718   procedure gen-key-fv :
      719     define input  parameter p-key-rec    as character no-undo .
      720     define output parameter p-field-list as character no-undo .
      721     define output parameter p-value-list as character no-undo.
      722     do
      723     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      724     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      725     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      726     :
      727       define variable v-full-tbl-name  as character no-undo .
      728       define variable bh_tbl-name      as handle    no-undo .
      729       define variable v-tbl-name       as character no-undo .
      730       define variable v-field-num      as integer   no-undo .
      731       define variable v-count-fld      as integer   no-undo .
      732       define variable v-inform         as character no-undo .
      733       define variable v-ind            as integer   no-undo .
      734       define variable v-idx-field-qnty as integer   no-undo .
      735       define variable v-delim-key      as character no-undo .
      736       if p-key-rec = ?
      737         or p-key-rec = "":U
      738       then do:
      739         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      740       end.
      741       assign
      742         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      743         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      744       .
      745       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      746       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      747       assign
      748         v-inform = bh_tbl-name:index-information(1)
      749         v-ind    = 2
      750       .
      751       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      752       on error undo, return error
      753       :
      754         assign
      755           v-inform = bh_tbl-name:index-information( v-ind )
      756           v-ind    = v-ind + 1
      757         .
      758       end.
      759       if v-inform = ?
      760         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      761         or entry( 3, v-inform, ",":U ) <> "1":U
      762       then do:
      763         delete object bh_tbl-name no-error.
      764         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      765       end.
      766       assign
      767         v-idx-field-qnty = num-entries( v-inform ) - 4
      768       .
      769       if v-idx-field-qnty < 2 then do:
      770         delete object bh_tbl-name no-error.
      771         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      772       end.
      773       assign
      774         p-field-list = "":U
      775         p-value-list = "":U
      776         v-delim-key  = "":U
      777         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      778         v-count-fld  = 0
      779       .
      780       block_where:
      781       do v-ind = 1 to v-idx-field-qnty by 2
      782       on error undo, return error
      783       :
      784         assign
      785           v-count-fld = v-count-fld + 1
      786         .
      787         if v-count-fld > v-field-num then do:
      788           leave block_where.
      789         end.
      790         assign
      791           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      792           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      793         .
      794         if v-ind = 1 then do:
      795           assign
      796             v-delim-key = chr(3)
      797           .
      798         end.
      799       end.
      800       delete object bh_tbl-name.
      801       if v-count-fld <> v-field-num then do:
      802         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      803       end.
      804     end.
      805   end procedure.
      806   procedure gen-key-field :
      807     define input  parameter p-table      as character no-undo .
      808     define output parameter p-field-list as character no-undo .
      809     do
      810     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      811     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      812     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      813     :
      814       define variable v-full-tbl-name  as character no-undo .
      815       define variable bh_tbl-name      as handle    no-undo .
      816       define variable v-tbl-name       as character no-undo .
      817       define variable v-field-num      as integer   no-undo .
      818       define variable v-count-fld      as integer   no-undo .
      819       define variable v-inform         as character no-undo .
      820       define variable v-ind            as integer   no-undo .
      821       define variable v-idx-field-qnty as integer   no-undo .
      822       define variable v-delim-key      as character no-undo .
      823       if p-table = ?
      824         or p-table = "":U
      825       then do:
      826         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      827       end.
      828       assign
      829         v-tbl-name      = p-table
      830         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      831       .
      832       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      833       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      834       assign
      835         v-inform = bh_tbl-name:index-information(1)
      836         v-ind    = 2
      837       .
      838       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      839       on error undo, return error
      840       :
      841         assign
      842           v-inform = bh_tbl-name:index-information( v-ind )
      843           v-ind    = v-ind + 1
      844         .
      845       end.
      846       if v-inform = ?
      847         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      848         or entry( 3, v-inform, ",":U ) <> "1":U
      849       then do:
      850         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      851       end.
      852       assign
      853         v-idx-field-qnty = num-entries( v-inform ) - 4
      854       .
      855       if v-idx-field-qnty < 2 then do:
      856         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      857       end.
      858       assign
      859         p-field-list = "":U
      860         v-delim-key  = "":U
      861         v-count-fld  = 0
      862       .
      863       block_where:
      864       do v-ind = 1 to v-idx-field-qnty by 2
      865       on error undo, return error
      866       :
      867         assign
      868           v-count-fld = v-count-fld + 1
      869         .
      870         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      871         if v-ind = 1 then do:
      872           assign
      873             v-delim-key = chr(3)
      874           .
      875         end.
      876       end.
      877       delete object bh_tbl-name.
      878     end.
      879   end procedure.
      880   DEFINE VARIABLE v-param-num-list AS CHARACTER NO-UNDO.
      881   define variable v-is-copy as logical no-undo .
