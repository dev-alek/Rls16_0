      955             SIZE 34 BY 1
      956        t-run-db0 AT ROW 2.07 COL 71 WIDGET-ID 54
      957        tt-rule-process.pchain-id AT ROW 3.13 COL 14 COLON-ALIGNED WIDGET-ID 38 FORMAT "x(48)"
      958             VIEW-AS FILL-IN
      959             SIZE 53.5 BY 1
      960        t-run-rdb AT ROW 3.13 COL 71 WIDGET-ID 56
      961        t-link-btwn-profiles AT ROW 4.13 COL 71 WIDGET-ID 58
      962        tt-rule-process.start-from AT ROW 4.2 COL 15.5 NO-LABEL WIDGET-ID 42
      963             VIEW-AS RADIO-SET HORIZONTAL
      964             RADIO-BUTTONS
      965                       "ГБД", 0,
      966   "УБД", 1
      967             SIZE 20.5 BY 1.07
      968        tt-rule-process.link-id AT ROW 5.27 COL 14 COLON-ALIGNED WIDGET-ID 48
      969             VIEW-AS FILL-IN
      970             SIZE 15.5 BY 1.07
      971        t-is-export AT ROW 5.27 COL 71 WIDGET-ID 60
      972        t-is-import AT ROW 6.27 COL 71 WIDGET-ID 62
      973        tt-rule-process.codex_id AT ROW 6.57 COL 14 COLON-ALIGNED WIDGET-ID 50
      974             VIEW-AS FILL-IN
      975             SIZE 9 BY 1
      976        B-codex AT ROW 6.57 COL 26 WIDGET-ID 28
      977        t-needs-efile AT ROW 7.27 COL 71 WIDGET-ID 64
      978        tt-rule-process.ruleset_id AT ROW 7.67 COL 14 COLON-ALIGNED WIDGET-ID 52
      979             LABEL "Набор правил"
      980             VIEW-AS FILL-IN
      981             SIZE 9 BY 1
      982        t-needs-ifile AT ROW 8.27 COL 71 WIDGET-ID 66
      983        T-is-routing AT ROW 9.27 COL 71 WIDGET-ID 68
      984        T-is-esys-import AT ROW 10.27 COL 71 WIDGET-ID 70
      985        T-main-link AT ROW 11.27 COL 71 WIDGET-ID 72
      986        T-can-be-start AT ROW 12.27 COL 71 WIDGET-ID 74
      987        tt-rule-process.documentation AT ROW 14 COL 1 NO-LABEL WIDGET-ID 16
      988             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      989             SIZE 98 BY 4.27
      990        "Старт из:" VIEW-AS TEXT
      991             SIZE 12.5 BY 1.07 AT ROW 4.2 COL 2 WIDGET-ID 46
      992        SPACE(84.99) SKIP(14.02)
      993       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      994            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      995            TITLE ""
      996            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      997   ASSIGN
      998          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      999          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1000   ON GO OF FRAME Dialog-Frame
     1001   DO:
     1002     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1003     IF ERROR-STATUS:ERROR THEN DO:
     1004         RETURN NO-APPLY.
     1005     END.
     1006   END.
     1007   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1008   DO:
     1009     APPLY "END-ERROR":U TO SELF.
     1010   END.
     1011   ON CHOOSE OF B-codex IN FRAME Dialog-Frame
     1012   DO:
     1013   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1014   DEFINE BUFFER buf_ruleset FOR ub.ruleset.
     1015   IF tt-rule-process.pchain-type = ""
     1016   OR tt-rule-process.pchain-type =? THEN DO:
     1017      MESSAGE "Не выбран типа процесса"
     1018      VIEW-AS ALERT-BOX ERROR.
     1019      UNDO, RETURN NO-APPLY.
     1020   END.
     1021   if tt-rule-process.codex_id <> 0 then do:
     1022     find first buf_ruleset no-lock where
     1023             buf_ruleset.codex_id = tt-rule-process.codex_id
     1024         and buf_ruleset.ruleset_id = tt-rule-process.ruleset_id .
     1025     v-rid-list = string(recid(buf_ruleset)).
     1026   end.
     1027   run rul/ruleset-s.w ( INPUT parparentproc
     1028                        ,INPUT 'b-sel':U
     1029                        ,input "profile-type" + chr(4) + tt-rule-process.pchain-type + chr(4) + "all"
     1030                        ,input 0
     1031                        ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1032   IF v-rid-list <> '':U THEN DO:
     1033      FIND FIRST buf_ruleset NO-LOCK WHERE
     1034               recid(buf_ruleset) = INTEGER(v-rid-list) NO-ERROR.
     1035     IF NOT AVAILABLE buf_RULESET THEN RETURN NO-APPLY.
     1036     ASSIGN
     1037     tt-rule-process.codex_id = buf_ruleset.codex_id
     1038     tt-rule-process.ruleset_id = buf_ruleset.ruleset_id
     1039     .
     1040     DISPLAY
     1041     tt-rule-process.CODEx_id
     1042     tt-rule-process.ruleset_id
     1043     WITH FRAME Dialog-Frame.
     1044   END.
     1045   END.
     1046   ON VALUE-CHANGED OF tt-rule-process.pchain-type IN FRAME Dialog-Frame
     1047   DO:
     1048     assign
     1049     tt-rule-process.pchain-type.
     1050   END.
     1051   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1052   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1053   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   on help of frame Dialog-Frame
     1055   do:
     1056     run gbl/app_help.p
     1057       (input this-procedure :file-name
     1058       ,input ''
     1059       ,input ?
     1060       ) no-error.
     1061     if error-status :error then do:
     1062       message
     1063         "Ошибка при вызове помощи"
     1064         error-status :get-message(1)
     1065         view-as alert-box .
     1066     end.
     1067   end.
     1068   run minbtn-set in this-procedure .
     1069   on choose of b-help in frame Dialog-Frame
     1070   do:
     1071     apply "help":u to frame Dialog-Frame .
     1072   end.
     1073   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   procedure minbtn-set :
     1075       do
     1076           on error undo, return error return-value
     1077           :
     1078           define variable ii              as integer       no-undo .
     1079           define variable fh              as widget-handle no-undo .
     1080           define variable hh              as widget-handle no-undo .
     1081           define variable v-h             as handle        extent 4 no-undo .
     1082           define variable v-name-button   as character     no-undo .
     1083           define variable v-help-old-x    as decimal       no-undo .
     1084           define variable v-help-old-y    as decimal       no-undo .
     1085           define variable v-help-old-size as decimal       no-undo .
     1086           define variable v-frame-width   as decimal       no-undo .
     1087           define variable jj              as integer       no-undo .
     1088           do
     1089               on error undo, return error
     1090               :
     1091               assign
     1092                   v-frame-width = frame Dialog-Frame:width - 0.3
     1093                   fh            = frame Dialog-Frame:first-child
     1094                   hh            = fh:first-child
     1095                   ii            = 1
     1096                   .
     1097               do while valid-handle(hh):
     1098                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1099                   do:
     1100                       case lc(hh:name) :
     1101                           when "b-help" then
     1102                               do:
     1103                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1104                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1105                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1106                                   hh:TOOLTIP = "Помощь" .
     1107                                   v-help-old-x = hh:column .
     1108                                   v-help-old-y = hh:row    .
     1109                                   v-help-old-size = hh:width .
     1110                                   hh:width-chars = 2.5 .
     1111                               end.
     1112                           when "b-print" then
     1113                               do:
     1114                                   hh:load-image("cmp/b-print.bmp":u) .
     1115                                   hh:TOOLTIP = "Печать" .
     1116                                   v-h[ii] = hh:handle .
     1117                                   ii = ii + 1 .
     1118                                   hh:width-chars = 3 .
     1119                               end.
     1120                           when "b-history" or
     1121                           when "b-hist" then
     1122                               do:
     1123                                   hh:load-image("cmp/b-hist.bmp":u) .
     1124                                   hh:TOOLTIP = "История" .
     1125                                   v-h[ii] = hh:handle .
     1126                                   ii = ii + 1 .
     1127                                   hh:width-chars = 3 .
     1128                               end.
     1129                           when "b-sch" then
     1130                               do:
     1131                                   hh:load-image("cmp/b-sch.bmp":u) .
     1132                                   hh:TOOLTIP = "Установка Фильтра" .
     1133                                   v-h[ii] = hh:handle .
     1134                                   ii = ii + 1 .
     1135                                   hh:width-chars = 3 .
     1136                               end.
     1137                           when "b-hist-user" then
     1138                               do:
     1139                                   hh:load-image("cmp/b-hist.bmp":u) .
     1140                                   hh:TOOLTIP = "История пользователя" .
     1141                                   ii = ii + 1 .
     1142                               end.
     1143                       end case.
     1144                   end.
     1145                   hh = hh:next-sibling.
     1146               end.
     1147               b-help:column = v-frame-width - b-help:width-chars.
     1148               jj = 0.
     1149               repeat ii = 4 to 1 by -1 :
     1150                   if valid-handle (v-h[ii] ) then
     1151                   do:
     1152                       jj  = jj + 1 .
     1153                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1154                       v-h[ii]:row    = v-help-old-y .
     1155                   end.
     1156               end.
     1157           end.
     1158       end.
     1159   end procedure.
     1160   MAIN-BLOCK:
     1161   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1162      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1163      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1164     IF p-mode = 'ДОБАВЛЕНИЕ':U
     1165     THEN DO:
     1166       CREATE tt-rule-process.
     1167     END.
     1168     else do:
     1169       IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1170         FIND FIRST LOCKED_rule-process EXCLUSIVE-LOCK WHERE
     1171                   LOCKED_rule-process.pchain-type = p-pchain-type
     1172              and  LOCKED_rule-process.pchain-id = p-pchain-id
     1173              and  LOCKED_rule-process.start-from = p-start-from
     1174              and  LOCKED_rule-process.link-id = p-link-id   .
     1175       END.
     1176       IF p-mode = 'ПРОСМОТР':U
     1177       or p-mode = 'КОПИРОВАНИЕ':U
     1178       THEN DO:
     1179           FIND FIRST LOCKED_rule-process no-LOCK WHERE
     1180                   LOCKED_rule-process.pchain-type = p-pchain-type
     1181              and  LOCKED_rule-process.pchain-id = p-pchain-id
     1182              and  LOCKED_rule-process.start-from = p-start-from
     1183              and  LOCKED_rule-process.link-id = p-link-id no-error .
     1184       END.
     1185       create tt-rule-process.
     1186       buffer-copy locked_rule-process to tt-rule-process.
     1187     end.
     1188     if p-mode = 'КОПИРОВАНИЕ':U then do:
     1189       assign
     1190       p-mode = 'ДОБАВЛЕНИЕ':U
     1191       v-is-copy = yes.
     1192     end.
     1193     RUN Myenable in this-procedure .
     1194     WAIT-FOR GO OF FRAME Dialog-Frame.
     1195   END.
     1196   RUN disable_UI.
     1197   PROCEDURE disable_UI :
     1198     HIDE FRAME Dialog-Frame.
     1199   END PROCEDURE.
     1200   PROCEDURE enable_UI :
     1201     OPEN QUERY Dialog-Frame FOR EACH tt-rule-process SHARE-LOCK.
     1202     GET FIRST Dialog-Frame.
     1203     DISPLAY t-run-db0 t-run-rdb t-link-btwn-profiles t-is-export t-is-import
     1204             t-needs-efile t-needs-ifile T-is-routing T-is-esys-import T-main-link
     1205             T-can-be-start
     1206         WITH FRAME Dialog-Frame.
     1207     IF AVAILABLE tt-rule-process THEN
     1208       DISPLAY tt-rule-process.pchain-type tt-rule-process.pchain-id
     1209             tt-rule-process.start-from tt-rule-process.link-id
     1210             tt-rule-process.codex_id tt-rule-process.ruleset_id
     1211             tt-rule-process.documentation
     1212         WITH FRAME Dialog-Frame.
     1213     ENABLE B-exit b-quit B-Help tt-rule-process.pchain-type t-run-db0
     1214            tt-rule-process.pchain-id t-run-rdb t-link-btwn-profiles
     1215            tt-rule-process.start-from tt-rule-process.link-id t-is-export
     1216            t-is-import B-codex t-needs-efile t-needs-ifile T-is-routing
     1217            T-is-esys-import T-main-link T-can-be-start
     1218            tt-rule-process.documentation
     1219         WITH FRAME Dialog-Frame.
     1220     VIEW FRAME Dialog-Frame.
     1221   END PROCEDURE.
     1222   PROCEDURE MyEnable :
     1223   ASSIGN
     1224   tt-rule-process.pchain-type:LIST-ITEMS IN FRAME Dialog-Frame = 'dis-card-type,goods,clients,gds-grp,cli-grp,chk-doc_IBS-TH,chk-doc_IBS-TH-MOB,edoc,thref,pdf,rep,ord,cmb,fdoc':U .
     1225   assign
     1226   t-run-db0 = (tt-rule-process.run-db0 > 0)
     1227   t-run-rdb = (tt-rule-process.run-rdb > 0)
     1228   t-link-btwn-profiles = (tt-rule-process.link-btwn-profiles > 0)
     1229   t-is-export = (tt-rule-process.is-export > 0)
     1230   t-is-import = (tt-rule-process.is-import > 0)
     1231   t-needs-efile = (tt-rule-process.needs-efile > 0)
     1232   t-needs-ifile = (tt-rule-process.needs-ifile > 0)
     1233   t-is-routing = (tt-rule-process.is-routing > 0)
     1234   t-is-esys-import = (tt-rule-process.is-esys-import > 0)
     1235   t-main-link = (tt-rule-process.main-link > 0)
     1236   t-can-be-start = (tt-rule-process.can-be-start > 0)
     1237   .
     1238   IF AVAILABLE tt-rule-process THEN
     1239   DISPLAY
     1240   tt-rule-process.pchain-type
     1241   tt-rule-process.pchain-id
     1242   tt-rule-process.start-from
     1243   tt-rule-process.link-id
     1244   tt-rule-process.codex_id
     1245   tt-rule-process.ruleset_id
     1246   t-run-db0
     1247   t-run-rdb
     1248   t-link-btwn-profiles
     1249   t-is-export
     1250   t-is-import
     1251   t-needs-efile
     1252   t-needs-ifile
     1253   t-is-routing
     1254   t-is-esys-import
     1255   t-main-link
     1256   t-can-be-start
     1257   tt-rule-process.documentation
     1258   WITH FRAME Dialog-Frame .
     1259   ENABLE
     1260   B-exit  when p-mode <> 'ПРОСМОТР':U
     1261   b-quit
     1262   B-Help
     1263   tt-rule-process.pchain-type  when p-mode = 'ДОБАВЛЕНИЕ':U
     1264   tt-rule-process.pchain-id when p-mode = 'ДОБАВЛЕНИЕ':U
     1265   tt-rule-process.start-from      when p-mode = 'ДОБАВЛЕНИЕ':U
     1266   tt-rule-process.link-id when p-mode = 'ДОБАВЛЕНИЕ':U
     1267   tt-rule-process.documentation when p-mode <> 'ПРОСМОТР':U
     1268   b-codex when p-mode <> 'ПРОСМОТР':U
     1269   t-run-db0 when p-mode <> 'ПРОСМОТР':U
     1270   t-run-rdb when p-mode <> 'ПРОСМОТР':U
     1271   t-link-btwn-profiles when p-mode <> 'ПРОСМОТР':U
     1272   t-is-export when p-mode <> 'ПРОСМОТР':U
     1273   t-is-import when p-mode <> 'ПРОСМОТР':U
     1274   t-needs-efile when p-mode <> 'ПРОСМОТР':U
     1275   t-needs-ifile when p-mode <> 'ПРОСМОТР':U
     1276   t-is-routing when p-mode <> 'ПРОСМОТР':U
     1277   t-is-esys-import when p-mode <> 'ПРОСМОТР':U
     1278   t-main-link when p-mode <> 'ПРОСМОТР':U
     1279   t-can-be-start when p-mode <> 'ПРОСМОТР':U
     1280   WITH FRAME Dialog-Frame .
     1281   if p-mode = 'ПРОСМОТР':U then do:
     1282     assign
     1283     b-quit:label = "&Выход"
     1284     b-quit:column = 1
     1285     tt-rule-process.documentation:READ-ONLY = YES
     1286     .
     1287     hide b-exit in frame Dialog-Frame .
     1288   end.
     1289   VIEW FRAME Dialog-Frame .
     1290   END PROCEDURE.
     1291   PROCEDURE proc-save :
     1292   DEFINE VARIABLE v-rec AS recID  NO-UNDO.
     1293   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1294       RETURN.
     1295   END.
     1296   v-rec = p-rec.
     1297   ASSIGN
     1298   FRAME Dialog-Frame
     1299   tt-rule-process.pchain-type
     1300   tt-rule-process.pchain-id
     1301   tt-rule-process.start-from
     1302   tt-rule-process.link-id
     1303   tt-rule-process.codex_id
     1304   tt-rule-process.ruleset_id
     1305   t-run-db0
     1306   tt-rule-process.run-db0 = (if t-run-db0 then 1 else 0)
     1307   t-run-rdb
     1308   tt-rule-process.run-rdb = (if t-run-rdb then 1 else 0)
     1309   t-link-btwn-profiles
     1310   tt-rule-process.link-btwn-profiles = (if t-link-btwn-profiles then 1 else 0)
     1311   t-is-export
     1312   tt-rule-process.is-export = (if t-is-export then 1 else 0)
     1313   t-is-import
     1314   tt-rule-process.is-import = (if t-is-import then 1 else 0)
     1315   t-needs-efile
     1316   tt-rule-process.needs-efile = (if t-needs-efile then 1 else 0)
     1317   t-needs-ifile
     1318   tt-rule-process.needs-ifile = (if t-needs-ifile then 1 else 0)
     1319   t-is-routing
     1320   tt-rule-process.is-routing = (if t-is-routing then 1 else 0)
     1321   t-is-esys-import
     1322   tt-rule-process.is-esys-import = (if t-is-esys-import then 1 else 0)
     1323   t-main-link
     1324   tt-rule-process.main-link = (if t-main-link then 1 else 0)
     1325   t-can-be-start
     1326   tt-rule-process.can-be-start = (if t-can-be-start then 1 else 0)
     1327   .
     1328   run rul/rule-process1.p ( INPUT p-mode
     1329                   ,INPUT NO
     1330                   ,INPUT-OUTPUT v-rec
     1331                   ,INPUT tt-rule-process.pchain-type
     1332                   ,INPUT tt-rule-process.pchain-id
     1333                   ,INPUT tt-rule-process.start-from
     1334                   ,INPUT tt-rule-process.link-id
     1335                   ,INPUT tt-rule-process.codex_id
     1336                   ,INPUT tt-rule-process.ruleset_id
     1337                   ,INPUT tt-rule-process.run-db0
     1338                   ,INPUT tt-rule-process.run-rdb
     1339                   ,INPUT tt-rule-process.link-btwn-profiles
     1340                   ,INPUT tt-rule-process.is-export
     1341                   ,INPUT tt-rule-process.is-import
     1342                   ,INPUT tt-rule-process.needs-efile
     1343                   ,INPUT tt-rule-process.needs-ifile
     1344                   ,INPUT tt-rule-process.is-routing
     1345                   ,INPUT tt-rule-process.is-esys-import
     1346                   ,INPUT tt-rule-process.main-link
     1347                   ,INPUT tt-rule-process.can-be-start
     1348                   ,INPUT tt-rule-process.documentation:screen-value
     1349                   ) no-error.
     1350   if error-status:error then do:
     1351   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   define variable fh as widget-handle no-undo .
     1353   define variable hh as widget-handle no-undo .
     1354   define variable rv as character no-undo .
     1355   assign
     1356   rv = entry(1, return-value , chr(4)).
     1357   if rv <> "":U then do:
     1358     assign
     1359     fh = frame Dialog-Frame:first-child
     1360     hh = fh:first-child
     1361     .
     1362     do while valid-handle(hh):
     1363       if hh:name = rv then do:
     1364         APPLY "ENTRY" to hh.
     1365         undo ,
     1366         return error.
     1367       end.
     1368       hh = hh:next-sibling.
     1369     end.
     1370   end.
     1371     undo, return error.
     1372   end.
     1373   p-rec = v-rec.
     1374   END PROCEDURE.
