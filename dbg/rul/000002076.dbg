     2009   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2010   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2011   procedure proc-ord-code :
     2012   define input  parameter  p-type as character no-undo .
     2013   define input  parameter  v-cntxt-db-num   as integer   no-undo .
     2014   define input  parameter  v-cntxt-obj-type as character no-undo .
     2015   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     2016   define input  parameter  p-i-doc    as character no-undo .
     2017   define output parameter  p-ord-doc  as character no-undo .
     2018   define variable          v-idop     as character no-undo .
     2019     do
     2020     on error undo, return error return-value
     2021     :
     2022   case p-type :
     2023       when "main-no-ver" then do:
     2024         if  (v-cntxt-db-num <> 0) then
     2025           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     2026         else
     2027           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     2028       end.
     2029       when "main" then do:
     2030             do while true:
     2031             if  (v-cntxt-db-num <> 0) then
     2032               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     2033             else
     2034               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     2035             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     2036             End.
     2037       end.
     2038       when "chip" then do:
     2039         assign
     2040           v-idop = p-i-doc .
     2041         do while true :
     2042           if index (v-idop , ".") = 0 then
     2043             v-idop  = replace (v-idop , "-", "-1.").
     2044           else
     2045             v-idop  =
     2046             substring (v-idop , 1, index (v-idop, "-")) +
     2047             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     2048             substring (v-idop, index (v-idop, ".")).
     2049           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     2050         end.
     2051         assign
     2052           p-ord-doc = v-idop.
     2053       end.
     2054   end case.
     2055     end.
     2056   end procedure.
     2057   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2058   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2059   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2060   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2061   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2062   procedure ordlineattr-value :
     2063     do
     2064     on error undo, return error return-value
     2065     :
     2066       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2067       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2068       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2069       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2070       define output parameter p-type     as character no-undo .
     2071       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2072       define variable v-format         as character no-undo .
     2073       define variable v-fillin_width   as integer   no-undo .
     2074       define variable v-fillin_height  as integer   no-undo .
     2075       define variable v-label          as character no-undo .
     2076       define variable v-user-can-edit  as logical   no-undo .
     2077       define variable v-output-display as logical   no-undo .
     2078       define variable v-other          as character no-undo .
     2079       define variable v-proc           as character no-undo .
     2080       define variable v-func           as character no-undo .
     2081       define variable v-sort           as integer   no-undo .
     2082       run ordlineattr-code in this-procedure
     2083         (input  p-code
     2084         ,output p-type
     2085         ,output v-format
     2086         ,output v-fillin_width
     2087         ,output v-fillin_height
     2088         ,output v-label
     2089         ,output v-user-can-edit
     2090         ,output v-output-display
     2091         ,output v-proc
     2092         ,output v-func
     2093         ,output v-sort
     2094         ,output v-other
     2095         ) no-error .
     2096       if error-status :error then do:
     2097         undo, return error return-value .
     2098       end.
     2099       find first buf_ord-line-attr no-lock
     2100         where buf_ord-line-attr.doc-code  = p-doc-code
     2101           and buf_ord-line-attr.gds-code  = p-gds-code
     2102           and buf_ord-line-attr.attr-code = p-code
     2103         no-error .
     2104       if avail buf_ord-line-attr then do:
     2105         assign
     2106           p-value =  buf_ord-line-attr.attr-value
     2107         .
     2108       end.
     2109       else do:
     2110         assign
     2111           p-value = if p-type = 'L':U then "no":U else ""
     2112         .
     2113       end.
     2114     end.
     2115   end procedure.
     2116   procedure ordlineattr-write :
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2121       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2122       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2123       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     2124       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2125       define variable v-type           as character no-undo .
     2126       define variable v-format         as character no-undo .
     2127       define variable v-fillin_width   as integer   no-undo .
     2128       define variable v-fillin_height  as integer   no-undo .
     2129       define variable v-label          as character no-undo .
     2130       define variable v-user-can-edit  as logical   no-undo .
     2131       define variable v-output-display as logical   no-undo .
     2132       define variable v-other          as character no-undo .
     2133       define variable v-proc           as character no-undo .
     2134       define variable v-func           as character no-undo .
     2135       define variable v-sort           as integer   no-undo .
     2136       run ordlineattr-code in this-procedure
     2137         (input  p-code
     2138         ,output v-type
     2139         ,output v-format
     2140         ,output v-fillin_width
     2141         ,output v-fillin_height
     2142         ,output v-label
     2143         ,output v-user-can-edit
     2144         ,output v-output-display
     2145         ,output v-proc
     2146         ,output v-func
     2147         ,output v-sort
     2148         ,output v-other
     2149         ) no-error .
     2150       if error-status :error then do:
     2151         message
     2152           vss-workfile vss-revision vss-description skip
     2153           error-status :get-message(1) skip
     2154           return-value skip
     2155           ""
     2156           view-as alert-box error
     2157         .
     2158         undo, return error return-value .
     2159       end.
     2160       find first buf_ord-line-attr exclusive-lock
     2161         where buf_ord-line-attr.doc-code  = p-doc-code
     2162           and buf_ord-line-attr.gds-code  = p-gds-code
     2163           and buf_ord-line-attr.attr-code = p-code
     2164         no-error .
     2165       if not available buf_ord-line-attr then do:
     2166         create buf_ord-line-attr .
     2167         assign
     2168           buf_ord-line-attr.doc-code   = p-doc-code
     2169           buf_ord-line-attr.gds-code   = p-gds-code
     2170           buf_ord-line-attr.attr-code  = p-code
     2171         .
     2172       end.
     2173       assign
     2174         buf_ord-line-attr.attr-value = p-value
     2175       .
     2176   end.
     2177   end procedure.
     2178   procedure ordlineattr-exist :
     2179     do
     2180     on error undo, return error return-value
     2181     :
     2182       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2183       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2184       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2185       define output parameter p-exist   as logical  no-undo .
     2186       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2187       define variable v-type           as character no-undo .
     2188       define variable v-format         as character no-undo .
     2189       define variable v-fillin_width   as integer   no-undo .
     2190       define variable v-fillin_height  as integer   no-undo .
     2191       define variable v-label          as character no-undo .
     2192       define variable v-user-can-edit  as logical   no-undo .
     2193       define variable v-output-display as logical   no-undo .
     2194       define variable v-other          as character no-undo .
     2195       define variable v-proc           as character no-undo .
     2196       define variable v-func           as character no-undo .
     2197       define variable v-sort           as integer   no-undo .
     2198       run ordlineattr-code in this-procedure
     2199         (input  p-code
     2200         ,output v-type
     2201         ,output v-format
     2202         ,output v-fillin_width
     2203         ,output v-fillin_height
     2204         ,output v-label
     2205         ,output v-user-can-edit
     2206         ,output v-output-display
     2207         ,output v-proc
     2208         ,output v-func
     2209         ,output v-sort
     2210         ,output v-other
     2211         ) no-error .
     2212       if error-status :error then do:
     2213         undo, return error return-value .
     2214       end.
     2215       find first buf_ord-line-attr no-lock
     2216         where buf_ord-line-attr.doc-code  = p-doc-code
     2217           and buf_ord-line-attr.gds-code = p-gds-code
     2218           and buf_ord-line-attr.attr-code = p-code
     2219         no-error .
     2220       if  available buf_ord-line-attr then do:
     2221         p-exist = yes.
     2222       end.
     2223     end.
     2224   end procedure.
     2225   procedure ordlineattr-delete :
     2226     do
     2227     on error undo, return error return-value
     2228     :
     2229       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2230       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2231       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2232       define output parameter p-deleted  as logical no-undo.
     2233       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2234       define variable v-type           as character no-undo .
     2235       define variable v-format         as character no-undo .
     2236       define variable v-fillin_width   as integer   no-undo .
     2237       define variable v-fillin_height  as integer   no-undo .
     2238       define variable v-label          as character no-undo .
     2239       define variable v-user-can-edit  as logical   no-undo .
     2240       define variable v-output-display as logical   no-undo .
     2241       define variable v-proc           as character no-undo .
     2242       define variable v-func           as character no-undo .
     2243       define variable v-sort           as integer   no-undo .
     2244       define variable v-other          as character no-undo .
     2245       run ordlineattr-code in this-procedure
     2246         (input  p-code
     2247         ,output v-type
     2248         ,output v-format
     2249         ,output v-fillin_width
     2250         ,output v-fillin_height
     2251         ,output v-label
     2252         ,output v-user-can-edit
     2253         ,output v-output-display
     2254         ,output v-proc
     2255         ,output v-func
     2256         ,output v-sort
     2257         ,output v-other
     2258         ) no-error .
     2259       if error-status :error then do:
     2260         undo, return error return-value .
     2261       end.
     2262       find first buf_ord-line-attr exclusive-lock
     2263         where buf_ord-line-attr.doc-code  = p-doc-code
     2264           and buf_ord-line-attr.gds-code  = p-gds-code
     2265           and buf_ord-line-attr.attr-code = p-code
     2266         no-error NO-WAIT.
     2267       if not available buf_ord-line-attr then do:
     2268         p-deleted = no.
     2269       end.
     2270       else do:
     2271         delete buf_ord-line-attr.
     2272         p-deleted = yes.
     2273       end.
     2274     end.
     2275   end procedure.
     2276   procedure ordlineattr-code :
     2277     do on error undo, return error return-value
     2278     :
     2279       define input  parameter p-code           as character no-undo .
     2280       define output parameter p-type           as character no-undo .
     2281       define output parameter p-format         as character no-undo .
     2282       define output parameter p-fillin_width   as integer   no-undo .
     2283       define output parameter p-fillin_height  as integer   no-undo .
     2284       define output parameter p-label          as character no-undo .
     2285       define output parameter p-user-can-edit  as logical   no-undo .
     2286       define output parameter p-output-display as logical   no-undo .
     2287       define output parameter p-proc           as character no-undo .
     2288       define output parameter p-func           as character no-undo .
     2289       define output parameter p-sort           as integer   no-undo .
     2290       define output parameter p-other          as character no-undo .
     2291       case p-code :
     2292               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2293               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2294         otherwise do:
     2295           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     2296         end.
     2297       end.
     2298     end.
     2299   end procedure.
     2300   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     2301   define variable v-ii as integer   no-undo .
     2302   define variable v-dop as character no-undo .
     2303   define variable v-dop1 as character no-undo .
     2304   define variable v-mess as character no-undo .
     2305   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2306     v-dop = entry(v-ii, p-mess, chr(4) ).
     2307     case entry(1, v-dop, "="):
     2308       when 'pack-num':U then do:
     2309         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2310       end.
     2311       when 'route':U then do:
     2312         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2313       end.
     2314       when 'ediiterchangeid':U then do:
     2315         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2316       end.
     2317       when 'price-up':U then do:
     2318         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2319       end.
     2320       when 'price-down':U then do:
     2321         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2322       end.
     2323       when 'vat-change':U then do:
     2324         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2325       end.
     2326       when 'ps':U then do:
     2327         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2328       end.
     2329       when 'info':U then do:
     2330         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2331       end.
     2332       when 'qnty-up':U then do:
     2333         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2334       end.
     2335       when 'qnty-down':U then do:
     2336         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2337       end.
     2338       when 'bstr-change':U then do:
     2339         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2340       end.
     2341       when 'shipdate-change':U then do:
     2342         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2343       end.
     2344       when 'clioutdoc-change':U then do:
     2345         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2346       end.
     2347     end case.
     2348     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     2349   end.
     2350   return v-mess.
     2351   end function.
     2352   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     2353   define variable v-ii as integer   no-undo .
     2354   define variable v-dop as character no-undo .
     2355   define variable v-dop1 as character no-undo .
     2356   define variable v-mess as character no-undo .
     2357   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2358     v-dop = entry(v-ii, p-mess, chr(4) ).
     2359     case entry(1, v-dop, "="):
     2360       when 'pack-num':U then do:
     2361         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2362       end.
     2363       when 'route':U then do:
     2364         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2365       end.
     2366       when 'ediiterchangeid':U then do:
     2367         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2368       end.
     2369       when 'price-up':U then do:
     2370         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2371       end.
     2372       when 'price-down':U then do:
     2373         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2374       end.
     2375       when 'vat-change':U then do:
     2376         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2377       end.
     2378       when 'ps':U then do:
     2379         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2380       end.
     2381       when 'info':U then do:
     2382         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2383       end.
     2384       when 'qnty-up':U then do:
     2385         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2386       end.
     2387       when 'qnty-down':U then do:
     2388         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2389       end.
     2390       when 'bstr-change':U then do:
     2391         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2392       end.
     2393       when 'shipdate-change':U then do:
     2394         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2395       end.
     2396       when 'clioutdoc-change':U then do:
     2397         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2398       end.
     2399     end case.
     2400     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2401   end.
     2402   return v-mess.
     2403   end function.
     2404   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2405   define variable v-ii as integer   no-undo .
     2406   define variable v-dop as character no-undo .
     2407   define variable v-dop1 as character no-undo .
     2408   define variable v-value as character no-undo .
     2409   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2410     v-dop = entry(v-ii, p-mess, chr(4) ).
     2411     if entry(1, v-dop, "=") = p-key then do:
     2412       return entry(2, v-dop, "=").
     2413     end.
     2414   end.
     2415   return v-value.
     2416   end function.
     2417   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2418                                                        ,input p-key as character
     2419                                                        ,input p-value as character):
     2420   define variable v-dop as character no-undo .
     2421   define variable v-modificator as character no-undo .
     2422   assign
     2423   v-modificator = entry(2, p-key, "-") no-error .
     2424   case v-modificator:
     2425     when "up" then do:
     2426       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2427     end.
     2428     when "down" then do:
     2429       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2430     end.
     2431     when "change" then do:
     2432       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2433     end.
     2434     otherwise do:
     2435       v-dop = substitute("&1=&2", p-key, p-value).
     2436     end.
     2437   end case.
     2438   if p-mess = ''
     2439   or p-mess = ? then do:
     2440     return v-dop .
     2441   end.
     2442   else do:
     2443     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2444   end.
     2445   end function.
     2446   procedure create-edi-state :
     2447   define input  parameter p-tbl-name   as character no-undo .
     2448   define input  parameter p-doc-code   as character no-undo .
     2449   define input  parameter p-cli-type   as character no-undo .
     2450   define input  parameter p-cli-code   as integer   no-undo .
     2451   define input  parameter p-act        as character no-undo .
     2452   define input  parameter p-state      as character no-undo .
     2453   define input  parameter p-err        as integer   no-undo .
     2454   define input  parameter p-des        as character no-undo .
     2455   define input  parameter p-mess       as character no-undo .
     2456   define input  parameter p-dm         as integer  no-undo .
     2457   define input-output parameter p-date       as date no-undo .
     2458   define input-output parameter p-time       as integer no-undo .
     2459   define buffer buf_EDI-status for ub.EDI-status  .
     2460   define variable v-time as integer   no-undo .
     2461   define variable v-date as date   no-undo .
     2462   do
     2463   on error undo, return error return-value
     2464   :
     2465     if p-date = ? then do:
     2466       run cur-time in this-procedure ( output v-date, output v-time).
     2467     end.
     2468     else do:
     2469       assign
     2470       v-date = p-date
     2471       v-time = p-time
     2472       .
     2473     end.
     2474     find first buf_edi-status exclusive-lock where
     2475                 buf_edi-status.date-status = v-date
     2476             and buf_edi-status.time-status = v-time
     2477             and buf_edi-status.tbl-name    = p-tbl-name
     2478             and buf_edi-status.doc-code    = p-doc-code no-error .
     2479     if not available buf_edi-status  then do:
     2480       create buf_edi-status.
     2481     end.
     2482     assign
     2483     buf_edi-status.act         = p-act        .
     2484     buf_edi-status.cli-type    = p-cli-type   .
     2485     buf_edi-status.cli-code    = p-cli-code   .
     2486     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2487     buf_edi-status.doc-code    = p-doc-code   .
     2488     buf_edi-status.err-code    = p-err        .
     2489     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2490     buf_edi-status.state       = p-state      .
     2491     buf_edi-status.tbl-name    = p-tbl-name   .
     2492     buf_edi-status.date-status = v-date       .
     2493     buf_edi-status.time-status = v-time       .
     2494     buf_edi-status.whole-send-news = p-dm     .
     2495     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2496                                       else (if g#esys
     2497                                             then (chr(4) +  'ВС':U)
     2498                                             else g#userid)
     2499                                       )       .
     2500     assign
     2501     p-date = buf_edi-status.date-status
     2502     p-time = buf_edi-status.time-status
     2503     .
     2504   end.
     2505   end procedure.
     2506   procedure update-edi-state-light :
     2507   define input  parameter p-tbl-name   as character no-undo .
     2508   define input  parameter p-doc-code   as character no-undo .
     2509   define input  parameter p-date-status as date no-undo .
     2510   define input  parameter p-time-status as integer no-undo .
     2511   define input  parameter p-state      as character no-undo .
     2512   define input  parameter p-err        as integer   no-undo .
     2513   define input  parameter p-des        as character no-undo .
     2514   define input  parameter p-mess       as character no-undo .
     2515   define buffer buf_edi-status for ub.edi-status.
     2516   do
     2517   on error undo, return error
     2518   :
     2519     find first buf_edi-status exclusive-lock where
     2520                 buf_edi-status.date-status = p-date-status
     2521             and buf_edi-status.time-status = p-time-status
     2522             and buf_edi-status.tbl-name    = p-tbl-name
     2523             and buf_edi-status.doc-code    = p-doc-code no-error .
     2524     if available buf_edi-status  then do:
     2525       assign
     2526       buf_edi-status.des-err     = p-des        .
     2527       buf_edi-status.err-code    = p-err        .
     2528       buf_edi-status.mess-id     = p-mess       .
     2529       buf_edi-status.state       = p-state      .
     2530     end.
     2531   end.
     2532   end procedure.
     2533   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2534   PROCEDURE write-bonus :
     2535   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2536   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2537   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2538   define input  parameter v-bonus as decimal   no-undo .
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542       find first ub.contract-specif-attr exclusive-lock  where
     2543                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2544                  ub.contract-specif-attr.host-code    = p-host-code     and
     2545                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2546                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2547                 no-error .
     2548         if not available ub.contract-specif-attr then do:
     2549            create ub.contract-specif-attr .
     2550            assign
     2551                 ub.contract-specif-attr.contract-num = p-contract-num
     2552                 ub.contract-specif-attr.host-code    = p-host-code
     2553                 ub.contract-specif-attr.gds-code     = p-gds-code
     2554                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2555            .
     2556         end.
     2557         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2558   end.
     2559   END PROCEDURE.
     2560   PROCEDURE read-bonus :
     2561   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2562   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2563   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2564   define output parameter v-bonus as decimal   no-undo .
     2565     do
     2566     on error undo, return error return-value
     2567     :
     2568   find first ub.contract-specif-attr no-lock  where
     2569              ub.contract-specif-attr.contract-num = p-contract-num  and
     2570              ub.contract-specif-attr.host-code    = p-host-code     and
     2571              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2572              ub.contract-specif-attr.attr-code    = 'bonus':U
     2573              no-error .
     2574      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2575                                           else  v-bonus = 0 .
     2576   end.
     2577   END PROCEDURE.
     2578   PROCEDURE write-prc-min :
     2579   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2580   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2581   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2582   define input  parameter v-prc-min        as decimal   no-undo .
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       find first ub.contract-specif-attr exclusive-lock  where
     2587                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2588                 ub.contract-specif-attr.host-code    = p-host-code     and
     2589                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2590                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2591                 no-error .
     2592         if not available ub.contract-specif-attr then do:
     2593            create ub.contract-specif-attr .
     2594            assign
     2595                 ub.contract-specif-attr.contract-num = p-contract-num
     2596                 ub.contract-specif-attr.host-code    = p-host-code
     2597                 ub.contract-specif-attr.gds-code     = p-gds-code
     2598                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2599                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2600            .
     2601         end.
     2602         else do:
     2603            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2604         end.
     2605       find first ub.contract-specif exclusive-lock where
     2606           ub.contract-specif.contract-num = p-contract-num and
     2607           ub.contract-specif.host-code    = p-host-code    and
     2608           ub.contract-specif.gds-code     = p-gds-code.
     2609           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2610   end.
     2611   END PROCEDURE.
     2612   PROCEDURE read-prc-min :
     2613   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2614   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2615   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2616   define output parameter v-prc-min as decimal   no-undo .
     2617     do
     2618     on error undo, return error return-value
     2619     :
     2620   find first ub.contract-specif-attr no-lock  where
     2621              ub.contract-specif-attr.contract-num = p-contract-num  and
     2622              ub.contract-specif-attr.host-code    = p-host-code     and
     2623              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2624              ub.contract-specif-attr.attr-code    = 'prc-min':U
     2625              no-error .
     2626      if available ub.contract-specif-attr then  v-prc-min = decimal (ub.contract-specif-attr.attr-value ) .
     2627                                           else  v-prc-min = 0 .
     2628   end.
     2629   END PROCEDURE.
     2630   PROCEDURE write-retro-bonus :
     2631   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2632   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2633   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2634   define input  parameter v-retro-bonus as character   no-undo .
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638       find first ub.contract-specif-attr exclusive-lock  where
     2639                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2640                 ub.contract-specif-attr.host-code    = p-host-code     and
     2641                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2642                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2643                 no-error .
     2644         if not available ub.contract-specif-attr then do:
     2645            create ub.contract-specif-attr .
     2646            assign
     2647                 ub.contract-specif-attr.contract-num = p-contract-num
     2648                 ub.contract-specif-attr.host-code    = p-host-code
     2649                 ub.contract-specif-attr.gds-code     = p-gds-code
     2650                 ub.contract-specif-attr.attr-code    = "retro-bonus"
     2651            .
     2652            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2653            if error-status:error then
     2654               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2655         end.
     2656         else do:
     2657            ub.contract-specif-attr.attr-value  = v-retro-bonus no-error.
     2658            if error-status:error then
     2659               message "Превышен допустимый объем информации о ретро-бонусах. Удалите исторические или неактуальны периоды" view-as alert-box error.
     2660         end.
     2661       find first ub.contract-specif exclusive-lock where
     2662           ub.contract-specif.contract-num = p-contract-num and
     2663           ub.contract-specif.host-code    = p-host-code    and
     2664           ub.contract-specif.gds-code     = p-gds-code.
     2665           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2666   end.
     2667   END PROCEDURE.
     2668   PROCEDURE read-retro-bonus :
     2669   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2670   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2671   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2672   define output parameter v-retro-bonus as character   no-undo .
     2673     do
     2674     on error undo, return error return-value
     2675     :
     2676   find first ub.contract-specif-attr no-lock  where
     2677              ub.contract-specif-attr.contract-num = p-contract-num  and
     2678              ub.contract-specif-attr.host-code    = p-host-code     and
     2679              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2680              ub.contract-specif-attr.attr-code    = "retro-bonus"
     2681              no-error .
     2682      if available ub.contract-specif-attr then  v-retro-bonus = ub.contract-specif-attr.attr-value  .
     2683                                           else  v-retro-bonus = "" .
     2684   end.
     2685   END PROCEDURE.
     2686   define variable v-desadv-DELIVERYNOTENUMBER as character no-undo.
     2687   define variable v-desadv-DELIVERYNOTEDATE as date no-undo.
     2688   define variable v-cli-out-doc as character no-undo .
