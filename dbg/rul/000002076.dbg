     3580            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3581                                                           , p-esys-id-list
     3582                                                           , p-cmd-code
     3583                                                           , chr(10)
     3584                                                           , error-status:get-message(1)
     3585                                                           , return-value
     3586                                                           )).
     3587            return 0.
     3588         end.
     3589         delete procedure p-esys-cmd-proc-handle no-error.
     3590         return v-dmp-ord-int64.
     3591      end.
     3592      else do:
     3593         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     3594                                                       , p-esys-id-list
     3595                                                       , p-cmd-code
     3596                                                       , chr(10)
     3597                                                       , error-status:get-message(1)
     3598                                                       , return-value
     3599                                                       )).
