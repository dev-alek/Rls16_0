     3524   function context_begin-esys-command return logical
     3525   (
     3526       input p-esys-id-list as character
     3527      ,input-output p-esys-cmd-proc-handle as handle
     3528      ,output p-esys-cmd-code as integer
     3529   ):
     3530      if not valid-handle(p-esys-cmd-proc-handle )
     3531      then do:
     3532        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     3533        if error-status :error
     3534        then do:
     3535           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     3536                                              "&5&4&6"
     3537                                              ,vss-workfile
     3538                                              ,vss-revision
     3539                                              ,vss-description
     3540                                              ,chr(10)
     3541                                              ,error-status:get-message(1)
     3542                                              ,return-value )).
     3543        end.
     3544        run begin-create-command in p-esys-cmd-proc-handle
     3545          (input 'cmd-esys-general':U
     3546          ,input p-esys-id-list
     3547          ,output p-esys-cmd-code
     3548          ) no-error.
     3549        if error-status :error
     3550        then do:
     3551          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     3552                                                           , 'cmd-esys-general':U
     3553                                                           , error-status:get-message(1)
     3554                                                           , return-value
     3555                                                           )).
     3556          return no .
     3557        end.
     3558        return yes.
     3559      end.
     3560   end.
     3561   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3562   function context_send-esys-command return int64
     3563   (
     3564       input p-esys-id-list as character
     3565      ,input p-esys-cmd-proc-handle as handle
     3566      ,input p-esys-cmd-code as integer
     3567      ,input p-user-id as character
     3568   ):
