     5340   run fltfield-add in this-procedure('script-al', 'Термин', '',
     5341   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5342   run fltfield-add in this-procedure('script-nl', 'Перевод', '',
     5343   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5344   run fltfield-add in this-procedure('language', 'Язык', '',
     5345   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5346   run fltfield-add in this-procedure('entry-id', '№ статьи', '',
     5347   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5348   Filter-Block:
     5349   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5350       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5351       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5352     run gbl/filter.w ( INPUT parparentproc
     5353                      , INPUT filter-point + chr(4) + filter-point-label
     5354                      , INPUT tbl
     5355                      , INPUT join-tbl
     5356                      , INPUT fld
     5357                      , INPUT lab
     5358                      , INPUT spr
     5359                      , INPUT dim ).
     5360     RUN OpenBr IN THIS-PROCEDURE (INPUT yes
     5361                                  ,INPUT no
     5362                                  ,INPUT '':U).
     5363   end.
     5364   END PROCEDURE.
     5365   PROCEDURE proc-find-script-al :
     5366   define input parameter p-next as logical no-undo.
     5367   define input parameter p-script-al AS CHARACTER no-undo.
     5368   define input parameter p-find-option as character no-undo .
     5369   define variable old-word-script-al as character no-undo .
     5370   define variable old-word-script-nl as character no-undo .
     5371   define variable v-w-script-name as character no-undo .
     5372   assign
     5373   frame Dialog-Frame f-script-al.
     5374   if rs-find-nl = "begins" then
     5375   display
     5376   "":U @ f-script-nl
     5377   with frame Dialog-Frame.
     5378   assign
     5379   p-script-al = replace(p-script-al, chr(34), "":U)
     5380   p-script-al = replace(p-script-al, chr(39), chr(39) + chr(39))
     5381   v-w-script-name = p-script-al
     5382   p-script-al = chr(34) + p-script-al + chr(34).
     5383   CASE p-find-option:
     5384     WHEN "begins" THEN DO:
     5385       old-word-script-al = p-word-script-al.
     5386       p-word-script-al = '':U.
     5387       v-doc-rec = ?.
     5388       if old-word-script-al <> p-word-script-al
     5389       then do:
     5390         run OpenBr in this-procedure
     5391             (input yes
     5392             ,input no
     5393             ,input '':U
     5394             ).
     5395       end.
     5396       run OpenBr in this-procedure
     5397           (input false
     5398           ,input p-next
     5399           ,input substitute("and X_ruledict.script-al begins &1 "
     5400             , p-script-al)
     5401           ).
     5402     end.
     5403     when "contains":U then do:
     5404       p-word-script-al = v-w-script-name.
     5405           run OpenBr in this-procedure
     5406               (input yes
     5407               ,input NO
     5408               ,input '':U
     5409               ).
     5410     END.
     5411   end case.
     5412   apply "entry":u to f-script-al in frame Dialog-Frame .
     5413   END PROCEDURE.
     5414   PROCEDURE proc-find-script-nl :
     5415   define input parameter p-next as logical no-undo.
     5416   define input parameter p-script-nl AS CHARACTER no-undo.
     5417   define input parameter p-find-option as character no-undo .
     5418   define variable old-word-script-nl as character no-undo .
     5419   define variable old-word-script-al as character no-undo .
     5420   define variable v-w-script-name as character no-undo .
     5421   assign
     5422   frame Dialog-Frame f-script-nl.
     5423   if rs-find-al = "begins" then
     5424   display
     5425   "":U @ f-script-al
     5426   with frame Dialog-Frame.
