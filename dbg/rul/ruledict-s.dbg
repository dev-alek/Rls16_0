     5428   p-script-nl = replace(p-script-nl, chr(34), "":U)
     5429   p-script-nl = replace(p-script-nl, chr(39), chr(39) + chr(39))
     5430   v-w-script-name = p-script-nl
     5431   p-script-nl = chr(34) + p-script-nl + chr(34).
     5432   CASE p-find-option:
     5433     WHEN "begins" THEN DO:
     5434       old-word-script-nl = p-word-script-nl.
     5435       p-word-script-nl = '':U.
     5436       v-doc-rec = ?.
     5437       if old-word-script-nl <> p-word-script-nl
     5438       then do:
     5439         run OpenBr in this-procedure
     5440             (input yes
     5441             ,input no
     5442             ,input '':U
     5443             ).
     5444       end.
     5445       run OpenBr in this-procedure
     5446           (input false
     5447           ,input p-next
     5448           ,input substitute("and X_ruledict.script-nl begins &1 "
     5449             , p-script-nl)
     5450           ).
     5451     end.
     5452     when "contains":U then do:
     5453       p-word-script-nl = v-w-script-name.
     5454           run OpenBr in this-procedure
     5455               (input yes
     5456               ,input NO
     5457               ,input '':U
     5458               ).
     5459     END.
     5460   end case.
     5461   apply "entry":u to f-script-nl in frame Dialog-Frame .
     5462   END PROCEDURE.
     5463   PROCEDURE set-row-color :
     5464   DEFINE INPUT PARAMETER p-ruledict-type AS character.
     5465   DEFINE VARIABLE iFGColor AS INTEGER NO-UNDO.
     5466   DEFINE VARIABLE iBGColor AS INTEGER NO-UNDO.
     5467   CASE p-ruledict-type:
     5468     WHEN 'constant':U THEN DO:
     5469       ASSIGN
     5470       iFGColor = WHITE_COLOR
     5471       iBGColor = DARK_GREEN_COLOR
     5472       .
     5473     end.
     5474     when 'operator':U then do:
     5475       ASSIGN
     5476       iFGColor = WHITE_COLOR
     5477       iBGColor = BLUE_COLOR
     5478       .
     5479     end.
     5480     when 'control':U then do:
     5481       ASSIGN
     5482       iFGColor = WHITE_COLOR
     5483       iBGColor = YELLOW_COLOR
     5484       .
     5485     end.
     5486     when 'prop-name_':U
     5487     or
     5488     when 'prop-name_host':U
     5489     or
     5490     when 'prop-name_obj':U
     5491     then do:
     5492       ASSIGN
     5493       iFGColor = BLACK_COLOR
     5494       iBGColor = BLUE_COLOR
     5495       .
     5496     end.
     5497     when 'node-name_':U
     5498     or
     5499     when 'node-name_host':U
     5500     or
     5501     when 'node-name_obj':U
     5502     then do:
     5503       ASSIGN
     5504         iFGColor = BLACK_COLOR
     5505         iBGColor = GREY_COLOR
     5506       .
     5507     end.
     5508     when 'prop-script':U then do:
     5509       ASSIGN
     5510         iFGColor = BLACK_COLOR
     5511         iBGColor = RED_COLOR
     5512       .
     5513     end.
     5514     when 'sum-id':U then do:
     5515       ASSIGN
     5516         iFGColor = RED_COLOR
     5517         iBGColor = WHITE_COLOR
     5518       .
     5519     end.
     5520     when 'sum-id':U then do:
     5521       ASSIGN
     5522         iFGColor = DARK_GREEN_COLOR
     5523         iBGColor = WHITE_COLOR
     5524       .
     5525     end.
     5526     when 'rule':U then do:
     5527       ASSIGN
     5528         iFGColor = RED_COLOR
     5529         iBGColor = WHITE_COLOR
     5530       .
     5531     end.
     5532     when 'datatype':U then do:
     5533       ASSIGN
     5534         iFGColor = BLACK_COLOR
     5535         iBGColor = GREEN_COLOR
     5536       .
     5537     end.
     5538     otherwise do:
     5539       ASSIGN
     5540         iFGColor = Black_COLOR
     5541         iBGColor = White_COLOR
     5542       .
     5543     end.
     5544   END CASE.
     5545   ASSIGN
     5546   X_ruledict.entry-type:FGCOLOR IN BROWSE br-ruledict = iFGColor
     5547   X_ruledict.entry-type:BGCOLOR IN BROWSE br-ruledict = iBGColor
     5548   .
     5549   END PROCEDURE.
