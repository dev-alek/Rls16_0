     5175   PROCEDURE proc-b-link :
     5176   define variable v-rid-list as character no-undo .
     5177   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     5178   define variable v-rec as recid no-undo .
     5179   define variable v-dtm-code as integer no-undo .
     5180   define variable v-node-code as integer no-undo .
     5181   define variable v-language as character no-undo .
     5182   define variable v-script-name as character no-undo .
     5183   define variable v-dt-code as integer no-undo .
     5184   define variable v-revis-id as integer no-undo .
     5185   define variable v-rule-id as integer no-undo .
     5186   define variable v-field-list as character no-undo .
     5187   define variable v-value-list as character no-undo .
     5188   define buffer buf_ruledict-param for ub.ruledict-param.
     5189   CASE p-option:
     5190     WHEN 'ruledict-param':U THEN DO:
     5191       find first buf_ruledict-param no-lock where
     5192                 buf_ruledict-param.entry-id = X_ruledict.entry-id no-error.
     5193       if not available buf_ruledict-param then do:
     5194         message
     5195         "Нет параметров!"
     5196         view-as alert-box error .
     5197         undo, return error .
     5198       end.
     5199       run rul/ruledict-param-s.w ( INPUT parparentproc
     5200                                 ,input ?
     5201                                 ,INPUT "":U
     5202                                 ,INPUT "entry-id"
     5203                                 ,INPUT X_ruledict.entry-id
     5204                                 ,input X_ruledict.entry-type
     5205                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     5206     END.
     5207     WHEN "uniq-key-rec" then do:
     5208       CASE X_ruledict.entry-type:
     5209         WHEN 'constant':U
     5210         or when 'operator':U
     5211         or when 'control':U
     5212         THEN DO:
     5213           MESSAGE
     5214           "Нет просмотра!"
     5215           VIEW-AS ALERT-BOX WARNING.
     5216           RETURN NO-APPLY.
     5217         END.
     5218         when 'prop-name_':U
     5219         or
     5220         when 'prop-name_host':U
     5221         or
     5222         when 'prop-name_obj':U
     5223         then do:
     5224           run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
     5225                                             ,output v-field-list
     5226                                             ,output v-value-list).
     5227           v-dtm-code = integer(entry(lookup("dtm-code":U
     5228                                               , v-field-list
     5229                                               , chr(3))
     5230                                         , v-value-list, chr(3))).
     5231           run rul/prop-head-i.w ( input parparentproc
     5232                                  ,input 'ПРОСМОТР':U
     5233                                  ,input v-dtm-code
     5234                                  ,input-output v-rec ) no-error.
     5235         end.
     5236         when 'node-name_':U
     5237         or
     5238         when 'node-name_host':U
     5239         or
     5240         when 'node-name_obj':U
     5241         then do:
     5242           run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
     5243                                             ,output v-field-list
     5244                                             ,output v-value-list).
     5245           assign
     5246           v-dtm-code = integer(entry(lookup("dtm-code":U
     5247                                               , v-field-list
     5248                                               , chr(3))
     5249                                         , v-value-list, chr(3)))
     5250           v-node-code = integer(entry(lookup("node-code":U
     5251                                               , v-field-list
     5252                                               , chr(3))
     5253                                         , v-value-list, chr(3))).
     5254           run rul/prop-map-i.w ( input parparentproc
     5255                                  ,input 'ПРОСМОТР':U
     5256                                  ,input v-dtm-code
     5257                                  ,input v-node-code
     5258                                  ,input-output v-rec ) no-error.
     5259         end.
     5260         when 'prop-script':U
     5261         or
     5262         when 'datatype':U
     5263         then do:
     5264           run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
     5265                                             ,output v-field-list
     5266                                             ,output v-value-list).
     5267           assign
     5268           v-dtm-code = integer(entry(lookup("dtm-code":U
     5269                                               , v-field-list
     5270                                               , chr(3))
     5271                                         , v-value-list, chr(3)))
     5272           v-language = entry(lookup("language":U
     5273                                               , v-field-list
     5274                                               , chr(3))
     5275                                         , v-value-list, chr(3))
     5276           v-script-name = entry(lookup("script-name":U
     5277                                               , v-field-list
     5278                                               , chr(3))
     5279                                         , v-value-list, chr(3))
     5280           v-revis-id = integer(entry(lookup("revis_id":U
     5281                                               , v-field-list
     5282                                               , chr(3))
     5283                                         , v-value-list, chr(3))) no-error.
     5284           run rul/prop-script-i.w ( input parparentproc
     5285                                  ,input 'ПРОСМОТР':U
     5286                                  ,input v-dtm-code
     5287                                  ,input v-language
     5288                                  ,input v-script-name
     5289                                  ,input v-revis-id
     5290                                  ,input-output v-rec ) no-error.
     5291         end.
     5292         when 'sum-id':U then do:
     5293           run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
     5294                                             ,output v-field-list
     5295                                             ,output v-value-list).
     5296           assign
     5297           v-dt-code = integer(entry(lookup("dt-code":U
     5298                                               , v-field-list
     5299                                               , chr(3))
     5300                                         , v-value-list, chr(3)))
     5301           v-dtm-code = integer(entry(lookup("dtm-code":U
     5302                                               , v-field-list
     5303                                               , chr(3))
     5304                                         , v-value-list, chr(3)))
     5305                                         .
     5306           run rul/prop-ref-i.w ( input parparentproc
     5307                                  ,input 'ПРОСМОТР':U
     5308                                  ,input v-dtm-code
     5309                                  ,input v-dt-code
     5310                                  ,input '':U
     5311                                  ,input-output v-rec ) no-error.
     5312         end.
     5313         when 'rule':U then do:
     5314           run gen-key-fv in this-procedure ( input X_ruledict.uniq-key-rec
     5315                                             ,output v-field-list
     5316                                             ,output v-value-list).
     5317           assign
     5318           v-rule-id = integer(entry(lookup("rule_id":U
     5319                                               , v-field-list
     5320                                               , chr(3))
     5321                                         , v-value-list, chr(3))).
     5322           run rul/rule-i.w ( input parparentproc
     5323                                  ,input 'ПРОСМОТР':U
     5324                                  ,input v-rule-id
     5325                                  ,input-output v-rec ) no-error.
     5326         end.
     5327       END CASE.
     5328     END.
     5329   END CASE.
     5330   END PROCEDURE.
     5331   PROCEDURE proc-b-sch :
     5332   assign
     5333     tbl = 'ruledict'
     5334     join-tbl = 'X_ruledict'
     5335     fld = ""
     5336     lab = ""
     5337     spr = ""
     5338     dim = '0'
