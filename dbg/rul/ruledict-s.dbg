     3010         assign
     3011         parameter-2-18 = (if p-find-next then "true":u else "false":u )
     3012         parameter-4-18 =
     3013           "where ":u + " true " + " ":u + where-phrase-18 + " ":u + p-find-condition + " " + ""
     3014         parameter-5-18 = "  "
