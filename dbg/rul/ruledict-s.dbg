        1   DEFINE BUFFER X_ruledict FOR ub.ruledict.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo.
        4   define input parameter p-list-mode as character no-undo .
        5   define input parameter p-entry-type as character no-undo .
        6   define input parameter p-uniq-key-rec as character no-undo .
        7   define input-output parameter p-rid-list as character no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Словарь Rule-машины".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      369   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      370   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      371   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      372   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      373   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      374   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      375   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      376   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      377   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      378   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      379   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      380   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      381   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      382   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      383   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      384   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      385   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386     define variable v-cntxt-db-num        as integer   no-undo .
      387     define variable v-cntxt-userid        as character no-undo .
      388     define variable v-cntxt-level         as character no-undo .
      389     define variable v-cntxt-host-code-obj as integer   no-undo .
      390     define variable v-cntxt-obj-type      as character no-undo .
      391     define variable v-cntxt-obj-code      as integer   no-undo .
      392     define variable v-cntxt-db-num-obj    as integer   no-undo .
      393     define variable v-cntxt-is-admin      as logical   no-undo .
      394   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   procedure gen-key-rec :
      396     define input  parameter p-tbl-name    as character no-undo.
      397     define input  parameter p-bh_tbl-name as handle    no-undo.
      398     define output parameter p-key-rec     as character no-undo.
      399     do
      400     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      401     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      402     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      403     :
      404       define variable fh               as handle    no-undo .
      405       define variable v-ok             as logical   no-undo .
      406       define variable v-inform         as character no-undo .
      407       define variable v-ind            as integer   no-undo .
      408       define variable v-idx-field-qnty as integer   no-undo .
      409       if p-tbl-name = ?
      410         or p-tbl-name = "":U
      411       then do:
      412         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      413       end.
      414       if not p-bh_tbl-name:available then do:
      415         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      416       end.
      417       assign
      418         p-key-rec = p-tbl-name
      419         v-inform  = p-bh_tbl-name:index-information(1)
      420         v-ind     = 2
      421       .
      422       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      423       on error undo, return error
      424       :
      425         assign
      426           v-inform = p-bh_tbl-name:index-information( v-ind )
      427           v-ind    = v-ind + 1
      428         .
      429       end.
      430       if v-inform = ?
      431         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      432         or entry( 3, v-inform, ",":U ) <> "1":U
      433       then do:
      434         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      435       end.
      436       else do:
      437         assign
      438           v-idx-field-qnty = num-entries( v-inform ) - 4
      439         .
      440         if v-idx-field-qnty < 2 then do:
      441           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      442         end.
      443         do v-ind = 1 to v-idx-field-qnty by 2
      444         on error undo, return error
      445         :
      446           assign
      447             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      448             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      449           .
      450         end.
      451       end.
      452       if p-key-rec = ? then do:
      453         assign
      454           p-key-rec = "":U
      455         .
      456         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      457       end.
      458     end.
      459     return.
      460   end procedure.
      461   procedure gen-where-keyr-tab :
      462     define input  parameter i-tableSerach as character no-undo.
      463     define input  parameter i-tablekey   as character  no-undo.
      464     define input  parameter p-key-rec    as character  no-undo.
      465     define input  parameter p-key-handle as handle     no-undo .
      466     define input  parameter p-db-name    as character  no-undo .
      467     define input  parameter p-tt-handle  as handle     no-undo .
      468     define output parameter o-Where      as character  no-undo.
      469     do
      470     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      471     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      472     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      473     :
      474       define variable v-full-tbl-name  as character no-undo .
      475       define variable bh_tbl-name      as handle    no-undo .
      476       define variable fh_key           as handle    no-undo .
      477       define variable fh_search        as handle    no-undo .
      478       define variable v-field-num      as integer   no-undo .
      479       define variable v-count-fld      as integer   no-undo .
      480       define variable v-inform         as character no-undo .
      481       define variable v-ind            as integer   no-undo .
      482       define variable v-idx-field-qnty as integer   no-undo .
      483       define variable v-field-name     as character no-undo .
      484       define variable v-field-val      as character no-undo .
      485       define variable v-word-link      as character no-undo .
      486       define variable vTable           as character no-undo.
      487       define variable bh_tbl-key       as handle    no-undo .
      488       assign
      489         p-key-rec = trim( p-key-rec )
      490       .
      491       if p-key-handle <> ? then do:
      492         if not valid-handle(p-key-handle)
      493            or p-key-handle:type <> "buffer"
      494         then do:
      495           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      496         end.
      497         if num-entries( p-key-rec, chr(3) ) > 1
      498           or p-key-rec = ?
      499           or p-key-rec = "":U
      500         then do:
      501           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      502         end.
      503       end.
      504       else do:
      505         if p-key-rec = ?
      506           or p-key-rec = "":U
      507         then do:
      508           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      509         end.
      510       end.
      511       assign
      512         vTable = entry( 1 , p-key-rec, chr(3) )
      513       .
      514       if p-tt-handle <> ?
      515         and ( not valid-handle(p-tt-handle)
      516               or p-tt-handle:type <> "buffer"
      517             )
      518       then do:
      519         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      520       end.
      521       if p-tt-handle = ? then do:
      522         assign
      523           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      524         .
      525         create buffer bh_tbl-name for table v-full-tbl-name .
      526       end.
      527       else do:
      528         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      529       end.
      530       assign
      531         v-inform = bh_tbl-name:index-information(1)
      532         v-ind    = 2
      533       .
      534       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      535       on error undo, return error
      536       :
      537         assign
      538           v-inform = bh_tbl-name:index-information( v-ind )
      539           v-ind    = v-ind + 1
      540         .
      541       end.
      542       if v-inform = ?
      543         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      544         or entry( 3, v-inform, ",":U ) <> "1":U
      545       then do:
      546         delete object bh_tbl-name no-error.
      547         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      548       end.
      549       assign
      550         v-idx-field-qnty = num-entries( v-inform ) - 4
      551       .
      552       if v-idx-field-qnty < 2 then do:
      553         delete object bh_tbl-name no-error.
      554         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      555       end.
      556       assign
      557         o-where     = "where":U
      558         v-word-link = "":U
      559         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      560         v-count-fld = 0
      561       .
      562       if i-tablekey ne "" and i-tablekey ne ?
      563       then do:
      564         assign
      565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      566         .
      567         create buffer bh_tbl-key for table v-full-tbl-name .
      568       end.
      569       if i-tableSerach ne "" and i-tableSerach ne ?
      570       then do:
      571         delete object bh_tbl-name no-error.
      572         assign
      573           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      574         .
      575         create buffer bh_tbl-name for table v-full-tbl-name .
      576       end.
      577       block_where:
      578       do v-ind = 1 to v-idx-field-qnty by 2
      579       on error undo, return error
      580       :
      581         assign
      582           v-count-fld = v-count-fld + 1
      583         .
      584         if p-key-handle = ?
      585           and v-count-fld > v-field-num
      586         then do:
      587           leave block_where.
      588         end.
      589         define variable VfieldKeyTable as handle no-undo.
      590         assign
      591           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      592           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      593         .
      594         if     bh_tbl-key ne ?
      595         then do:
      596            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      597            if VfieldKeyTable eq ?
      598            then next block_where.
      599         end.
      600         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      601         then
      602            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      603         else
      604            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      605         if p-key-handle = ? then do:
      606           assign
      607             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      608           .
      609         end.
      610         else do:
      611           assign
      612             fh_key = p-key-handle:buffer-field( v-field-name )
      613           .
      614           if fh_key = ?
      615             or not valid-handle( fh_key )
      616           then do:
      617             delete object bh_tbl-name.
      618             if     bh_tbl-key ne ?
      619             then
      620                delete object bh_tbl-key.
      621             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      622           end.
      623           assign
      624             v-field-val = fh_key:buffer-value
      625           .
      626         end.
      627         if fh_search:data-type ="character":U then do:
      628           assign
      629             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      630             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      631             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      632             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      633             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      634             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      635             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      636             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      637             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      638             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      639             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      640             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      641             v-field-val = substitute( '"&1"', v-field-val )
      642           .
      643         end.
      644         assign
      645           o-where = substitute( "&1 &2", o-where, v-field-val )
      646         .
      647         if v-word-link = "":U then do:
      648           assign
      649             v-word-link = "and":U
      650           .
      651         end.
      652       end.
      653       delete object bh_tbl-name.
      654       if     bh_tbl-key ne ?
      655       then
      656          delete object bh_tbl-key.
      657       if p-key-handle = ?
      658         and v-count-fld <> v-field-num
      659       then do:
      660         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      661       end.
      662     end.
      663   end procedure.
      664   procedure gen-hn-keyr-tab :
      665     define input  parameter i-tableSerach as character no-undo.
      666     define input  parameter i-tablekey   as character no-undo.
      667     define input  parameter p-key-rec    as character no-undo.
      668     define input  parameter p-key-handle as handle    no-undo .
      669     define input  parameter p-db-name    as character no-undo .
      670     define input  parameter p-tt-handle  as handle    no-undo .
      671     define input  parameter p-stts-lock  as integer   no-undo .
      672     define output parameter o-hn         as handle    no-undo.
      673     define variable v-full-tbl-name as character no-undo.
      674     define variable v-where         as character no-undo.
      675     define variable bh_tbl-name     as handle    no-undo.
      676     define variable vTable          as character no-undo.
      677     do
      678     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      679     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      680     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      681         run gen-where-keyr-tab(i-tableSerach,
      682                                i-tablekey,
      683                                p-key-rec,
      684                                p-key-handle,
      685                                p-db-name,
      686                                p-tt-handle,
      687                                output v-where).
      688         if i-tableSerach ne "" and i-tableSerach ne ?
      689         then do:
      690            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      691            create buffer bh_tbl-name for table v-full-tbl-name .
      692         end.
      693         else do:
      694            if p-tt-handle = ? then do:
      695               assign
      696                  vTable = entry( 1 , p-key-rec, chr(3) )
      697               .
      698               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      699               create buffer bh_tbl-name for table v-full-tbl-name .
      700            end.
      701            else do:
      702               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      703            end.
      704         end.
      705         if p-tt-handle = ? then do:
      706            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      707         end.
      708         else do:
      709            bh_tbl-name:find-first( v-where ) no-error .
      710         end.
      711         o-hn = bh_tbl-name.
      712      end.
      713   end procedure.
      714   procedure gen-hn-keyr :
      715     define input  parameter p-key-rec    as character no-undo.
      716     define input  parameter p-key-handle as handle    no-undo .
      717     define input  parameter p-db-name    as character no-undo .
      718     define input  parameter p-tt-handle  as handle    no-undo .
      719     define input  parameter p-stts-lock  as integer   no-undo .
      720     define output parameter o-hn         as handle    no-undo.
      721     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      722   end.
      723   procedure gen-row-keyr :
      724     define input  parameter p-key-rec    as character no-undo.
      725     define input  parameter p-key-handle as handle    no-undo .
      726     define input  parameter p-db-name    as character no-undo .
      727     define input  parameter p-tt-handle  as handle    no-undo .
      728     define input  parameter p-stts-lock  as integer   no-undo .
      729     define output parameter p-tbl-row    as rowid     no-undo.
      730     define output parameter p-tbl-name   as character no-undo.
      731     define variable vHn as handle no-undo.
      732       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      733       p-tbl-row = if vHn:available then vHn:rowid else ?.
      734       p-tbl-name =  vHn:table.
      735       delete object vHn no-error.
      736     if p-tbl-row = ? then do:
      737       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      738     end.
      739     else do:
      740       return.
      741     end.
      742   end procedure.
      743   procedure gen-key-fv :
      744     define input  parameter p-key-rec    as character no-undo .
      745     define output parameter p-field-list as character no-undo .
      746     define output parameter p-value-list as character no-undo.
      747     do
      748     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      749     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      750     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      751     :
      752       define variable v-full-tbl-name  as character no-undo .
      753       define variable bh_tbl-name      as handle    no-undo .
      754       define variable v-tbl-name       as character no-undo .
      755       define variable v-field-num      as integer   no-undo .
      756       define variable v-count-fld      as integer   no-undo .
      757       define variable v-inform         as character no-undo .
      758       define variable v-ind            as integer   no-undo .
      759       define variable v-idx-field-qnty as integer   no-undo .
      760       define variable v-delim-key      as character no-undo .
      761       if p-key-rec = ?
      762         or p-key-rec = "":U
      763       then do:
      764         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      765       end.
      766       assign
      767         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      768         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      769       .
      770       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      771       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      772       assign
      773         v-inform = bh_tbl-name:index-information(1)
      774         v-ind    = 2
      775       .
      776       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      777       on error undo, return error
      778       :
      779         assign
      780           v-inform = bh_tbl-name:index-information( v-ind )
      781           v-ind    = v-ind + 1
      782         .
      783       end.
      784       if v-inform = ?
      785         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      786         or entry( 3, v-inform, ",":U ) <> "1":U
      787       then do:
      788         delete object bh_tbl-name no-error.
      789         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      790       end.
      791       assign
      792         v-idx-field-qnty = num-entries( v-inform ) - 4
      793       .
      794       if v-idx-field-qnty < 2 then do:
      795         delete object bh_tbl-name no-error.
      796         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      797       end.
      798       assign
      799         p-field-list = "":U
      800         p-value-list = "":U
      801         v-delim-key  = "":U
      802         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      803         v-count-fld  = 0
      804       .
      805       block_where:
      806       do v-ind = 1 to v-idx-field-qnty by 2
      807       on error undo, return error
      808       :
      809         assign
      810           v-count-fld = v-count-fld + 1
      811         .
      812         if v-count-fld > v-field-num then do:
      813           leave block_where.
      814         end.
      815         assign
      816           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      817           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      818         .
      819         if v-ind = 1 then do:
      820           assign
      821             v-delim-key = chr(3)
      822           .
      823         end.
      824       end.
      825       delete object bh_tbl-name.
      826       if v-count-fld <> v-field-num then do:
      827         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      828       end.
      829     end.
      830   end procedure.
      831   procedure gen-key-field :
      832     define input  parameter p-table      as character no-undo .
      833     define output parameter p-field-list as character no-undo .
      834     do
      835     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      836     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      837     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      838     :
      839       define variable v-full-tbl-name  as character no-undo .
      840       define variable bh_tbl-name      as handle    no-undo .
      841       define variable v-tbl-name       as character no-undo .
      842       define variable v-field-num      as integer   no-undo .
      843       define variable v-count-fld      as integer   no-undo .
      844       define variable v-inform         as character no-undo .
      845       define variable v-ind            as integer   no-undo .
      846       define variable v-idx-field-qnty as integer   no-undo .
      847       define variable v-delim-key      as character no-undo .
      848       if p-table = ?
      849         or p-table = "":U
      850       then do:
      851         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      852       end.
      853       assign
      854         v-tbl-name      = p-table
      855         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      856       .
      857       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      858       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      859       assign
      860         v-inform = bh_tbl-name:index-information(1)
      861         v-ind    = 2
      862       .
      863       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      864       on error undo, return error
      865       :
      866         assign
      867           v-inform = bh_tbl-name:index-information( v-ind )
      868           v-ind    = v-ind + 1
      869         .
      870       end.
      871       if v-inform = ?
      872         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      873         or entry( 3, v-inform, ",":U ) <> "1":U
      874       then do:
      875         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      876       end.
      877       assign
      878         v-idx-field-qnty = num-entries( v-inform ) - 4
      879       .
      880       if v-idx-field-qnty < 2 then do:
      881         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      882       end.
      883       assign
      884         p-field-list = "":U
      885         v-delim-key  = "":U
      886         v-count-fld  = 0
      887       .
      888       block_where:
      889       do v-ind = 1 to v-idx-field-qnty by 2
      890       on error undo, return error
      891       :
      892         assign
      893           v-count-fld = v-count-fld + 1
      894         .
      895         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      896         if v-ind = 1 then do:
      897           assign
      898             v-delim-key = chr(3)
      899           .
      900         end.
      901       end.
      902       delete object bh_tbl-name.
      903     end.
      904   end procedure.
      905   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   FUNCTION mark-string RETURNS CHARACTER
      907     ( input p-recid as recid, input mark-list as character  ) :
      908     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      909   END FUNCTION.
      910   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   define variable c-point  as character no-undo .
      912   define variable tbl      as character no-undo .
      913   define variable join-tbl as character no-undo .
      914   define variable fld      as character no-undo .
      915   define variable lab      as character no-undo .
      916   define variable spr      as character no-undo .
      917   define variable dim      as character no-undo .
      918   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   procedure fltfield-clear :
      920     define output parameter loc-fld as character no-undo.
      921     define output parameter loc-lab as character no-undo .
      922     define output parameter loc-spr as character no-undo .
      923     define output parameter loc-dim as character no-undo .
      924     assign
      925       loc-fld = ""
      926       loc-lab = ""
      927       loc-spr = ""
      928       loc-dim = "0"
      929     .
      930   end procedure .
      931   procedure fltfield-add :
      932     define input        parameter par-fld as character no-undo.
      933     define input        parameter par-lab as character no-undo .
      934     define input        parameter par-spr as character no-undo .
      935     define input-output parameter loc-fld as character no-undo.
      936     define input-output parameter loc-lab as character no-undo .
      937     define input-output parameter loc-spr as character no-undo .
      938     define input-output parameter loc-dim as character no-undo .
      939     do
      940     on error undo, return error
      941     :
      942       assign
      943       loc-fld = if loc-dim = '0'
      944                 then par-fld
      945                 else (loc-fld + chr(44) + par-fld)
      946       loc-lab = if loc-dim = '0'
      947                 then par-lab
      948                 else (loc-lab + chr(44) + par-lab)
      949       loc-spr = if loc-dim = '0'
      950                 then par-spr
      951                 else (loc-spr + chr(44) + par-spr)
      952       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      953                 string(integer(if num-entries(loc-dim) > 1
      954                               then entry(2, loc-dim)
      955                               else entry(1, loc-dim)
      956                               ) + 1)
      957       no-error
      958       .
      959     end.
      960   end procedure.
      961   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      963   procedure fltopend_fltopend :
      964   define input parameter p-parent-handle as handle no-undo .
      965   define input parameter p-qh as handle no-undo .
      966   define input parameter p-flt-open-open-query  as character no-undo .
      967   define input parameter p-where-cond as character no-undo .
      968   define input parameter p-use-indFIRST-query-tail as character no-undo .
      969   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      970   define input parameter p-indexed-reposition as character no-undo .
      971     do
      972     on error undo, return error
      973     :
      974   define variable v-prepare-string as character no-undo .
      975   define variable glog as logical no-undo .
      976   assign
      977   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      978                      p-where-cond + chr(32)  +
      979                      p-use-indFIRST-query-tail + chr(32) +
      980                      p-use-ind-sort-clmn-by + chr(32) +
      981                      p-indexed-reposition
      982   .
      983   assign
      984   glog = p-qh:query-prepare(v-prepare-string) no-error .
      985   if not glog
      986   or error-status:error then do:
      987     message error-status:get-message(1) view-as alert-box .
      988     undo, return error .
      989   end.
      990   assign
      991   glog = p-qh:query-open no-error .
      992   if not glog
      993   or error-status:error then do:
      994     message error-status:get-message(1) view-as alert-box .
      995     undo, return error .
      996   end.
      997     end.
      998   end procedure.
      999   procedure fltopend_fltfindd :
     1000   define input parameter p-parent-handle as handle no-undo .
     1001   define input parameter p-qh as handle no-undo .
     1002   define input parameter p-rowid as rowid no-undo .
     1003   define input parameter p-next as logical no-undo .
     1004   define input parameter p-lock as integer no-undo .
     1005   define input parameter p-bh as handle no-undo .
     1006   define input parameter p-where-cond as character no-undo .
     1007   define input parameter p-use-index-phrase as character no-undo .
     1008   define variable glog as logical no-undo .
     1009   define variable v-qh as handle no-undo .
     1010   define variable v-bh as handle no-undo .
     1011   define variable v-recid as recid no-undo .
     1012   define variable v-prepare-string as character no-undo .
     1013   do
     1014   on error undo, return error
     1015   on stop undo, return error
     1016   :
     1017     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1018     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1019     create query v-qh.
     1020     v-qh:set-buffers(v-bh).
     1021     v-prepare-string = substitute("for each &1 &2 &3"
     1022                                     ,v-bh:name
     1023                                     ,p-where-cond
     1024                                     ,p-use-index-phrase).
     1025     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1026     if not glog then do:
     1027       delete object v-qh.
     1028       delete object v-bh.
     1029       undo, return error .
     1030     end.
     1031     glog = v-qh:query-open no-error .
     1032     if not glog then do:
     1033       delete object v-qh.
     1034       delete object v-bh.
     1035       undo, return error .
     1036     end.
     1037     if p-next then do:
     1038       v-qh:reposition-to-rowid(p-rowid) no-error .
     1039       glog = v-qh:get-next( p-lock) no-error .
     1040       glog = v-qh:get-next( p-lock) no-error .
     1041       if not glog or v-qh:query-off-end = yes then do:
     1042         glog = v-qh:get-first( p-lock) no-error .
     1043       end.
     1044     end.
     1045     else do:
     1046       glog = v-qh:get-first( p-lock) no-error .
     1047     end.
     1048     v-recid = v-bh:recid no-error .
     1049     delete object v-qh.
     1050     delete object v-bh.
     1051     return string(v-recid) .
     1052   end.
     1053   end procedure.
     1054   procedure fltopend_fltfindq :
     1055   define input parameter p-parent-handle as handle no-undo .
     1056   define input parameter p-qh as handle no-undo .
     1057   define input parameter p-next as logical no-undo .
     1058   define input parameter p-lock as integer no-undo .
     1059   define input parameter p-flt-open-open-query  as character no-undo .
     1060   define input parameter p-where-cond as character no-undo .
     1061   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1062   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1063   define input parameter p-indexed-reposition as character no-undo .
     1064   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1065   define variable glog as logical no-undo .
     1066   define variable v-qh as handle no-undo .
     1067   define variable v-bh as handle no-undo extent 18.
     1068   define variable v-rowid as rowid no-undo extent 18.
     1069   define variable v-ii as integer no-undo .
     1070   define variable v-prepare-string as character no-undo .
     1071   do
     1072   on error undo, return error
     1073   on stop undo, return error
     1074   :
     1075     create query v-qh.
     1076     do v-ii = 1 to p-qh:num-buffers:
     1077       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1078       assign
     1079       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1080       no-error.
     1081       v-qh:add-buffer(v-bh[v-ii]).
     1082     end.
     1083     assign
     1084     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1085                       p-where-cond + chr(32)  +
     1086                       p-use-indFIRST-query-tail + chr(32) +
     1087                       p-use-ind-sort-clmn-by + chr(32) +
     1088                       p-indexed-reposition
     1089     .
     1090     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1091     if not glog then do:
     1092       delete object v-qh.
     1093       do v-ii = 1 to p-qh:num-buffers:
     1094         delete object v-bh[v-ii].
     1095       end.
     1096       undo, return error .
     1097     end.
     1098     glog = v-qh:query-open no-error .
     1099     if not glog then do:
     1100       delete object v-qh.
     1101       do v-ii = 1 to p-qh:num-buffers:
     1102         delete object v-bh[v-ii].
     1103       end.
     1104       undo, return error .
     1105     end.
     1106     if p-next then do:
     1107       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1108       glog = v-qh:get-next( p-lock) no-error .
     1109       glog = v-qh:get-next( p-lock) no-error .
     1110       if not glog or v-qh:query-off-end = yes then do:
     1111         glog = v-qh:get-first( p-lock) no-error .
     1112       end.
     1113     end.
     1114     else do:
     1115       glog = v-qh:get-first( p-lock) no-error .
     1116     end.
     1117     do v-ii = 1 to p-qh:num-buffers:
     1118       assign
     1119       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1120       no-error.
     1121     end.
     1122     delete object v-qh.
     1123     do v-ii = 1 to p-qh:num-buffers:
     1124       delete object v-bh[v-ii].
     1125     end.
     1126   end.
     1127   end procedure.
     1128   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1129   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
     1130   define variable sort-column-name as character no-undo .
     1131   define variable filter-point-label as character no-undo init "Словарь RULE-машины" .
     1132   define variable filter-point0 as character no-undo init "ruledict-s" .
     1133   define variable filter-point as character no-undo init "ruledict-s" .
     1134   define variable p-word-script-al as character no-undo .
     1135   define variable p-word-script-nl as character no-undo .
     1136   define variable v-rid-list as character no-undo .
     1137   DEFINE MENU MENU-b-links
     1138          MENU-ITEM m_ruledict-param LABEL "Параметры"
     1139          MENU-ITEM m_correspondent LABEL "Корреспондент" .
     1140   DEFINE BUTTON b-add
     1141        LABEL "&Добавить"
     1142        SIZE 10 BY 1.
     1143   DEFINE BUTTON b-chg
     1144        LABEL "&Изменить"
     1145        SIZE 10 BY 1.
     1146   DEFINE BUTTON b-copy
     1147        LABEL "&Копировать"
     1148        SIZE 10 BY 1.
     1149   DEFINE BUTTON b-del
     1150        LABEL "&Удалить"
     1151        SIZE 10 BY 1.
     1152   DEFINE BUTTON B-Help
     1153        LABEL "Помо&щь"
     1154        SIZE 3 BY 1
     1155        BGCOLOR 8 .
     1156   DEFINE BUTTON b-links
     1157        LABEL "Связи"
     1158        SIZE 10 BY 1.
     1159   DEFINE BUTTON b-lkp
     1160        LABEL "&Просмотр"
     1161        SIZE 10 BY 1.
     1162   DEFINE BUTTON b-mark
     1163        LABEL "&*"
     1164        SIZE 4 BY 1.
     1165   DEFINE BUTTON b-quit AUTO-END-KEY
     1166        LABEL "&Выход"
     1167        SIZE 10 BY 1
     1168        BGCOLOR 8 .
     1169   DEFINE BUTTON b-sch
     1170        LABEL "&Фильтр"
     1171        SIZE 3 BY 1.
     1172   DEFINE BUTTON b-sel AUTO-GO
     1173        LABEL "Выбор"
     1174        SIZE 10 BY 1.
     1175   DEFINE BUTTON b-uniq-key-rec
     1176        LABEL "Связать"
     1177        SIZE 10 BY 1.
     1178   DEFINE VARIABLE cb-entry-type AS CHARACTER FORMAT "X(256)":U
     1179        VIEW-AS COMBO-BOX INNER-LINES 10
     1180        LIST-ITEMS "Item 1"
     1181        DROP-DOWN-LIST
     1182        SIZE 97.5 BY 1 NO-UNDO.
     1183   DEFINE VARIABLE f-script-al AS CHARACTER FORMAT "X(256)":U
     1184        LABEL "Термин"
     1185        VIEW-AS FILL-IN
     1186        SIZE 65 BY 1 NO-UNDO.
     1187   DEFINE VARIABLE f-script-nl AS CHARACTER FORMAT "X(256)":U
     1188        LABEL "Перевод"
     1189        VIEW-AS FILL-IN
     1190        SIZE 65 BY 1 NO-UNDO.
     1191   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1192         VIEW-AS TEXT
     1193        SIZE 9 BY .67
     1194        FGCOLOR 10  NO-UNDO.
     1195   DEFINE VARIABLE rs-find-al AS CHARACTER INITIAL "begins"
     1196        VIEW-AS RADIO-SET HORIZONTAL
     1197        RADIO-BUTTONS
     1198             "Нач.назв.", "begins",
     1199   "Нач.слова", "contains"
     1200        SIZE 23 BY 1 NO-UNDO.
     1201   DEFINE VARIABLE rs-find-nl AS CHARACTER INITIAL "begins"
     1202        VIEW-AS RADIO-SET HORIZONTAL
     1203        RADIO-BUTTONS
     1204             "Нач.назв.", "begins",
     1205   "Нач.слова", "contains"
     1206        SIZE 23 BY 1 NO-UNDO.
     1207   DEFINE  QUERY br-ruledict FOR
     1208                   X_ruledict SCROLLING.
     1209   DEFINE BROWSE br-ruledict
     1210     QUERY br-ruledict NO-LOCK DISPLAY
     1211         mark-string(recid(X_ruledict), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1212   X_ruledict.entry-id COLUMN-LABEL "ID" FORMAT "->>>>>>>>9"
     1213   X_ruledict.entry-type COLUMN-LABEL "Тип" FORMAT "X(16)"
     1214   X_ruledict.script-al COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
     1215   X_ruledict.script-nl COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
     1216   X_ruledict.uniq-key-rec COLUMN-LABEL "Корреспондент" FORMAT "X(255)" WIDTH 60
     1217       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 16.54 FIT-LAST-COLUMN.
     1218   DEFINE FRAME Dialog-Frame
     1219        b-quit AT ROW 1 COL 1
     1220        b-mark AT ROW 1 COL 24 WIDGET-ID 12
     1221        b-sel AT ROW 1 COL 28 WIDGET-ID 10
     1222        b-add AT ROW 1 COL 38 WIDGET-ID 2
     1223        b-chg AT ROW 1 COL 48 WIDGET-ID 4
     1224        b-del AT ROW 1 COL 58 WIDGET-ID 8
     1225        b-lkp AT ROW 1 COL 68 WIDGET-ID 6
     1226        b-links AT ROW 1 COL 78 WIDGET-ID 16
     1227        b-sch AT ROW 1 COL 92 WIDGET-ID 20
     1228        B-Help AT ROW 1 COL 95
     1229        b-copy AT ROW 2 COL 38 WIDGET-ID 62
     1230        b-uniq-key-rec AT ROW 2 COL 58 WIDGET-ID 60
     1231        cb-entry-type AT ROW 3 COL 1 NO-LABEL WIDGET-ID 18
     1232        rs-find-al AT ROW 4 COL 1.5 NO-LABEL WIDGET-ID 52
     1233        f-script-al AT ROW 4 COL 25.5 WIDGET-ID 22
     1234        rs-find-nl AT ROW 5 COL 1.5 NO-LABEL WIDGET-ID 56
     1235        f-script-nl AT ROW 5 COL 24.5 WIDGET-ID 24
     1236        br-ruledict AT ROW 6 COL 1.5 WIDGET-ID 100
     1237        mark-num AT ROW 1 COL 13 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1238        SPACE(74.50) SKIP(21.20)
     1239       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1240            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1241            TITLE ""
     1242            CANCEL-BUTTON b-quit.
     1243   ASSIGN
     1244          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1245          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1246   ASSIGN
     1247          b-links:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-links:HANDLE.
     1248   ON GO OF FRAME Dialog-Frame
     1249   DO:
     1250     p-rid-list = v-rid-list.
     1251   END.
     1252   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1253   DO:
     1254     APPLY "END-ERROR":U TO SELF.
     1255   END.
     1256   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1257   DO:
     1258    define variable v-rec as recid no-undo.
     1259   run rul/ruledict-i.w ( input parparentproc
     1260                          ,input 'ДОБАВЛЕНИЕ':U
     1261                          ,input (if p-list-mode = "entry-type" then p-entry-type else '':U)
     1262                          ,input 0
     1263                          ,input-output v-rec) no-error.
     1264     if v-rec <> ? then do:
     1265       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1266       reposition br-ruledict to recid v-rec no-error.
     1267       apply "entry" to br-ruledict.
     1268     end.
     1269   END.
     1270   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1271   DO:
     1272     define variable v-rec as recid no-undo.
     1273     if not available X_ruledict then return no-apply.
     1274     v-rec = recid(X_ruledict).
     1275     run rul/ruledict-i.w ( input parparentproc
     1276                          ,input 'ИЗМЕНЕНИЕ':U
     1277                          ,input X_ruledict.entry-type
     1278                          ,input X_ruledict.entry-id
     1279                          ,input-output v-rec) no-error.
     1280     if v-rec <> ? then do:
     1281        br-ruledict:refresh().
     1282     end.
     1283   END.
     1284   ON CHOOSE OF b-copy IN FRAME Dialog-Frame
     1285   DO:
     1286    define variable v-rec as recid no-undo.
     1287     if not available X_ruledict then return no-apply.
     1288     v-rec = recid(X_ruledict).
     1289     run rul/ruledict-i.w ( input parparentproc
     1290                          ,input 'КОПИРОВАНИЕ':U
     1291                          ,input (if p-list-mode = "entry-type" then p-entry-type else '':U)
     1292                          ,input X_ruledict.entry-id
     1293                          ,input-output v-rec) no-error.
     1294     if v-rec <> ? then do:
     1295       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1296       reposition br-ruledict to recid v-rec no-error.
     1297       apply "entry" to br-ruledict.
     1298     end.
     1299   END.
     1300   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1301   DO:
     1302     define variable v-rec as recid no-undo.
     1303     define variable glog as logical no-undo.
     1304     if not available X_ruledict then return no-apply.
     1305     v-rec = recid(X_ruledict).
     1306     message "Вы уверены, что хотите удалить термин из словаря?"
     1307     view-as alert-box question buttons yes-no update glog.
     1308     if not glog then return no-apply.
     1309     run rul/ruledict3.p (
     1310                          input no
     1311                         ,input v-rec
     1312                         ) no-error.
     1313    if error-status:error then return no-apply.
     1314    run OpenBr in this-procedure ( input yes, input no, input '':U).
     1315   END.
     1316   ON CHOOSE OF b-links IN FRAME Dialog-Frame
     1317   DO:
     1318   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1319     IF NOT AVAILABLE X_ruledict THEN RETURN NO-APPLY.
     1320   IF link-option = '':U THEN DO:
     1321     run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1322     if error-status :error then do: return no-apply. end.
     1323   END.
     1324   if link-option = "":U then do:
     1325      return no-apply.
     1326   end.
     1327   RUN proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1328   IF ERROR-STATUS:ERROR THEN DO:
     1329     link-option = '':U.
     1330     RETURN NO-APPLY.
     1331    END.
     1332   link-option = '':U.
     1333   END.
     1334   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1335   DO:
     1336     define variable v-rec as recid no-undo.
     1337     if not available X_ruledict then return no-apply.
     1338     v-rec = recid(X_ruledict).
     1339     run rul/ruledict-i.w ( input parparentproc
     1340                          ,input 'ПРОСМОТР':U
     1341                          ,input X_ruledict.entry-type
     1342                          ,input X_ruledict.entry-id
     1343                          ,input-output v-rec) no-error.
     1344   END.
     1345   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1346   DO:
     1347      define variable glog as logical no-undo .
     1348     if available X_ruledict then do:
     1349   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1350   define variable v-str-recid10 as character no-undo .
     1351   define variable v-num-entry10 as integer   no-undo .
     1352   assign
     1353     v-str-recid10 = trim( string( recid( X_ruledict ) , "->>>>>>>>>>>9":U ) )
     1354     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1355   .
     1356   if v-num-entry10 > 0 then do:
     1357     assign
     1358       entry( v-num-entry10, v-rid-list ) = "":U
     1359       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1360     .
     1361   end.
     1362   else do:
     1363     assign
     1364       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1365     .
     1366   end.
     1367     glog = br-ruledict:refresh() .
     1368     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1369         glog = br-ruledict:select-next-row ().
     1370         apply "VALUE-CHANGED" to br-ruledict in frame Dialog-Frame.
     1371     end.
     1372     if num-entries( v-rid-list ) = 0
     1373     then
     1374         hide mark-num in frame Dialog-Frame.
     1375     else
     1376         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1377   end.
     1378   apply "entry" to br-ruledict in frame Dialog-Frame.
     1379   END.
     1380   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1381   DO:
     1382     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1383     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1384   END.
     1385   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1386   DO:
     1387     if available X_ruledict then do:
     1388       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1389       then  v-rid-list = string( recid( X_ruledict ) ) .
     1390     end.
     1391   END.
     1392   ON CHOOSE OF b-uniq-key-rec IN FRAME Dialog-Frame
     1393   DO:
     1394    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1395    define variable v-rec as recid no-undo .
     1396    DEFINE BUFFER buf_prop-script FOR ub.prop-script.
     1397    IF NOT AVAILABLE X_ruledict THEN RETURN NO-APPLY.
     1398    v-rec = recid(X_ruledict).
     1399   run rul/prop-script-s.w (
     1400                      input parparentproc
     1401                      ,INPUT 'b-sel'
     1402                     ,INPUT 'все':U
     1403                     ,INPUT '':U
     1404                     ,INPUT 0
     1405                     ,INPUT "":U
     1406                     ,INPUT "":U
     1407                     ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1408   IF NOT ERROR-STATUS:ERROR
     1409   AND v-rid-list <> '':U THEN DO:
     1410     FIND FIRST buf_prop-script NO-LOCK WHERE
     1411         RECID(buf_prop-script) = INTEGER(v-rid-list) NO-ERROR .
     1412     IF NOT AVAILABLE buf_prop-script THEN RETURN NO-APPLY.
     1413     run rul/ruledict4.p ( INPUT NO
     1414                      ,INPUT RECID(X_ruledict)
     1415                      ,INPUT buf_prop-script.uniq-key-rec) no-error .
     1416     if not error-status:error then do:
     1417       RUN openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1418       reposition br-ruledict to recid v-rec no-error.
     1419       apply "entry" to br-ruledict.
     1420     end.
     1421   END.
     1422   END.
     1423   ON VALUE-CHANGED OF cb-entry-type IN FRAME Dialog-Frame
     1424   DO:
     1425     ASSIGN cb-entry-type.
     1426     RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     1427   END.
     1428   ON CTRL-J OF f-script-al IN FRAME Dialog-Frame
     1429   DO:
     1430     run proc-find-script-al in this-procedure ( input YES
     1431                                               , input frame Dialog-Frame f-script-al
     1432                                               , input rs-find-al) no-error.
     1433     if error-status:error then return no-apply.
     1434   END.
     1435   ON RETURN OF f-script-al IN FRAME Dialog-Frame
     1436   DO:
     1437       run proc-find-script-al in this-procedure ( input NO
     1438                                                 , input frame Dialog-Frame f-script-al
     1439                                                 , input rs-find-al) no-error.
     1440     if error-status:error then return no-apply.
     1441   END.
     1442   ON CTRL-J OF f-script-nl IN FRAME Dialog-Frame
     1443   DO:
     1444       run proc-find-script-nl in this-procedure ( input YES
     1445                                                 , input frame Dialog-Frame f-script-nl
     1446                                                 , input rs-find-nl) no-error.
     1447     if error-status:error then return no-apply.
     1448   END.
     1449   ON RETURN OF f-script-nl IN FRAME Dialog-Frame
     1450   DO:
     1451       run proc-find-script-nl in this-procedure ( input NO
     1452                                                 , input frame Dialog-Frame f-script-nl
     1453                                                 , input rs-find-al) no-error.
     1454     if error-status:error then return no-apply.
     1455   END.
     1456   ON CHOOSE OF MENU-ITEM m_correspondent
     1457   DO:
     1458       IF NOT AVAILABLE X_ruledict THEN RETURN NO-APPLY.
     1459     RUN proc-b-link IN THIS-PROCEDURE ( INPUT "uniq-key-rec") NO-ERROR.
     1460     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1461   END.
     1462   ON CHOOSE OF MENU-ITEM m_ruledict-param
     1463   DO:
     1464    IF NOT AVAILABLE X_ruledict THEN RETURN NO-APPLY.
     1465    RUN proc-b-link IN THIS-PROCEDURE ( INPUT 'ruledict-param':U) NO-ERROR.
     1466    IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1467   END.
     1468   ON VALUE-CHANGED OF rs-find-al IN FRAME Dialog-Frame
     1469   DO:
     1470     ASSIGN
     1471     rs-find-al.
     1472     apply "ENTRY" to f-script-al.
     1473   END.
     1474   ON VALUE-CHANGED OF rs-find-nl IN FRAME Dialog-Frame
     1475   DO:
     1476     ASSIGN
     1477     rs-find-nl.
     1478     apply "ENTRY" to f-script-nl.
     1479   END.
     1480   ON ROW-DISPLAY OF br-ruledict IN frame Dialog-Frame
     1481   DO:
     1482     IF AVAIL X_ruledict THEN DO:
     1483       RUN set-row-color IN this-procedure  ( INPUT X_ruledict.entry-type).
     1484     END.
     1485   END.
     1486   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1487   on f5 of frame Dialog-Frame anywhere
     1488   do:
     1489      v-doc-rec = recid(X_ruledict).    RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-ruledict to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-ruledict.
     1490       apply "VALUE-CHANGED" to br-ruledict.
     1491   end.
     1492   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1493   procedure set-filter-name :
     1494   define input parameter p-filter-name as character no-undo .
     1495     do with frame Dialog-Frame:
     1496       if p-filter-name > "" then do:
     1497         assign
     1498           frame Dialog-Frame:title
     1499             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1500         .
     1501         assign
     1502           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1503         .
     1504       end.
     1505       else do:
     1506         assign
     1507           b-sch :tooltip = ""
     1508         .
     1509       end.
     1510     end.
     1511   end procedure.
     1512   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   on help of frame Dialog-Frame
     1514   do:
     1515     run gbl/app_help.p
     1516       (input this-procedure :file-name
     1517       ,input ''
     1518       ,input ?
     1519       ) no-error.
     1520     if error-status :error then do:
     1521       message
     1522         "Ошибка при вызове помощи"
     1523         error-status :get-message(1)
     1524         view-as alert-box .
     1525     end.
     1526   end.
     1527   run minbtn-set in this-procedure .
     1528   on choose of b-help in frame Dialog-Frame
     1529   do:
     1530     apply "help":u to frame Dialog-Frame .
     1531   end.
     1532   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1533   procedure minbtn-set :
     1534       do
     1535           on error undo, return error return-value
     1536           :
     1537           define variable ii              as integer       no-undo .
     1538           define variable fh              as widget-handle no-undo .
     1539           define variable hh              as widget-handle no-undo .
     1540           define variable v-h             as handle        extent 4 no-undo .
     1541           define variable v-name-button   as character     no-undo .
     1542           define variable v-help-old-x    as decimal       no-undo .
     1543           define variable v-help-old-y    as decimal       no-undo .
     1544           define variable v-help-old-size as decimal       no-undo .
     1545           define variable v-frame-width   as decimal       no-undo .
     1546           define variable jj              as integer       no-undo .
     1547           do
     1548               on error undo, return error
     1549               :
     1550               assign
     1551                   v-frame-width = frame Dialog-Frame:width - 0.3
     1552                   fh            = frame Dialog-Frame:first-child
     1553                   hh            = fh:first-child
     1554                   ii            = 1
     1555                   .
     1556               do while valid-handle(hh):
     1557                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1558                   do:
     1559                       case lc(hh:name) :
     1560                           when "b-help" then
     1561                               do:
     1562                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1563                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1564                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1565                                   hh:TOOLTIP = "Помощь" .
     1566                                   v-help-old-x = hh:column .
     1567                                   v-help-old-y = hh:row    .
     1568                                   v-help-old-size = hh:width .
     1569                                   hh:width-chars = 2.5 .
     1570                               end.
     1571                           when "b-print" then
     1572                               do:
     1573                                   hh:load-image("cmp/b-print.bmp":u) .
     1574                                   hh:TOOLTIP = "Печать" .
     1575                                   v-h[ii] = hh:handle .
     1576                                   ii = ii + 1 .
     1577                                   hh:width-chars = 3 .
     1578                               end.
     1579                           when "b-history" or
     1580                           when "b-hist" then
     1581                               do:
     1582                                   hh:load-image("cmp/b-hist.bmp":u) .
     1583                                   hh:TOOLTIP = "История" .
     1584                                   v-h[ii] = hh:handle .
     1585                                   ii = ii + 1 .
     1586                                   hh:width-chars = 3 .
     1587                               end.
     1588                           when "b-sch" then
     1589                               do:
     1590                                   hh:load-image("cmp/b-sch.bmp":u) .
     1591                                   hh:TOOLTIP = "Установка Фильтра" .
     1592                                   v-h[ii] = hh:handle .
     1593                                   ii = ii + 1 .
     1594                                   hh:width-chars = 3 .
     1595                               end.
     1596                           when "b-hist-user" then
     1597                               do:
     1598                                   hh:load-image("cmp/b-hist.bmp":u) .
     1599                                   hh:TOOLTIP = "История пользователя" .
     1600                                   ii = ii + 1 .
     1601                               end.
     1602                       end case.
     1603                   end.
     1604                   hh = hh:next-sibling.
     1605               end.
     1606               b-help:column = v-frame-width - b-help:width-chars.
     1607               jj = 0.
     1608               repeat ii = 4 to 1 by -1 :
     1609                   if valid-handle (v-h[ii] ) then
     1610                   do:
     1611                       jj  = jj + 1 .
     1612                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1613                       v-h[ii]:row    = v-help-old-y .
     1614                   end.
     1615               end.
     1616           end.
     1617       end.
     1618   end procedure.
     1619   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1620   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1621   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1622   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1623   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1624   define variable v-diasize-current-frame-height as decimal   no-undo .
     1625   define variable v-diasize-change-size          as logical   no-undo .
     1626   define variable v-diasize-resize-button        as handle    no-undo .
     1627   define variable v-diasize-wndmax               as logical   no-undo .
     1628   define variable v-diasize-wndstore             as logical   no-undo .
     1629   define variable v-diasize-proc-name            as character no-undo .
     1630   define variable v-diasize-browse-handle        as handle    no-undo .
     1631   define variable v-diasize-browse-number        as integer   no-undo .
     1632   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1633   define temp-table temp-diasize-handle no-undo
     1634     field handle-value  as handle
     1635     field save-position as decimal
     1636     index xpk is primary unique handle-value
     1637     .
     1638   define temp-table temp-browse-handle no-undo
     1639     field browse-type   as character
     1640     field browse-number as integer
     1641     field browse-handle as handle
     1642     field original-size as decimal
     1643     index xpk is primary unique browse-type browse-number
     1644     index xie browse-type browse-handle
     1645   .
     1646   procedure diasize_change-height :
     1647     define input  parameter p-change-value  as decimal   no-undo .
     1648     define input  parameter p-move-resize   as logical   no-undo .
     1649     define variable v-field-group-handle    as handle    no-undo .
     1650     define variable v-object-handle         as handle    no-undo .
     1651     define variable v-frame-height          as decimal   no-undo .
     1652     define variable v-frame-virtual-height  as decimal   no-undo .
     1653     define variable v-browse-height         as decimal   no-undo .
     1654     define variable v-window-height         as decimal   no-undo .
     1655     define variable v-window-virtual-height as decimal   no-undo .
     1656     define variable v-change-sign           as integer   no-undo .
     1657     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1658     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1659     if p-change-value > 0
     1660     then do:
     1661       if frame Dialog-Frame :height + p-change-value
     1662           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1663       then do:
     1664         assign
     1665           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1666                           - (frame Dialog-Frame :height-chars)
     1667         .
     1668         if p-change-value <= 0
     1669         then do:
     1670           run diasize_position-resize-button in this-procedure .
     1671           return .
     1672         end.
     1673       end.
     1674     end.
     1675     if p-change-value < 0
     1676     then do:
     1677       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1678       then do:
     1679         assign
     1680           p-change-value = v-diasize-orig-frame-height
     1681                          - (frame Dialog-Frame :height-chars)
     1682         .
     1683         if p-change-value >= 0
     1684         then do:
     1685           run diasize_position-resize-button in this-procedure .
     1686           return .
     1687         end.
     1688       end.
     1689     end.
     1690     if p-change-value >= 0
     1691     then do:
     1692       assign
     1693         v-change-sign = 1
     1694       .
     1695     end.
     1696     else do:
     1697       assign
     1698         v-change-sign = -1
     1699       .
     1700     end.
     1701     assign
     1702       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1703     .
     1704     if p-change-value = 0
     1705     then do:
     1706       run diasize_position-resize-button in this-procedure .
     1707       return .
     1708     end.
     1709     move_block:
     1710     do
     1711     on error undo move_block, retry move_block
     1712     :
     1713       if retry
     1714       then do:
     1715         do
     1716         on error undo move_block, leave move_block
     1717         :
     1718           if p-change-value > 0
     1719           then do:
     1720             for each buf_temp-diasize-handle
     1721             on error undo, next
     1722             :
     1723               assign
     1724                 v-object-handle = buf_temp-diasize-handle.handle-value
     1725               .
     1726               if v-object-handle <> v-diasize-resize-button
     1727               then do:
     1728                 assign
     1729                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1730                 .
     1731               end.
     1732             end.
     1733             assign
     1734               v-diasize-browse-handle :height = v-browse-height
     1735             .
     1736             for each buf_temp-browse-handle
     1737               where buf_temp-browse-handle.browse-type = 'height':u
     1738             on error undo, next
     1739             :
     1740               assign
     1741                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1742               .
     1743             end.
     1744             assign
     1745               frame Dialog-Frame :height = v-frame-height
     1746             .
     1747             if frame Dialog-Frame :scrollable = true
     1748             then do:
     1749               assign
     1750                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1751               .
     1752             end.
     1753             run diasize_position-resize-button in this-procedure .
     1754           end.
     1755           else do:
     1756             if frame Dialog-Frame :scrollable = true
     1757             then do:
     1758               assign
     1759                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1760               .
     1761             end.
     1762             assign
     1763               frame Dialog-Frame :height = v-frame-height
     1764             .
     1765             assign
     1766               v-diasize-browse-handle :height = v-browse-height
     1767             .
     1768             for each buf_temp-browse-handle
     1769               where buf_temp-browse-handle.browse-type = 'height':u
     1770             on error undo, next
     1771             :
     1772               assign
     1773                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1774               .
     1775             end.
     1776             for each buf_temp-diasize-handle
     1777             on error undo, next
     1778             :
     1779               assign
     1780                 v-object-handle = buf_temp-diasize-handle.handle-value
     1781               .
     1782               if v-object-handle <> v-diasize-resize-button
     1783               then do:
     1784                 assign
     1785                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1786                 .
     1787               end.
     1788             end.
     1789             run diasize_position-resize-button in this-procedure .
     1790           end.
     1791           assign
     1792             v-diasize-change-size = false
     1793           .
     1794           leave move_block .
     1795         end.
     1796       end.
     1797       assign
     1798         v-diasize-need-full-display = true
     1799       .
     1800       if v-diasize-change-size = false
     1801       then do:
     1802         assign
     1803           v-diasize-change-size = true
     1804         .
     1805       end.
     1806       else do:
     1807         return .
     1808       end.
     1809       assign
     1810         v-frame-height = frame Dialog-Frame :height
     1811         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1812         v-browse-height = v-diasize-browse-handle :height
     1813       .
     1814       for each buf_temp-browse-handle
     1815         where buf_temp-browse-handle.browse-type = 'height':u
     1816       :
     1817         assign
     1818           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1819         .
     1820       end.
     1821       for each buf_temp-diasize-handle
     1822       :
     1823         delete buf_temp-diasize-handle .
     1824       end.
     1825       assign
     1826         v-field-group-handle = frame Dialog-Frame :first-child
     1827       .
     1828       do while valid-handle(v-field-group-handle)
     1829       :
     1830         assign
     1831           v-object-handle = v-field-group-handle :first-child
     1832         .
     1833         do while valid-handle(v-object-handle)
     1834         :
     1835           if  v-object-handle <> v-diasize-browse-handle :handle
     1836           and can-query(v-object-handle, "row")
     1837           and can-query(v-object-handle, "height")
     1838           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1839           then do:
     1840             find first buf_temp-browse-handle
     1841               where buf_temp-browse-handle.browse-type   = 'height':u
     1842                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1843               no-error .
     1844             if available buf_temp-browse-handle
     1845             then do:
     1846             end.
     1847             else do:
     1848               create buf_temp-diasize-handle .
     1849               assign
     1850                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1851                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1852               .
     1853             end.
     1854           end.
     1855           assign
     1856             v-object-handle = v-object-handle :next-sibling
     1857           .
     1858         end.
     1859         assign
     1860           v-field-group-handle = v-field-group-handle :next-sibling
     1861         .
     1862       end.
     1863       do with frame Dialog-Frame
     1864       :
     1865         hide v-diasize-resize-button .
     1866         assign
     1867           v-diasize-resize-button :row    = 1
     1868           v-diasize-resize-button :column = 1
     1869         .
     1870       end.
     1871       if p-change-value > 0
     1872       then do:
     1873         if frame Dialog-Frame :scrollable = true
     1874         then do:
     1875           assign
     1876             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1877             no-error .
     1878           if error-status :error
     1879           or error-status :get-message(1) <> ""
     1880           then do:
     1881             undo move_block, retry move_block .
     1882           end.
     1883         end.
     1884         assign
     1885           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1886           no-error .
     1887         if error-status :error
     1888         or error-status :get-message(1) <> ""
     1889         then do:
     1890           undo move_block, retry move_block .
     1891         end.
     1892         assign
     1893           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1894           no-error .
     1895         if error-status :error
     1896         or error-status :get-message(1) <> ""
     1897         then do:
     1898           undo move_block, retry move_block .
     1899         end.
     1900         for each buf_temp-browse-handle
     1901           where buf_temp-browse-handle.browse-type = 'height':u
     1902         on error undo move_block, retry move_block
     1903         :
     1904           assign
     1905             buf_temp-browse-handle.browse-handle :height
     1906               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1907             no-error .
     1908           if error-status :error
     1909           or error-status :get-message(1) <> ""
     1910           then do:
     1911             undo move_block, retry move_block .
     1912           end.
     1913         end.
     1914         for each buf_temp-diasize-handle
     1915         on error undo move_block, retry move_block
     1916         :
     1917           assign
     1918             v-object-handle = buf_temp-diasize-handle.handle-value
     1919           .
     1920           if v-object-handle <> v-diasize-resize-button
     1921           then do:
     1922             assign
     1923               v-object-handle :row = v-object-handle :row + p-change-value
     1924               no-error .
     1925             if error-status :error
     1926             or error-status :get-message(1) <> ""
     1927             then do:
     1928               undo move_block, retry move_block .
     1929             end.
     1930           end.
     1931         end.
     1932       end.
     1933       else do:
     1934         for each buf_temp-diasize-handle
     1935         on error undo move_block, retry move_block
     1936         :
     1937           assign
     1938             v-object-handle = buf_temp-diasize-handle.handle-value
     1939           .
     1940           if v-object-handle <> v-diasize-resize-button
     1941           then do:
     1942             assign
     1943               v-object-handle :row = v-object-handle :row + p-change-value
     1944               no-error .
     1945             if error-status :error
     1946             or error-status :get-message(1) <> ""
     1947             then do:
     1948               undo move_block, retry move_block .
     1949             end.
     1950           end.
     1951         end.
     1952         assign
     1953           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1954           no-error .
     1955         if error-status :error
     1956         or error-status :get-message(1) <> ""
     1957         then do:
     1958           undo move_block, retry move_block .
     1959         end.
     1960         for each buf_temp-browse-handle
     1961           where buf_temp-browse-handle.browse-type = 'height':u
     1962         on error undo move_block, retry move_block
     1963         :
     1964           assign
     1965             buf_temp-browse-handle.browse-handle :height
     1966               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1967             no-error .
     1968           if error-status :error
     1969           or error-status :get-message(1) <> ""
     1970           then do:
     1971             undo move_block, retry move_block .
     1972           end.
     1973         end.
     1974         assign
     1975           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1976           no-error .
     1977         if error-status :error
     1978         or error-status :get-message(1) <> ""
     1979         then do:
     1980           undo move_block, retry move_block .
     1981         end.
     1982         if frame Dialog-Frame :scrollable = true
     1983         then do:
     1984           assign
     1985             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1986             no-error .
     1987           if error-status :error
     1988           or error-status :get-message(1) <> ""
     1989           then do:
     1990             undo move_block, retry move_block .
     1991           end.
     1992         end.
     1993       end.
     1994       if p-move-resize = true
     1995       then do:
     1996         run diasize_position-resize-button in this-procedure .
     1997       end.
     1998       if v-diasize-wndstore = true
     1999       then do:
     2000         if connected("ub") = true
     2001         then do:
     2002           define variable v-cntxt-db-num        as integer   no-undo .
     2003           define variable v-cntxt-userid        as character no-undo .
     2004           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2005                                             , OUTPUT v-cntxt-userid
     2006                                             ) .
     2007           run gbl/wndsizew.p
     2008             (input  v-cntxt-db-num
     2009             ,input  v-cntxt-userid
     2010             ,input  v-diasize-proc-name
     2011             ,input  'height':u
     2012             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2013             ) .
     2014         end.
     2015       end.
     2016     end.
     2017     assign
     2018       v-diasize-change-size = false
     2019     .
     2020   end procedure.
     2021   procedure diasize_set-height :
     2022     define input  parameter p-new-height  as decimal   no-undo .
     2023     define input  parameter p-move-resize as logical   no-undo .
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       run diasize_change-height in this-procedure
     2028         (input  (p-new-height - frame Dialog-Frame :height)
     2029         ,input  p-move-resize
     2030         ) .
     2031     end.
     2032   end procedure.
     2033   procedure diasize_change-width :
     2034     define input  parameter p-change-value as decimal   no-undo .
     2035     define input  parameter p-move-resize  as logical   no-undo .
     2036     define variable v-field-group-handle   as handle    no-undo .
     2037     define variable v-object-handle        as handle    no-undo .
     2038     define variable v-frame-width          as decimal   no-undo .
     2039     define variable v-frame-virtual-width  as decimal   no-undo .
     2040     define variable v-browse-width         as decimal   no-undo .
     2041     define variable v-window-width         as decimal   no-undo .
     2042     define variable v-window-virtual-width as decimal   no-undo .
     2043     define variable v-change-sign          as integer   no-undo .
     2044     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2045     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2046     if p-change-value > 0
     2047     then do:
     2048       if frame Dialog-Frame :width + p-change-value >
     2049           session :width-chars
     2050       then do:
     2051         assign
     2052           p-change-value = session :width-chars - frame Dialog-Frame :width
     2053         .
     2054         if p-change-value <= 0
     2055         then do:
     2056           run diasize_position-resize-button in this-procedure .
     2057           return .
     2058         end.
     2059       end.
     2060     end.
     2061     if p-change-value < 0
     2062     then do:
     2063       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2064       then do:
     2065         assign
     2066           p-change-value = v-diasize-orig-frame-width
     2067                          - frame Dialog-Frame :width
     2068         .
     2069         if p-change-value >= 0
     2070         then do:
     2071           run diasize_position-resize-button in this-procedure .
     2072           return .
     2073         end.
     2074       end.
     2075     end.
     2076     if p-change-value >= 0
     2077     then do:
     2078       assign
     2079         v-change-sign = 1
     2080       .
     2081     end.
     2082     else do:
     2083       assign
     2084         v-change-sign = -1
     2085       .
     2086     end.
     2087     assign
     2088       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2089     .
     2090     if p-change-value = 0
     2091     then do:
     2092       run diasize_position-resize-button in this-procedure .
     2093       return .
     2094     end.
     2095     move_block:
     2096     do
     2097     on error undo move_block, leave move_block
     2098     :
     2099       if retry
     2100       then do:
     2101         do
     2102         on error undo move_block, leave move_block
     2103         :
     2104           if p-change-value > 0
     2105           then do:
     2106             for each buf_temp-diasize-handle
     2107             on error undo, next
     2108             :
     2109               assign
     2110                 v-object-handle = buf_temp-diasize-handle.handle-value
     2111               .
     2112               if v-object-handle <> v-diasize-resize-button
     2113               then do:
     2114                 assign
     2115                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2116                 .
     2117               end.
     2118             end.
     2119             assign
     2120               v-diasize-browse-handle :width = v-browse-width
     2121             .
     2122             for each buf_temp-browse-handle
     2123               where buf_temp-browse-handle.browse-type = 'width':u
     2124             on error undo, next
     2125             :
     2126               assign
     2127                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2128               .
     2129             end.
     2130             assign
     2131               frame Dialog-Frame :width = v-frame-width
     2132             .
     2133             if frame Dialog-Frame :scrollable = true
     2134             then do:
     2135               assign
     2136                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2137               .
     2138             end.
     2139             run diasize_position-resize-button in this-procedure .
     2140           end.
     2141           else do:
     2142             if frame Dialog-Frame :scrollable = true
     2143             then do:
     2144               assign
     2145                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2146               .
     2147             end.
     2148             assign
     2149               frame Dialog-Frame :width = v-frame-width
     2150             .
     2151             for each buf_temp-browse-handle
     2152               where buf_temp-browse-handle.browse-type = 'width':u
     2153             on error undo, next
     2154             :
     2155               assign
     2156                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2157               .
     2158             end.
     2159             assign
     2160               v-diasize-browse-handle :width = v-browse-width
     2161             .
     2162             for each buf_temp-diasize-handle
     2163             on error undo, next
     2164             :
     2165               assign
     2166                 v-object-handle = buf_temp-diasize-handle.handle-value
     2167               .
     2168               if v-object-handle <> v-diasize-resize-button
     2169               then do:
     2170                 assign
     2171                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2172                 .
     2173               end.
     2174             end.
     2175             run diasize_position-resize-button in this-procedure .
     2176           end.
     2177           assign
     2178             v-diasize-change-size = false
     2179           .
     2180           leave move_block .
     2181         end.
     2182       end.
     2183       assign
     2184         v-diasize-need-full-display = true
     2185       .
     2186       if v-diasize-change-size = false
     2187       then do:
     2188         assign
     2189           v-diasize-change-size = true
     2190         .
     2191       end.
     2192       else do:
     2193         return .
     2194       end.
     2195       assign
     2196         v-frame-width = frame Dialog-Frame :width
     2197         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2198         v-browse-width = v-diasize-browse-handle :width
     2199       .
     2200       for each buf_temp-browse-handle
     2201         where buf_temp-browse-handle.browse-type = 'width':u
     2202       :
     2203         assign
     2204           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2205         .
     2206       end.
     2207       for each buf_temp-diasize-handle
     2208       :
     2209         delete buf_temp-diasize-handle .
     2210       end.
     2211       assign
     2212         v-field-group-handle = frame Dialog-Frame :first-child
     2213       .
     2214       do while valid-handle(v-field-group-handle)
     2215       :
     2216         assign
     2217           v-object-handle = v-field-group-handle :first-child
     2218         .
     2219         do while valid-handle(v-object-handle)
     2220         :
     2221           if  v-object-handle <> v-diasize-browse-handle :handle
     2222           and v-object-handle <> v-diasize-resize-button
     2223           and can-query(v-object-handle, "row")
     2224           and can-query(v-object-handle, "height")
     2225           and ( v-object-handle :col + v-object-handle :width
     2226                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2227               )
     2228           then do:
     2229             find first buf_temp-browse-handle
     2230               where buf_temp-browse-handle.browse-type   = 'width':u
     2231                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2232               no-error .
     2233             if available buf_temp-browse-handle
     2234             then do:
     2235             end.
     2236             else do:
     2237               create buf_temp-diasize-handle .
     2238               assign
     2239                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2240                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2241               .
     2242             end.
     2243           end.
     2244           assign
     2245             v-object-handle = v-object-handle :next-sibling
     2246           .
     2247         end.
     2248         assign
     2249           v-field-group-handle = v-field-group-handle :next-sibling
     2250         .
     2251       end.
     2252       do with frame Dialog-Frame
     2253       :
     2254         hide v-diasize-resize-button .
     2255         v-diasize-resize-button :row = 1.
     2256         v-diasize-resize-button :column = 1.
     2257       end.
     2258       if p-change-value > 0
     2259       then do:
     2260         if frame Dialog-Frame :scrollable = true
     2261         then do:
     2262           assign
     2263             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2264             no-error .
     2265           if error-status :error
     2266           or error-status :get-message(1) <> ""
     2267           then do:
     2268             undo move_block, retry move_block.
     2269           end.
     2270         end.
     2271         assign
     2272           frame Dialog-Frame :width = v-frame-width + p-change-value
     2273           no-error .
     2274         if error-status :error
     2275         or error-status :get-message(1) <> ""
     2276         then do:
     2277           undo move_block, retry move_block.
     2278         end.
     2279         assign
     2280           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2281         no-error .
     2282         if error-status :error
     2283         or error-status :get-message(1) <> ""
     2284         then do:
     2285           undo move_block, retry move_block.
     2286         end.
     2287         for each buf_temp-browse-handle
     2288           where buf_temp-browse-handle.browse-type = 'width':u
     2289         on error undo move_block, retry move_block
     2290         :
     2291           assign
     2292             buf_temp-browse-handle.browse-handle :width
     2293               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2294             no-error .
     2295           if error-status :error
     2296           or error-status :get-message(1) <> ""
     2297           then do:
     2298             undo move_block, retry move_block .
     2299           end.
     2300         end.
     2301         for each buf_temp-diasize-handle
     2302         on error undo move_block, retry move_block
     2303         :
     2304           assign
     2305             v-object-handle = buf_temp-diasize-handle.handle-value
     2306           .
     2307           if v-object-handle <> v-diasize-resize-button
     2308           then do:
     2309             assign
     2310               v-object-handle :col = v-object-handle :col + p-change-value
     2311               no-error .
     2312             if error-status :error
     2313             or error-status :get-message(1) <> ""
     2314             then do:
     2315               undo move_block, retry move_block .
     2316             end.
     2317           end.
     2318         end.
     2319       end.
     2320       else do:
     2321         for each buf_temp-diasize-handle
     2322         on error undo move_block, retry move_block
     2323         :
     2324           assign
     2325             v-object-handle = buf_temp-diasize-handle.handle-value
     2326           .
     2327           if v-object-handle <> v-diasize-resize-button
     2328           then do:
     2329             assign
     2330               v-object-handle :col = v-object-handle :col + p-change-value
     2331               no-error .
     2332             if error-status :error
     2333             or error-status :get-message(1) <> ""
     2334             then do:
     2335               undo move_block, retry move_block .
     2336             end.
     2337           end.
     2338         end.
     2339         for each buf_temp-browse-handle
     2340           where buf_temp-browse-handle.browse-type = 'width':u
     2341         on error undo move_block, retry move_block
     2342         :
     2343           assign
     2344             buf_temp-browse-handle.browse-handle :width
     2345               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2346             no-error .
     2347           if error-status :error
     2348           or error-status :get-message(1) <> ""
     2349           then do:
     2350             undo move_block, retry move_block .
     2351           end.
     2352         end.
     2353         assign
     2354           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2355           no-error .
     2356         if error-status :error
     2357         or error-status :get-message(1) <> ""
     2358         then do:
     2359           undo move_block, retry move_block.
     2360         end.
     2361         assign
     2362           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2363         no-error .
     2364         if error-status :error
     2365         or error-status :get-message(1) <> ""
     2366         then do:
     2367           undo move_block, retry move_block.
     2368         end.
     2369         if frame Dialog-Frame :scrollable = true
     2370         then do:
     2371           assign
     2372             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2373           no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block.
     2378           end.
     2379         end.
     2380       end.
     2381       if p-move-resize
     2382       then do:
     2383         run diasize_position-resize-button in this-procedure .
     2384       end.
     2385       if v-diasize-wndstore = true
     2386       then do:
     2387         if connected("ub") = true
     2388         then do:
     2389           define variable v-cntxt-db-num        as integer   no-undo .
     2390           define variable v-cntxt-userid        as character no-undo .
     2391           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2392                                             , OUTPUT v-cntxt-userid
     2393                                             ) .
     2394           run gbl/wndsizew.p
     2395             (input  v-cntxt-db-num
     2396             ,input  v-cntxt-userid
     2397             ,input  v-diasize-proc-name
     2398             ,input  'width':u
     2399             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2400             ) .
     2401         end.
     2402       end.
     2403     end.
     2404     assign
     2405       v-diasize-change-size = false
     2406     .
     2407   end procedure.
     2408   procedure diasize_set-width :
     2409     define input  parameter p-new-width  as decimal   no-undo .
     2410     define input  parameter p-move-resize as logical   no-undo .
     2411     do
     2412     on error undo, return error return-value
     2413     :
     2414       run diasize_change-width in this-procedure
     2415         (input  (p-new-width - frame Dialog-Frame :width)
     2416         ,input  p-move-resize
     2417         ) .
     2418     end.
     2419   end procedure.
     2420   procedure diasize_position-resize-button :
     2421     do with frame Dialog-Frame
     2422     :
     2423       hide v-diasize-resize-button .
     2424       assign
     2425         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2426                     - 1
     2427                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2428         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2429                     - 1
     2430                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2431       .
     2432       view v-diasize-resize-button .
     2433     end.
     2434   end procedure.
     2435   on alt-right anywhere
     2436   do:
     2437     run diasize_change-width in this-procedure
     2438       (input 1
     2439       ,input true
     2440       ) .
     2441     return no-apply .
     2442   end.
     2443   on alt-left anywhere
     2444   do:
     2445     run diasize_change-width in this-procedure
     2446       (input -1
     2447       ,input true
     2448       ) .
     2449     return no-apply .
     2450   end.
     2451   on alt-down anywhere
     2452   do:
     2453     run diasize_change-height in this-procedure
     2454       (input 1
     2455       ,input true
     2456       ) .
     2457     return no-apply .
     2458   end.
     2459   on alt-up anywhere
     2460   do:
     2461     run diasize_change-height in this-procedure
     2462       (input -1
     2463       ,input true
     2464       ) .
     2465     return no-apply .
     2466   end.
     2467   on alt-enter of frame Dialog-Frame
     2468   do:
     2469     run diasize_maximize in this-procedure
     2470       (input  ?
     2471       ).
     2472     return no-apply .
     2473   end.
     2474   procedure diasize_end-move :
     2475     do
     2476     on error undo, return error return-value
     2477     :
     2478       define variable v-row-delta as decimal   no-undo .
     2479       define variable v-col-delta as decimal   no-undo .
     2480       define variable v-new-row as decimal   no-undo .
     2481       define variable v-new-col as decimal   no-undo .
     2482       assign
     2483         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2484         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2485       .
     2486       assign
     2487         v-row-delta = v-new-row - frame Dialog-Frame :height
     2488         v-col-delta = v-new-col - frame Dialog-Frame :width
     2489       .
     2490       run diasize_change-height in this-procedure
     2491         (input v-row-delta
     2492         ,input true
     2493         ) .
     2494       run diasize_change-width in this-procedure
     2495         (input v-col-delta
     2496         ,input true
     2497         ) .
     2498     end.
     2499   end procedure.
     2500   procedure diasize_maximize :
     2501     define input  parameter p-action as logical   no-undo .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       if p-action = ?
     2506       then do:
     2507         if v-diasize-need-maximize = true
     2508         then do:
     2509           assign
     2510             p-action = true
     2511           .
     2512         end.
     2513         else do:
     2514           assign
     2515             p-action = false
     2516           .
     2517         end.
     2518       end.
     2519       if p-action = true
     2520       then do:
     2521         run diasize_change-height in this-procedure
     2522           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2523               - frame Dialog-Frame :height-chars
     2524           ,input true
     2525           ) .
     2526         run diasize_change-width in this-procedure
     2527           (input session :width-chars
     2528               - frame Dialog-Frame :width-chars
     2529           ,input true
     2530           ) .
     2531         assign
     2532           v-diasize-need-maximize = false
     2533         .
     2534       end.
     2535       else do:
     2536         run diasize_change-width in this-procedure
     2537           (input v-diasize-orig-frame-width
     2538               - frame Dialog-Frame :width-chars
     2539           ,input true
     2540           ) .
     2541         run diasize_change-height in this-procedure
     2542           (input v-diasize-orig-frame-height
     2543               - frame Dialog-Frame :height-chars
     2544           ,input true
     2545           ) .
     2546         assign
     2547           v-diasize-need-maximize = true
     2548         .
     2549       end.
     2550     end.
     2551   end procedure.
     2552   procedure diasize_restore-orig-size :
     2553     do
     2554     on error undo, return error return-value
     2555     :
     2556       assign
     2557         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2558         v-diasize-current-frame-height = frame Dialog-Frame :height
     2559       .
     2560       run diasize_set-height in this-procedure
     2561         (input  v-diasize-orig-frame-height
     2562         ,input  true
     2563         ) .
     2564       run diasize_set-width in this-procedure
     2565         (input  v-diasize-orig-frame-width
     2566         ,input  true
     2567         ) .
     2568     end.
     2569   end procedure.
     2570   procedure diasize_restore-current-size :
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       run diasize_set-height in this-procedure
     2575         (input  v-diasize-current-frame-height
     2576         ,input  true
     2577         ) .
     2578       run diasize_set-width in this-procedure
     2579         (input  v-diasize-current-frame-width
     2580         ,input  true
     2581         ) .
     2582     end.
     2583   end procedure.
     2584   procedure diasize_set-browse-handle :
     2585     define input  parameter p-browse-handle as handle   no-undo .
     2586     define buffer buf_temp-browse-handle for temp-browse-handle .
     2587     do
     2588     on error undo, return error return-value
     2589     :
     2590       assign
     2591         v-diasize-browse-handle = p-browse-handle
     2592       .
     2593       for each buf_temp-browse-handle
     2594       on error undo, return error return-value
     2595       :
     2596         delete buf_temp-browse-handle .
     2597       end.
     2598     end.
     2599   end procedure.
     2600   procedure diasize_add_browse :
     2601     define input  parameter p-browse-type   as character no-undo .
     2602     define input  parameter p-browse-handle as handle    no-undo .
     2603     define buffer buf_temp-browse-handle for temp-browse-handle .
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       assign
     2608         v-diasize-browse-number = v-diasize-browse-number + 1
     2609       .
     2610       create buf_temp-browse-handle .
     2611       assign
     2612         buf_temp-browse-handle.browse-type   = p-browse-type
     2613         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2614         buf_temp-browse-handle.browse-handle = p-browse-handle
     2615       .
     2616     end.
     2617   end procedure.
     2618   procedure diasize_init :
     2619     define variable v-default-value    as logical   no-undo .
     2620     define variable v-restore-saved    as logical   no-undo .
     2621     define variable v-resize-value-str as character no-undo .
     2622     do
     2623     on error undo, return error return-value
     2624     :
     2625       do with frame Dialog-Frame
     2626       :
     2627         assign
     2628           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2629           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2630           v-diasize-browse-handle     = browse br-ruledict :handle
     2631         .
     2632         create button v-diasize-resize-button
     2633         assign
     2634           parent        = frame Dialog-Frame :first-child
     2635           label         = "s"
     2636           height-pixels = 16
     2637           width-pixels  = 16
     2638           visible       = true
     2639           sensitive     = true
     2640           movable       = true
     2641           triggers:
     2642             on end-move persistent run diasize_end-move in this-procedure .
