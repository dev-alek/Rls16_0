     3038             if (" true " + " " + where-phrase-18) <> ""
     3039             then " true " + " " + where-phrase-18
     3040             else "true"
     3041           )
     3042         parameter-5-18 = (" " + "" + " " + "" + " " + p-find-condition)
     3043         parameter-6-18 = if sort-phrase-18 = ''
     3044                              then
