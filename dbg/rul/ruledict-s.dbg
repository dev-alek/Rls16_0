     2659             (input  v-cntxt-db-num
     2660             ,input  v-cntxt-userid
     2661             ,input  'wndmax':U
     2662             ,output v-diasize-wndmax
     2663             ,output v-default-value
     2664             ) .
     2665         end.
     2666         assign
     2667           v-diasize-wndstore = false
     2668         .
     2669         if connected("ub") = true
     2670         then do:
     2671           run gbl/wndpar_r.p
     2672             (input  v-cntxt-db-num
     2673             ,input  v-cntxt-userid
     2674             ,input  'wndstore':U
     2675             ,output v-diasize-wndstore
     2676             ,output v-default-value
     2677             ) .
     2678         end.
     2679         assign
     2680           v-diasize-proc-name = entry(1, program-name(2), '.')
     2681         .
     2682         if v-diasize-wndstore = true
     2683         then do:
     2684           assign
     2685             v-restore-saved = false
     2686           .
     2687           if connected("ub") = true
     2688           then do:
     2689             run gbl/wndsizer.p
     2690               (input  v-cntxt-db-num
     2691               ,input  v-cntxt-userid
     2692               ,input  v-diasize-proc-name
     2693               ,input  'height':u
     2694               ,output v-resize-value-str
     2695               ) .
     2696             if v-resize-value-str <> '':U
     2697             then do:
     2698               run diasize_change-height in this-procedure
     2699                 (input  integer(v-resize-value-str)
     2700                 ,input  true
     2701                 ) .
     2702               assign
     2703                 v-restore-saved = true
     2704               .
     2705             end.
     2706           end.
     2707           if connected("ub") = true
     2708           then do:
     2709             run gbl/wndsizer.p
     2710               (input  v-cntxt-db-num
     2711               ,input  v-cntxt-userid
     2712               ,input  v-diasize-proc-name
     2713               ,input  'width':u
     2714               ,output v-resize-value-str
     2715               ) .
     2716             if v-resize-value-str <> '':U
     2717             then do:
     2718               run diasize_change-width in this-procedure
     2719                 (input  integer(v-resize-value-str)
     2720                 ,input  true
     2721                 ) .
     2722               assign
     2723                 v-restore-saved = true
     2724               .
     2725             end.
     2726           end.
     2727           if v-restore-saved <> true
     2728           then do:
     2729             if v-diasize-wndmax = true
     2730             then do:
     2731               run diasize_maximize in this-procedure
     2732                 (input  true
     2733                 ) .
     2734             end.
     2735           end.
     2736         end.
     2737         else do:
     2738           if v-diasize-wndmax = true
     2739           then do:
     2740             run diasize_maximize in this-procedure
     2741               (input  true
     2742               ) .
     2743           end.
     2744         end.
     2745       end.
     2746     end.
     2747   end procedure.
     2748   procedure diasize_need-full-display :
     2749     define output parameter p-need-full-display as logical   no-undo .
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       assign
     2754         p-need-full-display = v-diasize-need-full-display
     2755       .
     2756       assign
     2757         v-diasize-need-full-display = false
     2758       .
     2759     end.
     2760   end procedure.
     2761   procedure get-context :
     2762      define output parameter p-db-num as integer          no-undo.
     2763      define output parameter p-user-id as character        no-undo.
     2764      define variable v-login               as character    no-undo.
     2765      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2766      define buffer buf_user-login  for ub.user-login .
     2767      do
     2768      on error undo, return error
     2769      :
     2770            FIND FIRST buf_sys-ctrl no-lock.
     2771            ASSIGN
     2772               v-login = USERID("ub")
     2773               p-db-num = buf_sys-ctrl.db-num
     2774            .
     2775            FIND FIRST buf_user-login
     2776                 WHERE buf_user-login.db-num = p-db-num
     2777                   AND buf_user-login.user-login = v-login
     2778                 no-lock
     2779                 no-error
     2780                 .
     2781            IF AVAILABLE buf_user-login
     2782            THEN DO:
     2783               assign
     2784                  p-user-id = buf_user-login.user-id
     2785               .
     2786            END.
     2787      end.
     2788   end procedure.
     2789       run diasize_init in this-procedure .
     2790   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2791   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2792   MAIN-BLOCK:
     2793   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2794      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2795   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2796     run mainmenu_getcntxt in parparentproc
     2797       (output v-cntxt-db-num
     2798       ,output v-cntxt-userid
     2799       ,output v-cntxt-level
     2800       ,output v-cntxt-host-code-obj
     2801       ,output v-cntxt-obj-type
     2802       ,output v-cntxt-obj-code
     2803       ,output v-cntxt-db-num-obj
     2804       ,output v-cntxt-is-admin
     2805       ) .
     2806     v-rid-list = p-rid-list.
     2807     run Myenable in this-procedure .
     2808     WAIT-FOR GO OF FRAME Dialog-Frame.
     2809   END.
     2810   RUN disable_UI.
     2811   PROCEDURE disable_UI :
     2812     HIDE FRAME Dialog-Frame.
     2813   END PROCEDURE.
     2814   PROCEDURE enable_UI :
     2815     DISPLAY cb-entry-type rs-find-al f-script-al rs-find-nl f-script-nl mark-num
     2816         WITH FRAME Dialog-Frame.
     2817     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-lkp b-links b-sch B-Help
     2818            b-copy b-uniq-key-rec cb-entry-type rs-find-al f-script-al rs-find-nl
     2819            f-script-nl br-ruledict mark-num
     2820         WITH FRAME Dialog-Frame.
     2821     VIEW FRAME Dialog-Frame.
     2822     OPEN QUERY br-ruledict FOR EACH X_ruledict .
     2823   END PROCEDURE.
     2824   PROCEDURE Myenable :
     2825   ASSIGN
     2826   cb-entry-type:LIST-ITEMs  IN FRAME Dialog-Frame = chr(44) + 'constant,operator,control,prop-name_,prop-name_host,prop-name_obj,node-name_,node-name_host,node-name_obj,prop-script,sum-id,rule,rule-profile,datatype,parameter':u
     2827   X_ruledict.script-nl:RESIZABLE IN BROWSE br-ruledict = YES
     2828   X_ruledict.script-al:RESIZABLE IN BROWSE br-ruledict = YES
     2829   X_ruledict.uniq-key-rec:RESIZABLE IN BROWSE br-ruledict = YES
     2830   b-links:MENU-MOUSE IN FRAME Dialog-Frame = 1
     2831   cb-entry-type = '':U
     2832   rs-find-al = "begins"
     2833   rs-find-nl = "begins"
     2834   .
     2835   ENABLE
     2836   b-quit
     2837   b-add when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2838   b-copy when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2839   b-chg when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2840   b-del when (v-cntxt-db-num = 0 and lookup("b-add", bttns) > 0)
     2841   b-lkp
     2842   B-Help
     2843   b-mark when lookup("b-mark", bttns) > 0
     2844   b-sel when lookup("b-sel", bttns) > 0
     2845   b-sch
     2846   b-links
     2847   b-uniq-key-rec
     2848   br-ruledict
     2849   cb-entry-type WHEN p-list-mode = 'все':U
     2850   f-script-al
     2851   f-script-nl
     2852   rs-find-al
     2853   rs-find-nl
     2854   WITH FRAME Dialog-Frame.
     2855   VIEW FRAME Dialog-Frame.
     2856   IF p-list-mode = "entry-type" THEN DO:
     2857     HIDE
     2858     cb-entry-type IN FRAME Dialog-Frame.
     2859   END.
     2860   run OpenBr in this-procedure  ( input yes, input no, input '':U).
     2861   END PROCEDURE.
     2862   PROCEDURE Openbr :
     2863   define input  parameter p-open-query     as logical   no-undo .
     2864   define input  parameter p-find-next      as logical   no-undo .
     2865   define input  parameter p-find-condition as character no-undo .
     2866   define variable l-query-was-opened as logical no-undo .
     2867   run waitfram-show in this-procedure ("Ждите...").
     2868   define variable sort-column-phrase as character no-undo .
     2869   case sort-column-name :
     2870     when "" then do:
     2871       assign
     2872         sort-column-phrase = ""
     2873       .
     2874     end.
     2875     otherwise do:
     2876       assign
     2877         sort-column-phrase = "by " + sort-column-name
     2878       .
     2879     end.
     2880   end case.
     2881   define variable l-open-query as logical   no-undo .
     2882   filter-point = filter-point0 + p-list-mode.
