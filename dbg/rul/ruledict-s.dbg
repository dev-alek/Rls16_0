     2891           .
     2892         end.
     2893         if p-word-script-nl = '':U
     2894         and p-word-script-al = '':U then do:
     2895   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2896   define variable  l-disable-where-18  as logical   no-undo .
