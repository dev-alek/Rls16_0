     2917       run set-filter-name in this-procedure
     2918         (INPUT filter-name-18
     2919         ) no-error .
     2920     assign
     2921       l-filter-open-18 = false
     2922     .
     2923     if flt-rec-18 <> ?
     2924       or sort-column-phrase > ""
     2925     then do:
     2926       define variable  parameter-2-18 as character no-undo .
     2927       define variable  parameter-3-18 as character no-undo .
     2928       define variable  parameter-4-18 as character no-undo .
     2929       define variable  parameter-5-18 as character no-undo .
     2930       define variable  parameter-6-18 as character no-undo .
     2931       define variable  parameter-7-18 as character no-undo .
     2932         assign
     2933         parameter-3-18 =
     2934                                 "FOR EACH X_ruledict"
     2935         parameter-4-18 =
     2936           (
     2937             if (" true " + " " + where-phrase-18) <> ""
     2938             then " true " + " " + where-phrase-18
     2939             else "true"
     2940           )
     2941         parameter-5-18 = (" " + "" + " " + "")
     2942         parameter-6-18 = if sort-phrase-18 = ''
     2943                              then
     2944           (
     2945           " " + "  " +
     2946             " " + sort-column-phrase +
     2947           " " + "  "
     2948           )
     2949                              else
     2950           (
     2951           " " + "  " +
     2952             " " + sort-column-phrase +
     2953           " " + sort-phrase-18
     2954           )
     2955         parameter-7-18 =
     2956           " indexed-reposition  "
     2957       .
     2958       do
     2959       on stop undo, leave
     2960       on error undo, leave
     2961       :
     2962         assign
     2963           l-disable-where-18 =
     2964             (" true " + " " + where-phrase-18 = "")
     2965         .
     2966         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2967                             ,input QUERY br-ruledict:handle
     2968                             ,input parameter-3-18
     2969                             ,input parameter-4-18
     2970                             ,input parameter-5-18
     2971                             ,input parameter-6-18
