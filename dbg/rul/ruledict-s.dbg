     3062                             ,input logical(parameter-2-18)
     3063                             ,input no-lock
     3064                             ,input parameter-3-18
     3065                             ,input parameter-4-18
     3066                             ,input parameter-5-18
     3067                             ,input parameter-6-18
     3068                             ,input parameter-7-18
     3069                             ,output v-fltopend-rowid
     3070                             ) no-error.
     3071         .
     3072         v-doc-rec = ?.
     3073       end.
     3074       assign
     3075         l-query-was-opened = true
     3076       .
     3077     end.
     3078   end.
     3079     run waitfram-hide in this-procedure .
     3080         end.
     3081         if p-word-script-nl = '':U
     3082         and p-word-script-al <> '':U then do:
     3083   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3084   define variable  l-disable-where-20  as logical   no-undo .
