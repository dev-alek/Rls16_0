     2982           "Будут показаны записи без учета фильтра" skip
     2983           view-as alert-box .
     2984       end.
     2985       else do:
     2986           assign
     2987             l-query-was-opened = true
     2988           .
     2989       end.
     2990     end.
     2991     if l-filter-open-18 = false then do:
     2992       OPEN QUERY br-ruledict FOR EACH X_ruledict
     2993         where  true
     2994         indexed-reposition
     2995     .
     2996         assign
     2997           l-query-was-opened = true
     2998         .
     2999     end.
     3000   end.
