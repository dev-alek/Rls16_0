     2547       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     2548                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     2549                                   else -1 )
     2550       buf_temp-hist-nws-option.table-name = 'clients':U
     2551       buf_temp-hist-nws-option.key#_one = 2
     2552       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     2553       .
