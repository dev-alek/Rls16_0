     1935   procedure get-gate-file-name :
     1936   define input parameter p-gate-rec as character no-undo .
     1937   define output  parameter p-gate-file-name as character no-undo .
     1938   define buffer buf_clob-data for ub.clob-data.
     1939   define variable v-tbl-row as rowid no-undo .
     1940   define variable v-tbl-name as character no-undo .
     1941   run gen-row-keyr in this-procedure ( input p-gate-rec
     1942                                       ,input ?
     1943                                       ,input "ub"
     1944                                       ,input ?
     1945                                       ,input no-lock
     1946                                       ,output v-tbl-row
     1947                                       ,output v-tbl-name) no-error.
     1948   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1949                                                           ,vss-include-info15
     1950                                                           ,p-gate-rec).
     1951   find first buf_clob-data no-lock where
     1952             rowid(buf_clob-data) = v-tbl-row no-error.
     1953   if not available buf_clob-data then do:
     1954     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1955                                                             ,vss-include-info15
     1956                                                             ,p-gate-rec).
     1957   end.
     1958   p-gate-file-name = buf_clob-data.file-name.
     1959   end procedure.
     1960   procedure get-gate-rec :
     1961   define input  parameter p-gate-name as character no-undo .
     1962   define output parameter p-gate-rec as character no-undo .
     1963   define buffer buf_clob-bind for ub.clob-bind.
     1964   define buffer buf_clob-data for ub.clob-data.
     1965   main-block:
     1966   do
     1967   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1968   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1969   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1970   :
     1971       find first buf_clob-bind no-lock where
     1972                 buf_clob-bind.uniq-key-rec = p-gate-name
     1973             and buf_clob-bind.field-name = '':U
     1974             and buf_clob-bind.part-num = 1
     1975             and buf_clob-bind.resource-type = 'gate':U
     1976             no-error.
     1977       if not available buf_clob-bind then do:
     1978         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1979                                         , p-gate-name
     1980                                         ).
     1981       end.
     1982       find first buf_clob-data no-lock where
     1983                 buf_clob-data.db-num = buf_clob-bind.db-num
     1984             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1985       if not available buf_clob-data then do:
     1986         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1987                                         , buf_clob-bind.db-num
     1988                                         , buf_clob-bind.int64-id
     1989                                         , p-gate-name
     1990                                         ).
     1991       end.
     1992       run gen-key-rec in this-procedure ( input 'clob-data':U
     1993                                 ,input buffer buf_clob-data:handle
     1994                                 ,output p-gate-rec).
     1995   end.
     1996   end procedure.
     1997   procedure get-gate-by-name :
     1998   define input  parameter p-gate-name as character no-undo .
     1999   define output parameter p-gate-rec as character no-undo .
     2000   define output parameter p-dsh as handle no-undo .
     2001   define input-output  parameter p-xmlh as handle no-undo .
     2002   define variable v-ii as integer   no-undo .
     2003   define variable glog as logical   no-undo .
     2004   define variable v-longchar as longchar no-undo .
     2005   define variable v-txmlh as handle no-undo .
     2006   define variable v-db-num as integer no-undo .
     2007   define variable v-int64-id as int64 no-undo .
     2008   define buffer buf_clob-bind for ub.clob-bind.
     2009   define buffer buf_clob-data for ub.clob-data.
     2010   main-block:
     2011   do
     2012   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2013   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2014   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2015   :
     2016       find first buf_clob-bind no-lock where
     2017                 buf_clob-bind.uniq-key-rec = p-gate-name
     2018             and buf_clob-bind.field-name = '':U
     2019             and buf_clob-bind.part-num = 1
     2020             and buf_clob-bind.resource-type = 'gate':U
     2021             no-error.
     2022       if not available buf_clob-bind then do:
     2023         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2024                                         , p-gate-name
     2025                                         ).
     2026       end.
     2027       find first buf_clob-data no-lock where
     2028                 buf_clob-data.db-num = buf_clob-bind.db-num
     2029             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2030       if not available buf_clob-data then do:
     2031         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2032                                         , buf_clob-bind.db-num
     2033                                         , buf_clob-bind.int64-id
     2034                                         , p-gate-name
     2035                                         ).
     2036       end.
     2037       assign
     2038       v-longchar = buf_clob-data.cdata
     2039       .
     2040       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2041       if error-status :error then do:
     2042         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2043       end.
     2044       create dataset p-dsh .
     2045       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2046                                     , v-longchar
     2047                                     , ?
     2048                                     , ?
     2049                                     , ?
     2050                                     ) no-error.
     2051       v-longchar = '':U.
     2052       if error-status :error
     2053       or not glog
     2054       then do:
     2055         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2056       end.
     2057       if not valid-handle(p-xmlh)
     2058       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2059         create temp-table v-txmlh.
     2060         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2061         v-txmlh:temp-table-prepare("temp-xml-tables").
     2062         p-xmlh = v-txmlh:default-buffer-handle.
     2063       end.
     2064       run gen-key-rec in this-procedure ( input 'clob-data':U
     2065                                 ,input buffer buf_clob-data:handle
     2066                                 ,output p-gate-rec).
     2067       do v-ii = 1 to p-dsh:num-buffers:
     2068         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2069         if not p-xmlh:available then do:
     2070           p-xmlh:buffer-create().
     2071           assign
     2072           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2073           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2074           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2075           p-xmlh::gate-handle_ = p-dsh
     2076           p-xmlh::uniq-gate-rec = p-gate-rec
     2077           p-xmlh::gate-name = p-dsh:name
     2078           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2079           .
     2080           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2081             assign
     2082             p-xmlh::order = -3.
     2083           end.
     2084         end.
     2085       end.
     2086   end.
     2087   end procedure.
     2088   procedure get-gate-by-rec :
     2089   define input  parameter p-gate-rec as character no-undo .
     2090   define output parameter p-dsh as handle no-undo .
     2091   define input-output  parameter p-xmlh as handle no-undo .
     2092   define input-output parameter p-longchar  as longchar no-undo .
     2093   define variable v-ii as integer   no-undo .
     2094   define variable glog as logical   no-undo .
     2095   define variable v-rowid as rowid no-undo .
     2096   define variable v-tbl-name as character no-undo .
     2097   define variable v-longchar as longchar no-undo .
     2098   define variable v-txmlh as handle no-undo .
     2099   define buffer buf_clob-data for ub.clob-data.
     2100   main-block:
     2101   do
     2102   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2103   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2104   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2105   :
     2106     run gen-row-keyr in this-procedure (
     2107                                           input  p-gate-rec
     2108                                           ,input  ?
     2109                                           ,input  "ub"
     2110                                           ,input  ?
     2111                                           ,input  NO-LOCK
     2112                                           ,output v-rowid
     2113                                           ,output v-tbl-name   ) no-error.
     2114       find first buf_clob-data no-lock where
     2115                 rowid(buf_clob-data) = v-rowid  no-error.
     2116       if not available buf_clob-data then do:
     2117         undo, return error substitute("Не найден CLOB  &1"
     2118                                         , p-gate-rec
     2119                                         ).
     2120       end.
     2121       assign
     2122       v-longchar = buf_clob-data.cdata
     2123       .
     2124       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2125       if error-status :error then do:
     2126         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2127       end.
     2128       create dataset p-dsh .
     2129       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2130                                     , v-longchar
     2131                                     , ?
     2132                                     , ?
     2133                                     , ?
     2134                                     ) no-error.
     2135       define variable v-esm as character no-undo .
     2136       v-esm = error-status:get-message(1) .
     2137       if p-longchar <> ? then do:
     2138         p-longchar = v-longchar.
     2139       end.
     2140       v-longchar = '':U.
     2141       if error-status :error
     2142       or not glog
     2143       then do:
     2144         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2145                                      , p-gate-rec
     2146                                      , p-gate-rec
     2147                                      , v-esm
     2148                                      ).
     2149       end.
     2150       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2151       if not valid-handle(p-xmlh)
     2152       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2153         create temp-table v-txmlh.
     2154         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2155         v-txmlh:temp-table-prepare("temp-xml-tables").
     2156         p-xmlh = v-txmlh:default-buffer-handle.
     2157       end.
     2158       do v-ii = 1 to p-dsh:num-buffers:
     2159         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2160         if not p-xmlh:available then do:
     2161           p-xmlh:buffer-create().
     2162           assign
     2163           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2164           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2165           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2166           p-xmlh::gate-handle_ = p-dsh
     2167           p-xmlh::uniq-gate-rec = p-gate-rec
     2168           p-xmlh::gate-name = p-dsh:name
     2169           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2170           .
     2171           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2172             assign
     2173             p-xmlh::order = -3.
     2174           end.
     2175           p-xmlh:buffer-release().
     2176         end.
     2177       end.
     2178   end.
     2179   end procedure.
     2180   procedure get-gate-by-file :
     2181   define input  parameter p-schema-file-name as character no-undo .
     2182   define input  parameter p-gate-rec as character no-undo .
     2183   define output parameter p-dsh as handle no-undo .
     2184   define input-output  parameter p-xmlh as handle no-undo .
     2185   define variable v-ii as integer   no-undo .
     2186   define variable glog as logical   no-undo .
     2187   define variable v-rowid as rowid no-undo .
     2188   define variable v-tbl-name as character no-undo .
     2189   define variable v-longchar as longchar no-undo .
     2190   define variable v-txmlh as handle no-undo .
     2191   main-block:
     2192   do
     2193   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2194   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2195   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2196   :
     2197       COPY-LOB
     2198       FROM  FILE p-schema-file-name
     2199       TO  OBJECT v-longchar
     2200       no-convert
     2201       NO-ERROR .
     2202       if error-status :error then do:
     2203           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2204                                     , p-schema-file-name
     2205                                 , chr(10)
     2206                                 , error-status:get-message(1) ).
     2207       end.
     2208       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2209       if error-status :error then do:
     2210         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2211       end.
     2212       create dataset p-dsh .
     2213       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2214                                     , v-longchar
     2215                                     , ?
     2216                                     , ?
     2217                                     , ?
     2218                                     ) no-error.
     2219       v-longchar = ''.
     2220       if error-status :error
     2221       or not glog
     2222       then do:
     2223         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2224                                      , p-schema-file-name
     2225                                      ,chr(10)
     2226                                      , error-status:get-message(1)
     2227                                      ).
     2228       end.
     2229       if not valid-handle(p-xmlh)
     2230       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2231         create temp-table v-txmlh.
     2232         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2233         v-txmlh:temp-table-prepare("temp-xml-tables").
     2234         p-xmlh = v-txmlh:default-buffer-handle.
     2235       end.
     2236       do v-ii = 1 to p-dsh:num-buffers:
     2237         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2238                                      ,p-dsh:get-buffer-handle(v-ii):name
     2239                                      ,p-gate-rec
     2240                                      )) no-error.
     2241         if not p-xmlh:available then do:
     2242           p-xmlh:buffer-create().
     2243           assign
     2244           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2245           p-xmlh::uniq-gate-rec = p-gate-rec
     2246           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2247           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2248           p-xmlh::gate-handle_ = p-dsh
     2249           p-xmlh::gate-name = p-dsh:name
     2250           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2251           .
     2252           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2253             assign
     2254             p-xmlh::order = -3.
     2255           end.
     2256           p-xmlh:buffer-release().
     2257         end.
     2258       end.
     2259   end.
     2260   end procedure.
     2261   procedure gate-clear :
     2262   define input  parameter p-dsh as handle no-undo .
     2263   define input  parameter p-xmlh as handle no-undo .
     2264   define variable v-dsh as handle no-undo .
     2265   define variable v-th as handle no-undo .
     2266     do
     2267     on error undo, return error return-value
     2268     :
     2269       if valid-handle(p-dsh) then do:
     2270         delete object p-dsh.
     2271         v-dsh = p-dsh.
     2272         p-dsh = ?.
     2273       end.
     2274       repeat while true:
     2275         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2276                            , share-lock) no-error.
     2277         if p-xmlh:available then do:
     2278           assign
     2279           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2280           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2281           and valid-handle(v-th)
     2282           and v-th:dynamic = yes
     2283           then do:
     2284             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2285             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2286           end.
     2287           p-xmlh:buffer-delete().
     2288         end.
     2289         else do:
     2290           leave.
     2291         end.
     2292       end.
     2293       if p-xmlh:dynamic = yes
     2294       and valid-handle(p-xmlh)
     2295       then do:
     2296         delete object p-xmlh:table-handle.
     2297         p-xmlh = ?.
     2298       end.
     2299       v-dsh = ?.
     2300     end.
     2301   end procedure.
     2302   procedure all-gates-clear :
     2303   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2304   do
     2305   on error undo, return error
     2306   :
     2307     for each buf_temp-xml-tables
     2308     break
     2309     by buf_temp-xml-tables.uniq-gate-rec
     2310     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2311     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2312     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2313     :
     2314         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2315           delete object buf_temp-xml-tables.gate-handle_.
     2316           buf_temp-xml-tables.gate-handle_ = ?.
     2317         end.
     2318         if valid-handle(buf_temp-xml-tables.table-handle_)
     2319         and buf_temp-xml-tables.table-handle_:dynamic = no
     2320         then do:
     2321           delete object buf_temp-xml-tables.table-handle_.
     2322           buf_temp-xml-tables.table-handle_ = ?.
     2323         end.
     2324         delete buf_temp-xml-tables.
     2325     end.
     2326   end.
     2327   end procedure.
     2328   procedure fix-schemalocation :
     2329   define input-output  parameter p-longchar as longchar no-undo .
     2330   DEFINE VARIABLE hdoc AS HANDLE.
     2331   DEFINE VARIABLE hroot AS HANDLE.
     2332   DEFINE VARIABLE hnode-child AS HANDLE.
     2333   DEFINE VARIABLE hnode-attr AS HANDLE.
     2334   define variable v-jj as integer   no-undo .
     2335   define variable ok as logical   no-undo .
     2336   define variable v-path1                    as character                no-undo .
     2337   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2338   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2339   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2340   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2341   define variable v-schema-location          as character                no-undo .
     2342   do
     2343   on error undo, return error return-value
     2344   :
     2345     CREATE X-DOCUMENT hdoc.
     2346     CREATE X-noderef hroot.
     2347     CREATE X-noderef hnode-child.
     2348     CREATE X-noderef hnode-attr.
     2349     hdoc:load("longchar", p-longchar, no) no-error.
     2350     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2351     hdoc:get-document-element(hroot).
     2352     _repeat:
     2353     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2354       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2355       if not ok then next.
     2356       if hNode-Child:local-name = "include"
     2357       then do:
     2358         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2359           v-schema-location = hnode-attr:node-value.
     2360           run gbl/filename.p (
     2361                           input "exe/" + hnode-attr:node-value
     2362                         ,output v-full-path1
     2363                         ,output v-path1
     2364                         ,output v-file-name1
     2365                         ,output v-file-name-no-ext1
     2366                         ,output v-file-name-ext1
     2367                         ) no-error .
     2368           if error-status :error then do:
     2369             delete object hnode-attr.
     2370             delete object hnode-child.
     2371             delete object hroot.
     2372             delete object hdoc.
     2373             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2374           end.
     2375         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2376         leave  _repeat.
     2377       end.
     2378     END.
     2379     hdoc:save("longchar", p-longchar).
     2380     delete object hnode-attr.
     2381     delete object hnode-child.
     2382     delete object hroot.
     2383     delete object hdoc.
     2384   end.
     2385   end procedure.
     2386   procedure gate-clb_fill-xml-tables :
     2387   define input parameter p-dsh as handle no-undo .
     2388   define input-output parameter p-xmlh as handle no-undo .
     2389   define variable v-ii as integer no-undo .
     2390     do
     2391     on error undo, return error
     2392     :
     2393       do v-ii = 1 to p-dsh:num-buffers:
     2394         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2395         if not p-xmlh:available then do:
     2396           p-xmlh:buffer-create().
     2397           assign
     2398           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2399           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2400           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2401           p-xmlh::gate-handle_ = p-dsh
     2402           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2403           p-xmlh::gate-name = p-dsh:name
     2404           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2405           .
     2406           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2407             assign
     2408             p-xmlh::order = -3.
     2409           end.
     2410           p-xmlh:buffer-release().
     2411         end.
     2412       end.
     2413     end.
     2414   end procedure.
     2415   procedure all-gates-empty :
     2416   define buffer buf_temp-xml-tables for temp-xml-tables.
     2417   do
     2418   on error undo, return error
     2419   :
     2420     for each buf_temp-xml-tables
     2421     break
     2422     by buf_temp-xml-tables.uniq-gate-rec
     2423     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2424     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2425     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2426     :
     2427       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2428         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2429       end.
     2430     end.
     2431   end.
     2432   end procedure.
     2433   define variable v-current-d-card as character no-undo .
     2434   define variable v-current-host-code as integer no-undo .
     2435   define variable v-current-obj-type as character no-undo .
     2436   define variable v-current-obj-code as integer no-undo .
     2437   define variable v-current-doc-code as character no-undo .
     2438   define variable v-current-lock as integer no-undo .
     2439   define variable v-current-wait as integer no-undo .
     2440   define variable v-save as integer no-undo .
     2441   define variable v-current-db-num as integer no-undo .
     2442   define variable v-current-date as date no-undo .
     2443   define variable v-emitent-host-code as integer no-undo .
     2444   define variable v-type as character no-undo .
     2445   define variable v-sign as integer no-undo .
     2446   define variable file-name as char.
     2447   define variable num-rec as integer no-undo .
     2448   define variable num-rec-ok as integer no-undo .
     2449   define variable v-full-path        as character no-undo .
     2450   define variable v-path             as character no-undo .
     2451   define variable v-file-name        as character no-undo .
     2452   define variable v-file-name-no-ext as character no-undo .
