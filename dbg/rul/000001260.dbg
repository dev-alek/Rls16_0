     3458   procedure get-db-list-for-d-card2 :
     3459   define input parameter p-d-card as character no-undo .
     3460   define variable v-current-db-processed as logical no-undo .
     3461   define buffer buf_clients  for ub.clients.
     3462   define buffer buf_dis-obj for ub.dis-obj.
     3463   define buffer buf_temp-smart-route for temp-smart-route.
     3464     do
     3465     on error undo, return error return-value
     3466     :
     3467       for each buf_dis-obj no-lock where
     3468               buf_dis-obj.d-card = p-d-card,
     3469          first buf_clients no-lock where
     3470               buf_clients.obj-type = buf_dis-obj.obj-type
     3471           and buf_clients.obj-code = buf_dis-obj.obj-code
     3472       break by
     3473       buf_clients.db-num:
     3474         if first-of(buf_Clients.db-num) then do:
     3475           find first buf_temp-smart-route no-lock where
     3476                 buf_temp-smart-route.key-field = p-d-card
     3477             and buf_temp-smart-route.db-num = buf_clients.db-num
     3478                 no-error.
     3479           if available buf_temp-smart-route then return.
     3480           create buf_temp-smart-route.
     3481           assign
     3482           buf_temp-smart-route.key-field = p-d-card
     3483           buf_temp-smart-route.db-num = buf_clients.db-num
     3484           .
     3485           if buf_clients.db-num = g#db-num then do:
     3486             v-current-db-processed = yes.
     3487           end.
     3488         end.
     3489       end.
     3490       if not v-current-db-processed then do:
     3491         find first buf_temp-smart-route no-lock where
     3492               buf_temp-smart-route.key-field = p-d-card
     3493           and buf_temp-smart-route.db-num = g#db-num  no-error.
     3494         if not available buf_temp-smart-route then do:
     3495           create buf_temp-smart-route.
     3496           assign
     3497           buf_temp-smart-route.key-field = p-d-card
     3498           buf_temp-smart-route.db-num = g#db-num
     3499           .
