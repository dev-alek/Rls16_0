      478   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure gen-b-code :
      480     define input  parameter type-code like ub.code-range.range-type no-undo .
      481     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      482     do
      483     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      484     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      485     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      486     :
      487       define buffer buf_thbj-attr     for ub.thbj-attr .
      488       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      489       define buffer buf_code-range for ub.code-range .
      490       define variable l-code         as   integer              no-undo .
      491       define variable v-db-num       like ub.db.db-num         no-undo .
      492       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      493       if type-code = 'sslc':U
      494       or type-code = 'ssgb':U
      495       then do:
      496         message
      497           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      498           "Обратитесь к администратору системы."
      499           view-as alert-box error .
      500         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      501       end.
      502       run trg/getpcode.p ( input  type-code
      503                      ,output cfg-param-code
      504                     ).
      505       run get-next-seq( input  type-code,
      506                         output l-code
      507                       ).
      508       find first buf_sys-ctrl no-lock.
      509       if type-code = 'sclc':U
      510       or type-code = 'pglc':U
      511       then do:
      512         assign
      513           v-db-num = 0
      514         .
      515       end.
      516       else do:
      517         assign
      518           v-db-num = buf_sys-ctrl.db-num
      519         .
      520       end.
      521       find first buf_code-range no-lock
      522         where buf_code-range.db-num     = v-db-num
      523           and buf_code-range.range-type = type-code
      524           and buf_code-range.stts       = "a"
      525         use-index stts
      526         no-error .
      527       if available buf_code-range
      528          and l-code <= buf_code-range.last-code
      529          and l-code >= buf_code-range.first-code then do:
      530         assign
      531           p-b-code = l-code
      532         .
      533       end.
      534       else do:
      535         if available buf_code-range
      536            and l-code < buf_code-range.last-code then do:
      537           message
      538             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      539             "Обратитесь к администратору системы."
      540             view-as alert-box error .
      541           undo, return error "sequence":U .
      542         end.
      543         do transaction
      544         on error undo, return error
      545         :
      546           find first buf_thbj-attr exclusive-lock
      547             where buf_thbj-attr.upper-prop-code = 'code-range':U
      548               and buf_thbj-attr.prop-code = cfg-param-code
      549               and buf_thbj-attr.obj-type   = 'БД':U
      550               and buf_thbj-attr.obj-code   = v-db-num
      551             no-error .
      552           if not available buf_thbj-attr then do:
      553             find first buf_thbj-attr exclusive-lock
      554               where buf_thbj-attr.upper-prop-code = 'code-range':U
      555                 and buf_thbj-attr.prop-code = cfg-param-code
      556                 and buf_thbj-attr.obj-type   = ''
      557                 and buf_thbj-attr.obj-code   = 0
      558               no-error .
      559             if not available buf_thbj-attr then do:
      560               if not locked buf_thbj-attr then do:
      561                 message
      562                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      563                   "Обратитесь к администратору системы."
      564                   view-as alert-box error .
      565               end.
      566               undo, return error "config":U .
      567             end.
      568           end.
      569           run get-next-seq( input type-code,
      570                             output l-code
      571                           ).
      572           find first buf_code-range
      573             where buf_code-range.db-num     = v-db-num
      574               and buf_code-range.range-type = type-code
      575               and buf_code-range.stts       = "a"
      576             use-index stts
      577             no-error .
      578           if available buf_code-range
      579           and l-code <= buf_code-range.last-code
      580           and l-code >= buf_code-range.first-code
      581           then do:
      582             assign
      583               p-b-code = l-code
      584             .
      585           end.
      586           else do:
      587             if available buf_code-range then do:
      588               assign
      589                 buf_code-range.stts = "u"
      590               .
      591             end.
      592             find first buf_code-range
      593               where buf_code-range.db-num     = v-db-num
      594                 and buf_code-range.range-type = type-code
      595                 and buf_code-range.stts       = "f"
      596               use-index stts
      597               no-error .
      598             if not available buf_code-range then do:
      599               message
      600                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      601                 "Обратитесь к администратору системы"
      602                 view-as alert-box error .
      603               undo, return error "code-range":U .
      604             end.
      605             assign
      606               buf_code-range.stts           = "a"
      607             .
      608             if buf_code-range.first-code = 1 then do:
      609               run set-seq-cr( input type-code,
      610                               input buf_code-range.first-code
      611                             ).
      612               assign
      613                 p-b-code = 1
      614               .
      615             end.
      616             else do:
      617               run set-seq-cr( input type-code,
      618                               input ( buf_code-range.first-code - 1 )
      619                             ).
      620               run get-next-seq( input type-code,
      621                                 output p-b-code
      622                               ).
      623             end.
      624           end.
      625         end.
      626       end.
      627     end.
      628   end procedure.
      629   procedure get-next-seq :
      630     define input  parameter type-code like ub.code-range.range-type no-undo .
      631     define output parameter next-seq  as   integer                  no-undo .
      632     do
      633     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      634     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      635     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      636     :
      637       case type-code:
      638         when 'bcgb':U then do:
      639           assign
      640             next-seq = next-value(s-bcgb-code, ub)
      641           .
      642         end.
      643         when 'scgb':U then do:
      644           assign
      645             next-seq = next-value(s-scgb-code, ub)
      646           .
      647         end.
      648         when 'sclc':U then do:
      649           assign
      650             next-seq = next-value(s-sclc-code, ub)
      651           .
      652         end.
      653         when 'pglc':U then do:
      654           assign
      655             next-seq = next-value(s-pglc-code, ub)
      656           .
      657         end.
      658         when 'dcgb':U then do:
      659           assign
      660             next-seq = next-value(s-dcgb-code, ub)
      661           .
      662         end.
      663         when 'ctgb':U then do:
      664           assign
      665             next-seq = next-value(s-ctgb-code, ub)
      666           .
      667         end.
      668         when 'drgb':U then do:
      669           assign
      670             next-seq = next-value(s-drgb-code, ub)
      671           .
      672         end.
      673         when 'fmgb':U then do:
      674           assign
      675             next-seq = next-value(s-fmgb-code, ub)
      676           .
      677         end.
      678         when 'pngb':U then do:
      679           assign
      680             next-seq = next-value(s-pngb-code, ub)
      681           .
      682         end.
      683         when 'cagb':U then do:
      684           assign
      685             next-seq = next-value(s-cagb-code, ub)
      686           .
      687         end.
      688         when 'fdgb':U then do:
      689           assign
      690             next-seq = next-value(s-fin-doc, ub)
      691           .
      692         end.
      693       end case.
      694     end.
      695   end procedure.
      696   procedure set-seq-cr :
      697     define input parameter type-code like ub.code-range.range-type no-undo .
      698     define input parameter set-val   like ub.code-range.first-code no-undo .
      699     do
      700     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      701     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      702     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      703     :
      704       case type-code:
      705         when 'bcgb':U then do:
      706           assign
      707             current-value(s-bcgb-code, ub) = set-val
      708           .
      709         end.
      710         when 'scgb':U then do:
      711           assign
      712             current-value(s-scgb-code, ub) = set-val
      713           .
      714         end.
      715         when 'sclc':U then do:
      716           assign
      717             current-value(s-sclc-code, ub) = set-val
      718           .
      719         end.
      720         when 'pglc':U then do:
      721           assign
      722             current-value(s-pglc-code, ub) = set-val
      723           .
      724         end.
      725         when 'dcgb':U then do:
      726           assign
      727             current-value(s-dcgb-code, ub) = set-val
      728           .
      729         end.
      730         when 'ctgb':U then do:
      731           assign
      732             current-value(s-ctgb-code, ub) = set-val
      733           .
      734         end.
      735         when 'drgb':U then do:
      736           assign
      737             current-value(s-drgb-code, ub) = set-val
      738           .
      739         end.
      740         when 'fmgb':U then do:
      741           assign
      742             current-value(s-fmgb-code, ub) = set-val
      743           .
      744         end.
      745         when 'pngb':U then do:
      746           assign
      747             current-value(s-pngb-code, ub) = set-val
      748           .
      749         end.
      750         when 'cagb':U then do:
      751           assign
      752             current-value(s-cagb-code, ub) = set-val
      753           .
      754         end.
      755         when 'fdgb':U then do:
      756           assign
      757             current-value(s-fin-doc, ub) = set-val
      758           .
      759         end.
      760       end case.
      761     end.
      762   end procedure.
      763   procedure new-bcod-gen-code-range :
      764     do
      765     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      766     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      767     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      768     :
      769       define input parameter p-db-num  like ub.db.db-num             no-undo .
      770       define input parameter type-code like ub.code-range.range-type no-undo .
      771       define buffer buf_code-range      for ub.code-range .
      772       define buffer last_code-range     for ub.code-range .
      773       define buffer last-1_code-range   for ub.code-range .
      774       define buffer last-2_code-range   for ub.code-range .
      775       define buffer last-3_code-range   for ub.code-range .
      776       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      777       define variable conf-par       as character no-undo .
      778       define variable par-type       as character no-undo .
      779       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      780       define variable v-cre-cdrg as logical   no-undo .
      781       define variable v-cre-str  as character no-undo .
      782       define variable v-cr1      as integer no-undo .
      783       define variable v-cr2      as integer no-undo .
      784       define variable v-cr3      as integer no-undo .
      785       define variable v-cmax     as integer no-undo .
      786       find first buf_sys-ctrl no-lock .
      787       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      788         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      789                                       ,vss-workfile
      790                                       ,vss-revision
      791                                       ,vss-description
      792                                       ,chr(10)
      793                                       , p-db-num
      794                                      ).
      795       end.
      796       run trg/getpcode.p ( input  type-code
      797                      ,output cfg-param-code
      798                     ).
      799       for each buf_code-range
      800         where buf_code-range.db-num     = -1
      801           and buf_code-range.range-type = type-code
      802           and buf_code-range.stts       = "f"
      803       by buf_code-range.first-code
      804       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      805       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      806       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      807       :
      808         assign
      809           buf_code-range.db-num = p-db-num
      810         .
      811         return .
      812       end.
      813       assign
      814         v-cre-cdrg = TRUE
      815       .
      816       case type-code:
      817         when 'sclc':U
      818         or when 'scgb':U
      819         or when 'pglc':U
      820         then do:
      821           find last last-1_code-range no-lock
      822             where last-1_code-range.range-type = 'sclc':U
      823             no-error .
      824           if available last-1_code-range then do:
      825             v-cr1 = last-1_code-range.last-code.
      826           end.
      827           find last last-2_code-range no-lock
      828             where last-2_code-range.range-type = 'scgb':U
      829             no-error .
      830           if available last-2_code-range then do:
      831             v-cr2 = last-2_code-range.last-code.
      832             end.
      833           find last last-3_code-range no-lock
      834             where last-3_code-range.range-type = 'pglc':U
      835             no-error .
      836           if available last-3_code-range then do:
      837             v-cr3 = last-3_code-range.last-code.
      838           end.
      839           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      840           .
      841           if v-cmax = v-cr1  then do:
      842               find last last_code-range no-lock
      843                 where recid( last_code-range ) = recid( last-1_code-range )
      844                 .
      845             end.
      846           if v-cmax = v-cr2  then do:
      847               find last last_code-range no-lock
      848                 where recid( last_code-range ) = recid( last-2_code-range )
      849                 .
      850             end.
      851           if v-cmax = v-cr3  then do:
      852             find last last_code-range no-lock
      853               where recid( last_code-range ) = recid( last-3_code-range )
      854               .
      855           end.
      856           if last_code-range.last-code + 1 > 99999 then do:
      857             assign
      858               v-cre-cdrg = FALSE
      859             .
      860           end.
      861         end.
      862         when 'bcgb':U
      863         or when 'sslc':U
      864         or when 'ssgb':U
      865         then do:
      866           find last last-1_code-range no-lock
      867             where last-1_code-range.range-type = 'sslc':U
      868             no-error .
      869           if available last-1_code-range then do:
      870             v-cr1 = last-1_code-range.last-code.
      871           end.
      872           find last last-2_code-range no-lock
      873             where last-2_code-range.range-type = 'bcgb':U
      874             no-error .
      875           if available last-2_code-range then do:
      876             v-cr2 = last-2_code-range.last-code.
      877             end.
      878           find last last-3_code-range no-lock
      879             where last-3_code-range.range-type = 'ssgb':U
      880             no-error .
      881           if available last-3_code-range then do:
      882             v-cr3 = last-3_code-range.last-code.
      883           end.
      884           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      885           .
      886           if v-cmax = v-cr1  then do:
      887               find last last_code-range no-lock
      888                 where recid( last_code-range ) = recid( last-1_code-range )
      889                 .
      890             end.
      891           if v-cmax = v-cr2  then do:
      892               find last last_code-range no-lock
      893                 where recid( last_code-range ) = recid( last-2_code-range )
      894                 .
      895             end.
      896           if v-cmax = v-cr3  then do:
      897             find last last_code-range no-lock
      898               where recid( last_code-range ) = recid( last-3_code-range )
      899               .
      900           end.
      901         end.
      902         otherwise do:
      903           find last last_code-range no-lock
      904             where last_code-range.range-type = type-code
      905             no-error .
      906         end.
      907       end case.
      908       if not available last_code-range then do:
      909         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      910                                       ,vss-workfile
      911                                       ,vss-revision
      912                                       ,vss-description
      913                                       , chr(10)
      914                                       , type-code
      915                                      ) .
      916       end.
      917       define variable v-mes7 as character no-undo .
      918       define variable v-param-type7 as character no-undo .
      919       define variable v-value-character7 as INTEGER no-undo .
      920       define variable v-value-date7 as date no-undo .
      921       define variable v-value-decimal7 as decimal no-undo .
      922       define variable v-value-integer7 AS integer no-undo .
      923       define variable v-value-logical7 AS LOGICAL no-undo .
      924       define variable v-tth7 as handle no-undo .
      925       run adm/shattri.p (
      926           input "get":U
      927           ,input  'БД':U
      928           ,input  p-db-num
      929           ,input  'code-range':U
      930           ,input  cfg-param-code
      931           ,output v-value-character7
      932           ,output v-value-date7
      933           ,output v-value-decimal7
      934           ,output v-value-integer7
      935           ,output v-value-logical7
      936           ,output v-param-type7
      937           ,INPUT-OUTPUT table-handle v-tth7
      938           ) no-error .
      939       if error-status :error then do:
      940         delete object v-tth7.
      941         v-mes7 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      942                            , error-status:get-message(1)
      943                            , chr(10)
      944                            , return-value ).
      945         undo, return error v-mes7.
      946       end.
      947       delete object v-tth7.
      948       if v-cre-cdrg = TRUE then do:
      949         create buf_code-range .
      950         assign
      951           buf_code-range.db-num     = p-db-num
      952           buf_code-range.range-type = type-code
      953           buf_code-range.stts       = "f"
      954           buf_code-range.first-code = last_code-range.last-code + 1
      955           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer7)
      956           v-cre-str = "Свободный диапазон успешно создан"
      957         .
      958       end.
      959       else do:
      960         assign
      961           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      962                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      963         .
      964       end.
      965     end.
      966     return v-cre-str .
      967   end procedure.
      968   procedure gen-new-code-range-if-neces :
      969     define input parameter v-db-num           like ub.db.db-num             no-undo .
      970     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      971     define input parameter v-cur-code         as   integer                  no-undo .
      972     define input parameter v-g#news           as   logical                  no-undo .
      973     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      974     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      975     do
      976     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      977     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      978     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      979     :
      980       define variable l-code-range-exist as logical   no-undo init false .
      981       define variable v-db-for-send      as character no-undo .
      982       define buffer buf_code-range  for ub.code-range .
      983       define buffer buf1_code-range for ub.code-range .
      984       define buffer buf_db          for ub.db .
      985       find first buf_code-range
      986         where buf_code-range.range-type = v-range-type
      987           and buf_code-range.last-code >= v-cur-code
      988         use-index last-codei
      989         no-error .
      990       if
      991       (
      992          available buf_code-range
      993          and
      994         (buf_code-range.db-num = v-db-num
      995           and
      996         buf_code-range.first-code <= v-cur-code
      997         )
      998       or
      999         (
     1000           v-range-type = 'drgb':U
     1001           AND
     1002           v-cur-code = 0
     1003         )
     1004      )
     1005      then do:
     1006         assign
     1007           l-code-range-exist = true
     1008         .
     1009         if v-g#news
     1010         and buf_code-range.stts = "f" then do:
     1011           assign
     1012             buf_code-range.stts = "u"
     1013           .
     1014         end.
     1015       end.
     1016       if not l-code-range-exist
     1017          and v-g#news-source-db <> 0
     1018       then do:
     1019         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1020                                       ,vss-workfile
     1021                                       ,vss-revision
     1022                                       ,vss-description
     1023                                       ,chr(10)
     1024                                       ,v-db-num
     1025                                       ,v-range-type
     1026                                       ,v-cur-code
     1027                                      ).
     1028       end.
     1029       if (not l-code-range-exist
     1030           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1031          )
     1032       and ( not can-find (first buf1_code-range no-lock
     1033                           where buf1_code-range.db-num = v-db-num
     1034                             and buf1_code-range.range-type = v-range-type
     1035                             and buf1_code-range.stts = "f"
     1036                          )
     1037           )
     1038       then do:
     1039         if v-g#db-num = 0 then do:
     1040           run new-bcod-gen-code-range in this-procedure
     1041             (input v-db-num,
     1042              input v-range-type
     1043             ) no-error .
     1044           if error-status :error then do:
     1045             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1046                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1047                                           ,v-db-num
     1048                                           ,v-range-type
     1049                                           ,v-cur-code
     1050                                           ,chr(10)
     1051                                           ,error-status:get-message(1)
     1052                                           ,return-value
     1053                                          ).
     1054           end.
     1055         end.
     1056         else do:
     1057           if v-range-type = 'sclc':U
     1058           or v-range-type = 'pglc':U
     1059           then do:
     1060             assign
     1061               v-db-for-send = "":U
     1062             .
     1063             if v-g#db-num = 0 then do:
     1064               for each buf_db no-lock
     1065                 where buf_db.db-num > 0
     1066                   and buf_db.db-num <> v-g#news-source-db
     1067               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1068               :
     1069                 assign
     1070                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1071                 .
     1072               end.
     1073               assign
     1074                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1075               .
     1076             end.
     1077             else do:
     1078               if not v-g#news then do:
     1079                 assign
     1080                   v-db-for-send = "0":U
     1081                 .
     1082               end.
     1083             end.
     1084             run nws/cr-route.p ( input 'send-cmd':U
     1085                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1086                                  "code-range":U + chr(1) +
     1087                                  (if v-range-type = 'sclc':U
     1088                                   then string( current-value(s-sclc-code, ub))
     1089                                   else string( current-value(s-pglc-code, ub))
     1090                                   ) + chr(1) +
     1091                                   v-range-type)
     1092                           ,input ?
     1093                           ,input v-db-for-send
     1094                           ) no-error .
     1095             if error-status :error then do:
     1096               undo, return error return-value.
     1097             end.
     1098           end.
     1099         end.
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure cre-loc-sc-code-range :
     1104     define input parameter v-cur-code as integer no-undo .
     1105   define input parameter p-cdrg-type as character no-undo .
     1106     do
     1107     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1108     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1109     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1110     :
     1111       define buffer buf_code-range for ub.code-range .
     1112       find first buf_code-range
     1113            where buf_code-range.range-type = p-cdrg-type
     1114              and buf_code-range.first-code >= v-cur-code
     1115            no-error .
     1116       if not available buf_code-range then do:
     1117         run new-bcod-gen-code-range in this-procedure
     1118           ( input 0,
     1119             input p-cdrg-type
     1120           ) no-error .
     1121         if error-status :error then do:
     1122           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1123                                          + "Код &2&1&3 &4"
     1124                                         , chr(10)
     1125                                         , v-cur-code
     1126                                         , error-status:get-message(1)
     1127                                         , return-value
     1128                                        ) .
     1129         end.
     1130       end.
     1131     end.
     1132   end procedure.
     1133   procedure mark-used-if-need :
     1134   define input parameter p-cur-code as integer no-undo .
     1135   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1136   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1137     do
     1138     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1139     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1140     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1141     :
     1142       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1143       define buffer buf_code-range for ub.code-range .
     1144       assign
     1145       v-db-num = if p-range-type = 'sclc':U
     1146                  then 0
     1147                  else p-db-num
     1148       .
     1149   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1150   define buffer locK-batchprocess8 for ub.batchprocess.
     1151   run gbl/lock-prc.p
     1152       (input 'lscc':U
     1153       ,input 0
     1154       ,input 0
     1155       ,input 0
     1156       ,input ""
     1157       ,input ""
     1158       ,input ""
     1159       ,input (
     1160               ",,,Вкл/выкл лок. вес. кодов"
     1161              )
     1162       ,input true
     1163       ,buffer lock-batchprocess8
     1164       ) no-error .
     1165     if error-status :error then do:
     1166       message
     1167         vss-workfile vss-revision vss-description skip
     1168         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1169         view-as alert-box error .
     1170       undo, return error .
     1171     end.
     1172       find first buf_code-range
     1173            where buf_code-range.range-type = p-range-type
     1174              and buf_code-range.first-code >= p-cur-code
     1175              and buf_code-range.last-code <= p-cur-code
     1176              and buf_code-range.db-num = v-db-num
     1177            no-error .
     1178       if not available buf_code-range then do:
     1179         message
     1180           vss-workfile vss-revision vss-description skip
     1181           "Ошибка при создании поиске диапазона" skip
     1182           "База данных" p-db-num skip
     1183           "Код" p-cur-code skip
     1184           "Тип" p-range-type
     1185           error-status :get-message(1) skip
     1186           return-value skip
     1187           view-as alert-box error .
     1188         undo, return error .
     1189       end.
     1190       if buf_code-range.stts = "f":U then do:
     1191         assign
     1192         buf_code-range.stts = "u":U
     1193         .
     1194       end.
     1195     end.
     1196   end procedure.
     1197   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   define new global shared variable g#lib-nws as handle no-undo .
     1199   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1200   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1201   procedure gen-key-rec :
     1202     define input  parameter p-tbl-name    as character no-undo.
     1203     define input  parameter p-bh_tbl-name as handle    no-undo.
     1204     define output parameter p-key-rec     as character no-undo.
     1205     do
     1206     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1207     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1208     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1209     :
     1210       define variable fh               as handle    no-undo .
     1211       define variable v-ok             as logical   no-undo .
     1212       define variable v-inform         as character no-undo .
     1213       define variable v-ind            as integer   no-undo .
     1214       define variable v-idx-field-qnty as integer   no-undo .
     1215       if p-tbl-name = ?
     1216         or p-tbl-name = "":U
     1217       then do:
     1218         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     1219       end.
     1220       if not p-bh_tbl-name:available then do:
     1221         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     1222       end.
     1223       assign
     1224         p-key-rec = p-tbl-name
     1225         v-inform  = p-bh_tbl-name:index-information(1)
     1226         v-ind     = 2
     1227       .
     1228       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1229       on error undo, return error
     1230       :
     1231         assign
     1232           v-inform = p-bh_tbl-name:index-information( v-ind )
     1233           v-ind    = v-ind + 1
     1234         .
     1235       end.
     1236       if v-inform = ?
     1237         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1238         or entry( 3, v-inform, ",":U ) <> "1":U
     1239       then do:
     1240         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     1241       end.
     1242       else do:
     1243         assign
     1244           v-idx-field-qnty = num-entries( v-inform ) - 4
     1245         .
     1246         if v-idx-field-qnty < 2 then do:
     1247           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     1248         end.
     1249         do v-ind = 1 to v-idx-field-qnty by 2
     1250         on error undo, return error
     1251         :
     1252           assign
     1253             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1254             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1255           .
     1256         end.
     1257       end.
     1258       if p-key-rec = ? then do:
     1259         assign
     1260           p-key-rec = "":U
     1261         .
     1262         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     1263       end.
     1264     end.
     1265     return.
     1266   end procedure.
     1267   procedure gen-where-keyr-tab :
     1268     define input  parameter i-tableSerach as character no-undo.
     1269     define input  parameter i-tablekey   as character  no-undo.
     1270     define input  parameter p-key-rec    as character  no-undo.
     1271     define input  parameter p-key-handle as handle     no-undo .
     1272     define input  parameter p-db-name    as character  no-undo .
     1273     define input  parameter p-tt-handle  as handle     no-undo .
     1274     define output parameter o-Where      as character  no-undo.
     1275     do
     1276     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1277     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1278     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1279     :
     1280       define variable v-full-tbl-name  as character no-undo .
     1281       define variable bh_tbl-name      as handle    no-undo .
     1282       define variable fh_key           as handle    no-undo .
     1283       define variable fh_search        as handle    no-undo .
     1284       define variable v-field-num      as integer   no-undo .
     1285       define variable v-count-fld      as integer   no-undo .
     1286       define variable v-inform         as character no-undo .
     1287       define variable v-ind            as integer   no-undo .
     1288       define variable v-idx-field-qnty as integer   no-undo .
     1289       define variable v-field-name     as character no-undo .
     1290       define variable v-field-val      as character no-undo .
     1291       define variable v-word-link      as character no-undo .
     1292       define variable vTable           as character no-undo.
     1293       define variable bh_tbl-key       as handle    no-undo .
     1294       assign
     1295         p-key-rec = trim( p-key-rec )
     1296       .
     1297       if p-key-handle <> ? then do:
     1298         if not valid-handle(p-key-handle)
     1299            or p-key-handle:type <> "buffer"
     1300         then do:
     1301           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     1302         end.
     1303         if num-entries( p-key-rec, chr(3) ) > 1
     1304           or p-key-rec = ?
     1305           or p-key-rec = "":U
     1306         then do:
     1307           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     1308         end.
     1309       end.
     1310       else do:
     1311         if p-key-rec = ?
     1312           or p-key-rec = "":U
     1313         then do:
     1314           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1315         end.
     1316       end.
     1317       assign
     1318         vTable = entry( 1 , p-key-rec, chr(3) )
     1319       .
     1320       if p-tt-handle <> ?
     1321         and ( not valid-handle(p-tt-handle)
     1322               or p-tt-handle:type <> "buffer"
     1323             )
     1324       then do:
     1325         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     1326       end.
     1327       if p-tt-handle = ? then do:
     1328         assign
     1329           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1330         .
     1331         create buffer bh_tbl-name for table v-full-tbl-name .
     1332       end.
     1333       else do:
     1334         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1335       end.
     1336       assign
     1337         v-inform = bh_tbl-name:index-information(1)
     1338         v-ind    = 2
     1339       .
     1340       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1341       on error undo, return error
     1342       :
     1343         assign
     1344           v-inform = bh_tbl-name:index-information( v-ind )
     1345           v-ind    = v-ind + 1
     1346         .
     1347       end.
     1348       if v-inform = ?
     1349         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1350         or entry( 3, v-inform, ",":U ) <> "1":U
     1351       then do:
     1352         delete object bh_tbl-name no-error.
     1353         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     1354       end.
     1355       assign
     1356         v-idx-field-qnty = num-entries( v-inform ) - 4
     1357       .
     1358       if v-idx-field-qnty < 2 then do:
     1359         delete object bh_tbl-name no-error.
     1360         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     1361       end.
     1362       assign
     1363         o-where     = "where":U
     1364         v-word-link = "":U
     1365         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1366         v-count-fld = 0
     1367       .
     1368       if i-tablekey ne "" and i-tablekey ne ?
     1369       then do:
     1370         assign
     1371           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1372         .
     1373         create buffer bh_tbl-key for table v-full-tbl-name .
     1374       end.
     1375       if i-tableSerach ne "" and i-tableSerach ne ?
     1376       then do:
     1377         delete object bh_tbl-name no-error.
     1378         assign
     1379           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1380         .
     1381         create buffer bh_tbl-name for table v-full-tbl-name .
     1382       end.
     1383       block_where:
     1384       do v-ind = 1 to v-idx-field-qnty by 2
     1385       on error undo, return error
     1386       :
     1387         assign
     1388           v-count-fld = v-count-fld + 1
     1389         .
     1390         if p-key-handle = ?
     1391           and v-count-fld > v-field-num
     1392         then do:
     1393           leave block_where.
     1394         end.
     1395         define variable VfieldKeyTable as handle no-undo.
     1396         assign
     1397           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1398           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1399         .
     1400         if     bh_tbl-key ne ?
     1401         then do:
     1402            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1403            if VfieldKeyTable eq ?
     1404            then next block_where.
     1405         end.
     1406         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1407         then
     1408            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1409         else
     1410            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1411         if p-key-handle = ? then do:
     1412           assign
     1413             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1414           .
     1415         end.
     1416         else do:
     1417           assign
     1418             fh_key = p-key-handle:buffer-field( v-field-name )
     1419           .
     1420           if fh_key = ?
     1421             or not valid-handle( fh_key )
     1422           then do:
     1423             delete object bh_tbl-name.
     1424             if     bh_tbl-key ne ?
     1425             then
     1426                delete object bh_tbl-key.
     1427             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     1428           end.
     1429           assign
     1430             v-field-val = fh_key:buffer-value
     1431           .
     1432         end.
     1433         if fh_search:data-type ="character":U then do:
     1434           assign
     1435             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1436             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1437             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1438             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1439             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1440             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1441             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1442             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1443             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1444             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1445             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1446             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1447             v-field-val = substitute( '"&1"', v-field-val )
     1448           .
     1449         end.
     1450         assign
     1451           o-where = substitute( "&1 &2", o-where, v-field-val )
     1452         .
     1453         if v-word-link = "":U then do:
     1454           assign
     1455             v-word-link = "and":U
     1456           .
     1457         end.
     1458       end.
     1459       delete object bh_tbl-name.
     1460       if     bh_tbl-key ne ?
     1461       then
     1462          delete object bh_tbl-key.
     1463       if p-key-handle = ?
     1464         and v-count-fld <> v-field-num
     1465       then do:
     1466         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     1467       end.
     1468     end.
     1469   end procedure.
     1470   procedure gen-hn-keyr-tab :
     1471     define input  parameter i-tableSerach as character no-undo.
     1472     define input  parameter i-tablekey   as character no-undo.
     1473     define input  parameter p-key-rec    as character no-undo.
     1474     define input  parameter p-key-handle as handle    no-undo .
     1475     define input  parameter p-db-name    as character no-undo .
     1476     define input  parameter p-tt-handle  as handle    no-undo .
     1477     define input  parameter p-stts-lock  as integer   no-undo .
     1478     define output parameter o-hn         as handle    no-undo.
     1479     define variable v-full-tbl-name as character no-undo.
     1480     define variable v-where         as character no-undo.
     1481     define variable bh_tbl-name     as handle    no-undo.
     1482     define variable vTable          as character no-undo.
     1483     do
     1484     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1485     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1486     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1487         run gen-where-keyr-tab(i-tableSerach,
     1488                                i-tablekey,
     1489                                p-key-rec,
     1490                                p-key-handle,
     1491                                p-db-name,
     1492                                p-tt-handle,
     1493                                output v-where).
     1494         if i-tableSerach ne "" and i-tableSerach ne ?
     1495         then do:
     1496            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1497            create buffer bh_tbl-name for table v-full-tbl-name .
     1498         end.
     1499         else do:
     1500            if p-tt-handle = ? then do:
     1501               assign
     1502                  vTable = entry( 1 , p-key-rec, chr(3) )
     1503               .
     1504               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1505               create buffer bh_tbl-name for table v-full-tbl-name .
     1506            end.
     1507            else do:
     1508               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1509            end.
     1510         end.
     1511         if p-tt-handle = ? then do:
     1512            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1513         end.
     1514         else do:
     1515            bh_tbl-name:find-first( v-where ) no-error .
     1516         end.
     1517         o-hn = bh_tbl-name.
     1518      end.
     1519   end procedure.
     1520   procedure gen-hn-keyr :
     1521     define input  parameter p-key-rec    as character no-undo.
     1522     define input  parameter p-key-handle as handle    no-undo .
     1523     define input  parameter p-db-name    as character no-undo .
     1524     define input  parameter p-tt-handle  as handle    no-undo .
     1525     define input  parameter p-stts-lock  as integer   no-undo .
     1526     define output parameter o-hn         as handle    no-undo.
     1527     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1528   end.
     1529   procedure gen-row-keyr :
     1530     define input  parameter p-key-rec    as character no-undo.
     1531     define input  parameter p-key-handle as handle    no-undo .
     1532     define input  parameter p-db-name    as character no-undo .
     1533     define input  parameter p-tt-handle  as handle    no-undo .
     1534     define input  parameter p-stts-lock  as integer   no-undo .
     1535     define output parameter p-tbl-row    as rowid     no-undo.
     1536     define output parameter p-tbl-name   as character no-undo.
     1537     define variable vHn as handle no-undo.
     1538       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1539       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1540       p-tbl-name =  vHn:table.
     1541       delete object vHn no-error.
     1542     if p-tbl-row = ? then do:
     1543       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     1544     end.
     1545     else do:
     1546       return.
     1547     end.
     1548   end procedure.
     1549   procedure gen-key-fv :
     1550     define input  parameter p-key-rec    as character no-undo .
     1551     define output parameter p-field-list as character no-undo .
     1552     define output parameter p-value-list as character no-undo.
     1553     do
     1554     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1555     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1556     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1557     :
     1558       define variable v-full-tbl-name  as character no-undo .
     1559       define variable bh_tbl-name      as handle    no-undo .
     1560       define variable v-tbl-name       as character no-undo .
     1561       define variable v-field-num      as integer   no-undo .
     1562       define variable v-count-fld      as integer   no-undo .
     1563       define variable v-inform         as character no-undo .
     1564       define variable v-ind            as integer   no-undo .
     1565       define variable v-idx-field-qnty as integer   no-undo .
     1566       define variable v-delim-key      as character no-undo .
     1567       if p-key-rec = ?
     1568         or p-key-rec = "":U
     1569       then do:
     1570         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1571       end.
     1572       assign
     1573         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1574         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1575       .
     1576       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1577       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     1578       assign
     1579         v-inform = bh_tbl-name:index-information(1)
     1580         v-ind    = 2
     1581       .
     1582       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1583       on error undo, return error
     1584       :
     1585         assign
     1586           v-inform = bh_tbl-name:index-information( v-ind )
     1587           v-ind    = v-ind + 1
     1588         .
     1589       end.
     1590       if v-inform = ?
     1591         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1592         or entry( 3, v-inform, ",":U ) <> "1":U
     1593       then do:
     1594         delete object bh_tbl-name no-error.
     1595         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1596       end.
     1597       assign
     1598         v-idx-field-qnty = num-entries( v-inform ) - 4
     1599       .
     1600       if v-idx-field-qnty < 2 then do:
     1601         delete object bh_tbl-name no-error.
     1602         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1603       end.
     1604       assign
     1605         p-field-list = "":U
     1606         p-value-list = "":U
     1607         v-delim-key  = "":U
     1608         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1609         v-count-fld  = 0
     1610       .
     1611       block_where:
     1612       do v-ind = 1 to v-idx-field-qnty by 2
     1613       on error undo, return error
     1614       :
     1615         assign
     1616           v-count-fld = v-count-fld + 1
     1617         .
     1618         if v-count-fld > v-field-num then do:
     1619           leave block_where.
     1620         end.
     1621         assign
     1622           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1623           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1624         .
     1625         if v-ind = 1 then do:
     1626           assign
     1627             v-delim-key = chr(3)
     1628           .
     1629         end.
     1630       end.
     1631       delete object bh_tbl-name.
     1632       if v-count-fld <> v-field-num then do:
     1633         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure gen-key-field :
     1638     define input  parameter p-table      as character no-undo .
     1639     define output parameter p-field-list as character no-undo .
     1640     do
     1641     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1642     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1643     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1644     :
     1645       define variable v-full-tbl-name  as character no-undo .
     1646       define variable bh_tbl-name      as handle    no-undo .
     1647       define variable v-tbl-name       as character no-undo .
     1648       define variable v-field-num      as integer   no-undo .
     1649       define variable v-count-fld      as integer   no-undo .
     1650       define variable v-inform         as character no-undo .
     1651       define variable v-ind            as integer   no-undo .
     1652       define variable v-idx-field-qnty as integer   no-undo .
     1653       define variable v-delim-key      as character no-undo .
     1654       if p-table = ?
     1655         or p-table = "":U
     1656       then do:
     1657         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     1658       end.
     1659       assign
     1660         v-tbl-name      = p-table
     1661         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1662       .
     1663       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1664       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     1665       assign
     1666         v-inform = bh_tbl-name:index-information(1)
     1667         v-ind    = 2
     1668       .
     1669       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1670       on error undo, return error
     1671       :
     1672         assign
     1673           v-inform = bh_tbl-name:index-information( v-ind )
     1674           v-ind    = v-ind + 1
     1675         .
     1676       end.
     1677       if v-inform = ?
     1678         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1679         or entry( 3, v-inform, ",":U ) <> "1":U
     1680       then do:
     1681         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1682       end.
     1683       assign
     1684         v-idx-field-qnty = num-entries( v-inform ) - 4
     1685       .
     1686       if v-idx-field-qnty < 2 then do:
     1687         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1688       end.
     1689       assign
     1690         p-field-list = "":U
     1691         v-delim-key  = "":U
     1692         v-count-fld  = 0
     1693       .
     1694       block_where:
     1695       do v-ind = 1 to v-idx-field-qnty by 2
     1696       on error undo, return error
     1697       :
     1698         assign
     1699           v-count-fld = v-count-fld + 1
     1700         .
     1701         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1702         if v-ind = 1 then do:
     1703           assign
     1704             v-delim-key = chr(3)
     1705           .
     1706         end.
     1707       end.
     1708       delete object bh_tbl-name.
     1709     end.
     1710   end procedure.
     1711   define SHARED temp-table temp-cmd no-undo
     1712   field cmd-code as integer
     1713   field db-list as character
     1714   index pi is unique primary
     1715   db-list
     1716   index icmd
     1717   cmd-code
     1718   .
     1719   define SHARED temp-table temp-smart-route no-undo
     1720   field key-field as character
     1721   field db-num as integer
     1722   index pi is unique primary
     1723   key-field
     1724   db-num
     1725   .
     1726   define SHARED temp-table temp-no-route no-undo
     1727   field rec-ord as integer
     1728   field db-num as integer
     1729   index pi is unique primary
     1730   db-num
     1731   rec-ord
     1732   index iro
     1733   rec-ord
     1734   .
     1735   define SHARED temp-table temp-smart-link no-undo
     1736   field uniq-key-rec as character
     1737   field key-field as character
     1738   field rec-ord as integer
     1739   field is-smart as logical
     1740   index pi is unique primary
     1741   key-field
     1742   uniq-key-rec
     1743   rec-ord
     1744   index iu
     1745   uniq-key-rec
     1746   index iro
     1747   rec-ord
     1748   .
     1749   define SHARED temp-table temp-nws-outline no-undo
     1750   like ub.nws-outline.
     1751   procedure create-smart-route :
     1752   define input parameter p-key-field as character no-undo .
     1753   define input parameter p-db-num as integer no-undo .
     1754   define buffer buf_temp-smart-route for temp-smart-route.
     1755     do
     1756     on error undo, return error
     1757     :
     1758       find first buf_temp-smart-route where
     1759                 buf_temp-smart-route.key-field = p-key-field
     1760             and buf_temp-smart-route.db-num = p-db-num no-error.
     1761       if not available buf_temp-smart-route then do:
     1762         create buf_temp-smart-route.
     1763         assign
     1764         buf_temp-smart-route.key-field = p-key-field
     1765         buf_temp-smart-route.db-num = p-db-num
     1766         .
     1767       end.
     1768     end.
     1769   end procedure.
     1770   procedure create-smart-route-link :
     1771   define input parameter p-tbl-name as character no-undo .
     1772   define input parameter p-bh_tbl-name as handle no-undo .
     1773   define input parameter p-key-field as character no-undo .
     1774   define input parameter p-rec-ord as integer no-undo .
     1775   define input parameter p-is-smart as logical no-undo .
     1776   define variable v-key-rec as character no-undo .
     1777   define buffer buf_temp-smart-link for temp-smart-link.
     1778     do
     1779     on error undo, return error
     1780     :
     1781       run gen-key-rec in this-procedure ( input p-tbl-name
     1782                                          ,input p-bh_tbl-name
     1783                                          ,output v-key-rec     ).
     1784      find first buf_temp-smart-link where
     1785                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1786              and buf_temp-smart-link.key-field = p-key-field
     1787              and buf_temp-smart-link.rec-ord = p-rec-ord
     1788              no-error .
     1789      if not available buf_temp-smart-link then do:
     1790        create buf_temp-smart-link.
     1791        assign
     1792        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1793        buf_temp-smart-link.key-field = p-key-field
     1794        buf_temp-smart-link.rec-ord = p-rec-ord
     1795        buf_temp-smart-link.is-smart = p-is-smart
     1796        .
     1797      end.
     1798     end.
     1799   end procedure.
     1800   procedure create-nws-outline :
     1801   define input parameter p-cmd-proc-handle as handle no-undo .
     1802   define input parameter p-cmd-code as integer no-undo .
     1803   define input parameter p-outline-type as character no-undo .
     1804   define input parameter p-charkey_one as character no-undo .
     1805   define input parameter p-charkey_two as character no-undo .
     1806   define input parameter p-charkey_three as character no-undo .
     1807   define input parameter p-key#_one as integer no-undo .
     1808   define input parameter p-key#_two as integer no-undo .
     1809   define input parameter p-key#_three as integer no-undo .
     1810   define variable v-no-id as integer no-undo .
     1811   define variable v-rec-ord as integer no-undo .
     1812     do
     1813     on error undo, return error return-value
     1814     :
     1815       find last temp-nws-outline use-index pi no-error .
     1816       v-no-id = (if available temp-nws-outline
     1817                  then (temp-nws-outline.no-id  + 1)
     1818                  else 1).
     1819       create temp-nws-outline.
     1820       assign
     1821       temp-nws-outline.charkeY_one = p-charkey_one
     1822       temp-nws-outline.charkeY_two = p-charkey_two
     1823       temp-nws-outline.charkeY_three = p-charkey_three
     1824       temp-nws-outline.key#_one = p-key#_one
     1825       temp-nws-outline.key#_two = p-key#_two
     1826       temp-nws-outline.key#_three = p-key#_three
     1827       temp-nws-outline.no-id = v-no-id
     1828       temp-nws-outline.outline-type = p-outline-type
     1829       .
     1830                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1831       run  create-smart-route in this-procedure (
     1832                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1833                                                  ,input -1).
     1834       run create-smart-route-link in this-procedure (
     1835                                                      input 'nws-outline':U
     1836                                                     ,input (buffer temp-nws-outline:handle)
     1837                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1838                                                     ,input v-rec-ord
     1839                                                     ,input no
     1840                                                     ).
     1841     end.
     1842   end procedure.
     1843   procedure create-no-route :
     1844   define input parameter p-rec-ord as integer no-undo .
     1845   define input parameter p-db-num as integer no-undo .
     1846   define buffer buf_temp-no-route for temp-no-route.
     1847   do
     1848   on error undo, return error
     1849   :
     1850      find first buf_temp-no-route where
     1851                 buf_temp-no-route.rec-ord = p-rec-ord
     1852              and buf_temp-no-route.db-num = p-db-num no-error .
     1853      if not available buf_temp-no-route then do:
     1854        create buf_temp-no-route.
     1855        assign
     1856        buf_temp-no-route.rec-ord = p-rec-ord
     1857        buf_temp-no-route.db-num = p-db-num
     1858        .
     1859      end.
     1860   end.
     1861   end procedure.
     1862   procedure clear-from-rec-ord :
     1863   define input parameter p-rec-ord as integer no-undo .
     1864   define buffer buf_temp-no-route for temp-no-route.
     1865   define buffer buf_temp-smart-link for temp-smart-link.
     1866   do
     1867   on error undo, return error
     1868   :
     1869   for each buf_temp-no-route where
     1870           buf_temp-no-route.rec-ord > p-rec-ord:
     1871     delete buf_temp-no-route.
     1872   end.
     1873   for each buf_temp-smart-link where
     1874           buf_temp-smart-link.rec-ord > p-rec-ord:
     1875      delete buf_temp-smart-link.
     1876   end.
     1877   end.
     1878   end procedure.
