     2488   function 00040000_get-error-message returns character :
     2489   define variable v-ii as integer no-undo .
     2490   define variable v-mess as character no-undo .
     2491   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2492       v-mess = substitute("&1&2ош &3"
     2493                           ,v-mess
     2494                           ,chr(10)
     2495                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     2496   END.
     2497   return v-mess.
     2498   end function.
