     2533         "Не определен клиент" skip
     2534         view-as alert-box error .
     2535       undo, return error .
     2536     end.
     2537     find first buf_temp-hist-nws-option where
     2538               buf_temp-hist-nws-option.table-name = 'clients':U
     2539           and buf_temp-hist-nws-option.db-num = g#db-num no-error .
     2540     if not available buf_temp-hist-nws-option then do:
     2541       find first last_temp-hist-nws-option where
