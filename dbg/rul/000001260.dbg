     4028   end.
     4029   end.
     4030           end.
     4031         end.
     4032         v-retry-action = 0 .
     4033        _release:
     4034         do on error undo, retry:
     4035           if  retry
     4036           or v-retry
     4037           then do:
     4038             v-retry-action = v-retry-action + 1.
     4039             run write-log-and-file in p-log-handle (
     4040                                                     input 1
     4041                                                   , input log-file-name
     4042                                                   , input 1
     4043                                                   , input substitute("&1&2&3"
     4044                                                                     , error-status:get-message(1)
     4045                                                                     , chr(10)
     4046                                                                     , v-last-error-message )).
     4047           end.
     4048   if v-retry-action < 1 then do:
     4049   Client1:Clients_release_ ( ) .
     4050   end.
     4051   if v-retry-action < 2 then do:
     4052   Card1:Dis-card_release_ ( ) .
     4053   end.
     4054   if v-retry-action < 3 then do:
     4055   Dis-card-type1:Dis-card-type_release_ ( ) .
     4056   end.
     4057   if v-retry-action < 4 then do:
     4058   Import-sum-obj1:Dis-card-sale_objrelease_ ( ) .
     4059   end.
     4060   if v-retry-action < 5 then do:
     4061   Tot-sum1:Dis-tot_release_ ( ) .
     4062   end.
     4063         end.
     4064         if v-retry-action = 0 then do:
     4065           num-rec-ok = num-rec-ok + 1.
     4066         end.
     4067         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4068         process events.
     4069         run get-stop-state in p-log-handle ( output v-stop) no-error .
     4070         if v-stop then do:
     4071             run write-log-and-file in p-log-handle (
     4072                                                     input 1
     4073                                                   , input log-file-name
     4074                                                   , input 1
     4075                                                   , input substitute("Процесс импорта прерван пользователем")).
     4076            leave _stroka.
     4077         end.
     4078         if num-rec modulo 100 = 0 then do:
     4079           run write-log-and-file in p-log-handle (
     4080                                                   input 1
     4081                                                 , input log-file-name
     4082                                                 , input 1
     4083                                                 , input substitute("Записи &1-&2: сохранение/пересылка в СПН...", num-rec - 100, num-rec)).
     4084           find first buf_temp-cmd use-index pi.
     4085           run after-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     4086           if error-status:error then do:
     4087                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).                      assign v-view-log = yes.
     4088             undo _main, return error .
     4089           end.
     4090           run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     4091           if error-status:error then do:
     4092                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).                      assign v-view-log = yes.
     4093           end.
     4094           find first buf_temp-cmd use-index pi.
     4095           p-cmd-code = buf_temp-cmd.cmd-code.
     4096         end.
     4097       end.
     4098       if not v-stop then do:
     4099         num-rec = num-rec - 1.
     4100       end.
     4101       input stream instream close.
     4102       run write-log-and-file in p-log-handle (
     4103             input 1
     4104           , input log-file-name
     4105           , input 1
     4106                                             , input substitute("Записи &1-&2: сохранение/пересылка в СПН..."
     4107                                             , (num-rec - num-rec modulo 100 + 1), num-rec)).
     4108       find first buf_temp-cmd use-index pi.
     4109       run after-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     4110       if error-status:error then do:
     4111               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                   , chr(10)                                   , error-status:get-message(1)                                   , return-value )).                      assign v-view-log = yes.
     4112         undo _main, return error .
     4113       end.
     4114       run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     4115       if error-status:error then do:
     4116               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                   , chr(10)                                   , error-status:get-message(1)                                   , return-value )).                      assign v-view-log = yes.
     4117       end.
     4118       find first buf_temp-cmd use-index pi.
     4119       p-cmd-code = buf_temp-cmd.cmd-code.
     4120       run write-log-and-file in p-log-handle (
     4121             input 1
     4122           , input log-file-name
     4123           , input 1
     4124           , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4125     end.
     4126   end procedure.
     4127   procedure load-ruleset-context :
     4128   define input parameter p-ruleset-id as integer no-undo .
     4129   define buffer buf_rule-call-param for tt0-rule-call-param.
     4130     do
     4131     on error undo, return error
     4132     :
     4133    find first buf_rule-call-param no-lock where
     4134   buf_rule-call-param.codex_id = p-codex-id
     4135   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4136   and buf_rule-call-param.call_id = p-call-id
     4137   and buf_rule-call-param.order_id = p-order-id
     4138   and buf_rule-call-param.rule_id = p-rule-id
     4139   and buf_rule-call-param.param-name = "p-dis-tot-obj-code"
     4140    no-error.
     4141   if available buf_rule-call-param then do:
     4142   assign p-dis-tot-obj-code = buf_rule-call-param.param-value-integer.
     4143   end.
     4144    find first buf_rule-call-param no-lock where
     4145   buf_rule-call-param.codex_id = p-codex-id
     4146   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4147   and buf_rule-call-param.call_id = p-call-id
     4148   and buf_rule-call-param.order_id = p-order-id
     4149   and buf_rule-call-param.rule_id = p-rule-id
     4150   and buf_rule-call-param.param-name = "p-issue-code"
     4151    no-error.
     4152   if available buf_rule-call-param then do:
     4153   assign p-issue-code = buf_rule-call-param.param-value-integer.
     4154   end.
     4155    find first buf_rule-call-param no-lock where
     4156   buf_rule-call-param.codex_id = p-codex-id
     4157   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4158   and buf_rule-call-param.call_id = p-call-id
     4159   and buf_rule-call-param.order_id = p-order-id
     4160   and buf_rule-call-param.rule_id = p-rule-id
     4161   and buf_rule-call-param.param-name = "p-issue-date"
     4162    no-error.
     4163   if available buf_rule-call-param then do:
     4164   assign p-issue-date = buf_rule-call-param.param-value-date.
     4165   end.
     4166    find first buf_rule-call-param no-lock where
     4167   buf_rule-call-param.codex_id = p-codex-id
     4168   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4169   and buf_rule-call-param.call_id = p-call-id
     4170   and buf_rule-call-param.order_id = p-order-id
     4171   and buf_rule-call-param.rule_id = p-rule-id
     4172   and buf_rule-call-param.param-name = "p-valid-date"
     4173    no-error.
     4174   if available buf_rule-call-param then do:
     4175   assign p-valid-date = buf_rule-call-param.param-value-date.
     4176   end.
     4177    find first buf_rule-call-param no-lock where
     4178   buf_rule-call-param.codex_id = p-codex-id
     4179   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4180   and buf_rule-call-param.call_id = p-call-id
     4181   and buf_rule-call-param.order_id = p-order-id
     4182   and buf_rule-call-param.rule_id = p-rule-id
     4183   and buf_rule-call-param.param-name = "p-cli-grp-code"
     4184    no-error.
     4185   if available buf_rule-call-param then do:
     4186   assign p-cli-grp-code = buf_rule-call-param.param-value-integer.
     4187   end.
     4188    find first buf_rule-call-param no-lock where
     4189   buf_rule-call-param.codex_id = p-codex-id
     4190   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4191   and buf_rule-call-param.call_id = p-call-id
     4192   and buf_rule-call-param.order_id = p-order-id
     4193   and buf_rule-call-param.rule_id = p-rule-id
     4194   and buf_rule-call-param.param-name = "p-lim-cr"
     4195    no-error.
     4196   if available buf_rule-call-param then do:
     4197   assign p-lim-cr = buf_rule-call-param.param-value-decimal.
     4198   end.
     4199    find first buf_rule-call-param no-lock where
     4200   buf_rule-call-param.codex_id = p-codex-id
     4201   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4202   and buf_rule-call-param.call_id = p-call-id
     4203   and buf_rule-call-param.order_id = p-order-id
     4204   and buf_rule-call-param.rule_id = p-rule-id
     4205   and buf_rule-call-param.param-name = "p-category"
     4206    no-error.
     4207   if available buf_rule-call-param then do:
     4208   assign p-category = buf_rule-call-param.param-value-integer.
     4209   end.
     4210       case p-ruleset-id:
     4211         when 1 then do:
     4212           for each buf_cash-pay no-lock where
     4213                  buf_cash-pay.curr-code = 0
     4214           by buf_cash-pay.cdpay-code:
     4215              if buf_cash-pay.is-cash then do:
     4216                leave.
     4217              end.
     4218           end.
     4219           if not available buf_cash-pay then do:
     4220             run write-log-and-file in p-log-handle (
     4221                   input 1
     4222                 , input log-file-name
     4223                 , input 1
     4224                 , input substitute("Не найдено ни одного типа кассового платежа с валютой &1 и свойством <НАЛИЧНЫЕ>,&2" +
     4225                                    "к которому можно привязать импортируемые суммы покупок по ДК"
     4226                                    , 0
     4227                                    , chr(10)
     4228                                    )).
     4229             assign
     4230             v-view-log = yes.
     4231             .
     4232             return error.
     4233           end.
     4234           assign
     4235           v-sign = 1
     4236           v-current-host-code = p-host-code
     4237           v-current-obj-type = p-obj-type
     4238           v-current-obj-code = p-obj-code
     4239           v-current-doc-code = p-doc-code
     4240           v-current-db-num = g#db-num
     4241           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4242           v-current-date = p-doc-date
     4243           file-name  = p-process-file-name
     4244           .
     4245           if NOT g#db-num = 0 then do:
     4246             run write-log-and-file in p-log-handle (
     4247                   input 1
     4248                 , input log-file-name
     4249                 , input 1
     4250                 , input substitute("Импорт клиентов и их дисконтных карт возможен только в ГБД")).
     4251             assign
     4252             v-view-log = yes.
     4253             .
     4254             return "return".
     4255           end.
     4256           run gbl/filename.p (
     4257                           input  file-name
     4258                           ,output v-full-path
     4259                           ,output v-path
     4260                           ,output v-file-name
     4261                           ,output v-file-name-no-ext
     4262                           ,output v-file-name-ext
     4263                           ) no-error .
     4264           if error-status:error then do:
     4265             run write-log-and-file in p-log-handle (
     4266                   input 1
     4267                 , input log-file-name
     4268                 , input 1
     4269                 , input substitute("Не найден файл для импорта физ.лиц/ДК &1", file-name)).
     4270             assign
     4271             v-view-log = yes.
     4272             .
     4273             return "return".
     4274           end.
     4275           assign
     4276           file-name = v-full-path.
     4277           run gbl/filnline.p (
     4278                         input file-name
     4279                         ,output v-end-new-line).
     4280           if v-end-new-line = no then do:
     4281             output stream Instream to value(file-name) append.
     4282             put stream instream unformatted skip(1).
     4283             output stream Instream close.
     4284           end.
     4285         end.
     4286       end case.
     4287     end.
     4288   end procedure.
     4289   procedure 00040000_set-vpay-chk  :
     4290   define input parameter p-bh as handle no-undo .
     4291   define buffer buf_vchk-pay for vchk-pay.
     4292   find first buf_vchk-pay no-lock where
     4293             buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     4294         and buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     4295         and buf_vchk-pay.curr-code = 0
     4296         and buf_vchk-pay.doc-date = v-current-date
     4297         and buf_vchk-pay.cre-pay = no
     4298         and buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     4299         and buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     4300         no-error .
     4301    if not available buf_vchk-pay then do:
     4302      create buf_vchk-pay.
     4303      assign
     4304      buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     4305      buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     4306      buf_vchk-pay.curr-code = 0
     4307      buf_vchk-pay.doc-date = v-current-date
     4308      buf_vchk-pay.cre-pay = no
     4309      buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     4310      buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     4311      .
     4312    end.
     4313    assign
     4314    buf_vchk-pay.tot-sum = buf_vchk-pay.tot-sum + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     4315    buf_vchk-pay.tot-base = buf_vchk-pay.tot-base + p-bh:buffer-field("pay-tot-base"):buffer-value
     4316    buf_vchk-pay.tot-rubl = buf_vchk-pay.tot-rubl + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     4317    .
     4318   end procedure.
     4319   procedure create_clients_:
     4320   define input parameter p-obj-type as character no-undo .
     4321   define input parameter p-obj-code as integer no-undo .
     4322   define buffer buf_temp-clients_ for temp-clients_.
     4323   find first buf_temp-clients_ where
     4324             buf_temp-clients_.obj-type = p-obj-type
     4325        and  buf_temp-clients_.obj-code = p-obj-code no-error .
     4326   if not available buf_temp-clients_ then do:
     4327     create buf_temp-clients_.
     4328     assign
     4329     buf_temp-clients_.obj-type = p-obj-type
     4330     buf_temp-clients_.obj-code = p-obj-code
     4331     .
     4332   end.
     4333   end procedure.
     4334   procedure create_dis-card_:
     4335   define input parameter p-d-card as character no-undo .
     4336   define buffer buf_temp-dis-card_ for temp-dis-card_.
     4337   find first buf_temp-dis-card_ where
     4338             buf_temp-dis-card_.d-card = p-d-card no-error .
     4339   if not available buf_temp-dis-card_ then do:
     4340     create buf_temp-dis-card_.
     4341     assign
     4342     buf_temp-dis-card_.d-card = p-d-card
     4343     .
     4344   end.
     4345   end procedure.
     4346   procedure can-find_clients_  :
     4347   define input parameter p-obj-type as character no-undo .
     4348   define input parameter p-obj-code as integer no-undo .
     4349   define output parameter p-find as logical no-undo .
     4350   find first temp-clients_ where
     4351                        temp-clients_.obj-type = p-obj-type
     4352                    and temp-clients_.obj-code = p-obj-code no-error.
     4353   p-find = available temp-clients_.
     4354   end procedure.
     4355   procedure can-find_dis-card_  :
     4356   define input parameter p-d-card as character no-undo .
     4357   define output parameter p-find as logical no-undo .
     4358   find first temp-dis-card_ where
     4359                        temp-dis-card_.d-card = p-d-card no-error.
     4360   p-find = available temp-dis-card_.
     4361   end procedure.
     4362   procedure delete-procedure :
     4363     do
     4364     on error undo, return error
     4365     :
     4366         for each temp-clients_:
     4367           delete temp-clients_.
     4368         end.
     4369         for each temp-dis-card_:
     4370           delete temp-dis-card_.
     4371         end.
     4372         run garbcoll_clear in this-procedure .
     4373     end.
     4374   end procedure.
