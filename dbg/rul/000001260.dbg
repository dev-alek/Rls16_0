      153   define  variable garbcoll_ii as integer no-undo .
      154   define  temp-table temp-gc no-undo
      155   field ii as integer
      156   field obj-r as handle
      157   field cn as character
      158   index pi is unique primary
      159   ii
      160   index icn
      161   cn.
      162   procedure garbcoll_create-gc-entry :
      163   define input parameter p-cn as character no-undo .
      164   define input parameter p-obj-r as handle no-undo .
      165     do
      166     on error undo, return error
      167     :
      168       create temp-gc.
      169       assign
      170       temp-gc.ii = garbcoll_ii
      171       garbcoll_ii = garbcoll_ii + 1
      172       temp-gc.cn = p-cn
      173       temp-gc.obj-r = p-obj-r
      174       .
      175     end.
      176   end procedure.
      177   procedure garbcoll_clear :
      178     do
      179     on error undo, return error
      180     :
      181       for each temp-gc:
      182         delete object temp-gc.obj-r.
      183         delete temp-gc.
      184       end.
      185     end.
      186   end procedure.
      187   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   procedure cur-time :
      189      define output parameter p-today as date      no-undo .
      190      define output parameter p-time  as integer   no-undo .
      191     do
      192     on error undo, return error
      193     :
      194       define variable v-date1 as date      no-undo .
      195       define variable v-date2 as date      no-undo .
      196       define variable v-time  as integer   no-undo .
      197       assign
      198         v-date1 = today
      199         v-time  = time
      200         v-date2 = today
      201       .
      202       if v-date1 <> v-date2
      203       then do:
      204         assign
      205           v-date1 = today
      206           v-time  = v-time
      207         .
      208       end.
      209       assign
      210         p-today = v-date1
      211         p-time  = v-time
      212       .
      213     end.
      214   end.
      215   function cur-time-date returns character
      216   :
      217     return string(today, '99/99/9999':U) .
      218   end.
      219   function cur-time-mjd returns decimal
      220   :
      221     define variable v-date as date      no-undo .
      222     define variable v-time as integer   no-undo .
      223     run cur-time in this-procedure
      224       (output v-date
      225       ,output v-time
      226       ) .
      227     return integer(v-date) - 2400002 + (v-time / 86400) .
      228   end.
      229   function cur-time-get-ending-index returns integer
      230   (input p-number as integer
      231   )
      232   :
      233     if p-number < 0
      234     or p-number = ?
      235     then do:
      236       return 1 .
      237     end.
      238     define variable v-rest as integer   no-undo .
      239     assign
      240       p-number = p-number modulo 100
      241     .
      242     if p-number < 20
      243     then do:
      244       assign
      245         v-rest = p-number
      246       .
      247     end.
      248     else do:
      249       assign
      250         v-rest = p-number modulo 10
      251       .
      252     end.
      253     case v-rest :
      254       when 1
      255       then do:
      256         return 2 .
      257       end.
      258       when 2 or
      259       when 3 or
      260       when 4
      261       then do:
      262         return 3 .
      263       end.
      264       otherwise do:
      265         return 1 .
      266       end.
      267     end case .
      268   end.
      269   procedure cur-time-mjd-to-date :
      270      define input  parameter i-mjd-diff as decimal no-undo.
      271      define output parameter o-Date     as date    no-undo.
      272      define output parameter o-Time     as integer no-undo.
      273      define variable v-day-number as integer   no-undo .
      274      if    i-mjd-diff < 0
      275         or i-mjd-diff = ?
      276      then do:
      277         return "?" .
      278      end.
      279      assign
      280         v-day-number = truncate(i-mjd-diff,0).
      281         o-Date = date(v-day-number + 2400002).
      282         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      283     .
      284   end.
      285   function cur-time-mjd-to-string returns character
      286   (input p-mjd-diff as decimal
      287   )
      288   :
      289     define variable v-day-number as integer   no-undo .
      290     define variable v-seconds    as integer   no-undo .
      291     define variable v-hour       as integer   no-undo .
      292     define variable v-min        as integer   no-undo .
      293     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      294     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      295     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      296     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      297     if p-mjd-diff < 0
      298     or p-mjd-diff = ?
      299     then do:
      300       return "?" .
      301     end.
      302     assign
      303       v-day-number = integer(truncate(p-mjd-diff,0))
      304       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      305     .
      306     if v-seconds > 86400
      307     then do:
      308       assign
      309         v-seconds = 86400 - 1
      310       .
      311     end.
      312     if v-seconds < 0
      313     then do:
      314       assign
      315         v-seconds = 0
      316       .
      317     end.
      318     assign
      319       v-hour = truncate(v-seconds / 3600, 0)
      320     .
      321     assign
      322       v-seconds = v-seconds modulo 3600
      323     .
      324     assign
      325       v-min = truncate(v-seconds / 60, 0)
      326     .
      327     assign
      328       v-seconds = v-seconds modulo 60
      329     .
      330     return
      331         (if v-day-number <> 0
      332           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      333           else ""
      334         )
      335       + (if v-day-number <> 0 or v-hour <> 0
      336           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      337           else ""
      338         )
      339       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      340           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      341           else ""
      342         )
      343       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      344       .
      345   end.
      346   function cur-time-string returns character
      347   :
      348     define variable v-date as date      no-undo .
      349     define variable v-time as integer   no-undo .
      350     run cur-time in this-procedure
      351       (output v-date
      352       ,output v-time
      353       ) .
      354     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      355   end.
      356   function cur-time-string-sec returns character
      357   :
      358     define variable v-date as date      no-undo .
      359     define variable v-time as integer   no-undo .
      360     run cur-time in this-procedure
      361       (output v-date
      362       ,output v-time
      363       ) .
      364     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      365   end.
      366   function cur-time-custom  returns character
      367   (input p-prefix as character
      368   ,input p-date-format as character
      369   ,input p-delimiter as character
      370   ,input p-time-format as character
      371   ,input p-suffix as character
      372   )
      373   :
      374     define variable v-date as date      no-undo .
      375     define variable v-time as integer   no-undo .
      376     run cur-time in this-procedure
      377       (output v-date
      378       ,output v-time
      379       ) .
      380     return
      381       p-prefix
      382       + string(v-date, p-date-format)
      383       + p-delimiter
      384       + string(v-time, p-time-format)
      385       + p-suffix
      386       .
      387   end.
      388   function cur-time-print  returns character
      389   :
      390     define variable v-date as date      no-undo .
      391     define variable v-time as integer   no-undo .
      392     run cur-time in this-procedure
      393       (output v-date
      394       ,output v-time
      395       ) .
      396     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      397   end.
      398   function cur-time-datetime returns datetime
      399   :
      400     define variable v-char as character no-undo .
      401     define variable v-datetime as datetime no-undo .
      402     v-char = cur-time-string().
      403     v-datetime = datetime(v-char).
      404     return  v-datetime.
      405   end.
      406   function cur-time-string-msec returns character
      407   :
      408     define variable v-date as datetime  no-undo .
      409     v-date = now.
      410     return string(v-date) .
      411   end.
