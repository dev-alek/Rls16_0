     4419   procedure 00040000_after-import :
     4420   define input  parameter p-d-card as character no-undo .
     4421   define variable v-ii as integer   no-undo .
     4422   define variable v-jj as integer   no-undo .
     4423   define variable v-codex-id as integer   no-undo .
     4424   define variable v-ruleset-id as integer   no-undo .
     4425   define variable v-ai-ruleset-id-list as character no-undo extent 4.
     4426   define variable v-ai-codex-id-list as character no-undo .
     4427   define variable v-proc-name as character no-undo .
     4428   define buffer buf_temp-d-card for temp-d-card.
     4429   define buffer buf_Dis-card for ub.dis-card.
     4430   define buffer buf_import-temp-d-card for import-temp-d-card.
     4431   define buffer buf_rule-by-call for ub.rule-by-call.
     4432     main-block:
     4433     do
     4434     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4435     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4436     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4437     :
     4438         assign
     4439         v-ai-codex-id-list = (if g#db-num = 0
     4440                            then "1,2"
     4441                            else '':U)
     4442         v-ai-ruleset-id-list[1] = string(5)
     4443         v-ai-ruleset-id-list[2] = "6,5"
     4444         v-ai-ruleset-id-list[3] = ''
     4445         .
     4446         find first buf_temp-d-card where
     4447                  buf_temp-d-card.d-card = p-d-card no-error.
     4448         if not available buf_temp-d-card then do:
     4449           find first buf_Dis-card exclusive-lock where
     4450                     buf_dis-card.d-card = p-d-card no-error.
     4451           if not available  buf_dis-card then do:
     4452             undo main-block, return error substitute("ДК &1 не найдена").
     4453           end.
     4454         end.
     4455         create buf_import-temp-d-card.
     4456         if available buf_temp-d-card then do:
     4457           buffer-copy buf_temp-d-card to buf_import-temp-d-card.
     4458         end.
     4459         else do:
     4460           buffer-copy buf_dis-card to buf_import-temp-d-card
     4461           assign
     4462           buf_import-temp-d-card.obj-type = p-obj-type
     4463           buf_import-temp-d-card.obj-code = p-obj-code
     4464           buf_import-temp-d-card.host-code = p-host-code
     4465           .
     4466         end.
     4467         release buf_temp-d-card.
     4468         _codex:
     4469         do v-jj = 1 to num-entries(v-ai-codex-id-list):
     4470           if entry(v-jj, v-ai-codex-id-list) = '':U then next _codex.
     4471           v-codex-id = integer(entry(v-jj, v-ai-codex-id-list)).
     4472           do v-ii = 1 to num-entries(v-ai-ruleset-id-list[v-jj]):
     4473              if entry(v-ii, v-ai-ruleset-id-list[v-jj]) = '':U then next.
     4474              v-ruleset-id = integer(entry(v-ii, v-ai-ruleset-id-list[v-jj])).
     4475             _rule-by-call:
     4476             for each buf_rule-by-call no-lock where
     4477                       buf_rule-by-call.call_id = p-call-id
     4478                 and buf_rule-by-call.can-calc = yes
     4479                 and buf_rule-by-call.codex_id = v-codex-id
     4480                 and buf_rule-by-call.ruleset_id = v-ruleset-id
     4481             by buf_rule-by-call.call_Id
     4482             by buf_rule-by-call.codex_id
     4483             by buf_rule-by-call.ruleset_id
     4484             by buf_rule-by-call.order_id
     4485             on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4486             on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4487             on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ) :
     4488               if not (buf_rule-by-call.profile_id = p-profile-id
     4489                       or
     4490                       buf_rule-by-call.profile_id = 1
     4491                       )
     4492               then next _rule-by-call.
     4493               v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     4494               run value(v-proc-name)  (
     4495                                                              input parparentproc
     4496                                                             ,input p-parent-handle
     4497                                                             ,input p-log-handle
     4498                                                             ,input p-cont-handle
     4499                                                             ,input v-codex-id
     4500                                                             ,input v-ruleset-id
     4501                                                             ,input p-call-id
     4502                                                             ,input buf_rule-by-call.order_id
     4503                                                             ,input buf_rule-by-call.rule_id
     4504                                                             ,input buf_rule-by-call.profile
     4505                                                             ,input buf_rule-by-call.is_dynamic
     4506                                                             ,input p-doc-type
     4507                                                             ,input buf_import-temp-d-card.host-code
     4508                                                             ,input buf_import-temp-d-card.obj-type
     4509                                                             ,input buf_import-temp-d-card.obj-code
     4510                                                             ,input p-doc-code
     4511                                                             ,input p-process-file-name
     4512                                                             ,input p-doc-date
     4513                                                             ,input p-fact-date
     4514                                                             ,input p-save
     4515                                                             ,input v-curr-r-b
     4516                                                             ,input p-cmd-proc-handle
     4517                                                             ,input p-cmd-code
     4518                                                             ,input p-type
     4519                                                             ,input p-emitent-host-code
     4520                                                             ,input table import-temp-d-card
     4521                                                             ) no-error .
     4522           if error-status:error then do:
     4523             undo main-block, return error substitute("Ошибка при выполнении правила &1 ( профайл &2) для ДК &3&4&5&4&6"
     4524                                                      ,buf_rule-by-call.rule_id
     4525                                                      ,buf_rule-by-call.profile_id
     4526                                                      ,p-d-card
     4527                                                      ,chr(10)
     4528                                                      ,error-status:get-message(1)
     4529                                                      ,return-value ).
     4530           end.
     4531         end.
     4532       end.
     4533     end.
     4534     find first buf_import-temp-d-card where buf_import-temp-d-card.d-card = p-d-card.
     4535     delete buf_import-temp-d-card.
     4536   end.
     4537   end procedure.
