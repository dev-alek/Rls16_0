     2556     (input  g#db-num
     2557     ,input  buffer buf_temp-hist-nws-option:handle
     2558     )  .
     2559     end.
     2560     if not g#news
     2561     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     2562       return.
     2563     end.
     2564     if g#news
     2565     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     2566       return.
     2567     end.
     2568     run cur-time in this-procedure(output v-date, output v-time).
