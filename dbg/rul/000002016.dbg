      476   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   procedure gen-b-code :
      478     define input  parameter type-code like ub.code-range.range-type no-undo .
      479     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      480     do
      481     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      482     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      483     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      484     :
      485       define buffer buf_thbj-attr     for ub.thbj-attr .
      486       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      487       define buffer buf_code-range for ub.code-range .
      488       define variable l-code         as   integer              no-undo .
      489       define variable v-db-num       like ub.db.db-num         no-undo .
      490       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      491       if type-code = 'sslc':U
      492       or type-code = 'ssgb':U
      493       then do:
      494         message
      495           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      496           "Обратитесь к администратору системы."
      497           view-as alert-box error .
      498         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      499       end.
      500       run trg/getpcode.p ( input  type-code
      501                      ,output cfg-param-code
      502                     ).
      503       run get-next-seq( input  type-code,
      504                         output l-code
      505                       ).
      506       find first buf_sys-ctrl no-lock.
      507       if type-code = 'sclc':U
      508       or type-code = 'pglc':U
      509       then do:
      510         assign
      511           v-db-num = 0
      512         .
      513       end.
      514       else do:
      515         assign
      516           v-db-num = buf_sys-ctrl.db-num
      517         .
      518       end.
      519       find first buf_code-range no-lock
      520         where buf_code-range.db-num     = v-db-num
      521           and buf_code-range.range-type = type-code
      522           and buf_code-range.stts       = "a"
      523         use-index stts
      524         no-error .
      525       if available buf_code-range
      526          and l-code <= buf_code-range.last-code
      527          and l-code >= buf_code-range.first-code then do:
      528         assign
      529           p-b-code = l-code
      530         .
      531       end.
      532       else do:
      533         if available buf_code-range
      534            and l-code < buf_code-range.last-code then do:
      535           message
      536             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      537             "Обратитесь к администратору системы."
      538             view-as alert-box error .
      539           undo, return error "sequence":U .
      540         end.
      541         do transaction
      542         on error undo, return error
      543         :
      544           find first buf_thbj-attr exclusive-lock
      545             where buf_thbj-attr.upper-prop-code = 'code-range':U
      546               and buf_thbj-attr.prop-code = cfg-param-code
      547               and buf_thbj-attr.obj-type   = 'БД':U
      548               and buf_thbj-attr.obj-code   = v-db-num
      549             no-error .
      550           if not available buf_thbj-attr then do:
      551             find first buf_thbj-attr exclusive-lock
      552               where buf_thbj-attr.upper-prop-code = 'code-range':U
      553                 and buf_thbj-attr.prop-code = cfg-param-code
      554                 and buf_thbj-attr.obj-type   = ''
      555                 and buf_thbj-attr.obj-code   = 0
      556               no-error .
      557             if not available buf_thbj-attr then do:
      558               if not locked buf_thbj-attr then do:
      559                 message
      560                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      561                   "Обратитесь к администратору системы."
      562                   view-as alert-box error .
      563               end.
      564               undo, return error "config":U .
      565             end.
      566           end.
      567           run get-next-seq( input type-code,
      568                             output l-code
      569                           ).
      570           find first buf_code-range
      571             where buf_code-range.db-num     = v-db-num
      572               and buf_code-range.range-type = type-code
      573               and buf_code-range.stts       = "a"
      574             use-index stts
      575             no-error .
      576           if available buf_code-range
      577           and l-code <= buf_code-range.last-code
      578           and l-code >= buf_code-range.first-code
      579           then do:
      580             assign
      581               p-b-code = l-code
      582             .
      583           end.
      584           else do:
      585             if available buf_code-range then do:
      586               assign
      587                 buf_code-range.stts = "u"
      588               .
      589             end.
      590             find first buf_code-range
      591               where buf_code-range.db-num     = v-db-num
      592                 and buf_code-range.range-type = type-code
      593                 and buf_code-range.stts       = "f"
      594               use-index stts
      595               no-error .
      596             if not available buf_code-range then do:
      597               message
      598                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      599                 "Обратитесь к администратору системы"
      600                 view-as alert-box error .
      601               undo, return error "code-range":U .
      602             end.
      603             assign
      604               buf_code-range.stts           = "a"
      605             .
      606             if buf_code-range.first-code = 1 then do:
      607               run set-seq-cr( input type-code,
      608                               input buf_code-range.first-code
      609                             ).
      610               assign
      611                 p-b-code = 1
      612               .
      613             end.
      614             else do:
      615               run set-seq-cr( input type-code,
      616                               input ( buf_code-range.first-code - 1 )
      617                             ).
      618               run get-next-seq( input type-code,
      619                                 output p-b-code
      620                               ).
      621             end.
      622           end.
      623         end.
      624       end.
      625     end.
      626   end procedure.
      627   procedure get-next-seq :
      628     define input  parameter type-code like ub.code-range.range-type no-undo .
      629     define output parameter next-seq  as   integer                  no-undo .
      630     do
      631     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      632     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      633     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      634     :
      635       case type-code:
      636         when 'bcgb':U then do:
      637           assign
      638             next-seq = next-value(s-bcgb-code, ub)
      639           .
      640         end.
      641         when 'scgb':U then do:
      642           assign
      643             next-seq = next-value(s-scgb-code, ub)
      644           .
      645         end.
      646         when 'sclc':U then do:
      647           assign
      648             next-seq = next-value(s-sclc-code, ub)
      649           .
      650         end.
      651         when 'pglc':U then do:
      652           assign
      653             next-seq = next-value(s-pglc-code, ub)
      654           .
      655         end.
      656         when 'dcgb':U then do:
      657           assign
      658             next-seq = next-value(s-dcgb-code, ub)
      659           .
      660         end.
      661         when 'ctgb':U then do:
      662           assign
      663             next-seq = next-value(s-ctgb-code, ub)
      664           .
      665         end.
      666         when 'drgb':U then do:
      667           assign
      668             next-seq = next-value(s-drgb-code, ub)
      669           .
      670         end.
      671         when 'fmgb':U then do:
      672           assign
      673             next-seq = next-value(s-fmgb-code, ub)
      674           .
      675         end.
      676         when 'pngb':U then do:
      677           assign
      678             next-seq = next-value(s-pngb-code, ub)
      679           .
      680         end.
      681         when 'cagb':U then do:
      682           assign
      683             next-seq = next-value(s-cagb-code, ub)
      684           .
      685         end.
      686         when 'fdgb':U then do:
      687           assign
      688             next-seq = next-value(s-fin-doc, ub)
      689           .
      690         end.
      691       end case.
      692     end.
      693   end procedure.
      694   procedure set-seq-cr :
      695     define input parameter type-code like ub.code-range.range-type no-undo .
      696     define input parameter set-val   like ub.code-range.first-code no-undo .
      697     do
      698     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      699     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      700     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      701     :
      702       case type-code:
      703         when 'bcgb':U then do:
      704           assign
      705             current-value(s-bcgb-code, ub) = set-val
      706           .
      707         end.
      708         when 'scgb':U then do:
      709           assign
      710             current-value(s-scgb-code, ub) = set-val
      711           .
      712         end.
      713         when 'sclc':U then do:
      714           assign
      715             current-value(s-sclc-code, ub) = set-val
      716           .
      717         end.
      718         when 'pglc':U then do:
      719           assign
      720             current-value(s-pglc-code, ub) = set-val
      721           .
      722         end.
      723         when 'dcgb':U then do:
      724           assign
      725             current-value(s-dcgb-code, ub) = set-val
      726           .
      727         end.
      728         when 'ctgb':U then do:
      729           assign
      730             current-value(s-ctgb-code, ub) = set-val
      731           .
      732         end.
      733         when 'drgb':U then do:
      734           assign
      735             current-value(s-drgb-code, ub) = set-val
      736           .
      737         end.
      738         when 'fmgb':U then do:
      739           assign
      740             current-value(s-fmgb-code, ub) = set-val
      741           .
      742         end.
      743         when 'pngb':U then do:
      744           assign
      745             current-value(s-pngb-code, ub) = set-val
      746           .
      747         end.
      748         when 'cagb':U then do:
      749           assign
      750             current-value(s-cagb-code, ub) = set-val
      751           .
      752         end.
      753         when 'fdgb':U then do:
      754           assign
      755             current-value(s-fin-doc, ub) = set-val
      756           .
      757         end.
      758       end case.
      759     end.
      760   end procedure.
      761   procedure new-bcod-gen-code-range :
      762     do
      763     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      764     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      765     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      766     :
      767       define input parameter p-db-num  like ub.db.db-num             no-undo .
      768       define input parameter type-code like ub.code-range.range-type no-undo .
      769       define buffer buf_code-range      for ub.code-range .
      770       define buffer last_code-range     for ub.code-range .
      771       define buffer last-1_code-range   for ub.code-range .
      772       define buffer last-2_code-range   for ub.code-range .
      773       define buffer last-3_code-range   for ub.code-range .
      774       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      775       define variable conf-par       as character no-undo .
      776       define variable par-type       as character no-undo .
      777       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      778       define variable v-cre-cdrg as logical   no-undo .
      779       define variable v-cre-str  as character no-undo .
      780       define variable v-cr1      as integer no-undo .
      781       define variable v-cr2      as integer no-undo .
      782       define variable v-cr3      as integer no-undo .
      783       define variable v-cmax     as integer no-undo .
      784       find first buf_sys-ctrl no-lock .
      785       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      786         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      787                                       ,vss-workfile
      788                                       ,vss-revision
      789                                       ,vss-description
      790                                       ,chr(10)
      791                                       , p-db-num
      792                                      ).
      793       end.
      794       run trg/getpcode.p ( input  type-code
      795                      ,output cfg-param-code
      796                     ).
      797       for each buf_code-range
      798         where buf_code-range.db-num     = -1
      799           and buf_code-range.range-type = type-code
      800           and buf_code-range.stts       = "f"
      801       by buf_code-range.first-code
      802       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      803       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      804       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      805       :
      806         assign
      807           buf_code-range.db-num = p-db-num
      808         .
      809         return .
      810       end.
      811       assign
      812         v-cre-cdrg = TRUE
      813       .
      814       case type-code:
      815         when 'sclc':U
      816         or when 'scgb':U
      817         or when 'pglc':U
      818         then do:
      819           find last last-1_code-range no-lock
      820             where last-1_code-range.range-type = 'sclc':U
      821             no-error .
      822           if available last-1_code-range then do:
      823             v-cr1 = last-1_code-range.last-code.
      824           end.
      825           find last last-2_code-range no-lock
      826             where last-2_code-range.range-type = 'scgb':U
      827             no-error .
      828           if available last-2_code-range then do:
      829             v-cr2 = last-2_code-range.last-code.
      830             end.
      831           find last last-3_code-range no-lock
      832             where last-3_code-range.range-type = 'pglc':U
      833             no-error .
      834           if available last-3_code-range then do:
      835             v-cr3 = last-3_code-range.last-code.
      836           end.
      837           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      838           .
      839           if v-cmax = v-cr1  then do:
      840               find last last_code-range no-lock
      841                 where recid( last_code-range ) = recid( last-1_code-range )
      842                 .
      843             end.
      844           if v-cmax = v-cr2  then do:
      845               find last last_code-range no-lock
      846                 where recid( last_code-range ) = recid( last-2_code-range )
      847                 .
      848             end.
      849           if v-cmax = v-cr3  then do:
      850             find last last_code-range no-lock
      851               where recid( last_code-range ) = recid( last-3_code-range )
      852               .
      853           end.
      854           if last_code-range.last-code + 1 > 99999 then do:
      855             assign
      856               v-cre-cdrg = FALSE
      857             .
      858           end.
      859         end.
      860         when 'bcgb':U
      861         or when 'sslc':U
      862         or when 'ssgb':U
      863         then do:
      864           find last last-1_code-range no-lock
      865             where last-1_code-range.range-type = 'sslc':U
      866             no-error .
      867           if available last-1_code-range then do:
      868             v-cr1 = last-1_code-range.last-code.
      869           end.
      870           find last last-2_code-range no-lock
      871             where last-2_code-range.range-type = 'bcgb':U
      872             no-error .
      873           if available last-2_code-range then do:
      874             v-cr2 = last-2_code-range.last-code.
      875             end.
      876           find last last-3_code-range no-lock
      877             where last-3_code-range.range-type = 'ssgb':U
      878             no-error .
      879           if available last-3_code-range then do:
      880             v-cr3 = last-3_code-range.last-code.
      881           end.
      882           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      883           .
      884           if v-cmax = v-cr1  then do:
      885               find last last_code-range no-lock
      886                 where recid( last_code-range ) = recid( last-1_code-range )
      887                 .
      888             end.
      889           if v-cmax = v-cr2  then do:
      890               find last last_code-range no-lock
      891                 where recid( last_code-range ) = recid( last-2_code-range )
      892                 .
      893             end.
      894           if v-cmax = v-cr3  then do:
      895             find last last_code-range no-lock
      896               where recid( last_code-range ) = recid( last-3_code-range )
      897               .
      898           end.
      899         end.
      900         otherwise do:
      901           find last last_code-range no-lock
      902             where last_code-range.range-type = type-code
      903             no-error .
      904         end.
      905       end case.
      906       if not available last_code-range then do:
      907         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      908                                       ,vss-workfile
      909                                       ,vss-revision
      910                                       ,vss-description
      911                                       , chr(10)
      912                                       , type-code
      913                                      ) .
      914       end.
      915       define variable v-mes7 as character no-undo .
      916       define variable v-param-type7 as character no-undo .
      917       define variable v-value-character7 as INTEGER no-undo .
      918       define variable v-value-date7 as date no-undo .
      919       define variable v-value-decimal7 as decimal no-undo .
      920       define variable v-value-integer7 AS integer no-undo .
      921       define variable v-value-logical7 AS LOGICAL no-undo .
      922       define variable v-tth7 as handle no-undo .
      923       run adm/shattri.p (
      924           input "get":U
      925           ,input  'БД':U
      926           ,input  p-db-num
      927           ,input  'code-range':U
      928           ,input  cfg-param-code
      929           ,output v-value-character7
      930           ,output v-value-date7
      931           ,output v-value-decimal7
      932           ,output v-value-integer7
      933           ,output v-value-logical7
      934           ,output v-param-type7
      935           ,INPUT-OUTPUT table-handle v-tth7
      936           ) no-error .
      937       if error-status :error then do:
      938         delete object v-tth7.
      939         v-mes7 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      940                            , error-status:get-message(1)
      941                            , chr(10)
      942                            , return-value ).
      943         undo, return error v-mes7.
      944       end.
      945       delete object v-tth7.
      946       if v-cre-cdrg = TRUE then do:
      947         create buf_code-range .
      948         assign
      949           buf_code-range.db-num     = p-db-num
      950           buf_code-range.range-type = type-code
      951           buf_code-range.stts       = "f"
      952           buf_code-range.first-code = last_code-range.last-code + 1
      953           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer7)
      954           v-cre-str = "Свободный диапазон успешно создан"
      955         .
      956       end.
      957       else do:
      958         assign
      959           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      960                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      961         .
      962       end.
      963     end.
      964     return v-cre-str .
      965   end procedure.
      966   procedure gen-new-code-range-if-neces :
      967     define input parameter v-db-num           like ub.db.db-num             no-undo .
      968     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      969     define input parameter v-cur-code         as   integer                  no-undo .
      970     define input parameter v-g#news           as   logical                  no-undo .
      971     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      972     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      973     do
      974     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      975     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      976     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      977     :
      978       define variable l-code-range-exist as logical   no-undo init false .
      979       define variable v-db-for-send      as character no-undo .
      980       define buffer buf_code-range  for ub.code-range .
      981       define buffer buf1_code-range for ub.code-range .
      982       define buffer buf_db          for ub.db .
      983       find first buf_code-range
      984         where buf_code-range.range-type = v-range-type
      985           and buf_code-range.last-code >= v-cur-code
      986         use-index last-codei
      987         no-error .
      988       if
      989       (
      990          available buf_code-range
      991          and
      992         (buf_code-range.db-num = v-db-num
      993           and
      994         buf_code-range.first-code <= v-cur-code
      995         )
      996       or
      997         (
      998           v-range-type = 'drgb':U
      999           AND
     1000           v-cur-code = 0
     1001         )
     1002      )
     1003      then do:
     1004         assign
     1005           l-code-range-exist = true
     1006         .
     1007         if v-g#news
     1008         and buf_code-range.stts = "f" then do:
     1009           assign
     1010             buf_code-range.stts = "u"
     1011           .
     1012         end.
     1013       end.
     1014       if not l-code-range-exist
     1015          and v-g#news-source-db <> 0
     1016       then do:
     1017         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1018                                       ,vss-workfile
     1019                                       ,vss-revision
     1020                                       ,vss-description
     1021                                       ,chr(10)
     1022                                       ,v-db-num
     1023                                       ,v-range-type
     1024                                       ,v-cur-code
     1025                                      ).
     1026       end.
     1027       if (not l-code-range-exist
     1028           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1029          )
     1030       and ( not can-find (first buf1_code-range no-lock
     1031                           where buf1_code-range.db-num = v-db-num
     1032                             and buf1_code-range.range-type = v-range-type
     1033                             and buf1_code-range.stts = "f"
     1034                          )
     1035           )
     1036       then do:
     1037         if v-g#db-num = 0 then do:
     1038           run new-bcod-gen-code-range in this-procedure
     1039             (input v-db-num,
     1040              input v-range-type
     1041             ) no-error .
     1042           if error-status :error then do:
     1043             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1044                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1045                                           ,v-db-num
     1046                                           ,v-range-type
     1047                                           ,v-cur-code
     1048                                           ,chr(10)
     1049                                           ,error-status:get-message(1)
     1050                                           ,return-value
     1051                                          ).
     1052           end.
     1053         end.
     1054         else do:
     1055           if v-range-type = 'sclc':U
     1056           or v-range-type = 'pglc':U
     1057           then do:
     1058             assign
     1059               v-db-for-send = "":U
     1060             .
     1061             if v-g#db-num = 0 then do:
     1062               for each buf_db no-lock
     1063                 where buf_db.db-num > 0
     1064                   and buf_db.db-num <> v-g#news-source-db
     1065               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1066               :
     1067                 assign
     1068                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1069                 .
     1070               end.
     1071               assign
     1072                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1073               .
     1074             end.
     1075             else do:
     1076               if not v-g#news then do:
     1077                 assign
     1078                   v-db-for-send = "0":U
     1079                 .
     1080               end.
     1081             end.
     1082             run nws/cr-route.p ( input 'send-cmd':U
     1083                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1084                                  "code-range":U + chr(1) +
     1085                                  (if v-range-type = 'sclc':U
     1086                                   then string( current-value(s-sclc-code, ub))
     1087                                   else string( current-value(s-pglc-code, ub))
     1088                                   ) + chr(1) +
     1089                                   v-range-type)
     1090                           ,input ?
     1091                           ,input v-db-for-send
     1092                           ) no-error .
     1093             if error-status :error then do:
     1094               undo, return error return-value.
     1095             end.
     1096           end.
     1097         end.
     1098       end.
     1099     end.
     1100   end procedure.
     1101   procedure cre-loc-sc-code-range :
     1102     define input parameter v-cur-code as integer no-undo .
     1103   define input parameter p-cdrg-type as character no-undo .
     1104     do
     1105     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1106     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1107     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1108     :
     1109       define buffer buf_code-range for ub.code-range .
     1110       find first buf_code-range
     1111            where buf_code-range.range-type = p-cdrg-type
     1112              and buf_code-range.first-code >= v-cur-code
     1113            no-error .
     1114       if not available buf_code-range then do:
     1115         run new-bcod-gen-code-range in this-procedure
     1116           ( input 0,
     1117             input p-cdrg-type
     1118           ) no-error .
     1119         if error-status :error then do:
     1120           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1121                                          + "Код &2&1&3 &4"
     1122                                         , chr(10)
     1123                                         , v-cur-code
     1124                                         , error-status:get-message(1)
     1125                                         , return-value
     1126                                        ) .
     1127         end.
     1128       end.
     1129     end.
     1130   end procedure.
     1131   procedure mark-used-if-need :
     1132   define input parameter p-cur-code as integer no-undo .
     1133   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1134   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1135     do
     1136     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1137     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1138     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1139     :
     1140       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1141       define buffer buf_code-range for ub.code-range .
     1142       assign
     1143       v-db-num = if p-range-type = 'sclc':U
     1144                  then 0
     1145                  else p-db-num
     1146       .
     1147   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   define buffer locK-batchprocess8 for ub.batchprocess.
     1149   run gbl/lock-prc.p
     1150       (input 'lscc':U
     1151       ,input 0
     1152       ,input 0
     1153       ,input 0
     1154       ,input ""
     1155       ,input ""
     1156       ,input ""
     1157       ,input (
     1158               ",,,Вкл/выкл лок. вес. кодов"
     1159              )
     1160       ,input true
     1161       ,buffer lock-batchprocess8
     1162       ) no-error .
     1163     if error-status :error then do:
     1164       message
     1165         vss-workfile vss-revision vss-description skip
     1166         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1167         view-as alert-box error .
     1168       undo, return error .
     1169     end.
     1170       find first buf_code-range
     1171            where buf_code-range.range-type = p-range-type
     1172              and buf_code-range.first-code >= p-cur-code
     1173              and buf_code-range.last-code <= p-cur-code
     1174              and buf_code-range.db-num = v-db-num
     1175            no-error .
     1176       if not available buf_code-range then do:
     1177         message
     1178           vss-workfile vss-revision vss-description skip
     1179           "Ошибка при создании поиске диапазона" skip
     1180           "База данных" p-db-num skip
     1181           "Код" p-cur-code skip
     1182           "Тип" p-range-type
     1183           error-status :get-message(1) skip
     1184           return-value skip
     1185           view-as alert-box error .
     1186         undo, return error .
     1187       end.
     1188       if buf_code-range.stts = "f":U then do:
     1189         assign
     1190         buf_code-range.stts = "u":U
     1191         .
     1192       end.
     1193     end.
     1194   end procedure.
     1195   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1196   define new global shared variable g#lib-nws as handle no-undo .
     1197   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1198   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   procedure gen-key-rec :
     1200     define input  parameter p-tbl-name    as character no-undo.
     1201     define input  parameter p-bh_tbl-name as handle    no-undo.
     1202     define output parameter p-key-rec     as character no-undo.
     1203     do
     1204     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1205     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1206     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1207     :
     1208       define variable fh               as handle    no-undo .
     1209       define variable v-ok             as logical   no-undo .
     1210       define variable v-inform         as character no-undo .
     1211       define variable v-ind            as integer   no-undo .
     1212       define variable v-idx-field-qnty as integer   no-undo .
     1213       if p-tbl-name = ?
     1214         or p-tbl-name = "":U
     1215       then do:
     1216         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     1217       end.
     1218       if not p-bh_tbl-name:available then do:
     1219         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     1220       end.
     1221       assign
     1222         p-key-rec = p-tbl-name
     1223         v-inform  = p-bh_tbl-name:index-information(1)
     1224         v-ind     = 2
     1225       .
     1226       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1227       on error undo, return error
     1228       :
     1229         assign
     1230           v-inform = p-bh_tbl-name:index-information( v-ind )
     1231           v-ind    = v-ind + 1
     1232         .
     1233       end.
     1234       if v-inform = ?
     1235         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1236         or entry( 3, v-inform, ",":U ) <> "1":U
     1237       then do:
     1238         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     1239       end.
     1240       else do:
     1241         assign
     1242           v-idx-field-qnty = num-entries( v-inform ) - 4
     1243         .
     1244         if v-idx-field-qnty < 2 then do:
     1245           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     1246         end.
     1247         do v-ind = 1 to v-idx-field-qnty by 2
     1248         on error undo, return error
     1249         :
     1250           assign
     1251             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1252             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1253           .
     1254         end.
     1255       end.
     1256       if p-key-rec = ? then do:
     1257         assign
     1258           p-key-rec = "":U
     1259         .
     1260         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     1261       end.
     1262     end.
     1263     return.
     1264   end procedure.
     1265   procedure gen-where-keyr-tab :
     1266     define input  parameter i-tableSerach as character no-undo.
     1267     define input  parameter i-tablekey   as character  no-undo.
     1268     define input  parameter p-key-rec    as character  no-undo.
     1269     define input  parameter p-key-handle as handle     no-undo .
     1270     define input  parameter p-db-name    as character  no-undo .
     1271     define input  parameter p-tt-handle  as handle     no-undo .
     1272     define output parameter o-Where      as character  no-undo.
     1273     do
     1274     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1275     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1276     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1277     :
     1278       define variable v-full-tbl-name  as character no-undo .
     1279       define variable bh_tbl-name      as handle    no-undo .
     1280       define variable fh_key           as handle    no-undo .
     1281       define variable fh_search        as handle    no-undo .
     1282       define variable v-field-num      as integer   no-undo .
     1283       define variable v-count-fld      as integer   no-undo .
     1284       define variable v-inform         as character no-undo .
     1285       define variable v-ind            as integer   no-undo .
     1286       define variable v-idx-field-qnty as integer   no-undo .
     1287       define variable v-field-name     as character no-undo .
     1288       define variable v-field-val      as character no-undo .
     1289       define variable v-word-link      as character no-undo .
     1290       define variable vTable           as character no-undo.
     1291       define variable bh_tbl-key       as handle    no-undo .
     1292       assign
     1293         p-key-rec = trim( p-key-rec )
     1294       .
     1295       if p-key-handle <> ? then do:
     1296         if not valid-handle(p-key-handle)
     1297            or p-key-handle:type <> "buffer"
     1298         then do:
     1299           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     1300         end.
     1301         if num-entries( p-key-rec, chr(3) ) > 1
     1302           or p-key-rec = ?
     1303           or p-key-rec = "":U
     1304         then do:
     1305           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     1306         end.
     1307       end.
     1308       else do:
     1309         if p-key-rec = ?
     1310           or p-key-rec = "":U
     1311         then do:
     1312           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1313         end.
     1314       end.
     1315       assign
     1316         vTable = entry( 1 , p-key-rec, chr(3) )
     1317       .
     1318       if p-tt-handle <> ?
     1319         and ( not valid-handle(p-tt-handle)
     1320               or p-tt-handle:type <> "buffer"
     1321             )
     1322       then do:
     1323         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     1324       end.
     1325       if p-tt-handle = ? then do:
     1326         assign
     1327           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1328         .
     1329         create buffer bh_tbl-name for table v-full-tbl-name .
     1330       end.
     1331       else do:
     1332         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1333       end.
     1334       assign
     1335         v-inform = bh_tbl-name:index-information(1)
     1336         v-ind    = 2
     1337       .
     1338       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1339       on error undo, return error
     1340       :
     1341         assign
     1342           v-inform = bh_tbl-name:index-information( v-ind )
     1343           v-ind    = v-ind + 1
     1344         .
     1345       end.
     1346       if v-inform = ?
     1347         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1348         or entry( 3, v-inform, ",":U ) <> "1":U
     1349       then do:
     1350         delete object bh_tbl-name no-error.
     1351         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     1352       end.
     1353       assign
     1354         v-idx-field-qnty = num-entries( v-inform ) - 4
     1355       .
     1356       if v-idx-field-qnty < 2 then do:
     1357         delete object bh_tbl-name no-error.
     1358         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     1359       end.
     1360       assign
     1361         o-where     = "where":U
     1362         v-word-link = "":U
     1363         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1364         v-count-fld = 0
     1365       .
     1366       if i-tablekey ne "" and i-tablekey ne ?
     1367       then do:
     1368         assign
     1369           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1370         .
     1371         create buffer bh_tbl-key for table v-full-tbl-name .
     1372       end.
     1373       if i-tableSerach ne "" and i-tableSerach ne ?
     1374       then do:
     1375         delete object bh_tbl-name no-error.
     1376         assign
     1377           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1378         .
     1379         create buffer bh_tbl-name for table v-full-tbl-name .
     1380       end.
     1381       block_where:
     1382       do v-ind = 1 to v-idx-field-qnty by 2
     1383       on error undo, return error
     1384       :
     1385         assign
     1386           v-count-fld = v-count-fld + 1
     1387         .
     1388         if p-key-handle = ?
     1389           and v-count-fld > v-field-num
     1390         then do:
     1391           leave block_where.
     1392         end.
     1393         define variable VfieldKeyTable as handle no-undo.
     1394         assign
     1395           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1396           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1397         .
     1398         if     bh_tbl-key ne ?
     1399         then do:
     1400            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1401            if VfieldKeyTable eq ?
     1402            then next block_where.
     1403         end.
     1404         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1405         then
     1406            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1407         else
     1408            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1409         if p-key-handle = ? then do:
     1410           assign
     1411             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1412           .
     1413         end.
     1414         else do:
     1415           assign
     1416             fh_key = p-key-handle:buffer-field( v-field-name )
     1417           .
     1418           if fh_key = ?
     1419             or not valid-handle( fh_key )
     1420           then do:
     1421             delete object bh_tbl-name.
     1422             if     bh_tbl-key ne ?
     1423             then
     1424                delete object bh_tbl-key.
     1425             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     1426           end.
     1427           assign
     1428             v-field-val = fh_key:buffer-value
     1429           .
     1430         end.
     1431         if fh_search:data-type ="character":U then do:
     1432           assign
     1433             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1434             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1435             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1436             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1437             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1438             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1439             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1440             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1441             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1442             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1443             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1444             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1445             v-field-val = substitute( '"&1"', v-field-val )
     1446           .
     1447         end.
     1448         assign
     1449           o-where = substitute( "&1 &2", o-where, v-field-val )
     1450         .
     1451         if v-word-link = "":U then do:
     1452           assign
     1453             v-word-link = "and":U
     1454           .
     1455         end.
     1456       end.
     1457       delete object bh_tbl-name.
     1458       if     bh_tbl-key ne ?
     1459       then
     1460          delete object bh_tbl-key.
     1461       if p-key-handle = ?
     1462         and v-count-fld <> v-field-num
     1463       then do:
     1464         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure gen-hn-keyr-tab :
     1469     define input  parameter i-tableSerach as character no-undo.
     1470     define input  parameter i-tablekey   as character no-undo.
     1471     define input  parameter p-key-rec    as character no-undo.
     1472     define input  parameter p-key-handle as handle    no-undo .
     1473     define input  parameter p-db-name    as character no-undo .
     1474     define input  parameter p-tt-handle  as handle    no-undo .
     1475     define input  parameter p-stts-lock  as integer   no-undo .
     1476     define output parameter o-hn         as handle    no-undo.
     1477     define variable v-full-tbl-name as character no-undo.
     1478     define variable v-where         as character no-undo.
     1479     define variable bh_tbl-name     as handle    no-undo.
     1480     define variable vTable          as character no-undo.
     1481     do
     1482     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1483     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1484     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1485         run gen-where-keyr-tab(i-tableSerach,
     1486                                i-tablekey,
     1487                                p-key-rec,
     1488                                p-key-handle,
     1489                                p-db-name,
     1490                                p-tt-handle,
     1491                                output v-where).
     1492         if i-tableSerach ne "" and i-tableSerach ne ?
     1493         then do:
     1494            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1495            create buffer bh_tbl-name for table v-full-tbl-name .
     1496         end.
     1497         else do:
     1498            if p-tt-handle = ? then do:
     1499               assign
     1500                  vTable = entry( 1 , p-key-rec, chr(3) )
     1501               .
     1502               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1503               create buffer bh_tbl-name for table v-full-tbl-name .
     1504            end.
     1505            else do:
     1506               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1507            end.
     1508         end.
     1509         if p-tt-handle = ? then do:
     1510            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1511         end.
     1512         else do:
     1513            bh_tbl-name:find-first( v-where ) no-error .
     1514         end.
     1515         o-hn = bh_tbl-name.
     1516      end.
     1517   end procedure.
     1518   procedure gen-hn-keyr :
     1519     define input  parameter p-key-rec    as character no-undo.
     1520     define input  parameter p-key-handle as handle    no-undo .
     1521     define input  parameter p-db-name    as character no-undo .
     1522     define input  parameter p-tt-handle  as handle    no-undo .
     1523     define input  parameter p-stts-lock  as integer   no-undo .
     1524     define output parameter o-hn         as handle    no-undo.
     1525     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1526   end.
     1527   procedure gen-row-keyr :
     1528     define input  parameter p-key-rec    as character no-undo.
     1529     define input  parameter p-key-handle as handle    no-undo .
     1530     define input  parameter p-db-name    as character no-undo .
     1531     define input  parameter p-tt-handle  as handle    no-undo .
     1532     define input  parameter p-stts-lock  as integer   no-undo .
     1533     define output parameter p-tbl-row    as rowid     no-undo.
     1534     define output parameter p-tbl-name   as character no-undo.
     1535     define variable vHn as handle no-undo.
     1536       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1537       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1538       p-tbl-name =  vHn:table.
     1539       delete object vHn no-error.
     1540     if p-tbl-row = ? then do:
     1541       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     1542     end.
     1543     else do:
     1544       return.
     1545     end.
     1546   end procedure.
     1547   procedure gen-key-fv :
     1548     define input  parameter p-key-rec    as character no-undo .
     1549     define output parameter p-field-list as character no-undo .
     1550     define output parameter p-value-list as character no-undo.
     1551     do
     1552     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1553     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1554     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1555     :
     1556       define variable v-full-tbl-name  as character no-undo .
     1557       define variable bh_tbl-name      as handle    no-undo .
     1558       define variable v-tbl-name       as character no-undo .
     1559       define variable v-field-num      as integer   no-undo .
     1560       define variable v-count-fld      as integer   no-undo .
     1561       define variable v-inform         as character no-undo .
     1562       define variable v-ind            as integer   no-undo .
     1563       define variable v-idx-field-qnty as integer   no-undo .
     1564       define variable v-delim-key      as character no-undo .
     1565       if p-key-rec = ?
     1566         or p-key-rec = "":U
     1567       then do:
     1568         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1569       end.
     1570       assign
     1571         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1572         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1573       .
     1574       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1575       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     1576       assign
     1577         v-inform = bh_tbl-name:index-information(1)
     1578         v-ind    = 2
     1579       .
     1580       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1581       on error undo, return error
     1582       :
     1583         assign
     1584           v-inform = bh_tbl-name:index-information( v-ind )
     1585           v-ind    = v-ind + 1
     1586         .
     1587       end.
     1588       if v-inform = ?
     1589         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1590         or entry( 3, v-inform, ",":U ) <> "1":U
     1591       then do:
     1592         delete object bh_tbl-name no-error.
     1593         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1594       end.
     1595       assign
     1596         v-idx-field-qnty = num-entries( v-inform ) - 4
     1597       .
     1598       if v-idx-field-qnty < 2 then do:
     1599         delete object bh_tbl-name no-error.
     1600         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1601       end.
     1602       assign
     1603         p-field-list = "":U
     1604         p-value-list = "":U
     1605         v-delim-key  = "":U
     1606         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1607         v-count-fld  = 0
     1608       .
     1609       block_where:
     1610       do v-ind = 1 to v-idx-field-qnty by 2
     1611       on error undo, return error
     1612       :
     1613         assign
     1614           v-count-fld = v-count-fld + 1
     1615         .
     1616         if v-count-fld > v-field-num then do:
     1617           leave block_where.
     1618         end.
     1619         assign
     1620           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1621           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1622         .
     1623         if v-ind = 1 then do:
     1624           assign
     1625             v-delim-key = chr(3)
     1626           .
     1627         end.
     1628       end.
     1629       delete object bh_tbl-name.
     1630       if v-count-fld <> v-field-num then do:
     1631         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     1632       end.
     1633     end.
     1634   end procedure.
     1635   procedure gen-key-field :
     1636     define input  parameter p-table      as character no-undo .
     1637     define output parameter p-field-list as character no-undo .
     1638     do
     1639     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1640     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1641     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1642     :
     1643       define variable v-full-tbl-name  as character no-undo .
     1644       define variable bh_tbl-name      as handle    no-undo .
     1645       define variable v-tbl-name       as character no-undo .
     1646       define variable v-field-num      as integer   no-undo .
     1647       define variable v-count-fld      as integer   no-undo .
     1648       define variable v-inform         as character no-undo .
     1649       define variable v-ind            as integer   no-undo .
     1650       define variable v-idx-field-qnty as integer   no-undo .
     1651       define variable v-delim-key      as character no-undo .
     1652       if p-table = ?
     1653         or p-table = "":U
     1654       then do:
     1655         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     1656       end.
     1657       assign
     1658         v-tbl-name      = p-table
     1659         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1660       .
     1661       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1662       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     1663       assign
     1664         v-inform = bh_tbl-name:index-information(1)
     1665         v-ind    = 2
     1666       .
     1667       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1668       on error undo, return error
     1669       :
     1670         assign
     1671           v-inform = bh_tbl-name:index-information( v-ind )
     1672           v-ind    = v-ind + 1
     1673         .
     1674       end.
     1675       if v-inform = ?
     1676         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1677         or entry( 3, v-inform, ",":U ) <> "1":U
     1678       then do:
     1679         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     1680       end.
     1681       assign
     1682         v-idx-field-qnty = num-entries( v-inform ) - 4
     1683       .
     1684       if v-idx-field-qnty < 2 then do:
     1685         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     1686       end.
     1687       assign
     1688         p-field-list = "":U
     1689         v-delim-key  = "":U
     1690         v-count-fld  = 0
     1691       .
     1692       block_where:
     1693       do v-ind = 1 to v-idx-field-qnty by 2
     1694       on error undo, return error
     1695       :
     1696         assign
     1697           v-count-fld = v-count-fld + 1
     1698         .
     1699         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1700         if v-ind = 1 then do:
     1701           assign
     1702             v-delim-key = chr(3)
     1703           .
     1704         end.
     1705       end.
     1706       delete object bh_tbl-name.
     1707     end.
     1708   end procedure.
     1709   define SHARED temp-table temp-cmd no-undo
     1710   field cmd-code as integer
     1711   field db-list as character
     1712   index pi is unique primary
     1713   db-list
     1714   index icmd
     1715   cmd-code
     1716   .
     1717   define SHARED temp-table temp-smart-route no-undo
     1718   field key-field as character
     1719   field db-num as integer
     1720   index pi is unique primary
     1721   key-field
     1722   db-num
     1723   .
     1724   define SHARED temp-table temp-no-route no-undo
     1725   field rec-ord as integer
     1726   field db-num as integer
     1727   index pi is unique primary
     1728   db-num
     1729   rec-ord
     1730   index iro
     1731   rec-ord
     1732   .
     1733   define SHARED temp-table temp-smart-link no-undo
     1734   field uniq-key-rec as character
     1735   field key-field as character
     1736   field rec-ord as integer
     1737   field is-smart as logical
     1738   index pi is unique primary
     1739   key-field
     1740   uniq-key-rec
     1741   rec-ord
     1742   index iu
     1743   uniq-key-rec
     1744   index iro
     1745   rec-ord
     1746   .
     1747   define SHARED temp-table temp-nws-outline no-undo
     1748   like ub.nws-outline.
     1749   procedure create-smart-route :
     1750   define input parameter p-key-field as character no-undo .
     1751   define input parameter p-db-num as integer no-undo .
     1752   define buffer buf_temp-smart-route for temp-smart-route.
     1753     do
     1754     on error undo, return error
     1755     :
     1756       find first buf_temp-smart-route where
     1757                 buf_temp-smart-route.key-field = p-key-field
     1758             and buf_temp-smart-route.db-num = p-db-num no-error.
     1759       if not available buf_temp-smart-route then do:
     1760         create buf_temp-smart-route.
     1761         assign
     1762         buf_temp-smart-route.key-field = p-key-field
     1763         buf_temp-smart-route.db-num = p-db-num
     1764         .
     1765       end.
     1766     end.
     1767   end procedure.
     1768   procedure create-smart-route-link :
     1769   define input parameter p-tbl-name as character no-undo .
     1770   define input parameter p-bh_tbl-name as handle no-undo .
     1771   define input parameter p-key-field as character no-undo .
     1772   define input parameter p-rec-ord as integer no-undo .
     1773   define input parameter p-is-smart as logical no-undo .
     1774   define variable v-key-rec as character no-undo .
     1775   define buffer buf_temp-smart-link for temp-smart-link.
     1776     do
     1777     on error undo, return error
     1778     :
     1779       run gen-key-rec in this-procedure ( input p-tbl-name
     1780                                          ,input p-bh_tbl-name
     1781                                          ,output v-key-rec     ).
     1782      find first buf_temp-smart-link where
     1783                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1784              and buf_temp-smart-link.key-field = p-key-field
     1785              and buf_temp-smart-link.rec-ord = p-rec-ord
     1786              no-error .
     1787      if not available buf_temp-smart-link then do:
     1788        create buf_temp-smart-link.
     1789        assign
     1790        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1791        buf_temp-smart-link.key-field = p-key-field
     1792        buf_temp-smart-link.rec-ord = p-rec-ord
     1793        buf_temp-smart-link.is-smart = p-is-smart
     1794        .
     1795      end.
     1796     end.
     1797   end procedure.
     1798   procedure create-nws-outline :
     1799   define input parameter p-cmd-proc-handle as handle no-undo .
     1800   define input parameter p-cmd-code as integer no-undo .
     1801   define input parameter p-outline-type as character no-undo .
     1802   define input parameter p-charkey_one as character no-undo .
     1803   define input parameter p-charkey_two as character no-undo .
     1804   define input parameter p-charkey_three as character no-undo .
     1805   define input parameter p-key#_one as integer no-undo .
     1806   define input parameter p-key#_two as integer no-undo .
     1807   define input parameter p-key#_three as integer no-undo .
     1808   define variable v-no-id as integer no-undo .
     1809   define variable v-rec-ord as integer no-undo .
     1810     do
     1811     on error undo, return error return-value
     1812     :
     1813       find last temp-nws-outline use-index pi no-error .
     1814       v-no-id = (if available temp-nws-outline
     1815                  then (temp-nws-outline.no-id  + 1)
     1816                  else 1).
     1817       create temp-nws-outline.
     1818       assign
     1819       temp-nws-outline.charkeY_one = p-charkey_one
     1820       temp-nws-outline.charkeY_two = p-charkey_two
     1821       temp-nws-outline.charkeY_three = p-charkey_three
     1822       temp-nws-outline.key#_one = p-key#_one
     1823       temp-nws-outline.key#_two = p-key#_two
     1824       temp-nws-outline.key#_three = p-key#_three
     1825       temp-nws-outline.no-id = v-no-id
     1826       temp-nws-outline.outline-type = p-outline-type
     1827       .
     1828                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1829       run  create-smart-route in this-procedure (
     1830                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1831                                                  ,input -1).
     1832       run create-smart-route-link in this-procedure (
     1833                                                      input 'nws-outline':U
     1834                                                     ,input (buffer temp-nws-outline:handle)
     1835                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1836                                                     ,input v-rec-ord
     1837                                                     ,input no
     1838                                                     ).
     1839     end.
     1840   end procedure.
     1841   procedure create-no-route :
     1842   define input parameter p-rec-ord as integer no-undo .
     1843   define input parameter p-db-num as integer no-undo .
     1844   define buffer buf_temp-no-route for temp-no-route.
     1845   do
     1846   on error undo, return error
     1847   :
     1848      find first buf_temp-no-route where
     1849                 buf_temp-no-route.rec-ord = p-rec-ord
     1850              and buf_temp-no-route.db-num = p-db-num no-error .
     1851      if not available buf_temp-no-route then do:
     1852        create buf_temp-no-route.
     1853        assign
     1854        buf_temp-no-route.rec-ord = p-rec-ord
     1855        buf_temp-no-route.db-num = p-db-num
     1856        .
     1857      end.
     1858   end.
     1859   end procedure.
     1860   procedure clear-from-rec-ord :
     1861   define input parameter p-rec-ord as integer no-undo .
     1862   define buffer buf_temp-no-route for temp-no-route.
     1863   define buffer buf_temp-smart-link for temp-smart-link.
     1864   do
     1865   on error undo, return error
     1866   :
     1867   for each buf_temp-no-route where
     1868           buf_temp-no-route.rec-ord > p-rec-ord:
     1869     delete buf_temp-no-route.
     1870   end.
     1871   for each buf_temp-smart-link where
     1872           buf_temp-smart-link.rec-ord > p-rec-ord:
     1873      delete buf_temp-smart-link.
     1874   end.
     1875   end.
     1876   end procedure.
     1877   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878   define shared temp-table temp-hist-nws-option no-undo
