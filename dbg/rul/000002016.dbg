     2813                                                           ,input buffer buf_c-dis-host:handle
     2814                                                           ,input buf_dis-host.d-card
     2815                                                           ,input v-rec-ord2
     2816                                                           ,input no
     2817                                                           ).
     2818               run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     2819                                                           ,input buffer buf_c-dc-hist:handle
     2820                                                           ,input buf_dis-host.d-card
     2821                                                           ,input v-rec-ord3
     2822                                                           ,input no
     2823                                                           ).
     2824               run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     2825                                                         ,input -1).
     2826             end.
     2827           end.
     2828           otherwise do:
     2829             run create-smart-route-link in this-procedure ( input 'c-dis-host':U
     2830                                                         ,input buffer buf_c-dis-host:handle
     2831                                                         ,input buf_dis-host.d-card
     2832                                                         ,input v-rec-ord2
     2833                                                         ,input no
     2834                                                         ).
     2835             run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     2836                                                         ,input buffer buf_c-dc-hist:handle
     2837                                                         ,input buf_dis-host.d-card
     2838                                                         ,input v-rec-ord3
     2839                                                         ,input no
     2840                                                         ).
     2841             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     2842                                                       ,input -1).
     2843           end.
     2844         end case.
     2845       end.
     2846     end.
     2847   end.
     2848   end procedure.
     2849   procedure dis-hsth_send-dis-host-rul :
     2850   define parameter buffer buf_dis-host for ub.dis-host .
     2851   define input parameter p-type as character no-undo .
     2852   define input parameter p-emitent-host-code as integer no-undo .
     2853   define input parameter p-dtm-code as integer no-undo .
     2854   define input parameter p-action as integer no-undo .
     2855   define variable v-date as date      no-undo.
     2856   define variable v-time  as integer   no-undo.
     2857   define variable v-rec-ord1 as integer no-undo .
     2858   define variable v-rec-ord2 as integer no-undo .
     2859   define variable v-rec-ord3 as integer no-undo .
     2860   define variable v-rec-hno as integer no-undo .
     2861   define buffer buf_c-dc-hist for ub.c-dc-hist.
     2862   define buffer buf_c-dis-host for ub.c-dis-host.
     2863   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     2864   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     2865   do
     2866   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2867   :
     2868     if g#db-num > 0 then return.
     2869     if not available buf_dis-host then do:
     2870       message
     2871         vss-workfile vss-revision vss-description skip
     2872         "Ошибка задания входных параметров" skip
     2873         "Не определена ДК" skip
     2874         view-as alert-box error .
     2875       undo, return error .
     2876     end.
     2877     find first buf_temp-hist-nws-option where
     2878               buf_temp-hist-nws-option.table-name = 'dis-host':U
     2879           and buf_temp-hist-nws-option.db-num = g#db-num
     2880           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     2881           and buf_temp-hist-nws-option.charkey_one = p-type
     2882           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     2883     if not available buf_temp-hist-nws-option then do:
     2884       find first last_temp-hist-nws-option where
     2885                last_temp-hist-nws-option.db-num = g#db-num
     2886             and last_temp-hist-nws-option.hn-id < 0 no-error.
     2887       create buf_temp-hist-nws-option.
     2888       assign
     2889       buf_temp-hist-nws-option.db-num = g#db-num
     2890       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     2891                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     2892                                   else -1 )
     2893       buf_temp-hist-nws-option.table-name = 'dis-host':U
     2894       buf_temp-hist-nws-option.key#_one = 2
     2895       buf_temp-hist-nws-option.charkey_one = p-type
     2896       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     2897       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     2898       .
     2899   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2900   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     2901     (input  g#db-num
     2902     ,input  buffer buf_temp-hist-nws-option:handle
     2903     )  .
     2904     end.
     2905     run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'dis-host':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_dis-host:handle                                                                                    ,input '':U                                                                                         ,output v-rec-ord1                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-host':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     2906     if g#db-num = 0 then do:
     2907      case buf_temp-hist-nws-option.smart-nws:
     2908         when integer('0':U)
     2909         or
     2910         when integer('10':U) then do:
     2911           if buf_dis-host.dt-code = 0
     2912           and buf_dis-host.host-code  = 0
     2913           and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     2914             run create-smart-route-link in this-procedure ( input 'dis-host':U
     2915                                                         ,input buffer buf_dis-host:handle
     2916                                                         ,input buf_dis-host.d-card
     2917                                                         ,input v-rec-ord1
     2918                                                         ,input no
     2919                                                         ).
     2920             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     2921                                                       ,input -1).
     2922           end.
     2923           else do:
     2924             run get-db-list-for-d-card2  in this-procedure ( input buf_dis-host.d-card).
     2925             run create-smart-route-link in this-procedure ( input 'dis-host':U
     2926                                                         ,input buffer buf_dis-host:handle
     2927                                                         ,input buf_dis-host.d-card
     2928                                                         ,input v-rec-ord1
     2929                                                         ,input yes
     2930                                                         ).
     2931           end.
     2932         end.
     2933         when integer('1':U) then do:
     2934           if buf_dis-host.dt-code = 0
     2935           and buf_dis-host.host-code  = 0
     2936           and buf_Dis-host.whole-send-news = integer('-1':U) then do:
     2937             run create-smart-route-link in this-procedure ( input 'dis-host':U
     2938                                                         ,input buffer buf_dis-host:handle
     2939                                                         ,input buf_dis-host.d-card
     2940                                                         ,input v-rec-ord1
     2941                                                         ,input no
     2942                                                         ).
     2943             run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     2944                                                       ,input -1).
     2945           end.
     2946         end.
     2947         otherwise do:
     2948           run create-smart-route-link in this-procedure ( input 'dis-host':U
     2949                                                       ,input buffer buf_dis-host:handle
     2950                                                       ,input buf_dis-host.d-card
     2951                                                       ,input v-rec-ord1
     2952                                                       ,input no
     2953                                                       ).
     2954           run create-smart-route in this-procedure  ( input buf_dis-host.d-card
     2955                                                     ,input -1).
     2956         end.
     2957       end.
     2958     end.
     2959   end.
     2960   end procedure.
     2961   procedure get-db-list-for-d-card2 :
     2962   define input parameter p-d-card as character no-undo .
     2963   define variable v-current-db-processed as logical no-undo .
     2964   define buffer buf_clients  for ub.clients.
     2965   define buffer buf_dis-obj for ub.dis-obj.
     2966   define buffer buf_temp-smart-route for temp-smart-route.
     2967     do
     2968     on error undo, return error return-value
     2969     :
     2970       for each buf_dis-obj no-lock where
     2971               buf_dis-obj.d-card = p-d-card,
     2972          first buf_clients no-lock where
     2973               buf_clients.obj-type = buf_dis-obj.obj-type
     2974           and buf_clients.obj-code = buf_dis-obj.obj-code
     2975       break by
     2976       buf_clients.db-num:
     2977         if first-of(buf_Clients.db-num) then do:
     2978           find first buf_temp-smart-route no-lock where
     2979                 buf_temp-smart-route.key-field = p-d-card
     2980             and buf_temp-smart-route.db-num = buf_clients.db-num
     2981                 no-error.
     2982           if available buf_temp-smart-route then return.
     2983           create buf_temp-smart-route.
     2984           assign
     2985           buf_temp-smart-route.key-field = p-d-card
     2986           buf_temp-smart-route.db-num = buf_clients.db-num
     2987           .
     2988           if buf_clients.db-num = g#db-num then do:
     2989             v-current-db-processed = yes.
     2990           end.
     2991         end.
     2992       end.
     2993       if not v-current-db-processed then do:
     2994         find first buf_temp-smart-route no-lock where
     2995               buf_temp-smart-route.key-field = p-d-card
     2996           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2997         if not available buf_temp-smart-route then do:
     2998           create buf_temp-smart-route.
     2999           assign
     3000           buf_temp-smart-route.key-field = p-d-card
     3001           buf_temp-smart-route.db-num = g#db-num
     3002           .
     3003         end.
     3004       end.
     3005     end.
     3006   end procedure.
     3007   on delete of this-procedure do:
     3008     run delete-procedure in this-procedure .
     3009   end.
     3010   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     3011   if error-status:error
     3012   or return-value = "return" then return error.
     3013    define variable Card-number1 as  character no-undo .
     3014    define variable Card1 as class Dis-card_ no-undo .
     3015   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     3016    define variable ImpData1 as class Route-data_ no-undo .
     3017   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     3018    define variable Tot-sum1 as class Dis-tot_ no-undo .
     3019   Tot-sum1 = new Dis-tot_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     3020   if not this-procedure:persistent then do:
     3021     run proc-main in this-procedure ( input p-type
     3022                                 ,input p-emitent-host-code ) no-error .
     3023     if error-status:error then do:
     3024         run delete-procedure in this-procedure .
     3025         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     3026     end.
     3027     run delete-procedure in this-procedure .
     3028   end.
     3029   procedure proc-main :
     3030   define input parameter p-type like ub.dis-card.type no-undo .
     3031   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     3032   define variable v-ii as integer   no-undo .
     3033   define variable v-cli-type as character no-undo .
     3034   define variable v-cli-code as integer   no-undo .
     3035   define variable v-cli-type-code as character no-undo .
     3036   define variable v-type-from-file as character no-undo .
     3037   define variable v-issue-code as integer   no-undo .
     3038   define variable v-issue-date as date no-undo .
     3039   define variable v-valid-date as date no-undo .
     3040   define variable v-category as integer   no-undo .
     3041   define variable v-line-num as integer   no-undo .
     3042   define variable v-line-status_ as character no-undo .
     3043   define variable v-present as logical no-undo .
     3044   DEFINE VARIABLE v-today as date no-undo .
     3045   DEFINE VARIABLE v-time as integer no-undo .
     3046   define buffer buf_clients for ub.clients.
     3047   _main:
     3048   do transaction
     3049   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3050   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3051   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3052   :
     3053   assign
     3054   v-emitent-host-code = p-emitent-host-code
     3055   v-type = p-type.
     3056   run write-log  in p-log-handle (
     3057                                    input 0
     3058                                  , "&DLine").
     3059   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Импорт данных по ДК из файла &1", file-name)).
     3060   for each  buf_temp-xml-tables where
     3061           buf_temp-xml-tables.gate-handle_ = v_dataseth
     3062     and buf_temp-xml-tables.order >= 0
     3063     by buf_temp-xml-tables.order
     3064     :
     3065     create query v_qh.
     3066     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     3067     if error-status:error
     3068     or
     3069     not glog then do:
     3070           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3071      undo _main, return error ''.
     3072     end.
     3073     glog = v_qh:query-prepare( substitute( "for each &1 by line-num", buf_temp-xml-tables.tbl-name)) no-error .
     3074     if error-status:error
     3075     or
     3076     not glog then do:
     3077           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3078      undo _main, return error ''.
     3079     end.
     3080     glog = v_qh:query-open no-error .
     3081     if error-status:error
     3082     or
     3083     not glog then do:
     3084           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     3085       undo _main, return error ''.
     3086     end.
     3087     _stroka:
     3088     REPEAT:
     3089       v-retry-action = 0 .
     3090       _release:
     3091       do on error undo, retry:
     3092         if retry then do:
     3093           v-retry-action = v-retry-action + 1.
     3094                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                  , buf_temp-xml-tables.tbl-name                                                                 , num-rec                                                                 , chr(10)                                                                 , error-status:get-message(1)                                                                 , return-value)).
     3095           undo _main, return error ''.
     3096         end.
     3097         if v-retry-action < 1 then do:
     3098                   Card1:Dis-card_release_ ( ) .
     3099         end.
     3100         if v-retry-action < 2 then do:
     3101                   ImpData1:Route-data_dump ( ) .
     3102         end.
     3103         if v-retry-action < 3 then do:
     3104                   Tot-sum1:Dis-tot_release_ ( ) .
     3105         end.
     3106       end.
     3107          _rule:
     3108          do on error undo _rule, retry _rule:
     3109            if retry then do:
     3110           if valid-handle(v_qh) then do:
     3111             delete object v_qh no-error.
     3112           end.
     3113                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     3114         run undo-from-rec-ord in p-cmd-proc-handle ( input p-cmd-code, input v-last-rec-ord).
     3115         run clear-from-rec-ord in this-procedure ( input v-last-rec-ord).
     3116         undo _main, return error ''.
     3117            end.
     3118            else do:
     3119             v_qh:get-next().
     3120             IF v_qh:query-off-end then leave _stroka.
     3121         run get-last-rec-ord in p-cmd-proc-handle ( input p-cmd-code, output v-last-rec-ord).
     3122             IF  ImpData1:current-tbl-name( ) = 'dis-card':U  THEN do:
     3123               v-line-num = ImpData1:route-data_get-field-integer( input 'dis-card':U, input "line-num") .
     3124               Card-number1 = "" .
     3125               v-category  = 0.
     3126               v-type-from-file = ImpData1:route-data_get-field-character( input 'dis-card':U, input "type") .
     3127               if v-type-from-file <> v-type then do:
     3128                 next _stroka .
     3129               end.
     3130               Card-number1 = ImpData1:route-data_get-field-character( input 'dis-card':U, input "d-card") .
     3131               v-cli-type = ImpData1:route-data_get-field-character( input 'dis-card':U, input "cli-type") .
     3132               v-cli-code = ImpData1:route-data_get-field-integer( input 'dis-card':U, input "cli-code") .
     3133               v-line-num = ImpData1:route-data_get-field-integer( input 'dis-card':U, input "line-num") .
     3134               v-issue-date = ImpData1:route-data_get-field-date( input 'dis-card':U, input "issue-date") .
     3135               v-valid-date = ImpData1:route-data_get-field-date( input 'dis-card':U, input "valid-date") .
     3136               v-cli-type-code = v-cli-type + string(v-cli-code).
     3137               v-category = ImpData1:route-data_get-field-integer( input 'dis-card':U, input "category") .
     3138           v-line-status_ = ImpData1:route-data_get-field-character( input 'dis-card':U, input "status_") .
     3139               _tr:
     3140           do
     3141               on error undo _rule, retry _rule
     3142               :
     3143                 v-present = no.
     3144                 num-rec = num-rec + 1.
     3145                 find first buf_clients no-lock where
     3146                           buf_clients.obj-type = 'маг':U
     3147                       and buf_clients.db-num = g#db-num .
     3148                 v-issue-code = buf_clients.obj-code.
     3149                 IF  Card1:find_dis-card_no-error( INPUT Card-number1) = false  THEN do:
     3150                   v-line-status_ = 'N'.
     3151                   IF  Card1:create_dis-card_( INPUT 'маг':U, INPUT v-issue-code, INPUT Card-number1, INPUT v-emitent-host-code, INPUT v-type, INPUT v-cli-type-code) = false  THEN do:
     3152                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input (v-last-error-message + chr(10) + "Запись: " + String(v-line-num))).
     3153                     undo _rule, retry _rule .
     3154                   end.
     3155                 end.
     3156             else do:
     3157               if v-cli-type-code <> Card1:cli-type + string(Card1:cli-code) then do:
     3158                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input ("Изменение держателя карты НЕДОПУСТИМО" + chr(10) + "Запись: " + String(v-line-num))).
     3159                 undo _rule, retry _rule .
     3160               end.
     3161               if v-type <> Card1:type then do:
     3162                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input ("Изменение ТИПА карты НЕДОПУСТИМО" + chr(10) + "Запись: " + String(v-line-num))).
     3163                 undo _rule, retry _rule .
     3164               end.
     3165             end.
     3166                 Card1:category = v-category .
     3167                 Card1:issue-date = v-issue-date.
     3168                 Card1:valid-date = v-valid-date .
     3169                 Card1:issue-code = v-issue-code .
     3170                 run cur-time in this-procedure ( output v-today, output v-time).
     3171                 if v-valid-date < v-today then do:
     3172                   Card1:status_ = 'удал':U.
     3173                 end.
     3174                 if v-valid-date >= v-today then do:
     3175                   Card1:status_ = 'тек':U.
     3176                 end.
     3177                 if v-line-status_ = 'N' then do:
     3178                   Tot-sum1:create_dis-tot_( INPUT Card-number1) .
     3179                   IF  Card1:dis-card_save( ) = false  THEN do:
     3180                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input (v-last-error-message + chr(10) + "Запись: " + String(v-line-num))).
     3181                     undo _rule, retry _rule .
     3182                   end.
     3183                   IF  Tot-sum1:dis-tot_save( ) = false  THEN do:
     3184                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input (v-last-error-message + chr(10) + "Запись: " + String(v-line-num))).
     3185                     undo _rule, retry _rule .
     3186                   end.
     3187                 end.
     3188                 if v-line-status_ = 'U' then do:
     3189                   IF  Card1:dis-card_save( ) = false  THEN do:
     3190                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input (v-last-error-message + chr(10) + "Запись: " + String(v-line-num))).
     3191                     undo _rule, retry _rule .
     3192                   end.
     3193                 end.
     3194             run fill-dc-list-attr in p-cont-handle ( input Card-number1
     3195                                                     ,input v-emitent-host-code
     3196                                                     ) .
     3197               end.
     3198             end.
     3199           end.
     3200         end.
     3201         v-retry-action = 0 .
     3202        _release:
     3203         do on error undo, retry:
     3204           if  retry then do:
     3205             v-retry-action = v-retry-action + 1.
     3206                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     3207             undo _main, return error ''.
     3208           end.
     3209           if v-retry-action < 1 then do:
     3210                       Card1:Dis-card_release_ ( ) .
     3211           end.
     3212           if v-retry-action < 2 then do:
     3213                       ImpData1:Route-data_dump ( ) .
     3214           end.
     3215           if v-retry-action < 3 then do:
     3216                       Tot-sum1:Dis-tot_release_ ( ) .
     3217           end.
     3218         end.
     3219         if v-retry-action = 0 then do:
     3220         if num-rec modulo 100 = 0 then do:
     3221                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Записи &1-&2: сохранение/пересылка в СПН...", num-rec - 100, num-rec)).
     3222           find first buf_temp-cmd use-index pi.
     3223           run after-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3224           if error-status:error then do:
     3225                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).
     3226             undo _main, return error .
     3227           end.
     3228           run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3229           if error-status:error then do:
     3230                      run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value )).
     3231             undo _main, return error .
     3232           end.
     3233           find first buf_temp-cmd use-index pi.
     3234           p-cmd-code = buf_temp-cmd.cmd-code.
     3235         end.
     3236         num-rec-ok = num-rec-ok + 1.
     3237       end.
     3238         run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3239       end.
     3240     if valid-handle(v_qh) then  v_qh:query-close().
     3241       if valid-handle(v_qh) then do:
     3242         delete object v_qh.
     3243       end.
     3244       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Записи &1-&2: сохранение/пересылка в СПН..."                                         , (num-rec - num-rec modulo 100 + 1), num-rec)).
     3245     find first buf_temp-cmd use-index pi.
     3246     run after-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3247     if error-status:error then do:
     3248           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении/пересылке по СПН:&1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value )).
     3249       undo _main, return error .
     3250     end.
     3251     run before-command in p-parent-handle (buffer buf_temp-cmd) no-error.
     3252     if error-status:error then do:
     3253           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при инициации сохранения/пересылки пакета по СПН:&1&2&1&3"                                 , chr(10)                                 , error-status:get-message(1)                                 , return-value )).
     3254       undo _main, return error .
     3255     end.
     3256     find first buf_temp-cmd use-index pi.
     3257     p-cmd-code = buf_temp-cmd.cmd-code.
     3258     end.
     3259     for each temp-d-card
     3260     where temp-d-card.emitent-host-code = v-emitent-host-code
     3261       and temp-d-card.type = v-type
     3262     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3263     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3264     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3265     :
     3266       assign
     3267       temp-d-card.sale-type = (v-current-doc-type + chr(44) +  'import':U)
     3268       .
     3269       run create-temp-d-card in p-parent-handle ( input (buffer temp-d-card:handle)).
     3270     END.
     3271     run reset-context in p-parent-handle ( input v-current-obj-type
     3272                                           ,input v-current-obj-code
     3273                                           ,input v-current-doc-code
     3274                                           ,input v-current-doc-date
     3275                                           ,input (v-current-doc-type + chr(44) +  'import':U)
     3276     ).
     3277       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     3278   end.
     3279   end procedure.
     3280   procedure load-ruleset-context :
     3281   define input parameter p-ruleset-id as integer no-undo .
     3282   define buffer buf_rule-call-param for ub.rule-call-param.
     3283   define variable v-itop as integer   no-undo .
     3284   define variable v-ichild as integer   no-undo .
     3285   define variable v-esys-id as integer no-undo .
     3286   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     3287     do
     3288     on error undo, return error
     3289     :
     3290    find first buf_rule-call-param no-lock where
     3291   buf_rule-call-param.codex_id = p-codex-id
     3292   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3293   and buf_rule-call-param.call_id = p-call-id
     3294   and buf_rule-call-param.order_id = p-order-id
     3295   and buf_rule-call-param.rule_id = p-rule-id
     3296   and buf_rule-call-param.param-name = "p-esys-id"
     3297    no-error.
     3298   if available buf_rule-call-param then do:
     3299   assign p-esys-id = buf_rule-call-param.param-value-integer.
     3300   end.
     3301    find first buf_rule-call-param no-lock where
     3302   buf_rule-call-param.codex_id = p-codex-id
     3303   and buf_rule-call-param.ruleset_id = p-ruleset-id
     3304   and buf_rule-call-param.call_id = p-call-id
     3305   and buf_rule-call-param.order_id = p-order-id
     3306   and buf_rule-call-param.rule_id = p-rule-id
     3307   and buf_rule-call-param.param-name = "p-xsd-file"
     3308    no-error.
     3309   if available buf_rule-call-param then do:
     3310   assign p-xsd-file = buf_rule-call-param.param-value-character.
     3311   end.
     3312       case p-ruleset-id:
     3313         when 3 then do:
     3314           for each buf_cash-pay no-lock where
     3315                  buf_cash-pay.curr-code = 0
     3316           by buf_cash-pay.cdpay-code:
     3317              if buf_cash-pay.is-cash then do:
     3318                leave.
     3319              end.
     3320           end.
     3321           if not available buf_cash-pay then do:
     3322                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдено ни одного типа кассового платежа с валютой &1 и свойством <НАЛИЧНЫЕ>,&2" +                                  "к которому можно привязать импортируемые суммы покупок по ДК"                                  , 0                                  , chr(10)                                  )).
     3323             assign
     3324             v-view-log = yes.
     3325             .
     3326             return error.
     3327           end.
     3328           assign
     3329           v-sign = 1
     3330           v-current-host-code = p-host-code
     3331           v-current-obj-type = p-obj-type
     3332           v-current-obj-code = p-obj-code
     3333           v-current-doc-code = p-doc-code
     3334           v-current-db-num = g#db-num
     3335           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     3336           v-current-date = p-doc-date
     3337           file-name  = entry(1, p-process-file-name, chr(4))
     3338           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     3339           v-xmlh = buffer buf_temp-xml-tables:handle
     3340           v-esys-id = integer(p-doc-code)
     3341           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     3342           log-file-name = entry(4, p-process-file-name, chr(4))
     3343           .
     3344           find first buf_esys-pck-keys no-lock where
     3345                     buf_esys-pck-keys.esys-id = v-esys-id
     3346                 and buf_esys-pck-keys.db-num = 0
     3347                 and buf_esys-pck-keys.espr-cr-db-num = g#db-num
     3348                 and buf_esys-pck-keys.espr-pack-num = v-pck-num
     3349                 and buf_esys-pck-keys.espr-uniq-key = substitute("&2&1&3&1&4&1&5"
     3350                                                                     , chr(4)
     3351                                                                     , p-call-id
     3352                                                                     , p-codex-id
     3353                                                                     , p-ruleset-id
     3354                                                                     , p-order-id)
     3355                 no-error.
     3356           if available buf_esys-pck-keys then do:
     3357                       .
     3358             run set-stop-leave-status in p-parent-handle ( input "LEAVE").
     3359             return "return".
     3360           end.
     3361         end.
     3362         otherwise do:
     3363           undo, return error "Неправильный вызов".
     3364         end.
     3365       end case.
     3366     end.
     3367   end procedure.
     3368   procedure 00040000_set-vpay-chk  :
     3369   define input parameter p-bh as handle no-undo .
     3370   define buffer buf_vchk-pay for vchk-pay.
     3371   find first buf_vchk-pay no-lock where
     3372             buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3373         and buf_vchk-pay.pay-code = buf_cash-pay.cdpay-code
     3374         and buf_vchk-pay.curr-code = 0
     3375         and buf_vchk-pay.doc-date = v-current-date
     3376         and buf_vchk-pay.cre-pay = no
     3377         and buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3378         and buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3379         no-error .
     3380    if not available buf_vchk-pay then do:
     3381      create buf_vchk-pay.
     3382      assign
     3383      buf_vchk-pay.d-card = p-bh:buffer-field("d-card"):buffer-value
     3384      buf_vchk-pay.pay-code = (if v-current-doc-type = 'inkas':U
     3385                               then buf_cash-pay.cdpay-code
     3386                               else buf_cash-pay.pay-code
     3387                               )
     3388      buf_vchk-pay.curr-code = 0
     3389      buf_vchk-pay.doc-date = v-current-date
     3390      buf_vchk-pay.cre-pay = no
     3391      buf_vchk-pay.exch-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3392      buf_vchk-pay.base-rate = p-bh:buffer-field("pay-tot-rubl"):buffer-value / p-bh:buffer-field("pay-tot-base"):buffer-value
     3393      .
     3394    end.
     3395    assign
     3396    buf_vchk-pay.tot-sum = buf_vchk-pay.tot-sum + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3397    buf_vchk-pay.tot-base = buf_vchk-pay.tot-base + p-bh:buffer-field("pay-tot-base"):buffer-value
     3398    buf_vchk-pay.tot-rubl = buf_vchk-pay.tot-rubl + p-bh:buffer-field("pay-tot-rubl"):buffer-value
     3399    .
     3400   end procedure.
     3401   procedure create_clients_:
     3402   define input parameter p-obj-type as character no-undo .
     3403   define input parameter p-obj-code as integer no-undo .
     3404   define buffer buf_temp-clients_ for temp-clients_.
     3405   find first buf_temp-clients_ where
     3406             buf_temp-clients_.obj-type = p-obj-type
     3407        and  buf_temp-clients_.obj-code = p-obj-code no-error .
     3408   if not available buf_temp-clients_ then do:
     3409     create buf_temp-clients_.
     3410     assign
     3411     buf_temp-clients_.obj-type = p-obj-type
     3412     buf_temp-clients_.obj-code = p-obj-code
     3413     .
     3414   end.
     3415   end procedure.
     3416   procedure create_dis-card_:
     3417   define input parameter p-d-card as character no-undo .
     3418   define buffer buf_temp-dis-card_ for temp-dis-card_.
     3419   find first buf_temp-dis-card_ where
     3420             buf_temp-dis-card_.d-card = p-d-card no-error .
     3421   if not available buf_temp-dis-card_ then do:
     3422     create buf_temp-dis-card_.
     3423     assign
     3424     buf_temp-dis-card_.d-card = p-d-card
     3425     .
     3426   end.
     3427   end procedure.
     3428   procedure can-find_clients_  :
     3429   define input parameter p-obj-type as character no-undo .
     3430   define input parameter p-obj-code as integer no-undo .
     3431   define output parameter p-find as logical no-undo .
     3432   find first temp-clients_ where
     3433                        temp-clients_.obj-type = p-obj-type
     3434                    and temp-clients_.obj-code = p-obj-code no-error.
     3435   p-find = available temp-clients_.
     3436   end procedure.
     3437   procedure can-find_dis-card_  :
     3438   define input parameter p-d-card as character no-undo .
     3439   define output parameter p-find as logical no-undo .
     3440   find first temp-dis-card_ where
     3441                        temp-dis-card_.d-card = p-d-card no-error.
     3442   p-find = available temp-dis-card_.
     3443   end procedure.
     3444   procedure delete-procedure :
     3445     do
     3446     on error undo, return error
     3447     :
     3448         for each temp-clients_:
     3449           delete temp-clients_.
     3450         end.
     3451         for each temp-dis-card_:
     3452           delete temp-dis-card_.
     3453         end.
     3454         run garbcoll_clear in this-procedure .
     3455     end.
     3456   end procedure.
     3457   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3458   define   temp-table import-temp-d-card no-undo
     3459   field card-num as integer
     3460   field d-card as character
     3461   field dt-code as integer
     3462   field first-card as character
     3463   field first-main-card as character
     3464   field gds-dis-base as decimal
     3465   field gds-dis-rubl as decimal
     3466   field gds-tot-b0   as decimal
     3467   field gds-tot-base as decimal
     3468   field gds-tot-r0   as decimal
     3469   field gds-tot-rubl as decimal
     3470   field host-code as integer
     3471   field main-card as character
     3472   field num-chk as integer
     3473   field obj-code as integer
     3474   field obj-type as character
     3475   field pay-tot-base as decimal
     3476   field pay-tot-rubl as decimal
     3477   field sum-dis-base as decimal
     3478   field sum-dis-rubl as decimal
     3479   field sum-tot-base as decimal
     3480   field sum-tot-rubl as decimal
     3481   field sum-tot-r-b         as decimal
     3482   field gds-tot-r-b         as decimal
     3483   field gds-dis-r-b         as decimal
     3484   field cli-type            as character
     3485   field cli-code            as integer
     3486   field emitent-host-code   as integer
     3487   field type                as character
     3488   field exp-imp             as logical
     3489   field sale-doc            as character
     3490   field sale-type           as character
     3491   field doc-date            as date
     3492   field base-code           as integer
     3493   field smart-nws-log       as logical init ?
     3494   field action              as integer
     3495   index pi is unique primary
     3496   d-card
     3497   obj-type obj-code
     3498   index iobj obj-type obj-code
     3499   index itype type emitent-host-code
     3500   .
     3501   procedure 00040003_after-import :
     3502   define input  parameter p-d-card as character no-undo .
     3503   define variable v-ii as integer   no-undo .
     3504   define variable v-jj as integer   no-undo .
     3505   define variable v-codex-id as integer   no-undo .
     3506   define variable v-ruleset-id as integer   no-undo .
     3507   define variable v-ai-ruleset-id-list as character no-undo extent 4.
     3508   define variable v-ai-codex-id-list as character no-undo .
     3509   define variable v-proc-name as character no-undo .
     3510   define buffer buf_temp-d-card for temp-d-card.
     3511   define buffer buf_Dis-card for ub.dis-card.
     3512   define buffer buf_import-temp-d-card for import-temp-d-card.
     3513   define buffer buf_rule-by-call for ub.rule-by-call.
     3514     main-block:
     3515     do
     3516     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3517     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3518     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3519     :
     3520         assign
     3521         v-ai-codex-id-list = (if g#db-num = 0
     3522                            then "1,2"
     3523                            else '':U)
     3524         v-ai-ruleset-id-list[1] = string(5)
     3525         v-ai-ruleset-id-list[2] = "6,5"
     3526         v-ai-ruleset-id-list[3] = ''
     3527         .
     3528         find first buf_temp-d-card where
     3529                  buf_temp-d-card.d-card = p-d-card no-error.
     3530         if not available buf_temp-d-card then do:
     3531           find first buf_Dis-card exclusive-lock where
     3532                     buf_dis-card.d-card = p-d-card no-error.
     3533           if not available  buf_dis-card then do:
     3534             undo main-block, return error substitute("ДК &1 не найдена").
     3535           end.
     3536         end.
     3537         create buf_import-temp-d-card.
     3538         if available buf_temp-d-card then do:
     3539           buffer-copy buf_temp-d-card to buf_import-temp-d-card.
     3540         end.
     3541         else do:
     3542           buffer-copy buf_dis-card to buf_import-temp-d-card
     3543           assign
     3544           buf_import-temp-d-card.obj-type = p-obj-type
     3545           buf_import-temp-d-card.obj-code = p-obj-code
     3546           buf_import-temp-d-card.host-code = p-host-code
     3547           .
     3548         end.
     3549         release buf_temp-d-card.
     3550         _codex:
     3551         do v-jj = 1 to num-entries(v-ai-codex-id-list):
     3552           if entry(v-jj, v-ai-codex-id-list) = '':U then next _codex.
     3553           v-codex-id = integer(entry(v-jj, v-ai-codex-id-list)).
     3554           do v-ii = 1 to num-entries(v-ai-ruleset-id-list[v-jj]):
     3555              if entry(v-ii, v-ai-ruleset-id-list[v-jj]) = '':U then next.
     3556              v-ruleset-id = integer(entry(v-ii, v-ai-ruleset-id-list[v-jj])).
     3557             _rule-by-call:
     3558             for each buf_rule-by-call no-lock where
     3559                       buf_rule-by-call.call_id = p-call-id
     3560                 and buf_rule-by-call.can-calc = yes
     3561                 and buf_rule-by-call.codex_id = v-codex-id
     3562                 and buf_rule-by-call.ruleset_id = v-ruleset-id
     3563             by buf_rule-by-call.call_Id
     3564             by buf_rule-by-call.codex_id
     3565             by buf_rule-by-call.ruleset_id
     3566             by buf_rule-by-call.order_id
     3567             on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3568             on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3569             on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ) :
     3570               if not (buf_rule-by-call.profile_id = p-profile-id
     3571                       or
     3572                       buf_rule-by-call.profile_id = 1
     3573                       )
     3574               then next _rule-by-call.
     3575               v-proc-name = "rul/" + string(buf_rule-by-call.rule_id, '999999999') + '.p'.
     3576               run value(v-proc-name)  (
     3577                                                              input parparentproc
     3578                                                             ,input p-parent-handle
     3579                                                             ,input p-log-handle
     3580                                                             ,input p-cont-handle
     3581                                                             ,input v-codex-id
     3582                                                             ,input v-ruleset-id
     3583                                                             ,input p-call-id
     3584                                                             ,input buf_rule-by-call.order_id
     3585                                                             ,input buf_rule-by-call.rule_id
     3586                                                             ,input buf_rule-by-call.profile
     3587                                                             ,input buf_rule-by-call.is_dynamic
     3588                                                             ,input p-doc-type
     3589                                                             ,input buf_import-temp-d-card.host-code
     3590                                                             ,input buf_import-temp-d-card.obj-type
     3591                                                             ,input buf_import-temp-d-card.obj-code
     3592                                                             ,input p-doc-code
     3593                                                             ,input p-process-file-name
     3594                                                             ,input p-doc-date
     3595                                                             ,input p-fact-date
     3596                                                             ,input p-save
     3597                                                             ,input v-curr-r-b
     3598                                                             ,input p-cmd-proc-handle
     3599                                                             ,input p-cmd-code
     3600                                                             ,input p-type
     3601                                                             ,input p-emitent-host-code
     3602                                                             ,input table import-temp-d-card
     3603                                                             ) no-error .
     3604           if error-status:error then do:
     3605             undo main-block, return error substitute("Ошибка при выполнении правила &1 ( профайл &2) для ДК &3&4&5&4&6"
     3606                                                      ,buf_rule-by-call.rule_id
     3607                                                      ,buf_rule-by-call.profile_id
     3608                                                      ,p-d-card
     3609                                                      ,chr(10)
     3610                                                      ,error-status:get-message(1)
     3611                                                      ,return-value ).
     3612           end.
     3613         end.
     3614       end.
     3615     end.
     3616     find first buf_import-temp-d-card where buf_import-temp-d-card.d-card = p-d-card.
     3617     delete buf_import-temp-d-card.
     3618   end.
     3619   end procedure.
