      151   define  variable garbcoll_ii as integer no-undo .
      152   define  temp-table temp-gc no-undo
      153   field ii as integer
      154   field obj-r as handle
      155   field cn as character
      156   index pi is unique primary
      157   ii
      158   index icn
      159   cn.
      160   procedure garbcoll_create-gc-entry :
      161   define input parameter p-cn as character no-undo .
      162   define input parameter p-obj-r as handle no-undo .
      163     do
      164     on error undo, return error
      165     :
      166       create temp-gc.
      167       assign
      168       temp-gc.ii = garbcoll_ii
      169       garbcoll_ii = garbcoll_ii + 1
      170       temp-gc.cn = p-cn
      171       temp-gc.obj-r = p-obj-r
      172       .
      173     end.
      174   end procedure.
      175   procedure garbcoll_clear :
      176     do
      177     on error undo, return error
      178     :
      179       for each temp-gc:
      180         delete object temp-gc.obj-r.
      181         delete temp-gc.
      182       end.
      183     end.
      184   end procedure.
      185   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   procedure cur-time :
      187      define output parameter p-today as date      no-undo .
      188      define output parameter p-time  as integer   no-undo .
      189     do
      190     on error undo, return error
      191     :
      192       define variable v-date1 as date      no-undo .
      193       define variable v-date2 as date      no-undo .
      194       define variable v-time  as integer   no-undo .
      195       assign
      196         v-date1 = today
      197         v-time  = time
      198         v-date2 = today
      199       .
      200       if v-date1 <> v-date2
      201       then do:
      202         assign
      203           v-date1 = today
      204           v-time  = v-time
      205         .
      206       end.
      207       assign
      208         p-today = v-date1
      209         p-time  = v-time
      210       .
      211     end.
      212   end.
      213   function cur-time-date returns character
      214   :
      215     return string(today, '99/99/9999':U) .
      216   end.
      217   function cur-time-mjd returns decimal
      218   :
      219     define variable v-date as date      no-undo .
      220     define variable v-time as integer   no-undo .
      221     run cur-time in this-procedure
      222       (output v-date
      223       ,output v-time
      224       ) .
      225     return integer(v-date) - 2400002 + (v-time / 86400) .
      226   end.
      227   function cur-time-get-ending-index returns integer
      228   (input p-number as integer
      229   )
      230   :
      231     if p-number < 0
      232     or p-number = ?
      233     then do:
      234       return 1 .
      235     end.
      236     define variable v-rest as integer   no-undo .
      237     assign
      238       p-number = p-number modulo 100
      239     .
      240     if p-number < 20
      241     then do:
      242       assign
      243         v-rest = p-number
      244       .
      245     end.
      246     else do:
      247       assign
      248         v-rest = p-number modulo 10
      249       .
      250     end.
      251     case v-rest :
      252       when 1
      253       then do:
      254         return 2 .
      255       end.
      256       when 2 or
      257       when 3 or
      258       when 4
      259       then do:
      260         return 3 .
      261       end.
      262       otherwise do:
      263         return 1 .
      264       end.
      265     end case .
      266   end.
      267   procedure cur-time-mjd-to-date :
      268      define input  parameter i-mjd-diff as decimal no-undo.
      269      define output parameter o-Date     as date    no-undo.
      270      define output parameter o-Time     as integer no-undo.
      271      define variable v-day-number as integer   no-undo .
      272      if    i-mjd-diff < 0
      273         or i-mjd-diff = ?
      274      then do:
      275         return "?" .
      276      end.
      277      assign
      278         v-day-number = truncate(i-mjd-diff,0).
      279         o-Date = date(v-day-number + 2400002).
      280         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      281     .
      282   end.
      283   function cur-time-mjd-to-string returns character
      284   (input p-mjd-diff as decimal
      285   )
      286   :
      287     define variable v-day-number as integer   no-undo .
      288     define variable v-seconds    as integer   no-undo .
      289     define variable v-hour       as integer   no-undo .
      290     define variable v-min        as integer   no-undo .
      291     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      292     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      293     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      294     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      295     if p-mjd-diff < 0
      296     or p-mjd-diff = ?
      297     then do:
      298       return "?" .
      299     end.
      300     assign
      301       v-day-number = integer(truncate(p-mjd-diff,0))
      302       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      303     .
      304     if v-seconds > 86400
      305     then do:
      306       assign
      307         v-seconds = 86400 - 1
      308       .
      309     end.
      310     if v-seconds < 0
      311     then do:
      312       assign
      313         v-seconds = 0
      314       .
      315     end.
      316     assign
      317       v-hour = truncate(v-seconds / 3600, 0)
      318     .
      319     assign
      320       v-seconds = v-seconds modulo 3600
      321     .
      322     assign
      323       v-min = truncate(v-seconds / 60, 0)
      324     .
      325     assign
      326       v-seconds = v-seconds modulo 60
      327     .
      328     return
      329         (if v-day-number <> 0
      330           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      331           else ""
      332         )
      333       + (if v-day-number <> 0 or v-hour <> 0
      334           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      335           else ""
      336         )
      337       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      338           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      339           else ""
      340         )
      341       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      342       .
      343   end.
      344   function cur-time-string returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-string-sec returns character
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      363   end.
      364   function cur-time-custom  returns character
      365   (input p-prefix as character
      366   ,input p-date-format as character
      367   ,input p-delimiter as character
      368   ,input p-time-format as character
      369   ,input p-suffix as character
      370   )
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return
      379       p-prefix
      380       + string(v-date, p-date-format)
      381       + p-delimiter
      382       + string(v-time, p-time-format)
      383       + p-suffix
      384       .
      385   end.
      386   function cur-time-print  returns character
      387   :
      388     define variable v-date as date      no-undo .
      389     define variable v-time as integer   no-undo .
      390     run cur-time in this-procedure
      391       (output v-date
      392       ,output v-time
      393       ) .
      394     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      395   end.
      396   function cur-time-datetime returns datetime
      397   :
      398     define variable v-char as character no-undo .
      399     define variable v-datetime as datetime no-undo .
      400     v-char = cur-time-string().
      401     v-datetime = datetime(v-char).
      402     return  v-datetime.
      403   end.
      404   function cur-time-string-msec returns character
      405   :
      406     define variable v-date as datetime  no-undo .
      407     v-date = now.
      408     return string(v-date) .
      409   end.
