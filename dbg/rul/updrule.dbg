     4038   PROCEDURE proc-mouse-menu-click :
     4039   DEFINE VARIABLE v-script-al AS CHARACTER NO-UNDO.
     4040   DEFINE VARIABLE v-script-nl AS CHARACTER NO-UNDO.
     4041   DEFINE VARIABLE v-entry-type AS CHARACTER NO-UNDO.
     4042   DEFINE VARIABLE v-script-name AS CHARACTER NO-UNDO.
     4043   DEFINE VARIABLE v-script-type AS CHARACTER NO-UNDO.
     4044   DEFINE VARIABLE v-proc-type AS CHARACTER NO-UNDO.
     4045   DEFINE VARIABLE v-script-value-type AS CHARACTER NO-UNDO.
     4046   DEFINE VARIABLE v-data-type AS CHARACTER NO-UNDO.
     4047   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     4048   DEFINE VARIABLE v-class-dtm-code AS integer NO-UNDO.
     4049   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     4050   define variable v-includes-operator as logical no-undo .
     4051   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     4052   DEFINE BUFFER buf_tt-complex FOR tt-complex.
     4053   DEFINE BUFFER buf2_tt-complex FOR tt-complex.
     4054    ASSIGN
     4055    v-script-al = "("
     4056    v-script-nl = "("
     4057    .
     4058     FOR EACH buf_tt-widget
     4059     BY buf_tt-widget.right-bottom
     4060     ON error undo, return no-apply
     4061     :
     4062        IF buf_tt-widget.HANDLE:SELECTED THEN DO:
     4063           if not v-includes-operator
     4064           and  buf_tt-widget.entry-type = 'operator':U then do:
     4065             v-includes-operator = yes.
     4066           end.
     4067           ASSIGN
     4068           v-script-al = v-script-al + chr(32) + buf_tt-widget.script-al
     4069           v-script-nl = v-script-nl + chr(32) + buf_tt-widget.script-nl
     4070           v-ii = v-ii + 1
     4071           .
     4072           IF v-ii = 1 THEN DO:
     4073             ASSIGN
     4074             v-entry-type = '-':U
     4075             v-script-type = 'variable':U
     4076             v-script-value-type = buf_tt-widget.script-value-type
     4077             v-data-type = buf_tt-widget.DATA-TYPE
     4078             v-dtm-code = buf_tt-widget.dtm-code
     4079             v-class-dtm-code = buf_tt-widget.class-dtm-code
     4080             .
     4081           END.
     4082           ELSE DO:
     4083               ASSIGN
     4084               v-entry-type = '-':U
     4085               v-script-name  = '':U
     4086               v-script-type = 'variable':U
     4087               v-proc-type = '':U
     4088               v-script-value-type = '-':U
     4089               v-data-type = '-':U
     4090               v-dtm-code = 0
     4091               v-class-dtm-code = 0
     4092               .
     4093           END.
     4094          DELETE WIDGET buf_tt-widget.HANDLE_.
     4095          DELETE buf_tt-widget.
     4096        END.
     4097     END.
     4098     ASSIGN
     4099     v-script-al = v-script-al + " )"
     4100     v-script-nl = v-script-nl + " )"
     4101     .
     4102     if not v-includes-operator then do:
     4103       ASSIGN
     4104       v-script-al = left-trim(v-script-al, "(")
     4105       v-script-nl = left-trim(v-script-nl, "(")
     4106       v-script-al = right-trim(v-script-al, ")")
     4107       v-script-nl = right-trim(v-script-nl, ")")
     4108       .
     4109     end.
     4110     RUN create-widget IN THIS-PROCEDURE ( INPUT v-dtm-code
     4111                                      ,input v-class-dtm-code
     4112                                     ,INPUT rs-language
     4113                                     ,input v-script-al
     4114                                     ,INPUT v-script-al
     4115                                     ,INPUT v-script-nl
     4116                                     ,INPUT v-entry-type
     4117                                     ,INPUT v-script-type
     4118                                     ,input v-script-value-type
     4119                                     ,INPUT v-data-type
     4120                                     ,input v-proc-type
     4121                                     ,input '':U
     4122                                     ).
     4123     FIND last buf2_tt-complex NO-ERROR.
     4124     CREATE buf_tt-complex.
     4125     ASSIGN
     4126     buf_tt-complex.script-al = v-script-al
     4127     buf_tt-complex.script-nl = v-script-nl
     4128     buf_tt-complex.key_ = ( IF AVAILABLE buf2_tt-complex
     4129                              THEN buf2_tt-complex.KEY_ + 1
     4130                              ELSE 1)
     4131     buf_tt-complex.entry-type = v-entry-type
     4132     buf_tt-complex.script-name = v-script-name
     4133     buf_tt-complex.proc-type = v-proc-type
     4134     buf_tt-complex.script-type = v-script-type
     4135     buf_tt-complex.script-value-type = v-script-value-type
     4136     buf_tt-complex.data-type = v-data-type
     4137     buf_tt-complex.dtm-code = v-dtm-code
     4138     buf_tt-complex.class-dtm-code = v-class-dtm-code
     4139     .
     4140   OPEN QUERY br-complex FOR EACH tt-complex.
     4141   END PROCEDURE.
     4142   PROCEDURE proc-save :
     4143   DEFINE VARIABLE v-script-al AS CHARACTER NO-UNDO.
     4144   DEFINE VARIABLE v-script-nl AS CHARACTER NO-UNDO.
     4145   DEFINE VARIABLE v-script-id AS integer NO-UNDO.
     4146   DEFINE VARIABLE v-rule-id AS INTEGER NO-UNDO.
     4147   DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
     4148   DEFINE BUFFER buf_tt-rule-i-script FOR tt-rule-i-script.
     4149   DEFINE BUFFER buf_tt-loc-rule-i-script FOR tt-loc-rule-i-script.
     4150   IF p-script-type = 'COND':U
     4151   or p-script-type = 'CYCLE-COND':U
     4152   THEN DO:
     4153     RUN check-script-type-cond IN THIS-PROCEDURE ( OUTPUT v-script-al
     4154                                              ,OUTPUT v-script-nl) NO-ERROR.
     4155     IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     4156   END.
     4157   if p-script-type = 'CONS':U
     4158   or p-script-type = 'GOTO':U
     4159   then do:
     4160       RUN check-script-type-cons IN THIS-PROCEDURE ( OUTPUT v-script-al
     4161                                                    ,OUTPUT v-script-nl) NO-ERROR.
     4162      IF ERROR-STATUS:ERROR THEN RETURN ERROR.
     4163   end.
     4164   MESSAGE v-script-al SKIP v-script-nl VIEW-AS ALERT-BOX.
     4165   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4166     for each buf_tt-loc-rule-i-script where
     4167     on error undo, return error :
     4168       find first buf_tt-rule-i-script where
     4169                 buf_tt-rule-i-script.root_rule_id = buf_tt-loc-rule-i-script.root_rule_id
     4170            and  buf_tt-rule-i-script.script_id = buf_tt-loc-rule-i-script.script_id
     4171            and  buf_tt-rule-i-script.i-script-name = buf_tt-loc-rule-i-script.i-script-name no-error.
     4172       if not available buf_tt-rule-i-script then do:
     4173         create buf_tt-rule-i-script.
     4174       end.
     4175       buffer-copy buf_tt-loc-rule-i-script to buf_tt-rule-i-script.
     4176     end.
     4177     for each buf_tt-rule-i-script where
     4178             buf_tt-rule-i-script.root_rule_id = p-rule-id
     4179         and buf_tt-rule-i-script.script_id = p-script-id
     4180     on error undo, return error :
     4181       find first buf_tt-loc-rule-i-script where
     4182                 buf_tt-loc-rule-i-script.root_rule_id = buf_tt-rule-i-script.root_rule_id
     4183            and  buf_tt-loc-rule-i-script.script_id = buf_tt-rule-i-script.script_id
     4184            and  buf_tt-loc-rule-i-script.i-script-name = buf_tt-rule-i-script.i-script-name no-error.
     4185       if not available buf_tt-loc-rule-i-script then do:
     4186          delete buf_tt-rule-i-script.
     4187       end.
     4188     end.
     4189     assign
     4190     tt-rule-script.script = v-script-al
     4191     tt-l_rule-script.script = v-script-nl.
     4192   end.
     4193   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4194     ASSIGN
     4195     v-script-id = NEXT-VALUE(s-rule-script-id, ub)
     4196     tt-rule-script.script_id = v-script-id
     4197     tt-rule-script.script = v-script-al
     4198     tt-l_rule-script.script_id = v-script-id
     4199     tt-l_rule-script.script = v-script-nl
     4200    .
     4201     RELEASE tt-rule-script.
     4202     RELEASE tt-l_rule-script.
     4203     for each buf_tt-loc-rule-i-script where
     4204             buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id:
     4205     end.
     4206     for each buf_tt-loc-rule-i-script where
     4207             buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     4208         and buf_tt-loc-rule-i-script.script_id = 0
     4209     on error undo, return error :
     4210       create buf_tt-rule-i-script.
     4211       buffer-copy buf_tt-loc-rule-i-script
     4212       except script_id
     4213       to buf_tt-rule-i-script
     4214       assign
     4215       buf_tt-rule-i-script.script_id = v-script-id
     4216       .
     4217     end.
     4218     p-script-id = v-script-id.
     4219   end.
     4220   END PROCEDURE.
     4221   PROCEDURE proc-undo :
     4222   DEFINE BUFFER buf_tt-rule-script FOR tt-rule-script.
     4223   CASE p-mode:
     4224     WHEN 'ДОБАВЛЕНИЕ':U THEN DO:
     4225       FOR EACH buf_tt-rule-script WHERE
     4226               buf_tt-rule-script.rule_id = p-rule-id
     4227           and buf_tt-rule-script.script_id = 0:
     4228         DELETE buf_tt-rule-script.
     4229       END.
     4230     END.
     4231   END CASE.
     4232   END PROCEDURE.
     4233   PROCEDURE proc-vc-language :
     4234   DEFINE INPUT PARAMETER  p-language AS CHARACTER NO-UNDO.
     4235   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     4236   ASSIGN
     4237   X_pscript-ruleset.script-name:VISIBLE IN BROWSE br-pscript-ruleset =  (p-language = "ABL")
     4238   Y_ruledict.script-al:VISIBLE IN BROWSE br-operator =  (p-language = "ABL")
     4239   tt-ruledict-param.param-name:VISIBLE IN BROWSE br-parameter =  (p-language = "ABL")
     4240   X_dtruledict.script-al:VISIBLE IN BROWSE br-dtruledict =  (p-language = "ABL")
     4241   tt-complex.script-al:VISIBLE IN BROWSE br-complex =  (p-language = "ABL")
     4242   .
     4243   FOR EACH buf_tt-widget NO-LOCK:
     4244      ASSIGN
     4245      buf_tt-widget.HANDLE_:SCREEN-VALUE = (IF p-language = "ABL"
     4246                                            THEN buf_tt-widget.script-al
     4247                                            ELSE buf_tt-widget.script-nl).
     4248   END.
     4249   END PROCEDURE.
     4250   FUNCTION get-current-column RETURNS DECIMAL
     4251     ( input p-right-bottom AS DECIMAL ) :
     4252   DEFINE VARIABLE v-c-r AS DECIMAL NO-UNDO.
     4253   DEFINE VARIABLE v-c-c AS DECIMAL NO-UNDO.
     4254   ASSIGN
     4255   v-c-r = TRUNCATE(p-right-bottom / 98, 0) + 1
     4256   v-c-c = p-right-bottom - (v-c-r - 1 ) * 98 + 1.
     4257   IF v-c-c > 98 THEN DO:
     4258      v-c-r = v-c-r + 1.
     4259      v-c-c = 1.
     4260   END.
     4261   RETURN v-c-c.
     4262   END FUNCTION.
     4263   FUNCTION get-current-row RETURNS DECIMAL
     4264     ( input p-right-bottom AS DECIMAL ) :
     4265   DEFINE VARIABLE v-c-r AS DECIMAL NO-UNDO.
     4266   DEFINE VARIABLE v-c-c AS DECIMAL NO-UNDO.
     4267   ASSIGN
     4268   v-c-r = TRUNCATE(p-right-bottom / 98, 0) + 1
     4269   v-c-c = p-right-bottom - (v-c-r - 1) * 98 + 1.
     4270   IF v-c-c > 98 THEN DO:
     4271      v-c-r = v-c-r + 1.
     4272      v-c-c = 1.
     4273   END.
     4274   RETURN v-c-r.
     4275   END FUNCTION.
     4276   FUNCTION get-left-top RETURNS DECIMAL
     4277     ( INPUT p-row AS decimal, INPUT p-width AS decimal, INPUT p-column AS decimal, INPUT p-height AS DECIMAL ) :
     4278   RETURN (( p-row - 1.0) * 98.0 + p-column).
     4279   END FUNCTION.
     4280   FUNCTION get-right-bottom RETURNS DECIMAL
     4281     ( INPUT p-row AS decimal, INPUT p-width AS decimal, INPUT p-column AS decimal, INPUT p-height AS DECIMAL ) :
     4282   RETURN ( ( p-row - 1.0)  * 98.0 + p-width + p-column ).
     4283   END FUNCTION.
     4284   FUNCTION SUBSTITUTE-value-type RETURNS CHARACTER
     4285     ( INPUT p-value-type AS CHARACTER, buffer buf_tt-widget for tt-widget) :
     4286   define buffer buf_ruledict for ub.ruledict.
     4287   define buffer buf_ruledict-param for ub.ruledict-param.
     4288      if buf_tt-widget.entry-type = 'prop-script':U
     4289      or buf_tt-widget.entry-type = 'parameter':U then do:
     4290      end.
     4291      else do:
     4292         if buf_tt-widget.script-type = 'variable':U then do:
     4293           p-value-type = buf_tt-widget.script-value-type.
     4294         end.
     4295         else do:
     4296           if buf_tt-widget.entry-type = 'operator':U then do:
     4297             find first buf_ruledict no-lock where
     4298                       buf_ruledict.entry-type = 'operator':U
     4299                   and buf_ruledict.script-al = buf_tt-widget.script-al-fix no-error .
     4300             if available buf_ruledict then do:
     4301                 find first buf_ruledict-param no-lock where
     4302                           buf_ruledict-param.entry-id = buf_ruledict.entry-id
     4303                       and buf_ruledict-param.param-num = 0 no-error .
     4304                 if available buf_ruledict-param then do:
     4305                   p-value-type = buf_ruledict-param.param-data-type.
     4306                 end.
     4307                 else do:
     4308                   return buf_tt-widget.script-al.
     4309                 end.
     4310             end.
     4311             else do:
     4312               return buf_tt-widget.script-al.
     4313             end.
     4314           end.
     4315         end.
     4316      end.
     4317   CASE entry(1,p-value-type):
     4318       WHEN 'character':U THEN RETURN '""':U.
     4319       WHEN 'integer':U THEN RETURN '0':U.
     4320       WHEN 'decimal':U THEN RETURN '0.0':U.
     4321       WHEN 'date':U THEN RETURN '?':U.
     4322       WHEN 'logical':U THEN RETURN 'no':U.
     4323       WHEN 'void':U THEN RETURN '(no = no)':U.
     4324   END CASE.
     4325   RETURN buf_tt-widget.script-al.
     4326   END FUNCTION.
