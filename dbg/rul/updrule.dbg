        1   DEFINE TEMP-TABLE tt-loc-rule-i-script NO-UNDO LIKE ub.rule-i-script.
        2   DEFINE SHARED TEMP-TABLE tt-rule NO-UNDO LIKE ub.rule
        3          field level as integer.
        4   DEFINE SHARED TEMP-TABLE tt-rule-i-script NO-UNDO LIKE ub.rule-i-script.
        5   DEFINE SHARED TEMP-TABLE tt-rule-script NO-UNDO LIKE ub.rule-script
        6          field level as integer
        7          field gen-order as character
        8          field upper_rule_id as integer.
        9   DEFINE SHARED TEMP-TABLE tt-ruledict-param NO-UNDO LIKE ub.ruledict-param.
       10   DEFINE BUFFER X_dtruledict FOR ub.ruledict.
       11   DEFINE BUFFER X_prop-script FOR ub.prop-script.
       12   DEFINE BUFFER X_pscript-ruleset FOR ub.pscript-ruleset.
       13   DEFINE BUFFER X_rule-i-script FOR ub.rule-i-script.
       14   DEFINE BUFFER X_ruledict FOR ub.ruledict.
       15   DEFINE BUFFER X_ruleset FOR ub.ruleset.
       16   DEFINE BUFFER Y_prop-script FOR ub.prop-script.
       17   DEFINE BUFFER Y_pscript-ruleset FOR ub.pscript-ruleset.
       18   DEFINE BUFFER Y_ruledict FOR ub.ruledict.
       19   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       20   define input parameter p-mode as character no-undo .
       21   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
       22   DEFINE INPUT PARAMETER p-root-rule-id AS INTEGER NO-UNDO.
       23   define input parameter p-upper-rule-id as integer no-undo .
       24   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
       25   DEFINE INPUT PARAMETER p-script-type AS CHARACTER NO-UNDO.
       26   DEFINE INPUT PARAMETER p-salience AS INTEGER NO-UNDO.
       27   define input-output parameter p-script-id as integer no-undo .
       28   define variable vss-revision    as character no-undo init "$Revision$":U .
       29   define variable vss-author      as character no-undo init "$Author$":U .
       30   define variable vss-date        as character no-undo init "$Date$":U .
       31   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       32   define variable vss-archive     as character no-undo init "$Archive$":U .
       33   define variable vss-description as character no-undo init "Создание одного rule-script".
       34   procedure vss-get-info :
       35     define output parameter p-vss-revision    like vss-revision    no-undo .
       36     define output parameter p-vss-author      like vss-author      no-undo .
       37     define output parameter p-vss-date        like vss-date        no-undo .
       38     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       39     define output parameter p-vss-archive     like vss-archive     no-undo .
       40     define output parameter p-vss-description like vss-description no-undo .
       41     assign
       42       p-vss-revision    = vss-revision
       43       p-vss-author      = vss-author
       44       p-vss-date        = vss-date
       45       p-vss-workfile    = vss-workfile
       46       p-vss-archive     = vss-archive
       47       p-vss-description = vss-description
       48     .
       49   end procedure.
       50   procedure vss-get-parameters :
       51     define output parameter p-vss-parameters as character no-undo .
       52   end procedure.
       53   define new global shared variable g#vssrevis-logger as handle    no-undo .
       54   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       55   define variable v-vssrevis-logger                   as handle    no-undo .
       56   procedure vss-logevent :
       57     define input  parameter p-extra-paramters as character no-undo .
       58     define variable v-vssrevis-parameters as character no-undo .
       59     do
       60     on error undo, return error return-value
       61     :
       62       if  valid-handle(v-vssrevis-logger)
       63       and v-vssrevis-logger :get-signature("logevent") <> ""
       64       then do:
       65         run vss-get-parameters in this-procedure
       66           (output v-vssrevis-parameters
       67           ).
       68         run logevent in v-vssrevis-logger
       69           (input vss-workfile
       70           ,input vss-revision
       71           ,input v-vssrevis-parameters
       72           ,input p-extra-paramters
       73           ).
       74       end.
       75     end.
       76   end procedure.
       77   assign
       78     v-vssrevis-logger = g#vssrevis-logger
       79   .
       80   if  valid-handle(v-vssrevis-logger)
       81   and v-vssrevis-logger :get-signature("logevent") <> ""
       82   then do:
       83     assign
       84       v-vssrevis-logevent = true
       85     .
       86     run vss-logevent in this-procedure (input vss-description) .
       87   end.
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define variable v-waitfram-action01         as character   no-undo .
       90   define variable v-waitfram-action02         as character   no-undo .
       91   define variable v-waitfram-action03         as character   no-undo .
       92   define variable mWaitFramTextBeg            as character   no-undo.
       93   define variable mWaitFramTextEnd            as character   no-undo.
       94   define variable mWaitFramView               as logical     no-undo.
       95   define variable mWaitProcEvent              as logical     no-undo init yes.
       96   define variable mWaitFramInterval           as integer     no-undo init 1 .
       97   define variable mWaitFramStop               as logical     no-undo.
       98   define variable mWaitFramStopUser           as logical     no-undo.
       99   define variable mWaitFramStopTimeOut        as logical     no-undo.
      100   define variable mWaitFramStartProc          as datetime-tz no-undo.
      101   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      102   define button B-WaitFramStop auto-end-key
      103        label "Стоп"
      104        size 10 by 1 tooltip "Остоновить процесс".
      105   define button B-viewProcInfo
      106        label "Информация"
      107        size 15 by 1 tooltip "Информация о процесс".
      108   define frame waitfram
      109     v-waitfram-action01 format "x(72)" no-label skip
      110     v-waitfram-action02 format "x(72)" no-label skip
      111     v-waitfram-action03 format "x(72)" no-label skip
      112     B-viewProcInfo
      113     B-WaitFramStop at row 4 col 30
      114     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      115     .
      116   define new global shared variable mBatchMode as logical no-undo init ?.
      117   define variable mFramBachModHandle as handle no-undo.
      118   mFramBachModHandle = frame waitfram:handle.
      119   define variable mFameOldVis as logical no-undo.
      120   define variable mVisCUrentVin as logical no-undo.
      121   if session:batch-mode
      122   then
      123      mBatchMode = yes.
      124   if mBatchMode = ? then do:
      125     mVisCUrentVin = current-window:visible.
      126     mFameOldVis = mFramBachModHandle:visible.
      127     mFramBachModHandle:visible  = yes.
      128     mBatchMode = mFramBachModHandle:visible ne yes.
      129     mFramBachModHandle:visible = mFameOldVis.
      130     current-window:visible = mVisCUrentVin.
      131   end.
      132    if  log-manager:logfile-name ne ?
      133     then DO:
      134         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      135         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      136         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      137     end.
      138   on choose of B-WaitFramStop in frame waitfram
      139   do:
      140     mWaitFramStop = yes.
      141     mWaitFramStopUser = yes.
      142   end.
      143   function waitfram-check-timeout returns logical():
      144      define variable vtime as int64 no-undo.
      145      if mWaitFramStopTimeOut
      146      then
      147         return yes.
      148      vtime = ( now - mWaitFramStartProc ) / 1000 .
      149      if     mWaitFramTimeOut ne ?
      150         and mWaitFramTimeOut ne 0
      151         and mWaitFramTimeOut lt vtime
      152      then do:
      153         mWaitFramStopTimeOut = yes.
      154      end.
      155      return mWaitFramStopTimeOut.
      156   end.
      157   procedure waitfram-hide :
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       pause 0 before-hide .
      163       if not mBatchMode then
      164         hide frame waitfram .
      165     if     not mWaitFramView
      166        and mWaitProcEvent
      167     then
      168       process events .
      169     end.
      170   end procedure.
      171   procedure waitfram-show :
      172     define input  parameter p-message as character no-undo .
      173     define variable v-left-margin as integer   no-undo .
      174     if not session:batch-mode
      175     then do
      176     on error undo, return error return-value
      177     :
      178       if length(p-message) <= 70 then do:
      179         assign
      180           v-left-margin = integer((70 - length(p-message)) / 2)
      181         .
      182         assign
      183           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      184         .
      185         assign
      186           v-waitfram-action01 = " "
      187           v-waitfram-action02 = " "
      188                                    + fill(" ", v-left-margin)
      189                                    + p-message
      190           v-waitfram-action03 = " "
      191         .
      192       end.
      193       else do:
      194         define variable vRindex1 as integer no-undo.
      195         define variable vRindex2 as integer no-undo.
      196         vRindex1 = r-index(p-message," ",70).
      197         if vRindex1 = 0
      198         then
      199            vRindex1 = 70.
      200         if length(p-message)  <= vRindex1 + 70 then do:
      201           assign
      202             v-waitfram-action01 = " "
      203             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      204             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      205           .
      206         end.
      207         else do:
      208           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      209           if vRindex2 <= vRindex1
      210           then
      211              vRindex2 = vRindex1 + 70.
      212           assign
      213             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      214             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      215             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      216           .
      217         end.
      218       end.
      219       B-viewProcInfo:visible   in frame waitfram = no.
      220       B-viewProcInfo:sensitive in frame waitfram = no.
      221       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      222       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      223       if  (   mWaitFramView
      224          or  mWaitProcEvent)
      225          and not mBatchMode
      226       then
      227          display
      228             v-waitfram-action01 skip
      229             v-waitfram-action02 skip
      230             v-waitfram-action03 skip
      231          with frame waitfram .
      232       if     mWaitFramView
      233          then do:
      234             if     mWaitFramInterval ne ?
      235                and not mBatchMode
      236             then
      237                wait-for go of frame waitfram pause mWaitFramInterval.
      238          end.
      239          else
      240             if     mWaitProcEvent
      241                and not mBatchMode
      242             then
      243                process events .
      244     end.
      245   end procedure.
      246      procedure waitfram-show-this:
      247         define input  parameter iInterval as int64 no-undo.
      248         define variable vtime as int64 no-undo.
      249         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      250         mWaitFramInterval = iInterval.
      251         run waitfram-show (substitute("&1&2 &3&4" ,
      252                                       mWaitFramTextBeg ,
      253                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      254                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      255                                       mWaitFramTextEnd
      256                                      )
      257                           ).
      258      end.
      259      procedure WaitFramRunPause:
      260         define input  parameter iInterval as dec no-undo.
      261         define variable vStart  as datetime-tz no-undo.
      262         define variable vend    as datetime-tz no-undo.
      263         define variable vint as int64 no-undo.
      264         define variable vOk as logical no-undo.
      265         vStart = now.
      266         vend   = vStart.
      267         publish "WaitFramPause" (iInterval,output vOk).
      268         vend   =  now.
      269         vint = vend - vStart.
      270         vint = iInterval - vint / 1000.
      271         if     not mWaitFramStop
      272            and (   vint > 0
      273                 or (    not vOk
      274                     and iInterval eq ?
      275                     )
      276                 )
      277         then
      278            run waitfram-show-this (iInterval).
      279         vend   =  now.
      280         vint = vend - vStart.
      281         vint = iInterval - vint / 1000.
      282         if     not mWaitFramStop
      283            and vint > 0
      284         then do:
      285            run gbl/pause.p (vint * 1000).
      286         end.
      287         if iInterval ne ?
      288         then
      289            publish "WaitFramStop".
      290         waitfram-check-timeout().
      291      end.
      292      procedure WaitFramWaitFor:
      293         define input  parameter iInterval as dec no-undo.
      294         assign
      295            mWaitFramStartProc   = now
      296            mWaitFramStopUser    = no
      297            mWaitFramStopTimeOut = no
      298         .
      299         block-wait:
      300         do while not mWaitFramStop:
      301            run WaitFramRunPause (iInterval).
      302            if  waitfram-check-timeout()
      303            then do:
      304               leave block-wait.
      305            end.
      306         end.
      307         run waitfram-hide.
      308      end.
      309   procedure waitfram-join :
      310     define input  parameter p-line-1  as character no-undo .
      311     define input  parameter p-line-2  as character no-undo .
      312     define input  parameter p-line-3  as character no-undo .
      313     define output parameter p-message as character no-undo .
      314     do
      315     on error undo, return error return-value
      316     :
      317       assign
      318         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      319                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      320                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      321       .
      322     end.
      323   end procedure.
      324   function waitfram-join-function returns character
      325     (input p-line-1 as character
      326     ,input p-line-2 as character
      327     ,input p-line-3 as character
      328     ).
      329     define variable v-message as character no-undo .
      330     run waitfram-join in this-procedure
      331       (input  p-line-1
      332       ,input  p-line-2
      333       ,input  p-line-3
      334       ,output v-message
      335       ) .
      336     return v-message .
      337   end function .
      338   define new global shared variable g#language as character no-undo .
      339   if g#language <> '' and g#language <> 'rus':U then do:
      340     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      341   end.
      342   procedure proc-alt-shift-f2:
      343     if not ibs.th.gbl.gbl-var:rcode
      344   then
      345     run gbl\inidebug.p .
      346   end.
      347   procedure proc-alt-shift-f3:
      348     run gbl/prvssinf.p
      349       ( input this-procedure
      350       ) .
      351   end.
      352   define variable v-inform-launched as logical no-undo initial false .
      353   procedure proc-alt-shift-f4:
      354     define variable v-action as character no-undo .
      355     if v-inform-launched = false then do:
      356       assign
      357         v-inform-launched = true
      358       .
      359       run gbl/d-inform.w
      360         (  input self
      361         ,  input this-procedure
      362         , output v-action
      363         ) no-error .
      364       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      365       assign
      366         v-inform-launched = false
      367       .
      368     end.
      369   end.
      370   procedure proc-alt-f1:
      371     run gbl/corrhelp.p
      372       (input this-procedure
      373       ) .
      374   end .
      375   on alt-shift-f2 anywhere do:
      376     run proc-alt-shift-f2.
      377   end.
      378   on alt-shift-f3 anywhere do:
      379     run proc-alt-shift-f3 in this-procedure .
      380   end.
      381   on alt-shift-f4 anywhere do:
      382     run proc-alt-shift-f4 in this-procedure.
      383   end.
      384   on alt-f1 anywhere do:
      385     run proc-alt-f1 in this-procedure .
      386   end.
      387   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      389   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      390   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      391   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      392   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      393   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      394   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      395   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      396   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      397   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      398   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      399   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      400   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      401   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      402   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      403   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      404   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      405   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   procedure gen-key-rec :
      407     define input  parameter p-tbl-name    as character no-undo.
      408     define input  parameter p-bh_tbl-name as handle    no-undo.
      409     define output parameter p-key-rec     as character no-undo.
      410     do
      411     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      412     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      413     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      414     :
      415       define variable fh               as handle    no-undo .
      416       define variable v-ok             as logical   no-undo .
      417       define variable v-inform         as character no-undo .
      418       define variable v-ind            as integer   no-undo .
      419       define variable v-idx-field-qnty as integer   no-undo .
      420       if p-tbl-name = ?
      421         or p-tbl-name = "":U
      422       then do:
      423         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      424       end.
      425       if not p-bh_tbl-name:available then do:
      426         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      427       end.
      428       assign
      429         p-key-rec = p-tbl-name
      430         v-inform  = p-bh_tbl-name:index-information(1)
      431         v-ind     = 2
      432       .
      433       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      434       on error undo, return error
      435       :
      436         assign
      437           v-inform = p-bh_tbl-name:index-information( v-ind )
      438           v-ind    = v-ind + 1
      439         .
      440       end.
      441       if v-inform = ?
      442         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      443         or entry( 3, v-inform, ",":U ) <> "1":U
      444       then do:
      445         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      446       end.
      447       else do:
      448         assign
      449           v-idx-field-qnty = num-entries( v-inform ) - 4
      450         .
      451         if v-idx-field-qnty < 2 then do:
      452           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      453         end.
      454         do v-ind = 1 to v-idx-field-qnty by 2
      455         on error undo, return error
      456         :
      457           assign
      458             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      459             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      460           .
      461         end.
      462       end.
      463       if p-key-rec = ? then do:
      464         assign
      465           p-key-rec = "":U
      466         .
      467         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      468       end.
      469     end.
      470     return.
      471   end procedure.
      472   procedure gen-where-keyr-tab :
      473     define input  parameter i-tableSerach as character no-undo.
      474     define input  parameter i-tablekey   as character  no-undo.
      475     define input  parameter p-key-rec    as character  no-undo.
      476     define input  parameter p-key-handle as handle     no-undo .
      477     define input  parameter p-db-name    as character  no-undo .
      478     define input  parameter p-tt-handle  as handle     no-undo .
      479     define output parameter o-Where      as character  no-undo.
      480     do
      481     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      482     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      483     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      484     :
      485       define variable v-full-tbl-name  as character no-undo .
      486       define variable bh_tbl-name      as handle    no-undo .
      487       define variable fh_key           as handle    no-undo .
      488       define variable fh_search        as handle    no-undo .
      489       define variable v-field-num      as integer   no-undo .
      490       define variable v-count-fld      as integer   no-undo .
      491       define variable v-inform         as character no-undo .
      492       define variable v-ind            as integer   no-undo .
      493       define variable v-idx-field-qnty as integer   no-undo .
      494       define variable v-field-name     as character no-undo .
      495       define variable v-field-val      as character no-undo .
      496       define variable v-word-link      as character no-undo .
      497       define variable vTable           as character no-undo.
      498       define variable bh_tbl-key       as handle    no-undo .
      499       assign
      500         p-key-rec = trim( p-key-rec )
      501       .
      502       if p-key-handle <> ? then do:
      503         if not valid-handle(p-key-handle)
      504            or p-key-handle:type <> "buffer"
      505         then do:
      506           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      507         end.
      508         if num-entries( p-key-rec, chr(3) ) > 1
      509           or p-key-rec = ?
      510           or p-key-rec = "":U
      511         then do:
      512           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      513         end.
      514       end.
      515       else do:
      516         if p-key-rec = ?
      517           or p-key-rec = "":U
      518         then do:
      519           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      520         end.
      521       end.
      522       assign
      523         vTable = entry( 1 , p-key-rec, chr(3) )
      524       .
      525       if p-tt-handle <> ?
      526         and ( not valid-handle(p-tt-handle)
      527               or p-tt-handle:type <> "buffer"
      528             )
      529       then do:
      530         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      531       end.
      532       if p-tt-handle = ? then do:
      533         assign
      534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      535         .
      536         create buffer bh_tbl-name for table v-full-tbl-name .
      537       end.
      538       else do:
      539         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      540       end.
      541       assign
      542         v-inform = bh_tbl-name:index-information(1)
      543         v-ind    = 2
      544       .
      545       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      546       on error undo, return error
      547       :
      548         assign
      549           v-inform = bh_tbl-name:index-information( v-ind )
      550           v-ind    = v-ind + 1
      551         .
      552       end.
      553       if v-inform = ?
      554         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      555         or entry( 3, v-inform, ",":U ) <> "1":U
      556       then do:
      557         delete object bh_tbl-name no-error.
      558         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      559       end.
      560       assign
      561         v-idx-field-qnty = num-entries( v-inform ) - 4
      562       .
      563       if v-idx-field-qnty < 2 then do:
      564         delete object bh_tbl-name no-error.
      565         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      566       end.
      567       assign
      568         o-where     = "where":U
      569         v-word-link = "":U
      570         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      571         v-count-fld = 0
      572       .
      573       if i-tablekey ne "" and i-tablekey ne ?
      574       then do:
      575         assign
      576           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      577         .
      578         create buffer bh_tbl-key for table v-full-tbl-name .
      579       end.
      580       if i-tableSerach ne "" and i-tableSerach ne ?
      581       then do:
      582         delete object bh_tbl-name no-error.
      583         assign
      584           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      585         .
      586         create buffer bh_tbl-name for table v-full-tbl-name .
      587       end.
      588       block_where:
      589       do v-ind = 1 to v-idx-field-qnty by 2
      590       on error undo, return error
      591       :
      592         assign
      593           v-count-fld = v-count-fld + 1
      594         .
      595         if p-key-handle = ?
      596           and v-count-fld > v-field-num
      597         then do:
      598           leave block_where.
      599         end.
      600         define variable VfieldKeyTable as handle no-undo.
      601         assign
      602           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      603           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      604         .
      605         if     bh_tbl-key ne ?
      606         then do:
      607            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      608            if VfieldKeyTable eq ?
      609            then next block_where.
      610         end.
      611         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      612         then
      613            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      614         else
      615            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      616         if p-key-handle = ? then do:
      617           assign
      618             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      619           .
      620         end.
      621         else do:
      622           assign
      623             fh_key = p-key-handle:buffer-field( v-field-name )
      624           .
      625           if fh_key = ?
      626             or not valid-handle( fh_key )
      627           then do:
      628             delete object bh_tbl-name.
      629             if     bh_tbl-key ne ?
      630             then
      631                delete object bh_tbl-key.
      632             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      633           end.
      634           assign
      635             v-field-val = fh_key:buffer-value
      636           .
      637         end.
      638         if fh_search:data-type ="character":U then do:
      639           assign
      640             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      641             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      642             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      643             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      644             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      645             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      646             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      647             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      648             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      649             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      650             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      651             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      652             v-field-val = substitute( '"&1"', v-field-val )
      653           .
      654         end.
      655         assign
      656           o-where = substitute( "&1 &2", o-where, v-field-val )
      657         .
      658         if v-word-link = "":U then do:
      659           assign
      660             v-word-link = "and":U
      661           .
      662         end.
      663       end.
      664       delete object bh_tbl-name.
      665       if     bh_tbl-key ne ?
      666       then
      667          delete object bh_tbl-key.
      668       if p-key-handle = ?
      669         and v-count-fld <> v-field-num
      670       then do:
      671         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      672       end.
      673     end.
      674   end procedure.
      675   procedure gen-hn-keyr-tab :
      676     define input  parameter i-tableSerach as character no-undo.
      677     define input  parameter i-tablekey   as character no-undo.
      678     define input  parameter p-key-rec    as character no-undo.
      679     define input  parameter p-key-handle as handle    no-undo .
      680     define input  parameter p-db-name    as character no-undo .
      681     define input  parameter p-tt-handle  as handle    no-undo .
      682     define input  parameter p-stts-lock  as integer   no-undo .
      683     define output parameter o-hn         as handle    no-undo.
      684     define variable v-full-tbl-name as character no-undo.
      685     define variable v-where         as character no-undo.
      686     define variable bh_tbl-name     as handle    no-undo.
      687     define variable vTable          as character no-undo.
      688     do
      689     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      690     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      691     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      692         run gen-where-keyr-tab(i-tableSerach,
      693                                i-tablekey,
      694                                p-key-rec,
      695                                p-key-handle,
      696                                p-db-name,
      697                                p-tt-handle,
      698                                output v-where).
      699         if i-tableSerach ne "" and i-tableSerach ne ?
      700         then do:
      701            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      702            create buffer bh_tbl-name for table v-full-tbl-name .
      703         end.
      704         else do:
      705            if p-tt-handle = ? then do:
      706               assign
      707                  vTable = entry( 1 , p-key-rec, chr(3) )
      708               .
      709               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      710               create buffer bh_tbl-name for table v-full-tbl-name .
      711            end.
      712            else do:
      713               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      714            end.
      715         end.
      716         if p-tt-handle = ? then do:
      717            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      718         end.
      719         else do:
      720            bh_tbl-name:find-first( v-where ) no-error .
      721         end.
      722         o-hn = bh_tbl-name.
      723      end.
      724   end procedure.
      725   procedure gen-hn-keyr :
      726     define input  parameter p-key-rec    as character no-undo.
      727     define input  parameter p-key-handle as handle    no-undo .
      728     define input  parameter p-db-name    as character no-undo .
      729     define input  parameter p-tt-handle  as handle    no-undo .
      730     define input  parameter p-stts-lock  as integer   no-undo .
      731     define output parameter o-hn         as handle    no-undo.
      732     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      733   end.
      734   procedure gen-row-keyr :
      735     define input  parameter p-key-rec    as character no-undo.
      736     define input  parameter p-key-handle as handle    no-undo .
      737     define input  parameter p-db-name    as character no-undo .
      738     define input  parameter p-tt-handle  as handle    no-undo .
      739     define input  parameter p-stts-lock  as integer   no-undo .
      740     define output parameter p-tbl-row    as rowid     no-undo.
      741     define output parameter p-tbl-name   as character no-undo.
      742     define variable vHn as handle no-undo.
      743       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      744       p-tbl-row = if vHn:available then vHn:rowid else ?.
      745       p-tbl-name =  vHn:table.
      746       delete object vHn no-error.
      747     if p-tbl-row = ? then do:
      748       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      749     end.
      750     else do:
      751       return.
      752     end.
      753   end procedure.
      754   procedure gen-key-fv :
      755     define input  parameter p-key-rec    as character no-undo .
      756     define output parameter p-field-list as character no-undo .
      757     define output parameter p-value-list as character no-undo.
      758     do
      759     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      760     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      761     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      762     :
      763       define variable v-full-tbl-name  as character no-undo .
      764       define variable bh_tbl-name      as handle    no-undo .
      765       define variable v-tbl-name       as character no-undo .
      766       define variable v-field-num      as integer   no-undo .
      767       define variable v-count-fld      as integer   no-undo .
      768       define variable v-inform         as character no-undo .
      769       define variable v-ind            as integer   no-undo .
      770       define variable v-idx-field-qnty as integer   no-undo .
      771       define variable v-delim-key      as character no-undo .
      772       if p-key-rec = ?
      773         or p-key-rec = "":U
      774       then do:
      775         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      776       end.
      777       assign
      778         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      779         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      780       .
      781       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      782       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      783       assign
      784         v-inform = bh_tbl-name:index-information(1)
      785         v-ind    = 2
      786       .
      787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      788       on error undo, return error
      789       :
      790         assign
      791           v-inform = bh_tbl-name:index-information( v-ind )
      792           v-ind    = v-ind + 1
      793         .
      794       end.
      795       if v-inform = ?
      796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      797         or entry( 3, v-inform, ",":U ) <> "1":U
      798       then do:
      799         delete object bh_tbl-name no-error.
      800         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      801       end.
      802       assign
      803         v-idx-field-qnty = num-entries( v-inform ) - 4
      804       .
      805       if v-idx-field-qnty < 2 then do:
      806         delete object bh_tbl-name no-error.
      807         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      808       end.
      809       assign
      810         p-field-list = "":U
      811         p-value-list = "":U
      812         v-delim-key  = "":U
      813         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      814         v-count-fld  = 0
      815       .
      816       block_where:
      817       do v-ind = 1 to v-idx-field-qnty by 2
      818       on error undo, return error
      819       :
      820         assign
      821           v-count-fld = v-count-fld + 1
      822         .
      823         if v-count-fld > v-field-num then do:
      824           leave block_where.
      825         end.
      826         assign
      827           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      828           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      829         .
      830         if v-ind = 1 then do:
      831           assign
      832             v-delim-key = chr(3)
      833           .
      834         end.
      835       end.
      836       delete object bh_tbl-name.
      837       if v-count-fld <> v-field-num then do:
      838         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      839       end.
      840     end.
      841   end procedure.
      842   procedure gen-key-field :
      843     define input  parameter p-table      as character no-undo .
      844     define output parameter p-field-list as character no-undo .
      845     do
      846     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      847     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      848     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      849     :
      850       define variable v-full-tbl-name  as character no-undo .
      851       define variable bh_tbl-name      as handle    no-undo .
      852       define variable v-tbl-name       as character no-undo .
      853       define variable v-field-num      as integer   no-undo .
      854       define variable v-count-fld      as integer   no-undo .
      855       define variable v-inform         as character no-undo .
      856       define variable v-ind            as integer   no-undo .
      857       define variable v-idx-field-qnty as integer   no-undo .
      858       define variable v-delim-key      as character no-undo .
      859       if p-table = ?
      860         or p-table = "":U
      861       then do:
      862         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      863       end.
      864       assign
      865         v-tbl-name      = p-table
      866         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      867       .
      868       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      869       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      870       assign
      871         v-inform = bh_tbl-name:index-information(1)
      872         v-ind    = 2
      873       .
      874       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      875       on error undo, return error
      876       :
      877         assign
      878           v-inform = bh_tbl-name:index-information( v-ind )
      879           v-ind    = v-ind + 1
      880         .
      881       end.
      882       if v-inform = ?
      883         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      884         or entry( 3, v-inform, ",":U ) <> "1":U
      885       then do:
      886         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      887       end.
      888       assign
      889         v-idx-field-qnty = num-entries( v-inform ) - 4
      890       .
      891       if v-idx-field-qnty < 2 then do:
      892         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      893       end.
      894       assign
      895         p-field-list = "":U
      896         v-delim-key  = "":U
      897         v-count-fld  = 0
      898       .
      899       block_where:
      900       do v-ind = 1 to v-idx-field-qnty by 2
      901       on error undo, return error
      902       :
      903         assign
      904           v-count-fld = v-count-fld + 1
      905         .
      906         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      907         if v-ind = 1 then do:
      908           assign
      909             v-delim-key = chr(3)
      910           .
      911         end.
      912       end.
      913       delete object bh_tbl-name.
      914     end.
      915   end procedure.
      916   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   FUNCTION real-index returns integer(
      918                                       input p-source as character
      919                                      ,input p-target as character
      920                                      ,input p-starting as integer
      921                                      ,output p-sub-number as integer
      922                                      ):
      923   define variable v-dopi as integer no-undo .
      924   define variable v-starting as integer no-undo .
      925   define variable v-subs as character no-undo .
      926   v-starting = p-starting.
      927   _do:
      928   do while true:
      929     v-dopi = index(p-source, p-target, v-starting).
      930     if p-target  begins "&":U
      931     and v-dopi > 0  then do:
      932       if p-target = "&":U then do:
      933         v-subs = substring(p-source, v-dopi + 1, 1).
      934         if v-subs = "&":U
      935         and length(p-source) > v-dopi + 1
      936         then do:
      937           v-starting = v-dopi + 2.
      938         end.
      939         else do:
      940           if v-dopi > 1 then do:
      941             v-subs = substring(p-source, v-dopi - 1, 1).
      942             if v-subs = chr(123) then do:
      943                v-starting = v-dopi + 1.
      944             end.
      945             else do:
      946               leave _do.
      947             end.
      948           end.
      949           else do:
      950             leave _do.
      951           end.
      952         end.
      953       end.
      954       else  do:
      955         if v-dopi > 1 then do:
      956           v-subs = substring(p-source, v-dopi - 1, 1).
      957           if v-subs = "&":U
      958           and length(p-source) > v-dopi + 1
      959           then do:
      960             v-starting = v-dopi + 2.
      961           end.
      962           else do:
      963             leave _do.
      964           end.
      965         end.
      966         else do:
      967           leave _do.
      968         end.
      969       end.
      970     end.
      971     else leave _do.
      972   end.
      973   assign
      974   p-sub-number = integer(substring(p-source, v-dopi + 1, 1)) no-error .
      975   return v-dopi.
      976   end.
      977   DEFINE BUFFER tt-l_rule-script FOR tt-rule-script.
      978   define buffer bufv_tt-rule-i-script for tt-rule-i-script.
      979   DEFINE TEMP-TABLE tt-widget
      980   FIELD handle_ AS WIDGET-HANDLE
      981   FIELD name_ AS CHARACTER
      982   FIELD script-al AS CHARACTER
      983   FIELD script-nl AS CHARACTER
      984   FIELD num_ AS INTEGER
      985   FIELD ROW_ AS DECIMAL
      986   FIELD COLUMN_ AS DECIMAL
      987   FIELD WIDTH_ AS DECIMAL
      988   FIELD HEIGHT_ AS DECIMAL
      989   FIELD left-top AS DECIMAL
      990   FIELD right-bottom AS DECIMAL
      991   FIELD LENGTH_ AS DECIMAL
      992   FIELD script-type AS CHARACTER
      993   FIELD entry-type AS CHARACTER
      994   FIELD script-value-type AS CHARACTER
      995   FIELD data-type AS CHARACTER
      996   FIELD script-al-fix AS CHARACTER
      997   field dtm-code as integer
      998   field class-dtm-code as integer
      999   field uniq-key-rec as character
     1000   INDEX pi IS UNIQUE PRIMARY num_
     1001   INDEX ihandle HANDLE_
     1002   INDEX irc
     1003   ROW_
     1004   COLUMN_
     1005   .
     1006   define temp-table tt-widget-child no-undo
     1007   field num_ as integer
     1008   field level_ as integer
     1009   field position-al as integer
     1010   field position-nl as integer
     1011   field script-nl as character
     1012   field script-al as character
     1013   field entry-id AS INTEGER
     1014   field param-data-type AS CHARACTER
     1015   field param-2-data-type AS CHARACTER
     1016   field param-3-data-type AS CHARACTER
     1017   field param-label AS CHARACTER
     1018   field param-mode AS CHARACTER
     1019   field param-name AS CHARACTER
     1020   field param-num AS INTEGER
     1021   index pi is unique primary
     1022   num_ level_ param-num
     1023   index p-al
     1024   position-al
     1025   index p-nl
     1026   position-nl
     1027   .
     1028   DEFINE VARIABLE v-current-row AS DECIMAL NO-UNDO INIT 18.
     1029   DEFINE VARIABLE v-current-column AS DECIMAL NO-UNDO INIT 1.
     1030   DEFINE TEMP-TABLE tt-complex no-undo
     1031   FIELD script-al AS CHARACTER
     1032   FIELD script-nl AS CHARACTER
     1033   FIELD entry-type AS CHARACTER
     1034   FIELD proc-type AS CHARACTER
     1035   FIELD script-name AS CHARACTER
     1036   FIELD script-type AS CHARACTER
     1037   FIELD script-value-type AS CHARACTER
     1038   FIELD data-type AS CHARACTER
     1039   field dtm-code as integer
     1040   field class-dtm-code as integer
     1041   FIEld KEY_ AS INTEGER
     1042   INDEX pi IS UNIQUE PRIMARY
     1043   KEY_.
     1044   FUNCTION get-current-column RETURNS DECIMAL
     1045     ( input p-right-bottom AS DECIMAL )  FORWARD.
     1046   FUNCTION get-current-row RETURNS DECIMAL
     1047     ( input p-right-bottom AS DECIMAL )  FORWARD.
     1048   FUNCTION get-left-top RETURNS DECIMAL
     1049     ( INPUT p-row AS decimal, INPUT p-width AS decimal, INPUT p-column AS decimal, INPUT p-height AS DECIMAL )  FORWARD.
     1050   FUNCTION get-right-bottom RETURNS DECIMAL
     1051     ( INPUT p-row AS decimal, INPUT p-width AS decimal, INPUT p-column AS decimal, INPUT p-height AS DECIMAL )  FORWARD.
     1052   FUNCTION SUBSTITUTE-value-type RETURNS CHARACTER
     1053     ( INPUT p-value-type AS CHARACTER, buffer buf_tt-widget for tt-widget)  FORWARD.
     1054   DEFINE BUTTON b-complex
     1055        IMAGE-UP FILE "adeicon\ts-up110":U
     1056        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1057        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1058        LABEL ""
     1059        SIZE 14 BY 1.13.
     1060   DEFINE BUTTON b-defvariable
     1061        IMAGE-UP FILE "adeicon\ts-up110":U
     1062        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1063        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1064        LABEL ""
     1065        SIZE 14 BY 1.13.
     1066   DEFINE BUTTON B-exit AUTO-GO
     1067        LABEL "&Ввод"
     1068        SIZE 10 BY 1
     1069        BGCOLOR 8 .
     1070   DEFINE BUTTON B-Help
     1071        LABEL "Помо&щь"
     1072        SIZE 10 BY 1
     1073        BGCOLOR 8 .
     1074   DEFINE BUTTON B-operator
     1075        IMAGE-UP FILE "adeicon\ts-up110":U
     1076        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1077        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1078        LABEL ""
     1079        SIZE 14 BY 1.13.
     1080   DEFINE BUTTON b-parameter
     1081        IMAGE-UP FILE "adeicon\ts-up110":U
     1082        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1083        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1084        LABEL ""
     1085        SIZE 14 BY 1.13.
     1086   DEFINE BUTTON B-prop-script
     1087        IMAGE-UP FILE "adeicon\ts-up110":U
     1088        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1089        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1090        LABEL "&1.Перемещ."
     1091        SIZE 14 BY 1.13.
     1092   DEFINE BUTTON b-quit AUTO-END-KEY
     1093        LABEL "&Отмена"
     1094        SIZE 10 BY 1
     1095        BGCOLOR 8 .
     1096   DEFINE BUTTON b-variable
     1097        IMAGE-UP FILE "adeicon\ts-up110":U
     1098        IMAGE-DOWN FILE "adeicon\ts-dn110":U
     1099        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
     1100        LABEL ""
     1101        SIZE 14 BY 1.13.
     1102   DEFINE VARIABLE cb-pscript-ruleset AS CHARACTER FORMAT "X(256)":U
     1103        VIEW-AS COMBO-BOX INNER-LINES 10
     1104        LIST-ITEM-PAIRS "Item 1","Item 1"
     1105        DROP-DOWN-LIST
     1106        SIZE 98 BY 1 NO-UNDO.
     1107   DEFINE VARIABLE f-complex AS CHARACTER FORMAT "X(12)":U INITIAL "Сложн.выр-ние"
     1108         VIEW-AS TEXT
     1109        SIZE 11 BY .53
     1110        FONT 4 NO-UNDO.
     1111   DEFINE VARIABLE f-defvariable AS CHARACTER FORMAT "X(12)":U INITIAL "Декл.перем."
     1112         VIEW-AS TEXT
     1113        SIZE 11 BY .53
     1114        FONT 4 NO-UNDO.
     1115   DEFINE VARIABLE F-operator AS CHARACTER FORMAT "X(12)":U INITIAL "Оп-ры, конст-ы"
     1116         VIEW-AS TEXT
     1117        SIZE 11 BY .53
     1118        FONT 4 NO-UNDO.
     1119   DEFINE VARIABLE f-parameter AS CHARACTER FORMAT "X(12)":U INITIAL "Параметры"
     1120         VIEW-AS TEXT
     1121        SIZE 11 BY .53
     1122        FONT 4 NO-UNDO.
     1123   DEFINE VARIABLE f-prop-script AS CHARACTER FORMAT "X(12)" INITIAL "Св-ва, мет-ды"
     1124         VIEW-AS TEXT
     1125        SIZE 11 BY .53
     1126        FONT 4 NO-UNDO.
     1127   DEFINE VARIABLE f-variable AS CHARACTER FORMAT "X(12)":U INITIAL "Переменные"
     1128         VIEW-AS TEXT
     1129        SIZE 11 BY .53
     1130        FONT 4 NO-UNDO.
     1131   DEFINE VARIABLE RS-language AS CHARACTER INITIAL "ABL"
     1132        VIEW-AS RADIO-SET HORIZONTAL
     1133        RADIO-BUTTONS
     1134             "ABL", "ABL",
     1135   "lan", "lan"
     1136        SIZE 15 BY 1 NO-UNDO.
     1137   DEFINE QUERY br-complex FOR
     1138         tt-complex SCROLLING.
     1139   DEFINE QUERY br-dtruledict FOR
     1140         X_dtruledict SCROLLING.
     1141   DEFINE QUERY br-operator FOR
     1142         Y_ruledict SCROLLING.
     1143   DEFINE QUERY br-parameter FOR
     1144         tt-ruledict-param SCROLLING.
     1145   DEFINE QUERY br-pscript-ruleset FOR
     1146         X_prop-script,
     1147         X_pscript-ruleset,
     1148         X_ruledict SCROLLING.
     1149   DEFINE QUERY br-variable FOR
     1150         bufv_tt-rule-i-script SCROLLING.
     1151   DEFINE BROWSE br-complex
     1152     QUERY br-complex DISPLAY
     1153         tt-complex.script-al FORMAT "X(255)" WIDTH 45
     1154   tt-complex.script-nl FORMAT "X(255)" WIDTH 45
     1155       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13.8 FIT-LAST-COLUMN.
     1156   DEFINE BROWSE br-dtruledict
     1157     QUERY br-dtruledict NO-LOCK DISPLAY
     1158         X_dtruledict.script-nl COLUMN-LABEL "Тип данных" FORMAT "X(255)":U
     1159       WIDTH 20
     1160   X_dtruledict.script-al COLUMN-LABEL "Тип данных" FORMAT "X(255)":U
     1161       WIDTH 7
     1162       WITH NO-ROW-MARKERS SEPARATORS SIZE 60 BY 13.8 FIT-LAST-COLUMN.
     1163   DEFINE BROWSE br-operator
     1164     QUERY br-operator DISPLAY
     1165         Y_ruledict.script-al FORMAT "X(255)" WIDTH 20 COLUMN-LABEL "Скрипт"
     1166   Y_ruledict.script-nl FORMAT "X(255)" WIDTH 20 COLUMN-LABEL "Скрипт"
     1167       WITH NO-ROW-MARKERS SEPARATORS SIZE 60 BY 13.8 FIT-LAST-COLUMN.
     1168   DEFINE BROWSE br-parameter
     1169     QUERY br-parameter DISPLAY
     1170         tt-ruledict-param.param-data-type COLUMN-LABEL "Тип" FORMAT "X(16)"
     1171   tt-ruledict-param.param-mode COLUMN-LABEL "Мода" FORMAT "X(16)"
     1172   tt-ruledict-param.param-name COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
     1173   tt-ruledict-param.param-label COLUMN-LABEL "Название" FORMAT "X(255)" WIDTH 60
     1174       WITH NO-ROW-MARKERS SEPARATORS SIZE 58 BY 13.8 FIT-LAST-COLUMN.
     1175   DEFINE BROWSE br-pscript-ruleset
     1176     QUERY br-pscript-ruleset DISPLAY
     1177         X_pscript-ruleset.script-name FORMAT "X(255)" WIDTH 45 COLUMN-LABEL "Скрипт"
     1178   entry(1, X_prop-script.script-value-type) FORMAT "X(12)" WIDTH 45 COLUMN-LABEL "Тип знач"
     1179   (IF num-entries(X_prop-script.script-value-type) > 1
     1180    THEN entry(2, X_prop-script.script-value-type)
     1181    ELSE '':U) FORMAT "X(12)"                           COLUMN-LABEL "Тип объ"
     1182   X_ruledict.script-nl FORMAT "X(255)" WIDTH 45 COLUMN-LABEL "Скрипт"
     1183       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.8 FIT-LAST-COLUMN.
     1184   DEFINE BROWSE br-variable
     1185     QUERY br-variable DISPLAY
     1186         bufv_tt-rule-i-script.script-name FORMAT "X(32)" COLUMN-LABEL "Имя переменной"
     1187   bufv_tt-rule-i-script.script-TYPE FORMAT "X(20)" COLUMN-LABEL "Тип переменной"
     1188       WITH NO-ROW-MARKERS SEPARATORS SIZE 52 BY 13.8 FIT-LAST-COLUMN.
     1189   DEFINE FRAME Dialog-Frame
     1190        B-exit AT ROW 1 COL 1
     1191        b-complex AT ROW 2.57 COL 57 WIDGET-ID 40
     1192        b-quit AT ROW 1 COL 11
     1193        RS-language AT ROW 1 COL 30 NO-LABEL WIDGET-ID 2
     1194        B-Help AT ROW 1 COL 54.9
     1195        cb-pscript-ruleset AT ROW 4 COL 1 NO-LABEL WIDGET-ID 46
     1196        br-variable AT ROW 4 COL 1 WIDGET-ID 400
     1197        br-parameter AT ROW 4 COL 1 WIDGET-ID 500
     1198        br-operator AT ROW 4 COL 1 WIDGET-ID 200
     1199        br-dtruledict AT ROW 4 COL 1 WIDGET-ID 300
     1200        br-complex AT ROW 4 COL 1 WIDGET-ID 600
     1201        br-pscript-ruleset AT ROW 5 COL 1 WIDGET-ID 100
     1202        b-defvariable AT ROW 2.57 COL 71 WIDGET-ID 22
     1203        B-operator AT ROW 2.57 COL 15 WIDGET-ID 16
     1204        b-parameter AT ROW 2.57 COL 43 WIDGET-ID 34
     1205        B-prop-script AT ROW 2.57 COL 1 WIDGET-ID 14
     1206        b-variable AT ROW 2.57 COL 29 WIDGET-ID 28
     1207        f-prop-script AT ROW 2.93 COL 2.5 NO-LABEL WIDGET-ID 18
     1208        F-operator AT ROW 2.93 COL 16.5 NO-LABEL WIDGET-ID 20
     1209        f-variable AT ROW 2.93 COL 30.5 NO-LABEL WIDGET-ID 26
     1210        f-parameter AT ROW 2.93 COL 44.5 NO-LABEL WIDGET-ID 36
     1211        f-complex AT ROW 2.93 COL 58.5 NO-LABEL WIDGET-ID 42
     1212        f-defvariable AT ROW 2.93 COL 72.5 NO-LABEL WIDGET-ID 24
     1213        SPACE(15.59) SKIP(19.78)
     1214       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1215            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1216            TITLE ""
     1217            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit DROP-TARGET.
     1218   ASSIGN
     1219          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1220          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1221   ON END-ERROR OF FRAME Dialog-Frame
     1222   DO:
     1223     RUN proc-undo IN THIS-PROCEDURE NO-ERROR.
     1224   END.
     1225   ON ENDKEY OF FRAME Dialog-Frame
     1226   DO:
     1227   RUN proc-undo IN THIS-PROCEDURE NO-ERROR.
     1228   END.
     1229   ON GO OF FRAME Dialog-Frame
     1230   DO:
     1231     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1232     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1233   END.
     1234   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1235   DO:
     1236     APPLY "END-ERROR":U TO SELF.
     1237   END.
     1238   ON CHOOSE OF b-complex IN FRAME Dialog-Frame
     1239   DO:
     1240   run proc-init-b-complex in this-procedure .
     1241   END.
     1242   ON CHOOSE OF b-defvariable IN FRAME Dialog-Frame
     1243   DO:
     1244   run proc-init-b-defvariable in this-procedure .
     1245   END.
     1246   ON CHOOSE OF B-operator IN FRAME Dialog-Frame
     1247   DO:
     1248   run proc-init-b-operator in this-procedure .
     1249   END.
     1250   ON CHOOSE OF b-parameter IN FRAME Dialog-Frame
     1251   DO:
     1252   run proc-init-b-parameter in this-procedure .
     1253   END.
     1254   ON CHOOSE OF B-prop-script IN FRAME Dialog-Frame
     1255   DO:
     1256      run proc-init-b-prop-script in this-procedure .
     1257   END.
     1258   ON CHOOSE OF b-variable IN FRAME Dialog-Frame
     1259   DO:
     1260   run proc-init-b-variable in this-procedure .
     1261   END.
     1262   ON DEFAULT-ACTION OF br-complex IN FRAME Dialog-Frame
     1263   DO:
     1264       IF AVAILABLE tt-complex THEN DO:
     1265         RUN create-tt-complex IN THIS-PROCEDURE ( rs-language
     1266                                                 ,BUFFER tt-complex
     1267                                                 ) NO-ERROR.
     1268       END.
     1269   END.
     1270   ON DEFAULT-ACTION OF br-dtruledict IN FRAME Dialog-Frame
     1271   DO:
     1272     IF AVAILABLE X_dtruledict THEN DO:
     1273       RUN create-datatype IN THIS-PROCEDURE ( INPUT rs-language
     1274                                               ,BUFFER X_dtruledict) NO-ERROR.
     1275       if error-status:error then do:
     1276         apply "End-error" to frame Dialog-Frame  .
     1277       end.
     1278     END.
     1279   END.
     1280   ON DEFAULT-ACTION OF br-operator IN FRAME Dialog-Frame
     1281   DO:
     1282     IF AVAILABLE Y_ruledict THEN DO:
     1283       RUN create-operator IN THIS-PROCEDURE ( INPUT rs-language
     1284                                               ,BUFFER Y_ruledict) NO-ERROR.
     1285     END.
     1286   END.
     1287   ON DEFAULT-ACTION OF br-parameter IN FRAME Dialog-Frame
     1288   DO:
     1289       IF AVAILABLE tt-ruledict-param THEN DO:
     1290         RUN create-parameter IN THIS-PROCEDURE ( rs-language
     1291                                                 ,BUFFER tt-ruledict-param)
     1292                                                  NO-ERROR.
     1293       END.
     1294   END.
     1295   ON DEFAULT-ACTION OF br-pscript-ruleset IN FRAME Dialog-Frame
     1296   DO:
     1297       IF AVAILABLE X_prop-script THEN DO:
     1298         RUN create-prop-script IN THIS-PROCEDURE ( rs-language
     1299                                                 ,BUFFER X_prop-script
     1300                                                 ,BUFFER X_ruledict) NO-ERROR.
     1301       END.
     1302   END.
     1303   ON DEFAULT-ACTION OF br-variable IN FRAME Dialog-Frame
     1304   DO:
     1305       IF AVAILABLE bufv_tt-rule-i-script THEN DO:
     1306         RUN create-variable IN THIS-PROCEDURE ( INPUT rs-language
     1307                                                 ,BUFFER bufv_tt-rule-i-script
     1308                                                 ) NO-ERROR.
     1309       END.
     1310   END.
     1311   ON VALUE-CHANGED OF cb-pscript-ruleset IN FRAME Dialog-Frame
     1312   DO:
     1313     ASSIGN cb-pscript-ruleset.
     1314     OPEN QUERY br-pscript-ruleset FOR EACH X_prop-script NO-LOCK where        X_prop-script.dtm-code = integer(cb-pscript-ruleset),            FIRST X_pscript-ruleset NO-LOCK WHERE      X_pscript-ruleset.codex_id = p-codex-id     AND X_pscript-ruleset.dtm-code = integer(cb-pscript-ruleset)     AND  X_prop-script.language = X_pscript-ruleset.LANGUAGE     AND  X_prop-script.script-name = X_pscript-ruleset.script-name     AND  X_prop-script.revis_id = X_pscript-ruleset.revis_id,            FIRST X_ruledict NO-LOCK WHERE      X_ruledict.ENTRY-TYPE = 'prop-script':U AND  X_ruledict.uniq-key-rec = X_prop-script.uniq-key-rec.
     1315   END.
     1316   ON VALUE-CHANGED OF RS-language IN FRAME Dialog-Frame
     1317   DO:
     1318     ASSIGN
     1319     rs-language.
     1320     RUN proc-vc-language IN THIS-PROCEDURE ( INPUT rs-language).
     1321   END.
     1322   ON DELETE-CHARACTER anywhere
     1323   DO:
     1324     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1325     DEFINE BUFFER buf_tt-widget FOR tt-widget.
     1326     MESSAGE
     1327     "Удалить все выделенные куски?"
     1328     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1329     IF NOT glog  THEN RETURN NO-APPLY.
     1330     FOR EACH buf_tt-widget
     1331     ON error undo, return no-apply
     1332     :
     1333        IF buf_tt-widget.HANDLE:SELECTED THEN DO:
     1334            RUN proc-delete IN THIS-PROCEDURE ( BUFFER buf_tt-widget).
     1335        END.
     1336     END.
     1337   END.
     1338   ON mouse-menu-click anywhere
     1339   DO:
     1340     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1341     DEFINE BUFFER buf_tt-widget FOR tt-widget.
     1342     MESSAGE
     1343     "Сгруппировать все выделенные куски?"
     1344     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1345     IF NOT glog  THEN RETURN NO-APPLY.
     1346     RUN proc-mouse-menu-click IN THIS-PROCEDURE NO-ERROR.
     1347     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1348   END.
     1349   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1350   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1351   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1352   on help of frame Dialog-Frame
     1353   do:
     1354     run gbl/app_help.p
     1355       (input this-procedure :file-name
     1356       ,input ''
     1357       ,input ?
     1358       ) no-error.
     1359     if error-status :error then do:
     1360       message
     1361         "Ошибка при вызове помощи"
     1362         error-status :get-message(1)
     1363         view-as alert-box .
     1364     end.
     1365   end.
     1366   run minbtn-set in this-procedure .
     1367   on choose of b-help in frame Dialog-Frame
     1368   do:
     1369     apply "help":u to frame Dialog-Frame .
     1370   end.
     1371   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   procedure minbtn-set :
     1373       do
     1374           on error undo, return error return-value
     1375           :
     1376           define variable ii              as integer       no-undo .
     1377           define variable fh              as widget-handle no-undo .
     1378           define variable hh              as widget-handle no-undo .
     1379           define variable v-h             as handle        extent 4 no-undo .
     1380           define variable v-name-button   as character     no-undo .
     1381           define variable v-help-old-x    as decimal       no-undo .
     1382           define variable v-help-old-y    as decimal       no-undo .
     1383           define variable v-help-old-size as decimal       no-undo .
     1384           define variable v-frame-width   as decimal       no-undo .
     1385           define variable jj              as integer       no-undo .
     1386           do
     1387               on error undo, return error
     1388               :
     1389               assign
     1390                   v-frame-width = frame Dialog-Frame:width - 0.3
     1391                   fh            = frame Dialog-Frame:first-child
     1392                   hh            = fh:first-child
     1393                   ii            = 1
     1394                   .
     1395               do while valid-handle(hh):
     1396                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1397                   do:
     1398                       case lc(hh:name) :
     1399                           when "b-help" then
     1400                               do:
     1401                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1402                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1403                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1404                                   hh:TOOLTIP = "Помощь" .
     1405                                   v-help-old-x = hh:column .
     1406                                   v-help-old-y = hh:row    .
     1407                                   v-help-old-size = hh:width .
     1408                                   hh:width-chars = 2.5 .
     1409                               end.
     1410                           when "b-print" then
     1411                               do:
     1412                                   hh:load-image("cmp/b-print.bmp":u) .
     1413                                   hh:TOOLTIP = "Печать" .
     1414                                   v-h[ii] = hh:handle .
     1415                                   ii = ii + 1 .
     1416                                   hh:width-chars = 3 .
     1417                               end.
     1418                           when "b-history" or
     1419                           when "b-hist" then
     1420                               do:
     1421                                   hh:load-image("cmp/b-hist.bmp":u) .
     1422                                   hh:TOOLTIP = "История" .
     1423                                   v-h[ii] = hh:handle .
     1424                                   ii = ii + 1 .
     1425                                   hh:width-chars = 3 .
     1426                               end.
     1427                           when "b-sch" then
     1428                               do:
     1429                                   hh:load-image("cmp/b-sch.bmp":u) .
     1430                                   hh:TOOLTIP = "Установка Фильтра" .
     1431                                   v-h[ii] = hh:handle .
     1432                                   ii = ii + 1 .
     1433                                   hh:width-chars = 3 .
     1434                               end.
     1435                           when "b-hist-user" then
     1436                               do:
     1437                                   hh:load-image("cmp/b-hist.bmp":u) .
     1438                                   hh:TOOLTIP = "История пользователя" .
     1439                                   ii = ii + 1 .
     1440                               end.
     1441                       end case.
     1442                   end.
     1443                   hh = hh:next-sibling.
     1444               end.
     1445               b-help:column = v-frame-width - b-help:width-chars.
     1446               jj = 0.
     1447               repeat ii = 4 to 1 by -1 :
     1448                   if valid-handle (v-h[ii] ) then
     1449                   do:
     1450                       jj  = jj + 1 .
     1451                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1452                       v-h[ii]:row    = v-help-old-y .
     1453                   end.
     1454               end.
     1455           end.
     1456       end.
     1457   end procedure.
     1458   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1459   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1460   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1461   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1462   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1463   define variable v-diasize-current-frame-height as decimal   no-undo .
     1464   define variable v-diasize-change-size          as logical   no-undo .
     1465   define variable v-diasize-resize-button        as handle    no-undo .
     1466   define variable v-diasize-wndmax               as logical   no-undo .
     1467   define variable v-diasize-wndstore             as logical   no-undo .
     1468   define variable v-diasize-proc-name            as character no-undo .
     1469   define variable v-diasize-browse-handle        as handle    no-undo .
     1470   define variable v-diasize-browse-number        as integer   no-undo .
     1471   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1472   define temp-table temp-diasize-handle no-undo
     1473     field handle-value  as handle
     1474     field save-position as decimal
     1475     index xpk is primary unique handle-value
     1476     .
     1477   define temp-table temp-browse-handle no-undo
     1478     field browse-type   as character
     1479     field browse-number as integer
     1480     field browse-handle as handle
     1481     field original-size as decimal
     1482     index xpk is primary unique browse-type browse-number
     1483     index xie browse-type browse-handle
     1484   .
     1485   procedure diasize_change-height :
     1486     define input  parameter p-change-value  as decimal   no-undo .
     1487     define input  parameter p-move-resize   as logical   no-undo .
     1488     define variable v-field-group-handle    as handle    no-undo .
     1489     define variable v-object-handle         as handle    no-undo .
     1490     define variable v-frame-height          as decimal   no-undo .
     1491     define variable v-frame-virtual-height  as decimal   no-undo .
     1492     define variable v-browse-height         as decimal   no-undo .
     1493     define variable v-window-height         as decimal   no-undo .
     1494     define variable v-window-virtual-height as decimal   no-undo .
     1495     define variable v-change-sign           as integer   no-undo .
     1496     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1497     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1498     if p-change-value > 0
     1499     then do:
     1500       if frame Dialog-Frame :height + p-change-value
     1501           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1502       then do:
     1503         assign
     1504           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1505                           - (frame Dialog-Frame :height-chars)
     1506         .
     1507         if p-change-value <= 0
     1508         then do:
     1509           run diasize_position-resize-button in this-procedure .
     1510           return .
     1511         end.
     1512       end.
     1513     end.
     1514     if p-change-value < 0
     1515     then do:
     1516       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1517       then do:
     1518         assign
     1519           p-change-value = v-diasize-orig-frame-height
     1520                          - (frame Dialog-Frame :height-chars)
     1521         .
     1522         if p-change-value >= 0
     1523         then do:
     1524           run diasize_position-resize-button in this-procedure .
     1525           return .
     1526         end.
     1527       end.
     1528     end.
     1529     if p-change-value >= 0
     1530     then do:
     1531       assign
     1532         v-change-sign = 1
     1533       .
     1534     end.
     1535     else do:
     1536       assign
     1537         v-change-sign = -1
     1538       .
     1539     end.
     1540     assign
     1541       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1542     .
     1543     if p-change-value = 0
     1544     then do:
     1545       run diasize_position-resize-button in this-procedure .
     1546       return .
     1547     end.
     1548     move_block:
     1549     do
     1550     on error undo move_block, retry move_block
     1551     :
     1552       if retry
     1553       then do:
     1554         do
     1555         on error undo move_block, leave move_block
     1556         :
     1557           if p-change-value > 0
     1558           then do:
     1559             for each buf_temp-diasize-handle
     1560             on error undo, next
     1561             :
     1562               assign
     1563                 v-object-handle = buf_temp-diasize-handle.handle-value
     1564               .
     1565               if v-object-handle <> v-diasize-resize-button
     1566               then do:
     1567                 assign
     1568                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1569                 .
     1570               end.
     1571             end.
     1572             assign
     1573               v-diasize-browse-handle :height = v-browse-height
     1574             .
     1575             for each buf_temp-browse-handle
     1576               where buf_temp-browse-handle.browse-type = 'height':u
     1577             on error undo, next
     1578             :
     1579               assign
     1580                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1581               .
     1582             end.
     1583             assign
     1584               frame Dialog-Frame :height = v-frame-height
     1585             .
     1586             if frame Dialog-Frame :scrollable = true
     1587             then do:
     1588               assign
     1589                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1590               .
     1591             end.
     1592             run diasize_position-resize-button in this-procedure .
     1593           end.
     1594           else do:
     1595             if frame Dialog-Frame :scrollable = true
     1596             then do:
     1597               assign
     1598                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1599               .
     1600             end.
     1601             assign
     1602               frame Dialog-Frame :height = v-frame-height
     1603             .
     1604             assign
     1605               v-diasize-browse-handle :height = v-browse-height
     1606             .
     1607             for each buf_temp-browse-handle
     1608               where buf_temp-browse-handle.browse-type = 'height':u
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1613               .
     1614             end.
     1615             for each buf_temp-diasize-handle
     1616             on error undo, next
     1617             :
     1618               assign
     1619                 v-object-handle = buf_temp-diasize-handle.handle-value
     1620               .
     1621               if v-object-handle <> v-diasize-resize-button
     1622               then do:
     1623                 assign
     1624                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1625                 .
     1626               end.
     1627             end.
     1628             run diasize_position-resize-button in this-procedure .
     1629           end.
     1630           assign
     1631             v-diasize-change-size = false
     1632           .
     1633           leave move_block .
     1634         end.
     1635       end.
     1636       assign
     1637         v-diasize-need-full-display = true
     1638       .
     1639       if v-diasize-change-size = false
     1640       then do:
     1641         assign
     1642           v-diasize-change-size = true
     1643         .
     1644       end.
     1645       else do:
     1646         return .
     1647       end.
     1648       assign
     1649         v-frame-height = frame Dialog-Frame :height
     1650         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1651         v-browse-height = v-diasize-browse-handle :height
     1652       .
     1653       for each buf_temp-browse-handle
     1654         where buf_temp-browse-handle.browse-type = 'height':u
     1655       :
     1656         assign
     1657           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1658         .
     1659       end.
     1660       for each buf_temp-diasize-handle
     1661       :
     1662         delete buf_temp-diasize-handle .
     1663       end.
     1664       assign
     1665         v-field-group-handle = frame Dialog-Frame :first-child
     1666       .
     1667       do while valid-handle(v-field-group-handle)
     1668       :
     1669         assign
     1670           v-object-handle = v-field-group-handle :first-child
     1671         .
     1672         do while valid-handle(v-object-handle)
     1673         :
     1674           if  v-object-handle <> v-diasize-browse-handle :handle
     1675           and can-query(v-object-handle, "row")
     1676           and can-query(v-object-handle, "height")
     1677           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1678           then do:
     1679             find first buf_temp-browse-handle
     1680               where buf_temp-browse-handle.browse-type   = 'height':u
     1681                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1682               no-error .
     1683             if available buf_temp-browse-handle
     1684             then do:
     1685             end.
     1686             else do:
     1687               create buf_temp-diasize-handle .
     1688               assign
     1689                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1690                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1691               .
     1692             end.
     1693           end.
     1694           assign
     1695             v-object-handle = v-object-handle :next-sibling
     1696           .
     1697         end.
     1698         assign
     1699           v-field-group-handle = v-field-group-handle :next-sibling
     1700         .
     1701       end.
     1702       do with frame Dialog-Frame
     1703       :
     1704         hide v-diasize-resize-button .
     1705         assign
     1706           v-diasize-resize-button :row    = 1
     1707           v-diasize-resize-button :column = 1
     1708         .
     1709       end.
     1710       if p-change-value > 0
     1711       then do:
     1712         if frame Dialog-Frame :scrollable = true
     1713         then do:
     1714           assign
     1715             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1716             no-error .
     1717           if error-status :error
     1718           or error-status :get-message(1) <> ""
     1719           then do:
     1720             undo move_block, retry move_block .
     1721           end.
     1722         end.
     1723         assign
     1724           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1725           no-error .
     1726         if error-status :error
     1727         or error-status :get-message(1) <> ""
     1728         then do:
     1729           undo move_block, retry move_block .
     1730         end.
     1731         assign
     1732           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1733           no-error .
     1734         if error-status :error
     1735         or error-status :get-message(1) <> ""
     1736         then do:
     1737           undo move_block, retry move_block .
     1738         end.
     1739         for each buf_temp-browse-handle
     1740           where buf_temp-browse-handle.browse-type = 'height':u
     1741         on error undo move_block, retry move_block
     1742         :
     1743           assign
     1744             buf_temp-browse-handle.browse-handle :height
     1745               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1746             no-error .
     1747           if error-status :error
     1748           or error-status :get-message(1) <> ""
     1749           then do:
     1750             undo move_block, retry move_block .
     1751           end.
     1752         end.
     1753         for each buf_temp-diasize-handle
     1754         on error undo move_block, retry move_block
     1755         :
     1756           assign
     1757             v-object-handle = buf_temp-diasize-handle.handle-value
     1758           .
     1759           if v-object-handle <> v-diasize-resize-button
     1760           then do:
     1761             assign
     1762               v-object-handle :row = v-object-handle :row + p-change-value
     1763               no-error .
     1764             if error-status :error
     1765             or error-status :get-message(1) <> ""
     1766             then do:
     1767               undo move_block, retry move_block .
     1768             end.
     1769           end.
     1770         end.
     1771       end.
     1772       else do:
     1773         for each buf_temp-diasize-handle
     1774         on error undo move_block, retry move_block
     1775         :
     1776           assign
     1777             v-object-handle = buf_temp-diasize-handle.handle-value
     1778           .
     1779           if v-object-handle <> v-diasize-resize-button
     1780           then do:
     1781             assign
     1782               v-object-handle :row = v-object-handle :row + p-change-value
     1783               no-error .
     1784             if error-status :error
     1785             or error-status :get-message(1) <> ""
     1786             then do:
     1787               undo move_block, retry move_block .
     1788             end.
     1789           end.
     1790         end.
     1791         assign
     1792           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1793           no-error .
     1794         if error-status :error
     1795         or error-status :get-message(1) <> ""
     1796         then do:
     1797           undo move_block, retry move_block .
     1798         end.
     1799         for each buf_temp-browse-handle
     1800           where buf_temp-browse-handle.browse-type = 'height':u
     1801         on error undo move_block, retry move_block
     1802         :
     1803           assign
     1804             buf_temp-browse-handle.browse-handle :height
     1805               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1806             no-error .
     1807           if error-status :error
     1808           or error-status :get-message(1) <> ""
     1809           then do:
     1810             undo move_block, retry move_block .
     1811           end.
     1812         end.
     1813         assign
     1814           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1815           no-error .
     1816         if error-status :error
     1817         or error-status :get-message(1) <> ""
     1818         then do:
     1819           undo move_block, retry move_block .
     1820         end.
     1821         if frame Dialog-Frame :scrollable = true
     1822         then do:
     1823           assign
     1824             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1825             no-error .
     1826           if error-status :error
     1827           or error-status :get-message(1) <> ""
     1828           then do:
     1829             undo move_block, retry move_block .
     1830           end.
     1831         end.
     1832       end.
     1833       if p-move-resize = true
     1834       then do:
     1835         run diasize_position-resize-button in this-procedure .
     1836       end.
     1837       if v-diasize-wndstore = true
     1838       then do:
     1839         if connected("ub") = true
     1840         then do:
     1841           define variable v-cntxt-db-num        as integer   no-undo .
     1842           define variable v-cntxt-userid        as character no-undo .
     1843           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1844                                             , OUTPUT v-cntxt-userid
     1845                                             ) .
     1846           run gbl/wndsizew.p
     1847             (input  v-cntxt-db-num
     1848             ,input  v-cntxt-userid
     1849             ,input  v-diasize-proc-name
     1850             ,input  'height':u
     1851             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1852             ) .
     1853         end.
     1854       end.
     1855     end.
     1856     assign
     1857       v-diasize-change-size = false
     1858     .
     1859   end procedure.
     1860   procedure diasize_set-height :
     1861     define input  parameter p-new-height  as decimal   no-undo .
     1862     define input  parameter p-move-resize as logical   no-undo .
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       run diasize_change-height in this-procedure
     1867         (input  (p-new-height - frame Dialog-Frame :height)
     1868         ,input  p-move-resize
     1869         ) .
     1870     end.
     1871   end procedure.
     1872   procedure diasize_change-width :
     1873     define input  parameter p-change-value as decimal   no-undo .
     1874     define input  parameter p-move-resize  as logical   no-undo .
     1875     define variable v-field-group-handle   as handle    no-undo .
     1876     define variable v-object-handle        as handle    no-undo .
     1877     define variable v-frame-width          as decimal   no-undo .
     1878     define variable v-frame-virtual-width  as decimal   no-undo .
     1879     define variable v-browse-width         as decimal   no-undo .
     1880     define variable v-window-width         as decimal   no-undo .
     1881     define variable v-window-virtual-width as decimal   no-undo .
     1882     define variable v-change-sign          as integer   no-undo .
     1883     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1884     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1885     if p-change-value > 0
     1886     then do:
     1887       if frame Dialog-Frame :width + p-change-value >
     1888           session :width-chars
     1889       then do:
     1890         assign
     1891           p-change-value = session :width-chars - frame Dialog-Frame :width
     1892         .
     1893         if p-change-value <= 0
     1894         then do:
     1895           run diasize_position-resize-button in this-procedure .
     1896           return .
     1897         end.
     1898       end.
     1899     end.
     1900     if p-change-value < 0
     1901     then do:
     1902       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1903       then do:
     1904         assign
     1905           p-change-value = v-diasize-orig-frame-width
     1906                          - frame Dialog-Frame :width
     1907         .
     1908         if p-change-value >= 0
     1909         then do:
     1910           run diasize_position-resize-button in this-procedure .
     1911           return .
     1912         end.
     1913       end.
     1914     end.
     1915     if p-change-value >= 0
     1916     then do:
     1917       assign
     1918         v-change-sign = 1
     1919       .
     1920     end.
     1921     else do:
     1922       assign
     1923         v-change-sign = -1
     1924       .
     1925     end.
     1926     assign
     1927       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1928     .
     1929     if p-change-value = 0
     1930     then do:
     1931       run diasize_position-resize-button in this-procedure .
     1932       return .
     1933     end.
     1934     move_block:
     1935     do
     1936     on error undo move_block, leave move_block
     1937     :
     1938       if retry
     1939       then do:
     1940         do
     1941         on error undo move_block, leave move_block
     1942         :
     1943           if p-change-value > 0
     1944           then do:
     1945             for each buf_temp-diasize-handle
     1946             on error undo, next
     1947             :
     1948               assign
     1949                 v-object-handle = buf_temp-diasize-handle.handle-value
     1950               .
     1951               if v-object-handle <> v-diasize-resize-button
     1952               then do:
     1953                 assign
     1954                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1955                 .
     1956               end.
     1957             end.
     1958             assign
     1959               v-diasize-browse-handle :width = v-browse-width
     1960             .
     1961             for each buf_temp-browse-handle
     1962               where buf_temp-browse-handle.browse-type = 'width':u
     1963             on error undo, next
     1964             :
     1965               assign
     1966                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1967               .
     1968             end.
     1969             assign
     1970               frame Dialog-Frame :width = v-frame-width
     1971             .
     1972             if frame Dialog-Frame :scrollable = true
     1973             then do:
     1974               assign
     1975                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1976               .
     1977             end.
     1978             run diasize_position-resize-button in this-procedure .
     1979           end.
     1980           else do:
     1981             if frame Dialog-Frame :scrollable = true
     1982             then do:
     1983               assign
     1984                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1985               .
     1986             end.
     1987             assign
     1988               frame Dialog-Frame :width = v-frame-width
     1989             .
     1990             for each buf_temp-browse-handle
     1991               where buf_temp-browse-handle.browse-type = 'width':u
     1992             on error undo, next
     1993             :
     1994               assign
     1995                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1996               .
     1997             end.
     1998             assign
     1999               v-diasize-browse-handle :width = v-browse-width
     2000             .
     2001             for each buf_temp-diasize-handle
     2002             on error undo, next
     2003             :
     2004               assign
     2005                 v-object-handle = buf_temp-diasize-handle.handle-value
     2006               .
     2007               if v-object-handle <> v-diasize-resize-button
     2008               then do:
     2009                 assign
     2010                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2011                 .
     2012               end.
     2013             end.
     2014             run diasize_position-resize-button in this-procedure .
     2015           end.
     2016           assign
     2017             v-diasize-change-size = false
     2018           .
     2019           leave move_block .
     2020         end.
     2021       end.
     2022       assign
     2023         v-diasize-need-full-display = true
     2024       .
     2025       if v-diasize-change-size = false
     2026       then do:
     2027         assign
     2028           v-diasize-change-size = true
     2029         .
     2030       end.
     2031       else do:
     2032         return .
     2033       end.
     2034       assign
     2035         v-frame-width = frame Dialog-Frame :width
     2036         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2037         v-browse-width = v-diasize-browse-handle :width
     2038       .
     2039       for each buf_temp-browse-handle
     2040         where buf_temp-browse-handle.browse-type = 'width':u
     2041       :
     2042         assign
     2043           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2044         .
     2045       end.
     2046       for each buf_temp-diasize-handle
     2047       :
     2048         delete buf_temp-diasize-handle .
     2049       end.
     2050       assign
     2051         v-field-group-handle = frame Dialog-Frame :first-child
     2052       .
     2053       do while valid-handle(v-field-group-handle)
     2054       :
     2055         assign
     2056           v-object-handle = v-field-group-handle :first-child
     2057         .
     2058         do while valid-handle(v-object-handle)
     2059         :
     2060           if  v-object-handle <> v-diasize-browse-handle :handle
     2061           and v-object-handle <> v-diasize-resize-button
     2062           and can-query(v-object-handle, "row")
     2063           and can-query(v-object-handle, "height")
     2064           and ( v-object-handle :col + v-object-handle :width
     2065                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2066               )
     2067           then do:
     2068             find first buf_temp-browse-handle
     2069               where buf_temp-browse-handle.browse-type   = 'width':u
     2070                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2071               no-error .
     2072             if available buf_temp-browse-handle
     2073             then do:
     2074             end.
     2075             else do:
     2076               create buf_temp-diasize-handle .
     2077               assign
     2078                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2079                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2080               .
     2081             end.
     2082           end.
     2083           assign
     2084             v-object-handle = v-object-handle :next-sibling
     2085           .
     2086         end.
     2087         assign
     2088           v-field-group-handle = v-field-group-handle :next-sibling
     2089         .
     2090       end.
     2091       do with frame Dialog-Frame
     2092       :
     2093         hide v-diasize-resize-button .
     2094         v-diasize-resize-button :row = 1.
     2095         v-diasize-resize-button :column = 1.
     2096       end.
     2097       if p-change-value > 0
     2098       then do:
     2099         if frame Dialog-Frame :scrollable = true
     2100         then do:
     2101           assign
     2102             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2103             no-error .
     2104           if error-status :error
     2105           or error-status :get-message(1) <> ""
     2106           then do:
     2107             undo move_block, retry move_block.
     2108           end.
     2109         end.
     2110         assign
     2111           frame Dialog-Frame :width = v-frame-width + p-change-value
     2112           no-error .
     2113         if error-status :error
     2114         or error-status :get-message(1) <> ""
     2115         then do:
     2116           undo move_block, retry move_block.
     2117         end.
     2118         assign
     2119           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2120         no-error .
     2121         if error-status :error
     2122         or error-status :get-message(1) <> ""
     2123         then do:
     2124           undo move_block, retry move_block.
     2125         end.
     2126         for each buf_temp-browse-handle
     2127           where buf_temp-browse-handle.browse-type = 'width':u
     2128         on error undo move_block, retry move_block
     2129         :
     2130           assign
     2131             buf_temp-browse-handle.browse-handle :width
     2132               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2133             no-error .
     2134           if error-status :error
     2135           or error-status :get-message(1) <> ""
     2136           then do:
     2137             undo move_block, retry move_block .
     2138           end.
     2139         end.
     2140         for each buf_temp-diasize-handle
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             v-object-handle = buf_temp-diasize-handle.handle-value
     2145           .
     2146           if v-object-handle <> v-diasize-resize-button
     2147           then do:
     2148             assign
     2149               v-object-handle :col = v-object-handle :col + p-change-value
     2150               no-error .
     2151             if error-status :error
     2152             or error-status :get-message(1) <> ""
     2153             then do:
     2154               undo move_block, retry move_block .
     2155             end.
     2156           end.
     2157         end.
     2158       end.
     2159       else do:
     2160         for each buf_temp-diasize-handle
     2161         on error undo move_block, retry move_block
     2162         :
     2163           assign
     2164             v-object-handle = buf_temp-diasize-handle.handle-value
     2165           .
     2166           if v-object-handle <> v-diasize-resize-button
     2167           then do:
     2168             assign
     2169               v-object-handle :col = v-object-handle :col + p-change-value
     2170               no-error .
     2171             if error-status :error
     2172             or error-status :get-message(1) <> ""
     2173             then do:
     2174               undo move_block, retry move_block .
     2175             end.
     2176           end.
     2177         end.
     2178         for each buf_temp-browse-handle
     2179           where buf_temp-browse-handle.browse-type = 'width':u
     2180         on error undo move_block, retry move_block
     2181         :
     2182           assign
     2183             buf_temp-browse-handle.browse-handle :width
     2184               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2185             no-error .
     2186           if error-status :error
     2187           or error-status :get-message(1) <> ""
     2188           then do:
     2189             undo move_block, retry move_block .
     2190           end.
     2191         end.
     2192         assign
     2193           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2194           no-error .
     2195         if error-status :error
     2196         or error-status :get-message(1) <> ""
     2197         then do:
     2198           undo move_block, retry move_block.
     2199         end.
     2200         assign
     2201           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2202         no-error .
     2203         if error-status :error
     2204         or error-status :get-message(1) <> ""
     2205         then do:
     2206           undo move_block, retry move_block.
     2207         end.
     2208         if frame Dialog-Frame :scrollable = true
     2209         then do:
     2210           assign
     2211             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2212           no-error .
     2213           if error-status :error
     2214           or error-status :get-message(1) <> ""
     2215           then do:
     2216             undo move_block, retry move_block.
     2217           end.
     2218         end.
     2219       end.
     2220       if p-move-resize
     2221       then do:
     2222         run diasize_position-resize-button in this-procedure .
     2223       end.
     2224       if v-diasize-wndstore = true
     2225       then do:
     2226         if connected("ub") = true
     2227         then do:
     2228           define variable v-cntxt-db-num        as integer   no-undo .
     2229           define variable v-cntxt-userid        as character no-undo .
     2230           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2231                                             , OUTPUT v-cntxt-userid
     2232                                             ) .
     2233           run gbl/wndsizew.p
     2234             (input  v-cntxt-db-num
     2235             ,input  v-cntxt-userid
     2236             ,input  v-diasize-proc-name
     2237             ,input  'width':u
     2238             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2239             ) .
     2240         end.
     2241       end.
     2242     end.
     2243     assign
     2244       v-diasize-change-size = false
     2245     .
     2246   end procedure.
     2247   procedure diasize_set-width :
     2248     define input  parameter p-new-width  as decimal   no-undo .
     2249     define input  parameter p-move-resize as logical   no-undo .
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       run diasize_change-width in this-procedure
     2254         (input  (p-new-width - frame Dialog-Frame :width)
     2255         ,input  p-move-resize
     2256         ) .
     2257     end.
     2258   end procedure.
     2259   procedure diasize_position-resize-button :
     2260     do with frame Dialog-Frame
     2261     :
     2262       hide v-diasize-resize-button .
     2263       assign
     2264         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2265                     - 1
     2266                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2267         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2268                     - 1
     2269                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2270       .
     2271       view v-diasize-resize-button .
     2272     end.
     2273   end procedure.
     2274   on alt-right anywhere
     2275   do:
     2276     run diasize_change-width in this-procedure
     2277       (input 1
     2278       ,input true
     2279       ) .
     2280     return no-apply .
     2281   end.
     2282   on alt-left anywhere
     2283   do:
     2284     run diasize_change-width in this-procedure
     2285       (input -1
     2286       ,input true
     2287       ) .
     2288     return no-apply .
     2289   end.
     2290   on alt-down anywhere
     2291   do:
     2292     run diasize_change-height in this-procedure
     2293       (input 1
     2294       ,input true
     2295       ) .
     2296     return no-apply .
     2297   end.
     2298   on alt-up anywhere
     2299   do:
     2300     run diasize_change-height in this-procedure
     2301       (input -1
     2302       ,input true
     2303       ) .
     2304     return no-apply .
     2305   end.
     2306   on alt-enter of frame Dialog-Frame
     2307   do:
     2308     run diasize_maximize in this-procedure
     2309       (input  ?
     2310       ).
     2311     return no-apply .
     2312   end.
     2313   procedure diasize_end-move :
     2314     do
     2315     on error undo, return error return-value
     2316     :
     2317       define variable v-row-delta as decimal   no-undo .
     2318       define variable v-col-delta as decimal   no-undo .
     2319       define variable v-new-row as decimal   no-undo .
     2320       define variable v-new-col as decimal   no-undo .
     2321       assign
     2322         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2323         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2324       .
     2325       assign
     2326         v-row-delta = v-new-row - frame Dialog-Frame :height
     2327         v-col-delta = v-new-col - frame Dialog-Frame :width
     2328       .
     2329       run diasize_change-height in this-procedure
     2330         (input v-row-delta
     2331         ,input true
     2332         ) .
     2333       run diasize_change-width in this-procedure
     2334         (input v-col-delta
     2335         ,input true
     2336         ) .
     2337     end.
     2338   end procedure.
     2339   procedure diasize_maximize :
     2340     define input  parameter p-action as logical   no-undo .
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       if p-action = ?
     2345       then do:
     2346         if v-diasize-need-maximize = true
     2347         then do:
     2348           assign
     2349             p-action = true
     2350           .
     2351         end.
     2352         else do:
     2353           assign
     2354             p-action = false
     2355           .
     2356         end.
     2357       end.
     2358       if p-action = true
     2359       then do:
     2360         run diasize_change-height in this-procedure
     2361           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2362               - frame Dialog-Frame :height-chars
     2363           ,input true
     2364           ) .
     2365         run diasize_change-width in this-procedure
     2366           (input session :width-chars
     2367               - frame Dialog-Frame :width-chars
     2368           ,input true
     2369           ) .
     2370         assign
     2371           v-diasize-need-maximize = false
     2372         .
     2373       end.
     2374       else do:
     2375         run diasize_change-width in this-procedure
     2376           (input v-diasize-orig-frame-width
     2377               - frame Dialog-Frame :width-chars
     2378           ,input true
     2379           ) .
     2380         run diasize_change-height in this-procedure
     2381           (input v-diasize-orig-frame-height
     2382               - frame Dialog-Frame :height-chars
     2383           ,input true
     2384           ) .
     2385         assign
     2386           v-diasize-need-maximize = true
     2387         .
     2388       end.
     2389     end.
     2390   end procedure.
     2391   procedure diasize_restore-orig-size :
     2392     do
     2393     on error undo, return error return-value
     2394     :
     2395       assign
     2396         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2397         v-diasize-current-frame-height = frame Dialog-Frame :height
     2398       .
     2399       run diasize_set-height in this-procedure
     2400         (input  v-diasize-orig-frame-height
     2401         ,input  true
     2402         ) .
     2403       run diasize_set-width in this-procedure
     2404         (input  v-diasize-orig-frame-width
     2405         ,input  true
     2406         ) .
     2407     end.
     2408   end procedure.
     2409   procedure diasize_restore-current-size :
     2410     do
     2411     on error undo, return error return-value
     2412     :
     2413       run diasize_set-height in this-procedure
     2414         (input  v-diasize-current-frame-height
     2415         ,input  true
     2416         ) .
     2417       run diasize_set-width in this-procedure
     2418         (input  v-diasize-current-frame-width
     2419         ,input  true
     2420         ) .
     2421     end.
     2422   end procedure.
     2423   procedure diasize_set-browse-handle :
     2424     define input  parameter p-browse-handle as handle   no-undo .
     2425     define buffer buf_temp-browse-handle for temp-browse-handle .
     2426     do
     2427     on error undo, return error return-value
     2428     :
     2429       assign
     2430         v-diasize-browse-handle = p-browse-handle
     2431       .
     2432       for each buf_temp-browse-handle
     2433       on error undo, return error return-value
     2434       :
     2435         delete buf_temp-browse-handle .
     2436       end.
     2437     end.
     2438   end procedure.
     2439   procedure diasize_add_browse :
     2440     define input  parameter p-browse-type   as character no-undo .
     2441     define input  parameter p-browse-handle as handle    no-undo .
     2442     define buffer buf_temp-browse-handle for temp-browse-handle .
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       assign
     2447         v-diasize-browse-number = v-diasize-browse-number + 1
     2448       .
     2449       create buf_temp-browse-handle .
     2450       assign
     2451         buf_temp-browse-handle.browse-type   = p-browse-type
     2452         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2453         buf_temp-browse-handle.browse-handle = p-browse-handle
     2454       .
     2455     end.
     2456   end procedure.
     2457   procedure diasize_init :
     2458     define variable v-default-value    as logical   no-undo .
     2459     define variable v-restore-saved    as logical   no-undo .
     2460     define variable v-resize-value-str as character no-undo .
     2461     do
     2462     on error undo, return error return-value
     2463     :
     2464       do with frame Dialog-Frame
     2465       :
     2466         assign
     2467           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2468           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2469           v-diasize-browse-handle     = browse br-complex :handle
     2470         .
     2471         create button v-diasize-resize-button
     2472         assign
     2473           parent        = frame Dialog-Frame :first-child
     2474           label         = "s"
     2475           height-pixels = 16
     2476           width-pixels  = 16
     2477           visible       = true
     2478           sensitive     = true
     2479           movable       = true
     2480           triggers:
     2481             on end-move persistent run diasize_end-move in this-procedure .
     2482           end triggers.
     2483         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2484         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2485         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2486         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2487         assign
     2488           v-diasize-wndmax = false
     2489         .
     2490         if connected("ub") = true
     2491         then do:
     2492           define variable v-cntxt-db-num        as integer   no-undo .
     2493           define variable v-cntxt-userid        as character no-undo .
     2494           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2495                                             , OUTPUT v-cntxt-userid
     2496                                             ) .
     2497           run gbl/wndpar_r.p
     2498             (input  v-cntxt-db-num
     2499             ,input  v-cntxt-userid
     2500             ,input  'wndmax':U
     2501             ,output v-diasize-wndmax
     2502             ,output v-default-value
     2503             ) .
     2504         end.
     2505         assign
     2506           v-diasize-wndstore = false
     2507         .
     2508         if connected("ub") = true
     2509         then do:
     2510           run gbl/wndpar_r.p
     2511             (input  v-cntxt-db-num
     2512             ,input  v-cntxt-userid
     2513             ,input  'wndstore':U
     2514             ,output v-diasize-wndstore
     2515             ,output v-default-value
     2516             ) .
     2517         end.
     2518         assign
     2519           v-diasize-proc-name = entry(1, program-name(2), '.')
     2520         .
     2521         if v-diasize-wndstore = true
     2522         then do:
     2523           assign
     2524             v-restore-saved = false
     2525           .
     2526           if connected("ub") = true
     2527           then do:
     2528             run gbl/wndsizer.p
     2529               (input  v-cntxt-db-num
     2530               ,input  v-cntxt-userid
     2531               ,input  v-diasize-proc-name
     2532               ,input  'height':u
     2533               ,output v-resize-value-str
     2534               ) .
     2535             if v-resize-value-str <> '':U
     2536             then do:
     2537               run diasize_change-height in this-procedure
     2538                 (input  integer(v-resize-value-str)
     2539                 ,input  true
     2540                 ) .
     2541               assign
     2542                 v-restore-saved = true
     2543               .
     2544             end.
     2545           end.
     2546           if connected("ub") = true
     2547           then do:
     2548             run gbl/wndsizer.p
     2549               (input  v-cntxt-db-num
     2550               ,input  v-cntxt-userid
     2551               ,input  v-diasize-proc-name
     2552               ,input  'width':u
     2553               ,output v-resize-value-str
     2554               ) .
     2555             if v-resize-value-str <> '':U
     2556             then do:
     2557               run diasize_change-width in this-procedure
     2558                 (input  integer(v-resize-value-str)
     2559                 ,input  true
     2560                 ) .
     2561               assign
     2562                 v-restore-saved = true
     2563               .
     2564             end.
     2565           end.
     2566           if v-restore-saved <> true
     2567           then do:
     2568             if v-diasize-wndmax = true
     2569             then do:
     2570               run diasize_maximize in this-procedure
     2571                 (input  true
     2572                 ) .
     2573             end.
     2574           end.
     2575         end.
     2576         else do:
     2577           if v-diasize-wndmax = true
     2578           then do:
     2579             run diasize_maximize in this-procedure
     2580               (input  true
     2581               ) .
     2582           end.
     2583         end.
     2584       end.
     2585     end.
     2586   end procedure.
     2587   procedure diasize_need-full-display :
     2588     define output parameter p-need-full-display as logical   no-undo .
     2589     do
     2590     on error undo, return error return-value
     2591     :
     2592       assign
     2593         p-need-full-display = v-diasize-need-full-display
     2594       .
     2595       assign
     2596         v-diasize-need-full-display = false
     2597       .
     2598     end.
     2599   end procedure.
     2600   procedure get-context :
     2601      define output parameter p-db-num as integer          no-undo.
     2602      define output parameter p-user-id as character        no-undo.
     2603      define variable v-login               as character    no-undo.
     2604      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2605      define buffer buf_user-login  for ub.user-login .
     2606      do
     2607      on error undo, return error
     2608      :
     2609            FIND FIRST buf_sys-ctrl no-lock.
     2610            ASSIGN
     2611               v-login = USERID("ub")
     2612               p-db-num = buf_sys-ctrl.db-num
     2613            .
     2614            FIND FIRST buf_user-login
     2615                 WHERE buf_user-login.db-num = p-db-num
     2616                   AND buf_user-login.user-login = v-login
     2617                 no-lock
     2618                 no-error
     2619                 .
     2620            IF AVAILABLE buf_user-login
     2621            THEN DO:
     2622               assign
     2623                  p-user-id = buf_user-login.user-id
     2624               .
     2625            END.
     2626      end.
     2627   end procedure.
     2628       run diasize_init in this-procedure .
     2629   MAIN-BLOCK:
     2630   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2631      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2632     if p-mode <> 'ДОБАВЛЕНИЕ':U
     2633     and p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     2634       message
     2635       vss-workfile vss-revision vss-description skip
     2636       "Неверное значение параметра p-mode" p-mode
     2637       view-as alert-box error .
     2638       undo, return error .
     2639     end.
     2640     RUN fill-tables IN THIS-PROCEDURE no-error.
     2641     if error-status:error then do:
     2642       undo, return error return-value .
     2643     end.
     2644     RUN Myenable in this-procedure no-error  .
     2645     if error-status:error then do:
     2646       undo, return error return-value .
     2647     end.
     2648     WAIT-FOR GO OF FRAME Dialog-Frame.
     2649   END.
     2650   RUN disable_UI.
     2651   FOR EACH tt-widget:
     2652     IF VALID-HANDLE(tt-widget.HANDLE_) THEN DO:
     2653       DELETE WIDGET tt-widget.HANDLE_.
     2654     END.
     2655     DELETE tt-widget.
     2656   END.
     2657   PROCEDURE check-script-type-cond :
     2658   DEFINE output PARAMETER p-script-al AS CHARACTER NO-UNDO.
     2659   DEFINE output PARAMETER p-script-nl AS CHARACTER NO-UNDO.
     2660   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2661   DEFINE variable v-script-al AS CHARACTER NO-UNDO.
     2662   DEFINE variable v-script-al-subs AS CHARACTER NO-UNDO.
     2663   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     2664   FOR EACH buf_tt-widget
     2665   BY buf_tt-widget.right-bottom
     2666       :
     2667      ASSIGN
     2668      p-script-al = substitute("&1 &2"
     2669                               ,p-script-al
     2670                               ,buf_tt-widget.script-al)
     2671      v-script-al = substitute("&1 &2"
     2672                                 ,v-script-al
     2673                                 ,SUBSTITUTE-value-type (buf_tt-widget.script-value-type, buffer buf_tt-widget)
     2674                                   )
     2675      p-script-nl = substitute("&1 &2"
     2676                                 ,p-script-nl
     2677                                 ,buf_tt-widget.script-nl
     2678                                 ).
     2679      .
     2680      message buf_tt-widget.script-al skip
     2681      v-script-al
     2682       view-as alert-box .
     2683   END.
     2684   MESSAGE p-script-al SKIP "from check-script-type-cond"
     2685   skip v-script-al
     2686   VIEW-AS ALERT-BOX.
     2687   define variable v-sub-number as integer no-undo .
     2688   IF real-INDEX(p-script-al, "&", 1, output v-sub-number) > 0  THEN DO:
     2689     MESSAGE
     2690     "Подставлены не все параметры!"
     2691     VIEW-AS ALERT-BOX ERROR.
     2692     UNDO, RETURN ERROR.
     2693   END.
     2694   run rul/check-expr-by-query.p ( INPUT v-script-al
     2695                                  ,OUTPUT glog) NO-ERROR.
     2696   IF NOT glog THEN DO:
     2697     MESSAGE
     2698     "Выражение сформулировано неверно!"
     2699     VIEW-AS ALERT-BOX ERROR.
     2700     RETURN ERROR.
     2701   END.
     2702   END PROCEDURE.
     2703   PROCEDURE check-script-type-cons :
     2704   DEFINE output PARAMETER p-script-al AS CHARACTER NO-UNDO.
     2705   DEFINE output PARAMETER p-script-nl AS CHARACTER NO-UNDO.
     2706   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2707   DEFINE VARIABLE v-first AS LOGICAL NO-UNDO INIT YES.
     2708   DEFINE VARIABLE v-is-void AS LOGICAL NO-UNDO INIT YES.
     2709   DEFINE variable v-script-al AS CHARACTER NO-UNDO.
     2710   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     2711   FOR EACH buf_tt-widget
     2712   BY buf_tt-widget.right-bottom
     2713       :
     2714      IF buf_tt-widget.script-value-type = 'void':U THEN DO:
     2715         IF NOT v-first THEN DO:
     2716           MESSAGE
     2717           "В одной строке может быть только один скрипт типа" 'void':U
     2718           VIEW-AS alert-box ERROR.
     2719           undo, RETURN ERROR.
     2720         END.
     2721         v-is-void = YES.
     2722      END.
     2723      v-first = NO.
     2724      ASSIGN
     2725      p-script-al = substitute("&1 &2"
     2726                                 ,p-script-al
     2727                                 ,buf_tt-widget.script-al)
     2728      p-script-nl = substitute("&1 &2"
     2729                                 ,p-script-nl
     2730                                 ,buf_tt-widget.script-nl
     2731                                 )
     2732      v-script-al = substitute("&1 &2"
     2733                                 ,p-script-al
     2734                                 ,(IF buf_tt-widget.entry-type = 'prop-script':U
     2735                                   THEN SUBSTITUTE-value-type (buf_tt-widget.script-value-type, buffer buf_tt-widget)
     2736                                   ELSE buf_tt-widget.script-al))
     2737      .
     2738   END.
     2739   MESSAGE p-script-al "from check-script-type-cons" VIEW-AS ALERT-BOX.
     2740   define variable v-sub-number as integer no-undo .
     2741   IF real-INDEX(p-script-al, "&", 1, output v-sub-number) > 0  THEN DO:
     2742     MESSAGE
     2743     "Подставлены не все параметры!"
     2744     VIEW-AS ALERT-BOX ERROR.
     2745     UNDO, RETURN ERROR.
     2746   END.
     2747   IF NOT v-is-void  THEN DO:
     2748       run rul/check-expr-by-query.p ( INPUT v-script-al
     2749                                      ,OUTPUT glog) NO-ERROR.
     2750       IF NOT glog THEN DO:
     2751         MESSAGE
     2752         "Выражение сформулировано неверно!"
     2753         VIEW-AS ALERT-BOX ERROR.
     2754         RETURN ERROR.
     2755       END.
     2756   END.
     2757   END PROCEDURE.
     2758   PROCEDURE create-datatype :
     2759   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     2760   DEFINE parameter BUFFER buf_ruledict FOR ub.ruledict.
     2761   DEFINE variable v-ok AS LOGICAL NO-UNDO.
     2762   DEFINE VARIABLE v-variable-name AS CHARACTER NO-UNDO.
     2763   DEFINE VARIABLE v-script-nl AS CHARACTER NO-UNDO.
     2764   DEFINE VARIABLE v-script-al AS CHARACTER NO-UNDO.
     2765   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     2766   DEFINE VARIABLE v-check-name AS CHARACTER NO-UNDO.
     2767   define variable v-tbl-row as row no-undo .
     2768   define variable v-tbl-name as character no-undo .
     2769   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     2770   DEFINE BUFFER buf_tt-rule-i-script FOR tt-rule-i-script.
     2771   define buffer buf_prop-script for ub.prop-script.
     2772   FIND FIRST buf_tt-widget NO-LOCK NO-ERROR .
     2773   IF AVAILABLE buf_tt-widget
     2774   or p-script-type = 'GOTO':U
     2775   THEN DO:
     2776     MESSAGE
     2777     "Определение переменной можно поместить только в пустой скрипт типа CONS"
     2778     VIEW-AS ALERT-BOX.
     2779     UNDO, RETURN ERROR.
     2780   END.
     2781   v-format = "X(32)".
     2782   run gbl/d-character.w (
     2783         INPUT ?
     2784       , INPUT (
     2785         'title=':u + substitute("Декларирование переменной типа &1", buf_ruledict.script-nl) + '\':u
     2786       + 'text1=':u + "Введите имя переменной" + '\':u
     2787       + 'foemta=' + v-format + '\':u
     2788       + 'fillin_row=3\':u
     2789       + 'fillin_col=4\':u
     2790       + 'fillin_width=20\':u
     2791       + 'fillin_height=1\':u
     2792       + 'readonly=' + 'no':u + '\':u)
     2793       , input-output v-variable-name
     2794       , output v-ok
     2795           ).
     2796       if not v-ok then return error.
     2797   ASSIGN
     2798   v-check-name = TRIM(v-variable-name, "abcdefghijklmnopqrstuvwxyz1234567890-").
     2799   IF v-check-name <> '':U
     2800   OR lookup(substring(v-variable-name, 1, 1), "0123456789") > 0  THEN DO:
     2801     MESSAGE
     2802     "Имя переменной может содержать только латинские буквы, цифры, символ '-' и начинаться с буквы"
     2803     VIEW-AS ALERT-BOX ERROR.
     2804     UNDO, RETURN ERROR.
     2805   END.
     2806   IF LENGTH(v-variable-name) > 32  THEN DO:
     2807       MESSAGE
     2808       "Имя переменной не может быть длиннее 32 символов"
     2809       VIEW-AS ALERT-BOX ERROR.
     2810     UNDO, RETURN ERROR.
     2811   END.
     2812   FIND FIRST buf_tt-rule-i-script NO-LOCK WHERE
     2813             buf_tt-rule-i-script.i-script-type = 'variable':U
     2814        AND  buf_tt-rule-i-script.i-script-name = v-variable-name NO-ERROR.
     2815   IF AVAILABLE buf_tt-rule-i-script THEN DO:
     2816       MESSAGE
     2817       "Уже есть переменная с  таким именем"
     2818       VIEW-AS ALERT-BOX ERROR.
     2819     UNDO, RETURN ERROR.
     2820   END.
     2821   if lookup(buf_ruledict.script-al, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0  then do:
     2822     RUN gen-row-keyr IN THIS-PROCEDURE
     2823       ( input  buf_ruledict.uniq-key-rec
     2824        ,input ?
     2825        ,input "ub":U
     2826        ,input ?
     2827        ,input no-lock
     2828        ,output v-tbl-row
     2829        ,output  v-tbl-name
     2830       ) NO-ERROR.
     2831     if error-status:error then do:
     2832       message
     2833       substitute("Не найден Тип данных &1 (класс)", buf_ruledict.script-al)
     2834       view-as alert-box error .
     2835       undo, return error .
     2836     end.
     2837     if v-tbl-name <> 'prop-script':U then do:
     2838       message
     2839       substitute("Тип данных &1 в словаре не привязан к классу", buf_ruledict.script-al)
     2840       view-as alert-box error .
     2841       undo, return error .
     2842     end.
     2843     find first buf_prop-script no-lock where
     2844               rowid(buf_prop-script) = v-tbl-row.
     2845   end.
     2846   ASSIGN
     2847   v-script-al = substitute("define variable &1 as &2 &3 no-undo"
     2848                            , v-variable-name
     2849                            , (if lookup(buf_ruledict.script-al, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0
     2850                               then '':U
     2851                               else "class")
     2852                            , (if lookup(buf_ruledict.script-al, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0
     2853                               then buf_ruledict.script-al
     2854                               else buf_prop-script.script-head)
     2855                            )
     2856   v-script-nl = substitute("Декларируем переменную &1 тип &2"
     2857                            , v-variable-name
     2858                            , buf_ruledict.script-nl).
     2859   RUN create-widget IN THIS-PROCEDURE (
     2860                                         input (if available buf_prop-script
     2861                                                then buf_prop-script.dtm-code
     2862                                                else 0)
     2863                                        ,input (if available buf_prop-script
     2864                                                then buf_prop-script.class-dtm-code
     2865                                                else 0)
     2866                                        ,INPUT p-language
     2867                                        ,INPUT v-variable-name
     2868                                        ,INPUT v-script-al
     2869                                        ,INPUT v-script-nl
     2870                                        ,INPUT buf_ruledict.entry-type
     2871                                        ,INPUT 'variable':U
     2872                                        ,INPUT 'void':U
     2873                                        ,INPUT (if lookup(buf_ruledict.script-al, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0
     2874                                             then buf_ruledict.script-al
     2875                                             else buf_ruledict.script-al)
     2876                                        ,input '':U
     2877                                        ,input '':U
     2878                                        ) NO-ERROR.
     2879   IF ERROR-STATUS:ERROR THEN DO:
     2880     UNDO, RETURN ERROR.
     2881   END.
     2882   END PROCEDURE.
     2883   PROCEDURE create-operator :
     2884   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     2885   DEFINE parameter BUFFER buf_ruledict FOR ub.ruledict.
     2886   DEFINE VARIABLE v-script-al AS CHARACTER NO-UNDO.
     2887   DEFINE VARIABLE v-script-nl AS CHARACTER NO-UNDO.
     2888   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     2889   DEFINE VARIABLE v-character AS CHARACTER NO-UNDO.
     2890   DEFINE VARIABLE v-longchar AS CHARACTER NO-UNDO.
     2891   DEFINE VARIABLE v-date AS date NO-UNDO.
     2892   DEFINE VARIABLE v-decimal AS decimal NO-UNDO.
     2893   DEFINE VARIABLE v-integer AS integer NO-UNDO.
     2894   DEFINE VARIABLE v-logical AS logical NO-UNDO.
     2895   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     2896   IF buf_ruledict.ENTRY-TYPE = 'datatype':U
     2897   THEN DO:
     2898     CASE buf_ruledict.script-al:
     2899       WHEN 'character':U THEN DO:
     2900          run gbl/d-character.w (
     2901                                  INPUT ?
     2902                                 ,INPUT '':U
     2903                                 ,input-output v-character
     2904                                 ,output v-ok
     2905                                  ) NO-ERROR.
     2906          IF ERROR-STATUS:ERROR
     2907          OR NOT v-ok THEN undo, RETURN error.
     2908          ASSIGN
     2909          v-script-al = substitute('"&1"', v-character)
     2910          v-script-nl = substitute('"&1"', v-character)
     2911          .
     2912       END.
     2913       WHEN 'longchar':U THEN DO:
     2914          run gbl/d-longchar.w (
     2915                                  INPUT ?
     2916                                 ,INPUT '':U
     2917                                 ,input-output v-longchar
     2918                                 ,output v-ok
     2919                                  ) NO-ERROR.
     2920          IF ERROR-STATUS:ERROR
     2921          OR NOT v-ok THEN undo, RETURN error.
     2922          ASSIGN
     2923          v-script-al = substitute('"&1"', v-longchar)
     2924          v-script-nl = substitute('"&1"', v-longchar)
     2925          v-longchar = '':U
     2926          .
     2927       END.
     2928       WHEN 'date':U THEN DO:
     2929           v-format = "99/99/9999".
     2930         run gbl/d-inpday.w
     2931           (input ?
     2932           ,input "Календарь"
     2933           ,input ""
     2934           ,input ""
     2935           ,input-output v-date
     2936           ,output v-ok
     2937           ) NO-ERROR.
     2938         IF ERROR-STATUS:ERROR
     2939         OR NOT v-ok THEN undo, RETURN error.
     2940         ASSIGN
     2941         v-script-al = substitute('&1', string(v-date, "99/99/9999"))
     2942         v-script-nl = substitute('&1', string(v-date, "99/99/9999"))
     2943         .
     2944       END.
     2945       WHEN 'decimal':U THEN DO:
     2946           v-format = "->>>,>>>,>>9.999".
     2947           run gbl/d-decimal.w (
     2948                                   INPUT ?
     2949                                  ,INPUT ('format=' + v-format + '\':u
     2950                                          )
     2951                                    , input-output v-decimal
     2952                                    , output v-ok
     2953                                        ) NO-ERROR.
     2954           IF ERROR-STATUS:ERROR
     2955           OR NOT v-ok THEN undo, RETURN error.
     2956           ASSIGN
     2957           v-script-al = substitute('&1', string(v-decimal))
     2958           v-script-nl = substitute('&1', string(v-decimal))
     2959           .
     2960       END.
     2961       WHEN 'integer':U THEN DO:
     2962           v-format = "->>>,>>>,>>9".
     2963           run gbl/d-integer.w (
     2964                                   INPUT ?
     2965                                  ,INPUT ('format=' + v-format + '\':u
     2966                                            )
     2967                                    , input-output v-integer
     2968                                    , output v-ok
     2969                                        ) NO-ERROR.
     2970           ASSIGN
     2971           v-script-al = substitute('&1', string(v-integer))
     2972           v-script-nl = substitute('&1', string(v-integer))
     2973           .
     2974       END.
     2975       WHEN 'logical':U THEN DO:
     2976           v-format = "+/".
     2977           run gbl/d-logical.w (
     2978                                   INPUT ?
     2979                                  ,INPUT ('format=' + v-format + '\':u
     2980                                    )
     2981                                    , input-output v-logical
     2982                                    , output v-ok
     2983                                        ) NO-ERROR.
     2984           ASSIGN
     2985           v-script-al = substitute('&1', string(v-logical))
     2986           v-script-nl = substitute('&1', string(v-logical))
     2987           .
     2988       END.
     2989     END CASE.
     2990     message v-script-al view-as alert-box .
     2991   END.
     2992   ELSE DO:
     2993     ASSIGN
     2994     v-script-nl = buf_ruledict.script-nl
     2995     v-script-al = buf_ruledict.script-al
     2996     .
     2997   END.
     2998   RUN create-widget IN THIS-PROCEDURE ( INPUT 0
     2999                                        ,input 0
     3000                                        ,INPUT p-language
     3001                                        ,INPUT v-script-al
     3002                                        ,INPUT v-script-al
     3003                                        ,INPUT v-script-nl
     3004                                        ,INPUT (IF buf_ruledict.entry-type = 'control':U
     3005                                                or buf_ruledict.entry-type = 'operator':U
     3006                                                THEN buf_ruledict.entry-type
     3007                                                ELSE '':U)
     3008                                        ,INPUT '':U
     3009                                        ,INPUT '':u
     3010                                        ,INPUT (IF buf_ruledict.entry-type = 'datatype':U
     3011                                                THEN buf_ruledict.script-al
     3012                                                ELSE '':U)
     3013                                        ,input '':U
     3014                                        ,input buf_ruledict.uniq-key-rec
     3015                                                    ).
     3016   END PROCEDURE.
     3017   PROCEDURE create-parameter :
     3018   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     3019   DEFINE parameter BUFFER buf_tt-ruledict-param FOR tt-ruledict-param.
     3020   RUN create-widget IN THIS-PROCEDURE ( INPUT 0
     3021                                        ,INPUT 0
     3022                                        ,INPUT p-language
     3023                                        ,INPUT buf_tt-ruledict-param.param-name
     3024                                        ,INPUT buf_tt-ruledict-param.param-name
     3025                                        ,INPUT buf_tt-ruledict-param.param-label
     3026                                        ,INPUT 'parameter':U
     3027                                        ,INPUT '':U
     3028                                        ,INPUT buf_tt-ruledict-param.param-data-type
     3029                                        ,INPUT buf_tt-ruledict-param.param-data-type
     3030                                        ,input '':U
     3031                                        ,input '':U
     3032                                            ).
     3033   END PROCEDURE.
     3034   PROCEDURE create-prop-script :
     3035   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     3036   DEFINE parameter BUFFER buf_prop-script FOR ub.prop-script.
     3037   DEFINE parameter BUFFER buf_ruledict FOR ub.ruledict.
     3038   DEFINE VARIABLE v-object-type AS CHARACTER NO-UNDO.
     3039   IF LOOKUP(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0  THEN DO:
     3040     v-object-type = trim(entry(2, buf_prop-script.script-body, chr(32)), ".").
     3041     v-object-type = ENTRY(NUM-ENTRIES(v-object-type, "."), v-object-type, ".").
     3042   END.
     3043   ELSE DO:
     3044     v-object-type = buf_prop-script.script-value-type.
     3045   END.
     3046   RUN create-widget IN THIS-PROCEDURE ( INPUT buf_prop-script.dtm-code
     3047                                        ,INPUT buf_prop-script.class-dtm-code
     3048                                        ,INPUT p-language
     3049                                        ,INPUT buf_prop-script.script-name
     3050                                        ,INPUT buf_prop-script.script-name
     3051                                        ,INPUT buf_ruledict.script-nl
     3052                                        ,INPUT 'prop-script':U
     3053                                        ,INPUT buf_prop-script.script-type
     3054                                        ,INPUT buf_prop-script.script-value-type
     3055                                        ,INPUT v-object-type
     3056                                        ,input buf_prop-script.proc-type
     3057                                        ,input buf_prop-script.uniq-key-rec
     3058                                        ).
     3059   END PROCEDURE.
     3060   PROCEDURE create-rule-i-script :
     3061   DEFINE INPUT PARAMETER p-dtm-code AS INTEGER NO-UNDO.
     3062   define input parameter p-class-dtm-code as integer no-undo .
     3063   DEFINE INPUT PARAMETER p-i-script-name AS CHARACTER NO-UNDO.
     3064   DEFINE INPUT PARAMETER p-i-script-type AS CHARACTER NO-UNDO.
     3065   DEFINE INPUT PARAMETER p-script-name AS CHARACTER NO-UNDO.
     3066   DEFINE INPUT PARAMETER p-script-type AS CHARACTER NO-UNDO.
     3067   define input parameter p-subsid as logical no-undo .
     3068   DEFINE VARIABLE v-sub-object AS CHARACTER NO-UNDO.
     3069   DEFINE BUFFER buf_prop-script FOR ub.prop-script.
     3070   DEFINE BUFFER buf_tt-loc-rule-i-script FOR tt-loc-rule-i-script.
     3071   do
     3072   on error undo, return error
     3073   :
     3074     IF p-i-script-type = 'variable':U
     3075     and not p-subsid
     3076     THEN DO:
     3077         find first buf_tt-loc-rule-i-script where
     3078                   buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3079               and buf_tt-loc-rule-i-script.script-name = p-script-name no-error.
     3080           if not available buf_tt-loc-rule-i-script then do:
     3081             if lookup(p-script-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) = 0 then do:
     3082               find first buf_prop-script no-lock where
     3083                       buf_prop-script.language = 'ABL'
     3084                   and buf_prop-script.script-name = p-script-type
     3085                   and buf_prop-script.dtm-code = p-dtm-code
     3086                   and buf_prop-script.proc-type = 'class':U no-error.
     3087               if not available buf_prop-script then do:
     3088                 message
     3089                 substitute("Не найден класс типа &1", p-script-type)
     3090                 view-as alert-box error .
     3091                 undo, return error .
     3092               end.
     3093             end.
     3094             create buf_tt-loc-rule-i-script.
     3095             assign
     3096             buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3097             buf_tt-loc-rule-i-script.i-script-type = p-i-script-type
     3098             buf_tt-loc-rule-i-script.i-script-name = p-I-script-name
     3099             buf_tt-loc-rule-i-script.script-type = p-script-type
     3100             buf_tt-loc-rule-i-script.script-name = p-script-name
     3101             buf_tt-loc-rule-i-script.dtm-code = (if available buf_prop-script
     3102                                                  then buf_prop-script.dtm-code
     3103                                                  else 0)
     3104             buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3105             buf_tt-loc-rule-i-script.revis_id = (if available buf_prop-script
     3106                                                  then buf_prop-script.revis_id
     3107                                                  else 0)
     3108             buf_tt-loc-rule-i-script.script_id = p-script-id
     3109             .
     3110           end.
     3111     END.
     3112     ELSE DO:
     3113       if p-subsid = no then do:
     3114         find first buf_prop-script no-lock where
     3115                   buf_prop-script.dtm-code = p-dtm-code
     3116               and buf_prop-script.class-dtm-code = p-class-dtm-code
     3117               and buf_prop-script.language = 'ABL'
     3118               and buf_prop-script.script-name = p-script-name no-error.
     3119         if not available buf_prop-script then do:
     3120           message
     3121           "not available buf_prop-script"
     3122           p-script-name p-dtm-code  ("l" + p-script-type + "@") p-i-script-type
     3123           view-as alert-box .
     3124           UNDO, RETURN ERROR.
     3125         end.
     3126         find first buf_tt-loc-rule-i-script where
     3127                 buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3128             and buf_tt-loc-rule-i-script.i-script-name = p-i-script-name
     3129             AND buf_tt-loc-rule-i-script.script_id = p-script-id no-error.
     3130         if not available buf_tt-loc-rule-i-script then do:
     3131           create buf_tt-loc-rule-i-script.
     3132           assign
     3133           buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3134           buf_tt-loc-rule-i-script.i-script-type = p-i-script-type
     3135           buf_tt-loc-rule-i-script.i-script-name = p-i-script-name
     3136           buf_tt-loc-rule-i-script.script-type = p-script-type
     3137           buf_tt-loc-rule-i-script.script-name = p-script-name
     3138           buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3139           buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3140           buf_tt-loc-rule-i-script.revis_id = buf_prop-script.revis_id
     3141           buf_tt-loc-rule-i-script.script_id = p-script-id
     3142           .
     3143         end.
     3144         v-sub-object = entry(1, p-script-name, '@').
     3145         if p-dtm-code > 0
     3146         AND lookup(buf_prop-script.proc-type, 'class,data-member,property,method,constructor,destructor':u) = 0  then do:
     3147           if buf_prop-script.script-type = 'create':U
     3148           or buf_prop-script.script-type = 'find':U
     3149           or buf_prop-script.script-type = 'get':U
     3150           or buf_prop-script.script-type = 'set':U
     3151           then do:
     3152             assign
     3153             v-sub-object   = substring(v-sub-object, index(v-sub-object,'_':U) + 1)
     3154             .
     3155             find first buf_tt-loc-rule-i-script where
     3156                       buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3157                   and buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3158                   and buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3159                   and buf_tt-loc-rule-i-script.i-script-type = 'define_b':U
     3160                   and buf_tt-loc-rule-i-script.script-name = ('buf_':U + v-sub-object )
     3161                   AND buf_tt-loc-rule-i-script.script_id = p-script-id no-error.
     3162             if not available buf_tt-loc-rule-i-script then do:
     3163               create buf_tt-loc-rule-i-script.
     3164               assign
     3165               buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3166               buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3167               buf_tt-loc-rule-i-script.dtm-code = p-class-dtm-code
     3168               buf_tt-loc-rule-i-script.i-script-type = 'define_b':U
     3169               buf_tt-loc-rule-i-script.i-script-name = 'buf_':U + v-sub-object
     3170               buf_tt-loc-rule-i-script.script-type = 'define_b':U
     3171               buf_tt-loc-rule-i-script.script-name = 'buf_':U + v-sub-object
     3172               buf_tt-loc-rule-i-script.revis_id = buf_prop-script.revis_id
     3173               buf_tt-loc-rule-i-script.script_id = p-script-id
     3174               .
     3175               create buf_tt-loc-rule-i-script.
     3176               assign
     3177               buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3178               buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3179               buf_tt-loc-rule-i-script.dtm-code = p-class-dtm-code
     3180               buf_tt-loc-rule-i-script.i-script-type = 'define_tt':U
     3181               buf_tt-loc-rule-i-script.i-script-name = 'buft_':U + v-sub-object
     3182               buf_tt-loc-rule-i-script.script-type = 'define_tt':U
     3183               buf_tt-loc-rule-i-script.script-name = 'buft_':U + v-sub-object
     3184               buf_tt-loc-rule-i-script.script_id = p-script-id
     3185               .
     3186             end.
     3187             find first buf_tt-loc-rule-i-script where
     3188                       buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3189                   and buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3190                   and buf_tt-loc-rule-i-script.dtm-code = p-class-dtm-code
     3191                   and buf_tt-loc-rule-i-script.i-script-type = 'define_h'
     3192                   and buf_tt-loc-rule-i-script.script-name = ('vh_':U + v-sub-object)
     3193                   AND buf_tt-loc-rule-i-script.script_id = p-script-id no-error.
     3194             if not available buf_tt-loc-rule-i-script then do:
     3195               create buf_tt-loc-rule-i-script.
     3196               assign
     3197               buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3198               buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3199               buf_tt-loc-rule-i-script.dtm-code = p-class-dtm-code
     3200               buf_tt-loc-rule-i-script.i-script-type = 'define_h':U
     3201               buf_tt-loc-rule-i-script.i-script-name = 'vh_':U + v-sub-object
     3202               buf_tt-loc-rule-i-script.script-type = 'define_h':U
     3203               buf_tt-loc-rule-i-script.script-name = 'vh_':U + v-sub-object
     3204               buf_tt-loc-rule-i-script.revis_id = buf_prop-script.revis_id
     3205               buf_tt-loc-rule-i-script.script_id = p-script-id
     3206               .
     3207             end.
     3208           end.
     3209           v-sub-object = entry(1, p-script-name, '@').
     3210           if buf_prop-script.script-type = 'create':U
     3211           or buf_prop-script.script-type = 'set':U
     3212           then do:
     3213             assign
     3214             v-sub-object   = substring(v-sub-object, index(v-sub-object,'_':U) + 1)
     3215             .
     3216             find first buf_tt-loc-rule-i-script where
     3217                       buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3218                   and buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3219                   and buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3220                   and buf_tt-loc-rule-i-script.i-script-type = 'hist-nws'
     3221                   and buf_tt-loc-rule-i-script.script-name = ('hist-nws_':U + v-sub-object)
     3222                   AND buf_tt-loc-rule-i-script.script_id = p-script-id no-error.
     3223             if not available buf_tt-loc-rule-i-script then do:
     3224               create buf_tt-loc-rule-i-script.
     3225               assign
     3226               buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3227               buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3228               buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3229               buf_tt-loc-rule-i-script.i-script-type = 'hist-nws'
     3230               buf_tt-loc-rule-i-script.i-script-name = 'hist-nws_':U + v-sub-object
     3231               buf_tt-loc-rule-i-script.script-type = 'hist-nws'
     3232               buf_tt-loc-rule-i-script.script-name = 'hist-nws_':U + v-sub-object
     3233               buf_tt-loc-rule-i-script.revis_id = buf_prop-script.revis_id
     3234               buf_tt-loc-rule-i-script.script_id = p-script-id
     3235               .
     3236             end.
     3237           end.
     3238         end.
     3239       end.
     3240       else do:
     3241         define variable v-tbl-row as rowid no-undo .
     3242         define variable v-tbl-name as character no-undo .
     3243         run gen-row-keyr in this-procedure
     3244           ( input  p-i-script-name
     3245            ,input ?
     3246            ,input "ub"
     3247            ,input ?
     3248            ,input no-lock
     3249            ,output v-tbl-row
     3250            ,output v-tbl-name
     3251           ).
     3252         find first buf_prop-script where
     3253                 rowid(buf_prop-script) = v-tbl-row.
     3254         find first buf_tt-loc-rule-i-script where
     3255                 buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3256             and buf_tt-loc-rule-i-script.i-script-name = buf_prop-script.script-foot
     3257             AND buf_tt-loc-rule-i-script.script_id = p-script-id no-error.
     3258         if not available buf_tt-loc-rule-i-script then do:
     3259           create buf_tt-loc-rule-i-script.
     3260           assign
     3261           buf_tt-loc-rule-i-script.root_rule_id = p-root-rule-id
     3262           buf_tt-loc-rule-i-script.i-script-type = 'ifunction':U
     3263           buf_tt-loc-rule-i-script.i-script-name = buf_prop-script.script-foot
     3264           buf_tt-loc-rule-i-script.script-type = '':U
     3265           buf_tt-loc-rule-i-script.script-name = replace(buf_prop-script.script-foot
     3266                                                        , "&" + substitute("&1", p-script-type)
     3267                                                        , p-script-name)
     3268           buf_tt-loc-rule-i-script.dtm-code = p-dtm-code
     3269           buf_tt-loc-rule-i-script.class-dtm-code = p-class-dtm-code
     3270           buf_tt-loc-rule-i-script.revis_id = buf_prop-script.revis_id
     3271           buf_tt-loc-rule-i-script.script_id = p-script-id
     3272           .
     3273         end.
     3274         else do:
     3275           assign
     3276           buf_tt-loc-rule-i-script.script-type = '':U
     3277           buf_tt-loc-rule-i-script.script-name = replace(buf_tt-loc-rule-i-script.script-name
     3278                                                        , "&" + substitute("&1", p-script-type)
     3279                                                        , p-script-name)
     3280           .
     3281         end.
     3282       end.
     3283     END.
     3284   end.
     3285   END PROCEDURE.
     3286   PROCEDURE create-tt-complex :
     3287   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     3288   DEFINE PARAMETER BUFFER buf_tt-complex FOR tt-complex.
     3289   DEFINE VARIABLE v-object-type AS CHARACTER NO-UNDO.
     3290   DEFINE BUFFER buf_prop-script FOR ub.prop-script.
     3291   IF LOOKUP(buf_tt-complex.proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0  THEN DO:
     3292     FIND FIRST buf_prop-script NO-LOCK WHERE
     3293               buf_prop-script.dtm-code = buf_tt-complex.class-dtm-code
     3294         AND   buf_prop-script.script-name = buf_tt-complex.script-name.
     3295   END.
     3296   ELSE DO:
     3297     v-object-type = buf_tt-complex.script-value-type.
     3298   END.
     3299   RUN create-widget IN THIS-PROCEDURE ( INPUT buf_tt-complex.dtm-code
     3300                                        ,INPUT buf_tt-complex.class-dtm-code
     3301                                        ,INPUT p-language
     3302                                        ,INPUT buf_tt-complex.script-name
     3303                                        ,INPUT buf_tt-complex.script-al
     3304                                        ,INPUT buf_tt-complex.script-nl
     3305                                        ,INPUT buf_tt-complex.entry-type
     3306                                        ,INPUT buf_tt-complex.script-type
     3307                                        ,INPUT buf_tt-complex.script-value-type
     3308                                        ,INPUT v-object-type
     3309                                        ,input buf_tt-complex.proc-type
     3310                                        ,input '':U
     3311                                        ).
     3312   END PROCEDURE.
     3313   PROCEDURE create-variable :
     3314   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     3315   DEFINE parameter BUFFER buf_tt-loc-rule-i-script FOR tt-rule-i-script.
     3316   RUN create-widget IN THIS-PROCEDURE ( INPUT buf_tt-loc-rule-i-script.dtm-code
     3317                                        ,INPUT buf_tt-loc-rule-i-script.class-dtm-code
     3318                                        ,INPUT p-language
     3319                                        ,INPUT buf_tt-loc-rule-i-script.i-script-name
     3320                                        ,INPUT buf_tt-loc-rule-i-script.script-name
     3321                                        ,INPUT buf_tt-loc-rule-i-script.script-name
     3322                                        ,INPUT '':U
     3323                                        ,INPUT 'variable':U
     3324                                        ,INPUT buf_tt-loc-rule-i-script.script-type
     3325                                        ,INPUT buf_tt-loc-rule-i-script.script-type
     3326                                        ,input '':U
     3327                                        ,input '':U
     3328                                        ).
     3329   END PROCEDURE.
     3330   PROCEDURE create-widget :
     3331   DEFINE INPUT PARAMETER p-dtm-code AS integer NO-UNDO.
     3332   DEFINE INPUT PARAMETER p-class-dtm-code AS integer NO-UNDO.
     3333   DEFINE INPUT PARAMETER p-language AS CHARACTER NO-UNDO.
     3334   DEFINE INPUT PARAMETER p-script-name AS CHARACTER NO-UNDO.
     3335   DEFINE INPUT PARAMETER p-script-al AS CHARACTER NO-UNDO.
     3336   DEFINE INPUT PARAMETER p-script-nl AS CHARACTER NO-UNDO.
     3337   DEFINE INPUT PARAMETER p-entry-type AS CHARACTER NO-UNDO.
     3338   DEFINE INPUT PARAMETER p-script-type AS CHARACTER NO-UNDO.
     3339   DEFINE INPUT PARAMETER p-script-value-type AS CHARACTER NO-UNDO.
     3340   DEFINE INPUT PARAMETER p-DATA-type AS CHARACTER NO-UNDO.
     3341   define input parameter p-proc-type as character no-undo .
     3342   define input parameter p-uniq-key-rec as character no-undo .
     3343   DEFINE VARIABLE v-len AS INTEGER NO-UNDO.
     3344   DEFINE VARIABLE v-color AS INTEGER NO-UNDO.
     3345   DEFINE VARIABLE v-widget-num AS INTEGER NO-UNDO.
     3346   DEFINE VARIABLE v-ano-script-name AS CHARACTER NO-UNDO.
     3347   DEFINE VARIABLE v-ano-script-type AS CHARACTER NO-UNDO.
     3348   DEFINE VARIABLE v-index-al AS INTEGER NO-UNDO.
     3349   DEFINE VARIABLE v-index-nl AS INTEGER NO-UNDO.
     3350   DEFINE VARIABLE v-in-script AS logical NO-UNDO.
     3351   DEFINE VARIABLE v-level AS INTEGER NO-UNDO.
     3352   define variable glog as logical no-undo .
     3353   define variable v-sub-number as integer no-undo .
     3354   define variable v-main-sub-number as integer no-undo .
     3355   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     3356   DEFINE BUFFER last_tt-widget FOR tt-widget.
     3357   DEFINE BUFFER buf_tt-widget-child FOR tt-widget-child.
     3358   RUN debug-proc( INPUT "kk.txt").
     3359   FOR EACH buf_tt-widget:
     3360     IF buf_tt-widget.HANDLE_:SELECTED = YES
     3361     and buf_tt-widget.script-type = 'variable':U
     3362     and lookup(p-proc-type, 'class,data-member,property,method,constructor,destructor':u) > 0
     3363     and (buf_tt-widget.data-type = p-data-type
     3364           or
     3365           buf_tt-widget.class-dtm-code = p-class-dtm-code)
     3366     then do:
     3367       message
     3368       substitute("Использовать объект &1 в скрипте?", buf_tt-widget.script-al)
     3369       view-as alert-box question buttons yes-no update glog.
     3370       if not glog then next.
     3371       entry(1, p-script-al, ':') = buf_tt-widget.script-al.
     3372       entry(1, p-script-nl, ':') = buf_tt-widget.script-nl.
     3373       RUN proc-delete IN THIS-PROCEDURE ( BUFFER buf_tt-widget).
     3374       leave.
     3375     end.
     3376   END.
     3377   FOR EACH buf_tt-widget:
     3378     IF buf_tt-widget.HANDLE_:SELECTED = YES
     3379     AND real-index(buf_tt-widget.script-al, "&", 1, output v-sub-number) > 0  THEN DO:
     3380        v-index-al = real-index(buf_tt-widget.script-al, "&", 1, v-main-sub-number).
     3381        v-index-nl = real-index(buf_tt-widget.script-nl, "&", 1, v-sub-number).
     3382        FIND FIRST buf_tt-widget-child WHERE
     3383                   buf_tt-widget-child.num_ = buf_tt-widget.num_
     3384              AND  buf_tt-widget-child.position-al = v-index-al NO-ERROR.
     3385        IF NOT AVAILABLE buf_tt-widget-child THEN UNDO, RETURN ERROR.
     3386        IF right-trim(buf_tt-widget-child.param-data-type, chr(44)) <> trim(p-data-type, chr(44))
     3387        AND right-trim(buf_tt-widget-child.param-data-type, chr(44)) <> trim(entry(1, p-data-type, chr(44)))
     3388        and not (p-data-type = "-" and buf_tt-widget-child.param-data-type = 'void':U)
     3389        THEN DO:
     3390           MESSAGE
     3391           substitute("Вставляемый скрипт &1 имеет тип данных <&2>&3" +
     3392                      "А параметр &4 - имеет тип данных <&5>&3" +
     3393                      "Продолжить?"
     3394                      ,p-script-al
     3395                      ,p-data-type
     3396                      ,chr(10)
     3397                      ,buf_tt-widget-child.param-name
     3398                      ,buf_tt-widget-child.param-data-type)
     3399           VIEW-AS ALERT-BOX question buttons yes-no update glog.
     3400           if not glog then next.
     3401        END.
     3402        v-level = buf_tt-widget-child.level_ + 1.
     3403        v-widget-num = buf_tt-widget.num_.
     3404        ASSIGN
     3405        buf_tt-widget-child.script-al = p-script-al
     3406        buf_tt-widget-child.script-nl = p-script-nl
     3407        buf_tt-widget.script-al = substring(buf_tt-widget.script-al, 1, v-index-al - 1) +
     3408                                  p-script-al +
     3409                                  substring(buf_tt-widget.script-al, v-index-al + 2)
     3410        buf_tt-widget.script-nl = substring(buf_tt-widget.script-nl, 1, v-index-nl - 1) +
     3411                                  p-script-nl +
     3412                                     substring(buf_tt-widget.script-nl, v-index-nl + 2).
     3413       FOR EACH buf_tt-widget-child WHERE
     3414               buf_tt-widget-child.num_ = buf_tt-widget.num_:
     3415          ASSIGN
     3416          buf_tt-widget-child.position-al = (IF buf_tt-widget-child.position-al > v-index-al
     3417                                             THEN buf_tt-widget-child.position-al + LENGTH(p-script-al) - 2
     3418                                             ELSE   buf_tt-widget-child.position-al)
     3419          buf_tt-widget-child.position-nl = (IF buf_tt-widget-child.position-nl > v-index-nl
     3420                                             THEN buf_tt-widget-child.position-nl + LENGTH(p-script-nl) - 2
     3421                                             ELSE   buf_tt-widget-child.position-nl)
     3422          .
     3423       END.
     3424       run create-widget-child in this-procedure ( buffer buf_tt-widget
     3425                                                 ,INPUT v-level
     3426                                                 ,INPUT v-index-al
     3427                                                 ,INPUT v-index-nl
     3428                                                 ,INPUT p-entry-type
     3429                                                 ,INPUT p-script-al
     3430                                                 ,input p-script-type
     3431                                                 ,output v-sub-number
     3432                                                 ).
     3433       if buf_tt-widget.script-type = 'get-ifunction':U
     3434       and v-main-sub-number > 0 then do:
     3435         RUN CREATE-rule-i-script IN THIS-PROCEDURE  ( INPUT buf_tt-widget.dtm-code
     3436                                                     ,input buf_tt-widget.class-dtm-code
     3437                                                     ,INPUT buf_tt-widget.uniq-key-rec
     3438                                                     ,INPUT p-script-type
     3439                                                     ,INPUT p-script-al
     3440                                                     ,INPUT string(v-main-sub-number)
     3441                                                     ,input yes  ) NO-ERROR.
     3442         IF error-status:error tHEN DO:
     3443           UNDO, return ERROR.
     3444         END.
     3445       end.
     3446       ASSIGN
     3447       v-in-script = YES.
     3448       leave.
     3449     END.
     3450   END.
     3451   IF v-in-script = NO  THEN DO:
     3452     CASE p-entry-type:
     3453       WHEN 'prop-script':U THEN DO:
     3454         v-len = 45.
     3455         v-color = BLUE_COLOR.
     3456       END.
     3457       WHEN 'operator':U THEN DO:
     3458         v-len = 5.
     3459         v-color = BROWN_COLOR.
     3460       END.
     3461       WHEN 'constant':U THEN DO:
     3462           v-len = 5.
     3463           v-color = BROWN_COLOR.
     3464       END.
     3465       WHEN 'datatype':U THEN DO:
     3466         v-len = 40.
     3467         v-color = DARK_GREEn_COLOR.
     3468       END.
     3469       WHEN '-':U THEN DO:
     3470           v-len = 60.
     3471           v-color = BLACK_COLOR.
     3472       END.
     3473       WHEN '':U THEN DO:
     3474         ASSIGN
     3475         v-len = length(p-script-al)
     3476         v-color = BLACK_COLOR
     3477         .
     3478       END.
     3479     END CASE.
     3480     FIND LAST buf_tt-widget NO-ERROR.
     3481     V-WIDGET-NUM = (IF AVAILABLE BUF_TT-widget
     3482                       THEN BUF_TT-WIDGET.NUM_
     3483                       ELSE 0) + 1.
     3484     FIND LAST LAST_tt-widget USE-INDEX irc NO-ERROR.
     3485     IF AVAILABLE LAST_tt-widget THEN DO:
     3486       ASSIGN
     3487       v-current-row = get-current-row(last_tt-widget.right-bottom)
     3488       v-current-column = get-current-column(last_tt-widget.right-bottom)
     3489       .
     3490     END.
     3491     else do:
     3492       ASSIGN
     3493       v-current-row = 18
     3494       v-current-column = 1
     3495       .
     3496     end.
     3497     IF MINIMUM(length(p-script-nl), v-len) + v-current-column + 1 > 98 THEN DO:
     3498       ASSIGN
     3499       v-current-row = v-current-row + 1
     3500       v-current-column = 1
     3501       .
     3502     END.
     3503     CREATE buf_tt-widget.
     3504     assign
     3505     buf_tt-widget.num_ = v-widget-num
     3506     buf_tt-widget.NAME_ = "n" + STRING(buf_tt-widget.num_)
     3507     buf_tt-widget.entry-type = p-entry-type
     3508     buf_tt-widget.script-type = p-script-type
     3509     buf_tt-widget.script-value-type = p-script-value-type
     3510     buf_tt-widget.data-type = p-data-type
     3511     buf_tt-widget.script-nl = p-script-nl
     3512     buf_tt-widget.script-al = p-script-al
     3513     buf_tt-widget.ROW_ = v-current-row
     3514     buf_tt-widget.column_ = v-current-column
     3515     buf_tt-widget.WIDTH_ = MINIMUM(length(buf_tt-widget.script-nl), v-len)
     3516     buf_tt-widget.WIDTH_ = (IF buf_tt-widget.width_ < 5
     3517                             THEN 5
     3518                             ELSE buf_tt-widget.WIDTH_)
     3519     buf_tt-widget.dtm-code = p-dtm-code
     3520     buf_tt-widget.class-dtm-code = p-class-dtm-code
     3521     buf_tt-widget.uniq-key-rec = p-uniq-key-rec
     3522     .
     3523     if real-index(buf_tt-widget.script-nl, "&", 1, v-sub-number) > 0 then do:
     3524        run create-widget-child in this-procedure ( buffer buf_tt-widget
     3525                                                   ,INPUT 1
     3526                                                   ,INPUT 0
     3527                                                   ,INPUT 0
     3528                                                   ,INPUT p-entry-type
     3529                                                   ,INPUT p-script-name
     3530                                                   ,input p-script-type
     3531                                                   ,output v-sub-number
     3532                                                   ) NO-ERROR.
     3533     end.
     3534   end.
     3535   else do:
     3536   end.
     3537   FIND FIRST buf_tt-widget WHERE
     3538           buf_tt-widget.num_ = v-widget-num.
     3539   IF VALID-HANDLE(buf_tt-widget.HANDLE) THEN
     3540   assign
     3541   buf_tt-widget.handle_:SCREEN-VALUE = (IF p-language = "ABL"
     3542                                           THEN buf_tt-widget.script-al
     3543                                           ELSE buf_tt-widget.script-nl)
     3544     .
     3545   RUN debug-proc( INPUT "jj.txt").
     3546   ASSIGN
     3547   buf_tt-widget.length_ = maximum(LENGTH(buf_tt-widget.script-nl), LENGTH(buf_tt-widget.script-al))
     3548   buf_tt-widget.right-bottom = get-right-bottom(buf_tt-widget.ROW_
     3549                                                ,buf_tt-widget.width_
     3550                                                ,buf_tt-widget.COLUMN_
     3551                                                ,buf_tt-widget.HEIGHT_)
     3552   buf_tt-widget.left-top = get-left-top(buf_tt-widget.ROW_
     3553                                                ,buf_tt-widget.width_
     3554                                                ,buf_tt-widget.COLUMN_
     3555                                                ,buf_tt-widget.HEIGHT_)
     3556   v-current-row = get-current-row(buf_tt-widget.right-bottom)
     3557   v-current-column = get-current-column(buf_tt-widget.right-bottom)
     3558   .
     3559   if not v-in-script then do:
     3560     create EDITOR buf_tt-widget.HANDLE_
     3561     assign
     3562     frame = frame Dialog-Frame:handle
     3563     row = buf_tt-widget.ROW_
     3564     column = buf_tt-widget.COLUMN_
     3565     NAME = buf_tt-widget.NAME_
     3566     scrollbar-vertical = yes
     3567     height-chars = 1
     3568     width-chars = buf_tt-widget.width_
     3569     sensitive = yes
     3570     visible = true
     3571     movable = true
     3572     READ-ONLY = YES
     3573     RESIZABLE = YES
     3574     selectable = YES
     3575     FGCOLOR = v-color
     3576     SCREEN-VALUE = (IF p-language = "ABL"
     3577                     THEN buf_tt-widget.script-al
     3578                     ELSE buf_tt-widget.script-nl)
     3579     FONT = 4
     3580     triggers:
     3581       on END-RESIZE
     3582         persistent run do-not-resize .
     3583       on END-MOVE
     3584         persistent run proc-end-move .
     3585     end triggers.
     3586   END.
     3587   IF lookup(p-entry-type, 'constant':U + chr(44) +
     3588                           'operator':U + chr(44) +
     3589                           'control':U + chr(44) +
     3590                           'parameter':U + chr(44) +
     3591                           "-" + chr(44) +
     3592                           "":U) = 0 THEN DO:
     3593       ASSIGN
     3594       v-ano-script-name = p-script-name
     3595       v-ano-script-type = p-DATA-type
     3596       .
     3597       RUN CREATE-rule-i-script IN THIS-PROCEDURE  ( INPUT p-dtm-code
     3598                                                    ,input p-class-dtm-code
     3599                                                    ,INPUT p-script-al
     3600                                                    ,INPUT p-script-type
     3601                                                    ,INPUT v-ano-script-name
     3602                                                    ,INPUT v-ano-script-type
     3603                                                    ,input no
     3604                                                    ) NO-ERROR.
     3605       IF error-status:error tHEN DO:
     3606          UNDO, return ERROR.
     3607       END.
     3608   END.
     3609   END PROCEDURE.
     3610   PROCEDURE create-widget-child :
     3611   DEFINE PARAMETER BUFFER buf_tt-widget FOR tt-widget.
     3612   DEFINE INPUT PARAMETER p-level AS INTEGER NO-UNDO.
     3613   DEFINE INPUT PARAMETER p-position-al AS INTEGER NO-UNDO.
     3614   DEFINE INPUT PARAMETER p-position-nl AS INTEGER NO-UNDO.
     3615   DEFINE INPUT PARAMETER p-entry-type AS character NO-UNDO.
     3616   DEFINE INPUT PARAMETER p-script-name AS character NO-UNDO.
     3617   define input parameter p-script-type as character no-undo .
     3618   define output parameter p-sub-number as integer no-undo .
     3619   DEFINE BUFFER buf_tt-widget-child FOR tt-widget-child.
     3620   DEFINE BUFFER buf_ruledict FOR ub.ruledict.
     3621   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3622   IF p-entry-type = '-'
     3623   OR p-entry-type = 'parameter':U
     3624   OR p-entry-TYPE = '':U THEN RETURN.
     3625   FIND FIRST buf_ruledict NO-LOCK WHERE
     3626             buf_Ruledict.entry-type = p-entry-type
     3627          AND buf_ruledict.script-al = p-script-name NO-ERROR.
     3628   IF not available buf_Ruledict THEN DO:
     3629      UNDO, RETURN ERROR.
     3630   END.
     3631   FOR EACH buf_tt-widget-child WHERE
     3632          buf_tt-widget-child.num_ = buf_tt-widget.num_
     3633       AND buf_tt-widget-child.level_= p-level:
     3634     DELETE buf_tt-widget-child.
     3635   END.
     3636   FOR EACH buf_ruledict-param NO-LOCK WHERE
     3637           buf_ruledict-param.entry-id = buf_ruledict.entry-id
     3638       and buf_ruledict-param.param-num > 0:
     3639     CREATE buf_tt-widget-child.
     3640     ASSIGN
     3641     buf_tt-widget-child.num_ = buf_tt-widget.num_
     3642     buf_tt-widget-child.level_ = p-level
     3643     buf_tt-widget-child.param-data-type = buf_ruledict-param.param-data-type
     3644     buf_tt-widget-child.param-2-data-type = buf_ruledict-param.param-2-data-type
     3645     buf_tt-widget-child.param-3-data-type = buf_ruledict-param.param-3-data-type
     3646     buf_tt-widget-child.param-label = buf_ruledict-param.param-label
     3647     buf_tt-widget-child.param-mode = buf_ruledict-param.param-mode
     3648     buf_tt-widget-child.param-name = buf_ruledict-param.param-name
     3649     buf_tt-widget-child.param-num = buf_ruledict-param.param-num
     3650     buf_tt-widget-child.script-nl = '':U
     3651     buf_tt-widget-child.script-al = '':U
     3652     buf_tt-widget-child.entry-id = buf_ruledict-param.entry-id
     3653     buf_tt-widget.script-al-fix = buf_ruledict.script-al
     3654     .
     3655     define variable v-al as integer no-undo .
     3656     define variable v-nl as integer no-undo .
     3657     define variable v-sub-number-al as integer no-undo .
     3658     define variable v-sub-number-nl as integer no-undo .
     3659     ASSIGN
     3660     v-al = real-INDEX(buf_tt-widget.script-al, ("&" + STRING(buf_tt-widget-child.param-num)), 1, output v-sub-number-al)
     3661                                                                           + (IF p-level = 1 THEN 0 ELSE (p-position-al - 1))
     3662     v-nl = real-INDEX(buf_ruledict.script-nl, ("&" + STRING(buf_tt-widget-child.param-num)), 1, output v-sub-number-nl)
     3663                                                                          + (IF p-level = 1 THEN 0 ELSE (p-position-nl - 1))
     3664     .
     3665     if v-sub-number-al > 0
     3666     and p-script-type = 'get-ifunction':U
     3667     then do:
     3668       p-sub-number = v-sub-number-al.
     3669     end.
     3670     assign
     3671     buf_tt-widget-child.position-al = v-al
     3672     buf_tt-widget-child.position-nl = v-nl
     3673     .
     3674   END.
     3675   END PROCEDURE.
     3676   PROCEDURE debug-proc :
     3677   DEFINE INPUT PARAMETER p-file-name AS CHARACTER NO-UNDO.
     3678   DEFINE BUFFER buf_tt-widget FOR tt-widget.
     3679   DEFINE BUFFER buf_tt-widget-child FOR tt-widget-child.
     3680   OUTPUT TO VALUE(p-file-name).
     3681   FOR EACH buf_tt-widget-child:
     3682       EXPORT buf_tt-widget-child.
     3683   END.
     3684   FOR EACH buf_tt-widget:
     3685       EXPORT buf_tt-widget EXCEPT HANDLE_.
     3686   END.
     3687   OUTPUT close.
     3688   END PROCEDURE.
     3689   PROCEDURE disable_UI :
     3690     HIDE FRAME Dialog-Frame.
     3691   END PROCEDURE.
     3692   PROCEDURE do-not-resize :
     3693   DEFINE BUFFER buf_tt-widget for tt-widget.
     3694   FIND FIRST buf_tt-widget NO-LOCK WHERE
     3695             buf_tt-widget.HANDLE_ = SELF.
     3696   ASSIGN
     3697   SELF:HEIGHT = 1.5
     3698   SELF:WIDTH = MINIMUM(length(SELF:SCREEN-VALUE), 45)
     3699   buf_tt-widget.WIDTH_ = SELF:WIDTH
     3700   .
     3701   END PROCEDURE.
     3702   PROCEDURE enable_UI :
     3703     DISPLAY RS-language cb-pscript-ruleset f-prop-script F-operator f-variable
     3704             f-parameter f-complex f-defvariable
     3705         WITH FRAME Dialog-Frame.
     3706     ENABLE B-exit b-complex b-quit RS-language B-Help cb-pscript-ruleset
     3707            br-variable br-parameter br-operator br-dtruledict br-complex
     3708            br-pscript-ruleset b-defvariable B-operator b-parameter B-prop-script
     3709            b-variable f-prop-script F-operator f-variable f-parameter f-complex
     3710            f-defvariable
     3711         WITH FRAME Dialog-Frame.
     3712     VIEW FRAME Dialog-Frame.
     3713     OPEN QUERY br-complex FOR EACH tt-complex.    OPEN QUERY br-dtruledict FOR EACH X_dtruledict NO-LOCK WHERE X_dtruledict.entry-type = 'datatype':U INDEXED-REPOSITION .    OPEN QUERY br-operator FOR EACH Y_ruledict NO-LOCK WHERE      (Y_ruledict.ENTRY-TYPE = 'operator':U       OR       Y_ruledict.ENTRY-TYPE = 'constant':U       OR       Y_ruledict.ENTRY-TYPE = 'datatype':U       OR       Y_ruledict.ENTRY-TYPE = 'control':U       ) .    OPEN QUERY br-parameter FOR EACH tt-ruledict-param.    OPEN QUERY br-pscript-ruleset FOR EACH X_prop-script NO-LOCK where        X_prop-script.dtm-code = integer(cb-pscript-ruleset),            FIRST X_pscript-ruleset NO-LOCK WHERE      X_pscript-ruleset.codex_id = p-codex-id     AND X_pscript-ruleset.dtm-code = integer(cb-pscript-ruleset)     AND  X_prop-script.language = X_pscript-ruleset.LANGUAGE     AND  X_prop-script.script-name = X_pscript-ruleset.script-name     AND  X_prop-script.revis_id = X_pscript-ruleset.revis_id,            FIRST X_ruledict NO-LOCK WHERE      X_ruledict.ENTRY-TYPE = 'prop-script':U AND  X_ruledict.uniq-key-rec = X_prop-script.uniq-key-rec.    OPEN QUERY br-variable FOR EACH bufv_tt-rule-i-script NO-LOCK WHERE bufv_tt-rule-i-script.root_rule_id = p-root-rule-id  AND bufv_tt-rule-i-script.i-script-type = 'variable':U INDEXED-REPOSITION.
     3714   END PROCEDURE.
     3715   PROCEDURE fill-tables :
     3716   DEFINE BUFFER buf_tt-loc-rule-i-script FOR tt-loc-rule-i-script.
     3717   DEFINE BUFFER buf_tt-rule-i-script FOR tt-rule-i-script.
     3718     FOR EACH buf_tt-loc-rule-i-script:
     3719       delete buf_tt-loc-rule-i-script.
     3720     END.
     3721     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3722       FOR EACH buf_tt-rule-i-script NO-LOCK WHERE
     3723                 buf_tt-rule-i-script.root_rule_id = p-rule-id
     3724            AND  buf_tt-rule-i-script.script_id = p-script-id:
     3725           CREATE buf_tt-loc-rule-i-script.
     3726           BUFFER-COPY buf_tt-rule-i-script TO buf_tt-loc-rule-i-script.
     3727       END.
     3728       FIND FIRST tt-rule-script WHERE
     3729              tt-rule-script.script_id = p-script-id
     3730           and tt-rule-script.language = "ABL".
     3731       FIND FIRST tt-l_rule-script WHERE
     3732              tt-l_rule-script.script_id = p-script-id
     3733              and tt-l_rule-script.language = "rus" .
     3734       FIND FIRST tt-rule WHERE
     3735                 tt-rule.RULE_id = p-rule-id.
     3736     end.
     3737     else do:
     3738       FIND FIRST tt-rule WHERE
     3739                     tt-rule.RULE_id = p-rule-id.
     3740       CREATE tt-rule-script.
     3741        ASSIGN
     3742        tt-rule-script.script_id = 0
     3743        tt-rule-script.RULE_id = p-rule-id
     3744        tt-rule-script.root_RULE_id = p-root-rule-id
     3745        tt-rule-script.salience = p-salience
     3746        tt-rule-script.script-type = p-script-type
     3747        tt-rule-script.LANGUAGE = "ABL".
     3748        RELEASE tt-rule-script.
     3749        FIND FIRST tt-rule-script WHERE
     3750                 tt-rule-script.script_id = 0
     3751             AND tt-rule-script.LANGUAGE = "ABL".
     3752        CREATE tt-l_rule-script.
     3753        ASSIGN
     3754        tt-l_rule-script.script_id = 0
     3755        tt-l_rule-script.RULE_id = p-rule-id
     3756        tt-l_rule-script.root_RULE_id = p-root-rule-id
     3757        tt-l_rule-script.salience = p-salience
     3758        tt-l_rule-script.script-type = p-script-type
     3759        tt-l_rule-script.LANGUAGE = "rus".
     3760        RELEASE tt-l_rule-script.
     3761        FIND FIRST tt-l_rule-script WHERE
     3762                 tt-l_rule-script.script_id = 0
     3763            AND tt-l_rule-script.LANGUAGE = "rus".
     3764     end.
     3765   END PROCEDURE.
     3766   PROCEDURE MyEnable :
     3767   DEFINE VARIABLE v-dtm-label AS CHARACTER no-undo.
     3768   DEFINE BUFFER buf_prop-ruleset FOR ub.prop-ruleset.
     3769   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     3770   assign
     3771   cb-pscript-ruleset:DELIMITER in FRAME Dialog-Frame = "|"
     3772   cb-pscript-ruleset:list-item-pairs = "|":U
     3773   .
     3774   _prop-ruleset:
     3775   FOR EACH buf_prop-ruleset NO-LOCK WHERE
     3776           buf_prop-ruleset.codex_id = p-codex-id
     3777   BREAK BY buf_prop-ruleset.dtm-code:
     3778      IF first-of(buf_prop-ruleset.dtm-CODE) THEN DO:
     3779        FIND FIRST buf_prop-head NO-LOCK WHERE
     3780                   buf_prop-head.dtm-code = buf_prop-ruleset.dtm-code NO-ERROR.
     3781        IF NOT AVAILABLE buf_prop-head THEN DO:
     3782           NEXT _prop-ruleset.
     3783        END.
     3784        v-dtm-label = replace(buf_prop-head.prop-label, "|", chr(32)).
     3785        cb-pscript-ruleset:ADD-LAST(v-dtm-label, string(buf_prop-ruleset.dtm-code)) IN FRAME Dialog-Frame.
     3786      END.
     3787   END.
     3788   ASSIGN
     3789   cb-pscript-ruleset = "0"
     3790   rs-language:radio-buttons in frame Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     3791                                                      "rus" + chr(44) + "rus"
     3792   X_pscript-ruleset.script-name:RESIZABLE IN BROWSE br-pscript-ruleset =  yes
     3793   X_ruledict.script-nl:RESIZABLE IN BROWSE br-pscript-ruleset =  yes
     3794   Y_ruledict.script-al:RESIZABLE IN BROWSE br-operator =  yes
     3795   Y_ruledict.script-nl:RESIZABLE IN BROWSE br-operator =  yes
     3796   tt-complex.script-al:RESIZABLE IN BROWSE br-complex =  yes
     3797   tt-complex.script-nl:RESIZABLE IN BROWSE br-complex =  yes
     3798   FRAME Dialog-Frame:TITLE = SUBSTITUTE("Скрипт типа &1, номер вышестояшего правила &2, номер корневого правила &3"
     3799                                          , p-script-type
     3800                                          ,p-upper-rule-id
     3801                                          ,p-root-rule-id).
     3802   .
     3803   DISPLAY
     3804   RS-language
     3805   b-prop-script
     3806   b-operator
     3807   b-defvariable WHEn p-script-type <> 'COND':U
     3808   b-variable
     3809   b-parameter
     3810   b-complex
     3811   f-prop-script
     3812   f-operator
     3813   f-defvariable WHEn p-script-type <> 'COND':U
     3814   f-variable
     3815   f-parameter
     3816   f-complex
     3817   CB-PSCRIPT-RULESET
     3818   WITH FRAME Dialog-Frame.
     3819   ENABLE
     3820   B-exit
     3821   b-quit
     3822   RS-language
     3823   B-Help
     3824   cb-pscript-ruleset
     3825   br-operator
     3826   br-pscript-ruleset
     3827   b-prop-script
     3828   b-operator
     3829   b-variable
     3830   b-parameter
     3831   b-complex
     3832   b-defvariable WHEn p-script-type <> 'COND':U
     3833   br-dtruledict WHEn p-script-type <> 'COND':U
     3834   br-variable
     3835   br-parameter
     3836   br-complex
     3837   WITH FRAME Dialog-Frame.
     3838   APPLY "VALUE-CHANGED" TO rs-language.
     3839   APPLY "VALUE-CHANGED" TO cb-pscript-ruleset.
     3840   VIEW FRAME Dialog-Frame.
     3841   OPEN QUERY br-complex FOR EACH tt-complex.    OPEN QUERY br-dtruledict FOR EACH X_dtruledict NO-LOCK WHERE X_dtruledict.entry-type = 'datatype':U INDEXED-REPOSITION .    OPEN QUERY br-operator FOR EACH Y_ruledict NO-LOCK WHERE      (Y_ruledict.ENTRY-TYPE = 'operator':U       OR       Y_ruledict.ENTRY-TYPE = 'constant':U       OR       Y_ruledict.ENTRY-TYPE = 'datatype':U       OR       Y_ruledict.ENTRY-TYPE = 'control':U       ) .    OPEN QUERY br-parameter FOR EACH tt-ruledict-param.    OPEN QUERY br-pscript-ruleset FOR EACH X_prop-script NO-LOCK where        X_prop-script.dtm-code = integer(cb-pscript-ruleset),            FIRST X_pscript-ruleset NO-LOCK WHERE      X_pscript-ruleset.codex_id = p-codex-id     AND X_pscript-ruleset.dtm-code = integer(cb-pscript-ruleset)     AND  X_prop-script.language = X_pscript-ruleset.LANGUAGE     AND  X_prop-script.script-name = X_pscript-ruleset.script-name     AND  X_prop-script.revis_id = X_pscript-ruleset.revis_id,            FIRST X_ruledict NO-LOCK WHERE      X_ruledict.ENTRY-TYPE = 'prop-script':U AND  X_ruledict.uniq-key-rec = X_prop-script.uniq-key-rec.    OPEN QUERY br-variable FOR EACH bufv_tt-rule-i-script NO-LOCK WHERE bufv_tt-rule-i-script.root_rule_id = p-root-rule-id  AND bufv_tt-rule-i-script.i-script-type = 'variable':U INDEXED-REPOSITION.
     3842   APPLY "CHOOSE" TO b-prop-script.
     3843   IF p-script-type = 'COND':U THEN DO:
     3844     HIDE
     3845     br-dtruledict
     3846     f-defvariable
     3847     b-defvariable
     3848     IN FRAME Dialog-Frame.
     3849   END.
     3850   END PROCEDURE.
     3851   PROCEDURE proc-delete :
     3852   DEFINE PARAMETER BUFFER buf_tt-widget FOR tt-widget.
     3853   define buffer buf_tt-complex for tt-complex.
     3854   define buffer buf_tt-widget-child for tt-widget-child.
     3855   if buf_tt-widget.entry-type = '-' then do:
     3856     for each buf_tt-complex where buf_tt-complex.script-al = buf_tt-widget.script-al:
     3857       delete buf_tt-complex.
     3858     end.
     3859     OPEN QUERY br-complex FOR EACH tt-complex.
     3860   end.
     3861   FOR EACH buf_tt-widget-child WHERE
     3862           buf_tt-widget-child.num_ = buf_tt-widget.num_:
     3863     DELETE buf_tt-widget-child.
     3864   END.
     3865   DELETE WIDGET buf_tt-widget.HANDLE_.
     3866   DELETE buf_tt-widget.
     3867   END PROCEDURE.
     3868   PROCEDURE proc-end-move :
     3869   DEFINE BUFFER buf_tt-widget for tt-widget.
     3870   FIND FIRST buf_tt-widget NO-LOCK WHERE
     3871             buf_tt-widget.HANDLE_ = SELF.
     3872   ASSIGN
     3873   SELF:ROW = ROUND(SELF:ROW, 0)
     3874   SELF:column = ROUND(SELF:column, 0)
     3875   buf_tt-widget.row_ = SELF:ROW
     3876   buf_tt-widget.column_ = SELF:column.
     3877   buf_tt-widget.right-bottom = get-right-bottom ( INPUT buf_tt-widget.row_
     3878                                                 ,INPUT buf_tt-widget.width_
     3879                                                 ,INPUT buf_tt-widget.column_
     3880                                                 ,INPUT buf_tt-widget.height_).
     3881   END PROCEDURE.
     3882   PROCEDURE proc-init-b-complex :
     3883   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3884   DO on error undo, return error return-value:
     3885    b-complex:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     3886    f-complex:fgcolor = 1   .
     3887    b-prop-script:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3888    b-operator:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3889    b-defvariable:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3890    b-parameter:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3891    b-variable:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3892    ASSIGN
     3893    f-prop-script:fgcolor = ?
     3894    f-operator:fgcolor = ?
     3895    f-defvariable:fgcolor = ?
     3896    f-parameter:fgcolor = ?
     3897    f-variable:fgcolor = ?
     3898    br-operator:VISIBLE IN FRAME Dialog-Frame = NO
     3899    br-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3900    cb-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3901    br-dtruledict:VISIBLE IN FRAME Dialog-Frame = NO.
     3902    br-variable:VISIBLE IN FRAME Dialog-Frame  = NO.
     3903    br-parameter:VISIBLE IN FRAME Dialog-Frame  = NO.
     3904    br-complex:VISIBLE IN FRAME Dialog-Frame  = YES.
     3905    glog = br-complex:MOVE-TO-TOP().
     3906   end.
     3907   END PROCEDURE.
     3908   PROCEDURE proc-init-b-defvariable :
     3909   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3910   DO on error undo, return error return-value:
     3911    b-defvariable:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     3912    f-defvariable:fgcolor = 1   .
     3913    b-prop-script:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3914    b-operator:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3915    b-variable:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3916    b-parameter:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3917    b-complex:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3918    ASSIGN
     3919    f-prop-script:fgcolor = ?
     3920    f-operator:fgcolor = ?
     3921    f-variable:fgcolor = ?
     3922    f-parameter:fgcolor = ?
     3923    f-complex:fgcolor = ?
     3924    br-operator:VISIBLE IN FRAME Dialog-Frame = NO
     3925    br-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3926    cb-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3927    br-dtruledict:VISIBLE IN FRAME Dialog-Frame =YES.
     3928    br-variable:VISIBLE IN FRAME Dialog-Frame =NO.
     3929    br-parameter:VISIBLE IN FRAME Dialog-Frame =NO.
     3930    br-complex:VISIBLE IN FRAME Dialog-Frame =NO.
     3931    glog = br-dtruledict:MOVE-TO-TOP().
     3932   end.
     3933   END PROCEDURE.
     3934   PROCEDURE proc-init-b-operator :
     3935   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3936   DO on error undo, return error return-value:
     3937    b-operator:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     3938    F-operator:fgcolor = 1   .
     3939    b-prop-script:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3940    b-defvariable:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3941    b-variable:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3942    b-parameter:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3943    b-complex:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     3944    ASSIGN
     3945    f-prop-script:fgcolor = ?
     3946    f-defvariable:fgcolor = ?
     3947    f-variable:fgcolor = ?
     3948    f-parameter:fgcolor = ?
     3949    f-complex:fgcolor = ?
     3950    br-operator:VISIBLE IN FRAME Dialog-Frame = YES
     3951    br-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3952    cb-pscript-ruleset:VISIBLE IN FRAME Dialog-Frame = NO.
     3953    br-dtruledict:VISIBLE IN FRAME Dialog-Frame = NO.
