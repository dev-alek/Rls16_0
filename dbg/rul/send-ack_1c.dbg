       89   procedure esallatr-name :
       90   do
       91     on error undo, return error
       92     :
       93     define input  parameter p-code           as character no-undo .
       94     define output parameter p-type           as character no-undo .
       95     define output parameter p-format         as character no-undo .
       96     define output parameter p-label          as character no-undo .
       97     define output parameter p-user-can-edit  as logical   no-undo .
       98     define output parameter p-output-display as logical   no-undo .
       99     define output parameter p-other          as character no-undo .
      100       case p-code :
      101               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      102               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      103         otherwise do:
      104           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
      105         end.
      106       end.
      107     end.
      108   end procedure.
      109   procedure esallatr-value :
      110   do
      111     on error undo, return error
      112     :
      113     define input  parameter p-table-name as character no-undo .
      114     define input  parameter p-key1     as int64 no-undo .
      115     define input  parameter p-key2     as int64 no-undo .
      116     define input  parameter p-key3     as character no-undo .
      117     define input  parameter p-key4     as character no-undo .
      118     define input  parameter p-key5     as int64 no-undo .
      119     define input  parameter p-key6     as int64 no-undo .
      120     define input  parameter p-key7     as character no-undo .
      121     define input  parameter p-key8     as character no-undo .
      122     define input  parameter p-code     as character no-undo .
      123     define output parameter p-value    as character no-undo .
      124     define output parameter p-type     as character no-undo .
      125     define buffer buf_esys-all-attr for ub.esys-all-attr.
      126     define variable v-format         as character no-undo .
      127     define variable v-label          as character no-undo .
      128     define variable v-user-can-edit  as logical   no-undo .
      129     define variable v-output-display as logical   no-undo .
      130     define variable v-other          as character no-undo .
      131       run esallatr-name in this-procedure
      132         (input  p-code
      133         ,output p-type
      134         ,output v-format
      135         ,output v-label
      136         ,output v-user-can-edit
      137         ,output v-output-display
      138         ,output v-other
      139         ) no-error .
      140       if error-status :error then do:
      141         undo, return error return-value .
      142       end.
      143       Find first  buf_esys-all-attr no-lock where
      144                   buf_esys-all-attr.attr-code = p-code
      145              and  buf_esys-all-attr.table-name  = p-table-name
      146              and  buf_esys-all-attr.key1  = p-key1
      147              and  buf_esys-all-attr.key2  = p-key2
      148              and  buf_esys-all-attr.key3  = p-key3
      149              and  buf_esys-all-attr.key4  = p-key4
      150              and  buf_esys-all-attr.key5  = p-key5
      151              and  buf_esys-all-attr.key6  = p-key6
      152              and  buf_esys-all-attr.key7  = p-key7
      153              and  buf_esys-all-attr.key8  = p-key8  no-error .
      154      if avail buf_esys-all-attr then do:
      155       assign
      156       p-value = buf_esys-all-attr.attr-value.
      157      end.
      158      else do:
      159       assign
      160       p-value = if p-type = 'L':U then "no":U else "".
      161      end.
      162   end.
      163   end procedure.
