      357   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   procedure cur-time :
      359      define output parameter p-today as date      no-undo .
      360      define output parameter p-time  as integer   no-undo .
      361     do
      362     on error undo, return error
      363     :
      364       define variable v-date1 as date      no-undo .
      365       define variable v-date2 as date      no-undo .
      366       define variable v-time  as integer   no-undo .
      367       assign
      368         v-date1 = today
      369         v-time  = time
      370         v-date2 = today
      371       .
      372       if v-date1 <> v-date2
      373       then do:
      374         assign
      375           v-date1 = today
      376           v-time  = v-time
      377         .
      378       end.
      379       assign
      380         p-today = v-date1
      381         p-time  = v-time
      382       .
      383     end.
      384   end.
      385   function cur-time-date returns character
      386   :
      387     return string(today, '99/99/9999':U) .
      388   end.
      389   function cur-time-mjd returns decimal
      390   :
      391     define variable v-date as date      no-undo .
      392     define variable v-time as integer   no-undo .
      393     run cur-time in this-procedure
      394       (output v-date
      395       ,output v-time
      396       ) .
      397     return integer(v-date) - 2400002 + (v-time / 86400) .
      398   end.
      399   function cur-time-get-ending-index returns integer
      400   (input p-number as integer
      401   )
      402   :
      403     if p-number < 0
      404     or p-number = ?
      405     then do:
      406       return 1 .
      407     end.
      408     define variable v-rest as integer   no-undo .
      409     assign
      410       p-number = p-number modulo 100
      411     .
      412     if p-number < 20
      413     then do:
      414       assign
      415         v-rest = p-number
      416       .
      417     end.
      418     else do:
      419       assign
      420         v-rest = p-number modulo 10
      421       .
      422     end.
      423     case v-rest :
      424       when 1
      425       then do:
      426         return 2 .
      427       end.
      428       when 2 or
      429       when 3 or
      430       when 4
      431       then do:
      432         return 3 .
      433       end.
      434       otherwise do:
      435         return 1 .
      436       end.
      437     end case .
      438   end.
      439   procedure cur-time-mjd-to-date :
      440      define input  parameter i-mjd-diff as decimal no-undo.
      441      define output parameter o-Date     as date    no-undo.
      442      define output parameter o-Time     as integer no-undo.
      443      define variable v-day-number as integer   no-undo .
      444      if    i-mjd-diff < 0
      445         or i-mjd-diff = ?
      446      then do:
      447         return "?" .
      448      end.
      449      assign
      450         v-day-number = truncate(i-mjd-diff,0).
      451         o-Date = date(v-day-number + 2400002).
      452         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      453     .
      454   end.
      455   function cur-time-mjd-to-string returns character
      456   (input p-mjd-diff as decimal
      457   )
      458   :
      459     define variable v-day-number as integer   no-undo .
      460     define variable v-seconds    as integer   no-undo .
      461     define variable v-hour       as integer   no-undo .
      462     define variable v-min        as integer   no-undo .
      463     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      464     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      465     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      466     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      467     if p-mjd-diff < 0
      468     or p-mjd-diff = ?
      469     then do:
      470       return "?" .
      471     end.
      472     assign
      473       v-day-number = integer(truncate(p-mjd-diff,0))
      474       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      475     .
      476     if v-seconds > 86400
      477     then do:
      478       assign
      479         v-seconds = 86400 - 1
      480       .
      481     end.
      482     if v-seconds < 0
      483     then do:
      484       assign
      485         v-seconds = 0
      486       .
      487     end.
      488     assign
      489       v-hour = truncate(v-seconds / 3600, 0)
      490     .
      491     assign
      492       v-seconds = v-seconds modulo 3600
      493     .
      494     assign
      495       v-min = truncate(v-seconds / 60, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 60
      499     .
      500     return
      501         (if v-day-number <> 0
      502           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      503           else ""
      504         )
      505       + (if v-day-number <> 0 or v-hour <> 0
      506           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      507           else ""
      508         )
      509       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      510           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      511           else ""
      512         )
      513       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      514       .
      515   end.
      516   function cur-time-string returns character
      517   :
      518     define variable v-date as date      no-undo .
      519     define variable v-time as integer   no-undo .
      520     run cur-time in this-procedure
      521       (output v-date
      522       ,output v-time
      523       ) .
      524     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      525   end.
      526   function cur-time-string-sec returns character
      527   :
      528     define variable v-date as date      no-undo .
      529     define variable v-time as integer   no-undo .
      530     run cur-time in this-procedure
      531       (output v-date
      532       ,output v-time
      533       ) .
      534     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      535   end.
      536   function cur-time-custom  returns character
      537   (input p-prefix as character
      538   ,input p-date-format as character
      539   ,input p-delimiter as character
      540   ,input p-time-format as character
      541   ,input p-suffix as character
      542   )
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return
      551       p-prefix
      552       + string(v-date, p-date-format)
      553       + p-delimiter
      554       + string(v-time, p-time-format)
      555       + p-suffix
      556       .
      557   end.
      558   function cur-time-print  returns character
      559   :
      560     define variable v-date as date      no-undo .
      561     define variable v-time as integer   no-undo .
      562     run cur-time in this-procedure
      563       (output v-date
      564       ,output v-time
      565       ) .
      566     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      567   end.
      568   function cur-time-datetime returns datetime
      569   :
      570     define variable v-char as character no-undo .
      571     define variable v-datetime as datetime no-undo .
      572     v-char = cur-time-string().
      573     v-datetime = datetime(v-char).
      574     return  v-datetime.
      575   end.
      576   function cur-time-string-msec returns character
      577   :
      578     define variable v-date as datetime  no-undo .
      579     v-date = now.
      580     return string(v-date) .
      581   end.
      582   define stream LogStream .
      583   define variable mNoTime as logical no-undo.
      584   procedure write-to-log-notime :
      585     define input param i-str as character no-undo .
      586     mNoTime = yes.
      587     run write-to-log (i-str).
      588     mNoTime = no.
      589   end.
      590   procedure write-to-log :
      591     define input param p-str as character no-undo .
      592     do
      593     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      594     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      595     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      596     :
      597       define variable log-res        as logical   no-undo .
      598       define variable v-jj           as integer   no-undo .
      599       if    mNoTime
      600          or writelogvalue eq "AsyncProc"
      601       then
      602          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      603       else
      604          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      605       if auto-log-msg-h <> ? then do:
      606         log-res = auto-log-msg-h:move-to-eof( ) .
      607         log-res = auto-log-msg-h:insert-string( p-str ).
      608       end.
      609       if hand-log-msg-h <> ? then do:
      610         log-res = hand-log-msg-h:move-to-eof( ) .
      611         log-res = hand-log-msg-h:insert-string( p-str ).
      612       end.
      613       assign
      614         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      615         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      616         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      617       .
      618       if add-log-file-name <> ? then do:
      619         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      620           run gbl/fileapnd.p
      621             ( input entry(v-jj, add-log-file-name, chr(1) )
      622             ,input p-str
      623             ,input 20
      624             ) no-error .
      625           if error-status:error then do:
      626             return error return-value .
      627           end.
      628         end.
      629       end.
      630       if writelogvalue eq "AsyncProc"
      631       then do:
      632          p-str = trim(p-str, (chr(13) + chr(10)) )
      633       .
      634          Publish "WriteLogAsunc" (p-str,yes).
      635       end.
      636       else if writelogvalue <> "yes" then do:
      637         run gbl/fileapnd.p
      638           ( input log-file-name
      639           ,input p-str
      640           ,input 20
      641           ) no-error .
      642         if error-status:error then do:
      643           return error return-value .
      644         end.
      645       end.
      646     end.
      647   end procedure.
      648   procedure write-to-screen :
      649     define input param p-str as character no-undo .
      650     do
      651     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      652     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      653     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      654     :
      655       define variable log-res as logical no-undo.
      656       assign
      657         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      658       .
      659       if auto-log-msg-h <> ?
      660       then do:
      661         log-res = auto-log-msg-h:move-to-eof( ) .
      662         log-res = auto-log-msg-h:insert-string( p-str ).
      663       end.
      664       if hand-log-msg-h <> ?
      665       then do:
      666         log-res = hand-log-msg-h:move-to-eof( ) .
      667         log-res = hand-log-msg-h:insert-string( p-str ).
      668       end.
      669     end.
      670   end procedure.
      671   procedure send-msg-to-email :
      672     define input  parameter p-subject      as character no-undo .
      673     define input  parameter p-text-err     as character no-undo .
      674     define input  parameter p-attach-files as character no-undo .
      675     do
      676     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      677     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      678     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      679     :
      680       define variable v-tth             as handle    no-undo .
      681       define variable v-value-character as character no-undo .
      682       define variable v-value-date      as date      no-undo .
      683       define variable v-value-decimal   as decimal   no-undo .
      684       define variable v-value-integer   as integer   no-undo .
      685       define variable v-value-logical   as logical   no-undo .
      686       define variable v-param-type      as character no-undo .
      687       define variable v-email       as character no-undo .
      688       define variable v-tmp-str     as character no-undo .
      689       define variable v-tmp1-str    as character no-undo .
      690       define variable v-ind         as integer   no-undo .
      691       define variable v-num-entries as integer   no-undo .
      692       delete object v-tth no-error.
      693       run adm/shattri.p
      694         ( input "get":U
      695          ,input  "":U
      696          ,input  0
      697          ,input  'auto-task':U
      698          ,input  'send-msg-to-email':U
      699          ,output v-value-character
      700          ,output v-value-date
      701          ,output v-value-decimal
      702          ,output v-value-integer
      703          ,output v-value-logical
      704          ,output v-param-type
      705          ,input-output table-handle v-tth
      706         ) no-error .
      707       if not error-status :error  then do:
      708         assign
      709           v-tmp-str = v-value-character
      710         .
      711       end.
      712       delete object v-tth no-error.
      713       assign
      714         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      715         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      716         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      717         v-num-entries = num-entries( v-tmp-str, chr(44) )
      718         v-email       = "":U
      719       .
      720       do v-ind = 1 to v-num-entries
      721       :
      722         assign
      723           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      724         .
      725         if trim( v-tmp1-str ) <> "":U then do:
      726           if v-email = "":U then do:
      727             assign
      728               v-email = v-tmp1-str
      729             .
      730           end.
      731           else do:
      732             assign
      733               v-email = v-email + chr(44) + v-tmp1-str
      734             .
      735           end.
      736         end.
      737       end.
      738       if v-email <> "":U then do:
      739         run gbl/sendmail.p
      740           ( input v-email
      741           , input p-subject
      742           , input p-text-err
      743           , input p-attach-files
      744           ) no-error .
      745         if error-status :error
      746           or return-value <> "":U
      747         then do:
      748           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      749         end.
      750       end.
      751     end.
      752   end procedure.
      753   define  shared variable oxml-exch-dir as character no-undo .
      754   define  shared variable oxml-heap-dir as character no-undo .
      755   define variable err-mess as character no-undo .
      756   define temp-table t-pck-conf no-undo
      757     field esys-id         as integer
      758     field db-num          as integer
      759     field current-db-num  as integer
      760     field pack-num        as integer
      761     field rcvd-recs       as integer
      762     field total-recs      as integer
      763     field sys-key         as character
      764     field src_db-key      as character
      765     field ver-num         as character
      766     field prev-crc        as character
      767     field actual-date     as date
      768     field actual-time-int as integer
      769   .
      770   function esys-id-format returns character ( input p-esys-id as integer):
      771     return string(p-esys-id, "99999").
      772   end.
      773   FUNCTION nws-db-format returns character ( input p-db-num as integer):
      774     define variable v-nws-db-format as character no-undo .
      775     assign
      776       v-nws-db-format = string( p-db-num,  (if p-db-num > 999 then "99999":U else "999":U ) )
      777     .
      778     return v-nws-db-format.
      779   END FUNCTION.
      780   define variable sw as handle no-undo.
      781   // define variable v-sender-id as character no-undo .
      782   define variable v-work-dir as character no-undo .
      783   define variable v-filename as character no-undo .
      784   define variable v-target-dir as character no-undo .
      785   define variable v-target as character no-undo .
      786   define variable v-source as character no-undo .
      787   define variable v-file-no-ext as character no-undo .
      788   define variable v-mess as character no-undo .
      789   DEFINE VARIABLE v-now AS DATETIME NO-UNDO.
      790   v-work-dir   = nws-db-format( ibs.th.gbl.gbl-var:g#db-num ) + "-":U + "ES" + esys-id-format( p-esys-id ) .
      791   v-target-dir = oxml-exch-dir + chr(92) + v-work-dir .
      792   assign
      793     file-info:file-name = v-target-dir
      794   .
      795   if file-info:file-type = ?
      796     or not ( file-info:file-type begins "D":U ) then do:
      797     os-create-dir value( v-target-dir ).
      798     if os-error <> 0 then do:
      799        run gbl/os-errnm.p ( input os-error
      800                            ,output v-mess) .
      801        undo, return error substitute("&1 Каталог &2 отсутствует, а создать его не удалось.&3&4"
      802                              ,vss-workfile
      803                              ,v-target-dir
      804                              ,chr(10)
      805                              ,v-mess
      806                            ).
      807     end.
      808   end.
      809   v-now = now .
      810   v-file-no-ext = "ack_" + p-sender-id + "_" + v-receiver-id + "_" + string(p-pck-num) + "_"
      811                             + string(day(v-now), "99") + string(month(v-now), "99") + string(year(v-now), "9999")
      812                             + replace (  string(TIME, "HH:MM:SS"),  ":",  "") .
      813   v-filename = v-target-dir + chr(92) + v-file-no-ext + ".xml" .
      814   define variable v-packdata as memptr no-undo .
      815   define variable v-signdata as memptr no-undo .
      816   define variable v-position as integer no-undo .
      817   define variable v-sign-file as character no-undo .
      818     do :
      819       create sax-writer sw.
      820       sw:formatted = true.
      821       sw:set-output-destination ("memptr", v-packdata).
      822       sw:encoding = "UTF-8".
      823       sw:start-document () .
      824       sw:start-element ("GC-ERPRN-ACK") .
      825       sw:insert-attribute ("xmlns", "http://www.rosneft.ru/GasComplex/Retail") .
      826       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
      827       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      828           sw:write-data-element ("num", string(p-pck-num)) .
      829           sw:write-data-element ("sender-id", p-sender-id) .
      830           sw:write-data-element ("reciever-id", v-receiver-id) .
      831           sw:write-data-element ("created-date", iso-date (v-now)) .
      832           sw:write-data-element ("status", string(p-status_)) .
      833           sw:write-data-element ("error", p-error) .
      834       sw:end-element ("GC-ERPRN-ACK") .
      835       sw:end-document () .
      836     end .
      837       COPY-LOB FROM OBJECT v-packdata TO FILE v-filename NO-CONVERT NO-ERROR .
      838       if valid-object (p-pkcs) then do on error undo, throw :
      839         define variable v-err-msg as character no-undo .
      840         v-err-msg = "" .
      841         v-signdata = p-pkcs:computeSign(v-packdata, p-cert-subj-name, p-cert-issuer-name, p-cert-repository) .
      842         // взять имя файла p-pack-file без расширения
      843         v-position = r-index(v-filename, ".") .
      844         v-sign-file = if v-position > 0 then substring(v-filename, 1, v-position - 1) else v-filename .
      845         v-sign-file = substitute("&1.&2", v-sign-file, p-sign-fileext) .
      846         COPY-LOB FROM OBJECT v-signdata TO FILE v-sign-file NO-CONVERT .
      847         catch exAppErrors as class Progress.Lang.AppError :
      848           v-err-msg = exAppErrors:ReturnValue .
      849           if v-err-msg > "" then . else do :
      850             v-err-msg = exAppErrors:GetMessage(1) .
      851             if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rul\send-ack_1c.p" .
      852           end .
      853         end catch .
      854         catch exProErrors as class Progress.Lang.ProError :
      855           v-err-msg = exProErrors:GetMessage(1) .
      856           if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rul\send-ack_1c.p" .
      857         end catch .
      858         catch exAnyErrors as class Progress.Lang.Error:
      859           v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rul\send-ack_1c.p " + exAnyErrors:GetMessage(1).
      860         end catch .
      861         finally:
      862           set-size(v-signdata) = 0 .
      863           if v-err-msg > "" then
      864             undo, return error v-err-msg .
      865         end finally.
      866       end . // end_of if_cert
      867       set-size(v-packdata) = 0 .
      868       os-command silent
      869               value( search('exe/pkzipc.exe':U) )
      870               value( "-add -path=none -span=700 ":U )
      871               value( v-target-dir + "\" + v-file-no-ext + ".zip"  )
      872               value( v-target-dir + "\" + v-file-no-ext + ".*"  )
      873             .
      874       os-delete value(v-filename) .
      875       if valid-object (p-pkcs) then os-delete value(v-sign-file) .
