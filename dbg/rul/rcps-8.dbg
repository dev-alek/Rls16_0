     4089       .
     4090     END.
     4091   END CASE.
     4092    IF p-call-id <> '':U THEN DO:
     4093      v-ch[6]:VISIBLE = NO.
     4094    END.
     4095     IF p-profile-id <> 0 THEN DO:
     4096      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     4097    END.
