     4176   run cur-time in this-procedure ( output v-today, output v-time).
     4177   find first buf_prop-ref no-lock where
     4178             buf_prop-ref.dtm-code = 5
     4179         and buf_prop-ref.caller_id = f-caller-id
     4180         and buf_prop-ref.sum-id >= propreft-date-to-string(v-today)
     4181         no-error.
     4182   if not available buf_prop-ref then do:
     4183     message
     4184     substitute("Внимание! В момент начала работы по данному профайлу в БД должен быть срез/итог по ДК за соответствующий период, у которого доп. идентификатор=&1"
     4185                , f-caller-id
     4186                )
     4187     view-as alert-box warning.
     4188   end.
