     1631        f-prev-dis-rule-name AT ROW 6.6 COL 1 NO-LABEL WIDGET-ID 142
     1632        SPACE(1.09) SKIP(15.99)
     1633       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1634            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1635            TITLE ""
     1636            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1637   ASSIGN
     1638          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1639          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1640   ASSIGN
     1641          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1642   ASSIGN
     1643          l-r-b:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1644   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1645   DO:
     1646     APPLY "END-ERROR":U TO SELF.
     1647   END.
     1648   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1649   DO:
     1650   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1651   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     1652   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1653     run ref/dis-ruls.w (   input  parparentproc
     1654                           ,input 0
     1655                           ,input '':U
     1656                           ,input 0
     1657                           ,input "b-sel,b-add"
     1658                           ,input "upper-rule-num"
     1659                           ,input 63
     1660                           ,input ?
     1661                           ,input 0
     1662                           ,input-output v-sts
     1663                           ,input-OUTPUT v-rid-list) NO-ERROR.
     1664     if v-rid-list <> '':U then do:
     1665       find first buf_dis-rule no-lock where
     1666                 recid(buf_dis-rule) = integer(v-rid-list) no-error.
     1667       if not available buf_dis-rule then do:
     1668           MESSAGE substitute("Не найдено правило скидки c recid &1", v-rid-list)
     1669           VIEW-AS ALERT-BOX ERROR.
     1670           UNDO, RETURN NO-APPLY.
     1671       end.
     1672       assign
     1673       f-rule-num = buf_dis-rule.rule-num
     1674       .
     1675       DISPLAY
     1676       f-rule-num
     1677       buf_dis-rule.des @ f-dis-rule-name
     1678       WITH FRAME Dialog-Frame.
     1679     end.
     1680   END.
     1681   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1682   DO:
     1683     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1684     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1685   END.
     1686   ON CHOOSE OF b-lkp-dis-rule IN FRAME Dialog-Frame
     1687   DO:
     1688   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   if lookup(self :type
     1690            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1691            ) = 0
     1692   then do:
     1693     message
     1694       "$Workfile$"
     1695       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1696       "Интерфейсный элемент" self :name  skip
     1697       "Тип" self :type  skip
     1698       "Процедура" this-procedure :file-name skip
     1699       view-as alert-box .
     1700   end.
     1701   else do:
     1702     apply "entry":u to self  .
     1703     if focus :handle <> self :handle  then do:
     1704       return no-apply .
     1705     end.
     1706   end.
     1707     IF f-rule-num > 0  THEN
     1708     run ref/show-dr.p ( INPUT parparentproc
     1709                        ,INPUT f-rule-num) NO-ERROR.
     1710   END.
     1711   ON CHOOSE OF b-lkp-prev-dis-rule IN FRAME Dialog-Frame
     1712   DO:
     1713   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1714   if lookup(self :type
     1715            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1716            ) = 0
     1717   then do:
     1718     message
     1719       "$Workfile$"
     1720       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1721       "Интерфейсный элемент" self :name  skip
     1722       "Тип" self :type  skip
     1723       "Процедура" this-procedure :file-name skip
     1724       view-as alert-box .
     1725   end.
     1726   else do:
     1727     apply "entry":u to self  .
     1728     if focus :handle <> self :handle  then do:
     1729       return no-apply .
     1730     end.
     1731   end.
     1732     IF f-prev-rule-num > 0  THEN
     1733     run ref/show-dr.p ( INPUT parparentproc
     1734                        ,INPUT f-prev-rule-num) NO-ERROR.
     1735   END.
     1736   ON CHOOSE OF b-prev-dis-rule IN FRAME Dialog-Frame
     1737   DO:
     1738   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1739   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     1740   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1741     run ref/dis-ruls.w (   input  parparentproc
     1742                           ,input 0
     1743                           ,input '':U
     1744                           ,input 0
     1745                           ,input "b-sel,b-add"
     1746                           ,input "upper-rule-num"
     1747                           ,input 63
     1748                           ,input ?
     1749                           ,input 0
     1750                           ,input-output v-sts
     1751                           ,input-OUTPUT v-rid-list) NO-ERROR.
     1752     if v-rid-list <> '':U then do:
     1753       find first buf_dis-rule no-lock where
     1754                 recid(buf_dis-rule) = integer(v-rid-list) no-error.
     1755       if not available buf_dis-rule then do:
     1756           MESSAGE substitute("Не найдено правило скидки c recid &1", v-rid-list)
     1757           VIEW-AS ALERT-BOX ERROR.
     1758           UNDO, RETURN NO-APPLY.
     1759       end.
     1760       assign
     1761       f-prev-rule-num = buf_dis-rule.rule-num
     1762       .
     1763       DISPLAY
     1764       f-prev-rule-num
     1765       buf_dis-rule.des @ f-prev-dis-rule-name
     1766       WITH FRAME Dialog-Frame.
     1767     end.
     1768   END.
     1769   ON CHOOSE OF b-sum-id IN FRAME Dialog-Frame
     1770   DO:
     1771   define variable v-rid-list as character no-undo .
     1772   define buffer buf_prop-ref for ub.prop-ref.
     1773   run ref/proprefs.w (   input  parparentproc
     1774                         ,input "b-sel,b-add"
     1775                         ,input "dtm-code"
     1776                         ,input  7
     1777                         ,input '':U
     1778                         ,input '':U
     1779                         ,input-OUTPUT v-rid-list) NO-ERROR.
     1780   if v-rid-list = '' then return no-apply.
     1781   find first buf_prop-ref no-lock where
     1782             recid(buf_prop-ref) = integer(v-rid-list) no-error.
     1783   if not available buf_prop-ref then do:
     1784     MESSAGE
     1785     substitute("Нет среза с recid &1", v-rid-list)
     1786     VIEW-AS ALERT-BOX ERROR.
     1787     UNDO, RETURN NO-APPLY.
     1788   end.
     1789   f-sum-id = buf_prop-ref.sum-id.
     1790   f-nd-caller-id = buf_prop-ref.caller_id.
     1791   display
     1792   f-sum-id
     1793   f-nd-caller-id
     1794   with frame Dialog-Frame .
     1795   END.
     1796   ON VALUE-CHANGED OF t-is-over IN FRAME Dialog-Frame
     1797   DO:
     1798      assign
     1799      t-is-over.
     1800   END.
     1801   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1802   DO:
     1803     IF AVAIL tt-rule-call-param THEN DO:
     1804       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1805     END.
     1806   END.
     1807   ON f6 anywhere DO:
     1808     ASSIGN
     1809     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1810     .
     1811   END.
     1812   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1813   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1814   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   on help of frame Dialog-Frame
     1816   do:
     1817     run gbl/app_help.p
     1818       (input this-procedure :file-name
     1819       ,input ''
     1820       ,input ?
     1821       ) no-error.
     1822     if error-status :error then do:
     1823       message
     1824         "Ошибка при вызове помощи"
     1825         error-status :get-message(1)
     1826         view-as alert-box .
     1827     end.
     1828   end.
     1829   run minbtn-set in this-procedure .
     1830   on choose of b-help in frame Dialog-Frame
     1831   do:
     1832     apply "help":u to frame Dialog-Frame .
     1833   end.
     1834   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   procedure minbtn-set :
     1836       do
     1837           on error undo, return error return-value
     1838           :
     1839           define variable ii              as integer       no-undo .
     1840           define variable fh              as widget-handle no-undo .
     1841           define variable hh              as widget-handle no-undo .
     1842           define variable v-h             as handle        extent 4 no-undo .
     1843           define variable v-name-button   as character     no-undo .
     1844           define variable v-help-old-x    as decimal       no-undo .
     1845           define variable v-help-old-y    as decimal       no-undo .
     1846           define variable v-help-old-size as decimal       no-undo .
     1847           define variable v-frame-width   as decimal       no-undo .
     1848           define variable jj              as integer       no-undo .
     1849           do
     1850               on error undo, return error
     1851               :
     1852               assign
     1853                   v-frame-width = frame Dialog-Frame:width - 0.3
     1854                   fh            = frame Dialog-Frame:first-child
     1855                   hh            = fh:first-child
     1856                   ii            = 1
     1857                   .
     1858               do while valid-handle(hh):
     1859                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1860                   do:
     1861                       case lc(hh:name) :
     1862                           when "b-help" then
     1863                               do:
     1864                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1865                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1866                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1867                                   hh:TOOLTIP = "Помощь" .
     1868                                   v-help-old-x = hh:column .
     1869                                   v-help-old-y = hh:row    .
     1870                                   v-help-old-size = hh:width .
     1871                                   hh:width-chars = 2.5 .
     1872                               end.
     1873                           when "b-print" then
     1874                               do:
     1875                                   hh:load-image("cmp/b-print.bmp":u) .
     1876                                   hh:TOOLTIP = "Печать" .
     1877                                   v-h[ii] = hh:handle .
     1878                                   ii = ii + 1 .
     1879                                   hh:width-chars = 3 .
     1880                               end.
     1881                           when "b-history" or
     1882                           when "b-hist" then
     1883                               do:
     1884                                   hh:load-image("cmp/b-hist.bmp":u) .
     1885                                   hh:TOOLTIP = "История" .
     1886                                   v-h[ii] = hh:handle .
     1887                                   ii = ii + 1 .
     1888                                   hh:width-chars = 3 .
     1889                               end.
     1890                           when "b-sch" then
     1891                               do:
     1892                                   hh:load-image("cmp/b-sch.bmp":u) .
     1893                                   hh:TOOLTIP = "Установка Фильтра" .
     1894                                   v-h[ii] = hh:handle .
     1895                                   ii = ii + 1 .
     1896                                   hh:width-chars = 3 .
     1897                               end.
     1898                           when "b-hist-user" then
     1899                               do:
     1900                                   hh:load-image("cmp/b-hist.bmp":u) .
     1901                                   hh:TOOLTIP = "История пользователя" .
     1902                                   ii = ii + 1 .
     1903                               end.
     1904                       end case.
     1905                   end.
     1906                   hh = hh:next-sibling.
     1907               end.
     1908               b-help:column = v-frame-width - b-help:width-chars.
     1909               jj = 0.
     1910               repeat ii = 4 to 1 by -1 :
     1911                   if valid-handle (v-h[ii] ) then
     1912                   do:
     1913                       jj  = jj + 1 .
     1914                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1915                       v-h[ii]:row    = v-help-old-y .
     1916                   end.
     1917               end.
     1918           end.
     1919       end.
     1920   end procedure.
     1921   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1922   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1923   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1924   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1925   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1926   define variable v-diasize-current-frame-height as decimal   no-undo .
     1927   define variable v-diasize-change-size          as logical   no-undo .
     1928   define variable v-diasize-resize-button        as handle    no-undo .
     1929   define variable v-diasize-wndmax               as logical   no-undo .
     1930   define variable v-diasize-wndstore             as logical   no-undo .
     1931   define variable v-diasize-proc-name            as character no-undo .
     1932   define variable v-diasize-browse-handle        as handle    no-undo .
     1933   define variable v-diasize-browse-number        as integer   no-undo .
     1934   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1935   define temp-table temp-diasize-handle no-undo
     1936     field handle-value  as handle
     1937     field save-position as decimal
     1938     index xpk is primary unique handle-value
     1939     .
     1940   define temp-table temp-browse-handle no-undo
     1941     field browse-type   as character
     1942     field browse-number as integer
     1943     field browse-handle as handle
     1944     field original-size as decimal
     1945     index xpk is primary unique browse-type browse-number
     1946     index xie browse-type browse-handle
     1947   .
     1948   procedure diasize_change-height :
     1949     define input  parameter p-change-value  as decimal   no-undo .
     1950     define input  parameter p-move-resize   as logical   no-undo .
     1951     define variable v-field-group-handle    as handle    no-undo .
     1952     define variable v-object-handle         as handle    no-undo .
     1953     define variable v-frame-height          as decimal   no-undo .
     1954     define variable v-frame-virtual-height  as decimal   no-undo .
     1955     define variable v-browse-height         as decimal   no-undo .
     1956     define variable v-window-height         as decimal   no-undo .
     1957     define variable v-window-virtual-height as decimal   no-undo .
     1958     define variable v-change-sign           as integer   no-undo .
     1959     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1960     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1961     if p-change-value > 0
     1962     then do:
     1963       if frame Dialog-Frame :height + p-change-value
     1964           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1965       then do:
     1966         assign
     1967           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1968                           - (frame Dialog-Frame :height-chars)
     1969         .
     1970         if p-change-value <= 0
     1971         then do:
     1972           run diasize_position-resize-button in this-procedure .
     1973           return .
     1974         end.
     1975       end.
     1976     end.
     1977     if p-change-value < 0
     1978     then do:
     1979       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1980       then do:
     1981         assign
     1982           p-change-value = v-diasize-orig-frame-height
     1983                          - (frame Dialog-Frame :height-chars)
     1984         .
     1985         if p-change-value >= 0
     1986         then do:
     1987           run diasize_position-resize-button in this-procedure .
     1988           return .
     1989         end.
     1990       end.
     1991     end.
     1992     if p-change-value >= 0
     1993     then do:
     1994       assign
     1995         v-change-sign = 1
     1996       .
     1997     end.
     1998     else do:
     1999       assign
     2000         v-change-sign = -1
     2001       .
     2002     end.
     2003     assign
     2004       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2005     .
     2006     if p-change-value = 0
     2007     then do:
     2008       run diasize_position-resize-button in this-procedure .
     2009       return .
     2010     end.
     2011     move_block:
     2012     do
     2013     on error undo move_block, retry move_block
     2014     :
     2015       if retry
     2016       then do:
     2017         do
     2018         on error undo move_block, leave move_block
     2019         :
     2020           if p-change-value > 0
     2021           then do:
     2022             for each buf_temp-diasize-handle
     2023             on error undo, next
     2024             :
     2025               assign
     2026                 v-object-handle = buf_temp-diasize-handle.handle-value
     2027               .
     2028               if v-object-handle <> v-diasize-resize-button
     2029               then do:
     2030                 assign
     2031                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2032                 .
     2033               end.
     2034             end.
     2035             assign
     2036               v-diasize-browse-handle :height = v-browse-height
     2037             .
     2038             for each buf_temp-browse-handle
     2039               where buf_temp-browse-handle.browse-type = 'height':u
     2040             on error undo, next
     2041             :
     2042               assign
     2043                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2044               .
     2045             end.
     2046             assign
     2047               frame Dialog-Frame :height = v-frame-height
     2048             .
     2049             if frame Dialog-Frame :scrollable = true
     2050             then do:
     2051               assign
     2052                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2053               .
     2054             end.
     2055             run diasize_position-resize-button in this-procedure .
     2056           end.
     2057           else do:
     2058             if frame Dialog-Frame :scrollable = true
     2059             then do:
     2060               assign
     2061                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2062               .
     2063             end.
     2064             assign
     2065               frame Dialog-Frame :height = v-frame-height
     2066             .
     2067             assign
     2068               v-diasize-browse-handle :height = v-browse-height
     2069             .
     2070             for each buf_temp-browse-handle
     2071               where buf_temp-browse-handle.browse-type = 'height':u
     2072             on error undo, next
     2073             :
     2074               assign
     2075                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2076               .
     2077             end.
     2078             for each buf_temp-diasize-handle
     2079             on error undo, next
     2080             :
     2081               assign
     2082                 v-object-handle = buf_temp-diasize-handle.handle-value
     2083               .
     2084               if v-object-handle <> v-diasize-resize-button
     2085               then do:
     2086                 assign
     2087                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2088                 .
     2089               end.
     2090             end.
     2091             run diasize_position-resize-button in this-procedure .
     2092           end.
     2093           assign
     2094             v-diasize-change-size = false
     2095           .
     2096           leave move_block .
     2097         end.
     2098       end.
     2099       assign
     2100         v-diasize-need-full-display = true
     2101       .
     2102       if v-diasize-change-size = false
     2103       then do:
     2104         assign
     2105           v-diasize-change-size = true
     2106         .
     2107       end.
     2108       else do:
     2109         return .
     2110       end.
     2111       assign
     2112         v-frame-height = frame Dialog-Frame :height
     2113         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2114         v-browse-height = v-diasize-browse-handle :height
     2115       .
     2116       for each buf_temp-browse-handle
     2117         where buf_temp-browse-handle.browse-type = 'height':u
     2118       :
     2119         assign
     2120           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2121         .
     2122       end.
     2123       for each buf_temp-diasize-handle
     2124       :
     2125         delete buf_temp-diasize-handle .
     2126       end.
     2127       assign
     2128         v-field-group-handle = frame Dialog-Frame :first-child
     2129       .
     2130       do while valid-handle(v-field-group-handle)
     2131       :
     2132         assign
     2133           v-object-handle = v-field-group-handle :first-child
     2134         .
     2135         do while valid-handle(v-object-handle)
     2136         :
     2137           if  v-object-handle <> v-diasize-browse-handle :handle
     2138           and can-query(v-object-handle, "row")
     2139           and can-query(v-object-handle, "height")
     2140           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2141           then do:
     2142             find first buf_temp-browse-handle
     2143               where buf_temp-browse-handle.browse-type   = 'height':u
     2144                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2145               no-error .
     2146             if available buf_temp-browse-handle
     2147             then do:
     2148             end.
     2149             else do:
     2150               create buf_temp-diasize-handle .
     2151               assign
     2152                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2153                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2154               .
     2155             end.
     2156           end.
     2157           assign
     2158             v-object-handle = v-object-handle :next-sibling
     2159           .
     2160         end.
     2161         assign
     2162           v-field-group-handle = v-field-group-handle :next-sibling
     2163         .
     2164       end.
     2165       do with frame Dialog-Frame
     2166       :
     2167         hide v-diasize-resize-button .
     2168         assign
     2169           v-diasize-resize-button :row    = 1
     2170           v-diasize-resize-button :column = 1
     2171         .
     2172       end.
     2173       if p-change-value > 0
     2174       then do:
     2175         if frame Dialog-Frame :scrollable = true
     2176         then do:
     2177           assign
     2178             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2179             no-error .
     2180           if error-status :error
     2181           or error-status :get-message(1) <> ""
     2182           then do:
     2183             undo move_block, retry move_block .
     2184           end.
     2185         end.
     2186         assign
     2187           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2188           no-error .
     2189         if error-status :error
     2190         or error-status :get-message(1) <> ""
     2191         then do:
     2192           undo move_block, retry move_block .
     2193         end.
     2194         assign
     2195           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2196           no-error .
     2197         if error-status :error
     2198         or error-status :get-message(1) <> ""
     2199         then do:
     2200           undo move_block, retry move_block .
     2201         end.
     2202         for each buf_temp-browse-handle
     2203           where buf_temp-browse-handle.browse-type = 'height':u
     2204         on error undo move_block, retry move_block
     2205         :
     2206           assign
     2207             buf_temp-browse-handle.browse-handle :height
     2208               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2209             no-error .
     2210           if error-status :error
     2211           or error-status :get-message(1) <> ""
     2212           then do:
     2213             undo move_block, retry move_block .
     2214           end.
     2215         end.
     2216         for each buf_temp-diasize-handle
     2217         on error undo move_block, retry move_block
     2218         :
     2219           assign
     2220             v-object-handle = buf_temp-diasize-handle.handle-value
     2221           .
     2222           if v-object-handle <> v-diasize-resize-button
     2223           then do:
     2224             assign
     2225               v-object-handle :row = v-object-handle :row + p-change-value
     2226               no-error .
     2227             if error-status :error
     2228             or error-status :get-message(1) <> ""
     2229             then do:
     2230               undo move_block, retry move_block .
     2231             end.
     2232           end.
     2233         end.
     2234       end.
     2235       else do:
     2236         for each buf_temp-diasize-handle
     2237         on error undo move_block, retry move_block
     2238         :
     2239           assign
     2240             v-object-handle = buf_temp-diasize-handle.handle-value
     2241           .
     2242           if v-object-handle <> v-diasize-resize-button
     2243           then do:
     2244             assign
     2245               v-object-handle :row = v-object-handle :row + p-change-value
     2246               no-error .
     2247             if error-status :error
     2248             or error-status :get-message(1) <> ""
     2249             then do:
     2250               undo move_block, retry move_block .
     2251             end.
     2252           end.
     2253         end.
     2254         assign
     2255           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2256           no-error .
     2257         if error-status :error
     2258         or error-status :get-message(1) <> ""
     2259         then do:
     2260           undo move_block, retry move_block .
     2261         end.
     2262         for each buf_temp-browse-handle
     2263           where buf_temp-browse-handle.browse-type = 'height':u
     2264         on error undo move_block, retry move_block
     2265         :
     2266           assign
     2267             buf_temp-browse-handle.browse-handle :height
     2268               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2269             no-error .
     2270           if error-status :error
     2271           or error-status :get-message(1) <> ""
     2272           then do:
     2273             undo move_block, retry move_block .
     2274           end.
     2275         end.
     2276         assign
     2277           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2278           no-error .
     2279         if error-status :error
     2280         or error-status :get-message(1) <> ""
     2281         then do:
     2282           undo move_block, retry move_block .
     2283         end.
     2284         if frame Dialog-Frame :scrollable = true
     2285         then do:
     2286           assign
     2287             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2288             no-error .
     2289           if error-status :error
     2290           or error-status :get-message(1) <> ""
     2291           then do:
     2292             undo move_block, retry move_block .
     2293           end.
     2294         end.
     2295       end.
     2296       if p-move-resize = true
     2297       then do:
     2298         run diasize_position-resize-button in this-procedure .
     2299       end.
     2300       if v-diasize-wndstore = true
     2301       then do:
     2302         if connected("ub") = true
     2303         then do:
     2304           define variable v-cntxt-db-num        as integer   no-undo .
     2305           define variable v-cntxt-userid        as character no-undo .
     2306           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2307                                             , OUTPUT v-cntxt-userid
     2308                                             ) .
     2309           run gbl/wndsizew.p
     2310             (input  v-cntxt-db-num
     2311             ,input  v-cntxt-userid
     2312             ,input  v-diasize-proc-name
     2313             ,input  'height':u
     2314             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2315             ) .
     2316         end.
     2317       end.
     2318     end.
     2319     assign
     2320       v-diasize-change-size = false
     2321     .
     2322   end procedure.
     2323   procedure diasize_set-height :
     2324     define input  parameter p-new-height  as decimal   no-undo .
     2325     define input  parameter p-move-resize as logical   no-undo .
     2326     do
     2327     on error undo, return error return-value
     2328     :
     2329       run diasize_change-height in this-procedure
     2330         (input  (p-new-height - frame Dialog-Frame :height)
     2331         ,input  p-move-resize
     2332         ) .
     2333     end.
     2334   end procedure.
     2335   procedure diasize_change-width :
     2336     define input  parameter p-change-value as decimal   no-undo .
     2337     define input  parameter p-move-resize  as logical   no-undo .
     2338     define variable v-field-group-handle   as handle    no-undo .
     2339     define variable v-object-handle        as handle    no-undo .
     2340     define variable v-frame-width          as decimal   no-undo .
     2341     define variable v-frame-virtual-width  as decimal   no-undo .
     2342     define variable v-browse-width         as decimal   no-undo .
     2343     define variable v-window-width         as decimal   no-undo .
     2344     define variable v-window-virtual-width as decimal   no-undo .
     2345     define variable v-change-sign          as integer   no-undo .
     2346     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2347     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2348     if p-change-value > 0
     2349     then do:
     2350       if frame Dialog-Frame :width + p-change-value >
     2351           session :width-chars
     2352       then do:
     2353         assign
     2354           p-change-value = session :width-chars - frame Dialog-Frame :width
     2355         .
     2356         if p-change-value <= 0
     2357         then do:
     2358           run diasize_position-resize-button in this-procedure .
     2359           return .
     2360         end.
     2361       end.
     2362     end.
     2363     if p-change-value < 0
     2364     then do:
     2365       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2366       then do:
     2367         assign
     2368           p-change-value = v-diasize-orig-frame-width
     2369                          - frame Dialog-Frame :width
     2370         .
     2371         if p-change-value >= 0
     2372         then do:
     2373           run diasize_position-resize-button in this-procedure .
     2374           return .
     2375         end.
     2376       end.
     2377     end.
     2378     if p-change-value >= 0
     2379     then do:
     2380       assign
     2381         v-change-sign = 1
     2382       .
     2383     end.
     2384     else do:
     2385       assign
     2386         v-change-sign = -1
     2387       .
     2388     end.
     2389     assign
     2390       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2391     .
     2392     if p-change-value = 0
     2393     then do:
     2394       run diasize_position-resize-button in this-procedure .
     2395       return .
     2396     end.
     2397     move_block:
     2398     do
     2399     on error undo move_block, leave move_block
     2400     :
     2401       if retry
     2402       then do:
     2403         do
     2404         on error undo move_block, leave move_block
     2405         :
     2406           if p-change-value > 0
     2407           then do:
     2408             for each buf_temp-diasize-handle
     2409             on error undo, next
     2410             :
     2411               assign
     2412                 v-object-handle = buf_temp-diasize-handle.handle-value
     2413               .
     2414               if v-object-handle <> v-diasize-resize-button
     2415               then do:
     2416                 assign
     2417                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2418                 .
     2419               end.
     2420             end.
     2421             assign
     2422               v-diasize-browse-handle :width = v-browse-width
     2423             .
     2424             for each buf_temp-browse-handle
     2425               where buf_temp-browse-handle.browse-type = 'width':u
     2426             on error undo, next
     2427             :
     2428               assign
     2429                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2430               .
     2431             end.
     2432             assign
     2433               frame Dialog-Frame :width = v-frame-width
     2434             .
     2435             if frame Dialog-Frame :scrollable = true
     2436             then do:
     2437               assign
     2438                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2439               .
     2440             end.
     2441             run diasize_position-resize-button in this-procedure .
     2442           end.
     2443           else do:
     2444             if frame Dialog-Frame :scrollable = true
     2445             then do:
     2446               assign
     2447                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2448               .
     2449             end.
     2450             assign
     2451               frame Dialog-Frame :width = v-frame-width
     2452             .
     2453             for each buf_temp-browse-handle
     2454               where buf_temp-browse-handle.browse-type = 'width':u
     2455             on error undo, next
     2456             :
     2457               assign
     2458                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2459               .
     2460             end.
     2461             assign
     2462               v-diasize-browse-handle :width = v-browse-width
     2463             .
     2464             for each buf_temp-diasize-handle
     2465             on error undo, next
     2466             :
     2467               assign
     2468                 v-object-handle = buf_temp-diasize-handle.handle-value
     2469               .
     2470               if v-object-handle <> v-diasize-resize-button
     2471               then do:
     2472                 assign
     2473                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2474                 .
     2475               end.
     2476             end.
     2477             run diasize_position-resize-button in this-procedure .
     2478           end.
     2479           assign
     2480             v-diasize-change-size = false
     2481           .
     2482           leave move_block .
     2483         end.
     2484       end.
     2485       assign
     2486         v-diasize-need-full-display = true
     2487       .
     2488       if v-diasize-change-size = false
     2489       then do:
     2490         assign
     2491           v-diasize-change-size = true
     2492         .
     2493       end.
     2494       else do:
     2495         return .
     2496       end.
     2497       assign
     2498         v-frame-width = frame Dialog-Frame :width
     2499         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2500         v-browse-width = v-diasize-browse-handle :width
     2501       .
     2502       for each buf_temp-browse-handle
     2503         where buf_temp-browse-handle.browse-type = 'width':u
     2504       :
     2505         assign
     2506           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2507         .
     2508       end.
     2509       for each buf_temp-diasize-handle
     2510       :
     2511         delete buf_temp-diasize-handle .
     2512       end.
     2513       assign
     2514         v-field-group-handle = frame Dialog-Frame :first-child
     2515       .
     2516       do while valid-handle(v-field-group-handle)
     2517       :
     2518         assign
     2519           v-object-handle = v-field-group-handle :first-child
     2520         .
     2521         do while valid-handle(v-object-handle)
     2522         :
     2523           if  v-object-handle <> v-diasize-browse-handle :handle
     2524           and v-object-handle <> v-diasize-resize-button
     2525           and can-query(v-object-handle, "row")
     2526           and can-query(v-object-handle, "height")
     2527           and ( v-object-handle :col + v-object-handle :width
     2528                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2529               )
     2530           then do:
     2531             find first buf_temp-browse-handle
     2532               where buf_temp-browse-handle.browse-type   = 'width':u
     2533                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2534               no-error .
     2535             if available buf_temp-browse-handle
     2536             then do:
     2537             end.
     2538             else do:
     2539               create buf_temp-diasize-handle .
     2540               assign
     2541                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2542                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2543               .
     2544             end.
     2545           end.
     2546           assign
     2547             v-object-handle = v-object-handle :next-sibling
     2548           .
     2549         end.
     2550         assign
     2551           v-field-group-handle = v-field-group-handle :next-sibling
     2552         .
     2553       end.
     2554       do with frame Dialog-Frame
     2555       :
     2556         hide v-diasize-resize-button .
     2557         v-diasize-resize-button :row = 1.
     2558         v-diasize-resize-button :column = 1.
     2559       end.
     2560       if p-change-value > 0
     2561       then do:
     2562         if frame Dialog-Frame :scrollable = true
     2563         then do:
     2564           assign
     2565             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2566             no-error .
     2567           if error-status :error
     2568           or error-status :get-message(1) <> ""
     2569           then do:
     2570             undo move_block, retry move_block.
     2571           end.
     2572         end.
     2573         assign
     2574           frame Dialog-Frame :width = v-frame-width + p-change-value
     2575           no-error .
     2576         if error-status :error
     2577         or error-status :get-message(1) <> ""
     2578         then do:
     2579           undo move_block, retry move_block.
     2580         end.
     2581         assign
     2582           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2583         no-error .
     2584         if error-status :error
     2585         or error-status :get-message(1) <> ""
     2586         then do:
     2587           undo move_block, retry move_block.
     2588         end.
     2589         for each buf_temp-browse-handle
     2590           where buf_temp-browse-handle.browse-type = 'width':u
     2591         on error undo move_block, retry move_block
     2592         :
     2593           assign
     2594             buf_temp-browse-handle.browse-handle :width
     2595               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2596             no-error .
     2597           if error-status :error
     2598           or error-status :get-message(1) <> ""
     2599           then do:
     2600             undo move_block, retry move_block .
     2601           end.
     2602         end.
     2603         for each buf_temp-diasize-handle
     2604         on error undo move_block, retry move_block
     2605         :
     2606           assign
     2607             v-object-handle = buf_temp-diasize-handle.handle-value
     2608           .
     2609           if v-object-handle <> v-diasize-resize-button
     2610           then do:
     2611             assign
     2612               v-object-handle :col = v-object-handle :col + p-change-value
     2613               no-error .
     2614             if error-status :error
     2615             or error-status :get-message(1) <> ""
     2616             then do:
     2617               undo move_block, retry move_block .
     2618             end.
     2619           end.
     2620         end.
     2621       end.
     2622       else do:
     2623         for each buf_temp-diasize-handle
     2624         on error undo move_block, retry move_block
     2625         :
     2626           assign
     2627             v-object-handle = buf_temp-diasize-handle.handle-value
     2628           .
     2629           if v-object-handle <> v-diasize-resize-button
     2630           then do:
     2631             assign
     2632               v-object-handle :col = v-object-handle :col + p-change-value
     2633               no-error .
     2634             if error-status :error
     2635             or error-status :get-message(1) <> ""
     2636             then do:
     2637               undo move_block, retry move_block .
     2638             end.
     2639           end.
     2640         end.
     2641         for each buf_temp-browse-handle
     2642           where buf_temp-browse-handle.browse-type = 'width':u
     2643         on error undo move_block, retry move_block
     2644         :
     2645           assign
     2646             buf_temp-browse-handle.browse-handle :width
     2647               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2648             no-error .
     2649           if error-status :error
     2650           or error-status :get-message(1) <> ""
     2651           then do:
     2652             undo move_block, retry move_block .
     2653           end.
     2654         end.
     2655         assign
     2656           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2657           no-error .
     2658         if error-status :error
     2659         or error-status :get-message(1) <> ""
     2660         then do:
     2661           undo move_block, retry move_block.
     2662         end.
     2663         assign
     2664           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2665         no-error .
     2666         if error-status :error
     2667         or error-status :get-message(1) <> ""
     2668         then do:
     2669           undo move_block, retry move_block.
     2670         end.
     2671         if frame Dialog-Frame :scrollable = true
     2672         then do:
     2673           assign
     2674             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2675           no-error .
     2676           if error-status :error
     2677           or error-status :get-message(1) <> ""
     2678           then do:
     2679             undo move_block, retry move_block.
     2680           end.
     2681         end.
     2682       end.
     2683       if p-move-resize
     2684       then do:
     2685         run diasize_position-resize-button in this-procedure .
     2686       end.
     2687       if v-diasize-wndstore = true
     2688       then do:
     2689         if connected("ub") = true
     2690         then do:
     2691           define variable v-cntxt-db-num        as integer   no-undo .
     2692           define variable v-cntxt-userid        as character no-undo .
     2693           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2694                                             , OUTPUT v-cntxt-userid
     2695                                             ) .
     2696           run gbl/wndsizew.p
     2697             (input  v-cntxt-db-num
     2698             ,input  v-cntxt-userid
     2699             ,input  v-diasize-proc-name
     2700             ,input  'width':u
     2701             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2702             ) .
     2703         end.
     2704       end.
     2705     end.
     2706     assign
     2707       v-diasize-change-size = false
     2708     .
     2709   end procedure.
     2710   procedure diasize_set-width :
     2711     define input  parameter p-new-width  as decimal   no-undo .
     2712     define input  parameter p-move-resize as logical   no-undo .
     2713     do
     2714     on error undo, return error return-value
     2715     :
     2716       run diasize_change-width in this-procedure
     2717         (input  (p-new-width - frame Dialog-Frame :width)
     2718         ,input  p-move-resize
     2719         ) .
     2720     end.
     2721   end procedure.
     2722   procedure diasize_position-resize-button :
     2723     do with frame Dialog-Frame
     2724     :
     2725       hide v-diasize-resize-button .
     2726       assign
     2727         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2728                     - 1
     2729                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2730         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2731                     - 1
     2732                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2733       .
     2734       view v-diasize-resize-button .
     2735     end.
     2736   end procedure.
     2737   on alt-right anywhere
     2738   do:
     2739     run diasize_change-width in this-procedure
     2740       (input 1
     2741       ,input true
     2742       ) .
     2743     return no-apply .
     2744   end.
     2745   on alt-left anywhere
     2746   do:
     2747     run diasize_change-width in this-procedure
     2748       (input -1
     2749       ,input true
     2750       ) .
     2751     return no-apply .
     2752   end.
     2753   on alt-down anywhere
     2754   do:
     2755     run diasize_change-height in this-procedure
     2756       (input 1
     2757       ,input true
     2758       ) .
     2759     return no-apply .
     2760   end.
     2761   on alt-up anywhere
     2762   do:
     2763     run diasize_change-height in this-procedure
     2764       (input -1
     2765       ,input true
     2766       ) .
     2767     return no-apply .
     2768   end.
     2769   on alt-enter of frame Dialog-Frame
     2770   do:
     2771     run diasize_maximize in this-procedure
     2772       (input  ?
     2773       ).
     2774     return no-apply .
     2775   end.
     2776   procedure diasize_end-move :
     2777     do
     2778     on error undo, return error return-value
     2779     :
     2780       define variable v-row-delta as decimal   no-undo .
     2781       define variable v-col-delta as decimal   no-undo .
     2782       define variable v-new-row as decimal   no-undo .
     2783       define variable v-new-col as decimal   no-undo .
     2784       assign
     2785         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2786         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2787       .
     2788       assign
     2789         v-row-delta = v-new-row - frame Dialog-Frame :height
     2790         v-col-delta = v-new-col - frame Dialog-Frame :width
     2791       .
     2792       run diasize_change-height in this-procedure
     2793         (input v-row-delta
     2794         ,input true
     2795         ) .
     2796       run diasize_change-width in this-procedure
     2797         (input v-col-delta
     2798         ,input true
     2799         ) .
     2800     end.
     2801   end procedure.
     2802   procedure diasize_maximize :
     2803     define input  parameter p-action as logical   no-undo .
     2804     do
     2805     on error undo, return error return-value
     2806     :
     2807       if p-action = ?
     2808       then do:
     2809         if v-diasize-need-maximize = true
     2810         then do:
     2811           assign
     2812             p-action = true
     2813           .
     2814         end.
     2815         else do:
     2816           assign
     2817             p-action = false
     2818           .
     2819         end.
     2820       end.
     2821       if p-action = true
     2822       then do:
     2823         run diasize_change-height in this-procedure
     2824           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2825               - frame Dialog-Frame :height-chars
     2826           ,input true
     2827           ) .
     2828         run diasize_change-width in this-procedure
     2829           (input session :width-chars
     2830               - frame Dialog-Frame :width-chars
     2831           ,input true
     2832           ) .
     2833         assign
     2834           v-diasize-need-maximize = false
     2835         .
     2836       end.
     2837       else do:
     2838         run diasize_change-width in this-procedure
     2839           (input v-diasize-orig-frame-width
     2840               - frame Dialog-Frame :width-chars
     2841           ,input true
     2842           ) .
     2843         run diasize_change-height in this-procedure
     2844           (input v-diasize-orig-frame-height
     2845               - frame Dialog-Frame :height-chars
     2846           ,input true
     2847           ) .
     2848         assign
     2849           v-diasize-need-maximize = true
     2850         .
     2851       end.
     2852     end.
     2853   end procedure.
     2854   procedure diasize_restore-orig-size :
     2855     do
     2856     on error undo, return error return-value
     2857     :
     2858       assign
     2859         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2860         v-diasize-current-frame-height = frame Dialog-Frame :height
     2861       .
     2862       run diasize_set-height in this-procedure
     2863         (input  v-diasize-orig-frame-height
     2864         ,input  true
     2865         ) .
     2866       run diasize_set-width in this-procedure
     2867         (input  v-diasize-orig-frame-width
     2868         ,input  true
     2869         ) .
     2870     end.
     2871   end procedure.
     2872   procedure diasize_restore-current-size :
     2873     do
     2874     on error undo, return error return-value
     2875     :
     2876       run diasize_set-height in this-procedure
     2877         (input  v-diasize-current-frame-height
     2878         ,input  true
     2879         ) .
     2880       run diasize_set-width in this-procedure
     2881         (input  v-diasize-current-frame-width
     2882         ,input  true
     2883         ) .
     2884     end.
     2885   end procedure.
     2886   procedure diasize_set-browse-handle :
     2887     define input  parameter p-browse-handle as handle   no-undo .
     2888     define buffer buf_temp-browse-handle for temp-browse-handle .
     2889     do
     2890     on error undo, return error return-value
     2891     :
     2892       assign
     2893         v-diasize-browse-handle = p-browse-handle
     2894       .
     2895       for each buf_temp-browse-handle
     2896       on error undo, return error return-value
     2897       :
     2898         delete buf_temp-browse-handle .
     2899       end.
     2900     end.
     2901   end procedure.
     2902   procedure diasize_add_browse :
     2903     define input  parameter p-browse-type   as character no-undo .
     2904     define input  parameter p-browse-handle as handle    no-undo .
     2905     define buffer buf_temp-browse-handle for temp-browse-handle .
     2906     do
     2907     on error undo, return error return-value
     2908     :
     2909       assign
     2910         v-diasize-browse-number = v-diasize-browse-number + 1
     2911       .
     2912       create buf_temp-browse-handle .
     2913       assign
     2914         buf_temp-browse-handle.browse-type   = p-browse-type
     2915         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2916         buf_temp-browse-handle.browse-handle = p-browse-handle
     2917       .
     2918     end.
     2919   end procedure.
     2920   procedure diasize_init :
     2921     define variable v-default-value    as logical   no-undo .
     2922     define variable v-restore-saved    as logical   no-undo .
     2923     define variable v-resize-value-str as character no-undo .
     2924     do
     2925     on error undo, return error return-value
     2926     :
     2927       do with frame Dialog-Frame
     2928       :
     2929         assign
     2930           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2931           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2932           v-diasize-browse-handle     = browse BR-rcp :handle
     2933         .
     2934         create button v-diasize-resize-button
     2935         assign
     2936           parent        = frame Dialog-Frame :first-child
     2937           label         = "s"
     2938           height-pixels = 16
     2939           width-pixels  = 16
     2940           visible       = true
     2941           sensitive     = true
     2942           movable       = true
     2943           triggers:
     2944             on end-move persistent run diasize_end-move in this-procedure .
     2945           end triggers.
     2946         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2947         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2948         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2949         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2950         assign
     2951           v-diasize-wndmax = false
     2952         .
     2953         if connected("ub") = true
     2954         then do:
     2955           define variable v-cntxt-db-num        as integer   no-undo .
     2956           define variable v-cntxt-userid        as character no-undo .
     2957           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2958                                             , OUTPUT v-cntxt-userid
     2959                                             ) .
     2960           run gbl/wndpar_r.p
     2961             (input  v-cntxt-db-num
     2962             ,input  v-cntxt-userid
     2963             ,input  'wndmax':U
     2964             ,output v-diasize-wndmax
     2965             ,output v-default-value
     2966             ) .
     2967         end.
     2968         assign
     2969           v-diasize-wndstore = false
     2970         .
     2971         if connected("ub") = true
     2972         then do:
     2973           run gbl/wndpar_r.p
     2974             (input  v-cntxt-db-num
     2975             ,input  v-cntxt-userid
     2976             ,input  'wndstore':U
     2977             ,output v-diasize-wndstore
     2978             ,output v-default-value
     2979             ) .
     2980         end.
     2981         assign
     2982           v-diasize-proc-name = entry(1, program-name(2), '.')
     2983         .
     2984         if v-diasize-wndstore = true
     2985         then do:
     2986           assign
     2987             v-restore-saved = false
     2988           .
     2989           if connected("ub") = true
     2990           then do:
     2991             run gbl/wndsizer.p
     2992               (input  v-cntxt-db-num
     2993               ,input  v-cntxt-userid
     2994               ,input  v-diasize-proc-name
     2995               ,input  'height':u
     2996               ,output v-resize-value-str
     2997               ) .
     2998             if v-resize-value-str <> '':U
     2999             then do:
     3000               run diasize_change-height in this-procedure
     3001                 (input  integer(v-resize-value-str)
     3002                 ,input  true
     3003                 ) .
     3004               assign
     3005                 v-restore-saved = true
     3006               .
     3007             end.
     3008           end.
     3009           if connected("ub") = true
     3010           then do:
     3011             run gbl/wndsizer.p
     3012               (input  v-cntxt-db-num
     3013               ,input  v-cntxt-userid
     3014               ,input  v-diasize-proc-name
     3015               ,input  'width':u
     3016               ,output v-resize-value-str
     3017               ) .
     3018             if v-resize-value-str <> '':U
     3019             then do:
     3020               run diasize_change-width in this-procedure
     3021                 (input  integer(v-resize-value-str)
     3022                 ,input  true
     3023                 ) .
     3024               assign
     3025                 v-restore-saved = true
     3026               .
     3027             end.
     3028           end.
     3029           if v-restore-saved <> true
     3030           then do:
     3031             if v-diasize-wndmax = true
     3032             then do:
     3033               run diasize_maximize in this-procedure
     3034                 (input  true
     3035                 ) .
     3036             end.
     3037           end.
     3038         end.
     3039         else do:
     3040           if v-diasize-wndmax = true
     3041           then do:
     3042             run diasize_maximize in this-procedure
     3043               (input  true
     3044               ) .
     3045           end.
     3046         end.
     3047       end.
     3048     end.
     3049   end procedure.
     3050   procedure diasize_need-full-display :
     3051     define output parameter p-need-full-display as logical   no-undo .
     3052     do
     3053     on error undo, return error return-value
     3054     :
     3055       assign
     3056         p-need-full-display = v-diasize-need-full-display
     3057       .
     3058       assign
     3059         v-diasize-need-full-display = false
     3060       .
     3061     end.
     3062   end procedure.
     3063   procedure get-context :
     3064      define output parameter p-db-num as integer          no-undo.
     3065      define output parameter p-user-id as character        no-undo.
     3066      define variable v-login               as character    no-undo.
     3067      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3068      define buffer buf_user-login  for ub.user-login .
     3069      do
     3070      on error undo, return error
     3071      :
     3072            FIND FIRST buf_sys-ctrl no-lock.
     3073            ASSIGN
     3074               v-login = USERID("ub")
     3075               p-db-num = buf_sys-ctrl.db-num
     3076            .
     3077            FIND FIRST buf_user-login
     3078                 WHERE buf_user-login.db-num = p-db-num
     3079                   AND buf_user-login.user-login = v-login
     3080                 no-lock
     3081                 no-error
     3082                 .
     3083            IF AVAILABLE buf_user-login
     3084            THEN DO:
     3085               assign
     3086                  p-user-id = buf_user-login.user-id
     3087               .
     3088            END.
     3089      end.
     3090   end procedure.
     3091       run diasize_init in this-procedure .
     3092   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3093   procedure rcps_get-profile-id :
     3094   define output parameter p-local-profile-id as integer no-undo .
     3095   do
     3096   on error undo, return error:
     3097   p-local-profile-id = p-profile-id.
     3098   end.
     3099   end procedure.
     3100   PROCEDURE rcps_fill-table :
     3101   define input parameter p-clear-params as logical no-undo .
     3102   if p-clear-params then do:
     3103   FOR EACH tt-rule-call-param:
     3104       DELETE tt-rule-call-param.
     3105   END.
     3106   end.
     3107    FOR EACH tt0-rule-call-param:
     3108      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3109        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3110           NEXT.
     3111        end.
     3112        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3113          NEXT.
     3114        end.
     3115        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3116          NEXT.
     3117        end.
     3118        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3119          NEXT.
     3120        end.
     3121        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3122          NEXT.
     3123        end.
     3124      END.
     3125      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     3126        next.
     3127      end.
     3128      IF p-list-mode = 'rp-rule-param':U
     3129      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3130      THEN DO:
     3131         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3132           NEXT.
     3133         end.
     3134         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3135           NEXT.
     3136         end.
     3137      END.
     3138      CREATE tt-rule-call-param.
     3139      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     3140   END.
     3141   END PROCEDURE.
     3142   procedure rcps_get-value :
     3143   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3144   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3145   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3146   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3147   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     3148   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     3149   DEFINE output parameter p-value-date AS date NO-UNDO.
     3150   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     3151   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     3152   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     3153   define variable v-current-index as integer no-undo init -1.
     3154   define variable v-start as logical no-undo init yes.
     3155   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3156   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3157   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3158   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3159   do
     3160   on error undo, return error
     3161   :
     3162   FOR FIRST buf_rp-rule-param WHERE
     3163         buf_rp-rule-param.profile_id = p-profile-id
     3164     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3165   , each buf_tt-rule-call-param WHERE
     3166      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3167   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3168   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3169   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3170   AND buf_tt-rule-call-param.p-index >= pp-index
     3171    ,each buf_term_tt-rule-call-param where
     3172          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3173      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3174      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3175      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3176      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3177      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     3178     by buf_term_tt-rule-call-param.call_id
     3179     by buf_term_tt-rule-call-param.codex_id
     3180     by buf_term_tt-rule-call-param.ruleset_id
     3181     by buf_term_tt-rule-call-param.order_id
     3182     by buf_term_tt-rule-call-param.param-name
     3183     by buf_term_tt-rule-call-param.p-index :
     3184       if v-start
     3185       then do:
     3186         assign
     3187         pp-index = buf_term_tt-rule-call-param.p-index
     3188         p-value-character = buf_term_tt-rule-call-param.param-value-character
     3189         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     3190         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     3191         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     3192         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     3193         v-start = no
     3194         .
     3195       end.
     3196       else do:
     3197         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     3198           v-current-index = buf_term_tt-rule-call-param.p-index.
     3199           leave.
     3200         end.
     3201             end.
     3202     end.
     3203     pp-index = v-current-index.
     3204   end.
     3205   end procedure.
     3206   PROCEDURE rcps_proc-b-add :
     3207   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3208   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3209   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3210   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3211   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3212   define variable v-ind as integer no-undo .
     3213   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3214   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3215   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3216   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3217   FOR FIRST buf_rp-rule-param WHERE
     3218             buf_rp-rule-param.profile_id = p-profile-id
     3219         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3220       , first buf0_tt-rule-call-param WHERE
     3221          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3222      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3223      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3224      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3225     LEAVE.
     3226   END.
     3227   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3228     BELL.
     3229     RETURN.
     3230   END.
     3231   for each buf_rp-rule-param where
     3232           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3233       and buf_rp-rule-param.profile_id = p-profile-id,
     3234       first buf_tt-rule-call-param where
     3235           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3236       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3237       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3238       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3239       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3240       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3241       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3242       and buf_tt-rule-call-param.p-index = p-index:
     3243     RETURN.
     3244   END.
     3245   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3246   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3247   THEN DO:
     3248     BELL.
     3249     RETURN.
     3250   END.
     3251   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     3252     BELL.
     3253     RETURN.
     3254   END.
     3255   find last buf_tt-rule-call-param where
     3256            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3257        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     3258        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     3259        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     3260        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     3261   if available buf_tt-rule-call-param
     3262   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3263        or
     3264        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3265        )
     3266   and buf_tt-rule-call-param.p-index > 0 then do:
     3267     v-ind = buf_tt-rule-call-param.p-index.
     3268   end.
     3269   for each buf_rp-rule-param where
     3270           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3271       and buf_rp-rule-param.profile_id = p-profile-id,
     3272       first buf_tt-rule-call-param where
     3273           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3274       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3275       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3276       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3277       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3278       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3279       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3280       and buf_tt-rule-call-param.p-index = 0
     3281   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3282   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3283   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3284   :
     3285     create buf2_tt-rule-call-param.
     3286     buffer-copy buf_tt-rule-call-param
     3287     except p-index
     3288     to buf2_tt-rule-call-param
     3289     assign
     3290     buf2_tt-rule-call-param.p-index = v-ind + 1
     3291     .
     3292   end.
     3293   END PROCEDURE.
     3294   PROCEDURE rcps_proc-b-del :
     3295   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3296   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3297   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3298   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3299   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3300   define variable v-ind as integer no-undo .
     3301   define variable v-once-more as integer no-undo .
     3302   define variable v-call-id as character no-undo .
     3303   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3304   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3305   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3306   if pp-index = 0 then do:
     3307     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3308   end.
     3309   FOR first buf_rp-rule-param WHERE
     3310             buf_rp-rule-param.profile_id = p-profile-id
     3311         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3312       , first buf0_tt-rule-call-param WHERE
     3313          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3314      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3315      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3316      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3317      AND buf0_tt-rule-call-param.p-index = pp-index
     3318      :
     3319     LEAVE.
     3320   END.
     3321   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3322     FOR first buf_rp-rule-param WHERE
     3323               buf_rp-rule-param.profile_id = p-profile-id
     3324           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3325         , last buf0_tt-rule-call-param WHERE
     3326           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3327       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3328       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3329       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3330       AND buf0_tt-rule-call-param.p-index > pp-index :
     3331       leave.
     3332     end.
     3333     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3334     return "not-found".
     3335     end.
     3336     else do:
     3337       return ''.
     3338     end.
     3339   END.
     3340   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3341   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3342   THEN DO:
     3343     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3344   END.
     3345   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3346     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3347   END.
     3348   for each buf_rp-rule-param where
     3349           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3350       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3351       each buf_tt-rule-call-param where
     3352           buf_tt-rule-call-param.call_id = p-call-id
     3353       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3354       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3355       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3356       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3357       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3358       and buf_tt-rule-call-param.once-more = p-once-more
     3359       and buf_tt-rule-call-param.p-index = pp-index
     3360   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3361   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3362   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3363       DELETE buf_tt-rule-call-param.
     3364   end.
     3365   return ''.
     3366   END PROCEDURE.
     3367   PROCEDURE rcps_proc-save0 :
     3368   FOR EACH tt-rule-call-param
     3369   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3370   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3371   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3372   :
     3373      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3374               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3375          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3376          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3377          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3378          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3379          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3380      if not available tt0-rule-call-param
     3381      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3382           OR
     3383           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3384           )
     3385      and tt-rule-call-param.p-index > 0 then do:
     3386        create tt0-rule-call-param.
     3387      end.
     3388      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3389   END.
     3390   FOR EACH tt0-rule-call-param
     3391   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3392   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3393   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3394   :
     3395     if tt0-rule-call-param.p-index = 0 then next.
     3396     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3397     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3398             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3399         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3400         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3401         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3402         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3403         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3404     if not available tt-rule-call-param
     3405     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3406         OR
     3407         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3408         )
     3409     and tt0-rule-call-param.p-index > 0
     3410     then do:
     3411        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3412           NEXT.
     3413        end.
     3414        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3415          NEXT.
     3416        end.
     3417        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3418          NEXT.
     3419        end.
     3420        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3421          NEXT.
     3422        end.
     3423        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3424          NEXT.
     3425        end.
     3426       IF p-list-mode = 'rp-rule-param':U
     3427       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3428       THEN DO:
     3429         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3430           NEXT.
     3431         end.
     3432         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3433           NEXT.
     3434         end.
     3435       end.
     3436       delete tt0-rule-call-param.
     3437     end.
     3438   end.
     3439   END PROCEDURE.
     3440   PROCEDURE rcps_set-value :
     3441   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3442   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3443   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3444   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3445   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3446   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3447   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3448   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3449   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3450   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3451   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3452   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3453   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3454   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3455   define variable v-found as logical no-undo .
     3456   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3457   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3458   FOR FIRST buf_rp-rule-param WHERE
     3459             buf_rp-rule-param.profile_id = p-profile-id
     3460         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3461       , first buf_tt-rule-call-param WHERE
     3462          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3463      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3464      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3465      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3466     ASSIGN
     3467     v-codex-id = buf_tt-rule-call-param.codex_id
     3468     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3469     v-order-id = buf_tt-rule-call-param.order_id
     3470     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3471     .
     3472     LEAVE.
     3473   END.
     3474   CASE p-list-mode:
     3475     WHEN 'rp-rule-param':U THEN DO:
     3476       if pp-index > 0
     3477       then do:
     3478         FOR EACH  buf_rp-rule-param NO-LOCK where
     3479             buf_rp-rule-param.profile_id = p-profile-id
     3480             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3481             ,EACH buf_tt-rule-call-param WHERE
     3482                 buf_tt-rule-call-param.profile_id = p-profile-id
     3483             AND buf_tt-rule-call-param.once-more = p-once-more
     3484             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3485             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3486             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3487             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3488             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3489             AND buf_tt-rule-call-param.p-index = pp-index
     3490         ON error undo, return error :
     3491           v-found = yes.
     3492         end.
     3493       end.
     3494       if not v-found then do:
     3495         run rcps_proc-b-add in this-procedure (
     3496                                                  input p-profile-id
     3497                                                 ,input p-once-more
     3498                                                 ,input p-call-id
     3499                                                 ,
     3500                                                  input p-rp-param-name
     3501                                                 ,input pp-index).
     3502       end.
     3503       FOR EACH  buf_rp-rule-param NO-LOCK where
     3504           buf_rp-rule-param.profile_id = p-profile-id
     3505           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3506           ,EACH buf_tt-rule-call-param WHERE
     3507               buf_tt-rule-call-param.profile_id = p-profile-id
     3508           AND buf_tt-rule-call-param.once-more = p-once-more
     3509           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3510           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3511           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3512           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3513           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3514           AND buf_tt-rule-call-param.p-index = pp-index
     3515         ON error undo, return error :
     3516         assign
     3517         buf_tt-rule-call-param.param-value-character = p-value-character
     3518         buf_tt-rule-call-param.param-value-date      = p-value-date
     3519         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3520         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3521         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3522         .
     3523       END.
     3524     END.
     3525     WHEN 'rule-call-param':U THEN DO:
     3526       FIND FIRST buf_tt-rule-call-param WHERE
     3527           buf_tt-rule-call-param.call_id = p-call-id
     3528       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3529       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3530       AND buf_tt-rule-call-param.order_id = v-order-id
     3531       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3532       AND buf_tt-rule-call-param.p-index = pp-index.
     3533       assign
     3534       buf_tt-rule-call-param.param-value-character = p-value-character
     3535       buf_tt-rule-call-param.param-value-date      = p-value-date
     3536       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3537       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3538       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3539       .
     3540     END.
     3541   END CASE.
     3542   END PROCEDURE.
     3543   procedure rcps_get-rule-on-off :
     3544   define input parameter p-codex-id as integer no-undo .
     3545   define input parameter p-ruleset-id as integer no-undo .
     3546   define input parameter p-rule-id as integer no-undo .
     3547   define input parameter p-profile-id as integer no-undo .
     3548   define input parameter p-once-more as integer no-undo .
     3549   define output parameter p-on-off as logical no-undo .
     3550   if valid-handle(p-call-handle)
     3551   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3552     run rcpscont_get-rule-on-off in p-call-handle (
     3553                                              input p-codex-id
     3554                                             ,input p-ruleset-id
     3555                                             ,input p-rule-id
     3556                                             ,input p-profile-id
     3557                                             ,input p-once-more
     3558                                             ,output p-on-off) no-error.
     3559   end.
     3560   end procedure.
     3561   procedure rcps_set-rule-on-off :
     3562   define input parameter p-codex-id as integer no-undo .
     3563   define input parameter p-ruleset-id as integer no-undo .
     3564   define input parameter p-rule-id as integer no-undo .
     3565   define input parameter p-profile-id as integer no-undo .
     3566   define input parameter p-once-more as integer no-undo .
     3567   define input parameter p-on-off as logical no-undo .
     3568   if valid-handle(p-call-handle)
     3569   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3570     run rcpscont_set-rule-on-off in p-call-handle (
     3571                                              input p-codex-id
     3572                                             ,input p-ruleset-id
     3573                                             ,input p-rule-id
     3574                                             ,input p-profile-id
     3575                                             ,input p-once-more
     3576                                             ,input p-on-off) no-error.
     3577   end.
     3578   end procedure.
     3579   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3580   PROCEDURE rcps_MyEnable0 :
     3581   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3582   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3583   ASSIGN
     3584   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3585   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3586   .
     3587   ASSIGN
     3588   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3589   REPEAT WHILE valid-handle(v-ch0):
     3590      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3591        v-ch[1] = v-ch0.
     3592        v-ch0:VISIBLE = NO.
     3593      END.
     3594      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3595        v-ch[2] = v-ch0.
     3596        v-ch0:VISIBLE = NO.
     3597      END.
     3598      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3599        v-ch[3] = v-ch0.
     3600        v-ch0:VISIBLE = NO.
     3601      END.
     3602      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3603        v-ch[4] = v-ch0.
     3604        v-ch0:VISIBLE = NO.
     3605      END.
     3606      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3607        v-ch[5] = v-ch0.
     3608        v-ch0:VISIBLE = NO.
     3609      END.
     3610      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3611        v-ch[6] = v-ch0.
     3612      END.
     3613      IF v-ch0:LABEL = "Значение" THEN
     3614      v-ch0:RESIZABLE = YES.
     3615      v-ch0 = v-ch0:NEXT-COLUMN.
     3616   END.
     3617   assign
     3618   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3619   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3620   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3621   .
     3622   CASE p-list-mode:
     3623     WHEN 'rule-call-param':U THEN DO:
     3624        ASSIGN
     3625        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3626        .
     3627     END.
     3628     WHEN 'rp-rule-param':U
     3629     or
     3630     when 'rp-rule-param':U + chr(44) + 'все':U
     3631     THEN DO:
     3632       assign
     3633       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3634       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3635       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3636       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3637       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3638       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3639       .
     3640     END.
     3641   END CASE.
     3642    IF p-call-id <> '':U THEN DO:
     3643      v-ch[6]:VISIBLE = NO.
     3644    END.
     3645     IF p-profile-id <> 0 THEN DO:
     3646      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3647    END.
     3648     IF p-rule-id <> 0 THEN DO:
     3649      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3650    END.
     3651     IF p-once-more <> 0 THEN DO:
     3652      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3653    END.
     3654   END PROCEDURE.
     3655   PROCEDURE rcps_Openbr :
     3656   CASE p-list-mode:
     3657     WHEN 'rp-rule-param':U THEN DO:
     3658         OPEN QUERY br-rcp
     3659         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3660             ,FIRST X_rp-rule-param WHERE
     3661                 X_rp-rule-param.profile_id = p-profile-id
     3662             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3663           , first tt-rule-call-param WHERE
     3664              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3665          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3666          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3667          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3668            ,each term_tt-rule-call-param where
     3669                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3670              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3671              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3672              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3673              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3674         BY tt-rule-call-param.call_id
     3675         BY tt-rule-call-param.codex_id
     3676         BY tt-rule-call-param.ruleset_id
     3677         BY tt-rule-call-param.order_id
     3678         BY tt-rule-call-param.param-num.
     3679     END.
     3680   END CASE.
     3681   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3682   APPLy "VALUE-CHANGED" to br-rcp.
     3683   END PROCEDURE.
     3684   PROCEDURE rcps_proc-b-chg PRIVATE :
     3685   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3686   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3687   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3688   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3689   define variable v-param-data-type as character no-undo .
     3690   define variable v-rid-list as character no-undo .
     3691   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3692     RETURN ERROR.
     3693   END.
     3694   ASSIGN
     3695   v-rec1 = rowid(X_ruledict-param)
     3696   v-rec2 = rowid(X_rp-rule-param)
     3697   v-rec3 = Rowid(tt-rule-call-param)
     3698   v-rec4 = Rowid(term_tt-rule-call-param)
     3699   .
     3700   run rcps_openbr in this-procedure .
     3701   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3702   IF ERROR-STATUS:ERROR THEN DO:
     3703     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3704   END.
     3705   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3706   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3707   END PROCEDURE.
     3708   PROCEDURE rcps_set-row-color :
     3709   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3710   ASSIGN
     3711   v-ch[1]:FGCOLOR = GREY_COLOR
     3712   v-ch[1]:BGCOLOR = GREY_Color
     3713   v-ch[1]:PFCOLOR = GREY_Color
     3714   v-ch[2]:FGCOLOR = GREY_COLOR
     3715   v-ch[2]:BGCOLOR = GREY_Color
     3716   v-ch[2]:PFCOLOR = GREY_Color
     3717   v-ch[3]:FGCOLOR = GREY_COLOR
     3718   v-ch[3]:BGCOLOR = GREY_Color
     3719   v-ch[3]:PFCOLOR = GREY_Color
     3720   v-ch[4]:FGCOLOR = GREY_COLOR
     3721   v-ch[4]:BGCOLOR = GREY_Color
     3722   v-ch[4]:PFCOLOR = GREY_Color
     3723   v-ch[5]:FGCOLOR = GREY_COLOR
     3724   v-ch[5]:BGCOLOR = GREY_Color
     3725   v-ch[5]:PFCOLOR = GREY_Color
     3726   .
     3727   CASE entry(1, p-data-type):
     3728        WHEN 'character':U THEN DO:
     3729         ASSIGN
     3730         v-ch[1]:FGCOLOR = BLACK_COLOR
     3731         v-ch[1]:BGCOLOR = WHITE_Color.
     3732       END.
     3733       WHEN 'decimal':U THEN DO:
     3734         ASSIGN
     3735         v-ch[3]:FGCOLOR = BLACK_COLOR
     3736         v-ch[3]:BGCOLOR = WHITE_Color.
     3737       END.
     3738       WHEN 'integer':U THEN DO:
     3739         ASSIGN
     3740         v-ch[4]:FGCOLOR = BLACK_COLOR
     3741         v-ch[4]:BGCOLOR = WHITE_Color.
     3742       END.
     3743       WHEN 'date':U THEN DO:
     3744         ASSIGN
     3745         v-ch[2]:FGCOLOR = BLACK_COLOR
     3746         v-ch[2]:BGCOLOR = WHITE_Color.
     3747        END.
     3748        WHEN 'logical':U THEN DO:
     3749          ASSIGN
     3750          v-ch[5]:FGCOLOR = BLACK_COLOR
     3751          v-ch[5]:BGCOLOR = WHITE_Color.
     3752        END.
     3753   END CASE.
     3754   END PROCEDURE.
     3755   MAIN-BLOCK:
     3756   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3757      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3758   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3759     run mainmenu_getcntxt in parparentproc
     3760       (output v-cntxt-db-num
     3761       ,output v-cntxt-userid
     3762       ,output v-cntxt-level
     3763       ,output v-cntxt-host-code-obj
     3764       ,output v-cntxt-obj-type
     3765       ,output v-cntxt-obj-code
     3766       ,output v-cntxt-db-num-obj
     3767       ,output v-cntxt-is-admin
     3768       ) .
     3769      run gbl/dftempl.p ( input 'rp-rule-param':U
     3770                        , output v-dflt-rec) no-error.
     3771       if error-status:error then dO:
     3772         message
     3773         vss-workfile vss-revision vss-description skip
     3774         "Невозможно найти recid template записи в таблице rp-rule-param"
     3775         view-as alert-box error .
     3776         return error.
     3777       end.
     3778       run gbl/dftempl.p ( input 'ruledict-param':U
     3779                         , output v-rp-dflt-rec) no-error.
     3780        if error-status:error then dO:
     3781          message
     3782          vss-workfile vss-revision vss-description skip
     3783          "Невозможно найти recid template записи в таблице ruledict-param"
     3784          view-as alert-box error .
     3785          return error.
     3786        end.
     3787     IF p-list-mode = 'rp-rule-param':U
     3788     THEN DO:
     3789       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3790                 buf_rule-profile.profile_id = p-profile-id.
     3791       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3792                                       ,input buffer buf_rule-profile:handle
     3793                                       ,output v-uniq-key-rec).
     3794       FIND FIRST buf_ruledict NO-LOCK WHERE
     3795                 buf_ruledict.entry-type = 'rule-profile':U
     3796          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3797       v-rcps-entry-id = buf_ruledict.entry-id.
     3798     END.
     3799     ELSE DO:
     3800        MESSAGE
     3801        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3802        VIEW-AS alert-box.
     3803     END.
     3804     if p-call-id begins 'schedule':U then do:
     3805       v-running-mode = yes.
     3806     end.
     3807     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3808     RUN Myenable in THIS-PROCEDURE.
     3809     WAIT-FOR GO OF FRAME Dialog-Frame.
     3810   END.
     3811   RUN disable_UI.
     3812   PROCEDURE disable_UI :
     3813     HIDE FRAME Dialog-Frame.
     3814   END PROCEDURE.
     3815   PROCEDURE enable_UI :
     3816     DISPLAY rs-r-b t-is-over f-rule-num f-prev-rule-num f-caller-id f-sum-id
     3817             f-nd-caller-id E-rules T-rule-sale-out T-rule-trn-out T-rule-recalc
     3818             T-rule-sale-in T-rule-trn-in l-r-b f-dis-rule-name
     3819             f-prev-dis-rule-name
     3820         WITH FRAME Dialog-Frame.
     3821     ENABLE B-exit b-quit B-Help rs-r-b t-is-over f-rule-num b-dis-rule
     3822            b-lkp-dis-rule f-prev-rule-num b-prev-dis-rule b-lkp-prev-dis-rule
     3823            f-caller-id f-sum-id b-sum-id E-rules T-rule-sale-out T-rule-trn-out
     3824            T-rule-recalc T-rule-sale-in T-rule-trn-in BR-rcp
     3825         WITH FRAME Dialog-Frame.
     3826     VIEW FRAME Dialog-Frame.
     3827   END PROCEDURE.
     3828   PROCEDURE move-up-down :
     3829   define parameter buffer source_tt-rule-call-param for tt-rule-call-param.
     3830   define input parameter p-direction as character no-undo.
     3831   define input parameter p-rule-id as integer no-undo.
     3832   define output parameter p-recid as recid no-undo.
     3833   define variable v-source as integer no-undo .
     3834   define variable v-target as integer no-undo .
     3835   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3836     if not available source_tt-rule-call-param then do:
     3837       bell.
     3838       return no-apply.
     3839     end.
     3840     assign
     3841     v-source = source_tt-rule-call-param.p-index
     3842     p-recid = recid(source_tt-rule-call-param)
     3843     .
     3844     case p-direction:
     3845       when "down" then do:
     3846         find first buf_tt-rule-call-param where
     3847              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3848          and buf_tt-rule-call-param.rule_id = p-rule-id
     3849          and buf_tt-rule-call-param.p-index > v-source no-error.
     3850       end.
     3851       when "up" then do:
     3852         find last buf_tt-rule-call-param where
     3853              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3854          and buf_tt-rule-call-param.rule_id = p-rule-id
     3855          and buf_tt-rule-call-param.p-index < v-source
     3856          and buf_tt-rule-call-param.p-index > 0
     3857          no-error.
     3858       end.
     3859     end case.
     3860     if not available buf_tt-rule-call-param then do:
     3861       bell.
     3862       return no-apply.
     3863     end.
     3864     assign
     3865     v-target = buf_tt-rule-call-param.p-index.
     3866     do transaction
     3867     on error   undo, return no-apply
     3868     on stop    undo, return no-apply
     3869     on end-key undo, return no-apply:
     3870       assign
     3871       buf_tt-rule-call-param.p-index = -99999.
     3872       release buf_tt-rule-call-param.
     3873       assign
     3874       source_tt-rule-call-param.p-index = v-target.
     3875       find first buf_tt-rule-call-param where
     3876              buf_tt-rule-call-param.param-name = "p-rule-nums"
     3877          and buf_tt-rule-call-param.rule_id = p-rule-id
     3878          and buf_tt-rule-call-param.p-index = -99999.
     3879       assign
     3880       buf_tt-rule-call-param.p-index = v-source.
     3881       release buf_tt-rule-call-param.
     3882       release source_tt-rule-call-param.
     3883     end.
     3884   END PROCEDURE.
