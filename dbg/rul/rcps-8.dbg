     4155   PROCEDURE proc-save :
     4156   define buffer buf_prop-ref for ub.prop-ref.
     4157   define variable v-ii as integer   no-undo .
     4158   DEFINE VARIABLE v-today as date no-undo .
     4159   DEFINE VARIABLE v-time as integer no-undo .
     4160   v-ii = 0.
