     1572   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1573   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1574   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1575   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1576   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1577   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1578   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1579   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1580                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1581                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1582                   ,INPUT TERM_tt-rule-call-param.p-index
     1583                   ,INPUT term_tt-rule-call-param.param-value-character
     1584                   ,INPUT term_tt-rule-call-param.param-value-date
     1585                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1586                   ,INPUT term_tt-rule-call-param.param-value-integer
     1587                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1588   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1589    THEN term_tt-rule-call-param.param-value-character
     1590    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1591   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1592   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1593   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1594   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1595   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1596   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1597   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1598   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1599   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1600   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1601   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1602   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1603   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1604       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1605            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1606   DEFINE FRAME Dialog-Frame
     1607        B-exit AT ROW 1 COL 1
     1608        b-quit AT ROW 1 COL 11
     1609        B-Help AT ROW 1 COL 95
