     4038   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     4039   REPEAT WHILE valid-handle(v-ch0):
     4040      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     4041        v-ch[1] = v-ch0.
     4042        v-ch0:VISIBLE = NO.
     4043      END.
     4044      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     4045        v-ch[2] = v-ch0.
     4046        v-ch0:VISIBLE = NO.
     4047      END.
     4048      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     4049        v-ch[3] = v-ch0.
     4050        v-ch0:VISIBLE = NO.
     4051      END.
     4052      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     4053        v-ch[4] = v-ch0.
     4054        v-ch0:VISIBLE = NO.
     4055      END.
     4056      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     4057        v-ch[5] = v-ch0.
     4058        v-ch0:VISIBLE = NO.
     4059      END.
     4060      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     4061        v-ch[6] = v-ch0.
     4062      END.
     4063      IF v-ch0:LABEL = "Значение" THEN
     4064      v-ch0:RESIZABLE = YES.
     4065      v-ch0 = v-ch0:NEXT-COLUMN.
     4066   END.
