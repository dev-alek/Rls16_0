        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-dt-code as integer no-undo .
        6   define input parameter        p-sum-id as character no-undo .
        7   define input parameter        p-dtm-code as integer no-undo .
        8   define input parameter        p-call-id as character no-undo .
        9   define input parameter        p-ref-type as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Сохранение prop-ref".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   FUNCTION propreft-Date-to-String returns character(input  p-date as date):
       87   define variable v-date-str as character no-undo .
       88   assign
       89   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
       90                string(Month(p-date), "99":U) + chr(47) +
       91                string(DAY(p-date), "99":U).
       92   return v-date-str.
       93   END FUNCTION.
       94   function propreft-string-to-date returns date ( input p-string  as character):
       95     define variable v-date as date no-undo .
       96     assign
       97     v-date = date(integer(substring(p-string, 6, 2))
       98                   ,integer(substring(p-string, 9, 2))
       99                   ,integer(substring(p-string, 1, 4))
      100                  ) no-error .
      101     if error-status:error then return ?.
      102     return v-date.
      103   END FUNCTION.
      104   FUNCTION propreft-petrol-to-String returns character(input  p-gds-code as integer):
      105   define variable v-date-str as character no-undo .
      106   assign
      107   v-date-str = substitute("petrol-&1", p-gds-code).
      108   return v-date-str.
      109   END FUNCTION.
      110   FUNCTION propreft-string-to-petrol returns integer(input  p-string as character):
      111   define variable v-gds-code as integer no-undo .
      112   assign
      113   v-gds-code = integer(entry(2, p-string, "-")) no-error.
      114   return v-gds-code.
      115   END FUNCTION.
      116   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   procedure cur-time :
      118      define output parameter p-today as date      no-undo .
      119      define output parameter p-time  as integer   no-undo .
      120     do
      121     on error undo, return error
      122     :
      123       define variable v-date1 as date      no-undo .
      124       define variable v-date2 as date      no-undo .
      125       define variable v-time  as integer   no-undo .
      126       assign
      127         v-date1 = today
      128         v-time  = time
      129         v-date2 = today
      130       .
      131       if v-date1 <> v-date2
      132       then do:
      133         assign
      134           v-date1 = today
      135           v-time  = v-time
      136         .
      137       end.
      138       assign
      139         p-today = v-date1
      140         p-time  = v-time
      141       .
      142     end.
      143   end.
      144   function cur-time-date returns character
      145   :
      146     return string(today, '99/99/9999':U) .
      147   end.
      148   function cur-time-mjd returns decimal
      149   :
      150     define variable v-date as date      no-undo .
      151     define variable v-time as integer   no-undo .
      152     run cur-time in this-procedure
      153       (output v-date
      154       ,output v-time
      155       ) .
      156     return integer(v-date) - 2400002 + (v-time / 86400) .
      157   end.
      158   function cur-time-get-ending-index returns integer
      159   (input p-number as integer
      160   )
      161   :
      162     if p-number < 0
      163     or p-number = ?
      164     then do:
      165       return 1 .
      166     end.
      167     define variable v-rest as integer   no-undo .
      168     assign
      169       p-number = p-number modulo 100
      170     .
      171     if p-number < 20
      172     then do:
      173       assign
      174         v-rest = p-number
      175       .
      176     end.
      177     else do:
      178       assign
      179         v-rest = p-number modulo 10
      180       .
      181     end.
      182     case v-rest :
      183       when 1
      184       then do:
      185         return 2 .
      186       end.
      187       when 2 or
      188       when 3 or
      189       when 4
      190       then do:
      191         return 3 .
      192       end.
      193       otherwise do:
      194         return 1 .
      195       end.
      196     end case .
      197   end.
      198   procedure cur-time-mjd-to-date :
      199      define input  parameter i-mjd-diff as decimal no-undo.
      200      define output parameter o-Date     as date    no-undo.
      201      define output parameter o-Time     as integer no-undo.
      202      define variable v-day-number as integer   no-undo .
      203      if    i-mjd-diff < 0
      204         or i-mjd-diff = ?
      205      then do:
      206         return "?" .
      207      end.
      208      assign
      209         v-day-number = truncate(i-mjd-diff,0).
      210         o-Date = date(v-day-number + 2400002).
      211         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      212     .
      213   end.
      214   function cur-time-mjd-to-string returns character
      215   (input p-mjd-diff as decimal
      216   )
      217   :
      218     define variable v-day-number as integer   no-undo .
      219     define variable v-seconds    as integer   no-undo .
      220     define variable v-hour       as integer   no-undo .
      221     define variable v-min        as integer   no-undo .
      222     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      223     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      224     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      225     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      226     if p-mjd-diff < 0
      227     or p-mjd-diff = ?
      228     then do:
      229       return "?" .
      230     end.
      231     assign
      232       v-day-number = integer(truncate(p-mjd-diff,0))
      233       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      234     .
      235     if v-seconds > 86400
      236     then do:
      237       assign
      238         v-seconds = 86400 - 1
      239       .
      240     end.
      241     if v-seconds < 0
      242     then do:
      243       assign
      244         v-seconds = 0
      245       .
      246     end.
      247     assign
      248       v-hour = truncate(v-seconds / 3600, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 3600
      252     .
      253     assign
      254       v-min = truncate(v-seconds / 60, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 60
      258     .
      259     return
      260         (if v-day-number <> 0
      261           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      262           else ""
      263         )
      264       + (if v-day-number <> 0 or v-hour <> 0
      265           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      266           else ""
      267         )
      268       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      269           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      270           else ""
      271         )
      272       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      273       .
      274   end.
      275   function cur-time-string returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-string-sec returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      294   end.
      295   function cur-time-custom  returns character
      296   (input p-prefix as character
      297   ,input p-date-format as character
      298   ,input p-delimiter as character
      299   ,input p-time-format as character
      300   ,input p-suffix as character
      301   )
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return
      310       p-prefix
      311       + string(v-date, p-date-format)
      312       + p-delimiter
      313       + string(v-time, p-time-format)
      314       + p-suffix
      315       .
      316   end.
      317   function cur-time-print  returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      326   end.
      327   function cur-time-datetime returns datetime
      328   :
      329     define variable v-char as character no-undo .
      330     define variable v-datetime as datetime no-undo .
      331     v-char = cur-time-string().
      332     v-datetime = datetime(v-char).
      333     return  v-datetime.
      334   end.
      335   function cur-time-string-msec returns character
      336   :
      337     define variable v-date as datetime  no-undo .
      338     v-date = now.
      339     return string(v-date) .
      340   end.
      341   define variable v-mess as character no-undo .
      342   define variable v-entry as character no-undo .
      343   define variable v-dis-card-storage as character no-undo .
      344   DEFINE VARIABLE v-today as date no-undo .
      345   DEFINE VARIABLE v-time as integer no-undo .
      346   define buffer buf_prop-ref for ub.prop-ref.
      347   define buffer buf2_prop-ref for ub.prop-ref.
      348   define buffer buf_prop-head for ub.prop-head.
      349   if p-mode <> 'ДОБАВЛЕНИЕ':U
      350   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      351     message vss-workfile vss-revision vss-description skip
      352             "Неверный параметр p-mode - " p-mode
      353     view-as alert-box error .
      354     return error '':u.
      355   end.
      356   if g#db-num <> 0 then do:
      357     message vss-workfile vss-revision vss-description skip
      358             "Запрещено вызывать процедуру в УБД"
      359     view-as alert-box error .
      360     return error '':u.
      361   end.
      362   _main:
      363   do for buf_prop-ref
      364   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      365   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      366   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      367   :
      368     assign
      369     v-dis-card-storage = '':U + chr(44) +
      370                          chr(63) + chr(44) +
      371                          'dis-card':U + chr(44) +
      372                          'dis-obj':U + chr(44) +
      373                          'dis-card-property':U.
      374     if p-dtm-code = 0 then do:
      375       assign
      376       v-mess = substitute("Неверный объект-операнд  с кодом &1", p-dtm-code).
      377       run err-mess in this-procedure ( input-output v-mess).
      378       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      379     end.
      380     find first buf_prop-head no-lock where
      381               buf_prop-head.dtm-code  = p-dtm-code no-error.
      382     if not available buf_prop-head then do:
      383       assign
      384       v-mess = substitute("Не найден объект-операнд  с кодом &1", p-dtm-code).
      385       run err-mess in this-procedure ( input-output v-mess).
      386       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      387     end.
      388     if lookup(buf_prop-head.storage-place, v-dis-card-storage) = 0
      389     and lookup(buf_prop-head.storage-place-host, v-dis-card-storage) = 0
      390     and lookup(buf_prop-head.storage-place-obj, v-dis-card-storage) = 0 then do:
      391       assign
      392       v-mess = substitute("Объект-операнд  с кодом &1 не предназначен для хранения данных по ДК", p-dtm-code).
      393       run err-mess in this-procedure ( input-output v-mess).
      394       return error (if p-silent = yes then v-mess else 'dtm-code':U).
      395     end.
      396     if p-sum-id = '':u
      397     then do:
      398       assign
      399       v-mess = substitute("Мнемонический идентификатор может быть пустым только&1" +
      400                          "для основного среза - с кодом 0").
      401       run err-mess in this-procedure ( input-output v-mess).
      402       return error (if p-silent = yes then v-mess else 'sum-id':U).
      403     end.
      404     if lookup(p-ref-type, 'blank,period,sel-goods,one-ptrl':U) = 0 then do:
      405       assign
      406       v-mess = substitute("Неверный тип идентификатора &1", p-ref-type).
      407       run err-mess in this-procedure ( input-output v-mess).
      408       return error (if p-silent = yes then v-mess else 'ref-type':U).
      409     end.
      410     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      411       if p-dt-code = 0 then do:
      412         find last buf_prop-ref no-lock use-index pi no-error.
      413         assign
      414         p-dt-code = buf_prop-ref.dt-code + 1.
      415       end.
      416       else do:
      417         find first buf_prop-ref no-lock where
      418               buf_prop-ref.dt-code = p-dt-code no-error.
      419         if available buf_prop-ref then do:
      420           assign
      421           v-mess = "Уже существует Срез c таким кодом".
      422           run err-mess in this-procedure ( input-output v-mess).
      423           return error (if p-silent = yes then v-mess else 'dt-code':U).
      424         end.
      425       end.
      426       find first buf2_prop-ref no-lock where
      427                 buf2_prop-ref.dtm-code = p-dtm-code
      428            and  buf2_prop-ref.sum-id = p-sum-id
      429            and buf2_prop-ref.caller_id = p-call-id no-error.
      430       if available buf2_prop-ref then do:
      431         assign
      432         v-mess = substitute("Уже существует Срез c таким мнемонич идентификатором  &1 и кодом объекта &2 и доп.идентификатором &3"
      433                               ,p-sum-id
      434                               ,p-dtm-code
      435                               ,p-call-id).
      436         run err-mess in this-procedure ( input-output v-mess).
      437         return error (if p-silent = yes then v-mess else 'dtm-code':U).
      438       end.
      439       if p-ref-type = 'period':U then do:
      440         define variable v-date-from as date no-undo .
      441         define variable v-date-to as date no-undo .
      442         define variable v-date-from2 as date no-undo .
      443         define variable v-date-to2 as date no-undo .
      444         assign
      445         v-date-from = propreft-string-to-date( entry(1, p-sum-id, "-"))
      446         v-date-to = propreft-string-to-date( entry(2, p-sum-id, "-"))
      447         .
      448         run cur-time in this-procedure ( output v-today, output v-time).
      449         if v-date-from <= v-today then do:
      450           assign
      451           v-mess = substitute("Нельзя ввести частный итог для текущего периода времени").
      452           run err-mess in this-procedure ( input-output v-mess).
      453           return error (if p-silent = yes then v-mess else 'dtm-code':U).
      454         end.
      455         for each buf2_prop-ref no-lock where
      456                   buf2_prop-ref.dtm-code = p-dtm-code
      457               and buf2_prop-ref.caller_id = p-call-id:
      458           assign
      459           v-date-from2 = propreft-string-to-date( entry(1, buf2_prop-ref.sum-id, "-"))
      460           v-date-to2 = propreft-string-to-date( entry(2,  buf2_prop-ref.sum-id, "-"))
      461           .
      462           if v-date-from <= v-date-from2
      463           and v-date-to >= v-date-to2
      464           then leave.
      465           if v-date-from >= v-date-from2
      466           and v-date-to <= v-date-to2
      467           then leave.
      468           if v-date-from <= v-date-from2
      469           and v-date-to >= v-date-from2
      470           and v-date-to <= v-date-to2
      471           then leave.
      472           if v-date-from >= v-date-from2
      473           and v-date-from <= v-date-to2
      474           and v-date-to >= v-date-to2
      475           then leave.
      476         end.
      477         if available buf2_prop-ref then do:
      478           assign
      479           v-mess = substitute("Уже существует Срез &1 c кодом объекта &2 и доп.идентификатором &3, который захватывает период дат &4"
      480                                 ,buf2_prop-ref.dt-code
      481                                 ,p-dtm-code
      482                                 ,p-call-id
      483                                 ,p-sum-id
      484                                 ).
      485           run err-mess in this-procedure ( input-output v-mess).
      486           return error (if p-silent = yes then v-mess else 'dtm-code':U).
      487         end.
      488       end.
      489       create buf_prop-ref.
      490       assign
      491       buf_prop-ref.dt-code = p-dt-code
      492       .
      493     end.
      494     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      495       find first buf_prop-ref exclusive-lock where
      496                 recid(buf_prop-ref) = p-rec .
      497       if buf_prop-ref.dt-code <> p-dt-code
      498       then do:
      499         assign
      500         v-mess = substitute("Для уже существующего среза невозможно изменение кода&1" +
      501                                 "старые значения кода: &2"
      502                                 , chr(10)
      503                                 , buf_prop-ref.dt-code)
      504         .
      505         run err-mess in this-procedure ( input-output v-mess).
      506         return error (if p-silent = yes then v-mess else 'dt-code':U).
      507       end.
      508     end.
      509     assign
      510     buf_prop-ref.sum-id  = p-sum-id
      511     buf_prop-ref.dtm-code  = p-dtm-code
      512     buf_prop-ref.caller_id  = p-call-id
      513     buf_prop-ref.ref-type  = p-ref-type
      514     p-rec = recid(buf_prop-ref)
      515     .
      516   end.
      517   PROCEDURE err-mess:
      518     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      519     CASE p-silent:
      520       when yes then do:
      521         assign
      522         p-mess = substitute("Срез данных по ДК код: &1 &2"
      523                            , p-dtm-code
      524                            , p-mess)
      525         .
      526       end.
      527       when no then do:
      528         message
      529         p-mess
      530         view-as alert-box error .
      531       end.
      532     end.
      533   END PROCEDURE.
