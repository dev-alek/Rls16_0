     1050   procedure create-smart-route-link :
     1051   define input parameter p-tbl-name as character no-undo .
     1052   define input parameter p-bh_tbl-name as handle no-undo .
     1053   define input parameter p-key-field as character no-undo .
     1054   define input parameter p-rec-ord as integer no-undo .
     1055   define input parameter p-is-smart as logical no-undo .
