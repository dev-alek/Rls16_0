      161   procedure garbcoll_create-gc-entry :
      162   define input parameter p-cn as character no-undo .
      163   define input parameter p-obj-r as handle no-undo .
      164     do
      165     on error undo, return error
      166     :
      167       create temp-gc.
      168       assign
      169       temp-gc.ii = garbcoll_ii
      170       garbcoll_ii = garbcoll_ii + 1
      171       temp-gc.cn = p-cn
      172       temp-gc.obj-r = p-obj-r
      173       .
      174     end.
      175   end procedure.
      176   procedure garbcoll_clear :
      177     do
      178     on error undo, return error
      179     :
      180       for each temp-gc:
      181         delete object temp-gc.obj-r.
      182         delete temp-gc.
      183       end.
      184     end.
      185   end procedure.
      186   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      187   procedure cur-time :
      188      define output parameter p-today as date      no-undo .
      189      define output parameter p-time  as integer   no-undo .
      190     do
      191     on error undo, return error
      192     :
      193       define variable v-date1 as date      no-undo .
      194       define variable v-date2 as date      no-undo .
      195       define variable v-time  as integer   no-undo .
      196       assign
      197         v-date1 = today
      198         v-time  = time
      199         v-date2 = today
      200       .
      201       if v-date1 <> v-date2
      202       then do:
      203         assign
      204           v-date1 = today
      205           v-time  = v-time
      206         .
      207       end.
      208       assign
      209         p-today = v-date1
      210         p-time  = v-time
      211       .
      212     end.
      213   end.
      214   function cur-time-date returns character
      215   :
      216     return string(today, '99/99/9999':U) .
      217   end.
      218   function cur-time-mjd returns decimal
      219   :
      220     define variable v-date as date      no-undo .
      221     define variable v-time as integer   no-undo .
      222     run cur-time in this-procedure
      223       (output v-date
      224       ,output v-time
      225       ) .
      226     return integer(v-date) - 2400002 + (v-time / 86400) .
      227   end.
      228   function cur-time-get-ending-index returns integer
      229   (input p-number as integer
      230   )
      231   :
      232     if p-number < 0
      233     or p-number = ?
      234     then do:
      235       return 1 .
      236     end.
      237     define variable v-rest as integer   no-undo .
      238     assign
      239       p-number = p-number modulo 100
      240     .
      241     if p-number < 20
      242     then do:
      243       assign
      244         v-rest = p-number
      245       .
      246     end.
      247     else do:
      248       assign
      249         v-rest = p-number modulo 10
      250       .
      251     end.
      252     case v-rest :
      253       when 1
      254       then do:
      255         return 2 .
      256       end.
      257       when 2 or
      258       when 3 or
      259       when 4
      260       then do:
      261         return 3 .
      262       end.
      263       otherwise do:
      264         return 1 .
      265       end.
      266     end case .
      267   end.
      268   procedure cur-time-mjd-to-date :
      269      define input  parameter i-mjd-diff as decimal no-undo.
      270      define output parameter o-Date     as date    no-undo.
      271      define output parameter o-Time     as integer no-undo.
      272      define variable v-day-number as integer   no-undo .
      273      if    i-mjd-diff < 0
      274         or i-mjd-diff = ?
      275      then do:
      276         return "?" .
      277      end.
      278      assign
      279         v-day-number = truncate(i-mjd-diff,0).
      280         o-Date = date(v-day-number + 2400002).
      281         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      282     .
      283   end.
      284   function cur-time-mjd-to-string returns character
      285   (input p-mjd-diff as decimal
      286   )
      287   :
      288     define variable v-day-number as integer   no-undo .
      289     define variable v-seconds    as integer   no-undo .
      290     define variable v-hour       as integer   no-undo .
      291     define variable v-min        as integer   no-undo .
      292     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      293     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      294     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      295     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      296     if p-mjd-diff < 0
      297     or p-mjd-diff = ?
      298     then do:
      299       return "?" .
      300     end.
      301     assign
      302       v-day-number = integer(truncate(p-mjd-diff,0))
      303       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      304     .
      305     if v-seconds > 86400
      306     then do:
      307       assign
      308         v-seconds = 86400 - 1
      309       .
      310     end.
      311     if v-seconds < 0
      312     then do:
      313       assign
      314         v-seconds = 0
      315       .
      316     end.
      317     assign
      318       v-hour = truncate(v-seconds / 3600, 0)
      319     .
      320     assign
      321       v-seconds = v-seconds modulo 3600
      322     .
      323     assign
      324       v-min = truncate(v-seconds / 60, 0)
      325     .
      326     assign
      327       v-seconds = v-seconds modulo 60
      328     .
      329     return
      330         (if v-day-number <> 0
      331           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      332           else ""
      333         )
      334       + (if v-day-number <> 0 or v-hour <> 0
      335           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      336           else ""
      337         )
      338       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      339           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      340           else ""
      341         )
      342       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      343       .
      344   end.
      345   function cur-time-string returns character
      346   :
      347     define variable v-date as date      no-undo .
      348     define variable v-time as integer   no-undo .
      349     run cur-time in this-procedure
      350       (output v-date
      351       ,output v-time
      352       ) .
      353     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      354   end.
      355   function cur-time-string-sec returns character
      356   :
      357     define variable v-date as date      no-undo .
      358     define variable v-time as integer   no-undo .
      359     run cur-time in this-procedure
      360       (output v-date
      361       ,output v-time
      362       ) .
      363     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      364   end.
      365   function cur-time-custom  returns character
      366   (input p-prefix as character
      367   ,input p-date-format as character
      368   ,input p-delimiter as character
      369   ,input p-time-format as character
      370   ,input p-suffix as character
      371   )
      372   :
      373     define variable v-date as date      no-undo .
      374     define variable v-time as integer   no-undo .
      375     run cur-time in this-procedure
      376       (output v-date
      377       ,output v-time
      378       ) .
      379     return
      380       p-prefix
      381       + string(v-date, p-date-format)
      382       + p-delimiter
      383       + string(v-time, p-time-format)
      384       + p-suffix
      385       .
      386   end.
      387   function cur-time-print  returns character
      388   :
      389     define variable v-date as date      no-undo .
      390     define variable v-time as integer   no-undo .
      391     run cur-time in this-procedure
      392       (output v-date
      393       ,output v-time
      394       ) .
      395     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      396   end.
      397   function cur-time-datetime returns datetime
      398   :
      399     define variable v-char as character no-undo .
      400     define variable v-datetime as datetime no-undo .
      401     v-char = cur-time-string().
      402     v-datetime = datetime(v-char).
      403     return  v-datetime.
      404   end.
      405   function cur-time-string-msec returns character
      406   :
      407     define variable v-date as datetime  no-undo .
      408     v-date = now.
      409     return string(v-date) .
      410   end.
