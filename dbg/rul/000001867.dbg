     1748   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1749   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1750   define buffer buf_temp-cmd for temp-cmd.
     1751   define buffer buf_dis-card-sale_obj for temp-d-card.
     1752   define variable vh_dis-card-sale_obj as handle no-undo .
     1753    define variable p-esys-id as integer no-undo.
     1754    define variable p-xsd-file as character no-undo.
     1755   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1756   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1757   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1758   function context_begin-esys-command return logical
     1759   (
     1760       input p-esys-id-list as character
     1761      ,input-output p-esys-cmd-proc-handle as handle
     1762      ,output p-esys-cmd-code as integer
     1763   ):
     1764      if not valid-handle(p-esys-cmd-proc-handle )
     1765      then do:
     1766        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1767        if error-status :error
     1768        then do:
     1769           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1770                                              "&5&4&6"
     1771                                              ,vss-workfile
     1772                                              ,vss-revision
     1773                                              ,vss-description
     1774                                              ,chr(10)
     1775                                              ,error-status:get-message(1)
     1776                                              ,return-value )).
     1777        end.
     1778        run begin-create-command in p-esys-cmd-proc-handle
     1779          (input 'cmd-esys-general':U
     1780          ,input p-esys-id-list
     1781          ,output p-esys-cmd-code
     1782          ) no-error.
     1783        if error-status :error
     1784        then do:
     1785          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1786                                                           , 'cmd-esys-general':U
     1787                                                           , error-status:get-message(1)
     1788                                                           , return-value
     1789                                                           )).
     1790          return no .
     1791        end.
     1792        return yes.
     1793      end.
     1794   end.
     1795   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1796   function context_send-esys-command return logical
     1797   (
     1798       input p-esys-id-list as character
     1799      ,input p-esys-cmd-proc-handle as handle
     1800      ,input p-esys-cmd-code as integer
     1801      ,input p-user-id as character
     1802   ):
     1803      define variable v-dmp-ord-int64 as int64 no-undo .
     1804      if valid-handle(p-esys-cmd-proc-handle )
     1805      then do:
     1806         run send-command-esys in p-esys-cmd-proc-handle
     1807             (input p-esys-cmd-code
     1808             ,input p-esys-id-list
     1809             ,input p-user-id
     1810             ,output v-dmp-ord-int64
     1811             ) no-error.
     1812         if error-status :error
     1813         then do:
     1814            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1815                                                           , p-esys-id-list
     1816                                                           , p-cmd-code
     1817                                                           , chr(10)
     1818                                                           , error-status:get-message(1)
     1819                                                           , return-value
     1820                                                           )).
     1821            return no .
     1822         end.
     1823         delete procedure p-esys-cmd-proc-handle no-error.
     1824         return yes.
     1825      end.
     1826      else do:
     1827         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1828                                                       , p-esys-id-list
     1829                                                       , p-cmd-code
     1830                                                       , chr(10)
     1831                                                       , error-status:get-message(1)
     1832                                                       , return-value
     1833                                                       )).
     1834         return no .
     1835      end.
     1836   end.
     1837   on delete of this-procedure do:
     1838     run garbcoll_clear in this-procedure .
     1839   end.
     1840   run load-ruleset-context in this-procedure ( input p-ruleset-id).
     1841    define variable Card1 as class Dis-card_ no-undo .
     1842   Card1 = new Dis-card_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     1843    define variable Chk1 as class Dis-chk-doc_obj no-undo .
     1844   Chk1 = new Dis-chk-doc_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-cont-handle, input v-current-lock, input v-current-wait, input v-save) .
     1845    define variable ExpData1 as class Route-data_ no-undo .
     1846   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     1847    define variable Sale-sums as class Dis-card-sale_obj no-undo .
     1848   Sale-sums = new Dis-card-sale_obj( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input vh_dis-card-sale_obj, input p-codex-id, input p-ruleset-id) .
     1849   if not this-procedure:persistent then do:
     1850     run proc-main in this-procedure ( input p-type
     1851                                 ,input p-emitent-host-code ) no-error .
     1852     if error-status:error then do:
     1853         run garbcoll_clear in this-procedure .
     1854         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1855     end.
     1856     run garbcoll_clear in this-procedure .
     1857   end.
     1858   procedure proc-main :
     1859   define input parameter p-type like ub.dis-card.type no-undo .
     1860   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1861   _main:
     1862   do
     1863   on error undo, return error return-value
     1864   :
     1865   assign
     1866   v-emitent-host-code = p-emitent-host-code
     1867   v-type = p-type.
     1868     _d-card:
     1869     for each temp-d-card where
     1870             temp-d-card.type = p-type
     1871         and temp-d-card.emitent-host-code = p-emitent-host-code
     1872     break
     1873     by temp-d-card.d-card
     1874     On error undo _d-card, retry _d-card:
     1875       if temp-d-card.d-card = '_' then next.
     1876       num-rec = num-rec + 1.
     1877       if retry then do:
     1878         if p-ruleset-id = 5 then do:
     1879           num-rec-calc-err = num-rec-calc-err + 1.
     1880           undo _d-card, next _d-card .
     1881         end.
     1882         else do:
     1883           undo _main, return error return-value .
     1884         end.
     1885       end.
     1886       assign
     1887       v-current-d-card = temp-d-card.d-card
     1888       .
     1889   _1867:
     1890   do:
     1891   IF  num-rec = 1  THEN do:
     1892     _1868:
     1893     do:
     1894     IF  v-current-doc-type <> 'trn-doc':U  THEN do:
     1895       _1869:
     1896       do:
     1897        leave _1867 .
     1898       end.
     1899     end.
     1900     IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     1901       _1870:
     1902       do:
     1903        undo _main, return error v-last-error-message .
     1904       end.
     1905     end.
     1906     IF  context_begin-esys-command( input string(p-esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     1907       _1892:
     1908       do:
     1909        undo _main, return error v-last-error-message .
     1910       end.
     1911     end.
     1912     end.
     1913   end.
     1914   IF  Card1:find_dis-card_( INPUT v-current-d-card) = true  THEN do:
     1915     _1871:
     1916     do:
     1917     IF  temp-d-card.sale-type = 'inkas':U  THEN do:
