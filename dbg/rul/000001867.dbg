      101   define new global shared variable g#vssrevis-logger as handle    no-undo .
      102   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      103   define variable v-vssrevis-logger                   as handle    no-undo .
      104   procedure vss-logevent :
      105     define input  parameter p-extra-paramters as character no-undo .
      106     define variable v-vssrevis-parameters as character no-undo .
      107     do
      108     on error undo, return error return-value
      109     :
      110       if  valid-handle(v-vssrevis-logger)
      111       and v-vssrevis-logger :get-signature("logevent") <> ""
      112       then do:
      113         run vss-get-parameters in this-procedure
      114           (output v-vssrevis-parameters
      115           ).
      116         run logevent in v-vssrevis-logger
      117           (input vss-workfile
      118           ,input vss-revision
      119           ,input v-vssrevis-parameters
      120           ,input p-extra-paramters
      121           ).
      122       end.
      123     end.
      124   end procedure.
      125   assign
      126     v-vssrevis-logger = g#vssrevis-logger
      127   .
      128   if  valid-handle(v-vssrevis-logger)
      129   and v-vssrevis-logger :get-signature("logevent") <> ""
      130   then do:
      131     assign
      132       v-vssrevis-logevent = true
      133     .
      134     run vss-logevent in this-procedure (input vss-description) .
      135   end.
