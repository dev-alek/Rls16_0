     2054   procedure load-ruleset-context :
     2055   define input parameter p-ruleset-id as integer no-undo .
     2056   define buffer buf_rule-call-param for ub.rule-call-param.
     2057     do
     2058     on error undo, return error
     2059     :
     2060    find first buf_rule-call-param no-lock where
     2061   buf_rule-call-param.codex_id = p-codex-id
     2062   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2063   and buf_rule-call-param.call_id = p-call-id
     2064   and buf_rule-call-param.order_id = p-order-id
     2065   and buf_rule-call-param.rule_id = p-rule-id
     2066   and buf_rule-call-param.param-name = "p-esys-id"
     2067    no-error.
     2068   if available buf_rule-call-param then do:
     2069   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2070   end.
     2071    find first buf_rule-call-param no-lock where
     2072   buf_rule-call-param.codex_id = p-codex-id
     2073   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2074   and buf_rule-call-param.call_id = p-call-id
     2075   and buf_rule-call-param.order_id = p-order-id
     2076   and buf_rule-call-param.rule_id = p-rule-id
     2077   and buf_rule-call-param.param-name = "p-xsd-file"
     2078    no-error.
     2079   if available buf_rule-call-param then do:
     2080   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2081   end.
     2082       assign
     2083       vh_dis-card-sale_obj = buffer temp-d-card:handle
     2084       v-save = p-save
     2085       v-current-doc-type = p-doc-type
     2086       .
     2087       case p-ruleset-id:
     2088         when 1 then do:
     2089           assign
     2090           v-sign = 1
     2091           v-current-host-code = p-host-code
     2092           v-current-obj-type = p-obj-type
     2093           v-current-obj-code = p-obj-code
     2094           v-current-db-num = g#db-num
     2095           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2096           v-current-doc-code = p-doc-code
     2097           v-current-doc-date = p-doc-date
     2098           v-current-doc-fact-date = p-fact-date
     2099           v-current-date = p-doc-date
     2100           v-current-fact-date = p-fact-date
     2101           .
     2102         end.
     2103         when 2 then do:
     2104           assign
     2105           v-sign = -1
     2106           v-current-host-code = p-host-code
     2107           v-current-obj-type = p-obj-type
     2108           v-current-obj-code = p-obj-code
     2109           v-current-db-num = g#db-num
     2110           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2111           v-current-doc-code = p-doc-code
     2112           v-current-doc-date = p-doc-date
     2113           v-current-doc-fact-date = p-fact-date
     2114           v-current-date = p-doc-date
     2115           v-current-fact-date = p-fact-date
     2116           .
     2117         end.
     2118         when 3 or
     2119         when 6 then do:
     2120           assign
     2121           v-sign = 1
     2122           v-current-host-code = p-host-code
     2123           v-current-obj-type = p-obj-type
     2124           v-current-obj-code = p-obj-code
     2125           v-current-db-num = g#db-num
     2126           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2127           v-current-doc-code = p-doc-code
     2128           v-current-doc-date = p-doc-date
     2129           v-current-doc-time = 0
     2130           v-current-doc-fact-date = p-fact-date
     2131           v-current-date = p-doc-date
     2132           v-current-fact-date = p-fact-date
     2133           .
     2134         end.
     2135         when 4 then do:
     2136           assign
     2137           v-sign = -1
     2138           v-current-host-code = p-host-code
     2139           v-current-obj-type = p-obj-type
     2140           v-current-obj-code = p-obj-code
     2141           v-current-db-num = g#db-num
     2142           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2143           v-current-doc-code = p-doc-code
     2144           v-current-doc-date = p-doc-date
     2145           v-current-doc-time = 0
     2146           v-current-doc-fact-date = p-fact-date
     2147           v-current-date = p-doc-date
     2148           v-current-fact-date = p-fact-date
     2149           .
     2150         end.
     2151         when 5 then do:
     2152           assign
     2153           v-sign = 1
     2154           v-current-host-code = p-host-code
     2155           v-current-obj-type = p-obj-type
     2156           v-current-obj-code = p-obj-code
     2157           v-current-db-num = g#db-num
     2158           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2159           v-current-doc-code = p-doc-code
     2160           v-current-doc-date = p-doc-date
     2161           v-current-doc-time = 0
     2162           v-current-doc-fact-date = p-fact-date
     2163           v-current-date = p-doc-date
     2164           v-current-fact-date = p-fact-date
     2165           .
     2166         end.
     2167         when 7
     2168         or when 9
     2169         then do:
     2170           assign
     2171           v-sign = 1
     2172           v-current-host-code = p-host-code
     2173           v-current-obj-type = p-obj-type
     2174           v-current-obj-code = p-obj-code
     2175           v-current-db-num = g#db-num
     2176           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2177           v-current-doc-code = p-doc-code
     2178           v-current-doc-date = p-doc-date
     2179           v-current-doc-time = 0
     2180           v-current-doc-fact-date = p-fact-date
     2181           v-current-date = p-doc-date
     2182           v-current-fact-date = p-fact-date
     2183           .
     2184         end.
     2185       end case.
     2186     end.
     2187   end procedure.
