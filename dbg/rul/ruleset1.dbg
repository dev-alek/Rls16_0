        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-codex-id as integer no-undo .
        6   define input parameter        p-ruleset-id as integer no-undo .
        7   define input parameter        p-name       as character no-undo .
        8   define input parameter        p-documentation as character no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Сохранение ruleset".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable v-mess as character no-undo .
       85   define variable v-entry as character no-undo .
       86   define buffer buf_ruleset for ub.ruleset.
       87   if p-mode <> 'ДОБАВЛЕНИЕ':U
       88   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       89     message vss-workfile vss-revision vss-description skip
       90             "Неверный параметр p-mode - " p-mode
       91     view-as alert-box error .
       92     return error '':u.
       93   end.
       94   if g#db-num <> 0 then do:
       95     message vss-workfile vss-revision vss-description skip
       96             "Запрещено вызывать процедуру в УБД"
       97     view-as alert-box error .
       98     return error '':u.
       99   end.
      100   _main:
      101   do for buf_ruleset
      102   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      103   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      104   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      105   :
      106     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      107       find first buf_ruleset no-lock where
      108                 buf_ruleset.codex_id = p-codex-id
      109             and buf_ruleset.ruleset_id = p-ruleset-id no-error.
      110       if available buf_ruleset then do:
      111         assign
      112         v-mess = "Уже существует ruleset c таким кодексом и набором правил".
      113         run err-mess in this-procedure ( input-output v-mess).
      114         return error (if p-silent = yes then v-mess else '':U).
      115       end.
      116       if p-ruleset-id <> 0 then do:
      117         find first buf_ruleset no-lock where
      118                   buf_ruleset.codex_id = p-codex-id
      119               and buf_ruleset.ruleset_id = 0 no-error.
      120         if not available buf_ruleset then do:
      121           assign
      122           v-mess = substitute("Не существует КОДЕКС &1", p-codex-id).
      123           run err-mess in this-procedure ( input-output v-mess).
      124           return error (if p-silent = yes then v-mess else '':U).
      125         end.
      126       end.
      127       create buf_ruleset.
      128       assign
      129       buf_ruleset.codex_id = p-codex-id
      130       buf_ruleset.ruleset_id = p-ruleset-id
      131       .
      132     end.
      133     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      134       find first buf_ruleset exclusive-lock where
      135                 recid(buf_ruleset) = p-rec .
      136       if buf_ruleset.codex_id <> p-codex-id
      137       or buf_ruleset.ruleset_id <> p-ruleset-id
      138       then do:
      139         assign
      140         v-mess = substitute("Для уже существующего ruleset невозможно изменеие кодекса и набора правил&1" +
      141                                 "старые значения кодекса и набора правил: &2 и &3"
      142                                 , chr(10)
      143                                 , buf_ruleset.codex_id
      144                                 , buf_ruleset.ruleset_id)
      145         .
      146         run err-mess in this-procedure ( input-output v-mess).
      147         return error (if p-silent = yes then v-mess else '':U).
      148       end.
      149     end.
      150     assign
      151     buf_ruleset.name = p-name
      152     buf_ruleset.documentation = p-documentation
      153     p-rec = recid(buf_ruleset)
      154     .
      155   end.
      156   PROCEDURE err-mess:
      157     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      158     CASE p-silent:
      159       when yes then do:
      160         assign
      161         p-mess = substitute("Кодекс правил: &1 набор правил: &2: &3"
      162                            , p-codex-id
      163                            , p-ruleset-id
      164                            , p-mess)
      165         .
      166       end.
      167       when no then do:
      168         message
      169         p-mess
      170         view-as alert-box error .
      171       end.
      172     end.
      173   END PROCEDURE.
