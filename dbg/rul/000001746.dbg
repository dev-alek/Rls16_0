     1984                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1985                                   else -1 )
     1986       buf_temp-hist-nws-option.table-name = 'dis-host':U
     1987       buf_temp-hist-nws-option.key#_one = 2
     1988       buf_temp-hist-nws-option.charkey_one = p-type
     1989       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1990       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1991       .
