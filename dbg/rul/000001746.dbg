     2687           v-current-doc-fact-date = p-fact-date
     2688           v-current-date = p-doc-date
     2689           v-current-fact-date = p-fact-date
     2690           .
     2691         end.
     2692         when 7
     2693         or when 9
     2694         then do:
     2695           assign
     2696           v-sign = 1
     2697           v-current-host-code = p-host-code
     2698           v-current-obj-type = p-obj-type
     2699           v-current-obj-code = p-obj-code
     2700           v-current-db-num = g#db-num
     2701           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2702           v-current-doc-code = p-doc-code
     2703           v-current-doc-date = p-doc-date
     2704           v-current-doc-time = 0
     2705           v-current-doc-fact-date = p-fact-date
     2706           v-current-date = p-doc-date
     2707           v-current-fact-date = p-fact-date
     2708           .
     2709         end.
     2710       end case.
     2711     end.
     2712   end procedure.
     2713   procedure delete-procedure :
     2714     do
     2715     on error undo, return error
     2716     :
     2717         run garbcoll_clear in this-procedure .
     2718     end.
     2719   end procedure.
