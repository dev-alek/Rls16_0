     1971               buf_temp-hist-nws-option.table-name = 'dis-host':U
     1972           and buf_temp-hist-nws-option.db-num = g#db-num
     1973           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1974           and buf_temp-hist-nws-option.charkey_one = p-type
     1975           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
