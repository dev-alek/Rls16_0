     2054   procedure get-db-list-for-d-card2 :
     2055   define input parameter p-d-card as character no-undo .
     2056   define variable v-current-db-processed as logical no-undo .
     2057   define buffer buf_clients  for ub.clients.
     2058   define buffer buf_dis-obj for ub.dis-obj.
     2059   define buffer buf_temp-smart-route for temp-smart-route.
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       for each buf_dis-obj no-lock where
     2064               buf_dis-obj.d-card = p-d-card,
     2065          first buf_clients no-lock where
     2066               buf_clients.obj-type = buf_dis-obj.obj-type
     2067           and buf_clients.obj-code = buf_dis-obj.obj-code
     2068       break by
     2069       buf_clients.db-num:
     2070         if first-of(buf_Clients.db-num) then do:
     2071           find first buf_temp-smart-route no-lock where
     2072                 buf_temp-smart-route.key-field = p-d-card
     2073             and buf_temp-smart-route.db-num = buf_clients.db-num
     2074                 no-error.
     2075           if available buf_temp-smart-route then return.
     2076           create buf_temp-smart-route.
     2077           assign
     2078           buf_temp-smart-route.key-field = p-d-card
     2079           buf_temp-smart-route.db-num = buf_clients.db-num
     2080           .
     2081           if buf_clients.db-num = g#db-num then do:
     2082             v-current-db-processed = yes.
     2083           end.
     2084         end.
     2085       end.
     2086       if not v-current-db-processed then do:
     2087         find first buf_temp-smart-route no-lock where
     2088               buf_temp-smart-route.key-field = p-d-card
     2089           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2090         if not available buf_temp-smart-route then do:
     2091           create buf_temp-smart-route.
     2092           assign
     2093           buf_temp-smart-route.key-field = p-d-card
     2094           buf_temp-smart-route.db-num = g#db-num
     2095           .
     2096         end.
     2097       end.
     2098     end.
     2099   end procedure.
