     1142   procedure clear-from-rec-ord :
     1143   define input parameter p-rec-ord as integer no-undo .
     1144   define buffer buf_temp-no-route for temp-no-route.
     1145   define buffer buf_temp-smart-link for temp-smart-link.
     1146   do
     1147   on error undo, return error
     1148   :
     1149   for each buf_temp-no-route where
     1150           buf_temp-no-route.rec-ord > p-rec-ord:
     1151     delete buf_temp-no-route.
     1152   end.
     1153   for each buf_temp-smart-link where
     1154           buf_temp-smart-link.rec-ord > p-rec-ord:
     1155      delete buf_temp-smart-link.
     1156   end.
     1157   end.
     1158   end procedure.
     1159   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   define shared temp-table temp-hist-nws-option no-undo
