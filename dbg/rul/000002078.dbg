     3722       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3723       .
     3724       if v-waiting-stfl-i = 0
     3725       or v-old-stfl-i = 0
     3726       or v-new-stfl-i = 0
     3727       then do:
     3728         next _ii.
     3729       end.
     3730       if v-old-stfl-i < v-waiting-stfl-i
     3731       and v-new-stfl-i = v-waiting-stfl-i then do:
     3732         assign
     3733         p-is-waiting-status = yes
     3734         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3735         return.
     3736       end.
     3737       if v-old-stfl-i < v-waiting-stfl-i
     3738       and v-new-stfl-i > v-waiting-stfl-i then do:
     3739         assign
     3740         p-is-waiting-status = yes
     3741         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3742         return.
     3743       end.
     3744       if v-new-stfl-i = v-waiting-stfl-i
     3745       and v-old-stfl-i > v-waiting-stfl-i then do:
     3746         assign
     3747         p-is-waiting-status = yes
     3748         p-direction = '<открытие документа>':U + chr(4) + "to".
     3749         return.
     3750       end.
     3751       if v-new-stfl-i < v-waiting-stfl-i
     3752       and v-old-stfl-i > v-waiting-stfl-i then do:
     3753         assign
     3754         p-is-waiting-status = yes
     3755         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3756         return.
     3757       end.
     3758       if v-old-stfl-i = v-waiting-stfl-i
     3759       and v-new-stfl-i > v-waiting-stfl-i then do:
     3760         assign
     3761         p-is-waiting-status = yes
     3762         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3763         return.
     3764       end.
     3765       if v-old-stfl-i = v-waiting-stfl-i
     3766       and v-new-stfl-i < v-waiting-stfl-i then do:
     3767         assign
     3768         p-is-waiting-status = yes
     3769         p-direction = '<открытие документа>':U + chr(4) + "from".
     3770         return.
     3771       end.
     3772     end.
     3773   end.
     3774   end.
     3775   end procedure .
     3776   procedure stat-graf-price :
     3777   define input parameter p-oldbh              as handle no-undo .
     3778   define input parameter p-newbh              as handle no-undo .
     3779   define input parameter p-changed-fields     as character no-undo .
     3780   define input parameter p-waiting-status     as character no-undo .
