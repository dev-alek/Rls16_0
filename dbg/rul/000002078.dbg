     3963         assign
     3964         p-is-waiting-status = yes
     3965         p-direction = '<открытие документа>':U + chr(4) + "to".
     3966         return.
     3967       end.
     3968       if v-new-stfl-i < v-waiting-stfl-i
     3969       and v-old-stfl-i > v-waiting-stfl-i then do:
     3970         assign
     3971         p-is-waiting-status = yes
     3972         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3973         return.
     3974       end.
     3975       if v-old-stfl-i = v-waiting-stfl-i
