     2912   FUNCTION get-gln returns character ( input p-obj-type as character
     2913                                       ,input p-obj-code as integer):
     2914   define variable v-uniq-key-rec as character no-undo .
     2915   define buffer buf_clients for ub.clients.
     2916   define buffer buf_ext-classif for ub.ext-classif.
     2917   find first buf_clients no-lock where
     2918             buf_clients.obj-type = p-obj-type
     2919         and buf_clients.obj-code = p-obj-code no-error.
     2920   if not available buf_clients then do:
     2921     return chr(63).
     2922   end.
     2923   run gen-key-rec  in this-procedure ( input 'clients':U
     2924                                       ,input (buffer buf_clients:handle)
     2925                                       ,output v-uniq-key-rec) no-error.
     2926   if error-status:error then do:
     2927      return chr(63).
     2928   end.
     2929   find first buf_ext-classif no-lock where
     2930             buf_ext-classif.classif-subject = 'clients':U
     2931         and buf_ext-classif.classif-name = 'GLN':U
     2932         and buf_ext-classif.uniq-key-rec = v-uniq-key-rec no-error .
     2933   if available buf_ext-classif then do:
     2934     return buf_ext-classif.charkey_one.
     2935   end.
     2936   else do:
     2937    return ''.
     2938   end.
     2939   END FUNCTION.
     2940   FUNCTION get-type-code-from-gln returns logical ( input  p-gln      as character
     2941                                                       ,output p-obj-type as character
     2942                                                       ,output p-obj-code as integer) :
     2943   define variable v-uniq-key-rec as character no-undo .
     2944   define variable v-field-list as character no-undo .
     2945   define variable v-value-list as character no-undo .
     2946   define buffer buf_clients for ub.clients.
     2947   define buffer buf_ext-classif for ub.ext-classif.
     2948   find first buf_ext-classif no-lock where
     2949             buf_ext-classif.classif-subject = 'clients':U
     2950         and buf_ext-classif.classif-name = 'GLN':U
     2951         and buf_ext-classif.charkey_one = p-gln no-error .
     2952   if available buf_ext-classif then do:
     2953     assign v-uniq-key-rec = buf_ext-classif.uniq-key-rec.
     2954   end.
     2955   else do:
     2956     assign
     2957       p-obj-type = ''
     2958       p-obj-code = 0
     2959     .
     2960     return no.
     2961   end.
     2962   if v-uniq-key-rec <> '' then do:
     2963       run gen-key-fv in this-procedure ( input  v-uniq-key-rec
     2964                                         ,output v-field-list
     2965                                         ,output v-value-list).
     2966   end.
     2967   assign
     2968     p-obj-type = entry(lookup("obj-type":U
     2969                             , v-field-list
     2970                             , chr(3))
     2971                             , v-value-list, chr(3))
     2972     p-obj-code = integer(entry(lookup("obj-code":U
     2973                                     , v-field-list
     2974                                     , chr(3))
     2975                                     , v-value-list, chr(3)))
     2976   no-error .
     2977   if error-status:error then do:
     2978     assign
     2979       p-obj-type = ''
     2980       p-obj-code = 0
     2981     .
     2982     return no.
     2983   end.
     2984   else do:
     2985     return yes.
     2986   end.
     2987   END FUNCTION.
     2988   FUNCTION status-edoc-edi-light RETURN CHAR (buffer loc-o-doc for ub.ord-doc
     2989                                      , input is-edoc-nn as logical
     2990                                      , input is-edi as logical
     2991                                      , output p-color as integer ).
     2992   p-color = ?.
