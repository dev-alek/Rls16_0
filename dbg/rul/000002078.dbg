     4003   define variable v-current-wait as integer no-undo .
     4004   define variable v-save as integer no-undo .
     4005   define variable v-esys-cmd-proc-handle as handle no-undo .
     4006   define variable v-esys-cmd-code as integer no-undo .
     4007   define variable log-file-name                as character      no-undo init "process-edoc.txt".
     4008   define variable v-current-db-num as integer no-undo .
     4009   define variable v-last-error-message as character no-undo .
     4010   define variable file-name as char.
     4011   define variable v-sign as integer no-undo .
     4012   define variable v-gate-rec as character no-undo .
     4013   define variable v-type as character no-undo .
     4014   define variable l-res as integer no-undo .
     4015   define variable v-es as logical no-undo .
     4016   define variable v-esm as character no-undo .
     4017   define variable v-rv as character no-undo .
     4018   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4019   procedure write-to-screen :
