     2757     ,output v-obj-db-num
     2758     )  .
     2759   find first  buf_clients no-lock where
     2760               buf_clients.obj-type = loc-o-doc.cli-type and
     2761               buf_clients.obj-code = loc-o-doc.cli-code
     2762                 no-error .
