     3789   define variable v-old-stfl-i as integer no-undo .
     3790   define variable v-new-stfl-i as integer no-undo .
     3791   define variable v-ii as integer no-undo .
     3792   do
     3793   on error undo, return error return-value
     3794   :
     3795   assign
     3796   v-stat-list[1] =
     3797                    ''            +  chr(3) +
     3798                    'новый':U    +  chr(3) +
     3799                    'приказ':U      +  chr(3) +
     3800                    'разрешен':U  +  chr(3) +
     3801                    'акт':U
     3802   .
     3803     assign
     3804     v-waiting-stfl = p-waiting-status
     3805     .
     3806     assign
     3807     v-old-stfl = p-oldbh::status_
     3808     .
     3809     assign
     3810     v-new-stfl = p-newbh::status_
     3811     .
     3812     _ii:
     3813     do v-ii = 1 to 5:
     3814       if v-stat-list[v-ii] = '' then next.
     3815       assign
     3816       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3817       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3818       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3819       .
     3820       if v-waiting-stfl-i = 0
     3821       or v-old-stfl-i = 0
     3822       or v-new-stfl-i = 0
     3823       then do:
     3824         next _ii.
     3825       end.
     3826       if v-old-stfl-i < v-waiting-stfl-i
     3827       and v-new-stfl-i = v-waiting-stfl-i then do:
     3828         assign
     3829         p-is-waiting-status = yes
     3830         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3831         return.
     3832       end.
     3833       if v-old-stfl-i < v-waiting-stfl-i
     3834       and v-new-stfl-i > v-waiting-stfl-i then do:
     3835         assign
     3836         p-is-waiting-status = yes
     3837         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3838         return.
     3839       end.
     3840       if v-new-stfl-i = v-waiting-stfl-i
     3841       and v-old-stfl-i > v-waiting-stfl-i then do:
     3842         assign
     3843         p-is-waiting-status = yes
     3844         p-direction = '<открытие документа>':U + chr(4) + "to".
     3845         return.
     3846       end.
     3847       if v-new-stfl-i < v-waiting-stfl-i
     3848       and v-old-stfl-i > v-waiting-stfl-i then do:
     3849         assign
     3850         p-is-waiting-status = yes
     3851         p-direction = '<открытие документа>':U + chr(4) + "to-down".
     3852         return.
     3853       end.
     3854       if v-old-stfl-i = v-waiting-stfl-i
     3855       and v-new-stfl-i > v-waiting-stfl-i then do:
     3856         assign
     3857         p-is-waiting-status = yes
     3858         p-direction = '<закрытие документа>':U + chr(4) + "from".
     3859         return.
     3860       end.
     3861       if v-old-stfl-i = v-waiting-stfl-i
     3862       and v-new-stfl-i < v-waiting-stfl-i then do:
     3863         assign
     3864         p-is-waiting-status = yes
     3865         p-direction = '<открытие документа>':U + chr(4) + "from".
     3866         return.
     3867       end.
