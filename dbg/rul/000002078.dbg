     3912                    'запрос':U + chr(4) + string(no)
     3913   .
     3914   _jj:
     3915   do v-jj = 1 to 2:
     3916     if v-jj = 1 then do:
     3917       assign
     3918       v-waiting-stfl = p-waiting-status + chr(4) + string(if p-waiting-flag = ? then no else p-waiting-flag)
     3919       .
     3920     end.
     3921     if v-jj = 2 then do:
     3922       if p-waiting-flag <> ? then leave  _jj.
     3923       assign
     3924       v-waiting-stfl = p-waiting-status + chr(4) + string(yes)
     3925       .
     3926     end.
     3927     assign
     3928     v-old-stfl = p-oldbh::status_ + chr(4) + string(p-oldbh::flag_)
     3929     .
     3930     assign
     3931     v-new-stfl = p-newbh::status_ + chr(4) + string(p-newbh::flag_)
     3932     .
     3933     _ii:
     3934     do v-ii = 1 to 3:
     3935       if v-stat-list[v-ii] = '' then next.
     3936       assign
     3937       v-waiting-stfl-i = lookup(v-waiting-stfl, v-stat-list[v-ii], chr(3))
     3938       v-old-stfl-i = lookup(v-old-stfl, v-stat-list[v-ii], chr(3))
     3939       v-new-stfl-i = lookup(v-new-stfl, v-stat-list[v-ii], chr(3))
     3940       .
     3941       if v-waiting-stfl-i = 0
     3942       or v-old-stfl-i = 0
     3943       or v-new-stfl-i = 0
     3944       then do:
     3945         next _ii.
     3946       end.
     3947       if v-old-stfl-i < v-waiting-stfl-i
     3948       and v-new-stfl-i = v-waiting-stfl-i then do:
     3949         assign
     3950         p-is-waiting-status = yes
     3951         p-direction = '<закрытие документа>':U + chr(4) + "to".
     3952         return.
     3953       end.
     3954       if v-old-stfl-i < v-waiting-stfl-i
     3955       and v-new-stfl-i > v-waiting-stfl-i then do:
     3956         assign
     3957         p-is-waiting-status = yes
     3958         p-direction = '<закрытие документа>':U + chr(4) + "to-up".
     3959         return.
     3960       end.
