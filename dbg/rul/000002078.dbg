     3899   assign
     3900   v-stat-list[1] =
     3901                    '' +           chr(4) + string(no) + chr(3) +
     3902                    'новый':U + chr(4) + string(no) + chr(3) +
     3903                    'факт':U +      chr(4) + string(no)
     3904   v-stat-list[2] =
