     3562   procedure stat-graf-trn :
     3563   define input parameter  p-oldbh              as handle no-undo .
     3564   define input parameter  p-newbh              as handle no-undo .
     3565   define input parameter  p-changed-fields     as character no-undo .
     3566   define input parameter  p-waiting-status     as character no-undo .
     3567   define input parameter  p-waiting-flag       as logical no-undo .
     3568   define output parameter p-is-waiting-status  as logical no-undo .
     3569   define output parameter p-direction          as character no-undo .
     3570   define variable v-doc-code as character no-undo .
     3571   define variable v-ext-doc-type as character no-undo .
     3572   define variable v-stat-list as character no-undo extent 84.
     3573   define variable v-stat-list-all as character no-undo .
     3574   define variable v-jj as integer no-undo .
     3575   define variable v-ii as integer no-undo .
     3576   define variable v-old-stfl as character no-undo .
     3577   define variable v-new-stfl as character no-undo .
     3578   define variable v-waiting-stfl as character no-undo .
     3579   define variable v-old-stfl-i as integer no-undo .
     3580   define variable v-new-stfl-i as integer no-undo .
     3581   define variable v-waiting-stfl-i as integer no-undo .
     3582   do
     3583   on error  undo, return error substitute( "&1. &2&3&4", vss-include-info23, return-value, chr(10), error-status :get-message (1))
     3584   :
     3585   if p-newbh = ?  then do:
     3586     v-doc-code = p-oldbh::doc-code .
     3587     v-ext-doc-type = p-oldbh::ext-doc-type .
     3588   end.
     3589   else do:
     3590     v-doc-code     = p-newbh::doc-code .
     3591     v-ext-doc-type = p-newbh::ext-doc-type .
     3592   end.
     3593   assign
     3594   v-stat-list-all =
     3595                    '' +           chr(4) + string(no) + chr(3) +
     3596                    'запрос':U +   chr(4) + string(no) + chr(3) +
     3597                    'запрос':U +   chr(4) + string(yes) + chr(3) +
     3598                    'накл':U +      chr(4) + string(no) + chr(3) +
     3599                    'накл':U +      chr(4) + string(yes) + chr(3) +
     3600                    'разрешен':U + chr(4) + string(no) + chr(3) +
     3601                    'разрешен':U + chr(4) + string(yes) + chr(3) +
     3602                    'факт':U +      chr(4) + string(yes)
     3603   .
     3604   assign
     3605   v-stat-list[lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3606   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3607   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 2] =
     3608                                                                    '' +           chr(4) + string(no) + chr(3) +
     3609                                                                    'готов':U     + chr(4) + string(yes)
     3610   v-stat-list[lookup('ee':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 1] =
     3611                                                                    '' +           chr(4) + string(no) + chr(3) +
     3612                                                                    'отказ':U  +  chr(4) + string(yes)
     3613   v-stat-list[lookup('ep':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3614   v-stat-list[lookup('re':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3615   v-stat-list[lookup('we':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
     3616   v-stat-list[lookup('vp':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] =
     3617                                                                   ''              + chr(4) + string(no) + chr(3) +
     3618                                                                   'накл':U         + chr(4) + string(no) + chr(3) +
     3619                                                                   'факт':U         + chr(4) + string(yes)
     3620   v-stat-list[lookup('iv':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U) * 4 - 3] = v-stat-list-all
