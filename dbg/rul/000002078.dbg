     4043   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4044   procedure set-error :
     4045   define input parameter p-mess as character no-undo .
     4046     do
     4047     on error undo, return error
     4048     :
     4049        assign
     4050        v-last-error-message = p-mess.
     4051     end.
     4052   end procedure.
     4053     define variable p-xsd-file as character no-undo.
     4054   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4055   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     4056   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     4057   function context_begin-esys-command return logical
     4058   (
     4059       input p-esys-id-list as character
     4060      ,input-output p-esys-cmd-proc-handle as handle
     4061      ,output p-esys-cmd-code as integer
     4062   ):
     4063      if not valid-handle(p-esys-cmd-proc-handle )
     4064      then do:
     4065        run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     4066        if error-status :error
     4067        then do:
     4068           delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     4069                                              "&5&4&6"
     4070                                              ,vss-workfile
     4071                                              ,vss-revision
     4072                                              ,vss-description
     4073                                              ,chr(10)
     4074                                              ,error-status:get-message(1)
     4075                                              ,return-value )).
     4076        end.
     4077        run begin-create-command in p-esys-cmd-proc-handle
     4078          (input 'cmd-esys-general':U
     4079          ,input p-esys-id-list
     4080          ,output p-esys-cmd-code
     4081          ) no-error.
     4082        if error-status :error
     4083        then do:
     4084          delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     4085                                                           , 'cmd-esys-general':U
     4086                                                           , error-status:get-message(1)
     4087                                                           , return-value
     4088                                                           )).
     4089          return no .
     4090        end.
     4091        return yes.
     4092      end.
     4093   end.
     4094   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4095   function context_send-esys-command return int64
     4096   (
     4097       input p-esys-id-list as character
     4098      ,input p-esys-cmd-proc-handle as handle
     4099      ,input p-esys-cmd-code as integer
     4100      ,input p-user-id as character
     4101   ):
     4102      define variable v-dmp-ord-int64 as int64 no-undo .
     4103      if valid-handle(p-esys-cmd-proc-handle )
     4104      then do:
     4105         run send-command-esys in p-esys-cmd-proc-handle
     4106             (input p-esys-cmd-code
     4107             ,input p-esys-id-list
     4108             ,input p-user-id
     4109             ,output v-dmp-ord-int64
     4110             ) no-error.
     4111         if error-status :error
     4112         then do:
     4113            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4114                                                           , p-esys-id-list
     4115                                                           , p-cmd-code
     4116                                                           , chr(10)
     4117                                                           , error-status:get-message(1)
     4118                                                           , return-value
     4119                                                           )).
     4120            return 0.
     4121         end.
     4122         delete procedure p-esys-cmd-proc-handle no-error.
     4123         return v-dmp-ord-int64.
     4124      end.
     4125      else do:
     4126         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     4127                                                       , p-esys-id-list
     4128                                                       , p-cmd-code
     4129                                                       , chr(10)
     4130                                                       , error-status:get-message(1)
     4131                                                       , return-value
     4132                                                       )).
     4133         return 0 .
     4134      end.
     4135   end.
     4136   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4137   function context_set-custom-esys-pck-name return logical
     4138   (
     4139       input p-esys-cmd-proc-handle as handle
     4140      ,input p-esys-cmd-code as integer
     4141      ,input p-custom-pck-name as character
     4142   ):
     4143      if valid-handle(p-esys-cmd-proc-handle )
     4144      then do:
     4145         run set-custom-esys-pck-name in p-esys-cmd-proc-handle (
     4146                                                                 input p-esys-cmd-code
     4147                                                                ,input p-custom-pck-name) no-error .
     4148         if error-status :error
     4149         then do:
     4150            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     4151                                                        , p-cmd-code
     4152                                                        , chr(10)
     4153                                                        , error-status:get-message(1)
     4154                                                        , return-value
     4155                                                        )).
     4156            return no .
     4157         end.
     4158         return yes.
     4159      end.
     4160      else do:
     4161         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при установке спец имени пакета для отсылки во внешнюю систему команды с кодом &1&2&3&2&4"
     4162                                                       , p-cmd-code
     4163                                                       , chr(10)
     4164                                                       , error-status:get-message(1)
     4165                                                       , return-value
     4166                                                       )).
     4167         return no .
     4168      end.
     4169   end.
     4170   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4171   function context_delete-command return logical
     4172   (
     4173       input p-esys-cmd-proc-handle as handle
     4174      ,input p-esys-cmd-code as integer
     4175   ):
     4176      if valid-handle(p-esys-cmd-proc-handle )
     4177      then do:
     4178         run delete-command in p-esys-cmd-proc-handle
     4179             (input p-esys-cmd-code
     4180             ) no-error.
     4181         if error-status :error
     4182         then do:
     4183            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4184                                                              , p-cmd-code
     4185                                                              , chr(10)
     4186                                                              , error-status:get-message(1)
     4187                                                              , return-value
     4188                                                              )).
     4189            return no .
     4190         end.
     4191         delete procedure p-esys-cmd-proc-handle no-error.
     4192         return yes.
     4193      end.
     4194      else do:
     4195         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     4196                                                       , p-cmd-code
     4197                                                       , chr(10)
     4198                                                       , error-status:get-message(1)
     4199                                                       , return-value
     4200                                                       )).
     4201         return no .
     4202      end.
     4203   end.
     4204   on delete of this-procedure do:
     4205     run garbcoll_clear in this-procedure .
     4206   end.
     4207   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     4208   if error-status:error then do:
     4209     undo, return error return-value .
     4210   end.
     4211   if return-value = "return" then return ''.
     4212   define variable ExpData1 as class Route-data_ no-undo .
     4213   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle) .
     4214   if not this-procedure:persistent then do:
     4215     run proc-main in this-procedure no-error .
     4216     if error-status:error then do:
     4217       v-esm = error-status :get-message (1).
     4218       v-es = error-status:error .
     4219       v-rv = return-value .
     4220     end.
     4221     if v-es then do:
     4222         run garbcoll_clear in this-procedure .
     4223         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     4224     end.
     4225     run garbcoll_clear in this-procedure .
     4226   end.
     4227   procedure proc-main :
     4228     define variable v-ii as integer no-undo .
     4229     define variable v-uniq-key-rec as character no-undo .
     4230     define variable v-cli-uniq-key-rec as character no-undo .
     4231     define variable v-err as logical no-undo .
     4232     define variable v-custom-pack-name as character no-undo .
     4233     define variable v-success as logical   no-undo .
     4234     DEFINE VARIABLE v-today as date no-undo .
     4235     DEFINE VARIABLE v-time as integer no-undo .
     4236     define variable v-ord-int1 as integer no-undo .
     4237     define variable v-obj-gln as character no-undo .
     4238     define variable v-cli-gln as character no-undo .
     4239     define variable v-frm-gln as character no-undo .
     4240     define variable v-mess as character no-undo .
     4241     define variable v-b-code as integer no-undo .
     4242     define variable v-b-str as character no-undo .
     4243     define variable v-jj as integer   no-undo .
     4244     define variable v-cli-base-rate as decimal no-undo .
     4245     define variable v-dump-ord-int64 as int64 no-undo .
     4246     define variable v-rcv-code as character no-undo .
     4247     define variable v-cli-type as character no-undo .
     4248     define variable v-cli-code as integer   no-undo .
     4249     define variable v-cli-rcv-code as character no-undo .
     4250     define variable v-EDIINTERCHANGEID as character no-undo .
     4251     define variable v-edist-mess as character no-undo .
     4252     define variable v-date-status as character no-undo .
     4253     define variable v-time-status as integer no-undo .
     4254     define buffer buf_ext-system for ub.ext-system.
     4255     define buffer buf_ord-doc for ub.ord-doc.
     4256     define buffer buf_ord-line for ub.ord-line.
     4257     define buffer buf_object for ub.clients.
     4258     define buffer buf_clients for ub.clients.
     4259     define buffer buf_ext-classif for ub.ext-classif.
     4260     define buffer esys_ext-classif for ub.ext-classif.
     4261     define buffer buf_goods for ub.goods.
     4262     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     4263     define buffer buf_currency for ub.currency.
     4264     define buffer buf_ord-line-attr for ub.ord-line-attr.
     4265     define buffer buf_edi-status for ub.edi-status.
     4266   _main:
     4267   do
     4268   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4269   on stop undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     4270   :
     4271     dataset status__-t:handle:empty-dataset() .
     4272     if retry then do:
     4273           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при обработке поставки &1 по заказу &2:&3&4"                                    ,v-current-doc-code                                    , v-current-doc-code                                     , chr(10), v-mess)).
     4274       undo _main, return error.
     4275     end.
     4276     else do:
     4277       if v-has-newbh then do:
     4278         v-current-obj-type = v-newbh::obj-type.
     4279         v-current-obj-code = v-newbh::obj-code.
     4280         v-cli-type = v-newbh::cli-type.
     4281         v-cli-code = v-newbh::cli-code.
     4282         v-current-doc-code = v-newbh:buffer-field("doc-code"):buffer-value.
     4283         v-rcv-code = v-newbh:buffer-field("rcv-code"):buffer-value.
     4284         v-ord-int1 = v-newbh:buffer-field("ord-int1"):buffer-value.
     4285         v-cli-rcv-code = entry (1 , v-newbh::sub-par, chr(4)).
     4286       end.
     4287       assign
     4288       v-mess = ''
     4289       .
     4290       find first buf_ord-doc exclusive-lock where
     4291                 buf_ord-doc.doc-code = v-current-doc-code no-error .
     4292       if not available buf_ord-doc then do:
     4293         v-mess = substitute("Не найден заказ для поставки").
     4294         v-err = yes.
     4295         undo _main, retry _main.
     4296       end.
     4297       IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     4298         undo _main, return error v-last-error-message .
     4299       end.
     4300       find first buf_clients no-lock where
     4301                 buf_clients.obj-type = v-cli-type
     4302             and buf_clients.obj-code = v-cli-code no-error.
     4303       if not available buf_clients then do:
     4304         v-mess =  substitute("Не найден контрагент &1&2", v-cli-type, v-cli-code).
     4305         v-err = yes.
     4306         undo _main, retry _main.
     4307       end.
     4308       if buf_ord-doc.doc-type = 'ОП':U
     4309       and buf_ord-doc.status_  = 'поставка':U
     4310       and buf_ord-doc.ord-int1 = integer('7':U)
     4311       and buf_ord-doc.whole-send-news = integer('2':U)
     4312       then do:
     4313         assign
     4314         v-ord-int1 = integer('8':U).
     4315       end.
     4316       else do:
     4317         return "return".
     4318       end.
     4319       run gen-key-rec in this-procedure ( input 'clients':U
     4320                                         ,input (buffer buf_clients:handle)
     4321                                         ,output v-cli-uniq-key-rec) no-error .
     4322       if error-status:error then do:
     4323         v-mess = substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4324                                   , error-status:get-message(1)
     4325                                   , return-value
     4326                                   , chr(10)
     4327                                   , v-cli-type
     4328                                   , v-cli-code).
     4329         v-err = yes.
     4330         undo _main, retry _main.
     4331       end.
     4332       find first esys_ext-classif no-lock where
     4333           esys_ext-classif.classif-name = 'exite-edi':U
     4334       and esys_ext-classif.classif-subject = 'clients':U
     4335       and esys_ext-classif.db-num = -1
     4336       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec no-error .
     4337       if not available esys_ext-classif then do:
     4338         v-mess = substitute("Поставщик &1&2 заказа НЕ РАБОТАЕТ ПО СИСТЕМЕ EDI", v-cli-type, v-cli-code).
     4339         v-err = yes.
     4340         undo _main, retry _main.
     4341       end.
     4342       find first buf_object no-lock where
     4343                 buf_object.obj-type = v-current-obj-type
     4344             and buf_object.obj-code = v-current-obj-code no-error.
     4345       if not available buf_object then do:
     4346         v-mess =  substitute("Не найден объект &1&2", v-current-obj-type, v-current-obj-code).
     4347         v-err = yes.
     4348         undo _main, retry _main.
     4349       end.
     4350       if buf_object.db-num <> g#db-num then do:
     4351         v-mess = substitute("Объект &1&2 принадлежит другой БД", v-current-obj-type, v-current-obj-code).
     4352         v-err = yes.
     4353         undo _main, retry _main.
     4354       end.
     4355       run gen-key-rec in this-procedure ( input 'clients':U
     4356                                         ,input (buffer buf_object:handle)
     4357                                         ,output v-uniq-key-rec) no-error .
     4358       if error-status:error then do:
     4359         v-mess =  substitute("gen-key-rec: &1&2&3&2(&4&5)"
     4360                                   , error-status:get-message(1)
     4361                                   , return-value
     4362                                   , chr(10)
     4363                                   , buf_object.obj-type
     4364                                   , buf_object.obj-code).
     4365         v-err = yes.
     4366         undo _main, retry _main.
     4367       end.
     4368       assign
     4369       v-obj-gln = get-gln( input buf_object.obj-type
     4370                       ,input buf_object.obj-code) no-error.
     4371       if error-status:error
     4372       or v-obj-gln = chr(63)
     4373       or v-obj-gln = '' then do:
     4374         v-mess =  substitute("Не определен GLN для &1&2"
     4375                                   , buf_object.obj-type
     4376                                   , buf_object.obj-code) .
     4377         v-err = yes.
     4378         undo _main, retry _main.
     4379       end.
     4380       v-cli-gln = get-gln( input v-cli-type
     4381                           ,input v-cli-code) no-error.
     4382       if error-status:error
     4383       or v-cli-gln = chr(63)
     4384       or v-cli-gln = '' then do:
     4385         v-mess =  substitute("Не определен GLN для &1&2"
     4386                                   , buf_object.obj-type
     4387                                   , buf_object.obj-code) .
     4388         v-err = yes.
     4389         undo _main, retry _main.
     4390       end.
     4391       for each esys_ext-classif no-lock where
     4392           esys_ext-classif.classif-name = 'exite-edi':U
     4393       and esys_ext-classif.classif-subject = 'clients':U
     4394       and esys_ext-classif.db-num = -1
     4395       and esys_Ext-classif.uniq-key-rec = v-cli-uniq-key-rec,
     4396         first buf_ext-system no-lock where
     4397                   buf_ext-system.esys-id = esys_ext-classif.key#_one
     4398               and buf_ext-system.db-num = 0
     4399               and buf_ext-system.esys-have-export = yes,
     4400         first buf_ext-classif no-lock where
     4401           buf_ext-classif.classif-name = 'exite-edi':U
     4402       and buf_ext-classif.classif-subject = 'clients':U
     4403       and buf_ext-classif.db-num = -1
     4404       and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec
     4405       and buf_Ext-classif.key#_one = esys_ext-classif.key#_one:
     4406         leave.
     4407       end.
     4408       if not available buf_ext-system then do:
     4409         v-mess = substitute("Для поставщика &1&2 не найдена ВС, у которой есть экспорт в текущей БД").
     4410         v-err = yes.
     4411         undo _main, retry _main.
     4412       end.
     4413       IF  context_begin-esys-command( input string(buf_ext-system.esys-id), input-output v-esys-cmd-proc-handle, output v-esys-cmd-code) = false  THEN do:
     4414         undo _main, return error v-last-error-message .
     4415       end.
     4416       run cur-time in this-procedure(output v-today, output v-time) no-error.
     4417       v-custom-pack-name = substitute("status_&1_&&pack-num.xml"
     4418                                     ,v-obj-gln).
     4419       for each buf_edi-status no-lock where
     4420               buf_edi-status.tbl-name = 'ord-doc-rcv':U
     4421          and buf_edi-status.doc-code = v-rcv-code
     4422          and buf_edi-status.state = '7':U
     4423          and buf_edi-status.err-code < 3 :
     4424         assign
     4425         v-EDIINTERCHANGEID = cr-edist_get-mess-key-value(buf_edi-status.mess, 'ediiterchangeid':U).
     4426       end.
     4427       create status_-t.
     4428       assign
     4429       status_-t.EXiteICID    = v-EDIINTERCHANGEID
     4430       status_-t.CustomerICID = v-cli-rcv-code
     4431       status_-t.From_        = v-obj-gln
     4432       status_-t.To_          = v-cli-gln
     4433       status_-t.Status_      = 1
     4434       status_-t.DateIn       = v-today
     4435       status_-t.TimeIn       = string(v-time, "HH:MM")
     4436       status_-t.DateOut      = v-today
     4437       status_-t.TimeOut      = string(v-time, "HH:MM")
     4438       status_-t.SizeInBytes  = 0
     4439       status_-t.MessageClass = "DESADV"
     4440       .
     4441       ExpData1:route-data_create-record( INPUT "status_") .
     4442       ExpData1:route-data_copy-record( INPUT "status_", INPUT  (buffer status_-t:handle) ) .
     4443       IF ExpData1:esys-add-dump( INPUT "status_", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4444         undo _main, return error v-last-error-message .
     4445       end.
     4446       run edocsord_export in this-procedure ( buffer buf_ord-doc
     4447                                           ,input v-cli-rcv-code
     4448                                           ,input v-ord-int1
     4449                                           ) no-error.
     4450       if error-status:error then do:
     4451         v-mess = substitute("Ошибка при переводе статуса маршрутизированного заказа:&1&2&1&3"
     4452                             , chr(10)
     4453                             , error-status:get-message(1)
     4454                             , return-value ).
     4455         undo _main, retry _main.
     4456       end.
     4457       IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4458         undo _main, return error v-last-error-message .
     4459       end.
     4460       v-dump-ord-int64 = context_send-esys-command( input string(buf_ext-system.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid).
     4461       if v-dump-ord-int64 = 0 THEN do:
     4462         undo _main, return error v-last-error-message .
     4463       end.
     4464       v-edist-mess = ''.
     4465       v-edist-mess = cr-edist_add-edist-mess( v-edist-mess, 'route':U, string(v-dump-ord-int64)).
     4466       v-date-status = ?.
     4467       run create-edi-state in this-procedure (
     4468                                               input 'ord-doc-rcv':U
     4469                                             , input v-rcv-code
     4470                                             , input buf_ord-doc.cli-type
     4471                                             , input buf_ord-doc.cli-code
     4472                                             , input 'ИЗМЕНЕНИЕ':U
     4473                                             , input v-newbh::ord-int1
     4474                                             , input integer('0':U)
     4475                                             , input buf_ord-doc.PS
     4476                                             , input v-edist-mess
     4477                                             , input integer('2':U)
     4478                                             , input-output v-date-status
     4479                                             , input-output v-time-status
     4480                                             ).
     4481           ExpData1:Route-data_clear-data ( ) .
     4482     end.
     4483       ExpData1:Route-data_clear-data ( ) .
     4484   end.
     4485   end procedure.
     4486   procedure load-ruleset-context :
     4487   define input parameter p-ruleset-id as integer no-undo .
     4488   define variable v-is-waiting-status as logical   no-undo .
     4489   define variable v-direction as character no-undo .
     4490   define variable v-dm as integer no-undo .
     4491   define buffer buf_rule-call-param for ub.rule-call-param.
     4492   do
     4493   on error undo, return error
     4494   on stop undo, return error
     4495   :
     4496     if g#news then  return "return".
     4497     assign
     4498     v-oldbh = widget-handle (entry(2, p-doc-code, chr(4)))
     4499     v-newbh = widget-handle (entry(3, p-doc-code, chr(4)))
     4500     v-changes-list = entry(4, p-doc-code, chr(4))
     4501     file-name  = p-process-file-name
     4502     v-has-oldbh = valid-handle(v-oldbh) and v-oldbh:available
     4503     v-has-newbh = valid-handle(v-newbh) and v-newbh:available
     4504     .
     4505     if not v-has-newbh
     4506     and not v-has-oldbh then do:
     4507       undo, return error substitute("Не определено ни одного буфера - ни старый, ни новый").
     4508     end.
     4509     if not v-has-oldbh
     4510     and v-changes-list  = '' then do:
     4511        undo, return error substitute("Не определен старый буфер и список изменений").
     4512     end.
     4513     case p-ruleset-id:
     4514     when 105 then do:
     4515       if v-has-newbh
     4516       and v-newbh:table <> 'ord-doc-rcv':U then do:
     4517         undo, return error substitute("Передан неверный буфер вместо буфера для &1",  'ord-doc-rcv':U).
     4518       end.
     4519     end.
     4520     otherwise do:
     4521       undo, return error substitute("Неверный вызов &1 для набора правил &2", vss-workfile , p-ruleset-id).
     4522     end.
     4523     end case.
     4524     run statq_has-waiting-stat in this-procedure (
     4525                                                   input v-oldbh
     4526                                                   ,input v-newbh
     4527                                                   ,input v-changes-list
     4528                                                   ,input 'поставка':U
     4529                                                   ,input no
     4530                                                   ,input integer('7':U)
     4531                                                   ,output v-is-waiting-status
     4532                                                   ,output v-direction
     4533                                                   ) no-error.
     4534     if v-is-waiting-status = no
     4535     or entry(1, v-direction, chr(4)) = 'удаление':U
     4536     then do:
     4537       return "return".
     4538     end.
     4539     v-dm = v-newbh:buffer-field("whole-send-news"):buffer-value.
     4540     if v-dm <> integer('2':U) then do:
     4541       return "return".
     4542     end.
     4543     find first buf_rule-call-param no-lock where
     4544   buf_rule-call-param.codex_id = p-codex-id
     4545   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4546   and buf_rule-call-param.call_id = p-call-id
     4547   and buf_rule-call-param.order_id = p-order-id
     4548   and buf_rule-call-param.rule_id = p-rule-id
     4549   and buf_rule-call-param.param-name = "p-xsd-file"
     4550    no-error.
     4551   if available buf_rule-call-param then do:
     4552   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4553   end.
     4554   end.
     4555   end procedure.
