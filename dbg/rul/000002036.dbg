     1804   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1805   function context_delete-command return logical
     1806   (
     1807       input p-esys-cmd-proc-handle as handle
     1808      ,input p-esys-cmd-code as integer
     1809   ):
     1810      if valid-handle(p-esys-cmd-proc-handle )
     1811      then do:
     1812         run delete-command in p-esys-cmd-proc-handle
     1813             (input p-esys-cmd-code
     1814             ) no-error.
     1815         if error-status :error
     1816         then do:
     1817            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1818                                                              , p-cmd-code
     1819                                                              , chr(10)
     1820                                                              , error-status:get-message(1)
     1821                                                              , return-value
     1822                                                              )).
     1823            return no .
     1824         end.
     1825         delete procedure p-esys-cmd-proc-handle no-error.
     1826         return yes.
     1827      end.
     1828      else do:
     1829         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при удалении команды с кодом &1&2&3&2&4"
     1830                                                       , p-cmd-code
     1831                                                       , chr(10)
     1832                                                       , error-status:get-message(1)
     1833                                                       , return-value
     1834                                                       )).
     1835         return no .
     1836      end.
     1837   end.
     1838   on delete of this-procedure do:
     1839     run garbcoll_clear in this-procedure .
     1840   end.
     1841   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     1842   if error-status:error then do:
     1843     undo, return error return-value .
     1844   end.
     1845   define variable ExpData1 as class Route-data_ no-undo .
     1846   ExpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input p-dataseth, input v-xmlh) .
     1847   if not this-procedure:persistent then do:
     1848     run proc-main in this-procedure no-error .
     1849     if error-status:error then do:
     1850       v-es = error-status:error .
     1851       v-rv = return-value .
     1852     end.
     1853     if v-es then do:
     1854         run garbcoll_clear in this-procedure .
     1855         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     1856     end.
     1857     run garbcoll_clear in this-procedure .
     1858   end.
     1859   procedure proc-main :
     1860   define variable v-err-mess as character no-undo .
     1861   define variable v_qh as handle no-undo .
     1862   define variable glog as logical no-undo .
     1863   define buffer buf_ext-system for ub.ext-system.
     1864   _main:
     1865   do transaction
     1866   on error  undo _main, retry _main
     1867   on stop   undo _main, retry _main
     1868   on endkey undo _main, retry _main
     1869   :
     1870     if retry then do:
     1871       v-esm = v-err-mess.
     1872       if valid-handle(v_qh) then do:
     1873         delete object v_qh no-error.
     1874       end.
     1875       if valid-handle(p-dataseth) then do:
     1876         delete object p-dataseth no-error.
     1877       end.
     1878           ExpData1:Route-data_clear-data ( ) .
     1879       if p-ruleset-id = 2
     1880       then do:
     1881         run write-log  in p-log-handle (
     1882                                         input 0
     1883                                       , "&DLine").
     1884               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............(&1) Маршрутизация отчета закончилась ошибкой", p-rule-id)).
     1885               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-esm)).
     1886               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............&1", v-rv)).
     1887         v-rv = v-esm + chr(10) + v-rv.
     1888       end.
     1889       return error v-rv.
     1890     end.
     1891     else do:
     1892       if valid-handle(p-dataseth) = no then do:
     1893         v-err-mess = substitute("Не удалось получить данные для маршрутизации - маршрутизация невозможна:&1&2&1&3"
     1894                                , chr(10)
     1895                                , error-status:get-message(1)
     1896                                , return-value
     1897                                ).
     1898         undo _main, retry _main .
     1899       end.
     1900       ExpData1:change-direction( 1).
     1901       find first buf_ext-system no-lock where
     1902                 buf_ext-system.esys-id = p-esys-id
     1903             and buf_ext-system.db-num = 0
     1904                 no-error.
     1905       if not available buf_ext-system then do:
     1906         v-err-mess = substitute("Не найдена ВС &1", p-esys-id).
     1907         undo _main, retry _main .
     1908       end.
     1909       if not (buf_ext-system.esys-type > integer('0':U)) then do:
     1910         v-err-mess = substitute("ВС &1 не имеет типа СПЕЦИАЛЬНАЯ - маршрутизация невозможна", p-esys-id).
     1911         undo _main, retry _main .
     1912       end.
     1913       if buf_ext-system.esys-have-export = no then do:
     1914         v-err-mess = substitute("Для ВС &1 не определена операция экспорта - маршрутизация невозможна", p-esys-id).
     1915         undo _main, retry _main .
     1916       end.
     1917       IF  context_begin-nws2esys-command ( input p-esys-id
     1918                                         ,input buf_ext-system.esys-db-num-exp
     1919                                         ,input p-dataseth:private-data
     1920                                         ,input-output v-esys-cmd-proc-handle
     1921                                         ,output v-esys-cmd-code) = false  THEN do:
     1922         v-err-mess = v-last-error-message.
     1923         undo _main, retry _main  .
     1924       end.
     1925       for each buf_temp-xml-tables:
     1926         create query v_qh.
     1927         glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle) no-error.
     1928         if error-status:error
     1929         or
     1930         not glog then do:
     1931           v-err-mess = substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1932                                                                   , buf_temp-xml-tables.tbl-name
     1933                                                                   , chr(10)
     1934                                                                   , error-status:get-message(1)
     1935                                                                   , return-value).
     1936           undo _main, retry _main .
     1937         end.
     1938         glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     1939         if error-status:error
     1940         or
     1941         not glog then do:
     1942           v-err-mess = substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1943                                                                   , buf_temp-xml-tables.tbl-name
     1944                                                                   , chr(10)
     1945                                                                   , error-status:get-message(1)
     1946                                                                   , return-value).
     1947           undo _main, retry _main .
     1948         end.
     1949         glog = v_qh:query-open no-error .
     1950         if error-status:error
     1951         or not glog then do:
     1952           v-err-mess =  substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1953                                         , buf_temp-xml-tables.tbl-name
     1954                                         , chr(10)
     1955                                         , error-status:get-message(1)
     1956                                         , return-value).
     1957           undo _main, retry _main.
     1958         end.
     1959         _stroka:
     1960         repeat:
     1961           v_qh:get-next().
     1962           if v_qh:query-off-end then do:
     1963             leave _stroka.
     1964           end.
     1965           IF  ExpData1:esys-add-dump( INPUT buf_temp-xml-tables.tbl-name
     1966                                     , INPUT v-esys-cmd-proc-handle
     1967                                     , INPUT v-esys-cmd-code
     1968                                     , '+update') = false  THEN do:
     1969             v-err-mess = v-last-error-message .
     1970             undo _main, retry _main.
     1971           end.
     1972         end.
     1973         delete object v_qh.
     1974       end.
     1975       IF  context_send-nws2esys-command( input p-esys-id
     1976                                        , input buf_ext-system.esys-db-num-exp
     1977                                        , input p-dataseth:private-data
     1978                                        , input v-esys-cmd-proc-handle
     1979                                        , input v-esys-cmd-code
     1980                                        , input g#userid) = false  THEN do:
     1981         v-err-mess = v-last-error-message.
     1982         undo _main, retry _main  .
     1983       end.
     1984           ExpData1:Route-data_clear-data ( ) .
     1985       if valid-handle(p-dataseth) then do:
     1986         delete object p-dataseth no-error.
     1987       end.
     1988     end.
     1989   end.
     1990   end procedure.
     1991   procedure load-ruleset-context :
     1992   define input parameter p-ruleset-id as integer no-undo .
     1993   define buffer buf_rule-call-param for ub.rule-call-param.
     1994   do
     1995   on error undo, return error
     1996   :
     1997   for each buf_temp-rule-call-param:
     1998     delete buf_temp-rule-call-param.
     1999   end.
     2000    find first buf_rule-call-param no-lock where
     2001   buf_rule-call-param.codex_id = p-codex-id
     2002   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2003   and buf_rule-call-param.call_id = p-call-id
     2004   and buf_rule-call-param.order_id = p-order-id
     2005   and buf_rule-call-param.rule_id = p-rule-id
     2006   and buf_rule-call-param.param-name = "p-esys-id"
     2007    no-error.
     2008   if available buf_rule-call-param then do:
     2009   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2010   end.
     2011       find first buf_rule-call-param no-lock where
     2012   buf_rule-call-param.codex_id = p-codex-id
     2013   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2014   and buf_rule-call-param.call_id = p-call-id
     2015   and buf_rule-call-param.order_id = p-order-id
     2016   and buf_rule-call-param.rule_id = p-rule-id
     2017   and buf_rule-call-param.param-name = "p-xsd-file"
     2018    no-error.
     2019   if available buf_rule-call-param then do:
     2020   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2021   end.
     2022   run cb_rcps-run_get-value in p-cont-handle ( input p-call-id
     2023                                               ,input p-codex-id
     2024                                               ,input p-ruleset-id
     2025                                               ,input p-order-id
     2026                                               ,input "p-dataseth"
     2027                                               ,input-output v-p-index
     2028                                               ,output v-value-character
     2029                                               ,output v-value-date
     2030                                               ,output v-value-decimal
     2031                                               ,output v-value-integer
     2032                                               ,output v-value-logical).
     2033   p-dataseth = widget-handle(v-value-character).
     2034       case p-ruleset-id:
     2035         when 2
     2036         then do:
     2037           assign
     2038           v-sign = 0
     2039           v-current-host-code = p0-host-code
     2040           v-current-obj-type = p-obj-type
     2041           v-current-obj-code = p-obj-code
     2042           v-current-db-num = g#db-num
     2043           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2044           v-dirs  = p-process-dirs
     2045           v-current-rep-code  = p-doc-code
     2046           .
     2047           run gate-clb_fill-xml-tables in this-procedure ( input p-dataseth
     2048                                                         ,input-output v-xmlh) no-error.
     2049           if error-status:error then do:
     2050             run gate-clear in this-procedure ( input p-dataseth
     2051                                              , input v-xmlh) no-error.
     2052             undo, return error substitute("Ошибка при получении схемы данных отчета:&1&2&1&3"
     2053                                           , chr(10)
     2054                                           , error-status:get-message(1)
     2055                                           , return-value ).
     2056           end.
     2057         end.
     2058      end case.
     2059   end.
     2060   end procedure.
