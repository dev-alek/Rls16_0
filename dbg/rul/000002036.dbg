     1714                                    ,p-esys-id
     1715                                    ,p-db-num-export
     1716                                    ,str-encode( p-uniq-gate-rec
     1717                                    , ""
     1718                                    , chr(3))
     1719                                 ).
     1720         if g#db-num > 0
