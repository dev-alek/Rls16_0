     1697      ,input p-uniq-gate-rec as character
     1698      ,input p-esys-cmd-proc-handle as handle
     1699      ,input p-esys-cmd-code as integer
     1700      ,input p-user-id as character
     1701   ):
     1702      define variable v-dmp-ord-int64 as int64 no-undo .
     1703      define variable v-command-name as character no-undo .
