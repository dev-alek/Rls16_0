     1733               (input p-esys-cmd-code
     1734               ,input v-dst-list
     1735               ,input p-user-id
     1736               ,output v-dmp-ord-int64
     1737            ) no-error.
     1738         end.
     1739         else do:
     1740            run send-command in p-esys-cmd-proc-handle
     1741               (input p-esys-cmd-code
     1742               ,input v-dst-list
     1743            ) no-error.
     1744         end.
     1745         if error-status :error
     1746         then do:
     1747            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1748                                                        , p-esys-id
     1749                                                        , p-cmd-code
     1750                                                        , chr(10)
     1751                                                        , error-status:get-message(1)
     1752                                                        , return-value
     1753                                                        )).
     1754            return no .
     1755         end.
     1756         delete procedure p-esys-cmd-proc-handle no-error.
     1757         return yes.
     1758      end.
     1759      else do:
     1760         delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1761                                                       , p-esys-id
     1762                                                       , p-cmd-code
     1763                                                       , chr(10)
     1764                                                       , error-status:get-message(1)
     1765                                                       , return-value
     1766                                                       )).
     1767         return no .
     1768      end.
     1769   end.
     1770   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
