        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p0-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-dirs as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 22, набор 2".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define shared temp-table temp-hist-nws-option no-undo
      361   like ub.hist-nws-option
      362   .
      363   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure gen-key-rec :
      365     define input  parameter p-tbl-name    as character no-undo.
      366     define input  parameter p-bh_tbl-name as handle    no-undo.
      367     define output parameter p-key-rec     as character no-undo.
      368     do
      369     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      370     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      371     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      372     :
      373       define variable fh               as handle    no-undo .
      374       define variable v-ok             as logical   no-undo .
      375       define variable v-inform         as character no-undo .
      376       define variable v-ind            as integer   no-undo .
      377       define variable v-idx-field-qnty as integer   no-undo .
      378       if p-tbl-name = ?
      379         or p-tbl-name = "":U
      380       then do:
      381         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      382       end.
      383       if not p-bh_tbl-name:available then do:
      384         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      385       end.
      386       assign
      387         p-key-rec = p-tbl-name
      388         v-inform  = p-bh_tbl-name:index-information(1)
      389         v-ind     = 2
      390       .
      391       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      392       on error undo, return error
      393       :
      394         assign
      395           v-inform = p-bh_tbl-name:index-information( v-ind )
      396           v-ind    = v-ind + 1
      397         .
      398       end.
      399       if v-inform = ?
      400         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      401         or entry( 3, v-inform, ",":U ) <> "1":U
      402       then do:
      403         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      404       end.
      405       else do:
      406         assign
      407           v-idx-field-qnty = num-entries( v-inform ) - 4
      408         .
      409         if v-idx-field-qnty < 2 then do:
      410           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      411         end.
      412         do v-ind = 1 to v-idx-field-qnty by 2
      413         on error undo, return error
      414         :
      415           assign
      416             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      417             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      418           .
      419         end.
      420       end.
      421       if p-key-rec = ? then do:
      422         assign
      423           p-key-rec = "":U
      424         .
      425         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      426       end.
      427     end.
      428     return.
      429   end procedure.
      430   procedure gen-where-keyr-tab :
      431     define input  parameter i-tableSerach as character no-undo.
      432     define input  parameter i-tablekey   as character  no-undo.
      433     define input  parameter p-key-rec    as character  no-undo.
      434     define input  parameter p-key-handle as handle     no-undo .
      435     define input  parameter p-db-name    as character  no-undo .
      436     define input  parameter p-tt-handle  as handle     no-undo .
      437     define output parameter o-Where      as character  no-undo.
      438     do
      439     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      440     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      442     :
      443       define variable v-full-tbl-name  as character no-undo .
      444       define variable bh_tbl-name      as handle    no-undo .
      445       define variable fh_key           as handle    no-undo .
      446       define variable fh_search        as handle    no-undo .
      447       define variable v-field-num      as integer   no-undo .
      448       define variable v-count-fld      as integer   no-undo .
      449       define variable v-inform         as character no-undo .
      450       define variable v-ind            as integer   no-undo .
      451       define variable v-idx-field-qnty as integer   no-undo .
      452       define variable v-field-name     as character no-undo .
      453       define variable v-field-val      as character no-undo .
      454       define variable v-word-link      as character no-undo .
      455       define variable vTable           as character no-undo.
      456       define variable bh_tbl-key       as handle    no-undo .
      457       assign
      458         p-key-rec = trim( p-key-rec )
      459       .
      460       if p-key-handle <> ? then do:
      461         if not valid-handle(p-key-handle)
      462            or p-key-handle:type <> "buffer"
      463         then do:
      464           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      465         end.
      466         if num-entries( p-key-rec, chr(3) ) > 1
      467           or p-key-rec = ?
      468           or p-key-rec = "":U
      469         then do:
      470           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      471         end.
      472       end.
      473       else do:
      474         if p-key-rec = ?
      475           or p-key-rec = "":U
      476         then do:
      477           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      478         end.
      479       end.
      480       assign
      481         vTable = entry( 1 , p-key-rec, chr(3) )
      482       .
      483       if p-tt-handle <> ?
      484         and ( not valid-handle(p-tt-handle)
      485               or p-tt-handle:type <> "buffer"
      486             )
      487       then do:
      488         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      489       end.
      490       if p-tt-handle = ? then do:
      491         assign
      492           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      493         .
      494         create buffer bh_tbl-name for table v-full-tbl-name .
      495       end.
      496       else do:
      497         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      498       end.
      499       assign
      500         v-inform = bh_tbl-name:index-information(1)
      501         v-ind    = 2
      502       .
      503       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      504       on error undo, return error
      505       :
      506         assign
      507           v-inform = bh_tbl-name:index-information( v-ind )
      508           v-ind    = v-ind + 1
      509         .
      510       end.
      511       if v-inform = ?
      512         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      513         or entry( 3, v-inform, ",":U ) <> "1":U
      514       then do:
      515         delete object bh_tbl-name no-error.
      516         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      517       end.
      518       assign
      519         v-idx-field-qnty = num-entries( v-inform ) - 4
      520       .
      521       if v-idx-field-qnty < 2 then do:
      522         delete object bh_tbl-name no-error.
      523         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      524       end.
      525       assign
      526         o-where     = "where":U
      527         v-word-link = "":U
      528         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      529         v-count-fld = 0
      530       .
      531       if i-tablekey ne "" and i-tablekey ne ?
      532       then do:
      533         assign
      534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      535         .
      536         create buffer bh_tbl-key for table v-full-tbl-name .
      537       end.
      538       if i-tableSerach ne "" and i-tableSerach ne ?
      539       then do:
      540         delete object bh_tbl-name no-error.
      541         assign
      542           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      543         .
      544         create buffer bh_tbl-name for table v-full-tbl-name .
      545       end.
      546       block_where:
      547       do v-ind = 1 to v-idx-field-qnty by 2
      548       on error undo, return error
      549       :
      550         assign
      551           v-count-fld = v-count-fld + 1
      552         .
      553         if p-key-handle = ?
      554           and v-count-fld > v-field-num
      555         then do:
      556           leave block_where.
      557         end.
      558         define variable VfieldKeyTable as handle no-undo.
      559         assign
      560           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      561           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      562         .
      563         if     bh_tbl-key ne ?
      564         then do:
      565            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      566            if VfieldKeyTable eq ?
      567            then next block_where.
      568         end.
      569         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      570         then
      571            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      572         else
      573            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      574         if p-key-handle = ? then do:
      575           assign
      576             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      577           .
      578         end.
      579         else do:
      580           assign
      581             fh_key = p-key-handle:buffer-field( v-field-name )
      582           .
      583           if fh_key = ?
      584             or not valid-handle( fh_key )
      585           then do:
      586             delete object bh_tbl-name.
      587             if     bh_tbl-key ne ?
      588             then
      589                delete object bh_tbl-key.
      590             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      591           end.
      592           assign
      593             v-field-val = fh_key:buffer-value
      594           .
      595         end.
      596         if fh_search:data-type ="character":U then do:
      597           assign
      598             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      599             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      600             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      601             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      602             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      603             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      604             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      605             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      606             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      607             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      608             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      609             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      610             v-field-val = substitute( '"&1"', v-field-val )
      611           .
      612         end.
      613         assign
      614           o-where = substitute( "&1 &2", o-where, v-field-val )
      615         .
      616         if v-word-link = "":U then do:
      617           assign
      618             v-word-link = "and":U
      619           .
      620         end.
      621       end.
      622       delete object bh_tbl-name.
      623       if     bh_tbl-key ne ?
      624       then
      625          delete object bh_tbl-key.
      626       if p-key-handle = ?
      627         and v-count-fld <> v-field-num
      628       then do:
      629         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      630       end.
      631     end.
      632   end procedure.
      633   procedure gen-hn-keyr-tab :
      634     define input  parameter i-tableSerach as character no-undo.
      635     define input  parameter i-tablekey   as character no-undo.
      636     define input  parameter p-key-rec    as character no-undo.
      637     define input  parameter p-key-handle as handle    no-undo .
      638     define input  parameter p-db-name    as character no-undo .
      639     define input  parameter p-tt-handle  as handle    no-undo .
      640     define input  parameter p-stts-lock  as integer   no-undo .
      641     define output parameter o-hn         as handle    no-undo.
      642     define variable v-full-tbl-name as character no-undo.
      643     define variable v-where         as character no-undo.
      644     define variable bh_tbl-name     as handle    no-undo.
      645     define variable vTable          as character no-undo.
      646     do
      647     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      648     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      649     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      650         run gen-where-keyr-tab(i-tableSerach,
      651                                i-tablekey,
      652                                p-key-rec,
      653                                p-key-handle,
      654                                p-db-name,
      655                                p-tt-handle,
      656                                output v-where).
      657         if i-tableSerach ne "" and i-tableSerach ne ?
      658         then do:
      659            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      660            create buffer bh_tbl-name for table v-full-tbl-name .
      661         end.
      662         else do:
      663            if p-tt-handle = ? then do:
      664               assign
      665                  vTable = entry( 1 , p-key-rec, chr(3) )
      666               .
      667               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      668               create buffer bh_tbl-name for table v-full-tbl-name .
      669            end.
      670            else do:
      671               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      672            end.
      673         end.
      674         if p-tt-handle = ? then do:
      675            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      676         end.
      677         else do:
      678            bh_tbl-name:find-first( v-where ) no-error .
      679         end.
      680         o-hn = bh_tbl-name.
      681      end.
      682   end procedure.
      683   procedure gen-hn-keyr :
      684     define input  parameter p-key-rec    as character no-undo.
      685     define input  parameter p-key-handle as handle    no-undo .
      686     define input  parameter p-db-name    as character no-undo .
      687     define input  parameter p-tt-handle  as handle    no-undo .
      688     define input  parameter p-stts-lock  as integer   no-undo .
      689     define output parameter o-hn         as handle    no-undo.
      690     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      691   end.
      692   procedure gen-row-keyr :
      693     define input  parameter p-key-rec    as character no-undo.
      694     define input  parameter p-key-handle as handle    no-undo .
      695     define input  parameter p-db-name    as character no-undo .
      696     define input  parameter p-tt-handle  as handle    no-undo .
      697     define input  parameter p-stts-lock  as integer   no-undo .
      698     define output parameter p-tbl-row    as rowid     no-undo.
      699     define output parameter p-tbl-name   as character no-undo.
      700     define variable vHn as handle no-undo.
      701       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      702       p-tbl-row = if vHn:available then vHn:rowid else ?.
      703       p-tbl-name =  vHn:table.
      704       delete object vHn no-error.
      705     if p-tbl-row = ? then do:
      706       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      707     end.
      708     else do:
      709       return.
      710     end.
      711   end procedure.
      712   procedure gen-key-fv :
      713     define input  parameter p-key-rec    as character no-undo .
      714     define output parameter p-field-list as character no-undo .
      715     define output parameter p-value-list as character no-undo.
      716     do
      717     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      718     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      719     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      720     :
      721       define variable v-full-tbl-name  as character no-undo .
      722       define variable bh_tbl-name      as handle    no-undo .
      723       define variable v-tbl-name       as character no-undo .
      724       define variable v-field-num      as integer   no-undo .
      725       define variable v-count-fld      as integer   no-undo .
      726       define variable v-inform         as character no-undo .
      727       define variable v-ind            as integer   no-undo .
      728       define variable v-idx-field-qnty as integer   no-undo .
      729       define variable v-delim-key      as character no-undo .
      730       if p-key-rec = ?
      731         or p-key-rec = "":U
      732       then do:
      733         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      734       end.
      735       assign
      736         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      737         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      738       .
      739       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      740       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      741       assign
      742         v-inform = bh_tbl-name:index-information(1)
      743         v-ind    = 2
      744       .
      745       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      746       on error undo, return error
      747       :
      748         assign
      749           v-inform = bh_tbl-name:index-information( v-ind )
      750           v-ind    = v-ind + 1
      751         .
      752       end.
      753       if v-inform = ?
      754         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      755         or entry( 3, v-inform, ",":U ) <> "1":U
      756       then do:
      757         delete object bh_tbl-name no-error.
      758         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      759       end.
      760       assign
      761         v-idx-field-qnty = num-entries( v-inform ) - 4
      762       .
      763       if v-idx-field-qnty < 2 then do:
      764         delete object bh_tbl-name no-error.
      765         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      766       end.
      767       assign
      768         p-field-list = "":U
      769         p-value-list = "":U
      770         v-delim-key  = "":U
      771         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      772         v-count-fld  = 0
      773       .
      774       block_where:
      775       do v-ind = 1 to v-idx-field-qnty by 2
      776       on error undo, return error
      777       :
      778         assign
      779           v-count-fld = v-count-fld + 1
      780         .
      781         if v-count-fld > v-field-num then do:
      782           leave block_where.
      783         end.
      784         assign
      785           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      786           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      787         .
      788         if v-ind = 1 then do:
      789           assign
      790             v-delim-key = chr(3)
      791           .
      792         end.
      793       end.
      794       delete object bh_tbl-name.
      795       if v-count-fld <> v-field-num then do:
      796         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      797       end.
      798     end.
      799   end procedure.
      800   procedure gen-key-field :
      801     define input  parameter p-table      as character no-undo .
      802     define output parameter p-field-list as character no-undo .
      803     do
      804     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      805     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      806     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      807     :
      808       define variable v-full-tbl-name  as character no-undo .
      809       define variable bh_tbl-name      as handle    no-undo .
      810       define variable v-tbl-name       as character no-undo .
      811       define variable v-field-num      as integer   no-undo .
      812       define variable v-count-fld      as integer   no-undo .
      813       define variable v-inform         as character no-undo .
      814       define variable v-ind            as integer   no-undo .
      815       define variable v-idx-field-qnty as integer   no-undo .
      816       define variable v-delim-key      as character no-undo .
      817       if p-table = ?
      818         or p-table = "":U
      819       then do:
      820         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      821       end.
      822       assign
      823         v-tbl-name      = p-table
      824         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      825       .
      826       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      827       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      828       assign
      829         v-inform = bh_tbl-name:index-information(1)
      830         v-ind    = 2
      831       .
      832       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      833       on error undo, return error
      834       :
      835         assign
      836           v-inform = bh_tbl-name:index-information( v-ind )
      837           v-ind    = v-ind + 1
      838         .
      839       end.
      840       if v-inform = ?
      841         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      842         or entry( 3, v-inform, ",":U ) <> "1":U
      843       then do:
      844         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      845       end.
      846       assign
      847         v-idx-field-qnty = num-entries( v-inform ) - 4
      848       .
      849       if v-idx-field-qnty < 2 then do:
      850         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      851       end.
      852       assign
      853         p-field-list = "":U
      854         v-delim-key  = "":U
      855         v-count-fld  = 0
      856       .
      857       block_where:
      858       do v-ind = 1 to v-idx-field-qnty by 2
      859       on error undo, return error
      860       :
      861         assign
      862           v-count-fld = v-count-fld + 1
      863         .
      864         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      865         if v-ind = 1 then do:
      866           assign
      867             v-delim-key = chr(3)
      868           .
      869         end.
      870       end.
      871       delete object bh_tbl-name.
      872     end.
      873   end procedure.
      874   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   define variable tempcxml_v-num_ as integer no-undo .
      877   define  temp-table temp-xml-tables no-undo
      878   field order as integer
      879   field tbl-name as character
      880   field tbl-handle_ as handle
      881   field table-handle_ as handle
      882   field uniq-gate-rec as character
      883   field gate-name as character
      884   field gate-handle_ as handle
      885   field is-parent as logical
      886   index pi is unique primary
      887   uniq-gate-rec
      888   tbl-name
      889   index iorder
      890   order
      891   index gr
      892   uniq-gate-rec
      893   index gh
      894   gate-handle_
      895   index iparent
      896   is-parent
      897   .
      898   define  temp-table temp-xml-records no-undo
      899   field tbl-name as character
      900   field uniq-key-rec as character
      901   index pi is unique primary
      902   tbl-name
      903   uniq-key-rec
      904   .
      905   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   procedure get-gate-file-name :
      907   define input parameter p-gate-rec as character no-undo .
      908   define output  parameter p-gate-file-name as character no-undo .
      909   define buffer buf_clob-data for ub.clob-data.
      910   define variable v-tbl-row as rowid no-undo .
      911   define variable v-tbl-name as character no-undo .
      912   run gen-row-keyr in this-procedure ( input p-gate-rec
      913                                       ,input ?
      914                                       ,input "ub"
      915                                       ,input ?
      916                                       ,input no-lock
      917                                       ,output v-tbl-row
      918                                       ,output v-tbl-name) no-error.
      919   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      920                                                           ,vss-include-info4
      921                                                           ,p-gate-rec).
      922   find first buf_clob-data no-lock where
      923             rowid(buf_clob-data) = v-tbl-row no-error.
      924   if not available buf_clob-data then do:
      925     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
      926                                                             ,vss-include-info4
      927                                                             ,p-gate-rec).
      928   end.
      929   p-gate-file-name = buf_clob-data.file-name.
      930   end procedure.
      931   procedure get-gate-rec :
      932   define input  parameter p-gate-name as character no-undo .
      933   define output parameter p-gate-rec as character no-undo .
      934   define buffer buf_clob-bind for ub.clob-bind.
      935   define buffer buf_clob-data for ub.clob-data.
      936   main-block:
      937   do
      938   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      939   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      940   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      941   :
      942       find first buf_clob-bind no-lock where
      943                 buf_clob-bind.uniq-key-rec = p-gate-name
      944             and buf_clob-bind.field-name = '':U
      945             and buf_clob-bind.part-num = 1
      946             and buf_clob-bind.resource-type = 'gate':U
      947             no-error.
      948       if not available buf_clob-bind then do:
      949         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      950                                         , p-gate-name
      951                                         ).
      952       end.
      953       find first buf_clob-data no-lock where
      954                 buf_clob-data.db-num = buf_clob-bind.db-num
      955             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
      956       if not available buf_clob-data then do:
      957         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
      958                                         , buf_clob-bind.db-num
      959                                         , buf_clob-bind.int64-id
      960                                         , p-gate-name
      961                                         ).
      962       end.
      963       run gen-key-rec in this-procedure ( input 'clob-data':U
      964                                 ,input buffer buf_clob-data:handle
      965                                 ,output p-gate-rec).
      966   end.
      967   end procedure.
      968   procedure get-gate-by-name :
      969   define input  parameter p-gate-name as character no-undo .
      970   define output parameter p-gate-rec as character no-undo .
      971   define output parameter p-dsh as handle no-undo .
      972   define input-output  parameter p-xmlh as handle no-undo .
      973   define variable v-ii as integer   no-undo .
      974   define variable glog as logical   no-undo .
      975   define variable v-longchar as longchar no-undo .
      976   define variable v-txmlh as handle no-undo .
      977   define variable v-db-num as integer no-undo .
      978   define variable v-int64-id as int64 no-undo .
      979   define buffer buf_clob-bind for ub.clob-bind.
      980   define buffer buf_clob-data for ub.clob-data.
      981   main-block:
      982   do
      983   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
      984   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
      985   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
      986   :
      987       find first buf_clob-bind no-lock where
      988                 buf_clob-bind.uniq-key-rec = p-gate-name
      989             and buf_clob-bind.field-name = '':U
      990             and buf_clob-bind.part-num = 1
      991             and buf_clob-bind.resource-type = 'gate':U
      992             no-error.
      993       if not available buf_clob-bind then do:
      994         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
      995                                         , p-gate-name
      996                                         ).
      997       end.
      998       find first buf_clob-data no-lock where
      999                 buf_clob-data.db-num = buf_clob-bind.db-num
     1000             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1001       if not available buf_clob-data then do:
     1002         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1003                                         , buf_clob-bind.db-num
     1004                                         , buf_clob-bind.int64-id
     1005                                         , p-gate-name
     1006                                         ).
     1007       end.
     1008       assign
     1009       v-longchar = buf_clob-data.cdata
     1010       .
     1011       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1012       if error-status :error then do:
     1013         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1014       end.
     1015       create dataset p-dsh .
     1016       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1017                                     , v-longchar
     1018                                     , ?
     1019                                     , ?
     1020                                     , ?
     1021                                     ) no-error.
     1022       v-longchar = '':U.
     1023       if error-status :error
     1024       or not glog
     1025       then do:
     1026         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1027       end.
     1028       if not valid-handle(p-xmlh)
     1029       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1030         create temp-table v-txmlh.
     1031         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1032         v-txmlh:temp-table-prepare("temp-xml-tables").
     1033         p-xmlh = v-txmlh:default-buffer-handle.
     1034       end.
     1035       run gen-key-rec in this-procedure ( input 'clob-data':U
     1036                                 ,input buffer buf_clob-data:handle
     1037                                 ,output p-gate-rec).
     1038       do v-ii = 1 to p-dsh:num-buffers:
     1039         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1040         if not p-xmlh:available then do:
     1041           p-xmlh:buffer-create().
     1042           assign
     1043           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1044           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1045           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1046           p-xmlh::gate-handle_ = p-dsh
     1047           p-xmlh::uniq-gate-rec = p-gate-rec
     1048           p-xmlh::gate-name = p-dsh:name
     1049           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1050           .
     1051           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1052             assign
     1053             p-xmlh::order = -3.
     1054           end.
     1055         end.
     1056       end.
     1057   end.
     1058   end procedure.
     1059   procedure get-gate-by-rec :
     1060   define input  parameter p-gate-rec as character no-undo .
     1061   define output parameter p-dsh as handle no-undo .
     1062   define input-output  parameter p-xmlh as handle no-undo .
     1063   define input-output parameter p-longchar  as longchar no-undo .
     1064   define variable v-ii as integer   no-undo .
     1065   define variable glog as logical   no-undo .
     1066   define variable v-rowid as rowid no-undo .
     1067   define variable v-tbl-name as character no-undo .
     1068   define variable v-longchar as longchar no-undo .
     1069   define variable v-txmlh as handle no-undo .
     1070   define buffer buf_clob-data for ub.clob-data.
     1071   main-block:
     1072   do
     1073   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1074   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1075   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1076   :
     1077     run gen-row-keyr in this-procedure (
     1078                                           input  p-gate-rec
     1079                                           ,input  ?
     1080                                           ,input  "ub"
     1081                                           ,input  ?
     1082                                           ,input  NO-LOCK
     1083                                           ,output v-rowid
     1084                                           ,output v-tbl-name   ) no-error.
     1085       find first buf_clob-data no-lock where
     1086                 rowid(buf_clob-data) = v-rowid  no-error.
     1087       if not available buf_clob-data then do:
     1088         undo, return error substitute("Не найден CLOB  &1"
     1089                                         , p-gate-rec
     1090                                         ).
     1091       end.
     1092       assign
     1093       v-longchar = buf_clob-data.cdata
     1094       .
     1095       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1096       if error-status :error then do:
     1097         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1098       end.
     1099       create dataset p-dsh .
     1100       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1101                                     , v-longchar
     1102                                     , ?
     1103                                     , ?
     1104                                     , ?
     1105                                     ) no-error.
     1106       define variable v-esm as character no-undo .
     1107       v-esm = error-status:get-message(1) .
     1108       if p-longchar <> ? then do:
     1109         p-longchar = v-longchar.
     1110       end.
     1111       v-longchar = '':U.
     1112       if error-status :error
     1113       or not glog
     1114       then do:
     1115         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1116                                      , p-gate-rec
     1117                                      , p-gate-rec
     1118                                      , v-esm
     1119                                      ).
     1120       end.
     1121       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1122       if not valid-handle(p-xmlh)
     1123       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1124         create temp-table v-txmlh.
     1125         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1126         v-txmlh:temp-table-prepare("temp-xml-tables").
     1127         p-xmlh = v-txmlh:default-buffer-handle.
     1128       end.
     1129       do v-ii = 1 to p-dsh:num-buffers:
     1130         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1131         if not p-xmlh:available then do:
     1132           p-xmlh:buffer-create().
     1133           assign
     1134           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1135           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1136           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1137           p-xmlh::gate-handle_ = p-dsh
     1138           p-xmlh::uniq-gate-rec = p-gate-rec
     1139           p-xmlh::gate-name = p-dsh:name
     1140           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1141           .
     1142           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1143             assign
     1144             p-xmlh::order = -3.
     1145           end.
     1146           p-xmlh:buffer-release().
     1147         end.
     1148       end.
     1149   end.
     1150   end procedure.
     1151   procedure get-gate-by-file :
     1152   define input  parameter p-schema-file-name as character no-undo .
     1153   define input  parameter p-gate-rec as character no-undo .
     1154   define output parameter p-dsh as handle no-undo .
     1155   define input-output  parameter p-xmlh as handle no-undo .
     1156   define variable v-ii as integer   no-undo .
     1157   define variable glog as logical   no-undo .
     1158   define variable v-rowid as rowid no-undo .
     1159   define variable v-tbl-name as character no-undo .
     1160   define variable v-longchar as longchar no-undo .
     1161   define variable v-txmlh as handle no-undo .
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1167   :
     1168       COPY-LOB
     1169       FROM  FILE p-schema-file-name
     1170       TO  OBJECT v-longchar
     1171       no-convert
     1172       NO-ERROR .
     1173       if error-status :error then do:
     1174           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1175                                     , p-schema-file-name
     1176                                 , chr(10)
     1177                                 , error-status:get-message(1) ).
     1178       end.
     1179       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1180       if error-status :error then do:
     1181         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1182       end.
     1183       create dataset p-dsh .
     1184       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1185                                     , v-longchar
     1186                                     , ?
     1187                                     , ?
     1188                                     , ?
     1189                                     ) no-error.
     1190       v-longchar = ''.
     1191       if error-status :error
     1192       or not glog
     1193       then do:
     1194         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1195                                      , p-schema-file-name
     1196                                      ,chr(10)
     1197                                      , error-status:get-message(1)
     1198                                      ).
     1199       end.
     1200       if not valid-handle(p-xmlh)
     1201       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1202         create temp-table v-txmlh.
     1203         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1204         v-txmlh:temp-table-prepare("temp-xml-tables").
     1205         p-xmlh = v-txmlh:default-buffer-handle.
     1206       end.
     1207       do v-ii = 1 to p-dsh:num-buffers:
     1208         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1209                                      ,p-dsh:get-buffer-handle(v-ii):name
     1210                                      ,p-gate-rec
     1211                                      )) no-error.
     1212         if not p-xmlh:available then do:
     1213           p-xmlh:buffer-create().
     1214           assign
     1215           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1216           p-xmlh::uniq-gate-rec = p-gate-rec
     1217           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1218           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1219           p-xmlh::gate-handle_ = p-dsh
     1220           p-xmlh::gate-name = p-dsh:name
     1221           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1222           .
     1223           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1224             assign
     1225             p-xmlh::order = -3.
     1226           end.
     1227           p-xmlh:buffer-release().
     1228         end.
     1229       end.
     1230   end.
     1231   end procedure.
     1232   procedure gate-clear :
     1233   define input  parameter p-dsh as handle no-undo .
     1234   define input  parameter p-xmlh as handle no-undo .
     1235   define variable v-dsh as handle no-undo .
     1236   define variable v-th as handle no-undo .
     1237     do
     1238     on error undo, return error return-value
     1239     :
     1240       if valid-handle(p-dsh) then do:
     1241         delete object p-dsh.
     1242         v-dsh = p-dsh.
     1243         p-dsh = ?.
     1244       end.
     1245       repeat while true:
     1246         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1247                            , share-lock) no-error.
     1248         if p-xmlh:available then do:
     1249           assign
     1250           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1251           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1252           and valid-handle(v-th)
     1253           and v-th:dynamic = yes
     1254           then do:
     1255             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1256             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1257           end.
     1258           p-xmlh:buffer-delete().
     1259         end.
     1260         else do:
     1261           leave.
     1262         end.
     1263       end.
     1264       if p-xmlh:dynamic = yes
     1265       and valid-handle(p-xmlh)
     1266       then do:
     1267         delete object p-xmlh:table-handle.
     1268         p-xmlh = ?.
     1269       end.
     1270       v-dsh = ?.
     1271     end.
     1272   end procedure.
     1273   procedure all-gates-clear :
     1274   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1275   do
     1276   on error undo, return error
     1277   :
     1278     for each buf_temp-xml-tables
     1279     break
     1280     by buf_temp-xml-tables.uniq-gate-rec
     1281     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1282     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1283     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1284     :
     1285         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1286           delete object buf_temp-xml-tables.gate-handle_.
     1287           buf_temp-xml-tables.gate-handle_ = ?.
     1288         end.
     1289         if valid-handle(buf_temp-xml-tables.table-handle_)
     1290         and buf_temp-xml-tables.table-handle_:dynamic = no
     1291         then do:
     1292           delete object buf_temp-xml-tables.table-handle_.
     1293           buf_temp-xml-tables.table-handle_ = ?.
     1294         end.
     1295         delete buf_temp-xml-tables.
     1296     end.
     1297   end.
     1298   end procedure.
     1299   procedure fix-schemalocation :
     1300   define input-output  parameter p-longchar as longchar no-undo .
     1301   DEFINE VARIABLE hdoc AS HANDLE.
     1302   DEFINE VARIABLE hroot AS HANDLE.
     1303   DEFINE VARIABLE hnode-child AS HANDLE.
     1304   DEFINE VARIABLE hnode-attr AS HANDLE.
     1305   define variable v-jj as integer   no-undo .
     1306   define variable ok as logical   no-undo .
     1307   define variable v-path1                    as character                no-undo .
     1308   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1309   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1310   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1311   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1312   define variable v-schema-location          as character                no-undo .
     1313   do
     1314   on error undo, return error return-value
     1315   :
     1316     CREATE X-DOCUMENT hdoc.
     1317     CREATE X-noderef hroot.
     1318     CREATE X-noderef hnode-child.
     1319     CREATE X-noderef hnode-attr.
     1320     hdoc:load("longchar", p-longchar, no) no-error.
     1321     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1322     hdoc:get-document-element(hroot).
     1323     _repeat:
     1324     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1325       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1326       if not ok then next.
     1327       if hNode-Child:local-name = "include"
     1328       then do:
     1329         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1330           v-schema-location = hnode-attr:node-value.
     1331           run gbl/filename.p (
     1332                           input "exe/" + hnode-attr:node-value
     1333                         ,output v-full-path1
     1334                         ,output v-path1
     1335                         ,output v-file-name1
     1336                         ,output v-file-name-no-ext1
     1337                         ,output v-file-name-ext1
     1338                         ) no-error .
     1339           if error-status :error then do:
     1340             delete object hnode-attr.
     1341             delete object hnode-child.
     1342             delete object hroot.
     1343             delete object hdoc.
     1344             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1345           end.
     1346         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1347         leave  _repeat.
     1348       end.
     1349     END.
     1350     hdoc:save("longchar", p-longchar).
     1351     delete object hnode-attr.
     1352     delete object hnode-child.
     1353     delete object hroot.
     1354     delete object hdoc.
     1355   end.
     1356   end procedure.
     1357   procedure gate-clb_fill-xml-tables :
     1358   define input parameter p-dsh as handle no-undo .
     1359   define input-output parameter p-xmlh as handle no-undo .
     1360   define variable v-ii as integer no-undo .
     1361     do
     1362     on error undo, return error
     1363     :
     1364       do v-ii = 1 to p-dsh:num-buffers:
     1365         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1366         if not p-xmlh:available then do:
     1367           p-xmlh:buffer-create().
     1368           assign
     1369           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1370           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1371           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1372           p-xmlh::gate-handle_ = p-dsh
     1373           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1374           p-xmlh::gate-name = p-dsh:name
     1375           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1376           .
     1377           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1378             assign
     1379             p-xmlh::order = -3.
     1380           end.
     1381           p-xmlh:buffer-release().
     1382         end.
     1383       end.
     1384     end.
     1385   end procedure.
     1386   procedure all-gates-empty :
     1387   define buffer buf_temp-xml-tables for temp-xml-tables.
     1388   do
     1389   on error undo, return error
     1390   :
     1391     for each buf_temp-xml-tables
     1392     break
     1393     by buf_temp-xml-tables.uniq-gate-rec
     1394     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1395     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1396     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1397     :
     1398       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1399         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1400       end.
     1401     end.
     1402   end.
     1403   end procedure.
     1404   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   define variable v-current-rep-code as character no-undo .
     1406   define variable v-current-doc-code as character no-undo .
     1407   define variable v-current-host-code as integer no-undo .
     1408   define variable v-current-obj-type as character no-undo .
     1409   define variable v-current-obj-code as integer no-undo .
     1410   define variable v-current-lock as integer no-undo .
     1411   define variable v-current-wait as integer no-undo .
     1412   define variable v-save as integer no-undo .
     1413   define variable v-esys-cmd-proc-handle as handle no-undo .
     1414   define variable v-esys-cmd-code as integer no-undo .
     1415   define variable log-file-name                as character      no-undo init "calc-rep.log".
     1416   define variable v-view-log                   as logical        no-undo .
     1417   define variable v-stop                       as logical        no-undo .
     1418   define variable v-current-db-num as integer no-undo .
     1419   define variable v-last-error-message as character no-undo .
     1420   define variable v-value-character as character no-undo .
     1421   define variable v-value-date as date no-undo .
     1422   define variable v-value-decimal as decimal no-undo .
     1423   define variable v-value-integer as integer no-undo .
     1424   define variable v-value-logical as logical no-undo .
     1425   define variable v-p-index as integer no-undo .
     1426   define variable v-dirs as character no-undo .
     1427   define variable v-sign as integer no-undo .
     1428   define variable v-type as character no-undo .
     1429   define variable l-res as integer no-undo .
     1430   define variable v-es as logical no-undo .
     1431   define variable v-esm as character no-undo .
     1432   define variable v-rv as character no-undo .
     1433   define variable v-xmlh as handle no-undo .
     1434   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1435   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1436   define buffer buf_temp-xml-tables for temp-xml-tables.
     1437   v-xmlh = buffer buf_temp-xml-tables:handle.
     1438   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1439   procedure write-to-screen :
     1440   define input param p-str as character no-undo .
     1441   run write-log-and-file in p-log-handle (
     1442         input 1
     1443       , input log-file-name
     1444       , input 1
     1445       , input p-str).
     1446   end procedure.
     1447   procedure write-to-log :
     1448   define input param p-str as character no-undo .
     1449   run write-log-and-file in p-log-handle (
     1450         input 1
     1451       , input log-file-name
     1452       , input 1
     1453       , input p-str).
     1454   end procedure.
     1455   procedure write-to-log-notime :
     1456   define input param p-str as character no-undo .
     1457   run write-log-and-file in p-log-handle (
     1458         input 1
     1459       , input log-file-name
     1460       , input 1
     1461       , input p-str).
     1462   end procedure.
     1463   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   procedure set-error :
     1465   define input parameter p-mess as character no-undo .
     1466     do
     1467     on error undo, return error
     1468     :
     1469        assign
     1470        v-last-error-message = p-mess.
     1471     end.
     1472   end procedure.
     1473   define variable p-esys-id as integer no-undo .
     1474   define variable p-xsd-file as character no-undo.
     1475   define variable p-dataseth as handle no-undo .
     1476   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1477   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1478   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1479   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   function octal-to-char return character
     1481   ( p-string as character ) :
     1482     def var v-asc     as integer no-undo .
     1483     def var v-new-asc as integer no-undo .
     1484     def var ind       as integer no-undo .
     1485     if length(p-string) <> 3 then do:
     1486       return ? .
     1487     end.
     1488     assign
     1489       v-asc = 0
     1490     .
     1491     do ind = 1 to length(p-string)
     1492     :
     1493       assign
     1494         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     1495       .
     1496       if v-new-asc < 0 or v-new-asc >= 8 then do:
     1497         return ? .
     1498       end.
     1499       assign
     1500         v-asc = v-asc * 8 + v-new-asc
     1501       .
     1502     end.
     1503     return chr(v-asc) .
     1504   end function .
     1505   function char-to-octal return character
     1506   ( p-chr as character ) :
     1507     def var v-asc    as integer   no-undo .
     1508     def var ind      as integer   no-undo .
     1509     def var v-string as character no-undo .
     1510     if length(p-chr) <> 1 then do:
     1511       return ? .
     1512     end.
     1513     assign
     1514       v-asc    = asc(p-chr)
     1515       v-string = ""
     1516     .
     1517     do ind = 1 to 3
     1518     :
     1519       assign
     1520         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     1521       .
     1522       assign
     1523         v-asc = truncate(v-asc / 8, 0)
     1524       .
     1525     end.
     1526     return v-string .
     1527   end.
     1528   function str-encode return character
     1529   (   p-init-string       as character
     1530     , p-encode-char       as character
     1531     , p-special-char-list as character
     1532   ) :
     1533     def var p-encode-string as character no-undo .
     1534     def var ind                as integer no-undo .
     1535     def var v-num-special-char as integer no-undo .
     1536     def var v-special-char     as character no-undo .
     1537     if p-encode-char = ?
     1538     or p-encode-char = "" then do:
     1539       assign
     1540         p-encode-char = "~~"
     1541       .
     1542     end.
     1543     if p-init-string = ? then do:
     1544       return "?" .
     1545     end.
     1546     if p-init-string = "?" then do:
     1547       return p-encode-char + char-to-octal("?") .
     1548     end.
     1549     assign
     1550       v-num-special-char = length(p-special-char-list)
     1551       p-encode-string    = replace(p-init-string
     1552                                   ,p-encode-char
     1553                                   ,p-encode-char + char-to-octal(p-encode-char)
     1554                                   )
     1555     .
     1556     do ind = 1 to v-num-special-char
     1557     :
     1558       assign
     1559         v-special-char = substring(p-special-char-list, ind, 1)
     1560       .
     1561       if v-special-char <> p-encode-char then do:
     1562         assign
     1563           p-encode-string = replace (p-encode-string
     1564                                     ,v-special-char
     1565                                     ,p-encode-char + char-to-octal(v-special-char)
     1566                                     )
     1567         .
     1568       end.
     1569     end.
     1570     return p-encode-string .
     1571   end.
     1572   function str-decode returns character
     1573     (p-init-string   as character
     1574     ,p-encode-char   as character
     1575     ) :
     1576     def var p-decode-string as character no-undo .
     1577     def var ind                       as integer no-undo .
     1578     def var v-num-entries-init-string as integer no-undo .
     1579     def var v-sub-phrase              as character no-undo .
     1580     def var v-special-char            as character no-undo .
     1581     if p-encode-char = ?
     1582     or p-encode-char = "" then do:
     1583       assign
     1584         p-encode-char = "~~"
     1585       .
     1586     end.
     1587     if p-init-string = "?" then do:
     1588       return ? .
     1589     end.
     1590     assign
     1591       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     1592     .
     1593     if v-num-entries-init-string > 1 then do:
     1594       assign
     1595         p-decode-string = entry(1, p-init-string, p-encode-char)
     1596       .
     1597       do ind = 2 to v-num-entries-init-string
     1598       :
     1599         assign
     1600           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     1601         .
     1602         assign
     1603           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     1604         .
     1605         if v-special-char <> ? then do:
     1606           assign
     1607             p-decode-string = p-decode-string
     1608                             + v-special-char
     1609                             + substring(v-sub-phrase, 4)
     1610           .
     1611         end.
     1612         else do:
     1613           assign
     1614             p-decode-string = p-decode-string
     1615                             + p-encode-char
     1616                             + v-sub-phrase
     1617           .
     1618         end.
     1619       end.
     1620     end.
     1621     else do:
     1622       assign
     1623         p-decode-string = p-init-string
     1624       .
     1625     end.
     1626     return p-decode-string .
     1627   end.
     1628   function context_begin-nws2esys-command return logical
     1629   (
     1630       input p-esys-id as integer
     1631      ,input p-db-num-export as integer
     1632      ,input p-uniq-gate-rec as character
     1633      ,input-output p-esys-cmd-proc-handle as handle
     1634      ,output p-esys-cmd-code as integer
     1635   ):
     1636      define variable v-command-name as character no-undo .
     1637      define variable v-dst-list as character no-undo .
     1638      if g#db-num = p-db-num-export
     1639      then do:
     1640         v-command-name = 'cmd-esys-general':U.
     1641         v-dst-list = string(p-esys-id).
     1642      end.
     1643      else do:
     1644         v-command-name = substitute("&2&1&3&1&4&1&5"
     1645                                   ,chr(6)
     1646                                   ,'cmd-nws2esys-general':U
     1647                                   ,p-esys-id
     1648                                   ,p-db-num-export
     1649                                   ,str-encode( p-uniq-gate-rec
     1650                                   , ""
     1651                                   , chr(3))
     1652                                 ).
     1653         if g#db-num > 0
     1654         then do:
     1655            v-dst-list = string(0).
     1656         end.
     1657         else do:
     1658            v-dst-list = string(p-db-num-export).
     1659         end.
     1660      end.
     1661      if not valid-handle(p-esys-cmd-proc-handle )
     1662      then do:
     1663         run nws/cmd-bush.p persistent set p-esys-cmd-proc-handle no-error .
     1664         if error-status :error
     1665         then do:
     1666            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1667                                           "&5&4&6"
     1668                                           ,vss-workfile
     1669                                           ,vss-revision
     1670                                           ,vss-description
     1671                                           ,chr(10)
     1672                                           ,error-status:get-message(1)
     1673                                           ,return-value )).
     1674         end.
     1675         run begin-create-command in p-esys-cmd-proc-handle
     1676            (input v-command-name
     1677            ,input v-dst-list
     1678            ,output p-esys-cmd-code
     1679         ) no-error.
     1680         if error-status :error
     1681         then do:
     1682            delete procedure p-esys-cmd-proc-handle no-error.        run set-error in this-procedure ( input substitute("Ошибка при создании команды &1&2&3&1&4"
     1683                                                     , 'cmd-nws2esys-general':U
     1684                                                     , error-status:get-message(1)
     1685                                                     , return-value
     1686                                                     )).
     1687            return no .
     1688         end.
     1689         return yes.
     1690      end.
     1691   end.
     1692   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   function context_send-nws2esys-command return logical
     1694   (
     1695       input p-esys-id as integer
