     1116   .
     1117   procedure tmpreldf_get-relations :
     1118   define input parameter p-dataseth as handle no-undo .
     1119   define variable v-ii as integer no-undo .
     1120   define buffer buf_temp-rel-handle for temp-rel-handle.
     1121   do
     1122   on error undo, return error
     1123   :
     1124     if not valid-handle(p-dataseth)
     1125     or p-dataseth:type <> "DATASET"
     1126     then do:
     1127       return error substitute("Не определен dataset с handle &1", p-dataseth).
     1128     end.
     1129     for each buf_temp-rel-handle where
     1130             buf_temp-rel-handle.dh = p-dataseth:
     1131       delete buf_temp-rel-handle.
     1132     end.
     1133     do v-ii = 1 to p-dataseth:num-relations:
     1134       create buf_temp-rel-handle.
     1135       assign
     1136       buf_temp-rel-handle.ii = v-ii
     1137       buf_temp-rel-handle.dh = p-dataseth
     1138       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     1139       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     1140       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     1141       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     1142       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     1143       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     1144       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     1145       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     1146       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     1147       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     1148       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     1149       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     1150       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     1151       .
     1152     end.
     1153   end.
     1154   end procedure.
     1155   procedure tmpreldf_set-relations :
     1156   define input parameter p-srcdataseth as handle no-undo .
     1157   define input parameter p-trgdataseth as handle no-undo .
     1158   define variable gh as handle no-undo .
     1159   define buffer buf_temp-rel-handle for temp-rel-handle.
     1160   do
     1161   on error undo, return error
     1162   :
     1163     if not valid-handle(p-srcdataseth)
     1164     or p-srcdataseth:type <> "DATASET"
     1165     then do:
     1166       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     1167     end.
     1168     if not valid-handle(p-trgdataseth)
     1169     or p-trgdataseth:type <> "DATASET"
     1170     then do:
     1171       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     1172     end.
     1173     for each buf_temp-rel-handle no-lock where
     1174             buf_temp-rel-handle.dh = p-srcdataseth
     1175     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1176     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1177     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1178     :
     1179       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     1180                                         , buf_temp-rel-handle.child-buffer-handle
     1181                                         , buf_temp-rel-handle.relation-fields_
     1182                                         , buf_temp-rel-handle.reposition_
     1183                                         , buf_temp-rel-handle.nested_).
     1184      if error-status:error
     1185      or not valid-handle(gh) then do:
     1186        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     1187      end.
     1188     end.
     1189   end.
     1190   end procedure.
     1191   procedure tmpreld2_query :
     1192   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     1193   define input-output parameter p-child-qh as handle no-undo .
     1194   define variable glog as logical no-undo .
     1195   define variable v-mess as character no-undo .
     1196   _main:
     1197   do
     1198   on error undo, return error
     1199   :
     1200     create query p-child-qh .
     1201     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     1202     if error-status:error
     1203     or
     1204     not glog then do:
     1205       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     1206                           , buf_temp-rel-handle.child-buffer_
     1207                           , chr(10)
     1208                           , error-status:get-message(1)
     1209                           ).
     1210       delete object p-child-qh no-error.
     1211       undo _main, return error v-mess.
     1212     end.
     1213     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     1214                                               , buf_temp-rel-handle.child-buffer_
     1215                                               , buf_temp-rel-handle.where-string_
     1216                                               )) no-error .
     1217     if error-status:error
     1218     or
     1219     not glog then do:
     1220       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     1221                           , buf_temp-rel-handle.child-buffer_
     1222                           , chr(10)
     1223                           , error-status:get-message(1)
     1224                           ).
     1225       delete object p-child-qh no-error.
     1226       undo _main, return error v-mess.
     1227     end.
     1228     glog = p-child-qh:query-open no-error .
     1229     if error-status:error
     1230     or
     1231     not glog then do:
     1232       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     1233                           , buf_temp-rel-handle.child-buffer_
     1234                           , chr(10)
     1235                           , error-status:get-message(1)
     1236                           ).
     1237       delete object p-child-qh no-error.
     1238       undo _main, return error v-mess.
     1239     end.
     1240   end.
     1241   end procedure.
     1242   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   procedure factord :
     1244     define input  parameter p-fact-date            as date    no-undo .
     1245     define input  parameter p-fact-time            as integer no-undo .
     1246     define input  parameter p-fact-num             as integer no-undo .
     1247     define input  parameter p-shift-date           as date    no-undo .
     1248     define input  parameter p-shift-num            as integer no-undo .
     1249     define input  parameter p-shift-on             as logical no-undo .
     1250     define output parameter p-fact-order           as decimal no-undo .
     1251     define output parameter p-shift-end-fact-order as decimal no-undo .
     1252     define output parameter p-day-end-fact-order   as decimal no-undo .
     1253     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1254     if p-fact-date = ?
     1255     then do:
     1256       return error "Не указана фактическая дата" .
     1257     end.
     1258     define variable v-fact-date-num as integer no-undo .
     1259     assign
     1260       v-fact-date-num = integer(p-fact-date)
     1261     .
     1262     if p-fact-num = ?
     1263     or p-fact-num = 0
     1264     then do:
     1265       return error "Не задан p-fact-num " + string(p-fact-num) .
     1266     end.
     1267     if p-fact-num < 0
     1268     then do:
     1269       return error "Отрицательный fact-num " + string(p-fact-num) .
     1270     end.
     1271     if p-fact-num >= 100000000
     1272     then do:
     1273       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1274     end.
     1275     if p-shift-on = true
     1276     then do:
     1277       if p-shift-date = ?
     1278       then do:
     1279         return error "Не задана дата смены" .
     1280       end.
     1281       if p-shift-num = ?
     1282       or p-shift-num = 0
     1283       then do:
     1284         return error "Не задан номер смены" .
     1285       end.
     1286     end.
     1287     else do:
     1288       assign
     1289         p-shift-date = p-fact-date
     1290         p-shift-num  = 24
     1291       .
     1292     end.
     1293     define variable v-shift-offset as integer no-undo .
     1294     if p-shift-date = p-fact-date
     1295     then do:
     1296       assign
     1297         v-shift-offset = 1
     1298       .
     1299     end.
     1300     if p-shift-date < p-fact-date
     1301     then do:
     1302       assign
     1303         v-shift-offset = 0
     1304       .
     1305     end.
     1306     if p-shift-date > p-fact-date
     1307     then do:
     1308       message
     1309         vss-workfile vss-revision vss-description skip
     1310         "Неправильная дата закрытия смены" skip
     1311         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1312         view-as alert-box error .
     1313       undo, return error
     1314         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1315           ,string(p-fact-date, '99/99/9999':U)
     1316           ,string(p-shift-date, '99/99/9999':U)
     1317           )
     1318       .
     1319     end.
     1320     if p-shift-num < 1
     1321     or p-shift-num > 24
     1322     then do:
     1323       message
     1324         vss-workfile vss-revision vss-description skip
     1325         "Неправильный номер смены" skip
     1326         "p-shift-num" p-shift-num skip
     1327         view-as alert-box error .
     1328       undo, return error return-value .
     1329     end.
     1330     assign
     1331       p-fact-order           = v-fact-date-num
     1332                              + v-shift-offset * 0.5
     1333                              + p-shift-num    * 0.02 - 0.01
     1334                              + p-fact-num     * 0.0000000001
     1335       p-shift-end-fact-order = v-fact-date-num
     1336                              + v-shift-offset * 0.5
     1337                              + p-shift-num    * 0.02
     1338       p-day-end-fact-order   = v-fact-date-num
     1339                              + 0.99
     1340     .
     1341     if p-fact-order           <= v-fact-date-num
     1342     or p-shift-end-fact-order <= v-fact-date-num
     1343     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1344     or p-shift-end-fact-order >= p-day-end-fact-order
     1345     then do:
     1346       message
     1347         vss-workfile vss-revision vss-description skip
     1348         "Внутренняя ошибка при генерации фактического номера" skip
     1349         "p-fact-date"            p-fact-date            skip
     1350         "p-fact-time"            p-fact-time            skip
     1351         "p-fact-num"             p-fact-num             skip
     1352         "p-shift-date"           p-shift-date           skip
     1353         "p-shift-num"            p-shift-num            skip
     1354         "p-shift-on"             p-shift-on             skip
     1355         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1356         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1357         "v-fact-date-num"        v-fact-date-num        skip
     1358         view-as alert-box error .
     1359       undo, return error return-value .
     1360     end.
     1361   end procedure.
     1362   procedure day-begin-fact-order :
     1363     define input  parameter p-fact-date            as date    no-undo .
     1364     define output parameter p-day-begin-fact-order as decimal no-undo .
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368       if p-fact-date = ?
     1369       then do:
     1370         assign
     1371           p-day-begin-fact-order = 0
     1372         .
     1373       end.
     1374       else do:
     1375         assign
     1376           p-day-begin-fact-order = integer(p-fact-date)
     1377         .
     1378       end.
     1379     end.
     1380   end procedure.
     1381   procedure factord-max-fact-order :
     1382     define output parameter p-max-fact-order as decimal   no-undo .
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       run day-begin-fact-order in this-procedure
     1387         (input  date(1, 1, 5000)
     1388         ,output p-max-fact-order
     1389         ) .
     1390     end.
     1391   end procedure.
     1392   procedure factord-cut-archive :
     1393     define input  parameter p-obj-type             as character no-undo .
     1394     define input  parameter p-obj-code             as integer   no-undo .
     1395     define input  parameter p-fact-date            as date      no-undo .
     1396     define output parameter p-shift-on             as logical   no-undo .
     1397     define output parameter p-shift-date           as date      no-undo .
     1398     define output parameter p-shift-num            as integer   no-undo .
     1399     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1400     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1401     define variable v-fact-order as decimal   no-undo .
     1402     define buffer buf_shift-obj for ub.shift-obj .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1408     (input  p-obj-type
     1409     ,input  p-obj-code
     1410     ,input  'shift-on=request'
     1411     ,output p-shift-on
     1412     ) no-error .
     1413       if error-status :error
     1414       then do:
     1415         message
     1416           vss-workfile vss-revision vss-description skip
     1417           "Ошибка при определении атрибута объекта" skip
     1418           "Объект" p-obj-type p-obj-code skip
     1419           error-status :get-message(1) skip
     1420           return-value skip
     1421           view-as alert-box error .
     1422         undo, return error return-value .
     1423       end.
     1424       if p-shift-on = false
     1425       then do:
     1426         assign
     1427           p-shift-date               = ?
     1428           p-shift-num                = 0
     1429         .
     1430       end.
     1431       else do:
     1432         find first buf_shift-obj share-lock
     1433           where buf_shift-obj.obj-type   = p-obj-type
     1434             and buf_shift-obj.obj-code   = p-obj-code
     1435             and buf_shift-obj.shift-date > p-fact-date
     1436           use-index pi
     1437           no-error .
     1438         if not available buf_shift-obj
     1439         or buf_shift-obj.status_ <> 'зкр':U
     1440         then do:
     1441           message
     1442             vss-workfile vss-revision vss-description skip
     1443             "Невозможно вычислить последнюю смену" skip
     1444             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1445             "Объект" p-obj-type p-obj-code skip
     1446             "Дата" p-fact-date skip
     1447             view-as alert-box error .
     1448           undo, return error return-value .
     1449         end.
     1450         find last buf_shift-obj share-lock
     1451           where buf_shift-obj.obj-type = p-obj-type
     1452             and buf_shift-obj.obj-code = p-obj-code
     1453             and buf_shift-obj.shift-date <= p-fact-date
     1454           use-index pi
     1455           no-error .
     1456         if available buf_shift-obj
     1457         then do:
     1458           if  buf_shift-obj.status_ = 'зкр':U
     1459           then do:
     1460             assign
     1461               p-shift-date = buf_shift-obj.shift-date
     1462               p-shift-num  = buf_shift-obj.shift-num
     1463             .
     1464           end.
     1465           else do:
     1466             message
     1467               vss-workfile vss-revision vss-description skip
     1468               "Невозможно вычислить последнюю смену" skip
     1469               "Статус смены отличен от статуса" 'зкр':U skip
     1470               "Объект" p-obj-type p-obj-code skip
     1471               "Дата" p-fact-date skip
     1472               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1473               view-as alert-box error .
     1474             undo, return error return-value .
     1475           end.
     1476         end.
     1477         else do:
     1478           assign
     1479             p-shift-date = p-fact-date - 1
     1480             p-shift-num  = 1
     1481           .
     1482         end.
     1483       end.
     1484       run factord in this-procedure
     1485         (input  p-fact-date
     1486         ,input  1
     1487         ,input  1
     1488         ,input  p-shift-date
     1489         ,input  p-shift-num
     1490         ,input  p-shift-on
     1491         ,output v-fact-order
     1492         ,output p-shift-end-fact-order
     1493         ,output p-day-end-fact-order
     1494         ) no-error .
     1495       if error-status :error
     1496       then do:
     1497         message
     1498           vss-workfile vss-revision vss-description skip
     1499           "Ошибка при вызове процедуры factord"
     1500           error-status :get-message(1) skip
     1501           return-value skip
     1502           view-as alert-box error .
     1503         undo, return error return-value .
     1504       end.
     1505     end.
     1506   end procedure.
     1507   procedure factord-lock-shift :
     1508     define input  parameter p-obj-type  as character no-undo .
     1509     define input  parameter p-obj-code  as integer   no-undo .
     1510     define input  parameter p-fact-date as date      no-undo .
     1511     define parameter buffer buf_shift-obj for ub.shift-obj .
     1512     define variable v-shift-on      as logical   no-undo .
     1513     define variable v-extra-message as character no-undo .
     1514     define variable v-error as character no-undo .
     1515     do
     1516     on error undo, return error return-value
     1517     :
     1518   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1520     (input  p-obj-type
     1521     ,input  p-obj-code
     1522     ,input  'shift-on=request'
     1523     ,output v-shift-on
     1524     ) no-error .
     1525       if error-status :error
     1526       then do:
     1527         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1528         undo, return error v-error .
     1529       end.
     1530       if v-shift-on = true
     1531       then do:
     1532         find first buf_shift-obj share-lock
     1533           where buf_shift-obj.obj-type   = p-obj-type
     1534             and buf_shift-obj.obj-code   = p-obj-code
     1535             and buf_shift-obj.shift-date > p-fact-date
     1536           use-index pi
     1537           no-error .
     1538         if not available buf_shift-obj
     1539         or buf_shift-obj.status_ <> 'зкр':U
     1540         then do:
     1541           find last buf_shift-obj
     1542             where buf_shift-obj.obj-type = p-obj-type
     1543               and buf_shift-obj.obj-code = p-obj-code
     1544               and buf_shift-obj.status_  = 'зкр':U
     1545             use-index stts
     1546             no-error .
     1547           if available buf_shift-obj
     1548           then do:
     1549             assign
     1550               v-extra-message =
     1551                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1552                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1553                               )
     1554             .
     1555           end.
     1556           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1557           undo, return error v-error .
     1558         end.
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure factord-end-day :
     1563     define input  parameter p-fact-date            as date    no-undo .
     1564     define output parameter p-day-end-fact-order   as decimal no-undo .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       if p-fact-date = ?
     1569       then do:
     1570         return error "Не указана фактическая дата" .
     1571       end.
     1572       assign
     1573         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1574       .
     1575     end.
     1576   end procedure.
     1577   procedure factord-to-date :
     1578     define input  parameter p-fact-order as decimal no-undo .
     1579     define output parameter p-fact-date  as date    no-undo .
     1580     define variable v-ref-date  as date      no-undo .
     1581     define variable v-ref-delta as integer   no-undo .
     1582     do
     1583     on error undo, return error return-value
     1584     :
     1585       if p-fact-order = ?
     1586       or p-fact-order = 0
     1587       then do:
     1588         return error "Не указан fact-order" .
     1589       end.
     1590       assign
     1591         v-ref-date  = date(1, 1, 2000)
     1592       .
     1593       assign
     1594         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1595       .
     1596       assign
     1597         p-fact-date = v-ref-date + v-ref-delta
     1598       .
     1599     end.
     1600   end procedure.
     1601   procedure factord-to-fact-num :
     1602     define input  parameter p-fact-order as decimal no-undo .
     1603     define output parameter p-fact-num   as integer no-undo .
     1604     define variable v-fact-order-trunc as decimal no-undo .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       if p-fact-order = ?
     1609       or p-fact-order = 0
     1610       then do:
     1611         return error "Не указан fact-order" .
     1612       end.
     1613       assign
     1614        v-fact-order-trunc = truncate(p-fact-order, 2)
     1615       .
     1616       assign
     1617         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1618       .
     1619     end.
     1620   end procedure.
     1621   procedure factord-to-shift-num :
     1622     define input  parameter p-fact-order as decimal no-undo .
     1623     define output parameter p-shift-num   as integer no-undo .
     1624     define variable  p-shift-numd  as decimal   no-undo .
     1625     define variable v-fact-order-trunc as decimal no-undo .
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       if p-fact-order = ?
     1630       or p-fact-order = 0
     1631       then do:
     1632         return error "Не указан fact-order" .
     1633       end.
     1634       assign
     1635        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1636       .
     1637       if v-fact-order-trunc < 0.5 then do:
     1638         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1639       end.
     1640       assign
     1641         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1642         .
     1643        assign
     1644         p-shift-num = truncate (p-shift-numd , 0)
     1645       .
     1646     end.
     1647   end procedure.
