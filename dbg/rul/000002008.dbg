     1096   define temp-table temp-rel-handle no-undo
     1097   field dh as handle
     1098   field ii as integer
     1099   field active_ as logical
     1100   field child-buffer_ as character
     1101   field parent-buffer_ as character
     1102   field child-buffer-handle as handle
     1103   field parent-buffer-handle as handle
     1104   field name_ as character
     1105   field nested_ as logical
     1106   field relation-fields_ as character
     1107   field reposition_ as logical
     1108   field type_ as character
     1109   field query_ as handle
     1110   field where-string_ as character
     1111   field tbl-handle_ as handle
