     1713   procedure clear_tt :
     1714     do
     1715     on error  undo, return error substitute( "&1 (clear-tt). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1716     on stop   undo, return error substitute( "&1 (clear-tt). stop", vss-workfile )
     1717     on endkey undo, return error substitute( "&1 (clear-tt). endkey", vss-workfile )
     1718     :
     1719       for each temp-tax-rate
     1720       on error undo, next
     1721       :
     1722         delete temp-tax-rate .
     1723       end.
     1724       for each temp-tax-rate-value
     1725       on error undo, next
     1726       :
     1727         delete temp-tax-rate-value .
     1728       end.
     1729     end.
     1730   end procedure.
     1731   function 00200004_get-error-message returns character :
     1732   define variable v-ii as integer no-undo .
     1733   define variable v-mess as character no-undo .
     1734   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1735       v-mess = substitute("&1&2ош &3"
     1736                           ,v-mess
     1737                           ,chr(10)
     1738                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     1739   END.
     1740   end function.
     1741     define variable p-esys-id  as integer no-undo.
     1742     define variable p-xsd-file as character no-undo.
     1743   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1744   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1745   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1746   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1747   function context_get-thobj-es return logical
     1748   (
     1749      input p-esys-id as integer
     1750     ,input p-eobj-type as character
     1751     ,input p-eobj-code as integer
     1752     ,output p-obj-type as character
     1753     ,output p-obj-code as integer
     1754   ):
     1755      define variable v-value-list as character no-undo .
     1756      define variable v-field-list as character no-undo .
     1757      define buffer buf_clients for ub.clients.
     1758      define buffer buf_ext-classif for ub.ext-classif.
     1759      find first buf_ext-classif no-lock where
     1760                buf_ext-classif.classif-name = 'clients-esys':U
     1761            and buf_ext-classif.classif-subject = 'clients':U
     1762            and buf_ext-classif.db-num = 0
     1763            and buf_Ext-classif.key#_one = p-esys-id
     1764            and buf_Ext-classif.charkey_one = p-eobj-type
     1765            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1766      if available buf_Ext-classif
     1767      then do:
     1768         ObjSrv:Lib:KeyRec:GenKeyFv (
     1769                                         input buf_Ext-classif.uniq-key-rec
     1770                                         ,output v-field-list
     1771                                         ,output v-value-list).
     1772         assign
     1773            p-obj-type = entry(lookup("obj-type":U
     1774                                     , v-field-list
     1775                                     , chr(3))
     1776                                     , v-value-list, chr(3))
     1777            p-obj-code = integer(entry(lookup("obj-code":U
     1778                                            , v-field-list
     1779                                            , chr(3))
     1780                                      , v-value-list
     1781                                      , chr(3)))
     1782         no-error .
     1783      end.
     1784      if     available buf_ext-classif
     1785         and (p-obj-type = 'маг':U
     1786              or
     1787              p-obj-type = 'скл':U
     1788              )
     1789         and (p-obj-code > 0 and p-obj-code <= 99999)
     1790      then do:
     1791         find first buf_clients no-lock where
     1792                    buf_clients.obj-type = p-obj-type
     1793                and buf_clients.obj-code = p-obj-code no-error.
     1794         if available buf_clients then do:
     1795            return yes.
     1796         end.
     1797         else do:
     1798            assign
     1799               p-obj-type = '':U
     1800               p-obj-code = 0
     1801            .
     1802            return no.
     1803         end.
     1804      end.
     1805      else do:
     1806         assign
     1807            p-obj-type = '':U
     1808            p-obj-code = 0
     1809         .
     1810         return no.
     1811      end.
     1812   end.
     1813   on delete of this-procedure do:
     1814     run delete-procedure in this-procedure .
     1815   end.
     1816   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     1817   if error-status:error
     1818   or return-value = "return" then return.
     1819    define variable ImpData1 as class Route-data_ no-undo .
     1820   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     1821   if not this-procedure:persistent then do:
     1822     run proc-main in this-procedure  no-error .
     1823     if error-status:error then do:
     1824         run delete-procedure in this-procedure .
     1825         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1826     end.
     1827     run delete-procedure in this-procedure .
     1828   end.
     1829   procedure proc-main :
     1830   define variable v-ii               as   integer                      no-undo .
     1831   define variable v-tax-code         like ub.tax-rate.tax-code         no-undo .
     1832   define variable v-rate-code        like ub.tax-rate.rate-code        no-undo .
     1833   define variable v-rate-name        like ub.tax-rate.rate-name        no-undo .
     1834   define variable v-rate-value       like ub.tax-rate-value.rate-value no-undo .
     1835   define variable v-fact-date        like ub.tax-rate-value.fact-date  no-undo .
     1836   define variable v-status           as   character                    no-undo .
     1837   define variable v-line-num         as   integer                      no-undo .
     1838   define variable v-present          as   logical                      no-undo .
     1839   define variable v-current-tbl-name as   character                    no-undo .
     1840   define buffer buf_ext-system for ub.ext-system.
     1841   if transaction then do:
     1842     message
     1843       vss-workfile vss-revision vss-description skip
     1844       substitute("Вызов процедуры в действующей транзакции недопустим") skip
     1845       view-as alert-box error .
     1846     return error substitute( "&1 (proc-main). Вызов процедуры в действующей транзакции недопустим", vss-workfile ) .
     1847   end.
     1848   _main:
     1849   do transaction
     1850   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1851   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1852   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1853   :
     1854   assign
     1855     v-tax-code  = integer('1':U)
     1856   .
     1857   run write-log  in p-log-handle (
     1858                                    input 0
     1859                                  , "&DLine").
     1860     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по налогам из ВС")).                      assign v-view-log = yes.
     1861     run write-log-and-file in p-log-handle (
     1862         input 1
     1863       , input log-file-name
     1864       , input 1
     1865       , input substitute("Импорт данных по налогам из файла &1", file-name)).
     1866       find first buf_ext-system no-lock where
     1867                 buf_ext-system.esys-id = p-esys-id
     1868             and buf_ext-system.db-num = 0 no-error.
     1869       if not available buf_ext-system
     1870       or not (buf_ext-system.esys-type  = integer('3':U)) then do:
     1871              run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа ORACLE RETAIL", p-esys-id)).                      assign v-view-log = yes.
     1872          undo _main, return error ''.
     1873       end.
     1874     assign
     1875       num-rec          = 0
     1876       num-rec-ok       = 0
     1877       num-rec-ok2      = 0
     1878     .
     1879     _table:
     1880     for each buf_temp-xml-tables where
     1881             buf_temp-xml-tables.order >= 0
     1882         and buf_temp-xml-tables.is-parent = true
     1883     on error undo _table, retry _table
     1884     :
     1885       if retry then do:
     1886               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                               , buf_temp-xml-tables.tbl-name                                                               , chr(10)                                                               , error-status:get-message(1)                                                               , return-value)).                      assign v-view-log = yes.
     1887         run delete-procedure in this-procedure .
     1888         if valid-handle(v_qh) then do:
     1889           delete object v_qh no-error.
     1890         end.
     1891         undo _main, return error ''.
     1892       end.
     1893       if buf_temp-xml-tables.tbl-name = "THheader" then next.
     1894     create query v_qh.
     1895     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     1896     if error-status:error
     1897       or not glog
     1898     then do:
     1899        undo _table, retry _table.
     1900     end.
     1901     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     1902     if error-status:error
     1903       or not glog
     1904     then do:
     1905        undo _table, retry _table.
     1906     end.
     1907     glog = v_qh:query-open no-error .
     1908     if error-status:error
     1909       or not glog
     1910     then do:
     1911        undo _table, retry _table.
     1912     end.
     1913     _stroka:
     1914     repeat:
     1915       assign
     1916         num-rec = num-rec + 1
     1917         v-retry-action = 0
     1918       .
     1919       _release:
     1920       do
     1921       on error undo _release, retry _release
     1922       :
     1923         if  retry then do:
     1924           v-retry-action = v-retry-action + 1.
     1925                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                       , buf_temp-xml-tables.tbl-name                                       , num-rec                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value)).                      assign v-view-log = yes.
     1926           run delete-procedure in this-procedure .
     1927           if valid-handle(v_qh) then do:
     1928             delete object v_qh no-error.
     1929           end.
     1930           undo _main, return error ''.
     1931         end.
     1932         if v-retry-action < 1 then do:
     1933                   ImpData1:Route-data_dump ( ) .
     1934         end.
     1935       end.
     1936       _rule:
     1937       do
     1938       on error undo _rule, retry _rule
     1939       :
     1940         if retry then do:
     1941                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка разбора/приема данных по ставке налога из ВС:&1&2&1&3", chr(10), return-value, error-status :get-message( 1 ) )).                      assign v-view-log = yes.
     1942           run set-err-type in p-cont-handle
     1943             ( input v-err-type
     1944             ) no-error.
     1945           run delete-procedure in this-procedure .
     1946           if valid-handle(v_qh) then do:
     1947             delete object v_qh no-error.
     1948           end.
     1949           if valid-handle(v_child-qh) then do:
     1950             delete object v_child-qh no-error.
     1951           end.
     1952           undo _main, return error ''.
     1953         end.
     1954         else do:
     1955           v_qh:get-next().
     1956           if v_qh:query-off-end then do:
     1957             leave _stroka.
     1958           end.
     1959           assign
     1960             v-current-tbl-name = ImpData1:current-tbl-name( )
     1961           .
     1962           IF v-current-tbl-name = 'tax-rate':U  THEN do:
     1963             trans_save:
     1964             do
     1965             on error  undo _rule, retry _rule
     1966             on stop   undo _rule, retry _rule
     1967             on endkey undo _rule, retry _rule
     1968             :
     1969               assign
     1970                 v-line-num  = ImpData1:route-data_get-field-integer  ( input 'tax-rate':U, input "line-num":U )
     1971                 v-rate-code = ImpData1:route-data_get-field-integer  ( input 'tax-rate':U, input "rate-code":U )
     1972                 v-rate-name = ImpData1:route-data_get-field-character( input 'tax-rate':U, input "rate-name":U )
     1973                 v-status    = ImpData1:route-data_get-field-character( input 'tax-rate':U, input "status_":U )
     1974               .
     1975               run proc-save-tax-rate in this-procedure
     1976                 ( input v-tax-code
     1977                 , input v-rate-code
     1978                 , input v-rate-name
     1979                 , input v-status
     1980                 ) no-error .
     1981               if error-status:error then do:
     1982                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по ставке налога при приеме данных из ВС:" )).                      assign v-view-log = yes.
     1983                 undo _rule, retry _rule.
     1984               end.
     1985               else do:
     1986                 assign
     1987                   num-rec-ok2 = num-rec-ok2 + 1
     1988                 .
     1989               end.
     1990               if v-status <> 'D' then do:
     1991                 for each buf_temp-rel-handle
     1992                   where buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name
     1993                 on error undo _rule, retry _rule
     1994                 :
     1995                   run tmpreld2_query in this-procedure
     1996                     ( buffer buf_temp-rel-handle
     1997                     , input-output v_child-qh
     1998                     ) no-error.
     1999                   if error-status:error then do:
     2000                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить записи &1 для &2&3&4&3&5"                                               , buf_temp-rel-handle.child-buffer_                                               , v-current-tbl-name                                               , chr(10)                                               , error-status:get-message(1)                                                , return-value )).                      assign v-view-log = yes.
     2001                     undo _rule, retry _rule .
     2002                   end.
     2003                   _child-stroka:
     2004                   repeat:
     2005                     v_child-qh:get-next().
     2006                     if v_child-qh:query-off-end then do:
     2007                       leave _child-stroka.
     2008                     end.
     2009                     case buf_temp-rel-handle.child-buffer_:
     2010                       when 'tax-rate-value':U then do:
     2011                         run proc-save-tax-rate-value in this-procedure
     2012                           ( input v-tax-code
     2013                           , input ImpData1:route-data_get-field-integer  ( buffer buf_temp-rel-handle:handle, input 'tax-rate-value':U, input "rate-code":U )
     2014                           , input ImpData1:route-data_get-field-decimal  ( buffer buf_temp-rel-handle:handle, input 'tax-rate-value':U, input "rate-value":U )
     2015                           , input ImpData1:route-data_get-field-date     ( buffer buf_temp-rel-handle:handle, input 'tax-rate-value':U, input "fact-date":U )
     2016                           , input 0
     2017                           , input "":U
     2018                           , input 0
     2019                           , input ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input 'tax-rate-value':U, input "status_":U )
     2020                           ) no-error .
     2021                         if error-status:error then do:
     2022                           undo _rule, retry _rule.
     2023                         end.
     2024                       end.
     2025                     end case.
     2026                   end.
     2027                   delete object v_child-qh no-error.
     2028                 end.
     2029               end.
     2030             end.
     2031           end.
     2032         end.
     2033       end.
     2034       v-retry-action = 0 .
     2035       _release:
     2036       do
     2037       on error undo _release, retry _release
     2038       :
     2039         if retry then do:
     2040           v-retry-action = v-retry-action + 1.
     2041                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                       , buf_temp-xml-tables.tbl-name                                       , num-rec                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value)).                      assign v-view-log = yes.
     2042           run delete-procedure in this-procedure .
     2043           if valid-handle(v_qh) then do:
     2044             delete object v_qh no-error.
     2045           end.
     2046           undo _main, return error ''.
     2047         end.
     2048         if v-retry-action < 1 then do:
     2049                   ImpData1:Route-data_dump ( ) .
     2050         end.
     2051       end.
     2052       if v-retry-action = 0 then do:
     2053         num-rec-ok = num-rec-ok + 1.
     2054       end.
     2055       run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     2056     end.
     2057     if not v-stop
     2058     and buf_temp-xml-tables.is-parent
     2059     then do:
     2060       num-rec = num-rec - 1.
     2061     end.
     2062     v_qh:query-close().
     2063     if valid-handle(v_qh) then do:
     2064       delete object v_qh.
     2065     end.
     2066   end.
     2067     run write-log-and-file in p-log-handle
     2068       ( input 1
     2069       , input log-file-name
     2070       , input 1
     2071       , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok2 )
     2072       ).
     2073   end.
     2074   end procedure.
     2075   procedure load-ruleset-context :
     2076   define input parameter p-ruleset-id as integer no-undo .
     2077   define buffer buf_rule-call-param for ub.rule-call-param.
     2078   define variable v-itop as integer   no-undo .
     2079   define variable v-ichild as integer   no-undo .
     2080   define buffer buf_ext-system for ub.ext-system.
     2081     do
     2082     on error undo, return error
     2083     :
     2084    find first buf_rule-call-param no-lock where
     2085   buf_rule-call-param.codex_id = p-codex-id
     2086   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2087   and buf_rule-call-param.call_id = p-call-id
     2088   and buf_rule-call-param.order_id = p-order-id
     2089   and buf_rule-call-param.rule_id = p-rule-id
     2090   and buf_rule-call-param.param-name = "p-xsd-file"
     2091    no-error.
     2092   if available buf_rule-call-param then do:
     2093   assign p-xsd-file = buf_rule-call-param.param-value-character.
     2094   end.
     2095    find first buf_rule-call-param no-lock where
     2096   buf_rule-call-param.codex_id = p-codex-id
     2097   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2098   and buf_rule-call-param.call_id = p-call-id
     2099   and buf_rule-call-param.order_id = p-order-id
     2100   and buf_rule-call-param.rule_id = p-rule-id
     2101   and buf_rule-call-param.param-name = "p-esys-id"
     2102    no-error.
     2103   if available buf_rule-call-param then do:
     2104   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2105   end.
     2106       case p-ruleset-id:
     2107         when 4 then do:
     2108           assign
     2109           v-sign = 1
     2110           v-current-host-code = p-host-code
     2111           v-current-obj-type = p-obj-type
     2112           v-current-obj-code = p-obj-code
     2113           v-current-doc-code = p-doc-code
     2114           v-current-db-num = g#db-num
     2115           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2116           file-name  = entry(1, p-process-file-name, chr(4))
     2117           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     2118           v-xmlh = buffer buf_temp-xml-tables:handle
     2119           v-esys-id = integer(p-doc-code)
     2120           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     2121           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     2122           log-file-name = entry(4, p-process-file-name, chr(4))
     2123           no-error
     2124           .
     2125           if error-status:error then do:
     2126                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).                      assign v-view-log = yes.
     2127             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     2128           end.
     2129           find first buf_ext-system no-lock where
     2130                     buf_ext-system.esys-id = v-esys-id
     2131                 and buf_ext-system.db-num = 0 no-error .
     2132           if not available buf_ext-system then do:
     2133                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     2134             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     2135           end.
     2136           if v-extension = ''
     2137           or lookup(v-extension, "dat") = 0 then do:
     2138                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).                      assign v-view-log = yes.
     2139             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     2140           end.
     2141           _top-buffers:
     2142           do v-itop = 1 to v_dataseth:num-top-buffers:
     2143             if v_dataseth:get-top-buffer(v-itop):table = "header_" then do:
     2144               next _top-buffers.
     2145             end.
     2146             assign
     2147             v-ds-read-order = v-ds-read-order +
     2148                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     2149                               v_dataseth:get-top-buffer(v-itop):table
     2150                               .
     2151             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     2152               assign
     2153               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     2154             end.
     2155           end.
     2156           run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     2157         end.
     2158         otherwise do:
     2159           undo, return error "Неправильный вызов".
     2160         end.
     2161       end case.
     2162     end.
     2163   end procedure.
     2164   procedure delete-procedure :
     2165     do
     2166     on error  undo, return error substitute( "&1 (delete-procedure). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2167     on stop   undo, return error substitute( "&1 (delete-procedure). stop", vss-workfile )
     2168     on endkey undo, return error substitute( "&1 (delete-procedure). endkey", vss-workfile )
     2169     :
     2170         run clear_tt in this-procedure .
     2171         run garbcoll_clear in this-procedure .
     2172     end.
     2173   end procedure.
     2174   procedure proc-save-tax-rate :
     2175     define input  parameter p-tax-code  like ub.tax-rate.tax-code  no-undo .
     2176     define input  parameter p-rate-code like ub.tax-rate.rate-code no-undo .
     2177     define input  parameter p-rate-name like ub.tax-rate.rate-name no-undo .
     2178     define input  parameter p-status    as   character             no-undo .
     2179     do
     2180     on error  undo, return error substitute( "&1 (proc-save-tax-rate). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2181     on stop   undo, return error substitute( "&1 (proc-save-tax-rate). stop", vss-workfile )
     2182     on endkey undo, return error substitute( "&1 (proc-save-tax-rate). endkey", vss-workfile )
     2183     :
     2184       define buffer buf_tax            for ub.tax .
     2185       define buffer buf_tax-rate       for ub.tax-rate .
     2186       define buffer buf_tax-rate-value for ub.tax-rate-value .
     2187       define buffer buf_clients        for ub.clients .
     2188       define variable v-rid       as recid     no-undo .
     2189       define variable v-host-code as integer   no-undo .
     2190       define variable v-stts      as character no-undo .
     2191       find first buf_tax-rate exclusive-lock
     2192         where buf_tax-rate.tax-code  = p-tax-code
     2193           and buf_tax-rate.rate-code = p-rate-code
     2194         no-error .
     2195       if available buf_tax-rate then do:
     2196         assign
     2197           v-rid  = recid( buf_tax-rate )
     2198           v-stts = 'ИЗМЕНЕНИЕ':U
     2199         .
     2200       end.
     2201       else do:
     2202         assign
     2203           v-rid  = ?
     2204           v-stts = 'ДОБАВЛЕНИЕ':U
     2205         .
     2206       end.
     2207       case p-status :
     2208         when 'N'
     2209         or when 'U'
     2210         then do:
     2211           run ref/taxrati1.p
     2212             ( input-output v-rid
     2213             , input v-stts
     2214             , input true
     2215             , input p-tax-code
     2216             , input p-rate-code
     2217             , input p-rate-name
     2218             , input 'тек':U
     2219             ) no-error.
     2220           if error-status:error then do:
     2221             undo, return error substitute( "&1 (proc-save-tax-rate). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)) .
     2222           end.
     2223         end.
     2224         when 'D' then do:
     2225           if available buf_tax-rate then do:
     2226             for each buf_tax-rate-value exclusive-lock
     2227               where buf_tax-rate-value.tax-code  = buf_tax-rate.tax-code
     2228                 and buf_tax-rate-value.rate-code = buf_tax-rate.rate-code
     2229             on error undo, return error substitute( "&1 (proc-save-tax-rate). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2230             :
     2231               assign
     2232                 buf_tax-rate-value.status_ = 'удал':U
     2233               .
     2234             end.
     2235             assign
     2236               buf_tax-rate.status_ = 'удал':U
     2237             .
     2238             release buf_tax-rate .
     2239           end.
     2240           else do:
     2241             undo, return error substitute( "&1 (proc-save-tax-rate). Запрошено удаление отсутствующей записи", vss-workfile ) .
     2242           end.
     2243         end.
     2244       end case.
     2245       find first buf_tax no-lock where
     2246                buf_tax.tax-code = p-tax-code no-error.
     2247       if available buf_tax
     2248       and buf_tax.to-cashdesk = yes
     2249       then do:
     2250         for each buf_clients no-lock
     2251           where buf_clients.obj-type = 'маг':U
     2252             and buf_clients.db-num = g#db-num
     2253         on error undo, return error return-value
     2254         :
     2255   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2256   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2257     (input  buf_clients.obj-type
     2258     ,input  buf_clients.obj-code
     2259     ,output v-host-code
     2260     )  .
     2261           run fill-cash-txr in p-cont-handle (
     2262                                                input p-tax-code
     2263                                               ,input p-rate-code
     2264                                               ,input (if p-status = 'N'
     2265                                                       or p-status = 'U'
     2266                                                       then 'тек':U
     2267                                                       else 'удал':U)
     2268                                               ,input v-host-code
     2269                                               ,input buf_clients.obj-type
     2270                                               ,input buf_clients.obj-code
     2271                                               ,input buf_tax.tax-type
     2272                                               ,input ?
     2273                                               ,input p-rate-code
     2274                                               ,input v-rid
     2275                                               ).
     2276         end.
     2277       end.
     2278     end.
     2279   end procedure.
     2280   procedure proc-save-tax-rate-value :
     2281     define input  parameter p-tax-code   like ub.tax-rate-value.tax-code   no-undo .
     2282     define input  parameter p-rate-code  like ub.tax-rate-value.rate-code  no-undo .
     2283     define input  parameter p-rate-value like ub.tax-rate-value.rate-value no-undo .
     2284     define input  parameter p-fact-date  like ub.tax-rate-value.fact-date  no-undo .
     2285     define input  parameter p-host-code  like ub.tax-rate-value.host-code  no-undo .
     2286     define input  parameter p-obj-type   like ub.tax-rate-value.obj-type   no-undo .
     2287     define input  parameter p-obj-code   like ub.tax-rate-value.obj-code   no-undo .
     2288     define input  parameter p-status     as   character                    no-undo .
     2289     do
     2290     on error  undo, return error substitute( "&1 (proc-save-tax-rate-value). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2291     on stop   undo, return error substitute( "&1 (proc-save-tax-rate-value). stop", vss-workfile )
     2292     on endkey undo, return error substitute( "&1 (proc-save-tax-rate-value). endkey", vss-workfile )
     2293     :
     2294       define buffer buf_tax            for ub.tax .
     2295       define buffer buf_tax-rate-value for ub.tax-rate-value .
     2296       define variable v-rid        as   recid                        no-undo .
     2297       define variable v-fact-order like ub.tax-rate-value.fact-order no-undo .
     2298       define variable v-today as date      no-undo.
     2299       define variable v-time  as integer   no-undo.
     2300       run factord-end-day in this-procedure
     2301         ( input p-fact-date
     2302         , output v-fact-order
     2303         ).
     2304       find first buf_tax-rate-value exclusive-lock
     2305         where buf_tax-rate-value.tax-code   = p-tax-code
     2306           and buf_tax-rate-value.rate-code  = p-rate-code
     2307           and buf_tax-rate-value.host-code  = p-host-code
     2308           and buf_tax-rate-value.obj-type   = p-obj-type
     2309           and buf_tax-rate-value.obj-code   = p-obj-code
     2310           and buf_tax-rate-value.fact-order = v-fact-order
     2311         no-error .
     2312       if available buf_tax-rate-value then do:
     2313         assign
     2314           v-rid  = recid( buf_tax-rate-value )
     2315         .
     2316       end.
     2317       else do:
     2318         assign
     2319           v-rid  = ?
     2320         .
     2321       end.
     2322       case p-status :
     2323         when 'N'
     2324         or when 'U'
     2325         then do:
     2326           run ref/taxvali1.p
     2327             ( input-output v-rid
     2328             , input 'ДОБАВЛЕНИЕ':U
     2329             , input true
     2330             , input p-tax-code
     2331             , input p-rate-code
     2332             , input p-rate-value
     2333             , input p-fact-date
     2334             , input p-host-code
     2335             , input p-obj-type
     2336             , input p-obj-code
     2337             , input 'тек':U
     2338             ) no-error.
     2339           if error-status:error then do:
     2340             undo, return error substitute( "&1 (proc-save-tax-rate-value). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)) .
     2341           end.
     2342         end.
     2343         when 'D' then do:
     2344           if available buf_tax-rate-value then do:
     2345             assign
     2346               buf_tax-rate-value.status_ = 'удал':U
     2347             .
     2348             release buf_tax-rate-value .
     2349           end.
     2350           else do:
     2351             undo, return error substitute( "&1 (proc-save-tax-rate-value). Запрошено удаление отсутствующей записи", vss-workfile ) .
     2352           end.
     2353         end.
     2354       end case.
     2355       find buf_tax where
     2356           buf_tax.tax-code = p-tax-code no-lock no-error.
     2357       run cur-time in this-procedure ( output v-today, output v-time).
     2358       if available buf_tax
     2359       and buf_tax.to-cashdesk = yes
     2360       and p-fact-date <= v-today
     2361       then do:
     2362         run fill-cash-txr in p-cont-handle (
     2363                                              input buf_tax.tax-code
     2364                                             ,input p-rate-code
     2365                                             ,input ?
     2366                                             ,input p-host-code
     2367                                             ,input p-obj-type
     2368                                             ,input p-obj-code
     2369                                             ,input buf_tax.tax-type
     2370                                             ,input (if p-status = 'D' then ? else p-rate-value)
     2371                                             ,input integer( p-fact-date)
     2372                                             ,input v-rid
     2373                                             ).
     2374     end.
     2375     end.
     2376   end procedure.
