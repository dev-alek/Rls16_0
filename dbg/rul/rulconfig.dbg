        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Список сущностей rule-машины".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#library  as handle no-undo .
       63   define new global shared variable g#library2 as handle no-undo .
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   procedure proc-alt-shift-f2:
      319     if not ibs.th.gbl.gbl-var:rcode
      320   then
      321     run gbl\inidebug.p .
      322   end.
      323   procedure proc-alt-shift-f3:
      324     run gbl/prvssinf.p
      325       ( input this-procedure
      326       ) .
      327   end.
      328   define variable v-inform-launched as logical no-undo initial false .
      329   procedure proc-alt-shift-f4:
      330     define variable v-action as character no-undo .
      331     if v-inform-launched = false then do:
      332       assign
      333         v-inform-launched = true
      334       .
      335       run gbl/d-inform.w
      336         (  input self
      337         ,  input this-procedure
      338         , output v-action
      339         ) no-error .
      340       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      341       assign
      342         v-inform-launched = false
      343       .
      344     end.
      345   end.
      346   procedure proc-alt-f1:
      347     run gbl/corrhelp.p
      348       (input this-procedure
      349       ) .
      350   end .
      351   on alt-shift-f2 anywhere do:
      352     run proc-alt-shift-f2.
      353   end.
      354   on alt-shift-f3 anywhere do:
      355     run proc-alt-shift-f3 in this-procedure .
      356   end.
      357   on alt-shift-f4 anywhere do:
      358     run proc-alt-shift-f4 in this-procedure.
      359   end.
      360   on alt-f1 anywhere do:
      361     run proc-alt-f1 in this-procedure .
      362   end.
      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   procedure get-ro_get-read-only :
      590     define output parameter p-ro-set as logical   no-undo .
      591     do
      592     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info2, return-value, error-status :get-message( 1 ) )
      593     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info2 )
      594     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info2 )
      595     :
      596       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      597       then do:
      598         assign
      599           p-ro-set = true
      600         .
      601       end.
      602       else do:
      603         assign
      604           p-ro-set = false
      605         .
      606       end.
      607     end.
      608   end procedure.
      609   define variable v-rum-tables as character no-undo.
      610   define variable v-rum-table-names as character no-undo.
      611   define variable v-sys-key as character no-undo .
      612   define variable v-ibs as logical no-undo .
      613   define variable glog as logical no-undo .
      614   define variable v-get-ro_read-only as logical   no-undo .
      615   DEFINE BUFFER buf_file FOR dictdb._file.
      616   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER )  FORWARD.
      617   DEFINE BUTTON b-export
      618        LABEL "&Экспорт"
      619        SIZE 10 BY 1.
      620   DEFINE BUTTON B-Help
      621        LABEL "Помо&щь"
      622        SIZE 3 BY 1
      623        BGCOLOR 8 .
      624   DEFINE BUTTON b-import
      625        LABEL "&Импорт"
      626        SIZE 10 BY 1.
      627   DEFINE BUTTON b-quit AUTO-END-KEY
      628        LABEL "&Выход"
      629        SIZE 10 BY 1
      630        BGCOLOR 8 .
      631   DEFINE BUTTON B-sel
      632        LABEL "В&ыбор"
      633        SIZE 10 BY 1.
      634   DEFINE VARIABLE rs-language AS CHARACTER
      635        VIEW-AS RADIO-SET HORIZONTAL
      636        RADIO-BUTTONS
      637             "Item 1", "1",
      638   "Item 2", "2"
      639        SIZE 21 BY 1 NO-UNDO.
      640   DEFINE QUERY br-vrmtables FOR
      641         buf_file SCROLLING.
      642   DEFINE BROWSE br-vrmtables
      643     QUERY br-vrmtables DISPLAY
      644         buf_file._file-name FORMAT "X(32)" COLUMN-LABEL "Таблицы"
      645   get-tbl-fname (buf_file._file-name) FORMAT "X(62)" COLUMN-LABEL "Описание"
      646       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.27 FIT-LAST-COLUMN.
      647   DEFINE FRAME Dialog-Frame
      648        b-quit AT ROW 1 COL 1
      649        B-sel AT ROW 1 COL 21 WIDGET-ID 2
      650        b-export AT ROW 1 COL 48 WIDGET-ID 4
      651        b-import AT ROW 1 COL 58 WIDGET-ID 10
      652        B-Help AT ROW 1 COL 95
      653        rs-language AT ROW 2 COL 33.5 NO-LABEL WIDGET-ID 6
      654        br-vrmtables AT ROW 3 COL 1 WIDGET-ID 100
      655        SPACE(0.69) SKIP(0.00)
      656       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      657            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      658            TITLE "Справочники rule-машины"
      659            CANCEL-BUTTON b-quit.
      660   ASSIGN
      661          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      662          FRAME Dialog-Frame:HIDDEN           = TRUE.
      663   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      664   DO:
      665     APPLY "END-ERROR":U TO SELF.
      666   END.
      667   ON CHOOSE OF b-export IN FRAME Dialog-Frame
      668   DO:
      669   define variable v-file-name as character no-undo .
      670   define variable v-old-file-name as character no-undo .
      671   define variable v-dir-name as character no-undo .
      672   define variable v-yesno as logical no-undo .
      673   define variable v-mode-log as logical no-undo .
      674   define variable v-mode as character no-undo .
      675   message
      676   "Хотите экспортировать уникальное имя каждой записи (uniq-key-rec)?"
      677   view-as alert-box question buttons yes-no-cancel update v-mode-log.
      678   if v-mode-log = ? then return no-apply.
      679   if v-mode-log then do:
      680     v-mode = "full".
      681   end.
      682   message
      683   "Хотите экспортировать ПОЛНУЮ конфигурацию RULE-машины" skip
      684   "или только измененные записи?"
      685   view-as alert-box question buttons yes-no-cancel update v-yesno.
      686   if v-yesno = ? then return no-apply.
      687   if v-yesno = no then do:
      688     run gbl/d-file.p (
      689           input-output v-old-file-name
      690         , input-output v-dir-name
      691         , input  (" Все файлы txt (*.txt) ")
      692         , input  ("*.txt":U)
      693         , input  chr(44)
      694         , input  (".txt":U)
      695         , input  yes
      696         , input  no
      697         , input  yes
      698         , input  "Введите имя старого файла (для сравнения)"
      699         , output v-yesno
      700     ) no-error.
      701     if error-status:error
      702     or v-yesno = no then return no-apply.
      703   end.
      704   v-yesno = no.
      705     run gbl/d-file.p (
      706           input-output v-file-name
      707         , input-output v-dir-name
      708         , input  (" Все файлы txt (*.txt) ")
      709         , input  ("*.txt":U)
      710         , input  chr(44)
      711         , input  (".txt":U)
      712         , input  no
      713         , input  yes
      714         , input  yes
      715         , input  "Введите имя файла для экспорта"
      716         , output v-yesno
      717     ) no-error.
      718     if error-status:error
      719     or v-yesno = no then return no-apply.
      720     run rul/export-current-rum.p (
      721                                    input v-file-name
      722                                   ,input v-old-file-name
      723                                   ,input v-mode
      724                                  ) NO-ERROR.
      725     IF ERROR-STATUS:ERROR THEN DO:
      726        MESSAGE
      727        ERROR-STATUS:GET-MESSAGE(1) SKIP
      728        RETURN-VALUE
      729        VIEW-AS ALERT-BOX.
      730        RETURN NO-APPLY.
      731     END.
      732     define variable v-md5-signature as character no-undo .
      733     define variable v-full-file-name          as character                no-undo .
      734     define variable v-path                    as character                no-undo .
      735     DEFINE VARIABLE v-full-path               as character                no-undo .
      736     DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      737     DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      738     run gbl/md5.p ( input v-file-name
      739                    ,output v-md5-signature ) .
      740     run gbl/filename.p (
      741                    input v-file-name
      742                   ,output v-full-path
      743                   ,output v-path
      744                   ,output v-full-file-name
      745                   ,output v-file-name-no-ext
      746                   ,output v-file-name-ext
      747                   ) no-error .
      748     if error-status:error then do:
      749       message
      750       return-value
      751       view-as alert-box ERROR.
      752       return.
      753     end.
      754     output to value(v-path + chr(47) + v-file-name-no-ext + ".md5").
      755     put unformatted v-md5-signature skip.
      756     output close.
      757   END.
      758   ON CHOOSE OF b-import IN FRAME Dialog-Frame
      759   DO:
      760   define variable glog as logical no-undo.
      761   message
      762   "Хотите закачать новую конфигурацию?" skip(0)
      763   "ЕСЛИ НЕ УВЕРЕНЫ, ЧТО ЗНАЕТЕ ЗАЧЕМ ЭТО НАДО - НЕ ЗАКАЧИВАЙТЕ!!!!!"
      764   view-as alert-box question buttons yes-no update glog.
      765   if not glog then return no-apply.
      766   run trg/fixrum.p ( input yes
      767                    , input v-get-ro_read-only) no-error.
      768   END.
      769   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      770   DO:
      771     run proc-b-sel IN THIS-PROCEDURE NO-ERROR.
      772     IF ERROR-STATUS:ERROR THEN DO:
      773        RETURN NO-APPLY.
      774     END.
      775   END.
      776   ON DEFAULT-ACTION OF br-vrmtables IN FRAME Dialog-Frame
      777   DO:
      778     APPLY "CHOOSE" TO b-sel.
      779   END.
      780   ON VALUE-CHANGED OF rs-language IN FRAME Dialog-Frame
      781   DO:
      782     ASSIGN
      783     rs-language.
      784     CASE rs-language:
      785       WHEN "ABL" THEN DO:
      786         buf_file._file-name:VISIBLE IN BROWSE br-vrmtables = YES.
      787       END.
      788       WHEN "rus" THEN DO:
      789         buf_file._file-name:VISIBLE IN BROWSE br-vrmtables = NO.
      790       END.
      791     END CASE.
      792   END.
      793   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      794   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      795   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      796   on help of frame Dialog-Frame
      797   do:
      798     run gbl/app_help.p
      799       (input this-procedure :file-name
      800       ,input ''
      801       ,input ?
      802       ) no-error.
      803     if error-status :error then do:
      804       message
      805         "Ошибка при вызове помощи"
      806         error-status :get-message(1)
      807         view-as alert-box .
      808     end.
      809   end.
      810   run minbtn-set in this-procedure .
      811   on choose of b-help in frame Dialog-Frame
      812   do:
      813     apply "help":u to frame Dialog-Frame .
      814   end.
      815   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   procedure minbtn-set :
      817       do
      818           on error undo, return error return-value
      819           :
      820           define variable ii              as integer       no-undo .
      821           define variable fh              as widget-handle no-undo .
      822           define variable hh              as widget-handle no-undo .
      823           define variable v-h             as handle        extent 4 no-undo .
      824           define variable v-name-button   as character     no-undo .
      825           define variable v-help-old-x    as decimal       no-undo .
      826           define variable v-help-old-y    as decimal       no-undo .
      827           define variable v-help-old-size as decimal       no-undo .
      828           define variable v-frame-width   as decimal       no-undo .
      829           define variable jj              as integer       no-undo .
      830           do
      831               on error undo, return error
      832               :
      833               assign
      834                   v-frame-width = frame Dialog-Frame:width - 0.3
      835                   fh            = frame Dialog-Frame:first-child
      836                   hh            = fh:first-child
      837                   ii            = 1
      838                   .
      839               do while valid-handle(hh):
      840                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      841                   do:
      842                       case lc(hh:name) :
      843                           when "b-help" then
      844                               do:
      845                                   hh:load-image-up("cmp/b-help.bmp":u) .
      846                                   hh:load-image-down("cmp/b-help.bmp":u) .
      847                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      848                                   hh:TOOLTIP = "Помощь" .
      849                                   v-help-old-x = hh:column .
      850                                   v-help-old-y = hh:row    .
      851                                   v-help-old-size = hh:width .
      852                                   hh:width-chars = 2.5 .
      853                               end.
      854                           when "b-print" then
      855                               do:
      856                                   hh:load-image("cmp/b-print.bmp":u) .
      857                                   hh:TOOLTIP = "Печать" .
      858                                   v-h[ii] = hh:handle .
      859                                   ii = ii + 1 .
      860                                   hh:width-chars = 3 .
      861                               end.
      862                           when "b-history" or
      863                           when "b-hist" then
      864                               do:
      865                                   hh:load-image("cmp/b-hist.bmp":u) .
      866                                   hh:TOOLTIP = "История" .
      867                                   v-h[ii] = hh:handle .
      868                                   ii = ii + 1 .
      869                                   hh:width-chars = 3 .
      870                               end.
      871                           when "b-sch" then
      872                               do:
      873                                   hh:load-image("cmp/b-sch.bmp":u) .
      874                                   hh:TOOLTIP = "Установка Фильтра" .
      875                                   v-h[ii] = hh:handle .
      876                                   ii = ii + 1 .
      877                                   hh:width-chars = 3 .
      878                               end.
      879                           when "b-hist-user" then
      880                               do:
      881                                   hh:load-image("cmp/b-hist.bmp":u) .
      882                                   hh:TOOLTIP = "История пользователя" .
      883                                   ii = ii + 1 .
      884                               end.
      885                       end case.
      886                   end.
      887                   hh = hh:next-sibling.
      888               end.
      889               b-help:column = v-frame-width - b-help:width-chars.
      890               jj = 0.
      891               repeat ii = 4 to 1 by -1 :
      892                   if valid-handle (v-h[ii] ) then
      893                   do:
      894                       jj  = jj + 1 .
      895                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      896                       v-h[ii]:row    = v-help-old-y .
      897                   end.
      898               end.
      899           end.
      900       end.
      901   end procedure.
      902   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      903   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      904   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      905   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      906   define variable v-diasize-current-frame-width  as decimal   no-undo .
      907   define variable v-diasize-current-frame-height as decimal   no-undo .
      908   define variable v-diasize-change-size          as logical   no-undo .
      909   define variable v-diasize-resize-button        as handle    no-undo .
      910   define variable v-diasize-wndmax               as logical   no-undo .
      911   define variable v-diasize-wndstore             as logical   no-undo .
      912   define variable v-diasize-proc-name            as character no-undo .
      913   define variable v-diasize-browse-handle        as handle    no-undo .
      914   define variable v-diasize-browse-number        as integer   no-undo .
      915   define variable v-diasize-need-full-display    as logical   no-undo init false .
      916   define temp-table temp-diasize-handle no-undo
      917     field handle-value  as handle
      918     field save-position as decimal
      919     index xpk is primary unique handle-value
      920     .
      921   define temp-table temp-browse-handle no-undo
      922     field browse-type   as character
      923     field browse-number as integer
      924     field browse-handle as handle
      925     field original-size as decimal
      926     index xpk is primary unique browse-type browse-number
      927     index xie browse-type browse-handle
      928   .
      929   procedure diasize_change-height :
      930     define input  parameter p-change-value  as decimal   no-undo .
      931     define input  parameter p-move-resize   as logical   no-undo .
      932     define variable v-field-group-handle    as handle    no-undo .
      933     define variable v-object-handle         as handle    no-undo .
      934     define variable v-frame-height          as decimal   no-undo .
      935     define variable v-frame-virtual-height  as decimal   no-undo .
      936     define variable v-browse-height         as decimal   no-undo .
      937     define variable v-window-height         as decimal   no-undo .
      938     define variable v-window-virtual-height as decimal   no-undo .
      939     define variable v-change-sign           as integer   no-undo .
      940     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      941     define buffer buf_temp-browse-handle  for temp-browse-handle .
      942     if p-change-value > 0
      943     then do:
      944       if frame Dialog-Frame :height + p-change-value
      945           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      946       then do:
      947         assign
      948           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      949                           - (frame Dialog-Frame :height-chars)
      950         .
      951         if p-change-value <= 0
      952         then do:
      953           run diasize_position-resize-button in this-procedure .
      954           return .
      955         end.
      956       end.
      957     end.
      958     if p-change-value < 0
      959     then do:
      960       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      961       then do:
      962         assign
      963           p-change-value = v-diasize-orig-frame-height
      964                          - (frame Dialog-Frame :height-chars)
      965         .
      966         if p-change-value >= 0
      967         then do:
      968           run diasize_position-resize-button in this-procedure .
      969           return .
      970         end.
      971       end.
      972     end.
      973     if p-change-value >= 0
      974     then do:
      975       assign
      976         v-change-sign = 1
      977       .
      978     end.
      979     else do:
      980       assign
      981         v-change-sign = -1
      982       .
      983     end.
      984     assign
      985       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      986     .
      987     if p-change-value = 0
      988     then do:
      989       run diasize_position-resize-button in this-procedure .
      990       return .
      991     end.
      992     move_block:
      993     do
      994     on error undo move_block, retry move_block
      995     :
      996       if retry
      997       then do:
      998         do
      999         on error undo move_block, leave move_block
     1000         :
     1001           if p-change-value > 0
     1002           then do:
     1003             for each buf_temp-diasize-handle
     1004             on error undo, next
     1005             :
     1006               assign
     1007                 v-object-handle = buf_temp-diasize-handle.handle-value
     1008               .
     1009               if v-object-handle <> v-diasize-resize-button
     1010               then do:
     1011                 assign
     1012                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1013                 .
     1014               end.
     1015             end.
     1016             assign
     1017               v-diasize-browse-handle :height = v-browse-height
     1018             .
     1019             for each buf_temp-browse-handle
     1020               where buf_temp-browse-handle.browse-type = 'height':u
     1021             on error undo, next
     1022             :
     1023               assign
     1024                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1025               .
     1026             end.
     1027             assign
     1028               frame Dialog-Frame :height = v-frame-height
     1029             .
     1030             if frame Dialog-Frame :scrollable = true
     1031             then do:
     1032               assign
     1033                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1034               .
     1035             end.
     1036             run diasize_position-resize-button in this-procedure .
     1037           end.
     1038           else do:
     1039             if frame Dialog-Frame :scrollable = true
     1040             then do:
     1041               assign
     1042                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1043               .
     1044             end.
     1045             assign
     1046               frame Dialog-Frame :height = v-frame-height
     1047             .
     1048             assign
     1049               v-diasize-browse-handle :height = v-browse-height
     1050             .
     1051             for each buf_temp-browse-handle
     1052               where buf_temp-browse-handle.browse-type = 'height':u
     1053             on error undo, next
     1054             :
     1055               assign
     1056                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1057               .
     1058             end.
     1059             for each buf_temp-diasize-handle
     1060             on error undo, next
     1061             :
     1062               assign
     1063                 v-object-handle = buf_temp-diasize-handle.handle-value
     1064               .
     1065               if v-object-handle <> v-diasize-resize-button
     1066               then do:
     1067                 assign
     1068                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1069                 .
     1070               end.
     1071             end.
     1072             run diasize_position-resize-button in this-procedure .
     1073           end.
     1074           assign
     1075             v-diasize-change-size = false
     1076           .
     1077           leave move_block .
     1078         end.
     1079       end.
     1080       assign
     1081         v-diasize-need-full-display = true
     1082       .
     1083       if v-diasize-change-size = false
     1084       then do:
     1085         assign
     1086           v-diasize-change-size = true
     1087         .
     1088       end.
     1089       else do:
     1090         return .
     1091       end.
     1092       assign
     1093         v-frame-height = frame Dialog-Frame :height
     1094         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1095         v-browse-height = v-diasize-browse-handle :height
     1096       .
     1097       for each buf_temp-browse-handle
     1098         where buf_temp-browse-handle.browse-type = 'height':u
     1099       :
     1100         assign
     1101           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1102         .
     1103       end.
     1104       for each buf_temp-diasize-handle
     1105       :
     1106         delete buf_temp-diasize-handle .
     1107       end.
     1108       assign
     1109         v-field-group-handle = frame Dialog-Frame :first-child
     1110       .
     1111       do while valid-handle(v-field-group-handle)
     1112       :
     1113         assign
     1114           v-object-handle = v-field-group-handle :first-child
     1115         .
     1116         do while valid-handle(v-object-handle)
     1117         :
     1118           if  v-object-handle <> v-diasize-browse-handle :handle
     1119           and can-query(v-object-handle, "row")
     1120           and can-query(v-object-handle, "height")
     1121           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1122           then do:
     1123             find first buf_temp-browse-handle
     1124               where buf_temp-browse-handle.browse-type   = 'height':u
     1125                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1126               no-error .
     1127             if available buf_temp-browse-handle
     1128             then do:
     1129             end.
     1130             else do:
     1131               create buf_temp-diasize-handle .
     1132               assign
     1133                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1134                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1135               .
     1136             end.
     1137           end.
     1138           assign
     1139             v-object-handle = v-object-handle :next-sibling
     1140           .
     1141         end.
     1142         assign
     1143           v-field-group-handle = v-field-group-handle :next-sibling
     1144         .
     1145       end.
     1146       do with frame Dialog-Frame
     1147       :
     1148         hide v-diasize-resize-button .
     1149         assign
     1150           v-diasize-resize-button :row    = 1
     1151           v-diasize-resize-button :column = 1
     1152         .
     1153       end.
     1154       if p-change-value > 0
     1155       then do:
     1156         if frame Dialog-Frame :scrollable = true
     1157         then do:
     1158           assign
     1159             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1160             no-error .
     1161           if error-status :error
     1162           or error-status :get-message(1) <> ""
     1163           then do:
     1164             undo move_block, retry move_block .
     1165           end.
     1166         end.
     1167         assign
     1168           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1169           no-error .
     1170         if error-status :error
     1171         or error-status :get-message(1) <> ""
     1172         then do:
     1173           undo move_block, retry move_block .
     1174         end.
     1175         assign
     1176           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1177           no-error .
     1178         if error-status :error
     1179         or error-status :get-message(1) <> ""
     1180         then do:
     1181           undo move_block, retry move_block .
     1182         end.
     1183         for each buf_temp-browse-handle
     1184           where buf_temp-browse-handle.browse-type = 'height':u
     1185         on error undo move_block, retry move_block
     1186         :
     1187           assign
     1188             buf_temp-browse-handle.browse-handle :height
     1189               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1190             no-error .
     1191           if error-status :error
     1192           or error-status :get-message(1) <> ""
     1193           then do:
     1194             undo move_block, retry move_block .
     1195           end.
     1196         end.
     1197         for each buf_temp-diasize-handle
     1198         on error undo move_block, retry move_block
     1199         :
     1200           assign
     1201             v-object-handle = buf_temp-diasize-handle.handle-value
     1202           .
     1203           if v-object-handle <> v-diasize-resize-button
     1204           then do:
     1205             assign
     1206               v-object-handle :row = v-object-handle :row + p-change-value
     1207               no-error .
     1208             if error-status :error
     1209             or error-status :get-message(1) <> ""
     1210             then do:
     1211               undo move_block, retry move_block .
     1212             end.
     1213           end.
     1214         end.
     1215       end.
     1216       else do:
     1217         for each buf_temp-diasize-handle
     1218         on error undo move_block, retry move_block
     1219         :
     1220           assign
     1221             v-object-handle = buf_temp-diasize-handle.handle-value
     1222           .
     1223           if v-object-handle <> v-diasize-resize-button
     1224           then do:
     1225             assign
     1226               v-object-handle :row = v-object-handle :row + p-change-value
     1227               no-error .
     1228             if error-status :error
     1229             or error-status :get-message(1) <> ""
     1230             then do:
     1231               undo move_block, retry move_block .
     1232             end.
     1233           end.
     1234         end.
     1235         assign
     1236           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1237           no-error .
     1238         if error-status :error
     1239         or error-status :get-message(1) <> ""
     1240         then do:
     1241           undo move_block, retry move_block .
     1242         end.
     1243         for each buf_temp-browse-handle
     1244           where buf_temp-browse-handle.browse-type = 'height':u
     1245         on error undo move_block, retry move_block
     1246         :
     1247           assign
     1248             buf_temp-browse-handle.browse-handle :height
     1249               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1250             no-error .
     1251           if error-status :error
     1252           or error-status :get-message(1) <> ""
     1253           then do:
     1254             undo move_block, retry move_block .
     1255           end.
     1256         end.
     1257         assign
     1258           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1259           no-error .
     1260         if error-status :error
     1261         or error-status :get-message(1) <> ""
     1262         then do:
     1263           undo move_block, retry move_block .
     1264         end.
     1265         if frame Dialog-Frame :scrollable = true
     1266         then do:
     1267           assign
     1268             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1269             no-error .
     1270           if error-status :error
     1271           or error-status :get-message(1) <> ""
     1272           then do:
     1273             undo move_block, retry move_block .
     1274           end.
     1275         end.
     1276       end.
     1277       if p-move-resize = true
     1278       then do:
     1279         run diasize_position-resize-button in this-procedure .
     1280       end.
     1281       if v-diasize-wndstore = true
     1282       then do:
     1283         if connected("ub") = true
     1284         then do:
     1285           define variable v-cntxt-db-num        as integer   no-undo .
     1286           define variable v-cntxt-userid        as character no-undo .
     1287           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1288                                             , OUTPUT v-cntxt-userid
     1289                                             ) .
     1290           run gbl/wndsizew.p
     1291             (input  v-cntxt-db-num
     1292             ,input  v-cntxt-userid
     1293             ,input  v-diasize-proc-name
     1294             ,input  'height':u
     1295             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1296             ) .
     1297         end.
     1298       end.
     1299     end.
     1300     assign
     1301       v-diasize-change-size = false
     1302     .
     1303   end procedure.
     1304   procedure diasize_set-height :
     1305     define input  parameter p-new-height  as decimal   no-undo .
     1306     define input  parameter p-move-resize as logical   no-undo .
     1307     do
     1308     on error undo, return error return-value
     1309     :
     1310       run diasize_change-height in this-procedure
     1311         (input  (p-new-height - frame Dialog-Frame :height)
     1312         ,input  p-move-resize
     1313         ) .
     1314     end.
     1315   end procedure.
     1316   procedure diasize_change-width :
     1317     define input  parameter p-change-value as decimal   no-undo .
     1318     define input  parameter p-move-resize  as logical   no-undo .
     1319     define variable v-field-group-handle   as handle    no-undo .
     1320     define variable v-object-handle        as handle    no-undo .
     1321     define variable v-frame-width          as decimal   no-undo .
     1322     define variable v-frame-virtual-width  as decimal   no-undo .
     1323     define variable v-browse-width         as decimal   no-undo .
     1324     define variable v-window-width         as decimal   no-undo .
     1325     define variable v-window-virtual-width as decimal   no-undo .
     1326     define variable v-change-sign          as integer   no-undo .
     1327     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1328     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1329     if p-change-value > 0
     1330     then do:
     1331       if frame Dialog-Frame :width + p-change-value >
     1332           session :width-chars
     1333       then do:
     1334         assign
     1335           p-change-value = session :width-chars - frame Dialog-Frame :width
     1336         .
     1337         if p-change-value <= 0
     1338         then do:
     1339           run diasize_position-resize-button in this-procedure .
     1340           return .
     1341         end.
     1342       end.
     1343     end.
     1344     if p-change-value < 0
     1345     then do:
     1346       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1347       then do:
     1348         assign
     1349           p-change-value = v-diasize-orig-frame-width
     1350                          - frame Dialog-Frame :width
     1351         .
     1352         if p-change-value >= 0
     1353         then do:
     1354           run diasize_position-resize-button in this-procedure .
     1355           return .
     1356         end.
     1357       end.
     1358     end.
     1359     if p-change-value >= 0
     1360     then do:
     1361       assign
     1362         v-change-sign = 1
     1363       .
     1364     end.
     1365     else do:
     1366       assign
     1367         v-change-sign = -1
     1368       .
     1369     end.
     1370     assign
     1371       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1372     .
     1373     if p-change-value = 0
     1374     then do:
     1375       run diasize_position-resize-button in this-procedure .
     1376       return .
     1377     end.
     1378     move_block:
     1379     do
     1380     on error undo move_block, leave move_block
     1381     :
     1382       if retry
     1383       then do:
     1384         do
     1385         on error undo move_block, leave move_block
     1386         :
     1387           if p-change-value > 0
     1388           then do:
     1389             for each buf_temp-diasize-handle
     1390             on error undo, next
     1391             :
     1392               assign
     1393                 v-object-handle = buf_temp-diasize-handle.handle-value
     1394               .
     1395               if v-object-handle <> v-diasize-resize-button
     1396               then do:
     1397                 assign
     1398                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1399                 .
     1400               end.
     1401             end.
     1402             assign
     1403               v-diasize-browse-handle :width = v-browse-width
     1404             .
     1405             for each buf_temp-browse-handle
     1406               where buf_temp-browse-handle.browse-type = 'width':u
     1407             on error undo, next
     1408             :
     1409               assign
     1410                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1411               .
     1412             end.
     1413             assign
     1414               frame Dialog-Frame :width = v-frame-width
     1415             .
     1416             if frame Dialog-Frame :scrollable = true
     1417             then do:
     1418               assign
     1419                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1420               .
     1421             end.
     1422             run diasize_position-resize-button in this-procedure .
     1423           end.
     1424           else do:
     1425             if frame Dialog-Frame :scrollable = true
     1426             then do:
     1427               assign
     1428                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1429               .
     1430             end.
     1431             assign
     1432               frame Dialog-Frame :width = v-frame-width
     1433             .
     1434             for each buf_temp-browse-handle
     1435               where buf_temp-browse-handle.browse-type = 'width':u
     1436             on error undo, next
     1437             :
     1438               assign
     1439                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1440               .
     1441             end.
     1442             assign
     1443               v-diasize-browse-handle :width = v-browse-width
     1444             .
     1445             for each buf_temp-diasize-handle
     1446             on error undo, next
     1447             :
     1448               assign
     1449                 v-object-handle = buf_temp-diasize-handle.handle-value
     1450               .
     1451               if v-object-handle <> v-diasize-resize-button
     1452               then do:
     1453                 assign
     1454                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1455                 .
     1456               end.
     1457             end.
     1458             run diasize_position-resize-button in this-procedure .
     1459           end.
     1460           assign
     1461             v-diasize-change-size = false
     1462           .
     1463           leave move_block .
     1464         end.
     1465       end.
     1466       assign
     1467         v-diasize-need-full-display = true
     1468       .
     1469       if v-diasize-change-size = false
     1470       then do:
     1471         assign
     1472           v-diasize-change-size = true
     1473         .
     1474       end.
     1475       else do:
     1476         return .
     1477       end.
     1478       assign
     1479         v-frame-width = frame Dialog-Frame :width
     1480         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1481         v-browse-width = v-diasize-browse-handle :width
     1482       .
     1483       for each buf_temp-browse-handle
     1484         where buf_temp-browse-handle.browse-type = 'width':u
     1485       :
     1486         assign
     1487           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1488         .
     1489       end.
     1490       for each buf_temp-diasize-handle
     1491       :
     1492         delete buf_temp-diasize-handle .
     1493       end.
     1494       assign
     1495         v-field-group-handle = frame Dialog-Frame :first-child
     1496       .
     1497       do while valid-handle(v-field-group-handle)
     1498       :
     1499         assign
     1500           v-object-handle = v-field-group-handle :first-child
     1501         .
     1502         do while valid-handle(v-object-handle)
     1503         :
     1504           if  v-object-handle <> v-diasize-browse-handle :handle
     1505           and v-object-handle <> v-diasize-resize-button
     1506           and can-query(v-object-handle, "row")
     1507           and can-query(v-object-handle, "height")
     1508           and ( v-object-handle :col + v-object-handle :width
     1509                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1510               )
     1511           then do:
     1512             find first buf_temp-browse-handle
     1513               where buf_temp-browse-handle.browse-type   = 'width':u
     1514                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1515               no-error .
     1516             if available buf_temp-browse-handle
     1517             then do:
     1518             end.
     1519             else do:
     1520               create buf_temp-diasize-handle .
     1521               assign
     1522                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1523                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1524               .
     1525             end.
     1526           end.
     1527           assign
     1528             v-object-handle = v-object-handle :next-sibling
     1529           .
     1530         end.
     1531         assign
     1532           v-field-group-handle = v-field-group-handle :next-sibling
     1533         .
     1534       end.
     1535       do with frame Dialog-Frame
     1536       :
     1537         hide v-diasize-resize-button .
     1538         v-diasize-resize-button :row = 1.
     1539         v-diasize-resize-button :column = 1.
     1540       end.
     1541       if p-change-value > 0
     1542       then do:
     1543         if frame Dialog-Frame :scrollable = true
     1544         then do:
     1545           assign
     1546             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1547             no-error .
     1548           if error-status :error
     1549           or error-status :get-message(1) <> ""
     1550           then do:
     1551             undo move_block, retry move_block.
     1552           end.
     1553         end.
     1554         assign
     1555           frame Dialog-Frame :width = v-frame-width + p-change-value
     1556           no-error .
     1557         if error-status :error
     1558         or error-status :get-message(1) <> ""
     1559         then do:
     1560           undo move_block, retry move_block.
     1561         end.
     1562         assign
     1563           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1564         no-error .
     1565         if error-status :error
     1566         or error-status :get-message(1) <> ""
     1567         then do:
     1568           undo move_block, retry move_block.
     1569         end.
     1570         for each buf_temp-browse-handle
     1571           where buf_temp-browse-handle.browse-type = 'width':u
     1572         on error undo move_block, retry move_block
     1573         :
     1574           assign
     1575             buf_temp-browse-handle.browse-handle :width
     1576               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1577             no-error .
     1578           if error-status :error
     1579           or error-status :get-message(1) <> ""
     1580           then do:
     1581             undo move_block, retry move_block .
     1582           end.
     1583         end.
     1584         for each buf_temp-diasize-handle
     1585         on error undo move_block, retry move_block
     1586         :
     1587           assign
     1588             v-object-handle = buf_temp-diasize-handle.handle-value
     1589           .
     1590           if v-object-handle <> v-diasize-resize-button
     1591           then do:
     1592             assign
     1593               v-object-handle :col = v-object-handle :col + p-change-value
     1594               no-error .
     1595             if error-status :error
     1596             or error-status :get-message(1) <> ""
     1597             then do:
     1598               undo move_block, retry move_block .
     1599             end.
     1600           end.
     1601         end.
     1602       end.
     1603       else do:
     1604         for each buf_temp-diasize-handle
     1605         on error undo move_block, retry move_block
     1606         :
     1607           assign
     1608             v-object-handle = buf_temp-diasize-handle.handle-value
     1609           .
     1610           if v-object-handle <> v-diasize-resize-button
     1611           then do:
     1612             assign
     1613               v-object-handle :col = v-object-handle :col + p-change-value
     1614               no-error .
     1615             if error-status :error
     1616             or error-status :get-message(1) <> ""
     1617             then do:
     1618               undo move_block, retry move_block .
     1619             end.
     1620           end.
     1621         end.
     1622         for each buf_temp-browse-handle
     1623           where buf_temp-browse-handle.browse-type = 'width':u
     1624         on error undo move_block, retry move_block
     1625         :
     1626           assign
     1627             buf_temp-browse-handle.browse-handle :width
     1628               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1629             no-error .
     1630           if error-status :error
     1631           or error-status :get-message(1) <> ""
     1632           then do:
     1633             undo move_block, retry move_block .
     1634           end.
     1635         end.
     1636         assign
     1637           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1638           no-error .
     1639         if error-status :error
     1640         or error-status :get-message(1) <> ""
     1641         then do:
     1642           undo move_block, retry move_block.
     1643         end.
     1644         assign
     1645           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1646         no-error .
     1647         if error-status :error
     1648         or error-status :get-message(1) <> ""
     1649         then do:
     1650           undo move_block, retry move_block.
     1651         end.
     1652         if frame Dialog-Frame :scrollable = true
     1653         then do:
     1654           assign
     1655             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1656           no-error .
     1657           if error-status :error
     1658           or error-status :get-message(1) <> ""
     1659           then do:
     1660             undo move_block, retry move_block.
     1661           end.
     1662         end.
     1663       end.
     1664       if p-move-resize
     1665       then do:
     1666         run diasize_position-resize-button in this-procedure .
     1667       end.
     1668       if v-diasize-wndstore = true
     1669       then do:
     1670         if connected("ub") = true
     1671         then do:
     1672           define variable v-cntxt-db-num        as integer   no-undo .
     1673           define variable v-cntxt-userid        as character no-undo .
     1674           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1675                                             , OUTPUT v-cntxt-userid
     1676                                             ) .
     1677           run gbl/wndsizew.p
     1678             (input  v-cntxt-db-num
     1679             ,input  v-cntxt-userid
     1680             ,input  v-diasize-proc-name
     1681             ,input  'width':u
     1682             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1683             ) .
     1684         end.
     1685       end.
     1686     end.
     1687     assign
     1688       v-diasize-change-size = false
     1689     .
     1690   end procedure.
     1691   procedure diasize_set-width :
     1692     define input  parameter p-new-width  as decimal   no-undo .
     1693     define input  parameter p-move-resize as logical   no-undo .
     1694     do
     1695     on error undo, return error return-value
     1696     :
     1697       run diasize_change-width in this-procedure
     1698         (input  (p-new-width - frame Dialog-Frame :width)
     1699         ,input  p-move-resize
     1700         ) .
     1701     end.
     1702   end procedure.
     1703   procedure diasize_position-resize-button :
     1704     do with frame Dialog-Frame
     1705     :
     1706       hide v-diasize-resize-button .
     1707       assign
     1708         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1709                     - 1
     1710                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1711         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1712                     - 1
     1713                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1714       .
     1715       view v-diasize-resize-button .
     1716     end.
     1717   end procedure.
     1718   on alt-right anywhere
     1719   do:
     1720     run diasize_change-width in this-procedure
     1721       (input 1
     1722       ,input true
     1723       ) .
     1724     return no-apply .
     1725   end.
     1726   on alt-left anywhere
     1727   do:
     1728     run diasize_change-width in this-procedure
     1729       (input -1
     1730       ,input true
     1731       ) .
     1732     return no-apply .
     1733   end.
     1734   on alt-down anywhere
     1735   do:
     1736     run diasize_change-height in this-procedure
     1737       (input 1
     1738       ,input true
     1739       ) .
     1740     return no-apply .
     1741   end.
     1742   on alt-up anywhere
     1743   do:
     1744     run diasize_change-height in this-procedure
     1745       (input -1
     1746       ,input true
     1747       ) .
     1748     return no-apply .
     1749   end.
     1750   on alt-enter of frame Dialog-Frame
     1751   do:
     1752     run diasize_maximize in this-procedure
     1753       (input  ?
     1754       ).
     1755     return no-apply .
     1756   end.
     1757   procedure diasize_end-move :
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761       define variable v-row-delta as decimal   no-undo .
     1762       define variable v-col-delta as decimal   no-undo .
     1763       define variable v-new-row as decimal   no-undo .
     1764       define variable v-new-col as decimal   no-undo .
     1765       assign
     1766         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1767         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1768       .
     1769       assign
     1770         v-row-delta = v-new-row - frame Dialog-Frame :height
     1771         v-col-delta = v-new-col - frame Dialog-Frame :width
     1772       .
     1773       run diasize_change-height in this-procedure
     1774         (input v-row-delta
     1775         ,input true
     1776         ) .
     1777       run diasize_change-width in this-procedure
     1778         (input v-col-delta
     1779         ,input true
     1780         ) .
     1781     end.
     1782   end procedure.
     1783   procedure diasize_maximize :
     1784     define input  parameter p-action as logical   no-undo .
     1785     do
     1786     on error undo, return error return-value
     1787     :
     1788       if p-action = ?
     1789       then do:
     1790         if v-diasize-need-maximize = true
     1791         then do:
     1792           assign
     1793             p-action = true
     1794           .
     1795         end.
     1796         else do:
     1797           assign
     1798             p-action = false
     1799           .
     1800         end.
     1801       end.
     1802       if p-action = true
     1803       then do:
     1804         run diasize_change-height in this-procedure
     1805           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1806               - frame Dialog-Frame :height-chars
     1807           ,input true
     1808           ) .
     1809         run diasize_change-width in this-procedure
     1810           (input session :width-chars
     1811               - frame Dialog-Frame :width-chars
     1812           ,input true
     1813           ) .
     1814         assign
     1815           v-diasize-need-maximize = false
     1816         .
     1817       end.
     1818       else do:
     1819         run diasize_change-width in this-procedure
     1820           (input v-diasize-orig-frame-width
     1821               - frame Dialog-Frame :width-chars
     1822           ,input true
     1823           ) .
     1824         run diasize_change-height in this-procedure
     1825           (input v-diasize-orig-frame-height
     1826               - frame Dialog-Frame :height-chars
     1827           ,input true
     1828           ) .
     1829         assign
     1830           v-diasize-need-maximize = true
     1831         .
     1832       end.
     1833     end.
     1834   end procedure.
     1835   procedure diasize_restore-orig-size :
     1836     do
     1837     on error undo, return error return-value
     1838     :
     1839       assign
     1840         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1841         v-diasize-current-frame-height = frame Dialog-Frame :height
     1842       .
     1843       run diasize_set-height in this-procedure
     1844         (input  v-diasize-orig-frame-height
     1845         ,input  true
     1846         ) .
     1847       run diasize_set-width in this-procedure
     1848         (input  v-diasize-orig-frame-width
     1849         ,input  true
     1850         ) .
     1851     end.
     1852   end procedure.
     1853   procedure diasize_restore-current-size :
     1854     do
     1855     on error undo, return error return-value
     1856     :
     1857       run diasize_set-height in this-procedure
     1858         (input  v-diasize-current-frame-height
     1859         ,input  true
     1860         ) .
     1861       run diasize_set-width in this-procedure
     1862         (input  v-diasize-current-frame-width
     1863         ,input  true
     1864         ) .
     1865     end.
     1866   end procedure.
     1867   procedure diasize_set-browse-handle :
     1868     define input  parameter p-browse-handle as handle   no-undo .
     1869     define buffer buf_temp-browse-handle for temp-browse-handle .
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       assign
     1874         v-diasize-browse-handle = p-browse-handle
     1875       .
     1876       for each buf_temp-browse-handle
     1877       on error undo, return error return-value
     1878       :
     1879         delete buf_temp-browse-handle .
     1880       end.
     1881     end.
     1882   end procedure.
     1883   procedure diasize_add_browse :
     1884     define input  parameter p-browse-type   as character no-undo .
     1885     define input  parameter p-browse-handle as handle    no-undo .
     1886     define buffer buf_temp-browse-handle for temp-browse-handle .
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       assign
     1891         v-diasize-browse-number = v-diasize-browse-number + 1
     1892       .
     1893       create buf_temp-browse-handle .
     1894       assign
     1895         buf_temp-browse-handle.browse-type   = p-browse-type
     1896         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1897         buf_temp-browse-handle.browse-handle = p-browse-handle
     1898       .
     1899     end.
     1900   end procedure.
     1901   procedure diasize_init :
     1902     define variable v-default-value    as logical   no-undo .
     1903     define variable v-restore-saved    as logical   no-undo .
     1904     define variable v-resize-value-str as character no-undo .
     1905     do
     1906     on error undo, return error return-value
     1907     :
     1908       do with frame Dialog-Frame
     1909       :
     1910         assign
     1911           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1912           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1913           v-diasize-browse-handle     = browse br-vrmtables :handle
     1914         .
     1915         create button v-diasize-resize-button
     1916         assign
     1917           parent        = frame Dialog-Frame :first-child
     1918           label         = "s"
     1919           height-pixels = 16
     1920           width-pixels  = 16
     1921           visible       = true
     1922           sensitive     = true
     1923           movable       = true
     1924           triggers:
     1925             on end-move persistent run diasize_end-move in this-procedure .
     1926           end triggers.
     1927         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1928         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1929         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1930         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1931         assign
     1932           v-diasize-wndmax = false
     1933         .
     1934         if connected("ub") = true
     1935         then do:
     1936           define variable v-cntxt-db-num        as integer   no-undo .
     1937           define variable v-cntxt-userid        as character no-undo .
     1938           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1939                                             , OUTPUT v-cntxt-userid
     1940                                             ) .
     1941           run gbl/wndpar_r.p
     1942             (input  v-cntxt-db-num
     1943             ,input  v-cntxt-userid
     1944             ,input  'wndmax':U
     1945             ,output v-diasize-wndmax
     1946             ,output v-default-value
     1947             ) .
     1948         end.
     1949         assign
     1950           v-diasize-wndstore = false
     1951         .
     1952         if connected("ub") = true
     1953         then do:
     1954           run gbl/wndpar_r.p
     1955             (input  v-cntxt-db-num
     1956             ,input  v-cntxt-userid
     1957             ,input  'wndstore':U
     1958             ,output v-diasize-wndstore
     1959             ,output v-default-value
     1960             ) .
     1961         end.
     1962         assign
     1963           v-diasize-proc-name = entry(1, program-name(2), '.')
     1964         .
     1965         if v-diasize-wndstore = true
     1966         then do:
     1967           assign
     1968             v-restore-saved = false
     1969           .
     1970           if connected("ub") = true
     1971           then do:
     1972             run gbl/wndsizer.p
     1973               (input  v-cntxt-db-num
     1974               ,input  v-cntxt-userid
     1975               ,input  v-diasize-proc-name
     1976               ,input  'height':u
     1977               ,output v-resize-value-str
     1978               ) .
     1979             if v-resize-value-str <> '':U
     1980             then do:
     1981               run diasize_change-height in this-procedure
     1982                 (input  integer(v-resize-value-str)
     1983                 ,input  true
     1984                 ) .
     1985               assign
     1986                 v-restore-saved = true
     1987               .
     1988             end.
     1989           end.
     1990           if connected("ub") = true
     1991           then do:
     1992             run gbl/wndsizer.p
     1993               (input  v-cntxt-db-num
     1994               ,input  v-cntxt-userid
     1995               ,input  v-diasize-proc-name
     1996               ,input  'width':u
     1997               ,output v-resize-value-str
     1998               ) .
     1999             if v-resize-value-str <> '':U
     2000             then do:
     2001               run diasize_change-width in this-procedure
     2002                 (input  integer(v-resize-value-str)
     2003                 ,input  true
     2004                 ) .
     2005               assign
     2006                 v-restore-saved = true
     2007               .
     2008             end.
     2009           end.
     2010           if v-restore-saved <> true
     2011           then do:
     2012             if v-diasize-wndmax = true
     2013             then do:
     2014               run diasize_maximize in this-procedure
     2015                 (input  true
     2016                 ) .
     2017             end.
     2018           end.
     2019         end.
     2020         else do:
     2021           if v-diasize-wndmax = true
     2022           then do:
     2023             run diasize_maximize in this-procedure
     2024               (input  true
     2025               ) .
     2026           end.
     2027         end.
     2028       end.
     2029     end.
     2030   end procedure.
     2031   procedure diasize_need-full-display :
     2032     define output parameter p-need-full-display as logical   no-undo .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       assign
     2037         p-need-full-display = v-diasize-need-full-display
     2038       .
     2039       assign
     2040         v-diasize-need-full-display = false
     2041       .
     2042     end.
     2043   end procedure.
     2044   procedure get-context :
     2045      define output parameter p-db-num as integer          no-undo.
     2046      define output parameter p-user-id as character        no-undo.
     2047      define variable v-login               as character    no-undo.
     2048      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2049      define buffer buf_user-login  for ub.user-login .
     2050      do
     2051      on error undo, return error
     2052      :
     2053            FIND FIRST buf_sys-ctrl no-lock.
     2054            ASSIGN
     2055               v-login = USERID("ub")
     2056               p-db-num = buf_sys-ctrl.db-num
     2057            .
     2058            FIND FIRST buf_user-login
     2059                 WHERE buf_user-login.db-num = p-db-num
     2060                   AND buf_user-login.user-login = v-login
     2061                 no-lock
     2062                 no-error
     2063                 .
     2064            IF AVAILABLE buf_user-login
     2065            THEN DO:
     2066               assign
     2067                  p-user-id = buf_user-login.user-id
     2068               .
     2069            END.
     2070      end.
     2071   end procedure.
     2072       run diasize_init in this-procedure .
     2073   MAIN-BLOCK:
     2074   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2075      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2076      v-get-ro_read-only = false
     2077     .
     2078     run get-ro_get-read-only in this-procedure
     2079       ( output v-get-ro_read-only
     2080       ) .
     2081   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     2082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     2083     (output v-sys-key
     2084     ) no-error .
     2085     if error-status:error then return error.
     2086     assign
     2087     v-ibs = (v-sys-key = 'ExpertekIBS':U).
     2088     if not v-ibs then do:
     2089       message
     2090       "Данная программа может вызываться только сотрудниками IBS" skip
     2091       "Продолжать?" view-as alert-box question buttons yes-no update glog.
     2092       if not glog then do:
     2093         undo, return error .
     2094       end.
     2095       DEFINE VARIABLE v-value AS CHARACTER no-undo.
     2096       DEFINE VARIABLE v-password AS CHARACTER no-undo.
     2097       DEFINE VARIABLE v-today as date no-undo .
     2098       DEFINE VARIABLE v-time as integer no-undo .
     2099       run cur-time in this-procedure ( output v-today, output v-time).
     2100       ASSIGN
     2101       v-password = string((if weekday(v-today) = 1
     2102                           then 7
     2103                           else (weekday(v-today) - 1))
     2104                           * 140).
     2105           run gbl/d-prompt.w (
     2106           'title=':u + "ВВЕДИТЕ ПАРОЛЬ" + '\':u
     2107         + 'text1=' + substitute("Пароль") + '\':u
     2108         + 'format=' + ">>>>>>>>9" + '\':u
     2109         + 'type=' + 'I':U + '\':u
     2110         + 'fillin_row=2\':u
     2111         + 'fillin_col=4\':u
     2112         + 'fillin_width=30\':u
     2113         + 'fillin_height=1\':u
     2114         + 'max-chars=70\':u
     2115         + 'readonly=no\':u
     2116         , input-output v-value
     2117         ).
     2118       if return-value = 'false':u
     2119       then do:
     2120         return no-apply.
     2121       end.
     2122       IF v-value <> v-password THEN DO:
     2123           MESSAGE
     2124         "Неверный пароль!"
     2125         VIEW-AS ALERT-BOX.
     2126         RETURN error.
     2127       END.
     2128     end.
     2129     assign
     2130     v-rum-tables = v-rum-tables + chr(44) + 'ruleset':U +
     2131                                   chr(44) + 'prop-head':U +
     2132                                   chr(44) + 'rule-profile':U +
     2133                                   chr(44) + 'ruledict':U +
     2134                                   chr(44) + 'rule':U +
     2135                                   chr(44) + 'prop-script':U +
     2136                                   chr(44) + 'rule-process':U
     2137                                   .
     2138     assign
     2139     v-rum-table-names = v-rum-table-names + chr(44) + 'Кодексы и наборы правил':U +
     2140                                   chr(44) + 'Объекты-операнды машины правил':U +
     2141                                   chr(44) + 'Профайлы правил':U +
     2142                                   chr(44) + 'Словарь RULE-машины':U +
     2143                                   chr(44) + 'Правила RULE-машины':U +
     2144                                   chr(44) + 'Скрипты RULE-машины':U +
     2145                                   chr(44) + 'Звено процесса':U
     2146                                   .
     2147     assign
     2148     v-rum-tables = trim(v-rum-tables).
     2149     run Myenable.
     2150     WAIT-FOR GO OF FRAME Dialog-Frame.
     2151   END.
     2152   run disable_UI.
     2153   PROCEDURE disable_UI :
     2154     HIDE FRAME Dialog-Frame.
     2155   END PROCEDURE.
     2156   PROCEDURE enable_UI :
     2157     DISPLAY rs-language
     2158         WITH FRAME Dialog-Frame.
     2159     ENABLE b-quit B-sel b-export b-import B-Help rs-language br-vrmtables
     2160         WITH FRAME Dialog-Frame.
     2161     VIEW FRAME Dialog-Frame.
     2162     OPEN QUERY br-vrmtables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-rum-tables) > 0.
     2163   END PROCEDURE.
     2164   PROCEDURE MyEnable :
     2165   ASSIGN
     2166   rs-language:RADIO-BUTTONS IN FRAME Dialog-Frame = "ABL" + chr(44) + "ABL" + chr(44) +
     2167                                                    "rus" + chr(44) + "rus"
     2168   .
     2169   rs-language + "ABL".
     2170   ENABLE
     2171   b-quit
     2172   B-sel
     2173   B-Help
     2174   b-export
     2175   b-import
     2176   br-vrmtables
     2177   rs-language
     2178   WITH FRAME Dialog-Frame.
     2179   VIEW FRAME Dialog-Frame.
     2180   run waitfram-show in this-procedure ( input "Ждите..." ).
     2181   OPEN QUERY br-vrmtables FOR EACH buf_file NO-LOCK WHERE lookup(buf_file._file-name,        v-rum-tables) > 0.
     2182   run waitfram-hide in this-procedure .
     2183   END PROCEDURE.
     2184   PROCEDURE proc-b-sel :
     2185   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2186   IF NOT AVAILABLE buf_file THEN DO:
     2187      RETURN.
     2188   END.
     2189   CASE buf_file._file-name:
     2190     WHEN 'ruleset':U THEN DO:
     2191       run rul/ruleset-s.w ( INPUT parparentproc
     2192                            ,INPUT (if v-ibs then
     2193                                   'b-add':U
     2194                                   else '':U)
     2195                            ,input 'все':U
     2196                            ,input 0
     2197                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2198     END.
     2199     WHEN 'prop-head':U THEN DO:
     2200       run rul/prop-head-s.w ( INPUT parparentproc
     2201                            ,INPUT (if v-ibs then
     2202                                   'b-add':U
     2203                                   else '':U)
     2204                            ,input 'все':U
     2205                            ,input '':U
     2206                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2207     END.
     2208     WHEN 'rule-profile':U THEN DO:
     2209       run rul/rule-profile-s.w ( INPUT parparentproc
     2210                            ,INPUT (if v-ibs then
     2211                                   'b-add':U
     2212                                   else '':U)
     2213                            ,input 'все':U
     2214                            ,input '':U
     2215                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2216     END.
     2217     WHEN 'rule-process':U THEN DO:
     2218       run rul/rule-process-s.w ( INPUT parparentproc
     2219                            ,INPUT (if v-ibs then
     2220                                   'b-add':U
     2221                                   else '':U)
     2222                            ,input 'все':U
     2223                            ,input '':U
     2224                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2225     END.
     2226     WHEN 'ruledict':U THEN DO:
     2227       run rul/ruledict-s.w ( INPUT parparentproc
     2228                            ,INPUT (if v-ibs then
     2229                                   'b-add':U
     2230                                   else '':U)
     2231                            ,input 'все':U
     2232                            ,input '':U
     2233                            ,input '':U
     2234                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2235     END.
     2236     WHEN 'rule':U THEN DO:
     2237       run rul/rule-s.w ( INPUT parparentproc
     2238                            ,INPUT (if v-ibs then
     2239                                   'b-add':U
     2240                                   else '':U)
     2241                            ,input 'все':U
     2242                            ,input 0
     2243                            ,input -999999999
     2244                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2245     end.
     2246     WHEN 'prop-script':U THEN DO:
     2247       run rul/prop-script-s.w ( INPUT parparentproc
     2248                            ,INPUT (if v-ibs then
     2249                                   'b-add':U
     2250                                   else '':U)
     2251                            ,input 'все':U
     2252                            ,input "ABL"
     2253                            ,input 0
     2254                            ,input '':U
     2255                            ,input '':U
     2256                            ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2257     end.
     2258   END CASE.
     2259   END PROCEDURE.
     2260   FUNCTION get-tbl-fname RETURNS CHARACTER ( INPUT p-tbl-name AS CHARACTER ) :
     2261   DEFINE VARIABLE v-tbl-fname AS CHARACTER NO-UNDO.
     2262   v-tbl-fname = ENTRY(LOOKUP(p-tbl-name, v-rum-tables), v-rum-table-names).
     2263   return v-tbl-fname.
     2264   END FUNCTION.
