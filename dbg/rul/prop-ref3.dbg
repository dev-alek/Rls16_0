        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Удаление prop-ref".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure gen-key-rec :
       71     define input  parameter p-tbl-name    as character no-undo.
       72     define input  parameter p-bh_tbl-name as handle    no-undo.
       73     define output parameter p-key-rec     as character no-undo.
       74     do
       75     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       76     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       77     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       78     :
       79       define variable fh               as handle    no-undo .
       80       define variable v-ok             as logical   no-undo .
       81       define variable v-inform         as character no-undo .
       82       define variable v-ind            as integer   no-undo .
       83       define variable v-idx-field-qnty as integer   no-undo .
       84       if p-tbl-name = ?
       85         or p-tbl-name = "":U
       86       then do:
       87         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       88       end.
       89       if not p-bh_tbl-name:available then do:
       90         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       91       end.
       92       assign
       93         p-key-rec = p-tbl-name
       94         v-inform  = p-bh_tbl-name:index-information(1)
       95         v-ind     = 2
       96       .
       97       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       98       on error undo, return error
       99       :
      100         assign
      101           v-inform = p-bh_tbl-name:index-information( v-ind )
      102           v-ind    = v-ind + 1
      103         .
      104       end.
      105       if v-inform = ?
      106         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      107         or entry( 3, v-inform, ",":U ) <> "1":U
      108       then do:
      109         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      110       end.
      111       else do:
      112         assign
      113           v-idx-field-qnty = num-entries( v-inform ) - 4
      114         .
      115         if v-idx-field-qnty < 2 then do:
      116           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      117         end.
      118         do v-ind = 1 to v-idx-field-qnty by 2
      119         on error undo, return error
      120         :
      121           assign
      122             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      123             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      124           .
      125         end.
      126       end.
      127       if p-key-rec = ? then do:
      128         assign
      129           p-key-rec = "":U
      130         .
      131         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      132       end.
      133     end.
      134     return.
      135   end procedure.
      136   procedure gen-where-keyr-tab :
      137     define input  parameter i-tableSerach as character no-undo.
      138     define input  parameter i-tablekey   as character  no-undo.
      139     define input  parameter p-key-rec    as character  no-undo.
      140     define input  parameter p-key-handle as handle     no-undo .
      141     define input  parameter p-db-name    as character  no-undo .
      142     define input  parameter p-tt-handle  as handle     no-undo .
      143     define output parameter o-Where      as character  no-undo.
      144     do
      145     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      146     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      147     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      148     :
      149       define variable v-full-tbl-name  as character no-undo .
      150       define variable bh_tbl-name      as handle    no-undo .
      151       define variable fh_key           as handle    no-undo .
      152       define variable fh_search        as handle    no-undo .
      153       define variable v-field-num      as integer   no-undo .
      154       define variable v-count-fld      as integer   no-undo .
      155       define variable v-inform         as character no-undo .
      156       define variable v-ind            as integer   no-undo .
      157       define variable v-idx-field-qnty as integer   no-undo .
      158       define variable v-field-name     as character no-undo .
      159       define variable v-field-val      as character no-undo .
      160       define variable v-word-link      as character no-undo .
      161       define variable vTable           as character no-undo.
      162       define variable bh_tbl-key       as handle    no-undo .
      163       assign
      164         p-key-rec = trim( p-key-rec )
      165       .
      166       if p-key-handle <> ? then do:
      167         if not valid-handle(p-key-handle)
      168            or p-key-handle:type <> "buffer"
      169         then do:
      170           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      171         end.
      172         if num-entries( p-key-rec, chr(3) ) > 1
      173           or p-key-rec = ?
      174           or p-key-rec = "":U
      175         then do:
      176           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      177         end.
      178       end.
      179       else do:
      180         if p-key-rec = ?
      181           or p-key-rec = "":U
      182         then do:
      183           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      184         end.
      185       end.
      186       assign
      187         vTable = entry( 1 , p-key-rec, chr(3) )
      188       .
      189       if p-tt-handle <> ?
      190         and ( not valid-handle(p-tt-handle)
      191               or p-tt-handle:type <> "buffer"
      192             )
      193       then do:
      194         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      195       end.
      196       if p-tt-handle = ? then do:
      197         assign
      198           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      199         .
      200         create buffer bh_tbl-name for table v-full-tbl-name .
      201       end.
      202       else do:
      203         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      204       end.
      205       assign
      206         v-inform = bh_tbl-name:index-information(1)
      207         v-ind    = 2
      208       .
      209       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      210       on error undo, return error
      211       :
      212         assign
      213           v-inform = bh_tbl-name:index-information( v-ind )
      214           v-ind    = v-ind + 1
      215         .
      216       end.
      217       if v-inform = ?
      218         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      219         or entry( 3, v-inform, ",":U ) <> "1":U
      220       then do:
      221         delete object bh_tbl-name no-error.
      222         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      223       end.
      224       assign
      225         v-idx-field-qnty = num-entries( v-inform ) - 4
      226       .
      227       if v-idx-field-qnty < 2 then do:
      228         delete object bh_tbl-name no-error.
      229         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      230       end.
      231       assign
      232         o-where     = "where":U
      233         v-word-link = "":U
      234         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      235         v-count-fld = 0
      236       .
      237       if i-tablekey ne "" and i-tablekey ne ?
      238       then do:
      239         assign
      240           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      241         .
      242         create buffer bh_tbl-key for table v-full-tbl-name .
      243       end.
      244       if i-tableSerach ne "" and i-tableSerach ne ?
      245       then do:
      246         delete object bh_tbl-name no-error.
      247         assign
      248           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      249         .
      250         create buffer bh_tbl-name for table v-full-tbl-name .
      251       end.
      252       block_where:
      253       do v-ind = 1 to v-idx-field-qnty by 2
      254       on error undo, return error
      255       :
      256         assign
      257           v-count-fld = v-count-fld + 1
      258         .
      259         if p-key-handle = ?
      260           and v-count-fld > v-field-num
      261         then do:
      262           leave block_where.
      263         end.
      264         define variable VfieldKeyTable as handle no-undo.
      265         assign
      266           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      267           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      268         .
      269         if     bh_tbl-key ne ?
      270         then do:
      271            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      272            if VfieldKeyTable eq ?
      273            then next block_where.
      274         end.
      275         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      276         then
      277            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      278         else
      279            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      280         if p-key-handle = ? then do:
      281           assign
      282             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      283           .
      284         end.
      285         else do:
      286           assign
      287             fh_key = p-key-handle:buffer-field( v-field-name )
      288           .
      289           if fh_key = ?
      290             or not valid-handle( fh_key )
      291           then do:
      292             delete object bh_tbl-name.
      293             if     bh_tbl-key ne ?
      294             then
      295                delete object bh_tbl-key.
      296             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      297           end.
      298           assign
      299             v-field-val = fh_key:buffer-value
      300           .
      301         end.
      302         if fh_search:data-type ="character":U then do:
      303           assign
      304             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      305             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      306             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      307             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      308             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      309             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      310             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      311             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      312             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      313             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      314             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      315             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      316             v-field-val = substitute( '"&1"', v-field-val )
      317           .
      318         end.
      319         assign
      320           o-where = substitute( "&1 &2", o-where, v-field-val )
      321         .
      322         if v-word-link = "":U then do:
      323           assign
      324             v-word-link = "and":U
      325           .
      326         end.
      327       end.
      328       delete object bh_tbl-name.
      329       if     bh_tbl-key ne ?
      330       then
      331          delete object bh_tbl-key.
      332       if p-key-handle = ?
      333         and v-count-fld <> v-field-num
      334       then do:
      335         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      336       end.
      337     end.
      338   end procedure.
      339   procedure gen-hn-keyr-tab :
      340     define input  parameter i-tableSerach as character no-undo.
      341     define input  parameter i-tablekey   as character no-undo.
      342     define input  parameter p-key-rec    as character no-undo.
      343     define input  parameter p-key-handle as handle    no-undo .
      344     define input  parameter p-db-name    as character no-undo .
      345     define input  parameter p-tt-handle  as handle    no-undo .
      346     define input  parameter p-stts-lock  as integer   no-undo .
      347     define output parameter o-hn         as handle    no-undo.
      348     define variable v-full-tbl-name as character no-undo.
      349     define variable v-where         as character no-undo.
      350     define variable bh_tbl-name     as handle    no-undo.
      351     define variable vTable          as character no-undo.
      352     do
      353     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      354     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      355     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      356         run gen-where-keyr-tab(i-tableSerach,
      357                                i-tablekey,
      358                                p-key-rec,
      359                                p-key-handle,
      360                                p-db-name,
      361                                p-tt-handle,
      362                                output v-where).
      363         if i-tableSerach ne "" and i-tableSerach ne ?
      364         then do:
      365            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      366            create buffer bh_tbl-name for table v-full-tbl-name .
      367         end.
      368         else do:
      369            if p-tt-handle = ? then do:
      370               assign
      371                  vTable = entry( 1 , p-key-rec, chr(3) )
      372               .
      373               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      374               create buffer bh_tbl-name for table v-full-tbl-name .
      375            end.
      376            else do:
      377               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      378            end.
      379         end.
      380         if p-tt-handle = ? then do:
      381            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      382         end.
      383         else do:
      384            bh_tbl-name:find-first( v-where ) no-error .
      385         end.
      386         o-hn = bh_tbl-name.
      387      end.
      388   end procedure.
      389   procedure gen-hn-keyr :
      390     define input  parameter p-key-rec    as character no-undo.
      391     define input  parameter p-key-handle as handle    no-undo .
      392     define input  parameter p-db-name    as character no-undo .
      393     define input  parameter p-tt-handle  as handle    no-undo .
      394     define input  parameter p-stts-lock  as integer   no-undo .
      395     define output parameter o-hn         as handle    no-undo.
      396     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      397   end.
      398   procedure gen-row-keyr :
      399     define input  parameter p-key-rec    as character no-undo.
      400     define input  parameter p-key-handle as handle    no-undo .
      401     define input  parameter p-db-name    as character no-undo .
      402     define input  parameter p-tt-handle  as handle    no-undo .
      403     define input  parameter p-stts-lock  as integer   no-undo .
      404     define output parameter p-tbl-row    as rowid     no-undo.
      405     define output parameter p-tbl-name   as character no-undo.
      406     define variable vHn as handle no-undo.
      407       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      408       p-tbl-row = if vHn:available then vHn:rowid else ?.
      409       p-tbl-name =  vHn:table.
      410       delete object vHn no-error.
      411     if p-tbl-row = ? then do:
      412       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      413     end.
      414     else do:
      415       return.
      416     end.
      417   end procedure.
      418   procedure gen-key-fv :
      419     define input  parameter p-key-rec    as character no-undo .
      420     define output parameter p-field-list as character no-undo .
      421     define output parameter p-value-list as character no-undo.
      422     do
      423     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      424     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      425     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      426     :
      427       define variable v-full-tbl-name  as character no-undo .
      428       define variable bh_tbl-name      as handle    no-undo .
      429       define variable v-tbl-name       as character no-undo .
      430       define variable v-field-num      as integer   no-undo .
      431       define variable v-count-fld      as integer   no-undo .
      432       define variable v-inform         as character no-undo .
      433       define variable v-ind            as integer   no-undo .
      434       define variable v-idx-field-qnty as integer   no-undo .
      435       define variable v-delim-key      as character no-undo .
      436       if p-key-rec = ?
      437         or p-key-rec = "":U
      438       then do:
      439         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      440       end.
      441       assign
      442         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      443         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      444       .
      445       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      446       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      447       assign
      448         v-inform = bh_tbl-name:index-information(1)
      449         v-ind    = 2
      450       .
      451       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      452       on error undo, return error
      453       :
      454         assign
      455           v-inform = bh_tbl-name:index-information( v-ind )
      456           v-ind    = v-ind + 1
      457         .
      458       end.
      459       if v-inform = ?
      460         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      461         or entry( 3, v-inform, ",":U ) <> "1":U
      462       then do:
      463         delete object bh_tbl-name no-error.
      464         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      465       end.
      466       assign
      467         v-idx-field-qnty = num-entries( v-inform ) - 4
      468       .
      469       if v-idx-field-qnty < 2 then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      472       end.
      473       assign
      474         p-field-list = "":U
      475         p-value-list = "":U
      476         v-delim-key  = "":U
      477         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      478         v-count-fld  = 0
      479       .
      480       block_where:
      481       do v-ind = 1 to v-idx-field-qnty by 2
      482       on error undo, return error
      483       :
      484         assign
      485           v-count-fld = v-count-fld + 1
      486         .
      487         if v-count-fld > v-field-num then do:
      488           leave block_where.
      489         end.
      490         assign
      491           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      492           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      493         .
      494         if v-ind = 1 then do:
      495           assign
      496             v-delim-key = chr(3)
      497           .
      498         end.
      499       end.
      500       delete object bh_tbl-name.
      501       if v-count-fld <> v-field-num then do:
      502         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      503       end.
      504     end.
      505   end procedure.
      506   procedure gen-key-field :
      507     define input  parameter p-table      as character no-undo .
      508     define output parameter p-field-list as character no-undo .
      509     do
      510     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      511     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      512     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      513     :
      514       define variable v-full-tbl-name  as character no-undo .
      515       define variable bh_tbl-name      as handle    no-undo .
      516       define variable v-tbl-name       as character no-undo .
      517       define variable v-field-num      as integer   no-undo .
      518       define variable v-count-fld      as integer   no-undo .
      519       define variable v-inform         as character no-undo .
      520       define variable v-ind            as integer   no-undo .
      521       define variable v-idx-field-qnty as integer   no-undo .
      522       define variable v-delim-key      as character no-undo .
      523       if p-table = ?
      524         or p-table = "":U
      525       then do:
      526         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      527       end.
      528       assign
      529         v-tbl-name      = p-table
      530         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      531       .
      532       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      533       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      534       assign
      535         v-inform = bh_tbl-name:index-information(1)
      536         v-ind    = 2
      537       .
      538       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      539       on error undo, return error
      540       :
      541         assign
      542           v-inform = bh_tbl-name:index-information( v-ind )
      543           v-ind    = v-ind + 1
      544         .
      545       end.
      546       if v-inform = ?
      547         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      548         or entry( 3, v-inform, ",":U ) <> "1":U
      549       then do:
      550         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      551       end.
      552       assign
      553         v-idx-field-qnty = num-entries( v-inform ) - 4
      554       .
      555       if v-idx-field-qnty < 2 then do:
      556         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      557       end.
      558       assign
      559         p-field-list = "":U
      560         v-delim-key  = "":U
      561         v-count-fld  = 0
      562       .
      563       block_where:
      564       do v-ind = 1 to v-idx-field-qnty by 2
      565       on error undo, return error
      566       :
      567         assign
      568           v-count-fld = v-count-fld + 1
      569         .
      570         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      571         if v-ind = 1 then do:
      572           assign
      573             v-delim-key = chr(3)
      574           .
      575         end.
      576       end.
      577       delete object bh_tbl-name.
      578     end.
      579   end procedure.
      580   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   FUNCTION get-region RETURNS CHARACTER
      582     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      583     define variable par-region as character no-undo.
      584     if parhost-code = 0 and
      585          parobj-type = "":U and
      586          parobj-code = 0 then do:
      587          par-region = "Глобально".
      588          return par-region.
      589       end.
      590       if parobj-type = 'орг':U then do:
      591          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      592          return par-region.
      593       end.
      594       if parobj-type = 'регион':U
      595       then do:
      596          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      597          return par-region.
      598       end.
      599       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      600       return par-region.
      601   END FUNCTION.
      602   FUNCTION get-objregion RETURNS CHARACTER
      603     (  input parobj-type as character, input parobj-code as integer ) :
      604     define variable par-region as character no-undo.
      605     if  parobj-type = "":U and
      606         parobj-code = 0
      607     then do:
      608        par-region = "Глобально".
      609     end.
      610     else if parobj-type = 'орг':U
      611     then do:
      612        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      613     end.
      614     else if parobj-type = 'регион':U
      615     then do:
      616        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      617     end.
      618     else
      619        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      620     return par-region.
      621   END FUNCTION.
      622   FUNCTION calldscr returns character ( input p-call-id as character):
      623   define variable v-descr as character no-undo .
      624   define variable v-field-list as character no-undo .
      625   define variable v-value-list as character no-undo.
      626   define variable v-prop-label as character no-undo .
      627   define variable v-node-label as character no-undo .
      628   define variable v-dt-code as integer no-undo .
      629   define variable v-host-code as integer no-undo .
      630   define variable v-obj-type as character no-undo .
      631   define variable v-obj-code as integer no-undo .
      632   define variable v-label as character no-undo .
      633   define variable v-node-code as integer no-undo .
      634   define buffer buf_prop-head for ub.prop-head.
      635   define buffer buf_prop-ref for ub.prop-ref.
      636   define buffer buf_prop-map for ub.prop-map.
      637   run gen-key-fv in this-procedure ( input p-call-id
      638                                     ,output v-field-list
      639                                     ,output v-value-list) no-error .
      640   if error-status:error then return p-call-id.
      641   CASE entry(1, p-call-id, chr(3)):
      642     when 'dis-card-type':U then do:
      643       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      644                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      645                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      646                            ).
      647     end.
      648     when 'dis-card':U then do:
      649       v-descr = substitute("ДК: № &1"
      650                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      651                            ).
      652     end.
      653     when 'dis-card-property':U then do:
      654       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      655       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      656       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      657       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      658       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      659       find first buf_prop-ref no-lock where
      660                 buf_prop-ref.dt-code = v-dt-code no-error .
      661       if available buf_prop-ref then do:
      662         find first buf_prop-head no-lock where
      663                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      664         v-prop-label = buf_prop-head.prop-label.
      665         find first buf_prop-map no-lock where
      666                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      667               and buf_prop-map.node-code = v-node-code no-error .
      668         if available buf_prop-map then do:
      669           v-label = buf_prop-map.node-label.
      670         end.
      671       end.
      672       v-descr = substitute("ДК: № &1 &2:&3 &4"
      673                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      674                            ,v-prop-label
      675                            ,v-label
      676                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      677                            ).
      678     end.
      679     when 'clients':U then do:
      680       v-descr = substitute("&1&2"
      681                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      682                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      683                            ).
      684     end.
      685     when 'ext-system':U then do:
      686       v-descr = substitute("Внешняя система &1"
      687                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      688                            ).
      689     end.
      690     WHEN 'thbj-attr':U then do:
      691       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      692       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      693       then do:
      694         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      695           v-descr = "Операции с товарами".
      696         end.
      697         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      698           v-descr = "Операции с клиентами".
      699         end.
      700         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      701           v-descr = "Операции с группами товаров".
      702         end.
      703         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      704           v-descr = "Операции с группами клиентов".
      705         end.
      706         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      707           v-descr = "Операции с чеками на POS IBS-TH".
      708         end.
      709         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
      710           v-descr = "Операции с чеками на POS IBS-TH-MOB".
      711         end.
      712         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
      713           v-descr = "Операции в системе электронного документооборота".
      714         end.
      715         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
      716           v-descr = "Операции со справочниками".
      717         end.
      718         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
      719           v-descr = "Операции с ДНЦ и переоценками".
      720         end.
      721         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
      722           v-descr = "Отчеты".
      723         end.
      724         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
      725           v-descr = "Операции с заказами".
      726         end.
      727       end.
      728     end.
      729     when 'cash-desk':U then do:
      730       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
      731                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      732                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
      733                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
      734                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
      735                            ).
      736     end.
      737     when 'ext-file':U then do:
      738       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
      739                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
      740                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
      741                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
      742                            ).
      743     end.
      744   end case.
      745   return v-descr.
      746   end function.
      747   define variable v-mess as character no-undo .
      748   define buffer buf_prop-ref  for dictdb.prop-ref.
      749   define buffer buf_prop-script for ub.prop-script.
      750   define buffer buf_prop-map for ub.prop-map.
      751   define buffer buf_ruledict for ub.ruledict.
      752   define buffer buf_ruledict-param for ub.ruledict-param.
      753   define buffer buf_prop-head for ub.prop-head.
      754   define buffer buf_prop-ref-call for ub.prop-ref-call.
      755   main-block:
      756   do
      757   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      758   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      759   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      760   :
      761     find first buf_prop-ref exclusive-lock where
      762             recid(buf_prop-ref) = p-rec .
      763     if buf_prop-ref.sum-id = '':U
      764     or buf_prop-ref.dt-code = 0 then do:
      765       v-mess = substitute("Нельзя удалить главный срез (с кодом 0 и пустым идентификатором)" ).
      766      run err-mess in this-procedure ( input-output v-mess) .
      767      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      768     end.
      769     define variable v-ok as logical no-undo .
      770     define variable v-mwss as character no-undo .
      771     find first buf_prop-head no-lock where
      772             buf_prop-head.dtm-code = buf_prop-ref.dtm-code.
      773     run rul/pref-chk.p ( input 'удаление':U
      774                         ,input "prop-ref3"
      775                         ,input buf_prop-ref.dtm-code
      776                         ,input buf_prop-ref.dt-code
      777                         ,output v-ok
      778                         ,output v-mess) no-error .
      779     if error-status:error
      780     or not v-ok then do:
      781       v-mess = substitute("Нельзя удалить cрез/итог: &1", v-mess ).
      782       run err-mess in this-procedure ( input-output v-mess) .
      783       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      784     end.
      785     for each buf_ruledict where
      786             buf_ruledict.uniq-key-rec = buf_prop-ref.uniq-key-rec
      787     on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      788      for each buf_ruledict-param where
      789              buf_ruledict-param.entry-id = buf_ruledict.entry-id
      790      on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      791         delete buf_ruledict-param.
      792      end.
      793      delete buf_Ruledict.
      794     end.
      795     delete buf_prop-ref no-error.
      796     if error-status:error then do:
      797       v-mess = substitute("Ошибка при удалении: &1&2&3"
      798                            , error-status:get-message(1)
      799                            , chr(10)
      800                            , return-value ).
      801      run err-mess in this-procedure ( input-output v-mess) .
      802      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      803     end.
      804   end.
      805   PROCEDURE err-mess:
      806     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      807     CASE p-silent:
      808       when yes then do:
      809         assign
      810         p-mess = substitute("Срез данных по ДК: код объекта &1 код среза &2:&3&4"
      811                            , buf_prop-ref.dtm-code
      812                            , buf_prop-ref.dt-code
      813                            , chr(10)
      814                            , p-mess)
      815         .
      816       end.
      817       when no then do:
      818         message
      819         p-mess
      820         view-as alert-box error .
      821       end.
      822     end.
      823   END PROCEDURE.
