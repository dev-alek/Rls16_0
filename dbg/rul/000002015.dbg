     1092   tbl-name
     1093   uniq-key-rec
     1094   .
     1095   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   procedure factord :
     1097     define input  parameter p-fact-date            as date    no-undo .
     1098     define input  parameter p-fact-time            as integer no-undo .
     1099     define input  parameter p-fact-num             as integer no-undo .
     1100     define input  parameter p-shift-date           as date    no-undo .
     1101     define input  parameter p-shift-num            as integer no-undo .
     1102     define input  parameter p-shift-on             as logical no-undo .
     1103     define output parameter p-fact-order           as decimal no-undo .
     1104     define output parameter p-shift-end-fact-order as decimal no-undo .
     1105     define output parameter p-day-end-fact-order   as decimal no-undo .
     1106     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1107     if p-fact-date = ?
     1108     then do:
     1109       return error "Не указана фактическая дата" .
     1110     end.
     1111     define variable v-fact-date-num as integer no-undo .
     1112     assign
     1113       v-fact-date-num = integer(p-fact-date)
     1114     .
     1115     if p-fact-num = ?
     1116     or p-fact-num = 0
     1117     then do:
     1118       return error "Не задан p-fact-num " + string(p-fact-num) .
     1119     end.
     1120     if p-fact-num < 0
     1121     then do:
     1122       return error "Отрицательный fact-num " + string(p-fact-num) .
     1123     end.
     1124     if p-fact-num >= 100000000
     1125     then do:
     1126       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1127     end.
     1128     if p-shift-on = true
     1129     then do:
     1130       if p-shift-date = ?
     1131       then do:
     1132         return error "Не задана дата смены" .
     1133       end.
     1134       if p-shift-num = ?
     1135       or p-shift-num = 0
     1136       then do:
     1137         return error "Не задан номер смены" .
     1138       end.
     1139     end.
     1140     else do:
     1141       assign
     1142         p-shift-date = p-fact-date
     1143         p-shift-num  = 24
     1144       .
     1145     end.
     1146     define variable v-shift-offset as integer no-undo .
     1147     if p-shift-date = p-fact-date
     1148     then do:
     1149       assign
     1150         v-shift-offset = 1
     1151       .
     1152     end.
     1153     if p-shift-date < p-fact-date
     1154     then do:
     1155       assign
     1156         v-shift-offset = 0
     1157       .
     1158     end.
     1159     if p-shift-date > p-fact-date
     1160     then do:
     1161       message
     1162         vss-workfile vss-revision vss-description skip
     1163         "Неправильная дата закрытия смены" skip
     1164         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1165         view-as alert-box error .
     1166       undo, return error
     1167         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1168           ,string(p-fact-date, '99/99/9999':U)
     1169           ,string(p-shift-date, '99/99/9999':U)
     1170           )
     1171       .
     1172     end.
     1173     if p-shift-num < 1
     1174     or p-shift-num > 24
     1175     then do:
     1176       message
     1177         vss-workfile vss-revision vss-description skip
     1178         "Неправильный номер смены" skip
     1179         "p-shift-num" p-shift-num skip
     1180         view-as alert-box error .
     1181       undo, return error return-value .
     1182     end.
     1183     assign
     1184       p-fact-order           = v-fact-date-num
     1185                              + v-shift-offset * 0.5
     1186                              + p-shift-num    * 0.02 - 0.01
     1187                              + p-fact-num     * 0.0000000001
     1188       p-shift-end-fact-order = v-fact-date-num
     1189                              + v-shift-offset * 0.5
     1190                              + p-shift-num    * 0.02
     1191       p-day-end-fact-order   = v-fact-date-num
     1192                              + 0.99
     1193     .
     1194     if p-fact-order           <= v-fact-date-num
     1195     or p-shift-end-fact-order <= v-fact-date-num
     1196     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1197     or p-shift-end-fact-order >= p-day-end-fact-order
     1198     then do:
     1199       message
     1200         vss-workfile vss-revision vss-description skip
     1201         "Внутренняя ошибка при генерации фактического номера" skip
     1202         "p-fact-date"            p-fact-date            skip
     1203         "p-fact-time"            p-fact-time            skip
     1204         "p-fact-num"             p-fact-num             skip
     1205         "p-shift-date"           p-shift-date           skip
     1206         "p-shift-num"            p-shift-num            skip
     1207         "p-shift-on"             p-shift-on             skip
     1208         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1209         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1210         "v-fact-date-num"        v-fact-date-num        skip
     1211         view-as alert-box error .
     1212       undo, return error return-value .
     1213     end.
     1214   end procedure.
     1215   procedure day-begin-fact-order :
     1216     define input  parameter p-fact-date            as date    no-undo .
     1217     define output parameter p-day-begin-fact-order as decimal no-undo .
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       if p-fact-date = ?
     1222       then do:
     1223         assign
     1224           p-day-begin-fact-order = 0
     1225         .
     1226       end.
     1227       else do:
     1228         assign
     1229           p-day-begin-fact-order = integer(p-fact-date)
     1230         .
     1231       end.
     1232     end.
     1233   end procedure.
     1234   procedure factord-max-fact-order :
     1235     define output parameter p-max-fact-order as decimal   no-undo .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       run day-begin-fact-order in this-procedure
     1240         (input  date(1, 1, 5000)
     1241         ,output p-max-fact-order
     1242         ) .
     1243     end.
     1244   end procedure.
     1245   procedure factord-cut-archive :
     1246     define input  parameter p-obj-type             as character no-undo .
     1247     define input  parameter p-obj-code             as integer   no-undo .
     1248     define input  parameter p-fact-date            as date      no-undo .
     1249     define output parameter p-shift-on             as logical   no-undo .
     1250     define output parameter p-shift-date           as date      no-undo .
     1251     define output parameter p-shift-num            as integer   no-undo .
     1252     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1253     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1254     define variable v-fact-order as decimal   no-undo .
     1255     define buffer buf_shift-obj for ub.shift-obj .
     1256     do
     1257     on error undo, return error return-value
     1258     :
     1259   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1261     (input  p-obj-type
     1262     ,input  p-obj-code
     1263     ,input  'shift-on=request'
     1264     ,output p-shift-on
     1265     ) no-error .
     1266       if error-status :error
     1267       then do:
     1268         message
     1269           vss-workfile vss-revision vss-description skip
     1270           "Ошибка при определении атрибута объекта" skip
     1271           "Объект" p-obj-type p-obj-code skip
     1272           error-status :get-message(1) skip
     1273           return-value skip
     1274           view-as alert-box error .
     1275         undo, return error return-value .
     1276       end.
     1277       if p-shift-on = false
     1278       then do:
     1279         assign
     1280           p-shift-date               = ?
     1281           p-shift-num                = 0
     1282         .
     1283       end.
     1284       else do:
     1285         find first buf_shift-obj share-lock
     1286           where buf_shift-obj.obj-type   = p-obj-type
     1287             and buf_shift-obj.obj-code   = p-obj-code
     1288             and buf_shift-obj.shift-date > p-fact-date
     1289           use-index pi
     1290           no-error .
     1291         if not available buf_shift-obj
     1292         or buf_shift-obj.status_ <> 'зкр':U
     1293         then do:
     1294           message
     1295             vss-workfile vss-revision vss-description skip
     1296             "Невозможно вычислить последнюю смену" skip
     1297             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1298             "Объект" p-obj-type p-obj-code skip
     1299             "Дата" p-fact-date skip
     1300             view-as alert-box error .
     1301           undo, return error return-value .
     1302         end.
     1303         find last buf_shift-obj share-lock
     1304           where buf_shift-obj.obj-type = p-obj-type
     1305             and buf_shift-obj.obj-code = p-obj-code
     1306             and buf_shift-obj.shift-date <= p-fact-date
     1307           use-index pi
     1308           no-error .
     1309         if available buf_shift-obj
     1310         then do:
     1311           if  buf_shift-obj.status_ = 'зкр':U
     1312           then do:
     1313             assign
     1314               p-shift-date = buf_shift-obj.shift-date
     1315               p-shift-num  = buf_shift-obj.shift-num
     1316             .
     1317           end.
     1318           else do:
     1319             message
     1320               vss-workfile vss-revision vss-description skip
     1321               "Невозможно вычислить последнюю смену" skip
     1322               "Статус смены отличен от статуса" 'зкр':U skip
     1323               "Объект" p-obj-type p-obj-code skip
     1324               "Дата" p-fact-date skip
     1325               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1326               view-as alert-box error .
     1327             undo, return error return-value .
     1328           end.
     1329         end.
     1330         else do:
     1331           assign
     1332             p-shift-date = p-fact-date - 1
     1333             p-shift-num  = 1
     1334           .
     1335         end.
     1336       end.
     1337       run factord in this-procedure
     1338         (input  p-fact-date
     1339         ,input  1
     1340         ,input  1
     1341         ,input  p-shift-date
     1342         ,input  p-shift-num
     1343         ,input  p-shift-on
     1344         ,output v-fact-order
     1345         ,output p-shift-end-fact-order
     1346         ,output p-day-end-fact-order
     1347         ) no-error .
     1348       if error-status :error
     1349       then do:
     1350         message
     1351           vss-workfile vss-revision vss-description skip
     1352           "Ошибка при вызове процедуры factord"
     1353           error-status :get-message(1) skip
     1354           return-value skip
     1355           view-as alert-box error .
     1356         undo, return error return-value .
     1357       end.
     1358     end.
     1359   end procedure.
     1360   procedure factord-lock-shift :
     1361     define input  parameter p-obj-type  as character no-undo .
     1362     define input  parameter p-obj-code  as integer   no-undo .
     1363     define input  parameter p-fact-date as date      no-undo .
     1364     define parameter buffer buf_shift-obj for ub.shift-obj .
     1365     define variable v-shift-on      as logical   no-undo .
     1366     define variable v-extra-message as character no-undo .
     1367     define variable v-error as character no-undo .
     1368     do
     1369     on error undo, return error return-value
     1370     :
     1371   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1373     (input  p-obj-type
     1374     ,input  p-obj-code
     1375     ,input  'shift-on=request'
     1376     ,output v-shift-on
     1377     ) no-error .
     1378       if error-status :error
     1379       then do:
     1380         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1381         undo, return error v-error .
     1382       end.
     1383       if v-shift-on = true
     1384       then do:
     1385         find first buf_shift-obj share-lock
     1386           where buf_shift-obj.obj-type   = p-obj-type
     1387             and buf_shift-obj.obj-code   = p-obj-code
     1388             and buf_shift-obj.shift-date > p-fact-date
     1389           use-index pi
     1390           no-error .
     1391         if not available buf_shift-obj
     1392         or buf_shift-obj.status_ <> 'зкр':U
     1393         then do:
     1394           find last buf_shift-obj
     1395             where buf_shift-obj.obj-type = p-obj-type
     1396               and buf_shift-obj.obj-code = p-obj-code
     1397               and buf_shift-obj.status_  = 'зкр':U
     1398             use-index stts
     1399             no-error .
     1400           if available buf_shift-obj
     1401           then do:
     1402             assign
     1403               v-extra-message =
     1404                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1405                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1406                               )
     1407             .
     1408           end.
     1409           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1410           undo, return error v-error .
     1411         end.
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure factord-end-day :
     1416     define input  parameter p-fact-date            as date    no-undo .
     1417     define output parameter p-day-end-fact-order   as decimal no-undo .
     1418     do
     1419     on error undo, return error return-value
     1420     :
     1421       if p-fact-date = ?
     1422       then do:
     1423         return error "Не указана фактическая дата" .
     1424       end.
     1425       assign
     1426         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1427       .
     1428     end.
     1429   end procedure.
     1430   procedure factord-to-date :
     1431     define input  parameter p-fact-order as decimal no-undo .
     1432     define output parameter p-fact-date  as date    no-undo .
     1433     define variable v-ref-date  as date      no-undo .
     1434     define variable v-ref-delta as integer   no-undo .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       if p-fact-order = ?
     1439       or p-fact-order = 0
     1440       then do:
     1441         return error "Не указан fact-order" .
     1442       end.
     1443       assign
     1444         v-ref-date  = date(1, 1, 2000)
     1445       .
     1446       assign
     1447         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1448       .
     1449       assign
     1450         p-fact-date = v-ref-date + v-ref-delta
     1451       .
     1452     end.
     1453   end procedure.
     1454   procedure factord-to-fact-num :
     1455     define input  parameter p-fact-order as decimal no-undo .
     1456     define output parameter p-fact-num   as integer no-undo .
     1457     define variable v-fact-order-trunc as decimal no-undo .
     1458     do
     1459     on error undo, return error return-value
     1460     :
     1461       if p-fact-order = ?
     1462       or p-fact-order = 0
     1463       then do:
     1464         return error "Не указан fact-order" .
     1465       end.
     1466       assign
     1467        v-fact-order-trunc = truncate(p-fact-order, 2)
     1468       .
     1469       assign
     1470         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1471       .
     1472     end.
     1473   end procedure.
     1474   procedure factord-to-shift-num :
     1475     define input  parameter p-fact-order as decimal no-undo .
     1476     define output parameter p-shift-num   as integer no-undo .
     1477     define variable  p-shift-numd  as decimal   no-undo .
     1478     define variable v-fact-order-trunc as decimal no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       if p-fact-order = ?
     1483       or p-fact-order = 0
     1484       then do:
     1485         return error "Не указан fact-order" .
     1486       end.
     1487       assign
     1488        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1489       .
     1490       if v-fact-order-trunc < 0.5 then do:
     1491         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1492       end.
     1493       assign
     1494         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1495         .
     1496        assign
     1497         p-shift-num = truncate (p-shift-numd , 0)
     1498       .
     1499     end.
     1500   end procedure.
     1501   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1502   define variable v-current-host-code as integer no-undo .
     1503   define variable v-current-obj-type as character no-undo .
     1504   define variable v-current-obj-code as integer no-undo .
     1505   define variable v-current-doc-code as character no-undo .
     1506   define variable v-current-doc-date as date no-undo .
     1507   define variable v-current-doc-type as character no-undo .
     1508   define variable v-current-doc-time as integer no-undo .
     1509   define variable v-current-lock as integer no-undo .
     1510   define variable v-current-wait as integer no-undo .
     1511   define variable v-save as integer no-undo .
     1512   define variable v-current-db-num as integer no-undo .
     1513   define variable v-current-date as date no-undo .
     1514   define variable v-sign as integer no-undo .
     1515   define variable file-name as char.
     1516   define variable num-rec as integer no-undo .
     1517   define variable num-rec-ok as integer no-undo .
     1518   define variable num-rec-ok2 as integer no-undo .
     1519   define variable v-full-path        as character no-undo .
     1520   define variable v-path             as character no-undo .
     1521   define variable v-file-name        as character no-undo .
     1522   define variable v-file-name-no-ext as character no-undo .
     1523   define variable v-file-name-ext    as character no-undo .
     1524   define variable v-end-new-line     as logical no-undo .
     1525   define variable v-last-error-message as character no-undo .
     1526   define variable v-retry-action as integer no-undo .
     1527   define variable v_dataseth as handle no-undo .
     1528   define variable v-xmlh as handle no-undo .
     1529   define variable v_qh as handle no-undo .
     1530   define variable v_child-qh         as handle    no-undo .
     1531   define variable glog as logical no-undo .
     1532   define variable v-ds-read-order as character no-undo .
     1533   define variable v-esys-id as integer no-undo .
     1534   define variable v-pck-num as integer no-undo .
     1535   define variable v-extension as character no-undo .
     1536   define variable v-err-type as character no-undo .
     1537   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   procedure set-error :
     1539   define input parameter p-mess as character no-undo .
     1540     do
     1541     on error undo, return error
     1542     :
     1543        assign
     1544        v-last-error-message = p-mess.
     1545     end.
     1546   end procedure.
     1547   define buffer buf_temp-cmd for temp-cmd.
     1548   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1549   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1550   define buffer buf_temp-xml-tables for temp-xml-tables.
     1551   define variable log-file-name                as character      no-undo .
     1552   define variable v-view-log                   as logical        no-undo .
     1553   define variable v-stop                       as logical        no-undo .
     1554   procedure clear_tt :
     1555     do
     1556     on error  undo, return error substitute( "&1 (clear-tt). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1557     on stop   undo, return error substitute( "&1 (clear-tt). stop", vss-workfile )
     1558     on endkey undo, return error substitute( "&1 (clear-tt). endkey", vss-workfile )
     1559     :
     1560     end.
     1561   end procedure.
     1562   function 00200004_get-error-message returns character :
     1563   define variable v-ii as integer no-undo .
     1564   define variable v-mess as character no-undo .
     1565   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1566       v-mess = substitute("&1&2ош &3"
     1567                           ,v-mess
     1568                           ,chr(10)
     1569                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     1570   END.
     1571   end function.
     1572     define variable p-esys-id  as integer no-undo.
     1573     define variable p-xsd-file as character no-undo.
     1574   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1576   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1577   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   function context_get-thobj-es return logical
     1579   (
     1580      input p-esys-id as integer
     1581     ,input p-eobj-type as character
     1582     ,input p-eobj-code as integer
     1583     ,output p-obj-type as character
     1584     ,output p-obj-code as integer
     1585   ):
     1586      define variable v-value-list as character no-undo .
     1587      define variable v-field-list as character no-undo .
     1588      define buffer buf_clients for ub.clients.
     1589      define buffer buf_ext-classif for ub.ext-classif.
     1590      find first buf_ext-classif no-lock where
     1591                buf_ext-classif.classif-name = 'clients-esys':U
     1592            and buf_ext-classif.classif-subject = 'clients':U
     1593            and buf_ext-classif.db-num = 0
     1594            and buf_Ext-classif.key#_one = p-esys-id
     1595            and buf_Ext-classif.charkey_one = p-eobj-type
     1596            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1597      if available buf_Ext-classif
     1598      then do:
     1599         ObjSrv:Lib:KeyRec:GenKeyFv (
     1600                                         input buf_Ext-classif.uniq-key-rec
     1601                                         ,output v-field-list
     1602                                         ,output v-value-list).
     1603         assign
     1604            p-obj-type = entry(lookup("obj-type":U
     1605                                     , v-field-list
     1606                                     , chr(3))
     1607                                     , v-value-list, chr(3))
     1608            p-obj-code = integer(entry(lookup("obj-code":U
     1609                                            , v-field-list
     1610                                            , chr(3))
     1611                                      , v-value-list
     1612                                      , chr(3)))
     1613         no-error .
     1614      end.
     1615      if     available buf_ext-classif
     1616         and (p-obj-type = 'маг':U
     1617              or
     1618              p-obj-type = 'скл':U
     1619              )
     1620         and (p-obj-code > 0 and p-obj-code <= 99999)
     1621      then do:
     1622         find first buf_clients no-lock where
     1623                    buf_clients.obj-type = p-obj-type
     1624                and buf_clients.obj-code = p-obj-code no-error.
     1625         if available buf_clients then do:
     1626            return yes.
     1627         end.
     1628         else do:
     1629            assign
     1630               p-obj-type = '':U
     1631               p-obj-code = 0
     1632            .
     1633            return no.
     1634         end.
     1635      end.
     1636      else do:
     1637         assign
     1638            p-obj-type = '':U
     1639            p-obj-code = 0
     1640         .
     1641         return no.
     1642      end.
     1643   end.
     1644   on delete of this-procedure do:
     1645     run delete-procedure in this-procedure .
     1646   end.
     1647   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     1648   if error-status:error
     1649   or return-value = "return" then return.
     1650    define variable ImpData1 as class Route-data_ no-undo .
     1651   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     1652   if not this-procedure:persistent then do:
     1653     run proc-main in this-procedure  no-error .
     1654     if error-status:error then do:
     1655         run delete-procedure in this-procedure .
     1656         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1657     end.
     1658     run delete-procedure in this-procedure .
     1659   end.
     1660   procedure proc-main :
     1661   define variable v-ii as integer   no-undo .
     1662   define variable v-line-num         as   integer                      no-undo .
     1663   define variable v-present          as   logical                      no-undo .
     1664   define buffer buf_ext-system for ub.ext-system.
     1665   if transaction then do:
     1666     message
     1667       vss-workfile vss-revision vss-description skip
     1668       substitute("Вызов процедуры в действующей транзакции недопустим") skip
     1669       view-as alert-box error .
     1670     return error substitute( "&1 (proc-main). Вызов процедуры в действующей транзакции недопустим", vss-workfile ) .
     1671   end.
     1672   _main:
     1673   do
     1674   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1675   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1676   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1677   :
     1678     run write-log in p-log-handle ( input 0, "&DLine").
     1679       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по валютам и курсам из ВС")).                      assign v-view-log = yes.
     1680     run write-log-and-file in p-log-handle (
     1681         input 1
     1682       , input log-file-name
     1683       , input 1
     1684       , input substitute("Импорт данных по валютам и курсам из файла &1", file-name)).
     1685     find first buf_ext-system no-lock where
     1686               buf_ext-system.esys-id = p-esys-id
     1687           and buf_ext-system.db-num = 0 no-error.
     1688     if not available buf_ext-system
     1689     or not (buf_ext-system.esys-type  = integer('3':U)) then do:
     1690           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1 или она не имеет типа ORACLE RETAIL", p-esys-id)).                      assign v-view-log = yes.
     1691         undo _main, return error ''.
     1692     end.
     1693     assign
     1694       num-rec          = 0
     1695       num-rec-ok       = 0
     1696       num-rec-ok2      = 0
     1697     .
     1698     _table:
     1699     for each buf_temp-xml-tables where
     1700             buf_temp-xml-tables.order >= 0
     1701         and buf_temp-xml-tables.is-parent = true
     1702     on error undo _table, retry _table
     1703     :
     1704       if retry then do:
     1705               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                               , buf_temp-xml-tables.tbl-name                                                               , chr(10)                                                               , error-status:get-message(1)                                                               , return-value)).                      assign v-view-log = yes.
     1706         run delete-procedure in this-procedure .
     1707         if valid-handle(v_qh) then do:
     1708           delete object v_qh no-error.
     1709         end.
     1710         undo _main, return error ''.
     1711       end.
     1712       if buf_temp-xml-tables.tbl-name = "THheader" then next.
     1713       create query v_qh.
     1714       glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     1715       if error-status:error
     1716       or not glog
     1717     then do:
     1718       undo _table, retry _table.
     1719     end.
     1720     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     1721     if error-status:error
     1722     or not glog
     1723     then do:
     1724       undo _table, retry _table.
     1725     end.
     1726     glog = v_qh:query-open no-error .
     1727     if error-status:error
     1728     or not glog
     1729     then do:
     1730       undo _table, retry _table.
     1731     end.
     1732     _stroka:
     1733     REPEAT:
     1734       assign
     1735         num-rec = num-rec + 1
     1736         v-retry-action = 0
     1737       .
     1738       _release:
     1739       do
     1740       on error undo _release, retry _release
     1741       :
     1742         if  retry then do:
     1743           v-retry-action = v-retry-action + 1.
     1744                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                     , buf_temp-xml-tables.tbl-name                                                                     , num-rec                                                                     , chr(10)                                                                     , error-status:get-message(1)                                                                     , return-value)).                      assign v-view-log = yes.
     1745           run delete-procedure in this-procedure .
     1746           if valid-handle(v_qh) then do:
     1747             delete object v_qh no-error.
     1748           end.
     1749           undo _main, return error ''.
     1750         end.
     1751         if v-retry-action < 1 then do:
     1752               ImpData1:Route-data_dump ( ) .
     1753         end.
     1754         end.
     1755       _rule:
     1756       do
     1757       on error undo _rule, retry _rule
     1758       :
     1759           if retry then do:
     1760                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка разбора/приема данных по валютам и курсам из ВС:&1&2&1&3", chr(10), return-value, error-status :get-message( 1 ) )).                      assign v-view-log = yes.
     1761           run set-err-type in p-cont-handle
     1762             ( input v-err-type
     1763             ) no-error.
     1764           run delete-procedure in this-procedure .
     1765           if valid-handle(v_qh) then do:
     1766             delete object v_qh no-error.
     1767           end.
     1768           if valid-handle(v_child-qh) then do:
     1769             delete object v_child-qh no-error.
     1770           end.
     1771             undo _main, return error ''.
     1772           end.
     1773           else do:
     1774           v_qh:get-next().
     1775           if v_qh:query-off-end then do:
     1776             leave _stroka.
     1777           end.
     1778           IF ImpData1:current-tbl-name( ) = 'currency':U  THEN do:
     1779             trans_save_currency:
     1780             do transaction
     1781             on error  undo _rule, retry _rule
     1782             on stop   undo _rule, retry _rule
     1783             on endkey undo _rule, retry _rule
     1784             :
     1785               assign
     1786                 v-line-num  = ImpData1:route-data_get-field-integer  ( input 'currency':U, input "line-num":U )
     1787               .
     1788               run get-xcnf_check-imp-rec in p-cont-handle
     1789                 ( input "create"
     1790                 , input p-esys-id
     1791                 , input 0
     1792                 , input g#db-num
     1793                 , input v-pck-num
     1794                 , input substitute( "&1&2", v-line-num, 'currency':U )
     1795                 , output v-present
     1796                 ) no-error.
     1797               if error-status:error then do:
     1798                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка идентификации принимаемых данных по валютам и курсам из ВС:" )).                      assign v-view-log = yes.
     1799                 undo _rule, retry _rule.
     1800               end.
     1801               if v-present = true then do:
     1802                 leave trans_save_currency .
     1803               end.
     1804               run proc-save-currency in this-procedure
     1805                 ( input ImpData1:route-data_get-field-integer  ( input 'currency':U, input "curr-code":U)
     1806                 , input ImpData1:route-data_get-field-character( input 'currency':U, input "curr-abbr":U)
     1807                 , input "":U
     1808                 , input ImpData1:route-data_get-field-character( input 'currency':U, input "curr-name":U)
     1809                 , input "":U
     1810                 , input "":U
     1811                 , input "":U
     1812                 , input "":U
     1813                 , input "":U
     1814                 , input "":U
     1815                 , input "":U
     1816                 , input "":U
     1817                 , input "":U
     1818                 , input "":U
     1819                 , input "":U
     1820                 , input ImpData1:route-data_get-field-integer  ( input 'currency':U, input "okv-code":U)
     1821                 ) no-error .
     1822               if error-status:error then do:
     1823                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по валютам при приеме данных из ВС:" )).                      assign v-view-log = yes.
     1824                 undo _rule, retry _rule.
     1825               end.
     1826               else do:
     1827                 assign
     1828                   num-rec-ok2 = num-rec-ok2 + 1
     1829                 .
     1830               end.
     1831             end.
     1832           end.
     1833           IF ImpData1:current-tbl-name( ) = 'curr-accnt':U  THEN do:
     1834             trans_save_curr-accnt:
     1835             do transaction
     1836             on error  undo _rule, retry _rule
     1837             on stop   undo _rule, retry _rule
     1838             on endkey undo _rule, retry _rule
     1839             :
     1840               assign
     1841                 v-line-num   = ImpData1:route-data_get-field-integer  ( input 'curr-accnt':U, input "line-num":U )
     1842               .
     1843               run get-xcnf_check-imp-rec in p-cont-handle
     1844                 ( input "create"
     1845                 , input p-esys-id
     1846                 , input 0
     1847                 , input g#db-num
     1848                 , input v-pck-num
     1849                 , input substitute( "&1&2", v-line-num, 'curr-accnt':U )
     1850                 , output v-present
     1851                 ) no-error.
     1852               if error-status:error then do:
     1853                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка идентификации принимаемых данных по валютам и курсам из ВС:" )).                      assign v-view-log = yes.
     1854                 undo _rule, retry _rule.
     1855               end.
     1856               if v-present = true then do:
     1857                 leave trans_save_curr-accnt .
     1858               end.
     1859               run proc-save-curr-accnt in this-procedure
     1860                 ( input ImpData1:route-data_get-field-integer  ( input 'curr-accnt':U, input "curr-code":U )
     1861                 , input ImpData1:route-data_get-field-date     ( input 'curr-accnt':U, input "exch-date":U )
     1862                 , input ImpData1:route-data_get-field-decimal  ( input 'curr-accnt':U, input "exch-rate":U)
     1863                 , input ImpData1:route-data_get-field-integer  ( input 'curr-accnt':U, input "exch-scale":U)
     1864                 , input ImpData1:route-data_get-field-character( input 'curr-accnt':U, input "status_":U )
     1865                 ) no-error .
     1866               if error-status:error then do:
     1867                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при сохранении данных по курсам валют при приеме данных из ВС:" )).                      assign v-view-log = yes.
     1868                 undo _rule, retry _rule.
     1869               end.
     1870               else do:
     1871                 assign
     1872                   num-rec-ok2 = num-rec-ok2 + 1
     1873                 .
     1874               end.
     1875             end.
     1876           end.
     1877         end.
     1878       end.
     1879       v-retry-action = 0 .
     1880       _release:
     1881       do
     1882       on error undo _release, retry _release
     1883       :
     1884         if  retry then do:
     1885           v-retry-action = v-retry-action + 1.
     1886                   run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                       , buf_temp-xml-tables.tbl-name                                       , num-rec                                       , chr(10)                                       , error-status:get-message(1)                                       , return-value)).                      assign v-view-log = yes.
     1887           run delete-procedure in this-procedure .
     1888           if valid-handle(v_qh) then do:
     1889             delete object v_qh no-error.
     1890           end.
     1891           undo _main, return error ''.
     1892         end.
     1893         if v-retry-action < 1 then do:
     1894               ImpData1:Route-data_dump ( ) .
     1895         end.
     1896       end.
     1897       if v-retry-action = 0 then do:
     1898         num-rec-ok = num-rec-ok + 1.
     1899       end.
     1900       run write-counter in p-log-handle ( input substitute("Прочитано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     1901     end.
     1902     if not v-stop
     1903     and buf_temp-xml-tables.is-parent
     1904     then do:
     1905       num-rec = num-rec - 1.
     1906     end.
     1907     v_qh:query-close().
     1908     if valid-handle(v_qh) then do:
     1909       delete object v_qh.
     1910     end.
     1911   end.
     1912   run write-log-and-file in p-log-handle
     1913     ( input 1
     1914     , input log-file-name
     1915     , input 1
     1916     , input substitute("Прочитано записей: &1, из них удачно обработано: &2", num-rec, num-rec-ok2)
     1917     ).
     1918   end.
     1919   end procedure.
     1920   procedure load-ruleset-context :
     1921   define input parameter p-ruleset-id as integer no-undo .
     1922   define buffer buf_rule-call-param for ub.rule-call-param.
     1923   define variable v-itop as integer   no-undo .
     1924   define variable v-ichild as integer   no-undo .
     1925   define buffer buf_ext-system for ub.ext-system.
     1926     do
     1927     on error undo, return error
     1928     :
     1929    find first buf_rule-call-param no-lock where
     1930   buf_rule-call-param.codex_id = p-codex-id
     1931   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1932   and buf_rule-call-param.call_id = p-call-id
     1933   and buf_rule-call-param.order_id = p-order-id
     1934   and buf_rule-call-param.rule_id = p-rule-id
     1935   and buf_rule-call-param.param-name = "p-xsd-file"
     1936    no-error.
     1937   if available buf_rule-call-param then do:
     1938   assign p-xsd-file = buf_rule-call-param.param-value-character.
     1939   end.
     1940    find first buf_rule-call-param no-lock where
     1941   buf_rule-call-param.codex_id = p-codex-id
     1942   and buf_rule-call-param.ruleset_id = p-ruleset-id
     1943   and buf_rule-call-param.call_id = p-call-id
     1944   and buf_rule-call-param.order_id = p-order-id
     1945   and buf_rule-call-param.rule_id = p-rule-id
     1946   and buf_rule-call-param.param-name = "p-esys-id"
     1947    no-error.
     1948   if available buf_rule-call-param then do:
     1949   assign p-esys-id = buf_rule-call-param.param-value-integer.
     1950   end.
     1951       case p-ruleset-id:
     1952         when 4 then do:
     1953           assign
     1954           v-sign = 1
     1955           v-current-host-code = p-host-code
     1956           v-current-obj-type = p-obj-type
     1957           v-current-obj-code = p-obj-code
     1958           v-current-doc-code = p-doc-code
     1959           v-current-db-num = g#db-num
     1960           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     1961           file-name  = entry(1, p-process-file-name, chr(4))
     1962           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     1963           v-xmlh = buffer buf_temp-xml-tables:handle
     1964           v-esys-id = integer(p-doc-code)
     1965           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     1966           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     1967           log-file-name = entry(4, p-process-file-name, chr(4))
     1968           no-error
     1969           .
     1970           if error-status:error then do:
     1971                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).                      assign v-view-log = yes.
     1972             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     1973           end.
     1974           find first buf_ext-system no-lock where
     1975                     buf_ext-system.esys-id = v-esys-id
     1976                 and buf_ext-system.db-num = 0 no-error .
     1977           if not available buf_ext-system then do:
     1978                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         )).                      assign v-view-log = yes.
     1979             undo, return error substitute("Не найдена ВС &1&2пропускаем ..."                                         , v-esys-id                                         , chr(10)                                         ).
     1980           end.
     1981           if v-extension = ''
     1982           or lookup(v-extension, "dat") = 0 then do:
     1983                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).                      assign v-view-log = yes.
     1984             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2пропускаем ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     1985           end.
     1986           _top-buffers:
     1987           do v-itop = 1 to v_dataseth:num-top-buffers:
     1988             if v_dataseth:get-top-buffer(v-itop):table = "header_" then do:
     1989               next _top-buffers.
     1990             end.
     1991             assign
     1992             v-ds-read-order = v-ds-read-order +
     1993                               (if v-ds-read-order = '':U then '':U else chr(44)) +
     1994                               v_dataseth:get-top-buffer(v-itop):table
     1995                               .
     1996             do v-ichild = 1 to v_dataseth:get-top-buffer(v-itop):num-child-relations:
     1997               assign
     1998               v-ds-read-order = v-ds-read-order + chr(44) + v_dataseth:get-top-buffer(v-itop):get-child-relation(v-ichild):child-buffer:name.
     1999             end.
     2000           end.
     2001         end.
     2002         otherwise do:
     2003           undo, return error "Неправильный вызов".
     2004         end.
     2005       end case.
     2006     end.
     2007   end procedure.
     2008   procedure delete-procedure :
     2009     do
     2010     on error  undo, return error substitute( "&1 (delete-procedure). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2011     on stop   undo, return error substitute( "&1 (delete-procedure). stop", vss-workfile )
     2012     on endkey undo, return error substitute( "&1 (delete-procedure). endkey", vss-workfile )
     2013     :
     2014         run clear_tt in this-procedure .
     2015         run garbcoll_clear in this-procedure .
     2016     end.
     2017   end procedure.
     2018   procedure proc-save-currency :
     2019     define input  parameter p-curr-code           like ub.currency.curr-code           no-undo .
     2020     define input  parameter p-curr-abbr           like ub.currency.curr-abbr           no-undo .
     2021     define input  parameter p-part-abbr           like ub.currency.part-abbr           no-undo .
     2022     define input  parameter p-curr-name           like ub.currency.curr-name           no-undo .
     2023     define input  parameter p-curr-name-one       like ub.currency.curr-name-one       no-undo .
     2024     define input  parameter p-curr-name-three     like ub.currency.curr-name-three     no-undo .
     2025     define input  parameter p-curr-name-five      like ub.currency.curr-name-five      no-undo .
     2026     define input  parameter p-curr-eng-name       like ub.currency.curr-eng-name       no-undo .
     2027     define input  parameter p-curr-eng-name-one   like ub.currency.curr-eng-name-one   no-undo .
     2028     define input  parameter p-curr-eng-name-three like ub.currency.curr-eng-name-three no-undo .
     2029     define input  parameter p-curr-eng-name-five  like ub.currency.curr-eng-name-five  no-undo .
     2030     define input  parameter p-part-name           like ub.currency.part-name           no-undo .
     2031     define input  parameter p-part-name-one       like ub.currency.part-name-one       no-undo .
     2032     define input  parameter p-part-name-three     like ub.currency.part-name-three     no-undo .
     2033     define input  parameter p-part-name-five      like ub.currency.part-name-five      no-undo .
     2034     define input  parameter p-okv-code            like ub.currency.okv-code            no-undo .
     2035     do
     2036     on error  undo, return error substitute( "&1 (proc-save-currency). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2037     on stop   undo, return error substitute( "&1 (proc-save-currency). stop", vss-workfile )
     2038     on endkey undo, return error substitute( "&1 (proc-save-currency). endkey", vss-workfile )
     2039     :
     2040       define buffer buf_currency for ub.currency .
     2041       define variable v-rid  as recid     no-undo .
     2042       define variable v-stts as character no-undo .
     2043       find first buf_currency exclusive-lock
     2044         where buf_currency.curr-code = p-curr-code
     2045         no-error .
     2046       if available buf_currency then do:
     2047         assign
     2048           v-rid  = recid( buf_currency )
     2049           v-stts = 'U'
     2050         .
     2051       end.
     2052       else do:
     2053         assign
     2054           v-rid  = ?
     2055           v-stts = 'N'
     2056         .
     2057       end.
     2058       run ref/currenc1.p
     2059         ( input-output v-rid
     2060         , input ( if v-stts = 'N' then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U )
     2061         , input true
     2062         , input p-curr-code
     2063         , input p-curr-abbr
     2064         , input p-part-abbr
     2065         , input p-curr-name
     2066         , input p-curr-name-one
     2067         , input p-curr-name-three
     2068         , input p-curr-name-five
     2069         , input p-curr-eng-name
     2070         , input p-curr-eng-name-one
     2071         , input p-curr-eng-name-three
     2072         , input p-curr-eng-name-five
     2073         , input p-part-name
     2074         , input p-part-name-one
     2075         , input p-part-name-three
     2076         , input p-part-name-five
     2077         , input p-okv-code
     2078         ) no-error .
     2079       if error-status:error then do:
     2080         undo, return error substitute( "&1 (proc-save-currency). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)) .
     2081       end.
     2082     end.
     2083   end procedure.
     2084   procedure proc-save-curr-accnt :
     2085     define input  parameter p-curr-code  like ub.curr-accnt.curr-code   no-undo .
     2086     define input  parameter p-exch-date  like ub.curr-accnt.exch-date   no-undo .
     2087     define input  parameter p-exch-rate  like ub.curr-accnt.exch-rate   no-undo .
     2088     define input  parameter p-exch-scale like ub.curr-accnt.exch-scale  no-undo .
     2089     define input  parameter p-status     as   character                 no-undo .
     2090     do transaction
     2091     on error  undo, return error substitute( "&1 (proc-save-curr-accnt). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2092     on stop   undo, return error substitute( "&1 (proc-save-curr-accnt). stop", vss-workfile )
     2093     on endkey undo, return error substitute( "&1 (proc-save-curr-accnt). endkey", vss-workfile )
     2094     :
     2095       define buffer buf_currency   for ub.currency .
     2096       define buffer buf_curr-accnt for ub.curr-accnt .
     2097       define buffer buf_curr-bank  for ub.curr-bank .
     2098       define variable v-rid   as recid     no-undo .
     2099       define variable v-today as date      no-undo .
     2100       define variable v-time  as integer   no-undo .
     2101       define variable v-stts  as character no-undo .
     2102       find first buf_currency exclusive-lock
     2103         where buf_currency.curr-code = p-curr-code
     2104         no-error .
     2105       if not available buf_currency then do:
     2106         undo, return error substitute( "&1 (proc-save-currency) Отсутствует валюта с кодом &2 .", vss-workfile, p-curr-code ) .
     2107       end.
     2108       run cur-time in this-procedure
     2109         ( output v-today
     2110         , output v-time
     2111         ).
     2112       if p-status = 'D'
     2113         and p-exch-date < v-today
     2114       then do:
     2115         undo, return error substitute( "&1 (proc-save-currency) Запрещено удалять курс с датой меньше текущей.&2Запрошено удаление курса валюты &3 на &4"
     2116                                        , vss-workfile
     2117                                        , chr(10)
     2118                                        , buf_currency.curr-abbr
     2119                                        , p-exch-date
     2120                                       ) .
     2121       end.
     2122       find first buf_curr-accnt exclusive-lock
     2123         where buf_curr-accnt.curr-code = p-curr-code
     2124           and buf_curr-accnt.exch-date = p-exch-date
     2125         no-error .
     2126       if available buf_curr-accnt then do:
     2127         assign
     2128           v-rid  = recid( buf_curr-accnt )
     2129           v-stts = 'ИЗМЕНЕНИЕ':U
     2130         .
     2131       end.
     2132       else do:
     2133         assign
     2134           v-rid  = ?
     2135           v-stts = 'ДОБАВЛЕНИЕ':U
     2136         .
     2137       end.
     2138       if p-status = 'D' then do:
     2139         if available buf_curr-accnt then do:
     2140           disable triggers for load of ub.curr-accnt .
     2141           delete buf_curr-accnt .
     2142         end.
     2143         else do:
     2144           undo, return error substitute( "&1 (proc-save-currency) Отсутствует курс ММВБ для валюты &2 на &3.", vss-workfile, buf_currency.curr-abbr, string( p-exch-date, "99/99/9999" ) ) .
     2145         end.
     2146       end.
     2147       else do:
     2148         run ref/curracc1.p
     2149           ( input-output v-rid
     2150           , input v-stts
     2151           , input true
     2152           , input p-curr-code
     2153           , input p-exch-date
     2154           , input p-exch-rate
     2155           , input p-exch-scale
     2156           ) .
     2157       end.
     2158       find first buf_curr-bank exclusive-lock
     2159         where buf_curr-bank.curr-code = p-curr-code
     2160           and buf_curr-bank.exch-date = p-exch-date
     2161         no-error .
     2162       if available buf_curr-bank then do:
     2163         assign
     2164           v-rid  = recid( buf_curr-bank )
     2165           v-stts = 'ИЗМЕНЕНИЕ':U
     2166         .
     2167       end.
     2168       else do:
     2169         assign
     2170           v-rid  = ?
     2171           v-stts = 'ДОБАВЛЕНИЕ':U
     2172         .
     2173       end.
     2174       if p-status = 'D' then do:
     2175         if available buf_curr-bank then do:
     2176           disable triggers for load of ub.curr-bank .
     2177           delete buf_curr-bank .
     2178         end.
     2179         else do:
     2180           undo, return error substitute( "&1 (proc-save-currency) Отсутствует курс ЦБ для валюты &2 на &3.", vss-workfile, buf_currency.curr-abbr, string( p-exch-date, "99/99/9999" ) ) .
     2181         end.
     2182       end.
     2183       else do:
     2184         run ref/currbnk1.p
     2185           ( input-output v-rid
     2186           , input v-stts
     2187           , input true
     2188           , input p-curr-code
     2189           , input p-exch-date
     2190           , input p-exch-rate
     2191           , input p-exch-scale
     2192           ) .
     2193       end.
     2194     end.
     2195   end procedure.
