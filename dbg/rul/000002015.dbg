     1077   uniq-gate-rec
     1078   tbl-name
     1079   index iorder
     1080   order
     1081   index gr
     1082   uniq-gate-rec
     1083   index gh
     1084   gate-handle_
     1085   index iparent
     1086   is-parent
     1087   .
     1088   define shared temp-table temp-xml-records no-undo
     1089   field tbl-name as character
     1090   field uniq-key-rec as character
