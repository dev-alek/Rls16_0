     2636   field THrcvdtime  as character
     2637   index pi is unique primary
     2638   THesys-id
     2639   THpack-num
     2640   index rcvd
     2641   THesys-id
     2642   THrcvd
     2643   .
     2644   procedure get-header-by-rec :
     2645   define input  parameter p-gate-rec as character no-undo .
     2646   define output parameter p-tth as handle no-undo .
     2647   define variable v-ii as integer   no-undo .
     2648   define variable glog as logical   no-undo .
     2649   define variable v-rowid as rowid no-undo .
     2650   define variable v-tbl-name as character no-undo .
     2651   define variable v-longchar as longchar no-undo .
     2652   define variable v-txmlh as handle no-undo .
     2653   define buffer buf_clob-data for ub.clob-data.
     2654   main-block:
     2655   do
     2656   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info8, return-value, chr(10), error-status :get-message (1))
     2657   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info8 )
     2658   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info8 )
     2659   :
     2660     run gen-row-keyr in  this-procedure  (
     2661                                           input  p-gate-rec
     2662                                           ,input  ?
     2663                                           ,input  "ub"
     2664                                           ,input  ?
     2665                                           ,input  NO-LOCK
     2666                                           ,output v-rowid
     2667                                           ,output v-tbl-name   ) no-error.
     2668       find first buf_clob-data no-lock where
     2669                 rowid(buf_clob-data) = v-rowid  no-error.
     2670       if not available buf_clob-data then do:
     2671         undo, return error substitute("Не найден CLOB  &1"
     2672                                         , p-gate-rec
     2673                                         ).
     2674       end.
     2675       assign
     2676       v-longchar = buf_clob-data.cdata
     2677       .
     2678       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2679       if error-status :error then do:
     2680         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2681       end.
     2682       create temp-table p-tth .
     2683       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2684                                     , v-longchar
     2685                                     , ?
     2686                                     , ?
     2687                                     , ?
     2688                                     ) no-error.
     2689       v-longchar = '':U.
     2690       define variable v-esm as character no-undo .
     2691       v-esm = error-status:get-message(1).
     2692       if error-status :error
     2693       or not glog
     2694       then do:
     2695         delete object p-tth no-error.
     2696         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2697                                    , p-gate-rec
     2698                                    , buf_clob-data.file-name_
     2699                                    , chr(10)
     2700                                    , v-esm
     2701                                     ).
     2702       end.
     2703   end.
     2704   end procedure.
     2705   procedure getoxmlh :
     2706   define input parameter p-xml-file-name as character no-undo .
     2707   define input parameter p-pack-data     as memptr no-undo .
     2708   define input parameter p-headerh as handle no-undo .
     2709   define input parameter p-delivery-method as integer no-undo .
     2710   define variable v-parse-status as integer no-undo .
     2711   define buffer buf_rec for temp_xmllib_rec.
     2712   define buffer buf_rec-fld for temp_xmllib_rec-fld.
     2713   define variable v-end-of-header as logical   no-undo .
     2714   define variable v-ii as integer   no-undo .
     2715   define variable v-root-name as character no-undo .
     2716   define buffer buf_temp_xmllib_rec for temp_xmllib_rec.
     2717   do
     2718   on error undo, return error return-value
     2719   :
     2720     run xmllib-clear-parse-data in this-procedure.
     2721     if valid-handle(p-headerh) then do:
     2722     do v-ii = 1 to p-headerh:num-fields:
     2723       run xmllib-add-rec-fld  in this-procedure (
     2724                                                    input p-headerh:table
     2725                                                   ,input (p-headerh:buffer-field(v-ii):name)
     2726                                                 )  .
     2727     end.
     2728     end.
     2729     case p-delivery-method:
     2730       when integer('3':U) then do:
     2731         v-root-name = "Oracle_Retail".
     2732         run xmllib-add-rec-fld  in this-procedure (
     2733                                                       input v-root-name
     2734                                                     ,input ""
     2735                                                   )  .
     2736       end.
     2737       when integer('5':U) then do:
     2738         run xmllib-add-rec-fld  in this-procedure (
     2739                                                       input "ORDER_"
     2740                                                     ,input ""
     2741                                                   )  .
     2742         run xmllib-add-rec-fld  in this-procedure (
     2743                                                       input "STATUS__"
     2744                                                     ,input ""
     2745                                                   )  .
     2746         run xmllib-add-rec-fld  in this-procedure (
     2747                                                       input "ORDRSP_"
     2748                                                     ,input ""
     2749                                                   )  .
     2750         run xmllib-add-rec-fld  in this-procedure (
     2751                                                       input "DESADV_"
     2752                                                     ,input ""
     2753                                                   )  .
     2754         run xmllib-add-rec-fld  in this-procedure (
     2755                                                       input "RECADV_"
     2756                                                     ,input ""
     2757                                                   )  .
     2758       end.
     2759       when integer('9':U) then do:
     2760               run xmllib-add-rec-fld  in this-procedure (
     2761                                                       input "statusReport"
     2762                                                     ,input ""
     2763                                                   )  .
     2764       end.
     2765       when integer('11':U) then do:
     2766         v-root-name = "".
     2767         run xmllib-add-rec-fld  in this-procedure (
     2768                                                       input "ERPRN-GC"
     2769                                                     ,input ""
     2770                                                   )  .
     2771       end.
     2772       otherwise do:
     2773         v-root-name = "".
     2774         run xmllib-add-rec-fld  in this-procedure (
     2775                                                   input v-root-name
     2776                                                  ,input ""
     2777                                               )  .
     2778       end.
     2779     end case.
     2780     run xmllib-parse-progressive ( input p-xml-file-name
     2781                                   ,input p-pack-data
     2782                                   ,input yes
     2783                                   ,input no
     2784                                   ,output v-parse-status) no-error .
     2785     repeat while not (error-status:error
     2786                       or
     2787                       v-parse-status = sax-complete
     2788                       or available buf_temp_xmllib_rec
     2789                       ):
     2790       if valid-handle(p-headerh)  then do:
     2791       find first buf_temp_xmllib_rec where
     2792                 buf_temp_xmllib_rec.recname = p-headerh:table
     2793             and buf_temp_xmllib_rec.closed = yes no-error.
     2794       end.
     2795       else do:
     2796         find first buf_temp_xmllib_rec no-error.
     2797       end.
     2798       error-status:error = no .
     2799       run xmllib-parse-progressive ( input p-xml-file-name
     2800                                     ,input p-pack-data
     2801                                     ,input no
     2802                                     ,input no
     2803                                     ,output v-parse-status) no-error .
     2804     end.
     2805   end.
     2806   end procedure.
     2807   define variable vss-include-info9 as character format "X(65)" no-undo
     2808   initial "@(#)$Workfile$ $Revision$".
     2809   procedure xmlchar-test :
     2810   define input parameter p-in-string          as character        no-undo.
     2811   define output parameter p-out-string-enc    as character        no-undo.
     2812   define output parameter p-out-string-dec    as character        no-undo.
     2813   do
     2814   on error undo, return error
     2815   :
     2816          run xmlchar-encode in this-procedure
     2817       (
     2818             input p-in-string
     2819           , output p-out-string-enc
     2820       ).
     2821          run xmlchar-decode in this-procedure
     2822       (
     2823             input p-out-string-enc
     2824           , output p-out-string-dec
     2825       ).
     2826   end.
     2827   end .
     2828   procedure xmlchar-encode :
     2829   define input parameter p-in-string      as character        no-undo.
     2830   define output parameter p-out-string    as character        no-undo.
     2831       define variable v-position      as integer      no-undo.
     2832       define variable v-current-char  as character    no-undo.
     2833   do
     2834   on error undo, return error
     2835   :
     2836       assign
     2837           p-out-string = "":U
     2838       .
     2839       case p-in-string
     2840       :
     2841           when ?
     2842           then do:
     2843               assign
     2844                   p-out-string = "?":U
     2845               .
     2846           end.
     2847           when "?":U
     2848           then do:
     2849               assign
     2850                   p-out-string = "&#63;":U
     2851               .
     2852           end.
     2853           otherwise do:
     2854               do v-position = 1 to length( p-in-string )
     2855               :
     2856                   assign
     2857                       v-current-char = substring( p-in-string, v-position, 1 )
     2858                   .
     2859                   case v-current-char
     2860                   :
     2861                       when "&":U
     2862                       then do:
     2863                           assign
     2864                               p-out-string = p-out-string + "&amp;":U
     2865                           .
     2866                       end.
     2867                       when ">":U
     2868                       then do:
     2869                           assign
     2870                               p-out-string = p-out-string + "&gt;":U
     2871                           .
     2872                       end.
     2873                       when "<":U
     2874                       then do:
     2875                           assign
     2876                               p-out-string = p-out-string + "&lt;":U
     2877                           .
     2878                       end.
     2879                       when "'":U
     2880                       then do:
     2881                           assign
     2882                               p-out-string = p-out-string + "&apos;":U
     2883                           .
     2884                       end.
     2885                       when '"':U
     2886                       then do:
     2887                           assign
     2888                               p-out-string = p-out-string + "&quot;":U
     2889                           .
     2890                       end.
     2891                       when chr(1)
     2892                       then do:
     2893                           assign
     2894                               p-out-string = p-out-string + "":U
     2895                           .
     2896                       end.
     2897                       when chr(2)
     2898                       then do:
     2899                           assign
     2900                               p-out-string = p-out-string + "":U
     2901                           .
     2902                       end.
     2903                       when chr(3)
     2904                       then do:
     2905                           assign
     2906                               p-out-string = p-out-string + "":U
     2907                           .
     2908                       end.
     2909                       when chr(4)
     2910                       then do:
     2911                           assign
     2912                               p-out-string = p-out-string + "":U
     2913                           .
     2914                       end.
     2915                       when chr(5)
     2916                       then do:
     2917                           assign
     2918                               p-out-string = p-out-string + "":U
     2919                           .
     2920                       end.
     2921                       when chr(6)
     2922                       then do:
     2923                           assign
     2924                               p-out-string = p-out-string + "":U
     2925                           .
     2926                       end.
     2927                       when chr(7)
     2928                       then do:
     2929                           assign
     2930                               p-out-string = p-out-string + "":U
     2931                           .
     2932                       end.
     2933                       when chr(8)
     2934                       then do:
     2935                           assign
     2936                               p-out-string = p-out-string + "":U
     2937                           .
     2938                       end.
     2939                       when chr(9)
     2940                       then do:
     2941                           assign
     2942                               p-out-string = p-out-string + "":U
     2943                           .
     2944                       end.
     2945                       when chr(29)
     2946                       then do:
     2947                           assign
     2948                               p-out-string = p-out-string + "":U
     2949                           .
     2950                       end.
     2951                       when chr(10)
     2952                       then do:
     2953                           assign
     2954                               p-out-string = p-out-string + "&#10;":U
     2955                           .
     2956                       end.
     2957                       when chr(13)
     2958                       then do:
     2959                           assign
     2960                               p-out-string = p-out-string + "&#13;":U
     2961                           .
     2962                       end.
     2963                       otherwise do:
     2964                           assign
     2965                               p-out-string = p-out-string + v-current-char
     2966                           .
     2967                       end.
     2968                   end case.
     2969               end.
     2970           end.
     2971       end case.
     2972   end.
     2973   end .
     2974   procedure xmlchar-encode-1c :
     2975   define input parameter p-in-string      as character        no-undo.
     2976   define output parameter p-out-string    as character        no-undo.
     2977       define variable v-position      as integer      no-undo.
     2978       define variable v-current-char  as character    no-undo.
     2979   do
     2980   on error undo, return error
     2981   :
     2982       assign
     2983           p-out-string = "":U
     2984       .
     2985       case p-in-string
     2986       :
     2987           when ?
     2988           then do:
     2989               assign
     2990                   p-out-string = "?":U
     2991               .
     2992           end.
     2993           otherwise do:
     2994               do v-position = 1 to length( p-in-string )
     2995               :
     2996                   assign
     2997                       v-current-char = substring( p-in-string, v-position, 1 )
     2998                   .
     2999                   case v-current-char
     3000                   :
     3001                       when chr(1)
     3002                       then do:
     3003                           assign
     3004                               p-out-string = p-out-string + " ":U
     3005                           .
     3006                       end.
     3007                       when chr(2)
     3008                       then do:
     3009                           assign
     3010                               p-out-string = p-out-string + " ":U
     3011                           .
     3012                       end.
     3013                       when chr(3)
     3014                       then do:
     3015                           assign
     3016                               p-out-string = p-out-string + " ":U
     3017                           .
     3018                       end.
     3019                       when chr(4)
     3020                       then do:
     3021                           assign
     3022                               p-out-string = p-out-string + " ":U
     3023                           .
     3024                       end.
     3025                       when chr(5)
     3026                       then do:
     3027                           assign
     3028                               p-out-string = p-out-string + " ":U
     3029                           .
     3030                       end.
     3031                       when chr(6)
     3032                       then do:
     3033                           assign
     3034                               p-out-string = p-out-string + " ":U
     3035                           .
     3036                       end.
     3037                       when chr(7)
     3038                       then do:
     3039                           assign
     3040                               p-out-string = p-out-string + " ":U
     3041                           .
     3042                       end.
     3043                       when chr(8)
     3044                       then do:
     3045                           assign
     3046                               p-out-string = p-out-string + " ":U
     3047                           .
     3048                       end.
     3049                       when chr(9)
     3050                       then do:
     3051                           assign
     3052                               p-out-string = p-out-string + " ":U
     3053                           .
     3054                       end.
     3055                       when chr(29)
     3056                       then do:
     3057                           assign
     3058                               p-out-string = p-out-string + " ":U
     3059                           .
     3060                       end.
     3061                       when chr(10)
     3062                       then do:
     3063                           assign
     3064                               p-out-string = p-out-string + " ":U
     3065                           .
     3066                       end.
     3067                       when chr(13)
     3068                       then do:
     3069                           assign
     3070                               p-out-string = p-out-string + " ":U
     3071                           .
     3072                       end.
     3073                       otherwise do:
     3074                           assign
     3075                               p-out-string = p-out-string + v-current-char
     3076                           .
     3077                       end.
     3078                   end case.
     3079               end.
     3080           end.
     3081       end case.
     3082   end.
     3083   end .
     3084   procedure xmlchar-decode :
     3085   define input parameter p-in-string      as character        no-undo.
     3086   define output parameter p-out-string    as character        no-undo.
     3087       define variable v-position      as integer      no-undo.
     3088       define variable v-last-position as integer      no-undo.
     3089       define variable v-temp-integer  as integer      no-undo.
     3090       define variable v-current-char  as character    no-undo.
     3091       define variable v-next-char     as character    no-undo.
     3092       define variable v-success       as logical      no-undo.
     3093   do
     3094   on error undo, return error
     3095   :
     3096       assign
     3097           p-out-string = "":U
     3098           v-position   = 0
     3099       .
     3100       replace-cycle:
     3101       do while yes
     3102       on error undo, return error
     3103       :
     3104           assign
     3105               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3106           .
     3107           if v-last-position <= v-position
     3108           then do:
     3109               if v-position = 0
     3110               then do:
     3111                   assign
     3112                       p-out-string = p-in-string
     3113                   .
     3114               end.
     3115               else do:
     3116                   assign
     3117                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3118                   .
     3119               end.
     3120               leave replace-cycle.
     3121           end.
     3122           else do:
     3123               assign
     3124                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3125                   v-position      = v-last-position
     3126                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3127               .
     3128               if v-current-char = "#":U
     3129               then do:
     3130                   assign
     3131                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3132                   .
     3133                   if v-last-position > 0
     3134                   then do:
     3135                       run xmlchar-read-integer in this-procedure
     3136                        (
     3137                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3138                           , output v-temp-integer
     3139                           , output v-success
     3140                       ).
     3141                       if v-success = yes
     3142                       and v-temp-integer >= 1
     3143                       and v-temp-integer <= 255
     3144                       then do:
     3145                           assign
     3146                               p-out-string = p-out-string + chr( v-temp-integer )
     3147                               v-position   = v-last-position + 1
     3148                           .
     3149                       end.
     3150                       else do:
     3151                           assign
     3152                               p-out-string = p-out-string + "&":U
     3153                               v-position   = v-position   + 1
     3154                           .
     3155                       end.
     3156                   end.
     3157                   else do:
     3158                       assign
     3159                           p-out-string = p-out-string + "&":U
     3160                           v-position   = v-position   + 1
     3161                       .
     3162                   end.
     3163               end.
     3164               else do:
     3165                   case substring( p-in-string, v-position + 1, 3 )
     3166                   :
     3167                       when "lt;":U
     3168                       then do:
     3169                           assign
     3170                               p-out-string = p-out-string + "<":U
     3171                               v-position   = v-position   + 3
     3172                           .
     3173                       end.
     3174                       when "gt;":U
     3175                       then do:
     3176                           assign
     3177                               p-out-string = p-out-string + ">":U
     3178                               v-position   = v-position   + 3
     3179                           .
     3180                       end.
     3181                       otherwise do:
     3182                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3183                           then do:
     3184                               assign
     3185                                   p-out-string = p-out-string + "&":U
     3186                                   v-position   = v-position   + 4
     3187                               .
     3188                           end.
     3189                           else do:
     3190                               case substring( p-in-string, v-position + 1, 5 )
     3191                               :
     3192                                   when "quot;":U
     3193                                   then do:
     3194                                       assign
     3195                                           p-out-string = p-out-string + '"':U
     3196                                           v-position   = v-position   + 5
     3197                                       .
     3198                                   end.
     3199                                   when "apos;":U
     3200                                   then do:
     3201                                       assign
     3202                                           p-out-string = p-out-string + "'":U
     3203                                           v-position   = v-position   + 5
     3204                                       .
     3205                                   end.
     3206                                   otherwise do:
     3207                                       assign
     3208                                           p-out-string = p-out-string + "&":U
     3209                                       .
     3210                                   end.
     3211                               end case.
     3212                           end.
     3213                       end.
     3214                   end case.
     3215               end.
     3216           end.
     3217       end.
     3218   end.
     3219   end .
     3220   procedure xmlchar-read-integer :
     3221   define input parameter p-input-string      as character        no-undo.
     3222   define output parameter p-output-integer   as integer          no-undo.
     3223   define output parameter p-success       as logical          no-undo.
     3224   do
     3225   on error undo, return error
     3226   :
     3227       assign
     3228           p-output-integer = integer( p-input-string )
     3229       no-error.
     3230       if error-status :error
     3231       then do:
     3232           assign
     3233               p-success           = no
     3234               p-output-integer    = 0
     3235           .
     3236       end.
     3237       else do:
     3238           assign
     3239               p-success           = yes
     3240           .
     3241       end.
     3242   end.
     3243   end.
     3244   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3245   define temp-table temp-rel-handle no-undo
     3246   field dh as handle
     3247   field ii as integer
     3248   field active_ as logical
     3249   field child-buffer_ as character
     3250   field parent-buffer_ as character
     3251   field child-buffer-handle as handle
     3252   field parent-buffer-handle as handle
     3253   field name_ as character
     3254   field nested_ as logical
     3255   field relation-fields_ as character
     3256   field reposition_ as logical
     3257   field type_ as character
     3258   field query_ as handle
     3259   field where-string_ as character
     3260   field tbl-handle_ as handle
     3261   index pi is unique primary
     3262   ii
     3263   index iparentname parent-buffer_ child-buffer_
     3264   index iparenthandle parent-buffer-handle child-buffer-handle
     3265   .
     3266   procedure tmpreldf_get-relations :
     3267   define input parameter p-dataseth as handle no-undo .
     3268   define variable v-ii as integer no-undo .
     3269   define buffer buf_temp-rel-handle for temp-rel-handle.
     3270   do
     3271   on error undo, return error
     3272   :
     3273     if not valid-handle(p-dataseth)
     3274     or p-dataseth:type <> "DATASET"
     3275     then do:
     3276       return error substitute("Не определен dataset с handle &1", p-dataseth).
     3277     end.
     3278     for each buf_temp-rel-handle where
     3279             buf_temp-rel-handle.dh = p-dataseth:
     3280       delete buf_temp-rel-handle.
     3281     end.
     3282     do v-ii = 1 to p-dataseth:num-relations:
     3283       create buf_temp-rel-handle.
     3284       assign
     3285       buf_temp-rel-handle.ii = v-ii
     3286       buf_temp-rel-handle.dh = p-dataseth
     3287       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     3288       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     3289       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     3290       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     3291       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     3292       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     3293       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     3294       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     3295       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     3296       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     3297       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     3298       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     3299       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     3300       .
     3301     end.
     3302   end.
     3303   end procedure.
     3304   procedure tmpreldf_set-relations :
     3305   define input parameter p-srcdataseth as handle no-undo .
     3306   define input parameter p-trgdataseth as handle no-undo .
     3307   define variable gh as handle no-undo .
     3308   define buffer buf_temp-rel-handle for temp-rel-handle.
     3309   do
     3310   on error undo, return error
     3311   :
     3312     if not valid-handle(p-srcdataseth)
     3313     or p-srcdataseth:type <> "DATASET"
     3314     then do:
     3315       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     3316     end.
     3317     if not valid-handle(p-trgdataseth)
     3318     or p-trgdataseth:type <> "DATASET"
     3319     then do:
     3320       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     3321     end.
     3322     for each buf_temp-rel-handle no-lock where
     3323             buf_temp-rel-handle.dh = p-srcdataseth
     3324     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3325     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3326     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3327     :
     3328       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     3329                                         , buf_temp-rel-handle.child-buffer-handle
     3330                                         , buf_temp-rel-handle.relation-fields_
     3331                                         , buf_temp-rel-handle.reposition_
     3332                                         , buf_temp-rel-handle.nested_).
     3333      if error-status:error
     3334      or not valid-handle(gh) then do:
     3335        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     3336      end.
     3337     end.
     3338   end.
     3339   end procedure.
     3340   define variable glog as logical no-undo .
     3341   define variable v-ok as logical no-undo .
     3342   define variable v-headerh as handle no-undo .
     3343   define variable v-header-th as handle no-undo .
     3344   define variable v_locdataseth as handle no-undo .
     3345   define variable v-schema-name as character no-undo .
     3346   define variable v-esys-id as integer no-undo .
     3347   define variable v-pack-num as integer no-undo .
     3348   define variable v-schema-tmp-file as character no-undo .
     3349   define variable v-gate-rec as character no-undo .
     3350   define variable v-part-num as integer no-undo init 1.
     3351   define variable v-clob-db-num as integer no-undo .
     3352   define variable v-int64-id as int64 no-undo .
     3353   define variable v-path                    as character                no-undo .
     3354   DEFINE VARIABLE v-full-path               as character                no-undo .
     3355   DEFINE VARIABLE v-file-name               as character                no-undo .
     3356   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     3357   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     3358   define variable v-pck-num                 as integer                  no-undo .
     3359   define variable v-rec-cnt     as integer   no-undo.
     3360   define variable v-xml-err as character no-undo .
     3361   define variable v-header-schema-name as character no-undo .
     3362   define variable v-header-name as character no-undo .
     3363   define variable v-header-rec as character no-undo .
     3364   define buffer buf_temp-xml-tables for temp-xml-tables.
     3365   define buffer buf_clob-data for ub.clob-data.
     3366   define buffer buf_temp_xmllib_rec for temp_xmllib_rec.
     3367   define buffer buf_temp_xmllib_rec-fld for temp_xmllib_rec-fld.
     3368   define frame imp-pck
     3369   p-xml-file-name label "Файл пакета" format "x(50)" skip
     3370   v-rec-cnt       label "Основных записей" format ">>>>>>>>>9" skip
     3371   with view-as dialog-box side-labels 1 columns three-d title "** Разбор пакета"
     3372   .
     3373   main-block:
     3374   do
     3375   on error undo, return error return-value
     3376   :
     3377     assign
     3378     v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     3379     .
     3380     run gbl/filename.p (
     3381                     input p-xml-file-name
     3382                   ,output v-full-path
     3383                   ,output v-path
     3384                   ,output v-file-name
     3385                   ,output v-file-name-no-ext
     3386                   ,output v-file-name-ext
     3387                   ) no-error .
     3388     if error-status :error then do:
     3389       run write-log in p-log-handle (           input 2         , input substitute("Файл пакета &1 не найден"                                  , p-xml-file-name                                   ) ).
     3390       undo, return error substitute("Файл пакета &1 не найден"                                  , p-xml-file-name                                   ).
     3391     end.
     3392     v-header-schema-name = "exe/ThHeader.xsd".
     3393     v-header-name = "ThHeader".
     3394     run get-gate-rec in this-procedure ( input v-header-schema-name
     3395                                         ,output v-header-rec) no-error.
     3396     if error-status:error then do:
     3397       undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-header-schema-name).
     3398     end.
     3399     run get-header-by-rec in this-procedure ( input v-header-rec
     3400                                           ,output v-header-th
     3401                                           ) no-error.
     3402     if error-status:error then do:
     3403           run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании структуры заголовка поакета согласно гейту:&1&2"                               , v-header-rec                               , chr(10), error-status:get-message(1) ) ).
     3404       undo, return error '':U.
     3405     end.
     3406     v-headerh = v-header-th:default-buffer-handle.
     3407     run getoxmlh in this-procedure ( input v-full-path
     3408                                     ,input ? // или передать memptr в который загружен xml-файл
     3409                                     ,input v-headerh
     3410                                     ,input -1
     3411                                      ) no-error.
     3412     define buffer buf_rec for temp_xmllib_rec.
     3413     define buffer buf_rec-fld for temp_xmllib_rec-fld.
     3414     for first buf_temp_xmllib_rec where
     3415             buf_temp_xmllib_rec.recname = "THheader",
     3416           each buf_temp_xmllib_rec-fld where
     3417            buf_temp_xmllib_rec-fld.rec-key = buf_temp_xmllib_rec.rec-key:
     3418       case buf_temp_xmllib_rec-fld.fldname:
     3419          when "THfilename" then do:
     3420          end.
     3421          when "THschema-name" then do:
     3422            v-schema-name = buf_temp_xmllib_rec-fld.fldvalue.
     3423          end.
     3424          when "THimport-esys-id" then do:
     3425            v-esys-id = integer(buf_temp_xmllib_rec-fld.fldvalue).
     3426          end.
     3427          when "THpack-num" then do:
     3428            v-pack-num = integer(buf_temp_xmllib_rec-fld.fldvalue).
     3429          end.
     3430       end case.
     3431     end.
     3432     if p-esys-id <> 0
     3433     and v-esys-id <> p-esys-id then do:
     3434       run write-log in p-log-handle (           input 2         , input substitute("Ожидался файл от ВС &1, в файле импорта указана ВС &2"                                  , p-esys-id                                  , v-esys-id                                   ) ).
     3435       return error substitute("Ожидался файл от ВС &1, в файле импорта указана ВС &2"                                  , p-esys-id                                  , v-esys-id                                   ).
     3436     end.
     3437     if p-pack-num <> 0
     3438     and v-pack-num <> p-pack-num then do:
     3439       run write-log in p-log-handle (           input 2         , input substitute("Читается пакет № &1, в файле импорта у№ пакета указан как &2"                                  , p-pack-num                                  , v-pack-num                                   ) ).
     3440       return error substitute("Читается пакет № &1, в файле импорта у№ пакета указан как &2"                                  , p-pack-num                                  , v-pack-num                                   ).
     3441     end.
     3442     if v-schema-name <> p-xsd-file then do:
     3443       run write-log in p-log-handle (           input 2         , input substitute("В профайле &1 нет обработки данных по схеме &2"                                  , p-profile-id                                  , v-schema-name                                   ) ).
     3444       return error substitute("В профайле &1 нет обработки данных по схеме &2"                                  , p-profile-id                                  , v-schema-name                                   ).
     3445     end.
     3446     assign
     3447     v-pck-num = 0.
     3448     run get-gate-rec in this-procedure ( v-schema-name
     3449                                         ,output v-gate-rec) no-error.
     3450     if error-status:error then do:
     3451       undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-schema-name).
     3452     end.
     3453     define variable v-longchar as longchar no-undo .
     3454     v-longchar = ?.
     3455     run get-gate-by-rec in this-procedure ( input v-gate-rec
     3456                                           ,output v_locdataseth
     3457                                           ,input-output v-xmlh
     3458                                           ,input-output  v-longchar
     3459                                           ) no-error.
     3460     if error-status:error then do:
     3461           run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2"                                , v-gate-rec                                , chr(10), error-status:get-message(1) ) ).
     3462       undo, return error substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2"                                , v-gate-rec                                , chr(10), error-status:get-message(1) ).
     3463     end.
     3464     create buf_temp-xml-tables.
     3465     assign
     3466     buf_temp-xml-tables.tbl-name = v-headerh:table
     3467     buf_temp-xml-tables.tbl-handle_ = v-headerh
     3468     buf_temp-xml-tables.table-handle_ = v-headerh:table-handle
     3469     buf_temp-xml-tables.order = -3
     3470     buf_temp-xml-tables.gate-handle = v_locdataseth
     3471     buf_temp-xml-tables.gate-name = v-schema-name
     3472     buf_temp-xml-tables.uniq-gate-rec = v-gate-rec
     3473     .
     3474     run tmpreldf_get-relations in this-procedure ( input v_locdataseth).
     3475     for each buf_temp-xml-tables
     3476     break
     3477     by buf_temp-xml-tables.order
     3478     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3479     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3480     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3481     :
     3482      if first(buf_temp-xml-tables.order) then do:
     3483        glog = v_locdataseth:set-buffers ( buf_temp-xml-tables.tbl-handle_) no-error.
     3484      end.
     3485      else do:
     3486        glog = v_locdataseth:add-buffer ( buf_temp-xml-tables.tbl-handle_) no-error.
     3487      end.
     3488      if error-status:error
     3489      or not glog
     3490      then do:
     3491               run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании заголовка XML файла:&1&2", chr(10), error-status:get-message(1) ) ).
     3492         run gate-clear in this-procedure ( input v_locdataseth, input v-xmlh).
     3493         undo, return error substitute("Ошибка при создании заголовка XML файла:&1&2", chr(10), error-status:get-message(1) ).
     3494       end.
     3495     end.
     3496     run tmpreldf_set-relations in this-procedure ( input v_locdataseth, input v_locdataseth).
     3497     run gbl/_tmpfile.p (
     3498                         input ""
     3499                       , input "xml"
     3500                       , output v-schema-tmp-file) .
     3501     assign
     3502     glog = v_locdataseth:WRITE-XMLSCHEMA( "FILE"
     3503                                      , v-schema-tmp-file
     3504                                      , yes
     3505                                      , ?
     3506                                      , no
     3507                                      ) no-error .
     3508     if error-status :error then do:
     3509               run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании временного файла xsd со схемой &1:&2&3"                                     , v_locdataseth:name                                     , chr(10)                                       , error-status:get-message(1) ) ).
     3510       run gate-clear in this-procedure ( input v_locdataseth, input v-xmlh).
     3511       undo, return error substitute("Ошибка при создании временного файла xsd со схемой &1:&2&3"                                     , v_locdataseth:name                                     , chr(10)                                       , error-status:get-message(1) ).
     3512     end.
     3513     assign
     3514     v-rec-cnt = 0
     3515     .
     3516     run gate-clear in this-procedure ( input v_locdataseth, input v-xmlh).
     3517     for each buf_temp-xml-tables:
     3518       delete buf_temp-xml-tables.
     3519     end.
     3520     run get-gate-by-file in this-procedure ( input v-schema-tmp-file
     3521                                           ,input v-gate-rec
     3522                                           ,output v_dataseth
     3523                                           ,input-output v-xmlh) no-error.
     3524     if error-status:error then do:
     3525           run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании структуры маршрутизируемых данных согласно файлу схемы:&1&2&3&2&4"                                , v-schema-tmp-file                                , chr(10), error-status:get-message(1), return-value  ) ).
     3526       undo, return error substitute("Ошибка при создании структуры маршрутизируемых данных согласно файлу схемы:&1&2&3&2&4"                                , v-schema-tmp-file                                , chr(10), error-status:get-message(1), return-value  ).
     3527     end.
     3528     ASSIGN
     3529     glog = v_dataseth:read-xml( "file"
     3530                               ,p-xml-file-name
     3531                               ,"merge"
     3532                               ,v-schema-tmp-file
     3533                               ,?
     3534                               ,?
     3535                               ,"strict"
     3536                               ) no-error .
     3537     if error-status:error
     3538     then do:
     3539       run write-log in p-log-handle (           input 2         , input substitute("Ошибка при чтении XML файла &1 данными через гейт &2:&3&4"                                     , p-xml-file-name                                     , v-schema-name                                     , chr(10)                                       , error-status:get-message(1)) ).
     3540       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     3541       undo, return error substitute("Ошибка при чтении XML файла &1 данными через гейт &2:&3&4"                                     , p-xml-file-name                                     , v-schema-name                                     , chr(10)                                       , error-status:get-message(1)).
     3542     end.
     3543     if not glog then do:
     3544       v-xml-err = error-status:get-message(1) + chr(10) + error-status:get-message(2).
     3545           run write-log in p-log-handle (           input 2         , input substitute("Не прошел верификацию с помощью схемы &1 XML файл &2:&3&4&3&5"                                     , v-schema-name                                     , p-xml-file-name                                     , chr(10)                                       , v-xml-err ) ).
     3546       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     3547       os-delete value(v-schema-tmp-file).
     3548       undo, return error substitute("Не прошел верификацию с помощью схемы &1 XML файл &2:&3&4&3&5"                                     , v-schema-name                                     , p-xml-file-name                                     , chr(10)                                       , v-xml-err ).
     3549     end.
     3550     find first buf_temp-xml-tables where
     3551               buf_temp-xml-tables.tbl-name = "THheader"
     3552           and buf_temp-xml-tables.gate-handle_ = v_dataseth
     3553               no-error.
     3554     if not available buf_temp-xml-tables then do:
     3555       run write-log in p-log-handle (           input 2         , input substitute("Не найден THHEADER в XML файлe &1:&2&3"                                     , p-xml-file-name                                     , chr(10)                                       , error-status:get-message(1)) ).
     3556       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     3557       os-delete value(v-schema-tmp-file).
     3558       undo, return error substitute("Не найден THHEADER в XML файлe &1:&2&3"                                     , p-xml-file-name                                     , chr(10)                                       , error-status:get-message(1)).
     3559     end.
     3560     glog = buf_temp-xml-tables.tbl-handle_:find-first( "where true") no-error.
     3561     if error-status:error
     3562     or not glog
     3563     or buf_temp-xml-tables.tbl-handle_:available = no then do:
     3564       run write-log in p-log-handle (           input 2         , input substitute("Не найдена запись THHEADER в XML файлe &1:&2&3"                                     , p-xml-file-name                                     , chr(10)                                       , error-status:get-message(1)) ).
     3565       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     3566       os-delete value(v-schema-tmp-file).
     3567       undo, return error substitute("Не найдена запись THHEADER в XML файлe &1:&2&3"                                     , p-xml-file-name                                     , chr(10)                                       , error-status:get-message(1)).
     3568     end.
     3569     assign
     3570     v-rec-cnt = v-rec-cnt + 1
     3571     .
     3572     os-delete value(v-schema-tmp-file).
     3573     v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle.
     3574   end.
