     2046   buf_rule-call-param.codex_id = p-codex-id
     2047   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2048   and buf_rule-call-param.call_id = p-call-id
     2049   and buf_rule-call-param.order_id = p-order-id
     2050   and buf_rule-call-param.rule_id = p-rule-id
     2051   and buf_rule-call-param.param-name = "p-esys-id"
     2052    no-error.
     2053   if available buf_rule-call-param then do:
     2054   assign p-esys-id = buf_rule-call-param.param-value-integer.
     2055   end.
     2056    find first buf_rule-call-param no-lock where
     2057   buf_rule-call-param.codex_id = p-codex-id
     2058   and buf_rule-call-param.ruleset_id = p-ruleset-id
     2059   and buf_rule-call-param.call_id = p-call-id
     2060   and buf_rule-call-param.order_id = p-order-id
     2061   and buf_rule-call-param.rule_id = p-rule-id
     2062   and buf_rule-call-param.param-name = "p-xsd-file"
     2063    no-error.
