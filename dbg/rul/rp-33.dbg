     5571         buf2_temp-call-param.call-name_ = substitute("dis-rule_rf_&1&2", string(v-templ-rl-root, "99999"), v-inversed-chr)
     5572         buf2_temp-call-param.param-number_ = integer(buf_drt-prop.prop-code)
     5573         buf2_temp-call-param.param-name_ = entry(1, buf_drt-prop.property-value)
     5574         buf2_temp-call-param.param-datatype_ = entry(2, buf_drt-prop.property-value)
     5575         buf2_temp-call-param.io-mode_ = entry(3, buf_drt-prop.property-value)
     5576         buf2_temp-call-param.param-label_ = entry(4, buf_drt-prop.property-value)
     5577         buf2_temp-call-param.fld-df = entry(5, buf_drt-prop.property-value)
     5578         .
     5579         glog60 = p-dr-flddf:find-first( substitute(' where fld-df = &1&2&1', chr(34), buf2_temp-call-param.fld-df, chr(34))) no-error.
     5580         if p-dr-flddf:available = no then do:
     5581           message
     5582           substitute("Не определен регистр &1 параметра &2 для расчета скидок/бонусов по правилу с шаблоном &3"
     5583                                         ,buf2_temp-call-param.fld-df
     5584                                         ,buf2_temp-call-param.param-name_
     5585                                         ,v-templ-rl-root)
     5586           view-as alert-box error .
     5587           undo, return error substitute("Не определен регистр &1 параметра &2 для расчета скидок/бонусов по правилу с шаблоном &3"
     5588                                         ,buf2_temp-call-param.fld-df
     5589                                         ,buf2_temp-call-param.param-name_
     5590                                         ,v-templ-rl-root).
     5591         end.
     5592         assign
     5593         buf2_temp-call-param.field-name_ = p-dr-flddf::field-name_
     5594         buf2_temp-call-param.table-no = p-dr-flddf::table-no
     5595         .
     5596       end.
     5597     end.
     5598     assign
     5599     buf_temp-call-param.num-params = v-ii
     5600     .
     5601   end.
     5602   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5603     find first buf_temp-call-param where
     5604               buf_temp-call-param.call-name_ = substitute("dis-rule_rf_&1&2", string(v-templ-rl-root, "99999"), v-inversed-chr)
     5605           and buf_temp-call-param.param-number = 0.
     5606     if not valid-handle(buf_temp-call-param.call-handle_) then do:
     5607       create call buf_temp-call-param.call-handle_.
     5608       assign
     5609       buf_temp-call-param.call-handle_:call-name = buf_temp-call-param.call-name_
     5610       buf_temp-call-param.call-handle_:call-type = FUNCTION-CALL-TYPE
     5611       buf_temp-call-param.call-handle_:in-handle = this-procedure:handle
     5612       buf_temp-call-param.call-handle_:num-parameters = buf_temp-call-param.num-params
     5613       .
     5614     end.
     5615   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5616     define variable glog62 as logical   no-undo .
     5617     define variable v-dt-tp62  as character no-undo .
     5618     for each buf2_temp-call-param where
     5619             buf2_temp-call-param.param-num > 0
     5620         and buf2_temp-call-param.call-name_ = substitute("dis-rule_rf_&1&2", string(v-templ-rl-root, "99999"), v-inversed-chr)
     5621     on error  undo , return error substitute( "&1. &2&3&4", vss-include-info62,  return-value, chr(10), error-status :get-message (1))
     5622     on stop   undo , return error substitute( "&1. stop", vss-include-info62 )
     5623     on endkey undo , return error substitute( "&1. endkey", vss-include-info62 ):
     5624         if v-bh[buf2_temp-call-param.table-no]:buffer-field(buf2_temp-call-param.field-name_):buffer-value = ? then
     5625         do:
     5626            case buf2_temp-call-param.param-datatype_:
     5627               when "decimal"  or when "integer" then
     5628               do:
     5629       glog62 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5630                                                       ,buf2_temp-call-param.param-datatype_
     5631                                                       ,buf2_temp-call-param.io-mode
     5632                                                       ,0
     5633                                                       ).
     5634               end.
     5635               when "character" then
     5636               do:
     5637       glog62 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5638                                                       ,buf2_temp-call-param.param-datatype_
     5639                                                       ,buf2_temp-call-param.io-mode
     5640                                                       ,""
     5641                                                       ).
     5642               end.
     5643            end case .
     5644         end.
     5645         else
     5646       glog62 = buf_temp-call-param.call-handle_:set-parameter( buf2_temp-call-param.param-num
     5647                                                       ,buf2_temp-call-param.param-datatype_
     5648                                                       ,buf2_temp-call-param.io-mode
     5649                                                       ,v-bh[buf2_temp-call-param.table-no]:buffer-field(buf2_temp-call-param.field-name_):buffer-value
     5650                                                       ).
     5651     end.
     5652     assign
     5653     buf_temp-call-param.call-number = buf_temp-call-param.call-number + 1
     5654     v-last-call-number = buf_temp-call-param.call-number
     5655     v-last-call-name = buf_temp-call-param.call-name_
     5656     .
     5657     buf_temp-call-param.call-handle_:invoke.
     5658       if buf_temp-call-param.call-handle_:return-value = ? then
     5659       do:
     5660          v-dt-tp62 = v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):data-type .
     5661          if v-dt-tp62 = "decimal" or v-dt-tp62 = "integer" then
     5662          do:
     5663   v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):buffer-value = 0 .
     5664          end.
     5665       end.
     5666       else
     5667       do:
     5668     v-bh[buf_temp-call-param.table-no]:buffer-field(buf_temp-call-param.field-name_):buffer-value = buf_temp-call-param.call-handle_:return-value.
     5669       end.
     5670     if v-inversed then do:
     5671       v-bh[6]:buffer-field("object-sum"):buffer-value =
     5672       v-bh[6]:buffer-field("object-sum"):buffer-value   .
     5673     end.
     5674     if v-bh[6]:buffer-field("value-type"):buffer-value =  integer('1':U) then do:
     5675     end.
     5676     else do:
     5677       v-bh[6]:buffer-field("discnt-value-pcnt"):buffer-value =
     5678                 v-bh[6]:buffer-field("discnt-value-abs"):buffer-value /
     5679                 v-bh[6]:buffer-field("object-sum"):buffer-value * 100
     5680                 .
     5681     end.
     5682     assign
     5683     v-delta-discnt-r-b = v-bh[6]:buffer-field("discnt-value-abs"):buffer-value
     5684     .
     5685     if v-bh[1]:buffer-field("r-b"):buffer-value = 'rubl':U then do:
     5686       assign
     5687       v-delta-discnt-rubl = v-delta-discnt-r-b
     5688       v-new-rubl-sum = v-rubl-sum - v-delta-discnt-rubl * integer(not v-inversed)
     5689       v-new-discnt-rubl = v-discnt-rubl + v-delta-discnt-rubl
     5690       .
     5691       if v-bh[1]:buffer-field("base-code"):buffer-value = 0 then do:
     5692         assign
     5693         v-delta-discnt-base = v-delta-discnt-r-b
     5694         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5695         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5696         .
     5697       end.
     5698       else do:
     5699         assign
     5700         v-delta-discnt-base = v-delta-discnt-r-b * v-bh[2]:buffer-field("base-rate"):buffer-value
     5701         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5702         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5703         .
     5704       end.
     5705     end.
     5706     else do:
     5707       assign
     5708       v-delta-discnt-base = v-delta-discnt-r-b
     5709       v-new-base-sum = v-base-sum - v-delta-discnt-base  * integer(not v-inversed)
     5710       v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5711       .
     5712       if  v-bh[1]:buffer-field("base-code"):buffer-value = 0 then do:
     5713         assign
     5714         v-delta-discnt-rubl = v-delta-discnt-r-b
     5715         v-new-rubl-sum = v-rubl-sum - v-delta-discnt-base * integer(not v-inversed)
     5716         v-new-discnt-rubl = v-discnt-rubl + v-delta-discnt-base
     5717         .
     5718       end.
     5719       else do:
     5720         assign
     5721         v-delta-discnt-base = v-delta-discnt-r-b / v-bh[2]:buffer-field("base-rate"):buffer-value
     5722         v-new-base-sum = v-base-sum - v-delta-discnt-base * integer(not v-inversed)
     5723         v-new-discnt-base = v-discnt-base + v-delta-discnt-base
     5724         .
     5725       end.
     5726     end.
     5727     if v-curr-code = 0 then do:
     5728       assign
     5729       v-delta-discnt-curr = v-delta-discnt-rubl
     5730       v-new-curr-sum = v-curr-sum - v-delta-discnt-curr * integer(not v-inversed)
     5731       v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5732       .
     5733     end.
     5734     else do:
     5735       if v-curr-code = v-bh[1]:buffer-field("base-code"):buffer-value then do:
     5736         assign
     5737         v-delta-discnt-curr = v-delta-discnt-base
     5738         v-new-curr-sum = v-curr-sum - v-delta-discnt-curr  * integer(not v-inversed)
     5739         v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5740         .
     5741       end.
     5742       else do:
     5743         assign
     5744         v-delta-discnt-curr = v-delta-discnt-rubl / v-bh[5]:buffer-field("exch-rate"):buffer-value * v-bh[5]:buffer-field("exch-scale"):buffer-value
     5745         v-new-curr-sum = v-curr-sum - v-delta-discnt-curr * integer(not v-inversed)
     5746         v-new-discnt-curr = v-discnt-curr + v-delta-discnt-curr
     5747         .
     5748       end.
     5749     end.
     5750     if v-bh[6]:buffer-field("intended"):buffer-value = no
     5751     and v-bh[6]:buffer-field("not-found"):buffer-value = no
     5752     then do:
     5753       if v-inversed then do:
     5754         create buf_chk-discnt.
     5755         buffer buf_chk-discnt:handle:buffer-copy(v-bh[6]).
     5756         if buf_temp-discnt-role.table-name = 'dis-cp-rule':U then do:
     5757           assign
     5758           buffer buf_chk-discnt:handle:buffer-field("object-sum"):buffer-value = v-bh[2]:buffer-field("netto"):buffer-value
     5759           .
     5760         end.
     5761         run printbuffer in this-procedure ( input v-bh[6]).
     5762         release buf_chk-discnt.
     5763       end.
     5764       v-bh[6]:buffer-release().
     5765       v-found = yes.
     5766     end.
     5767     else do:
     5768       v-bh[6]:buffer-delete().
     5769       v-found = no.
     5770     end.
     5771   end.
     5772               if v-found then leave _cycle.
     5773             end.
     5774           end.
     5775         end case.
     5776       end.
     5777       if v-found and not p-add-discnts then do:
     5778         leave _roles.
     5779       end.
     5780     end.
     5781   end.
     5782   end.
     5783   end procedure.
     5784   procedure load-ruleset-context :
     5785   define variable v-subject-type as integer no-undo .
     5786   define variable v-found as logical no-undo .
     5787   define variable v-vh as handle no-undo .
     5788   define buffer buf_rule-call-param for ub.rule-call-param.
     5789   define buffer buf_rule-by-call for ub.rule-by-call.
     5790   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     5791   define buffer buf_temp-rule-by-call for temp-rule-by-call.
     5792   define buffer buf_temp-discnt-role for temp-discnt-role.
     5793   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     5794   define buffer buf2_dis-cfg-rule for ub.dis-cfg-rule.
     5795   main-block:
     5796   do
     5797   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5798   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5799   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5800   :
     5801     for each buf_temp-rule-call-param:
     5802       delete buf_temp-rule-call-param.
     5803     end.
     5804     for each buf_temp-rule-by-call:
     5805       delete buf_temp-rule-by-call.
     5806     end.
     5807     for each buf_rule-call-param no-lock where
     5808             buf_rule-call-param.profile_id = p-profile-id
     5809         and buf_rule-call-param.once-more = p-once-more
     5810         and buf_rule-call-param.call_id = p-call-id
     5811     break
     5812     by buf_rule-call-param.call_id
     5813     by buf_rule-call-param.codex_id
     5814     by buf_rule-call-param.ruleset_id
     5815     by buf_rule-call-param.order_id
     5816     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5817     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5818     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5819     :
     5820       if first-of(buf_rule-call-param.order_id)  then do:
     5821         v-found = no.
     5822       end.
     5823       create buf_temp-rule-call-param.
     5824       buffer-copy buf_rule-call-param to buf_temp-rule-call-param.
     5825       if (lookup(buf_temp-rule-call-param.param-3-data-type, "LIST") = 0
     5826       and lookup(buf_temp-rule-call-param.param-3-data-type, "SORTED-LIST") = 0
     5827       )
     5828       or buf_temp-rule-call-param.p-index > 0 then do:
     5829         if lookup(buf_temp-rule-call-param.param-2-data-type, 'gds-discnt-role,subtotal-discnt-role,pay-discnt-role':U) > 0
     5830         then do:
     5831           case buf_temp-rule-call-param.param-2-data-type:
     5832             when 'gds-discnt-role':U then do:
     5833               assign
     5834               v-subject-type = integer('1':U).
     5835             end.
     5836             when 'subtotal-discnt-role':U then do:
     5837               assign
     5838               v-subject-type = integer('2':U).
     5839             end.
     5840             when 'pay-discnt-role':U then do:
     5841               assign
     5842               v-subject-type = integer('5':U).
     5843             end.
     5844           end case.
     5845           for each buf_dis-cfg-rule no-lock where
     5846                       buf_dis-cfg-rule.discnt-role = buf_temp-rule-call-param.param-value-character
     5847                   and buf_dis-cfg-rule.pos-type = p-pos-type-for-discnt
     5848                and buf_dis-cfg-rule.subject-type = v-subject-type :
     5849             if buf_dis-cfg-rule.link-prop <> integer('0':U)
     5850             and buf_dis-cfg-rule.link-prop <> integer('-1':U) then next.
     5851             assign
     5852             v-vh = p-bh[1]:buffer-field("how-" + buf_temp-rule-call-param.param-value-character) no-error.
     5853             if valid-handle(v-vh)
     5854             and buf_dis-cfg-rule.discnt-role <> p-bh[1]:buffer-field("how-" + buf_temp-rule-call-param.param-value-character):buffer-value
     5855             then next.
     5856             find first buf_temp-discnt-role where
     5857                     buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5858                 and buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5859                 and buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5860                 and buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5861                 and buf_temp-discnt-role.pos-type = p-pos-type-for-discnt
     5862                 and buf_temp-discnt-role.discnt-role = buf_temp-rule-call-param.param-value-character
     5863                 and buf_temp-discnt-role.table-name = buf_dis-cfg-rule.table-name
     5864                 no-error.
     5865             if not available buf_temp-discnt-role then do:
     5866               create buf_temp-discnt-role.
     5867               assign
     5868               buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5869               buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5870               buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5871               buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5872               buf_temp-discnt-role.once-more = buf_temp-rule-call-param.once-more
     5873               buf_temp-discnt-role.pos-type = p-pos-type-for-discnt
     5874               buf_temp-discnt-role.subject-type = v-subject-type
     5875               buf_temp-discnt-role.discnt-role = buf_temp-rule-call-param.param-value-character
     5876               buf_temp-discnt-role.discnt-type = buf_Dis-cfg-rule.discnt-type
     5877               buf_temp-discnt-role.table-name = buf_Dis-cfg-rule.table-name
     5878               buf_temp-discnt-role.has-glob = buf_Dis-cfg-rule.has-glob
     5879               buf_temp-discnt-role.has-host = buf_Dis-cfg-rule.has-host
     5880               buf_temp-discnt-role.has-obj = buf_Dis-cfg-rule.has-obj
     5881               buf_temp-discnt-role.link-prop = buf_Dis-cfg-rule.link-prop
     5882               buf_temp-discnt-role.templ-rl-root = (if buf_Dis-cfg-rule.link-prop = integer('-1':U)
     5883                                                     then buf_dis-cfg-rule.templ-rl-root
     5884                                                     else buf_temp-discnt-role.templ-rl-root)
     5885               buf_temp-discnt-role.time-templ-rl-root = (if buf_Dis-cfg-rule.link-prop = integer('-1':U)
     5886                                                     then buf_dis-cfg-rule.time-templ-rl-root
     5887                                                     else buf_temp-discnt-role.time-templ-rl-root)
     5888               .
     5889               v-found = yes.
     5890               if buf_temp-discnt-role.table-name = 'dis-grp-rule':U then do:
     5891                 assign
     5892                 p-bh[1]:buffer-field("is-grp-totals"):buffer-value = yes.
     5893               end.
     5894             end.
     5895           end.
     5896         end.
     5897       end.
     5898       if last-of(buf_rule-call-param.order_id) then do:
     5899         if v-found = no then do:
     5900           create buf_temp-discnt-role.
     5901           assign
     5902           buf_temp-discnt-role.codex_id = buf_temp-rule-call-param.codex_id
     5903           buf_temp-discnt-role.ruleset_id = buf_temp-rule-call-param.ruleset_id
     5904           buf_temp-discnt-role.order_id = buf_temp-rule-call-param.order_id
     5905           buf_temp-discnt-role.rule_id = buf_temp-rule-call-param.rule_id
     5906           buf_temp-discnt-role.once-more = buf_temp-rule-call-param.once-more
     5907           buf_temp-discnt-role.discnt-type = 0
     5908           buf_temp-discnt-role.subject-type = 0
     5909           buf_temp-discnt-role.discnt-role = ''
     5910           .
     5911         end.
     5912       end.
     5913     end.
     5914     for each buf_rule-by-call no-lock where
     5915             buf_rule-by-call.profile_id = p-profile-id
     5916         and buf_rule-by-call.once-more = p-once-more
     5917         and buf_rule-by-call.call_id = p-call-id
     5918     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5919     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5920     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5921     :
     5922       create buf_temp-rule-by-call.
     5923       buffer-copy buf_rule-by-call to buf_temp-rule-by-call.
     5924     end.
     5925     assign
     5926     v-current-host-code = p-host-code
     5927     v-current-obj-type = p-obj-type
     5928     v-current-obj-code = p-obj-code
     5929     v-current-db-num = g#db-num
     5930     v-current-pos-type = p-pos-type
     5931     v-current-pos-type-for-discnt = p-pos-type-for-discnt
     5932     .
     5933   end.
     5934   end procedure.
     5935   procedure rp-chk-doc_set-log :
     5936   define input parameter p-lock-log-handle as handle no-undo .
     5937   main-block:
     5938   do
     5939   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5940   :
     5941     p-log-handle = p-lock-log-handle.
     5942   end.
     5943   end.
