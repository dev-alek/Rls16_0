     1412         run mpl-tpl-auto in this-procedure ( input p-b-code
     1413                                             ,input 'маг':U
     1414                                             ,input p-obj-code
     1415                                             ,input integer(entry(1, buf_term-dis-rule.charkey_one,"-"))
     1416                                             ,input integer(entry(2, buf_term-dis-rule.charkey_one,"-"))
     1417                                             ,input ?
     1418                                             ,output v-price
     1419                                             ,output v-pdf-id
     1420                                             ,output v-pdf-db-num
     1421                                             ) no-error.
     1422         if error-status :error then do:
     1423            v-price = p-price-netto.
     1424            p-not-found = yes.
     1425            return 0.
     1426         end.
     1427         if v-pdf-id = 0
     1428         or v-pdf-id = ? then do:
     1429           p-not-found = yes.
     1430         end.
     1431         p-value-type = integer('12':U).
     1432         p-discnt-sum = (p-price-netto - v-price) * p-qnty.
     1433         return (p-price-netto - v-price).
     1434       end.
     1435     end.
     1436   end.
     1437   p-not-found = yes.
     1438   return 0.
     1439   end function.
     1440   FUNCTION dis-rule_rf_00085 returns decimal ( input p-rule-num as integer
     1441                                           , input p-date as date
     1442                                           , input p-time as integer
     1443                                           , input p-price-netto as decimal
     1444                                           , input p-nonunique as character
     1445                                           , input p-b-code as integer
     1446                                           , output p-not-found as logical
     1447                                           , output p-discnt-pcnt as decimal
     1448                                           , output p-value-type as integer
     1449                                           ):
     1450   define buffer buf_dis-rule for ub.dis-rule.
     1451   define buffer buf_term-dis-rule for ub.dis-rule.
     1452   p-value-type = integer('1':U).
     1453   if p-nonunique <> string(p-b-code) then do:
     1454     p-not-found = yes.
     1455     return 0.
     1456   end.
     1457   find first buf_dis-rule no-lock where
     1458           buf_dis-rule.rule-num = p-rule-num no-error.
     1459   if available buf_dis-rule
     1460   and buf_dis-rule.sts = integer('0':U)
     1461   then do:
     1462     for each buf_term-dis-rule no-lock where
     1463             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     1464       if (buf_term-Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_term-dis-rule.time-templ-rl-root - 50000, "99999" )                                        , input buf_term-dis-rule.time-rule-num                                         , input p-date                                        , input p-time )) then do:
     1465         p-discnt-pcnt = buf_term-dis-rule.discnt-value.
     1466         return p-price-netto * buf_term-dis-rule.discnt-value / 100.
     1467       end.
     1468     end.
     1469   end.
     1470   p-not-found = yes.
     1471   return 0.
     1472   end function.
     1473   FUNCTION dis-rule_rf_00088 returns decimal ( input p-rule-num as integer
     1474                                             , input p-date as date
     1475                                             , input p-time as integer
     1476                                             , input p-obj-code as integer
     1477                                             , input p-price-netto as decimal
     1478                                             , input p-dis-kat as integer
     1479                                             , input p-qnty as decimal
     1480                                             , input p-b-code as integer
     1481                                             , input-output p-price as decimal
     1482                                             , output p-discnt-sum as decimal
     1483                                             , output p-value-type as integer
     1484                                             , output p-not-found as logical
     1485                                             ):
     1486   define variable v-price as decimal no-undo .
     1487   define variable v-pdf-id as integer no-undo .
     1488   define variable v-pdf-db-num as integer   no-undo .
     1489   define buffer buf_dis-rule for ub.dis-rule.
     1490   define buffer buf_term-dis-rule for ub.dis-rule.
     1491   v-price = p-price.
     1492   p-value-type = integer('2':U).
     1493   find first buf_dis-rule no-lock where
     1494           buf_dis-rule.rule-num = p-rule-num no-error.
     1495   if available buf_dis-rule
     1496   and buf_dis-rule.sts = integer('0':U)
     1497   and (buf_Dis-rule.time-templ-rl-root <= 50000 or dynamic-function( "dis-time-rule_" + string(buf_dis-rule.time-templ-rl-root - 50000, "99999")                                        , input buf_dis-rule.time-rule-num                                         , input p-date                                        , input p-time ))
     1498   then do:
     1499     for each buf_term-dis-rule no-lock where
     1500             buf_term-dis-rule.upper-rule-num = buf_dis-rule.rule-num
     1501     and buf_term-dis-rule.dis-kat = p-dis-kat :
     1502       run mpl-tpl-auto in this-procedure ( input p-b-code
     1503                                           ,input 'маг':U
     1504                                           ,input p-obj-code
     1505                                           ,input integer(entry(1, buf_term-dis-rule.charkey_one,"-"))
     1506                                           ,input integer(entry(2, buf_term-dis-rule.charkey_one,"-"))
     1507                                           ,input ?
     1508                                           ,output v-price
     1509                                           ,output v-pdf-id
     1510                                           ,output v-pdf-db-num
     1511                                           ) no-error.
     1512       if error-status :error then do:
     1513           v-price = p-price-netto.
     1514           p-not-found = yes.
     1515           return 0.
     1516       end.
     1517       if v-pdf-id = 0
     1518       or v-pdf-id = ? then do:
     1519         p-not-found = yes.
     1520       end.
     1521       p-value-type = integer('12':U).
     1522       p-discnt-sum = (p-price-netto - v-price) * p-qnty.
     1523       return (p-price-netto - v-price).
     1524     end.
     1525   end.
     1526   p-not-found = yes.
     1527   return 0.0.
     1528   end function.
     1529   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   define temp-table temp-call-param no-undo
     1531   field call-number as integer
     1532   field call-name_ as character
     1533   field param-name_ as character
     1534   field param-label_ as character
     1535   field num-params_ as integer
     1536   field call-handle_ as handle
     1537   field param-number_ as integer
     1538   field param-datatype_ as character
     1539   field io-mode_ as character
     1540   field character_ as character
     1541   field date_ as date
     1542   field decimal_ as decimal
     1543   field integer_ as integer
     1544   field logical_ as logical
     1545   field fld-df as character
     1546   field field-name_ as CHARACTER
     1547   field table-no as integer
     1548   field field-handle as handle
     1549   index pi is unique primary call-name_ param-number_.
     1550   define variable v-last-call-name as character no-undo .
     1551   define variable v-last-call-number as int64 no-undo .
     1552   define variable v-inversed-chr as character no-undo init ''.
     1553   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   procedure printbuffer private:
     1555   define input parameter p-bh as handle no-undo .
     1556   define variable v-ii as integer no-undo .
     1557   if search("printbuffer.fld") <> ? then do:
     1558     output to value( substitute("&1.txt", p-bh:name)) append.
     1559     put unformatted today chr(32) string(time, "HH:MM:SS")
     1560     this-procedure :name skip
     1561     skip.
     1562     do v-ii = 1 to p-bh:num-fields:
     1563       if p-bh:buffer-field(v-ii):data-type = 'rowid':U then do:
     1564         put unformatted fill( chr(32), 10) p-bh:buffer-field(v-ii):name string(p-bh:buffer-field(v-ii):buffer-value) at 35 skip.
     1565       end.
     1566       else do:
     1567         put unformatted fill( chr(32), 10) p-bh:buffer-field(v-ii):name p-bh:buffer-field(v-ii):buffer-value at 35 skip.
     1568       end.
     1569     end.
     1570   end.
     1571   output close.
     1572   end procedure.
     1573   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1574   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   procedure factord :
     1578     define input  parameter p-fact-date            as date    no-undo .
     1579     define input  parameter p-fact-time            as integer no-undo .
     1580     define input  parameter p-fact-num             as integer no-undo .
     1581     define input  parameter p-shift-date           as date    no-undo .
     1582     define input  parameter p-shift-num            as integer no-undo .
     1583     define input  parameter p-shift-on             as logical no-undo .
     1584     define output parameter p-fact-order           as decimal no-undo .
     1585     define output parameter p-shift-end-fact-order as decimal no-undo .
     1586     define output parameter p-day-end-fact-order   as decimal no-undo .
     1587     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1588     if p-fact-date = ?
     1589     then do:
     1590       return error "Не указана фактическая дата" .
     1591     end.
     1592     define variable v-fact-date-num as integer no-undo .
     1593     assign
     1594       v-fact-date-num = integer(p-fact-date)
     1595     .
     1596     if p-fact-num = ?
     1597     or p-fact-num = 0
     1598     then do:
     1599       return error "Не задан p-fact-num " + string(p-fact-num) .
     1600     end.
     1601     if p-fact-num < 0
     1602     then do:
     1603       return error "Отрицательный fact-num " + string(p-fact-num) .
     1604     end.
     1605     if p-fact-num >= 100000000
     1606     then do:
     1607       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1608     end.
     1609     if p-shift-on = true
     1610     then do:
     1611       if p-shift-date = ?
     1612       then do:
     1613         return error "Не задана дата смены" .
     1614       end.
     1615       if p-shift-num = ?
     1616       or p-shift-num = 0
     1617       then do:
     1618         return error "Не задан номер смены" .
     1619       end.
     1620     end.
     1621     else do:
     1622       assign
     1623         p-shift-date = p-fact-date
     1624         p-shift-num  = 24
     1625       .
     1626     end.
     1627     define variable v-shift-offset as integer no-undo .
     1628     if p-shift-date = p-fact-date
     1629     then do:
     1630       assign
     1631         v-shift-offset = 1
     1632       .
     1633     end.
     1634     if p-shift-date < p-fact-date
     1635     then do:
     1636       assign
     1637         v-shift-offset = 0
     1638       .
     1639     end.
     1640     if p-shift-date > p-fact-date
     1641     then do:
     1642       message
     1643         vss-workfile vss-revision vss-description skip
     1644         "Неправильная дата закрытия смены" skip
     1645         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1646         view-as alert-box error .
     1647       undo, return error
     1648         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1649           ,string(p-fact-date, '99/99/9999':U)
     1650           ,string(p-shift-date, '99/99/9999':U)
     1651           )
     1652       .
     1653     end.
     1654     if p-shift-num < 1
     1655     or p-shift-num > 24
     1656     then do:
     1657       message
     1658         vss-workfile vss-revision vss-description skip
     1659         "Неправильный номер смены" skip
     1660         "p-shift-num" p-shift-num skip
     1661         view-as alert-box error .
     1662       undo, return error return-value .
     1663     end.
     1664     assign
     1665       p-fact-order           = v-fact-date-num
     1666                              + v-shift-offset * 0.5
     1667                              + p-shift-num    * 0.02 - 0.01
     1668                              + p-fact-num     * 0.0000000001
     1669       p-shift-end-fact-order = v-fact-date-num
     1670                              + v-shift-offset * 0.5
     1671                              + p-shift-num    * 0.02
     1672       p-day-end-fact-order   = v-fact-date-num
     1673                              + 0.99
     1674     .
     1675     if p-fact-order           <= v-fact-date-num
     1676     or p-shift-end-fact-order <= v-fact-date-num
     1677     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1678     or p-shift-end-fact-order >= p-day-end-fact-order
     1679     then do:
     1680       message
     1681         vss-workfile vss-revision vss-description skip
     1682         "Внутренняя ошибка при генерации фактического номера" skip
     1683         "p-fact-date"            p-fact-date            skip
     1684         "p-fact-time"            p-fact-time            skip
     1685         "p-fact-num"             p-fact-num             skip
     1686         "p-shift-date"           p-shift-date           skip
     1687         "p-shift-num"            p-shift-num            skip
     1688         "p-shift-on"             p-shift-on             skip
     1689         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1690         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1691         "v-fact-date-num"        v-fact-date-num        skip
     1692         view-as alert-box error .
     1693       undo, return error return-value .
     1694     end.
     1695   end procedure.
     1696   procedure day-begin-fact-order :
     1697     define input  parameter p-fact-date            as date    no-undo .
     1698     define output parameter p-day-begin-fact-order as decimal no-undo .
     1699     do
     1700     on error undo, return error return-value
     1701     :
     1702       if p-fact-date = ?
     1703       then do:
     1704         assign
     1705           p-day-begin-fact-order = 0
     1706         .
     1707       end.
     1708       else do:
     1709         assign
     1710           p-day-begin-fact-order = integer(p-fact-date)
     1711         .
     1712       end.
     1713     end.
     1714   end procedure.
     1715   procedure factord-max-fact-order :
     1716     define output parameter p-max-fact-order as decimal   no-undo .
     1717     do
     1718     on error undo, return error return-value
     1719     :
     1720       run day-begin-fact-order in this-procedure
     1721         (input  date(1, 1, 5000)
     1722         ,output p-max-fact-order
     1723         ) .
     1724     end.
     1725   end procedure.
     1726   procedure factord-cut-archive :
     1727     define input  parameter p-obj-type             as character no-undo .
     1728     define input  parameter p-obj-code             as integer   no-undo .
     1729     define input  parameter p-fact-date            as date      no-undo .
     1730     define output parameter p-shift-on             as logical   no-undo .
     1731     define output parameter p-shift-date           as date      no-undo .
     1732     define output parameter p-shift-num            as integer   no-undo .
     1733     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1734     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1735     define variable v-fact-order as decimal   no-undo .
     1736     define buffer buf_shift-obj for ub.shift-obj .
     1737     do
     1738     on error undo, return error return-value
     1739     :
     1740   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1742     (input  p-obj-type
     1743     ,input  p-obj-code
     1744     ,input  'shift-on=request'
     1745     ,output p-shift-on
     1746     ) no-error .
     1747       if error-status :error
     1748       then do:
     1749         message
     1750           vss-workfile vss-revision vss-description skip
     1751           "Ошибка при определении атрибута объекта" skip
     1752           "Объект" p-obj-type p-obj-code skip
     1753           error-status :get-message(1) skip
     1754           return-value skip
     1755           view-as alert-box error .
     1756         undo, return error return-value .
     1757       end.
     1758       if p-shift-on = false
     1759       then do:
     1760         assign
     1761           p-shift-date               = ?
     1762           p-shift-num                = 0
     1763         .
     1764       end.
     1765       else do:
     1766         find first buf_shift-obj share-lock
     1767           where buf_shift-obj.obj-type   = p-obj-type
     1768             and buf_shift-obj.obj-code   = p-obj-code
     1769             and buf_shift-obj.shift-date > p-fact-date
     1770           use-index pi
     1771           no-error .
     1772         if not available buf_shift-obj
     1773         or buf_shift-obj.status_ <> 'зкр':U
     1774         then do:
     1775           message
     1776             vss-workfile vss-revision vss-description skip
     1777             "Невозможно вычислить последнюю смену" skip
     1778             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1779             "Объект" p-obj-type p-obj-code skip
     1780             "Дата" p-fact-date skip
     1781             view-as alert-box error .
     1782           undo, return error return-value .
     1783         end.
     1784         find last buf_shift-obj share-lock
     1785           where buf_shift-obj.obj-type = p-obj-type
     1786             and buf_shift-obj.obj-code = p-obj-code
     1787             and buf_shift-obj.shift-date <= p-fact-date
     1788           use-index pi
     1789           no-error .
     1790         if available buf_shift-obj
     1791         then do:
     1792           if  buf_shift-obj.status_ = 'зкр':U
     1793           then do:
     1794             assign
     1795               p-shift-date = buf_shift-obj.shift-date
     1796               p-shift-num  = buf_shift-obj.shift-num
     1797             .
     1798           end.
     1799           else do:
     1800             message
     1801               vss-workfile vss-revision vss-description skip
     1802               "Невозможно вычислить последнюю смену" skip
     1803               "Статус смены отличен от статуса" 'зкр':U skip
     1804               "Объект" p-obj-type p-obj-code skip
     1805               "Дата" p-fact-date skip
     1806               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1807               view-as alert-box error .
     1808             undo, return error return-value .
     1809           end.
     1810         end.
     1811         else do:
     1812           assign
     1813             p-shift-date = p-fact-date - 1
     1814             p-shift-num  = 1
     1815           .
     1816         end.
     1817       end.
     1818       run factord in this-procedure
     1819         (input  p-fact-date
     1820         ,input  1
     1821         ,input  1
     1822         ,input  p-shift-date
     1823         ,input  p-shift-num
     1824         ,input  p-shift-on
     1825         ,output v-fact-order
     1826         ,output p-shift-end-fact-order
     1827         ,output p-day-end-fact-order
     1828         ) no-error .
     1829       if error-status :error
     1830       then do:
     1831         message
     1832           vss-workfile vss-revision vss-description skip
     1833           "Ошибка при вызове процедуры factord"
     1834           error-status :get-message(1) skip
     1835           return-value skip
     1836           view-as alert-box error .
     1837         undo, return error return-value .
     1838       end.
     1839     end.
     1840   end procedure.
     1841   procedure factord-lock-shift :
     1842     define input  parameter p-obj-type  as character no-undo .
     1843     define input  parameter p-obj-code  as integer   no-undo .
     1844     define input  parameter p-fact-date as date      no-undo .
     1845     define parameter buffer buf_shift-obj for ub.shift-obj .
     1846     define variable v-shift-on      as logical   no-undo .
     1847     define variable v-extra-message as character no-undo .
     1848     define variable v-error as character no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1854     (input  p-obj-type
     1855     ,input  p-obj-code
     1856     ,input  'shift-on=request'
     1857     ,output v-shift-on
     1858     ) no-error .
     1859       if error-status :error
     1860       then do:
     1861         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1862         undo, return error v-error .
     1863       end.
     1864       if v-shift-on = true
     1865       then do:
     1866         find first buf_shift-obj share-lock
     1867           where buf_shift-obj.obj-type   = p-obj-type
     1868             and buf_shift-obj.obj-code   = p-obj-code
     1869             and buf_shift-obj.shift-date > p-fact-date
     1870           use-index pi
     1871           no-error .
     1872         if not available buf_shift-obj
     1873         or buf_shift-obj.status_ <> 'зкр':U
     1874         then do:
     1875           find last buf_shift-obj
     1876             where buf_shift-obj.obj-type = p-obj-type
     1877               and buf_shift-obj.obj-code = p-obj-code
     1878               and buf_shift-obj.status_  = 'зкр':U
     1879             use-index stts
     1880             no-error .
     1881           if available buf_shift-obj
     1882           then do:
     1883             assign
     1884               v-extra-message =
     1885                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1886                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1887                               )
     1888             .
     1889           end.
     1890           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1891           undo, return error v-error .
     1892         end.
     1893       end.
     1894     end.
     1895   end procedure.
     1896   procedure factord-end-day :
     1897     define input  parameter p-fact-date            as date    no-undo .
     1898     define output parameter p-day-end-fact-order   as decimal no-undo .
     1899     do
     1900     on error undo, return error return-value
     1901     :
     1902       if p-fact-date = ?
     1903       then do:
     1904         return error "Не указана фактическая дата" .
     1905       end.
     1906       assign
     1907         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1908       .
     1909     end.
     1910   end procedure.
     1911   procedure factord-to-date :
     1912     define input  parameter p-fact-order as decimal no-undo .
     1913     define output parameter p-fact-date  as date    no-undo .
     1914     define variable v-ref-date  as date      no-undo .
     1915     define variable v-ref-delta as integer   no-undo .
     1916     do
     1917     on error undo, return error return-value
     1918     :
     1919       if p-fact-order = ?
     1920       or p-fact-order = 0
     1921       then do:
     1922         return error "Не указан fact-order" .
     1923       end.
     1924       assign
     1925         v-ref-date  = date(1, 1, 2000)
     1926       .
     1927       assign
     1928         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1929       .
     1930       assign
     1931         p-fact-date = v-ref-date + v-ref-delta
     1932       .
     1933     end.
     1934   end procedure.
     1935   procedure factord-to-fact-num :
     1936     define input  parameter p-fact-order as decimal no-undo .
     1937     define output parameter p-fact-num   as integer no-undo .
     1938     define variable v-fact-order-trunc as decimal no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       if p-fact-order = ?
     1943       or p-fact-order = 0
     1944       then do:
     1945         return error "Не указан fact-order" .
     1946       end.
     1947       assign
     1948        v-fact-order-trunc = truncate(p-fact-order, 2)
     1949       .
     1950       assign
     1951         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1952       .
     1953     end.
     1954   end procedure.
     1955   procedure factord-to-shift-num :
     1956     define input  parameter p-fact-order as decimal no-undo .
     1957     define output parameter p-shift-num   as integer no-undo .
     1958     define variable  p-shift-numd  as decimal   no-undo .
     1959     define variable v-fact-order-trunc as decimal no-undo .
     1960     do
     1961     on error undo, return error return-value
     1962     :
     1963       if p-fact-order = ?
     1964       or p-fact-order = 0
     1965       then do:
     1966         return error "Не указан fact-order" .
     1967       end.
     1968       assign
     1969        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1970       .
     1971       if v-fact-order-trunc < 0.5 then do:
     1972         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1973       end.
     1974       assign
     1975         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1976         .
     1977        assign
     1978         p-shift-num = truncate (p-shift-numd , 0)
     1979       .
     1980     end.
     1981   end procedure.
     1982   procedure fact-order-mpl :
     1983     do
     1984     on error undo, return error return-value
     1985     :
     1986   define input  parameter p-doc-date as date     no-undo .
     1987   define input  parameter p-obj-type as character no-undo .
     1988   define input  parameter p-obj-code as integer   no-undo .
     1989   define output parameter p-fact-order as decimal   no-undo .
     1990   define variable v-fact-date            as date    no-undo .
     1991   define variable v-fact-time            as integer no-undo .
     1992   define variable v-fact-order           as decimal no-undo .
     1993   define variable v-shift-end-fact-order as decimal no-undo .
     1994   define variable v-day-end-fact-order   as decimal no-undo .
     1995   define variable l-shift-on as logical no-undo .
     1996   define variable l-date as date      no-undo .
     1997   define variable l-time as integer   no-undo .
     1998   define variable shift-date as date      no-undo .
     1999   define variable shift-num  as integer   no-undo .
     2000   define variable shift-name as character no-undo .
     2001   define variable max-fact-order as decimal   no-undo .
     2002   define buffer buf_global-state for ub.global-state  .
     2003   find first buf_global-state no-lock no-error .
     2004   if not available buf_global-state then do:
     2005      message
     2006        "Не заданы параметры ценообразования!"
     2007        view-as alert-box error
     2008      .
     2009      return error return-value .
     2010   end.
     2011     run cur-time in this-procedure
     2012     ( output v-fact-date ,
     2013       output v-fact-time  ).
     2014   if p-doc-date = ? then do:
     2015   if buf_global-state.pl-use-sys-date-time  = true then do:
     2016         run factord in this-procedure
     2017           (input  v-fact-date
     2018           ,input  v-fact-time
     2019           ,input  v-fact-time
     2020           ,input  ?
     2021           ,input  ?
     2022           ,input  false
     2023           ,output v-fact-order
     2024           ,output v-shift-end-fact-order
     2025           ,output v-day-end-fact-order
     2026           ) no-error .
     2027         if error-status :error
     2028         or v-fact-order = ?
     2029         or v-fact-order = 0 then do:
     2030           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2031         end.
     2032         p-fact-order = v-fact-order .
     2033   end.
     2034   else do:
     2035   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2036   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2037     (input  p-obj-type
     2038     ,input  p-obj-code
     2039     ,input  'shift-on=request'
     2040     ,output l-shift-on
     2041     ) no-error .
     2042         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     2043         if p-doc-date <> ? then do:
     2044         end.
     2045          run gbl/factdate.p
     2046          ( input        p-obj-type  ,
     2047            input        p-obj-code  ,
     2048            input-output v-fact-date ,
     2049            input-output v-fact-time ,
     2050            input-output shift-date      ,
     2051            input-output shift-num       ,
     2052            input-output shift-name      ,
     2053            input        yes
     2054            ) no-error .
     2055         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     2056         run factord in this-procedure
     2057           (input  v-fact-date
     2058           ,input  v-fact-time
     2059           ,input  v-fact-time
     2060           ,input  shift-date
     2061           ,input  shift-num
     2062           ,input  l-shift-on
     2063           ,output v-fact-order
     2064           ,output v-shift-end-fact-order
     2065           ,output v-day-end-fact-order
     2066           ) no-error .
     2067         if error-status :error
     2068         or v-fact-order = ?
     2069         or v-fact-order = 0 then do:
     2070           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2071         end.
     2072         p-fact-order = v-fact-order .
     2073   end.
     2074   end.
     2075   else do:
     2076          run gbl/factdate.p
     2077          ( input        p-obj-type  ,
     2078            input        p-obj-code  ,
     2079            input-output v-fact-date ,
     2080            input-output v-fact-time ,
     2081            input-output shift-date      ,
     2082            input-output shift-num       ,
     2083            input-output shift-name      ,
     2084            input        yes
     2085            ) no-error .
     2086         if error-status :error then return error "Ошибка factdate.p " + return-value .
     2087         v-fact-date = p-doc-date .
     2088         run factord in this-procedure
     2089           (input  v-fact-date
     2090           ,input  v-fact-time
     2091           ,input  v-fact-time
     2092           ,input  shift-date
     2093           ,input  shift-num
     2094           ,input  l-shift-on
     2095           ,output v-fact-order
     2096           ,output v-shift-end-fact-order
     2097           ,output v-day-end-fact-order
     2098           ) no-error .
     2099         if error-status :error
     2100         or v-fact-order = ?
     2101         or v-fact-order = 0 then do:
     2102           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     2103         end.
     2104         p-fact-order = v-fact-order .
     2105   end.
     2106     end.
     2107   end procedure.
     2108   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
