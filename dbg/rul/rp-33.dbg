     1330           p-value-type = integer('1':U).
     1331           p-discnt-pcnt = buf_term-dis-rule.discnt-value.
     1332           return p-price-netto * buf_term-dis-rule.discnt-value / 100.
     1333         end.
     1334         when integer('2':U) then do:
     1335           p-value-type = integer('2':U).
     1336           if p-price-netto - buf_term-dis-rule.discnt-value * p-cli-base-rate <= 0 then do:
     1337             p-discnt-sum = 0.
     1338             return 0.
     1339           end.
