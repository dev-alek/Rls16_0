     2155   define output parameter p-pdf-id          as integer   no-undo .
     2156   define output parameter p-pdf-db-num      as integer   no-undo .
     2157   define output parameter p-sale-price-base as decimal   no-undo .
     2158   define output parameter p-sale-price-rubl as decimal   no-undo .
     2159   define output parameter p-road-tax-base as decimal   no-undo .
     2160   define output parameter p-road-tax-rubl as decimal   no-undo .
     2161   define output parameter p-excise-base   as decimal   no-undo .
     2162   define output parameter p-excise-rubl   as decimal   no-undo .
     2163   define variable v-cli-oborot-ALL as decimal   no-undo .
     2164   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     2165   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     2166   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2167   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     2168   define buffer buf_price-all              for ub.price-all  .
     2169   define buffer buf_goods                  for ub.goods      .
     2170   define buffer buf_global-state           for ub.global-state  .
     2171   define buffer buf_buyer-group            for ub.buyer-group  .
     2172   define buffer buf_turnover-group         for ub.turnover-group  .
     2173   define buffer buf_main-code              for ub.bar-code  .
     2174   define buffer buf_bar-code               for ub.bar-code  .
     2175   define buffer buf_pay-type               for ub.pay-type  .
     2176   define buffer buf_cash-pay               for ub.cash-pay  .
     2177   define variable to-day          as date      no-undo .
     2178   define variable v-base-rate0    as decimal   no-undo .
     2179   define variable v-base-scale0   as decimal   no-undo .
     2180   define variable v-exch-rate0    as decimal   no-undo .
     2181   define variable v-exch-scale0   as decimal   no-undo .
     2182   define variable v-base-rate     as decimal   no-undo .
     2183   define variable v-base-scale    as decimal   no-undo .
     2184   define variable v-exch-rate     as decimal   no-undo .
     2185   define variable v-exch-scale    as decimal   no-undo .
     2186   define variable v-host-code     as integer   no-undo .
     2187   define variable v-curr-abbr     as character no-undo .
     2188   define variable v-grp-name      as character no-undo .
     2189   define variable v-date-1        as date      no-undo .
     2190   define variable v-date-2        as date      no-undo .
     2191   define variable v-interv        as character no-undo .
     2192   define variable v-pay-name      as character no-undo .
     2193   define variable v-cli-oborot    as decimal   no-undo .
     2194   define variable v-trn-pay-code  as integer   no-undo .
     2195   define variable v-cash-pay-curr as integer   no-undo .
     2196   define variable v-cash-pay-code as integer   no-undo .
     2197   do
     2198   on error undo, return error return-value
     2199   :
     2200   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     2201   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     2202   if p-fact-order = ? then do:
     2203     run fact-order-mpl (
     2204         input   today       ,
     2205         input   p-obj-type  ,
     2206         input   p-obj-code  ,
     2207         output  p-fact-order ).
     2208   end.
     2209   if p-vid-pay <> "" then do:
     2210      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     2211      if available buf_pay-type
     2212         then v-trn-pay-code = buf_pay-type.obj-code.
     2213         else v-trn-pay-code =  0.
     2214   end.
     2215   else v-trn-pay-code = 0 .
     2216   if p-cash-pay-type <> "" then do:
     2217      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     2218      if available buf_pay-type
     2219         then
     2220           assign
     2221             v-cash-pay-curr = buf_cash-pay.curr-code
     2222             v-cash-pay-code = buf_cash-pay.cdpay-code
     2223           .
     2224         else
     2225           assign
     2226             v-cash-pay-curr = 0
     2227             v-cash-pay-code = 0
     2228             .
     2229   end.
     2230   else
     2231     assign
     2232       v-cash-pay-curr = 0
     2233       v-cash-pay-code = 0
     2234       .
     2235   for each tt_price-all  : delete tt_price-all . end.
     2236   assign
     2237     p-plt-id             = ?
     2238     p-plt-db-num         = ?
     2239     p-pdf-id             = ?
     2240     p-pdf-db-num         = ?
     2241     p-sale-price-base    = ?
     2242     p-sale-price-rubl    = ?
     2243     v-cli-oborot         = 0
     2244   .
     2245   find first buf_global-state no-lock no-error .
     2246   if not available buf_global-state then do:
     2247      message
     2248        "Не заданы параметры ценообразования!"
     2249        view-as alert-box error
     2250      .
     2251      return error return-value .
     2252   end.
     2253   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2255     (input  p-obj-type
     2256     ,input  p-obj-code
     2257     ,output to-day
     2258     )  .
     2259   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2261     (input  p-obj-type
     2262     ,input  p-obj-code
     2263     ,output v-host-code
     2264     )  .
     2265   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2267     (input  v-host-code
     2268     ,input  to-day
     2269     ,output v-base-rate0
     2270     ,output v-base-scale0
     2271     )  .
     2272     v-cli-oborot-ALL  = 0 .
     2273     for each buf_turnover-buyer-main no-lock  where
     2274              buf_turnover-buyer-main.cli-type = p-cli-type  and
     2275              buf_turnover-buyer-main.cli-code = p-cli-code
     2276              :
     2277              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     2278     end.
     2279   for each buf_price-all no-lock where
     2280            buf_price-all.obj-type = p-obj-type and
     2281            buf_price-all.obj-code = p-obj-code and
     2282            buf_price-all.gds-code = buf_goods.gds-code and
     2283            buf_price-all.status_  = 'акт':U  and
     2284          ( p-only-b-code = false   or
     2285          ( buf_price-all.b-code = p-main-b-code or
     2286            buf_price-all.b-code = p-b-code))    and
     2287           ( p-only-b-code = true  or
     2288             buf_price-all.b-code = p-b-code)
     2289             and
     2290             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2291           ( buf_price-all.fact-order-sys-to = ? or
     2292             buf_price-all.fact-order-sys-to    >= p-fact-order)
     2293           :
     2294            v-interv   = "" .
     2295            v-grp-name = "" .
     2296            v-pay-name = "" .
     2297            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     2298            if buf_price-all.bgr-id > 0 then do:
     2299               find first buf_buyer-group no-lock where
     2300                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     2301                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     2302               if available buf_buyer-group then do:
     2303                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2304                  find first buf_buyer-in-buyer-group no-lock where
     2305                             buf_buyer-in-buyer-group.stts         = 0 and
     2306                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     2307                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     2308                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     2309                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     2310                             no-error .
     2311                             if not available buf_buyer-in-buyer-group then do:
     2312                                v-grp-name = "".
     2313                                next.
     2314                             end.
     2315                             v-grp-name = buf_buyer-group.name .
     2316                  end.
     2317               end.
     2318               else do:
     2319                    v-grp-name = "".
     2320                    next.
     2321               end.
     2322            end.
     2323            if buf_price-all.tog-id > 0 then do:
     2324               find first buf_turnover-group no-lock where
     2325                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     2326                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     2327               if available buf_turnover-group then do:
     2328                  if p-cli-type <> "" and p-cli-type <> ? then do:
     2329                     v-cli-oborot = v-cli-oborot-all  .
     2330                     find first buf1_tnv-in-turnover-group no-lock where
     2331                                buf1_tnv-in-turnover-group.stts       =  0     and
     2332                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2333                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2334                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     2335                     find first buf2_tnv-in-turnover-group no-lock where
     2336                                buf2_tnv-in-turnover-group.stts       =  0     and
     2337                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     2338                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     2339                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     2340                     if not (available buf1_tnv-in-turnover-group and
     2341                             available buf2_tnv-in-turnover-group ) then do:
     2342                             v-grp-name = "".
     2343                             next .
     2344                     end.
     2345                     v-grp-name = buf_turnover-group.name.
     2346                  end.
     2347               end.
     2348               else do:
     2349                    v-grp-name = "".
     2350                    next.
     2351               end.
     2352            end.
     2353            if buf_price-all.plt-fix-cource-crc-base = true then
     2354               assign
     2355                 v-base-rate  = buf_price-all.pdf-base-rate
     2356                 v-base-scale = buf_price-all.pdf-base-scale
     2357               .
     2358               else
     2359               assign
     2360                 v-base-rate  = v-base-rate0
     2361                 v-base-scale = v-base-scale0
     2362               .
     2363            if buf_price-all.plt-fix-cource-crc-doc = true then
     2364               assign
     2365                 v-exch-rate  = buf_price-all.pdf-exch-rate
     2366                 v-exch-scale = buf_price-all.pdf-exch-scale
     2367               .
     2368               else do:
     2369   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2370   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2371     (input  buf_price-all.curr-code
     2372     ,input  to-day
     2373     ,output v-exch-rate0
     2374     ,output v-exch-scale0
     2375     ,output v-curr-abbr
     2376     )  .
     2377               assign
     2378                 v-exch-rate  = v-exch-rate0
     2379                 v-exch-scale = v-exch-scale0
     2380                 .
     2381              end.
     2382              v-date-1 = date ( "" )  .
     2383              if buf_price-all.fact-order-sys-from > 0 then do:
     2384                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     2385                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     2386                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     2387              end.
     2388              v-date-2 =  date ( "" )  .
     2389              if buf_price-all.fact-order-sys-to > 0 then do:
     2390                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     2391                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     2392                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     2393              end.
     2394              if buf_price-all.qnty-from <> ? then do :
     2395                 if not (
     2396                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     2397                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     2398                 ) then do:
     2399                        v-interv = "".
     2400                        next.
     2401                 end.
     2402                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     2403              end.
     2404              if buf_price-all.sum-from <> ? then do :
     2405                 if not (
     2406                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     2407                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     2408                 ) then do:
     2409                    v-interv = "".
     2410                    next.
     2411                 end.
     2412                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     2413              end.
     2414              if buf_price-all.turnover-from <> ? then do :
     2415                 if not (
     2416                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     2417                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     2418                 ) then do:
     2419                    v-interv = "".
     2420                    next.
     2421                 end.
     2422                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     2423              end.
     2424              if buf_price-all.use-pay-type = 1 then do :
     2425                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     2426                    v-pay-name = "" .
     2427                    next.
     2428                  end.
     2429                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     2430              end.
     2431              if buf_price-all.use-cash-pay = 1 then do :
     2432                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     2433                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     2434                   v-pay-name = "" .
     2435                   next.
     2436                 end.
     2437                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     2438              end.
     2439             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2440             create tt_price-all .
     2441             buffer-copy buf_price-all to tt_price-all
     2442             assign
     2443               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     2444               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     2445               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     2446               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     2447               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     2448               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     2449               tt_price-all.price-sale     = buf_price-all.price-sale
     2450               tt_price-all.road-tax       = buf_price-all.road-tax
     2451               tt_price-all.excise         = buf_price-all.excise
     2452               tt_price-all.pdf-exch-rate   = v-exch-rate
     2453               tt_price-all.pdf-exch-scale  = v-exch-scale
     2454               tt_price-all.pdf-base-rate   = v-base-rate
     2455               tt_price-all.pdf-base-scale  = v-base-scale
     2456               tt_price-all.grp-name        = v-grp-name
     2457               tt_price-all.date-1          = v-date-1
     2458               tt_price-all.shift-1         = buf_price-all.start-shift-num
     2459               tt_price-all.time-1          = buf_price-all.start-sys-time
     2460               tt_price-all.date-2          = v-date-2
     2461               tt_price-all.shift-2         = buf_price-all.end-shift-num
     2462               tt_price-all.time-2          = buf_price-all.end-sys-time
     2463               tt_price-all.interv-name     = v-interv
     2464               tt_price-all.pay-name        = v-pay-name
     2465               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     2466             .
     2467   end.
     2468   define variable vt-plt-id as integer   no-undo .
     2469   define variable vt-plt-db as integer   no-undo .
     2470   define variable vt-pdf-id as integer   no-undo .
     2471   define variable vt-pdf-db as integer   no-undo .
     2472   define buffer neos_price-all for tt_price-all  .
     2473   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     2474       if available tt_price-all then do:
     2475        assign
     2476          vt-plt-id = tt_price-all.plt-id
     2477          vt-plt-db = tt_price-all.plt-db-num
     2478          vt-pdf-id = tt_price-all.pdf-id
     2479          vt-pdf-db = tt_price-all.pdf-db
     2480        .
     2481        if tt_price-all.b-code = p-b-code then do:
     2482             assign
     2483               p-plt-id           = tt_price-all.plt-id
     2484               p-plt-db-num       = tt_price-all.plt-db-num
     2485               p-pdf-id           = tt_price-all.pdf-id
     2486               p-pdf-db-num       = tt_price-all.pdf-db
     2487               p-sale-price-base  = tt_price-all.price-sale-base
     2488               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2489               p-road-tax-base    = tt_price-all.road-tax-base
     2490               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2491               p-excise-base      = tt_price-all.excise-base
     2492               p-excise-rubl      = tt_price-all.excise-rubl
     2493               .
     2494        end.
     2495        else do:
     2496          find first neos_price-all where
     2497                     neos_price-all.b-code     = p-b-code  and
     2498                     neos_price-all.plt-id     = vt-plt-id and
     2499                     neos_price-all.plt-db-num = vt-plt-db and
     2500                     neos_price-all.pdf-id     = vt-pdf-id and
     2501                     neos_price-all.pdf-db     = vt-pdf-db
     2502                     use-index pi no-error .
     2503            if available neos_price-all then do:
     2504             assign
     2505               p-plt-id           = tt_price-all.plt-id
     2506               p-plt-db-num       = tt_price-all.plt-db-num
     2507               p-pdf-id           = tt_price-all.pdf-id
     2508               p-pdf-db-num       = tt_price-all.pdf-db
     2509               p-sale-price-base  = neos_price-all.price-sale-base
     2510               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     2511               p-road-tax-base    = neos_price-all.road-tax-base
     2512               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     2513               p-excise-base      = neos_price-all.excise-base
     2514               p-excise-rubl      = neos_price-all.excise-rubl
     2515               .
     2516            end.
     2517            else do:
     2518                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2519                 if error-status :error    then do:
     2520                   message "Не найден бар-код" p-b-code view-as alert-box error .
     2521                   return error return-value .
     2522                 end.
     2523             assign
     2524               p-plt-id           = tt_price-all.plt-id
     2525               p-plt-db-num       = tt_price-all.plt-db-num
     2526               p-pdf-id           = tt_price-all.pdf-id
     2527               p-pdf-db-num       = tt_price-all.pdf-db
     2528               p-sale-price-base  = tt_price-all.price-sale-base
     2529               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     2530               p-road-tax-base    = tt_price-all.road-tax-base
     2531               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     2532               p-excise-base      = tt_price-all.excise-base
     2533               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     2534               .
     2535            end.
     2536        end.
     2537     end.
     2538   end.
     2539   end procedure.
     2540   procedure mpl-tpl-auto :
     2541   define input  parameter p-b-code     as integer   no-undo .
     2542   define input  parameter p-obj-type   as character no-undo .
     2543   define input  parameter p-obj-code   as integer   no-undo .
     2544   define input  parameter p-plt-id     as integer   no-undo .
     2545   define input  parameter p-plt-db-num as integer   no-undo .
     2546   define input  parameter p-fact-order as decimal   no-undo .
     2547   define output parameter p-sale-price as decimal   no-undo .
     2548   define output parameter p-pdf-id     as integer   no-undo .
     2549   define output parameter p-pdf-db-num as integer   no-undo .
     2550     do
     2551     on error undo, return error return-value
     2552     :
     2553   if p-fact-order = ? then do:
     2554     run fact-order-mpl (
     2555         input   today       ,
     2556         input   p-obj-type  ,
     2557         input   p-obj-code  ,
     2558         output  p-fact-order ) .
     2559   end.
     2560   assign
     2561     p-pdf-id      = ?
     2562     p-pdf-db-num  = ?
     2563     p-sale-price  = ?
     2564   .
     2565   define buffer buf_bar-code for ub.bar-code  .
     2566   define buffer buf_goods for ub.goods  .
     2567   find first buf_bar-code no-lock where
     2568              buf_bar-code.b-code = p-b-code
     2569              no-error .
     2570   if error-status :error then return error return-value .
     2571   find first buf_goods no-lock where
     2572              buf_goods.gds-code = buf_bar-code.gds-code
     2573              no-error .
     2574   if error-status :error then return error return-value .
     2575   define variable v-main-b-code as integer   no-undo .
     2576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2577     (input  buf_goods.gds-code
     2578     ,input  ?
     2579     ,output v-main-b-code
     2580     )  .
     2581   define buffer buf_price-all for ub.price-all  .
     2582   for each tt_price-all : delete tt_price-all. end.
     2583       for each buf_price-all no-lock where
     2584               buf_price-all.plt-id     = p-plt-id                 and
     2585               buf_price-all.plt-db-num = p-plt-db-num             and
     2586               buf_price-all.obj-type   = p-obj-type               and
     2587               buf_price-all.obj-code   = p-obj-code               and
     2588               buf_price-all.gds-code   = buf_goods.gds-code       and
     2589             ( buf_price-all.b-code = v-main-b-code or
     2590               buf_price-all.b-code = p-b-code)    and
     2591               buf_price-all.status_    = 'акт':U         and
     2592               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     2593             ( buf_price-all.fact-order-sys-to = ? or
     2594               buf_price-all.fact-order-sys-to >=  p-fact-order)
     2595               :
     2596                 create tt_price-all .
     2597                 buffer-copy buf_price-all to tt_price-all
     2598                 assign
     2599                   tt_price-all.price-sale  = buf_price-all.price-sale
     2600                 .
     2601       end.
     2602   define variable vt-plt-id as integer   no-undo .
     2603   define variable vt-plt-db as integer   no-undo .
     2604   define variable vt-pdf-id as integer   no-undo .
     2605   define variable vt-pdf-db as integer   no-undo .
     2606   define buffer neos_price-all for tt_price-all  .
     2607   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     2608       if available tt_price-all then do:
     2609        assign
     2610          vt-plt-id = tt_price-all.plt-id
     2611          vt-plt-db = tt_price-all.plt-db-num
     2612          vt-pdf-id = tt_price-all.pdf-id
     2613          vt-pdf-db = tt_price-all.pdf-db
     2614        .
     2615        if tt_price-all.b-code = p-b-code then do:
     2616             assign
     2617               p-plt-id           = tt_price-all.plt-id
     2618               p-plt-db-num       = tt_price-all.plt-db-num
     2619               p-pdf-id           = tt_price-all.pdf-id
     2620               p-pdf-db-num       = tt_price-all.pdf-db
     2621               p-sale-price       = tt_price-all.price-sale
     2622               .
     2623        end.
     2624        else do:
     2625          find first neos_price-all where
     2626                     neos_price-all.b-code     = p-b-code  and
     2627                     neos_price-all.plt-id     = vt-plt-id and
     2628                     neos_price-all.plt-db-num = vt-plt-db and
     2629                     neos_price-all.pdf-id     = vt-pdf-id and
     2630                     neos_price-all.pdf-db     = vt-pdf-db
     2631                     use-index pi no-error .
     2632            if available neos_price-all then do:
     2633             assign
     2634               p-plt-id           = tt_price-all.plt-id
     2635               p-plt-db-num       = tt_price-all.plt-db-num
     2636               p-pdf-id           = tt_price-all.pdf-id
     2637               p-pdf-db-num       = tt_price-all.pdf-db
     2638               p-sale-price       = neos_price-all.price-sale
     2639               .
     2640            end.
     2641            else do:
     2642           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     2643           if error-status :error    then do:
     2644              message "Не найден бар-код" p-b-code view-as alert-box error .
     2645              return error return-value .
     2646           end.
     2647             assign
     2648               p-plt-id           = tt_price-all.plt-id
     2649               p-plt-db-num       = tt_price-all.plt-db-num
     2650               p-pdf-id           = tt_price-all.pdf-id
     2651               p-pdf-db-num       = tt_price-all.pdf-db
     2652               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     2653               .
     2654            end.
     2655        end.
     2656     end.
     2657     end.
     2658   end procedure.
     2659   define variable v-current-host-code as integer no-undo .
     2660   define variable v-current-obj-type as character no-undo .
     2661   define variable v-current-obj-code as integer no-undo .
     2662   define variable v-current-pos-type as character no-undo .
     2663   define variable v-current-pos-type-for-discnt as character no-undo .
     2664   define variable v-current-lock as integer no-undo .
     2665   define variable v-current-wait as integer no-undo .
     2666   define variable v-save as integer no-undo .
     2667   define variable v-view-log                   as logical        no-undo .
     2668   define variable v-stop                       as logical        no-undo .
     2669   define variable v-current-db-num as integer no-undo .
     2670   define variable v-last-error-message as character no-undo .
     2671   define variable v-codex-id as integer   no-undo .
     2672   define variable v-ruleset-id as integer   no-undo .
     2673   define variable v-caller as character no-undo .
     2674   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2675   procedure set-error :
     2676   define input parameter p-mess as character no-undo .
     2677     do
     2678     on error undo, return error
     2679     :
     2680        assign
     2681        v-last-error-message = p-mess.
     2682     end.
     2683   end procedure.
     2684   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     2685   define temp-table temp-rule-by-call no-undo like ub.rule-by-call.
     2686   define temp-table temp-discnt-role no-undo like ub.dis-cfg-rule
     2687   field codex_id as integer
     2688   field ruleset_id as integer
     2689   field order_id as integer
     2690   field rule_id as integer
     2691   field once-more as integer
     2692   index pi is unique
     2693   primary
     2694   codex_id
     2695   ruleset_id
     2696   order_id
     2697   rule_id
     2698   pos-type
     2699   discnt-role
     2700   subject-type
     2701   .
     2702   on delete of this-procedure do:
     2703   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     2704   define buffer buf_temp-rule-by-call for temp-rule-by-call.
     2705   define buffer buf_temp-discnt-role for temp-discnt-role.
     2706     for each buf_temp-rule-call-param:
     2707       delete buf_temp-rule-call-param.
     2708     end.
     2709     for each buf_temp-rule-by-call:
     2710       delete buf_temp-rule-by-call.
     2711     end.
     2712     for each buf_temp-discnt-role:
     2713       delete buf_temp-discnt-role.
     2714     end.
     2715   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   define buffer buf_temp-call-param for temp-call-param.
     2717   for each buf_temp-call-param where
     2718           buf_temp-call-param.param-num = 0:
     2719     delete object buf_temp-call-param.call-handle_.
     2720     delete buf_temp-call-param.
     2721   end.
     2722     run garbcoll_clear in this-procedure .
     2723   end.
     2724   run load-ruleset-context in this-procedure no-error.
     2725   if error-status:error then do:
     2726     undo, return error return-value .
     2727   end.
     2728   procedure rs_15_1 :
     2729   define input parameter p-caller as character no-undo .
     2730   define input parameter v-gline-num as integer   no-undo .
     2731   define input parameter v-b-code as integer   no-undo .
     2732   define input parameter v-gds-code as integer   no-undo .
     2733   define input parameter v-sum-grp-code as integer no-undo .
     2734   define input parameter v-node-code as integer no-undo .
     2735   define input parameter v-src-qnty as decimal no-undo .
     2736   define input parameter v-doc-qnty as decimal no-undo .
     2737   define input parameter v-start-src-price as decimal no-undo .
     2738   define input parameter v-src-price as decimal no-undo .
     2739   define input parameter v-start-src-discnt as decimal no-undo .
     2740   define input parameter v-src-discnt as decimal no-undo .
     2741   define input parameter v-unit-base as character no-undo .
     2742   define input parameter v-unit-base-type as character no-undo .
