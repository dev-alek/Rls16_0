     2140   procedure mpl-autoprice :
     2141   define input  parameter p-only-b-code as logical   no-undo .
     2142   define input  parameter p-cli-type    as character no-undo .
     2143   define input  parameter p-cli-code    as integer   no-undo .
     2144   define input  parameter p-main-b-code as integer   no-undo .
     2145   define input  parameter p-b-code      as integer   no-undo .
