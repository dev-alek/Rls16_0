     2450   define input  parameter v-prc-min        as decimal   no-undo .
     2451     do
     2452     on error undo, return error return-value
     2453     :
     2454       find first ub.contract-specif-attr exclusive-lock  where
     2455                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2456                 ub.contract-specif-attr.host-code    = p-host-code     and
     2457                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2458                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2459                 no-error .
