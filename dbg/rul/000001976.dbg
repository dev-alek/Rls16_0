     2461            create ub.contract-specif-attr .
     2462            assign
     2463                 ub.contract-specif-attr.contract-num = p-contract-num
     2464                 ub.contract-specif-attr.host-code    = p-host-code
     2465                 ub.contract-specif-attr.gds-code     = p-gds-code
     2466                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2467                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2468            .
     2469         end.
     2470         else do:
     2471            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2472         end.
     2473       find first ub.contract-specif exclusive-lock where
     2474           ub.contract-specif.contract-num = p-contract-num and
     2475           ub.contract-specif.host-code    = p-host-code    and
     2476           ub.contract-specif.gds-code     = p-gds-code.
     2477           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     2478   end.
