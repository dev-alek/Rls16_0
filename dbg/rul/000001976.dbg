     1883   define input  parameter  v-cntxt-obj-code as integer   no-undo .
     1884   define input  parameter  p-i-doc    as character no-undo .
     1885   define output parameter  p-ord-doc  as character no-undo .
     1886   define variable          v-idop     as character no-undo .
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890   case p-type :
     1891       when "main-no-ver" then do:
     1892         if  (v-cntxt-db-num <> 0) then
     1893           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1894         else
     1895           p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1896       end.
     1897       when "main" then do:
     1898             do while true:
     1899             if  (v-cntxt-db-num <> 0) then
     1900               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (v-cntxt-obj-code, ">>>>9")) + substring (v-cntxt-obj-type, (if g#language = "RUS" then 1 else 2), 1).
     1901             else
     1902               p-ord-doc = trim (string (next-value (s-ord-doc, ub), ">>>>>>>>>9")) + "-".
     1903             if not can-find (ub.ord-doc where ub.ord-doc.doc-code = p-ord-doc no-lock) then leave.
     1904             End.
     1905       end.
     1906       when "chip" then do:
     1907         assign
     1908           v-idop = p-i-doc .
     1909         do while true :
     1910           if index (v-idop , ".") = 0 then
     1911             v-idop  = replace (v-idop , "-", "-1.").
     1912           else
     1913             v-idop  =
     1914             substring (v-idop , 1, index (v-idop, "-")) +
     1915             string (integer (substring (v-idop, index (v-idop, "-") + 1, index (v-idop, ".") - index (v-idop, "-") - 1)) + 1) +
     1916             substring (v-idop, index (v-idop, ".")).
     1917           if not can-find (ub.ord-doc where ub.ord-doc.doc-code = v-idop no-lock) then leave.
     1918         end.
     1919         assign
     1920           p-ord-doc = v-idop.
     1921       end.
     1922   end case.
     1923     end.
     1924   end procedure.
     1925   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1926   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1927   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1928   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1929   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1930   procedure ordlineattr-value :
     1931     do
     1932     on error undo, return error return-value
     1933     :
     1934       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1935       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1936       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1937       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1938       define output parameter p-type     as character no-undo .
     1939       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1940       define variable v-format         as character no-undo .
     1941       define variable v-fillin_width   as integer   no-undo .
     1942       define variable v-fillin_height  as integer   no-undo .
     1943       define variable v-label          as character no-undo .
     1944       define variable v-user-can-edit  as logical   no-undo .
     1945       define variable v-output-display as logical   no-undo .
     1946       define variable v-other          as character no-undo .
     1947       define variable v-proc           as character no-undo .
     1948       define variable v-func           as character no-undo .
     1949       define variable v-sort           as integer   no-undo .
     1950       run ordlineattr-code in this-procedure
     1951         (input  p-code
     1952         ,output p-type
     1953         ,output v-format
     1954         ,output v-fillin_width
     1955         ,output v-fillin_height
     1956         ,output v-label
     1957         ,output v-user-can-edit
     1958         ,output v-output-display
     1959         ,output v-proc
     1960         ,output v-func
     1961         ,output v-sort
     1962         ,output v-other
     1963         ) no-error .
     1964       if error-status :error then do:
     1965         undo, return error return-value .
     1966       end.
     1967       find first buf_ord-line-attr no-lock
     1968         where buf_ord-line-attr.doc-code  = p-doc-code
     1969           and buf_ord-line-attr.gds-code  = p-gds-code
     1970           and buf_ord-line-attr.attr-code = p-code
     1971         no-error .
     1972       if avail buf_ord-line-attr then do:
     1973         assign
     1974           p-value =  buf_ord-line-attr.attr-value
     1975         .
     1976       end.
     1977       else do:
     1978         assign
     1979           p-value = if p-type = 'L':U then "no":U else ""
     1980         .
     1981       end.
     1982     end.
     1983   end procedure.
     1984   procedure ordlineattr-write :
     1985     do
     1986     on error undo, return error return-value
     1987     :
     1988       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     1989       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     1990       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     1991       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     1992       define buffer buf_ord-line-attr for ub.ord-line-attr .
     1993       define variable v-type           as character no-undo .
     1994       define variable v-format         as character no-undo .
     1995       define variable v-fillin_width   as integer   no-undo .
     1996       define variable v-fillin_height  as integer   no-undo .
     1997       define variable v-label          as character no-undo .
     1998       define variable v-user-can-edit  as logical   no-undo .
     1999       define variable v-output-display as logical   no-undo .
     2000       define variable v-other          as character no-undo .
     2001       define variable v-proc           as character no-undo .
     2002       define variable v-func           as character no-undo .
     2003       define variable v-sort           as integer   no-undo .
     2004       run ordlineattr-code in this-procedure
     2005         (input  p-code
     2006         ,output v-type
     2007         ,output v-format
     2008         ,output v-fillin_width
     2009         ,output v-fillin_height
     2010         ,output v-label
     2011         ,output v-user-can-edit
     2012         ,output v-output-display
     2013         ,output v-proc
     2014         ,output v-func
     2015         ,output v-sort
     2016         ,output v-other
     2017         ) no-error .
     2018       if error-status :error then do:
     2019         message
     2020           vss-workfile vss-revision vss-description skip
     2021           error-status :get-message(1) skip
     2022           return-value skip
     2023           ""
     2024           view-as alert-box error
     2025         .
     2026         undo, return error return-value .
     2027       end.
     2028       find first buf_ord-line-attr exclusive-lock
     2029         where buf_ord-line-attr.doc-code  = p-doc-code
     2030           and buf_ord-line-attr.gds-code  = p-gds-code
     2031           and buf_ord-line-attr.attr-code = p-code
     2032         no-error .
     2033       if not available buf_ord-line-attr then do:
     2034         create buf_ord-line-attr .
     2035         assign
     2036           buf_ord-line-attr.doc-code   = p-doc-code
     2037           buf_ord-line-attr.gds-code   = p-gds-code
     2038           buf_ord-line-attr.attr-code  = p-code
     2039         .
     2040       end.
     2041       assign
     2042         buf_ord-line-attr.attr-value = p-value
     2043       .
     2044   end.
     2045   end procedure.
     2046   procedure ordlineattr-exist :
     2047     do
     2048     on error undo, return error return-value
     2049     :
     2050       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2051       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2052       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2053       define output parameter p-exist   as logical  no-undo .
     2054       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2055       define variable v-type           as character no-undo .
     2056       define variable v-format         as character no-undo .
     2057       define variable v-fillin_width   as integer   no-undo .
     2058       define variable v-fillin_height  as integer   no-undo .
     2059       define variable v-label          as character no-undo .
     2060       define variable v-user-can-edit  as logical   no-undo .
     2061       define variable v-output-display as logical   no-undo .
     2062       define variable v-other          as character no-undo .
     2063       define variable v-proc           as character no-undo .
     2064       define variable v-func           as character no-undo .
     2065       define variable v-sort           as integer   no-undo .
     2066       run ordlineattr-code in this-procedure
     2067         (input  p-code
     2068         ,output v-type
     2069         ,output v-format
     2070         ,output v-fillin_width
     2071         ,output v-fillin_height
     2072         ,output v-label
     2073         ,output v-user-can-edit
     2074         ,output v-output-display
     2075         ,output v-proc
     2076         ,output v-func
     2077         ,output v-sort
     2078         ,output v-other
     2079         ) no-error .
     2080       if error-status :error then do:
     2081         undo, return error return-value .
     2082       end.
     2083       find first buf_ord-line-attr no-lock
     2084         where buf_ord-line-attr.doc-code  = p-doc-code
     2085           and buf_ord-line-attr.gds-code = p-gds-code
     2086           and buf_ord-line-attr.attr-code = p-code
     2087         no-error .
     2088       if  available buf_ord-line-attr then do:
     2089         p-exist = yes.
     2090       end.
     2091     end.
     2092   end procedure.
     2093   procedure ordlineattr-delete :
     2094     do
     2095     on error undo, return error return-value
     2096     :
     2097       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     2098       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     2099       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     2100       define output parameter p-deleted  as logical no-undo.
     2101       define buffer buf_ord-line-attr for ub.ord-line-attr .
     2102       define variable v-type           as character no-undo .
     2103       define variable v-format         as character no-undo .
     2104       define variable v-fillin_width   as integer   no-undo .
     2105       define variable v-fillin_height  as integer   no-undo .
     2106       define variable v-label          as character no-undo .
     2107       define variable v-user-can-edit  as logical   no-undo .
     2108       define variable v-output-display as logical   no-undo .
     2109       define variable v-proc           as character no-undo .
     2110       define variable v-func           as character no-undo .
     2111       define variable v-sort           as integer   no-undo .
     2112       define variable v-other          as character no-undo .
     2113       run ordlineattr-code in this-procedure
     2114         (input  p-code
     2115         ,output v-type
     2116         ,output v-format
     2117         ,output v-fillin_width
     2118         ,output v-fillin_height
     2119         ,output v-label
     2120         ,output v-user-can-edit
     2121         ,output v-output-display
     2122         ,output v-proc
     2123         ,output v-func
     2124         ,output v-sort
     2125         ,output v-other
     2126         ) no-error .
     2127       if error-status :error then do:
     2128         undo, return error return-value .
     2129       end.
     2130       find first buf_ord-line-attr exclusive-lock
     2131         where buf_ord-line-attr.doc-code  = p-doc-code
     2132           and buf_ord-line-attr.gds-code  = p-gds-code
     2133           and buf_ord-line-attr.attr-code = p-code
     2134         no-error NO-WAIT.
     2135       if not available buf_ord-line-attr then do:
     2136         p-deleted = no.
     2137       end.
     2138       else do:
     2139         delete buf_ord-line-attr.
     2140         p-deleted = yes.
     2141       end.
     2142     end.
     2143   end procedure.
     2144   procedure ordlineattr-code :
     2145     do on error undo, return error return-value
     2146     :
     2147       define input  parameter p-code           as character no-undo .
     2148       define output parameter p-type           as character no-undo .
     2149       define output parameter p-format         as character no-undo .
     2150       define output parameter p-fillin_width   as integer   no-undo .
     2151       define output parameter p-fillin_height  as integer   no-undo .
     2152       define output parameter p-label          as character no-undo .
     2153       define output parameter p-user-can-edit  as logical   no-undo .
     2154       define output parameter p-output-display as logical   no-undo .
     2155       define output parameter p-proc           as character no-undo .
     2156       define output parameter p-func           as character no-undo .
     2157       define output parameter p-sort           as integer   no-undo .
     2158       define output parameter p-other          as character no-undo .
     2159       case p-code :
     2160               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2161               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     2162         otherwise do:
     2163           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     2164         end.
     2165       end.
     2166     end.
     2167   end procedure.
     2168   FUNCTION cr-edist_get-mess-mean returns character ( input p-mess as character):
     2169   define variable v-ii as integer   no-undo .
     2170   define variable v-dop as character no-undo .
     2171   define variable v-dop1 as character no-undo .
     2172   define variable v-mess as character no-undo .
     2173   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2174     v-dop = entry(v-ii, p-mess, chr(4) ).
     2175     case entry(1, v-dop, "="):
     2176       when 'pack-num':U then do:
     2177         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2178       end.
     2179       when 'route':U then do:
     2180         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2181       end.
     2182       when 'ediiterchangeid':U then do:
     2183         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2184       end.
     2185       when 'price-up':U then do:
     2186         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2187       end.
     2188       when 'price-down':U then do:
     2189         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2190       end.
     2191       when 'vat-change':U then do:
     2192         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2193       end.
     2194       when 'ps':U then do:
     2195         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2196       end.
     2197       when 'info':U then do:
     2198         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2199       end.
     2200       when 'qnty-up':U then do:
     2201         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2202       end.
     2203       when 'qnty-down':U then do:
     2204         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2205       end.
     2206       when 'bstr-change':U then do:
     2207         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2208       end.
     2209       when 'shipdate-change':U then do:
     2210         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2211       end.
     2212       when 'clioutdoc-change':U then do:
     2213         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2214       end.
     2215     end case.
     2216     v-mess  = v-mess + (if v-mess = '' then '' else chr(32)) + v-dop1.
     2217   end.
     2218   return v-mess.
     2219   end function.
     2220   FUNCTION cr-edist_get-error-mean returns character ( input p-mess as character):
     2221   define variable v-ii as integer   no-undo .
     2222   define variable v-dop as character no-undo .
     2223   define variable v-dop1 as character no-undo .
     2224   define variable v-mess as character no-undo .
     2225   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2226     v-dop = entry(v-ii, p-mess, chr(4) ).
     2227     case entry(1, v-dop, "="):
     2228       when 'pack-num':U then do:
     2229         v-dop1 =  substitute("&1 &2", 'Пакет', entry(2, v-dop, "=")).
     2230       end.
     2231       when 'route':U then do:
     2232         v-dop1 =  substitute("&1 &2", 'Рут':U, entry(2, v-dop, "=")).
     2233       end.
     2234       when 'ediiterchangeid':U then do:
     2235         v-dop1 =  substitute("&1 &2", 'ediiterchangeid':U, entry(2, v-dop, "=")).
     2236       end.
     2237       when 'price-up':U then do:
     2238         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2239       end.
     2240       when 'price-down':U then do:
     2241         v-dop1 =  substitute("&1 &2", 'Цена':U, entry(2, v-dop, "=")).
     2242       end.
     2243       when 'vat-change':U then do:
     2244         v-dop1 =  substitute("&1 &2", 'НДС':U, entry(2, v-dop, "=")).
     2245       end.
     2246       when 'ps':U then do:
     2247         v-dop1 =  substitute("&1 &2", ' ':U, entry(2, v-dop, "=")).
     2248       end.
     2249       when 'info':U then do:
     2250         v-dop1 =  substitute("&1 &2", 'Инф:':U, entry(2, v-dop, "=")).
     2251       end.
     2252       when 'qnty-up':U then do:
     2253         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2254       end.
     2255       when 'qnty-down':U then do:
     2256         v-dop1 =  substitute("&1 &2", 'Кол-во':U, entry(2, v-dop, "=")).
     2257       end.
     2258       when 'bstr-change':U then do:
     2259         v-dop1 =  substitute("&1 &2", 'Штрихкод:':U, entry(2, v-dop, "=")).
     2260       end.
     2261       when 'shipdate-change':U then do:
     2262         v-dop1 =  substitute("&1 &2", 'Дата отгрузки:':U, entry(2, v-dop, "=")).
     2263       end.
     2264       when 'clioutdoc-change':U then do:
     2265         v-dop1 =  substitute("&1 &2", '№ заказа по пост-ку:':U, entry(2, v-dop, "=")).
     2266       end.
     2267     end case.
     2268     v-mess  = v-mess + (if v-mess = '' then '' else chr(4)) + v-dop1.
     2269   end.
     2270   return v-mess.
     2271   end function.
     2272   FUNCTION cr-edist_get-mess-key-value returns character ( input p-mess as character, input p-key as character):
     2273   define variable v-ii as integer   no-undo .
     2274   define variable v-dop as character no-undo .
     2275   define variable v-dop1 as character no-undo .
     2276   define variable v-value as character no-undo .
     2277   do v-ii = 1 to num-entries(p-mess, chr(4) ):
     2278     v-dop = entry(v-ii, p-mess, chr(4) ).
     2279     if entry(1, v-dop, "=") = p-key then do:
     2280       return entry(2, v-dop, "=").
     2281     end.
     2282   end.
     2283   return v-value.
     2284   end function.
     2285   FUNCTION cr-edist_add-edist-mess returns character ( input p-mess as character
     2286                                                        ,input p-key as character
     2287                                                        ,input p-value as character):
     2288   define variable v-dop as character no-undo .
     2289   define variable v-modificator as character no-undo .
     2290   assign
     2291   v-modificator = entry(2, p-key, "-") no-error .
     2292   case v-modificator:
     2293     when "up" then do:
     2294       v-dop = substitute("&1=&2<&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2295     end.
     2296     when "down" then do:
     2297       v-dop = substitute("&1=&2>&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2298     end.
     2299     when "change" then do:
     2300       v-dop = substitute("&1=&2 ->&3", p-key, entry(1, p-value, chr(4)) , entry(2, p-value, chr(4))).
     2301     end.
     2302     otherwise do:
     2303       v-dop = substitute("&1=&2", p-key, p-value).
     2304     end.
     2305   end case.
     2306   if p-mess = ''
     2307   or p-mess = ? then do:
     2308     return v-dop .
     2309   end.
     2310   else do:
     2311     return substitute("&1&2&3", p-mess, chr(4), v-dop).
     2312   end.
     2313   end function.
     2314   procedure create-edi-state :
     2315   define input  parameter p-tbl-name   as character no-undo .
     2316   define input  parameter p-doc-code   as character no-undo .
     2317   define input  parameter p-cli-type   as character no-undo .
     2318   define input  parameter p-cli-code   as integer   no-undo .
     2319   define input  parameter p-act        as character no-undo .
     2320   define input  parameter p-state      as character no-undo .
     2321   define input  parameter p-err        as integer   no-undo .
     2322   define input  parameter p-des        as character no-undo .
     2323   define input  parameter p-mess       as character no-undo .
     2324   define input  parameter p-dm         as integer  no-undo .
     2325   define input-output parameter p-date       as date no-undo .
     2326   define input-output parameter p-time       as integer no-undo .
     2327   define buffer buf_EDI-status for ub.EDI-status  .
     2328   define variable v-time as integer   no-undo .
     2329   define variable v-date as date   no-undo .
     2330   do
     2331   on error undo, return error return-value
     2332   :
     2333     if p-date = ? then do:
     2334       run cur-time in this-procedure ( output v-date, output v-time).
     2335     end.
     2336     else do:
     2337       assign
     2338       v-date = p-date
     2339       v-time = p-time
     2340       .
     2341     end.
     2342     find first buf_edi-status exclusive-lock where
     2343                 buf_edi-status.date-status = v-date
     2344             and buf_edi-status.time-status = v-time
     2345             and buf_edi-status.tbl-name    = p-tbl-name
     2346             and buf_edi-status.doc-code    = p-doc-code no-error .
     2347     if not available buf_edi-status  then do:
     2348       create buf_edi-status.
     2349     end.
     2350     assign
     2351     buf_edi-status.act         = p-act        .
     2352     buf_edi-status.cli-type    = p-cli-type   .
     2353     buf_edi-status.cli-code    = p-cli-code   .
     2354     buf_edi-status.des-err     = buf_edi-status.des-err + (if buf_edi-status.des-err = '' then '' else chr(4)) + p-des        .
     2355     buf_edi-status.doc-code    = p-doc-code   .
     2356     buf_edi-status.err-code    = p-err        .
     2357     buf_edi-status.mess-id     = buf_edi-status.mess-id + (if buf_edi-status.mess-id = '' then '' else chr(4)) + p-mess       .
     2358     buf_edi-status.state       = p-state      .
     2359     buf_edi-status.tbl-name    = p-tbl-name   .
     2360     buf_edi-status.date-status = v-date       .
     2361     buf_edi-status.time-status = v-time       .
     2362     buf_edi-status.whole-send-news = p-dm     .
     2363     buf_edi-status.user-name   = (if g#news then (chr(4) +  'СПН':U)
     2364                                       else (if g#esys
     2365                                             then (chr(4) +  'ВС':U)
     2366                                             else g#userid)
     2367                                       )       .
     2368     assign
     2369     p-date = buf_edi-status.date-status
     2370     p-time = buf_edi-status.time-status
     2371     .
     2372   end.
     2373   end procedure.
     2374   procedure update-edi-state-light :
     2375   define input  parameter p-tbl-name   as character no-undo .
     2376   define input  parameter p-doc-code   as character no-undo .
     2377   define input  parameter p-date-status as date no-undo .
     2378   define input  parameter p-time-status as integer no-undo .
     2379   define input  parameter p-state      as character no-undo .
     2380   define input  parameter p-err        as integer   no-undo .
     2381   define input  parameter p-des        as character no-undo .
     2382   define input  parameter p-mess       as character no-undo .
     2383   define buffer buf_edi-status for ub.edi-status.
     2384   do
     2385   on error undo, return error
     2386   :
     2387     find first buf_edi-status exclusive-lock where
     2388                 buf_edi-status.date-status = p-date-status
     2389             and buf_edi-status.time-status = p-time-status
     2390             and buf_edi-status.tbl-name    = p-tbl-name
     2391             and buf_edi-status.doc-code    = p-doc-code no-error .
     2392     if available buf_edi-status  then do:
     2393       assign
     2394       buf_edi-status.des-err     = p-des        .
     2395       buf_edi-status.err-code    = p-err        .
     2396       buf_edi-status.mess-id     = p-mess       .
     2397       buf_edi-status.state       = p-state      .
     2398     end.
     2399   end.
     2400   end procedure.
     2401   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2402   PROCEDURE write-bonus :
     2403   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2404   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2405   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2406   define input  parameter v-bonus as decimal   no-undo .
     2407     do
     2408     on error undo, return error return-value
     2409     :
     2410       find first ub.contract-specif-attr exclusive-lock  where
     2411                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2412                  ub.contract-specif-attr.host-code    = p-host-code     and
     2413                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2414                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2415                 no-error .
     2416         if not available ub.contract-specif-attr then do:
     2417            create ub.contract-specif-attr .
     2418            assign
     2419                 ub.contract-specif-attr.contract-num = p-contract-num
     2420                 ub.contract-specif-attr.host-code    = p-host-code
     2421                 ub.contract-specif-attr.gds-code     = p-gds-code
     2422                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2423            .
     2424         end.
     2425         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2426   end.
     2427   END PROCEDURE.
     2428   PROCEDURE read-bonus :
     2429   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2430   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2431   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2432   define output parameter v-bonus as decimal   no-undo .
     2433     do
     2434     on error undo, return error return-value
     2435     :
     2436   find first ub.contract-specif-attr no-lock  where
     2437              ub.contract-specif-attr.contract-num = p-contract-num  and
     2438              ub.contract-specif-attr.host-code    = p-host-code     and
     2439              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2440              ub.contract-specif-attr.attr-code    = 'bonus':U
     2441              no-error .
     2442      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2443                                           else  v-bonus = 0 .
     2444   end.
     2445   END PROCEDURE.
