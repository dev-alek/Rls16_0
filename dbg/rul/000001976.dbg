     3476   end.
     3477         end.
     3478         if p-ruleset-id = 2
     3479         or p-ruleset-id = 6 then do:
     3480   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3481   if v-view-log
     3482   and not g#news
     3483   and not g#auto
     3484   then do:
     3485     message
     3486     '!!!При маршрутизации произошли ошибки!!!'  skip
