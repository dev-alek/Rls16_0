     4022               IF  context_delete-command( input v-esys-cmd-proc-handle, input v-esys-cmd-code) = false  THEN do:
     4023                 undo _main, return error v-last-error-message .
     4024               end.
     4025             end.
     4026                       ExpData1:Route-data_clear-data ( ) .
     4027             next _stroka.
     4028           end.
     4029           else do:
     4030             create order-line.
     4031             assign
     4032             order-line.doc-code = buf_ord-doc.doc-code
     4033                 order-line.trn-code      = ord-list.trn-doc
     4034             order-line.cliart = buf_ord-line.cli-art
     4035             order-line.status_ = 0
     4036             order-line.desstatus = ""
     4037             order-line.artth =  buf_ord-line.artic
     4038             order-line.prod-type =  buf_ord-line.prod-type
     4039             order-line.prod-code =  buf_ord-line.prod-code
     4040             order-line.nameth =  buf_goods.gds-name
     4041             order-line.quantityquant =  buf_ord-line.cli-qnty
     4042             order-line.pricequant =  buf_ord-line.price-cli
     4043             .
     4044             ExpData1:route-data_create-record( INPUT "order-line") .
     4045             ExpData1:route-data_copy-record( INPUT "order-line", INPUT  (buffer order-line:handle) ) .
     4046               if p-ruleset-id = 2
     4047               or p-ruleset-id = 6
     4048               then do:
     4049               IF  ExpData1:esys-add-dump( INPUT "order-line", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4050                 undo _main, return error v-last-error-message .
     4051               end.
     4052             end.
     4053             release order-line.
     4054           end.
     4055         end.
     4056         end.
     4057         end.
     4058         else do:
     4059           define buffer buf_doc-line for ub.doc-line  .
     4060           for each buf_doc-line no-lock where
     4061                    buf_doc-line.doc-code = ord-list.doc-type
     4062           on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4063           on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4064           on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4065           :
     4066             find first buf_goods no-lock where
     4067                       buf_goods.artic     = buf_doc-line.artic     and
     4068                       buf_goods.prod-type = buf_doc-line.prod-type and
     4069                       buf_goods.prod-code = buf_doc-line.prod-code no-error.
     4070             if not available buf_goods then do:
     4071               undo _main, return error v-last-error-message .
     4072             end.
     4073             find first buf_ord-line no-lock where
     4074                       buf_ord-line.doc-code  = ord-list.doc-code      and
     4075                       buf_ord-line.artic     = buf_doc-line.artic     and
     4076                       buf_ord-line.prod-type = buf_doc-line.prod-type and
     4077                       buf_ord-line.prod-code = buf_doc-line.prod-code no-error.
     4078             if not available buf_ord-line then do:
     4079               undo _main, return error v-last-error-message .
     4080             end.
     4081             find first order-line where
     4082                        order-line.doc-code  = ord-list.doc-code
     4083                    and order-line.cliart    = buf_ord-line.cli-art
     4084                    no-error .
     4085             if available order-line then do:
     4086                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("В ПН &1 две строки с одинаковым артикулом поставщика &2: пропускаем ..."                                         , ord-list.doc-code                                         , buf_ord-line.cli-art                                         )).
     4087               assign v-view-log = yes.
     4088               if p-ruleset-id = 2
     4089               or p-ruleset-id = 6
     4090               then do:
     4091                 IF  context_delete-command( input v-esys-cmd-proc-handle, input v-esys-cmd-code) = false  THEN do:
     4092                   undo _main, return error v-last-error-message .
     4093                 end.
     4094               end.
     4095                           ExpData1:Route-data_clear-data ( ) .
     4096               next _stroka.
     4097             end.
     4098             else do:
     4099               create order-line.
     4100               assign
     4101               order-line.doc-code      = buf_ord-doc.doc-code
     4102               order-line.trn-code      = ord-list.trn-doc
     4103               order-line.cliart        = buf_ord-line.cli-art
     4104               order-line.status_       = 0
     4105               order-line.desstatus     = ""
     4106               order-line.artth         =  buf_ord-line.artic
     4107               order-line.prod-type     =  buf_ord-line.prod-type
     4108               order-line.prod-code     =  buf_ord-line.prod-code
     4109               order-line.nameth        =  buf_goods.gds-name
     4110               order-line.quantityquant =  buf_doc-line.fact-qnty / buf_doc-line.cli-base-rate
     4111               order-line.pricequant    =  buf_doc-line.price-cli
     4112               .
     4113               ExpData1:route-data_create-record( INPUT "order-line") .
     4114               ExpData1:route-data_copy-record( INPUT "order-line", INPUT  (buffer order-line:handle) ) .
     4115               if p-ruleset-id = 2
     4116               or p-ruleset-id = 6
     4117               then do:
     4118                 IF  ExpData1:esys-add-dump( INPUT "order-line", INPUT v-esys-cmd-proc-handle, INPUT v-esys-cmd-code, '+update') = false  THEN do:
     4119                   undo _main, return error v-last-error-message .
     4120                 end.
     4121               end.
     4122               release order-line.
     4123             end.
     4124           end.
     4125         end.
     4126         for each order-line:
     4127           delete order-line.
     4128         end.
     4129         run edocsord_export in this-procedure ( buffer buf_ord-doc
     4130                                                ,input ord-list.trn-doc
     4131                                                ,input ord-list.ord-int1
     4132                                               ) no-error.
     4133         if p-ruleset-id = 2
     4134         or p-ruleset-id = 6
     4135         then do:
     4136           if temp-esys.delivery-method = integer('1':U) then do:
     4137           IF  context_set-custom-esys-pck-name(  input v-esys-cmd-proc-handle, input v-esys-cmd-code, input v-custom-pack-name) = false  THEN do:
     4138             undo _main, return error v-last-error-message .
     4139           end.
     4140           end.
     4141           IF  context_send-esys-command( input string(temp-esys.esys-id), input v-esys-cmd-proc-handle, input v-esys-cmd-code, input g#userid) = false  THEN do:
     4142             undo _main, return error v-last-error-message .
     4143           end.
     4144           if ord-list.sel-order = 1 then delete ord-list.
     4145         end.
     4146         if p-ruleset-id = 1
     4147         or p-ruleset-id = 5
     4148         then do:
     4149           if not ExpData1:set-esys( temp-esys.esys-id, temp-esys.esys-name) then do:
     4150             undo _main, return error .
     4151           end.
     4152           if temp-esys.delivery-method = integer('2':U) then do:
     4153             if not ExpData1:set-pack-num( v-pack-num) then do:
     4154               undo _main, return error .
     4155             end.
     4156           end.
     4157           if not ExpData1:write-xml(v-exchange-dir + chr(47) + v-loc-file-name, 1) then do:
     4158             undo _main, return error .
     4159           end.
     4160           assign
     4161           v-parameter = temp-esys.ftp-ip + chr(4) +
     4162                         temp-esys.ftp-login + chr(4) +
     4163                         temp-esys.ftp-password + chr(4) +
     4164                         string(0)  + chr(4) +
     4165                         (if temp-esys.ftp-path <> ''
     4166                         then (trim (trim (trim(temp-esys.ftp-path
     4167                                         , chr(92))
     4168                                    ,chr(47))
     4169                               ,chr(92)) + chr(47))
     4170                         else '') +
     4171                         "out" + chr(47) + v-loc-file-name  + chr(4) +
     4172                         v-exchange-dir + chr(47) + v-loc-file-name + chr(4) +
     4173                         string(no) + chr(4) +
     4174                         "process-edoc.txt"
     4175           .
     4176           run gbl/ftp-put.p ( input parparentproc
     4177                             ,input this-procedure:handle
     4178                             ,input p-log-handle
     4179                             ,input v-parameter ) no-error.
     4180           if error-status:error then do:
     4181                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при передаче файла заказа &1 по FTP"                                       , v-loc-file-name  )).
     4182              assign v-view-log = yes.
     4183              v-err = yes.
     4184              undo _stroka, next _stroka.
     4185           end.
     4186           else do:
     4187             run cur-time in this-procedure ( output v-today, output v-time).
     4188   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4189   create buf_esys-pck-sent.
     4190   assign
     4191   buf_esys-pck-sent.esps-CreDate        = v-today
     4192   buf_esys-pck-sent.esps-CreTimeInt     = v-time
     4193   buf_esys-pck-sent.esps-CreTime        = string( v-time, "HH:MM:SS" )
     4194   buf_esys-pck-sent.esys-id             = temp-esys.esys-id
     4195   buf_esys-pck-sent.db-num              = temp-esys.db-num
     4196   buf_esys-pck-sent.esps-cr-db-num      = g#db-num
     4197   buf_esys-pck-sent.esps-pack-num       = v-pack-num
     4198   buf_esys-pck-sent.esps-rcvd           = no
     4199   buf_esys-pck-sent.esps-total-recs     = ?
     4200   buf_esys-pck-sent.esps-CreNum         = 0
     4201   buf_esys-pck-sent.esps-SendTxtDate    = ?
     4202   buf_esys-pck-sent.esps-SendTxtTimeInt = 0
     4203   buf_esys-pck-sent.esps-SendTxtTime    = "":U
     4204   buf_esys-pck-sent.esps-rcvdDate       = ?
     4205   buf_esys-pck-sent.esps-RcvdTimeInt    = 0
     4206   buf_esys-pck-sent.esps-RcvdTime       = "":U
     4207   buf_esys-pck-sent.esps-CRC-pack       = substitute( "&1 &2 &3 &4", today, time, etime, DBTASKID( "ub":U ) )
     4208   .
     4209             assign
     4210             buf_esys-pck-sent.esps-rcvd = yes
     4211             buf_esys-pck-sent.esps-total-recs = 2
     4212             buf_esys-pck-sent.esps-CreNum         = 1
     4213             buf_esys-pck-sent.esps-SendTxtDate    = v-today
     4214             buf_esys-pck-sent.esps-SendTxtTimeInt = v-time
     4215             buf_esys-pck-sent.esps-SendTxtTime    = string( v-time, "HH:MM:SS" )
     4216             buf_esys-pck-sent.esps-rcvdDate       = v-today
     4217             buf_esys-pck-sent.esps-RcvdTimeInt    = v-time
     4218             buf_esys-pck-sent.esps-RcvdTime       = string( v-time, "HH:MM:SS" )
     4219             .
     4220             run bge/sxg-pack.p (
     4221                            input parparentproc
     4222                           ,input this-procedure:handle
     4223                           ,input p-log-handle
     4224                           ,input "fput":U
     4225                           ,input false
     4226                           ,input v-loc-file-name
     4227                           ,input v-exchange-dir
     4228                           ,input v-heap-dir
     4229                           ,input v-temp-dir
     4230                           ,input 0
     4231                           ,input temp-esys.esys-id
     4232                           ,input temp-esys.db-num
     4233                           ,input g#db-num
     4234                           ,input temp-esys.delivery-method
     4235                           ) no-error.
     4236             if error-status :error then do:
     4237                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при перемещении файла заказа &1 из директории обмена &2 в архивную директорию &3"                                         , v-loc-file-name                                         , v-exchange-dir                                         , v-heap-dir                                         )).
     4238               assign v-view-log = yes.
     4239               v-err = yes.
     4240               next _stroka.
     4241             end.
     4242             run gbl/del-file.p ( input v-temp-dir ) no-error .
     4243             if error-status :error then do:
     4244                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при удалении временной директории &1"                                         , v-temp-dir                                         )).
     4245               assign v-view-log = yes.
     4246               v-err = yes.
     4247               next _stroka.
     4248             end.
     4249             run gbl/del-file.p ( input v-exchange-dir + chr(47) + v-loc-file-name ) no-error .
     4250             if error-status :error then do:
     4251                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при удалении файла в директории обмена &1"                                         , v-exchange-dir + chr(47) + v-loc-file-name                                         )).
     4252               assign v-view-log = yes.
     4253               v-err = yes.
     4254               next _stroka.
     4255             end.
     4256           end.
     4257         end.
     4258               ExpData1:Route-data_clear-data ( ) .
     4259       end.
     4260       num-rec-ok = num-rec-ok + 1.
     4261       run write-counter in p-log-handle ( input substitute("Обработано заказов списка экспорта: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4262       run get-stop-state in p-log-handle ( output v-stop) no-error .
     4263       if v-stop then do:
     4264           run write-log-and-file in p-log-handle (
     4265                                                   input 1
     4266                                                 , input log-file-name
     4267                                                 , input 1
     4268                                                 , input substitute("Процесс прерван пользователем")).
     4269           leave _stroka.
     4270       end.
     4271     end.
     4272     ExpData1:route-data_clear-xmlschema ( ).
     4273     run write-log-and-file in p-log-handle (
     4274           input 1
     4275         , input log-file-name
     4276         , input 1
     4277         , input substitute("Обработано заказов списка экспорта: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4278   end.
     4279   end procedure.
     4280   procedure load-ruleset-context :
     4281   define input parameter p-ruleset-id as integer no-undo .
     4282   define buffer buf_rule-call-param for ub.rule-call-param.
     4283     do
     4284     on error undo, return error
     4285     :
     4286     find first buf_rule-call-param no-lock where
     4287   buf_rule-call-param.codex_id = p-codex-id
     4288   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4289   and buf_rule-call-param.call_id = p-call-id
     4290   and buf_rule-call-param.order_id = p-order-id
     4291   and buf_rule-call-param.rule_id = p-rule-id
     4292   and buf_rule-call-param.param-name = "p-xsd-file"
     4293    no-error.
     4294   if available buf_rule-call-param then do:
     4295   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4296   end.
     4297       case p-ruleset-id:
     4298         when 1
     4299         or
     4300         when 5
     4301         then do:
     4302           assign
     4303           v-sign = 2
     4304           v-current-host-code = p-host-code
     4305           v-current-obj-type = p-obj-type
     4306           v-current-obj-code = p-obj-code
     4307           v-current-db-num = g#db-num
     4308           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4309           file-name  = p-process-file-name
     4310           .
     4311           run bge/oxmlinir.p ( output v-oxml-exch-dir
     4312                               ,output v-oxml-heap-dir) .
     4313         end.
     4314         when 2
     4315         or
     4316         when 6
     4317         then do:
     4318           assign
     4319           v-sign = 2
     4320           v-current-host-code = p-host-code
     4321           v-current-obj-type = p-obj-type
     4322           v-current-obj-code = p-obj-code
     4323           v-current-db-num = g#db-num
     4324           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4325           file-name  = p-process-file-name
     4326           .
     4327         end.
     4328       end case.
     4329     end.
     4330   end procedure.
