     3458     view-as alert-box error .
     3459        define variable v-user-action32   as character no-undo .
     3460     define variable v-printed32       as logical   no-undo .
     3461     run gbl/prnfilen.w
     3462       (input  ('!!!При экспорте произошли ошибки!!!')
     3463       ,input  0
     3464       ,input  (string("./":U) + log-file-name)
     3465       ,input  7
     3466       ,output v-user-action32
     3467       ,output v-printed32
     3468       ) .
