     1610   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611   FUNCTION rum-fn_get-next-file-name returns character (
     1612                                       input p-base-file-name as character
     1613                                     , input p-index as integer):
     1614   define variable v-loc-file-name as character no-undo .
     1615   v-loc-file-name = substitute("&1_&2.&3"
     1616                               ,substring(p-base-file-name, 1, (if r-index(p-base-file-name, ".") > 1
     1617                                                         then (r-index(p-base-file-name, ".") - 1)
     1618                                                         else length(p-base-file-name)
     1619                                                         )
     1620                                           )
     1621                               ,p-index
     1622                               ,(if r-index(p-base-file-name, ".") > 1
     1623                                 then substring(p-base-file-name, r-index(p-base-file-name, ".") + 1)
     1624                                 else '')
     1625                                 )
     1626                                 .
     1627   return v-loc-file-name.
     1628   end function.
     1629   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1630   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1631   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1632   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   function context_get-thobj-es return logical
     1634   (
     1635      input p-esys-id as integer
     1636     ,input p-eobj-type as character
     1637     ,input p-eobj-code as integer
     1638     ,output p-obj-type as character
     1639     ,output p-obj-code as integer
     1640   ):
     1641      define variable v-value-list as character no-undo .
     1642      define variable v-field-list as character no-undo .
     1643      define buffer buf_clients for ub.clients.
     1644      define buffer buf_ext-classif for ub.ext-classif.
     1645      find first buf_ext-classif no-lock where
     1646                buf_ext-classif.classif-name = 'clients-esys':U
     1647            and buf_ext-classif.classif-subject = 'clients':U
     1648            and buf_ext-classif.db-num = 0
     1649            and buf_Ext-classif.key#_one = p-esys-id
     1650            and buf_Ext-classif.charkey_one = p-eobj-type
     1651            and buf_Ext-classif.key#_two = p-eobj-code no-error .
     1652      if available buf_Ext-classif
     1653      then do:
     1654         ObjSrv:Lib:KeyRec:GenKeyFv (
     1655                                         input buf_Ext-classif.uniq-key-rec
     1656                                         ,output v-field-list
     1657                                         ,output v-value-list).
     1658         assign
     1659            p-obj-type = entry(lookup("obj-type":U
     1660                                     , v-field-list
     1661                                     , chr(3))
     1662                                     , v-value-list, chr(3))
     1663            p-obj-code = integer(entry(lookup("obj-code":U
     1664                                            , v-field-list
     1665                                            , chr(3))
     1666                                      , v-value-list
     1667                                      , chr(3)))
     1668         no-error .
     1669      end.
     1670      if     available buf_ext-classif
     1671         and (p-obj-type = 'маг':U
     1672              or
     1673              p-obj-type = 'скл':U
     1674              )
     1675         and (p-obj-code > 0 and p-obj-code <= 99999)
     1676      then do:
     1677         find first buf_clients no-lock where
     1678                    buf_clients.obj-type = p-obj-type
     1679                and buf_clients.obj-code = p-obj-code no-error.
     1680         if available buf_clients then do:
     1681            return yes.
     1682         end.
     1683         else do:
     1684            assign
     1685               p-obj-type = '':U
     1686               p-obj-code = 0
     1687            .
     1688            return no.
     1689         end.
     1690      end.
     1691      else do:
     1692         assign
     1693            p-obj-type = '':U
     1694            p-obj-code = 0
     1695         .
     1696         return no.
     1697      end.
     1698   end.
