     3434   end.
     3435   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     3436   if error-status:error then do:
     3437     undo, return error return-value .
     3438   end.
     3439   define variable ExpData1 as class Route-data_ no-undo .
