     3488     view-as alert-box error .
     3489        define variable v-user-action34   as character no-undo .
     3490     define variable v-printed34       as logical   no-undo .
     3491     run gbl/prnfilen.w
     3492       (input  ('!!!При маршрутизации произошли ошибки!!!')
     3493       ,input  0
     3494       ,input  (string("./":U) + log-file-name)
     3495       ,input  7
     3496       ,output v-user-action34
     3497       ,output v-printed34
     3498       ) .
     3499   end.
     3500   if v-view-log = true
     3501   and (g#news
     3502   or g#auto)
     3503   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     3504   then do:
     3505      run cb_set-view-log in p-parent-handle ( input yes).
     3506   end.
     3507         end.
     3508     if v-es then do:
     3509         run garbcoll_clear in this-procedure .
     3510         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     3511     end.
     3512     run garbcoll_clear in this-procedure .
     3513   end.
     3514   procedure proc-main :
     3515   _main:
     3516   do
     3517   on error undo, return error substitute( "&1&2&3&2&4", return-value, chr(10), error-status :get-message (1), v-last-error-message)
     3518   :
     3519     define variable v-ii as integer no-undo .
     3520     define variable v-loc-file-name as character no-undo .
     3521     define variable v-pck-num-rec as integer no-undo init 1000.
     3522     define variable v-uniq-key-rec as character no-undo .
     3523     define variable v-cli-uniq-key-rec as character no-undo .
     3524     define variable v-ext-obj-code as integer no-undo .
     3525     define variable v-err as logical no-undo .
     3526     define variable v-custom-pack-name as character no-undo .
     3527     define variable v-success as logical   no-undo .
     3528     define variable v-pack-num as integer   no-undo .
     3529     define variable v-heap-dir as character no-undo .
     3530     define variable v-exchange-dir as character no-undo .
     3531     define variable v-temp-dir as character no-undo .
     3532     define variable v-log-file-name as character no-undo .
     3533     define variable v-list-file-name as character no-undo .
     3534     define variable v-custom-pack-flag as logical   no-undo .
     3535     define variable v-parameter as character no-undo .
     3536     DEFINE VARIABLE v-today as date no-undo .
     3537     DEFINE VARIABLE v-time as integer no-undo .
     3538     define variable v-ord-int1 as integer no-undo .
     3539     define variable v-found-rcv as logical no-undo .
     3540     define buffer buf_ext-system for ub.ext-system.
     3541     define buffer buf_ord-doc for ub.ord-doc.
     3542     define buffer buf_ord-line for ub.ord-line.
     3543     define buffer buf_object for ub.clients.
     3544     define buffer buf_clients for ub.clients.
     3545     define buffer buf_ext-classif for ub.ext-classif.
     3546     define buffer esys_ext-classif for ub.ext-classif.
     3547     define buffer buf_goods for ub.goods.
     3548     define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     3549     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     3550     define buffer buf_ord-list for ord-list.
     3551     define buffer buf_contract for ub.contract.
     3552     for each order-header:
     3553       delete  order-header.
     3554     end.
     3555     for each order-line:
     3556       delete  order-line.
     3557     end.
     3558     if p-ruleset-id = 1
     3559     or p-ruleset-id = 5
     3560     then do:
     3561       run write-log  in p-log-handle (
     3562                                       input 0
     3563                                     , "&DLine").
     3564           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Экспорт заказов в XML для передачи поставщику")).
     3565     end.
     3566     if p-ruleset-id = 2
     3567     or p-ruleset-id = 6
     3568     then do:
     3569       run write-log  in p-log-handle (
     3570                                       input 0
     3571                                     , "&DLine").
     3572           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Маршрутизация заказов поставщику")).
     3573     end.
     3574     for each ord-list:
     3575       if ord-list.is-trn-doc = no
     3576       and ord-list.sel-order = 0
     3577       then do:
     3578         if ord-list.ord-int1 = int('7':U) then do:
     3579           if ord-list.trn-doc = '' then do:
     3580             v-found-rcv = no.
     3581             for each  buf_ord-doc-rcv no-lock where
     3582                     buf_ord-doc-rcv.doc-code = ord-list.doc-code
     3583                 and buf_ord-doc-rcv.ord-int1 = integer('7':U):
     3584               find first buf_ord-list where
     3585                         buf_ord-list.doc-code = ord-list.doc-code
     3586                     and  buf_ord-list.doc-type = ord-list.doc-type
     3587                     and  buf_ord-list.trn-doc = entry(1, buf_ord-doc-rcv.sub-par, chr(4)) no-error .
     3588               if not available buf_ord-list then do:
     3589                 create buf_ord-list.
     3590                 buffer-copy ord-list to buf_ord-list
     3591                 assign
     3592                 buf_ord-list.trn-doc = entry(1, buf_ord-doc-rcv.sub-par, chr(4) )
     3593                 buf_ord-list.ord-int1 = integer('8':U)
     3594                 v-found-rcv = yes
     3595                 .
     3596                 release buf_ord-list.
     3597               end.
     3598             end.
     3599             if v-found-rcv then do:
     3600               delete ord-list.
     3601             end.
     3602             else do:
     3603               assign
     3604               ord-list.ord-int1 = integer('8':U)
     3605               .
     3606               release ord-list.
     3607             end.
     3608           end.
     3609         end.
     3610       end.
     3611      end.
     3612     _stroka:
     3613     for each ord-list
     3614     break
     3615     by ord-list.host-code
     3616     by ord-list.cli-type
     3617     by ord-list.cli-code
     3618     by ord-list.obj-type
     3619     by ord-list.obj-code
     3620     by ord-list.doc-code
     3621     by ord-list.trn-doc
     3622     On error undo _stroka, next _stroka
     3623     :
     3624       assign
     3625       v-current-doc-code = ord-list.doc-code
     3626       num-rec = num-rec + 1
     3627       .
     3628           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Обработка заказа &1 &2", ord-list.doc-code , ord-list.trn-doc)).
     3629       if v-err then next.
     3630       IF num-rec = 1
     3631       THEN do:
     3632         IF  ExpData1:route-data_read-xmlschema( INPUT p-xsd-file) = false  THEN do:
     3633           undo _main, return error v-last-error-message .
     3634         end.
     3635       end.
     3636       if first-of(ord-list.cli-code) then do:
     3637         for each order-header:
     3638           delete  order-header.
     3639         end.
     3640         for each order-line:
     3641           delete  order-line.
     3642         end.
     3643         v-err = no.
     3644         find first buf_clients no-lock where
