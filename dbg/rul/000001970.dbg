     3665   procedure xmlchar-test :
     3666   define input parameter p-in-string          as character        no-undo.
     3667   define output parameter p-out-string-enc    as character        no-undo.
     3668   define output parameter p-out-string-dec    as character        no-undo.
     3669   do
     3670   on error undo, return error
     3671   :
     3672          run xmlchar-encode in this-procedure
     3673       (
     3674             input p-in-string
     3675           , output p-out-string-enc
     3676       ).
     3677          run xmlchar-decode in this-procedure
     3678       (
     3679             input p-out-string-enc
     3680           , output p-out-string-dec
     3681       ).
     3682   end.
     3683   end .
     3684   procedure xmlchar-encode :
     3685   define input parameter p-in-string      as character        no-undo.
     3686   define output parameter p-out-string    as character        no-undo.
     3687       define variable v-position      as integer      no-undo.
     3688       define variable v-current-char  as character    no-undo.
     3689   do
     3690   on error undo, return error
     3691   :
     3692       assign
     3693           p-out-string = "":U
     3694       .
     3695       case p-in-string
     3696       :
     3697           when ?
     3698           then do:
     3699               assign
     3700                   p-out-string = "?":U
     3701               .
     3702           end.
     3703           when "?":U
     3704           then do:
     3705               assign
     3706                   p-out-string = "&#63;":U
     3707               .
     3708           end.
     3709           otherwise do:
     3710               do v-position = 1 to length( p-in-string )
     3711               :
     3712                   assign
     3713                       v-current-char = substring( p-in-string, v-position, 1 )
     3714                   .
     3715                   case v-current-char
     3716                   :
     3717                       when "&":U
     3718                       then do:
     3719                           assign
     3720                               p-out-string = p-out-string + "&amp;":U
     3721                           .
     3722                       end.
     3723                       when ">":U
     3724                       then do:
     3725                           assign
     3726                               p-out-string = p-out-string + "&gt;":U
     3727                           .
     3728                       end.
     3729                       when "<":U
     3730                       then do:
     3731                           assign
     3732                               p-out-string = p-out-string + "&lt;":U
     3733                           .
     3734                       end.
     3735                       when "'":U
     3736                       then do:
     3737                           assign
     3738                               p-out-string = p-out-string + "&apos;":U
     3739                           .
     3740                       end.
     3741                       when '"':U
     3742                       then do:
     3743                           assign
     3744                               p-out-string = p-out-string + "&quot;":U
     3745                           .
     3746                       end.
     3747                       when chr(1)
     3748                       then do:
     3749                           assign
     3750                               p-out-string = p-out-string + "":U
     3751                           .
     3752                       end.
     3753                       when chr(2)
     3754                       then do:
     3755                           assign
     3756                               p-out-string = p-out-string + "":U
     3757                           .
     3758                       end.
     3759                       when chr(3)
     3760                       then do:
     3761                           assign
     3762                               p-out-string = p-out-string + "":U
     3763                           .
     3764                       end.
     3765                       when chr(4)
     3766                       then do:
     3767                           assign
     3768                               p-out-string = p-out-string + "":U
     3769                           .
     3770                       end.
     3771                       when chr(5)
     3772                       then do:
     3773                           assign
     3774                               p-out-string = p-out-string + "":U
     3775                           .
     3776                       end.
     3777                       when chr(6)
     3778                       then do:
     3779                           assign
     3780                               p-out-string = p-out-string + "":U
     3781                           .
     3782                       end.
     3783                       when chr(7)
     3784                       then do:
     3785                           assign
     3786                               p-out-string = p-out-string + "":U
     3787                           .
     3788                       end.
     3789                       when chr(8)
     3790                       then do:
     3791                           assign
     3792                               p-out-string = p-out-string + "":U
     3793                           .
     3794                       end.
     3795                       when chr(9)
     3796                       then do:
     3797                           assign
     3798                               p-out-string = p-out-string + "":U
     3799                           .
     3800                       end.
     3801                       when chr(29)
     3802                       then do:
     3803                           assign
     3804                               p-out-string = p-out-string + "":U
     3805                           .
     3806                       end.
     3807                       when chr(10)
     3808                       then do:
     3809                           assign
     3810                               p-out-string = p-out-string + "&#10;":U
     3811                           .
     3812                       end.
     3813                       when chr(13)
     3814                       then do:
     3815                           assign
     3816                               p-out-string = p-out-string + "&#13;":U
     3817                           .
     3818                       end.
     3819                       otherwise do:
     3820                           assign
     3821                               p-out-string = p-out-string + v-current-char
     3822                           .
     3823                       end.
     3824                   end case.
     3825               end.
     3826           end.
     3827       end case.
     3828   end.
     3829   end .
     3830   procedure xmlchar-encode-1c :
