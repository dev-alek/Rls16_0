     3558   procedure xmllib-parse-rec-open :
     3559   define input parameter p-rec-name   as character        no-undo.
     3560   define input parameter p-rec-level  as integer          no-undo.
     3561       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3562   do
     3563   for buf_temp_xmllib_rec
     3564   on error undo, return error
     3565   :
     3566        find first buf_temp_xmllib_rec
     3567            where buf_temp_xmllib_rec.recName = p-rec-name
     3568              and buf_temp_xmllib_rec.recLevel = p-rec-level
     3569              and buf_temp_xmllib_rec.closed  = no
     3570       use-index nm
     3571       no-error.
     3572       if available buf_temp_xmllib_rec
     3573       then do:
     3574           run xmllib-parse-error in this-procedure (
     3575               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     3576                               , p-rec-name
     3577                               , p-rec-level
     3578                               , buf_temp_xmllib_rec.recOpenLine
     3579                               )
     3580           ).
     3581       end.
     3582       else do:
     3583           assign
     3584               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     3585           .
     3586           create buf_temp_xmllib_rec.
     3587           assign
     3588               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     3589               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3590               buf_temp_xmllib_rec.recCloseLine    = 0
     3591               buf_temp_xmllib_rec.recName         = p-rec-name
     3592               buf_temp_xmllib_rec.recLevel        = p-rec-level
     3593               buf_temp_xmllib_rec.closed          = no
     3594           .
     3595       end.
     3596   end.
     3597   end procedure.
     3598   procedure xmllib-parse-rec-fld-open :
     3599   define input parameter p-rec-name   as character        no-undo.
     3600   define input parameter p-rec-level  as integer          no-undo.
     3601   define input parameter p-fld-name   as character        no-undo.
     3602       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3603       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     3604   do
     3605   for buf_temp_xmllib_rec
     3606     , buf_temp_xmllib_rec-fld
     3607   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     3608                                           , return-value
     3609                                           , trim( error-status :get-message( 1 ) )
     3610                                           , trim( error-status :get-message( 2 ) ) )
     3611   :
     3612       find last buf_temp_xmllib_rec
     3613           where buf_temp_xmllib_rec.recName   = p-rec-name
     3614             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     3615             and buf_temp_xmllib_rec.closed    = no
     3616       use-index nm
     3617       no-error.
     3618       if not available buf_temp_xmllib_rec
     3619       then do:
     3620           run xmllib-parse-error in this-procedure (
     3621               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     3622                               , p-rec-name
     3623                               , p-fld-name
     3624                               , p-rec-level
     3625                               )
     3626           ).
     3627       end.
     3628       else do:
     3629           find last buf_temp_xmllib_rec-fld
     3630               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     3631                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     3632                 and buf_temp_xmllib_rec-fld.closed   = no
     3633           use-index nm
     3634           no-error.
     3635           if available buf_temp_xmllib_rec-fld
     3636           then do:
     3637               run xmllib-parse-error in this-procedure (
     3638                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     3639                                   , p-rec-name
     3640                                   , p-fld-name
     3641                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     3642                                   )
     3643               ).
     3644           end.
     3645           else do:
     3646               assign
     3647                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     3648               .
     3649               create buf_temp_xmllib_rec-fld.
     3650               assign
     3651                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     3652                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     3653                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3654                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     3655                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     3656                   buf_temp_xmllib_rec-fld.closed          = no
     3657               .
     3658           end.
     3659       end.
     3660   end.
     3661   end procedure.
