     3535   procedure xmllib-set-codepage-convert :
     3536     define input  parameter p-codepage-source as character no-undo .
     3537     define input  parameter p-codepage-target as character no-undo .
     3538   do
     3539   on error undo, return error return-value
     3540   :
     3541     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     3542     then do:
     3543       assign
     3544         v-xmllib-codepage-convert = yes
     3545         v-xmllib-codepage-source  = p-codepage-source
     3546         v-xmllib-codepage-target  = p-codepage-target
     3547       .
     3548     end.
     3549     else do:
     3550       assign
     3551         v-xmllib-codepage-convert = no
