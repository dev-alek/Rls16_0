     2335   procedure get-header-by-rec :
     2336   define input  parameter p-gate-rec as character no-undo .
     2337   define output parameter p-tth as handle no-undo .
     2338   define variable v-ii as integer   no-undo .
     2339   define variable glog as logical   no-undo .
     2340   define variable v-rowid as rowid no-undo .
     2341   define variable v-tbl-name as character no-undo .
     2342   define variable v-longchar as longchar no-undo .
     2343   define variable v-txmlh as handle no-undo .
     2344   define buffer buf_clob-data for ub.clob-data.
     2345   main-block:
     2346   do
     2347   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info16, return-value, chr(10), error-status :get-message (1))
     2348   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info16 )
     2349   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info16 )
     2350   :
     2351     run gen-row-keyr in  this-procedure  (
     2352                                           input  p-gate-rec
     2353                                           ,input  ?
     2354                                           ,input  "ub"
     2355                                           ,input  ?
     2356                                           ,input  NO-LOCK
     2357                                           ,output v-rowid
     2358                                           ,output v-tbl-name   ) no-error.
     2359       find first buf_clob-data no-lock where
     2360                 rowid(buf_clob-data) = v-rowid  no-error.
     2361       if not available buf_clob-data then do:
     2362         undo, return error substitute("Не найден CLOB  &1"
     2363                                         , p-gate-rec
     2364                                         ).
     2365       end.
     2366       assign
     2367       v-longchar = buf_clob-data.cdata
     2368       .
     2369       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2370       if error-status :error then do:
     2371         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2372       end.
     2373       create temp-table p-tth .
     2374       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2375                                     , v-longchar
     2376                                     , ?
     2377                                     , ?
     2378                                     , ?
     2379                                     ) no-error.
     2380       v-longchar = '':U.
     2381       define variable v-esm as character no-undo .
     2382       v-esm = error-status:get-message(1).
     2383       if error-status :error
     2384       or not glog
     2385       then do:
     2386         delete object p-tth no-error.
     2387         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2388                                    , p-gate-rec
     2389                                    , buf_clob-data.file-name_
     2390                                    , chr(10)
     2391                                    , v-esm
     2392                                     ).
     2393       end.
     2394   end.
     2395   end procedure.
