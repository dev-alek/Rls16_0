        1   using Ibs.Th.Rul.Route-data_.
        2   block-level on error undo, throw.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-parent-handle as handle no-undo .
        5   define input parameter p-log-handle  as handle no-undo .
        6   define input parameter p-cont-handle  as handle no-undo .
        7   define input parameter p-codex-id as integer no-undo .
        8   define input parameter p-ruleset-id as integer no-undo .
        9   define input parameter p-call-id as character no-undo .
       10   define input parameter p-order-id as integer no-undo .
       11   define input parameter p-rule-id as integer no-undo .
       12   define input parameter p-profile-id as integer no-undo .
       13   define input parameter p-is-dynamic as logical no-undo .
       14   define input parameter p-doc-type as character no-undo .
       15   define input parameter p-host-code like ub.sysconf.host-code no-undo .
       16   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       17   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       18   define input parameter p-doc-code as character no-undo .
       19   define input parameter p-process-file-name as character no-undo .
       20   define input parameter p-save       as integer no-undo .
       21   define input parameter v-curr-r-b   as character no-undo .
       22   define input parameter p-cmd-proc-handle as handle no-undo .
       23   define input parameter p-cmd-code  as integer no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 14 набор правил 3".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define  variable garbcoll_ii as integer no-undo .
      101   define  temp-table temp-gc no-undo
      102   field ii as integer
      103   field obj-r as handle
      104   field cn as character
      105   index pi is unique primary
      106   ii
      107   index icn
      108   cn.
      109   procedure garbcoll_create-gc-entry :
      110   define input parameter p-cn as character no-undo .
      111   define input parameter p-obj-r as handle no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       create temp-gc.
      116       assign
      117       temp-gc.ii = garbcoll_ii
      118       garbcoll_ii = garbcoll_ii + 1
      119       temp-gc.cn = p-cn
      120       temp-gc.obj-r = p-obj-r
      121       .
      122     end.
      123   end procedure.
      124   procedure garbcoll_clear :
      125     do
      126     on error undo, return error
      127     :
      128       for each temp-gc:
      129         delete object temp-gc.obj-r.
      130         delete temp-gc.
      131       end.
      132     end.
      133   end procedure.
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define new global shared variable g#lib-nws as handle no-undo .
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure gen-key-rec :
      364     define input  parameter p-tbl-name    as character no-undo.
      365     define input  parameter p-bh_tbl-name as handle    no-undo.
      366     define output parameter p-key-rec     as character no-undo.
      367     do
      368     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      369     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      370     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      371     :
      372       define variable fh               as handle    no-undo .
      373       define variable v-ok             as logical   no-undo .
      374       define variable v-inform         as character no-undo .
      375       define variable v-ind            as integer   no-undo .
      376       define variable v-idx-field-qnty as integer   no-undo .
      377       if p-tbl-name = ?
      378         or p-tbl-name = "":U
      379       then do:
      380         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      381       end.
      382       if not p-bh_tbl-name:available then do:
      383         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      384       end.
      385       assign
      386         p-key-rec = p-tbl-name
      387         v-inform  = p-bh_tbl-name:index-information(1)
      388         v-ind     = 2
      389       .
      390       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      391       on error undo, return error
      392       :
      393         assign
      394           v-inform = p-bh_tbl-name:index-information( v-ind )
      395           v-ind    = v-ind + 1
      396         .
      397       end.
      398       if v-inform = ?
      399         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      400         or entry( 3, v-inform, ",":U ) <> "1":U
      401       then do:
      402         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      403       end.
      404       else do:
      405         assign
      406           v-idx-field-qnty = num-entries( v-inform ) - 4
      407         .
      408         if v-idx-field-qnty < 2 then do:
      409           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      410         end.
      411         do v-ind = 1 to v-idx-field-qnty by 2
      412         on error undo, return error
      413         :
      414           assign
      415             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      416             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      417           .
      418         end.
      419       end.
      420       if p-key-rec = ? then do:
      421         assign
      422           p-key-rec = "":U
      423         .
      424         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      425       end.
      426     end.
      427     return.
      428   end procedure.
      429   procedure gen-where-keyr-tab :
      430     define input  parameter i-tableSerach as character no-undo.
      431     define input  parameter i-tablekey   as character  no-undo.
      432     define input  parameter p-key-rec    as character  no-undo.
      433     define input  parameter p-key-handle as handle     no-undo .
      434     define input  parameter p-db-name    as character  no-undo .
      435     define input  parameter p-tt-handle  as handle     no-undo .
      436     define output parameter o-Where      as character  no-undo.
      437     do
      438     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      439     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      440     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      441     :
      442       define variable v-full-tbl-name  as character no-undo .
      443       define variable bh_tbl-name      as handle    no-undo .
      444       define variable fh_key           as handle    no-undo .
      445       define variable fh_search        as handle    no-undo .
      446       define variable v-field-num      as integer   no-undo .
      447       define variable v-count-fld      as integer   no-undo .
      448       define variable v-inform         as character no-undo .
      449       define variable v-ind            as integer   no-undo .
      450       define variable v-idx-field-qnty as integer   no-undo .
      451       define variable v-field-name     as character no-undo .
      452       define variable v-field-val      as character no-undo .
      453       define variable v-word-link      as character no-undo .
      454       define variable vTable           as character no-undo.
      455       define variable bh_tbl-key       as handle    no-undo .
      456       assign
      457         p-key-rec = trim( p-key-rec )
      458       .
      459       if p-key-handle <> ? then do:
      460         if not valid-handle(p-key-handle)
      461            or p-key-handle:type <> "buffer"
      462         then do:
      463           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      464         end.
      465         if num-entries( p-key-rec, chr(3) ) > 1
      466           or p-key-rec = ?
      467           or p-key-rec = "":U
      468         then do:
      469           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      470         end.
      471       end.
      472       else do:
      473         if p-key-rec = ?
      474           or p-key-rec = "":U
      475         then do:
      476           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      477         end.
      478       end.
      479       assign
      480         vTable = entry( 1 , p-key-rec, chr(3) )
      481       .
      482       if p-tt-handle <> ?
      483         and ( not valid-handle(p-tt-handle)
      484               or p-tt-handle:type <> "buffer"
      485             )
      486       then do:
      487         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      488       end.
      489       if p-tt-handle = ? then do:
      490         assign
      491           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      492         .
      493         create buffer bh_tbl-name for table v-full-tbl-name .
      494       end.
      495       else do:
      496         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      497       end.
      498       assign
      499         v-inform = bh_tbl-name:index-information(1)
      500         v-ind    = 2
      501       .
      502       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      503       on error undo, return error
      504       :
      505         assign
      506           v-inform = bh_tbl-name:index-information( v-ind )
      507           v-ind    = v-ind + 1
      508         .
      509       end.
      510       if v-inform = ?
      511         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      512         or entry( 3, v-inform, ",":U ) <> "1":U
      513       then do:
      514         delete object bh_tbl-name no-error.
      515         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      516       end.
      517       assign
      518         v-idx-field-qnty = num-entries( v-inform ) - 4
      519       .
      520       if v-idx-field-qnty < 2 then do:
      521         delete object bh_tbl-name no-error.
      522         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      523       end.
      524       assign
      525         o-where     = "where":U
      526         v-word-link = "":U
      527         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      528         v-count-fld = 0
      529       .
      530       if i-tablekey ne "" and i-tablekey ne ?
      531       then do:
      532         assign
      533           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      534         .
      535         create buffer bh_tbl-key for table v-full-tbl-name .
      536       end.
      537       if i-tableSerach ne "" and i-tableSerach ne ?
      538       then do:
      539         delete object bh_tbl-name no-error.
      540         assign
      541           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      542         .
      543         create buffer bh_tbl-name for table v-full-tbl-name .
      544       end.
      545       block_where:
      546       do v-ind = 1 to v-idx-field-qnty by 2
      547       on error undo, return error
      548       :
      549         assign
      550           v-count-fld = v-count-fld + 1
      551         .
      552         if p-key-handle = ?
      553           and v-count-fld > v-field-num
      554         then do:
      555           leave block_where.
      556         end.
      557         define variable VfieldKeyTable as handle no-undo.
      558         assign
      559           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      560           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      561         .
      562         if     bh_tbl-key ne ?
      563         then do:
      564            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      565            if VfieldKeyTable eq ?
      566            then next block_where.
      567         end.
      568         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      569         then
      570            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      571         else
      572            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      573         if p-key-handle = ? then do:
      574           assign
      575             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      576           .
      577         end.
      578         else do:
      579           assign
      580             fh_key = p-key-handle:buffer-field( v-field-name )
      581           .
      582           if fh_key = ?
      583             or not valid-handle( fh_key )
      584           then do:
      585             delete object bh_tbl-name.
      586             if     bh_tbl-key ne ?
      587             then
      588                delete object bh_tbl-key.
      589             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      590           end.
      591           assign
      592             v-field-val = fh_key:buffer-value
      593           .
      594         end.
      595         if fh_search:data-type ="character":U then do:
      596           assign
      597             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      598             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      599             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      600             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      601             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      602             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      603             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      604             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      605             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      606             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      607             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      608             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      609             v-field-val = substitute( '"&1"', v-field-val )
      610           .
      611         end.
      612         assign
      613           o-where = substitute( "&1 &2", o-where, v-field-val )
      614         .
      615         if v-word-link = "":U then do:
      616           assign
      617             v-word-link = "and":U
      618           .
      619         end.
      620       end.
      621       delete object bh_tbl-name.
      622       if     bh_tbl-key ne ?
      623       then
      624          delete object bh_tbl-key.
      625       if p-key-handle = ?
      626         and v-count-fld <> v-field-num
      627       then do:
      628         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      629       end.
      630     end.
      631   end procedure.
      632   procedure gen-hn-keyr-tab :
      633     define input  parameter i-tableSerach as character no-undo.
      634     define input  parameter i-tablekey   as character no-undo.
      635     define input  parameter p-key-rec    as character no-undo.
      636     define input  parameter p-key-handle as handle    no-undo .
      637     define input  parameter p-db-name    as character no-undo .
      638     define input  parameter p-tt-handle  as handle    no-undo .
      639     define input  parameter p-stts-lock  as integer   no-undo .
      640     define output parameter o-hn         as handle    no-undo.
      641     define variable v-full-tbl-name as character no-undo.
      642     define variable v-where         as character no-undo.
      643     define variable bh_tbl-name     as handle    no-undo.
      644     define variable vTable          as character no-undo.
      645     do
      646     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      647     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      648     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      649         run gen-where-keyr-tab(i-tableSerach,
      650                                i-tablekey,
      651                                p-key-rec,
      652                                p-key-handle,
      653                                p-db-name,
      654                                p-tt-handle,
      655                                output v-where).
      656         if i-tableSerach ne "" and i-tableSerach ne ?
      657         then do:
      658            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      659            create buffer bh_tbl-name for table v-full-tbl-name .
      660         end.
      661         else do:
      662            if p-tt-handle = ? then do:
      663               assign
      664                  vTable = entry( 1 , p-key-rec, chr(3) )
      665               .
      666               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      667               create buffer bh_tbl-name for table v-full-tbl-name .
      668            end.
      669            else do:
      670               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      671            end.
      672         end.
      673         if p-tt-handle = ? then do:
      674            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      675         end.
      676         else do:
      677            bh_tbl-name:find-first( v-where ) no-error .
      678         end.
      679         o-hn = bh_tbl-name.
      680      end.
      681   end procedure.
      682   procedure gen-hn-keyr :
      683     define input  parameter p-key-rec    as character no-undo.
      684     define input  parameter p-key-handle as handle    no-undo .
      685     define input  parameter p-db-name    as character no-undo .
      686     define input  parameter p-tt-handle  as handle    no-undo .
      687     define input  parameter p-stts-lock  as integer   no-undo .
      688     define output parameter o-hn         as handle    no-undo.
      689     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      690   end.
      691   procedure gen-row-keyr :
      692     define input  parameter p-key-rec    as character no-undo.
      693     define input  parameter p-key-handle as handle    no-undo .
      694     define input  parameter p-db-name    as character no-undo .
      695     define input  parameter p-tt-handle  as handle    no-undo .
      696     define input  parameter p-stts-lock  as integer   no-undo .
      697     define output parameter p-tbl-row    as rowid     no-undo.
      698     define output parameter p-tbl-name   as character no-undo.
      699     define variable vHn as handle no-undo.
      700       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      701       p-tbl-row = if vHn:available then vHn:rowid else ?.
      702       p-tbl-name =  vHn:table.
      703       delete object vHn no-error.
      704     if p-tbl-row = ? then do:
      705       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      706     end.
      707     else do:
      708       return.
      709     end.
      710   end procedure.
      711   procedure gen-key-fv :
      712     define input  parameter p-key-rec    as character no-undo .
      713     define output parameter p-field-list as character no-undo .
      714     define output parameter p-value-list as character no-undo.
      715     do
      716     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      717     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      718     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      719     :
      720       define variable v-full-tbl-name  as character no-undo .
      721       define variable bh_tbl-name      as handle    no-undo .
      722       define variable v-tbl-name       as character no-undo .
      723       define variable v-field-num      as integer   no-undo .
      724       define variable v-count-fld      as integer   no-undo .
      725       define variable v-inform         as character no-undo .
      726       define variable v-ind            as integer   no-undo .
      727       define variable v-idx-field-qnty as integer   no-undo .
      728       define variable v-delim-key      as character no-undo .
      729       if p-key-rec = ?
      730         or p-key-rec = "":U
      731       then do:
      732         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      733       end.
      734       assign
      735         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      736         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      737       .
      738       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      739       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      740       assign
      741         v-inform = bh_tbl-name:index-information(1)
      742         v-ind    = 2
      743       .
      744       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      745       on error undo, return error
      746       :
      747         assign
      748           v-inform = bh_tbl-name:index-information( v-ind )
      749           v-ind    = v-ind + 1
      750         .
      751       end.
      752       if v-inform = ?
      753         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      754         or entry( 3, v-inform, ",":U ) <> "1":U
      755       then do:
      756         delete object bh_tbl-name no-error.
      757         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      758       end.
      759       assign
      760         v-idx-field-qnty = num-entries( v-inform ) - 4
      761       .
      762       if v-idx-field-qnty < 2 then do:
      763         delete object bh_tbl-name no-error.
      764         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      765       end.
      766       assign
      767         p-field-list = "":U
      768         p-value-list = "":U
      769         v-delim-key  = "":U
      770         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      771         v-count-fld  = 0
      772       .
      773       block_where:
      774       do v-ind = 1 to v-idx-field-qnty by 2
      775       on error undo, return error
      776       :
      777         assign
      778           v-count-fld = v-count-fld + 1
      779         .
      780         if v-count-fld > v-field-num then do:
      781           leave block_where.
      782         end.
      783         assign
      784           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      785           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      786         .
      787         if v-ind = 1 then do:
      788           assign
      789             v-delim-key = chr(3)
      790           .
      791         end.
      792       end.
      793       delete object bh_tbl-name.
      794       if v-count-fld <> v-field-num then do:
      795         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      796       end.
      797     end.
      798   end procedure.
      799   procedure gen-key-field :
      800     define input  parameter p-table      as character no-undo .
      801     define output parameter p-field-list as character no-undo .
      802     do
      803     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      804     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      805     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      806     :
      807       define variable v-full-tbl-name  as character no-undo .
      808       define variable bh_tbl-name      as handle    no-undo .
      809       define variable v-tbl-name       as character no-undo .
      810       define variable v-field-num      as integer   no-undo .
      811       define variable v-count-fld      as integer   no-undo .
      812       define variable v-inform         as character no-undo .
      813       define variable v-ind            as integer   no-undo .
      814       define variable v-idx-field-qnty as integer   no-undo .
      815       define variable v-delim-key      as character no-undo .
      816       if p-table = ?
      817         or p-table = "":U
      818       then do:
      819         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      820       end.
      821       assign
      822         v-tbl-name      = p-table
      823         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      824       .
      825       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      826       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      827       assign
      828         v-inform = bh_tbl-name:index-information(1)
      829         v-ind    = 2
      830       .
      831       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      832       on error undo, return error
      833       :
      834         assign
      835           v-inform = bh_tbl-name:index-information( v-ind )
      836           v-ind    = v-ind + 1
      837         .
      838       end.
      839       if v-inform = ?
      840         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      841         or entry( 3, v-inform, ",":U ) <> "1":U
      842       then do:
      843         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      844       end.
      845       assign
      846         v-idx-field-qnty = num-entries( v-inform ) - 4
      847       .
      848       if v-idx-field-qnty < 2 then do:
      849         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      850       end.
      851       assign
      852         p-field-list = "":U
      853         v-delim-key  = "":U
      854         v-count-fld  = 0
      855       .
      856       block_where:
      857       do v-ind = 1 to v-idx-field-qnty by 2
      858       on error undo, return error
      859       :
      860         assign
      861           v-count-fld = v-count-fld + 1
      862         .
      863         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      864         if v-ind = 1 then do:
      865           assign
      866             v-delim-key = chr(3)
      867           .
      868         end.
      869       end.
      870       delete object bh_tbl-name.
      871     end.
      872   end procedure.
      873   define SHARED temp-table temp-cmd no-undo
      874   field cmd-code as integer
      875   field db-list as character
      876   index pi is unique primary
      877   db-list
      878   index icmd
      879   cmd-code
      880   .
      881   define SHARED temp-table temp-smart-route no-undo
      882   field key-field as character
      883   field db-num as integer
      884   index pi is unique primary
      885   key-field
      886   db-num
      887   .
      888   define SHARED temp-table temp-no-route no-undo
      889   field rec-ord as integer
      890   field db-num as integer
      891   index pi is unique primary
      892   db-num
      893   rec-ord
      894   index iro
      895   rec-ord
      896   .
      897   define SHARED temp-table temp-smart-link no-undo
      898   field uniq-key-rec as character
      899   field key-field as character
      900   field rec-ord as integer
      901   field is-smart as logical
      902   index pi is unique primary
      903   key-field
      904   uniq-key-rec
      905   rec-ord
      906   index iu
      907   uniq-key-rec
      908   index iro
      909   rec-ord
      910   .
      911   define SHARED temp-table temp-nws-outline no-undo
      912   like ub.nws-outline.
      913   procedure create-smart-route :
      914   define input parameter p-key-field as character no-undo .
      915   define input parameter p-db-num as integer no-undo .
      916   define buffer buf_temp-smart-route for temp-smart-route.
      917     do
      918     on error undo, return error
      919     :
      920       find first buf_temp-smart-route where
      921                 buf_temp-smart-route.key-field = p-key-field
      922             and buf_temp-smart-route.db-num = p-db-num no-error.
      923       if not available buf_temp-smart-route then do:
      924         create buf_temp-smart-route.
      925         assign
      926         buf_temp-smart-route.key-field = p-key-field
      927         buf_temp-smart-route.db-num = p-db-num
      928         .
      929       end.
      930     end.
      931   end procedure.
      932   procedure create-smart-route-link :
      933   define input parameter p-tbl-name as character no-undo .
      934   define input parameter p-bh_tbl-name as handle no-undo .
      935   define input parameter p-key-field as character no-undo .
      936   define input parameter p-rec-ord as integer no-undo .
      937   define input parameter p-is-smart as logical no-undo .
      938   define variable v-key-rec as character no-undo .
      939   define buffer buf_temp-smart-link for temp-smart-link.
      940     do
      941     on error undo, return error
      942     :
      943       run gen-key-rec in this-procedure ( input p-tbl-name
      944                                          ,input p-bh_tbl-name
      945                                          ,output v-key-rec     ).
      946      find first buf_temp-smart-link where
      947                 buf_temp-smart-link.uniq-key-rec = v-key-rec
      948              and buf_temp-smart-link.key-field = p-key-field
      949              and buf_temp-smart-link.rec-ord = p-rec-ord
      950              no-error .
      951      if not available buf_temp-smart-link then do:
      952        create buf_temp-smart-link.
      953        assign
      954        buf_temp-smart-link.uniq-key-rec = v-key-rec
      955        buf_temp-smart-link.key-field = p-key-field
      956        buf_temp-smart-link.rec-ord = p-rec-ord
      957        buf_temp-smart-link.is-smart = p-is-smart
      958        .
      959      end.
      960     end.
      961   end procedure.
      962   procedure create-nws-outline :
      963   define input parameter p-cmd-proc-handle as handle no-undo .
      964   define input parameter p-cmd-code as integer no-undo .
      965   define input parameter p-outline-type as character no-undo .
      966   define input parameter p-charkey_one as character no-undo .
      967   define input parameter p-charkey_two as character no-undo .
      968   define input parameter p-charkey_three as character no-undo .
      969   define input parameter p-key#_one as integer no-undo .
      970   define input parameter p-key#_two as integer no-undo .
      971   define input parameter p-key#_three as integer no-undo .
      972   define variable v-no-id as integer no-undo .
      973   define variable v-rec-ord as integer no-undo .
      974     do
      975     on error undo, return error return-value
      976     :
      977       find last temp-nws-outline use-index pi no-error .
      978       v-no-id = (if available temp-nws-outline
      979                  then (temp-nws-outline.no-id  + 1)
      980                  else 1).
      981       create temp-nws-outline.
      982       assign
      983       temp-nws-outline.charkeY_one = p-charkey_one
      984       temp-nws-outline.charkeY_two = p-charkey_two
      985       temp-nws-outline.charkeY_three = p-charkey_three
      986       temp-nws-outline.key#_one = p-key#_one
      987       temp-nws-outline.key#_two = p-key#_two
      988       temp-nws-outline.key#_three = p-key#_three
      989       temp-nws-outline.no-id = v-no-id
      990       temp-nws-outline.outline-type = p-outline-type
      991       .
      992                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      993       run  create-smart-route in this-procedure (
      994                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
      995                                                  ,input -1).
      996       run create-smart-route-link in this-procedure (
      997                                                      input 'nws-outline':U
      998                                                     ,input (buffer temp-nws-outline:handle)
      999                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1000                                                     ,input v-rec-ord
     1001                                                     ,input no
     1002                                                     ).
     1003     end.
     1004   end procedure.
     1005   procedure create-no-route :
     1006   define input parameter p-rec-ord as integer no-undo .
     1007   define input parameter p-db-num as integer no-undo .
     1008   define buffer buf_temp-no-route for temp-no-route.
     1009   do
     1010   on error undo, return error
     1011   :
     1012      find first buf_temp-no-route where
     1013                 buf_temp-no-route.rec-ord = p-rec-ord
     1014              and buf_temp-no-route.db-num = p-db-num no-error .
     1015      if not available buf_temp-no-route then do:
     1016        create buf_temp-no-route.
     1017        assign
     1018        buf_temp-no-route.rec-ord = p-rec-ord
     1019        buf_temp-no-route.db-num = p-db-num
     1020        .
     1021      end.
     1022   end.
     1023   end procedure.
     1024   procedure clear-from-rec-ord :
     1025   define input parameter p-rec-ord as integer no-undo .
     1026   define buffer buf_temp-no-route for temp-no-route.
     1027   define buffer buf_temp-smart-link for temp-smart-link.
     1028   do
     1029   on error undo, return error
     1030   :
     1031   for each buf_temp-no-route where
     1032           buf_temp-no-route.rec-ord > p-rec-ord:
     1033     delete buf_temp-no-route.
     1034   end.
     1035   for each buf_temp-smart-link where
     1036           buf_temp-smart-link.rec-ord > p-rec-ord:
     1037      delete buf_temp-smart-link.
     1038   end.
     1039   end.
     1040   end procedure.
     1041   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   define shared temp-table temp-hist-nws-option no-undo
     1043   like ub.hist-nws-option
     1044   .
     1045   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   procedure library-cls_get-handle :
     1047   define input parameter p-library-name as character no-undo .
     1048   define output parameter p-library-handle as handle no-undo .
     1049     do
     1050     on error undo, return error
     1051     :
     1052       CASE p-library-name:
     1053         when "library" then do:
     1054           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1055           p-library-handle = g#library.
     1056         end.
     1057         when "library2" then do:
     1058           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1059           p-library-handle = g#library2.
     1060         end.
     1061       end case.
     1062     end.
     1063   end procedure.
     1064   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   define variable tempcxml_v-num_ as integer no-undo .
     1067   define new shared temp-table temp-xml-tables no-undo
     1068   field order as integer
     1069   field tbl-name as character
     1070   field tbl-handle_ as handle
     1071   field table-handle_ as handle
     1072   field uniq-gate-rec as character
     1073   field gate-name as character
     1074   field gate-handle_ as handle
     1075   field is-parent as logical
     1076   index pi is unique primary
     1077   uniq-gate-rec
     1078   tbl-name
     1079   index iorder
     1080   order
     1081   index gr
     1082   uniq-gate-rec
     1083   index gh
     1084   gate-handle_
     1085   index iparent
     1086   is-parent
     1087   .
     1088   define new shared temp-table temp-xml-records no-undo
     1089   field tbl-name as character
     1090   field uniq-key-rec as character
     1091   index pi is unique primary
     1092   tbl-name
     1093   uniq-key-rec
     1094   .
     1095   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1097   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   procedure get-gate-file-name :
     1099   define input parameter p-gate-rec as character no-undo .
     1100   define output  parameter p-gate-file-name as character no-undo .
     1101   define buffer buf_clob-data for ub.clob-data.
     1102   define variable v-tbl-row as rowid no-undo .
     1103   define variable v-tbl-name as character no-undo .
     1104   run gen-row-keyr in this-procedure ( input p-gate-rec
     1105                                       ,input ?
     1106                                       ,input "ub"
     1107                                       ,input ?
     1108                                       ,input no-lock
     1109                                       ,output v-tbl-row
     1110                                       ,output v-tbl-name) no-error.
     1111   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1112                                                           ,vss-include-info9
     1113                                                           ,p-gate-rec).
     1114   find first buf_clob-data no-lock where
     1115             rowid(buf_clob-data) = v-tbl-row no-error.
     1116   if not available buf_clob-data then do:
     1117     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1118                                                             ,vss-include-info9
     1119                                                             ,p-gate-rec).
     1120   end.
     1121   p-gate-file-name = buf_clob-data.file-name.
     1122   end procedure.
     1123   procedure get-gate-rec :
     1124   define input  parameter p-gate-name as character no-undo .
     1125   define output parameter p-gate-rec as character no-undo .
     1126   define buffer buf_clob-bind for ub.clob-bind.
     1127   define buffer buf_clob-data for ub.clob-data.
     1128   main-block:
     1129   do
     1130   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1131   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1132   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1133   :
     1134       find first buf_clob-bind no-lock where
     1135                 buf_clob-bind.uniq-key-rec = p-gate-name
     1136             and buf_clob-bind.field-name = '':U
     1137             and buf_clob-bind.part-num = 1
     1138             and buf_clob-bind.resource-type = 'gate':U
     1139             no-error.
     1140       if not available buf_clob-bind then do:
     1141         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1142                                         , p-gate-name
     1143                                         ).
     1144       end.
     1145       find first buf_clob-data no-lock where
     1146                 buf_clob-data.db-num = buf_clob-bind.db-num
     1147             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1148       if not available buf_clob-data then do:
     1149         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1150                                         , buf_clob-bind.db-num
     1151                                         , buf_clob-bind.int64-id
     1152                                         , p-gate-name
     1153                                         ).
     1154       end.
     1155       run gen-key-rec in this-procedure ( input 'clob-data':U
     1156                                 ,input buffer buf_clob-data:handle
     1157                                 ,output p-gate-rec).
     1158   end.
     1159   end procedure.
     1160   procedure get-gate-by-name :
     1161   define input  parameter p-gate-name as character no-undo .
     1162   define output parameter p-gate-rec as character no-undo .
     1163   define output parameter p-dsh as handle no-undo .
     1164   define input-output  parameter p-xmlh as handle no-undo .
     1165   define variable v-ii as integer   no-undo .
     1166   define variable glog as logical   no-undo .
     1167   define variable v-longchar as longchar no-undo .
     1168   define variable v-txmlh as handle no-undo .
     1169   define variable v-db-num as integer no-undo .
     1170   define variable v-int64-id as int64 no-undo .
     1171   define buffer buf_clob-bind for ub.clob-bind.
     1172   define buffer buf_clob-data for ub.clob-data.
     1173   main-block:
     1174   do
     1175   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1176   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1177   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1178   :
     1179       find first buf_clob-bind no-lock where
     1180                 buf_clob-bind.uniq-key-rec = p-gate-name
     1181             and buf_clob-bind.field-name = '':U
     1182             and buf_clob-bind.part-num = 1
     1183             and buf_clob-bind.resource-type = 'gate':U
     1184             no-error.
     1185       if not available buf_clob-bind then do:
     1186         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1187                                         , p-gate-name
     1188                                         ).
     1189       end.
     1190       find first buf_clob-data no-lock where
     1191                 buf_clob-data.db-num = buf_clob-bind.db-num
     1192             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1193       if not available buf_clob-data then do:
     1194         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1195                                         , buf_clob-bind.db-num
     1196                                         , buf_clob-bind.int64-id
     1197                                         , p-gate-name
     1198                                         ).
     1199       end.
     1200       assign
     1201       v-longchar = buf_clob-data.cdata
     1202       .
     1203       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1204       if error-status :error then do:
     1205         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1206       end.
     1207       create dataset p-dsh .
     1208       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1209                                     , v-longchar
     1210                                     , ?
     1211                                     , ?
     1212                                     , ?
     1213                                     ) no-error.
     1214       v-longchar = '':U.
     1215       if error-status :error
     1216       or not glog
     1217       then do:
     1218         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1219       end.
     1220       if not valid-handle(p-xmlh)
     1221       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1222         create temp-table v-txmlh.
     1223         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1224         v-txmlh:temp-table-prepare("temp-xml-tables").
     1225         p-xmlh = v-txmlh:default-buffer-handle.
     1226       end.
     1227       run gen-key-rec in this-procedure ( input 'clob-data':U
     1228                                 ,input buffer buf_clob-data:handle
     1229                                 ,output p-gate-rec).
     1230       do v-ii = 1 to p-dsh:num-buffers:
     1231         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1232         if not p-xmlh:available then do:
     1233           p-xmlh:buffer-create().
     1234           assign
     1235           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1236           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1237           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1238           p-xmlh::gate-handle_ = p-dsh
     1239           p-xmlh::uniq-gate-rec = p-gate-rec
     1240           p-xmlh::gate-name = p-dsh:name
     1241           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1242           .
     1243           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1244             assign
     1245             p-xmlh::order = -3.
     1246           end.
     1247         end.
     1248       end.
     1249   end.
     1250   end procedure.
     1251   procedure get-gate-by-rec :
     1252   define input  parameter p-gate-rec as character no-undo .
     1253   define output parameter p-dsh as handle no-undo .
     1254   define input-output  parameter p-xmlh as handle no-undo .
     1255   define input-output parameter p-longchar  as longchar no-undo .
     1256   define variable v-ii as integer   no-undo .
     1257   define variable glog as logical   no-undo .
     1258   define variable v-rowid as rowid no-undo .
     1259   define variable v-tbl-name as character no-undo .
     1260   define variable v-longchar as longchar no-undo .
     1261   define variable v-txmlh as handle no-undo .
     1262   define buffer buf_clob-data for ub.clob-data.
     1263   main-block:
     1264   do
     1265   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1266   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1267   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1268   :
     1269     run gen-row-keyr in this-procedure (
     1270                                           input  p-gate-rec
     1271                                           ,input  ?
     1272                                           ,input  "ub"
     1273                                           ,input  ?
     1274                                           ,input  NO-LOCK
     1275                                           ,output v-rowid
     1276                                           ,output v-tbl-name   ) no-error.
     1277       find first buf_clob-data no-lock where
     1278                 rowid(buf_clob-data) = v-rowid  no-error.
     1279       if not available buf_clob-data then do:
     1280         undo, return error substitute("Не найден CLOB  &1"
     1281                                         , p-gate-rec
     1282                                         ).
     1283       end.
     1284       assign
     1285       v-longchar = buf_clob-data.cdata
     1286       .
     1287       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1288       if error-status :error then do:
     1289         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1290       end.
     1291       create dataset p-dsh .
     1292       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1293                                     , v-longchar
     1294                                     , ?
     1295                                     , ?
     1296                                     , ?
     1297                                     ) no-error.
     1298       define variable v-esm as character no-undo .
     1299       v-esm = error-status:get-message(1) .
     1300       if p-longchar <> ? then do:
     1301         p-longchar = v-longchar.
     1302       end.
     1303       v-longchar = '':U.
     1304       if error-status :error
     1305       or not glog
     1306       then do:
     1307         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1308                                      , p-gate-rec
     1309                                      , p-gate-rec
     1310                                      , v-esm
     1311                                      ).
     1312       end.
     1313       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1314       if not valid-handle(p-xmlh)
     1315       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1316         create temp-table v-txmlh.
     1317         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1318         v-txmlh:temp-table-prepare("temp-xml-tables").
     1319         p-xmlh = v-txmlh:default-buffer-handle.
     1320       end.
     1321       do v-ii = 1 to p-dsh:num-buffers:
     1322         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1323         if not p-xmlh:available then do:
     1324           p-xmlh:buffer-create().
     1325           assign
     1326           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1327           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1328           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1329           p-xmlh::gate-handle_ = p-dsh
     1330           p-xmlh::uniq-gate-rec = p-gate-rec
     1331           p-xmlh::gate-name = p-dsh:name
     1332           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1333           .
     1334           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1335             assign
     1336             p-xmlh::order = -3.
     1337           end.
     1338           p-xmlh:buffer-release().
     1339         end.
     1340       end.
     1341   end.
     1342   end procedure.
     1343   procedure get-gate-by-file :
     1344   define input  parameter p-schema-file-name as character no-undo .
     1345   define input  parameter p-gate-rec as character no-undo .
     1346   define output parameter p-dsh as handle no-undo .
     1347   define input-output  parameter p-xmlh as handle no-undo .
     1348   define variable v-ii as integer   no-undo .
     1349   define variable glog as logical   no-undo .
     1350   define variable v-rowid as rowid no-undo .
     1351   define variable v-tbl-name as character no-undo .
     1352   define variable v-longchar as longchar no-undo .
     1353   define variable v-txmlh as handle no-undo .
     1354   main-block:
     1355   do
     1356   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     1357   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     1358   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     1359   :
     1360       COPY-LOB
     1361       FROM  FILE p-schema-file-name
     1362       TO  OBJECT v-longchar
     1363       no-convert
     1364       NO-ERROR .
     1365       if error-status :error then do:
     1366           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1367                                     , p-schema-file-name
     1368                                 , chr(10)
     1369                                 , error-status:get-message(1) ).
     1370       end.
     1371       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1372       if error-status :error then do:
     1373         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1374       end.
     1375       create dataset p-dsh .
     1376       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1377                                     , v-longchar
     1378                                     , ?
     1379                                     , ?
     1380                                     , ?
     1381                                     ) no-error.
     1382       v-longchar = ''.
     1383       if error-status :error
     1384       or not glog
     1385       then do:
     1386         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1387                                      , p-schema-file-name
     1388                                      ,chr(10)
     1389                                      , error-status:get-message(1)
     1390                                      ).
     1391       end.
     1392       if not valid-handle(p-xmlh)
     1393       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1394         create temp-table v-txmlh.
     1395         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1396         v-txmlh:temp-table-prepare("temp-xml-tables").
     1397         p-xmlh = v-txmlh:default-buffer-handle.
     1398       end.
     1399       do v-ii = 1 to p-dsh:num-buffers:
     1400         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1401                                      ,p-dsh:get-buffer-handle(v-ii):name
     1402                                      ,p-gate-rec
     1403                                      )) no-error.
     1404         if not p-xmlh:available then do:
     1405           p-xmlh:buffer-create().
     1406           assign
     1407           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1408           p-xmlh::uniq-gate-rec = p-gate-rec
     1409           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1410           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1411           p-xmlh::gate-handle_ = p-dsh
     1412           p-xmlh::gate-name = p-dsh:name
     1413           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1414           .
     1415           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1416             assign
     1417             p-xmlh::order = -3.
     1418           end.
     1419           p-xmlh:buffer-release().
     1420         end.
     1421       end.
     1422   end.
     1423   end procedure.
     1424   procedure gate-clear :
     1425   define input  parameter p-dsh as handle no-undo .
     1426   define input  parameter p-xmlh as handle no-undo .
     1427   define variable v-dsh as handle no-undo .
     1428   define variable v-th as handle no-undo .
     1429     do
     1430     on error undo, return error return-value
     1431     :
     1432       if valid-handle(p-dsh) then do:
     1433         delete object p-dsh.
     1434         v-dsh = p-dsh.
     1435         p-dsh = ?.
     1436       end.
     1437       repeat while true:
     1438         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1439                            , share-lock) no-error.
     1440         if p-xmlh:available then do:
     1441           assign
     1442           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1443           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1444           and valid-handle(v-th)
     1445           and v-th:dynamic = yes
     1446           then do:
     1447             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1448             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1449           end.
     1450           p-xmlh:buffer-delete().
     1451         end.
     1452         else do:
     1453           leave.
     1454         end.
     1455       end.
     1456       if p-xmlh:dynamic = yes
     1457       and valid-handle(p-xmlh)
     1458       then do:
     1459         delete object p-xmlh:table-handle.
     1460         p-xmlh = ?.
     1461       end.
     1462       v-dsh = ?.
     1463     end.
     1464   end procedure.
     1465   procedure all-gates-clear :
     1466   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1467   do
     1468   on error undo, return error
     1469   :
     1470     for each buf_temp-xml-tables
     1471     break
     1472     by buf_temp-xml-tables.uniq-gate-rec
     1473     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1474     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1475     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1476     :
     1477         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1478           delete object buf_temp-xml-tables.gate-handle_.
     1479           buf_temp-xml-tables.gate-handle_ = ?.
     1480         end.
     1481         if valid-handle(buf_temp-xml-tables.table-handle_)
     1482         and buf_temp-xml-tables.table-handle_:dynamic = no
     1483         then do:
     1484           delete object buf_temp-xml-tables.table-handle_.
     1485           buf_temp-xml-tables.table-handle_ = ?.
     1486         end.
     1487         delete buf_temp-xml-tables.
     1488     end.
     1489   end.
     1490   end procedure.
     1491   procedure fix-schemalocation :
     1492   define input-output  parameter p-longchar as longchar no-undo .
     1493   DEFINE VARIABLE hdoc AS HANDLE.
     1494   DEFINE VARIABLE hroot AS HANDLE.
     1495   DEFINE VARIABLE hnode-child AS HANDLE.
     1496   DEFINE VARIABLE hnode-attr AS HANDLE.
     1497   define variable v-jj as integer   no-undo .
     1498   define variable ok as logical   no-undo .
     1499   define variable v-path1                    as character                no-undo .
     1500   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1501   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1502   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1503   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1504   define variable v-schema-location          as character                no-undo .
     1505   do
     1506   on error undo, return error return-value
     1507   :
     1508     CREATE X-DOCUMENT hdoc.
     1509     CREATE X-noderef hroot.
     1510     CREATE X-noderef hnode-child.
     1511     CREATE X-noderef hnode-attr.
     1512     hdoc:load("longchar", p-longchar, no) no-error.
     1513     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1514     hdoc:get-document-element(hroot).
     1515     _repeat:
     1516     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1517       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1518       if not ok then next.
     1519       if hNode-Child:local-name = "include"
     1520       then do:
     1521         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1522           v-schema-location = hnode-attr:node-value.
     1523           run gbl/filename.p (
     1524                           input "exe/" + hnode-attr:node-value
     1525                         ,output v-full-path1
     1526                         ,output v-path1
     1527                         ,output v-file-name1
     1528                         ,output v-file-name-no-ext1
     1529                         ,output v-file-name-ext1
     1530                         ) no-error .
     1531           if error-status :error then do:
     1532             delete object hnode-attr.
     1533             delete object hnode-child.
     1534             delete object hroot.
     1535             delete object hdoc.
     1536             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1537           end.
     1538         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1539         leave  _repeat.
     1540       end.
     1541     END.
     1542     hdoc:save("longchar", p-longchar).
     1543     delete object hnode-attr.
     1544     delete object hnode-child.
     1545     delete object hroot.
     1546     delete object hdoc.
     1547   end.
     1548   end procedure.
     1549   procedure gate-clb_fill-xml-tables :
     1550   define input parameter p-dsh as handle no-undo .
     1551   define input-output parameter p-xmlh as handle no-undo .
     1552   define variable v-ii as integer no-undo .
     1553     do
     1554     on error undo, return error
     1555     :
     1556       do v-ii = 1 to p-dsh:num-buffers:
     1557         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1558         if not p-xmlh:available then do:
     1559           p-xmlh:buffer-create().
     1560           assign
     1561           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1562           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1563           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1564           p-xmlh::gate-handle_ = p-dsh
     1565           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1566           p-xmlh::gate-name = p-dsh:name
     1567           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1568           .
     1569           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1570             assign
     1571             p-xmlh::order = -3.
     1572           end.
     1573           p-xmlh:buffer-release().
     1574         end.
     1575       end.
     1576     end.
     1577   end procedure.
     1578   procedure all-gates-empty :
     1579   define buffer buf_temp-xml-tables for temp-xml-tables.
     1580   do
     1581   on error undo, return error
     1582   :
     1583     for each buf_temp-xml-tables
     1584     break
     1585     by buf_temp-xml-tables.uniq-gate-rec
     1586     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1587     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1588     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1589     :
     1590       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1591         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1592       end.
     1593     end.
     1594   end.
     1595   end procedure.
     1596   define variable vss-include-info12 as character format "X(65)" no-undo
     1597   initial "@(#)$Workfile$ $Revision$".
     1598   define temp-table temp_cgrplib_grp no-undo
     1599       field sel           as character
     1600       field full-name     as character
     1601       field sort-name     as character
     1602       field node-code     as integer
     1603       field upper-code    as integer
     1604       field d-pcnt        as decimal
     1605       field name          as character
     1606       field level         as integer
     1607       field mark          as character
     1608       index pi is primary unique sort-name
     1609       index fn full-name
     1610       index nc is unique node-code
     1611       index sl sel
     1612       index uc upper-code
     1613   .
     1614   define temp-table temp_cgrplib_found-grp no-undo
     1615       field full-name   as character
     1616       field sort-name   as character
     1617       field node-code   as integer
     1618       field level       as integer
     1619       field is-terminal as logical
     1620       field d-pcnt      as decimal
     1621       index pi is primary unique sort-name
     1622       index fn full-name
     1623       index lv level
     1624       index it is-terminal
     1625   .
     1626   define temp-table temp_cfound-result-nodelist no-undo
     1627       field node-code     as recid
     1628       field processed     as logical
     1629       field full-name     as character
     1630       field sort-name     as character
     1631       index pi is primary unique node-code
     1632       index ps processed
     1633   .
     1634   procedure cli-grplib-get-sort-name :
     1635   do
     1636   on error undo, return error
     1637   :
     1638   define input parameter p-node-code  as integer      no-undo.
     1639   define output parameter p-sort-name as character    no-undo.
     1640       define variable v-upper-code    as integer           no-undo.
     1641       define buffer buf_cli-grp       for ub.cli-grp.
     1642       define buffer buf_upper_cli-grp for ub.cli-grp.
     1643       find first buf_cli-grp no-lock
     1644            where buf_cli-grp.node-code = p-node-code
     1645       no-error.
     1646       if not available buf_cli-grp
     1647       then do:
     1648           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1649       end.
     1650       assign
     1651           p-sort-name  = ""
     1652           v-upper-code = 1
     1653       .
     1654       do while buf_cli-grp.upper-code <> 0
     1655       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     1656       :
     1657           assign
     1658               p-sort-name  = buf_cli-grp.node-name
     1659                            + (if p-sort-name <> "" then chr(2) else "")
     1660                            + p-sort-name
     1661               v-upper-code = buf_cli-grp.upper-code
     1662           .
     1663           find first buf_cli-grp no-lock
     1664                where buf_cli-grp.node-code = v-upper-code
     1665           no-error.
     1666           if not available buf_cli-grp
     1667           then do:
     1668               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     1669                                   + string( v-upper-code )
     1670                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1671           end.
     1672       end.
     1673   end.
     1674   end procedure.
     1675   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   procedure cli-grplib-get-full-name :
     1677      define input parameter  p-node-code  as integer      no-undo.
     1678      define output parameter p-full-name as character    no-undo.
     1679   do
     1680   on error undo, return error
     1681   :
     1682       define variable v-upper-code    as integer           no-undo.
     1683       define buffer buf_cli-grp       for ub.cli-grp.
     1684       define buffer buf_upper_cli-grp for ub.cli-grp.
     1685       find first buf_cli-grp no-lock
     1686            where buf_cli-grp.node-code = p-node-code
     1687       no-error.
     1688       if not available buf_cli-grp
     1689       then do:
     1690           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1691       end.
     1692       assign
     1693           p-full-name  = ""
     1694           v-upper-code = 1
     1695       .
     1696       do while buf_cli-grp.upper-code <> 0
     1697       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1698       :
     1699           assign
     1700               p-full-name  = buf_cli-grp.node-name
     1701                            + (if p-full-name <> "" then chr(47) else "")
     1702                            + p-full-name
     1703               v-upper-code = buf_cli-grp.upper-code
     1704           .
     1705           find first buf_cli-grp no-lock
     1706                where buf_cli-grp.node-code = v-upper-code
     1707           no-error.
     1708           if not available buf_cli-grp
     1709           then do:
     1710               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1711                                   + string( v-upper-code )
     1712                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1713           end.
     1714       end.
     1715       assign
     1716       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1717       .
     1718   end.
     1719   end .
     1720   procedure cgrplib-get-node-from-full-name :
     1721   define input parameter p-full-name as character no-undo .
     1722   define output parameter p-node-code as integer no-undo .
     1723   define variable v-ii as integer no-undo .
     1724   define variable v-upper-code as integer no-undo .
     1725   define variable v-root-code as integer no-undo .
     1726   define variable v-entry as character no-undo .
     1727   define buffer buf_cli-grp       for ub.cli-grp.
     1728   do
     1729   on error undo, return error
     1730   :
     1731     find first buf_cli-grp no-lock
     1732         where buf_cli-grp.upper-code = 0
     1733     no-error .
     1734     if not available buf_cli-grp
     1735     then do:
     1736         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1737     end.
     1738     else do:
     1739       assign
     1740       v-root-code = buf_cli-grp.node-code
     1741       .
     1742     end.
     1743     v-upper-code = v-root-code.
     1744     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1745       assign
     1746       v-entry = entry(v-ii, p-full-name, chr(47)).
     1747       if v-entry = '' then leave.
     1748       find first buf_cli-grp no-lock where
     1749                 buf_cli-grp.node-name = v-entry
     1750             and buf_cli-grp.upper-code = v-upper-code
     1751             no-error.
     1752       if not available buf_cli-grp then do:
     1753         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1754       end.
     1755       else do:
     1756         p-node-code = buf_cli-grp.node-code.
     1757         v-upper-code = buf_cli-grp.node-code.
     1758       end.
     1759     end.
     1760   end.
     1761   end .
     1762   procedure cgrplib-get-root-code :
     1763   do
     1764   on error undo, return error
     1765   :
     1766   define output parameter p-root-code as integer      no-undo.
     1767       define buffer buf_cli-grp       for ub.cli-grp.
     1768       find first buf_cli-grp no-lock
     1769           where buf_cli-grp.upper-code = 0
     1770       no-error .
     1771       if not available buf_cli-grp
     1772       then do:
     1773           undo, return error .
     1774       end.
     1775       else do:
     1776           assign
     1777               p-root-code = buf_cli-grp.node-code
     1778           .
     1779       end.
     1780   end.
     1781   end procedure.
     1782   procedure cgrplib-find-grp-by-full-name :
     1783   do
     1784   on error undo, return error
     1785   :
     1786   define input parameter p-search-name  as character    no-undo.
     1787   define input parameter p-fill-path    as logical      no-undo.
     1788       define variable v-upper-code    as integer          no-undo.
     1789       define variable v-not-found     as logical init yes no-undo.
     1790       define variable v-counter       as integer           no-undo.
     1791       define variable v-level         as integer           no-undo.
     1792       define variable v-full-name     as character         no-undo.
     1793       define variable v-sort-name     as character         no-undo.
     1794       define buffer buf_cli-grp       for ub.cli-grp.
     1795       assign
     1796           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1797       .
     1798       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     1799       if error-status :error
     1800       then do:
     1801           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     1802       end.
     1803       assign
     1804           v-full-name  = ""
     1805           v-level      = num-entries( p-search-name, chr(2) )
     1806       .
     1807       for each temp_cgrplib_found-grp
     1808       :
     1809           delete temp_cgrplib_found-grp.
     1810       end.
     1811       start-name-analyze:
     1812       do v-counter = 1 to v-level
     1813       :
     1814           if v-counter < v-level
     1815           then do:
     1816               find first buf_cli-grp no-lock
     1817                    where buf_cli-grp.upper-code = v-upper-code
     1818                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1819               no-error .
     1820               if not available buf_cli-grp
     1821               then do:
     1822                   assign
     1823                       v-full-name  = p-search-name
     1824                       v-sort-name  = p-search-name
     1825                   .
     1826                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1827               end.
     1828               else do:
     1829                   assign
     1830                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     1831                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     1832                       v-upper-code = buf_cli-grp.node-code
     1833                   .
     1834                   if p-fill-path = yes
     1835                   then do:
     1836                       create temp_cgrplib_found-grp.
     1837                       assign
     1838                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     1839                           temp_cgrplib_found-grp.sort-name = v-sort-name
     1840                           temp_cgrplib_found-grp.node-code = v-upper-code
     1841                           temp_cgrplib_found-grp.level     = v-counter
     1842                       .
     1843                   end.
     1844               end.
     1845           end.
     1846           else do:
     1847               for each buf_cli-grp no-lock
     1848                  where buf_cli-grp.upper-code = v-upper-code
     1849                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1850               :
     1851                   assign
     1852                       v-not-found = no
     1853                   .
     1854                   create temp_cgrplib_found-grp.
     1855                   assign
     1856                       temp_cgrplib_found-grp.full-name = v-full-name
     1857                                                           + ( if v-full-name = "" then "" else chr(47) )
     1858                                                           + buf_cli-grp.node-name + chr(47)
     1859                       temp_cgrplib_found-grp.sort-name = v-sort-name
     1860                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1861                                                           + buf_cli-grp.node-name
     1862                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     1863                       temp_cgrplib_found-grp.level     = v-level
     1864                   .
     1865               end.
     1866               if v-not-found = yes
     1867               then do:
     1868                   assign
     1869                       v-full-name  = p-search-name
     1870                       v-sort-name  = p-search-name
     1871                   .
     1872                   for each temp_cgrplib_found-grp
     1873                   :
     1874                       delete temp_cgrplib_found-grp.
     1875                   end.
     1876                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1877               end.
     1878           end.
     1879       end.
     1880   end.
     1881   end procedure.
     1882   procedure cgrplib-find-all-subgroup :
     1883   do
     1884   on error undo, return error
     1885   :
     1886   define input parameter p-start-node-code    as integer      no-undo.
     1887   define input parameter p-terminal-only      as logical      no-undo.
     1888       define variable v-start-full-name   as character     no-undo.
     1889       define variable v-start-sort-name   as character     no-undo.
     1890       define variable v-not-found         as logical       no-undo.
     1891       define variable v-is-terminal       as logical       no-undo.
     1892       define variable v-d-pcnt            as decimal       no-undo.
     1893       define buffer buf_cli-grp           for ub.cli-grp.
     1894       create temp_cfound-result-nodelist.
     1895       assign
     1896           temp_cfound-result-nodelist.node-code = p-start-node-code
     1897           temp_cfound-result-nodelist.processed = no
     1898       .
     1899       run cli-grplib-get-full-name in this-procedure (
     1900             input p-start-node-code
     1901           , output v-start-full-name
     1902       ).
     1903       run cli-grplib-get-sort-name in this-procedure (
     1904             input p-start-node-code
     1905           , output v-start-sort-name
     1906       ).
     1907       process-nodes:
     1908       do while yes
     1909       :
     1910           find first temp_cfound-result-nodelist
     1911                where temp_cfound-result-nodelist.node-code = p-start-node-code
     1912           .
     1913           assign
     1914               temp_cfound-result-nodelist.processed = yes
     1915           .
     1916           for each buf_cli-grp no-lock
     1917              where buf_cli-grp.upper-code = p-start-node-code
     1918           on error undo, return error
     1919           :
     1920               run cgrplib-is-terminal in this-procedure (
     1921                     input buf_cli-grp.node-code
     1922                   , output v-is-terminal
     1923               ).
     1924               if v-is-terminal = yes
     1925               then do:
     1926                   create temp_cgrplib_found-grp.
     1927                   assign
     1928                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1929                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     1930                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1931                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     1932                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1933                       temp_cgrplib_found-grp.is-terminal = yes
     1934                   .
     1935                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     1936                  if not error-status:error then do:
     1937                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     1938                  end.
     1939                  else do:
     1940                    temp_cgrplib_found-grp.d-pcnt = ?.
     1941                  end.
     1942               end.
     1943               else do:
     1944                   create temp_cfound-result-nodelist.
     1945                   assign
     1946                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     1947                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1948                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     1949                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1950                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     1951                       temp_cfound-result-nodelist.processed = no
     1952                   .
     1953                   if p-terminal-only = no
     1954                   then do:
     1955                       create temp_cgrplib_found-grp.
     1956                       assign
     1957                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1958                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     1959                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1960                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     1961                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     1962                           temp_cgrplib_found-grp.is-terminal = no
     1963                       .
     1964                   end.
     1965               end.
     1966           end.
     1967           find first temp_cfound-result-nodelist
     1968                where temp_cfound-result-nodelist.processed = no
     1969           no-error.
     1970           if not available temp_cfound-result-nodelist
     1971           then do:
     1972               leave process-nodes.
     1973           end.
     1974           else do:
     1975               assign
     1976                   p-start-node-code = temp_cfound-result-nodelist.node-code
     1977                   v-start-full-name = temp_cfound-result-nodelist.full-name
     1978                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     1979               .
     1980           end.
     1981       end.
     1982   end.
     1983   end procedure.
     1984   procedure cgrplib-expand-name :
     1985   do
     1986   on error undo, return error
     1987   :
     1988   define input parameter p-start-name as character        no-undo.
     1989   define output parameter p-end-name  as character        no-undo.
     1990       define variable v-is-terminal     as logical           no-undo.
     1991       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     1992       run cgrplib-find-grp-by-full-name in this-procedure (
     1993             input p-start-name
     1994           , input no
     1995       ) no-error.
     1996       run cgrplib-get-max-substring in this-procedure (
     1997                   input length( p-start-name )
     1998                 , output p-end-name
     1999       ) no-error .
     2000       if error-status :error
     2001       then do:
     2002           assign
     2003               p-end-name = ""
     2004           .
     2005       end.
     2006       else do:
     2007           find first temp_cgrplib_found-grp
     2008               where temp_cgrplib_found-grp.full-name = p-end-name
     2009           no-error.
     2010           if available temp_cgrplib_found-grp
     2011           then do:
     2012               find first buf_temp_cgrplib_found-grp
     2013                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     2014                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     2015               no-error.
     2016               if not available buf_temp_cgrplib_found-grp
     2017               then do:
     2018                   run cgrplib-is-terminal in this-procedure (
     2019                       input temp_cgrplib_found-grp.node-code
     2020                       , output v-is-terminal
     2021                   ).
     2022               end.
     2023           end.
     2024       end.
     2025   end.
     2026   end procedure.
     2027   procedure cgrplib-get-max-substring :
     2028   do
     2029   on error undo, return error
     2030   :
     2031   define input parameter p-min-substring-length   as integer      no-undo.
     2032   define output parameter p-substring             as character    no-undo.
     2033           define variable v-char-counter  as integer           no-undo.
     2034           define variable v-current-char  as character         no-undo.
     2035           define variable v-names-counter  as integer           no-undo.
     2036           define variable v-base-string   as character         no-undo.
     2037           assign
     2038               v-char-counter  = p-min-substring-length
     2039           .
     2040           find first temp_cgrplib_found-grp no-error.
     2041           if not available temp_cgrplib_found-grp
     2042           then do:
     2043               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2044           end.
     2045           else do:
     2046               assign
     2047                   v-base-string = temp_cgrplib_found-grp.full-name
     2048               .
     2049               counter-block:
     2050               do while yes
     2051               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2052               :
     2053                   assign
     2054                       v-char-counter  = v-char-counter + 1
     2055                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2056                       v-names-counter = 0
     2057                   .
     2058                   compare-block:
     2059                   for each temp_cgrplib_found-grp
     2060                   :
     2061                       assign
     2062                           v-names-counter = v-names-counter + 1
     2063                       .
     2064                       if v-names-counter = 1
     2065                       then do:
     2066                           next compare-block.
     2067                       end.
     2068                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2069                       then do:
     2070                           leave counter-block.
     2071                       end.
     2072                   end.
     2073                   if v-names-counter = 1
     2074                   then do:
     2075                       assign
     2076                           p-substring = v-base-string
     2077                       .
     2078                       return.
     2079                   end.
     2080               end.
     2081               assign
     2082                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2083               .
     2084           end.
     2085   end.
     2086   end procedure.
     2087   procedure cgrplib-is-terminal :
     2088   do
     2089   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     2090   :
     2091   define input parameter p-node-code      as integer      no-undo.
     2092   define output parameter p-is-terminal   as logical      no-undo.
     2093       define buffer buf_cli-grp       for ub.cli-grp.
     2094       find first buf_cli-grp no-lock
     2095           where buf_cli-grp.upper-code = p-node-code
     2096       no-error .
     2097       if not available buf_cli-grp
     2098       then do:
     2099           assign
     2100               p-is-terminal = yes
     2101           .
     2102       end.
     2103       else do:
     2104           assign
     2105               p-is-terminal = no
     2106           .
     2107       end.
     2108   end.
     2109   end procedure.
     2110   procedure cgrplib-have-clients :
     2111   do
     2112   on error undo, return error
     2113   :
     2114   define input parameter p-node-code      as integer      no-undo.
     2115   define output parameter p-have-clients   as logical      no-undo.
     2116       define buffer buf_clients         for ub.clients.
     2117       find first buf_clients no-lock
     2118            where buf_clients.grp-code = p-node-code
     2119       no-error .
     2120       if available buf_clients
     2121       then do:
     2122           assign
     2123               p-have-clients = yes
     2124           .
     2125       end.
     2126       else do:
     2127           assign
     2128               p-have-clients = no
     2129           .
     2130       end.
     2131   end.
     2132   end procedure.
     2133   procedure cgrplib-find-by-substring :
     2134   do
     2135   on error undo, return error
     2136   :
     2137   define input parameter p-start-code         as integer      no-undo.
     2138   define input parameter p-full-search-string as character    no-undo.
     2139   define output parameter p-found-code        as integer      no-undo.
     2140   define output parameter p-full-name         as character    no-undo.
     2141       define variable v-start-code     as integer           no-undo.
     2142       define variable v-found          as logical  init no  no-undo.
     2143       define buffer buf_cli-grp       for ub.cli-grp.
     2144       search-grp:
     2145       for each buf_cli-grp no-lock
     2146           where buf_cli-grp.node-code > p-start-code
     2147       :
     2148           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     2149           then do:
     2150               assign
     2151                   p-found-code = buf_cli-grp.node-code
     2152                   v-found      = yes
     2153               .
     2154               run cli-grplib-get-full-name in this-procedure (
     2155                     input p-found-code
     2156                   , output p-full-name
     2157               ) no-error .
     2158               if error-status :error
     2159               then do:
     2160                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2161               end.
     2162               leave search-grp.
     2163           end.
     2164       end.
     2165       if v-found = yes
     2166       then do:
     2167       end.
     2168       else do:
     2169           assign
     2170               p-full-name  = ""
     2171               p-found-code = 0
     2172           .
     2173       end.
     2174   end.
     2175   end procedure.
     2176   procedure cgrplib-analyze-grp-name :
     2177   do
     2178   on error undo, return error
     2179   :
     2180   define input parameter p-grp-name       as character            no-undo.
     2181   define input parameter p-upper-code     as integer              no-undo.
     2182   define output parameter p-error-message as character init ""    no-undo.
     2183       define variable v-char-list     as character    no-undo.
     2184       define variable v-char-counter  as integer      no-undo.
     2185       define variable v-full-name     as character    no-undo.
     2186       if p-grp-name = "" then do:
     2187           assign
     2188               p-error-message = "Название группы не может быть пустым.".
     2189           .
     2190       end.
     2191       else do:
     2192           assign
     2193               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2194           .
     2195           do v-char-counter = 1 to num-entries( v-char-list )
     2196           :
     2197               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2198               then do:
     2199                   assign
     2200                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2201                   .
     2202                   return.
     2203               end.
     2204           end.
     2205           run cli-grplib-get-full-name in this-procedure (
     2206                 input p-upper-code
     2207               , output v-full-name
     2208           ) no-error .
     2209           if error-status :error
     2210           then do:
     2211               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2212           end.
     2213           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2214           then do:
     2215               assign
     2216                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2217               .
     2218           end.
     2219       end.
     2220   end.
     2221   end procedure.
     2222   procedure cgrplib-get-lvl-num :
     2223   define input parameter p-node-code  as integer      no-undo.
     2224   define output parameter p-lvl-num   as integer      no-undo.
     2225       define variable v-full-name    as character    no-undo.
     2226   do
     2227   on error undo, return error
     2228   :
     2229       run cli-grplib-get-full-name in this-procedure (
     2230             input p-node-code
     2231           , output v-full-name
     2232       ).
     2233       assign
     2234           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2235       .
     2236       if p-lvl-num = -1
     2237       then do:
     2238           assign
     2239               p-lvl-num = 0
     2240           .
     2241       end.
     2242   end.
     2243   end procedure.
     2244   PROCEDURE cgrplib-get-pcnt-value :
     2245   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     2246   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     2247   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     2248   define buffer buf_dis-rule for ub.dis-rule.
     2249   find first buf_dis-grp-rule no-lock where
     2250             buf_dis-grp-rule.classif-type = 'cli-grp':U
     2251         and buf_dis-grp-rule.node-code = p-node-code
     2252         and buf_dis-grp-rule.host-code = 0
     2253         and buf_dis-grp-rule.obj-type = '':U
     2254         and buf_dis-grp-rule.obj-code = 0
     2255         and buf_dis-grp-rule.pos-type = '-':U
     2256         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     2257   if available buf_dis-grp-rule then do:
     2258     find first buf_dis-rule no-lock where
     2259               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     2260     if available buf_dis-rule then do:
     2261       assign
     2262       p-pcnt-value        = buf_dis-rule.discnt-value.
     2263       .
     2264     end.
     2265   end.
     2266   END PROCEDURE.
