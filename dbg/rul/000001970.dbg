     2471   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     2472   define variable v-xmllib-dirname            as character    no-undo .
     2473   define variable v-xmllib-filename           as character    no-undo .
     2474   define variable v-xmllib-log-filename       as character    no-undo .
     2475   define variable v-xmllib-log-handle         as handle       no-undo .
     2476   define variable v-xmllib-log-proc-name      as character    no-undo .
     2477   define variable v-xmllib-error-status       as logical      no-undo .
     2478   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     2479   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     2480   define variable v-xmllib-codepage-convert   as logical      no-undo .
     2481   define variable v-xmllib-codepage-source    as character    no-undo .
     2482   define variable v-xmllib-codepage-target    as character    no-undo .
     2483   procedure xmllib-clear-parse-data :
     2484   do
     2485   on error undo, return error
     2486   :
     2487       empty temp-table temp_xmllib_rec-list.
     2488       empty temp-table temp_xmllib_rec-fld-list.
     2489       empty temp-table temp_xmllib_rec.
     2490       empty temp-table temp_xmllib_rec-fld.
     2491   end.
     2492   end procedure.
     2493   procedure xmllib-add-rec-fld :
     2494   define input parameter p-rec-name       as character        no-undo.
     2495   define input parameter p-rec-fld-name   as character        no-undo.
     2496       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2497       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2498   do
     2499   for buf_rec-list
     2500     , buf_rec-fld-list
     2501   on error undo, return error
     2502   :
     2503       find first buf_rec-list
     2504            where buf_rec-list.recName = p-rec-name
     2505       no-error.
     2506       if not available buf_rec-list
     2507       then do:
     2508           create buf_rec-list.
     2509           assign
     2510               buf_rec-list.recName        = p-rec-name
     2511               buf_rec-list.recOpenLine    = 0
     2512               buf_rec-list.recCloseLine   = 0
     2513               buf_rec-list.closed         = yes
     2514           .
     2515       end.
     2516       find first buf_rec-fld-list
     2517            where buf_rec-fld-list.recName = p-rec-name
     2518              and buf_rec-fld-list.fldName = p-rec-fld-name
     2519       no-error.
     2520       if not available buf_rec-fld-list
     2521       then do:
     2522           create buf_rec-fld-list.
     2523           assign
     2524               buf_rec-fld-list.recName        = p-rec-name
     2525               buf_rec-fld-list.fldName        = p-rec-fld-name
     2526               buf_rec-fld-list.fldOpenLine    = 0
     2527               buf_rec-fld-list.fldCloseLine   = 0
     2528               buf_rec-fld-list.closed         = yes
     2529           .
     2530       end.
     2531   end.
     2532   end procedure.
     2533   procedure xmllib-tag-open:
     2534   define input parameter v-tag-level  as integer      no-undo.
     2535   define input parameter v-tag-name   as character    no-undo.
     2536   define input parameter v-tag-value  as character    no-undo.
     2537   do
     2538   on error undo, return error
     2539   :
     2540       assign
     2541           v-tag-name = trim( v-tag-name )
     2542       .
     2543       put stream stmXMLOut unformatted
     2544           substitute( "&1&2<&3&4&5>"
     2545               , chr(10)
     2546               , fill(" ", 4 * v-tag-level)
     2547               , v-tag-name
     2548               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     2549               , v-tag-value
     2550           )
     2551       .
     2552   end.
     2553   end procedure.
     2554   procedure xmllib-tag-put:
     2555   define input parameter v-tag-level      as integer      no-undo.
     2556   define input parameter v-tag-name       as character    no-undo.
     2557   define input parameter v-tag-value      as character    no-undo.
     2558   define input parameter v-empty-mode     as integer      no-undo.
     2559   do
     2560   on error undo, return error
     2561   :
     2562       assign
     2563           v-tag-name = trim( v-tag-name )
     2564       .
     2565       if  v-empty-mode = 1
     2566       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     2567       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     2568       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     2569       then do:
     2570           run xmlchar-encode in this-procedure (
     2571                 input v-tag-value
     2572               , output v-tag-value
     2573           ).
     2574           put stream stmXMLOut unformatted
     2575               substitute( "&1&2<&3>&4</&3>"
     2576                   , chr(10)
     2577                   , fill(" ":U, 4 * v-tag-level)
     2578                   , v-tag-name
     2579                   , v-tag-value
     2580               )
     2581           .
     2582       end.
     2583   end.
     2584   end procedure.
     2585   procedure xmllib-tag-put-null :
     2586   define input parameter p-tag-level  as integer      no-undo.
     2587   define input parameter p-tag-name   as character    no-undo.
     2588   do
     2589   on error undo, return error
     2590   :
     2591       assign
     2592           p-tag-name = trim( p-tag-name )
     2593       .
     2594       put stream stmXMLOut unformatted
     2595           substitute( '&1&2<&3 nil="true" /&3>'
     2596               , chr(10)
     2597               , fill(" ":U, 4 * p-tag-level)
     2598               , p-tag-name
     2599           )
     2600       .
     2601   end.
     2602   end procedure.
     2603   procedure xmllib-tag-close:
     2604   define input parameter v-tag-level as integer      no-undo.
     2605   define input parameter v-tag-name  as character    no-undo.
     2606   do
     2607   on error undo, return error
     2608   :
     2609       assign
     2610           v-tag-name = trim( v-tag-name )
     2611       .
     2612       put stream stmXMLOut unformatted
     2613           substitute( "&1&2</&3>"
     2614               , chr(10)
     2615               , fill( " ":U, 4 * v-tag-level)
     2616               , v-tag-name
     2617           )
     2618       .
     2619   end.
     2620   end procedure.
     2621   procedure xmllib-write-log:
     2622   define input parameter v-filename   as character    no-undo.
     2623   define input parameter v-log-level  as integer      no-undo.
     2624   define input parameter v-out-string as character    no-undo.
     2625   do
     2626   on error undo, return error
     2627   :
     2628       output stream stmXMLLog to value( v-filename ) append.
     2629       put stream stmXMLLog unformatted
     2630           chr(10)
     2631       .
     2632       put stream stmXMLLog unformatted
     2633           ( if v-log-level = 0
     2634             or v-out-string = "&DLine":U
     2635             or v-out-string = "&Line":U
     2636             then "":U
     2637             else cur-time-string-sec() + " ":U )
     2638       .
     2639       put stream stmXMLLog unformatted
     2640           ( if v-out-string = "&Line":U
     2641             then fill( "-":U, 80 )
     2642             else if v-out-string = "&DLine":U
     2643                  then fill( "=":U, 80 )
     2644                  else v-out-string )
     2645       .
     2646       output stream stmXMLLog close.
     2647   end.
     2648   end procedure.
     2649   procedure xmllib-write-edt:
     2650   define input parameter v-editor-handle    as handle       no-undo.
     2651   define input parameter v-log-level        as integer      no-undo.
     2652   define input parameter v-out-string       as character    no-undo.
     2653   do
     2654   on error undo, return error
     2655   :
     2656       if valid-handle ( v-editor-handle )
     2657       then do:
     2658           v-editor-handle :move-to-eof().
     2659           v-editor-handle :insert-string( ( if v-log-level = 0
     2660                                             or v-out-string = "&DLine":U
     2661                                             or v-out-string = "&Line":U
     2662                                             then "":U
     2663                                             else cur-time-string-sec() + " ":U
     2664                                         ) ).
     2665           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     2666                                             then fill( "-":U, 80 )
     2667                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     2668                                             else fill( " ":U, v-log-level) + v-out-string
     2669                                         ) ).
     2670           v-editor-handle :insert-string( chr(10) ).
     2671       end.
     2672   end.
     2673   end procedure.
     2674   procedure xmllib-show-cnt:
     2675   define input parameter v-fillin-handle     as handle   no-undo.
     2676   do
     2677   on error undo, return error
     2678   :
     2679       if valid-handle( v-fillin-handle )
     2680       then do:
     2681           assign
     2682               v-fillin-handle :visible = true
     2683           .
     2684       end.
     2685   end.
     2686   end procedure.
     2687   procedure xmllib-hide-cnt:
     2688   define input parameter v-fillin-handle     as handle   no-undo.
     2689   do
     2690   on error undo, return error
     2691   :
     2692       if valid-handle( v-fillin-handle )
     2693       then do:
     2694           assign v-fillin-handle :visible = false.
     2695       end.
     2696   end.
     2697   end procedure.
     2698   procedure xmllib-write-cnt:
     2699   define input parameter v-fillin-handle    as handle       no-undo.
     2700   define input parameter v-fillin-string    as character    no-undo.
     2701   do
     2702   on error undo, return error
     2703   :
     2704       if valid-handle( v-fillin-handle )
     2705       then do:
     2706           assign
     2707               v-fillin-handle :SCREEN-value = v-fillin-string
     2708           .
     2709       end.
     2710   end.
     2711   end procedure.
     2712   procedure xmllib-write-header:
     2713   define input parameter p-first-file     as logical      no-undo.
     2714   define input parameter p-xml-file-name  as character    no-undo.
     2715   define input parameter p-list-file-name as character    no-undo.
     2716   define input parameter p-file-number    as integer      no-undo.
     2717   define input parameter p-have-prev      as logical      no-undo.
     2718   define input parameter p-prev-filename  as character    no-undo.
     2719   define input parameter p-parameter-list as character    no-undo.
     2720       define variable v-counter    as integer        no-undo.
     2721   do
     2722   on error undo, return error
     2723   :
     2724       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2725       put stream stmXMLOut unformatted
     2726           "<?xml version='1.0' encoding='windows-1251'?>"
     2727       .
     2728       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2729       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2730       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2731       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2732       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2733       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2734       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2735       :
     2736           run xmllib-tag-put(
     2737                 input 1
     2738               , input entry( 2 * v-counter, p-parameter-list )
     2739               , input entry( 2 * v-counter + 1, p-parameter-list )
     2740               , input 0
     2741           ).
     2742       end.
     2743       run xmllib-tag-close( input 0, input "THheader" ).
     2744       output stream stmXMLOut close.
     2745       if p-list-file-name <> "":U
     2746       then do:
     2747           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2748           if p-first-file = yes
     2749           then do:
     2750               put stream stmXMLOut unformatted
     2751                   "<?xml version='1.0' encoding='windows-1251'?>"
     2752               .
     2753               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2754           end.
     2755           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2756           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2757           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2758           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2759           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2760           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2761           :
     2762               run xmllib-tag-put(
     2763                   input 2
     2764                   , input entry( 2 * v-counter, p-parameter-list )
     2765                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2766                   , input 0
     2767               ).
     2768           end.
     2769           run xmllib-tag-close( input 1, input "THfile" ).
     2770           output stream stmXMLOut close.
     2771       end.
     2772   end.
     2773   end procedure.
     2774   procedure xmllib-write-footer:
     2775   define input parameter p-last-file      as logical      no-undo.
     2776   define input parameter p-xml-file-name  as character    no-undo.
     2777   define input parameter p-list-file-name as character    no-undo.
     2778   define input parameter p-have-next      as logical      no-undo.
     2779   define input parameter p-next-file-name as character    no-undo.
     2780       define variable v-error-num     as integer           no-undo.
     2781   do
     2782   on error undo, return error
     2783   :
     2784       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2785       if p-have-next = yes
     2786       then do:
     2787           run xmllib-tag-open( input 0, input "footer", "" ).
     2788           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2789           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2790           run xmllib-tag-close( input 0, input "footer" ).
     2791       end.
     2792       run xmllib-tag-close( input 0, input "root" ).
     2793       output stream stmXMLOut close.
     2794       run bge/os_copy.p (
     2795             input "M"
     2796           , input p-xml-file-name + "tmp"
     2797           , input p-xml-file-name + "xml"
     2798           , output v-error-num
     2799       ).
     2800       if p-last-file = yes
     2801       and p-list-file-name <> "":U
     2802       then do:
     2803           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2804               run xmllib-tag-close( input 0, input "OpenXML" ).
     2805           output stream stmXMLOut close.
     2806           run bge/os_copy.p (
     2807                 input "M"
     2808               , input p-list-file-name + "tmp"
     2809               , input p-list-file-name + "xml":U
     2810               , output v-error-num
     2811           ).
     2812       end.
     2813   end.
     2814   end procedure.
     2815   procedure xmllib-filename :
     2816   define input parameter p-subdir             as character        no-undo.
     2817   define input parameter p-prefix             as character    no-undo.
     2818   define output parameter p-xml-file-name     as character    no-undo.
     2819   define output parameter p-log-file-name     as character    no-undo.
     2820   define output parameter p-list-file-name    as character    no-undo.
     2821       define variable v-home-dir  as character    no-undo.
     2822       define variable v-error-num as integer      no-undo.
     2823   do
     2824   on error undo, return error
     2825   :
     2826       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2827       if v-home-dir = ?
     2828       then do:
     2829           message
     2830             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2831             skip "Нет параметра oxml-dir в секции [OXML]."
     2832             skip(1)
     2833             skip "Обратитесь к администратору."
     2834           view-as alert-box error.
     2835           undo, return error .
     2836       end.
     2837       if p-subdir <> "":U
     2838       then do:
     2839           assign
     2840               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2841           .
     2842       end.
     2843       run gbl/dir-cre.p (
     2844           input v-home-dir
     2845       ) no-error.
     2846       if error-status :error
     2847       then do:
     2848           message
     2849             skip "Неверно задан каталог экспорта в ini-файле."
     2850             skip "Не удаётся создать каталог, указанный параметром"
     2851             skip "oxml-dir в секции [OXML]."
     2852             skip(1)
     2853             skip "Обратитесь к администратору."
     2854           view-as alert-box error.
     2855           undo, return error .
     2856       end.
     2857       run bge/genfname.p (
     2858             input v-home-dir
     2859           , input p-prefix
     2860           , input ""
     2861           , input "xml"
     2862           , input "tmp"
     2863           , output p-xml-file-name
     2864       ).
     2865       assign
     2866           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2867           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2868           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2869       .
     2870   end.
     2871   end procedure.
     2872   procedure xmllib-check-file-size :
     2873   define input parameter p-out-filename   as character    no-undo.
     2874   define output parameter p-is-big        as logical      no-undo.
     2875       define variable v-current-position    as integer        no-undo.
     2876   do
     2877   on error undo, return error
     2878   :
     2879       assign
     2880           v-current-position = seek( stmXMLOut )
     2881       .
     2882       if v-current-position / 1024 / 1024  >= 100
     2883       then do:
     2884           assign
     2885               p-is-big = yes
     2886           .
     2887       end.
     2888   end.
     2889   end procedure.
     2890   procedure xmllib-parse-file :
     2891   define input parameter p-full-filename      as character        no-undo.
     2892       define variable v-num-dirs              as integer      no-undo .
     2893       define variable v-str                   as character    no-undo .
     2894       define variable v-str-count             as int64        no-undo .
     2895   do
     2896   on error undo, return error
     2897   :
     2898       assign
     2899           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2900           v-xmllib-error-status   = no
     2901       .
     2902       if v-num-dirs > 1
     2903       then do:
     2904           assign
     2905               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2906               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2907           .
     2908       end.
     2909       else do:
     2910           assign
     2911               v-xmllib-filename = p-full-filename
     2912               v-xmllib-dirname  = "":U
     2913           .
     2914       end.
     2915       if valid-handle(v-xmllib-prg-bar-handle)
     2916       then do:
     2917   if session :set-wait-state( "compiler" ) then.
     2918         input stream strXMLIn from value(p-full-filename) .
     2919         repeat
     2920         :
     2921           import stream strXMLIn unformatted v-str no-error .
     2922           assign
     2923             v-str-count = v-str-count + 1
     2924           .
     2925         end.
     2926         input stream strXMLIn close .
     2927   if session :set-wait-state( "" ) then.
     2928         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2929         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2930         run prg-bar_show in this-procedure .
     2931       end.
     2932       create sax-reader v-xmllib-sax-reader-handle.
     2933       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2934       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2935       if error-status :error
     2936       then do:
     2937           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2938                                                                       ,vss-workfile
     2939                                                                       ,vss-revision
     2940                                                                       ,vss-description
     2941                                                                       ,chr(10)
     2942                                                                       ,return-value
     2943                                                                       ,trim(error-status :get-message(1))
     2944                                                                       ,trim(error-status :get-message(2))
     2945                                                                       ,trim(error-status :get-message(3)))
     2946                                                     ).
     2947           undo, return error .
     2948       end.
     2949       if v-xmllib-error-status <> no
     2950       then do:
     2951           run xmllib-parse-error in this-procedure (
     2952               input "*** При обработке XML файла были ошибки."
     2953           ).
     2954           delete object v-xmllib-sax-reader-handle.
     2955       end.
     2956       delete object v-xmllib-sax-reader-handle.
     2957       if valid-handle(v-xmllib-prg-bar-handle)
     2958       then do:
     2959         run prg-bar_delete in this-procedure .
     2960       end.
     2961   end.
     2962   end procedure.
     2963   procedure xmllib-parse-progressive :
     2964   define input parameter p-full-filename      as character no-undo .
     2965   define input parameter p-pack-data          as memptr no-undo .
     2966   define input parameter p-parse-first        as logical no-undo .
     2967   define input parameter p-first-err          as logical no-undo .
     2968   define output parameter p-parse-status as integer no-undo .
     2969   define variable v-num-dirs              as integer no-undo .
     2970   define variable glog                    as logical no-undo .
     2971   define variable v-pack-size             as int64 no-undo .
     2972   do
     2973   on error undo, return error
     2974   :
     2975     if p-parse-first then do:
     2976       if valid-handle(v-xmllib-sax-reader-handle)
     2977       then do:
     2978       end.
     2979       assign
     2980           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2981           v-xmllib-error-status   = no
     2982       .
     2983       if v-num-dirs > 1
     2984       then do:
     2985           assign
     2986               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2987               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2988           .
     2989       end.
     2990       else do:
     2991           assign
     2992               v-xmllib-filename = p-full-filename
     2993               v-xmllib-dirname  = "":U
     2994           .
     2995       end.
     2996       create sax-reader v-xmllib-sax-reader-handle.
     2997       v-pack-size = get-size (p-pack-data) .
     2998       if v-pack-size > 0 then
     2999         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     3000       else
     3001         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     3002       if error-status :error
     3003       or not glog
     3004       then do:
     3005         delete object v-xmllib-sax-reader-handle.
     3006         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3007                                                                     ,vss-workfile
     3008                                                                     ,vss-revision
     3009                                                                     ,vss-description
     3010                                                                     ,chr(10)
     3011                                                                     ,return-value
     3012                                                                     ,trim(error-status :get-message(1))
     3013                                                                     ,trim(error-status :get-message(2))
     3014                                                                     ,trim(error-status :get-message(3)) )
     3015                                                   ).
     3016         undo, return error .
     3017       end.
     3018       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     3019     end.
     3020     else do:
     3021       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     3022     end.
     3023     if error-status :error
     3024     then do:
     3025       delete object v-xmllib-sax-reader-handle.
     3026       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3027                                                                   ,vss-workfile
     3028                                                                   ,vss-revision
     3029                                                                   ,vss-description
     3030                                                                   ,chr(10)
     3031                                                                   ,return-value
     3032                                                                   ,trim(error-status :get-message(1))
     3033                                                                   ,trim(error-status :get-message(2))
     3034                                                                   ,trim(error-status :get-message(3)) )
     3035                                                 ).
     3036       undo, return error .
     3037     end.
     3038     if v-xmllib-error-status <> no
     3039     then do:
     3040       run xmllib-parse-error in this-procedure (
     3041           input "*** При обработке XML файла были ошибки."
     3042       ).
     3043       if p-first-err then do:
     3044         delete object v-xmllib-sax-reader-handle.
     3045       end.
     3046       else do:
     3047         v-xmllib-error-status = no.
     3048       end.
     3049     end.
     3050     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     3051       p-parse-status = SAX-COMPLETE.
     3052       delete object v-xmllib-sax-reader-handle.
     3053       return '':U.
     3054     end.
     3055     else do:
     3056       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     3057       return '':U.
     3058     end.
     3059   end.
     3060   end procedure.
     3061   procedure StartElement :
     3062   define input parameter p-name-space     as character        no-undo.
     3063   define input parameter p-local-name     as character        no-undo.
     3064   define input parameter p-q-name         as character        no-undo.
     3065   define input parameter p-attributes     as handle           no-undo.
     3066       define buffer buf_rec             for temp_xmllib_rec.
     3067       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3068       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3069       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3070   do
     3071   for buf_rec
     3072     , buf_rec-fld
     3073     , buf_rec-list
     3074     , buf_rec-fld-list
     3075   on error undo, return error
     3076   :
     3077       if valid-handle(v-xmllib-prg-bar-handle)
     3078       then do:
     3079         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     3080       end.
     3081       find first buf_rec-list
     3082            where buf_rec-list.recName = p-q-name
     3083       no-error.
     3084       if available buf_rec-list
     3085       then do:
     3086           if buf_rec-list.closed = no
     3087           then do:
     3088               find first buf_rec-fld-list
     3089                    where buf_rec-fld-list.recName = buf_rec-list.recName
     3090                      and buf_rec-fld-list.fldName = p-q-name
     3091               no-error.
     3092               if available buf_rec-fld-list
     3093               and buf_rec-list.recName = buf_rec-fld-list.recName
     3094               then do:
     3095                   if buf_rec-fld-list.closed = no
     3096                   then do:
     3097                       run xmllib-parse-error in this-procedure (
     3098                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     3099                                           , p-q-name
     3100                                           , p-q-name
     3101                                           , buf_rec-fld-list.fldOpenLine
     3102                                           )
     3103                       ).
     3104                   end.
     3105                   else do:
     3106                       run xmllib-parse-rec-fld-open in this-procedure (
     3107                             input buf_rec-list.recName
     3108                           , input buf_rec-list.recLevel
     3109                           , input buf_rec-fld-list.fldName
     3110                       ).
     3111                       assign
     3112                           buf_rec-fld-list.closed         = no
     3113                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3114                           buf_rec-fld-list.fldCloseLine   = 0
     3115                       .
     3116                   end.
     3117               end.
     3118               else do:
     3119                   assign
     3120                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     3121                   .
     3122                   run xmllib-parse-rec-open in this-procedure (
     3123                         input buf_rec-list.recName
     3124                       , input buf_rec-list.recLevel
     3125                   ).
     3126                   assign
     3127                       buf_rec-list.closed         = no
     3128                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3129                       buf_rec-list.recCloseLine   = 0
     3130                   .
     3131               end.
     3132           end.
     3133           else do:
     3134               run xmllib-parse-rec-open in this-procedure (
     3135                     input buf_rec-list.recName
     3136                   , input buf_rec-list.recLevel
     3137               ).
     3138               assign
     3139                   buf_rec-list.closed         = no
     3140                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3141                   buf_rec-list.recCloseLine   = 0
     3142               .
     3143           end.
     3144       end.
     3145       else do:
     3146           open-record:
     3147           for each buf_rec-fld-list
     3148              where buf_rec-fld-list.fldName = p-q-name
     3149           :
     3150               find first buf_rec-list
     3151                    where buf_rec-list.recName = buf_rec-fld-list.recName
     3152                      and buf_rec-list.closed  = no
     3153               no-error.
     3154               if available buf_rec-list
     3155               then do:
     3156                   run xmllib-parse-rec-fld-open in this-procedure (
     3157                         input buf_rec-list.recName
     3158                       , input buf_rec-list.recLevel
     3159                       , input buf_rec-fld-list.fldName
     3160                   ).
     3161                   assign
     3162                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     3163                       buf_rec-fld-list.closed         = no
     3164                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3165                       buf_rec-fld-list.fldCloseLine   = 0
     3166                   .
     3167                   leave open-record.
     3168               end.
     3169           end.
     3170       end.
     3171   end.
     3172   end procedure.
     3173   procedure Characters :
     3174   define input parameter p-char-data  as memptr.
     3175   define input parameter p-numchars   as integer.
     3176       define variable v-data-string    as character    no-undo.
     3177       define variable v-cp-utf8           as integer no-undo init 65001 .
     3178       define variable v-cp-windows1251    as integer no-undo init 1251 .
     3179       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     3180       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     3181       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     3182       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     3183   do
     3184   for buf_xmllib_rec
     3185     , buf_xmllib_rec-fld
     3186     , buf_xmllib_rec-list
     3187     , buf_xmllib_rec-fld-list
     3188   on error undo, return error
     3189   :
     3190       find first buf_xmllib_rec-list
     3191            where buf_xmllib_rec-list.closed = no
     3192       no-error.
     3193       if available buf_xmllib_rec-list
     3194       then do:
     3195           find first buf_xmllib_rec-fld-list
     3196                where buf_xmllib_rec-fld-list.closed = no
     3197           no-error.
     3198           if available buf_xmllib_rec-fld-list
     3199           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     3200           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     3201           then do:
     3202               find last buf_xmllib_rec
     3203                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     3204                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     3205                     and buf_xmllib_rec.closed   = no
     3206               use-index nm
     3207               no-error.
     3208               if available buf_xmllib_rec
     3209               then do:
     3210                   find last buf_xmllib_rec-fld
     3211                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     3212                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     3213                         and buf_xmllib_rec-fld.closed = no
     3214                   use-index nm
     3215                   no-error.
     3216                   if available buf_xmllib_rec-fld
     3217                   then do:
     3218                       assign
     3219                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     3220                       .
     3221                       if v-xmllib-codepage-convert = yes
     3222                       then do:
     3223                         assign
     3224                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     3225                         .
     3226                       end.
     3227                       run xmlchar-decode in this-procedure (
     3228                           input v-data-string
     3229                           , output v-data-string
     3230                       ).
     3231                       assign
     3232                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     3233                       .
     3234                   end.
     3235               end.
     3236           end.
     3237       end.
     3238   end.
     3239   end procedure.
     3240   procedure EndElement :
     3241   define input parameter p-name-space     as character        no-undo.
     3242   define input parameter p-local-name     as character        no-undo.
     3243   define input parameter p-q-name         as character        no-undo.
     3244       define buffer buf_rec             for temp_xmllib_rec.
     3245       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3246       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3247       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3248   do
     3249   for buf_rec
     3250     , buf_rec-fld
     3251     , buf_rec-list
     3252     , buf_rec-fld-list
     3253   on error undo, return error
     3254   :
     3255       find last buf_rec-list
     3256           where buf_rec-list.recName = p-q-name
     3257       use-index pi
     3258       no-error.
     3259       if available buf_rec-list
     3260       then do:
     3261           if buf_rec-list.closed = yes
     3262           then do:
     3263               run xmllib-parse-error in this-procedure (
     3264                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     3265                                   , p-q-name
     3266                                   )
     3267               ).
     3268           end.
     3269           else do:
     3270               find last buf_rec
     3271                   where buf_rec.recName  = buf_rec-list.recName
     3272                     and buf_rec.recLevel = buf_rec-list.recLevel
     3273                     and buf_rec.closed   = no
     3274               use-index nm
     3275               no-error.
     3276               if not available buf_rec
     3277               then do:
     3278                   run xmllib-parse-error in this-procedure (
     3279                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     3280                                       , p-q-name
     3281                                       , buf_rec-list.recLevel
     3282                                       )
     3283                   ).
     3284               end.
     3285               else do:
     3286                   find first buf_rec-fld-list
     3287                        where buf_rec-fld-list.recName  = buf_rec.recName
     3288                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     3289                          and buf_rec-fld-list.fldName  = p-q-name
     3290                          and buf_rec-fld-list.closed   = no
     3291                   no-error.
     3292                   if not available buf_rec-fld-list
     3293                   then do:
     3294                       if buf_rec.recName <> p-q-name
     3295                       then do:
     3296                           run xmllib-parse-error in this-procedure (
     3297                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     3298                                               , buf_rec.recName
     3299                                               )
     3300                           ).
     3301                       end.
     3302                       else do:
     3303                           assign
     3304                               buf_rec.closed              = yes
     3305                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3306                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3307                           .
     3308                           if buf_rec-list.recLevel > 0
     3309                           then do:
     3310                               assign
     3311                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     3312                               .
     3313                               for each buf_rec-fld-list
     3314                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     3315                               :
     3316                                   assign
     3317                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     3318                                   .
     3319                               end.
     3320                           end.
     3321                           else do:
     3322                               assign
     3323                                   buf_rec-list.closed         = yes
     3324                               .
     3325                           end.
     3326                       end.
     3327                   end.
     3328                   else do:
     3329                       find last buf_rec-fld
     3330                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3331                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3332                             and buf_rec-fld.closed  = no
     3333                       use-index nm
     3334                       no-error.
     3335                       if not available buf_rec-fld
     3336                       then do:
     3337                           run xmllib-parse-error in this-procedure (
     3338                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3339                                               , buf_rec-fld-list.fldName
     3340                                               , buf_rec.recName
     3341                                               , buf_rec.recLevel
     3342                                               )
     3343                           ).
     3344                       end.
     3345                       else do:
     3346                           assign
     3347                               buf_rec-fld.closed              = yes
     3348                               buf_rec-fld-list.closed         = yes
     3349                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3350                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3351                           .
     3352                       end.
     3353                   end.
     3354               end.
     3355           end.
     3356       end.
     3357       else do:
     3358           close-field-rec:
     3359           for each buf_rec-fld-list
     3360              where buf_rec-fld-list.fldName = p-q-name
     3361           :
     3362               find first buf_rec-list
     3363                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     3364                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     3365                      and buf_rec-list.closed   = no
     3366               no-error.
     3367               if available buf_rec-list
     3368               then do:
     3369                   find last buf_rec
     3370                       where buf_rec.recName  = buf_rec-list.recName
     3371                         and buf_rec.recLevel = buf_rec-list.recLevel
     3372                         and buf_rec.closed   = no
     3373                   use-index nm
     3374                   no-error.
     3375                   if not available buf_rec
     3376                   then do:
     3377                       run xmllib-parse-error in this-procedure (
     3378                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     3379                                           , p-q-name
     3380                                           )
     3381                       ).
     3382                   end.
     3383                   else do:
     3384                       find last buf_rec-fld
     3385                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3386                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3387                             and buf_rec-fld.closed  = no
     3388                       use-index nm
     3389                       no-error.
     3390                       if not available buf_rec-fld
     3391                       then do:
     3392                           run xmllib-parse-error in this-procedure (
     3393                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3394                                               , buf_rec-fld-list.fldName
     3395                                               , buf_rec.recName
     3396                                               , buf_rec.recLevel
     3397                                               )
     3398                           ).
     3399                       end.
     3400                       else do:
     3401                           assign
     3402                               buf_rec-fld.closed              = yes
     3403                               buf_rec-fld-list.closed         = yes
     3404                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3405                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3406                           .
     3407                       end.
     3408                   end.
     3409                   leave close-field-rec.
     3410               end.
     3411           end.
     3412       end.
     3413   end.
     3414   end procedure.
     3415   procedure Error :
     3416   define input parameter p-error-message     as character        no-undo.
     3417   do
     3418   on error undo, return error
     3419   :
     3420       run xmllib-parse-error in this-procedure (
     3421           input p-error-message
     3422       ).
     3423       assign
     3424           v-xmllib-error-status = yes
     3425       .
     3426   end.
     3427   end procedure.
     3428   procedure xmllib-parse-error :
     3429   define input parameter p-err-message    as character        no-undo.
     3430   do
     3431   on error undo, return error
     3432   :
     3433       if valid-handle(v-xmllib-log-handle) then do:
     3434         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     3435                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     3436                                    ,chr(10)
     3437                                    ,v-xmllib-dirname
     3438                                    ,v-xmllib-filename
     3439                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     3440                                      then v-xmllib-sax-reader-handle :locator-line-number
     3441                                      else ?)
     3442                                    ,p-err-message)).
     3443       end.
     3444       else do:
     3445         if v-xmllib-log-filename = "":U
     3446         then do:
     3447             message
     3448                     vss-workfile vss-revision vss-description
     3449                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     3450                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     3451                                  then v-xmllib-sax-reader-handle :locator-line-number
     3452                                  else ?)
     3453                 skip(1)
     3454                 skip p-err-message
     3455                 skip return-value
     3456                 skip trim( error-status :get-message( 1 ) )
     3457                     trim( error-status :get-message( 2 ) )
     3458                     trim( error-status :get-message( 3 ) )
     3459             view-as alert-box error.
     3460             undo, return error.
     3461         end.
     3462         else do:
     3463           output to value( v-xmllib-log-filename ).
     3464           put unformatted
     3465               substitute( "&1&2", chr(10), p-err-message )
     3466           .
     3467           output close.
     3468         end.
     3469       end.
     3470   end.
     3471   end procedure.
     3472   procedure xmllib-set-log-filename :
     3473   define input parameter p-log-filename   as character        no-undo.
     3474   do
     3475   on error undo, return error
     3476   :
     3477       run gbl/fileapnd.p (
     3478             input p-log-filename
     3479           , input "":U
     3480           , input 10
     3481       ) no-error.
     3482       if error-status :error
     3483       then do:
     3484           assign
     3485               v-xmllib-log-filename = "":U
     3486           .
     3487       end.
     3488       else do:
     3489           assign
     3490               v-xmllib-log-filename = p-log-filename
     3491           .
     3492       end.
     3493   end.
     3494   end procedure.
     3495   procedure xmllib-set-log-handle :
     3496   define input parameter p-log-handle    as handle        no-undo.
     3497   define input parameter p-log-proc-name as character no-undo .
     3498   do
     3499   on error undo, return error
     3500   :
     3501       if valid-handle(p-log-handle)
     3502       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     3503       then do:
     3504         assign
     3505         v-xmllib-log-handle    = p-log-handle
     3506         v-xmllib-log-proc-name = p-log-proc-name
     3507         .
     3508       end.
     3509       else do:
     3510         assign
     3511         v-xmllib-log-handle    = ?
     3512         v-xmllib-log-proc-name = '':U
     3513         .
     3514       end.
     3515   end.
     3516   end procedure.
     3517   procedure xmllib-set-prg-bar-handle :
