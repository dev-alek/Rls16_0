     3939   end .
     3940   procedure xmlchar-decode :
     3941   define input parameter p-in-string      as character        no-undo.
     3942   define output parameter p-out-string    as character        no-undo.
     3943       define variable v-position      as integer      no-undo.
     3944       define variable v-last-position as integer      no-undo.
     3945       define variable v-temp-integer  as integer      no-undo.
     3946       define variable v-current-char  as character    no-undo.
     3947       define variable v-next-char     as character    no-undo.
     3948       define variable v-success       as logical      no-undo.
     3949   do
     3950   on error undo, return error
     3951   :
     3952       assign
     3953           p-out-string = "":U
     3954           v-position   = 0
     3955       .
     3956       replace-cycle:
     3957       do while yes
     3958       on error undo, return error
     3959       :
     3960           assign
     3961               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3962           .
     3963           if v-last-position <= v-position
     3964           then do:
     3965               if v-position = 0
     3966               then do:
     3967                   assign
     3968                       p-out-string = p-in-string
     3969                   .
     3970               end.
     3971               else do:
     3972                   assign
     3973                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3974                   .
     3975               end.
     3976               leave replace-cycle.
     3977           end.
     3978           else do:
     3979               assign
     3980                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3981                   v-position      = v-last-position
     3982                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3983               .
     3984               if v-current-char = "#":U
     3985               then do:
     3986                   assign
     3987                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3988                   .
     3989                   if v-last-position > 0
     3990                   then do:
     3991                       run xmlchar-read-integer in this-procedure
     3992                        (
     3993                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3994                           , output v-temp-integer
     3995                           , output v-success
     3996                       ).
     3997                       if v-success = yes
     3998                       and v-temp-integer >= 1
     3999                       and v-temp-integer <= 255
     4000                       then do:
     4001                           assign
     4002                               p-out-string = p-out-string + chr( v-temp-integer )
     4003                               v-position   = v-last-position + 1
     4004                           .
     4005                       end.
     4006                       else do:
     4007                           assign
     4008                               p-out-string = p-out-string + "&":U
     4009                               v-position   = v-position   + 1
     4010                           .
     4011                       end.
     4012                   end.
     4013                   else do:
     4014                       assign
     4015                           p-out-string = p-out-string + "&":U
     4016                           v-position   = v-position   + 1
     4017                       .
     4018                   end.
     4019               end.
     4020               else do:
     4021                   case substring( p-in-string, v-position + 1, 3 )
     4022                   :
     4023                       when "lt;":U
     4024                       then do:
     4025                           assign
     4026                               p-out-string = p-out-string + "<":U
     4027                               v-position   = v-position   + 3
     4028                           .
     4029                       end.
     4030                       when "gt;":U
     4031                       then do:
     4032                           assign
     4033                               p-out-string = p-out-string + ">":U
     4034                               v-position   = v-position   + 3
     4035                           .
     4036                       end.
     4037                       otherwise do:
     4038                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4039                           then do:
     4040                               assign
     4041                                   p-out-string = p-out-string + "&":U
     4042                                   v-position   = v-position   + 4
     4043                               .
     4044                           end.
     4045                           else do:
     4046                               case substring( p-in-string, v-position + 1, 5 )
     4047                               :
     4048                                   when "quot;":U
     4049                                   then do:
     4050                                       assign
     4051                                           p-out-string = p-out-string + '"':U
     4052                                           v-position   = v-position   + 5
     4053                                       .
     4054                                   end.
     4055                                   when "apos;":U
     4056                                   then do:
     4057                                       assign
     4058                                           p-out-string = p-out-string + "'":U
     4059                                           v-position   = v-position   + 5
     4060                                       .
     4061                                   end.
     4062                                   otherwise do:
     4063                                       assign
     4064                                           p-out-string = p-out-string + "&":U
     4065                                       .
     4066                                   end.
     4067                               end case.
     4068                           end.
     4069                       end.
     4070                   end case.
     4071               end.
     4072           end.
     4073       end.
     4074   end.
     4075   end .
     4076   procedure xmlchar-read-integer :
     4077   define input parameter p-input-string      as character        no-undo.
     4078   define output parameter p-output-integer   as integer          no-undo.
     4079   define output parameter p-success       as logical          no-undo.
     4080   do
     4081   on error undo, return error
     4082   :
     4083       assign
     4084           p-output-integer = integer( p-input-string )
     4085       no-error.
     4086       if error-status :error
     4087       then do:
     4088           assign
     4089               p-success           = no
     4090               p-output-integer    = 0
     4091           .
     4092       end.
     4093       else do:
     4094           assign
     4095               p-success           = yes
     4096           .
     4097       end.
     4098   end.
     4099   end.
     4100   define variable v-current-node-code as integer no-undo .
     4101   define variable v-current-host-code as integer no-undo .
     4102   define variable v-current-obj-type as character no-undo .
     4103   define variable v-current-obj-code as integer no-undo .
     4104   define variable v-current-lock as integer no-undo .
     4105   define variable v-current-wait as integer no-undo .
     4106   define variable v-save as integer no-undo .
     4107   define variable log-file-name                as character      no-undo init "process-cli-grp.txt".
     4108   define variable v-view-log                   as logical        no-undo .
     4109   define variable v-stop                       as logical        no-undo .
     4110   define variable v-current-db-num as integer no-undo .
     4111   define variable v-current-date as date no-undo .
     4112   define variable v-sign as integer no-undo .
     4113   define variable file-name as char.
     4114   define variable num-rec as integer no-undo .
     4115   define variable num-rec-ok as integer no-undo .
     4116   define variable v-full-path        as character no-undo .
     4117   define variable v-path             as character no-undo .
     4118   define variable v-file-name        as character no-undo .
     4119   define variable v-file-name-no-ext as character no-undo .
     4120   define variable v-file-name-ext    as character no-undo .
     4121   define variable v-end-new-line     as logical no-undo .
     4122   define variable v-last-error-message as character no-undo .
     4123   define variable v-retry-action as integer no-undo .
     4124   define variable v_dataseth as handle no-undo .
     4125   define variable v-xmlh as handle no-undo .
     4126   define variable v_qh as handle no-undo .
     4127   define variable glog as logical no-undo .
     4128   define variable v-last-rec-ord as integer no-undo .
     4129   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4130   procedure set-error :
     4131   define input parameter p-mess as character no-undo .
     4132     do
     4133     on error undo, return error
     4134     :
     4135        assign
     4136        v-last-error-message = p-mess.
     4137     end.
     4138   end procedure.
     4139   define buffer buf_temp-cmd for temp-cmd.
     4140   define temp-table temp-cli-grp_ no-undo like ub.cli-grp.
     4141   define buffer buf_temp-xml-tables for temp-xml-tables.
     4142   define shared temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
     4143   function 00140003_get-error-message returns character :
     4144   define variable v-ii as integer no-undo .
     4145   define variable v-mess as character no-undo .
     4146   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4147       v-mess = substitute("&1&2ош &3"
     4148                           ,v-mess
     4149                           ,chr(10)
     4150                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     4151   END.
     4152   return v-mess.
     4153   end function.
     4154   function 00140003_after-import_f returns logical ( input p-d-card as character):
     4155     run 00140003_after-import in this-procedure ( input p-d-card) no-error.
     4156     run set-error in this-procedure ( input return-value ).
     4157     return not (error-status:error).
     4158   end function.
     4159   define variable p-xsd-file as character no-undo.
     4160   on delete of this-procedure do:
     4161     run delete-procedure in this-procedure .
     4162     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     4163   end.
     4164   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4165   if error-status:error
     4166   or return-value = "return" then return.
     4167   define variable ImpData1 as class Route-data_ no-undo .
     4168   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     4169   if not this-procedure:persistent then do:
     4170     run proc-main in this-procedure no-error .
     4171     if error-status:error then do:
     4172         run delete-procedure in this-procedure .
     4173         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4174     end.
     4175     run delete-procedure in this-procedure .
     4176   end.
     4177   procedure proc-main :
     4178   define variable v-current-upper-node-code as integer no-undo .
     4179   define variable v-current-node-name as character no-undo .
     4180   define variable v-rid as recid no-undo .
     4181   _main:
     4182   do
     4183   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4184   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4185   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4186   :
     4187   run write-log  in p-log-handle (
     4188                                    input 0
     4189                                  , "&DLine").
     4190   run write-log-and-file in p-log-handle (
     4191         input 1
     4192       , input log-file-name
     4193       , input 1
     4194       , input substitute("Импорт данных по группам клиентов из файла &1", file-name)).
     4195   for each buf_temp-xml-tables where buf_temp-xml-tables.order >= 0:
     4196     if buf_temp-xml-tables.tbl-name = "THheader" then next.
     4197     create query v_qh.
     4198     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     4199     if error-status:error
     4200     or
     4201     not glog then do:
     4202       run write-log-and-file in p-log-handle (
     4203                                               input 1
     4204                                             , input log-file-name
     4205                                             , input 1
     4206                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4207                                                               , buf_temp-xml-tables.tbl-name
     4208                                                               , chr(10)
     4209                                                               , error-status:get-message(1)
     4210                                                               , return-value)).
     4211       undo _main, return error ''.
     4212     end.
     4213     glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     4214     if error-status:error
     4215     or
     4216     not glog then do:
     4217       run write-log-and-file in p-log-handle (
     4218                                               input 1
     4219                                             , input log-file-name
     4220                                             , input 1
     4221                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4222                                                               , buf_temp-xml-tables.tbl-name
     4223                                                               , chr(10)
     4224                                                               , error-status:get-message(1)
     4225                                                               , return-value)).
     4226       undo _main, return error ''.
     4227     end.
     4228     glog = v_qh:query-open no-error .
     4229     if error-status:error
     4230     or
     4231     not glog then do:
     4232       run write-log-and-file in p-log-handle (
     4233                                               input 1
     4234                                             , input log-file-name
     4235                                             , input 1
     4236                                             , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     4237                                                               , buf_temp-xml-tables.tbl-name
     4238                                                               , chr(10)
     4239                                                               , error-status:get-message(1)
     4240                                                               , return-value)).
     4241       undo _main, return error ''.
     4242     end.
     4243       _stroka:
     4244       REPEAT:
     4245         num-rec = num-rec + 1.
     4246         v-retry-action = 0 .
     4247        _release:
     4248         do on error undo, retry:
     4249           if  retry then do:
     4250             v-retry-action = v-retry-action + 1.
     4251             run write-log-and-file in p-log-handle (
     4252                                                     input 1
     4253                                                   , input log-file-name
     4254                                                   , input 1
     4255                                                   , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"
     4256                                                                     , buf_temp-xml-tables.tbl-name
     4257                                                                     , num-rec
     4258                                                                     , chr(10)
     4259                                                                     , error-status:get-message(1)
     4260                                                                     , return-value)).
     4261           end.
     4262   if v-retry-action < 1 then do:
     4263   ImpData1:Route-data_dump ( ) .
     4264   end.
     4265         end.
     4266         _rule:
     4267          do on error undo _rule, retry _rule:
     4268            if retry then do:
     4269               run write-log-and-file in p-log-handle (
     4270                                                       input 1
     4271                                                     , input log-file-name
     4272                                                     , input 1
     4273                                                     , input substitute("&1&2&3"
     4274                                                                       , error-status:get-message(1)
     4275                                                                       , chr(10)
     4276                                                                       , return-value)).
     4277              next _stroka.
     4278            end.
     4279            else do:
     4280             v_qh:get-next().
     4281             IF v_qh:query-off-end then leave _stroka.
     4282             IF  ImpData1:current-tbl-name( ) = "cli-grp-01"  THEN do:
     4283               v-current-node-code = ImpData1:route-data_get-field-integer( input "cli-grp-01", input "node-code") .
     4284               v-current-upper-node-code = ImpData1:route-data_get-field-integer( input "cli-grp-01", input "upper-code") .
     4285               v-current-node-name = ImpData1:route-data_get-field-character( input "cli-grp-01", input "node-name") .
     4286               run ref/cligrp01.p ( input 'ДОБАВЛЕНИЕ':U
     4287                                   ,input yes
     4288                                   ,input yes
     4289                                   ,input-output v-current-node-code
     4290                                   ,input-output v-current-upper-node-code
     4291                                   ,input v-current-node-name
     4292                                   ,output v-rid ) no-error.
     4293               if error-status:error then do:
     4294                 run write-log-and-file in p-log-handle (
     4295                                                         input 1
     4296                                                       , input log-file-name
     4297                                                       , input 1
     4298                                                       , input substitute("&1&2&3"
     4299                                                                         , error-status:get-message(1)
     4300                                                                         , chr(10)
     4301                                                                         , return-value)).
     4302                 next _stroka.
     4303               end.
     4304             end.
     4305           end.
     4306         end.
     4307         v-retry-action = 0 .
     4308        _release:
     4309         do on error undo, retry:
     4310           if  retry then do:
     4311             v-retry-action = v-retry-action + 1.
     4312             run write-log-and-file in p-log-handle (
     4313                                                     input 1
     4314                                                   , input log-file-name
     4315                                                   , input 1
     4316                                                   , input substitute("&1&2&3"
     4317                                                                     , error-status:get-message(1)
     4318                                                                     , chr(10)
     4319                                                                     , v-last-error-message )).
     4320           end.
     4321   if v-retry-action < 1 then do:
     4322   ImpData1:Route-data_dump ( ) .
     4323   end.
     4324         end.
     4325         if v-retry-action = 0 then do:
     4326           num-rec-ok = num-rec-ok + 1.
     4327         end.
     4328         run write-counter in p-log-handle ( input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4329         process events.
     4330         run get-stop-state in p-log-handle ( output v-stop) no-error .
     4331         if v-stop then do:
     4332             run write-log-and-file in p-log-handle (
     4333                                                     input 1
     4334                                                   , input log-file-name
     4335                                                   , input 1
     4336                                                   , input substitute("Процесс импорта прерван пользователем")).
     4337            leave _stroka.
     4338         end.
     4339       end.
     4340       if not v-stop then do:
     4341         num-rec = num-rec - 1.
     4342       end.
     4343       v_qh:query-close().
     4344       if valid-handle(v_qh) then do:
     4345         delete object v_qh.
     4346       end.
     4347     end.
     4348     run write-log-and-file in p-log-handle (
     4349           input 1
     4350         , input log-file-name
     4351         , input 1
     4352         , input substitute("Обработано строк: &1, из них удачно: &2", num-rec, num-rec-ok)).
     4353   end.
     4354   end procedure.
     4355   procedure load-ruleset-context :
     4356   define input parameter p-ruleset-id as integer no-undo .
     4357   define buffer buf_rule-call-param for tt0-rule-call-param.
     4358   do
     4359   on error undo, return error
     4360   :
     4361     find first buf_rule-call-param no-lock where
     4362   buf_rule-call-param.codex_id = p-codex-id
     4363   and buf_rule-call-param.ruleset_id = p-ruleset-id
     4364   and buf_rule-call-param.call_id = p-call-id
     4365   and buf_rule-call-param.order_id = p-order-id
     4366   and buf_rule-call-param.rule_id = p-rule-id
     4367   and buf_rule-call-param.param-name = "p-xsd-file"
     4368    no-error.
     4369   if available buf_rule-call-param then do:
     4370   assign p-xsd-file = buf_rule-call-param.param-value-character.
     4371   end.
     4372       case p-ruleset-id:
     4373         when 3 then do:
     4374           assign
     4375           v-sign = 1
     4376           v-current-host-code = p-host-code
     4377           v-current-obj-type = p-obj-type
     4378           v-current-obj-code = p-obj-code
     4379           v-current-db-num = g#db-num
     4380           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     4381           file-name  = entry(1, p-process-file-name, chr(4))
     4382           v-xmlh = buffer buf_temp-xml-tables:handle:table-handle:default-buffer-handle
     4383           .
     4384           run rul/rum-xmli.p  (
     4385                                input parparentproc
     4386                               ,input p-log-handle
     4387                               ,input file-name
     4388                               ,input p-profile-id
     4389                               ,input p-xsd-file
     4390                               ,input 0
     4391                               ,input 0
     4392                               ,input-output v_dataseth
     4393                               ,input-output v-xmlh
     4394                               ) no-error.
     4395           if error-status:error then do:
     4396             undo, return error substitute("&1&2&3"
     4397                                             , error-status:get-message(1)
     4398                                             , chr(10)
     4399                                             , return-value ).
     4400           end.
     4401           v-xmlh = buffer buf_temp-xml-tables:handle.
     4402         end.
     4403         otherwise do:
     4404           undo, return error "Неправильный вызов".
     4405         end.
     4406       end case.
     4407     end.
     4408   end procedure.
     4409   procedure create_cli-grp_:
     4410   define input parameter p-node-code as integer no-undo .
     4411   define buffer buf_temp-cli-grp_ for temp-cli-grp_.
     4412   find first buf_temp-cli-grp_ where
     4413             buf_temp-cli-grp_.node-code = p-node-code no-error .
     4414   if not available buf_temp-cli-grp_ then do:
     4415     create buf_temp-cli-grp_.
     4416     assign
     4417     buf_temp-cli-grp_.node-code = p-node-code
     4418     .
     4419   end.
     4420   end procedure.
     4421   procedure can-find_cli-grp_  :
     4422   define input parameter p-node-code as integer no-undo .
     4423   define output parameter p-find as logical no-undo .
     4424   find first temp-cli-grp_ where
     4425                        temp-cli-grp_.node-code = p-node-code no-error.
     4426   p-find = available temp-cli-grp_.
     4427   end procedure.
     4428   procedure delete-procedure :
     4429     do
     4430     on error undo, return error
     4431     :
     4432         for each temp-cli-grp_:
     4433           delete temp-cli-grp_.
     4434         end.
     4435         run garbcoll_clear in this-procedure .
     4436     end.
     4437   end procedure.
     4438   procedure 00140003_after-import :
     4439   define input  parameter p-node-code as integer no-undo .
     4440   define buffer buf_cgrp-list for cgrp-list.
     4441   find first buf_cgrp-list where buf_cgrp-list.node-code = p-node-code.
     4442   delete buf_cgrp-list.
     4443   end procedure.
