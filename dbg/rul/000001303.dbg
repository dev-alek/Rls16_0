     2190       case p-ruleset-id:
     2191         when 1 then do:
     2192           assign
     2193           v-sign = 1
     2194           v-current-host-code = p-host-code
     2195           v-current-obj-type = p-obj-type
     2196           v-current-obj-code = p-obj-code
     2197           v-current-db-num = g#db-num
     2198           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2199           v-current-doc-code = p-doc-code
     2200           v-current-doc-date = p-doc-date
     2201           v-current-doc-fact-date = p-fact-date
     2202           v-current-date = p-doc-date
     2203           v-current-fact-date = p-fact-date
     2204           .
     2205         end.
     2206         when 2 then do:
     2207           assign
     2208           v-sign = -1
     2209           v-current-host-code = p-host-code
     2210           v-current-obj-type = p-obj-type
     2211           v-current-obj-code = p-obj-code
     2212           v-current-db-num = g#db-num
     2213           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2214           v-current-doc-code = p-doc-code
     2215           v-current-doc-date = p-doc-date
     2216           v-current-doc-fact-date = p-fact-date
     2217           v-current-date = p-doc-date
     2218           v-current-fact-date = p-fact-date
     2219           .
     2220         end.
     2221         when 3
     2222         or when 5
     2223         then do:
     2224           assign
     2225           v-sign = 1
     2226           v-current-host-code = p-host-code
     2227           v-current-obj-type = p-obj-type
     2228           v-current-obj-code = p-obj-code
     2229           v-current-db-num = g#db-num
     2230           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     2231           v-current-doc-code = p-doc-code
     2232           v-current-doc-date = p-doc-date
     2233           v-current-doc-time = 0
     2234           v-current-doc-fact-date = p-fact-date
     2235           v-current-date = p-doc-date
     2236           v-current-fact-date = p-fact-date
     2237           .
     2238         end.
     2239         when 4 then do:
     2240           assign
     2241           v-sign = -1
     2242           v-current-host-code = p-host-code
     2243           v-current-obj-type = p-obj-type
     2244           v-current-obj-code = p-obj-code
     2245           v-current-db-num = g#db-num
