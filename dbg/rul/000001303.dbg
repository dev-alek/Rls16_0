     1163   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1164   define variable tempcxml_v-num_ as integer no-undo .
     1165   define  temp-table temp-xml-tables no-undo
     1166   field order as integer
     1167   field tbl-name as character
     1168   field tbl-handle_ as handle
     1169   field table-handle_ as handle
