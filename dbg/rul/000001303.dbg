     1740   define temp-table temp-rule-call-param no-undo like ub.rule-call-param.
     1741   define buffer buf_temp-rule-call-param for temp-rule-call-param.
     1742   define buffer buf_temp-cmd for temp-cmd.
     1743   define buffer buf_dis-card-sale_obj for temp-d-card.
     1744   define variable vh_dis-card-sale_obj as handle no-undo .
     1745   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1746   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1747   procedure dis-objh_write-dis-obj-rul :
     1748   define parameter buffer buf_dis-obj for ub.dis-obj .
     1749   define input parameter p-type as character no-undo .
     1750   define input parameter p-emitent-host-code as integer no-undo .
     1751   define input parameter p-dtm-code as integer no-undo .
     1752   define input parameter p-action as integer no-undo .
     1753   define variable v-date as date      no-undo.
     1754   define variable v-time  as integer   no-undo.
     1755   define variable v-rec-ord1 as integer no-undo .
     1756   define variable v-rec-ord2 as integer no-undo .
     1757   define variable v-rec-ord3 as integer no-undo .
     1758   define variable v-rec-hno as integer no-undo .
     1759   define buffer buf_c-dc-hist for ub.c-dc-hist.
     1760   define buffer buf_c-dis-obj for ub.c-dis-obj.
     1761   define buffer buf_temp-hist-nws-option for temp-hist-nws-option.
     1762   define buffer last_temp-hist-nws-option for temp-hist-nws-option.
     1763   do
     1764   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1765   :
     1766     if not available buf_dis-obj then do:
     1767       message
     1768         vss-workfile vss-revision vss-description skip
     1769         "Ошибка задания входных параметров" skip
     1770         "Не определена ДК" skip
     1771         view-as alert-box error .
     1772       undo, return error .
     1773     end.
     1774     find first buf_temp-hist-nws-option where
     1775               buf_temp-hist-nws-option.table-name = 'dis-obj':U
     1776           and buf_temp-hist-nws-option.db-num = g#db-num
     1777           and buf_temp-hist-nws-option.key#_one = p-dtm-code
     1778           and buf_temp-hist-nws-option.charkey_one = p-type
     1779           and buf_temp-hist-nws-option.host-code = p-emitent-host-code no-error .
     1780     if not available buf_temp-hist-nws-option then do:
     1781       find first last_temp-hist-nws-option where
     1782                last_temp-hist-nws-option.db-num = g#db-num
     1783            and last_temp-hist-nws-option.hn-id < 0 no-error.
     1784       create buf_temp-hist-nws-option.
     1785       assign
     1786       buf_temp-hist-nws-option.db-num = g#db-num
     1787       buf_temp-hist-nws-option.hn-id = (if available last_temp-hist-nws-option
     1788                                   then - (abs(last_temp-hist-nws-option.hn-id) + 1)
     1789                                   else -1 )
     1790       buf_temp-hist-nws-option.table-name = 'dis-obj':U
     1791       buf_temp-hist-nws-option.key#_one = p-dtm-code
     1792       buf_temp-hist-nws-option.charkey_one = p-type
     1793       buf_temp-hist-nws-option.host-code = p-emitent-host-code
     1794       buf_temp-hist-nws-option.smart-nws = integer('-1':U)
     1795       .
     1796   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option-record in g#lib-nws
     1798     (input  g#db-num
     1799     ,input  buffer buf_temp-hist-nws-option:handle
     1800     )  .
     1801     end.
     1802     if not g#news
     1803     and buf_temp-hist-nws-option.hist-from-prim < 0 then do:
     1804       return.
     1805     end.
     1806     if g#news
     1807     and buf_temp-hist-nws-option.nws-to-hist < 0 then do:
     1808       return.
     1809     end.
     1810     run cur-time in this-procedure(output v-date, output v-time).
     1811     create buf_c-dis-obj.
     1812     buffer-copy buf_dis-obj to buf_c-dis-obj
     1813     assign
     1814     buf_c-dis-obj.d-card             = buf_dis-obj.d-card
     1815     buf_c-dis-obj.obj-type           = buf_dis-obj.obj-type
     1816     buf_c-dis-obj.obj-code           = buf_dis-obj.obj-code
     1817     buf_c-dis-obj.card-num           = buf_dis-obj.card-num
     1818     buf_c-dis-obj.dt-code            = buf_dis-obj.dt-code
     1819     buf_c-dis-obj.main-card          = buf_dis-obj.main-card
     1820     buf_c-dis-obj.first-main-card    = buf_dis-obj.first-main-card
     1821     buf_c-dis-obj.first-card         = buf_dis-obj.first-card
     1822     buf_c-dis-obj.chip-num           = next-value (s-dc-chip, ub)
     1823     buf_c-dis-obj.corr-time          = v-time
     1824     buf_c-dis-obj.corr-user-db-num   = g#db-num
     1825     buf_c-dis-obj.corr-user-name     = (if g#news
     1826                                         then (chr(4) +  'СПН':U)
     1827                                         else (if g#esys
     1828                                               then (chr(4) +  'ВС':U)
     1829                                               else g#userid)
     1830                                         )
     1831     buf_c-dis-obj.corr-date          = v-date
     1832     .
     1833     create buf_c-dc-hist.
     1834     buffer-copy buf_c-dis-obj to buf_c-dc-hist
     1835     assign
     1836     buf_c-dc-hist.action = p-action
     1837     buf_c-dc-hist.subject = 'dis-obj':U
     1838     buf_c-dc-hist.host-code =  buf_dis-obj.host-code
     1839     buf_c-dc-hist.is-news = g#news
     1840     buf_c-dc-hist.source-type = p-doc-type
     1841     buf_c-dc-hist.source-ref = (if p-doc-type = '':U
     1842                                  then '':U
     1843                                  else p-doc-code)
     1844     .
     1845     if g#db-num > 0
     1846     or (g#db-num = 0
     1847         and buf_temp-hist-nws-option.hist-to-nws >= 0)
     1848     then do:
     1849       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dis-obj':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dis-obj:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord2                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dis-obj':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1850       run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'c-dc-hist':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_c-dc-hist:handle                                                                                    ,input ''                                                                                         ,output v-rec-ord3                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'c-dc-hist':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1851       if g#db-num = 0 then do:
     1852        case  buf_temp-hist-nws-option.smart-nws :
     1853           when integer('0':U)
     1854           or
     1855           when integer('10':U)
     1856           then do:
     1857             run get-db-list-for-d-card  in this-procedure ( input buf_dis-obj.d-card).
     1858             run create-smart-route-link in this-procedure ( input 'c-dis-obj':U
     1859                                                         ,input buffer buf_c-dis-obj:handle
     1860                                                         ,input buf_dis-obj.d-card
     1861                                                         ,input v-rec-ord2
     1862                                                         ,input yes
     1863                                                         ).
     1864             run create-smart-route-link in this-procedure ( input 'c-dc-hist':U
     1865                                                         ,input buffer buf_c-dc-hist:handle
