     1049   procedure create-smart-route-link :
     1050   define input parameter p-tbl-name as character no-undo .
     1051   define input parameter p-bh_tbl-name as handle no-undo .
     1052   define input parameter p-key-field as character no-undo .
     1053   define input parameter p-rec-ord as integer no-undo .
     1054   define input parameter p-is-smart as logical no-undo .
     1055   define variable v-key-rec as character no-undo .
     1056   define buffer buf_temp-smart-link for temp-smart-link.
     1057     do
     1058     on error undo, return error
     1059     :
     1060       run gen-key-rec in this-procedure ( input p-tbl-name
     1061                                          ,input p-bh_tbl-name
     1062                                          ,output v-key-rec     ).
     1063      find first buf_temp-smart-link where
     1064                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1065              and buf_temp-smart-link.key-field = p-key-field
     1066              and buf_temp-smart-link.rec-ord = p-rec-ord
     1067              no-error .
     1068      if not available buf_temp-smart-link then do:
     1069        create buf_temp-smart-link.
     1070        assign
     1071        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1072        buf_temp-smart-link.key-field = p-key-field
     1073        buf_temp-smart-link.rec-ord = p-rec-ord
     1074        buf_temp-smart-link.is-smart = p-is-smart
     1075        .
     1076      end.
     1077     end.
     1078   end procedure.
     1079   procedure create-nws-outline :
     1080   define input parameter p-cmd-proc-handle as handle no-undo .
     1081   define input parameter p-cmd-code as integer no-undo .
     1082   define input parameter p-outline-type as character no-undo .
     1083   define input parameter p-charkey_one as character no-undo .
     1084   define input parameter p-charkey_two as character no-undo .
     1085   define input parameter p-charkey_three as character no-undo .
     1086   define input parameter p-key#_one as integer no-undo .
     1087   define input parameter p-key#_two as integer no-undo .
     1088   define input parameter p-key#_three as integer no-undo .
     1089   define variable v-no-id as integer no-undo .
     1090   define variable v-rec-ord as integer no-undo .
     1091     do
     1092     on error undo, return error return-value
     1093     :
     1094       find last temp-nws-outline use-index pi no-error .
     1095       v-no-id = (if available temp-nws-outline
     1096                  then (temp-nws-outline.no-id  + 1)
     1097                  else 1).
     1098       create temp-nws-outline.
     1099       assign
     1100       temp-nws-outline.charkeY_one = p-charkey_one
     1101       temp-nws-outline.charkeY_two = p-charkey_two
     1102       temp-nws-outline.charkeY_three = p-charkey_three
     1103       temp-nws-outline.key#_one = p-key#_one
     1104       temp-nws-outline.key#_two = p-key#_two
     1105       temp-nws-outline.key#_three = p-key#_three
     1106       temp-nws-outline.no-id = v-no-id
     1107       temp-nws-outline.outline-type = p-outline-type
     1108       .
     1109                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1110       run  create-smart-route in this-procedure (
     1111                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1112                                                  ,input -1).
     1113       run create-smart-route-link in this-procedure (
     1114                                                      input 'nws-outline':U
     1115                                                     ,input (buffer temp-nws-outline:handle)
     1116                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1117                                                     ,input v-rec-ord
     1118                                                     ,input no
     1119                                                     ).
     1120     end.
     1121   end procedure.
     1122   procedure create-no-route :
     1123   define input parameter p-rec-ord as integer no-undo .
     1124   define input parameter p-db-num as integer no-undo .
     1125   define buffer buf_temp-no-route for temp-no-route.
     1126   do
     1127   on error undo, return error
     1128   :
     1129      find first buf_temp-no-route where
     1130                 buf_temp-no-route.rec-ord = p-rec-ord
     1131              and buf_temp-no-route.db-num = p-db-num no-error .
     1132      if not available buf_temp-no-route then do:
     1133        create buf_temp-no-route.
     1134        assign
     1135        buf_temp-no-route.rec-ord = p-rec-ord
     1136        buf_temp-no-route.db-num = p-db-num
     1137        .
     1138      end.
     1139   end.
     1140   end procedure.
     1141   procedure clear-from-rec-ord :
     1142   define input parameter p-rec-ord as integer no-undo .
     1143   define buffer buf_temp-no-route for temp-no-route.
     1144   define buffer buf_temp-smart-link for temp-smart-link.
     1145   do
     1146   on error undo, return error
     1147   :
     1148   for each buf_temp-no-route where
     1149           buf_temp-no-route.rec-ord > p-rec-ord:
     1150     delete buf_temp-no-route.
     1151   end.
     1152   for each buf_temp-smart-link where
     1153           buf_temp-smart-link.rec-ord > p-rec-ord:
     1154      delete buf_temp-smart-link.
     1155   end.
     1156   end.
     1157   end procedure.
     1158   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   define shared temp-table temp-hist-nws-option no-undo
