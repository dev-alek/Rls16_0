     2247           v-current-doc-code = p-doc-code
     2248           v-current-doc-date = p-doc-date
     2249           v-current-doc-time = 0
     2250           v-current-doc-fact-date = p-fact-date
     2251           v-current-date = p-doc-date
     2252           v-current-fact-date = p-fact-date
     2253           .
     2254         end.
     2255       end case.
     2256     end.
     2257   end procedure.
