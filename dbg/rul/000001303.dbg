     1983   procedure get-db-list-for-d-card:
     1984   define input parameter p-d-card as character no-undo .
     1985   define variable v-current-db-processed as logical no-undo .
     1986   define buffer buf_clients  for ub.clients.
     1987   define buffer buf_dis-obj for ub.dis-obj.
     1988   define buffer buf_temp-smart-route for temp-smart-route.
     1989     do
     1990     on error undo, return error return-value
     1991     :
     1992       for each buf_dis-obj no-lock where
     1993               buf_dis-obj.d-card = p-d-card,
     1994          first buf_clients no-lock where
     1995               buf_clients.obj-type = buf_dis-obj.obj-type
     1996           and buf_clients.obj-code = buf_dis-obj.obj-code
     1997       break by
     1998       buf_clients.db-num:
     1999         if first-of(buf_Clients.db-num) then do:
     2000           find first buf_temp-smart-route no-lock where
     2001                 buf_temp-smart-route.key-field = p-d-card
     2002             and buf_temp-smart-route.db-num = buf_clients.db-num
     2003                 no-error.
     2004           if available buf_temp-smart-route then return.
     2005           create buf_temp-smart-route.
     2006           assign
     2007           buf_temp-smart-route.key-field = p-d-card
     2008           buf_temp-smart-route.db-num = buf_clients.db-num
     2009           .
     2010           if buf_clients.db-num = g#db-num then do:
     2011             v-current-db-processed = yes.
     2012           end.
     2013         end.
     2014       end.
     2015       if not v-current-db-processed then do:
     2016         find first buf_temp-smart-route no-lock where
     2017               buf_temp-smart-route.key-field = p-d-card
     2018           and buf_temp-smart-route.db-num = g#db-num  no-error.
     2019         if not available buf_temp-smart-route then do:
     2020           create buf_temp-smart-route.
     2021           assign
     2022           buf_temp-smart-route.key-field = p-d-card
     2023           buf_temp-smart-route.db-num = g#db-num
     2024           .
     2025         end.
     2026       end.
     2027     end.
     2028   end procedure.
     2029   on delete of this-procedure do:
     2030     run garbcoll_clear in this-procedure .
     2031   end.
     2032   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
