     1193   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   procedure get-gate-file-name :
     1195   define input parameter p-gate-rec as character no-undo .
     1196   define output  parameter p-gate-file-name as character no-undo .
     1197   define buffer buf_clob-data for ub.clob-data.
     1198   define variable v-tbl-row as rowid no-undo .
     1199   define variable v-tbl-name as character no-undo .
     1200   run gen-row-keyr in this-procedure ( input p-gate-rec
     1201                                       ,input ?
     1202                                       ,input "ub"
     1203                                       ,input ?
     1204                                       ,input no-lock
     1205                                       ,output v-tbl-row
     1206                                       ,output v-tbl-name) no-error.
     1207   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1208                                                           ,vss-include-info11
     1209                                                           ,p-gate-rec).
     1210   find first buf_clob-data no-lock where
     1211             rowid(buf_clob-data) = v-tbl-row no-error.
     1212   if not available buf_clob-data then do:
     1213     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1214                                                             ,vss-include-info11
     1215                                                             ,p-gate-rec).
     1216   end.
     1217   p-gate-file-name = buf_clob-data.file-name.
     1218   end procedure.
     1219   procedure get-gate-rec :
     1220   define input  parameter p-gate-name as character no-undo .
     1221   define output parameter p-gate-rec as character no-undo .
     1222   define buffer buf_clob-bind for ub.clob-bind.
     1223   define buffer buf_clob-data for ub.clob-data.
     1224   main-block:
     1225   do
     1226   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1227   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1228   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1229   :
     1230       find first buf_clob-bind no-lock where
     1231                 buf_clob-bind.uniq-key-rec = p-gate-name
     1232             and buf_clob-bind.field-name = '':U
     1233             and buf_clob-bind.part-num = 1
     1234             and buf_clob-bind.resource-type = 'gate':U
     1235             no-error.
     1236       if not available buf_clob-bind then do:
     1237         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1238                                         , p-gate-name
     1239                                         ).
     1240       end.
     1241       find first buf_clob-data no-lock where
     1242                 buf_clob-data.db-num = buf_clob-bind.db-num
     1243             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1244       if not available buf_clob-data then do:
     1245         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1246                                         , buf_clob-bind.db-num
     1247                                         , buf_clob-bind.int64-id
     1248                                         , p-gate-name
     1249                                         ).
     1250       end.
     1251       run gen-key-rec in this-procedure ( input 'clob-data':U
     1252                                 ,input buffer buf_clob-data:handle
     1253                                 ,output p-gate-rec).
     1254   end.
     1255   end procedure.
     1256   procedure get-gate-by-name :
     1257   define input  parameter p-gate-name as character no-undo .
     1258   define output parameter p-gate-rec as character no-undo .
     1259   define output parameter p-dsh as handle no-undo .
     1260   define input-output  parameter p-xmlh as handle no-undo .
     1261   define variable v-ii as integer   no-undo .
     1262   define variable glog as logical   no-undo .
     1263   define variable v-longchar as longchar no-undo .
     1264   define variable v-txmlh as handle no-undo .
     1265   define variable v-db-num as integer no-undo .
     1266   define variable v-int64-id as int64 no-undo .
     1267   define buffer buf_clob-bind for ub.clob-bind.
     1268   define buffer buf_clob-data for ub.clob-data.
     1269   main-block:
     1270   do
     1271   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1272   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1273   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1274   :
     1275       find first buf_clob-bind no-lock where
     1276                 buf_clob-bind.uniq-key-rec = p-gate-name
     1277             and buf_clob-bind.field-name = '':U
     1278             and buf_clob-bind.part-num = 1
     1279             and buf_clob-bind.resource-type = 'gate':U
     1280             no-error.
     1281       if not available buf_clob-bind then do:
     1282         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1283                                         , p-gate-name
     1284                                         ).
     1285       end.
     1286       find first buf_clob-data no-lock where
     1287                 buf_clob-data.db-num = buf_clob-bind.db-num
     1288             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1289       if not available buf_clob-data then do:
     1290         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1291                                         , buf_clob-bind.db-num
     1292                                         , buf_clob-bind.int64-id
     1293                                         , p-gate-name
     1294                                         ).
     1295       end.
     1296       assign
     1297       v-longchar = buf_clob-data.cdata
     1298       .
     1299       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1300       if error-status :error then do:
     1301         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1302       end.
     1303       create dataset p-dsh .
     1304       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1305                                     , v-longchar
     1306                                     , ?
     1307                                     , ?
     1308                                     , ?
     1309                                     ) no-error.
     1310       v-longchar = '':U.
     1311       if error-status :error
     1312       or not glog
     1313       then do:
     1314         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1315       end.
     1316       if not valid-handle(p-xmlh)
     1317       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1318         create temp-table v-txmlh.
     1319         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1320         v-txmlh:temp-table-prepare("temp-xml-tables").
     1321         p-xmlh = v-txmlh:default-buffer-handle.
     1322       end.
     1323       run gen-key-rec in this-procedure ( input 'clob-data':U
     1324                                 ,input buffer buf_clob-data:handle
     1325                                 ,output p-gate-rec).
     1326       do v-ii = 1 to p-dsh:num-buffers:
     1327         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1328         if not p-xmlh:available then do:
     1329           p-xmlh:buffer-create().
     1330           assign
     1331           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1332           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1333           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1334           p-xmlh::gate-handle_ = p-dsh
     1335           p-xmlh::uniq-gate-rec = p-gate-rec
     1336           p-xmlh::gate-name = p-dsh:name
     1337           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1338           .
     1339           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1340             assign
     1341             p-xmlh::order = -3.
     1342           end.
     1343         end.
     1344       end.
     1345   end.
     1346   end procedure.
     1347   procedure get-gate-by-rec :
     1348   define input  parameter p-gate-rec as character no-undo .
     1349   define output parameter p-dsh as handle no-undo .
     1350   define input-output  parameter p-xmlh as handle no-undo .
     1351   define input-output parameter p-longchar  as longchar no-undo .
     1352   define variable v-ii as integer   no-undo .
     1353   define variable glog as logical   no-undo .
     1354   define variable v-rowid as rowid no-undo .
     1355   define variable v-tbl-name as character no-undo .
     1356   define variable v-longchar as longchar no-undo .
     1357   define variable v-txmlh as handle no-undo .
     1358   define buffer buf_clob-data for ub.clob-data.
     1359   main-block:
     1360   do
     1361   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1362   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1363   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1364   :
     1365     run gen-row-keyr in this-procedure (
     1366                                           input  p-gate-rec
     1367                                           ,input  ?
     1368                                           ,input  "ub"
     1369                                           ,input  ?
     1370                                           ,input  NO-LOCK
     1371                                           ,output v-rowid
     1372                                           ,output v-tbl-name   ) no-error.
     1373       find first buf_clob-data no-lock where
     1374                 rowid(buf_clob-data) = v-rowid  no-error.
     1375       if not available buf_clob-data then do:
     1376         undo, return error substitute("Не найден CLOB  &1"
     1377                                         , p-gate-rec
     1378                                         ).
     1379       end.
     1380       assign
     1381       v-longchar = buf_clob-data.cdata
     1382       .
     1383       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1384       if error-status :error then do:
     1385         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1386       end.
     1387       create dataset p-dsh .
     1388       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1389                                     , v-longchar
     1390                                     , ?
     1391                                     , ?
     1392                                     , ?
     1393                                     ) no-error.
     1394       define variable v-esm as character no-undo .
     1395       v-esm = error-status:get-message(1) .
     1396       if p-longchar <> ? then do:
     1397         p-longchar = v-longchar.
     1398       end.
     1399       v-longchar = '':U.
     1400       if error-status :error
     1401       or not glog
     1402       then do:
     1403         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1404                                      , p-gate-rec
     1405                                      , p-gate-rec
     1406                                      , v-esm
     1407                                      ).
     1408       end.
     1409       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1410       if not valid-handle(p-xmlh)
     1411       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1412         create temp-table v-txmlh.
     1413         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1414         v-txmlh:temp-table-prepare("temp-xml-tables").
     1415         p-xmlh = v-txmlh:default-buffer-handle.
     1416       end.
     1417       do v-ii = 1 to p-dsh:num-buffers:
     1418         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1419         if not p-xmlh:available then do:
     1420           p-xmlh:buffer-create().
     1421           assign
     1422           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1423           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1424           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1425           p-xmlh::gate-handle_ = p-dsh
     1426           p-xmlh::uniq-gate-rec = p-gate-rec
     1427           p-xmlh::gate-name = p-dsh:name
     1428           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1429           .
     1430           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1431             assign
     1432             p-xmlh::order = -3.
     1433           end.
     1434           p-xmlh:buffer-release().
     1435         end.
     1436       end.
     1437   end.
     1438   end procedure.
     1439   procedure get-gate-by-file :
     1440   define input  parameter p-schema-file-name as character no-undo .
     1441   define input  parameter p-gate-rec as character no-undo .
     1442   define output parameter p-dsh as handle no-undo .
     1443   define input-output  parameter p-xmlh as handle no-undo .
     1444   define variable v-ii as integer   no-undo .
     1445   define variable glog as logical   no-undo .
     1446   define variable v-rowid as rowid no-undo .
     1447   define variable v-tbl-name as character no-undo .
     1448   define variable v-longchar as longchar no-undo .
     1449   define variable v-txmlh as handle no-undo .
     1450   main-block:
     1451   do
     1452   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info11, return-value, chr(10), error-status :get-message (1))
     1453   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info11 )
     1454   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info11 )
     1455   :
     1456       COPY-LOB
     1457       FROM  FILE p-schema-file-name
     1458       TO  OBJECT v-longchar
     1459       no-convert
     1460       NO-ERROR .
     1461       if error-status :error then do:
     1462           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1463                                     , p-schema-file-name
     1464                                 , chr(10)
     1465                                 , error-status:get-message(1) ).
     1466       end.
     1467       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1468       if error-status :error then do:
     1469         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1470       end.
     1471       create dataset p-dsh .
     1472       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1473                                     , v-longchar
     1474                                     , ?
     1475                                     , ?
     1476                                     , ?
     1477                                     ) no-error.
     1478       v-longchar = ''.
     1479       if error-status :error
     1480       or not glog
     1481       then do:
     1482         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1483                                      , p-schema-file-name
     1484                                      ,chr(10)
     1485                                      , error-status:get-message(1)
     1486                                      ).
     1487       end.
     1488       if not valid-handle(p-xmlh)
     1489       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1490         create temp-table v-txmlh.
     1491         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1492         v-txmlh:temp-table-prepare("temp-xml-tables").
     1493         p-xmlh = v-txmlh:default-buffer-handle.
     1494       end.
     1495       do v-ii = 1 to p-dsh:num-buffers:
     1496         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1497                                      ,p-dsh:get-buffer-handle(v-ii):name
     1498                                      ,p-gate-rec
     1499                                      )) no-error.
     1500         if not p-xmlh:available then do:
     1501           p-xmlh:buffer-create().
     1502           assign
     1503           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1504           p-xmlh::uniq-gate-rec = p-gate-rec
     1505           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1506           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1507           p-xmlh::gate-handle_ = p-dsh
     1508           p-xmlh::gate-name = p-dsh:name
     1509           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1510           .
     1511           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1512             assign
     1513             p-xmlh::order = -3.
     1514           end.
     1515           p-xmlh:buffer-release().
     1516         end.
     1517       end.
     1518   end.
     1519   end procedure.
     1520   procedure gate-clear :
     1521   define input  parameter p-dsh as handle no-undo .
     1522   define input  parameter p-xmlh as handle no-undo .
     1523   define variable v-dsh as handle no-undo .
     1524   define variable v-th as handle no-undo .
     1525     do
     1526     on error undo, return error return-value
     1527     :
     1528       if valid-handle(p-dsh) then do:
     1529         delete object p-dsh.
     1530         v-dsh = p-dsh.
     1531         p-dsh = ?.
     1532       end.
     1533       repeat while true:
     1534         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1535                            , share-lock) no-error.
     1536         if p-xmlh:available then do:
     1537           assign
     1538           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1539           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1540           and valid-handle(v-th)
     1541           and v-th:dynamic = yes
     1542           then do:
     1543             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1544             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1545           end.
     1546           p-xmlh:buffer-delete().
     1547         end.
     1548         else do:
     1549           leave.
     1550         end.
     1551       end.
     1552       if p-xmlh:dynamic = yes
     1553       and valid-handle(p-xmlh)
     1554       then do:
     1555         delete object p-xmlh:table-handle.
     1556         p-xmlh = ?.
     1557       end.
     1558       v-dsh = ?.
     1559     end.
     1560   end procedure.
     1561   procedure all-gates-clear :
     1562   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1563   do
     1564   on error undo, return error
     1565   :
     1566     for each buf_temp-xml-tables
     1567     break
     1568     by buf_temp-xml-tables.uniq-gate-rec
     1569     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1570     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1571     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1572     :
     1573         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1574           delete object buf_temp-xml-tables.gate-handle_.
     1575           buf_temp-xml-tables.gate-handle_ = ?.
     1576         end.
     1577         if valid-handle(buf_temp-xml-tables.table-handle_)
     1578         and buf_temp-xml-tables.table-handle_:dynamic = no
     1579         then do:
     1580           delete object buf_temp-xml-tables.table-handle_.
     1581           buf_temp-xml-tables.table-handle_ = ?.
     1582         end.
     1583         delete buf_temp-xml-tables.
     1584     end.
     1585   end.
     1586   end procedure.
     1587   procedure fix-schemalocation :
     1588   define input-output  parameter p-longchar as longchar no-undo .
     1589   DEFINE VARIABLE hdoc AS HANDLE.
     1590   DEFINE VARIABLE hroot AS HANDLE.
     1591   DEFINE VARIABLE hnode-child AS HANDLE.
     1592   DEFINE VARIABLE hnode-attr AS HANDLE.
     1593   define variable v-jj as integer   no-undo .
     1594   define variable ok as logical   no-undo .
     1595   define variable v-path1                    as character                no-undo .
     1596   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1597   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1598   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1599   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1600   define variable v-schema-location          as character                no-undo .
     1601   do
     1602   on error undo, return error return-value
     1603   :
     1604     CREATE X-DOCUMENT hdoc.
     1605     CREATE X-noderef hroot.
     1606     CREATE X-noderef hnode-child.
     1607     CREATE X-noderef hnode-attr.
     1608     hdoc:load("longchar", p-longchar, no) no-error.
     1609     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1610     hdoc:get-document-element(hroot).
     1611     _repeat:
     1612     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1613       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1614       if not ok then next.
     1615       if hNode-Child:local-name = "include"
     1616       then do:
     1617         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1618           v-schema-location = hnode-attr:node-value.
     1619           run gbl/filename.p (
     1620                           input "exe/" + hnode-attr:node-value
     1621                         ,output v-full-path1
     1622                         ,output v-path1
     1623                         ,output v-file-name1
     1624                         ,output v-file-name-no-ext1
     1625                         ,output v-file-name-ext1
     1626                         ) no-error .
     1627           if error-status :error then do:
     1628             delete object hnode-attr.
     1629             delete object hnode-child.
     1630             delete object hroot.
     1631             delete object hdoc.
     1632             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1633           end.
     1634         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1635         leave  _repeat.
     1636       end.
     1637     END.
     1638     hdoc:save("longchar", p-longchar).
     1639     delete object hnode-attr.
     1640     delete object hnode-child.
     1641     delete object hroot.
     1642     delete object hdoc.
     1643   end.
     1644   end procedure.
     1645   procedure gate-clb_fill-xml-tables :
     1646   define input parameter p-dsh as handle no-undo .
     1647   define input-output parameter p-xmlh as handle no-undo .
     1648   define variable v-ii as integer no-undo .
     1649     do
     1650     on error undo, return error
     1651     :
     1652       do v-ii = 1 to p-dsh:num-buffers:
     1653         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1654         if not p-xmlh:available then do:
     1655           p-xmlh:buffer-create().
     1656           assign
     1657           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1658           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1659           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1660           p-xmlh::gate-handle_ = p-dsh
     1661           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1662           p-xmlh::gate-name = p-dsh:name
     1663           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1664           .
     1665           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1666             assign
     1667             p-xmlh::order = -3.
     1668           end.
     1669           p-xmlh:buffer-release().
     1670         end.
     1671       end.
     1672     end.
     1673   end procedure.
     1674   procedure all-gates-empty :
     1675   define buffer buf_temp-xml-tables for temp-xml-tables.
     1676   do
     1677   on error undo, return error
     1678   :
     1679     for each buf_temp-xml-tables
     1680     break
     1681     by buf_temp-xml-tables.uniq-gate-rec
     1682     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1683     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1684     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1685     :
     1686       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1687         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1688       end.
     1689     end.
     1690   end.
     1691   end procedure.
     1692   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   procedure library-cls_get-handle :
     1694   define input parameter p-library-name as character no-undo .
     1695   define output parameter p-library-handle as handle no-undo .
     1696     do
     1697     on error undo, return error
     1698     :
     1699       CASE p-library-name:
     1700         when "library" then do:
     1701           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1702           p-library-handle = g#library.
     1703         end.
     1704         when "library2" then do:
     1705           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1706           p-library-handle = g#library2.
     1707         end.
     1708       end case.
     1709     end.
     1710   end procedure.
     1711   define variable v-current-d-card as character no-undo .
     1712   define variable v-current-host-code as integer no-undo .
     1713   define variable v-current-obj-type as character no-undo .
     1714   define variable v-current-obj-code as integer no-undo .
     1715   define variable v-current-lock as integer no-undo .
     1716   define variable v-current-wait as integer no-undo .
     1717   define variable v-save as integer no-undo .
     1718   define variable v-current-db-num as integer no-undo .
     1719   define variable v-current-doc-code as character no-undo .
     1720   define variable v-current-doc-date as date no-undo .
     1721   define variable v-current-doc-time as integer no-undo .
     1722   define variable v-current-doc-fact-date as date no-undo .
     1723   define variable v-current-date as date no-undo .
     1724   define variable v-current-fact-date as date no-undo .
     1725   define variable v-last-error-message as character no-undo .
     1726   define variable v-sign as integer no-undo .
     1727   define variable v-temp-d-card-rec-ord as integer   no-undo .
     1728   define variable v-vchk-pay-rec-ord as integer   no-undo .
     1729   define variable v-gate-rec as character no-undo .
     1730   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1731   procedure set-error :
     1732   define input parameter p-mess as character no-undo .
     1733     do
     1734     on error undo, return error
