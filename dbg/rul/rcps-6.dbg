     3910   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3911   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3912   .
     3913   CASE p-list-mode:
     3914     WHEN 'rule-call-param':U THEN DO:
     3915        ASSIGN
     3916        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3917        .
     3918     END.
     3919     WHEN 'rp-rule-param':U
     3920     or
     3921     when 'rp-rule-param':U + chr(44) + 'все':U
     3922     THEN DO:
     3923       assign
     3924       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3925       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3926       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
