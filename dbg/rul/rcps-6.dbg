     1532        LABEL "Накладная,возврат"
     1533        VIEW-AS TOGGLE-BOX
     1534        SIZE 20.5 BY 1 NO-UNDO.
     1535   DEFINE VARIABLE T-rule-trn-out AS LOGICAL INITIAL no
     1536        LABEL "Накладная,продажа"
     1537        VIEW-AS TOGGLE-BOX
     1538        SIZE 20.5 BY 1 NO-UNDO.
     1539   DEFINE QUERY BR-rcp FOR
     1540         X_ruledict-param,
     1541         X_rp-rule-param,
     1542         tt-rule-call-param,
     1543         TERM_tt-rule-call-param SCROLLING.
     1544   DEFINE BROWSE BR-rcp
     1545     QUERY BR-rcp DISPLAY
     1546         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1547   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1548   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1549   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1550   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1551   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1552   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1553   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1554   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1555   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">9"
     1556   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1557   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1558   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1559   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1560                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1561                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1562                   ,INPUT TERM_tt-rule-call-param.p-index
     1563                   ,INPUT term_tt-rule-call-param.param-value-character
     1564                   ,INPUT term_tt-rule-call-param.param-value-date
     1565                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1566                   ,INPUT term_tt-rule-call-param.param-value-integer
     1567                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1568   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1569    THEN term_tt-rule-call-param.param-value-character
     1570    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1571   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1572   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1573   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1574   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1575   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1576   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1577   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1578   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1579   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1580   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1581   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1582   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1583   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1584       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6
     1585            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1586   DEFINE FRAME Dialog-Frame
     1587        B-exit AT ROW 1 COL 1
     1588        b-quit AT ROW 1 COL 11
     1589        B-Help AT ROW 1 COL 95
     1590        rs-r-b AT ROW 2.07 COL 25.5 NO-LABEL WIDGET-ID 106
     1591        t-is-over AT ROW 2.07 COL 41 WIDGET-ID 88
     1592        f-rule-num AT ROW 3.13 COL 75 COLON-ALIGNED WIDGET-ID 110
     1593        b-dis-rule AT ROW 3.13 COL 93.5 WIDGET-ID 112
     1594        b-lkp-dis-rule AT ROW 3.13 COL 97 WIDGET-ID 148
     1595        f-caller-id AT ROW 7.4 COL 60 COLON-ALIGNED WIDGET-ID 144
     1596        f-sum-id AT ROW 8.47 COL 60 COLON-ALIGNED WIDGET-ID 114
     1597        b-sum-id AT ROW 8.47 COL 95 WIDGET-ID 116
     1598        f-nd-caller-id AT ROW 9.53 COL 1 WIDGET-ID 146
     1599        E-rules AT ROW 14.6 COL 1 NO-LABEL WIDGET-ID 136
     1600        T-rule-sale-out AT ROW 14.87 COL 33 WIDGET-ID 126
     1601        T-rule-trn-out AT ROW 14.87 COL 51 WIDGET-ID 130
     1602        T-rule-recalc AT ROW 14.87 COL 73 WIDGET-ID 134
     1603        T-rule-sale-in AT ROW 15.87 COL 33 WIDGET-ID 128
     1604        T-rule-trn-in AT ROW 15.87 COL 51 WIDGET-ID 132
     1605        BR-rcp AT ROW 17 COL 1 WIDGET-ID 100
     1606        l-r-b AT ROW 2.07 COL 1.5 NO-LABEL WIDGET-ID 122
     1607        f-dis-rule-name AT ROW 4.2 COL 1 NO-LABEL WIDGET-ID 124
     1608        SPACE(1.09) SKIP(18.39)
     1609       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1610            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1611            TITLE ""
     1612            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1613   ASSIGN
     1614          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1615          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1616   ASSIGN
     1617          BR-rcp:HIDDEN  IN FRAME Dialog-Frame                = TRUE.
     1618   ASSIGN
     1619          l-r-b:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1620   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1621   DO:
     1622     APPLY "END-ERROR":U TO SELF.
     1623   END.
     1624   ON CHOOSE OF b-dis-rule IN FRAME Dialog-Frame
     1625   DO:
     1626   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1627   DEFINE VARIABLE v-sts AS INTEGER NO-UNDO.
     1628   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1629     run ref/dis-ruls.w (   input  parparentproc
     1630                           ,input 0
     1631                           ,input '':U
     1632                           ,input 0
     1633                           ,input "b-sel,b-add"
     1634                           ,input "upper-rule-num"
     1635                           ,input 64
     1636                           ,input ?
     1637                           ,input 0
     1638                           ,input-output v-sts
     1639                           ,input-OUTPUT v-rid-list) NO-ERROR.
     1640     if v-rid-list <> '':U then do:
     1641       find first buf_dis-rule no-lock where
     1642                 recid(buf_dis-rule) = integer(v-rid-list) no-error.
     1643       if not available buf_dis-rule then do:
     1644           MESSAGE substitute("Не найдено правило скидки c recid &1", v-rid-list)
     1645           VIEW-AS ALERT-BOX ERROR.
     1646           UNDO, RETURN NO-APPLY.
     1647       end.
     1648       assign
     1649       f-rule-num = buf_dis-rule.rule-num
     1650       .
     1651       DISPLAY
     1652       f-rule-num
     1653       buf_dis-rule.des @ f-dis-rule-name
     1654       WITH FRAME Dialog-Frame.
     1655     end.
     1656   END.
     1657   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1658   DO:
     1659     RUN proc-save IN THIS-PROCEDURE  NO-ERROR.
     1660     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1661   END.
     1662   ON CHOOSE OF b-lkp-dis-rule IN FRAME Dialog-Frame
     1663   DO:
     1664   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   if lookup(self :type
     1666            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1667            ) = 0
     1668   then do:
     1669     message
     1670       "$Workfile$"
     1671       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1672       "Интерфейсный элемент" self :name  skip
     1673       "Тип" self :type  skip
     1674       "Процедура" this-procedure :file-name skip
     1675       view-as alert-box .
     1676   end.
     1677   else do:
     1678     apply "entry":u to self  .
     1679     if focus :handle <> self :handle  then do:
     1680       return no-apply .
     1681     end.
     1682   end.
     1683     IF f-rule-num > 0  THEN
     1684     run ref/show-dr.p ( INPUT parparentproc
     1685                        ,INPUT f-rule-num) NO-ERROR.
     1686   END.
     1687   ON CHOOSE OF b-sum-id IN FRAME Dialog-Frame
     1688   DO:
     1689   define variable v-rid-list as character no-undo .
     1690   define buffer buf_prop-ref for ub.prop-ref.
     1691   run ref/proprefs.w (   input  parparentproc
     1692                         ,input "b-sel,b-add"
     1693                         ,input "dtm-code"
     1694                         ,input  7
     1695                         ,input '':U
     1696                         ,input '':U
     1697                         ,input-OUTPUT v-rid-list) NO-ERROR.
     1698   if v-rid-list = '' then return no-apply.
     1699   find first buf_prop-ref no-lock where
     1700             recid(buf_prop-ref) = integer(v-rid-list) no-error.
     1701   if not available buf_prop-ref then do:
     1702     MESSAGE
     1703     substitute("Нет среза с recid &1", v-rid-list)
     1704     VIEW-AS ALERT-BOX ERROR.
     1705     UNDO, RETURN NO-APPLY.
     1706   end.
     1707   f-sum-id = buf_prop-ref.sum-id.
     1708   f-nd-caller-id = buf_prop-ref.caller_id.
     1709   display
     1710   f-sum-id
     1711   f-nd-caller-id
     1712   with frame Dialog-Frame .
     1713   END.
     1714   ON VALUE-CHANGED OF t-is-over IN FRAME Dialog-Frame
     1715   DO:
     1716      assign
     1717      t-is-over.
     1718   END.
     1719   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     1720   DO:
     1721     IF AVAIL tt-rule-call-param THEN DO:
     1722       RUN rcps_set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     1723     END.
     1724   END.
     1725   ON f6 anywhere DO:
     1726     ASSIGN
     1727     br-rcp:VISIBLE IN FRAME Dialog-Frame = (NOT br-rcp:VISIBLE IN FRAME Dialog-Frame)
     1728     .
     1729   END.
     1730   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1731   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1732   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733   on help of frame Dialog-Frame
     1734   do:
     1735     run gbl/app_help.p
     1736       (input this-procedure :file-name
     1737       ,input ''
     1738       ,input ?
     1739       ) no-error.
     1740     if error-status :error then do:
     1741       message
     1742         "Ошибка при вызове помощи"
     1743         error-status :get-message(1)
     1744         view-as alert-box .
     1745     end.
     1746   end.
     1747   run minbtn-set in this-procedure .
     1748   on choose of b-help in frame Dialog-Frame
     1749   do:
     1750     apply "help":u to frame Dialog-Frame .
     1751   end.
     1752   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   procedure minbtn-set :
     1754       do
     1755           on error undo, return error return-value
     1756           :
     1757           define variable ii              as integer       no-undo .
     1758           define variable fh              as widget-handle no-undo .
     1759           define variable hh              as widget-handle no-undo .
     1760           define variable v-h             as handle        extent 4 no-undo .
     1761           define variable v-name-button   as character     no-undo .
     1762           define variable v-help-old-x    as decimal       no-undo .
     1763           define variable v-help-old-y    as decimal       no-undo .
     1764           define variable v-help-old-size as decimal       no-undo .
     1765           define variable v-frame-width   as decimal       no-undo .
     1766           define variable jj              as integer       no-undo .
     1767           do
     1768               on error undo, return error
     1769               :
     1770               assign
     1771                   v-frame-width = frame Dialog-Frame:width - 0.3
     1772                   fh            = frame Dialog-Frame:first-child
     1773                   hh            = fh:first-child
     1774                   ii            = 1
     1775                   .
     1776               do while valid-handle(hh):
     1777                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1778                   do:
     1779                       case lc(hh:name) :
     1780                           when "b-help" then
     1781                               do:
     1782                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1783                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1784                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1785                                   hh:TOOLTIP = "Помощь" .
     1786                                   v-help-old-x = hh:column .
     1787                                   v-help-old-y = hh:row    .
     1788                                   v-help-old-size = hh:width .
     1789                                   hh:width-chars = 2.5 .
     1790                               end.
     1791                           when "b-print" then
     1792                               do:
     1793                                   hh:load-image("cmp/b-print.bmp":u) .
     1794                                   hh:TOOLTIP = "Печать" .
     1795                                   v-h[ii] = hh:handle .
     1796                                   ii = ii + 1 .
     1797                                   hh:width-chars = 3 .
     1798                               end.
     1799                           when "b-history" or
     1800                           when "b-hist" then
     1801                               do:
     1802                                   hh:load-image("cmp/b-hist.bmp":u) .
     1803                                   hh:TOOLTIP = "История" .
     1804                                   v-h[ii] = hh:handle .
     1805                                   ii = ii + 1 .
     1806                                   hh:width-chars = 3 .
     1807                               end.
     1808                           when "b-sch" then
     1809                               do:
     1810                                   hh:load-image("cmp/b-sch.bmp":u) .
     1811                                   hh:TOOLTIP = "Установка Фильтра" .
     1812                                   v-h[ii] = hh:handle .
     1813                                   ii = ii + 1 .
     1814                                   hh:width-chars = 3 .
     1815                               end.
     1816                           when "b-hist-user" then
     1817                               do:
     1818                                   hh:load-image("cmp/b-hist.bmp":u) .
     1819                                   hh:TOOLTIP = "История пользователя" .
     1820                                   ii = ii + 1 .
     1821                               end.
     1822                       end case.
     1823                   end.
     1824                   hh = hh:next-sibling.
     1825               end.
     1826               b-help:column = v-frame-width - b-help:width-chars.
     1827               jj = 0.
     1828               repeat ii = 4 to 1 by -1 :
     1829                   if valid-handle (v-h[ii] ) then
     1830                   do:
     1831                       jj  = jj + 1 .
     1832                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1833                       v-h[ii]:row    = v-help-old-y .
     1834                   end.
     1835               end.
     1836           end.
     1837       end.
     1838   end procedure.
     1839   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1840   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1841   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1842   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1843   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1844   define variable v-diasize-current-frame-height as decimal   no-undo .
     1845   define variable v-diasize-change-size          as logical   no-undo .
     1846   define variable v-diasize-resize-button        as handle    no-undo .
     1847   define variable v-diasize-wndmax               as logical   no-undo .
     1848   define variable v-diasize-wndstore             as logical   no-undo .
     1849   define variable v-diasize-proc-name            as character no-undo .
     1850   define variable v-diasize-browse-handle        as handle    no-undo .
     1851   define variable v-diasize-browse-number        as integer   no-undo .
     1852   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1853   define temp-table temp-diasize-handle no-undo
     1854     field handle-value  as handle
     1855     field save-position as decimal
     1856     index xpk is primary unique handle-value
     1857     .
     1858   define temp-table temp-browse-handle no-undo
     1859     field browse-type   as character
     1860     field browse-number as integer
     1861     field browse-handle as handle
     1862     field original-size as decimal
     1863     index xpk is primary unique browse-type browse-number
     1864     index xie browse-type browse-handle
     1865   .
     1866   procedure diasize_change-height :
     1867     define input  parameter p-change-value  as decimal   no-undo .
     1868     define input  parameter p-move-resize   as logical   no-undo .
     1869     define variable v-field-group-handle    as handle    no-undo .
     1870     define variable v-object-handle         as handle    no-undo .
     1871     define variable v-frame-height          as decimal   no-undo .
     1872     define variable v-frame-virtual-height  as decimal   no-undo .
     1873     define variable v-browse-height         as decimal   no-undo .
     1874     define variable v-window-height         as decimal   no-undo .
     1875     define variable v-window-virtual-height as decimal   no-undo .
     1876     define variable v-change-sign           as integer   no-undo .
     1877     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1878     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1879     if p-change-value > 0
     1880     then do:
     1881       if frame Dialog-Frame :height + p-change-value
     1882           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1883       then do:
     1884         assign
     1885           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1886                           - (frame Dialog-Frame :height-chars)
     1887         .
     1888         if p-change-value <= 0
     1889         then do:
     1890           run diasize_position-resize-button in this-procedure .
     1891           return .
     1892         end.
     1893       end.
     1894     end.
     1895     if p-change-value < 0
     1896     then do:
     1897       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1898       then do:
     1899         assign
     1900           p-change-value = v-diasize-orig-frame-height
     1901                          - (frame Dialog-Frame :height-chars)
     1902         .
     1903         if p-change-value >= 0
     1904         then do:
     1905           run diasize_position-resize-button in this-procedure .
     1906           return .
     1907         end.
     1908       end.
     1909     end.
     1910     if p-change-value >= 0
     1911     then do:
     1912       assign
     1913         v-change-sign = 1
     1914       .
     1915     end.
     1916     else do:
     1917       assign
     1918         v-change-sign = -1
     1919       .
     1920     end.
     1921     assign
     1922       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1923     .
     1924     if p-change-value = 0
     1925     then do:
     1926       run diasize_position-resize-button in this-procedure .
     1927       return .
     1928     end.
     1929     move_block:
     1930     do
     1931     on error undo move_block, retry move_block
     1932     :
     1933       if retry
     1934       then do:
     1935         do
     1936         on error undo move_block, leave move_block
     1937         :
     1938           if p-change-value > 0
     1939           then do:
     1940             for each buf_temp-diasize-handle
     1941             on error undo, next
     1942             :
     1943               assign
     1944                 v-object-handle = buf_temp-diasize-handle.handle-value
     1945               .
     1946               if v-object-handle <> v-diasize-resize-button
     1947               then do:
     1948                 assign
     1949                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1950                 .
     1951               end.
     1952             end.
     1953             assign
     1954               v-diasize-browse-handle :height = v-browse-height
     1955             .
     1956             for each buf_temp-browse-handle
     1957               where buf_temp-browse-handle.browse-type = 'height':u
     1958             on error undo, next
     1959             :
     1960               assign
     1961                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1962               .
     1963             end.
     1964             assign
     1965               frame Dialog-Frame :height = v-frame-height
     1966             .
     1967             if frame Dialog-Frame :scrollable = true
     1968             then do:
     1969               assign
     1970                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1971               .
     1972             end.
     1973             run diasize_position-resize-button in this-procedure .
     1974           end.
     1975           else do:
     1976             if frame Dialog-Frame :scrollable = true
     1977             then do:
     1978               assign
     1979                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1980               .
     1981             end.
     1982             assign
     1983               frame Dialog-Frame :height = v-frame-height
     1984             .
     1985             assign
     1986               v-diasize-browse-handle :height = v-browse-height
     1987             .
     1988             for each buf_temp-browse-handle
     1989               where buf_temp-browse-handle.browse-type = 'height':u
     1990             on error undo, next
     1991             :
     1992               assign
     1993                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1994               .
     1995             end.
     1996             for each buf_temp-diasize-handle
     1997             on error undo, next
     1998             :
     1999               assign
     2000                 v-object-handle = buf_temp-diasize-handle.handle-value
     2001               .
     2002               if v-object-handle <> v-diasize-resize-button
     2003               then do:
     2004                 assign
     2005                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2006                 .
     2007               end.
     2008             end.
     2009             run diasize_position-resize-button in this-procedure .
     2010           end.
     2011           assign
     2012             v-diasize-change-size = false
     2013           .
     2014           leave move_block .
     2015         end.
     2016       end.
     2017       assign
     2018         v-diasize-need-full-display = true
     2019       .
     2020       if v-diasize-change-size = false
     2021       then do:
     2022         assign
     2023           v-diasize-change-size = true
     2024         .
     2025       end.
     2026       else do:
     2027         return .
     2028       end.
     2029       assign
     2030         v-frame-height = frame Dialog-Frame :height
     2031         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2032         v-browse-height = v-diasize-browse-handle :height
     2033       .
     2034       for each buf_temp-browse-handle
     2035         where buf_temp-browse-handle.browse-type = 'height':u
     2036       :
     2037         assign
     2038           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2039         .
     2040       end.
     2041       for each buf_temp-diasize-handle
     2042       :
     2043         delete buf_temp-diasize-handle .
     2044       end.
     2045       assign
     2046         v-field-group-handle = frame Dialog-Frame :first-child
     2047       .
     2048       do while valid-handle(v-field-group-handle)
     2049       :
     2050         assign
     2051           v-object-handle = v-field-group-handle :first-child
     2052         .
     2053         do while valid-handle(v-object-handle)
     2054         :
     2055           if  v-object-handle <> v-diasize-browse-handle :handle
     2056           and can-query(v-object-handle, "row")
     2057           and can-query(v-object-handle, "height")
     2058           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2059           then do:
     2060             find first buf_temp-browse-handle
     2061               where buf_temp-browse-handle.browse-type   = 'height':u
     2062                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2063               no-error .
     2064             if available buf_temp-browse-handle
     2065             then do:
     2066             end.
     2067             else do:
     2068               create buf_temp-diasize-handle .
     2069               assign
     2070                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2071                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2072               .
     2073             end.
     2074           end.
     2075           assign
     2076             v-object-handle = v-object-handle :next-sibling
     2077           .
     2078         end.
     2079         assign
     2080           v-field-group-handle = v-field-group-handle :next-sibling
     2081         .
     2082       end.
     2083       do with frame Dialog-Frame
     2084       :
     2085         hide v-diasize-resize-button .
     2086         assign
     2087           v-diasize-resize-button :row    = 1
     2088           v-diasize-resize-button :column = 1
     2089         .
     2090       end.
     2091       if p-change-value > 0
     2092       then do:
     2093         if frame Dialog-Frame :scrollable = true
     2094         then do:
     2095           assign
     2096             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2097             no-error .
     2098           if error-status :error
     2099           or error-status :get-message(1) <> ""
     2100           then do:
     2101             undo move_block, retry move_block .
     2102           end.
     2103         end.
     2104         assign
     2105           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2106           no-error .
     2107         if error-status :error
     2108         or error-status :get-message(1) <> ""
     2109         then do:
     2110           undo move_block, retry move_block .
     2111         end.
     2112         assign
     2113           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2114           no-error .
     2115         if error-status :error
     2116         or error-status :get-message(1) <> ""
     2117         then do:
     2118           undo move_block, retry move_block .
     2119         end.
     2120         for each buf_temp-browse-handle
     2121           where buf_temp-browse-handle.browse-type = 'height':u
     2122         on error undo move_block, retry move_block
     2123         :
     2124           assign
     2125             buf_temp-browse-handle.browse-handle :height
     2126               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2127             no-error .
     2128           if error-status :error
     2129           or error-status :get-message(1) <> ""
     2130           then do:
     2131             undo move_block, retry move_block .
     2132           end.
     2133         end.
     2134         for each buf_temp-diasize-handle
     2135         on error undo move_block, retry move_block
     2136         :
     2137           assign
     2138             v-object-handle = buf_temp-diasize-handle.handle-value
     2139           .
     2140           if v-object-handle <> v-diasize-resize-button
     2141           then do:
     2142             assign
     2143               v-object-handle :row = v-object-handle :row + p-change-value
     2144               no-error .
     2145             if error-status :error
     2146             or error-status :get-message(1) <> ""
     2147             then do:
     2148               undo move_block, retry move_block .
     2149             end.
     2150           end.
     2151         end.
     2152       end.
     2153       else do:
     2154         for each buf_temp-diasize-handle
     2155         on error undo move_block, retry move_block
     2156         :
     2157           assign
     2158             v-object-handle = buf_temp-diasize-handle.handle-value
     2159           .
     2160           if v-object-handle <> v-diasize-resize-button
     2161           then do:
     2162             assign
     2163               v-object-handle :row = v-object-handle :row + p-change-value
     2164               no-error .
     2165             if error-status :error
     2166             or error-status :get-message(1) <> ""
     2167             then do:
     2168               undo move_block, retry move_block .
     2169             end.
     2170           end.
     2171         end.
     2172         assign
     2173           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2174           no-error .
     2175         if error-status :error
     2176         or error-status :get-message(1) <> ""
     2177         then do:
     2178           undo move_block, retry move_block .
     2179         end.
     2180         for each buf_temp-browse-handle
     2181           where buf_temp-browse-handle.browse-type = 'height':u
     2182         on error undo move_block, retry move_block
     2183         :
     2184           assign
     2185             buf_temp-browse-handle.browse-handle :height
     2186               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2187             no-error .
     2188           if error-status :error
     2189           or error-status :get-message(1) <> ""
     2190           then do:
     2191             undo move_block, retry move_block .
     2192           end.
     2193         end.
     2194         assign
     2195           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2196           no-error .
     2197         if error-status :error
     2198         or error-status :get-message(1) <> ""
     2199         then do:
     2200           undo move_block, retry move_block .
     2201         end.
     2202         if frame Dialog-Frame :scrollable = true
     2203         then do:
     2204           assign
     2205             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2206             no-error .
     2207           if error-status :error
     2208           or error-status :get-message(1) <> ""
     2209           then do:
     2210             undo move_block, retry move_block .
     2211           end.
     2212         end.
     2213       end.
     2214       if p-move-resize = true
     2215       then do:
     2216         run diasize_position-resize-button in this-procedure .
     2217       end.
     2218       if v-diasize-wndstore = true
     2219       then do:
     2220         if connected("ub") = true
     2221         then do:
     2222           define variable v-cntxt-db-num        as integer   no-undo .
     2223           define variable v-cntxt-userid        as character no-undo .
     2224           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2225                                             , OUTPUT v-cntxt-userid
     2226                                             ) .
     2227           run gbl/wndsizew.p
     2228             (input  v-cntxt-db-num
     2229             ,input  v-cntxt-userid
     2230             ,input  v-diasize-proc-name
     2231             ,input  'height':u
     2232             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2233             ) .
     2234         end.
     2235       end.
     2236     end.
     2237     assign
     2238       v-diasize-change-size = false
     2239     .
     2240   end procedure.
     2241   procedure diasize_set-height :
     2242     define input  parameter p-new-height  as decimal   no-undo .
     2243     define input  parameter p-move-resize as logical   no-undo .
     2244     do
     2245     on error undo, return error return-value
     2246     :
     2247       run diasize_change-height in this-procedure
     2248         (input  (p-new-height - frame Dialog-Frame :height)
     2249         ,input  p-move-resize
     2250         ) .
     2251     end.
     2252   end procedure.
     2253   procedure diasize_change-width :
     2254     define input  parameter p-change-value as decimal   no-undo .
     2255     define input  parameter p-move-resize  as logical   no-undo .
     2256     define variable v-field-group-handle   as handle    no-undo .
     2257     define variable v-object-handle        as handle    no-undo .
     2258     define variable v-frame-width          as decimal   no-undo .
     2259     define variable v-frame-virtual-width  as decimal   no-undo .
     2260     define variable v-browse-width         as decimal   no-undo .
     2261     define variable v-window-width         as decimal   no-undo .
     2262     define variable v-window-virtual-width as decimal   no-undo .
     2263     define variable v-change-sign          as integer   no-undo .
     2264     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2265     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2266     if p-change-value > 0
     2267     then do:
     2268       if frame Dialog-Frame :width + p-change-value >
     2269           session :width-chars
     2270       then do:
     2271         assign
     2272           p-change-value = session :width-chars - frame Dialog-Frame :width
     2273         .
     2274         if p-change-value <= 0
     2275         then do:
     2276           run diasize_position-resize-button in this-procedure .
     2277           return .
     2278         end.
     2279       end.
     2280     end.
     2281     if p-change-value < 0
     2282     then do:
     2283       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2284       then do:
     2285         assign
     2286           p-change-value = v-diasize-orig-frame-width
     2287                          - frame Dialog-Frame :width
     2288         .
     2289         if p-change-value >= 0
     2290         then do:
     2291           run diasize_position-resize-button in this-procedure .
     2292           return .
     2293         end.
     2294       end.
     2295     end.
     2296     if p-change-value >= 0
     2297     then do:
     2298       assign
     2299         v-change-sign = 1
     2300       .
     2301     end.
     2302     else do:
     2303       assign
     2304         v-change-sign = -1
     2305       .
     2306     end.
     2307     assign
     2308       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2309     .
     2310     if p-change-value = 0
     2311     then do:
     2312       run diasize_position-resize-button in this-procedure .
     2313       return .
     2314     end.
     2315     move_block:
     2316     do
     2317     on error undo move_block, leave move_block
     2318     :
     2319       if retry
     2320       then do:
     2321         do
     2322         on error undo move_block, leave move_block
     2323         :
     2324           if p-change-value > 0
     2325           then do:
     2326             for each buf_temp-diasize-handle
     2327             on error undo, next
     2328             :
     2329               assign
     2330                 v-object-handle = buf_temp-diasize-handle.handle-value
     2331               .
     2332               if v-object-handle <> v-diasize-resize-button
     2333               then do:
     2334                 assign
     2335                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2336                 .
     2337               end.
     2338             end.
     2339             assign
     2340               v-diasize-browse-handle :width = v-browse-width
     2341             .
     2342             for each buf_temp-browse-handle
     2343               where buf_temp-browse-handle.browse-type = 'width':u
     2344             on error undo, next
     2345             :
     2346               assign
     2347                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2348               .
     2349             end.
     2350             assign
     2351               frame Dialog-Frame :width = v-frame-width
     2352             .
     2353             if frame Dialog-Frame :scrollable = true
     2354             then do:
     2355               assign
     2356                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2357               .
     2358             end.
     2359             run diasize_position-resize-button in this-procedure .
     2360           end.
     2361           else do:
     2362             if frame Dialog-Frame :scrollable = true
     2363             then do:
     2364               assign
     2365                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2366               .
     2367             end.
     2368             assign
     2369               frame Dialog-Frame :width = v-frame-width
     2370             .
     2371             for each buf_temp-browse-handle
     2372               where buf_temp-browse-handle.browse-type = 'width':u
     2373             on error undo, next
     2374             :
     2375               assign
     2376                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2377               .
     2378             end.
     2379             assign
     2380               v-diasize-browse-handle :width = v-browse-width
     2381             .
     2382             for each buf_temp-diasize-handle
     2383             on error undo, next
     2384             :
     2385               assign
     2386                 v-object-handle = buf_temp-diasize-handle.handle-value
     2387               .
     2388               if v-object-handle <> v-diasize-resize-button
     2389               then do:
     2390                 assign
     2391                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2392                 .
     2393               end.
     2394             end.
     2395             run diasize_position-resize-button in this-procedure .
     2396           end.
     2397           assign
     2398             v-diasize-change-size = false
     2399           .
     2400           leave move_block .
     2401         end.
     2402       end.
     2403       assign
     2404         v-diasize-need-full-display = true
     2405       .
     2406       if v-diasize-change-size = false
     2407       then do:
     2408         assign
     2409           v-diasize-change-size = true
     2410         .
     2411       end.
     2412       else do:
     2413         return .
     2414       end.
     2415       assign
     2416         v-frame-width = frame Dialog-Frame :width
     2417         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2418         v-browse-width = v-diasize-browse-handle :width
     2419       .
     2420       for each buf_temp-browse-handle
     2421         where buf_temp-browse-handle.browse-type = 'width':u
     2422       :
     2423         assign
     2424           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2425         .
     2426       end.
     2427       for each buf_temp-diasize-handle
     2428       :
     2429         delete buf_temp-diasize-handle .
     2430       end.
     2431       assign
     2432         v-field-group-handle = frame Dialog-Frame :first-child
     2433       .
     2434       do while valid-handle(v-field-group-handle)
     2435       :
     2436         assign
     2437           v-object-handle = v-field-group-handle :first-child
     2438         .
     2439         do while valid-handle(v-object-handle)
     2440         :
     2441           if  v-object-handle <> v-diasize-browse-handle :handle
     2442           and v-object-handle <> v-diasize-resize-button
     2443           and can-query(v-object-handle, "row")
     2444           and can-query(v-object-handle, "height")
     2445           and ( v-object-handle :col + v-object-handle :width
     2446                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2447               )
     2448           then do:
     2449             find first buf_temp-browse-handle
     2450               where buf_temp-browse-handle.browse-type   = 'width':u
     2451                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2452               no-error .
     2453             if available buf_temp-browse-handle
     2454             then do:
     2455             end.
     2456             else do:
     2457               create buf_temp-diasize-handle .
     2458               assign
     2459                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2460                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2461               .
     2462             end.
     2463           end.
     2464           assign
     2465             v-object-handle = v-object-handle :next-sibling
     2466           .
     2467         end.
     2468         assign
     2469           v-field-group-handle = v-field-group-handle :next-sibling
     2470         .
     2471       end.
     2472       do with frame Dialog-Frame
     2473       :
     2474         hide v-diasize-resize-button .
     2475         v-diasize-resize-button :row = 1.
     2476         v-diasize-resize-button :column = 1.
     2477       end.
     2478       if p-change-value > 0
     2479       then do:
     2480         if frame Dialog-Frame :scrollable = true
     2481         then do:
     2482           assign
     2483             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2484             no-error .
     2485           if error-status :error
     2486           or error-status :get-message(1) <> ""
     2487           then do:
     2488             undo move_block, retry move_block.
     2489           end.
     2490         end.
     2491         assign
     2492           frame Dialog-Frame :width = v-frame-width + p-change-value
     2493           no-error .
     2494         if error-status :error
     2495         or error-status :get-message(1) <> ""
     2496         then do:
     2497           undo move_block, retry move_block.
     2498         end.
     2499         assign
     2500           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2501         no-error .
     2502         if error-status :error
     2503         or error-status :get-message(1) <> ""
     2504         then do:
     2505           undo move_block, retry move_block.
     2506         end.
     2507         for each buf_temp-browse-handle
     2508           where buf_temp-browse-handle.browse-type = 'width':u
     2509         on error undo move_block, retry move_block
     2510         :
     2511           assign
     2512             buf_temp-browse-handle.browse-handle :width
     2513               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2514             no-error .
     2515           if error-status :error
     2516           or error-status :get-message(1) <> ""
     2517           then do:
     2518             undo move_block, retry move_block .
     2519           end.
     2520         end.
     2521         for each buf_temp-diasize-handle
     2522         on error undo move_block, retry move_block
     2523         :
     2524           assign
     2525             v-object-handle = buf_temp-diasize-handle.handle-value
     2526           .
     2527           if v-object-handle <> v-diasize-resize-button
     2528           then do:
     2529             assign
     2530               v-object-handle :col = v-object-handle :col + p-change-value
     2531               no-error .
     2532             if error-status :error
     2533             or error-status :get-message(1) <> ""
     2534             then do:
     2535               undo move_block, retry move_block .
     2536             end.
     2537           end.
     2538         end.
     2539       end.
     2540       else do:
     2541         for each buf_temp-diasize-handle
     2542         on error undo move_block, retry move_block
     2543         :
     2544           assign
     2545             v-object-handle = buf_temp-diasize-handle.handle-value
     2546           .
     2547           if v-object-handle <> v-diasize-resize-button
     2548           then do:
     2549             assign
     2550               v-object-handle :col = v-object-handle :col + p-change-value
     2551               no-error .
     2552             if error-status :error
     2553             or error-status :get-message(1) <> ""
     2554             then do:
     2555               undo move_block, retry move_block .
     2556             end.
     2557           end.
     2558         end.
     2559         for each buf_temp-browse-handle
     2560           where buf_temp-browse-handle.browse-type = 'width':u
     2561         on error undo move_block, retry move_block
     2562         :
     2563           assign
     2564             buf_temp-browse-handle.browse-handle :width
     2565               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2566             no-error .
     2567           if error-status :error
     2568           or error-status :get-message(1) <> ""
     2569           then do:
     2570             undo move_block, retry move_block .
     2571           end.
     2572         end.
     2573         assign
     2574           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2575           no-error .
     2576         if error-status :error
     2577         or error-status :get-message(1) <> ""
     2578         then do:
     2579           undo move_block, retry move_block.
     2580         end.
     2581         assign
     2582           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2583         no-error .
     2584         if error-status :error
     2585         or error-status :get-message(1) <> ""
     2586         then do:
     2587           undo move_block, retry move_block.
     2588         end.
     2589         if frame Dialog-Frame :scrollable = true
     2590         then do:
     2591           assign
     2592             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2593           no-error .
     2594           if error-status :error
     2595           or error-status :get-message(1) <> ""
     2596           then do:
     2597             undo move_block, retry move_block.
     2598           end.
     2599         end.
     2600       end.
     2601       if p-move-resize
     2602       then do:
     2603         run diasize_position-resize-button in this-procedure .
     2604       end.
     2605       if v-diasize-wndstore = true
     2606       then do:
     2607         if connected("ub") = true
     2608         then do:
     2609           define variable v-cntxt-db-num        as integer   no-undo .
     2610           define variable v-cntxt-userid        as character no-undo .
     2611           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2612                                             , OUTPUT v-cntxt-userid
     2613                                             ) .
     2614           run gbl/wndsizew.p
     2615             (input  v-cntxt-db-num
     2616             ,input  v-cntxt-userid
     2617             ,input  v-diasize-proc-name
     2618             ,input  'width':u
     2619             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2620             ) .
     2621         end.
     2622       end.
     2623     end.
     2624     assign
     2625       v-diasize-change-size = false
     2626     .
     2627   end procedure.
     2628   procedure diasize_set-width :
     2629     define input  parameter p-new-width  as decimal   no-undo .
     2630     define input  parameter p-move-resize as logical   no-undo .
     2631     do
     2632     on error undo, return error return-value
     2633     :
     2634       run diasize_change-width in this-procedure
     2635         (input  (p-new-width - frame Dialog-Frame :width)
     2636         ,input  p-move-resize
     2637         ) .
     2638     end.
     2639   end procedure.
     2640   procedure diasize_position-resize-button :
     2641     do with frame Dialog-Frame
     2642     :
     2643       hide v-diasize-resize-button .
     2644       assign
     2645         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2646                     - 1
     2647                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2648         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2649                     - 1
     2650                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2651       .
     2652       view v-diasize-resize-button .
     2653     end.
     2654   end procedure.
     2655   on alt-right anywhere
     2656   do:
     2657     run diasize_change-width in this-procedure
     2658       (input 1
     2659       ,input true
     2660       ) .
     2661     return no-apply .
     2662   end.
     2663   on alt-left anywhere
     2664   do:
     2665     run diasize_change-width in this-procedure
     2666       (input -1
     2667       ,input true
     2668       ) .
     2669     return no-apply .
     2670   end.
     2671   on alt-down anywhere
     2672   do:
     2673     run diasize_change-height in this-procedure
     2674       (input 1
     2675       ,input true
     2676       ) .
     2677     return no-apply .
     2678   end.
     2679   on alt-up anywhere
     2680   do:
     2681     run diasize_change-height in this-procedure
     2682       (input -1
     2683       ,input true
     2684       ) .
     2685     return no-apply .
     2686   end.
     2687   on alt-enter of frame Dialog-Frame
     2688   do:
     2689     run diasize_maximize in this-procedure
     2690       (input  ?
     2691       ).
     2692     return no-apply .
     2693   end.
     2694   procedure diasize_end-move :
     2695     do
     2696     on error undo, return error return-value
     2697     :
     2698       define variable v-row-delta as decimal   no-undo .
     2699       define variable v-col-delta as decimal   no-undo .
     2700       define variable v-new-row as decimal   no-undo .
     2701       define variable v-new-col as decimal   no-undo .
     2702       assign
     2703         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2704         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2705       .
     2706       assign
     2707         v-row-delta = v-new-row - frame Dialog-Frame :height
     2708         v-col-delta = v-new-col - frame Dialog-Frame :width
     2709       .
     2710       run diasize_change-height in this-procedure
     2711         (input v-row-delta
     2712         ,input true
     2713         ) .
     2714       run diasize_change-width in this-procedure
     2715         (input v-col-delta
     2716         ,input true
     2717         ) .
     2718     end.
     2719   end procedure.
     2720   procedure diasize_maximize :
     2721     define input  parameter p-action as logical   no-undo .
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725       if p-action = ?
     2726       then do:
     2727         if v-diasize-need-maximize = true
     2728         then do:
     2729           assign
     2730             p-action = true
     2731           .
     2732         end.
     2733         else do:
     2734           assign
     2735             p-action = false
     2736           .
     2737         end.
     2738       end.
     2739       if p-action = true
     2740       then do:
     2741         run diasize_change-height in this-procedure
     2742           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2743               - frame Dialog-Frame :height-chars
     2744           ,input true
     2745           ) .
     2746         run diasize_change-width in this-procedure
     2747           (input session :width-chars
     2748               - frame Dialog-Frame :width-chars
     2749           ,input true
     2750           ) .
     2751         assign
     2752           v-diasize-need-maximize = false
     2753         .
     2754       end.
     2755       else do:
     2756         run diasize_change-width in this-procedure
     2757           (input v-diasize-orig-frame-width
     2758               - frame Dialog-Frame :width-chars
     2759           ,input true
     2760           ) .
     2761         run diasize_change-height in this-procedure
     2762           (input v-diasize-orig-frame-height
     2763               - frame Dialog-Frame :height-chars
     2764           ,input true
     2765           ) .
     2766         assign
     2767           v-diasize-need-maximize = true
     2768         .
     2769       end.
     2770     end.
     2771   end procedure.
     2772   procedure diasize_restore-orig-size :
     2773     do
     2774     on error undo, return error return-value
     2775     :
     2776       assign
     2777         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2778         v-diasize-current-frame-height = frame Dialog-Frame :height
     2779       .
     2780       run diasize_set-height in this-procedure
     2781         (input  v-diasize-orig-frame-height
     2782         ,input  true
     2783         ) .
     2784       run diasize_set-width in this-procedure
     2785         (input  v-diasize-orig-frame-width
     2786         ,input  true
     2787         ) .
     2788     end.
     2789   end procedure.
     2790   procedure diasize_restore-current-size :
     2791     do
     2792     on error undo, return error return-value
     2793     :
     2794       run diasize_set-height in this-procedure
     2795         (input  v-diasize-current-frame-height
     2796         ,input  true
     2797         ) .
     2798       run diasize_set-width in this-procedure
     2799         (input  v-diasize-current-frame-width
     2800         ,input  true
     2801         ) .
     2802     end.
     2803   end procedure.
     2804   procedure diasize_set-browse-handle :
     2805     define input  parameter p-browse-handle as handle   no-undo .
     2806     define buffer buf_temp-browse-handle for temp-browse-handle .
     2807     do
     2808     on error undo, return error return-value
     2809     :
     2810       assign
     2811         v-diasize-browse-handle = p-browse-handle
     2812       .
     2813       for each buf_temp-browse-handle
     2814       on error undo, return error return-value
     2815       :
     2816         delete buf_temp-browse-handle .
     2817       end.
     2818     end.
     2819   end procedure.
     2820   procedure diasize_add_browse :
     2821     define input  parameter p-browse-type   as character no-undo .
     2822     define input  parameter p-browse-handle as handle    no-undo .
     2823     define buffer buf_temp-browse-handle for temp-browse-handle .
     2824     do
     2825     on error undo, return error return-value
     2826     :
     2827       assign
     2828         v-diasize-browse-number = v-diasize-browse-number + 1
     2829       .
     2830       create buf_temp-browse-handle .
     2831       assign
     2832         buf_temp-browse-handle.browse-type   = p-browse-type
     2833         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2834         buf_temp-browse-handle.browse-handle = p-browse-handle
     2835       .
     2836     end.
     2837   end procedure.
     2838   procedure diasize_init :
     2839     define variable v-default-value    as logical   no-undo .
     2840     define variable v-restore-saved    as logical   no-undo .
     2841     define variable v-resize-value-str as character no-undo .
     2842     do
     2843     on error undo, return error return-value
     2844     :
     2845       do with frame Dialog-Frame
     2846       :
     2847         assign
     2848           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2849           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2850           v-diasize-browse-handle     = browse BR-rcp :handle
     2851         .
     2852         create button v-diasize-resize-button
     2853         assign
     2854           parent        = frame Dialog-Frame :first-child
     2855           label         = "s"
     2856           height-pixels = 16
     2857           width-pixels  = 16
     2858           visible       = true
     2859           sensitive     = true
     2860           movable       = true
     2861           triggers:
     2862             on end-move persistent run diasize_end-move in this-procedure .
     2863           end triggers.
     2864         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2865         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2866         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2867         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2868         assign
     2869           v-diasize-wndmax = false
     2870         .
     2871         if connected("ub") = true
     2872         then do:
     2873           define variable v-cntxt-db-num        as integer   no-undo .
     2874           define variable v-cntxt-userid        as character no-undo .
     2875           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2876                                             , OUTPUT v-cntxt-userid
     2877                                             ) .
     2878           run gbl/wndpar_r.p
     2879             (input  v-cntxt-db-num
     2880             ,input  v-cntxt-userid
     2881             ,input  'wndmax':U
     2882             ,output v-diasize-wndmax
     2883             ,output v-default-value
     2884             ) .
     2885         end.
     2886         assign
     2887           v-diasize-wndstore = false
     2888         .
     2889         if connected("ub") = true
     2890         then do:
     2891           run gbl/wndpar_r.p
     2892             (input  v-cntxt-db-num
     2893             ,input  v-cntxt-userid
     2894             ,input  'wndstore':U
     2895             ,output v-diasize-wndstore
     2896             ,output v-default-value
     2897             ) .
     2898         end.
     2899         assign
     2900           v-diasize-proc-name = entry(1, program-name(2), '.')
     2901         .
     2902         if v-diasize-wndstore = true
     2903         then do:
     2904           assign
     2905             v-restore-saved = false
     2906           .
     2907           if connected("ub") = true
     2908           then do:
     2909             run gbl/wndsizer.p
     2910               (input  v-cntxt-db-num
     2911               ,input  v-cntxt-userid
     2912               ,input  v-diasize-proc-name
     2913               ,input  'height':u
     2914               ,output v-resize-value-str
     2915               ) .
     2916             if v-resize-value-str <> '':U
     2917             then do:
     2918               run diasize_change-height in this-procedure
     2919                 (input  integer(v-resize-value-str)
     2920                 ,input  true
     2921                 ) .
     2922               assign
     2923                 v-restore-saved = true
     2924               .
     2925             end.
     2926           end.
     2927           if connected("ub") = true
     2928           then do:
     2929             run gbl/wndsizer.p
     2930               (input  v-cntxt-db-num
     2931               ,input  v-cntxt-userid
     2932               ,input  v-diasize-proc-name
     2933               ,input  'width':u
     2934               ,output v-resize-value-str
     2935               ) .
     2936             if v-resize-value-str <> '':U
     2937             then do:
     2938               run diasize_change-width in this-procedure
     2939                 (input  integer(v-resize-value-str)
     2940                 ,input  true
     2941                 ) .
     2942               assign
     2943                 v-restore-saved = true
     2944               .
     2945             end.
     2946           end.
     2947           if v-restore-saved <> true
     2948           then do:
     2949             if v-diasize-wndmax = true
     2950             then do:
     2951               run diasize_maximize in this-procedure
     2952                 (input  true
     2953                 ) .
     2954             end.
     2955           end.
     2956         end.
     2957         else do:
     2958           if v-diasize-wndmax = true
     2959           then do:
     2960             run diasize_maximize in this-procedure
     2961               (input  true
     2962               ) .
     2963           end.
     2964         end.
     2965       end.
     2966     end.
     2967   end procedure.
     2968   procedure diasize_need-full-display :
     2969     define output parameter p-need-full-display as logical   no-undo .
     2970     do
     2971     on error undo, return error return-value
     2972     :
     2973       assign
     2974         p-need-full-display = v-diasize-need-full-display
     2975       .
     2976       assign
     2977         v-diasize-need-full-display = false
     2978       .
     2979     end.
     2980   end procedure.
     2981   procedure get-context :
     2982      define output parameter p-db-num as integer          no-undo.
     2983      define output parameter p-user-id as character        no-undo.
     2984      define variable v-login               as character    no-undo.
     2985      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2986      define buffer buf_user-login  for ub.user-login .
     2987      do
     2988      on error undo, return error
     2989      :
     2990            FIND FIRST buf_sys-ctrl no-lock.
     2991            ASSIGN
     2992               v-login = USERID("ub")
     2993               p-db-num = buf_sys-ctrl.db-num
     2994            .
     2995            FIND FIRST buf_user-login
     2996                 WHERE buf_user-login.db-num = p-db-num
     2997                   AND buf_user-login.user-login = v-login
     2998                 no-lock
     2999                 no-error
     3000                 .
     3001            IF AVAILABLE buf_user-login
     3002            THEN DO:
     3003               assign
     3004                  p-user-id = buf_user-login.user-id
     3005               .
     3006            END.
     3007      end.
     3008   end procedure.
     3009       run diasize_init in this-procedure .
     3010   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   procedure rcps_get-profile-id :
     3012   define output parameter p-local-profile-id as integer no-undo .
     3013   do
     3014   on error undo, return error:
     3015   p-local-profile-id = p-profile-id.
     3016   end.
     3017   end procedure.
     3018   PROCEDURE rcps_fill-table :
     3019   define input parameter p-clear-params as logical no-undo .
     3020   if p-clear-params then do:
     3021   FOR EACH tt-rule-call-param:
     3022       DELETE tt-rule-call-param.
     3023   END.
     3024   end.
     3025    FOR EACH tt0-rule-call-param:
     3026      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3027        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3028           NEXT.
     3029        end.
     3030        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3031          NEXT.
     3032        end.
     3033        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3034          NEXT.
     3035        end.
     3036        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3037          NEXT.
     3038        end.
     3039        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3040          NEXT.
     3041        end.
     3042      END.
     3043      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     3044        next.
     3045      end.
     3046      IF p-list-mode = 'rp-rule-param':U
     3047      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3048      THEN DO:
     3049         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3050           NEXT.
     3051         end.
     3052         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3053           NEXT.
     3054         end.
     3055      END.
     3056      CREATE tt-rule-call-param.
     3057      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     3058   END.
     3059   END PROCEDURE.
     3060   procedure rcps_get-value :
     3061   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3062   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3063   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3064   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3065   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     3066   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     3067   DEFINE output parameter p-value-date AS date NO-UNDO.
     3068   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     3069   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     3070   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     3071   define variable v-current-index as integer no-undo init -1.
     3072   define variable v-start as logical no-undo init yes.
     3073   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     3074   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3075   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3076   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     3077   do
     3078   on error undo, return error
     3079   :
     3080   FOR FIRST buf_rp-rule-param WHERE
     3081         buf_rp-rule-param.profile_id = p-profile-id
     3082     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3083   , each buf_tt-rule-call-param WHERE
     3084      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3085   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3086   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3087   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3088   AND buf_tt-rule-call-param.p-index >= pp-index
     3089    ,each buf_term_tt-rule-call-param where
     3090          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     3091      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     3092      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     3093      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     3094      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     3095      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     3096     by buf_term_tt-rule-call-param.call_id
     3097     by buf_term_tt-rule-call-param.codex_id
     3098     by buf_term_tt-rule-call-param.ruleset_id
     3099     by buf_term_tt-rule-call-param.order_id
     3100     by buf_term_tt-rule-call-param.param-name
     3101     by buf_term_tt-rule-call-param.p-index :
     3102       if v-start
     3103       then do:
     3104         assign
     3105         pp-index = buf_term_tt-rule-call-param.p-index
     3106         p-value-character = buf_term_tt-rule-call-param.param-value-character
     3107         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     3108         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     3109         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     3110         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     3111         v-start = no
     3112         .
     3113       end.
     3114       else do:
     3115         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     3116           v-current-index = buf_term_tt-rule-call-param.p-index.
     3117           leave.
     3118         end.
     3119             end.
     3120     end.
     3121     pp-index = v-current-index.
     3122   end.
     3123   end procedure.
     3124   PROCEDURE rcps_proc-b-add :
     3125   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3126   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3127   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3128   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3129   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     3130   define variable v-ind as integer no-undo .
     3131   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3132   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3133   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3134   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3135   FOR FIRST buf_rp-rule-param WHERE
     3136             buf_rp-rule-param.profile_id = p-profile-id
     3137         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3138       , first buf0_tt-rule-call-param WHERE
     3139          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3140      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3141      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3142      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3143     LEAVE.
     3144   END.
     3145   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3146     BELL.
     3147     RETURN.
     3148   END.
     3149   for each buf_rp-rule-param where
     3150           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3151       and buf_rp-rule-param.profile_id = p-profile-id,
     3152       first buf_tt-rule-call-param where
     3153           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3154       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3155       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3156       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3157       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3158       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3159       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3160       and buf_tt-rule-call-param.p-index = p-index:
     3161     RETURN.
     3162   END.
     3163   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3164   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3165   THEN DO:
     3166     BELL.
     3167     RETURN.
     3168   END.
     3169   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     3170     BELL.
     3171     RETURN.
     3172   END.
     3173   find last buf_tt-rule-call-param where
     3174            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3175        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     3176        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     3177        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     3178        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     3179   if available buf_tt-rule-call-param
     3180   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3181        or
     3182        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3183        )
     3184   and buf_tt-rule-call-param.p-index > 0 then do:
     3185     v-ind = buf_tt-rule-call-param.p-index.
     3186   end.
     3187   for each buf_rp-rule-param where
     3188           buf_rp-rule-param.rp-param-name = p-rp-param-name
     3189       and buf_rp-rule-param.profile_id = p-profile-id,
     3190       first buf_tt-rule-call-param where
     3191           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     3192       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3193       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3194       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3195       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3196       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3197       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     3198       and buf_tt-rule-call-param.p-index = 0
     3199   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3200   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3201   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3202   :
     3203     create buf2_tt-rule-call-param.
     3204     buffer-copy buf_tt-rule-call-param
     3205     except p-index
     3206     to buf2_tt-rule-call-param
     3207     assign
     3208     buf2_tt-rule-call-param.p-index = v-ind + 1
     3209     .
     3210   end.
     3211   END PROCEDURE.
     3212   PROCEDURE rcps_proc-b-del :
     3213   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3214   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3215   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3216   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3217   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3218   define variable v-ind as integer no-undo .
     3219   define variable v-once-more as integer no-undo .
     3220   define variable v-call-id as character no-undo .
     3221   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     3222   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3223   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3224   if pp-index = 0 then do:
     3225     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     3226   end.
     3227   FOR first buf_rp-rule-param WHERE
     3228             buf_rp-rule-param.profile_id = p-profile-id
     3229         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3230       , first buf0_tt-rule-call-param WHERE
     3231          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3232      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3233      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3234      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3235      AND buf0_tt-rule-call-param.p-index = pp-index
     3236      :
     3237     LEAVE.
     3238   END.
     3239   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3240     FOR first buf_rp-rule-param WHERE
     3241               buf_rp-rule-param.profile_id = p-profile-id
     3242           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3243         , last buf0_tt-rule-call-param WHERE
     3244           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3245       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3246       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3247       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3248       AND buf0_tt-rule-call-param.p-index > pp-index :
     3249       leave.
     3250     end.
     3251     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     3252     return "not-found".
     3253     end.
     3254     else do:
     3255       return ''.
     3256     end.
     3257   END.
     3258   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3259   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     3260   THEN DO:
     3261     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     3262   END.
     3263   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     3264     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     3265   END.
     3266   for each buf_rp-rule-param where
     3267           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     3268       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     3269       each buf_tt-rule-call-param where
     3270           buf_tt-rule-call-param.call_id = p-call-id
     3271       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3272       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3273       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3274       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3275       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3276       and buf_tt-rule-call-param.once-more = p-once-more
     3277       and buf_tt-rule-call-param.p-index = pp-index
     3278   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3279   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3280   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     3281       DELETE buf_tt-rule-call-param.
     3282   end.
     3283   return ''.
     3284   END PROCEDURE.
     3285   PROCEDURE rcps_proc-save0 :
     3286   FOR EACH tt-rule-call-param
     3287   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3288   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3289   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3290   :
     3291      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     3292               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3293          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3294          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     3295          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     3296          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     3297          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     3298      if not available tt0-rule-call-param
     3299      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     3300           OR
     3301           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     3302           )
     3303      and tt-rule-call-param.p-index > 0 then do:
     3304        create tt0-rule-call-param.
     3305      end.
     3306      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     3307   END.
     3308   FOR EACH tt0-rule-call-param
     3309   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3310   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3311   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3312   :
     3313     if tt0-rule-call-param.p-index = 0 then next.
     3314     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     3315     find  FIRST tt-rule-call-param NO-LOCK WHERE
     3316             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     3317         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     3318         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     3319         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     3320         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     3321         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     3322     if not available tt-rule-call-param
     3323     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     3324         OR
     3325         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     3326         )
     3327     and tt0-rule-call-param.p-index > 0
     3328     then do:
     3329        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     3330           NEXT.
     3331        end.
     3332        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     3333          NEXT.
     3334        end.
     3335        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     3336          NEXT.
     3337        end.
     3338        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     3339          NEXT.
     3340        end.
     3341        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     3342          NEXT.
     3343        end.
     3344       IF p-list-mode = 'rp-rule-param':U
     3345       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3346       THEN DO:
     3347         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     3348           NEXT.
     3349         end.
     3350         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     3351           NEXT.
     3352         end.
     3353       end.
     3354       delete tt0-rule-call-param.
     3355     end.
     3356   end.
     3357   END PROCEDURE.
     3358   PROCEDURE rcps_set-value :
     3359   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     3360   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     3361   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3362   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     3363   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     3364   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     3365   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     3366   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     3367   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     3368   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     3369   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     3370   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     3371   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     3372   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     3373   define variable v-found as logical no-undo .
     3374   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     3375   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     3376   FOR FIRST buf_rp-rule-param WHERE
     3377             buf_rp-rule-param.profile_id = p-profile-id
     3378         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3379       , first buf_tt-rule-call-param WHERE
     3380          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3381      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3382      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3383      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     3384     ASSIGN
     3385     v-codex-id = buf_tt-rule-call-param.codex_id
     3386     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     3387     v-order-id = buf_tt-rule-call-param.order_id
     3388     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     3389     .
     3390     LEAVE.
     3391   END.
     3392   CASE p-list-mode:
     3393     WHEN 'rp-rule-param':U THEN DO:
     3394       if pp-index > 0
     3395       then do:
     3396         FOR EACH  buf_rp-rule-param NO-LOCK where
     3397             buf_rp-rule-param.profile_id = p-profile-id
     3398             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3399             ,EACH buf_tt-rule-call-param WHERE
     3400                 buf_tt-rule-call-param.profile_id = p-profile-id
     3401             AND buf_tt-rule-call-param.once-more = p-once-more
     3402             AND buf_tt-rule-call-param.call_id = p-CALL-id
     3403             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3404             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3405             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3406             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3407             AND buf_tt-rule-call-param.p-index = pp-index
     3408         ON error undo, return error :
     3409           v-found = yes.
     3410         end.
     3411       end.
     3412       if not v-found then do:
     3413         run rcps_proc-b-add in this-procedure (
     3414                                                  input p-profile-id
     3415                                                 ,input p-once-more
     3416                                                 ,input p-call-id
     3417                                                 ,
     3418                                                  input p-rp-param-name
     3419                                                 ,input pp-index).
     3420       end.
     3421       FOR EACH  buf_rp-rule-param NO-LOCK where
     3422           buf_rp-rule-param.profile_id = p-profile-id
     3423           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     3424           ,EACH buf_tt-rule-call-param WHERE
     3425               buf_tt-rule-call-param.profile_id = p-profile-id
     3426           AND buf_tt-rule-call-param.once-more = p-once-more
     3427           AND buf_tt-rule-call-param.call_id = p-CALL-id
     3428           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3429           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3430           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3431           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3432           AND buf_tt-rule-call-param.p-index = pp-index
     3433         ON error undo, return error :
     3434         assign
     3435         buf_tt-rule-call-param.param-value-character = p-value-character
     3436         buf_tt-rule-call-param.param-value-date      = p-value-date
     3437         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3438         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3439         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3440         .
     3441       END.
     3442     END.
     3443     WHEN 'rule-call-param':U THEN DO:
     3444       FIND FIRST buf_tt-rule-call-param WHERE
     3445           buf_tt-rule-call-param.call_id = p-call-id
     3446       AND buf_tt-rule-call-param.codex_id = v-codex-id
     3447       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     3448       AND buf_tt-rule-call-param.order_id = v-order-id
     3449       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     3450       AND buf_tt-rule-call-param.p-index = pp-index.
     3451       assign
     3452       buf_tt-rule-call-param.param-value-character = p-value-character
     3453       buf_tt-rule-call-param.param-value-date      = p-value-date
     3454       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     3455       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     3456       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     3457       .
     3458     END.
     3459   END CASE.
     3460   END PROCEDURE.
     3461   procedure rcps_get-rule-on-off :
     3462   define input parameter p-codex-id as integer no-undo .
     3463   define input parameter p-ruleset-id as integer no-undo .
     3464   define input parameter p-rule-id as integer no-undo .
     3465   define input parameter p-profile-id as integer no-undo .
     3466   define input parameter p-once-more as integer no-undo .
     3467   define output parameter p-on-off as logical no-undo .
     3468   if valid-handle(p-call-handle)
     3469   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3470     run rcpscont_get-rule-on-off in p-call-handle (
     3471                                              input p-codex-id
     3472                                             ,input p-ruleset-id
     3473                                             ,input p-rule-id
     3474                                             ,input p-profile-id
     3475                                             ,input p-once-more
     3476                                             ,output p-on-off) no-error.
     3477   end.
     3478   end procedure.
     3479   procedure rcps_set-rule-on-off :
     3480   define input parameter p-codex-id as integer no-undo .
     3481   define input parameter p-ruleset-id as integer no-undo .
     3482   define input parameter p-rule-id as integer no-undo .
     3483   define input parameter p-profile-id as integer no-undo .
     3484   define input parameter p-once-more as integer no-undo .
     3485   define input parameter p-on-off as logical no-undo .
     3486   if valid-handle(p-call-handle)
     3487   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     3488     run rcpscont_set-rule-on-off in p-call-handle (
     3489                                              input p-codex-id
     3490                                             ,input p-ruleset-id
     3491                                             ,input p-rule-id
     3492                                             ,input p-profile-id
     3493                                             ,input p-once-more
     3494                                             ,input p-on-off) no-error.
     3495   end.
     3496   end procedure.
     3497   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3498   PROCEDURE rcps_MyEnable0 :
     3499   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3500   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3501   ASSIGN
     3502   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3503   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3504   .
     3505   ASSIGN
     3506   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3507   REPEAT WHILE valid-handle(v-ch0):
     3508      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3509        v-ch[1] = v-ch0.
     3510        v-ch0:VISIBLE = NO.
     3511      END.
     3512      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3513        v-ch[2] = v-ch0.
     3514        v-ch0:VISIBLE = NO.
     3515      END.
     3516      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3517        v-ch[3] = v-ch0.
     3518        v-ch0:VISIBLE = NO.
     3519      END.
     3520      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3521        v-ch[4] = v-ch0.
     3522        v-ch0:VISIBLE = NO.
     3523      END.
     3524      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3525        v-ch[5] = v-ch0.
     3526        v-ch0:VISIBLE = NO.
     3527      END.
     3528      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3529        v-ch[6] = v-ch0.
     3530      END.
     3531      IF v-ch0:LABEL = "Значение" THEN
     3532      v-ch0:RESIZABLE = YES.
     3533      v-ch0 = v-ch0:NEXT-COLUMN.
     3534   END.
     3535   assign
     3536   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3537   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3538   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3539   .
     3540   CASE p-list-mode:
     3541     WHEN 'rule-call-param':U THEN DO:
     3542        ASSIGN
     3543        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3544        .
     3545     END.
     3546     WHEN 'rp-rule-param':U
     3547     or
     3548     when 'rp-rule-param':U + chr(44) + 'все':U
     3549     THEN DO:
     3550       assign
     3551       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3552       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3553       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3554       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3555       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3556       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3557       .
     3558     END.
     3559   END CASE.
     3560    IF p-call-id <> '':U THEN DO:
     3561      v-ch[6]:VISIBLE = NO.
     3562    END.
     3563     IF p-profile-id <> 0 THEN DO:
     3564      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3565    END.
     3566     IF p-rule-id <> 0 THEN DO:
     3567      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3568    END.
     3569     IF p-once-more <> 0 THEN DO:
     3570      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3571    END.
     3572   END PROCEDURE.
     3573   PROCEDURE rcps_Openbr :
     3574   CASE p-list-mode:
     3575     WHEN 'rp-rule-param':U THEN DO:
     3576         OPEN QUERY br-rcp
     3577         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     3578             ,FIRST X_rp-rule-param WHERE
     3579                 X_rp-rule-param.profile_id = p-profile-id
     3580             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3581           , first tt-rule-call-param WHERE
     3582              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3583          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3584          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3585          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3586            ,each term_tt-rule-call-param where
     3587                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3588              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3589              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3590              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3591              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3592         BY tt-rule-call-param.call_id
     3593         BY tt-rule-call-param.codex_id
     3594         BY tt-rule-call-param.ruleset_id
     3595         BY tt-rule-call-param.order_id
     3596         BY tt-rule-call-param.param-num.
     3597     END.
     3598   END CASE.
     3599   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3600   APPLy "VALUE-CHANGED" to br-rcp.
     3601   END PROCEDURE.
     3602   PROCEDURE rcps_proc-b-chg PRIVATE :
     3603   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3604   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3605   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3606   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3607   define variable v-param-data-type as character no-undo .
     3608   define variable v-rid-list as character no-undo .
     3609   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3610     RETURN ERROR.
     3611   END.
     3612   ASSIGN
     3613   v-rec1 = rowid(X_ruledict-param)
     3614   v-rec2 = rowid(X_rp-rule-param)
     3615   v-rec3 = Rowid(tt-rule-call-param)
     3616   v-rec4 = Rowid(term_tt-rule-call-param)
     3617   .
     3618   run rcps_openbr in this-procedure .
     3619   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     3620   IF ERROR-STATUS:ERROR THEN DO:
     3621     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     3622   END.
     3623   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     3624   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     3625   END PROCEDURE.
     3626   PROCEDURE rcps_set-row-color :
     3627   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     3628   ASSIGN
     3629   v-ch[1]:FGCOLOR = GREY_COLOR
     3630   v-ch[1]:BGCOLOR = GREY_Color
     3631   v-ch[1]:PFCOLOR = GREY_Color
     3632   v-ch[2]:FGCOLOR = GREY_COLOR
     3633   v-ch[2]:BGCOLOR = GREY_Color
     3634   v-ch[2]:PFCOLOR = GREY_Color
     3635   v-ch[3]:FGCOLOR = GREY_COLOR
     3636   v-ch[3]:BGCOLOR = GREY_Color
     3637   v-ch[3]:PFCOLOR = GREY_Color
     3638   v-ch[4]:FGCOLOR = GREY_COLOR
     3639   v-ch[4]:BGCOLOR = GREY_Color
     3640   v-ch[4]:PFCOLOR = GREY_Color
     3641   v-ch[5]:FGCOLOR = GREY_COLOR
     3642   v-ch[5]:BGCOLOR = GREY_Color
     3643   v-ch[5]:PFCOLOR = GREY_Color
     3644   .
     3645   CASE entry(1, p-data-type):
     3646        WHEN 'character':U THEN DO:
     3647         ASSIGN
     3648         v-ch[1]:FGCOLOR = BLACK_COLOR
     3649         v-ch[1]:BGCOLOR = WHITE_Color.
     3650       END.
     3651       WHEN 'decimal':U THEN DO:
     3652         ASSIGN
     3653         v-ch[3]:FGCOLOR = BLACK_COLOR
     3654         v-ch[3]:BGCOLOR = WHITE_Color.
     3655       END.
     3656       WHEN 'integer':U THEN DO:
     3657         ASSIGN
     3658         v-ch[4]:FGCOLOR = BLACK_COLOR
     3659         v-ch[4]:BGCOLOR = WHITE_Color.
     3660       END.
     3661       WHEN 'date':U THEN DO:
     3662         ASSIGN
     3663         v-ch[2]:FGCOLOR = BLACK_COLOR
     3664         v-ch[2]:BGCOLOR = WHITE_Color.
     3665        END.
     3666        WHEN 'logical':U THEN DO:
     3667          ASSIGN
     3668          v-ch[5]:FGCOLOR = BLACK_COLOR
     3669          v-ch[5]:BGCOLOR = WHITE_Color.
     3670        END.
     3671   END CASE.
     3672   END PROCEDURE.
     3673   MAIN-BLOCK:
     3674   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3675      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3676   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3677     run mainmenu_getcntxt in parparentproc
     3678       (output v-cntxt-db-num
     3679       ,output v-cntxt-userid
     3680       ,output v-cntxt-level
     3681       ,output v-cntxt-host-code-obj
     3682       ,output v-cntxt-obj-type
     3683       ,output v-cntxt-obj-code
     3684       ,output v-cntxt-db-num-obj
     3685       ,output v-cntxt-is-admin
     3686       ) .
     3687      run gbl/dftempl.p ( input 'rp-rule-param':U
     3688                        , output v-dflt-rec) no-error.
     3689       if error-status:error then dO:
     3690         message
     3691         vss-workfile vss-revision vss-description skip
     3692         "Невозможно найти recid template записи в таблице rp-rule-param"
     3693         view-as alert-box error .
     3694         return error.
     3695       end.
     3696       run gbl/dftempl.p ( input 'ruledict-param':U
     3697                         , output v-rp-dflt-rec) no-error.
     3698        if error-status:error then dO:
     3699          message
     3700          vss-workfile vss-revision vss-description skip
     3701          "Невозможно найти recid template записи в таблице ruledict-param"
     3702          view-as alert-box error .
     3703          return error.
     3704        end.
     3705     IF p-list-mode = 'rp-rule-param':U
     3706     THEN DO:
     3707       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3708                 buf_rule-profile.profile_id = p-profile-id.
     3709       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3710                                       ,input buffer buf_rule-profile:handle
     3711                                       ,output v-uniq-key-rec).
     3712       FIND FIRST buf_ruledict NO-LOCK WHERE
     3713                 buf_ruledict.entry-type = 'rule-profile':U
     3714          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3715       v-rcps-entry-id = buf_ruledict.entry-id.
     3716     END.
     3717     ELSE DO:
     3718        MESSAGE
     3719        substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     3720        VIEW-AS alert-box.
     3721     END.
     3722     if p-call-id begins 'schedule':U then do:
     3723       v-running-mode = yes.
     3724     end.
     3725     RUN rcps_fill-table IN THIS-PROCEDURE ( input yes).
     3726     RUN Myenable in THIS-PROCEDURE.
     3727     WAIT-FOR GO OF FRAME Dialog-Frame.
     3728   END.
     3729   RUN disable_UI.
     3730   PROCEDURE disable_UI :
     3731     HIDE FRAME Dialog-Frame.
     3732   END PROCEDURE.
     3733   PROCEDURE enable_UI :
     3734     DISPLAY rs-r-b t-is-over f-rule-num f-caller-id f-sum-id f-nd-caller-id
     3735             E-rules T-rule-sale-out T-rule-trn-out T-rule-recalc T-rule-sale-in
     3736             T-rule-trn-in l-r-b f-dis-rule-name
     3737         WITH FRAME Dialog-Frame.
     3738     ENABLE B-exit b-quit B-Help rs-r-b t-is-over f-rule-num b-dis-rule
     3739            b-lkp-dis-rule f-caller-id f-sum-id b-sum-id E-rules T-rule-sale-out
     3740            T-rule-trn-out T-rule-recalc T-rule-sale-in T-rule-trn-in BR-rcp
     3741         WITH FRAME Dialog-Frame.
     3742     VIEW FRAME Dialog-Frame.
     3743   END PROCEDURE.
     3744   PROCEDURE MyEnable :
     3745   define variable v-list as character no-undo .
     3746   define variable glog as logical no-undo .
     3747   define variable v-index-id as integer no-undo .
     3748   define variable v-value-character as character no-undo .
     3749   define variable v-value-date as date no-undo .
     3750   define variable v-value-decimal as decimal no-undo .
     3751   define variable v-value-integer as integer no-undo .
     3752   define variable v-value-logical as logical no-undo .
     3753   define variable v-shop-code as integer no-undo .
     3754   define buffer buf_dis-rule for ub.dis-rule.
     3755   run rcps_Myenable0 in this-procedure .
     3756   ASSIGN
     3757   rs-r-b:RADIO-BUTTONS IN FRAME Dialog-Frame =
     3758   'руб.':U + chr(44) + 'rubl':U + chr(44) +
     3759   'вал.':U + chr(44) + 'base':U
     3760   .
     3761   v-index-id = 0.
     3762   RUN rcps_get-value IN THIS-PROCEDURE (
     3763                                    INPUT p-profile-id
     3764                                   ,INPUT p-once-more
     3765                                   ,INPUT p-call-id
     3766                                   ,INPUT "p-is-over"
     3767                                   ,INPUT-output v-index-id
     3768                                   ,output v-value-character
     3769                                   ,output v-value-date
     3770                                   ,output v-value-decimal
     3771                                   ,output v-value-integer
     3772                                   ,output t-is-over
     3773                                   ).
     3774   v-index-id = 0.
     3775   RUN rcps_get-value IN THIS-PROCEDURE (
     3776                                    INPUT p-profile-id
     3777                                   ,INPUT p-once-more
     3778                                   ,INPUT p-call-id
     3779                                   ,INPUT "p-r-b"
     3780                                   ,INPUT-output v-index-id
     3781                                   ,output rs-r-b
     3782                                   ,output v-value-date
