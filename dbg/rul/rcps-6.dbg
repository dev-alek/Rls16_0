     3992   PROCEDURE proc-save :
     3993   define buffer buf_prop-ref for ub.prop-ref.
     3994   define variable v-ii as integer   no-undo .
     3995   DEFINE VARIABLE v-today as date no-undo .
     3996   DEFINE VARIABLE v-time as integer no-undo .
     3997   v-ii = 0.
     3998   assign
     3999   frame Dialog-Frame
     4000   t-is-over
     4001   T-rule-recalc
     4002   T-rule-sale-in
     4003   T-rule-sale-out
     4004   T-rule-trn-in
     4005   T-rule-trn-out
