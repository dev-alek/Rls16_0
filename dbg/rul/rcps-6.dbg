     4012   run cur-time in this-procedure ( output v-today, output v-time).
     4013   find first buf_prop-ref no-lock where
     4014             buf_prop-ref.dtm-code = 5
     4015         and buf_prop-ref.caller_id = f-caller-id
     4016         and buf_prop-ref.sum-id >= propreft-date-to-string(v-today)
     4017         no-error.
     4018   if not available buf_prop-ref then do:
     4019     message
     4020     substitute("Внимание! В момент начала работы по данному профайлу в БД должен быть срез/итог по ДК за соответствующий период, у которого доп. идентификатор=&1"
     4021                , f-caller-id
     4022                )
     4023     view-as alert-box warning.
     4024   end.
