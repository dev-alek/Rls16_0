     3876   .
     3877   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3878   ASSIGN
     3879   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3880   REPEAT WHILE valid-handle(v-ch0):
     3881      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3882        v-ch[1] = v-ch0.
     3883        v-ch0:VISIBLE = NO.
     3884      END.
     3885      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3886        v-ch[2] = v-ch0.
     3887        v-ch0:VISIBLE = NO.
     3888      END.
     3889      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3890        v-ch[3] = v-ch0.
     3891        v-ch0:VISIBLE = NO.
     3892      END.
     3893      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3894        v-ch[4] = v-ch0.
     3895        v-ch0:VISIBLE = NO.
     3896      END.
     3897      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3898        v-ch[5] = v-ch0.
     3899        v-ch0:VISIBLE = NO.
     3900      END.
     3901      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3902        v-ch[6] = v-ch0.
     3903      END.
     3904      IF v-ch0:LABEL = "Значение" THEN
     3905      v-ch0:RESIZABLE = YES.
     3906      v-ch0 = v-ch0:NEXT-COLUMN.
     3907   END.
     3908   assign
