     3929       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3930       .
     3931     END.
     3932   END CASE.
     3933    IF p-call-id <> '':U THEN DO:
     3934      v-ch[6]:VISIBLE = NO.
     3935    END.
     3936     IF p-profile-id <> 0 THEN DO:
     3937      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3938    END.
     3939     IF p-rule-id <> 0 THEN DO:
     3940      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3941    END.
     3942     IF p-once-more <> 0 THEN DO:
