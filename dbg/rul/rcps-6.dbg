     1511        RADIO-BUTTONS
     1512             "Item 1", "rubl",
     1513   "Item 1", "base"
     1514        SIZE 15 BY 1 NO-UNDO.
     1515   DEFINE VARIABLE t-is-over AS LOGICAL INITIAL no
     1516        LABEL "Учет перевыпуска карт"
