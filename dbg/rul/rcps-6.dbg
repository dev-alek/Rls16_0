     1488        VIEW-AS FILL-IN
     1489        SIZE 37.5 BY 1 TOOLTIP "Можно оставить пустой" NO-UNDO.
     1490   DEFINE VARIABLE f-dis-rule-name AS CHARACTER FORMAT "X(256)":U
     1491         VIEW-AS TEXT
     1492        SIZE 98 BY .67
     1493        FGCOLOR 4  NO-UNDO.
     1494   DEFINE VARIABLE f-nd-caller-id AS CHARACTER FORMAT "X(256)":U
     1495        LABEL "Доп.метка среза скидок в след. периоде (с типом Период Дат)"
     1496        VIEW-AS FILL-IN NATIVE
     1497        SIZE 37.5 BY 1 NO-UNDO.
     1498   DEFINE VARIABLE f-rule-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1499        LABEL "Правило зависимости СУММА НАКОПЛЕНИЙ  -> % СКИДКИ на итог в тек. периоде"
     1500        VIEW-AS FILL-IN
     1501        SIZE 16 BY 1 NO-UNDO.
     1502   DEFINE VARIABLE f-sum-id AS CHARACTER FORMAT "X(256)":U
     1503        LABEL "Идентификатор среза скидок на итог в следующем периоде"
     1504        VIEW-AS FILL-IN
     1505        SIZE 31 BY 1 NO-UNDO.
     1506   DEFINE VARIABLE l-r-b AS CHARACTER FORMAT "X(256)":U INITIAL "Расчет вести от:"
     1507         VIEW-AS TEXT
     1508        SIZE 22.5 BY .67 NO-UNDO.
     1509   DEFINE VARIABLE rs-r-b AS CHARACTER
