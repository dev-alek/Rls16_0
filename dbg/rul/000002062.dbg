        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as widget-handle       no-undo .
        3   define input parameter p-parent-handle as handle              no-undo .
        4   define input parameter p-log-handle    as handle              no-undo .
        5   define input parameter p-cont-handle   as handle              no-undo .
        6   define input parameter p-codex-id      as integer             no-undo .
        7   define input parameter p-ruleset-id    as integer             no-undo .
        8   define input parameter p-call-id       as character           no-undo .
        9   define input parameter p-order-id      as integer             no-undo .
       10   define input parameter p-rule-id       as integer             no-undo .
       11   define input parameter p-profile-id    as integer             no-undo .
       12   define input parameter p-is-dynamic    as logical             no-undo .
       13   define input parameter p-doc-type      as character           no-undo .
       14   define input parameter p-host-code  like ub.sysconf.host-code no-undo .
       15   define input parameter p-obj-type   like ub.clients.obj-type  no-undo .
       16   define input parameter p-obj-code   like ub.clients.obj-code  no-undo .
       17   define input parameter p-doc-code      as character           no-undo .
       18   define input parameter p-process-file-name as character       no-undo .
       19   define input parameter p-save          as integer             no-undo .
       20   define input parameter v-curr-r-b      as character           no-undo .
       21   define input parameter p-cmd-proc-handle as handle            no-undo .
       22   define input parameter p-cmd-code      as integer             no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision: 5ee64da48eb6, 3419, rls $":U .
       24   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       25   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:30 $":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile: 000002062.p $":U .
       27   define variable vss-archive     as character no-undo init "$Archive: rul/000002062.p $":U .
       28   define variable vss-description as character no-undo init "Библиотека процедур для работы с кодексом 24, набор 1".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define   shared variable g#auto as logical no-undo.
       90   define   shared variable g#news as logical no-undo.
       91   define   shared variable g#oxml as logical no-undo.
       92   define   shared variable g#esys as logical no-undo.
       93   define   shared variable g#news-source-db as integer no-undo.
       94   define   shared variable g#esys-source-esys as integer no-undo.
       95   define   shared variable g#db-num as integer   no-undo .
       96   define   shared variable g#userid as character no-undo .
       97   define   shared variable g#passwd as character no-undo .
       98   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       99   define  variable garbcoll_ii as integer no-undo .
      100   define  temp-table temp-gc no-undo
      101   field ii as integer
      102   field obj-r as handle
      103   field cn as character
      104   index pi is unique primary
      105   ii
      106   index icn
      107   cn.
      108   procedure garbcoll_create-gc-entry :
      109   define input parameter p-cn as character no-undo .
      110   define input parameter p-obj-r as handle no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       create temp-gc.
      115       assign
      116       temp-gc.ii = garbcoll_ii
      117       garbcoll_ii = garbcoll_ii + 1
      118       temp-gc.cn = p-cn
      119       temp-gc.obj-r = p-obj-r
      120       .
      121     end.
      122   end procedure.
      123   procedure garbcoll_clear :
      124     do
      125     on error undo, return error
      126     :
      127       for each temp-gc:
      128         delete object temp-gc.obj-r.
      129         delete temp-gc.
      130       end.
      131     end.
      132   end procedure.
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   procedure cur-time :
      135      define output parameter p-today as date      no-undo .
      136      define output parameter p-time  as integer   no-undo .
      137     do
      138     on error undo, return error
      139     :
      140       define variable v-date1 as date      no-undo .
      141       define variable v-date2 as date      no-undo .
      142       define variable v-time  as integer   no-undo .
      143       assign
      144         v-date1 = today
      145         v-time  = time
      146         v-date2 = today
      147       .
      148       if v-date1 <> v-date2
      149       then do:
      150         assign
      151           v-date1 = today
      152           v-time  = v-time
      153         .
      154       end.
      155       assign
      156         p-today = v-date1
      157         p-time  = v-time
      158       .
      159     end.
      160   end.
      161   function cur-time-date returns character
      162   :
      163     return string(today, '99/99/9999':U) .
      164   end.
      165   function cur-time-mjd returns decimal
      166   :
      167     define variable v-date as date      no-undo .
      168     define variable v-time as integer   no-undo .
      169     run cur-time in this-procedure
      170       (output v-date
      171       ,output v-time
      172       ) .
      173     return integer(v-date) - 2400002 + (v-time / 86400) .
      174   end.
      175   function cur-time-get-ending-index returns integer
      176   (input p-number as integer
      177   )
      178   :
      179     if p-number < 0
      180     or p-number = ?
      181     then do:
      182       return 1 .
      183     end.
      184     define variable v-rest as integer   no-undo .
      185     assign
      186       p-number = p-number modulo 100
      187     .
      188     if p-number < 20
      189     then do:
      190       assign
      191         v-rest = p-number
      192       .
      193     end.
      194     else do:
      195       assign
      196         v-rest = p-number modulo 10
      197       .
      198     end.
      199     case v-rest :
      200       when 1
      201       then do:
      202         return 2 .
      203       end.
      204       when 2 or
      205       when 3 or
      206       when 4
      207       then do:
      208         return 3 .
      209       end.
      210       otherwise do:
      211         return 1 .
      212       end.
      213     end case .
      214   end.
      215   procedure cur-time-mjd-to-date :
      216      define input  parameter i-mjd-diff as decimal no-undo.
      217      define output parameter o-Date     as date    no-undo.
      218      define output parameter o-Time     as integer no-undo.
      219      define variable v-day-number as integer   no-undo .
      220      if    i-mjd-diff < 0
      221         or i-mjd-diff = ?
      222      then do:
      223         return "?" .
      224      end.
      225      assign
      226         v-day-number = truncate(i-mjd-diff,0).
      227         o-Date = date(v-day-number + 2400002).
      228         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230   end.
      231   function cur-time-mjd-to-string returns character
      232   (input p-mjd-diff as decimal
      233   )
      234   :
      235     define variable v-day-number as integer   no-undo .
      236     define variable v-seconds    as integer   no-undo .
      237     define variable v-hour       as integer   no-undo .
      238     define variable v-min        as integer   no-undo .
      239     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      240     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      241     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      242     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      243     if p-mjd-diff < 0
      244     or p-mjd-diff = ?
      245     then do:
      246       return "?" .
      247     end.
      248     assign
      249       v-day-number = integer(truncate(p-mjd-diff,0))
      250       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      251     .
      252     if v-seconds > 86400
      253     then do:
      254       assign
      255         v-seconds = 86400 - 1
      256       .
      257     end.
      258     if v-seconds < 0
      259     then do:
      260       assign
      261         v-seconds = 0
      262       .
      263     end.
      264     assign
      265       v-hour = truncate(v-seconds / 3600, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 3600
      269     .
      270     assign
      271       v-min = truncate(v-seconds / 60, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 60
      275     .
      276     return
      277         (if v-day-number <> 0
      278           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0
      282           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      283           else ""
      284         )
      285       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      286           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      287           else ""
      288         )
      289       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      290       .
      291   end.
      292   function cur-time-string returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-string-sec returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      311   end.
      312   function cur-time-custom  returns character
      313   (input p-prefix as character
      314   ,input p-date-format as character
      315   ,input p-delimiter as character
      316   ,input p-time-format as character
      317   ,input p-suffix as character
      318   )
      319   :
      320     define variable v-date as date      no-undo .
      321     define variable v-time as integer   no-undo .
      322     run cur-time in this-procedure
      323       (output v-date
      324       ,output v-time
      325       ) .
      326     return
      327       p-prefix
      328       + string(v-date, p-date-format)
      329       + p-delimiter
      330       + string(v-time, p-time-format)
      331       + p-suffix
      332       .
      333   end.
      334   function cur-time-print  returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-datetime returns datetime
      345   :
      346     define variable v-char as character no-undo .
      347     define variable v-datetime as datetime no-undo .
      348     v-char = cur-time-string().
      349     v-datetime = datetime(v-char).
      350     return  v-datetime.
      351   end.
      352   function cur-time-string-msec returns character
      353   :
      354     define variable v-date as datetime  no-undo .
      355     v-date = now.
      356     return string(v-date) .
      357   end.
      358   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure gen-key-rec :
      360     define input  parameter p-tbl-name    as character no-undo.
      361     define input  parameter p-bh_tbl-name as handle    no-undo.
      362     define output parameter p-key-rec     as character no-undo.
      363     do
      364     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      365     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      366     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      367     :
      368       define variable fh               as handle    no-undo .
      369       define variable v-ok             as logical   no-undo .
      370       define variable v-inform         as character no-undo .
      371       define variable v-ind            as integer   no-undo .
      372       define variable v-idx-field-qnty as integer   no-undo .
      373       if p-tbl-name = ?
      374         or p-tbl-name = "":U
      375       then do:
      376         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      377       end.
      378       if not p-bh_tbl-name:available then do:
      379         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      380       end.
      381       assign
      382         p-key-rec = p-tbl-name
      383         v-inform  = p-bh_tbl-name:index-information(1)
      384         v-ind     = 2
      385       .
      386       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      387       on error undo, return error
      388       :
      389         assign
      390           v-inform = p-bh_tbl-name:index-information( v-ind )
      391           v-ind    = v-ind + 1
      392         .
      393       end.
      394       if v-inform = ?
      395         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      396         or entry( 3, v-inform, ",":U ) <> "1":U
      397       then do:
      398         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      399       end.
      400       else do:
      401         assign
      402           v-idx-field-qnty = num-entries( v-inform ) - 4
      403         .
      404         if v-idx-field-qnty < 2 then do:
      405           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      406         end.
      407         do v-ind = 1 to v-idx-field-qnty by 2
      408         on error undo, return error
      409         :
      410           assign
      411             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      412             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      413           .
      414         end.
      415       end.
      416       if p-key-rec = ? then do:
      417         assign
      418           p-key-rec = "":U
      419         .
      420         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      421       end.
      422     end.
      423     return.
      424   end procedure.
      425   procedure gen-where-keyr-tab :
      426     define input  parameter i-tableSerach as character no-undo.
      427     define input  parameter i-tablekey   as character  no-undo.
      428     define input  parameter p-key-rec    as character  no-undo.
      429     define input  parameter p-key-handle as handle     no-undo .
      430     define input  parameter p-db-name    as character  no-undo .
      431     define input  parameter p-tt-handle  as handle     no-undo .
      432     define output parameter o-Where      as character  no-undo.
      433     do
      434     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      435     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      436     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      437     :
      438       define variable v-full-tbl-name  as character no-undo .
      439       define variable bh_tbl-name      as handle    no-undo .
      440       define variable fh_key           as handle    no-undo .
      441       define variable fh_search        as handle    no-undo .
      442       define variable v-field-num      as integer   no-undo .
      443       define variable v-count-fld      as integer   no-undo .
      444       define variable v-inform         as character no-undo .
      445       define variable v-ind            as integer   no-undo .
      446       define variable v-idx-field-qnty as integer   no-undo .
      447       define variable v-field-name     as character no-undo .
      448       define variable v-field-val      as character no-undo .
      449       define variable v-word-link      as character no-undo .
      450       define variable vTable           as character no-undo.
      451       define variable bh_tbl-key       as handle    no-undo .
      452       assign
      453         p-key-rec = trim( p-key-rec )
      454       .
      455       if p-key-handle <> ? then do:
      456         if not valid-handle(p-key-handle)
      457            or p-key-handle:type <> "buffer"
      458         then do:
      459           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      460         end.
      461         if num-entries( p-key-rec, chr(3) ) > 1
      462           or p-key-rec = ?
      463           or p-key-rec = "":U
      464         then do:
      465           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      466         end.
      467       end.
      468       else do:
      469         if p-key-rec = ?
      470           or p-key-rec = "":U
      471         then do:
      472           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      473         end.
      474       end.
      475       assign
      476         vTable = entry( 1 , p-key-rec, chr(3) )
      477       .
      478       if p-tt-handle <> ?
      479         and ( not valid-handle(p-tt-handle)
      480               or p-tt-handle:type <> "buffer"
      481             )
      482       then do:
      483         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      484       end.
      485       if p-tt-handle = ? then do:
      486         assign
      487           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      488         .
      489         create buffer bh_tbl-name for table v-full-tbl-name .
      490       end.
      491       else do:
      492         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      493       end.
      494       assign
      495         v-inform = bh_tbl-name:index-information(1)
      496         v-ind    = 2
      497       .
      498       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      499       on error undo, return error
      500       :
      501         assign
      502           v-inform = bh_tbl-name:index-information( v-ind )
      503           v-ind    = v-ind + 1
      504         .
      505       end.
      506       if v-inform = ?
      507         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      508         or entry( 3, v-inform, ",":U ) <> "1":U
      509       then do:
      510         delete object bh_tbl-name no-error.
      511         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      512       end.
      513       assign
      514         v-idx-field-qnty = num-entries( v-inform ) - 4
      515       .
      516       if v-idx-field-qnty < 2 then do:
      517         delete object bh_tbl-name no-error.
      518         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      519       end.
      520       assign
      521         o-where     = "where":U
      522         v-word-link = "":U
      523         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      524         v-count-fld = 0
      525       .
      526       if i-tablekey ne "" and i-tablekey ne ?
      527       then do:
      528         assign
      529           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      530         .
      531         create buffer bh_tbl-key for table v-full-tbl-name .
      532       end.
      533       if i-tableSerach ne "" and i-tableSerach ne ?
      534       then do:
      535         delete object bh_tbl-name no-error.
      536         assign
      537           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      538         .
      539         create buffer bh_tbl-name for table v-full-tbl-name .
      540       end.
      541       block_where:
      542       do v-ind = 1 to v-idx-field-qnty by 2
      543       on error undo, return error
      544       :
      545         assign
      546           v-count-fld = v-count-fld + 1
      547         .
      548         if p-key-handle = ?
      549           and v-count-fld > v-field-num
      550         then do:
      551           leave block_where.
      552         end.
      553         define variable VfieldKeyTable as handle no-undo.
      554         assign
      555           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      556           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      557         .
      558         if     bh_tbl-key ne ?
      559         then do:
      560            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      561            if VfieldKeyTable eq ?
      562            then next block_where.
      563         end.
      564         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      565         then
      566            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      567         else
      568            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      569         if p-key-handle = ? then do:
      570           assign
      571             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      572           .
      573         end.
      574         else do:
      575           assign
      576             fh_key = p-key-handle:buffer-field( v-field-name )
      577           .
      578           if fh_key = ?
      579             or not valid-handle( fh_key )
      580           then do:
      581             delete object bh_tbl-name.
      582             if     bh_tbl-key ne ?
      583             then
      584                delete object bh_tbl-key.
      585             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      586           end.
      587           assign
      588             v-field-val = fh_key:buffer-value
      589           .
      590         end.
      591         if fh_search:data-type ="character":U then do:
      592           assign
      593             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      594             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      595             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      596             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      597             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      598             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      599             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      600             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      601             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      602             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      603             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      604             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      605             v-field-val = substitute( '"&1"', v-field-val )
      606           .
      607         end.
      608         assign
      609           o-where = substitute( "&1 &2", o-where, v-field-val )
      610         .
      611         if v-word-link = "":U then do:
      612           assign
      613             v-word-link = "and":U
      614           .
      615         end.
      616       end.
      617       delete object bh_tbl-name.
      618       if     bh_tbl-key ne ?
      619       then
      620          delete object bh_tbl-key.
      621       if p-key-handle = ?
      622         and v-count-fld <> v-field-num
      623       then do:
      624         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      625       end.
      626     end.
      627   end procedure.
      628   procedure gen-hn-keyr-tab :
      629     define input  parameter i-tableSerach as character no-undo.
      630     define input  parameter i-tablekey   as character no-undo.
      631     define input  parameter p-key-rec    as character no-undo.
      632     define input  parameter p-key-handle as handle    no-undo .
      633     define input  parameter p-db-name    as character no-undo .
      634     define input  parameter p-tt-handle  as handle    no-undo .
      635     define input  parameter p-stts-lock  as integer   no-undo .
      636     define output parameter o-hn         as handle    no-undo.
      637     define variable v-full-tbl-name as character no-undo.
      638     define variable v-where         as character no-undo.
      639     define variable bh_tbl-name     as handle    no-undo.
      640     define variable vTable          as character no-undo.
      641     do
      642     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      643     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      644     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      645         run gen-where-keyr-tab(i-tableSerach,
      646                                i-tablekey,
      647                                p-key-rec,
      648                                p-key-handle,
      649                                p-db-name,
      650                                p-tt-handle,
      651                                output v-where).
      652         if i-tableSerach ne "" and i-tableSerach ne ?
      653         then do:
      654            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      655            create buffer bh_tbl-name for table v-full-tbl-name .
      656         end.
      657         else do:
      658            if p-tt-handle = ? then do:
      659               assign
      660                  vTable = entry( 1 , p-key-rec, chr(3) )
      661               .
      662               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      663               create buffer bh_tbl-name for table v-full-tbl-name .
      664            end.
      665            else do:
      666               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      667            end.
      668         end.
      669         if p-tt-handle = ? then do:
      670            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      671         end.
      672         else do:
      673            bh_tbl-name:find-first( v-where ) no-error .
      674         end.
      675         o-hn = bh_tbl-name.
      676      end.
      677   end procedure.
      678   procedure gen-hn-keyr :
      679     define input  parameter p-key-rec    as character no-undo.
      680     define input  parameter p-key-handle as handle    no-undo .
      681     define input  parameter p-db-name    as character no-undo .
      682     define input  parameter p-tt-handle  as handle    no-undo .
      683     define input  parameter p-stts-lock  as integer   no-undo .
      684     define output parameter o-hn         as handle    no-undo.
      685     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      686   end.
      687   procedure gen-row-keyr :
      688     define input  parameter p-key-rec    as character no-undo.
      689     define input  parameter p-key-handle as handle    no-undo .
      690     define input  parameter p-db-name    as character no-undo .
      691     define input  parameter p-tt-handle  as handle    no-undo .
      692     define input  parameter p-stts-lock  as integer   no-undo .
      693     define output parameter p-tbl-row    as rowid     no-undo.
      694     define output parameter p-tbl-name   as character no-undo.
      695     define variable vHn as handle no-undo.
      696       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      697       p-tbl-row = if vHn:available then vHn:rowid else ?.
      698       p-tbl-name =  vHn:table.
      699       delete object vHn no-error.
      700     if p-tbl-row = ? then do:
      701       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      702     end.
      703     else do:
      704       return.
      705     end.
      706   end procedure.
      707   procedure gen-key-fv :
      708     define input  parameter p-key-rec    as character no-undo .
      709     define output parameter p-field-list as character no-undo .
      710     define output parameter p-value-list as character no-undo.
      711     do
      712     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      713     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      714     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      715     :
      716       define variable v-full-tbl-name  as character no-undo .
      717       define variable bh_tbl-name      as handle    no-undo .
      718       define variable v-tbl-name       as character no-undo .
      719       define variable v-field-num      as integer   no-undo .
      720       define variable v-count-fld      as integer   no-undo .
      721       define variable v-inform         as character no-undo .
      722       define variable v-ind            as integer   no-undo .
      723       define variable v-idx-field-qnty as integer   no-undo .
      724       define variable v-delim-key      as character no-undo .
      725       if p-key-rec = ?
      726         or p-key-rec = "":U
      727       then do:
      728         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      729       end.
      730       assign
      731         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      732         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      733       .
      734       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      735       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      736       assign
      737         v-inform = bh_tbl-name:index-information(1)
      738         v-ind    = 2
      739       .
      740       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      741       on error undo, return error
      742       :
      743         assign
      744           v-inform = bh_tbl-name:index-information( v-ind )
      745           v-ind    = v-ind + 1
      746         .
      747       end.
      748       if v-inform = ?
      749         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      750         or entry( 3, v-inform, ",":U ) <> "1":U
      751       then do:
      752         delete object bh_tbl-name no-error.
      753         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      754       end.
      755       assign
      756         v-idx-field-qnty = num-entries( v-inform ) - 4
      757       .
      758       if v-idx-field-qnty < 2 then do:
      759         delete object bh_tbl-name no-error.
      760         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      761       end.
      762       assign
      763         p-field-list = "":U
      764         p-value-list = "":U
      765         v-delim-key  = "":U
      766         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      767         v-count-fld  = 0
      768       .
      769       block_where:
      770       do v-ind = 1 to v-idx-field-qnty by 2
      771       on error undo, return error
      772       :
      773         assign
      774           v-count-fld = v-count-fld + 1
      775         .
      776         if v-count-fld > v-field-num then do:
      777           leave block_where.
      778         end.
      779         assign
      780           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      781           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      782         .
      783         if v-ind = 1 then do:
      784           assign
      785             v-delim-key = chr(3)
      786           .
      787         end.
      788       end.
      789       delete object bh_tbl-name.
      790       if v-count-fld <> v-field-num then do:
      791         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      792       end.
      793     end.
      794   end procedure.
      795   procedure gen-key-field :
      796     define input  parameter p-table      as character no-undo .
      797     define output parameter p-field-list as character no-undo .
      798     do
      799     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      800     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      801     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      802     :
      803       define variable v-full-tbl-name  as character no-undo .
      804       define variable bh_tbl-name      as handle    no-undo .
      805       define variable v-tbl-name       as character no-undo .
      806       define variable v-field-num      as integer   no-undo .
      807       define variable v-count-fld      as integer   no-undo .
      808       define variable v-inform         as character no-undo .
      809       define variable v-ind            as integer   no-undo .
      810       define variable v-idx-field-qnty as integer   no-undo .
      811       define variable v-delim-key      as character no-undo .
      812       if p-table = ?
      813         or p-table = "":U
      814       then do:
      815         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      816       end.
      817       assign
      818         v-tbl-name      = p-table
      819         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      820       .
      821       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      822       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      823       assign
      824         v-inform = bh_tbl-name:index-information(1)
      825         v-ind    = 2
      826       .
      827       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      828       on error undo, return error
      829       :
      830         assign
      831           v-inform = bh_tbl-name:index-information( v-ind )
      832           v-ind    = v-ind + 1
      833         .
      834       end.
      835       if v-inform = ?
      836         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      837         or entry( 3, v-inform, ",":U ) <> "1":U
      838       then do:
      839         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      840       end.
      841       assign
      842         v-idx-field-qnty = num-entries( v-inform ) - 4
      843       .
      844       if v-idx-field-qnty < 2 then do:
      845         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      846       end.
      847       assign
      848         p-field-list = "":U
      849         v-delim-key  = "":U
      850         v-count-fld  = 0
      851       .
      852       block_where:
      853       do v-ind = 1 to v-idx-field-qnty by 2
      854       on error undo, return error
      855       :
      856         assign
      857           v-count-fld = v-count-fld + 1
      858         .
      859         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      860         if v-ind = 1 then do:
      861           assign
      862             v-delim-key = chr(3)
      863           .
      864         end.
      865       end.
      866       delete object bh_tbl-name.
      867     end.
      868   end procedure.
      869   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   def
      871   new shared
      872   temp-table  obj-list no-undo
      873     field obj-type like ub.clients.obj-type
      874     field obj-code like ub.clients.obj-code
      875     field obj-name like ub.clients.obj-name
      876     field obj-id   as integer
      877     field db-num   as integer
      878     index pi is primary unique obj-id
      879     index ie1 obj-type obj-code
      880     index ie2 obj-name
      881   .
      882   procedure create_obj-list :
      883      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      884      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      885      do
      886      on error undo, return error return-value
      887      :
      888         define buffer cli-obj for ub.clients .
      889         define variable p-var as integer no-undo .
      890         define buffer buf_obj-list for obj-list .
      891         find last buf_obj-list  use-index pi no-error .
      892         if available buf_obj-list
      893         then
      894            p-var = buf_obj-list.obj-id + 1.
      895         else
      896            p-var = 1.
      897         find first cli-obj where
      898                   cli-obj.obj-type = p-obj-type
      899               and cli-obj.obj-code = p-obj-code
      900         no-lock no-error.
      901         if available cli-obj
      902         then do:
      903            create buf_obj-list.
      904            assign
      905               buf_obj-list.obj-id   = p-var
      906               buf_obj-list.obj-code = cli-obj.obj-code
      907               buf_obj-list.obj-type = cli-obj.obj-type
      908               buf_obj-list.obj-name = cli-obj.obj-name
      909               buf_obj-list.db-num   = cli-obj.db-num
      910            .
      911         end.
      912      end.
      913   end.
      914     run create_obj-list(p-obj-type,p-obj-code).
      915   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   procedure factord :
      918     define input  parameter p-fact-date            as date    no-undo .
      919     define input  parameter p-fact-time            as integer no-undo .
      920     define input  parameter p-fact-num             as integer no-undo .
      921     define input  parameter p-shift-date           as date    no-undo .
      922     define input  parameter p-shift-num            as integer no-undo .
      923     define input  parameter p-shift-on             as logical no-undo .
      924     define output parameter p-fact-order           as decimal no-undo .
      925     define output parameter p-shift-end-fact-order as decimal no-undo .
      926     define output parameter p-day-end-fact-order   as decimal no-undo .
      927     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      928     if p-fact-date = ?
      929     then do:
      930       return error "Не указана фактическая дата" .
      931     end.
      932     define variable v-fact-date-num as integer no-undo .
      933     assign
      934       v-fact-date-num = integer(p-fact-date)
      935     .
      936     if p-fact-num = ?
      937     or p-fact-num = 0
      938     then do:
      939       return error "Не задан p-fact-num " + string(p-fact-num) .
      940     end.
      941     if p-fact-num < 0
      942     then do:
      943       return error "Отрицательный fact-num " + string(p-fact-num) .
      944     end.
      945     if p-fact-num >= 100000000
      946     then do:
      947       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      948     end.
      949     if p-shift-on = true
      950     then do:
      951       if p-shift-date = ?
      952       then do:
      953         return error "Не задана дата смены" .
      954       end.
      955       if p-shift-num = ?
      956       or p-shift-num = 0
      957       then do:
      958         return error "Не задан номер смены" .
      959       end.
      960     end.
      961     else do:
      962       assign
      963         p-shift-date = p-fact-date
      964         p-shift-num  = 24
      965       .
      966     end.
      967     define variable v-shift-offset as integer no-undo .
      968     if p-shift-date = p-fact-date
      969     then do:
      970       assign
      971         v-shift-offset = 1
      972       .
      973     end.
      974     if p-shift-date < p-fact-date
      975     then do:
      976       assign
      977         v-shift-offset = 0
      978       .
      979     end.
      980     if p-shift-date > p-fact-date
      981     then do:
      982       message
      983         vss-workfile vss-revision vss-description skip
      984         "Неправильная дата закрытия смены" skip
      985         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      986         view-as alert-box error .
      987       undo, return error
      988         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      989           ,string(p-fact-date, '99/99/9999':U)
      990           ,string(p-shift-date, '99/99/9999':U)
      991           )
      992       .
      993     end.
      994     if p-shift-num < 1
      995     or p-shift-num > 24
      996     then do:
      997       message
      998         vss-workfile vss-revision vss-description skip
      999         "Неправильный номер смены" skip
     1000         "p-shift-num" p-shift-num skip
     1001         view-as alert-box error .
     1002       undo, return error return-value .
     1003     end.
     1004     assign
     1005       p-fact-order           = v-fact-date-num
     1006                              + v-shift-offset * 0.5
     1007                              + p-shift-num    * 0.02 - 0.01
     1008                              + p-fact-num     * 0.0000000001
     1009       p-shift-end-fact-order = v-fact-date-num
     1010                              + v-shift-offset * 0.5
     1011                              + p-shift-num    * 0.02
     1012       p-day-end-fact-order   = v-fact-date-num
     1013                              + 0.99
     1014     .
     1015     if p-fact-order           <= v-fact-date-num
     1016     or p-shift-end-fact-order <= v-fact-date-num
     1017     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1018     or p-shift-end-fact-order >= p-day-end-fact-order
     1019     then do:
     1020       message
     1021         vss-workfile vss-revision vss-description skip
     1022         "Внутренняя ошибка при генерации фактического номера" skip
     1023         "p-fact-date"            p-fact-date            skip
     1024         "p-fact-time"            p-fact-time            skip
     1025         "p-fact-num"             p-fact-num             skip
     1026         "p-shift-date"           p-shift-date           skip
     1027         "p-shift-num"            p-shift-num            skip
     1028         "p-shift-on"             p-shift-on             skip
     1029         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1030         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1031         "v-fact-date-num"        v-fact-date-num        skip
     1032         view-as alert-box error .
     1033       undo, return error return-value .
     1034     end.
     1035   end procedure.
     1036   procedure day-begin-fact-order :
     1037     define input  parameter p-fact-date            as date    no-undo .
     1038     define output parameter p-day-begin-fact-order as decimal no-undo .
     1039     do
     1040     on error undo, return error return-value
     1041     :
     1042       if p-fact-date = ?
     1043       then do:
     1044         assign
     1045           p-day-begin-fact-order = 0
     1046         .
     1047       end.
     1048       else do:
     1049         assign
     1050           p-day-begin-fact-order = integer(p-fact-date)
     1051         .
     1052       end.
     1053     end.
     1054   end procedure.
     1055   procedure factord-max-fact-order :
     1056     define output parameter p-max-fact-order as decimal   no-undo .
     1057     do
     1058     on error undo, return error return-value
     1059     :
     1060       run day-begin-fact-order in this-procedure
     1061         (input  date(1, 1, 5000)
     1062         ,output p-max-fact-order
     1063         ) .
     1064     end.
     1065   end procedure.
     1066   procedure factord-cut-archive :
     1067     define input  parameter p-obj-type             as character no-undo .
     1068     define input  parameter p-obj-code             as integer   no-undo .
     1069     define input  parameter p-fact-date            as date      no-undo .
     1070     define output parameter p-shift-on             as logical   no-undo .
     1071     define output parameter p-shift-date           as date      no-undo .
     1072     define output parameter p-shift-num            as integer   no-undo .
     1073     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1074     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1075     define variable v-fact-order as decimal   no-undo .
     1076     define buffer buf_shift-obj for ub.shift-obj .
     1077     do
     1078     on error undo, return error return-value
     1079     :
     1080   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1082     (input  p-obj-type
     1083     ,input  p-obj-code
     1084     ,input  'shift-on=request'
     1085     ,output p-shift-on
     1086     ) no-error .
     1087       if error-status :error
     1088       then do:
     1089         message
     1090           vss-workfile vss-revision vss-description skip
     1091           "Ошибка при определении атрибута объекта" skip
     1092           "Объект" p-obj-type p-obj-code skip
     1093           error-status :get-message(1) skip
     1094           return-value skip
     1095           view-as alert-box error .
     1096         undo, return error return-value .
     1097       end.
     1098       if p-shift-on = false
     1099       then do:
     1100         assign
     1101           p-shift-date               = ?
     1102           p-shift-num                = 0
     1103         .
     1104       end.
     1105       else do:
     1106         find first buf_shift-obj share-lock
     1107           where buf_shift-obj.obj-type   = p-obj-type
     1108             and buf_shift-obj.obj-code   = p-obj-code
     1109             and buf_shift-obj.shift-date > p-fact-date
     1110           use-index pi
     1111           no-error .
     1112         if not available buf_shift-obj
     1113         or buf_shift-obj.status_ <> 'зкр':U
     1114         then do:
     1115           message
     1116             vss-workfile vss-revision vss-description skip
     1117             "Невозможно вычислить последнюю смену" skip
     1118             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1119             "Объект" p-obj-type p-obj-code skip
     1120             "Дата" p-fact-date skip
     1121             view-as alert-box error .
     1122           undo, return error return-value .
     1123         end.
     1124         find last buf_shift-obj share-lock
     1125           where buf_shift-obj.obj-type = p-obj-type
     1126             and buf_shift-obj.obj-code = p-obj-code
     1127             and buf_shift-obj.shift-date <= p-fact-date
     1128           use-index pi
     1129           no-error .
     1130         if available buf_shift-obj
     1131         then do:
     1132           if  buf_shift-obj.status_ = 'зкр':U
     1133           then do:
     1134             assign
     1135               p-shift-date = buf_shift-obj.shift-date
     1136               p-shift-num  = buf_shift-obj.shift-num
     1137             .
     1138           end.
     1139           else do:
     1140             message
     1141               vss-workfile vss-revision vss-description skip
     1142               "Невозможно вычислить последнюю смену" skip
     1143               "Статус смены отличен от статуса" 'зкр':U skip
     1144               "Объект" p-obj-type p-obj-code skip
     1145               "Дата" p-fact-date skip
     1146               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1147               view-as alert-box error .
     1148             undo, return error return-value .
     1149           end.
     1150         end.
     1151         else do:
     1152           assign
     1153             p-shift-date = p-fact-date - 1
     1154             p-shift-num  = 1
     1155           .
     1156         end.
     1157       end.
     1158       run factord in this-procedure
     1159         (input  p-fact-date
     1160         ,input  1
     1161         ,input  1
     1162         ,input  p-shift-date
     1163         ,input  p-shift-num
     1164         ,input  p-shift-on
     1165         ,output v-fact-order
     1166         ,output p-shift-end-fact-order
     1167         ,output p-day-end-fact-order
     1168         ) no-error .
     1169       if error-status :error
     1170       then do:
     1171         message
     1172           vss-workfile vss-revision vss-description skip
     1173           "Ошибка при вызове процедуры factord"
     1174           error-status :get-message(1) skip
     1175           return-value skip
     1176           view-as alert-box error .
     1177         undo, return error return-value .
     1178       end.
     1179     end.
     1180   end procedure.
     1181   procedure factord-lock-shift :
     1182     define input  parameter p-obj-type  as character no-undo .
     1183     define input  parameter p-obj-code  as integer   no-undo .
     1184     define input  parameter p-fact-date as date      no-undo .
     1185     define parameter buffer buf_shift-obj for ub.shift-obj .
     1186     define variable v-shift-on      as logical   no-undo .
     1187     define variable v-extra-message as character no-undo .
     1188     define variable v-error as character no-undo .
     1189     do
     1190     on error undo, return error return-value
     1191     :
     1192   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1194     (input  p-obj-type
     1195     ,input  p-obj-code
     1196     ,input  'shift-on=request'
     1197     ,output v-shift-on
     1198     ) no-error .
     1199       if error-status :error
     1200       then do:
     1201         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1202         undo, return error v-error .
     1203       end.
     1204       if v-shift-on = true
     1205       then do:
     1206         find first buf_shift-obj share-lock
     1207           where buf_shift-obj.obj-type   = p-obj-type
     1208             and buf_shift-obj.obj-code   = p-obj-code
     1209             and buf_shift-obj.shift-date > p-fact-date
     1210           use-index pi
     1211           no-error .
     1212         if not available buf_shift-obj
     1213         or buf_shift-obj.status_ <> 'зкр':U
     1214         then do:
     1215           find last buf_shift-obj
     1216             where buf_shift-obj.obj-type = p-obj-type
     1217               and buf_shift-obj.obj-code = p-obj-code
     1218               and buf_shift-obj.status_  = 'зкр':U
     1219             use-index stts
     1220             no-error .
     1221           if available buf_shift-obj
     1222           then do:
     1223             assign
     1224               v-extra-message =
     1225                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1226                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1227                               )
     1228             .
     1229           end.
     1230           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1231           undo, return error v-error .
     1232         end.
     1233       end.
     1234     end.
     1235   end procedure.
     1236   procedure factord-end-day :
     1237     define input  parameter p-fact-date            as date    no-undo .
     1238     define output parameter p-day-end-fact-order   as decimal no-undo .
     1239     do
     1240     on error undo, return error return-value
     1241     :
     1242       if p-fact-date = ?
     1243       then do:
     1244         return error "Не указана фактическая дата" .
     1245       end.
     1246       assign
     1247         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1248       .
     1249     end.
     1250   end procedure.
     1251   procedure factord-to-date :
     1252     define input  parameter p-fact-order as decimal no-undo .
     1253     define output parameter p-fact-date  as date    no-undo .
     1254     define variable v-ref-date  as date      no-undo .
     1255     define variable v-ref-delta as integer   no-undo .
     1256     do
     1257     on error undo, return error return-value
     1258     :
     1259       if p-fact-order = ?
     1260       or p-fact-order = 0
     1261       then do:
     1262         return error "Не указан fact-order" .
     1263       end.
     1264       assign
     1265         v-ref-date  = date(1, 1, 2000)
     1266       .
     1267       assign
     1268         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1269       .
     1270       assign
     1271         p-fact-date = v-ref-date + v-ref-delta
     1272       .
     1273     end.
     1274   end procedure.
     1275   procedure factord-to-fact-num :
     1276     define input  parameter p-fact-order as decimal no-undo .
     1277     define output parameter p-fact-num   as integer no-undo .
     1278     define variable v-fact-order-trunc as decimal no-undo .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282       if p-fact-order = ?
     1283       or p-fact-order = 0
     1284       then do:
     1285         return error "Не указан fact-order" .
     1286       end.
     1287       assign
     1288        v-fact-order-trunc = truncate(p-fact-order, 2)
     1289       .
     1290       assign
     1291         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1292       .
     1293     end.
     1294   end procedure.
     1295   procedure factord-to-shift-num :
     1296     define input  parameter p-fact-order as decimal no-undo .
     1297     define output parameter p-shift-num   as integer no-undo .
     1298     define variable  p-shift-numd  as decimal   no-undo .
     1299     define variable v-fact-order-trunc as decimal no-undo .
     1300     do
     1301     on error undo, return error return-value
     1302     :
     1303       if p-fact-order = ?
     1304       or p-fact-order = 0
     1305       then do:
     1306         return error "Не указан fact-order" .
     1307       end.
     1308       assign
     1309        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1310       .
     1311       if v-fact-order-trunc < 0.5 then do:
     1312         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1313       end.
     1314       assign
     1315         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1316         .
     1317        assign
     1318         p-shift-num = truncate (p-shift-numd , 0)
     1319       .
     1320     end.
     1321   end procedure.
     1322   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   PROCEDURE fostatok :
     1324   define input parameter p-host-code   as integer no-undo .
     1325   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1326   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1327   define input parameter x-tog-shift   as   logical             no-undo.
     1328   define input parameter x-date-start  as date        no-undo.
     1329   define input parameter x-date-end    as date        no-undo.
     1330   define input parameter x-shift-start as integer     no-undo.
     1331   define input parameter x-shift-end   as integer     no-undo.
     1332   define input parameter xTog-obj   as logical no-undo.
     1333   define input parameter p-curr-code as integer no-undo .
     1334   define input parameter p-cashbookid as integer  no-undo .
     1335   define output parameter sum       as decimal   no-undo.
     1336   define output parameter Fact-order  as decimal  no-undo.
     1337   define variable Fact-order#   as decimal  no-undo.
     1338   define variable Fact-orderS   as character  no-undo.
     1339   define variable x-date-start-t  as date   no-undo.
     1340   define variable x-sum-type as character no-undo .
     1341       if x-tog-shift then do:
     1342         assign
     1343         x-sum-type = 'shift-obj':U.
     1344       end.
     1345       else do:
     1346         x-sum-type = 'obj':U.
     1347       end.
     1348   Assign
     1349   Fact-order   = 0
     1350   sum     = 0
     1351   x-date-start-t  = x-date-start + 1 .
     1352   IF x-date-end = date('') then DO:
     1353     Fact-order = 0 .
     1354     For each obj-list no-lock
     1355         WHERE  (NOT xTog-obj OR
     1356                 (x-store-type = obj-list.obj-type
     1357                 AND
     1358                 x-store-code = obj-list.obj-code))
     1359     :
     1360      fact-order# = 0.
     1361      IF  x-TOG-Shift = False Then DO:
     1362         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1363             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     1364             USE-INDEX fact-date  no-error .
     1365        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1366          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1367        end.
     1368      End.
     1369      Else  DO :
     1370         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1371              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     1372               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     1373               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     1374               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     1375               USE-INDEX Shift-num no-error .
     1376         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1377           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1378         end.
     1379       END.
     1380       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1381     End.
     1382   End.
     1383   Else DO:
     1384     For each obj-list  no-lock WHERE
     1385        (NOT xTog-obj
     1386         OR
     1387         (x-store-type = obj-list.obj-type
     1388         AND
     1389         x-store-code = obj-list.obj-code))
     1390      :
     1391      IF  x-TOG-Shift = False Then DO:
     1392         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1393               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     1394               and arh-fin-doc-schet-nal-obj.shift-num = 0
     1395               USE-INDEX fact-date no-error.
     1396        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1397          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1398        end.
     1399      END.
     1400      Else DO:
     1401         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1402               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     1403               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     1404               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     1405               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     1406         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1407           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1408         end.
     1409       End.
     1410       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1411     End.
     1412   End.
     1413   END PROCEDURE.
     1414   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     1417       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     1418       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     1419       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     1420       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     1421       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1422       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     1423       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
