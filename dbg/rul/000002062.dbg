     5528           tt0-fin-doc-tax.sum-line-rubl     = tt0-fin-doc-tax.sum-line-rubl + temp-autotank.sum-return
     5529           tt0-fin-doc-tax.sum-vat-line-rubl = tt0-fin-doc-tax.sum-vat-line-rubl +
     5530                                        round(temp-autotank.sum-return * tt0-fin-doc-tax.VAT-pc / (100 + tt0-fin-doc-tax.VAT-pc),2)
     5531           tt0-fin-doc-tax.sum-line-base     = tt0-fin-doc-tax.sum-line-base  + temp-autotank.sum-return
     5532           tt0-fin-doc-tax.sum-vat-line-base = tt0-fin-doc-tax.sum-vat-line-base  +
     5533                                        round(temp-autotank.sum-return * tt0-fin-doc-tax.VAT-pc / (100 + tt0-fin-doc-tax.VAT-pc),2)
     5534           .
