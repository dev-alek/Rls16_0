     5473       where buf_temp-tax.curr-code        = buf_temp-fin-sum.curr-code
     5474       and buf_temp-tax.cash-desk         = buf_temp-fin-sum.cash-desk
     5475       and buf_temp-tax.is-petrol        = buf_temp-fin-sum.is-petrol
     5476       and buf_temp-tax.cashbookId       = buf_temp-fin-sum.cashbookId
     5477       and buf_temp-tax.is-expense_cash  = buf_temp-fin-sum.is-expense_cash
     5478       and buf_temp-tax.num-expense_cash = buf_temp-fin-sum.num-expense_cash
     5479       and buf_temp-tax.pay-type = buf_temp-fin-sum.pay-type
     5480       :
     5481       v-line-num = v-line-num + 1.
     5482       create tt0-fin-doc-tax .
