     5509           tt0-fin-doc-tax.sum-line-rubl     = abs(buf_temp-tax.sum-rubl)
     5510           tt0-fin-doc-tax.sum-vat-line-rubl = abs(buf_temp-tax.vat-rubl)
     5511           tt0-fin-doc-tax.sum-line-base     = abs(buf_temp-tax.sum-base)
     5512           tt0-fin-doc-tax.sum-vat-line-base = abs(buf_temp-tax.vat-base)
     5513           .
