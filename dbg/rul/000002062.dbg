     3959             if not (tt-cashbookAttr.vneCli <> "" and tt-cashbookAttr.vneCorr <> "") then mValueVne = "" .
     3960             if not (tt-cashbookAttr.avansCli <> "" and tt-cashbookAttr.avansCorr <> "") then mValueAvans = "" .
