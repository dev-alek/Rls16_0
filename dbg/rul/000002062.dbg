     2829     define temp-table temp-autotank no-undo
     2830       field curr-code  as integer
     2831       field pay-desk   as integer
     2832       field sum-return as decimal
     2833       field is-petrol  as logical
     2834       field vat-pc     as decimal
     2835       field slt-pc     as decimal
     2836       index idx curr-code pay-desk is-petrol vat-pc slt-pc .
     2837   procedure proc-main :
     2838     define variable v-count         as integer   no-undo .
     2839     define variable v-tot-r-b-chk   as decimal   no-undo .
     2840     define variable v-tot-r-b-inkas as decimal   no-undo .
     2841     define variable v-real-obj-type as character no-undo .
     2842     define variable v-real-obj-code as integer   no-undo .
     2843     define variable v-host-code     as integer   no-undo .
     2844     define variable v-host-name     as character no-undo .
     2845     define variable v-base-code     as integer   no-undo .
     2846     define variable v-param-type    as character no-undo .
     2847     define variable v-naznach-plat  as character no-undo .
     2848     define variable v-naznach-plat2 as character no-undo .
     2849     define variable cash-book       as integer   no-undo .
     2850     define variable v-value         as character no-undo .
     2851     define variable v-cashier       as character no-undo .
     2852     define variable v-limit-access  as integer   no-undo .
     2853     define variable v-obj-db-num    as integer   no-undo .
     2854     define variable v-vat-pc        as integer   no-undo .
     2855     define variable v-slt-pc        as integer   no-undo .
     2856     define buffer buf_inkas                 for ub.inkas.
     2857     define buffer buf_inkas-pay-desk        for ub.inkas-pay-desk.
     2858     define buffer buf_cash-pay              for ub.cash-pay.
     2859     define buffer buf_temp-fin-sum          for temp-fin-sum.
     2860     define buffer buf_temp-fin-sum-Pko      for temp-fin-sum.
     2861     define buffer buf_temp-fin-sumVne       for temp-fin-sumVne.
     2862     define buffer buf_temp-fin-sumVne-Pko   for temp-fin-sumVne.
     2863     define buffer buf_temp-fin-sumAvans     for temp-fin-sumAvans.
     2864     define buffer buf_temp-fin-sumAvans-Pko for temp-fin-sumAvans.
     2865     define buffer buf_chk-gds-pay           for ub.chk-gds-pay.
     2866     define buffer buf_chk-doc               for ub.chk-doc.
     2867     define buffer buf_chk-pay               for ub.chk-pay.
     2868     define buffer buf_chk-pay-attr          for ub.chk-pay-attr.
     2869     define buffer buf_temp-gds              for temp-gds.
     2870     define buffer buf_temp-gdsVne           for temp-gdsVne.
     2871     define buffer buf_temp-gdsAvans         for temp-gdsAvans.
     2872     define buffer buf_bar-code              for ub.bar-code.
     2873     define buffer buf_goods                 for ub.goods.
     2874     define buffer buf_sale-doc              for ub.sale-doc.
     2875     define buffer buf_trn-doc               for ub.trn-doc.
     2876     define buffer buf_doc-line              for ub.doc-line.
     2877     define buffer buf_gds-dtl               for ub.gds-dtl.
     2878     define buffer buf_temp-tax              for temp-tax.
     2879     define buffer buf_temp-taxVne           for temp-taxVne.
     2880     define buffer buf_temp-taxAvans         for temp-taxAvans.
     2881     define buffer buf_fin-doc               for ub.fin-doc.
     2882     define buffer buf_sysconf               for ub.sysconf.
     2883     define buffer buf_shift-staff           for ub.shift-staff.
     2884     define buffer buf_chk-gds               for ub.chk-gds.
     2885     mCashBook = new ibs.th.ref.cashbookstorage () .
     2886     _main:
     2887     do
     2888       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2889       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     2890       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     2891       :
     2892       define variable v-err as logical no-undo .
     2893   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     2895     (input  buf_shift-obj.obj-type
     2896     ,input  buf_shift-obj.obj-code
     2897     ,output v-host-code
     2898     ,output v-host-name
     2899     )  .
     2900   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2901   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2902     (input  buf_shift-obj.obj-type
     2903     ,input  buf_shift-obj.obj-code
     2904     ,output v-obj-db-num
     2905     )  .
     2906   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2908     (input  v-host-code
     2909     ,output v-base-code
     2910     )  .
     2911       find first buf_sysconf no-lock where
     2912         buf_sysconf.host-code = v-host-code.
     2913       for each ub.CashBook no-lock:
     2914         create tt-cashbookAttr .
     2915         assign
     2916           tt-cashbookAttr.cashbookid = ub.CashBook.id .
     2917         for first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     2918           ub.CashBookRule.Code = "Vnecli-code":
     2919           tt-cashbookAttr.vneCli = ub.CashBookRule.RuleValue .
     2920         end.
     2921         for first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     2922           ub.CashBookRule.Code = "corrPkoVne":
     2923           tt-cashbookAttr.vneCorr = ub.CashBookRule.RuleValue .
     2924         end.
     2925         for first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     2926           ub.CashBookRule.Code = "Avanscli-code":
     2927           tt-cashbookAttr.avansCli = ub.CashBookRule.RuleValue .
     2928         end.
     2929         for first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     2930           ub.CashBookRule.Code = "corrPkoAvans":
     2931           tt-cashbookAttr.avansCorr = ub.CashBookRule.RuleValue .
     2932         end.
     2933       end.
     2934       find first buf_shift-staff no-lock
     2935         where buf_shift-staff.obj-type   = buf_shift-obj.obj-type
     2936         and buf_shift-staff.obj-code   = buf_shift-obj.obj-code
     2937         and buf_shift-staff.shift-date = buf_shift-obj.shift-date
     2938         and buf_shift-staff.shift-num  = buf_shift-obj.shift-num
     2939         and buf_shift-staff.staff-role = yes no-error.
     2940       if not available buf_shift-staFF THEN
     2941       DO:
     2942         if buf_shift-obj.status_ = 'зкр':U then
     2943         do:
     2944           v-cashier = "адм".
     2945         end.
     2946         else
     2947         do:
     2948           run gbl/d-prompt.w (
     2949             'title=':u + "Менеджер смены неопределен. Введите ФИО кассира," + '\':u
     2950             + 'text1=':u + "от имени которого будем оформлять Ордер на выручку" + '\':u
     2951             + 'format=' + "X(40)" + '\':u
     2952             + 'type=' + 'C':U + '\':u
     2953             + 'fillin_row=3\':u
     2954             + 'fillin_col=4\':u
     2955             + 'fillin_width=41\':u
     2956             + 'fillin_height=1\':u
     2957             + 'max-chars=5\':u
     2958             + 'readonly=no\':u
     2959             , input-output v-value
     2960             ).
     2961           if return-value = 'false':u then
     2962           do:
     2963                   if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Нельзя создать ордер на выручку, если кассир не определен")).
     2964             undo, return error .
     2965           END.
     2966         end.
     2967         v-cashier = v-value.
     2968       end.
     2969       else
     2970       do:
     2971         v-cashier = buf_shift-staff.name.
     2972       end.
     2973       for each buf_chk-gds-pay no-lock
     2974         where buf_chk-gds-pay.obj-type   = buf_shift-obj.obj-type
     2975         and buf_chk-gds-pay.obj-code   = buf_shift-obj.obj-code
     2976         and buf_chk-gds-pay.shift-date = buf_shift-obj.shift-date
     2977         and buf_chk-gds-pay.shift-num  = buf_shift-obj.shift-num
     2978         and buf_chk-gds-pay.algo-num   = "1.8":
     2979         assign
     2980           v-tot-r-b-chk = v-tot-r-b-chk  + buf_chk-gds-pay.tot-r-b
     2981           .
     2982         if num-entries(buf_chk-gds-pay.line-type, chr(4)) > 1
     2983           and entry(2, buf_chk-gds-pay.line-type, chr(4)) = ""
     2984           then
     2985         do :
     2986           find first buf_chk-gds no-lock where buf_chk-gds.b-code = buf_chk-gds-pay.b-code
     2987             and buf_chk-gds.doc-code = buf_chk-gds-pay.doc-code
     2988             and buf_chk-gds.line-num = buf_chk-gds-pay.line-num
     2989             no-error .
     2990           if not available buf_chk-gds
     2991             then
     2992           do :
     2993             find first buf_chk-gds no-lock where buf_chk-gds.b-code = buf_chk-gds-pay.b-code
     2994               and buf_chk-gds.doc-code = buf_chk-gds-pay.doc-code .
     2995           end.
     2996           if num-entries(buf_chk-gds.line-type, chr(4)) > 1
     2997             then
     2998           do :
     2999             find first ub.chk-gds-pay exclusive-lock where rowid(ub.chk-gds-pay) = rowid(buf_chk-gds-pay) .
     3000             assign
     3001               entry(2, ub.chk-gds-pay.line-type, chr(4)) = entry(2, buf_chk-gds.line-type, chr(4))
     3002               .
     3003             release ub.chk-gds-pay .
     3004           end.
     3005         end.
     3006       end.
     3007       for each buf_inkas no-lock
     3008         where buf_inkas.obj-type   = buf_shift-obj.obj-type
     3009         and buf_inkas.obj-code   = buf_shift-obj.obj-code
     3010         and buf_inkas.status_    = 'факт':U
     3011         and buf_inkas.shift-date = buf_shift-obj.shift-date
     3012         and buf_inkas.shift-num  = buf_shift-obj.shift-num
     3013         :
     3014         assign
     3015           v-count         = v-count + 1
     3016           v-tot-r-b-inkas = v-tot-r-b-inkas  + buf_inkas.netto
     3017           .
     3018         for each buf_chk-doc no-lock
     3019           where buf_chk-doc.obj-type    = buf_inkas.obj-type
     3020           and buf_chk-doc.obj-code    = buf_inkas.obj-code
     3021           and buf_chk-doc.out-code    = buf_inkas.inkas-code
     3022           and (buf_chk-doc.chk-type    = integer('1':U)
     3023           or  buf_chk-doc.chk-type    = integer('6':U))
     3024           :
     3025           if not can-find (first temp-z-number
     3026             where temp-z-number.cash-desk = buf_chk-doc.pay-desk
     3027             and temp-z-number.z-number  = buf_chk-doc.z-number)
     3028             then
     3029           do:
     3030             create temp-z-number.
     3031             assign
     3032               temp-z-number.cash-desk = buf_chk-doc.pay-desk
     3033               temp-z-number.z-number  = buf_chk-doc.z-number
     3034               .
     3035           end.
     3036         end.
     3037       end.
     3038       if abs(v-tot-r-b-chk - v-tot-r-b-inkas) > 0.015 * v-count then
     3039       do:
     3040               if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("В БД нет ПОЛНОЙ информации по разбиению товарных сумм в чеках по типам кассовых платежей")).
     3041         undo _main, return error .
     3042       end.
     3043           if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Создание кассовых ордеров для выручки по смене № &1 от &2 (П. &3) &6&4&5"                                 , buf_shift-obj.shift-name                                 , buf_shift-obj.shift-date                                 , buf_shift-obj.shift-nuM                                    , buf_shift-obj.obj-type                                 , buf_shift-obj.obj-code                                 , chr(10)                                 )).
     3044       for each buf_inkas no-lock
     3045         where buf_inkas.obj-type   = buf_shift-obj.obj-type
     3046         and buf_inkas.obj-code   = buf_shift-obj.obj-code
     3047         and buf_inkas.status_    = 'факт':U
     3048         and buf_inkas.shift-date = buf_shift-obj.shift-date
     3049         and buf_inkas.shift-num  = buf_shift-obj.shift-num
     3050         on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3051         on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3052         on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3053         :
     3054         for each buf_inkas-pay-desk no-lock
     3055           where buf_inkas-pay-desk.inkas-code = buf_inkas.inkas-code
     3056           break
     3057           by buf_inkas-pay-desk.inkas-code
     3058           by buf_inkas-pay-desk.pay-code
     3059           by buf_inkas-pay-desk.curr-code
     3060           by buf_inkas-pay-desk.pay-desk
     3061           on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3062           on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     3063           on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     3064           :
     3065           find first buf_cash-pay no-lock
     3066             where buf_cash-pay.cdpay-code = buf_inkas-pay-desk.pay-code
     3067             and buf_cash-pay.curr-code = buf_inkas-pay-desk.curr-code no-error.
     3068           if not available buf_cash-pay then
     3069           do:
     3070           end.
     3071           if not (buf_cash-pay.is-cash
     3072             or buf_cash-pay.cdpay-code = 1) then
     3073           do:
     3074             next.
     3075           end.
     3076           if last-of(buf_inkas-pay-desk.pay-desk) then
     3077           do:
     3078   //создание финдоков
     3079             for each buf_chk-doc no-lock
     3080               where buf_chk-doc.obj-code = buf_inkas.obj-code
     3081               and buf_chk-doc.obj-type = buf_inkas.obj-type
     3082               and buf_chk-doc.out-code = buf_inkas-pay-desk.inkas-code
     3083               and buf_chk-doc.pay-desk = buf_inkas-pay-desk.pay-desk
     3084               :
     3085               for each buf_chk-gds-pay no-lock
     3086                 where buf_chk-gds-pay.out-code = buf_inkas-pay-desk.inkas-code
     3087                 and buf_chk-gds-pay.obj-code = buf_inkas.obj-code
     3088                 and buf_chk-gds-pay.pay-code = buf_inkas-pay-desk.pay-code
     3089                 and buf_chk-gds-pay.doc-code = buf_chk-doc.doc-code
     3090                 and buf_chk-gds-pay.algo-num = "1.8"
     3091                 :
     3092                 if buf_chk-gds-pay.curr-code <> buf_inkas-pay-desk.curr-code then next .
     3093                 run gds-attr-value in this-procedure (
     3094                   input buf_chk-gds-pay.gds-code
     3095                   ,input "cash-book-id"
     3096                   ,output mValue
     3097                   ,output mType) no-error.
     3098                 run gds-attr-value in this-procedure (
     3099                   input buf_chk-gds-pay.gds-code
     3100                   ,input 'item-matter-mark':U
     3101                   ,output mValueVne
     3102                   ,output mTypeVne) no-error.
     3103                 run gds-attr-value in this-procedure (
     3104                   input buf_chk-gds-pay.gds-code
     3105                   ,input 'type-method-calc':U
     3106                   ,output mValueAvans
     3107                   ,output mTypeAvans) no-error.
     3108                 if p-by-petrol-goods then
     3109                 do:
     3110                   run check-petrol in this-procedure (
     3111                     input buf_chk-gds-pay.b-code ,
     3112                     output is-petrolium
     3113                     ).
     3114                 end.
     3115                 define variable msum    as decimal no-undo.
     3116                 define variable msumVne as decimal no-undo.
     3117                 case buf_chk-gds-pay.curr-code:
     3118                   when 0 then
     3119                     do:
     3120                       assign
     3121                         msum = (if v-curr-r-b = 'rubl':U
     3122                                    then buf_chk-gds-pay.tot-r-b
     3123                                    else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate)
     3124                                                                             )
     3125                         .
     3126                     end.
     3127                   when v-base-code then
     3128                     do:
     3129                       assign
     3130                         msum = (if v-curr-r-b = 'base':U
     3131                                   then buf_chk-gds-pay.tot-r-b
     3132                                   else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate)
     3133                                                                             )
     3134                         .
     3135                     end.
     3136                 end case.
     3137                 find first ub.CashBook no-lock where ub.CashBook.id = int64(mValue) no-error .
     3138                 if not available ub.CashBook
     3139                   then
     3140                 do :
     3141                   find first ub.CashBook no-lock where ub.CashBook.id = 0 no-error .
     3142                 end.
     3143                 find first tt-cashbookAttr where tt-cashbookAttr.cashbookid = ub.CashBook.id no-error .
     3144                 if not (tt-cashbookAttr.vneCli <> "" and tt-cashbookAttr.vneCorr <> "") then mValueVne = "" .
     3145                 if not (tt-cashbookAttr.avansCli <> "" and tt-cashbookAttr.avansCorr <> "") then mValueAvans = "" .
     3146                 if available ub.CashBook
     3147                   then
     3148                 do :
     3149                   find first chk-gds-attr where ub.chk-gds-attr.doc-code = buf_chk-gds-pay.doc-code
     3150                     and ub.chk-gds-attr.line-num = buf_chk-gds-pay.line-num
     3151                     and ub.chk-gds-attr.attr-code = "cstype"
     3152                     no-lock no-error.
     3153                   p-by-cash-desk = ub.CashBook.FlagSepCash .
     3154                   p-by-petrol-goods = ub.CashBook.FlagSepFull .
     3155                   mTypePay          = if available chk-gds-attr and integer (chk-gds-attr.attr-value) eq 37 then 'Cash' else "".
     3156                   .
     3157                 end.
     3158                 if mValueVne = "15" then
     3159                 do:
     3160                   find first buf_temp-fin-sumVne
     3161                     where buf_temp-fin-sumVne.curr-code = buf_cash-pay.curr-code
     3162                     and (p-by-cash-desk    = no or buf_temp-fin-sumVne.cash-desk = buf_inkas-pay-desk.pay-desk)
     3163                     and (p-by-petrol-goods = no or buf_temp-fin-sumVne.is-petrol = is-petrolium)
     3164                     and buf_temp-fin-sumVne.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
     3165                     and buf_temp-fin-sumVne.is-expense_cash = (msum < 0 and mTypePay eq "cash" )
     3166                     and buf_temp-fin-sumVne.pay-type eq mTypePay
     3167                     no-error.
     3168                   if not available buf_temp-fin-sumVne then
     3169                   do:
     3170                     create buf_temp-fin-sumVne.
     3171                     assign
     3172                       buf_temp-fin-sumVne.curr-code       = buf_cash-pay.curr-code
     3173                       buf_temp-fin-sumVne.cash-desk       = (if p-by-cash-desk
     3174                                                         then buf_inkas-pay-desk.pay-desk
     3175                                                         else 0)
     3176                       buf_temp-fin-sumVne.is-petrol       = (if p-by-petrol-goods
     3177                                                         then is-petrolium
     3178                                                         else no)
     3179                       buf_temp-fin-sumVne.cashbookid      = (if available ub.CashBook then ub.CashBook.id else 0)
     3180                       buf_temp-fin-sumVne.is-expense_cash = msum < 0 and mTypePay eq "cash"
     3181                       buf_temp-fin-sumVne.pay-type        = mTypePay
     3182                       .
     3183                   end.
     3184                   assign
     3185                     buf_temp-fin-sumVne.tot-rubl = buf_temp-fin-sumVne.tot-rubl + (if v-curr-r-b = 'rubl':U
     3186                                                                           then buf_chk-gds-pay.tot-r-b
     3187                                                                           else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate)
     3188                                                                           )
     3189                     buf_temp-fin-sumVne.tot-base = buf_temp-fin-sumVne.tot-base + (if v-curr-r-b = 'base':U
     3190                                                                           then buf_chk-gds-pay.tot-r-b
     3191                                                                           else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate)
     3192                                                                           )
     3193                     buf_temp-fin-sumVne.tot-sum  = buf_temp-fin-sumVne.tot-sum + msum
     3194                     .
     3195                 end .
     3196                 else
     3197                 do:
     3198                   if mValueAvans > "" then do:
     3199                                     find first buf_temp-fin-sumAvans
     3200                     where buf_temp-fin-sumAvans.curr-code = buf_cash-pay.curr-code
     3201                     and (p-by-cash-desk    = no or buf_temp-fin-sumAvans.cash-desk = buf_inkas-pay-desk.pay-desk)
     3202                     and (p-by-petrol-goods = no or buf_temp-fin-sumAvans.is-petrol = is-petrolium)
     3203                     and buf_temp-fin-sumAvans.cashbookid = (if available ub.CashBook then ub.CashBook.id else 0)
