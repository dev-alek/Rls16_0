     3893                                                                     else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate) / buf_chk-pay.calc-rate
     3894                                                                     )
     3895                             .
     3896                         end.
     3897                         else
     3898                         do:
     3899                         end.
     3900                       end.
     3901                     end case.
     3902                   end.
     3903                 end.
