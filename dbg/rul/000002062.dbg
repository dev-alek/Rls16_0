     6436         tt-fin-doc.base-scale = 1
     6437         .
     6438       if buf_temp-fin-sumAvans.tot-sum > 0  then
     6439       do:
     6440         if p-by-petrol-goods then
     6441         do:
     6442           assign
     6443             tt-fin-doc.payer-name     = "Выручка от реализации " + (if buf_temp-fin-sumAvans.is-petrol then "нефтепродуктов" else "ТНП")
     6444             tt-fin-doc.receiver-sign3 = v-cashier
     6445             .
     6446         end.
     6447         else
     6448         do:
     6449           assign
     6450             tt-fin-doc.payer-name     = "Выручка от реализации нефтепродуктов, ТНП"
     6451             tt-fin-doc.receiver-sign3 = v-cashier
     6452             .
     6453         end.
     6454         assign
     6455           tt-fin-doc.payer-name = mpayer-name
     6456           when mpayer-name ne "".
     6457       end.
     6458       else
     6459       do:
     6460         if p-by-petrol-goods then
     6461         do:
     6462           assign
     6463             tt-fin-doc.payer-sign3 = v-cashier
     6464             .
     6465         end.
     6466         else
     6467         do:
     6468           assign
     6469             tt-fin-doc.payer-sign3 = v-cashier
     6470             .
     6471         end.
     6472         assign
     6473           tt-fin-doc.receiver-name = mreceiver-name
     6474           when mreceiver-name ne "".
     6475       end.
     6476       o-uchet   = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "uchet") .
     6477       if available ub.CashBook
     6478         then
     6479       do :
     6480         tt-fin-doc.cor-acc-value  = mdopacct .
     6481         tt-fin-doc.cor-acc1-value = mosnacct.
     6482         if buf_temp-fin-sumAvans.tot-sum > 0
     6483           then
     6484         do:
     6485           tt-fin-doc.payer-name = mpayer-name .
     6486         end.
     6487         FIND ub.fin-code-cor-acc WHERE
     6488           ub.fin-code-cor-acc.code-value  = tt-fin-doc.cor-acc-value
     6489           AND ub.fin-code-cor-acc.host-code  = tt-fin-doc.host-code
     6490           AND  ub.fin-code-cor-acc.status_ = integer('0':U)
     6491           NO-LOCK NO-error.
     6492         if not available ub.fin-code-cor-acc
     6493           then
     6494         do:
     6495           assign
     6496             tt-fin-doc.cor-acc-value = chr(63)
     6497             .
     6498         end.
     6499         else
     6500         do:
     6501           assign
     6502             tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code
     6503             .
     6504         end.
     6505         FIND ub.fin-code-cor-acc WHERE
     6506           ub.fin-code-cor-acc.code-value  = tt-fin-doc.cor-acc1-value
     6507           AND ub.fin-code-cor-acc.host-code  = tt-fin-doc.host-code
     6508           AND  ub.fin-code-cor-acc.status_ = integer('0':U)
     6509           NO-LOCK NO-error.
     6510         if not available ub.fin-code-cor-acc
     6511           then
     6512         do:
     6513           assign
     6514             tt-fin-doc.cor-acc1-value = chr(63)
     6515             .
     6516         end.
     6517         else
     6518         do:
     6519           assign
     6520             tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code
     6521             .
     6522         end.
     6523       end.
     6524       if o-uchet = "0"
     6525         then v-uchet = "cal" .
     6526       else v-uchet = "smen" .
     6527       if buf_shift-obj.status_ = 'зкр':U and v-uchet = "smen" then
     6528       do:
     6529         assign
     6530           tt-fin-doc.doc-date   = buf_shift-obj.close-date
     6531           tt-fin-doc.shift-date = buf_shift-obj.shift-date
     6532           tt-fin-doc.shift-num  = buf_shift-obj.shift-num
     6533           tt-fin-doc.shift-name = buf_shift-obj.shift-name
     6534           .
     6535       end.
     6536       if v-uchet = "smen" then tt-fin-doc.doc-date = buf_shift-obj.shift-date .
     6537       assign
     6538         tt-fin-doc.doc-author = 'auto':U.
     6539             run ref/findoc0.p (
     6540         input-output v-doc-rec
     6541               ,input 'ДОБАВЛЕНИЕ':U + chr(4) + 'auto':U
     6542               ,input yes
     6543               ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
     6544               ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     6545               ,input table tt0-fin-doc-tax
     6546               ,input table tt0-fin-doc-attr
     6547               ,input no
     6548               ,input table tt0-payment
     6549         ) no-error.
     6550       if error-status:error then
     6551       do:
     6552                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при сохранении фин.док-та:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value )).
     6553         undo _main, return error.
     6554       end.
     6555       find first buf_fin-doc share-lock where
     6556         recid(buf_fin-doc) = v-doc-rec.
     6557       assign
     6558         buf_fin-doc.shift-flag = integer('1':U)
     6559         .
     6560       if buf_temp-fin-sumAvans.contr-kb ne ?
     6561         then
     6562       do:
     6563         find first fin-doc-attr where fin-doc-attr.host-code eq buf_fin-doc.host-code
     6564           and fin-doc-attr.fin-doc-code eq buf_fin-doc.fin-doc-code
     6565           and fin-doc-attr.attr-code eq "contr-kb"
     6566           exclusive-lock no-error.
     6567         if not available fin-doc-attr
     6568           then
     6569         do:
     6570           create fin-doc-attr.
     6571           assign
     6572             fin-doc-attr.host-code    = buf_fin-doc.host-code
     6573             fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code
     6574             fin-doc-attr.attr-code    = "contr-kb"
     6575             .
     6576         end.
     6577         fin-doc-attr.attr-value = String(buf_temp-fin-sumAvans.contr-kb).
     6578       end.
     6579       run proc-close in this-procedure ( buffer buf_fin-doc) no-error.
     6580       if error-status :error then
     6581       do:
     6582                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при сохранении фин.док-та:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value )).
     6583         undo _main, return error.
     6584       END.
     6585       if buf_fin-doc.status_ <> 'факт':U then
     6586       do:
     6587         run proc-close in this-procedure ( buffer buf_fin-doc) NO-ERROR.
     6588         if error-status :error then
     6589         do:
     6590                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value )).
     6591           undo _main, return error.
     6592         END.
     6593       end.
     6594       if buf_fin-doc.status_ <> 'факт':U then
     6595       do:
     6596         run proc-close in this-procedure ( buffer buf_fin-doc) no-error .
     6597         if error-status :error then
     6598         do:
     6599                     if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось сменить статус фин.док-та:&1&2&1&3"                                      , chr(10)                                      , error-status:get-message(1)                                        , return-value )).
     6600           undo _main, return error.
     6601         END.
     6602       end.
     6603                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Создаю &1 для выручки по смене № &2 от &3 (П. &4)&8 для &5&6  по кассовой книге № &7 на сумму &8"                                   , entry (lookup ((if buf_temp-fin-sumAvans.tot-sum > 0 then 'пко':U else 'рко':U), 'пко,рко,ппп,рпп,апп,апр':U) + 1, ',':U + 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,приходный АПЗ,расходный АПЗ':U)                                    , buf_shift-obj.shift-name                                   , buf_shift-obj.shift-date                                   , buf_shift-obj.shift-nuM                                      , buf_shift-obj.obj-type                                   , buf_shift-obj.obj-code                                   , buf_temp-fin-sumAvans.cashbookid                                   , abs(buf_temp-fin-sumAvans.tot-sum)                                   , chr(10)                                   )).
     6604      end.
     6605     end.
     6606     finally:
     6607       delete object mCashBook no-error .
     6608     end finally.
     6609   end procedure.
     6610   procedure load-ruleset-context :
     6611     define input parameter p-ruleset-id as integer no-undo .
     6612     define variable v-rowid    as rowid     no-undo .
     6613     define variable v-tbl-name as character no-undo .
     6614     define buffer buf_rule-call-param for ub.rule-call-param.
     6615     main-block:
     6616     do
     6617       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6618       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6619       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6620       :
     6621       if g#news = yes then
     6622       do:
     6623         return "return".
     6624       end.
     6625       run gen-row-keyr in this-procedure (
     6626         input  p-doc-code
     6627         ,input ?
     6628         ,input  "ub"
     6629         ,input  ?
     6630         ,input  no-lock
     6631         ,output v-rowid
     6632         ,output v-tbl-name ) .
     6633       find first buf_shift-obj no-lock where
     6634         rowid(buf_shift-obj) = v-rowid.
     6635     end.
     6636   end procedure.
     6637   PROCEDURE StrTax :
     6638     do
     6639       on error undo, return error return-value
     6640       :
     6641       define input-output parameter str as character no-undo .
     6642       define variable v-envd as logical no-undo .
     6643       assign
     6644         str = " В т.ч.: "  .
     6645       for each tt0-fin-doc-tax :
     6646         if str <> " В т.ч.: " then str = str + "," .
     6647         if not tt0-fin-doc-tax.with-vat then assign str = str + "без налога (НДС) - (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6648         else
     6649         do:
     6650           if tt-fin-doc.curr-code = 0 then
     6651           do:
     6652               case taxVne:
     6653                 when "vne" then
     6654                   do:
     6655                     str = str + "без налога (НДС) - (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6656                   end.
     6657                 when "avans" then
     6658                   do:
     6659                     str = str + string(tt0-fin-doc-tax.vat-pc,">>9") + "/" + string(tt0-fin-doc-tax.vat-pc + 100,">>9") + " НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6660                   end.
     6661                 otherwise
     6662                 do:
     6663                   str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + " руб. (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6664                 end.
     6665               end case .
     6666           end.
     6667           else
     6668           do:
     6669               case taxVne:
     6670                 when "vne" then
     6671                   do:
     6672                     str = str + "без налога (НДС) - (от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6673                   end.
     6674                 when "avans" then
     6675                   do:
     6676                     str = str + string(tt0-fin-doc-tax.vat-pc,">>9") + "/" + string(tt0-fin-doc-tax.vat-pc + 100,">>9") + " НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + "(от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6677                   end.
     6678                 otherwise
     6679                 do:
     6680                   str = str + string(tt0-fin-doc-tax.vat-pc,">>9.9") + "% НДС - " + string(tt0-fin-doc-tax.sum-vat-line-doc) + "(от суммы " + string(tt0-fin-doc-tax.sum-line-doc) + ") " .
     6681                 end.
     6682               end case .
     6683           end.
     6684         end.
     6685         if str = " В т.ч.: " then assign str = "" .
     6686       end.
     6687     end.
     6688   END PROCEDURE.
     6689   PROCEDURE RoundTax :
     6690     do
     6691       on error undo, return error return-value
     6692       :
     6693       for each tt0-fin-doc-tax :
     6694         assign
     6695           tt0-fin-doc-tax.sum-line-doc      = ROUND( tt0-fin-doc-tax.sum-line-doc      , 2)
     6696           tt0-fin-doc-tax.sum-vat-line-doc  = ROUND( tt0-fin-doc-tax.sum-vat-line-doc  , 2)
     6697           tt0-fin-doc-tax.sum-line-rubl     = ROUND( tt0-fin-doc-tax.sum-line-rubl     , 2)
     6698           tt0-fin-doc-tax.sum-vat-line-rubl = ROUND( tt0-fin-doc-tax.sum-vat-line-rubl , 2)
     6699           tt0-fin-doc-tax.sum-line-base     = ROUND( tt0-fin-doc-tax.sum-line-base     , 2)
     6700           tt0-fin-doc-tax.sum-vat-line-base = ROUND( tt0-fin-doc-tax.sum-vat-line-base , 2)
     6701           .
     6702       end.
     6703     end.
     6704   END PROCEDURE.
     6705   procedure proc-close :
     6706     define parameter buffer buf_fin-doc for ub.fin-doc.
     6707     define variable v-status_         as character no-undo .
     6708     define variable v-old-status_     as character no-undo .
     6709     define variable v-ask-date        as logical   no-undo .
     6710     define variable v-ask-message     as character no-undo .
     6711     define variable v-status-date-chr as character no-undo.
     6712     define variable v-date1           as date      no-undo .
     6713     assign
     6714       v-old-status_ = buf_fin-doc.status_
     6715       .
     6716     run trg/findgraf.p (
     6717       input  buf_fin-doc.host-code
     6718       ,input  buf_fin-doc.fin-doc-code
     6719       ,input  '<закрытие документа>':U
     6720       ,input  ''
     6721       ,input  v-old-status_
     6722       ,input  ?
     6723       ,output v-status_
     6724       ,output v-ask-date
     6725       ,output v-ask-message
     6726       ) no-error.
     6727     if error-status:error then
     6728     do:
     6729       return error substitute("Ошибка при проверке возможности &1&2&3"
     6730         ,'<закрытие документа>':U
     6731         , chr(10)
     6732         , return-value ).
     6733     end.
     6734     v-date1 = buf_fin-doc.doc-date.
     6735     run trg/findstat.p (
     6736       input parparentproc
     6737       ,input buf_fin-doc.host-code
     6738       ,input buf_fin-doc.fin-doc-code
     6739       ,input '<закрытие документа>':U
     6740       ,input 'auto':U
     6741       ,input v-status_
     6742       ,input-output v-date1
     6743       ,input no
     6744       ) no-error .
     6745     if error-status:error then
     6746     do:
     6747       return error substitute("Ошибка при переводе статуса финансового документа:&1&2&1&3"
     6748         ,'<закрытие документа>':U
     6749         , chr(10)
     6750         , return-value ).
     6751     end.
     6752   end procedure.
     6753   procedure check-petrol :
     6754     define input  parameter p-b-code       like ub.chk-gds-pay.b-code no-undo.
     6755     define output parameter p-is-petrolium as logical                 no-undo.
     6756     define variable is-petrol as logical   no-undo.
     6757     define variable is-pieces as logical   no-undo.
     6758     define variable v-value   as character no-undo.
     6759     define variable v-type    as character no-undo.
     6760     define buffer buf_bar-code for ub.bar-code.
     6761     define buffer buf_goods    for ub.goods.
     6762     find first buf_bar-code no-lock where
     6763       buf_bar-code.b-code = p-b-code no-error.
     6764     if available buf_bar-code then
     6765     do:
     6766       find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     6767       if available buf_goods then
     6768       do:
     6769         assign
     6770           p-is-petrolium = false .
     6771   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6772     (
     6773        input buf_goods.artic
     6774     ,  input buf_goods.prod-type
     6775     ,  input buf_goods.prod-code
     6776     , output is-petrol
     6777     , output is-pieces
     6778     ) no-error.
     6779     if  is-petrol = yes
     6780       and is-pieces = no
     6781       then
     6782     do :
     6783       run gds-attr-value in this-procedure (
     6784         input buf_goods.gds-code
     6785         ,input 'ptrl-as-good':U
     6786         ,output v-value
     6787         ,output v-type
     6788         ) no-error.
     6789       if NOT logical(v-value) = yes then
     6790       do:
     6791         assign
     6792           p-is-petrolium = yes.
     6793       end.
     6794     end.
     6795   end.
     6796   end.
     6797   end procedure.
