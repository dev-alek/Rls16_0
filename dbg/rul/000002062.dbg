     3984                                       else no)
     3985                 buf_temp-tax.cashbookId       = (if available ub.CashBook then ub.CashBook.id else 0)
     3986                 buf_temp-tax.is-expense_cash  = (buf_temp-gds.tot-doc < 0 and buf_temp-gds.pay-type eq "cash")
     3987                 buf_temp-tax.num-expense_cash = 0
