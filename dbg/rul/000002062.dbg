     3964               and buf_temp-tax.slt-pc = buf_doc-line.slt-pc
     3965               and buf_temp-tax.cash-desk = buf_temp-gds.cash-desk
     3966               and buf_temp-tax.is-petrol = buf_temp-gds.is-petrol
     3967               and buf_temp-tax.cashbookId = (if available ub.CashBook then ub.CashBook.id else 0)
     3968               and buf_temp-tax.is-expense_cash = (buf_temp-gds.tot-doc < 0 and buf_temp-gds.pay-type eq "cash")
     3969               and buf_temp-tax.pay-type = buf_temp-gds.pay-type
     3970               and buf_temp-tax.num-expense_cash = 0
     3971               no-error.
