     5952             tt0-fin-doc-tax.sum-line-base     = tt0-fin-doc-tax.sum-line-base  + temp-autotank.sum-return
     5953             tt0-fin-doc-tax.sum-vat-line-base = tt0-fin-doc-tax.sum-vat-line-base  +
