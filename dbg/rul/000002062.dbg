     2528   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2529   procedure set-error :
     2530   define input parameter p-mess as character no-undo .
     2531     do
     2532     on error undo, return error
     2533     :
     2534        assign
     2535        v-last-error-message = p-mess.
     2536     end.
     2537   end procedure.
     2538     define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     2539     define variable p-by-cash-desk    as logical   no-undo .
     2540     define variable p-by-petrol-goods as logical   no-undo .
     2541     define variable p-by-osnovanie    as character no-undo .
     2542     define variable p-by-pril         as character no-undo .
     2543     on delete of this-procedure
     2544       do:
     2545         run garbcoll_clear in this-procedure .
     2546       end.
     2547     run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error.
     2548     if error-status:error then
     2549     do:
     2550       undo, return error return-value .
     2551     end.
     2552     if return-value = "return" then return ''.
     2553     if not this-procedure:persistent then
     2554     do:
     2555       run proc-main in this-procedure no-error .
     2556       if error-status:error then
     2557       do:
     2558         v-esm = error-status :get-message (1).
     2559         v-es = error-status:error .
     2560         v-rv = return-value .
     2561       end.
     2562       if v-es then
     2563       do:
     2564         run garbcoll_clear in this-procedure .
     2565         undo, return error substitute( "&1. &2&3&4", vss-workfile, v-rv, chr(10), v-esm).
     2566       end.
     2567       run garbcoll_clear in this-procedure .
     2568     end.
