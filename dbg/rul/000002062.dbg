     3249                       buf_temp-fin-sum.cash-desk       = (if p-by-cash-desk
     3250                                                         then buf_inkas-pay-desk.pay-desk
     3251                                                         else 0)
     3252                       buf_temp-fin-sum.is-petrol       = (if p-by-petrol-goods
     3253                                                         then is-petrolium
     3254                                                         else no)
     3255                       buf_temp-fin-sum.cashbookid      = (if available ub.CashBook then ub.CashBook.id else 0)
