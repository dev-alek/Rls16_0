     6272           ,output v-limit-access ) no-error .
     6273       end.
     6274       else
     6275       do:
     6276         run ref/finfnoco.p (
     6277           INPUT parParentProc
     6278           ,INPUT ?
     6279           ,input v-host-code
     6280           ,input ('ДОБАВЛЕНИЕ':U + chr(4) + 'auto':U)
     6281           ,input v-host-code
     6282           ,input v-doc-rec
     6283           ,input 0
     6284           ,input 'рко':U
     6285           ,input 'рко':U
     6286           ,input buf_shift-obj.obj-type
     6287           ,input buf_shift-obj.obj-code
     6288           ,input 0
     6289           ,input ''
     6290           ,input 'орг':U
     6291           ,input v-host-code
     6292           ,input 0
     6293           ,input v-real-obj-type-save
     6294           ,input v-real-obj-code-save
     6295           ,input 0
     6296           ,input buf_temp-fin-sumAvans.curr-code
     6297           ,input 0
     6298           ,input 0
     6299           ,input 0
     6300           ,input 0
     6301           ,input buf_temp-fin-sumAvans.cashbookid
     6302           ,input ""
     6303           ,INPUT-OUTPUT table tt-fin-doc
     6304           ,INPUT-OUTPUT table ttc-fin-doc
     6305           ,output table tt0-fin-doc-attr
     6306           ,output v-limit-access ) no-error .
     6307       end.
     6308       if error-status:error then
     6309       do:
     6310                 if valid-handle(p-log-handle) then           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки при заполнении фин.док-та значениями по умолчанию:&1&2&1&3"                                    , chr(10)                                    , error-status:get-message(1)                                      , return-value )).
     6311         undo _main, return error.
     6312       end.
     6313       find first tt-fin-doc.
     6314       for each buf_temp-taxAvans no-lock
     6315         where buf_temp-taxAvans.curr-code        = buf_temp-fin-sumAvans.curr-code
     6316         and buf_temp-taxAvans.cash-desk         = buf_temp-fin-sumAvans.cash-desk
     6317         and buf_temp-taxAvans.is-petrol        = buf_temp-fin-sumAvans.is-petrol
     6318         and buf_temp-taxAvans.cashbookId       = buf_temp-fin-sumAvans.cashbookId
     6319         and buf_temp-taxAvans.is-expense_cash  = buf_temp-fin-sumAvans.is-expense_cash
     6320         and buf_temp-taxAvans.num-expense_cash = buf_temp-fin-sumAvans.num-expense_cash
     6321         and buf_temp-taxAvans.pay-type = buf_temp-fin-sumAvans.pay-type
     6322         :
     6323         v-line-num = v-line-num + 1.
     6324         create tt0-fin-doc-tax .
     6325         assign
     6326           tt0-fin-doc-tax.fin-doc-code       = tt-fin-doc.fin-doc-code
     6327           tt0-fin-doc-tax.host-code          = tt-fin-doc.host-code
     6328           tt0-fin-doc-tax.line-num           = v-line-num
     6329           tt0-fin-doc-tax.VAT-pc             = buf_temp-taxAvans.vat-pc
     6330           tt0-fin-doc-tax.slt-pc             = buf_temp-taxAvans.slt-pc
     6331           tt0-fin-doc-tax.sum-line-contr     = 0
     6332           tt0-fin-doc-tax.sum-vat-line-contr = 0
     6333           tt0-fin-doc-tax.with-vat           = buf_temp-taxAvans.with-vat
     6334           .
     6335         if buf_temp-fin-sumAvans.tot-sum > 0  then
     6336         do :
     6337           assign
     6338             tt0-fin-doc-tax.sum-line-doc      = buf_temp-taxAvans.sum-doc
     6339             tt0-fin-doc-tax.sum-vat-line-doc  = buf_temp-taxAvans.vat-doc
     6340             tt0-fin-doc-tax.sum-line-rubl     = buf_temp-taxAvans.sum-rubl
     6341             tt0-fin-doc-tax.sum-vat-line-rubl = buf_temp-taxAvans.vat-rubl
     6342             tt0-fin-doc-tax.sum-line-base     = buf_temp-taxAvans.sum-base
     6343             tt0-fin-doc-tax.sum-vat-line-base = buf_temp-taxAvans.vat-base
     6344             .
     6345         end.
     6346         else
     6347         do :
     6348           assign
     6349             tt0-fin-doc-tax.sum-line-doc      = abs(buf_temp-taxAvans.sum-doc)
     6350             tt0-fin-doc-tax.sum-vat-line-doc  = abs(buf_temp-taxAvans.vat-doc)
     6351             tt0-fin-doc-tax.sum-line-rubl     = abs(buf_temp-taxAvans.sum-rubl)
     6352             tt0-fin-doc-tax.sum-vat-line-rubl = abs(buf_temp-taxAvans.vat-rubl)
     6353             tt0-fin-doc-tax.sum-line-base     = abs(buf_temp-taxAvans.sum-base)
     6354             tt0-fin-doc-tax.sum-vat-line-base = abs(buf_temp-taxAvans.vat-base)
     6355             .
     6356         end.
     6357         find first temp-autotank no-lock
     6358           where temp-autotank.curr-code = buf_temp-taxAvans.curr-code
     6359           and temp-autotank.pay-desk = buf_temp-taxAvans.cash-desk
     6360           and temp-autotank.is-petrol = buf_temp-taxAvans.is-petrol
     6361           and temp-autotank.vat-pc    = buf_temp-taxAvans.vat-pc
     6362           and temp-autotank.slt-pc    = buf_temp-taxAvans.slt-pc
     6363           no-error.
     6364         if available temp-autotank then
     6365         do:
     6366           assign
     6367             tt0-fin-doc-tax.sum-line-doc      = tt0-fin-doc-tax.sum-line-doc + temp-autotank.sum-return
     6368             tt0-fin-doc-tax.sum-vat-line-doc  = tt0-fin-doc-tax.sum-vat-line-doc +
     6369                                        round(temp-autotank.sum-return * tt0-fin-doc-tax.VAT-pc / (100 + tt0-fin-doc-tax.VAT-pc),2)
     6370             tt0-fin-doc-tax.sum-line-rubl     = tt0-fin-doc-tax.sum-line-rubl + temp-autotank.sum-return
     6371             tt0-fin-doc-tax.sum-vat-line-rubl = tt0-fin-doc-tax.sum-vat-line-rubl +
     6372                                        round(temp-autotank.sum-return * tt0-fin-doc-tax.VAT-pc / (100 + tt0-fin-doc-tax.VAT-pc),2)
     6373             tt0-fin-doc-tax.sum-line-base     = tt0-fin-doc-tax.sum-line-base  + temp-autotank.sum-return
     6374             tt0-fin-doc-tax.sum-vat-line-base = tt0-fin-doc-tax.sum-vat-line-base  +
     6375                                        round(temp-autotank.sum-return * tt0-fin-doc-tax.VAT-pc / (100 + tt0-fin-doc-tax.VAT-pc),2)
     6376             .
     6377         end.
     6378         release tt0-fin-doc-tax.
     6379       end.
     6380       taxVne = "avans" .
     6381       run StrTax in this-procedure ( input-output tt-fin-doc.including) .
     6382       run RoundTax in this-procedure .
     6383       if available ub.CashBook
     6384         then
     6385       do :
     6386         p-by-cash-desk = ub.CashBook.FlagSepCash .
     6387         p-by-petrol-goods = ub.CashBook.FlagSepFull .
     6388         p-by-pril = ub.CashBook.RulePril .
     6389       end.
     6390       if p-by-cash-desk then
     6391       do:
     6392         find first temp-z-number-list no-lock
     6393           where temp-z-number-list.cash-desk = buf_temp-fin-sumAvans.cash-desk
     6394           no-error.
     6395       end.
     6396       if     trim(p-by-pril) = '0'
     6397         and buf_temp-fin-sumAvans.pay-type ne "trans"
     6398         then
     6399         tt-fin-doc.enclosure = v-naznach-plat.
     6400       case p-by-osnovanie:
     6401         when '0' then
     6402           do :
     6403             v-naznach-plat = 'Выручка от реализации'.
     6404             if available temp-z-number-list then temp-z-number-list.naznach-plat = 'Выручка от реализации'.
     6405           end.
     6406         when '2'          then
     6407           do :
     6408             v-naznach-plat = ''.
     6409             if available temp-z-number-list then temp-z-number-list.naznach-plat = ''.
     6410           end.
     6411         when '1'          then
     6412           do :
     6413             if available temp-z-number-list then temp-z-number-list.naznach-plat = v-naznach-plat.
     6414           end.
     6415         otherwise
     6416         do:
     6417           v-naznach-plat = p-by-osnovanie.
     6418           if available temp-z-number-list then temp-z-number-list.naznach-plat = p-by-osnovanie.
     6419         end.
     6420       end case .
     6421       assign
     6422         tt-fin-doc.naznach-plat = (if p-by-cash-desk
     6423                                           then (if available temp-z-number-list
     6424                                                 then temp-z-number-list.naznach-plat
     6425                                                 else '')
     6426                                           else  v-naznach-plat)
     6427         .
     6428       assign
     6429         tt-fin-doc.CashBookId = buf_temp-fin-sumAvans.cashbookid
     6430         tt-fin-doc.sum-doc    = abs(buf_temp-fin-sumAvans.tot-sum)
     6431         tt-fin-doc.sum-base   = abs(buf_temp-fin-sumAvans.tot-base)
     6432         tt-fin-doc.sum-rubl   = abs(buf_temp-fin-sumAvans.tot-rubl)
     6433         tt-fin-doc.exch-rate  = abs(if buf_temp-fin-sumAvans.curr-code = 0 then 1 else buf_temp-fin-sumAvans.tot-rubl / buf_temp-fin-sumAvans.tot-sum )
     6434         tt-fin-doc.exch-scale = 1
