     3977                 buf_temp-tax.vat-pc           = buf_doc-line.vat-pc
     3978                 buf_temp-tax.slt-pc           = buf_doc-line.slt-pc
     3979                 buf_temp-tax.cash-desk        = (if p-by-cash-desk
