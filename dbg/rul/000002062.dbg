     5287           .
     5288       end.
     5289     end.
     5290     assign
     5291       v-naznach-plat                  = v-naznach-plat + (if v-naznach-plat = '' then '' else chr(44)) + string(temp-z-number.z-number)
     5292       temp-z-number-list.naznach-plat = temp-z-number-list.naznach-plat + (if temp-z-number-list.naznach-plat = '' then '' else chr(44)) + string(temp-z-number.z-number)
     5293       .
     5294   end.
     5295   v-naznach-plat = substitute("Z-отчет(ы) &1 от &2г.", v-naznach-plat, if v-uchet = "smen" then string(buf_shift-obj.shift-date, "99/99/99") else string(TODAY, "99/99/99")).
     5296   for each temp-z-number-list:
