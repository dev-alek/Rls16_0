     5356           when buf_temp-fin-sum.tot-sum > 0
     5357           mosnacct             = ub.CashBook.OsnAcct
     5358           mdopacct             = mCashBook:getSinglRule(buf_temp-fin-sum.cashbookid, 'всем':U, 0, "Corr-transf")
     5359            //mcredit              = if  buf_temp-fin-sum.tot-sum < 0 then mCashBook:getSinglRule(buf_temp-fin-sum.cashbookid, {&by_all}, 0, "Corr-transf") else ub.CashBook.OsnAcct
     5360           .
