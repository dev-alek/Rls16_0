     5489         tt0-fin-doc-tax.sum-line-contr     = 0
     5490         tt0-fin-doc-tax.sum-vat-line-contr = 0
     5491         tt0-fin-doc-tax.with-vat           = buf_temp-tax.with-vat
     5492         .
