     2574   procedure get-header-by-rec :
     2575   define input  parameter p-gate-rec as character no-undo .
     2576   define output parameter p-tth as handle no-undo .
     2577   define variable v-ii as integer   no-undo .
     2578   define variable glog as logical   no-undo .
     2579   define variable v-rowid as rowid no-undo .
     2580   define variable v-tbl-name as character no-undo .
     2581   define variable v-longchar as longchar no-undo .
     2582   define variable v-txmlh as handle no-undo .
     2583   define buffer buf_clob-data for ub.clob-data.
     2584   main-block:
     2585   do
     2586   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     2587   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     2588   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     2589   :
     2590     run gen-row-keyr in  this-procedure  (
     2591                                           input  p-gate-rec
     2592                                           ,input  ?
     2593                                           ,input  "ub"
     2594                                           ,input  ?
     2595                                           ,input  NO-LOCK
     2596                                           ,output v-rowid
     2597                                           ,output v-tbl-name   ) no-error.
     2598       find first buf_clob-data no-lock where
     2599                 rowid(buf_clob-data) = v-rowid  no-error.
     2600       if not available buf_clob-data then do:
     2601         undo, return error substitute("Не найден CLOB  &1"
     2602                                         , p-gate-rec
     2603                                         ).
     2604       end.
     2605       assign
     2606       v-longchar = buf_clob-data.cdata
     2607       .
     2608       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2609       if error-status :error then do:
     2610         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2611       end.
     2612       create temp-table p-tth .
     2613       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     2614                                     , v-longchar
     2615                                     , ?
     2616                                     , ?
     2617                                     , ?
     2618                                     ) no-error.
     2619       v-longchar = '':U.
     2620       define variable v-esm as character no-undo .
     2621       v-esm = error-status:get-message(1).
     2622       if error-status :error
     2623       or not glog
     2624       then do:
     2625         delete object p-tth no-error.
     2626         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2627                                    , p-gate-rec
     2628                                    , buf_clob-data.file-name_
     2629                                    , chr(10)
     2630                                    , v-esm
     2631                                     ).
     2632       end.
     2633   end.
     2634   end procedure.
     2635   // { bge/getoxmlh.i } 23/VIII-2018 xmllib.i и tmpcxmlh.i вставлены напрямую
     2636   define variable vss-include-info16 as character format "X(65)" no-undo
     2637   initial "@(#)$Workfile$ $Revision$".
     2638   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2639   define stream stmXMLOut.
     2640   define stream stmXMLLog.
     2641   define stream strXMLIn.
     2642   define temp-table temp_xmllib_rec-list no-undo
     2643       field recName       as character
     2644       field recLevel      as integer
     2645       field recOpenLine   as integer
     2646       field recCloseLine  as integer
     2647       field closed        as logical
     2648       index pi is primary unique
     2649           recName
     2650           recLevel
     2651       index cl
     2652           closed
     2653   .
