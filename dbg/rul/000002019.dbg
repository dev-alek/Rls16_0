     4574   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     4575                                                       ,input p-range-type as character
     4576                                                       ,input p-code as integer):
     4577   define variable v-seq-val as integer no-undo .
     4578   define buffer buf_code-range for ub.code-range.
     4579   find first buf_code-range no-lock where
     4580             buf_code-range.db-num = p-db-num
     4581       and  buf_code-range.range-type = p-range-type
     4582       and  buf_code-range.stts = 'u'
     4583       and buf_code-range.first-code <= p-code
     4584       and buf_code-range.last-code >= p-code no-error .
     4585   if available buf_code-range then return yes.
     4586   CASE p-range-type:
     4587     when 'pngb':U then do:
     4588       v-seq-val = current-value(s-pngb-code, ub).
     4589     end.
     4590     when 'fmgb':U then do:
     4591       v-seq-val = current-value(s-fmgb-code, ub).
     4592     end.
     4593   END CASE.
     4594   if p-code <= v-seq-val then do:
     4595     find first buf_code-range no-lock where
     4596               buf_code-range.db-num = p-db-num
     4597         and  buf_code-range.range-type = p-range-type
     4598         and  buf_code-range.stts = 'a'
     4599         and buf_code-range.first-code <= p-code
     4600         no-error .
     4601    if available buf_code-range then return yes.
     4602   end.
     4603   find first buf_code-range no-lock where
     4604             buf_code-range.db-num = p-db-num
     4605       and  buf_code-range.range-type = p-range-type
     4606       and  buf_code-range.stts = 'f'
     4607       and buf_code-range.first-code <= p-code
     4608       and buf_code-range.last-code >= p-code
     4609       no-error .
     4610   if available buf_code-range then return yes.
     4611   return no.
     4612   END FUNCTION.
     4613   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     4614                                                       ,input p-range-type as character
     4615                                                       ,input p-code as integer):
     4616   define variable v-seq-val as integer no-undo .
     4617   define buffer buf_code-range for ub.code-range.
     4618   CASE p-range-type:
     4619     when 'pngb':U then do:
     4620       v-seq-val = current-value(s-pngb-code, ub).
     4621     end.
     4622     when 'fmgb':U then do:
     4623       v-seq-val = current-value(s-fmgb-code, ub).
     4624     end.
     4625   END CASE.
     4626   if p-code <= v-seq-val then do:
     4627     find first buf_code-range no-lock where
     4628               buf_code-range.db-num = p-db-num
     4629         and  buf_code-range.range-type = p-range-type
     4630         and buf_code-range.first-code <= p-code
     4631         and buf_code-range.last-code >= p-code no-error .
     4632     if available buf_code-range then return yes.
     4633   end.
     4634   return no.
     4635   END FUNCTION.
     4636   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     4637                                                       ,input p-db-num as integer
     4638                                                       ,input p-staff-code as integer
     4639                                                       ,input p-date as date
     4640                                                        ):
     4641   define buffer buf_staff for ub.staff.
     4642   if p-date = ? then do:
     4643     p-date = today .
     4644   end.
     4645   find first buf_staff no-lock where
     4646             buf_staff.role = p-role
     4647         and buf_staff.role-level = 'db':U
     4648         and buf_staff.db-num = p-db-num
     4649         and buf_staff.staff-code = p-staff-code
     4650         and buf_staff.date-end >= p-date use-index pi  no-error .
     4651   if available buf_staff then do:
     4652     return buf_staff.psn-code.
     4653   end.
     4654   return 0.
     4655   end FUNCTION.
     4656   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     4657                                                             ,input p-db-num as integer
     4658                                                             ,input p-date as date
     4659                                                                 ):
     4660   define buffer buf_staff for ub.staff.
     4661   define buffer buf2_staff for ub.staff.
     4662   if p-date = ? then do:
     4663     p-date = today .
     4664   end.
     4665   for each  buf_staff no-lock where
     4666             buf_staff.role = p-role
     4667         and buf_staff.db-num = p-db-num,
     4668   first buf2_staff no-lock where
     4669         buf2_staff.role = p-role
     4670     and buf2_staff.role-level = 'db':U
     4671     and buf2_staff.staff-code = buf_staff.staff-code
     4672     and buf2_staff.date-start <= p-date
     4673     and buf2_staff.date-end >= p-date
     4674   by buf_staff.staff-code
     4675   by date-start descending:
     4676     return buf_staff.staff-code.
     4677   end.
     4678   end FUNCTION.
     4679   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     4680                                                  ,input p-db-num as integer
     4681                                                  ,input p-psn-code as integer
     4682                                                  ,input p-date as date
     4683                                                  ,output p-c-password as character
     4684                                                        ):
     4685   define buffer buf_staff for ub.staff.
     4686   if p-date = ? then do:
     4687     p-date = today .
     4688   end.
     4689   find first buf_staff no-lock where
     4690             buf_staff.role = p-role
     4691         and buf_staff.role-level = 'db':U
     4692         and buf_staff.db-num = p-db-num
     4693        and buf_staff.date-end >= p-date
     4694        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     4695   if available buf_staff
     4696   then do:
     4697     assign
     4698     p-c-password = buf_staff.password.
     4699     return buf_staff.staff-code.
     4700   end.
     4701   p-c-password = ''.
     4702   return 0.
     4703   end FUNCTION.
     4704   FUNCTION gbclcode-is-psn-role returns integer (
     4705                                                 input p-role as character
     4706                                                 ,input p-psn-code as integer
     4707                                                 ,input p-date as date
     4708                                                     ):
     4709   define buffer buf_staff for ub.staff.
     4710   if p-date = ? then do:
     4711     p-date = today .
     4712   end.
     4713   for each buf_staff no-lock where
     4714             buf_staff.psn-code = p-psn-code
     4715        and  buf_staff.role = p-role
     4716   by buf_staff.role-level
     4717   by buf_staff.date-start
     4718        :
     4719     if  buf_staff.date-start <= p-date and
     4720     buf_staff.date-end >= p-date  then do:
     4721       return buf_staff.staff-code.
     4722     end.
     4723   end.
     4724   return 0.
     4725   end FUNCTION.
     4726   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     4727   define variable v-role-name as character no-undo .
     4728   assign
     4729   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     4730   no-error .
     4731   return v-role-name.
     4732   END.
     4733   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4734   FUNCTION gbclcode-get-position returns character ( input p-role as character
     4735                                                     ,input p-role-level as character
     4736                                                     ,input p-work-place as character
     4737                                                     ,input p-staff-code as integer
     4738                                                                ):
     4739   define variable v-role-name as character no-undo .
     4740   define variable v-role-level as character no-undo .
     4741   define variable v-staff-code as integer no-undo .
     4742   assign
     4743   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     4744   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     4745   v-staff-code = p-staff-code
     4746   no-error .
     4747   return substitute("&1, &2, Код &3"
     4748                   ,v-role-name
     4749                   ,v-role-level
     4750                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     4751   END.
     4752   FUNCTION gbclcode-get-work-place returns character (
     4753                                                   input p-role as character
     4754                                                  ,input p-role-level as character
     4755                                                  ,input p-db-num as integer
     4756                                                  ,input p-host-code as integer
     4757                                                  ,input p-obj-type as character
     4758                                                  ,input p-obj-code as integer
     4759                                                  ) :
     4760   define variable v-work-place as character no-undo .
     4761   define variable v-obj-type as character no-undo .
     4762     case p-role-level:
     4763       when 'db':U then do:
     4764         v-work-place = string(p-db-num, "99999").
     4765       end.
     4766       when 'firm':U then do:
     4767         v-work-place = string(p-host-code, "99999").
     4768       end.
     4769       when 'object':U then do:
     4770         assign
     4771         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     4772         .
     4773       end.
     4774     END CASE.
     4775     return v-work-place.
     4776   END FUNCTION.
     4777   FUNCTION gbclcode-get-level-last-code returns integer (
     4778                                                           input p-role as character
     4779                                                         , input p-role-level as character
     4780                                                         , input p-work-place as character
     4781                                                         , input p-date-start as date
     4782                                                         ):
     4783   DEFINE VARIABLE v-today as date no-undo .
     4784   define buffer buf_staff for ub.staff.
     4785   if p-work-place = chr(63) then return ?.
     4786   if p-date-start = ? then do:
     4787     v-today = today .
     4788   end.
     4789   else do:
     4790     v-today = p-date-start.
     4791   end.
     4792   find last buf_staff no-lock where
     4793             buf_staff.role = p-role
     4794        and  buf_staff.role-level = p-role-level
     4795        and  buf_staff.work-place = p-work-place
     4796        and  buf_staff.date-start <= v-today + 1
     4797        and  buf_staff.date-end >= v-today + 1
     4798        use-index pi  no-error .
     4799   if available buf_staff
     4800   then return buf_staff.staff-code.
     4801   return 0.
     4802   end FUNCTION.
     4803   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4804   PROCEDURE request-proc-save-staff :
     4805   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
     4806   define input parameter p-mode as character no-undo .
     4807   define input parameter p-callpoint as character no-undo .
     4808   define buffer buf_tt-staff for temp-staff_.
     4809   IF p-mode <> 'ДОБАВЛЕНИЕ':U
     4810   OR LOOKUP(p-callpoint , 'C,S':U) = 0 THEN RETURN.
     4811   for each buf_tt-staff :
     4812       RUN proc-save-staff IN p-child-handle (
     4813                                              INPUT buf_tt-staff.role
     4814                                             ,INPUT buf_tt-staff.staff-code
     4815                                             ,INPUT buf_tt-staff.role-level
     4816                                             ,INPUT buf_tt-staff.db-num
     4817                                             ,INPUT buf_tt-staff.host-code
     4818                                             ,INPUT buf_tt-staff.obj-type
     4819                                             ,INPUT buf_tt-staff.obj-code
     4820                                             ,INPUT buf_tt-staff.password
     4821                                             ,input buf_tt-staff.date-start
     4822                                             ,input buf_tt-staff.date-end
     4823                                             ,input buf_tt-staff.work-place
     4824                                               ) NO-ERROR.
     4825       IF ERROR-STATUS:ERROR THEN DO:
     4826         UNDO, RETURN ERROR RETURN-VALUE.
     4827       END.
     4828   END.
     4829   END PROCEDURE.
     4830   define buffer buf_temp-xml-tables for temp-xml-tables.
     4831   function 00120005_get-error-message returns character :
     4832   define variable v-ii as integer no-undo .
     4833   define variable v-mess as character no-undo .
     4834   DO v-ii = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4835       v-mess = substitute("&1&2ош &3"
     4836                           ,v-mess
     4837                           ,chr(10)
     4838                           ,ERROR-STATUS:GET-MESSAGE(v-ii)).
     4839   END.
     4840   return v-mess.
     4841   end function.
     4842   function 00120005_after-import_f returns logical ( input p-d-card as character):
     4843     run 00120005_after-import in this-procedure ( input p-d-card) no-error.
     4844     run set-error in this-procedure ( input return-value ).
     4845     return not (error-status:error).
     4846   end function.
     4847   define variable p-esys-id as integer no-undo .
     4848   define variable p-xsd-file as character no-undo.
     4849   on delete of this-procedure do:
     4850     run delete-procedure in this-procedure .
     4851     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh) no-error.
     4852   end.
     4853   run load-ruleset-context in this-procedure ( input p-ruleset-id) no-error .
     4854   if error-status:error
     4855   or return-value = "return" then return error.
     4856   define variable ImpData1 as class Route-data_ no-undo .
     4857   ImpData1 = new Route-data_( input parparentproc, input p-parent-handle, input p-log-handle, input this-procedure:handle, input v_dataseth, input v-xmlh) .
     4858   if not this-procedure:persistent then do:
     4859     run proc-main in this-procedure no-error .
     4860     if error-status:error then do:
     4861         run delete-procedure in this-procedure .
     4862         undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4863     end.
     4864     run delete-procedure in this-procedure .
     4865   end.
     4866   procedure proc-main :
     4867   define variable v-mode as character no-undo .
     4868   define variable v-line-num as integer no-undo .
     4869   define variable v-present as logical no-undo .
     4870   define variable v-current-tbl-name as character no-undo .
     4871   define variable v-current-cli-type as character no-undo .
     4872   define variable v-current-cli-code as integer no-undo .
     4873   define variable v-current-cli-name as character no-undo .
     4874   define variable v-current-code-bank as integer no-undo .
     4875   define variable v-current-r-schet as character no-undo .
     4876   define variable v-current-firm-code as integer no-undo .
     4877   define variable v-current-psn-code as integer no-undo .
     4878   define variable v-current-fin-cli-type as character no-undo .
     4879   define variable v-current-fin-cli-code as integer no-undo .
     4880   define variable v-current-staff-psn-code as integer no-undo .
     4881   define variable v-current-staff-code as integer no-undo .
     4882   define variable v-root-node-code as integer no-undo .
     4883   define variable v-schet-ii as integer no-undo .
     4884   define variable v_child-qh as handle no-undo .
     4885   define buffer buf_temp-clients_ for temp-clients_.
     4886   define buffer buf_temp-firm_ for temp-firm_.
     4887   define buffer buf_temp-person_ for temp-person_.
     4888   define buffer buf_temp-fin-schet_ for temp-fin-schet_.
     4889   define buffer buf_temp-staff_ for temp-staff_.
     4890   define buffer buf_temp-rel-handle for temp-rel-handle.
     4891   define variable v-rid as recid no-undo .
     4892   _main:
     4893   do transaction
     4894   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4895   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     4896   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     4897   :
     4898   run write-log  in p-log-handle (
     4899                                    input 0
     4900                                  , "&DLine").
     4901     run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute(".............Импорт данных по клиентам из ВС")).
     4902   run write-log-and-file in p-log-handle (
     4903         input 1
     4904       , input log-file-name
     4905       , input 1
     4906       , input substitute("Импорт данных по клиентам из файла &1", file-name)).
     4907   run  cgrplib-get-root-code in this-procedure ( output v-root-node-code).
     4908   for each buf_temp-xml-tables where
     4909          buf_temp-xml-tables.order >= 0
     4910      and buf_temp-xml-tables.is-parent = yes
     4911   :
     4912     if buf_temp-xml-tables.tbl-name = "Header_" then next.
     4913     create query v_qh.
     4914     glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     4915     if error-status:error
     4916     or
     4917     not glog then do:
     4918           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4919       undo _main, return error ''.
     4920     end.
     4921     glog = v_qh:query-prepare( substitute( "for each &1 by &1.line-num", buf_temp-xml-tables.tbl-name)) no-error .
     4922     if error-status:error
     4923     or
     4924     not glog then do:
     4925           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при попытке получить записи &1&2&3&2&4"                                                             , buf_temp-xml-tables.tbl-name                                                             , chr(10)                                                             , error-status:get-message(1)                                                             , return-value)).
     4926       if valid-handle(v_qh) then do:
     4927         delete object v_qh no-error.
     4928       end.
     4929       undo _main, return error ''.
     4930     end.
     4931     glog = v_qh:query-open no-error .
     4932     if error-status:error
     4933     or not glog then do:
     4934           .
     4935       if valid-handle(v_qh) then do:
     4936         delete object v_qh no-error.
     4937       end.
     4938       undo _main, return error ''.
     4939     end.
     4940       _stroka:
     4941       REPEAT:
     4942         v-retry-action = 0 .
     4943        _release:
     4944         do on error undo, retry:
     4945           if  retry then do:
     4946             v-retry-action = v-retry-action + 1.
     4947                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибка при импорте записи &5 &1&2&3&2&4"                                                                   , buf_temp-xml-tables.tbl-name                                                                   , num-rec                                                                   , chr(10)                                                                   , error-status:get-message(1)                                                                   , return-value)).
     4948             if valid-handle(v_qh) then do:
     4949               delete object v_qh no-error.
     4950             end.
     4951             undo _main, return error ''.
     4952           end.
     4953           if v-retry-action < 1 then do:
     4954                       ImpData1:Route-data_dump ( ) .
     4955           end.
     4956         end.
     4957         _rule:
     4958          do on error undo _rule, retry _rule:
     4959            if retry then do:
     4960             empty temp-table buf_temp-clients_.
     4961             empty temp-table buf_temp-firm_.
     4962             empty temp-table buf_temp-person_.
     4963             empty temp-table buf_temp-fin-schet_.
     4964             empty temp-table buf_temp-staff_.
     4965              if valid-handle(v_qh) then do:
     4966                delete object v_qh no-error.
     4967              end.
     4968              if valid-handle(v_child-qh) then do:
     4969                delete object v_child-qh no-error.
     4970              end.
     4971                         run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , return-value)).
     4972              undo _main, return error ''.
     4973            end.
     4974            else do:
     4975             v_qh:get-next().
     4976             IF v_qh:query-off-end then leave _stroka.
     4977             assign
     4978             v-current-tbl-name = ''
     4979             v-current-tbl-name = ImpData1:current-tbl-name() no-error.
     4980             case v-current-tbl-name:
     4981               when 'clients':U  THEN do:
     4982                 empty temp-table buf_temp-clients_.
     4983                 empty temp-table buf_temp-firm_.
     4984                 empty temp-table buf_temp-person_.
     4985                 empty temp-table buf_temp-fin-schet_.
     4986                 empty temp-table buf_temp-staff_.
     4987                 _tr:
     4988                 do
     4989                 on error undo _rule, retry _rule
     4990                 :
     4991                   v-line-num = ImpData1:route-data_get-field-integer( input 'clients':U, input "line-num") .
     4992                   v-present = no.
     4993                   num-rec = num-rec + 1.
     4994                   v-current-cli-type = ImpData1:route-data_get-field-character( input 'clients':U, input "obj-type") .
     4995                   v-current-cli-code = ImpData1:route-data_get-field-integer( input 'clients':U, input "obj-code") .
     4996                   v-current-cli-name = ImpData1:route-data_get-field-character( input 'clients':U, input "obj-name") .
     4997                   find first buf_temp-clients_ where
     4998                             buf_temp-clients_.obj-type = v-current-cli-type
     4999                         and buf_temp-clients_.obj-code = v-current-cli-code no-error.
     5000                   if not available buf_temp-clients_ then do:
     5001                     create  buf_temp-clients_.
     5002                     assign
     5003                     buf_temp-clients_.obj-type = v-current-cli-type
     5004                     buf_temp-clients_.obj-code = v-current-cli-code
     5005                     .
     5006                   end.
     5007                   assign
     5008                   buf_temp-clients_.obj-name = v-current-cli-name
     5009                   .
     5010                   assign
     5011                   glog = buffer buf_temp-clients_:handle:buffer-copy(ImpData1:route-data_get-record('clients':U), "obj-type,obj-code,obj-name") no-error.
     5012                   if not glog
     5013                   or error-status:error then do:
     5014                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи clients: &1&2&3"                                               , error-status:get-message(1)                                               , chr(10)                                               , return-value)).
     5015                     undo _rule, retry _rule.
     5016                   end.
     5017                   _rel:
     5018                   for each buf_temp-rel-handle where
     5019                           buf_temp-rel-handle.parent-buffer_ = v-current-tbl-name:
     5020                     run tmpreld2_query in this-procedure ( buffer buf_temp-rel-handle, input-output v_child-qh) no-error.
     5021                     if error-status:error then do:
     5022                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input return-value).
     5023                       undo _rule, retry _rule.
     5024                     end.
     5025                       _child:
     5026                       repeat:
     5027                       v_child-qh:get-next().
     5028                       IF v_child-qh:query-off-end then do:
     5029                         delete object v_child-qh no-error.
     5030                         next _rel.
     5031                       end.
     5032                       case buf_temp-rel-handle.child-buffer_:
     5033                         when 'firm':U
     5034                         THEN do:
     5035                           v-current-firm-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input 'firm':U , input "firm-code") .
     5036                             if v-current-firm-code <> v-current-cli-code then do:
     5037                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     5038                               delete object v_child-qh no-error.
     5039                               undo _rule, retry _rule.
     5040                             end.
     5041                           find first buf_temp-firm_ where
     5042                                     buf_temp-firm_.firm = v-current-firm-code no-error.
     5043                           if not available buf_temp-firm_ then do:
     5044                             create  buf_temp-firm_.
     5045                             assign
     5046                             buf_temp-firm_.firm-code = v-current-firm-code
     5047                             .
     5048                           end.
     5049                           assign
     5050                           glog = buffer buf_temp-firm_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     5051                                                                           ,"firm-code"
     5052                                                                         ) no-error.
     5053                           if not glog
     5054                           or error-status:error then do:
     5055                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                       , error-status:get-message(1)                                                       , chr(10)                                                       , return-value                                                       , 'firm':U)).
     5056                             undo _rule, retry _rule.
     5057                           end.
     5058                           release buf_temp-firm_ .
     5059                         end.
     5060                         when 'person':U
     5061                         THEN do:
     5062                           v-current-psn-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input 'person':U, input "psn-code") .
     5063                             if v-current-psn-code <> v-current-cli-code then do:
     5064                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     5065                               delete object v_child-qh no-error.
     5066                               undo _rule, retry _rule.
     5067                             end.
     5068                           find first buf_temp-person_ where
     5069                                     buf_temp-person_.psn-code = v-current-psn-code no-error.
     5070                           if not available buf_temp-person_ then do:
     5071                             create  buf_temp-person_.
     5072                             assign
     5073                             buf_temp-person_.psn-code = v-current-psn-code
     5074                             .
     5075                           end.
     5076                           assign
     5077                           glog = buffer buf_temp-person_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     5078                                                                            ,"psn-code"
     5079                                                                                                           ) no-error.
     5080                           if not glog
     5081                           or error-status:error then do:
     5082                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                       , error-status:get-message(1)                                                       , chr(10)                                                       , return-value                                                       , 'person':U )).
     5083                             undo _rule, retry _rule.
     5084                           end.
     5085                           release buf_temp-person_ .
     5086                         end.
     5087                         when 'fin-schet':U then do:
     5088                             v-current-fin-cli-type = ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input 'fin-schet':U, input "cli-type") .
     5089                             v-current-fin-cli-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle , input 'fin-schet':U, input "cli-code") .
     5090                           v-current-code-bank = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input 'fin-schet':U,  input "code-bank") .
     5091                           v-current-r-schet = ImpData1:route-data_get-field-character( buffer buf_temp-rel-handle:handle, input 'fin-schet':U,  input "r-schet") .
     5092                             if not (v-current-fin-cli-type = v-current-cli-type
     5093                                     and
     5094                                     v-current-fin-cli-code = v-current-cli-code)
     5095                              then do:
     5096                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     5097                               delete object v_child-qh no-error.
     5098                               undo _rule, retry _rule.
     5099                             end.
     5100                           find first buf_temp-fin-schet_ where
     5101                                       buf_temp-fin-schet_.cli-type = v-current-fin-cli-type
     5102                                   and buf_temp-fin-schet_.cli-code = v-current-fin-cli-code
     5103                                 and buf_temp-fin-schet_.code-bank = v-current-code-bank
     5104                                 and buf_temp-fin-schet_.r-schet = v-current-r-schet  no-error.
     5105                           if not available buf_temp-fin-schet_ then do:
     5106                             create  buf_temp-fin-schet_.
     5107                             assign
     5108                               buf_temp-fin-schet_.cli-type = v-current-fin-cli-type
     5109                               buf_temp-fin-schet_.cli-code = v-current-fin-cli-code
     5110                             buf_temp-fin-schet_.code-bank = v-current-code-bank
     5111                             buf_temp-fin-schet_.r-schet = v-current-r-schet
     5112                               buf_temp-fin-schet_.code-schet = v-schet-ii
     5113                               v-schet-ii = v-schet-ii + 1
     5114                             .
     5115                           end.
     5116                           assign
     5117                           glog = buffer buf_temp-fin-schet_:handle:buffer-copy(buf_temp-rel-handle.child-buffer-handle
     5118                                                                               ,"cli-type,cli-code,code-bank,r-schet"
     5119                                                                                                           ) no-error.
     5120                           if not glog
     5121                           or error-status:error then do:
     5122                                                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не удалось получить данные записи <&4>: &1&2&3"                                                       , error-status:get-message(1)                                                       , chr(10)                                                       , return-value                                                       , 'fin-schet':U )).
     5123                             undo _rule, retry _rule.
     5124                           end.
     5125                           release buf_temp-fin-schet_ .
     5126                         end.
     5127                         when 'staff':U
     5128                         THEN do:
     5129                           v-current-staff-psn-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input 'staff':U, input "psn-code") .
     5130                             if v-current-staff-psn-code <> v-current-cli-code then do:
     5131                                                           run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Запись &1: нарушение схемы")).
     5132                               delete object v_child-qh no-error.
     5133                               undo _rule, retry _rule.
     5134                             end.
     5135                             if v-current-staff-psn-code >= 600000000
     5136                             and v-current-staff-psn-code <= 699999999 then do:
     5137                               if not can-find ( first ub.clients no-lock where
     5138                                               ub.clients.obj-type = 'маг':U
     5139                                               and ub.clients.obj-code = integer(substring(string(v-current-staff-psn-code), 2, 4))
     5140                                               and ub.clients.db-num = g#db-num) then do:
     5141                                  next _child.
     5142                                end.
     5143                             end.
     5144                           v-current-staff-code = ImpData1:route-data_get-field-integer( buffer buf_temp-rel-handle:handle, input 'staff':U, input "staff-code") .
     5145                           find first buf_temp-staff_ where
     5146                                     buf_temp-staff_.psn-code = v-current-staff-psn-code
     5147                                 and buf_temp-staff_.staff-code = v-current-staff-code
     5148                                       no-error.
     5149                           if not available buf_temp-staff_ then do:
     5150                             create  buf_temp-staff_.
     5151                             assign
     5152                             buf_temp-staff_.psn-code = v-current-staff-psn-code
     5153                             buf_temp-staff_.staff-code = v-current-staff-code
     5154                             .
     5155                           end.
     5156                           release buf_temp-staff_ .
     5157                         end.
     5158                       end case.
     5159                     end.
     5160                     delete object v_child-qh no-error.
     5161                   end.
     5162               run proc-save in this-procedure (  input v-line-num
     5163                                                     ,input v-root-node-code
     5164                                                 ,buffer buf_temp-clients_) no-error.
     5165               if error-status:error then do:
     5166                 run set-err-type in p-cont-handle
     5167                   ( input 'PROCESSING'
     5168                   ) no-error.
     5169                 if valid-handle(v_qh) then do:
     5170                   delete object v_qh no-error.
     5171                 end.
     5172                               run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                            , error-status:get-message(1)                                           , chr(10)                                           , return-value)).
     5173                 undo _rule, retry _rule .
     5174               end.
     5175                   end.
     5176                 end.
     5177               end case.
     5178           end.
     5179         end.
     5180         v-retry-action = 0 .
     5181        _release:
     5182         do on error undo, retry:
     5183           if  retry then do:
     5184             v-retry-action = v-retry-action + 1.
     5185                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("&1&2&3"                                       , error-status:get-message(1)                                       , chr(10)                                       , v-last-error-message )).
     5186             undo _main, return error ''.
     5187           end.
     5188         if v-retry-action < 1 then do:
     5189                   ImpData1:Route-data_dump ( ) .
     5190         end.
     5191         end.
     5192         if v-retry-action = 0 then do:
     5193           num-rec-ok = num-rec-ok + 1.
     5194         end.
     5195         run write-counter in p-log-handle ( input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     5196       end.
     5197       v_qh:query-close().
     5198       if valid-handle(v_qh) then do:
     5199         delete object v_qh.
     5200       end.
     5201     end.
     5202     run write-log-and-file in p-log-handle (
     5203           input 1
     5204         , input log-file-name
     5205         , input 1
     5206         , input substitute("Обработано записей: &1, из них удачно: &2", num-rec, num-rec-ok)).
     5207   end.
     5208   end procedure.
     5209   procedure load-ruleset-context :
     5210   define input parameter p-ruleset-id as integer no-undo .
     5211   define buffer buf_rule-call-param for ub.rule-call-param.
     5212   define buffer buf_ext-system for ub.ext-system.
     5213   do
     5214   on error undo, return error
     5215   :
     5216    find first buf_rule-call-param no-lock where
     5217   buf_rule-call-param.codex_id = p-codex-id
     5218   and buf_rule-call-param.ruleset_id = p-ruleset-id
     5219   and buf_rule-call-param.call_id = p-call-id
     5220   and buf_rule-call-param.order_id = p-order-id
     5221   and buf_rule-call-param.rule_id = p-rule-id
     5222   and buf_rule-call-param.param-name = "p-esys-id"
     5223    no-error.
     5224   if available buf_rule-call-param then do:
     5225   assign p-esys-id = buf_rule-call-param.param-value-integer.
     5226   end.
     5227       find first buf_rule-call-param no-lock where
     5228   buf_rule-call-param.codex_id = p-codex-id
     5229   and buf_rule-call-param.ruleset_id = p-ruleset-id
     5230   and buf_rule-call-param.call_id = p-call-id
     5231   and buf_rule-call-param.order_id = p-order-id
     5232   and buf_rule-call-param.rule_id = p-rule-id
     5233   and buf_rule-call-param.param-name = "p-xsd-file"
     5234    no-error.
     5235   if available buf_rule-call-param then do:
     5236   assign p-xsd-file = buf_rule-call-param.param-value-character.
     5237   end.
     5238       case p-ruleset-id:
     5239         when 5 then do:
     5240           assign
     5241           v-sign = 1
     5242           v-current-host-code = p-host-code
     5243           v-current-obj-type = p-obj-type
     5244           v-current-obj-code = p-obj-code
     5245           v-current-db-num = g#db-num
     5246           v-current-lock = (if p-save >= 0 then exclusive-lock else no-lock)
     5247           file-name  = entry(1, p-process-file-name, chr(4))
     5248           v_dataseth = handle(entry(2, p-process-file-name, chr(4)))
     5249           v-xmlh = buffer buf_temp-xml-tables:handle
     5250           v-esys-id = integer(p-doc-code)
     5251           v-extension = entry(num-entries(file-name, "."), file-name, ".")
     5252           v-pck-num = integer(entry(3, p-process-file-name, chr(4)))
     5253           log-file-name = entry(4, p-process-file-name, chr(4))
     5254           no-error
     5255           .
     5256           if error-status:error then do:
     5257                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) )).
     5258             undo, return error substitute("Ошибки параметров&1&2 ..."                                         , chr(10)                                         , error-status:get-message(1) ).
     5259           end.
     5260           find first buf_ext-system no-lock where
     5261                     buf_ext-system.esys-id = v-esys-id
     5262                 and buf_ext-system.db-num = 0 no-error .
     5263           if not available buf_ext-system then do:
     5264                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         )).
     5265             undo, return error substitute("Не найдена ВС &1&2 ..."                                         , v-esys-id                                         , chr(10)                                         ).
     5266           end.
     5267           if v-extension = ''
     5268           or lookup(v-extension, "dat") = 0 then do:
     5269                       run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         )).
     5270             undo, return error substitute("Файл &1 имеет недопустимое расширение &3&2 ..."                                         ,file-name                                         , chr(10)                                         , v-extension                                         ).
     5271           end.
     5272           run tmpreldf_get-relations in this-procedure ( input  v_dataseth).
     5273         end.
     5274         otherwise do:
     5275           undo, return error "Неправильный вызов".
     5276         end.
     5277       end case.
     5278     end.
     5279   end procedure.
     5280   procedure delete-procedure :
     5281     do
     5282     on error undo, return error
     5283     :
     5284         for each temp-clients_:
     5285           delete temp-clients_.
     5286         end.
     5287         for each temp-firm_:
     5288           delete temp-firm_.
     5289         end.
     5290         for each temp-person_:
     5291           delete temp-person_.
     5292         end.
     5293         for each temp-fin-schet_:
     5294           delete temp-fin-schet_.
     5295         end.
     5296         for each temp-staff_:
     5297           delete temp-staff_.
     5298         end.
     5299         run garbcoll_clear in this-procedure .
     5300     end.
     5301   end procedure.
     5302   procedure proc-save :
     5303   define input  parameter p-line-num as integer   no-undo .
     5304   define input  parameter p-grp-code as integer no-undo .
     5305   define parameter buffer buf_temp-clients_ for temp-clients_.
     5306   define buffer buf_temp-firm_ for temp-firm_.
     5307   define buffer buf_temp-person_ for temp-person_.
     5308   define buffer buf_temp-fin-schet_ for temp-fin-schet_.
     5309   define buffer buf_temp-staff_ for temp-staff_.
     5310   define buffer buf_clients for ub.clients.
     5311   define buffer buf_fin-schet for ub.fin-schet.
     5312   define buffer buf_staff for ub.staff.
     5313   define buffer buf_sysconf for ub.sysconf.
     5314   define buffer buf_firm for ub.firm.
     5315   define buffer buf_person for ub.person.
     5316   define buffer buf_temp_contract for temp_contract.
     5317   define variable v-rid as recid no-undo .
     5318   define variable v-mode as character no-undo .
     5319   define variable v-work-place as character no-undo .
     5320   define variable v-today as date      no-undo.
     5321   define variable v-time  as integer   no-undo.
     5322   define variable v-err-mess as character no-undo .
     5323   define variable v-is-terminal as logical no-undo .
     5324   define variable v-status_ as character no-undo .
     5325   define variable v-not-found-fin-schet as logical no-undo .
     5326   define variable v-veto-man-doc as character no-undo .
     5327   define variable v-attr-type as character no-undo .
     5328   define variable v-deleted as logical no-undo .
     5329   define buffer buf_cli-grp for ub.cli-grp.
     5330   define buffer buf_dis-card for ub.dis-card.
     5331   main-block:
     5332   do transaction
     5333   on error  undo main-block, retry main-block
     5334   on stop   undo main-block, retry main-block
     5335   on endkey undo main-block, retry main-block
     5336   :
     5337     if retry then do:
     5338       empty temp-table buf_temp-clients_.
     5339       empty temp-table buf_temp-firm_.
     5340       empty temp-table buf_temp-person_.
     5341       empty temp-table buf_temp-fin-schet_.
     5342       empty temp-table buf_temp-staff_.
     5343       empty temp-table buf_temp_contract.
     5344             run write-log-and-file in p-log-handle (                 input 1                                          , input log-file-name                              , input 1                                          , input v-err-mess).
     5345        return error ''.
     5346     end.
     5347     else do:
     5348       v-is-terminal = no.
     5349       run cgrplib-is-terminal ( input p-grp-code
     5350                                ,output v-is-terminal) no-error.
     5351       if not v-is-terminal then do:
     5352         for each buf_cli-grp no-lock:
     5353           if buf_cli-grp.is-term = yes then do:
     5354             run cgrplib-is-terminal ( input buf_cli-grp.node-code
     5355                                     ,output v-is-terminal) no-error.
     5356             if v-is-terminal then do:
     5357               p-grp-code = buf_cli-grp.node-code.
     5358               leave.
     5359             end.
     5360           end.
     5361         end.
     5362       end.
     5363       if not v-is-terminal then do:
     5364         v-err-mess = substitute("Не найдено ни одной терминальной группы в справочнике групп клиентов, к которой можно приписать клиента").
     5365         undo main-block, retry main-block.
     5366       end.
     5367       buf_temp-clients_.grp-code = p-grp-code.
     5368       find first buf_clients share-lock where
     5369               buf_clients.obj-type = buf_temp-clients_.obj-type
     5370           and buf_clients.obj-code = buf_temp-clients_.obj-code no-error.
     5371       if not available buf_clients then do:
     5372         v-mode = 'ДОБАВЛЕНИЕ':U.
     5373         v-rid = ?.
     5374       end.
     5375       else do:
     5376         v-mode = 'ИЗМЕНЕНИЕ':U.
     5377         v-rid = recid( buf_clients).
     5378       end.
     5379       case buf_temp-clients_.obj-type:
     5380         when 'орг':U then do:
     5381           find first buf_temp-firm_ where
     5382                     buf_temp-firm_.firm-code = buf_temp-clients_.obj-code no-error.
     5383           if not available buf_temp-firm_ then do:
     5384             create buf_temp-firm_.
     5385             assign
     5386             buf_temp-firm_.firm-code = buf_temp-clients_.obj-code
     5387             .
     5388           end.
     5389           if v-mode = 'ИЗМЕНЕНИЕ':U then do:
     5390             find first buf_firm share-lock where
     5391                       buf_firm.firm-code = buf_temp-clients_.obj-code.
     5392             buffer-copy buf_firm except
     5393             firm-code city ind addres1 addres2 inn post-addr1 post-addr2 engl-name
     5394             to buf_temp-firm_.
     5395           end.
     5396           run ref/firm1.p (
     5397               input parparentproc
     5398               ,input-output v-rid
     5399               ,input v-mode
     5400               ,input "cli-all":U
     5401               ,input yes
     5402               ,input (if v-mode = 'ДОБАВЛЕНИЕ':U
     5403                       then (- abs(buf_temp-clients_.obj-code))
     5404                       else buf_clients.obj-code)
     5405               ,input 0
     5406               ,input buf_temp-clients_.obj-name
     5407               ,input 0
     5408               ,input buf_temp-clients_.PS
     5409               ,input buf_temp-clients_.grp-code
     5410               ,input buf_temp-firm_.addres1
     5411               ,input buf_temp-firm_.addres2
     5412               ,input buf_temp-firm_.city
     5413               ,input buf_temp-firm_.contact-psn
     5414               ,input buf_temp-firm_.director
     5415               ,input buf_temp-firm_.e-mail
     5416               ,input buf_temp-firm_.engl-name
     5417               ,input buf_temp-firm_.fax
     5418               ,input buf_temp-firm_.given-by
     5419               ,input buf_temp-firm_.ind
     5420               ,input buf_temp-firm_.inn
     5421               ,input yes
     5422               ,input buf_temp-firm_.is-pboul
     5423               ,input buf_temp-firm_.kpp
     5424               ,input buf_temp-firm_.okonh
     5425               ,input buf_temp-firm_.okpo
     5426               ,input buf_temp-firm_.passp-num
     5427               ,input buf_temp-firm_.passp-ser
     5428               ,input buf_temp-firm_.phone
     5429               ,input buf_temp-firm_.phone1-note
     5430               ,input buf_temp-firm_.post-addr1
     5431               ,input buf_temp-firm_.post-addr2
     5432               ,input buf_temp-firm_.post-city
     5433               ,input buf_temp-firm_.post-ind
     5434               ,input buf_temp-clients_.reg-code
     5435               ,input buf_temp-firm_.telex
     5436               ,input buf_temp-firm_.tobj-code
     5437               ,input no
     5438               ,input no
     5439             ) no-error .
     5440         end.
     5441         when 'чел':U then do:
     5442           find first buf_temp-person_ no-error.
     5443           if not available buf_temp-person_ then do:
     5444             create buf_temp-person_.
     5445             assign
     5446             buf_temp-person_.psn-code = buf_temp-person_.psn-code
     5447             .
     5448           end.
     5449           if v-mode = 'ИЗМЕНЕНИЕ':U then do:
     5450             find first buf_person share-lock where
     5451                       buf_person.psn-code = buf_temp-clients_.obj-code.
     5452             buffer-copy buf_person except
     5453             name1
     5454             name2
     5455             address
     5456             passp-ser
     5457             passp-num
     5458             given-by
     5459             city
     5460             ind
     5461             inn
     5462             gender
     5463             date-birth
     5464             position
     5465             to buf_temp-person_.
     5466           end.
     5467           run ref/person1.p (
     5468               input parparentproc
     5469             ,input this-procedure:handle
     5470             ,input-output v-rid
     5471             ,input v-mode
     5472             ,input "cli-all":U
     5473             ,input yes
     5474             ,input (if v-mode = 'ДОБАВЛЕНИЕ':U
     5475                     then (- abs(buf_temp-clients_.obj-code))
     5476                     else buf_clients.obj-code)
     5477             ,input 0
     5478             ,input buf_temp-clients_.obj-name
     5479             ,input 0
     5480             ,input buf_temp-clients_.PS
     5481             ,input buf_temp-clients_.grp-code
     5482             ,input buf_temp-person_.address
     5483             ,input buf_temp-person_.city
     5484             ,input buf_temp-person_.date-birth
     5485             ,input buf_temp-person_.e-mail
     5486             ,input buf_temp-person_.fax
     5487             ,input buf_temp-person_.firm-code
     5488             ,input buf_temp-person_.firm-name
     5489             ,input buf_temp-person_.gender
     5490             ,input buf_temp-person_.given-by
     5491             ,input buf_temp-person_.ind
     5492             ,input buf_temp-person_.inn
     5493             ,input yes
     5494             ,input buf_temp-person_.is-pboul
     5495             ,input buf_temp-person_.kpp
     5496             ,input buf_temp-person_.name1
     5497             ,input buf_temp-person_.name2
     5498             ,input buf_temp-person_.okonh
     5499             ,input buf_temp-person_.okpo
     5500             ,input buf_temp-person_.passp-num
     5501             ,input buf_temp-person_.passp-ser
     5502             ,input buf_temp-person_.phone1
     5503             ,input buf_temp-person_.phone1-note
     5504             ,input buf_temp-person_.position
     5505             ,input buf_temp-person_.post-box
     5506             ,input buf_temp-person_.post-address
     5507             ,input buf_temp-person_.post-city
     5508             ,input buf_temp-person_.post-ind
     5509             ,input buf_temp-clients_.reg-code
     5510             ,input no
     5511             ,input no
     5512             ) no-error .
     5513         end.
     5514       end case.
     5515       if error-status :error then do:
     5516         v-err-mess = substitute("Запись &1: Ошибка при сохранении clients &2&3&4&5&4&6"
     5517                                   , p-line-num
     5518                                   , buf_temp-clients_.obj-type
     5519                                   , buf_temp-clients_.obj-code
     5520                                   , chr(10)
     5521                                   , error-status:get-message(1)
     5522                                   , return-value ).
     5523         undo main-block, retry main-block.
     5524       end.
     5525       if buf_temp-clients_.obj-type = 'орг':U
     5526       and (buf_temp-firm_.nds-serries <> 0
     5527       or buf_temp-firm_.nds-number <> 0
     5528       or buf_temp-firm_.nds-date <> ?) then do:
     5529         run clntattr-write in this-procedure (
     5530                                                 input buf_temp-clients_.obj-type
     5531                                                ,input buf_temp-clients_.obj-code
     5532                                                ,input 'vat-register':U
     5533                                                ,input substitute("&2&1&3&1&4"
     5534                                                                  , chr(4)
     5535                                                                  , string(buf_temp-firm_.nds-serries, "99999")
     5536                                                                  , string(buf_temp-firm_.nds-number, "9999999")
     5537                                                                  , (if buf_temp-firm_.nds-date = ?
     5538                                                                     then chr(63)
     5539                                                                     else string(buf_temp-firm_.nds-date, "99/99/9999" )
     5540                                                                    )
     5541                                                                   )
     5542                                                ) no-error.
     5543         if error-status:error then do:
     5544         v-err-mess = substitute("Запись &1: Ошибка при сохранении атрибута &7 clients &2&3&4&5&4&6&7"
     5545                                   , p-line-num
     5546                                   , buf_temp-clients_.obj-type
     5547                                   , buf_temp-clients_.obj-code
     5548                                   , chr(10)
     5549                                   , error-status:get-message(1)
     5550                                   , return-value
     5551                                   , 'vat-register':U
     5552                                   ).
     5553         undo main-block, retry main-block.
     5554       end.
     5555       end.
     5556       run clntattr-value in this-procedure (
     5557                                                input  buf_temp-clients_.obj-type
     5558                                               ,input  buf_temp-clients_.obj-code
     5559                                               ,input  'veto-man-doc':U
     5560                                               ,output v-veto-man-doc
     5561                                               ,output v-attr-type
     5562                                               ) .
     5563       if v-veto-man-doc <> buf_temp-clients_.vetoManDoc
     5564       and buf_temp-clients_.vetoManDoc <> ''
     5565       then do:
     5566         run clntattr-write in this-procedure (
     5567                                                 input buf_temp-clients_.obj-type
     5568                                                ,input buf_temp-clients_.obj-code
     5569                                                ,input 'veto-man-doc':U
     5570                                                ,input buf_temp-clients_.vetoManDoc
     5571                                                ) no-error.
     5572         if error-status:error then do:
     5573           v-err-mess = substitute("Запись &1: Ошибка при сохранении атрибута &7 clients &2&3&4&5&4&6&7"
     5574                                     , p-line-num
     5575                                     , buf_temp-clients_.obj-type
     5576                                     , buf_temp-clients_.obj-code
     5577                                     , chr(10)
     5578                                     , error-status:get-message(1)
     5579                                     , return-value
     5580                                     , 'veto-man-doc':U
     5581                                     ).
     5582           undo main-block, retry main-block.
     5583         end.
     5584       end.
     5585       if v-veto-man-doc <> ''
     5586       and buf_temp-clients_.vetoManDoc = ''
     5587       then do:
     5588         run clntattr-delete in this-procedure  (
     5589                                                      input   buf_temp-clients_.obj-type
     5590                                                     ,input   buf_temp-clients_.obj-code
     5591                                                     ,input   'veto-man-doc':U
     5592                                                     ,output  v-deleted
     5593                                                     ) no-error.
     5594         if error-status:error then do:
     5595           v-err-mess = substitute("Запись &1: Ошибка при удалении атрибута &7 clients &2&3&4&5&4&6&7"
     5596                                     , p-line-num
     5597                                     , buf_temp-clients_.obj-type
     5598                                     , buf_temp-clients_.obj-code
     5599                                     , chr(10)
     5600                                     , error-status:get-message(1)
     5601                                     , return-value
     5602                                     , 'veto-man-doc':U
     5603                                     ).
     5604           undo main-block, retry main-block.
     5605         end.
     5606       end.
     5607       find first buf_clients where
     5608                 recid(buf_clients) = v-rid.
     5609       if buf_temp-clients_.stts <>  buf_clients.stts
     5610       then do:
     5611         run ref/clients2.p ( input parparentproc
     5612                             ,input recid(buf_clients)
     5613                             ,input buf_temp-clients_.stts
     5614                             ,input yes
     5615                             ,input no
     5616                             ,input '':U
     5617                             ,input '':U
     5618                             ,input '':U
     5619                             ) no-error .
     5620         if error-status:error then do:
     5621           v-err-mess = substitute("Запись &1: Ошибка при логическом удалении clients &2&3&4&5&4&6"
     5622                                     , p-line-num
     5623                                     , buf_temp-clients_.obj-type
     5624                                     , buf_temp-clients_.obj-code
     5625                                     , chr(10)
     5626                                     , error-status:get-message(1)
     5627                                     , return-value ).
     5628           undo main-block, retry main-block.
     5629         end.
     5630       end.
     5631       v-not-found-fin-schet = yes.
     5632       for each buf_temp-fin-schet_ no-lock where
     5633               buf_temp-fin-schet_.cli-type = buf_temp-clients_.obj-type
     5634           and buf_temp-fin-schet_.cli-code = buf_temp-clients_.obj-code
     5635       on error  undo main-block, retry main-block
     5636       on stop   undo main-block, retry main-block
     5637       on endkey undo main-block, retry main-block
     5638       :
     5639         v-not-found-fin-schet = no.
     5640         for each buf_sysconf no-lock:
     5641           run proc-delete-all-fs in this-procedure (  input p-line-num
     5642                                                     , input buf_sysconf.host-code
     5643                                                     , buffer buf_temp-clients_
     5644                                                     , input buf_temp-fin-schet_.code-bank
     5645                                                     , input buf_temp-fin-schet_.r-schet) no-error.
     5646               if error-status:error then do:
     5647             v-err-mess = return-value .
     5648                 undo main-block, retry main-block.
     5649               end.
     5650           find first buf_fin-schet share-lock where
     5651                     buf_fin-schet.host-code = buf_sysconf.host-code
     5652                 and buf_fin-schet.cli-type = buf_temp-fin-schet_.cli-type
     5653                 and buf_fin-schet.cli-code = buf_temp-fin-schet_.cli-code
     5654                 and buf_fin-schet.code-bank = buf_temp-fin-schet_.code-bank
     5655                 and buf_fin-schet.r-schet = buf_temp-fin-schet_.r-schet no-error.
     5656           if available buf_fin-schet then do:
     5657             v-mode = 'ИЗМЕНЕНИЕ':U.
     5658             v-rid = recid(buf_fin-schet).
     5659           end.
     5660           else do:
     5661             v-mode = 'ДОБАВЛЕНИЕ':U.
     5662             v-rid = ?.
     5663           end.
     5664           run ref/finscht1.p (
     5665            input-output v-rid
     5666           ,input v-mode
     5667           ,input yes
     5668           ,input ""
     5669           ,input buf_sysconf.host-code
     5670           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then 0 else buf_fin-schet.code-schet)
     5671           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.c-schet)
     5672           ,input buf_temp-fin-schet_.cli-type
     5673           ,input buf_temp-fin-schet_.cli-code
     5674           ,input buf_temp-fin-schet_.code-bank
     5675           ,input buf_temp-fin-schet_.curr-code
     5676           ,INPUT (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.dop1) + (if buf_temp-fin-schet_.cli-code  >= 100000000
     5677                                                                              and buf_temp-fin-schet_.cli-code  < 299999999
     5678                                                                              then (chr(4) + string(buf_temp-fin-schet_.cli-code ))
     5679                                                                              else '')
     5680           ,INPUT (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.dop2)
     5681           ,input buf_temp-fin-schet_.r-schet
     5682           ,input (if v-mode = 'ДОБАВЛЕНИЕ':U then '' else buf_fin-schet.ps)
     5683           )
     5684           no-error.
     5685           if error-status :error then do:
     5686             v-err-mess = substitute("Запись &1: Ошибка при сохранении fin-schet  для фирмы &7&2&3&4&5&4&6"
     5687                                       , p-line-num
     5688                                       , buf_temp-clients_.obj-type
     5689                                       , buf_temp-clients_.obj-code
     5690                                       , chr(10)
     5691                                       , error-status:get-message(1)
     5692                                       , return-value
     5693                                       , buf_sysconf.host-code
     5694                                       ).
     5695             undo main-block, retry main-block.
     5696           end.
     5697           find first buf_fin-schet share-lock where
     5698                     recid(buf_fin-schet) = v-rid.
     5699           if buf_fin-schet.status_ = 'удал':U then do:
     5700             v-status_ = 'тек':U.
     5701             run ref/finscht2.p ( input recid(buf_fin-schet)
     5702                                 ,input yes
     5703                                 ,input (if buf_fin-schet.cli-code >= 100000000
     5704                                         and buf_fin-schet.cli-code < 299999999
     5705                                         then "no-check"
     5706                                         else '')
     5707                                 ,input-output v-status_) no-error.
     5708             if error-status:error then do:
     5709               v-err-mess = substitute("Запись &1: Ошибка при восстановлении логически удаленного р/с &8 при получении нового для &7&2&3&4&5&4&6"
     5710                                         , p-line-num
     5711                                         , buf_temp-clients_.obj-type
     5712                                         , buf_temp-clients_.obj-code
     5713                                         , chr(10)
     5714                                         , error-status:get-message(1)
     5715                                         , return-value
     5716                                         , buf_sysconf.host-code
     5717                                         , buf_fin-schet.r-schet
     5718                                         ).
     5719               undo main-block, retry main-block.
     5720             end.
     5721           end.
     5722         end.
     5723       end.
     5724       if v-not-found-fin-schet then do:
     5725         for each buf_sysconf no-lock:
     5726           run proc-delete-all-fs in this-procedure (  input p-line-num
     5727                                                     , input buf_sysconf.host-code
     5728                                                     , buffer buf_temp-clients_
     5729                                                     , input 0
     5730                                                     , input "nnn") no-error.
     5731           if error-status:error then do:
     5732             v-err-mess = return-value .
     5733             undo main-block, retry main-block.
     5734           end.
     5735         end.
     5736       end.
     5737       if v-mode = 'ДОБАВЛЕНИЕ':U
     5738       and buf_temp-clients_.obj-code >= 100000000
     5739       and buf_temp-clients_.obj-code <= 199999999
     5740       then do:
     5741         define variable v-int-ok as integer no-undo .
     5742         run cur-time in this-procedure ( output v-today, output v-time).
     5743         create buf_temp_contract.
     5744         assign
     5745         buf_temp_contract.contract-code = buf_temp-clients_.obj-code
     5746         buf_temp_contract.contract-date = v-today
     5747         buf_temp_contract.exch-code     = 0
     5748         .
     5749         run utl/ora-i405.p (
     5750             input parparentproc ,
     5751             input this-procedure ,
     5752             input table temp_contract ,
     5753             input table temp_contract-specif ,
     5754             output v-int-ok
     5755             ) no-error .
     5756         if error-status:error then do:
     5757           v-err-mess = substitute("Запись &1: Ошибка при задании договора по &2&3&4&5&4&6"
     5758                                     , p-line-num
     5759                                     , buf_temp-clients_.obj-type
     5760                                     , buf_temp-clients_.obj-code
     5761                                     , chr(10)
     5762                                     , error-status:get-message(1)
     5763                                     , return-value
     5764                                     ).
     5765            undo main-block, retry main-block.
     5766         end.
     5767       end.
     5768       if not (buf_temp-clients_.obj-type = 'маг':U or buf_temp-clients_.obj-type = 'скл':U)
     5769       then do:
     5770         for each buf_dis-card where
     5771                 buf_dis-card.cli-type = buf_temp-clients_.obj-type
     5772             AND buf_dis-card.cli-code = buf_temp-clients_.obj-code:
     5773           run fill-dc-list in p-cont-handle ( buffer buf_Dis-card) .
     5774         end.
     5775       end.
     5776     end.
     5777   end.
     5778   end procedure.
     5779   procedure proc-delete-all-fs :
     5780   define input parameter p-line-num as integer no-undo .
     5781   define input parameter p-host-code as integer no-undo .
     5782   define parameter buffer buf_temp-clients_ for temp-clients_.
     5783   define input parameter p-code-bank as integer no-undo .
     5784   define input parameter p-r-schet as character no-undo .
     5785   define buffer buf_fin-schet  for ub.fin-schet.
     5786   define buffer buf_sysconf for ub.sysconf.
     5787   define variable v-status_ as character no-undo .
     5788   define variable v-err-mess as character no-undo .
     5789   main-block:
     5790   do
     5791   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5792   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     5793   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     5794   :
     5795     _fs:
     5796     for each buf_fin-schet share-lock where
     5797               buf_fin-schet.host-code = p-host-code
     5798           and buf_fin-schet.cli-type = buf_temp-clients_.obj-type
     5799           and buf_fin-schet.cli-code = buf_temp-clients_.obj-code
     5800     on error  undo main-block, retry main-block
     5801     on stop   undo main-block, retry main-block
     5802     on endkey undo main-block, retry main-block:
     5803       if buf_fin-schet.r-schet = p-r-schet
     5804       and buf_fin-schet.code-bank = p-code-bank
     5805       then next _fs.
     5806       if buf_fin-schet.status_ = 'тек':U then do:
     5807         v-status_ = 'удал':U.
     5808         run ref/finscht2.p ( input recid(buf_fin-schet)
     5809                             ,input yes
     5810                             ,input "no-check"
     5811                             ,input-output v-status_) no-error.
     5812         if error-status:error then do:
     5813           v-err-mess = substitute("Запись &1: Ошибка при логическом удалении р/с &8 при получении нового для &7&2&3&4&5&4&6"
     5814                                     , p-line-num
     5815                                     , buf_temp-clients_.obj-type
     5816                                     , buf_temp-clients_.obj-code
     5817                                     , chr(10)
     5818                                     , error-status:get-message(1)
     5819                                     , return-value
     5820                                     , p-host-code
     5821                                     , buf_fin-schet.r-schet
     5822                                     ).
     5823           undo main-block, return error v-err-mess.
     5824         end.
     5825       end.
     5826     end.
     5827   end.
     5828   end procedure.
     5829   procedure pcall-log-file :
     5830   define input  parameter p-message as character no-undo .
     5831     do
     5832     on error undo, return error return-value
     5833     :
     5834       run write-log-and-file in p-log-handle (
     5835             input 1
     5836           , input log-file-name
     5837           , input 1
     5838           , input p-message ) .
     5839     end.
     5840   end procedure.
