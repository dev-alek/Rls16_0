     3923   procedure xmlchar-encode :
     3924   define input parameter p-in-string      as character        no-undo.
     3925   define output parameter p-out-string    as character        no-undo.
     3926       define variable v-position      as integer      no-undo.
     3927       define variable v-current-char  as character    no-undo.
     3928   do
     3929   on error undo, return error
     3930   :
     3931       assign
     3932           p-out-string = "":U
     3933       .
     3934       case p-in-string
     3935       :
     3936           when ?
     3937           then do:
     3938               assign
     3939                   p-out-string = "?":U
     3940               .
     3941           end.
     3942           when "?":U
     3943           then do:
     3944               assign
     3945                   p-out-string = "&#63;":U
     3946               .
     3947           end.
     3948           otherwise do:
     3949               do v-position = 1 to length( p-in-string )
     3950               :
     3951                   assign
     3952                       v-current-char = substring( p-in-string, v-position, 1 )
     3953                   .
     3954                   case v-current-char
     3955                   :
     3956                       when "&":U
     3957                       then do:
     3958                           assign
     3959                               p-out-string = p-out-string + "&amp;":U
     3960                           .
     3961                       end.
     3962                       when ">":U
     3963                       then do:
     3964                           assign
     3965                               p-out-string = p-out-string + "&gt;":U
     3966                           .
     3967                       end.
     3968                       when "<":U
     3969                       then do:
     3970                           assign
     3971                               p-out-string = p-out-string + "&lt;":U
     3972                           .
     3973                       end.
     3974                       when "'":U
     3975                       then do:
     3976                           assign
     3977                               p-out-string = p-out-string + "&apos;":U
     3978                           .
     3979                       end.
     3980                       when '"':U
     3981                       then do:
     3982                           assign
     3983                               p-out-string = p-out-string + "&quot;":U
     3984                           .
     3985                       end.
     3986                       when chr(1)
     3987                       then do:
     3988                           assign
     3989                               p-out-string = p-out-string + "":U
     3990                           .
     3991                       end.
     3992                       when chr(2)
     3993                       then do:
     3994                           assign
     3995                               p-out-string = p-out-string + "":U
     3996                           .
     3997                       end.
     3998                       when chr(3)
     3999                       then do:
     4000                           assign
     4001                               p-out-string = p-out-string + "":U
     4002                           .
     4003                       end.
     4004                       when chr(4)
     4005                       then do:
     4006                           assign
     4007                               p-out-string = p-out-string + "":U
     4008                           .
     4009                       end.
     4010                       when chr(5)
     4011                       then do:
     4012                           assign
     4013                               p-out-string = p-out-string + "":U
     4014                           .
     4015                       end.
     4016                       when chr(6)
     4017                       then do:
     4018                           assign
     4019                               p-out-string = p-out-string + "":U
     4020                           .
     4021                       end.
     4022                       when chr(7)
     4023                       then do:
     4024                           assign
     4025                               p-out-string = p-out-string + "":U
     4026                           .
     4027                       end.
     4028                       when chr(8)
     4029                       then do:
     4030                           assign
     4031                               p-out-string = p-out-string + "":U
     4032                           .
     4033                       end.
     4034                       when chr(9)
     4035                       then do:
     4036                           assign
     4037                               p-out-string = p-out-string + "":U
     4038                           .
     4039                       end.
     4040                       when chr(29)
     4041                       then do:
     4042                           assign
     4043                               p-out-string = p-out-string + "":U
     4044                           .
     4045                       end.
     4046                       when chr(10)
     4047                       then do:
     4048                           assign
     4049                               p-out-string = p-out-string + "&#10;":U
     4050                           .
     4051                       end.
     4052                       when chr(13)
