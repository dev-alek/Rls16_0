     4179   procedure xmlchar-decode :
     4180   define input parameter p-in-string      as character        no-undo.
     4181   define output parameter p-out-string    as character        no-undo.
     4182       define variable v-position      as integer      no-undo.
     4183       define variable v-last-position as integer      no-undo.
     4184       define variable v-temp-integer  as integer      no-undo.
     4185       define variable v-current-char  as character    no-undo.
     4186       define variable v-next-char     as character    no-undo.
     4187       define variable v-success       as logical      no-undo.
     4188   do
     4189   on error undo, return error
     4190   :
     4191       assign
     4192           p-out-string = "":U
     4193           v-position   = 0
     4194       .
     4195       replace-cycle:
     4196       do while yes
     4197       on error undo, return error
     4198       :
     4199           assign
     4200               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4201           .
     4202           if v-last-position <= v-position
     4203           then do:
     4204               if v-position = 0
     4205               then do:
     4206                   assign
     4207                       p-out-string = p-in-string
     4208                   .
     4209               end.
     4210               else do:
     4211                   assign
     4212                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4213                   .
     4214               end.
     4215               leave replace-cycle.
     4216           end.
     4217           else do:
     4218               assign
     4219                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4220                   v-position      = v-last-position
     4221                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4222               .
     4223               if v-current-char = "#":U
     4224               then do:
     4225                   assign
     4226                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4227                   .
     4228                   if v-last-position > 0
     4229                   then do:
     4230                       run xmlchar-read-integer in this-procedure
     4231                        (
     4232                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4233                           , output v-temp-integer
     4234                           , output v-success
     4235                       ).
     4236                       if v-success = yes
     4237                       and v-temp-integer >= 1
     4238                       and v-temp-integer <= 255
     4239                       then do:
     4240                           assign
     4241                               p-out-string = p-out-string + chr( v-temp-integer )
     4242                               v-position   = v-last-position + 1
     4243                           .
     4244                       end.
     4245                       else do:
     4246                           assign
     4247                               p-out-string = p-out-string + "&":U
     4248                               v-position   = v-position   + 1
     4249                           .
     4250                       end.
     4251                   end.
     4252                   else do:
     4253                       assign
     4254                           p-out-string = p-out-string + "&":U
     4255                           v-position   = v-position   + 1
     4256                       .
     4257                   end.
     4258               end.
     4259               else do:
     4260                   case substring( p-in-string, v-position + 1, 3 )
     4261                   :
     4262                       when "lt;":U
     4263                       then do:
     4264                           assign
     4265                               p-out-string = p-out-string + "<":U
     4266                               v-position   = v-position   + 3
     4267                           .
     4268                       end.
     4269                       when "gt;":U
     4270                       then do:
     4271                           assign
     4272                               p-out-string = p-out-string + ">":U
     4273                               v-position   = v-position   + 3
     4274                           .
     4275                       end.
     4276                       otherwise do:
     4277                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4278                           then do:
     4279                               assign
     4280                                   p-out-string = p-out-string + "&":U
     4281                                   v-position   = v-position   + 4
     4282                               .
     4283                           end.
     4284                           else do:
     4285                               case substring( p-in-string, v-position + 1, 5 )
     4286                               :
     4287                                   when "quot;":U
     4288                                   then do:
     4289                                       assign
     4290                                           p-out-string = p-out-string + '"':U
     4291                                           v-position   = v-position   + 5
     4292                                       .
     4293                                   end.
     4294                                   when "apos;":U
     4295                                   then do:
     4296                                       assign
     4297                                           p-out-string = p-out-string + "'":U
     4298                                           v-position   = v-position   + 5
     4299                                       .
     4300                                   end.
     4301                                   otherwise do:
     4302                                       assign
     4303                                           p-out-string = p-out-string + "&":U
     4304                                       .
     4305                                   end.
     4306                               end case.
     4307                           end.
     4308                       end.
     4309                   end case.
     4310               end.
     4311           end.
     4312       end.
     4313   end.
     4314   end .
     4315   procedure xmlchar-read-integer :
     4316   define input parameter p-input-string      as character        no-undo.
     4317   define output parameter p-output-integer   as integer          no-undo.
     4318   define output parameter p-success       as logical          no-undo.
     4319   do
     4320   on error undo, return error
     4321   :
     4322       assign
     4323           p-output-integer = integer( p-input-string )
     4324       no-error.
     4325       if error-status :error
     4326       then do:
     4327           assign
     4328               p-success           = no
     4329               p-output-integer    = 0
     4330           .
     4331       end.
     4332       else do:
     4333           assign
     4334               p-success           = yes
     4335           .
     4336       end.
     4337   end.
     4338   end.
     4339   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4340   define temp-table temp-rel-handle no-undo
     4341   field dh as handle
     4342   field ii as integer
     4343   field active_ as logical
     4344   field child-buffer_ as character
     4345   field parent-buffer_ as character
     4346   field child-buffer-handle as handle
     4347   field parent-buffer-handle as handle
     4348   field name_ as character
     4349   field nested_ as logical
     4350   field relation-fields_ as character
     4351   field reposition_ as logical
     4352   field type_ as character
     4353   field query_ as handle
     4354   field where-string_ as character
     4355   field tbl-handle_ as handle
