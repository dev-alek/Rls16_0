     2655       field recName       as character
     2656       field recLevel      as integer
     2657       field fldName       as character
     2658       field fldOpenLine   as integer
     2659       field fldCloseLine  as integer
     2660       field closed        as logical
     2661       index pi is primary unique
     2662           recName
     2663           recLevel
     2664           fldName
     2665       index fn
     2666           fldName
     2667       index cl
     2668           closed
     2669   .
     2670   define temp-table temp_xmllib_rec no-undo
     2671       field rec-key       as integer
     2672       field recLevel      as integer
     2673       field recOpenLine   as integer
     2674       field recCloseLine  as integer
     2675       field recName       as character
     2676       field closed        as logical
     2677       index pi is primary unique
     2678           rec-key
     2679       index nm
     2680           recName
     2681           closed
     2682           rec-key
     2683       index cl
     2684           closed
     2685       index rlv
     2686           recName
     2687           recLevel
     2688           closed
     2689           rec-key
     2690   .
     2691   define temp-table temp_xmllib_rec-fld no-undo
     2692       field fld-key       as integer
     2693       field rec-key       as integer
     2694       field fldOpenLine   as integer
     2695       field fldCloseLine  as integer
     2696       field fldName       as character
     2697       field fldValue      as character
     2698       field closed        as logical
     2699       index pi is primary unique
     2700           fld-key
     2701       index nm
     2702           rec-key
     2703           fldName
     2704           closed
     2705           fld-key
     2706       index cl
     2707           closed
     2708   .
     2709   define variable v-xmllib-rec-key            as integer      no-undo .
     2710   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     2711   define variable v-xmllib-dirname            as character    no-undo .
     2712   define variable v-xmllib-filename           as character    no-undo .
     2713   define variable v-xmllib-log-filename       as character    no-undo .
     2714   define variable v-xmllib-log-handle         as handle       no-undo .
     2715   define variable v-xmllib-log-proc-name      as character    no-undo .
     2716   define variable v-xmllib-error-status       as logical      no-undo .
     2717   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     2718   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     2719   define variable v-xmllib-codepage-convert   as logical      no-undo .
     2720   define variable v-xmllib-codepage-source    as character    no-undo .
     2721   define variable v-xmllib-codepage-target    as character    no-undo .
     2722   procedure xmllib-clear-parse-data :
     2723   do
     2724   on error undo, return error
     2725   :
     2726       empty temp-table temp_xmllib_rec-list.
     2727       empty temp-table temp_xmllib_rec-fld-list.
     2728       empty temp-table temp_xmllib_rec.
     2729       empty temp-table temp_xmllib_rec-fld.
     2730   end.
     2731   end procedure.
     2732   procedure xmllib-add-rec-fld :
     2733   define input parameter p-rec-name       as character        no-undo.
     2734   define input parameter p-rec-fld-name   as character        no-undo.
     2735       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2736       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2737   do
     2738   for buf_rec-list
     2739     , buf_rec-fld-list
     2740   on error undo, return error
     2741   :
     2742       find first buf_rec-list
     2743            where buf_rec-list.recName = p-rec-name
     2744       no-error.
     2745       if not available buf_rec-list
     2746       then do:
     2747           create buf_rec-list.
     2748           assign
     2749               buf_rec-list.recName        = p-rec-name
     2750               buf_rec-list.recOpenLine    = 0
     2751               buf_rec-list.recCloseLine   = 0
     2752               buf_rec-list.closed         = yes
     2753           .
     2754       end.
     2755       find first buf_rec-fld-list
     2756            where buf_rec-fld-list.recName = p-rec-name
     2757              and buf_rec-fld-list.fldName = p-rec-fld-name
     2758       no-error.
     2759       if not available buf_rec-fld-list
     2760       then do:
     2761           create buf_rec-fld-list.
     2762           assign
     2763               buf_rec-fld-list.recName        = p-rec-name
     2764               buf_rec-fld-list.fldName        = p-rec-fld-name
     2765               buf_rec-fld-list.fldOpenLine    = 0
     2766               buf_rec-fld-list.fldCloseLine   = 0
     2767               buf_rec-fld-list.closed         = yes
     2768           .
     2769       end.
     2770   end.
     2771   end procedure.
     2772   procedure xmllib-tag-open:
     2773   define input parameter v-tag-level  as integer      no-undo.
     2774   define input parameter v-tag-name   as character    no-undo.
     2775   define input parameter v-tag-value  as character    no-undo.
     2776   do
     2777   on error undo, return error
     2778   :
     2779       assign
     2780           v-tag-name = trim( v-tag-name )
     2781       .
     2782       put stream stmXMLOut unformatted
     2783           substitute( "&1&2<&3&4&5>"
     2784               , chr(10)
     2785               , fill(" ", 4 * v-tag-level)
     2786               , v-tag-name
     2787               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     2788               , v-tag-value
     2789           )
     2790       .
     2791   end.
     2792   end procedure.
     2793   procedure xmllib-tag-put:
     2794   define input parameter v-tag-level      as integer      no-undo.
     2795   define input parameter v-tag-name       as character    no-undo.
     2796   define input parameter v-tag-value      as character    no-undo.
     2797   define input parameter v-empty-mode     as integer      no-undo.
     2798   do
     2799   on error undo, return error
     2800   :
     2801       assign
     2802           v-tag-name = trim( v-tag-name )
     2803       .
     2804       if  v-empty-mode = 1
     2805       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     2806       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     2807       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     2808       then do:
     2809           run xmlchar-encode in this-procedure (
     2810                 input v-tag-value
     2811               , output v-tag-value
     2812           ).
     2813           put stream stmXMLOut unformatted
     2814               substitute( "&1&2<&3>&4</&3>"
     2815                   , chr(10)
     2816                   , fill(" ":U, 4 * v-tag-level)
     2817                   , v-tag-name
     2818                   , v-tag-value
     2819               )
     2820           .
     2821       end.
     2822   end.
     2823   end procedure.
     2824   procedure xmllib-tag-put-null :
     2825   define input parameter p-tag-level  as integer      no-undo.
     2826   define input parameter p-tag-name   as character    no-undo.
     2827   do
     2828   on error undo, return error
     2829   :
     2830       assign
     2831           p-tag-name = trim( p-tag-name )
     2832       .
     2833       put stream stmXMLOut unformatted
     2834           substitute( '&1&2<&3 nil="true" /&3>'
     2835               , chr(10)
     2836               , fill(" ":U, 4 * p-tag-level)
     2837               , p-tag-name
     2838           )
     2839       .
     2840   end.
     2841   end procedure.
     2842   procedure xmllib-tag-close:
     2843   define input parameter v-tag-level as integer      no-undo.
     2844   define input parameter v-tag-name  as character    no-undo.
     2845   do
     2846   on error undo, return error
     2847   :
     2848       assign
     2849           v-tag-name = trim( v-tag-name )
     2850       .
     2851       put stream stmXMLOut unformatted
     2852           substitute( "&1&2</&3>"
     2853               , chr(10)
     2854               , fill( " ":U, 4 * v-tag-level)
     2855               , v-tag-name
     2856           )
     2857       .
     2858   end.
     2859   end procedure.
     2860   procedure xmllib-write-log:
     2861   define input parameter v-filename   as character    no-undo.
     2862   define input parameter v-log-level  as integer      no-undo.
     2863   define input parameter v-out-string as character    no-undo.
     2864   do
     2865   on error undo, return error
     2866   :
     2867       output stream stmXMLLog to value( v-filename ) append.
     2868       put stream stmXMLLog unformatted
     2869           chr(10)
     2870       .
     2871       put stream stmXMLLog unformatted
     2872           ( if v-log-level = 0
     2873             or v-out-string = "&DLine":U
     2874             or v-out-string = "&Line":U
     2875             then "":U
     2876             else cur-time-string-sec() + " ":U )
     2877       .
     2878       put stream stmXMLLog unformatted
     2879           ( if v-out-string = "&Line":U
     2880             then fill( "-":U, 80 )
     2881             else if v-out-string = "&DLine":U
     2882                  then fill( "=":U, 80 )
     2883                  else v-out-string )
     2884       .
     2885       output stream stmXMLLog close.
     2886   end.
     2887   end procedure.
     2888   procedure xmllib-write-edt:
     2889   define input parameter v-editor-handle    as handle       no-undo.
     2890   define input parameter v-log-level        as integer      no-undo.
     2891   define input parameter v-out-string       as character    no-undo.
     2892   do
     2893   on error undo, return error
     2894   :
     2895       if valid-handle ( v-editor-handle )
     2896       then do:
     2897           v-editor-handle :move-to-eof().
     2898           v-editor-handle :insert-string( ( if v-log-level = 0
     2899                                             or v-out-string = "&DLine":U
     2900                                             or v-out-string = "&Line":U
     2901                                             then "":U
     2902                                             else cur-time-string-sec() + " ":U
     2903                                         ) ).
     2904           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     2905                                             then fill( "-":U, 80 )
     2906                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     2907                                             else fill( " ":U, v-log-level) + v-out-string
     2908                                         ) ).
     2909           v-editor-handle :insert-string( chr(10) ).
     2910       end.
     2911   end.
     2912   end procedure.
     2913   procedure xmllib-show-cnt:
     2914   define input parameter v-fillin-handle     as handle   no-undo.
     2915   do
     2916   on error undo, return error
     2917   :
     2918       if valid-handle( v-fillin-handle )
     2919       then do:
     2920           assign
     2921               v-fillin-handle :visible = true
     2922           .
     2923       end.
     2924   end.
     2925   end procedure.
     2926   procedure xmllib-hide-cnt:
     2927   define input parameter v-fillin-handle     as handle   no-undo.
     2928   do
     2929   on error undo, return error
     2930   :
     2931       if valid-handle( v-fillin-handle )
     2932       then do:
     2933           assign v-fillin-handle :visible = false.
     2934       end.
     2935   end.
     2936   end procedure.
     2937   procedure xmllib-write-cnt:
     2938   define input parameter v-fillin-handle    as handle       no-undo.
     2939   define input parameter v-fillin-string    as character    no-undo.
     2940   do
     2941   on error undo, return error
     2942   :
     2943       if valid-handle( v-fillin-handle )
     2944       then do:
     2945           assign
     2946               v-fillin-handle :SCREEN-value = v-fillin-string
     2947           .
     2948       end.
     2949   end.
     2950   end procedure.
     2951   procedure xmllib-write-header:
     2952   define input parameter p-first-file     as logical      no-undo.
     2953   define input parameter p-xml-file-name  as character    no-undo.
     2954   define input parameter p-list-file-name as character    no-undo.
     2955   define input parameter p-file-number    as integer      no-undo.
     2956   define input parameter p-have-prev      as logical      no-undo.
     2957   define input parameter p-prev-filename  as character    no-undo.
     2958   define input parameter p-parameter-list as character    no-undo.
     2959       define variable v-counter    as integer        no-undo.
     2960   do
     2961   on error undo, return error
     2962   :
     2963       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2964       put stream stmXMLOut unformatted
     2965           "<?xml version='1.0' encoding='windows-1251'?>"
     2966       .
     2967       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2968       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2969       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2970       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2971       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2972       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2973       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2974       :
     2975           run xmllib-tag-put(
     2976                 input 1
     2977               , input entry( 2 * v-counter, p-parameter-list )
     2978               , input entry( 2 * v-counter + 1, p-parameter-list )
     2979               , input 0
     2980           ).
     2981       end.
     2982       run xmllib-tag-close( input 0, input "THheader" ).
     2983       output stream stmXMLOut close.
     2984       if p-list-file-name <> "":U
     2985       then do:
     2986           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2987           if p-first-file = yes
     2988           then do:
     2989               put stream stmXMLOut unformatted
     2990                   "<?xml version='1.0' encoding='windows-1251'?>"
     2991               .
     2992               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2993           end.
     2994           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2995           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2996           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2997           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2998           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2999           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     3000           :
     3001               run xmllib-tag-put(
     3002                   input 2
     3003                   , input entry( 2 * v-counter, p-parameter-list )
     3004                   , input entry( 2 * v-counter + 1, p-parameter-list )
     3005                   , input 0
     3006               ).
     3007           end.
     3008           run xmllib-tag-close( input 1, input "THfile" ).
     3009           output stream stmXMLOut close.
     3010       end.
     3011   end.
     3012   end procedure.
     3013   procedure xmllib-write-footer:
     3014   define input parameter p-last-file      as logical      no-undo.
     3015   define input parameter p-xml-file-name  as character    no-undo.
     3016   define input parameter p-list-file-name as character    no-undo.
     3017   define input parameter p-have-next      as logical      no-undo.
     3018   define input parameter p-next-file-name as character    no-undo.
     3019       define variable v-error-num     as integer           no-undo.
     3020   do
     3021   on error undo, return error
     3022   :
     3023       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     3024       if p-have-next = yes
     3025       then do:
     3026           run xmllib-tag-open( input 0, input "footer", "" ).
     3027           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     3028           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     3029           run xmllib-tag-close( input 0, input "footer" ).
     3030       end.
     3031       run xmllib-tag-close( input 0, input "root" ).
     3032       output stream stmXMLOut close.
     3033       run bge/os_copy.p (
     3034             input "M"
     3035           , input p-xml-file-name + "tmp"
     3036           , input p-xml-file-name + "xml"
     3037           , output v-error-num
     3038       ).
     3039       if p-last-file = yes
     3040       and p-list-file-name <> "":U
     3041       then do:
     3042           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     3043               run xmllib-tag-close( input 0, input "OpenXML" ).
     3044           output stream stmXMLOut close.
     3045           run bge/os_copy.p (
     3046                 input "M"
     3047               , input p-list-file-name + "tmp"
     3048               , input p-list-file-name + "xml":U
     3049               , output v-error-num
     3050           ).
     3051       end.
     3052   end.
     3053   end procedure.
     3054   procedure xmllib-filename :
     3055   define input parameter p-subdir             as character        no-undo.
     3056   define input parameter p-prefix             as character    no-undo.
     3057   define output parameter p-xml-file-name     as character    no-undo.
     3058   define output parameter p-log-file-name     as character    no-undo.
     3059   define output parameter p-list-file-name    as character    no-undo.
     3060       define variable v-home-dir  as character    no-undo.
     3061       define variable v-error-num as integer      no-undo.
     3062   do
     3063   on error undo, return error
     3064   :
     3065       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     3066       if v-home-dir = ?
     3067       then do:
     3068           message
     3069             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     3070             skip "Нет параметра oxml-dir в секции [OXML]."
     3071             skip(1)
     3072             skip "Обратитесь к администратору."
     3073           view-as alert-box error.
     3074           undo, return error .
     3075       end.
     3076       if p-subdir <> "":U
     3077       then do:
     3078           assign
     3079               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     3080           .
     3081       end.
     3082       run gbl/dir-cre.p (
     3083           input v-home-dir
     3084       ) no-error.
     3085       if error-status :error
     3086       then do:
     3087           message
     3088             skip "Неверно задан каталог экспорта в ini-файле."
     3089             skip "Не удаётся создать каталог, указанный параметром"
     3090             skip "oxml-dir в секции [OXML]."
     3091             skip(1)
     3092             skip "Обратитесь к администратору."
     3093           view-as alert-box error.
     3094           undo, return error .
     3095       end.
     3096       run bge/genfname.p (
     3097             input v-home-dir
     3098           , input p-prefix
     3099           , input ""
     3100           , input "xml"
     3101           , input "tmp"
     3102           , output p-xml-file-name
     3103       ).
     3104       assign
     3105           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     3106           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     3107           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     3108       .
     3109   end.
     3110   end procedure.
     3111   procedure xmllib-check-file-size :
     3112   define input parameter p-out-filename   as character    no-undo.
     3113   define output parameter p-is-big        as logical      no-undo.
     3114       define variable v-current-position    as integer        no-undo.
     3115   do
     3116   on error undo, return error
     3117   :
     3118       assign
     3119           v-current-position = seek( stmXMLOut )
     3120       .
     3121       if v-current-position / 1024 / 1024  >= 100
     3122       then do:
     3123           assign
     3124               p-is-big = yes
     3125           .
     3126       end.
     3127   end.
     3128   end procedure.
     3129   procedure xmllib-parse-file :
     3130   define input parameter p-full-filename      as character        no-undo.
     3131       define variable v-num-dirs              as integer      no-undo .
     3132       define variable v-str                   as character    no-undo .
     3133       define variable v-str-count             as int64        no-undo .
     3134   do
     3135   on error undo, return error
     3136   :
     3137       assign
     3138           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     3139           v-xmllib-error-status   = no
     3140       .
     3141       if v-num-dirs > 1
     3142       then do:
     3143           assign
     3144               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     3145               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     3146           .
     3147       end.
     3148       else do:
     3149           assign
     3150               v-xmllib-filename = p-full-filename
     3151               v-xmllib-dirname  = "":U
     3152           .
     3153       end.
     3154       if valid-handle(v-xmllib-prg-bar-handle)
     3155       then do:
     3156   if session :set-wait-state( "compiler" ) then.
     3157         input stream strXMLIn from value(p-full-filename) .
     3158         repeat
     3159         :
     3160           import stream strXMLIn unformatted v-str no-error .
     3161           assign
     3162             v-str-count = v-str-count + 1
     3163           .
     3164         end.
     3165         input stream strXMLIn close .
     3166   if session :set-wait-state( "" ) then.
     3167         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     3168         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     3169         run prg-bar_show in this-procedure .
     3170       end.
     3171       create sax-reader v-xmllib-sax-reader-handle.
     3172       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     3173       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     3174       if error-status :error
     3175       then do:
     3176           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3177                                                                       ,vss-workfile
     3178                                                                       ,vss-revision
     3179                                                                       ,vss-description
     3180                                                                       ,chr(10)
     3181                                                                       ,return-value
     3182                                                                       ,trim(error-status :get-message(1))
     3183                                                                       ,trim(error-status :get-message(2))
     3184                                                                       ,trim(error-status :get-message(3)))
     3185                                                     ).
     3186           undo, return error .
     3187       end.
     3188       if v-xmllib-error-status <> no
     3189       then do:
     3190           run xmllib-parse-error in this-procedure (
     3191               input "*** При обработке XML файла были ошибки."
     3192           ).
     3193           delete object v-xmllib-sax-reader-handle.
     3194       end.
     3195       delete object v-xmllib-sax-reader-handle.
     3196       if valid-handle(v-xmllib-prg-bar-handle)
     3197       then do:
     3198         run prg-bar_delete in this-procedure .
     3199       end.
     3200   end.
     3201   end procedure.
     3202   procedure xmllib-parse-progressive :
     3203   define input parameter p-full-filename      as character no-undo .
     3204   define input parameter p-pack-data          as memptr no-undo .
     3205   define input parameter p-parse-first        as logical no-undo .
     3206   define input parameter p-first-err          as logical no-undo .
     3207   define output parameter p-parse-status as integer no-undo .
     3208   define variable v-num-dirs              as integer no-undo .
     3209   define variable glog                    as logical no-undo .
     3210   define variable v-pack-size             as int64 no-undo .
     3211   do
     3212   on error undo, return error
     3213   :
     3214     if p-parse-first then do:
     3215       if valid-handle(v-xmllib-sax-reader-handle)
     3216       then do:
     3217       end.
     3218       assign
     3219           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     3220           v-xmllib-error-status   = no
     3221       .
     3222       if v-num-dirs > 1
     3223       then do:
     3224           assign
     3225               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     3226               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     3227           .
     3228       end.
     3229       else do:
     3230           assign
     3231               v-xmllib-filename = p-full-filename
     3232               v-xmllib-dirname  = "":U
     3233           .
     3234       end.
     3235       create sax-reader v-xmllib-sax-reader-handle.
     3236       v-pack-size = get-size (p-pack-data) .
     3237       if v-pack-size > 0 then
     3238         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     3239       else
     3240         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     3241       if error-status :error
     3242       or not glog
     3243       then do:
     3244         delete object v-xmllib-sax-reader-handle.
     3245         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3246                                                                     ,vss-workfile
     3247                                                                     ,vss-revision
     3248                                                                     ,vss-description
     3249                                                                     ,chr(10)
     3250                                                                     ,return-value
     3251                                                                     ,trim(error-status :get-message(1))
     3252                                                                     ,trim(error-status :get-message(2))
     3253                                                                     ,trim(error-status :get-message(3)) )
     3254                                                   ).
     3255         undo, return error .
     3256       end.
     3257       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     3258     end.
     3259     else do:
     3260       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     3261     end.
     3262     if error-status :error
     3263     then do:
     3264       delete object v-xmllib-sax-reader-handle.
     3265       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     3266                                                                   ,vss-workfile
     3267                                                                   ,vss-revision
     3268                                                                   ,vss-description
     3269                                                                   ,chr(10)
     3270                                                                   ,return-value
     3271                                                                   ,trim(error-status :get-message(1))
     3272                                                                   ,trim(error-status :get-message(2))
     3273                                                                   ,trim(error-status :get-message(3)) )
     3274                                                 ).
     3275       undo, return error .
     3276     end.
     3277     if v-xmllib-error-status <> no
     3278     then do:
     3279       run xmllib-parse-error in this-procedure (
     3280           input "*** При обработке XML файла были ошибки."
     3281       ).
     3282       if p-first-err then do:
     3283         delete object v-xmllib-sax-reader-handle.
     3284       end.
     3285       else do:
     3286         v-xmllib-error-status = no.
     3287       end.
     3288     end.
     3289     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     3290       p-parse-status = SAX-COMPLETE.
     3291       delete object v-xmllib-sax-reader-handle.
     3292       return '':U.
     3293     end.
     3294     else do:
     3295       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     3296       return '':U.
     3297     end.
     3298   end.
     3299   end procedure.
     3300   procedure StartElement :
     3301   define input parameter p-name-space     as character        no-undo.
     3302   define input parameter p-local-name     as character        no-undo.
     3303   define input parameter p-q-name         as character        no-undo.
     3304   define input parameter p-attributes     as handle           no-undo.
     3305       define buffer buf_rec             for temp_xmllib_rec.
     3306       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3307       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3308       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3309   do
     3310   for buf_rec
     3311     , buf_rec-fld
     3312     , buf_rec-list
     3313     , buf_rec-fld-list
     3314   on error undo, return error
     3315   :
     3316       if valid-handle(v-xmllib-prg-bar-handle)
     3317       then do:
     3318         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     3319       end.
     3320       find first buf_rec-list
     3321            where buf_rec-list.recName = p-q-name
     3322       no-error.
     3323       if available buf_rec-list
     3324       then do:
     3325           if buf_rec-list.closed = no
     3326           then do:
     3327               find first buf_rec-fld-list
     3328                    where buf_rec-fld-list.recName = buf_rec-list.recName
     3329                      and buf_rec-fld-list.fldName = p-q-name
     3330               no-error.
     3331               if available buf_rec-fld-list
     3332               and buf_rec-list.recName = buf_rec-fld-list.recName
     3333               then do:
     3334                   if buf_rec-fld-list.closed = no
     3335                   then do:
     3336                       run xmllib-parse-error in this-procedure (
     3337                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     3338                                           , p-q-name
     3339                                           , p-q-name
     3340                                           , buf_rec-fld-list.fldOpenLine
     3341                                           )
     3342                       ).
     3343                   end.
     3344                   else do:
     3345                       run xmllib-parse-rec-fld-open in this-procedure (
     3346                             input buf_rec-list.recName
     3347                           , input buf_rec-list.recLevel
     3348                           , input buf_rec-fld-list.fldName
     3349                       ).
     3350                       assign
     3351                           buf_rec-fld-list.closed         = no
     3352                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3353                           buf_rec-fld-list.fldCloseLine   = 0
     3354                       .
     3355                   end.
     3356               end.
     3357               else do:
     3358                   assign
     3359                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     3360                   .
     3361                   run xmllib-parse-rec-open in this-procedure (
     3362                         input buf_rec-list.recName
     3363                       , input buf_rec-list.recLevel
     3364                   ).
     3365                   assign
     3366                       buf_rec-list.closed         = no
     3367                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3368                       buf_rec-list.recCloseLine   = 0
     3369                   .
     3370               end.
     3371           end.
     3372           else do:
     3373               run xmllib-parse-rec-open in this-procedure (
     3374                     input buf_rec-list.recName
     3375                   , input buf_rec-list.recLevel
     3376               ).
     3377               assign
     3378                   buf_rec-list.closed         = no
     3379                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3380                   buf_rec-list.recCloseLine   = 0
     3381               .
     3382           end.
     3383       end.
     3384       else do:
     3385           open-record:
     3386           for each buf_rec-fld-list
     3387              where buf_rec-fld-list.fldName = p-q-name
     3388           :
     3389               find first buf_rec-list
     3390                    where buf_rec-list.recName = buf_rec-fld-list.recName
     3391                      and buf_rec-list.closed  = no
     3392               no-error.
     3393               if available buf_rec-list
     3394               then do:
     3395                   run xmllib-parse-rec-fld-open in this-procedure (
     3396                         input buf_rec-list.recName
     3397                       , input buf_rec-list.recLevel
     3398                       , input buf_rec-fld-list.fldName
     3399                   ).
     3400                   assign
     3401                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     3402                       buf_rec-fld-list.closed         = no
     3403                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     3404                       buf_rec-fld-list.fldCloseLine   = 0
     3405                   .
     3406                   leave open-record.
     3407               end.
     3408           end.
     3409       end.
     3410   end.
     3411   end procedure.
     3412   procedure Characters :
     3413   define input parameter p-char-data  as memptr.
     3414   define input parameter p-numchars   as integer.
     3415       define variable v-data-string    as character    no-undo.
     3416       define variable v-cp-utf8           as integer no-undo init 65001 .
     3417       define variable v-cp-windows1251    as integer no-undo init 1251 .
     3418       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     3419       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     3420       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     3421       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     3422   do
     3423   for buf_xmllib_rec
     3424     , buf_xmllib_rec-fld
     3425     , buf_xmllib_rec-list
     3426     , buf_xmllib_rec-fld-list
     3427   on error undo, return error
     3428   :
     3429       find first buf_xmllib_rec-list
     3430            where buf_xmllib_rec-list.closed = no
     3431       no-error.
     3432       if available buf_xmllib_rec-list
     3433       then do:
     3434           find first buf_xmllib_rec-fld-list
     3435                where buf_xmllib_rec-fld-list.closed = no
     3436           no-error.
     3437           if available buf_xmllib_rec-fld-list
     3438           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     3439           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     3440           then do:
     3441               find last buf_xmllib_rec
     3442                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     3443                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     3444                     and buf_xmllib_rec.closed   = no
     3445               use-index nm
     3446               no-error.
     3447               if available buf_xmllib_rec
     3448               then do:
     3449                   find last buf_xmllib_rec-fld
     3450                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     3451                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     3452                         and buf_xmllib_rec-fld.closed = no
     3453                   use-index nm
     3454                   no-error.
     3455                   if available buf_xmllib_rec-fld
     3456                   then do:
     3457                       assign
     3458                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     3459                       .
     3460                       if v-xmllib-codepage-convert = yes
     3461                       then do:
     3462                         assign
     3463                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     3464                         .
     3465                       end.
     3466                       run xmlchar-decode in this-procedure (
     3467                           input v-data-string
     3468                           , output v-data-string
     3469                       ).
     3470                       assign
     3471                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     3472                       .
     3473                   end.
     3474               end.
     3475           end.
     3476       end.
     3477   end.
     3478   end procedure.
     3479   procedure EndElement :
     3480   define input parameter p-name-space     as character        no-undo.
     3481   define input parameter p-local-name     as character        no-undo.
     3482   define input parameter p-q-name         as character        no-undo.
     3483       define buffer buf_rec             for temp_xmllib_rec.
     3484       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     3485       define buffer buf_rec-list        for temp_xmllib_rec-list.
     3486       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     3487   do
     3488   for buf_rec
     3489     , buf_rec-fld
     3490     , buf_rec-list
     3491     , buf_rec-fld-list
     3492   on error undo, return error
     3493   :
     3494       find last buf_rec-list
     3495           where buf_rec-list.recName = p-q-name
     3496       use-index pi
     3497       no-error.
     3498       if available buf_rec-list
     3499       then do:
     3500           if buf_rec-list.closed = yes
     3501           then do:
     3502               run xmllib-parse-error in this-procedure (
     3503                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     3504                                   , p-q-name
     3505                                   )
     3506               ).
     3507           end.
     3508           else do:
     3509               find last buf_rec
     3510                   where buf_rec.recName  = buf_rec-list.recName
     3511                     and buf_rec.recLevel = buf_rec-list.recLevel
     3512                     and buf_rec.closed   = no
     3513               use-index nm
     3514               no-error.
     3515               if not available buf_rec
     3516               then do:
     3517                   run xmllib-parse-error in this-procedure (
     3518                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     3519                                       , p-q-name
     3520                                       , buf_rec-list.recLevel
     3521                                       )
     3522                   ).
     3523               end.
     3524               else do:
     3525                   find first buf_rec-fld-list
     3526                        where buf_rec-fld-list.recName  = buf_rec.recName
     3527                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     3528                          and buf_rec-fld-list.fldName  = p-q-name
     3529                          and buf_rec-fld-list.closed   = no
     3530                   no-error.
     3531                   if not available buf_rec-fld-list
     3532                   then do:
     3533                       if buf_rec.recName <> p-q-name
     3534                       then do:
     3535                           run xmllib-parse-error in this-procedure (
     3536                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     3537                                               , buf_rec.recName
     3538                                               )
     3539                           ).
     3540                       end.
     3541                       else do:
     3542                           assign
     3543                               buf_rec.closed              = yes
     3544                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3545                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3546                           .
     3547                           if buf_rec-list.recLevel > 0
     3548                           then do:
     3549                               assign
     3550                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     3551                               .
     3552                               for each buf_rec-fld-list
     3553                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     3554                               :
     3555                                   assign
     3556                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     3557                                   .
     3558                               end.
     3559                           end.
     3560                           else do:
     3561                               assign
     3562                                   buf_rec-list.closed         = yes
     3563                               .
     3564                           end.
     3565                       end.
     3566                   end.
     3567                   else do:
     3568                       find last buf_rec-fld
     3569                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3570                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3571                             and buf_rec-fld.closed  = no
     3572                       use-index nm
     3573                       no-error.
     3574                       if not available buf_rec-fld
     3575                       then do:
     3576                           run xmllib-parse-error in this-procedure (
     3577                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3578                                               , buf_rec-fld-list.fldName
     3579                                               , buf_rec.recName
     3580                                               , buf_rec.recLevel
     3581                                               )
     3582                           ).
     3583                       end.
     3584                       else do:
     3585                           assign
     3586                               buf_rec-fld.closed              = yes
     3587                               buf_rec-fld-list.closed         = yes
     3588                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3589                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3590                           .
     3591                       end.
     3592                   end.
     3593               end.
     3594           end.
     3595       end.
     3596       else do:
     3597           close-field-rec:
     3598           for each buf_rec-fld-list
     3599              where buf_rec-fld-list.fldName = p-q-name
     3600           :
     3601               find first buf_rec-list
     3602                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     3603                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     3604                      and buf_rec-list.closed   = no
     3605               no-error.
     3606               if available buf_rec-list
     3607               then do:
     3608                   find last buf_rec
     3609                       where buf_rec.recName  = buf_rec-list.recName
     3610                         and buf_rec.recLevel = buf_rec-list.recLevel
     3611                         and buf_rec.closed   = no
     3612                   use-index nm
     3613                   no-error.
     3614                   if not available buf_rec
     3615                   then do:
     3616                       run xmllib-parse-error in this-procedure (
     3617                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     3618                                           , p-q-name
     3619                                           )
     3620                       ).
     3621                   end.
     3622                   else do:
     3623                       find last buf_rec-fld
     3624                           where buf_rec-fld.rec-key = buf_rec.rec-key
     3625                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     3626                             and buf_rec-fld.closed  = no
     3627                       use-index nm
     3628                       no-error.
     3629                       if not available buf_rec-fld
     3630                       then do:
     3631                           run xmllib-parse-error in this-procedure (
     3632                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     3633                                               , buf_rec-fld-list.fldName
     3634                                               , buf_rec.recName
     3635                                               , buf_rec.recLevel
     3636                                               )
     3637                           ).
     3638                       end.
     3639                       else do:
     3640                           assign
     3641                               buf_rec-fld.closed              = yes
     3642                               buf_rec-fld-list.closed         = yes
     3643                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     3644                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     3645                           .
     3646                       end.
     3647                   end.
     3648                   leave close-field-rec.
     3649               end.
     3650           end.
     3651       end.
     3652   end.
     3653   end procedure.
     3654   procedure Error :
     3655   define input parameter p-error-message     as character        no-undo.
     3656   do
     3657   on error undo, return error
     3658   :
     3659       run xmllib-parse-error in this-procedure (
     3660           input p-error-message
     3661       ).
     3662       assign
     3663           v-xmllib-error-status = yes
     3664       .
     3665   end.
     3666   end procedure.
     3667   procedure xmllib-parse-error :
     3668   define input parameter p-err-message    as character        no-undo.
     3669   do
     3670   on error undo, return error
     3671   :
     3672       if valid-handle(v-xmllib-log-handle) then do:
     3673         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     3674                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     3675                                    ,chr(10)
     3676                                    ,v-xmllib-dirname
     3677                                    ,v-xmllib-filename
     3678                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     3679                                      then v-xmllib-sax-reader-handle :locator-line-number
     3680                                      else ?)
     3681                                    ,p-err-message)).
     3682       end.
     3683       else do:
     3684         if v-xmllib-log-filename = "":U
     3685         then do:
     3686             message
     3687                     vss-workfile vss-revision vss-description
     3688                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     3689                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     3690                                  then v-xmllib-sax-reader-handle :locator-line-number
     3691                                  else ?)
     3692                 skip(1)
     3693                 skip p-err-message
     3694                 skip return-value
     3695                 skip trim( error-status :get-message( 1 ) )
     3696                     trim( error-status :get-message( 2 ) )
     3697                     trim( error-status :get-message( 3 ) )
     3698             view-as alert-box error.
     3699             undo, return error.
     3700         end.
     3701         else do:
     3702           output to value( v-xmllib-log-filename ).
     3703           put unformatted
     3704               substitute( "&1&2", chr(10), p-err-message )
     3705           .
     3706           output close.
     3707         end.
     3708       end.
     3709   end.
     3710   end procedure.
     3711   procedure xmllib-set-log-filename :
     3712   define input parameter p-log-filename   as character        no-undo.
     3713   do
     3714   on error undo, return error
     3715   :
     3716       run gbl/fileapnd.p (
     3717             input p-log-filename
     3718           , input "":U
     3719           , input 10
     3720       ) no-error.
     3721       if error-status :error
     3722       then do:
     3723           assign
     3724               v-xmllib-log-filename = "":U
     3725           .
     3726       end.
     3727       else do:
     3728           assign
     3729               v-xmllib-log-filename = p-log-filename
     3730           .
     3731       end.
     3732   end.
     3733   end procedure.
     3734   procedure xmllib-set-log-handle :
     3735   define input parameter p-log-handle    as handle        no-undo.
     3736   define input parameter p-log-proc-name as character no-undo .
     3737   do
     3738   on error undo, return error
     3739   :
     3740       if valid-handle(p-log-handle)
     3741       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     3742       then do:
     3743         assign
     3744         v-xmllib-log-handle    = p-log-handle
     3745         v-xmllib-log-proc-name = p-log-proc-name
     3746         .
     3747       end.
     3748       else do:
     3749         assign
     3750         v-xmllib-log-handle    = ?
     3751         v-xmllib-log-proc-name = '':U
     3752         .
     3753       end.
     3754   end.
     3755   end procedure.
     3756   procedure xmllib-set-prg-bar-handle :
     3757   define input parameter p-handle    as handle        no-undo.
     3758   do
     3759   on error undo, return error
     3760   :
     3761       if valid-handle(p-handle)
     3762       then do:
     3763         assign
     3764           v-xmllib-prg-bar-handle = p-handle
     3765         .
     3766       end.
     3767       else do:
     3768         assign
     3769           v-xmllib-prg-bar-handle = ?
     3770         .
     3771       end.
     3772   end.
     3773   end procedure.
     3774   procedure xmllib-set-codepage-convert :
     3775     define input  parameter p-codepage-source as character no-undo .
     3776     define input  parameter p-codepage-target as character no-undo .
     3777   do
     3778   on error undo, return error return-value
     3779   :
     3780     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     3781     then do:
     3782       assign
     3783         v-xmllib-codepage-convert = yes
     3784         v-xmllib-codepage-source  = p-codepage-source
     3785         v-xmllib-codepage-target  = p-codepage-target
     3786       .
     3787     end.
     3788     else do:
     3789       assign
     3790         v-xmllib-codepage-convert = no
     3791         v-xmllib-codepage-source  = ""
     3792         v-xmllib-codepage-target  = ""
     3793       .
     3794     end.
     3795   end.
     3796   end procedure.
     3797   procedure xmllib-parse-rec-open :
     3798   define input parameter p-rec-name   as character        no-undo.
     3799   define input parameter p-rec-level  as integer          no-undo.
     3800       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3801   do
     3802   for buf_temp_xmllib_rec
     3803   on error undo, return error
     3804   :
     3805        find first buf_temp_xmllib_rec
     3806            where buf_temp_xmllib_rec.recName = p-rec-name
     3807              and buf_temp_xmllib_rec.recLevel = p-rec-level
     3808              and buf_temp_xmllib_rec.closed  = no
     3809       use-index nm
     3810       no-error.
     3811       if available buf_temp_xmllib_rec
     3812       then do:
     3813           run xmllib-parse-error in this-procedure (
     3814               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     3815                               , p-rec-name
     3816                               , p-rec-level
     3817                               , buf_temp_xmllib_rec.recOpenLine
     3818                               )
     3819           ).
     3820       end.
     3821       else do:
     3822           assign
     3823               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     3824           .
     3825           create buf_temp_xmllib_rec.
     3826           assign
     3827               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     3828               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3829               buf_temp_xmllib_rec.recCloseLine    = 0
     3830               buf_temp_xmllib_rec.recName         = p-rec-name
     3831               buf_temp_xmllib_rec.recLevel        = p-rec-level
     3832               buf_temp_xmllib_rec.closed          = no
     3833           .
     3834       end.
     3835   end.
     3836   end procedure.
     3837   procedure xmllib-parse-rec-fld-open :
     3838   define input parameter p-rec-name   as character        no-undo.
     3839   define input parameter p-rec-level  as integer          no-undo.
     3840   define input parameter p-fld-name   as character        no-undo.
     3841       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3842       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     3843   do
     3844   for buf_temp_xmllib_rec
     3845     , buf_temp_xmllib_rec-fld
     3846   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     3847                                           , return-value
     3848                                           , trim( error-status :get-message( 1 ) )
     3849                                           , trim( error-status :get-message( 2 ) ) )
     3850   :
     3851       find last buf_temp_xmllib_rec
     3852           where buf_temp_xmllib_rec.recName   = p-rec-name
     3853             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     3854             and buf_temp_xmllib_rec.closed    = no
     3855       use-index nm
     3856       no-error.
     3857       if not available buf_temp_xmllib_rec
     3858       then do:
     3859           run xmllib-parse-error in this-procedure (
     3860               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     3861                               , p-rec-name
     3862                               , p-fld-name
     3863                               , p-rec-level
     3864                               )
     3865           ).
     3866       end.
     3867       else do:
     3868           find last buf_temp_xmllib_rec-fld
     3869               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     3870                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     3871                 and buf_temp_xmllib_rec-fld.closed   = no
     3872           use-index nm
     3873           no-error.
     3874           if available buf_temp_xmllib_rec-fld
     3875           then do:
     3876               run xmllib-parse-error in this-procedure (
     3877                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     3878                                   , p-rec-name
     3879                                   , p-fld-name
     3880                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     3881                                   )
     3882               ).
     3883           end.
     3884           else do:
     3885               assign
     3886                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     3887               .
     3888               create buf_temp_xmllib_rec-fld.
     3889               assign
     3890                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
