     1377   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1378   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1380   procedure get-gate-file-name :
     1381   define input parameter p-gate-rec as character no-undo .
     1382   define output  parameter p-gate-file-name as character no-undo .
     1383   define buffer buf_clob-data for ub.clob-data.
     1384   define variable v-tbl-row as rowid no-undo .
     1385   define variable v-tbl-name as character no-undo .
     1386   run gen-row-keyr in this-procedure ( input p-gate-rec
     1387                                       ,input ?
     1388                                       ,input "ub"
     1389                                       ,input ?
     1390                                       ,input no-lock
     1391                                       ,output v-tbl-row
     1392                                       ,output v-tbl-name) no-error.
     1393   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1394                                                           ,vss-include-info10
     1395                                                           ,p-gate-rec).
     1396   find first buf_clob-data no-lock where
     1397             rowid(buf_clob-data) = v-tbl-row no-error.
     1398   if not available buf_clob-data then do:
     1399     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1400                                                             ,vss-include-info10
     1401                                                             ,p-gate-rec).
     1402   end.
     1403   p-gate-file-name = buf_clob-data.file-name.
     1404   end procedure.
     1405   procedure get-gate-rec :
     1406   define input  parameter p-gate-name as character no-undo .
     1407   define output parameter p-gate-rec as character no-undo .
     1408   define buffer buf_clob-bind for ub.clob-bind.
     1409   define buffer buf_clob-data for ub.clob-data.
     1410   main-block:
     1411   do
     1412   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1413   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1414   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1415   :
     1416       find first buf_clob-bind no-lock where
     1417                 buf_clob-bind.uniq-key-rec = p-gate-name
     1418             and buf_clob-bind.field-name = '':U
     1419             and buf_clob-bind.part-num = 1
     1420             and buf_clob-bind.resource-type = 'gate':U
     1421             no-error.
     1422       if not available buf_clob-bind then do:
     1423         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1424                                         , p-gate-name
     1425                                         ).
     1426       end.
     1427       find first buf_clob-data no-lock where
     1428                 buf_clob-data.db-num = buf_clob-bind.db-num
     1429             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1430       if not available buf_clob-data then do:
     1431         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1432                                         , buf_clob-bind.db-num
     1433                                         , buf_clob-bind.int64-id
     1434                                         , p-gate-name
     1435                                         ).
     1436       end.
     1437       run gen-key-rec in this-procedure ( input 'clob-data':U
     1438                                 ,input buffer buf_clob-data:handle
     1439                                 ,output p-gate-rec).
     1440   end.
     1441   end procedure.
     1442   procedure get-gate-by-name :
     1443   define input  parameter p-gate-name as character no-undo .
     1444   define output parameter p-gate-rec as character no-undo .
     1445   define output parameter p-dsh as handle no-undo .
     1446   define input-output  parameter p-xmlh as handle no-undo .
     1447   define variable v-ii as integer   no-undo .
     1448   define variable glog as logical   no-undo .
     1449   define variable v-longchar as longchar no-undo .
     1450   define variable v-txmlh as handle no-undo .
     1451   define variable v-db-num as integer no-undo .
     1452   define variable v-int64-id as int64 no-undo .
     1453   define buffer buf_clob-bind for ub.clob-bind.
     1454   define buffer buf_clob-data for ub.clob-data.
     1455   main-block:
     1456   do
     1457   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1458   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1459   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1460   :
     1461       find first buf_clob-bind no-lock where
     1462                 buf_clob-bind.uniq-key-rec = p-gate-name
     1463             and buf_clob-bind.field-name = '':U
     1464             and buf_clob-bind.part-num = 1
     1465             and buf_clob-bind.resource-type = 'gate':U
     1466             no-error.
     1467       if not available buf_clob-bind then do:
     1468         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1469                                         , p-gate-name
     1470                                         ).
     1471       end.
     1472       find first buf_clob-data no-lock where
     1473                 buf_clob-data.db-num = buf_clob-bind.db-num
     1474             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1475       if not available buf_clob-data then do:
     1476         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1477                                         , buf_clob-bind.db-num
     1478                                         , buf_clob-bind.int64-id
     1479                                         , p-gate-name
     1480                                         ).
     1481       end.
     1482       assign
     1483       v-longchar = buf_clob-data.cdata
     1484       .
     1485       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1486       if error-status :error then do:
     1487         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1488       end.
     1489       create dataset p-dsh .
     1490       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1491                                     , v-longchar
     1492                                     , ?
     1493                                     , ?
     1494                                     , ?
     1495                                     ) no-error.
     1496       v-longchar = '':U.
     1497       if error-status :error
     1498       or not glog
     1499       then do:
     1500         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1501       end.
     1502       if not valid-handle(p-xmlh)
     1503       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1504         create temp-table v-txmlh.
     1505         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1506         v-txmlh:temp-table-prepare("temp-xml-tables").
     1507         p-xmlh = v-txmlh:default-buffer-handle.
     1508       end.
     1509       run gen-key-rec in this-procedure ( input 'clob-data':U
     1510                                 ,input buffer buf_clob-data:handle
     1511                                 ,output p-gate-rec).
     1512       do v-ii = 1 to p-dsh:num-buffers:
     1513         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1514         if not p-xmlh:available then do:
     1515           p-xmlh:buffer-create().
     1516           assign
     1517           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1518           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1519           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1520           p-xmlh::gate-handle_ = p-dsh
     1521           p-xmlh::uniq-gate-rec = p-gate-rec
     1522           p-xmlh::gate-name = p-dsh:name
     1523           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1524           .
     1525           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1526             assign
     1527             p-xmlh::order = -3.
     1528           end.
     1529         end.
     1530       end.
     1531   end.
     1532   end procedure.
     1533   procedure get-gate-by-rec :
     1534   define input  parameter p-gate-rec as character no-undo .
     1535   define output parameter p-dsh as handle no-undo .
     1536   define input-output  parameter p-xmlh as handle no-undo .
     1537   define input-output parameter p-longchar  as longchar no-undo .
     1538   define variable v-ii as integer   no-undo .
     1539   define variable glog as logical   no-undo .
     1540   define variable v-rowid as rowid no-undo .
     1541   define variable v-tbl-name as character no-undo .
     1542   define variable v-longchar as longchar no-undo .
     1543   define variable v-txmlh as handle no-undo .
     1544   define buffer buf_clob-data for ub.clob-data.
     1545   main-block:
     1546   do
     1547   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1548   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1549   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1550   :
     1551     run gen-row-keyr in this-procedure (
     1552                                           input  p-gate-rec
     1553                                           ,input  ?
     1554                                           ,input  "ub"
     1555                                           ,input  ?
     1556                                           ,input  NO-LOCK
     1557                                           ,output v-rowid
     1558                                           ,output v-tbl-name   ) no-error.
     1559       find first buf_clob-data no-lock where
     1560                 rowid(buf_clob-data) = v-rowid  no-error.
     1561       if not available buf_clob-data then do:
     1562         undo, return error substitute("Не найден CLOB  &1"
     1563                                         , p-gate-rec
     1564                                         ).
     1565       end.
     1566       assign
     1567       v-longchar = buf_clob-data.cdata
     1568       .
     1569       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1570       if error-status :error then do:
     1571         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1572       end.
     1573       create dataset p-dsh .
     1574       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1575                                     , v-longchar
     1576                                     , ?
     1577                                     , ?
     1578                                     , ?
     1579                                     ) no-error.
     1580       define variable v-esm as character no-undo .
     1581       v-esm = error-status:get-message(1) .
     1582       if p-longchar <> ? then do:
     1583         p-longchar = v-longchar.
     1584       end.
     1585       v-longchar = '':U.
     1586       if error-status :error
     1587       or not glog
     1588       then do:
     1589         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1590                                      , p-gate-rec
     1591                                      , p-gate-rec
     1592                                      , v-esm
     1593                                      ).
     1594       end.
     1595       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1596       if not valid-handle(p-xmlh)
     1597       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1598         create temp-table v-txmlh.
     1599         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1600         v-txmlh:temp-table-prepare("temp-xml-tables").
     1601         p-xmlh = v-txmlh:default-buffer-handle.
     1602       end.
     1603       do v-ii = 1 to p-dsh:num-buffers:
     1604         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1605         if not p-xmlh:available then do:
     1606           p-xmlh:buffer-create().
     1607           assign
     1608           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1609           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1610           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1611           p-xmlh::gate-handle_ = p-dsh
     1612           p-xmlh::uniq-gate-rec = p-gate-rec
     1613           p-xmlh::gate-name = p-dsh:name
     1614           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1615           .
     1616           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1617             assign
     1618             p-xmlh::order = -3.
     1619           end.
     1620           p-xmlh:buffer-release().
     1621         end.
     1622       end.
     1623   end.
     1624   end procedure.
     1625   procedure get-gate-by-file :
     1626   define input  parameter p-schema-file-name as character no-undo .
     1627   define input  parameter p-gate-rec as character no-undo .
     1628   define output parameter p-dsh as handle no-undo .
     1629   define input-output  parameter p-xmlh as handle no-undo .
     1630   define variable v-ii as integer   no-undo .
     1631   define variable glog as logical   no-undo .
     1632   define variable v-rowid as rowid no-undo .
     1633   define variable v-tbl-name as character no-undo .
     1634   define variable v-longchar as longchar no-undo .
     1635   define variable v-txmlh as handle no-undo .
     1636   main-block:
     1637   do
     1638   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info10, return-value, chr(10), error-status :get-message (1))
     1639   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info10 )
     1640   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info10 )
     1641   :
     1642       COPY-LOB
     1643       FROM  FILE p-schema-file-name
     1644       TO  OBJECT v-longchar
     1645       no-convert
     1646       NO-ERROR .
     1647       if error-status :error then do:
     1648           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1649                                     , p-schema-file-name
     1650                                 , chr(10)
     1651                                 , error-status:get-message(1) ).
     1652       end.
     1653       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1654       if error-status :error then do:
     1655         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1656       end.
     1657       create dataset p-dsh .
     1658       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1659                                     , v-longchar
     1660                                     , ?
     1661                                     , ?
     1662                                     , ?
     1663                                     ) no-error.
     1664       v-longchar = ''.
     1665       if error-status :error
     1666       or not glog
     1667       then do:
     1668         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1669                                      , p-schema-file-name
     1670                                      ,chr(10)
     1671                                      , error-status:get-message(1)
     1672                                      ).
     1673       end.
     1674       if not valid-handle(p-xmlh)
     1675       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1676         create temp-table v-txmlh.
     1677         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1678         v-txmlh:temp-table-prepare("temp-xml-tables").
     1679         p-xmlh = v-txmlh:default-buffer-handle.
     1680       end.
     1681       do v-ii = 1 to p-dsh:num-buffers:
     1682         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1683                                      ,p-dsh:get-buffer-handle(v-ii):name
     1684                                      ,p-gate-rec
     1685                                      )) no-error.
     1686         if not p-xmlh:available then do:
     1687           p-xmlh:buffer-create().
     1688           assign
     1689           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1690           p-xmlh::uniq-gate-rec = p-gate-rec
     1691           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1692           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1693           p-xmlh::gate-handle_ = p-dsh
     1694           p-xmlh::gate-name = p-dsh:name
     1695           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1696           .
     1697           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1698             assign
     1699             p-xmlh::order = -3.
     1700           end.
     1701           p-xmlh:buffer-release().
     1702         end.
     1703       end.
     1704   end.
     1705   end procedure.
     1706   procedure gate-clear :
     1707   define input  parameter p-dsh as handle no-undo .
     1708   define input  parameter p-xmlh as handle no-undo .
     1709   define variable v-dsh as handle no-undo .
     1710   define variable v-th as handle no-undo .
     1711     do
     1712     on error undo, return error return-value
     1713     :
     1714       if valid-handle(p-dsh) then do:
     1715         delete object p-dsh.
     1716         v-dsh = p-dsh.
     1717         p-dsh = ?.
     1718       end.
     1719       repeat while true:
     1720         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1721                            , share-lock) no-error.
     1722         if p-xmlh:available then do:
     1723           assign
     1724           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1725           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1726           and valid-handle(v-th)
     1727           and v-th:dynamic = yes
     1728           then do:
     1729             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1730             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1731           end.
     1732           p-xmlh:buffer-delete().
     1733         end.
     1734         else do:
     1735           leave.
     1736         end.
     1737       end.
     1738       if p-xmlh:dynamic = yes
     1739       and valid-handle(p-xmlh)
     1740       then do:
     1741         delete object p-xmlh:table-handle.
     1742         p-xmlh = ?.
     1743       end.
     1744       v-dsh = ?.
     1745     end.
     1746   end procedure.
     1747   procedure all-gates-clear :
     1748   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1749   do
     1750   on error undo, return error
     1751   :
     1752     for each buf_temp-xml-tables
     1753     break
     1754     by buf_temp-xml-tables.uniq-gate-rec
     1755     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1756     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1757     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1758     :
     1759         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1760           delete object buf_temp-xml-tables.gate-handle_.
     1761           buf_temp-xml-tables.gate-handle_ = ?.
     1762         end.
     1763         if valid-handle(buf_temp-xml-tables.table-handle_)
     1764         and buf_temp-xml-tables.table-handle_:dynamic = no
     1765         then do:
     1766           delete object buf_temp-xml-tables.table-handle_.
     1767           buf_temp-xml-tables.table-handle_ = ?.
     1768         end.
     1769         delete buf_temp-xml-tables.
     1770     end.
     1771   end.
     1772   end procedure.
     1773   procedure fix-schemalocation :
     1774   define input-output  parameter p-longchar as longchar no-undo .
     1775   DEFINE VARIABLE hdoc AS HANDLE.
     1776   DEFINE VARIABLE hroot AS HANDLE.
     1777   DEFINE VARIABLE hnode-child AS HANDLE.
     1778   DEFINE VARIABLE hnode-attr AS HANDLE.
     1779   define variable v-jj as integer   no-undo .
     1780   define variable ok as logical   no-undo .
     1781   define variable v-path1                    as character                no-undo .
     1782   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1783   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1784   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1785   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1786   define variable v-schema-location          as character                no-undo .
     1787   do
     1788   on error undo, return error return-value
     1789   :
     1790     CREATE X-DOCUMENT hdoc.
     1791     CREATE X-noderef hroot.
     1792     CREATE X-noderef hnode-child.
     1793     CREATE X-noderef hnode-attr.
     1794     hdoc:load("longchar", p-longchar, no) no-error.
     1795     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1796     hdoc:get-document-element(hroot).
     1797     _repeat:
     1798     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1799       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1800       if not ok then next.
     1801       if hNode-Child:local-name = "include"
     1802       then do:
     1803         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1804           v-schema-location = hnode-attr:node-value.
     1805           run gbl/filename.p (
     1806                           input "exe/" + hnode-attr:node-value
     1807                         ,output v-full-path1
     1808                         ,output v-path1
     1809                         ,output v-file-name1
     1810                         ,output v-file-name-no-ext1
     1811                         ,output v-file-name-ext1
     1812                         ) no-error .
     1813           if error-status :error then do:
     1814             delete object hnode-attr.
     1815             delete object hnode-child.
     1816             delete object hroot.
     1817             delete object hdoc.
     1818             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1819           end.
     1820         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1821         leave  _repeat.
     1822       end.
     1823     END.
     1824     hdoc:save("longchar", p-longchar).
     1825     delete object hnode-attr.
     1826     delete object hnode-child.
     1827     delete object hroot.
     1828     delete object hdoc.
     1829   end.
     1830   end procedure.
     1831   procedure gate-clb_fill-xml-tables :
     1832   define input parameter p-dsh as handle no-undo .
     1833   define input-output parameter p-xmlh as handle no-undo .
     1834   define variable v-ii as integer no-undo .
     1835     do
     1836     on error undo, return error
     1837     :
     1838       do v-ii = 1 to p-dsh:num-buffers:
     1839         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1840         if not p-xmlh:available then do:
     1841           p-xmlh:buffer-create().
     1842           assign
     1843           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1844           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1845           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1846           p-xmlh::gate-handle_ = p-dsh
     1847           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1848           p-xmlh::gate-name = p-dsh:name
     1849           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1850           .
     1851           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1852             assign
     1853             p-xmlh::order = -3.
     1854           end.
     1855           p-xmlh:buffer-release().
     1856         end.
     1857       end.
     1858     end.
     1859   end procedure.
     1860   procedure all-gates-empty :
     1861   define buffer buf_temp-xml-tables for temp-xml-tables.
     1862   do
     1863   on error undo, return error
     1864   :
     1865     for each buf_temp-xml-tables
     1866     break
     1867     by buf_temp-xml-tables.uniq-gate-rec
     1868     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1869     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1870     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1871     :
     1872       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1873         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1874       end.
     1875     end.
     1876   end.
     1877   end procedure.
     1878   define variable vss-include-info13 as character format "X(65)" no-undo
     1879   initial "@(#)$Workfile$ $Revision$".
     1880   define temp-table temp_cgrplib_grp no-undo
     1881       field sel           as character
     1882       field full-name     as character
     1883       field sort-name     as character
     1884       field node-code     as integer
     1885       field upper-code    as integer
     1886       field d-pcnt        as decimal
     1887       field name          as character
     1888       field level         as integer
     1889       field mark          as character
     1890       index pi is primary unique sort-name
     1891       index fn full-name
     1892       index nc is unique node-code
     1893       index sl sel
     1894       index uc upper-code
     1895   .
     1896   define temp-table temp_cgrplib_found-grp no-undo
     1897       field full-name   as character
     1898       field sort-name   as character
     1899       field node-code   as integer
     1900       field level       as integer
     1901       field is-terminal as logical
     1902       field d-pcnt      as decimal
     1903       index pi is primary unique sort-name
     1904       index fn full-name
     1905       index lv level
     1906       index it is-terminal
     1907   .
     1908   define temp-table temp_cfound-result-nodelist no-undo
     1909       field node-code     as recid
     1910       field processed     as logical
     1911       field full-name     as character
     1912       field sort-name     as character
     1913       index pi is primary unique node-code
     1914       index ps processed
     1915   .
     1916   procedure cli-grplib-get-sort-name :
     1917   do
     1918   on error undo, return error
     1919   :
     1920   define input parameter p-node-code  as integer      no-undo.
     1921   define output parameter p-sort-name as character    no-undo.
     1922       define variable v-upper-code    as integer           no-undo.
     1923       define buffer buf_cli-grp       for ub.cli-grp.
     1924       define buffer buf_upper_cli-grp for ub.cli-grp.
     1925       find first buf_cli-grp no-lock
     1926            where buf_cli-grp.node-code = p-node-code
     1927       no-error.
     1928       if not available buf_cli-grp
     1929       then do:
     1930           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1931       end.
     1932       assign
     1933           p-sort-name  = ""
     1934           v-upper-code = 1
     1935       .
     1936       do while buf_cli-grp.upper-code <> 0
     1937       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
     1938       :
     1939           assign
     1940               p-sort-name  = buf_cli-grp.node-name
     1941                            + (if p-sort-name <> "" then chr(2) else "")
     1942                            + p-sort-name
     1943               v-upper-code = buf_cli-grp.upper-code
     1944           .
     1945           find first buf_cli-grp no-lock
     1946                where buf_cli-grp.node-code = v-upper-code
     1947           no-error.
     1948           if not available buf_cli-grp
     1949           then do:
     1950               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
     1951                                   + string( v-upper-code )
     1952                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1953           end.
     1954       end.
     1955   end.
     1956   end procedure.
     1957   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1958   procedure cli-grplib-get-full-name :
     1959      define input parameter  p-node-code  as integer      no-undo.
     1960      define output parameter p-full-name as character    no-undo.
     1961   do
     1962   on error undo, return error
     1963   :
     1964       define variable v-upper-code    as integer           no-undo.
     1965       define buffer buf_cli-grp       for ub.cli-grp.
     1966       define buffer buf_upper_cli-grp for ub.cli-grp.
     1967       find first buf_cli-grp no-lock
     1968            where buf_cli-grp.node-code = p-node-code
     1969       no-error.
     1970       if not available buf_cli-grp
     1971       then do:
     1972           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1973       end.
     1974       assign
     1975           p-full-name  = ""
     1976           v-upper-code = 1
     1977       .
     1978       do while buf_cli-grp.upper-code <> 0
     1979       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1980       :
     1981           assign
     1982               p-full-name  = buf_cli-grp.node-name
     1983                            + (if p-full-name <> "" then chr(47) else "")
     1984                            + p-full-name
     1985               v-upper-code = buf_cli-grp.upper-code
     1986           .
     1987           find first buf_cli-grp no-lock
     1988                where buf_cli-grp.node-code = v-upper-code
     1989           no-error.
     1990           if not available buf_cli-grp
     1991           then do:
     1992               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1993                                   + string( v-upper-code )
     1994                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1995           end.
     1996       end.
     1997       assign
     1998       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1999       .
     2000   end.
     2001   end .
     2002   procedure cgrplib-get-node-from-full-name :
     2003   define input parameter p-full-name as character no-undo .
     2004   define output parameter p-node-code as integer no-undo .
     2005   define variable v-ii as integer no-undo .
     2006   define variable v-upper-code as integer no-undo .
     2007   define variable v-root-code as integer no-undo .
     2008   define variable v-entry as character no-undo .
     2009   define buffer buf_cli-grp       for ub.cli-grp.
     2010   do
     2011   on error undo, return error
     2012   :
     2013     find first buf_cli-grp no-lock
     2014         where buf_cli-grp.upper-code = 0
     2015     no-error .
     2016     if not available buf_cli-grp
     2017     then do:
     2018         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     2019     end.
     2020     else do:
     2021       assign
     2022       v-root-code = buf_cli-grp.node-code
     2023       .
     2024     end.
     2025     v-upper-code = v-root-code.
     2026     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2027       assign
     2028       v-entry = entry(v-ii, p-full-name, chr(47)).
     2029       if v-entry = '' then leave.
     2030       find first buf_cli-grp no-lock where
     2031                 buf_cli-grp.node-name = v-entry
     2032             and buf_cli-grp.upper-code = v-upper-code
     2033             no-error.
     2034       if not available buf_cli-grp then do:
     2035         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2036       end.
     2037       else do:
     2038         p-node-code = buf_cli-grp.node-code.
     2039         v-upper-code = buf_cli-grp.node-code.
     2040       end.
     2041     end.
     2042   end.
     2043   end .
     2044   procedure cgrplib-get-root-code :
     2045   do
     2046   on error undo, return error
     2047   :
     2048   define output parameter p-root-code as integer      no-undo.
     2049       define buffer buf_cli-grp       for ub.cli-grp.
     2050       find first buf_cli-grp no-lock
     2051           where buf_cli-grp.upper-code = 0
     2052       no-error .
     2053       if not available buf_cli-grp
     2054       then do:
     2055           undo, return error .
     2056       end.
     2057       else do:
     2058           assign
     2059               p-root-code = buf_cli-grp.node-code
     2060           .
     2061       end.
     2062   end.
     2063   end procedure.
     2064   procedure cgrplib-find-grp-by-full-name :
     2065   do
     2066   on error undo, return error
     2067   :
     2068   define input parameter p-search-name  as character    no-undo.
     2069   define input parameter p-fill-path    as logical      no-undo.
     2070       define variable v-upper-code    as integer          no-undo.
     2071       define variable v-not-found     as logical init yes no-undo.
     2072       define variable v-counter       as integer           no-undo.
     2073       define variable v-level         as integer           no-undo.
     2074       define variable v-full-name     as character         no-undo.
     2075       define variable v-sort-name     as character         no-undo.
     2076       define buffer buf_cli-grp       for ub.cli-grp.
     2077       assign
     2078           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2079       .
     2080       run cgrplib-get-root-code ( output v-upper-code ) no-error .
     2081       if error-status :error
     2082       then do:
     2083           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
     2084       end.
     2085       assign
     2086           v-full-name  = ""
     2087           v-level      = num-entries( p-search-name, chr(2) )
     2088       .
     2089       for each temp_cgrplib_found-grp
     2090       :
     2091           delete temp_cgrplib_found-grp.
     2092       end.
     2093       start-name-analyze:
     2094       do v-counter = 1 to v-level
     2095       :
     2096           if v-counter < v-level
     2097           then do:
     2098               find first buf_cli-grp no-lock
     2099                    where buf_cli-grp.upper-code = v-upper-code
     2100                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     2101               no-error .
     2102               if not available buf_cli-grp
     2103               then do:
     2104                   assign
     2105                       v-full-name  = p-search-name
     2106                       v-sort-name  = p-search-name
     2107                   .
     2108                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2109               end.
     2110               else do:
     2111                   assign
     2112                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
     2113                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
     2114                       v-upper-code = buf_cli-grp.node-code
     2115                   .
     2116                   if p-fill-path = yes
     2117                   then do:
     2118                       create temp_cgrplib_found-grp.
     2119                       assign
     2120                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
     2121                           temp_cgrplib_found-grp.sort-name = v-sort-name
     2122                           temp_cgrplib_found-grp.node-code = v-upper-code
     2123                           temp_cgrplib_found-grp.level     = v-counter
     2124                       .
     2125                   end.
     2126               end.
     2127           end.
     2128           else do:
     2129               for each buf_cli-grp no-lock
     2130                  where buf_cli-grp.upper-code = v-upper-code
     2131                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2132               :
     2133                   assign
     2134                       v-not-found = no
     2135                   .
     2136                   create temp_cgrplib_found-grp.
     2137                   assign
     2138                       temp_cgrplib_found-grp.full-name = v-full-name
     2139                                                           + ( if v-full-name = "" then "" else chr(47) )
     2140                                                           + buf_cli-grp.node-name + chr(47)
     2141                       temp_cgrplib_found-grp.sort-name = v-sort-name
     2142                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2143                                                           + buf_cli-grp.node-name
     2144                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
     2145                       temp_cgrplib_found-grp.level     = v-level
     2146                   .
     2147               end.
     2148               if v-not-found = yes
     2149               then do:
     2150                   assign
     2151                       v-full-name  = p-search-name
     2152                       v-sort-name  = p-search-name
     2153                   .
     2154                   for each temp_cgrplib_found-grp
     2155                   :
     2156                       delete temp_cgrplib_found-grp.
     2157                   end.
     2158                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2159               end.
     2160           end.
     2161       end.
     2162   end.
     2163   end procedure.
     2164   procedure cgrplib-find-all-subgroup :
     2165   do
     2166   on error undo, return error
     2167   :
     2168   define input parameter p-start-node-code    as integer      no-undo.
     2169   define input parameter p-terminal-only      as logical      no-undo.
     2170       define variable v-start-full-name   as character     no-undo.
     2171       define variable v-start-sort-name   as character     no-undo.
     2172       define variable v-not-found         as logical       no-undo.
     2173       define variable v-is-terminal       as logical       no-undo.
     2174       define variable v-d-pcnt            as decimal       no-undo.
     2175       define buffer buf_cli-grp           for ub.cli-grp.
     2176       create temp_cfound-result-nodelist.
     2177       assign
     2178           temp_cfound-result-nodelist.node-code = p-start-node-code
     2179           temp_cfound-result-nodelist.processed = no
     2180       .
     2181       run cli-grplib-get-full-name in this-procedure (
     2182             input p-start-node-code
     2183           , output v-start-full-name
     2184       ).
     2185       run cli-grplib-get-sort-name in this-procedure (
     2186             input p-start-node-code
     2187           , output v-start-sort-name
     2188       ).
     2189       process-nodes:
     2190       do while yes
     2191       :
     2192           find first temp_cfound-result-nodelist
     2193                where temp_cfound-result-nodelist.node-code = p-start-node-code
     2194           .
     2195           assign
     2196               temp_cfound-result-nodelist.processed = yes
     2197           .
     2198           for each buf_cli-grp no-lock
     2199              where buf_cli-grp.upper-code = p-start-node-code
     2200           on error undo, return error
     2201           :
     2202               run cgrplib-is-terminal in this-procedure (
     2203                     input buf_cli-grp.node-code
     2204                   , output v-is-terminal
     2205               ).
     2206               if v-is-terminal = yes
     2207               then do:
     2208                   create temp_cgrplib_found-grp.
     2209                   assign
     2210                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2211                                                           chr(47) + buf_cli-grp.node-name + chr(47)
     2212                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2213                                                           chr(2) + buf_cli-grp.node-name + chr(2)
     2214                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     2215                       temp_cgrplib_found-grp.is-terminal = yes
     2216                   .
     2217                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
     2218                  if not error-status:error then do:
     2219                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
     2220                  end.
     2221                  else do:
     2222                    temp_cgrplib_found-grp.d-pcnt = ?.
     2223                  end.
     2224               end.
     2225               else do:
     2226                   create temp_cfound-result-nodelist.
     2227                   assign
     2228                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
     2229                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2230                                                              chr(47) + buf_cli-grp.node-name + chr(47)
     2231                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2232                                                              chr(2) + buf_cli-grp.node-name + chr(2)
     2233                       temp_cfound-result-nodelist.processed = no
     2234                   .
     2235                   if p-terminal-only = no
     2236                   then do:
     2237                       create temp_cgrplib_found-grp.
     2238                       assign
     2239                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2240                                                               chr(47) + buf_cli-grp.node-name + chr(47)
     2241                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2242                                                               chr(2) + buf_cli-grp.node-name + chr(2)
     2243                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
     2244                           temp_cgrplib_found-grp.is-terminal = no
     2245                       .
     2246                   end.
     2247               end.
     2248           end.
     2249           find first temp_cfound-result-nodelist
     2250                where temp_cfound-result-nodelist.processed = no
     2251           no-error.
     2252           if not available temp_cfound-result-nodelist
     2253           then do:
     2254               leave process-nodes.
     2255           end.
     2256           else do:
     2257               assign
     2258                   p-start-node-code = temp_cfound-result-nodelist.node-code
     2259                   v-start-full-name = temp_cfound-result-nodelist.full-name
     2260                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
     2261               .
     2262           end.
     2263       end.
     2264   end.
     2265   end procedure.
     2266   procedure cgrplib-expand-name :
     2267   do
     2268   on error undo, return error
     2269   :
     2270   define input parameter p-start-name as character        no-undo.
     2271   define output parameter p-end-name  as character        no-undo.
     2272       define variable v-is-terminal     as logical           no-undo.
     2273       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
     2274       run cgrplib-find-grp-by-full-name in this-procedure (
     2275             input p-start-name
     2276           , input no
     2277       ) no-error.
     2278       run cgrplib-get-max-substring in this-procedure (
     2279                   input length( p-start-name )
     2280                 , output p-end-name
     2281       ) no-error .
     2282       if error-status :error
     2283       then do:
     2284           assign
     2285               p-end-name = ""
     2286           .
     2287       end.
     2288       else do:
     2289           find first temp_cgrplib_found-grp
     2290               where temp_cgrplib_found-grp.full-name = p-end-name
     2291           no-error.
     2292           if available temp_cgrplib_found-grp
     2293           then do:
     2294               find first buf_temp_cgrplib_found-grp
     2295                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
     2296                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
     2297               no-error.
     2298               if not available buf_temp_cgrplib_found-grp
     2299               then do:
     2300                   run cgrplib-is-terminal in this-procedure (
     2301                       input temp_cgrplib_found-grp.node-code
     2302                       , output v-is-terminal
     2303                   ).
     2304               end.
     2305           end.
     2306       end.
     2307   end.
     2308   end procedure.
     2309   procedure cgrplib-get-max-substring :
     2310   do
     2311   on error undo, return error
     2312   :
     2313   define input parameter p-min-substring-length   as integer      no-undo.
     2314   define output parameter p-substring             as character    no-undo.
     2315           define variable v-char-counter  as integer           no-undo.
     2316           define variable v-current-char  as character         no-undo.
     2317           define variable v-names-counter  as integer           no-undo.
     2318           define variable v-base-string   as character         no-undo.
     2319           assign
     2320               v-char-counter  = p-min-substring-length
     2321           .
     2322           find first temp_cgrplib_found-grp no-error.
     2323           if not available temp_cgrplib_found-grp
     2324           then do:
     2325               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
     2326           end.
     2327           else do:
     2328               assign
     2329                   v-base-string = temp_cgrplib_found-grp.full-name
     2330               .
     2331               counter-block:
     2332               do while yes
     2333               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2334               :
     2335                   assign
     2336                       v-char-counter  = v-char-counter + 1
     2337                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2338                       v-names-counter = 0
     2339                   .
     2340                   compare-block:
     2341                   for each temp_cgrplib_found-grp
     2342                   :
     2343                       assign
     2344                           v-names-counter = v-names-counter + 1
     2345                       .
     2346                       if v-names-counter = 1
     2347                       then do:
     2348                           next compare-block.
     2349                       end.
     2350                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2351                       then do:
     2352                           leave counter-block.
     2353                       end.
     2354                   end.
     2355                   if v-names-counter = 1
     2356                   then do:
     2357                       assign
     2358                           p-substring = v-base-string
     2359                       .
     2360                       return.
     2361                   end.
     2362               end.
     2363               assign
     2364                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2365               .
     2366           end.
     2367   end.
     2368   end procedure.
     2369   procedure cgrplib-is-terminal :
     2370   do
     2371   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
     2372   :
     2373   define input parameter p-node-code      as integer      no-undo.
     2374   define output parameter p-is-terminal   as logical      no-undo.
     2375       define buffer buf_cli-grp       for ub.cli-grp.
     2376       find first buf_cli-grp no-lock
     2377           where buf_cli-grp.upper-code = p-node-code
     2378       no-error .
     2379       if not available buf_cli-grp
     2380       then do:
     2381           assign
     2382               p-is-terminal = yes
     2383           .
     2384       end.
     2385       else do:
     2386           assign
     2387               p-is-terminal = no
     2388           .
     2389       end.
     2390   end.
     2391   end procedure.
     2392   procedure cgrplib-have-clients :
     2393   do
     2394   on error undo, return error
     2395   :
     2396   define input parameter p-node-code      as integer      no-undo.
     2397   define output parameter p-have-clients   as logical      no-undo.
     2398       define buffer buf_clients         for ub.clients.
     2399       find first buf_clients no-lock
     2400            where buf_clients.grp-code = p-node-code
     2401       no-error .
     2402       if available buf_clients
     2403       then do:
     2404           assign
     2405               p-have-clients = yes
     2406           .
     2407       end.
     2408       else do:
     2409           assign
     2410               p-have-clients = no
     2411           .
     2412       end.
     2413   end.
     2414   end procedure.
     2415   procedure cgrplib-find-by-substring :
     2416   do
     2417   on error undo, return error
     2418   :
     2419   define input parameter p-start-code         as integer      no-undo.
     2420   define input parameter p-full-search-string as character    no-undo.
     2421   define output parameter p-found-code        as integer      no-undo.
     2422   define output parameter p-full-name         as character    no-undo.
     2423       define variable v-start-code     as integer           no-undo.
     2424       define variable v-found          as logical  init no  no-undo.
     2425       define buffer buf_cli-grp       for ub.cli-grp.
     2426       search-grp:
     2427       for each buf_cli-grp no-lock
     2428           where buf_cli-grp.node-code > p-start-code
     2429       :
     2430           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     2431           then do:
     2432               assign
     2433                   p-found-code = buf_cli-grp.node-code
     2434                   v-found      = yes
     2435               .
     2436               run cli-grplib-get-full-name in this-procedure (
     2437                     input p-found-code
     2438                   , output p-full-name
     2439               ) no-error .
     2440               if error-status :error
     2441               then do:
     2442                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2443               end.
     2444               leave search-grp.
     2445           end.
     2446       end.
     2447       if v-found = yes
     2448       then do:
     2449       end.
     2450       else do:
     2451           assign
     2452               p-full-name  = ""
     2453               p-found-code = 0
     2454           .
     2455       end.
     2456   end.
     2457   end procedure.
     2458   procedure cgrplib-analyze-grp-name :
     2459   do
     2460   on error undo, return error
     2461   :
     2462   define input parameter p-grp-name       as character            no-undo.
     2463   define input parameter p-upper-code     as integer              no-undo.
     2464   define output parameter p-error-message as character init ""    no-undo.
     2465       define variable v-char-list     as character    no-undo.
     2466       define variable v-char-counter  as integer      no-undo.
     2467       define variable v-full-name     as character    no-undo.
     2468       if p-grp-name = "" then do:
     2469           assign
     2470               p-error-message = "Название группы не может быть пустым.".
     2471           .
     2472       end.
     2473       else do:
     2474           assign
     2475               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2476           .
     2477           do v-char-counter = 1 to num-entries( v-char-list )
     2478           :
     2479               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2480               then do:
     2481                   assign
     2482                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2483                   .
     2484                   return.
     2485               end.
     2486           end.
     2487           run cli-grplib-get-full-name in this-procedure (
     2488                 input p-upper-code
     2489               , output v-full-name
     2490           ) no-error .
     2491           if error-status :error
     2492           then do:
     2493               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2494           end.
     2495           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2496           then do:
     2497               assign
     2498                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2499               .
     2500           end.
     2501       end.
     2502   end.
     2503   end procedure.
     2504   procedure cgrplib-get-lvl-num :
     2505   define input parameter p-node-code  as integer      no-undo.
     2506   define output parameter p-lvl-num   as integer      no-undo.
     2507       define variable v-full-name    as character    no-undo.
     2508   do
     2509   on error undo, return error
     2510   :
     2511       run cli-grplib-get-full-name in this-procedure (
     2512             input p-node-code
     2513           , output v-full-name
     2514       ).
     2515       assign
     2516           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     2517       .
     2518       if p-lvl-num = -1
     2519       then do:
     2520           assign
     2521               p-lvl-num = 0
     2522           .
     2523       end.
     2524   end.
     2525   end procedure.
     2526   PROCEDURE cgrplib-get-pcnt-value :
     2527   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     2528   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     2529   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     2530   define buffer buf_dis-rule for ub.dis-rule.
     2531   find first buf_dis-grp-rule no-lock where
     2532             buf_dis-grp-rule.classif-type = 'cli-grp':U
     2533         and buf_dis-grp-rule.node-code = p-node-code
     2534         and buf_dis-grp-rule.host-code = 0
     2535         and buf_dis-grp-rule.obj-type = '':U
     2536         and buf_dis-grp-rule.obj-code = 0
     2537         and buf_dis-grp-rule.pos-type = '-':U
     2538         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     2539   if available buf_dis-grp-rule then do:
     2540     find first buf_dis-rule no-lock where
     2541               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     2542     if available buf_dis-rule then do:
     2543       assign
     2544       p-pcnt-value        = buf_dis-rule.discnt-value.
     2545       .
     2546     end.
     2547   end.
     2548   END PROCEDURE.
     2549   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
