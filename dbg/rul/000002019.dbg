     4359   index iparenthandle parent-buffer-handle child-buffer-handle
     4360   .
     4361   procedure tmpreldf_get-relations :
     4362   define input parameter p-dataseth as handle no-undo .
     4363   define variable v-ii as integer no-undo .
     4364   define buffer buf_temp-rel-handle for temp-rel-handle.
     4365   do
     4366   on error undo, return error
     4367   :
     4368     if not valid-handle(p-dataseth)
     4369     or p-dataseth:type <> "DATASET"
     4370     then do:
     4371       return error substitute("Не определен dataset с handle &1", p-dataseth).
     4372     end.
     4373     for each buf_temp-rel-handle where
     4374             buf_temp-rel-handle.dh = p-dataseth:
     4375       delete buf_temp-rel-handle.
     4376     end.
     4377     do v-ii = 1 to p-dataseth:num-relations:
     4378       create buf_temp-rel-handle.
     4379       assign
     4380       buf_temp-rel-handle.ii = v-ii
     4381       buf_temp-rel-handle.dh = p-dataseth
     4382       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     4383       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     4384       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     4385       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     4386       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     4387       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     4388       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     4389       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     4390       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     4391       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     4392       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     4393       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     4394       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     4395       .
     4396     end.
     4397   end.
     4398   end procedure.
     4399   procedure tmpreldf_set-relations :
     4400   define input parameter p-srcdataseth as handle no-undo .
     4401   define input parameter p-trgdataseth as handle no-undo .
     4402   define variable gh as handle no-undo .
     4403   define buffer buf_temp-rel-handle for temp-rel-handle.
     4404   do
     4405   on error undo, return error
     4406   :
     4407     if not valid-handle(p-srcdataseth)
     4408     or p-srcdataseth:type <> "DATASET"
     4409     then do:
     4410       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     4411     end.
     4412     if not valid-handle(p-trgdataseth)
     4413     or p-trgdataseth:type <> "DATASET"
     4414     then do:
     4415       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     4416     end.
     4417     for each buf_temp-rel-handle no-lock where
     4418             buf_temp-rel-handle.dh = p-srcdataseth
     4419     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4420     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4421     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4422     :
     4423       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     4424                                         , buf_temp-rel-handle.child-buffer-handle
     4425                                         , buf_temp-rel-handle.relation-fields_
     4426                                         , buf_temp-rel-handle.reposition_
     4427                                         , buf_temp-rel-handle.nested_).
     4428      if error-status:error
     4429      or not valid-handle(gh) then do:
     4430        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     4431      end.
     4432     end.
     4433   end.
     4434   end procedure.
     4435   procedure tmpreld2_query :
     4436   define  parameter buffer buf_temp-rel-handle for temp-rel-handle.
     4437   define input-output parameter p-child-qh as handle no-undo .
     4438   define variable glog as logical no-undo .
     4439   define variable v-mess as character no-undo .
     4440   _main:
     4441   do
     4442   on error undo, return error
     4443   :
     4444     create query p-child-qh .
     4445     glog = p-child-qh:set-buffers( buf_temp-rel-handle.child-buffer-handle) no-error.
     4446     if error-status:error
     4447     or
     4448     not glog then do:
     4449       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4450                           , buf_temp-rel-handle.child-buffer_
     4451                           , chr(10)
     4452                           , error-status:get-message(1)
     4453                           ).
     4454       delete object p-child-qh no-error.
     4455       undo _main, return error v-mess.
     4456     end.
     4457     glog = p-child-qh:query-prepare( substitute( "for each &1 &2 "
     4458                                               , buf_temp-rel-handle.child-buffer_
     4459                                               , buf_temp-rel-handle.where-string_
     4460                                               )) no-error .
     4461     if error-status:error
     4462     or
     4463     not glog then do:
     4464       v-mess =  substitute("Ошибка при попытке получить записи &1&2&3"
     4465                           , buf_temp-rel-handle.child-buffer_
     4466                           , chr(10)
     4467                           , error-status:get-message(1)
     4468                           ).
     4469       delete object p-child-qh no-error.
     4470       undo _main, return error v-mess.
     4471     end.
     4472     glog = p-child-qh:query-open no-error .
     4473     if error-status:error
     4474     or
     4475     not glog then do:
     4476       v-mess = substitute("Ошибка при попытке получить записи &1&2&3"
     4477                           , buf_temp-rel-handle.child-buffer_
     4478                           , chr(10)
     4479                           , error-status:get-message(1)
     4480                           ).
     4481       delete object p-child-qh no-error.
     4482       undo _main, return error v-mess.
     4483     end.
     4484   end.
     4485   end procedure.
     4486   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4487   define temp-table temp_contract no-undo
