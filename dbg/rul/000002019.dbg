     1328   procedure library-cls_get-handle :
     1329   define input parameter p-library-name as character no-undo .
     1330   define output parameter p-library-handle as handle no-undo .
     1331     do
     1332     on error undo, return error
     1333     :
     1334       CASE p-library-name:
     1335         when "library" then do:
     1336           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1337           p-library-handle = g#library.
     1338         end.
     1339         when "library2" then do:
     1340           if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     1341           p-library-handle = g#library2.
     1342         end.
     1343       end case.
     1344     end.
     1345   end procedure.
     1346   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1347   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
