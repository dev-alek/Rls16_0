      643   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   procedure gen-key-rec :
      646     define input  parameter p-tbl-name    as character no-undo.
      647     define input  parameter p-bh_tbl-name as handle    no-undo.
      648     define output parameter p-key-rec     as character no-undo.
      649     do
      650     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      651     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      652     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      653     :
      654       define variable fh               as handle    no-undo .
      655       define variable v-ok             as logical   no-undo .
      656       define variable v-inform         as character no-undo .
      657       define variable v-ind            as integer   no-undo .
      658       define variable v-idx-field-qnty as integer   no-undo .
      659       if p-tbl-name = ?
      660         or p-tbl-name = "":U
      661       then do:
      662         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      663       end.
      664       if not p-bh_tbl-name:available then do:
      665         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      666       end.
      667       assign
      668         p-key-rec = p-tbl-name
      669         v-inform  = p-bh_tbl-name:index-information(1)
      670         v-ind     = 2
      671       .
      672       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      673       on error undo, return error
      674       :
      675         assign
      676           v-inform = p-bh_tbl-name:index-information( v-ind )
      677           v-ind    = v-ind + 1
      678         .
      679       end.
      680       if v-inform = ?
      681         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      682         or entry( 3, v-inform, ",":U ) <> "1":U
      683       then do:
      684         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      685       end.
      686       else do:
      687         assign
      688           v-idx-field-qnty = num-entries( v-inform ) - 4
      689         .
      690         if v-idx-field-qnty < 2 then do:
      691           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      692         end.
      693         do v-ind = 1 to v-idx-field-qnty by 2
      694         on error undo, return error
      695         :
      696           assign
      697             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      698             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      699           .
      700         end.
      701       end.
      702       if p-key-rec = ? then do:
      703         assign
      704           p-key-rec = "":U
      705         .
      706         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      707       end.
      708     end.
      709     return.
      710   end procedure.
      711   procedure gen-where-keyr-tab :
      712     define input  parameter i-tableSerach as character no-undo.
      713     define input  parameter i-tablekey   as character  no-undo.
      714     define input  parameter p-key-rec    as character  no-undo.
      715     define input  parameter p-key-handle as handle     no-undo .
      716     define input  parameter p-db-name    as character  no-undo .
      717     define input  parameter p-tt-handle  as handle     no-undo .
      718     define output parameter o-Where      as character  no-undo.
      719     do
      720     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      721     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      722     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      723     :
      724       define variable v-full-tbl-name  as character no-undo .
      725       define variable bh_tbl-name      as handle    no-undo .
      726       define variable fh_key           as handle    no-undo .
      727       define variable fh_search        as handle    no-undo .
      728       define variable v-field-num      as integer   no-undo .
      729       define variable v-count-fld      as integer   no-undo .
      730       define variable v-inform         as character no-undo .
      731       define variable v-ind            as integer   no-undo .
      732       define variable v-idx-field-qnty as integer   no-undo .
      733       define variable v-field-name     as character no-undo .
      734       define variable v-field-val      as character no-undo .
      735       define variable v-word-link      as character no-undo .
      736       define variable vTable           as character no-undo.
      737       define variable bh_tbl-key       as handle    no-undo .
      738       assign
      739         p-key-rec = trim( p-key-rec )
      740       .
      741       if p-key-handle <> ? then do:
      742         if not valid-handle(p-key-handle)
      743            or p-key-handle:type <> "buffer"
      744         then do:
      745           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      746         end.
      747         if num-entries( p-key-rec, chr(3) ) > 1
      748           or p-key-rec = ?
      749           or p-key-rec = "":U
      750         then do:
      751           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      752         end.
      753       end.
      754       else do:
      755         if p-key-rec = ?
      756           or p-key-rec = "":U
      757         then do:
      758           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      759         end.
      760       end.
      761       assign
      762         vTable = entry( 1 , p-key-rec, chr(3) )
      763       .
      764       if p-tt-handle <> ?
      765         and ( not valid-handle(p-tt-handle)
      766               or p-tt-handle:type <> "buffer"
      767             )
      768       then do:
      769         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      770       end.
      771       if p-tt-handle = ? then do:
      772         assign
      773           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      774         .
      775         create buffer bh_tbl-name for table v-full-tbl-name .
      776       end.
      777       else do:
      778         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      779       end.
      780       assign
      781         v-inform = bh_tbl-name:index-information(1)
      782         v-ind    = 2
      783       .
      784       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      785       on error undo, return error
      786       :
      787         assign
      788           v-inform = bh_tbl-name:index-information( v-ind )
      789           v-ind    = v-ind + 1
      790         .
      791       end.
      792       if v-inform = ?
      793         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      794         or entry( 3, v-inform, ",":U ) <> "1":U
      795       then do:
      796         delete object bh_tbl-name no-error.
      797         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      798       end.
      799       assign
      800         v-idx-field-qnty = num-entries( v-inform ) - 4
      801       .
      802       if v-idx-field-qnty < 2 then do:
      803         delete object bh_tbl-name no-error.
      804         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      805       end.
      806       assign
      807         o-where     = "where":U
      808         v-word-link = "":U
      809         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      810         v-count-fld = 0
      811       .
      812       if i-tablekey ne "" and i-tablekey ne ?
      813       then do:
      814         assign
      815           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      816         .
      817         create buffer bh_tbl-key for table v-full-tbl-name .
      818       end.
      819       if i-tableSerach ne "" and i-tableSerach ne ?
      820       then do:
      821         delete object bh_tbl-name no-error.
      822         assign
      823           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      824         .
      825         create buffer bh_tbl-name for table v-full-tbl-name .
      826       end.
      827       block_where:
      828       do v-ind = 1 to v-idx-field-qnty by 2
      829       on error undo, return error
      830       :
      831         assign
      832           v-count-fld = v-count-fld + 1
      833         .
      834         if p-key-handle = ?
      835           and v-count-fld > v-field-num
      836         then do:
      837           leave block_where.
      838         end.
      839         define variable VfieldKeyTable as handle no-undo.
      840         assign
      841           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      842           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      843         .
      844         if     bh_tbl-key ne ?
      845         then do:
      846            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      847            if VfieldKeyTable eq ?
      848            then next block_where.
      849         end.
      850         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      851         then
      852            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      853         else
      854            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      855         if p-key-handle = ? then do:
      856           assign
      857             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      858           .
      859         end.
      860         else do:
      861           assign
      862             fh_key = p-key-handle:buffer-field( v-field-name )
      863           .
      864           if fh_key = ?
      865             or not valid-handle( fh_key )
      866           then do:
      867             delete object bh_tbl-name.
      868             if     bh_tbl-key ne ?
      869             then
      870                delete object bh_tbl-key.
      871             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
      872           end.
      873           assign
      874             v-field-val = fh_key:buffer-value
      875           .
      876         end.
      877         if fh_search:data-type ="character":U then do:
      878           assign
      879             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      880             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      881             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      882             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      883             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      884             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      885             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      886             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      887             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      888             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      889             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      890             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      891             v-field-val = substitute( '"&1"', v-field-val )
      892           .
      893         end.
      894         assign
      895           o-where = substitute( "&1 &2", o-where, v-field-val )
      896         .
      897         if v-word-link = "":U then do:
      898           assign
      899             v-word-link = "and":U
      900           .
      901         end.
      902       end.
      903       delete object bh_tbl-name.
      904       if     bh_tbl-key ne ?
      905       then
      906          delete object bh_tbl-key.
      907       if p-key-handle = ?
      908         and v-count-fld <> v-field-num
      909       then do:
      910         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
      911       end.
      912     end.
      913   end procedure.
      914   procedure gen-hn-keyr-tab :
      915     define input  parameter i-tableSerach as character no-undo.
      916     define input  parameter i-tablekey   as character no-undo.
      917     define input  parameter p-key-rec    as character no-undo.
      918     define input  parameter p-key-handle as handle    no-undo .
      919     define input  parameter p-db-name    as character no-undo .
      920     define input  parameter p-tt-handle  as handle    no-undo .
      921     define input  parameter p-stts-lock  as integer   no-undo .
      922     define output parameter o-hn         as handle    no-undo.
      923     define variable v-full-tbl-name as character no-undo.
      924     define variable v-where         as character no-undo.
      925     define variable bh_tbl-name     as handle    no-undo.
      926     define variable vTable          as character no-undo.
      927     do
      928     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      929     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      930     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      931         run gen-where-keyr-tab(i-tableSerach,
      932                                i-tablekey,
      933                                p-key-rec,
      934                                p-key-handle,
      935                                p-db-name,
      936                                p-tt-handle,
      937                                output v-where).
      938         if i-tableSerach ne "" and i-tableSerach ne ?
      939         then do:
      940            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      941            create buffer bh_tbl-name for table v-full-tbl-name .
      942         end.
      943         else do:
      944            if p-tt-handle = ? then do:
      945               assign
      946                  vTable = entry( 1 , p-key-rec, chr(3) )
      947               .
      948               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      949               create buffer bh_tbl-name for table v-full-tbl-name .
      950            end.
      951            else do:
      952               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      953            end.
      954         end.
      955         if p-tt-handle = ? then do:
      956            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      957         end.
      958         else do:
      959            bh_tbl-name:find-first( v-where ) no-error .
      960         end.
      961         o-hn = bh_tbl-name.
      962      end.
      963   end procedure.
      964   procedure gen-hn-keyr :
      965     define input  parameter p-key-rec    as character no-undo.
      966     define input  parameter p-key-handle as handle    no-undo .
      967     define input  parameter p-db-name    as character no-undo .
      968     define input  parameter p-tt-handle  as handle    no-undo .
      969     define input  parameter p-stts-lock  as integer   no-undo .
      970     define output parameter o-hn         as handle    no-undo.
      971     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      972   end.
      973   procedure gen-row-keyr :
      974     define input  parameter p-key-rec    as character no-undo.
      975     define input  parameter p-key-handle as handle    no-undo .
      976     define input  parameter p-db-name    as character no-undo .
      977     define input  parameter p-tt-handle  as handle    no-undo .
      978     define input  parameter p-stts-lock  as integer   no-undo .
      979     define output parameter p-tbl-row    as rowid     no-undo.
      980     define output parameter p-tbl-name   as character no-undo.
      981     define variable vHn as handle no-undo.
      982       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      983       p-tbl-row = if vHn:available then vHn:rowid else ?.
      984       p-tbl-name =  vHn:table.
      985       delete object vHn no-error.
      986     if p-tbl-row = ? then do:
      987       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
      988     end.
      989     else do:
      990       return.
      991     end.
      992   end procedure.
      993   procedure gen-key-fv :
      994     define input  parameter p-key-rec    as character no-undo .
      995     define output parameter p-field-list as character no-undo .
      996     define output parameter p-value-list as character no-undo.
      997     do
      998     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      999     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1000     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1001     :
     1002       define variable v-full-tbl-name  as character no-undo .
     1003       define variable bh_tbl-name      as handle    no-undo .
     1004       define variable v-tbl-name       as character no-undo .
     1005       define variable v-field-num      as integer   no-undo .
     1006       define variable v-count-fld      as integer   no-undo .
     1007       define variable v-inform         as character no-undo .
     1008       define variable v-ind            as integer   no-undo .
     1009       define variable v-idx-field-qnty as integer   no-undo .
     1010       define variable v-delim-key      as character no-undo .
     1011       if p-key-rec = ?
     1012         or p-key-rec = "":U
     1013       then do:
     1014         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1015       end.
     1016       assign
     1017         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1018         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1019       .
     1020       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1021       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1022       assign
     1023         v-inform = bh_tbl-name:index-information(1)
     1024         v-ind    = 2
     1025       .
     1026       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1027       on error undo, return error
     1028       :
     1029         assign
     1030           v-inform = bh_tbl-name:index-information( v-ind )
     1031           v-ind    = v-ind + 1
     1032         .
     1033       end.
     1034       if v-inform = ?
     1035         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1036         or entry( 3, v-inform, ",":U ) <> "1":U
     1037       then do:
     1038         delete object bh_tbl-name no-error.
     1039         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1040       end.
     1041       assign
     1042         v-idx-field-qnty = num-entries( v-inform ) - 4
     1043       .
     1044       if v-idx-field-qnty < 2 then do:
     1045         delete object bh_tbl-name no-error.
     1046         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1047       end.
     1048       assign
     1049         p-field-list = "":U
     1050         p-value-list = "":U
     1051         v-delim-key  = "":U
     1052         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1053         v-count-fld  = 0
     1054       .
     1055       block_where:
     1056       do v-ind = 1 to v-idx-field-qnty by 2
     1057       on error undo, return error
     1058       :
     1059         assign
     1060           v-count-fld = v-count-fld + 1
     1061         .
     1062         if v-count-fld > v-field-num then do:
     1063           leave block_where.
     1064         end.
     1065         assign
     1066           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1067           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1068         .
     1069         if v-ind = 1 then do:
     1070           assign
     1071             v-delim-key = chr(3)
     1072           .
     1073         end.
     1074       end.
     1075       delete object bh_tbl-name.
     1076       if v-count-fld <> v-field-num then do:
     1077         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1078       end.
     1079     end.
     1080   end procedure.
     1081   procedure gen-key-field :
     1082     define input  parameter p-table      as character no-undo .
     1083     define output parameter p-field-list as character no-undo .
     1084     do
     1085     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1086     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1087     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1088     :
     1089       define variable v-full-tbl-name  as character no-undo .
     1090       define variable bh_tbl-name      as handle    no-undo .
     1091       define variable v-tbl-name       as character no-undo .
     1092       define variable v-field-num      as integer   no-undo .
     1093       define variable v-count-fld      as integer   no-undo .
     1094       define variable v-inform         as character no-undo .
     1095       define variable v-ind            as integer   no-undo .
     1096       define variable v-idx-field-qnty as integer   no-undo .
     1097       define variable v-delim-key      as character no-undo .
     1098       if p-table = ?
     1099         or p-table = "":U
     1100       then do:
     1101         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1102       end.
     1103       assign
     1104         v-tbl-name      = p-table
     1105         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1106       .
     1107       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1108       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1109       assign
     1110         v-inform = bh_tbl-name:index-information(1)
     1111         v-ind    = 2
     1112       .
     1113       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1114       on error undo, return error
     1115       :
     1116         assign
     1117           v-inform = bh_tbl-name:index-information( v-ind )
     1118           v-ind    = v-ind + 1
     1119         .
     1120       end.
     1121       if v-inform = ?
     1122         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1123         or entry( 3, v-inform, ",":U ) <> "1":U
     1124       then do:
     1125         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1126       end.
     1127       assign
     1128         v-idx-field-qnty = num-entries( v-inform ) - 4
     1129       .
     1130       if v-idx-field-qnty < 2 then do:
     1131         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1132       end.
     1133       assign
     1134         p-field-list = "":U
     1135         v-delim-key  = "":U
     1136         v-count-fld  = 0
     1137       .
     1138       block_where:
     1139       do v-ind = 1 to v-idx-field-qnty by 2
     1140       on error undo, return error
     1141       :
     1142         assign
     1143           v-count-fld = v-count-fld + 1
     1144         .
     1145         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1146         if v-ind = 1 then do:
     1147           assign
     1148             v-delim-key = chr(3)
     1149           .
     1150         end.
     1151       end.
     1152       delete object bh_tbl-name.
     1153     end.
     1154   end procedure.
     1155   define SHARED temp-table temp-cmd no-undo
     1156   field cmd-code as integer
     1157   field db-list as character
     1158   index pi is unique primary
     1159   db-list
     1160   index icmd
     1161   cmd-code
     1162   .
     1163   define SHARED temp-table temp-smart-route no-undo
     1164   field key-field as character
     1165   field db-num as integer
     1166   index pi is unique primary
     1167   key-field
     1168   db-num
     1169   .
     1170   define SHARED temp-table temp-no-route no-undo
     1171   field rec-ord as integer
     1172   field db-num as integer
     1173   index pi is unique primary
     1174   db-num
     1175   rec-ord
     1176   index iro
     1177   rec-ord
     1178   .
     1179   define SHARED temp-table temp-smart-link no-undo
     1180   field uniq-key-rec as character
     1181   field key-field as character
     1182   field rec-ord as integer
     1183   field is-smart as logical
     1184   index pi is unique primary
     1185   key-field
     1186   uniq-key-rec
     1187   rec-ord
     1188   index iu
     1189   uniq-key-rec
     1190   index iro
     1191   rec-ord
     1192   .
     1193   define SHARED temp-table temp-nws-outline no-undo
     1194   like ub.nws-outline.
     1195   procedure create-smart-route :
     1196   define input parameter p-key-field as character no-undo .
     1197   define input parameter p-db-num as integer no-undo .
     1198   define buffer buf_temp-smart-route for temp-smart-route.
     1199     do
     1200     on error undo, return error
     1201     :
     1202       find first buf_temp-smart-route where
     1203                 buf_temp-smart-route.key-field = p-key-field
     1204             and buf_temp-smart-route.db-num = p-db-num no-error.
     1205       if not available buf_temp-smart-route then do:
     1206         create buf_temp-smart-route.
     1207         assign
     1208         buf_temp-smart-route.key-field = p-key-field
     1209         buf_temp-smart-route.db-num = p-db-num
     1210         .
     1211       end.
     1212     end.
     1213   end procedure.
     1214   procedure create-smart-route-link :
     1215   define input parameter p-tbl-name as character no-undo .
     1216   define input parameter p-bh_tbl-name as handle no-undo .
     1217   define input parameter p-key-field as character no-undo .
     1218   define input parameter p-rec-ord as integer no-undo .
     1219   define input parameter p-is-smart as logical no-undo .
     1220   define variable v-key-rec as character no-undo .
     1221   define buffer buf_temp-smart-link for temp-smart-link.
     1222     do
     1223     on error undo, return error
     1224     :
     1225       run gen-key-rec in this-procedure ( input p-tbl-name
     1226                                          ,input p-bh_tbl-name
     1227                                          ,output v-key-rec     ).
     1228      find first buf_temp-smart-link where
     1229                 buf_temp-smart-link.uniq-key-rec = v-key-rec
     1230              and buf_temp-smart-link.key-field = p-key-field
     1231              and buf_temp-smart-link.rec-ord = p-rec-ord
     1232              no-error .
     1233      if not available buf_temp-smart-link then do:
     1234        create buf_temp-smart-link.
     1235        assign
     1236        buf_temp-smart-link.uniq-key-rec = v-key-rec
     1237        buf_temp-smart-link.key-field = p-key-field
     1238        buf_temp-smart-link.rec-ord = p-rec-ord
     1239        buf_temp-smart-link.is-smart = p-is-smart
     1240        .
     1241      end.
     1242     end.
     1243   end procedure.
     1244   procedure create-nws-outline :
     1245   define input parameter p-cmd-proc-handle as handle no-undo .
     1246   define input parameter p-cmd-code as integer no-undo .
     1247   define input parameter p-outline-type as character no-undo .
     1248   define input parameter p-charkey_one as character no-undo .
     1249   define input parameter p-charkey_two as character no-undo .
     1250   define input parameter p-charkey_three as character no-undo .
     1251   define input parameter p-key#_one as integer no-undo .
     1252   define input parameter p-key#_two as integer no-undo .
     1253   define input parameter p-key#_three as integer no-undo .
     1254   define variable v-no-id as integer no-undo .
     1255   define variable v-rec-ord as integer no-undo .
     1256     do
     1257     on error undo, return error return-value
     1258     :
     1259       find last temp-nws-outline use-index pi no-error .
     1260       v-no-id = (if available temp-nws-outline
     1261                  then (temp-nws-outline.no-id  + 1)
     1262                  else 1).
     1263       create temp-nws-outline.
     1264       assign
     1265       temp-nws-outline.charkeY_one = p-charkey_one
     1266       temp-nws-outline.charkeY_two = p-charkey_two
     1267       temp-nws-outline.charkeY_three = p-charkey_three
     1268       temp-nws-outline.key#_one = p-key#_one
     1269       temp-nws-outline.key#_two = p-key#_two
     1270       temp-nws-outline.key#_three = p-key#_three
     1271       temp-nws-outline.no-id = v-no-id
     1272       temp-nws-outline.outline-type = p-outline-type
     1273       .
     1274                                   run add-dump in p-cmd-proc-handle                                                                           (input p-cmd-code                                                                                         ,input 'nws-outline':U                                                                                          ,input '+update'                                                                                         ,input (buffer temp-nws-outline:handle)                                                                                    ,input ''                                                                                         ,output v-rec-ord                                                                                         ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure p-cmd-proc-handle .                                                                        undo , return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'nws-outline':U                                                                                                ,p-cmd-code                                                                                               ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1275       run  create-smart-route in this-procedure (
     1276                                                   input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1277                                                  ,input -1).
     1278       run create-smart-route-link in this-procedure (
     1279                                                      input 'nws-outline':U
     1280                                                     ,input (buffer temp-nws-outline:handle)
     1281                                                     ,input ('nws-outline':U + chr(4) + string(temp-nws-outline.no-id))
     1282                                                     ,input v-rec-ord
     1283                                                     ,input no
     1284                                                     ).
     1285     end.
     1286   end procedure.
     1287   procedure create-no-route :
     1288   define input parameter p-rec-ord as integer no-undo .
     1289   define input parameter p-db-num as integer no-undo .
     1290   define buffer buf_temp-no-route for temp-no-route.
     1291   do
     1292   on error undo, return error
     1293   :
     1294      find first buf_temp-no-route where
     1295                 buf_temp-no-route.rec-ord = p-rec-ord
     1296              and buf_temp-no-route.db-num = p-db-num no-error .
     1297      if not available buf_temp-no-route then do:
     1298        create buf_temp-no-route.
     1299        assign
     1300        buf_temp-no-route.rec-ord = p-rec-ord
     1301        buf_temp-no-route.db-num = p-db-num
     1302        .
     1303      end.
     1304   end.
     1305   end procedure.
     1306   procedure clear-from-rec-ord :
     1307   define input parameter p-rec-ord as integer no-undo .
     1308   define buffer buf_temp-no-route for temp-no-route.
     1309   define buffer buf_temp-smart-link for temp-smart-link.
     1310   do
     1311   on error undo, return error
     1312   :
     1313   for each buf_temp-no-route where
     1314           buf_temp-no-route.rec-ord > p-rec-ord:
     1315     delete buf_temp-no-route.
     1316   end.
     1317   for each buf_temp-smart-link where
     1318           buf_temp-smart-link.rec-ord > p-rec-ord:
     1319      delete buf_temp-smart-link.
     1320   end.
     1321   end.
     1322   end procedure.
